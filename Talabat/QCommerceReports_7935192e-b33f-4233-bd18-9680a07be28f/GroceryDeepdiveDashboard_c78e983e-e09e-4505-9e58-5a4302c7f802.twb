            <properties context=''>
              <relation connection='bigquery.11kwbpr0qtzp630zyamp31o65i6s' name='Custom SQL Query' type='text'>select * from
`tlb-data-dev.data_playground_finding.agg_grocery_experiments_dashboard_session_table` 
where (lower(experiment_id) like &apos;%qcommerce%&apos;
or experiment_id in (&apos;133553&apos;,&apos;133554&apos;,&apos;133289&apos;,&apos;133288&apos;,&apos;134308&apos;,&apos;134307&apos;,&apos;135025&apos;,&apos;135026&apos;,&apos;135362&apos;,&apos;135363&apos;)
or experiment_id = &apos;all&apos;)
and found_via_feature = &apos;all&apos;
--and level = &apos;experiment_overall&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
