      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>&lt;Sheet Name&gt; for feature:</run>
            <run bold='true' fontalignment='1' fontsize='14'>Æ </run>
            <run bold='true' fontalignment='1' fontsize='12'><![CDATA[<[federated.0c0yjv00dmv1h01grklox009zxy4].[none:found_via_feature:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='experiment sessions data - found via feature level' name='federated.0c0yjv00dmv1h01grklox009zxy4' />
          </datasources>
          <datasource-dependencies datasource='federated.0c0yjv00dmv1h01grklox009zxy4'>
            <column caption='gHome to Menu CTR' datatype='real' default-format='p0.00%' name='[Calculation_1112600250930143233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_ghome_menu_clicked])/sum([ghome_session_count])' />
            </column>
            <column caption='ATC%' datatype='real' default-format='p0.00%' name='[Calculation_1112600250930270210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_ghome_added_to_cart])/sum([ghome_session_count])' />
            </column>
            <column caption='Checkout started%' datatype='real' default-format='p0.00%' name='[Calculation_1112600250930343939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_ghome_started_checkout])/sum([ghome_session_count])' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_1112600250930556933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_ghome_transaction])/sum([ghome_session_count])' />
            </column>
            <column datatype='string' name='[app_version]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[experiment_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[experiment_variant]' role='dimension' type='nominal' />
            <column caption='found_via_feature (copy)' datatype='string' name='[found_via_feature (copy)_2369737881471049733]' role='dimension' type='nominal'>
