          <datasource-dependencies datasource='federated.0delke41j3jwg318r7jch0bi1rii'>
            <column caption='In-vendor Search Usage' datatype='real' default-format='p0.00%' name='[Calculation_1112600250924748800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([grocery_in_vendor_search_clicked_sessions])/sum([viewed_grocery_menu_overall_sessions])' />
            </column>
            <column caption='Overall CVR' datatype='real' default-format='p0.00%' name='[Calculation_187954952071004160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([session_placed_order_overall])/sum([experiment_sessions])' />
            </column>
            <column caption='Grocery CVR' datatype='real' default-format='p0.00%' name='[Calculation_187954952071114753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([grocery_placed_order_overall_sessions])/sum([grocery_session_count])' />
            </column>
            <column caption='GHome CVR' datatype='real' default-format='p0.00%' name='[Calculation_187954952071282690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_ghome_transaction])/sum([ghome_session_count])' />
            </column>
            <column caption='GHome CTR - Exc Search' datatype='real' default-format='p0.00%' name='[Calculation_187954952219754500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ghome_clicked_overall_exc_search])/sum([ghome_session_count])' />
            </column>
            <column caption='GHome Search Usage' datatype='real' default-format='p0.00%' name='[Calculation_187954952220164102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ghome_search_session_count])/sum([ghome_session_count])' />
            </column>
