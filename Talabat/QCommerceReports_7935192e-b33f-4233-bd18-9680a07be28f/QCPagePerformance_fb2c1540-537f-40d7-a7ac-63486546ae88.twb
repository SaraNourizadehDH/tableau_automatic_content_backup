      <table>
        <view>
          <datasources>
            <datasource caption='remix_qc_report (data_playground_grocery)' name='federated.0ofliy3136izjk0zryp3v02furrh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ofliy3136izjk0zryp3v02furrh].[Calculation_5711197710948880389]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-02-22#'>
              <calculation class='tableau' formula='#2025-02-22#' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Measure' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Sessions&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ofliy3136izjk0zryp3v02furrh].[Default Date - Start (copy)_5711197710948954118]' caption='End Date' datatype='date' name='[Start Date (copy)_5711197710948687875]' param-domain-type='any' role='measure' type='quantitative' value='#2025-02-22#'>
              <calculation class='tableau' formula='#2025-02-22#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ofliy3136izjk0zryp3v02furrh'>
            <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1432637327203627008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='All Filter - Shop Type' datatype='boolean' name='[Calculation_4289537973488427008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Shop Type&apos; THEN [shop_type] != &apos;All&apos;&#10;ELSE [shop_type] = &apos;All&apos;&#10;END' />
            </column>
            <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_5711197710946963456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks])/SUM([sessions])' />
            </column>
            <column caption='Date Filter' datatype='string' name='[Calculation_5711197710948749316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_5711197710948687875])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5711197710948687875]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_5711197710948687875])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_5711197710948687875]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='Default Date - Start' datatype='date' name='[Calculation_5711197710948880389]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Hide null' datatype='boolean' name='[Calculation_5711197710950256647]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = #2024-09-26# then&#10;INDEX() = 1&#10;ELSE&#10;INDEX()!= 1&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Selected Dimension' datatype='string' name='[Calculation_5711197710951223304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Country&apos; THEN [country_code]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Shop Type&apos; THEN [shop_type]&#10;WHEN &apos;QC Customer Segment&apos; THEN [qc_customer_segment]&#10;&#10;END' />
            </column>
            <column caption='Selected Metric' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5711197710952480778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Sessions&apos; THEN SUM([sessions])&#10;WHEN &apos;Placed Orders&apos; THEN SUM([transactions])&#10;WHEN &apos;Users&apos; THEN SUM([users])&#10;WHEN &apos;GMV&apos; THEN SUM([gmv])&#10;&#10;END' />
            </column>
            <column caption='Default Date - End' datatype='date' name='[Default Date - Start (copy)_5711197710948954118]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Selected Metric %' datatype='real' default-format='p0.0%' name='[Selected Metric (copy)_5711197710953558028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;CVR&apos; THEN [Calculation_1432637327203627008]&#10;WHEN &apos;CTR&apos; THEN [Calculation_5711197710946963456]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Clicks' datatype='integer' name='[clicks]' role='measure' type='quantitative' />
            <column caption='Component Name' datatype='string' name='[component_name]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Selected Metric (copy)_5711197710953558028]' derivation='User' name='[diff:usr:Selected Metric (copy)_5711197710953558028:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
