      <aliases enabled='yes' />
      <column caption='CTR (Green)' datatype='real' name='[CVR (Green) (copy)_1933451681623175172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5711197710946963456] &gt;= .28 THEN&#10;&#10;[Calculation_5711197710946963456]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='CTR (Red)' datatype='real' name='[CVR (Red) (copy)_1933451681623175174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5711197710946963456] &lt; .28 THEN&#10;&#10;[Calculation_5711197710946963456]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='CVR (Green)' datatype='real' name='[CVR (Red) (copy)_2258414491645734919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1432637327203627008] &gt;= .28 THEN&#10;&#10;[Calculation_1432637327203627008]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='CVR (remaining)' datatype='real' default-format='p0.0%' name='[CVR (copy)_1420956074391166976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1432637327203627008] &lt; .28 THEN&#10;&#10;1 - ([Calculation_2258414491645501446] + [Calculation_93871929805230080])&#10;ELSE 1 - [Calculation_1432637327203627008]&#10;&#10;END' />
      </column>
      <column caption='CTR (remaining)' datatype='real' default-format='p0.0%' name='[CVR (remaining) (copy)_1933451681623175173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5711197710946963456] &lt; .28 THEN&#10;&#10;1 - ([CVR (Red) (copy)_1933451681623175174] + [CVR Target (copy)_1933451681623175175])&#10;ELSE 1 - [Calculation_5711197710946963456]&#10;&#10;END' />
      </column>
      <column caption='CTR Target' datatype='real' name='[CVR Target (copy)_1933451681623175175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5711197710946963456] &lt; .28 THEN&#10;&#10;0.28 - [CVR (Red) (copy)_1933451681623175174]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='Title 1' datatype='string' name='[Calculation_138204280467927042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Activation&apos; THEN &apos;&lt; 4 platform orders&apos;&#10;ELSE &apos;Habitual Food&apos;&#10;END' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1432637327203627008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
      </column>
      <column caption='Screen - MHU Food: Not Active Grocery' datatype='boolean' name='[Calculation_1933451681514274816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;MHU Food: Not Active Grocery&apos;' />
      </column>
      <column caption='CVR (Red)' datatype='real' name='[Calculation_2258414491645501446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1432637327203627008] &lt; .28 THEN&#10;&#10;[Calculation_1432637327203627008]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='Screen - App Filter' datatype='boolean' name='[Calculation_3730739777685397505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#10;WHEN  &apos;Activation&apos; THEN [qc_customer_segment] = &apos;ACTIVATION&apos;&#10;WHEN  &apos;MHU Food: MHU Grocery&apos; THEN [qc_customer_segment] = &apos;MHU&apos;&#10;END' />
      </column>
      <column caption='Customers Segment' datatype='string' name='[Calculation_3730739777734164484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6] THEN [qc_customer_segment] ELSE &apos;Total&apos; end' />
      </column>
