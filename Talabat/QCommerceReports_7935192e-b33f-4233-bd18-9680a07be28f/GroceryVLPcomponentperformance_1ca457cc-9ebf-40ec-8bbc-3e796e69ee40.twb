      <aliases enabled='yes' />
      <column caption='Clicks-to-order' datatype='real' name='[Calculation_117586234587394048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversion_count])/SUM([click_count])' />
      </column>
      <column caption='Clicks-to-ATC' datatype='real' name='[Calculation_117586234587561985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([add_to_cart_count])/SUM([click_count])' />
      </column>
      <column caption='Usage Rate' datatype='real' name='[Calculation_6544645113868963840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([click_count])/SUM([impression_count])' />
      </column>
      <column caption='ATCR' datatype='real' name='[Calculation_6544645113869066241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([add_to_cart_count])/SUM([impression_count])' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_6544645113869209602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversion_count])/SUM([impression_count])' />
      </column>
