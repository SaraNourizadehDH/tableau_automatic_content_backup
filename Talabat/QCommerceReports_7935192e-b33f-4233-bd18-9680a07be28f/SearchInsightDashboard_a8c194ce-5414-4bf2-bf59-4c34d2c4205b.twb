  and vertical = &apos;grocery&apos;
  and country_code in (&apos;AE&apos;,&apos;BH&apos;,&apos;EG&apos;,&apos;IQ&apos;,&apos;JO&apos;, &apos;KW&apos;,&apos;OM&apos;,&apos;QA&apos;)
), city_sessions as (
