  <datasources>
    <datasource caption='P80 vs CVR' inline='true' name='federated.0gberei1ji6nc910rplfq1s0i5fs' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0g0bz0p1f98dnk1brw46e0np18l3'>
            <connection CATALOG='tlb-datateam-analysis-6343' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-datateam-analysis' schema='bq_logs' server-oauth='server-custom' username='weichun.chang@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0g0bz0p1f98dnk1brw46e0np18l3' name='Custom SQL Query' type='text'>with temp as(
select distinct
lower(st.search_term_en) search_query_entered,
search_item_category,
PERCENTILE_CONT(clicked_vendor_rank, 0.8) over(partition by lower(search_term_en)) p80
from `tlb-data-prod.data_platform.fct_sub_session_search` s
inner join `tlb-data-dev.data_playground.qc_search_term_item_category_type`  st
      on s.search_query_entered = st.search_term
 where
       date between &apos;2025-01-01&apos; and  &apos;2025-02-28&apos;
  and lower(trim(search_query_entered)) not in (&apos;na&apos;,&apos;&apos;)
  and length(search_query_entered)&gt;&gt;0
  and vertical = &apos;grocery&apos;
), temp2 as(
select 
lower(st.search_term_en) search_query_entered,
--PERCENTILE_CONT(clicked_vendor_rank, 0.8) over(),
count(distinct(session_id )) as total_sessions,
safe_divide(count(distinct(case when placed_order then session_id end)),count(distinct(session_id ))) as cvr,
-- case when IFNULL(REGEXP_EXTRACT( search_query_entered , r&apos;([\p{Arabic}]+)&apos;), &apos;&apos;) != &apos;&apos; then &apos;arabic&apos; else &apos;english&apos; end as search_query_lang,
count(distinct(case when placed_order then session_id end)) as total_sessions_placed_order,
count(distinct(case when clicked_vendor_id is not null then session_id end)) as total_sessions_clicked,
--count(distinct(case when search_results_count = 0 then session_id end)) as total_zero_results_sessions,
avg(case when clicked_vendor_id is not null then clicked_vendor_rank end) as ag_clicked_vendor_position,
avg(case when clicked_vendor_id is not null  and placed_order= True then clicked_vendor_rank end) as ag_conv_clicked_vendor_position,
min(case when clicked_vendor_id is not null then clicked_vendor_rank end) as avg_first_pos_clicked_vendor_position
from `tlb-data-prod.data_platform.fct_sub_session_search` s
inner join `tlb-data-dev.data_playground.qc_search_term_item_category_type`  st
      on s.search_query_entered = st.search_term
 where
       date between &apos;2025-01-01&apos; and  &apos;2025-02-28&apos;
  and lower(trim(search_query_entered)) not in (&apos;na&apos;,&apos;&apos;)
  and length(search_query_entered)&gt;&gt;0
  and vertical = &apos;grocery&apos;
GROUP BY 1
  )

select temp.search_query_entered
  , split(search_item_category,&apos;-&apos;)[0] search_item_category
  , p80
  , cvr
  , temp2.total_sessions
from temp
    left join temp2
        on temp.search_query_entered = temp2.search_query_entered
group by all
order by total_sessions desc
limit 200</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
