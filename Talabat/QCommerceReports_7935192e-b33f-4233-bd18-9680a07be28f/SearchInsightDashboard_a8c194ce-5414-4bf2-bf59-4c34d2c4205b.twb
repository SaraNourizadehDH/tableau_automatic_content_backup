  and length(s.search_query_entered)&gt;&gt;0
  and s.vertical = &apos;grocery&apos;
  and s.country_code in (&apos;AE&apos;,&apos;BH&apos;,&apos;EG&apos;,&apos;IQ&apos;,&apos;JO&apos;, &apos;KW&apos;,&apos;OM&apos;,&apos;QA&apos;)
), base_metrics as (
select 
s.date,
user_selected_country,
user_selected_city,
si.vendor_id,
search_term_en search_query_entered,
s.session_id,
placed_order
from `tlb-data-prod.data_platform.fct_sub_session_search` s
  inner join `tlb-data-prod.data_platform.fct_sub_session_item_search` si
    on s.sub_session_id = si.sub_session_id
      and s.search_query_entered = si.search_query_entered
      and si.date between current_date - interval 90 day and current_date
  inner join `tlb-data-prod.data_platform.dim_vendor` dv
    on si.vendor_id = dv.vendor_id
      and dv.is_grocery_darkstore
  inner join `tlb-data-dev.data_playground.qc_search_term_item_category_type`  st
      on s.search_query_entered = st.search_term
 where
       s.date between current_date - interval 90 day and current_date
  and lower(trim(s.search_query_entered)) not in (&apos;na&apos;,&apos;&apos;)
  and length(s.search_query_entered)&gt;&gt;0
  and s.vertical = &apos;grocery&apos;
  and s.country_code in (&apos;AE&apos;,&apos;BH&apos;,&apos;EG&apos;,&apos;IQ&apos;,&apos;JO&apos;, &apos;KW&apos;,&apos;OM&apos;,&apos;QA&apos;)
), vendor_sessions as (
select 
date,
user_selected_country,
user_selected_city,
vendor_id,
search_query_entered,
count(distinct(session_id )) as total_sessions_vendor
from base_metrics
group by 1,2,3,4,5
having count(distinct(session_id ))&gt;&gt;100
), temp2 as(

select 
b.date,
b.user_selected_country,
b.user_selected_city,
b.vendor_id,
b.search_query_entered,
-- Overall metrics
count(distinct(b.session_id)) over(partition by b.date,b.search_query_entered) as total_sessions_overall,
safe_divide(count(distinct(case when b.placed_order then b.session_id end)) over(partition by b.date,b.search_query_entered),
           count(distinct(b.session_id )) over(partition by b.date,b.search_query_entered)) as cvr_overall,
-- Country level metrics
count(distinct(b.session_id )) over(partition by b.date,b.user_selected_country, b.search_query_entered) as total_sessions_country,
safe_divide(count(distinct(case when b.placed_order then b.session_id end)) over(partition by b.date,b.user_selected_country, b.search_query_entered),
           count(distinct(b.session_id )) over(partition by b.date,b.user_selected_country, b.search_query_entered)) as cvr_country,
-- City level metrics
count(distinct(b.session_id )) over(partition by b.date,b.user_selected_country,b.user_selected_city, b.search_query_entered) as total_sessions_city,
safe_divide(count(distinct(case when b.placed_order then b.session_id end)) over(partition by b.date,b.user_selected_country,b.user_selected_city, b.search_query_entered),
           count(distinct(b.session_id )) over(partition by b.date,b.user_selected_country,b.user_selected_city, b.search_query_entered)) as cvr_city,
-- Vendor level metrics
a.total_sessions_vendor,
safe_divide(count(distinct(case when b.placed_order then b.session_id end)) over(partition by b.date,b.user_selected_country,b.user_selected_city,b.vendor_id, b.search_query_entered),
           count(distinct(b.session_id )) over(partition by b.date,b.user_selected_country,b.user_selected_city,b.vendor_id, b.search_query_entered)) as cvr_vendor
from base_metrics b
inner join vendor_sessions a
    on b.date = a.date
    and b.user_selected_country = a.user_selected_country
    and b.user_selected_city = a.user_selected_city
    and b.vendor_id = a.vendor_id
    and b.search_query_entered = a.search_query_entered
group by 1,2,3,4,5, session_id, placed_order, a.total_sessions_vendor
)

select 
    t.date,
    t.user_selected_country,
    t.user_selected_city,
    t2.vendor_id,
    t.search_query_entered,
    search_term_en,
    search_item_category,
    search_type,
    round(t.p80_overall, 1) p80_overall,
    round(t.p80_country, 1) p80_country,
    round(t.p80_city, 1) p80_city,
    round(t.p80_vendor, 1) p80_vendor,
    t2.total_sessions_overall,
    t2.total_sessions_country,
    t2.total_sessions_city,
    t2.total_sessions_vendor,
    round(t2.cvr_overall, 3) cvr_overall,
    round(t2.cvr_country, 3) cvr_country,
    round(t2.cvr_city, 3) cvr_city, 
    round(t2.cvr_vendor, 3) cvr_vendor
from temp t
    inner join temp2 t2
        on t.date = t2.date
        and t.user_selected_country = t2.user_selected_country
        and t.user_selected_city = t2.user_selected_city
        and t.vendor_id = t2.vendor_id
        and t.search_query_entered = t2.search_query_entered
    left join `tlb-data-dev.data_playground.qc_search_term_item_category_type`  s
      on t.search_query_entered = s.search_term
group by all</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
