        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1auk4ys1xvanzh19cir9t1qthnj5' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_performance AS
(
SELECT 
partition_date_local AS Order_Date,
ORD.country_code,
CASE WHEN ORD.brand_name = 'Talabat' THEN ORD.vendor_id END Talabat_Vendor_ID,
CASE WHEN ORD.brand_name = 'InstaShop' THEN ORD.vendor_id END InstaShop_Vendor_ID,

Count (distinct  ORD.order_id) AS Total_Orders,
COUNT (DISTINCT CASE WHEN  ORD.is_successful then  ORD.order_id END) AS successful_orders,
SUM (  CASE WHEN  ORD.is_successful then  ORD.value.order.gmv_eur ELSE 0 END) AS GMV_EUR, 
SUM(CASE WHEN  ORD.is_successful then total_items_quantity ELSE 0 END) AS Orderd_Items,
AVG(CASE WHEN  ORD.is_successful then ORD.value.order.gmv_eur ELSE 0 END ) AS AOV_AVG_EUR,
AVG(CASE WHEN  ORD.is_successful then ORD.value.order.gmv_local ELSE 0 END) AS AOV_AVG_LC,
SUM (  CASE WHEN  ORD.is_successful then  ORD.value.order.gmv_local ELSE 0 END) AS GMV_LC,
AVG (CASE WHEN  ORD.is_successful then ORD.value.order.gbv_eur ELSE 0 END) AS Average_Basket_Value_EUR,
AVG (CASE WHEN  ORD.is_successful then ORD.value.order.gbv_local ELSE 0 END) AS Average_Basket_Value_LC,
COUNT(DISTINCT CASE WHEN  ORD.is_successful then  customer.customer_id END) AS Unique_Customers,

FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` ORD
WHERE DATE (ORD.partition_date_local) >>= '2024-01-01'
AND ORD.brand_name in ('InstaShop','Talabat')
--AND ORD.vendor_id ='zzrGebzKpw'
--AND ORD.vendor_id  in ( '723522' , 'AnS0cWVgS2')
GROUP BY ALL
),
Vendor_Mapping AS 
(
SELECT
DD.date,
CAST (talabat_vendor_id AS STRING) AS Talabat_Vendor_ID,
talabat_vendor_name AS Talabat_Vendor_Name,
talabat_vendor_vertical AS Talbat_Vendor_Vertical,
CASE WHEN TLB_VEN.location.city = "bahrain all cities" THEN "bahrain"
     WHEN TLB_VEN.location.city = "cairo_inactive" THEN "cairo"
     WHEN TLB_VEN.location.city = "damietta new" THEN "damietta"
     WHEN TLB_VEN.location.city = "north coast 24" THEN "north coast" 
     WHEN TLB_VEN.location.city = "ras al khaima" THEN "ras al khaimah"
     WHEN TLB_VEN.location.city = "umm al-quwain" THEN "umm al quwain"
     WHEN TLB_VEN.location.city IN
     (
      "muttrah" ,"sohar", "amerat","seeb","salalah","bosher","al suwayq","sinaw","al khabourah", "rustaq",      
      "nizwa","jalan","ibri","barka","ibra ","saham","duqm","bahla","ibra","sur","buraimi"
     )
     THEN "muscat" ELSE TLB_VEN.location.city END AS Talabat_Vendor_City,
TLB_VEN.location.latitude AS Talabat_Vendor_latitude,
TLB_VEN.location.longitude AS Talabat_Vendor_longitude,
instashop_vendor_id AS InstaShop_Vendor_ID,
instashop_vendor_name AS InstaShop_Vendor_Name,
instashop_vendor_vertical AS Insta_Shop_Vendor_Vertical,
CASE WHEN INS_VEN.location.city = "bahrain all cities" THEN "bahrain"
     WHEN INS_VEN.location.city = "cairo_inactive" THEN "cairo"
     WHEN INS_VEN.location.city = "damietta new" THEN "damietta"
     WHEN INS_VEN.location.city = "north coast 24" THEN "north coast" 
     WHEN INS_VEN.location.city = "ras al khaima" THEN "ras al khaimah"
     WHEN INS_VEN.location.city = "umm al-quwain" THEN "umm al quwain"
     WHEN INS_VEN.location.city IN
     (
      "muttrah" ,"sohar", "amerat","seeb","salalah","bosher","al suwayq","sinaw","al khabourah", "rustaq",      
      "nizwa","jalan","ibri","barka","ibra ","saham","duqm","bahla","ibra","sur","buraimi"
     )
     THEN "muscat" ELSE INS_VEN.location.city END AS InstaShop_Vendor_City,
INS_VEN.location.latitude AS InstaShop_Vendor_latitude,
INS_VEN.location.longitude AS InstaShop_Vendor_longitude,
FROM
`tlb-data-prod.data_platform.dim_date` DD
 CROSS JOIN `tlb-data-dev.data_playground.vendors_mapping` VM 
LEFT  JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` TLB_VEN  
ON  CAST (VM.talabat_vendor_id AS STRING)  = TLB_VEN.vendor_id AND UPPER(VM.country_code) = Upper(TLB_VEN.country_code)
LEFT  JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` INS_VEN  
ON  CAST (VM.InstaShop_Vendor_ID AS STRING)  = INS_VEN.vendor_id AND UPPER(VM.country_code) = Upper(INS_VEN.country_code)
WHERE VM.matched
AND DD.date >>= '2024-01-01'
AND DD.date << current_date
--AND CAST (talabat_vendor_id AS STRING) in ( '723522' , 'AnS0cWVgS2')
),

Talabat_KPIs AS
(
SELECT 
VM.* , VP.*except(Talabat_Vendor_ID)
FROM Vendor_Mapping VM
JOIN vendor_performance VP ON VM.date = VP.Order_Date AND VM.Talabat_Vendor_ID = VP.Talabat_Vendor_ID
),
----------------INSTASHOP KPIs--------
InstaShop_KPIs AS
(
SELECT 
VM.* , VP.*except(InstaShop_Vendor_ID)
FROM Vendor_Mapping VM
JOIN vendor_performance VP ON VM.date = VP.Order_Date AND VM.InstaShop_Vendor_ID = VP.InstaShop_Vendor_ID
)


SELECT 
VM.date AS Order_Date,
COALESCE (TK.country_code , IK.country_code) AS Country,
--------------------TALABAT KPIS--------
VM.Talabat_Vendor_ID,
VM.Talabat_Vendor_Name,
VM.Talabat_Vendor_City,
VM.Talabat_Vendor_latitude,
VM.Talabat_Vendor_longitude,
VM.Talbat_Vendor_Vertical,
Coalesce (TK.Total_Orders,0) Talabat_Total_Orders,
Coalesce (TK.successful_orders,0) Talabat_successful_orders,
Coalesce (TK.GMV_EUR,0) Talabat_GMV_EUR,
Coalesce (TK.Orderd_Items,0) Talabat_Orderd_Items,
Coalesce (TK.AOV_AVG_EUR,0) Talabat_AOV_AVG_EUR,
Coalesce (TK.AOV_AVG_LC,0) Talabat_AOV_AVG_LC,
Coalesce (TK.GMV_LC,0) Talabat_GMV_LC,
Coalesce (TK.Average_Basket_Value_EUR,0) Talabat_ABV_EUR,
Coalesce (TK.Average_Basket_Value_LC,0) Talabat_ABV_LC,
Coalesce (TK.Unique_Customers,0) Talabat_Unique_Customers,
--------------------INSTASHOP KPIS--------
VM.InstaShop_Vendor_ID,
VM.InstaShop_Vendor_Name,
VM.InstaShop_Vendor_City,
VM.InstaShop_Vendor_latitude,
VM.InstaShop_Vendor_longitude,
VM.Insta_Shop_Vendor_Vertical,
Coalesce (IK.Total_Orders,0) InstaShop_Total_Orders,
Coalesce (IK.successful_orders,0) InstaShop_successful_orders,
Coalesce (IK.GMV_EUR,0) InstaShop_GMV_EUR,
Coalesce (IK.Orderd_Items,0) InstaShop_Orderd_Items,
Coalesce (IK.AOV_AVG_EUR,0) InstaShop_AOV_AVG_EUR,
Coalesce (IK.AOV_AVG_LC,0) InstaShop_AOV_AVG_LC,
Coalesce (IK.GMV_LC,0) InstaShop_GMV_LC,
Coalesce (IK.Average_Basket_Value_EUR,0) InstaShop_ABV_EUR,
Coalesce (IK.Average_Basket_Value_LC,0) InstaShop_ABV_LC,
Coalesce (IK.Unique_Customers,0) InstaShop_Unique_Customers,

FROM Vendor_Mapping VM 
LEFT JOIN Talabat_KPIs TK ON VM.date = TK.order_date AND VM.Talabat_Vendor_ID = TK.Talabat_Vendor_ID  AND TK.country_code  is not null 
LEFT JOIN InstaShop_KPIs IK ON VM.date = IK.order_date AND VM.InstaShop_Vendor_ID = IK.InstaShop_Vendor_ID AND IK.country_code  is not null]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1auk4ys1xvanzh19cir9t1qthnj5' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_performance AS
