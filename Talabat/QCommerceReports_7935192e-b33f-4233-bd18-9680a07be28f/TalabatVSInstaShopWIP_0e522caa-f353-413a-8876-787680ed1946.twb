              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0wcxn3f0khm7051gj9z2h0t94t76].[sum:InstaShop_ABV_EUR:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0wcxn3f0khm7051gj9z2h0t94t76].[sum:Talabat_ABV_EUR:qk]&quot;' />
            </groupfilter>
