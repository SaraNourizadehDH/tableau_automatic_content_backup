      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0wcxn3f0khm7051gj9z2h0t94t76' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date AGG' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wcxn3f0khm7051gj9z2h0t94t76'>
            <column caption='AOV DIFF % ' datatype='string' name='[ABV DIFF % (copy)_6016598044470140935]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Talabat_AOV_AVG_EUR]) &gt; AVG([InstaShop_AOV_AVG_EUR]) THEN&#10;    &quot;Talabat is higher by &quot; + STR(ROUND(ABS((AVG([Talabat_AOV_AVG_EUR]) - AVG([InstaShop_AOV_AVG_EUR])) / AVG([InstaShop_AOV_AVG_EUR]) * 100), 2)) + &quot;%&quot;&#10;ELSEIF AVG([InstaShop_AOV_AVG_EUR]) &gt; AVG([Talabat_AOV_AVG_EUR]) THEN&#10;    &quot;Talabat Is Lower By &quot; + STR(ROUND(ABS((AVG([Talabat_AOV_AVG_EUR]) - AVG([InstaShop_AOV_AVG_EUR])) / AVG([InstaShop_AOV_AVG_EUR]) * 100), 2)) + &quot;%&quot;&#10;ELSE&#10;    &quot;Both are equal&quot;&#10;END' />
            </column>
            <column caption='GMV DIFF %' datatype='string' name='[ABV DIFF % (copy)_6016598044481556494]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Talabat_GMV_EUR]) &gt; SUM([InstaShop_GMV_EUR]) &#10;THEN &quot;Talabat is higher by &quot; + STR(ROUND(ABS((SUM([Talabat_GMV_EUR]) - SUM([InstaShop_GMV_EUR])) / SUM([InstaShop_GMV_EUR]) * 100), 2)) + &quot;%&quot;&#10;ELSEIF SUM([InstaShop_GMV_EUR]) &gt; SUM([Talabat_GMV_EUR]) &#10;THEN &quot;Talabat Is Lower By &quot; + STR(ROUND(ABS((SUM([Talabat_GMV_EUR]) - SUM([InstaShop_GMV_EUR])) / SUM([InstaShop_GMV_EUR]) * 100), 2)) + &quot;%&quot;&#10;ELSE &quot;Both are equal&quot;&#10;END' />
            </column>
            <column caption='GMV DIFF' datatype='real' name='[ABV DIFF (copy)_6016598044479832076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Talabat_GMV_EUR])  - SUM([InstaShop_GMV_EUR]))/SUM([InstaShop_GMV_EUR])' />
            </column>
            <column caption='Successful Orders DIFF %' datatype='string' name='[AOV DIFF %  (copy)_6016598044474568714]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;SUM([Talabat_successful_orders]) &gt; SUM([InstaShop_successful_orders]) &#10;THEN &#10;&quot;Talabat Is Higher By &quot; + STR(ROUND(ABS((SUM([Talabat_successful_orders]) - SUM([InstaShop_successful_orders])) / SUM([InstaShop_successful_orders]) * 100), 2)) + &quot;%&quot;&#10;ELSEIF&#10;SUM([InstaShop_successful_orders]) &gt; SUM([Talabat_successful_orders]) &#10;THEN&#10;&quot;Talabat Is Lower By &quot; + STR(ROUND(ABS((SUM([Talabat_successful_orders]) - SUM([InstaShop_successful_orders])) / SUM([InstaShop_successful_orders]) * 100), 2)) + &quot;%&quot;&#10;ELSE&#10;&quot;Both Are Equal&quot;&#10;END' />
            </column>
            <column caption='Date AGG' datatype='string' name='[Calculation_6016598044435107840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &#10;MID(STR(DATETRUNC(&apos;year&apos;,[Order_Date])),1,4) + &quot; - &quot; + &quot; (&quot; + LEFT(DATENAME(&apos;month&apos;,[Order_Date]),3) + &quot;)&quot;&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN  MID(STR(DATETRUNC(&apos;year&apos;,[Order_Date])),1,4) + &quot; - &quot; + &quot;W &quot; +str(DATEPART(&apos;week&apos;,[Order_Date])) &#10;&#10;ELSE IF  [Parameters].[Parameter 1]  = &apos;Daily&apos;  THEN MID(STR(DATETRUNC(&apos;year&apos;,[Order_Date])),1,4) + &quot;-&quot; +str(DATEPART(&apos;month&apos;,[Order_Date])) + &quot;-&quot; + str(DATEPART(&apos;day&apos;,[Order_Date])) + &quot; - &quot;  + LEFT(DATENAME(&apos;weekday&apos;,[Order_Date]),3) &#10;ELSE &apos;&apos; END&#10;END' />
            </column>
            <column caption='ABV DIFF %' datatype='string' name='[Calculation_6016598044444135426]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Talabat_ABV_EUR]) &gt; AVG([InstaShop_ABV_EUR]) THEN&#10;    &quot;Talabat is higher by &quot; + STR(ROUND(ABS((AVG([Talabat_ABV_EUR]) - AVG([InstaShop_ABV_EUR])) / AVG([InstaShop_ABV_EUR]) * 100), 2)) + &quot;%&quot;&#10;ELSEIF AVG([InstaShop_ABV_EUR]) &gt; AVG([Talabat_ABV_EUR]) THEN&#10;    &quot;Talabat is Lower by &quot; + STR(ROUND(ABS((AVG([Talabat_ABV_EUR]) - AVG([InstaShop_ABV_EUR])) / AVG([InstaShop_ABV_EUR]) * 100), 2)) + &quot;%&quot;&#10;&#10;ELSE&#10;    &quot;Both are equal&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
