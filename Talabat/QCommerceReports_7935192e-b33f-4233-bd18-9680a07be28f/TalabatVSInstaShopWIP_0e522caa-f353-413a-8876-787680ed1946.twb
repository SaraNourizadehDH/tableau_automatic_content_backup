          <named-connection caption='BigQuery' name='bigquery.1auk4ys1xvanzh19cir9t1qthnj5'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='ahmed.elbeltagy@talabat.com' workgroup-auth-mode='prompt' />
