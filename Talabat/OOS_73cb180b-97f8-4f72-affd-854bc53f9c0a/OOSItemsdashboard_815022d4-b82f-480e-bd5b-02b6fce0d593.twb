      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0tv50st11tvc8510ibdvn0b3v86f].[usr:OOS (successful + failed)  \% (copy)_1495476584147922944:qk]&quot;' value='Orders with OOS (successful + failed) ' />
        </aliases>
      </column>
      <column caption='Rest orders' datatype='integer' name='[Calculation_1495476584173404162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_355221453234462726] - ([Calculation_408420223329861635] +[Successful order with OOS items (copy)_355221453222199296])' />
      </column>
      <column caption='All OOS items' datatype='boolean' name='[Calculation_2361856531816976384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Successful order with OOS items (copy)_99923680743272448] = True and ([pelican_status] != &apos;IN_CART&apos; or [ordered_quantity] &gt; [delivered_quantity])) or ([reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) and [pelican_status] != &apos;IN_CART&apos;)' />
      </column>
      <column caption='All orders' datatype='integer' name='[Calculation_355221453234462726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[successful orders with oos items (copy)_408420223341748229] + [Successful orders (copy)_355221453223596035]' />
      </column>
      <column caption='OOS (successful + failed)  %' datatype='real' name='[Calculation_355221453234675719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_408420223329861635] + [Successful order with OOS items (copy)_355221453222199296]) / [Calculation_355221453234462726]' />
      </column>
      <column caption='OOS failed orders' datatype='integer' name='[Calculation_408420223314087937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [reason] = &apos;ITEM_UNAVAILABLE&apos; or [reason] = &apos;MENU_ACCOUNT_SETTINGS&apos; then [order_id] END' />
      </column>
      <column caption='Successful order with OOS items' datatype='integer' name='[Calculation_408420223329861635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if ([is_successful]= True) and ([has_item_qty_modified] or [has_item_replacement])  then [order_id] END)' />
      </column>
      <column caption='Qty failed orders' datatype='integer' name='[Calculation_408420223369306120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [reason] = &apos;ITEM_UNAVAILABLE&apos; or [reason] = &apos;MENU_ACCOUNT_SETTINGS&apos; then([ordered_quantity]) END' />
      </column>
      <column caption='Other reasons %' datatype='real' name='[Failed orders OOS % (copy)_355221453224591365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Successful orders (copy)_355221453223596035] - [Successful order with OOS items (copy)_355221453222199296])/[Successful orders (copy)_355221453223596035]' />
      </column>
      <column caption='OOS Items %' datatype='real' name='[Failed orders OOS (copy)_355221453223460866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful] = FALSE and [is_net]= True and [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) then [order_id] END)/[Successful orders (copy)_355221453223596035]' />
      </column>
      <column caption='OOS (successful + failed) ' datatype='integer' name='[OOS (successful + failed)  % (copy)_1495476584147922944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_408420223329861635] + [Successful order with OOS items (copy)_355221453222199296])' />
      </column>
      <column caption='Order_id' datatype='integer' name='[Order id (copy)_1758655692305063939]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[order_id]' />
      </column>
      <column datatype='string' name='[Reason (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[reason]' new-bin='true'>
          <bin default-name='false' value='&quot;OOS Items&quot;'>
            <value>&quot;ITEM_UNAVAILABLE&quot;</value>
            <value>&quot;MENU_ACCOUNT_SETTINGS&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Other reasons&quot;'>
            <value>%null%</value>
            <value>&quot;ADDRESS_INCOMPLETE_MISSTATED&quot;</value>
            <value>&quot;Application issue / IT&quot;</value>
            <value>&quot;BAD_WEATHER&quot;</value>
            <value>&quot;CARD_READER_NOT_AVAILABLE&quot;</value>
            <value>&quot;Changed mind - Mistake / Error&quot;</value>
            <value>&quot;CONTENT_WRONG_MISLEADING&quot;</value>
            <value>&quot;COURIER_ACCIDENT&quot;</value>
            <value>&quot;COURIER_UNREACHABLE&quot;</value>
            <value>&quot;CUSTOMER_MISTAKE_ERROR&quot;</value>
            <value>&quot;CUSTOMER_UNABLE_TO_PAY&quot;</value>
            <value>&quot;DELIVERY_ETA_TOO_LONG&quot;</value>
            <value>&quot;Do not deliver to this area&quot;</value>
            <value>&quot;Duplicate order&quot;</value>
            <value>&quot;DUPLICATE_ORDER&quot;</value>
            <value>&quot;Fake Order&quot;</value>
            <value>&quot;FOOD_QUALITY_SPILLAGE&quot;</value>
            <value>&quot;FRAUD_PRANK&quot;</value>
            <value>&quot;Lack of delivery men&quot;</value>
            <value>&quot;Late delivery&quot;</value>
            <value>&quot;LATE_DELIVERY&quot;</value>
            <value>&quot;Missing / Wrong Order&quot;</value>
            <value>&quot;NEVER_DELIVERED&quot;</value>
            <value>&quot;NO_COURIER&quot;</value>
            <value>&quot;NO_PICKER&quot;</value>
            <value>&quot;ONLINE_PAYMENT&quot;</value>
            <value>&quot;ORDER_MODIFICATION_NOT_POSSIBLE&quot;</value>
            <value>&quot;OTHER&quot;</value>
            <value>&quot;OUTSIDE_DELIVERY_AREA&quot;</value>
            <value>&quot;OUTSIDE_SERVICE_HOURS&quot;</value>
            <value>&quot;PLATFORM_BAD_LOCATION&quot;</value>
