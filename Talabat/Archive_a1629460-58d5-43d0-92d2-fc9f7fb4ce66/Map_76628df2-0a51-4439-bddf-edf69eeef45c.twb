FROM `tlb-data-prod.data_platform.dim_location_info` l&#13;
JOIN zones z&#13;
  ON ST_INTERSECTS(z.zone_shape,ST_GEOGFROMTEXT(UPPER(TRIM(l.area_polygon))))&#13;
WHERE country_id = 9&#13;
AND is_active_area = TRUE&#13;
AND is_active_city = TRUE&#13;
AND l.zone_name != &apos;Unknown&apos;</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
