        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1x0cx9r0pe3ghl12c74vc0vp6gyw' name='Custom SQL Query' type='text'>WITH zones as (&#13;
SELECT&#13;
  zone_id,&#13;
  zone_name,&#13;
  zone_shape,&#13;
  ST_AREA(z.zone_shape) AS zone_area&#13;
FROM `tlb-data-prod.data_platform.dim_logistics_zone` z&#13;
WHERE country_code = &apos;eg&apos;&#13;
AND is_Active = TRUE&#13;
)&#13;
&#13;
SELECT&#13;
  z.zone_id,&#13;
  z.zone_name as z1,&#13;
  z.zone_area/1000000 zone_area,&#13;
  l.city_name,&#13;
  l.zone_name as z2,&#13;
  l.area_name,&#13;
  l.area_polygon ,&#13;
  ST_GEOGFROMTEXT(UPPER(TRIM(l.area_polygon))) AS geo_area_polygon,&#13;
  ST_AREA(ST_INTERSECTION(z.zone_shape, ST_GEOGFROMTEXT(UPPER(TRIM(l.area_polygon)))))/1000000 AS intersection_area,&#13;
FROM `tlb-data-prod.data_platform.dim_location_info` l&#13;
JOIN zones z&#13;
  ON ST_INTERSECTS(z.zone_shape,ST_GEOGFROMTEXT(UPPER(TRIM(l.area_polygon))))&#13;
WHERE country_id = 9&#13;
AND is_active_area = TRUE&#13;
AND is_active_city = TRUE&#13;
AND l.zone_name != &apos;Unknown&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1x0cx9r0pe3ghl12c74vc0vp6gyw' name='Custom SQL Query' type='text'>WITH zones as (&#13;
SELECT&#13;
