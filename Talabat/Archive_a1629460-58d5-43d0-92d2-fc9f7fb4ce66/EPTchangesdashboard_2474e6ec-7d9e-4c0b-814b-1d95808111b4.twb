              <calculation class='tableau' formula='if [Decrease eligible (copy)_3238158527119757363]=true then&#10;    if [fir_x_conf] &gt;= 0.8 and [avg_estimated_prep_time] &lt; [AVTC threshold (copy)_3238158527092109325] then [avg_estimated_prep_time]&#10;    elseif [fir_x_conf] &lt; 0.8 then [AVTC threshold (copy)_3238158527092109325]&#10;    elseif [fir_x_conf] &gt;= 0.8 and [avg_estimated_prep_time] &gt; [AVTC threshold (copy)_3238158527092109325] then [AVTC threshold (copy)_3238158527092109325]&#10;    END&#10;&#10;else null&#10;end&#10;&#10;&#10;&#10;//=IFS(&#10;//    and(FIR x Conf &gt;=0.8, EPT + buffer(50 %) &lt; 75th percentile of the cuisine),&#10;//        EPT + buffer(50 %),&#10;//    FIR x Conf &lt;0.8,&#10;//        75th percentile of the cuisine,&#10;//    AND(FIR x Conf &gt;=0.8, EPT + buffer(50 %) &gt; 75th percentile of the cuisine),&#10;//        75th percentile of the cuisine' />
