            <column caption='incr - FiR usage threshold' datatype='string' folder-name='increase threshold' name='[incr - FiR x conf threshold (copy)_593208527514341376]' param-domain-type='list' role='measure' type='nominal' value='&quot;p90&quot;'>
              <calculation class='tableau' formula='&quot;p90&quot;' />
            </column>
            <column caption='decr - Successful orders threshold' datatype='string' folder-name='decrease threshold' name='[incr - Successful orders threshold (copy)_3238158527094214670]' param-domain-type='list' role='measure' type='nominal' value='&quot;p5&quot;'>
              <calculation class='tableau' formula='&quot;p5&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wj3ihy0dubbk916iunn51mdt8d4'>
            <column caption='incr - AVTC threshold' datatype='real' name='[% on time threshold (copy)_3238158527086964742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Successful orders threshold (copy)_3238158527085690883]&#10;when &apos;p5&apos; then [avtc_p5]&#10;when &apos;p10&apos; then [avtc_p10]&#10;when &apos;p15&apos; then [avtc_p15]&#10;when &apos;p20&apos; then [avtc_p20]&#10;when &apos;p25&apos; then [avtc_p25]&#10;when &apos;p30&apos; then [avtc_p30]&#10;when &apos;p40&apos; then [avtc_p40]&#10;when &apos;p50&apos; then [avtc_p50]&#10;when &apos;p60&apos; then [avtc_p60]&#10;when &apos;p70&apos; then [avtc_p70]&#10;when &apos;p75&apos; then [avtc_p75]&#10;when &apos;p80&apos; then [avtc_p80]&#10;when &apos;p85&apos; then [avtc_p85]&#10;when &apos;p90&apos; then [avtc_p90]&#10;when &apos;p95&apos; then [avtc_p95]&#10;when &apos;p98&apos; then [avtc_p98]&#10;end' />
            </column>
            <column caption='incr - Cuisine EPT Threshold' datatype='real' name='[AVTC threshold (copy)_3238158527092109325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;p5&apos; then [ept_p5]&#10;when &apos;p10&apos; then [ept_p10]&#10;when &apos;p15&apos; then [ept_p15]&#10;when &apos;p20&apos; then [ept_p20]&#10;when &apos;p25&apos; then [ept_p25]&#10;when &apos;p30&apos; then [ept_p30]&#10;when &apos;p40&apos; then [ept_p40]&#10;when &apos;p50&apos; then [ept_p50]&#10;when &apos;p60&apos; then [ept_p60]&#10;when &apos;p70&apos; then [ept_p70]&#10;when &apos;p75&apos; then [ept_p75]&#10;when &apos;p80&apos; then [ept_p80]&#10;when &apos;p85&apos; then [ept_p85]&#10;when &apos;p90&apos; then [ept_p90]&#10;when &apos;p95&apos; then [ept_p95]&#10;when &apos;p98&apos; then [ept_p98]&#10;end' />
            </column>
            <column caption='incr - % on time threshold' datatype='real' name='[Calculation_3238158527085961221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Successful orders threshold (copy)_3238158527083122689]&#10;when &apos;p5&apos; then [order_on_time_p5]&#10;when &apos;p10&apos; then [order_on_time_p10]&#10;when &apos;p15&apos; then [order_on_time_p15]&#10;when &apos;p20&apos; then [order_on_time_p20]&#10;when &apos;p25&apos; then [order_on_time_p25]&#10;when &apos;p30&apos; then [order_on_time_p30]&#10;when &apos;p40&apos; then [order_on_time_p40]&#10;when &apos;p50&apos; then [order_on_time_p50]&#10;when &apos;p60&apos; then [order_on_time_p60]&#10;when &apos;p70&apos; then [order_on_time_p70]&#10;when &apos;p75&apos; then [order_on_time_p75]&#10;when &apos;p80&apos; then [order_on_time_p80]&#10;when &apos;p85&apos; then [order_on_time_p85]&#10;when &apos;p90&apos; then [order_on_time_p90]&#10;when &apos;p95&apos; then [order_on_time_p95]&#10;when &apos;p98&apos; then [order_on_time_p98]&#10;end' />
            </column>
            <column caption='incr - Delta bw FiR &amp; EPT threshold' datatype='integer' name='[Calculation_3238158527090515980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[EPT Threshold (cuisine) (copy)]' />
            </column>
            <column caption='Delta FiR &amp; EPT' datatype='real' name='[Calculation_3238158527096746011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_estimated_prep_time]-[avg_fir_prep_time]' />
            </column>
            <column caption='decr - eligible % on time' datatype='boolean' name='[Calculation_3238158527100121125]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[decr - % on time threshold (copy)]&#10;when &apos;greater than or equal to&apos; then iif([order_on_time]&gt;=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;greater than&apos; then iif([order_on_time]&gt;[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;less than or equal to&apos; then iif([order_on_time]&lt;=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;less than or equal to&apos; then iif([order_on_time]&lt;[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;equal to&apos; then iif([order_on_time]=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;end' />
            </column>
            <column caption='Decrease eligible' datatype='boolean' name='[Calculation_3238158527119114290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([decr - eligible % on time (copy)_3238158527100735526]&#10;    and [decr - eligible AVTC (copy)_3238158527101272103]&#10;    and [Calculation_3238158527100121125]&#10;    and [decr - eligible FiR x conf (copy)_3238158527101636648] &#10;    and [decr - eligible successful orders (copy)_3238158527101906985]&#10;) then true&#10;else false&#10;end' />
            </column>
            <column caption='Vendor action' datatype='string' name='[Calculation_3238158527120564276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Decrease eligible (copy)_3238158527119757363] then &apos;Increase&apos;&#10;elseif [Calculation_3238158527119114290] then &apos;Decrease&apos;&#10;else &apos;No action&apos;&#10;end' />
            </column>
            <column caption='Proposed EPT' datatype='real' name='[Calculation_3238158527121842229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Calculation_3238158527120564276]&#10;&#10;when &apos;Decrease&apos; then&#10;    if [avg_fir_prep_time]&lt;10 then [avg_fir_prep_time] else [avg_fir_prep_time] + [avg_at_vendor_time_cleaned] END&#10;&#10;when &apos;Increase&apos; then&#10;    if [fir_x_conf] &gt;= 0.8 and [avg_estimated_prep_time] &lt; [AVTC threshold (copy)_3238158527092109325] then [avg_estimated_prep_time]&#10;    elseif [fir_x_conf] &lt; 0.8 then [AVTC threshold (copy)_3238158527092109325]&#10;    elseif [fir_x_conf] &gt;= 0.8 and [avg_estimated_prep_time] &gt; [AVTC threshold (copy)_3238158527092109325] then [AVTC threshold (copy)_3238158527092109325]&#10;    END&#10;&#10;else null&#10;end&#10;&#10;&#10;&#10;//=IFS(&#10;//    and(FIR x Conf &gt;=0.8, EPT + buffer(50 %) &lt; 75th percentile of the cuisine),&#10;//        EPT + buffer(50 %),&#10;//    FIR x Conf &lt;0.8,&#10;//        75th percentile of the cuisine,&#10;//    AND(FIR x Conf &gt;=0.8, EPT + buffer(50 %) &gt; 75th percentile of the cuisine),&#10;//        75th percentile of the cuisine' />
            </column>
            <column caption='Order share %' datatype='real' name='[Calculation_3238158527138406454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_count]/[country_successful_orders_count]' />
            </column>
            <column caption='Increase eligible' datatype='boolean' name='[Decrease eligible (copy)_3238158527119757363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([decr - eligible AVTC (copy)_3238158527102382123]&#10;    and [decr - eligible % on time (copy)_3238158527102382122]&#10;    and [incr - eligible FiR x conf (copy)_593208527519014916]&#10;    and [incr - eligible FiR usage (copy)_593208527520464903] &#10;    and [decr - delta bw FiR &amp; EPT (copy)_3238158527102382126]&#10;) then true&#10;else false&#10;end' />
            </column>
            <column caption='Avg DT' datatype='real' name='[avg_actual_delivery_time]' role='measure' type='quantitative' />
            <column caption='Avg AVTC' datatype='real' name='[avg_at_vendor_time_cleaned]' role='measure' type='quantitative' />
            <column caption='Avg EPT + AVTC' datatype='real' name='[avg_ept_avtc]' role='measure' type='quantitative' />
            <column caption='Avg EPT' datatype='real' name='[avg_estimated_prep_time]' role='measure' type='quantitative' />
            <column caption='Avg FiR PT' datatype='real' name='[avg_fir_prep_time]' role='measure' type='quantitative' />
            <column caption='Avg PDT' datatype='real' name='[avg_promised_delivery_time]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p10]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p15]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p20]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p25]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p30]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p40]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p50]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p5]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p60]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p70]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p75]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p80]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p85]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p90]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p95]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p98]' role='measure' type='quantitative' />
            <column caption='Chain name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[country_successful_orders_count]' role='measure' type='quantitative' />
            <column caption='incr - eligible delta bw FiR &amp; EPT' datatype='boolean' name='[decr - delta bw FiR &amp; EPT (copy)_3238158527102382126]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[decr - Delta bw FiR &amp; EPT comp (copy)_3238158527098441763]&#10;when &apos;greater than or equal to&apos; then    iif([Calculation_3238158527096746011]&gt;=        [Calculation_3238158527090515980],true,false)&#10;when &apos;greater than&apos; then                iif([Calculation_3238158527096746011]&gt;         [Calculation_3238158527090515980],true,false)&#10;when &apos;less than or equal to&apos; then       iif([Calculation_3238158527096746011]&lt;=        [Calculation_3238158527090515980],true,false)&#10;when &apos;less than&apos; then                   iif([Calculation_3238158527096746011]&lt;         [Calculation_3238158527090515980],true,false)&#10;when &apos;equal to&apos; then                    iif([Calculation_3238158527096746011]=         [Calculation_3238158527090515980],true,false)&#10;when &apos;not considered&apos; then true&#10;end' />
            </column>
            <column caption='decr - eligible AVTC' datatype='boolean' name='[decr - eligible % on time (copy)_3238158527100735526]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[decr - % on time comp (copy)_3238158527097913372]&#10;when &apos;greater than or equal to&apos; then    iif([avg_at_vendor_time_cleaned]&gt;=        [incr - AVTC threshold (copy)_3238158527095197717],true,false)&#10;when &apos;greater than&apos; then                iif([avg_at_vendor_time_cleaned]&gt;         [incr - AVTC threshold (copy)_3238158527095197717],true,false)&#10;when &apos;less than or equal to&apos; then       iif([avg_at_vendor_time_cleaned]&lt;=        [incr - AVTC threshold (copy)_3238158527095197717],true,false)&#10;when &apos;less than or equal to&apos; then       iif([avg_at_vendor_time_cleaned]&lt;         [incr - AVTC threshold (copy)_3238158527095197717],true,false)&#10;when &apos;equal to&apos; then                    iif([avg_at_vendor_time_cleaned]=         [incr - AVTC threshold (copy)_3238158527095197717],true,false)&#10;end' />
            </column>
            <column caption='incr - eligible % on time' datatype='boolean' name='[decr - eligible % on time (copy)_3238158527102382122]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[decr - % on time comp (copy)_3238158527098441761]&#10;when &apos;greater than or equal to&apos; then iif([order_on_time]&gt;=[Calculation_3238158527085961221],true,false)&#10;when &apos;greater than&apos; then iif([order_on_time]&gt;[Calculation_3238158527085961221],true,false)&#10;when &apos;less than or equal to&apos; then iif([order_on_time]&lt;=[Calculation_3238158527085961221],true,false)&#10;when &apos;less than&apos; then iif([order_on_time]&lt;[Calculation_3238158527085961221],true,false)&#10;when &apos;equal to&apos; then iif([order_on_time]=[Calculation_3238158527085961221],true,false)&#10;when &apos;not considered&apos; then true&#10;end' />
