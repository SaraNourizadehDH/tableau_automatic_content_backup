            </clause>
            <relation connection='bigquery.1j2wru2135xwz51e06wry1y5cxso' name='All Vendors' type='text'><![CDATA[select
  country_code,
  main_cuisine,
  chain_name,
  vendor_id,
  vendor_name,
  successful_orders_count,
  avg_ept_avtc,
  avg_estimated_prep_time,
  avg_at_vendor_time_cleaned,
  avg_fir_prep_time,  --this is the targeted benchmark for prep time changes. if this is higher than the 75p of cuisine, then use the 75th of cuisine, set a threshold for reduction based on % of reduction
  safe_divide(fir_used_count,count_primary_rider_near_resturant) as fir_percentage,
  safe_divide(fir_confident_use_nominator,fir_confident_use_denominator) as fir_confidence,
  safe_divide(fir_confident_use_nominator,fir_confident_use_denominator) * safe_divide(fir_used_count,count_primary_rider_near_resturant) as fir_x_conf,
  avg_actual_delivery_time,
  avg_promised_delivery_time,
  safe_divide(order_on_time_helper,completed_orders_count) as order_on_time,
  safe_divide(vendor_delay_v2_10mins,total_vendor_late_v2_orders) as vendor_delay_v2_10mins_percentage,
    from (
    SELECT
    lower(oi.country_iso) as country_code,
    c.main_cuisine  AS main_cuisine,
    c.chain_name  AS chain_name,
    v.source_system_vendor_id  AS vendor_id,
    v.vendor_name  AS vendor_name,
    COALESCE(SUM(CASE WHEN oi.is_successful  THEN 1  ELSE NULL END), 0) AS successful_orders_count,
    AVG(( o.estimated_prep_time/60  ) + ( o.at_vendor_time_cleaned/60 )) AS avg_ept_avtc,
    AVG(o.estimated_prep_time/60 ) AS avg_estimated_prep_time,
    AVG(o.at_vendor_time_cleaned/60 ) AS avg_at_vendor_time_cleaned,
    AVG(( TIMESTAMP_DIFF(o.vendor_prepared_at , o.sent_to_vendor_at , MINUTE))) AS avg_fir_prep_time,
    COUNT(DISTINCT CASE WHEN o.fir_used  THEN o.order_code  ELSE NULL END) AS fir_used_count,
    COUNT(DISTINCT CASE WHEN ( o.primary_rider_near_restaurant_at   IS NOT NULL) THEN o.order_code  ELSE NULL END) AS count_primary_rider_near_resturant,
    COUNT(DISTINCT CASE WHEN o.is_fir_confident_use  THEN o.order_code  ELSE NULL END) AS fir_confident_use_nominator,
    COUNT(DISTINCT CASE WHEN ((( o.is_fir_confident_use  ) IS NOT NULL)) THEN o.order_code  ELSE NULL END) AS fir_confident_use_denominator,
    AVG(o.actual_delivery_time/60 ) AS avg_actual_delivery_time,
    AVG(o.promised_delivery_time/60 ) AS avg_promised_delivery_time,
    COUNT(DISTINCT CASE WHEN ((( case when o.order_status = 'completed' then ((o.actual_delivery_time/60) - (o.promised_delivery_time/60))
      else null end ) >> -10 AND ( case when o.order_status = 'completed' then ((o.actual_delivery_time/60) - (o.promised_delivery_time/60))
      else null end ) << 10)) THEN o.order_code  ELSE NULL END) AS order_on_time_helper,
    COUNT(DISTINCT CASE WHEN (UPPER( o.order_status  ) = UPPER('completed')) THEN o.order_code  ELSE NULL END) AS completed_orders_count,
    COUNT(DISTINCT CASE WHEN (( o.vendor_delay_v2/60  ) >> 10) THEN o.order_code  ELSE NULL END) AS vendor_delay_v2_10mins,
    COUNT(DISTINCT CASE WHEN NOT (( o.vendor_delay_v2/60  ) IS NULL) THEN o.order_code  ELSE NULL END) AS total_vendor_late_v2_orders,

    FROM `tlb-data-prod.data_platform.fct_order_info`
      AS oi
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order`
      AS o ON o.order_id = oi.order_id and o.is_talabat and o.is_rider_order
    INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
      AS v ON v.vendor_id = oi.vendor_id
    INNER JOIN `tlb-data-prod.data_platform.dim_chain`
      AS c ON c.chain_id = oi.chain_id
    INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
      AS ci ON ci.country_id = oi.country_id

          WHERE oi.is_tgo
          AND NOT v.is_non_food
          AND oi.order_date >>= DATE_ADD(CURRENT_DATE(), INTERVAL -14 DAY)
          and oi.country_iso <<>> 'SA'
          GROUP BY
              1,
              2,
              3,
              4,
              5
          HAVING successful_orders_count >> 10)]]></relation>
            <relation connection='bigquery.1j2wru2135xwz51e06wry1y5cxso' name='Country threshold' type='text'><![CDATA[with metrics as (
select
  country_code,
  main_cuisine,
  chain_name,
  vendor_id,
  vendor_name,
  successful_orders_count,
  avg_ept_avtc,
  avg_estimated_prep_time,
  avg_at_vendor_time_cleaned,
  avg_fir_prep_time,  --this is the targeted benchmark for prep time changes. if this is higher than the 75p of cuisine, then use the 75th of cuisine, set a threshold for reduction based on % of reduction
  safe_divide(fir_used_count,count_primary_rider_near_resturant) as fir_percentage,
    safe_divide(fir_confident_use_nominator,fir_confident_use_denominator) as fir_confidence,
  safe_divide(fir_confident_use_nominator,fir_confident_use_denominator) * safe_divide(fir_used_count,count_primary_rider_near_resturant) as fir_x_conf,
  avg_actual_delivery_time,
  avg_promised_delivery_time,
  safe_divide(order_on_time_helper,completed_orders_count) as order_on_time,
  safe_divide(vendor_delay_v2_10mins,total_vendor_late_v2_orders) as vendor_delay_v2_10mins_percentage,
    from (
    SELECT
    lower(oi.country_iso) as country_code,
    c.main_cuisine  AS main_cuisine,
    c.chain_name  AS chain_name,
    v.source_system_vendor_id  AS vendor_id,
    v.vendor_name  AS vendor_name,
    COALESCE(SUM(CASE WHEN oi.is_successful  THEN 1  ELSE NULL END), 0) AS successful_orders_count,
    AVG(( o.estimated_prep_time/60  ) + ( o.at_vendor_time_cleaned/60 )) AS avg_ept_avtc,
    AVG(o.estimated_prep_time/60 ) AS avg_estimated_prep_time,
    AVG(o.at_vendor_time_cleaned/60 ) AS avg_at_vendor_time_cleaned,
    AVG(( TIMESTAMP_DIFF(o.vendor_prepared_at , o.sent_to_vendor_at , MINUTE))) AS avg_fir_prep_time,
    COUNT(DISTINCT CASE WHEN o.fir_used  THEN o.order_code  ELSE NULL END) AS fir_used_count,
    COUNT(DISTINCT CASE WHEN ( o.primary_rider_near_restaurant_at   IS NOT NULL) THEN o.order_code  ELSE NULL END) AS count_primary_rider_near_resturant,
    COUNT(DISTINCT CASE WHEN o.is_fir_confident_use  THEN o.order_code  ELSE NULL END) AS fir_confident_use_nominator,
    COUNT(DISTINCT CASE WHEN ((( o.is_fir_confident_use  ) IS NOT NULL)) THEN o.order_code  ELSE NULL END) AS fir_confident_use_denominator,
    AVG(o.actual_delivery_time/60 ) AS avg_actual_delivery_time,
    AVG(o.promised_delivery_time/60 ) AS avg_promised_delivery_time,
    COUNT(DISTINCT CASE WHEN ((( case when o.order_status = 'completed' then ((o.actual_delivery_time/60) - (o.promised_delivery_time/60))
      else null end ) >> -10 AND ( case when o.order_status = 'completed' then ((o.actual_delivery_time/60) - (o.promised_delivery_time/60))
      else null end ) << 10)) THEN o.order_code  ELSE NULL END) AS order_on_time_helper,
    COUNT(DISTINCT CASE WHEN (UPPER( o.order_status  ) = UPPER('completed')) THEN o.order_code  ELSE NULL END) AS completed_orders_count,
    COUNT(DISTINCT CASE WHEN (( o.vendor_delay_v2/60  ) >> 10) THEN o.order_code  ELSE NULL END) AS vendor_delay_v2_10mins,
    COUNT(DISTINCT CASE WHEN NOT (( o.vendor_delay_v2/60  ) IS NULL) THEN o.order_code  ELSE NULL END) AS total_vendor_late_v2_orders,

    FROM `tlb-data-prod.data_platform.fct_order_info`
      AS oi
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order`
      AS o ON o.order_id = oi.order_id and o.is_talabat and o.is_rider_order
    INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
      AS v ON v.vendor_id = oi.vendor_id
    INNER JOIN `tlb-data-prod.data_platform.dim_chain`
      AS c ON c.chain_id = oi.chain_id
    INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
      AS ci ON ci.country_id = oi.country_id

          WHERE oi.is_tgo
          AND NOT v.is_non_food
          AND oi.order_date >>= DATE_ADD(CURRENT_DATE(), INTERVAL -14 DAY)
          and oi.country_iso <<>> 'SA'
          GROUP BY
              1,
              2,
              3,
              4,
              5
          HAVING successful_orders_count >> 10)
  )


select
country_code,

    sum(successful_orders_count) as country_successful_orders_count,

  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(5)] as avtc_p5,
  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(10)] as avtc_p10,
  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(15)] as avtc_p15,
  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(20)] as avtc_p20,
