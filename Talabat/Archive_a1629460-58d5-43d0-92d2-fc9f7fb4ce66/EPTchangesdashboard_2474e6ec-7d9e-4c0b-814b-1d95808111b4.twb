            <column caption='incr - FiR confidence threshold' datatype='string' folder-name='increase threshold' name='[incr - FiR usage threshold (copy)_593208527514517505]' param-domain-type='list' role='measure' type='nominal' value='&quot;p80&quot;'>
              <calculation class='tableau' formula='&quot;p80&quot;' />
            </column>
            <column caption='incr - FiR confidence comp' datatype='string' folder-name='increase comparison' name='[incr - FiR x conf comp (copy)_593208527514636290]' param-domain-type='list' role='measure' type='nominal' value='&quot;greater than&quot;'>
              <calculation class='tableau' formula='&quot;greater than&quot;' />
            </column>
            <column caption='decr - FiR x conf threshold' datatype='string' folder-name='decrease threshold' name='[incr - FiR x conf threshold (copy)_3238158527094214674]' param-domain-type='list' role='measure' type='nominal' value='&quot;p25&quot;'>
              <calculation class='tableau' formula='&quot;p25&quot;' />
