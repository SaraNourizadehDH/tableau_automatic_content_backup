          <datasource-dependencies datasource='federated.1wj3ihy0dubbk916iunn51mdt8d4'>
            <column caption='incr - AVTC threshold' datatype='real' name='[% on time threshold (copy)_3238158527086964742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Successful orders threshold (copy)_3238158527085690883]&#10;when &apos;p5&apos; then [avtc_p5]&#10;when &apos;p10&apos; then [avtc_p10]&#10;when &apos;p15&apos; then [avtc_p15]&#10;when &apos;p20&apos; then [avtc_p20]&#10;when &apos;p25&apos; then [avtc_p25]&#10;when &apos;p30&apos; then [avtc_p30]&#10;when &apos;p40&apos; then [avtc_p40]&#10;when &apos;p50&apos; then [avtc_p50]&#10;when &apos;p60&apos; then [avtc_p60]&#10;when &apos;p70&apos; then [avtc_p70]&#10;when &apos;p75&apos; then [avtc_p75]&#10;when &apos;p80&apos; then [avtc_p80]&#10;when &apos;p85&apos; then [avtc_p85]&#10;when &apos;p90&apos; then [avtc_p90]&#10;when &apos;p95&apos; then [avtc_p95]&#10;when &apos;p98&apos; then [avtc_p98]&#10;end' />
            </column>
            <column caption='incr - % on time threshold' datatype='real' name='[Calculation_3238158527085961221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Successful orders threshold (copy)_3238158527083122689]&#10;when &apos;p5&apos; then [order_on_time_p5]&#10;when &apos;p10&apos; then [order_on_time_p10]&#10;when &apos;p15&apos; then [order_on_time_p15]&#10;when &apos;p20&apos; then [order_on_time_p20]&#10;when &apos;p25&apos; then [order_on_time_p25]&#10;when &apos;p30&apos; then [order_on_time_p30]&#10;when &apos;p40&apos; then [order_on_time_p40]&#10;when &apos;p50&apos; then [order_on_time_p50]&#10;when &apos;p60&apos; then [order_on_time_p60]&#10;when &apos;p70&apos; then [order_on_time_p70]&#10;when &apos;p75&apos; then [order_on_time_p75]&#10;when &apos;p80&apos; then [order_on_time_p80]&#10;when &apos;p85&apos; then [order_on_time_p85]&#10;when &apos;p90&apos; then [order_on_time_p90]&#10;when &apos;p95&apos; then [order_on_time_p95]&#10;when &apos;p98&apos; then [order_on_time_p98]&#10;end' />
            </column>
            <column caption='incr - Delta bw FiR &amp; EPT threshold' datatype='integer' name='[Calculation_3238158527090515980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[EPT Threshold (cuisine) (copy)]' />
            </column>
            <column caption='Delta FiR &amp; EPT' datatype='real' name='[Calculation_3238158527096746011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_estimated_prep_time]-[avg_fir_prep_time]' />
            </column>
            <column caption='decr - eligible % on time' datatype='boolean' name='[Calculation_3238158527100121125]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[decr - % on time threshold (copy)]&#10;when &apos;greater than or equal to&apos; then iif([order_on_time]&gt;=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;greater than&apos; then iif([order_on_time]&gt;[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;less than or equal to&apos; then iif([order_on_time]&lt;=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;less than or equal to&apos; then iif([order_on_time]&lt;[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;when &apos;equal to&apos; then iif([order_on_time]=[incr - % on time threshold (copy)_3238158527095197720],true,false)&#10;end' />
            </column>
            <column caption='Decrease eligible' datatype='boolean' name='[Calculation_3238158527119114290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([decr - eligible % on time (copy)_3238158527100735526]&#10;    and [decr - eligible AVTC (copy)_3238158527101272103]&#10;    and [Calculation_3238158527100121125]&#10;    and [decr - eligible FiR x conf (copy)_3238158527101636648] &#10;    and [decr - eligible successful orders (copy)_3238158527101906985]&#10;) then true&#10;else false&#10;end' />
            </column>
            <column caption='Vendor action' datatype='string' name='[Calculation_3238158527120564276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Decrease eligible (copy)_3238158527119757363] then &apos;Increase&apos;&#10;elseif [Calculation_3238158527119114290] then &apos;Decrease&apos;&#10;else &apos;No action&apos;&#10;end' />
            </column>
            <column caption='Increase eligible' datatype='boolean' name='[Decrease eligible (copy)_3238158527119757363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([decr - eligible AVTC (copy)_3238158527102382123]&#10;    and [decr - eligible % on time (copy)_3238158527102382122]&#10;    and [incr - eligible FiR x conf (copy)_593208527519014916]&#10;    and [incr - eligible FiR usage (copy)_593208527520464903] &#10;    and [decr - delta bw FiR &amp; EPT (copy)_3238158527102382126]&#10;) then true&#10;else false&#10;end' />
            </column>
            <column caption='Avg AVTC' datatype='real' name='[avg_at_vendor_time_cleaned]' role='measure' type='quantitative' />
            <column caption='Avg EPT' datatype='real' name='[avg_estimated_prep_time]' role='measure' type='quantitative' />
            <column caption='Avg FiR PT' datatype='real' name='[avg_fir_prep_time]' role='measure' type='quantitative' />
            <column datatype='real' name='[avtc_p10]' role='measure' type='quantitative' />
