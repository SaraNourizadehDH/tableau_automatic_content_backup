            <column caption='incr - Cuisine EPT Threshold' datatype='real' name='[AVTC threshold (copy)_3238158527092109325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;p5&apos; then [ept_p5]&#10;when &apos;p10&apos; then [ept_p10]&#10;when &apos;p15&apos; then [ept_p15]&#10;when &apos;p20&apos; then [ept_p20]&#10;when &apos;p25&apos; then [ept_p25]&#10;when &apos;p30&apos; then [ept_p30]&#10;when &apos;p40&apos; then [ept_p40]&#10;when &apos;p50&apos; then [ept_p50]&#10;when &apos;p60&apos; then [ept_p60]&#10;when &apos;p70&apos; then [ept_p70]&#10;when &apos;p75&apos; then [ept_p75]&#10;when &apos;p80&apos; then [ept_p80]&#10;when &apos;p85&apos; then [ept_p85]&#10;when &apos;p90&apos; then [ept_p90]&#10;when &apos;p95&apos; then [ept_p95]&#10;when &apos;p98&apos; then [ept_p98]&#10;end' />
