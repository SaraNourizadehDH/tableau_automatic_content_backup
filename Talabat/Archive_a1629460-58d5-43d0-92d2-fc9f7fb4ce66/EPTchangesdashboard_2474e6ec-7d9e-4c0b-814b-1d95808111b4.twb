  approx_quantiles(fir_x_conf,100)[offset(75)] as fir_x_conf_p75,
  approx_quantiles(fir_x_conf,100)[offset(80)] as fir_x_conf_p80,
  approx_quantiles(fir_x_conf,100)[offset(85)] as fir_x_conf_p85,
  approx_quantiles(fir_x_conf,100)[offset(90)] as fir_x_conf_p90,
  approx_quantiles(fir_x_conf,100)[offset(95)] as fir_x_conf_p95,
