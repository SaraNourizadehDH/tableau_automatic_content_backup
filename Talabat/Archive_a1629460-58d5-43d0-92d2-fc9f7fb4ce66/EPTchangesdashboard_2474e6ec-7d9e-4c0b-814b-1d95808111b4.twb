  approx_quantiles(fir_percentage,100)[offset(95)] as fir_percentage_p95,
  approx_quantiles(fir_percentage,100)[offset(98)] as fir_percentage_p98,

  approx_quantiles(fir_confidence,100)[offset(5)] as fir_confidence_p5,
