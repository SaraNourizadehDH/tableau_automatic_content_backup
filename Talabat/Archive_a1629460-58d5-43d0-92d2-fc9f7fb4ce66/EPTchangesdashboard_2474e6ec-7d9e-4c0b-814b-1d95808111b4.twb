              <calculation class='tableau' formula='case [Parameters].[incr - FiR x conf comp (copy)_593208527514636290]&#10;when &apos;greater than or equal to&apos; then    iif([fir_confidence]&gt;=        [incr - FiR usage threshold (copy)_593208527520026630],true,false)&#10;when &apos;greater than&apos; then                iif([fir_confidence]&gt;         [incr - FiR usage threshold (copy)_593208527520026630],true,false)&#10;when &apos;less than or equal to&apos; then       iif([fir_confidence]&lt;=        [incr - FiR usage threshold (copy)_593208527520026630],true,false)&#10;when &apos;less than&apos; then                   iif([fir_confidence]&lt;         [incr - FiR usage threshold (copy)_593208527520026630],true,false)&#10;when &apos;equal to&apos; then                    iif([fir_confidence]=         [incr - FiR usage threshold (copy)_593208527520026630],true,false)&#10;when &apos;not considered&apos; then true&#10;end' />
