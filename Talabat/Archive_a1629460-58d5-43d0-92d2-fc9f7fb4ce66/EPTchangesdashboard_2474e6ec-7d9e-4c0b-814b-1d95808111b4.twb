            <column caption='incr - FiR usage comp' datatype='string' folder-name='increase comparison' name='[incr - FiR confidence comp (copy)_593208527514738691]' param-domain-type='list' role='measure' type='nominal' value='&quot;greater than&quot;'>
              <calculation class='tableau' formula='&quot;greater than&quot;' />
