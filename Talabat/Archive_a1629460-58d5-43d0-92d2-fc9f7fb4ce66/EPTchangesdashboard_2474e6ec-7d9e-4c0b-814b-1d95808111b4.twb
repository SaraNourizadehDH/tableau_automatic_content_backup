  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(95)] as avtc_p95,
  approx_quantiles(avg_at_vendor_time_cleaned,100)[offset(98)] as avtc_p98,

  approx_quantiles(avg_fir_prep_time,100)[offset(5)] as fir_prep_p5,
  approx_quantiles(avg_fir_prep_time,100)[offset(10)] as fir_prep_p10,
  approx_quantiles(avg_fir_prep_time,100)[offset(15)] as fir_prep_p15,
