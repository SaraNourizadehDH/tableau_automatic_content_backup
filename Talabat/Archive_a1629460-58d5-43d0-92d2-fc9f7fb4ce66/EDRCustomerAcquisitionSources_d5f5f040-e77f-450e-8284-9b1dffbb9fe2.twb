  <datasources>
    <datasource caption='EDR Customer Retention' inline='true' name='federated.0p1ezr10p741h113crnhy13hr5f1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ki4xmd0l8qfx31b3cpj70t7onsg'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[edr_retention_base].[vendor_id]' />
              <expression op='[dim_vendor].[vendor_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0ki4xmd0l8qfx31b3cpj70t7onsg' name='edr_retention_base' type='text'>WITH
incentive_acq_base AS
        (
        SELECT
        COALESCE((CASE WHEN incentive_sub_type = &apos;gem&apos; THEN &quot;GEM&quot; ELSE i.campaign_name END),NULL) AS incentive_campaign_name,
        o.analytical_customer_id,
        i.incentive_amount_lc,
        i.campaign_group,
        i.order_id,
        i.incentive_sub_type,
        i.incentive_type,
        did.targeted_segment_name,
        COUNT( i.order_id) OVER(PARTITION BY  i.order_id) as no_of_incentives,
        CASE 
                WHEN MAX(CASE WHEN targeted_segment_name = &quot;NEW_CUSTOMER&quot; THEN CONCAT(&quot;FTU - &quot;, i.campaign_name) END)
         OVER(PARTITION BY i.order_id) IS NOT NULL THEN 
                MAX(CASE WHEN targeted_segment_name = &quot;NEW_CUSTOMER&quot; THEN CONCAT(&quot;FTU - &quot;, i.campaign_name) END)
        OVER(PARTITION BY i.order_id)
                WHEN i.incentive_amount_lc = MAX(i.incentive_amount_lc) OVER(PARTITION BY i.order_id) THEN 
        COALESCE(
                CASE   
                WHEN incentive_sub_type = &quot;voucher wallet&quot; THEN &quot;Talabat Offer &amp; Wallet Discounts&quot;
                WHEN incentive_sub_type = &apos;gem&apos; THEN &quot;GEM&quot;
                WHEN incentive_sub_type = &apos;discounted delivery&apos; THEN &quot;RDF&quot;
                WHEN incentive_sub_type = &apos;free delivery&apos; THEN &quot;Free Delivery&quot;
                ELSE i.campaign_name 
                END,
        NULL
        ) 
        ELSE NULL END AS final_discount_type,
        FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` i
        LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = i.vendor_id
        LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` o on i.order_id = o.order_id 
        LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` did on did.campaign_id=i.campaign_id
        LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` r on r.order_id = i.order_id
        WHERE 
        -- DATE_TRUNC(i.order_date,month) = &quot;2024-09-01&quot;
        DATE_TRUNC(i.order_date,month) &gt;&gt;= &quot;2024-07-01&quot;
        AND  o.is_successful
        AND r.customer_vendor_order_index = 1
        -- AND v.vendor_id = 608996
        AND o.chain_id IN (603153,659775,670444,676645)
        -- AND o.order_id IN(1756296287,1737436382,1741055349,1740087923)
        ),
        
        pre_final_incentives AS
        (SELECT
        *,
        MAX(final_discount_type) OVER(PARTITION BY order_id) final_campaign_name,
        FROM
        incentive_acq_base),


        final_order_incentive_acq AS
        (
                SELECT 
                *,
                (CASE 
                                ------ GEM ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%GEM%&quot;) THEN &quot;GEM&quot;
                                ------- FTU Menu Discounts -------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 20% off Menu%&quot;) THEN &quot;FTU - 20% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 30% off Menu%&quot;) THEN &quot;FTU - 30% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 40% off Menu%&quot;) THEN &quot;FTU - 40% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 50% off Menu%&quot;) THEN &quot;FTU - 50% Off Menu Discount&quot;
                                ------- Menu Discounts -------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%20% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot; THEN &quot;20% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%30% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;30% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%40% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;40% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%50% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;50% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Flash Sale%&quot;) THEN &quot;Flash Sale&quot;
                                ------ FTU Item Discounts ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 20% off Item%&quot;) THEN &quot;FTU - 20% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 30% off Item%&quot;) THEN &quot;FTU - 30% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 40% off Item%&quot;) THEN &quot;FTU - 40% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 50% off Item%&quot;) THEN &quot;FTU - 50% Off Item Discount&quot;                                
                                ------ Item Discounts ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%20% off%&quot;) AND incentive_sub_type = &quot;item discount&quot; THEN &quot;20% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%30% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;30% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%40% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;40% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%50% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;50% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Under AED 30%&quot;) THEN &quot;Under 30 AED (ID)&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%15% off selected items%&quot;) THEN &quot;15% off Item Discount (BS)&quot;
                                ------ RDF ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%RDF%&quot;) THEN &quot;RDF&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Free Delivery%&quot;) THEN &quot;Free Delivery&quot;

                                ----- Other -----
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%15% off selected items%&quot;) THEN &quot;15% off Item Discount (BS)&quot;
                                WHEN LOWER(final_campaign_name) = LOWER(&quot;Talabat Offer &amp; Wallet Discounts&quot;) THEN &quot;Talabat Offer &amp; Wallet Discounts&quot;
                        END)
                AS incentive_type_group
        FROM pre_final_incentives
        ),

        incentive_pre_final AS
        (
                SELECT
                analytical_customer_id,
                order_id,
                final_campaign_name
                FROM final_order_incentive_acq
        ),

        incentive_final AS
        (
                SELECT
                analytical_customer_id,
                order_id,
                final_campaign_name as incentive_acquired_type
                FROM pre_final_incentives
                GROUP BY ALL
        ),

        base AS
        (
                SELECT 
                o.order_date,
                o.vendor_id,
                o.order_id,
                r.customer_vendor_order_index,
                o.analytical_customer_id,
                o.gmv_amount_lc,
                o.incentive_amount_lc,
                i.incentive_acquired_type,
                COALESCE(MIN(i.incentive_acquired_type) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),&quot;Organic Acquisition&quot;) as full_acq_type,
                DATE_TRUNC(MIN((CASE WHEN r.customer_vendor_order_index = 1 THEN o.order_date END)) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),month) as acquired_month,
                DATE_TRUNC(MIN((CASE WHEN r.customer_vendor_order_index = 2 THEN o.order_date END)) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),month) as retention_month,
                FROM `tlb-data-prod.data_platform.fct_order_info` o
                LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` r on r.order_id = o.order_id
                LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
                LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
                LEFT JOIN incentive_final i on i.order_id = o.order_id AND i.analytical_customer_id = o.analytical_customer_id
                WHERE DATE_TRUNC(o.order_date,month) &gt;&gt;= &quot;2024-07-01&quot;
                AND o.is_successful
                AND NOT o.is_test
                AND v.country_code = &quot;AE&quot;
                AND c.vertical = &quot;food&quot;
                AND o.chain_id IN (603153,659775,670444,676645)
        ),

        pre_customer_freq AS
        (
                SELECT
                DATE_TRUNC(b.order_date,MONTH) AS month,
                vendor_id,
                analytical_customer_id,
                full_acq_type,
                acquired_month,
                retention_month,
                CASE WHEN retention_month is not null then true else false end as is_retained_customer,
                COUNT(DISTINCT CASE WHEN customer_vendor_order_index IS NOT NULL THEN order_id END) as no_of_orders,
                COUNT(DISTINCT CASE WHEN customer_vendor_order_index IS NOT NULL AND incentive_amount_lc &gt;&gt; 0 THEN order_id END) as incentivized_orders,
                SUM(gmv_amount_lc) as gmv_amount_lc,
                SUM(incentive_amount_lc) as incentive_lc
                FROM base b
                WHERE acquired_month &gt;&gt;= &quot;2024-07-01&quot;
                GROUP BY 1,2,3,4,5,6
        ),

        
        pre_final AS
        (SELECT 
        a.month,
        a.vendor_id,
        a.analytical_customer_id,
        a.full_acq_type,
        a.is_retained_customer,
        SUM(b.no_of_orders) as no_of_orders,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month THEN a.analytical_customer_id ELSE NULL END) as acquired_customers,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND a.acquired_month = b.retention_month THEN a.analytical_customer_id ELSE NULL END) ret_m0,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 1 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m1,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 2 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m2,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 3 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m3,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 4 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m4,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 5 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m5,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 6 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m6,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 7 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m7,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 8 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m8,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 9 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m9,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 10 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m10,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 11 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m11,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 12 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m12,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_TRUNC(b.retention_month,month) &gt;&gt; DATE_ADD(a.acquired_month, INTERVAL 12 MONTH) THEN a.analytical_customer_id ELSE NULL END) as ret_beyond_m12,
              ------ Retention -------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) ret_m0_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m1_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m2_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m3_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m4_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m5_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m6_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m7_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m8_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m9_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m10_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m11_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m12_all,
        SUM(CASE WHEN DATE_TRUNC(a.month,month) &gt;&gt; DATE_ADD(b.month, INTERVAL 12 MONTH) THEN 1 ELSE 0 END) as ret_m13_beyond_all,

        ------ Frequency ------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) frequency_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m12,
        SUM(CASE WHEN DATE_TRUNC(b.month,month) &gt;&gt; DATE_ADD(b.month, INTERVAL 12 MONTH) THEN b.no_of_orders ELSE 0 END) as frequency_beyond_m12,
                ---- GMV -----
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) gmv_lc_0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m12,
        ---- Incentive Orders -------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) incentive_orders_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m12,
        ---- Incentives Amount ----
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) incentive_lc_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m12,
        FROM pre_customer_freq a
        LEFT JOIN pre_customer_freq b on b.vendor_id = a.vendor_id AND b.analytical_customer_id = a.analytical_customer_id
        GROUP BY 1,2,3,4,5),

        final AS
        (
        SELECT
        month,
        vendor_id,
        full_acq_type,
        SUM(no_of_orders) as no_of_orders,
        COUNT(analytical_customer_id) as total_customers,
        COUNT(DISTINCT analytical_customer_id) as unique_customers,
        COUNT(DISTINCT CASE WHEN is_retained_customer THEN analytical_customer_id END) as retained_customers,
        COUNT(DISTINCT CASE WHEN NOT is_retained_customer THEN analytical_customer_id END) as lost_customers,
        SUM(acquired_customers) as acquired_customers,
        SUM(COALESCE(ret_m0, 0 )) AS ret_m0,
        SUM(COALESCE(ret_m1, 0 ) )AS ret_m1,
        SUM(COALESCE(ret_m2, 0 ) )AS ret_m2,
        SUM(COALESCE(ret_m3, 0 ) )AS ret_m3,
        SUM(COALESCE(ret_m4, 0 ) )AS ret_m4,
        SUM(COALESCE(ret_m5, 0 ) )AS ret_m5,
        SUM(COALESCE(ret_m6, 0 ) )AS ret_m6,
        SUM(COALESCE(ret_m7, 0 ) )AS ret_m7,
        SUM(COALESCE(ret_m8, 0 ) )AS ret_m8,
        SUM(COALESCE(ret_m9, 0 ) )AS ret_m9,
        SUM(COALESCE(ret_m10, 0 )) AS ret_m10,
        SUM(COALESCE(ret_m11, 0 )) AS ret_m11,
        SUM(COALESCE(ret_m12, 0 )) AS ret_m12,
        SUM(COALESCE(ret_beyond_m12, 0 )) AS ret_beyond_m12,
        SUM(COALESCE(ret_m0_all, 0 )) AS ret_m0_all,
        SUM(COALESCE(ret_m1_all, 0 ) )AS ret_m1_all,
        SUM(COALESCE(ret_m2_all, 0 ) )AS ret_m2_all,
        SUM(COALESCE(ret_m3_all, 0 ) )AS ret_m3_all,
        SUM(COALESCE(ret_m4_all, 0 ) )AS ret_m4_all,
        SUM(COALESCE(ret_m5_all, 0 ) )AS ret_m5_all,
        SUM(COALESCE(ret_m6_all, 0 ) )AS ret_m6_all,
        SUM(COALESCE(ret_m7_all, 0 ) )AS ret_m7_all,
        SUM(COALESCE(ret_m8_all, 0 ) )AS ret_m8_all,
        SUM(COALESCE(ret_m9_all, 0 ) )AS ret_m9_all,
        SUM(COALESCE(ret_m10_all, 0 )) AS ret_m10_all,
        SUM(COALESCE(ret_m11_all, 0 )) AS ret_m11_all,
        SUM(COALESCE(ret_m12_all, 0 )) AS ret_m12_all,
        SUM(COALESCE(ret_m13_beyond_all, 0 )) AS ret_m13_beyond_all,
        SUM(frequency_m0) AS frequency_m0,
        SUM(frequency_m1) AS frequency_m1,
        SUM(frequency_m2) AS frequency_m2,
        SUM(frequency_m3) AS frequency_m3,
        SUM(frequency_m4) AS frequency_m4,
        SUM(frequency_m5) AS frequency_m5,
        SUM(frequency_m6) AS frequency_m6,
        SUM(frequency_m7) AS frequency_m7,
        SUM(frequency_m8) AS frequency_m8,
        SUM(frequency_m9) AS frequency_m9,
        SUM(frequency_m10) AS frequency_m10,
        SUM(frequency_m11) AS frequency_m11,
        SUM(frequency_m12) AS frequency_m12,    
        SUM(gmv_lc_0) AS gmv_lc_0,
        SUM(gmv_lc_m1) AS gmv_lc_m1,
        SUM(gmv_lc_m2) AS gmv_lc_m2,
        SUM(gmv_lc_m3) AS gmv_lc_m3,
        SUM(gmv_lc_m4) AS gmv_lc_m4,
        SUM(gmv_lc_m5) AS gmv_lc_m5,
        SUM(gmv_lc_m6) AS gmv_lc_m6,
        SUM(gmv_lc_m7) AS gmv_lc_m7,
        SUM(gmv_lc_m8) AS gmv_lc_m8,
        SUM(gmv_lc_m9) AS gmv_lc_m9,
        SUM(gmv_lc_m10) AS gmv_lc_m10,
        SUM(gmv_lc_m11) AS gmv_lc_m11,
        SUM(gmv_lc_m12) AS gmv_lc_m12,
        SUM(incentive_orders_m0) AS incentive_orders_m0,
        SUM(incentive_orders_m1) AS incentive_orders_m1,
        SUM(incentive_orders_m2) AS incentive_orders_m2,
        SUM(incentive_orders_m3) AS incentive_orders_m3,
        SUM(incentive_orders_m4) AS incentive_orders_m4,
        SUM(incentive_orders_m5) AS incentive_orders_m5,
        SUM(incentive_orders_m6) AS incentive_orders_m6,
        SUM(incentive_orders_m7) AS incentive_orders_m7,
        SUM(incentive_orders_m8) AS incentive_orders_m8,
        SUM(incentive_orders_m9) AS incentive_orders_m9,
        SUM(incentive_orders_m10) AS incentive_orders_m10,
        SUM(incentive_orders_m11) AS incentive_orders_m11,
        SUM(incentive_orders_m12) AS incentive_orders_m12,
        SUM(incentive_lc_m0) AS incentive_lc_m0,
        SUM(incentive_lc_m1) AS incentive_lc_m1,
        SUM(incentive_lc_m2) AS incentive_lc_m2,
        SUM(incentive_lc_m3) AS incentive_lc_m3,
        SUM(incentive_lc_m4) AS incentive_lc_m4,
        SUM(incentive_lc_m5) AS incentive_lc_m5,
        SUM(incentive_lc_m6) AS incentive_lc_m6,
        SUM(incentive_lc_m7) AS incentive_lc_m7,
        SUM(incentive_lc_m8) AS incentive_lc_m8,
        SUM(incentive_lc_m9) AS incentive_lc_m9,
        SUM(incentive_lc_m10) AS incentive_lc_m10,
        SUM(incentive_lc_m11) AS incentive_lc_m11,
        SUM(incentive_lc_m12) AS incentive_lc_m12,
        FROM pre_final
        GROUP BY 1,2,3
        )

        SELECT * FROM final</relation>
          <relation connection='bigquery.0ki4xmd0l8qfx31b3cpj70t7onsg' name='dim_vendor' type='text'>SELECT * FROM `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info`</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[edr_retention_base].[vendor_id]' />
              <expression op='[dim_vendor].[vendor_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0ki4xmd0l8qfx31b3cpj70t7onsg' name='edr_retention_base' type='text'>WITH
incentive_acq_base AS
        (
        SELECT
        COALESCE((CASE WHEN incentive_sub_type = &apos;gem&apos; THEN &quot;GEM&quot; ELSE i.campaign_name END),NULL) AS incentive_campaign_name,
        o.analytical_customer_id,
        i.incentive_amount_lc,
        i.campaign_group,
        i.order_id,
        i.incentive_sub_type,
        i.incentive_type,
        did.targeted_segment_name,
        COUNT( i.order_id) OVER(PARTITION BY  i.order_id) as no_of_incentives,
        CASE 
                WHEN MAX(CASE WHEN targeted_segment_name = &quot;NEW_CUSTOMER&quot; THEN CONCAT(&quot;FTU - &quot;, i.campaign_name) END)
         OVER(PARTITION BY i.order_id) IS NOT NULL THEN 
                MAX(CASE WHEN targeted_segment_name = &quot;NEW_CUSTOMER&quot; THEN CONCAT(&quot;FTU - &quot;, i.campaign_name) END)
        OVER(PARTITION BY i.order_id)
                WHEN i.incentive_amount_lc = MAX(i.incentive_amount_lc) OVER(PARTITION BY i.order_id) THEN 
        COALESCE(
                CASE   
                WHEN incentive_sub_type = &quot;voucher wallet&quot; THEN &quot;Talabat Offer &amp; Wallet Discounts&quot;
                WHEN incentive_sub_type = &apos;gem&apos; THEN &quot;GEM&quot;
                WHEN incentive_sub_type = &apos;discounted delivery&apos; THEN &quot;RDF&quot;
                WHEN incentive_sub_type = &apos;free delivery&apos; THEN &quot;Free Delivery&quot;
                ELSE i.campaign_name 
                END,
        NULL
        ) 
        ELSE NULL END AS final_discount_type,
        FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` i
        LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = i.vendor_id
        LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` o on i.order_id = o.order_id 
        LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` did on did.campaign_id=i.campaign_id
        LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` r on r.order_id = i.order_id
        WHERE 
        -- DATE_TRUNC(i.order_date,month) = &quot;2024-09-01&quot;
        DATE_TRUNC(i.order_date,month) &gt;&gt;= &quot;2024-07-01&quot;
        AND  o.is_successful
        AND r.customer_vendor_order_index = 1
        -- AND v.vendor_id = 608996
        AND o.chain_id IN (603153,659775,670444,676645)
        -- AND o.order_id IN(1756296287,1737436382,1741055349,1740087923)
        ),
        
        pre_final_incentives AS
        (SELECT
        *,
        MAX(final_discount_type) OVER(PARTITION BY order_id) final_campaign_name,
        FROM
        incentive_acq_base),


        final_order_incentive_acq AS
        (
                SELECT 
                *,
                (CASE 
                                ------ GEM ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%GEM%&quot;) THEN &quot;GEM&quot;
                                ------- FTU Menu Discounts -------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 20% off Menu%&quot;) THEN &quot;FTU - 20% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 30% off Menu%&quot;) THEN &quot;FTU - 30% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 40% off Menu%&quot;) THEN &quot;FTU - 40% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 50% off Menu%&quot;) THEN &quot;FTU - 50% Off Menu Discount&quot;
                                ------- Menu Discounts -------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%20% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot; THEN &quot;20% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%30% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;30% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%40% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;40% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%50% off%&quot;) AND incentive_sub_type = &quot;menu discount&quot;  THEN &quot;50% Off Menu Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Flash Sale%&quot;) THEN &quot;Flash Sale&quot;
                                ------ FTU Item Discounts ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 20% off Item%&quot;) THEN &quot;FTU - 20% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 30% off Item%&quot;) THEN &quot;FTU - 30% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 40% off Item%&quot;) THEN &quot;FTU - 40% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%FTU - 50% off Item%&quot;) THEN &quot;FTU - 50% Off Item Discount&quot;                                
                                ------ Item Discounts ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%20% off%&quot;) AND incentive_sub_type = &quot;item discount&quot; THEN &quot;20% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%30% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;30% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%40% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;40% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%50% off%&quot;) AND incentive_sub_type = &quot;item discount&quot;  THEN &quot;50% Off Item Discount&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Under AED 30%&quot;) THEN &quot;Under 30 AED (ID)&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%15% off selected items%&quot;) THEN &quot;15% off Item Discount (BS)&quot;
                                ------ RDF ------
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%RDF%&quot;) THEN &quot;RDF&quot;
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%Free Delivery%&quot;) THEN &quot;Free Delivery&quot;

                                ----- Other -----
                                WHEN LOWER(final_campaign_name) LIKE LOWER(&quot;%15% off selected items%&quot;) THEN &quot;15% off Item Discount (BS)&quot;
                                WHEN LOWER(final_campaign_name) = LOWER(&quot;Talabat Offer &amp; Wallet Discounts&quot;) THEN &quot;Talabat Offer &amp; Wallet Discounts&quot;
                        END)
                AS incentive_type_group
        FROM pre_final_incentives
        ),

        incentive_pre_final AS
        (
                SELECT
                analytical_customer_id,
                order_id,
                final_campaign_name
                FROM final_order_incentive_acq
        ),

        incentive_final AS
        (
                SELECT
                analytical_customer_id,
                order_id,
                final_campaign_name as incentive_acquired_type
                FROM pre_final_incentives
                GROUP BY ALL
        ),

        base AS
        (
                SELECT 
                o.order_date,
                o.vendor_id,
                o.order_id,
                r.customer_vendor_order_index,
                o.analytical_customer_id,
                o.gmv_amount_lc,
                o.incentive_amount_lc,
                i.incentive_acquired_type,
                COALESCE(MIN(i.incentive_acquired_type) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),&quot;Organic Acquisition&quot;) as full_acq_type,
                DATE_TRUNC(MIN((CASE WHEN r.customer_vendor_order_index = 1 THEN o.order_date END)) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),month) as acquired_month,
                DATE_TRUNC(MIN((CASE WHEN r.customer_vendor_order_index = 2 THEN o.order_date END)) OVER(PARTITION BY o.vendor_id,o.analytical_customer_id),month) as retention_month,
                FROM `tlb-data-prod.data_platform.fct_order_info` o
                LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` r on r.order_id = o.order_id
                LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
                LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
                LEFT JOIN incentive_final i on i.order_id = o.order_id AND i.analytical_customer_id = o.analytical_customer_id
                WHERE DATE_TRUNC(o.order_date,month) &gt;&gt;= &quot;2024-07-01&quot;
                AND o.is_successful
                AND NOT o.is_test
                AND v.country_code = &quot;AE&quot;
                AND c.vertical = &quot;food&quot;
                AND o.chain_id IN (603153,659775,670444,676645)
        ),

        pre_customer_freq AS
        (
                SELECT
                DATE_TRUNC(b.order_date,MONTH) AS month,
                vendor_id,
                analytical_customer_id,
                full_acq_type,
                acquired_month,
                retention_month,
                CASE WHEN retention_month is not null then true else false end as is_retained_customer,
                COUNT(DISTINCT CASE WHEN customer_vendor_order_index IS NOT NULL THEN order_id END) as no_of_orders,
                COUNT(DISTINCT CASE WHEN customer_vendor_order_index IS NOT NULL AND incentive_amount_lc &gt;&gt; 0 THEN order_id END) as incentivized_orders,
                SUM(gmv_amount_lc) as gmv_amount_lc,
                SUM(incentive_amount_lc) as incentive_lc
                FROM base b
                WHERE acquired_month &gt;&gt;= &quot;2024-07-01&quot;
                GROUP BY 1,2,3,4,5,6
        ),

        
        pre_final AS
        (SELECT 
        a.month,
        a.vendor_id,
        a.analytical_customer_id,
        a.full_acq_type,
        a.is_retained_customer,
        SUM(b.no_of_orders) as no_of_orders,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month THEN a.analytical_customer_id ELSE NULL END) as acquired_customers,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND a.acquired_month = b.retention_month THEN a.analytical_customer_id ELSE NULL END) ret_m0,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 1 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m1,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 2 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m2,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 3 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m3,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 4 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m4,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 5 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m5,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 6 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m6,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 7 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m7,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 8 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m8,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 9 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m9,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 10 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m10,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 11 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m11,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_ADD(a.acquired_month, INTERVAL 12 MONTH) = DATE_TRUNC(b.retention_month,month) THEN a.analytical_customer_id ELSE NULL END) as ret_m12,
        COUNT(DISTINCT CASE WHEN a.month = a.acquired_month AND DATE_TRUNC(b.retention_month,month) &gt;&gt; DATE_ADD(a.acquired_month, INTERVAL 12 MONTH) THEN a.analytical_customer_id ELSE NULL END) as ret_beyond_m12,
              ------ Retention -------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) ret_m0_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m1_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m2_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m3_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m4_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m5_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m6_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m7_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m8_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m9_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m10_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m11_all,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN 1 ELSE 0 END) as ret_m12_all,
        SUM(CASE WHEN DATE_TRUNC(a.month,month) &gt;&gt; DATE_ADD(b.month, INTERVAL 12 MONTH) THEN 1 ELSE 0 END) as ret_m13_beyond_all,

        ------ Frequency ------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) frequency_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.no_of_orders ELSE 0 END) as frequency_m12,
        SUM(CASE WHEN DATE_TRUNC(b.month,month) &gt;&gt; DATE_ADD(b.month, INTERVAL 12 MONTH) THEN b.no_of_orders ELSE 0 END) as frequency_beyond_m12,
                ---- GMV -----
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) gmv_lc_0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.gmv_amount_lc ELSE 0 END) as gmv_lc_m12,
        ---- Incentive Orders -------
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) incentive_orders_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentivized_orders ELSE 0 END) as incentive_orders_m12,
        ---- Incentives Amount ----
        SUM(CASE WHEN a.month = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) incentive_lc_m0,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 1 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m1,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 2 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m2,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 3 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m3,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 4 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m4,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 5 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m5,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 6 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m6,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 7 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m7,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 8 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m8,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 9 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m9,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 10 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m10,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 11 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m11,
        SUM(CASE WHEN DATE_ADD(a.month, INTERVAL 12 MONTH) = DATE_TRUNC(b.month,month) THEN b.incentive_lc ELSE 0 END) as incentive_lc_m12,
        FROM pre_customer_freq a
        LEFT JOIN pre_customer_freq b on b.vendor_id = a.vendor_id AND b.analytical_customer_id = a.analytical_customer_id
        GROUP BY 1,2,3,4,5),

        final AS
        (
        SELECT
        month,
        vendor_id,
        full_acq_type,
        SUM(no_of_orders) as no_of_orders,
        COUNT(analytical_customer_id) as total_customers,
        COUNT(DISTINCT analytical_customer_id) as unique_customers,
        COUNT(DISTINCT CASE WHEN is_retained_customer THEN analytical_customer_id END) as retained_customers,
        COUNT(DISTINCT CASE WHEN NOT is_retained_customer THEN analytical_customer_id END) as lost_customers,
        SUM(acquired_customers) as acquired_customers,
        SUM(COALESCE(ret_m0, 0 )) AS ret_m0,
        SUM(COALESCE(ret_m1, 0 ) )AS ret_m1,
        SUM(COALESCE(ret_m2, 0 ) )AS ret_m2,
        SUM(COALESCE(ret_m3, 0 ) )AS ret_m3,
        SUM(COALESCE(ret_m4, 0 ) )AS ret_m4,
