  <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/EDRCustomerAcquisitionSources?rev=1.2' id='EDRCustomerAcquisitionSources' path='/t/Talabat/workbooks' revision='1.3' site='Talabat' />
