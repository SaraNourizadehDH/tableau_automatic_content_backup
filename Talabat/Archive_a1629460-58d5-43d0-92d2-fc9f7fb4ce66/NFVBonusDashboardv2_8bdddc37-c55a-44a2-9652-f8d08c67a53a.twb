      <datasource-dependencies datasource='federated.0f6797v1xed1k21a7ym2c13in9zi'>
        <column datatype='real' name='[Daily Orders]' role='measure' type='quantitative' />
        <column datatype='real' name='[Discount GMV %]' role='measure' type='quantitative' />
        <column datatype='real' name='[Portfolio commision earning]' role='measure' type='quantitative' />
