            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_iso]' derivation='None' name='[none:country_iso:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[other_owners_failed_lost_gmv]' role='measure' type='quantitative' />
