          <named-connection caption='BigQuery' name='bigquery.0xfgjzm0i2ye46115gli21dkn6nd'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground_grocery' server-oauth='' username='aaryaman@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0xfgjzm0i2ye46115gli21dkn6nd' name='Custom SQL Query' type='text'>with t_day AS (
  SELECT
    date
    FROM
      `tlb-data-prod.data_platform.dim_date`
    WHERE
      date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 3 MONTH) AND CURRENT_DATE-1
      ),
vendors_data as (
  select
    c.country_code as country_iso,
    c.chain_id,
    c.chain_name,
    v.vendor_id,
    v.vendor_name,
    v.first_online_date,
    v.account_manager_name, 
    v.order_flow_type
  from `tlb-data-prod.data_platform.dim_chain` c
  left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
  where is_non_food
  and not is_darkstore
),
orders_data as (
 SELECT
    date as order_date,
    i.vendor_id,
    successful_orders as successful_orders,
    commission_lc as commission_amount_lc,
    failed_orders_due_to_vendor as vendor_net_failed_orders,
    net_orders as net_orders,
    vendor_oos_failed_orders as failed_oos_orders,
    delivered_gmv as delivered_gmv,
    delivered_lc as delivered_gmv_lc,
    net_total_lost_gmv_eur as total_lost_gmv,
    lost_gmv_eur_due_to_non_vendor_failed_orders as other_owners_failed_lost_gmv,
    contact_orders,
    partially_fulfilled_orders_removed_items,
    vendor_oos_total_failed_items as vendor_oos_failed_items,
    net_qty_ordered
    
    FROM 
    `tlb-data-dev.data_playground_grocery.qc_vendor_performance` i

),
spu_data as (
  SELECT 
    order_date,
    vendor_id,
    SUM(coalesce(discount_voucher_vendor,0)) 
    + SUM(coalesce(item_lvl_discount,0)) 
    +SUM(COALESCE(discount_incentive,0))
    +SUM(if((df_campaign is not null AND NOT is_tpro_order),df_discount_vendor_share,0)) AS total_discount,
    sum(gmv_amount_lc) as total_gmv_lc, 
  FROM `tlb-data-prod.data_platform.fct_grocery_discount` 
  WHERE order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 3 MONTH) AND CURRENT_DATE-1
  GROUP BY 1,2

),
cpc_data as (
  SELECT 
    date,
    vendor_id,
    COALESCE(SUM(booking_revenue_lc),0) as cpc_lc,
    COALESCE(SUM(booking_revenue_eur),0) as cpc_eur,
  FROM `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly`
  WHERE date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 3 MONTH) AND CURRENT_DATE-1
  group by 1,2

),
cpp_data as (
  SELECT 
    date,
    vendor_id,
    COALESCE(SUM(suggested_price_lc),0) as cpp_lc,
    COALESCE(SUM(suggested_price_eur),0) as cpp_eur 
  FROM `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly`
  WHERE date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 3 MONTH) AND CURRENT_DATE-1
  group by 1,2
)

SELECT
    t.*, v.* , o.* except(order_date,vendor_id), s.* except(order_date, vendor_id), COALESCE(cpc_lc,0) as cpc_lc, COALESCE(cpc_eur,0) as cpc_eur, COALESCE(cpp_lc,0) as cpp_lc, COALESCE(cpp_eur,0) as cpp_eur
  from  t_day t
  cross join vendors_data v
  left join orders_data o on v.vendor_id = o.vendor_id and t.date = o.order_date
  left join spu_data s on  o.order_date = s.order_date and o.vendor_id = s.vendor_id
  left join cpc_data cpc on t.date = cpc.date and v.vendor_id = cpc.vendor_id
  left join cpp_data cpp on t.date = cpp.date and v.vendor_id = cpp.vendor_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
