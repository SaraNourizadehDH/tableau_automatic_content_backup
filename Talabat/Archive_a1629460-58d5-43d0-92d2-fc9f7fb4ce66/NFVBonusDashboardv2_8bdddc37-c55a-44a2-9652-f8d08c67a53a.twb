      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.053ihdt1pqceo2103raos0wstgki].[sum:commission_amount_lc:qk]&quot;' value='Commission (LC)' />
