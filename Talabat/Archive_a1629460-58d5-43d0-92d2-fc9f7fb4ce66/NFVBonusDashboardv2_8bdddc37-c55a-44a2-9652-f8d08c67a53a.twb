      <column caption='commission - Bonus' datatype='real' name='[avg orders - Bonus  (copy)_1233986356666839044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Commission Earnings (LC)  goal % (copy)_1069886433832681473] &lt; .80 then 0 else ([Commission Earnings (LC)  goal % (copy)_1069886433832681473] * .20) END' />
