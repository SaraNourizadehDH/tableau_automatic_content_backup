      </column>
      <column caption='Average daily order' datatype='real' name='[Average daily orders (copy)_1240178807507464195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/ max([Calculation_1240178807507992580])' />
      </column>
      <column caption='Average daily GMV' datatype='real' name='[Average daily orders (copy)_2627568931840860160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV (EUR) (copy)_1825928203146743808]/ max([MTD (copy)_1005710151940198400])' />
      </column>
      <column caption='avg orders - Bonus ' datatype='real' name='[Bonus (copy)_1233986356666671107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1402871322816126976] &lt; .80 then 0 else ([Calculation_1402871322816126976] * .20) END' />
      </column>
      <column caption='Month days' datatype='integer' name='[Calculation_1195424265294864387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))' />
      </column>
      <column caption='Average daily orders' datatype='real' name='[Calculation_1195424265295044612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/ max([MTD (copy)_1005710151940198400])' />
      </column>
      <column caption='MTD' datatype='integer' name='[Calculation_1240178807507992580]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [date], TODAY())' />
      </column>
      <column caption='Bonus' datatype='real' name='[Calculation_1342635678179708929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1402871322816126976] * .20) + ([Commission Earnings (LC)  goal % (copy)_1069886433832681473] * .20) + ([Discount of GMV goal % (copy)_1402871322836705292] * .20) + ([Orders per Vendor goal % (copy)_1402871322821476355] * .20) + ([Commission per vendor goal % (copy)_1402871322825220104] * .20)' />
      </column>
      <column caption='Average daily orders goal %' datatype='real' name='[Calculation_1402871322816126976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1195424265295044612]/MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Daily Orders])' />
      </column>
      <column caption='Pace' datatype='real' name='[Calculation_1402871322817138689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1/30) * (DATEPART(&apos;day&apos;, TODAY()))' />
      </column>
      <column caption='Average daily orders Pace Score' datatype='string' name='[Calculation_1402871322820067330]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1402871322816126976]/[Calculation_1402871322817138689] &gt;=1 THEN &apos;Pace Target Achieved&apos;&#13;&#10;ELSEIF [Calculation_1402871322816126976]/[Calculation_1402871322817138689] &gt;=.9 THEN &apos;Slightly Behind Pace Target&apos;&#13;&#10;ELSE &apos;Behind Pace Target&apos;&#13;&#10;END' />
      </column>
      <column caption='Viable Vendors growth' datatype='integer' name='[Calculation_1402871322874392593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF { INCLUDE [vendor_id]: SUM([successful_orders]) } &gt; 25&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='GMV loss % Exc. Other failures' datatype='real' name='[Calculation_1670835477837049856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_lost_gmv]) - sum([other_owners_failed_lost_gmv])) / (sum([total_lost_gmv]) + sum([delivered_gmv]))' />
      </column>
      <column caption='GMV (EUR)' datatype='real' name='[Calculation_1670835477842644993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivered_gmv])' />
      </column>
      <column caption='Contact rate%' datatype='real' name='[Calculation_1933733102130180096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([contact_orders])/sum([net_orders])' />
      </column>
      <column caption='Items not delivered%' datatype='real' name='[Calculation_2334272019092365312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(partially_fulfilled_orders_removed_items) + SUM(vendor_oos_failed_items))/SUM(net_qty_ordered)' />
      </column>
      <column caption='Ordered GMV' datatype='real' name='[Calculation_2487394390297493505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_lost_gmv]) + sum([delivered_gmv]))' />
      </column>
      <column caption='NCR(EUR)' datatype='real' name='[Calculation_2627568931894824961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_eur]) + sum([cpp_eur])' />
      </column>
      <column caption='% Savings in SPU' datatype='real' name='[Calculation_705939279371599887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_discount]) / SUM([total_gmv_lc])' />
      </column>
      <column caption='Vendor NFR%' datatype='real' name='[Calculation_705939279371796496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_net_failed_orders])/SUM([net_orders])' />
      </column>
      <column caption='Portfolio commission earning  goal % ' datatype='real' name='[Commission Earnings (LC)  goal % (copy)_1069886433832681473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Commission Earnings (LC) (copy)_1069886433832562688]/MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Portfolio commision earning])' />
      </column>
      <column caption='Portfolio commission earning(LC)' datatype='real' name='[Commission Earnings (LC) (copy)_1069886433832562688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([commission_amount_lc])' />
      </column>
      <column caption='Vendor NFR% Pace Score' datatype='string' name='[Commission per vendor gaol % Pace Score (copy)_1402871322825527305]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Commission per vendor goal % (copy)_1402871322825220104] &lt;=1 THEN &apos;Behind Pace Target&apos; &#13;&#10;ELSEIF [Commission per vendor goal % (copy)_1402871322825220104] &lt;=.9 THEN &apos;Slightly Behind Pace Target&apos;&#13;&#10;ELSE &apos;Pace Target Achieved&apos;&#13;&#10;END' />
      </column>
      <column caption='Vendor NFR goal %' datatype='real' name='[Commission per vendor goal % (copy)_1402871322825220104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Vendor NFR %])/[Calculation_705939279371796496]' />
      </column>
      <column caption='Bonus Pace Score' datatype='string' name='[Daily Order Average Pace Score (copy)_1342635678182080514]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1342635678179708929] &gt;=.7 THEN &apos;Target Achieved&apos;&#13;&#10;ELSEIF [Calculation_1342635678179708929] &gt;=.6 THEN &apos;Slightly Behind Target&apos;&#13;&#10;ELSE &apos;Behind Target&apos;&#13;&#10;END' />
      </column>
      <column caption='Date (copy)' datatype='date' name='[Date (copy)_2677671463637000192]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[date]' />
      </column>
      <column caption='Viable Vendors growth  goal %' datatype='real' name='[Discount of GMV goal % (copy)_1402871322836705292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1402871322874392593]/MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Viable Vendors growth])' />
      </column>
      <column caption='Portfolio commission earning  Pace Score' datatype='string' name='[Discount of GMV% Pace Score (copy)_1402871322823843847]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Commission Earnings (LC)  goal % (copy)_1069886433832681473]/[Calculation_1402871322817138689] &gt;=1 THEN &apos;Pace Target Achieved&apos;&#13;&#10;ELSEIF [Commission Earnings (LC)  goal % (copy)_1069886433832681473]/[Calculation_1402871322817138689] &gt;=.9 THEN &apos;Slightly Behind Pace Target&apos;&#13;&#10;ELSE &apos;Behind Pace Target&apos;&#13;&#10;END' />
      </column>
      <column caption='Viable Vendors growth  Pace Score ' datatype='string' name='[Discount of GMV% Pace Score (copy)_1402871322836475915]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Discount of GMV goal % (copy)_1402871322836705292]/[Calculation_1402871322817138689] &gt;=1 THEN &apos;Target Achieved&apos;&#13;&#10;ELSEIF [Discount of GMV goal % (copy)_1402871322836705292]/[Calculation_1402871322817138689] &gt;=.9 THEN &apos;Slightly Behind Target&apos;&#13;&#10;ELSE &apos;Behind Target&apos;&#13;&#10;END' />
      </column>
      <column caption='GMV (LC) ' datatype='real' name='[GMV (EUR) (copy)_1825928203146743808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivered_gmv_lc])' />
      </column>
      <column caption='Days' datatype='integer' name='[MTD (copy)_1005710151940198400]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1240178807507992580]&gt;[Calculation_1195424265294864387] then [Calculation_1195424265294864387] else [Calculation_1240178807507992580] END' />
      </column>
      <column caption='NCR(LC)' datatype='real' name='[NCR(EUR) (copy)_1681250101621874688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_lc]) + sum([cpp_lc])' />
      </column>
      <column caption='Discount of GMV% Pace Score' datatype='string' name='[Orders per Vendor Pace Score (copy)_1402871322822799365]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Orders per Vendor goal % (copy)_1402871322821476355]/[Calculation_1402871322817138689] &gt;=1 THEN &apos;Pace Target Achieved&apos;&#13;&#10;ELSEIF [Orders per Vendor goal % (copy)_1402871322821476355]/[Calculation_1402871322817138689] &gt;=.9 THEN &apos;Slightly Behind Pace Target&apos;&#13;&#10;ELSE &apos;Behind Pace Target&apos;&#13;&#10;END' />
      </column>
      <column caption='Discount of GMV goal %' datatype='real' name='[Orders per Vendor goal % (copy)_1402871322821476355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_705939279371599887]/MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Discount GMV %])' />
      </column>
      <column caption='Pace (copy)' datatype='real' name='[Pace (copy)_2436165970867048448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1/30) * (DATEPART(&apos;day&apos;, TODAY()))' />
      </column>
      <column caption='Viable Vendors growth ' datatype='real' name='[Vendors with more than 25 orders (copy)_1233986356618162177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1402871322874392593] / MAX([federated.0f6797v1xed1k21a7ym2c13in9zi].[Viable Vendors growth])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='nfv_bonus_data' datatype='table' name='[__tableau_internal_object_id__].[nfv_bonus_data_4F885D0BB23C4E7198BEF0CC34E9658B]' role='measure' type='quantitative' />
