            <column-instance column='[other_owners_failed_lost_gmv]' derivation='Sum' name='[sum:other_owners_failed_lost_gmv:qk]' pivot='key' type='quantitative' />
            <column-instance column='[successful_orders]' derivation='Sum' name='[sum:successful_orders:qk]' pivot='key' type='quantitative' />
