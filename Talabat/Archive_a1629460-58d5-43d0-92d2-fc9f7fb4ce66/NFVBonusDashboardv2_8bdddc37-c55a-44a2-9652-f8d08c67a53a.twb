            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_iso]' derivation='None' name='[none:country_iso:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
