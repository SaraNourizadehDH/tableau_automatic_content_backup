      <aliases enabled='yes' />
      <column caption='AOV (EUR)' datatype='real' name='[AOV (LC) (copy)_4062246881142849540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4062246881139789827]/[Calculation_4062246881139679233]' />
      </column>
      <column caption='AOV (LC)' datatype='real' name='[Calculation_3297620104153833472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_lc])/SUM([no_of_orders])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_4062246881139679233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_of_orders])' />
      </column>
      <column caption='GMV (LC)' datatype='real' name='[Calculation_4062246881139740674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_lc])' />
      </column>
      <column caption='GMV (EUR)' datatype='real' name='[Calculation_4062246881139789827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])' />
      </column>
      <column caption='R.No' datatype='integer' name='[Calculation_5073234637266178048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Kitchen Orders' datatype='integer' name='[Calculation_5073234637283872769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [vendor_type] = &quot;Same Kitchen&quot; THEN [no_of_orders] END)' />
      </column>
      <column caption='Kitchen Orders Penetration %' datatype='real' default-format='p0.00%' name='[Calculation_5073234637284569090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5073234637283872769]/[Calculation_4062246881139679233]' />
      </column>
