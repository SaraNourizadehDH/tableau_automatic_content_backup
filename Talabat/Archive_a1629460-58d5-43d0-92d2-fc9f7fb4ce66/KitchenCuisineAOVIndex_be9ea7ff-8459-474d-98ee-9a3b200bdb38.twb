      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2BA9B7D71001439FBD5420EEC816EAE3'>
            <properties context=''>
              <relation connection='bigquery.0ig48sx0a2x5hr10dhltr1lzcdo3' name='Custom SQL Query' type='text'>WITH
    calculation 
    as (
        SELECT
        DATE_TRUNC(order_date,MONTH) as month,
        v.facility_short_name as kitchen_name,
        v.vendor_id,
        v.main_cuisine,
        k.delivery_area_id,
        SUM(successful_orders) as successful_orders,
        SUM(s_orders_gmv_amount) as gmv_lc,
        SUM(s_orders_gmv_amount_eur) as gmv_eur,
        SUM(s_basket_amount_total) as gbv_lc,
        SUM(s_basket_amount_total_eur) as gbv_eur
        FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_order_kpis_reporting` k
        LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = k.vendor_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dl on dl.area_id = k.delivery_area_id
        WHERE DATE_TRUNC(order_date,MONTH) = &quot;2024-09-01&quot;
        AND is_dh_kitchen_gfs
        AND v.country_code = &quot;AE&quot;
        GROUP BY 1,2,3,4,5
        HAVING successful_orders &gt;&gt;= 20),

        filtered_areas AS 
        (
            SELECT
            DISTINCT kitchen_name,delivery_area_id 
            FROM calculation
            -- WHERE kitchen_name IN (&quot;DSO&quot;,&quot;Mirdiff&quot;,&quot;Rashidiya&quot;,&quot;Business Bay SOL&quot;)
        ),

        all_data AS 
        (
            SELECT
            DATE_TRUNC(o.order_date,month) as month,
            o.vendor_id,
            fa.kitchen_name,
            COALESCE(v.is_dh_kitchen_gfs,FALSE) as is_dh_kitchen_gfs,
            -- o.delivery_area_id,
            COUNT(DISTINCT o.order_id) as no_of_orders,
            SUM(o.gmv_amount_lc) as gmv_lc,
            SUM(o.gmv_amount_eur) as gmv_eur,
            -- COUNT(DISTINCT oi.item_id) as no_of_unique_items, 
            -- SUM(oi.ordered_quantity) as no_of_quantity
            FROM `tlb-data-prod.data_platform.fct_order_info` o
            --  LEFT JOIN `tlb-data-prod.data_platform.fct_order_item` oi on oi.order_id = o.order_id
            LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = o.vendor_id
            LEFT JOIN filtered_areas fa on fa.delivery_area_id = o.delivery_area_id
            WHERE DATE_TRUNC(o.order_date,month) = &quot;2024-11-01&quot;
            AND o.country_Code = &quot;AE&quot;
            AND o.is_successful
            AND NOT o.is_test
            AND v.vertical = &quot;food&quot;
            AND o.delivery_arrangement IN (&quot;TMP&quot;,&quot;TGO&quot;)
            AND o.delivery_area_id IN (SELECT DISTINCT delivery_area_id FROM filtered_areas)
            AND v.main_cuisine IN (SELECT DISTINCT main_cuisine FROM filtered_areas)
            GROUP BY 1,2,3,4
        )

        SELECT
        a.*,
        v.vendor_name,
        v.main_cuisine,
        a.kitchen_name as kitchen_location,
        v.facility_short_name as facility_short_name,
        dc.is_aaa_account,
        dc.is_key_vip_account,
        dc.is_regional_key_account,
        dc.is_local_key_account,
        CASE
        WHEN a.kitchen_name = v.facility_short_name THEN &quot;Same Kitchen&quot;
        WHEN v.facility_short_name IS NOT NULL THEN &quot;Other Kitchen&quot;
        ELSE &quot;Non Kitchen&quot; END as vendor_type
        FROM all_data a
        LEFT JOIN `gfs-data-reporting.gfs_tlb_base_prod.talabat_dim_vendor_info` v on v.vendor_id = a.vendor_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc on dc.chain_id = v.chain_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
