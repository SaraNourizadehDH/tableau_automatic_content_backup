        <zone h='12133' id='31' name='Top 10 cuisines' w='59133' x='28333' y='1700' />
        <zone forceUpdate='true' h='10333' id='32' type-v2='text' w='27333' x='467' y='1667'>
          <formatted-text>
            <run fontsize='12'>This is a detailed view to identify if our kitchen vendors provide affordable choice to customers in each cluster.</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='12'>Logic flow:</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>1. Identify the top cuisines in a cluster/ region</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>2. Compare AOV of available kitchen vendor to other platform vendors to conclude on gap</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>3. Target affordable high performance vendors in cuisines with perceptible gap</run>
          </formatted-text>
        </zone>
