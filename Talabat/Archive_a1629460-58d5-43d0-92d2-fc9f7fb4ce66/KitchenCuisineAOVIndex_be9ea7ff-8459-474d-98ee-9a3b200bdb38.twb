              <bucket>&quot;Non Kitchen&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Same Kitchen&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Other Kitchen&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
