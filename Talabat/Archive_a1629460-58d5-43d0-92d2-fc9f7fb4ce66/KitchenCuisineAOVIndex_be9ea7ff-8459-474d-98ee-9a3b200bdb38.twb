        <zone forceUpdate='true' h='1933' id='26' type-v2='text' w='98333' x='467' y='69367'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='16'>Comparison View</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>Compare Kitchens or Cuisines within the same kitchen delivery area.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
