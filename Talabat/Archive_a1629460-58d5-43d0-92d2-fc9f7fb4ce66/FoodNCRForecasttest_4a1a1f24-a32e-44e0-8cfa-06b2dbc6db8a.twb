    <worksheet name='Kwords CPC LC'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1gb30mf072alp81cl7xvb0a2gapn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column alias='NCR Total' caption='View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;NCR&quot;'>
              <calculation class='tableau' formula='&quot;NCR&quot;' />
              <aliases>
                <alias key='&quot;AdRev&quot;' value='Ads Revenue Total' />
                <alias key='&quot;CPC&quot;' value='Premium Positions' />
                <alias key='&quot;NCR&quot;' value='NCR Total' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gb30mf072alp81cl7xvb0a2gapn'>
            <column caption='Act vs Bud KW' datatype='real' name='[Actuals vs Budget (copy)_412360909059440703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FP  excl tax (copy)_1370501688675831820])/SUM([Budget PP (copy)_412360908765401137])' />
            </column>
            <column caption='BE Kwords' datatype='real' name='[BE FP]' role='measure' type='quantitative' />
            <column datatype='integer' name='[BUD FP]' role='measure' type='quantitative' />
            <column caption='Budget Kwords' datatype='real' name='[Budget PP (copy)_412360908765401137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] :AVG([BUD FP])}' />
            </column>
            <column caption='Ratio of days left' datatype='real' name='[Calculation_1038361254111571974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Current_daysleft])/AVG([Previous_daysleft])' />
            </column>
            <column caption='Kwords 2' datatype='real' name='[Calculation_1370501688675446793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Final FP (copy)_1370501688675069959],0)' />
            </column>
            <column caption='KW not fixed' datatype='real' name='[Calculation_1370501688675541002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1370501688675446793] * AVG(VAT)' />
            </column>
            <column caption='Kwords MTD' datatype='real' name='[Calculation_1370501688675905549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] = &quot;Kwords MTD&quot;&#13;&#10;&#13;&#10;THEN [EUR]&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='fGMV forecast' datatype='real' name='[Calculation_2247577756186238978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : (SUM([GEM 7 days (copy)_2247577756184301569])*AVG([daysinmonth]))/AVG([dayscompleted (Days Remaining)])}' />
            </column>
            <column caption='Currency' datatype='string' name='[Calculation_412360908382122016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_412360908382167073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='For. vs Bud. Kwords' datatype='real' name='[Calculation_412360909059158078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Featured Product excl VAT (copy)_1370501688675655691])/SUM([Budget PP (copy)_412360908765401137])' />
            </column>
            <column caption='CM days left' datatype='integer' name='[Current_daysleft]' role='measure' type='quantitative' />
            <column datatype='real' name='[EUR]' role='measure' type='quantitative' />
            <column caption='Expected Budget Sold KW' datatype='real' name='[Expected Budget Sold FP (copy)_1370501688674947078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Velocity of Bud FP (copy)_1370501688674611204]*[Calculation_1038361254111571974]*(SUM([Last Month Bud FP (copy)_1370501688673505281])-SUM([Last MTD Budget Sold FP (copy)_1370501688673718274]))) + SUM([MTD Budget Sold FP (copy)_1370501688674418691])' />
            </column>
            <column caption='Expected Budget Sold KW (copy)' datatype='real' name='[Expected Budget Sold KW (copy)_1002543501927034880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Expected Budget Sold FP (copy)_1370501688674947078],AVG([MTD Budget Sold FP (copy)_1370501688674418691]))' />
            </column>
            <column caption='Kwords excl VAT mtd' datatype='real' name='[FP  excl tax (copy)_1370501688675831820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : SUM([Calculation_1370501688675905549]) * AVG([VAT])}' />
            </column>
            <column caption='Kwords/fGMV ' datatype='real' name='[FP/fGMV  (copy)_1370501688677015566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Featured Product excl VAT (copy)_1370501688675655691])/SUM([Calculation_2247577756186238978])' />
            </column>
            <column caption='Kwords forecast excl VAT (copy)' datatype='real' name='[Featured Product excl VAT (copy)_1370501688675655691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : [Calculation_1370501688675541002] }' />
            </column>
            <column caption='Final KW' datatype='real' name='[Final FP (copy)_1370501688675069959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Expected Budget Sold KW (copy)_1002543501927034880]*AVG([Kwords])' />
            </column>
            <column caption='fGMV LC' datatype='real' name='[GEM 7 days (copy)_2247577756184301569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;fGMV&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR]&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Kwords]' role='measure' type='quantitative' />
            <column caption='Last MTD Budget Sold KW' datatype='real' name='[Last MTD Budget Sold FP (copy)_1370501688673718274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((IF [Type] =  &quot;Kwords LM MTD Bud&quot;&#13;&#10;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR]&#13;&#10;&#13;&#10;END),0)' />
            </column>
            <column caption='Last Month Bud KW' datatype='real' name='[Last Month Bud FP (copy)_1370501688673505281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;Kwords LM Bud&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='MTD Budget Sold KW' datatype='real' name='[MTD Budget Sold FP (copy)_1370501688674418691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;Kwords Current MTD Bud&quot;&#13;&#10;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='LM days left' datatype='integer' name='[Previous_daysleft]' role='measure' type='quantitative' />
            <column datatype='string' name='[Type]' role='dimension' type='nominal' />
            <column datatype='real' name='[VAT]' role='measure' type='quantitative' />
            <column caption='Velocity of Bud KW' datatype='real' name='[Velocity of Bud FP (copy)_1370501688674611204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([MTD Budget Sold FP (copy)_1370501688674418691])&#13;&#10;&#13;&#10;/&#13;&#10;SUM ([MTD Budget Sold FP (copy)_1370501688674418691])' />
            </column>
            <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
