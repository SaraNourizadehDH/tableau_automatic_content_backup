            <column caption='Expected Budget Sold FP' datatype='real' name='[Expected Budget Sold (copy)_1100285750028713995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Velocity of Bud (copy)_1100285750028484618]*[Calculation_1038361254111571974]*(SUM([Last Month Bud (copy)_1100285750028152839])-SUM([Last MTD Budget Sold (copy)_1100285750028275720]))) + SUM([MTD Budget Sold (copy)_1100285750028369929])' />
            </column>
