            <column caption='PP actuals' datatype='real' name='[Calculation_2247577756309401611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1100285749720522754]) + SUM([Calculation_2247577756232605700]) - AVG([Calculation_1681531521999507457]) - AVG([Calculation_297237603143516163])' />
            </column>
