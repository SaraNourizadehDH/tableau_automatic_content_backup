    AND fct_monthly.ad_type_id = fct.ad_type_id
    AND fct_monthly.booking_id = fct.booking_id
INNER JOIN
  `tlb-data-prod.data_platform.dim_adex_booking_status` booking_status
ON
  fct_monthly.booking_status_id = booking_status.booking_status_id

  WHERE fct.date  BETWEEN DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 1 DAY), month)
    AND 
    DATE_SUB(current_date(), INTERVAL 1 DAY)
  and ad_type = 'organic_placements'
  and vertical = 'food'

)
