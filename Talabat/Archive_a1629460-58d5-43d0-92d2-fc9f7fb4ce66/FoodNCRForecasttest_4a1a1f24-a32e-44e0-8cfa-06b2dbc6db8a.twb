UNION ALL
(SELECT country_code, "GEM" as Type,SUM(Rev_LC) as EUR FROM

(SELECT DATE_TRUNC(order_date, MONTH) as Yearmonth, a.country_code,c.chain_id,CAST(a.vendor_id AS STRING),b.vendor_name,b.account_manager_name,b.account_manager_id,
'GEM' as type,'GEM' as billing_type, 

 SUM(a.gem_commission_amount_lc) as Rev_LC, SUM(a.gem_commission_amount_eur) as Rev_EUR

 FROM `tlb-data-prod.data_platform.fct_order_info` a

 LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` b

 ON b.vendor_id=a.vendor_id

 LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c

 ON c.chain_id = b.chain_id

 
 WHERE order_date >>= DATE_SUB(current_date(), INTERVAL 8 DAY)
 and order_Date <<= DATE_SUB(current_date(), INTERVAL 1 DAY)

 and is_successful=true
 and is_on_gem = true
 and is_test = false
 and country_iso <<>> 'SA'

 GROUP BY 1,2,3,4,5,6,7,8,9
)

GROUP BY 1
)

UNION ALL

(SELECT 
country_iso,"Current MTD Bud FP" as Type,SUM(budget_LC) EUR FROM

((SELECT 
DATE_TRUNC(date, MONTH) as Yearmonth,
country_code as country_iso,
chain_id, 
vendor_id as vendor_code,
vendor_name,
booking_id,
booking_status,
account_manager_name,
account_manager_id,
booking_type as type,
billing_type,
MAX(budget_lc) budget_lc,
(CASE WHEN SUM(revenue_lc)>>MAX(budget_lc) THEN MAX(budget_lc) ELSE SUM(revenue_lc) END) Rev_LC,
(CASE WHEN SUM(revenue_eur)>>MAX(budget_eur) THEN MAX(budget_eur) ELSE SUM(revenue_eur) END) Rev_EUR

FROM

(SELECT
  fct.date,
  vendor.vendor_id,
  vendor.vendor_name,
  CONCAT(vendor.vendor_name, " (", vendor.vendor_id, ")") AS vendor_name_id,
  chain.chain_id,
  chain.chain_name,
  CONCAT(chain.chain_name, " (", chain.chain_id, ")") AS chain_name_id,
  vendor.account_manager_name,
  vendor.account_manager_id,
  chain.vertical,
  country.country_code,
  country.country country_name,
  location.city_id,
  location.city_name,
  location.currency_symbol,
  ad_typ.ad_type booking_type,
  ad_typ.billing_type,
  fct.booking_id,
  booking_source.booking_source,
  booking_status.booking_status,
  CASE
    WHEN fct_monthly.is_budget_outlier_12_std THEN "Outlier (>> 12 STD)"
    WHEN fct_monthly.is_budget_outlier_6_std THEN "Outlier (6 - 12 STD)"
    WHEN fct_monthly.is_budget_outlier_3_std THEN "Outlier (3 - 6 STD)"
    WHEN fct_monthly.is_budget_outlier_1_5_std THEN "Outlier (1.5 - 3 STD)"
  ELSE
  "Not Outlier"
END
  AS budget_outlier_tag,
  fct_monthly.budget_eur,
  fct_monthly.budget_lc,
  fct.click_price_lc,
  fct.click_price_eur,
  fct.nb_impressions,
  fct.nb_booking_clicks nb_clicks,
  fct.nb_orders_successful nb_orders,
  fct.gmv_amount_lc_successful gmv_amount_lc,
  fct.gmv_amount_eur_successful gmv_amount_eur,
  fct.booking_revenue_lc revenue_lc,
  fct.booking_revenue_eur revenue_eur
FROM
  `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_daily` fct
INNER JOIN
  `tlb-data-prod.data_platform.dim_adex_booking_source` booking_source
USING
