        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='full' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Master CPC].[country_iso]' />
              <expression op='[Sheet3].[country_iso]' />
            </expression>
          </clause>
          <relation join='left' type='join'>
