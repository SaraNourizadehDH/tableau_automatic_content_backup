    <worksheet name='Adrev Forecast'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1gb30mf072alp81cl7xvb0a2gapn' />
          </datasources>
          <datasource-dependencies datasource='federated.1gb30mf072alp81cl7xvb0a2gapn'>
            <column datatype='real' name='[Banner VAT]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Budget Reduction]' role='measure' type='quantitative' />
            <column caption='FP CPC MTD' datatype='real' name='[CPC MTD (copy)_2247577756311302157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] = &quot;FP CPC MTD&quot;&#13;&#10;&#13;&#10;THEN [EUR]&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GEM MTD' datatype='real' name='[CPC MTD (copy)_2247577756312899602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_iso] : (SUM([Calculation_871446553611726848])*AVG([GEM VAT]))- ([Calculation_947163343102009344])}' />
            </column>
            <column caption='CPC UTR' datatype='real' name='[CPC]' role='measure' type='quantitative' />
            <column caption='CPP Full Month' datatype='real' name='[CPP MTD fixed (copy)_813744160025837569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : ((SUM([Calculation_1100285749720522754]) *AVG(VAT))/AVG([dayscompleted (Days Remaining)]))*AVG([daysinmonth])-AVG([Calculation_297237603143516163])}' />
            </column>
            <column datatype='integer' name='[CPP reduction]' role='measure' type='quantitative' />
            <column caption='Ratio of days left' datatype='real' name='[Calculation_1038361254111571974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Current_daysleft])/AVG([Previous_daysleft])' />
            </column>
            <column caption='MTD Budget Sold' datatype='real' name='[Calculation_1038361254111698951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;Current MTD Bud&quot;&#13;&#10;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR] - [Calculation_1681531521999507457]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Velocity of Bud' datatype='real' name='[Calculation_1038361254112251915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [country_iso (Custom SQL Query1)] &lt;&gt; &quot;IQ&quot;  &#13;&#10;THEN [Calculation_1038361254111698951] ELSE 1  END)&#13;&#10;&#13;&#10;/&#13;&#10;SUM (IF [country_iso (Custom SQL Query1)] &lt;&gt; &quot;IQ&quot;  &#13;&#10;THEN [MTD Budget Sold (copy)_1038361254111944712] ELSE 1 END)' />
            </column>
            <column caption='Expected Budget Sold' datatype='real' name='[Calculation_1038361254113132557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1038361254112251915]*[Calculation_1038361254111571974]*(([Calculation_42502749261570050])-SUM([MTD Budget Sold (copy)_1038361254111944712]))) + SUM([Calculation_1038361254111698951])' />
            </column>
            <column caption='Bud Consumed ' datatype='real' name='[Calculation_1038361254116143118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1038361254113132557]*AVG([CPC])' />
            </column>
            <column caption='Premium Positions' datatype='real' name='[Calculation_1100285749715505153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Premium Positions (copy)_412360908739924013]) = TRUE&#13;&#10;&#13;&#10;THEN 0&#13;&#10;&#13;&#10;ELSE [Premium Positions (copy)_412360908739924013]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CPP MTD fixed' datatype='real' name='[Calculation_1100285749720522754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Last Month Bud (copy)_1100285749715038208]) = TRUE&#13;&#10;&#13;&#10;THEN 0&#13;&#10;&#13;&#10;ELSE [Last Month Bud (copy)_1100285749715038208]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GEM per day' datatype='real' name='[Calculation_1100285749738336260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Last Month Bud (copy)_1100285749737086979])/8' />
            </column>
            <column caption='GEM Forecast' datatype='real' name='[Calculation_1100285749742342150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_iso]:IFNULL((([Calculation_1523342598558543872])+SUM([CPC MTD (copy)_2247577756312899602])),0)}' />
            </column>
            <column caption='Total Banners Forecast' datatype='real' name='[Calculation_1100285750057586706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Inline Banner Forecast (copy)_1100285750057349137]+[Last Month Bud (copy)_1100285750057234448]' />
            </column>
            <column caption='SS forecast' datatype='real' name='[Calculation_1100285750061957141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_412360908776394806]))' />
            </column>
            <column caption='AdRev Forecast' datatype='real' name='[Calculation_1100285750063534102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Premium Positions (copy)_1100285750084575256]) + SUM([Calculation_1100285749742342150]) +SUM([Featured Product (copy)_1100285750084894745]) + SUM([Total Banners Forecast (copy)_2247577756315918356]) + SUM([SS forecast (copy)_1100285750089080862]) + SUM([Featured Product excl VAT (copy)_1370501688675655691]) +  SUM([Calculation_4915819734372982788])' />
            </column>
            <column caption='Reduction JO Fix' datatype='real' name='[Calculation_1314206721502326784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso (Sheet3)] :AVG([Calculation_42502749258227712])}' />
            </column>
            <column caption='Kwords 2' datatype='real' name='[Calculation_1370501688675446793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Final FP (copy)_1370501688675069959],0)' />
            </column>
            <column caption='KW not fixed' datatype='real' name='[Calculation_1370501688675541002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1370501688675446793] * AVG(VAT)' />
            </column>
            <column caption='GEM new forecast' datatype='real' name='[Calculation_1523342598558543872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1100285749738336260] * AVG([Current_daysleft])' />
            </column>
            <column caption='Budget Reduction ' datatype='real' name='[Calculation_1681531521999507457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : IFNULL(AVG([Budget Reduction]),0)}' />
            </column>
            <column caption='FP MTD total' datatype='real' name='[Calculation_2247577756311482383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FP CPC MTD (copy)_2247577756311384078])+SUM([CPC MTD (copy)_2247577756311302157])' />
            </column>
            <column caption='CPP reduction fixed' datatype='integer' name='[Calculation_297237603143516163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([CPP reduction],0)' />
            </column>
            <column caption='Premium Posi not fixed' datatype='real' name='[Calculation_412360908759158830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1100285749715505153] * AVG(VAT)' />
            </column>
            <column caption='Super Saver Forecast ' datatype='real' name='[Calculation_412360908776394806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : AVG(FLOAT([Super Saver Forecast]))}' />
            </column>
            <column caption='reduction JO' datatype='integer' name='[Calculation_42502749258227712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country_iso (Custom SQL Query1)] = &quot;JO&quot; THEN 0 ELSE 0 END' />
            </column>
            <column caption='Last Month New' datatype='real' name='[Calculation_42502749261570050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Last MTD Budget Sold (copy)_1038361254112063498])' />
            </column>
            <column caption='DT per day' datatype='real' name='[Calculation_4915819734372524034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Registration Forecast (copy)_4915819734370975744]) / AVG([dayscompleted (Days Remaining)]))*AVG([Current_daysleft])' />
            </column>
            <column caption='Deal Targeting Forecast LC' datatype='real' name='[Calculation_4915819734372982788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_iso]:IFNULL((SUM([Registration Forecast (copy)_4915819734370975744])+([Calculation_4915819734372524034])),0)}' />
            </column>
            <column caption='Extra CPC July' datatype='integer' name='[Calculation_813744160008003584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='GEM Act with VAT' datatype='real' name='[Calculation_871446553611726848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] = &quot;GEM MTD&quot;&#13;&#10;&#13;&#10;THEN [EUR]&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GEM Reduction' datatype='real' name='[Calculation_947163343102009344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([CPP reduction])' />
            </column>
            <column caption='CM days left' datatype='integer' name='[Current_daysleft]' role='measure' type='quantitative' />
            <column datatype='real' name='[Deal Targeting]' role='measure' type='quantitative' />
            <column datatype='real' name='[EUR]' role='measure' type='quantitative' />
            <column caption='Expected Budget Sold KW' datatype='real' name='[Expected Budget Sold FP (copy)_1370501688674947078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Velocity of Bud FP (copy)_1370501688674611204]*[Calculation_1038361254111571974]*(SUM([Last Month Bud FP (copy)_1370501688673505281])-SUM([Last MTD Budget Sold FP (copy)_1370501688673718274]))) + SUM([MTD Budget Sold FP (copy)_1370501688674418691])' />
            </column>
            <column caption='Expected Budget Sold KW (copy)' datatype='real' name='[Expected Budget Sold KW (copy)_1002543501927034880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Expected Budget Sold FP (copy)_1370501688674947078],AVG([MTD Budget Sold FP (copy)_1370501688674418691]))' />
            </column>
            <column caption='FP CPP MTD' datatype='real' name='[FP CPC MTD (copy)_2247577756311384078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] = &quot;FP CPP MTD&quot;&#13;&#10;&#13;&#10;THEN [EUR]&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Featured Product excl VAT' datatype='real' name='[Featured Product (copy)_1100285750084894745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : [Calculation_2247577756311482383] * AVG([VAT])}' />
            </column>
            <column caption='Kwords forecast excl VAT (copy)' datatype='real' name='[Featured Product excl VAT (copy)_1370501688675655691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : [Calculation_1370501688675541002] }' />
            </column>
            <column caption='Final KW' datatype='real' name='[Final FP (copy)_1370501688675069959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Expected Budget Sold KW (copy)_1002543501927034880]*AVG([Kwords])' />
            </column>
            <column datatype='real' name='[GEM VAT]' role='measure' type='quantitative' />
            <column datatype='real' name='[Homepage]' role='measure' type='quantitative' />
            <column caption='Homepage Banner Forecast' datatype='real' name='[Inline Banner Forecast (copy)_1100285750057349137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(AVG([Homepage]),0)' />
            </column>
            <column datatype='real' name='[Inline]' role='measure' type='quantitative' />
            <column datatype='real' name='[Kwords]' role='measure' type='quantitative' />
            <column caption='Last Month Bud' datatype='real' name='[Last MTD Budget Sold (copy)_1038361254112063498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;LM Bud&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR] - [Calculation_1681531521999507457] -[Calculation_1314206721502326784]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Last MTD Budget Sold KW' datatype='real' name='[Last MTD Budget Sold FP (copy)_1370501688673718274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((IF [Type] =  &quot;Kwords LM MTD Bud&quot;&#13;&#10;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR]&#13;&#10;&#13;&#10;END),0)' />
