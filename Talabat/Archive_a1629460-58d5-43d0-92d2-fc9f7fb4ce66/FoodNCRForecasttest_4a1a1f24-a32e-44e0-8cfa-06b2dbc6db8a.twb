  `tlb-data-prod.data_platform.dim_chain` chain
USING
  (chain_id)
INNER JOIN
  `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` fct_monthly
ON
    fct_monthly.date = DATE_TRUNC(fct.date, MONTH)
