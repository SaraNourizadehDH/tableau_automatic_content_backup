    <worksheet name='Combined LC (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1gb30mf072alp81cl7xvb0a2gapn' />
          </datasources>
          <datasource-dependencies datasource='federated.1gb30mf072alp81cl7xvb0a2gapn'>
            <column datatype='real' name='[BE GEMS]' role='measure' type='quantitative' />
            <column datatype='real' name='[BE PP]' role='measure' type='quantitative' />
            <column datatype='integer' name='[BUD GEMS]' role='measure' type='quantitative' />
            <column caption='Budget GEM ' datatype='real' name='[Budget FP  (copy)_412360908766777396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] :AVG([BUD GEMS])}' />
            </column>
            <column caption='BE GEM' datatype='real' name='[Budget GEM  (copy)_412360909059674176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] :AVG([BE GEMS])}' />
            </column>
            <column caption='BE PP ' datatype='real' name='[Budget PP (copy)_412360909058502716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] :AVG([BE PP])}' />
            </column>
            <column datatype='integer' name='[Budget PP]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Budget Reduction]' role='measure' type='quantitative' />
            <column caption='PP  excl tax' datatype='real' name='[CPC MTD (copy)_2247577756308070405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : [Calculation_2247577756309401611] * AVG([VAT])}' />
            </column>
            <column caption='GEM MTD' datatype='real' name='[CPC MTD (copy)_2247577756312899602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_iso] : (SUM([Calculation_871446553611726848])*AVG([GEM VAT]))- ([Calculation_947163343102009344])}' />
            </column>
            <column caption='CPC UTR' datatype='real' name='[CPC]' role='measure' type='quantitative' />
            <column caption='CPP Full Month' datatype='real' name='[CPP MTD fixed (copy)_813744160025837569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_iso] : ((SUM([Calculation_1100285749720522754]) *AVG(VAT))/AVG([dayscompleted (Days Remaining)]))*AVG([daysinmonth])-AVG([Calculation_297237603143516163])}' />
            </column>
            <column datatype='integer' name='[CPP reduction]' role='measure' type='quantitative' />
            <column caption='Ratio of days left' datatype='real' name='[Calculation_1038361254111571974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Current_daysleft])/AVG([Previous_daysleft])' />
            </column>
            <column caption='MTD Budget Sold' datatype='real' name='[Calculation_1038361254111698951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type] =  &quot;Current MTD Bud&quot;&#13;&#10;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[EUR] - [Calculation_1681531521999507457]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Velocity of Bud' datatype='real' name='[Calculation_1038361254112251915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [country_iso (Custom SQL Query1)] &lt;&gt; &quot;IQ&quot;  &#13;&#10;THEN [Calculation_1038361254111698951] ELSE 1  END)&#13;&#10;&#13;&#10;/&#13;&#10;SUM (IF [country_iso (Custom SQL Query1)] &lt;&gt; &quot;IQ&quot;  &#13;&#10;THEN [MTD Budget Sold (copy)_1038361254111944712] ELSE 1 END)' />
            </column>
            <column caption='Expected Budget Sold' datatype='real' name='[Calculation_1038361254113132557]' role='measure' type='quantitative'>
