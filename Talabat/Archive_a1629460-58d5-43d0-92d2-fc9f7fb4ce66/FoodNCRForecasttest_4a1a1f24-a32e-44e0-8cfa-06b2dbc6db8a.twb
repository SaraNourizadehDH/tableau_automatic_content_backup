        <objects>
          <object caption='Custom SQL Query' id='_074E3B2550FA400AB6512E15F8A3DB91'>
            <properties context=''>
              <relation join='full' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Master CPC].[country_iso]' />
                    <expression op='[Sheet3].[country_iso]' />
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='='>
