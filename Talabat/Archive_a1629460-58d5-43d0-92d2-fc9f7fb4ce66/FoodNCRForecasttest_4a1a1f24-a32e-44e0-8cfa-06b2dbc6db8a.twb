  WHERE fct.date >>= DATE_TRUNC(DATE_ADD(DATE_SUB(current_date(), INTERVAL 1 DAY), INTERVAL -1 MONTH), MONTH)
    AND 
    fct.date <<= DATE_SUB(DATE_ADD(CURRENT_DATE(), INTERVAL -1 MONTH), INTERVAL 1 DAY)

  and ad_type = 'organic_placements'
