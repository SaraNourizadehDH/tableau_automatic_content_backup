            <column caption='CM total days' datatype='integer' name='[daysinmonth]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_412360908382122016]' derivation='None' name='[none:Calculation_412360908382122016:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_412360908382167073]' derivation='None' name='[none:Calculation_412360908382167073:nk]' pivot='key' type='nominal' />
