        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0trrxxn01ovnns1fssn6w04c151b' name='Custom SQL Query' type='text'>WITH geo AS &#13;
(&#13;
select distinct country_code,  city_id, city_name, zone_id, zone_name from&#13;
`tlb-data-prod.data_platform.dim_logistics_country` country&#13;
left join `tlb-data-prod.data_platform.dim_logistics_city` city using(country_code)&#13;
left join `tlb-data-prod.data_platform.dim_logistics_zone` zone using(country_code, city_id)&#13;
-- INNER join unnest(cities) cities &#13;
-- INNER join unnest(zones) zones&#13;
-- cities.is_active&#13;
-- and zones.is_active&#13;
where country_code not in (&apos;q2&apos;,&apos;dp-kw&apos;)&#13;
)&#13;
select * from&#13;
`tlb-data-dev.data_platform.planned_shifts_ramadan2021`&#13;
left join `tlb-data-dev.data_platform.evaluated_shifts_ramadan2021` using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join `tlb-data-dev.data_platform.break_time_ramadan2021`  using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join `tlb-data-dev.data_platform.no_shows_ramadan2021`  using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join `tlb-data-dev.data_platform.ramadan2021_orders_table` using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join `tlb-data-dev.data_platform.Ramadan2021_fill_rate` using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join `tlb-data-dev.data_platform.idle_time_ramadan2021` using(country_code, city_id,zone_id,report_date_local,time_local)&#13;
left join geo using(country_code,city_id,zone_id)&#13;
where country_code not in (&apos;dp-kw&apos;,&apos;q2&apos;,&apos;sa&apos;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
