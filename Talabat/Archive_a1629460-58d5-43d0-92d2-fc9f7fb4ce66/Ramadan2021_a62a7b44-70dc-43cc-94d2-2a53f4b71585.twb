    <worksheet name='order_related'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0qi9d3k1auqnc81cyiwzg1vq2x6r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DATE&quot;'>
              <calculation class='tableau' formula='&quot;DATE&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qi9d3k1auqnc81cyiwzg1vq2x6r'>
            <column caption='No Show %`' datatype='real' name='[Calculation_1216253442927689728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([no_show_time_in_interval_seconds]+[no_show_ex_time_in_interval_seconds])/sum([planned_time_in_interval_seconds])' />
            </column>
            <column caption='Orders Completed DNU' datatype='integer' name='[Calculation_1448751773305987072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_created])-sum([failed_orders])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_1448751773306265601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time]/60)/sum([actual_delivery_time_denominator])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_1448751773307252738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([orders_created])' />
            </column>
            <column caption='Order Late 10' datatype='real' name='[Calculation_1448751773308280835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_late_10])/sum([completed_orders])' />
            </column>
            <column caption='Vendor Late 10' datatype='real' name='[Calculation_1448751773308440580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_10])/sum([vendor_late_10_denominator])' />
            </column>
            <column caption='Breaks %' datatype='real' name='[Calculation_1448751773308559365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([break_time_in_interval_seconds])/sum([planned_time_in_interval_seconds])' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_1448751773308919814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([primary_stacked_count])/sum([deliveries_completed])' />
            </column>
            <column caption='Rider Late 10' datatype='real' name='[Calculation_1448751773309124615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late_10])/[Calculation_1448751773305987072]' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1448751773309411336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([completed_orders])/sum([working_time_in_interval_seconds]/3600)' />
            </column>
            <column caption='WEEK' datatype='string' name='[Calculation_1448751773311016972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(WEEK([report_date_local]))' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_1448751773311127565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date_local]))+&quot;_&quot;+[Calculation_1448751773311016972]' />
            </column>
            <column caption='Hour' datatype='string' name='[Calculation_1448751773312032783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;hour&apos;,DATETIME([time_local])))+&quot;:00&quot;' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_1448751773313662992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datename(&quot;weekday&quot;,[report_date_local])' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_1448751773317644306]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;WEEK&apos; then STR([Calculation_1448751773311127565])&#13;&#10;WHEN &apos;MONTH&apos; THEN STR([Calculation_845550831956299776])&#13;&#10;WHEN &apos;DATE&apos; then STR([report_date_local])&#13;&#10;WHEN &apos;HOUR&apos; then STR([Calculation_1448751773312032783])&#13;&#10;WHEN &apos;WEEKDAY&apos; then STR([Calculation_1448751773313662992])&#13;&#10;WHEN &apos;COUNTRY&apos; then STR([country_code])&#13;&#10;WHEN &apos;CITY&apos; then [city_name]&#13;&#10;WHEN &apos;ZONE&apos; then [zone_name]&#13;&#10;END' />
            </column>
            <column caption='Fill Rate' datatype='real' name='[Calculation_1448751773369860117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([assigned_shifts])/sum([assigned_shifts]+[slots])' />
            </column>
            <column caption='order date' datatype='string' name='[Calculation_1448751773380956182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([report_date_local])' />
            </column>
            <column caption='ATVC' datatype='real' name='[Calculation_1448751773388107799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_vendor_time_cleaned]/60)/sum([at_vendor_time_cleaned_denominator])' />
            </column>
            <column caption='Idle Time %' datatype='real' name='[Calculation_2456713604715626498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([rider_effective_time])/sum([working_time_in_interval_seconds])' />
            </column>
            <column caption='Month' datatype='integer' name='[Calculation_845550831956299776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MONTH([report_date_local])' />
            </column>
            <column datatype='integer' name='[actual_delivery_time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[actual_delivery_time_denominator]' role='measure' type='quantitative' />
            <column datatype='integer' name='[assigned_shifts]' role='measure' type='quantitative' />
