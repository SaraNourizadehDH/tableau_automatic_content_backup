          <named-connection caption='BigQuery' name='bigquery.0tuyuu50ym9bws1b0ghoz10ws84h'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='mohammad.mansoor@talabat.com' workgroup-auth-mode='prompt' />
