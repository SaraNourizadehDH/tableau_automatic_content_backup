      <date-options start-of-week='saturday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Waste time threshold' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
          <range max='100' min='4' />
        </column>
      </datasource-dependencies>
      <filter class='categorical' column='[none:week:ok]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[none:week:ok]' />
          <groupfilter function='member' level='[none:week:ok]' member='#2023-06-25#' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7D426056099A47F0AA6C36B7983BB692'>
            <properties context=''>
              <relation connection='bigquery.0tuyuu50ym9bws1b0ghoz10ws84h' name='Custom SQL Query' type='text'><![CDATA[with t1 as 
(select distinct 
rider.country_code, 
rider.vendor.vertical_type,
chain.name as chain_name,
rider.vendor.name vendor_name,
date_trunc(created_date,week) week,
o.order_code,
rd.rider_id,
rd.id as delivery_id, 
o.created_at,
rider.timings.estimated_walk_in_duration/60 as walk_in,
rider.food_is_ready_at,
rd.rider_near_restaurant_at as near_pickup_at,
rider.original_scheduled_pickup_at as estimated_pickup_at,
rd.rider_picked_up_at as picked_up_at,
rd.delivery_status,
rd.stacked_deliveries

from 

`fulfillment-dwh-production.curated_data_shared.orders_v2` o
left join `fulfillment-dwh-production.curated_data_shared.vendors_v2` v using (vendor_code,entity_id)
left join unnest(rider.deliveries) rd


where  
--rider.country_code = 'eg'
 entity.brand_name='Talabat'
and delivery_type='OWN_DELIVERY'
and rider.country_code is not null 
and lower(chain.name) = 'talabat mart'
and date_trunc(created_date,month) >>= ('2023-07-01') and date_trunc(created_date,week) << date_trunc(current_date(),week)
and rd.delivery_status = 'completed'
and rd.rider_picked_up_at >> rider.original_scheduled_pickup_at
and rider.food_is_ready_at is not null
--and rd.stacked_deliveries >> 1
--and order_code = '1072622017'
--order by o.order_code
--limit 1000
), t2 as(
select *,
case when (near_pickup_at << food_is_ready_at) then timestamp_diff(picked_up_at,food_is_ready_at,second)/60
when (near_pickup_at >> food_is_ready_at) then timestamp_diff(picked_up_at,near_pickup_at,second)/60 else 0 end as handling_time
 from t1), RD as 
(select *,
case when stacked_deliveries >> 0 then True else False end as is_stacked,
case when handling_time >> t2.walk_in then True else False end as is_wasted,
case when handling_time >> t2.walk_in then handling_time - t2.walk_in else 0 end as waste_time,
 from t2),

offenders as 
(select 
country_code,	rider_id, week,
count(distinct order_code)	total_orders,	
count(distinct case when is_stacked then order_code end) stacked_orders,
count(distinct case when is_wasted then order_code end) wasted_time_orders,
count(distinct case when is_wasted and is_stacked then order_code end) wasted_time_and_stacked_orders,
round(avg(waste_time),2) avg_waste_time,
round(sum(waste_time),2) sum_waste_time,
round(avg(case when is_stacked then waste_time end),2) avg_wasted_for_stacking,
round(sum(case when is_stacked then waste_time end),2) sum_wasted_for_stacking


 from RD 
 group by 1,2,3
 having avg_waste_time >>=<[Parameters].[Parameter 1]> and 
 stacked_orders/total_orders >> 0.3 and
 total_orders >>=7
 order by 3 desc)

 select *,case when DATE_SUB(week, INTERVAL 1 WEEK) = lag(week) over (partition by rider_id,country_code order by week) then True else False end offended_last_week from offenders order by 1,2,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Montly List' inline='true' name='federated.0jt9knq10biq5k10iazef03hn1u4' version='18.1'>
