        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform) (2)' name='federated.18jye190yymlzo16bcyif013juhy' />
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1yr65t713vazkb11pd90a02e79pu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='FIR 90th Perc' caption='Suggested EPT' datatype='string' name='[Measure Name (copy)_2700259875607875590]' param-domain-type='list' role='measure' type='nominal' value='&quot;FIR_90&quot;'>
              <calculation class='tableau' formula='&quot;FIR_90&quot;' />
              <aliases>
                <alias key='&quot;FIR&quot;' value='Avg FIR' />
                <alias key='&quot;FIR_50&quot;' value='FIR 50th Perc.' />
                <alias key='&quot;FIR_75&quot;' value='FIR 75th Perc.' />
                <alias key='&quot;FIR_80&quot;' value='FIR 80th Perc' />
                <alias key='&quot;FIR_90&quot;' value='FIR 90th Perc' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18jye190yymlzo16bcyif013juhy'>
            <column caption='DayofWeek' datatype='string' name='[Calculation_2700259875583799299]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [DOW]&#10;    WHEN &apos;Mon&apos; THEN &apos;1. Mon&apos;&#10;    WHEN &apos;Tue&apos; THEN &apos;2. Tue&apos;&#10;    WHEN &apos;Wed&apos; THEN &apos;3. Wed&apos;&#10;    WHEN &apos;Thu&apos; THEN &apos;4. Thu&apos;&#10;    WHEN &apos;Fri&apos; THEN &apos;5. Fri&apos;&#10;    WHEN &apos;Sat&apos; THEN &apos;6. Sat&apos;&#10;    WHEN &apos;Sun&apos; THEN &apos;7. Sun&apos;&#10;END' />
            </column>
            <column datatype='string' name='[DOW]' role='dimension' type='nominal' />
            <column datatype='real' name='[FIR]' role='measure' type='quantitative' />
            <column datatype='real' name='[FIR_50]' role='measure' type='quantitative' />
            <column datatype='real' name='[FIR_75]' role='measure' type='quantitative' />
            <column datatype='real' name='[FIR_80]' role='measure' type='quantitative' />
            <column datatype='real' name='[FIR_90]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[Hour]' role='dimension' type='ordinal' />
            <column caption='Suggested EPT' datatype='real' default-format='n#,##0;-#,##0' name='[Measure (copy)_2700259875608477703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(&#10;    SUM(&#10;        CASE [Parameters].[Measure Name (copy)_2700259875607875590]&#10;            WHEN &apos;FIR&apos; THEN FIR&#10;            WHEN &apos;FIR_50&apos; THEN [FIR_50]&#10;            WHEN &apos;FIR_75&apos; THEN [FIR_75]&#10;            WHEN &apos;FIR_80&apos; THEN [FIR_80]&#10;            WHEN &apos;FIR_90&apos; THEN [FIR_90]&#10;        END&#10;    ), 60&#10;)' />
            </column>
