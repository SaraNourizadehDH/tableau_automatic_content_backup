      <aliases enabled='yes' />
      <column caption='DayofWeek' datatype='string' name='[Calculation_2700259875583799299]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [DOW]&#10;    WHEN &apos;Mon&apos; THEN &apos;1. Mon&apos;&#10;    WHEN &apos;Tue&apos; THEN &apos;2. Tue&apos;&#10;    WHEN &apos;Wed&apos; THEN &apos;3. Wed&apos;&#10;    WHEN &apos;Thu&apos; THEN &apos;4. Thu&apos;&#10;    WHEN &apos;Fri&apos; THEN &apos;5. Fri&apos;&#10;    WHEN &apos;Sat&apos; THEN &apos;6. Sat&apos;&#10;    WHEN &apos;Sun&apos; THEN &apos;7. Sun&apos;&#10;END' />
      </column>
      <column caption='Measure' datatype='string' name='[Calculation_2700259875593072644]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;pct_delay15&apos; THEN &#10;        STR(ROUND(&#10;            SUM(&#10;                CASE [Parameters].[Parameter 1]&#10;                    WHEN &apos;pct_delay15&apos; THEN [pct_delay15]&#10;                END&#10;            ) * 100,0)) + &quot;%&quot;&#10;    WHEN &apos;orders&apos; THEN &#10;    &#9;STR(ROUND(&#10;            SUM(&#10;                CASE [Parameters].[Parameter 1]&#10;                    WHEN &apos;orders&apos; THEN [successful_orders]/[day_count]&#10;                END&#10;            ), 0))&#10;    ELSE &#10;        STR(ROUND(&#10;            SUM(&#10;                CASE [Parameters].[Parameter 1]&#10;                    WHEN &apos;DT&apos; THEN [DT]&#10;                    WHEN &apos;EPT&apos; THEN [EPT]&#10;                    WHEN &apos;FIR&apos; THEN [FIR]&#10;                    WHEN &apos;AVTC&apos; THEN [AVTC]&#10;                END&#10;            ), 1))&#10;END' />
      </column>
      <column caption='Current EPT' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2700259875610644488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([EPT])' />
      </column>
      <column caption='DAY-RANGE' datatype='string' name='[Calculation_3508656008783753216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [DOW]&#10;    WHEN &quot;Mon&quot; THEN &quot;MONDAY-MONDAY&quot;&#10;    WHEN &quot;Tue&quot; THEN &quot;TUESDAY-TUESDAY&quot;&#10;    WHEN &quot;Wed&quot; THEN &quot;WEDNESDAY-WEDNESDAY&quot;&#10;    WHEN &quot;Thu&quot; THEN &quot;THURSDAY-THURSDAY&quot;&#10;    WHEN &quot;Fri&quot; THEN &quot;FRIDAY-FRIDAY&quot;&#10;    WHEN &quot;Sat&quot; THEN &quot;SATURDAY-SATURDAY&quot;&#10;    WHEN &quot;Sun&quot; THEN &quot;SUNDAY-SUNDAY&quot;&#10;END' />
      </column>
      <column caption='HOUR-RANGE' datatype='string' name='[Calculation_3508656008785375233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;,&quot;+STR([Hour])+ &quot;-&quot; + STR([Hour])' />
      </column>
      <column caption='PREPARATION-BUFFER' datatype='integer' name='[Calculation_3508656008785825794]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='sum(0)' />
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_3508656008787726341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Hour]' role='dimension' type='ordinal' />
      <column caption='Measure color' datatype='real' name='[Measure (copy)_2700259875595759621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;                CASE [Parameters].[Parameter 1]&#10;                    WHEN &apos;DT&apos; THEN [DT]&#10;                    WHEN &apos;EPT&apos; THEN [EPT]&#10;                    WHEN &apos;FIR&apos; THEN [FIR]&#10;                    WHEN &apos;AVTC&apos; THEN [AVTC]&#10;                    WHEN &apos;pct_delay15&apos; THEN [pct_delay15]&#10;                    WHEN &apos;orders&apos; Then [successful_orders]&#10;                END)' />
      </column>
      <column caption='Suggested EPT' datatype='real' default-format='n#,##0;-#,##0' name='[Measure (copy)_2700259875608477703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#10;    SUM(&#10;        CASE [Parameters].[Measure Name (copy)_2700259875607875590]&#10;            WHEN &apos;FIR&apos; THEN FIR&#10;            WHEN &apos;FIR_50&apos; THEN [FIR_50]&#10;            WHEN &apos;FIR_75&apos; THEN [FIR_75]&#10;            WHEN &apos;FIR_80&apos; THEN [FIR_80]&#10;            WHEN &apos;FIR_90&apos; THEN [FIR_90]&#10;        END&#10;    ), 60&#10;)' />
      </column>
