  --is_grocery_flow,
  EXTRACT(hour from foi.order_time) Hour,
  FORMAT_DATE('%a', order_date) AS DOW,
  count(distinct foi.order_id) successful_orders,
  count(distinct order_date) day_count,
  round(avg(estimated_prep_time/60),2) EPT,
  round(avg(at_vendor_time_cleaned/60),2) AVTC,
  ROUND(SAFE_DIVIDE(count(distinct case when order_delay/60>>15 then foi.order_id end),count(distinct case when order_delay is not null then foi.order_id end)),4) pct_delay15,
  round(avg(actual_delivery_time/60),2) DT, 
  round(avg(TIMESTAMP_DIFF(vendor_prepared_at, sent_to_vendor_at, second)/60),2) FIR,
  round(approx_quantiles(TIMESTAMP_DIFF(vendor_prepared_at, sent_to_vendor_at, second)/60, 100)[OFFSET(50)],2) FIR_50,
  round(approx_quantiles(TIMESTAMP_DIFF(vendor_prepared_at, sent_to_vendor_at, second)/60, 100)[OFFSET(75)],2) FIR_75,
  round(approx_quantiles(TIMESTAMP_DIFF(vendor_prepared_at, sent_to_vendor_at, second)/60, 100)[OFFSET(80)],2) FIR_80,
  round(approx_quantiles(TIMESTAMP_DIFF(vendor_prepared_at, sent_to_vendor_at, second)/60, 100)[OFFSET(90)],2) FIR_90,




from `tlb-data-prod.data_platform.fct_order_info` foi 
inner join `tlb-data-prod.data_platform.dim_order_status` os on os.order_status_id = foi.order_status_id
inner join `tlb-data-prod.data_platform.fct_logistics_order` o on lower(foi.country_iso) = o.country_code and o.order_code = cast(foi.order_id as string)
left join `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = foi.vendor_id
left join `tlb-data-prod.data_platform.dim_chain` c on c.chain_id =foi.chain_id and c.country_code = foi.country_iso
left join `tlb-data-prod.data_platform.fct_picker_order` p on p.country_code = foi.country_iso and p.vendor_id = foi.vendor_id and p.order_id = foi.order_id
left join `tlb-data-prod.data_platform.dim_logistics_vendor` lv on lv.entity_id = o.entity_id and lv.country_code = o.country_code and lv.vendor_code = o.vendor_code
left join SO on SO.entity_id = o.entity_id and SO.country_code = o.country_code and SO.vendor_code = o.vendor_code 
left join `tlb-data-dev.data_platform.ept_cap` cap on cap.Country = foi.country_iso



where 
  order_date >>= '2024-08-24' and order_date <<= '2024-09-06'
  and order_date <<>> current_date()
  and foi.is_tgo
  --Tara filters--
  AND v.is_non_food
  --and not foi.is_darkstore
  and lower(v.vendor_name) not like '%talabat mart%'
  AND sub_vertical <<>> 'darkstore'
  and is_net
  and foi.is_successful
  -----------------
-------
  --and foi.order_id in (1699513449,1702685700,2199828)

group by 1,2,3,4,5,6,7,8,9
order by 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
