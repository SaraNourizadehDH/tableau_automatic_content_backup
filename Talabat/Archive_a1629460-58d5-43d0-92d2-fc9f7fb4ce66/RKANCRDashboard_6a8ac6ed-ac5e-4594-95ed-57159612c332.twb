    <worksheet name='ROI'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Arial' fontsize='12'>ROAS &amp; Percentage of Vendors with &gt; 3x ROAS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RKA NCR' name='federated.1qpk1zm0wtolw816jz4u611hnts3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='End Date' datatype='date' default-format='*MMMM-YYYY' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-06-30#'>
              <calculation class='tableau' formula='#2024-06-30#' />
            </column>
            <column caption='Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Outlier' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude&quot;'>
              <calculation class='tableau' formula='&quot;Exclude&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qpk1zm0wtolw816jz4u611hnts3'>
            <column caption='Budget Fixed exclusive of outlier' datatype='real' name='[Budget Fixed inclusive of outlier (copy)_3792804978630119427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([date]), [booking_id], [vendor_id]: AVG([Calculation_3792804978629775362]) }' />
            </column>
            <column caption='Final GMV1' datatype='real' name='[Calculation_2459246898896388096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [successful_gmv_amount_lc] else [successful_gmv_amount_eur] END' />
            </column>
            <column caption='aggregated_trendline_date' datatype='datetime' name='[Calculation_2459246899196194818]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Month&apos; then DATETRUNC(&apos;month&apos;,[date]) &#10;elseif [Parameters].[Parameter 4] = &apos;Week&apos; then DATETRUNC(&apos;week&apos;,[date]) &#10;else [date] END' />
            </column>
            <column caption='bookings' datatype='integer' name='[Calculation_2459246899224383495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([booking_id])' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_2459246899244789769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Euro&apos; then [revenue_eur] else [revenue_lc] END' />
            </column>
            <column caption='Budget' datatype='real' name='[Calculation_2459246899245133834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Euro&apos; then [budget_eur] else [budget_lc] END' />
            </column>
            <column caption='month' datatype='datetime' name='[Calculation_2459246899257475084]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_2459246899260841999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_3792804978631925767])/sum([Calculation_3792804978632163336])' />
            </column>
            <column caption='% Bookings &gt;3 ROAS' datatype='integer' name='[Calculation_2459246899262435344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [booking_id] : (&#10;IF [Calculation_2459246899260841999]&gt;3&#10;THEN 1&#10;ELSE 0&#10;END&#10;) }' />
            </column>
            <column caption='% vendors with &gt; 3 ROAS' datatype='real' name='[Calculation_2459246899262595089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2459246899262435344])/[Calculation_2459246899224383495]' />
            </column>
            <column caption='Budget Fixed inclusive of outlier' datatype='real' name='[Calculation_3792804978629156865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([date]), [booking_id], [vendor_id]: AVG([Calculation_2459246899245133834]) }' />
            </column>
            <column caption='Inclusion Budget' datatype='real' name='[Calculation_3792804978629775362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Exclude&quot; THEN [Calculation_2459246899245133834] END' />
            </column>
            <column caption='Budget Booked' datatype='real' name='[Calculation_3792804978631065604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Exclude&quot;&#10;THEN [Budget Fixed inclusive of outlier (copy)_3792804978630119427]&#10;ELSEIF  [Parameters].[Parameter 5] = &quot;Include&quot;&#10;THEN [Calculation_3792804978629156865]&#10;END' />
            </column>
            <column caption='Cost Fixed' datatype='real' name='[Calculation_3792804978631409669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED month(date),[booking_id],[vendor_id]: SUM([Calculation_2459246899244789769]) }' />
            </column>
            <column caption='Cost Fixed Final' datatype='real' name='[Calculation_3792804978631614470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3792804978631409669] &gt; [Calculation_3792804978631065604] THEN [Calculation_3792804978631065604] ELSE [Calculation_3792804978631409669] END' />
            </column>
            <column caption='Fixed Budget' datatype='real' name='[Calculation_3792804978631925767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: SUM([Calculation_2459246898896388096]) }' />
            </column>
            <column caption='Budget Consumed' datatype='real' name='[Calculation_3792804978632163336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: SUM([Calculation_3792804978631614470]) }' />
            </column>
            <column datatype='integer' name='[booking_id]' role='measure' type='quantitative' />
            <column caption='Booking Type' datatype='string' name='[booking_type]' role='dimension' type='nominal'>
              <aliases>
