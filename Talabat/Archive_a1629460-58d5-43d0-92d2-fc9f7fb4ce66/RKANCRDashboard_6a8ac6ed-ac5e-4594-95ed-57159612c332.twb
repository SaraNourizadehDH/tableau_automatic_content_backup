      </column>
      <column caption='Date filter' datatype='boolean' name='[Calculation_1579707964376903687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1579707964377067528] OR [Calculation_1579707964378292234]' />
      </column>
      <column caption='CP_Timeline' datatype='boolean' name='[Calculation_1579707964377067528]' role='dimension' type='nominal'>
