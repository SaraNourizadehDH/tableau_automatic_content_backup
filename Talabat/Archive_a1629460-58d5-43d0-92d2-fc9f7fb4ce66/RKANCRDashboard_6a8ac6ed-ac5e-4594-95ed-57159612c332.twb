              </aliases>
            </column>
            <column datatype='real' name='[budget_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[budget_lc]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
