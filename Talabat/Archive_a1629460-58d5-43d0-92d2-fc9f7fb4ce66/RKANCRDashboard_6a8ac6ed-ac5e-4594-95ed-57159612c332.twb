      <table>
        <view>
          <datasources>
            <datasource caption='RKA NCR' name='federated.1qpk1zm0wtolw816jz4u611hnts3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comparision End Date' datatype='date' default-format='*MMMM-YYYY' name='[End Date (copy)_2893703556139741196]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-31#'>
              <calculation class='tableau' formula='#2023-01-31#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Start Date' datatype='date' default-format='*MMMM-YYYY' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
            <column caption='End Date' datatype='date' default-format='*MMMM-YYYY' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-06-30#'>
              <calculation class='tableau' formula='#2024-06-30#' />
            </column>
            <column caption='Comparision Start Date' datatype='date' default-format='*MMMM-YYYY' name='[Start Date (copy)_2893703556139741195]' param-domain-type='any' role='measure' type='quantitative' value='#2022-01-01#'>
              <calculation class='tableau' formula='#2022-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qpk1zm0wtolw816jz4u611hnts3'>
            <column caption='Final_Rev' datatype='real' name='[Calculation_1579707964360863745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [Rev_LC] else [Rev_EUR] END' />
            </column>
            <column caption='Trendline Date Filter' datatype='boolean' name='[Calculation_1579707964372119554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Yearmonth] &gt;= [Parameters].[Parameter 2] AND [Yearmonth] &lt;= [Parameters].[Parameter 3])&#10;OR &#10;([Yearmonth] &gt;= [Parameters].[Start Date (copy)_2893703556139741195] AND [Yearmonth] &lt;= [Parameters].[End Date (copy)_2893703556139741196])' />
            </column>
            <column caption='Days in between SD &amp; ED' datatype='integer' name='[Calculation_1579707964376641542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Parameters].[Start Date (copy)_2893703556139741195],[Parameters].[Parameter 2])' />
            </column>
            <column caption='CP_Timeline' datatype='boolean' name='[Calculation_1579707964377067528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Yearmonth]&gt;=[Parameters].[Parameter 2] AND [Yearmonth]&lt;=[Parameters].[Parameter 3]' />
              <aliases>
                <alias key='false' value='Previous Period' />
                <alias key='true' value='Current Period' />
              </aliases>
            </column>
            <column caption='Dummy Axis' datatype='datetime' name='[Calculation_1579707964378771467]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ([Calculation_1579707964377067528]) THEN [Yearmonth]&#10;    ELSE DATEADD(&apos;month&apos;, [Calculation_1579707964376641542] ,[Yearmonth]) END' />
            </column>
            <column caption='Final GMV1' datatype='real' name='[Calculation_2459246898896388096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [successful_gmv_amount_lc] else [successful_gmv_amount_eur] END' />
            </column>
            <column caption='NCR_over_GMV' datatype='real' name='[Calculation_6447676946100568064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1579707964360863745]) / sum([Calculation_2459246898896388096])' />
            </column>
            <column datatype='real' name='[Rev_EUR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Rev_LC]' role='measure' type='quantitative' />
            <column datatype='date' name='[Yearmonth]' role='dimension' type='ordinal' />
