            </column>
            <column caption='Trendline Label' datatype='string' name='[Calculation_2459246899201552389]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Month&apos; then &apos;Last 12 Months&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Week&apos; then &apos;Last 12 Weeks&apos;&#10;ELSE &apos;Last 30 days&apos; END' />
            </column>
