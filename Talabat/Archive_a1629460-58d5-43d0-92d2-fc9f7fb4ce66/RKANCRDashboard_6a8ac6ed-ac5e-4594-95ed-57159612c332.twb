              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Month&apos; then DATETRUNC(&apos;month&apos;,[date]) &#10;elseif [Parameters].[Parameter 4] = &apos;Week&apos; then DATETRUNC(&apos;week&apos;,[date]) &#10;else [date] END' />
            </column>
            <column caption='trendline date filter - ROI' datatype='boolean' name='[Calculation_2459246899197370371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Month&apos; then &#10;[Calculation_2459246899196194818] &gt;= datetrunc(&apos;month&apos;,dateadd(&apos;month&apos;,-11,[Parameters].[Parameter 3]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Week&apos; then &#10;[Calculation_2459246899196194818] &gt;= datetrunc(&apos;week&apos;,dateadd(&apos;week&apos;,-12,[Parameters].[Parameter 3]))&#10;&#10;else &#10;[Calculation_2459246899196194818] &gt;= datetrunc(&apos;day&apos;,dateadd(&apos;day&apos;,-30,[Parameters].[Parameter 3]))&#10;&#10;end' />
            </column>
            <column caption='CTO' datatype='real' name='[Calculation_2459246899197976580]' role='measure' type='quantitative'>
