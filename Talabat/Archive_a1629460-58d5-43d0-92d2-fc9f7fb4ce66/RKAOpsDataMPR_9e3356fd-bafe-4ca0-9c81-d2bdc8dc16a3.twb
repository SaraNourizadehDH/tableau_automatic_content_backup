            </column>
            <column caption='EPT + AVTC' datatype='real' name='[Calculation_5185824618241273888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_ept_plus_avtc]) / sum([tgo_orders])' />
            </column>
            <column caption='comparision_trendline' datatype='string' name='[Calculation_5185824618242002978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] = [Parameters].[Parameter 2] THEN &apos;Current Duration&apos; &#10;ELSEIF [month] = [Parameters].[Previous Duration (copy)_336151507604172819] THEN &apos;YoY Duration&apos; &#10;ELSE &apos;Previous Duration&apos; END' />
