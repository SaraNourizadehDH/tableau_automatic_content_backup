            </column>
            <column caption='Other Rev % GMV' datatype='real' name='[Calculation_336151507606118421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_336151507553853441])/sum([Calculation_5185824618229780483])' />
            </column>
            <column caption='Effective Fees / Order' datatype='real' name='[Calculation_336151507606724630]' role='measure' type='quantitative'>
