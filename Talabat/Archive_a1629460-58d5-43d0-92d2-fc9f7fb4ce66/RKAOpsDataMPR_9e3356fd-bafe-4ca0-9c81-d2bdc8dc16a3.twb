            <column caption='cost_of_sales' datatype='real' name='[Calculation_336151507557445643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_336151507555299332]) +&#10;sum([Calculation_336151507555459077]) +&#10;sum([Calculation_336151507555713030]) +&#10;sum([Calculation_336151507555876871]) + &#10;sum([Calculation_336151507556016136])' />
            </column>
            <column caption='gross_profit (gp)' datatype='real' name='[Calculation_336151507557658636]' role='measure' type='quantitative'>
