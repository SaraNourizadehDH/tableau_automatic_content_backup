      <column caption='test' datatype='real' name='[Calculation_5185824618252865579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM(0)) - LOOKUP(ZN(SUM(0)), -1)) / ABS(LOOKUP(ZN(SUM(0)), -1))'>
