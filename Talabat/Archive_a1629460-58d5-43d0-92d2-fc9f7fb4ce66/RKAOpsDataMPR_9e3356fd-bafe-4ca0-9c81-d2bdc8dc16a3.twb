      <table>
        <view>
          <datasources>
            <datasource caption='MRP_dashboard' name='federated.0iz90qy0tdx1gj13v3p0406pf4q7' />
          </datasources>
          <datasource-dependencies datasource='federated.0iz90qy0tdx1gj13v3p0406pf4q7'>
            <column caption='fail rate %' datatype='real' name='[Calculation_5185824618238869529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_net_failed_orders]) / sum([net_orders])' />
            </column>
            <column caption='contact rate %' datatype='real' name='[Calculation_5185824618239107098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fault_customer_contacts]) / sum([gross_orders])' />
            </column>
            <column caption='On Time % (Talabat)' datatype='real' name='[Calculation_5185824618240561181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_on_time_talabat_numerator]) / sum([order_on_time_talabat_denominator])' />
            </column>
            <column caption='Avg Actual Delivery Time' datatype='real' name='[Calculation_5185824618240847902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_actual_delivery_time]) / sum([tgo_orders])' />
            </column>
            <column caption='Vendor Delay V2 &gt;10mins %' datatype='real' name='[Calculation_5185824618241056799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_delay_v2_10mins]) / sum([tgo_orders])' />
