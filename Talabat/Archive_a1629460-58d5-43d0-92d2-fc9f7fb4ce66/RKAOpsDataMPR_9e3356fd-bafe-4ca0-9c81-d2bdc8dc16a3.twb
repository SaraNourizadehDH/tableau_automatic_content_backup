        <calculation class='tableau' formula='[month] &gt;= date(&apos;2023-05-01&apos;)&#10;AND &#10;[month]&lt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()))' />
