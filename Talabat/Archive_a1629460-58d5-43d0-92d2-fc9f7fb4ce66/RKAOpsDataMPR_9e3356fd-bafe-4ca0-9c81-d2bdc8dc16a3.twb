      <column caption='platform_orders' datatype='integer' name='[Calculation_1146588342426079232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [month], [country]: sum([orders]) }' />
      </column>
      <column caption='group_flag' datatype='string' name='[Calculation_1146588342433939457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [group_name] = &apos;Others&apos; THEN &apos;Others&apos; ELSEIF [group_name] = &apos;Other American Brands&apos; THEN &apos;Other American Brands&apos; ELSE &apos;RKA&apos; END' />
        <aliases>
          <alias key='&quot;Others&quot;' value='Platform' />
        </aliases>
      </column>
      <column caption='baseline month trendline' datatype='boolean' name='[Calculation_1146588342435573762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month] &gt;= DATE(&apos;2023-08-01&apos;)&#10;AND &#10;[month]&lt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()))' />
      </column>
      <column caption='M0_freq' datatype='real' name='[Calculation_1146588342500347908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Freq_M0]) / sum([unique_users])' />
      </column>
      <column caption='retention_m1' datatype='real' name='[Calculation_1146588342500954117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Ret_M1]) / sum([unique_users])' />
      </column>
      <column caption='Savings Over GMV % ' datatype='real' name='[Calculation_1146588342732128264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1146588342788452362]) / sum([Calculation_5185824618231820301])' />
      </column>
      <column caption='vfd_discount_amount' datatype='real' name='[Calculation_1146588342788452362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [vfd_discount_amount_euro] ELSE [vfd_discount_amount_lc] END' />
      </column>
      <column caption='vfd_type_basket_amount' datatype='real' name='[Calculation_1146588342795673613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos;  THEN [basket_amount_eur] ELSE [basket_amount_lc] END' />
      </column>
      <column caption='__test_day' datatype='integer' name='[Calculation_1146588342802542607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed [month]: max([no_of_days]) }' />
      </column>
      <column caption='Avg Daily Orders' datatype='real' name='[Calculation_1146588342803722256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders]) / sum([Calculation_1146588342802542607])' />
      </column>
      <column caption='Comparison_on_ppt_new_palakshee' datatype='boolean' name='[Calculation_1146588342805184529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month] = [Parameters].[Parameter 2]&#10;OR&#10;[month] = [Parameters].[Current Duration (copy)_5185824618241941537]&#10;OR&#10;[month] = [Parameters].[Previous Duration (copy)_336151507604172819]&#10;OR&#10;[month] = DATE(&apos;2023-11-01&apos;)' />
      </column>
