      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MRP_dashboard' name='federated.0iz90qy0tdx1gj13v3p0406pf4q7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0iz90qy0tdx1gj13v3p0406pf4q7].[month]' caption='Previous Duration' datatype='date' default-format='*MMM-YYYY' name='[Current Duration (copy)_5185824618241941537]' param-domain-type='list' role='measure' type='quantitative' value='#2024-04-01#'>
              <calculation class='tableau' formula='#2024-04-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0iz90qy0tdx1gj13v3p0406pf4q7].[month]' caption='Current Duration' datatype='date' default-format='*MMM-YYYY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0iz90qy0tdx1gj13v3p0406pf4q7].[month]' caption='YoY Duration' datatype='date' default-format='*MMM-YYYY' name='[Previous Duration (copy)_336151507604172819]' param-domain-type='list' role='measure' type='quantitative' value='#2023-05-01#'>
              <calculation class='tableau' formula='#2023-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iz90qy0tdx1gj13v3p0406pf4q7'>
            <column caption='platform_orders' datatype='integer' name='[Calculation_1146588342426079232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month], [country]: sum([orders]) }' />
            </column>
            <column caption='__test_day' datatype='integer' name='[Calculation_1146588342802542607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed [month]: max([no_of_days]) }' />
            </column>
            <column caption='Avg Daily Orders' datatype='real' name='[Calculation_1146588342803722256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders]) / sum([Calculation_1146588342802542607])' />
            </column>
            <column caption='act_delivery_service_revenue_amount' datatype='real' name='[Calculation_336151507543126016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_delivery_service_revenue_amount_eur] ELSE [act_delivery_service_revenue_amount_lc] END' />
            </column>
            <column caption='act_revenue_reduction_others' datatype='real' name='[Calculation_336151507553853441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_revenue_reduction_others_eur] ELSE [act_revenue_reduction_others_lc] END' />
            </column>
            <column caption='act_server_transmission' datatype='real' name='[Calculation_336151507555299332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_server_transmission_eur] ELSE [act_server_transmission_lc] END' />
            </column>
            <column caption='act_contact_center' datatype='real' name='[Calculation_336151507555459077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_contact_center_eur] ELSE [act_contact_center_lc] END' />
            </column>
            <column caption='act_payment_cost' datatype='real' name='[Calculation_336151507555713030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_payment_cost_eur] ELSE [act_payment_cost_lc] END' />
            </column>
            <column caption='act_bad_debt' datatype='real' name='[Calculation_336151507555876871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_bad_debt_eur] ELSE [act_bad_debt_lc] END' />
            </column>
            <column caption='act_other_costs' datatype='real' name='[Calculation_336151507556016136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_other_costs_eur] ELSE [act_other_costs_lc] END' />
            </column>
            <column caption='total_revenue' datatype='real' name='[Calculation_336151507556683785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618231517195]) + &#10;sum([Calculation_336151507543126016]) +&#10;sum([Calculation_336151507559043085]) +&#10;sum([Calculation_5185824618232492049]) +&#10;sum([Calculation_336151507553853441])' />
            </column>
            <column caption='net_revenue' datatype='real' name='[Calculation_336151507557240842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_336151507556683785] + sum([Calculation_5185824618235772949])' />
            </column>
            <column caption='cost_of_sales' datatype='real' name='[Calculation_336151507557445643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_336151507555299332]) +&#10;sum([Calculation_336151507555459077]) +&#10;sum([Calculation_336151507555713030]) +&#10;sum([Calculation_336151507555876871]) + &#10;sum([Calculation_336151507556016136])' />
            </column>
            <column caption='gross_profit (gp)' datatype='real' name='[Calculation_336151507557658636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_336151507557240842] + [Calculation_336151507557445643]' />
            </column>
            <column caption='act_service_fee_revenue_amount' datatype='real' name='[Calculation_336151507559043085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_service_fee_revenue_amount_eur] ELSE [act_service_fee_revenue_amount_lc] END' />
            </column>
            <column caption='Other Rev % GMV' datatype='real' name='[Calculation_336151507606118421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_336151507553853441])/sum([Calculation_5185824618229780483])' />
            </column>
            <column caption='Effective Fees / Order' datatype='real' name='[Calculation_336151507606724630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([Calculation_336151507543126016])+&#10;sum([Calculation_336151507559043085]) + &#10;sum([Calculation_5185824618232492049]) +&#10;sum([Calculation_336151507553853441]) ) / SUM([orders])' />
            </column>
            <column caption='COS / Order' datatype='real' name='[Calculation_336151507607695383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_336151507557445643] / sum([orders])' />
            </column>
            <column caption='Order Share' datatype='real' name='[Calculation_5185824618227642368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/sum([Calculation_1146588342426079232])' />
            </column>
            <column caption='Avg Daily Orders Per Brand' datatype='real' name='[Calculation_5185824618229227521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/sum([no_of_days])' />
            </column>
            <column caption='gmv' datatype='real' name='[Calculation_5185824618229780483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [gmv_euro] ELSE [gmv_lc] END' />
            </column>
            <column caption='tgo_gmv' datatype='real' name='[Calculation_5185824618229997572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [tgo_gmv_eur] ELSE [tgo_gmv_lc] END' />
            </column>
            <column caption='mp_gmv_euro' datatype='real' name='[Calculation_5185824618230185989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_euro]-[tgo_gmv_eur]' />
            </column>
            <column caption='mp_gmv' datatype='real' name='[Calculation_5185824618230538248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [Calculation_5185824618230185989] ELSE [tgo_mp_euro (copy)_5185824618230337542] END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_5185824618231324681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618229780483])/sum([orders])' />
            </column>
            <column caption='act_commission_revenue' datatype='real' name='[Calculation_5185824618231517195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_commission_revenue_amount_eur] ELSE [act_commission_revenue_amount_lc] END' />
            </column>
            <column caption='CR% / GMV' datatype='real' name='[Calculation_5185824618231652364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618231517195]) / sum([Calculation_5185824618229780483])' />
            </column>
            <column caption='basket_value' datatype='real' name='[Calculation_5185824618231820301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [basket_value_euro] ELSE [basket_value_lc] END' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_5185824618232111119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618231820301]) / SUM([orders])' />
            </column>
            <column caption='CR%  / GFV' datatype='real' name='[Calculation_5185824618232307728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5185824618231517195]) / SUM([Calculation_5185824618231820301])' />
            </column>
            <column caption='NCR' datatype='real' name='[Calculation_5185824618232492049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [Rev_EUR] ELSE [Rev_LC] END' />
            </column>
            <column caption='NCR % GMV' datatype='real' name='[Calculation_5185824618232602642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618232492049]) / SUM([Calculation_5185824618229780483])' />
            </column>
            <column caption='GPO' datatype='real' name='[Calculation_5185824618233049108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_336151507557658636] / sum([orders])' />
            </column>
            <column caption='act_cp' datatype='real' name='[Calculation_5185824618235772949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Euro&apos; THEN [act_cpo_eur] ELSE [act_cpo_lc] END' />
            </column>
            <column caption='Fully Loaded CPO (CPO1 + CPO2 + CPO3)' datatype='real' name='[Calculation_5185824618235928598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5185824618235772949]) / sum([act_egpo_orders])' />
            </column>
            <column caption='comparision_trendline' datatype='string' name='[Calculation_5185824618242002978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] = [Parameters].[Parameter 2] THEN &apos;Current Duration&apos; &#10;ELSEIF [month] = [Parameters].[Previous Duration (copy)_336151507604172819] THEN &apos;YoY Duration&apos; &#10;ELSE &apos;Previous Duration&apos; END' />
            </column>
            <column caption='CP or PP' datatype='boolean' name='[Calculation_5185824618242875428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month] = [Parameters].[Parameter 2] OR [month] = [Parameters].[Current Duration (copy)_5185824618241941537] or [month] = [Parameters].[Previous Duration (copy)_336151507604172819]' />
            </column>
