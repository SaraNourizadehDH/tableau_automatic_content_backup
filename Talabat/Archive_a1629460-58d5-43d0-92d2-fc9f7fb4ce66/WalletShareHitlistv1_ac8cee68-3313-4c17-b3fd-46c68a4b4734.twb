          <filter class='categorical' column='[federated.00ekbim0z3ck5u10r7t1m1e31jfu].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.00ekbim0z3ck5u10r7t1m1e31jfu].[usr:Card and cash fee \%  (copy)_4078783543743811593:qk]&quot;' />
