            <column datatype='real' name='[tgo_amount_eur]' role='measure' type='quantitative' />
            <column caption='Tpro cost' datatype='real' name='[tpro_savings]' role='measure' type='quantitative' />
            <column-instance column='[Adrev % (copy)_4078783543743598599]' derivation='User' name='[usr:Adrev % (copy)_4078783543743598599:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4078783543743455237]' derivation='User' name='[usr:Calculation_4078783543743455237:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4078783543744045066]' derivation='User' name='[usr:Calculation_4078783543744045066:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4078783543744909325]' derivation='User' name='[usr:Calculation_4078783543744909325:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4078783543744970766]' derivation='User' name='[usr:Calculation_4078783543744970766:qk]' pivot='key' type='quantitative' />
