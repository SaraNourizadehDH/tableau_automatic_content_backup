      </column>
      <column caption='VFD % ' datatype='real' name='[Adrev % (copy)_4078783543743533062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spend (copy)_4078783543741165570] / sum([successful_gfv])' />
      </column>
      <column caption='Card and cash fee % ' datatype='real' name='[Adrev % (copy)_4078783543743598599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spend (copy)_4078783543741620228] / sum([successful_gfv])' />
      </column>
      <column caption='DT Hitlist ' datatype='string' name='[Best Seller Hitlist (copy)_1427078160274972682]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4078783543744909325] &lt; AVG([VFDtFloor])  &#13;&#10;AND ATTR([Calculation_1125336998740361220]) =  &quot;Yes&quot;&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='DT Status' datatype='string' name='[Best Seller Status (copy)_1427078160274374665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR([StatusDT]) = &quot;t&quot; Then &quot;Yes&quot;&#13;&#10;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Kwords Hitlist' datatype='string' name='[CPC Hitlist (copy)_445856391138693135]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Expected CPC RoAS (copy)_445856391129628684]) THEN &quot;&quot; ELSEIF  [Calculation_4078783543743455237] &lt; AVG([AdsFloor])  &#13;&#10;AND [Expected CPC RoAS (copy)_445856391129628684] &gt; 2.5&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='KW Hitlist Fix' datatype='string' name='[CPC Hitlist FIX (copy)_1427078160272322566]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([CPC Status (copy)_1427078160272035845]) = 1 then    &quot;&quot;&#13;&#10;ELSE  [CPC Hitlist (copy)_445856391138693135]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='KW Status ' datatype='integer' name='[CPC Status (copy)_1427078160272035845]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [KWstatus] = 1 Then 1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='CP Cstatus' datatype='integer' name='[CPCstatus]' role='dimension' type='ordinal' />
      <column caption='Best Seller Status2' datatype='string' name='[Calculation_1125336998739603459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status (bestseller2)] = TRUE Then &quot;Yes&quot;&#13;&#10;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='DT Status2' datatype='string' name='[Calculation_1125336998740361220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR([StatusDT (dthitlist2)]) = &quot;t&quot; Then &quot;Yes&quot;&#13;&#10;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='KW AOV' datatype='real' name='[Calculation_1187542954486636544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([KWGMV])/SUM([KWorders])' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1187542954486730753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_gmv])/SUM([successful_orders])' />
      </column>
      <column caption='KW Conversion' datatype='real' name='[Calculation_1187542954486939650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([KWorders])/SUM([KWclicks])' />
      </column>
      <column caption='Conversion' datatype='real' name='[Calculation_1187542954487017475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/SUM([vendorclicks])' />
      </column>
      <column caption='CPC Status' datatype='integer' name='[Calculation_1427078160270012417]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [CPCstatus] = 1 Then 1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='CPC Hitlist FIX' datatype='string' name='[Calculation_1427078160271372292]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1427078160270012417]) = 1 then    &quot;&quot;&#13;&#10;ELSE  [Calculation_445856391130206221]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total wallet spend' datatype='real' name='[Calculation_4078783543739793408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;IFNULL([commission_amount_eur],0) + &#10;IFNULL([tgo_amount_eur],0) + &#10;IFNULL([fp_revenue_eur],0) + &#10;IFNULL([kw_revenue_eur],0) + &#10;IFNULL([cpp_monthly_revenue_eur_total],0) + &#10;IFNULL([deal_target_ncr_eur],0) +&#10;IFNULL([discount_gmv],0) + &#10;IFNULL([gem_commission_amount_eur],0) + &#10;IFNULL([pp_revenue_eur],0) +  &#10;IFNULL([cash_fee],0) + &#10;IFNULL([card_fee],0) + &#10;IFNULL([tpro_savings],0) )' />
      </column>
      <column caption='Adrev %' datatype='real' name='[Calculation_4078783543743455237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spend (copy)_4078783543741034497] / sum([successful_gfv])' />
      </column>
      <column caption='Wallet share' datatype='real' name='[Calculation_4078783543744045066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4078783543739793408] / sum([successful_gfv])' />
      </column>
      <column caption='Targeted discounts ' datatype='real' name='[Calculation_4078783543744720907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([targeted_deals_discounts],0))' />
      </column>
      <column caption='Untargeted discounts' datatype='real' name='[Calculation_4078783543744802828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([discount_gmv],0)) - (IFNULL([Calculation_4078783543744720907],0))' />
      </column>
      <column caption='Targeted discounts %' datatype='real' name='[Calculation_4078783543744909325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_4078783543744720907],0) / sum([successful_gfv])' />
      </column>
      <column caption='Untargeted discounts %' datatype='real' name='[Calculation_4078783543744970766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4078783543744802828]) / sum([successful_gfv])' />
      </column>
      <column caption='EPM' datatype='real' name='[Calculation_4078783543757516815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([successful_gfv]) - ([Calculation_4078783543739793408])' />
      </column>
      <column caption='EPO' datatype='real' name='[Calculation_4078783543757660176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4078783543757516815] / SUM([successful_orders])' />
      </column>
      <column caption='median new customers' datatype='real' name='[Calculation_4078783543957868565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([new_customers]) &gt; 0 then MEDIAN([new_customers]) end' />
      </column>
      <column caption='Median new customers by cuisine' datatype='real' name='[Calculation_4078783543958147094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [date_month] ,[main_cuisine], [new_customers] &gt;0 : MEDIAN([new_customers])}' />
      </column>
      <column caption='cuisines gmv sum' datatype='real' name='[Calculation_4078783544138563607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code],[date_month],[main_cuisine] : sum([successful_gmv])}' />
      </column>
      <column caption='Cuisine gmv share %' datatype='real' name='[Calculation_4078783544138747928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_gmv]) / sum([Calculation_4078783544138563607])' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_4078783544139198489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order_session_count])/SUM([viewed_menu_session_count])' />
      </column>
      <column caption='Added to cart %' datatype='real' name='[Calculation_4078783544139321370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([added_to_cart_sessions])/sum([viewed_menu_session_count])' />
      </column>
      <column caption='Image ratio' datatype='real' name='[Calculation_4078783544139571227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_images])/sum([total_active_menu_items])' />
      </column>
      <column caption='Description ratio' datatype='real' name='[Calculation_4078783544139755548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_description])/sum([total_active_menu_items])' />
      </column>
      <column caption='Target Floor' datatype='real' name='[Calculation_445856391127695370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[AdsFloor] + [CRFloor] + [PaymentFloor] + [tproFloor] + [VFDtFloor] + [VFDuFloor]' />
      </column>
      <column caption='Expected CPC RoAS' datatype='real' name='[Calculation_445856391129399307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1187542954487017475]*[Calculation_1187542954486730753])/AVG([CPCprice])' />
      </column>
      <column caption='CPC Hitlist' datatype='string' name='[Calculation_445856391130206221]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_445856391129399307]) THEN &quot;&quot; ELSEIF  [Calculation_4078783543743455237] &lt; AVG([AdsFloor])  &#13;&#10;AND [Calculation_445856391129399307] &gt; 2.5&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='GEM Hitlist ' datatype='string' name='[Calculation_445856391152062481]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4078783543743455237] &lt; AVG([AdsFloor])  &#13;&#10;AND ATTR([Kwords Hitlist (copy)_445856391149649936]) = 1&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='Best Seller Status' datatype='string' name='[Calculation_445856391174504467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] = &quot;true&quot; Then &quot;Yes&quot;&#13;&#10;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;&#13;&#10;END' />
