    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.00ekbim0z3ck5u10r7t1m1e31jfu' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1p6op6u0zy3gwl16leb8517ug59o'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='' username='rahul.verma@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Ads last 14' name='cloudfile:googledrive-excel-direct.0ky50kf0qhrzkw17u5uy513h3hnh'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1ypV56brzmYUP2jO44NxGyvgYc0ORtqDaTnMfO6Q0y8E' cloudFileMetadata_-_folder='root' cloudFileName='Ads last 14.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1ypV56brzmYUP2jO44NxGyvgYc0ORtqDaTnMfO6Q0y8E/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Ads last 14.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='rahul.verma@talabat.com' validate='no' workgroup-auth-mode='prompt' />
