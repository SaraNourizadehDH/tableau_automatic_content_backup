    <worksheet name='wallet share (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Wallet share components - &lt;</run>
            <run fontsize='12'>[federated.00ekbim0z3ck5u10r7t1m1e31jfu].[none:country_code:nk]</run>
            <run fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.00ekbim0z3ck5u10r7t1m1e31jfu' />
          </datasources>
          <datasource-dependencies datasource='federated.00ekbim0z3ck5u10r7t1m1e31jfu'>
            <column caption='Card and cash fee % ' datatype='real' name='[Adrev % (copy)_4078783543743598599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[spend (copy)_4078783543741620228] / sum([successful_gfv])' />
            </column>
            <column caption='Total wallet spend' datatype='real' name='[Calculation_4078783543739793408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;IFNULL([commission_amount_eur],0) + &#10;IFNULL([tgo_amount_eur],0) + &#10;IFNULL([fp_revenue_eur],0) + &#10;IFNULL([kw_revenue_eur],0) + &#10;IFNULL([cpp_monthly_revenue_eur_total],0) + &#10;IFNULL([deal_target_ncr_eur],0) +&#10;IFNULL([discount_gmv],0) + &#10;IFNULL([gem_commission_amount_eur],0) + &#10;IFNULL([pp_revenue_eur],0) +  &#10;IFNULL([cash_fee],0) + &#10;IFNULL([card_fee],0) + &#10;IFNULL([tpro_savings],0) )' />
            </column>
            <column caption='Adrev %' datatype='real' name='[Calculation_4078783543743455237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[spend (copy)_4078783543741034497] / sum([successful_gfv])' />
            </column>
            <column caption='Wallet share' datatype='real' name='[Calculation_4078783543744045066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4078783543739793408] / sum([successful_gfv])' />
            </column>
            <column caption='Targeted discounts ' datatype='real' name='[Calculation_4078783543744720907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([targeted_deals_discounts],0))' />
            </column>
            <column caption='Untargeted discounts' datatype='real' name='[Calculation_4078783543744802828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([discount_gmv],0)) - (IFNULL([Calculation_4078783543744720907],0))' />
            </column>
            <column caption='Targeted discounts %' datatype='real' name='[Calculation_4078783543744909325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_4078783543744720907],0) / sum([successful_gfv])' />
            </column>
            <column caption='Untargeted discounts %' datatype='real' name='[Calculation_4078783543744970766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4078783543744802828]) / sum([successful_gfv])' />
            </column>
            <column caption='Tpro cost % ' datatype='real' name='[Card and cash fee %  (copy)_4078783543743705096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tpro_savings]) / sum([successful_gfv])' />
            </column>
            <column caption='Commission revenue % ' datatype='real' name='[Card and cash fee %  (copy)_4078783543743811593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[spend (copy)_4078783543741505539] / sum([successful_gfv])' />
            </column>
            <column caption='account manager name' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[card_fee]' role='measure' type='quantitative' />
            <column datatype='real' name='[cash_fee]' role='measure' type='quantitative' />
            <column caption='chain tier' datatype='string' name='[chain_segments_reorder]' role='dimension' type='nominal' />
            <column datatype='real' name='[commission_amount_eur]' role='measure' type='quantitative' />
            <column caption='country code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[cpp_monthly_revenue_eur_total]' role='measure' type='quantitative' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[deal_target_ncr_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[fp_revenue_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gem_commission_amount_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[kw_revenue_eur]' role='measure' type='quantitative' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_segments_reorder]' derivation='None' name='[none:chain_segments_reorder:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pp_revenue_eur]' role='measure' type='quantitative' />
            <column caption='adrev' datatype='real' name='[spend (copy)_4078783543741034497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;&#10;&#10;IFNULL([fp_revenue_eur],0) + &#10;IFNULL([kw_revenue_eur],0) + &#10;IFNULL([cpp_monthly_revenue_eur_total],0) + &#10;IFNULL([pp_revenue_eur],0) + &#10;IFNULL([deal_target_ncr_eur],0) +&#10;IFNULL([gem_commission_amount_eur],0)  &#10;)' />
            </column>
            <column caption='commission rev  amount' datatype='real' name='[spend (copy)_4078783543741505539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;IFNULL([commission_amount_eur],0) + &#10;IFNULL([tgo_amount_eur],0)  )' />
            </column>
            <column caption='card and cash fee ' datatype='real' name='[spend (copy)_4078783543741620228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;IFNULL([cash_fee],0) + &#10;IFNULL([card_fee],0) )' />
            </column>
            <column caption='GFV' datatype='real' name='[successful_gfv]' role='measure' type='quantitative' />
