      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.00ekbim0z3ck5u10r7t1m1e31jfu].[ctd:vendor_id:qk]&quot;' value='# vendors' />
