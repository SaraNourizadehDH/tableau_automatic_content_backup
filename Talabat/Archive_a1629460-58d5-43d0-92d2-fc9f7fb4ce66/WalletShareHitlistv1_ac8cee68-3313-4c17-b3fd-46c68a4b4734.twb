            </column>
            <column caption='DT Status2' datatype='string' name='[Calculation_1125336998740361220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([StatusDT (dthitlist2)]) = &quot;t&quot; Then &quot;Yes&quot;&#13;&#10;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;&#13;&#10;END' />
