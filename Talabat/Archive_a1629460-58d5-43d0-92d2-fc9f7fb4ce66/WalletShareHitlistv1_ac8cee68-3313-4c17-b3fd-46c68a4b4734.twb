          <relation connection='bigquery.1p6op6u0zy3gwl16leb8517ug59o' name='Custom SQL Query1' type='text'>SELECT&#13;
  DISTINCT v.vendor_id,&#13;
  &#13;
  a.id AS Account_id,&#13;
  &#13;
  u.id AS User_id,&#13;
&#13;
FROM `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l&#13;
ON l.location_id = v.location_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` w&#13;
ON w.chain_id = v.chain_id&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a&#13;
ON v.salesforce_id = a.grid__c&#13;
LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c&#13;
ON a.id = c.accountid&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o&#13;
ON a.id =o.accountid&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u&#13;
ON v.account_manager_email = email&#13;
WHERE&#13;
isactive = TRUE</relation>
