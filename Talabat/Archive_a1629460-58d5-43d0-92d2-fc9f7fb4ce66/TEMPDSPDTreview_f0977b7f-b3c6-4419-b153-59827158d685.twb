          <named-connection caption='BigQuery' name='bigquery.1aq6wj00px4yge1g4w43e1y72ywe'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='server-custom' username='fakhry.auzan@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
