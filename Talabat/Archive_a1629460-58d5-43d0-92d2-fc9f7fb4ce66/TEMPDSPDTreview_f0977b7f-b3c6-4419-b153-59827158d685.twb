      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tmart hour PDT' id='_0D7AD78F184B47A2B391CDE71E35B9C3'>
            <properties context=''>
              <relation connection='bigquery.1aq6wj00px4yge1g4w43e1y72ywe' name='Custom SQL Query' type='text'><![CDATA[with default_v as (
select
entity_id,
vendor_name,
vendor_code,
city_name,
CASE
when country_code='qa' then 25
when country_code='ae' then 20
when country_code='bh' then 20
when country_code='eg' then 20
when country_code='iq' then 25
when country_code='jo' then 25
when country_code='kw' then 30
when country_code='om' then 20
end as fixed_duration
from `tlb-data-prod.data_platform.dim_logistics_vendor`
left join `tlb-data-prod.data_platform.dim_logistics_city` using(country_code, city_id)
where vertical_type='darkstores'
and (entity_id like 'TB_%' or entity_id like 'HF_%')
order by 1,2
)

, raw as (
select
country_code,
entity.id as entity_id,
vendor.vendor_code as vendor_code,
created_at,
created_date,
timezone,
timings.promised_delivery_time as promised_delivery_time,
platform_order_id as order_id,
from `fulfillment-dwh-production.curated_data_shared.orders`
where created_date>>=current_date()-14
and promised_delivery_time is not null
)

select
country_code,
vendor_code,
vendor_name,
city_name,
date(created_at,timezone) as created_date,
extract(hour from datetime(created_at,timezone)) as created_hour,
count(distinct order_id) as no_of_orders,
count(distinct case when round(promised_delivery_time/60)=fixed_duration then order_id end) as same_time,
count(distinct case when round(promised_delivery_time/60)=fixed_duration-1 then order_id end) as minus_1_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration-2 then order_id end) as minus_2_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration-3 then order_id end) as minus_3_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration-4 then order_id end) as minus_4_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration-5 then order_id end) as minus_5_minute,
count(distinct case when round(promised_delivery_time/60)<<fixed_duration-5 then order_id end) as minus_less_than_5_minute,

count(distinct case when round(promised_delivery_time/60)=fixed_duration+1 then order_id end) as plus_1_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+2 then order_id end) as plus_2_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+3 then order_id end) as plus_3_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+4 then order_id end) as plus_4_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+5 then order_id end) as plus_5_minute,
count(distinct case when round(promised_delivery_time/60)>>fixed_duration+5 then order_id end) as plus_more_than_5_minute,

from default_v
-- left join `tlb-data-prod.data_platform.fct_logistics_order` using(entity_id, vendor_code)
left join raw using(entity_id, vendor_code)
where created_date>>=current_date()-14
and promised_delivery_time is not null
group by 1,2,3,4,5,6]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
