count(distinct case when round(promised_delivery_time/60)<<fixed_duration-5 then order_id end) as minus_less_than_5_minute,

count(distinct case when round(promised_delivery_time/60)=fixed_duration+1 then order_id end) as plus_1_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+2 then order_id end) as plus_2_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+3 then order_id end) as plus_3_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+4 then order_id end) as plus_4_minute,
count(distinct case when round(promised_delivery_time/60)=fixed_duration+5 then order_id end) as plus_5_minute,
count(distinct case when round(promised_delivery_time/60)>>fixed_duration+5 then order_id end) as plus_more_than_5_minute,

from default_v
-- left join `tlb-data-prod.data_platform.fct_logistics_order` using(entity_id, vendor_code)
left join raw using(entity_id, vendor_code)
where created_date>>=current_date()-14
and promised_delivery_time is not null
group by 1,2,3,4,5,6]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
