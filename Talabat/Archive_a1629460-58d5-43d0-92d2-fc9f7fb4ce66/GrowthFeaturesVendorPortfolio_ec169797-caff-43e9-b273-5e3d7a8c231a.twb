          <relation connection='bigquery.0sihls81iknzo914e7q1u1mlpijx' name='Custom SQL Query1' type='text'>select
dim_vendor_info.vendor_id
,dim_vendor_info.chain_id
,dim_vendor_info.vendor_name
,dim_chain.chain_name
,dim_chain.chain_name_arabic
,dim_vendor_info.vendor_name_arabic
,dim_vendor_info.account_type
,dim_vendor_info.account_sub_category
,dim_vendor_info.account_manager_id
,dim_vendor_info.account_manager_name
,dim_vendor_info.account_manager_email
,dim_location.country_name
,dim_location.city_name
,dim_location.area_name
from
  `tlb-data-prod.data_platform.dim_vendor_info` as dim_vendor_info
left join
  `tlb-data-prod.data_platform.dim_location` as dim_location
  using(location_id)
left join
  `tlb-data-prod.data_platform.dim_chain` as dim_chain
  using(chain_id)</relation>
