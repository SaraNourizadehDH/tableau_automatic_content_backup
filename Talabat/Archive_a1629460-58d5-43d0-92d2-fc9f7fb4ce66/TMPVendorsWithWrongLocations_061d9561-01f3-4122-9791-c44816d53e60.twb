    <datasource caption='Custom SQL Query (performance_management_egypt)' inline='true' name='federated.14nieww15jweln140xhae0lheas3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0dsv6dc066j6p11e2wsnk1h6ey14'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='performance_management_egypt' server-oauth='' username='seif.hany@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dsv6dc066j6p11e2wsnk1h6ey14' name='Custom SQL Query' type='text'>SELECT v.vendor_id, v.vendor_name, c.vertical_class, COUNT(o.order_id) / DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY) AS daily_avg_orders, COUNT(o.order_id) / (t.avg_daily_total_orders * DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY)) AS total_orders_percentage,&#13;
CASE&#13;
  WHEN c.chain_id = 607445 THEN &apos;tMart&apos;&#13;
  WHEN c.vertical_class = &apos;food&apos; THEN &apos;food&apos;&#13;
  ELSE &apos;NFV&apos;&#13;
END AS vertical&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o,&#13;
(SELECT COUNT(o.order_id) / (DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY)) AS avg_daily_total_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
WHERE o.country_id = 9 AND is_successful AND NOT is_test AND o.order_date &gt;&gt;= date_sub(current_date(), INTERVAL 1 MONTH) AND o.delivery_arrangement = &apos;TMP&apos;) t&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
ON CAST(o.vendor_id AS INTEGER) = v.vendor_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c&#13;
ON CAST (v.chain_id AS INTEGER) = c.chain_id&#13;
LEFT JOIN `tlb-data-dev.performance_management_egypt.vendors_with_wrong_location` l&#13;
ON CAST (v.vendor_id AS INTEGER) = l.vendor_id&#13;
WHERE o.country_id = 9 AND is_successful AND NOT is_test AND o.order_date &gt;&gt;= date_sub(current_date(), INTERVAL 1 MONTH) AND l.is_wrong_location = 1 AND NOT v.is_tgo&#13;
GROUP BY vendor_id, v.vendor_name, c.chain_id, c.vertical_class, t.avg_daily_total_orders, l.is_wrong_location&#13;
-- HAVING vertical = &apos;tMart&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0dsv6dc066j6p11e2wsnk1h6ey14' name='Custom SQL Query' type='text'>SELECT v.vendor_id, v.vendor_name, c.vertical_class, COUNT(o.order_id) / DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY) AS daily_avg_orders, COUNT(o.order_id) / (t.avg_daily_total_orders * DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY)) AS total_orders_percentage,&#13;
CASE&#13;
  WHEN c.chain_id = 607445 THEN &apos;tMart&apos;&#13;
  WHEN c.vertical_class = &apos;food&apos; THEN &apos;food&apos;&#13;
  ELSE &apos;NFV&apos;&#13;
END AS vertical&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o,&#13;
(SELECT COUNT(o.order_id) / (DATE_DIFF(current_date(), date_sub(current_date(), INTERVAL 1 MONTH), DAY)) AS avg_daily_total_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
WHERE o.country_id = 9 AND is_successful AND NOT is_test AND o.order_date &gt;&gt;= date_sub(current_date(), INTERVAL 1 MONTH) AND o.delivery_arrangement = &apos;TMP&apos;) t&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
ON CAST(o.vendor_id AS INTEGER) = v.vendor_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c&#13;
ON CAST (v.chain_id AS INTEGER) = c.chain_id&#13;
LEFT JOIN `tlb-data-dev.performance_management_egypt.vendors_with_wrong_location` l&#13;
ON CAST (v.vendor_id AS INTEGER) = l.vendor_id&#13;
WHERE o.country_id = 9 AND is_successful AND NOT is_test AND o.order_date &gt;&gt;= date_sub(current_date(), INTERVAL 1 MONTH) AND l.is_wrong_location = 1 AND NOT v.is_tgo&#13;
GROUP BY vendor_id, v.vendor_name, c.chain_id, c.vertical_class, t.avg_daily_total_orders, l.is_wrong_location&#13;
-- HAVING vertical = &apos;tMart&apos;</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
