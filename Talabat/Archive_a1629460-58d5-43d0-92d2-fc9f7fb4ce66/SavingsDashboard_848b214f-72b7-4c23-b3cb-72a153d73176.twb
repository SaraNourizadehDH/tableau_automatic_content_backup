      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_BDC85300D04F4597B04224BD57F39728'>
            <properties context=''>
              <relation connection='bigquery.0j3psjm0jf2cly14rqvm302igeja' name='Custom SQL Query' type='text'><![CDATA[(SELECT

EXTRACT (Year FROM orders.order_date) AS Year,
EXTRACT (Month FROM orders.order_date) AS Month,b.country_name, orders.vendor_id, a.vendor_name, a.account_manager_name,incentive_sub_type
, sum(incentive_amount_eur)  AS savingeur

FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` a
ON a.vendor_id = orders.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` b
ON b.chain_id = a.chain_id

WHERE order_date >>= "2021-10-01"
and orders.vertical = 'food'
and is_successful=true
and incentive_sub_type IN ('menu discount','free delivery','item discount')


group by 1,2,3,4,5,6,7
order by 1,2 desc)

UNION ALL

(SELECT



EXTRACT (Year FROM orders.order_date) AS Year,
EXTRACT (Month FROM orders.order_date) AS Month,
dc.country_name, 
orders.vendor_id, 
vv.vendor_name, 
vv.account_manager_name,
'Total',
SUM(gmv_amount_EUR) total_gmv_eur

FROM `tlb-data-prod.data_platform.fct_order_info` orders

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` as vendors
ON orders.vendor_id = vendors.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` as vv
ON orders.vendor_id = vv.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
ON l.location_id = vendors.location_id
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc
ON vv.chain_id = dc.chain_id

WHERE

orders.order_date >>= "2021-10-01"

AND NOT orders.is_non_food
AND orders.is_successful
and orders.country_iso <<>>'SA'
group by 1,2,3,4,5,6,7)

UNION ALL

(SELECT 
EXTRACT (Year FROM orders.order_date) AS Year,
EXTRACT (Month FROM orders.order_date) AS Month,
dc.country_name, 
orders.vendor_id, 
vv.vendor_name, 
vv.account_manager_name,
'GEM' as incentive_sub_type,
SUM(orders.gem_discount_amount_eur) gem_discount_eur

FROM `tlb-data-prod.data_platform.fct_order_info` AS orders
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` as vendors
ON orders.vendor_id = vendors.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` as vv
ON orders.vendor_id = vv.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
ON l.location_id = vendors.location_id
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc
ON vv.chain_id = dc.chain_id
WHERE
orders.order_date >>= "2021-10-01" 
AND is_successful = true
AND is_on_gem = true
AND vertical_id = 4

group by 1,2,3,4,5,6,7 )

UNION ALL

(SELECT 

EXTRACT (Year FROM a.order_date) AS Year,
EXTRACT (Month FROM a.order_date) AS Month,
d.country_name, a.vendor_id, c.vendor_name,c.account_manager_name, offer_type, SUM(saving_amount_eur)	savingeur

FROM `tlb-data-prod..data_platform.fct_order_info` a

LEFT JOIN `tlb-data-prod.data_platform_redshift.fct_affordability` b
ON a.order_id = CAST(b.order_id AS INT)

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` c
ON c.vendor_id = a.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` d
ON d.chain_id = a.chain_id

WHERE order_date >>= "2021-10-01"

AND offer_type IN ('Promotional Item - BOGO','Promotional Item')

GROUP BY 1,2,3,4,5,6,7)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
