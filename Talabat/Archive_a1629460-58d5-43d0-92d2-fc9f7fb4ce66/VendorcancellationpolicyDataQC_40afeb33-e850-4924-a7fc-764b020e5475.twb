      <datasource-dependencies datasource='Parameters'>
        <column caption='date granularity' datatype='string' name='[order_date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
          <calculation class='tableau' formula='&quot;month&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_583D0EDA3BD0433188DABAF4BFCE43ED'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Custom SQL Query].[country_code]' />
                      <expression op='if [Final exception list].[Country]=&apos;UAE&apos; then &apos;AE&apos;&#10;ELSEIF  [Final exception list].[Country]=&quot;Jordan&quot; then &apos;JO&apos; &#10;ELSEIF  [Final exception list].[Country]=&quot;Qatar&quot; then &apos;QA&apos;  END' />
                    </expression>
                    <expression op='='>
                      <expression op='[Custom SQL Query].[vendor_id]' />
                      <expression op='[Final exception list].[Vendor ID]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.107o9fq03z631513tf8ns0nqgf98' name='Custom SQL Query' type='text'><![CDATA[SELECT
  orderid,
  order_date,
  extract(month from order_date) as month,
  extract(year from order_date) as year,
  f.country_code,
  f.chain_id,
  f.vendor_id,
  vendor_name,
  chain_name,
  basket_amount_lc-municipality_tax_amount_lc AS basket_amount_lc,
  basket_amount_eur-municipality_tax_amount_eur AS basket_amount_eur,
  basket_amount_eur-discount_amount_eur-gem_discount_amount_eur-voucher_discount_amount_eur-municipality_tax_amount_eur AS bv_after_discount_eur,
  basket_amount_lc-discount_amount_lc-gem_discount_amount_lc-voucher_discount_amount_lc-municipality_tax_amount_lc AS bv_after_discount,
  CASE
    WHEN vr.vertical='food' THEN 'food'
    WHEN vr.sub_vertical='darkstore' THEN 'tmart'
    WHEN vr.vertical NOT IN ('food', 'all', 'N/A') THEN 'nfv'
END
  AS vertical_details,
  fr.stage,
  fr.talabat_reason,
  delivery_arrangement,
  SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.IsRefundable')AS BOOLEAN) AS IsRefundable,
  SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.CancellationReasonId')AS STRING) AS CancellationReasonId,
  COALESCE(SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.CancellationRefundAmount')AS NUMERIC),0)/f.exchange_rate_to_eur AS CancellationRefundAmount_eur,
  COALESCE(SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.CancellationRefundAmount')AS NUMERIC),0) AS CancellationRefundAmount_lc,
  SAFE_DIVIDE(COALESCE(SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.CancellationRefundAmount')AS NUMERIC),0),(basket_amount_lc-discount_amount_lc-gem_discount_amount_lc-voucher_discount_amount_lc-municipality_tax_amount_lc) )*100 AS payout_percent_actual
FROM
  `tlb-data-prod.data_platform_billing.billingdata` d
JOIN
  `tlb-data-prod.data_platform.fct_order_info` f
ON
  d.orderid=f.order_id --and f.order_date='2023-10-01'
LEFT JOIN
  tlb-data-prod.data_platform.dim_order_fail_reason fr
ON
  fr.order_fail_reason_id=f.order_fail_reason_id
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` v
ON
  v.vendor_id=f.vendor_id
LEFT JOIN
  `tlb-data-prod.data_platform.dim_chain` ch
ON
  ch.chain_id=f.chain_id
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vertical` vr
ON
  vr.vertical_id=f.vertical_id
  AND vr.vertical <<>> 'all'
WHERE
  DATE(ordercreatedon) >>= '2023-10-01'
  AND f.order_date>>='2023-10-01'
  AND cancellationrefunddata IS NOT NULL
  AND SAFE_CAST(JSON_QUERY(cancellationrefunddata, '$.IsRefundable')AS BOOLEAN)]]></relation>
                <relation connection='cloudfile:googledrive-excel-direct.0wjim9e1lwt18e102pryn0e41vt4' name='Final exception list' table='[&apos;Final exception list$&apos;]' type='table'>
                  <columns gridOrigin='A1:H2588:no:A1:H2588:0' header='yes' outcome='2'>
                    <column datatype='string' name='Country' ordinal='0' />
                    <column datatype='integer' name='Chain ID' ordinal='1' />
                    <column datatype='integer' name='Vendor ID' ordinal='2' />
                    <column datatype='string' name='Chain Name' ordinal='3' />
                    <column datatype='string' name='Vendor Name' ordinal='4' />
                    <column datatype='real' name='Payout %' ordinal='5' />
                    <column datatype='string' name='Grid IDs' ordinal='6' />
                    <column datatype='string' name='TGO Yes/ No' ordinal='7' />
                  </columns>
                </relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='List of Orders with Mismatch in payout % '>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1ge7ct515m097r1b5qkyl04hm370' />
          </datasources>
          <datasource-dependencies datasource='federated.1ge7ct515m097r1b5qkyl04hm370'>
            <column aggregation='Sum' caption='payout%' datatype='real' name='[Calculation_4229654116269740034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if([vertical_details]=&apos;food&apos; and [delivery_arrangement]=&apos;TGO&apos;) then IFNULL([Payout %],0.3)*100 else 0 END' />
            </column>
            <column aggregation='Sum' caption='Payout % difference  ( Actual - Default )' datatype='real' name='[Calculation_4348506925199036416]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='([payout_percent_actual])-[Calculation_4229654116269740034]' />
            </column>
            <column aggregation='Sum' caption='exception_flag_' datatype='integer' name='[Calculation_922886092016857090]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([Chain ID],1)' />
