          <relation connection='bigquery.107o9fq03z631513tf8ns0nqgf98' name='Custom SQL Query' type='text'><![CDATA[SELECT
  orderid,
  order_date,
  extract(month from order_date) as month,
  extract(year from order_date) as year,
  f.country_code,
  f.chain_id,
