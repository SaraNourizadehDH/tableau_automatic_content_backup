    <worksheet name='Number of Orders with mismatch in Payout % '>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1ge7ct515m097r1b5qkyl04hm370' />
          </datasources>
          <datasource-dependencies datasource='federated.1ge7ct515m097r1b5qkyl04hm370'>
            <column aggregation='Sum' caption='payout%' datatype='real' name='[Calculation_4229654116269740034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if([vertical_details]=&apos;food&apos; and [delivery_arrangement]=&apos;TGO&apos;) then IFNULL([Payout %],0.3)*100 else 0 END' />
            </column>
            <column aggregation='Sum' caption='Payout % difference  ( Actual - Default )' datatype='real' name='[Calculation_4348506925199036416]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='([payout_percent_actual])-[Calculation_4229654116269740034]' />
            </column>
            <column datatype='boolean' name='[IsRefundable]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Payout % Default' datatype='real' name='[Payout %]' role='dimension' type='ordinal' />
            <column caption='CountryCode' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[orderid]' derivation='CountD' name='[ctd:orderid:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[delivery_arrangement]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4348506925199036416]' derivation='None' name='[none:Calculation_4348506925199036416:ok]' pivot='key' type='ordinal' />
            <column-instance column='[IsRefundable]' derivation='None' name='[none:IsRefundable:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[orderid]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[payout_percent_actual]' role='dimension' type='ordinal' />
            <column datatype='string' name='[vertical_details]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ge7ct515m097r1b5qkyl04hm370].[none:Calculation_4348506925199036416:ok]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter from='-120.0' function='range' level='[none:Calculation_4348506925199036416:ok]' to='-0.33582090000000164' />
              <groupfilter from='20.0' function='range' level='[none:Calculation_4348506925199036416:ok]' to='34.5' />
            </groupfilter>
