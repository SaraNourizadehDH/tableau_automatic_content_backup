          <datasource-dependencies datasource='federated.0p6v0xy1un7qg91detbol0yz4tto'>
            <column caption='GMV (LC)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1361142663781351426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount])' />
            </column>
            <column caption='NCR Spend' datatype='real' name='[Calculation_1361142664707756037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_6760325297459523607] + [Calculation_6760325297495375904])' />
            </column>
            <column caption='NCR Orders' datatype='integer' name='[Calculation_1361142664708104198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6760325297494892575] + [Calculation_6760325297544106019]' />
            </column>
            <column caption='NCR RoAS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1361142664708964361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1361142664709726221]/[Calculation_1361142664707756037]' />
            </column>
            <column caption='NCR GMV' datatype='real' name='[Calculation_1361142664709726221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([GEM_gmv_amount_lc_successful])) + ZN(SUM([cpc_gmv_amount_lc_successful]))+&#10;ZN(SUM([fp_gmv_amount_lc_successful]))+&#10;ZN(SUM([kwords_search_gmv_amount_lc_successful]))+&#10;ZN(SUM([other_gmv_amount_lc_successful]))' />
            </column>
            <column caption='New Customers' datatype='integer' name='[Calculation_1361142665102299173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([new_customer]))' />
            </column>
            <column caption='Returning Customers' datatype='integer' name='[Calculation_1361142665102417958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([repeated_customer]))' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_1361142665102491687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1361142665102299173])+ZN([Calculation_1361142665102417958])' />
            </column>
            <column caption='Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1361142665117909032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6760325297493729306]/[Calculation_1361142665102491687]' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1361142665199652909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cases_vendor_reason])/SUM([cr_gross_orders])' />
            </column>
            <column caption='vNFR' datatype='real' default-format='p0.00%' name='[Calculation_1361142665205760048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
            </column>
            <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1361142665495404606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_order_rating])' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_6760325296803491850]' role='measure' type='quantitative'>
