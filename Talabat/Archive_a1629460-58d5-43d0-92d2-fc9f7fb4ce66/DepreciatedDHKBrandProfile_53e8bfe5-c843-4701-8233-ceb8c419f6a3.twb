      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='DHK Vendor Profile - Monthly' id='_608756E2FC2C4BC4AC97040695401A19'>
            <properties context=''>
              <relation connection='bigquery.0x4xjcg0v42npr1d1ycn51jint6m' name='Custom SQL Query' type='text'><![CDATA[WITH
    orders AS (
    Select
    DATE_TRUNC(o.order_date,MONTH) date,
    CAST(o.vendor_id AS STRING) vendor_id,
    --- Order Info ---- 
    COUNT(DISTINCT CASE WHEN o.is_successful then o.order_id END) as successful_orders,
    COUNT(DISTINCT CASE WHEN os.is_net then o.order_id END) as net_orders,
    COUNT(DISTINCT CASE WHEN os.is_net AND NOT(o.is_successful) AND ofr.owner = 'VENDOR' then o.order_id END) as vendor_net_fail_orders,
    COUNT(DISTINCT CASE WHEN os.is_net AND NOT(o.is_successful)  then o.order_id END) as net_fail_orders,
    COUNT(DISTINCT CASE WHEN o.is_successful AND o.discount_amount_lc <<>> 0 then o.order_id END) as discounted_orders,
    COUNT(DISTINCT CASE WHEN o.is_successful AND o.is_tpro_order THEN o.order_id END ) as t_pro_order,
    ---- GEM Orders ----
    COUNT(DISTINCT CASE WHEN o.is_successful AND o.is_on_gem THEN o.order_id END) AS GEM_orders,
    SUM(CASE WHEN o.is_successful AND o.is_on_gem THEN o.gem_commission_amount_lc END) AS GEM_fees_lc,
    SUM(CASE WHEN o.is_successful AND o.is_on_gem THEN o.gem_discount_amount_lc END) AS GEM_discount_amount_lc,
    SUM(CASE WHEN o.is_successful AND o.is_on_gem THEN o.gmv_amount_lc END) AS GEM_gmv_amount_lc_successful,
    --- Billing Info ---- 
    SUM(CASE WHEN o.is_successful then o.gmv_amount_lc END) as s_orders_gmv_amount,
    SUM(CASE WHEN o.is_successful then o.basket_amount_lc END) as s_basket_amount_total,
    SUM(o.discount_amount_lc) as discount_amount_total,
    SUM(o.delivery_fee_amount_lc) as delivery_fee_total,
    --- Rating ----
    AVG(rating.original_rating) as avg_order_rating,
    ------ Customer Info -----
    COUNT(DISTINCT CASE WHEN o.is_successful  AND  rank.customer_vendor_order_index   = 1 THEN  o.analytical_customer_id   END) AS new_customer,
    COUNT(DISTINCT CASE WHEN o.is_successful  AND  rank.customer_vendor_order_index   >> 1 THEN  o.analytical_customer_id   END) AS repeated_customer,
    ----- hold back time completed orders
    SUM(CASE WHEN  TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) and is_logistics_preorder is false then hold_back_time/60 end) as hold_back_time_sum,
    COUNT(DISTINCT CASE WHEN  TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) and is_logistics_preorder is false then o_log.order_id end) as hold_back_time_count,
    ----- hold back time all orders
    SUM(hold_back_time/60) as hold_back_time_sum_all_orders,
    COUNT(o_log.order_id) as hold_back_time_count_all_orders,
    ----- Promised Delivery Time
    SUM(promised_delivery_time/60) as sum_promised_delivery_time,
    COUNT(o_log.order_id) as count_promised_delivery_time,
    -- Actual Delivery Time 
    SUM( o_log.actual_delivery_time/60) AS actual_delivery_time_sum,
    COUNT(o_log.actual_delivery_time/60) AS actual_delivery_time_count,
    -- Actual Delivery Time completed orders 
    SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) THEN o_log.actual_delivery_time/60 END) AS actual_delivery_time_comp_orders_sum,
    COUNT(DISTINCT CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) THEN o_log.order_id END) AS actual_delivery_time_comp_orders_count,
    --- Actual Delivery Time V2 --
    SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND o.is_tgo THEN TIMESTAMP_DIFF(DATETIME(primary_rider_dropped_off_at, "Asia/Dubai"),DATETIME(created_at, "Asia/Dubai"), MINUTE) END) as sum_actual_delivery_mintues_v2_only_tgo,
    COUNT(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND o.is_tgo THEN o_log.order_id END ) as count_actual_delivery_minutes_v2_only_tgo,
    -------Vendor Delay V2
    COUNT(DISTINCT CASE WHEN (( o_log.vendor_delay_v2/60) >> 5) THEN o.order_id ELSE NULL END) AS vendor_late_orders_5min_V2,
    COUNT(DISTINCT CASE WHEN (( o_log.vendor_delay_v2/60) >> 10) THEN o.order_id  ELSE NULL END) AS vendor_late_orders_10min_V2,         
    COUNT(DISTINCT CASE WHEN ( o_log.vendor_delay_v2/60) IS NOT NULL THEN o.order_id  END) AS vendor_late_orders_V2,   
    SUM(vendor_delay_v2/60) as vendor_late_min_V2,
    ---- Vendor Prep Time
    SUM(vendor_preparation_time)*1.0/60 AS vendor_preparation_time_sum,
    COUNT(CASE WHEN vendor_preparation_time is not null then o.order_id end) AS vendor_preparation_time_count,
    ---- Assumed Actual Prep Time
    SUM(assumed_actual_preparation_time)*1.0/60 AS assumed_actual_prep_time_sum,
    COUNT(CASE WHEN assumed_actual_preparation_time is not null then o.order_id end) AS assumed_actual_prep_time_count,  
    ---- FIR Prep Time
    SUM(TIMESTAMP_DIFF(o_log.vendor_prepared_at , o_log.sent_to_vendor_at , MINUTE)) as Avg_FIR_Prep_Time_Sum,
    COUNT(CASE WHEN TIMESTAMP_DIFF(o_log.vendor_prepared_at , o_log.sent_to_vendor_at , MINUTE) IS NOT NULL THEN o.order_id END) as Avg_FIR_Prep_Time_count,
    FROM `tlb-data-prod.data_platform.fct_order_info` o
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` o_log on o_log.order_id = o.order_id and o_log.is_talabat
    LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` fr on fr.order_fail_reason_id = o.order_fail_reason_id
    INNER JOIN `tlb-data-prod.data_platform.dim_order_status` os on os.order_status_id = o.order_status_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` ofr on ofr.order_fail_reason_id = o.order_fail_reason_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_rating` rating on rating.order_id = o.order_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` rank on rank.order_id = o.order_id
    LEFT JOIN (SELECT vendor_id,name_en as vendor_name,vertical FROM `tlb-data-prod.data_platform.dim_vendor`) v on v.vendor_id = o.vendor_id
    WHERE DATE(o.order_date) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) AND CURRENT_DATE()
    AND LOWER(v.vendor_name) LIKE LOWER ('%dh kitchen%') 
    GROUP BY
    1,2),

    marketing_spend as 
    (Select
    DATE_TRUNC(date,MONTH) as ms_date,
    CAST(ms.vendor_id AS STRING) as ms_vendor_id,
    SUM(CASE WHEN ad_type_id = 8 THEN nb_orders_successful END) as cpc_nb_orders_successful,
    SUM(CASE WHEN ad_type_id = 8 THEN revenue_lc END) as cpc_revenue_lc,
    SUM(CASE WHEN ad_type_id = 8 THEN nb_billed_clicks END) as cpc_nb_billed_clicks,
    SUM(CASE WHEN ad_type_id = 8 THEN gmv_amount_lc_successful END) as cpc_gmv_amount_lc_successful,
    SUM(CASE WHEN ad_type_id = 5 THEN nb_orders_successful END) as fp_nb_orders_successful,
    SUM(CASE WHEN ad_type_id = 5 THEN revenue_lc END) as fp_revenue_lc,
    SUM(CASE WHEN ad_type_id = 5 THEN nb_billed_clicks END) as fp_nb_billed_clicks,
    SUM(CASE WHEN ad_type_id = 5 THEN gmv_amount_lc_successful END) as fp_gmv_amount_lc_successful,
    SUM(CASE WHEN ad_type_id = 6 THEN nb_orders_successful END) as kwords_search_nb_orders_successful,
    SUM(CASE WHEN ad_type_id = 6 THEN revenue_lc END) as kwords_search_revenue_lc,
    SUM(CASE WHEN ad_type_id = 6 THEN nb_billed_clicks END) as kword_nb_billed_clicks,
    SUM(CASE WHEN ad_type_id = 6 THEN gmv_amount_lc_successful END) as kwords_search_gmv_amount_lc_successful,
    SUM(CASE WHEN ad_type_id NOT IN (6,5,8) THEN nb_orders_successful END) as other_nb_orders_successful,
    SUM(CASE WHEN ad_type_id NOT IN (6,5,8) THEN revenue_lc END) as other_revenue_lc,
    SUM(CASE WHEN ad_type_id NOT IN (6,5,8) THEN nb_billed_clicks END) as other_nb_billed_clicks,
    SUM(CASE WHEN ad_type_id NOT IN (6,5,8) THEN gmv_amount_lc_successful END) as other_gmv_amount_lc_successful,
    FROM `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` ms
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING)  = CAST(ms.vendor_id AS STRING)
    WHERE LOWER(v.vendor_name) LIKE '%dh kitchen%'
    GROUP BY 1,2),

    sessions 
    AS (
    Select 
    DATE_TRUNC(date,MONTH) date,
    CAST(av.vendor_id AS STRING) as vendor_id,
    SUM(viewed_menu_session_count)viewed_menu_session_count,
    SUM(placed_order_session_count) placed_order_session_count
    FROM `tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily` av
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING)  = av.vendor_id
    WHERE LOWER(v.vendor_name) LIKE '%dh kitchen%'
    GROUP BY 1,2),

    tsv as (
    select  
    award_date,
    t_star.vendor_id,
    is_top,
    in_progress,
    (SELECT is_fulfilled FROM UNNEST(metrics) WHERE name = 'rejection_rate') AS flag_rejection,
    (SELECT is_fulfilled FROM UNNEST(metrics) WHERE name = 'rating') AS flag_rating,
    (SELECT is_fulfilled FROM UNNEST(metrics) WHERE name = 'order_delay_rate') AS flag_delay_rate,
    (SELECT is_fulfilled FROM UNNEST(metrics) WHERE name = 'order_count') AS flag_order,
    (SELECT is_fulfilled FROM UNNEST(metrics) WHERE name = 'offline_rate') AS flag_offline,
    FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vri_cl_top_restaurant_reward_report` t_star
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING) = t_star.vendor_id
    WHERE award_date is not null
    AND LOWER(v.vendor_name) LIKE '%dh kitchen%'),

    cr as (
      SELECT
      distinct
      DATE_TRUNC(evaluation_date, MONTH) month_date,
      c.vendor_id,
      is_bad_CR,
      is_bad_FR,
      cohort_start_date,
      SUM(gross_orders) cr_gross_orders,
      SUM(net_orders) cr_net_orders,
      SUM(successful_orders) cr_successful_orders,
      SUM(cases_vendor_reason) cases_vendor_reason,
      SUM(vendor_failed_order_count) vendor_failed_order_count,
      FROM `tlb-data-dev.data_playground_growth.vendors_performance_daily` c
      LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = c.vendor_id
      WHERE cohort >> 1
      AND LOWER(v.vendor_name) LIKE '%dh kitchen%'
      AND DATE_TRUNC(evaluation_date, MONTH) = cohort_start_date   
      GROUP BY 1,2,3,4,5)


        Select
        o.*,
        s.* EXCEPT(date,vendor_id),
        cr.* EXCEPT(month_date,vendor_id),
        ms.* EXCEPT(ms_date,ms_vendor_id),
        tsv.*EXCEPT(award_date,vendor_id),
        CASE WHEN cpc_nb_billed_clicks is not null then true end as is_cpc_active,
        CASE WHEN fp_nb_billed_clicks is not null then true end as is_fp_active,
        CASE WHEN kword_nb_billed_clicks is not null then true end as is_kword_active,
        CASE WHEN other_nb_billed_clicks is not null then true end as is_other_active,
        CASE WHEN cpc_nb_billed_clicks is not null OR fp_nb_billed_clicks is not null OR kword_nb_billed_clicks is not null OR other_nb_billed_clicks is not null then true else false end as is_adex_active,
        CASE WHEN flag_rejection = true
        AND flag_rating = true
        AND flag_delay_rate = true
        AND flag_order = true
        AND flag_offline = true then true
        ELSE false END as is_on_track_for_tc
        FROM orders o
        LEFT JOIN sessions s on s.date = o.date AND s.vendor_id = o.vendor_id
        LEFT JOIN marketing_spend ms on ms.ms_date = o.date and ms.ms_vendor_id = o.vendor_id
        LEFT JOIN tsv on tsv.award_date = o.date and tsv.vendor_id = CAST(o.vendor_id AS STRING)
        LEFT JOIN cr on cr.month_date = o.date and CAST(cr.vendor_id AS STRING) = CAST(o.vendor_id AS STRING)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_608756E2FC2C4BC4AC97040695401A19' table='[Extract].[_608756E2FC2C4BC4AC97040695401A19]' type='table' />
            </properties>
          </object>
          <object caption='vendor_table' id='_74B1F4A229484D46B952957BA88B0C3D'>
            <properties context=''>
              <relation connection='bigquery.0x4xjcg0v42npr1d1ycn51jint6m' name='Custom SQL Query1' type='text'>SELECT
            v.source_system_vendor_id as vendor_id,
            v.salesforce_id,
            c.source_system_chain_id as chain_id,
            c.salesforce_id as chain_salesforce_id,
            v.vendor_name as vendor_name_en,
            c.chain_name as chain_name_en,
            l.country_name,
            l.area_name as vendor_area_name,
            v.is_tgo,
            v.is_active,
            gfs.is_kitchen,
            gfs.kitchen_area,
            gfs.is_online as is_online_on_gfs,
            gfs.stall_numbers,
            gfs.activation_date_local,
            gfs.partner_name,
            v.is_tpro,
            gfs.virtual_brand_group,
        FROM
            `tlb-data-prod.data_platform.dim_vendor_info` v
            LEFT JOIN `fulfillment-dwh-production.curated_data_shared_gfs.vendors` gfs on gfs.vendor_id = CAST(v.vendor_id AS STRING)
            LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_location` l on l.location_id = v.location_id
            WHERE 
            LOWER(v.vendor_name) LIKE LOWER(&apos;%dh kitchen%&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_74B1F4A229484D46B952957BA88B0C3D' table='[Extract].[_74B1F4A229484D46B952957BA88B0C3D]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='='>
              <expression op='[vendor_id]' />
              <expression _.fcp.RelationshipCalculations.false...op='[STR(vendor_id (Custom SQL Query1))]' _.fcp.RelationshipCalculations.true...op='STR([vendor_id (Custom SQL Query1)])' />
            </expression>
            <first-end-point object-id='_608756E2FC2C4BC4AC97040695401A19' />
            <second-end-point object-id='_74B1F4A229484D46B952957BA88B0C3D' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Customers &amp; New Customer %'>
