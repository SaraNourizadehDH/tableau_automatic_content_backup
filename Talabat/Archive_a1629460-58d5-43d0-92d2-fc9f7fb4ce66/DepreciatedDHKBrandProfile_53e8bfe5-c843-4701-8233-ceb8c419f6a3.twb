        <view>
          <datasources>
            <datasource caption='DHK Vendor Profile' name='federated.0p6v0xy1un7qg91detbol0yz4tto' />
          </datasources>
          <datasource-dependencies datasource='federated.0p6v0xy1un7qg91detbol0yz4tto'>
            <column caption='New Customers' datatype='integer' name='[Calculation_1361142665102299173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([new_customer]))' />
