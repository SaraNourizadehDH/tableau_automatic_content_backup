    <worksheet name='Platform - Customer - exclusive deals'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff0000'><![CDATA[<[federated.1b0gtf309wmzld11gvplb0rtl3g0].[none:date_aggregation:nk]>]]></run>
            <run> Level KPIS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Code' name='federated.1b0gtf309wmzld11gvplb0rtl3g0' />
          </datasources>
          <datasource-dependencies datasource='federated.1b0gtf309wmzld11gvplb0rtl3g0'>
            <column caption='% exclusive deal order of Pro Order GMV' datatype='real' default-format='p0.00%' name='[% exclusive deal order of Pro Orders (copy)_683421303739109409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([exclucsive_deal_gmv_amount_lc]/[all_tpro_orders_gmv_amount_lc])' />
            </column>
            <column caption='AOV - Non Food Exclusive Deals ' datatype='real' name='[ABV - Exclusive Deals  (copy)_683421303735324698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([exclucsive_deal_gmv_amount_lc_non_food])&#13;&#10;/sum([exclusive_deal_orders_non_food])' />
            </column>
            <column caption='ABV - Exclusive Deals  exc tmart' datatype='real' name='[ABV - Exclusive Deals  (copy)_683421303737593886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([exclucsive_deal_basket_amount_lc_non_food]/&#13;&#10;[exclusive_deal_orders_non_food])' />
            </column>
            <column caption='ABV -Food  Exclusive Deals  ' datatype='real' name='[ABV - Exclusive Deals  exc tmart (copy)_683421303940276266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([exclucsive_deal_basket_amount_lc_food]/&#13;&#10;[exclusive_deal_orders_food])' />
            </column>
            <column caption='ABV - Pro' datatype='real' name='[ABV - tPro Booster (copy)_683421303738011679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_tpro_orders_basket_amount_lc])/SUM([all_tpro_orders])' />
            </column>
            <column caption='ABV' datatype='integer' name='[AOV (copy)_3834744763923415047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(NULL)' />
            </column>
            <column caption='AOV - Exclusive Deals' datatype='real' name='[AOV - Best Seller (copy)_683421303733657624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([exclucsive_deal_gmv_amount_lc])/SUM([exclusive_deal_orders])' />
            </column>
            <column caption='ABV - Exclusive Deals ' datatype='real' name='[AOV - Exclusive Deals (copy)_683421303734669337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([exclucsive_deal_basket_amount_lc])/SUM([exclusive_deal_orders])' />
            </column>
            <column caption='AOV - Pro' datatype='real' name='[AOV - Exclusive Deals (copy)_683421303736041499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_tpro_orders_gmv_amount_lc])/SUM([all_tpro_orders])' />
            </column>
            <column caption='AOV - Food Exclusive Deals ' datatype='real' name='[AOV - Non Food Exclusive Deals  (copy)_683421303940132905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([exclucsive_deal_gmv_amount_lc_food])&#13;&#10;/sum([exclusive_deal_orders_food])' />
            </column>
            <column caption='Order Frequency' datatype='integer' name='[Adoption % (copy)_2481553813357395979]' role='measure' type='quantitative'>
