    <worksheet name='Customers - exclusive'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 1]</run>
            <run>&gt; Level KPIS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Code' name='federated.1b0gtf309wmzld11gvplb0rtl3g0' />
          </datasources>
          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.1b0gtf309wmzld11gvplb0rtl3g0'>
            <column caption='Average Exclusive Deal Savings per Customer-e ' datatype='real' name='[Average Exclusive Deal Savings per Order -e (copy)_683421303606456324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([exclusive_deal_discount])/SUM([exclusive_deal_users])' />
            </column>
            <column caption='Average Free Delivery Savings per Customer- e ' datatype='real' name='[Average Free Delivery Savings per Order - e (copy)_683421303606669317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([exclusive_deal_free_delivery_discount]))/&#13;&#10;SUM([exclusive_deal_users])' />
            </column>
            <column caption='Average Free Delivery Savings per Order - e' datatype='real' name='[Average Total Savings per Order - e (copy)_683421303605727233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([exclusive_deal_free_delivery_discount]))/&#13;&#10;SUM([exclusive_deal_orders])' />
            </column>
            <column caption='Average Total Savings per Customer - e ' datatype='real' name='[Average Total Savings per Order - e (copy)_683421303606284291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([exclusive_deal_free_delivery_discount])+SUM([exclusive_deal_discount]))/&#13;&#10;SUM([exclusive_deal_users])' />
