,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_booster_discount_amount_lc,0) end) as pro_best_seller_tpro_booster_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(best_seller_discount_amount_lc,0) end) as pro_best_seller_discount_savings

