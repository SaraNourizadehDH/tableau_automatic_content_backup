  ,sum(case when has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount


  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_non_food
  ,sum(case when is_non_food and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_non_food
  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_non_food


  
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_food
  ,sum(case when is_non_food is false  and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_food
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_food


  
  , count(distinct case when has_tpro_exclusive_deal and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders

   , count(distinct case when has_tpro_exclusive_deal and is_non_food and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_non_food

  
   , count(distinct case when has_tpro_exclusive_deal and is_non_food is false and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_food

