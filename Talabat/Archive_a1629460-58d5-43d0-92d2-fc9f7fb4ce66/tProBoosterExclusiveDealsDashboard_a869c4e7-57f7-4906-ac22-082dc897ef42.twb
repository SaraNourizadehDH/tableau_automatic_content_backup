  ,sum(case when  is_non_food  is false and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_food



  ,count(distinct case when has_tpro_exclusive_deal then account_id end) as exclusive_deal_users
  ,count(distinct case when has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders


  ,count(distinct case when is_non_food and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_non_food
