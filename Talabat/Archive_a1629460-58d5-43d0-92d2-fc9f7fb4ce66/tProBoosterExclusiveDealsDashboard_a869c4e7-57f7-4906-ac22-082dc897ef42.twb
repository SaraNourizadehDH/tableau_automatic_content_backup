  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Booster Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/tProBoosterDashboard_17235523792230/BoosterGlossary?rev=' id='BoosterGlossary' path='/t/Talabat/workbooks/tProBoosterDashboard_17235523792230' revision='' site='Talabat' />
      <style />
      <size maxheight='1300' maxwidth='1000' minheight='1300' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98770' id='3' type-v2='text' w='98400' x='800' y='615'>
            <formatted-text>
              <run bold='true' fontalignment='0'>Definitions</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0'>* all monetary values are in LC</run>
              <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontalignment='0'>Customers</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0'>Average total savings per Customer</run>
              <run fontalignment='0'>: total savings (booster + free delivery+best seller)/ count of customers using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Booster savings per Custome</run>
              <run fontalignment='0'>r : total booster discount/ count of customers using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Best Seller savings per Customer </run>
              <run fontalignment='0'>: total best seller discount/ count of customers using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Free Delivery savings per Customer</run>
              <run fontalignment='0'> : total free delivery discount/ count of customers using booster discount

</run>
              <run bold='true' fontalignment='0'>Average total savings per Order</run>
              <run fontalignment='0'>: total savings (booster + free delivery+best seller)/ count of orders using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Booster savings per Order:</run>
              <run fontalignment='0'> total booster discount/ count of orders using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Best Seller savings per Order:</run>
              <run fontalignment='0'> total best seller discount/ count of orders using booster discount
</run>
              <run bold='true' fontalignment='0'>Average Free Delivery savings per Order :</run>
              <run fontalignment='0'> total free delivery discount/ count of orders using booster discount


</run>
              <run bold='true' fontalignment='0'>Platform</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0'>* based on Booster or Best Seller - as applicable </run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0'>Orders</run>
              <run fontalignment='0'> : count of orders&#10;</run>
              <run bold='true' fontalignment='0'>Customers  </run>
              <run fontalignment='0'>: count of  users&#10;</run>
              <run bold='true' fontalignment='0'>Adoption%</run>
              <run fontalignment='0'> : count of users in the time period / total tpro customers in the time period
</run>
              <run bold='true' fontalignment='0'>Order Frequency</run>
              <run fontalignment='0'> : count of orders/ count of booster customers
</run>
              <run bold='true' fontalignment='0'>GMV</run>
              <run fontalignment='0'> : GMV of orders&#10;</run>
              <run bold='true' fontalignment='0'>AOV </run>
              <run fontalignment='0'> (gmv/orders) : GMV of orders/ count of  orders
</run>
              <run bold='true' fontalignment='0'>ABV </run>
              <run fontalignment='0'> (basket value/orders) : basket value of orders/ count of  orders
 </run>
              <run bold='true' fontalignment='0'>Utilization </run>
              <run fontalignment='0'>: count of  orders / count of all  orders by tpro users
 </run>
              <run bold='true' fontalignment='0'>Free Delivery Order % </run>
              <run fontalignment='0'>: count of orders with free delivery / count of orders
</run>
              <run bold='true' fontalignment='0'>Activation via Booster:</run>
              <run fontalignment='0'>  count of users with first tpro order as a booster order
</run>
              <run bold='true' fontalignment='0'>Total Booster Savings</run>
              <run fontalignment='0'> : total booster savings&#10;</run>
              <run bold='true' fontalignment='0'>Talabat Share of Booster Discoun</run>
              <run fontalignment='0'>t : talabat share of booster discount/ total booster savings
</run>
              <run bold='true' fontalignment='0'>Vendor Share of Booster Discount : </run>
              <run fontalignment='0'>vendor share of booster discount/ total booster savings

</run>
              <run bold='true' fontalignment='0'>Vendor</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0'>* The KPIs below are in the context of Pro Customers on the vendor </run>
              <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontalignment='0'>Pro Orders</run>
              <run fontalignment='0'>  :Total Pro Orders on  the vendor
</run>
              <run bold='true' fontalignment='0'>Best Seller Orders</run>
              <run fontalignment='0'> :Total Best Seller Orders on the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Best Seller Orders</run>
              <run fontalignment='0'> : Pro Best Seller Orders on the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Booster Orders </run>
              <run fontalignment='0'> :Pro Booster Orders on the vendor
</run>
              <run bold='true' fontalignment='0'>Booster share of Best Seller Orders: </run>
              <run fontalignment='0'>Pro Booster Orders on the vendor as a share of Best Seller Orders
</run>
              <run bold='true' fontalignment='0'>Pro Customer Count</run>
              <run fontalignment='0'>: Pro Customer Count on the vendor
</run>
              <run bold='true' fontalignment='0'>Best Seller Customers</run>
              <run fontalignment='0'> :Best Seller Customers on the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Best Seller Customers</run>
              <run fontalignment='0'> :Best Seller Customers who have placed a Pro Best Seller Order on the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Booster Customers: </run>
              <run fontalignment='0'>Pro Booster Customers on the vendor
</run>
              <run bold='true' fontalignment='0'>Best Seller Adoption% : </run>
              <run fontalignment='0'>Best Seller Customers as a share of Pro Customer Count
</run>
              <run bold='true' fontalignment='0'>Pro Booster Adoption%</run>
              <run fontalignment='0'> : Pro Booster Customers as a share of Pro Customer Count
</run>
              <run bold='true' fontalignment='0'>Pro Order Frequency:</run>
              <run fontalignment='0'>  Pro Orders by Pro Customers&#10;</run>
              <run bold='true' fontalignment='0'>Best Seller Order Frequency </run>
              <run fontalignment='0'> :Best Seller Orders by Pro Customers
</run>
              <run bold='true' fontalignment='0'>Pro Booster Order Frequency :</run>
              <run fontalignment='0'>Pro Booster Orders by Pro Customers
</run>
              <run bold='true' fontalignment='0'>Pro GMV </run>
              <run fontalignment='0'>        Pro Order GMV on the vendor
</run>
              <run bold='true' fontalignment='0'>Best Seller GMV </run>
              <run fontalignment='0'>        Best Seller Order GMV on  the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Best Seller GMV</run>
              <run fontalignment='0'>        Best Seller Pro Order GMV on  the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Booster GMV</run>
              <run fontalignment='0'>         Total Pro Booster GMV on  the vendor
</run>
              <run bold='true' fontalignment='0'>Pro Order AOV</run>
              <run fontalignment='0'>         Pro Orders GMV by Count of Pro Orders
</run>
              <run bold='true' fontalignment='0'>Best Seller AOV   </run>
              <run fontalignment='0'>      Best Seller GMV by Count of Best Seller Orders
</run>
              <run bold='true' fontalignment='0'>Pro Booster AOV</run>
              <run fontalignment='0'>        Pro Best Seller GMV by Count of Pro Booster Orders
</run>
              <run bold='true' fontalignment='0'>Pro ABV</run>
              <run fontalignment='0'>         Total Pro Booster Basket Value on  the vendor
</run>
              <run bold='true' fontalignment='0'>Best Seller ABV:  </run>
              <run fontalignment='0'>Pro Orders Basket Value  by Count of Pro Orders
</run>
              <run bold='true' fontalignment='0'>Pro Booster ABV:</run>
              <run fontalignment='0'>Best Seller Basket Value by Count of Best Seller Orders
</run>
              <run bold='true' fontalignment='0'>Pro Utilization : </run>
              <run fontalignment='0'>Pro Orders by Total Orders on the Vendor by Pro Customers
</run>
              <run bold='true' fontalignment='0'>Best Seller Utilization</run>
              <run fontalignment='0'>  :Best Seller Order by  Total Orders on the Vendor by Pro Customers
</run>
              <run bold='true' fontalignment='0'>Pro Booster Utilization: </run>
              <run fontalignment='0'>Pro Best Seller Order by  Total Orders on the Vendor by Pro Customers
</run>
              <run bold='true' fontalignment='0'>% Best Seller Order with Free Delivery:</run>
              <run fontalignment='0'>  Best Seller Orders with free delivery benefit
</run>
              <run bold='true' fontalignment='0'>% Pro Booster Order with Free Delivery</run>
              <run fontalignment='0'> :Pro Best Seller Orders with free delivery benefit
</run>
              <run bold='true' fontalignment='0'>Pro Customer Acquisitions : </run>
              <run fontalignment='0'>Count of users placing the first order on the vendor via Pro benefit
</run>
              <run bold='true' fontalignment='0'>Booster Pro Customer Acquisitions : </run>
              <run fontalignment='0'>Count of users placing the first order on the vendor via  Booster benefit ( subset of above acq count)
</run>
              <run bold='true' fontalignment='0'>Pro Cost</run>
              <run fontalignment='0'>  : Sum of Free Delivery Benefit, Best Seller Benefit and Booster Benefit
</run>
              <run bold='true' fontalignment='0'>Best Seller Cost: </run>
              <run fontalignment='0'>Best Seller Cost&#10;</run>
              <run bold='true' fontalignment='0'>Pro Best Seller Cost; </run>
              <run fontalignment='0'>Best Seller Cost for orders with Pro Benefit
</run>
              <run bold='true' fontalignment='0'>Booster Cost :</run>
              <run fontalignment='0'> Booster Cost&#10;</run>
              <run bold='true' fontalignment='0'>Talabat Funded Booster Discount :</run>
              <run fontalignment='0'>       Booster Cost funded by Talabat by Total Booster Cost
</run>
              <run bold='true' fontalignment='0'>Vendor Funded Booster Discount :</run>
              <run fontalignment='0'> Booster Cost funded by Vendor by Total Booster Cost
</run>
              <run bold='true' fontalignment='0'>Pro ROD (return on discount)  :</run>
              <run fontalignment='0'>Pro Order GMV on the vendor by Pro Cost
</run>
              <run bold='true' fontalignment='0'>Pro CAC (cost per Pro Acquisition)  :</run>
              <run fontalignment='0'>Pro Cost by Pro acquisition&#10;</run>
              <run bold='true' fontalignment='0'>Pro CPO (cost per Pro order)  :</run>
              <run fontalignment='0'>Pro Cost by Count of Pro Orders


</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f1f0' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='338' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='337' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98770' id='3' type-v2='text' w='98400' x='800' y='615'>
                  <formatted-text>
                    <run bold='true' fontalignment='0'>Definitions</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0'>* all monetary values are in LC</run>
                    <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontalignment='0'>Customers</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0'>Average total savings per Customer</run>
                    <run fontalignment='0'>: total savings (booster + free delivery+best seller)/ count of customers using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Booster savings per Custome</run>
                    <run fontalignment='0'>r : total booster discount/ count of customers using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Best Seller savings per Customer </run>
                    <run fontalignment='0'>: total best seller discount/ count of customers using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Free Delivery savings per Customer</run>
                    <run fontalignment='0'> : total free delivery discount/ count of customers using booster discount

</run>
                    <run bold='true' fontalignment='0'>Average total savings per Order</run>
                    <run fontalignment='0'>: total savings (booster + free delivery+best seller)/ count of orders using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Booster savings per Order:</run>
                    <run fontalignment='0'> total booster discount/ count of orders using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Best Seller savings per Order:</run>
                    <run fontalignment='0'> total best seller discount/ count of orders using booster discount
</run>
                    <run bold='true' fontalignment='0'>Average Free Delivery savings per Order :</run>
                    <run fontalignment='0'> total free delivery discount/ count of orders using booster discount


</run>
                    <run bold='true' fontalignment='0'>Platform</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0'>* based on Booster or Best Seller - as applicable </run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='0'>Orders</run>
                    <run fontalignment='0'> : count of orders&#10;</run>
                    <run bold='true' fontalignment='0'>Customers  </run>
                    <run fontalignment='0'>: count of  users&#10;</run>
                    <run bold='true' fontalignment='0'>Adoption%</run>
                    <run fontalignment='0'> : count of users in the time period / total tpro customers in the time period
</run>
                    <run bold='true' fontalignment='0'>Order Frequency</run>
                    <run fontalignment='0'> : count of orders/ count of booster customers
</run>
                    <run bold='true' fontalignment='0'>GMV</run>
                    <run fontalignment='0'> : GMV of orders&#10;</run>
                    <run bold='true' fontalignment='0'>AOV </run>
                    <run fontalignment='0'> (gmv/orders) : GMV of orders/ count of  orders
</run>
                    <run bold='true' fontalignment='0'>ABV </run>
                    <run fontalignment='0'> (basket value/orders) : basket value of orders/ count of  orders
 </run>
                    <run bold='true' fontalignment='0'>Utilization </run>
                    <run fontalignment='0'>: count of  orders / count of all  orders by tpro users
 </run>
                    <run bold='true' fontalignment='0'>Free Delivery Order % </run>
                    <run fontalignment='0'>: count of orders with free delivery / count of orders
</run>
                    <run bold='true' fontalignment='0'>Activation via Booster:</run>
                    <run fontalignment='0'>  count of users with first tpro order as a booster order
</run>
                    <run bold='true' fontalignment='0'>Total Booster Savings</run>
                    <run fontalignment='0'> : total booster savings&#10;</run>
                    <run bold='true' fontalignment='0'>Talabat Share of Booster Discoun</run>
                    <run fontalignment='0'>t : talabat share of booster discount/ total booster savings
</run>
                    <run bold='true' fontalignment='0'>Vendor Share of Booster Discount : </run>
                    <run fontalignment='0'>vendor share of booster discount/ total booster savings

</run>
                    <run bold='true' fontalignment='0'>Vendor</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0'>* The KPIs below are in the context of Pro Customers on the vendor </run>
                    <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontalignment='0'>Pro Orders</run>
                    <run fontalignment='0'>  :Total Pro Orders on  the vendor
</run>
                    <run bold='true' fontalignment='0'>Best Seller Orders</run>
                    <run fontalignment='0'> :Total Best Seller Orders on the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Best Seller Orders</run>
                    <run fontalignment='0'> : Pro Best Seller Orders on the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Booster Orders </run>
                    <run fontalignment='0'> :Pro Booster Orders on the vendor
</run>
                    <run bold='true' fontalignment='0'>Booster share of Best Seller Orders: </run>
                    <run fontalignment='0'>Pro Booster Orders on the vendor as a share of Best Seller Orders
</run>
                    <run bold='true' fontalignment='0'>Pro Customer Count</run>
                    <run fontalignment='0'>: Pro Customer Count on the vendor
</run>
                    <run bold='true' fontalignment='0'>Best Seller Customers</run>
                    <run fontalignment='0'> :Best Seller Customers on the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Best Seller Customers</run>
                    <run fontalignment='0'> :Best Seller Customers who have placed a Pro Best Seller Order on the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Booster Customers: </run>
                    <run fontalignment='0'>Pro Booster Customers on the vendor
</run>
                    <run bold='true' fontalignment='0'>Best Seller Adoption% : </run>
                    <run fontalignment='0'>Best Seller Customers as a share of Pro Customer Count
</run>
                    <run bold='true' fontalignment='0'>Pro Booster Adoption%</run>
                    <run fontalignment='0'> : Pro Booster Customers as a share of Pro Customer Count
</run>
                    <run bold='true' fontalignment='0'>Pro Order Frequency:</run>
                    <run fontalignment='0'>  Pro Orders by Pro Customers&#10;</run>
                    <run bold='true' fontalignment='0'>Best Seller Order Frequency </run>
                    <run fontalignment='0'> :Best Seller Orders by Pro Customers
</run>
                    <run bold='true' fontalignment='0'>Pro Booster Order Frequency :</run>
                    <run fontalignment='0'>Pro Booster Orders by Pro Customers
</run>
                    <run bold='true' fontalignment='0'>Pro GMV </run>
                    <run fontalignment='0'>        Pro Order GMV on the vendor
</run>
                    <run bold='true' fontalignment='0'>Best Seller GMV </run>
                    <run fontalignment='0'>        Best Seller Order GMV on  the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Best Seller GMV</run>
                    <run fontalignment='0'>        Best Seller Pro Order GMV on  the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Booster GMV</run>
                    <run fontalignment='0'>         Total Pro Booster GMV on  the vendor
</run>
                    <run bold='true' fontalignment='0'>Pro Order AOV</run>
                    <run fontalignment='0'>         Pro Orders GMV by Count of Pro Orders
</run>
                    <run bold='true' fontalignment='0'>Best Seller AOV   </run>
                    <run fontalignment='0'>      Best Seller GMV by Count of Best Seller Orders
</run>
                    <run bold='true' fontalignment='0'>Pro Booster AOV</run>
                    <run fontalignment='0'>        Pro Best Seller GMV by Count of Pro Booster Orders
</run>
                    <run bold='true' fontalignment='0'>Pro ABV</run>
                    <run fontalignment='0'>         Total Pro Booster Basket Value on  the vendor
</run>
                    <run bold='true' fontalignment='0'>Best Seller ABV:  </run>
                    <run fontalignment='0'>Pro Orders Basket Value  by Count of Pro Orders
</run>
                    <run bold='true' fontalignment='0'>Pro Booster ABV:</run>
                    <run fontalignment='0'>Best Seller Basket Value by Count of Best Seller Orders
</run>
                    <run bold='true' fontalignment='0'>Pro Utilization : </run>
                    <run fontalignment='0'>Pro Orders by Total Orders on the Vendor by Pro Customers
</run>
                    <run bold='true' fontalignment='0'>Best Seller Utilization</run>
                    <run fontalignment='0'>  :Best Seller Order by  Total Orders on the Vendor by Pro Customers
</run>
                    <run bold='true' fontalignment='0'>Pro Booster Utilization: </run>
                    <run fontalignment='0'>Pro Best Seller Order by  Total Orders on the Vendor by Pro Customers
</run>
                    <run bold='true' fontalignment='0'>% Best Seller Order with Free Delivery:</run>
                    <run fontalignment='0'>  Best Seller Orders with free delivery benefit
</run>
                    <run bold='true' fontalignment='0'>% Pro Booster Order with Free Delivery</run>
                    <run fontalignment='0'> :Pro Best Seller Orders with free delivery benefit
</run>
                    <run bold='true' fontalignment='0'>Pro Customer Acquisitions : </run>
                    <run fontalignment='0'>Count of users placing the first order on the vendor via Pro benefit
</run>
                    <run bold='true' fontalignment='0'>Booster Pro Customer Acquisitions : </run>
                    <run fontalignment='0'>Count of users placing the first order on the vendor via  Booster benefit ( subset of above acq count)
</run>
                    <run bold='true' fontalignment='0'>Pro Cost</run>
                    <run fontalignment='0'>  : Sum of Free Delivery Benefit, Best Seller Benefit and Booster Benefit
</run>
                    <run bold='true' fontalignment='0'>Best Seller Cost: </run>
                    <run fontalignment='0'>Best Seller Cost&#10;</run>
                    <run bold='true' fontalignment='0'>Pro Best Seller Cost; </run>
                    <run fontalignment='0'>Best Seller Cost for orders with Pro Benefit
</run>
                    <run bold='true' fontalignment='0'>Booster Cost :</run>
                    <run fontalignment='0'> Booster Cost&#10;</run>
                    <run bold='true' fontalignment='0'>Talabat Funded Booster Discount :</run>
                    <run fontalignment='0'>       Booster Cost funded by Talabat by Total Booster Cost
</run>
                    <run bold='true' fontalignment='0'>Vendor Funded Booster Discount :</run>
                    <run fontalignment='0'> Booster Cost funded by Vendor by Total Booster Cost
</run>
                    <run bold='true' fontalignment='0'>Pro ROD (return on discount)  :</run>
                    <run fontalignment='0'>Pro Order GMV on the vendor by Pro Cost
</run>
                    <run bold='true' fontalignment='0'>Pro CAC (cost per Pro Acquisition)  :</run>
                    <run fontalignment='0'>Pro Cost by Pro acquisition&#10;</run>
                    <run bold='true' fontalignment='0'>Pro CPO (cost per Pro order)  :</run>
                    <run fontalignment='0'>Pro Cost by Count of Pro Orders


</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f1f0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
