,count(distinct case when is_exclusive_deal_acquisition and is_non_food then base.account_id end) as exclusive_deal_acquisition_customers_non_food
,count(distinct case when is_exclusive_deal_acquisition and is_non_food is false then base.account_id end) as exclusive_deal_acquisition_customers_food

