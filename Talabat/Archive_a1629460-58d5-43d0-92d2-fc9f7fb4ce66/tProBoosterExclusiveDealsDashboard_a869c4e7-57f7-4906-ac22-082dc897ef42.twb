            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='rimsha.rashid.2@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1b9jnxc12e8l0911a0si008fizeg' name='Custom SQL Query' type='text'><![CDATA[#select * from
#`tlb-data-dev.data_playground.booster_total_test1`

-- select 
-- order_id,
-- order_time_utc,
-- has_tpro_benefit,
-- has_tpro_booster,
-- has_tpro_exclusive_deal,
-- is_tpro_order
-- from
-- `tlb-data-prod.data_platform.fct_order_info`
-- where account_id=18355448
-- and order_date>>="2024-09-01"
-- and is_successful
-- order by 1


with first_order_customer as (
  select 
     ord.account_id
     ,ord.order_id
    ,ord.order_date
    ,order_time_utc
    ,ord.country_code
    ,has_tpro_benefit
    ,row_number() over (partition by account_id,country_code,has_tpro_benefit order by order_time_utc) as first_tpro_order_date
    ,row_number() over (partition by account_id,country_code order by order_time_utc) as first_order_date
    -- ,min(order_date) as first_order_date
    -- ,min(case when has_tpro_benefit then order_date end) as first_tpro_order_date
    -- ,min(case when has_tpro_booster then order_date end) as first_tpro_booster_order_date
    -- ,min(case when has_tpro_exclusive_deal then order_date end) as first_tpro_exclusive_order_date
  from `tlb-data-prod.data_platform.fct_order_info` ord
    where true
    
    and is_successful
    and is_test = FALSE
    and ord.country_code in ('AE','KW','QA','BH','JO','OM')
    group by all
)



, tpro_customers as (
  select 
   DATE(TIMESTAMP(date), timezone)  as  date ----- converting to local time
  ,c.country_code
  ,account_id
  ,is_churned
  ,is_billing_retry
  ,is_acquired
  ,sum(case when is_churned is false and is_billing_retry is false then coalesce(order_count,0) end) as all_orders_tpro_customers,
  
  from `tlb-data-prod.data_platform.fct_subscription_cohort_daily`  c
  inner join `tlb-data-prod.data_platform.dim_country_info` as d
 on c.country_code=d.country_code
 
  -- where true
  -- and is_churned is false
  -- and is_billing_retry is false

  group by all
)


,aggregated_tpro_customers as (

select
  "Daily" as date_aggregation,
  country_code,
  date as  date,
  count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
  sum(all_orders_tpro_customers) as all_orders_tpro_customers,
  count(distinct case when is_acquired then account_id end) as tpro_acquistions
  from
  tpro_customers
  group by all

union all

  select
  "Weekly" as date_aggregation,
   country_code,
   date_trunc(date,week) as date,
   count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
   sum(all_orders_tpro_customers) as all_orders_tpro_customers,
   count(distinct case when is_acquired then account_id end) as tpro_acquistions
  from
  tpro_customers
  group by all

union all

select
  "Monthly" as date_aggregation,
  country_code,
  date_trunc(date,month) as date,
   count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
   sum(all_orders_tpro_customers) as all_orders_tpro_customers,
   count(distinct case when is_acquired then account_id end) as tpro_acquistions
 from tpro_customers
  group by all

)

, base as (
select 
   ord.order_date
  ,ord.order_id
  ,ord.is_non_food
  ,ord.account_id
  ,ord.country_code
  ,ord.gmv_amount_lc
  ,ord.basket_amount_lc
  ,ord.has_tpro_benefit
  ,ord.has_tpro_delivery_discount
  ,ord.tpro_discount_lc as tpro_delivery_discount_amount_lc
  ,max(case when inc.order_id is not null and platform_campaign_type="Best Sellers"  and lower(inc.incentive_sub_type) in ('item discount')then true else false end) as is_best_seller_order
  ,sum(case when inc.order_id is not null and platform_campaign_type="Best Sellers" and lower(inc.incentive_sub_type) in ('item discount') then inc.incentive_amount_lc end) as 
  best_seller_discount_amount_lc
  ,ord.has_tpro_booster
  ,ord.tpro_booster_discount_amount_lc

  
  ,max(case when cust.first_tpro_order_date =1 and has_tpro_booster then true else false end) as is_booster_acquisition
,max(case when first_tpro_order_date = 1 then true else false end) as is_tpro_acquisition

  ,bill.vendor_paid_incentive_amount_lc
  ,bill.talabat_paid_incentive_amount_lc
  ,bill.vendor_paid_tpro_booster_discount_amount_lc
  ,bill.talabat_paid_tpro_booster_discount_amount_lc
 ---- adding exclusive deals --------------------------------------------------
  ,ord.has_tpro_exclusive_deal
  ,ord.tpro_exclusive_deal_discount_amount_lc
  ,sum(case when is_tpro_exclusive then platform_incentive_cost_lc else 0 end) as platform_incentive_cost_lc	
  ,sum(case when is_tpro_exclusive then vendor_incentive_cost_lc else 0 end) as vendor_incentive_cost_lc
  ,max(case when first_tpro_order_date=1 and has_tpro_exclusive_deal then true else false end) as is_exclusive_deal_acquisition
  
from `tlb-data-prod.data_platform.fct_order_info` ord
inner join `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
       on ord.account_id = tpro.account_id
      and ord.country_code = tpro.country_code
      and ord.order_date = tpro.date
      and is_churned is false 
      and is_billing_retry is false
left join `tlb-data-prod.data_platform.dim_vendor` ven 
       on ord.vendor_id = ven.vendor_id
left join `tlb-data-prod.data_platform.fct_incentive_order_detail` inc 
       on ord.order_id = inc.order_id 
      --and lower(incentive_sub_type) in ('item discount','menu discount')
left join `tlb-data-prod.data_platform.dim_incentive_campaign` camp 
       on inc.incentive_campaign_id = camp.incentive_campaign_id
      -- and coalesce(platform_campaign_type,"NA") in ("Best Sellers","NA")
left join `tlb-data-prod.data_platform.fct_billing` bill 
       on ord.order_id = bill.order_id
left join first_order_customer cust on ord.order_id = cust.order_id
--and ord.country_code=cust.country_code
where 
ord.is_successful
and ord.is_test = false
and ord.country_code in ('AE','KW','QA','BH','JO','OM')

group by all
)

-- select
-- *
-- from base
-- where is_exclusive_deal_acquisition
-- and country_code='AE'
-- and date_trunc(order_date,month)="2024-09-01"






,final as (select 
  "Daily" as date_aggregation
  ,base.country_code
  ,date.date -- make this from dim date table
  ,count(distinct case when is_best_seller_order then base.account_id end) as best_seller_customers
  ,count(distinct case when has_tpro_booster then base.account_id end) as tpro_booster_customers

  ,count(distinct case when is_booster_acquisition then base.account_id end) as booster_acquisition_customers
  ,count(distinct case when is_tpro_acquisition then base.account_id end) as tpro_acquisition_customers

  ,count(distinct case when is_best_seller_order then order_id end) as best_seller_orders
  ,count(distinct case when has_tpro_booster then order_id end) as tpro_booster_orders

  ,count(distinct case when is_best_seller_order and has_tpro_delivery_discount then order_id end) as best_seller_free_delivery_orders
  ,count(distinct case when has_tpro_booster and has_tpro_delivery_discount then order_id end) as tpro_booster_free_delivery_orders

  ,sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc -- general best seller discount amount
  ,sum(case when has_tpro_booster then best_seller_discount_amount_lc end) as tpro_booster_incentive_discount_amount_lc -- only best seller amount when there is a booster applied 
  ,sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc --booster discount amount

  ,sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc -- talabat funded booster amount
  ,sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc -- vendor funded booster amount

  ,sum(case when is_best_seller_order then tpro_delivery_discount_amount_lc end) as best_seller_tpro_discount_lc -- fd amount
  ,sum(case when has_tpro_booster then tpro_delivery_discount_amount_lc end) as tpro_booster_tpro_discount_lc

  ,sum(case when is_best_seller_order then base.gmv_amount_lc end) as best_seller_gmv_amount_lc
  ,sum(case when has_tpro_booster then base.gmv_amount_lc end) as tpro_booster_gmv_amount_lc

  ,sum(case when is_best_seller_order then basket_amount_lc end) as best_seller_basket_amount_lc
  ,sum(case when has_tpro_booster then basket_amount_lc end) as tpro_booster_basket_amount_lc

  --------------------------------------------------------------------------------------------
  ,count(distinct case when has_tpro_benefit then order_id end) as all_tpro_orders
  ,count(distinct case when has_tpro_benefit then account_id end) as all_tpro_orders_customers
  ,sum(case when has_tpro_benefit then coalesce(gmv_amount_lc,0) end) as all_tpro_orders_gmv_amount_lc
  ,sum(case when has_tpro_benefit then coalesce(basket_amount_lc,0) end) as all_tpro_orders_basket_amount_lc

  ,sum(case when has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc
  ,sum(case when has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc
  
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_non_food
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_non_food

    ,sum(case when  is_non_food is false and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_food
  ,sum(case when  is_non_food  is false and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_food



  ,count(distinct case when has_tpro_exclusive_deal then account_id end) as exclusive_deal_users
  ,count(distinct case when has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders


  ,count(distinct case when is_non_food and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_non_food
  ,count(distinct case when  is_non_food and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_non_food

  ,count(distinct case when is_non_food is false and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_food
  ,count(distinct case when  is_non_food is false  and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_food

    
  ,sum(case when has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount


  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_non_food
  ,sum(case when is_non_food and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_non_food
  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_non_food


  
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_food
  ,sum(case when is_non_food is false  and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_food
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_food


  
  , count(distinct case when has_tpro_exclusive_deal and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders

   , count(distinct case when has_tpro_exclusive_deal and is_non_food and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_non_food

  
   , count(distinct case when has_tpro_exclusive_deal and is_non_food is false and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_food

,sum(case when has_tpro_exclusive_deal then coalesce(tpro_delivery_discount_amount_lc,0) end) as exclusive_deal_free_delivery_discount

,count(distinct case when is_exclusive_deal_acquisition then base.account_id end) as exclusive_deal_acquisition_customers
,count(distinct case when is_exclusive_deal_acquisition and is_non_food then base.account_id end) as exclusive_deal_acquisition_customers_non_food
,count(distinct case when is_exclusive_deal_acquisition and is_non_food is false then base.account_id end) as exclusive_deal_acquisition_customers_food
----------------------------------------------------------------------------
,count(distinct case when is_best_seller_order and has_tpro_benefit then order_id end) as pro_best_seller_order
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as pro_best_seller_free_delivery_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_booster_discount_amount_lc,0) end) as pro_best_seller_tpro_booster_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(best_seller_discount_amount_lc,0) end) as pro_best_seller_discount_savings
,count(distinct case when is_best_seller_order and has_tpro_benefit then account_id end) as pro_best_seller_order_customer

--------
, sum(case when has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as total_free_delivery_savings

from tlb-data-prod.data_platform.dim_date date
left join base on date.date = base.order_date

where true
and date.date >>= '2024-01-01'
and date.date <<= current_date()
group by all


union all

select 
  "Weekly" as date_aggregation
  ,base.country_code
  ,date_trunc(date.date,week) as date -- make this from dim date table
  ,count(distinct case when is_best_seller_order then base.account_id end) as best_seller_customers
  ,count(distinct case when has_tpro_booster then base.account_id end) as tpro_booster_customers

  ,count(distinct case when is_booster_acquisition then base.account_id end) as booster_acquisition_customers
  ,count(distinct case when is_tpro_acquisition then base.account_id end) as tpro_acquisition_customers

  ,count(distinct case when is_best_seller_order then order_id end) as best_seller_orders
  ,count(distinct case when has_tpro_booster then order_id end) as tpro_booster_orders

  ,count(distinct case when is_best_seller_order and has_tpro_delivery_discount then order_id end) as best_seller_free_delivery_orders
  ,count(distinct case when has_tpro_booster and has_tpro_delivery_discount then order_id end) as tpro_booster_free_delivery_orders

  ,sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc -- general best seller discount amount
  ,sum(case when has_tpro_booster then best_seller_discount_amount_lc end) as tpro_booster_incentive_discount_amount_lc -- only best seller amount when there is a booster applied 
  ,sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc --booster discount amount

  ,sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc -- talabat funded booster amount
  ,sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc -- vendor funded booster amount

  ,sum(case when is_best_seller_order then tpro_delivery_discount_amount_lc end) as best_seller_tpro_discount_lc -- fd amount
  ,sum(case when has_tpro_booster then tpro_delivery_discount_amount_lc end) as tpro_booster_tpro_discount_lc

  ,sum(case when is_best_seller_order then base.gmv_amount_lc end) as best_seller_gmv_amount_lc
  ,sum(case when has_tpro_booster then base.gmv_amount_lc end) as tpro_booster_gmv_amount_lc

  ,sum(case when is_best_seller_order then basket_amount_lc end) as best_seller_basket_amount_lc
  ,sum(case when has_tpro_booster then basket_amount_lc end) as tpro_booster_basket_amount_lc

  ----------------------------------------------------------------------------------------------------------
   ,count(distinct case when has_tpro_benefit then order_id end) as all_tpro_orders
   ,count(distinct case when has_tpro_benefit then account_id end) as all_tpro_orders_customers
  ,sum(case when has_tpro_benefit then coalesce(gmv_amount_lc,0) end) as all_tpro_orders_gmv_amount_lc
  ,sum(case when has_tpro_benefit then coalesce(basket_amount_lc,0) end) as all_tpro_orders_basket_amount_lc

  ,sum(case when has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc
  ,sum(case when has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc
  
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_non_food
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_non_food

    ,sum(case when  is_non_food is false and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_food
  ,sum(case when  is_non_food  is false and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_food



  ,count(distinct case when has_tpro_exclusive_deal then account_id end) as exclusive_deal_users
  ,count(distinct case when has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders


  ,count(distinct case when is_non_food and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_non_food
  ,count(distinct case when  is_non_food and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_non_food

  ,count(distinct case when is_non_food is false and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_food
  ,count(distinct case when  is_non_food is false  and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_food

    
  ,sum(case when has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount


  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_non_food
  ,sum(case when is_non_food and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_non_food
  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_non_food


  
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_food
  ,sum(case when is_non_food is false  and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_food
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_food


  
  , count(distinct case when has_tpro_exclusive_deal and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders

   , count(distinct case when has_tpro_exclusive_deal and is_non_food and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_non_food

  
   , count(distinct case when has_tpro_exclusive_deal and is_non_food is false and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_food

,sum(case when has_tpro_exclusive_deal then coalesce(tpro_delivery_discount_amount_lc,0) end) as exclusive_deal_free_delivery_discount

,count(distinct case when is_exclusive_deal_acquisition then base.account_id end) as exclusive_deal_acquisition_customers
,count(distinct case when is_exclusive_deal_acquisition and is_non_food then base.account_id end) as exclusive_deal_acquisition_customers_non_food
,count(distinct case when is_exclusive_deal_acquisition and is_non_food is false then base.account_id end) as exclusive_deal_acquisition_customers_food

,count(distinct case when is_best_seller_order and has_tpro_benefit then order_id end) as pro_best_seller_order
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as pro_best_seller_free_delivery_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_booster_discount_amount_lc,0) end) as pro_best_seller_tpro_booster_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(best_seller_discount_amount_lc,0) end) as pro_best_seller_discount_savings

,count(distinct case when is_best_seller_order and has_tpro_benefit then account_id end) as pro_best_seller_order_customer

, sum(case when has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as total_free_delivery_savings

from tlb-data-prod.data_platform.dim_date date
left join base on (date.date) = order_date

where true
and date.date >>= '2024-01-01'
and date.date <<= current_date()
group by all

union all

select 
  "Monthly" as date_aggregation
  
  ,base.country_code
  ,date_trunc(date.date,month) as date -- make this from dim date table
  ,count(distinct case when is_best_seller_order then base.account_id end) as best_seller_customers
  ,count(distinct case when has_tpro_booster then base.account_id end) as tpro_booster_customers

  ,count(distinct case when is_booster_acquisition then base.account_id end) as booster_acquisition_customers
  ,count(distinct case when is_tpro_acquisition then base.account_id end) as tpro_acquisition_customers

  ,count(distinct case when is_best_seller_order then order_id end) as best_seller_orders
  ,count(distinct case when has_tpro_booster then order_id end) as tpro_booster_orders

  ,count(distinct case when is_best_seller_order and has_tpro_delivery_discount then order_id end) as best_seller_free_delivery_orders
  ,count(distinct case when has_tpro_booster and has_tpro_delivery_discount then order_id end) as tpro_booster_free_delivery_orders

  ,sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc -- general best seller discount amount
  ,sum(case when has_tpro_booster then best_seller_discount_amount_lc end) as tpro_booster_incentive_discount_amount_lc -- only best seller amount when there is a booster applied 
  ,sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc --booster discount amount

  ,sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc -- talabat funded booster amount
  ,sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc -- vendor funded booster amount

  ,sum(case when is_best_seller_order then tpro_delivery_discount_amount_lc end) as best_seller_tpro_discount_lc -- fd amount
  ,sum(case when has_tpro_booster then tpro_delivery_discount_amount_lc end) as tpro_booster_tpro_discount_lc

  ,sum(case when is_best_seller_order then base.gmv_amount_lc end) as best_seller_gmv_amount_lc
  ,sum(case when has_tpro_booster then base.gmv_amount_lc end) as tpro_booster_gmv_amount_lc

  ,sum(case when is_best_seller_order then basket_amount_lc end) as best_seller_basket_amount_lc
  ,sum(case when has_tpro_booster then basket_amount_lc end) as tpro_booster_basket_amount_lc

  ----------------------------------------------------------------------------------------------------------
  ,count(distinct case when has_tpro_benefit then order_id end) as all_tpro_orders
  ,count(distinct case when has_tpro_benefit then account_id end) as all_tpro_orders_customers
  ,sum(case when has_tpro_benefit then coalesce(gmv_amount_lc,0) end) as all_tpro_orders_gmv_amount_lc
  ,sum(case when has_tpro_benefit then coalesce(basket_amount_lc,0) end) as all_tpro_orders_basket_amount_lc

  ,sum(case when has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc
  ,sum(case when has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc
  
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_non_food
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_non_food

    ,sum(case when  is_non_food is false and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_food
  ,sum(case when  is_non_food  is false and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_food



  ,count(distinct case when has_tpro_exclusive_deal then account_id end) as exclusive_deal_users
  ,count(distinct case when has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders


  ,count(distinct case when is_non_food and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_non_food
  ,count(distinct case when  is_non_food and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_non_food

  ,count(distinct case when is_non_food is false and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_food
  ,count(distinct case when  is_non_food is false  and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_food

    
  ,sum(case when has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount


  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_non_food
  ,sum(case when is_non_food and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_non_food
  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_non_food


  
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_food
  ,sum(case when is_non_food is false  and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_food
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_food


  
  , count(distinct case when has_tpro_exclusive_deal and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders

   , count(distinct case when has_tpro_exclusive_deal and is_non_food and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_non_food

  
   , count(distinct case when has_tpro_exclusive_deal and is_non_food is false and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_food

,sum(case when has_tpro_exclusive_deal then coalesce(tpro_delivery_discount_amount_lc,0) end) as exclusive_deal_free_delivery_discount

,count(distinct case when is_exclusive_deal_acquisition then base.account_id end) as exclusive_deal_acquisition_customers
,count(distinct case when is_exclusive_deal_acquisition and is_non_food then base.account_id end) as exclusive_deal_acquisition_customers_non_food
,count(distinct case when is_exclusive_deal_acquisition and is_non_food is false then base.account_id end) as exclusive_deal_acquisition_customers_food

,count(distinct case when is_best_seller_order and has_tpro_benefit then order_id end) as pro_best_seller_order
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as pro_best_seller_free_delivery_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_booster_discount_amount_lc,0) end) as pro_best_seller_tpro_booster_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(best_seller_discount_amount_lc,0) end) as pro_best_seller_discount_savings

,count(distinct case when is_best_seller_order and has_tpro_benefit then account_id end) as pro_best_seller_order_customer

, sum(case when has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as total_free_delivery_savings


from tlb-data-prod.data_platform.dim_date date
left join base on (date.date) = order_date

where true
and date.date>>="2024-01-01" and date.date <<= current_date()
group by all)

select f.*,all_tpro_customers,all_orders_tpro_customers,tpro_acquistions from final as f
inner join aggregated_tpro_customers as a
on f.country_code=a.country_code
and f.date_aggregation=a.date_aggregation
and f.date=a.date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1b9jnxc12e8l0911a0si008fizeg' name='Custom SQL Query' type='text'><![CDATA[#select * from
#`tlb-data-dev.data_playground.booster_total_test1`

-- select 
-- order_id,
-- order_time_utc,
-- has_tpro_benefit,
-- has_tpro_booster,
-- has_tpro_exclusive_deal,
-- is_tpro_order
-- from
-- `tlb-data-prod.data_platform.fct_order_info`
-- where account_id=18355448
-- and order_date>>="2024-09-01"
-- and is_successful
-- order by 1


with first_order_customer as (
  select 
     ord.account_id
     ,ord.order_id
    ,ord.order_date
    ,order_time_utc
    ,ord.country_code
    ,has_tpro_benefit
    ,row_number() over (partition by account_id,country_code,has_tpro_benefit order by order_time_utc) as first_tpro_order_date
    ,row_number() over (partition by account_id,country_code order by order_time_utc) as first_order_date
    -- ,min(order_date) as first_order_date
    -- ,min(case when has_tpro_benefit then order_date end) as first_tpro_order_date
    -- ,min(case when has_tpro_booster then order_date end) as first_tpro_booster_order_date
    -- ,min(case when has_tpro_exclusive_deal then order_date end) as first_tpro_exclusive_order_date
  from `tlb-data-prod.data_platform.fct_order_info` ord
    where true
    
    and is_successful
    and is_test = FALSE
    and ord.country_code in ('AE','KW','QA','BH','JO','OM')
    group by all
)



, tpro_customers as (
  select 
   DATE(TIMESTAMP(date), timezone)  as  date ----- converting to local time
  ,c.country_code
  ,account_id
  ,is_churned
  ,is_billing_retry
  ,is_acquired
  ,sum(case when is_churned is false and is_billing_retry is false then coalesce(order_count,0) end) as all_orders_tpro_customers,
  
  from `tlb-data-prod.data_platform.fct_subscription_cohort_daily`  c
  inner join `tlb-data-prod.data_platform.dim_country_info` as d
 on c.country_code=d.country_code
 
  -- where true
  -- and is_churned is false
  -- and is_billing_retry is false

  group by all
)


,aggregated_tpro_customers as (

select
  "Daily" as date_aggregation,
  country_code,
  date as  date,
  count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
  sum(all_orders_tpro_customers) as all_orders_tpro_customers,
  count(distinct case when is_acquired then account_id end) as tpro_acquistions
  from
  tpro_customers
  group by all

union all

  select
  "Weekly" as date_aggregation,
   country_code,
   date_trunc(date,week) as date,
   count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
   sum(all_orders_tpro_customers) as all_orders_tpro_customers,
   count(distinct case when is_acquired then account_id end) as tpro_acquistions
  from
  tpro_customers
  group by all

union all

select
  "Monthly" as date_aggregation,
  country_code,
  date_trunc(date,month) as date,
   count(distinct case when is_churned is false and is_billing_retry is false then account_id end) as all_tpro_customers,
   sum(all_orders_tpro_customers) as all_orders_tpro_customers,
   count(distinct case when is_acquired then account_id end) as tpro_acquistions
 from tpro_customers
  group by all

)

, base as (
select 
   ord.order_date
  ,ord.order_id
  ,ord.is_non_food
  ,ord.account_id
  ,ord.country_code
  ,ord.gmv_amount_lc
  ,ord.basket_amount_lc
  ,ord.has_tpro_benefit
  ,ord.has_tpro_delivery_discount
  ,ord.tpro_discount_lc as tpro_delivery_discount_amount_lc
  ,max(case when inc.order_id is not null and platform_campaign_type="Best Sellers"  and lower(inc.incentive_sub_type) in ('item discount')then true else false end) as is_best_seller_order
  ,sum(case when inc.order_id is not null and platform_campaign_type="Best Sellers" and lower(inc.incentive_sub_type) in ('item discount') then inc.incentive_amount_lc end) as 
  best_seller_discount_amount_lc
  ,ord.has_tpro_booster
  ,ord.tpro_booster_discount_amount_lc

  
  ,max(case when cust.first_tpro_order_date =1 and has_tpro_booster then true else false end) as is_booster_acquisition
,max(case when first_tpro_order_date = 1 then true else false end) as is_tpro_acquisition

  ,bill.vendor_paid_incentive_amount_lc
  ,bill.talabat_paid_incentive_amount_lc
  ,bill.vendor_paid_tpro_booster_discount_amount_lc
  ,bill.talabat_paid_tpro_booster_discount_amount_lc
 ---- adding exclusive deals --------------------------------------------------
  ,ord.has_tpro_exclusive_deal
  ,ord.tpro_exclusive_deal_discount_amount_lc
  ,sum(case when is_tpro_exclusive then platform_incentive_cost_lc else 0 end) as platform_incentive_cost_lc	
  ,sum(case when is_tpro_exclusive then vendor_incentive_cost_lc else 0 end) as vendor_incentive_cost_lc
  ,max(case when first_tpro_order_date=1 and has_tpro_exclusive_deal then true else false end) as is_exclusive_deal_acquisition
  
from `tlb-data-prod.data_platform.fct_order_info` ord
inner join `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
       on ord.account_id = tpro.account_id
      and ord.country_code = tpro.country_code
      and ord.order_date = tpro.date
      and is_churned is false 
      and is_billing_retry is false
left join `tlb-data-prod.data_platform.dim_vendor` ven 
       on ord.vendor_id = ven.vendor_id
left join `tlb-data-prod.data_platform.fct_incentive_order_detail` inc 
       on ord.order_id = inc.order_id 
      --and lower(incentive_sub_type) in ('item discount','menu discount')
left join `tlb-data-prod.data_platform.dim_incentive_campaign` camp 
       on inc.incentive_campaign_id = camp.incentive_campaign_id
      -- and coalesce(platform_campaign_type,"NA") in ("Best Sellers","NA")
left join `tlb-data-prod.data_platform.fct_billing` bill 
       on ord.order_id = bill.order_id
left join first_order_customer cust on ord.order_id = cust.order_id
--and ord.country_code=cust.country_code
where 
ord.is_successful
and ord.is_test = false
and ord.country_code in ('AE','KW','QA','BH','JO','OM')

group by all
)

-- select
-- *
-- from base
-- where is_exclusive_deal_acquisition
-- and country_code='AE'
-- and date_trunc(order_date,month)="2024-09-01"






,final as (select 
  "Daily" as date_aggregation
  ,base.country_code
  ,date.date -- make this from dim date table
  ,count(distinct case when is_best_seller_order then base.account_id end) as best_seller_customers
  ,count(distinct case when has_tpro_booster then base.account_id end) as tpro_booster_customers

  ,count(distinct case when is_booster_acquisition then base.account_id end) as booster_acquisition_customers
  ,count(distinct case when is_tpro_acquisition then base.account_id end) as tpro_acquisition_customers

  ,count(distinct case when is_best_seller_order then order_id end) as best_seller_orders
  ,count(distinct case when has_tpro_booster then order_id end) as tpro_booster_orders

  ,count(distinct case when is_best_seller_order and has_tpro_delivery_discount then order_id end) as best_seller_free_delivery_orders
  ,count(distinct case when has_tpro_booster and has_tpro_delivery_discount then order_id end) as tpro_booster_free_delivery_orders

  ,sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc -- general best seller discount amount
  ,sum(case when has_tpro_booster then best_seller_discount_amount_lc end) as tpro_booster_incentive_discount_amount_lc -- only best seller amount when there is a booster applied 
  ,sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc --booster discount amount

  ,sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc -- talabat funded booster amount
  ,sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc -- vendor funded booster amount

  ,sum(case when is_best_seller_order then tpro_delivery_discount_amount_lc end) as best_seller_tpro_discount_lc -- fd amount
  ,sum(case when has_tpro_booster then tpro_delivery_discount_amount_lc end) as tpro_booster_tpro_discount_lc

  ,sum(case when is_best_seller_order then base.gmv_amount_lc end) as best_seller_gmv_amount_lc
  ,sum(case when has_tpro_booster then base.gmv_amount_lc end) as tpro_booster_gmv_amount_lc

  ,sum(case when is_best_seller_order then basket_amount_lc end) as best_seller_basket_amount_lc
  ,sum(case when has_tpro_booster then basket_amount_lc end) as tpro_booster_basket_amount_lc

  --------------------------------------------------------------------------------------------
  ,count(distinct case when has_tpro_benefit then order_id end) as all_tpro_orders
  ,count(distinct case when has_tpro_benefit then account_id end) as all_tpro_orders_customers
  ,sum(case when has_tpro_benefit then coalesce(gmv_amount_lc,0) end) as all_tpro_orders_gmv_amount_lc
  ,sum(case when has_tpro_benefit then coalesce(basket_amount_lc,0) end) as all_tpro_orders_basket_amount_lc

  ,sum(case when has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc
  ,sum(case when has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc
  
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_non_food
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_non_food

    ,sum(case when  is_non_food is false and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_food
  ,sum(case when  is_non_food  is false and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_food



  ,count(distinct case when has_tpro_exclusive_deal then account_id end) as exclusive_deal_users
  ,count(distinct case when has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders


  ,count(distinct case when is_non_food and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_non_food
  ,count(distinct case when  is_non_food and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_non_food

  ,count(distinct case when is_non_food is false and  has_tpro_exclusive_deal then account_id end) as exclusive_deal_users_food
  ,count(distinct case when  is_non_food is false  and has_tpro_exclusive_deal then order_id end) as exclusive_deal_orders_food

    
  ,sum(case when has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount
  ,sum(case when has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount


  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_non_food
  ,sum(case when is_non_food and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_non_food
  ,sum(case when is_non_food and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_non_food


  
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(tpro_exclusive_deal_discount_amount_lc,0) end) as exclusive_deal_discount_food
  ,sum(case when is_non_food is false  and  has_tpro_exclusive_deal then coalesce(platform_incentive_cost_lc	,0) end) as talabat_funded_exclusive_deal_discount_food
  ,sum(case when is_non_food is false and has_tpro_exclusive_deal then coalesce(vendor_incentive_cost_lc	,0) end) as vendor_funded_exclusive_deal_discount_food


  
  , count(distinct case when has_tpro_exclusive_deal and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders

   , count(distinct case when has_tpro_exclusive_deal and is_non_food and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_non_food

  
   , count(distinct case when has_tpro_exclusive_deal and is_non_food is false and tpro_delivery_discount_amount_lc <<>>0 then order_id end) as          exclusive_deal_free_delivery_orders_food

,sum(case when has_tpro_exclusive_deal then coalesce(tpro_delivery_discount_amount_lc,0) end) as exclusive_deal_free_delivery_discount

,count(distinct case when is_exclusive_deal_acquisition then base.account_id end) as exclusive_deal_acquisition_customers
,count(distinct case when is_exclusive_deal_acquisition and is_non_food then base.account_id end) as exclusive_deal_acquisition_customers_non_food
,count(distinct case when is_exclusive_deal_acquisition and is_non_food is false then base.account_id end) as exclusive_deal_acquisition_customers_food
----------------------------------------------------------------------------
,count(distinct case when is_best_seller_order and has_tpro_benefit then order_id end) as pro_best_seller_order
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as pro_best_seller_free_delivery_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(tpro_booster_discount_amount_lc,0) end) as pro_best_seller_tpro_booster_savings
,sum(case when is_best_seller_order and has_tpro_benefit then coalesce(best_seller_discount_amount_lc,0) end) as pro_best_seller_discount_savings
,count(distinct case when is_best_seller_order and has_tpro_benefit then account_id end) as pro_best_seller_order_customer

--------
, sum(case when has_tpro_benefit then coalesce(tpro_delivery_discount_amount_lc,0) end) as total_free_delivery_savings

from tlb-data-prod.data_platform.dim_date date
left join base on date.date = base.order_date

where true
and date.date >>= '2024-01-01'
and date.date <<= current_date()
group by all


union all

select 
  "Weekly" as date_aggregation
  ,base.country_code
  ,date_trunc(date.date,week) as date -- make this from dim date table
  ,count(distinct case when is_best_seller_order then base.account_id end) as best_seller_customers
  ,count(distinct case when has_tpro_booster then base.account_id end) as tpro_booster_customers

  ,count(distinct case when is_booster_acquisition then base.account_id end) as booster_acquisition_customers
  ,count(distinct case when is_tpro_acquisition then base.account_id end) as tpro_acquisition_customers

  ,count(distinct case when is_best_seller_order then order_id end) as best_seller_orders
  ,count(distinct case when has_tpro_booster then order_id end) as tpro_booster_orders

  ,count(distinct case when is_best_seller_order and has_tpro_delivery_discount then order_id end) as best_seller_free_delivery_orders
  ,count(distinct case when has_tpro_booster and has_tpro_delivery_discount then order_id end) as tpro_booster_free_delivery_orders

  ,sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc -- general best seller discount amount
  ,sum(case when has_tpro_booster then best_seller_discount_amount_lc end) as tpro_booster_incentive_discount_amount_lc -- only best seller amount when there is a booster applied 
  ,sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc --booster discount amount

  ,sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc -- talabat funded booster amount
  ,sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc -- vendor funded booster amount

  ,sum(case when is_best_seller_order then tpro_delivery_discount_amount_lc end) as best_seller_tpro_discount_lc -- fd amount
  ,sum(case when has_tpro_booster then tpro_delivery_discount_amount_lc end) as tpro_booster_tpro_discount_lc

  ,sum(case when is_best_seller_order then base.gmv_amount_lc end) as best_seller_gmv_amount_lc
  ,sum(case when has_tpro_booster then base.gmv_amount_lc end) as tpro_booster_gmv_amount_lc

  ,sum(case when is_best_seller_order then basket_amount_lc end) as best_seller_basket_amount_lc
  ,sum(case when has_tpro_booster then basket_amount_lc end) as tpro_booster_basket_amount_lc

  ----------------------------------------------------------------------------------------------------------
   ,count(distinct case when has_tpro_benefit then order_id end) as all_tpro_orders
   ,count(distinct case when has_tpro_benefit then account_id end) as all_tpro_orders_customers
  ,sum(case when has_tpro_benefit then coalesce(gmv_amount_lc,0) end) as all_tpro_orders_gmv_amount_lc
  ,sum(case when has_tpro_benefit then coalesce(basket_amount_lc,0) end) as all_tpro_orders_basket_amount_lc

  ,sum(case when has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc
  ,sum(case when has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc
  
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(gmv_amount_lc,0) end) as exclucsive_deal_gmv_amount_lc_non_food
  ,sum(case when  is_non_food and has_tpro_exclusive_deal then coalesce(basket_amount_lc,0) end) as exclucsive_deal_basket_amount_lc_non_food

