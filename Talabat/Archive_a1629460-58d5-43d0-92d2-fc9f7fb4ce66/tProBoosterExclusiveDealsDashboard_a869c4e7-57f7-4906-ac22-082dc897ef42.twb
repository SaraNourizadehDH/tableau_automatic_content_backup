          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.1b0gtf309wmzld11gvplb0rtl3g0'>
            <column caption='Average Best Seller savings per Customer ' datatype='real' name='[Average Best Seller savings per Customer (copy)_1502794955890126848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tpro_booster_incentive_discount_amount_lc])&#10;/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Booster savings per Customer ' datatype='real' name='[Average Booster savings per Customer (copy)_1502794955892936705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_discount_amount_lc])/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Best Seller savings per Order' datatype='real' name='[Average Booster savings per Order (copy)_3834744763922059267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tpro_booster_incentive_discount_amount_lc]))&#10;/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average Free Delivery savings per Order' datatype='real' name='[Average Booster savings per Order (copy)_3834744763922493444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_tpro_discount_lc])/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average Free Delivery savings per Customer ' datatype='real' name='[Average Free Delivery savings per Customer (copy)_1502794955893186562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_tpro_discount_lc])/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Savings per customer' datatype='real' name='[Average Savings per customer (copy)_1502794955893628931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tpro_booster_tpro_discount_lc])+SUM([tpro_booster_incentive_discount_amount_lc])+sum([tpro_booster_discount_amount_lc]))/&#13;&#10;SUM([tpro_booster_customers])' />
            </column>
            <column caption='Average Booster savings per Order' datatype='real' name='[Calculation_913949296779644932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_discount_amount_lc])/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average total savings per Order' datatype='real' name='[Calculation_913949296781238278]' role='measure' type='quantitative'>
