    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Exclusive Deals Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/tProBoosterDashboard_17235523792230/ExclusiveDealsGlossary?rev=' id='ExclusiveDealsGlossary' path='/t/Talabat/workbooks/tProBoosterDashboard_17235523792230' revision='' site='Talabat' />
      <style />
      <size maxheight='1300' maxwidth='1000' minheight='1300' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98770' id='3' type-v2='text' w='98400' x='800' y='615'>
            <formatted-text>
              <run bold='true' fontalignment='0'>Definitions</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0'>* all monetary values are in LC</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0'>Pro Order Count: </run>
              <run fontalignment='0'>count of Pro Benefit orders&#10;</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deal Orders:  </run>
              <run fontalignment='0'>count of exclusive deal orders&#10;</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal Orders : </run>
              <run fontalignment='0'>count of food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>% share of Food Exclusive Deal Orders : </run>
              <run fontalignment='0'>count of food exclusive deal orders / total exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Non-Food Exclusive Deal Orders: </run>
              <run fontalignment='0'>count of non-food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>% share of Non-Food Exclusive Deal Orders : </run>
              <run fontalignment='0'>count of non- food exclusive deal orders / total exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>% Exclusive Deal Orders of Pro Orders: </run>
              <run fontalignment='0'>total exclusive deal orders/  Pro Order Count

</run>
              <run bold='true' fontalignment='0'>Pro Order Customers : </run>
              <run fontalignment='0'>count of customer placing Pro orders
</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deals Customers : </run>
              <run fontalignment='0'>count of customers placing exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal Customers :  </run>
              <run fontalignment='0'>count of</run>
              <run bold='true' fontalignment='0'>Æ </run>
              <run fontalignment='0'>customers placing food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal Customers: </run>
              <run fontalignment='0'>count of</run>
              <run bold='true' fontalignment='0'>Æ </run>
              <run fontalignment='0'>customers placing non- food exclusive deal orders

</run>
              <run bold='true' fontalignment='0'>Adoption% - Pro Order : </run>
              <run fontalignment='0'>count of Pro order Customer/ count of Pro  subscribers in the month
</run>
              <run bold='true' fontalignment='0'>Exclusive Deals Adoption% : </run>
              <run fontalignment='0'>count of  exclusive deal customers/ count of Pro subscribers in the month
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal Adoption% : </run>
              <run fontalignment='0'>count of  food  exclusive deal customers/ count of Pro subscribers in the month
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal Adoption% : </run>
              <run fontalignment='0'>count of  non- food exclusive deal customers/ count of Pro subscribers in the month

</run>
              <run bold='true' fontalignment='0'>Pro Order Frequency : </run>
              <run fontalignment='0'>count of Pro orders / count of Pro order customers 
</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deals Order Frequency : </run>
              <run fontalignment='0'>count of exclusive deal orders/ count of exclusive deal customers
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal Orders Frequency : </run>
              <run fontalignment='0'>count of food exclusive deal orders / count of exclusive deal customers
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal Order Frequency : </run>
              <run fontalignment='0'>count of non- food exclusive deal orders / count of exclusive deal customers
 
</run>
              <run bold='true' fontalignment='0'>Pro Orders GMV:  </run>
              <run fontalignment='0'>GMV of Pro Orders&#10;</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deals GMV : </run>
              <run fontalignment='0'>GMV of exclusive  deal orders&#10;</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal GMV : </run>
              <run fontalignment='0'>GMV of  food  exclusive  deal orders
</run>
              <run bold='true' fontalignment='0'>% Food share of Exclusive Deal GMV  : </run>
              <run fontalignment='0'>GMV of  food  exclusive  deal orders/GMV of  food  exclusive  deal orders
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal GMV :</run>
              <run fontalignment='0'>GMV of  non-  food  exclusive  deal orders
</run>
              <run bold='true' fontalignment='0'>% Non - Food share of Exclusive Deal GMV : </run>
              <run fontalignment='0'>GMV of  non - food  exclusive  deal orders/GMV of  food  exclusive  deal orders
</run>
              <run bold='true' fontalignment='0'>% exclusive deal order of Pro Order GMV : </run>
              <run fontalignment='0'>GMV of  food  exclusive  deal orders/GMV of Pro Orders

</run>
              <run bold='true' fontalignment='0'>Pro AOV : </run>
              <run fontalignment='0'>Pro Order GMV / Pro order count
</run>
              <run bold='true' fontalignment='0'>Exclusive Deals AOV  :  </run>
              <run fontalignment='0'>total exclusive deal GMV / total exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal AOV : </run>
              <run fontalignment='0'>food  exclusive deal GMV /  food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal AOV: </run>
              <run fontalignment='0'>non - food  exclusive deal GMV /  non - food  exclusive deal orders

</run>
              <run bold='true' fontalignment='0'>Pro ABV: </run>
              <run fontalignment='0'>Basket Value of Pro Orders / Pro order count
</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deals ABV: </run>
              <run fontalignment='0'>Basket value of  exclusive deal orders/  total exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal ABV : </run>
              <run fontalignment='0'>Basket value of food exclusive deal orders / food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Non- Food Exclusive Deal ABV:</run>
              <run fontalignment='0'>Basket value of  non -  food exclusive deal orders / non -food exclusive deal orders

</run>
              <run bold='true' fontalignment='0'>Pro Utilization : </run>
              <run fontalignment='0'>Pro order count/ count of all orders by Pro customers 
</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deals Utilization : </run>
              <run fontalignment='0'>total exclusive deal order count/ count of all orders by Pro customers  
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deals Utilization : </run>
              <run fontalignment='0'>food  exclusive deal order count/ count of all orders by Pro customers  
</run>
              <run bold='true' fontalignment='0'>Non- Food Exclusive Deal Utilization :  </run>
              <run fontalignment='0'>non - food  exclusive deal order count/ count of all orders by Pro customers  

</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deal Free Delivery Order % :  </run>
              <run fontalignment='0'>count of  exclusive deal orders with free delivery/ total exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Food - Exclusive Deal Free Delivery Order % :   </run>
              <run fontalignment='0'>count of  food exclusive deal orders with free delivery/ food exclusive deal orders
</run>
              <run bold='true' fontalignment='0'>Non Food - Exclusive Deal Free Delivery Order % :  </run>
              <run fontalignment='0'>count of non  -  food exclusive deal orders with free delivery/ non-food exclusive deal orders

</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deal Acquisitions: </run>
              <run fontalignment='0'>acquisition to tpro via exclusive deal order i.e user never placed a Pro order before placing a exclusive deal order
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deal Acquisitions :  </run>
              <run fontalignment='0'>acquisition to tpro via  food exclusive deal order
</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal Acquisitions : </run>
              <run fontalignment='0'>acquisition to tpro via  non- food exclusive deal order

</run>
              <run bold='true' fontalignment='0'>Total Exclusive Deal Discount </run>
              <run fontalignment='0'>: total exclusive deal discount
</run>
              <run bold='true' fontalignment='0'>Food Exclusive Deals Discount : </run>
              <run fontalignment='0'>food exclusive deal discount&#10;</run>
              <run bold='true' fontalignment='0'>% Vendor Funded Discount :</run>
              <run fontalignment='0'> vendor funded food exclusive deal discount</run>
              <run bold='true' fontalignment='0'> / </run>
              <run fontalignment='0'>food exclusive deal discount&#10;</run>
              <run bold='true' fontalignment='0'>% Talabat Funded Discount : </run>
              <run fontalignment='0'> talabat funded food exclusive deal discount</run>
              <run bold='true' fontalignment='0'> / </run>
              <run fontalignment='0'>food exclusive deal discount&#10;</run>
              <run bold='true' fontalignment='0'>Non - Food Exclusive Deal Discount :  </run>
              <run fontalignment='0'>non -food exclusive deal discount
</run>
              <run bold='true' fontalignment='0'>% Vendor Funded Discount : </run>
              <run fontalignment='0'> vendor funded non - food exclusive deal discount</run>
              <run bold='true' fontalignment='0'> / </run>
              <run fontalignment='0'>non</run>
              <run bold='true' fontalignment='0'> - </run>
              <run fontalignment='0'>food exclusive deal discount&#10;</run>
              <run bold='true' fontalignment='0'>% Talabat Funded Discount : : </run>
              <run fontalignment='0'> talabat  funded non - food exclusive deal discount</run>
              <run bold='true' fontalignment='0'> / </run>
              <run fontalignment='0'>non</run>
              <run bold='true' fontalignment='0'> - </run>
              <run fontalignment='0'>food exclusive deal discount&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f1f0' />
            </zone-style>
