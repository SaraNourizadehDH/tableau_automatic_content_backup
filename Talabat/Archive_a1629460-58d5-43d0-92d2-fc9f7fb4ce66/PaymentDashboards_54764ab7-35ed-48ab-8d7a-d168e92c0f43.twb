              <relation connection='bigquery.0gzh86w02xa5ez13ciqij05pq5dp' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
(with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;
and st.is_test=false
and st.is_canceled_by_fraud_shield=false
),
totals
as 
