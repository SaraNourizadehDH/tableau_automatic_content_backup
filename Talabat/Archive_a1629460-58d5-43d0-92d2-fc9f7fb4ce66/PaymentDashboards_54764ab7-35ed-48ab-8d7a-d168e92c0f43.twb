      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Verticals' id='_74DF9A2989D74E09A3DCD7F218A7708A'>
            <properties context=''>
              <relation connection='bigquery.0c1qg2q1ioeuqz16m1a750itqi6s' name='Custom SQL Query' type='text'>select c.country,
safe_cast(date_trunc(a.order_date, month) AS date) as month,
e.payment_method,
b.vertical_class,
b.vertical,
count(*) as orders_count,
avg(a.gmv_amount_lc) avg_gmv_amount_lc,
avg(gmv_amount_eur) avg_gmv_amount_eur,
sum(a.gmv_amount_lc) total_gmv_amount_lc,
sum(a.gmv_amount_eur) total_gmv_amount_eur
from `tlb-data-prod.data_platform.fct_order_info` a
left join `tlb-data-prod.data_platform.dim_country_info` c on (a.country_id=c.country_id)
left join `tlb-data-prod.data_platform.dim_vertical` b on (a.vertical_id=b.vertical_id)
left join `tlb-data-prod.data_platform.dim_order_status` d on (a.order_status_id=d.order_status_id)
left join `tlb-data-prod.data_platform.dim_payment_method` e on (e.payment_method_id=a.payment_method_id)
where a.payment_method_id in (13 , 23)
And d.status=&apos;SUCCESS&apos;
and a.order_date&gt;&gt;=&apos;2021-01-01&apos;
group by 1,2,3,4,5
order by 2 desc</relation>
            </properties>
          </object>
          <object caption='Transactions counts' id='_D1C9A87C1F174966ACEFC2C1CC2D0FB7'>
            <properties context=''>
              <relation connection='bigquery.0c1qg2q1ioeuqz16m1a750itqi6s' name='Custom SQL Query1' type='text'>select a.date_utc, b.country, c.transaction_type_name,e.payment_method ,
count(*) transactions_count,
sum(a.amount_lc) wallet_amount_lc,
sum(a.amount_eur) as wallet_amount_eur,
avg(d.gmv_amount_lc) avg_gmv_amount_lc,
avg(d.gmv_amount_eur) avg_gmv_amount_eur
from tlb-data-prod.data_platform.fct_wallet_transaction a
left join tlb-data-prod.data_platform.dim_country_info b on (a.country_id=b.country_id)
left join tlb-data-prod.data_platform.dim_wallet_transaction_type c on (a.transaction_type_id=c.transaction_type_id)
left join tlb-data-prod.data_platform.fct_order_info d on (a.order_id=d.order_id and a.transaction_type_id=0)
left join tlb-data-prod.data_platform.dim_payment_method e on (e.payment_method_id=d.payment_method_id)
where a.date_utc&gt;&gt;=&apos;2021-01-01&apos; 
group by 1,2,3,4</relation>
            </properties>
          </object>
        </objects>
