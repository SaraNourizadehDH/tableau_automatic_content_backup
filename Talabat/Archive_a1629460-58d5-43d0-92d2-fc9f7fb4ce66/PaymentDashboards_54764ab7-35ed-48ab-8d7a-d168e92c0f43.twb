            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xw038o0bnt5yr1en17ut0j6yz11'>
            <column caption='Date' datatype='datetime' name='[Calculation_3368833299723415552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] =&apos;Daily&apos; then [order_date]&#10;elseif [Parameters].[Parameter 1] =&apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[order_date])&#10;elseif [Parameters].[Parameter 1] =&apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[order_date])&#10;end' />
            </column>
