b.transaction_id, 
a.gmv_amount_lc, 
a.gmv_amount_eur,
coalesce(b.customer_balance_after_lc,0) as wallet_balance_before_order, 
row_number() OVER (PARTITION BY b.account_id, a.order_id ORDER BY b.created_time_utc desc) as row_number 
from `tlb-data-prod.data_platform.fct_order_info` a 
join `tlb-data-prod.data_platform.dim_order_status` st  on (a.order_status_id=st.order_status_id and st.status='SUCCESS')
left join `tlb-data-prod.data_platform.fct_wallet_transaction` b on (a.account_id=b.account_id 
and timestamp(b.created_time_utc)<<a.order_time_utc) 
where  a.order_date>>='2022-08-01'
and st.status = 'SUCCESS'
and st.is_test=false
and st.is_canceled_by_fraud_shield=false
),
totals
as 
(select  
order_date, 
country_id,  
count(*) total_count_per_day, 
sum(gmv_amount_eur) as total_gmv_eur_per_day
from success_orders a
where (a.row_number=1 and wallet_balance_before_order>>0)
group by 1,2), 
counts as (
SELECT  
a.order_date ,
c.country, 
case when a.payment_method_id=60 then 'talabat Pay,Card' else 
payment_method
end as payment_method,  
d.total_count_per_day, 
d.total_gmv_eur_per_day,
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur, 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c, 
totals d 
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
and a.order_date=d.order_date 
and a.country_id=d.country_id
and (a.row_number=1 and wallet_balance_before_order>>0)
group by 1 ,2,3,4,5) 
select * ,
payment_method_total_count/total_count_per_day payment_method_order_count_percentage,
payment_method_total_gmv_amount_eur/total_gmv_eur_per_day payment_method_gmv_percentage
from counts)
union all 
(
with success_orders as 
(select a.order_date,
a.order_time_utc,
a.order_id, 
a.payment_method_id,
a.account_id, 
a.country_id , 
b.created_time_utc,
b.transaction_id, 
a.gmv_amount_lc, 
a.gmv_amount_eur,
coalesce(b.customer_balance_after_lc,0) as wallet_balance_before_order, 
row_number() OVER (PARTITION BY b.account_id, a.order_id ORDER BY b.created_time_utc desc) as row_number 
from `tlb-data-prod.data_platform.fct_order_info` a 
join `tlb-data-prod.data_platform.dim_order_status` st  on (a.order_status_id=st.order_status_id and st.status='SUCCESS')
left join `tlb-data-prod.data_platform.fct_wallet_transaction` b on (a.account_id=b.account_id 
and timestamp(b.created_time_utc)<<a.order_time_utc) 
where a.order_date>>='2022-08-01'
and st.status = 'SUCCESS'
and st.is_test=false
and st.is_canceled_by_fraud_shield=false),
totals
as 
(select  
order_date, 
count(*) total_count_per_day, 
sum(gmv_amount_eur) as total_gmv_eur_per_day
from success_orders
where  (row_number=1 and wallet_balance_before_order>>0)
group by 1), 
counts as (
SELECT  
a.order_date ,
'ALL countries' country,
case when a.payment_method_id=60 then 'talabat Pay,Card' else 
payment_method
end as payment_method, 
d.total_count_per_day, 
d.total_gmv_eur_per_day,
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur, 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
totals d 
where a.payment_method_id=b.payment_method_id
and a.order_date=d.order_date 
and  (a.row_number=1 and wallet_balance_before_order>>0)
group by 1 ,2,3,4,5) 
select * ,
payment_method_total_count/total_count_per_day payment_method_order_count_percentage,
payment_method_total_gmv_amount_eur/total_gmv_eur_per_day payment_method_gmv_percentage
from counts
)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
