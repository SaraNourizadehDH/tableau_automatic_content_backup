      <_.fcp.ObjectModelTableType.true...column caption='Verticals' datatype='table' name='[__tableau_internal_object_id__].[_9AA76EAF1613453088AA93052FAD35BE]' role='measure' type='quantitative' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
