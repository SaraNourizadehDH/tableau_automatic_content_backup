      <column caption='total_wallet_gmv_percentage1' datatype='real' name='[Calculation_3427028217009414145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([wallet_gmv_eur]+[wallet_mixed_payment_gmv_eur])/sum([total_gmv_amount_eur])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Payment method daily' datatype='table' name='[__tableau_internal_object_id__].[_9F6B1EA641E74BE282F691F628C61AFB]' role='measure' type='quantitative' />
