sum(gmv_amount_eur) as total_gmv_eur_per_day
from success_orders
group by 1,2), 
counts as (
SELECT  
a.order_date ,
c.country, 
case when a.payment_method_id=60 then &apos;talabat Pay,Card&apos;
     WHEN b.digital_wallet =&apos;Apple Pay&apos; THEN &apos;Apple Pay&apos;
 else 
payment_method
end as payment_method,  
d.total_count_per_day, 
d.total_gmv_eur_per_day,
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur, 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c, 
totals d 
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
and a.order_date=d.order_date 
and a.country_id=d.country_id
group by 1 ,2,3,4,5) 
select * ,
payment_method_total_count/total_count_per_day payment_method_order_count_percentage,
