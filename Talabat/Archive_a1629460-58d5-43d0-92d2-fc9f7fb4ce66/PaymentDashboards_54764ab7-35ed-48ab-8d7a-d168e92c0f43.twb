            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='svetlana.miroshnikova@talabat.com' workgroup-auth-mode='prompt' />
