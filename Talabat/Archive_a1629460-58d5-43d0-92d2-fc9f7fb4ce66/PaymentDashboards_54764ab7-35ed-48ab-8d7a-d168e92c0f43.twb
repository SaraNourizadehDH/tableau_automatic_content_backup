    <datasource caption='Payment_share_for_users_with_credit' inline='true' name='federated.0nwngkv14guaz51gei18b0qf4vdz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1flueev13zh9sw10x7faa1bpqs8g'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='svetlana.miroshnikova@talabat.com' workgroup-auth-mode='prompt' />
