      <aliases enabled='yes' />
      <column caption='Calculation1 (copy)' datatype='integer' name='[Calculation1 (copy)_6946098765882167297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([main_cuisine])' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_1499839440101605381]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(&#10;sum(if MONTH([month]) = 12 then [weighted_monthly_price] else null&#10;end )&#10;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show 0% Price Index' datatype='boolean' name='[Calculation_1499839440400023562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ZN(SUM([weighted_monthly_price])), FIRST()) = LOOKUP(ZN(SUM([weighted_monthly_price])), LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='increased/decreased' datatype='string' name='[Calculation_1499839440414486540]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [weighted_monthly_price_last (copy)_1499839440108388361] &gt; 0 then &quot;increased&quot; else &quot;decreased&quot; END' />
      </column>
      <column caption='Country Breakdown' datatype='string' name='[Calculation_1499839440432660494]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] then [country_name] else &apos;all&apos; END' />
      </column>
      <column caption='Vendors' datatype='integer' name='[Calculation_1520387114499264512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Text 1' datatype='string' name='[Calculation_1520387114500067329]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if COUNTD([main_cuisine]) = 1 and COUNTD([vendor_name]) &gt; 1 and [Parameters].[Parameter 2] != &quot;Cuisine&quot;&#10;then &#10;&#10;&quot;- Comparing &quot; +&#10;MAX([main_cuisine])&#10;+&#10;&quot; vendor weighted monthly price evolution against the &quot; + [Parameters].[Parameter 2] &#10;+ &quot; evolution.&quot;&#10;&#10;ELSEIF COUNTD([main_cuisine]) = 1 and COUNTD([vendor_name]) = 1&#10;then&#10;&quot;- Comparing &quot; +&#10;MAX([vendor_name])&#10;+&#10;&quot; cuisine weighted monthly price evolution against the &quot; + [Parameters].[Parameter 2] &#10;+ &quot; evolution.&quot;&#10;&#10;else null&#10;END' />
      </column>
      <column caption='Selected Measure' datatype='real' name='[Calculation_512917809025437697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &apos;Orders&apos; then [Orders]&#10;WHEN &apos;GMV&apos; then [GMV]&#10;WHEN &apos;ABS&apos; then [ABS]&#10;WHEN &apos;AOV&apos; then [AOV]&#10;WHEN &apos;AOF&apos; then NULL&#10;&#10;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_6946098765882089472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_name])' />
      </column>
      <column datatype='real' name='[Orders]' role='measure' type='quantitative' />
