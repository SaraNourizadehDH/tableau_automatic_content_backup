            <column-instance column='[main_cuisine]' derivation='None' name='[none:main_cuisine:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[weighted_monthly_price (copy)_1499839440074084355]' derivation='Attribute' name='[pcdf:attr:weighted_monthly_price (copy)_1499839440074084355:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-2</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[weighted_monthly_price]' derivation='Sum' name='[pcdf:sum:weighted_monthly_price:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.12182r1042ivwc13g4lhe15sghbx].[month]' ordering-type='Field' type='PctDiff'>
