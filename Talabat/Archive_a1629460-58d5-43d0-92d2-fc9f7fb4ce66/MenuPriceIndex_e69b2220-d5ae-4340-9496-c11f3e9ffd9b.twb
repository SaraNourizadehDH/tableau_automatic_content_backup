            <column datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
            <column caption='weighted_monthly_price (compare)' datatype='real' name='[weighted_monthly_price (copy)_1499839440074084355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;Country&apos; then&#10;{ fixed  [month], [country_name]: &#10;SUM([weighted_monthly_price])&#10;}&#10;when &apos;Cuisine&apos; then&#10;{ fixed [main_cuisine], [month], [country_name]: &#10;SUM([weighted_monthly_price])&#10;}&#10;when &apos;AAA Vendors&apos; then&#10;{ fixed [main_cuisine], [month], [country_name]: &#10;SUM(if [is_key_vip_account] = 1 THEN [weighted_monthly_price] END)&#10;}&#10;END' />
            </column>
            <column datatype='real' name='[weighted_monthly_price]' role='measure' type='quantitative' />
          </datasource-dependencies>
