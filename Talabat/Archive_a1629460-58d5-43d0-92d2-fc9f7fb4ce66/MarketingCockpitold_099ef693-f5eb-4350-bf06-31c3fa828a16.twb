            <column caption='segment class count' datatype='integer' name='[Calculation_4639059522534084624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment_class] in (&apos;Churn&apos;,&apos;Inactive&apos;,&apos;Lost&apos;,&apos;Soft Churn&apos;) then -1 *[count]&#10;else [count] end' />
            </column>
            <column datatype='integer' name='[count]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[entity_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[flag]' role='dimension' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity_type]' derivation='None' name='[none:entity_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[flag]' derivation='None' name='[none:flag:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment_class]' derivation='None' name='[none:segment_class:nk]' pivot='key' type='nominal' />
            <column caption='churn rate' datatype='real' name='[segment class count (copy)_4639059522535931922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if max([segment_class]) in (&apos;Churn&apos;,&apos;Inactive&apos;,&apos;Lost&apos;,&apos;Soft Churn&apos;) then sum([count])end/&#10;total(sum([count]))'>
