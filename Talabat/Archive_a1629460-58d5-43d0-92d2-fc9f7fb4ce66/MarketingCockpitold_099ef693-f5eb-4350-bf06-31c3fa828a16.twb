        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03f0wpk1t39ivb124vvns1tefg7g' name='Custom SQL Query' type='text'>with orders
as(
  select
  distinct
    oi.analytical_customer_id,
    oi.order_date,
    date_trunc(oi.order_date, month) month,
    case
      when is_darkstore then &apos;tmart&apos;
      when is_non_food then &apos;LS&apos;
      else &apos;food&apos; end as verticall,
    oi.order_id,
    oi.country_code,
    is_darkstore,
    is_non_food,
    is_acquisition,
  from `tlb-data-prod.data_platform.fct_order_info` oi
  where order_date &gt;&gt;=  date_sub(date_trunc(current_date(),month),interval 12 month)
    and is_successful and analytical_customer_id is not null
    and not is_test
  group by all
),

mv_flagging as(
  select  
    month,
    country_code,
    analytical_customer_id,
    string_agg(verticall, &apos;,&apos; order by verticall) mv, 
  from(
    select
      distinct 
        month,
        country_code,
        analytical_customer_id,
        verticall,
    from orders
    )
    group by all
),

mv as (
  select
    month,
    country_code,
    mv,
    count(distinct analytical_customer_id) mv_acids,
  from mv_flagging
  group by all
  order by 1,2,3
)
select *
from mv</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
