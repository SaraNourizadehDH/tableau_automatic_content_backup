        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.09rc3ey1bmlin8185eh0m1oiovtd' name='Custom SQL Query' type='text'>select 
  overall_acquisition_order_date,
  snapshot_date as month,
  growth_incentive_ratio_segment,
  growth_order_segment,
  date_diff(snapshot_date,overall_acquisition_order_date, month) as tenure,
  count(distinct analytical_customer_id) acids,
  sum(order_success_count) orders,
  sum(order_food_count) food_orders,
  sum(order_non_food_count) non_food_orders,
  sum(order_darkstore_count) darkstore_orders,
  
from `tlb-data-prod.data_platform.agg_customer_profile_monthly`  
-- where overall_acquisition_order_date =&apos;2024-1-1&apos;
-- and snapshot_date = &apos;2024-4-1&apos;
group by all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
