    <worksheet name='tenure retention rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='customer_monthly /segmentation' name='federated.0u0753513d06uz1ab8e9x1bmses2' />
          </datasources>
          <datasource-dependencies datasource='federated.0u0753513d06uz1ab8e9x1bmses2'>
            <column caption='Retention Rate' datatype='real' name='[Calculation_4639059522208370700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if&#10;(ZN(SUM([acids])) - LOOKUP(ZN(SUM([acids])), FIRST())) /&#10; ABS(LOOKUP(ZN(SUM([acids])), FIRST()))&#10;= -1 &#10;or (ZN(SUM([acids])) - LOOKUP(ZN(SUM([acids])), FIRST())) /&#10; ABS(LOOKUP(ZN(SUM([acids])), FIRST()))&#10;= 0&#10;then null&#10;else &#10;1-((LOOKUP(ZN(SUM([acids])), FIRST()) - ZN(SUM([acids]))) /&#10; ABS(LOOKUP(ZN(SUM([acids])), FIRST())))&#10;end'>
