      <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.16iev0b0tdq0wk151d93c1lpog3s].[month]' caption='Select month' datatype='date' default-format='*mmm-yy' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2024-08-01#'>
          <calculation class='tableau' formula='#2024-08-01#' />
        </column>
        <column caption='Select Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
          <calculation class='tableau' formula='&quot;Orders&quot;' />
        </column>
        <column caption='Select County Measure' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
          <calculation class='tableau' formula='&quot;Orders&quot;' />
          <aliases>
            <alias key='&quot;tpro Subs&quot;' value='tpro Subscribers' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2F698030EF3F47ACA6226DC9F586AB4C'>
            <properties context=''>
              <relation connection='bigquery.1a56zrh05mo7cr1d0ydla1jxoxnl' name='Custom SQL Query' type='text'>with orders
as(
  select
    oi.analytical_customer_id,
    oi.order_date,
    date_trunc(oi.order_date, month) month,
    case 
      when is_darkstore then &apos;tmart&apos;
      when is_non_food then &apos;LS&apos;
      else &apos;food&apos; end as verticall,
    case when is_non_food then &apos;QC&apos; else &apos;food&apos; end as vertical_class, 
    oi.order_id,
    oi.is_non_food,
    oi.is_darkstore,
    oi.account_id,
    oi.country_code,
    oi.is_acquisition,
    oi.gmv_amount_eur,
    oi.is_tpro_order,
    case when not is_acquisition then 
      ifnull(date_diff(order_date, lag(order_date) over(partition by analytical_customer_id order by order_date) ,month),3) end &gt;&gt;=2 as churned_flag,
  from `tlb-data-prod.data_platform.fct_order_info` oi
  where order_date &gt;&gt;=  date_sub(date_trunc(current_date(),month),interval 13 month)
    and is_successful
    and not is_test
),


orders_agg as(
  select
    month,
    country_code,
    if(grouping(verticall) = 1, &apos;All&apos;, verticall) as vertical,
    -- vertical,
    -- vertical_class,
    count(distinct analytical_customer_id) vertical_mau,
    count(order_id) vertical_orders,
    sum(gmv_amount_eur) vertical_gmv,
    count(distinct case when vertical_class = &apos;QC&apos; then analytical_customer_id end) as qc_mau,
    count(distinct case when is_acquisition then analytical_customer_id end) acquisitions,
    count(distinct case when churned_flag then analytical_customer_id end) reactivated,
  from orders
  where month &gt;&gt;= date_sub(date_trunc(current_date(),month),interval 12 month)
  group by rollup  (1,2,verticall)
  having country_code is not null
),

-- overall_orders_agg as(
--   select
--     month,
--     country_code,
--     count(distinct analytical_customer_id) mau,
--     count(distinct case when is_acquisition then analytical_customer_id end) acquisitions,
--     count(distinct case when churned_flag then analytical_customer_id end) reactivated,
--     count(order_id) orders,
--     sum(gmv_amount_eur) gmv,
--   from orders
--   where month &gt;&gt;= &apos;2024-1-1&apos;
--   group by 1,2
-- ),


next_month as(
  select distinct
    analytical_customer_id,
    country_code,
    month as active_month,
    date_add(month, interval 1 month) as plus_one,
    is_acquisition
  from orders --and analytical_customer_id =&apos;3C2lBtgsQjmoZ990_IQhJw&apos;
),

blended_churn as(
  select
    date_add(s.active_month, interval 1 month) as month,
    s.country_code,
    &apos;All&apos; as vertical,
    count(distinct t.analytical_customer_id) as retained_acids,
    count(distinct case when t.analytical_customer_id is null then s.analytical_customer_id end) as churned_acids,
    round(1 -
      (count(distinct t.analytical_customer_id) / count(distinct s.analytical_customer_id)), 4) * 100 as blended_churn_ratio,  
  from next_month s
  left join next_month t
    on s.analytical_customer_id = t.analytical_customer_id
    and s.plus_one = t.active_month
  group by 1,2
),

m1_freq as (
  select 
    t.month as month,
    s.country_code,
    &apos;All&apos; as vertical,
    count(distinct t.order_id) as m1_orders,
    count(distinct t.analytical_customer_id) as m1_acids,
    safe_divide(count(distinct t.order_id), count(distinct t.analytical_customer_id)) as m1_freq
  from next_month s
  join orders t
    on s.analytical_customer_id = t.analytical_customer_id
    and s.plus_one = date_trunc(t.order_date,month)
  where s.is_acquisition
  group by 1,2
),

tpro 
as (
  select
    month,
    country_code,
    &apos;All&apos; as vertical,
    round(safe_divide(sum(active_subscribers),sum(talabat_active)) * 100, 2) as tpro_adoption_share,
    sum(active_subscribers) active_subscribers,
    sum(talabat_active) talabat_active,
  from(
      select
        date_trunc(date, month) as month,
        country_code,
        sum(tpro_regular_subscriber_count) as active_subscribers,
        avg(talabat_active_user_count) as talabat_active
      from `tlb-data-prod.data_platform.agg_tpro_order_contribution`
      where aggregation_level = &apos;Monthly&apos;
        and date &gt;&gt;= date_sub(date_trunc(current_date(),month),interval 12 month)
      group by 1,2
    )
  group by all
),

segmentation as (
  SELECT
      DATE_TRUNC(fs.valid_from, MONTH) AS month,
      fs.country_code,
      &apos;All&apos; as vertical,
      COUNT(DISTINCT IF(dim.segment_class = &apos;Inactive&apos;, fs.entity_id, NULL)) AS inactive_acids,
      COUNT(DISTINCT IF(dim.segment_class = &apos;Lost&apos;, fs.entity_id, NULL)) AS lost_acids,
  FROM `tlb-data-prod.data_platform.fct_segmentation` fs
      INNER JOIN `tlb-data-prod.data_platform.dim_segment` dim
          USING (segment_id)
      INNER JOIN `tlb-data-prod.data_platform.dim_segment_entity_type` typ
          USING (entity_type_id)
  WHERE dim.segment_model_name = &apos;Customer Lifecycle Segmentation&apos;
      AND DATE_TRUNC(fs.valid_from, MONTH) &gt;&gt;= date_sub(date_trunc(current_date(),month),interval 12 month)
      AND COALESCE(fs.country_code, &apos;NA&apos;) NOT IN (&apos;SA&apos;, &apos;NA&apos;, &apos;LB&apos;)
      and segment_class in (&quot;Lost&quot;,&apos;Inactive&apos;)
      and entity_type = &apos;analytical_customer_id&apos;
  GROUP BY all
)
select *
from orders_agg
left join blended_churn
  using(month,country_code,vertical)
left join m1_freq
  using(month,country_code,vertical)
left join tpro
  using(month,country_code,vertical)
left join segmentation
  using(month,country_code,vertical)
where month != date_trunc(current_date(),month)
order by 1,2</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='segments' inline='true' name='federated.1bw4nzb1y6m1js14tk2ip0nvpzm4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0eyi3jv0jm1tm11czkqwq16fzn41'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='bassel.salaas@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0eyi3jv0jm1tm11czkqwq16fzn41' name='Custom SQL Query' type='text'>with segments
as(
    SELECT
        -- DATE_TRUNC(fs.valid_from, MONTH) AS month,
        fs.valid_from,
        fs.country_code,
        dim.segment_class,
        dim.segment_name,
        -- case
        --     when segment_class in(&apos;Churn&apos;,&apos;Soft Churn&apos;) then &apos;Churn&apos;
        --     else segment_class
        -- end as customer_class
        -- case
        --     when segment_class = &apos;Active Customer&apos; then segment_class
        --     when segment_class = &apos;Churn&apos; then segment_class
        --     when segment_class = &apos;Active Customer&apos; then segment_class
        -- end as customer_segment,
        entity_type,
        entity_id,
    FROM `tlb-data-prod.data_platform.fct_segmentation` fs
        INNER JOIN `tlb-data-prod.data_platform.dim_segment` dim
            USING (segment_id)
        INNER JOIN `tlb-data-prod.data_platform.dim_segment_entity_type` typ
            USING (entity_type_id)
    WHERE dim.segment_model_name = &apos;Customer Lifecycle Segmentation&apos;
        AND DATE_TRUNC(fs.valid_from, MONTH) &gt;&gt;=&apos;2024-1-1&apos;
        AND COALESCE(fs.country_code, &apos;NA&apos;) NOT IN (&apos;SA&apos;, &apos;NA&apos;, &apos;LB&apos;)
    -- limit 9999
),

month_agg 
as(
    select 
        &apos;month_agg&apos; as flag,
        date_trunc(valid_from, month) month,
        country_code,
        segment_class,
        segment_name,
        entity_type,
        count(distinct entity_id) count,
    from segments
    group by all
    order by 1,2,3
),

first_day 
as(
     select 
        &apos;first_day&apos; as flag,
        date_trunc(valid_from, month) month,
        country_code,
        segment_class,
        segment_name,
        entity_type,
        count(distinct entity_id) count,
    from segments
    where extract(day from valid_from) = 1
    group by all
    order by 1,2,3
)

select * from month_agg
union all
select * from first_day</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0eyi3jv0jm1tm11czkqwq16fzn41' name='Custom SQL Query' type='text'>with segments
as(
    SELECT
        -- DATE_TRUNC(fs.valid_from, MONTH) AS month,
        fs.valid_from,
        fs.country_code,
        dim.segment_class,
        dim.segment_name,
        -- case
        --     when segment_class in(&apos;Churn&apos;,&apos;Soft Churn&apos;) then &apos;Churn&apos;
        --     else segment_class
        -- end as customer_class
        -- case
        --     when segment_class = &apos;Active Customer&apos; then segment_class
        --     when segment_class = &apos;Churn&apos; then segment_class
        --     when segment_class = &apos;Active Customer&apos; then segment_class
        -- end as customer_segment,
        entity_type,
        entity_id,
    FROM `tlb-data-prod.data_platform.fct_segmentation` fs
        INNER JOIN `tlb-data-prod.data_platform.dim_segment` dim
            USING (segment_id)
        INNER JOIN `tlb-data-prod.data_platform.dim_segment_entity_type` typ
            USING (entity_type_id)
    WHERE dim.segment_model_name = &apos;Customer Lifecycle Segmentation&apos;
        AND DATE_TRUNC(fs.valid_from, MONTH) &gt;&gt;=&apos;2024-1-1&apos;
        AND COALESCE(fs.country_code, &apos;NA&apos;) NOT IN (&apos;SA&apos;, &apos;NA&apos;, &apos;LB&apos;)
    -- limit 9999
),

month_agg 
as(
    select 
        &apos;month_agg&apos; as flag,
        date_trunc(valid_from, month) month,
        country_code,
        segment_class,
        segment_name,
        entity_type,
        count(distinct entity_id) count,
    from segments
    group by all
    order by 1,2,3
),

first_day 
as(
     select 
        &apos;first_day&apos; as flag,
        date_trunc(valid_from, month) month,
        country_code,
        segment_class,
        segment_name,
        entity_type,
        count(distinct entity_id) count,
    from segments
    where extract(day from valid_from) = 1
    group by all
    order by 1,2,3
)

select * from month_agg
union all
select * from first_day</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>flag</remote-name>
            <remote-type>130</remote-type>
            <local-name>[flag]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>flag</remote-alias>
            <local-type>string</local-type>
