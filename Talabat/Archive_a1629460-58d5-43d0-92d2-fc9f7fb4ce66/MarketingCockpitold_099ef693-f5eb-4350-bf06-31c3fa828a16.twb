    <worksheet name='customer life cycle test (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Customer life cycle and churn rate (by start of month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='segments' name='federated.1bw4nzb1y6m1js14tk2ip0nvpzm4' />
