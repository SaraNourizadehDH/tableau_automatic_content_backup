  WHERE 
    created_date &gt;&gt;= DATE_SUB( CURRENT_DATE(), INTERVAL 1 YEAR)
  AND 
  gfs_brands_tlb
  ORDER BY 2</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
