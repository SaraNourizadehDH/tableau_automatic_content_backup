    <datasource caption='GFS Vendor AVR' inline='true' name='federated.0wz02te0w0149619xeytw0pu9qo5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0tk44o50rq7w0p10p883y1bk4zod'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tk44o50rq7w0p10p883y1bk4zod' name='Custom SQL Query' type='text'>SELECT 
  avr.*,
  v.* EXCEPT(country_code)
  FROM `fulfillment-dwh-production.curated_data_shared.vendor_avr` avr
  LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on CAST(v.vendor_id AS STRING) = avr.vendor_code
  WHERE 
    created_date &gt;&gt;= DATE_SUB( CURRENT_DATE(), INTERVAL 1 YEAR)
  AND 
  gfs_brands_tlb
  ORDER BY 2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0tk44o50rq7w0p10p883y1bk4zod' name='Custom SQL Query' type='text'>SELECT 
