      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='gfs_vendor_avr_dtp' id='_261D4F8692A64747BC0E2F8904E759AE'>
            <properties context=''>
              <relation connection='bigquery.0tk44o50rq7w0p10p883y1bk4zod' name='Custom SQL Query' type='text'>SELECT 
  avr.*,
  v.* EXCEPT(country_code)
  FROM `fulfillment-dwh-production.curated_data_shared.vendor_avr` avr
  LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on CAST(v.vendor_id AS STRING) = avr.vendor_code
  WHERE 
    created_date &gt;&gt;= DATE_SUB( CURRENT_DATE(), INTERVAL 1 YEAR)
  AND 
  gfs_brands_tlb
  ORDER BY 2</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
