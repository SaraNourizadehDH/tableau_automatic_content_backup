        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dwpe4f10qdw8h1427eib0bwcaq5' name='Custom SQL Query' type='text'><![CDATA[WITH cumulative_metrics AS ( 
    SELECT 
        country_code,
        date AS dates_,
        MAX(CASE WHEN metric = 'is_mau' THEN holdout END) AS is_mau_holdout,
        MAX(CASE WHEN metric = 'is_mau' THEN rewards END) AS is_mau_rewards,
        MAX(CASE WHEN metric = 'is_mau' THEN relative_difference END) AS is_mau_relative_difference,
        MAX(CASE WHEN metric = 'is_mau' THEN corrected_p_vals END) AS is_mau_corrected_p_vals,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN holdout END) AS cumulative_sum_since_exposure_holdout,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN rewards END) AS cumulative_sum_since_exposure_rewards,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN relative_difference END) AS cumulative_sum_since_exposure_relative_difference,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN corrected_p_vals END) AS cumulative_corrected_p_vals
    FROM `tlb-data-prod.data_platform.loyalty_holdout_cumalative_result_daily`
    GROUP BY country_code, dates_
), 

reporting_date AS (
    SELECT 
        MAX(date) AS reporting_date 
    FROM (
        SELECT MAX(dates_) AS date 
        FROM cumulative_metrics 
        UNION ALL 
        SELECT MAX(date) AS date 
        FROM `tlb-data-prod.data_platform.loyalty_holdout_cumalative_result_daily`
    )
),

final_results AS (
    SELECT 
        a.* EXCEPT(Confidence_interval_frequency_28d_corrected, de_bq_write_timestamp),
        is_mau_holdout,
        is_mau_rewards,
        is_mau_relative_difference,
        is_mau_corrected_p_vals,
        cumulative_sum_since_exposure_holdout,
        cumulative_sum_since_exposure_rewards,
        cumulative_sum_since_exposure_relative_difference,
        cumulative_corrected_p_vals,
        r.reporting_date
    FROM `tlb-data-prod.data_platform.loyalty_holdout_frequency_result_daily` a
    LEFT JOIN cumulative_metrics b ON a.country_code = b.country_code AND a.dates_ = b.dates_
    CROSS JOIN reporting_date r
)

SELECT * FROM final_results where dates_ <<= reporting_date order by dates_ desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0dwpe4f10qdw8h1427eib0bwcaq5' name='Custom SQL Query' type='text'><![CDATA[WITH cumulative_metrics AS ( 
    SELECT 
        country_code,
        date AS dates_,
        MAX(CASE WHEN metric = 'is_mau' THEN holdout END) AS is_mau_holdout,
        MAX(CASE WHEN metric = 'is_mau' THEN rewards END) AS is_mau_rewards,
        MAX(CASE WHEN metric = 'is_mau' THEN relative_difference END) AS is_mau_relative_difference,
        MAX(CASE WHEN metric = 'is_mau' THEN corrected_p_vals END) AS is_mau_corrected_p_vals,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN holdout END) AS cumulative_sum_since_exposure_holdout,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN rewards END) AS cumulative_sum_since_exposure_rewards,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN relative_difference END) AS cumulative_sum_since_exposure_relative_difference,
        MAX(CASE WHEN metric = 'cumulative_sum_since_exposure' THEN corrected_p_vals END) AS cumulative_corrected_p_vals
    FROM `tlb-data-prod.data_platform.loyalty_holdout_cumalative_result_daily`
    GROUP BY country_code, dates_
), 

reporting_date AS (
    SELECT 
        MAX(date) AS reporting_date 
    FROM (
        SELECT MAX(dates_) AS date 
        FROM cumulative_metrics 
        UNION ALL 
        SELECT MAX(date) AS date 
        FROM `tlb-data-prod.data_platform.loyalty_holdout_cumalative_result_daily`
    )
),

final_results AS (
    SELECT 
        a.* EXCEPT(Confidence_interval_frequency_28d_corrected, de_bq_write_timestamp),
        is_mau_holdout,
        is_mau_rewards,
        is_mau_relative_difference,
        is_mau_corrected_p_vals,
        cumulative_sum_since_exposure_holdout,
        cumulative_sum_since_exposure_rewards,
        cumulative_sum_since_exposure_relative_difference,
        cumulative_corrected_p_vals,
        r.reporting_date
    FROM `tlb-data-prod.data_platform.loyalty_holdout_frequency_result_daily` a
    LEFT JOIN cumulative_metrics b ON a.country_code = b.country_code AND a.dates_ = b.dates_
    CROSS JOIN reporting_date r
)

SELECT * FROM final_results where dates_ <<= reporting_date order by dates_ desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
