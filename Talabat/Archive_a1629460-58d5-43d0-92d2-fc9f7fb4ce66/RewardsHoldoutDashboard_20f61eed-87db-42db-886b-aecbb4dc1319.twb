          <named-connection caption='BigQuery' name='bigquery.0dwpe4f10qdw8h1427eib0bwcaq5'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='amro.elnour@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
