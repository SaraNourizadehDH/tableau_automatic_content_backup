              <calculation class='tableau' formula='case [Parameters].[Measure I (copy)_4509510648678633523]&#10;//when &quot;CVR: Vendor List to Placed Order&quot; then [CVR: Vendor List to Placed Order]&#10;//when &quot;mCVR: Tile to Vendor List&quot; then [mCVR: Tile to Vendor List]&#10;//when &quot;mCVR: Vendor List to Enter Amount&quot; then [mCVR: Vendor List to Enter Amount]&#10;//when &quot;mCVR: Enter Amount to Checkout&quot; then [mCVR: Enter Amount to Checkout]&#10;//when &quot;mCVR: Checkout to Attempted Place Order&quot; then [mCVR: Checkout to Attempted Place Order]&#10;//when &quot;mCVR: Attempted Place Order to Placed Order&quot; then [mCVR: Attempted to Placed Order]&#10;when &quot;Tile Loaded&quot; then [Tile Loaded (copy)_4509510648673620013]&#10;when &quot;Vendor List Loaded&quot; then [Vendor List Loaded (copy)_4509510648673701934]&#10;when &quot;Enter Amount Loaded&quot; then [Enter Amount Loaded (copy)_4509510648673390634]&#10;when &quot;Checkout Loaded&quot; then [Checkout Loaded (copy)_4509510648673321001]&#10;when &quot;Attempted Place Order&quot; then [Calculation_4509510648673202216]&#10;when &quot;Placed Order&quot; then [Placed Order (copy)_4509510648673476652]&#10;when &quot;No. of Granted User&quot; then [Calculation_4509510648658337830]&#10;when &quot;Order Attempt Failed&quot; then [Calculation_4509510648658513959]&#10;when &quot;None&quot; then null&#10;&#10;END' />
