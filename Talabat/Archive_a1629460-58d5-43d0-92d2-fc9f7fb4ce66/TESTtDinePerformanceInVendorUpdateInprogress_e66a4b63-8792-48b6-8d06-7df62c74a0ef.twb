    <worksheet name='Engagement Metric Split'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt; </run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Bold' fontsize='9'>| &lt;[Parameters].[Parameter 7]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tDine - Order Performance' name='federated.0z2hchx15vq0eh1357q7y1ah4bsi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
            <column caption='Include EDR - City Walk ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
            <column caption='Split By' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mealtime&quot;'>
              <calculation class='tableau' formula='&quot;Mealtime&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Vendor Area' />
              </aliases>
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Users&quot;'>
              <calculation class='tableau' formula='&quot;Users&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z2hchx15vq0eh1357q7y1ah4bsi'>
            <column caption='Tpro discounted text' datatype='string' name='[Calculation_1398508442947874816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [tpro_discount] then &apos;Tpro discount&apos; else &apos;Normal discount&apos; end' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_1617425632457068544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [is_successful] then [order_id] end)' />
            </column>
            <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_1617425632710991893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
            </column>
            <column caption='Metric Split By' datatype='string' name='[Calculation_3596053945315020801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;None&apos; then &apos;no group&apos;&#10;elseif [Parameters].[Parameter 6]=&apos;Cuisine&apos; then [main_cuisine]&#10;elseif [Parameters].[Parameter 6]=&apos;Area&apos; then [area_name]&#10;elseif [Parameters].[Parameter 6]=&apos;Mealtime&apos; then [Calculation_536280212229771264]&#10;elseif [Parameters].[Parameter 6]=&apos;Discount Type&apos; then [Calculation_1398508442947874816]&#10;END' />
            </column>
            <column caption='Engagement Metric' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3596053945322942466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7]=&apos;Orders&apos; then [Calculation_1617425632457068544] &#10;elseif [Parameters].[Parameter 7]=&apos;GMV&apos; then [Successful Orders (copy)_1617425632458043397] &#10;elseif [Parameters].[Parameter 7]=&apos;Users&apos; then [Successful Orders (copy)_1617425632457306113]&#10;end' />
            </column>
            <column caption='Mealtime' datatype='string' name='[Calculation_536280212229771264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_time_hour]&gt;=7 and [order_time_hour]&lt;11 then &apos;Breakfast [7-11[&apos;&#10;elseif [order_time_hour]&gt;=11 and [order_time_hour]&lt;16 then &apos;Lunch [11-16[&apos;&#10;&#10;elseif [order_time_hour]&gt;=16 and [order_time_hour]&lt;18 then &apos;Snacks [16-18[&apos;&#10;&#10;elseif [order_time_hour]&gt;=18 and [order_time_hour]&lt;23 then &apos;Dinner [18-23[&apos;&#10;&#10;elseif [order_time_hour]&gt;=23 or [order_time_hour]&lt;7 then &apos;Late night [23-7[&apos;&#10;end' />
            </column>
            <column caption='Active Customers' datatype='integer' name='[Successful Orders (copy)_1617425632457306113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [is_successful] then [account_id] end)' />
            </column>
            <column caption='GMV Amount' datatype='real' name='[Successful Orders (copy)_1617425632458043397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [gmv_amount_lc] else [gmv_amount_eur] end)&#10;&#10;end)' />
            </column>
            <column aggregation='Sum' caption='Account ID' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
            <column caption='App Version' datatype='string' name='[app_version]' role='dimension' type='nominal' />
            <column caption='Vendor Area' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column caption='GMV Amount Eur' datatype='real' name='[gmv_amount_eur]' role='measure' type='quantitative' />
            <column caption='GMV Amount LC' datatype='real' name='[gmv_amount_lc]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_successful]' role='dimension' type='nominal' />
            <column caption='Is talabat employee' datatype='boolean' name='[is_talabat_employee]' role='dimension' type='nominal' />
            <column caption='Main Cuisine' datatype='string' name='[main_cuisine]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1617425632710991893]' derivation='None' name='[none:Calculation_1617425632710991893:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3596053945315020801]' derivation='None' name='[none:Calculation_3596053945315020801:nk]' pivot='key' type='nominal' />
            <column-instance column='[app_version]' derivation='None' name='[none:app_version:nk]' pivot='key' type='nominal' />
