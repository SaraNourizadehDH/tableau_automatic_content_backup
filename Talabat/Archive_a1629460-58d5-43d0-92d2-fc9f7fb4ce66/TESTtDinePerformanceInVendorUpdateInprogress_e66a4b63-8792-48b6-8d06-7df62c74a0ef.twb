    <worksheet name='Main KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='tDine - Order Performance' name='federated.0z2hchx15vq0eh1357q7y1ah4bsi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
            <column caption='Include EDR - City Walk ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z2hchx15vq0eh1357q7y1ah4bsi'>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_1617425632457068544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [is_successful] then [order_id] end)' />
            </column>
            <column caption='Customers with Multiple Orders' datatype='integer' name='[Calculation_1617425632457834500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if not [tdine_acquisition] and [is_successful] then [account_id] end)' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1617425632461279243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_1617425632458043397] / [Calculation_1617425632457068544]' />
            </column>
            <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_1617425632710991893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
            </column>
            <column caption='Discount %' datatype='real' default-format='p0.0%' name='[Calculation_1617425632813449251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful GMV (copy)_1617425632458588167] / ([Successful GMV (copy)_1617425632458588167]+[Successful Orders (copy)_1617425632458043397])' />
            </column>
            <column caption='Pre Discount GMV' datatype='real' name='[Calculation_1617425632817885220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_1617425632458043397] + [Successful GMV (copy)_1617425632458588167]' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Net Fail Rate, % (copy)_5225653323145191424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if ([parent_order_acceptance_status_detailed]=&apos;success with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;success with multiple attempts&apos;&#10;or&#10;[parent_order_acceptance_status_detailed]=&apos;recovery with different pm&apos;) and [is_parent_order]&#10;  then [order_id] end)&#10;/&#10;countd(if [is_parent_order] then  [parent_order_id] end)' />
            </column>
            <column caption='Discount Amount' datatype='real' name='[Successful GMV (copy)_1617425632458588167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [discount_amount_lc] else [discount_amount_eur] end)&#10;&#10;end)' />
            </column>
            <column caption='Active Customers' datatype='integer' name='[Successful Orders (copy)_1617425632457306113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [is_successful] then [account_id] end)' />
            </column>
            <column caption='GMV Amount' datatype='real' name='[Successful Orders (copy)_1617425632458043397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [gmv_amount_lc] else [gmv_amount_eur] end)&#10;&#10;end)' />
            </column>
