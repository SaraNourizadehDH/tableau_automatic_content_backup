    <datasource caption='tDine - Order Performance' inline='true' name='federated.0z2hchx15vq0eh1357q7y1ah4bsi' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0jlhxmi167xnh716jmmml0du619f'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='kulvan@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jlhxmi167xnh716jmmml0du619f' name='Custom SQL Query' type='text'>with employee_account_id as
(select distinct account_id from
-----employee identification - Mariam&apos;s code
  (select 
    distinct account_id
  from `tlb-data-prod.data_platform.dim_account` a
  inner join `tlb-data-prod.data_platform.dim_employee` b
    ON a.employee_id = b.employee_id
  where 
    is_inhouse
    and not is_agent
    and not is_bpo

  union all

  --extra users
  select 
    distinct id as account_id
  from `tlb-data-prod.data_platform_maindb.aspnetusers`
  where 
    email like &apos;%@talabat.com&apos;
    or email like &apos;%ismailova.aliia@gmail.com%&apos;
  )
), 
upm as (
  select backend_reference as order_id, min(response_message) payment_response_message
from `tlb-data-prod.data_platform.fct_payment_gateway_transaction`  a 
join `tlb-data-prod.data_platform.dim_payment_gateway_response` b on a.response_id=b.response_id
where payment_time&gt;&gt;=&apos;2023-06-01&apos;
group by 1
), 
tpro_discounted_orders as (
  select distinct  order_id
 from `tlb-data-prod.data_platform.sq_tdine_with_tpro_extra_discount_order`
)
-- select account_id, count(*) from employee_account_id group by 1 having count(*)&gt;&gt;1
,order_base_data as
(select 
  ord.order_date
  ,ord.country_code
  ,loc.location_id
  ,loc.city_name
  ,loc.area_id
  ,loc.area_name
  ,ord.delivery_arrangement
  ,ord.order_id
  ,ord.is_successful
  ,os.is_net
  ,case when os.is_net and not ord.is_successful then true else false end as net_failed_order
  ,ofr.owner as order_fail_owner
  ,ofr.reason as order_fail_talabat_reason
  
  ,case when ord.is_successful and ((row_number() over(partition by ord.account_id,ord.is_successful order by order_time))=1) then true else false end as tdine_acquisition
  
  ,ord.analytical_customer_id
  ,ord.account_id
  ,case when emp.account_id is null then false else true end as is_talabat_employee
  --
  ,ord.chain_id
  ,ch.chain_name
  ,ord.vendor_id
  ,v.vendor_name
  ,ver.vertical
  ,ver.sub_vertical
  ,v.is_everyday_roastery
  ,v.is_kitchen
  ,v.is_dh_kitchen
  ,ch.main_cuisine
  --
  ,ord.basket_amount_lc
  ,ord.basket_amount_eur
  ,ord.gmv_amount_lc
  ,ord.gmv_amount_eur
  ,ord.discount_amount_lc
  ,ord.discount_amount_eur
  ,ord.voucher_discount_amount_lc
  ,ord.voucher_discount_amount_eur
  ,ord.service_fee_amount_lc
  ,ord.service_fee_amount_eur
  ,ord.app_version
  , upm.payment_response_message
  ,po.parent_order_id
  ,po.parent_order_acceptance_status_detailed
  ,po.is_parent_order
  ,po.is_last_attempt
  , extract (hour from ord.order_time) order_time_hour
  , case when trim(lower(w.payment_method)) = &apos;credit card&apos; then  
        (case when trim(lower(w.digital_wallet)) = &apos;apple pay&apos; then &apos;Apple Pay&apos; 
              else &apos;Credit Card&apos;
          end)
      else w.payment_method 
    end as payment_method
  , case when ttf.order_id is not null then true else false end tpro_discount
from `tlb-data-prod.data_platform.fct_order_info` ord
left join `tlb-data-prod.data_platform.dim_vendor_info` v
  on ord.vendor_id = v.vendor_id
left join `tlb-data-prod.data_platform.dim_order_status` os
  on ord.order_status_id = os.order_status_id
left join `tlb-data-prod.data_platform.dim_chain` ch
  on ord.chain_id = ch.chain_id
left join `tlb-data-prod.data_platform.dim_vertical` ver
  on ord.vertical_id = ver.vertical_id
left join `tlb-data-prod.data_platform.dim_order_fail_reason` ofr
  on ord.order_fail_reason_id = ofr.order_fail_reason_id
left join `tlb-data-prod.data_platform.dim_location_info` loc
  on v.location_id = loc.location_id
left join `tlb-data-prod.data_platform.dim_payment_method` w 
  on (ord.payment_method_id=w.payment_method_id)
left join employee_account_id emp
  on ord.account_id = emp.account_id
left join upm 
  on upm.order_id=safe_cast(ord.order_id as string) 
left join `fulfillment-dwh-production.curated_data_shared_fintech.platform_orders` po 
  on global_entity_id=&apos;TB_AE&apos;
  and po.order_date&gt;&gt;=&apos;2023-06-01&apos; 
  and po.order_id=safe_cast(ord.order_id as string)
left join tpro_discounted_orders ttf 
  on ttf.order_id=ord.order_id 
where
  date_trunc(ord.order_date,month) &gt;&gt;= &apos;2023-06-01&apos;
  and ord.delivery_arrangement = &apos;TDINE&apos;
  and not ord.is_test
  and ord.order_id not in (1436564087, 1436568897)
)
select * from order_base_data</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
