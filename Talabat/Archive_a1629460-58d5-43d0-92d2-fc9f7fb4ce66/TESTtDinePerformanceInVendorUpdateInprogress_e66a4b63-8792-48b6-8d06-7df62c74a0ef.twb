            <column-instance column='[payment_method]' derivation='None' name='[none:payment_method:nk]' pivot='key' type='nominal' />
            <column-instance column='[tpro_discount]' derivation='None' name='[none:tpro_discount:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='Date' datatype='date' default-format='*dd-mmm-yy' name='[order_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Order ID' datatype='integer' name='[order_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[parent_order_acceptance_status_detailed]' role='dimension' type='nominal' />
