      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1D5F266F05FE4FD2BA528D0871C0D19A'>
            <properties context=''>
              <relation connection='bigquery.0s5duoz1azp1q211peu8b0n58uz2 (copy)' name='Custom SQL Query' type='text'><![CDATA[with week_agg as
(select 
  agg_level
  ,'week' as data_type
  ,date_trunc(date,week) date
  ,user_segment
  ,operating_system
  ,entry_point
  ,session_error
  ,session_error_category
  ,distance_category
  ,sum(tile_loaded) as tile_loaded
  ,sum(vendor_list_loaded) as vendor_list_loaded
  ,sum(filters_clicked) as filters_clicked
  ,sum(enter_amount_loaded) as enter_amount_loaded
  ,sum(checkout_loaded) as checkout_loaded
  ,sum(attempted_place_order) as attempted_place_order
  ,sum(order_attempt_failed) as order_attempt_failed
  ,sum(placed_order) as placed_order
  ,sum(filters_clicked_placed_order) as filters_clicked_placed_order
  ,sum(vendor_clicked_count) as vendor_clicked_count
  ,sum(granted_users) as granted_users

from `tlb-data-prod.data_platform_rest_tables.agg_session_tdine`
where 
  data_type = 'daily'
  and agg_level = 'session'
group by all
)

(select * from `tlb-data-prod.data_platform_rest_tables.agg_session_tdine` 
where
  agg_level = 'session'
  and data_type <<>> 'daily'

union all
select * from week_agg
)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
