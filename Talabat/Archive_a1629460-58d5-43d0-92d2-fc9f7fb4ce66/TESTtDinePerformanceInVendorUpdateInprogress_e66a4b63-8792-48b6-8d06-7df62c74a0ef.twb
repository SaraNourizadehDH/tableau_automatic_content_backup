      <aliases enabled='yes' />
      <column caption='Avg Basket Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AOV (copy)_5054657279723778056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful GMV (copy)_1617425632458452998] / [Calculation_1617425632457068544]' />
      </column>
      <column caption='Acceptance Failure Count' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Acceptance Failure Error (copy)_6526701035236478977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if ([parent_order_acceptance_status_detailed]=&apos;fail with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with multiple attempts&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with different pm&apos;&#10;) and [is_last_attempt] then [order_id] end)' />
      </column>
      <column caption='tDine Acquisitions' datatype='integer' name='[Active Customers (copy)_1617425632457392130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [tdine_acquisition] then [order_id] end)' />
      </column>
      <column caption='Net Fail Rate, %' datatype='real' default-format='p0.0%' name='[Active Customers (copy)_1617425632458788872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(&#10;count(if [net_failed_order] then [order_id] end)&#10;/&#10;count(if [is_net] then [order_id] end)&#10;)' />
      </column>
      <column caption='Tpro discounted text' datatype='string' name='[Calculation_1398508442947874816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [tpro_discount] then &apos;Tpro discount&apos; else &apos;Normal discount&apos; end' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_1617425632457068544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if [is_successful] then [order_id] end)' />
      </column>
      <column caption='Customers with Multiple Orders' datatype='integer' name='[Calculation_1617425632457834500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if not [tdine_acquisition] and [is_successful] then [account_id] end)' />
      </column>
      <column caption='Overall Fail Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1617425632459227146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Orders (copy)_1617425632459141129] / count([order_id])' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1617425632461279243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Orders (copy)_1617425632458043397] / [Calculation_1617425632457068544]' />
      </column>
      <column caption='Measure' datatype='real' default-format='n#,##0.0;(#,##0.0)' name='[Calculation_1617425632475475981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;when &quot;Successful Orders&quot; then [Calculation_1617425632457068544]&#10;when &quot;Successful GMV&quot; then [Successful Orders (copy)_1617425632458043397]&#10;when &quot;AOV&quot; then [Calculation_1617425632461279243]&#10;when &quot;Successful Basket Amount&quot; then [Successful GMV (copy)_1617425632458452998]&#10;when &quot;Discount Amount&quot; then [Successful GMV (copy)_1617425632458588167]&#10;when &quot;Failed Orders&quot; then [Successful Orders (copy)_1617425632459141129]&#10;//when &quot;Overall Fail Rate, %&quot; then [Overall Fail Rate, %]&#10;//when &quot;Net Fail Rate, %&quot; then [Net Fail Rate, %]&#10;when &quot;tDine Acquisitions&quot; then [Active Customers (copy)_1617425632457392130]&#10;when &quot;Active Customers&quot; then [Successful Orders (copy)_1617425632457306113]&#10;when &quot;Customers with Multiple Orders&quot; then [Calculation_1617425632457834500]&#10;end' />
      </column>
      <column caption='Report Date' datatype='datetime' default-format='*dd-mmm-yy' name='[Calculation_1617425632477896722]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Day&apos; then [Day]&#10;elseif [Parameters].[Parameter 4] = &apos;Week&apos; then datetrunc(&apos;week&apos;,[order_date],&apos;monday&apos;)&#10;elseif [Parameters].[Parameter 4] = &apos;Month&apos; then [Month]&#10;end' />
      </column>
      <column caption='Last 6 months' datatype='boolean' name='[Calculation_1617425632487514131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month] &gt;= DATEADD(&apos;month&apos;,-5,{max([Month])})' />
      </column>
      <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_1617425632710991893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
      </column>
      <column caption='Discount %' datatype='real' default-format='p0.0%' name='[Calculation_1617425632813449251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful GMV (copy)_1617425632458588167] / ([Successful GMV (copy)_1617425632458588167]+[Successful Orders (copy)_1617425632458043397])' />
      </column>
      <column caption='Pre Discount GMV' datatype='real' name='[Calculation_1617425632817885220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Orders (copy)_1617425632458043397] + [Successful GMV (copy)_1617425632458588167]' />
      </column>
      <column caption='Metric Split By' datatype='string' name='[Calculation_3596053945315020801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;None&apos; then &apos;no group&apos;&#10;elseif [Parameters].[Parameter 6]=&apos;Cuisine&apos; then [main_cuisine]&#10;elseif [Parameters].[Parameter 6]=&apos;Area&apos; then [area_name]&#10;elseif [Parameters].[Parameter 6]=&apos;Mealtime&apos; then [Calculation_536280212229771264]&#10;elseif [Parameters].[Parameter 6]=&apos;Discount Type&apos; then [Calculation_1398508442947874816]&#10;END' />
      </column>
      <column caption='Engagement Metric' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3596053945322942466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7]=&apos;Orders&apos; then [Calculation_1617425632457068544] &#10;elseif [Parameters].[Parameter 7]=&apos;GMV&apos; then [Successful Orders (copy)_1617425632458043397] &#10;elseif [Parameters].[Parameter 7]=&apos;Users&apos; then [Successful Orders (copy)_1617425632457306113]&#10;end' />
      </column>
      <column caption='Mealtime' datatype='string' name='[Calculation_536280212229771264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_time_hour]&gt;=7 and [order_time_hour]&lt;11 then &apos;Breakfast [7-11[&apos;&#10;elseif [order_time_hour]&gt;=11 and [order_time_hour]&lt;16 then &apos;Lunch [11-16[&apos;&#10;&#10;elseif [order_time_hour]&gt;=16 and [order_time_hour]&lt;18 then &apos;Snacks [16-18[&apos;&#10;&#10;elseif [order_time_hour]&gt;=18 and [order_time_hour]&lt;23 then &apos;Dinner [18-23[&apos;&#10;&#10;elseif [order_time_hour]&gt;=23 or [order_time_hour]&lt;7 then &apos;Late night [23-7[&apos;&#10;end' />
      </column>
      <column caption='Acceptance Failure Error' datatype='string' name='[Calculation_6526701035235819520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([parent_order_acceptance_status_detailed]=&apos;fail with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with multiple attempts&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with different pm&apos;&#10;) and [is_last_attempt] then [payment_response_message] end' />
      </column>
