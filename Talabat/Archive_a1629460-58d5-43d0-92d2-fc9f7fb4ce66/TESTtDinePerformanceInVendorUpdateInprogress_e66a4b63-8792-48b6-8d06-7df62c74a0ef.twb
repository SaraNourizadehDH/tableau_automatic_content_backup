        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0mpcal9058pclz1cx7a9b1jh4klb' name='Custom SQL Query' type='text'>SELECT 
  t1.vendor_id
  ,t1.vendor_name
  ,t1.country_code
  ,t2.city_name as city
  ,t2.area_name as vendor_area
  ,t3.main_cuisine
  ,st_x(t1.location) as longitude
  ,st_y(t1.location) as latitude

from `tlb-data-prod.data_platform.dim_vendor_info` t1
left join `tlb-data-prod.data_platform.dim_location_info` t2
  on t1.location_id = t2.location_id
left join `tlb-data-prod.data_platform.dim_chain` t3
  on t1.chain_id = t3.chain_id
where t1.is_dineout</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0mpcal9058pclz1cx7a9b1jh4klb' name='Custom SQL Query' type='text'>SELECT 
  t1.vendor_id
  ,t1.vendor_name
  ,t1.country_code
  ,t2.city_name as city
  ,t2.area_name as vendor_area
  ,t3.main_cuisine
  ,st_x(t1.location) as longitude
  ,st_y(t1.location) as latitude

from `tlb-data-prod.data_platform.dim_vendor_info` t1
left join `tlb-data-prod.data_platform.dim_location_info` t2
  on t1.location_id = t2.location_id
left join `tlb-data-prod.data_platform.dim_chain` t3
  on t1.chain_id = t3.chain_id
where t1.is_dineout</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
