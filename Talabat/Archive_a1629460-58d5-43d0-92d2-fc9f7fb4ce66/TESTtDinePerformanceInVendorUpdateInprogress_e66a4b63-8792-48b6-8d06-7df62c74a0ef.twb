      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tDine - Order Performance' name='federated.0z2hchx15vq0eh1357q7y1ah4bsi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Include EDR - City Walk ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z2hchx15vq0eh1357q7y1ah4bsi'>
            <column caption='Acceptance Failure Count' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Acceptance Failure Error (copy)_6526701035236478977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if ([parent_order_acceptance_status_detailed]=&apos;fail with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with multiple attempts&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with different pm&apos;&#10;) and [is_last_attempt] then [order_id] end)' />
            </column>
            <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_1617425632710991893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
            </column>
            <column caption='Acceptance Failure Error' datatype='string' name='[Calculation_6526701035235819520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([parent_order_acceptance_status_detailed]=&apos;fail with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with multiple attempts&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;fail with different pm&apos;&#10;) and [is_last_attempt] then [payment_response_message] end' />
            </column>
            <column caption='App Version' datatype='string' name='[app_version]' role='dimension' type='nominal' />
            <column caption='Vendor Area' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6526701035235819520]' derivation='Attribute' name='[attr:Calculation_6526701035235819520:nk]' pivot='key' type='nominal' />
            <column datatype='boolean' name='[is_last_attempt]' role='dimension' type='nominal' />
            <column caption='Is talabat employee' datatype='boolean' name='[is_talabat_employee]' role='dimension' type='nominal' />
            <column caption='Main Cuisine' datatype='string' name='[main_cuisine]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1617425632710991893]' derivation='None' name='[none:Calculation_1617425632710991893:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6526701035235819520]' derivation='None' name='[none:Calculation_6526701035235819520:nk]' pivot='key' type='nominal' />
            <column-instance column='[app_version]' derivation='None' name='[none:app_version:nk]' pivot='key' type='nominal' />
            <column-instance column='[area_name]' derivation='None' name='[none:area_name:nk]' pivot='key' type='nominal' />
