      </column>
      <column caption='Measure %' datatype='real' default-format='p0.0%' name='[Measure (copy)_1617425632475807758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;//when &quot;Successful Orders&quot; then [Successful Orders]&#10;//when &quot;Successful GMV&quot; then [Successful GMV]&#10;//when &quot;AOV&quot; then [AOV]&#10;//when &quot;Successful Basket Amount&quot; then [Successful Basket Amount]&#10;//when &quot;Discount Amount&quot; then [Discount Amount]&#10;//when &quot;Failed Orders&quot; then [Failed Orders]&#10;when &quot;Overall Fail Rate, %&quot; then [Calculation_1617425632459227146]&#10;when &quot;Net Fail Rate, %&quot; then [Active Customers (copy)_1617425632458788872]&#10;when &quot;Acceptance Rate&quot; then [Net Fail Rate, % (copy)_5225653323145191424]&#10;//when &quot;tDine Acquisitions&quot; then [tDine Acquisitions]&#10;//when &quot;Active Customers&quot; then [Active Customers]&#10;//when &quot;Customers with Multiple Orders&quot; then [Customers with Multiple Orders]&#10;end' />
      </column>
      <column datatype='date' name='[Month]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='order_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_date]))' />
      </column>
      <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Net Fail Rate, % (copy)_5225653323145191424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if ([parent_order_acceptance_status_detailed]=&apos;success with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;success with multiple attempts&apos;&#10;or&#10;[parent_order_acceptance_status_detailed]=&apos;recovery with different pm&apos;) and [is_parent_order]&#10;  then [order_id] end)&#10;/&#10;countd(if [is_parent_order] then  [parent_order_id] end)' />
      </column>
      <column caption='Successful Basket Amount' datatype='real' name='[Successful GMV (copy)_1617425632458452998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [basket_amount_lc] else [basket_amount_eur] end)&#10;&#10;end)' />
      </column>
      <column caption='Discount Amount' datatype='real' name='[Successful GMV (copy)_1617425632458588167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [discount_amount_lc] else [discount_amount_eur] end)&#10;&#10;end)' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Successful Orders (copy)_1617425632457306113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_successful] then [account_id] end)' />
