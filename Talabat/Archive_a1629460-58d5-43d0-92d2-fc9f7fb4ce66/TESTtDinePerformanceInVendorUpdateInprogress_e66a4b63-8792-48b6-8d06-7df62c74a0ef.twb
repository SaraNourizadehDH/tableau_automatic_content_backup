      <aliases enabled='yes' />
      <column caption='Avg Basket Amount' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_5054657279737585681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5054657279735771145])/[Calculation_5054657279735930890]' />
      </column>
      <column caption='Total Vendor Count' datatype='integer' name='[AOV (copy)_5054657279738339346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Size' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Avg Basket Amount (copy)_5883460349032886273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Commission Amount' datatype='real' name='[Basket Amount  (copy)_5054657279736000523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [commission_amount_lc] else [commission_amount_lc] END' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_3130212866064338945]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([date])}' />
      </column>
      <column caption='Churned Vendor Count' datatype='integer' name='[Calculation_3130212866065465346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[Total Vendor Count] - [Latest Vendor Count]&#10;&#10;countd(if [is_churned_vendor] then vendor_id end)' />
      </column>
      <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_3130212866066100227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
      </column>
      <column caption='Basket Amount ' datatype='real' name='[Calculation_5054657279735771145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [basket_amount_lc] else [basket_amount_lc] END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_5054657279735930890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_order_count])' />
      </column>
      <column caption='UiD' datatype='string' name='[Calculation_5883460349031235584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([country_id]) + &apos;--&apos; + str([area_id])' />
      </column>
      <column caption='Commissionable GMV' datatype='real' name='[Commission Amount (copy)_5054657279736188940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [commissionable_gmv_amount_lc] else [commissionable_gmv_amount_eur] END' />
      </column>
      <column caption='Discount Amount' datatype='real' name='[Commissionable GMV (copy)_5054657279736274957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [discount_amount_lc] else [discount_amount_eur] END' />
      </column>
      <column caption='GMV' datatype='real' name='[Discount Amount (copy)_5054657279736381454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [gmv_amount_lc] else [gmv_amount_eur] END' />
      </column>
      <column caption='Service Fee' datatype='real' name='[GMV (copy)_5054657279736451087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;LC&apos; then [service_fee_amount_lc] else [service_fee_amount_eur] END' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV (copy)_5054657279737483280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Discount Amount (copy)_5054657279736381454])/[Calculation_5054657279735930890]' />
      </column>
      <column caption='Latest Vendor Count' datatype='integer' name='[Total Vendor Count (copy)_3130212866064265216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [date] = [Calculation_3130212866064338945] then [vendor_id] end)' />
      </column>
      <column caption='Vendors with atleast 1 order' datatype='integer' name='[Total Vendor Count (copy)_5054657279738503187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if zn([successful_order_count])&gt;0 then [vendor_id] end)' />
      </column>
      <column caption='Total Vendor Count - fixed' datatype='integer' name='[Total Vendor Count (copy)_5883460349037256706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [vendor_area], [city] :&#10;COUNT([vendor_id])}' />
      </column>
