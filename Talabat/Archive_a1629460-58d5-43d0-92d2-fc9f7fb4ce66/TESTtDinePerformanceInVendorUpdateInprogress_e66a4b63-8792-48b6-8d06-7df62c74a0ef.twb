    <worksheet name='Historic View'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Historic View</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold' fontsize='9'> | &lt;[Parameters].[Parameter 3]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tDine - Order Performance' name='federated.0z2hchx15vq0eh1357q7y1ah4bsi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
            <column caption='Select Measure' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
              <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Include EDR - City Walk ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z2hchx15vq0eh1357q7y1ah4bsi'>
            <column caption='tDine Acquisitions' datatype='integer' name='[Active Customers (copy)_1617425632457392130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [tdine_acquisition] then [order_id] end)' />
            </column>
            <column caption='Net Fail Rate, %' datatype='real' default-format='p0.0%' name='[Active Customers (copy)_1617425632458788872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#10;count(if [net_failed_order] then [order_id] end)&#10;/&#10;count(if [is_net] then [order_id] end)&#10;)' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_1617425632457068544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [is_successful] then [order_id] end)' />
            </column>
            <column caption='Customers with Multiple Orders' datatype='integer' name='[Calculation_1617425632457834500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if not [tdine_acquisition] and [is_successful] then [account_id] end)' />
            </column>
            <column caption='Overall Fail Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1617425632459227146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_1617425632459141129] / count([order_id])' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1617425632461279243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_1617425632458043397] / [Calculation_1617425632457068544]' />
            </column>
            <column caption='Measure' datatype='real' default-format='n#,##0.0;(#,##0.0)' name='[Calculation_1617425632475475981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;when &quot;Successful Orders&quot; then [Calculation_1617425632457068544]&#10;when &quot;Successful GMV&quot; then [Successful Orders (copy)_1617425632458043397]&#10;when &quot;AOV&quot; then [Calculation_1617425632461279243]&#10;when &quot;Successful Basket Amount&quot; then [Successful GMV (copy)_1617425632458452998]&#10;when &quot;Discount Amount&quot; then [Successful GMV (copy)_1617425632458588167]&#10;when &quot;Failed Orders&quot; then [Successful Orders (copy)_1617425632459141129]&#10;//when &quot;Overall Fail Rate, %&quot; then [Overall Fail Rate, %]&#10;//when &quot;Net Fail Rate, %&quot; then [Net Fail Rate, %]&#10;when &quot;tDine Acquisitions&quot; then [Active Customers (copy)_1617425632457392130]&#10;when &quot;Active Customers&quot; then [Successful Orders (copy)_1617425632457306113]&#10;when &quot;Customers with Multiple Orders&quot; then [Calculation_1617425632457834500]&#10;end' />
            </column>
            <column caption='Report Date' datatype='datetime' default-format='*dd-mmm-yy' name='[Calculation_1617425632477896722]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Day&apos; then [Day]&#10;elseif [Parameters].[Parameter 4] = &apos;Week&apos; then datetrunc(&apos;week&apos;,[order_date],&apos;monday&apos;)&#10;elseif [Parameters].[Parameter 4] = &apos;Month&apos; then [Month]&#10;end' />
            </column>
            <column caption='EDR - CityWalk Filter' datatype='boolean' name='[Calculation_1617425632710991893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;Yes&quot; then true else ([vendor_id] &lt;&gt; 699895) end' />
            </column>
            <column datatype='date' name='[Day]' role='dimension' type='quantitative' user:agg-type='None' user:base-field='order_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='Measure Combined' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Measure % (copy)_1617425632476602383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;//when &quot;Successful Orders&quot; then [Successful Orders]&#10;//when &quot;Successful GMV&quot; then [Successful GMV]&#10;//when &quot;AOV&quot; then [AOV]&#10;//when &quot;Successful Basket Amount&quot; then [Successful Basket Amount]&#10;//when &quot;Discount Amount&quot; then [Discount Amount]&#10;//when &quot;Failed Orders&quot; then [Failed Orders]&#10;when &quot;Overall Fail Rate, %&quot; then [Calculation_1617425632459227146]&#10;when &quot;Net Fail Rate, %&quot; then [Active Customers (copy)_1617425632458788872]&#10;when &quot;Acceptance Rate&quot; then [Net Fail Rate, % (copy)_5225653323145191424]&#10;//when &quot;tDine Acquisitions&quot; then [tDine Acquisitions]&#10;//when &quot;Active Customers&quot; then [Active Customers]&#10;//when &quot;Customers with Multiple Orders&quot; then [Customers with Multiple Orders]&#10;else [Calculation_1617425632475475981]&#10;end' />
            </column>
            <column caption='Measure %' datatype='real' default-format='p0.0%' name='[Measure (copy)_1617425632475807758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;//when &quot;Successful Orders&quot; then [Successful Orders]&#10;//when &quot;Successful GMV&quot; then [Successful GMV]&#10;//when &quot;AOV&quot; then [AOV]&#10;//when &quot;Successful Basket Amount&quot; then [Successful Basket Amount]&#10;//when &quot;Discount Amount&quot; then [Discount Amount]&#10;//when &quot;Failed Orders&quot; then [Failed Orders]&#10;when &quot;Overall Fail Rate, %&quot; then [Calculation_1617425632459227146]&#10;when &quot;Net Fail Rate, %&quot; then [Active Customers (copy)_1617425632458788872]&#10;when &quot;Acceptance Rate&quot; then [Net Fail Rate, % (copy)_5225653323145191424]&#10;//when &quot;tDine Acquisitions&quot; then [tDine Acquisitions]&#10;//when &quot;Active Customers&quot; then [Active Customers]&#10;//when &quot;Customers with Multiple Orders&quot; then [Customers with Multiple Orders]&#10;end' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='order_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_date]))' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Net Fail Rate, % (copy)_5225653323145191424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if ([parent_order_acceptance_status_detailed]=&apos;success with single attempt&apos;&#10;or [parent_order_acceptance_status_detailed]=&apos;success with multiple attempts&apos;&#10;or&#10;[parent_order_acceptance_status_detailed]=&apos;recovery with different pm&apos;) and [is_parent_order]&#10;  then [order_id] end)&#10;/&#10;countd(if [is_parent_order] then  [parent_order_id] end)' />
            </column>
            <column caption='Successful Basket Amount' datatype='real' name='[Successful GMV (copy)_1617425632458452998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then &#10;&#10; (if [Parameters].[Parameter 2] = &apos;LC&apos; then [basket_amount_lc] else [basket_amount_eur] end)&#10;&#10;end)' />
            </column>
            <column caption='Discount Amount' datatype='real' name='[Successful GMV (copy)_1617425632458588167]' role='measure' type='quantitative'>
