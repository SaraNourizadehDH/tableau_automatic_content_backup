            <column-instance column='[Calculation_3596053945322942466]' derivation='User' name='[pcto:usr:Calculation_3596053945322942466:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Table' type='PctTotal' />
            </column-instance>
