              <calculation class='tableau' formula='case [tpro_subs_type] WHEN &apos;Pro Family&apos; then &#13;&#10;CASE [family_sub_type] WHEN &apos;Manager&apos; THEN&#13;&#10;IF [plan_type] = &apos;1M&apos; then ZN([1M to 1M different plan type - Family (copy)_1040050044844118040]) + ZN([6M to 1M different plan type - Family (copy)_1040050044844888093]) + ZN([12M to 1M different plan type - Family (copy)_1040050044842549266]) + ZN([1M same plan name different sub type  - Manager (copy)_1798906599819874331]) + ZN([1M to 6M same plan type (copy)_1040050044834803721]) + ZN([6M to 1M same plan type different sub type - Family Manager (copy)_1798906599810326552]) + ZN([1M to 12M same plan type (copy)_1040050044836913163]) + ZN([12M to 1M same plan type different sub type - Family Manager (copy)_1798906599808851987])&#13;&#10;ELSEIF CONTAINS([plan_name], &apos;6&apos;) then ZN([1M to 6M different plan type - Family (copy)_1040050044844277785]) + ZN([12M to 6M different plan type - Family (copy)_1040050044842860564]) + ZN([6M same plan name different sub type  - Manager (copy)_1798906599819956252]) + ZN([Upgrades from 1M to 6M (copy)_1040050044829896706]) + ZN([1M to 6M same plan type different sub type - Family Manager (copy)_1798906599809982486]) + ZN([12M to 6M same plan type different sub type - Family Manager (copy)_1798906599809478676])&#13;&#10;ELSE ZN([1M to 12M different plan type - Family (copy)_1040050044843204630]) + ZN([6M to 12M different plan type - Family (copy)_1040050044844593179]) + ZN([12M to 12M different plan type - Family (copy)_1040050044842254353]) + ZN([12M same plan name different sub type  - Manager (copy)_1798906599820070941]) + ZN([1M to 12M same plan type (copy)_1040050044829462529]) + ZN([1M to 12M same plan type different sub type - Family Manager (copy)_1798906599809703957]) + ZN([Upgrades from 6M to 12M (copy)_1040050044830769156]) + ZN([6M to 12M same plan type different sub type - Family Manager (copy)_1798906599810158615]) END&#13;