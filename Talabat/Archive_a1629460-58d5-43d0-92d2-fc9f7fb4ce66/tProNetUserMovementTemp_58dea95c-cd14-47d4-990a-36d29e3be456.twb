                <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Medium' italic='true' underline='true'>Daily View</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users Yesterday:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers as of yesterday</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Acquisitions:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>All new subscribers added on the given day (New Acquistions + Winbacks - Organic + Winbacks - Converted from BR)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>New Acquisitions:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>First time acquisitions on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Winbacks - Organic:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Churned users returing to pro on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Winbacks - Converted from BR:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Billing Retry conversions on the given day</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Churned:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>All subscribers who exited tPro on the given day (Churn - Voluntary + Churn - Involuntary)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Churn - Voluntary:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Users who churned voluntarily on the given day (Free Trial + Paid)</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium'>Æ      </run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Free Trial:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Free trial users who churned voluntarily on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium'>Æ      </run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Paid:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Paid users who churned voluntarily on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Churn - Involuntary:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Users who churned involuntarily on the given day (Free Trial + Paid)</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium'>Æ      </run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Free Trial:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Free trial users who churned involuntarily on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium'>Æ      </run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Paid:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Paid users who churned involuntarily on the given day</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Upgrades:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Users who upgraded their 1M subscription to LTP on the given day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Downgrades: </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Users who downgraded their LTP plan to 1M on the given day</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users EOD:</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers as of the given day (Active Users Yesterday + Acquisitions - Churned)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users EOD (1M):</run>
                    <run fontname='Tableau Medium'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers in a 1M plan as of the given day (Active Users Yesterday + Acquisitions - Churned - Upgrades + Downgrades)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users EOD (LTP):</run>
