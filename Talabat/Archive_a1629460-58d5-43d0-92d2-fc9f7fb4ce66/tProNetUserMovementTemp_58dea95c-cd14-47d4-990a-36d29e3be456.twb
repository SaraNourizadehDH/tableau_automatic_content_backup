              <run fontcolor='#000000' fontname='Tableau Medium'>All subscribers who exited tPro in this month (Free Trial + Paid)</run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Medium'>Æ      </run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Free Trial:</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Free trial users who churned in this month</run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Medium'>Æ      </run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Paid:</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Paid users who churned in this month</run>
              <run>Æ&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Upgrades:</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Users who upgraded their 1M subscription to LTP in this month</run>
              <run>Æ&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Downgrades: </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Users who downgraded their LTP plan to 1M in this month</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users Current Month:</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers at the end of the month (Active Users Previous Month + Acquisitions - Churned)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users Current Month (1M):</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers in a 1M at the end of the month (Active Users Previous Month + Acquisitions - Churned - Upgrades + Downgrades)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium'>Active Users Current Month (LTP):</run>
              <run fontname='Tableau Medium'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Active tPro Subscribers in a 1M at the end of the month (Active Users Previous Month + Acquisitions - Churned + Upgrades - Downgrades)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#2f008f' fontname='Tableau Medium' italic='true' underline='true'>Caveats:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Users moving to regular plan from partnerships will be counted under Winbacks - Organic.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium'>Users moving to partnerships from regular plan will be counted under Churn - Voluntary.</run>
              <run>Æ&#10;&#10;&#10;&#10;</run>
