              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(&#13;&#10;IF CONTAINS([plan_name], &apos;12&apos;) then&#13;&#10;IF [family_sub_type] = &apos;Member&apos; THEN&#13;&#10;ZN([acquisitions_same_plan_different_family_sub_type_count]) + ZN([winbacks_same_plan_different_family_sub_type_count]) + ZN([billing_retry_same_plan_different_family_sub_type_count]) + ZN([active_ld_same_plan_different_family_sub_type_count]) &#13;&#10;+ ZN([renewed_from_partnerships_same_plan_different_family_sub_type_count]) + ZN([winback_target_same_plan_different_family_sub_type_count]) ELSE 0 END END)}' />
