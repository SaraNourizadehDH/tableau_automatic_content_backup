      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Customer Segments' id='_28C237A3FB9C4373B905BDDC0A8CCB2B'>
            <properties context=''>
              <relation connection='bigquery.1e4tpkd0sr7klw1137d1k1khwv0w' name='Custom_SQL_Query' type='text'><![CDATA[with all_tpro_new as 
(select   
CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country,
dc.campaign_name
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) =ue.campaign_step_id
where LOWER(campaign_name) LIKE'%_tpronew_%'
group by 1,2),

all_active_campaigns as 
(select country, campaign_name from 
(select * from `tlb-data-dev.data_playground.crm_active_campaigns_list_v1` as a 
UNION ALL 
select * from all_tpro_new as b)
group by 1,2
order by 1,2),

clicks_monthly as
(select country, external_id, clicked_month, campaign_type, campaign_name, clicked_time, 
MAX(clicked_time) OVER(PARTITION BY country, external_id, clicked_month, campaign_type) as campaign_clicked_time from  
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, external_id, 
DATE(DATE_TRUNC(event_timestamp,MONTH)) as clicked_month,
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type, dc.campaign_name,
max(event_timestamp) as clicked_time
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and     (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
where event_type in ('email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4,5) QUALIFY campaign_clicked_time = clicked_time),

clicks_daily as
(select country, external_id, clicked_date, campaign_type, campaign_name, clicked_time, 
MAX(clicked_time) OVER(PARTITION BY country, external_id, clicked_date, campaign_type) as campaign_clicked_time from  
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, external_id, 
DATE(event_timestamp) as clicked_date,
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type, dc.campaign_name,
max(event_timestamp) as clicked_time
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and     (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
where event_type in ('email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4,5) QUALIFY campaign_clicked_time = clicked_time),

clicks_weekly as
(select country, external_id, clicked_week, campaign_type, campaign_name, clicked_time, 
MAX(clicked_time) OVER(PARTITION BY country, external_id, clicked_week, campaign_type) as campaign_clicked_time from  
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, external_id, 
DATE(DATE_TRUNC(event_timestamp,WEEK)) as clicked_week,
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type, dc.campaign_name,
max(event_timestamp) as clicked_time
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and     (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
where event_type in ('email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4,5) QUALIFY campaign_clicked_time = clicked_time),

customers_d as 
(select country, account_id, start_date, subscription_state from 
(select country, account_id, subscription_state, a.start_date,
ROW_NUMBER() OVER(PARTITION BY country, account_id ORDER BY start_date) as rnk_start
from `tlb-data-prod.data_platform.fct_subscription_history` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.is_visible
order by 1,2) where rnk_start = 1),

combined_monthly as
(select a.*, case when b.account_id is not null then 1 else 0 END as is_subscribed, 
b.start_date as is_subscribed_time,
DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) as time_diff,
ROW_NUMBER() OVER(PARTITION BY a.country, a.external_id, a.clicked_month ORDER BY DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) ) as subs_rnk
 from clicks_monthly as a left join customers_d as b 
on a.external_id = CAST(b.account_id AS STRING) and a.country = b.country QUALIFY subs_rnk = 1),

combined_daily as
(select a.*, case when b.account_id is not null then 1 else 0 END as is_subscribed, 
b.start_date as is_subscribed_time,
DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) as time_diff,
ROW_NUMBER() OVER(PARTITION BY a.country, a.external_id, a.clicked_date ORDER BY DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) ) as subs_rnk
 from clicks_daily as a left join customers_d as b 
on a.external_id = CAST(b.account_id AS STRING) and a.country = b.country QUALIFY subs_rnk = 1),

combined_weekly as
(select a.*, case when b.account_id is not null then 1 else 0 END as is_subscribed, 
b.start_date as is_subscribed_time,
DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) as time_diff,
ROW_NUMBER() OVER(PARTITION BY a.country, a.external_id, a.clicked_week ORDER BY DATE_DIFF(CAST(b.start_date as TIMESTAMP), a.clicked_time, MINUTE) ) as subs_rnk
 from clicks_weekly as a left join customers_d as b 
on a.external_id = CAST(b.account_id AS STRING) and a.country = b.country QUALIFY subs_rnk = 1),

acqns_monthly as 
(select country, clicked_month, campaign_name, campaign_type, external_id,
count(distinct case when time_diff between 0 and 360 then external_id END) as six_hour_acqns from combined_monthly
group by 1,2,3,4,5
order by 1,2,3,4,5),

acqns_daily as 
(select country, clicked_date, campaign_name, campaign_type, external_id,
count(distinct case when time_diff between 0 and 360 then external_id END) as six_hour_acqns from combined_daily
group by 1,2,3,4,5
order by 1,2,3,4,5),

acqns_weekly as 
(select country, clicked_week, campaign_name, campaign_type, external_id,
count(distinct case when time_diff between 0 and 360 then external_id END) as six_hour_acqns from combined_weekly
group by 1,2,3,4,5
order by 1,2,3,4,5),

base_data as 
(select 
country_iso, 
DATE_TRUNC(a.order_date,MONTH) as iso_date, 
a.account_id, 
count(distinct order_id) as orders,
case when count(distinct order_id) <<= 4 then 'Very Light'
     when count(distinct order_id) <<= 9 then 'Light'
     when count(distinct order_id) <<= 14 then 'Medium'
     when count(distinct order_id) <<= 19 then 'Heavy'
     else 'Very Heavy' END as segments
from `tlb-data-prod.data_platform.fct_order_info` as a 
where a.order_date between '2022-12-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 DAY)
and country_iso in ('AE','KW', 'QA', 'KW', 'JO') and a.is_successful and account_id >> 0
group by 1,2,3),

sends_and_clicks_monthly as 
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, DATE(DATE_TRUNC(event_timestamp,MONTH)) as clicked_month, ue.external_id, 
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type,   
count(distinct case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then ue.external_id END) as unique_sends,
count(case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then '123' END) as sends,
count(distinct case when event_type in ('email_click','push_notify_open','inapp_message_click') then ue.external_id END) as unique_clicks,
count(case when event_type in ('email_click','push_notify_open','inapp_message_click') then '123' END) as clicks,
max(case when bd.segments is null then 'missing' else bd.segments END) as segments
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and  (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
left join base_data as bd on ue.external_id = CAST(bd.account_id as STRING) and 
(CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = bd.country_iso and DATE(DATE_TRUNC(event_timestamp,MONTH)) = DATE_ADD(bd.iso_date, INTERVAL 1 MONTH)
where event_type in ('email_delivery','inapp_message_impression','push_notify_send', 'email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4
order by 1,2,3,4),

sends_and_clicks_daily as 
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, DATE(event_timestamp) as clicked_date, ue.external_id,
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type,
count(distinct case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then ue.external_id END) as unique_sends,
count(case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then '123' END) as sends,
count(distinct case when event_type in ('email_click','push_notify_open','inapp_message_click') then ue.external_id END) as unique_clicks,
count(case when event_type in ('email_click','push_notify_open','inapp_message_click') then '123' END) as clicks,
max(case when bd.segments is null then 'missing' else bd.segments END) as segments
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and  (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
left join base_data as bd on ue.external_id = CAST(bd.account_id as STRING) and 
(CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = bd.country_iso and DATE(DATE_TRUNC(event_timestamp,MONTH)) = DATE_ADD(bd.iso_date, INTERVAL 1 MONTH)
where event_type in ('email_delivery','inapp_message_impression','push_notify_send', 'email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4
order by 1,2,3,4),

sends_and_clicks_weekly as 
(select CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END as country, DATE(DATE_TRUNC(event_timestamp,WEEK)) as clicked_week, ue.external_id,
case when event_type like '%push%' then 'Push' 
     when event_type like '%inapp%' then 'IAM'
     when event_type like '%email%' then 'Email' END as campaign_type,
count(distinct case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then ue.external_id END) as unique_sends,
count(case when event_type in ('email_delivery','inapp_message_impression','push_notify_send') then '123' END) as sends,
count(distinct case when event_type in ('email_click','push_notify_open','inapp_message_click') then ue.external_id END) as unique_clicks,
count(case when event_type in ('email_click','push_notify_open','inapp_message_click') then '123' END) as clicks,
max(case when bd.segments is null then 'missing' else bd.segments END) as segments
FROM
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue
  JOIN
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce
  USING(
    event_type_id)
JOIN `tlb-data-prod.data_platform.dim_campaign` dc
    ON
      dc.campaign_id=ue.campaign_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs
    ON  
      CAST(cs.campaign_step_id AS STRING) = ue.campaign_step_id
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) 
and  (CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = cm.country
left join base_data as bd on ue.external_id = CAST(bd.account_id as STRING) and 
(CASE
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_AE.*") THEN 'AE'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_KW.*") THEN 'KW'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_QA.*") THEN 'QA'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_BH.*") THEN 'BH'
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r"_JO.*") THEN 'JO'
    ELSE
    'Other'
    END) = bd.country_iso and DATE(DATE_TRUNC(event_timestamp,MONTH)) = DATE_ADD(bd.iso_date, INTERVAL 1 MONTH)
where event_type in ('email_delivery','inapp_message_impression','push_notify_send', 'email_click','push_notify_open','inapp_message_click')
group by 1,2,3,4
order by 1,2,3,4)

select 'Daily' as type, a.country, a.clicked_date as iso_date, segments, a.campaign_type,
sum(unique_sends) as unqiue_sends, sum(sends) as sends, 
sum(unique_clicks) as unique_clicks, sum(clicks) as clicks, sum(b.six_hour_acqns) as six_hour_acqns from sends_and_clicks_daily as a left join acqns_daily as b 
on a.country = b.country and a.clicked_date = b.clicked_date and a.external_id = b.external_id
and a.campaign_type = b.campaign_type
where a.country in ('AE', 'KW', 'QA', 'BH', 'JO')
and (case when a.country in ('AE', 'KW') and a.clicked_date >>= '2023-01-01' then true
          when a.country = 'QA' and a.clicked_date >>= '2023-04-01' then true
          when a.country = 'BH' and a.clicked_date >>= '2023-06-01' then true 
          when a.country = 'JO' and a.clicked_date >>= '2023-07-01' then true END) = true
group by 1,2,3,4,5

UNION ALL

select 'Weekly' as type, a.country, a.clicked_week as iso_date, segments, a.campaign_type,
sum(unique_sends) as unqiue_sends, sum(sends) as sends, 
sum(unique_clicks) as unique_clicks, sum(clicks) as clicks, sum(b.six_hour_acqns) as six_hour_acqns from sends_and_clicks_weekly as a left join acqns_weekly as b 
on a.country = b.country and a.clicked_week = b.clicked_week and a.external_id = b.external_id
and a.campaign_type = b.campaign_type
where a.country in ('AE', 'KW', 'QA', 'BH', 'JO')
and (case when a.country in ('AE', 'KW') and a.clicked_week >>= '2023-01-01' then true
          when a.country = 'QA' and a.clicked_week >>= '2023-04-01' then true
          when a.country = 'BH' and a.clicked_week >>= '2023-06-01' then true 
          when a.country = 'JO' and a.clicked_week >>= '2023-07-01' then true END) = true
group by 1,2,3,4,5

UNION ALL

select 'Monthly' as type, a.country, a.clicked_month as iso_date, segments, a.campaign_type,
sum(unique_sends) as unqiue_sends, sum(sends) as sends, 
sum(unique_clicks) as unique_clicks, sum(clicks) as clicks, sum(b.six_hour_acqns) as six_hour_acqns from sends_and_clicks_monthly as a left join acqns_monthly as b 
on a.country = b.country and a.clicked_month = b.clicked_month and a.external_id = b.external_id
and a.campaign_type = b.campaign_type
where a.country in ('AE', 'KW', 'QA', 'BH')
and (case when a.country in ('AE', 'KW') and a.clicked_month >>= '2023-01-01' then true
          when a.country = 'QA' and a.clicked_month >>= '2023-04-01' then true
          when a.country = 'BH' and a.clicked_month >>= '2023-06-01' then true 
          when a.country = 'JO' and a.clicked_month >>= '2023-07-01' then true END) = true
group by 1,2,3,4,5
order by 1,2,3,4,5]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Custom_SQL_Query (data_platform)' inline='true' name='federated.0zsi9w01t3m4i01e5n4vr16x857c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0jlhl3q0csi8720zt6pe01su17rr'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='hajira.zulfiqar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jlhl3q0csi8720zt6pe01su17rr' name='Custom_SQL_Query' type='text'>with all_tpro_new as &#13;
(select &#13;
CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END as country,&#13;
dc.campaign_name&#13;
FROM&#13;
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue&#13;
  JOIN&#13;
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce&#13;
  USING(&#13;
    event_type_id)&#13;
JOIN `tlb-data-prod.data_platform.dim_campaign` dc&#13;
    ON&#13;
      dc.campaign_id=ue.campaign_id&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs&#13;
    ON  &#13;
      CAST(cs.campaign_step_id AS STRING) =ue.campaign_step_id&#13;
where LOWER(campaign_name) LIKE&apos;%_tpronew_%&apos;&#13;
group by 1,2),&#13;
&#13;
all_active_campaigns as &#13;
(select country, campaign_name from &#13;
(select * from `tlb-data-dev.data_playground.crm_active_campaigns_list_v1` as a &#13;
UNION ALL &#13;
select * from all_tpro_new as b)&#13;
group by 1,2&#13;
order by 1,2),&#13;
&#13;
clicks_monthly as&#13;
(select country, account_id, clicked_month, campaign_type, campaign_name, clicked_time, &#13;
MAX(clicked_time) OVER(PARTITION BY country, account_id, clicked_month, campaign_type) as campaign_clicked_time from  &#13;
(select CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END as country, external_id as account_id, &#13;
DATE(DATE_TRUNC(event_timestamp,MONTH)) as clicked_month,&#13;
case when event_type like &apos;%push%&apos; then &apos;Push&apos; &#13;
     when event_type like &apos;%inapp%&apos; then &apos;IAM&apos;&#13;
     when event_type like &apos;%email%&apos; then &apos;Email&apos; END as campaign_type, dc.campaign_name,&#13;
max(event_timestamp) as clicked_time&#13;
FROM&#13;
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue&#13;
  JOIN&#13;
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce&#13;
  USING(&#13;
    event_type_id)&#13;
JOIN `tlb-data-prod.data_platform.dim_campaign` dc&#13;
    ON&#13;
      dc.campaign_id=ue.campaign_id&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs&#13;
    ON  &#13;
      CAST(cs.campaign_step_id AS STRING) =ue.campaign_step_id&#13;
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) &#13;
and     (CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END) = cm.country      &#13;
where event_type in (&apos;email_click&apos;,&apos;push_notify_open&apos;,&apos;inapp_message_click&apos;)&#13;
group by 1,2,3,4,5) QUALIFY campaign_clicked_time = clicked_time),&#13;
&#13;
clicks_daily as&#13;
(select country, account_id, clicked_date, campaign_type, campaign_name, clicked_time, &#13;
MAX(clicked_time) OVER(PARTITION BY country, account_id, clicked_date, campaign_type) as campaign_clicked_time from  &#13;
(select CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
