  <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/WIPtProCRMAcquisitionCampaignsTracker?rev=1.0' id='WIPtProCRMAcquisitionCampaignsTracker' path='/t/Talabat/workbooks' revision='1.0' site='Talabat' />
  <preferences>
