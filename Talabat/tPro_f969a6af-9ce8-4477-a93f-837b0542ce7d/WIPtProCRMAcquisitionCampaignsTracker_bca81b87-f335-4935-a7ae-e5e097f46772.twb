  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END as country, external_id as account_id, &#13;
DATE(event_timestamp) as clicked_date,&#13;
case when event_type like &apos;%push%&apos; then &apos;Push&apos; &#13;
     when event_type like &apos;%inapp%&apos; then &apos;IAM&apos;&#13;
     when event_type like &apos;%email%&apos; then &apos;Email&apos; END as campaign_type, dc.campaign_name,&#13;
max(event_timestamp) as clicked_time&#13;
FROM&#13;
