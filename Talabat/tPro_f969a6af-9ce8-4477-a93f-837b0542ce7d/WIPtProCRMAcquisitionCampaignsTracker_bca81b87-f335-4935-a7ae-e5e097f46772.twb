    &apos;Other&apos;&#13;
    END) = cm.country&#13;
where event_type in (&apos;email_delivery&apos;,&apos;inapp_message_impression&apos;,&apos;push_notify_send&apos;, &apos;email_click&apos;,&apos;push_notify_open&apos;,&apos;inapp_message_click&apos;)&#13;
group by 1,2,3,4&#13;
order by 1,2,3,4),&#13;
&#13;
sends_and_clicks_weekly as &#13;
(select CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END as country, DATE(DATE_TRUNC(event_timestamp,WEEK)) as clicked_week, dc.campaign_name,&#13;
case when event_type like &apos;%push%&apos; then &apos;Push&apos; &#13;
     when event_type like &apos;%inapp%&apos; then &apos;IAM&apos;&#13;
     when event_type like &apos;%email%&apos; then &apos;Email&apos; END as campaign_type,&#13;
count(distinct case when event_type in (&apos;email_delivery&apos;,&apos;inapp_message_impression&apos;,&apos;push_notify_send&apos;) then external_id END) as unique_sends,&#13;
count(distinct case when event_type in (&apos;email_delivery&apos;,&apos;inapp_message_impression&apos;,&apos;push_notify_send&apos;) then &#13;
concat(external_id, event_type, DATE(event_timestamp)) END) as sends,&#13;
count(distinct case when event_type in (&apos;email_click&apos;,&apos;push_notify_open&apos;,&apos;inapp_message_click&apos;) then external_id END) as unique_clicks,&#13;
count(distinct case when event_type in (&apos;email_click&apos;,&apos;push_notify_open&apos;,&apos;inapp_message_click&apos;) then &#13;
concat(external_id, event_type, DATE(event_timestamp)) END) as clicks&#13;
FROM&#13;
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue&#13;
  JOIN&#13;
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce&#13;
  USING(&#13;
    event_type_id)&#13;
JOIN `tlb-data-prod.data_platform.dim_campaign` dc&#13;
    ON&#13;
      dc.campaign_id=ue.campaign_id&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs&#13;
    ON  &#13;
      CAST(cs.campaign_step_id AS STRING)=ue.campaign_step_id&#13;
inner join all_active_campaigns as cm on lower(dc.campaign_name) = lower(cm.campaign_name) &#13;
and  (CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END) = cm.country&#13;
where event_type in (&apos;email_delivery&apos;,&apos;inapp_message_impression&apos;,&apos;push_notify_send&apos;, &apos;email_click&apos;,&apos;push_notify_open&apos;,&apos;inapp_message_click&apos;)&#13;
group by 1,2,3,4&#13;
order by 1,2,3,4)&#13;
&#13;
select &apos;Daily&apos; as type, a.country, a.clicked_date as iso_date, a.campaign_name, a.campaign_type,&#13;
unique_sends, sends, unique_clicks, clicks, six_hour_acqns &#13;
from sends_and_clicks_daily as a left join acqns_daily as b &#13;
on a.country = b.country and a.clicked_date = b.clicked_date and a.campaign_name = b.campaign_name &#13;
and a.campaign_type = b.campaign_type&#13;
where a.country in (&apos;AE&apos;, &apos;KW&apos;, &apos;QA&apos;, &apos;BH&apos;, &apos;JO&apos;)&#13;
and (case when a.country in (&apos;AE&apos;, &apos;KW&apos;) and a.clicked_date &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;QA&apos; and a.clicked_date &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;BH&apos; and a.clicked_date &gt;&gt;= &apos;2024-01-01&apos; then true &#13;
          when a.country = &apos;JO&apos; and a.clicked_date &gt;&gt;= &apos;2024-01-01&apos; then true END) = true&#13;
&#13;
UNION ALL&#13;
&#13;
select &apos;Weekly&apos; as type, a.country, a.clicked_week as iso_date, a.campaign_name, a.campaign_type, unique_sends, sends, unique_clicks, clicks, six_hour_acqns &#13;
from sends_and_clicks_weekly as a left join acqns_weekly as b &#13;
on a.country = b.country and a.clicked_week = b.clicked_week and a.campaign_name = b.campaign_name &#13;
and a.campaign_type = b.campaign_type&#13;
where a.country in (&apos;AE&apos;, &apos;KW&apos;, &apos;QA&apos;, &apos;BH&apos;, &apos;JO&apos;)&#13;
and (case when a.country in (&apos;AE&apos;, &apos;KW&apos;) and a.clicked_week &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;QA&apos; and a.clicked_week &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;BH&apos; and a.clicked_week &gt;&gt;= &apos;2024-01-01&apos; then true &#13;
          when a.country = &apos;JO&apos; and a.clicked_week &gt;&gt;= &apos;2024-01-01&apos; then true END) = true&#13;
&#13;
UNION ALL&#13;
&#13;
select &apos;Monthly&apos; as type, a.country, a.clicked_month as iso_date, a.campaign_name, a.campaign_type,&#13;
unique_sends, sends, unique_clicks, clicks, six_hour_acqns &#13;
from sends_and_clicks_monthly as a left join acqns_monthly as b &#13;
on a.country = b.country and a.clicked_month = b.clicked_month and a.campaign_name = b.campaign_name &#13;
and a.campaign_type = b.campaign_type&#13;
where a.country in (&apos;AE&apos;, &apos;KW&apos;, &apos;QA&apos;, &apos;BH&apos;, &apos;JO&apos;)&#13;
and (case when a.country in (&apos;AE&apos;, &apos;KW&apos;) and a.clicked_month &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;QA&apos; and a.clicked_month &gt;&gt;= &apos;2024-01-01&apos; then true&#13;
          when a.country = &apos;BH&apos; and a.clicked_month &gt;&gt;= &apos;2024-01-01&apos; then true &#13;
          when a.country = &apos;JO&apos; and a.clicked_month &gt;&gt;= &apos;2024-01-01&apos; then true END) = true</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0jlhl3q0csi8720zt6pe01su17rr' name='Custom_SQL_Query' type='text'>with all_tpro_new as &#13;
(select &#13;
CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_JO.*&quot;) THEN &apos;JO&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
    END as country,&#13;
dc.campaign_name&#13;
FROM&#13;
  `tlb-data-prod.data_platform.fct_campaign_user_event` ue&#13;
  JOIN&#13;
  `tlb-data-prod.data_platform.dim_campaign_event_type` dce&#13;
  USING(&#13;
    event_type_id)&#13;
JOIN `tlb-data-prod.data_platform.dim_campaign` dc&#13;
    ON&#13;
      dc.campaign_id=ue.campaign_id&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_campaign_step` cs&#13;
    ON  &#13;
      CAST(cs.campaign_step_id AS STRING) =ue.campaign_step_id&#13;
where LOWER(campaign_name) LIKE&apos;%_tpronew_%&apos;&#13;
group by 1,2),&#13;
&#13;
all_active_campaigns as &#13;
(select country, campaign_name from &#13;
(select * from `tlb-data-dev.data_playground.crm_active_campaigns_list_v1` as a &#13;
UNION ALL &#13;
select * from all_tpro_new as b)&#13;
group by 1,2&#13;
order by 1,2),&#13;
&#13;
clicks_monthly as&#13;
(select country, account_id, clicked_month, campaign_type, campaign_name, clicked_time, &#13;
MAX(clicked_time) OVER(PARTITION BY country, account_id, clicked_month, campaign_type) as campaign_clicked_time from  &#13;
(select CASE&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_AE.*&quot;) THEN &apos;AE&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_KW.*&quot;) THEN &apos;KW&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_QA.*&quot;) THEN &apos;QA&apos;&#13;
  WHEN REGEXP_CONTAINS(UPPER(dc.campaign_name), r&quot;_BH.*&quot;) THEN &apos;BH&apos;&#13;
