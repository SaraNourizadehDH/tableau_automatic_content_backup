          <alias key='&quot;[federated.1jm3s7i0heq52h1eypl6z1p7da2b].[sum:Calculation_1702079197101674500:qk]&quot;' value='Clicked Users' />
          <alias key='&quot;[federated.1jm3s7i0heq52h1eypl6z1p7da2b].[sum:users:qk]&quot;' value='Sent Users' />
