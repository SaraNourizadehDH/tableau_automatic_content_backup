            <column-instance column='[campaign_variant_name]' derivation='None' name='[none:campaign_variant_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[send_delivery_tag]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1702079197101674500]' derivation='Sum' name='[sum:Calculation_1702079197101674500:qk]' pivot='key' type='quantitative' />
