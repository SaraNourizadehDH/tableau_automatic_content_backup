    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Guide'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/CampaignPerformanceDashboard/Guide?rev=' id='Guide' path='/t/Talabat/workbooks/WIPCampaignPerformanceDashboard' revision='' site='Talabat' />
      <style />
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98400' id='3' type-v2='text' w='98400' x='800' y='800'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontname='Cambria' fontsize='9'>Summary:</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>  The dashboard analyzes the impact of campaigns, specifically voucher campaigns on the following two fronts: </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Acquisition &amp; Winback to Pro </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Uplift on Vendor KPIs </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>All campaigns are divided in two types: </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Acquisition Only: for non-pro customers </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Engagement: for existing pro customers </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Both: for both </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontname='Cambria' fontsize='9'>Success Metrics:</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#ff0000' fontname='Cambria' fontsize='9'>Acquisition Only: for non-pro customers</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Acquisition and Winback rate between Test and Control </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       In these types of campaigns, all users receive the communication for voucher, we will not be calculating vendor impact. </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#ff0000' fontname='Cambria' fontsize='9'>Engagement: for existing pro customers</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#ff0000' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Acquisition and Winback rate between Test and Control </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Voucher Usage rate between Test and Control </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontname='Cambria' fontsize='9'>Assumptions:</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       Conversion period between Test and Control is defined as campaign start date and last send date of the campaign. </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       In case Test and Control of a given campaign are part of another campaign, we will assume that since they will be randomly assigned to the other campaign, our results will not be impacted. </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       In case Hero Banner and CRM both are used, the maximum uplift from each of tool would be the minimum of the campaign, given there could be contamination of groups. </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>·       We are not assigning an acquisition or winback to a particular campaign, so for any given time period we cant sum up all acquisitions and winbacks for the campaigns. </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#ff0000' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#ff0000' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontname='Cambria' fontsize='9'>Æ  </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
