              <calculation class='tableau' formula='sum([acquisitions])/sum([Calculation_1298725555486048257])' />
            </column>
            <column caption='Campaign Type' datatype='string' name='[Calculation_1702079197099573251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(lower([campaign_name]),&quot;voucher&quot;) THEN&#13;&#10;&quot;Voucher&quot;&#13;&#10;ELSEIF &#13;&#10;CONTAINS(lower([campaign_name]), &quot;acq&quot;) THEN&#13;&#10;    &quot;Acquisition&quot;&#13;&#10;ELSEIF CONTAINS(lower([campaign_name]),&quot;nonpro&quot;) then&#13;&#10;&quot;Acquisition&quot;&#13;&#10;ELSEIF CONTAINS(lower([campaign_name]), &quot;Existing&quot;) THEN&#13;&#10;    &quot;Existing&quot;&#13;&#10;ELSEIF  CONTAINS(lower([campaign_name]),&quot;onboarding&quot;) THEN&#13;&#10;&quot;Onboarding&quot;&#13;&#10;ELSE&#13;&#10; &quot;N/A&quot;&#13;&#10;END' />
            </column>
            <column caption='Clicked' datatype='integer' name='[Calculation_1702079197101674500]' role='measure' type='quantitative'>
