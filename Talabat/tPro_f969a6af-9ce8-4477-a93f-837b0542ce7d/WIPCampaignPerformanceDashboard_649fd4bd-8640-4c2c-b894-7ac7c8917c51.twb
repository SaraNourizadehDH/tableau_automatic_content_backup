        </aliases>
      </column>
      <column caption='Winbacks%' datatype='real' name='[Acquisitions % (copy)_1298725555488448515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([winbacks])/sum([Calculation_1298725555486048257])' />
      </column>
      <column caption='Clicks/ Sends' datatype='real' name='[Calculation_1298725555482710016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1702079197101674500])/SUM([users])' />
      </column>
      <column caption='Base' datatype='integer' name='[Calculation_1298725555486048257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  ISNULL([Calculation_1702079197101674500]) then [users] ELSE [Calculation_1702079197101674500] END' />
      </column>
      <column caption='Acquisitions %' datatype='real' name='[Calculation_1298725555487977474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions])/sum([Calculation_1298725555486048257])' />
      </column>
      <column caption='Campaign Type' datatype='string' name='[Calculation_1702079197099573251]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(lower([campaign_name]),&quot;voucher&quot;) THEN&#13;&#10;&quot;Voucher&quot;&#13;&#10;ELSEIF &#13;&#10;CONTAINS(lower([campaign_name]), &quot;acq&quot;) THEN&#13;&#10;    &quot;Acquisition&quot;&#13;&#10;ELSEIF CONTAINS(lower([campaign_name]),&quot;nonpro&quot;) then&#13;&#10;&quot;Acquisition&quot;&#13;&#10;ELSEIF CONTAINS(lower([campaign_name]), &quot;Existing&quot;) THEN&#13;&#10;    &quot;Existing&quot;&#13;&#10;ELSEIF  CONTAINS(lower([campaign_name]),&quot;onboarding&quot;) THEN&#13;&#10;&quot;Onboarding&quot;&#13;&#10;ELSE&#13;&#10; &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Clicked' datatype='integer' name='[Calculation_1702079197101674500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [send_delivery_tag]=1 then [users] END' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1702079197105389573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Zero (copy)' datatype='integer' name='[Zero (copy)_1702079197105430534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_7B6AF608D50F4583A0F0BB1FD2E8A5E6]' role='measure' type='quantitative' />
      <column datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
      <column datatype='string' name='[base_tag]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Acquisition Base&quot;' value='Acquisition' />
          <alias key='&quot;Winbacks Base&quot;' value='Winbacks' />
        </aliases>
      </column>
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[send_delivery_tag]' role='dimension' type='ordinal' />
      <column datatype='string' name='[tag]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='0-No Order' />
          <alias key='&quot;Heavy&quot;' value='4-Heavy' />
          <alias key='&quot;Light&quot;' value='2-Light' />
          <alias key='&quot;Medium&quot;' value='3-Medium' />
          <alias key='&quot;Very Heavy&quot;' value='5-Very Heavy' />
          <alias key='&quot;Very Light&quot;' value='1-Very Light' />
