      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7B6AF608D50F4583A0F0BB1FD2E8A5E6'>
            <properties context=''>
              <relation connection='bigquery.0gdt9lt1gtauuj1bqeomx0w1bmup' name='Custom SQL Query' type='text'><![CDATA[with c as  (
select * from tlb-data-dev.data_playground.crm_table_fill
)
 
,base as (select c.country,
campaign_start_date,
campaign_end_date,c.campaign_name,campaign_variant_name,
send_delivery_tag,
external_id,case when (cd.account_id is null or date(cd.start_date)>>= date(campaign_start_date)) then "Acquisition Base" when (cd.start_date)<< campaign_start_date then "Winbacks Base" end  as base_tag,
case when (date(cd.start_date) between campaign_start_date and campaign_end_date) then 1 else 0 end  as acquired
from c 
inner join (select campaign_name,min(date(start_date)) as campaign_start_date, max(date(end_date)) as campaign_end_date
from c group by 1) as ci
on c.campaign_name=ci.campaign_name
left join `tlb-data-prod.data_platform_rest_tables.customers_d` as cd
on c.external_id=cast(cd.account_id as string)
and c.country=cd.country
and subscription_state not in ("BILLING RETRY") and plan_id not in (31,34)

)


,pro as (
  select 
    a.country, 
    iso_date,
    account_id as winbacks
  from 
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
  where 
    iso_date << CURRENT_DATE 
    and (case when DATE(a.start_date) = iso_date and a.subscription_state = 'PAID' and DATE_DIFF(DATE(a.start_date), DATE(a.prev_end_date), DAY) >> 1 THEN 1 else 0 END)=1
  group by 
    1, 
    2,
    3
  order by
    3 desc

)



,last_month as (
select country_iso,segment_month, if((orders>>=0 and orders<<=4),"Very Light",if((orders>>=5 and orders <<=9),"Light",
if((orders>>=10 and orders<<=14),"Medium",if((orders>>=15 and orders <<=19),"Heavy","Very Heavy"))))
as tag, account_id from (
select country_iso,account_id, date_trunc(order_date,month) as segment_month, count(distinct order_id) as orders
from tlb-data-prod.data_platform.fct_order_info as o
where is_successful
and date_trunc(order_date,month)>>="2023-07-01"
group by 1,2,3)group by 1,2,3,4)

select
b.country,
b.campaign_start_date,b.campaign_end_date,b.campaign_name,b.campaign_variant_name,
base_tag,
tag,
send_delivery_tag,
count(distinct b.external_id) as users,
sum(acquired)as acquisitions,
count(distinct winbacks) as winbacks,
from base as b 
left join 
last_month as l
on b.external_id=cast(l.account_id as string)
and b.country=l.country_iso
and date_trunc(campaign_start_date,month)=date_add(segment_month,interval 1 month)
left join pro as p
on b.external_id=cast(p.winbacks as string)
and b.country=p.country
and p.iso_date between campaign_start_date and campaign_end_date
group by 1,2,3,4,5,6,7,8]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Voucher Usage' inline='true' name='federated.1qk5g4d12oyxiu195yk480uzog3r' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0sdgvje0vpuhen1f0mqo40wdtcu2'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='hajira.zulfiqar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0sdgvje0vpuhen1f0mqo40wdtcu2' name='Custom SQL Query' type='text'><![CDATA[with account_used as (
select
ci.country_id,
date_trunc(date(created_on_date),month) as voucher_month,
c.braze_canvas_name,
c.braze_canvas_variant_name,
case when (is_used is true and is_deleted is false) then "Used" else "Did not Use" end as used_accounts,
v.account_id as assigned_users ,
chain_name
from
tlb-data-prod.data_platform.dim_campaign as dc 
left join tlb-data-prod.data_platform.dim_incentives_voucher as c
on dc.campaign_name=c.braze_canvas_name
left join
tlb-data-prod.data_platform.dim_incentives_voucher_details as v
on c.voucher_id=v.voucher_id
left join tlb-data-prod.data_platform.dim_country_info as ci
on c.country_id=ci.country_id
and (campaign_reference_id like ('%tpronew%') or campaign_reference_id like ('%tpro%')
or campaign_reference_id like ('%nonpro%'))
left join tlb-data-prod.data_platform.fct_order_info as o
on cast(o.order_id as string)=v.order_id
left join tlb-data-prod.data_platform.dim_chain as vi
on vi.chain_id=o.chain_id
group by 1,2,3,4,5,6,7
)

,
last_month as (
select country_id,segment_month, if((orders>>=0 and orders<<=4),"1-Very Light",if((orders>>=5 and orders <<=9),"2-Light",
if((orders>>=10 and orders<<=14),"3-Medium",if((orders>>=15 and orders <<=19),"4-Heavy","5-Very Heavy"))))
as tag, account_id from (
select country_id,account_id, date_trunc(order_date,month) as segment_month, count(distinct order_id) as orders
from tlb-data-prod.data_platform.fct_order_info as o
where is_successful
and date_trunc(order_date,month)>>="2023-06-01"
group by 1,2,3
)group by 1,2,3,4)

select a.country_id,chain_name,braze_canvas_name,braze_canvas_variant_name,
tag,used_accounts, count(distinct a.assigned_users) as total_accounts
from account_used as a left join last_month as l on a.assigned_users=l.account_id
and voucher_month=date_add(segment_month, interval 1 month)
and a.country_id=l.country_id
group by 1,2,3,4,5,6 order by 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0sdgvje0vpuhen1f0mqo40wdtcu2' name='Custom SQL Query' type='text'><![CDATA[with account_used as (
