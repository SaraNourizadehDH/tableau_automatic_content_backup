where d.date between date_sub(current_date(),  interval  12 month)  and current_date()
and a.plan_id not in (31,34) and a.subscription_state<<>>'BILLING RETRY')


,orders as(select country_iso,date_trunc(order_date,month) as month, account_id, coalesce(count(distinct order_id),0) as freq, coalesce(sum(gmv_amount_lc),0) as gmv, 
from  `tlb-data-prod.data_platform.fct_order_info`
where order_date between date_sub(date_trunc(current_date(),month),  interval  12 month)  and current_date()
and is_successful
and country_iso in ("OM","BH","KW","QA","AE","JO")
group by all)

,pro_users as ( select 
 a.month,
 a.country,
 a.plan_type,
 case 
    when a.country in ("AE", "BH","QA") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 4 then "2.Low"
        when b.freq between 5 and 10 then "3.Medium"
        when b.freq >> 10 then "4.High" end
    when a.country in ("JO") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq =2 then "2.Low"
        when b.freq between 3 and 5 then "3.Medium"
        when b.freq >>5 then "4.High" end
    when a.country in ("KW") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 6 then "2.Low"
        when b.freq between 7 and 13 then "3.Medium"
        when b.freq >>13 then "4.High" end
    when a.country in ("OM") then
      case
         when b.freq<<= 1 then "1.Inactive"
         when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 3 then "2.Low"
        when b.freq between 4 and 8 then "3.Medium"
        when b.freq >>8 then "4.High" end
    else "Others"
    end as order_segment,
    count(distinct a.account_id) as pro_user,

 from active_customers as a
 left join orders as b
 on b.account_id=a.account_id
 and b.country_iso=a.country
 and b.month=a.month
 group by all
)



select 
"Talabat KPIs" as type,
a.country_iso,
a.month,
case 
    when a.country_iso in ("AE", "BH","QA") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 4 then "2.Low"
        when b.freq between 5 and 10 then "3.Medium"
        when b.freq >> 10 then "4.High" end
    when a.country_iso in ("JO") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq =2 then "2.Low"
        when b.freq between 3 and 5 then "3.Medium"
        when b.freq >>5 then "4.High" end
    when a.country_iso in ("KW") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 6 then "2.Low"
        when b.freq between 7 and 13 then "3.Medium"
        when b.freq >>13 then "4.High" end
    when a.country_iso in ("OM") then
      case
         when b.freq<<= 1 then "1.Inactive"
         when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 3 then "2.Low"
        when b.freq between 4 and 8 then "3.Medium"
        when b.freq >>8 then "4.High" end
    else "Others"
    end as order_segment,
count(distinct a.account_id) as talabat_base, 
from orders as a
left join orders as b
on b.account_id=a.account_id
and b.country_iso=a.country_iso
and b.month=a.month
group by all




UNION ALL

SELECT 
case when plan_type="STP" then "STP" else "LTP" end as type,
 country,
 month,
 order_segment,
 pro_user
 from pro_users
 group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Churn%'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Churn % by Order Segments</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn- segment' name='federated.1ogtooq0rqndz014s6mrx0kxru2w' />
          </datasources>
          <datasource-dependencies datasource='federated.1ogtooq0rqndz014s6mrx0kxru2w'>
            <column caption='Segment Bucket' datatype='string' name='[Calculation_1176565417911566336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;AE&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=4) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=10 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;10 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;     when &apos;BH&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=4) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=10 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;10 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;     when &apos;JO&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=2) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=5 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;5 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;     when &apos;KW&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=6) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=13 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;13 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;     when &apos;OM&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=3) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=8 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;8 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;    when &apos;QA&apos; then &#13;&#10;    (if [total_orders]&lt;=1   then &apos;0.Inactive&apos;&#13;&#10;     ELSEIF  ([total_orders] &lt;=4) then &apos;1.Low&apos;&#13;&#10;     ELSEIF   [total_orders] &lt;=10 then &apos;2.Medium&apos;&#13;&#10;     ELSEIF     [total_orders] &gt;10 then &apos;3.High&apos;&#13;&#10;     ELSE &apos;None&apos;  end )&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Churned %' datatype='real' name='[Calculation_1176565417912512513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [churned]=1 then [account_id] else null end)&#13;&#10;/&#13;&#10;countd([account_id])' />
            </column>
            <column datatype='integer' name='[account_id]' role='measure' type='quantitative' />
            <column datatype='integer' name='[churned]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1176565417911566336]' derivation='None' name='[none:Calculation_1176565417911566336:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1176565417912512513]' derivation='User' name='[usr:Calculation_1176565417912512513:qk]' pivot='key' type='quantitative' />
