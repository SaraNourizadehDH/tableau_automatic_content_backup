      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_EFD38B6871294F6E9A794AE35FFDA105'>
            <properties context=''>
              <relation connection='bigquery.0zp6e4i0k7s6lc1aeacof0ksnla0' name='Custom SQL Query' type='text'><![CDATA[with  subscriber_daily as 
(
select *,case when (lead(start_date) over (partition by account_id,plan_id order by iso_date asc)  is not null and lead(date(start_date)) over (partition by account_id,plan_id order by iso_date asc) != date(start_date) and lead(date(start_date)) over (partition by account_id,plan_id order by iso_date asc) <<= date(end_date)) then iso_date else date(end_date) end  as new_end_date
        ,row_number() over (partition by account_id ,country,case when subscription_state = 'BILLING RETRY' then 1 else 0 end order by iso_date asc) as days_on_pro
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`

)
,customers_monthly as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         

from subscriber_daily  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(new_end_date)
and plan_id not in (31,34)
and iso_date <<=current_date-2

),end_of_month_active as
(
select  date_trunc(iso_date,month)  as month,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'and dd.date<<=current_date()
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
--and     subscription_state <<>> 'BILLING RETRY'
and     plan_id not in (31,34)
group by 1,2,3,4
),ranking_monthly as 
(
select *,date_trunc(up_for_renewal_date,month) as month
        ,row_number()over(partition by account_id,country,date_trunc(up_for_renewal_date,month) order by up_for_renewal_date desc ) as rank_number 
from  customers_monthly cm 
),monthly_load as 
(
select cm.country
      ,cm.month as iso_date
      ,cm.plan_id
      ,'monthly' as type
      ,'renewed' as status
      ,case when cm.subscription_state = 'GRACE PERIOD' then cm.prev_subs_type else cm.subscription_state end as subscriptiontype
      ,'' as churn_type
      ,cm.account_id
      ,cm.up_for_renewal_date 
      ,date(cm.start_date) as start_date
      ,date(cm.new_end_date) as end_date
      ,cm.days_on_pro
      --,count(distinct case when  em.account_id is not null and em.subscription_state <<>> 'BILLING RETRY' then cm.account_id end ) as customers
from ranking_monthly cm
left join end_of_month_active em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
where  cm.month<<=current_date
and  cm.rank_number = 1
and  em.account_id is not null and em.subscription_state <<>> 'BILLING RETRY'
group by all
union all 
select cm.country
      ,cm.month as iso_date
      ,cm.plan_id
      ,'monthly' as type
      ,'churned' as status
      ,case when cm.subscription_state = 'GRACE PERIOD' then cm.prev_subs_type else cm.subscription_state end as subscriptiontype
      ,case when (fs.subscription_state = 'BILLING RETRY' or cm.subscription_state ='GRACE PERIOD') then 'Involuntary Churn' else 'Voluntary Churn' end as churn_type
      ,cm.account_id 
      ,up_for_renewal_date
      --,count(distinct case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as customers
      ,date(cm.start_date) as start_date
      ,date(cm.new_end_date) as end_date
      ,cm.days_on_pro

from ranking_monthly cm
left join end_of_month_active em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.month<<=current_date
and cm.rank_number = 1
and (em.account_id is null or (em.subscription_state = 'BILLING RETRY'))
group by all
), order_kpis as 
(
select cm.*
       ,count(distinct fi.order_id) as orders
       ,count(distinct case when vh.vendor_id is not null then fi.order_id end) as pro_vendor_orders
       ,count(distinct case when fi.is_tpro_order then fi.order_id end) as tpro_orders
       ,sum(case when fi.is_modified then fi.mod_original_gmv_amount_lc else fi.gmv_amount_lc end - fi.delivery_fee_amount_lc- fi.service_fee_amount_lc - fi.tourist_tax_amount_lc - fi.municipality_tax_amount_lc ) as gfv 
       ,sum(case when fi.is_tpro_order then 
                  case when fi.is_modified then fi.mod_original_gmv_amount_lc else fi.gmv_amount_lc end - fi.delivery_fee_amount_lc - fi.service_fee_amount_lc - fi.tourist_tax_amount_lc - fi.municipality_tax_amount_lc end ) as gfv_pro
       ,sum(fi.tpro_discount_lc) as pro_savings 


from monthly_load cm 
left join `tlb-data-prod.data_platform.fct_order_info` fi 
on   cm.account_id = fi.account_id 
and  cm.country = fi.country_iso 
and  fi.order_date between date_add(end_date,interval -30 day) and end_date 
and  fi.is_successful 
and  fi.order_date >>='2023-01-01'
left join `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history` vh 
on   vh.vendor_id = fi.vendor_id 
and  vh.date = fi.order_date 
group by all
)
select  ok.country
        ,case when lower(ok.subscriptiontype) like '%free%' then 'FREE TRIAL' ELSE ok.subscriptiontype end as subs_type
        ,ok.iso_date as date 
        ,ok.account_id 
        ,ok.up_for_renewal_date
        ,ok.end_date
        ,ok.days_on_pro 
        ,case when churn_type = 'Voluntary Churn' then 1 else 0 end as vol_churn
        ,case when status = 'churned' then 1 else 0 end as churned
        ,ok.plan_id as prev_planid
        ,coalesce(ok.orders,0) as total_orders
        ,coalesce(ok.pro_vendor_orders,0) as orders_pro_restaurants
        ,coalesce(ok.pro_savings,0) as pro_savings 
        ,coalesce(ok.gfv,0) as gfv_lc
        ,0 as avg_rating 
        ,coalesce(ok.tpro_orders,0) as pro_orders




from    order_kpis ok 
where ok.iso_date >>= date_add(date_trunc(current_date,month),interval -6 month)
and subscriptiontype is not null]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='adoption%' inline='true' name='federated.1p8e75z1tuys2q1cv8756065kurk' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0fj25eq05nnccd12jpu6c1hik12f'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hajira.zulfiqar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0fj25eq05nnccd12jpu6c1hik12f' name='Custom SQL Query' type='text'><![CDATA[with 
active_customers as(select distinct a.account_id ,a.country, date_trunc(a.iso_date,month) as month,case when plan_duration_days<<=31 then "STP" else "LTP" end as plan_type,
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_date` as d
on a.iso_date=d.month_end_date
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as s
on s.plan_id=a.plan_id
and d.date<<=current_date()
where d.date between date_sub(current_date(),  interval  12 month)  and current_date()
and a.plan_id not in (31,34) and a.subscription_state<<>>'BILLING RETRY')


,orders as(select country_iso,date_trunc(order_date,month) as month, account_id, coalesce(count(distinct order_id),0) as freq, coalesce(sum(gmv_amount_lc),0) as gmv, 
from  `tlb-data-prod.data_platform.fct_order_info`
where order_date between date_sub(date_trunc(current_date(),month),  interval  12 month)  and current_date()
and is_successful
and country_iso in ("OM","BH","KW","QA","AE","JO")
group by all)

,pro_users as ( select 
 a.month,
 a.country,
 a.plan_type,
 case 
    when a.country in ("AE", "BH","QA") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 4 then "2.Low"
        when b.freq between 5 and 10 then "3.Medium"
        when b.freq >> 10 then "4.High" end
    when a.country in ("JO") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq =2 then "2.Low"
        when b.freq between 3 and 5 then "3.Medium"
        when b.freq >>5 then "4.High" end
    when a.country in ("KW") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 6 then "2.Low"
        when b.freq between 7 and 13 then "3.Medium"
        when b.freq >>13 then "4.High" end
    when a.country in ("OM") then
      case
         when b.freq<<= 1 then "1.Inactive"
         when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 3 then "2.Low"
        when b.freq between 4 and 8 then "3.Medium"
        when b.freq >>8 then "4.High" end
    else "Others"
    end as order_segment,
    count(distinct a.account_id) as pro_user,

 from active_customers as a
 left join orders as b
 on b.account_id=a.account_id
 and b.country_iso=a.country
 and b.month=a.month
 group by all
)



select 
"Talabat KPIs" as type,
a.country_iso,
a.month,
case 
    when a.country_iso in ("AE", "BH","QA") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 4 then "2.Low"
        when b.freq between 5 and 10 then "3.Medium"
        when b.freq >> 10 then "4.High" end
    when a.country_iso in ("JO") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq =2 then "2.Low"
        when b.freq between 3 and 5 then "3.Medium"
        when b.freq >>5 then "4.High" end
    when a.country_iso in ("KW") then
      case
        when b.freq<<= 1 then "1.Inactive"
        when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 6 then "2.Low"
        when b.freq between 7 and 13 then "3.Medium"
        when b.freq >>13 then "4.High" end
    when a.country_iso in ("OM") then
      case
         when b.freq<<= 1 then "1.Inactive"
         when b.account_id is null then "1.Inactive"
        when b.freq between 2 and 3 then "2.Low"
        when b.freq between 4 and 8 then "3.Medium"
        when b.freq >>8 then "4.High" end
    else "Others"
    end as order_segment,
count(distinct a.account_id) as talabat_base, 
from orders as a
left join orders as b
on b.account_id=a.account_id
and b.country_iso=a.country_iso
and b.month=a.month
group by all




UNION ALL

SELECT 
case when plan_type="STP" then "STP" else "LTP" end as type,
 country,
 month,
 order_segment,
 pro_user
 from pro_users
 group by all]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
