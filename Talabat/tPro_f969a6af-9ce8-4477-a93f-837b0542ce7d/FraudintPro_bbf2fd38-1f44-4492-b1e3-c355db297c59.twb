    <datasource caption='Total Active Users Network Size' inline='true' name='federated.1e08s2b0mvrogq191qoen1hxfu8q' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0j1er240w1cubh1at6kn00im88hp'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='rimsha.rashid.2@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0j1er240w1cubh1at6kn00im88hp' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  DISTINCT iso_date AS date,
  CASE 
    WHEN customer_network_size = 0 THEN '0'
    WHEN customer_network_size = 1 THEN '1'
    WHEN customer_network_size = 2 THEN '2'
    WHEN customer_network_size = 3 THEN '3'
    WHEN customer_network_size = 4 THEN '4'
    ELSE '>>=5'
  END AS customer_network_size_group,
  country,
  COUNT(DISTINCT account_id) AS total_account_id_count
FROM tlb-data-prod.data_platform.fct_tpro_subscriber_daily active
LEFT JOIN `tlb-data-prod`.data_platform_fraud.agg_customer_network net
  ON active.account_id = net.customer_id
WHERE subscription_state <<>> 'BILLING RETRY'
  AND iso_date = DATE(start_date)
  AND DATE(start_date) >>= '2024-10-01'
GROUP BY 
  date, 
  country, 
  customer_network_size_group]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0j1er240w1cubh1at6kn00im88hp' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  DISTINCT iso_date AS date,
  CASE 
    WHEN customer_network_size = 0 THEN '0'
    WHEN customer_network_size = 1 THEN '1'
    WHEN customer_network_size = 2 THEN '2'
    WHEN customer_network_size = 3 THEN '3'
    WHEN customer_network_size = 4 THEN '4'
    ELSE '>>=5'
  END AS customer_network_size_group,
  country,
  COUNT(DISTINCT account_id) AS total_account_id_count
FROM tlb-data-prod.data_platform.fct_tpro_subscriber_daily active
LEFT JOIN `tlb-data-prod`.data_platform_fraud.agg_customer_network net
  ON active.account_id = net.customer_id
WHERE subscription_state <<>> 'BILLING RETRY'
  AND iso_date = DATE(start_date)
  AND DATE(start_date) >>= '2024-10-01'
GROUP BY 
  date, 
  country, 
  customer_network_size_group]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
