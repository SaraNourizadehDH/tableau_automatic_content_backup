      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_253CFD39396144208969AFFA202B546C'>
            <properties context=''>
              <relation connection='bigquery.0j1er240w1cubh1at6kn00im88hp' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  DISTINCT iso_date AS date,
  CASE 
    WHEN customer_network_size = 0 THEN '0'
    WHEN customer_network_size = 1 THEN '1'
    WHEN customer_network_size = 2 THEN '2'
    WHEN customer_network_size = 3 THEN '3'
    WHEN customer_network_size = 4 THEN '4'
    ELSE '>>=5'
  END AS customer_network_size_group,
  country,
  COUNT(DISTINCT account_id) AS total_account_id_count
FROM tlb-data-prod.data_platform.fct_tpro_subscriber_daily active
LEFT JOIN `tlb-data-prod`.data_platform_fraud.agg_customer_network net
  ON active.account_id = net.customer_id
WHERE subscription_state <<>> 'BILLING RETRY'
  AND iso_date = DATE(start_date)
  AND DATE(start_date) >>= '2024-10-01'
GROUP BY 
  date, 
  country, 
  customer_network_size_group]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='free trial card abuse query' inline='true' name='federated.0w28vea08t9p3z1647q651228p3c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0rkbok80r4iwro1310iqb18rzck1'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='yes' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='rimsha.rashid.2@talabat.com' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rkbok80r4iwro1310iqb18rzck1' name='Custom SQL Query' type='text'>WITH upm_data AS (SELECT DISTINCT customer_id,
                                  country_id,
                                  card_number_encrypted,
                                  EXTRACT(month from transaction_time) AS transaction_month,
                  FROM `tlb-data-prod`.data_platform_fraud.fct_card_transaction
                  WHERE DATE(transaction_time) &gt;&gt;= &apos;2024-10-01&apos;),
     filtered_data AS (SELECT a.card_number_encrypted,
                              country,
                              start_date as date,
                              tpro.account_id
                       FROM `tlb-data-prod`.data_platform.fct_tpro_subscriber_daily tpro
                                LEFT JOIN upm_data a
                                          ON tpro.account_id = a.customer_id
                       WHERE tpro.subscription_state = &apos;FREE TRIAL&apos;
                         AND tpro.iso_date = DATE(tpro.start_date)
                         AND DATE(tpro.start_date) &gt;&gt;= &apos;2024-10-01&apos;),
     card_to_accounts AS (SELECT card_number_encrypted,
                                 country,
                                 date,
                                 COUNT(DISTINCT account_id) AS count_of_customers_per_card
                          FROM filtered_data
                          GROUP BY card_number_encrypted, country, date)
SELECT country,
       date,
       CASE
           WHEN count_of_customers_per_card = 0 THEN &apos;0&apos;
           WHEN count_of_customers_per_card = 1 THEN &apos;1&apos;
           WHEN count_of_customers_per_card = 2 THEN &apos;2&apos;
           WHEN count_of_customers_per_card = 3 THEN &apos;3&apos;
           WHEN count_of_customers_per_card = 4 THEN &apos;4&apos;
           ELSE &apos;&gt;&gt;=5&apos;
           END  as count_of_customers_per_card,
       COUNT(*) AS count_of_card_fingerprint
FROM card_to_accounts
GROUP BY country, date, count_of_customers_per_card
ORDER BY count_of_customers_per_card</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0rkbok80r4iwro1310iqb18rzck1' name='Custom SQL Query' type='text'>WITH upm_data AS (SELECT DISTINCT customer_id,
                                  country_id,
                                  card_number_encrypted,
                                  EXTRACT(month from transaction_time) AS transaction_month,
                  FROM `tlb-data-prod`.data_platform_fraud.fct_card_transaction
                  WHERE DATE(transaction_time) &gt;&gt;= &apos;2024-10-01&apos;),
     filtered_data AS (SELECT a.card_number_encrypted,
                              country,
                              start_date as date,
                              tpro.account_id
                       FROM `tlb-data-prod`.data_platform.fct_tpro_subscriber_daily tpro
                                LEFT JOIN upm_data a
                                          ON tpro.account_id = a.customer_id
                       WHERE tpro.subscription_state = &apos;FREE TRIAL&apos;
                         AND tpro.iso_date = DATE(tpro.start_date)
                         AND DATE(tpro.start_date) &gt;&gt;= &apos;2024-10-01&apos;),
     card_to_accounts AS (SELECT card_number_encrypted,
                                 country,
                                 date,
                                 COUNT(DISTINCT account_id) AS count_of_customers_per_card
                          FROM filtered_data
                          GROUP BY card_number_encrypted, country, date)
SELECT country,
