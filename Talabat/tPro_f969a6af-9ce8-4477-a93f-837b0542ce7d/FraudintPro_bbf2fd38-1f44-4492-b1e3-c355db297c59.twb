      <column caption='date_range_free_trial' datatype='string' name='[Calculation_5939333119288537123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &quot;Daily&quot; THEN&#10;    STR(DAY([date])) + &quot; &quot; +&#10;    LEFT(DATENAME(&apos;month&apos;, [date]), 3) + &quot;, &quot; +&#10;    RIGHT(STR(YEAR([date])), 2)&#10;  WHEN &quot;Weekly&quot; THEN&#10;    &quot;Week &quot; + STR(DATEPART(&apos;week&apos;, [date]))&#10;  WHEN &quot;Monthly&quot; THEN&#10;    LEFT(DATENAME(&apos;month&apos;, [date]), 3) + &quot; , &quot; +&#10;    RIGHT(STR(YEAR([date])), 2)&#10;WHEN &quot;Yearly&quot; THEN&#10;    DATENAME(&apos;year&apos;, [date])&#10;END' />
      </column>
      <column caption='highlight_free_trial' datatype='string' name='[Calculation_5939333119291359268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// ULTIMATE WORKAROUND (handles edge cases)&#10;IF STR([count_of_customers_per_card]) = &quot;&gt;=5&quot; AND &#10;   NOT ISNULL([country]) THEN&#10;    &quot;HIGHLIGHT&quot;&#10;ELSE&#10;    &quot;NO HIGHLIGHT&quot;&#10;END' />
      </column>
