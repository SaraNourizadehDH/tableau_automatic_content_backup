        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rs1uwu0mtcks61cls39f1l1f20t' name='Custom SQL Query' type='text'>select distinct date,
                CASE
                    WHEN customer_network_size = 0 THEN &apos;0&apos;
                    WHEN customer_network_size = 1 THEN &apos;1&apos;
                    WHEN customer_network_size = 2 THEN &apos;2&apos;
                    WHEN customer_network_size = 3 THEN &apos;3&apos;
                    WHEN customer_network_size = 4 THEN &apos;4&apos;
                    ELSE &apos;&gt;&gt;=5&apos;
