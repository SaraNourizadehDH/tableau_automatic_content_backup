          <object caption='Custom SQL Query' id='_CF1007B21B39496794B9D164A319326A'>
            <properties context=''>
              <relation connection='bigquery.0rkbok80r4iwro1310iqb18rzck1' name='Custom SQL Query' type='text'>WITH upm_data AS (SELECT DISTINCT customer_id,
                                  country_id,
                                  card_number_encrypted,
                                  EXTRACT(month from transaction_time) AS transaction_month,
                  FROM `tlb-data-prod`.data_platform_fraud.fct_card_transaction
                  WHERE DATE(transaction_time) &gt;&gt;= &apos;2024-10-01&apos;),
     filtered_data AS (SELECT a.card_number_encrypted,
                              country,
                              start_date as date,
                              tpro.account_id
                       FROM `tlb-data-prod`.data_platform.fct_tpro_subscriber_daily tpro
                                LEFT JOIN upm_data a
                                          ON tpro.account_id = a.customer_id
                       WHERE tpro.subscription_state = &apos;FREE TRIAL&apos;
                         AND tpro.iso_date = DATE(tpro.start_date)
                         AND DATE(tpro.start_date) &gt;&gt;= &apos;2024-10-01&apos;),
     card_to_accounts AS (SELECT card_number_encrypted,
                                 country,
                                 date,
                                 COUNT(DISTINCT account_id) AS count_of_customers_per_card
                          FROM filtered_data
                          GROUP BY card_number_encrypted, country, date)
SELECT country,
       date,
       CASE
           WHEN count_of_customers_per_card = 0 THEN &apos;0&apos;
           WHEN count_of_customers_per_card = 1 THEN &apos;1&apos;
           WHEN count_of_customers_per_card = 2 THEN &apos;2&apos;
           WHEN count_of_customers_per_card = 3 THEN &apos;3&apos;
           WHEN count_of_customers_per_card = 4 THEN &apos;4&apos;
           ELSE &apos;&gt;&gt;=5&apos;
           END  as count_of_customers_per_card,
       COUNT(*) AS count_of_card_fingerprint
FROM card_to_accounts
GROUP BY country, date, count_of_customers_per_card
ORDER BY count_of_customers_per_card</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
