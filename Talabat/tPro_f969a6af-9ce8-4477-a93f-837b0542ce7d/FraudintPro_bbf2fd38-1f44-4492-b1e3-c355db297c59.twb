                   on sub.account_id = net.customer_id
where date &gt;&gt;= &apos;2024-10-01&apos;
  and is_payment_successful
group by date, customer_network_size_group, country_code, acquisition_type</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
