              <calculation class='tableau' formula='// ULTIMATE WORKAROUND (handles edge cases)&#10;IF STR([customer_network_size_group]) = &quot;&gt;=5&quot; AND &#10;   NOT ISNULL([country_code]) THEN&#10;    &quot;HIGHLIGHT&quot;&#10;ELSE&#10;    &quot;NO HIGHLIGHT&quot;&#10;END' />
