              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_644577744469102600:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_644577744469291017:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_644577744475193357:qk]&quot;' />
