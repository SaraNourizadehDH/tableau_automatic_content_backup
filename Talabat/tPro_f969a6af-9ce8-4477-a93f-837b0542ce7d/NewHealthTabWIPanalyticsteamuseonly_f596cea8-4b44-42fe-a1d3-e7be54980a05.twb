        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_76ED470E74274EADB925514E49290436'>
            <properties context=''>
              <relation connection='bigquery.0m99f6m13f5e5m10ih4hf0ngbkcj' name='Custom SQL Query' type='text'><![CDATA[---Monthly Health Tab View------------------------------------------
with eom_active as
(
select  iso_date,
fs.country ,
count(distinct case when fs.plan_id not in (31,34) then fs.account_id end) as tpro_active_subscribers,
count(distinct case when plan_duration_days>>31 and is_visible and plan_price_lc <<>> 0 then fs.account_id end ) as tpro_ltp_active_subscribers,
count(distinct fs.account_id) as total_active_subscribers
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs


inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on fs.plan_id=sp.plan_id
where date_trunc(iso_date,month)<<=date_trunc(current_date(),month)
and subscription_state <<>> 'BILLING RETRY'
group by 1,2)

,acquisitions as (
select country,date(start_date) as start_date, 
count(distinct case when plan_id in (31,34) then account_id end) as partnerships_acquisitions,
count(distinct case when plan_id not in (31,34) then account_id end) as regular_acquisitions
from `tlb-data-prod.data_platform_rest_tables.customers_d`
where subscription_state <<>> "BILLING RETRY"
group by 1,2
)

-- select 
-- plan_id,
-- count(distinct account_id) from 
-- `tlb-data-prod.data_platform_rest_tables.customers_d`
-- where subscription_state <<>> "BILLING RETRY" and date_trunc(start_date,month)="2024-01-01"
-- and country="AE"
-- group by 1


,tpro_kpis as (
select o.country,
date as date,
sum(CASE WHEN TYPE IN ("Daily") and sp.plan_id in (31,34) then (gmv_overall_eur) else 0 end )as Partner_GMVProCustomers,
sum(CASE WHEN TYPE IN ("Daily") and sp.plan_id not in (31,34) then (gmv_overall_eur) else 0 end )as Regular_GMVProCustomers,
sum(case when type in ("Daily") and sp.plan_id in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Partner_GMVProCustomersMTD,
sum(case when type in ("Daily") and sp.plan_id not in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Regular_GMVProCustomersMTD,
sum(case when  type in ("Daily") and sp.plan_id in (31,34) then tpro_orders  else 0 end ) as partner_utilisation_tpro_orders,
sum(case when type in ("Daily") and sp.plan_id in (31,34) then overall_orders else 0 end ) as partner_utilisation_all_orders,
sum(case when  type in ("Daily") and sp.plan_id not in (31,34) then tpro_orders  else 0 end ) as regular_utilisation_tpro_orders,
sum(case when type in ("Daily") and sp.plan_id not in (31,34) then overall_orders else 0 end ) as regular_utilisation_all_orders
from tlb-data-prod.data_platform.agg_tpro_orders as o 
inner join tlb-data-prod.data_platform.dim_subscription_plan as sp
on o.plan_id=sp.plan_id
where 
is_visible
and date>>="2022-03-01"  --and type in ("Monthly")
and subs_type_upd = 'All'
group by 1,2
)


,talabat as (select order_date,
country_iso,
ifnull (max(talabat_l30_active) ,max(talabat_active)) as talabat_active,
sum(gmv_amount_eur) as talabatgmv,
count(distinct order_id) as talabat_orders,
sum(case when extract (day from order_date)<< extract(day from current_date()) then gmv_amount_eur end) as talabatgmvmtd,
sum(coalesce(gmv_amount_lc,0)) as platform_gmv

from `tlb-data-prod.data_platform.fct_order_info` fi
inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
on  fi.vendor_id = dv.vendor_id 
and  is_successful 
left join 
(select country,date,(talabat_l30_active) ,(talabat_active) from tlb-data-prod.data_platform.agg_tpro_order_contribution  as oc
where type="Daily"
group by 1,2,3,4) as oc
on fi.order_date=oc.date
and fi.country_iso=oc.country
--and  country_iso = 'AE'

where is_successful
and order_date>>="2023-01-01"
group by 1,2
)


---------------------------------churn----------------------------------------------------------------------------------------
,customers_daily as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         

from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
and plan_id not in (31,34)
and iso_date <<=current_date-2
),end_of_day_active as
(
select  iso_date  as date,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
where iso_date <<= current_date - 1
and     plan_id not in (31,34)
group by 1,2,3,4
)

,ranking_daily as 
(
select *
        ,row_number()over(partition by account_id,country,up_for_renewal_date order by up_for_renewal_date desc ) as rank_number 
from  customers_daily cm 
)

,churn_regular as (
select cm.country
      ,cm.up_for_renewal_date as renewal_date
     ,count(distinct cm.account_id) as regular_up_for_renewal
    ,count(distinct case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as regular_churned_customers
from ranking_daily cm
left join end_of_day_active em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.up_for_renewal_date = em.date
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.up_for_renewal_date<<=current_date-1
and cm.rank_number = 1
group by 1,2)



----------------------------all churn---------------------------------------------------------------------------------------------

,customers_daily_all as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         

from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
---and plan_id not in (31,34)
and iso_date <<=current_date-2
)
,end_of_day_active_all as
(
select  iso_date  as date,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
where iso_date <<= current_date - 1
--and     plan_id not in (31,34)
group by 1,2,3,4
)

,ranking_daily_all as 
(
select *
        ,row_number()over(partition by account_id,country,up_for_renewal_date order by up_for_renewal_date desc ) as rank_number 
from  customers_daily cm 
)

,churn_daily_all as (
select cm.country
      ,cm.up_for_renewal_date as renewal_date
     ,count(distinct cm.account_id) as up_for_renewal_all
    ,count(distinct case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as churned_customers_all
from ranking_daily_all cm
left join end_of_day_active_all em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.up_for_renewal_date = em.date
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.up_for_renewal_date<<=current_date-1
and cm.rank_number = 1
group by 1,2)

----------------------------------------------------------------------------------------------------------------------------------------













select a.iso_date,a.country,tpro_active_subscribers,total_active_subscribers,talabat_active,talabatgmv,talabatgmvmtd,platform_gmv,
regular_up_for_renewal,regular_churned_customers,
Partner_GMVProCustomers,Regular_GMVProCustomers,Partner_GMVProCustomersMTD,Regular_GMVProCustomersMTD,
regular_acquisitions,partnerships_acquisitions, tpro_ltp_active_subscribers,partner_utilisation_tpro_orders,regular_utilisation_tpro_orders,partner_utilisation_all_orders,regular_utilisation_all_orders,talabat_orders,up_for_renewal_all,churned_customers_all

from eom_active a
inner join talabat as b
on a.iso_date=b.order_date
and a.country=b.country_iso
inner join acquisitions as c
on a.iso_date=c.start_date
and a.country=c.country
inner join churn_regular as d
on a.iso_date=d.renewal_date
and a.country=d.country
inner join tpro_kpis as e
on a.iso_date=e.date
and a.country=e.country
inner join churn_daily_all as g
on a.iso_date=g.renewal_date
and a.country=g.country
where a.iso_date>>="2023-01-01"
order by a.country,a.iso_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Health Tab Monthly' inline='true' name='federated.1dspsjq15ygdnl1bej6tf0m2ef6n' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0cr40up0kdefp819hjmyn08g3h5j'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hajira.zulfiqar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0cr40up0kdefp819hjmyn08g3h5j' name='Custom SQL Query' type='text'><![CDATA[---Monthly Health Tab View------------------------------------------
with eom_active as
(
select  date_trunc(iso_date,month)  as month,
fs.country ,
count(distinct case when fs.plan_id not in (31,34) then fs.account_id end) as tpro_active_subscribers,
count(distinct case when plan_duration_days>>31 and is_visible and plan_price_lc <<>> 0 then fs.account_id end ) as tpro_ltp_active_subscribers,
count(distinct fs.account_id) as total_active_subscribers
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
and     subscription_state <<>> 'BILLING RETRY'
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on fs.plan_id=sp.plan_id
where date_trunc(iso_date,month)<<=date_trunc(current_date(),month)
group by 1,2)

,acquisitions as (
select country,date_trunc(date(start_date),month) as month, 
count(distinct case when plan_id in (31,34) then account_id end) as partnerships_acquisitions,
count(distinct case when plan_id not in (31,34) then account_id end) as regular_acquisitions
from `tlb-data-prod.data_platform_rest_tables.customers_d`
where subscription_state <<>> "BILLING RETRY"
group by 1,2
)

-- select 
-- plan_id,
-- count(distinct account_id) from 
-- `tlb-data-prod.data_platform_rest_tables.customers_d`
-- where subscription_state <<>> "BILLING RETRY" and date_trunc(start_date,month)="2024-01-01"
-- and country="AE"
-- group by 1


,tpro_kpis as (select o.country,
date_trunc(date,year) as year,
date_trunc(date, month) as month,
sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_id in (31,34) then (gmv_overall_eur) else 0 end )as Partner_GMVProCustomers,
sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_id not in (31,34) then (gmv_overall_eur) else 0 end )as Regular_GMVProCustomers,
sum(case when type in ("Daily") and sp.plan_id in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Partner_GMVProCustomersMTD,
sum(case when type in ("Daily") and sp.plan_id not in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Regular_GMVProCustomersMTD,
sum(case when  type in ("Monthly") and sp.plan_id in (31,34) then tpro_orders  else 0 end ) as partner_utilisation_tpro_orders,
sum(case when type in ("Monthly") and sp.plan_id in (31,34) then overall_orders else 0 end ) as partner_utilisation_all_orders,
sum(case when  type in ("Monthly") and sp.plan_id not in (31,34) then tpro_orders  else 0 end ) as regular_utilisation_tpro_orders,
sum(case when type in ("Monthly") and sp.plan_id not in (31,34) then overall_orders else 0 end ) as regular_utilisation_all_orders
from tlb-data-prod.data_platform.agg_tpro_orders as o 
inner join tlb-data-prod.data_platform.dim_subscription_plan as sp
on o.plan_id=sp.plan_id
where 
is_visible
and date>>="2022-03-01"  --and type in ("Monthly")
and subs_type_upd = 'All'
group by 1,2,3
)


,talabat as (select date_trunc(order_date,month) as month,
country_iso,
ifnull (max(talabat_l30_active) ,max(talabat_active)) as talabat_active,
sum(gmv_amount_eur) as talabatgmv,
count(distinct order_id) as talabat_orders,
sum(case when extract (day from order_date)<< extract(day from current_date()) then gmv_amount_eur end) as talabatgmvmtd,
sum(coalesce(gmv_amount_lc,0)) as platform_gmv
,sum(case when pv.vendor_id is not null then gmv_amount_lc end) as pro_vendor_gmv,
count(distinct case when pv.vendor_id is not null then pv.vendor_id end) as pro_vendor_count,
count(distinct case when pv.vendor_id is not null and fi.is_non_food is false then pv.vendor_id end) as pro_food_count,
count(distinct case when pv.vendor_id is not null and fi.is_non_food  then pv.vendor_id end) as pro_nfv_count,
sum(case when pv.vendor_id is not null and fi.is_non_food is false then gmv_amount_lc end) as pro_food_gmv,sum(case when fi.is_non_food is false then gmv_amount_lc end) as food_gmv,sum(case when pv.vendor_id is not null and fi.is_non_food is true and not dv.is_grocery_darkstore then gmv_amount_lc end ) as pro_nfv_gmv,sum(case when fi.is_non_food is true and not dv.is_grocery_darkstore then gmv_amount_lc end) as nfv_gmv,
from `tlb-data-prod.data_platform.fct_order_info` fi
inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
on  fi.vendor_id = dv.vendor_id 
and  is_successful 
left join 
(select country,date_trunc(date,month) as month,(talabat_l30_active) ,(talabat_active) from tlb-data-prod.data_platform.agg_tpro_order_contribution  as oc
where type="Monthly"
group by 1,2,3,4) as oc
on date_trunc(fi.order_date,month)=oc.month
and fi.country_iso=oc.country
--and  country_iso = 'AE'
left join  `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history` pv
on   pv.date = date_add(last_day(date_trunc(order_date,month)),interval 1 day)
and  pv.vendor_id = fi.vendor_id 
where is_successful
and order_date>>="2023-01-01"
group by 1,2
)

,platform_active as (select
month,
country_code,
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) and dv.is_non_food is false then km.vendor_id end) as talabat_food_count,
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) and dv.is_non_food  then km.vendor_id end) as talabat_nfv_count,      
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) then km.vendor_id end) as talabat_vendor_count
from `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` as km
inner join `tlb-data-prod.data_platform.dim_vendor_info` as dv
on km.vendor_id=dv.vendor_id
where month<<date_trunc(current_date(),month)
group by 1,2
)

---------------------------------churn----------------------------------------------------------------------------------------
,
customers_monthly as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
and plan_id not in (31,34)
and iso_date <<=current_date-2
)
,end_of_month_active as
(
select  date_trunc(iso_date,month)  as month,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
---and     subscription_state <<>> 'BILLING RETRY'
and     plan_id not in (31,34)
group by 1,2,3,4
)
,ranking_monthly as 
(
select *,date_trunc(up_for_renewal_date,month) as month
        ,row_number()over(partition by account_id,country,date_trunc(up_for_renewal_date,month) order by up_for_renewal_date desc ) as rank_number 
from  customers_monthly cm 
)


,churn_regular as (select cm.country
      ,cm.month as month
      ,count(distinct  cm.account_id  ) as regular_up_for_renewal

      ,count(distinct  case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as 
      regular_churned_customers

      from ranking_monthly cm
      left join end_of_month_active em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.month<<=current_date
and cm.rank_number = 1
group by 1,2)
----------------------------all churn---------------------------------------------------------------------------------------------

,
customers_monthly_all as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
--and plan_id not in (31,34)
and iso_date <<=current_date-2
)
,end_of_month_active_all as
(
select  date_trunc(iso_date,month)  as month,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
---and     subscription_state <<>> 'BILLING RETRY'
--and     plan_id not in (31,34)
group by 1,2,3,4
)
,ranking_monthly_all as 
(
select *,date_trunc(up_for_renewal_date,month) as month
        ,row_number()over(partition by account_id,country,date_trunc(up_for_renewal_date,month) order by up_for_renewal_date desc ) as rank_number 
from  customers_monthly cm 
)


,churn_all as (select cm.country
      ,cm.month as month
      ,count(distinct  cm.account_id  ) as up_for_renewal_all

      ,count(distinct  case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as 
      churned_customers_all

      from ranking_monthly_all cm
      left join end_of_month_active_all em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.month<<=current_date
and cm.rank_number = 1
group by 1,2)

----------------------------------------------------------------------------------------------------------------------------------------













select a.month,a.country,tpro_active_subscribers,total_active_subscribers,talabat_active,talabatgmv,talabatgmvmtd,platform_gmv,pro_vendor_gmv,pro_food_gmv,food_gmv,pro_nfv_gmv,nfv_gmv,
regular_up_for_renewal,regular_churned_customers,
Partner_GMVProCustomers,Regular_GMVProCustomers,Partner_GMVProCustomersMTD,Regular_GMVProCustomersMTD,
regular_acquisitions,partnerships_acquisitions, tpro_ltp_active_subscribers,partner_utilisation_tpro_orders,regular_utilisation_tpro_orders,partner_utilisation_all_orders,regular_utilisation_all_orders,pro_vendor_count,talabat_vendor_count,talabat_food_count,talabat_nfv_count,pro_food_count,pro_nfv_count,talabat_orders,up_for_renewal_all,churned_customers_all

from eom_active a
inner join talabat as b
on a.month=b.month
and a.country=b.country_iso
inner join acquisitions as c
on a.month=c.month
and a.country=c.country
inner join churn_regular as d
on a.month=d.month
and a.country=d.country
inner join tpro_kpis as e
on a.month=e.month
and a.country=e.country
left join platform_active as f
on a.month=f.month
and a.country=f.country_code
inner join churn_all as g
on a.month=g.month
and a.country=g.country
where a.month>>="2023-01-01"
order by a.country,a.month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0cr40up0kdefp819hjmyn08g3h5j' name='Custom SQL Query' type='text'><![CDATA[---Monthly Health Tab View------------------------------------------
with eom_active as
(
select  date_trunc(iso_date,month)  as month,
fs.country ,
count(distinct case when fs.plan_id not in (31,34) then fs.account_id end) as tpro_active_subscribers,
count(distinct case when plan_duration_days>>31 and is_visible and plan_price_lc <<>> 0 then fs.account_id end ) as tpro_ltp_active_subscribers,
count(distinct fs.account_id) as total_active_subscribers
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
and     subscription_state <<>> 'BILLING RETRY'
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on fs.plan_id=sp.plan_id
where date_trunc(iso_date,month)<<=date_trunc(current_date(),month)
group by 1,2)

,acquisitions as (
select country,date_trunc(date(start_date),month) as month, 
count(distinct case when plan_id in (31,34) then account_id end) as partnerships_acquisitions,
count(distinct case when plan_id not in (31,34) then account_id end) as regular_acquisitions
from `tlb-data-prod.data_platform_rest_tables.customers_d`
where subscription_state <<>> "BILLING RETRY"
group by 1,2
)

-- select 
-- plan_id,
-- count(distinct account_id) from 
-- `tlb-data-prod.data_platform_rest_tables.customers_d`
-- where subscription_state <<>> "BILLING RETRY" and date_trunc(start_date,month)="2024-01-01"
-- and country="AE"
-- group by 1


,tpro_kpis as (select o.country,
date_trunc(date,year) as year,
date_trunc(date, month) as month,
sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_id in (31,34) then (gmv_overall_eur) else 0 end )as Partner_GMVProCustomers,
sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_id not in (31,34) then (gmv_overall_eur) else 0 end )as Regular_GMVProCustomers,
sum(case when type in ("Daily") and sp.plan_id in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Partner_GMVProCustomersMTD,
sum(case when type in ("Daily") and sp.plan_id not in (31,34) and extract (day from date)<< extract(day from current_date()) then gmv_overall_eur end) as Regular_GMVProCustomersMTD,
sum(case when  type in ("Monthly") and sp.plan_id in (31,34) then tpro_orders  else 0 end ) as partner_utilisation_tpro_orders,
sum(case when type in ("Monthly") and sp.plan_id in (31,34) then overall_orders else 0 end ) as partner_utilisation_all_orders,
sum(case when  type in ("Monthly") and sp.plan_id not in (31,34) then tpro_orders  else 0 end ) as regular_utilisation_tpro_orders,
sum(case when type in ("Monthly") and sp.plan_id not in (31,34) then overall_orders else 0 end ) as regular_utilisation_all_orders
from tlb-data-prod.data_platform.agg_tpro_orders as o 
inner join tlb-data-prod.data_platform.dim_subscription_plan as sp
on o.plan_id=sp.plan_id
where 
is_visible
and date>>="2022-03-01"  --and type in ("Monthly")
and subs_type_upd = 'All'
group by 1,2,3
)


,talabat as (select date_trunc(order_date,month) as month,
country_iso,
ifnull (max(talabat_l30_active) ,max(talabat_active)) as talabat_active,
sum(gmv_amount_eur) as talabatgmv,
count(distinct order_id) as talabat_orders,
sum(case when extract (day from order_date)<< extract(day from current_date()) then gmv_amount_eur end) as talabatgmvmtd,
sum(coalesce(gmv_amount_lc,0)) as platform_gmv
,sum(case when pv.vendor_id is not null then gmv_amount_lc end) as pro_vendor_gmv,
count(distinct case when pv.vendor_id is not null then pv.vendor_id end) as pro_vendor_count,
count(distinct case when pv.vendor_id is not null and fi.is_non_food is false then pv.vendor_id end) as pro_food_count,
count(distinct case when pv.vendor_id is not null and fi.is_non_food  then pv.vendor_id end) as pro_nfv_count,
sum(case when pv.vendor_id is not null and fi.is_non_food is false then gmv_amount_lc end) as pro_food_gmv,sum(case when fi.is_non_food is false then gmv_amount_lc end) as food_gmv,sum(case when pv.vendor_id is not null and fi.is_non_food is true and not dv.is_grocery_darkstore then gmv_amount_lc end ) as pro_nfv_gmv,sum(case when fi.is_non_food is true and not dv.is_grocery_darkstore then gmv_amount_lc end) as nfv_gmv,
from `tlb-data-prod.data_platform.fct_order_info` fi
inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
on  fi.vendor_id = dv.vendor_id 
and  is_successful 
left join 
(select country,date_trunc(date,month) as month,(talabat_l30_active) ,(talabat_active) from tlb-data-prod.data_platform.agg_tpro_order_contribution  as oc
where type="Monthly"
group by 1,2,3,4) as oc
on date_trunc(fi.order_date,month)=oc.month
and fi.country_iso=oc.country
--and  country_iso = 'AE'
left join  `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history` pv
on   pv.date = date_add(last_day(date_trunc(order_date,month)),interval 1 day)
and  pv.vendor_id = fi.vendor_id 
where is_successful
and order_date>>="2023-01-01"
group by 1,2
)

,platform_active as (select
month,
country_code,
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) and dv.is_non_food is false then km.vendor_id end) as talabat_food_count,
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) and dv.is_non_food  then km.vendor_id end) as talabat_nfv_count,      
count(distinct case when km.vendor_id is not null and (km.is_active or is_zombie) then km.vendor_id end) as talabat_vendor_count
from `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` as km
inner join `tlb-data-prod.data_platform.dim_vendor_info` as dv
on km.vendor_id=dv.vendor_id
where month<<date_trunc(current_date(),month)
group by 1,2
)

---------------------------------churn----------------------------------------------------------------------------------------
,
customers_monthly as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
and plan_id not in (31,34)
and iso_date <<=current_date-2
)
,end_of_month_active as
(
select  date_trunc(iso_date,month)  as month,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
---and     subscription_state <<>> 'BILLING RETRY'
and     plan_id not in (31,34)
group by 1,2,3,4
)
,ranking_monthly as 
(
select *,date_trunc(up_for_renewal_date,month) as month
        ,row_number()over(partition by account_id,country,date_trunc(up_for_renewal_date,month) order by up_for_renewal_date desc ) as rank_number 
from  customers_monthly cm 
)


,churn_regular as (select cm.country
      ,cm.month as month
      ,count(distinct  cm.account_id  ) as regular_up_for_renewal

      ,count(distinct  case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as 
      regular_churned_customers

      from ranking_monthly cm
      left join end_of_month_active em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.month<<=current_date
and cm.rank_number = 1
group by 1,2)
----------------------------all churn---------------------------------------------------------------------------------------------

,
customers_monthly_all as 
(
select   fs.*
         ,date_add(iso_date,interval 1 day) as up_for_renewal_date
         from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`  fs 
where subscription_state <<>> 'BILLING RETRY'
and iso_date = date(end_date)
--and plan_id not in (31,34)
and iso_date <<=current_date-2
)
,end_of_month_active_all as
(
select  date_trunc(iso_date,month)  as month,fs.country ,fs.account_id,fs.subscription_state
from   `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select month_start_date,month_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      fs.iso_date = (case when month_start_date = date_trunc(current_date,month) then current_date-1 else month_end_date end )
---and     subscription_state <<>> 'BILLING RETRY'
--and     plan_id not in (31,34)
group by 1,2,3,4
)
,ranking_monthly_all as 
(
select *,date_trunc(up_for_renewal_date,month) as month
        ,row_number()over(partition by account_id,country,date_trunc(up_for_renewal_date,month) order by up_for_renewal_date desc ) as rank_number 
from  customers_monthly cm 
)


,churn_all as (select cm.country
      ,cm.month as month
      ,count(distinct  cm.account_id  ) as up_for_renewal_all

      ,count(distinct  case when em.account_id is null or (em.subscription_state = 'BILLING RETRY') then cm.account_id end) as 
      churned_customers_all

      from ranking_monthly_all cm
      left join end_of_month_active_all em 
on   cm.account_id = em.account_id 
and  cm.country = em.country
and  cm.month = em.month
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
on   fs.account_id = cm.account_id 
and  cm.up_for_renewal_date = fs.iso_date 
and  fs.plan_id = cm.plan_id 
and  fs.country = cm.country 
where   cm.month<<=current_date
and cm.rank_number = 1
group by 1,2)

----------------------------------------------------------------------------------------------------------------------------------------













select a.month,a.country,tpro_active_subscribers,total_active_subscribers,talabat_active,talabatgmv,talabatgmvmtd,platform_gmv,pro_vendor_gmv,pro_food_gmv,food_gmv,pro_nfv_gmv,nfv_gmv,
regular_up_for_renewal,regular_churned_customers,
Partner_GMVProCustomers,Regular_GMVProCustomers,Partner_GMVProCustomersMTD,Regular_GMVProCustomersMTD,
regular_acquisitions,partnerships_acquisitions, tpro_ltp_active_subscribers,partner_utilisation_tpro_orders,regular_utilisation_tpro_orders,partner_utilisation_all_orders,regular_utilisation_all_orders,pro_vendor_count,talabat_vendor_count,talabat_food_count,talabat_nfv_count,pro_food_count,pro_nfv_count,talabat_orders,up_for_renewal_all,churned_customers_all

from eom_active a
inner join talabat as b
on a.month=b.month
and a.country=b.country_iso
inner join acquisitions as c
on a.month=c.month
and a.country=c.country
inner join churn_regular as d
on a.month=d.month
and a.country=d.country
inner join tpro_kpis as e
on a.month=e.month
and a.country=e.country
left join platform_active as f
on a.month=f.month
and a.country=f.country_code
inner join churn_all as g
on a.month=g.month
and a.country=g.country
where a.month>>="2023-01-01"
order by a.country,a.month]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
