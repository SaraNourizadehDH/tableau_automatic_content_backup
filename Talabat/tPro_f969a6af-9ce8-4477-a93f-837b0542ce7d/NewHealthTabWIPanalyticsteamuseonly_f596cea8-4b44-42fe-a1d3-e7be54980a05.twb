      <column caption='LTP Adoption%' datatype='real' name='[Calculation_644577744498540558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers])/SUM([tpro_active_subscribers])' />
      </column>
      <column caption='GMV%' datatype='real' name='[Calculation_644577744498688015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Regular_GMVProCustomers])/SUM([talabatgmv])' />
      </column>
      <column caption='Churned Regular %' datatype='real' name='[Calculation_644577744506019856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([regular_churned_customers])/SUM([regular_up_for_renewal])' />
      </column>
      <column caption='All Acquisitions' datatype='integer' name='[Calculation_644577744507326483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partnerships_acquisitions])+SUM([regular_acquisitions])' />
      </column>
      <column caption='Adoption%' datatype='real' name='[Calculation_665969841693245449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_active_subscribers])/SUM([talabat_active])' />
