      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[sum:acquisitions:qk]&quot;' value='Acquisitions' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[sum:regular_acquisitions:qk]&quot;' value=' Acquisitions' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[sum:total_active_subscribers:qk]&quot;' value='Active Pro Subscribers ' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[sum:tpro_active_subscribers:qk]&quot;' value='Active Pro Subscribers' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_665969841674248192:qk]&quot;' value='Adoption% ' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_665969841677660166:qk]&quot;' value='Vendor GMV Coverage (food) % ' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_665969841678200839:qk]&quot;' value='Vendor GMV Coverage (NFV)%' />
          <alias key='&quot;[federated.1dspsjq15ygdnl1bej6tf0m2ef6n].[usr:Calculation_665969841678389256:qk]&quot;' value='Vendor GMV Coverage % (Overall)' />
        </aliases>
      </column>
      <column caption='LTP Adoption% ' datatype='real' name='[Adoption% (copy)_644577743855095808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers])/SUM([tpro_active_subscribers])' />
      </column>
      <column caption='Utilization%' datatype='real' name='[Calculation_644577743855374337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([regular_utilisation_tpro_orders])/SUM([regular_utilisation_all_orders])' />
      </column>
      <column caption='Vendor Count Coverage (Overall)' datatype='real' name='[Calculation_644577744151666690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_vendor_count])/SUM([talabat_vendor_count])' />
      </column>
      <column caption='Vendor Count Coverage %(Food)' datatype='real' name='[Calculation_644577744171859972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_food_count])/SUM([talabat_food_count])' />
      </column>
      <column caption='Customer Order%' datatype='real' name='[Calculation_644577744459816966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([regular_utilisation_tpro_orders])/SUM([talabat_orders])' />
      </column>
      <column caption='All Pro Subscribers' datatype='integer' name='[Calculation_644577744468733959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_active_subscribers]' />
      </column>
      <column caption='Total Acquisitions' datatype='integer' name='[Calculation_644577744469102600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partnerships_acquisitions])+SUM([regular_acquisitions])' />
      </column>
      <column caption='Total Adoption %' datatype='real' name='[Calculation_644577744469291017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_644577744468733959])/SUM([talabat_active])' />
      </column>
      <column caption='Total Customer Order %' datatype='real' name='[Calculation_644577744469663754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([regular_utilisation_tpro_orders])+SUM([partner_utilisation_tpro_orders]))/SUM([talabat_orders])' />
      </column>
      <column caption='Total Customer GMV%' datatype='real' name='[Calculation_644577744469975051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Partner_GMVProCustomers])+SUM([Regular_GMVProCustomers]))/&#13;&#10;SUM([talabatgmv])' />
      </column>
      <column caption='Churn % (Pro+Partnerships)' datatype='real' name='[Calculation_644577744475193357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_customers_all])/SUM([up_for_renewal_all])' />
      </column>
      <column caption='Adoption%' datatype='real' name='[Calculation_665969841674248192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_active_subscribers])/SUM([talabat_active])' />
      </column>
      <column caption='Churned %' datatype='real' name='[Calculation_665969841676103682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([regular_churned_customers])/SUM([regular_up_for_renewal])' />
      </column>
      <column caption='Customer GMV%' datatype='real' name='[Calculation_665969841676664836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Regular_GMVProCustomers])/SUM([talabatgmv])' />
