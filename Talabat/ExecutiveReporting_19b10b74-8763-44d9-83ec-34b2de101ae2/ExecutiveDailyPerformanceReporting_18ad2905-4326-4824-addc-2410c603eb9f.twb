            <column-instance column='[MTD vs. LY MTD Successful Orders (copy)_5550545805345845266]' derivation='User' name='[usr:MTD vs. LY MTD Successful Orders (copy)_5550545805345845266:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WTD WoW Successful Orders (copy)_5550545805345099792]' derivation='User' name='[usr:WTD WoW Successful Orders (copy)_5550545805345099792:qk]' pivot='key' type='quantitative' />
