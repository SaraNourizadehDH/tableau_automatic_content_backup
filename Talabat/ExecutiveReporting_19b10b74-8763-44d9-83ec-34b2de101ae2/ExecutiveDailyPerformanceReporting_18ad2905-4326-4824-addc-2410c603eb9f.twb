            </column>
            <column caption='Orders MTD vs LM MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[MTD vs. LY MTD Successful Orders (copy)_5550545805345845266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([orders_month_to_date]) - sum([orders_last_month_month_to_date]))/sum([orders_last_month_month_to_date])' />
