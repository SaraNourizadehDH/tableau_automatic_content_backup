      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_order_coo_dashboard (data_platform) (2)' name='federated.030vccq18lm9za1dbaog30w9cb8r' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.030vccq18lm9za1dbaog30w9cb8r].[Calculation_5550545805343584270]' caption='End Date 1' datatype='date' default-format='*mmm dd, yyyy' name='[Start Date (copy)_5550545805310132225 1]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-17#'>
              <calculation class='tableau' formula='#2024-11-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.030vccq18lm9za1dbaog30w9cb8r'>
            <column caption='Remove Saudi' datatype='boolean' name='[Calculation_192599261919182852]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code] != &apos;SA&apos;' />
            </column>
            <column caption='DATE = date' datatype='boolean' name='[Calculation_5550545805332668426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] = [Parameters].[Start Date (copy)_5550545805310132225 1]' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_5550545805343584270]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='GMV MTD vs LM MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Orders MTD vs LM MTD (copy)_130674765396037634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([gmv_month_to_date]) - sum([gmv_last_month_month_to_date]))/sum([gmv_last_month_month_to_date])' />
            </column>
            <column caption='GMV MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Orders MTD vs LY MTD (copy)_130674765396037635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(sum([Orders Month To Date]) - sum([Orders Last Year Month To Date]))/sum([Orders Last Year Month To Date])&#10;SUM([gmv_month_to_date])/SUM([gmv_last_year_month_to_date]) - 1' />
            </column>
            <column caption='GMV WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Orders WTD vs LW WTD (copy)_130674765396037633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_week_to_date])/SUM([gmv_last_week_to_same_day_last_week])-1' />
            </column>
            <column caption='GMV vs (Daily WoW)' datatype='real' default-format='*+0.00%;-0.00%' name='[Orders vs SDLW (copy)_130674765396037632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv])-SUM([gmv_same_day_last_week]))/SUM([gmv_same_day_last_week])' />
            </column>
            <column caption='Orders MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[WTD WoW Successful Orders (copy)_5550545805345099792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(sum([Orders Month To Date]) - sum([Orders Last Year Month To Date]))/sum([Orders Last Year Month To Date])&#10;SUM([orders_month_to_date])/SUM([orders_last_year_month_to_date]) - 1' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Gmv' datatype='real' name='[gmv]' role='measure' type='quantitative' />
