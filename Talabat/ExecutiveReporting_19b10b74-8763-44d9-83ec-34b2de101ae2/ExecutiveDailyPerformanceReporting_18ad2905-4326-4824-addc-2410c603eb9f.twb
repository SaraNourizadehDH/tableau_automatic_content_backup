              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.030vccq18lm9za1dbaog30w9cb8r].[usr:Calculation_5550545805344149519:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.030vccq18lm9za1dbaog30w9cb8r].[usr:MTD vs. LY MTD Successful Orders (copy)_5550545805345845266:qk]&quot;' />
