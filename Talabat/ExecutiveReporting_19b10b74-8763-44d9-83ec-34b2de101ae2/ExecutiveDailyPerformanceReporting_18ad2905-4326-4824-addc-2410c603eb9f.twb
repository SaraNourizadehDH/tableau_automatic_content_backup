    <worksheet name='Contact Rate trend (Actuals)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#e3642b' fontname='Tableau Medium' fontsize='14'>Last 7 Days vs WoW (Actuals)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
