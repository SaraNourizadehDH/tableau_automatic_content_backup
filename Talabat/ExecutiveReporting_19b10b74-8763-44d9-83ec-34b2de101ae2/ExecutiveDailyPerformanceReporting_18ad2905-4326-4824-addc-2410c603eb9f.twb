            </column>
            <column caption='Last 12 days' datatype='boolean' name='[Last 7 days (copy)_861876382579281920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt; DATEADD(&apos;day&apos;,-12,[Parameters].[Start Date (copy)_5550545805310132225 1])&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5550545805310132225 1]' />
