            </column>
            <column caption='Orders 40 Min Delivery WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate WTD vs LW WTD (copy)_3281857499424178181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_40_min_delivery_week_to_date])/SUM([orders_week_to_date]))&#10;-&#10;(SUM([orders_40_min_delivery_last_week_to_same_day_last_week])/SUM([orders_last_week_to_same_day_last_week]))' />
            </column>
