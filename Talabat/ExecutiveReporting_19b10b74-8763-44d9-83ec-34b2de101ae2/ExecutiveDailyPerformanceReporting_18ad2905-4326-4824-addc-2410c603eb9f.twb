              <calculation class='tableau' formula='[country_code] != &apos;SA&apos;' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_5550545805343584270]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='&apos;Trend 30 Days Rolling&apos;' datatype='string' name='[Calculation_6488350062926061572]' role='dimension' type='nominal' user:unnamed='Successful Orders (6)'>
              <calculation class='tableau' formula='&apos;Trend 30 Days Rolling&apos;' />
            </column>
            <column caption='Last 12 days' datatype='boolean' name='[Last 7 days (copy)_861876382579281920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt; DATEADD(&apos;day&apos;,-12,[Parameters].[Start Date (copy)_5550545805310132225 1])&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5550545805310132225 1]' />
            </column>
