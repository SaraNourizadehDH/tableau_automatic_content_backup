    <worksheet name='Country % (Net Failed Orders)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#e3642b' fontname='Tableau Medium' fontsize='14'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_order_coo_dashboard (data_platform) (2)' name='federated.030vccq18lm9za1dbaog30w9cb8r' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.030vccq18lm9za1dbaog30w9cb8r].[Calculation_5550545805343584270]' caption='End Date 1' datatype='date' default-format='*mmm dd, yyyy' name='[Start Date (copy)_5550545805310132225 1]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-17#'>
              <calculation class='tableau' formula='#2024-11-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.030vccq18lm9za1dbaog30w9cb8r'>
            <column caption='Remove Saudi' datatype='boolean' name='[Calculation_192599261919182852]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code] != &apos;SA&apos;' />
            </column>
            <column caption='DATE = date' datatype='boolean' name='[Calculation_5550545805332668426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] = [Parameters].[Start Date (copy)_5550545805310132225 1]' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_5550545805343584270]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='AOV MTD vs LM MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV MTD vs LM MTD (copy)_1282611108236955648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([gmv_month_to_date])/SUM([orders_month_to_date])) / &#10;(sum([gmv_last_month_month_to_date])/SUM([orders_last_month_month_to_date])) - 1' />
            </column>
            <column caption='Net Failed Orders MTD vs LM MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV MTD vs LM MTD (copy)_1866390210187669504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([net_failed_orders_month_to_date]) / sum([orders_month_to_date]) )&#10;-&#10;(sum([net_failed_orders_last_month_month_to_date]) / sum([orders_last_month_month_to_date]) )' />
            </column>
            <column caption='AOV MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV MTD vs LY MTD (copy)_1282611108236955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([gmv_month_to_date])/SUM([orders_month_to_date])) / &#10;(sum([gmv_last_year_month_to_date])/SUM([orders_last_year_month_to_date])) - 1' />
            </column>
            <column caption='Net Failed Orders MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV MTD vs LY MTD (copy)_1866390210187669505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([net_failed_orders_month_to_date]) / SUM([orders_month_to_date]) )&#10;-&#10;(SUM([net_failed_orders_last_year_month_to_date]) / SUM([orders_last_year_month_to_date]) )' />
            </column>
            <column caption='AOV WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV WTD vs LW WTD (copy)_1282611108236955650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_week_to_date])/SUM([orders_week_to_date]))/&#10;(SUM([gmv_last_week_to_same_day_last_week])/SUM([orders_last_week_to_same_day_last_week]))&#10;-1' />
            </column>
            <column caption='Net Failed Orders WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV WTD vs LW WTD (copy)_1866390210187669506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([net_failed_orders_week_to_date])/SUM([orders_week_to_date]))&#10;-&#10;(SUM([net_failed_orders_last_week_to_same_day_last_week])/SUM([orders_last_week_to_same_day_last_week]))' />
            </column>
            <column caption='AOV vs (Daily WoW)' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV vs SDLW (copy)_1282611108236955651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv])/SUM([orders]))/&#10;(SUM([gmv_same_day_last_week])/SUM([orders_same_day_last_week]))&#10;-1' />
            </column>
            <column caption='Net Failed Orders vs (Daily WoW)' datatype='real' default-format='*+0.00%;-0.00%' name='[GMV vs SDLW (copy)_1866390210187669507]' role='measure' type='quantitative'>
