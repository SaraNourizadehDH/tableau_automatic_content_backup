              <calculation class='tableau' formula='(SUM([orders_40_min_delivery_month_to_date])/SUM([orders_month_to_date]))&#10;-&#10;(SUM([orders_40_min_delivery_last_month_month_to_date])/SUM([orders_last_month_month_to_date]))' />
