              <calculation class='tableau' formula='#2024-11-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.030vccq18lm9za1dbaog30w9cb8r'>
            <column caption='Remove Saudi' datatype='boolean' name='[Calculation_192599261919182852]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code] != &apos;SA&apos;' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_5550545805343584270]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='&apos;Trend 30 Days Rolling&apos;' datatype='string' name='[Calculation_6488350063288315909]' role='dimension' type='nominal' user:unnamed='Successful Orders (5)'>
              <calculation class='tableau' formula='&apos;Trend 30 Days Rolling&apos;' />
            </column>
            <column caption='Last 12 days' datatype='boolean' name='[Last 7 days (copy)_861876382579281920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt; DATEADD(&apos;day&apos;,-12,[Parameters].[Start Date (copy)_5550545805310132225 1])&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5550545805310132225 1]' />
            </column>
            <column caption='Rolling 30 Days Aov' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Rolling 30 Days Gmv (copy)_1282611108241825796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rolling_30_days_gmv])/SUM([rolling_30_days_order_count])' />
