      <column caption='AOV Same Day Last Week' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_1282611108326150154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gmv_same_day_last_week])/SUM([orders_same_day_last_week]))' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aov (copy)_1282611108243288073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])/SUM([orders])' />
      </column>
      <column caption='Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_1866390210277629956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_with_contact])/SUM([orders])' />
      </column>
      <column caption='Remove Saudi' datatype='boolean' name='[Calculation_192599261919182852]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_code] != &apos;SA&apos;' />
      </column>
      <column caption='Best Estimate Achievement %' datatype='real' default-format='*+0.00%;-0.00%' name='[Calculation_4906671800988504066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([run_rate_order_count])/SUM([best_estimate_order_count])' />
      </column>
      <column caption='Orders vs (Daily WoW)' datatype='real' default-format='*+0.00%;-0.00%' name='[Calculation_5550545805325561862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders])-SUM([orders_same_day_last_week]))/SUM([orders_same_day_last_week])' />
      </column>
      <column caption='DATE = date' datatype='boolean' name='[Calculation_5550545805332668426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = [Parameters].[Start Date (copy)_5550545805310132225 1]' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_5550545805343584270]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{MAX([date])}' />
      </column>
      <column caption='Orders WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Calculation_5550545805344149519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_week_to_date])/SUM([orders_last_week_to_same_day_last_week])-1' />
      </column>
      <column caption='Last 7 days' datatype='boolean' name='[Calculation_5550545805347029011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt; DATEADD(&apos;day&apos;,-7,[Parameters].[Start Date (copy)_5550545805310132225 1])&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5550545805310132225 1]' />
      </column>
      <column caption='Contact Rate Same Day Last Week' datatype='real' default-format='p0.0%' name='[Contact Rate (copy)_1866390210281168905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_with_contact_same_day_last_week])/SUM([orders_same_day_last_week])' />
      </column>
      <column caption='Rolling 7 Days Contact Rate' datatype='real' default-format='p0.0%' name='[Contact Rate (copy)_3281857499416412160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rolling_7_days_orders_with_contact])/SUM([rolling_7_days_order_count])' />
      </column>
      <column caption='Orders 40 Min Delivery Rate' datatype='real' default-format='p0.0%' name='[Contact Rate (copy)_3281857499423219714]' role='measure' type='quantitative'>
