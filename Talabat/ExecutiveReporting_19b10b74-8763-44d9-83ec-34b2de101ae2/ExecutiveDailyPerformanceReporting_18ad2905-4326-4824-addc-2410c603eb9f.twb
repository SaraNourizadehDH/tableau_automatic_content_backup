            <column caption='Orders 40 Min Delivery MTD vs LM MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate MTD vs LM MTD (copy)_3281857499424178179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_40_min_delivery_month_to_date])/SUM([orders_month_to_date]))&#10;-&#10;(SUM([orders_40_min_delivery_last_month_month_to_date])/SUM([orders_last_month_month_to_date]))' />
            </column>
            <column caption='Orders 40 Min Delivery MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate MTD vs LY MTD (copy)_3281857499424178180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_40_min_delivery_month_to_date])/SUM([orders_month_to_date]))&#10;-&#10;(SUM([orders_40_min_delivery_last_year_month_to_date])/SUM([orders_last_year_month_to_date]))' />
            </column>
            <column caption='Orders 40 Min Delivery WTD vs LW WTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate WTD vs LW WTD (copy)_3281857499424178181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_40_min_delivery_week_to_date])/SUM([orders_week_to_date]))&#10;-&#10;(SUM([orders_40_min_delivery_last_week_to_same_day_last_week])/SUM([orders_last_week_to_same_day_last_week]))' />
            </column>
            <column caption='Orders 40 Min Delivery vs (Daily WoW)' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate vs SDLW (copy)_3281857499424178182]' role='measure' type='quantitative'>
