      </column>
      <column caption='Orders 40 Min Delivery MTD vs LY MTD' datatype='real' default-format='*+0.00%;-0.00%' name='[Contact Rate MTD vs LY MTD (copy)_3281857499424178180]' role='measure' type='quantitative'>
