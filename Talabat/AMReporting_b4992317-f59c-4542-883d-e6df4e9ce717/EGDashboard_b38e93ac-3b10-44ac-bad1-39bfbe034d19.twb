  <column aggregation='User' caption='Avg. Daily Vouchers Orders' datatype='real' default-type='quantitative' name='[Avg. Daily Talabat Vouchers Orders (copy)_1374160891847503872]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
