            <column aggregation='User' caption='Avg. Daily Organic non Talabat Funded Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_279786135159197698]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [offer_type]=&apos;None&apos; or [offer_type]=&apos;Vendor&apos; THEN [Successful] END)&#13;&#10;/ COUNTD([order_date])' />
