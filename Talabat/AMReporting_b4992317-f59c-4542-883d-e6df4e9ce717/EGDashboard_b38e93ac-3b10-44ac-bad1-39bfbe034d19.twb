              <calculation class='tableau' formula='SUM([Order Related Cases (copy)_846958272365285376]) / SUM([Gross]) * 100&#13;&#10;//(SUM([Order Related Chats]) + SUM([Order Related Cases])) / SUM([Order Related Gross]) * 100' />
