ndor Vouchers Orders&quot;&#13;&#10;when &quot;Avg. Daily tRewards Orders&quot; then &quot;Avg. Daily tRewards Orders&quot;&#13;&#10;&#13;&#10;when &quot;Avg. Daily Organic Orders&quot; then &quot;Avg. Daily Organic Orders&quot;&#13;&#10;when &quot;Avg. Daily Organic non Vendor Funded Orders&quot; then &quot;Avg. Daily Organic non Vendor Funded Orders&quot;&#13;&#10;when &quot;Avg. Daily Organic non Talabat Funded Orders&quot; then &quot;Avg. Daily Organic non Talabat Funded Orders&quot;&#13;&#10;&#13;&#10;when &quot;Avg. Daily Organic Orders %&quot; then &quot;Avg. Daily Organic Orders %&quot;&#13;&#10;when &quot;Avg. Daily Organic non Talabat Funded Orders %&quot; then &quot;Avg. Daily Organic non Talabat Funded Orders %&quot;&#13;&#10;when &quot;Avg. Daily Organic non Vendor Funded Orders %&quot; then &quot;Avg. Daily Organic non Vendor Funded Orders %&quot;&#13;&#10;&#13;&#10;WHEN &quot;Commission %&quot; THEN &quot;Commission %&quot;&#13;&#10;when &quot;Finance Commission %&quot; THEN &quot;Finance Commission %&quot;&#13;&#10;&#13;&#10;when &quot;On Time %&quot; then &quot;On Time %&quot;&#13;&#10;when &quot;Delayed Orders &gt; 10 %&quot; then &quot;Delayed Orders &gt; 10 %&quot;&#13;&#10;&#13;&#10;when &quot;NPS %&quot; then &quot;NPS %&quot;&#13;&#10;&#13;&#10;when &quot;Avg. Item Price&quot; then &quot;Avg. Item Price&quot;&#13;&#10;when &quot;Avg. Items per Order&quot; then &quot;Avg. Items per Order&quot;&#13;&#10;&#13;&#10;WHEN &quot;Avg SF % of AFV&quot; THEN &quot;Avg SF % of AFV&quot;&#13;&#10;WHEN &quot;Avg EF % of AFV&quot; THEN &quot;Avg EF % of AFV&quot;&#13;&#10;&#13;&#10;WHEN &quot;Avg. Commission&quot; THEN &quot;Avg. Commission&quot;&#13;&#10;WHEN &quot;Seamless Orders %&quot; THEN &quot;Seamless Orders %&quot;&#13;&#10;&#13;&#10;when &quot;Avg. Daily Voucher Code&quot; then &quot;Avg. Daily Voucher Code&quot;&#13;&#10;when &quot;Avg. Daily Marketing Voucher&quot; then &quot;Avg. Daily Marketing Voucher&quot;&#13;&#10;when &quot;Avg. Daily Comp