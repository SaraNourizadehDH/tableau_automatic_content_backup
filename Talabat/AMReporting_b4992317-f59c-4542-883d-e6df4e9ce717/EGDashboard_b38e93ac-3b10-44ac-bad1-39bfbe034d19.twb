              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;when &quot;Gross Orders&quot; then &quot;Gross Orders&quot;&#13;&#10;when &quot;Successful Orders&quot; then &quot;Successful Orders&quot;&#13;&#10;when &quot;Net Failed Orders&quot; then &quot;Net Failed Orders&quot;&#13;&#10;when &quot;NFR %&quot; then &quot;NFR %&quot;&#13;&#10;when &quot;HFR %&quot; then &quot;HFR %&quot;&#13;&#10;when &quot;Vendor FR%&quot; then &quot;Vendor FR%&quot;&#13;&#10;when &quot;Voucher Orders&quot; then &quot;Voucher Orders&quot;&#13;&#10;when &quot;Voucher Orders %&quot; then &quot;Voucher Orders %&quot;&#13;&#10;when &quot;Talabat-Funded Orders&quot; then &quot;Talabat-Funded Orders&quot;&#13;&#10;when &quot;Talabat-Funded Orders %&quot; then &quot;Talabat-Funded Orders %&quot;&#13;&#10;when &quot;Vendor-Funded Orders&quot; then &quot;Vendor-Funded Orders&quot;&#13;&#10;when &quot;Vendor-Funded Orders %&quot; then &quot;Vendor-Funded Orders %&quot;&#13;&#10;when &quot;Funded Orders&quot; then &quot;Funded Orders&quot;&#13;&#10;when &quot;Funded Orders %&quot; then &quot;Funded Orders %&quot;&#13;&#10;when &quot;Talabat Fund Amount&quot; then &quot;Talabat Fund Amount&quot;&#13;&#10;when &quot;Talabat Fund Amount (GMV %)&quot; then &quot;Talabat Fund Amount (GMV %)&quot;&#13;&#10;when &quot;Vendor Fund Amount&quot; then &quot;Vendor Fund Amount&quot;&#13;&#10;when &quot;Vendor Fund Amount (GMV %)&quot; then &quot;Vendor Fund Amount (GMV %)&quot;&#13;&#10;when &quot;Fund Amount&quot; then &quot;Fund Amount&quot;&#13;&#10;when &quot;Fund Amount (GMV %)&quot; then &quot;Fund Amount (GMV %)&quot;&#13;&#10;when &quot;Vendor Late &gt;10 V2&quot; then &quot;Vendor Late &gt;10 V2&quot;&#13;&#10;when &quot;Vendor Late &gt;5 V2&quot; then &quot;Vendor Late &gt;5 V2&quot;&#13;&#10;when &quot;Avg Order Delay&quot; then &quot;Avg Order Delay&quot;&#13;&#10;when &quot;Acquisitions&quot; then &quot;Acquisitions&quot;&#13;&#10;when &quot;Avg Delivery Fees&quot; then &quot;Avg Delivery Fees&quot;&#13;&#10;when &quot;TGO Orders&quot; then &quot;TGO Orders&quot;&#13;&#10;when &quot;TGO Share %&quot; then &quot;TGO Share %&quot;&#13;&#10;when &quot;Stacked Orders %&quot; then &quot;Stacked Orders %&quot;&#13;&#10;when &quot;Avg Rider acceptance time&quot; then &quot;Avg Rider acceptance time&quot;&#13;&#10;when &quot;Avg. Daily Orders&quot; then &quot;Avg. Daily orders&quot;&#13;&#10;when &quot;Avg. Daily GMV&quot; then &quot;Avg. Daily GMV&quot;&#13;&#10;when &quot;Order Related CR %&quot; then &quot;Order Related CR %&quot;&#13;&#10;when &quot;Avg. Service fees&quot; then &quot;Avg. Service fees&quot;&#13;&#10;when &quot;Avg. Effective fees&quot; then &quot;Avg. Effective fees&quot;&#13;&#10;when &quot;Avg. Food Value&quot; then &quot;Avg. Food Value&quot;&#13;&#10;when &quot;Chain Orders Contribution %&quot; then &quot;Chain Orders Contribution %&quot;&#13;&#10;when &quot;GMV&quot; then &quot;GMV&quot;&#13;&#10;when &quot;Avg. Paid Delivery Fees&quot; then &quot;Avg. Paid Delivery Fees&quot;&#13;&#10;when &quot;Avg. Paid Service Fees&quot; then &quot;Avg. Paid Service Fees&quot;&#13;&#10;when &quot;% of orders by healthy customers&quot; then &quot;% of orders by healthy customers&quot;&#13;&#10;&#13;&#10;when &quot;Avg. Daily Free Delivery Orders&quot; then &quot;Avg. Daily Free Delivery Orders&quot;&#13;&#10;when &quot;Avg. Daily Discounted Delivery Orders&quot; then &quot;Avg. Daily Discounted Delivery Orders&quot;&#13;&#10;when &quot;Avg. Daily Gem Orders&quot; then &quot;Avg. Daily Gem Orders&quot;&#13;&#10;when &quot;Avg. Daily Restaurant Funded Orders&quot; then &quot;Avg. Daily Restaurant Funded Orders&quot;&#13;&#10;when &quot;Avg. Daily Item Funded Orders&quot; then &quot;Avg. Daily Item Funded Orders&quot;&#13;&#10;when &quot;Avg. Daily Talabat Vouchers Orders&quot; then &quot;Avg. Daily Talabat Vouchers Orders&quot;&#13;&#10;when &quot;Avg. Daily Vendor Vouchers Orders&quot; then &quot;Avg. Daily Ve