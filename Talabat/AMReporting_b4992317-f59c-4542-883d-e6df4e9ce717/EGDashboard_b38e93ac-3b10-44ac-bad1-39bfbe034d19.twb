        <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [gem_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_gem_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_gem_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
