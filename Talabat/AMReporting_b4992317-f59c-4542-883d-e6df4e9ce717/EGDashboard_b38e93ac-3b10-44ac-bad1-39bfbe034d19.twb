            <ordinal>122</ordinal>
            <layered>true</layered>
            <caption>KPI2 Table</caption>
            <local-type>real</local-type>
            <aggregation>User</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='integer' name='field-type'>0</attribute>
              <attribute datatype='string' name='formula'>&quot;case [Parameters].[KPI 1 (copy)_768989670986936324]&#13;
when \&quot;Gross Orders\&quot; then SUM([Gross])&#13;
when \&quot;Successful Orders\&quot; then SUM([Successful])&#13;
when \&quot;Avg. Daily Orders\&quot; then SUM([Successful]) /  COUNTD([order_date])&#13;
when \&quot;Net Failed Orders\&quot; then SUM([Net_Failed])&#13;
when \&quot;NFR \%\&quot; then SUM([Net_Failed]) / SUM([Net]) * 100&#13;
when \&quot;HFR \%\&quot; then SUM([Failed]) / SUM([Gross]) * 100&#13;
when \&quot;Vendor FR\%\&quot; then SUM([Vendor_FR_3]) / SUM([Net]) *100&#13;
when \&quot;Order Related CR \%\&quot; then [Calculation_1108167025630093312]&#13;
&#13;
when \&quot;Voucher Orders\&quot; then SUM([Voucher])&#13;
when \&quot;Voucher Orders \%\&quot; then SUM([Voucher]) / SUM([Successful]) * 100&#13;
when \&quot;Talabat-Funded Orders\&quot; then SUM([Talabat_funded_orders])&#13;
when \&quot;Talabat-Funded Orders \%\&quot; then SUM([Talabat_funded_orders]) / SUM([Successful]) * 100&#13;
when \&quot;Vendor-Funded Orders\&quot; then SUM([Vendor_Fund])&#13;
when \&quot;Vendor-Funded Orders \%\&quot; then SUM([Vendor_Fund]) / SUM([Successful]) * 100&#13;
when \&quot;Funded Orders\&quot; then SUM([Funded_Orders])&#13;
when \&quot;Funded Orders \%\&quot; then SUM([Funded_Orders]) / SUM([Successful]) * 100&#13;
when \&quot;Talabat Fund Amount\&quot; then SUM([Talabat_fund_amount])&#13;
when \&quot;Talabat Fund Amount (GMV \%)\&quot; then SUM([Talabat_fund_amount]) / SUM([GMV]) * 100&#13;
when \&quot;Vendor Fund Amount\&quot; then SUM([Vendor_Fund_amount])&#13;
when \&quot;Vendor Fund Amount (GMV \%)\&quot; then SUM([Vendor_Fund_amount]) / SUM([GMV]) * 100&#13;
when \&quot;Fund Amount\&quot; then SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])&#13;
when \&quot;Fund Amount (GMV \%)\&quot; then (SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])) / SUM([GMV]) * 100&#13;
&#13;
when \&quot;Vendor Late &gt;10 V2\&quot; then SUM([Late_600]) / SUM([Late_not_null]) * 100&#13;
when \&quot;Vendor Late &gt;5 V2\&quot; then SUM([Late_300]) / SUM([Late_not_null]) * 100&#13;
when \&quot;Avg Order Delay\&quot; then (SUM([Average_delay]) / SUM([delayed_orders])) / 60&#13;
when \&quot;Stacked Orders \%\&quot; then [Calculation_1913466902577307648]&#13;
when \&quot;Avg Rider acceptance time\&quot; then (SUM([rider_acc_time]) / SUM([rider_acc_time_not_null])) / 60&#13;
when \&quot;TGO Orders\&quot; then SUM([TGO])&#13;
when \&quot;TGO Share \%\&quot; then SUM([TGO]) / SUM([Successful]) * 100&#13;
when \&quot;On Time \%\&quot; then [Calculation_1367405496446644224]*100&#13;
when \&quot;Delayed Orders &gt; 10 \%\&quot; then [Calculation_2346656912126193665]&#13;
&#13;
when \&quot;Acquisitions\&quot; then SUM([Acquisition])&#13;
when \&quot;\% of orders by healthy customers\&quot; then [Calculation_642607372759633920]&#13;
when \&quot;Chain Orders Contribution \%\&quot; then [Calculation_1119988996971290624]&#13;
&#13;
when \&quot;Avg. Delivery Fees (Cust. Pay)\&quot; then SUM([DF]) / SUM([DF_count])&#13;
when \&quot;Avg. Delivery Fees\&quot; then SUM([t_df]) / SUM([DF_count])&#13;
when &apos;Avg. Delivery Fees (Ven. Fund)&apos; then ((sum(t_df))-sum([DF]))/SUM([DF_count]) &#13;
when \&quot;Avg. Service fees\&quot; then SUM([service_fee]) / SUM([DF_count])&#13;
when \&quot;Avg. Small Order Fee\&quot; then [Calculation_1004584238208241664]&#13;
when \&quot;Avg. Effective fees\&quot; then [Calculation_1141099597754753025]&#13;
when \&quot;Avg. Paid Delivery Fees\&quot; then [Calculation_851180330467799040]&#13;
when \&quot;Avg. Paid Service Fees\&quot; then [Calculation_851180330467913729]&#13;
when \&quot;Avg. Paid Small Order Fee\&quot; then [Avg. Paid Service Fees (copy)_1217097853038202880]&#13;
when \&quot;Avg. Paid Effective Fees\&quot; then [Avg. Paid Delivery Fees (copy)_1217097853038686209]&#13;
