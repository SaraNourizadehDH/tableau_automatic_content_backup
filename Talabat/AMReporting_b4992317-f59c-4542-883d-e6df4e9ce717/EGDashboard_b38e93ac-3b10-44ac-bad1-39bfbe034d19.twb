      <table>
        <view>
          <datasources>
            <datasource caption='Fail Reasons' name='federated.1m6o02n1xam6rj145dzdj0pvvn4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='HFR View' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;HFR&quot;'>
              <calculation class='tableau' formula='&quot;HFR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m6o02n1xam6rj145dzdj0pvvn4t'>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827211923457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column caption='Date Level' datatype='datetime' name='[Calculation_281193540027432960]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Day&apos; then [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [order_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;END' />
            </column>
            <column caption='HFR' datatype='real' name='[Calculation_281193540027944961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_474003911705030657]) / SUM([Gross]) * 100' />
            </column>
            <column caption='failed_orders' datatype='integer' name='[Calculation_474003911705030657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;HFR&apos; THEN [Failed]&#13;&#10;WHEN &apos;True HFR&apos; THEN [true_failed_order]&#13;&#10;END' />
            </column>
            <column caption='Reason: Sub Reason' datatype='string' name='[Calculation_982910658685767681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reason]+ if not ([sub_reason] = &quot;N/A&quot;) then &quot;:&quot;+[sub_reason] else &quot;&quot; END' />
            </column>
            <column datatype='integer' name='[Failed]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Gross]' role='measure' type='quantitative' />
            <column caption='HFR owner' datatype='real' name='[HFR (copy)_850054432677924864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Failed]) / SUM( { FIXED [order_date] : SUM([Gross])} ) * 100&#13;&#10;&#13;&#10;//SUM([Failed])&#13;&#10;&#13;&#10;//SUM( { FIXED [order_date] : SUM([Gross])} )&#13;&#10;&#13;&#10;&#13;&#10;CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Week&apos; THEN SUM([Calculation_474003911705030657]) / SUM( { FIXED WEEK([order_date]):SUM([Gross])} ) * 100&#13;&#10;WHEN &apos;Month&apos; THEN SUM([Calculation_474003911705030657]) / SUM( { FIXED MONTH([order_date]):SUM([Gross])} ) * 100&#13;&#10;WHEN &apos;Day&apos; THEN SUM([Calculation_474003911705030657]) / SUM( { FIXED [order_date]:SUM([Gross])} ) * 100&#13;&#10;&#13;&#10;END' />
            </column>
