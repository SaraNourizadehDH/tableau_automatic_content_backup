              <calculation class='tableau' formula='//SUM([Successful]) / TOTAL( COUNTD([order date]) )&#13;&#10;{ FIXED [chain_name] : SUM([Successful]) } / { FIXED : COUNTD([order_date])  }' />
            </column>
