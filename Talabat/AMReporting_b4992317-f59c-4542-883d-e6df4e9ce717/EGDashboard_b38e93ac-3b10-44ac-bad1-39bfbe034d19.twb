        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[order_date]) = DATETRUNC(&apos;month&apos;,TODAY()-1) then [Order Related Cases (copy)_846958272365285376] end))&#13;&#10;/&#13;&#10;sum(IF DATETRUNC(&apos;month&apos;,[order_date]) = DATETRUNC(&apos;month&apos;,TODAY()-1) then [Gross] end)' />
      </column>
      <column aggregation='User' caption='CR Diff' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1268889222703837190]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Calculation_1268889222703489029] - &#13;&#10;(&#13;&#10;(SUM(if DATETRUNC(&apos;month&apos;,[order_date])= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1) )&#13;&#10;                  then [Order Related Cases (copy)_846958272365285376] end))&#13;&#10;/&#13;&#10;sum(if DATETRUNC(&apos;month&apos;,[order_date])= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1) )&#13;&#10;                  then [Gross] end)&#13;&#10;)' />
