            <column aggregation='User' caption='Avg. Daily Organic Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_279786135154614272]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [offer_type] = &apos;None&apos;  then [Successful] else 0 END)&#13;&#10;/ COUNTD([order_date])' />
