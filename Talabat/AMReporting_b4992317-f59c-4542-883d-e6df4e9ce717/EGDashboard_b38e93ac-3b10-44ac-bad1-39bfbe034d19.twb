    <worksheet name='Avg. Daily Fund amount &amp; Fund as % of GMV (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca'>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Americana_chains]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Weekday' datatype='string' default-type='nominal' layered='true' name='[Calculation_1213720127609049088]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827201437696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Chain Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_3766557407763734528]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Americana_chains]=&apos;Americana&apos; THEN &apos;Americana&apos;&#10;ELSEIF [chain_id] in (&#10;&apos;694639&apos;, //3m shatltat&#10;&apos;677850&apos;, //konafa w basbosa&#10;&apos;677778&apos;, //blaban&#10;&apos;686788&apos;, //wahmy burger&#10;&apos;689801&apos;, //karam elsham&#10;&apos;687553&apos; //bahij&#10;) THEN &apos;B.Laban &amp; Co.&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column aggregation='Year' caption='Date Level' datatype='datetime' default-type='ordinal' layered='true' name='[Calculation_383368955007725569]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Day&apos; then [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [order_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Talabat Fund as % of GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' default-type='quantitative' layered='true' name='[Calculation_540431998390366211]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_675821461914652673] / [Calculation_964896256219947010] * 100' />
            </column>
            <column aggregation='User' caption='Vendor Fund as % of GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' default-type='quantitative' layered='true' name='[Calculation_540431998390464516]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_675821461914570752] / [Calculation_964896256219947010] * 100' />
            </column>
            <column aggregation='User' caption='Avg. Daily Vendor Fund' datatype='real' default-type='quantitative' layered='true' name='[Calculation_675821461914570752]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Vendor_Fund_amount]) / COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Talabat Fund' datatype='real' default-type='quantitative' layered='true' name='[Calculation_675821461914652673]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Talabat_fund_amount]) / COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily GMV' datatype='real' default-type='quantitative' layered='true' name='[Calculation_964896256219947010]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([GMV]) / COUNTD([order_date])' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[GMV]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[Talabat_fund_amount]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
