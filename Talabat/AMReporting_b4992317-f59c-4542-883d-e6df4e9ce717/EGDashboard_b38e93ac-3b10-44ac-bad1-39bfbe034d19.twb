        <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [trewards_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_trewards_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_trewards_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
