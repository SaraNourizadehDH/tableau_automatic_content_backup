            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='KPI 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. Daily Orders&quot;'>
              <calculation class='tableau' formula='&quot;Avg. Daily Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca'>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[ADF]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[ADF_count]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='User' caption='AFV_tgo_tmp' datatype='real' default-type='quantitative' layered='true' name='[AFV (copy)_1090997064012828672]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [is_tgo]!=&apos;PICKUP&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Basket] END) &#13;&#10;/ SUM(IF [is_tgo]!=&apos;PICKUP&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Successful] END)' />
            </column>
            <column aggregation='User' caption='AFV_tgo' datatype='real' default-type='quantitative' layered='true' name='[AFV_tgo_tmp (copy)_1702501458179063817]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [is_tgo]=&apos;TGO&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Basket] END) &#13;&#10;/ SUM(IF [is_tgo]=&apos;TGO&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Successful] END)' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[ASF]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[ASOF]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[Acquisition]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Americana_chains]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[Average_delay]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='User' caption='Avg. Daily Organic Orders %' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Organic Orders (copy)_279786135174328323]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [offer_type] = &apos;None&apos;  then [Successful] else 0 END)&#13;&#10;/ SUM([Successful]) * 100' />
            </column>
            <column aggregation='User' caption='Avg. Daily Organic non Talabat Funded Orders %' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Organic non Talabat Funded Orders (copy)_279786135175995396]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [offer_type]=&apos;None&apos; or [offer_type]=&apos;Vendor&apos; THEN [Successful] END)&#13;&#10;/ SUM([Successful]) * 100' />
            </column>
            <column aggregation='User' caption='Avg. Daily Organic non Vendor Funded Orders %' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Organin non Vendor Funded Orders (copy)_279786135176896517]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF [offer_type] =&apos;None&apos; or [offer_type]=&apos;Talabat&apos; then [Successful] END)&#13;&#10;/ SUM([Successful]) * 100' />
            </column>
            <column aggregation='User' caption='Avg. Delivery Fees' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Avg. Delivery Fees (Cust. Pay) (copy)_1238771408544116736]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([t_df]) / SUM([DF_count])*1.14' />
            </column>
            <column aggregation='Sum' caption='Total Paid EF' datatype='real' default-type='quantitative' layered='true' name='[Avg. Effective fees (copy)_3620401577221201954]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[ADF]+[ASF]+[ASOF]' />
            </column>
            <column aggregation='User' caption='Avg. Paid Effective Fees' datatype='real' default-type='quantitative' layered='true' name='[Avg. Paid Delivery Fees (copy)_1217097853038686209]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='(SUM([ADF]) + SUM([ASF]) + SUM([ASOF]))            // df+sf+small_order_fee&#13;&#10;/ SUM([ADF_count])' />
            </column>
            <column aggregation='User' caption='Avg. Paid Small Order Fee' datatype='real' default-type='quantitative' layered='true' name='[Avg. Paid Service Fees (copy)_1217097853038202880]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([ASOF]) / SUM([ADF_count])' />
            </column>
            <column aggregation='User' caption='Avg. DF % of AFV' datatype='real' default-type='quantitative' layered='true' name='[Avg. SF % of AFV (copy)_1702501458177286152]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Avg. Delivery Fees (Cust. Pay) (copy)_1238771408544116736] / &#10;[AFV_tgo_tmp (copy)_1702501458179063817]&#10;* 100' />
            </column>
            <column aggregation='User' caption='Avg. EF % of AFV' datatype='real' default-type='quantitative' layered='true' name='[Avg. SF % of AFV (copy)_713820593923960833]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_1141099597754753025] / [AFV (copy)_1090997064012828672] * 100' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[Basket]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='User' caption='KPI1 Chart' datatype='real' default-type='quantitative' layered='true' name='[Calculation1 (copy)_871165102841962496]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;when &quot;Gross Orders&quot; then SUM([Gross])&#13;&#10;when &quot;Successful Orders&quot; then SUM([Successful])&#13;&#10;when &quot;Avg. Daily Orders&quot; then ROUND( SUM([Successful]) /  COUNTD([order_date]), 0)&#13;&#10;when &quot;Net Failed Orders&quot; then SUM([Net_Failed])&#13;&#10;when &quot;NFR %&quot; then ROUND(  SUM([Net_Failed]) / SUM([Net]) * 100, 2)&#13;&#10;when &quot;HFR %&quot; then ROUND(  SUM([Failed]) / SUM([Gross]) * 100, 1)&#13;&#10;when &quot;Vendor FR%&quot; then ROUND(  SUM([Vendor_FR_3]) / SUM([Net]) *100, 2)&#13;&#10;when &quot;Order Related CR %&quot; then ROUND([Calculation_1108167025630093312], 1)&#13;&#10;&#13;&#10;when &quot;Voucher Orders&quot; then SUM([Voucher])&#13;&#10;when &quot;Voucher Orders %&quot; then ROUND( SUM([Voucher]) / SUM([Successful]) * 100, 1)&#13;&#10;when &quot;Talabat-Funded Orders&quot; then SUM([Talabat_funded_orders])&#13;&#10;when &quot;Talabat-Funded Orders %&quot; then ROUND( SUM([Talabat_funded_orders]) / SUM([Successful]) * 100, 1)&#13;&#10;when &quot;Vendor-Funded Orders&quot; then SUM([Vendor_Fund])&#13;&#10;when &quot;Vendor-Funded Orders %&quot; then ROUND( SUM([Vendor_Fund]) / SUM([Successful]) * 100, 1)&#13;&#10;when &quot;Funded Orders&quot; then SUM([Funded_Orders])&#13;&#10;when &quot;Funded Orders %&quot; then ROUND( SUM([Funded_Orders]) / SUM([Successful]) * 100, 1)&#13;&#10;when &quot;Talabat Fund Amount&quot; then SUM([Talabat_fund_amount])&#13;&#10;when &quot;Talabat Fund Amount (GMV %)&quot; then ROUND( SUM([Talabat_fund_amount]) / SUM([GMV]) * 100, 1)&#13;&#10;when &quot;Vendor Fund Amount&quot; then SUM([Vendor_Fund_amount])&#13;&#10;when &quot;Vendor Fund Amount (GMV %)&quot; then ROUND( SUM([Vendor_Fund_amount]) / SUM([GMV]) * 100, 1)&#13;&#10;when &quot;Fund Amount&quot; then SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])&#13;&#10;when &quot;Fund Amount (GMV %)&quot; then ROUND( (SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])) / SUM([GMV]) * 100, 1)&#13;&#10;&#13;&#10;when &quot;Vendor Late &gt;10 V2&quot; then ROUND( SUM([Late_600]) / SUM([Late_not_null]) * 100, 1)&#13;&#10;when &quot;Vendor Late &gt;5 V2&quot; then ROUND( SUM([Late_300]) / SUM([Late_not_null]) * 100, 1)&#13;&#10;when &quot;Avg Order Delay&quot; then ROUND( (SUM([Average_delay]) / SUM([delayed_orders])) / 60, 2)&#13;&#10;when &quot;TGO Orders&quot; then SUM([TGO])&#13;&#10;when &quot;TGO Share %&quot; then ROUND( SUM([TGO]) / SUM([Successful]) * 100, 1)&#13;&#10;when &quot;Stacked Orders %&quot; then ROUND([Calculation_1913466902577307648], 1)&#13;&#10;when &quot;Avg Rider acceptance time&quot; then ROUND( (SUM([rider_acc_time]) / SUM([rider_acc_time_not_null])) / 60, 1)&#13;&#10;when &quot;On Time %&quot; then ROUND([Calculation_1367405496446644224]*100, 1)&#13;&#10;when &quot;Delayed Orders &gt; 10 %&quot; then ROUND([Calculation_2346656912126193665], 1)&#13;&#10;&#13;&#10;when &quot;Avg. Delivery Fees (Cust. Pay)&quot; then ROUND( sum([DF]) / SUM([DF_count]), 2)&#13;&#10;when &quot;Avg. Delivery Fees&quot; then ROUND( sum([t_df]) / SUM([DF_count]), 2)&#13;&#10;when &apos;Avg. Delivery Fees (Ven. Fund)&apos; then ROUND(((sum(t_df))-sum([DF]))/SUM([DF_count]) ,2)&#13;&#10;when &quot;Avg. Service fees&quot; then ROUND( SUM([service_fee]) / SUM([sf_d]) , 2)&#13;&#10;when &quot;Avg. Small Order Fee&quot; then ROUND([Calculation_1004584238208241664] , 2)&#13;&#10;when &quot;Avg. Effective fees&quot; then ROUND( [Calculation_1141099597754753025], 2)&#13;&#10;when &quot;Avg. Paid Delivery Fees&quot; then ROUND([Calculation_851180330467799040], 2)&#13;&#10;when &quot;Avg. Paid Service Fees&quot; then ROUND([Calculation_851180330467913729], 2)&#13;&#10;when &quot;Avg. Paid Small Order Fee&quot; then ROUND([Avg. Paid Service Fees (copy)_1217097853038202880], 2)&#13;&#10;when &quot;Avg. Paid Effective Fees&quot; then ROUND([Avg. Paid Delivery Fees (copy)_1217097853038686209], 2)&#13;&#10;&#13;&#10;when &quot;Avg. Food Value&quot; then ROUND( SUM([Basket]) / SUM([Successful]), 1)&#13;&#10;when &quot;Avg. Order Value&quot; then Round( SUM([GMV]) / SUM([Successful]), 1)&#13;&#10;when &quot;GMV&quot; then Round(SUM([GMV]), 0)&#13;&#10;when &quot;Avg. Daily GMV&quot; then ROUND( SUM([GMV]) /  COUNTD([order_date]), 0)&#13;&#10;&#13;&#10;when &quot;Acquisitions&quot; then SUM([Acquisition])&#13;&#10;when &quot;Chain Orders Contribution %&quot; then ROUND( [Calculation_802485223669989378] * 100, 1)&#13;&#10;when &quot;% of orders by healthy customers&quot; then ROUND([Calculation_642607372759633920], 1)&#13;&#10;&#13;&#10;when &quot;Avg. Daily Voucher Code&quot; then ROUND(SUM([Calculation_1344043015486328832]) / COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Marketing Voucher&quot; then ROUND(SUM([Calculation_1344043015500836865]) / COUNTD([order_date]), 0)&#13;&#10;&#13;&#10;when &quot;Avg. Daily Delivery Funded Orders&quot; then ROUND(SUM([free_delivery_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Gem Orders&quot; then ROUND(SUM([gem_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Menu Funded Orders&quot; then ROUND(SUM([restaurant_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Item Funded Orders&quot; then ROUND(SUM([item_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily tRewards Orders&quot; then ROUND(SUM([trewards_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Voucher Orders&quot; then ROUND(SUM([Voucher])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily tPro Delivery Funded Orders&quot; then ROUND(SUM([tpro_deliv_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily tPro Item Funded Orders&quot; then ROUND(SUM([tpro_item_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;when &quot;Avg. Daily Compensation Orders&quot; then ROUND(SUM([compensation_funded_orders])/COUNTD([order_date]), 0)&#13;&#10;&#13;&#10;when &quot;Avg. Daily Organic Orders&quot; then ROUND([Calculation_279786135154614272], 0)&#13;&#10;when &quot;Avg. Daily Organic non Vendor Funded Orders&quot; then ROUND([Calculation_279786135157661697], 0)&#13;&#10;when &quot;Avg. Daily Organic non Talabat Funded Orders&quot; then ROUND([Calculation_279786135159197698], 0)&#13;&#10;&#13;&#10;when &quot;Avg. Daily Organic Orders %&quot; then ROUND([Avg. Daily Organic Orders (copy)_279786135174328323], 1)&#13;&#10;when &quot;Avg. Daily Organic non Talabat Funded Orders %&quot; then ROUND([Avg. Daily Organic non Talabat Funded Orders (copy)_279786135175995396], 1)&#13;&#10;when &quot;Avg. Daily Organic non Vendor Funded Orders %&quot; then ROUND([Avg. Daily Organin non Vendor Funded Orders (copy)_279786135176896517], 1)&#13;&#10;&#13;&#10;when &quot;Finance Commission %&quot; THEN ROUND([Calculation_2140054266546216960], 2)&#13;&#10;when &quot;Commission %&quot; THEN ROUND([Calculation_596164014970306560], 2)&#13;&#10;WHEN &quot;Avg. Commission&quot; THEN Round([Calculation_28991982927265792], 1)&#13;&#10;&#13;&#10;when &quot;Avg. Item Price&quot; then Round([Calculation_1070730849795502081], 1)&#13;&#10;when &quot;Avg. Items per Order&quot; then Round([Calculation_1070730849794523136], 2)&#13;&#10;&#13;&#10;WHEN &apos;Avg DF % of AFV&apos; THEN ROUND([Avg. SF % of AFV (copy)_1702501458177286152], 2)&#13;&#10;WHEN &quot;Avg SF % of AFV&quot; THEN Round([Calculation_713820593923362816], 2)&#13;&#10;WHEN &quot;Avg EF % of AFV&quot; THEN Round([Avg. SF % of AFV (copy)_713820593923960833], 2)&#13;&#10;&#13;&#10;WHEN &quot;EBITDA&quot; THEN Round(SUM([ebitda]), 1)&#13;&#10;WHEN &quot;EBITDA per Order&quot; THEN Round([Calculation_1345168942618529792], 1)&#13;&#10;&#13;&#10;WHEN &apos;Total Active Vendors&apos; THEN [Calculation_961237071305261056]&#13;&#10;WHEN &apos;Total Active Chains&apos; THEN [Number of Active Vendors (copy)_1114359458686873601]&#13;&#10;WHEN &apos;% Online Payment&apos; THEN ROUND([Calculation_1114359458685546496]*100, 1)&#13;&#10;WHEN &apos;EF TGO / DF TMP&apos; THEN ROUND([Calculation_3620401577217581088]*100, 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Avg. Small Order Fee' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1004584238208241664]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
