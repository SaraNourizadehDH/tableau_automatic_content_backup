        <calculation class='tableau' formula='if { FIXED [chain_name] : [Calculation_1321243605375111168] &gt; 30 } and &#13;&#10;{ FIXED [chain_name] : [Calculation_1321243605379964929] &gt; DATE(DATEADD(&apos;month&apos;,-3,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()-1)))) }&#13;&#10;then &apos;True&apos; else &apos;False&apos;  end' />
