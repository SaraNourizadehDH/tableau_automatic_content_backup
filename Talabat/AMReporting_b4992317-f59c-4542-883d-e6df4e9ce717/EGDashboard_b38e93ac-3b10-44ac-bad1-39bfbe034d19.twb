        <calculation class='tableau' formula='(&#10;SUM(IF [main_vertical]=&apos;tmart&apos; THEN NULL ELSEIF [is_tgo]=&apos;TGO&apos; THEN [Avg. Effective fees (copy)_3620401577221201954] ELSE 0 END) / SUM(IF [is_tgo]=&apos;TGO&apos; THEN [ADF_count] ELSE 0 END)&#10;)&#10;/&#10;(&#10;SUM(IF [is_tgo]=&apos;TMP&apos; THEN [ADF] ELSE 0 END) / SUM(IF [is_tgo]=&apos;TMP&apos; THEN [ADF_count] ELSE 0 END)&#10;)' />
