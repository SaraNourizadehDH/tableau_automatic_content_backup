            <column aggregation='User' caption='EBITDA per Order' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1345168942618529792]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([ebitda]) / SUM([Successful])' />
            </column>
            <column aggregation='User' caption='On Time%' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1367405496446644224]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([on_time_d])' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827201437696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Stacked Orders %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1913466902577307648]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Stacked_orders]) / SUM([stacked_d]) * 100' />
            </column>
            <column aggregation='User' caption='Commission (finance) %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266546216960]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='(SUM([commission_new]) / &#13;&#10;(ZN(SUM([Calculation_2140054266558148610])) + ZN(SUM([Calculation_2140054266555224065])) + ZN(SUM([GMV TMP (copy)_1312236370339164160]))) &#13;&#10;) * 100' />
            </column>
            <column aggregation='Sum' caption='GMV TMP' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266555224065]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='IF [is_tgo]=&apos;TMP&apos; then [GMV] END' />
            </column>
            <column aggregation='Sum' caption='Basket TGO' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266558148610]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='IF [is_tgo]=&apos;TGO&apos; then [Basket] END' />
