    <datasource caption='Orders' inline='true' name='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca' version='18.1'>
      <repository-location derived-from='http://ip-172-31-0-197:8002/t/Talabat/datasources/Orders?rev=1.2' id='Orders' path='/t/Talabat/datasources' revision='44.9' site='Talabat' />
      <connection channel='https' class='sqlproxy' dataserver-permissions='true' dbname='Orders' directory='dataserver' port='443' saved-credentials-viewerid='50460' server='tableau.deliveryhero.net' server-ds-friendly-name='Orders' username=''>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca' name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca' name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[AFV (copy)_1090997064012828672]' formula='SUM(IF [is_tgo]!=&apos;PICKUP&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Basket] END) &#13;&#10;/ SUM(IF [is_tgo]!=&apos;PICKUP&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Successful] END)' />
          <calculation column='[AFV_tgo_tmp (copy)_1702501458179063817]' formula='SUM(IF [is_tgo]=&apos;TGO&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Basket] END) &#13;&#10;/ SUM(IF [is_tgo]=&apos;TGO&apos; AND [main_vertical]!=&apos;tmart&apos; AND [chain_id]!=&apos;625984&apos; THEN&#13;&#10;[Successful] END)' />
          <calculation column='[Avg. Daily Item Funded Orders (copy)_1374160891848826881]' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_item_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_item_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_item_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
          <calculation column='[Avg. Daily Item Funded Orders (copy)_1374160891849457667]' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [compensation_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_comp_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_comp_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
          <calculation column='[Avg. Daily Orders  (copy)_802485223616143360]' formula='{ FIXED [chain_name]: SUM([Successful]) /  COUNTD([order_date])}' />
          <calculation column='[Avg. Daily Organic Orders (copy)_279786135174328323]' formula='SUM(IF [offer_type] = &apos;None&apos;  then [Successful] else 0 END)&#13;&#10;/ SUM([Successful]) * 100' />
          <calculation column='[Avg. Daily Organic non Talabat Funded Orders (copy)_279786135175995396]' formula='SUM(IF [offer_type]=&apos;None&apos; or [offer_type]=&apos;Vendor&apos; THEN [Successful] END)&#13;&#10;/ SUM([Successful]) * 100' />
          <calculation column='[Avg. Daily Organin non Vendor Funded Orders (copy)_279786135176896517]' formula='SUM(IF [offer_type] =&apos;None&apos; or [offer_type]=&apos;Talabat&apos; then [Successful] END)&#13;&#10;/ SUM([Successful]) * 100' />
          <calculation column='[Avg. Daily Talabat Vouchers Orders (copy)_1374160891847503872]' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [Voucher]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [vendor_voucher_orders]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [talabat_voucher_orders]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
          <calculation column='[Avg. Daily tPro Exclusive Deal Orders (copy)_1378945930962104320]' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_booster_discount_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_booster_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_booster_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
          <calculation column='[Avg. Daily tPro Item Funded Orders (copy)_1374160891849125890]' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_deliv_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_deliv_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_deliv_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
          <calculation column='[Avg. Delivery Fees (Cust. Pay) (copy)_1238771408544116736]' formula='SUM([t_df]) / SUM([DF_count])*1.14' />
          <calculation column='[Avg. Effective fees (copy)_3620401577221201954]' formula='[ADF]+[ASF]+[ASOF]' />
          <calculation column='[Avg. Paid Delivery Fees (copy)_1217097853038686209]' formula='(SUM([ADF]) + SUM([ASF]) + SUM([ASOF]))            // df+sf+small_order_fee&#13;&#10;/ SUM([ADF_count])' />
          <calculation column='[Avg. Paid Service Fees (copy)_1217097853038202880]' formula='SUM([ASOF]) / SUM([ADF_count])' />
