              <calculation class='tableau' formula='//(SUM([t_df]) / SUM([DF_count])) + (SUM([service_fee])/ sum([sf_d]))&#10;[Avg. Delivery Fees (Cust. Pay) (copy)_1238771408544116736] + [Calculation_1141099597754306560] + [Calculation_1004584238208241664]' />
            </column>
            <column aggregation='Sum' caption='Voucher Code' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1344043015486328832]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='IF [voucher_type]=&apos;VOUCHER_CODE&apos; then [Successful] else 0 END' />
