  <worksheets>
    <worksheet name='Avg. Daily Fund Type'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Fund Type View' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca'>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Americana_chains]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='User' caption='Avg. Daily tPro Exclusive Deal Orders' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Item Funded Orders (copy)_1374160891848826881]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_item_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_item_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_item_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Compensation Orders' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Item Funded Orders (copy)_1374160891849457667]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [compensation_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_comp_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_comp_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Vouchers Orders' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily Talabat Vouchers Orders (copy)_1374160891847503872]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [Voucher]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [vendor_voucher_orders]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [talabat_voucher_orders]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily tPro Booster Discount Orders' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily tPro Exclusive Deal Orders (copy)_1378945930962104320]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_booster_discount_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_booster_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_booster_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily tPro Delivery Discount Orders' datatype='real' default-type='quantitative' layered='true' name='[Avg. Daily tPro Item Funded Orders (copy)_1374160891849125890]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [tpro_deliv_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_tpro_deliv_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_tpro_deliv_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='Count' caption='Weekday' datatype='string' default-type='nominal' layered='true' name='[Calculation_1213720127609049088]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Free Delivery Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1569785946348978176]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [free_delivery_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_free_deliv_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_free_deliv_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Gem Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1569785946349203457]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [gem_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_gem_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_gem_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Item Funded Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1569785946349301762]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [item_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_item_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_item_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column aggregation='User' caption='Avg. Daily Menu Funded Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1569785946349498371]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [restaurant_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_rest_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_rest_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827201437696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Chain Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_3766557407763734528]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Americana_chains]=&apos;Americana&apos; THEN &apos;Americana&apos;&#10;ELSEIF [chain_id] in (&#10;&apos;694639&apos;, //3m shatltat&#10;&apos;677850&apos;, //konafa w basbosa&#10;&apos;677778&apos;, //blaban&#10;&apos;686788&apos;, //wahmy burger&#10;&apos;689801&apos;, //karam elsham&#10;&apos;687553&apos; //bahij&#10;) THEN &apos;B.Laban &amp; Co.&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column aggregation='Year' caption='Date Level' datatype='datetime' default-type='ordinal' layered='true' name='[Calculation_383368955007725569]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Day&apos; then [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [order_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Avg. Daily tRewards Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_433752983813029888]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;CASE [Parameters].[Parameter 8]&#13;&#10;WHEN &apos;All&apos; THEN [trewards_funded_orders]&#13;&#10;WHEN &apos;Vendor Fund&apos; THEN [ven_trewards_o]&#13;&#10;WHEN &apos;Talabat Fund&apos; THEN [tal_trewards_o]&#13;&#10;END)&#13;&#10;/ COUNTD([order_date])' />
            </column>
