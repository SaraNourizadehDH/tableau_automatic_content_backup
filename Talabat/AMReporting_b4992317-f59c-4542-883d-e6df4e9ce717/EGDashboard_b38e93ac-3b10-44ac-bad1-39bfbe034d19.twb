              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Stacked Orders %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1913466902577307648]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Stacked_orders]) / SUM([stacked_d]) * 100' />
            </column>
            <column aggregation='User' caption='Delayed Orders &gt; 10' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2346656912126193665]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([delayed_orders_10]) / SUM([delayed_orders]) * 100' />
            </column>
            <column aggregation='User' caption='Contact Rate %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_264867988933185536]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Contact Cases (copy)_1412722911773999104]) / SUM([Gross]) * 100&#13;&#10;//(SUM([Contact Cases]) + SUM([Contact Chats])) / SUM([Contact Gross]) * 100' />
            </column>
            <column aggregation='User' caption='HFR %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_271341909629894656]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([Failed]) / SUM([Gross]) * 100' />
            </column>
            <column aggregation='Count' caption='Chain Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_3766557407763734528]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Americana_chains]=&apos;Americana&apos; THEN &apos;Americana&apos;&#10;ELSEIF [chain_id] in (&#10;&apos;694639&apos;, //3m shatltat&#10;&apos;677850&apos;, //konafa w basbosa&#10;&apos;677778&apos;, //blaban&#10;&apos;686788&apos;, //wahmy burger&#10;&apos;689801&apos;, //karam elsham&#10;&apos;687553&apos; //bahij&#10;) THEN &apos;B.Laban &amp; Co.&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
