            <column aggregation='User' caption='Commission (finance) %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266546216960]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='(SUM([commission_new]) / &#13;&#10;(ZN(SUM([Calculation_2140054266558148610])) + ZN(SUM([Calculation_2140054266555224065])) + ZN(SUM([GMV TMP (copy)_1312236370339164160]))) &#13;&#10;) * 100' />
            </column>
            <column aggregation='Sum' caption='GMV TMP' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266555224065]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='IF [is_tgo]=&apos;TMP&apos; then [GMV] END' />
