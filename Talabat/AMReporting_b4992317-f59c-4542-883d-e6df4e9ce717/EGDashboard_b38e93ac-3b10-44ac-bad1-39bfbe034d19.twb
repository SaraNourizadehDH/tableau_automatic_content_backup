      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_860640DB37824DFA946598D183B7CF07'>
            <properties context=''>
              <relation connection='bigquery.1fqukiu0wr15qa12r2g8w17d0qpc' name='Custom SQL Query' type='text'><![CDATA[--**EG DB: Fail Reason**--

with real_failed as 
(
select order_id, account_id, is_successful, order_time, vendor_id,

lead(order_id) OVER (PARTITION BY account_id ORDER BY order_time) as next_order,
lead(is_successful) OVER (PARTITION BY account_id ORDER BY order_time) as next_order_status,
lead(order_time) OVER (PARTITION BY account_id ORDER BY order_time) as next_order_time,
lead(vendor_id) OVER (PARTITION BY account_id ORDER BY order_time) as next_vendor,

from `tlb-data-prod.data_platform.fct_order_info`

where order_date>>=date_trunc(date_sub(current_date(), INTERVAL 5 MONTH),MONTH) and country_id=9 
)

select 

F.order_date, 
F.delivery_arrangement as is_tgo, 
F.is_tpro_order is_tpro,

DL.cluster_name as city_cluster,
DL.city_name,
DL.zone_name_final as zone,

L.reason,
L.sub_reason,
L.owner,

V.vendor_name,
V.account_manager_name,
V.account_manager_email,
V.team_leader_email,
C.chain_name,

count(*) as Gross,
sum(case when F.is_successful = false then 1 else 0 end) as Failed, 

--Main Vertical
case
 when not F.is_non_food then 'Food'
  when F.is_non_food and not F.is_darkstore then 'NFV'
  when F.is_darkstore then 'tmart' 
end as main_vertical , 

sum(case when 
    F.is_successful=false and 
    next_order_status=True and 
    (TIMESTAMP_DIFF(next_order_time, F.order_time, minute) << 60 and F.vendor_id=next_vendor) 
    then 0 
   when not F.is_successful then 1 
   else 0 end) as true_failed_order,

from `tlb-data-prod.data_platform.fct_order_info` F 
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` L ON F.order_fail_reason_id = L.order_fail_reason_id
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on F.delivery_location_id = DL.location_id 
left join `tlb-data-prod.data_platform.dim_vendor_info` V on F.vendor_id = V.vendor_id 
left join `tlb-data-prod.data_platform.dim_chain` C on F.chain_id = C.chain_id 

left join real_failed rf on F.order_id = rf.order_id 

where F.country_id = 9 
and F.order_date >>= date_trunc(date_sub(current_date(), INTERVAL 3 MONTH),MONTH) 
and not F.is_test  

group by 
F.order_date, 
F.delivery_arrangement, 
F.is_tpro_order,
DL.cluster_name, DL.city_name, DL.zone_name_final,
L.reason, L.sub_reason, 
main_vertical,
L.owner,
V.vendor_name,
V.account_manager_name,
V.account_manager_email,
V.team_leader_email,
C.chain_name]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
