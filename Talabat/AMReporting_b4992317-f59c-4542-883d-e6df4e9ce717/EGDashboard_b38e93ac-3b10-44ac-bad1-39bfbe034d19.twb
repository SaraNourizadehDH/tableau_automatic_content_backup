            <column aggregation='Sum' caption='Basket TGO' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2140054266558148610]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='IF [is_tgo]=&apos;TGO&apos; then [Basket] END' />
