          <datasource-dependencies datasource='sqlproxy.10gqw6702p8u2313fsfgg0ugjyca'>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Americana_chains]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='User' caption='HFR MTD' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1268889222700646401]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,[order_date]) = DATETRUNC(&apos;month&apos;,TODAY()-1) then [Failed] end)&#13;&#10;/&#13;&#10;sum(IF DATETRUNC(&apos;month&apos;,[order_date]) = DATETRUNC(&apos;month&apos;,TODAY()-1) then [Gross] end)' />
            </column>
            <column aggregation='User' caption='HFR Diff' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1268889222700818434]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_1268889222700646401] - &#13;&#10;(&#13;&#10;sum(if DATETRUNC(&apos;month&apos;,[order_date])= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1) )&#13;&#10;                  then [Failed] end)&#13;&#10;/&#13;&#10;SUM((if DATETRUNC(&apos;month&apos;,[order_date])= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1) )&#13;&#10;                  then [Gross] end))&#13;&#10;)' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827201437696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Dimension 1 value ' datatype='string' default-type='nominal' layered='true' name='[Calculation_2195223372599144449]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;&#13;&#10;WHEN &apos;Delivery Arrangement&apos; THEN [is_tgo]&#13;&#10;WHEN &apos;Main Vertical&apos; THEN [main_vertical]&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Chain Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_3766557407763734528]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Americana_chains]=&apos;Americana&apos; THEN &apos;Americana&apos;&#10;ELSEIF [chain_id] in (&#10;&apos;694639&apos;, //3m shatltat&#10;&apos;677850&apos;, //konafa w basbosa&#10;&apos;677778&apos;, //blaban&#10;&apos;686788&apos;, //wahmy burger&#10;&apos;689801&apos;, //karam elsham&#10;&apos;687553&apos; //bahij&#10;) THEN &apos;B.Laban &amp; Co.&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column aggregation='Count' caption='Dimension 1 value' datatype='string' default-type='nominal' layered='true' name='[Calculation_43065711995932674]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;&#13;&#10;WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;WHEN &quot;Chain ID&quot; THEN [chain_id]&#13;&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;WHEN &quot;Vendor ID&quot; THEN [vendor_id]&#13;&#10;WHEN &quot;Account Manager&quot; THEN [account_manager_name]&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Location Dimension ' datatype='string' default-type='nominal' layered='true' name='[Calculation_764204595265716224]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;&#13;&#10;WHEN &quot;Cluster&quot; THEN [city_cluster]&#13;&#10;WHEN &quot;City&quot; THEN [city_name]&#13;&#10;//WHEN &quot;Zone&quot; THEN [zone_name_final]&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[Failed]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' caption='Dimension 2 value ' datatype='string' default-type='nominal' layered='true' name='[Fisrt Dimension Value (copy)_2195223372599463938]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[First Dimension (copy)_2195223372598910976]&#13;&#10;&#13;&#10;WHEN &apos;Delivery Arrangement&apos; THEN [is_tgo]&#13;&#10;WHEN &apos;Main Vertical&apos; THEN [main_vertical]&#13;&#10;&#13;&#10;END' />
