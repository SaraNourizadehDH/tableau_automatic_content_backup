              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;when &quot;Gross Orders&quot; then SUM([Gross])&#13;&#10;when &quot;Successful Orders&quot; then SUM([Successful])&#13;&#10;when &quot;Avg. Daily Orders&quot; then SUM([Successful]) /  COUNTD([order_date])&#13;&#10;when &quot;Net Failed Orders&quot; then SUM([Net_Failed])&#13;&#10;when &quot;NFR %&quot; then SUM([Net_Failed]) / SUM([Net]) * 100&#13;&#10;when &quot;HFR %&quot; then SUM([Failed]) / SUM([Gross]) * 100&#13;&#10;when &quot;Vendor FR%&quot; then SUM([Vendor_FR_3]) / SUM([Net]) *100&#13;&#10;when &quot;Order Related CR %&quot; then [Calculation_1108167025630093312]&#13;&#10;&#13;&#10;when &quot;Voucher Orders&quot; then SUM([Voucher])&#13;&#10;when &quot;Voucher Orders %&quot; then SUM([Voucher]) / SUM([Successful]) * 100&#13;&#10;when &quot;Talabat-Funded Orders&quot; then SUM([Talabat_funded_orders])&#13;&#10;when &quot;Talabat-Funded Orders %&quot; then SUM([Talabat_funded_orders]) / SUM([Successful]) * 100&#13;&#10;when &quot;Vendor-Funded Orders&quot; then SUM([Vendor_Fund])&#13;&#10;when &quot;Vendor-Funded Orders %&quot; then SUM([Vendor_Fund]) / SUM([Successful]) * 100&#13;&#10;when &quot;Funded Orders&quot; then SUM([Funded_Orders])&#13;&#10;when &quot;Funded Orders %&quot; then SUM([Funded_Orders]) / SUM([Successful]) * 100&#13;&#10;when &quot;Talabat Fund Amount&quot; then SUM([Talabat_fund_amount])&#13;&#10;when &quot;Talabat Fund Amount (GMV %)&quot; then SUM([Talabat_fund_amount]) / SUM([GMV]) * 100&#13;&#10;when &quot;Vendor Fund Amount&quot; then SUM([Vendor_Fund_amount])&#13;&#10;when &quot;Vendor Fund Amount (GMV %)&quot; then SUM([Vendor_Fund_amount]) / SUM([GMV]) * 100&#13;&#10;when &quot;Fund Amount&quot; then SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])&#13;&#10;when &quot;Fund Amount (GMV %)&quot; then (SUM([Talabat_fund_amount]) + SUM([Vendor_Fund_amount])) / SUM([GMV]) * 100&#13;&#10;&#13;&#10;when &quot;Vendor Late &gt;10 V2&quot