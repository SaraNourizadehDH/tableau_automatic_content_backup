            <column aggregation='User' caption='On Time%' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1367405496446644224]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([on_time_d])' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_1701234827201437696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#13;&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#13;&#10;END' />
            </column>
            <column aggregation='User' caption='Stacked Orders %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1913466902577307648]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
