    <datasource caption='campaigns_new' inline='true' name='federated.1a52vju18zgxix1eor4jo17iu8wm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1mlsxry0s9ynbd1ald7ff08ic7ij'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1mlsxry0s9ynbd1ald7ff08ic7ij' name='Custom SQL Query' type='text'><![CDATA[WITH 
        menu_item_campaigns AS (
            SELECT
              CONCAT(dicvh.campaign_id,"-",v.vendor_id) as unique_campaign_id,
              dicvh.campaign_id,
              CAST(dicvh.incentive_campaign_id AS STRING) as incentive_campaign_id,
              v.vendor_id,
              v.vendor_name,
              c.chain_id,
              c.chain_name,
              dicvh.valid_from_time_utc,
              dicvh.valid_to_time_utc,
              did.campaign_name,
              dic.incentive_type,
              dic.incentive_sub_type,
              did.source_system_platform_campaign_type,
              dic.campaign_start_date,
              dic.campaign_end_date,
              dic.is_tpro_exclusive,
              dic.is_tpro_booster,
              did.discount_type,
              v.account_manager_name,
              v.account_manager_email,
              v.team_leader_name,
              v.team_leader_email,
              c.country_code,
              COALESCE(did.is_monetized_campaign,FALSE) as is_targeted_campaign,
              dic.is_experimental_deal,
              "Campaign" as type,
          FROM `tlb-data-prod.data_platform.dim_incentive_campaign_vendor_history` dicvh
          LEFT JOIN `tlb-data-prod.data_platform.dim_incentive_campaign` dic on dic.incentive_campaign_id = dicvh.incentive_campaign_id
          LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` did on did.incentive_campaign_id = dicvh.incentive_campaign_id
          LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = dicvh.vendor_id
          LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
          WHERE DATE(dicvh.valid_from_time_utc) <<= CURRENT_DATE()-1
          AND DATE(dicvh.valid_to_time_utc) >>= CURRENT_DATE()-1
          AND LOWER(did.campaign_name) NOT LIKE "%dineout%"
          AND c.vertical = "food"
        ),

        booster_campaigns AS (
            SELECT
              CONCAT(didd.campaign_id,"-",v.vendor_id) as unique_campaign_id,
              didd.campaign_id,
              CAST(didd.incentive_campaign_id AS STRING) as incentive_campaign_id,
              v.vendor_id,
              v.vendor_name,
              c.chain_id,
              c.chain_name,
              TIMESTAMP(NULL) as valid_from_time_utc,
              TIMESTAMP(NULL) as valid_to_time_utc,
              did.campaign_name,
              dic.incentive_type,
              dic.incentive_sub_type,
              did.source_system_platform_campaign_type,
              dic.campaign_start_date,
              dic.campaign_end_date,
              dic.is_tpro_exclusive,
              dic.is_tpro_booster,
              did.discount_type,
              v.account_manager_name,
              v.account_manager_email,
              v.team_leader_name,
              v.team_leader_email,
              c.country_code,
              COALESCE(did.is_monetized_campaign,FALSE) as is_targeted_campaign,
              dic.is_experimental_deal,
              "Campaign" as type,
            FROM `tlb-data-prod.data_platform.dim_incentives_discount_details` didd
            LEFT JOIN `tlb-data-prod.data_platform.dim_incentive_campaign` dic on dic.incentive_campaign_id = didd.incentive_campaign_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` did on did.incentive_campaign_id = didd.incentive_campaign_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = didd.vendor_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
            WHERE didd.vendor_id IS NOT NULL
            AND didd.vendor_id <<>> 0
            AND c.vertical = "food"
            AND LOWER(dic.incentive_sub_type) = "booster discount"
            AND LOWER(did.campaign_name) NOT LIKE "%dineout%"
        ),

        tpro_delivery AS (
            SELECT
            CONCAT("tPro Delivery","-",v.vendor_id) as unique_campaign_id,
            "tPro Delivery" AS campaign_id,
            "tPro Delivery" AS incentive_campaign_id,
            v.vendor_id,
            v.vendor_name,
            c.chain_id,
            c.chain_name,
            TIMESTAMP(NULL) as valid_from_time_utc,
            TIMESTAMP(NULL) as valid_to_time_utc,
            "tPro Delivery" AS campaign_name,
            "tPro Delivery" AS incentive_type,
            "tPro Delivery" AS incentive_sub_type,
            STRING(NULL) AS source_system_platform_campaign_type,
            TIMESTAMP(tc.startdate) as campaign_start_date,
            TIMESTAMP(tc.end_date) as campaign_end_date,
            TRUE as is_tpro_exclusive,
            FALSE as is_tpro_booster,
            "tPro Delivery" as discount_type,
            v.account_manager_name,
            v.account_manager_email,
            v.team_leader_name,
            v.team_leader_email,
            c.country_code,
            FALSE as is_targeted_campaign,
            FALSE AS is_experimental_deal,
            "Incentive" as type,
          FROM `tlb-data-prod.data_platform_rest_tables.tpro_vendor_salesforce_contracts` tc 
          LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = tc.vendor_id 
          LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
          WHERE COALESCE(end_date,"2055-12-31") >>= CURRENT_DATE()-1
          AND c.vertical = "food"
        ),


        gem_base AS 
            (
                SELECT 
                CONCAT("gem","-",v.vendor_id) as unique_campaign_id,
                "gem" AS campaign_id,
                "gem" AS incentive_campaign_id,
                v.vendor_id,
                v.vendor_name,
                c.chain_id,
                c.chain_name,
                TIMESTAMP(NULL) as valid_from_time_utc,
                TIMESTAMP(NULL) as valid_to_time_utc,
                "gem" AS campaign_name,
                "gem" AS incentive_type,
                "gem" AS incentive_sub_type,
                STRING(NULL) AS source_system_platform_campaign_type,
                TIMESTAMP(NULL) as campaign_start_date,
                TIMESTAMP(NULL) as campaign_end_date,
                FALSE as is_tpro_exclusive,
                FALSE as is_tpro_booster,
                "gem" as discount_type,
                v.account_manager_name,
                v.account_manager_email,
                v.team_leader_name,
                v.team_leader_email,
                c.country_code,
                FALSE as is_targeted_campaign,
                FALSE AS is_experimental_deal,
                "AdTech" as type,
                promotion_date,
                FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.fct_restaurant_joker` gem
                LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING) = gem.vendor_id
                LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
                WHERE 
                promotion_date >>= CURRENT_DATE() -2
                AND c.vertical = "food"        
            ),

        max_gem_date AS 
            (
                SELECT
                MAX(promotion_date) as max_date,
                FROM gem_base
            ),


        final_gem AS
                (SELECT 
                * EXCEPT(promotion_date)
                FROM gem_base
                WHERE promotion_date = (SELECT max_date FROM max_gem_date)
            ),

      cpc_bookings AS
          (
            SELECT 
            date,
            campaign_id,
            vendor_id,
            chain_id,
            product,
            status,
            revenue as revenue_lc,
            revenue_eur,
            started_at_local,
            ended_at_local,
            pricing_model,
            targeting_strategy,
            FROM `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily_local_v2` cpc
            WHERE date >>= CURRENT_DATE() -2
          ),
        
      max_cpc_date AS (
        SELECT
        MAX(date) as max_date,
        FROM cpc_bookings
      ),

      final_cpc AS
        (
          SELECT
          CONCAT(cpc.campaign_id,"-",v.vendor_id) as unique_campaign_id,
          campaign_id,
          STRING(NULL) AS incentive_campaign_id,
          v.vendor_id,
          v.vendor_name,
          c.chain_id,
          c.chain_name,
          TIMESTAMP(NULL) as valid_from_time_utc,
          TIMESTAMP(NULL) as valid_to_time_utc,
          "AdTech" AS campaign_name,
          product AS incentive_type,
          product AS incentive_sub_type,
          STRING(NULL) AS source_system_platform_campaign_type,
          TIMESTAMP(NULL) as campaign_start_date,
          TIMESTAMP(NULL) as campaign_end_date,
          FALSE as is_tpro_exclusive,
          FALSE as is_tpro_booster,
          pricing_model as discount_type,
          v.account_manager_name,
          v.account_manager_email,
          v.team_leader_name,
          v.team_leader_email,
          c.country_code,
          CASE WHEN targeting_strategy <<>> "all_customers" THEN TRUE ELSE FALSE END as is_targeted_campaign,
          FALSE AS is_experimental_deal,
          "AdTech" as type,
          FROM cpc_bookings cpc
          LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING) = cpc.vendor_id 
          LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
          WHERE date = (SELECT max_date FROM max_cpc_date)
          AND c.vertical = "food"
        ),

        final AS 
          (
            SELECT * FROM menu_item_campaigns
            UNION ALL
            SELECT * FROM booster_campaigns
            UNION ALL
            SELECT * FROM tpro_delivery
            UNION ALL
            SELECT * FROM final_gem
            UNION ALL
            SELECT * FROM final_cpc
          )

        SELECT * FROM final]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1mlsxry0s9ynbd1ald7ff08ic7ij' name='Custom SQL Query' type='text'><![CDATA[WITH 
        menu_item_campaigns AS (
            SELECT
