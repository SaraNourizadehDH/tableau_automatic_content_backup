            <connection CATALOG='tlb-data-prod' EXECCATALOG='bento-2024' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='rahul.verma@talabat.com' workgroup-auth-mode='prompt' />
