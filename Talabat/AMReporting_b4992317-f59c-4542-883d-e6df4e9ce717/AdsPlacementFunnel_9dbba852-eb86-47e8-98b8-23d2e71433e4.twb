        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1s7zifd07rf708150gh661b7gl9e' name='Custom SQL Query' type='text'>SELECT&#13;
  DATE_TRUNC(date, MONTH) Month,&#13;
  country_code,&#13;
  vertical,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(0)] AS screen_type,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(1)] AS screen_name,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(2)] AS component_type,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(3)] AS component_name,&#13;
&#13;
  -- CPC metrics&#13;
  SUM(cpc_vendor_impression_count) AS cpc_impressions,&#13;
  SUM(cpc_vendor_click_count)      AS cpc_clicks,&#13;
  SUM(cpc_add_to_cart_count)       AS cpc_add_to_carts,&#13;
  SUM(cpc_checkout_count)          AS cpc_checkouts,&#13;
  SUM(cpc_order_count)             AS cpc_orders,&#13;
  SUM(cpc_gmv_eur)                 AS cpc_gmv_eur,&#13;
  SUM(cpc_gmv_lc)                  AS cpc_gmv_lc,&#13;
  SUM(cpc_revenue_eur)             AS cpc_revenue_eur,&#13;
  SUM(cpc_revenue_lc)              AS cpc_revenue_lc,&#13;
&#13;
  -- GEM metrics&#13;
  SUM(gem_vendor_impression_count) AS gem_impressions,&#13;
  SUM(gem_vendor_click_count)      AS gem_clicks,&#13;
  SUM(gem_add_to_cart_count)       AS gem_add_to_carts,&#13;
  SUM(gem_checkout_count)          AS gem_checkouts,&#13;
  SUM(gem_order_count)             AS gem_orders,&#13;
  SUM(gem_gmv_eur)                 AS gem_gmv_eur,&#13;
  SUM(gem_gmv_lc)                  AS gem_gmv_lc,&#13;
  SUM(gem_revenue_eur)             AS gem_revenue_eur,&#13;
  SUM(gem_revenue_lc)              AS gem_revenue_lc,&#13;
&#13;
  -- Display Ads metrics&#13;
  SUM(displayads_vendor_impression_count) AS displayads_impressions,&#13;
  SUM(displayads_vendor_click_count)      AS displayads_clicks,&#13;
  SUM(displayads_add_to_cart_count)       AS displayads_add_to_carts,&#13;
  SUM(displayads_checkout_count)          AS displayads_checkouts,&#13;
  SUM(displayads_order_count)             AS displayads_orders,&#13;
  SUM(displayads_gmv_eur)                 AS displayads_gmv_eur,&#13;
  SUM(displayads_gmv_lc)                  AS displayads_gmv_lc,&#13;
  SUM(displayads_revenue_eur)             AS displayads_revenue_eur,&#13;
  SUM(displayads_revenue_lc)              AS displayads_revenue_lc,&#13;
&#13;
  -- Display Video metrics&#13;
  SUM(displayvideo_vendor_impression_count) AS displayvideo_impressions,&#13;
  SUM(displayvideo_vendor_click_count)      AS displayvideo_clicks,&#13;
  SUM(displayvideo_add_to_cart_count)       AS displayvideo_add_to_carts,&#13;
  SUM(displayvideo_checkout_count)          AS displayvideo_checkouts,&#13;
  SUM(displayvideo_order_count)             AS displayvideo_orders,&#13;
  SUM(displayvideo_gmv_eur)                 AS displayvideo_gmv_eur,&#13;
  SUM(displayvideo_gmv_lc)                  AS displayvideo_gmv_lc,&#13;
  SUM(displayvideo_revenue_eur)             AS displayvideo_revenue_eur,&#13;
  SUM(displayvideo_revenue_lc)              AS displayvideo_revenue_lc,&#13;
&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_adex_session_metrics_pool`&#13;
WHERE date &gt;&gt;= &apos;2025-01-01&apos;&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
