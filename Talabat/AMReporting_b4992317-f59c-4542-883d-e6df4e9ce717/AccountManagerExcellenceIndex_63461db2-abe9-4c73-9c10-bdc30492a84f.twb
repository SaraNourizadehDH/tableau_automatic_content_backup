    <worksheet name='time spent in hours'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Regular' fontsize='11'>Time spent in &lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Regular' fontsize='11'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Regular' fontsize='11'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_sana' name='federated.1yjcp73164np6b1b9h6sp0vfmnw9' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Units of time' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Minutes&quot;'>
              <calculation class='tableau' formula='&quot;Minutes&quot;' />
            </column>
            <column caption='Views' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Breakdown&quot;'>
              <calculation class='tableau' formula='&quot;Breakdown&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yjcp73164np6b1b9h6sp0vfmnw9'>
            <column caption=' Time spent (hrs) ' datatype='real' default-format='n#,##0;-#,##0' name='[ Time spent (mins)  (copy)_3636938217497784324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([course_time_spent_seconds])/3600)' />
            </column>
            <column caption=' Time spent (Secs)' datatype='integer' default-format='n#,##0;-#,##0' name='[ Time spent (mins)  (copy)_4202139980708503554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([course_time_spent_seconds]))' />
            </column>
            <column caption=' Time spent (mins) ' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3636938217233477633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([course_time_spent_seconds])/60)' />
