            <column caption='Retained vendor GMV %' datatype='real' default-format='p0.00%' name='[Calculation_2719470533388214275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Retained vendors GMV (LC) (copy)_2719470533387751426])/ sum([gmv_eur])' />
            </column>
            <column caption='Retained vendors GMV (EUR) ' datatype='real' name='[Retained vendors GMV (LC) (copy)_2719470533387751426]' role='measure' type='quantitative'>
