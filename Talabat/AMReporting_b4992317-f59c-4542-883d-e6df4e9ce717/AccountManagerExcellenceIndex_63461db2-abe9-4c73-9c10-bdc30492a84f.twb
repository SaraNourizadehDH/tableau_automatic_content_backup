          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='temp_account_manager_meeting' name='federated.0z3odbt0953del15h2zaq0w6y659' />
          </datasources>
          <datasource-dependencies datasource='federated.0z3odbt0953del15h2zaq0w6y659'>
            <column caption='Active in L3M' datatype='boolean' name='[Calculation_2523071361827487744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if {FIXED [chain_id] : (sum([orders]) &gt;0 or [Calculation_2523071361850122249] &gt; 0) } = true then true else false end' />
            </column>
            <column caption='Chain Tiers' datatype='string' name='[Calculation_2523071361828417537]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([chain_monetisation_tiers],&quot;Tier E&quot;)' />
            </column>
            <column caption='Top Tier chains' datatype='integer' name='[Calculation_2523071361828614146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [account_manager_name], [country_code], [Calculation_2523071361827487744],[is_contract_active] ,[chain_vertical]  : &#10;COUNTD(if [Calculation_2523071361828417537] in (&quot;AAA&quot;,&quot;Tier A&quot;,&quot;Tier B&quot;) then [chain_id] end)}' />
            </column>
            <column caption='Meeting Target (top tier chains)' datatype='integer' name='[Calculation_2523071361830682628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2523071361828614146] * 1' />
            </column>
            <column caption='Total Meetings (lower tier)' datatype='integer' name='[Calculation_2523071361831006214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Calculation_2523071361828417537] in (&quot;Tier C&quot;,&quot;Tier D&quot;,&quot;Tier E&quot;) then [event_id] end )' />
            </column>
            <column caption='events no' datatype='integer' name='[Calculation_2523071361850122249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([event_id])' />
            </column>
            <column caption='Meeting target achievement (lower tier chains)' datatype='real' name='[Calculation_2523071361854246923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2523071361831006214]) / sum([No of meetings (top tier chains) (copy)_2523071361830801413])' />
            </column>
            <column caption='Meeting target achievement (top tier chains)' datatype='real' name='[Meeting target achievement (lower tier chains) (copy)_2523071361855664142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Meetings (lower tier) (copy)_2523071361855299596] / sum([Calculation_2523071361830682628])' />
            </column>
            <column caption='Meeting Target (lower tier chains) ' datatype='integer' name='[No of meetings (top tier chains) (copy)_2523071361830801413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Top Tier chains (copy)_2523071361829773315] * 2' />
            </column>
            <column caption='Bottom Tier chains ' datatype='integer' name='[Top Tier chains (copy)_2523071361829773315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [account_manager_name], [country_code],[Calculation_2523071361827487744],[is_contract_active],[chain_vertical] : &#10;COUNTD(if [Calculation_2523071361828417537] in (&quot;Tier C&quot;,&quot;Tier D&quot;,&quot;Tier E&quot;) then [chain_id] end)}' />
