    <worksheet name='Vendors growing &gt; cohort'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Medium' fontsize='11'>Vendors m0m Growth % vs Cohort m0m Growth %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_northstar' name='federated.0fzruvl0kj7rcs174d9160ckmk5z' />
