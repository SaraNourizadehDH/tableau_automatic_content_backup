      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='northstar' id='_606E9BC5D712468BAD68EF4E6AD9810C'>
            <properties context=''>
              <relation connection='bigquery.15ui35815zb8or166zd8s0rn5iwk' name='Custom SQL Query' type='text'><![CDATA[with base as 
(
    select
        ta.date_month,
        ta.country_code,
        ta.account_manager_name,
        ta.team_leader_name,
        ta.vendor_id,
        ta.vendor_name,
        ta.chain_id,
        ta.chain_name,
        ta.account_manager_type,
        ta.vertical,
        case when lower(AM) is not null then true else false end as is_food_am,
        date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), month) as tenure_months,
        date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), year) as tenure_years,
    from `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta 
    left join 
    (
      select
        distinct
        u.createddate,
        lower(  firstname || " " || lastname) as user_name
      from  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
      where  1=1
      qualify row_number() over (partition by lower(  firstname || " " || lastname) order by createddate asc) = 1
    ) u on lower(ta.account_manager_name) = u.user_name
    left JOIN `tlb-data-prod.data_platform_google_sheet.account_manager_target` t on lower(AM) = u.user_name
    where 1=1
    and date_month >>= date_sub(date_trunc(current_date,month), interval 3 month)
)
, percentiles AS 
(
  SELECT
    distinct
    account_manager_type,
    PERCENTILE_CONT(tenure_months, 0.75) OVER (partition by account_manager_type) AS upper_bound_75,
    PERCENTILE_CONT(tenure_months, 0.25) OVER (partition by account_manager_type) AS lower_bound_25
  FROM base
)
, growth_products as 
(
  SELECT
    distinct
    DATE(ta.date_month) AS date_month,
    ta.country_code,
    ta.account_manager_name,
    ta.vendor_id,
    if(coalesce(cr.total_revenue_lc ,0) >>= 1 , ta.vendor_id , null ) on_ads,
    cr.total_revenue_lc,
    (case when vendor_funded_saving_amount_lc >>= 1 then ta.vendor_id else null end) on_vfd,
    coalesce(vendor_funded_saving_amount_lc,0) as vendor_funded_saving_amount_lc,
    ((CASE WHEN ta.is_active_l3 then ta.vendor_id else null end  )) AS active_inventory_l3,
    ((CASE WHEN ta.is_new_vendor_zero_order then ta.vendor_id else null end  )) AS new_vendor_0_order,
    (case when ta.is_new_vendor = true  and ta.successful_order_count >>= 1 then ta.vendor_id else null end ) as new_vendor_id_w_order, -- new vendors with orders
    ( if
    ( 
      ifnull(ta.successful_order_count,0) >>= 1  
        AND  ta.is_new_vendor = FALSE 
        AND ta.is_active_l3 = false
    , ta.vendor_id ,null
    ) ) reactivated_vendor,
  FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta
    LEFT JOIN (
        SELECT
            ta.date_month,
            ta.country_code,
            ta.vendor_id,
            SUM(
                COALESCE(
                    (gem_commission_amount_lc_excl_vat - LEAST(gem_flat_discount_amount_lc_excl_vat, gem_commission_amount_lc_excl_vat)), 0
                )
                + COALESCE(
                    (kword_revenue_lc_excl_vat - LEAST(kword_flat_discount_amount_lc_excl_vat, kword_revenue_lc_excl_vat)), 0
                )
                + COALESCE(feature_product_revenue_lc_excl_vat, 0)
                + COALESCE(
                    (cpp_revenue_lc_excl_vat - LEAST(cpp_flat_discount_amount_lc_excl_vat, cpp_revenue_lc_excl_vat)), 0
                )
                + COALESCE(
                    (organic_placement_revenue_lc_excl_vat - LEAST(cpc_flat_discount_amount_lc_excl_vat, organic_placement_revenue_lc_excl_vat) - cpc_credit_lc_excl), 0
                )
                + COALESCE(
                    (deal_target_revenue_lc_excl_vat - LEAST(deal_targeting_flat_discount_amount_lc_excl_vat, deal_target_revenue_lc_excl_vat)), 0
                )
                + COALESCE(
                    (display_ads_revenue_lc_excl_vat - LEAST(display_ads_flat_discount_amount_lc_excl_vat, display_ads_revenue_lc_excl_vat)), 0
                )
            ) AS total_revenue_lc
        FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta
        GROUP BY 1, 2, 3
    ) cr
        ON ta.date_month = cr.date_month
            AND ta.vendor_id = cr.vendor_id
    LEFT JOIN (
        SELECT
            DATE(date) AS date_month,
            LOWER(country_code) AS country_code,
            chain_id,
            MAX(chain_monetisation_tiers) AS chain_monetisation_tiers
        FROM `tlb-data-prod.data_platform.agg_chain_tiers`
        WHERE date = DATE_TRUNC(CURRENT_DATE, MONTH)
        GROUP BY 1, 2, 3
    ) t1
        ON ta.date_month = t1.date_month
            AND LOWER(ta.country_code) = LOWER(t1.country_code)
            AND ta.chain_id = t1.chain_id
    LEFT JOIN (
        SELECT
            DATE(month) AS month,
            LOWER(country_code) AS country_code,
            COALESCE(type = 'new', FALSE) AS vendor_acquired_type,
            MAX(SAFE_CAST(aaa_threshold AS FLOAT64)) AS aaa_threshold,
            MAX(SAFE_CAST(tier_a_threshold AS FLOAT64)) AS tier_a_threshold,
            MAX(SAFE_CAST(tier_b_threshold AS FLOAT64)) AS tier_b_threshold,
            MAX(SAFE_CAST(tier_c_threshold AS FLOAT64)) AS tier_c_threshold,
            MAX(SAFE_CAST(tier_d_threshold AS FLOAT64)) AS tier_d_threshold,
            MAX(SAFE_CAST(tier_e_threshold AS FLOAT64)) AS tier_e_threshold
        FROM `tlb-data-prod.data_platform_google_sheet.tier_level_adrev_thresholds`
        GROUP BY 1, 2, 3
    ) t2
        ON ta.date_month = t2.month
            AND ta.is_new_vendor_l3 = t2.vendor_acquired_type
            AND LOWER(ta.country_code) = LOWER(t2.country_code)
    WHERE 1=1 
    AND (ta.date_month) >>= date_sub(date_trunc(current_date,month), interval 3 month)
    -- group by 
)
, vendor_growth as 
(
    WITH base AS 
    (
        SELECT
            a.date_month,
            a.country_code,
            COALESCE(c.chain_monetisation_tiers, "Tier E") AS chain_monetisation_tiers,
            a.vendor_id,
            a.gmv_lc,
            a.gmv_eur,
            LAG(a.gmv_lc, 1) OVER (PARTITION BY a.vendor_id, c.chain_monetisation_tiers, a.country_code ORDER BY a.date_month) AS vendor_m1_gmv_lc,
            LAG(a.gmv_eur, 1) OVER (PARTITION BY a.vendor_id, c.chain_monetisation_tiers, a.country_code ORDER BY a.date_month) AS vendor_m1_gmv_eur
        FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` a
        LEFT JOIN `tlb-data-prod.data_platform.agg_chain_tiers` c ON a.chain_id = c.chain_id AND c.date = DATE_TRUNC(DATE(CURRENT_DATE), MONTH)
        WHERE 1=1
        and a.date_month  >>= date_sub(date_trunc(current_date,month), interval 3 month)
        AND a.successful_order_count >>= 1
    -- AND a.country_code = 'BH'
    )
    , cohort AS 
    (
        SELECT
            date_month,
            country_code,
            chain_monetisation_tiers,
            SUM(gmv_lc) AS cohort_gmv_lc,
            SUM(gmv_eur) AS cohort_gmv_eur,
            LAG(SUM(gmv_lc), 1) OVER (PARTITION BY chain_monetisation_tiers, country_code ORDER BY date_month) AS cohort_m1_gmv_lc,
            LAG(SUM(gmv_eur), 1) OVER (PARTITION BY chain_monetisation_tiers, country_code ORDER BY date_month) AS cohort_m1_gmv_eur
        FROM base
        GROUP BY 1,2,3
    )
    SELECT
        b.date_month, 
        b.country_code,
        b.vendor_id,
        b.chain_monetisation_tiers,
        c.cohort_gmv_lc,
        c.cohort_m1_gmv_lc,
        c.cohort_gmv_eur,
        c.cohort_m1_gmv_eur,
        SUM(b.gmv_lc) AS gmv_lc,
        SUM(b.vendor_m1_gmv_lc) AS vendor_m1_gmv_lc,
        SUM(b.gmv_eur) AS gmv_eur,
        SUM(b.vendor_m1_gmv_eur) AS vendor_m1_gmv_eur,
        SAFE_DIVIDE(SAFE_SUBTRACT(SUM(b.gmv_lc), SUM(b.vendor_m1_gmv_lc)), SUM(b.vendor_m1_gmv_lc)) AS vendor_m0m,
        SAFE_DIVIDE(SAFE_SUBTRACT(c.cohort_gmv_lc, c.cohort_m1_gmv_lc), c.cohort_m1_gmv_lc) AS cohort_m0m,
        CASE WHEN 
            SAFE_DIVIDE(SAFE_SUBTRACT(SUM(b.gmv_lc), SUM(b.vendor_m1_gmv_lc)), SUM(b.vendor_m1_gmv_lc)) 
            >>= SAFE_DIVIDE(SAFE_SUBTRACT(c.cohort_gmv_lc, c.cohort_m1_gmv_lc), c.cohort_m1_gmv_lc) 
            THEN 1 ELSE 0  
        END AS vendor_growing_more_than_cohort,
        SAFE_DIVIDE(
            SAFE_DIVIDE(SAFE_SUBTRACT(SUM(b.gmv_lc), SUM(b.vendor_m1_gmv_lc)), SUM(b.vendor_m1_gmv_lc)),
            SAFE_DIVIDE(SAFE_SUBTRACT(c.cohort_gmv_lc, c.cohort_m1_gmv_lc), c.cohort_m1_gmv_lc)
        ) AS relative_growth_ratio
    FROM base b
    JOIN cohort c ON b.date_month = c.date_month AND b.country_code = c.country_code AND b.chain_monetisation_tiers = c.chain_monetisation_tiers
    WHERE b.date_month  >>= date_sub(date_trunc(current_date,month), interval 3 month)
    GROUP BY 1,2,3,4,5,6,7,8
)
, retention as 
(
    with base as 
    (
        SELECT
            a.date_month,
            a.vendor_id,
            a.country_code,
            a.successful_order_count,
            lag(a.successful_order_count,1) OVER (PARTITION BY a.vendor_id, a.country_code ORDER BY a.date_month) as m1_successful_order_count
        FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` a
        where 1=1
    )
    select
        date_month,
        country_code,  
        vendor_id, 
        sum(distinct case when successful_order_count >>= 1 then 1 end) as current_month_active_inventory,
        sum(distinct case when m1_successful_order_count >>= 1 then 1 end) as last_month_active_inventory,
        sum(distinct case when m1_successful_order_count >>= 1  and   successful_order_count >>= 1 then 1 end) as current_month_retained_vendors 
    from base 
    where 1=1
    group by 1,2,3 
)
select
    distinct
    b.*,
    p.upper_bound_75 as am_upper_bound,
    p.lower_bound_25 as am_lower_bound,
    CASE 
      WHEN b.tenure_months >>=  p.upper_bound_75 THEN 'Experienced'
      WHEN b.tenure_months <<=  p.lower_bound_25  THEN 'Newbie'
      ELSE 'Intermediate'
    END AS tenure_bucket,
    a.on_ads,
    a.total_revenue_lc,
    a.on_vfd,
    a.vendor_funded_saving_amount_lc,
    a.active_inventory_l3,
    a.new_vendor_0_order,
    a.new_vendor_id_w_order,
    a.reactivated_vendor,
    gr.chain_monetisation_tiers,
    gr.gmv_lc,
    gr.vendor_m1_gmv_lc,
    gr.cohort_gmv_lc,
    gr.cohort_m1_gmv_lc,
    gr.gmv_eur,
    gr.vendor_m1_gmv_eur,
    gr.cohort_gmv_eur,
    gr.cohort_m1_gmv_eur,
    gr.vendor_m0m,
    gr.cohort_m0m,
    gr.vendor_growing_more_than_cohort,
    gr.relative_growth_ratio,
    r.current_month_active_inventory,
    r.last_month_active_inventory,
    r.current_month_retained_vendors,
    safe_divide(current_month_retained_vendors , last_month_active_inventory ) as retention_rate
from base b
left join growth_products a on b.date_month = a.date_month and b.country_code = a.country_code and b.vendor_id = a.vendor_id
left join vendor_growth gr on b.date_month = gr.date_month and b.country_code = gr.country_code and b.vendor_id = gr.vendor_id
left join retention r on b.date_month = r.date_month and b.country_code = r.country_code and b.vendor_id = r.vendor_id
left join percentiles p on lower(b.account_manager_type) = lower(p.account_manager_type)
where 1=1 
and b.date_month  >>= date_sub(date_trunc(current_date,month), interval 3 month)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='temp_account_manager_meeting' inline='true' name='federated.0z3odbt0953del15h2zaq0w6y659' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1yga8oh05tcfyy19tpzl50634df7'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='savannahp@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1yga8oh05tcfyy19tpzl50634df7' name='Custom SQL Query' type='text'><![CDATA[with 
comm as
( SELECT
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ),
   
parent_kitchen as 
(select 
a.id as parent_id,
a.name as parent_name,
case when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as parent_kitchen,
(CONCAT(u.firstname, ' ', u.lastname)) AS group_owner_name,
u.id as group_owner_id,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on a.ownerid = u.id

where  1=1 
and type = "Group" 
group by 1 ,2,3,4,5
),

brand_kitchen as 
(select 
a.id as brand_id,
parentid as brand_parent_id,
pk.parent_name,
group_owner_name,
group_owner_id,
lower(a.name) as brand_name,
case 
when lower(pk.parent_name) like ("%delivery hero%") then "dhk"
when lower(pk.parent_name) like ("%dh kitchen%") then "dhk"
when lower(pk.parent_name) like ("%dhk%") then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as brand_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` a 
left join parent_kitchen pk on pk.parent_id = a.parentid
where 
a.type = "Brand"
group by 1 ,2,3,4,5,6,7
),

facility_kitchen as 
(select  
id,
case when (lower(name) like ("%delivery hero%") or lower(name) like ("%dh kitchen%") or lower(name) like ("%dhk%")) then "dhk" else "nonk" end as facility_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` 
where type = "Facility"
group by 1 ,2
),

--select * from brand_kitchen
group_base  as (
select 
lower(a.name) as name,
grid__c as salesforce_id,
coalesce (pk.parent_id, brand_parent_id, a.parentid) as group_id,
coalesce (pk.parent_name, bk.parent_name) as group_name,
coalesce (pk.group_owner_name,bk.group_owner_name) as group_owner_name,
coalesce (pk.group_owner_id,bk.group_owner_id) as group_owner_id,
case 
when parent_kitchen = "dhk" then "dhk"
when brand_kitchen = "dhk" then "dhk"
when facility_kitchen = "dhk" then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk"
when  a.parentid in ('0016900002nY7x1AAC',
'0016900002plqy0AAA',
'0016900002pm4RcAAI',
'0016900002YIhUFAA1',
'00169000032RsKnAAK',
'00169000033ky16AAA',
'001690000352Qn3AAE',
'00169000035XWKbAAO',
'0016900003DTUlqAAH') then "dhk"
when franchise_connection__c  = "0016900002tnxIsAAI" then "dhk" 
when a.facility__c = "0016900002yvbRkAAI" then "dhk"
when a.ownerid = "0056900000BJcveAAD" then "dhk" 
else "nonk" end as kitchens_tag,
count(*)  

from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join parent_kitchen pk on pk.parent_id = a.parentid
left join brand_kitchen bk on bk.brand_id = a.parentid
left join facility_kitchen fk on fk.id = a.facility__c
where  (a.vertical__c = "Restaurant"  or lower(a.vertical_segment__c) in ("bakery","drinks","snacks_and_sweets","specialty_coffee_and_tea"))
--and lower(a.country_code) = "ae"
--and a.grid__c = "4C2626"
group by 1 ,2,3,4,5,6,7 ),

tiers as 
(
SELECT 
distinct 
lower(country_code) as country_code,
chain_id as chain_id,
date,
lower(chain_name) as chain_name,
ifnull(chain_monetisation_tiers,"Tier E") AS  chain_monetisation_tiers
FROM `tlb-data-prod.data_platform.agg_chain_tiers` 
where date = date_trunc((current_date - interval 1 day),month)
),

orders as 
(
select 
vendor_id, 
count(distinct order_id) as orders,
sum(gmv_amount_eur) as GMV_eur,
sum(gmv_amount_lc) as GMV_lc

from `tlb-data-prod.data_platform.fct_order_info` o1 
where  date_trunc(o1.order_date,month) >>= date_trunc(current_date,month) - interval '4' month
and o1.is_successful
and o1.order_date << current_date 
group by 1
),

events as   
(
select
*
from 
(
  
  select
  distinct
  'event' as tag,
  e.country_code as event_country_code,
  e.accountid,
  partition_date,
  e.ownerid as meeting_owner_id,
  (CONCAT(us.firstname, ' ', us.lastname)) AS account_owner_name,
  us.title as account_owner_title,
  (CONCAT(us1.firstname, ' ', us1.lastname)) AS meeting_owner_name,
  us1.title as meeting_owner_title,
  e.id as event_id,
  e.type as event_type,
  e.subject,
  a.grid__c ,
  a.type as account_type,
  a.name as account_name,
  group_owner_id,
  group_owner_name,
  group_id,
  group_name,
  e.description,
  e.comments__c,
  a.vertical__c as vertical,
  a.vertical_segment__c as vertical_segment,
  date(activitydate) as event_date,
  o.business_type__c as business_type,
  a.vendor_grade__c as vendor_grade,

  from  `fulfillment-dwh-production.curated_data_shared_salesforce.event`  e 
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on a.id = e.accountid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o on e.whatid = o.id
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = a.ownerid
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us1 on us1.id = e.ownerid
  left join group_base gb on gb.salesforce_id = a.grid__c 
  where lower(e.type) <<>> ("email") --and lower(e.subject) in ("new meeting","follow up","meeting")
  and partition_date >>= "2025-01-01"
  and e.country_code <<>> "sa"

union all 
  select
  distinct
  'task' as tag,
  e.country_code as event_country_code,
  e.accountid,
  partition_date,
  e.ownerid as meeting_owner_id,
  (CONCAT(us.firstname, ' ', us.lastname)) AS account_owner_name,
  us.title as account_owner_title,
  (CONCAT(us1.firstname, ' ', us1.lastname)) AS meeting_owner_name,
  us1.title as meeting_owner_title,
  e.id as event_id,
  e.type as event_type,
  e.subject,
  a.grid__c ,
  a.type as account_type,
  a.name as account_name,
  group_owner_id,
  group_owner_name,
  group_id,
  group_name,
  e.description,
  e.comments__c,
  a.vertical__c as vertical,
  a.vertical_segment__c as vertical_segment,
  date(activitydate) as event_date,
  o.business_type__c as business_type,
  a.vendor_grade__c as vendor_grade,

  from  `fulfillment-dwh-production.curated_data_shared_salesforce.task`  e 
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on a.id = e.accountid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o on e.whatid = o.id
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = a.ownerid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us1 on us1.id = e.ownerid
  left join group_base gb on gb.salesforce_id = a.grid__c 
  where lower(e.type) <<>> ("email") --and lower(e.subject) in ("new meeting","follow up","meeting")
  and partition_date >>= "2025-01-01"
  and e.country_code <<>> "sa"
  
) 
where account_owner_name = meeting_owner_name
)

select
c.country_code,
v.vendor_id,
v.chain_id,
c.chain_name,
v.vendor_name,
v.account_manager_name,
v.team_leader_name,
v.first_online_date,
v.is_dh_kitchen,
o.orders,
chain_monetisation_tiers,
c.vertical as chain_vertical,
e.*,
is_contract_active


from `tlb-data-prod.data_platform.dim_vendor_info` v
join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id 
left join tiers t on t.chain_id = v.chain_id
left join orders o on o.vendor_id = v.vendor_id 
left join events e on e.grid__c = v.salesforce_id

where 
v.country_code <<>> "SA"
--and accountid = "001bO000003mM1JQAU"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1yga8oh05tcfyy19tpzl50634df7' name='Custom SQL Query' type='text'><![CDATA[with 
comm as
( SELECT
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ),
   
parent_kitchen as 
(select 
a.id as parent_id,
a.name as parent_name,
case when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as parent_kitchen,
(CONCAT(u.firstname, ' ', u.lastname)) AS group_owner_name,
u.id as group_owner_id,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on a.ownerid = u.id

where  1=1 
and type = "Group" 
group by 1 ,2,3,4,5
),

brand_kitchen as 
(select 
a.id as brand_id,
parentid as brand_parent_id,
pk.parent_name,
group_owner_name,
group_owner_id,
lower(a.name) as brand_name,
case 
when lower(pk.parent_name) like ("%delivery hero%") then "dhk"
when lower(pk.parent_name) like ("%dh kitchen%") then "dhk"
when lower(pk.parent_name) like ("%dhk%") then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as brand_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` a 
left join parent_kitchen pk on pk.parent_id = a.parentid
where 
a.type = "Brand"
group by 1 ,2,3,4,5,6,7
),

facility_kitchen as 
(select  
id,
case when (lower(name) like ("%delivery hero%") or lower(name) like ("%dh kitchen%") or lower(name) like ("%dhk%")) then "dhk" else "nonk" end as facility_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` 
where type = "Facility"
group by 1 ,2
),

--select * from brand_kitchen
group_base  as (
select 
lower(a.name) as name,
grid__c as salesforce_id,
coalesce (pk.parent_id, brand_parent_id, a.parentid) as group_id,
coalesce (pk.parent_name, bk.parent_name) as group_name,
coalesce (pk.group_owner_name,bk.group_owner_name) as group_owner_name,
coalesce (pk.group_owner_id,bk.group_owner_id) as group_owner_id,
case 
when parent_kitchen = "dhk" then "dhk"
when brand_kitchen = "dhk" then "dhk"
when facility_kitchen = "dhk" then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk"
when  a.parentid in ('0016900002nY7x1AAC',
'0016900002plqy0AAA',
'0016900002pm4RcAAI',
'0016900002YIhUFAA1',
'00169000032RsKnAAK',
'00169000033ky16AAA',
'001690000352Qn3AAE',
'00169000035XWKbAAO',
'0016900003DTUlqAAH') then "dhk"
when franchise_connection__c  = "0016900002tnxIsAAI" then "dhk" 
when a.facility__c = "0016900002yvbRkAAI" then "dhk"
when a.ownerid = "0056900000BJcveAAD" then "dhk" 
else "nonk" end as kitchens_tag,
count(*)  

from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join parent_kitchen pk on pk.parent_id = a.parentid
left join brand_kitchen bk on bk.brand_id = a.parentid
left join facility_kitchen fk on fk.id = a.facility__c
where  (a.vertical__c = "Restaurant"  or lower(a.vertical_segment__c) in ("bakery","drinks","snacks_and_sweets","specialty_coffee_and_tea"))
--and lower(a.country_code) = "ae"
--and a.grid__c = "4C2626"
group by 1 ,2,3,4,5,6,7 ),

tiers as 
(
SELECT 
distinct 
lower(country_code) as country_code,
chain_id as chain_id,
date,
lower(chain_name) as chain_name,
ifnull(chain_monetisation_tiers,"Tier E") AS  chain_monetisation_tiers
FROM `tlb-data-prod.data_platform.agg_chain_tiers` 
where date = date_trunc((current_date - interval 1 day),month)
),

orders as 
(
select 
vendor_id, 
count(distinct order_id) as orders,
sum(gmv_amount_eur) as GMV_eur,
sum(gmv_amount_lc) as GMV_lc

from `tlb-data-prod.data_platform.fct_order_info` o1 
