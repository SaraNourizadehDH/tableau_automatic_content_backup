      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='meeting_data' id='_2052CEF7CF1E4F1484F49CA385D5D20C'>
            <properties context=''>
              <relation connection='bigquery.1yga8oh05tcfyy19tpzl50634df7' name='Custom SQL Query' type='text'><![CDATA[with 
comm as
( SELECT
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ),
   
parent_kitchen as 
(select 
a.id as parent_id,
a.name as parent_name,
case when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as parent_kitchen,
(CONCAT(u.firstname, ' ', u.lastname)) AS group_owner_name,
u.id as group_owner_id,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on a.ownerid = u.id

where  1=1 
and type = "Group" 
group by 1 ,2,3,4,5
),

brand_kitchen as 
(select 
a.id as brand_id,
parentid as brand_parent_id,
pk.parent_name,
group_owner_name,
group_owner_id,
lower(a.name) as brand_name,
case 
when lower(pk.parent_name) like ("%delivery hero%") then "dhk"
when lower(pk.parent_name) like ("%dh kitchen%") then "dhk"
when lower(pk.parent_name) like ("%dhk%") then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk" 
else "nonk" end as brand_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` a 
left join parent_kitchen pk on pk.parent_id = a.parentid
where 
a.type = "Brand"
group by 1 ,2,3,4,5,6,7
),

facility_kitchen as 
(select  
id,
case when (lower(name) like ("%delivery hero%") or lower(name) like ("%dh kitchen%") or lower(name) like ("%dhk%")) then "dhk" else "nonk" end as facility_kitchen,
count(*)  
from   `fulfillment-dwh-production.curated_data_shared_salesforce.account` 
where type = "Facility"
group by 1 ,2
),

--select * from brand_kitchen
group_base  as (
select 
lower(a.name) as name,
grid__c as salesforce_id,
coalesce (pk.parent_id, brand_parent_id, a.parentid) as group_id,
coalesce (pk.parent_name, bk.parent_name) as group_name,
coalesce (pk.group_owner_name,bk.group_owner_name) as group_owner_name,
coalesce (pk.group_owner_id,bk.group_owner_id) as group_owner_id,
case 
when parent_kitchen = "dhk" then "dhk"
when brand_kitchen = "dhk" then "dhk"
when facility_kitchen = "dhk" then "dhk"
when lower(a.name) like ("%delivery hero%") then "dhk"
when lower(a.name) like ("%dh kitchen%") then "dhk"
when lower(a.name) like ("%dhk%") then "dhk"
when  a.parentid in ('0016900002nY7x1AAC',
'0016900002plqy0AAA',
'0016900002pm4RcAAI',
'0016900002YIhUFAA1',
'00169000032RsKnAAK',
'00169000033ky16AAA',
'001690000352Qn3AAE',
'00169000035XWKbAAO',
'0016900003DTUlqAAH') then "dhk"
when franchise_connection__c  = "0016900002tnxIsAAI" then "dhk" 
when a.facility__c = "0016900002yvbRkAAI" then "dhk"
when a.ownerid = "0056900000BJcveAAD" then "dhk" 
else "nonk" end as kitchens_tag,
count(*)  

from   `fulfillment-dwh-production.curated_data_shared_salesforce.account`  a
left join parent_kitchen pk on pk.parent_id = a.parentid
left join brand_kitchen bk on bk.brand_id = a.parentid
left join facility_kitchen fk on fk.id = a.facility__c
where  (a.vertical__c = "Restaurant"  or lower(a.vertical_segment__c) in ("bakery","drinks","snacks_and_sweets","specialty_coffee_and_tea"))
--and lower(a.country_code) = "ae"
--and a.grid__c = "4C2626"
group by 1 ,2,3,4,5,6,7 ),

tiers as 
(
SELECT 
distinct 
lower(country_code) as country_code,
chain_id as chain_id,
date,
lower(chain_name) as chain_name,
ifnull(chain_monetisation_tiers,"Tier E") AS  chain_monetisation_tiers
FROM `tlb-data-prod.data_platform.agg_chain_tiers` 
where date = date_trunc((current_date - interval 1 day),month)
),

orders as 
(
select 
vendor_id, 
count(distinct order_id) as orders,
sum(gmv_amount_eur) as GMV_eur,
sum(gmv_amount_lc) as GMV_lc

from `tlb-data-prod.data_platform.fct_order_info` o1 
where  date_trunc(o1.order_date,month) >>= date_trunc(current_date,month) - interval '4' month
and o1.is_successful
and o1.order_date << current_date 
group by 1
),

events as   
(
select
*
from 
(
  
  select
  distinct
  'event' as tag,
  e.country_code as event_country_code,
  e.accountid,
  partition_date,
  e.ownerid as meeting_owner_id,
  (CONCAT(us.firstname, ' ', us.lastname)) AS account_owner_name,
  us.title as account_owner_title,
  (CONCAT(us1.firstname, ' ', us1.lastname)) AS meeting_owner_name,
  us1.title as meeting_owner_title,
  e.id as event_id,
  e.type as event_type,
  e.subject,
  a.grid__c ,
  a.type as account_type,
  a.name as account_name,
  group_owner_id,
  group_owner_name,
  group_id,
  group_name,
  e.description,
  e.comments__c,
  a.vertical__c as vertical,
  a.vertical_segment__c as vertical_segment,
  date(activitydate) as event_date,
  o.business_type__c as business_type,
  a.vendor_grade__c as vendor_grade,

  from  `fulfillment-dwh-production.curated_data_shared_salesforce.event`  e 
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on a.id = e.accountid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o on e.whatid = o.id
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = a.ownerid
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us1 on us1.id = e.ownerid
  left join group_base gb on gb.salesforce_id = a.grid__c 
  where lower(e.type) <<>> ("email") --and lower(e.subject) in ("new meeting","follow up","meeting")
  and partition_date >>= "2025-01-01"
  and e.country_code <<>> "sa"

union all 
  select
  distinct
  'task' as tag,
  e.country_code as event_country_code,
  e.accountid,
  partition_date,
  e.ownerid as meeting_owner_id,
  (CONCAT(us.firstname, ' ', us.lastname)) AS account_owner_name,
  us.title as account_owner_title,
  (CONCAT(us1.firstname, ' ', us1.lastname)) AS meeting_owner_name,
  us1.title as meeting_owner_title,
  e.id as event_id,
  e.type as event_type,
  e.subject,
  a.grid__c ,
  a.type as account_type,
  a.name as account_name,
  group_owner_id,
  group_owner_name,
  group_id,
  group_name,
  e.description,
  e.comments__c,
  a.vertical__c as vertical,
  a.vertical_segment__c as vertical_segment,
  date(activitydate) as event_date,
  o.business_type__c as business_type,
  a.vendor_grade__c as vendor_grade,

  from  `fulfillment-dwh-production.curated_data_shared_salesforce.task`  e 
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on a.id = e.accountid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o on e.whatid = o.id
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = a.ownerid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us1 on us1.id = e.ownerid
  left join group_base gb on gb.salesforce_id = a.grid__c 
  where lower(e.type) <<>> ("email") --and lower(e.subject) in ("new meeting","follow up","meeting")
  and partition_date >>= "2025-01-01"
  and e.country_code <<>> "sa"
  
) 
where account_owner_name = meeting_owner_name
)

select
c.country_code,
v.vendor_id,
v.chain_id,
c.chain_name,
v.vendor_name,
v.account_manager_name,
v.team_leader_name,
v.first_online_date,
v.is_dh_kitchen,
o.orders,
chain_monetisation_tiers,
c.vertical as chain_vertical,
e.*,
is_contract_active


from `tlb-data-prod.data_platform.dim_vendor_info` v
join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id 
left join tiers t on t.chain_id = v.chain_id
left join orders o on o.vendor_id = v.vendor_id 
left join events e on e.grid__c = v.salesforce_id

where 
v.country_code <<>> "SA"
--and accountid = "001bO000003mM1JQAU"]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='temp_agg_account_manager_sana' inline='true' name='federated.1yjcp73164np6b1b9h6sp0vfmnw9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1cjf4w21qohilv18hv3qi07j9xb2'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='savannahp@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cjf4w21qohilv18hv3qi07j9xb2' name='Custom SQL Query' type='text'><![CDATA[with am_details as 
(
  SELECT
    country,
    company_name__c,
    firstname || " " || lastname AS user,
    userrole_name,
    email,
    title,
    CASE
        WHEN u.title IN ('Account Manager', 'Sales Executive', 'Sr. Analyst - Sales Performance', ' ') THEN 'Account Manager'
        WHEN u.title IN ('Sr. Account Manager') THEN 'Sr. Account Manager'
        WHEN u.title IN ('Key Account Manager') THEN 'Key Account Manager'
        WHEN u.title IN ('Sr. Key Account Manager') THEN 'Sr. Key Account Manager'
        WHEN u.title IN ('Online Account Manager', 'Online Account Manager II') THEN 'Online Account Manager'
        WHEN
            u.title IN (
                'Associate Team Lead Account Management', 'Team Lead Account Management', 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain'
            )
            THEN 'Team Lead'
        ELSE 'Account Manager'
    END AS title_type,
    central_job_role__c,
    createddate,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), month) as tenure_months,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), year) as tenure_years,
  FROM  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  INNER JOIN `tlb-data-prod.data_platform_google_sheet.account_manager_target` t on lower(AM) = lower(  firstname || " " || lastname) 
  WHERE 1=1
  AND company_name__c = 'Talabat'
  AND isactive
)
, sana_details as 
(
  select
    distinct
    ua.year_month,
    ua.user_display_name,
    ua.user_email,
    ua.monthly_active_users,
    ua.weekly_active_users,
    ua.daily_active_users,
    ct.content_title,
    sum(ct.time_spent_seconds) as course_time_spent_seconds,
    sum(c.courses_completed)courses_completed,
    sum(c.courses_started)courses_started,
    sum(c.courses_accessible)courses_accessible,
    safe_divide( sum(c.courses_started), sum(c.courses_accessible)) completion_rate_l1,
    safe_divide( sum(c.courses_completed), sum(c.courses_accessible)) completion_rate_l2,
    safe_divide( sum(c.courses_completed), sum(c.courses_started)) completion_rate_l3,
    -- program insights
    program_title, 
    sum(p.progress) program_progress, 
    sum(p.courses_started) program_courses_started, 
    sum(p.courses_completed) program_courses_completed
  from `tlb-data-prod.data_platform_sana.activity_per_user_country`  ua
  LEFT JOIN `tlb-data-prod.data_platform_sana.user_performance_time_spent_per_month`  up on ua.user_id = up.user_id and ua.year_month = up.year_month
  LEFT JOIN `tlb-data-prod.data_platform_sana.time_spent_by_user_per_course_program_per_month`  ct on ua.user_id = ct.user_id and ct.year_month = up.year_month 
  left join `tlb-data-prod.data_platform_sana.content_insights_per_user` c on ua.user_id = c.user_id and c.content_id = ct.content_id
  left join `tlb-data-prod.data_platform_sana.program_insights` p on ua.user_id = p.user_id 
  where 1=1
  and ct.content_type = 'course'
  -- and ua.user_display_name = 'Mohammad Sayyab'
 group by all
)
, percentiles AS 
(
  SELECT
    distinct
    title_type,
    PERCENTILE_CONT(tenure_months, 0.75) OVER (partition by title_type) AS upper_bound_75,
    PERCENTILE_CONT(tenure_months, 0.25) OVER (partition by title_type) AS lower_bound_25
  FROM am_details
)
select 
distinct 
    am.country,
    am.user,
    am.title,
    am.title_type,
    am.central_job_role__c,
    date_trunc(date(am.createddate),month) as employee_month,
    am.tenure_months,
    am.tenure_years,
    p.upper_bound_75 as am_upper_bound,
    p.lower_bound_25 as am_lower_bound,
    CASE 
      WHEN am.tenure_months >>=  upper_bound_75 THEN 'Experienced'
      WHEN am.tenure_months <<=  lower_bound_25  THEN 'Newbie'
      ELSE 'Intermediate'
    END AS tenure_bucket,
    -- s.monthly_active_users,
    -- s.weekly_active_users,
    -- s.daily_active_users,
    ( case when s.monthly_active_users is not null then user end) as monthly_active_users,
    ( case when s.weekly_active_users is not null then user end) as weekly_active_users,
    ( case when s.daily_active_users is not null then user end) as daily_active_users,
    date(s.year_month)year_month,
    s.content_title,
    s.course_time_spent_seconds,
    s.courses_completed,
    s.courses_started,
    s.courses_accessible,
    s.completion_rate_l1,
    s.completion_rate_l2,
    s.completion_rate_l3,
    s.program_title,
    s.program_progress,
    s.program_courses_started,
    s.program_courses_completed
from am_details am
LEFT join sana_details s on lower(am.email) = lower(s.user_email)
left join percentiles p on lower(am.title_type) = lower(p.title_type)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1cjf4w21qohilv18hv3qi07j9xb2' name='Custom SQL Query' type='text'><![CDATA[with am_details as 
(
  SELECT
    country,
    company_name__c,
    firstname || " " || lastname AS user,
    userrole_name,
    email,
    title,
    CASE
        WHEN u.title IN ('Account Manager', 'Sales Executive', 'Sr. Analyst - Sales Performance', ' ') THEN 'Account Manager'
        WHEN u.title IN ('Sr. Account Manager') THEN 'Sr. Account Manager'
        WHEN u.title IN ('Key Account Manager') THEN 'Key Account Manager'
        WHEN u.title IN ('Sr. Key Account Manager') THEN 'Sr. Key Account Manager'
        WHEN u.title IN ('Online Account Manager', 'Online Account Manager II') THEN 'Online Account Manager'
        WHEN
            u.title IN (
                'Associate Team Lead Account Management', 'Team Lead Account Management', 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain'
            )
            THEN 'Team Lead'
        ELSE 'Account Manager'
    END AS title_type,
    central_job_role__c,
    createddate,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), month) as tenure_months,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), year) as tenure_years,
  FROM  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  INNER JOIN `tlb-data-prod.data_platform_google_sheet.account_manager_target` t on lower(AM) = lower(  firstname || " " || lastname) 
  WHERE 1=1
  AND company_name__c = 'Talabat'
  AND isactive
)
, sana_details as 
(
  select
    distinct
    ua.year_month,
    ua.user_display_name,
    ua.user_email,
    ua.monthly_active_users,
    ua.weekly_active_users,
    ua.daily_active_users,
    ct.content_title,
    sum(ct.time_spent_seconds) as course_time_spent_seconds,
    sum(c.courses_completed)courses_completed,
    sum(c.courses_started)courses_started,
    sum(c.courses_accessible)courses_accessible,
    safe_divide( sum(c.courses_started), sum(c.courses_accessible)) completion_rate_l1,
    safe_divide( sum(c.courses_completed), sum(c.courses_accessible)) completion_rate_l2,
    safe_divide( sum(c.courses_completed), sum(c.courses_started)) completion_rate_l3,
    -- program insights
    program_title, 
    sum(p.progress) program_progress, 
    sum(p.courses_started) program_courses_started, 
    sum(p.courses_completed) program_courses_completed
  from `tlb-data-prod.data_platform_sana.activity_per_user_country`  ua
  LEFT JOIN `tlb-data-prod.data_platform_sana.user_performance_time_spent_per_month`  up on ua.user_id = up.user_id and ua.year_month = up.year_month
  LEFT JOIN `tlb-data-prod.data_platform_sana.time_spent_by_user_per_course_program_per_month`  ct on ua.user_id = ct.user_id and ct.year_month = up.year_month 
  left join `tlb-data-prod.data_platform_sana.content_insights_per_user` c on ua.user_id = c.user_id and c.content_id = ct.content_id
  left join `tlb-data-prod.data_platform_sana.program_insights` p on ua.user_id = p.user_id 
  where 1=1
  and ct.content_type = 'course'
  -- and ua.user_display_name = 'Mohammad Sayyab'
 group by all
)
, percentiles AS 
(
  SELECT
    distinct
    title_type,
    PERCENTILE_CONT(tenure_months, 0.75) OVER (partition by title_type) AS upper_bound_75,
    PERCENTILE_CONT(tenure_months, 0.25) OVER (partition by title_type) AS lower_bound_25
  FROM am_details
)
select 
distinct 
    am.country,
    am.user,
    am.title,
    am.title_type,
    am.central_job_role__c,
    date_trunc(date(am.createddate),month) as employee_month,
    am.tenure_months,
    am.tenure_years,
    p.upper_bound_75 as am_upper_bound,
    p.lower_bound_25 as am_lower_bound,
    CASE 
      WHEN am.tenure_months >>=  upper_bound_75 THEN 'Experienced'
      WHEN am.tenure_months <<=  lower_bound_25  THEN 'Newbie'
      ELSE 'Intermediate'
    END AS tenure_bucket,
    -- s.monthly_active_users,
    -- s.weekly_active_users,
    -- s.daily_active_users,
    ( case when s.monthly_active_users is not null then user end) as monthly_active_users,
    ( case when s.weekly_active_users is not null then user end) as weekly_active_users,
    ( case when s.daily_active_users is not null then user end) as daily_active_users,
    date(s.year_month)year_month,
    s.content_title,
    s.course_time_spent_seconds,
    s.courses_completed,
    s.courses_started,
    s.courses_accessible,
    s.completion_rate_l1,
    s.completion_rate_l2,
    s.completion_rate_l3,
    s.program_title,
    s.program_progress,
    s.program_courses_started,
    s.program_courses_completed
from am_details am
LEFT join sana_details s on lower(am.email) = lower(s.user_email)
left join percentiles p on lower(am.title_type) = lower(p.title_type)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
