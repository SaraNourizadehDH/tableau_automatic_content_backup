    <worksheet name='Vendor List - Retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Regular' fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_northstar' name='federated.0fzruvl0kj7rcs174d9160ckmk5z' />
          </datasources>
          <datasource-dependencies datasource='federated.0fzruvl0kj7rcs174d9160ckmk5z'>
            <column caption='Vendor Count' datatype='integer' name='[Calculation_4464052438711091200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_id])' />
            </column>
            <column caption='Total Inventory (L3)' datatype='integer' name='[Calculation_4464052438711832578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([active_inventory_l3]) &#10;+ COUNTD([new_vendor_0_order])&#10;+ COUNTD([new_vendor_id_w_order])&#10;+ countd([reactivated_vendor])' />
            </column>
            <column caption='Vendors Growing %' datatype='real' default-format='p0.00%' name='[Calculation_4464052438712070147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_growing_more_than_cohort])/[Calculation_4464052438711832578]' />
            </column>
            <column caption='Vendor Growth %' datatype='real' default-format='p0.00%' name='[Calculation_4464052438712987654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([gmv_lc]) - sum([vendor_m1_gmv_lc]) )/ sum([vendor_m1_gmv_lc])' />
            </column>
            <column caption='Cohort Growth % ' datatype='real' default-format='p0.00%' name='[Vendor m0m GR% (copy)_4464052438730956807]' role='measure' type='quantitative'>
