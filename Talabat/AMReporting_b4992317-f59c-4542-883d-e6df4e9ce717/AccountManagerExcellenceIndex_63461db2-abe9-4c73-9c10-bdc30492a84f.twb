      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_northstar' name='federated.0fzruvl0kj7rcs174d9160ckmk5z' />
          </datasources>
          <datasource-dependencies datasource='federated.0fzruvl0kj7rcs174d9160ckmk5z'>
            <column caption='% on Growth Products' datatype='real' default-format='p0.00%' name='[% on VFD (copy)_4464052438763618321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_4464052438763102224])/[Calculation_4464052438711832578]' />
            </column>
            <column caption='Total Inventory (L3)' datatype='integer' name='[Calculation_4464052438711832578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([active_inventory_l3]) &#10;+ COUNTD([new_vendor_0_order])&#10;+ COUNTD([new_vendor_id_w_order])&#10;+ countd([reactivated_vendor])' />
            </column>
            <column caption='on_growth_products' datatype='integer' name='[Calculation_4464052438763102224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [on_ads]&gt;=1 or [on_vfd] &gt;=1 then [vendor_id] end' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[active_inventory_l3]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_4464052438763102224]' derivation='CountD' name='[ctd:Calculation_4464052438763102224:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[new_vendor_0_order]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[new_vendor_id_w_order]' role='dimension' type='ordinal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[on_ads]' role='measure' type='quantitative' />
            <column datatype='integer' name='[on_vfd]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[reactivated_vendor]' role='dimension' type='ordinal' />
            <column-instance column='[% on VFD (copy)_4464052438763618321]' derivation='User' name='[usr:% on VFD (copy)_4464052438763618321:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4464052438711832578]' derivation='User' name='[usr:Calculation_4464052438711832578:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Vendor ID' datatype='integer' name='[vendor_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
