      <column caption='Retention %' datatype='real' default-format='p0.00%' name='[Calculation_2719470533379997696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([current_month_retained_vendors]) /SUM([last_month_active_inventory])' />
      </column>
      <column caption='Retained vendors GMV (LC)' datatype='real' name='[Calculation_2719470533384278017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [current_month_retained_vendors] &gt;= 1 then [gmv_lc] else null end' />
      </column>
      <column caption='Retained vendor GMV %' datatype='real' default-format='p0.00%' name='[Calculation_2719470533388214275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Retained vendors GMV (LC) (copy)_2719470533387751426])/ sum([gmv_eur])' />
      </column>
      <column caption='New Vendors' datatype='integer' name='[Calculation_2719470533389053957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([new_vendor_0_order]) + COUNTD([new_vendor_id_w_order])' />
      </column>
      <column caption='Vendor Count' datatype='integer' name='[Calculation_4464052438711091200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([vendor_id])' />
      </column>
      <column caption='Total Inventory (L3)' datatype='integer' name='[Calculation_4464052438711832578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([active_inventory_l3]) &#10;+ COUNTD([new_vendor_0_order])&#10;+ COUNTD([new_vendor_id_w_order])&#10;+ countd([reactivated_vendor])' />
      </column>
      <column caption='Vendors Growing %' datatype='real' default-format='p0.00%' name='[Calculation_4464052438712070147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_growing_more_than_cohort])/[Calculation_4464052438711832578]' />
      </column>
      <column caption='Vendor Growth %' datatype='real' default-format='p0.00%' name='[Calculation_4464052438712987654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([gmv_lc]) - sum([vendor_m1_gmv_lc]) )/ sum([vendor_m1_gmv_lc])' />
      </column>
      <column caption='min()' datatype='integer' name='[Calculation_4464052438739828745]' role='measure' type='quantitative'>
