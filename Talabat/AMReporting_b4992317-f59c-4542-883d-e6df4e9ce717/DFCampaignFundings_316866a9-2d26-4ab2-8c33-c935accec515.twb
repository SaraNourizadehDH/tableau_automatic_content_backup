          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11082f11yctbgk189vuz10pf52ko'>
            <column caption='Funding Source' datatype='string' name='[Calculation_1100215342487207936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF IFNULL([vendor_delivery_cost_lc],0) &gt; 0 THEN &quot;Vendor Funded&quot; &#10;ELSE &quot;Talabat Funded&quot; &#10;&#10;END' />
            </column>
            <column caption='Campaign Type' datatype='string' name='[Calculation_2536230285991186438]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [campaign_type_2]&#10;WHEN &quot;FDNC&quot; Then &quot;FDNC&quot;&#10;WHEN &quot;FD&quot; Then &quot;Free Delivery&quot;&#10;WHEN &quot;RDF&quot; Then &quot;Reduced Delivery Fee&quot;&#10;END' />
            </column>
            <column caption='FDNC &lt;&gt; VF Orders' datatype='integer' name='[Calculation_885098127623966720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [campaign_type_new] &#10;WHEN &apos;FDNC&lt;&gt;VF Campaigns&apos;&#10;THEN [orders]&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Total Vendor Funding (inc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_98797778512355328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [vendor_revenue_lc]&#13;&#10;WHEN &quot;Euro&quot; then [vendor_revenue_eur] END' />
            </column>
            <column aggregation='Sum' caption='Month' datatype='integer' name='[Month - Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='month' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [month])*100 + DATEPART(&apos;month&apos;, [month]))' />
