      <column caption='Total Vendor Funding (inc VAT)' datatype='real' name='[Calculation_2910662375232061441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [vendor_revenue_lc]&#10;WHEN &quot;Euro&quot; then [vendor_revenue_eur] END' />
      </column>
      <column caption='Total Vendor Funding (ext VAT)' datatype='real' name='[Calculation_2910662375232143362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [vendor_revenue_lc_exc_vat]&#10;WHEN &quot;Euro&quot; then [vendor_revenue_eur_exc_vat] END' />
      </column>
      <column caption='Vendor Funding P.O' datatype='real' name='[Calculation_2910662375232270339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2910662375232061441])/SUM([chargeable_orders])' />
      </column>
