      <aliases enabled='yes' />
      <column caption='Funding Source' datatype='string' name='[Calculation_1100215342487207936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF IFNULL([vendor_delivery_cost_lc],0) &gt; 0 THEN &quot;Vendor Funded&quot; &#10;ELSE &quot;Talabat Funded&quot; &#10;&#10;END' />
      </column>
      <column caption='Campaign Type' datatype='string' name='[Calculation_2536230285991186438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [campaign_type_2]&#10;WHEN &quot;FDNC&quot; Then &quot;FDNC&quot;&#10;WHEN &quot;FD&quot; Then &quot;Free Delivery&quot;&#10;WHEN &quot;RDF&quot; Then &quot;Reduced Delivery Fee&quot;&#10;END' />
      </column>
      <column caption='Avg Vendor Funding' datatype='real' name='[Calculation_4067735690426351630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//CASE [Currency] WHEN &quot;Local&quot; then [Vendor Funding P.O]&#10;//WHEN &quot;Euro&quot; then [vendor_delivery_cost_eur] END&#10;SUM([Calculation_98797778512355328])/SUM([chargeable_orders])' />
      </column>
      <column caption='Ticket ID' datatype='string' name='[Calculation_7437061474114801678]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;DFCM&quot; + SPLIT([campaign_name], &quot;DFCM&quot;,2)' />
      </column>
      <column caption='FDNC &lt;&gt; VF Orders' datatype='integer' name='[Calculation_885098127623966720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [campaign_type_new] &#10;WHEN &apos;FDNC&lt;&gt;VF Campaigns&apos;&#10;THEN [orders]&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='Total Vendor Funding (inc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_98797778512355328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [vendor_revenue_lc]&#13;&#10;WHEN &quot;Euro&quot; then [vendor_revenue_eur] END' />
      </column>
      <column caption='End Date ' datatype='string' name='[Calculation_98797778778505221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([campaign_active_to_local]),&quot;ongoing&quot;)' />
      </column>
      <column aggregation='Sum' caption='Month' datatype='integer' name='[Month - Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='month' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [month])*100 + DATEPART(&apos;month&apos;, [month]))' />
      </column>
      <column caption='Total TB Funding (inc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[TB Cost (exc VAT) (copy)_98797778515030020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [tlb_cost_lc]&#13;&#10;WHEN &quot;Euro&quot; then [tlb_cost_eur] END' />
      </column>
      <column caption='Avg Talabat Funding ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Talabat Funding P.O (copy)_1353894638709006336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then SUM([TB Cost (exc VAT) (copy)_98797778515030020])/SUM([chargeable_orders])&#13;&#10;WHEN &quot;Euro&quot; then SUM([TB Cost (exc VAT) (copy)_98797778515030020])/SUM([chargeable_orders]) END' />
      </column>
      <column caption='Total TB Funding (exc VAT)' datatype='real' default-format='N' name='[VF Revenue (exc VAT) (copy)_98797778514595843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [tlb_cost_lc_exc_vat]&#13;&#10;WHEN &quot;Euro&quot; then [tlb_cost_eur_exc_vat] END' />
      </column>
      <column caption='Total Vendor Funding (exc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[VF Revenue (inc VAT) (copy)_98797778513117185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then [vendor_revenue_lc_exc_vat]&#13;&#10;WHEN &quot;Euro&quot; then [vendor_revenue_eur_exc_vat] END' />
      </column>
      <column caption='Avg Customer Paid' datatype='real' name='[Vendor Funding P.O   (copy)_3967037989450199042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//CASE [Currency] WHEN &quot;Local&quot; then [Vendor Funding P.O]&#10;//WHEN &quot;Euro&quot; then [vendor_delivery_cost_eur] END&#10;&#10;&#10;SUM(CASE [Parameters].[Parameter 1] WHEN &quot;Local&quot; then delivery_fee_amount_lc&#10;WHEN &quot;Euro&quot; then delivery_fee_amount_lc END)&#10;&#10;/SUM([chargeable_orders])' />
      </column>
