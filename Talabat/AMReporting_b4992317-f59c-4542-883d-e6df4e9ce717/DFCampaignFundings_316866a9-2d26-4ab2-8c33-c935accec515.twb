      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run bold='true'>TMP Campaigns</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='1200' minheight='1200' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='387' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='386' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='3360' id='81' type-v2='title' w='98750' x='625' y='640'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='159' forceUpdate='true' h='13360' id='107' type-v2='text' w='98750' x='625' y='4000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#898989'>Notes</run>
                    <run fontcolor='#898989'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>1. </run>
                    <run bold='true' fontcolor='#000000'>Filter Data</run>
                    <run fontcolor='#000000'>: Use filters on the right, select relevant </run>
                    <run fontcolor='#000000' underline='true'>country</run>
                    <run fontcolor='#000000'> and </run>
                    <run fontcolor='#000000' underline='true'>month</run>
                    <run fontcolor='#000000'> to filter the data</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>2. </run>
                    <run bold='true' fontcolor='#000000'>Chargeable Orders</run>
                    <run fontcolor='#000000'>: Calculated as total campaign orders excluding tPro orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>3. </run>
                    <run bold='true' fontcolor='#000000'>Total Vendor Funding</run>
                    <run fontcolor='#000000'>: Calculated as the total vendor funding amount (VF per order * chargeable orders)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>4. </run>
                    <run bold='true' fontcolor='#000000'>Total TB Funding</run>
                    <run fontcolor='#000000'>: Calculated as the </run>
                    <run fontcolor='#000000' underline='true'>delta between incentivized DF</run>
                    <run fontcolor='#000000'> (customer + vendor df) and the </run>
                    <run fontcolor='#000000' underline='true'>default fees</run>
                    <run fontcolor='#000000'> without any incentives</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>5. </run>
                    <run bold='true' fontcolor='#000000'>Data Availability</run>
                    <run fontcolor='#000000'>: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>a. Funding splits (VF/TF) are dependent on the markets </run>
                    <run fontcolor='#000000' underline='true'>migrating to the new campaign process</run>
                    <run fontcolor='#000000'> (complete migration by Q2’24)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>b. Orders with a null &quot;vendor funding p.o&quot; field likely belong to campaigns with old naming conventions. You can use the &quot;</run>
                    <run fontcolor='#000000' underline='true'>is migrated</run>
                    <run fontcolor='#000000'>&quot; filter at the bottom right to specifically view campaigns with the new naming structure</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>6. </run>
                    <run bold='true' fontcolor='#000000'>Download Data</run>
                    <run fontcolor='#000000'>: Click top right download button, select &quot;crosstab&quot;, choose specific sheet for download</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='4480' id='310' mode='dropdown' name='TMP - Monthly Summary' param='[federated.088abwb1jcssrj14mc7e61b4u0br].[none:country_code:nk]' show-all='false' type-v2='filter' values='cascading' w='12266' x='87109' y='22880'>
