        CASE WHEN fd.account_manager IS NOT NULL THEN fd.account_manager ELSE o.account_manager END account_manager,
        CASE WHEN fd.campaign_id IS NOT NULL THEN fd.campaign_id ELSE o.dps_campaign_id END dps_campaign_id,
        CASE WHEN fd.campaign_name IS NOT NULL THEN fd.campaign_name ELSE o.campaign_name END campaign_name,
        CASE WHEN fd.carc IS NOT NULL THEN fd.carc ELSE o.carc END carc,
        CASE WHEN fd.campaign_start_date IS NOT NULL THEN fd.campaign_start_date ELSE o.campaign_active_from_local END campaign_active_from_local,
        CASE WHEN fd.campaign_end_date IS NOT NULL THEN fd.campaign_end_date ELSE o.campaign_active_to_local END campaign_active_to_local,
        CASE WHEN fd.requester_team IS NOT NULL THEN fd.requester_team ELSE o.requester_team END requester_team,
        CASE WHEN fd.account_manager IS NOT NULL THEN TRUE ELSE o.is_migrated END is_migrated,
        
        o.vendor_funding_local as vendor_delivery_cost_lc,
        o.is_fdnc_campaign,
        ROUND(SAFE_DIVIDE(o.vendor_funding_local, exchange_rate),3)  as vendor_delivery_cost_eur,
        
         case 
          when is_campaign_order  and is_tpro_order is false then talabat_delivery_fee_opportunity_cost_local
          when is_overlapping_vf_campaign  and is_tpro_order is false then 0
         end as dps_incentive_discount_local_calculated,


        case 
          when is_campaign_order  and is_tpro_order is false then ROUND(SAFE_DIVIDE(o.talabat_delivery_fee_opportunity_cost_local, exchange_rate),3)
          when is_overlapping_vf_campaign  and is_tpro_order is false then 0
         end as dps_incentive_discount_eur_calculated,

        
        case when o.is_campaign_order AND is_overlapping_vf_campaign is false then 1 else 0 end  campaign_order,
        case when  is_overlapping_vf_campaign is true then 1 else 0 end  fdnc_vf_order,
        case when o.is_campaign_order and o.is_tpro_order then 1 else 0 end  tpro_order,
        
        CASE 
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign) AND vendor_funding_local <<>> 0 AND delivery_fee_amount_lc=0  THEN 'FD - Vendor Funded'
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign) AND vendor_funding_local <<>> 0 AND delivery_fee_amount_lc>>0  THEN 'RFD - Vendor Funded'
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign) AND vendor_funding_local = 0 AND delivery_fee_amount_lc=0  THEN 'FD - Talabat Funded'
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign) AND vendor_funding_local = 0 AND delivery_fee_amount_lc>>0  THEN 'RFD - Talabat Funded'
        END AS campaign_type,

                CASE 
            WHEN is_tpro_order is false AND o.is_fdnc_campaign IS TRUE THEN 'FDNC'
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign)  AND delivery_fee_amount_lc=0  THEN 'FD'
            WHEN is_tpro_order is false AND o.is_fdnc_order IS FALSE AND (is_campaign_order OR is_overlapping_vf_campaign)  AND delivery_fee_amount_lc>>0  THEN 'RDF'
            

        END AS campaign_type_2,
        

        CASE WHEN is_overlapping_vf_campaign THEN 'FDNC<<>>VF Campaigns' ELSE 'Others' end campaign_type_new,
      CASE WHEN is_tpro_order then 0 else o.delivery_fee_amount_lc end delivery_fee_amount_lc,
      CASE WHEN is_tpro_order then 0 else ROUND(SAFE_DIVIDE(o.delivery_fee_amount_lc, exchange_rate),3) end delivery_fee_amount_eur,

    FROM data_playground_regional_pricing.delivery_fee_incentivized_orders o
    LEFT JOIN `tlb-data-dev.data_playground_regional_pricing.fdnc_orders_having_vendor_funded_campaigns` fd 
      on o.order_id = fd.order_id 
      --and o.country_code = fd.country_code
WHERE 
  is_campaign_order OR is_overlapping_vf_campaign
  --and is_fdnc_campaign is false 
    
    
)


SELECT
    month,
    country_code,
    city_name,
    max(vat_value) as city_vat_value,
    vendor_id,
    chain_id,
    vendor_name,
    chain_name,
    vertical,
    is_dh_kitchen,
    account_manager,
    dps_campaign_id,
    campaign_name,
    campaign_type,
    campaign_type_new,
    campaign_type_2,
    carc,
    campaign_active_from_local,
    campaign_active_to_local,
    vendor_delivery_cost_lc,
    vendor_delivery_cost_eur,
    is_migrated,
    requester_team,
    order_type,

    COUNT(DISTINCT order_id) AS orders,
    SUM(campaign_order) AS campaign_orders,
    SUM(fdnc_vf_order) AS fdnc_vf_orders,
    SUM(tpro_order) AS tpro_orders,
    SUM((campaign_order+fdnc_vf_order) - tpro_order) AS chargeable_orders,
    
    CAST((1.00 * vendor_delivery_cost_lc * SUM((campaign_order+fdnc_vf_order) - tpro_order)) AS FLOAT64) AS vendor_revenue_lc,
    CAST((1.00 * vendor_delivery_cost_eur * SUM((campaign_order+fdnc_vf_order) - tpro_order)) AS FLOAT64) AS vendor_revenue_eur,


    (CAST((1.00 * vendor_delivery_cost_lc * SUM((campaign_order+fdnc_vf_order) - tpro_order)) AS FLOAT64))/max(vat_value) as vendor_revenue_lc_exc_vat,
    (CAST((1.00 * vendor_delivery_cost_eur * SUM((campaign_order+fdnc_vf_order) - tpro_order)) AS FLOAT64))/max(vat_value) as vendor_revenue_eur_exc_vat,


    SAFE_DIVIDE(SUM(dps_incentive_discount_local_calculated),SUM((campaign_order+fdnc_vf_order) - tpro_order)) as tlb_cost_per_order,
    SAFE_DIVIDE(SUM(dps_incentive_discount_eur_calculated),SUM((campaign_order+fdnc_vf_order) - tpro_order)) as tlb_cost_per_order_eur,
    
    SUM(dps_incentive_discount_local_calculated)  AS tlb_cost_lc,
    SUM(dps_incentive_discount_eur_calculated)  AS tlb_cost_eur,
    
    SUM(dps_incentive_discount_local_calculated)/max(vat_value)  AS tlb_cost_lc_exc_vat,
    SUM(dps_incentive_discount_eur_calculated)/max(vat_value)  AS tlb_cost_eur_exc_vat,
    
    SUM(delivery_fee_amount_lc) as delivery_fee_amount_lc,
    SUM(delivery_fee_amount_eur) as delivery_fee_amount_eur,

    MAX(order_date) as last_order_date
    
    


FROM incentived_orders

where 1=1
--and country_code='AE'
 --and vendor_id=622158
-- and dps_campaign_id=290
--and month='2024-09-01'
--and tpro_order=0 

GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
