  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='DF Campaign Funding (Vendor + TB)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>DPS DF Campaign Funding by Vendor and Talabat</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Version 2.0</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-201:8967/t/Talabat/workbooks/DFCampaignFundings/DFCampaignFundingVendorTB?rev=' id='DFCampaignFundingVendorTB' path='/t/Talabat/workbooks/DFCampaignFundings' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_107' value='top' />
        </style-rule>
      </style>
      <size maxheight='1250' maxwidth='1280' minheight='1250' minwidth='1280' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL Query (data_playground_regional_pricing)' name='federated.11082f11yctbgk189vuz10pf52ko' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
          <calculation class='tableau' formula='&quot;Local&quot;' />
          <members>
            <member value='&quot;Local&quot;' />
            <member value='&quot;Euro&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.11082f11yctbgk189vuz10pf52ko'>
        <column caption='Funding Source' datatype='string' name='[Calculation_1100215342487207936]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF IFNULL([vendor_delivery_cost_lc],0) &gt; 0 THEN &quot;Vendor Funded&quot; &#10;ELSE &quot;Talabat Funded&quot; &#10;&#10;END' />
        </column>
        <column caption='Campaign Type' datatype='string' name='[Calculation_2536230285991186438]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [campaign_type_2]&#10;WHEN &quot;FDNC&quot; Then &quot;FDNC&quot;&#10;WHEN &quot;FD&quot; Then &quot;Free Delivery&quot;&#10;WHEN &quot;RDF&quot; Then &quot;Reduced Delivery Fee&quot;&#10;END' />
        </column>
        <column caption='Campaign Requester' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
        <column datatype='string' name='[carc]' role='dimension' type='nominal' />
        <column aggregation='Sum' caption='Chain ID' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
        <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
        <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column aggregation='Sum' caption='Campaign ID' datatype='real' name='[dps_campaign_id]' role='dimension' type='ordinal' />
        <column datatype='boolean' name='[is_dh_kitchen]' role='dimension' type='nominal' />
        <column datatype='date' name='[month]' role='dimension' type='quantitative' />
        <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Calculation_1100215342487207936]' derivation='None' name='[none:Calculation_1100215342487207936:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_2536230285991186438]' derivation='None' name='[none:Calculation_2536230285991186438:nk]' pivot='key' type='nominal' />
        <column-instance column='[account_manager]' derivation='None' name='[none:account_manager:nk]' pivot='key' type='nominal' />
        <column-instance column='[carc]' derivation='None' name='[none:carc:nk]' pivot='key' type='nominal' />
        <column-instance column='[chain_id]' derivation='None' name='[none:chain_id:ok]' pivot='key' type='ordinal' />
        <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
        <column-instance column='[dps_campaign_id]' derivation='None' name='[none:dps_campaign_id:ok]' pivot='key' type='ordinal' />
        <column-instance column='[is_dh_kitchen]' derivation='None' name='[none:is_dh_kitchen:nk]' pivot='key' type='nominal' />
        <column-instance column='[requester_team]' derivation='None' name='[none:requester_team:nk]' pivot='key' type='nominal' />
        <column-instance column='[vendor_id]' derivation='None' name='[none:vendor_id:ok]' pivot='key' type='ordinal' />
        <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
        <column datatype='string' name='[requester_team]' role='dimension' type='nominal' />
        <column aggregation='Sum' caption='Vendor ID' datatype='integer' name='[vendor_id]' role='dimension' type='ordinal' />
        <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
        <column caption='Vertical' datatype='string' name='[vertical]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98720' id='80' param='vert' type-v2='layout-flow' w='98750' x='625' y='640'>
            <zone h='4880' id='81' type-v2='title' w='98750' x='625' y='640'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='140' forceUpdate='true' h='11840' id='107' is-fixed='true' type-v2='text' w='98750' x='625' y='5520'>
              <formatted-text>
                <run bold='true' fontcolor='#898989'>Notes</run>
                <run fontcolor='#898989'>:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>1. </run>
                <run bold='true' fontcolor='#000000'>Filter Data</run>
                <run fontcolor='#000000'>: Use filters on the right, select relevant </run>
                <run fontcolor='#000000' underline='true'>country</run>
                <run fontcolor='#000000'> and </run>
                <run fontcolor='#000000' underline='true'>month</run>
                <run fontcolor='#000000'> to filter the data</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>2. </run>
                <run bold='true' fontcolor='#000000'>Chargeable Orders</run>
                <run fontcolor='#000000'>: Calculated as total campaign orders excluding tPro orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>3. </run>
                <run bold='true' fontcolor='#000000'>Total Vendor Funding</run>
                <run fontcolor='#000000'>: Calculated as the total vendor funding amount (VF per order * chargeable orders)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>4. </run>
                <run bold='true' fontcolor='#000000'>Total TB Funding</run>
                <run fontcolor='#000000'>: Calculated as the </run>
                <run fontcolor='#000000' underline='true'>delta between incentivized DF</run>
                <run fontcolor='#000000'> (customer + vendor df) and the </run>
                <run fontcolor='#000000' underline='true'>default fees</run>
                <run fontcolor='#000000'> without any incentives</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>5. </run>
                <run bold='true' fontcolor='#000000'>Data Availability</run>
                <run fontcolor='#000000'>: Orders with a null &quot;vendor funding p.o&quot; field likely belong to campaigns with old naming conventions. You can use the &quot;</run>
                <run fontcolor='#000000' underline='true'>is migrated</run>
                <run fontcolor='#000000'>&quot; filter at the bottom right to specifically view campaigns with the new naming structure</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>6. </run>
                <run bold='true' fontcolor='#000000'>Download Data</run>
                <run fontcolor='#000000'>: Click top right download button, select &quot;crosstab&quot;, choose specific sheet for download</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='82000' id='7' param='horz' type-v2='layout-flow' w='98750' x='625' y='17360'>
              <zone h='82000' id='5' type-v2='layout-basic' w='86484' x='625' y='17360'>
