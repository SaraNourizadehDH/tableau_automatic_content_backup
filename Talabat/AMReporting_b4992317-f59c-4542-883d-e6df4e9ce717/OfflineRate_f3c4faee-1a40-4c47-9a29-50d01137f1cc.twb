  </column>
  <column aggregation='User' caption='Check in failed offline time' datatype='real' default-type='quantitative' name='[Calculation_2000513078471507972]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum(if [Calculation_3358277981803941889] = &quot;Check in requirements&quot; then (([actual_offline_duration_in_seconds])/3600) end)/&\#10;([Total Scheduled hours  (copy)_2000513078471036931])' />
