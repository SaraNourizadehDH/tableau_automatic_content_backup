              <calculation class='tableau' formula='{FIXED [vendor_id],[month]:  if ifnull([Calculation_2321535240451727364],0) = 1 and ifnull([Offline rate % (copy)_1279233457048064006],0) = 1 and ifnull([m1 Offline rate %  (copy)_1279233457048190983],0) = 1 then &quot;t&quot; else &quot;f&quot; end }' />
