              <calculation class='tableau' formula='if [Parameters].[Group by (copy)_5091811990708408326] = &quot;Vendor age&quot; then [Calculation_5091811990705954821]&#10;&#10;elseif [Parameters].[Group by (copy)_5091811990708408326] = &quot;Chain Tiers&quot; then [Calculation_2321535240805199882]&#10;ELSEIF [Parameters].[Group by (copy)_5091811990708408326] = &quot;Vendor Grade&quot; then [vendor_grade__c]&#10;&#10;ELSEIF [Parameters].[Group by (copy)_5091811990708408326] =  &quot;Active vs Inactive vendors&quot; then [Calculation_2655786804205043712]&#10;&#10;ELSEIF [Parameters].[Group by (copy)_5091811990708408326] =  &quot;transmission category&quot; then [transmission_category]&#10;end' />
