      <connection channel='https' class='sqlproxy' dbname='offline_analysis_daily' directory='/dataserver' port='443' server='tableau.deliveryhero.net' server-oauth='' username='' workgroup-auth-mode='prompt'>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Calculation1]' formula='sum(if tag = &quot;Unavailability_date_reason&quot; then ([actual_offline_duration_in_seconds] / 60 ) end)' />
          <calculation column='[Calculation_2321535240512671751]' formula='sum([Calculation_419186634612125698]  ) / sum(([offline_time_minutes (copy)_307159570706325506]))' />
          <calculation column='[Calculation_2321535240805199882]' formula='IFNULL([chain_monetisation_tiers],&quot;Tier E&quot; )' />
          <calculation column='[Calculation_2437502952799834112]' formula='DATEDIFF(&apos;day&apos;, TODAY(),[first_online_date])' />
          <calculation column='[Calculation_2437502952800055297]' formula='if DATETRUNC(&apos;month&apos;,[first_online_date]) = [month] then &quot;New&quot; else &quot;Existing&quot;&#10;end' />
          <calculation column='[Calculation_2655786804205043712]' formula='if [Calculation_374854304221831170] = True then &quot;Active&quot;&#10;else &quot;Not Active&quot; end' />
          <calculation column='[Calculation_3358277981803941889]' formula='if [unavilability_reason] = &quot;UNREACHABLE&quot; THEN &quot;Unreachable&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CLOSED&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor Induced&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;ORDER_FAILURE&quot;) THEN &quot;Operational issues&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CHECK_IN_REQUIRED&quot;) THEN &quot;Check in requirements&quot;&#10;else &quot;Others&quot; end' />
          <calculation column='[Calculation_3358277983484706823]' formula='[Calculation_2321535240805199882]&#10;//if [orders - fixed] = true then [Chain tiers] else &quot;Inactive&quot; end' />
          <calculation column='[Calculation_3395784514723614721]' formula='{FIXED [vendor_id], [date] : max([daily_orders])}' />
          <calculation column='[Calculation_374854304221831170]' formula='{FIXED [vendor_id], [date] : sum([daily_orders]) &gt; 0 }' />
          <calculation column='[Calculation_419186634597621761]' formula='if [account_status__c] = &quot;Active&quot; then true else false end' />
          <calculation column='[Calculation_419186634612125698]' formula='if [tag] = &quot;Unavailability_date&quot; then [actual_offline_duration_in_seconds] end' />
          <calculation column='[Calculation_4312548519038525442]' formula='if [country_code] = &quot;ae&quot; and [city_name] in [city_name Set] then 1 &#10;ELSEIF [country_code] &lt;&gt; &quot;ae&quot; then 1 end' />
          <calculation column='[Calculation_4880213147334438915]' formula='if [sources] &lt;&gt; null then 1 else 0 end' />
          <calculation column='[Calculation_4880213147338244101]' formula='if [actual_offline_duration_in_seconds] &gt; 0.01 then 1 else 0 end' />
          <calculation column='[Calculation_4880213147347566598]' formula='sum([Calculation_419186634612125698]  ) / sum(([offline_time_minutes (copy)_307159570706325506]))' />
          <calculation column='[Calculation_5837228135003009025]' formula='{FIXED [date] : COUNTD([vendor_id])}' />
          <calculation column='[Calculation_5837228135004631042]' formula='COUNTD([vendor_id])' />
          <calculation column='[Calculation_6384415423619088394]' formula='ISOWEEKDAY([date])' />
          <calculation column='[Group by  (copy)_6384415423394136066]' formula='if [Parameters].[Group by (copy)_6384415423393579008] = &quot;Country&quot; then [country_code]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;Chain Tiers&quot; then [Calculation_3358277983484706823]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;City&quot; then [city_name]&#10;ELSEIF [Parameters].[Group by (copy)_6384415423393579008] = &quot;Vendor Grade&quot; then [vendor_grade__c]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;Area Name&quot; then [area_name]&#10;ELSEIF [Parameters].[Group by (copy)_6384415423393579008] = &quot;Cuisine&quot; then [main_cuisine]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;Unavailability source&quot; then [sources]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;Unavailability Reason&quot; then [unavilability_reason]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;transmission category&quot; then [transmission_category]&#10;elseif [Parameters].[Group by (copy)_6384415423393579008] = &quot;New vs Existing vendors&quot; then [Calculation_2437502952800055297]&#10;ELSEIF [Parameters].[Group by (copy)_6384415423393579008] = &quot;None&quot; then &quot; &quot;&#10;ELSEIF [Parameters].[Group by (copy)_6384415423393579008] = &quot;Active vs Inactive vendors&quot; then [Calculation_2655786804205043712]&#10;ELSEIF [Parameters].[Group by (copy)_6384415423393579008] = &quot;Reason group&quot; then [Calculation_3358277981803941889]&#10;end' />
