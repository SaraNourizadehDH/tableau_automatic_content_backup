  <aliases enabled='yes' />
  <column aggregation='Count' datatype='string' default-type='nominal' name='[:Measure Names]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <aliases>
      <alias key='&quot;[federated.0yahmse1mdqm901boo2hr147ypsp].[sum:sub_sessions:qk]&quot;' value='Sub sessions during offline' />
    </aliases>
  </column>
  <column aggregation='User' caption='Offline minutes' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[Calculation1]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum(if tag = &quot;Unavailability_date_reason&quot; then ([actual_offline_duration_in_seconds] / 60 ) end)' />
  </column>
  <column aggregation='User' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[Calculation3]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM([actual_offline_duration_in_seconds]) / TOTAL(SUM([actual_offline_duration_in_seconds]))'>
      <table-calc ordering-type='Columns' />
    </calculation>
  </column>
  <column aggregation='User' caption='Offline rate \%' datatype='real' default-type='quantitative' name='[Calculation_2321535240512671751]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([Calculation_419186634612125698]  ) / sum(([offline_time_minutes (copy)_307159570706325506]))' />
  </column>
  <column aggregation='Count' caption='Chain tiers' datatype='string' default-type='nominal' name='[Calculation_2321535240805199882]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IFNULL([chain_monetisation_tiers],&quot;Tier E&quot; )' />
  </column>
  <column aggregation='Sum' caption='days_from_first_onlinde_date' datatype='integer' default-type='quantitative' name='[Calculation_2437502952799834112]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(),[first_online_date])' />
  </column>
  <column aggregation='Count' caption='New vs Mature vendor' datatype='string' default-type='nominal' name='[Calculation_2437502952800055297]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[first_online_date]) = [month] then &quot;New&quot; else &quot;Existing&quot;&\#10;end' />
  </column>
  <column aggregation='Count' caption='Active vendors' datatype='string' default-type='nominal' name='[Calculation_2655786804205043712]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if [Calculation_374854304221831170] = True then &quot;Active&quot;&\#10;else &quot;Not Active&quot; end' />
  </column>
  <column aggregation='Count' caption='Reason group' datatype='string' default-type='nominal' name='[Calculation_3358277981803941889]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if [unavilability_reason] = &quot;UNREACHABLE&quot; THEN &quot;Unreachable&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;CLOSED&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor Induced&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;ORDER_FAILURE&quot;) THEN &quot;Operational issues&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;CHECK_IN_REQUIRED&quot;) THEN &quot;Check in requirements&quot;&\#10;else &quot;Others&quot; end' />
  </column>
  <column aggregation='Count' caption='Chain Tier' datatype='string' default-type='nominal' name='[Calculation_3358277983484706823]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_2321535240805199882]&\#10;//if [orders - fixed] = true then [Chain tiers] else &quot;Inactive&quot; end' />
  </column>
  <column aggregation='Sum' caption='orders fixed' datatype='integer' default-type='quantitative' name='[Calculation_3395784514723614721]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='{FIXED [vendor_id], [date] : max([daily_orders])}' />
  </column>
  <column aggregation='Count' caption='orders - fixed' datatype='boolean' default-type='nominal' name='[Calculation_374854304221831170]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='{FIXED [vendor_id], [date] : sum([daily_orders]) &gt; 0 }' />
  </column>
  <column aggregation='Count' caption='SF contract status' datatype='boolean' default-type='nominal' name='[Calculation_419186634597621761]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='if [account_status__c] = &quot;Active&quot; then true else false end' />
  </column>
  <column aggregation='Sum' caption='offline time in seconds' datatype='integer' default-type='quantitative' name='[Calculation_419186634612125698]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='if [tag] = &quot;Unavailability_date&quot; then [actual_offline_duration_in_seconds] end' />
  </column>
  <column aggregation='Count' caption='uae city check' datatype='integer' default-type='ordinal' name='[Calculation_4312548519038525442]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='if [country_code] = &quot;ae&quot; and [city_name] in [city_name Set] then 1 &\#10;ELSEIF [country_code] &lt;&gt; &quot;ae&quot; then 1 end' />
  </column>
  <column aggregation='Sum' caption='Calculation2' datatype='integer' default-type='quantitative' name='[Calculation_4880213147334438915]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='if [sources] &lt;&gt; null then 1 else 0 end' />
  </column>
  <column aggregation='Sum' caption='Offline events' datatype='integer' default-type='quantitative' name='[Calculation_4880213147338244101]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='if [actual_offline_duration_in_seconds] &gt; 0.01 then 1 else 0 end' />
  </column>
  <column aggregation='User' caption='Offline rate ' datatype='real' default-type='quantitative' name='[Calculation_4880213147347566598]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([Calculation_419186634612125698]  ) / sum(([offline_time_minutes (copy)_307159570706325506]))' />
  </column>
  <column aggregation='Count' caption='Offline during schedule start' datatype='boolean' default-type='nominal' name='[Calculation_4880213147365851146]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='DATETRUNC(&apos;hour&apos;,[schedule_start_timestamp_local]) = DATETRUNC(&apos;hour&apos;,[event_start_time_local])' />
  </column>
  <column aggregation='Sum' caption='vendors by day' datatype='integer' default-type='quantitative' name='[Calculation_5837228135003009025]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='{FIXED [date] : COUNTD([vendor_id])}' />
  </column>
  <column aggregation='User' caption='vendors' datatype='integer' default-type='quantitative' name='[Calculation_5837228135004631042]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNTD([vendor_id])' />
  </column>
  <column aggregation='Count' caption='Weekday vs Weekends' datatype='integer' default-type='ordinal' name='[Calculation_6384415423619088394]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='ISOWEEKDAY([date])' />
  </column>
  <column aggregation='User' caption='ranks' datatype='integer' default-type='quantitative' name='[Calculation_6384415423620821004]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='INDEX()'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='User' caption='index' datatype='integer' default-type='ordinal' name='[Calculation_6384415423925141518]' pivot='key' role='measure' type='ordinal' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='INDEX()'>
      <table-calc ordering-type='Rows' />
    </calculation>
