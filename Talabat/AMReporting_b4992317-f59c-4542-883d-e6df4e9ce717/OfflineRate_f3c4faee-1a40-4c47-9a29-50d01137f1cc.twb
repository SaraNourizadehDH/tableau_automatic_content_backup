    <worksheet name='month- summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Offline Rate %</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='offline_month' name='sqlproxy.0hzshrx03oa76z17a19331y1glwg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Group by  m' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0hzshrx03oa76z17a19331y1glwg'>
            <column aggregation='Count' caption='offline tag l3m' datatype='string' default-type='nominal' layered='true' name='[Calculation_1279233457048412170]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[month]:  if ifnull([Calculation_2321535240451727364],0) = 1 and ifnull([Offline rate % (copy)_1279233457048064006],0) = 1 and ifnull([m1 Offline rate %  (copy)_1279233457048190983],0) = 1 then &quot;t&quot; else &quot;f&quot; end }' />
            </column>
            <column aggregation='Sum' caption='Scheduled time agg' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2321535240451518466]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[month] : max([scheduled_duration_in_seconds])}' />
            </column>
            <column aggregation='User' caption='Offline rate %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2321535240451727364]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([actual_offline_duration_in_seconds]) / sum([Calculation_2321535240451518466])' />
            </column>
            <column aggregation='Count' caption='Chain tiers' datatype='string' default-type='nominal' layered='true' name='[Calculation_2321535240805199882]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='ifnull([Calculation_3358277983476441093],&quot;Tier E&quot;)' />
            </column>
            <column aggregation='Count' caption='New vs Mature vendor' datatype='string' default-type='nominal' layered='true' name='[Calculation_2437502952800055297]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
