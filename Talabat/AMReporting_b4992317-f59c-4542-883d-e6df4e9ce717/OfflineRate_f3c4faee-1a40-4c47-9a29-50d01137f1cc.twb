      <column aggregation='User' caption='Total Scheduled hours ' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2000513078470737922]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum([Calculation_2321535240451518466])/3600' />
