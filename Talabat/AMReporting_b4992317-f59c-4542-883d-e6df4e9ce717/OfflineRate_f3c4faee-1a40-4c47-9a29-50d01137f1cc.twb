      <column aggregation='Count' caption='Group by ' datatype='string' default-type='nominal' layered='true' name='[Calculation_2321535240804765705]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Country&quot; then [country_code]&#10;&#10;elseif [Parameters].[Parameter 1] = &quot;Chain Tiers&quot; then [Calculation_2321535240805199882]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Vendor Grade&quot; then [vendor_grade__c]&#10;&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Active vs Inactive vendors&quot; then [Calculation_2655786804205043712]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;New vs Existing vendors&quot; then [Calculation_2437502952800055297]&#10;&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Transmission category&quot; then [transmission_category]&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;City&quot; then [city_name]&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Reason group&quot; then [Calculation_3358277981803941889]&#10;end' />
      </column>
      <column aggregation='Count' caption='Chain tiers' datatype='string' default-type='nominal' layered='true' name='[Calculation_2321535240805199882]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='ifnull([Calculation_3358277983476441093],&quot;Tier E&quot;)' />
      </column>
      <column aggregation='Sum' caption='days_from_first_onlinde_date' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2437502952799834112]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(),[first_online_date])' />
