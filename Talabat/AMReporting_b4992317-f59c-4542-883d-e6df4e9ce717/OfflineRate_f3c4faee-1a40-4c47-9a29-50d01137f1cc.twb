            </column>
            <column aggregation='User' caption='Vendors (Absolute vs Stacked)' datatype='real' default-type='quantitative' layered='true' name='[Calculation_4365817656980901891]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]  = &quot;Absolute&quot; then [Calculation_6384415423527362564]&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Stacked %&quot; then [Calculation_4365817656980656129] end'>
                <table-calc ordering-type='Rows' />
