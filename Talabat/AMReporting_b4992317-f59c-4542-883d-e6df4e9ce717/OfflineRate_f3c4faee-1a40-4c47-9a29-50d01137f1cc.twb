            <column aggregation='User' caption='Offline rate %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2321535240451727364]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([actual_offline_duration_in_seconds]) / sum([Calculation_2321535240451518466])' />
