        <calculation class='tableau' formula='if [Parameters].[Parameter 9] = &quot;Schedule time&quot; then avg ([Calculation_1863997721955106819] )&#10;ELSEIF [Parameters].[Parameter 9] = &quot;Offline time&quot;  then [Operational issues offline time (copy)_2000513078472126471]&#10;end' />
