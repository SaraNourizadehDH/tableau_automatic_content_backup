      <column aggregation='Count' caption='New vs Mature vendor' datatype='string' default-type='nominal' layered='true' name='[Calculation_2437502952800055297]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[first_online_date]) = [month] then &quot;New&quot; else &quot;Mature&quot;&#10;end' />
      </column>
      <column aggregation='Count' caption='Active vendors' datatype='string' default-type='nominal' layered='true' name='[Calculation_2655786804205043712]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [Calculation_374854304221831170] = True then &quot;Active&quot;&#10;else &quot;Not Active&quot; end' />
      </column>
      <column aggregation='Count' caption='Reason group' datatype='string' default-type='nominal' layered='true' name='[Calculation_3358277981803941889]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [unavilability_reason] = &quot;UNREACHABLE&quot; THEN &quot;Unreachable&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CLOSED&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor Induced&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;ORDER_FAILURE&quot;) THEN &quot;Operational issues&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CHECK_IN_REQUIRED&quot;) THEN &quot;Check in requirements&quot;&#10;else &quot;Others&quot; end' />
      </column>
      <column aggregation='Sum' caption='Vendor with 90% offline' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_3358277981815701506]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED [vendor_id],[month] : if ([Calculation_2321535240451727364] &gt;= 0.9) then 1 else 0 end }' />
      </column>
      <column aggregation='Count' caption='Vendor offline for &gt; 90%' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_3358277981816143875]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='if [Calculation_3358277981815701506] = 1 then true else false end' />
