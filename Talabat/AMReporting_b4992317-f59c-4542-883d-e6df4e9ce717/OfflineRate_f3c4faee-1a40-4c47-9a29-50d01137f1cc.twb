            </column>
            <column aggregation='Count' caption='offlien bin flag' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_5091811990691139584]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_3395784514722217984] &gt; 0 and [Calculation_3395784514722217984] &lt;= 1' />
            </column>
            <column aggregation='Count' caption='Vendor Age' datatype='string' default-type='nominal' layered='true' name='[Calculation_5091811990705954821]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 30 then &quot;0 to 30 days&quot; &#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 30 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 60 then &quot;31 to 60 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 60 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 90 then &quot;61 to 90 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 90 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 120 then &quot;91 to 120 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 120 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 150 then &quot;121 to 150 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 150 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 180 then &quot;151 to 180 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 180 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 365 then &quot;181 to 365 days&quot;&#10;else &quot;&gt; 365 days&quot; end' />
            </column>
