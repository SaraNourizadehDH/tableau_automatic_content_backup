        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Calculation_1279233457048412170]' formula='{FIXED [vendor_id],[month]:  if ifnull([Calculation_2321535240451727364],0) = 1 and ifnull([Offline rate % (copy)_1279233457048064006],0) = 1 and ifnull([m1 Offline rate %  (copy)_1279233457048190983],0) = 1 then &quot;t&quot; else &quot;f&quot; end }' />
          <calculation column='[Calculation_1863997721955106819]' formula='//(if [Reason group] = &quot;Unreachable&quot; then [actual_offline_duration_in_seconds] end)  /3600&#10;//(  { FIXED [month], [Chain tiers], [country_code]  : sum([schedule time tiers]) }  )&#10;&#10;&#10;&#10; ({FIXED [country_code], [Calculation_2321535240805199882], [month],  [Calculation_3358277981803941889]  : if max([Calculation_3358277981803941889]) = &quot;Unreachable&quot; then [Offline rate % drill down (copy)_1863997721954189314]  end })' />
          <calculation column='[Calculation_2000513078470737922]' formula='sum([Calculation_2321535240451518466])/3600' />
          <calculation column='[Calculation_2000513078471507972]' formula='sum(if [Calculation_3358277981803941889] = &quot;Check in requirements&quot; then (([actual_offline_duration_in_seconds])/3600) end)/&#10;([Total Scheduled hours  (copy)_2000513078471036931])' />
          <calculation column='[Calculation_2000513078471929861]' formula='sum(if [Calculation_3358277981803941889] = &quot;Operational issues&quot; then (([actual_offline_duration_in_seconds])/3600) end) / ([Total Scheduled hours  (copy)_2000513078471036931])' />
          <calculation column='[Calculation_2321535240451518466]' formula='{FIXED [vendor_id],[month] : max([scheduled_duration_in_seconds])}' />
          <calculation column='[Calculation_2321535240451670019]' formula='sum([actual_offline_duration_in_seconds])/60' />
          <calculation column='[Calculation_2321535240451727364]' formula='sum([actual_offline_duration_in_seconds]) / sum([Calculation_2321535240451518466])' />
          <calculation column='[Calculation_2321535240804765705]' formula='if [Parameters].[Parameter 1] = &quot;Country&quot; then [country_code]&#10;&#10;elseif [Parameters].[Parameter 1] = &quot;Chain Tiers&quot; then [Calculation_2321535240805199882]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Vendor Grade&quot; then [vendor_grade__c]&#10;&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Active vs Inactive vendors&quot; then [Calculation_2655786804205043712]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;New vs Existing vendors&quot; then [Calculation_2437502952800055297]&#10;&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Transmission category&quot; then [transmission_category]&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;City&quot; then [city_name]&#10;ELSEIF [Parameters].[Parameter 1] =  &quot;Reason group&quot; then [Calculation_3358277981803941889]&#10;end' />
          <calculation column='[Calculation_2321535240805199882]' formula='ifnull([Calculation_3358277983476441093],&quot;Tier E&quot;)' />
          <calculation column='[Calculation_2437502952799834112]' formula='DATEDIFF(&apos;day&apos;, TODAY(),[first_online_date])' />
          <calculation column='[Calculation_2437502952800055297]' formula='if DATETRUNC(&apos;month&apos;,[first_online_date]) = [month] then &quot;New&quot; else &quot;Mature&quot;&#10;end' />
          <calculation column='[Calculation_2655786804205043712]' formula='if [Calculation_374854304221831170] = True then &quot;Active&quot;&#10;else &quot;Not Active&quot; end' />
          <calculation column='[Calculation_3358277981803941889]' formula='if [unavilability_reason] = &quot;UNREACHABLE&quot; THEN &quot;Unreachable&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CLOSED&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor Induced&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;ORDER_FAILURE&quot;) THEN &quot;Operational issues&quot;&#10;ELSEIF  [unavilability_reason] IN (&quot;CHECK_IN_REQUIRED&quot;) THEN &quot;Check in requirements&quot;&#10;else &quot;Others&quot; end' />
          <calculation column='[Calculation_3358277981815701506]' formula='{ FIXED [vendor_id],[month] : if ([Calculation_2321535240451727364] &gt;= 0.9) then 1 else 0 end }' />
          <calculation column='[Calculation_3358277981816143875]' formula='if [Calculation_3358277981815701506] = 1 then true else false end' />
          <calculation column='[Calculation_3358277981816365060]' formula='if [open_on_comp_flag] = &quot;open&quot; then true else FALSE end' />
          <calculation column='[Calculation_3358277983476441093]' formula='if [Calculation_374854304221831170] = true then [chain_monetisation_tiers]&#10;elseif [offline tag l3m (copy)_1279233457053061131]  = &quot;t&quot; and [Calculation_1279233457048412170]  = &quot;f&quot; then &quot;100% Offline for current month&quot;&#10;elseif [Calculation_1279233457048412170]  = &quot;t&quot; and [offline tag l3m (copy)_1863997721943056384] = &quot;f&quot; then &quot;100% Offline for last 3 months&quot;&#10;elseif  [offline tag l3m (copy)_1863997721943056384] = &quot;t&quot; then &quot;100% Offline for last 6 months&quot;&#10; else &quot;Zombie&quot; end' />
          <calculation column='[Calculation_3395784514722217984]' formula='{FIXED [vendor_id], [month] : ([Calculation_2321535240451727364])}' />
          <calculation column='[Calculation_3395784514723614721]' formula='{FIXED [vendor_id], [month] : max([orders])}' />
          <calculation column='[Calculation_374854304212832256]' formula='if ifnull([churn_vendors],0) &gt; 0  then &quot;True&quot; else &quot;False&quot; end' />
          <calculation column='[Calculation_374854304221831170]' formula='{FIXED [vendor_id], [month] : MAX([orders]) &gt; 0 }' />
          <calculation column='[Calculation_3810889768888610821]' formula='if [Parameters].[Parameter 9] = &quot;Schedule time&quot; then avg ([Calculation_1863997721955106819] )&#10;ELSEIF [Parameters].[Parameter 9] = &quot;Offline time&quot;  then [Operational issues offline time (copy)_2000513078472126471]&#10;end' />
          <calculation column='[Calculation_419186634597621761]' formula='if [account_status__c] = &quot;Active&quot; then true else false end' />
          <calculation column='[Calculation_4312548519038525442]' formula='if [country_code] = &quot;ae&quot; and [city_name] in [city_name Set] then 1 &#10;ELSEIF [country_code] &lt;&gt; &quot;ae&quot; then 1 end' />
          <calculation column='[Calculation_4312548519050174467]' formula='if [Parameters].[Parameter 6] = &quot;Account manager&quot; then [account_manager_name]&#10;ELSEIF [Parameters].[Parameter 6] = &quot;Vendor name&quot; then [vendor_name]&#10;elseif [Parameters].[Parameter 6] = &quot;Chain name&quot; then [chain_name]&#10;end' />
          <calculation column='[Calculation_4312548520258764805]' formula='{FIXED [vendor_id], [month], [unavilability_reason] = &quot;REFURBISHMENT&quot; : sum([offline - fixed (copy)_3395784517042946051]) } &gt; 200' />
          <calculation column='[Calculation_4365817656963416064]' formula='[Calculation_3395784514722217984] &gt; 0' />
          <calculation column='[Calculation_4829477331882422272]' formula='if [Parameters].[Parameter 8] = &quot;Total&quot; then [Calculation_2321535240451727364]&#10;else [Offline rate % (copy)_519884330800721922] end' />
          <calculation column='[Calculation_5091811990691139584]' formula='[Calculation_3395784514722217984] &gt; 0 and [Calculation_3395784514722217984] &lt;= 1' />
          <calculation column='[Calculation_5091811990705954821]' formula='if [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 30 then &quot;0 to 30 days&quot; &#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 30 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 60 then &quot;31 to 60 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 60 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 90 then &quot;61 to 90 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 90 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 120 then &quot;91 to 120 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 120 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 150 then &quot;121 to 150 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 150 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 180 then &quot;151 to 180 days&quot;&#10;ELSEIF  [days_from_first_onlinde_date (copy)_5091811990705147908] &gt; 180 and [days_from_first_onlinde_date (copy)_5091811990705147908] &lt;= 365 then &quot;181 to 365 days&quot;&#10;else &quot;&gt; 365 days&quot; end' />
          <calculation column='[Calculation_519884330800492544]' formula='{FIXED [country_code],[month], [Calculation_419186634597621761] : sum([Calculation_2321535240451518466])}' />
