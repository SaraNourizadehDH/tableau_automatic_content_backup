      <column aggregation='User' caption='Check in failed offline time' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2000513078471507972]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum(if [Calculation_3358277981803941889] = &quot;Check in requirements&quot; then (([actual_offline_duration_in_seconds])/3600) end)/&#10;([Total Scheduled hours  (copy)_2000513078471036931])' />
      </column>
      <column aggregation='User' caption='Operational issues offline time' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2000513078471929861]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum(if [Calculation_3358277981803941889] = &quot;Operational issues&quot; then (([actual_offline_duration_in_seconds])/3600) end) / ([Total Scheduled hours  (copy)_2000513078471036931])' />
      </column>
      <column aggregation='Sum' caption='Scheduled time agg' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2321535240451518466]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{FIXED [vendor_id],[month] : max([scheduled_duration_in_seconds])}' />
      </column>
      <column aggregation='User' caption='Offline time (min)' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2321535240451670019]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum([actual_offline_duration_in_seconds])/60' />
