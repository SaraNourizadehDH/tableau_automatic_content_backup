    <calculation class='tableau' formula='if [unavilability_reason] = &quot;UNREACHABLE&quot; THEN &quot;Unreachable&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;CLOSED&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor Induced&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;ORDER_FAILURE&quot;) THEN &quot;Operational issues&quot;&\#10;ELSEIF  [unavilability_reason] IN (&quot;CHECK_IN_REQUIRED&quot;) THEN &quot;Check in requirements&quot;&\#10;else &quot;Others&quot; end' />
