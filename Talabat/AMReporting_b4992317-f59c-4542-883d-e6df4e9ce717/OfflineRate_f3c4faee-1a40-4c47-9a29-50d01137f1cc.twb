        <calculation class='tableau' formula='{FIXED [vendor_id],[month]:  if ifnull([Calculation_2321535240451727364],0) = 1 and ifnull([Offline rate % (copy)_1279233457048064006],0) = 1 and ifnull([m1 Offline rate %  (copy)_1279233457048190983],0) = 1 then &quot;t&quot; else &quot;f&quot; end }' />
      </column>
      <column aggregation='Sum' caption='Offline rate % due to Unreachable' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1863997721955106819]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='//(if [Reason group] = &quot;Unreachable&quot; then [actual_offline_duration_in_seconds] end)  /3600&#10;//(  { FIXED [month], [Chain tiers], [country_code]  : sum([schedule time tiers]) }  )&#10;&#10;&#10;&#10; ({FIXED [country_code], [Calculation_2321535240805199882], [month],  [Calculation_3358277981803941889]  : if max([Calculation_3358277981803941889]) = &quot;Unreachable&quot; then [Offline rate % drill down (copy)_1863997721954189314]  end })' />
