      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='offline_month' name='sqlproxy.0hzshrx03oa76z17a19331y1glwg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Group By' datatype='string' name='[Group by (copy)_5091811990708408326]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Absolute vs Stacked' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0hzshrx03oa76z17a19331y1glwg'>
            <column aggregation='Count' caption='offline tag l3m' datatype='string' default-type='nominal' layered='true' name='[Calculation_1279233457048412170]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[month]:  if ifnull([Calculation_2321535240451727364],0) = 1 and ifnull([Offline rate % (copy)_1279233457048064006],0) = 1 and ifnull([m1 Offline rate %  (copy)_1279233457048190983],0) = 1 then &quot;t&quot; else &quot;f&quot; end }' />
            </column>
            <column aggregation='Sum' caption='Scheduled time agg' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2321535240451518466]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[month] : max([scheduled_duration_in_seconds])}' />
            </column>
            <column aggregation='User' caption='Offline rate %' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2321535240451727364]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([actual_offline_duration_in_seconds]) / sum([Calculation_2321535240451518466])' />
            </column>
            <column aggregation='Count' caption='Chain tiers' datatype='string' default-type='nominal' layered='true' name='[Calculation_2321535240805199882]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='ifnull([Calculation_3358277983476441093],&quot;Tier E&quot;)' />
            </column>
            <column aggregation='Count' caption='New vs Mature vendor' datatype='string' default-type='nominal' layered='true' name='[Calculation_2437502952800055297]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[first_online_date]) = [month] then &quot;New&quot; else &quot;Mature&quot;&#10;end' />
            </column>
            <column aggregation='Count' caption='Active vendors' datatype='string' default-type='nominal' layered='true' name='[Calculation_2655786804205043712]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Calculation_374854304221831170] = True then &quot;Active&quot;&#10;else &quot;Not Active&quot; end' />
            </column>
            <column aggregation='Count' caption='Chain Tier' datatype='string' default-type='nominal' layered='true' name='[Calculation_3358277983476441093]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Calculation_374854304221831170] = true then [chain_monetisation_tiers]&#10;elseif [offline tag l3m (copy)_1279233457053061131]  = &quot;t&quot; and [Calculation_1279233457048412170]  = &quot;f&quot; then &quot;100% Offline for current month&quot;&#10;elseif [Calculation_1279233457048412170]  = &quot;t&quot; and [offline tag l3m (copy)_1863997721943056384] = &quot;f&quot; then &quot;100% Offline for last 3 months&quot;&#10;elseif  [offline tag l3m (copy)_1863997721943056384] = &quot;t&quot; then &quot;100% Offline for last 6 months&quot;&#10; else &quot;Zombie&quot; end' />
            </column>
            <column aggregation='Sum' caption='offline - fixed' datatype='real' default-type='quantitative' layered='true' name='[Calculation_3395784514722217984]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id], [month] : ([Calculation_2321535240451727364])}' />
            </column>
            <column aggregation='Count' caption='orders - fixed' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_374854304221831170]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='{FIXED [vendor_id], [month] : MAX([orders]) &gt; 0 }' />
            </column>
            <column aggregation='Count' caption='SF contract status' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_419186634597621761]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='if [account_status__c] = &quot;Active&quot; then true else false end' />
            </column>
            <column aggregation='Count' caption='uae city check' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_4312548519038525442]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='if [country_code] = &quot;ae&quot; and [city_name] in [city_name Set] then 1 &#10;ELSEIF [country_code] &lt;&gt; &quot;ae&quot; then 1 end' />
            </column>
            <column aggregation='User' caption='stacked' datatype='real' default-type='quantitative' layered='true' name='[Calculation_4365817656980656129]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_6384415423527362564] / TOTAL([Calculation_6384415423527362564])'>
