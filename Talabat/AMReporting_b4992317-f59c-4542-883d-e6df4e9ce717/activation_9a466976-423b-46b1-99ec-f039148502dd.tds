  <field-sort-info field-sort-order-type='custom-order'>
    <field-sort-custom-order field='month' />
    <field-sort-custom-order field='Calculation_2103673660512509969' />
    <field-sort-custom-order field='date' />
    <field-sort-custom-order field='Calculation_5022639493773729793' />
    <field-sort-custom-order field='day' />
    <field-sort-custom-order field='country_code' />
    <field-sort-custom-order field='Calculation_565131445080633345' />
    <field-sort-custom-order field='Calculation_5022639493773352960' />
    <field-sort-custom-order field='FS_MTD_vendors' />
    <field-sort-custom-order field='AMs_MTD_vendors' />
    <field-sort-custom-order field='TS_MTD_vendors' />
