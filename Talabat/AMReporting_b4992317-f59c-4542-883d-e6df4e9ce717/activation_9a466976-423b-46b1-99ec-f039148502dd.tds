  <column caption='Activation M-2%' datatype='real' name='[Activation M-1% (copy)_2103673660245241863]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([live_m2_count])/sum([onboarded_m2_count])' />
  </column>
  <column caption='Active Absolute Diff %' datatype='real' name='[Active Absolute Diff (copy)_2103673660508524557]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([active_vendor_count])-([Calculation_2103673660242636801]))/[Calculation_2103673660242636801]' />
  </column>
  <column caption='Actual vs Target M2 %' datatype='real' default-format='*0%▲;-0%▼' name='[Actual vs Target M1 % (copy)_4147111628747046916]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([onboarded_m0_active_m2_count])-sum([M2_target]))/sum([M2_target])' />
  </column>
  <column caption='Actual vs Target M1 %' datatype='real' default-format='*0%▲;-0%▼' name='[Actual vs Target M1 (copy)_4147111628746428418]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([onboarded_m0_active_m1_count])-sum([M1_target]))/sum([M1_target])' />
  </column>
  <column caption='Actual vs Target M2' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual vs Target M1 (copy)_4147111628747038723]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([onboarded_m0_active_m2_count])-sum([M2_target])' />
  </column>
  <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(ZN([M0 Absolute Diff (copy)_2103673660506910731]) - LOOKUP(ZN([M0 Absolute Diff (copy)_2103673660506910731]), 1)) / ABS(LOOKUP(ZN([M0 Absolute Diff (copy)_2103673660506910731]), 1))'>
      <table-calc ordering-type='ColumnInPane' />
    </calculation>
  </column>
  <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(ZN(SUM([Calculation_1287255442418102272])) - LOOKUP(ZN(SUM([Calculation_1287255442418102272])), 1)) / ABS(LOOKUP(ZN(SUM([Calculation_1287255442418102272])), 1))'>
      <table-calc ordering-type='ColumnInPane' />
    </calculation>
  </column>
  <column caption='NewActiveVendorCount' datatype='integer' name='[Calculation_1287255442418102272]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[new_active_vendor_count]+[missing_info_active_vendors]' />
  </column>
  <column caption='New Activation Target' datatype='real' name='[Calculation_2103673660242509824]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[m0_activation_target_value]*[MTD_new_vendors_target]' />
  </column>
  <column caption='Active Vendors Target' datatype='real' name='[Calculation_2103673660242636801]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([Calculation_2103673660242509824])+sum([reactivated_target])+sum([retained_target])+sum([M1_target])+sum([M2_target])' />
  </column>
  <column caption='M_2_activaton_target_edited' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2103673660243513346]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if([M_2_activation_target])&lt;0 then 0 else [M_2_activation_target] END' />
  </column>
  <column caption='M_1_Target_edited' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2103673660243812355]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if([M_1_activation_target])&lt;0 then 0 else [M_1_activation_target] END' />
  </column>
  <column caption='M0 Activation %' datatype='real' name='[Calculation_2103673660244058116]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([new_active_vendor_count]+[missing_info_active_vendors])/sum([onboarded_m0_count])' />
  </column>
  <column caption='Activation M-1%' datatype='real' name='[Calculation_2103673660244561925]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([live_m1_count])/   sum([onboarded_m1_count])' />
  </column>
  <column caption='M0 Absolute Diff' datatype='real' name='[Calculation_2103673660506595338]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([new_active_vendor_count])-sum([Calculation_2103673660242509824])' />
  </column>
  <column caption='Active Absolute Diff' datatype='real' name='[Calculation_2103673660508319756]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([active_vendor_count])-([Calculation_2103673660242636801])' />
  </column>
  <column caption='Regional' datatype='string' name='[Calculation_2103673660512509969]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&quot;Regional&quot;' />
  </column>
  <column caption='Actual vs target (Active vendors)' datatype='real' name='[Calculation_2244481502000640058]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([active_vendor_count])-[Calculation_2103673660242636801])/[Calculation_2103673660242636801]' />
  </column>
  <column caption='Total New Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2665638406201094150]' role='measure' type='quantitative'>
