------------------------------------ my work here ---------------------------------------------
titles as (


select 

'FS' as title
union all 
select 'TS' as title 
union all 
select 'AMs' as title 



)

,days as (
select distinct month_start_date as month,d.date,
day_of_month,country_code,title as team  from `tlb-data-prod.data_platform.dim_date` d 
cross join `tlb-data-prod.data_platform.dim_country_info` c 

cross join titles 
where month_start_date between '2025-02-01' and date_trunc(current_date,month)
) 

,pre_output as (
select upper(country_code) as country, date_trunc(date,month) as month, 
date,
extract(day from date) as day_of_month, 

  CASE
    WHEN title IN (
      'Sales Executive', 'Sales Exeuctive', 'Sr. Sales Executive', 'Sr. Sales executive',
      'Coordinator Riders', 'Sales Acquisition - IC1', 'Team Lead Acquisition', 'Manager Acquisition',
      'Head Of Acquisitions & Partnerships', 'Lead Generator', 'Lead Generator Support', 'Intern - Sales'
    ) THEN 'FS'
      WHEN LOWER(opportunity_owner_name) = 'talabat lead research team' THEN 'FS'
    WHEN title IN (
      'Inside Sales Executive', 'Executive Inside Sales', 'Manager Content', 'Account Advisor - Content',
      "Account Advisor - Restaurants’ Operations", 'Supervisor Operations'
    ) THEN 'TS'
    WHEN title IN (
      'Account Manager', 'Sr. Key Account Manager', 'Key Account Manager', 'Team Lead Account Management',
      'Online Account Manager', 'Sr. Account Manager', 'Online Account Manager II',
      'Team lead Online Account Management', 'Phone Account Manager', 'Coordinator Sales - Account Management'
    ) THEN 'AMs'
    ELSE 'AMs'
  END AS team,
  count(distinct id) as vendors,
FROM base b 

where tag='Live'
and coalesce(date,date("1999-09-01")) <<>> date "1999-09-01"
and date_trunc(date,month) >>='2025-02-01'
and vertical='Restaurant'
group by all
)

--select * from pre_output

,pre_output_clean as (

select d.*, coalesce(vendors,0) as vendors, 
coalesce(sum(vendors) over(partition by d.month,d.country_code,d.team order by d.day_of_month),0) as MTD_vendors 
 from pre_output b
right join days d on  b.day_of_month=d.day_of_month and b.month=d.month and upper(b.country)=d.country_code and b.team=d.team
)





/*


select country_code, 
day_of_month, 
team, 
avg(weight_of_a_day) from before_agg
group by 1,2,3 
*/
,target as (
select a.*,t.Target_value,date(t.target_date) as target_date, 
avg_day_weight_opt*target_value as day_target_value
 from `tlb-data-dev.vendor_analytics.acquisition_daily_weights_optm_external`  a 
join --`tlb-data-dev.vendor_analytics.acquisition_targets`
`tlb-data-dev.vendor_analytics.acquisition_targets_materalized`
 t on a.country_code=t.country and a.team=t.team
--where t.country='AE'
)
, target_run as (

select country_code, 
day_of_month, 
team,
target_date, 
coalesce(sum(day_target_value) over(partition by country_code,target_date,team order by day_of_month),0) as target_MTD
from target 


) 
select o.*, t.target_MTD
 from pre_output_clean o
left join target_run t 
on o.month=t.target_date 
and o.day_of_month=t.day_of_month 
and o.country_code=t.country_code 
and o.team=t.team 

--and t.day_of_month = extract(day from current_date - interval '1' day)

) ,new_vendors as (
  
  --select month, 
  --country_code,
  --max(mtd_vendors) as mtd_vendors 
  --from (
  select month,
 country_code,
 date,
  sum(MTD_vendors) as MTD_vendors,
  sum(target_mtd) as MTD_new_vendors_target
 -- sum(MTD_vendors) MTD_vendors  
--date
 from hist_acq
 group by all)
 --group by all)





 ,activity_after_target as (
 select a.*, coalesce(mtd_vendors,0) MTD_vendors,
 MTD_new_vendors_target
    from activity a 
 left join new_vendors t on a.country_code=t.country_code --and t.date=current_date - interval '5' day
 and a.month=t.month and a.date=t.date
 --where a.month=date_trunc(current_date,month)

 /*union all 
  select a.*, mtd_vendors  from activity a 
 join t_4 t on a.country_code=t.country_code and t.month=a.month 
 and case when extract(month from t.month)=2 then extract(day from t.date)=24 else extract(day from t.date)=26 end
 where a.month <<>> date_trunc(current_date,month)
 */
 )
 , 
 retn_hist as (/*create or replace table `tlb-data-dev.vendor_analytics.Retention_targets_materialized` 
as select * from tlb-data-dev.vendor_analytics.Retention_targets;

*/
WITH Active_Base_LM AS (
    /* Active vendors in December 2024 */
    SELECT 
        vendor_id,
        country_code,
        month
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`
    WHERE vertical = 'Restaurant'
      --AND month = date_trunc(current_date,month)-interval '1' month  -- December 2024
      and month >>='2024-12-01'
      AND is_active  -- Only active vendors
),comm as 
( SELECT 
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ), 

  active_base_LM_filtered as (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from active_base_lm a 
left join comm c on a.vendor_id=c.vendor_id ) 
where vendor_dineout_flag=false
    
  ),

Active_Base_m0 AS (
    /* Active vendors in December 2024 */
    SELECT 
        vendor_id,
        country_code,
        month
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`
    WHERE vertical = 'Restaurant'
      AND month >>='2025-2-01' --date_trunc(current_date,month) -- December 2024
      AND is_active  -- Only active vendors
),
  active_base_m0_filtered as (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from active_base_m0 a 
left join comm c on a.vendor_id=c.vendor_id ) 
where vendor_dineout_flag=false
    
  )


,
date_series AS (
    -- Generate all dates in January 2025
    SELECT date ,date_trunc(date,month) as month
    FROM `tlb-data-prod.data_platform.dim_date` 
    WHERE date_trunc(date,month) between '2025-02-01' and date_trunc(current_date,month)
),

orders_M0 AS (
    -- Successful food orders in January 2025
    SELECT
        f.vendor_id,
        f.country_code,
        f.order_date,
        a.month
    FROM `tlb-data-prod.data_platform.fct_order_info` f 
    join active_base_m0_filtered a on f.vendor_id=a.vendor_id and a.month=date_trunc(f.order_date,month)
    WHERE date_trunc(order_date,month) >>='2025-02-01'
      --AND NOT is_non_food
      --AND is_successful
)


,daily_actuals as (
select month,
extract(day from date) as day, 
a.country_code, 
--retention_rate,
retained_vendors,
--active_base_last_month

from (
SELECT
    d.date,
    b.country_code,
    d.month,
    COUNT(DISTINCT o.vendor_id) AS retained_vendors,
    COUNT(DISTINCT b.vendor_id) AS active_base_last_month,
    ROUND(COUNT(DISTINCT o.vendor_id) * 1.0 / COUNT(DISTINCT b.vendor_id), 4) AS retention_rate
FROM date_series d
CROSS JOIN active_base_LM_filtered b  -- All active vendors from December
LEFT JOIN orders_m0 o
    ON b.vendor_id = o.vendor_id
    AND b.country_code = o.country_code
    AND o.order_date <<= d.date  -- Orders up to the current date
    and date_trunc(o.order_date,month)=b.month+ interval '1' month
    and date_trunc(o.order_date,month)=date_trunc(d.date,month)
GROUP BY all
)a 
--join last_month l on l.country_code=a.country_code
) 

,active_lm as (


    select country_code, month, 
    count(distinct vendor_id) active_lm
    from active_base_LM_filtered 
    group by all
  ) 

   ,active_lm_target as (

select country,
target_date as month,
Active_Inventory as lm_active_target 
  from `tlb-data-dev.vendor_analytics.Retention_targets_materialized` 



  )
  ,daily_actuals_v2 as (


    select a.*, alm.lm_active_target as active_base_last_month 
    ,retained_vendors/lm_active_target as retention_rate
    
     from daily_actuals a 
join active_lm_target alm on alm.country=a.country_code 
and alm.month=a.month - interval '1' month





  )

select *,round(target_retention_rate*active_base_last_month)  as target_retained
 from (

select d.*,target_value,
case when month='2025-02-01' and d.day=26 then
(target_value *0.996) 
when month='2025-02-01' and d.day=27 then
(target_value *0.998) 
  when month='2025-02-01' and d.day=28 then 
 (target_value*1) else  
target_value * daily_retention_weight end as target_retention_rate,




 from daily_actuals_v2 d 
join `tlb-data-dev.vendor_analytics.Retention_daily_weights` w 
on d.day=w.day and d.country_code=w.country_code
join `tlb-data-dev.vendor_analytics.Retention_targets_materialized` t on t.target_date=d.month
and t.country=d.country_code and t.Target_date=d.month

)









)






,retn_react as (
select ret.*,
reactivated_churn
,churn_last_month
,max_reactivated_churn
,reactivated_from_zombie
,max_base,
total_reactivated
,rh.target_value as react_target_value_EOM
,target_MTD_reactivated
 from retn_hist ret 
join reactivation_history rh on ret.day=rh.day 
and ret.month=rh.month 
and ret.country_code=rh.country_code
) 
,total_acq_targets as (
  
  
  select *, 
  lag(target_value) over(partition by country order by month) as lm_acq_targ,
   lag(target_value,2) over(partition by country order by month) as l2m_acq_targ
   from (
  select country, target_date as month, 
sum(target_value) as target_value 

 from `tlb-data-dev.vendor_analytics.acquisition_targets_materalized`
group by all 
/*
UAE	886
KW	200
EG	584
JO	231
IQ	306
OM	181
QA	102
BH	129
*/
union all 
select 'AE', date('2025-01-01'),886 
union all 
select 'KW', date('2025-01-01'),200 
union all 
select 'EG', date('2025-01-01'),584 
union all 
select 'JO', date('2025-01-01'),231 
union all 
select 'IQ', date('2025-01-01'),306 
union all 
select 'OM', date('2025-01-01'),181 
union all 
select 'QA', date('2025-01-01'),102 
union all 
select 'BH', date('2025-01-01'),129 
)

)
select t.*, round(a.retained_target) as retained_target, 
round(reactivated_target) as reactivated_target,
M1_target,M2_target,active_inventory

 from (

select country_code, month, 

max(target_retained) as retained_target,
max(target_MTD_reactivated)
as reactivated_target
 from retn_react
 where day=extract( day from current_date - interval '1' day)
 and month=date_trunc(current_date,month)
 group by all 
 union all


select country_code, month, 
max(target_value*active_base_last_month) as retained_target_value
,max(react_target_value_EOM) as reactivation_target_value
 from retn_react
 where  month <<>> date_trunc(current_date,month)
 
 group by all ) a
 join activity_after_target t 
 on t.month=a.month and t.country_code=a.country_code

 join `tlb-data-dev.vendor_analytics.m1_m2_activation_targets_materialized` ta on ta.target_date=a.month and ta.country=a.country_code

 join `tlb-data-dev.vendor_analytics.Retention_targets_materialized` act on act.Target_date=a.month and act.country=a.country_code]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
    <metadata-records>
      <metadata-record class='column'>
        <remote-name>month</remote-name>
        <remote-type>7</remote-type>
        <local-name>[month]</local-name>
        <parent-name>[Custom SQL Query]</parent-name>
        <remote-alias>month</remote-alias>
        <local-type>date</local-type>
