        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.112fp2j07765xo17b6wm30rzjivb' name='Custom SQL Query' type='text'>SELECT 
    V.vendor_id,
    V.vendor_name,
    V.chain_id,
    T.chain_name,
    V.country_code,
    V.salesforce_id,
    V.account_manager_email,
    V.team_leader_email,
    first_online_date,
    COALESCE(T.chain_monetisation_tiers, &apos;Tier E&apos;) as vendor_tier
FROM `tlb-data-prod.data_platform.dim_vendor_info` V
LEFT JOIN `tlb-data-prod.data_platform.agg_chain_tiers` T 
ON T.chain_id = V.chain_id
WHERE T.date = (
    SELECT MAX(date) 
    FROM `tlb-data-prod.data_platform.agg_chain_tiers`
)
AND is_non_food = FALSE</relation>
