      <date-options start-of-week='saturday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Selected comparison metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
          <calculation class='tableau' formula='&quot;GMV&quot;' />
