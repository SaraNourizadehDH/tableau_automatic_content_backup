    <worksheet name='Automation'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PST' name='federated.1w6srax005h1wz179ysbe06pwm4t' />
          </datasources>
          <datasource-dependencies datasource='federated.1w6srax005h1wz179ysbe06pwm4t'>
            <column caption='Retained vendors' datatype='integer' name='[Calculation_1495124749914238976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_retained] = True THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='Reactivated vendors' datatype='integer' name='[Calculation_1495124749916106753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_reactivated_churn] = True THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='Ad rev / GMV' datatype='real' name='[Calculation_1495124749917954050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2848386065975959558]/[Calculation_2848386065975042053]' />
            </column>
            <column caption='Ads vendors' datatype='integer' name='[Calculation_1495124749918830595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [ncr_eur] &gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='Ads vendor penetration' datatype='real' name='[Calculation_1495124749919690756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1495124749918830595]/[Calculation_2848386065973346307]' />
            </column>
            <column caption='Vendor-funded savings/GMV' datatype='real' name='[Calculation_1495124749920468997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2848386065976143879]/[Calculation_2848386065975042053]' />
            </column>
            <column caption='Vendor-funded vendors' datatype='integer' name='[Calculation_1495124749921243143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [vendor_funded_saving_eur] &gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='Vendor-funded saving penetration' datatype='real' name='[Calculation_1495124749921460232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1495124749921243143]/[Calculation_2848386065973346307]' />
            </column>
            <column caption='Self-serve NCR' datatype='real' name='[Calculation_1495124749923287051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cpc_revenue_selfserve_eur]+[gem_selfserve_eur]' />
            </column>
            <column caption='Self-serve VFD' datatype='real' name='[Calculation_1495124749923635212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[booster_discount_vendor_funded_self_serve_saving_eur]+[compensation_vendor_funded_self_serve_saving_eur]+[discounted_delivery_vendor_funded_self_serve_saving_eur]+[free_delivery_vendor_funded_self_serve_saving_eur]+[item_discount_vendor_funded_self_serve_saving_eur]+[menu_discount_vendor_funded_self_serve_saving_eur]+[voucher_wallet_vendor_funded_self_serve_saving_eur]' />
            </column>
            <column caption='Avg prep time' datatype='real' name='[Calculation_1495124750193643533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([prep_time_avg_mins])' />
            </column>
            <column caption='Vendor fail rate' datatype='real' name='[Calculation_1495124750193926158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1495124750194241551]/[Calculation_2848386065974902788]' />
            </column>
            <column caption='Failed orders' datatype='real' name='[Calculation_1495124750194241551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fail_order_count])' />
            </column>
            <column caption='DLP' datatype='real' name='[Calculation_1495124750194679824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_count])/sum([active_menu_items_count])' />
            </column>
            <column caption='DLD' datatype='real' name='[Calculation_1495124750194835473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_description_count])/sum([active_menu_items_count])' />
            </column>
            <column caption='Active flag' datatype='integer' name='[Calculation_2848386065970876416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_count] &gt; 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% active vendors' datatype='real' name='[Calculation_2848386065970966529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2848386065970876416]) / COUNTD([vendor_id])' />
            </column>
            <column caption='All PST vendors' datatype='integer' name='[Calculation_2848386065971986434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_id])' />
            </column>
            <column caption='Active vendors' datatype='integer' name='[Calculation_2848386065973346307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [order_active_status] = &quot;Active vendor&quot; THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='Orders' datatype='real' name='[Calculation_2848386065974902788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2848386065975042053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])' />
            </column>
            <column caption='Ad revenue' datatype='real' name='[Calculation_2848386065975959558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ncr_eur)' />
            </column>
            <column caption='Vendor-funded savings' datatype='real' name='[Calculation_2848386065976143879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(vendor_funded_saving_eur)' />
            </column>
            <column caption='AM' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[active_menu_items_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[booster_discount_vendor_funded_self_serve_saving_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[compensation_vendor_funded_self_serve_saving_eur]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
