from non_pst_performance_details1 t1 left join vfd_split t2 on t1.vendor_id = t2.vfd_vendor_id and cast(t1.date_month as date) = t2.vfd_snapshot_date left join cpc_self_serve cpc_ss on cast(t1.vendor_id as string) = cpc_ss.cpc_selfserve_vendor_id and cast(t1.date_month as date) = cpc_ss.cpc_selfserve_month left join gem_self_serve gem_ss on cast(t1.vendor_id as string) = gem_ss.gem_self_serve_vendor_id and cast(t1.date_month as date) = gem_ss.gem_selfserve_month left join vfd_self_serve vfd_ss on cast(t1.vendor_id as string) = cast(vfd_ss.vfd_selfserve_vendor_id as string) and cast(t1.date_month as date) = vfd_ss.vfd_selfserve_month
