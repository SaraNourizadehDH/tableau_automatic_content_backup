    <worksheet name='Selected metric performance vs. % active vendors - market level'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Selected metric performance vs. % active vendors</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PST' name='federated.1w6srax005h1wz179ysbe06pwm4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w6srax005h1wz179ysbe06pwm4t'>
            <column caption='Active flag' datatype='integer' name='[Calculation_2848386065970876416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_count] &gt; 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% active vendors' datatype='real' name='[Calculation_2848386065970966529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2848386065970876416]) / COUNTD([vendor_id])' />
            </column>
            <column caption='Active vendors' datatype='integer' name='[Calculation_2848386065973346307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [order_active_status] = &quot;Active vendor&quot; THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='Orders' datatype='real' name='[Calculation_2848386065974902788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2848386065975042053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])' />
            </column>
            <column caption='Ad revenue' datatype='real' name='[Calculation_2848386065975959558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ncr_eur)' />
            </column>
            <column caption='Vendor-funded savings' datatype='real' name='[Calculation_2848386065976143879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(vendor_funded_saving_eur)' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_2848386065984995340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &quot;Active vendors&quot; THEN [Calculation_2848386065973346307]&#10;  WHEN &quot;GMV&quot; THEN [Calculation_2848386065975042053]&#10;  WHEN &quot;Orders&quot; THEN [Calculation_2848386065974902788]&#10;  WHEN &quot;Vendor-funded savings&quot; THEN [Calculation_2848386065976143879]&#10;  WHEN &quot;Ad revenue&quot; THEN [Calculation_2848386065975959558]&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' datatype-customized='true' name='[date_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[ncr_eur]' role='measure' type='quantitative' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[tier]' derivation='None' name='[none:tier:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[order_active_status]' role='dimension' type='nominal' />
            <column datatype='real' name='[order_count]' role='measure' type='quantitative' />
            <column caption='Tier' datatype='string' name='[tier]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2848386065970966529]' derivation='User' name='[usr:Calculation_2848386065970966529:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2848386065984995340]' derivation='User' name='[usr:Calculation_2848386065984995340:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[vendor_funded_saving_eur]' role='measure' type='quantitative' />
            <column datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[vendor_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1w6srax005h1wz179ysbe06pwm4t].[none:country_code:nk]' filter-group='7'>
            <groupfilter function='level-members' level='[none:country_code:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
