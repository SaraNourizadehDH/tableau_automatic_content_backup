            <column caption='DLP' datatype='real' name='[Calculation_4337599802935066645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_count])/sum([active_menu_items_count])' />
            </column>
            <column caption='DLD' datatype='real' name='[Calculation_4337599802935132182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_description_count])/sum([active_menu_items_count])' />
            </column>
            <column caption='Add-to-cart rate' datatype='real' name='[Calculation_4337599802935189527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([added_to_cart_session_count])/sum([viewed_menu_session_count])' />
            </column>
            <column caption='Started checkout rate' datatype='real' name='[Calculation_4337599802935287832]' role='measure' type='quantitative'>
