          <member value='&quot;Ads vendor penetration&quot;' />
          <member value='&quot;Vendor-funded savings&quot;' />
          <member value='&quot;Vendor-funded savings / GMV&quot;' />
          <member value='&quot;Vendor-funded vendors&quot;' />
          <member value='&quot;Vendor-funded savings penetration&quot;' />
          <member value='&quot;Self-serve NCR&quot;' />
          <member value='&quot;\% self-serve NCR&quot;' />
          <member value='&quot;Self-serve VFD&quot;' />
          <member value='&quot;\% self-serve VFD&quot;' />
