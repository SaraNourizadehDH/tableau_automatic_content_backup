    <worksheet name='Vendor retention matrix % - market level'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PST' name='federated.1w6srax005h1wz179ysbe06pwm4t' />
          </datasources>
          <datasource-dependencies datasource='federated.1w6srax005h1wz179ysbe06pwm4t'>
            <column caption='Retention denominator' datatype='real' name='[Calculation_3438357619257372679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [acquisition_status_next] = &quot;Active vendor&quot; then [vendor_id (Custom SQL Query1)] end)  /&#10;SUM( { FIXED [acquisition_month (Custom SQL Query1)] : COUNTD(if [acquisition_status] = &quot;Active vendor&quot; then [vendor_id (Custom SQL Query1)]end)} )' />
            </column>
            <column caption='M+ category ' datatype='integer' name='[Calculation_5565956598175944718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [acquisition_month (Custom SQL Query1)], [next_month])' />
            </column>
            <column datatype='date' datatype-customized='true' name='[acquisition_month (Custom SQL Query1)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[acquisition_status]' role='dimension' type='nominal' />
            <column datatype='string' name='[acquisition_status_next]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5565956598175944718]' derivation='Max' name='[max:Calculation_5565956598175944718:qk]' pivot='key' type='quantitative' />
            <column-instance column='[acquisition_month (Custom SQL Query1)]' derivation='MY' name='[my:acquisition_month (Custom SQL Query1):ok]' pivot='key' type='ordinal' />
            <column datatype='date' name='[next_month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5565956598175944718]' derivation='None' name='[none:Calculation_5565956598175944718:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[tier]' derivation='None' name='[none:tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_retention_status]' derivation='None' name='[none:vendor_retention_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3438357619257372679]' derivation='User' name='[pcto:usr:Calculation_3438357619257372679:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Tier' datatype='string' name='[tier]' role='dimension' type='nominal' />
            <column datatype='integer' name='[vendor_id (Custom SQL Query1)]' role='measure' type='quantitative' />
            <column caption='Vendor retention category' datatype='string' name='[vendor_retention_status]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1w6srax005h1wz179ysbe06pwm4t].[max:Calculation_5565956598175944718:qk]' included-values='in-range'>
            <min>1</min>
            <max>7</max>
          </filter>
          <filter class='categorical' column='[federated.1w6srax005h1wz179ysbe06pwm4t].[none:country_code:nk]' filter-group='7'>
            <groupfilter function='level-members' level='[none:country_code:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
