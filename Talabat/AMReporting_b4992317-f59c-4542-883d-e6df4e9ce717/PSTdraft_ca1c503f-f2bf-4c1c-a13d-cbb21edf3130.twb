    <datasource caption='PST' inline='true' name='federated.1w6srax005h1wz179ysbe06pwm4t' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02h8n6i06o4p8m1g818h01r7j66h'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_billing' server-oauth='server-custom' username='mayank.mathur@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02h8n6i06o4p8m1g818h01r7j66h' name='Custom SQL Query1' type='text'><![CDATA[-- Get the latest available month from the agents table
with latest_month_va as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))
),

-- Get current month vendor-agent mapping
agent_vendor_map as (
  select
    va.date_month,
    v.account_manager_name,
    v.vendor_id
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents` va 
  left join `tlb-data-prod.data_platform.dim_vendor_info` v 
    on lower(trim(va.agent_name)) = lower(trim(v.account_manager_name))
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
  where cast(va.date_month as date) = (select date_month from latest_month_va) and sf.account_status__c = "Active"
),

-- Same as above, for use in VP table filtering
latest_month_vp as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))
),

-- Get historical vendor-agent mapping
vendor_portfolio_map as (
  select
    vp.date_month,
    v.account_manager_name,
    v.vendor_id
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_historical_portfolio` vp 
  left join `tlb-data-prod.data_platform.dim_vendor_info` v 
    on vp.vendor_id = safe_cast(v.vendor_id as string)
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
  where cast(vp.date_month as date) << (select date_month from latest_month_vp) and sf.account_status__c = "Active"
),

-- Union of all months of vendor-agent mappings
vendor_list as (
  select * from agent_vendor_map
  union all
  select * from vendor_portfolio_map
),

-- Identify acquisition month for each vendor
vendor_list2 as (
  select
    vendor_id,
    min(date_month) acquisition_month
  from
    vendor_list
  group by 1
),

-- Merge acquisition month back to full vendor list
vendor_list_final as (
  select
    t1.*,
    acquisition_month
  from vendor_list t1 
  left join vendor_list2 using (vendor_id)
),

-- Get order count and vendor status for each vendor-month
t1 as (
  select
    t1.vendor_id,
    t1.acquisition_month,
    t1.account_manager_name,
    t1.date_month,
    ta.order_count,
    case
      when ta.order_count is null then "Inactive vendor"
      when ta.order_count = 0 then "Inactive vendor"
      else "Active vendor"
    end as vendor_status
  from vendor_list_final t1 
  left join `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta 
    on cast(t1.date_month as date) = ta.date_month and t1.vendor_id = ta.vendor_id
  where t1.vendor_id is not null
),

-- Get next month and previous month for each vendor for retention tracking
t2 as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    date_month,
    vendor_status as acquisition_status,
    lead(date_month, 1) over (partition by vendor_id order by date_month) as next_month,
    lag(date_month, 1) over (partition by vendor_id order by date_month) as prev_month,
    lead(vendor_status, 1) over (partition by vendor_id order by date_month) as acquisition_status_next,
    row_number() over (partition by vendor_id order by date_month) as instance
  from t1
),

-- Add vendor_retention_status
tagged as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    cast(date_month as date) as date_month,
    acquisition_status,
    cast(next_month as date) as next_month,
    acquisition_status_next,
    instance,
    case
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) = 1 then "Retained"
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) = 0 then "Retained"
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) >> 1 then "Reactivated"
      when instance >> 1 and date_diff(cast(next_month as date), cast(date_month as date), month) = 1 then "Retained"
      when instance >> 1 and date_diff(cast(next_month as date), cast(date_month as date), month) >> 1 then "Reactivated"
      else "Other"
    end as vendor_retention_status
  from t2
),

-- Append Churned rows: 1 month after the max next_month per vendor
churned_rows as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    max(cast(date_month as date)) as date_month,
    "Inactive vendor" as acquisition_status,
    date_add(max(cast(date_month as date)), interval 1 month) as next_month,
    "Inactive vendor" as acquisition_status_next,
    max(instance) + 1 as instance,
    "Churned" as vendor_retention_status
  from tagged
  group by vendor_id, acquisition_month, account_manager_name
),

final_union as (
  select * from tagged where vendor_retention_status <<>> "Other"
  union all
  select * from churned_rows
)

select
  vendor_id, acquisition_month, account_manager_name, acquisition_status, next_month, acquisition_status_next, vendor_retention_status
from
  final_union
where next_month <<= date_trunc(current_date(), month)
order by vendor_id, date_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.02h8n6i06o4p8m1g818h01r7j66h' name='Custom SQL Query' type='text'>
            <columns>
              <column datatype='datetime' date-parse-format='yyyy-MM-dd' name='acquisition_month' />
            </columns>
            <![CDATA[
            
with latest_month_va as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))),

agent_vendor_map as (
  select
    va.date_month,
    v.account_manager_name,
    v.account_manager_email,
    case 
      when u.title in ("Account Manager","Sales Executive","Sr. Analyst - Sales Performance"," ") then "Account Manager"
      when u.title in ("Sr. Account Manager")  then "Sr. Account Manager"
      when u.title in ("Key Account Manager") then 'Key Account Manager'
      when u.title in ("Sr. Key Account Manager") then "Sr. Key Account Manager"
      when u.title in ("Online Account Manager", "Online Account Manager II") then 'Online Account Manager'
      when u.title in ("Associate Team Lead Account Management", "Team Lead Account Management", 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain') then 'Team Lead'
      else  "Account Manager" end as title_type,
    v.team_leader_name,
    v.country_code,
    v.vendor_id,
    v.vendor_name,
    ch.chain_id,
    ch.chain_name,
    ch.main_cuisine,
    t.chain_monetisation_tiers tier
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents` va left join `tlb-data-prod.data_platform.dim_vendor_info` v on lower(trim(va.agent_name)) = lower(trim(v.account_manager_name))
    left join `tlb-data-prod.data_platform.dim_chain` ch on v.chain_id = ch.chain_id
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
    left join `tlb-data-prod.data_platform.agg_chain_tiers` t on cast(va.date_month as date) = t.date and ch.chain_id = t.chain_id
    where cast(va.date_month as date) = (select date_month from latest_month_va) and sf.account_status__c = "Active"),

latest_month_vp as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))),

vendor_portfolio_map as (
  select
    vp.date_month,
    v.account_manager_name,
    v.account_manager_email,
    case 
      when u.title in ("Account Manager","Sales Executive","Sr. Analyst - Sales Performance"," ") then "Account Manager"
      when u.title in ("Sr. Account Manager")  then "Sr. Account Manager"
      when u.title in ("Key Account Manager") then 'Key Account Manager'
      when u.title in ("Sr. Key Account Manager") then "Sr. Key Account Manager"
      when u.title in ("Online Account Manager", "Online Account Manager II") then 'Online Account Manager'
      when u.title in ("Associate Team Lead Account Management", "Team Lead Account Management", 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain') then 'Team Lead'
      else  "Account Manager" end as title_type,
    v.team_leader_name,
    v.country_code,
    v.vendor_id,
    v.vendor_name,
    ch.chain_id,
    ch.chain_name,
    ch.main_cuisine,
    t.chain_monetisation_tiers tier
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_historical_portfolio` vp left join `tlb-data-prod.data_platform.dim_vendor_info` v on vp.vendor_id = safe_cast(v.vendor_id as string)
    left join `tlb-data-prod.data_platform.dim_chain` ch on v.chain_id = ch.chain_id
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
    left join `tlb-data-prod.data_platform.agg_chain_tiers` t on cast(vp.date_month as date) = t.date and ch.chain_id = t.chain_id
    where cast(vp.date_month as date) << (select date_month from latest_month_vp) and sf.account_status__c = "Active"),

vendor_details as (
  select * from agent_vendor_map
  union all
  select * from vendor_portfolio_map),

vendor_details2 as (
  select vendor_id, min(date_month) acquisition_month
  from vendor_details
  group by 1),

vendor_details_final as (
  select
    vendor_id,
    vendor_name,
    acquisition_month,
    date_month,
    account_manager_name,
    account_manager_email,
    title_type,
    team_leader_name,
    country_code,
    chain_id,
    chain_name,
    tier,
    main_cuisine
  from
    vendor_details left join vendor_details2 using (vendor_id)),

performance_details1 as (
  select
    t1.*,
    case
      when ta.order_count >> 0 then "Active vendor"
      else "Inactive vendor"
      end order_active_status,
    ta.order_count,
    ta.gmv_eur,
    ta.gmv_lc,
    inv.is_active,
    inv.is_retained,
    inv.is_reactivated_churn,
    ta.gem_commission_amount_eur,
    ta.kword_revenue_eur,
    ta.feature_product_revenue_eur,
    ta.cpp_revenue_eur,
    ta.organic_placement_revenue_eur,
    ta.banner_amount_eur,
    ta.super_saver_revenue_eur,
    ta.display_ads_revenue_eur,
    ta.cpc_credit_eur_excl,
    ta.gem_commission_amount_eur + ta.kword_revenue_eur + ta.feature_product_revenue_eur + ta.cpp_revenue_eur + ta.organic_placement_revenue_eur + ta.banner_amount_eur + ta.super_saver_revenue_eur + ta.display_ads_revenue_eur - ta.cpc_credit_eur_excl ncr_eur,
    ta.gem_commission_amount_lc,
    ta.kword_revenue_lc,
    ta.feature_product_revenue_lc,
    ta.cpp_revenue_lc,
    ta.organic_placement_revenue_lc,
    ta.banner_amount_lc,
    ta.super_saver_revenue_lc,
    ta.display_ads_revenue_lc,
    ta.cpc_credit_lc_excl,
    ta.gem_commission_amount_lc + ta.kword_revenue_lc + ta.feature_product_revenue_lc + ta.cpp_revenue_lc + ta.organic_placement_revenue_lc + ta.banner_amount_lc + ta.super_saver_revenue_lc + ta.display_ads_revenue_lc - ta.cpc_credit_lc_excl ncr_lc,
    ta.vendor_funded_saving_amount_eur vendor_funded_saving_eur,
    ta.vendor_funded_saving_amount_lc vendor_funded_saving_lc,
    ta.saving_amount_eur overall_saving_eur,
    ta.saving_amount_lc overall_saving_lc,
    ta.active_menu_items_count,
    ta.items_with_images_count,
    safe_divide(ta.items_with_images_count,ta.active_menu_items_count) dlp,
    ta.items_with_description_count,
    safe_divide(ta.items_with_description_count,ta.active_menu_items_count) dld,
    sum(p.viewed_menu_session_count) viewed_menu_session_count,
    sum(p.added_to_cart_session_count) added_to_cart_session_count,
    safe_divide(sum(p.added_to_cart_session_count),sum(p.viewed_menu_session_count)) add_to_cart_rate,
    sum(p.started_checkout_sessions_count) started_checkout_sessions_count,
    safe_divide(sum(p.started_checkout_sessions_count),sum(p.added_to_cart_session_count)) started_checkout_rate,
    sum(p.placed_order_session_count) placed_order_session_count,
    safe_divide(sum(p.placed_order_session_count),sum(p.started_checkout_sessions_count)) placed_order_rate,
    ta.vendor_fail_order_count,
    safe_divide(ta.vendor_fail_order_count,ta.order_count) vfr,
    safe_divide(sum(vendor_food_prep_time_sum),ta.order_count) prep_time_avg_mins,
    safe_divide(offline_duration_seconds, actual_duration_in_seconds)*100 offline_rate
  from vendor_details_final t1
    left join `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta on cast(t1.date_month as date) = ta.date_month and t1.vendor_id = ta.vendor_id and ta.country_code = t1.country_code
    left join `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` inv on t1.vendor_id = inv.vendor_id and cast(t1.date_month as date) = inv.month
    left join (select * from `tlb-data-prod.data_platform.agg_vendor_performance_monthly` p where vendor_id not in ('all','NA')) p on t1.vendor_id = safe_cast(p.vendor_id as int) and cast(t1.date_month as date) = p.snapshot_date
  group by all
  order by country_code, vendor_id, date_month),

hari_chain_tiers AS (
  SELECT
      DISTINCT
      LOWER(country_code) as country_code,
      (chain_id) as chain_id,
      date,
      LOWER(chain_name) as chain_name,
      IFNULL(chain_monetisation_tiers,"Tier E") as chain_tier
  FROM `tlb-data-prod.data_platform.agg_chain_tiers`),

hari_vfd_monthly AS (
  SELECT
    DATE_TRUNC(snapshot_date,month) as snapshot_date,
    country_code,
    vendor_id,
    is_tpro_exclusive,
    incentive_sub_type,
    is_targeted_campaign,
    vertical,
    delivery_arrangement,
    SUM(order_count) AS order_count,
    SUM(saving_lc) AS saving_lc,
    SUM(saving_eur) AS saving_eur,
    SUM(platform_incentive_cost_lc) AS platform_incentive_cost_lc,
    SUM(platform_incentive_cost_eur) AS platform_incentive_cost_eur,
    SUM(vendor_incentive_cost_lc) AS vendor_incentive_cost_lc,
    SUM(vendor_incentive_cost_eur) AS vendor_incentive_cost_eur,
    SUM(gmv_amount_incentive_lc) AS gmv_amount_incentive_lc,
    SUM(gmv_amount_incentive_eur) AS gmv_amount_incentive_eur,
    SUM(opportunity_cost_lc) AS opportunity_cost_lc,
    SUM(opportunity_cost_eur) AS opportunity_cost_eur,
  FROM  `tlb-data-prod.data_platform.agg_vendor_incentives_performance_daily` vfd 
  WHERE DATE_TRUNC(vfd.snapshot_date,MONTH) BETWEEN DATE_ADD(DATE_TRUNC(CURRENT_DATE()-1,MONTH), INTERVAL -13 month) AND DATE_TRUNC(CURRENT_DATE()-1,MONTH) AND vertical = 'food'
  GROUP BY ALL),

hari_vfd_monthly2 AS (
  SELECT
    DATE_TRUNC(snapshot_date, MONTH) AS snapshot_date,
    country_code,
    vendor_id,
    incentive_sub_type,
    SUM(vendor_incentive_cost_eur) AS vendor_incentive_cost_eur,
    SUM(vendor_incentive_cost_lc) AS vendor_incentive_cost_lc
  FROM `tlb-data-prod.data_platform.agg_vendor_incentives_performance_daily`
  WHERE DATE_TRUNC(snapshot_date, MONTH) BETWEEN DATE_ADD(DATE_TRUNC(CURRENT_DATE()-1, MONTH), INTERVAL -13 MONTH) AND DATE_TRUNC(CURRENT_DATE()-1, MONTH)
    AND vertical = 'food'
  GROUP BY 1, 2, 3, 4),

vfd_split AS (
 SELECT
   snapshot_date vfd_snapshot_date,
   vendor_id vfd_vendor_id,
   sum(if(incentive_sub_type = 'free delivery', vendor_incentive_cost_lc, 0)) AS free_delivery_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'free delivery', vendor_incentive_cost_eur, 0)) AS free_delivery_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'Other vouchers', vendor_incentive_cost_lc, 0)) AS other_vouchers_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'Other vouchers', vendor_incentive_cost_eur, 0)) AS other_vouchers_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'Stamp Cards', vendor_incentive_cost_lc, 0)) AS stamp_card_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'Stamp Cards', vendor_incentive_cost_eur, 0)) AS stamp_card_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'Total Discount', vendor_incentive_cost_lc, 0)) AS total_discount_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'Total Discount', vendor_incentive_cost_eur, 0)) AS total_discount_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'MFO Order Item Incentive', vendor_incentive_cost_lc, 0)) AS mfo_order_incentive_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'MFO Order Item Incentive', vendor_incentive_cost_eur, 0)) AS mfo_order_incentive_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'item_discounts', vendor_incentive_cost_lc, 0)) AS item_discounts_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'item_discounts', vendor_incentive_cost_eur, 0)) AS item_discounts_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'tRewards', vendor_incentive_cost_lc, 0)) AS t_rewards_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'tRewards', vendor_incentive_cost_eur, 0)) AS t_rewards_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'tPro Delivery', vendor_incentive_cost_lc, 0)) AS tpro_delivery_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'tPro Delivery', vendor_incentive_cost_eur, 0)) AS tpro_delivery_vendor_funded_saving_eur,
   sum(if(incentive_sub_type = 'Total Discounted Targeted', vendor_incentive_cost_lc, 0)) AS total_targeted_discounts_vendor_funded_saving_lc,
   sum(if(incentive_sub_type = 'Total Discounted Targeted', vendor_incentive_cost_eur, 0)) AS total_targeted_discounts_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'buy x get y', vendor_incentive_cost_lc, 0)) AS buy_x_get_y_vendor_funded_saving_lc,
   sum(IF(incentive_sub_type = 'buy x get y', vendor_incentive_cost_eur, 0)) AS buy_x_get_y_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'MFO Order Delivery Incentive', vendor_incentive_cost_lc, 0)) AS mfo_order_deliv_vendor_funded_saving_lc,
   sum(IF(incentive_sub_type = 'MFO Order Delivery Incentive', vendor_incentive_cost_eur, 0)) AS mfo_order_deliv_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'gem', vendor_incentive_cost_lc, 0)) AS gem_vendor_funded_saving_lc,
   sum(IF(incentive_sub_type = 'gem', vendor_incentive_cost_eur, 0)) AS gem_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'menu discount', vendor_incentive_cost_lc, 0)) AS menu_discount_vendor_funded_saving_lc,
   sum(IF(incentive_sub_type = 'menu discount', vendor_incentive_cost_eur, 0)) AS menu_discount_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'Total', vendor_incentive_cost_lc, 0)) AS total_vendor_funded_saving_lc,
   sum(IF(incentive_sub_type = 'Total', vendor_incentive_cost_eur, 0)) AS total_vendor_funded_saving_eur,
   sum(IF(incentive_sub_type = 'discounted delivery', vendor_incentive_cost_lc, 0)) AS discounted_delivery_lc,
   sum(IF(incentive_sub_type = 'discounted delivery', vendor_incentive_cost_eur, 0)) AS discounted_delivery_eur,
 FROM hari_vfd_monthly2
 group by 1,2),

hassan_bookings_1 AS (
  SELECT
    date,
    DATE_TRUNC(date, MONTH) AS date_month,
    campaign_id,
    RIGHT(global_entity_id, 2) AS country_iso,
    v2.chain_id,
    dim_chain.chain_name,
    v2.vendor_id AS vendor_code,
    dim_vendor.vendor_name,
    dim_vendor.is_dh_kitchen,
    dim_vendor.account_manager_email,
    dim_vendor.team_leader_email,
    dim_vendor.account_manager_name,
    dim_vendor.is_tgo,
    dim_location.country_name,
    dim_location.city_name,
    dim_chain.vertical,
    v2.pricing_model,
    v2.targeting_strategy,
    FIRST_VALUE(is_auto_biding) OVER (
      PARTITION BY campaign_id, DATE_TRUNC(date, MONTH)
      ORDER BY DATE_TRUNC(date, MONTH), date DESC
    ) AS lastbid,
    is_auto_biding,
    FIRST_VALUE(status) OVER (
      PARTITION BY campaign_id, DATE_TRUNC(date, MONTH)
      ORDER BY DATE_TRUNC(date, MONTH), date DESC
    ) AS last_status,
    product AS type,
    pricing_model AS billing_type,
    status,
    tool,
    DATE(started_at_local) AS startdate,
    DATE(created_at_local) AS createddate,
    DATE(ended_at_local) AS enddate,
    CASE WHEN origin = 'vendor' THEN 'self_booking' ELSE 'agent_booking' END AS booking_source,
    CASE WHEN targeting_strategy = 'acquisition' THEN TRUE ELSE FALSE END AS clt_flag,
    SUM(clicks_count) AS clicks,
    MAX(budget.eur) AS BudgetEUR,
    MAX(budget.local) AS BudgetLC,
    CASE WHEN ROW_NUMBER() OVER (PARTITION BY campaign_id, DATE_TRUNC(date, MONTH) ORDER BY date DESC) = 1 THEN TRUE ELSE FALSE END AS last_budget,
    CASE WHEN ROW_NUMBER() OVER (PARTITION BY campaign_id, DATE_TRUNC(date, MONTH) ORDER BY date ASC) = 1 THEN TRUE ELSE FALSE END AS initial_budget,
    CASE WHEN ROW_NUMBER() OVER (PARTITION BY campaign_id, DATE_TRUNC(date, MONTH) ORDER BY MAX(budget.local) DESC) = 1 THEN TRUE ELSE FALSE END AS max_budget,
    SUM(revenue_eur) AS RevenueEUR,
    SUM(revenue) AS RevenueLC,
    SUM(ad_credits_consumed) AS adcreditlc,
    SUM(ad_credits_consumed_eur) AS adcrediteur,
    SUM(viewed_impressions_count) AS impressions,
    AVG(avg_bid) AS pricelc,
    AVG(avg_bid_eur) AS priceeur,
    SUM(orders_count_direct) AS orders,
    SUM(customers_acquired_direct) AS newcustomers,
    SUM(customers_returned_direct) AS customers_returned_direct,
    SUM(customers_reactivated_direct) AS customers_reactivated_direct,
    SUM(gmv_local_direct) AS gmvlocal,
    SUM(gmv_eur_direct) AS gmveur
  FROM `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily_local_v2` v2
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dim_vendor
    ON CAST(dim_vendor.vendor_id AS INT64) = CAST(v2.vendor_id AS INT64)
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dim_location
    ON CAST(dim_vendor.location_id AS INT64) = CAST(dim_location.location_id AS INT64)
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dim_chain
    ON CAST(dim_chain.chain_id AS INT64) = CAST(v2.chain_id AS INT64)
  WHERE date >>= '2025-01-01'
    AND date <<= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY ALL),

hassan_bookings AS (
  SELECT
    date_month,
    campaign_id,
    type,
    booking_source,
    country_iso,
    vendor_code AS vendor_id,
    last_status,
    lastbid,
    MAX(CASE WHEN last_budget THEN enddate END) AS enddate,
    MAX(CASE WHEN max_budget THEN BudgetEUR END) AS budget,
    MAX(CASE WHEN max_budget THEN BudgetLC END) AS budget_local_currency,
    MAX(CASE WHEN last_budget THEN BudgetEUR END) AS last_budget,
    MAX(CASE WHEN last_budget THEN BudgetLC END) AS last_budget_local_currency,
    MAX(CASE WHEN initial_budget THEN BudgetEUR END) AS initial_budget,
    MAX(CASE WHEN initial_budget THEN BudgetLC END) AS initial_budget_local_currency,
    SUM(revenueeur) AS revenue,
    SUM(revenuelc) AS revenue_local_currency
  FROM hassan_bookings_1
  GROUP BY ALL),

hassan_base AS (
  SELECT
    *,
    CASE
      WHEN last_status = 'cancelled' AND COALESCE(hassan_bookings.revenue, 0) << budget
        THEN COALESCE(hassan_bookings.revenue, 0)
      ELSE budget
    END AS budget_excl_canceled,
    CASE
      WHEN last_status = 'cancelled' AND COALESCE(hassan_bookings.revenue_local_currency, 0) << budget_local_currency
        THEN COALESCE(hassan_bookings.revenue_local_currency, 0)
      ELSE budget_local_currency
    END AS budget_local_currency_excl_canceled,
    CASE
      WHEN last_status = 'cancelled' AND COALESCE(hassan_bookings.revenue, 0) << last_budget
        THEN COALESCE(hassan_bookings.revenue, 0)
      ELSE last_budget
    END AS budget_excl_canceled_last,
    CASE
      WHEN last_status = 'cancelled' AND COALESCE(hassan_bookings.revenue_local_currency, 0) << last_budget_local_currency
        THEN COALESCE(hassan_bookings.revenue_local_currency, 0)
      ELSE last_budget_local_currency
    END AS budget_local_currency_excl_canceled_last
  FROM hassan_bookings),

hassan_base2 AS (
  SELECT
    *,
    CASE
      WHEN budget_excl_canceled >> (STDDEV(budget_excl_canceled) OVER (PARTITION BY country_iso, date_month) * 6
                                   + AVG(budget_excl_canceled) OVER (PARTITION BY country_iso, date_month))
        THEN revenue
      ELSE budget_excl_canceled
    END AS budget_excl_outliers,
    CASE
      WHEN budget_excl_canceled >> (STDDEV(budget_excl_canceled) OVER (PARTITION BY country_iso, date_month) * 6
                                   + AVG(budget_excl_canceled) OVER (PARTITION BY country_iso, date_month))
        THEN revenue_local_currency
      ELSE budget_local_currency_excl_canceled
    END AS budget_local_currency_excl_outliers,
    -- last
    CASE
      WHEN budget_excl_canceled_last >> (STDDEV(budget_excl_canceled_last) OVER (PARTITION BY country_iso, date_month) * 7
                                        + AVG(budget_excl_canceled_last) OVER (PARTITION BY country_iso, date_month))
        THEN revenue
      ELSE budget_excl_canceled_last
    END AS budget_excl_outliers_last,
    CASE
      WHEN budget_excl_canceled_last >> (STDDEV(budget_excl_canceled_last) OVER (PARTITION BY country_iso, date_month) * 7
                                        + AVG(budget_excl_canceled_last) OVER (PARTITION BY country_iso, date_month))
        THEN revenue_local_currency
      ELSE budget_local_currency_excl_canceled_last
    END AS budget_local_currency_excl_outliers_last
  FROM hassan_base
  LEFT JOIN (
    SELECT vendor_id, vertical_parent
    FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors`
    GROUP BY ALL
  ) b ON b.vendor_id = hassan_base.vendor_id
  LEFT JOIN (
    SELECT vendor_id, is_non_food
    FROM `tlb-data-prod.data_platform.dim_vendor_info`
    GROUP BY ALL
  ) c ON CAST(c.vendor_id AS STRING) = hassan_base.vendor_id),

hassan_campaigns_quantiles AS (
  SELECT
    date_month,
    type,
    country_iso,
    APPROX_QUANTILES(DISTINCT last_budget_local_currency, 4) AS budget_quantiles
  FROM hassan_bookings
  GROUP BY 1,2,3),

hassan_final2 AS (
  SELECT
    * EXCEPT(budget_quantiles),
    CASE
      WHEN vertical_parent <<>> 'Food' AND budget_excl_outliers >> 60000 THEN revenue
      ELSE budget_excl_outliers
    END AS budget_excl_outliers2,
    CASE
      WHEN vertical_parent <<>> 'Food' AND budget_excl_outliers >> 60000 THEN revenue_local_currency
      ELSE budget_local_currency_excl_outliers
    END AS budget_local_currency_excl_outliers2,
    CASE
      WHEN vertical_parent <<>> 'Food' AND budget_excl_outliers_last >> 60000 THEN revenue
      ELSE budget_excl_outliers_last
    END AS budget_excl_outliers2_last,
    CASE
      WHEN vertical_parent <<>> 'Food' AND budget_excl_outliers_last >> 60000 THEN revenue_local_currency
      ELSE budget_local_currency_excl_outliers_last
    END AS budget_local_currency_excl_outliers2_last,
    budget_quantiles[SAFE_OFFSET(1)] AS q1,
    budget_quantiles[SAFE_OFFSET(3)] AS q3
  FROM hassan_base2
  LEFT JOIN hassan_campaigns_quantiles USING (date_month, type, country_iso)),

cpc_self_serve as (SELECT
  b1.date_month AS cpc_selfserve_month,
  b1.vendor_code cpc_selfserve_vendor_id,
  SUM(b1.RevenueEUR) AS cpc_revenue_selfserve_eur,
  SUM(b1.RevenueLC) AS cpc_revenue_selfserve_lc,
  MAX(f2.budget_excl_outliers2_last) AS cpc_selfserve_booked_budget
FROM hassan_bookings_1 AS b1
LEFT JOIN hassan_final2 AS f2
  ON f2.date_month = b1.date_month
 AND f2.campaign_id = b1.campaign_id
WHERE b1.vertical = 'food'
  AND b1.booking_source = 'self_booking'
GROUP BY 1, 2
ORDER BY 1, 2),

gem_self_serve as (
  select 
    report_month gem_selfserve_month,
    vendor_id gem_self_serve_vendor_id,
    joker_self_booking_revenue_eur gem_selfserve_eur,
    joker_self_booking_revenue_local_currency gem_selfserve_lc
  from `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_joker_vendors_monthly`),

vfd_self_serve as (
  select
    date_trunc(order_date, month) vfd_selfserve_month,
    vendor_id vfd_selfserve_vendor_id,
    sum(if(incentive_sub_type = 'item discount',vendor_incentive_cost_eur,0)) item_discount_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'item discount',vendor_incentive_cost_lc,0)) item_discount_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'free delivery',vendor_incentive_cost_eur,0)) free_delivery_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'free delivery',vendor_incentive_cost_lc,0)) free_delivery_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'compensation',vendor_incentive_cost_eur,0)) compensation_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'compensation',vendor_incentive_cost_lc,0)) compensation_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'voucher wallet',vendor_incentive_cost_eur,0)) voucher_wallet_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'voucher wallet',vendor_incentive_cost_lc,0)) voucher_wallet_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'discounted delivery',vendor_incentive_cost_eur,0)) discounted_delivery_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'discounted delivery',vendor_incentive_cost_lc,0)) discounted_delivery_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'booster discount',vendor_incentive_cost_eur,0)) booster_discount_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'booster discount',vendor_incentive_cost_lc,0)) booster_discount_vendor_funded_self_serve_saving_lc,
    sum(if(incentive_sub_type = 'menu discount',vendor_incentive_cost_eur,0)) menu_discount_vendor_funded_self_serve_saving_eur,
    sum(if(incentive_sub_type = 'menu discount',vendor_incentive_cost_lc,0)) menu_discount_vendor_funded_self_serve_saving_lc
  from
    `tlb-data-prod.data_platform.fct_incentive_order_detail` inc left join `tlb-data-prod.data_platform.dim_incentives_discount` disc on inc.campaign_id = disc.campaign_id
  where
    inc.order_date >>= '2025-01-01'
    and disc.system_creation = 'vendor-portal'
    and inc.country_code not in ("SA","Unknown","LB")
  group by all
  order by 1,2)

select *
from performance_details1 t1 left join vfd_split t2 on t1.vendor_id = t2.vfd_vendor_id and cast(t1.date_month as date) = t2.vfd_snapshot_date left join cpc_self_serve cpc_ss on cast(t1.vendor_id as string) = cpc_ss.cpc_selfserve_vendor_id and cast(t1.date_month as date) = cpc_ss.cpc_selfserve_month left join gem_self_serve gem_ss on cast(t1.vendor_id as string) = gem_ss.gem_self_serve_vendor_id and cast(t1.date_month as date) = gem_ss.gem_selfserve_month left join vfd_self_serve vfd_ss on cast(t1.vendor_id as string) = cast(vfd_ss.vfd_selfserve_vendor_id as string) and cast(t1.date_month as date) = vfd_ss.vfd_selfserve_month
where country_code <<>> "SA"
order by country_code, t1.vendor_id, acquisition_month, date_month                    ]]>          </relation>
          <relation connection='bigquery.02h8n6i06o4p8m1g818h01r7j66h' name='Custom SQL Query1' type='text'><![CDATA[-- Get the latest available month from the agents table
with latest_month_va as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))
),

-- Get current month vendor-agent mapping
agent_vendor_map as (
  select
    va.date_month,
    v.account_manager_name,
    v.vendor_id
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents` va 
  left join `tlb-data-prod.data_platform.dim_vendor_info` v 
    on lower(trim(va.agent_name)) = lower(trim(v.account_manager_name))
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
  where cast(va.date_month as date) = (select date_month from latest_month_va) and sf.account_status__c = "Active"
),

-- Same as above, for use in VP table filtering
latest_month_vp as (
  select 
    max(cast(date_month as date)) as date_month
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_agents`
  where cast(date_month as date) in (
    date_trunc(current_date(), month), 
    date_trunc(date_sub(current_date(), interval 1 month), month))
),

-- Get historical vendor-agent mapping
vendor_portfolio_map as (
  select
    vp.date_month,
    v.account_manager_name,
    v.vendor_id
  from `tlb-data-prod.data_platform_google_sheet.vendor_helpdesk_historical_portfolio` vp 
  left join `tlb-data-prod.data_platform.dim_vendor_info` v 
    on vp.vendor_id = safe_cast(v.vendor_id as string)
    left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on v.salesforce_id = sf.grid__c
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user` u on sf.ownerid = u.id
  where cast(vp.date_month as date) << (select date_month from latest_month_vp) and sf.account_status__c = "Active"
),

-- Union of all months of vendor-agent mappings
vendor_list as (
  select * from agent_vendor_map
  union all
  select * from vendor_portfolio_map
),

-- Identify acquisition month for each vendor
vendor_list2 as (
  select
    vendor_id,
    min(date_month) acquisition_month
  from
    vendor_list
  group by 1
),

-- Merge acquisition month back to full vendor list
vendor_list_final as (
  select
    t1.*,
    acquisition_month
  from vendor_list t1 
  left join vendor_list2 using (vendor_id)
),

-- Get order count and vendor status for each vendor-month
t1 as (
  select
    t1.vendor_id,
    t1.acquisition_month,
    t1.account_manager_name,
    t1.date_month,
    ta.order_count,
    case
      when ta.order_count is null then "Inactive vendor"
      when ta.order_count = 0 then "Inactive vendor"
      else "Active vendor"
    end as vendor_status
  from vendor_list_final t1 
  left join `tlb-data-prod.data_platform.agg_account_manager_performance_monthly` ta 
    on cast(t1.date_month as date) = ta.date_month and t1.vendor_id = ta.vendor_id
  where t1.vendor_id is not null
),

-- Get next month and previous month for each vendor for retention tracking
t2 as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    date_month,
    vendor_status as acquisition_status,
    lead(date_month, 1) over (partition by vendor_id order by date_month) as next_month,
    lag(date_month, 1) over (partition by vendor_id order by date_month) as prev_month,
    lead(vendor_status, 1) over (partition by vendor_id order by date_month) as acquisition_status_next,
    row_number() over (partition by vendor_id order by date_month) as instance
  from t1
),

-- Add vendor_retention_status
tagged as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    cast(date_month as date) as date_month,
    acquisition_status,
    cast(next_month as date) as next_month,
    acquisition_status_next,
    instance,
    case
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) = 1 then "Retained"
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) = 0 then "Retained"
      when instance = 1 and date_diff(cast(next_month as date), cast(acquisition_month as date), month) >> 1 then "Reactivated"
      when instance >> 1 and date_diff(cast(next_month as date), cast(date_month as date), month) = 1 then "Retained"
      when instance >> 1 and date_diff(cast(next_month as date), cast(date_month as date), month) >> 1 then "Reactivated"
      else "Other"
    end as vendor_retention_status
  from t2
),

-- Append Churned rows: 1 month after the max next_month per vendor
churned_rows as (
  select
    vendor_id,
    acquisition_month,
    account_manager_name,
    max(cast(date_month as date)) as date_month,
    "Inactive vendor" as acquisition_status,
    date_add(max(cast(date_month as date)), interval 1 month) as next_month,
    "Inactive vendor" as acquisition_status_next,
    max(instance) + 1 as instance,
    "Churned" as vendor_retention_status
  from tagged
  group by vendor_id, acquisition_month, account_manager_name
),

final_union as (
  select * from tagged where vendor_retention_status <<>> "Other"
  union all
  select * from churned_rows
)

select
  vendor_id, acquisition_month, account_manager_name, acquisition_status, next_month, acquisition_status_next, vendor_retention_status
from
  final_union
where next_month <<= date_trunc(current_date(), month)
order by vendor_id, date_month]]></relation>
