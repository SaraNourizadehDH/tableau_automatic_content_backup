              <calculation class='tableau' formula='COUNTD(if [acquisition_status_next] = &quot;Active vendor&quot; then [vendor_id (Custom SQL Query1)] end)  /&#10;SUM( { FIXED [acquisition_month (Custom SQL Query1)] : COUNTD(if [acquisition_status] = &quot;Active vendor&quot; then [vendor_id (Custom SQL Query1)]end)} )' />
