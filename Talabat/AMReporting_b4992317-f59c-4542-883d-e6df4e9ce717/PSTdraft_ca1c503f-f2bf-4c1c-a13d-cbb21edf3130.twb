      <aliases enabled='yes' />
      <column caption='All vendors' datatype='integer' name='[Calculation_4337599802638974977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_active_vendors]+[num_inactive_vendors]' />
      </column>
      <column caption='% active vendors' datatype='real' name='[Calculation_4337599802639904770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_active_vendors])/sum([Calculation_4337599802638974977])' />
      </column>
      <column caption='% retained' datatype='real' name='[Calculation_4337599802640785411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_inv_retained_vendors])/sum([num_active_vendors])' />
      </column>
      <column caption='% reactivated' datatype='real' name='[Calculation_4337599802641666053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_inv_reactivated_vendors])/sum([num_inv_active_vendors])' />
      </column>
      <column caption='Ad rev / GMV' datatype='real' name='[Calculation_4337599802668232711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ncr_eur])/sum([gmv_eur])' />
      </column>
      <column caption='Ads vendor penetration' datatype='real' name='[Calculation_4337599802671460361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ncr_vendors])/sum([num_active_vendors])' />
      </column>
      <column caption='Vendor-funded savings / GMV' datatype='real' name='[Calculation_4337599802672676874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_funded_saving_amount_eur])/sum([gmv_eur])' />
      </column>
      <column caption='Vendor-funded savings penetration' datatype='real' name='[Calculation_4337599802673045515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_vendors])/sum([num_active_vendors])' />
      </column>
      <column caption='Self-serve NCR' datatype='real' name='[Calculation_4337599802922381324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cpc_revenue_selfserve_eur]+[gem_selfserve_eur]' />
      </column>
      <column caption='Self-serve VFD' datatype='real' name='[Calculation_4337599802926424078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[booster_discount_vendor_funded_self_serve_saving_eur]+[buy_x_get_y_vendor_funded_self_serve_saving_eur]+[compensation_vendor_funded_self_serve_saving_eur]+[discounted_delivery_vendor_funded_self_serve_saving_eur]+[dt_vendor_funded_self_serve_saving_eur]+[free_delivery_vendor_funded_self_serve_saving_eur]+[gem_vendor_funded_self_serve_saving_eur]+[item_discount_vendor_funded_self_serve_saving_eur]+[menu_discount_vendor_funded_self_serve_saving_eur]+[voucher_wallet_vendor_funded_self_serve_saving_eur]' />
      </column>
      <column caption='% self-serve NCR' datatype='real' name='[Calculation_4337599802927427599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4337599802922381324])/sum([ncr_eur])' />
      </column>
      <column caption='% self-serve VFD' datatype='real' name='[Calculation_4337599802927677456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4337599802926424078])/sum([vendor_funded_saving_amount_eur])' />
      </column>
      <column caption='Offline rate' datatype='real' name='[Calculation_4337599802933547026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([offline_duration])/sum([actual_duration])' />
      </column>
      <column caption='Vendor fail rate' datatype='real' name='[Calculation_4337599802933989395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_fail_order_count])/sum([order_count])' />
      </column>
      <column caption='Avg. prep time' datatype='real' name='[Calculation_4337599802934161428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([prep_time])/sum([order_count])' />
      </column>
      <column caption='DLP' datatype='real' name='[Calculation_4337599802935066645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_images_count])/sum([active_menu_items_count])' />
      </column>
      <column caption='DLD' datatype='real' name='[Calculation_4337599802935132182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_description_count])/sum([active_menu_items_count])' />
      </column>
      <column caption='Add-to-cart rate' datatype='real' name='[Calculation_4337599802935189527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([added_to_cart_session_count])/sum([viewed_menu_session_count])' />
      </column>
      <column caption='Started checkout rate' datatype='real' name='[Calculation_4337599802935287832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([started_checkout_sessions_count])/sum([added_to_cart_session_count])' />
      </column>
      <column caption='Placed order rate' datatype='real' name='[Calculation_4337599802935390233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([placed_order_session_count])/sum([started_checkout_sessions_count])' />
      </column>
      <column caption='Selected comparison metric' datatype='real' name='[Calculation_6413266650290372608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [Selected comparison metric]&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &quot;All vendors&quot; THEN SUM([Calculation_4337599802638974977])&#10;WHEN &quot;Active vendors&quot;          THEN SUM([num_active_vendors])&#10;WHEN &quot;GMV&quot;                     THEN SUM([gmv_eur])&#10;WHEN &quot;Orders&quot;                  THEN SUM([order_count])&#10;WHEN &quot;% active vendors&quot;        THEN &#10;    ROUND((SUM([num_active_vendors]) / NULLIF(SUM([Calculation_4337599802638974977]), 0))*100,0)&#10;WHEN &quot;Vendor-funded savings&quot;   THEN SUM([vendor_funded_saving_amount_eur])&#10;WHEN &quot;Ad revenue&quot;              THEN SUM([ncr_eur])&#10;WHEN &quot;Retained vendors&quot; THEN SUM([num_inv_retained_vendors])&#10;WHEN &quot;% retained&quot; THEN ROUND((SUM([num_inv_retained_vendors])/SUM([num_active_vendors]))*100,0)&#10;WHEN &quot;Reactivated vendors&quot; THEN SUM([num_inv_reactivated_vendors])&#10;WHEN &quot;% reactivated&quot; THEN ROUND((SUM([num_inv_reactivated_vendors])/SUM([num_active_vendors]))*100,0)&#10;WHEN &quot;Ad revenue&quot; THEN SUM([ncr_eur])&#10;WHEN &quot;Ad rev / GMV&quot; THEN ROUND((SUM([ncr_eur])/SUM([gmv_eur]))*100,0)&#10;WHEN &quot;Ads vendors&quot; THEN SUM([ncr_vendors])&#10;WHEN &quot;Ads vendor penetration&quot; THEN ROUND((SUM([ncr_vendors])/SUM([num_active_vendors]))*100,0)&#10;WHEN &quot;Vendor-funded savings&quot; THEN SUM([vendor_funded_saving_amount_eur])&#10;WHEN &quot;Vendor-funded savings / GMV&quot; THEN ROUND((SUM([vendor_funded_saving_amount_eur])/SUM([gmv_eur]))*100,0)&#10;WHEN &quot;Vendor-funded vendors&quot; THEN SUM([vfd_vendors])&#10;WHEN &quot;Vendor-funded savings penetration&quot; THEN ROUND((SUM([vfd_vendors])/SUM([num_active_vendors]))*100,0)&#10;WHEN &quot;Self-serve NCR&quot; THEN SUM([Calculation_4337599802922381324])&#10;WHEN &quot;% self-serve NCR&quot; THEN ROUND((SUM([Calculation_4337599802922381324])/SUM([ncr_eur]))*100,0)&#10;WHEN &quot;Self-serve VFD&quot; THEN SUM([Calculation_4337599802926424078])&#10;WHEN &quot;% self-serve VFD&quot; THEN ROUND((SUM([Calculation_4337599802926424078])/SUM([vendor_funded_saving_amount_eur]))*100,0)&#10;WHEN &quot;Offline rate&quot; THEN ROUND((SUM([offline_duration])/SUM([actual_duration]))*100,0)&#10;WHEN &quot;Vendor fail rate&quot; THEN ROUND((SUM([vendor_fail_order_count])/SUM([order_count]))*100,0)&#10;WHEN &quot;Avg. prep time&quot; THEN SUM([prep_time])/SUM([order_count])&#10;WHEN &quot;DLP&quot; THEN ROUND((SUM([items_with_images_count])/SUM([active_menu_items_count]))*100,0)&#10;WHEN &quot;DLD&quot; THEN ROUND((SUM([items_with_description_count])/SUM([active_menu_items_count]))*100,0)&#10;WHEN &quot;Viewed menu sessions&quot; THEN SUM([viewed_menu_session_count])&#10;WHEN &quot;Add-to-cart rate&quot; THEN ROUND((SUM([added_to_cart_session_count])/SUM([viewed_menu_session_count]))*100,0)&#10;WHEN &quot;Started checkout rate&quot; THEN ROUND((SUM([started_checkout_sessions_count])/SUM([added_to_cart_session_count]))*100,0)&#10;WHEN &quot;Placed order rate&quot; THEN ROUND((SUM([placed_order_session_count])/SUM([started_checkout_sessions_count]))*100,0)&#10;END' />
      </column>
      <column caption='Selected metric growth' datatype='real' name='[Calculation_6413266650311434241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [Selected comparison metric MoM %]&#10;IF ISNULL(LOOKUP([Calculation_6413266650290372608], -1))&#10; OR LOOKUP([Calculation_6413266650290372608], -1) = 0&#10;THEN&#10;    NULL&#10;ELSE&#10;    ( [Calculation_6413266650290372608] / LOOKUP([Calculation_6413266650290372608], -1) - 1 )&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
