            <column caption='Calculation1' datatype='boolean' name='[Calculation_1501387570933252109]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1501387570930864138] = 0 OR ISNULL([Calculation_1501387570930864138])' />
            </column>
            <column caption='NCR/fGMV' datatype='real' name='[Calculation_1501387570935316496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1501387570926391297])/SUM([GMVEUR])' />
