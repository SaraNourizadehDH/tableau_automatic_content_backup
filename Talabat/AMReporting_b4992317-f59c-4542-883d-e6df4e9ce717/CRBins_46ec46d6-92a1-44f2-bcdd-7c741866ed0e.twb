      <column caption='CR Bins' datatype='string' name='[Calculation_1501387570929594376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1501387570930864138] &lt; 0.10 THEN &quot;&lt;10%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.15 THEN &quot;10-15%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.20 THEN &quot;15-20%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.25 THEN &quot;20-25%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.30 THEN &quot;25-30%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.35 THEN &quot;30-35%&quot;&#13;&#10;ELSE &quot;&gt;35%&quot;&#13;&#10;END' />
