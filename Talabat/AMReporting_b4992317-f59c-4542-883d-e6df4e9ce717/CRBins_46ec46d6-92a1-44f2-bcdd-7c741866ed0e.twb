        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0eebi4u01yr0zc1cuiomw1n8z3ql' name='Custom SQL Query' type='text'><![CDATA[with
ft as
(
select
snapshot_month as date_month,
vws.country_code,
vws.vendor_id,
vendor_name,
vws.chain_id,
vws.chain_name,
is_tgo,
is_exclusive,
vi.account_manager_name,
vi.team_leader_name,
chain_segment as chain_tier,
dim_chain.vertical,dim_chain.is_regional_key_account,
successful_order_count as successful_orders,
gmv_amount_lc as successful_gmv_lc,
safe_divide(sum(gmv_amount_lc),sum(successful_order_count)) as AOV,
safe_divide(sum(basket_amount_lc),sum(successful_order_count)) as ABV,
commissionable_gmv_amount_lc,
gmv_amount_lc,
commissionable_gmv_amount_eur,
gmv_amount_eur,
basket_amount_lc as successful_gfv_lc,
basket_amount_eur as successful_gfv_eur,
commission_amount_lc as  commission_amount_lc,
commission_amount_eur as  commission_amount_eur,
tgo_amount_lc as tgo_amount_lc,
tgo_amount_eur as tgo_amount_eur,
card_fee_lc as card_fee_lc,
cash_fee_lc as cash_fee_lc,
cash_fee_eur as cash_fee_eur,
card_fee_eur as card_fee_eur,
tpro_discount_amount_lc as tpro_savings_lc,
tpro_discount_amount_eur as tpro_savings_eur,
discount_amount_lc as discount_gmv_lc,
discount_amount_eur as discount_gmv_eur,
targeted_deal_discount_amount_lc as targeted_deal_discounts_lc,
gem_discount_amount_lc as gem_discounts_lc,
gem_commission_amount_lc as gem_commission_amount_lc,
gem_commission_amount_eur as gem_commission_amount_eur,
cpp_monthly_revenue_lc as cpp_monthly_revenue_lc_total,
cpp_monthly_revenue_eur as cpp_monthly_revenue_eur_total,
featured_product_revenue_lc  as fp_revenue_lc,
featured_product_revenue_eur as fp_revenue_eur,
kwords_search_revenue_lc as kw_revenue_lc,
kwords_search_revenue_eur as kw_revenue_eur,
organic_placement_revenue_lc as pp_revenue_lc,
organic_placement_revenue_eur as pp_revenue_eur,

deal_targeting_revenue_lc as deal_target_ncr_lc,
deal_targeting_revenue_eur as deal_target_ncr_eur,
display_ads_revenue_lc as display_ads_revenue_lc_excl,
display_ads_revenue_eur as display_ads_revenue_eur_excl,
vendor_reward_cost_lc as rewards_cost_lc,
vendor_reward_cost_eur as rewards_cost_eur,
tpro_delivery_fees_lc ,
vendor_tpro_cost_lc as pro_cost_for_vendor_lc,
from tlb-data-prod.data_platform.agg_vendor_wallet_share_monthly vws
join tlb-data-prod.data_platform.dim_vendor_info vi on vws.vendor_id = vi.vendor_id
JOIN tlb-data-prod.data_platform.dim_chain AS dim_chain ON vws.chain_id = dim_chain.chain_id
JOIN tlb-data-prod.data_platform.dim_location_info AS dim_location ON vi.location_id = dim_location.location_id
where
snapshot_month >>= '2025-05-01'
group by all)

, t2 AS (
select
DISTINCT
  ft.date_month,
  ft.country_code,
  ft.chain_id,
  ft.chain_name,
  is_regional_key_account,
  chain_tier,
safe_divide ((SUM(
IFNULL(commission_amount_lc,0) +
IFNULL(tgo_amount_lc,0) +
IFNULL(fp_revenue_lc,0) +
IFNULL(kw_revenue_lc,0) +
IFNULL(cpp_monthly_revenue_lc_total,0) +
IFNULL(deal_target_ncr_lc,0) +
IFNULL(discount_gmv_lc,0) +
IFNULL(gem_commission_amount_lc,0) +
IFNULL(pp_revenue_lc,0) +
IFNULL(cash_fee_lc,0) +
IFNULL(card_fee_lc,0) +
IFNULL(tpro_savings_lc,0)+
IFNULL(display_ads_revenue_lc_excl,0)+
IFNULL(rewards_cost_lc,0))
),
SUm(successful_gfv_lc)) as wallet_share, SUM(successful_gfv_lc) GFVLC, SUm(successful_gfv_eur) GFVEUR,
SUM(IFNULL(commission_amount_lc,0) + IFNULL(tgo_amount_lc,0) ) CommissionLC , 
SUM(IFNULL(commission_amount_eur,0) + IFNULL(tgo_amount_eur,0) ) CommissionEUR , 
SUM(commissionable_gmv_amount_lc) CGMVLC, 
SUM(commissionable_gmv_amount_eur) CGMVEUR, 
SUM(ft.gmv_amount_lc) GMVLC,
SUM(ft.gmv_amount_eur) GMVEUR,
SUM(
IFNULL(commission_amount_lc,0) +
IFNULL(tgo_amount_lc,0) +
IFNULL(fp_revenue_lc,0) +
IFNULL(kw_revenue_lc,0) +
IFNULL(cpp_monthly_revenue_lc_total,0) +
IFNULL(deal_target_ncr_lc,0) +
IFNULL(discount_gmv_lc,0) +
IFNULL(gem_commission_amount_lc,0) +
IFNULL(pp_revenue_lc,0) +
IFNULL(cash_fee_lc,0) +
IFNULL(card_fee_lc,0) +
IFNULL(tpro_savings_lc,0)+
IFNULL(display_ads_revenue_lc_excl,0)+
IFNULL(rewards_cost_lc,0)) wsnumlc,

SUM(
IFNULL(commission_amount_eur,0) +
IFNULL(tgo_amount_eur,0) +
IFNULL(fp_revenue_eur,0) +
IFNULL(kw_revenue_eur,0) +
IFNULL(cpp_monthly_revenue_eur_total,0) +
IFNULL(deal_target_ncr_eur,0) +
IFNULL(discount_gmv_eur,0) +
IFNULL(gem_commission_amount_eur,0) +
IFNULL(pp_revenue_eur,0) +
IFNULL(cash_fee_eur,0) +
IFNULL(card_fee_eur,0) +
IFNULL(tpro_savings_eur,0)+
IFNULL(display_ads_revenue_eur_excl,0)+
IFNULL(rewards_cost_eur,0)) wsnumeur

  from ft
  where ft.date_month >>=  '2025-05-01' and ft.date_month <<='2025-07-01'
  and vertical = 'food'
  group by all
  ORDER by chain_id)

,t3 AS (SELECT
DATE_TRUNC(report_date, MONTH) AS month,
CASE 
WHEN financial_country_code IN ('IQ-BG', 'IQ-KD') THEN 'IQ' ELSE financial_country_code END AS financial_country_code,
backend_chain_id,
a.vertical,
SUM(accounting_currency_amount) AS amountlc,

FROM `tlb-data-prod.data_platform.agg_daily_ledger_transactions` t
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` a ON t.backend_chain_id = a.chain_id
LEFT JOIN `tlb-data-prod.data_platform.agg_chain_tiers` b ON t.backend_chain_id = b.chain_id
WHERE date IN (
SELECT MAX(date)
FROM `tlb-data-prod.data_platform.agg_chain_tiers`
)
AND DATE_TRUNC(report_date, MONTH) >>= '2025-05-01' and DATE_TRUNC(report_date, MONTH) <<= '2025-07-01'
AND SAFE_CAST(ledger_account_number AS INT) IN (
750101001, 750101009, 750101002, 750101003, 750101010,730101211, 750101004, 750101005, 750101008, 750101028, 750101007, 750101033, 750101011, 750101012, 750101026, 750101032, 750105004, 750105001, 750105007, 750105011, 750105014, 750105017, 750105005, 750105018, 750104001,750104004, 750104007, 750104011, 750104002, 750104012, 750106022, 750106034, 750106023, 750106027, 750106042, 750106004, 750106009, 750106001, 750101015, 750101014, 750103011, 750103001, 750103004, 750103007, 750101017,750101018)
GROUP BY ALL)

SELECT * FROM t2

LEFT JOIN t3 
on t2.chain_id = t3.backend_chain_id 
and t2.date_month = t3.month]]></relation>
