  <worksheets>
    <worksheet name='Chain Level'>
      <repository-location id='ChainLevel' path='/t/Talabat/workbooks/CRBins' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.1o3dwhq1hv6rhv14hzrib033coqv' />
          </datasources>
          <datasource-dependencies datasource='federated.1o3dwhq1hv6rhv14hzrib033coqv'>
            <column datatype='real' name='[Amnt]' role='measure' type='quantitative' />
            <column datatype='real' name='[CGMVEUR]' role='measure' type='quantitative' />
            <column caption='NCR LC' datatype='real' name='[Calculation_1501387570926333952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amountlc]*-1' />
            </column>
            <column caption='NCR EUR' datatype='real' name='[Calculation_1501387570926391297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1501387570926333952] * [Amnt]' />
            </column>
            <column caption='CR %' datatype='real' name='[Calculation_1501387570926632963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CommissionEUR])/SUM([CGMVEUR])' />
            </column>
            <column caption='CR Bins' datatype='string' name='[Calculation_1501387570929594376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1501387570930864138] &lt; 0.10 THEN &quot;&lt;10%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.15 THEN &quot;10-15%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.20 THEN &quot;15-20%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.25 THEN &quot;20-25%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.30 THEN &quot;25-30%&quot;&#13;&#10;ELSEIF [Calculation_1501387570930864138] &lt; 0.35 THEN &quot;30-35%&quot;&#13;&#10;ELSE &quot;&gt;35%&quot;&#13;&#10;END' />
            </column>
            <column caption='Test' datatype='real' name='[Calculation_1501387570930864138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF { FIXED [chain_id] : SUM([CGMVEUR]) } = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    { FIXED [chain_id] : SUM([CommissionEUR]) } &#13;&#10;    / { FIXED [chain_id] : SUM([CGMVEUR]) }&#13;&#10;END' />
            </column>
            <column caption='Count of Chainds' datatype='integer' name='[Calculation_1501387570931810315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_id])' />
            </column>
            <column caption='Calculation1' datatype='boolean' name='[Calculation_1501387570933252109]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1501387570930864138] = 0 OR ISNULL([Calculation_1501387570930864138])' />
            </column>
            <column caption='NCR/fGMV' datatype='real' name='[Calculation_1501387570935316496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1501387570926391297])/SUM([GMVEUR])' />
            </column>
            <column caption='Wallet Share %' datatype='real' name='[Calculation_1501387570937581585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([wsnumeur])/SUM([GFVEUR])' />
            </column>
            <column datatype='real' name='[CommissionEUR]' role='measure' type='quantitative' />
            <column datatype='real' name='[GFVEUR]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMVEUR]' role='measure' type='quantitative' />
            <column caption='NCRLC' datatype='real' name='[amountlc]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_tier]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1501387570929594376]' derivation='None' name='[none:Calculation_1501387570929594376:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1501387570933252109]' derivation='None' name='[none:Calculation_1501387570933252109:nk]' pivot='key' type='nominal' />
