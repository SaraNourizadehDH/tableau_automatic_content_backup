    <worksheet name='Orders by Chain Tiers'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f4ede3' fontname='Tableau Semibold'><![CDATA[<[Parameters].[Main Metric (copy)_1382886609336422439]> By Chain Tiers]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#411517' fontname='Tableau Semibold' fontsize='10'>-</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_level_mfo_reporting' name='federated.0fjvcqu1it4u411auaji1158n93g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Chain Tier Metric' datatype='string' name='[Main Metric (copy)_1382886609336422439]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='MFO - AAA Chains' datatype='integer' name='[AAA Vendors (copy)_1382886609329889290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;,[order_date]),[country_code] : COUNTD(IF [tiers] = &quot;AAA&quot; THEN [chain_id] END)}' />
            </column>
            <column caption='Tier A Active Chains' datatype='integer' name='[Calculation_1382886609297289218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;,[order_date]),[country_code] : MAX([tier_a_active_chains])}' />
            </column>
            <column caption='MFO - Chain Penetration' datatype='real' default-format='p0.00%' name='[Calculation_1382886609332523037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([tiers])&#10;WHEN &quot;AAA&quot; THEN SUM([AAA Vendors (copy)_1382886609329889290])/SUM([Tier A Active Chains (copy) (copy) (copy) (copy)_1382886609297473542])&#10;WHEN &quot;Tier A&quot; THEN SUM([MFO - AAA Chains (copy)_1382886609331408910])/SUM([Calculation_1382886609297289218])&#10;WHEN &quot;Tier B&quot; THEN SUM([MFO - AAA Chains (copy) (copy)_1382886609331417103])/SUM([Tier A Active Chains (copy)_1382886609297436675])&#10;WHEN &quot;Tier C&quot; THEN SUM([MFO - AAA Chains (copy) (copy) (copy)_1382886609331425297])/SUM([Tier A Active Chains (copy) (copy)_1382886609297440772])&#10;WHEN &quot;Tier D&quot; THEN SUM([MFO - AAA Chains (copy) (copy) (copy) (copy)_1382886609331433491])/SUM([Tier A Active Chains (copy) (copy) (copy)_1382886609297448965])&#10;WHEN &quot;Tier E&quot; THEN SUM([MFO - AAA Chains (copy) (copy) (copy) (copy) (copy)_1382886609331441685])/SUM([Tier A Active Chains (copy) (copy) (copy) (copy) (copy)_1382886609297481735])&#10;END' />
            </column>
            <column caption='GMV (EUR)' datatype='real' name='[Calculation_3317253013766184968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
