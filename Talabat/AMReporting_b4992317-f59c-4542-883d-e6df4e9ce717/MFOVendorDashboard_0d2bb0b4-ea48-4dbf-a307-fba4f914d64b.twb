          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='vDelay V2 10M %' datatype='real' default-format='p0.00%' name='[Calculation_3317253013751676930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_3317253013766152199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_lc])' />
            </column>
            <column caption='GMV (EUR)' datatype='real' name='[Calculation_3317253013766184968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='vNet Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_3317253013766475785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3317253013766639626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Max Date' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767426061]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([order_date])}' />
            </column>
            <column caption='Max Month' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767507982]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[order_date])))}' />
            </column>
            <column caption='Is Date Range' datatype='boolean' name='[Calculation_3317253013774368785]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='vContact Rate' datatype='real' default-format='p0.00%' name='[Calculation_3317253013775355924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
