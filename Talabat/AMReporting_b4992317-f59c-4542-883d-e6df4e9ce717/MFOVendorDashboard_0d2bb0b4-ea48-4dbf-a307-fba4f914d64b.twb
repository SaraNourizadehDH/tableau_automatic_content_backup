    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Item Performance'>
      <repository-location id='ItemPerformance' path='/t/Talabat/workbooks/MFOVendorDashboard' revision='' site='Talabat' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='color' value='#f4ede3' />
