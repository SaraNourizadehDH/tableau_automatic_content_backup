      <table>
        <view>
          <datasources>
            <datasource caption='vendor_level_mfo_reporting' name='federated.0fjvcqu1it4u411auaji1158n93g' />
          </datasources>
          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='Country Orders Penetration (%)' datatype='real' default-format='p0.00%' name='[Calculation_3201355693309808641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766639626]/SUM([Calculation_3317253014892470336])' />
            </column>
            <column caption='GMV (EUR)' datatype='real' name='[Calculation_3317253013766184968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3317253013766639626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='AOV (EUR)' datatype='real' name='[Calculation_3317253013805768730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766184968]/[Calculation_3317253013766639626]' />
            </column>
            <column caption='Platform Acquisitions' datatype='integer' name='[Calculation_3317253013821341731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acquisition])' />
            </column>
            <column caption='Country Orders' datatype='integer' name='[Calculation_3317253014892470336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_date],[country_code]:MAX([benchmark_successful_orders])}' />
            </column>
            <column caption='Country GMV (EUR)' datatype='real' name='[Country Orders (copy)_3201355693314793475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_date],[country_code]:MAX([benchmark_gmv_eur])}' />
            </column>
            <column caption='Country GMV Penetration (%)' datatype='real' default-format='p0.00%' name='[Country Orders Penetration (copy)_3201355693314605058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766184968]/SUM([Country Orders (copy)_3201355693314793475])' />
            </column>
