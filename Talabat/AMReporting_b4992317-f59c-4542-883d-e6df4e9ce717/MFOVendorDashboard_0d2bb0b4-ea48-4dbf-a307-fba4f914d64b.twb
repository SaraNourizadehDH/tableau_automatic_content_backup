            </column>
            <column caption='Dim for Rank (Calc)' datatype='string' name='[Calculation_3317253013819781153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;Chain Name&quot; THEN [chain_name]&#10;WHEN &quot;TL Name&quot; THEN [team_leader_name]&#10;WHEN &quot;AM Name&quot; THEN [account_manager_name]&#10;WHEN &quot;Chain Tier&quot; THEN [tiers]&#10;END' />
            </column>
            <column caption='Metric for Rank' datatype='real' name='[Calculation_3317253013820121122]' role='measure' type='quantitative'>
