            </column>
            <column caption='Platform Acquisitions' datatype='integer' name='[Calculation_3317253013821341731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acquisition])' />
            </column>
            <column caption='Top or Bottom Filter' datatype='string' name='[Calculation_3317253014137344057]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_3317253013819322399]&lt;=[Parameters].[Parameter 5] THEN &quot;Top N&quot;  ELSE IF [Calculation_3317253013819322399]&gt;=SIZE()-[Parameters].[Parameter 5]&#10;&#10;THEN  &quot;Bottom N&quot;  else &quot;Others&quot; end end'>
                <table-calc ordering-type='Rows' />
