      <table>
        <view>
          <datasources>
            <datasource caption='MFO Item Level Performance' name='federated.1ywtcto0sz641x1bi356g1m8nj2q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ywtcto0sz641x1bi356g1m8nj2q].[Calculation_1774347935352967174]' caption='End Date (IL)' datatype='date' name='[Parameter 11]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-05#'>
              <calculation class='tableau' formula='#2025-03-05#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ywtcto0sz641x1bi356g1m8nj2q].[Calculation_1774347935353085959]' caption='Start Date (IL)' datatype='date' name='[Parameter 12]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ywtcto0sz641x1bi356g1m8nj2q'>
            <column caption='Quantity Sold' datatype='integer' name='[Calculation_1774347935341760512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sold_quantity])' />
            </column>
            <column caption='Discount Amount (LC)' datatype='real' name='[Calculation_1774347935342252033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([item_discount_lc],0)) *[Calculation_1774347935341760512]' />
            </column>
            <column caption='Sale Amount (LC)' datatype='real' name='[Calculation_1774347935343562755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_item_price_lc]*[sold_quantity])' />
            </column>
            <column caption='No. Of Items' datatype='integer' name='[Calculation_1774347935347290116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([item_id])' />
            </column>
            <column caption='No. Of Chains' datatype='integer' name='[Calculation_1774347935347535877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_id])' />
            </column>
            <column caption='Max Date (IL)' datatype='date' name='[Calculation_1774347935352967174]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
            </column>
            <column caption='Max Month (IL)' datatype='date' name='[Calculation_1774347935353085959]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[date])))}' />
            </column>
            <column caption='Is in Date Range (IL)' datatype='boolean' name='[Calculation_1774347935353479176]' role='dimension' type='nominal'>
