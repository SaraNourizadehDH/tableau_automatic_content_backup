              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='CPC Spend (EUR)' datatype='real' name='[CPC Spend (LC) (copy)_4441886284619235333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_eur])' />
            </column>
            <column caption='Country Orders Penetration (%)' datatype='real' default-format='p0.00%' name='[Calculation_3201355693309808641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766639626]/SUM([Calculation_3317253014892470336])' />
            </column>
            <column caption='Incentive Amount (LC)' datatype='real' name='[Calculation_3201355693320491013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_amount_lc])' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013751480320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_comp_orders_numerator])&#10;/&#10;SUM([actual_delivery_time_comp_orders_denominator])' />
            </column>
            <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013751607297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_rating_numerator])/&#10;SUM([order_rating_denominator])' />
            </column>
            <column caption='vDelay V2 10M %' datatype='real' default-format='p0.00%' name='[Calculation_3317253013751676930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
            </column>
            <column caption='Vendor Order Penetration (%)' datatype='real' default-format='p0.00%' name='[Calculation_3317253013765758980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/SUM([all_successful_order])' />
            </column>
            <column caption='Vendor GMV Penetration (%)' datatype='real' default-format='p0.00%' name='[Calculation_3317253013765844997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_lc])/SUM([all_gmv_amount_lc])' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_3317253013766152199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_lc])' />
            </column>
            <column caption='GMV (EUR)' datatype='real' name='[Calculation_3317253013766184968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3317253013766639626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Max Date' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767426061]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([order_date])}' />
            </column>
            <column caption='Max Month' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767507982]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[order_date])))}' />
            </column>
            <column caption='vContact Rate' datatype='real' default-format='p0.00%' name='[Calculation_3317253013775355924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
            </column>
            <column caption='Order Late' datatype='real' default-format='p0.00%' name='[Calculation_3317253013793222677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10min_numerator])/SUM([order_late_10min_denominator])' />
            </column>
            <column caption='Stacking %' datatype='real' default-format='p0.00%' name='[Calculation_3317253013793419286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([log_completed_orders])' />
            </column>
            <column caption='Est. Prep Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013798498328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time_sum])/SUM([estimated_prep_time_count])' />
            </column>
            <column caption='AOV (LC)' datatype='real' name='[Calculation_3317253013805703193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766152199]/[Calculation_3317253013766639626]' />
            </column>
            <column caption='AOV (EUR)' datatype='real' name='[Calculation_3317253013805768730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3317253013766184968]/[Calculation_3317253013766639626]' />
            </column>
            <column caption='Platform Acquisitions' datatype='integer' name='[Calculation_3317253013821341731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acquisition])' />
            </column>
            <column caption='Country Orders' datatype='integer' name='[Calculation_3317253014892470336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_date],[country_code]:MAX([benchmark_successful_orders])}' />
            </column>
            <column caption='CPC Spend (LC)' datatype='real' name='[Calculation_4441886284619161603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_lc])' />
            </column>
