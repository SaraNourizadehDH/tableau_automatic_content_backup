        <zone h='3450' id='7' name='Quadrants' pane-specification-id='0' param='[federated.1ywtcto0sz641x1bi356g1m8nj2q].[usr:Calculation_1774347935347535877:qk]' type-v2='size' w='8867' x='88333' y='11600' />
