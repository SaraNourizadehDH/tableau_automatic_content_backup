            <column-instance column='[tiers]' derivation='None' name='[none:tiers:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Order Item Price (LC)' datatype='real' name='[order_item_price_lc]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6512768062031093766]' derivation='User' name='[pcto:usr:Calculation_6512768062031093766:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Chain Tier' datatype='string' name='[tiers]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1774347935347290116]' derivation='User' name='[usr:Calculation_1774347935347290116:qk]' pivot='key' type='quantitative' />
