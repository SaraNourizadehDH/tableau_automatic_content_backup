            <column caption='Metric for Rank' datatype='real' name='[Calculation_3317253013820121122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Orders&quot; THEN [Calculation_3317253013766639626]&#10;WHEN &quot;GMV (LC)&quot; THEN [Calculation_3317253013766152199]&#10;WHEN &quot;GMV (EUR)&quot; THEN [Calculation_3317253013766184968]&#10;WHEN &quot;Platform Acquisitions&quot; THEN [Calculation_3317253013821341731]&#10;WHEN &quot;Vendor Acquisitions&quot; THEN [Platform Acquisitions (copy)_3317253013821403172]&#10;WHEN &quot;vNFR&quot; THEN [Calculation_3317253013766475785]*100&#10;WHEN &quot;vContact Rate&quot; THEN [Calculation_3317253013775355924]*100&#10;WHEN &quot;vDelay v2 10M%&quot; THEN [Calculation_3317253013751676930]*100&#10;WHEN &quot;vContact Orders&quot; THEN [Calculation_4441886284618174464]&#10;WHEN &quot;vNet Fail Orders&quot; THEN [Calculation_4441886284618579970]&#10;WHEN &quot;vDelay V2 10M Orders&quot; THEN [Calculation_4441886284618395649]&#10;END' />
            </column>
            <column caption='Platform Acquisitions' datatype='integer' name='[Calculation_3317253013821341731]' role='measure' type='quantitative'>
