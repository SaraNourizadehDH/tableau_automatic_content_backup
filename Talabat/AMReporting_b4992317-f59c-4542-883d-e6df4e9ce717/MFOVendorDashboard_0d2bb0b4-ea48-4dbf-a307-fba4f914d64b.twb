    </datasource>
    <datasource caption='vendor_level_mfo_reporting' inline='true' name='federated.0fjvcqu1it4u411auaji1158n93g' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.081orr90o2x7sk1fqg6rq1nbuio3'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.081orr90o2x7sk1fqg6rq1nbuio3' name='Custom SQL Query' type='text'><![CDATA[WITH 
      orders_base AS
    (
    SELECT
      o.order_date,
      o.order_id,
      ---- Dim ----
      v.vendor_id,
      dc.chain_id,
      dc.country_code,
      dc.vertical,
      --- Order Falgs ---
      o.is_abandoned,
      os.is_net,
      o.is_test,
      o.is_successful,
      o.is_meal_for_one_order,
      ---- Monetary ---
      o.gmv_amount_lc,
      o.gmv_amount_eur,
      o.basket_amount_lc,
      o.basket_amount_eur,
      o.incentive_amount_lc as ot_incentive_amount_lc,
      o.incentive_amount_eur as ot_incentive_amount_eur,
      -- i.incentive_amount_lc,
      -- i.incentive_amount_eur,
      o.delivery_fee_amount_lc,
      o.delivery_fee_amount_eur,
      o.service_fee_amount_lc,
      o.service_fee_amount_eur,
      ---- Order Ranks --- 
      o.analytical_customer_id,
      rank.customer_vendor_order_index,
      rank.customer_order_index,
      ---- Rating ------
      rating.original_rating,
      ---- Contact ---- 
      c.contact_id,
      c.stakeholder_id,
      --- Logistics ----
      ofr.owner,
      o.is_tgo,
      o_log.order_id as o_log_order_id,
      o_log.actual_delivery_time,
      o_log.vendor_delay_v2,
      o_log.primary_stacked_count,
      estimated_prep_time,
      o_log.is_logistics_preorder,
      o_log.order_status,
      o_log.order_delay,
      o_log.order_code
    FROM `tlb-data-prod.data_platform.fct_order_info` o
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` o_log on o_log.order_id = o.order_id and o_log.is_talabat
    INNER JOIN `tlb-data-prod.data_platform.dim_order_status` os on os.order_status_id = o.order_status_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` ofr on ofr.order_fail_reason_id = o.order_fail_reason_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_rating` rating on rating.order_id = o.order_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` rank on rank.order_id = o.order_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc on dc.chain_id = o.chain_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_contact` c on c.order_id = CAST(o.order_id AS STRING)
    WHERE DATE(o.order_date) >>= "2025-02-01"
    AND dc.country_code IN ("AE","KW")
    ),

    mfo_orders AS 
    (
    SELECT 
    DISTINCT order_id,vendor_id
    FROM orders_base
    WHERE is_meal_for_one_order
    ),

  pre_transmission as   
  (
    SELECT 
    vendor_id,
    dt.transmission_category  AS transmission_category,
    row_number() over (partition by vendor_id order by end_date desc ) as rno
    FROM `tlb-data-prod.data_platform.rltnp_vendor_x_transmission`  vt 
    LEFT JOIN `tlb-data-prod.data_platform.dim_transmission` dt ON vt.transmission_id = dt.transmission_id
    WHERE 1=1
    ),

  transmission AS (
    SELECT vendor_id,transmission_category FROM pre_transmission
    WHERE rno = 1
    ),

  incentive_base AS
    (
      SELECT
order_date,
      dc.country_code,
      orders.vendor_id,
      vv.vendor_name,
      vv.account_manager_name,
          CASE 
          WHEN orders.incentive_sub_type ='voucher wallet' AND orders.platform_cost_share = 0 AND incentive_type_detail = 'LOYALTY' THEN 'tRewards' 
        WHEN orders.incentive_sub_type ='voucher wallet' AND orders.platform_cost_share = 0 AND incentive_type_detail <<>> 'LOYALTY'
        THEN 'voucher'
        ELSE orders.incentive_sub_type END
      AS incentive_sub_type_new,
      CAST(is_monetized_campaign AS string) AS is_targeted_campaign,
      vv.chain_id,
      dc.chain_name,
      CASE
        WHEN orders.platform_cost_share >> 0 THEN 'talabat funded'
        ELSE 'vendor funded'
      END
      AS funded_by,
      orders.order_id,
      orders.incentive_amount_lc,
      orders.incentive_amount_eur,
      orders.gmv_amount_lc,
      orders.gmv_amount_eur,
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders
    LEFT JOIN`tlb-data-prod.data_platform.dim_incentives_discount` c ON orders.incentive_campaign_id = c.incentive_campaign_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_voucher` d ON orders.incentive_campaign_id = d.incentive_campaign_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info`  vv ON orders.vendor_id = vv.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc ON vv.chain_id = dc.chain_id
    WHERE
       orders.order_date >>= "2025-02-01"
      AND is_successful
      AND dc.country_code IN ('AE',"KW")
      AND orders.order_id IN (SELECT DISTINCT order_id FROM mfo_orders)
      AND orders.incentive_sub_type NOT IN ('compensation')
      AND  orders.incentive_sub_type IN ('menu discount','item discount','free delivery','gem','discounted delivery','buy x get y','booster discount','voucher wallet')
    ),

    inct_final
      AS
      (
        SELECT 
        order_date as incent_order_date,
        order_id as incent_order_id,
        SUM(incentive_amount_lc) as incentive_amount_lc,
        SUM(incentive_amount_eur) as incentive_amount_eur,
        FROM incentive_base
        WHERE incentive_sub_type_new NOT IN ('voucher wallet')
        GROUP BY 1,2
      ),


benchmark_details AS
  ( Select
    order_date,
    country_code,
    --- Order Info ---- 
    COUNT(DISTINCT CASE WHEN is_successful then order_id END) as benchmark_successful_orders,
    COUNT(DISTINCT CASE WHEN is_net then order_id END) as benchmark_net_orders,
    COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful) AND owner = 'VENDOR' then order_id END) as benchmark_vendor_net_fail_orders,
    COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful)  then order_id END) as benchmark_net_fail_orders,    
    --- Billing Info ---- 
    SUM(CASE WHEN is_successful then gmv_amount_lc END) as benchmark_gmv_lc,
    SUM(CASE WHEN is_successful then gmv_amount_eur END) as benchmark_gmv_eur,
    SUM(CASE WHEN is_successful then basket_amount_lc END) as benchmark_basket_amount_lc,
    SUM(CASE WHEN is_successful then basket_amount_eur END) as benchmark_basket_amount_eur,
    SUM(CASE WHEN is_successful THEN delivery_fee_amount_lc END) as benchmark_delivery_fee_lc,
    SUM(CASE WHEN is_successful THEN delivery_fee_amount_eur END) as benchmark_delivery_fee_eur,
    ----- Incentives ------
    SUM(CASE WHEN is_successful then ot_incentive_amount_lc END) as benchmark_o_table_incentive_amount_lc,
    SUM(CASE WHEN is_successful then ot_incentive_amount_eur END) as benchmark_o_table_incentive_amount_eur,
    -- SUM(CASE WHEN is_successful then incentive_amount_lc END) as benchmark_incentive_amount_lc,
    -- SUM(CASE WHEN is_successful then incentive_amount_eur END) as benchmark_incentive_amount_eur,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_lc END) as benchmark_df_incet_amt_lc,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_eur END) as benchmark_df_incet_amt_eur,  
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_lc END) as benchmark_sf_incent_amt_lc,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_eur END) as benchmark_sf_incent_amt_eur,
    --- Rating ----
    SUM(original_rating) as benchmark_order_rating_numerator,
    COUNT(CASE WHEN original_rating is not null then order_id end) as benchmark_order_rating_denominator,
    ------ Customer Info -----
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  analytical_customer_id   END) AS benchmark_new_customer,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  analytical_customer_id   END) AS benchmark_repeated_customer,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_order_index   = 1 THEN  analytical_customer_id   END) AS benchmark_platform_acquisition,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  order_id   END) AS benchmark_new_customer_order_count,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  order_id   END) AS benchmark_repeated_customer_order_count,
    ----- Contact -------
    COUNT(DISTINCT CASE WHEN NOT is_abandoned then order_id END) as benchmark_gross_orders,
    SUM(CASE WHEN stakeholder_id = 4 AND contact_id IS NOT NULL THEN 1 END) as benchmark_vendor_contact_new,
    COUNT(CASE WHEN stakeholder_id   = 4  AND contact_id IS NOT NULL THEN order_id END) as benchmark_contacted_orders,
    -- Actual Delivery Time completed orders 
    SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN actual_delivery_time/60 END) AS benchmark_actual_delivery_time_comp_orders_numerator,
    COUNT(DISTINCT CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN o_log_order_id END) AS benchmark_actual_delivery_time_comp_orders_denominator, 
    -------Vendor Delay V2
    COUNT(DISTINCT CASE WHEN (( vendor_delay_v2/60) >> 10) THEN order_id  ELSE NULL END) AS benchmark_vendor_late_orders_10min_V2,         
    COUNT(DISTINCT CASE WHEN ( vendor_delay_v2/60) IS NOT NULL THEN order_id  END) AS benchmark_vendor_late_orders_V2,   
    SUM(vendor_delay_v2/60) as benchmark_vendor_late_min_V2,
      ------- Stacked Orders 
      COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0 THEN order_code END) as benchmark_stacked_orders,
      COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0  AND (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS benchmark_log_completed_stacked_orders,
      COUNT(DISTINCT CASE WHEN (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS benchmark_log_completed_orders,
      ------- Est. Prep Time
      SUM(estimated_prep_time)*1.0/60 AS benchmark_estimated_prep_time_sum,
      COUNT(CASE WHEN estimated_prep_time is not null then order_id end) AS benchmark_estimated_prep_time_count,
      ------- Order Late
      COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT is_logistics_preorder AND order_status='completed' THEN order_delay/60  END ) >> 10) THEN order_code  ELSE NULL END) as benchmark_order_late_10min_numerator, 
      COUNT(DISTINCT CASE WHEN order_delay IS NOT NULL THEN order_code END ) benchmark_order_late_10min_denominator,
    FROM orders_base
    WHERE DATE(order_date) >>= "2025-02-01"
    AND country_code IN ("AE","KW")
    AND vertical = "food"
    GROUP BY ALL),

  mfo_order_details AS
    ( Select
      order_date,
      vendor_id,
      --- Order Info ---- 
      COUNT(DISTINCT CASE WHEN is_successful then order_id END) as successful_orders,
      COUNT(DISTINCT CASE WHEN is_net then order_id END) as net_orders,
      COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful) AND owner = 'VENDOR' then order_id END) as vendor_net_fail_orders,
      COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful)  then order_id END) as net_fail_orders,
      --- Billing Info ---- 
      SUM(CASE WHEN is_successful then gmv_amount_lc END) as gmv_lc,
      SUM(CASE WHEN is_successful then gmv_amount_eur END) as gmv_eur,
      SUM(CASE WHEN is_successful then basket_amount_lc END) as basket_amount_lc,
      SUM(CASE WHEN is_successful then basket_amount_eur END) as basket_amount_eur,
      SUM(CASE WHEN is_successful THEN delivery_fee_amount_lc END) as delivery_fee_lc,
      SUM(CASE WHEN is_successful THEN delivery_fee_amount_eur END) as delivery_fee_eur,
      ----- Incentives ------
      SUM(CASE WHEN is_successful then incentive_amount_lc END) as o_table_incentive_amount_lc,
      SUM(CASE WHEN is_successful then incentive_amount_eur END) as o_table_incentive_amount_eur,
      SUM(CASE WHEN is_successful then incentive_amount_lc END) as incentive_amount_lc,
      SUM(CASE WHEN is_successful then incentive_amount_eur END) as incentive_amount_eur,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_lc END) as df_incet_amt_lc,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_eur END) as df_incet_amt_eur,  
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_lc END) as sf_incent_amt_lc,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_eur END) as sf_incent_amt_eur,
      --- Rating ----
      SUM(original_rating) as order_rating_numerator,
      COUNT(CASE WHEN original_rating is not null then order_id end) as order_rating_denominator,
      ------ Customer Info -----
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  analytical_customer_id   END) AS new_customer,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  analytical_customer_id   END) AS repeated_customer,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_order_index   = 1 THEN  analytical_customer_id   END) AS platform_acquisition,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  order_id   END) AS new_customer_order_count,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  order_id   END) AS repeated_customer_order_count,
      ----- Contact -------
      COUNT(DISTINCT CASE WHEN NOT is_abandoned then order_id END) as gross_orders,
      SUM(CASE WHEN stakeholder_id = 4 AND contact_id IS NOT NULL THEN 1 END) as vendor_contact_new,
      COUNT(CASE WHEN stakeholder_id   = 4  AND contact_id IS NOT NULL THEN order_id END) as contacted_orders,
      -- Actual Delivery Time completed orders 
      SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN actual_delivery_time/60 END) AS actual_delivery_time_comp_orders_numerator,
      COUNT(DISTINCT CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND o.is_tgo THEN o_log_order_id END) AS actual_delivery_time_comp_orders_denominator, 
      -------Vendor Delay V2
      COUNT(DISTINCT CASE WHEN (( vendor_delay_v2/60) >> 10) THEN order_id  ELSE NULL END) AS vendor_late_orders_10min_V2,         
      COUNT(DISTINCT CASE WHEN ( vendor_delay_v2/60) IS NOT NULL THEN order_id  END) AS vendor_late_orders_V2,   
      SUM(vendor_delay_v2/60) as vendor_late_min_V2,
        ------- Stacked Orders 
        COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0 THEN order_code END) as stacked_orders,
        COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0  AND (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS log_completed_stacked_orders,
        COUNT(DISTINCT CASE WHEN (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS log_completed_orders,
        ------- Est. Prep Time
        SUM(estimated_prep_time)*1.0/60 AS estimated_prep_time_sum,
        COUNT(CASE WHEN estimated_prep_time is not null then order_id end) AS estimated_prep_time_count,
        ------- Order Late
        COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT is_logistics_preorder AND order_status='completed' THEN order_delay/60  END ) >> 10) THEN order_code  ELSE NULL END) as order_late_10min_numerator, 
        COUNT(DISTINCT CASE WHEN order_delay IS NOT NULL THEN order_code END ) order_late_10min_denominator,

      FROM orders_base o
      LEFT JOIN inct_final i on i.incent_order_id = o.order_id
      WHERE DATE(order_date) >>= "2025-02-01"
      AND country_code IN ("AE","KW")
      AND is_meal_for_one_order
      GROUP BY ALL),



      
      agg_vendor_metrics as
      (
        SELECT 
        snapshot_date as order_date,
        vendor_id,
        successful_order_count as all_successful_order,
        gmv_amount_lc as all_gmv_amount_lc,
        gmv_amount_eur as all_gmv_amount_eur,
        cpc_revenue_lc,
        cpc_revenue_eur,
        schedule_duration_in_hours,
        offline_duration_in_hours,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily`
        WHERE 
        snapshot_date >>= "2025-02-01" 
        AND country_code IN ("AE",'KW')
        AND vendor_id IN (SELECT DISTINCT vendor_id FROM mfo_orders)
      ),


   vendor_tiers AS
    (
      SELECT
      distinct
      lower(country_code) as country_code,
      (chain_id) as chain_id,
      date as month,
      lower(chain_name) as chain_name,
      ifnull(chain_monetisation_tiers,"Tier E") as tiers
      FROM `tlb-data-prod.data_platform.agg_chain_tiers`
    ),

    agg_country_metrics as
      (
        SELECT 
        m.snapshot_date as order_date,
        m.country_code,
        SUM(successful_order_count) as country_orders,  
        SUM(gmv_amount_lc) as country_gmv_amount_lc,
        SUM(gmv_amount_eur) as country_gmv_amount_eur,
        SUM(offline_duration_in_hours) as country_offline_duration_in_hours,
        SUM(schedule_duration_in_hours) as country_schedule_duration_in_hours,
        SUM(CASE WHEN vt.tiers = "AAA" THEN successful_order_count END) as aaa_orders,
        SUM(CASE WHEN vt.tiers = "Tier A" THEN successful_order_count END) as tier_a_orders,
        SUM(CASE WHEN vt.tiers = "Tier B" THEN successful_order_count END) as tier_b_orders,
        SUM(CASE WHEN vt.tiers = "Tier C" THEN successful_order_count END) as tier_c_orders,
        SUM(CASE WHEN vt.tiers = "Tier D" THEN successful_order_count END) as tier_d_orders,
        SUM(CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" THEN successful_order_count END) as tier_e_orders,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` m
        LEFT JOIN vendor_tiers vt on vt.chain_id = m.chain_id AND vt.month = DATE_TRUNC(m.snapshot_date,month)
        WHERE 
        m.snapshot_date >>= "2025-02-01" 
        AND m.country_code IN ("AE",'KW')
        AND m.vertical = "food"
        GROUP BY ALL
      ),

      chain_teir_metrics as
      (
        SELECT 
        DATE_TRUNC(m.snapshot_date,month) as order_date,
        m.country_code,
        COUNT(DISTINCT CASE WHEN vt.tiers = "AAA" AND successful_order_count >> 0 THEN m.vendor_id END) as aaa_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "AAA" AND successful_order_count >> 0 THEN m.chain_id END) as aaa_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier A" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_a_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier A" AND successful_order_count >> 0 THEN m.chain_id END) as tier_a_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier B" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_b_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier B" AND successful_order_count >> 0 THEN m.chain_id END) as tier_b_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier C" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_c_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier C" AND successful_order_count >> 0 THEN m.chain_id END) as tier_c_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier D" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_d_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier D" AND successful_order_count >> 0 THEN m.chain_id END) as tier_d_active_chains,
        COUNT(DISTINCT CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_e_active_vendors,
        COUNT(DISTINCT CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" AND successful_order_count >> 0 THEN m.chain_id END) as tier_e_active_chains,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` m
        LEFT JOIN vendor_tiers vt on vt.chain_id = m.chain_id AND vt.month = DATE_TRUNC(m.snapshot_date,month)
        WHERE 
        m.snapshot_date >>= "2025-02-01" 
        AND m.country_code IN ("AE",'KW')
        AND m.vertical = "food"
        GROUP BY ALL
      )
   
    SELECT 
    o.order_date,
    o.vendor_id,
    v.vendor_name,
    c.chain_id,
    c.chain_name,
    c.main_cuisine,
    ifnull(vc.tiers,"Tier E") as tiers,
    v.account_manager_name,
    v.team_leader_name,
    c.country_code,
    t.transmission_category,
    o.* EXCEPT (order_date,vendor_id),
    avm.* EXCEPT (order_date,vendor_id),
    acm.* EXCEPT (order_date,country_code),
    bd.* EXCEPT (order_date,country_code),
    ctm.* EXCEPT (order_date,country_code)
    FROM mfo_order_details o
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
    LEFT JOIN vendor_tiers vc on vc.chain_id = c.chain_id AND DATE_TRUNC(vc.month,month) = DATE_TRUNC(o.order_date,month)
    LEFT JOIN agg_vendor_metrics avm on avm.vendor_id = o.vendor_id AND avm.order_date = o.order_date
    LEFT JOIN agg_country_metrics acm on acm.order_date = o.order_date AND acm.country_code = c.country_code
    LEFT JOIN benchmark_details bd on bd.order_date = o.order_date AND bd.country_code = c.country_code
    LEFT JOIN transmission t on t.vendor_id = v.vendor_id
    LEFT JOIN chain_teir_metrics ctm on ctm.order_date = DATE_TRUNC(o.order_date,month) AND ctm.country_code = c.country_code]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.081orr90o2x7sk1fqg6rq1nbuio3' name='Custom SQL Query' type='text'><![CDATA[WITH 
      orders_base AS
    (
    SELECT
      o.order_date,
      o.order_id,
      ---- Dim ----
      v.vendor_id,
      dc.chain_id,
      dc.country_code,
      dc.vertical,
      --- Order Falgs ---
      o.is_abandoned,
      os.is_net,
      o.is_test,
      o.is_successful,
      o.is_meal_for_one_order,
      ---- Monetary ---
      o.gmv_amount_lc,
      o.gmv_amount_eur,
      o.basket_amount_lc,
      o.basket_amount_eur,
      o.incentive_amount_lc as ot_incentive_amount_lc,
      o.incentive_amount_eur as ot_incentive_amount_eur,
      -- i.incentive_amount_lc,
      -- i.incentive_amount_eur,
      o.delivery_fee_amount_lc,
      o.delivery_fee_amount_eur,
      o.service_fee_amount_lc,
      o.service_fee_amount_eur,
      ---- Order Ranks --- 
      o.analytical_customer_id,
      rank.customer_vendor_order_index,
      rank.customer_order_index,
      ---- Rating ------
      rating.original_rating,
      ---- Contact ---- 
      c.contact_id,
      c.stakeholder_id,
      --- Logistics ----
      ofr.owner,
      o.is_tgo,
      o_log.order_id as o_log_order_id,
      o_log.actual_delivery_time,
      o_log.vendor_delay_v2,
      o_log.primary_stacked_count,
      estimated_prep_time,
      o_log.is_logistics_preorder,
      o_log.order_status,
      o_log.order_delay,
      o_log.order_code
    FROM `tlb-data-prod.data_platform.fct_order_info` o
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` o_log on o_log.order_id = o.order_id and o_log.is_talabat
    INNER JOIN `tlb-data-prod.data_platform.dim_order_status` os on os.order_status_id = o.order_status_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` ofr on ofr.order_fail_reason_id = o.order_fail_reason_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_rating` rating on rating.order_id = o.order_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` rank on rank.order_id = o.order_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc on dc.chain_id = o.chain_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_contact` c on c.order_id = CAST(o.order_id AS STRING)
    WHERE DATE(o.order_date) >>= "2025-02-01"
    AND dc.country_code IN ("AE","KW")
    ),

    mfo_orders AS 
    (
    SELECT 
    DISTINCT order_id,vendor_id
    FROM orders_base
    WHERE is_meal_for_one_order
    ),

  pre_transmission as   
  (
    SELECT 
    vendor_id,
    dt.transmission_category  AS transmission_category,
    row_number() over (partition by vendor_id order by end_date desc ) as rno
    FROM `tlb-data-prod.data_platform.rltnp_vendor_x_transmission`  vt 
    LEFT JOIN `tlb-data-prod.data_platform.dim_transmission` dt ON vt.transmission_id = dt.transmission_id
    WHERE 1=1
    ),

  transmission AS (
    SELECT vendor_id,transmission_category FROM pre_transmission
    WHERE rno = 1
    ),

  incentive_base AS
    (
      SELECT
order_date,
      dc.country_code,
      orders.vendor_id,
      vv.vendor_name,
      vv.account_manager_name,
          CASE 
          WHEN orders.incentive_sub_type ='voucher wallet' AND orders.platform_cost_share = 0 AND incentive_type_detail = 'LOYALTY' THEN 'tRewards' 
        WHEN orders.incentive_sub_type ='voucher wallet' AND orders.platform_cost_share = 0 AND incentive_type_detail <<>> 'LOYALTY'
        THEN 'voucher'
        ELSE orders.incentive_sub_type END
      AS incentive_sub_type_new,
      CAST(is_monetized_campaign AS string) AS is_targeted_campaign,
      vv.chain_id,
      dc.chain_name,
      CASE
        WHEN orders.platform_cost_share >> 0 THEN 'talabat funded'
        ELSE 'vendor funded'
      END
      AS funded_by,
      orders.order_id,
      orders.incentive_amount_lc,
      orders.incentive_amount_eur,
      orders.gmv_amount_lc,
      orders.gmv_amount_eur,
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders
    LEFT JOIN`tlb-data-prod.data_platform.dim_incentives_discount` c ON orders.incentive_campaign_id = c.incentive_campaign_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_voucher` d ON orders.incentive_campaign_id = d.incentive_campaign_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info`  vv ON orders.vendor_id = vv.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc ON vv.chain_id = dc.chain_id
    WHERE
       orders.order_date >>= "2025-02-01"
      AND is_successful
      AND dc.country_code IN ('AE',"KW")
      AND orders.order_id IN (SELECT DISTINCT order_id FROM mfo_orders)
      AND orders.incentive_sub_type NOT IN ('compensation')
      AND  orders.incentive_sub_type IN ('menu discount','item discount','free delivery','gem','discounted delivery','buy x get y','booster discount','voucher wallet')
    ),

    inct_final
      AS
      (
        SELECT 
        order_date as incent_order_date,
        order_id as incent_order_id,
        SUM(incentive_amount_lc) as incentive_amount_lc,
        SUM(incentive_amount_eur) as incentive_amount_eur,
        FROM incentive_base
        WHERE incentive_sub_type_new NOT IN ('voucher wallet')
        GROUP BY 1,2
      ),


benchmark_details AS
  ( Select
    order_date,
    country_code,
    --- Order Info ---- 
    COUNT(DISTINCT CASE WHEN is_successful then order_id END) as benchmark_successful_orders,
    COUNT(DISTINCT CASE WHEN is_net then order_id END) as benchmark_net_orders,
    COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful) AND owner = 'VENDOR' then order_id END) as benchmark_vendor_net_fail_orders,
    COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful)  then order_id END) as benchmark_net_fail_orders,    
    --- Billing Info ---- 
    SUM(CASE WHEN is_successful then gmv_amount_lc END) as benchmark_gmv_lc,
    SUM(CASE WHEN is_successful then gmv_amount_eur END) as benchmark_gmv_eur,
    SUM(CASE WHEN is_successful then basket_amount_lc END) as benchmark_basket_amount_lc,
    SUM(CASE WHEN is_successful then basket_amount_eur END) as benchmark_basket_amount_eur,
    SUM(CASE WHEN is_successful THEN delivery_fee_amount_lc END) as benchmark_delivery_fee_lc,
    SUM(CASE WHEN is_successful THEN delivery_fee_amount_eur END) as benchmark_delivery_fee_eur,
    ----- Incentives ------
    SUM(CASE WHEN is_successful then ot_incentive_amount_lc END) as benchmark_o_table_incentive_amount_lc,
    SUM(CASE WHEN is_successful then ot_incentive_amount_eur END) as benchmark_o_table_incentive_amount_eur,
    -- SUM(CASE WHEN is_successful then incentive_amount_lc END) as benchmark_incentive_amount_lc,
    -- SUM(CASE WHEN is_successful then incentive_amount_eur END) as benchmark_incentive_amount_eur,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_lc END) as benchmark_df_incet_amt_lc,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_eur END) as benchmark_df_incet_amt_eur,  
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_lc END) as benchmark_sf_incent_amt_lc,
    -- SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_eur END) as benchmark_sf_incent_amt_eur,
    --- Rating ----
    SUM(original_rating) as benchmark_order_rating_numerator,
    COUNT(CASE WHEN original_rating is not null then order_id end) as benchmark_order_rating_denominator,
    ------ Customer Info -----
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  analytical_customer_id   END) AS benchmark_new_customer,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  analytical_customer_id   END) AS benchmark_repeated_customer,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_order_index   = 1 THEN  analytical_customer_id   END) AS benchmark_platform_acquisition,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  order_id   END) AS benchmark_new_customer_order_count,
    COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  order_id   END) AS benchmark_repeated_customer_order_count,
    ----- Contact -------
    COUNT(DISTINCT CASE WHEN NOT is_abandoned then order_id END) as benchmark_gross_orders,
    SUM(CASE WHEN stakeholder_id = 4 AND contact_id IS NOT NULL THEN 1 END) as benchmark_vendor_contact_new,
    COUNT(CASE WHEN stakeholder_id   = 4  AND contact_id IS NOT NULL THEN order_id END) as benchmark_contacted_orders,
    -- Actual Delivery Time completed orders 
    SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN actual_delivery_time/60 END) AS benchmark_actual_delivery_time_comp_orders_numerator,
    COUNT(DISTINCT CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN o_log_order_id END) AS benchmark_actual_delivery_time_comp_orders_denominator, 
    -------Vendor Delay V2
    COUNT(DISTINCT CASE WHEN (( vendor_delay_v2/60) >> 10) THEN order_id  ELSE NULL END) AS benchmark_vendor_late_orders_10min_V2,         
    COUNT(DISTINCT CASE WHEN ( vendor_delay_v2/60) IS NOT NULL THEN order_id  END) AS benchmark_vendor_late_orders_V2,   
    SUM(vendor_delay_v2/60) as benchmark_vendor_late_min_V2,
      ------- Stacked Orders 
      COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0 THEN order_code END) as benchmark_stacked_orders,
      COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0  AND (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS benchmark_log_completed_stacked_orders,
      COUNT(DISTINCT CASE WHEN (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS benchmark_log_completed_orders,
      ------- Est. Prep Time
      SUM(estimated_prep_time)*1.0/60 AS benchmark_estimated_prep_time_sum,
      COUNT(CASE WHEN estimated_prep_time is not null then order_id end) AS benchmark_estimated_prep_time_count,
      ------- Order Late
      COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT is_logistics_preorder AND order_status='completed' THEN order_delay/60  END ) >> 10) THEN order_code  ELSE NULL END) as benchmark_order_late_10min_numerator, 
      COUNT(DISTINCT CASE WHEN order_delay IS NOT NULL THEN order_code END ) benchmark_order_late_10min_denominator,
    FROM orders_base
    WHERE DATE(order_date) >>= "2025-02-01"
    AND country_code IN ("AE","KW")
    AND vertical = "food"
    GROUP BY ALL),

  mfo_order_details AS
    ( Select
      order_date,
      vendor_id,
      --- Order Info ---- 
      COUNT(DISTINCT CASE WHEN is_successful then order_id END) as successful_orders,
      COUNT(DISTINCT CASE WHEN is_net then order_id END) as net_orders,
      COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful) AND owner = 'VENDOR' then order_id END) as vendor_net_fail_orders,
      COUNT(DISTINCT CASE WHEN is_net AND NOT(is_successful)  then order_id END) as net_fail_orders,
      --- Billing Info ---- 
      SUM(CASE WHEN is_successful then gmv_amount_lc END) as gmv_lc,
      SUM(CASE WHEN is_successful then gmv_amount_eur END) as gmv_eur,
      SUM(CASE WHEN is_successful then basket_amount_lc END) as basket_amount_lc,
      SUM(CASE WHEN is_successful then basket_amount_eur END) as basket_amount_eur,
      SUM(CASE WHEN is_successful THEN delivery_fee_amount_lc END) as delivery_fee_lc,
      SUM(CASE WHEN is_successful THEN delivery_fee_amount_eur END) as delivery_fee_eur,
      ----- Incentives ------
      SUM(CASE WHEN is_successful then incentive_amount_lc END) as o_table_incentive_amount_lc,
      SUM(CASE WHEN is_successful then incentive_amount_eur END) as o_table_incentive_amount_eur,
      SUM(CASE WHEN is_successful then incentive_amount_lc END) as incentive_amount_lc,
      SUM(CASE WHEN is_successful then incentive_amount_eur END) as incentive_amount_eur,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_lc END) as df_incet_amt_lc,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN delivery_fee_amount_eur END) as df_incet_amt_eur,  
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_lc END) as sf_incent_amt_lc,
      SUM(CASE WHEN is_successful AND incentive_amount_lc >>0 THEN service_fee_amount_eur END) as sf_incent_amt_eur,
      --- Rating ----
      SUM(original_rating) as order_rating_numerator,
      COUNT(CASE WHEN original_rating is not null then order_id end) as order_rating_denominator,
      ------ Customer Info -----
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  analytical_customer_id   END) AS new_customer,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  analytical_customer_id   END) AS repeated_customer,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_order_index   = 1 THEN  analytical_customer_id   END) AS platform_acquisition,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   = 1 THEN  order_id   END) AS new_customer_order_count,
      COUNT(DISTINCT CASE WHEN is_successful  AND  customer_vendor_order_index   >> 1 THEN  order_id   END) AS repeated_customer_order_count,
      ----- Contact -------
      COUNT(DISTINCT CASE WHEN NOT is_abandoned then order_id END) as gross_orders,
      SUM(CASE WHEN stakeholder_id = 4 AND contact_id IS NOT NULL THEN 1 END) as vendor_contact_new,
      COUNT(CASE WHEN stakeholder_id   = 4  AND contact_id IS NOT NULL THEN order_id END) as contacted_orders,
      -- Actual Delivery Time completed orders 
      SUM(CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND is_tgo THEN actual_delivery_time/60 END) AS actual_delivery_time_comp_orders_numerator,
      COUNT(DISTINCT CASE WHEN TRIM(UPPER(order_status)) = TRIM(UPPER('completed')) AND o.is_tgo THEN o_log_order_id END) AS actual_delivery_time_comp_orders_denominator, 
      -------Vendor Delay V2
      COUNT(DISTINCT CASE WHEN (( vendor_delay_v2/60) >> 10) THEN order_id  ELSE NULL END) AS vendor_late_orders_10min_V2,         
      COUNT(DISTINCT CASE WHEN ( vendor_delay_v2/60) IS NOT NULL THEN order_id  END) AS vendor_late_orders_V2,   
      SUM(vendor_delay_v2/60) as vendor_late_min_V2,
        ------- Stacked Orders 
        COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0 THEN order_code END) as stacked_orders,
        COUNT(DISTINCT CASE WHEN primary_stacked_count >> 0  AND (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS log_completed_stacked_orders,
        COUNT(DISTINCT CASE WHEN (UPPER( order_status  ) = UPPER('completed')) THEN order_code  ELSE NULL END) AS log_completed_orders,
        ------- Est. Prep Time
        SUM(estimated_prep_time)*1.0/60 AS estimated_prep_time_sum,
        COUNT(CASE WHEN estimated_prep_time is not null then order_id end) AS estimated_prep_time_count,
        ------- Order Late
        COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT is_logistics_preorder AND order_status='completed' THEN order_delay/60  END ) >> 10) THEN order_code  ELSE NULL END) as order_late_10min_numerator, 
        COUNT(DISTINCT CASE WHEN order_delay IS NOT NULL THEN order_code END ) order_late_10min_denominator,

      FROM orders_base o
      LEFT JOIN inct_final i on i.incent_order_id = o.order_id
      WHERE DATE(order_date) >>= "2025-02-01"
      AND country_code IN ("AE","KW")
      AND is_meal_for_one_order
      GROUP BY ALL),



      
      agg_vendor_metrics as
      (
        SELECT 
        snapshot_date as order_date,
        vendor_id,
        successful_order_count as all_successful_order,
        gmv_amount_lc as all_gmv_amount_lc,
        gmv_amount_eur as all_gmv_amount_eur,
        cpc_revenue_lc,
        cpc_revenue_eur,
        schedule_duration_in_hours,
        offline_duration_in_hours,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily`
        WHERE 
        snapshot_date >>= "2025-02-01" 
        AND country_code IN ("AE",'KW')
        AND vendor_id IN (SELECT DISTINCT vendor_id FROM mfo_orders)
      ),


   vendor_tiers AS
    (
      SELECT
      distinct
      lower(country_code) as country_code,
      (chain_id) as chain_id,
      date as month,
      lower(chain_name) as chain_name,
      ifnull(chain_monetisation_tiers,"Tier E") as tiers
      FROM `tlb-data-prod.data_platform.agg_chain_tiers`
    ),

    agg_country_metrics as
      (
        SELECT 
        m.snapshot_date as order_date,
        m.country_code,
        SUM(successful_order_count) as country_orders,  
        SUM(gmv_amount_lc) as country_gmv_amount_lc,
        SUM(gmv_amount_eur) as country_gmv_amount_eur,
        SUM(offline_duration_in_hours) as country_offline_duration_in_hours,
        SUM(schedule_duration_in_hours) as country_schedule_duration_in_hours,
        SUM(CASE WHEN vt.tiers = "AAA" THEN successful_order_count END) as aaa_orders,
        SUM(CASE WHEN vt.tiers = "Tier A" THEN successful_order_count END) as tier_a_orders,
        SUM(CASE WHEN vt.tiers = "Tier B" THEN successful_order_count END) as tier_b_orders,
        SUM(CASE WHEN vt.tiers = "Tier C" THEN successful_order_count END) as tier_c_orders,
        SUM(CASE WHEN vt.tiers = "Tier D" THEN successful_order_count END) as tier_d_orders,
        SUM(CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" THEN successful_order_count END) as tier_e_orders,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` m
        LEFT JOIN vendor_tiers vt on vt.chain_id = m.chain_id AND vt.month = DATE_TRUNC(m.snapshot_date,month)
        WHERE 
        m.snapshot_date >>= "2025-02-01" 
        AND m.country_code IN ("AE",'KW')
        AND m.vertical = "food"
        GROUP BY ALL
      ),

      chain_teir_metrics as
      (
        SELECT 
        DATE_TRUNC(m.snapshot_date,month) as order_date,
        m.country_code,
        COUNT(DISTINCT CASE WHEN vt.tiers = "AAA" AND successful_order_count >> 0 THEN m.vendor_id END) as aaa_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "AAA" AND successful_order_count >> 0 THEN m.chain_id END) as aaa_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier A" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_a_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier A" AND successful_order_count >> 0 THEN m.chain_id END) as tier_a_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier B" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_b_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier B" AND successful_order_count >> 0 THEN m.chain_id END) as tier_b_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier C" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_c_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier C" AND successful_order_count >> 0 THEN m.chain_id END) as tier_c_active_chains,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier D" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_d_active_vendors,
        COUNT(DISTINCT CASE WHEN vt.tiers = "Tier D" AND successful_order_count >> 0 THEN m.chain_id END) as tier_d_active_chains,
        COUNT(DISTINCT CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" AND successful_order_count >> 0 THEN m.vendor_id END) as tier_e_active_vendors,
        COUNT(DISTINCT CASE WHEN COALESCE(vt.tiers,"Tier E") = "Tier E" AND successful_order_count >> 0 THEN m.chain_id END) as tier_e_active_chains,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` m
        LEFT JOIN vendor_tiers vt on vt.chain_id = m.chain_id AND vt.month = DATE_TRUNC(m.snapshot_date,month)
        WHERE 
        m.snapshot_date >>= "2025-02-01" 
        AND m.country_code IN ("AE",'KW')
        AND m.vertical = "food"
        GROUP BY ALL
      )
   
    SELECT 
    o.order_date,
    o.vendor_id,
    v.vendor_name,
    c.chain_id,
    c.chain_name,
    c.main_cuisine,
    ifnull(vc.tiers,"Tier E") as tiers,
    v.account_manager_name,
    v.team_leader_name,
    c.country_code,
    t.transmission_category,
    o.* EXCEPT (order_date,vendor_id),
    avm.* EXCEPT (order_date,vendor_id),
    acm.* EXCEPT (order_date,country_code),
    bd.* EXCEPT (order_date,country_code),
    ctm.* EXCEPT (order_date,country_code)
    FROM mfo_order_details o
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id = o.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
    LEFT JOIN vendor_tiers vc on vc.chain_id = c.chain_id AND DATE_TRUNC(vc.month,month) = DATE_TRUNC(o.order_date,month)
    LEFT JOIN agg_vendor_metrics avm on avm.vendor_id = o.vendor_id AND avm.order_date = o.order_date
    LEFT JOIN agg_country_metrics acm on acm.order_date = o.order_date AND acm.country_code = c.country_code
    LEFT JOIN benchmark_details bd on bd.order_date = o.order_date AND bd.country_code = c.country_code
    LEFT JOIN transmission t on t.vendor_id = v.vendor_id
    LEFT JOIN chain_teir_metrics ctm on ctm.order_date = DATE_TRUNC(o.order_date,month) AND ctm.country_code = c.country_code]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
