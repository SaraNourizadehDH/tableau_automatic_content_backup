      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='mfo_item' id='_21A5705E95EE4FF683B7C0EAFE6A39E5'>
            <properties context=''>
              <relation connection='bigquery.1hkwnz50y0ssft1a9k5m51poyi3b' name='Custom SQL Query' type='text'>WITH 
agg_cuisine_metrics as
      (
        SELECT 
        DATE_TRUNC(m.snapshot_date,month) as month,
        m.country_code,
        c.main_cuisine as cuisine,
        SUM(successful_order_count) as cuisine_orders,  
        SUM(gmv_amount_lc) as cuisine_gmv_amount_lc,
        SUM(gmv_amount_eur) as cuisine_gmv_amount_eur,
        FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` m
        LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = m.chain_id
        WHERE 
        m.snapshot_date &gt;&gt;= &quot;2025-01-31&quot; 
        AND m.country_code IN (&quot;AE&quot;,&apos;KW&apos;)
        AND m.vertical = &quot;food&quot;
        GROUP BY ALL
      ),

    items AS 
      (
        SELECT
        DISTINCT
        chain_id as f_chain_id,
        item_id as f_item_id,
        original_item_price_lc as f_original_item_price_lc,
        order_item_price_lc as f_order_item_price_lc,
        item_discount_lc as f_item_discount_lc,
        FROM `tlb-data-prod.data_platform.agg_mfo_chain_item_sales_daily`
        WHERE date IS NOT NULL
      ),

      cuisine_rank AS 
      (
      SELECT 
      *,
      RANK() OVER (PARTITION BY month,country_code ORDER BY cuisine_orders DESC) as cuisine_orders_rank,
      RANK() OVER (PARTITION BY month,country_code ORDER BY cuisine_gmv_amount_eur DESC) as cuisine_gmv_rank,
      FROM agg_cuisine_metrics
      ORDER BY country_code,cuisine_orders DESC
      ),

   chain_tiers AS
    (
      SELECT
      distinct
      lower(country_code) as country_code,
      (chain_id) as chain_id,
      date as month,
      lower(chain_name) as chain_name,
      ifnull(chain_monetisation_tiers,&quot;Tier E&quot;) as tiers
      FROM `tlb-data-prod.data_platform.agg_chain_tiers`
    )


    SELECT
    c.main_cuisine,
    di.item_description_en,
    di.is_active,
    IFNULL(ct.tiers,&quot;Tier E&quot;) as tiers,
    i.*,
    c.account_manager_name,
    cr.cuisine_orders_rank,
    cr.cuisine_gmv_rank,
    di.item_price_average
    FROM `tlb-data-prod.data_platform.agg_mfo_chain_item_sales_daily` i
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = i.chain_id
    LEFT JOIN chain_tiers ct on ct.chain_id = i.chain_id AND ct.month = DATE_TRUNC(date,month)
    LEFT JOIN `tlb-data-prod.data_platform.dim_item` di on di.item_id = i.item_id
    LEFT JOIN cuisine_rank cr on cr.month = DATE_TRUNC(date,month) AND cr.country_code = c.country_code AND cr.cuisine = c.main_cuisine
    WHERE date IS NOT NULL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
