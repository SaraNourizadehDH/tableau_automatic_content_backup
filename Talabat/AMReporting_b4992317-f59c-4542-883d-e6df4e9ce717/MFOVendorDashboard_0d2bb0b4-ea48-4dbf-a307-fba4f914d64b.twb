              <calculation class='tableau' formula='#2025-03-05#' />
            </column>
            <column caption='Dim for Quadrants' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cuisine&quot;'>
