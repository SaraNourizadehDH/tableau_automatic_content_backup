            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0fjvcqu1it4u411auaji1158n93g].[Calculation_3317253013767507982]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0fjvcqu1it4u411auaji1158n93g].[Calculation_3317253013767426061]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-05#'>
              <calculation class='tableau' formula='#2025-03-05#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='Offline Rate' datatype='real' default-format='p0.00%' name='[Calculation_3201355693307060224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration_in_hours])/SUM([schedule_duration_in_hours])' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013751480320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_comp_orders_numerator])&#10;/&#10;SUM([actual_delivery_time_comp_orders_denominator])' />
            </column>
            <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013751607297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_rating_numerator])/&#10;SUM([order_rating_denominator])' />
            </column>
            <column caption='vDelay V2 10M %' datatype='real' default-format='p0.00%' name='[Calculation_3317253013751676930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
            </column>
            <column caption='vNet Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_3317253013766475785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
            </column>
            <column caption='Max Date' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767426061]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([order_date])}' />
            </column>
            <column caption='Max Month' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_3317253013767507982]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[order_date])))}' />
            </column>
            <column caption='Is Date Range' datatype='boolean' name='[Calculation_3317253013774368785]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='vContact Rate' datatype='real' default-format='p0.00%' name='[Calculation_3317253013775355924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
            </column>
            <column caption='Order Late' datatype='real' default-format='p0.00%' name='[Calculation_3317253013793222677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10min_numerator])/SUM([order_late_10min_denominator])' />
            </column>
            <column caption='Stacking %' datatype='real' default-format='p0.00%' name='[Calculation_3317253013793419286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([log_completed_orders])' />
            </column>
            <column caption='Est. Prep Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3317253013798498328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time_sum])/SUM([estimated_prep_time_count])' />
