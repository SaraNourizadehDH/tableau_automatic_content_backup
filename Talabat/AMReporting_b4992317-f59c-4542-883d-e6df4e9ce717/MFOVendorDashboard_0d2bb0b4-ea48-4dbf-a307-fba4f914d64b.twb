    <datasource caption='MFO Vendor x Area' inline='true' name='federated.0blh78m03j7lsy1cu0mh61ln9d9m' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.14fc0j51t56chp19dg0n40aom4nz'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='final area_polygon' name='ogrdirect.18mzwz91k2jw7c19brtbx16595v6'>
            <connection class='ogrdirect' directory='Data/Desktop' filename='final area_polygon.geojson' server='' tablename='' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='STR([mfo_vendor_x_area].[area_id])' />
              <expression op='[final area_polygon.geojson].[area_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.14fc0j51t56chp19dg0n40aom4nz' name='mfo_vendor_x_area' type='text'>WITH 
  vendors_base AS
  (
    SELECT 
      v.observed_at_date as date,
      v.city,
      v.location_id,
      v.country_code,
      v.delivery_area,
      v.chain_id,
      v.branch_id,
      v.vendor_name,
      l.area_id,
      c.main_cuisine,
  FROM `tlb-data-prod.data_platform_pluto.tt_vendor_list` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location` l on l.location_id = v.location_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
  WHERE 
  observed_at_date &gt;&gt;= &quot;2025-02-01&quot;
  -- observed_at_date &gt;&gt;= &quot;2025-02-20&quot;
  AND v.country_code IN (&quot;AE&quot;,&quot;KW&quot;)
  AND c.vertical = &quot;food&quot;
  ),

  m41_vendors AS
    (
      SELECT
      chain_id,
      chain_name,
      c.vendor_id,
      c.vendor_name,
      c.location_id,
      true as is_mfo_chain,
      true as is_mfo_vendor,
      main_cuisine,
      l.area_id,
      l.area_name,
      l.country_code,
      item_category_name,
      item_id,
      item_name_en
      FROM `tlb-data-prod.data_platform.dim_item` a
      LEFT JOIN `tlb-data-prod.data_platform.dim_chain` b
      USING(chain_id)
      LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` c
      USING(chain_id)
      LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l 
      USING(location_id)
      WHERE item_category_name = &apos;M41&apos;
      AND item_type_name = &apos;main&apos;
      AND a.is_active
      AND NOT is_deleted
      AND b.country_code in (&apos;AE&apos;, &apos;KW&apos;)
    ),

  pre_final AS
    (
      SELECT
      v.*,
      mv.chain_id AS mfo_chain_id,
      mv.vendor_id AS mfo_vendor_id,
      FROM vendors_base v
      LEFT JOIN (SELECT DISTINCT chain_id,vendor_id, FROM  m41_vendors) mv on mv.vendor_id = v.branch_id
    )

    SELECT 
    date,
    city,
    location_id,
    area_id,
    country_code,
    delivery_area,
    main_cuisine,
    COUNT(DISTINCT chain_id) as all_chains,
    COUNT(DISTINCT branch_id) as all_vendors,
    COUNT(DISTINCT mfo_vendor_id) as mfo_vendors,
    COUNT(DISTINCT mfo_chain_id) as mfo_chains,
    FROM pre_final
    GROUP BY ALL</relation>
          <relation connection='ogrdirect.18mzwz91k2jw7c19brtbx16595v6' name='final area_polygon.geojson' table='[final area_polygon.geojson]' type='table'>
            <columns>
