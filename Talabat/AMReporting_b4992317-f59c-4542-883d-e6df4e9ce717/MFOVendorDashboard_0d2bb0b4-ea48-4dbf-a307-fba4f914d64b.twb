    <worksheet name='Item Price Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f6efe0' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#f6efe0' fontsize='10'>** Price distrubution buckets are different for each country, please use this country filter.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#f6efe0' fontname='Tableau Regular' fontsize='9'>UAE - Buckets are created at 5 AED Gaps for UAE &amp; 0.25 KWD Gaps for KW</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MFO Item Level Performance' name='federated.1ywtcto0sz641x1bi356g1m8nj2q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ywtcto0sz641x1bi356g1m8nj2q].[Calculation_1774347935352967174]' caption='End Date (IL)' datatype='date' name='[Parameter 11]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-05#'>
              <calculation class='tableau' formula='#2025-03-05#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ywtcto0sz641x1bi356g1m8nj2q].[Calculation_1774347935353085959]' caption='Start Date (IL)' datatype='date' name='[Parameter 12]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ywtcto0sz641x1bi356g1m8nj2q'>
            <column caption='No. Of Items' datatype='integer' name='[Calculation_1774347935347290116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([item_id])' />
            </column>
            <column caption='Max Date (IL)' datatype='date' name='[Calculation_1774347935352967174]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
            </column>
            <column caption='Max Month (IL)' datatype='date' name='[Calculation_1774347935353085959]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[date])))}' />
            </column>
            <column caption='Is in Date Range (IL)' datatype='boolean' name='[Calculation_1774347935353479176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [date] &gt;= [Parameters].[Parameter 12] AND [date] &lt;= [Parameters].[Parameter 11] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Item Price Buckets' datatype='string' name='[Calculation_1774347935379869706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_code] = &quot;AE&quot; THEN&#10;(IF &#10;[order_item_price_lc] &lt;= 5 THEN &quot;Below 5&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 5 AND [order_item_price_lc] &lt;= 10 THEN &quot;5-10&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 10 AND [order_item_price_lc] &lt;= 15 THEN &quot;10-15&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 15 AND [order_item_price_lc] &lt;= 20 THEN &quot;15-20&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 20 AND [order_item_price_lc] &lt;= 25 THEN &quot;20-25&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 25 AND [order_item_price_lc] &lt;= 30 THEN &quot;25-30&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 30 THEN &quot;Above 30&quot; END)&#10;&#10;ELSEIF [country_code] = &quot;KW&quot; THEN&#10;(IF &#10;[order_item_price_lc] &lt;= 0.5 THEN &quot;0.25&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 0.25 AND [order_item_price_lc] &lt;= 0.5 THEN &quot;0.25-0.50&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 0.75 AND [order_item_price_lc] &lt;= 1.0 THEN &quot;0.75-1.0&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 1.0 AND [order_item_price_lc] &lt;= 1.25 THEN &quot;1.0-1.25&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 1.25 AND [order_item_price_lc] &lt;= 1.5 THEN &quot;1.25-1.5&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 1.5 AND [order_item_price_lc] &lt;= 1.75 THEN &quot;1.5-1.75&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 1.75 AND [order_item_price_lc] &lt;= 2.0 THEN &quot;1.75-2.0&quot;&#10;ELSEIF &#10;[order_item_price_lc] &gt; 2.0 THEN &quot;Above 2.0&quot; END)&#10;ELSE &quot;Other&quot; END' />
            </column>
            <column caption='No. Of Orders' datatype='integer' name='[Calculation_6512768062031093766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])' />
            </column>
            <column caption='AM Name' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Item ID' datatype='integer' name='[item_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1774347935353479176]' derivation='None' name='[none:Calculation_1774347935353479176:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1774347935379869706]' derivation='None' name='[none:Calculation_1774347935379869706:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
