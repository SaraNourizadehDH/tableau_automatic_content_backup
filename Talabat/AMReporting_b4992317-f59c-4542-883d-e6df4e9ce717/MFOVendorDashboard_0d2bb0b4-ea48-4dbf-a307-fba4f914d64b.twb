          <datasource-dependencies datasource='federated.0fjvcqu1it4u411auaji1158n93g'>
            <column caption='Offline Rate' datatype='real' default-format='p0.00%' name='[Calculation_3201355693307060224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration_in_hours])/SUM([schedule_duration_in_hours])' />
            </column>
