            <remote-type>7</remote-type>
            <local-name>[first_online_month]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>first_online_month</remote-alias>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_83AF5FAEED354DE8AED035C740E9809C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>first_online_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[first_online_date]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>first_online_date</remote-alias>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_83AF5FAEED354DE8AED035C740E9809C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>business_type</remote-name>
            <remote-type>130</remote-type>
            <local-name>[business_type]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>business_type</remote-alias>
            <local-type>string</local-type>
