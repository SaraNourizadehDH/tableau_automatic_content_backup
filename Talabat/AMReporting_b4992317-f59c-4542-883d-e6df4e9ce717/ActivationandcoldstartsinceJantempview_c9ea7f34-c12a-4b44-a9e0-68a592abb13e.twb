    <worksheet name='activated_list2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#666666'><![CDATA[Activation in first 30 days list  - <]]></run>
            <run fontcolor='#666666'>[New vendor performance  (local copy)].[none:country_code:nk]</run>
            <run fontcolor='#666666'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='New vendor performance  (local copy)' />
          </datasources>
          <datasource-dependencies datasource='New vendor performance  (local copy)'>
            <column caption='Activation Status' datatype='string' name='[Activation status (copy)_6016457282948100116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  ifnull([order_0_30_day],0) &gt;= 1 then &quot;Activated&quot;&#10;elseif  [is_activated] = 1 THEN  &quot;Activated&quot; &#10;else &quot;Not Activated&quot; end' />
            </column>
            <column caption='Offline duration 30 days' datatype='real' name='[Calculation_100205138837782531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30])/sum([actual_duration_in_hrs_0_30])' />
            </column>
            <column caption='vendor grade' datatype='string' name='[Calculation_1085789731678420992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='lower([vendor_grade])' />
            </column>
            <column caption='orders forecast' datatype='real' name='[Calculation_1970676725688741888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(if max([Calculation_6366752872450056195]) = &quot;First 30 days not over&quot; then (30 * sum(ifnull([order_0_30_day],0))) / sum([days_since_onboarding] ) end,0)' />
            </column>
            <column caption='completed F30 days' datatype='boolean' name='[Calculation_1970676725802151943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [day30_from_first_online_date] &lt;= [last_updated_at] then true else false  end' />
              <aliases>
                <alias key='false' value='Not completed' />
                <alias key='true' value='Completed' />
              </aliases>
            </column>
            <column caption='Terminated before 30th day' datatype='boolean' name='[Calculation_1970676725814501385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [sf_contract_flags] = &quot;include&quot; then false else true end' />
            </column>
            <column caption='DLP on first online date ' datatype='real' name='[Calculation_2249970285810212864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_1])/ sum([total_active_menu_items_1])' />
            </column>
            <column caption='DLP on 30th dat from first online date' datatype='real' name='[Calculation_2249970285810393089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_30]) / sum([total_active_menu_items_30])' />
            </column>
            <column caption='check for 15 minutes vendors' datatype='boolean' name='[Calculation_244038865773400075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='contains ((LOWER([vendor_name])) ,&quot;15 minutes&quot;)' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_3221973699789475856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN USERNAME() = [account_manager_email] &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN [team_leader_email] = {MIN(IF USERNAME() = [account_manager_email] THEN [team_leader_email] ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN USERNAME() = [team_leader_email] OR USERNAME() = [account_manager_email]&#10;END' />
            </column>
            <column caption='Growth products' datatype='string' name='[Calculation_3287909213719035906]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([Calculation_6366752873063432204] &gt; 0  ) then &quot;On growth pdts&quot; else &quot;Not on growth pdts&quot; end' />
            </column>
            <column caption='Vertical flag' datatype='string' name='[Calculation_3835518800872120320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  (vertical = &quot;Restaurant&quot;  or lower(vertical_segment__c) in (&quot;bakery&quot;,&quot;drinks&quot;,&quot;snacks_and_sweets&quot;,&quot;specialty_coffee_and_tea&quot;))&#10;then &quot;Restaurant&quot; else &quot;Others&quot; end' />
            </column>
            <column caption='Activation status' datatype='string' name='[Calculation_4705698684443639813]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if   [days_since_onboarding] &lt; 30 then &quot;First 30 days not over&quot;  &#10;elseif  [is_activated] = 1 THEN  &quot;Activated&quot; &#10;else &quot;Not Activated&quot; end' />
            </column>
            <column caption='Dineout' datatype='boolean' name='[Calculation_5628514434802434056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([vendor_dineout_flags]) = true then true else false end' />
            </column>
            <column caption='Team' datatype='string' name='[Calculation_5628514434803429385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in (&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,) then &apos;Field Sales&apos;&#10;ELSEIF  lower([owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] in (&apos;Inside Sales Executive&apos;, &apos;Executive Inside Sales&apos;)    then &apos;Tele Sales&apos;&#10;else &apos;Account Managers&apos;&#10;end' />
            </column>
            <column caption='Self Activated' datatype='string' name='[Calculation_5941866420104331265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [case_modified_by_name] = &quot;API Vendor Onboarding&quot; then &quot;Self Activated&quot; else &quot;Others&quot; end' />
            </column>
            <column caption='AM assigned?' datatype='string' name='[Calculation_6366752872443891712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if lower([am_name]) = lower([owner_name]) then &quot;Not assigned&quot; else &quot;Assigned&quot; end' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_6366752872444547073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([placed_order_session_count_0_30]) / SUM( [viewed_menu_session_count_0_30])' />
            </column>
            <column caption='Coldstart?' datatype='string' name='[Calculation_6366752872450056195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if   [days_since_onboarding] &lt; 30 then &quot;First 30 days not over&quot;  &#10;elseif  [is_coldstart] = 1 THEN  &quot;Coldstart&quot; &#10;else &quot;Healthy&quot; end' />
            </column>
            <column caption='growth products' datatype='real' name='[Calculation_6366752873062608907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(ifnull([ad_revenue_0_30],0)) + ifnull([VFD 0 to 30 (copy)_4539206263770177536],0) + ifnull([Targeted discounts 0 to 30 day (copy)_4539206263770361857],0))' />
            </column>
            <column caption='Vendors on growth products' datatype='integer' name='[Calculation_6366752873063432204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull({ FIXED [vendor_id],[month] : if   ([Calculation_6366752873062608907]) &gt; 0 then COUNTD([vendor_id]) else null end },0)' />
            </column>
            <column caption='VFR 0 to 30 days' datatype='real' name='[Calculation_6366752873632370703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum( [net_order_0_30])' />
            </column>
            <column caption='DLD on 30th day from first online date ' datatype='real' name='[DLP on 30th dat from first online date (copy)_1710664174913343489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_description_30]) / sum([total_active_menu_items_30])' />
            </column>
            <column caption='DLD on first online date  ' datatype='real' name='[DLP on first online date  (copy)_1710664174913200128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_description_1])/ sum([total_active_menu_items_1])' />
