            <column datatype='boolean' name='[is_managed_by_vendor_helpdesk]' role='dimension' type='nominal' />
            <column datatype='integer' name='[items_with_images_1]' role='measure' type='quantitative' />
            <column caption='Latest items with images' datatype='integer' name='[items_with_images_30]' role='measure' type='quantitative' />
