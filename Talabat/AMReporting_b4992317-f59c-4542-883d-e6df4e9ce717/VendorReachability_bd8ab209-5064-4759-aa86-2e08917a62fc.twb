    <worksheet name='phone (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#411517' fontsize='14'>Account and Owner Phone number status - validated by Whatsapp comms </run>
            <run bold='true' fontcolor='#411517' fontsize='9' italic='true'>(based  on comms sent during last 6 months)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0txybe007qydjz17koj991jkri16' />
          </datasources>
          <datasource-dependencies datasource='federated.0txybe007qydjz17koj991jkri16'>
