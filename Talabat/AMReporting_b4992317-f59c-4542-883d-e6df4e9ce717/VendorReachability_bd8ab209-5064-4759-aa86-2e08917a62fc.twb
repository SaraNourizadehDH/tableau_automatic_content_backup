      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Calculation_4484881582080675842:qk]&quot;' value='Reachable vendors' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Calculation_4484881582084296709:qk]&quot;' value='Vendors with Account and Owner emails' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Calculation_4484881582084648967:qk]&quot;' value='Vendors with VP/App login this month' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Calculation_661536603176886287:qk]&quot;' value='Vendors with SF account phone number' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Vendors with Account and Owner emails (copy)_4484881582084534278:qk]&quot;' value='Vendors with Account and Owner phone number' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Vendors with SF account email (copy)_661536603330134040:qk]&quot;' value='Vendors with SF owner email ' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Vendors with SF account phone number (copy)_661536603177201680:qk]&quot;' value='Vendors with SF Owner phone number ' />
          <alias key='&quot;[federated.0txybe007qydjz17koj991jkri16].[ctd:Vendors with SF account phone number (copy)_661536603326980119:qk]&quot;' value='Vendors with SF account email' />
        </aliases>
      </column>
      <column caption='sf account email hard bounced' datatype='boolean' name='[Calculation_4484881582058315776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [sf_account_email_hard_bounced] = &quot;true&quot;  then true else false  end' />
      </column>
      <column caption='Reachable vendors' datatype='integer' name='[Calculation_4484881582080675842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_reachable_vendor] = true then [vendor_id] end' />
      </column>
      <column caption='Total active vendors (L3M)' datatype='integer' name='[Calculation_4484881582080770051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Share of Reachable vendors' datatype='real' name='[Calculation_4484881582080868356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_4484881582080675842])/ [Calculation_4484881582080770051]' />
      </column>
      <column caption='Vendors with Account and Owner emails' datatype='integer' name='[Calculation_4484881582084296709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [has_all_emails] = true then [vendor_id] end' />
      </column>
      <column caption='Vendors with VP/App login this month' datatype='integer' name='[Calculation_4484881582084648967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [app_vp_login_this_month] = true then [vendor_id] end' />
      </column>
      <column caption='Vendors with account and owner number' datatype='integer' name='[Calculation_661536602967597057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [phone_number_status] = &quot;has all numbers&quot; then [vendor_id]&#10;ELSEIF [phone_number_status] = &quot;No vp  number - has account and owner number&quot; then [vendor_id]&#10;end' />
      </column>
      <column caption='Share of Vendors with account and owner number' datatype='real' name='[Calculation_661536602968223746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_661536602967597057]) / COUNTD([vendor_id])' />
      </column>
      <column caption='sf_account phone - is on whatsapp ?' datatype='boolean' name='[Calculation_661536602970509318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([sf_account_recent_whatsapp],&quot; &quot;) &lt;&gt; &quot; &quot; and [sf_account_recent_whatsapp_within_l6m] = true' />
      </column>
      <column caption='Vendors with SF account phone number' datatype='integer' name='[Calculation_661536603176886287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [SF_phone_number_status] in (&quot;Has SF Account and Owner number&quot;, &quot;No SF Owner number&quot;)  then [vendor_id] end' />
      </column>
      <column caption='SF account phone - whatsapp delivered' datatype='integer' name='[Calculation_661536603319635986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_661536602970509318] = true then [vendor_id] end' />
      </column>
      <column caption='Share of SF Account phones with whatsapp' datatype='real' name='[Calculation_661536603319963668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_661536603319635986]) / COUNTD([Calculation_661536603176886287])' />
      </column>
      <column caption='Group By' datatype='string' name='[Calculation_661536603502710813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Chain Tiers&quot; then [chain_monetisation_tiers]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Country&quot; then [country_code]&#10;else &quot; &quot; end' />
      </column>
      <column caption='user filter' datatype='boolean' name='[Calculation_661536603536252958]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN lower(USERNAME()) = lower([account_manager_email] )&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN lower([team_leader_email]) = {MIN(IF  lower(USERNAME() ) = lower([account_manager_email]) THEN lower([team_leader_email]) ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN lower(USERNAME()) = lower([team_leader_email]) OR lower(USERNAME()) = lower([account_manager_email] )&#10;END' />
      </column>
      <column caption='SF owner emails - hard bounced ' datatype='integer' name='[SF account emails - hard bounced (copy)_661536603332386842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [sf_contact_email_hard_bounced] = &quot;true&quot; and  [SF_email_status] in (&quot;Has SF Account and Owner email&quot;, &quot;No SF Account email&quot;) then [vendor_id] end' />
      </column>
      <column caption='SF owner phone - whatsapp delivered ' datatype='integer' name='[SF account phone - whatsapp delivered (copy)_661536603319775251]' role='measure' type='quantitative'>
