  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Group by' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain Tiers&quot;'>
        <calculation class='tableau' formula='&quot;Chain Tiers&quot;' />
        <members>
          <member value='&quot;Country&quot;' />
          <member value='&quot;Chain Tiers&quot;' />
