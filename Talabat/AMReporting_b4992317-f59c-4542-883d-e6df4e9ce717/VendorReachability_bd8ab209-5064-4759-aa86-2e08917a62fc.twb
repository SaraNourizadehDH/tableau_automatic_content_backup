    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.0txybe007qydjz17koj991jkri16' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1nwxz6y1s6ajhn13u2yfc0gby21l'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='andria.sunny@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nwxz6y1s6ajhn13u2yfc0gby21l' name='Custom SQL Query' type='text'><![CDATA[with   
activity as   
(
  select 
  *
  from  
  (
  select 
  vendor_id,
  sum(successful_order_count) as orders ,
  sum(gmv_amount_eur) as gmv_eur 
  from
  `tlb-data-prod.data_platform.agg_vendor_wallet_share_monthly` 
  where snapshot_month >>= date_trunc(current_date, month)  - interval '3'month
  group by all 
  )
  where orders >> 0 
),
tiers as   
(
select
distinct 
date as month,
v.chain_id,
vendor_id,
ifnull(chain_monetisation_tiers,"Tier E") as chain_monetisation_tiers
  
from `tlb-data-prod.data_platform.agg_chain_tiers` t 
join `tlb-data-prod.data_platform.dim_vendor_info` v on v.chain_id = t.chain_id 
where 1=1
and date = date_trunc(current_date,month)
group by 1,2,3,4
order by 1 desc
),

reachability_base as   
(
  select 
  *
  from  
  `tlb-data-prod.data_platform_partner_engagement.stg_partner_contact_profile_enriched`
),

phone_email_status as  
( 
select 
case 
when sf_account_with_no = 0 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 0 then "No contact number"
when sf_account_with_no = 0 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 1 then "No account or owner  number - has vp number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 0 then "No account or vp  number - has owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 0 then "No owner or vp  number - has account number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 0 then "No vp  number - has account and owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 1 then "No owner number - has account and vp number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 1 then "No account  number - has vp and owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 1 then "has all numbers"
else "others"end as phone_number_status,
 
case 
when sf_account_with_no = 0 and  sf_contact_with_no = 0 then "No SF Account or Owner number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 then "No SF Account number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 then "No SF Owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 then "Has SF Account and Owner number"
else "others"end as SF_phone_number_status,

case 
when sf_account_with_int_email = 1 then "internal account email"
when sf_contact_with_int_email = 1 then "internal owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 0 then "No email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 1 then "No account or owner  email - has vp email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 0 then "No account or vp  email - has owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 0 then "No owner or vp  email - has account email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 0 then "No vp  email - has account and owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 1 then "No owner email - has account and vp email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 1 then "No account  email - has vp and owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 1 then "has all emails"
else "others"end as email_status,

case 
when sf_account_with_int_email = 1 then "internal account email"
when sf_contact_with_int_email = 1 then "internal owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 then "No SF Account and Owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 then "No SF Account email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 then "No SF Owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 then "Has SF Account and Owner email"
else "others"end as SF_email_status,

salesforce_id,
count(distinct salesforce_id) as vendors

from
(
select 
v.salesforce_id,

count(distinct case when contact_source = "salesforce_account" and email is not null then ri.salesforce_id end  ) as sf_account_with_email,
count(distinct case when contact_source = "salesforce_contact" and email is not null then ri.salesforce_id end  ) as sf_contact_with_email,
count(distinct case when contact_source = "vp_users" and email is not null then ri.salesforce_id end  ) as vp_users_contact_with_email,

count(distinct case when contact_source = "salesforce_account" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as sf_account_with_int_email,
count(distinct case when contact_source = "salesforce_contact" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as sf_contact_with_int_email,
count(distinct case when contact_source = "vp_users" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as vp_users_contact_with_int_email,

count(distinct case when contact_source = "salesforce_account" and number is not null then ri.salesforce_id end  ) as sf_account_with_no,
count(distinct case when contact_source = "salesforce_contact" and number is not null then ri.salesforce_id end  ) as sf_contact_with_no,
count(distinct case when contact_source = "vp_users" and number is not null then ri.salesforce_id end  ) as vp_users_contact_with_no,


from   reachability_base ri
join `tlb-data-prod.data_platform.dim_vendor_info` v on ri.salesforce_id = v.salesforce_id 
join activity  vws on vws.vendor_id = v.vendor_id 

where 1=1 -- vertical = "Restaurant" --and status = "Active" and grid_type = "Branch - Main"
and is_non_food = false 
and is_contract_active = true 
group by all
)
group by all 
),

final_agg as    
(
select
*,

greatest(IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01"))) as app_recent_login_timestamp,
greatest(IFNULL(SAFE_CAST(recent_web_session_time_at AS DATE),DATE("1999-01-01")) ,IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),
IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01"))) as vp_or_app_recent_login_timestamp,
case when date_trunc(date(greatest(recent_ios_session_time_at,recent_android_session_time_at)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as recent_app_login_within_l6m,
case when date_trunc(date(coalesce(recent_web_session_time_at)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as recent_vp_login_within_l6m,
case when date_trunc(date(coalesce(sf_contact_recent_whatsapp)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_contact_recent_whatsapp_within_l6m,
case when date_trunc(date(coalesce(sf_account_recent_whatsapp)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_account_recent_whatsapp_within_l6m,
case when date_trunc(date(coalesce(sf_account_recent_email)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_account_recent_email_within_l6m,
case when date_trunc(date(coalesce(sf_contact_recent_email)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_contact_recent_email_within_l6m,

case when SF_email_status = "Has SF Account and Owner email" then true else false end as has_all_emails,
case when SF_phone_number_status = "Has SF Account and Owner number" then true else false end as has_all_numbers,
case when date_trunc(date(greatest(IFNULL(SAFE_CAST(recent_web_session_time_at AS DATE),DATE("1999-01-01")) ,IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01")))),month) =  date_trunc(date(current_date),month ) then true else false end as app_vp_login_this_month


from  
(

select 
v.vendor_id,
v.vendor_name,
v.salesforce_id,
v.country_code,
ri.global_entity_id,
chain_monetisation_tiers,
date(first_online_date) as first_online_date,
account_manager_name,
team_leader_name,
account_manager_email,
team_leader_email,
is_managed_by_vendor_helpdesk,
orders,
gmv_eur,
STRING_AGG(distinct (case when contact_source = "salesforce_account"  then ri.number end), ", ") AS sf_account_phone_no,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then ri.number end), ", ") AS sf_contact_phone_no,
STRING_AGG(distinct(case when contact_source = "vp_users"  then ri.number end), ", ") AS vp_contact_phone_no,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then ri.email end), ", ") AS sf_account_email,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then ri.email end), ", ") AS sf_contact_email,
STRING_AGG(distinct(case when contact_source = "vp_users"  then ri.email end), ", ") AS vp_contact_email,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then safe_cast(is_internal_email as string)  end), ", ") AS sf_account_internal_email,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then  safe_cast(is_internal_email as string)  end), ", ") AS sf_contact_internal_email,
STRING_AGG(distinct(case when contact_source = "vp_users"  then  safe_cast(is_internal_email as string)  end), ", ") AS vp_contact_internal_email,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS sf_account_email_hard_bounced,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS sf_contact_email_hard_bounced,
STRING_AGG(distinct(case when contact_source = "vp_users"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS 
vp_contact_email_hard_bounced,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_web_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_web_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_web_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_ios_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_ios_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_ios_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_android_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_android_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_android_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS vp_contact_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_contact_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_account"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_account"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_account_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_account"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_account"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_account_recent_email,

array_AGG((case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_contact_recent_email,

STRING_AGG(distinct(case when contact_source = "vp_users"  then safe_cast(date(recent_email_delivery_time_at ) as string)  end), ", ") AS 
vp_contact_recent_email,


phone_number_status,
email_status,
SF_phone_number_status,
SF_email_status,
is_tgo

from 
reachability_base  ri 
join `tlb-data-prod.data_platform.dim_vendor_info` v on ri.salesforce_id = v.salesforce_id 
join activity  vws on vws.vendor_id = v.vendor_id 
left join phone_email_status pe on pe.salesforce_id = v.salesforce_id
left join tiers t on t.vendor_id = v.vendor_id 
where 1=1 -- and  ri.salesforce_id  = "4O0P8G"
and lower(country_code) <<>> "sa"
and is_non_food = false 
and is_contract_active = true 
group by all
)
)

select 
*,
case when has_all_emails is true and has_all_numbers is true and app_vp_login_this_month is true then true else false end  as is_reachable_vendor,

from final_agg]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1nwxz6y1s6ajhn13u2yfc0gby21l' name='Custom SQL Query' type='text'><![CDATA[with   
activity as   
(
  select 
  *
  from  
  (
  select 
  vendor_id,
  sum(successful_order_count) as orders ,
  sum(gmv_amount_eur) as gmv_eur 
  from
  `tlb-data-prod.data_platform.agg_vendor_wallet_share_monthly` 
  where snapshot_month >>= date_trunc(current_date, month)  - interval '3'month
  group by all 
  )
  where orders >> 0 
),
tiers as   
(
select
distinct 
date as month,
v.chain_id,
vendor_id,
ifnull(chain_monetisation_tiers,"Tier E") as chain_monetisation_tiers
  
from `tlb-data-prod.data_platform.agg_chain_tiers` t 
join `tlb-data-prod.data_platform.dim_vendor_info` v on v.chain_id = t.chain_id 
where 1=1
and date = date_trunc(current_date,month)
group by 1,2,3,4
order by 1 desc
),

reachability_base as   
(
  select 
  *
  from  
  `tlb-data-prod.data_platform_partner_engagement.stg_partner_contact_profile_enriched`
),

phone_email_status as  
( 
select 
case 
when sf_account_with_no = 0 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 0 then "No contact number"
when sf_account_with_no = 0 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 1 then "No account or owner  number - has vp number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 0 then "No account or vp  number - has owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 0 then "No owner or vp  number - has account number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 0 then "No vp  number - has account and owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 and vp_users_contact_with_no = 1 then "No owner number - has account and vp number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 1 then "No account  number - has vp and owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 and vp_users_contact_with_no = 1 then "has all numbers"
else "others"end as phone_number_status,
 
case 
when sf_account_with_no = 0 and  sf_contact_with_no = 0 then "No SF Account or Owner number"
when sf_account_with_no = 0 and  sf_contact_with_no = 1 then "No SF Account number"
when sf_account_with_no = 1 and  sf_contact_with_no = 0 then "No SF Owner number"
when sf_account_with_no = 1 and  sf_contact_with_no = 1 then "Has SF Account and Owner number"
else "others"end as SF_phone_number_status,

case 
when sf_account_with_int_email = 1 then "internal account email"
when sf_contact_with_int_email = 1 then "internal owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 0 then "No email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 1 then "No account or owner  email - has vp email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 0 then "No account or vp  email - has owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 0 then "No owner or vp  email - has account email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 0 then "No vp  email - has account and owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 and vp_users_contact_with_email = 1 then "No owner email - has account and vp email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 1 then "No account  email - has vp and owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 and vp_users_contact_with_email = 1 then "has all emails"
else "others"end as email_status,

case 
when sf_account_with_int_email = 1 then "internal account email"
when sf_contact_with_int_email = 1 then "internal owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 0 then "No SF Account and Owner email"
when sf_account_with_email = 0 and  sf_contact_with_email = 1 then "No SF Account email"
when sf_account_with_email = 1 and  sf_contact_with_email = 0 then "No SF Owner email"
when sf_account_with_email = 1 and  sf_contact_with_email = 1 then "Has SF Account and Owner email"
else "others"end as SF_email_status,

salesforce_id,
count(distinct salesforce_id) as vendors

from
(
select 
v.salesforce_id,

count(distinct case when contact_source = "salesforce_account" and email is not null then ri.salesforce_id end  ) as sf_account_with_email,
count(distinct case when contact_source = "salesforce_contact" and email is not null then ri.salesforce_id end  ) as sf_contact_with_email,
count(distinct case when contact_source = "vp_users" and email is not null then ri.salesforce_id end  ) as vp_users_contact_with_email,

count(distinct case when contact_source = "salesforce_account" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as sf_account_with_int_email,
count(distinct case when contact_source = "salesforce_contact" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as sf_contact_with_int_email,
count(distinct case when contact_source = "vp_users" and is_internal_email is true  and email is not null then ri.salesforce_id end  ) as vp_users_contact_with_int_email,

count(distinct case when contact_source = "salesforce_account" and number is not null then ri.salesforce_id end  ) as sf_account_with_no,
count(distinct case when contact_source = "salesforce_contact" and number is not null then ri.salesforce_id end  ) as sf_contact_with_no,
count(distinct case when contact_source = "vp_users" and number is not null then ri.salesforce_id end  ) as vp_users_contact_with_no,


from   reachability_base ri
join `tlb-data-prod.data_platform.dim_vendor_info` v on ri.salesforce_id = v.salesforce_id 
join activity  vws on vws.vendor_id = v.vendor_id 

where 1=1 -- vertical = "Restaurant" --and status = "Active" and grid_type = "Branch - Main"
and is_non_food = false 
and is_contract_active = true 
group by all
)
group by all 
),

final_agg as    
(
select
*,

greatest(IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01"))) as app_recent_login_timestamp,
greatest(IFNULL(SAFE_CAST(recent_web_session_time_at AS DATE),DATE("1999-01-01")) ,IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),
IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01"))) as vp_or_app_recent_login_timestamp,
case when date_trunc(date(greatest(recent_ios_session_time_at,recent_android_session_time_at)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as recent_app_login_within_l6m,
case when date_trunc(date(coalesce(recent_web_session_time_at)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as recent_vp_login_within_l6m,
case when date_trunc(date(coalesce(sf_contact_recent_whatsapp)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_contact_recent_whatsapp_within_l6m,
case when date_trunc(date(coalesce(sf_account_recent_whatsapp)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_account_recent_whatsapp_within_l6m,
case when date_trunc(date(coalesce(sf_account_recent_email)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_account_recent_email_within_l6m,
case when date_trunc(date(coalesce(sf_contact_recent_email)),month) >>=   date_trunc(current_date, month)  - interval '6'month then true else false end as sf_contact_recent_email_within_l6m,

case when SF_email_status = "Has SF Account and Owner email" then true else false end as has_all_emails,
case when SF_phone_number_status = "Has SF Account and Owner number" then true else false end as has_all_numbers,
case when date_trunc(date(greatest(IFNULL(SAFE_CAST(recent_web_session_time_at AS DATE),DATE("1999-01-01")) ,IFNULL(SAFE_CAST(recent_ios_session_time_at AS DATE),DATE("1999-01-01")),IFNULL(SAFE_CAST(recent_android_session_time_at AS DATE),DATE("1999-01-01")))),month) =  date_trunc(date(current_date),month ) then true else false end as app_vp_login_this_month


from  
(

select 
v.vendor_id,
v.vendor_name,
v.salesforce_id,
v.country_code,
ri.global_entity_id,
chain_monetisation_tiers,
date(first_online_date) as first_online_date,
account_manager_name,
team_leader_name,
account_manager_email,
team_leader_email,
is_managed_by_vendor_helpdesk,
orders,
gmv_eur,
STRING_AGG(distinct (case when contact_source = "salesforce_account"  then ri.number end), ", ") AS sf_account_phone_no,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then ri.number end), ", ") AS sf_contact_phone_no,
STRING_AGG(distinct(case when contact_source = "vp_users"  then ri.number end), ", ") AS vp_contact_phone_no,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then ri.email end), ", ") AS sf_account_email,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then ri.email end), ", ") AS sf_contact_email,
STRING_AGG(distinct(case when contact_source = "vp_users"  then ri.email end), ", ") AS vp_contact_email,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then safe_cast(is_internal_email as string)  end), ", ") AS sf_account_internal_email,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then  safe_cast(is_internal_email as string)  end), ", ") AS sf_contact_internal_email,
STRING_AGG(distinct(case when contact_source = "vp_users"  then  safe_cast(is_internal_email as string)  end), ", ") AS vp_contact_internal_email,

STRING_AGG(distinct(case when contact_source = "salesforce_account"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS sf_account_email_hard_bounced,
STRING_AGG(distinct(case when contact_source = "salesforce_contact"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS sf_contact_email_hard_bounced,
STRING_AGG(distinct(case when contact_source = "vp_users"  then safe_cast(is_email_hard_bounce as string)  end), ", ") AS 
vp_contact_email_hard_bounced,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_web_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_web_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_web_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_ios_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_ios_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_ios_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_android_session_time_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_android_session_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS recent_android_session_time_at,

array_AGG((case when contact_source = "vp_users"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "vp_users"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS vp_contact_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_contact_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_account"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_account"  then  safe_cast(date(recent_whatsapp_delivered_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_account_recent_whatsapp,

array_AGG((case when contact_source = "salesforce_account"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_account"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_account_recent_email,

array_AGG((case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )  ORDER BY 
(case when contact_source = "salesforce_contact"  then  safe_cast(date(recent_email_delivery_time_at) as string) end )   DESC LIMIT 1)[OFFSET(0)] AS sf_contact_recent_email,

STRING_AGG(distinct(case when contact_source = "vp_users"  then safe_cast(date(recent_email_delivery_time_at ) as string)  end), ", ") AS 
vp_contact_recent_email,


phone_number_status,
email_status,
SF_phone_number_status,
SF_email_status,
is_tgo

from 
reachability_base  ri 
join `tlb-data-prod.data_platform.dim_vendor_info` v on ri.salesforce_id = v.salesforce_id 
join activity  vws on vws.vendor_id = v.vendor_id 
left join phone_email_status pe on pe.salesforce_id = v.salesforce_id
left join tiers t on t.vendor_id = v.vendor_id 
where 1=1 -- and  ri.salesforce_id  = "4O0P8G"
and lower(country_code) <<>> "sa"
and is_non_food = false 
and is_contract_active = true 
group by all
)
)

select 
*,
case when has_all_emails is true and has_all_numbers is true and app_vp_login_this_month is true then true else false end  as is_reachable_vendor,

from final_agg]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
