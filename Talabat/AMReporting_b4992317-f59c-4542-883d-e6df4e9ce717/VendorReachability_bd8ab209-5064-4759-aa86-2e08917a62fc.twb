  <repository-location derived-from='http://ip-172-31-0-213:8352/t/Talabat/workbooks/VendorReachability?rev=1.4' id='VendorReachability' path='/t/Talabat/workbooks' revision='1.5' site='Talabat' />
  <preferences />
