      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_229F79FF4A5E4684BFB5C3E538514D20'>
            <properties context=''>
              <relation connection='bigquery.0iifvhx0h4jhzm151biwo0ms0545' name='Custom SQL Query' type='text'>SELECT date,&#13;
  country_code,&#13;
  vertical,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(0)] AS screen_type,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(1)] AS screen_name,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(2)] AS component_type,&#13;
  SPLIT(placement, &apos;.&apos;)[SAFE_OFFSET(3)] AS component_name,&#13;
  SUM(cpc_revenue_eur) AS cpc_revenue_eur,&#13;
  SUM(cpc_revenue_lc) AS cpc_revenue_lc,&#13;
  SUM(gem_revenue_eur) AS gem_revenue_eur,&#13;
  SUM(gem_revenue_lc) AS gem_revenue_lc,&#13;
  SUM(displayads_revenue_eur) AS displayads_revenue_eur,&#13;
  SUM(displayads_revenue_lc) AS displayads_revenue_lc,&#13;
  SUM(cpc_revenue_eur + gem_revenue_eur + displayads_revenue_eur) AS total_revenue_eur,&#13;
  SUM(cpc_revenue_lc + gem_revenue_lc + displayads_revenue_lc) AS total_revenue_lc&#13;
&#13;
from tlb-data-prod.data_platform.fct_adex_component_metrics&#13;
where 1=1&#13;
and date &gt;&gt;= &apos;2025-01-01&apos;&#13;
group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
