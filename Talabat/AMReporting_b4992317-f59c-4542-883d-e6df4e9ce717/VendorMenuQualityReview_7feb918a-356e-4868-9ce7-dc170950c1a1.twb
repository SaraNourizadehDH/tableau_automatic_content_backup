              <calculation class='tableau' formula='IF [DLP_may] = 0 THEN&#10;    &apos;Dish Photo 0%&apos;&#10;ELSEIF [DLP_may] &lt; 0.9 THEN&#10;    &apos;Dish Photo &lt;90%&apos;&#10;ELSE&#10;    &apos;Dish Photo &gt;90%&apos;&#10;END' />
            </column>
            <column caption='DLD Filter' datatype='string' name='[Calculation_2350245725939916802]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [DLD_may] = 0 THEN&#10;    &apos;Dish Description 0%&apos;&#10;ELSEIF [DLD_may] &lt; 0.9 THEN&#10;    &apos;Dish Description &lt;90%&apos;&#10;ELSE&#10;    &apos;Dish Description &gt;90%&apos;&#10;END' />
