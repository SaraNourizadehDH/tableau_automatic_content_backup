      <table>
        <view>
          <datasources>
            <datasource caption='All Vendors' name='federated.0ezlzcp12xeb901b2gnp90zjtac3' />
          </datasources>
          <datasource-dependencies datasource='federated.0ezlzcp12xeb901b2gnp90zjtac3'>
            <column caption='DLP Filter' datatype='string' name='[Calculation_2350245725938589697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [DLP_may] = 0 THEN&#10;    &apos;Dish Photo 0%&apos;&#10;ELSEIF [DLP_may] &lt; 0.9 THEN&#10;    &apos;Dish Photo &lt;90%&apos;&#10;ELSE&#10;    &apos;Dish Photo &gt;90%&apos;&#10;END' />
            </column>
            <column aggregation='Sum' caption='DLP' datatype='real' name='[DLP_may]' role='dimension' type='ordinal' />
