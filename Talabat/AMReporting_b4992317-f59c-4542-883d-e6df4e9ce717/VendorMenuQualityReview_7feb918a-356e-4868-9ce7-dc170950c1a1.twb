      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='All vendors' id='_D16BA148E93B4E3A9791BAFB26D105CC'>
            <properties context=''>
              <relation connection='bigquery.03bwy491dn0n211acexg60nly0ox' name='Custom SQL Query' type='text'><![CDATA[WITH vendors AS (
    SELECT
        v.vendor_id,
        v.salesforce_id,
        v.vendor_name,
        v.first_online_date,
        c.chain_id,
        c.chain_name,
        c.country_code,
        a.account_status__c,
        v.account_manager_email,
        v.account_manager_name,
        c.vertical,
        a.vertical__c,
        a.vertical_segment__c,
        c.main_cuisine
    FROM `tlb-data-prod.data_platform.dim_vendor_info` v
    JOIN `tlb-data-prod.data_platform.dim_chain` c
        ON v.chain_id = c.chain_id
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
        ON v.salesforce_id = a.grid__c
    WHERE 
    LOWER(c.vertical) = 'food'
    --AND a.account_status__c = 'Active'
    --AND   LOWER(v.account_manager_name) IN ('amr el eraki')
    --AND v.vendor_id IN (744035)
    --AND v.salesforce_id IN ()
    --AND c.country_code IN ('OM','QA')
    --AND c.main_cuisine != 'charity'
),
chain_monetization AS (
    SELECT chain_id,
        chain_monetisation_tiers
    FROM `tlb-data-prod.data_platform.agg_chain_tiers`
    WHERE DATE_TRUNC(date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)
),
user_data AS (
    SELECT DISTINCT
        CONCAT(u.firstname, ' ', u.lastname) AS owner_name,
        u.email,
        CASE
            WHEN LOWER(CONCAT(u.firstname, ' ', u.lastname)) IN (
                'hadeer ahmed', 'manar tarek', 'zeinab nageh', 'bahy el-orabi',
                'abdallah aly', 'amr el eraki', 'yehia othman', 'rana rizk',
                'mostafa soliman', 'raghdah bahaa', 'ali hamada', 'ahmed farag',
                'mohamed hesham', 'razan elfeky', 'shorouq masoud',
                'abdelrahman mansour', 'mariam shawky', 'yasser housney',
                'ibrahim mohamed', 'amany hussien', 'mostafa mohamed',
                'osman el deeb', "afia'a abu smaiha", 'wafa bany ersheed',
                'suha al-maani', 'ghaith jadallah', 'ayham alsaber',
                'aya ahmed saaed', 'hanna tarek', 'omar abdelhady', 'aya fouad', 'alia mawloud',
                'waleed abualhayja'
            ) THEN "Launch pad"
            ELSE u.title
        END AS title
    FROM `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
    WHERE u.isactive = TRUE
),
vendors_with_titles AS (
    SELECT
        v.vendor_id,
        v.salesforce_id,
        v.vendor_name,
        v.first_online_date,
        v.chain_id,
        v.chain_name,
        v.country_code,
        v.account_status__c,
        v.account_manager_name,
        v.vertical,
        v.main_cuisine,
        v.vertical__c,
        v.vertical_segment__c,
        COALESCE(ud.title, "Others") AS title,
        CASE
            WHEN COALESCE(ud.title, "Others") = "Launch pad" THEN "Launch pad"
            WHEN COALESCE(ud.title, "Others") IN ("Account Manager", "Sr. Account Manager","Senior Account Manager") THEN "Account Manager"
            WHEN COALESCE(ud.title, "Others") IN ("Key Account Manager", "Sr. Key Account Manager") THEN "Key Account Manager"
            WHEN COALESCE(ud.title, "Others") IN ("Online Account Manager", "Online Account Manager II") THEN "Online Account Manager"
            WHEN COALESCE(ud.title, "Others") IN ("Associate Team Lead Account Management", "Team Lead Account Management", 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain', "Assistant Team Lead Account Management") THEN "Team Lead"
            WHEN COALESCE(ud.title, "Others") IN ("City Head - Sales", "City Head II - Sales", "Head of Account Management", "Head of Key Account Management", "Associate City Head - Sales", "Head of Sales") THEN "Heads"
            ELSE "Others"
        END AS title_group
    FROM vendors v
    LEFT JOIN user_data ud
        ON v.account_manager_email = ud.email
),
orders_data AS (
    SELECT
        v.vendor_id,
        DATE_TRUNC(o.order_date, MONTH) AS order_month,
        COUNT(DISTINCT o.order_id) AS total_orders,
        SUM(gmv_amount_lc) AS total_gmv
    FROM vendors_with_titles v
    JOIN `tlb-data-prod.data_platform.fct_order_info` o
        ON v.vendor_id = o.vendor_id
    WHERE o.is_successful = TRUE
        AND DATE_TRUNC(o.order_date, MONTH) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 24 MONTH), MONTH)
        AND DATE_TRUNC(o.order_date, MONTH) =  DATE_TRUNC(CURRENT_DATE(), MONTH)
    GROUP BY v.vendor_id, order_month
),
vendors_after_sept AS (
    SELECT DISTINCT vendor_id
    FROM orders_data
    WHERE order_month = DATE_TRUNC(CURRENT_DATE(), MONTH)
),
last_order_month AS (
    SELECT
        vendor_id,
        MAX(DATE_TRUNC(order_date, MONTH)) AS last_order_month
    FROM `tlb-data-prod.data_platform.fct_order_info`
    WHERE is_successful = TRUE
    GROUP BY vendor_id
),
first_order_dates AS (
    SELECT
        vendor_id,
        MIN(order_date) AS first_order_date
    FROM `tlb-data-prod.data_platform.fct_order_info`
    WHERE is_successful = TRUE
    GROUP BY vendor_id
),
offline_time AS (
    SELECT
        vendor_id,
        date_month,
        offline_duration_seconds,
        actual_duration_in_seconds,
        items_with_description_count,
        items_with_images_count,
        active_menu_items_count,
        SAFE_DIVIDE(items_with_description_count, active_menu_items_count) AS DLD,
        SAFE_DIVIDE(items_with_images_count, active_menu_items_count) AS DLP,
        SAFE_DIVIDE(offline_duration_seconds, actual_duration_in_seconds) AS offline_time
    FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly`
    WHERE date_month = '2025-06-01'
),


savings AS (
    SELECT
        vendor_id,
        SUM(CASE WHEN date_month = '2025-01-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_jan_25,
        SUM(CASE WHEN date_month = '2025-02-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_feb_25,
        SUM(CASE WHEN date_month = '2025-03-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_mar_25,
        SUM(CASE WHEN date_month = '2025-04-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_apr_25,
        SUM(CASE WHEN date_month = '2025-05-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_may_25,
        SUM(CASE WHEN date_month = '2025-06-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_jun_25,
        SUM(CASE WHEN date_month = '2025-07-01' THEN vendor_funded_saving_amount_lc ELSE 0 END) AS savings_jul_25
    FROM `tlb-data-prod.data_platform.agg_account_manager_performance_monthly`
    WHERE date_month >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 24 MONTH), MONTH)
        AND date_month <<= '2025-07-01'
    GROUP BY vendor_id
),
menu_sessions AS (
    SELECT
        vendor_id,
        DATE_TRUNC(date, MONTH) AS Month,
        COUNT(DISTINCT session_id) AS menu_sessions_mtd
    FROM `tlb-data-prod.data_platform.fct_sub_session_menu`
    WHERE DATE_TRUNC(date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)
    GROUP BY vendor_id, 2
),
menu_sessions_feb AS (
    SELECT
        vendor_id,
        COUNT(DISTINCT session_id) AS menu_sessions_lmtd
    FROM `tlb-data-prod.data_platform.fct_sub_session_menu`
    WHERE DATE(date) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
                         AND DATE(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))
    GROUP BY vendor_id
),
vendor_closures AS (
    SELECT
        v.salesforce_id,
        v.vendor_id,
        MAX(o.closedate) AS closedate
    FROM `tlb-data-prod.data_platform.dim_vendor_info` v
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l ON l.location_id = v.location_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` w ON w.chain_id = v.chain_id
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a ON v.salesforce_id = a.grid__c
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c ON a.id = c.accountid
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o ON a.id = o.accountid
    WHERE o.business_type__c IN ('New Business', 'Win Back', 'Franchise Extension')
        AND o.stagename = 'Closed Won'
        AND c.status = 'Activated'
        AND c.name__c IN (
            'TGO Basic Commission', 'TMP Basic Commission', 'TGO Basic Commission SSU', 'TGO Basic Commision', 'OD Basic Commission',
            'MP Basic Commission', 'TGO Basic Commission N', 'TGO Basic commission', 'S01- Growth Package TGO Commission',
            'B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission', 'B01 Standard Package TGO Commission',
            'BH S01 - Growth Package TGO Commission', 'BH B01 - Standard Package TGO Commission', 'OD Basic Commission trial',
            'OM B01 - Standard Package (Restaurant) Commission OD', 'OM S01 - Growth Package (Restaurant) Commission OD',
            'S01 Growth Package TGO Commission', 'TGO Service Fee SSU', 'OD Service Fee', 'TGO Service Fee',
            'Fixed amount Per Order', 'Fix Amount Per Order', 'TGO Aggregated GMV Commission'
        )
    GROUP BY 1,2
)
SELECT
    v.vendor_id,
    v.salesforce_id,
    v.vendor_name,
    v.chain_id,
    v.chain_name,
    chain_monetisation_tiers,
    v.country_code,
    v.account_status__c,
    v.account_manager_name,
    v.title,
    v.title_group,
    vc.closedate,
    v.first_online_date,
    fod.first_order_date,
    lom.last_order_month,
    COALESCE(CAST(vc.closedate AS DATE), CAST(v.first_online_date AS DATE), CAST(fod.first_order_date AS DATE)) AS final_close_date,

    -- Orders Month-Wise
    -- COALESCE(SUM(CASE WHEN order_month = '2024-05-01' THEN total_orders END), 0) AS orders_may_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-06-01' THEN total_orders END), 0) AS orders_jun_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-07-01' THEN total_orders END), 0) AS orders_jul_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-08-01' THEN total_orders END), 0) AS orders_aug_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-09-01' THEN total_orders END), 0) AS orders_sep_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-10-01' THEN total_orders END), 0) AS orders_oct_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-11-01' THEN total_orders END), 0) AS orders_Nov_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2024-12-01' THEN total_orders END), 0) AS orders_dec_24,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-01-01' THEN total_orders END), 0) AS orders_jan_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-02-01' THEN total_orders END), 0) AS orders_feb_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-03-01' THEN total_orders END), 0) AS orders_mar_25,
    --COALESCE(SUM(CASE WHEN order_month = '2025-04-01' THEN total_orders END), 0) AS orders_apr_25,
    --COALESCE(SUM(CASE WHEN order_month = '2025-05-01' THEN total_orders END), 0) AS orders_may_25,
    --COALESCE(SUM(CASE WHEN order_month = '2025-06-01' THEN total_orders END), 0) AS orders_jun_25,
    --COALESCE(SUM(CASE WHEN order_month = '2025-07-01' THEN total_orders END), 0) AS orders_jul_25,

 -- gmv Month-Wise
    --COALESCE(SUM(CASE WHEN order_month = '2025-01-01' THEN total_gmv END), 0) AS gmv_jan_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-02-01' THEN total_gmv END), 0) AS gmv_feb_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-03-01' THEN total_gmv END), 0) AS gmv_mar_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-04-01' THEN total_gmv END), 0) AS gmv_apr_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-05-01' THEN total_gmv END), 0) AS gmv_may_25,
    -- COALESCE(SUM(CASE WHEN order_month = '2025-06-01' THEN total_gmv END), 0) AS gmv_jun_25,


    -- Savings Month-Wise
    -- COALESCE(sv.savings_jan_25, 0) AS savings_jan_25,
    -- COALESCE(sv.savings_feb_25, 0) AS savings_feb_25,
    -- COALESCE(sv.savings_mar_25, 0) AS savings_mar_25,
    -- COALESCE(sv.savings_apr_25, 0) AS savings_apr_25,
    -- COALESCE(sv.savings_may_25, 0) AS savings_may_25,
    -- COALESCE(sv.savings_jun_25, 0) AS savings_jun_25,
    -- COALESCE(
    --     sv.savings_jan_25 + sv.savings_feb_25 + sv.savings_mar_25 + 
    --     sv.savings_apr_25 + sv.savings_may_25, 
    --     0
    -- ) AS total_savings_6m,

    -- Offline, DLD, DLP, Menu Sessions (As you already had)
    --COALESCE(ot.offline_duration_seconds, 0) AS offline_duration_seconds_mtd,
    --COALESCE(ot.actual_duration_in_seconds, 0) AS actual_duration_in_seconds_mtd,
    --COALESCE(ot.offline_time, 0) AS offline_time_mtd,
    COALESCE(ot.items_with_description_count, 0) AS items_with_description_count_march,
    COALESCE(ot.items_with_images_count, 0) AS items_with_images_count_mtd,
    COALESCE(ot.active_menu_items_count, 0) AS active_menu_items_count_mtd,
    COALESCE(ot.DLD, 0) AS DLD_may,
    COALESCE(ot.DLP, 0) AS DLP_may,
    COALESCE(ms.menu_sessions_mtd, 0) AS menu_sessions_mtd,
    COALESCE(msf.menu_sessions_lmtd, 0) AS menu_sessions_lmtd,

    -- Cohort Logic
    CASE
        WHEN lom.last_order_month IS NULL THEN 
            CASE 
                WHEN COALESCE(CAST(vc.closedate AS DATE), CAST(v.first_online_date AS DATE), CAST(fod.first_order_date AS DATE)) 
                     >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 2 MONTH) THEN 'New'
                ELSE 'Zombie'
            END
        WHEN lom.last_order_month = DATE_TRUNC(CURRENT_DATE(), MONTH) THEN 'Active'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) THEN 'M0'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) THEN 'M-1'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH), MONTH) THEN 'M-2'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH), MONTH) THEN 'M-3'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) THEN 'M-4'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), MONTH) THEN 'M-5'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) THEN 'M-6'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 8 MONTH), MONTH) THEN 'M-7'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 9 MONTH), MONTH) THEN 'M-8'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 10 MONTH), MONTH) THEN 'M-9'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 11 MONTH), MONTH) THEN 'M-10'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH) THEN 'M-11'
        WHEN lom.last_order_month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) THEN 'M-12'
        ELSE '>>M-12'
    END AS cohort,
    v.vertical,
    v.main_cuisine,
    v.vertical__c,
    v.vertical_segment__c,

    FROM vendors_with_titles v
  

LEFT JOIN orders_data o ON v.vendor_id = o.vendor_id
LEFT JOIN offline_time ot ON v.vendor_id = ot.vendor_id
LEFT JOIN savings sv ON v.vendor_id = sv.vendor_id
LEFT JOIN menu_sessions ms ON v.vendor_id = ms.vendor_id
LEFT JOIN menu_sessions_feb msf ON v.vendor_id = msf.vendor_id
LEFT JOIN chain_monetization cm ON v.chain_id = cm.chain_id
LEFT JOIN vendor_closures vc ON v.vendor_id = vc.vendor_id
LEFT JOIN first_order_dates fod ON v.vendor_id = fod.vendor_id
LEFT JOIN last_order_month lom ON v.vendor_id = lom.vendor_id

GROUP BY 
    v.vendor_id, v.salesforce_id, v.vendor_name, v.chain_id, v.chain_name, chain_monetisation_tiers,
    v.country_code, v.account_status__c, v.account_manager_name, v.title, v.title_group, vc.closedate,
    v.first_online_date, fod.first_order_date, lom.last_order_month, 
    ms.menu_sessions_mtd, msf.menu_sessions_lmtd,
    ot.offline_duration_seconds, ot.actual_duration_in_seconds, ot.offline_time,
    ot.items_with_description_count, ot.items_with_images_count, ot.active_menu_items_count,
    ot.DLD, ot.DLP, 
    sv.savings_jan_25, sv.savings_feb_25, sv.savings_mar_25, sv.savings_apr_25, sv.savings_may_25, sv.savings_jun_25,v.vertical,
    v.main_cuisine,v.vertical__c,
    v.vertical_segment__c]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
