            <column datatype='string' name='[cohort (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[cohort]' new-bin='true'>
                <bin default-name='true' value='&quot;&gt;M-12, M-10, M-11 and 4 more&quot;'>
                  <value>&quot;&gt;M-12&quot;</value>
