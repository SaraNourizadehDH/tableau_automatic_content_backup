      <column caption='Affordability Status (copy)' datatype='string' name='[Affordability Status (copy)_77687144225529870]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN &#10;//IF [Is More Affordable] = True then &apos;More Affordable&apos; &#10;//ELSEIF [Is Less Affordable] = True then &apos;Less Affordable&apos; &#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([is_more_affordable])} = True then &apos;More Affordable&apos; &#10;ELSEIF  { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([is_less_affordable])} = True then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;when &apos;Promos&apos; THEN &#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: AVG([paos_promo])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: AVG([paos_promo])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;WHEN &apos;Pricing&apos; then&#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_pricing])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_pricing])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;WHEN &apos;Fees&apos; then&#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_effective_fees])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_effective_fees])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;END' />
      </column>
      <column caption='Breakdown by (Not Overall)' datatype='boolean' name='[Breakdown by (Overall) (copy)_1699053395074969609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] != &apos;Overall&apos;' />
      </column>
      <column caption='Selected x Axis' datatype='real' name='[Calculation_1146588367962378240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &apos;PAOS Promo&apos; then [paos_promo]&#10;WHEN &apos;PAOS Effective Fees&apos; THEN [paos_effective_fees]&#10;WHEN &apos;PAOS Pricing&apos; THEN [paos_pricing]&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' default-format='p0.0%' name='[Calculation_1146588367977234433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;WHEN &apos;GMV at Risk&apos; THEN [Calculation_702561591857008647]&#10;WHEN &apos;Protected GMV&apos; THEN [Calculation_702561591857254408]&#10;WHEN &apos;Avg Basket Markup&apos; THEN [Calculation_702561591851298820]&#10;WHEN &apos;Non Compliant Vendors&apos; THEN [Calculation_702561591856345094]&#10;WHEN &apos;Matched GMV&apos; THEN [Calculation_702561591857561609]&#10;WHEN &apos;Effective Markup&apos; THEN [GMV at Risk (copy)_625015246083313664]&#10;WHEN &apos;Fake Deals&apos; THEN [GMV at Risk (copy)_625015246248452099]&#10;WHEN &apos;Misleading Deals&apos; THEN [Fake Deals (copy)_625015246248779780]&#10;&#10;END' />
      </column>
      <column caption='Affordability Status' datatype='string' name='[Calculation_1146588367992258562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[is_more_affordable] = True then &apos;More Affordable&apos; &#10;ELSEIF &#10;[is_less_affordable] = True then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END' />
      </column>
      <column caption='Count of Vendors' datatype='integer' name='[Calculation_1146588367993528323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([talabat_vendor_id])' />
      </column>
      <column caption='View by (Vendor)' datatype='boolean' name='[Calculation_1699053394909159424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 8] = &apos;Vendors&apos;' />
      </column>
      <column caption='Breakdown by' datatype='string' name='[Calculation_1699053395073507335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Overall&apos; then null&#10;WHEN &apos;Team Leader&apos; then [team_leader_name]&#10;WHEN &apos;Account Manager&apos; then [account_manager_name]&#10;END' />
      </column>
      <column caption='Breakdown by (Overall)' datatype='boolean' name='[Calculation_1699053395074183176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] = &apos;Overall&apos;' />
      </column>
      <column caption='Selected Metric (Filter)' datatype='boolean' name='[Calculation_2151242945163075584]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1146588367977234433] &lt; 1 and [Calculation_1146588367977234433] &gt; 0' />
      </column>
      <column caption='Index' datatype='boolean' name='[Calculation_2151242945171484677]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 10]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Order Markup' datatype='real' default-format='p0.00%' name='[Calculation_2263058864795971584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN &#10;&#10;SUM(&#10;ABS([paos_pricing]+ [paos_promo])&#10;* [order_count]) / SUM([gmv_amount_lc_sum])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(&#10;ABS( [paos_promo])&#10;* [order_count]) / SUM([gmv_amount_lc_sum])&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(&#10;ABS([paos_pricing])&#10;* [order_count]) / SUM([gmv_amount_lc_sum])&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(&#10;ABS([paos_effective_fees])&#10;* [order_count]) / SUM([gmv_amount_lc_sum])&#10;END' />
      </column>
      <column caption='default date' datatype='date' name='[Calculation_2263058864798707713]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF NOT [Calculation_5798243839381446662] THEN [reporting_date] END) }' />
      </column>
      <column caption='Remove Overall' datatype='boolean' name='[Calculation_5310377332466122752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[competitor_platform] != &apos;Overall&apos;' />
      </column>
      <column caption='Is Data Null' datatype='boolean' name='[Calculation_5798243839381446662]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL( [talabat_vendor_id] )' />
      </column>
      <column caption='Date Trend' datatype='datetime' name='[Calculation_59813435356545025]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Daily&apos; THEN [reporting_date]&#10;WHEN &apos;Last 7 days&apos; THEN [reporting_date]&#10;WHEN &apos;Last 30 days&apos; THEN [reporting_date]&#10;WHEN &apos;WTD&apos; THEN DATETRUNC(&apos;week&apos;, [reporting_date], &apos;monday&apos;)&#10;WHEN &apos;MTD&apos; THEN DATETRUNC(&apos;month&apos;, [reporting_date])&#10;WHEN &apos;YTD&apos; THEN DATETRUNC(&apos;year&apos;, [reporting_date])&#10;END' />
      </column>
      <column caption='Avg Basket Markup' datatype='real' default-format='p0.00%' name='[Calculation_702561591851298820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then ABS([paos_pricing]+ [paos_promo]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF  [paos_promo] &lt; 0 then ABS( [paos_promo]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_promo] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;WHEN &apos;Pricing&apos; then&#10;&#10;SUM(IF [paos_pricing] &lt; 0 then ABS([paos_pricing]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then ABS([paos_pricing]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;END' />
      </column>
      <column caption='Non Compliant Vendors' datatype='real' default-format='p0.0%' name='[Calculation_702561591856345094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF  [paos_promo] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;WHEN &apos;Fees&apos; then&#10;&#10;SUM(IF [paos_effective_fees] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;END' />
      </column>
      <column caption='GMV at Risk' datatype='real' default-format='p0.0%' name='[Calculation_702561591857008647]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF [paos_promo] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_effective_fees] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;END' />
      </column>
      <column caption='Protected GMV' datatype='real' default-format='p0.0%' name='[Calculation_702561591857254408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF [paos_promo] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_effective_fees] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;END' />
      </column>
      <column caption='Matched GMV' datatype='real' default-format='p0.0%' name='[Calculation_702561591857561609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chain_matched_gmv])/SUM([total_gmv])' />
      </column>
      <column caption='Highlight Scatterplot' datatype='string' name='[Calculation_77687144196722695]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5]&#10;WHEN &apos;Is Key Account&apos; THEN str([is_key_vip_account])&#10;WHEN &apos;Affordabillity Status&apos; THEN [Calculation_1146588367992258562]&#10;WHEN &apos;Is Exclusive&apos; THEN str([is_exclusive])&#10;WHEN &apos;Vendor Wallet Share&apos; then [vendor_wallet_share_tier]&#10;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_77687144199454729]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;With &quot; +&#10;left(str(([Calculation_1146588367993528323] / TOTAL([Calculation_1146588367993528323])) * 100),5)&#10;+ &quot;% &quot; + attr([Calculation_1146588367992258562]) + &quot; vendors being &quot; + LEFT(STR([Calculation_702561591851298820]*100),5) + &quot;% &quot;&#10;+ attr([Calculation_77687144201216010]) + &quot; on an average order, we are &quot; + attr([More/Less (copy)_77687144245256208]) + &quot; &quot; +&#10;left(str(SUM([gmv_amount_eur_sum]) / TOTAL(SUM([gmv_amount_eur_sum]))*100),5) + &quot; % of our GMV.&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='More/Less' datatype='string' name='[Calculation_77687144201216010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1146588367992258562] = &apos;Less Affordable&apos; then &apos;more expensive&apos;&#10;ELSEIF [Calculation_1146588367992258562] = &apos;More Affordable&apos; then &apos;cheaper&apos;&#10;END' />
      </column>
      <column caption='Vendor Circle Size' datatype='real' name='[Calculation_77687144227553295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_amount_eur_sum])&#10;WHEN &apos;Avg Orders Value&apos; then SUM([gmv_amount_eur_sum]) / SUM([order_count])&#10;WHEN &apos;Order Count&apos; then SUM([order_count])&#10;WHEN &apos;None&apos; then 0&#10;END' />
      </column>
      <column caption='hide null' datatype='boolean' name='[Calculation_852165542013165568]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Less Affordable' datatype='boolean' name='[Calculation_9077779125274824704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;[is_less_affordable]&#10;when &apos;Promos&apos; THEN&#10;IF [paos_promo] &lt; 0 THEN TRUE ELSE FALSE END&#10;WHEN &apos;Pricing&apos; then&#10;IF [paos_pricing] &lt; 0 THEN TRUE ELSE FALSE END&#10;WHEN &apos;Fees&apos; then&#10;IF [paos_effective_fees] &lt; 0 THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column caption='Date Range' datatype='string' name='[Date Range (copy)_4280249235572375553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='///// Selected Periods:&#10;if [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -6, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -29, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;&#10;///// Comparison Periods:&#10;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2] - 1&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -13, [Parameters].[Parameter 2]) &#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -59, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;), [Parameters].[Parameter 2]), DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;&#10;&#10;END' />
      </column>
      <column caption='Date Trend (filter)' datatype='boolean' name='[Date Trend (copy)_59813435358691330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Daily&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;Last 7 days&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;Last 30 days&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;WTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;week&apos;, -15, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;))&#10;WHEN &apos;MTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;month&apos;, -15, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;YTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;year&apos;, -15, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) )&#10;END' />
      </column>
      <column caption='Deal Type' datatype='string' name='[Deal_Type]' role='dimension' type='nominal' />
      <column caption='Effective MarkUp 2' datatype='real' default-format='p0.0%' name='[Effective MarkUp (copy)_2826501408140873728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([GMV at Risk (copy)_625015246083313664]) &#10;THEN LOOKUP([GMV at Risk (copy)_625015246083313664], -10) &#10;ELSE [GMV at Risk (copy)_625015246083313664]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Misleading Deals' datatype='real' default-format='p0.0%' name='[Fake Deals (copy)_625015246248779780]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='countd(if [Deal_Type]= &apos;Misleading Deals&apos; then [talabat_vendor_id] else null end)/ countd([talabat_vendor_id])' />
      </column>
      <column caption='Effective MarkUp' datatype='real' default-format='p0.0%' name='[GMV at Risk (copy)_625015246083313664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([marked_up_item_gmv])/sum([total_item_gmv])' />
      </column>
      <column caption='Repeat Offenders' datatype='boolean' default-format='p0.0%' name='[GMV at Risk (copy)_625015246092238850]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum(if [paos_pricing] &lt; 0 and [is_most_affordable_platform_with_branch_match] then 1 else 0 end) &gt; 1 then TRUE else FALSE end' />
      </column>
      <column caption='Fake Deals' datatype='real' default-format='p0.0%' name='[GMV at Risk (copy)_625015246248452099]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='countd(if [Deal_Type]= &apos;Fake Deals&apos; then [talabat_vendor_id] else null end)/ COUNTD([talabat_vendor_id])' />
      </column>
      <column caption='Collections' datatype='boolean' default-format='p0.0%' name='[GMV at Risk (copy)_625015246269628421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric Filter (copy)_625015246269898758]&#10;when &apos;Overall&apos; THEN&#10;TRUE&#10;when &apos;Any&apos; THEN&#10;IF [is_on_best_sellers] or [is_on_flash_sale] or[is_on_gem] or[is_on_super_saver] or [is_on_other] or [is_on_free_delivery] then TRUE else FALSE end&#10;when &apos;No Collections&apos; THEN&#10;IF [is_on_best_sellers]= FALSE and [is_on_flash_sale]=FALSE and [is_on_gem]=FALSE and [is_on_super_saver]=FALSE and [is_on_other] =FALSE and [is_on_free_delivery]=FALSE then TRUE else FALSE end&#10;when &apos;Best Sellers&apos; THEN &#10;IF [is_on_best_sellers] then TRUE else FALSE end&#10;when &apos;Gem&apos; THEN &#10;IF [is_on_gem]=TRUE then TRUE else FALSE end&#10;when &apos;Super Savers&apos; THEN &#10;IF [is_on_super_saver] then TRUE else FALSE end&#10;when &apos;Flash Sale&apos; THEN &#10;IF [is_on_flash_sale] then TRUE else FALSE end&#10;when &apos;Other&apos; THEN &#10;IF [is_on_other] then TRUE else FALSE end&#10;when &apos;Free Delivery&apos; THEN &#10;IF [is_on_free_delivery] then TRUE else FALSE end&#10;END' />
      </column>
      <column caption='Less Affordable Count' datatype='integer' name='[Less Affordable (copy)_625015246091468801]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;IF [paos_promo] + [paos_pricing] &lt; 0 THEN 1 ELSE 0 END&#10;when &apos;Promos&apos; THEN&#10;IF [paos_promo] &lt; 0 THEN 1 ELSE 0 END&#10;WHEN &apos;Pricing&apos; then&#10;IF [paos_pricing] &lt; 0 THEN 1 ELSE 0 END&#10;WHEN &apos;Fees&apos; then&#10;IF [paos_effective_fees] &lt; 0 THEN 1 ELSE 0 END&#10;END' />
      </column>
      <column caption='More/Less (copy)' datatype='string' name='[More/Less (copy)_77687144245256208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1146588367992258562] = &apos;Less Affordable&apos; then &apos;losing&apos;&#10;ELSEIF [Calculation_1146588367992258562] = &apos;More Affordable&apos; then &apos;protecting&apos;&#10;END' />
      </column>
      <column caption='at_risk_Order_count' datatype='integer' default-format='p0.0%' name='[Order_count (copy)_1446499968304160771]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='if [paos] &lt; 0 then [order_count] else 0 end' />
      </column>
      <column caption='Protected GMV Amount' datatype='real' default-format='p0.0%' name='[Protected GMV (copy)_1220405193248464898]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;if [paos_pricing]+ [paos_promo] &gt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;when &apos;Promos&apos; THEN&#10;if [paos_promo] &gt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;if [paos_pricing]&gt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;WHEN &apos;Fees&apos; then&#10;if [paos_effective_fees] &gt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;END' />
      </column>
      <column caption='At Risk GMV Amount ' datatype='real' name='[Protected GMV Amount (copy)_1220405193250525189]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;if [paos_pricing]+ [paos_promo] &lt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;when &apos;Promos&apos; THEN&#10;if [paos_promo] &lt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;if [paos_pricing]&lt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;WHEN &apos;Fees&apos; then&#10;if [paos_effective_fees] &lt; 0 then [gmv_amount_eur_sum] else 0 end&#10;&#10;END' />
      </column>
      <column caption='Selected y Axis' datatype='real' name='[Selected x Axis (copy)_77687144193310721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#10;CASE [y Axis] &#10;WHEN &apos;PAOS Pricing&apos; THEN [Paos Pricing]&#10;WHEN &apos;PAOS Promo&apos; then [Paos Promo]&#10;WHEN &apos;PAOS Effective Fees&apos; THEN [Paos Effective Fees]&#10;END&#10;*/&#10;&#10;CASE [Parameters].[x Axis (copy)_77687144192647168]  &#10;WHEN &apos;PAOS Promo&apos; then [paos_promo]&#10;WHEN &apos;PAOS Effective Fees&apos; THEN [paos_effective_fees]&#10;WHEN &apos;PAOS Pricing&apos; THEN [paos_pricing]&#10;END' />
      </column>
      <column caption='View by (Account Manager)' datatype='boolean' name='[View by (Vendor) (copy)_1699053394909790209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 8] = &apos;Account Manager&apos;' />
      </column>
