      <table>
        <view>
          <datasources>
            <datasource caption='affordability_dashboard_base____ (data_playground)' name='federated.0qxogvy00gttqi1cmqib70hq14i6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Window' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0qxogvy00gttqi1cmqib70hq14i6].[Calculation_2263058864798707713]' caption='Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-10#'>
              <calculation class='tableau' formula='#2024-09-10#' />
            </column>
            <column caption='Metric Filter' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxogvy00gttqi1cmqib70hq14i6'>
            <column caption='Affordability Status (copy)' datatype='string' name='[Affordability Status (copy)_77687144225529870]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN &#10;//IF [Is More Affordable] = True then &apos;More Affordable&apos; &#10;//ELSEIF [Is Less Affordable] = True then &apos;Less Affordable&apos; &#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([is_more_affordable])} = True then &apos;More Affordable&apos; &#10;ELSEIF  { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([is_less_affordable])} = True then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;when &apos;Promos&apos; THEN &#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: AVG([paos_promo])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: AVG([paos_promo])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;WHEN &apos;Pricing&apos; then&#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_pricing])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_pricing])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;&#10;WHEN &apos;Fees&apos; then&#10;IF { FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_effective_fees])} &gt; 0  then &apos;More Affordable&apos; &#10;ELSEIF &#10;{ FIXED [talabat_vendor_id], [competitor_platform], [Date Range (copy)_4280249235572375553]: MAX([paos_effective_fees])} &lt; 0 then &apos;Less Affordable&apos; &#10;ELSE &apos;Same&apos; END&#10;END' />
            </column>
