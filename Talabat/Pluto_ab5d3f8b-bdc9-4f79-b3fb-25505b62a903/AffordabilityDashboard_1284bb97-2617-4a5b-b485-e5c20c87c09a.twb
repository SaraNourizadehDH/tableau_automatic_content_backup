      <table>
        <view>
          <datasources>
            <datasource caption='affordability_dashboard_base____ (data_playground)' name='federated.0qxogvy00gttqi1cmqib70hq14i6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Window' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0qxogvy00gttqi1cmqib70hq14i6].[Calculation_2263058864798707713]' caption='Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-10#'>
              <calculation class='tableau' formula='#2024-09-10#' />
            </column>
            <column caption='Metric Filter' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxogvy00gttqi1cmqib70hq14i6'>
            <column caption='default date' datatype='date' name='[Calculation_2263058864798707713]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF NOT [Calculation_5798243839381446662] THEN [reporting_date] END) }' />
            </column>
            <column caption='Is Data Null' datatype='boolean' name='[Calculation_5798243839381446662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL( [talabat_vendor_id] )' />
            </column>
            <column caption='Avg Basket Markup' datatype='real' default-format='p0.00%' name='[Calculation_702561591851298820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then ABS([paos_pricing]+ [paos_promo]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF  [paos_promo] &lt; 0 then ABS( [paos_promo]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_promo] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;WHEN &apos;Pricing&apos; then&#10;&#10;SUM(IF [paos_pricing] &lt; 0 then ABS([paos_pricing]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then ABS([paos_pricing]) ELSE 0 END * [order_count])&#10;/SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_lc_sum] else 0 end)&#10;&#10;END' />
            </column>
            <column caption='Non Compliant Vendors' datatype='real' default-format='p0.0%' name='[Calculation_702561591856345094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF  [paos_promo] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;WHEN &apos;Fees&apos; then&#10;&#10;SUM(IF [paos_effective_fees] &lt; 0 then 1 ELSE 0 END)/count([talabat_vendor_id])&#10;&#10;END' />
            </column>
            <column caption='GMV at Risk' datatype='real' default-format='p0.0%' name='[Calculation_702561591857008647]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF [paos_promo] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_effective_fees] &lt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;END' />
            </column>
            <column caption='Protected GMV' datatype='real' default-format='p0.0%' name='[Calculation_702561591857254408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;SUM(IF [paos_pricing]+ [paos_promo] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;when &apos;Promos&apos; THEN &#10;SUM(IF [paos_promo] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Pricing&apos; then&#10;SUM(IF [paos_pricing] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;WHEN &apos;Fees&apos; then&#10;SUM(IF [paos_effective_fees] &gt; 0 then [gmv_amount_eur_sum] ELSE 0 END)/SUM([gmv_amount_eur_sum])&#10;&#10;END' />
            </column>
            <column caption='Matched GMV' datatype='real' default-format='p0.0%' name='[Calculation_702561591857561609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chain_matched_gmv])/SUM([total_gmv])' />
            </column>
            <column caption='hide null' datatype='boolean' name='[Calculation_852165542013165568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX()!= 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Less Affordable' datatype='boolean' name='[Calculation_9077779125274824704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;Overall&apos; THEN&#10;[is_less_affordable]&#10;when &apos;Promos&apos; THEN&#10;IF [paos_promo] &lt; 0 THEN TRUE ELSE FALSE END&#10;WHEN &apos;Pricing&apos; then&#10;IF [paos_pricing] &lt; 0 THEN TRUE ELSE FALSE END&#10;WHEN &apos;Fees&apos; then&#10;IF [paos_effective_fees] &lt; 0 THEN TRUE ELSE FALSE END&#10;END' />
            </column>
            <column caption='Date Range' datatype='string' name='[Date Range (copy)_4280249235572375553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='///// Selected Periods:&#10;if [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -6, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -29, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;&#10;///// Comparison Periods:&#10;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2] - 1&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -13, [Parameters].[Parameter 2]) &#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -59, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;), [Parameters].[Parameter 2]), DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;&#10;&#10;END' />
            </column>
            <column caption='Effective MarkUp' datatype='real' default-format='p0.0%' name='[GMV at Risk (copy)_625015246083313664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marked_up_item_gmv])/sum([total_item_gmv])' />
