      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tmart price index' id='_576FAC94295D4138A6E2292264C6B30A'>
            <properties context=''>
              <relation connection='bigquery.0ddsvs00ihs70519tyj380mq5dur' name='Custom SQL Query' type='text'>SELECT * FROM `tlb-data-prod.data_platform_pluto_preparation.pluto_mart_tmart_executive_dashboard_metrics_daily` WHERE reporting_date &gt;&gt; &quot;2023-06-01&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='_576FAC94295D4138A6E2292264C6B30A' table='[Extract].[_576FAC94295D4138A6E2292264C6B30A]' type='table' />
            </properties>
          </object>
          <object caption='Matched GMV' id='_EA07BBFC5B3A4E059646301BE74367A0'>
            <properties context=''>
              <relation connection='bigquery.0ddsvs00ihs70519tyj380mq5dur' name='Custom SQL Query1' type='text'>with gmv_l30d as
(select
   di.product_sku
 , dli.country_name
 , sum(foi.total_price_paid_net_eur) as item_gmv
from tlb-data-prod.data_platform.fct_order_item foi
inner join tlb-data-prod.data_platform.dim_item di
        on foi.item_id = di.item_id
inner join tlb-data-prod.data_platform.fct_order_info fodi
        on fodi.order_id = foi.order_id
inner join tlb-data-prod.data_platform.dim_vendor_info dvi
        on foi.vendor_id = dvi.vendor_id
       and dvi.is_darkstore
inner join tlb-data-prod.data_platform.dim_location_info dli
        on dvi.location_id = dli.location_id
where 1=1
  and foi.order_date between date_add(current_date, interval -30 day) and current_date
  and fodi.is_successful
  and foi.sold_quantity &gt;&gt; 0
  and foi.total_price_paid_net_eur is not null
  and dvi.is_darkstore
  and dvi.is_non_food
group by 1, 2
)


select
  nip.country_name
, if(nip.matched_flag, &apos;matched&apos;, &apos;not_matched&apos;) as matched_flag
, nip.platform_code_competitor
, nip.pluto_vendor_id_competitor
, sum(coalesce(gl.item_gmv, 0)) as item_gmv
from
(select
  country_name
, product_sku
, platform_code_competitor
, pluto_vendor_id_competitor
, max(is_item_match) as matched_flag
from tlb-data-prod.data_platform_pluto_preparation.pluto_mid_nfv_item_parity
where 1=1
  and platform_code_talabat = &apos;tmart&apos;
group by 1, 2, 3, 4
) nip
left join gmv_l30d gl
       on nip.product_sku = gl.product_sku
      and nip.country_name = gl.country_name
group by 1, 2, 3, 4</relation>
