            <column caption='% items of lower price' datatype='real' default-format='p0%' name='[Calculation_2846134245783310344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2846134245784702986])/sum([Calculation_2846134245783994377])' />
            </column>
            <column caption='Matched SKUs' datatype='real' name='[Calculation_2846134245783994377]' role='measure' type='quantitative'>
