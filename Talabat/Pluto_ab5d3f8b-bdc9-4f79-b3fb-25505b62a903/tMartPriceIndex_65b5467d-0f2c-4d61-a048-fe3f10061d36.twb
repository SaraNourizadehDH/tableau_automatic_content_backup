            </column>
            <column caption='Date Window' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column alias='% Difference vs. Previous Day' caption='Compare Against' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Previous Day&quot;'>
              <calculation class='tableau' formula='&quot;Previous Day&quot;' />
              <aliases>
                <alias key='&quot;Previous Day&quot;' value='% Difference vs. Previous Day' />
                <alias key='&quot;Previous Month&quot;' value='% Difference vs. Previous Month' />
                <alias key='&quot;Previous Week&quot;' value='% Difference vs. Previous Week' />
              </aliases>
