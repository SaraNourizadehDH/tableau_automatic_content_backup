      <table>
        <view>
          <datasources>
            <datasource caption='tMart Price Index' name='federated.03j6d2y0ttivug1bu54vq0i6ngrl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03j6d2y0ttivug1bu54vq0i6ngrl].[Calculation_3929038852728311813]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.03j6d2y0ttivug1bu54vq0i6ngrl].[reporting_date]' caption='Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
            <column alias='Item Category' caption='Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;item_category&quot;'>
              <calculation class='tableau' formula='&quot;item_category&quot;' />
              <aliases>
                <alias key='&quot;item_category&quot;' value='Item Category' />
                <alias key='&quot;item_role&quot;' value='Item Role' />
                <alias key='&quot;overall&quot;' value='Overall' />
              </aliases>
            </column>
            <column caption='Date Window' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column alias='% Difference vs. Previous Day' caption='Compare Against' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Previous Day&quot;'>
              <calculation class='tableau' formula='&quot;Previous Day&quot;' />
              <aliases>
                <alias key='&quot;Previous Day&quot;' value='% Difference vs. Previous Day' />
                <alias key='&quot;Previous Month&quot;' value='% Difference vs. Previous Month' />
                <alias key='&quot;Previous Week&quot;' value='% Difference vs. Previous Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03j6d2y0ttivug1bu54vq0i6ngrl'>
            <column caption='% items of higher price' datatype='real' default-format='p0%' name='[% items of lower price (copy)_2846134245784948747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Items of Lower Price (copy)_2846134245784961036])/sum([Calculation_2846134245783994377])' />
            </column>
            <column caption='% items of equal price' datatype='real' default-format='p0%' name='[% items of lower price (copy)_2846134245785341966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Items of Lower Price (copy)_2846134245785214989])/sum([Calculation_2846134245783994377])' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_2846134245369589760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reporting_date] = [Parameters].[Parameter 1] THEN &apos;Selected Period&apos;&#10;   &#10;    ELSEIF [reporting_date] = DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 1]) and [Parameters].[Parameter 6] = &apos;Previous Day&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSEIF [reporting_date] = DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 1]) and [Parameters].[Parameter 6] = &apos;Previous Week&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSEIF [reporting_date] = DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 1]) and [Parameters].[Parameter 6] = &apos;Previous Month&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END' />
            </column>
            <column caption='Original Price Index' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2846134245445386241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [metric] = &apos;daily_original_price_index&apos; and [Parameters].[Parameter 3] = &apos;Daily&apos;&#10;then [metric_value] &#10;ELSEIF [metric] = &apos;7d_original_price_index&apos; and [Parameters].[Parameter 3] = &apos;Last 7 Days&apos;&#10;then [metric_value] &#10;ELSEIF [metric] = &apos;30d_original_price_index&apos; and [Parameters].[Parameter 3] = &apos;Last 30 Days&apos;&#10;then [metric_value] &#10;end' />
            </column>
            <column caption='Total SKUs' datatype='real' name='[Calculation_2846134245445890050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [metric] = &apos;total_sku_count&apos; then [metric_value] end' />
            </column>
            <column caption='Discounted SKUs' datatype='real' name='[Calculation_2846134245446471683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [metric] = &apos;discounted_sku_count&apos; then [metric_value] end' />
            </column>
            <column caption='% Discounted SKUs' datatype='real' default-format='p0.0%' name='[Calculation_2846134245446668292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2846134245446471683])/sum([Calculation_2846134245445890050])' />
            </column>
            <column caption='Average Discount' datatype='real' default-format='p0.0%' name='[Calculation_2846134245761294343]' role='measure' type='quantitative'>
