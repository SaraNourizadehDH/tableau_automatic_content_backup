      <column caption='Markup KPIs Daily' datatype='real' name='[Calculation_915215950909632516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Share of Marked Up GMV&apos; then [Calculation_915215950913138695]&#10;WHEN &apos;Share of Marked Up Food Orders&apos; then [Calculation_915215950913363976]&#10;WHEN &apos;Share of Marked Up Accounts&apos; then [Calculation_915215950912524294]&#10;END' />
      </column>
      <column caption='Share of Marked Up Accounts' datatype='real' name='[Calculation_915215950912524294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(case [is_markup] when TRUE then [account_id] end) / (COUNTD(case [is_markup] when TRUE then [account_id] end) + COUNTD(case [is_markup] when FALSE then [account_id] end))' />
