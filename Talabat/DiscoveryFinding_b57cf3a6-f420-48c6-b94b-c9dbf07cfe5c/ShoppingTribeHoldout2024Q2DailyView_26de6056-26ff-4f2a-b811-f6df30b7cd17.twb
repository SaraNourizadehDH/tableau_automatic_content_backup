        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_2995597487099949069]&#10;WHEN &apos;CVR3&apos; then [CVR (copy 2)_603552766357204992]&#10;WHEN &apos;HoF CVR&apos; then [Calculation_603552766606315523]&#10;WHEN &apos;Ranking CVR&apos; then [Calculation_6861022985287413760]&#10;WHEN &apos;mCVR2&apos; then [Calculation_2995597485000839168]&#10;WHEN &apos;mCVR3&apos; then [mCVR2 (copy)_2995597485001093121]&#10;WHEN &apos;mCVR3 A&apos; then [mCVR3 (copy)_2995597485001293826]&#10;WHEN &apos;mCVR3 B&apos; then [mCVR3 A (copy)_2995597485001441283]&#10;WHEN &apos;mCVR4&apos; then [mCVR3 (copy)_2995597485001867268]&#10;WHEN &apos;mCVR4 A&apos; then [mCVR4 (copy)_2995597485002235909]&#10;WHEN &apos;mCVR4 B&apos; then [mCVR4 A (copy)_2995597485002735622]&#10;WHEN &apos;Overall Food Order Per User&apos; then [Calculation_5420997002248392705]&#10;WHEN &apos;HoF Food Order Per User&apos; then [Overall Food orders per user (copy 2)_5693886986848800779]&#10;WHEN &apos;AOV&apos; then [Calculation_380272741018800128]&#10;when &apos;GMV Per User&apos; then [Overall Food orders per user (copy 2)_1996502069712097301]&#10;end' />
