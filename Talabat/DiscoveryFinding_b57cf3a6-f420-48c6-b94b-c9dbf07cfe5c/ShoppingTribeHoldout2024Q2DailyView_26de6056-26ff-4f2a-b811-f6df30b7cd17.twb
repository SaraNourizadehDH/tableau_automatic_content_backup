              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2],[date])' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_4466163455840989184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_652318317329248257])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_652318317329248257]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_652318317329248257])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_652318317329248257]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
            </column>
            <column caption='Markup KPIs Daily' datatype='real' name='[Calculation_915215950909632516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Share of Marked Up GMV&apos; then [Calculation_915215950913138695]&#10;WHEN &apos;Share of Marked Up Food Orders&apos; then [Calculation_915215950913363976]&#10;WHEN &apos;Share of Marked Up Accounts&apos; then [Calculation_915215950912524294]&#10;END' />
            </column>
            <column caption='Share of Marked Up Accounts' datatype='real' name='[Calculation_915215950912524294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(case [is_markup] when TRUE then [account_id] end) / (COUNTD(case [is_markup] when TRUE then [account_id] end) + COUNTD(case [is_markup] when FALSE then [account_id] end))' />
            </column>
            <column caption='Share of Marked Up GMV' datatype='real' name='[Calculation_915215950913138695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_marked_up_gmv_eur])/(SUM([total_marked_up_gmv_eur]) + SUM([total_non_marked_up_gmv_eur]))' />
            </column>
            <column caption='Share of Marked Up Food Orders' datatype='real' name='[Calculation_915215950913363976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([marked_up_food_order_count])/(SUM([marked_up_food_order_count]) + SUM([non_marked_up_food_order_count]))' />
            </column>
            <column caption='Account Id' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
