              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;hof&apos; THEN  [food_order_count] end)&#10;/ COUNTD(case [kpis_source] when &apos;hof&apos; THEN  [account_id] END)' />
