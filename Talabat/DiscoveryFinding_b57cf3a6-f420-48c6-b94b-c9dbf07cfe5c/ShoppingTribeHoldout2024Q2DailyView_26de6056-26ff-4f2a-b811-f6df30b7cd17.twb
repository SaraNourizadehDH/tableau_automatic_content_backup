    <worksheet name='Shopping Tribe Main KPIs (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Latest Date - Shopping Tribe Main KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily metrics' name='federated.1s6wtkl028z39s1b8t4n21gwjqng (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1s6wtkl028z39s1b8t4n21gwjqng (copy)'>
            <column caption='CVR3' datatype='real' default-format='p0.000%' name='[CVR (copy 2)_603552766357204992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Placed Order Sessions])/sum([All Sessions])&#10;&#10;sum((case [kpis_source] when &apos;overall&apos; THEN [placed_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;overall&apos; THEN [menu_view_session_count] END)' />
            </column>
            <column caption='today -2' datatype='boolean' name='[Calculation_1996502069268033554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= DATEADD(&apos;day&apos;, -2, TODAY())' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_380272741018800128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Total Order Value Eur])/sum([Food Orders])&#10;AVG([average_order_value])&#10;//sum((case [Kpis Source] when &apos;overall&apos; THEN [Total Order Value Eur] end)) &#10;/// sum(case [Kpis Source] when &apos;overall&apos; THEN [Food Order Count] END)' />
            </column>
            <column caption='Overall Food orders per user' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_5420997002248392705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;overall&apos; THEN  [food_order_count] end)&#10;/ COUNTD(case [kpis_source] when &apos;overall&apos; THEN  [account_id] END)' />
            </column>
            <column caption='HoF CVR' datatype='real' default-format='p0.00%' name='[Calculation_603552766606315523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum((case [kpis_source] when &apos;hof&apos; THEN [placed_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;hof&apos; THEN  [sessions_count] END)' />
            </column>
            <column caption='Ranking CVR' datatype='real' default-format='p0.000%' name='[Calculation_6861022985287413760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Ranking Order Sessions])/sum([All Sessions])&#10;&#10;sum((case [kpis_source] when &apos;hof&apos; THEN [ranking_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;hof&apos; THEN [sessions_count] END)' />
            </column>
            <column caption='Overall GMV Per User' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Overall Food orders per user (copy 2)_1996502069712097301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;overall&apos; THEN  [total_gmv_amount_eur] end)&#10;/ COUNTD(case [kpis_source] when &apos;overall&apos; THEN  [account_id] END)' />
            </column>
            <column caption='HoF Food orders per user' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Overall Food orders per user (copy 2)_5693886986848800779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;hof&apos; THEN  [food_order_count] end)&#10;/ COUNTD(case [kpis_source] when &apos;hof&apos; THEN  [account_id] END)' />
            </column>
