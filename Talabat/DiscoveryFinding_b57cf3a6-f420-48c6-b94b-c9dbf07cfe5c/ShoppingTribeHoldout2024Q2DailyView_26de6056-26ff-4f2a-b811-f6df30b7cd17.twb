    <worksheet name='Dynamic Delta Metric trend (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Dynamic Delta Metric trend&#10;</run>
            <run fontsize='9' italic='true' underline='true'>The axis scale doesn&apos;t have zero </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily metrics' name='federated.1s6wtkl028z39s1b8t4n21gwjqng (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-04-06#'>
              <calculation class='tableau' formula='#2024-04-06#' />
              <range max='#2025-01-01#' min='#2024-01-25#' />
            </column>
            <column alias='Day' caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Select Metric (copy)_2995597487099949069]' param-domain-type='list' role='measure' type='nominal' value='&quot;mCVR3&quot;'>
              <calculation class='tableau' formula='&quot;mCVR3&quot;' />
            </column>
            <column caption='Select Secondary Metric' datatype='string' name='[Select Secondary Metric  (copy)_2995597487099957262]' param-domain-type='list' role='measure' type='nominal' value='&quot;mCVR4&quot;'>
              <calculation class='tableau' formula='&quot;mCVR4&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1s6wtkl028z39s1b8t4n21gwjqng].[Calculation_652318317329420291]' caption='End Date' datatype='date' name='[Start Date (copy)_652318317329248257]' param-domain-type='any' role='measure' type='quantitative' value='#2024-06-09#'>
              <calculation class='tableau' formula='#2024-06-09#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s6wtkl028z39s1b8t4n21gwjqng (copy)'>
            <column caption='CVR3' datatype='real' default-format='p0.000%' name='[CVR (copy 2)_603552766357204992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Placed Order Sessions])/sum([All Sessions])&#10;&#10;sum((case [kpis_source] when &apos;overall&apos; THEN [placed_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;overall&apos; THEN [menu_view_session_count] END)' />
            </column>
            <column caption='mCVR2' datatype='real' default-format='p0.00%' name='[Calculation_2995597485000839168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum((case [kpis_source] when &apos;overall&apos; THEN [menu_view_session_count]end)) / sum(case [kpis_source] when &apos;overall&apos; THEN [sessions_count]END)' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_2995597487100686353]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2],[date])' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_380272741018800128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Total Order Value Eur])/sum([Food Orders])&#10;AVG([average_order_value])&#10;//sum((case [Kpis Source] when &apos;overall&apos; THEN [Total Order Value Eur] end)) &#10;/// sum(case [Kpis Source] when &apos;overall&apos; THEN [Food Order Count] END)' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_4466163455840989184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_652318317329248257])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_652318317329248257]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_652318317329248257])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_652318317329248257]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
            </column>
            <column caption='Overall Food orders per user' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_5420997002248392705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;overall&apos; THEN  [food_order_count] end)&#10;/ COUNTD(case [kpis_source] when &apos;overall&apos; THEN  [account_id] END)' />
            </column>
            <column caption='HoF CVR' datatype='real' default-format='p0.00%' name='[Calculation_603552766606315523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum((case [kpis_source] when &apos;hof&apos; THEN [placed_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;hof&apos; THEN  [sessions_count] END)' />
            </column>
            <column caption='Ranking CVR' datatype='real' default-format='p0.000%' name='[Calculation_6861022985287413760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Ranking Order Sessions])/sum([All Sessions])&#10;&#10;sum((case [kpis_source] when &apos;hof&apos; THEN [ranking_order_session_count] end)) &#10;/ sum(case [kpis_source] when &apos;hof&apos; THEN [sessions_count] END)' />
            </column>
            <column caption='Overall GMV Per User' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Overall Food orders per user (copy 2)_1996502069712097301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;overall&apos; THEN  [total_gmv_amount_eur] end)&#10;/ COUNTD(case [kpis_source] when &apos;overall&apos; THEN  [account_id] END)' />
            </column>
            <column caption='HoF Food orders per user' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Overall Food orders per user (copy 2)_5693886986848800779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Food Orders]/[Accounts]&#10;&#10;&#10;sum(case [kpis_source] when &apos;hof&apos; THEN  [food_order_count] end)&#10;/ COUNTD(case [kpis_source] when &apos;hof&apos; THEN  [account_id] END)' />
            </column>
            <column caption='Selected Metric' datatype='real' default-format='p0.00%' name='[Selected Metric (copy)_2995597487100108815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_2995597487099949069]&#10;WHEN &apos;CVR3&apos; then [CVR (copy 2)_603552766357204992]&#10;WHEN &apos;HoF CVR&apos; then [Calculation_603552766606315523]&#10;WHEN &apos;Ranking CVR&apos; then [Calculation_6861022985287413760]&#10;WHEN &apos;mCVR2&apos; then [Calculation_2995597485000839168]&#10;WHEN &apos;mCVR3&apos; then [mCVR2 (copy)_2995597485001093121]&#10;WHEN &apos;mCVR3 A&apos; then [mCVR3 (copy)_2995597485001293826]&#10;WHEN &apos;mCVR3 B&apos; then [mCVR3 A (copy)_2995597485001441283]&#10;WHEN &apos;mCVR4&apos; then [mCVR3 (copy)_2995597485001867268]&#10;WHEN &apos;mCVR4 A&apos; then [mCVR4 (copy)_2995597485002235909]&#10;WHEN &apos;mCVR4 B&apos; then [mCVR4 A (copy)_2995597485002735622]&#10;WHEN &apos;Overall Food Order Per User&apos; then [Calculation_5420997002248392705]&#10;WHEN &apos;HoF Food Order Per User&apos; then [Overall Food orders per user (copy 2)_5693886986848800779]&#10;WHEN &apos;AOV&apos; then [Calculation_380272741018800128]&#10;when &apos;GMV Per User&apos; then [Overall Food orders per user (copy 2)_1996502069712097301]&#10;end' />
            </column>
            <column caption='Selected Secondary Metric' datatype='real' default-format='p0.00%' name='[Selected Secondary Metric (copy)_2995597487100125200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Secondary Metric  (copy)_2995597487099957262]&#10;WHEN &apos;CVR3&apos; then [CVR (copy 2)_603552766357204992]&#10;WHEN &apos;HoF CVR&apos; then [Calculation_603552766606315523]&#10;WHEN &apos;Ranking CVR&apos; then [Calculation_6861022985287413760]&#10;WHEN &apos;mCVR2&apos; then [Calculation_2995597485000839168]&#10;WHEN &apos;mCVR3&apos; then [mCVR2 (copy)_2995597485001093121]&#10;WHEN &apos;mCVR3 A&apos; then [mCVR3 (copy)_2995597485001293826]&#10;WHEN &apos;mCVR3 B&apos; then [mCVR3 A (copy)_2995597485001441283]&#10;WHEN &apos;mCVR4&apos; then [mCVR3 (copy)_2995597485001867268]&#10;WHEN &apos;mCVR4 A&apos; then [mCVR4 (copy)_2995597485002235909]&#10;WHEN &apos;mCVR4 B&apos; then [mCVR4 A (copy)_2995597485002735622]&#10;WHEN &apos;Overall Food Order Per User&apos; then [Calculation_5420997002248392705]&#10;WHEN &apos;HoF Food Order Per User&apos; then [Overall Food orders per user (copy 2)_5693886986848800779]&#10;WHEN &apos;AOV&apos; then [Calculation_380272741018800128]&#10;when &apos;GMV Per User&apos; then [Overall Food orders per user (copy 2)_1996502069712097301]&#10;end' />
            </column>
            <column caption='Account Id' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
            <column caption='Added To Cart From Menu Session Count' datatype='integer' name='[added_to_cart_from_menu_session_count]' role='measure' type='quantitative' />
            <column caption='Attempted Place Order From Start Checkout Session Count' datatype='integer' name='[attempted_place_order_from_start_checkout_session_count]' role='measure' type='quantitative' />
            <column caption='Attempted Place Order Session Count' datatype='integer' name='[attempted_place_order_session_count]' role='measure' type='quantitative' />
