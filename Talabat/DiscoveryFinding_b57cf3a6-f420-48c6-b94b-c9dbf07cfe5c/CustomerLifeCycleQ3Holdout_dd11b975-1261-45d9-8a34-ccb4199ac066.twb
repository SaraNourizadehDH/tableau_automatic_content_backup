        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0shx3oc11exdqf1ffy0n11isnr9o' name='Custom SQL Query' type='text'><![CDATA[with segments as (
  SELECT
  distinct
    case WHEN global_entity_id = 'TB_AE' THEN 'AE'
    WHEN global_entity_id = 'TB_BH' THEN 'BH'
    WHEN global_entity_id = 'TB_IQ' THEN 'IQ'
    WHEN global_entity_id = 'TB_JO' THEN 'JO'
    WHEN global_entity_id = 'TB_KW' THEN 'KW'
    WHEN global_entity_id = 'TB_OM' THEN 'OM'
    WHEN global_entity_id = 'TB_QA' THEN 'QA'
    WHEN global_entity_id = 'HF_EG' THEN 'EG'
    else null end as country_code,
     cast(snapshot_date_utc as date) as date,
    customer_id as account_id,
    case when b.acquisition_order_date is null or b.acquisition_order_date >>=  cast(snapshot_date_utc as date) then 'Prospect'
    when DATE_DIFF(cast(snapshot_date_utc as date),b.acquisition_order_date,DAY) between 1 and 30 then 'New Customer'
    else global.growth.value_segment end as segment
  FROM 
    `fulfillment-dwh-production.curated_data_shared_cdp.customers` a
  LEFT JOIN `tlb-data-prod.data_platform.agg_account_profile` b on a.customer_id= cast(b.account_id as string)
  WHERE 
    global_entity_id IN ('TB_AE', 'TB_BH', 'TB_IQ', 'TB_JO', 'TB_KW', 'TB_OM', 'TB_QA', 'HF_EG')
  AND 
    cast(snapshot_date_utc as date)  >>='2025-01-01'
  AND global.growth.value_segment is not null
), 

holdout as (
SELECT
  clientId,
  partition_date,
  holdoutKey,
  holdoutVariation,
  holdoutEvaluation,
  platform,
  case when country in ('AE','ARE','ae') then 'AE'
       when country in ('KW','KWT','kw') then 'KW'
       when country in ('BHR','BH','bh') then 'BH'
       when country in ('EG','EGY','eg') then 'EG'
       when country in ('IQ','IRQ','iq') then 'IQ'
       when country in ('JO','JOR','jo') then 'JO'
       when country in ('OM','OMN','om') then 'OM'
       when country in ('QA','QAT','qa') then 'QA'
       when country in ('SA','SAU','sa') then 'SA'
       else null end as country
FROM `fulfillment-dwh-production.curated_data_shared_experimentation.experiment_holdout_talabat` 
WHERE TRUE
    AND dh_platform = 'talabat'
    AND (
      (partition_date << '2025-07-01' AND eventAction = 'holdout_group.participated')
      OR 
      (partition_date >>= '2025-07-01')
    )
    AND holdoutKey='activation-holdout-h2-2025'),

sessions AS (
  SELECT
    a.date,
    session_id,
    a.transaction_id,
    is_successful,
    viewed_menu,
    a.country_code,
    operating_system,
  	segment,
    holdoutEvaluation,
    case when visit_number=1 then True else False end as is_first_session,
    case when segment IS NULL OR segment != '1_HVC' then True else False end as is_non_hvc_session,
  	viewed_home
  FROM `tlb-data-prod.data_platform.fct_session`  as a
  left join `tlb-data-prod.data_platform.fct_order_info` b 
  on cast(a.transaction_id as string) = cast(b.transaction_id as string)
  LEFT JOIN segments c
    ON CAST(a.account_id AS STRING) = c.account_id 
    AND a.date = c.date
    AND a.country_code= c.country_code
  left join holdout h
    ON a.perseus_client_id = h.clientId 
    AND  a.date = h.partition_date
    AND a.country_code = h.country
  WHERE a.date >>= '2025-01-01'
)
  
  SELECT
    date,
	country_code,
	segment,
  operating_system,
  holdoutEvaluation,
	COUNT(distinct case when is_successful and is_first_session then session_id end) as nb_first_sessions_converted,
    COUNT(distinct case when is_first_session then session_id end) AS nb_first_sessions,
    COUNT(distinct case when is_successful and viewed_home and is_first_session then session_id end) as nb_first_sessions_home_converted,
    COUNT(distinct case when is_first_session and viewed_home then session_id end) AS nb_first_sessions_home,
	COUNT(distinct case when viewed_menu and is_non_hvc_session then session_id end) as non_hvc_sessions_menu_view,
    COUNT(distinct case when is_non_hvc_session then session_id end) AS non_hvc_sessions 
  FROM sessions 
  GROUP BY 1,2,3,4,5
  order by date asc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
