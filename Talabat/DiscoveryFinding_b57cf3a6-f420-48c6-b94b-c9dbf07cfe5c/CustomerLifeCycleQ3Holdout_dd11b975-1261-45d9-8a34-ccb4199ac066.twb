      <aliases enabled='yes' />
      <column caption='1st Home Session CVR ' datatype='real' default-format='p0.00%' name='[1st Session CVR (copy)_4879650230092439553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([nb_first_sessions_home_converted]) / sum([nb_first_sessions_home])' />
      </column>
      <column caption='Non HVC Menu Views Conversion' datatype='real' default-format='p0.00%' name='[Calculation_4236831754514726912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([non_hvc_sessions_menu_view])/sum([non_hvc_sessions])' />
      </column>
      <column caption='1st Session CVR' datatype='real' default-format='p0.00%' name='[Calculation_4879650230092140544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([nb_first_sessions_converted]) / sum([nb_first_sessions])' />
      </column>
      <column caption='Conversion Metrics' datatype='real' default-format='p0.00%' name='[Calculation_5867768140786401283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10;when &apos;1st Session CVR&apos; then [Calculation_4879650230092140544]&#10;when &apos;1st Home Session CVR&apos; then [1st Session CVR (copy)_4879650230092439553]&#10;when &apos;Non HVC Menu Views Conversion&apos; then [Calculation_4236831754514726912] END' />
      </column>
