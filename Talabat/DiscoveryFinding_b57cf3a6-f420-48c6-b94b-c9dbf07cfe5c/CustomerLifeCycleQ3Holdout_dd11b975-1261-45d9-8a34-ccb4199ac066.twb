      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_2E6339BCF96B4F069C11BA596C32DAE3]' role='measure' type='quantitative' />
