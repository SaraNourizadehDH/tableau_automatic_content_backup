            <column datatype='integer' name='[total_session]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xbyufr1f74ig317yqxzs0hhsc5p'>
            <column caption='Loaded Sessions Count' datatype='integer' name='[Calculation_1567886030979325952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(case  [loaded_event_action] when &apos;voice_icon.loaded&apos; &#10;then ([loaded_session_id]) end)' />
            </column>
            <column caption='Feature Coverage %' datatype='real' default-format='p0.00%' name='[Calculation_1567886030981758979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1567886030979325952]/[federated.1w0htx5050z83u16e1ttw08ilr8k].[Calculation_2575003497700536323]' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_1567886030982676484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 2] when &apos;Country&apos; then [country] &#10;when &apos;No selection&apos; then &apos;No selection&apos; end' />
            </column>
            <column caption='Zero Result Count' datatype='integer' name='[Calculation_1567886030992535563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(if [engegment_event_action] = &apos;voice_ordering_results.loaded&apos; and  [is_no_result_loaded] = TRUE then [engagement_session_id] END )' />
            </column>
            <column caption='Search Query Submit Count' datatype='integer' name='[Calculation_1567886031003508748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(if [engegment_event_action] = &apos;command.submitted&apos;  then [engagement_session_id] end)' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_2575003497699074049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull((SUM([federated.1idyh9w0wv0dd91cwo81p0znpi5y].[orders]))/ [Loaded Sessions Count (copy)_1567886030979928065],0)' />
            </column>
            <column caption='Feature CTR' datatype='real' default-format='p0.00%' name='[Calculation_4022418190954856448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Loaded Sessions Count (copy)_1567886030980784130] / [Loaded Sessions Count (copy)_1567886030979928065]' />
            </column>
            <column caption='Date Granularity' datatype='date' name='[Calculation_5516628105245265920]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[date]))' />
            </column>
            <column caption='ZRR' datatype='real' default-format='p0.00%' name='[Calculation_5516628105248161793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([Calculation_1567886030992535563]&#10;/[Calculation_1567886031003508748]),0)' />
            </column>
            <column caption='Shown Sessions Count' datatype='integer' name='[Loaded Sessions Count (copy)_1567886030979928065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(case  [loaded_event_action] when &apos;voice_icon.shown&apos; &#10;then ([loaded_session_id]) end)' />
            </column>
            <column caption='Feature Clicked Sessions Count' datatype='integer' name='[Loaded Sessions Count (copy)_1567886030980784130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(case [engegment_event_action] when &apos;bottom_sheet.loaded&apos; &#10;then ([engagement_session_id]) end)' />
            </column>
