      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1w0htx5050z83u16e1ttw08ilr8k].[sum:total_session:qk]&quot;' value='Total Screen Sessions' />
          <alias key='&quot;[federated.1xbyufr1f74ig317yqxzs0hhsc5p].[sum:placed_order_sessions:qk]&quot;' value='Placed order sessions' />
          <alias key='&quot;[federated.1xbyufr1f74ig317yqxzs0hhsc5p].[sum:shop_clicks:qk]&quot;' value='Sessions with vendor clicks' />
          <alias key='&quot;[federated.1xbyufr1f74ig317yqxzs0hhsc5p].[sum:vo_bottom_click:qk]&quot;' value='Voice ordering Clicked' />
          <alias key='&quot;[federated.1xbyufr1f74ig317yqxzs0hhsc5p].[usr:Calculation_5516628105248161793:qk]&quot;' value='ZRR(Zero Result Rate)' />
        </aliases>
      </column>
      <column caption='Loaded Sessions Count' datatype='integer' name='[Calculation_1567886030979325952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(case  [loaded_event_action] when &apos;voice_icon.loaded&apos; &#10;then ([loaded_session_id]) end)' />
      </column>
      <column caption='Feature Coverage %' datatype='real' default-format='p0.00%' name='[Calculation_1567886030981758979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1567886030979325952]/[federated.1w0htx5050z83u16e1ttw08ilr8k].[Calculation_2575003497700536323]' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_1567886030982676484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 2] when &apos;Country&apos; then [country] &#10;when &apos;No selection&apos; then &apos;No selection&apos; end' />
      </column>
      <column caption='Sessions Count' datatype='integer' name='[Calculation_1567886030987702278]' role='measure' type='quantitative'>
