      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_B680C5EF5A8B42848C84A19D47017E6C'>
            <properties context=''>
              <relation connection='bigquery.11gzp8i1q0rgcm15jxhzj1xjyq3k' name='Custom SQL Query' type='text'>WITH vo_shown_loaded AS (
  SELECT
    partition_date,
    country,
    userId AS user_id,
    sessionId AS session_id,
    eventAction
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_events_talabat`
  WHERE partition_date BETWEEN &apos;2025-08-11&apos; AND CURRENT_DATE() - 1
    AND eventAction IN (&apos;voice_icon.shown&apos;, &apos;voice_icon.loaded&apos;)
),

vo_engagement AS (
  SELECT
    partition_date,
    country,
    eventAction,
    sessionId AS session_id,
    userId AS user_id,
    hit_number,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.eventOrigin&quot;) AS STRING) AS eventOrigin,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.featureName&quot;) AS STRING) AS featureName,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.inputMode&quot;) AS STRING) AS voice_order_inputMode,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.productSku&quot;) AS STRING) AS loaded_productSku,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.shopsIds&quot;) AS STRING) AS loaded_shopsIds,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.searchTerm&quot;) AS STRING) AS searchTerm,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.bottomSheetName&quot;) AS STRING) AS bottomSheetName,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.feedbackType&quot;) AS STRING) AS feedbackType,
    SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.shopId&quot;) AS STRING) AS shopId
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_events_talabat`
  WHERE partition_date BETWEEN &apos;2025-08-11&apos; AND CURRENT_DATE() - 1
    AND eventAction IN (
      &apos;bottom_sheet.loaded&apos;,
      &apos;voice_ordering_results.loaded&apos;,
      &apos;command.submitted&apos;,
      &apos;shop.clicked&apos;,
      &apos;product_info.clicked&apos;,
      &apos;feedback.submitted&apos;,
      &apos;shop_impressions.loaded&apos;,
      &apos;product_impressions.loaded&apos;
    )
    AND SAFE_CAST(JSON_EXTRACT_SCALAR(eventVariables_Json, &quot;$.featureName&quot;) AS STRING) = &apos;voice_ordering&apos;
),

-- Apply window function BEFORE joining or grouping
vo_engagement_with_mode AS (
  SELECT
    *,
    CASE 
      WHEN eventAction = &apos;voice_ordering_results.loaded&apos; THEN
        LAST_VALUE(
          CASE 
            WHEN eventAction = &apos;command.submitted&apos; AND voice_order_inputMode IS NOT NULL 
            THEN voice_order_inputMode 
          END
          IGNORE NULLS
        ) 
        OVER (
          PARTITION BY session_id 
          ORDER BY hit_number 
          ROWS UNBOUNDED PRECEDING
        )
      ELSE voice_order_inputMode
    END AS voice_order_inputMode_filled
  FROM vo_engagement
)

-- Final selection: join shown_loaded to engagement (optional), filter for voice_ordering_results.loaded
SELECT distinct 
  a.partition_date AS date,
  a.country,
  a.user_id,
  a.session_id AS loaded_session_id,
  b.session_id AS engagement_session_id,
  a.eventAction AS loaded_event_action,
  b.eventAction AS engegment_event_action,
  b.eventOrigin,
  b.featureName,
  b.voice_order_inputMode,
  b.voice_order_inputMode_filled,
  CASE WHEN TRIM(b.loaded_productSku) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_productSku END AS loaded_productSku,
  CASE WHEN TRIM(b.loaded_shopsIds) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_shopsIds END AS loaded_shopsIds,
  b.searchTerm,
  b.bottomSheetName,
  b.feedbackType,
  b.shopId,
  CASE 
    WHEN b.eventAction = &apos;voice_ordering_results.loaded&apos; 
     AND CASE WHEN TRIM(b.loaded_shopsIds) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_shopsIds END = &apos;0&apos; 
    THEN TRUE 
    ELSE FALSE 
  END AS is_no_result_loaded
FROM vo_shown_loaded a
LEFT JOIN vo_engagement_with_mode b 
  ON a.session_id = b.session_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
