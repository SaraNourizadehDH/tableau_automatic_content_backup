-- Final selection: join shown_loaded to engagement (optional), filter for voice_ordering_results.loaded
SELECT distinct 
  a.partition_date AS date,
  a.country,
  a.user_id,
  a.session_id AS loaded_session_id,
  b.session_id AS engagement_session_id,
  a.eventAction AS loaded_event_action,
  b.eventAction AS engegment_event_action,
  b.eventOrigin,
  b.featureName,
  b.voice_order_inputMode,
  b.voice_order_inputMode_filled,
  CASE WHEN TRIM(b.loaded_productSku) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_productSku END AS loaded_productSku,
  CASE WHEN TRIM(b.loaded_shopsIds) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_shopsIds END AS loaded_shopsIds,
  b.searchTerm,
  b.bottomSheetName,
  b.feedbackType,
  b.shopId,
  CASE 
