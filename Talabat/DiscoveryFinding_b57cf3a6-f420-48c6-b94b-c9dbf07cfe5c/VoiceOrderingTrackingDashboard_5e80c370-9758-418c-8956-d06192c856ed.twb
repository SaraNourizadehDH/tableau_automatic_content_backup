     AND CASE WHEN TRIM(b.loaded_shopsIds) = &apos;&apos; THEN &apos;0&apos; ELSE b.loaded_shopsIds END = &apos;0&apos; 
    THEN TRUE 
    ELSE FALSE 
  END AS is_no_result_loaded
FROM vo_shown_loaded a
LEFT JOIN vo_engagement_with_mode b 
  ON a.session_id = b.session_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
