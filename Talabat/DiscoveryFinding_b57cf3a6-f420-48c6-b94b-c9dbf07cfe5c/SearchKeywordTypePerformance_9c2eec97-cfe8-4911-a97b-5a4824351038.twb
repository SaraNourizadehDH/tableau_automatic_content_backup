              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1n6sf1r18ddwu213jpzz20u9h7i2].[Calculation_1963287979991478273]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-11-16#'>
              <calculation class='tableau' formula='#2023-11-16#' />
            </column>
            <column alias='All' caption='Country' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
