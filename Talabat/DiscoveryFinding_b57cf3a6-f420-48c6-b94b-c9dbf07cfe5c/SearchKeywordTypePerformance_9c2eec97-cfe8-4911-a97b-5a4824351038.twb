              <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_3989344860172103683])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_3989344860172103683]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_3989344860172103683])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_3989344860172103683]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
