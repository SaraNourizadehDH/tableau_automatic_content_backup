                <alias key='&quot;all&quot;' value='All' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Placed Orders Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Placed Orders Sessions&quot;' />
            </column>
            <column caption='Select Secondary Metric' datatype='string' name='[Select Metric (copy)_5025806093498486784]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
              <calculation class='tableau' formula='&quot;CVR&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1n6sf1r18ddwu213jpzz20u9h7i2].[Calculation_1963287979990851584]' caption='End Date' datatype='date' name='[Start Date (copy)_3989344860172103683]' param-domain-type='any' role='measure' type='quantitative' value='#2023-11-23#'>
              <calculation class='tableau' formula='#2023-11-23#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1n6sf1r18ddwu213jpzz20u9h7i2'>
            <column caption='CTO' datatype='real' default-format='p0.000%' name='[CVR (copy)_1963287980002742276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([placed_order_session_count])/sum([vendor_clicked_session_count])' />
            </column>
            <column caption='Default Date - End' datatype='date' name='[Calculation_1963287979990851584]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='Default Date - Start' datatype='date' name='[Calculation_1963287979991478273]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-8' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_1963287979991760898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_3989344860172103683])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_3989344860172103683]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_3989344860172103683])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_3989344860172103683]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.000%' name='[Calculation_1963287979996028931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([placed_order_session_count])/sum([search_bar_clicked_session_count])' />
            </column>
            <column caption='mCVR3' datatype='real' default-format='p0.000%' name='[Calculation_1963287980003115013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(started_checkout_session_count)/sum(vendor_clicked_session_count)' />
            </column>
            <column caption='Selected Secondary Metric' datatype='real' default-format='p0.000%' name='[Calculation_1963287980030853127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_5025806093498486784]&#10;WHEN &apos;CVR&apos; then [Calculation_1963287979996028931]&#10;WHEN &apos;CTO&apos; THEN [CVR (copy)_1963287980002742276]&#10;WHEN &apos;mCVR3&apos; THEN [Calculation_1963287980003115013]&#10;WHEN &apos;mCVR2&apos; THEN [mCVR3 (copy)_7513693052717932544]&#10;WHEN  &apos;mCVR4&apos; THEN [mCVR3 (copy)_1963287980003196934]&#10;&#10;END' />
            </column>
            <column caption='Selected Metric' datatype='integer' name='[Calculation_1963287980031610888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Sessions&apos; then SUM([search_bar_clicked_session_count])&#10;WHEN &apos;Placed Orders Sessions&apos; then SUM([placed_order_session_count])&#10;WHEN &apos;Started Checkout Sessions&apos; THEN SUM([started_checkout_session_count])&#10;WHEN &apos;Add to Cart Sessions&apos; THEN SUM([add_cart_session_count])&#10;WHEN &apos;Vendor Clicked Sessions&apos; THEN SUM([vendor_clicked_session_count])&#10;&#10;END' />
            </column>
            <column caption='Verticals' datatype='string' name='[Calculation_1963287980037881868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT([vertical_cleaned],1))+LOWER(MID([vertical_cleaned],2))' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_1963287980042149905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;All&apos; then true else [Parameters].[Parameter 2] = [country_code] end' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_1963287980055003154]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 10],[date])' />
            </column>
            <column datatype='string' name='[Search Keyword Type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[type]' new-bin='true'>
                <bin default-name='false' value='&quot;Cuisine/Lifestyle&quot;'>
                  <value>&quot;cuisine/Lifestyle&quot;</value>
                  <value>&quot;Cuisine/Lifestyle&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;dish&quot;'>
                  <value>&quot;dish/&quot;</value>
                </bin>
