meters].[Parameter 2] = &apos;All&apos; then true else [Parameters].[Parameter 2] = [User Selected Country] end&#10;WHEN &apos;Delivery Type&apos; THEN [Parameters].[Parameter 8] != &apos;All&apos;&#10;&#10;&#10;END' />
      </column>
