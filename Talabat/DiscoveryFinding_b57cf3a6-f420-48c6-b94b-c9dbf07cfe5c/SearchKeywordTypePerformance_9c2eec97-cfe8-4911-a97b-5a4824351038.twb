      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1n6sf1r18ddwu213jpzz20u9h7i2].[pcto:usr:Calculation_1963287980031610888:qk:3]&quot;' value='% Δ' />
