      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='date' />
        <field-sort-custom-order field='country_code' />
        <field-sort-custom-order field='component' />
        <field-sort-custom-order field='rank_adjusted' />
        <field-sort-custom-order field='Calculation_53621015141093378' />
        <field-sort-custom-order field='Average Rank (copy)_53621015141220356' />
        <field-sort-custom-order field='Lowest Rank  (copy)_53621015141363717' />
        <field-sort-custom-order field='Average Rank (copy)_53621015141163011' />
        <field-sort-custom-order field='sessions' />
        <field-sort-custom-order field='Geometry (generated)' />
        <field-sort-custom-order field='Latitude (generated)' />
