            <column caption='CTR' datatype='real' default-format='p0.00%' name='[CVR (copy)_2992430877564547078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2992430877563502593]) / sum([Click_session_count (copy)_2992430877563928578])' />
            </column>
            <column caption='CVR - Based on screen sessions' datatype='real' default-format='p0.00%' name='[CVR (copy)_53621015124791296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_session_count (copy)_2992430877564088323]) / SUM([federated.06cn9qk1kbrdtd102cwwk164xtd0].[total_session])' />
