    <datasource caption='total sessions data' inline='true' name='federated.06cn9qk1kbrdtd102cwwk164xtd0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ing2i2088e9kl15fw6om0f2k2qo'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='mohammed.gomaa@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ing2i2088e9kl15fw6om0f2k2qo' name='Custom SQL Query' type='text'>with segments as (
    SELECT
      distinct
      case WHEN global_entity_id = &apos;TB_AE&apos; THEN &apos;AE&apos;
        WHEN global_entity_id = &apos;TB_BH&apos; THEN &apos;BH&apos;
        WHEN global_entity_id = &apos;TB_IQ&apos; THEN &apos;IQ&apos;
        WHEN global_entity_id = &apos;TB_JO&apos; THEN &apos;JO&apos;
        WHEN global_entity_id = &apos;TB_KW&apos; THEN &apos;KW&apos;
        WHEN global_entity_id = &apos;TB_OM&apos; THEN &apos;OM&apos;
        WHEN global_entity_id = &apos;TB_QA&apos; THEN &apos;QA&apos;
        WHEN global_entity_id = &apos;HF_EG&apos; THEN &apos;EG&apos;
        else null end as country_code,
       cast(snapshot_date_utc as date) as date,
      customer_id as account_id,
      case when b.acquisition_order_date is null or b.acquisition_order_date &gt;&gt;=  cast(snapshot_date_utc as date) then &apos;Prospect&apos;
      when DATE_DIFF(cast(snapshot_date_utc as date),b.acquisition_order_date,DAY) between 1 and 30 then &apos;New Customer&apos;
      else global.growth.value_segment end as segment
    FROM 
      `fulfillment-dwh-production.curated_data_shared_cdp.customers` a
    LEFT JOIN `tlb-data-prod.data_platform.agg_account_profile` b on a.customer_id= cast(b.account_id as string)
    WHERE 
      global_entity_id IN (&apos;TB_AE&apos;, &apos;TB_BH&apos;, &apos;TB_IQ&apos;, &apos;TB_JO&apos;, &apos;TB_KW&apos;, &apos;TB_OM&apos;, &apos;TB_QA&apos;, &apos;HF_EG&apos;)
    AND 
      cast(snapshot_date_utc as date)BETWEEN &apos;2025-06-01&apos; AND current_date
    AND global.growth.value_segment is not null
  )

  SELECT
  a.date,
  a.country_code,
  segment,
  COUNT(DISTINCT session_id) total_session
FROM
  `tlb-data-prod.data_platform.fct_session` a
left join segments s on cast(a.account_id as string) = s.account_id and a.date = s.date and a.country_code = s.country_code
WHERE
  a.date
  BETWEEN &apos;2025-06-01&apos;
  AND current_date
GROUP BY
  ALL

union all 

SELECT
  a.date,
  &apos;Overall&apos; as country_code,
  segment,
  COUNT(DISTINCT session_id) total_session
FROM
  `tlb-data-prod.data_platform.fct_session` a
  left join segments s on cast(a.account_id as string) = s.account_id and a.date = s.date and a.country_code = s.country_code
WHERE
  a.date
  BETWEEN &apos;2025-06-01&apos;
  AND current_date
GROUP BY
  ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
