  a.country_code,
  segment,
  COUNT(DISTINCT session_id) total_session
FROM
  `tlb-data-prod.data_platform.fct_session` a
left join segments s on cast(a.account_id as string) = s.account_id and a.date = s.date and a.country_code = s.country_code
WHERE
  a.date
  BETWEEN &apos;2025-06-01&apos;
  AND current_date
GROUP BY
  ALL

union all 

SELECT
  a.date,
  &apos;Overall&apos; as country_code,
  segment,
  COUNT(DISTINCT session_id) total_session
FROM
  `tlb-data-prod.data_platform.fct_session` a
  left join segments s on cast(a.account_id as string) = s.account_id and a.date = s.date and a.country_code = s.country_code
WHERE
  a.date
  BETWEEN &apos;2025-06-01&apos;
  AND current_date
GROUP BY
  ALL</relation>
            </properties>
