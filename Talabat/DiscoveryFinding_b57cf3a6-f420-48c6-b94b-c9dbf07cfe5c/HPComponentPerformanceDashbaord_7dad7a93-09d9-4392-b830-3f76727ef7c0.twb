      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E9BFBBA3A3144056B5B25B10874F2E7E'>
            <properties context=''>
              <relation connection='bigquery.1bes0pk17q7ixk12rrz991yliy0a' name='Custom SQL Query' type='text'>WITH hit AS (
  SELECT 
    date,
    country_code,
    session_id,
    account_id,
    components_loaded, 
  FROM `tlb-data-prod.data_platform.fct_hit`
  WHERE date &gt;&gt;= &apos;2025-06-01&apos;
    AND account_id IS NOT NULL 
    AND components_loaded IS NOT NULL
    AND country_code in (&apos;AE&apos;, &apos;IQ&apos;, &apos;QA&apos;, &apos;OM&apos;, &apos;JO&apos;, &apos;KW&apos;, &apos;BH&apos;, &apos;EG&apos;)
  QUALIFY RANK() OVER (PARTITION BY session_id ORDER BY hit_timestamp_utc ASC) = 1
),

-- Base exploded component table
component_hits AS (
  SELECT
    date,
    country_code,
    session_id,
    SPLIT(kv, &apos;:&apos;)[SAFE_OFFSET(0)] AS component,
    (SAFE_CAST(SPLIT(kv, &apos;:&apos;)[SAFE_OFFSET(1)] AS INT64) - 2) AS rank_adjusted
  FROM hit,
  UNNEST(SPLIT(components_loaded, &apos;,&apos;)) AS kv
)

-- First aggregation: Overall (country_code = &apos;Overall&apos;)
SELECT
  date,
  &apos;Overall&apos; AS country_code,
  case 
    when component = &apos;sliding_banners&apos; then  &apos;sliding_banner&apos;
    when component = &apos;bento_box&apos; then &apos;bento_box_banner&apos;
    when component = &apos;order_lifecycle_widget&apos; then &apos;contextual_reorder_widget&apos;
    when component = &apos;display_ads_video&apos; then &apos;video_ads&apos;
    when component in (&apos;qc_swimlane&apos;,&apos;qcpl_swimlane&apos;) then &apos;qc_swimlane&apos;
    else component end component,
  rank_adjusted,
  COUNT(DISTINCT session_id) AS sessions
FROM component_hits
GROUP BY date, component, rank_adjusted
HAVING sessions &gt;&gt; 1000
  AND rank_adjusted &gt;&gt;= 1


UNION ALL

-- Second aggregation: Per country
SELECT
  date,
  country_code,
    case 
    when component = &apos;sliding_banners&apos; then  &apos;sliding_banner&apos;
    when component = &apos;bento_box&apos; then &apos;bento_box_banner&apos;
    when component = &apos;order_lifecycle_widget&apos; then &apos;contextual_reorder_widget&apos;
    when component = &apos;display_ads_video&apos; then &apos;video_ads&apos;
    when component in (&apos;qc_swimlane&apos;,&apos;qcpl_swimlane&apos;) then &apos;qc_swimlane&apos;
    else component end component,
  rank_adjusted,
  COUNT(DISTINCT session_id) AS sessions
FROM component_hits
GROUP BY date, country_code, component, rank_adjusted
HAVING sessions &gt;&gt; 1000
  AND rank_adjusted &gt;&gt;= 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
