    <worksheet name='Regional Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>&lt;Sheet Name&gt; </run>
            <run fontname='Tableau Regular' fontsize='8'>(Euros)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/FDNCDashboardnon-FDXdraftversion/RegionalOverview_1?rev=' id='RegionalOverview_1' path='/t/Talabat/workbooks/FDNCDashboardnon-FDXdraftversion' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery (2)' name='federated.0u3a8w80tjcboo120y90w0g3evru (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru (copy)'>
            <column datatype='real' name='[Blended_New_Incremental_Orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[Blended_New_Incremental_Users]' role='measure' type='quantitative' />
            <column caption='FDNC_CPA' datatype='real' name='[CPA (copy)_1844716664013463565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1218294083277791240])/SUM([MoM New Users (copy)_1844716663118389251])' />
            </column>
            <column caption='MoM First New Orders AFV' datatype='real' name='[Calculation_1218294083245473792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [order_month]=[cohort_month] then ([first_new_orders_basket_amount_eur (copy)_1218294084204867609]) End)/SUM([MoM New Users (copy)_1844716662741729280])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_1218294083271852037]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Country&apos; THEN [country_code]&#10;WHEN &apos;Month&apos; THEN STR([First Month (copy)_1218294083273842695])&#10;&#10;END' />
            </column>
            <column caption='FDNC Spend' datatype='real' name='[Calculation_1218294083277791240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_lc]) }&#10;WHEN &quot;Euro&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_eur]) }&#10;END' />
            </column>
            <column caption='m_first_new_orders_gmv' datatype='real' name='[Calculation_1218294084191686665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_gmv_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_gmv_eur]&#10;END' />
            </column>
            <column caption='m_returned_customer_gmv' datatype='real' name='[Calculation_1218294084193411084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [returned_customer_gmv_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [returned_customer_gmv_eur]&#10;END' />
            </column>
            <column caption='m_first_new_orders_flgpo' datatype='real' name='[Calculation_1218294084199411727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_flgpo_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_flgpo_eur]&#10;END' />
            </column>
            <column caption='m_first_new_orders_GP' datatype='real' name='[Calculation_1218294084199608336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_GP_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_GP_eur]&#10;END' />
            </column>
            <column caption='m_returned_customer_GP' datatype='real' name='[Calculation_1218294084200173587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [returned_customer_GP_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [returned_customer_GP_eur]&#10;END' />
            </column>
            <column caption='m_second_orders_first_month_flgpo' datatype='real' name='[Calculation_1218294084200493076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [second_orders_first_month_flgpo_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [second_orders_first_month_flgpo_eur]&#10;END' />
            </column>
            <column caption='%Order Share' datatype='real' default-format='p0.00%' name='[Calculation_17592228894392320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MoM New Users (copy)_1844716662741729280])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
            </column>
            <column caption='Impact on DF' datatype='real' default-format='p0.00%' name='[Calculation_17592229188472837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([dps_incentive_discount_eur])/(SUM([MoM tGo Orders DF])+SUM([dps_incentive_discount_eur]))&#10;SUM([Calculation_1218294083277791240])/SUM([MoM New Users Orders (copy)_17592229174857731]) * -1' />
            </column>
            <column caption='CPA' datatype='real' name='[Calculation_1799469553708007424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1218294083277791240])/SUM([Calculation_841610203003039749])' />
            </column>
            <column caption='FDNC_Total_New_Orders' datatype='real' name='[Calculation_1844716664694075434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MoM First New Orders (copy)_1844716663119605764]) + SUM([FDNC_MoM First New Orders (copy)_1844716664010522632])' />
            </column>
            <column caption='Inc. per first orders' datatype='real' name='[Calculation_2625598611046215681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATE([cohort_month]) &lt;= DATE(&apos;2024-09-01&apos;) THEN [Blended_New_Incremental_Users]  ELSE [New_Incremental_Users] END' />
            </column>
            <column caption='Same Verrical' datatype='boolean' name='[Calculation_2763169532868497415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[first_order_vertical]=[vertical]' />
            </column>
            <column caption='MoM New Users' datatype='integer' name='[Calculation_841610203003039749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [new_users] END' />
            </column>
            <column caption='FDNC_MoM Second New Orders' datatype='real' name='[FDNC_MoM First New Orders (copy)_1844716664010522632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if [Order Month]=[First Month] then &#10;[MoM First New Orders (copy)_1844716662741901313] - ([MoM First New Orders (copy)_1844716662741901313]/(1+[Inc. per first orders (copy)_2625598611047141378])) &#10;//END' />
            </column>
            <column caption='FDNC_MoM First New Orders GMV' datatype='real' name='[FDNC_MoM First New Orders (copy)_1844716664012750859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[Calculation_1218294084191686665] - [Calculation_1218294084191686665]/(1+[Calculation_2625598611046215681]) &#10;END' />
            </column>
            <column caption='FDNC_MoM First New Orders GP' datatype='real' name='[FDNC_MoM First New Orders GMV (copy)_1844716664376066077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[Calculation_1218294084199608336] - [Calculation_1218294084199608336]/(1+[Calculation_2625598611046215681]) &#10;END' />
            </column>
            <column caption='FDNC_MoM Second New Orders GMV' datatype='real' name='[FDNC_MoM Second New Orders (copy)_1844716664013045772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[m_returned_customer_gmv (copy)_1218294084194430989] - [m_returned_customer_gmv (copy)_1218294084194430989]/(1+[Inc. per first orders (copy)_2625598611047141378]) &#10;END' />
            </column>
            <column caption='FDNC_MoM Second New Orders GP' datatype='real' name='[FDNC_MoM Second New Orders GMV (copy)_1844716664376205342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[m_second_orders_first_month_flgpo (copy)_1218294084200714261] - [m_second_orders_first_month_flgpo (copy)_1218294084200714261]/(1+[Inc. per first orders (copy)_2625598611047141378]) &#10;END' />
            </column>
            <column caption='FDNC_Total_New_Orders_GMV' datatype='real' name='[FDNC_Total_New_Orders (copy)_1844716664694652971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FDNC_MoM First New Orders (copy)_1844716664012750859]) + SUM([FDNC_MoM Second New Orders (copy)_1844716664013045772])' />
            </column>
            <column caption='FDNC_Total_New_Orders_GP' datatype='real' name='[FDNC_Total_New_Orders_GMV (copy)_1844716664694902828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FDNC_MoM First New Orders GMV (copy)_1844716664376066077]) + SUM([FDNC_MoM Second New Orders GMV (copy)_1844716664376205342])' />
            </column>
            <column caption='First Month (copy)' datatype='date' default-format='*mmm yy' name='[First Month (copy)_1218294083273842695]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[cohort_month]' />
