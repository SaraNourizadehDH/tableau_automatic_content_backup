              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[first_new_orders] - [first_new_orders]/(1+[Calculation_2625598611046215681]) &#10;END' />
            </column>
            <column caption='MoM Second New Orders AFV' datatype='real' name='[MoM First New Orders AFV (copy)_1218294083247886337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [order_month]=[cohort_month] then ([m_return_customer_basket_amount (copy)_1218294084205359131]) End)/SUM([MoM First New Orders (copy)_1844716662741901313])' />
            </column>
            <column caption='MoM First New Orders' datatype='integer' name='[MoM New Users (copy)_1844716662741729280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [first_new_orders] END' />
            </column>
            <column caption='FDNC_MoM New Users' datatype='real' name='[MoM New Users (copy)_1844716663118389251]' role='measure' type='quantitative'>
