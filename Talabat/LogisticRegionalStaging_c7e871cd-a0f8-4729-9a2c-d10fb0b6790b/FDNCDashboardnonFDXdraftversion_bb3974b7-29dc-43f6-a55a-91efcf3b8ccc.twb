    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='FDNC Inc. Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>This tab highlights the </run>
            <run bold='true' fontcolor='#000000' fontsize='10' italic='true'>incremental impact of the FDNC</run>
            <run fontcolor='#000000' fontsize='10' italic='true'> campaign, providing metrics for users specifically influenced by the campaign. It offers insights into the additional new users, orders, GMV, and gross profit generated as a result of the FDNC initiative.</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-149:8863/t/Talabat/workbooks/FDNCDashboardnon-FDXdraftversion/FDNCInc_Impact?rev=' id='FDNCInc_Impact' path='/t/Talabat/workbooks/FDNCDashboardnon-FDXdraftversion' revision='' site='Talabat' />
      <style />
      <size maxheight='1200' maxwidth='1270' minheight='1200' minwidth='1270' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Cohort Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Net GP&quot;'>
          <calculation class='tableau' formula='&quot;Net GP&quot;' />
          <members>
            <member value='&quot;Users&quot;' />
            <member value='&quot;Orders&quot;' />
            <member value='&quot;Order Frequency&quot;' />
            <member value='&quot;Net GP&quot;' />
            <member value='&quot;GMV&quot;' />
            <member value='&quot;GPO&quot;' />
            <member value='&quot;FLGP&quot;' />
            <member value='&quot;AFV&quot;' />
          </members>
        </column>
