      <column caption='FDNC_CPA' datatype='real' name='[CPA (copy)_1844716664013463565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1218294083277791240])/SUM([MoM New Users (copy)_1844716663118389251])' />
      </column>
      <column caption='FDNC_Cohor Return Customers GMV' datatype='real' name='[Calculation_1123296299820105729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    IF MAX([cohort_month]=[order_month]) &#10;        THEN &#10;        SUM(([Calculation_1218294084191686665] - [Calculation_1218294084191686665] / (1+[Calculation_2625598611046215681])) &#10;        + ([m_returned_customer_gmv (copy)_1218294084194430989] - [m_returned_customer_gmv (copy)_1218294084194430989] / (1+[Inc. per first orders (copy)_2625598611047141378]))&#10;        )&#10;        ELSE &#10;   &#10;            [Calculation_224194855155343362] * [Calculation_224194855166951431]&#10;        END&#10;    )' />
      </column>
      <column caption='MoM First New Orders AFV' datatype='real' name='[Calculation_1218294083245473792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [order_month]=[cohort_month] then ([first_new_orders_basket_amount_eur (copy)_1218294084204867609]) End)/SUM([MoM New Users (copy)_1844716662741729280])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1218294083271852037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Country&apos; THEN [country_code]&#10;WHEN &apos;Month&apos; THEN STR([First Month (copy)_1218294083273842695])&#10;&#10;END' />
      </column>
      <column caption='FDNC Spend' datatype='real' name='[Calculation_1218294083277791240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_lc]) }&#10;WHEN &quot;Euro&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_eur]) }&#10;END' />
      </column>
      <column caption='m_first_new_orders_gmv' datatype='real' name='[Calculation_1218294084191686665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_gmv_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_gmv_eur]&#10;END' />
      </column>
      <column caption='m_returned_customer_gmv' datatype='real' name='[Calculation_1218294084193411084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [returned_customer_gmv_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [returned_customer_gmv_eur]&#10;END' />
      </column>
      <column caption='m_first_new_orders_flgpo' datatype='real' name='[Calculation_1218294084199411727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_flgpo_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_flgpo_eur]&#10;END' />
      </column>
      <column caption='m_first_new_orders_GP' datatype='real' name='[Calculation_1218294084199608336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [first_new_orders_GP_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [first_new_orders_GP_eur]&#10;END' />
      </column>
      <column caption='m_returned_customer_GP' datatype='real' name='[Calculation_1218294084200173587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [returned_customer_GP_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [returned_customer_GP_eur]&#10;END' />
      </column>
      <column caption='m_second_orders_first_month_flgpo' datatype='real' name='[Calculation_1218294084200493076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [second_orders_first_month_flgpo_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [second_orders_first_month_flgpo_eur]&#10;END' />
      </column>
      <column caption='m_monthly_gmv' datatype='real' name='[Calculation_1218294084203610134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [monthly_gmv_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [monthly_gmv_eur]&#10;END' />
      </column>
      <column caption='m_monthly_delivery_fee' datatype='real' name='[Calculation_1218294084203790359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN [monthly_delivery_fee_lc]&#10;WHEN &quot;Euro&quot;&#10;THEN [monthly_delivery_fee_eur]&#10;END' />
      </column>
      <column caption='%Order Share' datatype='real' default-format='p0.00%' name='[Calculation_17592228894392320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MoM New Users (copy)_1844716662741729280])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
      </column>
      <column caption='Definitation' datatype='string' name='[Calculation_17592228900638722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 3]&#10;WHEN &apos;FDNC Spend&apos; THEN &quot;Total opportunity Cost by FDNC&quot;&#10;ELSE &quot;TBA&quot;&#10;END' />
      </column>
      <column caption='Impact on DF' datatype='real' default-format='p0.00%' name='[Calculation_17592229188472837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([dps_incentive_discount_eur])/(SUM([MoM tGo Orders DF])+SUM([dps_incentive_discount_eur]))&#10;SUM([Calculation_1218294083277791240])/SUM([MoM New Users Orders (copy)_17592229174857731]) * -1' />
      </column>
      <column caption='Acquisition Chart - Measure' datatype='real' name='[Calculation_1770477647728652288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;&#10;WHEN &quot;Users&quot; THEN SUM([Calculation_841610203003039749])&#10;WHEN &quot;Orders&quot; THEN SUM([MoM New Users (copy)_1799469553720156164])&#10;WHEN &quot;Spend&quot; THEN SUM([Calculation_1218294083277791240])&#10;WHEN &quot;CPA&quot; THEN [Calculation_1799469553708007424]&#10;&#10;END' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_1799469553708007424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1218294083277791240])/SUM([Calculation_841610203003039749])' />
      </column>
      <column caption='ROI - GMV (over 6 months)' datatype='real' name='[Calculation_1799469553722785798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1844716664402354208])/SUM([Calculation_1218294083277791240])' />
      </column>
      <column caption='Incremental Users' datatype='real' name='[Calculation_1799469553729581064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([new_users]) * MAX([incremental_users_per])&#13;&#10;SUM([new_users]) * 0.16' />
      </column>
      <column caption='Same Month' datatype='boolean' name='[Calculation_1799469554098814990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cohort_month]&lt;=[order_month]' />
      </column>
      <column caption='Temp' datatype='real' name='[Calculation_1844716664323051537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;       // THEN &#10;       // ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;      // ELSE &#10;        SUM(([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])) )&#10;      // END&#10;&#10;/&#10;&#10;SUM([new_users] - [new_users]/(1+[New_Incremental_Users]) )' />
      </column>
      <column caption='6 Months GMV' datatype='real' name='[Calculation_1844716664402354208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[vertical] : SUM(IF DATEDIFF(&apos;month&apos;, [cohort_month], [order_month]) &lt; [Parameters].[Parameter 2] AND [order_month]&gt;=[cohort_month] THEN [Calculation_1218294084193411084] ELSE 0 END) }' />
      </column>
      <column caption='Greater Month' datatype='boolean' name='[Calculation_1844716664408797218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_month] &gt;= [cohort_month]' />
      </column>
      <column caption='FDNC_ROI' datatype='real' name='[Calculation_1844716664480948263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([6 Months GMV (copy)_1844716664480362534])/SUM([Calculation_1218294083277791240])' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1844716664678146089]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FDNC_Total_New_Orders' datatype='real' name='[Calculation_1844716664694075434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MoM First New Orders (copy)_1844716663119605764]) + SUM([FDNC_MoM First New Orders (copy)_1844716664010522632])' />
      </column>
      <column caption='Retention Rate Orders' datatype='real' name='[Calculation_224194855151603712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returned_customer_orders])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([returned_customer_orders])  END) })' />
      </column>
      <column caption='FDNC_Cohort Return Customers Orders' datatype='real' name='[Calculation_224194855155343362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;    //    THEN &#10;  //      ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;//        ELSE &#10;              // ([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])&#10;              //    SUM([returned_customer_orders]) * [Retention Rate Orders]&#10; &#10;  //      END&#10;&#10;SUM([Calculation_224194855156355076]) * [Calculation_224194855151603712]' />
      </column>
      <column caption='FDNC_First_Cohort_Month_Orders' datatype='real' name='[Calculation_224194855156355076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code],[cohort_month],[vertical]:  &#10;SUM(IF ([cohort_month]=[order_month]) &#10;        THEN &#10;        ([first_new_orders] - [first_new_orders] / (1+[Calculation_2625598611046215681])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[Inc. per first orders (copy)_2625598611047141378]))&#10;END)&#10; }' />
      </column>
      <column caption='GMV Per Order' datatype='real' name='[Calculation_224194855166951431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1218294084193411084])/SUM([returned_customer_orders])' />
      </column>
      <column caption='Inc. per first orders' datatype='real' name='[Calculation_2625598611046215681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATE([cohort_month]) &lt;= DATE(&apos;2024-09-01&apos;) THEN [Blended_New_Incremental_Users]  ELSE [New_Incremental_Users] END' />
      </column>
      <column caption='AB test results' datatype='string' name='[Calculation_2625598611688972292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;https://docs.google.com/spreadsheets/d/1dPTi65coQQ7mrk7Srg7l5AoY7RvxI7zhI3J4FtOi0Pk/edit?gid=923101055#gid=923101055&quot;' />
      </column>
      <column caption='Avg Sales Rev (Ret Orders)' datatype='real' name='[Calculation_2698078435721396224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_sales_revenue_eur]/[returned_customer_orders]' />
      </column>
      <column caption='Month CPO ' datatype='real' name='[Calculation_2698078435726938115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN MAX([CPO_Value_eur])&#10;WHEN &quot;Euro&quot;&#10;THEN MAX([CPO_Value_lc])&#10;END' />
      </column>
      <column caption='Same Verrical' datatype='boolean' name='[Calculation_2763169532868497415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_order_vertical]=[vertical]' />
      </column>
      <column aggregation='CountD' caption='Calculation1' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_305681870413852672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;H&quot;' />
      </column>
      <column caption='Both Months Same' datatype='boolean' name='[Calculation_3700762644532957184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cohort_month]=[order_month]' />
      </column>
      <column caption='Empty' datatype='integer' name='[Calculation_3700762644533927937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Chart Measure - Base' datatype='real' name='[Calculation_3700762644538421251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#10;WHEN &quot;Users&quot; THEN SUM([Calculation_841610203003039749] - [MoM New Users (copy)_1844716663118389251])&#10;WHEN &quot;Orders&quot; THEN SUM([MoM New Users (copy)_1799469553720156164]) - [Calculation_1844716664694075434] &#10;WHEN &quot;GMV&quot; THEN SUM([MoM New Users (copy)_1799469553719791619]) - [FDNC_Total_New_Orders (copy)_1844716664694652971]&#10;WHEN &quot;GP&quot; THEN SUM([MoM New Users GMV (copy)_1844716664375435292]) - [FDNC_Total_New_Orders_GMV (copy)_1844716664694902828]&#10;END' />
      </column>
      <column caption='QC Verticals' datatype='boolean' name='[Calculation_3794704944485224450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [first_order_vertical]&#10;WHEN &apos;tMart&apos; THEN TRUE &#10;WHEN &apos;LS&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='FD Order Share%' datatype='real' name='[Calculation_3794704944486727683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([FDNC Spend (copy)_3794704944484917249])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_390687324219920388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#10;[cohort_month] &gt;= DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])) &#10;//[Start Date] - (DATEDIFF(&apos;day&apos;,[Start Date], [End Date])+1)&#10;and [cohort_month] &lt;= DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])) )))&#10;//[End Date]-(DATEDIFF(&apos;day&apos;,[Start Date], [End Date])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[cohort_month] &gt;= [Parameters].[Parameter 8] and [cohort_month] &lt;= [Parameters].[Start Date (copy)_390687324220837895]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
      </column>
      <column caption='Default Start Date' datatype='datetime' name='[Calculation_390687324220088325]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))' />
      </column>
      <column caption='temp 1' datatype='datetime' name='[Calculation_390687324224483336]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Start Date]))&#10;DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])))))' />
      </column>
      <column caption='FD Orders Diff' datatype='real' name='[Calculation_390687324956213258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([cohort_month] &gt;= [Parameters].[Parameter 8] AND [cohort_month] &lt;= [Parameters].[Start Date (copy)_390687324220837895]) THEN&#10;(ZN([Calculation_3794704944486727683]) - LOOKUP(ZN([Calculation_3794704944486727683]), -1)) / ABS(LOOKUP(ZN([Calculation_3794704944486727683]), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dim FD Order Share' datatype='string' name='[Calculation_4912512457557733381]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FD Order Share&quot;' />
      </column>
      <column caption='FD Sign up' datatype='string' name='[Calculation_4912512457559744519]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_390687324956213258] &gt;= 0 THEN &quot;▲&quot;&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cohort Metric' datatype='real' name='[Calculation_841610199226773504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN SUM([new_users]) + SUM ([returned_customers])&#13;&#10;WHEN &apos;Orders&apos; THEN SUM([returned_customer_orders]) &#13;&#10;WHEN &apos;GMV&apos; THEN  SUM([Calculation_1218294084193411084])&#10;WHEN &apos;Net GP&apos; THEN  ([Calculation_841610202394591236])&#13;&#10;WHEN &apos;Order Frequency&apos; THEN [Net GP (copy)_1799469553759350795]&#13;&#10;WHEN &apos;GPO&apos; THEN [GMV Per Order (copy)_224194855169228808]&#10;WHEN &apos;FLGP&apos; THEN  SUM([m_first_new_orders_flgpo (copy)_1218294084199936018])&#10;WHEN &apos;AFV&apos; THEN  SUM([m_first_new_orders_basket_amount (copy)_1218294084205154330])/SUM([returned_customer_orders]) &#13;&#10;END' />
      </column>
      <column caption='%Cohort Metric' datatype='real' default-format='p0%' name='[Calculation_841610199446482946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Cohort Metric]) /[Fixed_Cohort_Mertic]&#10;&#10;(ZN([Calculation_841610199226773504]) - LOOKUP(ZN([Calculation_841610199226773504]), FIRST())) / ABS(LOOKUP(ZN([Calculation_841610199226773504]), FIRST()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Net GP' datatype='real' name='[Calculation_841610202394591236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Calculation_3700762644532957184]) = TRUE THEN&#10;&#10;IF SUM([Calculation_1218294084200173587])&lt;0 THEN &#10;&#10;SUM([Calculation_1218294084200173587]) - SUM(IFNULL([Calculation_1218294083277791240],0))&#10;&#10;ELSE &#10;&#10;SUM([Calculation_1218294084200173587]) - SUM(IFNULL([Calculation_1218294083277791240],0))&#10;&#10;END&#10;&#10;ELSE &#10;SUM([Calculation_1218294084200173587])&#10;END' />
      </column>
      <column caption='MoM New Users' datatype='integer' name='[Calculation_841610203003039749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [new_users] END' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_908179072259457030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Cohort Analysis Definitaions' datatype='string' name='[Calculation_908179072263376903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Users&apos; THEN &quot;No. of users acquired in the cohort, and the number of returning users from that cohort in subsequent months&quot;&#10;WHEN &apos;Orders&apos; THEN &quot;No. of orders placed by new users, and the number of returning 2nd &amp; beyond orders from that cohort in subsequent months&quot;&#10;WHEN &apos;GMV&apos; THEN &quot;Total GMV produced from orders placed by new users from that cohort in subsequent months&quot;&#10;WHEN &apos;Order Frequency&apos; THEN &quot;Average number of orders placed per customer&quot;&#10;WHEN &apos;Net GP&apos; THEN &quot;Total gross profit - FDNC spend, this indicates the net of cost to fund FD and the profit generated from the incremental orders gained through FDNC&quot;&#10;WHEN &apos;GPO&apos; THEN &quot;Gross profit per order (gross profit / number of orders)&quot;&#10;WHEN &apos;FLGP&apos; THEN &quot;Fully loaded gross profit per order&quot;&#10;WHEN &apos;AFV&apos; THEN &quot;Average food value&quot;&#10;END' />
      </column>
      <column caption='Subsequent Orders Vertical' datatype='string' name='[Calculation_908179072284233736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_order_vertical] = [vertical] &#10;THEN &apos;Same Vertical&apos;&#10;ELSE &apos;All Verticals&apos;&#10;END' />
      </column>
      <column caption='Chart Measure - Inc ' datatype='real' name='[Chart Measure - Base (copy)_3700762644538621956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#10;WHEN &quot;Users&quot; THEN SUM([MoM New Users (copy)_1844716663118389251])&#10;WHEN &quot;Orders&quot; THEN ([Calculation_1844716664694075434])&#10;WHEN &quot;GMV&quot; THEN ([FDNC_Total_New_Orders (copy)_1844716664694652971])&#10;WHEN &quot;GP&quot; THEN ([FDNC_Total_New_Orders_GMV (copy)_1844716664694902828])&#10;END' />
      </column>
      <column caption='FDNC_Cohort Metric' datatype='real' name='[Cohort Metric (copy)_1844716663124791301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN (SUM([new_users] - [new_users]/(1+[Calculation_2625598611046215681]) )) + (SUM([returned_customers] - [returned_customers]/(1+[Calculation_2625598611046215681]) ))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN  &#13;&#10;    (&#13;&#10;&#13;&#10;[Calculation_224194855155343362]&#13;&#10;)&#13;&#10;&#13;&#10;WHEN &apos;Order Frequency&apos; THEN &#13;&#10;[Order Frequency (copy)_224194855162732550]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Net GP&apos; THEN  &#13;&#10;    (&#13;&#10;    (IF MAX([Calculation_3700762644532957184]) = TRUE &#13;&#10;        THEN &#13;&#10;        SUM(([Calculation_1218294084199608336] - [Calculation_1218294084199608336] / (1+[Calculation_2625598611046215681])) + ([m_second_orders_first_month_flgpo (copy)_1218294084200714261] - [m_second_orders_first_month_flgpo (copy)_1218294084200714261] / (1+[Inc. per first orders (copy)_2625598611047141378])))&#13;&#10;        - SUM(IFNULL([Calculation_1218294083277791240],0))&#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] )&#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;&#13;&#10;WHEN &apos;GMV&apos; THEN  &#13;&#10;   &#13;&#10;[Calculation_1123296299820105729]&#13;&#10;&#13;&#10;WHEN &apos;FLGP&apos; THEN  &#13;&#10;   &#13;&#10;[FDNC_Cohor Return Customers GMV (copy)_1170584071163981826]&#13;&#10;&#13;&#10;WHEN &apos;AFV&apos; THEN  &#13;&#10;   &#13;&#10;SUM([m_first_new_orders_basket_amount (copy)_1218294084205154330])/SUM([returned_customer_orders])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;GPO&apos; THEN&#13;&#10;&#13;&#10;   (&#13;&#10;    (IF MAX([cohort_month]=[order_month]) &#13;&#10;        THEN &#13;&#10;        SUM(([Calculation_1218294084199608336] - [Calculation_1218294084199608336] / (1+[Calculation_2625598611046215681])) + ([m_second_orders_first_month_flgpo (copy)_1218294084200714261] - [m_second_orders_first_month_flgpo (copy)_1218294084200714261] / (1+[Inc. per first orders (copy)_2625598611047141378])))&#13;&#10;        &#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;/&#13;&#10;[Calculation_224194855155343362]&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Area Metric' datatype='integer' name='[Cohort Metric (copy)_908179071959064578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Cohort Metric (copy)_908179071958814721]&#13;&#10;WHEN &apos;New Users&apos; THEN SUM([new_users])&#10;WHEN &apos;Orders&apos; THEN SUM([MoM New Users (copy)_1799469553720156164])&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
