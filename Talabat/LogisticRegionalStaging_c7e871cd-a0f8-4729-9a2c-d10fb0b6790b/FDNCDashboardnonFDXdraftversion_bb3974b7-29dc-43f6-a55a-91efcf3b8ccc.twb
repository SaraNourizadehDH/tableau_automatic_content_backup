      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0u3a8w80tjcboo120y90w0g3evru].[Calculation_390687324220088325]' caption='Start Date' datatype='date' default-format='*dd-mmm-yy' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0u3a8w80tjcboo120y90w0g3evru].[Default Start Date (copy)_390687324220571654]' caption='End Date' datatype='date' default-format='*dd-mmm-yy' name='[Start Date (copy)_390687324220837895]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-31#'>
              <calculation class='tableau' formula='#2025-07-31#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru'>
            <column caption='FDNC Spend' datatype='real' name='[Calculation_1218294083277791240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Local&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_lc]) }&#10;WHEN &quot;Euro&quot;&#10;THEN { FIXED [country_code (copy)_2821294105585311744],[First Month (copy)_1218294083273842695],[first_order_vertical],[customer_type]: MAX([dps_incentive_discount_eur]) }&#10;END' />
            </column>
            <column caption='Impact on DF' datatype='real' default-format='p0.00%' name='[Calculation_17592229188472837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([dps_incentive_discount_eur])/(SUM([MoM tGo Orders DF])+SUM([dps_incentive_discount_eur]))&#10;SUM([Calculation_1218294083277791240])/SUM([MoM New Users Orders (copy)_17592229174857731]) * -1' />
            </column>
            <column caption='Same Verrical' datatype='boolean' name='[Calculation_2763169532868497415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[first_order_vertical]=[vertical]' />
            </column>
            <column caption='Both Months Same' datatype='boolean' name='[Calculation_3700762644532957184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cohort_month]=[order_month]' />
            </column>
            <column caption='FD Order Share%' datatype='real' name='[Calculation_3794704944486727683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FDNC Spend (copy)_3794704944484917249])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_390687324219920388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#10;[cohort_month] &gt;= DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])) &#10;//[Start Date] - (DATEDIFF(&apos;day&apos;,[Start Date], [End Date])+1)&#10;and [cohort_month] &lt;= DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])) )))&#10;//[End Date]-(DATEDIFF(&apos;day&apos;,[Start Date], [End Date])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[cohort_month] &gt;= [Parameters].[Parameter 8] and [cohort_month] &lt;= [Parameters].[Start Date (copy)_390687324220837895]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
            </column>
            <column caption='Default Start Date' datatype='datetime' name='[Calculation_390687324220088325]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='FD Orders Diff' datatype='real' name='[Calculation_390687324956213258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([cohort_month] &gt;= [Parameters].[Parameter 8] AND [cohort_month] &lt;= [Parameters].[Start Date (copy)_390687324220837895]) THEN&#10;(ZN([Calculation_3794704944486727683]) - LOOKUP(ZN([Calculation_3794704944486727683]), -1)) / ABS(LOOKUP(ZN([Calculation_3794704944486727683]), -1))&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='FD Sign up' datatype='string' name='[Calculation_4912512457559744519]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_390687324956213258] &gt;= 0 THEN &quot;▲&quot;&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Default End Date' datatype='datetime' name='[Default Start Date (copy)_390687324220571654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,TODAY()) -1' />
            </column>
            <column caption='Dim Impact on ADF' datatype='string' name='[Dim FD Order Share (copy)_4912512457558192134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Impact on ADF&quot;' />
            </column>
            <column caption='Impact on ADF (SP)' datatype='real' default-format='p0.00%' name='[FD Order Share% (SP) (copy)_4912512457554227202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE MAX([Calculation_390687324219920388]) WHEN &apos;Selected Period&apos; &#10;THEN [Calculation_17592229188472837] END' />
            </column>
            <column caption='Impact on ADF Diff' datatype='real' default-format='p0%' name='[FD Orders Diff (copy)_4912512457554333699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([cohort_month] &gt;= [Parameters].[Parameter 8] AND [cohort_month] &lt;= [Parameters].[Start Date (copy)_390687324220837895]) THEN&#10;(ZN([Calculation_17592229188472837]) - LOOKUP(ZN([Calculation_17592229188472837]), -1)) / ABS(LOOKUP(ZN([Calculation_17592229188472837]), -1))&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='FD Sign Down' datatype='string' name='[FD Sign up (copy)_4912512457560940552]' role='measure' type='nominal'>
