    <worksheet name='#New Users By Area'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>#New Users By Area</run>
            <run fontname='Tableau Regular' fontsize='9'>Æ </run>
            <run fontname='Tableau Regular' fontsize='8'><![CDATA[(<[federated.0u3a8w80tjcboo120y90w0g3evru].[none:city_name:nk]>, <[federated.0u3a8w80tjcboo120y90w0g3evru].[attr:country_name:nk]>)]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Area Metric' datatype='string' name='[Cohort Metric (copy)_908179071958814721]' param-domain-type='list' role='measure' type='nominal' value='&quot;New Users&quot;'>
              <calculation class='tableau' formula='&quot;New Users&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru'>
            <column caption='Area Metric' datatype='integer' name='[Cohort Metric (copy)_908179071959064578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Cohort Metric (copy)_908179071958814721]&#13;&#10;WHEN &apos;New Users&apos; THEN SUM([new_users])&#10;WHEN &apos;Orders&apos; THEN SUM([MoM New Users (copy)_1799469553720156164])&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='MoM New Users Orders' datatype='integer' name='[MoM New Users (copy)_1799469553720156164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_orders] END' />
            </column>
            <column caption='Area Name' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column-instance column='[city_name]' derivation='Attribute' name='[attr:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='Attribute' name='[attr:country_name:nk]' pivot='key' type='nominal' />
