            <column caption='tPro Tmart chargeback' datatype='real' default-format='n#,##0;(#,##0)' name='[tPro Tmart chargeback. (copy)_6304828382441889814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( if [finance_vertical]==&quot;tmart&quot; then -([tpro_discount]) end,0)' />
