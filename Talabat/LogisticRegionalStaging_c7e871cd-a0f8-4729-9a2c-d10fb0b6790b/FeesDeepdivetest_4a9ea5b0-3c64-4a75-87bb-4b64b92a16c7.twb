            <column caption='% To tmart / Paid  ' datatype='real' default-format='p0.00%' name='[% To Vendors / Paid  (copy)_1046805473367978013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1046805473040928774])/sum([delivery_fee])' />
