  <worksheets>
    <worksheet name='Averages'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#666666' fontsize='9'>Delivery revenues divided by order counts</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontsize='9'>(Excluding VAT)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DF' name='federated.0cod0mp1d6beis1b1rf8w1yznj4x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='VAT Application' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclusive&quot;'>
              <calculation class='tableau' formula='&quot;Exclusive&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cod0mp1d6beis1b1rf8w1yznj4x'>
            <column caption='Tmart Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1046805473036275713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [finance_vertical]=&apos;tmart&apos; then [orders_count] else 0 end&#10;// if [Is Darkstore] and [Is Tgo] then [Orders Count] else 0 end' />
            </column>
            <column caption='tmart charge back Delivery Fee (exc. VAT)' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_1046805473040928774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// -ifnull( IF ([Is Darkstore]) then [To Vendor DF]-[Tax Delivery Fee] end,0)&#10;-IFNULL( if [finance_vertical]==&quot;tmart&quot; then [to_vendor_df]-[Calculation_3267361598178299915] end,0)' />
            </column>
            <column caption='Custom Dimension' datatype='string' name='[Calculation_1046805473378340899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1] when &apos;Country&apos; then [country_code]&#10;when &apos;City&apos; then [city_name]&#13;&#10;when &apos;Day&apos; then STR([order_date])&#13;&#10;when &apos;Month&apos; then STR(DATE(DATETRUNC(&apos;month&apos;,[order_date])))&#13;&#10;when &apos;Week&apos; then STR(DATE(DATETRUNC(&apos;week&apos;,[order_date])))&#13;&#10;when &apos;Finance Vertical&apos; then [finance_vertical]&#10;when &apos;Vertical&apos; then [vertical]&#13;&#10;when &apos;Scheme&apos; THEN [scheme_name]&#13;&#10;when &apos;Assignment&apos; then [vendor_price_scheme_type] end' />
            </column>
            <column caption='is_tmp' datatype='boolean' name='[Calculation_1317865872270700553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement]=&apos;TMP&apos;' />
            </column>
            <column caption='is_pickup' datatype='boolean' name='[Calculation_1317865872270848010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement]=&apos;PICKUP&apos;' />
            </column>
            <column caption='sum(null)' datatype='integer' name='[Calculation_1332784077100810241]' role='measure' type='quantitative' user:unnamed='Averages'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column caption='Tax Delivery Fee' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178299915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_tgo] then -[tax_delivery_fee] end' />
            </column>
            <column caption='Tax Service Fee' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178443276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(-[tax_service_fee],0)' />
            </column>
            <column caption='Vendor charge back Delivery Fee TGO' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178709517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_darkstore] and [is_tgo] then -[Paid back to tmart (copy)_1046805473041207303] end' />
            </column>
            <column caption='TGO Restaurant Orders' datatype='integer' name='[Calculation_4253860973262422016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] and [finance_vertical]=&apos;food&apos; and not [is_finance_kitchen] then [orders_count] else 0 end)&#10;//sum(if [Is Tgo] and [Vertical]=&apos;food&apos; and not [is_finance_kitchen] and not [Is Darkstore] then [Orders Count] else 0 end)' />
            </column>
            <column caption='Total Service Fees Revenue' datatype='real' name='[Calculation_4253860974626738194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_6304828382436282385],0)+&#10;IFNULL([Service fee (TMP) (exc VAT). (todo) (copy)_6304828382440648724],0)+&#10;IFNULL([Service fee TGO (inc VAT) (copy)_4253860974223302673],0)+&#10;IFNULL([Calculation_3267361598178443276],0)+&#10;IFNULL([tmart charge back DF (copy)_6304828381876359172],0)' />
            </column>
            <column caption='Total Small Order Fees Revenue' datatype='real' name='[Calculation_4253860974630891539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Small order fee (inc VAT). (copy)_6304828382441062421])+&#10;sum([Tax SOF. (copy)_6304828382439911442])' />
            </column>
            <column caption='DF/Order Restaurants' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4253860974637907988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6813383310494674944]-if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - TGO Restaurants (copy)_815292317248401410] else 0 end) / [Calculation_4253860973262422016]' />
            </column>
            <column caption='Total TGO Orders' datatype='integer' name='[Calculation_4253860975616290845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] then [orders_count] end)' />
            </column>
            <column caption='Sub Vertical' datatype='string' name='[Calculation_4559894652636295168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [sub_vertical]&#10;when &quot;N/A&quot; then NULL&#10;WHEN NULL then NULL&#10;ELSE [sub_vertical]&#10;end' />
            </column>
            <column caption='Service fee TGO (inc VAT)' datatype='real' name='[Calculation_6304828382436282385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [service_fee] end' />
            </column>
            <column caption='Delivery Fee Revenue - TGO Restaurants' datatype='real' name='[Calculation_6813383310494674944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] and [finance_vertical]=&apos;food&apos; and not [is_finance_kitchen] then [Total TGO Delivery Revenue (copy)_1317865872245325827] end)' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_6813383310547472394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4253860973262422016]+[TGO Food Orders (copy)_4253860973478068225]+sum([Calculation_1046805473036275713])&#10;+[TGO Restaurant Orders (copy)_4253860973510807556]+[Pickup Orders (copy)_4253860973520044045]' />
            </column>
            <column caption='sum(null)' datatype='integer' name='[Calculation_6813383310782947355]' role='measure' type='quantitative' user:unnamed='Averages New'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column caption='sum(null)' datatype='integer' name='[Calculation_6813383310783385630]' role='measure' type='quantitative' user:unnamed='Averages New'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column caption='sum(null)' datatype='integer' name='[Calculation_6813383310787805216]' role='measure' type='quantitative' user:unnamed='Averages New'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column caption='sum(null)' datatype='integer' name='[Calculation_6813383310787866658]' role='measure' type='quantitative' user:unnamed='Averages New'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column caption='DF/Order NFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Food (copy)_4253860974711341077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Delivery Revenue - TGO Restaurants (copy)_6813383310539218950] -if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - TGO Non-Food (copy)_815292317248401413] else 0 end)/ [TGO Food Orders (copy)_4253860973478068225]' />
            </column>
            <column caption='DF/Order Tmart (BH)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Kitchens (copy)_3245828755004108800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Delivery Revenue - NFV (copy)_1317865872249585669]-if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - tMart (copy)_815292317248401411] else 0 end) / sum(if [country_code]==&apos;BH&apos; then [Calculation_1046805473036275713] end)' />
            </column>
            <column caption='DF/Order LAAS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Kitchens (copy)_4253860975610544155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Delivery Revenue - TGO Kitchens (copy)_1317865872249933830] -if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - TGO LAAS (copy)_815292317248401412] else 0 end) / [Pickup Orders (copy)_4253860973520044045]' />
            </column>
            <column caption='SF/Order TGO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Kitchens (copy)_4253860975611654172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Delivery Revenue - TGO Kitchens (copy)_1317865872252551175] - sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Tax Service Fee (copy)_815292317254889478] else 0 end) )/ [Calculation_4253860975616290845]' />
            </column>
            <column caption='DF/Order Overall' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Kitchens (copy)_6813383310549094412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Total TGO Delivery Revenue (copy)_1317865872245325827])-sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Calculation_3267361598178299915] else 0 end) )/[Calculation_6813383310547472394]' />
            </column>
            <column caption='DF/Order Kitchens' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order Restaurants (copy)_4253860975608447001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Delivery Revenue - TGO Restaurants (copy)_6813383310545461256]-if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - TGO Kitchens (copy)_815292317247860736] else 0 end)  / [TGO Restaurant Orders (copy)_4253860973510807556]' />
            </column>
            <column caption='tMart CPO crosscharge less tpro Tmart chargeback' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DF/Order TGO tMart - CPO Cross Charge less Tpro delivery Funded (copy)_6813383310498430981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;  sum(if [country_code] != &apos;BH&apos; then [Tmart cross charge. (todo) (copy)_6304828382250143759] end )&#10;  +sum(if [country_code] != &apos;BH&apos; then [tPro Tmart chargeback. (copy)_6304828382441889814] end)  &#10;  -if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Delivery Fee Revenue - tMart (copy)_815292317248401411] else 0 end&#10;) &#10;/ &#10;sum(if [country_code] != &apos;BH&apos; then [Calculation_1046805473036275713] end)' />
            </column>
            <column caption='Tax Delivery fee TGO Kitchens' datatype='real' name='[Delivery Fee Revenue - TGO Kitchens (copy)_815292317247860736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] and [finance_vertical]==&apos;food&apos; and [is_finance_kitchen] then [Calculation_3267361598178299915] end)' />
            </column>
            <column caption='Tax Delivery Fee - TGO LAAS' datatype='real' name='[Delivery Fee Revenue - TGO LAAS (copy)_815292317248401412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;LAAS&apos; then [Calculation_3267361598178299915] end)' />
            </column>
            <column caption='Tax Delivery Fee - TGO Non-Food' datatype='real' name='[Delivery Fee Revenue - TGO Non-Food (copy)_815292317248401413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;NFV&apos; then [Calculation_3267361598178299915] end)' />
            </column>
            <column caption='Tax Delivery Fee - TGO Restaurants' datatype='real' name='[Delivery Fee Revenue - TGO Restaurants (copy)_815292317248401410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] and [finance_vertical]=&apos;food&apos; and not [is_finance_kitchen] then [Calculation_3267361598178299915] end)' />
            </column>
            <column caption='Tax Delivery Fee Revenue - tMart' datatype='real' name='[Delivery Fee Revenue - tMart (copy)_815292317248401411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;tmart&apos; then [Calculation_3267361598178299915] end)' />
            </column>
            <column caption='Delivery Fee Revenue - tMart' datatype='real' name='[Delivery Revenue - NFV (copy)_1317865872249585669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;tmart&apos; then [Total TGO Delivery Revenue (copy)_1317865872245325827] end)' />
            </column>
            <column caption='Delivery Fee Revenue - TGO LAAS' datatype='real' name='[Delivery Revenue - TGO Kitchens (copy)_1317865872249933830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;LAAS&apos; then [Total TGO Delivery Revenue (copy)_1317865872245325827] end)' />
            </column>
            <column caption='Service Fee Revenue - TGO' datatype='real' name='[Delivery Revenue - TGO Kitchens (copy)_1317865872252551175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] then [Calculation_4253860974626738194] end)' />
            </column>
            <column caption='Delivery Fee Revenue - TGO Non-Food' datatype='real' name='[Delivery Revenue - TGO Restaurants (copy)_6813383310539218950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]==&apos;NFV&apos; then [Total TGO Delivery Revenue (copy)_1317865872245325827] end)' />
            </column>
            <column caption='Delivery Fee Revenue - TGO Kitchens' datatype='real' name='[Delivery Revenue - TGO Restaurants (copy)_6813383310545461256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_tgo] and [finance_vertical]==&apos;food&apos; and [is_finance_kitchen] then [Total TGO Delivery Revenue (copy)_1317865872245325827] end)' />
            </column>
            <column caption='Delivery fee TGO (inc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[Delivery fee (inc VAT) (copy)_6304828382435926032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [delivery_fee] end' />
            </column>
            <column caption='LAAS fee revenue (exc. VAT)' datatype='real' name='[LAAS fee revenue (exc. VAT). (todo) (copy)_6304828382443151385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([laas_revenue],0)' />
            </column>
            <column caption='Charge back DF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Paid back to tmart (copy)_1046805473041207303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull( if( [vertical]&lt;&gt;&apos;darkstores&apos;) then [to_vendor_df] end,0)' />
            </column>
            <column caption='LAAS Orders' datatype='integer' name='[Pickup Orders (copy)_4253860973520044045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [finance_vertical]=&apos;LAAS&apos; then [orders_count] else 0 end)' />
            </column>
            <column caption='SF/Order Overall' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[SF/Order Pickup (copy)_4253860975617183776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_4253860974626738194])- sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Calculation_3267361598178443276] else 0 end) ) / ([Calculation_4253860975616290845]+[TGO NFV Orders (copy)_4253860973478453251]+[TMP Orders (copy)_4253860973511254021])' />
            </column>
            <column caption='SOF/Order TGO Restaurants' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[SF/Order Pickup (copy)_4253860975617691681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4253860974630891539] - sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Tax SOF. (copy)_6304828382439911442] else 0 end) ) / [Calculation_4253860973262422016]' />
            </column>
            <column caption='SF/Order TMP' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[SF/Order TGO (copy)_4253860975616872478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Service Fee Revenue - TGO (copy)_1317865872268832776] - sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Tax Service Fee TGO orders (copy)_815292317255487495] else 0 end) )/ [TGO NFV Orders (copy)_4253860973478453251]' />
            </column>
            <column caption='SF/Order Pickup' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[SF/Order TMP (copy)_4253860975617040415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Service Fee Revenue - TMP (copy)_1317865872271077387] - sum(if [Parameters].[Parameter 2]==&apos;Inclusive&apos; then [Tax Service Fee TGO orders (copy)_815292317255577608] else 0 end) ) / [TMP Orders (copy)_4253860973511254021]' />
            </column>
            <column caption='Service Fee Revenue - TMP' datatype='real' name='[Service Fee Revenue - TGO (copy)_1317865872268832776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_1317865872270700553] then [Calculation_4253860974626738194] end)' />
            </column>
            <column caption='Service Fee Revenue - PICKUP' datatype='real' name='[Service Fee Revenue - TMP (copy)_1317865872271077387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_1317865872270848010] then [Calculation_4253860974626738194] end)' />
            </column>
            <column caption='Service fee TMP (inc VAT)' datatype='real' name='[Service fee (TMP) (exc VAT). (todo) (copy)_6304828382440648724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( IF not [is_tgo] then [service_fee] end,0)' />
            </column>
            <column caption='Service fee Pickup (inc VAT)' datatype='real' name='[Service fee TGO (inc VAT) (copy)_4253860974223302673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( IF [delivery_arrangement]=&apos;PICKUP&apos; then [service_fee] end,0)' />
            </column>
            <column caption='Small order fee (inc VAT)' datatype='real' default-format='n#,##0;(#,##0)' name='[Small order fee (inc VAT). (copy)_6304828382441062421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [small_order_fee] end' />
