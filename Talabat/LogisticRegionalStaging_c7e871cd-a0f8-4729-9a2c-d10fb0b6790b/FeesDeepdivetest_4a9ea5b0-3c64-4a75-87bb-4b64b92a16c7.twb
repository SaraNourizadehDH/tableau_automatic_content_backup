                <zone forceUpdate='true' h='2900' id='315' type-v2='text' w='89000' x='500' y='58000'>
                  <formatted-text>
                    <run fontcolor='#333333' fontsize='15'>Averages</run>
                    <run>
Delivery revenues divided by order counts

Select whether to see the averages inclusive or exclusive of VAT. Only applicable to customer paid fees.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
