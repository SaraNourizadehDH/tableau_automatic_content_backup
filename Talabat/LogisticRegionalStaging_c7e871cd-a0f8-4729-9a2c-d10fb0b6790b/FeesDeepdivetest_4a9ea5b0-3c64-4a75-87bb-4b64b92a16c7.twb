    <worksheet name='Potential DF Breakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='DF' name='federated.0cod0mp1d6beis1b1rf8w1yznj4x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cod0mp1d6beis1b1rf8w1yznj4x'>
            <column caption='% Net DF / Potential' datatype='real' default-format='p0.00%' name='[% Net DF / Paid (copy)_1046805473368526879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_6304828381755121665])/[Estimated fees income without incentives. (copy)_6304828382445183004]' />
            </column>
            <column caption='% tmart CPO / Potential' datatype='real' default-format='p0.00%' name='[% Net DF / Potential (copy)_1046805473368637472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6304828381754482688]/[Estimated fees income without incentives. (copy)_6304828382445183004]' />
            </column>
            <column caption='% incentives / Potential' datatype='real' default-format='p0.00%' name='[% tmart CPO / Potential (copy)_1046805473368772641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1795528909289050112])/[Estimated fees income without incentives. (copy)_6304828382445183004]' />
            </column>
            <column caption='tmart charge back Delivery Fee (exc. VAT)' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_1046805473040928774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// -ifnull( IF ([Is Darkstore]) then [To Vendor DF]-[Tax Delivery Fee] end,0)&#10;-IFNULL( if [finance_vertical]==&quot;tmart&quot; then [to_vendor_df]-[Calculation_3267361598178299915] end,0)' />
            </column>
            <column caption='Custom Dimension' datatype='string' name='[Calculation_1046805473378340899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1] when &apos;Country&apos; then [country_code]&#10;when &apos;City&apos; then [city_name]&#13;&#10;when &apos;Day&apos; then STR([order_date])&#13;&#10;when &apos;Month&apos; then STR(DATE(DATETRUNC(&apos;month&apos;,[order_date])))&#13;&#10;when &apos;Week&apos; then STR(DATE(DATETRUNC(&apos;week&apos;,[order_date])))&#13;&#10;when &apos;Finance Vertical&apos; then [finance_vertical]&#10;when &apos;Vertical&apos; then [vertical]&#13;&#10;when &apos;Scheme&apos; THEN [scheme_name]&#13;&#10;when &apos;Assignment&apos; then [vendor_price_scheme_type] end' />
            </column>
            <column caption='Incentives' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1795528909289050112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([vendor_price_scheme_type]==&apos;Campaign&apos;) then [standard_fee]-[delivery_fee] else 0 end' />
            </column>
            <column caption='Tax Delivery Fee' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178299915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_tgo] then -[tax_delivery_fee] end' />
            </column>
            <column caption='Tax Service Fee' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178443276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(-[tax_service_fee],0)' />
            </column>
            <column caption='Vendor charge back Delivery Fee TGO' datatype='real' default-format='n#,##0;(#,##0)' name='[Calculation_3267361598178709517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_darkstore] and [is_tgo] then -[Paid back to tmart (copy)_1046805473041207303] end' />
            </column>
            <column caption='Sub Vertical' datatype='string' name='[Calculation_4559894652636295168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [sub_vertical]&#10;when &quot;N/A&quot; then NULL&#10;WHEN NULL then NULL&#10;ELSE [sub_vertical]&#10;end' />
            </column>
            <column caption='Net DF new' datatype='real' name='[Calculation_6304828381755121665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee])-sum([tax_delivery_fee])-sum([to_vendor_df])' />
            </column>
            <column caption='Service fee TGO (inc VAT)' datatype='real' name='[Calculation_6304828382436282385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [service_fee] end' />
            </column>
            <column caption='Delivery fee TGO (inc VAT)' datatype='real' default-format='n#,##0;-#,##0' name='[Delivery fee (inc VAT) (copy)_6304828382435926032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [delivery_fee] end' />
            </column>
            <column caption='Estimated fees income without incentives' datatype='real' default-format='n#,##0;-#,##0' name='[Estimated fees income without incentives. (copy)_6304828382445183004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Fees income after deductions (P&amp;L). (copy)_6304828382443274266]+[Calculation_1795528909289050112]' />
            </column>
            <column caption='Fees after tax' datatype='real' default-format='n#,##0;-#,##0' name='[Fees after tax. (copy)_6304828382440345619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery fee (inc VAT) (copy)_6304828382435926032]+[Calculation_6304828382436282385]+ [Service fee (TMP) (exc VAT). (todo) (copy)_6304828382440648724]&#10;+[Small order fee (inc VAT). (copy)_6304828382441062421]&#10;+[Calculation_3267361598178299915]+[Calculation_3267361598178443276]+[Tax SOF. (copy)_6304828382439911442]' />
            </column>
            <column caption='Fees income after deductions (P&amp;L)' datatype='real' default-format='n#,##0;-#,##0' name='[Fees income after deductions (P&amp;L). (copy)_6304828382443274266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Fees after tax. (copy)_6304828382440345619]&#10;+[Calculation_1046805473040928774]&#10;+[tmart charge back DF (copy)_6304828381876359172]&#10;+[tmart charge back DF (copy)_6304828381876785158]&#10;+[tPro Tmart chargeback. (copy)_6304828382441889814]&#10;+[Calculation_3267361598178709517]&#10;+[tPro Vendor Comission (exc VAT). (copy)_6304828382442491927]&#10;+[Vendor funded Revenue (exc VAT). (todo) (copy)_6304828382442958872]&#10;+[LAAS fee revenue (exc. VAT). (todo) (copy)_6304828382443151385]' />
            </column>
            <column caption='LAAS fee revenue (exc. VAT)' datatype='real' name='[LAAS fee revenue (exc. VAT). (todo) (copy)_6304828382443151385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([laas_revenue],0)' />
            </column>
            <column caption='Charge back DF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Paid back to tmart (copy)_1046805473041207303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull( if( [vertical]&lt;&gt;&apos;darkstores&apos;) then [to_vendor_df] end,0)' />
            </column>
            <column caption='Service fee TMP (inc VAT)' datatype='real' name='[Service fee (TMP) (exc VAT). (todo) (copy)_6304828382440648724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( IF not [is_tgo] then [service_fee] end,0)' />
            </column>
            <column caption='Small order fee (inc VAT)' datatype='real' default-format='n#,##0;(#,##0)' name='[Small order fee (inc VAT). (copy)_6304828382441062421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_tgo] then [small_order_fee] end' />
            </column>
            <column caption='Tax Small Order Fee' datatype='real' default-format='n#,##0;(#,##0)' name='[Tax SOF. (copy)_6304828382439911442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( if [is_tgo] then -[tax_small_order_fee] end ,0)' />
            </column>
            <column caption='Vendor funded Revenue (exc VAT) (partial*)' datatype='real' name='[Vendor funded Revenue (exc VAT). (todo) (copy)_6304828382442958872]' role='measure' type='quantitative'>
