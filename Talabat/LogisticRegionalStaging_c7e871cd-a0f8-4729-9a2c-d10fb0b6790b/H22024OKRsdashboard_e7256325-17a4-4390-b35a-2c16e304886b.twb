      <column caption='Targets (mid)' datatype='real' name='[Key Results (mid) (copy)_1093811792055738372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN ROUND(FLOAT([Targets])* 100, 1)&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN ROUND(FLOAT([Targets])* 100, 1)&#13;&#10;    WHEN &quot;Rider Quality Score&quot; THEN ROUND(FLOAT([Targets])* 100)&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN ROUND(FLOAT([Targets])* 100)&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN ROUND(FLOAT([Targets]), 1)&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN ROUND(FLOAT([Targets])*100, 1)&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN ROUND(FLOAT([Targets]), 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN ROUND(FLOAT([Targets]))&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN ROUND(FLOAT([Targets]))&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;&#13;&#10;&#13;&#10;    ELSE ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;END' />
