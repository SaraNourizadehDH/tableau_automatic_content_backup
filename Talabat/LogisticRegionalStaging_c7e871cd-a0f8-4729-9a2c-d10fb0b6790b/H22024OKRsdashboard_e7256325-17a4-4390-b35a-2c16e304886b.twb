    <worksheet name='Regional monthly 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly' name='federated.19qtnne16f8awa19z59wx1ynbba7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month Selection' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 1 Month&quot;'>
              <calculation class='tableau' formula='&quot;Last 1 Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19qtnne16f8awa19z59wx1ynbba7'>
            <column aggregation='Sum' datatype='real' name='[#]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Actuals2]' role='measure' type='quantitative' />
            <column datatype='real' name='[Actuals]' role='measure' type='quantitative' />
            <column caption='combined actuals' datatype='real' name='[Calculation_1093811792043827200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Actuals]) THEN [Actuals2] ELSE [Actuals] END' />
            </column>
            <column caption='Target Filter' datatype='string' name='[Calculation_1093811792058531847]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Current Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 0 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 1 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 1 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 2 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 2 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 3 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 3 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 4 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 4 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 5 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 5 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 6 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) = 6 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;END' />
            </column>
            <column caption='Target' datatype='string' name='[Calculation_1093811792058744840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 100) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 100)), 2) + &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 100) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 100)), 2) + &quot;%&quot;&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Quality Score [RQS]&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1)&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + LEFT(STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 10) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN STR(FLOOR([Key Results (mid) (copy)_1093811792055738372])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Key Results (mid) (copy)_1093811792055738372] * 100) - (FLOOR([Key Results (mid) (copy)_1093811792055738372]) * 100)), 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN STR([Key Results (mid) (copy)_1093811792055738372])&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN [Targets]&#13;&#10;    ELSE STR([Key Results (mid) (copy)_1093811792055738372])+ &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='delta to target' datatype='real' name='[Calculation_1093811792059772937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Department OKRs]) = &quot;Cost Per Order Accuracy&quot; AND SUM([Calculation_1093811792043827200]) &gt;= SUM([Calculation_1093811792059887626]) AND SUM([Calculation_1093811792043827200]) &lt;= SUM([Calculation_1093811792059949067])&#13;&#10;THEN 0&#13;&#10;ELSEIF ATTR([Department OKRs]) = &quot;Cost Per Order Accuracy&quot; AND SUM([Calculation_1093811792043827200]) &lt; SUM([Calculation_1093811792059887626]) &#13;&#10;THEN SUM([Calculation_1093811792043827200]) - SUM([Calculation_1093811792059887626]) &#13;&#10;ELSEIF ATTR([Department OKRs]) = &quot;Cost Per Order Accuracy&quot; AND SUM([Calculation_1093811792043827200]) &gt; SUM([Calculation_1093811792059949067]) &#13;&#10;THEN SUM([Calculation_1093811792043827200]) - SUM([Calculation_1093811792059949067]) &#13;&#10;&#13;&#10;ELSEIF ATTR([Department OKRs]) != &quot;Cost Per Order Accuracy&quot; &#13;&#10;THEN (SUM([Calculation_1093811792043827200]) - SUM(float([Targets]))) / abs(SUM(float([Targets]))) //@rabia, I added the absolute on the denominator to fix the negative RNPS issue&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CPO lower bound' datatype='real' name='[Calculation_1093811792059887626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Department OKRs] = &quot;Cost Per Order Accuracy&quot; THEN &#13;&#10;    FLOAT(REPLACE(MID([Targets], FIND([Targets], &quot;[&quot;) + 1, FIND([Targets], &quot;%&quot;) - FIND([Targets], &quot;[&quot;) - 1), &quot;%&quot;, &quot;&quot;)) / 100&#13;&#10;END' />
            </column>
            <column caption='CPO upper bound' datatype='real' name='[Calculation_1093811792059949067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Department OKRs] = &quot;Cost Per Order Accuracy&quot; THEN &#13;&#10;    FLOAT(REPLACE(MID([Targets], FIND([Targets], &quot;+&quot;) + 1, FIND([Targets], &quot;%&quot;, FIND([Targets], &quot;+&quot;)) - FIND([Targets], &quot;+&quot;) - 1), &quot;%&quot;, &quot;&quot;)) / 100&#13;&#10;END' />
            </column>
            <column caption='color cases' datatype='integer' name='[Calculation_1726286064758464513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// off target 1 - on target 0&#13;&#10;CASE ATTR([Department OKRs])&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN IF ABS([Calculation_1093811792059772937]) &gt; 0.05 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;LS Order Late &gt; 10 mins&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Rider Quality Score&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN IF [Calculation_1093811792059772937] &gt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 0 ELSE 1 END&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN IF [Calculation_1093811792059772937] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN IF [Calculation_1093811792059772937] = 0 THEN 0 ELSE 1 END&#13;&#10;&#13;&#10;&#13;&#10;    ELSE 0&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Department OKRs]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;LS Order Late &gt; 10 mins&quot;' value='LS Order Late &gt; 15 mins' />
              </aliases>
            </column>
            <column caption='Targets (mid)' datatype='real' name='[Key Results (mid) (copy)_1093811792055738372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN ROUND(FLOAT([Targets])* 100, 1)&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN ROUND(FLOAT([Targets])* 100, 1)&#13;&#10;    WHEN &quot;Rider Quality Score&quot; THEN ROUND(FLOAT([Targets])* 100)&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN ROUND(FLOAT([Targets]) * 100, 1)&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN ROUND(FLOAT([Targets])* 100)&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN ROUND(FLOAT([Targets]) * 100)&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN ROUND(FLOAT([Targets]), 1)&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN ROUND(FLOAT([Targets])*100, 1)&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN ROUND(FLOAT([Targets]), 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN ROUND(FLOAT([Targets]))&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN ROUND(FLOAT([Targets]))&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;&#13;&#10;&#13;&#10;    ELSE ROUND(FLOAT([Targets]) * 100, 2)&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Objective]' role='dimension' type='nominal' />
            <column datatype='string' name='[Targets]' role='dimension' type='nominal' />
            <column-instance column='[#]' derivation='None' name='[none:#:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1093811792058531847]' derivation='None' name='[none:Calculation_1093811792058531847:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1093811792058744840]' derivation='None' name='[none:Calculation_1093811792058744840:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Department OKRs]' derivation='None' name='[none:Department OKRs:nk]' pivot='key' type='nominal' />
            <column-instance column='[Month]' derivation='None' name='[none:Month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Objective]' derivation='None' name='[none:Objective:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1093811792059772937]' derivation='User' name='[usr:Calculation_1093811792059772937:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1726286064758464513]' derivation='User' name='[usr:Calculation_1726286064758464513:qk]' pivot='key' type='quantitative' />
