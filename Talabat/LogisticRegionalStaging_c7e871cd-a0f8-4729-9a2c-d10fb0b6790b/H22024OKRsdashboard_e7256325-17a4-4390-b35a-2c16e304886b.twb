      <column caption='Key Results (mid)' datatype='real' name='[Calculation_747879046009556995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins V2.&quot; THEN ROUND([Actuals2] * 100, 1)&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN ROUND([Actuals2] * 100, 2)&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN ROUND([Actuals2] * 100, 2)&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN ROUND([Actuals2] * 100, 1)&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN ROUND([Actuals2] * 100, 1)&#13;&#10;    WHEN &quot;LS Order Late &gt; 10 mins&quot; THEN ROUND([Actuals2] * 100, 1)&#13;&#10;    WHEN &quot;Rider Quality Score&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN ROUND([Actuals2] * 100, 1)&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN ROUND([Actuals2] * 100)&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN ROUND([Actuals2], 1)&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN ROUND([Actuals2]*100, 1)&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN ROUND([Actuals2], 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN ROUND([Actuals2])&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN ROUND([Actuals2])&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN ROUND([Actuals2] * 100, 2)&#13;&#10;&#13;&#10;&#13;&#10;    ELSE ROUND([Actuals2] * 100, 2)&#13;&#10;END' />
      </column>
      <column caption='Key results' datatype='string' name='[Calculation_747879046010032132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins V2.&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_747879046009556995] * 100) - (FLOOR([Calculation_747879046009556995]) * 100)), 2) + &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_747879046009556995] * 100) - (FLOOR([Calculation_747879046009556995]) * 100)), 2) + &quot;%&quot;&#13;&#10;    &#13;&#10;&#13;&#10;WHEN &quot;Orders On Time&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Quality Score [RQS]&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_747879046009556995] * 10) - (FLOOR([Calculation_747879046009556995]) * 10)), 1) &#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_747879046009556995] * 100) - (FLOOR([Calculation_747879046009556995]) * 100)), 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN STR([Calculation_747879046009556995])&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN STR(FLOOR([Calculation_747879046009556995])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_747879046009556995] * 100) - (FLOOR([Calculation_747879046009556995]) * 100)), 2) + &quot;%&quot;&#13;&#10;&#13;&#10;&#13;&#10;    ELSE STR([Calculation_747879046009556995])+ &quot;%&quot;&#13;&#10;END' />
      </column>
