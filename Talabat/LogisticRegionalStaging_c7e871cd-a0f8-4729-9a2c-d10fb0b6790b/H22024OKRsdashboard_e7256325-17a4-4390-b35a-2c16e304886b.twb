            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_747879046009556995]' derivation='Sum' name='[sum:Calculation_747879046009556995:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_747879045995257856]' derivation='Week-Trunc' name='[twk:Calculation_747879045995257856:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[week]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1f222cz1s87cfr19hpov30w0bwc2].[none:Department OKRs:nk]' filter-group='11'>
