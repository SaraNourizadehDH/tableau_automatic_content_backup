              <calculation class='tableau' formula='IF ISNULL([Actuals]) THEN [Actuals2] ELSE [Actuals] END' />
            </column>
            <column caption='Key Results (mid)' datatype='real' name='[Calculation_1093811792044888065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 2)&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 2)&#13;&#10;    WHEN &quot;Orders On Time&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;LS Order Late &gt; 10 mins&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;Rider Quality Score&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 1)&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN ROUND([Calculation_1093811792043827200] * 100)&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN ROUND([Calculation_1093811792043827200], 1)&#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN ROUND([Calculation_1093811792043827200]*100, 1)&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN ROUND([Calculation_1093811792043827200], 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN ROUND([Calculation_1093811792043827200])&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN ROUND([Calculation_1093811792043827200])&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN ROUND([Calculation_1093811792043827200] * 100, 2)&#13;&#10;&#13;&#10;&#13;&#10;    ELSE ROUND([Calculation_1093811792043827200] * 100, 2)&#13;&#10;END' />
            </column>
            <column caption='Month filter' datatype='string' name='[Calculation_1093811792053452803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Current Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 0 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 1 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 1 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 2 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt; 1  THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 3 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt; 2  THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 4 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;3  THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 5 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;4 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;    WHEN &quot;Last 6 Month&quot; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;5 THEN &quot;Include&quot; ELSE &quot;Exclude&quot; END&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Department OKRs]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;LS Order Late &gt; 10 mins&quot;' value='LS Order Late &gt; 15 mins' />
              </aliases>
            </column>
            <column caption='Key Results' datatype='string' name='[Key Results (mid) (copy)_1093811792048009218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Department OKRs]&#13;&#10;    WHEN &quot;Achievement of Planned vs Actual Hours&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Staffing Efficiency&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Delay &gt; 10 mins&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Transport Fail Rate&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_1093811792044888065] * 100) - (FLOOR([Calculation_1093811792044888065]) * 100)), 2) + &quot;%&quot;&#13;&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_1093811792044888065] * 100) - (FLOOR([Calculation_1093811792044888065]) * 100)), 2) + &quot;%&quot;&#13;&#10;    &#13;&#10;&#13;&#10;WHEN &quot;Orders On Time&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Extreme Delay &gt; 30 mins&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;LS Order Late &gt; 15 mins&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;LS Order Late &gt; 10 mins&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Quality Score [RQS]&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Fraud&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Legal Compliance %&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Overall RSAT&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;After Chat RSAT&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;Rider Value Proposition (RVP)&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) &#13;&#10;    WHEN &quot;Rider Rating of Vendors (RRV)&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + LEFT(STR(FLOOR([Calculation_1093811792044888065] * 10) - (FLOOR([Calculation_1093811792044888065]) * 10)), 1) + &quot;%&quot;&#13;&#10;    WHEN &quot;Fair &amp; Sustainable Rider Earnings (EPH)&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_1093811792044888065] * 100) - (FLOOR([Calculation_1093811792044888065]) * 100)), 2)&#13;&#10;    WHEN &quot;3PL NPS&quot; THEN STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;    WHEN &quot;# of pricing experiments&quot; THEN STR([Calculation_1093811792044888065])&#13;&#10;    WHEN &quot;Cost Per Order Accuracy&quot; THEN STR(FLOOR([Calculation_1093811792044888065])) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_1093811792044888065] * 100) - (FLOOR([Calculation_1093811792044888065]) * 100)), 2) + &quot;%&quot;&#13;&#10;&#13;&#10;&#13;&#10;    ELSE STR([Calculation_1093811792044888065])+ &quot;%&quot;&#13;&#10;END' />
            </column>
