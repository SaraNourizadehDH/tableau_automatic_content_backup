          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13szwps13wcuu112g2dqy0brtvwg'>
            <column caption='null actual or target' datatype='boolean' name='[Calculation_2360730631976349696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([okr_actual_value])  &#10;and ISNULL([Okr Target Value (copy)_6672012490422902784])' />
            </column>
            <column caption='okr_value_decimal_1' datatype='string' name='[Calculation_3766557411005345822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#10;  INT( INT([okr_actual_value] * 10 + 0.5) / 10 )&#10;)&#10;+ &quot;.&quot;&#10;+ STR(&#10;  INT([okr_actual_value] * 10 + 0.5) % 10 &#10;)' />
            </column>
            <column caption='okr_value decimal_2' datatype='string' name='[Calculation_3766557411005399071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#10;  INT( INT([okr_actual_value] * 100 + 0.5) / 100 )&#10;)&#10;+ &quot;.&quot;&#10;+&#10;IF&#10;  (&#10;    INT([okr_actual_value] * 100 + 0.5)&#10;    - INT( INT([okr_actual_value] * 100 + 0.5) / 100 ) * 100&#10;  ) &lt; 10&#10;THEN&#10;  &quot;0&quot; + STR(&#10;    INT([okr_actual_value] * 100 + 0.5)&#10;    - INT( INT([okr_actual_value] * 100 + 0.5) / 100 ) * 100&#10;  )&#10;ELSE&#10;  STR(&#10;    INT([okr_actual_value] * 100 + 0.5)&#10;    - INT( INT([okr_actual_value] * 100 + 0.5) / 100 ) * 100&#10;  )&#10;END' />
            </column>
            <column caption='OKR Value ' datatype='string' name='[Calculation_4230357807773208582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [value_format] = &quot;percentage_0&quot; THEN&#10;    if [okr_actual_value]&lt;0.1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 0)),2) + &quot;%&quot;&#10;    ELSEIF [okr_actual_value] &gt; 0.1 and [okr_actual_value] &lt; 1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 0)),3) + &quot;%&quot;&#10;    else &#10;        left(STR(ROUND([okr_actual_value] * 100, 0)),4) + &quot;%&quot;&#10;    END&#10;&#10;ELSEIF [value_format] = &quot;percentage_1&quot; THEN&#10;    if [okr_actual_value]&lt;0.1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 1)),3) + &quot;%&quot;&#10;    ELSEIF [okr_actual_value] &gt; 0.1 and [okr_actual_value] &lt; 1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 1)),4) + &quot;%&quot;&#10;    else &#10;        left(STR(ROUND([okr_actual_value] * 100, 1)),5) + &quot;%&quot;&#10;    END&#10;&#10;ELSEIF [value_format] = &quot;percentage_2&quot; THEN&#10;    if [okr_actual_value]&lt;0.1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 2)),4) + &quot;%&quot;&#10;    ELSEIF [okr_actual_value] &gt; 0.1 and [okr_actual_value] &lt; 1 then &#10;        left(STR(ROUND([okr_actual_value] * 100, 2)),5) + &quot;%&quot;&#10;    else &#10;        left(STR(ROUND([okr_actual_value] * 100, 2)),6) + &quot;%&quot;&#10;    END&#10;&#10;ELSEIF [value_format] = &quot;decimal_0&quot; THEN&#10;    str(int([okr_actual_value]) )&#10;&#10;ELSEIF [value_format] = &quot;decimal_1&quot; THEN&#10;[Calculation_3766557411005345822]&#10;&#10;ELSEIF [value_format] = &quot;decimal_2&quot; THEN&#10;[Calculation_3766557411005399071]&#10;&#10;ELSE&#10;    STR([okr_actual_value]) // Default case&#10;END' />
            </column>
            <column caption='current week' datatype='datetime' name='[Calculation_5290111095525638145]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, today(), &quot;monday&quot;)' />
            </column>
            <column caption='all months' datatype='date' name='[Calculation_5290111095526416388]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [granularity]=&quot;month&quot; then date end' />
            </column>
            <column caption='Relative Period Filter' datatype='boolean' name='[Calculation_6672012491180662791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;month&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 1] and&#10;   [date] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 1])&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 2] and&#10;   [date] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 2])&#10;end' />
            </column>
            <column caption='Okr Target Value ' datatype='real' default-format='p0.0%' name='[Okr Target Value (copy)_6672012490422902784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[okr_target_value]' />
            </column>
            <column caption='all weeks' datatype='date' name='[all months (copy)_5290111095526838278]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [granularity]=&quot;week&quot; then [date] end' />
            </column>
            <column-instance column='[okr_description]' derivation='Attribute' name='[attr:okr_description:nk]' pivot='key' type='nominal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
