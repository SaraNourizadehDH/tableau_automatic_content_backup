        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zdux7s1eofouu1f1we0v0i229ea' name='Custom SQL Query' type='text'>with base as (
  select 
  upper(country_code) as country_code,
  o.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id, country_code), 
  d.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id),
  from  `tlb-data-dev.data_platform.fct_logistics_okr_value` o
  left join `tlb-data-dev.data_platform.dim_logistics_okr` d using(okr_id)
  where is_active
)

select * from base</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
