            </column>
            <column caption='current month' datatype='datetime' datatype-customized='true' name='[current week (copy)_5290111095525875714]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// DATETIME(max(date (DATETRUNC(&quot;month&quot;, [Date]))))&#10;&#10;DATETRUNC(&apos;month&apos;, today()-1)' />
            </column>
