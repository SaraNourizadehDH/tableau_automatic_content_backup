            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jallyl11fsawl10smq3u0rwb9yb'>
            <column caption='Courier Delay' datatype='real' name='[Beehive (copy)_4402268640733339649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Courier Delay&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='First Online' datatype='date' name='[Calculation_2413225723138465792]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([first_online_date])' />
            </column>
            <column caption='Beehive' datatype='real' name='[Calculation_4402268640731226112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Beehive&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Order Failure' datatype='real' name='[Calculation_4402268640733831170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Order Failure&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Closed' datatype='real' name='[Calculation_4402268640733958147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Closed&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Check Out' datatype='real' name='[Calculation_4402268640734240772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Check-Out&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Check-IN' datatype='real' name='[Calculation_4402268640734490629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Check-IN&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Connectivity' datatype='real' name='[Calculation_4402268640734883846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Connectivity&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Too Busy' datatype='real' name='[Calculation_4402268640735105031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;Too_Busy&apos; then [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Others' datatype='real' name='[Calculation_4402268640735539208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [talabat_category_reason] = &apos;unknown&apos; OR [talabat_category_reason] = &apos;Others&apos; THEN [unavailable_duration_minutes] ELSE NULL END))' />
            </column>
            <column caption='Show Detailed Sheet' datatype='boolean' name='[Calculation_6369637989050691584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
