            <column caption='AM Name' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column caption='Author Service' datatype='string' name='[author_service]' role='dimension' type='nominal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Order' datatype='integer' name='[country_offline_minutes (copy)_5347532042972446732]' role='measure' type='quantitative'>
