            <column caption='CPP Vendor Count' datatype='integer' name='[CPC Vendor Count (copy)_6478991024391270405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([cpp_featured_products_revenue_lc_wo_vat]&#10;            +[cpp_premium_placements_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
