            </column>
            <column caption='Top/Bottom N Filter' datatype='string' name='[Calculation_946881855828017154]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_694117326009040904]&lt;=[Parameters].[Parameter 8] THEN &apos;Include&apos; &#13;&#10;ELSE &apos;Exclude&apos; END'>
