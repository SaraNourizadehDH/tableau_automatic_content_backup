            <column caption='% Rider Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700460032041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_rider_late_orders_5min])&#13;&#10;/&#13;&#10;sum([daily_all_rider_late_orders])' />
