              <calculation class='tableau' formula='case [Parameters].[Measure (copy)_694117325992284162] &#13;&#10;when &quot;Successful Orders&quot; then sum([daily_successful_order_count])&#13;&#10;when &quot;GMV&quot; then sum([Gem Discount Amount (copy)_1887852700224237577])&#13;&#10;when &quot;AOV&quot; then [Calculation_1887852700226600973]&#13;&#10;when &quot;Avg Basket Value&quot; then [Calculation_1887852700226764814]&#13;&#10;when &quot;Avg Delivery Fee TGO&quot; then [Calculation_1887852700227051535]&#13;&#10;when &quot;Avg Effective Fee TGO&quot; then [Avg Delivery Fee TGO (copy)_1887852700227502097]&#13;&#10;when &quot;Avg Delivery Fee TMP&quot; then [Avg Delivery Fee TGO (copy)_1887852700227244048]&#13;&#10;when &quot;Avg Effective Fee TMP&quot; then [Avg Effective Fee TGO (copy)_1887852700227670034]&#13;&#10;when &quot;Avg Service Fee&quot; then [Service Fee (copy)_1887852700227932179]&#13;&#10;when &quot;TGO Orders&quot; then ([Calculation_1887852700228476948])&#13;&#10;when &quot;TMP Orders&quot; then ([TGO Orders (copy)_1887852700228681749])&#13;&#10;when &quot;Pickup Orders&quot; then ([TMP Orders (copy)_1887852700228734998])&#13;&#10;when &quot;Avg Vendor Late (min)&quot; then [Calculation_1887852700451053596]&#13;&#10;when &quot;Avg Vendor Late V2 (min)&quot; then [Avg Vendor Late (min) (copy)_1887852700451303453]&#13;&#10;when &quot;Avg Vendor Clean Time (min)&quot; then [Calculation_1887852700451573790]&#13;&#10;when &quot;Avg Estimated Prep Time (min)&quot; then[Calculation_1887852700451827743]&#13;&#10;when &quot;Avg Preparation Time (min)&quot; then [Calculation_1887852700452073504]&#13;&#10;when &quot;Incentivized Orders (Incl. Gems)&quot; then sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;when &quot;Free Delivery Orders (DF=0)&quot; then sum([daily_successful_fd_order_count])&#13;&#10;when &quot;Avg Delivery Time (min)&quot; then [Calculation_1887852700455686182]&#13;&#10;when &quot;Avg Promised Delivery Time (min)&q