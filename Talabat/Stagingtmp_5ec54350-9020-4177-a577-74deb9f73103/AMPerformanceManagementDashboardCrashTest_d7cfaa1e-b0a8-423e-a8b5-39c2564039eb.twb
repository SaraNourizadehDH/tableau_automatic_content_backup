            <column caption='Report Date' datatype='date' default-format='*dd-mmm-yy' name='[Calculation_1887852700556222519]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Day]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Day (copy)_1887852700555989046]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='Measure I' datatype='real' default-format='n#,##0.0;(#,##0.0)' name='[Calculation_2060678337344253952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#13;&#10;when &quot;Successful Orders&quot; then sum([daily_successful_order_count])&#13;&#10;when &quot;GMV&quot; then sum([Gem Discount Amount (copy)_1887852700224237577])&#13;&#10;when &quot;AOV&quot; then [Calculation_1887852700226600973]&#13;&#10;when &quot;Avg Basket Value&quot; then [Calculation_1887852700226764814]&#13;&#10;when &quot;Avg Delivery Fee TGO&quot; then [Calculation_1887852700227051535]&#13;&#10;when &quot;Avg Effective Fee TGO&quot; then [Avg Delivery Fee TGO (copy)_1887852700227502097]&#13;&#10;when &quot;Avg Delivery Fee TMP&quot; then [Avg Delivery Fee TGO (copy)_1887852700227244048]&#13;&#10;when &quot;Avg Effective Fee TMP&quot; then [Avg Effective Fee TGO (copy)_1887852700227670034]&#13;&#10;when &quot;Avg Service Fee&quot; then [Service Fee (copy)_1887852700227932179]&#13;&#10;when &quot;TGO Orders&quot; then ([Calculation_1887852700228476948])&#13;&#10;when &quot;TMP Orders&quot; then ([TGO Orders (copy)_1887852700228681749])&#13;&#10;when &quot;Pickup Orders&quot; then ([TMP Orders (copy)_1887852700228734998])&#13;&#10;when &quot;Avg Vendor Late (min)&quot; then [Calculation_1887852700451053596]&#13;&#10;when &quot;Avg Vendor Late V2 (min)&quot; then [Avg Vendor Late (min) (copy)_1887852700451303453]&#13;&#10;when &quot;Avg Vendor Clean Time (min)&quot; then [Calculation_1887852700451573790]&#13;&#10;when &quot;Avg Estimated Prep Time (min)&quot; then[Calculation_1887852700451827743]&#13;&#10;when &quot;Avg Preparation Time (min)&quot; then [Calculation_1887852700452073504]&#13;&#10;when &quot;Incentivized Orders (Incl. Gems)&quot; then sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;when &quot;Free Delivery Orders (DF=0)&quot; then sum([daily_successful_fd_order_count])&#13;&#10;when &quot;Avg Delivery Time (min)&quot; then [Calculation_1887852700455686182]&#13;&#10;when &quot;Avg Promised Delivery Time (min)&quot; then [Avg Delivery Time (min) (copy)_1887852700455976999]&#13;&#10;when &quot;No of Late Orders&quot; then sum([daily_all_delivery_late_orders])&#13;&#10;when &quot;Avg Delivery Distance (km)&quot; then [Calculation_1887852700462321706]&#13;&#10;when &quot;Avg Driving Time (min)&quot; then [Calculation_1887852700462710827]&#13;&#10;when &quot;No of Orders with Stacking&quot; then sum([daily_total_stacked_orders])&#13;&#10;when &quot;Avg Hold Back Time (min)&quot; then [Calculation_1887852700524101677]&#13;&#10;when &quot;New Customers&quot; then sum([daily_order_new_customer_count])&#13;&#10;when &quot;Viewed Menu Subsessions&quot; then sum([daily_viewed_menu_subsession_count])&#13;&#10;when &quot;Placed Order Subsessions&quot; then sum([daily_placed_order_sub_session_count])&#13;&#10;when &quot;Avg Discount Amount&quot; then [Calculation_1766818460923830272]&#13;&#10;when &quot;Avg Voucher Discount&quot; then [Avg Discount Amount (copy)_1766818460924456961]&#13;&#10;when &quot;Avg Gem Discount&quot; then [Avg Voucher Discount (copy)_1766818460924583938]&#13;&#10;when &quot;Avg Commissionable GMV&quot; then [Calculation_1766818460924936195]&#13;&#10;when &quot;ABV - [AFV Sales Defn]&quot; then [Calculation_1766818460925415428]&#13;&#10;when &quot;Net Take per Order&quot; then [Net Take (copy)_1766818460926586886]&#13;&#10;&#10;&#10;//when &quot;﻿vFR % - Bad Vendor&quot; then [vFR % - Bad Vendor]&#10;//when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor]&#10;//when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TMP - VendorFault Contact Rate % - Bad Vendor]&#10;when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [Calculation_6203497390910783499]&#10;when &quot;﻿CPC Featured Prodcut&quot; then [Calculation_6203497390909800454]&#10;when &quot;﻿CPC KeyWord Search&quot; then [CPC Featured Product (copy)_6203497390909984775]&#10;when &quot;﻿CPC Organic Placements&quot; then [Calculation_6203497390909562885] &#10;when &quot;﻿CPP Featured Product&quot; then [Calculation_6203497390910263304]&#10;when &quot;﻿CPP Premium Placements&quot; then [CPP Featured Products (copy)_6203497390910406665]&#10;when &quot;﻿NCR Gems Revenue&quot; then [Calculation_6203497390910578698]&#10;when &quot;﻿NCR Vendor Count (Excl. Banner)&quot; then [CPC Vendor Count (copy)_6478991024392220679]&#10;&#10;when &quot;﻿CPC Vendor Count&quot; then [CPC Featured Product (copy)_6478991024390533124]&#10;when &quot;﻿CPP Vendor Count&quot; then [CPC Vendor Count (copy)_6478991024391270405]&#10;when &quot;﻿NCR Gem Vendor Count&quot; then [CPP Vendor Count (copy)_6478991024391483398]&#10;//when &quot;﻿Full GMV Coverage&quot; then [Full GMV Coverage]&#10;//when &quot;﻿VFD GMV Coverage&quot; then [VFD GMV Coverage]&#10;//when &quot;﻿VFD Share of Savings %&quot; then [VFD Share of Savings %]&#10;//when &quot;﻿VFD Order Share %&quot; then [VFD order share %]&#10;when &quot;﻿VFD Orders&quot; then [VFD order share % (copy)_6203497390926295060]&#10;when &quot;﻿VFD GMV&quot; then [Calculation_6203497390930489370]&#10;when &quot;﻿Menu Discount Orders&quot; then sum([successful_menu_discount_order])&#10;//when &quot;﻿Menu Discount Order %&quot; then [Menu Discount Order share]&#10;//when &quot;﻿Menu Discount GMV %&quot; then [Menu Discount GMV %]&#10;when &quot;﻿Menu Discount Vendor Count&quot; then [Menu Discount Order share (copy)_6478991024392970248]&#10;when &quot;﻿Item Discount Orders&quot; then sum([successful_item_discount_order])&#10;//when &quot;﻿Item Discount Order %&quot; then [Item Discount Order share]&#10;//when &quot;﻿Item Discount GMV %&quot; then [Item Discount GMV %]&#10;when &quot;﻿Item Discount Vendor Count&quot; then [Menu Discount Vendor Count (copy)_6478991024393211913]&#10;when &quot;﻿Inc. Free Delivery Orders&quot; then sum([successful_free_delivery_order])&#10;// when &quot;﻿Inc. FD Order %&quot; then [Inc. FD Order share]&#10;when &quot;﻿Buy x Get y Orders&quot; then sum([successful_buy_x_get_y_order])&#10;//when &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3, Menu - StartCheckout]&#10;//when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [mCVR3a, Menu - AddToCart]&#10;//when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout]&#10;//when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR4, StartCheckout - PlacedOrder]&#10;when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg Estimated Prep Time (min) (copy)_6489898193058914305]&#10;when &quot;Active Vendor Count&quot; then [Calculation_2299509842831519744]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;&#10;when &apos;Active tPro Vendor Count&apos; then [Active Vendor Count (copy)_2320620466090004480]&#10;&#10;&#10;//when &quot;Vendor Fail Rate, %&quot; then [Vendor Fail Rate, %]&#10;when &quot;Deal Target Incentive Amount&quot; then sum([Calculation_222224497063833604])&#10;//when &quot;Best Seller, % of Total GMV&quot; then [Best Seller - % of total GMV]&#10;//when &quot;tPro Vendors - % of GMV&quot; [tPro Vendors - % of GMV]&#10;when &quot;tPro Vendors - GMV&quot; then sum([Calculation_222224497422663703])&#10;when &quot;Offline Duration (Hrs)&quot; then [Calculation_2116199258539667457]&#10;when &quot;Scheduled Hours&quot; then [Calculation_2116199258539765762]&#10;//when &quot;% Offline Duration&quot; then [% Offline Duration]&#10;&#13;&#10;//TGO Share, %&#13;&#10;//FIR Usage, %&#13;&#10;//% Vendor Late &gt; 5min&#13;&#10;//% Vendor Late &gt; 5min V2&#13;&#10;//Commission %&#13;&#10;//% Incentivized Orders (Incl. Gems)&#13;&#10;//% Free Delivery orders (DF=0)&#13;&#10;//Customer Contact Rate, %&#13;&#10;//Net Fail Rate, %&#13;&#10;//% Order Late &gt; 5min&#13;&#10;//% Rider Late &gt; 5min&#13;&#10;//% Orders with Stacking&#13;&#10;//CVR by Subsessions&#13;&#10;//Net Take Rate, %&#13;&#10;//Commission Rate [Sales Defn] %&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Measure Combined I' datatype='real' name='[Calculation_2060678337348874242]' role='measure' type='quantitative'>
