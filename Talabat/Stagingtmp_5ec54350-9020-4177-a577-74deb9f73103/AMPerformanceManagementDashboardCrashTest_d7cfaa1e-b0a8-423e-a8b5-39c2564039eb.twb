      <simple-id uuid='{5F462269-23DE-4F03-AD45-AD51DA9323E1}' />
    </worksheet>
    <worksheet name='Sales Performance KPIs - Monthly View vs. LM'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>vs. LM</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold'>Æ </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='7' italic='true'>(NA for MTD)</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='8' italic='true' underline='true'>Important Notes</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>1. Full GMV Coverage: The campaigns are considered based on the initial setup dates. In case if a campagin settings (dates, status,etc) are changed, such changes are not taken into account while calculating this KPI</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>2. Buy x Get y: Not accurately captured due to engineering challenges. This is currently in progress</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>3. (Menu + Item + Inc.FD + BxGy) will not be equal to total VFD orders since multiple incentives can be applied for a single vendor</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>4. VAT has been removed from all NCR revenue metrics</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>5. Bad Vendor metrics are only applicable to only Food Vertical</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>6.VfContact Rate % : Vendor Fault Customer Contact Rate - Contacts due to vendor reasons (BeeHive Definition) </run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>7. % of Vendor ProceParity : This KPI is accurate only for month level date granularity. Please make sure that 1st day of the month falls under the date range selected</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='am_chain_vendor_performance_dashboard_reporting' name='sqlproxy.0gxbmd80t3un2i1brp9ow036duee' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Account Manager Type' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current&quot;'>
              <calculation class='tableau' formula='&quot;Current&quot;' />
            </column>
            <column caption='View MTD/Full Month' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;Full Month&quot;'>
              <calculation class='tableau' formula='&quot;Full Month&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0gxbmd80t3un2i1brp9ow036duee'>
            <column caption='% Vendor Late &gt; 10min V2' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 5min V2 (copy)_610871084621475840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_orders_10min_V2])&#13;&#10;/sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='AM Team Leader (Current)' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if [Account Manager Type] = &apos;Current&apos; then [current_assigned_team_leader_name]&#10;//ELSE [team_leader_name]&#10;//END&#10;&#10;[current_assigned_team_leader_name]' />
            </column>
            <column caption='Avg Delivery Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227244048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='CPC KeyWord Search' datatype='real' name='[CPC Featured Product (copy)_6203497390909984775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_kwords_search_revenue_eur_wo_vat]&#10;else [cpc_kwords_search_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='CPP Premium Placements' datatype='real' name='[CPP Featured Products (copy)_6203497390910406665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpp_premium_placements_revenue_eur_wo_vat]&#10;else [cpp_premium_placements_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_1887852700221997058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226600973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Discount Amount (copy)_1887852700224237577])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Basket Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226764814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221571073]) / sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Delivery Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700227051535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='TGO Orders' datatype='real' name='[Calculation_1887852700228476948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Commission %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700452315169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221997058])&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
            </column>
            <column caption='Avg Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700455686182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_delivery_time_min])&#13;&#10;/&#13;&#10;sum([daily_delivery_time_orders])' />
            </column>
            <column caption='CVR by Subsessions' datatype='real' default-format='p0.0%' name='[Calculation_1887852700532879406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_placed_order_sub_session_count])&#13;&#10;/&#13;&#10;sum([daily_viewed_menu_subsession_count])' />
            </column>
            <column caption='ODR Flag' datatype='boolean' name='[Calculation_1887852700554997812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement] = &quot;ODR&quot;' />
            </column>
            <column caption='% Offline Duration' datatype='real' default-format='p0.00%' name='[Calculation_2116199258539524096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/&#10;sum([slot_duration_seconds])' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
            <column caption='Deal Target Incentive Amount' datatype='real' name='[Calculation_222224497063833604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then [deal_target_incentive_amount_lc]&#10;else [deal_target_incentive_amount_eur]&#10;end' />
            </column>
            <column caption='Best Seller - % of total GMV' datatype='real' default-format='p0.00%' name='[Calculation_222224497323323406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Deal Target Incentive Amount (copy)_222224497064198149]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='avg(0)' datatype='real' name='[Calculation_222224497324269584]' role='measure' type='quantitative' user:unnamed='Sales Performance KPIs - Monthly View'>
              <calculation class='tableau' formula='avg(0)' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_222224497326702609]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor Fail Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_222224497420701718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_count]) / sum([vfr_net_order_count])' />
            </column>
            <column caption='tPro Vendors - GMV' datatype='real' name='[Calculation_222224497422663703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [tpro_vendor_successful_gmv_amount_lc]&#10;else [tpro_vendor_successful_gmv_amount_eur]&#10;END' />
            </column>
            <column caption='tPro Vendors - % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_222224497422790680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_222224497422663703]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Item Image Ratio - Daily' datatype='real' default-format='p0.00%' name='[Calculation_2412170196595625984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images]) / sum([total_active_menu_items])' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_2412170196599562249]' role='measure' type='quantitative' user:unnamed='Sales Performance KPIs'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='Filter: Hide for MTD' datatype='boolean' name='[Calculation_438960239379427328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 17] = &apos;MTD&apos; then false else true end' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_5163588101749960708]' role='measure' type='quantitative' user:unnamed='Sales Performance KPIs'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='% of Vendor PriceParity(cWatch Matched)' datatype='real' default-format='p0.0%' name='[Calculation_5163588101853908998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [price_parity_flag] = &apos;true&apos; then [vendor_id] end)&#10;/&#10;countd(if [price_parity_flag] in (&apos;true&apos;, &apos;false&apos;) then [vendor_id] end)' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_5163588101854789640]' role='measure' type='quantitative' user:unnamed='Sales Performance KPIs'>
              <calculation class='tableau' formula='sum(0)' />
