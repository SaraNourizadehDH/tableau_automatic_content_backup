 &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3, Menu - StartCheckout]&#10;//when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [mCVR3a, Menu - AddToCart]&#10;//when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout]&#10;//when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR4, StartCheckout - PlacedOrder]&#10;when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg Estimated Prep Time (min) (copy)_6489898193058914305]&#10;when &quot;Active Vendor Count&quot; then [Calculation_2299509842831519744]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;&#10;when &apos;Active tPro Vendor Count&apos; then [Active Vendor Count (copy)_2320620466090004480]&#10;&#10;&#10;//when &quot;Vendor Fail Rate, %&quot; then [Vendor Fail Rate, %]&#10;when &quot;Deal Target Incentive Amount&quot; then sum([Calculation_222224497063833604])&#10;//when &quot;Best Seller, % of Total GMV&quot; then [Best Seller - % of total GMV]&#10;//when &quot;tPro Vendors - % of GMV&quot; [tPro Vendors - % of GMV]&#10;when &quot;tPro Vendors - GMV&quot; then sum([Calculation_222224497422663703])&#10;when &quot;Offline Duration (Hrs)&quot; then [Calculation_2116199258539667457]&#10;when &quot;Scheduled Hours&quot; then [Calculation_2116199258539765762]&#10;//when &quot;% Offline Duration&quot; then [% Offline Duration]&#10;&#13;&#10;//TGO Share, %&#13;&#10;//FIR Usage, %&#13;&#10;//% Vendor Late &gt; 5min&#13;&#10;//% Vendor Late &gt; 5min V2&#13;&#10;//Commission %&#13;&#10;//% Incentivized Orders (Incl. Gems)&#13;&#10;//% Free Delivery orders (DF=0)&#13;&#10;//Customer Contact Rate, %&#13;&#10;//Net Fail Rate, %&#13;&#10;//% Order Late &gt; 5min&#13;&#10;//% Rider Late &gt; 5min&#13;&#10;//% Orders with Stacking&#13;&#10;//CVR by Subsessions&#13;&#10;//Net Take Rate, %&#13;&#10;//Commission Rate [Sales Defn] %&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Measure Combined I' datatype='real' name='[Calculation_2060678337348874242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#13;&#10;&#13;&#10;when &quot;TGO Share, %&quot; then [TGO Orders (copy)_1887852700228915223]&#10;when &quot;FIR Usage, %&quot; then [Calculation_1887852700229414936]&#10;when &quot;% Vendor Late &gt; 5min&quot;  then [Calculation_1887852700440100889]&#10;when &quot;% Vendor Late &gt; 5min V2&quot; then [% Vendor Late &gt; 5min (copy)_1887852700440547355]&#10;&#10;when &quot;Commission %&quot; then [Calculation_1887852700452315169]&#10;when &quot;% Incentivized Orders (Incl. Gems)&quot; then [Calculation_1887852700453523490]&#10;when &quot;% Free Delivery orders (DF=0)&quot; then [Calculation_1887852700453847075]&#10;when &quot;Customer Contact Rate, %&quot; then [Calculation_1887852700454101028]&#10;when &quot;Net Fail Rate, %&quot; then [Calculation_1887852700454682661]&#10;when &quot;% Order Late &gt; 5min&quot; then [Calculation_1887852700458917928]&#10;when &quot;% Rider Late &gt; 5min&quot; then [Calculation_1887852700460032041]&#10;&#10;when &quot;% Orders with Stacking&quot; then [Calculation_1887852700523860012]&#10;when &quot;CVR by Subsessions&quot; then [Calculation_1887852700532879406]&#10;when &quot;Net Take Rate, %&quot; then [Net Take per Order (copy)_1766818460927668231]&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Commission % (copy)_1766818460927938568]&#10;&#10;when &quot;% Vendor Late &gt; 10min&quot;  then [% Vendor Late &gt; 5min (copy)_610871084623101955]&#10;when &quot;% Vendor Late &gt; 10min V2&quot; then [% Vendor Late &gt; 5min V2 (copy)_610871084621475840]&#10;when &quot;% Order Late &gt; 10min&quot; then [% Order Late &gt; 5min (copy)_610871084621979650]&#10;when &quot;% Rider Late &gt; 10min&quot; then [% Rider Late &gt; 5min (copy)_610871084621697025]&#10;&#10;when &quot;﻿vFR % - Bad Vendor&quot; then [Calculation_6203497390900776960]&#10;when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [vFR % - Bad Vendor (copy)_6203497390901391361]&#10;when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor (copy)_6203497390917926924]&#10;//when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [NCR Ads Revenue (Excl Banner)]&#10;//when &quot;﻿CPC Featured Prodcut&quot; then [CPC Featured Product]&#10;//when &quot;﻿CPC KeyWord Search&quot; then [CPC KeyWord Search]&#10;//when &quot;﻿CPC Organic Placements&quot; then [CPC Organic Placements] &#10;//when &quot;﻿CPP Featured Product&quot; then [CPP Featured Products]&#10;//when &quot;﻿CPP Premium Placements&quot; then [CPP Premium Placements]&#10;//when &quot;﻿NCR Gems Revenue&quot; then [Gems Revenue]&#10;//when &quot;﻿NCR Vendor Count (Excl. Banner)&quot; then [NCR Vendor Count (Excl Banner)]&#10;//when &quot;﻿CPC Vendor Count&quot; then [CPC Vendor Count]&#10;//when &quot;﻿CPP Vendor Count&quot; then [CPP Vendor Count]&#10;//when &quot;﻿NCR Gem Vendor Count&quot; then [Gem Vendor Count]&#10;when &quot;% Ads Revenue Vendor Penetration&quot; then [Calculation_2320620466098237441]&#10;when &quot;﻿Full GMV Coverage&quot; then [Calculation_6203497390903332866]&#10;when &quot;﻿VFD GMV Coverage&quot; then [Calculation_6203497390904610819]&#10;when &quot;﻿VFD Share of Savings %&quot; then [Calculation_6203497390927261718]&#10;when &quot;﻿VFD Order Share %&quot; then [VFD GMV Coverage (copy)_6203497390905331716]&#10;//when &quot;﻿VFD Orders&quot; then [VFD orders]&#10;//when &quot;﻿VFD GMV&quot; then [VFD GMV]&#10;//when &quot;﻿Menu Discount Orders&quot; then sum([successful_menu_discount_order])&#10;when &quot;﻿Menu Discount Order %&quot; then [VFD order share % (copy)_6203497390927769623]&#10;when &quot;﻿Menu Discount GMV %&quot; then [VFD GMV (copy)_6478991024389677058]&#10;//when &quot;﻿Menu Discount Vendor Count&quot; then [Menu Discount Vendor Count]&#10;//when &quot;﻿Item Discount Orders&quot; then sum([successful_item_discount_order])&#10;when &quot;﻿Item Discount Order %&quot; then [Menu Discount Order share (copy)_6478991024388169728]&#10;when &quot;﻿Item Discount GMV %&quot; then [Menu Discount GMV % (copy)_6478991024390242307]&#10;//when &quot;﻿Item Discount Vendor Count&quot; then [Item Discount Vendor Count]&#10;//when &quot;﻿Inc. Free Delivery Orders&quot; then sum([successful_free_delivery_order])&#10;when &quot;﻿Inc. FD Order %&quot; then [Item Discount Order share (copy)_6478991024388546561]&#10;//when &quot;﻿Buy x Get y Orders&quot; then sum([successful_buy_x_get_y_order])&#10;when &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout (copy)_6478991024399364112]&#10;when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [Calculation_6478991024398819342]&#10;when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3a, Menu - AddToCart (copy)_6478991024399069199]&#10;when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR3, Menu - StartCheckout (copy)_6478991024399560721]&#10;&#10;when &quot;Commission Rev. % of GMV&quot; then [Commission Rate [Sales Defn]] % (copy)_814025654015954947]&#10;&#10;when &quot;Item Image Ratio&quot; then [Item Image Ratio - Daily (copy)_2412170196598308871]&#10;when &quot;Item Description Ratio&quot; then [Item Description Ratio - Daily (copy)_2412170196597977094]&#10;&#10;//when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg EPT + AVTC (min)]&#10;//when &quot;Active Vendor Count&quot; then [Active Vendor Count]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;when &quot;% of Vendor PriceParity(cWatch Matched)&quot; then [Calculation_5163588101853908998]&#10;&#13;&#10;when &quot;Vendor Fail Rate, %&quot; then [Calculation_222224497420701718]&#10;//when &quot;Deal Target Incentive Amount&quot; then sum([Deal Target Incentive Amount])&#10;when &quot;Best Seller, % of Total GMV&quot; then [Calculation_222224497323323406]&#10;when &quot;tPro Vendors - % of GMV&quot; then [Calculation_222224497422790680]&#10;//when &quot;tPro Vendors - GMV&quot; then sum([tPro Vendors - GMV])&#10;//when &quot;Offline Duration (Hrs)&quot; then [Offline Duration (Hrs)]&#10;//when &quot;Scheduled Hours&quot; then [Scheduled Hours]&#10;when &quot;% Offline Duration&quot; then [Calculation_2116199258539524096]&#10;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10; [Calculation_2060678337344253952]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% Offline Duration' datatype='real' default-format='p0.00%' name='[Calculation_2116199258539524096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/&#10;sum([slot_duration_seconds])' />
            </column>
            <column caption='Offline Duration (Hrs)' datatype='real' name='[Calculation_2116199258539667457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/3600' />
            </column>
            <column caption='Scheduled Hours' datatype='real' name='[Calculation_2116199258539765762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([slot_duration_seconds])&#10;/ 3600' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
            <column caption='Deal Target Incentive Amount' datatype='real' name='[Calculation_222224497063833604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then [deal_target_incentive_amount_lc]&#10;else [deal_target_incentive_amount_eur]&#10;end' />
            </column>
            <column caption='Best Seller - % of total GMV' datatype='real' default-format='p0.00%' name='[Calculation_222224497323323406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Deal Target Incentive Amount (copy)_222224497064198149]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Vendor Fail Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_222224497420701718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_count]) / sum([vfr_net_order_count])' />
            </column>
            <column caption='tPro Vendors - GMV' datatype='real' name='[Calculation_222224497422663703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [tpro_vendor_successful_gmv_amount_lc]&#10;else [tpro_vendor_successful_gmv_amount_eur]&#10;END' />
            </column>
            <column caption='tPro Vendors - % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_222224497422790680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_222224497422663703]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[Calculation_2299509842831519744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if zn([daily_successful_order_count])&gt;0 then vendor_id end)' />
            </column>
            <column caption='% Ads Revenue Vendor Penetration' datatype='real' default-format='p0.00%' name='[Calculation_2320620466098237441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CPC Vendor Count (copy)_6478991024392220679] / [Calculation_2299509842831519744]' />
            </column>
            <column caption='Item Image Ratio - Daily' datatype='real' default-format='p0.00%' name='[Calculation_2412170196595625984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images]) / sum([total_active_menu_items])' />
            </column>
            <column caption='% of Vendor PriceParity(cWatch Matched)' datatype='real' default-format='p0.0%' name='[Calculation_5163588101853908998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [price_parity_flag] = &apos;true&apos; then [vendor_id] end)&#10;/&#10;countd(if [price_parity_flag] in (&apos;true&apos;, &apos;false&apos;) then [vendor_id] end)' />
            </column>
            <column caption='vFR % - Bad Vendor' datatype='real' default-format='p0.00%' name='[Calculation_6203497390900776960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_count_bv]) / sum([net_order_count_bad_vendor_fr])' />
            </column>
            <column caption='Full GMV Coverage' datatype='real' default-format='p0.00%' name='[Calculation_6203497390903332866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1]=&apos;Eur&apos; then [full_inc_coverage_successful_gmv_amount_eur] &#10;    else [full_inc_coverage_successful_gmv_amount_eur]  end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='VFD GMV Coverage' datatype='real' default-format='p0.00%' name='[Calculation_6203497390904610819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [inc_successful_gmv_amount_eur]&#10;    else [inc_successful_gmv_amount_lc]&#10;    end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='CPC Organic Placements' datatype='real' name='[Calculation_6203497390909562885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_organic_placements_revenue_eur_wo_vat]&#10;else [cpc_organic_placements_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='CPC Featured Product' datatype='real' name='[Calculation_6203497390909800454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_featured_products_revenue_eur_wo_vat]&#10;else [cpc_featured_products_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='CPP Featured Products' datatype='real' name='[Calculation_6203497390910263304]' role='measure' type='quantitative'>
