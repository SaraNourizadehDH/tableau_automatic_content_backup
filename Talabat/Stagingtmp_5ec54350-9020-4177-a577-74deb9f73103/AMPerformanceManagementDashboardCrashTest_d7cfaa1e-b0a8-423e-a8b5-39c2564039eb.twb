            <column caption='AM Team Leader (Current)' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if [Account Manager Type] = &apos;Current&apos; then [current_assigned_team_leader_name]&#10;//ELSE [team_leader_name]&#10;//END&#10;&#10;[current_assigned_team_leader_name]' />
