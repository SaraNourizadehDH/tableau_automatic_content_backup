              <calculation class='tableau' formula='sum([successful_free_delivery_order])&#10;/&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Item Description Ratio - Daily' datatype='real' name='[Item Image Ratio (copy)_2412170196595900417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_description]) / sum([total_active_menu_items])' />
            </column>
            <column caption='Item Image Ratio' datatype='real' default-format='p0.00%' name='[Item Image Ratio - Daily (copy)_2412170196598308871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if [Date Granularity] = &apos;Day&apos; then [Item Image Ratio - Daily]&#10;//elseif [Date Granularity] = &apos;Week&apos; then [Item Image Ratio - Weekly]&#10;//elseif [Date Granularity] = &apos;Month&apos; then [Item Image Ratio - Monthly]&#10;//end&#10;&#10;[Calculation_2412170196595625984]' />
