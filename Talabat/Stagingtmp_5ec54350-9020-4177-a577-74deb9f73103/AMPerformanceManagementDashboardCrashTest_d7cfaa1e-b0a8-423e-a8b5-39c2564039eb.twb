        <caption>
          <formatted-text>
            <run fontcolor='#000000'>Select KPI from Measure I</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='am_chain_vendor_performance_dashboard_reporting' name='sqlproxy.0gxbmd80t3un2i1brp9ow036duee' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Account Manager Type' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current&quot;'>
              <calculation class='tableau' formula='&quot;Current&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
            </column>
            <column caption='POS Vendor for FIR%' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
              <calculation class='tableau' formula='12.5' />
            </column>
            <column caption='Measure I' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
              <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0gxbmd80t3un2i1brp9ow036duee'>
            <column caption='% Order Late &gt; 10min' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 5min (copy)_610871084621979650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_Delivery_late_10min])&#13;&#10;/&#13;&#10;sum([daily_eligible_delivery_late_order])' />
            </column>
            <column caption='% Rider Late &gt; 10min' datatype='real' default-format='p0.0%' name='[% Rider Late &gt; 5min (copy)_610871084621697025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_rider_late_orders_10min])&#13;&#10;/&#13;&#10;sum([daily_all_rider_late_orders])' />
            </column>
            <column caption='% Vendor Late &gt; 5min V2' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 5min (copy)_1887852700440547355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_orders_5min_V2])&#13;&#10;/sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='% Vendor Late &gt; 10min' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 5min (copy)_610871084623101955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_late_orders_10min])&#13;&#10;/sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='% Vendor Late &gt; 10min V2' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 5min V2 (copy)_610871084621475840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_orders_10min_V2])&#13;&#10;/sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='AM Team Leader (Current)' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if [Account Manager Type] = &apos;Current&apos; then [current_assigned_team_leader_name]&#10;//ELSE [team_leader_name]&#10;//END&#10;&#10;[current_assigned_team_leader_name]' />
            </column>
            <column caption='Active tPro Vendor Count' datatype='integer' name='[Active Vendor Count (copy)_2320620466090004480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if zn([tpro_vendor_successful_order_count])&gt;0 then [vendor_id] end)' />
            </column>
            <column caption='Avg Delivery Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227244048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Effective Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227502097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TGO&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Promised Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Time (min) (copy)_1887852700455976999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_promised_delivery_time])&#13;&#10;/&#13;&#10;sum([daily_promised_delivery_orders])' />
            </column>
            <column caption='Avg Voucher Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Discount Amount (copy)_1766818460924456961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([TGO Logistics Fees (copy)_1887852700224712716])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Effective Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Effective Fee TGO (copy)_1887852700227670034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TMP&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg EPT + AVTC (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Estimated Prep Time (min) (copy)_6489898193058914305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700451827743]+[Calculation_1887852700451573790]&#10;&#10;/*&#10;sum([daily_estimated_prep_time] + [daily_vendor_clean_time_min])&#10;/&#10;sum([daily_estimated_prep_time_orders])&#10;*/' />
            </column>
            <column caption='Avg Vendor Late V2 (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Vendor Late (min) (copy)_1887852700451303453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_min_V2])&#13;&#10;/&#13;&#10;sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='Avg Gem Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Voucher Discount (copy)_1766818460924583938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Commission Amount (copy)_1887852700223987720])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='CPC KeyWord Search' datatype='real' name='[CPC Featured Product (copy)_6203497390909984775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_kwords_search_revenue_eur_wo_vat]&#10;else [cpc_kwords_search_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='CPC Vendor Count' datatype='integer' name='[CPC Featured Product (copy)_6478991024390533124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([cpc_featured_products_revenue_lc_wo_vat]&#10;            +[cpc_kwords_search_revenue_eur_wo_vat]&#10;            +[cpc_organic_placements_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='CPP Vendor Count' datatype='integer' name='[CPC Vendor Count (copy)_6478991024391270405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([cpp_featured_products_revenue_lc_wo_vat]&#10;            +[cpp_premium_placements_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='NCR Vendor Count (Excl Banner)' datatype='integer' name='[CPC Vendor Count (copy)_6478991024392220679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([cpc_featured_products_revenue_lc_wo_vat]&#10;            +[cpc_kwords_search_revenue_eur_wo_vat]&#10;            +[cpc_organic_placements_revenue_eur_wo_vat]&#10;            +[cpp_featured_products_revenue_eur_wo_vat]&#10;            +[cpp_premium_placements_revenue_eur_wo_vat]&#10;            +[gem_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='CPP Premium Placements' datatype='real' name='[CPP Featured Products (copy)_6203497390910406665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpp_premium_placements_revenue_eur_wo_vat]&#10;else [cpp_premium_placements_revenue_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='Gem Vendor Count' datatype='integer' name='[CPP Vendor Count (copy)_6478991024391483398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([gem_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_162622169926053888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;END' />
            </column>
            <column caption='Avg Discount Amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1766818460923830272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Delivery Fee (copy)_1887852700223283205])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Commissionable GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460924936195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission Amount (copy)_1887852700222341123])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='ABV - [AFV Sales Defn]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460925415428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700226764814] - [Calculation_1766818460924936195]' />
            </column>
            <column caption='Net Take' datatype='real' name='[Calculation_1766818460925755397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_1887852700221997058]))&#13;&#10;+&#13;&#10;ZN(sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] END))&#13;&#10;+&#13;&#10;ZN(sum([GMV (copy)_1887852700224409610]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_694117325793140736]' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_1887852700221997058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226600973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Discount Amount (copy)_1887852700224237577])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Basket Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226764814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221571073]) / sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Delivery Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700227051535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='TGO Orders' datatype='real' name='[Calculation_1887852700228476948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='FIR Usage, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700229414936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Food_ready_used_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_Food_ready_used_orders_fir]&#13;&#10;    end)&#13;&#10;/&#13;&#10;sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Total_completed_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_total_completed_orders_fir]&#13;&#10;    end)' />
            </column>
            <column caption='% Vendor Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700440100889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_late_orders_5min])&#13;&#10;/sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='Avg Vendor Late (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451053596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_late_min])&#13;&#10;/&#13;&#10;sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='Avg Vendor Clean Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451573790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_clean_time_min])&#13;&#10;/&#13;&#10;sum([daily_vendor_clean_time_orders])' />
            </column>
            <column caption='Avg Estimated Prep Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451827743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_estimated_prep_time])&#13;&#10;/&#13;&#10;sum([daily_estimated_prep_time_orders])' />
            </column>
            <column caption='Avg Preparation Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700452073504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_assumed_actual_preparation_time])&#13;&#10;/&#13;&#10;sum([daily_assumed_actual_preparation_orders])' />
            </column>
            <column caption='Commission %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700452315169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221997058])&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
            </column>
            <column caption='% Incentivized Orders (Incl. Gems)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453523490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='% Free Delivery orders (DF=0)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453847075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_fd_order_count])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Customer Contact Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700454101028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_contacts])&#13;&#10;/&#13;&#10;sum([gross_orders])' />
            </column>
            <column caption='Net Fail Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700454682661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_net_failed_order_count])&#13;&#10;/&#13;&#10;sum([daily_net_order_count])' />
            </column>
            <column caption='Avg Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700455686182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_delivery_time_min])&#13;&#10;/&#13;&#10;sum([daily_delivery_time_orders])' />
            </column>
            <column caption='% Order Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700458917928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_Delivery_late_5min])&#13;&#10;/&#13;&#10;sum([daily_eligible_delivery_late_order])' />
            </column>
            <column caption='% Rider Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700460032041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_rider_late_orders_5min])&#13;&#10;/&#13;&#10;sum([daily_all_rider_late_orders])' />
