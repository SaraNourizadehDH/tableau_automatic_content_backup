            <column caption='Avg Effective Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227502097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TGO&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Effective Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Effective Fee TGO (copy)_1887852700227670034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TMP&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_162622169926053888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;END' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
