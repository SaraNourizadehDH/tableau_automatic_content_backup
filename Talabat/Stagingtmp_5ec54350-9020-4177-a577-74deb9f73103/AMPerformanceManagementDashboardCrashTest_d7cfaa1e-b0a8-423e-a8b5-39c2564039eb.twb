      <column caption='Max Date' datatype='date' name='[Calculation_946881855832399877]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Calculation_1887852700556222519]: MAX([Calculation_1887852700556222519])}' />
      </column>
      <column caption='MTD Filter' datatype='boolean' name='[Calculation_946881855836979209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; THEN&#13;&#10;[date] &gt;= [Calculation_946881855837261834]-1&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; THEN&#13;&#10;[date] &gt;= DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834], &apos;Sunday&apos;)&#13;&#10;and [date] &lt;= DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834], &apos;Sunday&apos;)+DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834], &apos;Sunday&apos;),[Calculation_946881855837261834])&#13;&#10;or&#13;&#10;[date] &gt;= DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834]-7, &apos;Sunday&apos;)&#13;&#10;and [date] &lt;= DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834]-7, &apos;Sunday&apos;)+DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;week&apos;,[Calculation_946881855837261834], &apos;Sunday&apos;),[Calculation_946881855837261834])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; THEN&#13;&#10;[date]&gt;= DATETRUNC(&apos;month&apos;,[Calculation_946881855837261834])&#13;&#10;and [date] &lt;= [Calculation_946881855837261834]&#13;&#10;OR &#13;&#10;[date] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -1, [Calculation_946881855837261834]))&#13;&#10;and [date] &lt;= DATEADD(&apos;month&apos;, -1, [Calculation_946881855837261834])&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Max Date - Overall' datatype='datetime' default-format='*dd-mmm-yy' name='[Calculation_946881855837261834]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED: MAX([date])}' />
      </column>
      <column caption='vs Previous' datatype='string' name='[Calculation_946881855857094672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#13;&#10;when &apos;Day&apos; then &apos;vs Prior Day*&apos;&#13;&#10;when &apos;Week&apos; then &apos;vs Prior Week*&apos;&#13;&#10;when &apos;Month&apos; then &apos;vs Prior Month*&apos;&#13;&#10;END' />
