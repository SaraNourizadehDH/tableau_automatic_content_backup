            <column caption='sum(0)' datatype='integer' name='[Calculation_6203497390924836883]' role='measure' type='quantitative' user:unnamed='NCR, mCVR and VFD Split'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='VFD Total Incentive Amount' datatype='real' name='[Calculation_6203497390926553109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [successful_incentive_amount_eur]&#10;    else [successful_incentive_amount_lc] end)' />
            </column>
            <column caption='VFD Share of Savings %' datatype='real' default-format='p0.00%' name='[Calculation_6203497390927261718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6203497390926553109]&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
