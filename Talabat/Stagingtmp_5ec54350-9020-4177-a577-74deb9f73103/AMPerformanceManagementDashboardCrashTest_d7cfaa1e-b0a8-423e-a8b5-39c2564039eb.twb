            <column caption='Item Discount GMV %' datatype='real' default-format='p0.00%' name='[Menu Discount GMV % (copy)_6478991024390242307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [successful_item_discount_inc_gmv_amount_eur]&#10;    else [successful_item_discount_inc_gmv_amount_lc]&#10;    end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Item Discount Order share' datatype='real' default-format='p0.00%' name='[Menu Discount Order share (copy)_6478991024388169728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_item_discount_order])&#10;/&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Menu Discount Vendor Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Menu Discount Order share (copy)_6478991024392970248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [successful_menu_discount_order]&gt;0 then [vendor_id] end )' />
            </column>
            <column caption='Item Discount Vendor Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Menu Discount Vendor Count (copy)_6478991024393211913]' role='measure' type='quantitative'>
