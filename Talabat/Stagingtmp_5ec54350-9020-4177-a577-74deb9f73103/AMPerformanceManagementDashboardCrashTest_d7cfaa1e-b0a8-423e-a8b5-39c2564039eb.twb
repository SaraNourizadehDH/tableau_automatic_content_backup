            <column caption='Report Date' datatype='date' default-format='*dd-mmm-yy' name='[Calculation_1887852700556222519]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Day]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Day (copy)_1887852700555989046]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
            <column caption='Delivery Cost' datatype='real' name='[Calculation_694117325793140736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 1] = &quot;Local&quot;&#13;&#10;    then [Parameters].[Parameter 4]&#13;&#10;    *[daily_successful_order_count]&#13;&#10;    &#13;&#10;    ELSEIF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 1] = &quot;Eur&quot;&#13;&#10;    THEN ([Parameters].[Parameter 4] * [exchange_rate_to_eur])&#13;&#10;    * [daily_successful_order_count]&#13;&#10;&#13;&#10;END)&#13;&#10;)' />
            </column>
            <column caption='Trends Label' datatype='string' name='[Calculation_946881856178077738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Trends&quot;' />
            </column>
            <column caption='Commission Rate [Sales Defn] %' datatype='real' default-format='p0.0%' name='[Commission % (copy)_1766818460927938568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1887852700221997058]) + sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
