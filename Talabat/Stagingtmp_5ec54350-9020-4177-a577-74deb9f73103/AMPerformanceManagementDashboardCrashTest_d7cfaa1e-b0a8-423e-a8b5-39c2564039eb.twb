            <column caption='ABV - [AFV Sales Defn]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460925415428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700226764814] - [Calculation_1766818460924936195]' />
            </column>
            <column caption='Net Take' datatype='real' name='[Calculation_1766818460925755397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_1887852700221997058]))&#13;&#10;+&#13;&#10;ZN(sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] END))&#13;&#10;+&#13;&#10;ZN(sum([GMV (copy)_1887852700224409610]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_694117325793140736]' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
