    <worksheet name='Analyse Performance KPIs - MoM - Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Bold'>&lt;Sheet Name&gt; </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='11'>| </run>
            <run fontcolor='#000000' fontsize='8'>Current month will be runnrate based on MTD</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='8' italic='true' underline='true'>Important Notes</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>1. Full GMV Coverage: The campaigns are considered based on the initial setup dates. In case if a campagin settings (dates, status,etc) are changed, such changes are not taken into account while calculating this KPI</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>2. Buy x Get y: Not accurately captured due to engineering challenges. This is currently in progress</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>3. (Menu + Item + Inc.FD + BxGy) will not be equal to total VFD orders since multiple incentives can be applied for a single vendor</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>4. VAT has been removed from all NCR revenue metrics</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>5. Bad Vendor metrics are only applicable to only Food Vertical</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>6.VfContact Rate % : Vendor Fault Customer Contact Rate - Contacts due to vendor reasons (BeeHive Definition) </run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='8' italic='true'>7. % of Vendor ProceParity : This KPI is accurate only for month level date granularity. Please make sure that 1st day of the month falls under the date range selected</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='am_chain_vendor_performance_dashboard_reporting' name='sqlproxy.0gxbmd80t3un2i1brp9ow036duee' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.0gxbmd80t3un2i1brp9ow036duee].[Report Date (copy)_921478710079868968]' caption='Select Target Month' datatype='date' name='[Baseline Month (copy)_921478710104662060]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
            <column caption='Account Manager Type' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current&quot;'>
              <calculation class='tableau' formula='&quot;Current&quot;' />
            </column>
            <column caption='View MTD/Full Month' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;Full Month&quot;'>
              <calculation class='tableau' formula='&quot;Full Month&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.0gxbmd80t3un2i1brp9ow036duee].[Report Date (copy)_921478710079868968]' caption='Select Baseline Month' datatype='date' name='[Parameter 18]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Parameter 19]' param-domain-type='list' role='measure' type='nominal' value='&quot;Team Leader&quot;'>
              <calculation class='tableau' formula='&quot;Team Leader&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0gxbmd80t3un2i1brp9ow036duee'>
            <column caption='AM Team Leader (Current)' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if [Account Manager Type] = &apos;Current&apos; then [current_assigned_team_leader_name]&#10;//ELSE [team_leader_name]&#10;//END&#10;&#10;[current_assigned_team_leader_name]' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='ODR Flag' datatype='boolean' name='[Calculation_1887852700554997812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement] = &quot;ODR&quot;' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
            <column caption='View MTD/Full Month' datatype='boolean' name='[Calculation_921478710080561194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 17] = &apos;MTD&apos; then [Granularity (copy)_2116199259332624392] &lt;&gt; &apos;month-runrate-mtf&apos;&#10;else true&#10;&#10;END' />
            </column>
            <column caption='Orders - Target Month' datatype='real' name='[Calculation_921478710106894382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Report Date (copy)_921478710079868968] = [Parameters].[Baseline Month (copy)_921478710104662060] then [daily_successful_order_count] end)' />
            </column>
            <column caption='Orders - Target Month, % of Country Total' datatype='real' default-format='p0.00%' name='[Calculation_921478710143479864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_921478710106894382]&#10;/&#10;[Target Month Orders (copy)_921478710111789111]' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_921478710144237626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 19] = &apos;City&apos; then [City Name (copy)_921478710111522870]&#10;ELSEIF [Parameters].[Parameter 19] = &apos;Team Leader&apos; then [Account Manager (copy)_222224496280100865]&#10;ELSEIF [Parameters].[Parameter 19] = &apos;Account Manager&apos; then [Calculation_222224496275509248]&#10;ELSEIF [Parameters].[Parameter 19] = &apos;Chain&apos; then [chain_name]&#10;ELSEIF [Parameters].[Parameter 19] = &apos;Vendor&apos; then [vendor_name]&#10;&#10;END' />
            </column>
            <column caption='City Name (H)' datatype='string' name='[City Name (copy)_921478710111522870]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Month' datatype='date' default-format='*dd-mmm-yy' name='[Day (copy)_1887852700555935797]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' scope-isolation='false' />
            </column>
            <column caption='Granularity - Monthly' datatype='string' name='[Granularity (copy)_2116199259332624392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]' />
            </column>
            <column caption='Orders - Delta Target vs. Baseline' datatype='real' default-format='n#,##0;-#,##0' name='[Orders - % Delta Target vs. Baseline (copy)_921478710110199861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_921478710106894382]&#10;-&#10;[Successful Orders - I (copy)_921478710107246639]&#10;)' />
            </column>
            <column caption='Report Month' datatype='date' default-format='*dd-mmm-yy' name='[Report Date (copy)_921478710079868968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='Orders - Baseline Month' datatype='real' name='[Successful Orders - I (copy)_921478710107246639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Report Date (copy)_921478710079868968] = [Parameters].[Parameter 18] then [daily_successful_order_count] end)' />
            </column>
            <column caption='Orders - % Delta Target vs. Baseline' datatype='real' default-format='p0.00%' name='[Target Month Orders (copy)_921478710109765683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_921478710106894382]&#10;/&#10;[Successful Orders - I (copy)_921478710107246639]&#10;)&#10;-1' />
            </column>
            <column caption='Orders - Target Month - Fixed' datatype='real' name='[Target Month Orders (copy)_921478710111789111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;{ FIXED &#10;[date]&#10;,[country_name]&#10;&#10;:&#10;sum(if [Report Date (copy)_921478710079868968] = [Parameters].[Baseline Month (copy)_921478710104662060] then [daily_successful_order_count] end)&#10;})' />
            </column>
            <column aggregation='Count' caption='Account Sub Category' datatype='string' default-type='nominal' layered='true' name='[account_sub_category]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
