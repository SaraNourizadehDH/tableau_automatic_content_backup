            <column caption='Avg Delivery Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227244048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Effective Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227502097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TGO&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Promised Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Time (min) (copy)_1887852700455976999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_promised_delivery_time])&#13;&#10;/&#13;&#10;sum([daily_promised_delivery_orders])' />
            </column>
            <column caption='Avg Voucher Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Discount Amount (copy)_1766818460924456961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([TGO Logistics Fees (copy)_1887852700224712716])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Effective Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Effective Fee TGO (copy)_1887852700227670034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TMP&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg EPT + AVTC (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Estimated Prep Time (min) (copy)_6489898193058914305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700451827743]+[Calculation_1887852700451573790]&#10;&#10;/*&#10;sum([daily_estimated_prep_time] + [daily_vendor_clean_time_min])&#10;/&#10;sum([daily_estimated_prep_time_orders])&#10;*/' />
            </column>
            <column caption='Avg Vendor Late V2 (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Vendor Late (min) (copy)_1887852700451303453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_min_V2])&#13;&#10;/&#13;&#10;sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='Avg Gem Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Voucher Discount (copy)_1766818460924583938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Commission Amount (copy)_1887852700223987720])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
