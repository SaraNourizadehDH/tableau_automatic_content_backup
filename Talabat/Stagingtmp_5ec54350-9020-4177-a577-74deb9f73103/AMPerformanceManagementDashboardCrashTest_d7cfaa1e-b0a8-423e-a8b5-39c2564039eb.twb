y Time (min) (copy)_1887852700455976999]&#13;&#10;when &quot;No of Late Orders&quot; then sum([daily_all_delivery_late_orders])&#13;&#10;when &quot;Avg Delivery Distance (km)&quot; then [Calculation_1887852700462321706]&#13;&#10;when &quot;Avg Driving Time (min)&quot; then [Calculation_1887852700462710827]&#13;&#10;when &quot;No of Orders with Stacking&quot; then sum([daily_total_stacked_orders])&#13;&#10;when &quot;Avg Hold Back Time (min)&quot; then [Calculation_1887852700524101677]&#13;&#10;when &quot;New Customers&quot; then sum([daily_order_new_customer_count])&#13;&#10;when &quot;Viewed Menu Subsessions&quot; then sum([daily_viewed_menu_subsession_count])&#13;&#10;when &quot;Placed Order Subsessions&quot; then sum([daily_placed_order_sub_session_count])&#13;&#10;when &quot;Avg Discount Amount&quot; then [Calculation_1766818460923830272]&#13;&#10;when &quot;Avg Voucher Discount&quot; then [Avg Discount Amount (copy)_1766818460924456961]&#13;&#10;when &quot;Avg Gem Discount&quot; then [Avg Voucher Discount (copy)_1766818460924583938]&#13;&#10;when &quot;Avg Commissionable GMV&quot; then [Calculation_1766818460924936195]&#13;&#10;when &quot;ABV - [AFV Sales Defn]&quot; then [Calculation_1766818460925415428]&#13;&#10;when &quot;Net Take per Order&quot; then [Net Take (copy)_1766818460926586886]&#13;&#10;&#10;&#10;//when &quot;﻿vFR % - Bad Vendor&quot; then [vFR % - Bad Vendor]&#10;//when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor]&#10;//when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TMP - VendorFault Contact Rate % - Bad Vendor]&#10;when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [Calculation_6203497390910783499]&#10;when &quot;﻿CPC Featured Prodcut&quot; then [Calculation_6203497390909800454]&#10;when &quot;﻿CPC KeyWord Search&quot; then [CPC Featured Product (copy)_6203497390909984775]&#10;when &quot;﻿CPC Organic Placements&quot; then [Calculation_6203497390909562885] &#10;when &quot;﻿CPP F