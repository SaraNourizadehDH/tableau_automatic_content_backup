              <calculation class='tableau' formula='sum([GMV (copy)_1887852700224409610])/sum([daily_successful_order_count])' />
            </column>
            <column caption='TMP - VendorFault Contact Rate % - Bad Vendor' datatype='real' default-format='p0.00%' name='[TGO - VendorFault Contact Rate % - Bad Vendor (copy)_6203497390917926924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([case_tmp]) / sum(if [delivery_arrangement] = &apos;TMP&apos; then [gross_orders_bad_vendor_cr] end)' />
            </column>
            <column caption='Voucher Discount' datatype='real' name='[TGO Logistics Fees (copy)_1887852700224712716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_voucher_discount_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_voucher_discount_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='TMP Orders' datatype='real' name='[TGO Orders (copy)_1887852700228681749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='TGO Share, %' datatype='real' default-format='p0.0%' name='[TGO Orders (copy)_1887852700228915223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700228476948]&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Pickup Orders' datatype='real' name='[TMP Orders (copy)_1887852700228734998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;PICKUP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Menu Discount GMV %' datatype='real' default-format='p0.00%' name='[VFD GMV (copy)_6478991024389677058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [successful_menu_discount_inc_gmv_amount_eur]&#10;    else [successful_menu_discount_inc_gmv_amount_lc]&#10;    end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='VFD order share %' datatype='real' default-format='p0.00%' name='[VFD GMV Coverage (copy)_6203497390905331716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inc_successful_order_count])&#10;/&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='VFD orders' datatype='real' default-format='p0.00%' name='[VFD order share % (copy)_6203497390926295060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inc_successful_order_count])' />
            </column>
            <column caption='Menu Discount Order share' datatype='real' default-format='p0.00%' name='[VFD order share % (copy)_6203497390927769623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_menu_discount_order])&#10;/&#10;sum([daily_successful_order_count])' />
            </column>
