            <column caption='NCR Ads Revenue (Excl Banner)' datatype='real' name='[Calculation_6203497390910783499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6203497390910263304]&#10;+[CPP Featured Products (copy)_6203497390910406665]&#10;+[Calculation_6203497390909800454]&#10;+[CPC Featured Product (copy)_6203497390909984775]&#10;+[Calculation_6203497390909562885]&#10;+[Calculation_6203497390910578698]' />
            </column>
            <column caption='VFD Total Incentive Amount' datatype='real' name='[Calculation_6203497390926553109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [successful_incentive_amount_eur]&#10;    else [successful_incentive_amount_lc] end)' />
