            <column caption='CPC Organic Placements' datatype='real' name='[Calculation_6203497390909562885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_organic_placements_revenue_eur_wo_vat]&#10;else [cpc_organic_placements_revenue_lc_wo_vat]&#10;END)' />
