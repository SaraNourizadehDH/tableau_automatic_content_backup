361]&#10;when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor (copy)_6203497390917926924]&#10;//when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [NCR Ads Revenue (Excl Banner)]&#10;//when &quot;﻿CPC Featured Prodcut&quot; then [CPC Featured Product]&#10;//when &quot;﻿CPC KeyWord Search&quot; then [CPC KeyWord Search]&#10;//when &quot;﻿CPC Organic Placements&quot; then [CPC Organic Placements] &#10;//when &quot;﻿CPP Featured Product&quot; then [CPP Featured Products]&#10;//when &quot;﻿CPP Premium Placements&quot; then [CPP Premium Placements]&#10;//when &quot;﻿NCR Gems Revenue&quot; then [Gems Revenue]&#10;//when &quot;﻿NCR Vendor Count (Excl. Banner)&quot; then [NCR Vendor Count (Excl Banner)]&#10;//when &quot;﻿CPC Vendor Count&quot; then [CPC Vendor Count]&#10;//when &quot;﻿CPP Vendor Count&quot; then [CPP Vendor Count]&#10;//when &quot;﻿NCR Gem Vendor Count&quot; then [Gem Vendor Count]&#10;when &quot;% Ads Revenue Vendor Penetration&quot; then [Calculation_2320620466098237441]&#10;when &quot;﻿Full GMV Coverage&quot; then [Calculation_6203497390903332866]&#10;when &quot;﻿VFD GMV Coverage&quot; then [Calculation_6203497390904610819]&#10;when &quot;﻿VFD Share of Savings %&quot; then [Calculation_6203497390927261718]&#10;when &quot;﻿VFD Order Share %&quot; then [VFD GMV Coverage (copy)_6203497390905331716]&#10;//when &quot;﻿VFD Orders&quot; then [VFD orders]&#10;//when &quot;﻿VFD GMV&quot; then [VFD GMV]&#10;//when &quot;﻿Menu Discount Orders&quot; then sum([successful_menu_discount_order])&#10;when &quot;﻿Menu Discount Order %&quot; then [VFD order share % (copy)_6203497390927769623]&#10;when &quot;﻿Menu Discount GMV %&quot; then [VFD GMV (copy)_6478991024389677058]&#10;//when &quot;﻿Menu Discount Vendor Count&quot; then [Menu Discount Vendor Count]&#10;//when &quot;﻿Item Discount Orders&quot; then sum([successful_item_discount_order])&#10;when &quot;﻿Item Discount Order %&quot; then [Menu Discount Order share (copy)_6478991024388169728]&#10;when &quot;﻿Item Discount GMV %&quot; then [Menu Discount GMV % (copy)_6478991024390242307]&#10;//when &quot;﻿Item Discount Vendor Count&quot; then [Item Discount Vendor Count]&#10;//when &quot;﻿Inc. Free Delivery Orders&quot; then sum([successful_free_delivery_order])&#10;when &quot;﻿Inc. FD Order %&quot; then [Item Discount Order share (copy)_6478991024388546561]&#10;//when &quot;﻿Buy x Get y Orders&quot; then sum([successful_buy_x_get_y_order])&#10;when &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout (copy)_6478991024399364112]&#10;when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [Calculation_6478991024398819342]&#10;when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3a, Menu - AddToCart (copy)_6478991024399069199]&#10;when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR3, Menu - StartCheckout (copy)_6478991024399560721]&#10;&#10;when &quot;Commission Rev. % of GMV&quot; then [Commission Rate [Sales Defn]] % (copy)_814025654015954947]&#10;&#10;when &quot;Item Image Ratio&quot; then [Item Image Ratio - Daily (copy)_2412170196598308871]&#10;when &quot;Item Description Ratio&quot; then [Item Description Ratio - Daily (copy)_2412170196597977094]&#10;&#10;//when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg EPT + AVTC (min)]&#10;//when &quot;Active Vendor Count&quot; then [Active Vendor Count]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;when &quot;% of Vendor PriceParity(cWatch Matched)&quot; then [Calculation_5163588101853908998]&#10;&#13;&#10;when &quot;Vendor Fail Rate, %&quot; then [Calculation_222224497420701718]&#10;//when &quot;Deal Target Incentive Amount&quot; then sum([Deal Target Incentive Amount])&#10;when &quot;Best Seller, % of Total GMV&quot; then [Calculation_222224497323323406]&#10;when &quot;tPro Vendors - % of GMV&quot; then [Calculation_222224497422790680]&#10;//when &quot;tPro Vendors - GMV&quot; then sum([tPro Vendors - GMV])&#10;//when &quot;Offline Duration (Hrs)&quot; then [Offline Duration (Hrs)]&#10;//when &quot;Scheduled Hours&quot; then [Scheduled Hours]&#10;when &quot;% Offline Duration&quot; then [Calculation_2116199258539524096]&#10;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10; [Calculation_2060678337344253952]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% Offline Duration' datatype='real' default-format='p0.00%' name='[Calculation_2116199258539524096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/&#10;sum([slot_duration_seconds])' />
            </column>
            <column caption='Offline Duration (Hrs)' datatype='real' name='[Calculation_2116199258539667457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/3600' />
            </column>
            <column caption='Scheduled Hours' datatype='real' name='[Calculation_2116199258539765762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([slot_duration_seconds])&#10;/ 3600' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
