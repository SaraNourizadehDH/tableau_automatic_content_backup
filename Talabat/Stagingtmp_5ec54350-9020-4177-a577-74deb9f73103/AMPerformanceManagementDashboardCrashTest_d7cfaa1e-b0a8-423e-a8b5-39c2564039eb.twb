            <column caption='Avg Commissionable GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460924936195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission Amount (copy)_1887852700222341123])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
