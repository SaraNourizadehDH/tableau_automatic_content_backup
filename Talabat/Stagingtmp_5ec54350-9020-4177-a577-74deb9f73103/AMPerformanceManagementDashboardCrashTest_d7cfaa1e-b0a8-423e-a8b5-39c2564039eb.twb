        <rows>[sqlproxy.0gxbmd80t3un2i1brp9ow036duee].[:Measure Names]</rows>
        <cols>[sqlproxy.0gxbmd80t3un2i1brp9ow036duee].[tdy:Report Date (copy)_921478710079868968:ok]</cols>
