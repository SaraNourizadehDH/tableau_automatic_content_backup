            <column caption='Commission Amount' datatype='real' name='[Calculation_1887852700221997058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226600973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Discount Amount (copy)_1887852700224237577])/sum([daily_successful_order_count])' />
