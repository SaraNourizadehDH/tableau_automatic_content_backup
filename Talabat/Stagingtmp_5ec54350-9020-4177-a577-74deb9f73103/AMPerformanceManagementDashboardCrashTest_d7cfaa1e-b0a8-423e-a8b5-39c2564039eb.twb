              <calculation class='tableau' formula='sum([daily_net_failed_order_count])&#13;&#10;/&#13;&#10;sum([daily_net_order_count])' />
            </column>
            <column caption='Avg Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700455686182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_delivery_time_min])&#13;&#10;/&#13;&#10;sum([daily_delivery_time_orders])' />
            </column>
            <column caption='% Order Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700458917928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_Delivery_late_5min])&#13;&#10;/&#13;&#10;sum([daily_eligible_delivery_late_order])' />
