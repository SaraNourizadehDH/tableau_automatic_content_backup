            <column caption='sum(0)' datatype='integer' name='[Calculation_6203497390928986137]' role='measure' type='quantitative' user:unnamed='NCR, mCVR and VFD Split'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='VFD GMV' datatype='real' name='[Calculation_6203497390930489370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [inc_successful_gmv_amount_eur]&#10;    else [inc_successful_gmv_amount_lc]&#10;    end)' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_6478991024393711629]' role='measure' type='quantitative' user:unnamed='NCR, mCVR and VFD Split'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='mCVR3a, Menu - AddToCart' datatype='real' default-format='p0.00%' name='[Calculation_6478991024398819342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_added_to_cart_session_count])/sum([daily_viewed_menu_session_count])' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_6478991024399740948]' role='measure' type='quantitative' user:unnamed='NCR, mCVR and VFD Split'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_6478991024401457174]' role='measure' type='quantitative' user:unnamed='Sales Performance KPIs'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='View MTD/Full Month' datatype='boolean' name='[Calculation_921478710080561194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 17] = &apos;MTD&apos; then [Granularity (copy)_2116199259332624392] &lt;&gt; &apos;month-runrate-mtf&apos;&#10;else true&#10;&#10;END' />
            </column>
            <column caption='Commission Rate [Sales Defn] %' datatype='real' default-format='p0.0%' name='[Commission % (copy)_1766818460927938568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1887852700221997058]) + sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
            </column>
            <column caption='Commissionable GMV' datatype='real' name='[Commission Amount (copy)_1887852700222341123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commissionable_gmv_amount_lc]&#13;&#10;else [daily_successful_commissionable_gmv_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Commissionable GMV (copy)_1887852700222509060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_delivery_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_delivery_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Month' datatype='date' default-format='*dd-mmm-yy' name='[Day (copy)_1887852700555935797]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' scope-isolation='false' />
            </column>
            <column caption='Best Seller GMV Amount' datatype='real' name='[Deal Target Incentive Amount (copy)_222224497064198149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then [best_seller_gmv_amount_lc]&#10;else [best_seller_gmv_amount_eur]&#10;end' />
            </column>
            <column caption='Service Fee' datatype='real' name='[GMV (copy)_1887852700224409610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_service_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_service_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Gem Discount Amount (copy)_1887852700224237577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_order_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_order_gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='Granularity - Monthly' datatype='string' name='[Granularity (copy)_2116199259332624392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]' />
            </column>
            <column caption='Granularity Filter Monthly' datatype='boolean' name='[Granularity Filter (copy)_2116199259332677641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([granularity] , &apos;month&apos;) then true else false&#10;&#10;END' />
