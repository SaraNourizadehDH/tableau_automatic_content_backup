            <column caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
              <calculation class='tableau' formula='12.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0gxbmd80t3un2i1brp9ow036duee'>
            <column caption='% Vendor Late &gt; 5min V2' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 5min (copy)_1887852700440547355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_orders_5min_V2])&#13;&#10;/sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='AM Team Leader (Current)' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if [Account Manager Type] = &apos;Current&apos; then [current_assigned_team_leader_name]&#10;//ELSE [team_leader_name]&#10;//END&#10;&#10;[current_assigned_team_leader_name]' />
            </column>
            <column caption='Avg Delivery Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227244048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Effective Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Fee TGO (copy)_1887852700227502097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TGO&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Promised Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Time (min) (copy)_1887852700455976999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_promised_delivery_time])&#13;&#10;/&#13;&#10;sum([daily_promised_delivery_orders])' />
            </column>
            <column caption='Avg Voucher Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Discount Amount (copy)_1766818460924456961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([TGO Logistics Fees (copy)_1887852700224712716])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Effective Fee TMP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Effective Fee TGO (copy)_1887852700227670034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TMP&quot; then [GMV (copy)_1887852700224409610] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Avg Vendor Late V2 (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Vendor Late (min) (copy)_1887852700451303453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_min_V2])&#13;&#10;/&#13;&#10;sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='Avg Gem Discount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Avg Voucher Discount (copy)_1766818460924583938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Commission Amount (copy)_1887852700223987720])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_162622169926053888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;END' />
            </column>
            <column caption='Avg Discount Amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1766818460923830272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Delivery Fee (copy)_1887852700223283205])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Commissionable GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460924936195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission Amount (copy)_1887852700222341123])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='ABV - [AFV Sales Defn]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818460925415428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700226764814] - [Calculation_1766818460924936195]' />
            </column>
            <column caption='Net Take' datatype='real' name='[Calculation_1766818460925755397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_1887852700221997058]))&#13;&#10;+&#13;&#10;ZN(sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] END))&#13;&#10;+&#13;&#10;ZN(sum([GMV (copy)_1887852700224409610]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_694117325793140736]' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_1887852700221997058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226600973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Discount Amount (copy)_1887852700224237577])/sum([daily_successful_order_count])' />
