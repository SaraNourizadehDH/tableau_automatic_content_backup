    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Top Chain | Vendor - Growth'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/AMPerformanceManagementDashboard-CrashTest/TopChainVendor-Growth?rev=' id='191994' path='/t/Talabat/workbooks/AMPerformanceManagementDashboard-CrashTest' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-title'>
          <format attr='font-weight' value='normal' />
          <format attr='text-align' value='center' />
        </style-rule>
        <style-rule element='dash-subtitle'>
          <format attr='font-weight' value='bold' />
          <format attr='font-size' value='12' />
          <format attr='background-color' value='#e6e6e6' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' value='center' />
          <format attr='vertical-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='2100' maxwidth='1500' minheight='2100' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='am_chain_vendor_performance_dashboard_reporting' name='sqlproxy.0gxbmd80t3un2i1brp9ow036duee' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Account Manager Type' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current&quot;'>
          <calculation class='tableau' formula='&quot;Current&quot;' />
          <members>
            <member value='&quot;Historical&quot;' />
            <member value='&quot;Current&quot;' />
          </members>
        </column>
        <column caption='View MTD/Full Month' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;Full Month&quot;'>
          <calculation class='tableau' formula='&quot;Full Month&quot;' />
          <members>
            <member value='&quot;MTD&quot;' />
            <member value='&quot;Full Month&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
          <calculation class='tableau' formula='&quot;Eur&quot;' />
          <members>
            <member value='&quot;Local&quot;' />
            <member value='&quot;Eur&quot;' />
          </members>
        </column>
        <column caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
          </members>
        </column>
        <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
          <calculation class='tableau' formula='12.5' />
        </column>
        <column caption='Measure I' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
          <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
          <members>
