            <column caption='Item Description Ratio' datatype='real' default-format='p0.00%' name='[Item Description Ratio - Daily (copy)_2412170196597977094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if [Date Granularity] = &apos;Day&apos; then [Item Description Ratio - Daily]&#10;//elseif [Date Granularity] = &apos;Week&apos; then [Item Description Ratio - Weekly]&#10;//elseif [Date Granularity] = &apos;Month&apos; then [Item Description Ratio - Monthly]&#10;//end&#10;&#10;[Item Image Ratio (copy)_2412170196595900417]' />
            </column>
