      <aliases enabled='yes' />
      <column caption='Adhoc Repaid Users Share' datatype='real' default-format='p0.0%' name='[Calculation_1256504332878204928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[repaid_users_count]/[users_count]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_9909304DCB664EB08C27F3F93F37CE9B]' role='measure' type='quantitative' />
