    <datasource caption='experiment_metrics' inline='true' name='federated.0ow0dg30od57vh15csstc0g3ce9k' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qwqa4j12cadui18mmbb10d9ze12'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='mariam.nufal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qwqa4j12cadui18mmbb10d9ze12' name='Custom SQL Query' type='text'><![CDATA[with experiments as 
(select 'exp_ordering_lending_pay_later_multiple_order_payment' experiment_id, 
date('2023-12-26') start_date, 
date('2024-01-26') end_date
union all 
select 'exp_ordering_lending_change_auto_payment_card'
 experiment_id, 
date('2023-08-10') start_date, 
date('2023-09-10') end_date
), 
users as (
select upper(trim(replace(replace(b.user_id,'{',''),'}',''))) user_id,
case when a.experiment_id='exp_ordering_lending_pay_later_multiple_order_payment' and  a.experiment_variant='Variation1' then 'Variation1 - Select All by default' 
when a.experiment_id='exp_ordering_lending_pay_later_multiple_order_payment' and  a.experiment_variant='Variation2' then 'Variation2 - Select Oldest by default'
else a.experiment_variant end experiment_variant, 
a.experiment_id,  
e.end_date, 
count(distinct a.session_id) sessions_count, 
count(distinct b.user_id) users_count, 
min (a.experiment_event_timestamp) first_experiment_date, 
count(distinct (case when fe_journey.payment_bottom_sheet_loaded then a.session_id end )) payment_bottom_sheet_loaded_sessions, 
count(distinct (case when fe_journey.payment_attempted then a.session_id end )) payment_attempted_sessions, 
count(distinct (case when fe_journey.payment_successful then a.session_id end )) payment_successful_sessions, 
from experiments e
join `tlb-data-prod.data_platform.fct_experiment_session` a on 1=1
left join tlb-data-prod.data_platform.fct_session b on a.session_id=b.session_id and b.date>>=e.start_date
and b.date<<=e.end_date
left join 
(select
f.session_id, f.date , logical_or(bottomsheet_name in ('bnpl_old_payment_screen','bnpl_multiple_payment_screen','bnpl_single_payment_screen') and event_action='bottom_sheet.loaded') payment_bottom_sheet_loaded, 
logical_or(event_action like '%bnpl_order_payment%clicked%') payment_attempted, 
logical_or(event_action like '%bnpl_order_payment%completed%') payment_successful
from `tlb-data-prod.data_platform.fct_hit` f
inner join
`tlb-data-prod.data_platform.dim_session_event` se on f.session_event_id = se.session_event_id
inner join
`tlb-data-prod.data_platform.dim_device` d on f.device_id = d.device_id
where f.date>>='2023-12-22' and 
((bottomsheet_name in ('bnpl_old_payment_screen','bnpl_multiple_payment_screen','bnpl_single_payment_screen') and event_action='bottom_sheet.loaded')
or event_action like '%bnpl_order_payment%clicked%'/*attempt*/
or event_action like '%bnpl_order_payment%completed%'/*success*/)
group by 1,2
) fe_journey on fe_journey.date>>=e.start_date and fe_journey.date<<=e.end_date and 
 b.session_id=fe_journey.session_id and b.date=fe_journey.date
where a.date>>=e.start_date
and a.date<<=e.end_date
and a.experiment_id = e.experiment_id
and b.user_id<<>>'00000000-0000-0000-0000-000000000000'
group by 1,2,3,4
order by 1,2,3,4), 
per_user as (
select u.experiment_variant, 
u.experiment_id, 
da.account_id, 
u.sessions_count, 
u.payment_bottom_sheet_loaded_sessions, 
u.payment_attempted_sessions, 
u.payment_successful_sessions,
/************/
count(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.order_id end ) manual_repaid_orders, 
/************/
count(distinct (case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.udf3_external_payment_id end) ) manual_repaid_payments, 
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.order_amount_lc end ),0) manual_repaid_gmv,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Late_Ad_Hoc', 'Completed_Late_On_Retry') then bod.order_amount_lc end ),0) repaid_late_gmv,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Late_Ad_Hoc', 'Completed_Late_On_Retry') then bod.order_amount_lc end ),0)/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success' then bod.order_amount_lc end ),-1) repaid_late_gmv_rate,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.order_state ='Completed' then bod.order_amount_lc end ),0) collected_gmv,
/************/
coalesce(sum(case when bod.order_created_timestamp>>=timestamp(u.first_experiment_date) and  
bod.order_created_timestamp<<=timestamp(u.end_date)  then bod.order_amount_lc end ),0) bnpl_gmv, 
/************/
count(case when bod.order_created_timestamp>>=timestamp(u.first_experiment_date) and  
bod.order_created_timestamp<<=timestamp(u.end_date)  then bod.order_id end ) bnpl_orders , 
/************/
sum(case when bod.order_state='Defaulted' then bod.order_amount_lc end) defaulted_gmv, 
/************/
sum(bod.order_amount_lc) total_bnpl_gmv, 
/************/
coalesce(sum(case when bod.order_state='Defaulted' then bod.order_amount_lc end),0)/case when  sum(bod.order_amount_lc)>>0 then sum(bod.order_amount_lc) else -1 end  default_rate
/************/
from users u 
join tlb-data-prod.data_platform.dim_account da on u.user_id=upper(da.user_id)
left join fulfillment-dwh-production.curated_data_shared_fintech.bnpl_orders_datamart  bod on  da.account_id= 
safe_cast(bod.customer_id as integer) 
-- and 
-- (bod.order_created_timestamp>>=timestamp(u.first_experiment_date) 
-- or bod.payment_datetime>>=timestamp(u.first_experiment_date) ) /*UTC???*/
-- and (bod.order_created_timestamp<<=timestamp(u.end_date) 
-- or bod.payment_datetime<<=timestamp(u.end_date) )
group by 1,2,3,4,5,6,7
) 
select experiment_variant, 
experiment_id,  
count(distinct account_id) users_count, 
count(distinct (case when manual_repaid_orders>> 0 then account_id end )) repaid_users_count, 
sum(manual_repaid_orders)/ count(distinct account_id) avg_manual_repaid_orders,
sum(manual_repaid_orders) total_manual_repaid_orders, 
sum(manual_repaid_payments)/ count(distinct account_id) avg_manual_repaid_payments,
sum(manual_repaid_payments) total_manual_repaid_payments, 
sum(manual_repaid_gmv)/ count(distinct account_id) avg_manual_repaid_gmv,
sum(manual_repaid_gmv) total_manual_repaid_gmv, 
sum(repaid_late_gmv)/count(distinct account_id) avg_repaid_late_gmv, 
sum(bnpl_gmv)/count(distinct account_id) avg_bnpl_gmv, 
sum(bnpl_orders)/count(distinct account_id) avg_bnpl_orders, 
sum(defaulted_gmv)/sum(total_bnpl_gmv) d30_default_rate, 
sum(default_rate)/count(distinct account_id) d30_default_rate_per_user, 
sum(collected_gmv)/count(distinct account_id) avg_collected_gmv,
sum(payment_bottom_sheet_loaded_sessions)/sum(sessions_count) payment_bottom_sheet_loaded_rate,
sum(payment_attempted_sessions)/case when sum(payment_bottom_sheet_loaded_sessions)>>0 then sum(payment_bottom_sheet_loaded_sessions) else -1 end payment_attempted_rate,
sum(payment_successful_sessions)/case when sum(payment_attempted_sessions)>>0 then sum(payment_attempted_sessions) else -1 end payment_successful_out_of_attempt_rate,
sum(payment_successful_sessions)/sum(sessions_count) payment_successful_rate, 
sum(repaid_late_gmv_rate)/count(distinct account_id) avg_repaid_late_gmv_rate
from per_user 
group by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qwqa4j12cadui18mmbb10d9ze12' name='Custom SQL Query' type='text'><![CDATA[with experiments as 
(select 'exp_ordering_lending_pay_later_multiple_order_payment' experiment_id, 
date('2023-12-26') start_date, 
date('2024-01-26') end_date
union all 
select 'exp_ordering_lending_change_auto_payment_card'
 experiment_id, 
date('2023-08-10') start_date, 
date('2023-09-10') end_date
), 
users as (
select upper(trim(replace(replace(b.user_id,'{',''),'}',''))) user_id,
case when a.experiment_id='exp_ordering_lending_pay_later_multiple_order_payment' and  a.experiment_variant='Variation1' then 'Variation1 - Select All by default' 
when a.experiment_id='exp_ordering_lending_pay_later_multiple_order_payment' and  a.experiment_variant='Variation2' then 'Variation2 - Select Oldest by default'
else a.experiment_variant end experiment_variant, 
a.experiment_id,  
e.end_date, 
count(distinct a.session_id) sessions_count, 
count(distinct b.user_id) users_count, 
min (a.experiment_event_timestamp) first_experiment_date, 
count(distinct (case when fe_journey.payment_bottom_sheet_loaded then a.session_id end )) payment_bottom_sheet_loaded_sessions, 
count(distinct (case when fe_journey.payment_attempted then a.session_id end )) payment_attempted_sessions, 
count(distinct (case when fe_journey.payment_successful then a.session_id end )) payment_successful_sessions, 
from experiments e
join `tlb-data-prod.data_platform.fct_experiment_session` a on 1=1
left join tlb-data-prod.data_platform.fct_session b on a.session_id=b.session_id and b.date>>=e.start_date
and b.date<<=e.end_date
left join 
(select
f.session_id, f.date , logical_or(bottomsheet_name in ('bnpl_old_payment_screen','bnpl_multiple_payment_screen','bnpl_single_payment_screen') and event_action='bottom_sheet.loaded') payment_bottom_sheet_loaded, 
logical_or(event_action like '%bnpl_order_payment%clicked%') payment_attempted, 
logical_or(event_action like '%bnpl_order_payment%completed%') payment_successful
from `tlb-data-prod.data_platform.fct_hit` f
inner join
`tlb-data-prod.data_platform.dim_session_event` se on f.session_event_id = se.session_event_id
inner join
`tlb-data-prod.data_platform.dim_device` d on f.device_id = d.device_id
where f.date>>='2023-12-22' and 
((bottomsheet_name in ('bnpl_old_payment_screen','bnpl_multiple_payment_screen','bnpl_single_payment_screen') and event_action='bottom_sheet.loaded')
or event_action like '%bnpl_order_payment%clicked%'/*attempt*/
or event_action like '%bnpl_order_payment%completed%'/*success*/)
group by 1,2
) fe_journey on fe_journey.date>>=e.start_date and fe_journey.date<<=e.end_date and 
 b.session_id=fe_journey.session_id and b.date=fe_journey.date
where a.date>>=e.start_date
and a.date<<=e.end_date
and a.experiment_id = e.experiment_id
and b.user_id<<>>'00000000-0000-0000-0000-000000000000'
group by 1,2,3,4
order by 1,2,3,4), 
per_user as (
select u.experiment_variant, 
u.experiment_id, 
da.account_id, 
u.sessions_count, 
u.payment_bottom_sheet_loaded_sessions, 
u.payment_attempted_sessions, 
u.payment_successful_sessions,
/************/
count(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.order_id end ) manual_repaid_orders, 
/************/
count(distinct (case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.udf3_external_payment_id end) ) manual_repaid_payments, 
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Early_Ad_Hoc','Completed_On_Schedule_Ad_Hoc','Completed_Late_Ad_Hoc') then bod.order_amount_lc end ),0) manual_repaid_gmv,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Late_Ad_Hoc', 'Completed_Late_On_Retry') then bod.order_amount_lc end ),0) repaid_late_gmv,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.installment_state in 
('Completed_Late_Ad_Hoc', 'Completed_Late_On_Retry') then bod.order_amount_lc end ),0)/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success' then bod.order_amount_lc end ),-1) repaid_late_gmv_rate,
/************/
coalesce(sum(case when bod.payment_datetime>>=timestamp(u.first_experiment_date) and  
bod.payment_datetime<<=timestamp(u.end_date) and
bod.payment_status='success'
and bod.order_state ='Completed' then bod.order_amount_lc end ),0) collected_gmv,
/************/
coalesce(sum(case when bod.order_created_timestamp>>=timestamp(u.first_experiment_date) and  
bod.order_created_timestamp<<=timestamp(u.end_date)  then bod.order_amount_lc end ),0) bnpl_gmv, 
/************/
count(case when bod.order_created_timestamp>>=timestamp(u.first_experiment_date) and  
bod.order_created_timestamp<<=timestamp(u.end_date)  then bod.order_id end ) bnpl_orders , 
/************/
sum(case when bod.order_state='Defaulted' then bod.order_amount_lc end) defaulted_gmv, 
/************/
sum(bod.order_amount_lc) total_bnpl_gmv, 
/************/
coalesce(sum(case when bod.order_state='Defaulted' then bod.order_amount_lc end),0)/case when  sum(bod.order_amount_lc)>>0 then sum(bod.order_amount_lc) else -1 end  default_rate
/************/
from users u 
join tlb-data-prod.data_platform.dim_account da on u.user_id=upper(da.user_id)
left join fulfillment-dwh-production.curated_data_shared_fintech.bnpl_orders_datamart  bod on  da.account_id= 
safe_cast(bod.customer_id as integer) 
-- and 
-- (bod.order_created_timestamp>>=timestamp(u.first_experiment_date) 
-- or bod.payment_datetime>>=timestamp(u.first_experiment_date) ) /*UTC???*/
-- and (bod.order_created_timestamp<<=timestamp(u.end_date) 
-- or bod.payment_datetime<<=timestamp(u.end_date) )
group by 1,2,3,4,5,6,7
) 
select experiment_variant, 
experiment_id,  
count(distinct account_id) users_count, 
count(distinct (case when manual_repaid_orders>> 0 then account_id end )) repaid_users_count, 
sum(manual_repaid_orders)/ count(distinct account_id) avg_manual_repaid_orders,
sum(manual_repaid_orders) total_manual_repaid_orders, 
sum(manual_repaid_payments)/ count(distinct account_id) avg_manual_repaid_payments,
sum(manual_repaid_payments) total_manual_repaid_payments, 
sum(manual_repaid_gmv)/ count(distinct account_id) avg_manual_repaid_gmv,
sum(manual_repaid_gmv) total_manual_repaid_gmv, 
sum(repaid_late_gmv)/count(distinct account_id) avg_repaid_late_gmv, 
sum(bnpl_gmv)/count(distinct account_id) avg_bnpl_gmv, 
sum(bnpl_orders)/count(distinct account_id) avg_bnpl_orders, 
sum(defaulted_gmv)/sum(total_bnpl_gmv) d30_default_rate, 
sum(default_rate)/count(distinct account_id) d30_default_rate_per_user, 
sum(collected_gmv)/count(distinct account_id) avg_collected_gmv,
sum(payment_bottom_sheet_loaded_sessions)/sum(sessions_count) payment_bottom_sheet_loaded_rate,
sum(payment_attempted_sessions)/case when sum(payment_bottom_sheet_loaded_sessions)>>0 then sum(payment_bottom_sheet_loaded_sessions) else -1 end payment_attempted_rate,
sum(payment_successful_sessions)/case when sum(payment_attempted_sessions)>>0 then sum(payment_attempted_sessions) else -1 end payment_successful_out_of_attempt_rate,
sum(payment_successful_sessions)/sum(sessions_count) payment_successful_rate, 
sum(repaid_late_gmv_rate)/count(distinct account_id) avg_repaid_late_gmv_rate
from per_user 
group by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
