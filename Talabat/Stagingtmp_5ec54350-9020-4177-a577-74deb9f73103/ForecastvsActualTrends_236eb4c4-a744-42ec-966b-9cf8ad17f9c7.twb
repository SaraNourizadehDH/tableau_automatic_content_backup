        <field-sort-custom-order field='actual_acquisitions' />
      </field-sort-info>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_570BD8FBFEEF4E24A1E57E6DF83B22AD'>
            <properties context=''>
              <relation connection='bigquery.0joz59215u4f5v14n2nzn05f3rpc' name='Custom SQL Query' type='text'>with all_forecast as (
  select
    DISTINCT source_id,
    case when rfo.country_iso = &apos;QAR&apos; then &apos;QA&apos; else rfo.country_iso end as country_code,
    iso_date,
    forecast_date,
    &apos;nfv&apos; as vertical,
    forecasted_orders as forecasted_succ_orders,
    (
      forecasted_aov * forecasted_orders
    ) forecasted_gmv_lc --    ,0 as forecasted_acq
    ,
    forecasted_platform_acqns as forecasted_acq
  from
    `tlb-data-prod.data_platform.forecast_nfv_daily` rfo
  union all
  select
    DISTINCT source_id,
    case when country_iso = &apos;QAR&apos; then &apos;QA&apos; else country_iso end as country_code,
    iso_date,
    forecast_date,
    &apos;tmart&apos; as vertical,
    forecasted_orders as forecasted_succ_orders,
    (
      forecasted_aov * forecasted_orders
    ) forecasted_gmv_lc --    ,0 as forecasted_acq
    ,
    forecasted_platform_acqns as forecasted_acq
  from
    `tlb-data-prod.data_platform.forecast_tmart_daily` ---where vertical = &apos;tmart&apos;
  union all
  select
    DISTINCT source_id,
    case when country_iso = &apos;QAR&apos; then &apos;QA&apos; else country_iso end as country_code,
    iso_date,
    forecast_date,
    &apos;food&apos; as vertical,
    forecasted_orders as forecasted_succ_orders,
    (forecasted_aov*forecasted_orders) as forecasted_gmv_lc,
    forecasted_acqns as forecasted_acq
  from
    `tlb-data-prod.data_platform.forecast_food_daily`

),
forecasted_orders as (
  (
    select
      rfo.source_id,
      &apos;TB_&apos; || trim(
        upper(rfo.country_code)
      ) as entity_code,
      trim(
        upper(rfo.country_code)
      ) as country_code,
      date_trunc(forecast_date, MONTH) forecast_month,
      iso_date,
      forecast_date,
      vertical,
      sum(rfo.forecasted_succ_orders) successful_orders,
      sum(rfo.forecasted_gmv_lc) suc_gmv_lc,
      sum(rfo.forecasted_acq) as acquisitions
    from
      all_forecast rfo
    where
      forecast_date &gt;&gt;= &apos;2023-12-01&apos;
      and iso_date &gt;&gt;= forecast_date
--       and date_trunc(iso_date, MONTH)= date_trunc(forecast_date, MONTH)
    group by
      1,
      2,
      3,
      4,
      5,
      6,
      7
  )
  
)


,actuals as 
(select
  dd.day_of_Week_mena
  ,o.country_code
  ,o.order_date
  ,case when ((not o.is_non_food and not coalesce(v.is_everyday_roastery,false)) or coalesce(v.is_dh_kitchen,false)) then &apos;food&apos;
        when not coalesce(o.is_dsaas_vendor,false) and (o.is_darkstore or coalesce(v.is_everyday_roastery,false)) then &apos;tmart&apos;
        else &apos;nfv&apos;
    end as vertical

  ,count(distinct case when o.is_successful then order_id end) as successful_order_count
  ,sum(case when o.is_successful then gmv_amount_lc end) as successful_gmv_amount_lc
  ,sum(case when o.is_successful then gmv_amount_eur end) as successful_gmv_amount_eur
  ,count(distinct case when o.is_successful and is_acquisition then order_id end) as acquisition_count

from `tlb-data-prod.data_platform.fct_order_info` o
inner join `tlb-data-prod.data_platform.dim_date` dd
  on o.order_date = dd.date
left join `tlb-data-prod.data_platform.dim_vendor_info` v
  on o.vendor_id = v.vendor_id

where
  o.order_date &gt;&gt;= &apos;2023-12-01&apos;

group by 1,2,3,4)


(select
  entity_code,
  t1.country_code as business_entity,
  iso_date,
  t1.forecast_date,
  forecast_month,
  t1.vertical ,
  -- date_diff(t1.forecast_date, current_date(), DAY) as forecast_day_identifier,
  t1.successful_orders as forecasted_orders,

  t2.successful_order_count as actual_orders,

  t1.suc_gmv_lc as forecasted_gmv_lc,
  t2.successful_gmv_amount_lc as actual_gmv_lc,

  t1.acquisitions as forecasted_acquisitions,
  t2.acquisition_count as actual_acquisitions
  
from
  forecasted_orders t1
  left join actuals t2
    on t1.iso_date = t2.order_date
    and t1.country_code = t2.country_code
    and t1.vertical = t2.vertical

where iso_date&gt;&gt;=forecast_date
and date_trunc(iso_date,month) = date_trunc(forecast_date,month)
  
  )</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
