      <aliases enabled='yes' />
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_2934376656608235521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([success (copy)_935200633463648257]) +sum([Calculation_937030220116738048])) /sum([sub_sessions_count])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_4020307117858263040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [date]&gt;=[Parameters].[Parameter 4] &#10;and [date]&lt;=[Parameters].[Parameter 5] then &apos;Selected Period&apos;&#10;ELSEIF [date]&gt;=[Parameters].[Parameter 4]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 4], [Parameters].[Parameter 5])+1)&#10;and [date]&lt;=[Parameters].[Parameter 5]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 4], [Parameters].[Parameter 5])+1)&#10;then &apos;Comparison Period&apos;&#10;ELSE &apos;Remaining days&apos;&#10;end' />
      </column>
      <column caption='Index' datatype='boolean' name='[Calculation_4020307117861449729]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Group By' datatype='string' name='[Calculation_450289621302472705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &quot;payment method&quot; then [first_payment_method]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;operating system&quot; then [operating_system]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;None&quot; then &quot;No group&quot;&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;Country&quot; then [country_code]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Limit&quot; then [liability_limit]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Adopter&quot; then if [is_bnpl_adopter] then &apos;BNPL adopter&apos; else &apos;Non BNPL adopter&apos; end &#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Eligible&quot; then if [is_bnpl_eligible] then &apos;BNPL eligible&apos; else &apos;Non BNPL eligible&apos; end &#10;END' />
      </column>
      <column caption='Success Rate' datatype='real' default-format='p0.0%' name='[Calculation_935200633115025408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_937030220116738048])/sum([sub_sessions_count])' />
      </column>
      <column caption='Recovery Payment Method' datatype='string' name='[Calculation_935200633484902407]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [acceptance_detail]=&apos;recovery with multiple attempt&apos; then [last_payment_method]&#10;end' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_935200633561739272]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;day&apos; then [date]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;month&apos; then [month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;week&apos; then [week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;quarter&apos; then [quarter]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;year&apos; then [year]&#10;END' />
      </column>
      <column caption='Metric' datatype='real' default-format='p0.0%' name='[Calculation_935200633564250122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;success&apos; then [Calculation_935200633115025408] &#10;elseif [Parameters].[Parameter 2]=&apos;failure&apos; then [Recovery Rate (copy 2)_935200633463996420]&#10;elseif [Parameters].[Parameter 2]=&apos;recovery&apos; then [Success Rate (copy)_935200633463873538]&#10;elseif [Parameters].[Parameter 2]=&apos;unknown&apos; then [Recovery Rate (copy)_935200633463988227]&#10;elseif [Parameters].[Parameter 2]=&apos;acceptance&apos; then [Calculation_2934376656608235521]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;failure single&apos; then [Failure Rate (copy 2)_2934376656609193989]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;failure multiple&apos; then [Failure Rate (copy)_2934376656609185796]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;success single&apos; then [Success Rate (copy)_2934376656610164744]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;success multiple&apos; then [Success Rate (copy 2)_2934376656610172937]&#10;end' />
      </column>
      <column caption='Success sub sessions' datatype='integer' name='[Calculation_937030220116738048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [acceptance_detail] =&apos;success with one attempt&apos; or &#10;[acceptance_detail]=&apos;success with multiple attempts&apos; &#10;then [sub_sessions_count]&#10;END' />
      </column>
      <column caption='Failure Rate one attempt' datatype='real' default-format='p0.0%' name='[Failure Rate (copy 2)_2934376656609193989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Failure sub sessions (copy 2)_2934376656609009667])/sum([sub_sessions_count])' />
      </column>
      <column caption='Failure Rate multiple attempts' datatype='real' default-format='p0.0%' name='[Failure Rate (copy)_2934376656609185796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Failure sub sessions (copy)_2934376656609001474])/sum([sub_sessions_count])' />
      </column>
      <column caption='Failure sub sessions one attempt' datatype='integer' name='[Failure sub sessions (copy 2)_2934376656609009667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [acceptance_detail] =&apos;failure with one attempt&apos; &#10;then [sub_sessions_count]&#10;END' />
      </column>
      <column caption='Failure sub sessions multiple attempts' datatype='integer' name='[Failure sub sessions (copy)_2934376656609001474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [acceptance_detail] =&apos;failure with multiple attempts&apos; &#10;then [sub_sessions_count]&#10;END' />
