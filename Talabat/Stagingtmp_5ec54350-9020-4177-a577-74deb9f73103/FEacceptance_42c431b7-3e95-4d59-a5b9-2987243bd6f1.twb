        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0p2p2360fyy3mq17l63gc0656bz1' name='Custom SQL Query' type='text'><![CDATA[select date, 
first_payment_method,
last_payment_method,
first_payment_method_session_error_category,
first_payment_method_session_error, 
operating_system, 
country_code, 
acceptance_detail, 
liability_limit, 
sub_sessions_count, 
is_bnpl_eligible,
is_bnpl_adopter, 
bnpl_batch_id,
attempts_count
from tlb-data-dev.data_playground_finance.fe_acceptance
where operating_system<<>>'BlackBerry'
and first_payment_method is not null
and first_payment_method<<>>'Unknown'
and last_payment_method<<>>'Unknown'
and first_payment_method<<>>'Credit Card/BNPL/Apple Pay'
and last_payment_method<<>>'Credit Card/BNPL/Apple Pay'
and (

(first_payment_method='BNPL' and date>>='2023-11-08')
or 
(first_payment_method='talabat Pay' and date>>='2023-11-08')
or 
(first_payment_method='Debit Card' and date>>='2023-09-04')
or 
(first_payment_method in ('Apple Pay','Credit Card') and date>>='2023-06-13')
or 
first_payment_method in ('Unknown' , 'Cash')
)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
