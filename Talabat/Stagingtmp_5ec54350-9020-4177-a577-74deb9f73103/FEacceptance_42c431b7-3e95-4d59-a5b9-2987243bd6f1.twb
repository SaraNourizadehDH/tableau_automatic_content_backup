          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1owscdr09uvtxq124geuk1g79ayh'>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_2934376656608235521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([success (copy)_935200633463648257]) +sum([Calculation_937030220116738048])) /sum([sub_sessions_count])' />
            </column>
            <column caption='Group By' datatype='string' name='[Calculation_450289621302472705]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &quot;payment method&quot; then [first_payment_method]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;operating system&quot; then [operating_system]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;None&quot; then &quot;No group&quot;&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;Country&quot; then [country_code]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Limit&quot; then [liability_limit]&#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Adopter&quot; then if [is_bnpl_adopter] then &apos;BNPL adopter&apos; else &apos;Non BNPL adopter&apos; end &#10;ELSEIF  [Parameters].[Parameter 6] = &quot;BNPL Eligible&quot; then if [is_bnpl_eligible] then &apos;BNPL eligible&apos; else &apos;Non BNPL eligible&apos; end &#10;END' />
            </column>
            <column caption='Success Rate' datatype='real' default-format='p0.0%' name='[Calculation_935200633115025408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_937030220116738048])/sum([sub_sessions_count])' />
