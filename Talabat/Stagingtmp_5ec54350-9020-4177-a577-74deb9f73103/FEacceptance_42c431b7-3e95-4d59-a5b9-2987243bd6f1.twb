        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vefd3m1bcucuo18wfcjc10zm6ug' name='Custom SQL Query' type='text'>select
 date_trunc(e.date, month) month, round(count(distinct case when b.session_id is null then e.session_id end )/ count(distinct e.session_id),2) percentage_difference
from
  tlb-data-prod.data_platform.fct_experiment_session as e
  left join (
    select session_id
from `tlb-data-prod.data_platform.fct_hit` f
inner join
`tlb-data-prod.data_platform.dim_session_event` se on f.session_event_id = se.session_event_id
left join
`tlb-data-prod.data_platform.dim_device` d on f.device_id = d.device_id
left join
`tlb-data-prod.data_platform.dim_location` loc on f.location_id = loc.location_id
Left join
`tlb-data-prod.data_platform.dim_payment_method` pay on f.payment_method_id = pay.payment_method_id
left join tlb-data-prod.data_platform.dim_session_error b on f.session_error_id=b.session_error_id
where f.date &gt;&gt;=&apos;2023-09-01&apos;
And event_action=&apos;checkout.loaded&apos;
and event_origin=&apos;flutter&apos;
  ) b on e.session_id=b.session_id
where
  e.date &gt;&gt;=&apos;2023-09-01&apos;
  and e.experiment_id = &quot;checkout-rewrite&quot;
  and e.experiment_variant=&quot;Variation1&quot;
  group by 1
  order by 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
