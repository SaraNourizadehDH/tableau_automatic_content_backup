    <datasource caption='vouchers_redeemers' inline='true' name='federated.1d7xflk0hbeol41e5c2nl1fvdvz9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ypyijd1pyksi41dwi8hi12sbc95'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='mariam.nufal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ypyijd1pyksi41dwi8hi12sbc95' name='Custom SQL Query' type='text'>with participants as 
(select distinct   
experiment_id,
experiment_variant,
b.user_id, 
d.account_id, 
case when experiment_id in (&apos;exp_homepage_rewards_kuwait_holdout&apos;, 
&apos;exp_homepage_rewards_kuwait_launch&apos;) then 1 
when experiment_id in (&apos;exp_homepage_rewards_bahrain_holdout&apos;, 
&apos;exp_homepage_rewards_bahrain_launch&apos;) then 3 
end as country_id
from `tlb-data-prod.data_platform.fct_experiment_session` a
left join `tlb-data-prod.data_platform.fct_session` b on a.session_id = b.session_id and a.date = b.date
left join `tlb-data-prod.data_platform.dim_account` d on b.user_id=d.user_id 
where a.date&gt;&gt;=&apos;2023-01-17&apos;
and b.date&gt;&gt;=&apos;2023-01-17&apos;
and experiment_id in (&apos;exp_homepage_rewards_kuwait_holdout&apos;, 
&apos;exp_homepage_rewards_kuwait_launch&apos;, 
&apos;exp_homepage_rewards_bahrain_holdout&apos;, 
&apos;exp_homepage_rewards_bahrain_launch&apos;)
)
select c.order_date,
d.experiment_id,
d.experiment_variant, 
count (distinct a.account_id) vouchers_redeemers_count
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
join `tlb-data-prod.data_platform.dim_incentives_voucher` b  on a.voucher_option_id = b.campaign_id
join `tlb-data-prod.data_platform.fct_order_info` c on a.order_id =safe_cast (c.order_id as string) and b.country_id = c.country_id
join participants d on a.account_id=d.account_id and c.country_id=d.country_id
and c.is_successful
where b.incentive_type_detail in (&apos;LOYALTY&apos;, &apos;NFP&apos;)
/*to exclude missions vouchers*/
and b.campaign_id not in (select replace(replace (campaign_ids.item,&apos;[&quot;&apos;,&apos;&apos;),&apos;&quot;]&apos;,&apos;&apos;) 
FROM `tlb-data-prod.data_platform.dim_reward_mission`)
and a.is_used=true
and c.order_date&gt;&gt;=&apos;2023-01-01&apos;
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
