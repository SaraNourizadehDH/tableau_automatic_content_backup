        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0d2ukm905tp1u2151282y1gi5q6s' name='Custom SQL Query' type='text'><![CDATA[select a.date , 
experiment_id,
experiment_variant,
a.operating_system,
count( distinct b.user_id) number_of_users,  
count( distinct c1.account_id) number_of_users_visit_catalogue_same_session
from `tlb-data-prod.data_platform.fct_experiment_session` a
left join `tlb-data-prod.data_platform.fct_session` b on a.session_id = b.session_id and a.date = b.date
left join `tlb-data-prod.data_platform.dim_account` d on b.user_id=d.user_id 
left join `tlb-data-prod.data_platform.fct_sub_session_loyalty` c1 on 
c1.date>>'2023-01-01' and d.account_id=c1.account_id and c1.found_via<<>>'cart'
and c1.session_id=a.session_id
where a.date>>='2023-01-17'
and b.date>>='2023-01-17'
and experiment_id in ('exp_homepage_rewards_kuwait_holdout', 
'exp_homepage_rewards_kuwait_launch', 
'exp_homepage_rewards_bahrain_holdout', 
'exp_homepage_rewards_bahrain_launch')
group by 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
