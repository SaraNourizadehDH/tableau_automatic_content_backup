          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jfinzx0drb84j1bwu2t31d6lyn3' name='Custom SQL Query' type='text'><![CDATA[select c.date , 
experiment_id,
experiment_variant,
count( distinct (case when loc.location_id is not null then c.account_id end )) 
number_of_users_visit_catalogue_same_country
from `tlb-data-prod.data_platform.fct_experiment_session` a
join `tlb-data-prod.data_platform.fct_session` b on a.session_id = b.session_id and a.date = b.date
join `tlb-data-prod.data_platform.dim_account` d on b.user_id=d.user_id 
join `tlb-data-prod.data_platform.fct_sub_session_loyalty` c 
on c.date>>'2023-01-01' and d.account_id=c.account_id and c.found_via<<>>'cart' 
join `tlb-data-prod.data_platform.dim_location` loc on c.location_id=loc.location_id
and ((loc.country_name='Kuwait' and experiment_id in ('exp_homepage_rewards_kuwait_holdout', 
'exp_homepage_rewards_kuwait_launch')) 

or 
(loc.country_name='Bahrain' and experiment_id in ( 
'exp_homepage_rewards_bahrain_holdout', 
'exp_homepage_rewards_bahrain_launch')))
where a.date>>='2023-01-17'
and b.date>>='2023-01-17'
and experiment_id in ('exp_homepage_rewards_kuwait_holdout', 
'exp_homepage_rewards_kuwait_launch', 
'exp_homepage_rewards_bahrain_holdout', 
'exp_homepage_rewards_bahrain_launch')
group by 1,2,3
order by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
