          <named-connection caption='BigQuery' name='bigquery.1ggrxpi1vhrmmg10h062h1l8nvhr'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='mariam.nufal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ggrxpi1vhrmmg10h062h1l8nvhr' name='Custom SQL Query' type='text'>with participants as 
(select distinct   
experiment_id,
experiment_variant,
b.user_id, 
d.account_id, 
case when experiment_id in (&apos;exp_homepage_rewards_kuwait_holdout&apos;, 
&apos;exp_homepage_rewards_kuwait_launch&apos;) then 1 
when experiment_id in  
(
&apos;exp_homepage_rewards_bahrain_holdout&apos;, 
&apos;exp_homepage_rewards_bahrain_launch&apos;) then 3
end as country_id
from `tlb-data-prod.data_platform.fct_experiment_session` a
left join `tlb-data-prod.data_platform.fct_session` b on a.session_id = b.session_id and a.date = b.date
left join `tlb-data-prod.data_platform.dim_account` d on b.user_id=d.user_id 
where a.date&gt;&gt;=&apos;2023-01-17&apos;
and b.date&gt;&gt;=&apos;2023-01-17&apos;
and experiment_id in 
(&apos;exp_homepage_rewards_kuwait_holdout&apos;, 
&apos;exp_homepage_rewards_kuwait_launch&apos;, 
&apos;exp_homepage_rewards_bahrain_holdout&apos;, 
&apos;exp_homepage_rewards_bahrain_launch&apos;)
)
select b.transaction_date_utc, 
a.experiment_id, 
a.experiment_variant , 
count (distinct ( case when b.transaction_type_id in (200,220,230,201) 
then b.account_id end )) burning_users_count ,
count (distinct ( case when b.transaction_type_id in (100,400,101,102) then b.account_id end )) earning_users_count , 
count (distinct ( case when b.transaction_type_id in (300,301) then b.account_id end )) count_users_earn_welcome_gift , 
count (distinct ( case when b.transaction_type_id in (900) then b.account_id end )) count_users_expire_points 
from participants a 
join `tlb-data-prod.data_platform.fct_loyalty_transaction` b on 
(a.account_id=b.account_id and b.transaction_country_id=a.country_id/*only in Kuwait*/
and b.transaction_date_utc&gt;&gt;=&apos;2023-01-01&apos;
)
group by 1,2,3
order by 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
