      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0u9pe731el2wdt1btz5be047p028].[sum:Calculation_2128302715359711232:qk]&quot;' value='PostPaid customers %' />
        </aliases>
      </column>
      <column caption='All four ecosystems customers %' datatype='real' default-format='p0.0%' name='[All four ecosystems customers (copy)_2494783119252455433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[bnpl_rewards_tpro_cards]/[any_of_them]' />
      </column>
      <column caption='Postpaid &amp; Talabat Card Customers Overall GMV %' datatype='real' default-format='p0.0%' name='[Calculation_1066930925515141120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_292382148345290755]+[Calculation_292382148345909252]+ [Calculation_292382148352811025]+&#10;[Calculation_292382148351430668]+ [Calculation_292382148351717389]&#10;+ [Calculation_292382148352380943]+[Calculation_292382148352573456]&#10;+ [Calculation_292382148348850185] + [Calculation_292382148349640715]&#10;+[Calculation_292382148347662343] +[Calculation_292382148346499078]+ &#10;[Calculation_292382148348518408]' />
      </column>
      <column caption='MV filter' datatype='boolean' name='[Calculation_1304706926003961872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Include PostPaid (copy) (copy) (copy)_1304706925972488205]' />
      </column>
      <column caption='PostPaid Customers %' datatype='real' name='[Calculation_2128302715359711232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[bnpl_active]/[platform_active]' />
      </column>
      <column caption='Keep last months' datatype='boolean' name='[Calculation_2128302715402076165]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [month], datetrunc(&apos;month&apos;,date(TODAY())))&lt;=6 then true else false end' />
      </column>
      <column caption='is_adcb_data_shared' datatype='string' name='[Calculation_2597591877526335488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull(adcb_share_gmv_w_apple_pay) and [month]&gt;=date(&apos;2023-05-01&apos;)  &#10;then &apos;Apple pay talabat card GMV is not yet received from the bank for this month or not uploaded in the google sheet&apos; end' />
      </column>
      <column caption='Customers Count' datatype='integer' name='[Calculation_2849793419005747201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Tpro &amp; Pay Later overlap only&apos; then [tpro_bnpl_only]&#10;+[bnpl_rewards_tpro_cards]+ [bnpl_tpro_cards_not_rewards]&#10;+[bnpl_rewards_tpro_not_cards]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro &amp; Rewards overlap only&apos; then [tpro_rewards_only]&#10;+[bnpl_rewards_tpro_cards]+ [bnpl_rewards_tpro_not_cards]&#10;+ [rewards_tpro_cards_not_bnpl]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro &amp; Talabat Card overlap only&apos; then [tpro_cards_only]&#10;+[bnpl_rewards_tpro_cards]+ [bnpl_tpro_cards_not_rewards]&#10;+ [rewards_tpro_cards_not_bnpl]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Pay Later &amp; Rewards overlap only&apos; then [bnpl_rewards_only]&#10;+[bnpl_rewards_tpro_cards]+ [bnpl_rewards_tpro_not_cards]&#10;+ [rewards_bnpl_cards_not_tpro]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Pay Later &amp; Talabat Card overlap only&apos; then [cards_bnpl_only]&#10;+[bnpl_rewards_tpro_cards]+ [bnpl_tpro_cards_not_rewards]&#10;+ [rewards_bnpl_cards_not_tpro]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Rewards overlap only&apos; then [cards_rewards_only]&#10;+[bnpl_rewards_tpro_cards]+ [rewards_bnpl_cards_not_tpro]&#10;+ [rewards_tpro_cards_not_bnpl]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro, Pay Later &amp; Rewards overlap only&apos; then [bnpl_rewards_tpro_cards]+  &#10;[bnpl_rewards_tpro_not_cards]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro, Pay Later &amp; Talabat Card overlap only&apos; then [bnpl_rewards_tpro_cards]+  &#10;[bnpl_tpro_cards_not_rewards]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Pay Later, Rewards &amp; Talabat Card overlap only&apos; then [bnpl_rewards_tpro_cards]+  &#10;[rewards_bnpl_cards_not_tpro]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro, Talabat Card &amp; Rewards overlap only&apos; then [bnpl_rewards_tpro_cards]+  &#10;[rewards_tpro_cards_not_bnpl]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Tpro&apos; then [tpro_active]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Pay Later&apos; then [bnpl_active]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Rewards&apos; then [rewards_active]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Talabat Card&apos; then [adcb_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Any Product&apos; then [any_of_them]&#10;&#10;&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Talabat Card&apos; then [bnpl_cards_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Rewards&apos; then [rewards_tpro_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Rewards&apos; then [bnpl_rewards_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Tpro&apos; then [bnpl_tpro_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Rewards &amp; Talabat Card&apos; then [cards_rewards_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Talabat Card&apos; then [cards_tpro_active]&#10;&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Postpaid &amp; Rewards&apos; then [bnpl_rewards_cards_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Postpaid &amp; Tpro&apos; then [bnpl_cards_tpro_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Tpro &amp; Rewards&apos; then [cards_tpro_rewards_active]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Postpaid &amp; Rewards&apos; then [bnpl_tpro_rewards_active]&#10;end' />
      </column>
