        <calculation class='tableau' formula='[Calculation_2849793419005747201]/[any_of_them]' />
      </column>
      <column caption='GMV' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Calculation_2849793419011981315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if /*[Products]=&apos;Tpro &amp; Pay Later overlap only&apos; then [tpro_bnpl_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]&#10;+[bnpl_rewards_tpro_not_cards_gmv]+&#10;[bnpl_tpro_cards_not_rewards_gmv]&#10;ELSEIF  [Products]=&apos;Tpro &amp; Rewards overlap only&apos; then [tpro_rewards_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]&#10;+[rewards_tpro_cards_not_bnpl_gmv]+&#10;[bnpl_rewards_tpro_not_cards_gmv]&#10;ELSEIF  [Products]=&apos;Tpro &amp; Talabat Card overlap only&apos; then [tpro_cards_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]+&#10;[bnpl_tpro_cards_not_rewards_gmv]+&#10;[rewards_tpro_cards_not_bnpl_gmv]&#10;ELSEIF  [Products]=&apos;Pay Later &amp; Rewards overlap only&apos; then [bnpl_rewards_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]&#10;+[bnpl_rewards_tpro_not_cards_gmv]&#10;+ [rewards_bnpl_cards_not_tpro_gmv]&#10;ELSEIF  [Products]=&apos;Pay Later &amp; Talabat Card overlap only&apos; then [cards_bnpl_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]&#10;+[bnpl_tpro_cards_not_rewards_gmv]&#10;+[rewards_bnpl_cards_not_tpro_gmv]&#10;ELSEIF  [Products]=&apos;Talabat Card &amp; Rewards overlap only&apos; then [cards_rewards_only_gmv]&#10;+[bnpl_rewards_tpro_cards_gmv]&#10;+[rewards_tpro_cards_not_bnpl_gmv]&#10;+[rewards_bnpl_cards_not_tpro_gmv]&#10;&#10;ELSEIF  [Products]=&apos;Tpro, Pay Later &amp; Rewards overlap only&apos; then [bnpl_rewards_tpro_cards_gmv]+  &#10;[bnpl_rewards_tpro_not_cards_gmv]&#10;ELSEIF  [Products]=&apos;Tpro, Pay Later &amp; Talabat Card overlap only&apos; then [bnpl_rewards_tpro_cards_gmv]+  &#10;[bnpl_tpro_cards_not_rewards_gmv]&#10;ELSEIF  [Products]=&apos;Pay Later, Rewards &amp; Talabat Card overlap only&apos; then [bnpl_rewards_tpro_cards_gmv]+  &#10;[rewards_bnpl_cards_not_tpro_gmv]&#10;ELSEIF  [Products]=&apos;Tpro, Talabat Card &amp; Rewards overlap only&apos; then [bnpl_rewards_tpro_cards_gmv]+  &#10;[rewards_tpro_cards_not_bnpl_gmv]&#10;ELSEIF &#10;In order to create these, we need to use the same flags as used in the below calculations, &#10;not the customer level ones&#10;*/ [Parameters].[Parameter 1]=&apos;Tpro&apos; then [tpro_users_gmv]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Pay Later&apos; then [bnpl_users_gmv]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Rewards&apos; then [rewards_users_gmv]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Talabat Card&apos; then [cards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Any Product&apos; then [all_products_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Talabat Card&apos; then [cards_bnpl_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Rewards&apos; then [tpro_rewards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Rewards&apos; then [bnpl_rewards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Postpaid &amp; Tpro&apos; then [bnpl_tpro_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Rewards &amp; Talabat Card&apos; then [cards_rewards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Talabat Card&apos; then [cards_tpro_users_gmv]&#10;&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Postpaid &amp; Rewards&apos; then [cards_bnpl_rewards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Postpaid &amp; Tpro&apos; then [cards_bnpl_tpro_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Talabat Card &amp; Tpro &amp; Rewards&apos; then [cards_tpro_rewards_users_gmv]&#10;elseif [Parameters].[Parameter 1]=&apos;Tpro &amp; Postpaid &amp; Rewards&apos; then [tpro_bnpl_rewards_users_gmv]&#10;&#10;&#10;&#10;end' />
      </column>
