union all
SELECT 
  month, 
  product_metric, 
  CAST(value AS NUMERIC) AS value
FROM (
     select * from 
              (SELECT 
                    month, 

                    bnpl_gmv/total_gmv bnpl_product_gmv,
                    rewards_used_gmv/total_gmv rewards_product_gmv,
                    paid_tpro_gmv/total_gmv tpro_gmv, 
                    tdine_gmv/total_gmv tdine_gmv, 
                    (total_gmv/2)/total_gmv mv_gmv, 
                    darkstore_gmv/total_gmv darkstore_gmv, 
                    cast(cashback_used_amount+co_branded_card_talabat_gmv_spend as numeric)/total_gmv card_gmv, 

                    bnpl_users_gmv/total_gmv bnpl_customer_gmv,
                    rewards_users_gmv/total_gmv rewards_customer_gmv,
                    tpro_users_gmv/total_gmv tpro_customer_gmv, 
                    tdine_users_gmv/total_gmv tdine_customer_gmv, 
                    (total_gmv/2)/total_gmv mv_customer_gmv, 
                    darkstore_users_gmv/total_gmv darkstore_customer_gmv, 
                    cards_users_gmv/total_gmv card_customer_gmv, 




            FROM 
-- tlb-data-dev.data_playground_fintech.cat_dashboard_new )
tlb-data-dev.data_platform.temp_old)
)
UNPIVOT (
  value FOR product_metric IN (
                    bnpl_product_gmv,
                    rewards_product_gmv,
                    tpro_gmv, 
                    tdine_gmv, 
                    mv_gmv, 
                    darkstore_gmv, 
                    card_gmv, 

                    bnpl_customer_gmv,
                    rewards_customer_gmv,
                    tpro_customer_gmv, 
                    tdine_customer_gmv, 
                    mv_customer_gmv, 
                    darkstore_customer_gmv, 
                    card_customer_gmv


  )
)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
