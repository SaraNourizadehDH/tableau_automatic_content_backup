            </column>
            <column caption='Product Tag' datatype='string' name='[Calculation_3689151821742010368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if&#10;            CONTAINS([product_metric], &apos;bnpl&apos;) &#10;            and not CONTAINS([product_metric], &apos;not_bnpl&apos;)  and [Parameters].[Parameter 2]&#10;                then &apos;PostPaid |&apos; else &apos;&apos; END&#10;+&#10;            if&#10;            (CONTAINS([product_metric], &apos;card&apos;) or CONTAINS([product_metric], &apos;adcb&apos;))&#10;            and not CONTAINS([product_metric], &apos;not_card&apos;)  and [Parameters].[Include PostPaid (copy) (copy)_1304706925972484108]&#10;                then &apos; Cards |&apos; else &apos;&apos; END&#10;+&#10;            if&#10;            CONTAINS([product_metric], &apos;rewards&apos;) &#10;            and not CONTAINS([product_metric], &apos;not_rewards&apos;)  and [Parameters].[Second Product Selection  (copy)_4753619815181987874]&#10;                then &apos; Rewards |&apos; else &apos;&apos; END&#10;+&#10;            if&#10;            CONTAINS([product_metric], &apos;tpro&apos;) &#10;            and not CONTAINS([product_metric], &apos;not_tpro&apos;)  and [Parameters].[One Product Selection (copy)_4753619815179612188]&#10;                then &apos; tPro |&apos; else &apos;&apos; END&#10;&#10;+&#10;            if&#10;            (CONTAINS([product_metric], &apos;_mv&apos;) or CONTAINS([product_metric], &apos;mv_&apos;) )&#10;            and not CONTAINS([product_metric], &apos;not_mv&apos;)   and [Parameters].[Include PostPaid (copy) (copy) (copy)_1304706925972488205]&#10;                then &apos; Multi-Vertical |&apos; else &apos;&apos; END&#10;+&#10;            if&#10;            CONTAINS([product_metric], &apos;darkstore&apos;) &#10;            and not CONTAINS([product_metric], &apos;not_darkstore&apos;) and [Parameters].[Include PostPaid (copy)_1304706925972475915]&#10;                then &apos; tMart |&apos; else &apos;&apos; END&#10;&#10;+&#10;            if&#10;            CONTAINS([product_metric], &apos;tdine&apos;) &#10;            and not CONTAINS([product_metric], &apos;not_tdine&apos;)  and [Parameters].[Include PostPaid (copy) (copy) (copy) (copy)_1304706925972504590]&#10;                then &apos; tDine |&apos; else &apos;&apos; END' />
