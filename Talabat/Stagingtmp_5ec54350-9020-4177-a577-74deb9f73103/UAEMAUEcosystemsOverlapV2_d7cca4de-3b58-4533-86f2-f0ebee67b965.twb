            <column datatype='real' name='[tpro_users_gmv]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0u9pe731el2wdt1btz5be047p028].[sum:tpro_users_gmv:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Rewards user:</run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'> A platform active user who has redeemed his rewards points on partners, charity or redeem to wallet AND earned rewards points</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Tpro user: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>A platform active user who is in &quot;paid&quot;, &quot;grace period&quot; tpro in the last day of the month </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>ADCB user: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>A platform active user who is a card holder in this month </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Pay Later user: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>A platform active user who placed a Pay Later order</run>
                <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Rewards user GMV:</run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'> All month platform GMV for the rewards user described above </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Tpro user GMV: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>All month platform GMV for the tpro user described above </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>ADCB user GMV: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>All month platform GMV for the ADCB user described above </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Pay Later user GMV: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>All month platform GMV for the pay later user described above</run>
                <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Rewards product GMV:</run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'> GMV from an order on which a rewards voucher is applied </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Tpro product GMV:</run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'> GMV from a tpro order from the days when the user was in &quot;paid&quot;, &quot;grace period&quot; tpro </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>ADCB product GMV: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>GMV from an order paid by the ADCB card (including apple pay) or ADCB cashback </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#1d1c1d' fontsize='11'>Pay Later product GMV:</run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='11'> GMV from a pay later order</run>
              </formatted-text>
            </customized-label>
            <style>
