              <calculation class='tableau' formula='if [Parameters].[Parameter 2]  then &#10;        (CONTAINS([product_metric], &apos;postpaid&apos;) or CONTAINS([product_metric], &apos;bnpl&apos;)) and not CONTAINS([product_metric], &apos;not_postpaid&apos;) else false end &#10;or&#10;if [Parameters].[One Product Selection (copy)_4753619815179612188]  then &#10;        CONTAINS([product_metric], &apos;tpro&apos;) and not CONTAINS([product_metric], &apos;not_tpro&apos;) else false end &#10;or&#10;&#10;if [Parameters].[Second Product Selection  (copy)_4753619815181987874] then &#10;        CONTAINS([product_metric], &apos;rewards&apos;) and not CONTAINS([product_metric], &apos;not_rewards&apos;) else false end&#10;&#10;or&#10;&#10;if [Parameters].[Include PostPaid (copy)_1304706925972475915] then &#10;        CONTAINS([product_metric], &apos;darkstore&apos;) and not CONTAINS([product_metric], &apos;not_darkstore&apos;) else false end&#10;or&#10;&#10;if [Parameters].[Include PostPaid (copy) (copy)_1304706925972484108] then &#10;        (CONTAINS([product_metric], &apos;card&apos;) or CONTAINS([product_metric], &apos;adcb&apos;) )and not CONTAINS([product_metric], &apos;not_cards&apos;) else false end&#10;or&#10;&#10;if [Parameters].[Include PostPaid (copy) (copy) (copy)_1304706925972488205] then &#10;        CONTAINS([product_metric], &apos;mv&apos;) and not CONTAINS([product_metric], &apos;not_mv&apos;) else false end&#10;or&#10;&#10;if [Parameters].[Include PostPaid (copy) (copy) (copy) (copy)_1304706925972504590] then &#10;        CONTAINS([product_metric], &apos;tdine&apos;) and not CONTAINS([product_metric], &apos;not_tdine&apos;) else false end' />
