          </datasources>
          <datasource-dependencies datasource='federated.03x7vba1glvz5g1bhppdb0onglmb'>
            <column caption='PostPaid Product GMV %' datatype='real' name='[Calculation_4753619815025102854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[bnpl_gmv]/[total_gmv]' />
            </column>
            <column caption='Talabat Card Product GMV %' datatype='real' name='[Calculation_4753619815026556938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([cashback_used_amount]+[co_branded_card_talabat_gmv_spend])/[total_gmv]' />
            </column>
            <column caption='tPro Product GMV % ' datatype='real' name='[Calculation_4753619815030747150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[paid_tpro_gmv]/[total_gmv]' />
            </column>
            <column caption='tDine product GMV %' datatype='real' name='[Calculation_4753619815031861265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tdine_gmv]/[total_gmv]' />
            </column>
            <column caption='tMart product GMV %' datatype='real' name='[Calculation_4753619815032410132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstore_gmv]/[total_gmv]' />
            </column>
            <column caption='Rewards product GMV % ' datatype='real' name='[Calculation_4753619815032852503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[rewards_used_gmv]/[total_gmv]' />
            </column>
            <column caption='tPro only GMV %' datatype='real' name='[Calculation_4753619815272349748]' role='measure' type='quantitative'>
