      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='orders' id='orders_51EA34181AE442369AC0C0BE0D409A05'>
            <properties context=''>
              <relation connection='bigquery.1xlp6kc0jqqb6z17woq100ncczsk' name='Custom SQL Query' type='text'>SELECT 
  -- Date and key dimensions
  DATE(orders.placed_at_local) AS order_date,
  orders.country_code,
  orders.currency_code,
  orders.vertical_type,
  orders.vertical_parent,
  orders.business_type,
  
  -- Campaign and voucher details
  COALESCE(vouchers.campaign_name, &apos;NA&apos;) AS campaign_name,
  COALESCE(vouchers.voucher_code, &apos;NA&apos;) AS voucher_code,
  
  -- Order counts
  COUNT(DISTINCT orders.order_id) AS total_orders,
  COUNT(DISTINCT CASE WHEN orders.is_discount = true THEN orders.order_id END) AS orders_with_discount,
  COUNT(DISTINCT CASE WHEN orders.is_voucher = true THEN orders.order_id END) AS orders_with_voucher,
  
  -- Discount metrics (EUR) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_dh_eur AS NUMERIC)), 0), 2) AS total_discount_dh_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_other_eur AS NUMERIC)), 0), 2) AS total_discount_other_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_total_eur AS NUMERIC)), 0), 2) AS total_discount_total_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.joker_customer_discount_eur AS NUMERIC)), 0), 2) AS total_joker_customer_discount_eur,
  
  -- Discount metrics (Local Currency) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_dh_local AS NUMERIC)), 0), 2) AS total_discount_dh_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_other_local AS NUMERIC)), 0), 2) AS total_discount_other_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.discount_total_local AS NUMERIC)), 0), 2) AS total_discount_total_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.joker_customer_discount_local AS NUMERIC)), 0), 2) AS total_joker_customer_discount_local,
  
  -- Voucher metrics (EUR) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_dh_eur AS NUMERIC)), 0), 2) AS total_voucher_dh_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_other_eur AS NUMERIC)), 0), 2) AS total_voucher_other_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_total_eur AS NUMERIC)), 0), 2) AS total_voucher_total_eur,
  
  -- Voucher metrics (Local Currency) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_dh_local AS NUMERIC)), 0), 2) AS total_voucher_dh_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_other_local AS NUMERIC)), 0), 2) AS total_voucher_other_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.voucher_total_local AS NUMERIC)), 0), 2) AS total_voucher_total_local,
  
  -- Voucher details aggregation - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(vouchers.amount_eur AS NUMERIC)), 0), 2) AS total_voucher_amount_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(vouchers.amount_local AS NUMERIC)), 0), 2) AS total_voucher_amount_local,
  ROUND(COALESCE(SUM(SAFE_CAST(vouchers.voucher_dh_eur AS NUMERIC)), 0), 2) AS total_voucher_detail_dh_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(vouchers.voucher_dh_local AS NUMERIC)), 0), 2) AS total_voucher_detail_dh_local,
  
  -- Other incentive metrics (EUR) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.corporate_allowance_eur AS NUMERIC)), 0), 2) AS total_corporate_allowance_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.wallet_total_eur AS NUMERIC)), 0), 2) AS total_wallet_total_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.total_incentives_eur AS NUMERIC)), 0), 2) AS total_incentives_eur,
  
  -- Other incentive metrics (Local Currency) - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.corporate_allowance_local AS NUMERIC)), 0), 2) AS total_corporate_allowance_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.wallet_total_local AS NUMERIC)), 0), 2) AS total_wallet_total_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.incentives.total_incentives_local AS NUMERIC)), 0), 2) AS total_incentives_local,
  
  -- Subscription incentives - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(subscriptions.amount_after_incentives_gross AS NUMERIC)), 0), 2) AS total_subscription_after_incentives,
  ROUND(COALESCE(SUM(SAFE_CAST(subscriptions.wallet_amount AS NUMERIC)), 0), 2) AS total_subscription_wallet_amount,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.addons.wallet_amount AS NUMERIC)), 0), 2) AS total_addons_wallet_amount,
  COUNT(DISTINCT subscriptions.subscription_id) AS unique_subscriptions_with_incentives,
  
  -- Order value context for incentive rates - rounded to 2 decimal places
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.order.gmv_eur AS NUMERIC)), 0), 2) AS total_gmv_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.order.gmv_local AS NUMERIC)), 0), 2) AS total_gmv_local,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.order.total_order_value_eur AS NUMERIC)), 0), 2) AS total_order_value_eur,
  ROUND(COALESCE(SUM(SAFE_CAST(orders.value.order.total_order_value_local AS NUMERIC)), 0), 2) AS total_order_value_local,
  
  -- Calculated incentive rates - rounded to 2 decimal places
  ROUND(COALESCE(
    SAFE_DIVIDE(
      SUM(SAFE_CAST(orders.value.incentives.total_incentives_eur AS NUMERIC)),
      SUM(SAFE_CAST(orders.value.order.gmv_eur AS NUMERIC))
    ) * 100, 0
  ), 2) AS incentive_rate_on_gmv_percent,
  
  ROUND(COALESCE(
    SAFE_DIVIDE(
      SUM(SAFE_CAST(orders.value.incentives.discount_total_eur AS NUMERIC)),
      SUM(SAFE_CAST(orders.value.order.gmv_eur AS NUMERIC))
    ) * 100, 0
  ), 2) AS discount_rate_on_gmv_percent,
  
  ROUND(COALESCE(
    SAFE_DIVIDE(
      SUM(SAFE_CAST(orders.value.incentives.voucher_total_eur AS NUMERIC)),
      SUM(SAFE_CAST(orders.value.order.gmv_eur AS NUMERIC))
    ) * 100, 0
  ), 2) AS voucher_rate_on_gmv_percent,
  
  -- Average incentive per order - rounded to 2 decimal places
  ROUND(COALESCE(
    SAFE_DIVIDE(
      SUM(SAFE_CAST(orders.value.incentives.total_incentives_eur AS NUMERIC)),
      COUNT(DISTINCT orders.order_id)
    ), 0
  ), 2) AS avg_incentive_per_order_eur,
  
  ROUND(COALESCE(
    SAFE_DIVIDE(
      SUM(SAFE_CAST(orders.value.incentives.voucher_total_eur AS NUMERIC)),
      COUNT(DISTINCT CASE WHEN vouchers.voucher_code IS NOT NULL THEN orders.order_id END)
    ), 0
  ), 2) AS avg_voucher_amount_per_voucher_order_eur

FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  LEFT JOIN UNNEST(orders.addons.subscriptions) AS subscriptions
  LEFT JOIN UNNEST(orders.vouchers) AS vouchers

WHERE 
  -- Filter for India entities
  orders.global_entity_id LIKE &apos;IN%&apos;
  
  -- Filter for last 6 months
  AND SAFE_CAST(orders.partition_date_local AS DATE) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
  
  -- Only successful orders
  AND orders.is_successful = true

GROUP BY 
  DATE(orders.placed_at_local),
  orders.country_code,
  orders.currency_code,
  orders.vertical_type,
  orders.vertical_parent,
  orders.business_type,
  COALESCE(vouchers.campaign_name, &apos;NA&apos;),
  COALESCE(vouchers.voucher_code, &apos;NA&apos;)

ORDER BY 
  order_date DESC,
  campaign_name,
  voucher_code,
  total_incentives_eur DESC</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
