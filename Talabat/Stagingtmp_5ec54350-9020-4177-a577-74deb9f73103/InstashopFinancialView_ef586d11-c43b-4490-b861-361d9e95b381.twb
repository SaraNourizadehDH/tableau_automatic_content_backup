            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_coredata_business' server-oauth='' username='sghosh@talabat.com' workgroup-auth-mode='prompt' />
