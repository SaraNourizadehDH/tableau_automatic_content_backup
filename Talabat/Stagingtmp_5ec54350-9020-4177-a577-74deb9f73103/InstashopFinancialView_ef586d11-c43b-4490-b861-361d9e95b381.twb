        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[global_entity_id]' member='&quot;IN_AE&quot;' />
          <groupfilter function='member' level='[global_entity_id]' member='&quot;IN_EG&quot;' />
