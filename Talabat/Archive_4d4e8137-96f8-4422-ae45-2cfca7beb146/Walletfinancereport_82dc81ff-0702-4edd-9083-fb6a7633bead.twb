          <named-connection caption='BigQuery' name='bigquery.0z0t4u319ipgya1ahr4p20urapgw'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='nikhil.krishna@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0z0t4u319ipgya1ahr4p20urapgw' name='Custom SQL Query' type='text'><![CDATA[(
      with movement as (
            select country,
                  date,
                  wallet_bucket_name,
                  Reversal,
                  case
                        when wallet_bucket_name in (
                              'ADCB touchpoints redemption',
                              'Cobranded Card Gift'
                        )
                        and action_type = 'Earn' then 'Credit'
                        when action_type = 'Burn-Deactivation' then 'Burn-Deactivation'
                        else burn_type
                  end as burn_type,
                  campaign_name,
                  wallet_bucket_id,
                  action_type,
                  SUM(detail_amount_eur) as movement_amount_eur,
                  SUM(detail_amount_lc) as movement_amount_lc,
                  max(dwh_entry_timestamp) as last_refresh
            from (
                        select fwtd.created_time_lc,
                              fwtd.date,
                              case
                                    when fwtd.transaction_type_id = 23 then 'Burn-Deactivation'
                                    else fwtd.action_type
                              end as action_type,
                              dci.country,
                              coalesce(dwb.wallet_bucket_name, 'No Bucket') wallet_bucket_name,
                              case when fwtd.transaction_type_id = 24 then 'Auto PSP Revert'
                              else dwtt.burn_type end as burn_type,
                              fwtd.detail_amount_eur,
                              fwtd.detail_amount_lc,
                              fwtd.wallet_bucket_id,
                              case
                                    when fwtd.is_reversal then 'Reversal'
                                    else 'Non Reversal'
                              end as Reversal,
                              /*case when dwb.wallet_bucket_name in ('Gift-NonEmployee','Gift-Employee','Marketing Credit') then fwtd.campaign_name else '' end as*/
                              fwtd.campaign_name,
                              fwtd.dwh_entry_timestamp
                        from `tlb-data-prod.data_platform.fct_wallet_transaction_details` fwtd
                              left join `tlb-data-prod.data_platform.dim_country_info` dci on (fwtd.country_id = dci.country_id)
                              left join `tlb-data-prod.data_platform.dim_wallet_bucket` dwb on (fwtd.wallet_bucket_id = dwb.wallet_bucket_id)
                              /*there will be null bucket for example in jordan on 06,07,2021 transaction 43616226
                               because it is earn but wrong transaction_type*/
                              left join `tlb-data-prod.data_platform.dim_wallet_transaction_type` dwtt on fwtd.transaction_type_id = dwtt.transaction_type_id
                        where (
                                    fwtd.wallet_bucket_id <<>> 0
                                    /*earn transactions with type 0 source data issue*/
                                    or fwtd.date >> '2021-09-02'
                              )
                  )
            group by all
      )
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_eur as movement_amount,
            'EUR' as currency,
            last_refresh
      from movement
      union all
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_lc as movement_amount,
            'LC' as currency,
            last_refresh
      from movement
)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0z0t4u319ipgya1ahr4p20urapgw' name='Custom SQL Query' type='text'><![CDATA[(
      with movement as (
            select country,
                  date,
                  wallet_bucket_name,
                  Reversal,
                  case
                        when wallet_bucket_name in (
                              'ADCB touchpoints redemption',
                              'Cobranded Card Gift'
                        )
                        and action_type = 'Earn' then 'Credit'
                        when action_type = 'Burn-Deactivation' then 'Burn-Deactivation'
                        else burn_type
                  end as burn_type,
                  campaign_name,
                  wallet_bucket_id,
                  action_type,
                  SUM(detail_amount_eur) as movement_amount_eur,
                  SUM(detail_amount_lc) as movement_amount_lc,
                  max(dwh_entry_timestamp) as last_refresh
            from (
                        select fwtd.created_time_lc,
                              fwtd.date,
                              case
                                    when fwtd.transaction_type_id = 23 then 'Burn-Deactivation'
                                    else fwtd.action_type
                              end as action_type,
                              dci.country,
                              coalesce(dwb.wallet_bucket_name, 'No Bucket') wallet_bucket_name,
                              case when fwtd.transaction_type_id = 24 then 'Auto PSP Revert'
                              else dwtt.burn_type end as burn_type,
                              fwtd.detail_amount_eur,
                              fwtd.detail_amount_lc,
                              fwtd.wallet_bucket_id,
                              case
                                    when fwtd.is_reversal then 'Reversal'
                                    else 'Non Reversal'
                              end as Reversal,
                              /*case when dwb.wallet_bucket_name in ('Gift-NonEmployee','Gift-Employee','Marketing Credit') then fwtd.campaign_name else '' end as*/
                              fwtd.campaign_name,
                              fwtd.dwh_entry_timestamp
                        from `tlb-data-prod.data_platform.fct_wallet_transaction_details` fwtd
                              left join `tlb-data-prod.data_platform.dim_country_info` dci on (fwtd.country_id = dci.country_id)
                              left join `tlb-data-prod.data_platform.dim_wallet_bucket` dwb on (fwtd.wallet_bucket_id = dwb.wallet_bucket_id)
                              /*there will be null bucket for example in jordan on 06,07,2021 transaction 43616226
                               because it is earn but wrong transaction_type*/
                              left join `tlb-data-prod.data_platform.dim_wallet_transaction_type` dwtt on fwtd.transaction_type_id = dwtt.transaction_type_id
                        where (
                                    fwtd.wallet_bucket_id <<>> 0
                                    /*earn transactions with type 0 source data issue*/
                                    or fwtd.date >> '2021-09-02'
                              )
                  )
            group by all
      )
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_eur as movement_amount,
            'EUR' as currency,
            last_refresh
      from movement
      union all
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_lc as movement_amount,
            'LC' as currency,
            last_refresh
      from movement
)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
