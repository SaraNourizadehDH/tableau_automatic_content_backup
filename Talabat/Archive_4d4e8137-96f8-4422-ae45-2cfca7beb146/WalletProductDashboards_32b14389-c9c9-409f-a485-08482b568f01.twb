      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Payment method daily' id='_9F6B1EA641E74BE282F691F628C61AFB'>
            <properties context=''>
              <relation connection='bigquery.1m7e6r70pm69jj1djujqa182gokk' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;),
counts as 
(
SELECT  
a.order_date ,
c.country, 
count(*) as total_count, 
sum(case when payment_method=&apos;Cash&apos; then 1 else 0 end ) as cash_count, 
sum(case when payment_method=&apos;Credit Card&apos; then 1 else 0 end ) as credit_card_count, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then 1 else 0 end ) as wallet_mixed_payment_count, 
sum(case when payment_method=&apos;talabat Pay&apos; then 1 else 0 end ) as wallet_count, 
sum(case when payment_method=&apos;Debit Card&apos; then 1 else 0 end ) as debit_card_count, 
sum(a.gmv_amount_lc) as total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as total_gmv_amount_eur, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_lc else 0 end ) as cash_gmv_lc, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_lc else 0 end ) as credit_card_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_lc else 0 end ) as wallet_mixed_payment_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_lc else 0 end ) as wallet_gmv_lc, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_lc else 0 end ) as debit_card_gmv_lc, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_eur else 0 end ) as cash_gmv_eur, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_eur else 0 end ) as credit_card_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_eur else 0 end ) as wallet_mixed_payment_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_eur else 0 end ) as wallet_gmv_eur, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_eur else 0 end ) as debit_card_gmv_eur 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
group by 1 ,2)
select 
 order_date,
country, 
total_count, 
