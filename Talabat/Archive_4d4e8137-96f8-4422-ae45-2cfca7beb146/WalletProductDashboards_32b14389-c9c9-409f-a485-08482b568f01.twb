(
select o.order_date, 
o.country_id, 
c.country, 
date_trunc(o.order_date, MONTH) as order_month, 
o.gmv_amount_eur, 
o.gmv_amount_lc, 
o.order_id, 
o.account_id, 
case when w.account_id is null then 'Non wallet user'
when date_trunc(o.order_date, MONTH)>>=w.first_wallet_usage_month then 'Wallet user'
when date_trunc(o.order_date, MONTH)<<w.first_wallet_usage_month then 'Non wallet user'
end as wallet_user_type , 
case when w.account_id is null then 'Non wallet user'
when date_trunc(o.order_date, MONTH)>>w.first_wallet_usage_month then 'Old wallet user'
when date_trunc(o.order_date, MONTH)=w.first_wallet_usage_month then 'New wallet user'
when date_trunc(o.order_date, MONTH)<<w.first_wallet_usage_month then 'Non wallet user'
end as wallet_user_detailed_type
from `tlb-data-prod.data_platform.fct_order_info` o 
join `tlb-data-prod.data_platform.dim_order_status` st on (o.order_status_id=st.order_status_id)
join tlb-data-prod.data_platform.dim_payment_method pm on (o.payment_method_id=pm.payment_method_id)
join tlb-data-prod.data_platform.dim_country_info c on (c.country_id=o.country_id)
left join customer_first_wallet_usage_month w on o.account_id=w.account_id and o.country_id=w.country_id
where st.status='SUCCESS'
and o.is_test=false
and o.order_date>>='2021-01-01'
)
select order_month, 
country, 
--wallet_user_type, 
wallet_user_detailed_type,
round(count(distinct order_id) / count(distinct account_id),2) average_order_frequency,
sum(gmv_amount_eur)/ count(distinct order_id) aov_eur, 
sum(gmv_amount_lc)/ count(distinct order_id) aov_lc
from raw
group by 1,2,3
union all 
select order_month, 
country, 
--wallet_user_type, 
wallet_user_type as wallet_user_detailed_type,
round(count(distinct order_id) / count(distinct account_id),2) average_order_frequency,
sum(gmv_amount_eur)/ count(distinct order_id) aov_eur, 
sum(gmv_amount_lc)/ count(distinct order_id) aov_lc
from raw
where wallet_user_type='Wallet user'
group by 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
