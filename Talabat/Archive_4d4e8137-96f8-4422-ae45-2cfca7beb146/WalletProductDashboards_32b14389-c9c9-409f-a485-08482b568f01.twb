              <relation connection='bigquery.162ams00a5m25t12x9vnr08kqgnx' name='Custom SQL Query' type='text'>(with counts as 
(select order_date, 
case when a.payment_method_id=60 then &apos;talabat Pay,Card&apos; else 
payment_method
end as payment_method,
country.country, 
count(*) total_orders, 
sum(case when is_incomplete_online_payment=false then 1 else 0 end ) as total_successful_orders
from `tlb-data-prod.data_platform.fct_order_info` a 
inner join `tlb-data-prod.data_platform.dim_order_status` b on (a.order_status_id=b.order_status_id)
left join `tlb-data-prod.data_platform.dim_payment_method` c on (a.payment_method_id=c.payment_method_id)
left join `tlb-data-prod.data_platform.dim_country_info` country on (a.country_id=country.country_id)
where b.is_test=false 
and b.is_canceled_by_fraud_shield=false
group by 1,2,3)
select 
order_date,
payment_method,
country,
total_successful_orders,
total_orders 
from counts )
union all 
(with counts as 
(select order_date, 
&apos;All payment methods&apos; as payment_method,
country.country, 
count(*) total_orders, 
sum(case when is_incomplete_online_payment=false then 1 else 0 end ) as total_successful_orders
from `tlb-data-prod.data_platform.fct_order_info` a 
inner join `tlb-data-prod.data_platform.dim_order_status` b on (a.order_status_id=b.order_status_id)
left join `tlb-data-prod.data_platform.dim_country_info` country on (a.country_id=country.country_id)
where b.is_test=false 
and b.is_canceled_by_fraud_shield=false
group by 1,2,3)
select 
order_date,
payment_method,
country,
total_successful_orders,
total_orders
from counts )</relation>
