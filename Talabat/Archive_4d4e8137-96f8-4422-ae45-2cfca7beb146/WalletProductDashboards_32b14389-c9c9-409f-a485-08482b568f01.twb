    <datasource caption='Checkout conversion rate' inline='true' name='federated.1l41s7015gnt101gjhzu31ygmfy6' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1h3jmls0asd1hc1d16cb2098vct8'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1h3jmls0asd1hc1d16cb2098vct8' name='Custom SQL Query' type='text'><![CDATA[with raw as 
(select a.date,
sub_session_id, 
c.started_checkout,
a.attempted_place_order,
c.account_id, 
a.sub_session_start_time,
b.transaction_id as wallet_transaction_id, 
b.customer_balance_after_lc as wallet_balance_at_checkout, 
row_number() OVER (PARTITION BY b.account_id, a.sub_session_id ORDER BY created_time_utc desc) as row_number 
from `tlb-data-prod.data_platform.fct_sub_session_checkout` a
left join `tlb-data-prod.data_platform.fct_session` c on (a.session_id=c.session_id)
left join `tlb-data-prod.data_platform.fct_wallet_transaction` b on (c.account_id=b.account_id 
and timestamp(b.created_time_utc)<<a.sub_session_start_time) 
where a.date>>=date_sub(current_date(), INTERVAL 1 MONTH)
and c.date>>=date_sub(current_date(), INTERVAL 1 MONTH)
and a.date=c.date),
counts as (
select date,
case when wallet_balance_at_checkout>>0 then 'Has wallet balance' else 'Zero wallet balance' end as has_wallet_balance,
sum (case when started_checkout then 1 else 0 end ) as number_checkout_visits ,
sum (case when attempted_place_order then 1 else 0 end ) as number_of_place_order_attempts
from raw 
where row_number=1
group by 1,2) 
select date , 
has_wallet_balance, 
number_of_place_order_attempts/number_checkout_visits checkout_conversion_percentage
from counts
union all
select date, 
'Both', 
sum(number_of_place_order_attempts)/sum(number_checkout_visits) checkout_conversion_percentage
from counts 
group by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
