    <dashboard name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/wallet_vertical_breakup/Glossary?rev=' id='Glossary' path='/t/Talabat/workbooks/wallet_vertical_breakup' revision='' site='Talabat' />
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97668' id='3' type-v2='text' w='98650' x='675' y='1166'>
            <formatted-text>
              <run bold='true' fontsize='12'>Wallet Topup Funnel</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet_viewed_percentage</run>
              <run fontsize='10'>= number of sessions where talabat Pay page is viewed/  number of all session </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet_topup_clicked_percentage</run>
              <run fontsize='10'>= number of sessions where top up link is clicked in talbat Pay dashboard/   number of sessions where talabat Pay page is viewed</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet_topup_card_chosen_percentage</run>
              <run fontsize='10'>= number of sessions where card is chosen after top up link is clicked in talbat Pay dashboard/   number of sessions where top up link is clicked in talbat Pay dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet_topup_attempted_percentage</run>
              <run fontsize='10'>= number of sessions where &quot;Top up&quot; button is clicked (in the page where the user can enter the amount)/   number of sessions where card is chosen after top up link is clicked in talbat Pay dashboard </run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='10'>Before 24,10,2022 card choosing was not tracked , </run>
              <run>Æ&#10;</run>
              <run fontsize='10'>and before the card choosing tracking reached full adoption approximately on 06,11,2022  it was: </run>
              <run>Æ&#10;</run>
              <run fontsize='10'> number of sessions where &quot;Top up&quot; button is clicked (in the page where the user can enter the amount)/ number of sessions where top up link is clicked in talbat Pay dashboard</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet_topup_suceeded_percentage</run>
              <run fontsize='10'>= number of sessions where topup is successful after &quot;Top up&quot; button is clicked/  number of sessions where &quot;Top up&quot; button is clicked (in the page where the user can enter the amount)</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='12'>Wallet users AOV AOF</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>wallet user</run>
              <run fontsize='10'>= A user is considered a wallet user since the month when he made a wallet pure/mixed payment order, or wallet rider tip, or wallet/mixed payment BNPL adhoc payment in a certain country.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>new wallet user</run>
              <run fontsize='10'>= A user is considered a new wallet user in a certain country in the first month when he made a wallet pure/mixed payment  order, or wallet rider tip, or wallet/mixed payment BNPL adhoc payment.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>old wallet user</run>
              <run fontsize='10'>= A user is considered an old wallet user in a certain country in the next subsequent  month after the first month when he made his first  wallet pure/mixed payment order, or wallet rider tip, or wallet/mixed payment BNPL adhoc payment.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>non wallet user</run>
              <run fontsize='10'>= A user is considered a non wallet user in a certain country if he never made a wallet pure/mixed payment order, nor wallet rider tip, nor wallet/mixed payment BNPL adhoc payment in this country.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='228' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97668' id='227' param='vert' type-v2='layout-flow' w='98650' x='675' y='1166'>
                <zone forceUpdate='true' h='97668' id='3' type-v2='text' w='98650' x='675' y='1166'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Wallet Topup Funnel</run>
                    <run>Æ&#10;&#10;</run>
