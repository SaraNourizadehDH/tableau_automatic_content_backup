    <worksheet name='Payment Success Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Payment Success Rate &#10;&#10;</run>
            <run fontsize='9'>This dashboard shows the payment success rate for orders after place order button is clicked and an order is created in the backend (this dashboard does not cover the place order attempt - when a customer clicks on place order button but order creation is failed). This dashboard is based on backend data. It is excluding test and fraud orders.</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Payment Success Rate' name='federated.1dhnwnc0otot3s10o326v17ayxwa' />
          </datasources>
          <datasource-dependencies datasource='federated.1dhnwnc0otot3s10o326v17ayxwa'>
            <column caption='Payment Successs Rate' datatype='real' default-format='p0.00%' name='[Calculation_931822919067574272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_successful_orders])/sum([total_orders])' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[payment_method]' derivation='None' name='[none:payment_method:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[payment_method]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='Day-Trunc' name='[tdy:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_931822919067574272]' derivation='User' name='[usr:Calculation_931822919067574272:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dhnwnc0otot3s10o326v17ayxwa].[none:country:nk]'>
            <groupfilter function='member' level='[none:country:nk]' member='&quot;United Arab Emirates&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
