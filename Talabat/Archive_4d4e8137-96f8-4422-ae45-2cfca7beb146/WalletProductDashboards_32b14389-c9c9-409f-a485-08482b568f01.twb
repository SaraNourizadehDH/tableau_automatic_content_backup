    <datasource caption='Payment Method Daily' inline='true' name='federated.0btpa4e1jouszs1078f7d03vg64g' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1m7e6r70pm69jj1djujqa182gokk'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='api-project-702632992366' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1m7e6r70pm69jj1djujqa182gokk' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;),
counts as 
(
SELECT  
a.order_date ,
c.country, 
count(*) as total_count, 
sum(case when payment_method=&apos;Cash&apos; then 1 else 0 end ) as cash_count, 
sum(case when payment_method=&apos;Credit Card&apos; then 1 else 0 end ) as credit_card_count, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then 1 else 0 end ) as wallet_mixed_payment_count, 
sum(case when payment_method=&apos;talabat Pay&apos; then 1 else 0 end ) as wallet_count, 
sum(case when payment_method=&apos;Debit Card&apos; then 1 else 0 end ) as debit_card_count, 
sum(a.gmv_amount_lc) as total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as total_gmv_amount_eur, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_lc else 0 end ) as cash_gmv_lc, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_lc else 0 end ) as credit_card_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_lc else 0 end ) as wallet_mixed_payment_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_lc else 0 end ) as wallet_gmv_lc, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_lc else 0 end ) as debit_card_gmv_lc, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_eur else 0 end ) as cash_gmv_eur, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_eur else 0 end ) as credit_card_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_eur else 0 end ) as wallet_mixed_payment_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_eur else 0 end ) as wallet_gmv_eur, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_eur else 0 end ) as debit_card_gmv_eur 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
group by 1 ,2)
select 
 order_date,
country, 
total_count, 
cash_count, 
credit_card_count, 
wallet_mixed_payment_count, 
wallet_count, 
debit_card_count, 
cash_count/total_count  cash_order_count_percentage, 
credit_card_count/total_count credit_card_order_count_percentage, 
wallet_mixed_payment_count/total_count wallet_mixed_payment_order_count_percentage, 
wallet_count/total_count wallet_order_count_percentage, 
(wallet_mixed_payment_count+wallet_count)/total_count total_wallet_order_count_percentage, 
debit_card_count/total_count debit_card_order_count_percentage, 
wallet_mixed_payment_gmv_eur/total_gmv_amount_eur wallet_mixed_payment_gmv_percentage,
wallet_gmv_eur/total_gmv_amount_eur wallet_gmv_percentage,
(wallet_mixed_payment_gmv_eur+wallet_gmv_eur)/total_gmv_amount_eur total_wallet_gmv_percentage,
total_gmv_amount_lc, 
total_gmv_amount_eur, 
cash_gmv_lc, 
credit_card_gmv_lc, 
wallet_mixed_payment_gmv_lc, 
wallet_gmv_lc, 
debit_card_gmv_lc, 
cash_gmv_eur, 
credit_card_gmv_eur, 
wallet_mixed_payment_gmv_eur, 
wallet_gmv_eur, 
debit_card_gmv_eur 
from counts</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1m7e6r70pm69jj1djujqa182gokk' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;),
counts as 
(
SELECT  
a.order_date ,
c.country, 
count(*) as total_count, 
sum(case when payment_method=&apos;Cash&apos; then 1 else 0 end ) as cash_count, 
sum(case when payment_method=&apos;Credit Card&apos; then 1 else 0 end ) as credit_card_count, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then 1 else 0 end ) as wallet_mixed_payment_count, 
sum(case when payment_method=&apos;talabat Pay&apos; then 1 else 0 end ) as wallet_count, 
sum(case when payment_method=&apos;Debit Card&apos; then 1 else 0 end ) as debit_card_count, 
sum(a.gmv_amount_lc) as total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as total_gmv_amount_eur, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_lc else 0 end ) as cash_gmv_lc, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_lc else 0 end ) as credit_card_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_lc else 0 end ) as wallet_mixed_payment_gmv_lc, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_lc else 0 end ) as wallet_gmv_lc, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_lc else 0 end ) as debit_card_gmv_lc, 
sum(case when payment_method=&apos;Cash&apos; then a.gmv_amount_eur else 0 end ) as cash_gmv_eur, 
sum(case when payment_method=&apos;Credit Card&apos; then a.gmv_amount_eur else 0 end ) as credit_card_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay,Card&apos; then a.gmv_amount_eur else 0 end ) as wallet_mixed_payment_gmv_eur, 
sum(case when payment_method=&apos;talabat Pay&apos; then a.gmv_amount_eur else 0 end ) as wallet_gmv_eur, 
sum(case when payment_method=&apos;Debit Card&apos; then a.gmv_amount_eur else 0 end ) as debit_card_gmv_eur 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
group by 1 ,2)
select 
 order_date,
country, 
total_count, 
cash_count, 
credit_card_count, 
wallet_mixed_payment_count, 
wallet_count, 
debit_card_count, 
cash_count/total_count  cash_order_count_percentage, 
credit_card_count/total_count credit_card_order_count_percentage, 
wallet_mixed_payment_count/total_count wallet_mixed_payment_order_count_percentage, 
wallet_count/total_count wallet_order_count_percentage, 
(wallet_mixed_payment_count+wallet_count)/total_count total_wallet_order_count_percentage, 
debit_card_count/total_count debit_card_order_count_percentage, 
wallet_mixed_payment_gmv_eur/total_gmv_amount_eur wallet_mixed_payment_gmv_percentage,
wallet_gmv_eur/total_gmv_amount_eur wallet_gmv_percentage,
(wallet_mixed_payment_gmv_eur+wallet_gmv_eur)/total_gmv_amount_eur total_wallet_gmv_percentage,
total_gmv_amount_lc, 
total_gmv_amount_eur, 
cash_gmv_lc, 
credit_card_gmv_lc, 
wallet_mixed_payment_gmv_lc, 
wallet_gmv_lc, 
debit_card_gmv_lc, 
cash_gmv_eur, 
credit_card_gmv_eur, 
wallet_mixed_payment_gmv_eur, 
wallet_gmv_eur, 
debit_card_gmv_eur 
from counts</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
