    <worksheet name='verify flutter performance GMV Payment Share/Wallet Balance&gt;0'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Flutter performance Order GMV Payment Share/Wallet Balance&gt;0 details (wrt to traffic )</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Payment_share_for_users_with_credit' name='federated.0nwngkv14guaz51gei18b0qf4vdz' />
          </datasources>
          <datasource-dependencies datasource='federated.0nwngkv14guaz51gei18b0qf4vdz'>
            <column-instance column='[total_gmv_eur_per_day]' derivation='Avg' name='[avg:total_gmv_eur_per_day:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[flutter_flag]' role='dimension' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[flutter_flag]' derivation='None' name='[none:flutter_flag:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[payment_method]' derivation='None' name='[none:payment_method:nk]' pivot='key' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='GMV with flutter ' datatype='real' name='[orders with flutter  (copy)_5495869312101056516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_date], [flutter_flag]: sum([payment_method_total_gmv_amount_eur]) }' />
            </column>
            <column caption='payment method GMV count % new' datatype='real' name='[payment method order count % new (copy)_5495869312100753411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([payment_method_total_gmv_amount_eur]) / AVG([orders with flutter  (copy)_5495869312101056516])' />
            </column>
            <column datatype='string' name='[payment_method]' role='dimension' type='nominal' />
            <column datatype='real' default-format='p0.00%' name='[payment_method_gmv_percentage]' role='measure' type='quantitative' />
            <column datatype='real' name='[payment_method_total_gmv_amount_eur]' role='measure' type='quantitative' />
            <column-instance column='[orders with flutter  (copy)_5495869312101056516]' derivation='Sum' name='[sum:orders with flutter  (copy)_5495869312101056516:qk]' pivot='key' type='quantitative' />
            <column-instance column='[payment_method_gmv_percentage]' derivation='Sum' name='[sum:payment_method_gmv_percentage:qk]' pivot='key' type='quantitative' />
            <column-instance column='[payment_method_total_gmv_amount_eur]' derivation='Sum' name='[sum:payment_method_total_gmv_amount_eur:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_gmv_eur_per_day]' role='measure' type='quantitative' />
