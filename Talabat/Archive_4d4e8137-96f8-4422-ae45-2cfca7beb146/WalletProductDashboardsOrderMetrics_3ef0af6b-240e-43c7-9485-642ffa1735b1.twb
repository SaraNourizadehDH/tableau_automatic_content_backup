    <worksheet name='Wallet Topup Funnel'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/wallet_vertical_breakup/WalletTopupFunnel?rev=' id='WalletTopupFunnel' path='/t/Talabat/workbooks/WalletProductDashboardsOrderMetrics' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Wallet Topup Funnel' name='federated.1408bco1dr1afz120s1jf0hiz7mt' />
          </datasources>
          <datasource-dependencies datasource='federated.1408bco1dr1afz120s1jf0hiz7mt'>
            <column caption='wallet_viewed_percentage' datatype='real' default-format='p0.00%' name='[Calculation_1828954059150692352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([wallet_viewed_count])/sum([session_count])' />
            </column>
            <column caption='wallet_topup_clicked_percentage' datatype='real' default-format='p0.00%' name='[Calculation_1828954059151151105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([wallet_topup_clicked_count])/sum([wallet_viewed_count])' />
            </column>
            <column caption='wallet_topup_card_chosen_percentage' datatype='real' default-format='p0.00%' name='[Calculation_1828954059151966210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([wallet_card_chosen_count])/sum([wallet_topup_clicked_count])' />
            </column>
            <column caption='wallet_topup_attempted_percentage' datatype='real' default-format='p0.00%' name='[Calculation_1828954059152506883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([wallet_topup_attempted_count])/ &#10;IF (sum([wallet_card_chosen_count]) &lt; sum([wallet_topup_attempted_count])) THEN &#10;sum([wallet_topup_clicked_count] ) &#10;ELSE sum([wallet_card_chosen_count]) end' />
            </column>
            <column caption='wallet_topup_succeeded_percentage' datatype='real' default-format='p0.00%' name='[Calculation_1828954059153137668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([wallet_topup_succeeded_count])/sum([wallet_topup_attempted_count])' />
            </column>
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='None' name='[none:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
