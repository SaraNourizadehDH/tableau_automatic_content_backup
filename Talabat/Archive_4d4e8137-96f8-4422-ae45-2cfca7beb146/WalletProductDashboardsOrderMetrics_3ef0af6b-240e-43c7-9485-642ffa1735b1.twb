    <datasource caption='Payment Method' inline='true' name='federated.0vn0guy0pj3abn14i7ngr1uznoz2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1vs8qro1042ea41bkeyjy0fwrds8'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='api-project-702632992366' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vs8qro1042ea41bkeyjy0fwrds8' name='Custom SQL Query' type='text'>with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;), 
orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id, 
count(*)
  OVER (
    PARTITION BY order_date, country_id
    ORDER BY order_date
  ) as total_count_per_day, 
sum(gmv_amount_eur)
  OVER (
    PARTITION BY order_date, country_id
    ORDER BY order_date
  ) as total_gmv_eur_per_day
from success_orders)
SELECT  
date_trunc(a.order_date,MONTH) month,
a.order_date,  
c.country, 
b.payment_method, 
a.total_count_per_day as total_order_count_per_day,
a.total_gmv_eur_per_day,
count(*) as orders_count_payment_method, 
sum(a.gmv_amount_lc) as total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as total_gmv_amount_eur
FROM orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
group by 1 ,2,3,4,5,6
order by 1 desc,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
