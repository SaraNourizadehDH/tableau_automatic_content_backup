            <connection CATALOG='tlb-data-prod' EXECCATALOG='api-project-702632992366' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
