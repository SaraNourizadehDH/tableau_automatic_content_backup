    <datasource caption='Payment Share' inline='true' name='federated.1xw038o0bnt5yr1en17ut0j6yz11' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gzh86w02xa5ez13ciqij05pq5dp'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='api-project-702632992366' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gzh86w02xa5ez13ciqij05pq5dp' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
(with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;
and st.is_test=false
and st.is_canceled_by_fraud_shield=false),
totals
as 
(select  
order_date, 
country_id,  
count(*) total_count_per_day, 
sum(gmv_amount_eur) as total_gmv_eur_per_day
from success_orders
group by 1,2), 
counts as (
SELECT  
a.order_date ,
c.country, 
case when a.payment_method_id=60 then &apos;talabat Pay,Card&apos; else 
payment_method
end as payment_method,  
d.total_count_per_day, 
d.total_gmv_eur_per_day,
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur, 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c, 
totals d 
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
and a.order_date=d.order_date 
and a.country_id=d.country_id
group by 1 ,2,3,4,5) 
select * ,
payment_method_total_count/total_count_per_day payment_method_order_count_percentage,
payment_method_total_gmv_amount_eur/total_gmv_eur_per_day payment_method_gmv_percentage
from counts)
union all 
(with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;
and st.is_test=false
and st.is_canceled_by_fraud_shield=false),
totals
as 
(select  
order_date, 
count(*) total_count_per_day, 
sum(gmv_amount_eur) as total_gmv_eur_per_day
from success_orders
group by 1), 
counts as (
SELECT  
a.order_date ,
&apos;ALL countries&apos;,
case when a.payment_method_id=60 then &apos;talabat Pay,Card&apos; else 
payment_method
end as payment_method, 
d.total_count_per_day, 
d.total_gmv_eur_per_day,
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur, 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
totals d 
where a.payment_method_id=b.payment_method_id
and a.order_date=d.order_date 
group by 1 ,2,3,4,5) 
select * ,
payment_method_total_count/total_count_per_day payment_method_order_count_percentage,
payment_method_total_gmv_amount_eur/total_gmv_eur_per_day payment_method_gmv_percentage
from counts)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
