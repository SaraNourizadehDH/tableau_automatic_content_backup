    <datasource caption='wallet_users_aov' inline='true' name='federated.1y2huud0kf71ve11gkfgg1xgp312' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0s6bu5e0jvx6c1164flrg00lvwnu'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0s6bu5e0jvx6c1164flrg00lvwnu' name='Custom SQL Query' type='text'><![CDATA[with wallet_usage 
as 
(select o.country_id, o.account_id, order_date as usage_date
from `tlb-data-prod.data_platform.fct_order_info` o 
join `tlb-data-prod.data_platform.dim_order_status` st on (o.order_status_id=st.order_status_id)
join tlb-data-prod.data_platform.dim_payment_method pm on (o.payment_method_id=pm.payment_method_id)
where st.status='SUCCESS'
and pm.payment_method='talabat Pay'
and o.is_test=false
union all 
select w.country_id, w.account_id, w.date as usage_date
from `tlb-data-prod.data_platform.fct_wallet_transaction` w
where transaction_type_id in (1000/*BNPL adhoc payment*/,301/*rider tip*/)
and payment_method_id in (46,45) 
),
first_wallet_usage
as 
(
select o.country_id, o.account_id, min (usage_date) first_wallet_usage_date
from wallet_usage o
group by 1,2
), 
customer_first_wallet_usage_month 
as 
(select country_id,
account_id, 
date_trunc(first_wallet_usage_date, MONTH ) first_wallet_usage_month
from first_wallet_usage
), 
raw as 
(
select o.order_date, 
o.country_id, 
c.country, 
date_trunc(o.order_date, MONTH) as order_month, 
o.gmv_amount_eur, 
o.gmv_amount_lc, 
o.order_id, 
o.account_id, 
case when w.account_id is null then 'Non wallet user'
when date_trunc(o.order_date, MONTH)>>=w.first_wallet_usage_month then 'Wallet user'
when date_trunc(o.order_date, MONTH)<<w.first_wallet_usage_month then 'Non wallet user'
end as wallet_user_type , 
case when w.account_id is null then 'Non wallet user'
when date_trunc(o.order_date, MONTH)>>w.first_wallet_usage_month then 'Old wallet user'
when date_trunc(o.order_date, MONTH)=w.first_wallet_usage_month then 'New wallet user'
when date_trunc(o.order_date, MONTH)<<w.first_wallet_usage_month then 'Non wallet user'
end as wallet_user_detailed_type
from `tlb-data-prod.data_platform.fct_order_info` o 
join `tlb-data-prod.data_platform.dim_order_status` st on (o.order_status_id=st.order_status_id)
join tlb-data-prod.data_platform.dim_payment_method pm on (o.payment_method_id=pm.payment_method_id)
join tlb-data-prod.data_platform.dim_country_info c on (c.country_id=o.country_id)
left join customer_first_wallet_usage_month w on o.account_id=w.account_id and o.country_id=w.country_id
where st.status='SUCCESS'
and o.is_test=false
and o.order_date>>='2021-01-01'
)
select order_month, 
country, 
--wallet_user_type, 
wallet_user_detailed_type,
round(count(distinct order_id) / count(distinct account_id),2) average_order_frequency,
sum(gmv_amount_eur)/ count(distinct order_id) aov_eur, 
sum(gmv_amount_lc)/ count(distinct order_id) aov_lc
from raw
group by 1,2,3
union all 
select order_month, 
country, 
--wallet_user_type, 
wallet_user_type as wallet_user_detailed_type,
round(count(distinct order_id) / count(distinct account_id),2) average_order_frequency,
sum(gmv_amount_eur)/ count(distinct order_id) aov_eur, 
sum(gmv_amount_lc)/ count(distinct order_id) aov_lc
from raw
where wallet_user_type='Wallet user'
group by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
