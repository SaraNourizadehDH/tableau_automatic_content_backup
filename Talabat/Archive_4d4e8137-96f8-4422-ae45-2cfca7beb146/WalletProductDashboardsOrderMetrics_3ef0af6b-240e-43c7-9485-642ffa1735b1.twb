        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.061lco61atdfeu1ddjs1h0n54f7h' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = &apos;SUCCESS&apos;)
SELECT  
a.order_date ,
c.country, 
b.payment_method, 
count(*) as payment_method_total_count, 
sum(a.gmv_amount_lc) as payment_method_total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as payment_method_total_gmv_amount_eur
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
and a.order_date&gt;&gt;&apos;2021-01-01&apos;
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.061lco61atdfeu1ddjs1h0n54f7h' name='Custom SQL Query' type='text'>/*same query as the monthly , but with order_date here*/
