        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hgi4mz0tei4oq17j2wnc1e0socg' name='Custom SQL Query' type='text'><![CDATA[with success_orders as 
(select gmv_amount_lc, 
gmv_amount_eur, 
order_date, 
country_id, 
payment_method_id
from `tlb-data-prod.data_platform.fct_order_info` a, 
`tlb-data-prod.data_platform.dim_order_status` st 
where st.order_status_id = a.order_status_id
and st.status = 'SUCCESS'
and st.is_test=false
and st.is_canceled_by_fraud_shield=false),
counts as 
(
SELECT  
date_trunc(a.order_date,MONTH) month,
c.country, 
count(*) as total_count, 
sum(case when payment_method='Cash' then 1 else 0 end ) as cash_count, 
sum(case when payment_method='Credit Card' then 1 else 0 end ) as credit_card_count, 
sum(case when payment_method='talabat Pay,Card' or a.payment_method_id=60 then 1 else 0 end ) as wallet_mixed_payment_count, 
sum(case when payment_method='talabat Pay' and a.payment_method_id<<>>60 then 1 else 0 end ) as wallet_count, 
sum(case when payment_method='Debit Card' then 1 else 0 end ) as debit_card_count, 
sum(a.gmv_amount_lc) as total_gmv_amount_lc, 
sum(a.gmv_amount_eur) as total_gmv_amount_eur, 
sum(case when payment_method='Cash' then a.gmv_amount_lc else 0 end ) as cash_gmv_lc, 
sum(case when payment_method='Credit Card' then a.gmv_amount_lc else 0 end ) as credit_card_gmv_lc, 
sum(case when payment_method='talabat Pay,Card' or a.payment_method_id=60 then a.gmv_amount_lc else 0 end ) as wallet_mixed_payment_gmv_lc, 
sum(case when payment_method='talabat Pay'  and a.payment_method_id<<>>60  then a.gmv_amount_lc else 0 end ) as wallet_gmv_lc, 
sum(case when payment_method='Debit Card' then a.gmv_amount_lc else 0 end ) as debit_card_gmv_lc, 
sum(case when payment_method='Cash' then a.gmv_amount_eur else 0 end ) as cash_gmv_eur, 
sum(case when payment_method='Credit Card' then a.gmv_amount_eur else 0 end ) as credit_card_gmv_eur, 
sum(case when payment_method='talabat Pay,Card' or a.payment_method_id=60  then a.gmv_amount_eur else 0 end ) as wallet_mixed_payment_gmv_eur, 
sum(case when payment_method='talabat Pay'  and a.payment_method_id<<>>60  then a.gmv_amount_eur else 0 end ) as wallet_gmv_eur, 
sum(case when payment_method='Debit Card' then a.gmv_amount_eur else 0 end ) as debit_card_gmv_eur 
FROM success_orders a, 
`tlb-data-prod.data_platform.dim_payment_method` b , 
`tlb-data-prod.data_platform.dim_country_info` c
where a.payment_method_id=b.payment_method_id
and a.country_id=c.country_id
group by 1 ,2)
select 
 month,
country, 
total_count, 
cash_count, 
credit_card_count, 
wallet_mixed_payment_count, 
wallet_count, 
debit_card_count, 
cash_count/total_count  cash_percentage, 
credit_card_count/total_count credit_card_percentage, 
wallet_mixed_payment_count/total_count wallet_mixed_payment_percentage, 
wallet_count/total_count wallet_percentage, 
debit_card_count/total_count debit_card_percentage, 
total_gmv_amount_lc, 
total_gmv_amount_eur, 
cash_gmv_lc, 
credit_card_gmv_lc, 
wallet_mixed_payment_gmv_lc, 
wallet_gmv_lc, 
debit_card_gmv_lc, 
cash_gmv_eur, 
credit_card_gmv_eur, 
wallet_mixed_payment_gmv_eur, 
wallet_gmv_eur, 
debit_card_gmv_eur 
from counts]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
