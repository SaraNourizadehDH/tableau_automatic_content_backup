      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:wallet_user_detailed_type:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;new wallet user&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Old wallet user&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;New wallet user&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;old wallet user&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Wallet user&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Non wallet user&quot;</bucket>
            </map>
