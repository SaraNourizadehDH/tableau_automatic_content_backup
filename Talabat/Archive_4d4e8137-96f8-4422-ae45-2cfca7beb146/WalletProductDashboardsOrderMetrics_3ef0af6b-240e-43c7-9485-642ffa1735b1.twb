    <datasource caption='Wallet Topup Funnel' inline='true' name='federated.1408bco1dr1afz120s1jf0hiz7mt' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04crtwd09pkqlt13az05g0vh0mw2'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.ziyad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04crtwd09pkqlt13az05g0vh0mw2' name='Custom SQL Query' type='text'>select &apos;Daily&apos; type, date, a.operating_system, b.country_name, 
count(*) as session_count, 
sum(case when wallet_viewed then 1 end ) as wallet_viewed_count, 
sum(case when wallet_topup_clicked then 1 end ) as wallet_topup_clicked_count, 
coalesce(sum(case when wallet_card_chosen then 1 end ),0) as wallet_card_chosen_count, 
sum(case when wallet_topup_attempted then 1 end ) as wallet_topup_attempted_count, 
sum(case when wallet_topup_succeeded then 1 end ) as wallet_topup_succeeded_count, 
sum(case when wallet_topup_failed then 1 end ) as wallet_topup_failed_count
from tlb-data-prod.data_platform.fct_session  a, 
tlb-data-prod.data_platform.dim_location_info b 
where a.location_id=b.location_id  
and a.date&gt;&gt;=&apos;2022-09-01&apos;
group by 1,2,3,4

union all 
select &apos;Monthly&apos; type, date_trunc (date ,month) as date , a.operating_system, b.country_name, 
count(*) as session_count, 
sum(case when wallet_viewed then 1 end ) as wallet_viewed_count, 
sum(case when wallet_topup_clicked then 1 end ) as wallet_topup_clicked_count, 
coalesce(sum(case when wallet_card_chosen then 1 end ),0) as wallet_card_chosen_count, 
sum(case when wallet_topup_attempted then 1 end ) as wallet_topup_attempted_count, 
sum(case when wallet_topup_succeeded then 1 end ) as wallet_topup_succeeded_count, 
sum(case when wallet_topup_failed then 1 end ) as wallet_topup_failed_count
from tlb-data-prod.data_platform.fct_session  a, 
tlb-data-prod.data_platform.dim_location_info b 
where a.location_id=b.location_id  
and a.date&gt;&gt;=&apos;2022-09-01&apos;
group by 1,2,3, 4
order by 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
