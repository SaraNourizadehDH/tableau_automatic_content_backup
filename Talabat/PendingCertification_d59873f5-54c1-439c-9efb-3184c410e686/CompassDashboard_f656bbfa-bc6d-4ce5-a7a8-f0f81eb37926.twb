      <column caption='Total Talabat Brands (CIty)' datatype='real' name='[Calculation_156148307090046976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [observation_week_start], [city_id], [platform]: MAX([city_brands_on_talabat_count])}' />
      </column>
      <column caption='Same Price %' datatype='real' default-format='p0.0%' name='[Calculation_1920785303675121664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([brands_same_price_count]) / &#10;(SUM([brands_same_price_count]) + SUM([brands_competitor_more_expensive_count])+ SUM([brands_talabat_more_expensive_count]))' />
      </column>
      <column caption='Filter - Area' datatype='boolean' name='[Calculation_1920785303705763845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] = [location_id]' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_3251036041885253632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [observation_week_start], [location_id]: MAX([total_sessions])}' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_3251036041889107970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_placed_orders])/SUM([total_sessions])' />
      </column>
      <column caption='Color Code' datatype='string' name='[Calculation_3251036041892941827]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([total_sessions]) &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;High Sessions, Low CVR&apos; &#10;ELSEIF [Calculation_3251036041889107970] &gt;= [Parameters].[Parameter 2] &#10;then &apos;High CVR&apos;&#10;ELSEIF  sum([total_sessions]) &lt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;Low Sessions, Low CVR&apos; &#10;&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_3251036041984049160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF  [Reporting Date] = DATETRUNC(&apos;week&apos;, [Date]) THEN &apos;Selected Period&apos; ELSEIF [Reporting Date] = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Date])) THEN &apos;Previous Period&apos; ELSE &apos;Remaining Days&apos; END&#10;[reporting_date] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='Default Date' datatype='date' name='[Calculation_3251036041985757194]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{max([reporting_date]) }' />
      </column>
      <column caption='Brands Count Difference' datatype='integer' name='[Calculation_3251036042212491279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([brands_on_talabat_count]) - SUM([brands_on_competitor_count])' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_3251036042216251408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;WHEN &apos;Brands Difference&apos; THEN [Calculation_3251036042212491279]&#10;WHEN &apos;Talabat Closed&apos; THEN SUM([brands_on_talabat_and_closed_count])&#10;WHEN &apos;CVR&apos; THEN [Calculation_3251036041889107970]&#10;END' />
      </column>
      <column caption='Info Button' datatype='string' name='[Calculation_477381619033948168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;ⓘ&apos;' />
      </column>
      <column caption='Map Color' datatype='string' name='[Calculation_4963881646021783556]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([total_sessions]) &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;High Sessions, Low CVR&apos; &#10;ELSEIF [Calculation_3251036041889107970] &gt;= [Parameters].[Parameter 2] &#10;then &apos;High CVR&apos;&#10;ELSEIF  sum([total_sessions]) &lt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;Low Sessions, Low CVR&apos; &#10;&#10;END' />
      </column>
      <column caption='Platform Filter' datatype='boolean' name='[Calculation_4963881646032871435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform] = [Parameters].[Parameter 8]' />
      </column>
      <column caption='City/Area Name' datatype='string' name='[Calculation_5641110392541835264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if LOWER([area_name]) = &apos;overall&apos; then &quot; &quot;+[city_name] ELSE [area_name] END' />
      </column>
      <column caption='Remove Areas' datatype='boolean' name='[Calculation_8212032511119691777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[area_name] != &apos;Dubai Maritime City&apos;&#10;or&#10;[area_name] != &apos;Dubai Creek Harbour&apos;&#10;or&#10;[area_name] != &apos;Al Shindagha&apos;&#10;or&#10;[area_name] != &apos;Gardens&apos;&#10;or&#10;[area_name (area_polygon.geojson)] != &apos;Dubai Maritime City&apos;&#10;or&#10;[area_name (area_polygon.geojson)] != &apos;Dubai Creek Harbour&apos;&#10;or&#10;[area_name (area_polygon.geojson)] != &apos;Al Shindagha&apos;&#10;or&#10;[area_name (area_polygon.geojson)] != &apos;Gardens&apos;' />
      </column>
