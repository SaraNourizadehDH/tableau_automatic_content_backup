              <calculation class='tableau' formula='#2024-11-01#' />
            </column>
            <column caption='Parameter - Location ID' datatype='integer' datatype-customized='true' default-format='n0;-0' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='588'>
