              <calculation class='tableau' formula='[area_name] != &apos;overall&apos;' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_3251036041889107970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_placed_orders])/SUM([total_sessions])' />
