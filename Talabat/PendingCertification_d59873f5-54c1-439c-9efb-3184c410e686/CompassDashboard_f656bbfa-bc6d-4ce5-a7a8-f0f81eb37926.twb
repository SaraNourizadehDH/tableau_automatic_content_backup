      <table>
        <view>
          <datasources>
            <datasource caption='compass_data' name='federated.0neu8t20ot563t1gej7hy07q4vne' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Session Value' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='9233'>
              <calculation class='tableau' formula='9233' />
            </column>
            <column caption='CVR Value' datatype='real' default-format='p0.00%' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.2657'>
              <calculation class='tableau' formula='0.2657' />
            </column>
            <column caption='Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-01#'>
              <calculation class='tableau' formula='#2024-11-01#' />
            </column>
            <column caption='Select Second Metric' datatype='string' name='[Select Metric (copy)_3251036042218700817]' param-domain-type='list' role='measure' type='nominal' value='&quot;Placed Orders&quot;'>
              <calculation class='tableau' formula='&quot;Placed Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0neu8t20ot563t1gej7hy07q4vne'>
            <column caption='remove overall' datatype='boolean' name='[Calculation_1535586748879962113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[area_name] != &apos;overall&apos;' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_3251036041889107970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_placed_orders])/SUM([total_sessions])' />
            </column>
            <column caption='Color Code' datatype='string' name='[Calculation_3251036041892941827]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if sum([total_sessions]) &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;High Sessions, Low CVR&apos; &#10;ELSEIF [Calculation_3251036041889107970] &gt;= [Parameters].[Parameter 2] &#10;then &apos;High CVR&apos;&#10;ELSEIF  sum([total_sessions]) &lt;= [Parameters].[Parameter 1] &#10;AND [Calculation_3251036041889107970] &lt;= [Parameters].[Parameter 2] &#10;THEN &apos;Low Sessions, Low CVR&apos; &#10;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_3251036041984049160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF  [Reporting Date] = DATETRUNC(&apos;week&apos;, [Date]) THEN &apos;Selected Period&apos; ELSEIF [Reporting Date] = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Date])) THEN &apos;Previous Period&apos; ELSE &apos;Remaining Days&apos; END&#10;[reporting_date] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Brands Count Difference' datatype='integer' name='[Calculation_3251036042212491279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([brands_on_talabat_count]) - SUM([brands_on_competitor_count])' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='Selected Metric 2' datatype='real' name='[Selected Metric (copy)_3251036042219032594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_3251036042218700817] &#10;WHEN &apos;Sessions&apos; THEN Sum([total_sessions])&#10;WHEN &apos;Placed Orders&apos; THEN SUM([food_placed_orders])&#10;WHEN &apos;CVR&apos; THEN [Calculation_3251036041889107970]&#10;&#10;END' />
            </column>
            <column caption='Delivery Area Name' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column caption='Total Competitor Brands' datatype='integer' default-format='n#,##0;-#,##0' name='[brands_on_competitor_count]' role='measure' type='quantitative' />
