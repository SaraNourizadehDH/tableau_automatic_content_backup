            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
              <calculation class='tableau' formula='&quot;CVR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0neu8t20ot563t1gej7hy07q4vne'>
