    <worksheet name='shrinkage_on'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>KPI&apos;s for Days where Shrinkage = On</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='opf test 1' name='federated.1kvezwk0ztsyie1aauh8a0c39otd' />
          </datasources>
          <datasource-dependencies datasource='federated.1kvezwk0ztsyie1aauh8a0c39otd'>
            <column caption='Avg. delivery time' datatype='real' name='[Calculation_3978508067808198656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_delivery_time]) / sum([total_orders])' />
            </column>
            <column caption='avg. to customer time' datatype='real' name='[Calculation_3978508067808333825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_to_customer_time]) / sum([total_orders])' />
            </column>
            <column caption='avg to vendor time' datatype='real' name='[Calculation_3978508067808452610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_to_vendor_time]) / sum([total_orders])' />
            </column>
            <column caption='Contact Rate %' datatype='real' name='[Calculation_3978508067808727043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_customer_contacts]) / sum([total_contacts])' />
            </column>
            <column caption='Logistics Fail Rate %' datatype='real' name='[Calculation_3978508067809136644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_failed_logistics_orders]) / sum([total_orders])' />
            </column>
            <column caption='OPF %' datatype='real' name='[Calculation_3978508067809443845]' role='measure' type='quantitative'>
