            <column-instance column='[total_failed_logistics_orders]' derivation='Sum' name='[sum:total_failed_logistics_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders]' derivation='Sum' name='[sum:total_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders_failed]' derivation='Sum' name='[sum:total_orders_failed:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders_successful]' derivation='Sum' name='[sum:total_orders_successful:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[sum_delivery_time]' role='measure' type='quantitative' />
            <column datatype='real' name='[sum_to_customer_time]' role='measure' type='quantitative' />
            <column datatype='real' name='[sum_to_vendor_time]' role='measure' type='quantitative' />
