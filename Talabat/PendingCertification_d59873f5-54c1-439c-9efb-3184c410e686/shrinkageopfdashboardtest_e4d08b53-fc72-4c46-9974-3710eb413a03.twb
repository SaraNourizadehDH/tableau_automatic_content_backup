            <column datatype='integer' name='[orders_late_greater_than_10_min]' role='measure' type='quantitative' />
            <column caption='rider late orders 10min %' datatype='real' name='[rider_late_orders_10min_percentage]' role='measure' type='quantitative' />
            <column caption='Shrinkage On' datatype='string' name='[shrinkage_on]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;FALSE&quot;' value='Turned Off' />
                <alias key='&quot;TRUE&quot;' value='Shrinkage Bypass Feature Turned On' />
