            <expression op='AND'>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[lower(country_code)]' _.fcp.RelationshipCalculations.true...op='lower([country_code])' />
                <expression _.fcp.RelationshipCalculations.false...op='[lower(country_code (Custom SQL Query1))]' _.fcp.RelationshipCalculations.true...op='lower([country_code (Custom SQL Query1)])' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[lower(title_type)]' _.fcp.RelationshipCalculations.true...op='lower([title_type])' />
                <expression _.fcp.RelationshipCalculations.false...op='[lower(am_type)]' _.fcp.RelationshipCalculations.true...op='lower([am_type])' />
              </expression>
            </expression>
            <first-end-point object-id='_2AEF2261144E471A9C3EC43B1AA39AD5' />
