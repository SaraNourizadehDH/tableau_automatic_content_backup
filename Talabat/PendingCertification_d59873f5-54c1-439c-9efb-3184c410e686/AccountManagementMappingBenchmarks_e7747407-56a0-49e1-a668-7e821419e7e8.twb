  (
      ifnull(sum(gem_commission_amount_eur_excl_vat) - sum(if(gem_flat_discount_amount_eur_excl_vat &gt;&gt; gem_commission_amount_eur_excl_vat,gem_commission_amount_eur_excl_vat, gem_flat_discount_amount_eur_excl_vat)) - sum(cpc_credit_eur_excl),0)
