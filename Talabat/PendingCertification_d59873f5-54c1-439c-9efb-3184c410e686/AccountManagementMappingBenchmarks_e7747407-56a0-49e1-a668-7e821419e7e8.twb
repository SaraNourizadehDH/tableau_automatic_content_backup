          <relation connection='bigquery.1nwl3410ptuwq41eutpae1qgy22w' name='Custom SQL Query1' type='text'>select
country_code,
am_type,
safe_cast(gmv_share_benchmark as float64)gmv_share_benchmark,
safe_cast(order_share_benchmark as float64) order_share_benchmark,
safe_cast(adrev_share_benchmark as float64) adrev_share_benchmark,
from `tlb-data-dev.data_platform_google_sheet.account_manager_type_benchmark`
qualify row_number() over (partition by country_code, am_type order by date_month desc) = 1</relation>
