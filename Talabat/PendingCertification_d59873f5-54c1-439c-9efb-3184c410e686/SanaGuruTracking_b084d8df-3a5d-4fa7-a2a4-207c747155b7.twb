    <worksheet name='course type attributes'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#411517' fontname='Tableau Regular' fontsize='11'>Course Attributes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_sana' name='federated.1yjcp73164np6b1b9h6sp0vfmnw9' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Spent (hours)&quot;'>
              <calculation class='tableau' formula='&quot;Time Spent (hours)&quot;' />
            </column>
            <column caption='Top N ' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='5' max='20' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yjcp73164np6b1b9h6sp0vfmnw9'>
            <column caption=' Time spent (hrs) ' datatype='real' default-format='n#,##0;-#,##0' name='[ Time spent (mins)  (copy)_3636938217497784324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([course_time_spent_seconds])/3600)' />
            </column>
            <column caption='# of employees' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3636938217215688704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([user])' />
            </column>
            <column caption='Measure I' datatype='real' name='[Calculation_3636938217504382987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2] when &apos;# of Courses started&apos; then SUM([courses_started])&#10;when &apos;Time Spent (hours)&apos; then [ Time spent (mins)  (copy)_3636938217497784324]&#10;when &apos;# of users&apos; then [Calculation_3636938217215688704]&#10;end' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_3636938217507201036]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='index()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calculation1' datatype='boolean' name='[Calculation_3636938217508904974]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] &gt;= [Calculation_3636938217507201036]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[content_title]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[course_time_spent_seconds]' role='measure' type='quantitative' />
            <column datatype='integer' default-format='n#,##0;-#,##0' name='[courses_started]' role='measure' type='quantitative' />
