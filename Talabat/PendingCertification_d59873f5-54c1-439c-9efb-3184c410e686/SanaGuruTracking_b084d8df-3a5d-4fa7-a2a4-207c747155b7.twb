      <table>
        <view>
          <datasources>
            <datasource caption='temp_agg_account_manager_sana' name='federated.1yjcp73164np6b1b9h6sp0vfmnw9' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1yjcp73164np6b1b9h6sp0vfmnw9'>
            <column caption='Program Completed Courses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_4859102573862244353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country],[user], [program_title]: max([program_courses_completed])}' />
            </column>
            <column caption='Program Started Courses' datatype='integer' default-format='n#,##0;-#,##0' name='[Program Completed Courses (copy)_4859102573862481922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country],[user], [program_title]: max([program_courses_started])}' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Program Completion %' datatype='real' default-format='p0.00%' name='[course_completion_rate (copy)_4859102573860020224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([program_courses_completed])/SUM([program_courses_completed])' />
