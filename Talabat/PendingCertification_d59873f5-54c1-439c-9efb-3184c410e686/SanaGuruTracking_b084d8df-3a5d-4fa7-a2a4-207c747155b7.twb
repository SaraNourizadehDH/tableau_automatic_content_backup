    <datasource caption='temp_agg_account_manager_sana' inline='true' name='federated.1yjcp73164np6b1b9h6sp0vfmnw9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1cjf4w21qohilv18hv3qi07j9xb2'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='savannahp@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cjf4w21qohilv18hv3qi07j9xb2' name='Custom SQL Query' type='text'><![CDATA[with am_details as 
(
  SELECT
    country,
    company_name__c,
    firstname || " " || lastname AS user,
    userrole_name,
    email,
    title,
    CASE
        WHEN u.title IN ('Account Manager', 'Sales Executive', 'Sr. Analyst - Sales Performance', ' ') THEN 'Account Manager'
        WHEN u.title IN ('Sr. Account Manager') THEN 'Sr. Account Manager'
        WHEN u.title IN ('Key Account Manager') THEN 'Key Account Manager'
        WHEN u.title IN ('Sr. Key Account Manager') THEN 'Sr. Key Account Manager'
        WHEN u.title IN ('Online Account Manager', 'Online Account Manager II') THEN 'Online Account Manager'
        WHEN
            u.title IN (
                'Associate Team Lead Account Management', 'Team Lead Account Management', 'Team Lead Online Account Management', 'Team Lead Online Account Management - Bahrain'
            )
            THEN 'Team Lead'
        ELSE 'Account Manager'
    END AS title_type,
    central_job_role__c,
    createddate,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), month) as tenure_months,
    date_diff(date_trunc(date(current_date),month), date_trunc(date(createddate),month), year) as tenure_years,
  FROM  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  INNER JOIN `tlb-data-prod.data_platform_google_sheet.account_manager_target` t on lower(AM) = lower(  firstname || " " || lastname) 
  WHERE 1=1
  AND company_name__c = 'Talabat'
  AND isactive
)
, sana_details as 
(
  select
    distinct
    ua.year_month,
    ua.user_display_name,
    ua.user_email,
    ua.monthly_active_users,
    ua.weekly_active_users,
    ua.daily_active_users,
    ct.content_title,
    sum(ct.time_spent_seconds) as course_time_spent_seconds,
    sum(c.courses_completed)courses_completed,
    sum(c.courses_started)courses_started,
    sum(c.courses_accessible)courses_accessible,
    safe_divide( sum(c.courses_started), sum(c.courses_accessible)) completion_rate_l1,
    safe_divide( sum(c.courses_completed), sum(c.courses_accessible)) completion_rate_l2,
    safe_divide( sum(c.courses_completed), sum(c.courses_started)) completion_rate_l3,
    -- program insights
  from `tlb-data-prod.data_platform_sana.activity_per_user_country`  ua
  LEFT JOIN `tlb-data-prod.data_platform_sana.user_performance_time_spent_per_month`  up on ua.user_id = up.user_id and ua.year_month = up.year_month
  LEFT JOIN `tlb-data-prod.data_platform_sana.time_spent_by_user_per_course_program_per_month`  ct on ua.user_id = ct.user_id and ct.year_month = up.year_month 
  left join `tlb-data-prod.data_platform_sana.content_insights_per_user` c on ua.user_id = c.user_id and c.content_id = ct.content_id
  where 1=1
  and ct.content_type = 'course'
  -- and ua.user_display_name = 'Mohammad Sayyab'
 group by all
)
, percentiles AS 
(
  SELECT
    distinct
    title_type,
    PERCENTILE_CONT(tenure_months, 0.75) OVER (partition by title_type) AS upper_bound_75,
    PERCENTILE_CONT(tenure_months, 0.25) OVER (partition by title_type) AS lower_bound_25
  FROM am_details
)
select 
distinct 
    am.country,
    am.user,
    am.title,
    am.title_type,
    am.central_job_role__c,
    date_trunc(date(am.createddate),month) as employee_month,
    am.tenure_months,
    am.tenure_years,
    p.upper_bound_75 as am_upper_bound,
    p.lower_bound_25 as am_lower_bound,
    CASE 
      WHEN am.tenure_months >>=  upper_bound_75 THEN 'Experienced'
      WHEN am.tenure_months <<=  lower_bound_25  THEN 'Newbie'
      ELSE 'Intermediate'
    END AS tenure_bucket,
    -- s.monthly_active_users,
    -- s.weekly_active_users,
    -- s.daily_active_users,
    ( case when s.monthly_active_users is not null then user end) as monthly_active_users,
    ( case when s.weekly_active_users is not null then user end) as weekly_active_users,
    ( case when s.daily_active_users is not null then user end) as daily_active_users,
    date(s.year_month)year_month,
    s.content_title,
    s.course_time_spent_seconds,
    s.courses_completed,
    s.courses_started,
    s.courses_accessible,
    s.completion_rate_l1,
    s.completion_rate_l2,
    s.completion_rate_l3
from am_details am
LEFT join sana_details s on lower(am.email) = lower(s.user_email)
left join percentiles p on lower(am.title_type) = lower(p.title_type)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
