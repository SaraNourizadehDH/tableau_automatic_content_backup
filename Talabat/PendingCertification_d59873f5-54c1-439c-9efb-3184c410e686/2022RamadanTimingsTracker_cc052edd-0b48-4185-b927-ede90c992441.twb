        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vwkvou191drm318fc9de04tq59o' name='Custom SQL Query' type='text'><![CDATA[WITH VENDOR_DETAILS AS (
SELECT dv.vendor_id
, dvi.salesforce_id
, dv.country_iso
, dv.chain_id
, dv.name_en AS vendor_name
, dv.is_tgo AS vendor_is_tgo
, dv.is_active AS vendor_is_active
, dv.is_chain_active AS vendor_is_chain_active
, dv.vertical AS vertical
, dc.chain_name
, dc.vertical AS chain_vertical
, dvi.account_manager_email
, chain_status
, dl.city_name
, dvi.is_key_vip_account

FROM `tlb-data-prod.data_platform.dim_vendor` dv
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc USING (chain_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dvi USING (vendor_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_location` dl ON dv.location_id=dl.location_id

WHERE dv.is_active=True AND dc.chain_status <<= 2 AND is_deleted_chain=False
AND dvi.is_hidden = False AND dv.country_iso IS NOT NULL),

 _SCHEDULE_UPDATES AS (
SELECT
countryId
, vendorId AS vendor_id
, source AS update_source
, requester AS update_requester
, timingType AS timing_type
, TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[
    OFFSET
    (0)]AS INT64)) ingestion_timestamp,event,
ROW_NUMBER() OVER (PARTITION BY vendorId ORDER BY  TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[OFFSET(0)]AS INT64)) DESC) AS _rn
FROM
`tlb-data-prod.data_platform_streams.vendor_availability_events`
WHERE event='ramdan_schedule'
AND DATE(TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[OFFSET(0)]AS INT64))) >>= DATE('2023-02-22')),

SCHEDULE_UPDATES AS (
SELECT * EXCEPT (_rn)
FROM _SCHEDULE_UPDATES
WHERE _rn = 1)

SELECT *
FROM VENDOR_DETAILS
LEFT JOIN SCHEDULE_UPDATES  USING (vendor_id)
ORDER BY update_source DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vwkvou191drm318fc9de04tq59o' name='Custom SQL Query' type='text'><![CDATA[WITH VENDOR_DETAILS AS (
SELECT dv.vendor_id
, dvi.salesforce_id
, dv.country_iso
, dv.chain_id
, dv.name_en AS vendor_name
, dv.is_tgo AS vendor_is_tgo
, dv.is_active AS vendor_is_active
, dv.is_chain_active AS vendor_is_chain_active
, dv.vertical AS vertical
, dc.chain_name
, dc.vertical AS chain_vertical
, dvi.account_manager_email
, chain_status
, dl.city_name
, dvi.is_key_vip_account

FROM `tlb-data-prod.data_platform.dim_vendor` dv
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc USING (chain_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dvi USING (vendor_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_location` dl ON dv.location_id=dl.location_id

WHERE dv.is_active=True AND dc.chain_status <<= 2 AND is_deleted_chain=False
AND dvi.is_hidden = False AND dv.country_iso IS NOT NULL),

 _SCHEDULE_UPDATES AS (
SELECT
countryId
, vendorId AS vendor_id
, source AS update_source
, requester AS update_requester
, timingType AS timing_type
, TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[
    OFFSET
    (0)]AS INT64)) ingestion_timestamp,event,
ROW_NUMBER() OVER (PARTITION BY vendorId ORDER BY  TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[OFFSET(0)]AS INT64)) DESC) AS _rn
FROM
`tlb-data-prod.data_platform_streams.vendor_availability_events`
WHERE event='ramdan_schedule'
AND DATE(TIMESTAMP_SECONDS(CAST(SPLIT(timestamp, '.')[OFFSET(0)]AS INT64))) >>= DATE('2023-02-22')),

SCHEDULE_UPDATES AS (
SELECT * EXCEPT (_rn)
FROM _SCHEDULE_UPDATES
WHERE _rn = 1)

SELECT *
FROM VENDOR_DETAILS
LEFT JOIN SCHEDULE_UPDATES  USING (vendor_id)
ORDER BY update_source DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
