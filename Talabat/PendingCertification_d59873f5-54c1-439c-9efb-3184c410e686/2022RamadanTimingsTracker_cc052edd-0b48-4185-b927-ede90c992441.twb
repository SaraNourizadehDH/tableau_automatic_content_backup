      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.08w45bj16n2oah12qi38c0nnsqzn].[ctd:vendor_id:qk]&quot;' value='# Vendors' />
          <alias key='&quot;[federated.08w45bj16n2oah12qi38c0nnsqzn].[usr:Calculation_4125297264699568129:qk]&quot;' value='Completion Rate' />
          <alias key='&quot;[federated.08w45bj16n2oah12qi38c0nnsqzn].[usr:Calculation_4125297264701210626:qk]&quot;' value='Self Service Adoption' />
          <alias key='&quot;[federated.08w45bj16n2oah12qi38c0nnsqzn].[usr:Calculation_4125297264703221765:qk]&quot;' value='Key accounts Completion Rate' />
        </aliases>
      </column>
      <column caption='% COMPLETION RATE' datatype='real' default-format='p0.00%' name='[Calculation_4125297264699568129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([update_source]) THEN [vendor_id] END) / COUNTD([vendor_id])' />
      </column>
      <column caption='% SELF SERVICE' datatype='real' default-format='p0.00%' name='[Calculation_4125297264701210626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [update_requester]=&apos;vendor_portal&apos; THEN 1 END) / COUNT([update_requester])' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_4125297264702087171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;,[ingestion_timestamp])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;,[ingestion_timestamp])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;,[ingestion_timestamp])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Hourly&apos; THEN STR([ingestion_timestamp])&#10;END' />
      </column>
      <column caption='% Completion Rate Key Account' datatype='real' default-format='p0.00%' name='[Calculation_4125297264703221765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_key_vip_account]=TRUE AND NOT (ISNULL([update_source])) THEN [vendor_id] END) / COUNTD(IF [is_key_vip_account]=True THEN [vendor_id] END)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_71FCCC6DB6E74C0BA92C58B8578F0925]' role='measure' type='quantitative' />
      <column caption='AM Email' datatype='string' name='[account_manager_email]' role='dimension' type='nominal' />
