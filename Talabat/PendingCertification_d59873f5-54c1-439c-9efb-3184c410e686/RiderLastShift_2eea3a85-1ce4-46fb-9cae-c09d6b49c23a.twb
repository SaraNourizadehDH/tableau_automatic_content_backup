      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CA21CFDBA7E7481F9262BC3C8FE8ACB2'>
            <properties context=''>
              <relation connection='bigquery.1iynqf81sjmxz4194sca61brwy9f' name='Custom SQL Query' type='text'>WITH RiderLastShift AS &#13;
(&#13;
    SELECT&#13;
        rider_id,&#13;
        actual_start_at,&#13;
        DATE(actual_start_at, &apos;Africa/Cairo&apos;) as last_shift_date,&#13;
        -- Rank all shifts to find the absolute last one for each rider&#13;
        ROW_NUMBER() OVER(PARTITION BY rider_id ORDER BY actual_start_at DESC) as shift_rank,&#13;
        -- Calculate stats for the specific day the shift occurred on, using the local timezone&#13;
        COUNT(shift_id) OVER(PARTITION BY rider_id, DATE(actual_start_at, &apos;Africa/Cairo&apos;)) as shifts_on_this_day,&#13;
        SUM(actual_working_time) OVER(PARTITION BY rider_id, DATE(actual_start_at, &apos;Africa/Cairo&apos;)) as total_actual_duration_on_day,&#13;
        SUM(planned_shift_duration) OVER(PARTITION BY rider_id, DATE(actual_start_at, &apos;Africa/Cairo&apos;)) as total_planned_duration_on_day&#13;
    FROM&#13;
        `tlb-data-prod.data_platform.fct_logistics_rider_shift`&#13;
)&#13;
&#13;
,-- CTE 2: For each day a rider had orders, find their last order&apos;s details and the total order count for that day.&#13;
OrderStatsPerDay AS &#13;
(&#13;
    SELECT&#13;
        primary_rider_id,&#13;
        order_date,&#13;
        order_count,&#13;
        last_order_id,&#13;
        last_order_time&#13;
    FROM &#13;
    (&#13;
        SELECT&#13;
            primary_rider_id,&#13;
            DATE(created_at, &apos;Africa/Cairo&apos;) AS order_date,&#13;
            order_id AS last_order_id,&#13;
            created_at AS last_order_time,&#13;
            -- Count total orders for the day in the local timezone&#13;
            COUNT(order_id) OVER(PARTITION BY primary_rider_id, DATE(created_at, &apos;Africa/Cairo&apos;)) as order_count,&#13;
            -- Rank orders within the day to find the last one&#13;
            ROW_NUMBER() OVER(PARTITION BY primary_rider_id, DATE(created_at, &apos;Africa/Cairo&apos;) ORDER BY created_at DESC) as daily_order_rank&#13;
        FROM&#13;
            `tlb-data-prod.data_platform.fct_logistics_order`&#13;
    )&#13;
    WHERE daily_order_rank = 1 -- This selects only the row corresponding to the last order of that day&#13;
)&#13;
&#13;
-- Final SELECT to assemble the complete report with columns in the specified order&#13;
SELECT&#13;
    ls.rider_id AS `Rider ID`,&#13;
    DATE(rider.last_contract_start_at, &apos;Africa/Cairo&apos;) AS `Start contract date`,&#13;
    FORMAT_DATE(&apos;%B&apos;, DATETIME(ls.actual_start_at, &apos;Africa/Cairo&apos;)) AS `Last Shift Month`,&#13;
    ls.last_shift_date AS `Last Evaluated Shift Date`,&#13;
    TIME(ls.actual_start_at, &apos;Africa/Cairo&apos;) AS `Last Shift Time`,&#13;
    ls.shifts_on_this_day AS `Count of Shifts on Last Working Day`,&#13;
    ROUND(ls.total_planned_duration_on_day / 3600, 2) AS `Planned Hours`,&#13;
    ROUND(ls.total_actual_duration_on_day / 3600, 2) AS `Actual Hours`,&#13;
    ROUND(&#13;
        SAFE_DIVIDE(ls.total_actual_duration_on_day, ls.total_planned_duration_on_day) * 100&#13;
    , 2) AS `AVP Pct`,&#13;
    os.last_order_id AS `Last Order ID`,&#13;
    DATETIME(os.last_order_time, &apos;Africa/Cairo&apos;) AS `Last Order Time`,&#13;
    COALESCE(os.order_count, 0) AS `Order Count on Last Shift Day`&#13;
FROM&#13;
    RiderLastShift ls&#13;
    LEFT JOIN&#13;
    OrderStatsPerDay os&#13;
    ON ls.rider_id = os.primary_rider_id AND ls.last_shift_date = os.order_date&#13;
LEFT JOIN&#13;
    `tlb-data-prod.data_platform.dim_logistics_rider` AS rider&#13;
    ON ls.rider_id = rider.rider_id&#13;
WHERE&#13;
    ls.shift_rank = 1&#13;
GROUP &#13;
    BY ALL &#13;
HAVING &#13;
    DATE(`Last Order Time`) &gt;&gt; DATE_TRUNC(current_date,month) - interval 6 month&#13;
ORDER BY&#13;
    `Last Evaluated Shift Date` DESC,&#13;
    `Rider ID`</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
