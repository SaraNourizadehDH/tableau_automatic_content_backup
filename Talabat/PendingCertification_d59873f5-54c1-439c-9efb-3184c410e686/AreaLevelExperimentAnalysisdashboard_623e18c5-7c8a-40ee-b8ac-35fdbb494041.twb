            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0egu66n0n0x3nb13ddi3w0naufdx].[Calculation_3778731199105302528]' caption='Choose Experiment' datatype='string' name='[Choose Entity (copy)_6029897706276470785]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025-07-02_BH_Speed-vs-Choice-Expansion_Bahrain - TB_BH|10&quot;'>
              <calculation class='tableau' formula='&quot;2025-07-02_BH_Speed-vs-Choice-Expansion_Bahrain - TB_BH|10&quot;' />
