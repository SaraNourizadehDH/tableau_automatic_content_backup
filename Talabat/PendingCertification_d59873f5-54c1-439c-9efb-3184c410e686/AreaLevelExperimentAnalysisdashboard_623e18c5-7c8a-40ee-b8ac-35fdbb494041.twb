    <worksheet name='Orders Data (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Overall KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='availability_test_orders+ (rl)' name='federated.0egu66n0n0x3nb13ddi3w0naufdx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0egu66n0n0x3nb13ddi3w0naufdx].[Calculation_3778731199105302528]' caption='Choose Experiment' datatype='string' name='[Choose Entity (copy)_6029897706276470785]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025-07-02_BH_Speed-vs-Choice-Expansion_Bahrain - TB_BH|10&quot;'>
              <calculation class='tableau' formula='&quot;2025-07-02_BH_Speed-vs-Choice-Expansion_Bahrain - TB_BH|10&quot;' />
            </column>
            <column alias='CVR' caption='Choose Metric' datatype='integer' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='37'>
              <calculation class='tableau' formula='37' />
              <aliases>
                <alias key='1' value='Total Orders' />
                <alias key='2' value='Completed Orders' />
                <alias key='5' value='Fail Rate' />
                <alias key='6' value='% Orders with Contacts' />
                <alias key='11' value='Avg To Customer Time Mins' />
                <alias key='12' value='Avg Promised Delivery Time Mins' />
                <alias key='13' value='Avg Actual Delivery Time Mins' />
                <alias key='14' value='% Orders with DT over 45 Mins' />
                <alias key='23' value='% On Time Orders' />
                <alias key='26' value='Avg Delivery Distance km' />
                <alias key='32' value='Total GMV Eur' />
                <alias key='34' value='% Order Late' />
                <alias key='35' value='DT &lt; 12 mins DTP' />
                <alias key='36' value='AOV (average Order Value Eur)' />
