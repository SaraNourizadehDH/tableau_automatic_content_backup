  </shared-views>
  <actions>
    <edit-parameter-action caption='Parameter1' name='[Action1_C679E9453DCC4A77B64A8A37CD73022D]'>
      <activation type='on-hover' />
      <source dashboard='All Users Overview' type='sheet' />
      <agg-type type='attr' />
      <_.fcp.ParameterActionClearSelection.true...clear-option type='do-nothing' value='s:LROOT:' />
      <params>
        <param name='source-field' value='[federated.0u3a8w80tjcboo120y90w0g3evru].[:Measure Names]' />
        <param name='target-parameter' value='[Parameters].[Parameter 3]' />
      </params>
    </edit-parameter-action>
  </actions>
  <worksheets>
    <worksheet name='Cohort Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run fontname='Tableau Regular'>Æ </run>
            <run fontname='Tableau Regular' fontsize='9'>(&lt;[Parameters].[Parameter 1]&gt;)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='9' italic='true'>This chart visualizes the retention of new users acquired during specific months, showing their activity in subsequent months</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cohort Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GPO&quot;'>
              <calculation class='tableau' formula='&quot;GPO&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru'>
            <column caption='Greater Month' datatype='boolean' name='[Calculation_1844716664408797218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= [cohort_month]' />
            </column>
            <column caption='GMV Per Order' datatype='real' name='[Calculation_224194855166951431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_gmv])/SUM([returned_customer_orders])' />
            </column>
            <column caption='Cohort Metric' datatype='real' name='[Calculation_841610199226773504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN SUM([new_users])&#13;&#10;WHEN &apos;Orders&apos; THEN SUM([returned_customer_orders])&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([returned_customer_gmv])&#13;&#10;//WHEN &apos;Incentive Spend&apos; THEN -[dps_incentive_discount_eur]&#13;&#10;//WHEN &apos;GP&apos; THEN [GP]&#13;&#10;WHEN &apos;Net GP&apos; THEN SUM([Calculation_841610202394591236])&#13;&#10;WHEN &apos;Order Frequency&apos; THEN [Net GP (copy)_1799469553759350795]&#13;&#10;WHEN &apos;GPO&apos; THEN [GMV Per Order (copy)_224194855169228808]&#13;&#10;END' />
            </column>
            <column caption='Net GP' datatype='real' name='[Calculation_841610202394591236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([GP]&lt;0) THEN &#10;&#10;[GP] - IFNULL([dps_incentive_discount_eur],0)&#10;&#10;ELSE &#10;&#10;[GP] - IFNULL([dps_incentive_discount_eur],0)&#10;&#10;END' />
            </column>
            <column caption='GPO' datatype='real' name='[GMV Per Order (copy)_224194855169228808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(GP)/SUM([returned_customer_orders])' />
            </column>
            <column datatype='real' name='[GP]' role='measure' type='quantitative' />
            <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Net GP (copy)_1799469553759350795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_orders])/SUM([new_users])' />
            </column>
            <column caption='Retention Rate' datatype='real' name='[Retention Rate Orders (copy)_224194855160332293]' role='measure' type='quantitative'>
