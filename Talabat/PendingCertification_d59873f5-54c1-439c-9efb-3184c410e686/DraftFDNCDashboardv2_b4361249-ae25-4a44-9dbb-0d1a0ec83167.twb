    <worksheet name='FDNC_Cohort Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>Cohort Analysis</run>
            <run fontname='Tableau Regular'>Æ </run>
            <run fontname='Tableau Regular' fontsize='9'>(&lt;[Parameters].[Parameter 1]&gt;)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='9' italic='true'>This chart visualizes the retention of new users acquired during specific months, showing their activity in subsequent months</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cohort Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GPO&quot;'>
              <calculation class='tableau' formula='&quot;GPO&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru'>
            <column caption='FDNC_Cohor Return Customers GMV' datatype='real' name='[Calculation_1123296299820105729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    IF MAX([cohort_month]=[order_month]) &#10;        THEN &#10;        SUM(([first_new_orders_gmv] - [first_new_orders_gmv] / (1+[New_Incremental_Users])) &#10;        + ([second_orders_first_month_gmv] - [second_orders_first_month_gmv] / (1+[New_Incremental_Orders]))&#10;        )&#10;        ELSE &#10;   &#10;            [Calculation_224194855155343362] * [Calculation_224194855166951431]&#10;        END&#10;    )' />
            </column>
            <column caption='Greater Month' datatype='boolean' name='[Calculation_1844716664408797218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= [cohort_month]' />
            </column>
            <column caption='Retention Rate Orders' datatype='real' name='[Calculation_224194855151603712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_orders])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([returned_customer_orders])  END) })' />
            </column>
            <column caption='FDNC_Cohort Return Customers Orders' datatype='real' name='[Calculation_224194855155343362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;    //    THEN &#10;  //      ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;//        ELSE &#10;              // ([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])&#10;              //    SUM([returned_customer_orders]) * [Retention Rate Orders]&#10; &#10;  //      END&#10;&#10;SUM([Calculation_224194855156355076]) * [Calculation_224194855151603712]' />
            </column>
            <column caption='FDNC_First_Cohort_Month_Orders' datatype='real' name='[Calculation_224194855156355076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[cohort_month],[vertical]:  &#10;SUM(IF ([cohort_month]=[order_month]) &#10;        THEN &#10;        ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;END)&#10; }' />
            </column>
            <column caption='GMV Per Order' datatype='real' name='[Calculation_224194855166951431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_gmv])/SUM([returned_customer_orders])' />
            </column>
            <column caption='FDNC_Cohort Metric' datatype='real' name='[Cohort Metric (copy)_1844716663124791301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN SUM([new_users] - [new_users]/(1+[New_Incremental_Users]) )&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN  &#13;&#10;    (&#13;&#10;&#13;&#10;[Calculation_224194855155343362]&#13;&#10;)&#13;&#10;&#13;&#10;WHEN &apos;Order Frequency&apos; THEN &#13;&#10;[Order Frequency (copy)_224194855162732550]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Net GP&apos; THEN  &#13;&#10;    (&#13;&#10;    (IF MAX([cohort_month]=[order_month]) &#13;&#10;        THEN &#13;&#10;        SUM(([first_new_orders_GP] - [first_new_orders_GP] / (1+[New_Incremental_Users])) + ([second_new_orders_GP] - [second_new_orders_GP] / (1+[New_Incremental_Orders])))&#13;&#10;        - SUM(IFNULL([dps_incentive_discount_eur],0))&#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) - SUM((IFNULL([dps_incentive_discount_eur],0)))&#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) - SUM((IFNULL([dps_incentive_discount_eur],0)))&#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;&#13;&#10;WHEN &apos;GMV&apos; THEN  &#13;&#10;   &#13;&#10;[Calculation_1123296299820105729]&#13;&#10;&#13;&#10;WHEN &apos;GPO&apos; THEN&#13;&#10;&#13;&#10;   (&#13;&#10;    (IF MAX([cohort_month]=[order_month]) &#13;&#10;        THEN &#13;&#10;        SUM(([first_new_orders_GP] - [first_new_orders_GP] / (1+[New_Incremental_Users])) + ([second_new_orders_GP] - [second_new_orders_GP] / (1+[New_Incremental_Orders])))&#13;&#10;        &#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;/&#13;&#10;[Calculation_224194855155343362]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='GPO' datatype='real' name='[GMV Per Order (copy)_224194855169228808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(GP)/SUM([returned_customer_orders])' />
            </column>
            <column datatype='real' name='[GP]' role='measure' type='quantitative' />
            <column datatype='real' name='[New_Incremental_Orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[New_Incremental_Users]' role='measure' type='quantitative' />
            <column caption='FDNC_Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Order Frequency (copy)_224194855162732550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_224194855155343362] /       &#10;SUM([new_users] - [new_users]/(1+[New_Incremental_Users]) )' />
            </column>
            <column caption='Retention Rate' datatype='real' name='[Retention Rate Orders (copy)_224194855160332293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10;WHEN &quot;Orders&quot; THEN&#10;SUM([returned_customer_orders])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([returned_customer_orders])  END) })&#10;&#10;WHEN &quot;Users&quot; THEN&#10;SUM([new_users])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([new_users])  END) })&#10;&#10;&#10;END' />
            </column>
            <column caption='First Month' datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column caption='country_code (copy)' datatype='string' name='[country_code (copy)_2821294105585311744]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dps_incentive_discount_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[first_new_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[first_new_orders_GP]' role='measure' type='quantitative' />
            <column datatype='real' name='[first_new_orders_gmv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[new_users]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1844716664408797218]' derivation='None' name='[none:Calculation_1844716664408797218:nk]' pivot='key' type='nominal' />
            <column-instance column='[cohort_month]' derivation='None' name='[none:cohort_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_code (copy)_2821294105585311744]' derivation='None' name='[none:country_code (copy)_2821294105585311744:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_month]' derivation='None' name='[none:order_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_month]' derivation='None' name='[none:order_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column caption='Order Month' datatype='date' name='[order_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[returned_customer_gmv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[returned_customer_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[second_new_orders_GP]' role='measure' type='quantitative' />
            <column datatype='integer' name='[second_orders_first_month]' role='measure' type='quantitative' />
            <column datatype='real' name='[second_orders_first_month_gmv]' role='measure' type='quantitative' />
            <column-instance column='[Cohort Metric (copy)_1844716663124791301]' derivation='User' name='[usr:Cohort Metric (copy)_1844716663124791301:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[Retention Rate Orders (copy)_224194855160332293]' derivation='User' name='[usr:Retention Rate Orders (copy)_224194855160332293:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0u3a8w80tjcboo120y90w0g3evru].[none:Calculation_1844716664408797218:nk]'>
            <groupfilter function='member' level='[none:Calculation_1844716664408797218:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0u3a8w80tjcboo120y90w0g3evru].[none:vertical:nk]</column>
            <column>[federated.0u3a8w80tjcboo120y90w0g3evru].[none:Calculation_1844716664408797218:nk]</column>
            <column>[federated.0u3a8w80tjcboo120y90w0g3evru].[none:country_code:nk]</column>
            <column>[federated.0u3a8w80tjcboo120y90w0g3evru].[none:order_month:qk]</column>
            <column>[federated.0u3a8w80tjcboo120y90w0g3evru].[none:country_code (copy)_2821294105585311744:nk]</column>
