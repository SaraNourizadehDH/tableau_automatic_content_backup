    <datasource caption='BigQuery' inline='true' name='federated.0u3a8w80tjcboo120y90w0g3evru' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.06tedhq15fc16x197e5wc10qf28o'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='muhammad.riaz@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.06tedhq15fc16x197e5wc10qf28o' name='Custom SQL Query' type='text'>WITH 
monthly_tgo_orders as(
  select 
  --account_id,
  CASE
        WHEN o.country_code IN (&apos;IQ&apos;) AND city_name IN (&apos;Baghdad&apos;, &apos;Basra&apos;) THEN &apos;IQ-BGH&apos;
        WHEN o.country_code IN (&apos;IQ&apos;) THEN &apos;IQ-KRI&apos; 
        ELSE o.country_code 
    END AS country_code,
  DATE_TRUNC(order_date, month) as order_month,
  
    CASE 
            WHEN v.vertical=&apos;food&apos; THEN &apos;Food&apos;
            WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos; THEN &apos;tMart&apos;
            WHEN v.vertical IN (&apos;flowers&apos;,&apos;grocery&apos;,&apos;pet shop&apos;,&apos;pharmacy&apos;,&apos;cosmetics&apos;,&apos;electronics&apos;) THEN &apos;LS&apos; 
      END vertical,
  count(order_id) as monthly_tgo_orders,
  SUM(o.basket_amount_eur+o.delivery_fee_amount_eur+o.service_fee_amount_eur) as monthly_gmv_eur,
  sum(delivery_fee_amount_eur) as monthly_delivery_fee_eur 
  FROM `tlb-data-prod.data_platform.fct_order_info` o
    
    LEFT JOIN `tlb-data-prod.data_platform.dim_location` loc ON loc.location_id = o.delivery_location_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` v on o.vertical_id=v.vertical_id
        WHERE
        o.is_successful IS TRUE
        AND o.order_date &gt;&gt;= &apos;2023-08-01&apos;
        AND o.delivery_arrangement = &apos;TGO&apos;
GROUP by 1,2,3
)

,order_lines as(
SELECT 

  
  CASE
        WHEN RIGHT(ol.global_entity_id,2) IN (&apos;IQ&apos;) AND city_name IN (&apos;Baghdad&apos;, &apos;Basra&apos;) THEN &apos;IQ-BGH&apos;
        WHEN RIGHT(ol.global_entity_id,2) IN (&apos;IQ&apos;) THEN &apos;IQ-KRI&apos; 
        ELSE RIGHT(ol.global_entity_id,2) 
    END AS country_code,
  oi.order_id,
  SUM(total_price_paid_net_lc) as total_sales_revenue,
  --SUM(total_price_paid_net_lc) - SUM(cogs_lc) as total_front_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(FM) as total_front_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(BM) as total_back_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(Shrink) as total_shrink_margin_cost,
  SUM(total_price_paid_net_lc) * MAX(Packaging) as total_packaging_cost,
  
  (SUM(total_price_paid_net_lc) * MAX(FM)) + (SUM(total_price_paid_net_lc) * MAX(BM)) + (SUM(total_price_paid_net_lc) * MAX(Shrink)) +
  (SUM(total_price_paid_net_lc) * MAX(Packaging))  as total_product_margin,
  

  MAX(FM),
  MAX(BM),
  MAX(Shrink),
  MAX(Packaging),

FROM
`tlb-data-prod.data_platform_dmart.fct_customer_order_lines` ol
LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` oi on ol.order_id=cast(oi.order_id as string)
LEFT JOIN `tlb-data-prod.data_platform.dim_location` loc ON loc.location_id = oi.delivery_location_id

  LEFT JOIN `tlb-data-dev.data_playground_regional_pricing.tmart_analysis_dashboard_pnl_input_table` p on 
    DATE_TRUNC(ol.date,month)=p.Month 
    AND RIGHT(ol.global_entity_id,2)=p.country

--WHERE date(date) &gt;&gt;= (select month from variables)
WHERE date(date) between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
--WHERE date(date) &gt;&gt;= &apos;2024-05-01&apos; and date(date) &gt;&gt;= &apos;2024-05-30&apos;
--And global_entity_id = &apos;TB_AE&apos;
AND oi.is_successful
AND oi.is_darkstore
GROUP BY 1,2
)

,orders_data as (
  select 
    
    io.country_code,
    io.order_id,
    io.order_date,
    DATE_TRUNC(order_date,month) as order_month,
    account_id,
    --vertical_id,
    vertical,
    is_fdnc_order,
    is_tpro_order,
    ROUND(SAFE_DIVIDE(gmv_amount_lc, (exchange_rate)),3) as gmv_amount_eur,
    ROW_NUMBER() OVER (Partition BY io.country_Code,account_id,vertical order by order_date) AS order_rank,
    
    CASE WHEN vertical = &apos;tMart&apos; then  
    (ROUND(SAFE_DIVIDE(delivery_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(service_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(total_product_margin, (exchange_rate)),3) ) 
    ELSE 
      (ROUND(SAFE_DIVIDE(delivery_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(service_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(commission_local, (exchange_rate)),3) ) 
      
      end order_revenue_eur,

      
    CASE 
      WHEN is_tpro_order THEN 0 
      ELSE ROUND(SAFE_DIVIDE(talabat_delivery_fee_opportunity_cost_local, (exchange_rate)),3)   END dps_incentive_discount_eur

    FROM `tlb-data-dev.data_playground_regional_pricing.delivery_fee_incentivized_orders` io
    LEFT JOIN order_lines ol 
      on io.order_id=ol.order_id
      AND io.country_code=ol.country_code
     
  
  
  WHERE order_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    
    AND is_fdnc_order
    AND delivery_fee_amount_lc=0
    AND delivery_arrangement =&apos;TGO&apos;
)


,monthly_opportunity_cost AS (
  SELECT 
    order_month,
    country_code,
    vertical,
    --account_id,
    SUM(dps_incentive_discount_eur) as dps_incentive_discount_eur
  FROM
    orders_data 
    
    
  GROUP BY 
    1,2,3
)

,first_order AS (
  SELECT 
    oi.country_code,
    oi.account_id,
    oi.vertical,

    MIN(order_month) AS first_order_month,
    --SUM(dps_incentive_discount_eur) as dps_incentive_discount_eur,
    
    COUNT(CASE WHEN order_rank=1 THEN oi.order_id END) as first_new_orders,
    SUM(CASE WHEN order_rank=1 THEN oi.gmv_amount_eur END) as first_new_orders_gmv,
    
    SUM(CASE WHEN order_rank=1 THEN order_revenue_eur END) as first_new_orders_revenue_eur,
    
  FROM
    orders_data oi
  
    
    
  GROUP BY 
    1,2,3
)

-- select first_order_month,
-- sum(first_new_orders) as first_new_orders, sum(first_new_orders_gmv) as first_new_orders_gmv

-- from first_order where country_code=&apos;AE&apos; group by 1 order by 1 desc



,orders AS (
  SELECT
    DATE_TRUNC(oi.order_date, MONTH) AS order_month,
      case 
        when oi.country_code in (&apos;IQ&apos;) AND dps.city_name in (&apos;Baghdad&apos;,&apos;Basra&apos;) then &apos;IQ - Baghdad&apos;
        when oi.country_code in (&apos;IQ&apos;) then &apos;IQ - KRI&apos; 
        ELSE oi.country_code end country_code,
    oi.account_id,
    
        CASE 
            WHEN v.vertical=&apos;food&apos; THEN &apos;Food&apos;
            WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos; THEN &apos;tMart&apos;
            WHEN v.vertical IN (&apos;flowers&apos;,&apos;grocery&apos;,&apos;pet shop&apos;,&apos;pharmacy&apos;,&apos;cosmetics&apos;,&apos;electronics&apos;) THEN &apos;LS&apos; 
      END vertical,
    COUNT(oi.order_id) AS orders,
    SUM(oi.basket_amount_eur+oi.delivery_fee_amount_eur+oi.service_fee_amount_eur) as gmv,
    
    

      SUM(IFNULL((CASE WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos;  then  
      (delivery_fee_amount_eur+service_fee_amount_eur+ROUND(SAFE_DIVIDE(total_product_margin, (exchange_rate)),3)) 
      ELSE 
      (delivery_fee_amount_eur+service_fee_amount_eur+commission_eur)
      end),0)) order_revenue_eur,
      


    MAX(oi.order_date) as last_order_date,
    
  FROM
    `tlb-data-prod.data_platform.fct_order_info` oi
  
  LEFT JOIN order_lines ol 
      on oi.order_id=ol.order_id
      AND oi.country_code=ol.country_code
    
  LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` v on oi.vertical_id=v.vertical_id
  LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders`  dps 
    ON oi.country_code=UPPER(dps.country_code) 
    AND CAST(oi.order_id AS STRING)=dps.platform_order_code
  WHERE 
     oi.order_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    AND  dps.created_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    AND oi.is_successful
    AND delivery_arrangement =&apos;TGO&apos;
  GROUP BY
    1, 2, 3,4
)

SELECT 
  fo.first_order_month AS cohort_month,
  o.order_month,
  o.country_code,
  fo.vertical,
  COUNT(DISTINCT fo.account_id) AS new_users,
  
  --SUM(new_orders) as new_orders,
  SUM(first_new_orders) as first_new_orders,
  --SUM(second_new_orders) as second_new_orders,
  SUM(first_new_orders_gmv) as first_new_orders_gmv,

  SUM(orders) - SUM(first_new_orders) as second_orders_first_month,

  SUM(gmv) - SUM(first_new_orders_gmv)   as second_orders_first_month_gmv,
  
  COUNT(DISTINCT CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.account_id END) AS returned_customers,

  
  (MAX(CPO.CPO_Euro) * SUM(first_new_orders)) + SUM(first_new_orders_revenue_eur) first_new_orders_GP,
  (MAX(CPO.CPO_Euro) * SUM(orders - first_new_orders)) + SUM(order_revenue_eur - first_new_orders_revenue_eur) as second_new_orders_GP,


  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.orders ELSE 0 END) AS returned_customer_orders,
  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.gmv ELSE 0 END) AS returned_customer_gmv,
  --SUM(delivery_)
  SUM(o.orders) AS returned_customer_orders,
  SUM(o.gmv) AS returned_customer_gmv,
  
  MAX( CASE WHEN o.order_month = fo.first_order_month THEN dps_incentive_discount_eur END) AS dps_incentive_discount_eur,
  MAX(CPO.CPO_Euro) as CPO_Value,
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) as CPO,
  
  -- SUM(service_fee_amount_eur) as service_fee_amount_eur,
  -- SUM(delivery_fee_amount_eur) as delivery_fee_amount_eur,
  -- SUM(commission_eur) as commission_eur,
  
  
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) + SUM(order_revenue_eur)  as GP,

  MAX(last_order_date) as last_order_date,
  MAX(f.New_Incremental_Users) as New_Incremental_Users,
  MAX(f.New_Incremental_Orders) as New_Incremental_Orders,

  MAX(monthly_tgo_orders) as monthly_tgo_orders,
  MAX(monthly_gmv_eur) as monthly_gmv_eur,
  MAX(monthly_delivery_fee_eur) as monthly_delivery_fee_eur 
  
    

FROM 
  first_order fo
LEFT JOIN 
  orders o ON fo.account_id = o.account_id AND fo.country_code=o.country_code AND fo.vertical=o.vertical
LEFT JOIN 
  `tlb-data-dev.data_playground_regional_pricing.monthly_fully_loaded_cpo_table` CPO on 
   o.order_month=CPO.month and o.country_code=CPO.Country_Code and CPO.Vertical=o.vertical
LEFT JOIN
   `tlb-data-dev.data_playground_regional_pricing.fdnc_impact_percentages_by_country_table` f 
   on o.country_code=f.country AND o.vertical = f.vertical

LEFT JOIN monthly_tgo_orders mo 
  ON  o.order_month=mo.order_month AND o.vertical=mo.vertical AND o.country_code=mo.country_code

LEFT JOIN monthly_opportunity_cost oc 
  ON fo.first_order_month=oc.order_month AND fo.vertical=oc.vertical AND fo.country_code=oc.country_code --AND fo.account_id=oc.account_id

WHERE 1=1
  AND fo.country_code IS NOT NULL

GROUP BY 
  1,2,3,4
-- ORDER BY 
--   fo.first_order_month, o.order_month, o.country_code</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.06tedhq15fc16x197e5wc10qf28o' name='Custom SQL Query' type='text'>WITH 
monthly_tgo_orders as(
  select 
  --account_id,
  CASE
        WHEN o.country_code IN (&apos;IQ&apos;) AND city_name IN (&apos;Baghdad&apos;, &apos;Basra&apos;) THEN &apos;IQ-BGH&apos;
        WHEN o.country_code IN (&apos;IQ&apos;) THEN &apos;IQ-KRI&apos; 
        ELSE o.country_code 
    END AS country_code,
  DATE_TRUNC(order_date, month) as order_month,
  
    CASE 
            WHEN v.vertical=&apos;food&apos; THEN &apos;Food&apos;
            WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos; THEN &apos;tMart&apos;
            WHEN v.vertical IN (&apos;flowers&apos;,&apos;grocery&apos;,&apos;pet shop&apos;,&apos;pharmacy&apos;,&apos;cosmetics&apos;,&apos;electronics&apos;) THEN &apos;LS&apos; 
      END vertical,
  count(order_id) as monthly_tgo_orders,
  SUM(o.basket_amount_eur+o.delivery_fee_amount_eur+o.service_fee_amount_eur) as monthly_gmv_eur,
  sum(delivery_fee_amount_eur) as monthly_delivery_fee_eur 
  FROM `tlb-data-prod.data_platform.fct_order_info` o
    
    LEFT JOIN `tlb-data-prod.data_platform.dim_location` loc ON loc.location_id = o.delivery_location_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` v on o.vertical_id=v.vertical_id
        WHERE
        o.is_successful IS TRUE
        AND o.order_date &gt;&gt;= &apos;2023-08-01&apos;
        AND o.delivery_arrangement = &apos;TGO&apos;
GROUP by 1,2,3
)

,order_lines as(
SELECT 

  
  CASE
        WHEN RIGHT(ol.global_entity_id,2) IN (&apos;IQ&apos;) AND city_name IN (&apos;Baghdad&apos;, &apos;Basra&apos;) THEN &apos;IQ-BGH&apos;
        WHEN RIGHT(ol.global_entity_id,2) IN (&apos;IQ&apos;) THEN &apos;IQ-KRI&apos; 
        ELSE RIGHT(ol.global_entity_id,2) 
    END AS country_code,
  oi.order_id,
  SUM(total_price_paid_net_lc) as total_sales_revenue,
  --SUM(total_price_paid_net_lc) - SUM(cogs_lc) as total_front_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(FM) as total_front_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(BM) as total_back_margin_revenue,
  SUM(total_price_paid_net_lc) * MAX(Shrink) as total_shrink_margin_cost,
  SUM(total_price_paid_net_lc) * MAX(Packaging) as total_packaging_cost,
  
  (SUM(total_price_paid_net_lc) * MAX(FM)) + (SUM(total_price_paid_net_lc) * MAX(BM)) + (SUM(total_price_paid_net_lc) * MAX(Shrink)) +
  (SUM(total_price_paid_net_lc) * MAX(Packaging))  as total_product_margin,
  

  MAX(FM),
  MAX(BM),
  MAX(Shrink),
  MAX(Packaging),

FROM
`tlb-data-prod.data_platform_dmart.fct_customer_order_lines` ol
LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` oi on ol.order_id=cast(oi.order_id as string)
LEFT JOIN `tlb-data-prod.data_platform.dim_location` loc ON loc.location_id = oi.delivery_location_id

  LEFT JOIN `tlb-data-dev.data_playground_regional_pricing.tmart_analysis_dashboard_pnl_input_table` p on 
    DATE_TRUNC(ol.date,month)=p.Month 
    AND RIGHT(ol.global_entity_id,2)=p.country

--WHERE date(date) &gt;&gt;= (select month from variables)
WHERE date(date) between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
--WHERE date(date) &gt;&gt;= &apos;2024-05-01&apos; and date(date) &gt;&gt;= &apos;2024-05-30&apos;
--And global_entity_id = &apos;TB_AE&apos;
AND oi.is_successful
AND oi.is_darkstore
GROUP BY 1,2
)

,orders_data as (
  select 
    
    io.country_code,
    io.order_id,
    io.order_date,
    DATE_TRUNC(order_date,month) as order_month,
    account_id,
    --vertical_id,
    vertical,
    is_fdnc_order,
    is_tpro_order,
    ROUND(SAFE_DIVIDE(gmv_amount_lc, (exchange_rate)),3) as gmv_amount_eur,
    ROW_NUMBER() OVER (Partition BY io.country_Code,account_id,vertical order by order_date) AS order_rank,
    
    CASE WHEN vertical = &apos;tMart&apos; then  
    (ROUND(SAFE_DIVIDE(delivery_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(service_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(total_product_margin, (exchange_rate)),3) ) 
    ELSE 
      (ROUND(SAFE_DIVIDE(delivery_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(service_fee_amount_lc, (exchange_rate)),3) +
      ROUND(SAFE_DIVIDE(commission_local, (exchange_rate)),3) ) 
      
      end order_revenue_eur,

      
    CASE 
      WHEN is_tpro_order THEN 0 
      ELSE ROUND(SAFE_DIVIDE(talabat_delivery_fee_opportunity_cost_local, (exchange_rate)),3)   END dps_incentive_discount_eur

    FROM `tlb-data-dev.data_playground_regional_pricing.delivery_fee_incentivized_orders` io
    LEFT JOIN order_lines ol 
      on io.order_id=ol.order_id
      AND io.country_code=ol.country_code
     
  
  
  WHERE order_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    
    AND is_fdnc_order
    AND delivery_fee_amount_lc=0
    AND delivery_arrangement =&apos;TGO&apos;
)


,monthly_opportunity_cost AS (
  SELECT 
    order_month,
    country_code,
    vertical,
    --account_id,
    SUM(dps_incentive_discount_eur) as dps_incentive_discount_eur
  FROM
    orders_data 
    
    
  GROUP BY 
    1,2,3
)

,first_order AS (
  SELECT 
    oi.country_code,
    oi.account_id,
    oi.vertical,

    MIN(order_month) AS first_order_month,
    --SUM(dps_incentive_discount_eur) as dps_incentive_discount_eur,
    
    COUNT(CASE WHEN order_rank=1 THEN oi.order_id END) as first_new_orders,
    SUM(CASE WHEN order_rank=1 THEN oi.gmv_amount_eur END) as first_new_orders_gmv,
    
    SUM(CASE WHEN order_rank=1 THEN order_revenue_eur END) as first_new_orders_revenue_eur,
    
  FROM
    orders_data oi
  
    
    
  GROUP BY 
    1,2,3
)

-- select first_order_month,
-- sum(first_new_orders) as first_new_orders, sum(first_new_orders_gmv) as first_new_orders_gmv

-- from first_order where country_code=&apos;AE&apos; group by 1 order by 1 desc



,orders AS (
  SELECT
    DATE_TRUNC(oi.order_date, MONTH) AS order_month,
      case 
        when oi.country_code in (&apos;IQ&apos;) AND dps.city_name in (&apos;Baghdad&apos;,&apos;Basra&apos;) then &apos;IQ - Baghdad&apos;
        when oi.country_code in (&apos;IQ&apos;) then &apos;IQ - KRI&apos; 
        ELSE oi.country_code end country_code,
    oi.account_id,
    
        CASE 
            WHEN v.vertical=&apos;food&apos; THEN &apos;Food&apos;
            WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos; THEN &apos;tMart&apos;
            WHEN v.vertical IN (&apos;flowers&apos;,&apos;grocery&apos;,&apos;pet shop&apos;,&apos;pharmacy&apos;,&apos;cosmetics&apos;,&apos;electronics&apos;) THEN &apos;LS&apos; 
      END vertical,
    COUNT(oi.order_id) AS orders,
    SUM(oi.basket_amount_eur+oi.delivery_fee_amount_eur+oi.service_fee_amount_eur) as gmv,
    
    

      SUM(IFNULL((CASE WHEN v.vertical !=&apos;food&apos; AND v.sub_vertical=&apos;darkstore&apos;  then  
      (delivery_fee_amount_eur+service_fee_amount_eur+ROUND(SAFE_DIVIDE(total_product_margin, (exchange_rate)),3)) 
      ELSE 
      (delivery_fee_amount_eur+service_fee_amount_eur+commission_eur)
      end),0)) order_revenue_eur,
      


    MAX(oi.order_date) as last_order_date,
    
  FROM
    `tlb-data-prod.data_platform.fct_order_info` oi
  
  LEFT JOIN order_lines ol 
      on oi.order_id=ol.order_id
      AND oi.country_code=ol.country_code
    
  LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` v on oi.vertical_id=v.vertical_id
  LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders`  dps 
    ON oi.country_code=UPPER(dps.country_code) 
    AND CAST(oi.order_id AS STRING)=dps.platform_order_code
  WHERE 
     oi.order_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    AND  dps.created_date between&apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), interval 2 day)
    AND oi.is_successful
    AND delivery_arrangement =&apos;TGO&apos;
  GROUP BY
    1, 2, 3,4
)

SELECT 
  fo.first_order_month AS cohort_month,
  o.order_month,
  o.country_code,
  fo.vertical,
  COUNT(DISTINCT fo.account_id) AS new_users,
  
  --SUM(new_orders) as new_orders,
  SUM(first_new_orders) as first_new_orders,
  --SUM(second_new_orders) as second_new_orders,
  SUM(first_new_orders_gmv) as first_new_orders_gmv,

  SUM(orders) - SUM(first_new_orders) as second_orders_first_month,

  SUM(gmv) - SUM(first_new_orders_gmv)   as second_orders_first_month_gmv,
  
  COUNT(DISTINCT CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.account_id END) AS returned_customers,

  
  (MAX(CPO.CPO_Euro) * SUM(first_new_orders)) + SUM(first_new_orders_revenue_eur) first_new_orders_GP,
  (MAX(CPO.CPO_Euro) * SUM(orders - first_new_orders)) + SUM(order_revenue_eur - first_new_orders_revenue_eur) as second_new_orders_GP,


  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.orders ELSE 0 END) AS returned_customer_orders,
  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.gmv ELSE 0 END) AS returned_customer_gmv,
  --SUM(delivery_)
  SUM(o.orders) AS returned_customer_orders,
  SUM(o.gmv) AS returned_customer_gmv,
  
  MAX( CASE WHEN o.order_month = fo.first_order_month THEN dps_incentive_discount_eur END) AS dps_incentive_discount_eur,
  MAX(CPO.CPO_Euro) as CPO_Value,
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) as CPO,
  
  -- SUM(service_fee_amount_eur) as service_fee_amount_eur,
  -- SUM(delivery_fee_amount_eur) as delivery_fee_amount_eur,
  -- SUM(commission_eur) as commission_eur,
  
  
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) + SUM(order_revenue_eur)  as GP,

  MAX(last_order_date) as last_order_date,
  MAX(f.New_Incremental_Users) as New_Incremental_Users,
  MAX(f.New_Incremental_Orders) as New_Incremental_Orders,

  MAX(monthly_tgo_orders) as monthly_tgo_orders,
  MAX(monthly_gmv_eur) as monthly_gmv_eur,
  MAX(monthly_delivery_fee_eur) as monthly_delivery_fee_eur 
  
    

FROM 
  first_order fo
LEFT JOIN 
  orders o ON fo.account_id = o.account_id AND fo.country_code=o.country_code AND fo.vertical=o.vertical
LEFT JOIN 
  `tlb-data-dev.data_playground_regional_pricing.monthly_fully_loaded_cpo_table` CPO on 
   o.order_month=CPO.month and o.country_code=CPO.Country_Code and CPO.Vertical=o.vertical
LEFT JOIN
   `tlb-data-dev.data_playground_regional_pricing.fdnc_impact_percentages_by_country_table` f 
   on o.country_code=f.country AND o.vertical = f.vertical

LEFT JOIN monthly_tgo_orders mo 
  ON  o.order_month=mo.order_month AND o.vertical=mo.vertical AND o.country_code=mo.country_code

LEFT JOIN monthly_opportunity_cost oc 
  ON fo.first_order_month=oc.order_month AND fo.vertical=oc.vertical AND fo.country_code=oc.country_code --AND fo.account_id=oc.account_id

WHERE 1=1
  AND fo.country_code IS NOT NULL

GROUP BY 
  1,2,3,4
-- ORDER BY 
--   fo.first_order_month, o.order_month, o.country_code</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
