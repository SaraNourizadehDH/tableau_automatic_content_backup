          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:MoM New Users (copy)_1844716662741729280:qk]&quot;' value='1st Orders' />
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:MoM New Users (copy)_1844716663118389251:qk]&quot;' value='Total Users Acquired  ' />
