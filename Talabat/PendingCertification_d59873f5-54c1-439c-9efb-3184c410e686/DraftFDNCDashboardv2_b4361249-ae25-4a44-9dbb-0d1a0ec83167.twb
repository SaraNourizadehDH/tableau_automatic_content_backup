            <column-instance column='[FDNC_MoM First New Orders (copy)_1844716664010522632]' derivation='Sum' name='[sum:FDNC_MoM First New Orders (copy)_1844716664010522632:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FDNC_MoM First New Orders (copy)_1844716664012750859]' derivation='Sum' name='[sum:FDNC_MoM First New Orders (copy)_1844716664012750859:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FDNC_MoM First New Orders GMV (copy)_1844716664376066077]' derivation='Sum' name='[sum:FDNC_MoM First New Orders GMV (copy)_1844716664376066077:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FDNC_MoM Second New Orders (copy)_1844716664013045772]' derivation='Sum' name='[sum:FDNC_MoM Second New Orders (copy)_1844716664013045772:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FDNC_MoM Second New Orders GMV (copy)_1844716664376205342]' derivation='Sum' name='[sum:FDNC_MoM Second New Orders GMV (copy)_1844716664376205342:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MoM First New Orders (copy)_1844716663119605764]' derivation='Sum' name='[sum:MoM First New Orders (copy)_1844716663119605764:qk]' pivot='key' type='quantitative' />
