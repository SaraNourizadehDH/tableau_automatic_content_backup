          <style-rule element='cell'>
            <format attr='height' field='[federated.0u3a8w80tjcboo120y90w0g3evru].[none:order_month:ok]' value='94' />
            <format attr='width' field='[federated.0u3a8w80tjcboo120y90w0g3evru].[none:cohort_month:ok]' value='136' />
            <format attr='width' field='[federated.0u3a8w80tjcboo120y90w0g3evru].[none:order_month:ok]' value='107' />
            <format attr='height' field='[federated.0u3a8w80tjcboo120y90w0g3evru].[none:cohort_month:ok]' value='41' />
            <format attr='text-format' field='[federated.0u3a8w80tjcboo120y90w0g3evru].[usr:Retention Rate Orders (copy)_224194855160332293:qk]' value='p0.0%' />
