    <worksheet name='Regional Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>&lt;Sheet Name&gt; </run>
            <run fontname='Tableau Regular' fontsize='8'>(Euros)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0u3a8w80tjcboo120y90w0g3evru' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='GMV Months For ROI' datatype='integer' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
            </column>
            <column alias='Total Users Acquired' caption='Capture Measure Name' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;Total Users Acquired&quot;'>
              <calculation class='tableau' formula='&quot;Total Users Acquired&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0u3a8w80tjcboo120y90w0g3evru'>
            <column caption='FDNC_6 Months GMV' datatype='real' name='[6 Months GMV (copy)_1844716664480362534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[order_month],[vertical]: &#10;(&#10;IF MAX(DATEDIFF(&apos;month&apos;, [cohort_month], [order_month])) &lt; 6 AND MAX([Calculation_1844716664408797218]) THEN &#10;&#10;   (&#10;   &#10;    [Calculation_1123296299820105729] &#10;   &#10;   )&#10;&#10;    &#10;ELSE &#10;0&#10;END&#10;)&#10;}' />
            </column>
            <column caption='FDNC_CPA' datatype='real' name='[CPA (copy)_1844716664013463565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/SUM([MoM New Users (copy)_1844716663118389251])' />
            </column>
            <column caption='FDNC_Cohor Return Customers GMV' datatype='real' name='[Calculation_1123296299820105729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    IF MAX([cohort_month]=[order_month]) &#10;        THEN &#10;        SUM(([first_new_orders_gmv] - [first_new_orders_gmv] / (1+[New_Incremental_Users])) &#10;        + ([second_orders_first_month_gmv] - [second_orders_first_month_gmv] / (1+[New_Incremental_Orders]))&#10;        )&#10;        ELSE &#10;   &#10;            [Calculation_224194855155343362] * [Calculation_224194855166951431]&#10;        END&#10;    )' />
            </column>
            <column caption='%Order Share' datatype='real' default-format='p0.00%' name='[Calculation_17592228894392320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MoM New Users (copy)_1799469553720156164])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
            </column>
            <column caption='Definitation' datatype='string' name='[Calculation_17592228900638722]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 3]&#10;WHEN &apos;FDNC Spend&apos; THEN &quot;Total opportunity Cost by FDNC&quot;&#10;ELSE &quot;TBA&quot;&#10;END' />
            </column>
            <column caption='% Impact on DF' datatype='real' default-format='p0.00%' name='[Calculation_17592229188472837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/(SUM([MoM tGo Orders (copy)_17592229177311236])+SUM([dps_incentive_discount_eur]))' />
            </column>
            <column caption='CPA' datatype='real' name='[Calculation_1799469553708007424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/SUM([Calculation_841610203003039749])' />
            </column>
            <column caption='ROI' datatype='real' name='[Calculation_1799469553722785798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1844716664402354208])/SUM([dps_incentive_discount_eur])' />
            </column>
            <column caption='6 Months GMV' datatype='real' name='[Calculation_1844716664402354208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[vertical] : SUM(IF DATEDIFF(&apos;month&apos;, [cohort_month], [order_month]) &lt; [Parameters].[Parameter 2] AND [order_month]&gt;=[cohort_month] THEN [returned_customer_gmv] ELSE 0 END) }' />
            </column>
            <column caption='Greater Month' datatype='boolean' name='[Calculation_1844716664408797218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= [cohort_month]' />
            </column>
            <column caption='FDNC_ROI' datatype='real' name='[Calculation_1844716664480948263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([6 Months GMV (copy)_1844716664480362534])/SUM([dps_incentive_discount_eur])' />
            </column>
            <column caption='Retention Rate Orders' datatype='real' name='[Calculation_224194855151603712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_orders])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([returned_customer_orders])  END) })' />
            </column>
            <column caption='FDNC_Cohort Return Customers Orders' datatype='real' name='[Calculation_224194855155343362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;    //    THEN &#10;  //      ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;//        ELSE &#10;              // ([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])&#10;              //    SUM([returned_customer_orders]) * [Retention Rate Orders]&#10; &#10;  //      END&#10;&#10;SUM([Calculation_224194855156355076]) * [Calculation_224194855151603712]' />
            </column>
            <column caption='FDNC_First_Cohort_Month_Orders' datatype='real' name='[Calculation_224194855156355076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[cohort_month],[vertical]:  &#10;SUM(IF ([cohort_month]=[order_month]) &#10;        THEN &#10;        ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;END)&#10; }' />
            </column>
            <column caption='GMV Per Order' datatype='real' name='[Calculation_224194855166951431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returned_customer_gmv])/SUM([returned_customer_orders])' />
            </column>
            <column caption='MoM New Users' datatype='integer' name='[Calculation_841610203003039749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [new_users] END' />
            </column>
            <column caption='FDNC_6 Months Orders' datatype='real' name='[FDNC_6 Months GMV (copy)_1123296299809603584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[order_month],[vertical]: &#10;(&#10;IF MAX(DATEDIFF(&apos;month&apos;, [cohort_month], [order_month])) &lt; 6 AND MAX([Calculation_1844716664408797218]) THEN &#10;&#10;   (&#10;   &#10;    [Calculation_224194855155343362] &#10;   &#10;   )&#10;&#10;    &#10;ELSE &#10;0&#10;END&#10;)&#10;}' />
            </column>
            <column caption='FDNC_CPIO (over 6 months)' datatype='real' name='[FDNC_ROI (copy)_1123296299822800898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/SUM([FDNC_6 Months GMV (copy)_1123296299809603584])' />
            </column>
            <column datatype='real' name='[GP]' role='measure' type='quantitative' />
            <column caption='MoM New Users GMV' datatype='real' name='[MoM New Users (copy)_1799469553719791619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_gmv] END' />
            </column>
            <column caption='MoM New Users Orders' datatype='integer' name='[MoM New Users (copy)_1799469553720156164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_orders] END' />
            </column>
            <column caption='FDNC_MoM New Users' datatype='real' name='[MoM New Users (copy)_1844716663118389251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[new_users] - [new_users]/(1+[New_Incremental_Users]) &#10;END' />
            </column>
            <column caption='MoM New Users GP' datatype='real' name='[MoM New Users GMV (copy)_1844716664375435292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then GP END' />
            </column>
            <column caption='MoM tGo Orders' datatype='integer' name='[MoM New Users Orders (copy)_17592229174857731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [monthly_tgo_orders] END' />
            </column>
            <column caption='MoM tGo Orders DF' datatype='real' name='[MoM tGo Orders (copy)_17592229177311236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [order_month]=[cohort_month] then [monthly_delivery_fee_eur] END' />
            </column>
            <column datatype='real' name='[New_Incremental_Orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[New_Incremental_Users]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_17592228900638722]' derivation='Attribute' name='[attr:Calculation_17592228900638722:nk]' pivot='key' type='nominal' />
            <column caption='First Month' datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column caption='country_code (copy)' datatype='string' name='[country_code (copy)_2821294105585311744]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dps_incentive_discount_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[first_new_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[first_new_orders_gmv]' role='measure' type='quantitative' />
            <column-instance column='[dps_incentive_discount_eur]' derivation='Min' name='[min:dps_incentive_discount_eur:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[monthly_delivery_fee_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[monthly_tgo_orders]' role='measure' type='quantitative' />
            <column-instance column='[order_month]' derivation='MY' name='[my:order_month:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[new_users]' role='measure' type='quantitative' />
            <column-instance column='[country_code (copy)_2821294105585311744]' derivation='None' name='[none:country_code (copy)_2821294105585311744:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_month]' derivation='None' name='[none:order_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column caption='Order Month' datatype='date' name='[order_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[returned_customer_gmv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[returned_customer_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[second_orders_first_month]' role='measure' type='quantitative' />
            <column datatype='real' name='[second_orders_first_month_gmv]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_841610203003039749]' derivation='Sum' name='[sum:Calculation_841610203003039749:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MoM New Users (copy)_1799469553719791619]' derivation='Sum' name='[sum:MoM New Users (copy)_1799469553719791619:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MoM New Users (copy)_1799469553720156164]' derivation='Sum' name='[sum:MoM New Users (copy)_1799469553720156164:qk]' pivot='key' type='quantitative' />
