        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_gmv] END' />
      </column>
      <column caption='MoM New Users Orders' datatype='integer' name='[MoM New Users (copy)_1799469553720156164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_orders] END' />
      </column>
      <column caption='MoM First New Orders' datatype='integer' name='[MoM New Users (copy)_1844716662741729280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [first_new_orders] END' />
