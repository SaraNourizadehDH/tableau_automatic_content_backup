          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[usr:MoM New Users Orders (copy)_1799469553730289674:qk]&quot;' value='Incremental Orders' />
        </aliases>
      </column>
      <column caption='FDNC_CPA' datatype='real' name='[CPA (copy)_1844716664013463565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/SUM([MoM New Users (copy)_1844716663118389251])' />
      </column>
      <column caption='FDNC_Cohor Return Customers GMV' datatype='real' name='[Calculation_1123296299820105729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    IF MAX([cohort_month]=[order_month]) &#10;        THEN &#10;        SUM(([first_new_orders_gmv] - [first_new_orders_gmv] / (1+[New_Incremental_Users])) &#10;        + ([second_orders_first_month_gmv] - [second_orders_first_month_gmv] / (1+[New_Incremental_Orders]))&#10;        )&#10;        ELSE &#10;   &#10;            [Calculation_224194855155343362] * [Calculation_224194855166951431]&#10;        END&#10;    )' />
      </column>
      <column caption='%Order Share' datatype='real' default-format='p0.00%' name='[Calculation_17592228894392320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MoM New Users (copy)_1799469553720156164])/SUM([MoM New Users Orders (copy)_17592229174857731])' />
      </column>
      <column caption='Definitation' datatype='string' name='[Calculation_17592228900638722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 3]&#10;WHEN &apos;FDNC Spend&apos; THEN &quot;Total opportunity Cost by FDNC&quot;&#10;ELSE &quot;TBA&quot;&#10;END' />
      </column>
      <column caption='% Impact on DF' datatype='real' default-format='p0.00%' name='[Calculation_17592229188472837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/(SUM([MoM tGo Orders (copy)_17592229177311236])+SUM([dps_incentive_discount_eur]))' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_1799469553708007424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_incentive_discount_eur])/SUM([Calculation_841610203003039749])' />
      </column>
      <column caption='ROI' datatype='real' name='[Calculation_1799469553722785798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1844716664402354208])/SUM([dps_incentive_discount_eur])' />
      </column>
      <column caption='Incremental Users' datatype='real' name='[Calculation_1799469553729581064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([new_users]) * MAX([incremental_users_per])&#13;&#10;SUM([new_users]) * 0.16' />
      </column>
      <column caption='Same Month' datatype='boolean' name='[Calculation_1799469554098814990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cohort_month]&lt;=[order_month]' />
      </column>
      <column caption='Temp' datatype='real' name='[Calculation_1844716664323051537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;       // THEN &#10;       // ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;      // ELSE &#10;        SUM(([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])) )&#10;      // END&#10;&#10;/&#10;&#10;SUM([new_users] - [new_users]/(1+[New_Incremental_Users]) )' />
      </column>
      <column caption='6 Months GMV' datatype='real' name='[Calculation_1844716664402354208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[vertical] : SUM(IF DATEDIFF(&apos;month&apos;, [cohort_month], [order_month]) &lt; [Parameters].[Parameter 2] AND [order_month]&gt;=[cohort_month] THEN [returned_customer_gmv] ELSE 0 END) }' />
      </column>
      <column caption='Greater Month' datatype='boolean' name='[Calculation_1844716664408797218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_month] &gt;= [cohort_month]' />
      </column>
      <column caption='FDNC_ROI' datatype='real' name='[Calculation_1844716664480948263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([6 Months GMV (copy)_1844716664480362534])/SUM([dps_incentive_discount_eur])' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1844716664678146089]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FDNC_Total_New_Orders' datatype='real' name='[Calculation_1844716664694075434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MoM First New Orders (copy)_1844716663119605764]) + SUM([FDNC_MoM First New Orders (copy)_1844716664010522632])' />
      </column>
      <column caption='Retention Rate Orders' datatype='real' name='[Calculation_224194855151603712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returned_customer_orders])&#10;/&#10;&#10;SUM({ FIXED [country_code],[cohort_month],[vertical]: SUM(IF([cohort_month]=[order_month]) Then ([returned_customer_orders])  END) })' />
      </column>
      <column caption='FDNC_Cohort Return Customers Orders' datatype='real' name='[Calculation_224194855155343362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF ([First Month]=[Order Month]) &#10;    //    THEN &#10;  //      ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;//        ELSE &#10;              // ([returned_customer_orders] - [returned_customer_orders] / (1+[New_Incremental_Orders])&#10;              //    SUM([returned_customer_orders]) * [Retention Rate Orders]&#10; &#10;  //      END&#10;&#10;SUM([Calculation_224194855156355076]) * [Calculation_224194855151603712]' />
      </column>
      <column caption='FDNC_First_Cohort_Month_Orders' datatype='real' name='[Calculation_224194855156355076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code],[cohort_month],[vertical]:  &#10;SUM(IF ([cohort_month]=[order_month]) &#10;        THEN &#10;        ([first_new_orders] - [first_new_orders] / (1+[New_Incremental_Users])) + ([second_orders_first_month] - [second_orders_first_month] / (1+[New_Incremental_Orders]))&#10;END)&#10; }' />
      </column>
      <column caption='GMV Per Order' datatype='real' name='[Calculation_224194855166951431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returned_customer_gmv])/SUM([returned_customer_orders])' />
      </column>
      <column caption='Cohort Metric' datatype='real' name='[Calculation_841610199226773504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN SUM([new_users])&#13;&#10;WHEN &apos;Orders&apos; THEN SUM([returned_customer_orders])&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([returned_customer_gmv])&#13;&#10;//WHEN &apos;Incentive Spend&apos; THEN -[dps_incentive_discount_eur]&#13;&#10;//WHEN &apos;GP&apos; THEN [GP]&#13;&#10;WHEN &apos;Net GP&apos; THEN SUM([Calculation_841610202394591236])&#13;&#10;WHEN &apos;Order Frequency&apos; THEN [Net GP (copy)_1799469553759350795]&#13;&#10;WHEN &apos;GPO&apos; THEN [GMV Per Order (copy)_224194855169228808]&#13;&#10;END' />
      </column>
      <column caption='%Cohort Metric' datatype='real' default-format='p0%' name='[Calculation_841610199446482946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Cohort Metric]) /[Fixed_Cohort_Mertic]&#10;&#10;(ZN([Calculation_841610199226773504]) - LOOKUP(ZN([Calculation_841610199226773504]), FIRST())) / ABS(LOOKUP(ZN([Calculation_841610199226773504]), FIRST()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Net GP' datatype='real' name='[Calculation_841610202394591236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([GP]&lt;0) THEN &#10;&#10;[GP] - IFNULL([dps_incentive_discount_eur],0)&#10;&#10;ELSE &#10;&#10;[GP] - IFNULL([dps_incentive_discount_eur],0)&#10;&#10;END' />
      </column>
      <column caption='MoM New Users' datatype='integer' name='[Calculation_841610203003039749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [new_users] END' />
      </column>
      <column caption='FDNC_Cohort Metric' datatype='real' name='[Cohort Metric (copy)_1844716663124791301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN SUM([new_users] - [new_users]/(1+[New_Incremental_Users]) )&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN  &#13;&#10;    (&#13;&#10;&#13;&#10;[Calculation_224194855155343362]&#13;&#10;)&#13;&#10;&#13;&#10;WHEN &apos;Order Frequency&apos; THEN &#13;&#10;[Order Frequency (copy)_224194855162732550]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Net GP&apos; THEN  &#13;&#10;    (&#13;&#10;    (IF MAX([cohort_month]=[order_month]) &#13;&#10;        THEN &#13;&#10;        SUM(([first_new_orders_GP] - [first_new_orders_GP] / (1+[New_Incremental_Users])) + ([second_new_orders_GP] - [second_new_orders_GP] / (1+[New_Incremental_Orders])))&#13;&#10;        - SUM(IFNULL([dps_incentive_discount_eur],0))&#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) - SUM((IFNULL([dps_incentive_discount_eur],0)))&#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) - SUM((IFNULL([dps_incentive_discount_eur],0)))&#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;&#13;&#10;WHEN &apos;GMV&apos; THEN  &#13;&#10;   &#13;&#10;[Calculation_1123296299820105729]&#13;&#10;&#13;&#10;WHEN &apos;GPO&apos; THEN&#13;&#10;&#13;&#10;   (&#13;&#10;    (IF MAX([cohort_month]=[order_month]) &#13;&#10;        THEN &#13;&#10;        SUM(([first_new_orders_GP] - [first_new_orders_GP] / (1+[New_Incremental_Users])) + ([second_new_orders_GP] - [second_new_orders_GP] / (1+[New_Incremental_Orders])))&#13;&#10;        &#13;&#10;        &#13;&#10;        ELSE &#13;&#10;   &#13;&#10;    &#13;&#10;                IF([GMV Per Order (copy)_224194855169228808]&lt;0) THEN &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                ELSE &#13;&#10;&#13;&#10;                    ([GMV Per Order (copy)_224194855169228808] * [Calculation_224194855155343362] ) &#13;&#10;&#13;&#10;                END&#13;&#10;        END&#13;&#10;))&#13;&#10;/&#13;&#10;[Calculation_224194855155343362]&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='FDNC_6 Months Orders' datatype='real' name='[FDNC_6 Months GMV (copy)_1123296299809603584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//WINDOW_SUM(SUM(IF DATEDIFF(&apos;month&apos;, [First Month], [Order Month]) &lt;= 6 AND [Order Month]&gt;=[First Month] THEN [returned_customer_gmv] ELSE 0 END))&#10;{ FIXED [country_code],[cohort_month],[order_month],[vertical]: &#10;(&#10;IF MAX(DATEDIFF(&apos;month&apos;, [cohort_month], [order_month])) &lt; 6 AND MAX([Calculation_1844716664408797218]) THEN &#10;&#10;   (&#10;   &#10;    [Calculation_224194855155343362] &#10;   &#10;   )&#10;&#10;    &#10;ELSE &#10;0&#10;END&#10;)&#10;}' />
      </column>
      <column caption='FDNC_MoM Second New Orders' datatype='real' name='[FDNC_MoM First New Orders (copy)_1844716664010522632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//if [Order Month]=[First Month] then &#10;[MoM First New Orders (copy)_1844716662741901313] - ([MoM First New Orders (copy)_1844716662741901313]/(1+[New_Incremental_Orders])) &#10;//END' />
      </column>
      <column caption='FDNC_MoM First New Orders GMV' datatype='real' name='[FDNC_MoM First New Orders (copy)_1844716664012750859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[first_new_orders_gmv] - [first_new_orders_gmv]/(1+[New_Incremental_Users]) &#10;END' />
      </column>
      <column caption='FDNC_MoM First New Orders GP' datatype='real' name='[FDNC_MoM First New Orders GMV (copy)_1844716664376066077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then &#10;[first_new_orders_GP] - [first_new_orders_GP]/(1+[New_Incremental_Users]) &#10;END' />
