    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Category Deep Dive'>
      <repository-location id='CategoryDeepDive' path='/t/Talabat/workbooks/ExternalScanningDashboard' revision='' site='Talabat' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f7f0e6' />
