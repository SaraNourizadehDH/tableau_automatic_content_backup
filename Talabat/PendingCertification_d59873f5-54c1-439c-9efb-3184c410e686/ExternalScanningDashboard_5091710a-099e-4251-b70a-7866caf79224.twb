            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='sharad.jain@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1f2gdyj1jxwr3w105kzh20xbddem' name='Custom SQL Query' type='text'><![CDATA[SELECT a.*,
b.sd_scanned_barcode_scanning_date,
b.sd_enabled_active_l30d_scanning_date,
b.sd_enabled_as_of_scanning_date,
b.sd_enabled_active_as_of_scanning_date,
b.sd_enabled_not_active_as_of_scanning_date,
b.sd_not_enabled_pim_as_of_scanning_date,
b.sd_not_enabled_not_pim_as_of_scanning_date
FROM `tlb-data-dev.data_playground_grocery.scanning_dashboard4` a
LEFT JOIN `tlb-data-dev.data_playground_grocery.scanning_date44` b ON a.vendor_id = b.vendor_id AND a.date >>= b.date 
-- AND a.last_scanning_date = b.date
WHERE 1 = 1
AND a.vendor_id IS NOT NULL
AND a.country_code <<>> 'SA'
AND (a.vertical <<>> 'food' OR a.chain_id = 607413)
-- AND a.vendor_id = 704901
-- AND a.date >>= '2025-03-01'
ORDER BY a.date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1f2gdyj1jxwr3w105kzh20xbddem' name='Custom SQL Query' type='text'><![CDATA[SELECT a.*,
b.sd_scanned_barcode_scanning_date,
b.sd_enabled_active_l30d_scanning_date,
b.sd_enabled_as_of_scanning_date,
b.sd_enabled_active_as_of_scanning_date,
b.sd_enabled_not_active_as_of_scanning_date,
b.sd_not_enabled_pim_as_of_scanning_date,
b.sd_not_enabled_not_pim_as_of_scanning_date
FROM `tlb-data-dev.data_playground_grocery.scanning_dashboard4` a
LEFT JOIN `tlb-data-dev.data_playground_grocery.scanning_date44` b ON a.vendor_id = b.vendor_id AND a.date >>= b.date 
-- AND a.last_scanning_date = b.date
WHERE 1 = 1
AND a.vendor_id IS NOT NULL
AND a.country_code <<>> 'SA'
AND (a.vertical <<>> 'food' OR a.chain_id = 607413)
-- AND a.vendor_id = 704901
-- AND a.date >>= '2025-03-01'
ORDER BY a.date]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
