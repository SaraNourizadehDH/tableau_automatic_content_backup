      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1ekd7i70jh8zf41dadxy31oor0p0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[Calculation_1708130929644273665]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='End Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-22#'>
              <calculation class='tableau' formula='#2025-07-22#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Assortment Parity \% (Scanning)&quot;'>
              <calculation class='tableau' formula='&quot;Assortment Parity % (Scanning)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='AVG Daily Vendor Assortment Actioned % [F30D]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Assortment Actioned % [Current]] (copy)_1708130930014556276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Assortment Actioned % F30D [Current]] (copy)_1708130930014363763])})' />
            </column>
            <column caption='AVG Daily Vendor Assortment Parity % [Scan]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930011119724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Assortment Parity % (copy)_1708130930011164781])})' />
            </column>
            <column caption='Assortment Actioned % F30D [Current] (copy)' datatype='real' default-format='p0.00%' name='[Assortment Actioned % F30D [Current]] (copy)_1708130930014363763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([is_gap_as_of_scanning]-[is_gap_first_30_days])/[is_gap_as_of_date]' />
            </column>
            <column caption='Assortment Parity % [Scan]1' datatype='real' default-format='p0.00%' name='[Assortment Parity % (copy)_1708130930011164781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_enabled_and_active_last_30_days_as_of_scanning_date]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='Assortment Parity % [Current]' datatype='real' default-format='p0.00%' name='[Assortment Parity % [Current]] (copy)_1708130929649414151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_enabled_and_active_last_30_days (copy)_1708130929649012741]/[barcodes_scanned_l90d (copy)_1708130929649250310]' />
            </column>
            <column caption='AVG Daily Vendor Assortment Parity % [Current] - old logic' datatype='real' default-format='p0.00%' name='[Assortment Parity % [Current]] (copy)_1708130929991565415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1708130929990418533]/[Calculation_1708130929991319654]' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_1708130929644273665]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1708130929645379586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    // Format: &quot;23 Jul&apos;25 | Tue&quot;&#10;    // If you want to revert to this, uncomment the below and comment out the line below it&#10;    // STR(DATEPART(&apos;day&apos;,[date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[date]),3)  + &quot;&apos;&quot; + MID(STR(DATETRUNC(&apos;year&apos;,[date])),3,2) + &quot; | &quot;  +  LEFT(DATENAME(&apos;weekday&apos;,[date]),3)&#10;    STR([date])&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    // Format: Week start date&#10;    LEFT(STR(DATETRUNC(&apos;week&apos;,[date], &apos;sunday&apos;)), 10)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    // Format: &quot;Jul 2025&quot;&#10;    LEFT(DATENAME(&apos;month&apos;,[date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Quarterly&apos; THEN&#10;    // Format: &quot;Q3 2025&quot;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Yearly&apos; THEN&#10;    // Format: &quot;2025&quot;&#10;    STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;END' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1708130929647476739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;=  [Parameters].[Parameter 2]&#10;AND [date] &lt;= [Parameters].[Parameter 1]&#10;// AND DAY([date]) &lt;= DAY([End Date])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_1708130929891102796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Assortment Parity % (Current)&quot; THEN [Assortment Parity % [Current]] (copy)_1708130929991565415] * 100&#10;WHEN &quot;Assortment Parity % (Scanning)&quot; THEN [AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930011119724] * 100&#10;WHEN &quot;Branches Scanned L90D&quot; THEN [Scanned Branches (L90D) (copy)_1708130929683165218]&#10;WHEN &quot;Availability %&quot; THEN 0 * 100&#10;WHEN &quot;Activation %&quot; THEN [AVG Daily Vendor Assortment Actioned % [Current]] (copy)_1708130930014556276] * 100&#10;END' />
            </column>
            <column caption='AVG Daily Vendor Enabled + Active L30D [Current]' datatype='real' name='[Calculation_1708130929990418533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([is_enabled_and_active_last_30_days])})' />
            </column>
            <column caption='AVG Daily Vendor Scanned Barcodes L90D [Current]' datatype='real' name='[Calculation_1708130929991319654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [country_code]: AVG([barcodes_scanned_l90d])})' />
            </column>
            <column caption='Date | original date' datatype='datetime' name='[Date (copy)_1708130929676070937]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    DATE([date])  // Keep as real date so missing values can be shown&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    DATETRUNC(&apos;week&apos;, DATE([date]), &apos;sunday&apos;)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    DATETRUNC(&apos;month&apos;, DATE([date]))&#10;&#10;END' />
            </column>
            <column caption='Effective End Date (copy)' datatype='datetime' name='[Effective End Date (copy)_1708130929681543199]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &quot;Monthly&quot; THEN DATE(DATETRUNC(&apos;month&apos;, [Date (copy)_1708130929676070937]) + 1) - 1&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [Date (copy)_1708130929676070937]) + 6  // Optional: End of week&#10;  ELSE [Date (copy)_1708130929676070937]&#10;END' />
            </column>
            <column caption='L90D | Original date' datatype='boolean' name='[L90D (copy 2)_1708130929683075105]' role='dimension' type='nominal'>
