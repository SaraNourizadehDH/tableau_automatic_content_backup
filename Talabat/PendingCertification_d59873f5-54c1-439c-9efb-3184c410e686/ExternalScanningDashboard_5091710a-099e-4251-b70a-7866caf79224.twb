      <column caption='Scanned barcodes ttt' datatype='real' name='[Calculation_1708130929906131028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1708130929905176658] THEN [barcodes_scanned] END)/[Calculation_1708130929902010448]' />
