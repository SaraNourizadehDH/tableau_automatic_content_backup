            <column caption='AVG Daily Vendor Assortment Actioned % [F30D]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Assortment Actioned % [Current]] (copy)_1708130930014556276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Assortment Actioned % F30D [Current]] (copy)_1708130930014363763])})' />
