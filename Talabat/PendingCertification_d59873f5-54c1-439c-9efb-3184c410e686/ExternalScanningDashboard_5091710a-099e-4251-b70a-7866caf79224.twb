        <calculation class='tableau' formula='IF [Parameters].[Parameter 10] = &apos;Scanned Barcodes [L90D]&apos; THEN [Calculation_1146025402320285699]&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Assortment Parity % [Current]&apos; THEN [Calculation_1146025402321711110] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Assortment Parity % [Scan]&apos; THEN [AVG Daily Assortment Parity % [Current]] (copy)_1146025402327986199] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;% Enabled&apos; THEN [Calculation_1146025402327089172] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;% Not Enabled + Not Active&apos; THEN [% Enabled (copy 2)_1146025402357731378] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;% Not Enabled + PIM&apos; THEN [% Not Enabled + PIM [Current]] (copy)_1146025402327539733] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Availability %&apos; THEN [Calculation_1146025402346725409] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Morning Availability %&apos; THEN [Calculation_1146025402355601447] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Afternoon Availability %&apos; THEN [Morning Availability % (copy)_1146025402355744808] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Evening Availability %&apos; THEN [Morning Availability % (copy) (copy)_1146025402355761193] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Items OOS %&apos; THEN [Calculation_1146025402347139107] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Items Not Delivered %&apos; THEN [Calculation_1146025402347733028] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;Basket Penetration %&apos; THEN [Calculation_1146025402347986981] * 100&#10;ELSEIF [Parameters].[Parameter 10] = &apos;GPV [EUR]&apos; THEN [Calculation_1146025402348511270]&#10;END' />
      </column>
