      <column caption='% Not Enabled [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1708130929691029548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[is_not_enabled_as_of_date]/[barcodes_scanned_l90d]' />
