      </column>
      <column caption='Branches Scanned Growth' datatype='real' name='[Calculation_1708130929910755425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1708130929902010448]&#10;/&#10;COUNTD(IF [date] &lt; [Parameters].[Parameter 2]&#10;AND [date] &gt;= DATEADD(&apos;day&apos;, -(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2],[Parameters].[Parameter 1])+1),[Parameters].[Parameter 2])&#10;AND [Calculation_1708130929905176658] THEN [vendor_id] END&#10;)&#10;-1' />
      </column>
      <column caption='Granularity: Vendor' datatype='boolean' name='[Calculation_1708130929946218594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;Vendor&apos;' />
