        <calculation class='tableau' formula='[is_pim_not_enabled_as_of_date]/[barcodes_scanned_l90d]' />
      </column>
      <column caption='% Enabled | Scan' datatype='real' default-format='p0.00%' name='[Calculation_1708130929695621172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [AVG Daily Vendor Enabled [Current]] (copy)_1708130930088071308]/[AVG Daily Vendor Scanned Barcodes [Current]] (copy)_1708130930010751083]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [AVG Daily Vendor Enabled +  Active  [Current]]  (copy)_1708130930055311490]/[AVG Daily Vendor Scanned Barcodes [Current]] (copy)_1708130930010751083]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;First 30 Days&apos; THEN [AVG Daily Vendor Enabled [Scan]] (copy)_1708130930088190093]/[AVG Daily Vendor Scanned Barcodes [Current]] (copy)_1708130930010751083]&#10;END' />
      </column>
