d.evening_is_enabled_active,
d.enabled_active_l30d_availability
FROM `tlb-data-dev.data_playground_grocery.scanning_dashboard4_cat` a
LEFT JOIN `tlb-data-dev.data_playground_grocery.scanning_date44_cat` b ON a.vendor_id = b.vendor_id 
AND a.date >>= b.date 
AND a.category_name_level_one = b.category_name_level_one
AND a.category_name_level_two = b.category_name_level_two
AND a.category_name_level_three = b.category_name_level_three
LEFT JOIN `tlb-data-dev.data_playground_grocery.foi_cat` c 
ON c.order_date = a.date 
AND a.vendor_id = c.vendor_id 
AND a.category_name_level_one = c.category_name_level_one
AND a.category_name_level_two = c.category_name_level_two
AND a.category_name_level_three = c.category_name_level_three
LEFT JOIN `tlb-data-dev.data_playground_grocery.availability_cat` d 
ON d.date = a.date 
AND a.vendor_id = d.vendor_id 
AND a.category_name_level_one = d.category_name_level_one
AND a.category_name_level_two = d.category_name_level_two
AND a.category_name_level_three = d.category_name_level_three
WHERE 1 = 1
AND a.vendor_id IS NOT NULL
AND a.country_code <<>> 'SA'
AND (a.vertical <<>> 'food' OR a.chain_id = 607413)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
