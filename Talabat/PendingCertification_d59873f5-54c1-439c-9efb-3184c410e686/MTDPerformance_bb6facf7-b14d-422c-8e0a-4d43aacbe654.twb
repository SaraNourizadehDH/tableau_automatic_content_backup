    <worksheet name='MTD VS LMTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='Performance Dashboard' name='federated.1k8o42q0hq1fhm1gtgky31djzf9c' />
          </datasources>
          <datasource-dependencies datasource='federated.1k8o42q0hq1fhm1gtgky31djzf9c'>
            <column datatype='real' name='[Break Hours]' role='measure' type='quantitative' />
            <column caption='Orders' datatype='integer' name='[Calculation_1609192463092088832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Completed Orders])' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Completed Orders]' role='measure' type='quantitative' />
            <column caption='Estimated Prep Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[DT (copy)_1609192463353896979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Estimated Prep Time]) / SUM([Completed Orders])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DT (copy)_1609192463354433556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Completed Orders]) / SUM([Working Hours])' />
            </column>
            <column datatype='integer' name='[Delay Contacts]' role='measure' type='quantitative' />
            <column datatype='real' name='[Delivery Time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Early Orders]' role='measure' type='quantitative' />
            <column caption='Estimated Prep Time (EPT)' datatype='real' name='[Estimated Prep Time]' role='measure' type='quantitative' />
            <column caption='On Time Orders %' datatype='real' default-format='p0.0%' name='[Fail Rate % (copy)_1609192463167832069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Non GFM On Time Orders]) / SUM([Non GFM Completed Orders])' />
            </column>
            <column caption='Rider Late %' datatype='real' default-format='p0.0%' name='[Fail Rate % (copy)_1609192463355723797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Rider Late &gt; 10 Orders]) / SUM([Completed Orders])' />
            </column>
            <column datatype='integer' name='[Gross Orders]' role='measure' type='quantitative' />
            <column caption='Early Orders %' datatype='real' default-format='p0.0%' name='[Late Orders % (copy)_1609192463286751240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Early Orders]) / SUM([Completed Orders])' />
            </column>
            <column caption='DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Late Orders % (copy)_1609192463287767049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery Time]) / SUM([Completed Orders])' />
            </column>
            <column caption='Delay CR %' datatype='real' default-format='p0.0%' name='[Late Orders % (copy)_1609192463357784086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delay Contacts]) / SUM([Gross Orders])' />
            </column>
            <column datatype='integer' name='[Late Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Logistics Failed Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Non GFM Completed Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Non GFM On Time Orders]' role='measure' type='quantitative' />
            <column caption='Logistics Fail Rate %' datatype='real' default-format='p0.0%' name='[Orders (copy)_1609192463165501441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Logistics Failed Orders]) / SUM([Gross Orders])' />
            </column>
            <column caption='Working Hours' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Orders (copy)_1609192463168745478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Working Hours])' />
            </column>
            <column caption='Late Orders %' datatype='real' default-format='p0.0%' name='[Orders on Time % (copy)_1609192463286571015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Late Orders]) / SUM([Completed Orders])' />
            </column>
            <column caption='Rider Accepting Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders on Time % (copy)_1609192463288328202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Rider Accepting Time]) / SUM([Completed Orders])' />
            </column>
            <column caption='Break Hours %' datatype='real' default-format='p0.0%' name='[Orders on Time % (copy)_1609192463341740049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Break Hours]) / (SUM([Working Hours]) + SUM([Break Hours]))' />
            </column>
            <column datatype='string' name='[Period]' role='dimension' type='nominal' />
            <column caption='Rider Accepting Time (RAT)' datatype='real' name='[Rider Accepting Time]' role='measure' type='quantitative' />
            <column caption='Stacking %' datatype='real' default-format='p0.0%' name='[Rider Late % (copy)_1609192464034443351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Stacked Orders]) / SUM([Completed Orders])' />
            </column>
            <column datatype='integer' name='[Rider Late &gt; 10 Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Stacked Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Vendor Delay V2]' role='measure' type='quantitative' />
            <column caption='Vendor Delay %' datatype='real' default-format='p0.0%' name='[WH (copy)_1609192463352832018]' role='measure' type='quantitative'>
