        <calculation class='tableau' formula='( SUM(if [Period] = &apos;QTD&apos; THEN [Delay Contacts] ELSE NULL END) / SUM(if [Period] = &apos;QTD&apos; THEN [Gross Orders] ELSE NULL END) ) /&#13;&#10;( SUM(if [Period] = &apos;LQTD&apos; THEN [Delay Contacts] ELSE NULL END) / SUM(if [Period] = &apos;LQTD&apos; THEN [Gross Orders] END) ) -1' />
