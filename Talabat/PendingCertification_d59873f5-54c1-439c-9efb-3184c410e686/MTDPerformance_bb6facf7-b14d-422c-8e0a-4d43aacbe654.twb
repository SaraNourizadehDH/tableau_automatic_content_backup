  <datasources>
    <datasource caption='Performance Dashboard' inline='true' name='federated.1k8o42q0hq1fhm1gtgky31djzf9c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0oc1f4p0t7shwt13jbq2x06sqrle'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='abdelrahman.nassar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0oc1f4p0t7shwt13jbq2x06sqrle' name='Performance' type='text'><![CDATA[WITH raw AS
(
 with Working_hours AS
  (
    SELECT
      wh.day,
      wh.zone_id,
      SUM(wh.Working_hours) AS Working_Hours,
      SUM(bh.Break_hours) AS Break_Hours
    FROM
    (
      SELECT
        s.zone_id,
        -- rider_id,
        DATE_TRUNC(d.day,day) AS Day,
        SUM(d.duration/3600) AS Working_hours
      FROM
        `fulfillment-dwh-production.curated_data_shared.shifts` s
      LEFT JOIN
        UNNEST (actual_working_time_by_date) d 
      WHERE 
        LOWER(s.country_code) = 'eg'
      AND 
        DATE_TRUNC(d.day,day) >>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND DATE_TRUNC(d.day,day) << CURRENT_DATE
      AND LOWER(s.shift_state) = 'evaluated'
      -- AND LOWER(`evaluations`[SAFE_OFFSET(0)].status) = 'accepted'
      -- AND DATE_TRUNC(DATE(actual_start_at,s.timezone),day) >>= CURRENT_DATE - 8
      GROUP BY ALL 
      ORDER BY
      -- rider_id, 
      -- zone_id, 
      day DESC  
    ) wh
    LEFT JOIN
    (
      SELECT
        s.zone_id,
        -- rider_id,
        DATE_TRUNC(b.day,day) AS Day,
        -- SUM(d.duration/3600) AS Break_Working_hours,
        SUM(b.duration/3600) AS Break_hours
      FROM
        `fulfillment-dwh-production.curated_data_shared.shifts` s
      LEFT JOIN
        UNNEST (actual_break_time_by_date) b
      WHERE 
        LOWER(s.country_code) = 'eg'
      AND 
        DATE_TRUNC(b.day,day) >>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND DATE_TRUNC(b.day,day) << CURRENT_DATE
      AND LOWER(s.shift_state) = 'evaluated'
      AND LOWER(`evaluations`[SAFE_OFFSET(0)].status) = 'accepted'
      GROUP BY ALL 
      ORDER BY
      -- rider_id, 
      -- zone_id,
      -- zone_id, 
      day DESC  
    ) bh
    ON 
    DATE(wh.day) = DATE(bh.day) 
    AND bh.zone_id = wh.zone_id
    GROUP BY ALL
    ORDER BY 
    -- -- zone_id ASC, 
    day DESC
  ) 

  ,Acceptance_rate AS 
  (
      SELECT 
        created_date_local AS Day
        ,r.zone_id
        ,SUM(d.actual_rider_accepted) AS Actual_rider_accepted
        , SUM(d.actual_rider_notified) AS Actual_rider_notified
        , SUM(d.manual_undispatched) AS Manual_undispatched
        -- , d.undispatched_after_accepted
      FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi` r
      LEFT JOIN UNNEST(r.deliveries) d
      WHERE country_code = 'eg'
        AND created_date_local >>= DATE_TRUNC(current_date-1,MONTH) - INTERVAL 23 MONTH 
        AND created_date_local << CURRENT_DATE
      GROUP BY ALL
  )

  ,Monthly_Riders AS
  (
    SELECT 
      Month,
      zone_id,
      COUNT(DISTINCT rider_id) AS Total_Riders
    FROM
    (
      SELECT
        DATE_TRUNC(DATE(so.created_at, so.timezone),Month) AS Month,
        d.rider_id,
        MAX(so.zone_id) AS zone_id,   
      FROM 
        `fulfillment-dwh-production.curated_data_shared.orders` so
      LEFT JOIN 
        UNNEST(deliveries) d 
      WHERE 
        DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
        AND so.country_code = 'eg'
        AND so.entity.id = 'HF_EG'
      GROUP BY ALL
    )
      WHERE zone_id IS NOT NULL
      GROUP BY ALL
  )

  ,Daily_Riders AS
  (
    SELECT 
      Day,
      zone_id,
      COUNT(DISTINCT rider_id) AS Total_Riders
    FROM
    (
      SELECT
        DATE_TRUNC(DATE(so.created_at, so.timezone),Day) AS Day,
        d.rider_id,
        MAX(so.zone_id) AS zone_id,   
      FROM 
        `fulfillment-dwh-production.curated_data_shared.orders` so
      LEFT JOIN 
        UNNEST(deliveries) d 
      WHERE 
        DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
        AND so.country_code = 'eg'
        AND so.entity.id = 'HF_EG'
      GROUP BY ALL
    )
    WHERE zone_id IS NOT NULL
      GROUP BY ALL
      ORDER BY DAY DESC
  )

  ,Delay_Contacts AS
  (
    SELECT
      DATE_TRUNC(DATE(so.created_at, so.timezone),Day) AS Day,
      so.zone_id,
    COUNT(DISTINCT CASE 
      WHEN contact_reason_l2 IN('Cancellation','Issue with order','Delivery time','Order status')  
      AND contact_reason_l3 IN ('Complaint about extreme delay', 'Complaint about moderate delay', 
      'Complaint about short delay', 'Complaint about severe delay', 'Check order status', "Restaurant hasn't started preparing the food", 'Refund request', 
      'Delivery time/date', 'Request: order will take longer than expected','Order not assigned to a rider','Cancellation reason inquiry') THEN fc.contact_id 
    ELSE NULL END) AS Total_Delay_Related_Contacts,
    count(distinct fc.contact_id) AS Total_Contacts
    FROM 
      `fulfillment-dwh-production.curated_data_shared.orders` so
    LEFT JOIN UNNEST(deliveries) d 
      ON is_primary
    LEFT JOIN 
      `tlb-data-prod.data_platform.fct_contact` fc --customer stakeholder
        ON fc.order_id = so.global_order_id AND fc.delivery_type != 'Non-order related' and fc.stakeholder_id = 1 
    LEFT JOIN 
      `tlb-data-prod.data_platform.dim_contact_reason` cr 
        ON fc.contact_reason_id = cr.contact_reason_id 
    WHERE 
      DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND so.country_code = 'eg'
      AND so.entity.id = 'HF_EG'
    GROUP BY ALL
    ORDER BY Day ASC
  )

  ,Base AS 
  (
    SELECT
      DATE_TRUNC(DATE(so.created_at,so.timezone), MONTH) AS Month,
      DATE(so.created_at,so.timezone) AS Day,
      z.zone_id,
      z.zone_name AS Zone,
      ct.city_name AS City,
      CASE 
        WHEN z.zone_id IN (45,43,84,38,39,41,65) THEN 'ESM' 
        WHEN z.zone_id IN (31,33,32,40,42,46,49,61,81,87) THEN 'Delta'
        WHEN z.zone_id IN (24,60) THEN 'Alex'
        WHEN z.zone_id IN (53, 18, 4, 19, 52, 20, 21, 6, 34, 5, 72, 26, 10, 80, 36, 70, 16, 51, 69, 12, 15, 2, 55, 1, 50, 35) THEN 'Cairo' 
        ELSE 'Other/New' 
      END AS Cluster,
      COUNT(DISTINCT so.order_id) AS `Gross Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' THEN so.order_id ELSE NULL END) AS `Completed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' THEN so.order_id ELSE NULL END) AS `Cancelled Orders`,
      COUNT(DISTINCT CASE WHEN NOT is_preorder THEN so.order_id ELSE NULL END) AS `Non preorder Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' AND LOWER(so.cancellation.reason) IN ('late_delivery','delay_customer_left')
        THEN so.order_id ELSE NULL END) AS `Delay Failed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND NOT 'wait_for_assembled'
        IN UNNEST(so.tags) THEN so.order_id ELSE NULL END) AS `Non GFM completed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.deliveries[OFFSET(0)].stacked_deliveries >> 0) 
        AND so.deliveries[OFFSET(0)].is_primary THEN so.order_id ELSE NULL END) AS `Stacked Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.total_weight >> 19 OR so.total_volume >> 64 
        OR 'large_order' IN UNNEST(so.tags)) THEN so.order_id ELSE NULL END) AS `Big Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND lo.succesful_deliveries_count >> 1 
        AND lo.redelivery_deliveries_count = 0 AND lo.returning_deliveries_count = 0 THEN so.order_id ELSE NULL END) AS `Split Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) 
        BETWEEN -10 AND 10 THEN so.order_id ELSE NULL END) AS `On Time Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) 
        BETWEEN -10 AND 10 AND NOT 'wait_for_assembled' IN UNNEST(so.tags) THEN so.order_id ELSE NULL END) AS `NON GFM On Time Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) >> 10 THEN so.order_id ELSE NULL END) AS `Late Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) << -10 THEN so.order_id ELSE NULL END) AS `Early Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.timings.rider_late/60) >> 10 THEN so.order_id ELSE NULL END) AS `Rider Late >> 10 Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND lo.vendor_delay_v2 IS NOT NULL THEN so.order_id ELSE NULL END) AS `Vendor Delay V2 Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((lo.vendor_delay_v2/60) >> 10 OR (so.timings.avoidable_wait_time/60) >> 10) THEN so.order_id ELSE NULL END) AS `Vendor Delay V2`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' AND LOWER(lo.cancellation_owner) IN ('transport','vendor') THEN so.order_id ELSE NULL END) AS `Logistics Failed Orders`,
      -- COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND vendor.vertical_type = 'darkstores' THEN so.order_id ELSE NULL END) AS `Tmart Orders`,
      ---------------------------- Timings
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.Estimated_Prep_Time/60) ELSE 0 END) AS `EPT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.assumed_actual_Preparation_Time/60) ELSE 0 END) AS `APT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.rider_accepting_time/60) ELSE 0 END) AS `Rat`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_vendor_time/60) ELSE 0 END) AS `Avt`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_vendor_time_cleaned/60) ELSE 0 END) AS `Avtc`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_customer_time/60) ELSE 0 END) AS `Act`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.To_Vendor_Time/60) ELSE 0 END) AS `To Vendor`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.promised_delivery_time/60) ELSE 0 END) AS `PDT`,
      SUM(CASE WHEN so.order_status = 'completed' and is_preorder = FALSE THEN (so.timings.actual_delivery_time/60) ELSE 0 END) AS `DT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.To_Customer_Time/60) ELSE 0 END) AS `To Customer`,
      -- SUM(CASE WHEN so.order_status = 'completed' AND vendor.vertical_type = 'darkstores' THEN (d.timings.actual_delivery_time/60) ELSE 0 END) AS `Tmart_DT`
    FROM 
      `fulfillment-dwh-production.curated_data_shared.orders` so
    LEFT JOIN UNNEST(deliveries) d ON is_primary
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` lo
      ON so.global_order_id = CAST(lo.order_id AS STRING) AND lo.country_code = 'eg'
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z 
      ON so.zone_id = z.zone_id AND z.country_code = 'eg' AND so.country_code = 'eg' AND z.is_Active
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` ct
      ON ct.city_id = z.city_id AND LOWER(ct.country_code) = 'eg' AND ct.is_Active
    WHERE 
      DATE(so.created_at,so.timezone) >>= DATE(DATE_TRUNC(CURRENT_DATE-1, MONTH)) - interval 23 month
      AND DATE(so.created_at,so.timezone) << CURRENT_DATE
      AND so.country_code = 'eg'
    GROUP BY all
  )

  SELECT b.*,
    MAX(dr.Total_Riders) AS `Daily Active Riders`,
    MAX(mr.Total_Riders) AS `Monthly Active Riders`,
    MAX(dc.Total_delay_related_contacts) AS `Delay Contacts`,
    MAX(dc.Total_contacts) AS `Total Contacts`,
    MAX(wh.working_hours) AS `Working Hours`,
    MAX(wh.Break_hours) AS `Break Hours`,
    MAX(ar.Actual_Rider_Notified) AS `Rider Notified`,
    MAX(ar.Actual_Rider_accepted) AS `Rider Accepted`,
    MAX(ar.manual_undispatched) AS `Manual Undispatched`,
    -- MAX(tp.dt_p90) AS `Tmart DT`,
  FROM Base b
  LEFT JOIN working_hours WH 
  on wh.day = b.day AND wh.zone_id = b.zone_id 
  LEFT JOIN Acceptance_rate ar 
  ON ar.Day = b.day AND ar.zone_id = b.zone_id 
  LEFT JOIN daily_riders dr 
  ON dr.day = b.day AND dr.zone_id = b.zone_id
  LEFT JOIN monthly_riders mr 
  ON mr.month = b.month AND mr.zone_id = b.zone_id
  LEFT JOIN delay_contacts dc 
  ON b.day = dc.day AND b.zone_id = dc.zone_id
  Where b.zone_id is not null
  GROUP BY ALL
)

-- 📆 MTD
  SELECT
    'MTD' AS Period,
    Cluster,
    City,
    Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM
    raw
  WHERE
    day BETWEEN DATE_TRUNC(CURRENT_DATE-1, MONTH) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LMTD (Same day range last month)
  SELECT
    'LMTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day 
  BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1, MONTH), INTERVAL 1 MONTH)
    AND DATE_SUB(CURRENT_DATE-1, INTERVAL 1 MONTH)
  GROUP BY ALL
--

UNION ALL
-- 📆 QTD (Current quarter to yesterday)
  SELECT
    'QTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1, QUARTER) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LQTD (Same length as current QTD, but last quarter)
  SELECT
    'LQTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 QUARTER, QUARTER)
        AND DATE_ADD(
        DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 QUARTER, QUARTER),
        INTERVAL DATE_DIFF(CURRENT_DATE-1 - INTERVAL 1 DAY, DATE_TRUNC(CURRENT_DATE-1, QUARTER), DAY)
        DAY
        )

  GROUP BY ALL
--

UNION ALL

-- 📆 YTD 
  SELECT
    'YTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1, YEAR) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LYTD (Same date range last year)
  SELECT
    'LYTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`

  FROM raw
 WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 YEAR, YEAR)
              AND CURRENT_DATE - INTERVAL 1 YEAR
  GROUP BY ALL
--]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0oc1f4p0t7shwt13jbq2x06sqrle' name='Performance' type='text'><![CDATA[WITH raw AS
(
 with Working_hours AS
  (
    SELECT
      wh.day,
      wh.zone_id,
      SUM(wh.Working_hours) AS Working_Hours,
      SUM(bh.Break_hours) AS Break_Hours
    FROM
    (
      SELECT
        s.zone_id,
        -- rider_id,
        DATE_TRUNC(d.day,day) AS Day,
        SUM(d.duration/3600) AS Working_hours
      FROM
        `fulfillment-dwh-production.curated_data_shared.shifts` s
      LEFT JOIN
        UNNEST (actual_working_time_by_date) d 
      WHERE 
        LOWER(s.country_code) = 'eg'
      AND 
        DATE_TRUNC(d.day,day) >>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND DATE_TRUNC(d.day,day) << CURRENT_DATE
      AND LOWER(s.shift_state) = 'evaluated'
      -- AND LOWER(`evaluations`[SAFE_OFFSET(0)].status) = 'accepted'
      -- AND DATE_TRUNC(DATE(actual_start_at,s.timezone),day) >>= CURRENT_DATE - 8
      GROUP BY ALL 
      ORDER BY
      -- rider_id, 
      -- zone_id, 
      day DESC  
    ) wh
    LEFT JOIN
    (
      SELECT
        s.zone_id,
        -- rider_id,
        DATE_TRUNC(b.day,day) AS Day,
        -- SUM(d.duration/3600) AS Break_Working_hours,
        SUM(b.duration/3600) AS Break_hours
      FROM
        `fulfillment-dwh-production.curated_data_shared.shifts` s
      LEFT JOIN
        UNNEST (actual_break_time_by_date) b
      WHERE 
        LOWER(s.country_code) = 'eg'
      AND 
        DATE_TRUNC(b.day,day) >>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND DATE_TRUNC(b.day,day) << CURRENT_DATE
      AND LOWER(s.shift_state) = 'evaluated'
      AND LOWER(`evaluations`[SAFE_OFFSET(0)].status) = 'accepted'
      GROUP BY ALL 
      ORDER BY
      -- rider_id, 
      -- zone_id,
      -- zone_id, 
      day DESC  
    ) bh
    ON 
    DATE(wh.day) = DATE(bh.day) 
    AND bh.zone_id = wh.zone_id
    GROUP BY ALL
    ORDER BY 
    -- -- zone_id ASC, 
    day DESC
  ) 

  ,Acceptance_rate AS 
  (
      SELECT 
        created_date_local AS Day
        ,r.zone_id
        ,SUM(d.actual_rider_accepted) AS Actual_rider_accepted
        , SUM(d.actual_rider_notified) AS Actual_rider_notified
        , SUM(d.manual_undispatched) AS Manual_undispatched
        -- , d.undispatched_after_accepted
      FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi` r
      LEFT JOIN UNNEST(r.deliveries) d
      WHERE country_code = 'eg'
        AND created_date_local >>= DATE_TRUNC(current_date-1,MONTH) - INTERVAL 23 MONTH 
        AND created_date_local << CURRENT_DATE
      GROUP BY ALL
  )

  ,Monthly_Riders AS
  (
    SELECT 
      Month,
      zone_id,
      COUNT(DISTINCT rider_id) AS Total_Riders
    FROM
    (
      SELECT
        DATE_TRUNC(DATE(so.created_at, so.timezone),Month) AS Month,
        d.rider_id,
        MAX(so.zone_id) AS zone_id,   
      FROM 
        `fulfillment-dwh-production.curated_data_shared.orders` so
      LEFT JOIN 
        UNNEST(deliveries) d 
      WHERE 
        DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
        AND so.country_code = 'eg'
        AND so.entity.id = 'HF_EG'
      GROUP BY ALL
    )
      WHERE zone_id IS NOT NULL
      GROUP BY ALL
  )

  ,Daily_Riders AS
  (
    SELECT 
      Day,
      zone_id,
      COUNT(DISTINCT rider_id) AS Total_Riders
    FROM
    (
      SELECT
        DATE_TRUNC(DATE(so.created_at, so.timezone),Day) AS Day,
        d.rider_id,
        MAX(so.zone_id) AS zone_id,   
      FROM 
        `fulfillment-dwh-production.curated_data_shared.orders` so
      LEFT JOIN 
        UNNEST(deliveries) d 
      WHERE 
        DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
        AND so.country_code = 'eg'
        AND so.entity.id = 'HF_EG'
      GROUP BY ALL
    )
    WHERE zone_id IS NOT NULL
      GROUP BY ALL
      ORDER BY DAY DESC
  )

  ,Delay_Contacts AS
  (
    SELECT
      DATE_TRUNC(DATE(so.created_at, so.timezone),Day) AS Day,
      so.zone_id,
    COUNT(DISTINCT CASE 
      WHEN contact_reason_l2 IN('Cancellation','Issue with order','Delivery time','Order status')  
      AND contact_reason_l3 IN ('Complaint about extreme delay', 'Complaint about moderate delay', 
      'Complaint about short delay', 'Complaint about severe delay', 'Check order status', "Restaurant hasn't started preparing the food", 'Refund request', 
      'Delivery time/date', 'Request: order will take longer than expected','Order not assigned to a rider','Cancellation reason inquiry') THEN fc.contact_id 
    ELSE NULL END) AS Total_Delay_Related_Contacts,
    count(distinct fc.contact_id) AS Total_Contacts
    FROM 
      `fulfillment-dwh-production.curated_data_shared.orders` so
    LEFT JOIN UNNEST(deliveries) d 
      ON is_primary
    LEFT JOIN 
      `tlb-data-prod.data_platform.fct_contact` fc --customer stakeholder
        ON fc.order_id = so.global_order_id AND fc.delivery_type != 'Non-order related' and fc.stakeholder_id = 1 
    LEFT JOIN 
      `tlb-data-prod.data_platform.dim_contact_reason` cr 
        ON fc.contact_reason_id = cr.contact_reason_id 
    WHERE 
      DATE(so.created_at, so.timezone)>>= DATE(DATE_TRUNC(CURRENT_DATE-1,MONTH))-INTERVAL 23 MONTH
      AND so.country_code = 'eg'
      AND so.entity.id = 'HF_EG'
    GROUP BY ALL
    ORDER BY Day ASC
  )

  ,Base AS 
  (
    SELECT
      DATE_TRUNC(DATE(so.created_at,so.timezone), MONTH) AS Month,
      DATE(so.created_at,so.timezone) AS Day,
      z.zone_id,
      z.zone_name AS Zone,
      ct.city_name AS City,
      CASE 
        WHEN z.zone_id IN (45,43,84,38,39,41,65) THEN 'ESM' 
        WHEN z.zone_id IN (31,33,32,40,42,46,49,61,81,87) THEN 'Delta'
        WHEN z.zone_id IN (24,60) THEN 'Alex'
        WHEN z.zone_id IN (53, 18, 4, 19, 52, 20, 21, 6, 34, 5, 72, 26, 10, 80, 36, 70, 16, 51, 69, 12, 15, 2, 55, 1, 50, 35) THEN 'Cairo' 
        ELSE 'Other/New' 
      END AS Cluster,
      COUNT(DISTINCT so.order_id) AS `Gross Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' THEN so.order_id ELSE NULL END) AS `Completed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' THEN so.order_id ELSE NULL END) AS `Cancelled Orders`,
      COUNT(DISTINCT CASE WHEN NOT is_preorder THEN so.order_id ELSE NULL END) AS `Non preorder Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' AND LOWER(so.cancellation.reason) IN ('late_delivery','delay_customer_left')
        THEN so.order_id ELSE NULL END) AS `Delay Failed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND NOT 'wait_for_assembled'
        IN UNNEST(so.tags) THEN so.order_id ELSE NULL END) AS `Non GFM completed Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.deliveries[OFFSET(0)].stacked_deliveries >> 0) 
        AND so.deliveries[OFFSET(0)].is_primary THEN so.order_id ELSE NULL END) AS `Stacked Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.total_weight >> 19 OR so.total_volume >> 64 
        OR 'large_order' IN UNNEST(so.tags)) THEN so.order_id ELSE NULL END) AS `Big Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND lo.succesful_deliveries_count >> 1 
        AND lo.redelivery_deliveries_count = 0 AND lo.returning_deliveries_count = 0 THEN so.order_id ELSE NULL END) AS `Split Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) 
        BETWEEN -10 AND 10 THEN so.order_id ELSE NULL END) AS `On Time Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) 
        BETWEEN -10 AND 10 AND NOT 'wait_for_assembled' IN UNNEST(so.tags) THEN so.order_id ELSE NULL END) AS `NON GFM On Time Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) >> 10 THEN so.order_id ELSE NULL END) AS `Late Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((so.timings.actual_delivery_time/60) - (so.timings.promised_delivery_time/60)) << -10 THEN so.order_id ELSE NULL END) AS `Early Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND (so.timings.rider_late/60) >> 10 THEN so.order_id ELSE NULL END) AS `Rider Late >> 10 Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND lo.vendor_delay_v2 IS NOT NULL THEN so.order_id ELSE NULL END) AS `Vendor Delay V2 Orders`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND ((lo.vendor_delay_v2/60) >> 10 OR (so.timings.avoidable_wait_time/60) >> 10) THEN so.order_id ELSE NULL END) AS `Vendor Delay V2`,
      COUNT(DISTINCT CASE WHEN so.order_status = 'cancelled' AND LOWER(lo.cancellation_owner) IN ('transport','vendor') THEN so.order_id ELSE NULL END) AS `Logistics Failed Orders`,
      -- COUNT(DISTINCT CASE WHEN so.order_status = 'completed' AND vendor.vertical_type = 'darkstores' THEN so.order_id ELSE NULL END) AS `Tmart Orders`,
      ---------------------------- Timings
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.Estimated_Prep_Time/60) ELSE 0 END) AS `EPT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.assumed_actual_Preparation_Time/60) ELSE 0 END) AS `APT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.rider_accepting_time/60) ELSE 0 END) AS `Rat`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_vendor_time/60) ELSE 0 END) AS `Avt`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_vendor_time_cleaned/60) ELSE 0 END) AS `Avtc`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.at_customer_time/60) ELSE 0 END) AS `Act`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.To_Vendor_Time/60) ELSE 0 END) AS `To Vendor`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.promised_delivery_time/60) ELSE 0 END) AS `PDT`,
      SUM(CASE WHEN so.order_status = 'completed' and is_preorder = FALSE THEN (so.timings.actual_delivery_time/60) ELSE 0 END) AS `DT`,
      SUM(CASE WHEN so.order_status = 'completed' THEN (so.timings.To_Customer_Time/60) ELSE 0 END) AS `To Customer`,
      -- SUM(CASE WHEN so.order_status = 'completed' AND vendor.vertical_type = 'darkstores' THEN (d.timings.actual_delivery_time/60) ELSE 0 END) AS `Tmart_DT`
    FROM 
      `fulfillment-dwh-production.curated_data_shared.orders` so
    LEFT JOIN UNNEST(deliveries) d ON is_primary
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` lo
      ON so.global_order_id = CAST(lo.order_id AS STRING) AND lo.country_code = 'eg'
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z 
      ON so.zone_id = z.zone_id AND z.country_code = 'eg' AND so.country_code = 'eg' AND z.is_Active
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` ct
      ON ct.city_id = z.city_id AND LOWER(ct.country_code) = 'eg' AND ct.is_Active
    WHERE 
      DATE(so.created_at,so.timezone) >>= DATE(DATE_TRUNC(CURRENT_DATE-1, MONTH)) - interval 23 month
      AND DATE(so.created_at,so.timezone) << CURRENT_DATE
      AND so.country_code = 'eg'
    GROUP BY all
  )

  SELECT b.*,
    MAX(dr.Total_Riders) AS `Daily Active Riders`,
    MAX(mr.Total_Riders) AS `Monthly Active Riders`,
    MAX(dc.Total_delay_related_contacts) AS `Delay Contacts`,
    MAX(dc.Total_contacts) AS `Total Contacts`,
    MAX(wh.working_hours) AS `Working Hours`,
    MAX(wh.Break_hours) AS `Break Hours`,
    MAX(ar.Actual_Rider_Notified) AS `Rider Notified`,
    MAX(ar.Actual_Rider_accepted) AS `Rider Accepted`,
    MAX(ar.manual_undispatched) AS `Manual Undispatched`,
    -- MAX(tp.dt_p90) AS `Tmart DT`,
  FROM Base b
  LEFT JOIN working_hours WH 
  on wh.day = b.day AND wh.zone_id = b.zone_id 
  LEFT JOIN Acceptance_rate ar 
  ON ar.Day = b.day AND ar.zone_id = b.zone_id 
  LEFT JOIN daily_riders dr 
  ON dr.day = b.day AND dr.zone_id = b.zone_id
  LEFT JOIN monthly_riders mr 
  ON mr.month = b.month AND mr.zone_id = b.zone_id
  LEFT JOIN delay_contacts dc 
  ON b.day = dc.day AND b.zone_id = dc.zone_id
  Where b.zone_id is not null
  GROUP BY ALL
)

-- 📆 MTD
  SELECT
    'MTD' AS Period,
    Cluster,
    City,
    Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM
    raw
  WHERE
    day BETWEEN DATE_TRUNC(CURRENT_DATE-1, MONTH) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LMTD (Same day range last month)
  SELECT
    'LMTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day 
  BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1, MONTH), INTERVAL 1 MONTH)
    AND DATE_SUB(CURRENT_DATE-1, INTERVAL 1 MONTH)
  GROUP BY ALL
--

UNION ALL
-- 📆 QTD (Current quarter to yesterday)
  SELECT
    'QTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1, QUARTER) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LQTD (Same length as current QTD, but last quarter)
  SELECT
    'LQTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 QUARTER, QUARTER)
        AND DATE_ADD(
        DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 QUARTER, QUARTER),
        INTERVAL DATE_DIFF(CURRENT_DATE-1 - INTERVAL 1 DAY, DATE_TRUNC(CURRENT_DATE-1, QUARTER), DAY)
        DAY
        )

  GROUP BY ALL
--

UNION ALL

-- 📆 YTD 
  SELECT
    'YTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`
  FROM raw
  WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1, YEAR) AND CURRENT_DATE - 1
  GROUP BY ALL
--

UNION ALL

-- 📆 LYTD (Same date range last year)
  SELECT
    'LYTD' AS Period,
    Cluster, City, Zone,
    SUM(`Completed Orders`) AS `Completed Orders`,
    SUM(`Non GFM On Time Orders`) AS `Non GFM On Time Orders`,
    SUM(`Non GFM Completed Orders`) AS `Non GFM Completed Orders`,
    SUM(`Total Contacts`) AS `Total Contacts`,
    SUM(`Delay Contacts`) AS `Delay Contacts`,
    SUM(`Delay Failed Orders`) AS `Delay Failed Orders`,
    SUM(`Cancelled Orders`) AS `Cancelled Orders`,
    SUM(`DT`) AS `Delivery Time`,
    SUM(`Early Orders`) AS `Early Orders`,
    SUM(`Late Orders`) AS `Late Orders`,
    SUM(`Vendor Delay V2`) AS `Vendor Delay V2`,
    SUM(`Daily Active Riders`) AS `Active Riders`,
    SUM(`Working Hours`) AS `Working Hours`,
    SUM(`Rider Late >> 10 Orders`) AS `Rider Late >> 10 Orders`,
    SUM(`Logistics Failed Orders`) AS `Logistics Failed Orders`,
    SUM(`RAT`) AS `Rider Accepting Time`,
    SUM(`Rider Accepted`) AS `Rider Accepted`,
    SUM(`Rider Notified`) AS `Rider Notified`,
    SUM(`Break Hours`) AS `Break Hours`,
    SUM(`EPT`) AS `Estimated Prep Time`,
    SUM(`Stacked Orders`) AS `Stacked Orders`,
    SUM(`On Time Orders`) AS `On Time Orders`,
    SUM(`Gross Orders`) AS `Gross Orders`

  FROM raw
 WHERE day BETWEEN DATE_TRUNC(CURRENT_DATE-1 - INTERVAL 1 YEAR, YEAR)
              AND CURRENT_DATE - INTERVAL 1 YEAR
  GROUP BY ALL
--]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>Period</remote-name>
            <remote-type>130</remote-type>
            <local-name>[Period]</local-name>
            <parent-name>[Performance]</parent-name>
            <remote-alias>Period</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_C41CAA4F4DCF43D8ADF9AF1F8215C1D1]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Cluster</remote-name>
            <remote-type>130</remote-type>
            <local-name>[Cluster]</local-name>
            <parent-name>[Performance]</parent-name>
            <remote-alias>Cluster</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_C41CAA4F4DCF43D8ADF9AF1F8215C1D1]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
