      <column caption='BH QTD VS LQTD' datatype='real' default-format='*▲0‎%;▼0%;' name='[BH MTD VS LMTD (copy)_1609192463693533231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF [Period] = &apos;QTD&apos; THEN [Break Hours] END) /&#13;&#10;    (&#13;&#10;        SUM(IF [Period] = &apos;QTD&apos; THEN [Working Hours] END) +&#13;&#10;        SUM(IF [Period] = &apos;QTD&apos; THEN [Break Hours] END)&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    SUM(IF [Period] = &apos;LQTD&apos; THEN [Break Hours] END) /&#13;&#10;    (&#13;&#10;        SUM(IF [Period] = &apos;LQTD&apos; THEN [Working Hours] END) +&#13;&#10;        SUM(IF [Period] = &apos;LQTD&apos; THEN [Break Hours] END)&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1' />
      </column>
      <column caption='BH YTD VS LYTD' datatype='real' default-format='*▲0‎%;▼0%;' name='[BH QTD VS LQTD (copy)_1609192463700910140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF [Period] = &apos;YTD&apos; THEN [Break Hours] END) /&#13;&#10;    (&#13;&#10;        SUM(IF [Period] = &apos;YTD&apos; THEN [Working Hours] END) +&#13;&#10;        SUM(IF [Period] = &apos;YTD&apos; THEN [Break Hours] END)&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    SUM(IF [Period] = &apos;LYTD&apos; THEN [Break Hours] END) /&#13;&#10;    (&#13;&#10;        SUM(IF [Period] = &apos;LYTD&apos; THEN [Working Hours] END) +&#13;&#10;        SUM(IF [Period] = &apos;LYTD&apos; THEN [Break Hours] END)&#13;&#10;    )&#13;&#10;)&#13;&#10;- 1' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1609192463092088832]' role='measure' type='quantitative'>
