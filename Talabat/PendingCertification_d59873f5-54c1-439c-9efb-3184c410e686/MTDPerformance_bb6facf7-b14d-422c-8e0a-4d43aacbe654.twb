          </datasources>
          <datasource-dependencies datasource='federated.1yzzksi0kn2su91ejupn715bp2y8'>
            <column caption='Today -1' datatype='date' name='[Calculation_1609192464015913034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 1' />
            </column>
            <column caption='Legend' datatype='string' name='[Calculation_1609192464174051440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034])) THEN &apos;Last Year&apos; ELSE &apos;This Year&apos; END' />
            </column>
            <column datatype='integer' name='[Completed Orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[DT]' role='measure' type='quantitative' />
            <column caption='Delivery Time ly' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Delivery Time (copy)_1609192464172716131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034])) THEN [DT] END) / &#13;&#10;SUM(IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034])) THEN [Completed Orders] END)' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Rider Accepting Time (copy)_1609192464033144918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;year&apos;,[Month]) = DATETRUNC(&apos;year&apos;,[Calculation_1609192464015913034]) THEN [DT] END) / &#13;&#10;SUM(IF DATETRUNC(&apos;year&apos;,[Month]) = DATETRUNC(&apos;year&apos;,[Calculation_1609192464015913034]) THEN [Completed Orders] END)' />
            </column>
