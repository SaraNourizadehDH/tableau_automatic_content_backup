          <datasource-dependencies datasource='federated.1yzzksi0kn2su91ejupn715bp2y8'>
            <column caption='BH % ly' datatype='real' default-format='p0.0%' name='[BH % (copy)_1609192464165191777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034])) THEN [Break Hours] END) / &#13;&#10;(&#13;&#10;SUM(  IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034]))  THEN [Break Hours] END) +&#13;&#10;SUM(IF DATETRUNC(&apos;year&apos;, [Month]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_1609192464015913034]))  THEN [Working Hours] END)&#13;&#10;)' />
            </column>
            <column datatype='real' name='[Break Hours]' role='measure' type='quantitative' />
            <column caption='Today -1' datatype='date' name='[Calculation_1609192464015913034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 1' />
            </column>
            <column caption='Legend' datatype='string' name='[Calculation_1609192464174051440]' role='dimension' type='nominal'>
