            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='BH %' datatype='real' default-format='p0.0%' name='[Total WH (copy)_1609192464038469724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;year&apos;,[Month]) = DATETRUNC(&apos;year&apos;,[Calculation_1609192464015913034]) THEN [Break Hours] END) / &#13;&#10;(&#13;&#10;SUM(IF DATETRUNC(&apos;year&apos;,[Month]) = DATETRUNC(&apos;year&apos;,[Calculation_1609192464015913034]) THEN [Break Hours] END) +&#13;&#10;SUM(IF DATETRUNC(&apos;year&apos;,[Month]) = DATETRUNC(&apos;year&apos;,[Calculation_1609192464015913034]) THEN [Working Hours] END)&#13;&#10;)' />
