        <calculation class='tableau' formula='( SUM(if [Period] = &apos;YTD&apos; THEN [Delay Contacts] ELSE NULL END) / SUM(if [Period] = &apos;YTD&apos; THEN [Gross Orders] ELSE NULL END) ) /&#13;&#10;( SUM(if [Period] = &apos;LYTD&apos; THEN [Delay Contacts] ELSE NULL END) / SUM(if [Period] = &apos;LYTD&apos; THEN [Gross Orders] END) ) -1' />
