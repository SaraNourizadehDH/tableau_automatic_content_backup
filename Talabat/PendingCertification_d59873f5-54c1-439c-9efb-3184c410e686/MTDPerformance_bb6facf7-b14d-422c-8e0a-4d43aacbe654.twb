            <column datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Completed Orders]' role='measure' type='quantitative' />
            <column caption='RAT MTD VS LMTD' datatype='real' default-format='*▲0‎%;▼0%;' name='[DT MTD VS LMTD (copy)_1609192463673720872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(if [Period] = &apos;MTD&apos; THEN [Rider Accepting Time] ELSE NULL END) / SUM(if [Period] = &apos;MTD&apos; THEN [Completed Orders] ELSE NULL END) ) /&#13;&#10;( SUM(if [Period] = &apos;LMTD&apos; THEN [Rider Accepting Time] ELSE NULL END) / SUM(if [Period] = &apos;LMTD&apos; THEN [Completed Orders] ELSE NULL END) ) -1' />
