        <calculation class='tableau' formula='( SUM(if [Period] = &apos;MTD&apos; THEN [Non GFM On Time Orders] ELSE NULL END) / SUM(if [Period] = &apos;MTD&apos; THEN [Non GFM Completed Orders] ELSE NULL END) ) /&#13;&#10;( SUM(if [Period] = &apos;LMTD&apos; THEN [Non GFM On Time Orders] ELSE NULL END) / SUM(if [Period] = &apos;LMTD&apos; THEN [Non GFM Completed Orders] END) ) -1' />
