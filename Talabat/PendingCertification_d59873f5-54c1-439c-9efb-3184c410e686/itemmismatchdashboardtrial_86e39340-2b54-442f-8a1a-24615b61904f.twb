    <worksheet name='country_level_affected_campaigns'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Daily Number of Affected Campaigns by Country</run>
            <run>Æ&#10;</run>
            <run fontcolor='#aa0000' fontsize='10'>&quot;Number of cumulated campaigns that faced an item deletion during their live duration&quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='items_deleted' name='federated.1fzjv260ppygwm112a31i0aogkca' />
          </datasources>
          <datasource-dependencies datasource='federated.1fzjv260ppygwm112a31i0aogkca'>
            <column caption='Total # campaigns affected (before end-date)' datatype='string' name='[Calculation_2338916325387132928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [campaign_id]&#10;END' />
            </column>
            <column caption='Deletion Type Flag' datatype='string' name='[Calculation_2338916325408534535]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &gt; 0 THEN &apos;After campaign&apos;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [deleted_date], [campaign_start_date]) &gt; 0 THEN &apos;Before campaign&apos;&#10;ELSEIF  DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &lt; 0 THEN &apos;During campaign&apos;&#10;ELSE &apos;hard_deleted&apos;&#10;END' />
            </column>
            <column caption='campaign end date' datatype='date' name='[campaign_end_date]' role='dimension' type='ordinal' />
            <column caption='campaign id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='campaign name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='campaign start date' datatype='date' name='[campaign_start_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='chain id' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column caption='chain name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2338916325387132928]' derivation='CountD' name='[ctd:Calculation_2338916325387132928:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[deleted_date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_item_deleted_from_catalog]' role='dimension' type='nominal' />
            <column datatype='string' name='[mismatch_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2338916325408534535]' derivation='None' name='[none:Calculation_2338916325408534535:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_id]' derivation='None' name='[none:campaign_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_name]' derivation='None' name='[none:campaign_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_id]' derivation='None' name='[none:chain_id:ok]' pivot='key' type='ordinal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[deleted_date]' derivation='None' name='[none:deleted_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pos_integration_name]' derivation='None' name='[none:pos_integration_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[pos_integration_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Non-POS' />
              </aliases>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1fzjv260ppygwm112a31i0aogkca].[none:Calculation_2338916325408534535:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_2338916325408534535:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1fzjv260ppygwm112a31i0aogkca].[none:campaign_id:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:campaign_id:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
