      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0xk8m1c1wyr4qy1bjeu3z17db31j'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='balderick.bissessur@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0xk8m1c1wyr4qy1bjeu3z17db31j' name='Custom SQL Query' type='text'>SELECT
  items.*,
  campaign_status,
  pos_integration_code,
  pos_integration_name,
  pos_integration_active_at
FROM
  `tlb-data-dev.data_playground.items_mismatch_test_v8` items
LEFT JOIN (
  SELECT
    campaign_id,
    campaign_start_date,
    campaign_status,
    country_code
  FROM
    `tlb-data-prod.data_platform.dim_incentive_campaign` c
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_country_info` d
  USING
    (country) ) campaigns
ON
  items.campaign_id = campaigns.campaign_id
  AND items.campaign_start_date = DATE(campaigns.campaign_start_date)
  AND LOWER(items.country_code) = LOWER(campaigns.country_code)
LEFT JOIN (
  SELECT
    country_code,
    chain_id,
    chain_name,
    vendor_code,
    vendor_name,
    pos_integration_code,
    pos_integration_name,
    pos_integration_active_at
  FROM
    `tlb-data-prod.data_platform.dim_logistics_vendor`
  WHERE
    is_pos_integration_active = TRUE ) pos
ON
  items.chain_id = pos.chain_id
where deleted_date &gt;&gt; &apos;2024-01-01&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0xk8m1c1wyr4qy1bjeu3z17db31j' name='Custom SQL Query' type='text'>SELECT
