    <worksheet name='table_campaign_status'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>KPI&apos;s By Campaign Status</run>
            <run>Æ&#10;</run>
            <run fontcolor='#aa0000' fontsize='10'>&quot;The data changes over time due to campaign status changing&quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='items_deleted' name='federated.1fzjv260ppygwm112a31i0aogkca' />
          </datasources>
          <datasource-dependencies datasource='federated.1fzjv260ppygwm112a31i0aogkca'>
            <column caption='Total # campaigns affected (before end-date)' datatype='string' name='[Calculation_2338916325387132928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [campaign_id]&#10;END' />
            </column>
            <column caption='Total # Chains affected' datatype='integer' name='[Calculation_2338916325387247617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [chain_id]&#10;END' />
            </column>
            <column caption='Deletion Type Flag' datatype='string' name='[Calculation_2338916325408534535]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &gt; 0 THEN &apos;After campaign&apos;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [deleted_date], [campaign_start_date]) &gt; 0 THEN &apos;Before campaign&apos;&#10;ELSEIF  DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &lt; 0 THEN &apos;During campaign&apos;&#10;ELSE &apos;hard_deleted&apos;&#10;END' />
            </column>
            <column caption='Non-Unique Items Deleted before Campaign End' datatype='integer' name='[Calculation_2338916325625946127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Unique items deleted before campaign end' datatype='integer' name='[Calculation_521080557795094536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([Mismatch Items Deleted before Campaign End (copy)_521080557794050052])' />
            </column>
            <column caption='Difference between non-unique &amp; unique items' datatype='integer' name='[Calculation_521080557806092299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2338916325625946127]) - [Calculation_521080557795094536]' />
            </column>
            <column caption='Unique Items Deleted before Campaign End' datatype='string' name='[Mismatch Items Deleted before Campaign End (copy)_521080557794050052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN STR([source_system_item_id])&#10;ELSE &apos;0&apos;&#10;END' />
            </column>
            <column caption='campaign end date' datatype='date' name='[campaign_end_date]' role='dimension' type='ordinal' />
            <column caption='campaign id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='campaign name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='campaign start date' datatype='date' name='[campaign_start_date]' role='dimension' type='ordinal' />
            <column caption='current campaign status' datatype='string' name='[campaign_status]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='chain id' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column caption='chain name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Creation Source' datatype='string' name='[created_by]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2338916325387132928]' derivation='CountD' name='[ctd:Calculation_2338916325387132928:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2338916325387247617]' derivation='CountD' name='[ctd:Calculation_2338916325387247617:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[deleted_date]' role='dimension' type='ordinal' />
