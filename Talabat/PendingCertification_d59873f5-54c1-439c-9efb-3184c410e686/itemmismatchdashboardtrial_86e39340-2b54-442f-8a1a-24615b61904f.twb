    </worksheet>
    <worksheet name='summary_table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>KPI&apos;s By Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='items_deleted' name='federated.1fzjv260ppygwm112a31i0aogkca' />
          </datasources>
          <datasource-dependencies datasource='federated.1fzjv260ppygwm112a31i0aogkca'>
            <column caption='Total # campaigns affected (before end-date)' datatype='string' name='[Calculation_2338916325387132928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [campaign_id]&#10;END' />
            </column>
            <column caption='Total # Chains affected' datatype='integer' name='[Calculation_2338916325387247617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [chain_id]&#10;END' />
            </column>
            <column caption='Non-Unique Items Deleted before Campaign End' datatype='integer' name='[Calculation_2338916325625946127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Totale Menus where deletions occured' datatype='integer' name='[Calculation_2338916326007029786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;[menu_id]&#10;)' />
            </column>
            <column caption='Unique items deleted before campaign end' datatype='integer' name='[Calculation_521080557795094536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([Mismatch Items Deleted before Campaign End (copy)_521080557794050052])' />
            </column>
            <column caption='Unique Items Deleted before Campaign End' datatype='string' name='[Mismatch Items Deleted before Campaign End (copy)_521080557794050052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN STR([source_system_item_id])&#10;ELSE &apos;0&apos;&#10;END' />
            </column>
            <column caption='campaign end date' datatype='date' name='[campaign_end_date]' role='dimension' type='ordinal' />
            <column caption='campaign id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='campaign name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
