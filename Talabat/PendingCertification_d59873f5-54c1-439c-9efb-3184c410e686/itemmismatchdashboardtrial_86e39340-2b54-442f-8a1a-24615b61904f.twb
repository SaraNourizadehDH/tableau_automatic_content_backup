    <worksheet name='menu_creation'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Daily Number of Menus Created Regardless of Deletions</run>
            <run>Æ&#10;</run>
            <run fontcolor='#aa0000' fontsize='10'>&quot;Number of unique menus created on that day without taking into account the number of menus that were affected by the deletions. This shows all the menus created within catalog.&quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='menus_created' name='federated.1hx5hcs01898po1c7oeaz0dxcvak' />
          </datasources>
          <datasource-dependencies datasource='federated.1hx5hcs01898po1c7oeaz0dxcvak'>
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_menus_created]' derivation='Sum' name='[sum:total_menus_created:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_menus_created]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1hx5hcs01898po1c7oeaz0dxcvak].[none:created_date:qk]' included-values='in-range'>
            <min>#2024-01-02#</min>
            <max>#2024-10-23#</max>
          </filter>
          <slices>
            <column>[federated.1hx5hcs01898po1c7oeaz0dxcvak].[none:created_date:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1hx5hcs01898po1c7oeaz0dxcvak].[sum:total_menus_created:qk]' scope='rows' value='Total Menus created' />
          </style-rule>
          <style-rule element='quick-filter'>
            <format attr='title' field='[federated.1hx5hcs01898po1c7oeaz0dxcvak].[none:created_date:qk]' value='created date'>
              <formatted-text>
                <run>created date</run>
              </formatted-text>
            </format>
          </style-rule>
        </style>
        <panes>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
