        </aliases>
      </column>
      <column caption='Total # campaigns affected (before end-date)' datatype='string' name='[Calculation_2338916325387132928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [campaign_id]&#10;END' />
      </column>
      <column caption='Total # Chains affected' datatype='integer' name='[Calculation_2338916325387247617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN [chain_id]&#10;END' />
      </column>
      <column caption='flag_deleted_after_campaign_end' datatype='string' name='[Calculation_2338916325387419650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &gt; 0 THEN &apos;yes&apos; ELSE &apos;no&apos; END' />
      </column>
      <column caption='flag_deleted_before_campaign_start' datatype='string' name='[Calculation_2338916325387538435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [deleted_date], [campaign_start_date]) &gt; 0 THEN &apos;yes&apos; ELSE &apos;no&apos; END' />
      </column>
      <column caption='flag_deleted_during_campaign' datatype='string' name='[Calculation_2338916325387653124]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &lt; 0 THEN &apos;yes&apos; ELSE &apos;no&apos; END' />
      </column>
      <column caption='Deletion Type Flag' datatype='string' name='[Calculation_2338916325408534535]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &gt; 0 THEN &apos;After campaign&apos;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [deleted_date], [campaign_start_date]) &gt; 0 THEN &apos;Before campaign&apos;&#10;ELSEIF  DATEDIFF(&apos;day&apos;, [campaign_end_date], [deleted_date]) &lt; 0 THEN &apos;During campaign&apos;&#10;ELSE &apos;hard_deleted&apos;&#10;END' />
      </column>
      <column caption='Weeks' datatype='datetime' name='[Calculation_2338916325414191114]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, - (DATEPART(&apos;weekday&apos;, [deleted_date]) - 1), [deleted_date])' />
      </column>
      <column caption='flag_items_deleted' datatype='string' name='[Calculation_2338916325615570957]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[is_item_deleted_from_catalog] = true &#10;THEN &apos;yes&apos; &#10;ELSE &apos;no&apos;&#10;END' />
      </column>
      <column caption='Non-Unique Items Deleted before Campaign End' datatype='integer' name='[Calculation_2338916325625946127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [deleted_date] &lt; [campaign_end_date]&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Total Items Deleted (incl. without dates data)' datatype='integer' name='[Calculation_2338916325986447381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_item_deleted_from_catalog] = TRUE&#10;   AND [mismatch_status] = &apos;mismatch&apos;&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Totale Menus where deletions occured' datatype='integer' name='[Calculation_2338916326007029786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;[menu_id]&#10;)' />
      </column>
      <column caption='menu_creation_date' datatype='date' name='[Calculation_2338916326007664667]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [menu_created_on_catalog]))' />
      </column>
      <column aggregation='Sum' caption='menu_creation_deletion_flag' datatype='integer' name='[Calculation_2338916326010892318]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF date([menu_created_on_catalog]) = [deleted_date] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Menu&apos;s created on deletion date' datatype='integer' name='[Calculation_2338916326012895263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD(IF DATE([menu_created_on_catalog]) = [deleted_date] THEN [menu_id] END) }' />
      </column>
      <column caption='Total Menus' datatype='integer' name='[Calculation_2338916326031589408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(menu_id)' />
      </column>
      <column caption='Unique items deleted before campaign end' datatype='integer' name='[Calculation_521080557795094536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Mismatch Items Deleted before Campaign End (copy)_521080557794050052])' />
      </column>
      <column caption='Unique items deleted before campaign start' datatype='integer' name='[Calculation_521080557795393545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Mismatch Items Deleted before Campaign Start (copy)_521080557794050053])' />
