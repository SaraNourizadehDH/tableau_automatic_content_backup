  AND order_date >> '2024-01-09'
GROUP BY ALL
)

    SELECT
        country_code,
        order_month,
        --order_date,
        chain_id,
        chain_name,
        vendor_id,
        vendor_name,
        integration_name,
        pos_integration_type,
        pos_client_name,
        is_refunded,
