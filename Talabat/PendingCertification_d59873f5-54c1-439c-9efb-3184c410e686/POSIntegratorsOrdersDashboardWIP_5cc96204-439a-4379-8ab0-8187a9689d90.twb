      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7569B7700F094B8B9A30204C16A3AB10'>
            <properties context=''>
              <relation connection='bigquery.0bpwuzt1663n5e149h6ba1hgshfm' name='Custom SQL Query' type='text'><![CDATA[WITH POS
as (
SELECT
  i.country_code,
  FORMAT_DATE('%B', order_date) AS order_month,
  --order_date,
  i.chain_id,
  c.chain_name,
  i.vendor_id,
  vi.vendor_name,
  v.integration_name,
  v.pos_integration_type,
  v.pos_client_name,
  --v.remote_id, 
  i.is_refunded,
  i.is_successful,
  i.is_tgo,
  order_fail_reason_id,
  reason as fail_reason, 
  reason_group as fail_reason_group, 
  talabat_reason as fail_talabat_reason, 
  sub_reason as fail_sub_reason,  
  owner as fail_owner,
  contact_reasons,
  contacts_count,
  contact_costs,
  COUNT(distinct i.order_id) AS total_orders,
FROM
  `tlb-data-prod.data_platform.fct_order_info` i
LEFT JOIN (
    SELECT
        entity_id,
        chain.id AS chain_id,
        chain.name AS chain_name,
        vendor_code,
        Vendor_id,
        vertical_type,
        v.vendor_name,
        client.name AS pos_client_name,
        Client.pos_integration_type,
        pos.*,
        STRING_AGG(DISTINCT d ORDER BY d DESC) AS delivery_types
    FROM
        `fulfillment-dwh-production.curated_data_shared_vendor.growth_vendors` v
    CROSS JOIN
        UNNEST(vendor) vv
    LEFT JOIN
        UNNEST(vv.delivery_type) d
    WHERE
        is_latest
        AND vv.is_Active
        AND client.pos_integration_type IS NOT NULL
        AND pos.is_pos_integration_active IS TRUE 
    GROUP BY ALL ) v
    ON i.chain_id = CAST(v.chain_id AS INT64)
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c ON i.chain_id = c.chain_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` vi ON i.vendor_id = vi.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_status` os ON i.order_status_id = os.order_status_id 
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` fr using(order_fail_reason_id)

LEFT JOIN 
    (
        SELECT 
            country_code, 
            order_id, 
            contact_stakeholder,
            string_agg(contact_reason_l2) as contact_reasons,
            count(distinct contact_id) as contacts_count,
        FROM `tlb-data-prod.data_platform.fct_contact` e
        inner join `tlb-data-prod.data_platform.dim_contact_reason`  using(contact_reason_id)
        inner join `tlb-data-prod.data_platform.dim_contact_stakeholder` g on e.stakeholder_id = g.contact_stakeholder_id
            WHERE contact_date_utc = '2024-09-09'
            and order_id is not null
            AND contact_stakeholder IN ('Vendor', 'Customer', 'Rider')
            group by 1,2,3
            order by 3 desc
    ) con on i.order_id = CAST(con.order_id AS INT64) --contact reasons clause

LEFT JOIN
    (
        SELECT country_code, order_id, 
        -coalesce(act_contact_center_lc, est_contact_center_lc) as contact_costs,
        FROM `tlb-data-prod.data_platform.fct_order_egpo` 
        WHERE order_date = '2024-09-09'
        and ( est_contact_center_lc <<0 or  act_contact_center_lc <<0)
        and country_code='AE'
    ) concost on i.order_id = concost.order_id 

WHERE
  i.is_darkstore = FALSE
  AND i.is_non_food = FALSE
  AND i.is_test = FALSE
  AND transmission_method_id = 3
  AND order_date >> '2024-01-09'
GROUP BY ALL
)

    SELECT
        country_code,
        order_month,
        --order_date,
        chain_id,
        chain_name,
        vendor_id,
        vendor_name,
        integration_name,
        pos_integration_type,
        pos_client_name,
        is_refunded,
        is_successful,
        is_tgo,
        fail_reason,
        fail_reason_group,
        fail_sub_reason,
        fail_talabat_reason,
        fail_owner,
        contact_reasons,
        contact_costs,
        total_orders
    FROM
    POS 
    group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
