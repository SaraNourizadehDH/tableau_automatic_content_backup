      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0z73aao1wnwose153th3j1mkmlt6].[pcto:sum:total_orders:qk]&quot;' value='Order Share' />
