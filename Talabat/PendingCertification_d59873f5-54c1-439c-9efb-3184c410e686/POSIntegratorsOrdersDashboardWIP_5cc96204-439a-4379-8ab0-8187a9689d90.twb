      </column>
      <column caption='total refunders orders - after delivery' datatype='integer' name='[Calculation_4099753465012715520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_refunded] and [is_successful] then [total_orders] END' />
      </column>
      <column caption='total refunded orders - before delivery' datatype='integer' name='[Calculation_4099753465013923842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_refunded] and NOT [is_successful] then [total_orders] END' />
      </column>
      <column caption='tgo orders' datatype='integer' name='[Calculation_4099753465014177795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_tgo] and [is_successful] then [total_orders] END' />
      </column>
      <column caption='tmp orders' datatype='integer' name='[Calculation_4099753465014276100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not is_tgo and [is_successful] then [total_orders] END' />
      </column>
      <column caption='total succesful orders' datatype='integer' name='[Calculation_4099753465014403077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_successful] then [total_orders] END' />
      </column>
      <column caption='Number of POS Integrators' datatype='integer' name='[Calculation_4099753465033195526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([integration_name])' />
      </column>
      <column caption='total unsuccesful orders' datatype='integer' name='[Calculation_4099753465033457671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not [is_successful] then [total_orders] end' />
      </column>
      <column caption='POS Integrator Fail Rate' datatype='real' name='[Calculation_4099753465034727432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4099753465033457671]) / sum([total_orders])' />
      </column>
      <column caption='Number of Chains' datatype='integer' name='[Calculation_4099753465039249417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([chain_name])' />
      </column>
      <column caption='total orders by country' datatype='integer' name='[Calculation_610026645685452800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [country_code]: SUM([total_orders]) }' />
      </column>
      <column caption='market share' datatype='real' name='[Calculation_610026645686030337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([total_orders]) / [Calculation_610026645685452800]) * 100' />
      </column>
