  <datasources>
    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.0uskjt51fjoroe112out6063xfbh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0o9te0r024okj3180kg7e0xhn7j9'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ali.anees@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0o9te0r024okj3180kg7e0xhn7j9' name='Custom SQL Query' type='text'><![CDATA[with base as (    SELECT
       k.vendor_id,
   case when snapshot_date >>= '2025-06-04' and snapshot_date <<'2025-07-04' then 'before_adcredit' 
   
   else 'after_adcredit'

     end as before_or_after_adcredit, 
     snapshot_date, 
     k.country_code,
     vendor_grade,
     date_trunc(snapshot_date,month) as month,
     
     sum(successful_order_count) as succ_orders, 
    /* sum(gmv_amount_eur) as gmv, 
     sum(vendor_acquisition_customer_count) as new_customers_to_vendors_numbers,
    sum(platform_acquisition_customer_count) as platform_new_customers_to_vendors_numbers,
    sum( IFNULL((cpp_featured_product_revenue_eur),0) +
IFNULL((kwords_revenue_eur),0) +
IFNULL((cpp_revenue_eur),0) +
IFNULL((deal_targeting_revenue_eur),0) +
IFNULL((gem_commission_amount_eur),0) +
--IFNULL((organic_placement_revenue_eur),0) +
IFNULL(display_ads_revenue_eur,0)) ad_rev,
sum(ifnull(cpc_revenue_eur,0)) as cpc,
sum(ifnull(discount_amount_eur,0)) as discount,


--- add here offline time 
sum(offline_duration_in_hours) as offline_duration_in_hours,
sum(schedule_duration_in_hours) as schedule_duration_in_hours,
-- dlp and dld 
max(active_menu_item_count) as active_menu_item_count, 
max(item_with_image_count) as item_with_image_count,
max(item_with_description_count) as item_with_description_count,
-- Engagement vs Impressions 
sum(vendor_list_impression_session_count) as vendor_list_impression_count,
sum(viewed_menu_session_count) as viewed_menu_session_count,
sum(order_count) as placed_order_count

*/

     FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` k
     left join `tlb-data-prod.data_platform.dim_vendor_info` v on k.vendor_id=v.vendor_id
     WHERE vertical = 'food'
       AND snapshot_date >>= '2025-06-04'  -- December 2024
       --AND is_active  -- Only active vendors
       --and is_contracted
       and k.country_code <<>> 'SA'
       and k.vendor_id in (760191,
754732,
