    <worksheet name='Impact Table (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='winning dubai' name='federated.0f6r2wl18ewor113a7px90xmtxro' />
          </datasources>
          <datasource-dependencies datasource='federated.0f6r2wl18ewor113a7px90xmtxro'>
            <column caption='% on time (+-10 mins)' datatype='real' default-format='p0.00%' name='[% Delay &gt; 10 mins (copy)_2915869656896036871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [delay_group]=&apos;on_time&apos; and [is_successful] then [order_count] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Rider Payment' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Basket Value LC  (copy)_3730950838892896266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [rider_payment] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg eGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Basket Value LC  (copy)_3730950838899482635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([est_egpo_lc]) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Compensation Cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Contact Cost (copy)_3730950838994034702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([compensation_cost]) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Commission Lc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Delivery Fee LC (copy)_3730950838598950919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [successful_commission_amount_lc]end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Service Fee LC' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Delivery Fee LC (copy)_5891341636393205763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [service_fee_amount_lc] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg To customer drive time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Drive time (mins) (copy)_2915869656895586309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [to_customer_mins] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Contact Cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Rider Payment (copy)_3730950838993776653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([contact_costs] ) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg Basket Value LC ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Service Fee LC (copy)_5891341636398825477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [basket_amount_lc] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Avg To vendor drive time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg to customer time (mins) (copy)_2915869656895692806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [to_vendor_mins] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Logistics Group' datatype='string' name='[Calculation_2409355436290662400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [is_expanded_vendor] then &quot;Non Expanded Vendors&quot;&#10;ELSEIF [is_expanded_vendor] and not [from_expanded_area] then &quot;Expanded vendors: Original delivery areas&quot;&#10;ELSEIF [Calculation_5210805508941680655] then &quot;Expanded vendors: Expanded delivery areas&quot;&#10;end' />
            </column>
            <column caption='Contact rate (from Customers and Riders)' datatype='real' default-format='p0.00%' name='[Calculation_2915869656890458112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([contacts_count]) / sum([order_count])' />
            </column>
            <column caption='% Delay &gt; 10 mins' datatype='real' default-format='p0.00%' name='[Calculation_2915869656894267393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [delay_group]=&apos;delay&gt;10&apos; and [is_successful] then [order_count] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Drive Time (mins)' datatype='real' name='[Calculation_2915869656894754818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[to_customer_mins] + [to_vendor_mins]' />
            </column>
            <column caption='Avg Drive time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2915869656895213572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [Calculation_2915869656894754818] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Stacking %' datatype='real' default-format='p0.00%' name='[Calculation_2915869656910336009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_stacked] and [is_successful] then [order_count] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_2915869657225662486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_successful] then [order_count] end' />
            </column>
            <column caption='Net orders' datatype='integer' name='[Calculation_2915869657231917079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_net] then [order_count] end' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2915869657531945002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2915869657225662486]) / sum([order_count])' />
            </column>
            <column caption='Succ Basket Amount' datatype='real' name='[Calculation_3730950838932770828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_successful] then [basket_amount_lc] end' />
            </column>
            <column caption='Net Revenue Per Order (RPO - CPO)' datatype='real' name='[Calculation_3730950838994976783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_522699037174185986] - [Calculation_5210805508945932304]' />
            </column>
            <column caption='Total cost' datatype='real' name='[Calculation_5210805508936622080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([rider_payment],0) &#10;+IFNULL([compensation_cost],0) &#10;+ IFNULL([contact_costs],0)' />
            </column>
            <column caption='is expanded vendor and expanded area' datatype='boolean' name='[Calculation_5210805508941680655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_expanded_vendor] and [from_expanded_area]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5210805508945932304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5210805508936622080]) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Successful order fees' datatype='real' name='[Calculation_522699037172920321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_successful] then [Calculation_5891341636392681474] end' />
            </column>
            <column caption='RPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_522699037174185986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_522699037172920321]) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Gross orders' datatype='integer' name='[Calculation_5891341636390215680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_abandoned] then [order_count] end' />
            </column>
            <column caption='Avg Delivery Fee LC' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5891341636392419329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [delivery_fee_amount_lc] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='fees' datatype='real' name='[Calculation_5891341636392681474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([delivery_fee_amount_lc],0) + IFNULL([service_fee_amount_lc],0)&#10;+ IFNULL([successful_commission_amount_lc],0)' />
            </column>
            <column caption='Avg Delay (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5891341636665163814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_successful] then [delay_sum] end) / sum([Calculation_6103433029147918336])' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_6103433029147918336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_successful] then [order_count] end' />
            </column>
            <column caption='Logistics Failed Orders' datatype='integer' name='[Failed Orders (copy)_2915869657239592987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_logistics_fail_reason] and not [is_successful] then [order_count] end' />
            </column>
            <column caption='Logistics Fail Rate' datatype='real' default-format='p0.00%' name='[General Fail Rate (copy)_2915869657193451540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Failed Orders (copy)_2915869657239592987]) / sum([order_count])' />
            </column>
