      <column caption='Logistics Failed Orders' datatype='integer' name='[Failed Orders (copy)_2915869657239592987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_logistics_fail_reason] and not [is_successful] then [order_count] end' />
