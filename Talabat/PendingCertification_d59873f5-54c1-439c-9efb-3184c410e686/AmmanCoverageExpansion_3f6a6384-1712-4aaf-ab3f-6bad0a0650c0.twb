          </datasources>
          <datasource-dependencies datasource='federated.0f6r2wl18ewor113a7px90xmtxro'>
            <column caption='CPO other area' datatype='real' name='[CPO expanded area (copy)_5210805508939628553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if not [Calculation_5210805508941680655] then [Calculation_5210805508936622080] end )/ sum(if not [Calculation_5210805508941680655] then [Calculation_6103433029147918336] end)' />
            </column>
            <column caption='Total cost' datatype='real' name='[Calculation_5210805508936622080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([rider_payment],0) &#10;+IFNULL([compensation_cost],0) &#10;+ IFNULL([contact_costs],0)' />
            </column>
            <column caption='CPO expanded area' datatype='real' name='[Calculation_5210805508939399176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_5210805508941680655] then [Calculation_5210805508936622080] end )/ sum(if [Calculation_5210805508941680655] then [Calculation_6103433029147918336] end)' />
            </column>
            <column caption='Incremental CPO' datatype='real' name='[Calculation_5210805508939730954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_5210805508939399176],0) - IFNULL([CPO expanded area (copy)_5210805508939628553],0)' />
            </column>
            <column caption='is expanded vendor and expanded area' datatype='boolean' name='[Calculation_5210805508941680655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_expanded_vendor] and [from_expanded_area]' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_6103433029147918336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_successful] then [order_count] end' />
            </column>
            <column caption='Compensation Cost' datatype='real' name='[compensation_cost]' role='measure' type='quantitative' />
            <column caption='Contact Costs' datatype='real' name='[contact_costs]' role='measure' type='quantitative' />
            <column datatype='string' name='[expansion_batch]' role='dimension' type='nominal' />
            <column caption='From expanded delivery area' datatype='boolean' name='[from_expanded_area]' role='dimension' type='nominal' />
            <column caption='Is Expanded Vendor' datatype='boolean' name='[is_expanded_vendor]' role='dimension' type='nominal' />
            <column caption='Is Successful' datatype='boolean' name='[is_successful]' role='dimension' type='nominal' />
            <column-instance column='[expansion_batch]' derivation='None' name='[none:expansion_batch:nk]' pivot='key' type='nominal' />
