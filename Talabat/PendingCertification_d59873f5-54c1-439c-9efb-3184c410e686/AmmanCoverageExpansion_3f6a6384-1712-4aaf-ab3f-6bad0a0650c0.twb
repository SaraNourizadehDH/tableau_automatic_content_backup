            <column caption='Contact rate (Customer)' datatype='real' default-format='p0.00%' name='[Contact rate (from Customers and Riders) (copy)_3730950839366799378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_contacts_count]) / sum([order_count])' />
