      </column>
      <column caption='Initiative Cost LC' datatype='real' name='[Calculation_5210805508940587021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5891341636395556868] * sum([Calculation_5210805508940980238])' />
