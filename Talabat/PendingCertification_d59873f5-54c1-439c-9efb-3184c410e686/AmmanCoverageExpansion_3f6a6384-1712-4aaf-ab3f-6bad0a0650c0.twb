      <column caption='orders count fixed' datatype='integer' name='[Calculation_2915869657119367186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_2409355436290662400] : sum([Calculation_2915869657231917079])}' />
