      <column caption='Order counts per thousand orders' datatype='real' default-format='n#,##0.00000;-#,##0.00000' name='[Calculation_5891341636414627861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2915869657231917079]) / sum([Calculation_2915869657119367186]) * 1000' />
