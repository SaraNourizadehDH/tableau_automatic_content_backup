      <column caption='Date granularity' datatype='datetime' name='[Calculation_6103433029154250754]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;Day&quot; then DATETRUNC(&apos;day&apos;, [order_date])&#10;when &quot;Week&quot; then DATETRUNC(&apos;week&apos;, [order_date])&#10;when &quot;Month&quot; then DATETRUNC(&apos;month&apos;, [order_date])&#10;when &quot;Year&quot; then DATETRUNC(&apos;year&apos;, [order_date])&#10;end' />
      </column>
      <column caption='my gran' datatype='string' name='[Calculation_6103433029154803715]' role='dimension' type='nominal'>
