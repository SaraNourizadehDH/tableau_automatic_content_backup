    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/DineOutChurnDashboard/Glossary?rev=' id='Glossary' path='/t/Talabat/workbooks/DineOutChurnDashboard' revision='' site='Talabat' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone forceUpdate='true' h='51000' id='3' type-v2='text' w='98600' x='100' y='125'>
          <formatted-text>
            <run bold='true' fontcolor='#690000'>Churn Definition </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000'>Churn - Next Month</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>A user is considered churned if they placed a DineOut order in </run>
            <run bold='true' fontcolor='#000000'>Month 1</run>
            <run fontcolor='#000000'> but </run>
            <run bold='true' fontcolor='#000000'>did not place any order in Month 2</run>
            <run fontcolor='#000000'>.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Churn - 30 Days</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>A user is considered churned if they </run>
            <run bold='true' fontcolor='#000000'>do not return to place another DineOut order within 30 days</run>
            <run fontcolor='#000000'> of their </run>
            <run bold='true' fontcolor='#000000'>last DineOut order</run>
            <run fontcolor='#000000'>.</run>
            <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
            <run bold='true' fontcolor='#690000'>Churn by KPIs</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000'>Average DineOut GMV segment  </run>
            <run fontcolor='#000000'>: Categorizes users based on their average DineOut GMV per order</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Average DineOut Discount : </run>
            <run fontcolor='#000000'>Total DineOut Discount in the month / Total Basket in the month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Platform Order Segment        :  </run>
            <run fontcolor='#000000'>Customer segment based on Platform orders (0=inactive, 1=first timers, 2-3= low, 4-8=Mid and Greater than 9= high)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Lifetime DineOut Orders : </run>
            <run fontcolor='#000000'>Total number of DineOut orders placed by a user since their acquisition uptil the month </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Monthly DineOut Orders : </run>
            <run fontcolor='#000000'>Number of DineOut orders made by a user in the month prior to churn.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Is tPro</run>
            <run fontcolor='#000000'> :Flag indicating whether the user is a tPro in the month prior to churn</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Is DineOut Acquisition : </run>
            <run fontcolor='#000000'>Indicates whether the user was a DineOut acquisition in the month prior to churn</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='44' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98000' id='43' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
                <zone forceUpdate='true' h='51000' id='3' type-v2='text' w='98600' x='100' y='125'>
                  <formatted-text>
                    <run bold='true' fontcolor='#690000'>Churn Definition </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Churn - Next Month</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>A user is considered churned if they placed a DineOut order in </run>
                    <run bold='true' fontcolor='#000000'>Month 1</run>
                    <run fontcolor='#000000'> but </run>
                    <run bold='true' fontcolor='#000000'>did not place any order in Month 2</run>
                    <run fontcolor='#000000'>.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>Churn - 30 Days</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>A user is considered churned if they </run>
                    <run bold='true' fontcolor='#000000'>do not return to place another DineOut order within 30 days</run>
                    <run fontcolor='#000000'> of their </run>
                    <run bold='true' fontcolor='#000000'>last DineOut order</run>
                    <run fontcolor='#000000'>.</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
