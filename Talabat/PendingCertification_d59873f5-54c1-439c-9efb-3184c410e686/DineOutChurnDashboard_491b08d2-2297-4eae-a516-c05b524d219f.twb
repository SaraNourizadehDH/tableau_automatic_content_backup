      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8E1C793A7EEA4A9C9E63AA4C3717FA6E'>
            <properties context=''>
              <relation connection='bigquery.02xf20z0xm8v5f14r3u7u1045aqy' name='Custom SQL Query' type='text'>-- Step 1: Get acquisition info (first tdine order)
with acquisition as (
  select 
    o.account_id,
    order_date as acquisition_date,
    order_time as acquisition_time
  from `tlb-data-prod.data_platform.fct_order_info` as o
  inner join `tlb-data-prod.data_platform.dim_account` as a
  on o.account_id=a.account_id
  where
    is_successful
    and lower(o.email) not like &quot;%talabat.com&quot;
    and lower(delivery_arrangement)=&quot;tdine&quot;
  qualify row_number() over (partition by o.account_id order by order_time) = 1
)


-- Step 2: All successful tdine orders with lead for next order
,orders as (
  select
    account_id,
    order_date,
    date_trunc(order_date, month) as order_month,
    lead(order_date) over (partition by account_id order by order_date) as next_order_month,
    lead(order_date) over (partition by o.account_id order by order_date) as next_order_date,
  from `tlb-data-prod.data_platform.fct_order_info` as o
  where 
    is_successful
    and lower(o.email) not like &quot;%talabat.com&quot;
    and lower(delivery_arrangement) = &quot;tdine&quot;
)

-- Step 3: Join acquisition to tag order type and churn status
,churn_tagged as (
  select
    o.account_id,
    o.order_month,
    max(case when date_trunc(o.order_date, month) = date_trunc(a.acquisition_date, month) then true else false end)as is_acquisition,
min(case
  when o.next_order_month is null then true
  when date_trunc(o.next_order_date, month) &gt;&gt; date_add(o.order_month, interval 1 month) then true
  when date_trunc(o.next_order_date, month) = date_add(o.order_month, interval 1 month) then false
  else false
end) as is_churn_next_month,
    CASE
  WHEN o.next_order_date IS NULL THEN TRUE
  WHEN o.next_order_date &gt;&gt; DATE_ADD(o.order_date, INTERVAL 30 DAY) THEN TRUE
  ELSE FALSE
END AS is_churn_30d
  from orders o
  left join acquisition a on o.account_id = a.account_id
  group by all
)


select
  order_month as month,
  is_acquisition,
  count(distinct account_id) as total_users,

  count(distinct case when is_churn_next_month then account_id end) as churned_next_month,
  round(count(distinct case when is_churn_next_month then account_id end)  / count(distinct account_id), 2) as churn_rate_next_month,

  count(distinct case when is_churn_30d then account_id end) as churned_30d,
  round(count(distinct case when is_churn_30d then account_id end) / count(distinct account_id), 2) as churn_rate_30d

from churn_tagged

group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='main - segments' inline='true' name='federated.1guuyfp1w3xhd0103238318eedff' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.10iijx70t2wxnh1d94tdn0eiey3j'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hajira.zulfiqar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.10iijx70t2wxnh1d94tdn0eiey3j' name='Custom SQL Query' type='text'><![CDATA[--create or replace table tlb-data-dev.data_playground.dineout_churn_deepdive as 
with acquisition as (
  select 
    o.account_id,
    order_date as acquisition_date,
    order_time as acquisition_time
  from `tlb-data-prod.data_platform.fct_order_info` as o
  inner join `tlb-data-prod.data_platform.dim_account` as a
  on o.account_id=a.account_id
  where
    is_successful
    and lower(o.email) not like "%talabat.com"
    and lower(delivery_arrangement)="tdine"
  qualify row_number() over (partition by o.account_id order by order_time) = 1
)


,orders as (
  select
    o.account_id,
    order_date,
    date_trunc(order_date, month) as order_month,
    lead(order_date) over (partition by o.account_id order by order_date) as next_order_date,
    lead(date_trunc(order_date,month)) over (partition by o.account_id order by order_date) as next_order_month,
    gmv_amount_lc,
    basket_amount_lc,
    discount_amount_lc,
    case when s.account_id is not null then true else false end as is_tpro_customer
    
  from `tlb-data-prod.data_platform.fct_order_info` as o
  left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as s
  on o.account_id=s.account_id
  and o.order_date=s.iso_date
  and o.order_time between start_date and end_date
  and lower(subscription_state)<<>>"BILLING RETRY"

  where 
    is_successful
    and lower(o.email) not like "%talabat.com"
    and lower(delivery_arrangement) = "tdine"
    order by 2
)

-- select * from orders
-- where account_id=28604697

-- Step 3: Aggregate monthly KPIs per user
,user_kpis as (
  select
    account_id,
    order_month,
    count(*) as order_count,
    sum(gmv_amount_lc) as gmv_total,
    avg(gmv_amount_lc) as gmv_avg,
    sum(basket_amount_lc) as basket_total,
    avg(basket_amount_lc) as basket_avg,
    sum(discount_amount_lc) as discount_total,
    avg(discount_amount_lc) as discount_avg,
    sum(discount_amount_lc)/sum(basket_amount_lc) as discount_percent_avg,
    min(order_date) as first_order_date,
    max(order_date) as last_order_date,
    date_diff(max(order_date), min(order_date), day) as activity_span_days,
    sum(count(*)) over (partition by account_id order by order_month rows between unbounded preceding and current row) as lifetime_order_count,
    max(is_tpro_customer) as is_tpro_customer


  from orders
  group by 1, 2
)




-- Step 4: Tag churn outcomes
,churn_tagged as (
  select
    o.account_id,
    o.order_month,
    max(case when date_trunc(o.order_date, month) = date_trunc(a.acquisition_date, month) then true else false end)as is_acquisition,
    min(case
      when o.next_order_month is null then true
      when date_trunc(o.next_order_date, month)=order_month then true
      when date_trunc(o.next_order_date, month) >> date_add(o.order_month, interval 1 month) then true
      else false
    end) as is_churn_next_month
  from orders o
  left join acquisition a on o.account_id = a.account_id
  group by all
)



,hard_churn_flag as (
  select
    account_id,
    case when count(*) = 1 then true else false end as is_hard_churn
  from orders
  group by account_id
)

,last_month_orders as (
  select
    account_id,
    date_trunc(order_date,month) as order_month,
    count(distinct order_id) as last_month_order_count
  from tlb-data-prod.data_platform.fct_order_info as o
  where is_successful
  group by all
)


,final_dataset as (
  select
    k.*,
    c.is_acquisition,
    c.is_churn_next_month,
    l.last_month_order_count,

    case 
      when l.last_month_order_count is null or l.last_month_order_count = 0 then '1.inactive'
      when l.last_month_order_count = 1 then '2.first_time'
      when l.last_month_order_count between 2 and 3 then '3.low'
      when l.last_month_order_count between 4 and 8 then '4.mid'
      else '5.high'
    end as order_segment
  from user_kpis k
  left join churn_tagged c
    on k.account_id = c.account_id and k.order_month = c.order_month
  left join last_month_orders l
    on k.account_id = l.account_id and k.order_month = date_add(l.order_month,interval 1 month)
)

select * from final_dataset]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
