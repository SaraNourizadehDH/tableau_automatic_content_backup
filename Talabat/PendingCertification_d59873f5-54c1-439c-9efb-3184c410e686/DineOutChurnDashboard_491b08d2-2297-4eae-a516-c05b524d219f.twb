      <column caption='DineOut Acquisition' datatype='string' name='[is_tpro (copy)_1170021144340873236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_acquisition]=TRUE&#10;then &quot;DineOut Acquisition&quot;&#10;else &quot;DineOut Existing User&quot; END' />
