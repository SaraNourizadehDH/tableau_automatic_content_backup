    <worksheet name='over view'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Next Month Churn by &lt;</run>
            <run bold='true' fontsize='12'>[Parameters].[Parameter 2]</run>
            <run bold='true' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='main - segments' name='federated.1guuyfp1w3xhd0103238318eedff' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Platform Order Segment' caption='KPI Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Segment&quot;'>
              <calculation class='tableau' formula='&quot;Order Segment&quot;' />
              <aliases>
                <alias key='&quot;Average GMV segment&quot;' value='Average DineOut GMV segment (AED)' />
                <alias key='&quot;Discount Threshold&quot;' value='Average DineOut Discount % Threshold' />
                <alias key='&quot;Order Segment&quot;' value='Platform Order Segment' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1guuyfp1w3xhd0103238318eedff'>
            <column caption='Discount Threshold' datatype='string' name='[Calculation_1170021144000315398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[discount_percent_avg] &lt;0.10 then &apos;1.Less than 10%&apos;&#10;ELSEIF [discount_percent_avg] &gt;= 0.10 and [discount_percent_avg]&lt;0.20 then &apos;2. Less than 20%&apos;&#10;ELSEIF [discount_percent_avg] &gt;= 0.20 and [discount_percent_avg]&lt;=0.30 then &apos;3.Less than 30%&apos;&#10;else &quot;4. More than 30%&quot;&#10;end' />
            </column>
            <column caption='churn' datatype='integer' name='[Calculation_1170021144001224711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [is_churn_next_month]&#10;when true&#10;then 1 END' />
            </column>
            <column caption='Churn %' datatype='real' name='[Calculation_1170021144002097160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1170021144001224711])/COUNTD([account_id])' />
            </column>
            <column caption='Average GMV segment' datatype='string' name='[Calculation_1170021144009134089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[gmv_avg]&lt;170 then &quot;1.Less than AED 170&quot;&#10;elseif [gmv_avg]&gt;=170 and [gmv_avg]&lt;270 THEN &quot;2.Less than 270&quot;&#10;else &quot;3.More than 270&quot; END' />
            </column>
            <column caption='KPI' datatype='string' name='[Calculation_1170021144010539019]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Average GMV segment&apos; then [Calculation_1170021144009134089]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Discount Threshold&apos; then [Calculation_1170021144000315398]&#10;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Order Segment&apos; then [order_segment]&#10;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Lifetime DineOut Orders&apos; then [Calculation_1170021144040370190]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Monthly DineOut Orders&apos; then [Calculation_1170021144307478546]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Is tPro&apos; then [Calculation_1170021144339603475]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Is DineOut Acquisition&apos; then [is_tpro (copy)_1170021144340873236]&#10;else null end' />
            </column>
            <column caption='Lifetime DineOut Order Count' datatype='string' name='[Calculation_1170021144040370190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lifetime_order_count] &lt; 2 THEN&#10;    &quot;1. One Order Only&quot;&#10;ELSEIF [lifetime_order_count] &gt;= 2 AND [lifetime_order_count] &lt;= 5 THEN&#10;    &quot;2. Less than 6 Orders&quot;&#10;ELSEIF [lifetime_order_count] &gt;= 6 AND [lifetime_order_count] &lt;= 10 THEN&#10;    &quot;3. Less than 11 Orders&quot;&#10;ELSEIF [lifetime_order_count] &gt;= 11 AND [lifetime_order_count] &lt;= 15 THEN&#10;    &quot;4. Less than 16 Orders&quot;&#10;ELSE&#10;    &quot;5. 16+ Orders&quot;&#10;END' />
            </column>
            <column caption='Exclude Current Month' datatype='boolean' name='[Calculation_1170021144298725393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Monthly DineOut Orders Threshold' datatype='string' name='[Calculation_1170021144307478546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_count]=1 then &quot;1 Orders&quot;&#10;ELSEIF [order_count]&gt;1 and  [order_count]&lt;=2  then &quot;2 Orders&quot;&#10;ELSEIF [order_count]&gt;=3 and [order_count]&lt;=5 then &quot;3-5 Orders&quot;&#10;ELSEIF [order_count]&gt;5 and [order_count]&lt;=10 then &quot;6-10 Orders&quot;&#10;ELSE &quot;11 or more&quot; END' />
            </column>
            <column caption='is_tpro' datatype='string' name='[Calculation_1170021144339603475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_tpro_customer]=TRUE&#10;then &quot;tPro&quot;&#10;else &quot;Non-tPro&quot; END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
            <column-instance column='[account_id]' derivation='CountD' name='[ctd:account_id:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[discount_percent_avg]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_avg]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_churn_next_month]' role='dimension' type='nominal' />
            <column caption='DineOut Acquisition' datatype='string' name='[is_tpro (copy)_1170021144340873236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_acquisition]=TRUE&#10;then &quot;DineOut Acquisition&quot;&#10;else &quot;DineOut Existing User&quot; END' />
            </column>
            <column datatype='boolean' name='[is_tpro_customer]' role='dimension' type='nominal' />
            <column datatype='integer' name='[lifetime_order_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1170021144010539019]' derivation='None' name='[none:Calculation_1170021144010539019:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1170021144298725393]' derivation='None' name='[none:Calculation_1170021144298725393:nk]' pivot='key' type='nominal' />
