            </columns>
          </relation>
          <relation connection='bigquery.0thcr0202tawab163ymv90x5j4kw' name='Custom SQL Query' type='text'><![CDATA[SELECT DATE_TRUNC(order_date, MONTH) month,country_Code,vendor_id,

SUM(gmv_amount_eur) gmveur , SUM(gmv_amount_lc) gmvlc, COUNT(DISTINCT order_id) orders

from `tlb-data-prod.data_platform.fct_order_info`

WHERE order_date>>='2025-01-01' and order_date<<='2025-06-30'
and is_successful = TRUE
and is_test = false

GROUP BY ALL]]></relation>
          <relation connection='bigquery.0thcr0202tawab163ymv90x5j4kw' name='Custom SQL Query1' type='text'>SELECT date_trunc(date,MONTH) date, product, SAFE_CAST(vendor_id AS INT) vendor_id,&#13;
&#13;
SAFE_DIVIDE(SUM(gmv_local_direct),SUM(revenue)) ROAS,SUM(gmv_local_direct) gmvlc,SUM(revenue) revenue&#13;
&#13;
,  FROM `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily_local_v2`&#13;
&#13;
WHERE date&gt;&gt;= &quot;2025-01-01&quot; and product = &apos;organic_placements&apos;&#13;
&#13;
GROUP BY ALL</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
