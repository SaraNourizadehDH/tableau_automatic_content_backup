      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2A2DD84477854E3583CD3F428BAF67E9'>
            <properties context=''>
              <relation connection='bigquery.1i2hz1t0g0l4ak1a0haax1tlcyoj' name='Custom SQL Query' type='text'><![CDATA[with RKA_universe as 
(
    select ch.chain_id, 

    case 
        when ((lower(ch.chain_name) LIKE lower("PF Chang%")) OR (lower(ch.chain_name) LIKE lower("P.F Chang%")) OR (lower(ch.chain_name) LIKE lower("P.F. Chang%")) ) then 'P.F Chang' 
        when (lower(ch.chain_name) LIKE lower("Blaze Pizza")) then 'Blaze Pizza'
        when (lower(ch.chain_name) LIKE lower("Raising Cane%")) then 'Raising Cane'
        when (lower(ch.chain_name) LIKE lower("Pinkberry%")) then 'Pinkberry'
        when (lower(ch.chain_name) LIKE lower("The Cheesecake Fac%")) then 'The Cheesecake Factory'
        when (lower(ch.chain_name) LIKE lower("Shake Shack%")) then 'Shake Shack'
        when (lower(ch.chain_name) LIKE lower("Texas Roadhouse")) then 'Texas Roadhouse'
        when (lower(ch.chain_name) LIKE lower("Asha's")) then "Asha's"
        when (lower(ch.chain_name) LIKE lower("%Le Pain Quotidien%")) then 'Le Pain Quotidien'
        when (lower(ch.chain_name) LIKE lower("Amiti Noura%")) then 'Amiti Noura'
        when (lower(ch.chain_name) LIKE lower("%Dean & Deluca%")) then 'Dean & Deluca'
        when (lower(ch.chain_name) LIKE lower("Bitza")) then 'Bitza'
        when (lower(ch.chain_name) LIKE lower("Pizza Express%")) then 'Pizza Express'
        when (lower(ch.chain_name) LIKE lower("Bouchon Bakery%")) then 'Bouchon Bakery'
        when (lower(ch.chain_name) LIKE lower("Bu Burger%")) then 'Bu Burger'
        when ((lower(ch.chain_name) LIKE lower("Babel")) OR (lower(ch.chain_name) LIKE lower("BeBabel"))) then 'BeBabel'
        when (lower(ch.chain_name) LIKE lower("Ahwet Zeitouna%")) then 'Ahwet Zeitouna'
        when (lower(ch.chain_name) LIKE lower("%DIYAY%")) then 'DIYAY'
    end as chain_name, 

    'Al Shaya' as group_name, ch.country_name

    from `tlb-data-prod.data_platform.dim_chain` AS ch 
    LEFT JOIN `tlb-data-prod.data_platform.dim_brand` AS br ON br.brand_id = ch.brand_id
    left join `tlb-data-prod.data_platform.dim_country_info` as ci on ci.country_id = ch.country_id

    where ch.vertical = 'food'

    and ch.chain_id IN (652042, 657579, 8421, 602074, 651855, 634094, 634039, 22044, 648279, 636006, 636007, 636012, 636011, 636009, 636008, 642286, 664625, 648475, 
        648477, 7214, 648473, 648505, 648476, 648474, 14722, 650356, 648114, 638809, 662096, 638804, 638805, 638798, 638801, 638799, 638802, 638807, 652644, 647606, 
        650221, 638797, 638810, 642103, 638800, 11165, 638806, 625215, 638808, 638803, 661655, 634349, 14320, 633558, 633564, 625216, 10566, 633567, 630233, 11953, 
        633575, 646800, 638025, 633566, 633563, 633570, 633569, 633565, 664142, 664239, 664240, 664242, 664241, 28695, 28690, 19765, 660245, 656262, 660246, 660247, 
        660249, 660248, 601480, 656239, 28291, 627, 634158, 634165, 652410, 634159, 634166, 634161, 634162, 634168, 663768, 600486, 632685, 634170, 652588, 652587, 
        634172, 634171, 634453, 634167, 634169, 11044, 609495, 10802, 27041, 634153, 634151, 7219, 634152, 634150, 634160, 634143, 634149, 634146, 532, 634147, 634632, 
        634139, 661193, 634142, 634137, 10563, 634136, 634148, 634141, 634164, 666120, 658916, 527, 634140, 634174, 634175, 634173, 634182, 634181, 634183, 634184, 634179, 
        634178, 634176, 633748, 633777, 633755, 9519, 650886, 658917, 633778, 633750, 633776, 659566, 633756, 633780, 633781, 633751, 658640, 633753, 658742, 658740, 633754, 
        633749, 658741, 633782, 633779, 8323, 658739, 633752, 653320, 665245, 633783, 15417, 7879, 634154, 634155, 634457, 635686, 636230, 9254, 635563, 12588, 657813, 657812, 
        9257, 654872, 9133, 654841, 654910, 665393, 11110, 634352, 634465, 10698, 633730, 633733, 665391, 600149, 14821, 663163, 10268, 647422, 647421, 10766, 652180, 651961, 
        646281, 635124, 635125, 12271, 646288, 656827, 633725, 633721, 633724, 633720, 10276, 656830, 600299, 12268, 661324, 661338, 661783, 11570, 661609, 15712, 662875, 662876, 
        662881, 16869, 662769, 663389, 20518, 506743)
    
    group by 1,2,3,4


    UNION ALL

    select ch.chain_id, 'Starbucks' as chain_name, 'Starbucks' as group_name, ch.country_name

    from `tlb-data-prod.data_platform.dim_chain` AS ch 
    LEFT JOIN `tlb-data-prod.data_platform.dim_brand` AS br ON br.brand_id = ch.brand_id
    where ( (lower(ch.chain_name) LIKE lower("starbuck%")) ) 
    and ch.vertical = 'food'
    group by 1,2,3,4



    UNION ALL 

    select ch.chain_id, ch.chain_name, 'Kitopi' as group_name, ch.country_name

    from `tlb-data-prod.data_platform.dim_chain` AS ch 
    LEFT JOIN `tlb-data-prod.data_platform.dim_brand` AS br ON br.brand_id = ch.brand_id
    
    where ch.chain_id In (1673, 625609, 15348, 628590, 632445, 639444, 11801, 13715, 5647, 7100, 7101, 7102, 28777, 630637, 631957, 637645, 24872, 19322, 600654, 29195, 640316, 1106, 1083, 1197, 8717, 632773, 1482, 635649, 641592, 627268, 631725, 637644, 634884, 634910, 635885, 23784, 634991, 637643, 25610, 628592, 631457, 611756, 631788, 29193, 28139, 612702, 620101, 17157, 611695, 628565, 13421, 628569, 637612, 606235, 612706, 648682, 648627, 626864, 632033, 630620, 19708, 628573, 609368, 2069, 12813, 620297, 602091, 15032, 25014, 25015, 25016, 25018, 25019, 25020, 25930, 601460, 620181, 629162, 637760, 11802, 24593, 622876, 15955, 628568, 1483, 28525, 19464, 23508, 624500, 494, 619322, 631724, 629499, 614267, 9439, 11367, 628593, 635646, 620109, 616659, 638990, 633291, 612704, 9564, 9828, 19657, 619149, 8716, 641537, 631734, 625157, 640577, 9292, 612705, 17076, 619320, 614261, 627511, 25922, 638991, 4650, 17138, 616655, 10469, 628572, 602452, 624217, 9307, 628566, 1979, 609370, 656604, 1945, 25101, 24800, 3078, 644940, 644897, 617381, 643284, 651255, 643281, 651256, 651253, 646328, 651257, 651254, 630443, 627490, 26904, 627320, 628269, 22996, 627341, 8883, 13776, 654450, 654448, 644235, 644236)
    
    and ch.vertical = 'food'
    group by 1,2,3,4



    UNION ALL

    select ch.chain_id, 

    case 
        when lower(dim_chain_chain_name) like lower('Baskin Robbins%') then 'Baskin Robbins'
        when lower(dim_chain_chain_name) like lower('Chicken Tikka%') then 'Chicken Tikka'
        when lower(dim_chain_chain_name) like lower('Costa Coffee%') then 'Costa Coffee'
        when lower(dim_chain_chain_name) like lower('Grand Cafe%') then 'Grand Cafe'
        when lower(dim_chain_chain_name) like lower('Hardee%') then 'Hardees'
        when lower(dim_chain_chain_name) like lower('KFC%') then 'KFC'
        when lower(dim_chain_chain_name) like lower('Krispy Kreme%') then 'Krispy Kreme'
        when lower(dim_chain_chain_name) like lower('Pizza Hut%') then 'Pizza Hut'
        when lower(dim_chain_chain_name) like lower('TGI Friday%') then 'TGI Friday'
        when lower(dim_chain_chain_name) like lower('Wimp%') then 'Wimpy'
    end as chain_name, 
    
    'Americana' as group_name, ch.country_name
    
    from `tlb-data-prod.data_platform.dim_chain` AS ch 
    inner join 
    (
        SELECT
        dim_country_info.country_code AS dim_country_info_country_code,
        dim_chain.chain_name AS dim_chain_chain_name,
        dim_chain.chain_id AS dim_chain_chain_id,
        dim_country_info.country,
        CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name) AS country_chain_name,
            
            (CASE
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Wimpy%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Krispy Kreme%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_TGI Friday\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_TGI Fridays%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Baskin Robbins%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%KW\\_Chicken Tikka%')) THEN 'KW Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Pizza Hut%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Krispy Kreme%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_TGI Fridays%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_TGI Friday\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Chicken Tikka%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%AE\\_Wimpy%')) THEN 'AE Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Pizza Hut%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Costa Coffee%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Wimpy%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Krispy Kreme%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Baskin Robbins%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_TGI Fridays%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_TGI Friday\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Chicken Tikka%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Grand Cafe%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_KFC - Tourist%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_KFC - Governorates%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Hardee\'s - City Stars%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_KFC - City Stars%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Pizza Hut - Tourist%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Costa Coffee - Tourist%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Chicken Tikka - North Coast%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%EG\\_Hardee\'s - North Coast%')) THEN 'EG Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_Krispy Kreme%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_TGI Fridays%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%QA\\_TGI Friday\'s%')) THEN 'QA Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_Pizza Hut%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_Costa Coffee%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%JO\\_Krispy Kreme%')) THEN 'JO Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%IQ\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%IQ\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%IQ\\_Hardees%')) THEN 'IQ Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%OM\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%OM\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%OM\\_Hardees%')) THEN 'OM Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%SA\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%SA\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%SA\\_Hardees%')) THEN 'KSA Americana'
            WHEN (UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_KFC%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_Hardee\'s%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_Hardees%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_Pizza Hut%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_Krispy Kreme%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_TGI Fridays%') OR UPPER((CONCAT(dim_country_info.country_code, '_', dim_chain.chain_name))) LIKE UPPER('%BH\\_TGI Friday\'s%')) THEN 'BH Americana'
            ELSE 'Other'
            END) AS americana_groups,
        
        dim_vendor_info.vendor_name AS dim_vendor_info_vendor_name,
        dim_vendor_info.vendor_id AS dim_vendor_info_vendor_id,
        COALESCE(SUM(CASE WHEN dim_order_status_flags.is_commissionable THEN fct_order_info.gmv_amount_eur ELSE 0 END), 0) AS fct_order_info_comm_gmv_amount_eur,
        COALESCE(SUM(CASE WHEN fct_order_info.is_successful THEN 1 ELSE NULL END), 0) AS fct_order_info_successful_orders_count
        FROM `tlb-data-prod.data_platform.fct_order_info`
        AS fct_order_info
        INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
        AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
        INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
        AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id
        INNER JOIN `tlb-data-prod.data_platform.dim_chain`
        AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id
        INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
        AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id
        WHERE ((( fct_order_info.order_date ) >>= ((DATE_TRUNC(CURRENT_DATE(), YEAR))) AND ( fct_order_info.order_date ) << ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), YEAR), INTERVAL 1 YEAR))))) AND ((dim_chain.chain_id ) NOT IN (3219, 10479) OR (dim_chain.chain_id ) IS NULL) AND ((UPPER(( dim_chain.chain_name )) LIKE UPPER('KFC%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Pizza Hut%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Hardee\'s%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Hardees%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Costa Coffee%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Krispy Kreme%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('TGI Friday\'s%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('TGI Fridays%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Chicken Tikka%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Wimpy%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Baskin Robbins%') OR UPPER(( dim_chain.chain_name )) LIKE UPPER('Grand Cafe%'))) AND (fct_order_info.order_date >>= DATE_ADD(DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -180 DAY), YEAR), INTERVAL -2 YEAR)
        and fct_order_info.country_iso like case when 'yes'='yes' then '%' else 'AE' end)
        GROUP BY 1, 2, 3, 4, 5, 6, 7, 8
    ) x on cast(x.dim_chain_chain_id as string)= cast(ch.chain_id as string) 
    where americana_groups != 'Other'
    group by 1,2,3,4

)



SELECT
'P0' as duration,
fct_order_info.analytical_customer_id,
dim_country_info.country,
case when x.chain_name IS NOT NULL then x.chain_name else dim_chain.chain_name end as chain_name,
COALESCE(dim_chain.main_cuisine,'others') as main_cuisine,
count(distinct fct_order_info.order_id) as orders 


FROM `tlb-data-prod.data_platform.fct_order_info` AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id

inner join RKA_universe as x on x.chain_id = fct_order_info.chain_id

WHERE fct_order_info.order_date between '2023-08-01' and '2023-08-31'

AND (NOT fct_order_info.is_non_food) 
AND (fct_order_info.is_successful ) 

and dim_country_info.country != 'Saudi Arabia'

GROUP BY 1,2,3,4,5



UNION ALL

SELECT
'Px' as duration,
fct_order_info.analytical_customer_id,
dim_country_info.country,
case when x.chain_name IS NOT NULL then x.chain_name else dim_chain.chain_name end as chain_name,
COALESCE(dim_chain.main_cuisine,'others') as main_cuisine,
count(distinct fct_order_info.order_id) as orders 


FROM `tlb-data-prod.data_platform.fct_order_info` AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id

inner join RKA_universe as x on x.chain_id = fct_order_info.chain_id

WHERE fct_order_info.order_date between '2023-10-01' and '2023-10-31'

AND (NOT fct_order_info.is_non_food) 
AND (fct_order_info.is_successful ) 

and dim_country_info.country != 'Saudi Arabia'

GROUP BY 1,2,3,4,5]]></relation>
