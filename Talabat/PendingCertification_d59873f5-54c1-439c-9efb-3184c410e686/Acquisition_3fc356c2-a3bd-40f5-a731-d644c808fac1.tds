0 as latest_meeting_rank

from
events a 
left join `tlb-data-prod.data_platform_google_sheet.sales_executives`  lE on  lower(lE.owner_name) =  loweR(a.opportunity_owner_name)  and  date_trunc(date(le.month),month) = date_trunc(current_Date,month)
)


union all 


select 

a.country_code,
" " as city,
ownerid,
accountid as id,
"Live" as tag,
account_status__c as status,
date(first_online_date) as Date,
title,
opportunity_owner_name,
a.salesforce_id,
group_owner_id,
group_owner_name,
group_id, 
group_name,
" " as description,
vendor_grade__c, 
