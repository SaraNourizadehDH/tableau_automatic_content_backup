 ) a

where lower(a.country_code) <<>> "sa"
-- and opportunity_owner_name = "Abedalrahman Mohammed"
-- and  (a.salesforce_id) = "HZ1ENZ"
-- and date_trunc(a.date,month) = "2024-06-01"

) 
, 


------------------------------------ my work here ---------------------------------------------
titles as (


select 

'FS' as title
union all 
select 'TS' as title 
union all 
select 'AMs' as title 



)

,days as (
select distinct month_start_date as month,d.date,
day_of_month,country_code,title as team  from `tlb-data-prod.data_platform.dim_date` d 
cross join `tlb-data-prod.data_platform.dim_country_info` c 

cross join titles 
where month_start_date between '2025-02-01' and date_trunc(current_date,month)
) 

,pre_output as (
select upper(country_code) as country, date_trunc(date,month) as month, 
date,
extract(day from date) as day_of_month, 

  CASE
    WHEN title IN (
      'Sales Executive', 'Sales Exeuctive', 'Sr. Sales Executive', 'Sr. Sales executive',
      'Coordinator Riders', 'Sales Acquisition - IC1', 'Team Lead Acquisition', 'Manager Acquisition',
      'Head Of Acquisitions & Partnerships', 'Lead Generator', 'Lead Generator Support', 'Intern - Sales'
    ) THEN 'FS'
      WHEN LOWER(opportunity_owner_name) = 'talabat lead research team' THEN 'FS'
    WHEN title IN (
      'Inside Sales Executive', 'Executive Inside Sales', 'Manager Content', 'Account Advisor - Content',
      "Account Advisor - Restaurants’ Operations", 'Supervisor Operations'
    ) THEN 'TS'
    WHEN title IN (
      'Account Manager', 'Sr. Key Account Manager', 'Key Account Manager', 'Team Lead Account Management',
      'Online Account Manager', 'Sr. Account Manager', 'Online Account Manager II',
      'Team lead Online Account Management', 'Phone Account Manager', 'Coordinator Sales - Account Management'
    ) THEN 'AMs'
    ELSE 'AMs'
  END AS team,
  count(distinct id) as vendors,
FROM base b 

where tag='Live'
and coalesce(date,date("1999-09-01")) <<>> date "1999-09-01"
and date_trunc(date,month) >>='2025-02-01'
and vertical='Restaurant'
group by all
)

--select * from pre_output

,pre_output_clean as (

select d.*, coalesce(vendors,0) as vendors, 
coalesce(sum(vendors) over(partition by d.month,d.country_code,d.team order by d.day_of_month),0) as MTD_vendors 
 from pre_output b
right join days d on  b.day_of_month=d.day_of_month and b.month=d.month and upper(b.country)=d.country_code and b.team=d.team
)





/*


select country_code, 
day_of_month, 
team, 
avg(weight_of_a_day) from before_agg
group by 1,2,3 
*/
,target as (
select a.*,t.Target_value,date(t.target_date) as target_date, 
--avg_day_weight*target_value as day_target_value
avg_day_weight_opt*target_value as day_target_value
 --from `tlb-data-dev.vendor_analytics.acquisition_daily_weights`  a 
 --from `tlb-data-dev.vendor_analytics.acquisition_daily_weights_optm` a
from tlb-data-dev.vendor_analytics.acquisition_daily_weights_optm_external a
join --`tlb-data-dev.vendor_analytics.acquisition_targets`
`tlb-data-dev.vendor_analytics.acquisition_targets_materalized`
 t on a.country_code=t.country and a.team=t.team --and t.target_date=a.month
--where t.country='AE'
)
, target_run as (

select country_code, 
day_of_month, 
team,
target_date, 
--month,
coalesce(sum(day_target_value) over(partition by country_code,target_date,team order by day_of_month),0) as target_MTD
from target 


) 
select o.*, t.target_MTD
 from pre_output_clean o
left join target_run t 
on o.month=t.target_date 
and o.day_of_month=t.day_of_month 
and o.country_code=t.country_code 
and o.team=t.team 

--and t.day_of_month = extract(day from current_date - interval '1' day)

)




select  a.month, a.date,extract(day from a.date) as day, a.country_code,
 a.MTD_vendors as FS_MTD_vendors, a.target_MTD as fs_target_mtd,
  a2.MTD_vendors as AMs_MTD_vendors,a2.target_MTD as AMs_target_mtd,
   a3.MTD_vendors as TS_MTD_vendors,a3.target_MTD as TS_target_mtd
from
 hist_acq a 
 join hist_acq a2 on a.date=a2.date and a.country_code=a2.country_code
 join hist_acq a3 on a.date=a3.date and a.country_code=a3.country_code
