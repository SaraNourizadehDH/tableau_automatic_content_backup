" " as is_dineout,
stagename,
a.type as meeting_type,
substatus__c,
subject,
event_date,
probability,
closedate,
" " as lost_reason__c,
0  as lead_Age__c,
kitchens_tag,
opp_business_type,
competitor__c,
right_competitor_flag,
name as vendor_name,
0 as cpc_budget_eur,
0 as cpc_nb_budget_clicks,
0 as cpc_revenue_eur_adjusted_excl,
0 as campaigns,
0 as ncr_eur_excl,
0 as ncr_lc_excl,
opp_hist_date,
date(current_date) as last_updated_date,
date_sub(current_date, interval 1 day) as yesterday,
case when lower(le.owner_name) = lower(opportunity_owner_name) and  date_trunc(date(le.month),month) = date_trunc(current_Date,month) then 1 else 0 end  as validated_agent,
le.type as rep_type,
le.country_code as rep_country_code,
latest_opportunity_rank,
account_owner_name,
account_owner_title,
latest_meeting_rank

from accounts a
left join `tlb-data-prod.data_platform_google_sheet.sales_executives`  lE on  lower(lE.owner_name) =  loweR(a.opportunity_owner_name)  and  date_trunc(date(le.month),month) = date_trunc(current_Date,month)

union all 

 
(
  
select 

a.country_code,
" " as city,
ownerid,
accountid as id,
"Meetings" as tag,
'' as status,
event_date as Date,
title as title,
opportunity_owner_name,
salesforce_id as salesforce_id,
group_owner_id,
group_owner_name,
group_id,
group_name,
description,
vendor_grade as vendor_grade__c,
'' as lead_data_origin__c,
leadsource,
lead_source_category,
