0 as lead_Age__c,
kitchens_tag,
" " as opp_business_type,
competitor__c,
right_competitor_flag,
name as vendor_name,
0 as cpc_budget_eur,
0 as cpc_nb_budget_clicks,
0 as cpc_revenue_eur_adjusted_excl,
0 as campaigns,
0 as ncr_eur_excl,
0 as ncr_lc_excl,
("2010-01-01") as opp_hist_date,
date(current_date) as last_updated_date,
date_sub(current_date, interval 1 day) as yesterday,
case when lower(le.owner_name) = lower(opportunity_owner_name) and  date_trunc(date(le.month),month) = date_trunc(current_Date,month) then 1 else 0 end  as validated_agent,
le.type as rep_type,
le.country_code as rep_country_code,
0 as latest_opportunity_rank,
