    <worksheet name='Daily Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tw Cen MT Condensed Extra Bold' fontsize='16'>Daily Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CCC Performance' name='federated.0pwszo50jbjygt1djlge90vtf2i8' />
          </datasources>
          <datasource-dependencies datasource='federated.0pwszo50jbjygt1djlge90vtf2i8'>
            <column caption='OOT%' datatype='real' default-format='p0.00%' name='[Calculation_1152077094781919232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time])/SUM([completed_orders])' />
            </column>
            <column caption='OL%' datatype='real' default-format='p0.00%' name='[Calculation_1152077094782558209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([OT_Late])/SUM([completed_orders])' />
            </column>
            <column caption='OE%' datatype='real' default-format='p0.00%' name='[Calculation_1152077094785044482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([OT_Early])/SUM([completed_orders])' />
            </column>
            <column caption='TFR' datatype='real' default-format='p0.00%' name='[Calculation_1152077094785327107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Transport_Failed_orders])/SUM([completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1152077094828027909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed])/SUM([working_hours])' />
            </column>
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[OT_Early]' role='measure' type='quantitative' />
            <column datatype='integer' name='[OT_Late]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[RAT]' role='measure' type='quantitative' />
