AVG (CASE WHEN LO.order_status = 'completed' THEN to_customer_time END)/60 AS to_customer,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_customer_time END)/60 AS at_customer,
AVG (CASE WHEN LO.order_status = 'completed' THEN promised_delivery_time END)/60 AS PDT,
AVG (CASE WHEN LO.order_status = 'completed' THEN actual_delivery_time END)/60 AS ADT,
AVG (CASE WHEN LO.order_status = 'completed' THEN order_delay END)/60 AS order_delay,
AVG (CASE WHEN LO.order_status = 'completed' THEN rider_late END)/60 rider_late,
AVG (CASE WHEN LO.order_status = 'completed' THEN vendor_late END)/60 vendor_late,
AVG (CASE WHEN LO.order_status = 'completed' THEN fir_preparation_seconds END)/60 FIR,
AVG (CASE WHEN LO.order_status = 'completed' THEN assumed_actual_preparation_time END)/60 Assumed_actual_prep,
AVG (CASE WHEN LO.order_status = 'completed' THEN estimated_vendor_preparation_seconds END)/60 as EPT,
APPROX_QUANTILES(LO.actual_delivery_time/60, 100)[OFFSET(90)] AS ADT_P90,
SAFE_DIVIDE(SUM (primary_stacked_count) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as staking_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN total_volume END) AS avg_volume,
AVG (CASE WHEN LO.order_status = 'completed' THEN total_weight END) AS avg_weight,
COUNTIF (is_seamless = TRUE) AS seamless_Orders,
AVG (CASE WHEN LO.order_status = 'completed' THEN hurrier_order_value END)/100 AS avg_order_value,
SAFE_DIVIDE (COUNT (DISTINCT CASE WHEN LO.actual_delivery_time/60 >> 36 AND LO.order_status = 'completed' THEN LO.order_id END), COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS OFFENDER_perc,
SAFE_DIVIDE (COUNT (DISTINCT CASE WHEN LO.actual_delivery_time/60 << 36 AND LO.order_status = 'completed' THEN LO.order_id END), COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END))  AS HEALTHY_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN actual_delivery_time/60 <<= 15 THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) ) as Below15_DT,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60 + LO.to_vendor_time/60 <<= fir_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RRV_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60  <<= estimated_vendor_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RAT_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.fir_preparation_seconds/60  <<= estimated_vendor_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FIR_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_late/60 >> 10 THEN LO.order_id END) ,COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) ) AS Rider_late_10,
