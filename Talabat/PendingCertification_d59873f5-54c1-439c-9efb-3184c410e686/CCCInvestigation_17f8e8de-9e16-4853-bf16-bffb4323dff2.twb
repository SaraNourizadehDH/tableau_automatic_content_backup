COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) as OT_Late,

COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) as OT_Early,

COUNT (DISTINCT CASE WHEN order_delay is NULL AND order_status = 'completed' THEN order_id END) as Null_deliveries,

AVG (CASE WHEN LO.order_status = 'completed' THEN rider_accepting_time END)/60 AS RAT,
