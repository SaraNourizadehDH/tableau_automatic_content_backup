    <datasource caption='17-21 Riders AVG WHs' inline='true' name='federated.0q5bck916aie5l1d09iso1nkzrmw' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.153tvhf0eeeq3g11wgfxb0dxm0qy'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='habiba.amr.2@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.153tvhf0eeeq3g11wgfxb0dxm0qy' name='Custom SQL Query' type='text'><![CDATA[with riders as (
  SELECT distinct created_date
,d.rider_id
,dlr.birth_date
  ,TIMESTAMP_DIFF(CURRENT_DATE,dlr.birth_date,YEAR ) as age
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = 'eg'
WHERE LOWER(o.country_code) = 'eg'
AND d.delivery_status = 'completed'
AND zone_id = 2
AND DATE(d.created_at, o.timezone) BETWEEN '2025-05-01' AND '2025-06-10'
GROUP BY ALL
HAVING age BETWEEN 17 AND 21
 )
 , whs as (
  SELECT 
    day AS report_date
  ,rider_id
  , SUM(d.duration) / 3600 working_hours
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-05-01'
  AND created_date <<= '2025-06-10'
  AND country_code = 'eg'
  AND zone_id = 2
GROUP BY ALL
 )

 SELECT created_date,
 AVG(whs.working_hours) as avg_whs
 FROM riders 
 LEFT JOIN whs on riders.rider_id = whs.rider_id
 GROUP BY 1
 ORDER BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
