      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Performance' id='_3B2E75C8CAB7424B9ACC956E89B1B8A4'>
            <properties context=''>
              <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query' type='text'><![CDATA[SELECT
EXTRACT (DATE FROM created_at + INTERVAL 3 HOUR) as DATE,
EXTRACT (HOUR FROM  created_at + INTERVAL 3 HOUR) as HOUR,

COUNT (DISTINCT order_id) as gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as completed_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'TRANSPORT' THEN LO.order_id END) AS Transport_Failed_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'PLATFORM' THEN LO.order_id END) AS PLATFORM_cancellation,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'CUSTOMER' THEN LO.order_id END) AS CUSTOMER_cancellation,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'VENDOR' THEN LO.order_id END) AS VENDOR_cancellation,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'FULFILMENT' THEN LO.order_id END) AS FULFILMENT_cancellation,

COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) as on_time,

COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) as OT_Late,

COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) as OT_Early,

COUNT (DISTINCT CASE WHEN order_delay is NULL AND order_status = 'completed' THEN order_id END) as Null_deliveries,

AVG (CASE WHEN LO.order_status = 'completed' THEN rider_accepting_time END)/60 AS RAT,
AVG (CASE WHEN LO.order_status = 'completed' THEN rider_reaction_time END)/60 AS Reaction_time,
AVG (CASE WHEN LO.order_status = 'completed' THEN to_vendor_time END)/60 AS to_vendor,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_vendor_time END)/60 AS at_vendor,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_vendor_time_cleaned END)/60 AS avtc,
AVG (CASE WHEN LO.order_status = 'completed' THEN to_customer_time END)/60 AS to_customer,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_customer_time END)/60 AS at_customer,
AVG (CASE WHEN LO.order_status = 'completed' THEN promised_delivery_time END)/60 AS PDT,
AVG (CASE WHEN LO.order_status = 'completed' THEN actual_delivery_time END)/60 AS ADT,
AVG (CASE WHEN LO.order_status = 'completed' THEN order_delay END)/60 AS order_delay,
AVG (CASE WHEN LO.order_status = 'completed' THEN rider_late END)/60 rider_late,
AVG (CASE WHEN LO.order_status = 'completed' THEN vendor_late END)/60 vendor_late,
AVG (CASE WHEN LO.order_status = 'completed' THEN fir_preparation_seconds END)/60 FIR,
AVG (CASE WHEN LO.order_status = 'completed' THEN assumed_actual_preparation_time END)/60 Assumed_actual_prep,
AVG (CASE WHEN LO.order_status = 'completed' THEN estimated_vendor_preparation_seconds END)/60 as EPT,
APPROX_QUANTILES(LO.actual_delivery_time/60, 100)[OFFSET(90)] AS ADT_P90,
SAFE_DIVIDE(SUM (primary_stacked_count) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as staking_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN total_volume END) AS avg_volume,
AVG (CASE WHEN LO.order_status = 'completed' THEN total_weight END) AS avg_weight,
COUNTIF (is_seamless = TRUE) AS seamless_Orders,
AVG (CASE WHEN LO.order_status = 'completed' THEN hurrier_order_value END)/100 AS avg_order_value,
SAFE_DIVIDE (COUNT (DISTINCT CASE WHEN LO.actual_delivery_time/60 >> 36 AND LO.order_status = 'completed' THEN LO.order_id END), COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS OFFENDER_perc,
SAFE_DIVIDE (COUNT (DISTINCT CASE WHEN LO.actual_delivery_time/60 << 36 AND LO.order_status = 'completed' THEN LO.order_id END), COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END))  AS HEALTHY_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN actual_delivery_time/60 <<= 15 THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) ) as Below15_DT,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60 + LO.to_vendor_time/60 <<= fir_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RRV_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60  <<= estimated_vendor_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RAT_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.fir_preparation_seconds/60  <<= estimated_vendor_preparation_seconds/60 THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FIR_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_late/60 >> 10 THEN LO.order_id END) ,COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) ) AS Rider_late_10,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_late/60 >> 5 THEN LO.order_id END) ,COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) ) AS Rider_late_5,
AVG ( CASE WHEN LO.rider_late/60 << 5 THEN LO.at_vendor_time_cleaned END)/60 AS avtc_below_5_rider_late,
AVG ( CASE WHEN LO.rider_late/60 = 0 THEN LO.at_vendor_time_cleaned END)/60 AS avtc_below_0_rider_late,

FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
   WHERE
    -- EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    DATE(LO.created_at + INTERVAL 3 HOUR) BETWEEN '2025-05-01' AND '2025-6-15'
    AND LO.order_id IS NOT NULL
    AND zone_id = 2
    AND LOWER(LO.country_code) = 'eg'
GROUP BY CUBE (1,2)
HAVING hour is not null AND DATE is not null
ORDER BY 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_3B2E75C8CAB7424B9ACC956E89B1B8A4' table='[Extract].[_3B2E75C8CAB7424B9ACC956E89B1B8A4]' type='table' />
            </properties>
          </object>
          <object caption='AVG WHs' id='_6C4AF0760A8F41B88D4E03A8FC2A00A9'>
            <properties context=''>
              <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query4' type='text'><![CDATA[WITH dataset AS (
SELECT DATE(d.rider_dropped_off_at, d.timezone) AS report_date
 ,EXTRACT (HOUR FROM  DATETIME(d.rider_dropped_off_at, d.timezone)) as Hour
 ,rider_id
 , COUNT(order_id) orders
 , NULL AS working_hours
 ,CASE WHEN vehicle.name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle.name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle.name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle.name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.orders` o
LEFT JOIN  UNNEST(deliveries) d ON d.is_primary
WHERE created_date >>= '2025-05-01'
AND created_date <<= '2025-06-10'
 AND country_code='eg'
 AND d.delivery_status = 'completed'
 AND zone_id = 2
 GROUP BY ALL

UNION ALL 


SELECT 
    day AS report_date
  ,EXTRACT(HOUR FROM DATETIME(actual_start_at,timezone)) AS Hour 
  ,rider_id
  , NULL AS orders
  , SUM(d.duration) / 3600 working_hours
  ,CASE WHEN vehicle_name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-05-01'
  AND created_date <<= '2025-06-10'
  AND country_code = 'eg'
  AND zone_id = 2
GROUP BY ALL
)

SELECT dataset.report_date
  , AVG(working_hours) AS working_hours
--   ,SUM(orders)/SUM(working_hours) as UTR
FROM dataset
WHERE report_date is not null
GROUP BY ALL
ORDER BY 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_6C4AF0760A8F41B88D4E03A8FC2A00A9' table='[Extract].[_6C4AF0760A8F41B88D4E03A8FC2A00A9]' type='table' />
            </properties>
          </object>
          <object caption='Hourly Riders Count' id='_787B9F9F75194712B21DA50628EE7BC9'>
            <properties context=''>
              <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query2' type='text'>SELECT DATE_TRUNC(DATE(d.created_at,o.timezone),DAY) AS DATE,&#13;
EXTRACT (HOUR FROM DATETIME(d.created_at,o.timezone)) AS Hour,&#13;
COUNT(DISTINCT rider_id) as riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
WHERE country_code = &apos;eg&apos;&#13;
AND zone_id = 2&#13;
AND DATE(d.created_at,o.timezone) BETWEEN &apos;2025-05-01&apos; AND &apos;2025-06-10&apos; &#13;
GROUP BY 1,2&#13;
ORDER BY 1,2</relation>
            </properties>
            <properties context='extract'>
              <relation name='_787B9F9F75194712B21DA50628EE7BC9' table='[Extract].[_787B9F9F75194712B21DA50628EE7BC9]' type='table' />
            </properties>
          </object>
          <object caption='Daily Riders Count' id='_8C649FA19CCE4A93A2B395535F43A795'>
            <properties context=''>
              <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query1' type='text'>SELECT DATE_TRUNC(DATE(d.created_at,o.timezone),DAY) AS DATE,&#13;
COUNT(DISTINCT rider_id) as riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
WHERE country_code = &apos;eg&apos;&#13;
AND zone_id = 2&#13;
AND DATE(d.created_at,o.timezone) BETWEEN &apos;2025-05-01&apos; AND &apos;2025-06-10&apos; &#13;
GROUP BY 1&#13;
ORDER BY 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='_8C649FA19CCE4A93A2B395535F43A795' table='[Extract].[_8C649FA19CCE4A93A2B395535F43A795]' type='table' />
            </properties>
          </object>
          <object caption='UTRs' id='_93BFB95F569948FBB032679CE6E65566'>
            <properties context=''>
              <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query3' type='text'><![CDATA[WITH dataset AS (
SELECT DATE(d.rider_dropped_off_at, d.timezone) AS report_date
 ,EXTRACT (HOUR FROM  DATETIME(d.rider_dropped_off_at, d.timezone)) as Hour
 , COUNT(order_id) orders
 , NULL AS working_hours
 ,CASE WHEN vehicle.name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle.name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle.name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle.name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.orders` o
LEFT JOIN  UNNEST(deliveries) d ON d.is_primary
WHERE created_date >>= '2025-05-01'
AND created_date <<= '2025-06-10'
 AND country_code='eg'
 AND d.delivery_status = 'completed'
 AND zone_id = 2
 GROUP BY ALL

UNION ALL 


SELECT 
    day AS report_date
  ,EXTRACT(HOUR FROM DATETIME(actual_start_at,timezone)) AS Hour 
  , NULL AS orders
  , SUM(d.duration) / 3600 working_hours
  ,CASE WHEN vehicle_name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-05-01'
  AND created_date <<= '2025-06-10'
  AND country_code = 'eg'
  AND zone_id = 2
GROUP BY ALL
)

SELECT dataset.report_date
  , Hour
  , SUM(orders) AS orders_completed
  , SUM(working_hours) AS working_hours
--   ,SUM(orders)/SUM(working_hours) as UTR
FROM dataset
WHERE report_date is not null
GROUP BY ALL
ORDER BY 1,2]]></relation>
            </properties>
