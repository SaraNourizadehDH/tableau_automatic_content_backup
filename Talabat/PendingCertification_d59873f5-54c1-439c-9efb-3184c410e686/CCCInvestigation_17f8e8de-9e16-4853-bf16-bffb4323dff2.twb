    <datasource caption='Riders Age' inline='true' name='federated.01bf7i815it27a15dgo131ba13o8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ufis4112wdslx119d50d0ivncdq'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='habiba.amr.2@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ufis4112wdslx119d50d0ivncdq' name='Custom SQL Query' type='text'><![CDATA[-- Select COUNT(Distinct d.rider_id) as riders,
SELECT CASE WHEN age << 17 THEN '<<17'
            WHEN age between 17 AND 21 THEN '17-21'
            WHEN age between 22 AND 30 THEN '22-30' 
            WHEN age between 31 AND 40 THEN '31-40'
            ELSE '+40'END age_bucket
      , COUNT(DISTINCT rider_id) as riders
FROM 
(
  SELECT distinct d.rider_id
,dlr.birth_date
  ,TIMESTAMP_DIFF(CURRENT_DATE,dlr.birth_date,YEAR ) as age
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = 'eg'
WHERE LOWER(o.country_code) = 'eg'
AND d.delivery_status = 'completed'
AND zone_id = 2
AND DATE(d.created_at, o.timezone) BETWEEN '2025-05-01' AND '2025-06-10'
GROUP BY ALL
)
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
