          <datasource-dependencies datasource='federated.01bf7i815it27a15dgo131ba13o8'>
            <column caption='%' datatype='string' name='[Calculation_1136877447087063041]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(SUM([riders])) + &quot; (&quot; + &#13;&#10;STR(ROUND(100 * SUM([riders]) / TOTAL(SUM([riders])), 1)) + &quot;%)&quot;'>
