            </column>
            <column caption='[Active Vendor on Booster Discount]/[Best Sellers Vendor Count]' datatype='real' name='[Calculation_217580197290520580]' role='measure' type='quantitative' user:unnamed='Sheet 6'>
              <calculation class='tableau' formula='[Calculation_5067605140804726789]/[Active Vendor on Booster Discount (copy)_3633982724315742215]' />
