      <column caption='Best Sellers Vendor Count' datatype='integer' name='[Active Vendor on Booster Discount (copy)_3633982724315742215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_on_best_seller_campaign] THEN [vendor_id] ELSE NULL END)' />
      </column>
      <column caption='Total GMV Euro [pro Booster Vendors]' datatype='real' name='[Active Vendor on Booster Discount (copy)_5067605140807815174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_on_pro_booster_campaign] THEN [gmv_amount_eur] ELSE 0 END)' />
      </column>
      <column caption='Total GMV Euro [tPro Vendor]' datatype='real' name='[Active Vendor on tPro (copy)_5067605140808073223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_tpro_vendor] THEN [gmv_amount_eur] ELSE 0 END)' />
