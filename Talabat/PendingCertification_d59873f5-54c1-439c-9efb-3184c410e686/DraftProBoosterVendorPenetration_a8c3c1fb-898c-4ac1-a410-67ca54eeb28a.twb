      <column caption='tpro_country_filter' datatype='string' name='[Calculation_70298414301954048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name] in (&apos;Bahrain&apos;,&apos;Kuwait&apos;,&apos;Jordan&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;UAE&apos;) THEN &apos;Include&apos; &#10;ELSE &apos;Exclude&apos;&#10;END' />
