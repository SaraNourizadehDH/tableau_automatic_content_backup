    <worksheet name='Vendor Penetration on tPro Booster [GMV]'>
      <repository-location id='VendorPenetrationontProBoosterGMV' path='/t/Talabat/workbooks/ProBoosterVendorPenetrationv2' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_playground)' name='federated.1mbqpvx1d7g3uc13zwhiu1ghe611' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
              <range max='#2024-07-14#' min='#2024-04-01#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1mbqpvx1d7g3uc13zwhiu1ghe611].[Calculation_217580197019541505]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-08-21#'>
              <calculation class='tableau' formula='#2024-08-21#' />
              <range max='#2050-12-31#' min='#2024-04-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mbqpvx1d7g3uc13zwhiu1ghe611'>
            <column caption='Total GMV Euro [pro Booster Vendors]' datatype='real' name='[Active Vendor on Booster Discount (copy)_5067605140807815174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_pro_booster_campaign] THEN [gmv_amount_eur] ELSE 0 END)' />
            </column>
            <column caption='Total GMV Euro [tPro Vendor]' datatype='real' name='[Active Vendor on tPro (copy)_5067605140808073223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_tpro_vendor] THEN [gmv_amount_eur] ELSE 0 END)' />
            </column>
            <column caption='End Date default' datatype='date' name='[Calculation_217580197019541505]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_217580197021261826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Parameter 2])+1)&#10;and [date] &lt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Parameter 2])+1)&#10;then &quot;Comparison Period&quot;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Parameter 2]&#10;then &apos;Selected Period&apos;&#10;else &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='Share of GMV with Booster Discount' datatype='real' name='[Calculation_5067605140808953864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_pro_booster_campaign] THEN [gmv_amount_eur] ELSE 0 END)&#10;/ sum([gmv_amount_eur])' />
            </column>
            <column caption='tpro_country_filter' datatype='string' name='[Calculation_70298414301954048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] in (&apos;Bahrain&apos;,&apos;Kuwait&apos;,&apos;Jordan&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;UAE&apos;) THEN &apos;Include&apos; &#10;ELSE &apos;Exclude&apos;&#10;END' />
            </column>
            <column caption='Share of GMV with Booster Discount From BS' datatype='real' name='[Share of GMV with Booster Discount (copy)_3633982724316794889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_pro_booster_campaign] and [is_on_best_seller_campaign] and [is_tpro_vendor] THEN [gmv_amount_eur] ELSE 0 END)&#10;/ sum(IF [is_on_best_seller_campaign] THEN [gmv_amount_eur] ELSE 0 END)' />
            </column>
            <column caption='Total GMV Euro [Pro Best Seller Vendors]' datatype='real' name='[Total GMV Euro [Best Seller Vendors]] (copy)_5154792024508846127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_best_seller_campaign] and [is_tpro_vendor] THEN [gmv_amount_eur] ELSE 0 END)' />
            </column>
            <column caption='Total GMV Euro [Pro Boosted Best Seller Vendors]' datatype='real' name='[Total GMV Euro [Pro Best Seller Vendors]] (copy)_5154792024509161520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_best_seller_campaign] and [is_tpro_vendor] and [is_on_pro_booster_campaign] THEN [gmv_amount_eur] ELSE 0 END)' />
            </column>
            <column caption='Total GMV Euro [Best Seller Vendors]' datatype='real' name='[Total GMV Euro [pro Booster Vendors]] (copy)_3633982724316508168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_on_best_seller_campaign] THEN [gmv_amount_eur] ELSE 0 END)' />
