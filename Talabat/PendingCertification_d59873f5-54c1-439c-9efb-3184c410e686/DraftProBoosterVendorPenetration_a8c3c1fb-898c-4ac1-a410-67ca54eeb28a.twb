        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ucdwgz02ahvus1d7jng61os68zr' name='Custom SQL Query' type='text'><![CDATA[WITH
  agg_tb_vendor_measures AS (
  SELECT
    order_date AS date,
    vendor_id,
    COUNT(DISTINCT order_id) AS order_count,
    SUM(gmv_amount_eur) AS gmv_amount_eur,
    MAX(is_tpro_order) AS is_tpro_vendor
  FROM
    `tlb-data-prod.data_platform.fct_order_info` o
  WHERE
    order_date >>= '2024-07-01'
     AND order_date <<= current_date
    AND is_successful
    AND vertical_id = 4 -- food only
  GROUP BY
    ALL
  ORDER BY
    1,
    2,
    3,
    4 ),
    agg_vendor_best_seller_flag AS (
  SELECT
    a.order_date AS date,
    a.vendor_id,
    TRUE AS is_on_best_seller_campaign
  FROM
    `tlb-data-prod.data_platform.fct_incentive_order_detail` a
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_discount` b
  ON
    a.campaign_id = b.campaign_id
  and
    a.incentive_sub_type = 'item discount'
  WHERE
    a.incentive_sub_type = 'item discount'
    AND ( b.platform_campaign_type IN ('Best Sellers')
      AND a.country_code != 'KW'
      OR ((b.platform_campaign_type IN ('Mega Deal')
          OR b.campaign_name LIKE '%Mega Deal%'
          OR b.campaign_name LIKE '%Mega deal%')
        AND a.country_code = 'KW'))
    AND   a.order_date >>= '2024-07-01'
    AND  a.order_date <<= current_date
  GROUP BY
    ALL ), 
    agg_pro_booster_vendor_daily AS (
  SELECT
    DISTINCT d.date,
    b.vendor_id,
    TRUE AS is_on_pro_booster_campaign
  FROM
    `tlb-data-prod.data_platform.dim_incentive_campaign` a
  JOIN
    `tlb-data-prod.data_platform.dim_incentive_campaign_detail` b
  ON
    a.campaign_id = b.campaign_id
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_date` d
  ON
    d.date BETWEEN DATE(a.campaign_start_date)
    AND LEAST(CURRENT_DATE(),DATE(a.campaign_end_date))
  WHERE
    a.incentive_sub_type = 'booster discount'
  GROUP BY
    ALL ),
    agg_pro_exclusive_deals as (
      SELECT
        DISTINCT 
        d.date,
        incentive_sub_type,
        is_pro_exclusive,
        b.vendor_id
      FROM
        `tlb-data-prod.data_platform.dim_incentives_discount` a
      JOIN
        `tlb-data-prod.data_platform.dim_incentive_campaign_detail` b
      ON
        a.campaign_id = b.campaign_id
      LEFT JOIN
        `tlb-data-prod.data_platform.dim_date` d
      ON
        d.date BETWEEN DATE(a.campaign_start_date)
        AND LEAST(CURRENT_DATE(),DATE(a.campaign_end_date))
      WHERE
        is_pro_exclusive = true
      order by date
    ),
    agg AS (
  SELECT
    a.*,
    COALESCE(b.is_on_pro_booster_campaign,FALSE) AS is_on_pro_booster_campaign,
    COALESCE(c.is_on_best_seller_campaign,FALSE) AS is_on_best_seller_campaign,
    COALESCE(exc_menu.is_pro_exclusive,FALSE) AS is_on_pro_exclusive_menu,
    COALESCE(exc_item.is_pro_exclusive,FALSE) AS is_on_pro_exclusive_item,
    COALESCE(exc_item.is_pro_exclusive OR exc_menu.is_pro_exclusive,FALSE) AS is_on_pro_exclusive

  FROM
    agg_tb_vendor_measures a
  LEFT JOIN
    agg_pro_booster_vendor_daily b
  ON
    a.date = b.date
    AND a.vendor_id = b.vendor_id
  LEFT JOIN
    agg_vendor_best_seller_flag c
  ON
    a.date = c.date
    AND a.vendor_id = c.vendor_id 
  LEFT JOIN agg_pro_exclusive_deals exc_menu on exc_menu.incentive_sub_type = 'menu discount' and a.date = exc_menu.date AND a.vendor_id = exc_menu.vendor_id  
  LEFT JOIN agg_pro_exclusive_deals exc_item on exc_item.incentive_sub_type = 'item discount' and a.date = exc_item.date AND a.vendor_id = exc_item.vendor_id  
    )
SELECT
  agg.*,
  v.vendor_name,
  c.chain_name,
  c.account_manager_email,
  c.account_manager_name,
  l.area_name,
  l.city_name,
  l.country_name,
  l.country_code
FROM
  agg
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` v
ON
  agg.vendor_id = v.vendor_id
LEFT JOIN
  `tlb-data-prod.data_platform.dim_location_info` l
ON
  v.location_id = l.location_id
LEFT JOIN
  `tlb-data-prod.data_platform.dim_chain` c
ON
  v.chain_id = c.chain_id
where date >>= <[Parameters].[Parameter 1]>
and date <<= <[Parameters].[Parameter 2]>
--and country_name = <[Parameters].[Parameter 3]>]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
