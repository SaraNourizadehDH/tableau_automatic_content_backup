    <datasource caption='Custom SQL Query (data_playground)' inline='true' name='federated.1mbqpvx1d7g3uc13zwhiu1ghe611' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ucdwgz02ahvus1d7jng61os68zr'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='' username='steve.chia@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
