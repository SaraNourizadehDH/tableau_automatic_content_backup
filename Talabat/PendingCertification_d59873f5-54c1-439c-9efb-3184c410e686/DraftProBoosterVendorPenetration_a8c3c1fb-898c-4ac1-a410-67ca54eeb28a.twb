    ),
    agg AS (
  SELECT
    a.*,
    COALESCE(b.is_on_pro_booster_campaign,FALSE) AS is_on_pro_booster_campaign,
    COALESCE(c.is_on_best_seller_campaign,FALSE) AS is_on_best_seller_campaign,
    COALESCE(exc_menu.is_pro_exclusive,FALSE) AS is_on_pro_exclusive_menu,
    COALESCE(exc_item.is_pro_exclusive,FALSE) AS is_on_pro_exclusive_item,
    COALESCE(exc_item.is_pro_exclusive OR exc_menu.is_pro_exclusive,FALSE) AS is_on_pro_exclusive

