    <worksheet name='Vendor Penetration on tPro Booster [Vendor Count]'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>% of pro vendors on Best seller = (Best Seller + Pro Vendor) / Best Seller
% Boosted vendors on Pro = Active Vendor on Booster Discount / Active Vendor on tPro</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location id='VendorPenetrationontProBoosterVendorCount' path='/t/Talabat/workbooks/ProBoosterVendorPenetrationv2' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_playground)' name='federated.1mbqpvx1d7g3uc13zwhiu1ghe611' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
              <range max='#2024-07-14#' min='#2024-04-01#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1mbqpvx1d7g3uc13zwhiu1ghe611].[Calculation_217580197019541505]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-08-21#'>
              <calculation class='tableau' formula='#2024-08-21#' />
              <range max='#2050-12-31#' min='#2024-04-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mbqpvx1d7g3uc13zwhiu1ghe611'>
            <column caption='Best Sellers Vendor Count' datatype='integer' name='[Active Vendor on Booster Discount (copy)_3633982724315742215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_on_best_seller_campaign] THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Best Sellers Pro Booster Vendor Count' datatype='integer' name='[Best Sellers Pro Vendor Count (copy)_5154792024507932717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_on_best_seller_campaign] and [is_tpro_vendor] and [is_on_pro_booster_campaign] THEN [vendor_id] &#10;  ELSE NULL &#10;  END&#10;)' />
            </column>
            <column caption='Best Sellers Pro Vendor Count' datatype='integer' name='[Best Sellers Vendor Count (copy)_5154792024507707436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF [is_on_best_seller_campaign] and [is_tpro_vendor] THEN [vendor_id] &#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='End Date default' datatype='date' name='[Calculation_217580197019541505]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_217580197021261826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Parameter 2])+1)&#10;and [date] &lt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Parameter 2])+1)&#10;then &quot;Comparison Period&quot;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Parameter 2]&#10;then &apos;Selected Period&apos;&#10;else &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='share of vendors with pro tpro' datatype='real' name='[Calculation_5067605140803104769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_tpro_vendor] THEN [vendor_id] ELSE NULL END)&#10;/ COUNTD([vendor_id])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[Calculation_5067605140803948546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Active Vendor on tPro' datatype='integer' name='[Calculation_5067605140804493316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(COUNTD(IF [is_tpro_vendor] THEN [vendor_id] ELSE NULL END))' />
            </column>
            <column caption='Active Vendor on Booster Discount' datatype='integer' name='[Calculation_5067605140804726789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_on_pro_booster_campaign] THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='tpro_country_filter' datatype='string' name='[Calculation_70298414301954048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] in (&apos;Bahrain&apos;,&apos;Kuwait&apos;,&apos;Jordan&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;UAE&apos;) THEN &apos;Include&apos; &#10;ELSE &apos;Exclude&apos;&#10;END' />
            </column>
            <column caption='Share of Vendors with Booster Discounts from pro' datatype='real' name='[Share of Vendors with Booster Discounts (copy)_230316928641560576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5067605140804726789] / [Calculation_5067605140804493316]' />
            </column>
            <column caption='% Boosted Pro Vendors from BS' datatype='real' name='[Share of Vendors with Booster Discounts (copy)_6930054701573869568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_on_pro_booster_campaign] THEN [vendor_id] ELSE NULL END)&#10;/ COUNTD(IF [is_on_best_seller_campaign] and [is_tpro_vendor] THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Share of Pro Vendors on Best Seller' datatype='real' name='[Share of Vendors with Booster Discounts from pro (copy)_5154792024508239918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Best Sellers Vendor Count (copy)_5154792024507707436]/[Active Vendor on Booster Discount (copy)_3633982724315742215]' />
            </column>
