        'coop_jo_partnership_B2B_100%_Uwallet_220318-220630_gn_50%x2JOD_Redemption_0%discount_all_one_op',
        'VoucherGenericRetention_ae_partnership_B2B_100%_TIERRACAFE_231215-240615_vw_10000x25%AED_Sales_25%discount_all_one_op',
        'VoucherGenericRetention_ae_partnership_B2B_100%_Terra Mezze_231226-240331_uc_30x30AED_Sales_30AED_all_one_op',
