      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Credit Mapping' id='Credit Mapping_6171081BD569473E84955062278D496C'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.086vgx11fep1hp1583mqj0glfj6x' name='Credit Mapping' table='[&apos;Credit Mapping$&apos;]' type='table'>
