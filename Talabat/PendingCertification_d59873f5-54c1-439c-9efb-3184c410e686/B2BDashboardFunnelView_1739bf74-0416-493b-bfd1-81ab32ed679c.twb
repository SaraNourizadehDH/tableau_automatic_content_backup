      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Voucher Funnel View' id='_43B68F9FF9A84E77BB46893864A7387E'>
            <properties context=''>
              <relation connection='bigquery.0vsou1l0sdmpzv12k51pv07ke7c4' name='Voucher Funnel View' type='text'><![CDATA[WITH
  base AS (
  SELECT
    c.country_code,
    DATE_TRUNC(DATE(b.campaign_start_date_utc), month) AS campaign_created_month,
    DATE_TRUNC(DATE(b.campaign_end_date_utc), month) AS campaign_end_month,
    DATE(b.campaign_start_date_utc) AS campaign_created_date,
    DATE(b.campaign_end_date_utc) AS campaign_end_date,
    DATE(a.created_on_time_utc, c.timezone) AS customer_redeem_date,
    DATE(a.valid_till_time_utc, c.timezone) AS voucher_expiry_date,
    a.campaign_reference_id,
    gmv_amount_eur,
    CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " "), r'^[^A-Za-z]') THEN CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " "), r'^[^A-Za-z]') THEN REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(6)], "_", " ")
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " ")
  END
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " ")
  END
    AS partner_name,
    CASE
      WHEN campaign_b2b_talabat_commission_percentage IS NULL THEN SAFE_CAST( (CASE
          WHEN ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)] LIKE "%%discount" THEN SPLIT(ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%" AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] LIKE "%discount%" THEN SPLIT(ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%"
        AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] NOT LIKE "%discount%"
        AND SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)] LIKE "%discount%" THEN SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)], "%")[SAFE_OFFSET(0)]
          ELSE "0"
      END
        ) AS FLOAT64)
      ELSE campaign_b2b_talabat_commission_percentage
  END
    AS talabat_commission_percentage,
    b.codes_count AS issued_vouchers,
    CASE
      WHEN LOWER(a.campaign_reference_id) LIKE "%sale%" THEN "sale based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%redempt%" THEN "redemption based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%full%" THEN "full upfront based"
      ELSE "unknown"
  END
    b2b_model,
    a.voucher_reference_id,
    a.voucher_id,
    a.account_id,
    cc.discount_type,
    cc.discount_value,
    a.is_used,
    d.order_date AS usage_date,
    a.order_id,
    c.currency,
    a.platform_cost_share,
    d.gmv_amount_lc
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
  INNER JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher` b
  ON
    a.voucher_id = b.voucher_id
  INNER JOIN
    `tlb-data-prod.data_platform_loyalty.voucher_options` cc
  ON
    cc.id = a.voucher_option_id AND cc.bin_group_id IS NULL
  INNER JOIN
    `tlb-data-prod.data_platform.dim_country_info` c
  ON
    b.country_id = c.country_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` d
  ON
    CAST(d.order_id AS string) = a.order_id
    AND d.is_successful
  WHERE
    b.incentive_type_detail = "VOUCHER_CODE"
    AND a.account_id >> 0
    AND is_deleted = FALSE
    AND (LOWER(a.campaign_reference_id) LIKE "%b2b%"
      OR name IN ( 'other_jo_Partnership_OrangeMoneyRamadan2023_230329-230427_gn_6000x30%_all_mult_op',
        'other_qa_Restaurant_Ashghal_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_Ashghal_230227-231231_vw_1x16%_all_mult_op',
        'other_qa_Restaurant_QFC_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_QIC_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_AspireAspetar_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_Workinton_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_GEMS_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_AliBinAli_230227-231231_vw_1x16%_all_mult_op',
        'other_qa_Restaurant_InternationalMedicalCompany_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_QatarRail_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_IFP_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_CBQStaff_230227-231231_vw_1x22%_all_mult_op',
