        'other_qa_Restaurant_QF_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_QDVC_230227-231231_vw_1x16%_all_mult_op',
        'other_qa_Restaurant_SalamGroup_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_QatarEnergy_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_DebakeySchool_230227-231231_vw_1x22%_all_mult_op',
