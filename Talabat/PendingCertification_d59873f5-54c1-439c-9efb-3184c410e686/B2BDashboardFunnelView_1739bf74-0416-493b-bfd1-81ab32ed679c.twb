  --DATE_TRUNC(DATE(a.created_on_time_utc, c.timezone), month) >>= "2024-01-01"),
  eur_calcs AS (
  SELECT
    b.country_code,
    campaign_created_date,
    campaign_created_month,
    campaign_end_date,
    campaign_end_month,
    customer_redeem_date,
    voucher_expiry_date,
    partner_name,
    talabat_commission_percentage,
    issued_vouchers,
    b2b_model,
    voucher_reference_id,
    voucher_id,
    account_id,
    discount_type,
    discount_value,
    usage_date,
    is_used,
    order_id,
    gmv_amount_eur,
    discount_value/exc1.exchange_rate_value AS discount_value_eur,
    issued_vouchers*(discount_value/exc1.exchange_rate_value) AS issued_vouchers_amount_eur,
  IF
    (order_id IS NULL
      AND voucher_expiry_date << CURRENT_DATE(), TRUE, FALSE) AS redeemed_and_expired_status,
  IF
    (campaign_end_date << CURRENT_DATE(), TRUE,FALSE) AS campaign_end_status,
    exc.exchange_rate_value,
    discount_value/exc1.exchange_rate_value AS discount_value_eur_issue_date,
  FROM
    base b
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_exchange_rate` exc
  ON
    exc.exchange_rate_date = IFNULL(b.usage_date, b.customer_redeem_date)
    AND exc.country_code = b.country_code
    AND exc.exchange_rate_base = 'EUR'
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_exchange_rate` exc1
  ON
    exc1.exchange_rate_date = b.campaign_created_date
    AND exc1.country_code = b.country_code
    AND exc1.exchange_rate_base = 'EUR'
  WHERE
    exc.exchange_rate_base = 'EUR'
    AND exc.exchange_rate_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month)
    AND campaign_created_month >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month)
    AND exc1.exchange_rate_base = 'EUR'
    AND exc1.exchange_rate_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month) )
SELECT
  country_code,
  campaign_created_month,
  campaign_end_month,
  partner_name, 
  talabat_commission_percentage,
  b2b_model,
  voucher_id AS campaign_id,
  discount_value AS voucher_value_lc,
  discount_value_eur AS voucher_value_eur,
  issued_vouchers AS issued_count,
  COUNT(DISTINCT(voucher_reference_id)) AS redeem_count,
  COUNT(DISTINCT(order_id)) AS used_count,
  COUNT(DISTINCT(
    IF
      (redeemed_and_expired_status, voucher_reference_id, NULL))) AS redeemed_and_expired_count,
  COUNT(DISTINCT(account_id)) AS redeemers,
  COUNT(DISTINCT(
    IF
      (order_id IS NOT NULL, account_id, NULL))) AS users,
  issued_vouchers_amount_eur,
  SUM(discount_value_eur) AS redeemed_amount_eur,
  SUM(
  IF
    (order_id IS NOT NULL, discount_value_eur, NULL)) AS used_amount_eur,
  SUM(
  IF
    (redeemed_and_expired_status, discount_value_eur, NULL )) AS redeemed_and_expired_amount_eur,
  issued_vouchers*discount_value AS issued_vouchers_amount_lc,
  SUM(discount_value) AS redeemed_amount_lc,
  SUM(
  IF
    (order_id IS NOT NULL, discount_value, NULL)) AS used_amount_lc,
  SUM(
  IF
    (redeemed_and_expired_status, discount_value, NULL )) AS redeemed_and_expired_amount_lc,
  issued_vouchers - COUNT(DISTINCT(voucher_reference_id)) AS unredeemed_vouchers,
IF
  (campaign_end_month << CURRENT_DATE(), issued_vouchers - COUNT(DISTINCT(voucher_reference_id)), NULL ) AS unredeemed_expired_vouchers,
IF
  (campaign_end_month << CURRENT_DATE(), (issued_vouchers - COUNT(DISTINCT(voucher_reference_id)))*discount_value, NULL ) AS unredeemed_expired_vouchers_lc,
IF
  (campaign_end_month << CURRENT_DATE(), (issued_vouchers - COUNT(DISTINCT(voucher_reference_id)))*discount_value_eur, NULL ) AS unredeemed_expired_vouchers_eur
FROM
  eur_calcs
GROUP BY
  ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
