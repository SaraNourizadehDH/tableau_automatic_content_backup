            <properties context='extract'>
              <relation name='Credit Mapping_6171081BD569473E84955062278D496C' table='[Extract].[Credit Mapping_6171081BD569473E84955062278D496C]' type='table' />
            </properties>
          </object>
          <object caption='Funnel View Credits' id='_C16B03DF39724D1DB9BEF517CC79654E'>
            <properties context=''>
              <relation connection='bigquery.1uwd3td0h2301118dxchh0gdd89y' name='Funnel View Credits' type='text'><![CDATA[WITH
  credits AS (
  SELECT
    country_code,
    DATE_TRUNC(date, MONTH) AS month,
    transaction_id,
    description,
    SUM(amount_eur) AS amount_eur,
    SUM(amount_lc) AS amount_lc,
    SUM(used_amount_lc) AS used_amount_lc,
    SUM(expired_amount_lc) AS expired_amount_lc,
    partner_name
  FROM (
    SELECT
      country_code,
      date,
      description,
      transaction_id,
      amount_eur,
      amount_lc,
    IF
      (expiry_date >> CURRENT_DATE(), amount_used_lc, amount_lc - expired_amount_lc) AS used_amount_lc,
      expired_amount_lc,
      CASE
        WHEN description LIKE '%Al Mulla%' THEN 'Al Mulla Group'
        WHEN description LIKE '%Roche Second Agreement%' THEN 'Roche 2'
        WHEN description LIKE '%Roche\\_%' THEN 'Roche'
        WHEN (LOWER(description) LIKE '%nielsen%'
        AND expiry_days <<= 30) THEN 'Nielsen'
        WHEN (LOWER(description) LIKE '%nielsen%' AND expiry_days = 365) THEN 'Nielsen (July Agreement)'
        WHEN LOWER(description) LIKE '%\\_mondelez\\_%' THEN 'Mondelez'
        WHEN LOWER(description) LIKE '%siemens\\_%' THEN 'Siemens'
        WHEN LOWER(description) LIKE '%\\_sigmaegp\\_%' THEN 'Sigma'
        WHEN LOWER(description) LIKE '%\\_ego\\_%' THEN 'EGO'
        WHEN LOWER(description) LIKE '%\\_bms(egypt)\\_%' THEN 'BMS'
        WHEN LOWER(description) LIKE '%\\_audiomob\\_%' THEN 'AudioMob'
        WHEN LOWER(description) LIKE '%\\_dnatatravel\\_%' THEN 'dnata Travel'
        WHEN LOWER(description) LIKE '%enbd\\_%' THEN 'ENBD'
        WHEN LOWER(description) LIKE '%\\_ooredoo%' THEN 'Ooredoo'
        WHEN LOWER(description) LIKE '%\\_nbkghatawi\\_%' THEN 'NBK'
        WHEN LOWER(description) LIKE '%\\_abk(kuwait)\\_%' THEN 'ABK'
        WHEN (LOWER(description) LIKE '%\\_aub%' AND LOWER(description) LIKE '%new campaign%') THEN 'Ahli United Bank (New Agreement)'
        WHEN LOWER(description) LIKE '%\\_aub%' THEN 'Ahli United Bank'
        WHEN LOWER(description) LIKE '%f\\_and\\_g\\_trade%' THEN 'F&G Trade'
        WHEN LOWER(description) LIKE '%\\_omantelmakasib\\_%' THEN 'Omantel'
        WHEN LOWER(description) LIKE '%\\_fifa\\_%' THEN 'FIFA'
        WHEN LOWER(description) LIKE '%\\_kib\\_%' THEN 'KIB'
        WHEN LOWER(description) LIKE '%\\_cbk(kuwait)\\_%' THEN 'CBK'
        WHEN LOWER(description) LIKE '%\\_techne\\_%' THEN 'Techne Summit (KDGP)'
        WHEN LOWER(description) LIKE '%\\_arabiaweather\\_%' THEN 'Arabia Weather'
        WHEN LOWER(description) LIKE '%arammeem%' THEN 'Aram Meem'
        WHEN LOWER(description) LIKE '%syngenta eg%' THEN 'Syngenta'
        WHEN LOWER(description) LIKE '%atlas copco eg%' THEN 'Atlas Copco'
        WHEN LOWER(description) LIKE '%higher colleges of technology%' THEN 'HCT'
        WHEN LOWER(description) LIKE '%jonson controls egypt%' THEN 'Johnson Controls Egypt'
        ELSE SPLIT(description,"_")[1]
    END
      AS partner_name
    FROM
      `tlb-data-prod.data_platform.fct_wallet_transaction`
    WHERE
      description LIKE '%B2B%'
      AND is_bulk_gift
      AND date >>= '2024-01-01' )
  GROUP BY
    ALL)
SELECT
  c.*,
  d.transaction_type_id,
  d.detail_amount_lc,
  d.detail_amount_eur
FROM
  credits c
LEFT JOIN
  `tlb-data-prod.data_platform.fct_wallet_transaction_details` d
ON
  d.parent_earn_transaction_id = c.transaction_id
  AND d.transaction_type_id = 23
WHERE
  d.transaction_type_id IS NULL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_C16B03DF39724D1DB9BEF517CC79654E' table='[Extract].[_C16B03DF39724D1DB9BEF517CC79654E]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[partner_name]' />
                <expression op='[Partner]' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[YEAR(month)]' _.fcp.RelationshipCalculations.true...op='YEAR([month])' />
                <expression op='[Year]' />
              </expression>
            </expression>
            <first-end-point object-id='_C16B03DF39724D1DB9BEF517CC79654E' />
            <second-end-point object-id='Credit Mapping_6171081BD569473E84955062278D496C' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Voucher Funnel View (data_platform)' inline='true' name='federated.1qz8ysl1nftlky14ljzsj0z0x5by' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0vsou1l0sdmpzv12k51pv07ke7c4'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='server-custom' username='zehra.saifuddin@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vsou1l0sdmpzv12k51pv07ke7c4' name='Voucher Funnel View' type='text'><![CDATA[WITH
  base AS (
  SELECT
    c.country_code,
    DATE_TRUNC(DATE(b.campaign_start_date_utc), month) AS campaign_created_month,
    DATE_TRUNC(DATE(b.campaign_end_date_utc), month) AS campaign_end_month,
    DATE(b.campaign_start_date_utc) AS campaign_created_date,
    DATE(b.campaign_end_date_utc) AS campaign_end_date,
    DATE(a.created_on_time_utc, c.timezone) AS customer_redeem_date,
    DATE(a.valid_till_time_utc, c.timezone) AS voucher_expiry_date,
    a.campaign_reference_id,
    gmv_amount_eur,
    CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " "), r'^[^A-Za-z]') THEN CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " "), r'^[^A-Za-z]') THEN REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(6)], "_", " ")
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " ")
  END
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " ")
  END
    AS partner_name,
    CASE
      WHEN campaign_b2b_talabat_commission_percentage IS NULL THEN SAFE_CAST( (CASE
          WHEN ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)] LIKE "%%discount" THEN SPLIT(ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%" AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] LIKE "%discount%" THEN SPLIT(ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%"
        AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] NOT LIKE "%discount%"
        AND SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)] LIKE "%discount%" THEN SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)], "%")[SAFE_OFFSET(0)]
          ELSE "0"
      END
        ) AS FLOAT64)
      ELSE campaign_b2b_talabat_commission_percentage
  END
    AS talabat_commission_percentage,
    b.codes_count AS issued_vouchers,
    CASE
      WHEN LOWER(a.campaign_reference_id) LIKE "%sale%" THEN "sale based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%redempt%" THEN "redemption based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%full%" THEN "full upfront based"
      ELSE "unknown"
  END
    b2b_model,
    a.voucher_reference_id,
    a.voucher_id,
    a.account_id,
    cc.discount_type,
    cc.discount_value,
    a.is_used,
    d.order_date AS usage_date,
    a.order_id,
    c.currency,
    a.platform_cost_share,
    d.gmv_amount_lc
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
  INNER JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher` b
  ON
    a.voucher_id = b.voucher_id
  INNER JOIN
    `tlb-data-prod.data_platform_loyalty.voucher_options` cc
  ON
    cc.id = a.voucher_option_id AND cc.bin_group_id IS NULL
  INNER JOIN
    `tlb-data-prod.data_platform.dim_country_info` c
  ON
    b.country_id = c.country_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` d
  ON
    CAST(d.order_id AS string) = a.order_id
    AND d.is_successful
  WHERE
    b.incentive_type_detail = "VOUCHER_CODE"
