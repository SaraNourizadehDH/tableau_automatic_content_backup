        'coop_ae_partnership_B2B_100%_TheBrooklynCreamery_220714-220731_uc_6x100AED(FLAT)_Full_0%discount_100%vendorfunded_all_one_op',
        'coop_ae_partnership_B2B_100%_TheBrooklynCreamery_220714-220731_uc_6x100AED(percentage)_Full_0%discount_100%vendorfunded_all_one_op',
        'coop_ae_partnership_B2B_100%_TheBrooklynCreamery_220714-220731_uc_6x100AED(percentage)_Full_0%discount_100%vendorfunded_all_one_op',
        'coop_ae_partnership_B2B_100%_Visa-EmiratesIslamicBank_220426-220614_gn_9000x25%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_Visa-EmiratesIslamicBank_220426-220614_gn_9000x25%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_Visa-EmiratesIslamicBank_220426-220614_gn_9000x25%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_Visa-EmiratesIslamicBank_220426-220614_gn_9000x25%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220627-220627_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220523-220523_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220530-220530_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220530-220530_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220606-220606_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220613-220613_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_ae_partnership_B2B_100%_FAB_220620-220620_gn_2000x50%AED_Redemption_0%discount_all_one_op',
        'coop_jo_Partnership_B2B_100%_Merit_Incentives_230407-240407_uc_20x25JOD_Full_4.5%discount_all_one_op' )
      OR LOWER(name) LIKE '%duplicate%'
      OR LOWER(name) LIKE '%test%'
      OR LOWER(name) LIKE '%vendor%'
      OR LOWER(name) LIKE '%mkt%carc%'
      OR id IN ( '0d12d7f0-edb6-43b6-a511-65816e02fdcb',
        'ff302f62-8d49-43d8-b787-4d2478688da7',
        '41a639f3-bb41-4bae-b5c1-a59ae3649a6b',
        '3862d511-2224-4b5c-b559-ea7cab8108a0',
        '35529a6e-d2d0-457b-9d27-6bc8b34f0fd7',
        '117bfbd5-7049-40f1-927f-d25b212ae0b0',
        '50b8fab2-64af-4117-b374-32c1a4bd626e',
        '61c78a5f-30d5-4a7a-b3f5-cfcc84e44d51' ) )
    AND DATE_TRUNC(b.campaign_start_date_lc, MONTH) >>= '2024-01-01'),
  --DATE_TRUNC(DATE(a.created_on_time_utc, c.timezone), month) >>= "2024-01-01"),
  eur_calcs AS (
  SELECT
    b.country_code,
    campaign_created_date,
    campaign_created_month,
    campaign_end_date,
    campaign_end_month,
    customer_redeem_date,
    voucher_expiry_date,
    partner_name,
    talabat_commission_percentage,
    issued_vouchers,
    b2b_model,
    voucher_reference_id,
    voucher_id,
    account_id,
    discount_type,
    discount_value,
    usage_date,
    is_used,
    order_id,
    gmv_amount_eur,
    discount_value/exc1.exchange_rate_value AS discount_value_eur,
    issued_vouchers*(discount_value/exc1.exchange_rate_value) AS issued_vouchers_amount_eur,
  IF
    (order_id IS NULL
      AND voucher_expiry_date << CURRENT_DATE(), TRUE, FALSE) AS redeemed_and_expired_status,
  IF
    (campaign_end_date << CURRENT_DATE(), TRUE,FALSE) AS campaign_end_status,
    exc.exchange_rate_value,
    discount_value/exc1.exchange_rate_value AS discount_value_eur_issue_date,
  FROM
    base b
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_exchange_rate` exc
  ON
    exc.exchange_rate_date = IFNULL(b.usage_date, b.customer_redeem_date)
    AND exc.country_code = b.country_code
    AND exc.exchange_rate_base = 'EUR'
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_exchange_rate` exc1
  ON
    exc1.exchange_rate_date = b.campaign_created_date
    AND exc1.country_code = b.country_code
    AND exc1.exchange_rate_base = 'EUR'
  WHERE
    exc.exchange_rate_base = 'EUR'
    AND exc.exchange_rate_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month)
    AND campaign_created_month >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month)
    AND exc1.exchange_rate_base = 'EUR'
    AND exc1.exchange_rate_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 18 month), month) )
SELECT
  country_code,
  campaign_created_month,
  campaign_end_month,
  partner_name, 
  talabat_commission_percentage,
  b2b_model,
  voucher_id AS campaign_id,
  discount_value AS voucher_value_lc,
  discount_value_eur AS voucher_value_eur,
  issued_vouchers AS issued_count,
  COUNT(DISTINCT(voucher_reference_id)) AS redeem_count,
  COUNT(DISTINCT(order_id)) AS used_count,
  COUNT(DISTINCT(
    IF
      (redeemed_and_expired_status, voucher_reference_id, NULL))) AS redeemed_and_expired_count,
  COUNT(DISTINCT(account_id)) AS redeemers,
  COUNT(DISTINCT(
    IF
      (order_id IS NOT NULL, account_id, NULL))) AS users,
  issued_vouchers_amount_eur,
  SUM(discount_value_eur) AS redeemed_amount_eur,
  SUM(
  IF
    (order_id IS NOT NULL, discount_value_eur, NULL)) AS used_amount_eur,
  SUM(
  IF
    (redeemed_and_expired_status, discount_value_eur, NULL )) AS redeemed_and_expired_amount_eur,
  issued_vouchers*discount_value AS issued_vouchers_amount_lc,
  SUM(discount_value) AS redeemed_amount_lc,
  SUM(
  IF
    (order_id IS NOT NULL, discount_value, NULL)) AS used_amount_lc,
  SUM(
  IF
    (redeemed_and_expired_status, discount_value, NULL )) AS redeemed_and_expired_amount_lc,
  issued_vouchers - COUNT(DISTINCT(voucher_reference_id)) AS unredeemed_vouchers,
IF
  (campaign_end_month << CURRENT_DATE(), issued_vouchers - COUNT(DISTINCT(voucher_reference_id)), NULL ) AS unredeemed_expired_vouchers,
IF
  (campaign_end_month << CURRENT_DATE(), (issued_vouchers - COUNT(DISTINCT(voucher_reference_id)))*discount_value, NULL ) AS unredeemed_expired_vouchers_lc,
IF
  (campaign_end_month << CURRENT_DATE(), (issued_vouchers - COUNT(DISTINCT(voucher_reference_id)))*discount_value_eur, NULL ) AS unredeemed_expired_vouchers_eur
FROM
  eur_calcs
GROUP BY
  ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vsou1l0sdmpzv12k51pv07ke7c4' name='Voucher Funnel View' type='text'><![CDATA[WITH
  base AS (
  SELECT
    c.country_code,
    DATE_TRUNC(DATE(b.campaign_start_date_utc), month) AS campaign_created_month,
    DATE_TRUNC(DATE(b.campaign_end_date_utc), month) AS campaign_end_month,
    DATE(b.campaign_start_date_utc) AS campaign_created_date,
    DATE(b.campaign_end_date_utc) AS campaign_end_date,
    DATE(a.created_on_time_utc, c.timezone) AS customer_redeem_date,
    DATE(a.valid_till_time_utc, c.timezone) AS voucher_expiry_date,
    a.campaign_reference_id,
    gmv_amount_eur,
    CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " "), r'^[^A-Za-z]') THEN CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " "), r'^[^A-Za-z]') THEN REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(6)], "_", " ")
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " ")
  END
      ELSE REPLACE(SPLIT(LOWER(a.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " ")
  END
    AS partner_name,
    CASE
      WHEN campaign_b2b_talabat_commission_percentage IS NULL THEN SAFE_CAST( (CASE
          WHEN ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)] LIKE "%%discount" THEN SPLIT(ARRAY_REVERSE(SPLIT(LOWER(a.campaign_reference_id), "_"))[SAFE_OFFSET(3)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%" AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] LIKE "%discount%" THEN SPLIT(ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(a.campaign_reference_id) LIKE "%_full_%"
        AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] NOT LIKE "%discount%"
        AND SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)] LIKE "%discount%" THEN SPLIT(SPLIT(LOWER(a.campaign_reference_id), "_full_")[SAFE_OFFSET(1)], "%")[SAFE_OFFSET(0)]
          ELSE "0"
      END
        ) AS FLOAT64)
      ELSE campaign_b2b_talabat_commission_percentage
  END
    AS talabat_commission_percentage,
    b.codes_count AS issued_vouchers,
    CASE
      WHEN LOWER(a.campaign_reference_id) LIKE "%sale%" THEN "sale based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%redempt%" THEN "redemption based"
      WHEN LOWER(a.campaign_reference_id) LIKE "%full%" THEN "full upfront based"
      ELSE "unknown"
  END
    b2b_model,
    a.voucher_reference_id,
    a.voucher_id,
    a.account_id,
    cc.discount_type,
    cc.discount_value,
    a.is_used,
    d.order_date AS usage_date,
    a.order_id,
    c.currency,
    a.platform_cost_share,
    d.gmv_amount_lc
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
  INNER JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher` b
  ON
    a.voucher_id = b.voucher_id
  INNER JOIN
    `tlb-data-prod.data_platform_loyalty.voucher_options` cc
  ON
    cc.id = a.voucher_option_id AND cc.bin_group_id IS NULL
  INNER JOIN
    `tlb-data-prod.data_platform.dim_country_info` c
  ON
    b.country_id = c.country_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` d
  ON
    CAST(d.order_id AS string) = a.order_id
    AND d.is_successful
  WHERE
    b.incentive_type_detail = "VOUCHER_CODE"
    AND a.account_id >> 0
    AND is_deleted = FALSE
    AND (LOWER(a.campaign_reference_id) LIKE "%b2b%"
      OR name IN ( 'other_jo_Partnership_OrangeMoneyRamadan2023_230329-230427_gn_6000x30%_all_mult_op',
        'other_qa_Restaurant_Ashghal_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_Ashghal_230227-231231_vw_1x16%_all_mult_op',
        'other_qa_Restaurant_QFC_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_QIC_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_AspireAspetar_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_Workinton_230227-231231_vw_1x22%_all_mult_op',
        'other_qa_Restaurant_GEMS_230227-231231_vw_1x22%_all_mult_op',
