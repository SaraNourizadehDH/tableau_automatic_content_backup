              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Daily&apos; THEN&#10;    IF [date] = [Parameters].[Parameter 5] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 5]) and [Parameters].[Parameter 7] = &apos;Previous Day&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 5]) and [Parameters].[Parameter 7] = &apos;Previous Week&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 5]) and [Parameters].[Parameter 7] = &apos;Previous Month&apos;&#10;    THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 5]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Parameter 5])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Date (copy)_3247306499875086351]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Date (copy)_3247306499875086351])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
            </column>
