        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0covvah1b46hxc14r56u20w10khx' name='Custom SQL Query' type='text'>select
c.contract_name, r.rider_id, rider_name, ci.city_name, r.country_code, date as planned_shift_date, ifnull(sum(t.planned_shift_duration),0) planned_shift


from `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` rlt
join `tlb-data-prod.data_platform.dim_logistics_rider` r on r.country_code=rlt.country_code and rlt.rider_id=r.rider_id
cross join `tlb-data-prod.data_platform.dim_date` d
join `tlb-data-prod.data_platform.dim_logistics_contract` c on c.country_code=rlt.country_code and rlt.contract_id=c.contract_id and c.contract_type=rlt.contract_type and c.city_id=rlt.city_id and date between date(Start_at) and date(end_at)
left join `tlb-data-prod.data_platform.fct_logistics_rider_shift` t on t.country_code=r.country_code and r.rider_id = t.rider_id and d.date=date(shift_start_at,t.timezone) and shift_state=&apos;PUBLISHED&apos; and date(shift_start_at,t.timezone) between current_date() and date_add(current_date, interval 7 day)
inner join `tlb-data-prod.data_platform.dim_logistics_city` ci on ci.country_code=r.country_code and ci.city_id=c.city_id
where date between current_date() and date_add(current_date, interval 7 day) and r.is_active and rlt.country_code not in (&apos;dp-kw&apos;,&apos;k3&apos;)
group by 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
