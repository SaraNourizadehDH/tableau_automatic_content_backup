      <column caption='Blocked Mobile Number Rate %' datatype='real' default-format='p0.0%' name='[Blocked Customer Rate % (copy)_2940428392342605829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([blocked_mobile_count])/&#10;sum([actioned_mobile_count])' />
      </column>
      <column caption='Blocked Device Rate %' datatype='real' default-format='p0.0%' name='[Blocked Mobile Rate % (copy)_2940428392343248902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([blocked_device_count])/&#10;sum([actioned_device_count])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Fraud Rate % (copy)_2940428392340594690]) - LOOKUP(ZN([Fraud Rate % (copy)_2940428392340594690]), -1)) / ABS(LOOKUP(ZN([Fraud Rate % (copy)_2940428392340594690]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fraud Rate %' datatype='real' default-format='p0.0%' name='[Calculation_2940428392340008960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actioned_request_count])/sum([evaluated_request_count])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_2940428392360173577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_2940428392360001544])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_2940428392360001544]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_2940428392360001544])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_2940428392360001544]&#10;then &apos;Selected Period&apos; &#10;&#10;else &apos;Remaining Days&apos;&#10;&#10;end' />
      </column>
      <column caption='False Positive Rate % ' datatype='real' default-format='p0%' name='[Calculation_3986670885370138628]' role='measure' type='quantitative'>
