      <column caption='consumed percentage' datatype='real' default-format='p0.00%' name='[Calculation_2311965126271262720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([consumed_amt_in_eur])/SUM([Calculation_2311965126921015300])' />
      </column>
      <column caption='consumption color' datatype='string' name='[Calculation_2311965126275514370]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2311965126271262720] &gt; 1 THEN &quot;Over 100%&quot;&#10;ELSEIF [Calculation_2311965126271262720] &gt;= 0.9 and [Calculation_2311965126271262720] &lt; 1 THEN &quot;Over 90%&quot;&#10;ELSEIF [Calculation_2311965126271262720] &gt; 0.8 and [Calculation_2311965126271262720] &lt;= 0.9 THEN &quot;80-90%&quot;&#10;ELSE &quot;Below 80%&quot;&#10;END' />
      </column>
      <column caption='exceeded amount (in eur)' datatype='real' name='[Calculation_2311965126276366339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2311965126271262720] &gt; 1 THEN (sum([consumed_amt_in_eur])-sum([Calculation_2311965126921015300]))&#10;ELSE 0&#10;END' />
      </column>
      <column caption='budget fixed (in eur)' datatype='real' name='[Calculation_2311965126921015300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [brand_name] : MAX([budget_eur]) }' />
      </column>
      <column caption='budget consumption ratio' datatype='real' name='[Calculation_2311965126946856966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([consumed_amt_in_eur]) / SUM({ FIXED [brand_name] : MAX([budget_eur]) })' />
      </column>
      <column caption='Label Placeholder' datatype='string' name='[Calculation_2311965126948335624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;All&quot;' />
      </column>
      <column caption='chain_ids_list_per_brand' datatype='string' name='[Calculation_2311965127248580620]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [brand_name] : MIN([chain_ids_list]) }' />
      </column>
      <column caption='Cumulative Consumed Amount' datatype='real' name='[Calculation_656751526768312320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([consumed_amt_in_eur]))'>
          <table-calc ordering-type='Rows' />
