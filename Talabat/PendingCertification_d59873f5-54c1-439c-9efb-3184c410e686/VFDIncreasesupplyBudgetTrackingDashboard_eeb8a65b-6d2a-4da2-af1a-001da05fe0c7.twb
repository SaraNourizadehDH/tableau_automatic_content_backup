            </column>
            <column caption='budget cap in % (80)' datatype='real' default-format='N' name='[budget cap in % (copy)_1860197789738528796]' param-domain-type='any' role='measure' type='quantitative' value='0.8'>
              <calculation class='tableau' formula='0.8' />
            </column>
