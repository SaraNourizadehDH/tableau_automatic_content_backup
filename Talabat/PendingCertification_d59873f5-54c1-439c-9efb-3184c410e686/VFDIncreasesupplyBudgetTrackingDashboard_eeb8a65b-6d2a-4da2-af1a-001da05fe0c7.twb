              <calculation class='tableau' formula='{ FIXED [brand_name] : MAX([budget_eur]) }' />
            </column>
            <column caption='Cumulative % Budget Consumed' datatype='real' name='[Calculation_656751526768443393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([consumed_amt_in_eur])) / MAX([Calculation_2311965126921015300])'>
