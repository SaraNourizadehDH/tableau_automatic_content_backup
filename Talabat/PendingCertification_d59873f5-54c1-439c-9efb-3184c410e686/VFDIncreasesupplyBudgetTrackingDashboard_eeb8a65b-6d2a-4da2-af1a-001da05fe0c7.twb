            <column caption='consumed percentage' datatype='real' default-format='p0.00%' name='[Calculation_2311965126271262720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([consumed_amt_in_eur])/SUM([Calculation_2311965126921015300])' />
            </column>
            <column caption='exceeded amount (in eur)' datatype='real' name='[Calculation_2311965126276366339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2311965126271262720] &gt; 1 THEN (sum([consumed_amt_in_eur])-sum([Calculation_2311965126921015300]))&#10;ELSE 0&#10;END' />
            </column>
            <column caption='budget fixed (in eur)' datatype='real' name='[Calculation_2311965126921015300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand_name] : MAX([budget_eur]) }' />
