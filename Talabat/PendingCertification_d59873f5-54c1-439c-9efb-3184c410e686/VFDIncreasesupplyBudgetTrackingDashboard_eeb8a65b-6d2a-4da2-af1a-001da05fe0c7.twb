      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0AEB758EC44F4863BCF6E1B92C07AF52'>
            <properties context=''>
              <relation connection='bigquery.0rv534z1j2ksj9132s1dq0u3fkon' name='Custom SQL Query' type='text'>with chain_info as
(
  select 
    dc.chain_id,
    dc.chain_name,
  from
    `tlb-data-prod.data_platform.dim_chain` dc
  left join
    `tlb-data-prod.data_platform.dim_vendor_info` dvi on dc.chain_id = dvi.chain_id  
  where
    dc.country_code in (&apos;AE&apos;)
    and dc.chain_id in (select distinct chain_id from `tlb-data-prod.data_platform_google_sheet.vfd_vendor_budget_config` where has_budget_capped = &apos;True&apos; and is_active = &apos;True&apos;)
),

vendor_wise_data as
(
select 
o.order_date as date,
f.brand_name,
AM_Name,
Team_Lead,
Cofund_Percentage,
budget_eur,
campaign_name,
o.incentive_amount_eur,
o.chain_id,
o.order_id
-- count(o.order_id),
--STRING_AGG(DISTINCT CAST(ci.chain_id AS STRING)) AS chain_ids_list,
-- ifnull(sum(i.incentive_amount_eur),0) as consumed_amt_in_eur,
from 
(select distinct brand_name,budget_eur from `tlb-data-prod.data_platform_google_sheet.vfd_vendor_budget_config`
where has_budget_capped = &apos;True&apos; and is_active = &apos;True&apos;) f
inner join `tlb-data-dev.data_playground.vfd_selected_chain_am_name` am on f.brand_name = am.brand_name
left join chain_info ci on f.brand_name = upper(ci.chain_name)
left join `tlb-data-prod.data_platform.fct_order_info` o on o.chain_id = ci.chain_id and order_date&gt;&gt;= &apos;2025-08-05&apos; and is_successful and order_time_utc &gt;&gt;= &apos;2025-08-05 13:00:00&apos;
left join `tlb-data-prod.data_platform.fct_incentive_order_detail` i on o.order_id = i.order_id and campaign_name = &apos;20% off full menu&apos; and i.order_date&gt;&gt;=&apos;2025-08-05&apos; and i.is_successful
and not is_test
and not is_abandoned 
group by all
order by 1
)

select 
date,
brand_name,
AM_Name,
Team_Lead,
Cofund_Percentage,
budget_eur,
STRING_AGG(DISTINCT CAST(chain_id AS STRING)) AS chain_ids_list,
ifnull(sum(incentive_amount_eur),0) as consumed_amt_in_eur,
campaign_name, from vendor_wise_data
where campaign_name is not null
group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
