      </column>
      <column caption='Budget Status' datatype='string' name='[Calculation_656751526769573890]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_656751526768443393] &gt;= 1 THEN &quot;Over Budget&quot;&#10;ELSEIF [Calculation_656751526768443393] &gt;=0.8 and [Calculation_656751526768443393]&lt;1 THEN &quot;Almost Budget&quot;&#10;ELSE &quot;Under Budget&quot;&#10;END'>
