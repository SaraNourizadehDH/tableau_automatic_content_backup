          <datasource-dependencies datasource='federated.0wydtgq0k2a3za15jmbzg11v08x4'>
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ADT]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ADT_P90]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVTC]' role='measure' type='quantitative' />
            <column caption='LS_orders_share' datatype='real' default-format='p0.00%' name='[Calculation_1477743637262315524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([LS_completed_orders])/SUM([zone_completed_orders]))' />
            </column>
            <column caption='GFM_Percentage' datatype='real' name='[Calculation_1477743637263892485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GFM_LS_Vendors])/(SUM([GFM_LS_Vendors])+SUM([nonGFM_LS_vendors])))' />
            </column>
            <column caption='DT_45%' datatype='real' default-format='p0.00%' name='[Calculation_1477743638958489611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT_45mins])/SUM([LS_completed_orders])' />
            </column>
