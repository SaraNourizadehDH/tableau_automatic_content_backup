      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Overall Orders' id='_3FC2C954248A4624BDF3A71A70A3BC3B'>
            <properties context=''>
              <relation connection='bigquery.0yi7z7x0e0k3pu182k9vm0w1zh03' name='Custom SQL Query1' type='text'><![CDATA[SELECT EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
COUNT (DISTINCT order_id) as overall_gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as overall_completed_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as on_time,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Early,
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    -- AND zone_name is not null
GROUP BY ALL
ORDER BY 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_3FC2C954248A4624BDF3A71A70A3BC3B' table='[Extract].[_3FC2C954248A4624BDF3A71A70A3BC3B]' type='table' />
            </properties>
          </object>
          <object caption='Main Query' id='_4A671D5C2C054CCEA26026D3FE2E1C26'>
            <properties context=''>
              <relation connection='bigquery.0yi7z7x0e0k3pu182k9vm0w1zh03' name='Custom SQL Query' type='text'><![CDATA[WITH LS_share as (
  
SELECT zone_name,
EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
-- Hurrier_vendor_name as vendor_name,
-- chain_id,
-- EXTRACT (HOUR FROM  LO.created_at + INTERVAL 3 HOUR) as HOUR,
COUNT (DISTINCT order_id) as gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as completed_orders,
-- COUNT(CASE WHEN LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery") THEN order_id end) as LS_orders,
-- COUNT(CASE WHEN LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery") and LO.order_status = 'completed' THEN order_id end) as LS_completed_orders,

FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND zone_name is not null
GROUP BY ALL
ORDER BY 1,2
)
,zone_orders as (
SELECT zone_name,
EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
COUNT (DISTINCT order_id) as zone_gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as zone_completed_orders
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND zone_name is not null
GROUP BY ALL
ORDER BY 1,2
)
, performance as (
SELECT DISTINCT zone_name,
hurrier_vendor_name,
LO.chain_id,
chain_name,
COUNT(distinct order_id ) as LS_orders,
COUNT(CASE WHEN order_status = 'completed' THEN order_id end) as LS_completed_orders,
EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
COUNT(distinct CASE WHEN is_wait_for_assembled then hurrier_vendor_name end) as GFM_LS_Vendors,
COUNT(distinct CASE WHEN not is_wait_for_assembled then hurrier_vendor_name end) as nonGFM_LS_Vendors,
COUNT (DISTINCT CASE WHEN actual_delivery_time/60 >> 45 THEN LO.order_id END) as DT_45mins,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60  <<= estimated_vendor_preparation_seconds/60 AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RAT_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60 + LO.to_vendor_time/60 <<= fir_preparation_seconds/60 AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RRV_compliance_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN rider_accepting_time END)/60 AS RAT,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.fir_preparation_seconds/60  <<= estimated_vendor_preparation_seconds/60  AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FIR_compliance_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN promised_delivery_time END)/60 AS PDT,
AVG (CASE WHEN LO.order_status = 'completed' THEN actual_delivery_time END)/60 AS ADT,
AVG (CASE WHEN LO.order_status = 'completed' THEN order_delay END)/60 AS order_delay,

APPROX_QUANTILES(LO.promised_delivery_time/60, 100)[OFFSET(90)] AS PDT_P90,
APPROX_QUANTILES(LO.actual_delivery_time/60, 100)[OFFSET(90)] AS ADT_P90,

COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) AS ontime_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as on_time,
COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) AS late_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 15 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late_15,
COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) AS early_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Early,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'TRANSPORT' THEN LO.order_id END) AS transport_failed_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'TRANSPORT' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS Transport_Fail_rate,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'PLATFORM' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS PLATFORM_cancellation,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'CUSTOMER' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS CUSTOMER_cancellation,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'VENDOR' THEN LO.order_id END) AS vendor_cancellation,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'VENDOR' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS VENDOR_cancellation_rate,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'FULFILMENT' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FULFILMENT_cancellation,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_vendor_time_cleaned END)/60 AS avtc,
AVG (CASE WHEN LO.order_status = 'completed' THEN estimated_vendor_preparation_seconds END)/60 as EPT,
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
  LEFT JOIN `tlb-data-dev.data_platform.dim_chain` c on LO.chain_id = c.chain_id and c.country_code ='EG' 
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery")
GROUP BY ALL
ORDER BY 1,2
) 

SELECT DISTINCT ls.zone_name,
zone_completed_orders,
ls.DATE, 
hurrier_vendor_name as vendor_name, 
chain_name,
ls.gross_orders as total_orders,
ls.completed_orders as total_completed_orders,
LS_orders,
LS_completed_orders,
-- ROUND(LS_completed_orders/completed_orders,2) AS LS_orders_percentage,
GFM_LS_Vendors,
nonGFM_LS_vendors,
ROUND(GFM_LS_Vendors/(nonGFM_LS_vendors+GFM_LS_Vendors),2) AS GFM_Vendors_percentage,
DT_45mins,
ROUND(RAT_compliance_perc,2) AS RAT_compliance_perc,
ROUND(RRV_compliance_perc,2) AS RRV_compliance_perc,
ROUND(RAT,2) as RAT,
ROUND(FIR_compliance_perc,2) AS FIR_compliance_perc,
ROUND(PDT,2) AS PDT,
ROUND(ADT,2) AS ADT,
ROUND(order_delay,2) AS order_delay,
ROUND(PDT_P90,2) AS PDT_P90,
ROUND(ADT_P90,2) AS ADT_P90,
ontime_orders, 
ROUND(on_time,2) AS on_time,
late_orders AS late_orders,
ROUND(order_late,2) AS order_late,
ROUND(order_Late_15,2) AS order_late_15,
early_orders AS early_orders,
ROUND(order_early,2) AS order_early,
transport_failed_orders,
ROUND(transport_fail_rate,2) AS transport_fail_rate,
vendor_cancellation,
ROUND(Vendor_cancellation_rate,2) AS vendor_cancellation_rate,
ROUND(avtc,2) as AVTC,
ROUND(late_orders/zone_completed_orders,2) AS lateness_effect,
ROUND(early_orders/zone_completed_orders,2) AS earliness_effect,
ROUND(EPT,2) as EPT,
FROM performance p 
LEFT JOIN LS_share ls ON ls.date = p.date AND ls.zone_name = p.zone_name --AND ls.chain_id = p.chain_id
LEFT JOIN zone_orders z ON ls.date = z.date AND ls.zone_name = z.zone_name 
WHERE hurrier_vendor_name is not null
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_4A671D5C2C054CCEA26026D3FE2E1C26' table='[Extract].[_4A671D5C2C054CCEA26026D3FE2E1C26]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='='>
              <expression op='[DATE]' />
              <expression op='[DATE (Custom SQL Query1)]' />
            </expression>
            <first-end-point object-id='_4A671D5C2C054CCEA26026D3FE2E1C26' />
            <second-end-point object-id='_3FC2C954248A4624BDF3A71A70A3BC3B' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Month over Month' inline='true' name='federated.17hnp0o16u96041bkf4qz1mmodwj' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1so1isw0n614ef13tqxwa0f4sorg'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='habiba.amr.2@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1so1isw0n614ef13tqxwa0f4sorg' name='Custom SQL Query' type='text'><![CDATA[WITH LS_share as (
  
SELECT zone_name,
DATE_TRUNC(DATE(LO.created_at,timezone), MONTH) AS DATE,
-- EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
Hurrier_vendor_name as vendor_name,
chain_id,
-- EXTRACT (HOUR FROM  LO.created_at + INTERVAL 3 HOUR) as HOUR,
COUNT (DISTINCT order_id) as gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as completed_orders,
COUNT(CASE WHEN LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery") THEN order_id end) as LS_orders,
COUNT(CASE WHEN LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery") and LO.order_status = 'completed' THEN order_id end) as LS_completed_orders,

FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN  DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND zone_name is not null
GROUP BY ALL
ORDER BY 1,2
)
,zone_orders as (
SELECT zone_name,
DATE_TRUNC(DATE(LO.created_at,timezone), MONTH) AS DATE,
-- EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
COUNT (DISTINCT order_id) as zone_gross_orders,
COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END) as zone_completed_orders
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN  DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND zone_name is not null
GROUP BY ALL
ORDER BY 1,2
)
, performance as (
SELECT zone_name,
hurrier_vendor_name,
LO.chain_id,
chain_name,
DATE_TRUNC(DATE(LO.created_at,timezone), MONTH) AS DATE,
-- EXTRACT (DATE FROM LO.created_at + INTERVAL 3 HOUR) as DATE,
COUNT(distinct CASE WHEN is_wait_for_assembled then hurrier_vendor_name end) as GFM_LS_Vendors,
COUNT(distinct CASE WHEN not is_wait_for_assembled then hurrier_vendor_name end) as nonGFM_LS_Vendors,
COUNT (DISTINCT CASE WHEN actual_delivery_time/60 >> 45 THEN LO.order_id END) as DT_45mins,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60  <<= estimated_vendor_preparation_seconds/60 AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RAT_compliance_perc,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.rider_accepting_time/60 + LO.to_vendor_time/60 <<= fir_preparation_seconds/60 AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS RRV_compliance_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN rider_accepting_time END)/60 AS RAT,
SAFE_DIVIDE(COUNT ( CASE WHEN LO.fir_preparation_seconds/60  <<= estimated_vendor_preparation_seconds/60  AND LO.order_status = 'completed' THEN LO.order_id END) , COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FIR_compliance_perc,
AVG (CASE WHEN LO.order_status = 'completed' THEN promised_delivery_time END)/60 AS PDT,
AVG (CASE WHEN LO.order_status = 'completed' THEN actual_delivery_time END)/60 AS ADT,
AVG (CASE WHEN LO.order_status = 'completed' THEN order_delay END)/60 AS order_delay,

APPROX_QUANTILES(LO.promised_delivery_time/60, 100)[OFFSET(90)] AS PDT_P90,
APPROX_QUANTILES(LO.actual_delivery_time/60, 100)[OFFSET(90)] AS ADT_P90,

COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) AS ontime_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as on_time,
COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END) AS late_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 15 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late_15,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Early,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'TRANSPORT' THEN LO.order_id END) AS transport_failed_orders,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'TRANSPORT' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS Transport_Fail_rate,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'PLATFORM' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS PLATFORM_cancellation,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'CUSTOMER' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS CUSTOMER_cancellation,
COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'VENDOR' THEN LO.order_id END) AS vendor_cancellation,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'VENDOR' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS VENDOR_cancellation_rate,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN LO.order_status = 'cancelled' AND LO.cancellation_owner = 'FULFILMENT' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) AS FULFILMENT_cancellation,
AVG (CASE WHEN LO.order_status = 'completed' THEN at_vendor_time_cleaned END)/60 AS avtc,
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on LO.zone_id = z.zone_id AND z.country_code = 'eg'
  LEFT JOIN `tlb-data-dev.data_platform.dim_chain` c on LO.chain_id = c.chain_id and c.country_code ='EG' 
   WHERE
    EXTRACT(DATE FROM LO.created_at + INTERVAL 3 HOUR) BETWEEN  DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND LO.order_id IS NOT NULL
    AND LOWER(LO.country_code) = 'eg'
    AND LO.vertical_type not in ('darkstores',"restaurants", "coffee", "bakery")
GROUP BY ALL
ORDER BY 1,2
) 

SELECT ls.zone_name,
zone_completed_orders,
ls.DATE, 
hurrier_vendor_name as vendor_name, 
chain_name,
ls.gross_orders as total_orders,
ls.completed_orders as total_completed_orders,
LS_orders,
LS_completed_orders,
-- ROUND(LS_completed_orders/completed_orders,2) AS LS_orders_percentage,
GFM_LS_Vendors,
nonGFM_LS_vendors,
ROUND(GFM_LS_Vendors/(nonGFM_LS_vendors+GFM_LS_Vendors),2) AS GFM_Vendors_percentage,
DT_45mins,
ROUND(RAT_compliance_perc,2) AS RAT_compliance_perc,
ROUND(RRV_compliance_perc,2) AS RRV_compliance_perc,
ROUND(AVG(RAT),2) as RAT,
ROUND(FIR_compliance_perc,2) AS FIR_compliance_perc,
ROUND(AVG(PDT),2) AS PDT,
ROUND(AVG(ADT),2) AS ADT,
ROUND(AVG(order_delay),2) AS order_delay,
ROUND(AVG(PDT_P90),2) AS PDT_P90,
ROUND(AVG(ADT_P90),2) AS ADT_P90,
SUM(ontime_orders) AS ontime_orders, 
ROUND(AVG(on_time),2) AS on_time,
SUM(late_orders) AS late_orders,
ROUND(AVG(order_late),2) AS order_late,
ROUND(AVG(order_Late_15),2) AS order_late_15,
ROUND(AVG(order_early),2) AS order_early,
transport_failed_orders,
ROUND(AVG(transport_fail_rate),2) AS transport_fail_rate,
vendor_cancellation,
ROUND(AVG(Vendor_cancellation_rate),2) AS vendor_cancellation_rate,
ROUND(AVG(avtc),2) as AVTC,
ROUND(SUM(late_orders)/zone_completed_orders,2) AS lateness_effect
FROM LS_share ls
LEFT JOIN performance p ON ls.date = p.date AND ls.zone_name = p.zone_name AND ls.chain_id = p.chain_id
LEFT JOIN zone_orders z ON ls.date = z.date AND ls.zone_name = z.zone_name 
WHERE hurrier_vendor_name is not null
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
