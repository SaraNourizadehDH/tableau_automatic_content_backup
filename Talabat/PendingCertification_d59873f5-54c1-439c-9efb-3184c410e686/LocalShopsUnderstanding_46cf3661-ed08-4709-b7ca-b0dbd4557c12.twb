SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN ABS(actual_delivery_time/60 - promised_delivery_time/60) <<= 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as on_time,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) >> 10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Late,
SAFE_DIVIDE(COUNT (DISTINCT CASE WHEN (actual_delivery_time/60 - promised_delivery_time/60) << -10 AND order_delay is NOT NULL AND order_status = 'completed' THEN LO.order_id END),COUNT (DISTINCT CASE WHEN LO.order_status = 'completed' THEN order_id END)) as order_Early,
FROM `tlb-data-prod.data_platform.fct_logistics_order` AS LO
   WHERE
