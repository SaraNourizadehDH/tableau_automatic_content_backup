              <calculation class='tableau' formula='/*sum(if [Currency] = &apos;Eur&apos; then [cpc_kwords_search_revenue_eur_wo_vat]&#10;else [cpc_kwords_search_revenue_lc_wo_vat]&#10;END)*/&#10;&#10;&#10;&#10;zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_kwords_search_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_kwords_search_revenue_lc_wo_vat]&#10;END))' />
