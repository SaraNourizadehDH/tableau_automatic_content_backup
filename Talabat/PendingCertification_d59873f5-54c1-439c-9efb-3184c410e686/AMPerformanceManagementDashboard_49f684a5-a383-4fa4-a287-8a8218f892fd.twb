              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
