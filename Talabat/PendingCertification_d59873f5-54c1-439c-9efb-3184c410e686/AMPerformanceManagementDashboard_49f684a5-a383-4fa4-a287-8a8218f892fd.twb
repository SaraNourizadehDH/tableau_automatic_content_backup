            </column>
            <column caption='Commission Rate TMP [Sales Defn] %' datatype='real' default-format='p0.0%' name='[Commission Rate TGO [Sales Defn]] % (copy)_4059572876870193157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(if [delivery_arrangement] = &apos;TMP&apos; then [Calculation_1887852700221997058] end) &#10;+ sum(if [delivery_arrangement] = &apos;TMP&apos; then [Service Fee (copy)_1887852700224598027]end))&#13;&#10;/&#13;&#10;sum(if [delivery_arrangement] = &apos;TMP&apos; then [Commission Amount (copy)_1887852700222341123] end)' />
            </column>
            <column caption='Commission Rate TGO [Sales Defn] %' datatype='real' default-format='p0.0%' name='[Commission Rate [Sales Defn]] % (copy)_4059572876869988356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(if [delivery_arrangement] = &apos;TGO&apos; then [Calculation_1887852700221997058] end) &#10;+ sum(if [delivery_arrangement] = &apos;TGO&apos; then [Service Fee (copy)_1887852700224598027]end))&#13;&#10;/&#13;&#10;sum(if [delivery_arrangement] = &apos;TGO&apos; then [Commission Amount (copy)_1887852700222341123] end)' />
            </column>
