dor Late &gt; 5min V2&quot; then [% Vendor Late &gt; 5min V2]&#10;&#13;&#10;when &quot;Commission %&quot; then [Commission %]&#13;&#10;when &quot;% Incentivized Orders (Incl. Gems)&quot; then [% Incentivized Orders (Incl. Gems)]&#13;&#10;when &quot;% Free Delivery orders (DF=0)&quot; then [% Free Delivery orders (DF=0)]&#13;&#10;when &quot;Customer Contact Rate, %&quot; then [Customer Contact Rate, %]&#13;&#10;when &quot;Net Fail Rate, %&quot; then [Net Fail Rate, %]&#13;&#10;when &quot;% Order Late &gt; 5min&quot; then [% Order Late &gt; 5min]&#13;&#10;when &quot;% Rider Late &gt; 5min&quot; then [% Rider Late &gt; 5min]&#10;&#13;&#10;when &quot;% Orders with Stacking&quot; then [% Orders with Stacking]&#13;&#10;when &quot;CVR by Subsessions&quot; then [CVR by Subsessions]&#13;&#10;when &quot;Net Take Rate, %&quot; then [Net Take Rate, %]&#13;&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Commission Rate [Sales Defn]] %]&#10;&#10;when &quot;% Ads Revenue Vendor Penetration&quot; then [% Ads Revenue Vendor Penetration]&#10;&#10;when &quot;% Vendor Late &gt; 10min&quot;  then [% Vendor Late &gt; 10min]&#10;when &quot;% Vendor Late &gt; 10min V2&quot; then [% Vendor Late &gt; 10min V2]&#10;when &quot;% Order Late &gt; 10min&quot; then [% Order Late &gt; 10min]&#10;when &quot;% Rider Late &gt; 10min&quot; then [% Rider Late &gt; 10min]&#10;&#10;when &quot;﻿vFR % - Bad Vendor&quot; then [vFR % - Bad Vendor]&#10;when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor]&#10;when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TMP - VendorFault Contact Rate % - Bad Vendor]&#10;//when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [NCR Ads Revenue (Excl Banner)]&#10;//when &quot;﻿CPC Featured Prodcut&quot; then [CPC Featured Product]&#10;//when &quot;﻿CPC KeyWord Search&quot; then [CPC KeyWord Search]&#10;//when &quot;﻿CPC Organic Placements&quot; then [CPC Organic Placements] &#10;//when &quot;﻿CPP Featured Product&quot; then [CPP Featured Products]&#10;//when &quot;﻿CPP Premium Placements&quot; then [CPP Premium Placements]&#10;//when &quot;﻿NCR Gems Revenue&quot; then [Gems Revenue]&#10;//when &quot;﻿NCR Vendor Count (Excl. Banner)&quot; then [NCR Vendor Count (Excl Banner)]&#10;//when &quot;﻿CPC Vendor Count&quot; then [CPC Vendor Count]&#10;//when &quot;﻿CPP Vendor Count&quot; then [CPP Vendor Count]&#10;//when &quot;﻿NCR Gem Vendor Count&quot; then [Gem Vendor Count]&#10;when &quot;﻿Full GMV Coverage&quot; then [GMV Coverage]&#10;when &quot;﻿VFD GMV Coverage&quot; then [GMV Incentive Share]&#10;when &quot;﻿VFD Share of Savings %&quot; then [Savings Amount over GMV %]&#10;when &quot;﻿VFD Order Share %&quot; then [VFD order share %]&#10;//when &quot;﻿VFD Orders&quot; then [VFD orders]&#10;//when &quot;﻿VFD GMV&quot; then [VFD GMV]&#10;//when &quot;﻿Menu Discount Orders&quot; then sum([successful_menu_discount_order])&#10;when &quot;﻿Menu Discount Order %&quot; then [Menu Discount Order share]&#10;when &quot;﻿Menu Discount GMV %&quot; then [Menu Discount GMV %]&#10;//when &quot;﻿Menu Discount Vendor Count&quot; then [Menu Discount Vendor Count]&#10;//when &quot;﻿Item Discount Orders&quot; then sum([successful_item_discount_order])&#10;when &quot;﻿Item Discount Order %&quot; then [Item Discount Order share]&#10;when &quot;﻿Item Discount GMV %&quot; then [Item Discount GMV %]&#10;//when &quot;﻿Item Discount Vendor Count&quot; then [Item Discount Vendor Count]&#10;//when &quot;﻿Inc. Free Delivery Orders&quot; then sum([successful_free_delivery_order])&#10;when &quot;﻿Inc. FD Order %&quot; then [Inc. FD Order share]&#10;//when &quot;﻿Buy x Get y Orders&quot; then sum([successful_buy_x_get_y_order])&#10;when &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3, Menu - StartCheckout]&#10;when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [mCVR3a, Menu - AddToCart]&#10;when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout]&#10;when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR4, StartCheckout - PlacedOrder]&#10;&#10;when &quot;Commission Rev. % of GMV&quot; then [Commission Rev. % of GMV]&#13;&#10;&#10;when &quot;Dish level Photos (DLP)&quot; then [Dish Level Photo (DLP)]&#10;when &quot;Dish level Description (DLD)&quot; then [Dish level Description (DLD)]&#10;&#10;//when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg EPT + AVTC (min)]&#10;//when &quot;Active Vendor Count&quot; then [Active Vendor Count]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;when &quot;% of Vendor PriceParity(cWatch Matched)&quot; then [% of Vendor PriceParity(cWatch Matched)]&#10;&#10;when &quot;Vendor Fail Rate, %&quot; then [Vendor Fail Rate, %]&#10;//when &quot;Deal Target Incentive Amount&quot; then sum([Deal Target Incentive Amount])&#10;when &quot;Best Seller, % of Total GMV&quot; then [Best Seller - % of total GMV]&#10;when &quot;tPro Vendors - % of GMV&quot; then [tPro Vendors - % of GMV]&#10;//when &quot;tPro Vendors - GMV&quot; then sum([tPro Vendors - GMV])&#10;//when &quot;Offline Duration (Hrs)&quot; then [Offline Duration (Hrs)]&#10;//when &quot;Scheduled Hours&quot; then [Scheduled Hours]&#10;when &quot;% Offline Duration&quot; then [% Offline Duration]&#10;&#10;&#13;&#10;END&#10;*/' />
            </column>
            <column caption='Net Take per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Net Take (copy)_1766818460926586886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1766818460925755397]&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Net Take Rate, %' datatype='real' default-format='p0.0%' name='[Net Take per Order (copy)_1766818460927668231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1766818460925755397]&#13;&#10;/&#13;&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Report Month' datatype='date' default-format='*dd-mmm-yy' name='[Report Date (copy)_921478710079868968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='TGO Logistics Fees' datatype='real' name='[Service Fee (copy)_1887852700224598027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_tgo_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_tgo_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Avg Service Fee' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Service Fee (copy)_1887852700227932179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (copy)_1887852700224409610])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Successful Orders - Vendor ID Level' datatype='real' name='[Successful Orders - Baseline (copy)_5327265827551883264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed &#10;[Report Date (copy)_921478710079868968]&#10;,[vendor_id]&#10;:SUM(&#10;    if [date] = [Report Date (copy)_921478710079868968] &#10;        and [Granularity Filter (copy)_2116199259332677641] &#10;        and [Granularity Filter (copy)_921478710165938260]&#10;    then [daily_successful_order_count]&#10;    end&#10;    )&#10;}' />
            </column>
            <column caption='Voucher Discount' datatype='real' name='[TGO Logistics Fees (copy)_1887852700224712716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_voucher_discount_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_voucher_discount_amount_eur]&#13;&#10;END' />
            </column>
