then[Avg Estimated Prep Time (min)]&#13;&#10;when &quot;Avg Preparation Time (min)&quot; then [Avg Preparation Time (min)]&#13;&#10;when &quot;Incentivized Orders (Incl. Gems)&quot; then sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;when &quot;Free Delivery Orders (DF=0)&quot; then sum([daily_successful_fd_order_count])&#13;&#10;when &quot;Avg Delivery Time (min)&quot; then [Avg Delivery Time (min)]&#13;&#10;when &quot;Avg Promised Delivery Time (min)&quot; then [Avg Promised Delivery Time (min)]&#13;&#10;when &quot;No of Late Orders&quot; then sum([daily_all_delivery_late_orders])&#13;&#10;when &quot;Avg Delivery Distance (km)&quot; then [Avg Delivery Distance (km)]&#13;&#10;when &quot;Avg Driving Time (min)&quot; then [Avg Driving Time (min)]&#13;&#10;when &quot;No of Orders with Stacking&quot; then sum([daily_total_stacked_orders])&#13;&#10;when &quot;Avg Hold Back Time (min)&quot; then [Avg Hold Back Time (min)]&#13;&#10;when &quot;New Customers&quot; then sum([New Customers (Platform Acquisitions)])&#13;&#10;when &quot;Viewed Menu Subsessions&quot; then sum([Viewed Menu Sub Session Count])&#13;&#10;when &quot;Placed Order Subsessions&quot; then sum([Placed Order Sub Session Count])&#13;&#10;when &quot;Avg Discount Amount&quot; then [Avg Discount Amount]&#13;&#10;when &quot;Avg Voucher Discount&quot; then [Avg Voucher Discount]&#13;&#10;when &quot;Avg Gem Discount&quot; then [Avg Gem Discount]&#13;&#10;when &quot;Avg Commissionable GMV&quot; then [Avg Commissionable GMV]&#13;&#10;when &quot;ABV - [AFV Sales Defn]&quot; then [ABV - [AFV Sales Defn]]]&#13;&#10;when &quot;Net Take per Order&quot; then [Net Take per Order]&#13;&#10;&#10;&#10;//when &quot;﻿vFR % - Bad Vendor&quot; then [vFR % - Bad Vendor]&#10;//when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor]&#10;//when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TMP - VendorFault Contact Rate % - Bad Vendor]&#10;when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [NCR Ads Revenue (Excl Banner)]&#10;when &quot;﻿CPC Featured Prodcut&quot; then [CPC Featured Product]&#10;when &quot;﻿CPC KeyWord Search&quot; then [Keyword Revenue]&#10;when &quot;﻿CPC Organic Placements&quot; then [CPC Revenue] &#10;when &quot;﻿CPP Featured Product&quot; then [CPP Featured Products]&#10;when &quot;﻿CPP Premium Placements&quot; then [CPP Revenue]&#10;when &quot;﻿NCR Gems Revenue&quot; then [Gems Revenue]&#10;when &quot;﻿NCR Vendor Count (Excl. Banner)&quot; then [NCR Vendor Count (Excl Banner)]&#10;&#10;when &quot;﻿CPC Vendor Count&quot; then [CPC Vendor Count]&#10;when &quot;﻿CPP Vendor Count&quot; then [CPP Vendor Count]&#10;when &quot;﻿NCR Gem Vendor Count&quot; then [Gem Vendor Count]&#10;//when &quot;﻿Full GMV Coverage&quot; then [Full GMV Coverage]&#10;//when &quot;﻿VFD GMV Coverage&quot; then [VFD GMV Coverage]&#10;//when &quot;﻿VFD Share of Savings %&quot; then [VFD Share of Savings %]&#10;//when &quot;﻿VFD Order Share %&quot; then [VFD order share %]&#10;when &quot;﻿VFD Orders&quot; then [VFD orders]&#10;when &quot;﻿VFD GMV&quot; then [GMV of Incentivised Orders]&#10;when &quot;﻿Menu Discount Orders&quot; then sum([successful_menu_discount_order])&#10;//when &quot;﻿Menu Discount Order %&quot; then [Menu Discount Order share]&#10;//when &quot;﻿Menu Discount GMV %&quot; then [Menu Discount GMV %]&#10;when &quot;﻿Menu Discount Vendor Count&quot; then [Menu Discount Vendor Count]&#10;when &quot;﻿Item Discount Orders&quot; then sum([successful_item_discount_order])&#10;//when &quot;﻿Item Discount Order %&quot; then [Item Discount Order share]&#10;//when &quot;﻿Item Discount GMV %&quot; then [Item Discount GMV %]&#10;when &quot;﻿Item Discount Vendor Count&quot; then [Item Discount Vendor Count]&#10;when &quot;﻿Inc. Free Delivery Orders&quot; then sum([Successful Incentivised Free Delivery Orders])&#10;// when &quot;﻿Inc. FD Order %&quot; then [Inc. FD Order share]&#10;when &quot;﻿Buy x Get y Orders&quot; then sum([successful_buy_x_get_y_order])&#10;//when &quot;﻿mCVR3, Menu - StartCheckout&quot; then [mCVR3, Menu - StartCheckout]&#10;//when &quot;﻿mCVR3a, Menu - AddToCart&quot; then [mCVR3a, Menu - AddToCart]&#10;//when &quot;﻿mCVR3b, AddToCart - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout]&#10;//when &quot;﻿mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR4, StartCheckout - PlacedOrder]&#10;when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg EPT + AVTC (min)]&#10;when &quot;Active Vendor Count&quot; then [Active Vendor Count]&#10;//when &quot;Zombie Vendor Count&quot; then sum([Zombie Vendor Count])&#10;//when &quot;Online Vendor Count&quot; then [Online Vendor Count]&#10;&#10;when &apos;Active tPro Vendor Count&apos; then [Active tPro Vendor Count]&#10;&#10;&#10;//when &quot;Vendor Fail Rate, %&quot; then [Vendor Fail Rate, %]&#10;when &quot;Deal Target Incentive Amount&quot; then sum([Deal Target Incentive Amount])&#10;//when &quot;Best Seller, % of Total GMV&quot; then [Best Seller - % of total GMV]&#10;//when &quot;tPro Vendors - % of GMV&quot; [tPro Vendors - % of GMV]&#10;when &quot;tPro Vendors - GMV&quot; then sum([tPro Vendors - GMV])&#10;when &quot;Offline Duration (Hrs)&quot; then [Offline Duration (Hrs)]&#10;when &quot;Scheduled Hours&quot; then [Scheduled Hours]&#10;//when &quot;% Offline Duration&quot; then [% Offline Duration]&#10;when &quot;Deal Targeting Revenue Amount &quot; then [Deal Targeting Revenue Amount ]&#10;&#10;when &quot;Vendor Count &gt; 30 Orders (MTD )&quot; then [Vendor Count &gt; 30 Orders (MTD )]&#10;&#13;&#10;//TGO Share, %&#13;&#10;//FIR Usage, %&#13;&#10;//% Vendor Late &gt; 5min&#13;&#10;//% Vendor Late &gt; 5min V2&#13;&#10;//Commission %&#13;&#10;//% Incentivized Orders (Incl. Gems)&#13;&#10;//% Free Delivery orders (DF=0)&#13;&#10;//Customer Contact Rate, %&#13;&#10;//Net Fail Rate, %&#13;&#10;//% Order Late &gt; 5min&#13;&#10;//% Rider Late &gt; 5min&#13;&#10;//% Orders with Stacking&#13;&#10;//CVR by Subsessions