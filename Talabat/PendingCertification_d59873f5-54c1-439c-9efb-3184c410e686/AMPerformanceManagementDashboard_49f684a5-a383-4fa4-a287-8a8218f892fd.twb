hen [Calculation_1887852700453847075]&#10;when &quot;GMV Coverage&quot; then [Calculation_6203497390903332866]&#10;when &quot;GMV Incentive Share&quot; then [Calculation_6203497390904610819]&#10;when &quot;Savings Amount over GMV %&quot; then [Calculation_6203497390927261718]&#10;when &quot;Best Seller - % of total GMV&quot; then [Calculation_222224497323323406]&#10;when &quot;Incentivised Orders Share, %&quot; then [Calculation_4059572876869013507]&#10;when &quot;CVR by Subsessions&quot; then [Calculation_1887852700532879406]&#10;when &quot;mCVR3, Menu - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout (copy)_6478991024399364112]&#10;when &quot;mCVR3a, Menu - AddToCart&quot; then [Calculation_6478991024398819342]&#10;when &quot;mCVR3b,AddToCart - StartCheckout&quot; then [mCVR3a, Menu - AddToCart (copy)_6478991024399069199]&#10;when &quot;mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR3, Menu - StartCheckout (copy)_6478991024399560721]&#10;when &quot;GMV of tPro Vendors over Total GMV, %&quot; then [Calculation_222224497422790680]&#10;when &quot;Net Take Rate, %&quot; then [Net Take per Order (copy)_1766818460927668231]&#10;when &quot;Commission %&quot; then [Calculation_1887852700452315169]&#10;when &quot;Commission Rev. % of GMV&quot; then [Commission Rate [Sales Defn]] % (copy)_814025654015954947]&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Commission % (copy)_1766818460927938568]&#10;when &quot;Commission Rate TGO [Sales Defn] %&quot; then [Commission Rate [Sales Defn]] % (copy)_4059572876869988356]&#10;when &quot;Commission Rate TMP [Sales Defn] %&quot; then [Commission Rate TGO [Sales Defn]] % (copy)_4059572876870193157]&#10;&#10;END&#10;&#10;&#10;/*OLD CALCULATIONS&#10;case [Parameters].[Measure I] &#13;&#10;&#13;&#10;when &quot;TGO Share, %&quot; then [TGO Share, %]&#13;&#10;when &quot;FIR Usage, %&quot; then [FIR Usage, %]&#13;&#10;when &quot;% Vendor Late &gt; 5min&quot;  then [% Vendor Late &gt; 5min]&#13;&#10;when &quot;% Vendor Late &gt; 5min V2&quot; then [% Vendor Late &gt; 5min V2]&#10;&#13;&#10;when &quot;Commission %&quot; then [Commission %]&#13;&#10;when &quot;% Incentivized Orders (Incl. Gems)&quot; then [% Incentivized Orders (Incl. Gems)]&#13;&#10;when &quot;% Free Delivery orders (DF=0)&quot; then [% Free Delivery orders (DF=0)]&#13;&#10;when &quot;Customer Contact Rate, %&quot; then [Customer Contact Rate, %]&#13;&#10;when &quot;Net Fail Rate, %&quot; then [Net Fail Rate, %]&#13;&#10;when &quot;% Order Late &gt; 5min&quot; then [% Order Late &gt; 5min]&#13;&#10;when &quot;% Rider Late &gt; 5min&quot; then [% Rider Late &gt; 5min]&#10;&#13;&#10;when &quot;% Orders with Stacking&quot; then [% Orders with Stacking]&#13;&#10;when &quot;CVR by Subsessions&quot; then [CVR by Subsessions]&#13;&#10;when &quot;Net Take Rate, %&quot; then [Net Take Rate, %]&#13;&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Commission Rate [Sales Defn]] %]&#10;&#10;when &quot;% Ads Revenue Vendor Penetration&quot; then [% Ads Revenue Vendor Penetration]&#10;&#10;when &quot;% Vendor Late &gt; 10min&quot;  then [% Vendor Late &gt; 10min]&#10;when &quot;% Vendor Late &gt; 10min V2&quot; then [% Vendor Late &gt; 10min V2]&#10;when &quot;% Order Late &gt; 10min&quot; then [% Order Late &gt; 10min]&#10;when &quot;% Rider Late &gt; 10min&quot; then [% Rider Late &gt; 10min]&#10;&#10;when &quot;﻿vFR % - Bad Vendor&quot; then [vFR % - Bad Vendor]&#10;when &quot;﻿TGO VfContact Rate % - Bad Vendor&quot; then [TGO - VendorFault Contact Rate % - Bad Vendor]&#10;when &quot;﻿TMP VfContact Rate % - Bad Vendor&quot; then [TMP - VendorFault Contact Rate % - Bad Vendor]&#10;//when &quot;﻿NCR Ads Revenue (Excl. Banner)&quot; then [NCR Ads Revenue (Excl Banner)]&#10;//when &quot;﻿CPC Featured Prodcut&quot; then [CPC Featured Product]&#10;//when &quot;﻿CPC KeyWord Search&quot; then [CPC KeyWord Search]&#10;//when &quot;﻿CPC Organic Placements&quot; then [CPC Organic Placements] &#10;//when &quot;﻿CPP Featured 