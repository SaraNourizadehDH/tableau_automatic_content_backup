              <calculation class='tableau' formula='sum([daily_added_to_cart_session_count])/sum([daily_viewed_menu_session_count])' />
            </column>
            <column caption='Delivery Cost' datatype='real' name='[Calculation_694117325793140736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 1] = &quot;Local&quot;&#13;&#10;    then [Parameters].[Parameter 4]&#13;&#10;    *[daily_successful_order_count]&#13;&#10;    &#13;&#10;    ELSEIF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 1] = &quot;Eur&quot;&#13;&#10;    THEN ([Parameters].[Parameter 4] * [exchange_rate_to_eur])&#13;&#10;    * [daily_successful_order_count]&#13;&#10;&#13;&#10;END)&#13;&#10;)' />
            </column>
            <column caption='Vendor AM ! Null' datatype='boolean' name='[Calculation_694117326007832582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not isnull([Calculation_222224496275509248])' />
