hen &quot;Commission %&quot; then [Commission %]&#10;when &quot;Commission Rev. % of GMV&quot; then [Commission Rev. % of GMV]&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Commission Rate [Sales Defn]] %]&#10;when &quot;Commission Rate TGO [Sales Defn] %&quot; then [Commission Rate TGO [Sales Defn]] %]&#10;when &quot;Commission Rate TMP [Sales Defn] %&quot; then [Commission Rate TMP [Sales Defn]] %]&#10;*/&#10;when &quot;Delivery Fee&quot; then sum([Commissionable GMV (copy)_1887852700222509060])&#10;when &quot;Service Fee&quot; then sum([GMV (copy)_1887852700224409610])&#10;when &quot;Active Vendor Count&quot; then [Calculation_2299509842831519744]&#10;when &quot;Vendor Count &gt; 30 Orders (MTD )&quot; then [Active Vendor Count (copy)_5181109945869340672]&#10;&#10;&#10;&#10;END&#10;&#10;/*&#10;case [Parameters].[Measure I] &#10;when &quot;Successful Orders&quot; then sum([Successful Orders])&#10;when &quot;GMV&quot; then sum([GMV])&#10;when &quot;AOV&quot; then [AOV]&#10;when &quot;Avg Basket Value&quot; then [Avg Basket Value]&#10;when &quot;Avg Delivery Fee TGO&quot; then [Avg Delivery Fee TGO]&#10;when &quot;Avg Effective Fee TGO&quot; then [Avg Effective Fee TGO]&#10;when &quot;Avg Delivery Fee TMP&quot; then [Avg Delivery Fee TMP]&#10;when &quot;Avg Effective Fee TMP&quot; then [Avg Effective Fee TMP]&#10;when &quot;Avg Service Fee&quot; then [Avg Service Fee]&#10;when &quot;TGO Orders&quot; then ([TGO Orders])&#10;when &quot;TMP Orders&quot; then ([TMP Orders])&#10;when &quot;Pickup Orders&quot; then ([Pickup Orders])&#10;when &quot;Avg Vendor Late (min)&quot; then [Avg Vendor Late (min)]&#10;when &quot;Avg Vendor Late V2 (min)&quot; then [Avg Vendor Late V2 (min)]&#10;when &quot;Avg Vendor Clean Time (min)&quot; then [Avg Vendor Clean Time (min)]&#10;when &quot;Avg Estimated Prep Time (min)&quot; then[Avg Estimated Prep Time (min)]&#10;when &quot;Avg Preparation Time (min)&quot; then [Avg Preparation Time (min)]&#10;when &quot;Incentivized Orde