          <datasource-dependencies datasource='sqlproxy.0gxbmd80t3un2i1brp9ow036duee'>
            <column caption='Avg TMP Delivery Fee Benchmark' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV Benchmark (copy) (copy)_4626604193570271253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max({ FIXED [Report Date (copy)_921478710079868968],[country_name],[am_title_group] :&#10;max(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [tmp_avg_delivery_fee_benchmark] * [Calculation_4626604193293422592]&#10;    else [tmp_avg_delivery_fee_benchmark]&#10;end)&#10;})' />
            </column>
            <column caption='Avg Basket Value Benchmark' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV Benchmark (copy)_4626604193556951046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max({ FIXED [Report Date (copy)_921478710079868968],[country_name],[am_title_group]:&#10;max(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [avg_basket_value_benchmark] * [Calculation_4626604193293422592]&#10;    else [avg_basket_value_benchmark]&#10;end)&#10;})' />
            </column>
            <column caption='Avg TGO Delivery Fee Benchmark' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV Benchmark (copy)_4626604193570258964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max({ FIXED [Report Date (copy)_921478710079868968],[country_name],[am_title_group] :&#10;max(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [tgo_avg_delivery_fee_benchmark] * [Calculation_4626604193293422592]&#10;    else [tgo_avg_delivery_fee_benchmark]&#10;end)&#10;})' />
            </column>
            <column caption='AM Team Leader' datatype='string' name='[Account Manager (copy)_222224496280100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Acc. Manager Portfolio Type (copy)_3033174377011576832]= &apos;Current&apos; then [current_assigned_team_leader_name]&#10;ELSE [team_leader_name]&#10;END&#10;&#10;/*[current_assigned_team_leader_name]*/' />
