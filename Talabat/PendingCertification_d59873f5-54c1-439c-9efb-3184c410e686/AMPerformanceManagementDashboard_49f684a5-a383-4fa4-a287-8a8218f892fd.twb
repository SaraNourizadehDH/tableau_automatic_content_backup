              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_tgo_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_tgo_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Avg Service Fee' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Service Fee (copy)_1887852700227932179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (copy)_1887852700224409610])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Successful Orders - Vendor ID Level' datatype='real' name='[Successful Orders - Baseline (copy)_5327265827551883264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed &#10;[Report Date (copy)_921478710079868968]&#10;,[vendor_id]&#10;:SUM(&#10;    if [date] = [Report Date (copy)_921478710079868968] &#10;        and [Granularity Filter (copy)_2116199259332677641] &#10;        and [Granularity Filter (copy)_921478710165938260]&#10;    then [daily_successful_order_count]&#10;    end&#10;    )&#10;}' />
            </column>
