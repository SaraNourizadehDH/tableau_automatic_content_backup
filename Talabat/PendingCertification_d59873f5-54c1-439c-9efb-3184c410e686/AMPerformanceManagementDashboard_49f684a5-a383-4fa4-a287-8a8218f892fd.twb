            <column caption='Net Take' datatype='real' name='[Calculation_1766818460925755397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_1887852700221997058]))&#13;&#10;+&#13;&#10;ZN(sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] END))&#13;&#10;+&#13;&#10;ZN(sum([GMV (copy)_1887852700224409610]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_694117325793140736]' />
