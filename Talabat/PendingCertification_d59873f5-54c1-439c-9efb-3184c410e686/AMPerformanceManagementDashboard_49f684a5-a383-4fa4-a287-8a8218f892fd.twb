              <calculation class='tableau' formula='max({ FIXED [Report Date (copy)_921478710079868968],[country_name],[am_title_group] :&#10;max(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [avg_service_fee_benchmark] * [Calculation_4626604193293422592]&#10;    else [avg_service_fee_benchmark]&#10;end)&#10;})' />
