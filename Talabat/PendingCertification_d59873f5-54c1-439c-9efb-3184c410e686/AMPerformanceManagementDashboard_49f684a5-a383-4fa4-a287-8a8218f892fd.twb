              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 3] = &apos;Month&apos; and &#10;[Parameters].[Parameter 17] = &apos;MTD&apos; then [Granularity (copy)_2116199259332624392] &lt;&gt; &apos;month-runrate-mtf&apos;&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 3] = &apos;Month&apos; and &#10;[Parameters].[Parameter 17] &lt;&gt; &apos;MTD&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;else true&#10;&#10;END' />
