            <column caption='Net Take' datatype='real' name='[Calculation_1766818460925755397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_1887852700221997058]))&#13;&#10;+&#13;&#10;ZN(sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] END))&#13;&#10;+&#13;&#10;ZN(sum([GMV (copy)_1887852700224409610]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_694117325793140736]' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_1887852700221997058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226600973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gem Discount Amount (copy)_1887852700224237577])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Basket Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700226764814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221571073]) / sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg Delivery Fee TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700227051535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Commissionable GMV (copy)_1887852700222509060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='TGO Orders' datatype='real' name='[Calculation_1887852700228476948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='FIR Usage, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700229414936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Food_ready_used_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_Food_ready_used_orders_fir]&#13;&#10;    end)&#13;&#10;/&#13;&#10;sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Total_completed_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_total_completed_orders_fir]&#13;&#10;    end)' />
            </column>
            <column caption='% Vendor Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700440100889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_late_orders_5min])&#13;&#10;/sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='Avg Vendor Late (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451053596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_late_min])&#13;&#10;/&#13;&#10;sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='Avg Vendor Clean Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451573790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_clean_time_min])&#13;&#10;/&#13;&#10;sum([daily_vendor_clean_time_orders])' />
            </column>
            <column caption='Avg Estimated Prep Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451827743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_estimated_prep_time])&#13;&#10;/&#13;&#10;sum([daily_estimated_prep_time_orders])' />
            </column>
            <column caption='Avg Preparation Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700452073504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_assumed_actual_preparation_time])&#13;&#10;/&#13;&#10;sum([daily_assumed_actual_preparation_orders])' />
            </column>
            <column caption='Commission %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700452315169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221997058])&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
            </column>
            <column caption='% Incentivized Orders (Incl. Gems)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453523490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='% Free Delivery orders (DF=0)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453847075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_fd_order_count])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Customer Contact Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700454101028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_contacts])&#13;&#10;/&#13;&#10;sum([gross_orders])' />
            </column>
            <column caption='Net Fail Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700454682661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_net_failed_order_count])&#13;&#10;/&#13;&#10;sum([daily_net_order_count])' />
            </column>
            <column caption='Avg Delivery Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700455686182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_delivery_time_min])&#13;&#10;/&#13;&#10;sum([daily_delivery_time_orders])' />
            </column>
            <column caption='% Order Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700458917928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_Delivery_late_5min])&#13;&#10;/&#13;&#10;sum([daily_eligible_delivery_late_order])' />
            </column>
            <column caption='% Rider Late &gt; 5min' datatype='real' default-format='p0.0%' name='[Calculation_1887852700460032041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_rider_late_orders_5min])&#13;&#10;/&#13;&#10;sum([daily_all_rider_late_orders])' />
            </column>
            <column caption='Avg Delivery Distance (km)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700462321706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_delivery_distance])/SUM([daily_completed_non_pre_gps_error_orders])' />
            </column>
            <column caption='Avg Driving Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700462710827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_driving_time_min])/SUM([daily_completed_non_pre_orders])' />
            </column>
            <column caption='% Orders with Stacking' datatype='real' default-format='p0.0%' name='[Calculation_1887852700523860012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_stacked_orders])&#13;&#10;/&#13;&#10;sum([daily_logistics_completed_orders])' />
            </column>
            <column caption='Avg Hold Back Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700524101677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_hold_back_time])&#13;&#10;/&#13;&#10;sum([daily_hold_back_time_orders])' />
            </column>
            <column caption='CVR by Subsessions' datatype='real' default-format='p0.0%' name='[Calculation_1887852700532879406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_placed_order_sub_session_count])&#13;&#10;/&#13;&#10;sum([daily_viewed_menu_subsession_count])' />
            </column>
            <column caption='ODR Flag' datatype='boolean' name='[Calculation_1887852700554997812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement] = &quot;ODR&quot;' />
            </column>
            <column caption='Report Date' datatype='date' default-format='*dd-mmm-yy' name='[Calculation_1887852700556222519]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Day]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Day (copy)_1887852700555989046]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='Color vs Baseline' datatype='real' name='[Calculation_2052023013245898754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([daily_successful_order_count])) - LOOKUP(ZN(SUM([daily_successful_order_count])), -1)) / ABS(LOOKUP(ZN(SUM([daily_successful_order_count])), -1))&#10;&#10;-&#10;&#10;(ZN(sum({ FIXED [Calculation_1887852700556222519]: SUM([daily_successful_order_count])})) &#10;- LOOKUP(ZN(sum({ FIXED [Calculation_1887852700556222519]: SUM([daily_successful_order_count])})), -1)) &#10;/ ABS(LOOKUP(ZN(sum({ FIXED [Calculation_1887852700556222519]: SUM([daily_successful_order_count])})), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Measure I' datatype='real' default-format='n#,##0.0;(#,##0.0)' name='[Calculation_2060678337344253952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#10;when &quot;Successful Orders&quot; then sum([daily_successful_order_count])&#10;when &quot;GMV&quot; then sum([Gem Discount Amount (copy)_1887852700224237577])&#10;when &quot;AOV&quot; then [Calculation_1887852700226600973]&#10;when &quot;Avg Basket Value&quot; then [Calculation_1887852700226764814]&#10;when &quot;Avg Delivery Fee TGO&quot; then [Calculation_1887852700227051535]&#10;when &quot;Avg Effective Fee TGO&quot; then [Avg Delivery Fee TGO (copy)_1887852700227502097]&#10;when &quot;Avg Delivery Fee TMP&quot; then [Avg Delivery Fee TGO (copy)_1887852700227244048]&#10;when &quot;Avg Effective Fee TMP&quot; then [Avg Effective Fee TGO (copy)_1887852700227670034]&#10;when &quot;Avg Service Fee&quot; then [Service Fee (copy)_1887852700227932179]&#10;when &quot;TGO Orders&quot; then ([Calculation_1887852700228476948])&#10;when &quot;TMP Orders&quot; then ([TGO Orders (copy)_1887852700228681749])&#10;when &quot;Pickup Orders&quot; then ([TMP Orders (copy)_1887852700228734998])&#10;when &quot;Basket Amount&quot; then sum([Calculation_1887852700221571073])&#10;//when &quot;TGO Share, %&quot; then [TGO Share, %]&#10;&#10;when &quot;NCR Ads Revenue (Excl Banner)&quot; then [Calculation_6203497390910783499]&#10;//when &quot;NCR AdRev % of GMV&quot; then [NCR AdRev % of GMV]&#10;&#10;when &quot;CPC Revenue&quot; then [Calculation_6203497390909562885]&#10;when &quot;CPP Revenue&quot; then [CPP Featured Products (copy)_6203497390910406665]&#10;when &quot;Gems Revenue&quot; then [Calculation_6203497390910578698]&#10;when &quot;Featured Product Revenue&quot; then [Calculation_2617858048638431235]&#10;when &quot;Keyword Revenue&quot; then [CPC Featured Product (copy)_6203497390909984775]&#10;when &quot;Deal Targeting Revenue Amount &quot; then [Deal Target Incentive Amount (copy)_2036964088382758912]&#10;when &quot;NCR Vendor Count (Excl Banner)&quot; then [CPC Vendor Count (copy)_6478991024392220679]&#10;when &quot;Avg Vendor Late (min)&quot; then [Calculation_1887852700451053596]&#10;when &quot;Avg Vendor Late V2 (min)&quot; then [Avg Vendor Late (min) (copy)_1887852700451303453]&#10;when &quot;Avg Vendor Clean Time (min)&quot; then [Calculation_1887852700451573790]&#10;when &quot;Avg Estimated Prep Time (min)&quot; then[Calculation_1887852700451827743]&#10;when &quot;Avg Preparation Time (min)&quot; then [Calculation_1887852700452073504]&#10;when &quot;Avg Delivery Time (min)&quot; then [Calculation_1887852700455686182]&#10;when &quot;Avg Promised Delivery Time (min)&quot; then [Avg Delivery Time (min) (copy)_1887852700455976999]&#10;when &quot;Avg Delivery Distance (km)&quot; then [Calculation_1887852700462321706]&#10;when &quot;Avg Driving Time (min)&quot; then [Calculation_1887852700462710827]&#10;when &quot;Avg Hold Back Time (min)&quot; then [Calculation_1887852700524101677]&#10;when &quot;﻿Avg EPT + AVTC (min)&quot; then [Avg Estimated Prep Time (min) (copy)_6489898193058914305]&#10;when &quot;Scheduled Hours&quot; then [Calculation_2116199258539765762]&#10;/*&#10;when &quot;FIR Usage, % (Including PoS)&quot; then [FIR Usage, %]&#10;when &quot;% Vendor Late &gt; 5min&quot; then [% Vendor Late &gt; 5min]&#10;when &quot;% Vendor Late &gt; 10min&quot; then [% Vendor Late &gt; 10min]&#10;when &quot;% Vendor Late &gt; 5min V2&quot; then [% Vendor Late &gt; 5min V2]&#10;when &quot;% Vendor Late &gt; 10min V2&quot; then [% Vendor Late &gt; 10min V2]&#10;when &quot;% Vendor Late &gt; 10min V3&quot; then [% Vendor Late &gt; 10min V3]&#10;when &quot;Customer Contact Rate, %&quot; then [Customer Contact Rate, %]&#10;when &quot;Net Fail Rate, %&quot; then [Net Fail Rate, %]&#10;when &quot;Vendor Fail Rate, %&quot; then [Vendor Fail Rate, %]&#10;when &quot;% Order Late &gt; 5min&quot; then [% Order Late &gt; 5min]&#10;when &quot;% Order Late &gt; 10min&quot; then [% Order Late &gt; 10min]&#10;*/&#10;when &quot;Delivery late orders&quot; then sum([daily_all_delivery_late_orders])&#10;/*&#10;when &quot;% Rider Late &gt; 5min&quot; then [% Rider Late &gt; 5min]&#10;when &quot;% Rider Late &gt; 10min&quot; then [% Rider Late &gt; 10min]&#10;*/&#10;when &quot;Orders with Stacking&quot; then sum([daily_total_stacked_orders])&#10;//when &quot;% Orders with Stacking&quot; then [% Orders with Stacking]&#10;&#10;//when &quot;Dish Level Photo (DLP)&quot; then [Dish Level Photo (DLP)]&#10;//when &quot;Dish level Description (DLD)&quot; then [Dish level Description (DLD)]&#10;//when &quot;% Offline Duration&quot; then [% Offline Duration]&#10;&#10;when &quot;Deal Target Incentive Amount&quot; then sum([Calculation_222224497063833604])&#10;when &quot;Successful Orders with any Discount (Incl.voucher,gem)&quot; then sum([daily_successful_incentivized_order_count_with_gem])&#10;//when &quot;% Orders with any Discounts (Incl.voucher,gems)&quot; then  [% Incentivized Orders (Incl. Gems)]&#10;&#10;when &quot;Successful Free Delivery Orders (DF=0)&quot; then sum([daily_successful_fd_order_count])&#10;//when &quot;% Free Delivery orders (DF=0)&quot; then [% Free Delivery orders (DF=0)]&#10;&#10;when &quot;GMV of Vendors on Incentive&quot; then [Full GMV Coverage (copy)_2743114442592612352]&#10;//when &quot;GMV Coverage&quot; then [GMV Coverage]&#10;when &quot;GMV of Incentivised Orders&quot; then [Calculation_6203497390930489370]&#10;//when &quot;GMV Incentive Share&quot; then [GMV Incentive Share]&#10;when &quot;Savings (Incentive) Amount&quot; then [Calculation_6203497390926553109]&#10;//when &quot;Savings Amount over GMV %&quot; then [Savings Amount over GMV %]&#10;//when &quot;Best Seller - % of total GMV&quot; then [Best Seller - % of total GMV]&#10;&#10;when &quot;Incentivised Successful Orders&quot; then sum([inc_successful_order_count])&#10;//when &quot;Incentivised Orders Share, %&quot; then [Incentivised Orders Share, %]&#10;&#10;when &quot;New Customers (Platform Acquisitions)&quot; then sum([daily_order_new_customer_count]