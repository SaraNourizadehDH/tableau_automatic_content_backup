            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1887852700221571073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
