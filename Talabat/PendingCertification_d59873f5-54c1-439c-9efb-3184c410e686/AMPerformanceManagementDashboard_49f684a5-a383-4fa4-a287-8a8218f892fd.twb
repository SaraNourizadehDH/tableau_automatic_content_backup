      <column caption='Completed ODR Orders' datatype='real' hidden='true' name='[Calculation_1887852700550893619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;ODR&quot; then [daily_logistics_completed_orders] end)' />
      </column>
      <column caption='ODR Flag' datatype='boolean' name='[Calculation_1887852700554997812]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delivery_arrangement] = &quot;ODR&quot;' />
