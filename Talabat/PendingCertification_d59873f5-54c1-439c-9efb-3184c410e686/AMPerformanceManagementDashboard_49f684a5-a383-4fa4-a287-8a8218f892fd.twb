              <calculation class='tableau' formula='//sum([items_with_description]) / sum([total_active_menu_items])&#10;&#10;&#10;sum( &#10;{ FIXED [date],[granularity],[vendor_id],[delivery_arrangement] :sum([items_with_description])}&#10;) &#10;&#10;/ &#10;&#10;sum(&#10;{ FIXED [date],[granularity],[vendor_id],[delivery_arrangement] :sum([total_active_menu_items])}&#10;)' />
            </column>
