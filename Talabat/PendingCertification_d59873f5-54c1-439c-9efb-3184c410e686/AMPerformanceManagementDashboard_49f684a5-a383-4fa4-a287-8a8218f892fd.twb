er_new_customer_count])&#10;when &quot;Viewed Menu Sub Session Count&quot; then sum([daily_viewed_menu_subsession_count])&#10;when &quot;Placed Order Sub Session Count&quot; then sum([daily_placed_order_sub_session_count])&#10;/*&#10;when &quot;CVR by Subsessions&quot; then [CVR by Subsessions]&#10;when &quot;mCVR3, Menu - StartCheckout&quot; then [mCVR3, Menu - StartCheckout]&#10;when &quot;mCVR3a, Menu - AddToCart&quot; then [mCVR3a, Menu - AddToCart]&#10;when &quot;mCVR3b,AddToCart - StartCheckout&quot; then [mCVR3b,AddToCart - StartCheckout]&#10;when &quot;mCVR4, StartCheckout - PlacedOrder&quot; then [mCVR4, StartCheckout - PlacedOrder]&#10;*/&#10;when &quot;tPro Successful Orders&quot; then [Calculation_2743114442637000713]&#10;when &quot;Total Orders of tPro Vendors&quot; then [GMV of tPro Vendors (copy)_2743114442637688842]&#10;when &apos;Active tPro Vendor Count&apos; then [Active Vendor Count (copy)_2320620466090004480]&#10;when &quot;Total GMV of Vendors on tPro&quot; then sum([Calculation_222224497422663703])&#10;//when &quot;GMV of tPro Vendors over Total GMV, %&quot; then [tPro Vendors - % of GMV]&#10;&#10;when &quot;Active tPro Vendor Count&quot; then [Active Vendor Count (copy)_2320620466090004480]&#10;when &quot;Avg Discount Amount&quot; then [Calculation_1766818460923830272]&#10;when &quot;Avg Voucher Discount&quot; then [Avg Discount Amount (copy)_1766818460924456961]&#10;when &quot;Avg Gem Discount&quot; then [Avg Voucher Discount (copy)_1766818460924583938]&#10;when &quot;Avg Commissionable GMV&quot; then [Calculation_1766818460924936195]&#10;when &quot;ABV - [AFV Sales Defn]&quot; then [Calculation_1766818460925415428]&#10;when &quot;Net Take per Order&quot; then [Net Take (copy)_1766818460926586886]&#10;//when &quot;Net Take Rate, %&quot; then [Net Take Rate, %]&#10;&#10;when &quot;Commission Amount&quot; then sum([Calculation_1887852700221997058])&#10;when &quot;Commissionable GMV&quot; then sum([Commission Amount (copy)_1887852700222341123])