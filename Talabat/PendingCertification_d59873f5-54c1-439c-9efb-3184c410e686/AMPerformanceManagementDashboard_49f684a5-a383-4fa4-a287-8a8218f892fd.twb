            <column caption='Net Take per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Net Take (copy)_1766818460926586886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1766818460925755397]&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Net Take Rate, %' datatype='real' default-format='p0.0%' name='[Net Take per Order (copy)_1766818460927668231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1766818460925755397]&#13;&#10;/&#13;&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Report Month' datatype='date' default-format='*dd-mmm-yy' name='[Report Date (copy)_921478710079868968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
            <column caption='TGO Logistics Fees' datatype='real' name='[Service Fee (copy)_1887852700224598027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_tgo_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_tgo_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Avg Service Fee' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Service Fee (copy)_1887852700227932179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (copy)_1887852700224409610])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Successful Orders - Vendor ID Level' datatype='real' name='[Successful Orders - Baseline (copy)_5327265827551883264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed &#10;[Report Date (copy)_921478710079868968]&#10;,[vendor_id]&#10;:SUM(&#10;    if [date] = [Report Date (copy)_921478710079868968] &#10;        and [Granularity Filter (copy)_2116199259332677641] &#10;        and [Granularity Filter (copy)_921478710165938260]&#10;    then [daily_successful_order_count]&#10;    end&#10;    )&#10;}' />
            </column>
            <column caption='Voucher Discount' datatype='real' name='[TGO Logistics Fees (copy)_1887852700224712716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[daily_successful_voucher_discount_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[daily_successful_voucher_discount_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='TMP Orders' datatype='real' name='[TGO Orders (copy)_1887852700228681749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TMP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='TGO Share, %' datatype='real' default-format='p0.0%' name='[TGO Orders (copy)_1887852700228915223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1887852700228476948]&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Pickup Orders' datatype='real' name='[TMP Orders (copy)_1887852700228734998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;PICKUP&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='Chain ! Null' datatype='boolean' name='[Vendor AM ! Null (copy)_694117326012227593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not isnull([chain_name])' />
            </column>
            <column caption='Vendor Name ! Null' datatype='boolean' name='[Vendor AM ! Null (copy)_946881856215199788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not isnull([vendor_name])' />
            </column>
            <column caption='View MTD/Full Month - Growth Views' datatype='boolean' name='[View MTD/Full Month (copy)_1577667264774799360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 3] = &apos;Month&apos; and &#10;[Parameters].[Parameter 17] = &apos;MTD&apos; then [Granularity (copy)_2116199259332624392] &lt;&gt; &apos;month-runrate-mtf&apos;&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 3] = &apos;Month&apos; and &#10;[Parameters].[Parameter 17] &lt;&gt; &apos;MTD&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;else true&#10;&#10;END' />
            </column>
