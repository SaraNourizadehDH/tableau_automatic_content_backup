              <calculation class='tableau' formula='(sum([Calculation_1887852700221997058]) + sum([Service Fee (copy)_1887852700224598027]))&#13;&#10;/&#13;&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
