              <calculation class='tableau' formula='if [Parameters].[Acc. Manager Portfolio Type (copy)_3033174377011576832]= &apos;Current&apos; then [current_assigned_team_leader_name]&#10;ELSE [team_leader_name]&#10;END&#10;&#10;/*[current_assigned_team_leader_name]*/' />
            </column>
            <column caption='NCR AdRev - (Exlc. Banner &amp; SuperSaver)' datatype='real' name='[CPC Featured Product (copy)_921478710158245962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_featured_products_revenue_eur_wo_vat]&#10;else [cpc_featured_products_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_kwords_search_revenue_eur_wo_vat]&#10;else [cpc_kwords_search_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpc_organic_placements_revenue_eur_wo_vat]&#10;else [cpc_organic_placements_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpp_featured_products_revenue_eur_wo_vat]&#10;else [cpp_featured_products_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [cpp_premium_placements_revenue_eur_wo_vat]&#10;else [cpp_premium_placements_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [gem_revenue_eur_wo_vat]&#10;else [gem_revenue_lc_wo_vat]&#10;END)&#10;+&#10;(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [deal_targeting_revenue_amount_eur_wo_vat]&#10;else [deal_targeting_revenue_amount_lc_wo_vat]&#10;END)' />
            </column>
            <column caption='Country Name Exclusions' datatype='boolean' name='[Calculation_1887852699869331456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] != &apos;Unknown&apos;&#13;&#10;and [country_name] != &apos;Null&apos;&#13;&#10;and [country_name] != &apos;KSA&apos;&#10;and [country_name] != &apos;Saudi Arabia&apos;' />
            </column>
            <column caption='ODR Flag' datatype='boolean' name='[Calculation_1887852700554997812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_arrangement] = &quot;ODR&quot;' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
