            <column caption='Week' datatype='date' name='[Day (copy)_1887852700555989046]' role='dimension' type='quantitative' user:agg-type='Week-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [date]))' scope-isolation='false' />
