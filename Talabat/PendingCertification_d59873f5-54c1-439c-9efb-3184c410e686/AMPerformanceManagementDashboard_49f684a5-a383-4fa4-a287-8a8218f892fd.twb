            <column caption='NCR Vendor Count (Excl Banner)' datatype='integer' name='[CPC Vendor Count (copy)_6478991024392220679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([cpc_featured_products_revenue_lc_wo_vat]&#10;            +[cpc_kwords_search_revenue_eur_wo_vat]&#10;            +[cpc_organic_placements_revenue_eur_wo_vat]&#10;            +[cpp_featured_products_revenue_eur_wo_vat]&#10;            +[cpp_premium_placements_revenue_eur_wo_vat]&#10;            +[gem_revenue_eur_wo_vat]&#10;          )&gt; 0 then [vendor_id] end)' />
            </column>
            <column caption='CPP Revenue' datatype='real' name='[CPP Featured Products (copy)_6203497390910406665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*zn(sum(if [Currency] = &apos;Eur&apos; then [cpp_premium_placements_revenue_eur_wo_vat]&#10;else [cpp_premium_placements_revenue_lc_wo_vat]&#10;END))*/&#10;&#10;zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpp_premium_placements_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpp_premium_placements_revenue_lc_wo_vat]&#10;END))' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_162622169926053888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; then CONTAINS([granularity] , &apos;month&apos;)&#10;&#10;END' />
            </column>
            <column caption='Avg Discount Amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1766818460923830272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Delivery Fee (copy)_1887852700223283205])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
