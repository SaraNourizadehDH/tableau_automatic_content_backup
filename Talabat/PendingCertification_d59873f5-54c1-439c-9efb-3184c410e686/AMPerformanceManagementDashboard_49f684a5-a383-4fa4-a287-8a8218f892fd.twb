            </column>
            <column caption='% Offline Duration' datatype='real' default-format='p0.00%' name='[Calculation_2116199258539524096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_seconds])&#10;/&#10;sum([slot_duration_seconds])' />
            </column>
            <column caption='Scheduled Hours' datatype='real' name='[Calculation_2116199258539765762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([slot_duration_seconds])&#10;/ 3600' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_222224496275509248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;Current&apos; then [current_assigned_account_manager_name]&#10;ELSE [vendor_am]&#10;END' />
            </column>
            <column caption='Deal Target Incentive Amount' datatype='real' name='[Calculation_222224497063833604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then [deal_target_incentive_amount_lc]&#10;else [deal_target_incentive_amount_eur]&#10;end' />
            </column>
            <column caption='Best Seller - % of total GMV' datatype='real' default-format='p0.00%' name='[Calculation_222224497323323406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Deal Target Incentive Amount (copy)_222224497064198149]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Vendor Fail Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_222224497420701718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_count]) / sum([vfr_net_order_count])' />
            </column>
            <column caption='Total GMV of Vendors on tPro' datatype='real' name='[Calculation_222224497422663703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Local&apos; then [tpro_vendor_successful_gmv_amount_lc]&#10;else [tpro_vendor_successful_gmv_amount_eur]&#10;END' />
            </column>
            <column caption='GMV of tPro Vendors over Total GMV, %' datatype='real' default-format='p0.00%' name='[Calculation_222224497422790680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_222224497422663703]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[Calculation_2299509842831519744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if zn([daily_successful_order_count])&gt;0 then vendor_id end)' />
            </column>
            <column caption='Dish Level Photo (DLP) - Daily' datatype='real' default-format='p0.00%' name='[Calculation_2412170196595625984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( &#10;{ FIXED [date],[granularity],[vendor_id],[delivery_arrangement] :sum([items_with_images])}&#10;) &#10;&#10;/ &#10;&#10;sum(&#10;{ FIXED [date],[granularity],[vendor_id],[delivery_arrangement] :sum([total_active_menu_items])}&#10;)' />
            </column>
            <column caption='Featured Product Revenue' datatype='real' name='[Calculation_2617858048638431235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_6203497390909800454]) + zn([Calculation_6203497390910263304])' />
            </column>
            <column caption='tPro Successful Orders' datatype='real' name='[Calculation_2743114442637000713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_tpro_order_count])' />
            </column>
            <column caption='NCR AdRev % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_4059572876867104769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CPC Featured Product (copy)_921478710158245962]) / sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='Incentivised Orders Share, %' datatype='real' default-format='p0.00%' name='[Calculation_4059572876869013507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inc_successful_order_count])/sum([daily_successful_order_count])' />
            </column>
            <column caption='tPro Successful Discount Amount' datatype='real' name='[Calculation_4104327438226493440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; THEN [successful_tpro_discount_amount_eur]&#10;else [successful_tpro_discount_amount_lc] end)' />
            </column>
            <column caption='GMV Coverage' datatype='real' default-format='p0.00%' name='[Calculation_6203497390903332866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1]=&apos;Eur&apos; then [full_inc_coverage_successful_gmv_amount_eur] &#10;    else [full_inc_coverage_successful_gmv_amount_eur]  end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='GMV Incentive Share' datatype='real' default-format='p0.00%' name='[Calculation_6203497390904610819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [inc_successful_gmv_amount_eur]&#10;    else [inc_successful_gmv_amount_lc]&#10;    end)&#10;/&#10;sum([Gem Discount Amount (copy)_1887852700224237577])' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_6203497390909562885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_organic_placements_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_organic_placements_revenue_lc_wo_vat]&#10;END))&#10;&#10;&#10;&#10;/*sum(if [Currency] = &apos;Eur&apos;then [cpc_organic_placements_revenue_eur_wo_vat]&#10;else [cpc_organic_placements_revenue_lc_wo_vat]&#10;END)*/' />
            </column>
            <column caption='CPC Featured Product' datatype='real' name='[Calculation_6203497390909800454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*sum(if [Currency] = &apos;Eur&apos; then [cpc_featured_products_revenue_eur_wo_vat]&#10;else [cpc_featured_products_revenue_lc_wo_vat]&#10;END)&#10;*/&#10;&#10;&#10;zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_featured_products_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpc_featured_products_revenue_lc_wo_vat]&#10;END))' />
            </column>
            <column caption='CPP Featured Products' datatype='real' name='[Calculation_6203497390910263304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*zn(sum(if [Currency] = &apos;Eur&apos; then [cpp_featured_products_revenue_eur_wo_vat]&#10;else [cpp_featured_products_revenue_lc_wo_vat]&#10;END))&#10;*/&#10;zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpp_featured_products_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [cpp_featured_products_revenue_lc_wo_vat]&#10;END))' />
            </column>
            <column caption='Gems Revenue' datatype='real' name='[Calculation_6203497390910578698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*sum(if [Currency] = &apos;Eur&apos; then [gem_revenue_eur_wo_vat]&#10;    else [gem_revenue_lc_wo_vat]&#10;    end&#10;)*/&#10;&#10;&#10;&#10;zn(sum(&#10;&#10;if [Parameters].[Parameter 1] = &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [gem_revenue_eur_wo_vat]&#10;&#10;elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Eur&apos; &#10;    and [Granularity Filter (copy)_921478710165938260] &#10;then [gem_revenue_lc_wo_vat]&#10;END))' />
            </column>
            <column caption='NCR Ads Revenue (Excl Banner)' datatype='real' name='[Calculation_6203497390910783499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2617858048638431235]&#10;+[CPP Featured Products (copy)_6203497390910406665]&#10;+[CPC Featured Product (copy)_6203497390909984775]&#10;+[Calculation_6203497390909562885]&#10;+[Calculation_6203497390910578698]&#10;+[Deal Target Incentive Amount (copy)_2036964088382758912]' />
            </column>
            <column caption='Savings (Incentive) Amount' datatype='real' name='[Calculation_6203497390926553109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(if [Parameters].[Parameter 1] = &apos;Eur&apos; then [successful_incentive_amount_eur]&#10;    else [successful_incentive_amount_lc] end))&#10;&#10;+ zn([Calculation_4104327438226493440])' />
