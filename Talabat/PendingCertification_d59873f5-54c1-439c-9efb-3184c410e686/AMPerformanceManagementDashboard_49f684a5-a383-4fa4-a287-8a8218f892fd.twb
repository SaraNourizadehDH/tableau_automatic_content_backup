            <column caption='Account Manager Select Filter' datatype='boolean' name='[Account Manager Select Filter (copy)_222224497657118750]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_222224497656537117] then true else false end' />
