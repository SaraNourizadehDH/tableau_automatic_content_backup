              <calculation class='tableau' formula='sum([daily_vendor_late_min])&#13;&#10;/&#13;&#10;sum([daily_all_vendor_late_orders])' />
            </column>
            <column caption='Avg Vendor Clean Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451573790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_vendor_clean_time_min])&#13;&#10;/&#13;&#10;sum([daily_vendor_clean_time_orders])' />
            </column>
            <column caption='Avg Estimated Prep Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700451827743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_estimated_prep_time])&#13;&#10;/&#13;&#10;sum([daily_estimated_prep_time_orders])' />
            </column>
            <column caption='Avg Preparation Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1887852700452073504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_assumed_actual_preparation_time])&#13;&#10;/&#13;&#10;sum([daily_assumed_actual_preparation_orders])' />
            </column>
            <column caption='Commission %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700452315169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1887852700221997058])&#13;&#10;/&#13;&#10;sum([Commission Amount (copy)_1887852700222341123])' />
            </column>
            <column caption='% Incentivized Orders (Incl. Gems)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453523490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='% Free Delivery orders (DF=0)' datatype='real' default-format='p0.0%' name='[Calculation_1887852700453847075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_fd_order_count])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Customer Contact Rate, %' datatype='real' default-format='p0.0%' name='[Calculation_1887852700454101028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_contacts])&#13;&#10;/&#13;&#10;sum([gross_orders])' />
