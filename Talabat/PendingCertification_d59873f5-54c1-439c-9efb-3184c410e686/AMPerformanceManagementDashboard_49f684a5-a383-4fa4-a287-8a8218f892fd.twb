              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Day]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Day (copy)_1887852700555989046]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Day (copy)_1887852700555935797]&#13;&#10;END' />
            </column>
