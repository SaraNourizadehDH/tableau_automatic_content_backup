  <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([actual_offline_duration_in_seconds]) / TOTAL(SUM([actual_offline_duration_in_seconds]))'>
      <table-calc ordering-type='Columns' />
    </calculation>
  </column>
  <column caption='Offline time (min)' datatype='real' name='[Calculation_2321535240512593926]' role='measure' type='quantitative'>
