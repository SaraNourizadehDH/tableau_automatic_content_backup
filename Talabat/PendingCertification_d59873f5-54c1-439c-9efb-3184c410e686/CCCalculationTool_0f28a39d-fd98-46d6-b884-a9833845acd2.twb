      <column caption='Talabat Sales' datatype='real' name='[Calculation_330170215204261889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] / 14' />
      </column>
      <column caption='Talabat&apos;s No. of Orders' datatype='real' name='[Calculation_330170215205404674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215204261889] / [Parameters].[Parameter 2]' />
      </column>
      <column caption='Op Fees' datatype='real' name='[Calculation_330170215206182916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_330170215204261889]*0.6) * 0.0175' />
      </column>
      <column caption='Talabat&apos;s Commission' datatype='real' default-format='p0%' name='[Calculation_330170215206682629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] / 14' />
      </column>
      <column caption='Talabat&apos;s Ads Investments' datatype='real' name='[Calculation_330170215267647494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Parameters].[Parameter 4] ) * [Calculation_330170215204261889]' />
      </column>
      <column caption='Talabat&apos;s Commission Revenue' datatype='real' name='[Calculation_330170215268900872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215206682629]* 14 * [Calculation_330170215204261889]' />
      </column>
      <column caption='Talabat&apos;s Expenses' datatype='real' name='[Calculation_330170215269306377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215268900872] + [Calculation_330170215206182916] + [Calculation_330170215267647494]' />
      </column>
      <column caption='Talabat&apos;s Cpo' datatype='real' name='[Calculation_330170215269781514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215269306377] / ([Calculation_330170215205404674]*14)' />
      </column>
      <column caption='Rest. Riders Expenses' datatype='real' name='[Calculation_330170215534276621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.16* [Talabat Sales (copy)_330170215533084683]' />
      </column>
      <column caption='Rest. CC Fees' datatype='real' name='[Calculation_330170215534764046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] / 14' />
      </column>
      <column caption='Rest. Total Expenses' datatype='real' name='[Calculation_330170215535362063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215534764046] + [Calculation_330170215534276621] + (0.005 * [Talabat Sales (copy)_330170215533084683])' />
      </column>
      <column caption='Restaurant CPO' datatype='real' name='[Calculation_330170215535792144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_330170215535362063] / ([Talabat&apos;s No. of Orders (copy)_330170215533346828]*14)' />
      </column>
      <column caption='Rest. CPO Vs Talabat&apos;s CPO' datatype='real' default-format='p0.00%' name='[Calculation_330170215538335761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_330170215535792144] - [Calculation_330170215269781514])/[Calculation_330170215535792144]) / 14' />
