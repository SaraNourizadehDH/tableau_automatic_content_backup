        <members>
          <member value='&quot;Ascending&quot;' />
          <member value='&quot;Descending&quot;' />
        </members>
      </column>
      <column caption='Top N Rows' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='50'>
