            <column caption='coldstart vendors with healthy ops and growth products' datatype='integer' name='[coldstart vendors with healthy ops (copy)_3287909213718327296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;Coldstart&quot;  and [Calculation_6366752873063432204] &gt; 0 then ({FIXED [vendor_id] , [is_coldstart] = 1 : &#10;sum(if [Calculation_1348124409283043328] = true and [offline bm check (copy)_1348124409283436545] = true then 1 else 0 end)  }) &#10;else 0 end' />
            </column>
