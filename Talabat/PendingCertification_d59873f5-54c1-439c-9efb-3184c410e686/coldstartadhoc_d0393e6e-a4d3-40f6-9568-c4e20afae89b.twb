  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='% Metric ' datatype='string' name='[Metric (copy)_6153817077670383618]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
