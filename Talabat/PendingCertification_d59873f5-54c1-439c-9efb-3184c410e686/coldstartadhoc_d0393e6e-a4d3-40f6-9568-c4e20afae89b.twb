      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_100205138830794752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_id])' />
      </column>
      <column caption='Offline duration 30 days' datatype='real' name='[Calculation_100205138837782531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30])/sum([actual_duration_in_hrs_0_30])' />
      </column>
      <column caption='CVR 30 days' datatype='real' name='[Calculation_100205138837917700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([placed_order_session_count_0_30])/sum([viewed_menu_session_count_0_30])' />
      </column>
      <column caption='vendor grade' datatype='string' name='[Calculation_1085789731678420992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='lower([vendor_grade])' />
      </column>
      <column caption='offline bm check' datatype='boolean' name='[Calculation_1348124409283043328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED  [vendor_id] : [Calculation_100205138837782531] &lt; avg([Calculation_302937451466973185])}' />
      </column>
      <column caption='coldstart vendors with healthy ops' datatype='integer' name='[Calculation_1348124409286422530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;Coldstart&quot; then ({FIXED [vendor_id] , [is_coldstart] = 1 : &#10;sum(if [Calculation_1348124409283043328] = true and [offline bm check (copy)_1348124409283436545] = true then 1 else 0 end)  })&#10;else 0 end' />
      </column>
      <column caption='Ops quality' datatype='string' name='[Calculation_1348124409407713283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([Calculation_1348124409283043328] = true and [offline bm check (copy)_1348124409283436545] = true ) then &quot;Healthy ops&quot; else &quot;Not healthy ops&quot; end' />
      </column>
      <column caption='Metric' datatype='integer' name='[Calculation_1348124409430323204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5 1] = &quot;Coldstart vendors&quot; then [Calculation_6366752873626861581]&#10;ELSEIF [Parameters].[Parameter 5 1] = &quot;Coldstart vendors with healthy ops&quot; then sum([Calculation_1348124409286422530])&#10;end' />
      </column>
      <column caption='VFD 0 to 30' datatype='real' name='[Calculation_1578441350593847317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([discount_gmv_amount_eur_0_30],0)' />
      </column>
      <column caption='orders forecast' datatype='real' name='[Calculation_1970676725688741888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(if max([Calculation_6366752872450056195]) = &quot;First 30 days not over&quot; then (30 * sum(ifnull([order_0_30_day],0))) / sum([days_since_onboarding] ) end,0)' />
      </column>
      <column caption='forecasted coldstart ' datatype='integer' name='[Calculation_1970676725700165633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ({FIXED [vendor_id],[month]: (ifnull([Calculation_1970676725688741888],0))}) &lt; 30 then 1 else 0 end' />
      </column>
      <column caption='forcasted coldstart vendors' datatype='boolean' name='[Calculation_1970676725711831043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;First 30 days not over&quot; and [Calculation_1970676725700165633] = 1 then true else false end' />
      </column>
      <column caption='completed days' datatype='boolean' name='[Calculation_1970676725802151943]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [day30_from_first_online_date] &lt; [last_updated_at] then true else false  end' />
        <aliases>
          <alias key='false' value='Not completed' />
          <alias key='true' value='Completed' />
        </aliases>
      </column>
      <column caption='Terminated before 30th day' datatype='boolean' name='[Calculation_1970676725814501385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [sf_contract_flags] = &quot;include&quot; then false else true end' />
      </column>
      <column caption='Coldstart vs Healthy' datatype='string' name='[Calculation_1970676726024359949]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [day30_from_first_online_date] &lt; [last_updated_at] then [Calculation_6366752872450056195]&#10;else [forcasted coldstart vendors (copy)_1970676726024179723] end' />
      </column>
      <column caption='DLP on first online date ' datatype='real' name='[Calculation_2249970285810212864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_images_1])/ sum([total_active_menu_items_1])' />
      </column>
      <column caption='DLP on 30th dat from first online date' datatype='real' name='[Calculation_2249970285810393089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([items_with_images_30]) / sum([total_active_menu_items_30])' />
      </column>
      <column caption='check for 15 minutes vendors' datatype='boolean' name='[Calculation_244038865773400075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='contains ((LOWER([vendor_name])) ,&quot;15 minutes&quot;)' />
      </column>
      <column caption='% of vendors on growth products' datatype='real' name='[Calculation_302937451462664192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_6366752873063432204]) / COUNTD([vendor_id])' />
      </column>
      <column caption='Offline rate BM' datatype='real' name='[Calculation_302937451466973185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;Healthy&quot; THEN ({FIXED [Calculation_6366752872450056195] =  &quot;Healthy&quot;, [month], [country_code], [vertical], [business_type] IN (&quot;New Business&quot;,&quot;Win Back&quot;), [Calculation_1085789731678420992] IN (&quot;A&quot;,&quot;AAA&quot;,&quot;B&quot;) : [Calculation_100205138837782531]}) &#10;else 0 end' />
      </column>
      <column caption='check' datatype='boolean' name='[Calculation_302937451481329669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[days_since_onboarding] &lt;= 30 or [months_from_onb_rep_month] = 1' />
      </column>
      <column caption='Growth products' datatype='string' name='[Calculation_3287909213719035906]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([Calculation_6366752873063432204] &gt; 0  ) then &quot;On growth pdts&quot; else &quot;Not on growth pdts&quot; end' />
      </column>
      <column caption='sp' datatype='integer' name='[Calculation_3763250136080084992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='orders_0_30_' datatype='integer' name='[Calculation_4047117647540817926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([order_0_30_day],0)' />
      </column>
      <column caption='Coldstart % (Forecast)' datatype='real' name='[Calculation_448108227671523328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ifnull(countd (if [Calculation_1970676725711831043] = true then [vendor_id] else null end ),0)  +  ifnull(sum([is_coldstart]),0) )&#10;/ COUNTD([vendor_id])' />
      </column>
      <column caption='Dineout agents' datatype='boolean' name='[Calculation_5628514434801917959]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if lower([owner_name]) in (&quot;nehal ruwala&quot;,&quot;lamiaa sabry&quot;,&quot;uthphal ramanan&quot;) then true else false end' />
      </column>
      <column caption='Dineout' datatype='boolean' name='[Calculation_5628514434802434056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([is_dineout] = true or [Calculation_5628514434801917959] = true) then true else false end' />
      </column>
      <column caption='Team' datatype='string' name='[Calculation_5628514434803429385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [title] in (&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,) then &apos;Field Sales&apos;&#10;ELSEIF  lower([owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;else &apos;Account Managers&apos;&#10;end' />
      </column>
      <column caption='Self Activated' datatype='string' name='[Calculation_5941866420104331265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [case_modified_by_name] = &quot;API Vendor Onboarding&quot; then &quot;Self Activated&quot; else &quot;Others&quot; end' />
      </column>
      <column caption='Self activated vendors' datatype='integer' name='[Calculation_5941866420104597506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5941866420104331265] = &quot;Self Activated&quot; then [vendor_id] else null end' />
      </column>
      <column caption='coldstart to healthy' datatype='integer' name='[Calculation_5941866420109066247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_coldstart] = 1 and [order_30_60_day] &gt;= 30 then [vendor_id] end' />
      </column>
      <column caption='Coldstart vendor next 30 day status' datatype='string' name='[Calculation_5941866420117540874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5941866420109066247] &gt; 0 then &quot;Coldstart to healthy&quot; &#10;ELSEIF [Remained coldstart  (copy)_5941866420109520905] &gt; 0 then &quot;Coldstart to churned&quot;&#10;ELSEIF  [coldstart to healthy (copy)_5941866420109283336] &gt;0  then &quot;Remained Coldstart&quot; &#10;else &quot;Others&quot; end' />
      </column>
      <column caption='Total vendors' datatype='integer' name='[Calculation_6153817077673852935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code],[month],[is_dineout],[Calculation_1085789731678420992],[lead_source],[self_setup__c],[am_name],[business_type],[vertical],[vendor_id]: SUM([coldstart_denominator])}' />
      </column>
      <column caption='mCVR3' datatype='real' name='[Calculation_6153817077807140874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([started_checkout_sessions_0_30]) / sum([viewed_menu_session_count_0_30])' />
      </column>
      <column caption='mCVR4' datatype='real' name='[Calculation_6153817077807226891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([placed_order_session_count_0_30]) / sum([started_checkout_sessions_0_30])' />
      </column>
      <column caption='AM assigned?' datatype='string' name='[Calculation_6366752872443891712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if lower([am_name]) = lower([owner_name]) then &quot;Not assigned&quot; else &quot;Assigned&quot; end' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_6366752872444547073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order_session_count_0_30]) / SUM( [viewed_menu_session_count_0_30])' />
      </column>
      <column caption='SP' datatype='integer' name='[Calculation_6366752872446791682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Coldstart?' datatype='string' name='[Calculation_6366752872450056195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if   [days_since_onboarding] &lt; 30 then &quot;First 30 days not over&quot;  &#10;elseif  [is_coldstart] = 1 THEN  &quot;Coldstart&quot; &#10;else &quot;Healthy&quot; end' />
      </column>
      <column caption='Coldstart % (% of vendors with &lt; 30 orders in first 30 days)' datatype='real' name='[Calculation_6366752873059196932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_coldstart]) / sum([coldstart_denominator])' />
      </column>
      <column caption='retained vendors 30 - 60' datatype='integer' name='[Calculation_6366752873059995653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if   ({ FIXED [vendor_id] : sum([order_30_60_day]) &gt; 0}) = true then [vendor_id] else null end&#10;&#10;//if [Coldstart?] = &quot;Coldstart&quot; and  ({ FIXED [vendor_id] : sum([order_30_60_day]) &gt; 0}) = true then [vendor_id] else null end' />
      </column>
      <column caption='coldstart vendors' datatype='boolean' name='[Calculation_6366752873060995080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_coldstart]  &gt; 0' />
      </column>
      <column caption='Healthy vendors' datatype='integer' name='[Calculation_6366752873062068234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;Healthy&quot; and  ({ FIXED [vendor_id] : sum([order_0_30_day]) &gt;= 30}) = true then [vendor_id] else null end' />
      </column>
      <column caption='growth products' datatype='real' name='[Calculation_6366752873062608907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([ad_revenue_0_30]) + [VFD 0 to 30 (copy)_4539206263770177536] + [Targeted discounts 0 to 30 day (copy)_4539206263770361857])' />
      </column>
      <column caption='Vendors on growth products' datatype='integer' name='[Calculation_6366752873063432204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor_id] : if   ([Calculation_6366752873062608907]) &gt; 0 then COUNTD([vendor_id]) else null end }' />
      </column>
      <column caption='Coldstart vendors' datatype='integer' name='[Calculation_6366752873626861581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_coldstart])' />
      </column>
      <column caption='VFR 0 to 30 days' datatype='real' name='[Calculation_6366752873632370703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum( [net_order_0_30])' />
      </column>
      <column caption='Coldstart % (% of vendors with &lt; 30 orders in first 30 days) (copy 2)' datatype='integer' name='[Coldstart % (% of vendors with &lt; 30 orders in first 30 days) (copy 2)_1970676725800374276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_coldstart]) &#10;// sum([coldstart_denominator])' />
      </column>
      <column caption='Coldstart % (% of vendors with &lt; 30 orders in first 30 days) (copy)' datatype='real' name='[Coldstart % (% of vendors with &lt; 30 orders in first 30 days) (copy)_5941866420109045766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_coldstart]) / sum([coldstart_denominator])' />
      </column>
      <column caption='Coldstart vendor next 30 day status (copy)' datatype='string' name='[Coldstart vendor next 30 day status (copy)_6841179004935147521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5941866420109066247] &gt; 0 then &quot;Coldstart to healthy&quot; &#10;ELSEIF [Remained coldstart  (copy)_5941866420109520905] &gt; 0 then &quot;Coldstart to churned&quot;&#10;ELSEIF  [coldstart to healthy (copy)_5941866420109283336] &gt;0  then &quot;Remained Coldstart&quot; &#10;else &quot;Others&quot; end' />
      </column>
      <column caption='Coldstart vs Healthy (copy)' datatype='string' name='[Coldstart vs Healthy (copy)_4047117647539363841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [day30_from_first_online_date] &lt;= [last_updated_at] then [Calculation_6366752872450056195]&#10;else [forcasted coldstart vendors (copy)_1970676726024179723] end' />
      </column>
      <column caption='Coldstart? (copy)' datatype='string' name='[Coldstart? (copy)_244038864916197377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if   [days_since_onboarding] &lt; 30 then &quot;First 30 days not over&quot;  &#10;elseif  [is_coldstart] = 1 THEN  &quot;Coldstart&quot; &#10;else &quot;Healthy&quot; end' />
