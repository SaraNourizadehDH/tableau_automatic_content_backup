              <calculation class='tableau' formula='IF [rider_has_orders] THEN [rider_id] END' />
            </column>
            <column caption='total_riders_orders' datatype='integer' name='[Calculation_5506213534835249156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_5506213534835097603])' />
