          <alias key='&quot;[federated.1m4l97j0wvoa2b1ez6rne05s4dqn].[usr:Calculation_5506213534862655504:qk]&quot;' value='% riders with orders' />
          <alias key='&quot;[federated.1m4l97j0wvoa2b1ez6rne05s4dqn].[usr:Calculation_5506213534862802961:qk]&quot;' value='% riders stacked orders' />
        </aliases>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_107734581264637961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_107734581267701771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='total_riders' datatype='integer' name='[Calculation_5506213534821625856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='total_tmarts' datatype='integer' name='[Calculation_5506213534821851137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='rider_with_orders' datatype='integer' name='[Calculation_5506213534835097603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [rider_has_orders] THEN [rider_id] END' />
      </column>
      <column caption='total_riders_orders' datatype='integer' name='[Calculation_5506213534835249156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_5506213534835097603])' />
      </column>
      <column caption='total_riders_stacked_orders' datatype='integer' name='[Calculation_5506213534840602630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_with_orders (copy)_5506213534835412997])' />
      </column>
      <column caption='riders_crowding' datatype='integer' name='[Calculation_5506213534851239943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT [rider_received_order_within_3min] THEN [rider_id] END' />
      </column>
      <column caption='total_riders_crowding' datatype='integer' name='[Calculation_5506213534851461128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Calculation_5506213534851239943])' />
      </column>
      <column caption='riders_crowding_store-only' datatype='integer' name='[Calculation_5506213534851817481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT [rider_received_order_within_3min] AND [rider_crowding_type] = &apos;rider_crowding_at_store&apos; THEN [rider_id] END' />
      </column>
      <column caption='total_riders_crowding_store' datatype='integer' name='[Calculation_5506213534851891210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_5506213534851817481])' />
      </column>
      <column caption='total_riders_crowding_area' datatype='integer' name='[Calculation_5506213534852128780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([riders_crowding_store (copy)_5506213534852050955])' />
      </column>
      <column caption='rider_crowding_percentage' datatype='real' name='[Calculation_5506213534854393869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5506213534851461128] / [Calculation_5506213534821625856]' />
      </column>
      <column caption='unique_orders' datatype='integer' name='[Calculation_5506213534856122382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [rider_id], [start_time_lc], [end_time_lc] : COUNT([orders]) &gt; 0 } THEN 1 ELSE 0 END' />
      </column>
      <column caption='total_orders' datatype='integer' name='[Calculation_5506213534856167439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5506213534856122382])' />
      </column>
      <column caption='riders_with_orders_percentage' datatype='real' name='[Calculation_5506213534862655504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5506213534835249156] / [Calculation_5506213534821625856]' />
      </column>
      <column caption='riders_with_stacked_orders_percentage' datatype='real' name='[Calculation_5506213534862802961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5506213534840602630] / [Calculation_5506213534821625856]' />
      </column>
      <column caption='Interval' datatype='string' name='[Calculation_5506213534869630994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([start_time_lc]), 9) + &quot; to &quot; + RIGHT(STR([end_time_lc]), 9)' />
      </column>
      <column caption='Sort By calc' datatype='real' name='[Calculation_5506213535128354836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;total_riders_crowding&apos; then [Calculation_5506213534851461128]&#10;WHEN &apos;rider_crowding_percentage&apos; then [Calculation_5506213534854393869]&#10;END' />
      </column>
      <column caption='Order by calc' datatype='real' name='[Calculation_5506213535130255382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Descending&apos; then  [Calculation_5506213535128354836]&#10;ELSE -[Calculation_5506213535128354836]&#10;END' />
      </column>
      <column caption='Select KPI calc' datatype='real' name='[Calculation_5506213535201423384]' role='measure' type='quantitative'>
