      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Cohort Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Users&quot;'>
          <calculation class='tableau' formula='&quot;Users&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F962EE273C484444B600CF8CD565112A'>
            <properties context=''>
              <relation connection='bigquery.06tedhq15fc16x197e5wc10qf28o' name='Custom SQL Query' type='text'>WITH &#13;
-- new_users_avg_6_mo as(&#13;
-- SELECT &#13;
--   country_code,&#13;
--   AVG(users) as avg_6_mo&#13;
--  FROM(&#13;
-- SELECT &#13;
-- o.COUNTRY_CODE,&#13;
-- DATE_TRUNC(o.order_date,month) as MONTH,&#13;
-- COUNT (DISTINCT oi.account_id) as users,&#13;
&#13;
&#13;
&#13;
--  FROM `tlb-data-prod.data_platform.fct_order_rank` o&#13;
--  LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` oi ON o.order_id=oi.order_id AND o.country_code=oi.country_code&#13;
--  WHERE 1=1&#13;
--   AND o.order_date between &quot;2023-06-01&quot; and &quot;2023-12-31&quot;&#13;
--   AND oi.order_date between &quot;2023-06-01&quot; and &quot;2023-12-31&quot;&#13;
--   AND account_order_index=1&#13;
--   AND delivery_arrangement =&apos;TGO&apos;&#13;
&#13;
--   AND is_successful&#13;
--   --AND account_id=5600921&#13;
-- GROUP by 1,2&#13;
&#13;
--  )&#13;
-- Group by 1&#13;
-- ),&#13;
&#13;
first_order AS (&#13;
  SELECT &#13;
    oi.country_code,&#13;
    oi.account_id,&#13;
    DATE_TRUNC(oi.order_date, MONTH) AS month,&#13;
    DATE_TRUNC(MIN(oi.order_date), MONTH) AS first_order_month,&#13;
    SUM(-1 * dps_incentive_discount_eur) as dps_incentive_discount_eur,&#13;
    COUNT(oi.order_id) as new_orders,&#13;
  FROM&#13;
    `tlb-data-prod.data_platform.fct_order_info` oi&#13;
    &#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders`  dps &#13;
    ON oi.country_code=UPPER(dps.country_code) &#13;
    AND CAST(oi.order_id AS STRING)=dps.platform_order_code&#13;
  WHERE &#13;
    oi.order_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
    AND dps.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
    AND oi.is_successful&#13;
    AND oi.is_fdnc_order&#13;
    AND delivery_fee_amount_lc=0&#13;
    AND delivery_arrangement =&apos;TGO&apos;&#13;
  GROUP BY &#13;
    1,2,3&#13;
),&#13;
&#13;
orders AS (&#13;
  SELECT&#13;
    DATE_TRUNC(oi.order_date, MONTH) AS order_month,&#13;
    oi.country_code,&#13;
    oi.account_id,&#13;
    COUNT(oi.order_id) AS orders,&#13;
    SUM(gmv_amount_eur) as gmv,&#13;
    &#13;
    SUM(delivery_fee_amount_eur) as delivery_fee_amount_eur,&#13;
    SUM(service_fee_amount_eur) as service_fee_amount_eur,&#13;
    SUM(commission_eur) as commission_eur,&#13;
    &#13;
    &#13;
&#13;
&#13;
  FROM&#13;
    `tlb-data-prod.data_platform.fct_order_info` oi&#13;
  LEFT JOIN&#13;
  `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders`  dps &#13;
    ON oi.country_code=UPPER(dps.country_code) &#13;
    AND CAST(oi.order_id AS STRING)=dps.platform_order_code&#13;
  WHERE &#13;
    oi.order_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
    AND dps.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
    AND oi.is_successful&#13;
    AND delivery_arrangement =&apos;TGO&apos;&#13;
  GROUP BY&#13;
    1, 2, 3&#13;
)&#13;
&#13;
SELECT &#13;
  fo.first_order_month AS cohort_month,&#13;
  o.order_month,&#13;
  o.country_code,&#13;
  COUNT(DISTINCT fo.account_id) AS new_users,&#13;
  &#13;
  --SUM(new_orders) as new_orders,&#13;
  &#13;
  &#13;
  COUNT(DISTINCT CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.account_id END) AS returned_customers,&#13;
  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.orders ELSE 0 END) AS returned_customer_orders,&#13;
  --SUM(CASE WHEN o.order_month &gt;&gt; fo.first_order_month THEN o.gmv ELSE 0 END) AS returned_customer_gmv,&#13;
  --SUM(delivery_)&#13;
  SUM(o.orders) AS returned_customer_orders,&#13;
  SUM(o.gmv) AS returned_customer_gmv,&#13;
  &#13;
  SUM( CASE WHEN o.order_month = fo.first_order_month THEN dps_incentive_discount_eur END) AS dps_incentive_discount_eur,&#13;
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) as CPO,&#13;
  &#13;
  -- SUM(service_fee_amount_eur) as service_fee_amount_eur,&#13;
  -- SUM(delivery_fee_amount_eur) as delivery_fee_amount_eur,&#13;
  -- SUM(commission_eur) as commission_eur,&#13;
  &#13;
  --SUM(delivery_fee_amount_eur+service_fee_amount_eur+commission_eur) as Half_GP,&#13;
  &#13;
  (MAX(CPO.CPO_Euro) * SUM(o.orders)) + SUM(delivery_fee_amount_eur+service_fee_amount_eur+commission_eur)  as GP,&#13;
  --MAX(avg_6_mo) as avg_6_mo&#13;
  CASE &#13;
    WHEN o.country_code = &apos;EG&apos; THEN 0.07 &#13;
    WHEN o.country_code = &apos;IQ&apos; THEN 0.27&#13;
    WHEN o.country_code = &apos;JO&apos; THEN 0.16 &#13;
    WHEN o.country_code = &apos;BH&apos; THEN 0.12 &#13;
    WHEN o.country_code = &apos;QA&apos; THEN 0.21 &#13;
    WHEN o.country_code = &apos;AE&apos; THEN 0&#13;
    WHEN o.country_code = &apos;OM&apos; THEN 0&#13;
    WHEN o.country_code = &apos;KW&apos; THEN 0&#13;
  END AS incremental_users_per&#13;
&#13;
FROM &#13;
  first_order fo&#13;
LEFT JOIN &#13;
  orders o ON fo.account_id = o.account_id AND fo.country_code=o.country_code&#13;
LEFT JOIN &#13;
  `tlb-data-dev.data_playground_regional_pricing.monthly_fully_loaded_cpo_table` CPO on &#13;
   o.order_month=CPO.month and o.country_code=CPO.Country_Code&#13;
--LEFT JOIN new_users_avg_6_mo b on fo.country_code=b.country_code&#13;
WHERE 1=1&#13;
  --AND fo.country_code=&apos;JO&apos;&#13;
  &#13;
&#13;
GROUP BY &#13;
  fo.first_order_month, o.order_month, o.country_code&#13;
ORDER BY &#13;
  fo.first_order_month, o.order_month, o.country_code</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
