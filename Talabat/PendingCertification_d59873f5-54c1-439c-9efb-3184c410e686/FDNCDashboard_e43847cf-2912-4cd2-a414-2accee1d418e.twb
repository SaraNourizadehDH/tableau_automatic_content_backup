            <column caption='Cohort Metric' datatype='real' name='[Calculation_841610199226773504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN [new_users]&#13;&#10;WHEN &apos;Orders&apos; THEN [returned_customer_orders]&#13;&#10;WHEN &apos;GMV&apos; THEN [returned_customer_gmv]&#13;&#10;WHEN &apos;Incentive Spend&apos; THEN -[dps_incentive_discount_eur]&#13;&#10;WHEN &apos;GP&apos; THEN [GP]&#13;&#10;WHEN &apos;Net GP&apos; THEN [Calculation_841610202394591236]&#13;&#10;WHEN &apos;Order Frequency&apos; THEN [Net GP (copy)_1799469553759350795]&#13;&#10;END' />
            </column>
            <column caption='Fixed_Cohort_Mertic' datatype='real' name='[Calculation_841610199446261761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [cohort_month], [country_code] : SUM(IF [order_month] = [cohort_month] THEN [Calculation_841610199226773504] END) }' />
            </column>
            <column caption='%Cohort Metric' datatype='real' default-format='p0%' name='[Calculation_841610199446482946]' role='measure' type='quantitative'>
