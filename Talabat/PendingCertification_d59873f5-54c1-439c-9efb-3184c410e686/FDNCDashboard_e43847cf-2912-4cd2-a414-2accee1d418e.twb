      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:Calculation_841610203003039749:qk]&quot;' value='Users' />
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:dps_incentive_discount_eur:qk]&quot;' value='Incentive Spend' />
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:MoM New Users (copy)_1799469553719791619:qk]&quot;' value='GMV' />
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[sum:MoM New Users (copy)_1799469553720156164:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.0u3a8w80tjcboo120y90w0g3evru].[usr:MoM New Users Orders (copy)_1799469553730289674:qk]&quot;' value='Incremental Orders' />
        </aliases>
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_1799469553708007424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dps_incentive_discount_eur]/[Calculation_841610203003039749]' />
      </column>
      <column caption='ROI' datatype='real' name='[Calculation_1799469553722785798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[MoM New Users (copy)_1799469553719791619]/[dps_incentive_discount_eur]' />
      </column>
      <column caption='Incremental Users' datatype='real' name='[Calculation_1799469553729581064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([new_users]) * MAX([incremental_users_per])&#13;&#10;SUM([new_users]) * 0.17' />
      </column>
      <column caption='Same Month' datatype='boolean' name='[Calculation_1799469554098814990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cohort_month]&lt;=[order_month]' />
      </column>
      <column caption='Cohort Metric' datatype='real' name='[Calculation_841610199226773504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Users&apos; THEN [new_users]&#13;&#10;WHEN &apos;Orders&apos; THEN [returned_customer_orders]&#13;&#10;WHEN &apos;GMV&apos; THEN [returned_customer_gmv]&#13;&#10;WHEN &apos;Incentive Spend&apos; THEN -[dps_incentive_discount_eur]&#13;&#10;WHEN &apos;GP&apos; THEN [GP]&#13;&#10;WHEN &apos;Net GP&apos; THEN [Calculation_841610202394591236]&#13;&#10;WHEN &apos;Order Frequency&apos; THEN [Net GP (copy)_1799469553759350795]&#13;&#10;END' />
      </column>
      <column caption='Fixed_Cohort_Mertic' datatype='real' name='[Calculation_841610199446261761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [cohort_month], [country_code] : SUM(IF [order_month] = [cohort_month] THEN [Calculation_841610199226773504] END) }' />
      </column>
      <column caption='%Cohort Metric' datatype='real' default-format='p0%' name='[Calculation_841610199446482946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_841610199226773504]) /&#13;&#10;[Calculation_841610199446261761]' />
      </column>
      <column caption='Net GP' datatype='real' name='[Calculation_841610202394591236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GP] - IFNULL([dps_incentive_discount_eur],0)' />
      </column>
      <column caption='MoM New Users' datatype='integer' name='[Calculation_841610203003039749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [new_users] END' />
      </column>
      <column caption='MoM New Users GMV' datatype='real' name='[MoM New Users (copy)_1799469553719791619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_gmv] END' />
      </column>
      <column caption='MoM New Users Orders' datatype='integer' name='[MoM New Users (copy)_1799469553720156164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_month]=[cohort_month] then [returned_customer_orders] END' />
      </column>
      <column caption='MoM  Incremental Users Orders' datatype='real' name='[MoM New Users Orders (copy)_1799469553730289674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [order_month]=[cohort_month] then [returned_customer_orders] END) * 0.6' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Net GP (copy)_1799469553759350795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[returned_customer_orders]/[new_users]' />
      </column>
