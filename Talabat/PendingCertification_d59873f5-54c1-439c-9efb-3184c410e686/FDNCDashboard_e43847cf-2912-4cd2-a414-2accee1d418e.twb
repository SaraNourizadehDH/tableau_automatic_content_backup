            </column>
            <column caption='ROI' datatype='real' name='[Calculation_1799469553722785798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MoM New Users (copy)_1799469553719791619]/[dps_incentive_discount_eur]' />
            </column>
            <column caption='Incremental Users' datatype='real' name='[Calculation_1799469553729581064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([new_users]) * MAX([incremental_users_per])&#13;&#10;SUM([new_users]) * 0.17' />
            </column>
            <column caption='Net GP' datatype='real' name='[Calculation_841610202394591236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GP] - IFNULL([dps_incentive_discount_eur],0)' />
