              <calculation class='tableau' formula='[returned_customer_orders]/[new_users]' />
            </column>
            <column caption='First Month' datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dps_incentive_discount_eur]' role='measure' type='quantitative' />
