          <datasource-dependencies datasource='federated.1m7d1m505t6rdw15tdxpw1utqaz5'>
            <column caption='PLP KPI 1' datatype='real' name='[Calculation_212654369271054349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Range 1 Start (copy)]&#10;WHEN 1 THEN SUM([plp_impression_sessions_count])&#10;WHEN 2 THEN [Calculation_212654369271980049]&#10;WHEN 3 THEN SUM([plp_click_sessions_count])&#10;WHEN 4 THEN [Calculation_212654369271455758]&#10;WHEN 5 THEN SUM([plp_atc_sessions_count])&#10;WHEN 6 THEN [Calculation_212654369271713807]&#10;ELSE [Calculation_212654369271771152]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='PLP CTR' datatype='real' name='[Calculation_212654369271455758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plp_click_sessions_count])/SUM([plp_impression_sessions_count])' />
            </column>
            <column caption='PLP ATCR' datatype='real' name='[Calculation_212654369271713807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plp_atc_sessions_count])/SUM([plp_impression_sessions_count])' />
            </column>
            <column caption='PLP Clicks to ATC' datatype='real' name='[Calculation_212654369271771152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plp_atc_sessions_count])/SUM([plp_click_sessions_count])' />
            </column>
            <column caption='PLP Impression Share' datatype='real' name='[Calculation_212654369271980049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plp_impression_sessions_count])/TOTAL(SUM([plp_impression_sessions_count]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
