    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/CustomerIntentDashboard/Definitions?rev=' id='Definitions' path='/t/Talabat/workbooks/CustomerIntentDashboard' revision='' site='Talabat' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#ec662c' fontname='Comic Sans MS' fontsize='14' underline='true'>About this dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run fontname='Comic Sans MS' fontsize='10'>We created this dashboard to be able to make decisions on what products or categories to push on a particular tMart&apos;s VLP or Category PLP based on what our users are searching for the most, in order to ensure a speedy checkout for them. We&apos;re assuming here that the products users are searching for signals intent and the merchandizing decisions can be very data-driven thanks to this dashboard. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ec662c' fontname='Comic Sans MS' fontsize='14' underline='true'>Metric Definitions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Impressions</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>The number of distinct sessions in which the product SKU was displayed either on the search results page or a Product Listing Page for that vendor within a specified date.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Clicks</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>The number of distinct sessions in which the product SKU was clicked on either on the search results page or a Product Listing Page for that vendor within a specified date. (This includes add to carts and PDP clicks)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>ATC</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>The number of distinct sessions in which the product SKU was added to cart either on the search results page or a Product Listing Page for that vendor within a specified date.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>CTR</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>(Clicks)/(Impressions)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>ATCR</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>(ATC)/(Impressions)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>ATC per Click</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>(ATC)/(Clicks)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Impression Share</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>percentage of impressions for a category from total impressions recorded for that duration</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Delta metrics</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>: </run>
              <run fontname='Comic Sans MS' fontsize='10'>The percentage difference between a metric between the 2 specified date ranges. The general formula is (Date Range 2 Metric - Date Range 1 Metric)/(Date Range 1 Metric)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ec662c' fontname='Comic Sans MS' fontsize='14' underline='true'>How to use the dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>1) </run>
              <run fontname='Comic Sans MS' fontsize='10'>Choose the overall date range for your analysis in the filters</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>2) </run>
              <run fontname='Comic Sans MS' fontsize='10'>Choose the country you want to analyse.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>3) </run>
              <run fontname='Comic Sans MS' fontsize='10'>Choose the chain you want to analyze.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>4) </run>
              <run fontname='Comic Sans MS' fontsize='10'>For the Category Level View and SKU Level View enter the 2 date ranges you would like to compare in the DD/MM/YYYY format.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Comic Sans MS' fontsize='10'>5) </run>
              <run fontname='Comic Sans MS' fontsize='10'>For the Metrics Evolution you can choose a Daily, Weekly and Monthly aggregation and you can choose the level of split you want in terms of category.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ec662c' fontname='Comic Sans MS' fontsize='14' underline='true'>Views</run>
              <run>Æ&#10;&#10;</run>
              <run fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Category Level View</run>
              <run fontname='Comic Sans MS' fontsize='10'>: Provides L1, L2 and L3 category level view of search and merch metrics, while comparing performance  between two timeframes</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>SKU  Level View</run>
              <run fontname='Comic Sans MS' fontsize='10'>: Provides SKU level view of search and merch metrics, while comparing performance between two timeframes</run>
              <run>Æ&#10;</run>
              <run fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Search Terms View</run>
              <run fontname='Comic Sans MS' fontsize='10'>: Provides view of top search terms while comparing performance between two timeframes</run>
              <run>Æ&#10;</run>
              <run fontname='Comic Sans MS' fontsize='10'>- </run>
              <run bold='true' fontcolor='#000000' fontname='Comic Sans MS' fontsize='10'>Metrics Evolution View</run>
              <run fontname='Comic Sans MS' fontsize='10'>: Provides daily view of search and merch metric evolution across a duration at a L1, L2 and L3 category level</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
