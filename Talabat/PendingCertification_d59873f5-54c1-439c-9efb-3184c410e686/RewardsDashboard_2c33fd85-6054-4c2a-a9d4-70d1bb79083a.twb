      <aliases enabled='yes' />
      <column caption='Acquisition Stage ' datatype='real' name='[Acquisition Stage (copy)_243616626346958871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Acquisition Stage (copy)_243616626346942486]&#10;&#10;when &apos;Sessions&apos; then [ct_session_unique]&#10;when &apos;Consideration&apos; then [is_consideration]&#10;when &apos;Redemption&apos; then [is_redeemed]&#10;when &apos;Utilization&apos; then [is_used]&#10;&#10;end' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_243616625584967684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Start Date (copy)_243616625584283650])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_243616625584283650]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Start Date (copy)_243616625584283650])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 2] and [date] &lt;= [Parameters].[Start Date (copy)_243616625584283650]&#10;then &apos;Selected Period&apos; &#10;&#10;else &apos;Remaining days&apos;&#10;&#10;end' />
      </column>
      <column caption='Consideration Rate %' datatype='real' default-format='p0%' name='[Calculation_243616625958920197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_consideration])/sum([ct_session_unique])' />
      </column>
      <column caption='100%' datatype='integer' name='[Calculation_243616625965854728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(1)' />
      </column>
      <column caption='Acquisition Stage' datatype='real' name='[Calculation_243616626334396434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;when &apos;Sessions&apos; then [ct_session_unique]&#10;when &apos;Consideration&apos; then [is_consideration]&#10;when &apos;Redemption&apos; then [is_redeemed]&#10;when &apos;Utilization&apos; then [is_used]&#10;&#10;end' />
      </column>
      <column caption='hide null' datatype='boolean' name='[Calculation_243616626335469587]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Conversion %' datatype='real' default-format='p0.0%' name='[Calculation_243616626336321557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Consideration Rate %&apos; then [Calculation_243616625958920197]&#10;when &apos;Redemption Rate %&apos; then [Consideration Rate % (copy)_243616625961996294]&#10;when &apos;Usage Rate %&apos; then [Redemption Rate % (copy)_243616625962205191]&#10;when &apos;Conversion Rate %&apos; then [Consideration Rate % (copy)_243616626017284105]&#10;end' />
      </column>
      <column caption='Breakdown Dimension' datatype='boolean' name='[Calculation_243616627401338905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] = &apos;Event Origin&apos;' />
      </column>
      <column caption='Last 15 days' datatype='boolean' name='[Calculation_243616627404169242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt;= DATEADD(&apos;day&apos;,-15,[Parameters].[Start Date (copy)_243616625584283650]) and date &lt;= [Parameters].[Start Date (copy)_243616625584283650]' />
      </column>
      <column caption='Redemption Rate %' datatype='real' default-format='p0%' name='[Consideration Rate % (copy)_243616625961996294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_redeemed])/&#10;sum([is_consideration])' />
      </column>
      <column caption='Conversion Rate %' datatype='real' default-format='p0.00%' name='[Consideration Rate % (copy)_243616626017284105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_used])/sum([ct_session_unique])' />
      </column>
      <column caption='Conversion Rate Remaining %' datatype='real' default-format='p0%' name='[Conversion Rate % (copy)_243616626017398794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Consideration Rate % (copy)_243616626017284105]' />
      </column>
      <column caption='Usage Rate %' datatype='real' default-format='p0%' name='[Redemption Rate % (copy)_243616625962205191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_used])/&#10;sum([is_redeemed])' />
      </column>
      <column caption='Redemption Rate % of Sessions' datatype='real' default-format='p0%' name='[Redemption Rate % (copy)_243616626272387088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_redeemed])/&#10;sum([ct_session_unique])' />
      </column>
      <column caption='Usage Rate % of Sessions' datatype='real' default-format='p0%' name='[Usage Rate % (copy)_243616626272718865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_used])/&#10;sum([ct_session_unique])' />
      </column>
