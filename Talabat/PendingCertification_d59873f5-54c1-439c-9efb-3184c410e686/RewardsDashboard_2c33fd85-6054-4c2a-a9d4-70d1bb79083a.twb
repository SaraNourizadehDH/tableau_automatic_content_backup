              <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Start Date (copy)_243616625584283650])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_243616625584283650]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Start Date (copy)_243616625584283650])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 2] and [date] &lt;= [Parameters].[Start Date (copy)_243616625584283650]&#10;then &apos;Selected Period&apos; &#10;&#10;else &apos;Remaining days&apos;&#10;&#10;end' />
