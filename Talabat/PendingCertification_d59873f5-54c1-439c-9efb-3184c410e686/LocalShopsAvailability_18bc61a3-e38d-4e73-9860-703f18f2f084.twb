            </column>
            <column caption='Availability % Trend' datatype='real' default-format='p0.00%' name='[Calculation_3863736673613410346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Country, Chain, Vendor&apos; THEN&#10;&#10;if MAX([Calculation_3863736673621725228]) = 1 THEN AVG([vendor_availability])&#10;END&#10;&#10;&#10;ELSE AVG([Availability % (copy)_3863736673572179987])&#10;END' />
            </column>
            <column caption='Availability KPI' datatype='real' default-format='p0.00%' name='[Calculation_3863736673614999595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Country, Chain, Vendor&apos;&#10;AND [Parameters].[Parameter 7] = &apos;Availability %&apos;&#10;THEN (&#10;    IF &#10;        COUNTD([vendor_id])= COUNTD([vendor_id]) AND&#10;        COUNTD([chain_id])= COUNTD([chain_id]) AND&#10;        COUNTD([country_code])= COUNTD([country_code])&#10;    THEN&#10;        AVG({ FIXED [L1 Category (copy)_3863736673570349071]: AVG([country_availability]) })&#10;    ELSE&#10;        0&#10;    END)&#10;ELSE 0 &#10;END' />
            </column>
