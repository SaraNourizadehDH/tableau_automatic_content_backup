        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1h82gcc1gd2k6h10nkkot0yj0y9e' name='Custom SQL Query' type='text'>SELECT country_code,delivery_location_id,count(distinct order_id)orders &#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o &#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` v on o.vendor_id=v.vendor_id&#13;
--left join `tlb-data-dev.data_platform.dim_location` li on o.location_id=li.location_id&#13;
--Where order_date between &quot;2024-01-01&quot; and &apos;2024-01-09&apos;&#13;
where 1=1&#13;
--order_date &gt;&gt;= timestamp_sub(current_date(), interval 16 day)&#13;
and DATE_TRUNC(order_date ,month)=DATE_TRUNC(current_date,month) &#13;
and is_successful is true&#13;
and country_code=&apos;IQ&apos;&#13;
group by 1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1h82gcc1gd2k6h10nkkot0yj0y9e' name='Custom SQL Query' type='text'>SELECT country_code,delivery_location_id,count(distinct order_id)orders &#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o &#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` v on o.vendor_id=v.vendor_id&#13;
--left join `tlb-data-dev.data_platform.dim_location` li on o.location_id=li.location_id&#13;
--Where order_date between &quot;2024-01-01&quot; and &apos;2024-01-09&apos;&#13;
where 1=1&#13;
--order_date &gt;&gt;= timestamp_sub(current_date(), interval 16 day)&#13;
and DATE_TRUNC(order_date ,month)=DATE_TRUNC(current_date,month) &#13;
and is_successful is true&#13;
and country_code=&apos;IQ&apos;&#13;
group by 1,2</relation>
