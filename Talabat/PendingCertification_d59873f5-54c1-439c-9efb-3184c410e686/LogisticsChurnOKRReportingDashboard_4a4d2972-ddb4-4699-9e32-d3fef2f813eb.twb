),

-- rider next month activity check
riders_count AS (
  SELECT
    a1.country_code,
    a1.city_name,
    a1.active_month,
    COUNT(DISTINCT a1.rider_id) AS this_month,
    COUNT(DISTINCT a2.rider_id) AS next_month
  FROM activity a1
  LEFT JOIN activity a2
    ON a1.rider_id = a2.rider_id
    AND a1.country_code = a2.country_code
    AND IFNULL(a1.city_name, 'ALL') = IFNULL(a2.city_name, 'ALL')
    AND DATE_ADD(a1.active_month, INTERVAL 1 MONTH) = a2.active_month
  WHERE a1.active_month << DATE_TRUNC(current_date, MONTH)
  GROUP BY a1.country_code, a1.city_name, a1.active_month
),

-- churn with active contract
riders_churn_count AS (
  WITH next_months AS (
    SELECT
      a1.country_code,
      a1.city_name,
      a1.active_month,
      a1.rider_id AS this_month_rider_id,
      a2.rider_id AS next_month_rider_id
    FROM activity a1
    LEFT JOIN activity a2
      ON a1.rider_id = a2.rider_id
      AND a1.country_code = a2.country_code
      AND IFNULL(a1.city_name, 'ALL') = IFNULL(a2.city_name, 'ALL')
