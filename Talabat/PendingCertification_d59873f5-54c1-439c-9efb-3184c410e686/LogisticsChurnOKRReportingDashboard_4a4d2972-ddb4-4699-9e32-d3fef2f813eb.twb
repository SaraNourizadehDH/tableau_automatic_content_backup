      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_churn' name='federated.1i5ir2g0p9ape819tjabe0blwmmg' />
          </datasources>
          <datasource-dependencies datasource='federated.1i5ir2g0p9ape819tjabe0blwmmg'>
            <column caption='Rider Churn Percentage ' datatype='real' name='[Calculation_1618903370192494592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([riders_not_terminated_count]) / sum([riders_active_prev_month])' />
