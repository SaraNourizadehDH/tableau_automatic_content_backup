      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A7E17519BB14452DBC6507B2FE319D8D'>
            <properties context=''>
              <relation connection='bigquery.06z5hlh0sblmpg1fpa31x077zj8j' name='Custom SQL Query' type='text'><![CDATA[--riders who completed at least one logistics delivery
WITH base_activity AS (
  SELECT
    country_code,
    city_name,
    rider_id,
    DATE_TRUNC(created_date, MONTH) AS active_month
  FROM `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance`
  WHERE total_completed_logistics_deliveries >> 0
    AND total_completed_logistics_deliveries >> 0
    AND created_date >>= '2024-12-01'
),

--country agg from base
country_level AS (
  SELECT
    country_code,
    CAST(NULL AS STRING) AS city_name,
    rider_id,
    active_month
  FROM base_activity
),

--dubai riders from the base actiity
dubai_only AS (
  SELECT
    country_code,
    'Dubai' AS city_name,
    rider_id,
    active_month
  FROM base_activity
  WHERE LOWER(city_name) = 'dubai'
),

--union
activity AS (
  SELECT * FROM country_level
  UNION ALL
  SELECT * FROM dubai_only
),

-- rider next month activity check
riders_count AS (
  SELECT
    a1.country_code,
    a1.city_name,
    a1.active_month,
    COUNT(DISTINCT a1.rider_id) AS this_month,
    COUNT(DISTINCT a2.rider_id) AS next_month
  FROM activity a1
  LEFT JOIN activity a2
    ON a1.rider_id = a2.rider_id
    AND a1.country_code = a2.country_code
    AND IFNULL(a1.city_name, 'ALL') = IFNULL(a2.city_name, 'ALL')
    AND DATE_ADD(a1.active_month, INTERVAL 1 MONTH) = a2.active_month
  WHERE a1.active_month << DATE_TRUNC(current_date, MONTH)
  GROUP BY a1.country_code, a1.city_name, a1.active_month
),

-- churn with active contract
riders_churn_count AS (
  WITH next_months AS (
    SELECT
      a1.country_code,
      a1.city_name,
      a1.active_month,
      a1.rider_id AS this_month_rider_id,
      a2.rider_id AS next_month_rider_id
    FROM activity a1
    LEFT JOIN activity a2
      ON a1.rider_id = a2.rider_id
      AND a1.country_code = a2.country_code
      AND IFNULL(a1.city_name, 'ALL') = IFNULL(a2.city_name, 'ALL')
      AND DATE_ADD(a1.active_month, INTERVAL 1 MONTH) = a2.active_month
    WHERE a1.active_month << DATE_TRUNC(current_date, MONTH)
  )
  SELECT
    nm.country_code,
    nm.city_name,
    DATE_ADD(nm.active_month, INTERVAL 1 MONTH) AS active_month,
    COUNT(DISTINCT nm.this_month_rider_id) AS riders_not_terminated_count
  FROM next_months nm
  WHERE nm.next_month_rider_id IS NULL
    AND (
      nm.country_code = 'ae'
      OR LOWER(nm.city_name) = 'dubai'
      OR EXISTS (
        SELECT 1
        FROM `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` c
        WHERE c.rider_id = nm.this_month_rider_id
          AND DATE_ADD(nm.active_month, INTERVAL 1 MONTH)
              BETWEEN DATE_TRUNC(DATE(c.start_at), MONTH)
              AND DATE_TRUNC(DATE(c.end_at), MONTH)
      )
    )
  GROUP BY 1, 2, 3
),

--final churn number
final_output AS (
  SELECT
    rc.country_code,
    rc.city_name,
    rc.active_month,
    rc.this_month,
    rc.next_month,
    rcc.riders_not_terminated_count,
    LAG(rc.this_month) OVER (
      PARTITION BY rc.country_code, rc.city_name
      ORDER BY rc.active_month
    ) AS riders_active_prev_month,
    ROUND(
      SAFE_DIVIDE(rcc.riders_not_terminated_count, 
                  LAG(rc.this_month) OVER (
                    PARTITION BY rc.country_code, rc.city_name
                    ORDER BY rc.active_month
                  )), 
      2
    ) AS riders_churn_percentage
  FROM riders_count rc
  LEFT JOIN riders_churn_count rcc
    ON rc.country_code = rcc.country_code
    AND IFNULL(rc.city_name, 'ALL') = IFNULL(rcc.city_name, 'ALL')
    AND rc.active_month = rcc.active_month
)

--combine dubai & country
SELECT
  CASE
    WHEN city_name = 'Dubai' THEN 'Dubai'
    ELSE country_code
  END AS cluster,
  country_code,
  active_month,
  this_month,
  next_month,
  riders_not_terminated_count,
  riders_active_prev_month,
  riders_churn_percentage
FROM final_output
WHERE active_month >> '2024-12-01'
ORDER BY cluster, active_month]]></relation>
            </properties>
