        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0q3to2610oo0rv1ac9f6k0iijg4f' name='Custom SQL Query' type='text'><![CDATA[-- riders who completed at least one logistics delivery
WITH base_activity AS (
  SELECT
    country_code,
    city_name,
    rider_id,
    DATE_TRUNC(created_date, MONTH) AS active_month
  FROM `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance`
  WHERE total_completed_logistics_deliveries >> 0
    AND created_date >>= '2024-12-01'
),

-- country-level view
country_level AS (
  SELECT
    country_code,
    CAST(NULL AS STRING) AS city_name,
    rider_id,
    active_month
  FROM base_activity
),

-- dubai-only view
dubai_only AS (
  SELECT
    country_code,
    'Dubai' AS city_name,
    rider_id,
    active_month
  FROM base_activity
  WHERE LOWER(city_name) = 'dubai'
),

-- combined country + dubai
activity AS (
  SELECT * FROM country_level
  UNION ALL
  SELECT * FROM dubai_only
),

-- rider-level: riders not active next month but still have contract
riders_not_terminated AS (
  WITH next_months AS (
    SELECT
      a1.country_code,
      a1.city_name,
      a1.active_month,
      a1.rider_id AS this_month_rider_id,
      a2.rider_id AS next_month_rider_id
    FROM activity a1
    LEFT JOIN activity a2
      ON a1.rider_id = a2.rider_id
      AND a1.country_code = a2.country_code
      AND IFNULL(a1.city_name, 'ALL') = IFNULL(a2.city_name, 'ALL')
      AND DATE_ADD(a1.active_month, INTERVAL 1 MONTH) = a2.active_month
    WHERE a1.active_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
  )
  SELECT
    nm.country_code,
    nm.city_name,
    DATE_ADD(nm.active_month, INTERVAL 1 MONTH) AS active_month,
    nm.this_month_rider_id AS rider_id_not_terminated
  FROM next_months nm
  WHERE nm.next_month_rider_id IS NULL
    AND (
      nm.country_code = 'ae'
      OR LOWER(nm.city_name) = 'dubai'
      OR EXISTS (
        SELECT 1
        FROM `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` c
        WHERE c.rider_id = nm.this_month_rider_id
          AND DATE_ADD(nm.active_month, INTERVAL 1 MONTH)
              BETWEEN DATE_TRUNC(DATE(c.start_at), MONTH)
              AND DATE_TRUNC(DATE(c.end_at), MONTH)
      )
    )
),

final_output as (

-- final output: list of riders
SELECT DISTINCT
  CASE
    WHEN city_name = 'Dubai' THEN 'Dubai'
    ELSE rr.country_code
  END AS cluster,
  rr.country_code,
  rr.city_name,
  rr.active_month,
  rr.rider_id_not_terminated,
  dlr.rider_name,
  dlr.phone_number,
  dlr.last_contract_name,
  date(dlr.last_contract_start_at) as last_contract_start_at ,
  date(dlr.last_contract_end_at) as last_contract_end_at ,
  dlr.vehicle,
  dlr.is_active,
  max(ld.created_date) as last_order_date,
FROM riders_not_terminated rr
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr on rr.rider_id_not_terminated = dlr.rider_id and rr.country_code = (dlr.country_code)
LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_delivery` ld on rr.rider_id_not_terminated = ld.rider_id and rr.country_code = ld.country_code 
WHERE active_month >> '2024-12-01'
GROUP BY ALL 
ORDER BY cluster, active_month, rider_id_not_terminated
)

select * from final_output]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0q3to2610oo0rv1ac9f6k0iijg4f' name='Custom SQL Query' type='text'><![CDATA[-- riders who completed at least one logistics delivery
