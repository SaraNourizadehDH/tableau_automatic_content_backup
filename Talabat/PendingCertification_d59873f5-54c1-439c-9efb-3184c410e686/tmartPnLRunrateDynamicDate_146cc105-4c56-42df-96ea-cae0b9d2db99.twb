              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526968019120276]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='Adjusted EBITDA wo Reg. Cost' datatype='real' name='[Calculation_1558526968025882773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967983968376]&#13;&#10;+SUM([carc]&#13;&#10;+[cancellation_carc]&#13;&#10;+[personnel]&#13;&#10;+[sg_a]&#13;&#10;)' />
            </column>
            <column caption='Adjusted EBITDA Inc. Reg.' datatype='real' name='[Calculation_1558526968026644631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526968025882773]&#13;&#10;+&#13;&#10;SUM([regional_personnel_expenses]&#13;&#10;+&#13;&#10;[regional_non_personnel_overhead]&#13;&#10;)' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526968026939550]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='COGS Back Margin' datatype='real' name='[Calculation_1558526968574992562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GPV (copy)_1558526965741875261]*([back_margin])' />
            </column>
            <column caption='Marketing Incentives Margin' datatype='real' default-format='p0.00%' name='[Commercial Margin (copy)_1558526967655817313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967655960674] / [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Corrected Shrink Margin' datatype='real' default-format='p0.00%' name='[Corrected Front Margin (copy)_573927501486108682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Shrinkage (copy)_573927501509324812]) / SUM([GMV (copy)_1558526965740851259])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([Shrinkage (copy)_573927501509324812]) / SUM([GMV (copy)_1558526965740851259]))-SUM([shrink_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([shrink_inc_transfer_error]))&#13;&#10;END' />
            </column>
            <column caption='Corrected Shrink Value' datatype='real' name='[Corrected Shrink Margin (copy)_573927501486780427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV (copy)_1558526965741875261])*([Corrected Front Margin (copy)_573927501486108682])' />
            </column>
            <column caption='Service Fee / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee / Order (copy)_1558526967828631659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro Delivery Fee (copy)_1558526967828582506]) / SUM([successful_orders_count])' />
            </column>
            <column caption='Delivery Fee / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee / Order - Non Pro (copy)_1558526967828086889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro Delivery Fee (copy)_1558526967660453990] + [tpro GPV (copy)_1558526965743292495]) / SUM([successful_orders_count])' />
            </column>
            <column caption='Delivery Fee / Order - Non Pro' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee / Order - tPro (copy)_1558526967660933224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro Delivery Fee (copy)_1558526967660453990]) / [Calculation_1558526965742891083]' />
            </column>
            <column caption='Commercial Margin' datatype='real' default-format='p0.00%' name='[Front &amp; Back Margin (copy)_1558526966040817756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([front_margin] )+SUM([back_margin])+SUM([nmr_ooi_margin])+[Corrected Front Margin (copy)_573927501486108682]' />
            </column>
            <column caption='Front Margin' datatype='real' default-format='p0.00%' name='[Front Margin (copy)_573927501395537922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='GPV' datatype='real' name='[GMV (copy)_1558526965740851259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gpv_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Platform GMV' datatype='real' name='[GMV (copy)_1558526965741187132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [platform_gmv]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='GPV Exc. VAT (Sales Revenue)' datatype='real' name='[GPV (copy)_1558526965741875261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gpv_exc_vat_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Gross Profit wo NRV' datatype='real' name='[Gross Profit (copy)_1558526967985201273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967981076599]&#13;&#10;+SUM([cancellation_rental_and_dep])' />
            </column>
            <column caption='Gross Profit wo NRV / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Gross Profit wo NRV (copy)_1558526967985291386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gross Profit (copy)_1558526967985201273]&#13;&#10;/&#13;&#10;SUM([successful_orders_count])' />
            </column>
            <column caption='Packaging Cost Calc' datatype='real' name='[NMR &amp; OOI Value Calc (copy)_573927501399937028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[packaging_cost_margin] * [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Marketing Incentives Calc' datatype='real' name='[NMR &amp; OOI Value Calc (copy)_573927501420171269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[marketing_incentives_margin_be] * [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Non Pro GPV' datatype='real' default-format='n#,##0;-#,##0' name='[Non Pro APV (copy)_1558526965743722577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_1558526965740851259])-SUM([Calculation_1558526965743185998])' />
            </column>
            <column caption='tpro APV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Non Pro APV (copy)_1558526965744517205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526965743185998]) / SUM([tpro_successful_orders_count])' />
            </column>
            <column caption='tPro Orders %' datatype='real' default-format='p0.0%' name='[Non Pro Orders % (copy)_1558526965744361556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_successful_orders_count]) / SUM([successful_orders_count])' />
