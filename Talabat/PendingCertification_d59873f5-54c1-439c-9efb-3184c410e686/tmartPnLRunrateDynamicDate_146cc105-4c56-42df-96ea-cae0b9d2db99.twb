    <datasource caption='Custom SQL Query+ (Multiple Connections)' inline='true' name='federated.0cihiff1fmumd7129gb3v04nzzwm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1uevnmf0st03zf1fqdzy90ogld7d'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='eyad.elkhateeb@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='tmart PnL Automation' name='cloudfile:googledrive-excel-direct.094jh6r0of3g30100lzv805ppqqj'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='12miJOv0h45Q7EPgNytPcMylSD9Zd22jdlWHNvAfgnac' cloudFileMetadata_-_folder='root' cloudFileName='tmart PnL Automation.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/12miJOv0h45Q7EPgNytPcMylSD9Zd22jdlWHNvAfgnac/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='tmart PnL Automation.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='eyad.elkhateeb@talabat.com' validate='no' workgroup-auth-mode='prompt' />
