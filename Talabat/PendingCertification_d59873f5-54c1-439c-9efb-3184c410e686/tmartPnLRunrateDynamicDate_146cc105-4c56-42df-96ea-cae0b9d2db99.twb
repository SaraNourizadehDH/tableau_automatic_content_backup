            <column caption='tPro Orders %' datatype='real' default-format='p0.0%' name='[Non Pro Orders % (copy)_1558526965744361556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_successful_orders_count]) / SUM([successful_orders_count])' />
