    <worksheet name='Sheet 8'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0cihiff1fmumd7129gb3v04nzzwm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cihiff1fmumd7129gb3v04nzzwm'>
            <column caption='Corrected COGS Front Margin' datatype='real' name='[COGS (copy)_573927501394063361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([GPV (copy)_1558526965741875261])*(1-[Calculation_1558526965749633114])' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_1558526965749555289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [cogs_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Corrected Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965749633114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])-SUM([front_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([margin_error]))&#13;&#10;END' />
            </column>
