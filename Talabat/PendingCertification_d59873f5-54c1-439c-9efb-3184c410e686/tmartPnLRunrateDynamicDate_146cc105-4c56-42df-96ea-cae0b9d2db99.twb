            <column caption='Marketing Incentives Calc' datatype='real' name='[NMR &amp; OOI Value Calc (copy)_573927501420171269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[marketing_incentives_margin_be] * [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Non Pro GPV' datatype='real' default-format='n#,##0;-#,##0' name='[Non Pro APV (copy)_1558526965743722577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_1558526965740851259])-SUM([Calculation_1558526965743185998])' />
            </column>
            <column caption='tpro APV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Non Pro APV (copy)_1558526965744517205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526965743185998]) / SUM([tpro_successful_orders_count])' />
