      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#cfff00'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0cihiff1fmumd7129gb3v04nzzwm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cihiff1fmumd7129gb3v04nzzwm'>
            <column caption='Sales Rev. / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_1558526965742051390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV (copy)_1558526965741875261])/SUM([successful_orders_count])' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[APV (copy)_1558526965740318777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526965740711994])/SUM([successful_orders_count])' />
            </column>
            <column caption='Non Pro APV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[APV (copy)_1558526965743415376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GMV (copy)_1558526965740851259])-SUM([Calculation_1558526965743185998])) / (SUM([successful_orders_count])-SUM([tpro_successful_orders_count]))' />
            </column>
            <column caption='Adjusted EBITDA wo Reg. Cost &amp; NRV' datatype='real' name='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968026415254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967983968376]&#13;&#10;+SUM([carc]&#13;&#10;+[cancellation_carc]&#13;&#10;+[personnel]&#13;&#10;+[sg_a]&#13;&#10;)&#13;&#10;-SUM([nrv])' />
            </column>
            <column caption='Adjusted EBITDA Inc. Reg. Cost &amp; wo NRV' datatype='real' name='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968029339807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968026415254]&#13;&#10;+&#13;&#10;SUM([regional_personnel_expenses]&#13;&#10;+&#13;&#10;[regional_non_personnel_overhead]&#13;&#10;)' />
            </column>
            <column caption='Avg. Orders / Day' datatype='real' name='[Avg. Orders / Day / Store (copy)_1558526965737365557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_count])/MAX([days_count])' />
            </column>
            <column caption='Orders % of Platform' datatype='real' default-format='p0.0%' name='[Avg. Orders / Day / Store (copy)_1558526965737484342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_count])/SUM([platform_orders_count])' />
            </column>
            <column caption='Corrected COGS Front Margin' datatype='real' name='[COGS (copy)_573927501394063361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([GPV (copy)_1558526965741875261])*(1-[Calculation_1558526965749633114])' />
            </column>
            <column caption='Avg. Orders / Day / Store' datatype='real' name='[Calculation_1558526965730123778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders_count])/MAX([vendors_count]))/MAX([days_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1558526965740711994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gmv_amount_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526965742596168]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526965742755914]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='Non Pro Orders' datatype='real' name='[Calculation_1558526965742891083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_count])-SUM([tpro_successful_orders_count])' />
            </column>
            <column caption='tpro GPV' datatype='real' name='[Calculation_1558526965743185998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [tpro_gpv_lc]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526965743857747]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526965744848984]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_1558526965749555289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [cogs_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Corrected Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965749633114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])-SUM([front_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([margin_error]))&#13;&#10;END' />
            </column>
            <column caption='Front &amp; Back Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965751214171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Front Margin (copy)_573927501395537922]+SUM([back_margin])' />
            </column>
            <column caption='Shrink Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526967654269024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Corrected Shrink Margin (copy)_573927501486780427] / SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='Marketing Incentives' datatype='real' name='[Calculation_1558526967655960674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN&#13;&#10;[NMR &amp; OOI Value Calc (copy)_573927501420171269]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0 &#13;&#10;END' />
            </column>
            <column caption='Marketing Incentives / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1558526967659683939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526967655960674]) / SUM([successful_orders_count])' />
            </column>
            <column caption='Product Margin %' datatype='real' default-format='p0.00%' name='[Calculation_1558526967905562737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261]&#13;&#10;+[marketing_incentives_be]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967660453990]&#13;&#10;+[tpro GPV (copy)_1558526965743292495]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967828582506]&#13;&#10;+[nmr_ooi_value]&#13;&#10;+[cogs_back_margin]&#13;&#10;//+[Shrinkage]&#13;&#10;+[packaging_cost]&#13;&#10;)&#13;&#10;+[COGS (copy)_573927501394063361]&#13;&#10;+ [Corrected Shrink Margin (copy)_573927501486780427]&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='Delivery CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1558526967909052530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ic_delivery_cost]) &#13;&#10;/ &#13;&#10;SUM([successful_orders_count])' />
            </column>
            <column caption='IC Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_1558526967909515379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_amount_lc])&#13;&#10;/&#13;&#10;SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526967977914486]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END ' />
            </column>
            <column caption='Contribution Margin' datatype='real' name='[Calculation_1558526967981076599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Product Margin (copy)_1558526967987085435]&#13;&#10;+&#13;&#10;SUM([ic_delivery_cost]&#13;&#10;+-[commission_amount_lc]&#13;&#10;+shoppers&#13;&#10;+[store_managers]&#13;&#10;+[store_oh_utilites]&#13;&#10;+[bad_debt_allowance]&#13;&#10;+[other_cost]&#13;&#10;+[distribution_center_cost]&#13;&#10;+[renta_and_dep])' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Calculation_1558526967983968376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967981076599]&#13;&#10;+SUM([cancellation_rental_and_dep])&#13;&#10;+SUM([nrv])' />
            </column>
            <column caption='Gross Profit wo NRV % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_1558526968015151234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gross Profit (copy)_1558526967985201273] / SUM([Calculation_1558526965740711994])' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526968015331460]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
