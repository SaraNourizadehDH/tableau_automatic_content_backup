            </column>
            <column caption='COGS' datatype='real' name='[Calculation_1558526965749555289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [cogs_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Corrected Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965749633114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])-SUM([front_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([margin_error]))&#13;&#10;END' />
            </column>
            <column caption='Front &amp; Back Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965751214171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Front Margin (copy)_573927501395537922]+SUM([back_margin])' />
            </column>
            <column caption='Shrink Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526967654269024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Corrected Shrink Margin (copy)_573927501486780427] / SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='Marketing Incentives' datatype='real' name='[Calculation_1558526967655960674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN&#13;&#10;[NMR &amp; OOI Value Calc (copy)_573927501420171269]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0 &#13;&#10;END' />
            </column>
            <column caption='Marketing Incentives / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1558526967659683939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526967655960674]) / SUM([successful_orders_count])' />
            </column>
            <column caption='Product Margin %' datatype='real' default-format='p0.00%' name='[Calculation_1558526967905562737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261]&#13;&#10;+[marketing_incentives_be]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967660453990]&#13;&#10;+[tpro GPV (copy)_1558526965743292495]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967828582506]&#13;&#10;+[nmr_ooi_value]&#13;&#10;+[cogs_back_margin]&#13;&#10;//+[Shrinkage]&#13;&#10;+[packaging_cost]&#13;&#10;)&#13;&#10;+[COGS (copy)_573927501394063361]&#13;&#10;+ [Corrected Shrink Margin (copy)_573927501486780427]&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='Delivery CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1558526967909052530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ic_delivery_cost]) &#13;&#10;/ &#13;&#10;SUM([successful_orders_count])' />
            </column>
            <column caption='IC Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_1558526967909515379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_amount_lc])&#13;&#10;/&#13;&#10;SUM([GPV (copy)_1558526965741875261])' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526967977914486]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END ' />
            </column>
            <column caption='Contribution Margin' datatype='real' name='[Calculation_1558526967981076599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Product Margin (copy)_1558526967987085435]&#13;&#10;+&#13;&#10;SUM([ic_delivery_cost]&#13;&#10;+-[commission_amount_lc]&#13;&#10;+shoppers&#13;&#10;+[store_managers]&#13;&#10;+[store_oh_utilites]&#13;&#10;+[bad_debt_allowance]&#13;&#10;+[other_cost]&#13;&#10;+[distribution_center_cost]&#13;&#10;+[renta_and_dep])' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Calculation_1558526967983968376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967981076599]&#13;&#10;+SUM([cancellation_rental_and_dep])&#13;&#10;+SUM([nrv])' />
