            <column caption='GMV % to Platfrom GMV' datatype='real' default-format='p0.0%' name='[Orders % of Platform (copy)_1558526965737701431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526965740711994])/SUM([GMV (copy)_1558526965741187132])' />
