            <column-instance column='[GPV (copy)_1558526965741875261]' derivation='Sum' name='[sum:GPV (copy)_1558526965741875261:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cogs_back_margin]' derivation='Sum' name='[sum:cogs_back_margin:qk]' pivot='key' type='quantitative' />
