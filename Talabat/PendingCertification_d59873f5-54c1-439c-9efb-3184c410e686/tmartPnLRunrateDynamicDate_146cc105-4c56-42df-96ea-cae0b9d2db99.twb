          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cihiff1fmumd7129gb3v04nzzwm'>
            <column caption='Sales Rev. / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_1558526965742051390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV (copy)_1558526965741875261])/SUM([successful_orders_count])' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[APV (copy)_1558526965740318777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1558526965740711994])/SUM([successful_orders_count])' />
            </column>
            <column caption='Non Pro APV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[APV (copy)_1558526965743415376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GMV (copy)_1558526965740851259])-SUM([Calculation_1558526965743185998])) / (SUM([successful_orders_count])-SUM([tpro_successful_orders_count]))' />
            </column>
            <column caption='Adjusted EBITDA wo Reg. Cost &amp; NRV' datatype='real' name='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968026415254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1558526967983968376]&#13;&#10;+SUM([carc]&#13;&#10;+[cancellation_carc]&#13;&#10;+[personnel]&#13;&#10;+[sg_a]&#13;&#10;)&#13;&#10;-SUM([nrv])' />
            </column>
            <column caption='Adjusted EBITDA Inc. Reg. Cost &amp; wo NRV' datatype='real' name='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968029339807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Adjusted EBITDA wo Reg. Cost (copy)_1558526968026415254]&#13;&#10;+&#13;&#10;SUM([regional_personnel_expenses]&#13;&#10;+&#13;&#10;[regional_non_personnel_overhead]&#13;&#10;)' />
            </column>
            <column caption='Avg. Orders / Day' datatype='real' name='[Avg. Orders / Day / Store (copy)_1558526965737365557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_count])/MAX([days_count])' />
            </column>
            <column caption='Orders % of Platform' datatype='real' default-format='p0.0%' name='[Avg. Orders / Day / Store (copy)_1558526965737484342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_count])/SUM([platform_orders_count])' />
            </column>
            <column caption='Corrected COGS Front Margin' datatype='real' name='[COGS (copy)_573927501394063361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([GPV (copy)_1558526965741875261])*(1-[Calculation_1558526965749633114])' />
            </column>
            <column caption='Avg. Orders / Day / Store' datatype='real' name='[Calculation_1558526965730123778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders_count])/MAX([vendors_count]))/MAX([days_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1558526965740711994]' role='measure' type='quantitative'>
