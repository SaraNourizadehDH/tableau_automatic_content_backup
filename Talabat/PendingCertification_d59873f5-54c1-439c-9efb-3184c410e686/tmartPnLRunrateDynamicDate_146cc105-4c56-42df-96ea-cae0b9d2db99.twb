    <worksheet name='product margin'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0cihiff1fmumd7129gb3v04nzzwm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cihiff1fmumd7129gb3v04nzzwm'>
            <column caption='Corrected COGS Front Margin' datatype='real' name='[COGS (copy)_573927501394063361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([GPV (copy)_1558526965741875261])*(1-[Calculation_1558526965749633114])' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_1558526965749555289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [cogs_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Corrected Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_1558526965749633114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([GPV (copy)_1558526965741875261])-SUM([Calculation_1558526965749555289])) / SUM([GPV (copy)_1558526965741875261])-SUM([front_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([margin_error]))&#13;&#10;END' />
            </column>
            <column caption='Marketing Incentives' datatype='real' name='[Calculation_1558526967655960674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN&#13;&#10;[NMR &amp; OOI Value Calc (copy)_573927501420171269]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0 &#13;&#10;END' />
            </column>
            <column caption='COGS Back Margin' datatype='real' name='[Calculation_1558526968574992562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GPV (copy)_1558526965741875261]*([back_margin])' />
            </column>
            <column caption='Corrected Shrink Margin' datatype='real' default-format='p0.00%' name='[Corrected Front Margin (copy)_573927501486108682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Shrinkage (copy)_573927501509324812]) / SUM([GMV (copy)_1558526965740851259])&#13;&#10;-&#13;&#10;CASE ATTR([Source])&#13;&#10;WHEN &apos;ACT&apos;&#13;&#10;THEN (SUM([Shrinkage (copy)_573927501509324812]) / SUM([GMV (copy)_1558526965740851259]))-SUM([shrink_margin])&#13;&#10;ELSE&#13;&#10;ZN(SUM([shrink_inc_transfer_error]))&#13;&#10;END' />
            </column>
            <column caption='Corrected Shrink Value' datatype='real' name='[Corrected Shrink Margin (copy)_573927501486780427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV (copy)_1558526965741875261])*([Corrected Front Margin (copy)_573927501486108682])' />
            </column>
            <column caption='GPV' datatype='real' name='[GMV (copy)_1558526965740851259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gpv_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='GPV Exc. VAT (Sales Revenue)' datatype='real' name='[GPV (copy)_1558526965741875261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gpv_exc_vat_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0&#13;&#10;END' />
            </column>
            <column caption='Packaging Cost Calc' datatype='real' name='[NMR &amp; OOI Value Calc (copy)_573927501399937028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[packaging_cost_margin] * [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Marketing Incentives Calc' datatype='real' name='[NMR &amp; OOI Value Calc (copy)_573927501420171269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[marketing_incentives_margin_be] * [GPV (copy)_1558526965741875261]' />
            </column>
            <column caption='Product Margin' datatype='real' name='[Product Margin (copy)_1558526967987085435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV (copy)_1558526965741875261]&#13;&#10;+[Calculation_1558526967655960674]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967660453990]&#13;&#10;+[tpro GPV (copy)_1558526965743292495]&#13;&#10;+[tpro Delivery Fee (copy)_1558526967828582506]&#13;&#10;+[nmr_ooi_value (copy)_573927501398618115]&#13;&#10;+[Calculation_1558526968574992562]&#13;&#10;//+[Shrinkage]&#13;&#10;+[NMR &amp; OOI Value Calc (copy)_573927501399937028]&#13;&#10;)&#13;&#10;+[COGS (copy)_573927501394063361]&#13;&#10;+[Corrected Shrink Margin (copy)_573927501486780427]' />
            </column>
            <column caption='Shrinkage (Product + Transfer)' datatype='real' name='[Shrinkage (copy)_573927501509324812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN&#13;&#10;[shrink_value_lc]+ZN([transfer_shrink_value_lc])&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN 0 &#13;&#10;END' />
            </column>
            <column datatype='string' name='[Source]' role='dimension' type='nominal' />
            <column datatype='real' default-format='p0.00%' name='[back_margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[cogs_back_margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[cogs_front_margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[cogs_lc]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[front_margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[gpv_exc_vat_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[gpv_lc]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[margin_error]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[marketing_incentives_margin_be]' role='measure' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column datatype='real' default-format='p0.00%' name='[nmr_ooi_margin]' role='measure' type='quantitative' />
            <column caption='NMR &amp; OOI Value Calc' datatype='real' name='[nmr_ooi_value (copy)_573927501398618115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nmr_ooi_margin] * [GPV (copy)_1558526965741875261]' />
