            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526968016752781]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
            </column>
            <column caption='IF 0=0 THEN NULL ELSE 0 END' datatype='integer' name='[Calculation_1558526968018526351]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='IF 0=0 THEN NULL ELSE 0 END' />
