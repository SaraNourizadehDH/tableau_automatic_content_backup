      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Month Source' id='Month Source_8B8D3ED3FBE048FEB5FA2CDC8C3471C2'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.094jh6r0of3g30100lzv805ppqqj' name='Month Source' table='[&apos;Month Source$&apos;]' type='table'>
                <columns gridOrigin='A1:B27:no:A1:B27:0' header='yes' outcome='2'>
                  <column datatype='string' name='Month' ordinal='0' />
                  <column datatype='string' name='Source' ordinal='1' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Month Source_8B8D3ED3FBE048FEB5FA2CDC8C3471C2' table='[Extract].[Month Source_8B8D3ED3FBE048FEB5FA2CDC8C3471C2]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_6DDF749400114872903E1F82E6CA4BF4'>
            <properties context=''>
              <relation connection='bigquery.1uevnmf0st03zf1fqdzy90ogld7d' name='Custom SQL Query' type='text'><![CDATA[WITH dates AS(
SELECT
country_code,
date as date,
CASE WHEN (FORMAT_DATE('%A', date) in ('Friday', 'Saturday') AND country_code <<>> "AE") OR (FORMAT_DATE('%A', date) in ('Sunday', 'Saturday') AND country_code = "AE") THEN 1 ELSE 0 END is_weekend,
FROM `tlb-data-prod.data_platform.dim_date` d, `tlb-data-prod.data_platform.dim_country_info` s
WHERE d.date BETWEEN <[Parameters].[Parameter 2]> AND DATE_ADD(DATE_TRUNC(<[Parameters].[Parameter 3]>-1,month), INTERVAL 2 month)-1
AND country_code not in ('LB','SA')
),
vouchers AS(
SELECT
entity_id AS country_code,
date,
SUM(amount_lc) AS marketing_incentives
FROM `tlb-data-prod.data_platform.agg_marketing_finance_daily`
WHERE
DATE BETWEEN '2025-05-01' AND <[Parameters].[Parameter 3]>
AND vertical = 'tmart - tmart'
GROUP BY ALL
),
shrink AS(
SELECT
sm.country_code,
sm.stock_date,
SUM(CASE WHEN add_or_remove = 'add'
THEN wac_lc * quantity
ELSE wac_lc * quantity*-1
END) AS shrink_value_lc,
FROM
`tlb-data-prod.data_platform.fct_grocery_stock_movement` sm
LEFT JOIN (
  SELECT
  vendor_warehouse_id,
  MAX(is_dsaas) AS is_dsaas
  FROM `tlb-data-prod.data_platform.dim_vendor_info`
  WHERE
  (is_darkstore OR is_dsaas)
  GROUP BY ALL
) V
on V.vendor_warehouse_id = sm.warehouse_id
WHERE
sm.stock_date between '2025-05-01' and <[Parameters].[Parameter 3]>
AND NOT (CASE WHEN sm.warehouse_id IN ('4dd770f7-cfd6-4afb-8fbc-4eb721a76e1a','9d0b1013-a782-4bf3-a273-14e96b2d3b6a') THEN FALSE ELSE COALESCE(is_dsaas,FALSE) END)
AND LOWER(stock_move_type_clean) NOT IN ("customer_order","supplier_order","customer_return") 
AND stock_move_source IS NOT NULL
GROUP BY ALL
),
transfer_shrink AS(
SELECT
DATE(w.current_status_modified_at) AS transfer_date,
w.country_code,
SUM((w.received_quantity-w.picked_quantity)*w.source_warehouse_sku_wac) AS transfer_shrink_value_lc,
FROM
`tlb-data-prod.data_platform.fct_warehouse_transfer_item` w
LEFT JOIN `tlb-data-prod.data_platform.dim_exchange_rate` der
ON
der.country_code = w.country_code
AND der.exchange_rate_date = DATE(w.current_status_modified_at)
AND der.exchange_rate_base = 'EUR'
WHERE
DATE(w.current_status_modified_at) between '2025-05-01' and <[Parameters].[Parameter 3]>
AND UPPER(w.current_status) = 'COMPLETED'
GROUP BY ALL
),
sales AS(SELECT
foi.order_date,
foi.country_code,
MAX(foi.order_date) OVER(PARTITION BY foi.country_code) AS max_date,
COUNT(DISTINCT CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN v.vendor_warehouse_id END) AS vendors_count,
COUNT(foi.order_id) AS platform_successful_orders_count,
SUM(foi.gmv_amount_lc) AS platform_gmv_amount_lc,
COUNT(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN foi.order_id END) AS successful_orders_count,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN foi.gmv_amount_lc END) AS gmv_amount_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN aoi.order_amount_inc_vat_lc END) AS gpv_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND is_everyday_roastery) THEN aoi.order_amount_inc_vat_lc/1.14 
         WHEN foi.is_darkstore  THEN aoi.amount_paid_net_lc END) as gpv_exc_vat_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN aoi.cogs_amount_lc END) AS cogs_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN foi.delivery_fee_amount_lc END) AS non_tpro_delivery_fee_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN foi.service_fee_amount_lc END) AS service_fee_lc,
COUNT(CASE WHEN ((foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore) AND foi.has_tpro_delivery_discount THEN foi.order_id END) AS tpro_successful_orders_count,
SUM(CASE WHEN ((foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore) AND foi.has_tpro_delivery_discount THEN aoi.order_amount_inc_vat_lc END) AS tpro_gpv_lc,
SUM(CASE WHEN ((foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore) AND has_tpro_delivery_discount THEN
  CASE WHEN dps_delivery_fee_lc = 0 THEN dps_incentive_discount_lc ELSE dps_delivery_fee_lc END END) AS tpro_delivery_fee_lc,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN cpo.total_cost END) AS total_delivery_cost,
SUM(CASE WHEN (foi.country_code = 'EG' AND (foi.is_darkstore OR is_everyday_roastery)) OR foi.is_darkstore THEN fb.commission_amount_lc END) AS commission_amount_lc,
FROM `tlb-data-prod.data_platform.fct_order_info` foi
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING(vendor_id)
LEFT JOIN `tlb-data-prod.data_platform.agg_order_item` aoi USING(order_id)
LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_cpo1` cpo USING(order_id)
LEFT JOIN `tlb-data-prod.data_platform.fct_billing` fb USING(order_id)
WHERE
foi.order_date between '2025-05-01' and <[Parameters].[Parameter 3]>
AND aoi.order_date between '2025-05-01'and <[Parameters].[Parameter 3]>
AND cpo.order_date between '2025-05-01' and <[Parameters].[Parameter 3]>
AND foi.is_successful
AND NOT foi.is_test
GROUP BY ALL  
),
last_4w_avg AS (
SELECT
s.country_code,
CASE WHEN (FORMAT_DATE('%A', order_date) in ('Friday', 'Saturday') AND s.country_code <<>> "AE") OR (FORMAT_DATE('%A', order_date) in ('Sunday', 'Saturday') AND s.country_code = "AE") THEN 1 ELSE 0 END is_weekend,
MAX(vendors_count) AS max_vendors_count,
AVG(gpv_lc) AS avg_gpv_lc,
AVG(gpv_exc_vat_lc) AS avg_gpv_exc_vat_lc,
AVG(cogs_lc) AS avg_cogs_lc,
AVG(tpro_successful_orders_count) AS avg_tpro_successful_orders_count,
AVG(tpro_gpv_lc) AS avg_tpro_gpv_lc,
AVG(marketing_incentives) AS avg_marketing_incentives,
AVG(tpro_delivery_fee_lc) AS avg_tpro_delivery_fee_lc,
AVG(non_tpro_delivery_fee_lc) AS avg_non_tpro_delivery_fee_lc,
AVG(total_delivery_cost) AS avg_total_delivery_cost,
AVG(commission_amount_lc) AS avg_commission_amount_lc,
AVG(shrink_value_lc) AS avg_shrink_value_lc,
AVG(transfer_shrink_value_lc) AS avg_transfer_shrink_value_lc
FROM sales s
LEFT JOIN vouchers v
ON v.date = s.order_date
AND v.country_code = s.country_code
LEFT JOIN shrink
ON shrink.stock_date = s.order_date
AND shrink.country_code = s.country_code
LEFT JOIN transfer_shrink ts
ON ts.transfer_date = s.order_date
AND ts.country_code = s.country_code
WHERE
order_date >>= max_date-29
GROUP BY ALL
),
last_4w_avg_forecast AS (
SELECT
date,
d.country_code,
max_vendors_count,
avg_gpv_lc,
avg_gpv_exc_vat_lc,
avg_cogs_lc,
avg_tpro_successful_orders_count,
avg_tpro_gpv_lc,
avg_marketing_incentives,
avg_tpro_delivery_fee_lc,
avg_non_tpro_delivery_fee_lc,
avg_total_delivery_cost,
avg_commission_amount_lc,
avg_shrink_value_lc,
avg_transfer_shrink_value_lc
FROM dates d
LEFT JOIN last_4w_avg f
ON f.country_code = d.country_code
AND f.is_weekend = d.is_weekend
WHERE
d.date >> <[Parameters].[Parameter 3]>
),
forecast AS(
SELECT
CASE WHEN t.country_iso = 'QAR' THEN 'QA' ELSE t.country_iso END AS country_code,
t.iso_date AS order_date,
t.forecasted_orders AS forecasted_orders,
(t.forecasted_aov * t.forecasted_orders) AS forecasted_gmv_lc,
t.forecasted_del_fee_lc AS forecasted_non_tpro_delivery_fee_lc,
t.forecasted_service_fee_lc AS forecasted_service_fee_lc,
t.forecasted_front_margin AS forecasted_front_margin,
t.forecasted_orders + COALESCE(n.forecasted_orders,0) + COALESCE(f.forecasted_orders,0) AS forecasted_platform_orders,
(t.forecasted_aov * t.forecasted_orders) + (COALESCE(n.forecasted_aov,0) * COALESCE(n.forecasted_orders,0)) + (COALESCE(f.forecasted_aov,0) * COALESCE(f.forecasted_orders,0)) AS forecasted_platform_gmv  
FROM `tlb-data-prod.data_platform.forecast_tmart_daily` t
LEFT JOIN `tlb-data-prod.data_platform.forecast_nfv_daily` n
ON t.iso_date = n.iso_date
AND t.forecast_date = n.forecast_date
AND t.country_iso = n.country_iso
LEFT JOIN `tlb-data-prod.data_platform.forecast_food_daily` f
ON t.iso_date = f.iso_date
AND t.forecast_date = f.forecast_date
AND t.country_iso = f.country_iso
WHERE
t.forecast_date = <[Parameters].[Parameter 3]>+1
AND t.country_iso <<>> 'SA'
),
runrates AS(
SELECT
DATE_TRUNC(d.date,month) AS month,
d.country_code,
-----Actuals + RRs
MAX(COALESCE(s.vendors_count,sf.max_vendors_count)) AS vendors_count,
SUM(COALESCE(s.platform_successful_orders_count,0) + COALESCE(f.forecasted_platform_orders,0)) AS platform_orders_count, -- RR
SUM(COALESCE(s.platform_gmv_amount_lc,0) + COALESCE(f.forecasted_platform_gmv,0)) AS platform_gmv, --RR
SUM(COALESCE(s.successful_orders_count,0) + COALESCE(f.forecasted_orders,0)) AS successful_orders_count, --RR
SUM(COALESCE(s.gmv_amount_lc,0) + COALESCE(forecasted_gmv_lc,0)) AS gmv_amount_lc, --RR
SUM(COALESCE(s.gpv_lc,0) + COALESCE(avg_gpv_lc,0)) AS gpv_lc, --Simple AVG
SUM(COALESCE(s.gpv_exc_vat_lc,0) + COALESCE(avg_gpv_exc_vat_lc,0)) AS gpv_exc_vat_lc, --Simple AVG
SUM(COALESCE(s.cogs_lc,0) + COALESCE(avg_cogs_lc,0)) AS cogs_lc,  --Simple AVG
SUM(COALESCE(s.non_tpro_delivery_fee_lc,0) + COALESCE(avg_non_tpro_delivery_fee_lc,0)) AS non_tpro_delivery_fee_lc, --RR
SUM(COALESCE(s.service_fee_lc,0) + COALESCE(forecasted_service_fee_lc,0)) AS service_fee_lc, --RR
SUM(COALESCE(v.marketing_incentives,0) + COALESCE(avg_marketing_incentives,0)) AS marketing_incentives, --Simple avg,
SUM(COALESCE(tpro_successful_orders_count,0) + COALESCE(avg_tpro_successful_orders_count,0)) AS tpro_successful_orders_count,  --Simple AVG,
SUM(COALESCE(tpro_gpv_lc,0) + COALESCE(avg_tpro_gpv_lc,0)) AS tpro_gpv_lc,  --Simple AVG,
SUM(COALESCE(tpro_delivery_fee_lc,0) + COALESCE(avg_tpro_delivery_fee_lc,0)) AS tpro_delivery_fee_lc, --Simple AVG
SUM(COALESCE(total_delivery_cost,0) + COALESCE(avg_total_delivery_cost,0)) AS total_delivery_cost, -- Simple AVG
SUM(COALESCE(commission_amount_lc,0) + COALESCE(avg_commission_amount_lc,0)) AS commission_amount_lc, --Simple AVG
SUM(COALESCE(shrink_value_lc,0) + COALESCE(avg_shrink_value_lc,0)) AS shrink_value_lc, --Simple AVG
SUM(COALESCE(transfer_shrink_value_lc,0) + COALESCE(avg_transfer_shrink_value_lc,0)) AS transfer_shrink_value_lc, --Simple AVG
FROM dates d
LEFT JOIN sales s
ON s.order_date = d.date
AND s.country_code = d.country_code
LEFT JOIN shrink
ON shrink.stock_date = d.date
AND shrink.country_code = d.country_code
LEFT JOIN transfer_shrink ts
ON ts.transfer_date = d.date
AND ts.country_code = d.country_code
LEFT JOIN vouchers v
ON v.date = d.date
AND v.country_code = d.country_code
LEFT JOIN forecast f
ON f.order_date = d.date
AND f.country_code = d.country_code
LEFT JOIN last_4w_avg_forecast sf
ON sf.date = d.date
AND sf.country_code = d.country_code
WHERE
d.date BETWEEN '2025-05-01' AND DATE_ADD(DATE_TRUNC(<[Parameters].[Parameter 3]>-1,month), INTERVAL 2 month)-1
GROUP BY ALL
ORDER BY month desc
),
margin_of_error AS(
WITH base AS(SELECT
rr.month,
rr.country_code,
SAFE_DIVIDE((gpv_exc_vat_lc-cogs_lc),gpv_exc_vat_lc) - front_margin as margin_error,
SAFE_DIVIDE(shrink_value_lc,gpv_exc_vat_lc) - shrink_margin as shrink_error,
SAFE_DIVIDE(COALESCE(shrink_value_lc,0)+COALESCE(transfer_shrink_value_lc,0),gpv_exc_vat_lc) - shrink_margin as shrink_inc_transfer_error,
FROM runrates rr
LEFT JOIN `tlb-data-dev.data_platform_google_sheet.dim_tmart_pnl_actuals` p
ON PARSE_DATE('%Y-%m-%d', p.month) = rr.month
AND p.country_code = rr.country_code
AND p.country_code <<>> 'IQ'
)
SELECT
  curr.month,
  curr.country_code,
  AVG(prev.margin_error) AS margin_error,
  AVG(prev.shrink_error) AS shrink_error,
  AVG(prev.shrink_inc_transfer_error) AS shrink_inc_transfer_error
FROM base curr
LEFT JOIN base prev
  ON curr.country_code = prev.country_code
  AND prev.month << curr.month
  AND prev.month >>= DATE_SUB(curr.month, INTERVAL 3 MONTH)
GROUP BY ALL
)
SELECT
rr.*,
EXTRACT(DAY FROM DATE_ADD(rr.month, INTERVAL 1 month)-1 ) AS days_count,
-----BEs
SUM(back_margin) AS back_margin,
SUM(front_margin) AS front_margin,
SUM(nmr_ooi_margin) AS nmr_ooi_margin,
SUM(shrink_margin) AS shrink_margin,
SUM(packaging_cost_margin) AS packaging_cost_margin,
SUM(product_margin) AS product_margin,
SUM(picker_cpo) AS picker_cpo,
SUM(store_manager_cpo) AS store_manager_cpo,
SUM(store_oh_per_store) AS store_oh_per_store,
SUM(sga_pct_gmv) AS sga_pct_gmv,
SUM(sales_rev_per_order*orders) AS sales,
SUM(marketing_incentives_margin) AS marketing_incentives_margin_be,
SUM(p.marketing_incentives) AS marketing_incentives_be,
SUM(nrv) AS nrv,
SUM(cogs_front_margin) AS cogs_front_margin,
SUM(cogs_back_margin) AS cogs_back_margin,
SUM(packagin_cost) AS packaging_cost,
SUM(nmr_ooi_value) AS nmr_ooi_value,
SUM(ic_delivery_cost) AS ic_delivery_cost,
SUM(ic_commission) AS ic_commission,
SUM(shoppers) AS shoppers,
SUM(store_managers) AS store_managers,
SUM(store_oh_utilites) AS store_oh_utilites,
SUM(bad_debt_allowance) AS bad_debt_allowance,
SUM(other_cost) AS other_cost,
SUM(distribution_center_cost) AS distribution_center_cost,
SUM(renta_and_dep) AS renta_and_dep,
SUM(cancellation_rental_and_dep) AS cancellation_rental_and_dep,
SUM(shrinkage) AS shrinkage_be,
SUM(carc) AS carc,
SUM(cancellation_carc) AS cancellation_carc,
SUM(personnel) AS personnel,
SUM(sg_a) AS sg_a,
SUM(regional_personnel_expenses) AS regional_personnel_expenses,
SUM(regional_non_personnel_overhead) AS regional_non_personnel_overhead,
SUM(margin_error) AS margin_error,
SUM(shrink_error) AS shrink_error,
SUM(shrink_inc_transfer_error) AS shrink_inc_transfer_error,
SUM(adjusted_ebitda_wo_reg_cost) AS adjusted_ebitda_wo_reg_cost,
SUM(adjusted_ebitda_wo_reg_cost_nrv) AS adjusted_ebitda_wo_reg_cost_nrv,
SUM(adjusted_ebitda_inc_reg) AS adjusted_ebitda_inc_reg,
SUM(adjusted_ebitda_inc_reg_wo_nrv) AS adjusted_ebitda_inc_reg_wo_nrv
-- IC Delivery Cost
-- IC Commission
-- Shoppers
-- Store Managers
-- Store OH & Utilites
-- Bad Debt Allowance
-- Other Cost
-- Distribution Center Cost
-- Rental & Dep.
-- Cancellation Rental & Dep.
FROM runrates rr
LEFT JOIN `tlb-data-dev.data_platform_google_sheet.dim_tmart_pnl_actuals` p
ON PARSE_DATE('%Y-%m-%d', p.month) = rr.month
AND p.country_code = rr.country_code
LEFT JOIN margin_of_error e
ON e.month = rr.month
AND e.country_code = rr.country_code
WHERE
rr.month between '2025-05-01' and <[Parameters].[Parameter 3]>
AND rr.country_code <<>> 'IQ'
GROUP BY ALL]]></relation>
            </properties>
