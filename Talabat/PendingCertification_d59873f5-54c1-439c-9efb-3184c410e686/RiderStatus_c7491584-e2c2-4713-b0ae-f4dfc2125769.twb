    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.0xwjnbf1y7718x16hn8w01cka715' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.12a7gea1be4pbk19apvxv0gkg3e1'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='abdelrahman.nassar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12a7gea1be4pbk19apvxv0gkg3e1' name='Custom SQL Query' type='text'>WITH&#13;
  rider_recent_orders AS&#13;
  (&#13;
    SELECT&#13;
      primary_rider_id AS rider_id,&#13;
      COUNT(DISTINCT IF(DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY), order_id, NULL)) AS orders_last_90_days,&#13;
      COUNT(DISTINCT IF(DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY), order_id, NULL)) AS orders_last_60_days,&#13;
      COUNT(DISTINCT IF(DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY), order_id, NULL)) AS orders_last_30_days,&#13;
      COUNT(DISTINCT IF(DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 15 DAY), order_id, NULL)) AS orders_last_15_days,&#13;
        COUNT(DISTINCT IF(DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY), order_id, NULL)) AS orders_last_7_days&#13;
    FROM&#13;
      `tlb-data-prod.data_platform.fct_logistics_order`&#13;
    WHERE&#13;
      country_code = &apos;eg&apos;&#13;
      AND order_status = &apos;completed&apos;&#13;
      AND DATE(created_at, timezone) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)&#13;
    GROUP BY&#13;
      1&#13;
  )&#13;
,&#13;
  rider_all_time_months AS&#13;
  (&#13;
    SELECT&#13;
      primary_rider_id AS rider_id,&#13;
      COUNT(DISTINCT DATE_TRUNC(created_date, MONTH)) AS all_time_active_months&#13;
    FROM&#13;
      `tlb-data-prod.data_platform.fct_logistics_order`&#13;
    WHERE&#13;
      country_code = &apos;eg&apos; AND order_status = &apos;completed&apos;&#13;
    GROUP BY&#13;
      1&#13;
  )&#13;
,&#13;
  orders_since_contract AS&#13;
  (&#13;
    SELECT&#13;
      r.rider_id,&#13;
      COUNT(DISTINCT o.order_id) AS orders_since_contract_start&#13;
    FROM&#13;
      `tlb-data-prod.data_platform.dim_logistics_rider` AS r&#13;
      JOIN `tlb-data-prod.data_platform.fct_logistics_order` AS o ON r.rider_id = o.primary_rider_id&#13;
    WHERE&#13;
      r.country_code = &apos;eg&apos;&#13;
      AND o.order_status = &apos;completed&apos;&#13;
      AND DATE(o.created_at, o.timezone) &gt;&gt;= DATE(r.last_contract_start_at)&#13;
    GROUP BY&#13;
      1&#13;
  )&#13;
SELECT&#13;
  r.rider_id,&#13;
  r.rider_name,&#13;
  r.is_active AS active_flag,&#13;
  r.last_contract_name,&#13;
  DATE_DIFF(CURRENT_DATE(), DATE(r.last_contract_start_at), MONTH) AS months_since_last_contract_start,&#13;
  r.last_operating_zone_name,&#13;
  COALESCE(am.all_time_active_months, 0) AS active_months,&#13;
  COALESCE(c.orders_since_contract_start, 0) AS orders_since_contract_start,&#13;
  COALESCE(ro.orders_last_90_days, 0) AS orders_last_90_days,&#13;
  COALESCE(ro.orders_last_60_days, 0) AS orders_last_60_days,&#13;
  COALESCE(ro.orders_last_30_days, 0) AS orders_last_30_days,&#13;
  COALESCE(ro.orders_last_15_days, 0) AS orders_last_15_days,&#13;
  COALESCE(ro.orders_last_7_days, 0) AS orders_last_7_days&#13;
FROM&#13;
  `tlb-data-prod.data_platform.dim_logistics_rider` AS r&#13;
  LEFT JOIN rider_recent_orders AS ro ON r.rider_id = ro.rider_id&#13;
  LEFT JOIN rider_all_time_months AS am ON r.rider_id = am.rider_id&#13;
  LEFT JOIN orders_since_contract AS c ON r.rider_id = c.rider_id&#13;
WHERE&#13;
  r.country_code = &apos;eg&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
