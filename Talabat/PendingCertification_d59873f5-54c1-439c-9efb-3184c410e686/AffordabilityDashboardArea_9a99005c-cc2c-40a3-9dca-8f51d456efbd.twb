      <column caption='Look By (Account Manager)' datatype='boolean' default-format='n#,##0.0;-#,##0.0' name='[Competitor (copy)_4200802964187156482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[View By (copy)_4200802964186591232] = &apos;Account Manager&apos;' />
