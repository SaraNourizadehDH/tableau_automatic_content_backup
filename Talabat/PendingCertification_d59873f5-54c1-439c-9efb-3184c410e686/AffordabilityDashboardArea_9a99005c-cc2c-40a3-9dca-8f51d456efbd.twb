      <table>
        <view>
          <datasources>
            <datasource caption='Area Performance' name='federated.0e86nyc0x3czl2115stmf15zvcd0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Area' datatype='string' name='[Parameter 10 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Date Window' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0qxogvy00gttqi1cmqib70hq14i6].[Calculation_2263058864798707713]' caption='Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-02-03#'>
              <calculation class='tableau' formula='#2025-02-03#' />
            </column>
            <column caption='Select Metric - Trends' datatype='string' default-format='n0;-0' name='[Select Metric Original (copy 2)_74731649346621441]' param-domain-type='list' role='measure' type='nominal' value='&quot;More Affordable Areas&quot;'>
              <calculation class='tableau' formula='&quot;More Affordable Areas&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e86nyc0x3czl2115stmf15zvcd0'>
            <column caption='Index Filter' datatype='boolean' default-format='p0.0%' name='[Better Promo % (copy)_1794684494514581508]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX() &lt;= 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='City' datatype='string' name='[Calculation_2679712169766703112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [delivery_city_name] = &apos;Cairo_inactive&apos; THEN &apos;Cairo&apos; else [delivery_city_name] end' />
            </column>
            <column caption='rank' datatype='integer' name='[Calculation_7546625640719265792]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='RANK(zn(SUM( if [Calculation_871939121873268736] then [gmv_amount_eur] * 100000000 else [gmv_amount_eur] end ) / TOTAL(SUM([gmv_amount_eur] ))))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Area filter' datatype='boolean' name='[Calculation_871939121873268736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_area_name] = [Parameters].[Parameter 10 1]' />
            </column>
            <column caption='Date Trend (Filter)' datatype='boolean' name='[Date Range (copy) (copy)_3930375880468946944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Daily&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;Last 7 days&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;Last 30 days&apos; THEN [reporting_date] &gt;= DATEADD(&apos;day&apos;, -15, DATETRUNC(&apos;day&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;WTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;week&apos;, -15, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;))&#10;WHEN &apos;MTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;month&apos;, -15, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) )&#10;WHEN &apos;YTD&apos; THEN [reporting_date] &gt;= DATEADD(&apos;year&apos;, -15, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) )&#10;END' />
            </column>
            <column caption='Date Trend' datatype='datetime' name='[Date Range (copy) (copy)_74731649347895299]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Daily&apos; THEN [reporting_date]&#10;WHEN &apos;Last 7 days&apos; THEN [reporting_date]&#10;WHEN &apos;Last 30 days&apos; THEN [reporting_date]&#10;WHEN &apos;WTD&apos; THEN DATETRUNC(&apos;week&apos;, [reporting_date], &apos;monday&apos;)&#10;WHEN &apos;MTD&apos; THEN DATETRUNC(&apos;month&apos;, [reporting_date])&#10;WHEN &apos;YTD&apos; THEN DATETRUNC(&apos;year&apos;, [reporting_date])&#10;END' />
            </column>
            <column caption='Less Affordable Areas lod' datatype='real' default-format='p0.00%' name='[More Affordable Areas lod (copy 2)_5215309149112635399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date] , [delivery_area_name], [competitor_platform] : IF [weighted_numerator (copy)_1794684493495443457] &lt; 0 THEN sum([gmv_amount_eur]) ELSE 0 END }' />
            </column>
            <column caption='Less Affordable Areas %' datatype='real' default-format='p0.00%' name='[More Affordable Areas lod (copy) (copy)_5215309149112885256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [More Affordable Areas lod (copy 2)_5215309149112635399] &gt; 0 THEN [delivery_area_name] END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([delivery_area_name]) }' />
            </column>
            <column caption='More Affordable Areas %' datatype='real' default-format='p0.00%' name='[More Affordable Areas lod (copy)_5215309149082394630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [more_affordable_promo (copy)_5215309149072326659] &gt; 0 THEN [delivery_area_name] END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([delivery_area_name]) }' />
            </column>
            <column caption='Less Affordable chains lod' datatype='real' default-format='p0.00%' name='[More Affordable chains lod (copy 2)_5215309149115367435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date] , [chain_id], [competitor_platform] : IF [weighted_numerator (copy)_1794684493495443457] &lt; 0 THEN sum([gmv_amount_eur]) ELSE 0 END }' />
            </column>
            <column caption='Less Affordable chains lod (copy)' datatype='real' default-format='p0.00%' name='[More Affordable chains lod (copy) (copy)_5215309149115379724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [More Affordable chains lod (copy 2)_5215309149115367435] &gt; 0 THEN chain_id END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([chain_id]) }' />
            </column>
            <column caption='More Affordable chains lod (copy)' datatype='real' default-format='p0.00%' name='[More Affordable chains lod (copy)_5215309149115076618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [more_affordable_promo (copy)_5215309149072326659] &gt; 0 THEN chain_id END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([chain_id]) }' />
            </column>
            <column caption='Selected Metric - Trends' datatype='real' default-format='p0.0%' name='[Selected Metric (copy 2)_74731649347514370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric Original (copy 2)_74731649346621441] &#10;WHEN &apos;Promo Difference&apos; THEN [weighted_numerator (copy)_1794684493495443457]&#10;WHEN &apos;More Affordable Areas&apos; THEN avg([More Affordable Areas lod (copy)_5215309149082394630])&#10;WHEN &apos;Less Affordable Areas&apos; THEN avg([More Affordable Areas lod (copy) (copy)_5215309149112885256])&#10;WHEN &apos;More Affordable Chains&apos; THEN avg([More Affordable chains lod (copy)_5215309149115076618])&#10;WHEN &apos;Less Affordable Chains&apos; THEN avg([More Affordable chains lod (copy) (copy)_5215309149115379724])&#10;&#10;/*&#10;WHEN &apos;Protected GMV&apos; THEN [Protected GMV]&#10;WHEN &apos;Avg Basket Markup&apos; THEN [Avg Basket Markup]&#10;WHEN &apos;Non Compliant Vendors&apos; THEN [Non Compliant Vendors]&#10;WHEN &apos;Matched GMV&apos; THEN [Matched GMV]&#10;WHEN &apos;Effective Markup&apos; THEN [Effective MarkUp]&#10;WHEN &apos;Fake Deals&apos; THEN [Fake Deals]&#10;WHEN &apos;Misleading Deals&apos; THEN [Misleading Deals]&#10;WHEN &apos;Repeat Offenders&apos; THEN [Repeat Offenders Trend]&#10;*/&#10;END' />
            </column>
