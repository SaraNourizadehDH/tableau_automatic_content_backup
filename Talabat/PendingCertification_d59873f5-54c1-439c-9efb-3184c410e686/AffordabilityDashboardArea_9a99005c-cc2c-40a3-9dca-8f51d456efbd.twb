      <table>
        <view>
          <datasources>
            <datasource caption='Area Performance' name='federated.0e86nyc0x3czl2115stmf15zvcd0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Area' datatype='string' name='[Parameter 10 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0e86nyc0x3czl2115stmf15zvcd0].[Calculation_86412826112507906]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0e86nyc0x3czl2115stmf15zvcd0].[reporting_date]' caption='Date 1' datatype='date' name='[Parameter 3 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-06#'>
              <calculation class='tableau' formula='#2025-02-06#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e86nyc0x3czl2115stmf15zvcd0'>
            <column caption='City' datatype='string' name='[Calculation_2679712169766703112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [delivery_city_name] = &apos;Cairo_inactive&apos; THEN &apos;Cairo&apos; else [delivery_city_name] end' />
            </column>
            <column caption='Talabat Vendor Coverage Gap' datatype='integer' name='[Calculation_4192992011474436096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_coverage_gap_vendor_count])' />
            </column>
            <column caption='Talabat Vendor Inventory Gap' datatype='integer' name='[Calculation_4192992011474599937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_inventory_gap_vendor_count])' />
            </column>
            <column caption='Difference - Choice' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5481725210520473602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_vendor_count]) - MAX([competitor_vendor_count])' />
            </column>
            <column caption='Difference - Price (matched vendors)' datatype='integer' name='[Calculation_6968898225782087682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([more_affordable_pricing_vendor_count]) - MAX([less_affordable_pricing_vendor_count])' />
            </column>
            <column caption='Difference - Max Vendor Distance Coverage (avg Km radius for matched vendors)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6968898225782448131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]) - MAX([competitor_overalpping_area_max_vendor_distance_meter_avg]))/1000' />
            </column>
            <column caption='Difference - Area Coverage (avg Sq Km for all vendors)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6968898225782583300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([talabat_area_coverage_square_km_avg]) - MAX([competitor_area_coverage_square_km_avg]))' />
            </column>
            <column caption='Max date' datatype='date' name='[Calculation_86412826112507906]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX([reporting_date]) }' />
            </column>
            <column caption='Area filter' datatype='boolean' name='[Calculation_871939121873268736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_area_name] = [Parameters].[Parameter 10 1]' />
            </column>
            <column caption='Lower Delivery Speed (matched talabat vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122267025413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_higher_delivery_eta_matched_vendor_count])' />
            </column>
            <column caption='Difference - Delivery Speed in minutes' datatype='real' datatype-customized='true' default-format='n#,##0.0;-#,##0.0' name='[Calculation_871939122267267078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([competitor_matched_vendor_delivery_eta_avg]) - MAX([talabat_matched_vendor_delivery_eta_avg])' />
            </column>
            <column caption='Difference - Promo (matched vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122278432775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_promotion_matched_vendor_count]) - MAX([competitor_promotion_matched_vendor_count])' />
            </column>
            <column caption='Lower Promo (matched talabat vendors)' datatype='real' default-format='p0.0%' name='[Calculation_871939122278711304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_at_risk])/sum([matched_gmv_amount_eur])' />
            </column>
            <column caption='Higher Delivery Fee (matched talabat vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122281578505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([talabat_higher_delivery_fee_matched_vendor_count])' />
            </column>
            <column caption='Difference - Delivery Fee in local currency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_871939122281779210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([competitor_matched_vendor_delivery_fee_lc_avg]) - MAX([talabat_matched_vendor_delivery_fee_lc_avg])' />
            </column>
            <column caption='Higher Price (matched talabat vendors)' datatype='real' default-format='p0.0%' name='[Calculation_871939122282364939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([less_affordable_pricing_vendor_count])/max([matched_vendor_count])' />
            </column>
            <column caption='Last 5 days filter' datatype='boolean' name='[Last 30 days filter (copy)_5069645829964464128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reporting_date] &gt;= DATEADD(&apos;day&apos;, -5, [Parameters].[Parameter 3 1]) AND [reporting_date] &lt;= [Parameters].[Parameter 3 1]' />
            </column>
            <column datatype='real' name='[competitor_area_coverage_square_km_avg]' role='measure' type='quantitative' />
