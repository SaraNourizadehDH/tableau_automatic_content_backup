          <datasource-dependencies datasource='federated.0e86nyc0x3czl2115stmf15zvcd0'>
            <column caption='Availability Message (copy)' datatype='string' name='[Availability Message (copy)_861876406338494464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL({sum([Calculation_570620203253018625])}) then  &quot;There is no data to display&quot;  else  &quot;Data for &quot; + [competitor_platform] + &quot; in &quot; + [delivery_country_name] + &quot; on &quot; + str([reporting_date]) + &quot; is &quot; + STR(ROUND([Calculation_570620203253018625]*100, 0)) + &quot;% available&quot; end' />
