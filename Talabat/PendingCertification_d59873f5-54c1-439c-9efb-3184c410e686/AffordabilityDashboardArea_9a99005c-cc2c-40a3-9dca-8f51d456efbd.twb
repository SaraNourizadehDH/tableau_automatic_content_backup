alabat_free_delivery_matched_vendor_count]) - MAX([competitor_free_delivery_matched_vendor_count])&#10;WHEN &apos;Better Price Vendors (matched vendors)&apos; then MAX([more_affordable_pricing_vendor_count]) - MAX([less_affordable_pricing_vendor_count])&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for all vendors)&apos; then (MAX([talabat_area_max_vendor_distance_meter_avg]) - MAX([competitor_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for matched vendors)&apos; then (MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]) - MAX([competitor_overalpping_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Area Coverage (sq Km)&apos; then (MAX([talabat_area_coverage_square_km_avg]) - MAX([competitor_area_coverage_square_km_avg]))&#10;*/&#10;END' />
