            <column caption='Less Affordable chains lod (copy)' datatype='real' default-format='p0.00%' name='[More Affordable chains lod (copy) (copy)_5215309149115379724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [More Affordable chains lod (copy 2)_5215309149115367435] &gt; 0 THEN chain_id END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([chain_id]) }' />
            </column>
            <column caption='More Affordable chains lod (copy)' datatype='real' default-format='p0.00%' name='[More Affordable chains lod (copy)_5215309149115076618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] : COUNTD(IF [more_affordable_promo (copy)_5215309149072326659] &gt; 0 THEN chain_id END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform]  : COUNTD([chain_id]) }' />
            </column>
            <column caption='Selected Metric - Trends' datatype='real' default-format='p0.0%' name='[Selected Metric (copy 2)_74731649347514370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric Original (copy 2)_74731649346621441] &#10;WHEN &apos;Promo Difference&apos; THEN [weighted_numerator (copy)_1794684493495443457]&#10;WHEN &apos;More Affordable Areas&apos; THEN avg([More Affordable Areas lod (copy)_5215309149082394630])&#10;WHEN &apos;Less Affordable Areas&apos; THEN avg([More Affordable Areas lod (copy) (copy)_5215309149112885256])&#10;WHEN &apos;More Affordable Chains&apos; THEN avg([More Affordable chains lod (copy)_5215309149115076618])&#10;WHEN &apos;Less Affordable Chains&apos; THEN avg([More Affordable chains lod (copy) (copy)_5215309149115379724])&#10;&#10;/*&#10;WHEN &apos;Protected GMV&apos; THEN [Protected GMV]&#10;WHEN &apos;Avg Basket Markup&apos; THEN [Avg Basket Markup]&#10;WHEN &apos;Non Compliant Vendors&apos; THEN [Non Compliant Vendors]&#10;WHEN &apos;Matched GMV&apos; THEN [Matched GMV]&#10;WHEN &apos;Effective Markup&apos; THEN [Effective MarkUp]&#10;WHEN &apos;Fake Deals&apos; THEN [Fake Deals]&#10;WHEN &apos;Misleading Deals&apos; THEN [Misleading Deals]&#10;WHEN &apos;Repeat Offenders&apos; THEN [Repeat Offenders Trend]&#10;*/&#10;END' />
            </column>
            <column-instance column='[target (copy)_397935292266860547]' derivation='Avg' name='[avg:target (copy)_397935292266860547:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column caption='Competitor Platform' datatype='string' name='[competitor_platform]' role='dimension' type='nominal' />
            <column caption='Area Name' datatype='string' name='[delivery_area_name]' role='dimension' type='nominal' />
