              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;&#10;&#10;WHEN &apos;GMV&apos; THEN MAX([gmv_amount_eur])&#10;WHEN &apos;Orders&apos; THEN MAX([order_count])&#10;ELSE null&#10;END' />
