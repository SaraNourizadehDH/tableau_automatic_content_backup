            <column caption='weighted_numerator' datatype='real' name='[order_count (copy)_1794684493495001088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[promo_difference]*[gmv_amount_eur]' />
            </column>
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
