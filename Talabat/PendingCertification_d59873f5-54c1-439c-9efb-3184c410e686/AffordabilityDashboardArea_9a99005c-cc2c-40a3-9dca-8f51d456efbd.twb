              <calculation class='tableau' formula='if [delivery_city_name] = &apos;Cairo_inactive&apos; THEN &apos;Cairo&apos; else [delivery_city_name] end' />
            </column>
            <column caption='Last 30 days filter' datatype='boolean' name='[Calculation_5703245992691478531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reporting_date] &gt;= DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 3 1]) AND [reporting_date] &lt;= [Parameters].[Parameter 3 1]' />
            </column>
            <column caption='Talabat' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6145161730947547137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;/*&#10;WHEN &apos;Choice&apos; then MAX([talabat_vendor_count])&#10;WHEN &apos;Speed in minutes (avg ETA for all vendors)&apos; then MAX([talabat_delivery_eta_avg])&#10;WHEN &apos;Speed in minutes (avg ETA for matched vendors)&apos; then  MAX([talabat_matched_vendor_delivery_eta_avg])&#10;WHEN &apos;Speed (faster matched vendors)&apos; then MAX([talabat_lower_delivery_eta_matched_vendor_count])&#10;WHEN &apos;Vendors with Promotions (all vendors)&apos; then  Max([talabat_promotion_vendor_count]) &#10;WHEN &apos;Vendors with Promotions (matched vendors)&apos; then  Max([talabat_promotion_matched_vendor_count]) &#10;*/&#10;WHEN &apos;Better Promo Vendors (matched vendors)&apos; then  SUM([talabat_higher_promotion_matched_vendor_count]) &#10;/*&#10;WHEN &apos;Delivery Fee in local currency (avg fee for all vendors)&apos; then  MAX([talabat_delivery_fee_lc_avg])&#10;WHEN &apos;Delivery Fee in local currency (avg fee for matched vendors)&apos; then MAX([talabat_matched_vendor_delivery_fee_lc_avg])&#10;WHEN &apos;Better Delivery Fee (matched vendors)&apos; then MAX([talabat_lower_delivery_fee_matched_vendor_count])&#10;WHEN &apos;Free Delivery (all vendors)&apos; then  Max([talabat_free_delivery_vendor_count]) &#10;WHEN &apos;Free Delivery (matched vendors)&apos; then  Max([talabat_free_delivery_matched_vendor_count]) &#10;WHEN &apos;Better Price Vendors (matched vendors)&apos; then MAX([more_affordable_pricing_vendor_count]) &#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for all vendors)&apos; then (MAX([talabat_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for matched vendors)&apos; then (MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Area Coverage (sq Km)&apos; then MAX([talabat_area_coverage_square_km_avg]) &#10;*/&#10;END' />
            </column>
            <column caption='Max date' datatype='date' name='[Calculation_86412826112507906]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX([reporting_date]) }' />
            </column>
            <column-instance column='[delivery_area_name]' derivation='Attribute' name='[attr:delivery_area_name:nk]' pivot='key' type='nominal' />
            <column caption='Competitor Platform' datatype='string' name='[competitor_platform]' role='dimension' type='nominal' />
            <column caption='Area Name' datatype='string' name='[delivery_area_name]' role='dimension' type='nominal' />
