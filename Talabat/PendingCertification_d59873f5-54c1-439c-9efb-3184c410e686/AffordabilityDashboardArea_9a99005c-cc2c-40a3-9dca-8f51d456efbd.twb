      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0e86nyc0x3czl2115stmf15zvcd0].[sum:gmv_amount_eur_sum:qk]&quot;' value='Total GMV' />
          <alias key='&quot;[federated.0e86nyc0x3czl2115stmf15zvcd0].[sum:gmv_amount_eur:qk]&quot;' value='GMV Amount' />
          <alias key='&quot;[federated.0e86nyc0x3czl2115stmf15zvcd0].[usr:delivery_area_count (copy)_820569969697554433:qk]&quot;' value='Number of Delivery Areas' />
          <alias key='&quot;[federated.0e86nyc0x3czl2115stmf15zvcd0].[usr:More Affordable Areas \%  (copy)_397935292209922048:qk]&quot;' value='More Affordable Areas %' />
        </aliases>
      </column>
      <column caption='Area Name is not All' datatype='boolean' name='[Area Name (copy)_610589611326201857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delivery_area_name] != &apos;All&apos;' />
      </column>
      <column caption='Availability Message (copy)' datatype='string' name='[Availability Message (copy)_861876406338494464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL({sum([Calculation_570620203253018625])}) then  &quot;There is no data to display&quot;  else  &quot;Data for &quot; + [competitor_platform] + &quot; in &quot; + [delivery_country_name] + &quot; on &quot; + str([reporting_date]) + &quot; is &quot; + STR(ROUND([Calculation_570620203253018625]*100, 0)) + &quot;% available&quot; end' />
      </column>
      <column caption='Free Delivery Fee %' datatype='real' default-format='p0.0%' name='[Better Delivery Fee % (copy)_6145161731344052233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_free_delivery_matched_vendor_count])/MAX([matched_vendor_count])' />
      </column>
      <column caption='Vendors with Worse Promo %' datatype='real' default-format='p0.0%' name='[Better Promo % (copy)_1794684493496946690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull( sum([gmv_at_risk])/sum([gmv_amount_eur]),0)' />
      </column>
      <column caption='Index Filter' datatype='boolean' default-format='p0.0%' name='[Better Promo % (copy)_1794684494514581508]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5481725210520473602]) - LOOKUP(ZN([Calculation_5481725210520473602]), -1)) / ABS(LOOKUP(ZN([Calculation_5481725210520473602]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Range Switch' datatype='boolean' name='[Calculation_171770135102263296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Parameters].[Parameter 17] = TRUE THEN&#10;[reporting_date] = [Parameters].[Parameter 3 1]&#10;ELSEIF [Parameters].[Parameter 17] = FALSE then&#10;[reporting_date] &lt;= [Parameters].[Parameter 3 1]&#10;end' />
      </column>
      <column caption='cityyy' datatype='string' name='[Calculation_1949003129897340930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [city_name] = &apos;All&apos; then &quot;&quot; else [city_name] end' />
      </column>
      <column caption='city = city' datatype='boolean' name='[Calculation_2679712169739571201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 11 1] = &apos;All&apos; then true else&#10;[Parameters].[Parameter 11 1] = [Calculation_2679712169766703112] end' />
      </column>
      <column caption='City filter' datatype='boolean' name='[Calculation_2679712169749712901]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2679712169766703112] != &apos;All&apos;' />
      </column>
      <column caption='City Select' datatype='boolean' name='[Calculation_2679712169761898502]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &apos;All Cities&apos; then [Calculation_2679712169766703112] = &apos;All&apos; else [Calculation_2679712169766703112] != &apos;All&apos; end' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_2679712169766703112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [delivery_city_name] = &apos;Cairo_inactive&apos; THEN &apos;Cairo&apos; else [delivery_city_name] end' />
      </column>
      <column caption='KPI 1' datatype='real' name='[Calculation_3766838886113820678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 7 1]&#10;WHEN &apos;Promotion Difference %&apos; then [weighted_numerator (copy)_1794684493495443457]&#10;END' />
      </column>
      <column caption='Difference between KPI 1 and KPI 2' datatype='real' name='[Calculation_3766838886141300745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3766838886113820678] - [KPI 1 (copy)_3766838886140182535]' />
      </column>
      <column caption='Sorting Value' datatype='real' name='[Calculation_3766838886163030026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9 1] = &apos;KPI 1&apos; then &#10;ZN([Calculation_3766838886113820678])* [Parameters].[Parameter 8 1]&#10;ELSEIF [Parameters].[Parameter 9 1] = &apos;KPI 2&apos; then &#10;ZN([KPI 1 (copy)_3766838886140182535])* [Parameters].[Parameter 8 1]&#10;END' />
      </column>
      <column caption='Talabat Vendor Coverage Gap' datatype='integer' name='[Calculation_4192992011474436096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_coverage_gap_vendor_count])' />
      </column>
      <column caption='Talabat Vendor Inventory Gap' datatype='integer' name='[Calculation_4192992011474599937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_inventory_gap_vendor_count])' />
      </column>
      <column caption='Vendor Distance Difference' datatype='real' name='[Calculation_4291367562958110720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]) -&#10;MAX([competitor_overalpping_area_max_vendor_distance_meter_avg])' />
      </column>
      <column caption='Area filter sort' datatype='integer' name='[Calculation_4657144240712540160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [delivery_area_name] = [Parameters].[Parameter 10 1] then 1 else 0 end' />
      </column>
      <column caption='ETA Difference (mins)' datatype='real' name='[Calculation_5481725210477588480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([max_competitor_eta]) - SUM([max_talabat_eta])&#10;MAX([competitor_delivery_eta_avg]) - MAX([talabat_delivery_eta_avg])' />
      </column>
      <column caption='Difference - Choice' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5481725210520473602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_vendor_count]) - MAX([competitor_vendor_count])' />
      </column>
      <column caption='Better ETA %' datatype='real' default-format='p0.0%' name='[Calculation_5703245992646746112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull( MAX([talabat_lower_delivery_eta_matched_vendor_count])/MAX([matched_vendor_count]),0)' />
      </column>
      <column caption='Better Price %' datatype='real' default-format='p0.0%' name='[Calculation_5703245992688279554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(  MAX([more_affordable_pricing_vendor_count]) / MAX([matched_vendor_count]),0)' />
      </column>
      <column caption='Last 30 days filter' datatype='boolean' name='[Calculation_5703245992691478531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reporting_date] &gt;= DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 3 1]) AND [reporting_date] &lt;= [Parameters].[Parameter 3 1]' />
      </column>
      <column caption='Delivery Area PCT ' datatype='real' default-format='p0%' name='[Calculation_570620203253018625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [delivery_area_availability_pct] &gt; 1 THEN 1 ELSE [delivery_area_availability_pct] END' />
      </column>
      <column caption='Vendor Availability PCT ' datatype='real' default-format='p0%' name='[Calculation_570620203253313538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vendor_availability_pct] &gt; 1 THEN 1&#10;ELSE [vendor_availability_pct]&#10;END' />
      </column>
      <column caption='12 weeks filter' datatype='boolean' name='[Calculation_610589611655520260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reporting_date] &gt;= DATEADD(&apos;week&apos;, -15, [Parameters].[Parameter 3 1]) AND [reporting_date] &lt;= [Parameters].[Parameter 3 1]' />
      </column>
      <column caption='select day of the week' datatype='boolean' name='[Calculation_610589611661213702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;, ([reporting_date])) = DATENAME(&apos;weekday&apos;, [Parameters].[Parameter 3 1])&#10;THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Selected Metric' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6145161730925899776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;/*&#10;WHEN &apos;Choice&apos; then MAX([talabat_vendor_count]) - MAX([competitor_vendor_count])&#10;WHEN &apos;Speed in minutes (avg ETA for all vendors)&apos; then  Max([competitor_delivery_eta_avg]) - MAX([talabat_delivery_eta_avg])&#10;WHEN &apos;Speed in minutes (avg ETA for matched vendors)&apos; then  Max([competitor_matched_vendor_delivery_eta_avg]) - MAX([talabat_matched_vendor_delivery_eta_avg])&#10;WHEN &apos;Speed (faster matched vendors)&apos; then MAX([talabat_lower_delivery_eta_matched_vendor_count]) - Max([talabat_higher_delivery_eta_matched_vendor_count])&#10;WHEN &apos;Vendors with Promotions (all vendors)&apos; then  Max([talabat_promotion_vendor_count]) - MAX([competitor_promotion_vendor_count]) + 0&#10;WHEN &apos;Vendors with Promotions (matched vendors)&apos; then  Max([talabat_promotion_matched_vendor_count]) - MAX([competitor_promotion_matched_vendor_count])&#10;*/&#10;WHEN &apos;Better Promo Vendors (matched vendors)&apos; then  SUM([talabat_higher_promotion_matched_vendor_count]) - SUM([talabat_lower_promotion_matched_vendor_count])&#10;WHEN &apos;Promo Difference&apos; then [weighted_numerator (copy)_1794684493495443457]&#10;/*&#10;WHEN &apos;Delivery Fee in local currency (avg fee for all vendors)&apos; then  Max([competitor_delivery_fee_lc_avg]) - MAX([talabat_delivery_fee_lc_avg])&#10;WHEN &apos;Delivery Fee in local currency (avg fee for matched vendors)&apos; then MAX([competitor_matched_vendor_delivery_fee_lc_avg]) - MAX([talabat_matched_vendor_delivery_fee_lc_avg])&#10;WHEN &apos;Better Delivery Fee (matched vendors)&apos; then MAX([talabat_lower_delivery_fee_matched_vendor_count]) - MAX([talabat_higher_delivery_fee_matched_vendor_count])&#10;WHEN &apos;Free Delivery (all vendors)&apos; then  Max([talabat_free_delivery_vendor_count]) - MAX([competitor_free_delivery_vendor_count])&#10;WHEN &apos;Free Delivery (matched vendors)&apos; then  Max([talabat_free_delivery_matched_vendor_count]) - MAX([competitor_free_delivery_matched_vendor_count])&#10;WHEN &apos;Better Price Vendors (matched vendors)&apos; then MAX([more_affordable_pricing_vendor_count]) - MAX([less_affordable_pricing_vendor_count])&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for all vendors)&apos; then (MAX([talabat_area_max_vendor_distance_meter_avg]) - MAX([competitor_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for matched vendors)&apos; then (MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]) - MAX([competitor_overalpping_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Area Coverage (sq Km)&apos; then (MAX([talabat_area_coverage_square_km_avg]) - MAX([competitor_area_coverage_square_km_avg]))&#10;*/&#10;END' />
      </column>
      <column caption='Talabat' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6145161730947547137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;/*&#10;WHEN &apos;Choice&apos; then MAX([talabat_vendor_count])&#10;WHEN &apos;Speed in minutes (avg ETA for all vendors)&apos; then MAX([talabat_delivery_eta_avg])&#10;WHEN &apos;Speed in minutes (avg ETA for matched vendors)&apos; then  MAX([talabat_matched_vendor_delivery_eta_avg])&#10;WHEN &apos;Speed (faster matched vendors)&apos; then MAX([talabat_lower_delivery_eta_matched_vendor_count])&#10;WHEN &apos;Vendors with Promotions (all vendors)&apos; then  Max([talabat_promotion_vendor_count]) &#10;WHEN &apos;Vendors with Promotions (matched vendors)&apos; then  Max([talabat_promotion_matched_vendor_count]) &#10;*/&#10;WHEN &apos;Better Promo Vendors (matched vendors)&apos; then  SUM([talabat_higher_promotion_matched_vendor_count]) &#10;/*&#10;WHEN &apos;Delivery Fee in local currency (avg fee for all vendors)&apos; then  MAX([talabat_delivery_fee_lc_avg])&#10;WHEN &apos;Delivery Fee in local currency (avg fee for matched vendors)&apos; then MAX([talabat_matched_vendor_delivery_fee_lc_avg])&#10;WHEN &apos;Better Delivery Fee (matched vendors)&apos; then MAX([talabat_lower_delivery_fee_matched_vendor_count])&#10;WHEN &apos;Free Delivery (all vendors)&apos; then  Max([talabat_free_delivery_vendor_count]) &#10;WHEN &apos;Free Delivery (matched vendors)&apos; then  Max([talabat_free_delivery_matched_vendor_count]) &#10;WHEN &apos;Better Price Vendors (matched vendors)&apos; then MAX([more_affordable_pricing_vendor_count]) &#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for all vendors)&apos; then (MAX([talabat_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for matched vendors)&apos; then (MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]))/1000&#10;WHEN &apos;Area Coverage (sq Km)&apos; then MAX([talabat_area_coverage_square_km_avg]) &#10;*/&#10;END' />
      </column>
      <column caption='Higher/Lower' datatype='string' name='[Calculation_6145161731272040454]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6145161730925899776] &gt;= 0 then &apos;higher than&apos; &#10;ELSEIF [Calculation_6145161730925899776] = 0 then &apos;equal to the&apos;&#10;&#10;ELSE &apos;lower than&apos; END' />
      </column>
      <column caption='Vendors with Better Promo %' datatype='real' default-format='p0.0%' name='[Calculation_6145161731330478087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull( sum([protected_gmv])/sum([gmv_amount_eur]),0)' />
