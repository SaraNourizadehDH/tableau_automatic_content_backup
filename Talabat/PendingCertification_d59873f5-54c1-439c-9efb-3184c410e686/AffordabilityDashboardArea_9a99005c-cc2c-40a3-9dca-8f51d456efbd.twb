      <column caption='Better Delivery Fee %' datatype='real' default-format='p0.0%' name='[Calculation_6145161731342692360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull( MAX([talabat_lower_delivery_fee_matched_vendor_count])/MAX([matched_vendor_count]),0)' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_6145161731346870285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='///// Selected Periods:&#10;if [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -6, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -29, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= [Parameters].[Parameter 2]&#10;THEN &apos;Selected Period&apos;&#10;&#10;///// Comparison Periods:&#10;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Daily&apos; &#10;AND [reporting_date] = [Parameters].[Parameter 2] - 1&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 7 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -13, [Parameters].[Parameter 2]) &#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;Last 30 days&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;day&apos;, -59, [Parameters].[Parameter 2])&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, -30, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;WTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;), [Parameters].[Parameter 2]), DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2], &apos;Monday&apos;)) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;MTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;ELSEIF [Parameters].[Parameter 11] = &apos;YTD&apos; AND&#10;[reporting_date] &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]))&#10;AND [reporting_date] &lt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2]), [Parameters].[Parameter 2]), DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 2])) )&#10;THEN &apos;Comparison Period&apos;&#10;&#10;&#10;END' />
      </column>
      <column caption='hide null' datatype='boolean' name='[Calculation_6145161731348783118]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='area name filter main kpi' datatype='boolean' name='[Calculation_625085574095626243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Parameters].[Parameter 10 1]) then [delivery_area_name] = &apos;All&apos; else [delivery_area_name] = [Parameters].[Parameter 10 1] end' />
      </column>
      <column caption='Main KPIs Title' datatype='string' name='[Calculation_625085574098296836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 10 1] = &apos;All&apos; then &apos;All Areas&apos; + &apos;, &apos; +[Calculation_2679712169766703112]  &#10;else [Parameters].[Parameter 10 1] + &apos;, &apos; + [Calculation_2679712169766703112]  &#10;end' />
      </column>
      <column caption='Test' datatype='string' name='[Calculation_687432286830342147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(str([Calculation_570620203253018625]),&apos;No data&apos;)' />
      </column>
      <column caption='Availability Message' datatype='string' name='[Calculation_687432286832398340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [data_availability_indicator]&#10;when &apos;Green&apos; then&#10;&quot;Data unavailability for &quot; + [competitor_platform] + &quot; in &quot; + [delivery_country_name] + &quot; is within acceptable limits&quot;&#10;when &apos;Yellow&apos; then&#10;&quot;Data unavailability for &quot; + [competitor_platform] + &quot; in &quot; + [delivery_country_name] + &quot; is slightly beyond the threshold&quot;&#10;&#10;when &apos;Red&apos; then&#10;&quot;Data unavailability for &quot; + [competitor_platform] + &quot; in &quot; + [delivery_country_name] +  &quot; is significantly above the threshold&quot;&#10;&#10;&#10;end' />
      </column>
      <column caption=' no data' datatype='boolean' name='[Calculation_687432286843371525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_570620203253018625] &gt; 0' />
      </column>
      <column caption='Difference - Price (matched vendors)' datatype='integer' name='[Calculation_6968898225782087682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([more_affordable_pricing_vendor_count]) - MAX([less_affordable_pricing_vendor_count])' />
      </column>
      <column caption='Difference - Max Vendor Distance Coverage (avg Km radius for matched vendors)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6968898225782448131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MAX([talabat_overlapping_area_max_vendor_distance_meter_avg]) - MAX([competitor_overalpping_area_max_vendor_distance_meter_avg]))/1000' />
      </column>
      <column caption='Difference - Area Coverage (avg Sq Km for all vendors)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6968898225782583300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MAX([talabat_area_coverage_square_km_avg]) - MAX([competitor_area_coverage_square_km_avg]))' />
      </column>
      <column caption='Filter Action (Platform)' datatype='string' name='[Calculation_736690408022593537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [delivery_country_name] &#10;when &apos;UAE&apos; THEN &apos;deliveroo&apos;&#10;when &apos;Qatar&apos; THEN &apos;deliveroo&apos;&#10;when &apos;Bahrain&apos; then &apos;jahez&apos;&#10;when &apos;Egypt&apos; then &apos;elmenus&apos;&#10;when &apos;Iraq&apos; then &apos;toters&apos;&#10;when &apos;Kuwait&apos; then &apos;deliveroo&apos;&#10;when &apos;Oman&apos; then &apos;tm_done&apos;&#10;when &apos;Jordan&apos; then &apos;careem&apos;&#10;END' />
      </column>
      <column caption='rank' datatype='integer' name='[Calculation_7546625640719265792]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(zn(SUM( if [Calculation_871939121873268736] then [gmv_amount_eur] * 100000000 else [gmv_amount_eur] end ) / TOTAL(SUM([gmv_amount_eur] ))))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Count of Less  Areas' datatype='real' name='[Calculation_84653629708681216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn({FIXED  [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform], [delivery_area_name] :&#10;(IF [Calculation_6145161730925899776] &lt; 0 then countd([location_id]) END)&#10;//countd([location_id])&#10;}))&#10;/&#10;sum(zn({FIXED  [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] :&#10;countd([location_id])&#10;}))' />
      </column>
      <column caption='Max date' datatype='date' name='[Calculation_86412826112507906]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([reporting_date]) }' />
      </column>
      <column caption='Area filter' datatype='boolean' name='[Calculation_871939121873268736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delivery_area_name] = [Parameters].[Parameter 10 1]' />
      </column>
      <column caption='Lower Delivery Speed (matched talabat vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122267025413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_higher_delivery_eta_matched_vendor_count])' />
      </column>
      <column caption='Difference - Delivery Speed in minutes' datatype='real' datatype-customized='true' default-format='n#,##0.0;-#,##0.0' name='[Calculation_871939122267267078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([competitor_matched_vendor_delivery_eta_avg]) - MAX([talabat_matched_vendor_delivery_eta_avg])' />
      </column>
      <column caption='Difference - Promo (matched vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122278432775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_promotion_matched_vendor_count]) - MAX([competitor_promotion_matched_vendor_count])' />
      </column>
      <column caption='Lower Promo (matched talabat vendors)' datatype='real' default-format='p0.0%' name='[Calculation_871939122278711304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_at_risk])/sum([matched_gmv_amount_eur])' />
      </column>
      <column caption='Higher Delivery Fee (matched talabat vendors)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_871939122281578505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([talabat_higher_delivery_fee_matched_vendor_count])' />
      </column>
      <column caption='Difference - Delivery Fee in local currency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_871939122281779210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([competitor_matched_vendor_delivery_fee_lc_avg]) - MAX([talabat_matched_vendor_delivery_fee_lc_avg])' />
      </column>
      <column caption='Higher Price (matched talabat vendors)' datatype='real' default-format='p0.0%' name='[Calculation_871939122282364939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([less_affordable_pricing_vendor_count])/max([matched_vendor_count])' />
      </column>
      <column caption='Choice Difference (copy)' datatype='integer' default-format='n#,##0;-#,##0' name='[Choice Difference (copy)_2760917734821732353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull( MAX([talabat_vendor_count]) - MAX([competitor_vendor_count]),0)' />
