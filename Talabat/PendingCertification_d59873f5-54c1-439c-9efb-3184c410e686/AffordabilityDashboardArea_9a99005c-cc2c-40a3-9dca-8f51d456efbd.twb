              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;/*&#10;WHEN &apos;Choice&apos; then MAX([competitor_vendor_count])&#10;WHEN &apos;Speed in minutes (avg ETA for all vendors)&apos; then  Max([competitor_delivery_eta_avg]) &#10;WHEN &apos;Speed in minutes (avg ETA for matched vendors)&apos; then  Max([competitor_matched_vendor_delivery_eta_avg]) &#10;WHEN &apos;Speed (faster matched vendors)&apos; then Max([talabat_higher_delivery_eta_matched_vendor_count])&#10;WHEN &apos;Vendors with Promotions (all vendors)&apos; then MAX([competitor_promotion_vendor_count])&#10;WHEN &apos;Vendors with Promotions (matched vendors)&apos; then  MAX([competitor_promotion_matched_vendor_count])&#10;*/&#10;WHEN &apos;Better Promo Vendors (matched vendors)&apos; then  SUM([talabat_lower_promotion_matched_vendor_count])&#10;/*&#10;WHEN &apos;Delivery Fee in local currency (avg fee for all vendors)&apos; then  Max([competitor_delivery_fee_lc_avg]) &#10;WHEN &apos;Delivery Fee in local currency (avg fee for matched vendors)&apos; then MAX([competitor_matched_vendor_delivery_fee_lc_avg]) &#10;WHEN &apos;Better Delivery Fee (matched vendors)&apos; then  MAX([talabat_higher_delivery_fee_matched_vendor_count])&#10;WHEN &apos;Free Delivery (all vendors)&apos; then  MAX([competitor_free_delivery_vendor_count])&#10;WHEN &apos;Free Delivery (matched vendors)&apos; then   MAX([competitor_free_delivery_matched_vendor_count])&#10;WHEN &apos;Better Price Vendors (matched vendors)&apos; then MAX([less_affordable_pricing_vendor_count])&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for all vendors)&apos; then  MAX([competitor_area_max_vendor_distance_meter_avg])/1000&#10;WHEN &apos;Max Vendor Distance Coverage (avg Km radius for matched vendors)&apos; then  MAX([competitor_overalpping_area_max_vendor_distance_meter_avg])/1000&#10;WHEN &apos;Area Coverage (sq Km)&apos; then MAX([competitor_area_coverage_square_km_avg])&#10;*/&#10;END' />
