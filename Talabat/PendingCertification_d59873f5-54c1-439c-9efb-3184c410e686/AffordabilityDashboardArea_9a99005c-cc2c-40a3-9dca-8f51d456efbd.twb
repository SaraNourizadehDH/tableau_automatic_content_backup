            <column-instance column='[weighted_numerator (copy)_1794684493495443457]' derivation='User' name='[usr:weighted_numerator (copy)_1794684493495443457:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vendor_wallet_share_tier]' role='dimension' type='nominal' />
            <column caption='Promotion Difference' datatype='real' default-format='p0.00%' name='[weighted_numerator (copy)_1794684493495443457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([order_count (copy)_1794684493495001088])) / ZN(SUM([gmv_amount_eur]))' />
            </column>
          </datasource-dependencies>
