            <column caption='Country' datatype='string' name='[delivery_country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[gmv_amount_eur]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_key_vip_account]' role='dimension' type='nominal' />
            <column caption='More Affordable Areas lod' datatype='real' default-format='p0.00%' name='[more_affordable_promo (copy)_5215309149072326659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date] , [delivery_area_name], [competitor_platform] : IF [weighted_numerator (copy)_1794684493495443457] &gt; 0 THEN sum([gmv_amount_eur]) ELSE 0 END }' />
            </column>
