            <column caption='Look By (Vendor Hitlist) ' datatype='boolean' default-format='n#,##0.0;-#,##0.0' name='[Look By (Account Manager) (copy) (copy)_530439637437710339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[View By (copy)_4200802964186591232] = &apos;Vendor Hitlist&apos;' />
