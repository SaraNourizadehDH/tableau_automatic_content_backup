        <calculation class='tableau' formula='/*IF RANK_UNIQUE(SUM([gmv_amount_eur_sum]), &apos;desc&apos;) &lt;= 150 THEN True ELSE False End*/&#10;IF RANK_UNIQUE(SUM([gmv_amount_eur_sum]), &apos;desc&apos;) &lt;= [Parameters].[Select trend (copy)_391531736006524928] THEN True ELSE False End'>
          <table-calc ordering-type='Rows' />
