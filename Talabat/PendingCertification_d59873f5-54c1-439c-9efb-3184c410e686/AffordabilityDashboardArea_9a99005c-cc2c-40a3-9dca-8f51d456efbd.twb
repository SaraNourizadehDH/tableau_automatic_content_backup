            <column caption='More Affordable Areas v %' datatype='real' default-format='p0.00%' name='[More Affordable Areas %  (copy)_397935292209922048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform] , [talabat_vendor_id]: COUNTD(IF [More Affordable Areas lod (copy 2)_397935292210180098] &gt; 0 THEN [delivery_area_name] END) } &#10;/ &#10;{ FIXED [reporting_date], [delivery_country_name], [Calculation_2679712169766703112], [competitor_platform], [talabat_vendor_id]  : COUNTD([delivery_area_name]) }&#10;)' />
            </column>
            <column caption='More Affordable Areas lod v' datatype='real' default-format='p0.00%' name='[More Affordable Areas lod (copy 2)_397935292210180098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reporting_date] , [delivery_area_name], [competitor_platform], [talabat_vendor_id] : IF [weighted_numerator (copy)_1794684493495443457] &gt; 0 THEN sum([gmv_amount_eur]) ELSE 0 END }' />
