              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;&#10;&#10;WHEN &apos;Better Promo Vendors (matched vendors)&apos; THEN &#10;  IF [Calculation_2679712169766703112] = &apos;All&apos; AND [delivery_area_name] = &apos;All&apos; THEN &#10;    ([talabat_higher_promotion_matched_vendor_count]) - ([talabat_lower_promotion_matched_vendor_count])&#10;  END&#10;&#10;&#10;END' />
            </column>
