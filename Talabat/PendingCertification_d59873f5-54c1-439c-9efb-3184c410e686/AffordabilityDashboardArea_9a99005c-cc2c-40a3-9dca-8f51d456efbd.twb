            <column-instance column='[Competitor (copy)_4200802964187156482]' derivation='None' name='[none:Competitor (copy)_4200802964187156482:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_area_name]' derivation='None' name='[none:delivery_area_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_key_vip_account]' derivation='None' name='[none:is_key_vip_account:nk]' pivot='key' type='nominal' />
