          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e86nyc0x3czl2115stmf15zvcd0'>
            <column caption='Index Filter' datatype='boolean' default-format='p0.0%' name='[Better Promo % (copy)_1794684494514581508]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX() &lt;= 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
