            <column-instance column='[Date Range (copy) (copy)_3930375880468946944]' derivation='None' name='[none:Date Range (copy) (copy)_3930375880468946944:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_area_name]' derivation='None' name='[none:delivery_area_name:nk]' pivot='key' type='nominal' />
