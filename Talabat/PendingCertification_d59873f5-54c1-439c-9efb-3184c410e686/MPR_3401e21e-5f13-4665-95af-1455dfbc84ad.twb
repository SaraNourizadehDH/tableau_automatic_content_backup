        <calculation class='tableau' formula='{ FIXED [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [open_better_location_inventory_top50]) / &#10;        SUM(IIF(NOT ISNULL([open_better_location_inventory_top50]), [area_tier_by_sessions_contribution_weight], 0)) }' />
      </column>
      <column caption='Calculation2 (copy)' datatype='integer' name='[Calculation2 (copy)_4032973518405132302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (ZN(SUM([avg_successful_delivery_time_mins])) - LOOKUP(ZN(SUM([avg_successful_delivery_time_mins])), -1)) / ABS(LOOKUP(ZN(SUM([avg_successful_delivery_time_mins])), -1)) &gt; 0 then 1 else 0 end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG([acquisition_customer_count])) - LOOKUP(ZN(AVG([acquisition_customer_count])), -1)) / ABS(LOOKUP(ZN(AVG([acquisition_customer_count])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation6]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG([successful_frequency])) - LOOKUP(ZN(AVG([successful_frequency])), -1)) / ABS(LOOKUP(ZN(AVG([successful_frequency])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of days in a month' datatype='integer' name='[Calculation_1280640839231438848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [month_start_date], DATEADD(&apos;month&apos;, 1, [month_start_date]))' />
      </column>
      <column caption='Avg. Daily Orders' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1280640839231619073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cnt_successful_orders]/[Calculation_1280640839231438848]' />
      </column>
      <column caption='M1 Retention' datatype='real' default-format='p0.0%' name='[Calculation_1280640839234232322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_customer_lm_tm_count] / [active_customer_lm_count]' />
      </column>
      <column caption='DT mom' datatype='real' name='[Calculation_4032973518389587968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((IF DATE(DATETRUNC(&apos;month&apos;,[month_start_date])) = [Calculation_4032973518391623681] THEN ([avg_successful_delivery_time_mins]) END)&#10;&#10;/&#10;&#10;(IF DATETRUNC(&apos;month&apos;,[month_start_date]) = DATEADD(&apos;month&apos;,-1,[Calculation_4032973518391623681]) THEN ([avg_successful_delivery_time_mins]) END)))&#10;&#10;- 1' />
      </column>
      <column caption='Current Month' datatype='datetime' datatype-customized='true' name='[Calculation_4032973518391623681]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='Calculation4' datatype='real' name='[Calculation_4032973518401359882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([avg_successful_delivery_time_mins])) - LOOKUP(ZN(SUM([avg_successful_delivery_time_mins])), -1)) / ABS(LOOKUP(ZN(SUM([avg_successful_delivery_time_mins])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_4032973518402818059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_4032973518401359882] &gt; 0 then 1 else 0 end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation3' datatype='real' name='[Calculation_4032973518403350540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation2 (copy)_4032973518405132302] = 1 THEN [country_name] END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_4485163065659363328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([month_start_date] &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY()))&#10;    OR (DATEPART(&apos;month&apos;, [month_start_date]) = DATEPART(&apos;month&apos;, TODAY()) - 1&#10;        AND DATEPART(&apos;year&apos;, [month_start_date]) = DATEPART(&apos;year&apos;, TODAY()) - 1)&#10;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='QC Adoption' datatype='real' default-format='p0.0%' name='[Calculation_4485163065663291393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cnt_qc_successful_customers]/[cnt_successful_customers]' />
      </column>
      <column caption='TPro Customer GMV %' datatype='real' default-format='p0.0%' name='[Calculation_4485163065664983042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([tpro_customer_gmv_amount_eur])/SUM([total_successful_gmv_eur])' />
      </column>
      <column caption='% of orders delivered &gt; 45 mins' datatype='real' default-format='p0.0%' name='[Calculation_4485163065666048003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cnt_successful_orders_more_than_45_mins]/[non_preorder_successful_order_count]' />
      </column>
      <column caption='Orders on time%' datatype='real' default-format='p0.0%' name='[Calculation_4485163065667338244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cnt_successful_orders_on_time]/[non_preorder_successful_order_count]' />
