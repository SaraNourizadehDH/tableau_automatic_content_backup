                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN(SUM([Better Delivery Fee areas [Overall]] country])) - LO...' datatype='real' name='[Calculation_2730659124456407048]' role='measure' type='quantitative' user:unnamed='Value YoY'>
              <calculation class='tableau' formula='(ZN(SUM([Better PDT areas [Overall]] country (copy)_6064378379839332360])) - LOOKUP(ZN(SUM([Better PDT areas [Overall]] country (copy)_6064378379839332360])), -1))*100'>
