      <column caption='VFD savings%' datatype='real' default-format='p0.0%' name='[Calculation_4485163065668595718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_food_successful_vendor_funded_deals_eur]/[total_food_successful_gmv_eur]' />
      </column>
      <column caption='Calculation1' datatype='real' hidden='true' name='[Calculation_4485163065676414985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;   WHEN &quot;%orders delivered &gt; 45 mins&quot; THEN SUM([Calculation_4485163065666048003])&#10;   WHEN &quot;Acquisitions&quot; THEN SUM([acquisition_customer_count])&#10;   WHEN &quot;Drop off&quot; THEN SUM([avg_drop_off_kms])&#10;END' />
      </column>
      <column caption='Last month date Filter' datatype='boolean' name='[Calculation_4485163065678163978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [month_start_date] &gt;= DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY())&#10;&#10;THEN TRUE&#10;&#10;ELSE FALSE&#10;END' />
