          <datasource-dependencies datasource='federated.0tzzm00186r63b124s07l0zk5sjw'>
            <column caption='Better serviceable areas [Top 50]' datatype='real' default-format='p0.0%' name='[Better Location Inventory Open% (copy 2)_6614450898203684867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [open_better_location_inventory_top50]) / &#10;        SUM(IIF(NOT ISNULL([open_better_location_inventory_top50]), [area_tier_by_sessions_contribution_weight], 0)) }' />
