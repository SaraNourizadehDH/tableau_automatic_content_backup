                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN(SUM([Better serviceable areas [Top 50]] country])) - LOOK...' datatype='real' name='[Calculation_118923243444133900]' role='measure' type='quantitative' user:unnamed='Selection YoY'>
