            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_4485163065664983042]' derivation='User' name='[diff:usr:Calculation_4485163065664983042:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='Month Start Date' datatype='date' default-format='*mmm&apos;yy' name='[month_start_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4485163065682190347]' derivation='None' name='[none:Calculation_4485163065682190347:nk]' pivot='key' type='nominal' />
            <column-instance column='[area_name]' derivation='None' name='[none:area_name:nk]' pivot='key' type='nominal' />
