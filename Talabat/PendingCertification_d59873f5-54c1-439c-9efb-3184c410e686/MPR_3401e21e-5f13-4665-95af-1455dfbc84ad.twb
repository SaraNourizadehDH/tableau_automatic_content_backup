          <datasource-dependencies datasource='federated.0tzzm00186r63b124s07l0zk5sjw'>
            <column caption='Better Delivery Fee areas [Top 50]' datatype='real' default-format='p0.0%' name='[Better Delivery Fee areas [Overall]] (copy)_6064378379836858371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_delivery_fee_top50]) / &#10;        SUM(IIF(NOT ISNULL([better_location_delivery_fee_top50]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='More affordable areas [Overall]' datatype='real' default-format='p0.0%' name='[Better Location Inventory Open% (copy)_6614450898204921860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_affordability]) / &#10;        SUM(IIF(NOT ISNULL([better_location_affordability]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='Better Delivery Fee areas [Overall]' datatype='real' default-format='p0.0%' name='[Better PDT areas [Overall]] (copy)_6064378379836551170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_delivery_fee]) / &#10;        SUM(IIF(NOT ISNULL([better_location_delivery_fee]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_4485163065659363328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([month_start_date] &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY()))&#10;    OR (DATEPART(&apos;month&apos;, [month_start_date]) = DATEPART(&apos;month&apos;, TODAY()) - 1&#10;        AND DATEPART(&apos;year&apos;, [month_start_date]) = DATEPART(&apos;year&apos;, TODAY()) - 1)&#10;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='VFD savings%' datatype='real' default-format='p0.0%' name='[Calculation_4485163065668595718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_food_successful_vendor_funded_deals_eur]/[total_food_successful_gmv_eur]' />
            </column>
            <column caption='Valid Country Name' datatype='string' name='[Calculation_4659747924076052490]' role='dimension' type='nominal'>
