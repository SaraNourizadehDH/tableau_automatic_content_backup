      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='0.970775' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' parameter-percentage='0.0292249' show-aliased-fields='true' show-hidden-fields='true' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Selected Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
          <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='agg_performance_mbr_area_monthly' id='agg_performance_mbr_area_monthly_D9E5D7E9E1EF4C15BE3641000533D685'>
            <properties context=''>
              <relation connection='bigquery.0j4ksgw1el4b4a1e3w4xv039nqwu' name='Custom SQL Query' type='text'><![CDATA[WITH
all_metrics AS (
  SELECT 
    month_start_date,
    area_name, 
    city_name, 
    country_code, 
    country_name, 
    cnt_successful_orders, 
    acquisition_customer_count, 
    cnt_successful_customers,
    active_customer_lm_tm_count, 
    active_customer_lm_count,
    successful_frequency,
    food_successful_frequency,
    ls_successful_frequency,
    tmart_successful_frequency,
    avg_successful_basket_amount_lc,
    cnt_qc_successful_customers, 
    tpro_customer_gmv_amount_eur, 
    total_successful_gmv_eur,
    cnt_successful_inventory,
    non_preorder_successful_delivery_time_mins, 
    dtp_12_minutes_dt,
    P90_successful_DT_actual_mins,
    cnt_successful_orders_on_time, 
    non_preorder_successful_order_count,
    cnt_successful_orders_more_than_45_mins,
    cnt_contacted_orders, 
    avg_drop_off_kms,
    total_food_successful_vendor_funded_deals_eur,
    total_food_successful_gmv_eur,
    better_location_inventory_open,
    open_better_location_inventory_top50,
    better_location_pdt,
    better_location_pdt_top50,
    better_location_affordability, 
    better_location_affordability_top50,
    better_location_delivery_fee,
    better_location_delivery_fee_top50

  FROM `tlb-data-prod.data_platform.agg_performance_mbr_area_monthly`
  WHERE 
    month_start_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
)

,better_metrics AS (
  -- area
  SELECT 
    month_start_date,
    area_name,
    city_name,
    country_code, 
    country_name,
    better_location_inventory_open AS better_serviceable_areas_overall,
    open_better_location_inventory_top50 AS better_serviceable_areas_top50,
    better_location_pdt AS better_pdt_areas_overall,
    better_location_pdt_top50 AS better_pdt_areas_top50,
    better_location_affordability AS more_affordable_areas_overall, 
    better_location_affordability_top50 AS more_affordable_areas_top50,
    better_location_delivery_fee AS better_delivery_fee_areas_overall,
    better_location_delivery_fee_top50 AS better_delivery_fee_areas_top50
  FROM all_metrics
  WHERE area_name != 'overall'
  AND city_name != 'overall'
  AND country_name != 'overall'

UNION ALL

  -- city
  SELECT 
    month_start_date,
    'overall' area_name,
    city_name,
    country_code, 
    country_name,
    SAFE_DIVIDE(SUM(better_location_inventory_open), COUNT(better_location_inventory_open)) AS better_serviceable_areas_overall,
    SAFE_DIVIDE(SUM(open_better_location_inventory_top50), COUNT(open_better_location_inventory_top50)) AS better_serviceable_areas_top50,
SAFE_DIVIDE(SUM(better_location_pdt), COUNT(better_location_pdt)) AS better_pdt_areas_overall,
SAFE_DIVIDE(SUM(better_location_pdt_top50), COUNT(better_location_pdt_top50)) AS better_pdt_areas_top50,
SAFE_DIVIDE(SUM(better_location_affordability), COUNT(better_location_affordability)) AS more_affordable_areas_overall,
SAFE_DIVIDE(SUM(better_location_affordability_top50), COUNT(better_location_affordability_top50)) AS more_affordable_areas_top50,
SAFE_DIVIDE(SUM(better_location_delivery_fee), COUNT(better_location_delivery_fee)) AS better_delivery_fee_areas_overall,
SAFE_DIVIDE(SUM(better_location_delivery_fee_top50), COUNT(better_location_delivery_fee_top50)) AS better_delivery_fee_areas_top50

  FROM all_metrics
  WHERE area_name != 'overall'
GROUP BY ALL

UNION ALL

  -- country
  SELECT 
    month_start_date,
    'overall' area_name,
    'overall' city_name,
    country_code, 
    country_name,
    SAFE_DIVIDE(SUM(better_location_inventory_open), COUNT(better_location_inventory_open)) AS better_serviceable_areas_overall,
    SAFE_DIVIDE(SUM(open_better_location_inventory_top50), COUNT(open_better_location_inventory_top50)) AS better_serviceable_areas_top50,
SAFE_DIVIDE(SUM(better_location_pdt), COUNT(better_location_pdt)) AS better_pdt_areas_overall,
SAFE_DIVIDE(SUM(better_location_pdt_top50), COUNT(better_location_pdt_top50)) AS better_pdt_areas_top50,
SAFE_DIVIDE(SUM(better_location_affordability), COUNT(better_location_affordability)) AS more_affordable_areas_overall,
SAFE_DIVIDE(SUM(better_location_affordability_top50), COUNT(better_location_affordability_top50)) AS more_affordable_areas_top50,
SAFE_DIVIDE(SUM(better_location_delivery_fee), COUNT(better_location_delivery_fee)) AS better_delivery_fee_areas_overall,
SAFE_DIVIDE(SUM(better_location_delivery_fee_top50), COUNT(better_location_delivery_fee_top50)) AS better_delivery_fee_areas_top50
  FROM all_metrics
  WHERE area_name != 'overall'
  AND city_name != 'overall'
GROUP BY ALL
)

SELECT 
  current_month.*,

  -- cnt_successful_orders
  CASE WHEN current_month.cnt_successful_orders >>= previous_month.cnt_successful_orders THEN 1 END AS orders_mom_improved,
  CASE WHEN current_month.cnt_successful_orders << previous_month.cnt_successful_orders THEN 1 END AS orders_mom_dropped,

  -- acquisition_customer_count
  CASE WHEN current_month.acquisition_customer_count >>= previous_month.acquisition_customer_count THEN 1 END AS acquisition_mom_improved,
  CASE WHEN current_month.acquisition_customer_count << previous_month.acquisition_customer_count THEN 1 END AS acquisition_mom_dropped,

  -- cnt_successful_customers
  CASE WHEN current_month.cnt_successful_customers >>= previous_month.cnt_successful_customers THEN 1 END AS customers_mom_improved,
  CASE WHEN current_month.cnt_successful_customers << previous_month.cnt_successful_customers THEN 1 END AS customers_mom_dropped,

  -- m1_retention
  CASE WHEN SAFE_DIVIDE(current_month.active_customer_lm_tm_count, current_month.active_customer_lm_count) >>= SAFE_DIVIDE(previous_month.active_customer_lm_tm_count, previous_month.active_customer_lm_count) THEN 1 END AS m1_retention_mom_improved,
  CASE WHEN SAFE_DIVIDE(current_month.active_customer_lm_tm_count, current_month.active_customer_lm_count) << SAFE_DIVIDE(previous_month.active_customer_lm_tm_count, previous_month.active_customer_lm_count) THEN 1 END AS m1_retention_mom_dropped,

  -- successful_frequency
  CASE WHEN current_month.successful_frequency >>= previous_month.successful_frequency THEN 1 END AS successful_frequency_mom_improved,
  CASE WHEN current_month.successful_frequency << previous_month.successful_frequency THEN 1 END AS successful_frequency_mom_dropped,

  -- food_successful_frequency
  CASE WHEN current_month.food_successful_frequency >>= previous_month.food_successful_frequency THEN 1 END AS food_successful_frequency_mom_improved,
  CASE WHEN current_month.food_successful_frequency << previous_month.food_successful_frequency THEN 1 END AS food_successful_frequency_mom_dropped,

  -- ls_successful_frequency
  CASE WHEN current_month.ls_successful_frequency >>= previous_month.ls_successful_frequency THEN 1 END AS ls_successful_frequency_mom_improved,
  CASE WHEN current_month.ls_successful_frequency << previous_month.ls_successful_frequency THEN 1 END AS ls_successful_frequency_mom_dropped,

  -- tmart_successful_frequency
  CASE WHEN current_month.tmart_successful_frequency >>= previous_month.tmart_successful_frequency THEN 1 END AS tmart_successful_frequency_mom_improved,
  CASE WHEN current_month.tmart_successful_frequency << previous_month.tmart_successful_frequency THEN 1 END AS tmart_successful_frequency_mom_dropped,

  -- avg_successful_basket_amount_lc
  CASE WHEN current_month.avg_successful_basket_amount_lc >>= previous_month.avg_successful_basket_amount_lc THEN 1 END AS basket_size_mom_improved,
  CASE WHEN current_month.avg_successful_basket_amount_lc << previous_month.avg_successful_basket_amount_lc THEN 1 END AS basket_size_mom_dropped,

  -- qc_adoption
  CASE WHEN SAFE_DIVIDE(current_month.cnt_qc_successful_customers, current_month.cnt_successful_customers) >>= SAFE_DIVIDE(previous_month.cnt_qc_successful_customers, previous_month.cnt_successful_customers) THEN 1 END AS qc_adoption_mom_improved,
  CASE WHEN SAFE_DIVIDE(current_month.cnt_qc_successful_customers, current_month.cnt_successful_customers) << SAFE_DIVIDE(previous_month.cnt_qc_successful_customers, previous_month.cnt_successful_customers) THEN 1 END AS qc_adoption_mom_dropped,

  -- tpro_customer_gmv
  CASE WHEN SAFE_DIVIDE(current_month.tpro_customer_gmv_amount_eur, current_month.total_successful_gmv_eur) >>= SAFE_DIVIDE(previous_month.tpro_customer_gmv_amount_eur, previous_month.total_successful_gmv_eur) THEN 1 END AS tpro_gmv_mom_improved,
  CASE WHEN SAFE_DIVIDE(current_month.tpro_customer_gmv_amount_eur, current_month.total_successful_gmv_eur) << SAFE_DIVIDE(previous_month.tpro_customer_gmv_amount_eur, previous_month.total_successful_gmv_eur) THEN 1 END AS tpro_gmv_mom_dropped,

  -- cnt_successful_inventory
CASE WHEN current_month.cnt_successful_inventory >>= previous_month.cnt_successful_inventory THEN 1 END AS inventory_mom_improved,
CASE WHEN current_month.cnt_successful_inventory << previous_month.cnt_successful_inventory THEN 1 END AS inventory_mom_dropped,

-- non_preorder_successful_delivery_time_mins (lower is better — careful here)
CASE WHEN current_month.non_preorder_successful_delivery_time_mins << previous_month.non_preorder_successful_delivery_time_mins THEN 1 END AS delivery_time_mom_improved,
CASE WHEN current_month.non_preorder_successful_delivery_time_mins >>= previous_month.non_preorder_successful_delivery_time_mins THEN 1 END AS delivery_time_mom_dropped,

-- dtp_12_minutes_dt (lower is better — careful here)
CASE WHEN current_month.dtp_12_minutes_dt << previous_month.dtp_12_minutes_dt THEN 1 END AS dtp_12_minutes_dt_mom_improved,
CASE WHEN current_month.dtp_12_minutes_dt >>= previous_month.dtp_12_minutes_dt THEN 1 END AS dtp_12_minutes_dt_mom_dropped,

-- P90_successful_DT_actual_mins (lower is better)
CASE WHEN current_month.P90_successful_DT_actual_mins << previous_month.P90_successful_DT_actual_mins THEN 1 END AS p90_delivery_time_mom_improved,
CASE WHEN current_month.P90_successful_DT_actual_mins >>= previous_month.P90_successful_DT_actual_mins THEN 1 END AS p90_delivery_time_mom_dropped,

-- orders_on_time_perc (higher is better)
CASE WHEN SAFE_DIVIDE(current_month.cnt_successful_orders_on_time, current_month.non_preorder_successful_order_count) >>= SAFE_DIVIDE(previous_month.cnt_successful_orders_on_time, previous_month.non_preorder_successful_order_count) THEN 1 END AS orders_on_time_mom_improved,
CASE WHEN SAFE_DIVIDE(current_month.cnt_successful_orders_on_time, current_month.non_preorder_successful_order_count) << SAFE_DIVIDE(previous_month.cnt_successful_orders_on_time, previous_month.non_preorder_successful_order_count) THEN 1 END AS orders_on_time_mom_dropped,

-- orders_delivered_more_than_45_mins_perc (lower is better)
CASE WHEN SAFE_DIVIDE(current_month.cnt_successful_orders_more_than_45_mins, current_month.non_preorder_successful_order_count) << SAFE_DIVIDE(previous_month.cnt_successful_orders_more_than_45_mins, previous_month.non_preorder_successful_order_count) THEN 1 END AS orders_more_than_45mins_mom_improved,
CASE WHEN SAFE_DIVIDE(current_month.cnt_successful_orders_more_than_45_mins, current_month.non_preorder_successful_order_count) >>= SAFE_DIVIDE(previous_month.cnt_successful_orders_more_than_45_mins, previous_month.non_preorder_successful_order_count) THEN 1 END AS orders_more_than_45mins_mom_dropped,

-- contact_rate_perc (lower is better, fewer complaints)
CASE WHEN SAFE_DIVIDE(current_month.cnt_contacted_orders, current_month.non_preorder_successful_order_count) << SAFE_DIVIDE(previous_month.cnt_contacted_orders, previous_month.non_preorder_successful_order_count) THEN 1 END AS contact_rate_mom_improved,
CASE WHEN SAFE_DIVIDE(current_month.cnt_contacted_orders, current_month.non_preorder_successful_order_count) >>= SAFE_DIVIDE(previous_month.cnt_contacted_orders, previous_month.non_preorder_successful_order_count) THEN 1 END AS contact_rate_mom_dropped,

-- avg_drop_off_kms (higher is better)
CASE WHEN current_month.avg_drop_off_kms >>= previous_month.avg_drop_off_kms THEN 1 END AS dropoff_distance_mom_improved,
CASE WHEN current_month.avg_drop_off_kms << previous_month.avg_drop_off_kms THEN 1 END AS dropoff_distance_mom_dropped,

-- vfd_savings_perc (higher is better)
CASE WHEN SAFE_DIVIDE(current_month.total_food_successful_vendor_funded_deals_eur, current_month.total_food_successful_gmv_eur) >>= SAFE_DIVIDE(previous_month.total_food_successful_vendor_funded_deals_eur, previous_month.total_food_successful_gmv_eur) THEN 1 END AS vfd_savings_mom_improved,
CASE WHEN SAFE_DIVIDE(current_month.total_food_successful_vendor_funded_deals_eur, current_month.total_food_successful_gmv_eur) << SAFE_DIVIDE(previous_month.total_food_successful_vendor_funded_deals_eur, previous_month.total_food_successful_gmv_eur) THEN 1 END AS vfd_savings_mom_dropped,

-- better_serviceable_areas_overall
CASE WHEN better_metrics_cm.better_serviceable_areas_overall >>= better_metrics_pm.better_serviceable_areas_overall THEN 1 END AS better_serviceable_areas_overall_improved,
CASE WHEN better_metrics_cm.better_serviceable_areas_overall << better_metrics_pm.better_serviceable_areas_overall THEN 1 END AS better_serviceable_areas_overall_dropped,

-- better_serviceable_areas_top50
CASE WHEN better_metrics_cm.better_serviceable_areas_top50 >>= better_metrics_pm.better_serviceable_areas_top50 THEN 1 END AS better_serviceable_areas_top50_improved,
CASE WHEN better_metrics_cm.better_serviceable_areas_top50 << better_metrics_pm.better_serviceable_areas_top50 THEN 1 END AS better_serviceable_areas_top50_dropped,

-- better_pdt_areas_overall
CASE WHEN better_metrics_cm.better_pdt_areas_overall >>= better_metrics_pm.better_pdt_areas_overall THEN 1 END AS better_pdt_areas_overall_improved,
CASE WHEN better_metrics_cm.better_pdt_areas_overall << better_metrics_pm.better_pdt_areas_overall THEN 1 END AS better_pdt_areas_overall_dropped,

-- better_pdt_areas_top50
CASE WHEN better_metrics_cm.better_pdt_areas_top50 >>= better_metrics_pm.better_pdt_areas_top50 THEN 1 END AS better_pdt_areas_top50_improved,
CASE WHEN better_metrics_cm.better_pdt_areas_top50 << better_metrics_pm.better_pdt_areas_top50 THEN 1 END AS better_pdt_areas_top50_dropped,

-- more_affordable_areas_overall
CASE WHEN better_metrics_cm.more_affordable_areas_overall >>= better_metrics_pm.more_affordable_areas_overall THEN 1 END AS more_affordable_areas_overall_improved,
CASE WHEN better_metrics_cm.more_affordable_areas_overall << better_metrics_pm.more_affordable_areas_overall THEN 1 END AS more_affordable_areas_overall_dropped,

-- more_affordable_areas_top50
CASE WHEN better_metrics_cm.more_affordable_areas_top50 >>= better_metrics_pm.more_affordable_areas_top50 THEN 1 END AS more_affordable_areas_top50_improved,
CASE WHEN better_metrics_cm.more_affordable_areas_top50 << better_metrics_pm.more_affordable_areas_top50 THEN 1 END AS more_affordable_areas_top50_dropped,

-- better_delivery_fee_areas_overall
CASE WHEN better_metrics_cm.better_delivery_fee_areas_overall >>= better_metrics_pm.better_delivery_fee_areas_overall THEN 1 END AS better_delivery_fee_areas_overall_improved,
CASE WHEN better_metrics_cm.better_delivery_fee_areas_overall << better_metrics_pm.better_delivery_fee_areas_overall THEN 1 END AS better_delivery_fee_areas_overall_dropped,

-- better_delivery_fee_areas_top50
CASE WHEN better_metrics_cm.better_delivery_fee_areas_top50 >>= better_metrics_pm.better_delivery_fee_areas_top50 THEN 1 END AS better_delivery_fee_areas_top50_improved,
CASE WHEN better_metrics_cm.better_delivery_fee_areas_top50 << better_metrics_pm.better_delivery_fee_areas_top50 THEN 1 END AS better_delivery_fee_areas_top50_dropped

FROM
  `tlb-data-prod.data_platform.agg_performance_mbr_area_monthly` current_month
LEFT JOIN
  all_metrics previous_month
  ON current_month.month_start_date = DATE_ADD(previous_month.month_start_date, INTERVAL 1 MONTH)
  AND current_month.area_name = previous_month.area_name
  AND current_month.city_name = previous_month.city_name
  AND current_month.country_code = previous_month.country_code
  AND current_month.country_name = previous_month.country_name
LEFT JOIN
  better_metrics better_metrics_cm
  ON current_month.month_start_date = better_metrics_cm.month_start_date
  AND current_month.area_name = better_metrics_cm.area_name
  AND current_month.city_name = better_metrics_cm.city_name
  AND current_month.country_code = better_metrics_cm.country_code
  AND current_month.country_name = better_metrics_cm.country_name
LEFT JOIN
  better_metrics better_metrics_pm
  ON current_month.month_start_date = DATE_ADD(better_metrics_pm.month_start_date, INTERVAL 1 MONTH)
  AND current_month.area_name = better_metrics_pm.area_name
  AND current_month.city_name = better_metrics_pm.city_name
  AND current_month.country_code = better_metrics_pm.country_code
  AND current_month.country_name = better_metrics_pm.country_name]]></relation>
