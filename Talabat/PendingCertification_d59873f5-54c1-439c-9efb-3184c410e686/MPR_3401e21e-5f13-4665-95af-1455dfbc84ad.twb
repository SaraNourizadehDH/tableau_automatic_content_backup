    <worksheet name='Topline MoM (4)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='26'>Mo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_performance_mbr_area_monthly (data_platform)' name='federated.0tzzm00186r63b124s07l0zk5sjw' />
          </datasources>
          <datasource-dependencies datasource='federated.0tzzm00186r63b124s07l0zk5sjw'>
            <column caption='Number of days in a month' datatype='integer' name='[Calculation_1280640839231438848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [month_start_date], DATEADD(&apos;month&apos;, 1, [month_start_date]))' />
            </column>
            <column caption='Avg. Daily Orders' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1280640839231619073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cnt_successful_orders]/[Calculation_1280640839231438848]' />
            </column>
            <column caption='M1 Retention' datatype='real' default-format='p0.0%' name='[Calculation_1280640839234232322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[active_customer_lm_tm_count] / [active_customer_lm_count]' />
            </column>
            <column caption='(ZN(AVG([M1 Retention])) - LOOKUP(ZN(AVG([M1 Retention])), -1...' datatype='real' name='[Calculation_1280640839692980228]' role='measure' type='quantitative' user:unnamed='Topline MoM'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_1280640839234232322])) - LOOKUP(ZN(AVG([Calculation_1280640839234232322])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='QC Adoption' datatype='real' default-format='p0.0%' name='[Calculation_4485163065663291393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cnt_qc_successful_customers]/[cnt_successful_customers]' />
            </column>
            <column caption='TPro Customer GMV %' datatype='real' default-format='p0.0%' name='[Calculation_4485163065664983042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tpro_customer_gmv_amount_eur])/SUM([total_successful_gmv_eur])' />
            </column>
            <column caption='Last month date Filter' datatype='boolean' name='[Calculation_4485163065678163978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_start_date] &gt;= DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY())&#10;&#10;THEN TRUE&#10;&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Valid Country Name' datatype='string' name='[Calculation_4659747924076052490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] IN (&apos;overall&apos;, &apos;Unknown&apos;, &apos;Lebanon&apos;, &apos;Invalid&apos;) THEN NULL ELSE [country_name] END' />
            </column>
            <column caption='(ZN(SUM([QC Adoption])) - LOOKUP(ZN(SUM([QC Adoption])), -1))...' datatype='real' name='[Calculation_6614450898462035975]' role='measure' type='quantitative' user:unnamed='Topline MoM'>
