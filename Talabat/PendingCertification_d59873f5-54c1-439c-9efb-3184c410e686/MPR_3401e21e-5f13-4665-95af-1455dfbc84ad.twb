            </column>
            <column caption='Last year month date Filter' datatype='boolean' name='[Calculation_4485163065682190347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([month_start_date] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY()))&#10;    OR (DATEPART(&apos;month&apos;, [month_start_date]) = DATEPART(&apos;month&apos;, TODAY()) - 1&#10;        AND DATEPART(&apos;year&apos;, [month_start_date]) = DATEPART(&apos;year&apos;, TODAY()) - 1)&#10;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Better serviceable areas [Overall]' datatype='real' default-format='p0.0%' name='[Calculation_4485163067618545677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_inventory_open]) / &#10;        SUM(IIF(NOT ISNULL([better_location_inventory_open]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='(ZN(SUM([Better serviceable areas [Overall]]])) - LOOKUP(ZN(S...' datatype='real' name='[Calculation_4659747924071665670]' role='measure' type='quantitative' user:unnamed='Selection YoY'>
