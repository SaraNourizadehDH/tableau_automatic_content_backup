          <datasource-dependencies datasource='federated.0tzzm00186r63b124s07l0zk5sjw'>
            <column caption='Better PDT areas [Top 50]' datatype='real' default-format='p0.0%' name='[Better PDT areas [Overall]] (copy)_6064378379836366849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_pdt_top50]) / &#10;        SUM(IIF(NOT ISNULL([better_location_pdt_top50]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='Better PDT areas [Overall]' datatype='real' default-format='p0.0%' name='[Better serviceable areas [Overall]] (copy)_6064378379835641856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [city_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_pdt]) / &#10;        SUM(IIF(NOT ISNULL([better_location_pdt]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_4485163065659363328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([month_start_date] &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY()))&#10;    OR (DATEPART(&apos;month&apos;, [month_start_date]) = DATEPART(&apos;month&apos;, TODAY()) - 1&#10;        AND DATEPART(&apos;year&apos;, [month_start_date]) = DATEPART(&apos;year&apos;, TODAY()) - 1)&#10;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='% of orders delivered &gt; 45 mins' datatype='real' default-format='p0.0%' name='[Calculation_4485163065666048003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cnt_successful_orders_more_than_45_mins]/[non_preorder_successful_order_count]' />
            </column>
            <column caption='Orders on time%' datatype='real' default-format='p0.0%' name='[Calculation_4485163065667338244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cnt_successful_orders_on_time]/[non_preorder_successful_order_count]' />
            </column>
            <column caption='Contact rate%' datatype='real' default-format='p0.0%' name='[Calculation_4485163065667649541]' role='measure' type='quantitative'>
