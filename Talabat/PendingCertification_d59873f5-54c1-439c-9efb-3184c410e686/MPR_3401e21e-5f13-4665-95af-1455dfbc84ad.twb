          <datasource-dependencies datasource='federated.0tzzm00186r63b124s07l0zk5sjw'>
            <column caption='TPro Customer GMV %' datatype='real' default-format='p0.0%' name='[Calculation_4485163065664983042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tpro_customer_gmv_amount_eur])/SUM([total_successful_gmv_eur])' />
            </column>
            <column caption='Last year month date Filter' datatype='boolean' name='[Calculation_4485163065682190347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([month_start_date] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))&#10;    AND DATEPART(&apos;month&apos;, [month_start_date]) &lt;&gt; DATEPART(&apos;month&apos;, TODAY()))&#10;    OR (DATEPART(&apos;month&apos;, [month_start_date]) = DATEPART(&apos;month&apos;, TODAY()) - 1&#10;        AND DATEPART(&apos;year&apos;, [month_start_date]) = DATEPART(&apos;year&apos;, TODAY()) - 1)&#10;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='(ZN([TPro Customer GMV %]) - LOOKUP(ZN([TPro Customer GMV %])...' datatype='real' name='[Calculation_6614450898465669138]' role='measure' type='quantitative' user:unnamed='Topline YoY'>
              <calculation class='tableau' formula='(ZN([Calculation_4485163065664983042]) - LOOKUP(ZN([Calculation_4485163065664983042]), -1))*100'>
                <table-calc ordering-type='Rows' />
