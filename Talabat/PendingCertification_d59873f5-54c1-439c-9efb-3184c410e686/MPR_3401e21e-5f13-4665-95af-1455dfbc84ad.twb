              <calculation class='tableau' formula='{ FIXED [country_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_affordability]) / &#10;        SUM(IIF(NOT ISNULL([better_location_affordability]), [area_tier_by_sessions_contribution_weight], 0)) }' />
