              <calculation class='tableau' formula='{ FIXED [country_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_inventory_open]) / &#10;        SUM(IIF(NOT ISNULL([better_location_inventory_open]), [area_tier_by_sessions_contribution_weight], 0)) }' />
