              <calculation class='tableau' formula='{ FIXED [country_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_delivery_fee_top50]) / &#10;        SUM(IIF(NOT ISNULL([better_location_delivery_fee_top50]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='Better Delivery Fee areas [Overall] country' datatype='real' default-format='p0.0%' name='[Better PDT areas [Overall]] country (copy)_6064378379839332360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month_start_date]: SUM([area_tier_by_sessions_contribution_weight] * [better_location_delivery_fee]) / &#10;        SUM(IIF(NOT ISNULL([better_location_delivery_fee]), [area_tier_by_sessions_contribution_weight], 0)) }' />
            </column>
            <column caption='(ZN(SUM([More affordable areas [Overall]] country])) - LOOKUP...' datatype='real' name='[Calculation_118923243442110469]' role='measure' type='quantitative' user:unnamed='Value YoY'>
              <calculation class='tableau' formula='(ZN(SUM([More affordable areas [Overall]] (copy)_118923243037626371])) - LOOKUP(ZN(SUM([More affordable areas [Overall]] (copy)_118923243037626371])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN(SUM([More affordable areas vs comp [Top 50]] country])) -...' datatype='real' name='[Calculation_118923243442147334]' role='measure' type='quantitative' user:unnamed='Value YoY'>
