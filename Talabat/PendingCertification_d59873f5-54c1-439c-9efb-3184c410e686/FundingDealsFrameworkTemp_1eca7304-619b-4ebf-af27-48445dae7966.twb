  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Funding Deals Framework'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-197:8196/t/Talabat/workbooks/FundingDealsFrameworkTemp/FundingDealsFramework?rev=' id='FundingDealsFramework' path='/t/Talabat/workbooks/FundingDealsFrameworkTemp' revision='' site='Talabat' />
      <style />
      <size maxheight='1500' maxwidth='1270' minheight='1500' minwidth='1270' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL Query (data_playground_regional_pricing)' name='federated.12051hv1vc2l0r132sxgq1du3n60' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Chart Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chains Distribution&quot;'>
          <calculation class='tableau' formula='&quot;Chains Distribution&quot;' />
          <members>
            <member value='&quot;Chains Distribution&quot;' />
            <member value='&quot;Orders Distribution&quot;' />
            <member value='&quot;TLB BV Funding\%&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.12051hv1vc2l0r132sxgq1du3n60'>
        <column caption='Quadrant' datatype='string' name='[Calculation_265712436144914436]' role='measure' type='nominal'>
          <calculation class='tableau' formula='/*&#10;IF SUM([total_orders]) &gt;= [Median Order Volume]&#10;AND ([GPO]) &gt;= [Median GPO]&#10;THEN &quot;Champions&quot;&#10;&#10;ELSE IF SUM([total_orders]) &lt;= [Median Order Volume]&#10;AND ([GPO]) &gt;= [Median GPO]&#10;THEN &quot;Hidden Gems&quot;&#10;&#10;ELSE IF SUM([total_orders]) &gt;= [Median Order Volume]&#10;AND ([GPO]) &lt;= [Median GPO]&#10;THEN &quot;Volume Drivers&quot;&#10;&#10;ELSE &quot;Low Potential&quot;&#10;END&#10;END&#10;END&#10;*/&#10;&#10;&#10;IF [Calculation_2805813001983303687] &gt;= 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &gt;= 0.5 THEN &quot;Champions&quot;&#10;ELSE IF [Calculation_2805813001983303687] &gt;= 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &lt; 0.5 THEN &quot;Volume Driver&quot;&#10;ELSE IF [Calculation_2805813001983303687] &lt; 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &lt; 0.5 THEN &quot;Low Potential&quot;&#10;ELSE &quot;Hidden Gems&quot;&#10;END&#10;END&#10;END&#10;&#10;//IF [GPO PercRank] &gt;= 0.7 then &apos;cham&apos; else &apos;no&apos; end'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='Chain total orders' datatype='integer' name='[Calculation_265712436301631496]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='{ FIXED [chain_name],[month],[country_code],[city_name],[vertical]:SUM([total_orders])}' />
        </column>
        <column caption='TB Funding DF' datatype='string' name='[Do we currently fund (BV Disc)?  (copy)_4906953335127097356]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF SUM([DF_campaigns_funding_talabat]) &gt; 0 THEN &quot;Yes&quot; &#10;ELSE &quot;No&quot;&#10;END' />
        </column>
        <column caption='Quartile Order Volume' datatype='integer' name='[Quadrant for Summary (copy)_4906953335049875465]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.75) } &#10;THEN 4&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.5) } &#10;THEN 3&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.25) } &#10;THEN 2&#10;&#10;ELSE 1&#10;&#10;END &#10;END&#10;END' />
        </column>
        <column caption='Quartile GPO' datatype='integer' name='[Quartile Volume (copy)_4906953335055040522]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.75) } &#10;THEN 4&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.5) } &#10;THEN 3&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.25) } &#10;THEN 2&#10;&#10;ELSE 1&#10;&#10;END &#10;END&#10;END' />
        </column>
        <column caption='Do we currently fund (BV Disc)? ' datatype='string' name='[Switch funding off? (copy)_2805813002053935116]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF SUM([talabat_incentive_cost_lc]) &gt; 0 THEN &quot;Yes&quot; &#10;ELSE &quot;No&quot;&#10;END' />
        </column>
        <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
