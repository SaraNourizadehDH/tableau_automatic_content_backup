    <worksheet name='Chains Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_playground_regional_pricing)' name='federated.12051hv1vc2l0r132sxgq1du3n60' />
          </datasources>
          <datasource-dependencies datasource='federated.12051hv1vc2l0r132sxgq1du3n60'>
            <column caption='Log Orders' datatype='real' name='[Calculation_1307592062791507968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LN(SUM(total_orders))' />
            </column>
            <column caption='Total GP' datatype='real' name='[Calculation_265712436140544000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([total_df_vat_inc],0) + &#10;IFNULL([service_fee_amount_lc],0) + &#10;IFNULL([small_order_fee_lc],0) + &#10;IFNULL([total_commission_vat_inc],0) + &#10;IFNULL([tpro_commission_lc],0) - &#10;IFNULL([total_cpo1],0)' />
            </column>
            <column caption='Quadrant' datatype='string' name='[Calculation_265712436144914436]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*&#10;IF SUM([total_orders]) &gt;= [Median Order Volume]&#10;AND ([GPO]) &gt;= [Median GPO]&#10;THEN &quot;Champions&quot;&#10;&#10;ELSE IF SUM([total_orders]) &lt;= [Median Order Volume]&#10;AND ([GPO]) &gt;= [Median GPO]&#10;THEN &quot;Hidden Gems&quot;&#10;&#10;ELSE IF SUM([total_orders]) &gt;= [Median Order Volume]&#10;AND ([GPO]) &lt;= [Median GPO]&#10;THEN &quot;Volume Drivers&quot;&#10;&#10;ELSE &quot;Low Potential&quot;&#10;END&#10;END&#10;END&#10;*/&#10;&#10;&#10;IF [Calculation_2805813001983303687] &gt;= 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &gt;= 0.5 THEN &quot;Champions&quot;&#10;ELSE IF [Calculation_2805813001983303687] &gt;= 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &lt; 0.5 THEN &quot;Volume Driver&quot;&#10;ELSE IF [Calculation_2805813001983303687] &lt; 0.5 AND ([Order PercRank (copy)_2805813001986048008]) &lt; 0.5 THEN &quot;Low Potential&quot;&#10;ELSE &quot;Hidden Gems&quot;&#10;END&#10;END&#10;END&#10;&#10;//IF [GPO PercRank] &gt;= 0.7 then &apos;cham&apos; else &apos;no&apos; end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Chain total orders' datatype='integer' name='[Calculation_265712436301631496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [chain_name],[month],[country_code],[city_name],[vertical]:SUM([total_orders])}' />
            </column>
            <column caption='Order Percentile' datatype='real' name='[Calculation_2805813001973497860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//PERCENTILE([total_orders],0.5)&#10;RANK_PERCENTILE(SUM([total_orders]),&apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order PercRank' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2805813001983303687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2805813001973497860] &lt;= 0.25 THEN 0&#10;ELSEIF [Calculation_2805813001973497860] &lt;= 0.5 THEN 0.25&#10;ELSEIF [Calculation_2805813001973497860] &lt;= 0.75 THEN  0.5 &#10;ELSEIF [Calculation_2805813001973497860] &gt; 0.75 THEN  0.75&#10;ELSE 1&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GPO' datatype='real' name='[GP (copy)_265712436140986369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_265712436140544000])/SUM([total_orders])' />
            </column>
            <column caption='Median GPO' datatype='real' name='[Median Order Volume (copy)_265712436141477891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED : MEDIAN(([Calculation_265712436140544000]/[total_orders])) })' />
            </column>
            <column caption='GPO PercRank' datatype='real' default-format='p0%' name='[Order PercRank (copy)_2805813001986048008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Order Percentile (copy)_2805813001976860677] &lt;= 0.25 THEN 0&#10;ELSEIF [Order Percentile (copy)_2805813001976860677] &lt;= 0.5 THEN 0.25&#10;ELSEIF [Order Percentile (copy)_2805813001976860677] &lt;= 0.75 THEN  0.5 &#10;ELSEIF [Order Percentile (copy)_2805813001976860677] &gt; 0.75 THEN  0.75&#10;ELSE 1&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GPO Percentile' datatype='real' name='[Order Percentile (copy)_2805813001976860677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(([GP (copy)_265712436140986369]),&apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Quadrant for Summary' datatype='string' name='[Quadrant (copy)_4906953334814150657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.5) } &#10;AND &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.5) }&#10;THEN &quot;Champions&quot;&#10;&#10;ELSEIF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.5) } &#10;AND &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &lt; &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.5) }&#10;THEN &quot;Volume Driver&quot;&#10;&#10;ELSEIF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &lt; &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.5) } &#10;AND &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &lt; &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.5) }&#10;THEN &quot;Low Potential&quot;&#10;&#10;ELSE &quot;Hidden Gems&quot;&#10;END' />
            </column>
            <column caption='Quartile Order Volume' datatype='integer' name='[Quadrant for Summary (copy)_4906953335049875465]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.75) } &#10;THEN 4&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.5) } &#10;THEN 3&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([total_orders]) }, 0.25) } &#10;THEN 2&#10;&#10;ELSE 1&#10;&#10;END &#10;END&#10;END' />
            </column>
            <column caption='Quartile GPO' datatype='integer' name='[Quartile Volume (copy)_4906953335055040522]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.75) } &#10;THEN 4&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.5) } &#10;THEN 3&#10;&#10;ELSE IF &#10;    { FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) } &gt;= &#10;    { FIXED : PERCENTILE({ FIXED [chain_name] : SUM([Calculation_265712436140544000]) / SUM([total_orders]) }, 0.25) } &#10;THEN 2&#10;&#10;ELSE 1&#10;&#10;END &#10;END&#10;END' />
            </column>
