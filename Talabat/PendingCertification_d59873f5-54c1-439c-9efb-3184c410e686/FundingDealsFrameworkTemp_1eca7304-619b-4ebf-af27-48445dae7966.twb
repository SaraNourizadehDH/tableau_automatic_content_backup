      <column caption='Order PercRank' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2805813001983303687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2805813001973497860] &lt;= 0.25 THEN 0&#10;ELSEIF [Calculation_2805813001973497860] &lt;= 0.5 THEN 0.25&#10;ELSEIF [Calculation_2805813001973497860] &lt;= 0.75 THEN  0.5 &#10;ELSEIF [Calculation_2805813001973497860] &gt; 0.75 THEN  0.75&#10;ELSE 1&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Funding Focus?' datatype='string' name='[Calculation_2805813002051497993]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2805813001983303687] &gt; 0 AND [Order PercRank (copy)_2805813001986048008] &gt; 0.25 THEN &quot;Yes&quot; &#10;ELSE &quot;No&quot;&#10;END'>
