        <calculation class='tableau' formula='IFNULL([total_df_vat_inc],0) + &#10;IFNULL([service_fee_amount_lc],0) + &#10;IFNULL([small_order_fee_lc],0) + &#10;IFNULL([total_commission_vat_inc],0) + &#10;IFNULL([tpro_commission_lc],0) - &#10;IFNULL([total_cpo1],0)' />
