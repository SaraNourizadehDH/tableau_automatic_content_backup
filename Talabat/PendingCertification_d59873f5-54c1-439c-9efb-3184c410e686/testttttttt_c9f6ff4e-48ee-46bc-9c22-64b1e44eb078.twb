      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='March to April' id='_A672A233C79A438A89440EE7E3F0A681'>
            <properties context=''>
              <relation connection='bigquery.1m912qn0ls7axq18jxl3m1h5dm3f' name='Custom SQL Query' type='text'><![CDATA[with riders as (
  SELECT distinct DATE_TRUNC(created_date,MONTH) as created_date
,d.rider_id
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
WHERE LOWER(o.country_code) = 'eg'
AND d.delivery_status = 'completed'
AND zone_id  in (21,2,4,1)
AND DATE(d.created_at, o.timezone) BETWEEN '2025-03-01' AND '2025-03-31'
GROUP BY ALL
 )
 , whs as (
  SELECT 
    DATE_TRUNC(day,MONTH) AS report_date
  ,rider_id
  ,zone_id
  ,count(distinct day) as working_days
  , SUM(d.duration) / 3600 working_hours
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-03-01'
  AND created_date <<= '2025-04-30'
  AND country_code = 'eg'
  AND zone_id in (21,2,4,1)
GROUP BY ALL
 )

 SELECT DATE_TRUNC(report_Date, MONTH) as Month,
 zone_id,
 riders.rider_id,
 SUM(whs.working_hours) as working_hours,
 working_days,
 SUM(whs.working_hours)/working_days as whs
 FROM riders 
 INNER JOIN whs on riders.rider_id = whs.rider_id
 GROUP BY ALL
 ORDER BY 1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
