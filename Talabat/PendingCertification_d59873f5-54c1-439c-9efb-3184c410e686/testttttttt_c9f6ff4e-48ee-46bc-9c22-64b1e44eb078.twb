AND zone_id  in (21,2,4,1)
AND DATE(d.created_at, o.timezone) BETWEEN '2025-04-01' AND '2025-04-30'
GROUP BY ALL
 )
 , whs as (
  SELECT 
    DATE_TRUNC(day,MONTH) AS report_date
  ,rider_id
  ,zone_id
  ,count(distinct day) as working_days
  , SUM(d.duration) / 3600 working_hours
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-04-01'
  AND created_date <<= '2025-05-31'
  AND country_code = 'eg'
  AND zone_id in (21,2,4,1)
GROUP BY ALL
 )

 SELECT DATE_TRUNC(report_Date, MONTH) as Month,
 zone_id,
 riders.rider_id,
 SUM(whs.working_hours) as working_hours,
 working_days,
 SUM(whs.working_hours)/working_days as whs
 FROM riders 
 INNER JOIN whs on riders.rider_id = whs.rider_id
 GROUP BY ALL
 ORDER BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
