      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.005bs1t0z6e4ig1cxcm0v0djfmmr'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='habiba.amr.2@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.005bs1t0z6e4ig1cxcm0v0djfmmr' name='Custom SQL Query' type='text'><![CDATA[with riders as (
  SELECT distinct DATE_TRUNC(created_date,MONTH) as created_date
,d.rider_id
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
WHERE LOWER(o.country_code) = 'eg'
AND d.delivery_status = 'completed'
AND zone_id  in (21,2,4,1)
AND DATE(d.created_at, o.timezone) BETWEEN '2025-04-01' AND '2025-04-30'
GROUP BY ALL
 )
 , whs as (
  SELECT 
    DATE_TRUNC(day,MONTH) AS report_date
  ,rider_id
  ,zone_id
  ,count(distinct day) as working_days
  , SUM(d.duration) / 3600 working_hours
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= '2025-04-01'
  AND created_date <<= '2025-05-31'
  AND country_code = 'eg'
  AND zone_id in (21,2,4,1)
GROUP BY ALL
 )

 SELECT DATE_TRUNC(report_Date, MONTH) as Month,
 zone_id,
 riders.rider_id,
 SUM(whs.working_hours) as working_hours,
 working_days,
 SUM(whs.working_hours)/working_days as whs
 FROM riders 
 INNER JOIN whs on riders.rider_id = whs.rider_id
 GROUP BY ALL
 ORDER BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.005bs1t0z6e4ig1cxcm0v0djfmmr' name='Custom SQL Query' type='text'><![CDATA[with riders as (
  SELECT distinct DATE_TRUNC(created_date,MONTH) as created_date
,d.rider_id
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
WHERE LOWER(o.country_code) = 'eg'
