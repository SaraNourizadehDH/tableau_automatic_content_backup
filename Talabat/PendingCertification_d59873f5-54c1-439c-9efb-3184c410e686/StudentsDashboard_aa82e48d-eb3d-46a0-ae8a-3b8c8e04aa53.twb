)&#13;
&#13;
SELECT &#13;
  Week,&#13;
  age_bucket,&#13;
  Category,&#13;
  zone_name,&#13;
  COUNT(DISTINCT shift_id) AS shifts,&#13;
  SUM(COUNT(DISTINCT shift_id)) OVER (&#13;
    PARTITION BY Week, age_bucket, zone_name&#13;
