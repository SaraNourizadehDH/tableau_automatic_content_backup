    END AS Category,&#13;
    zone_name,&#13;
    CASE &#13;
      WHEN TIMESTAMP_DIFF(DATE(created_date), dlr.birth_date, YEAR) BETWEEN 15 AND 21 THEN &apos;15-21&apos;&#13;
      WHEN TIMESTAMP_DIFF(DATE(created_date), dlr.birth_date, YEAR) BETWEEN 22 AND 29 THEN &apos;22-29&apos;&#13;
      WHEN TIMESTAMP_DIFF(DATE(created_date), dlr.birth_date, YEAR) BETWEEN 30 AND 39 THEN &apos;30-39&apos;&#13;
      WHEN TIMESTAMP_DIFF(DATE(created_date), dlr.birth_date, YEAR) BETWEEN 40 AND 49 THEN &apos;40-49&apos;&#13;
      ELSE &apos;+50&apos; &#13;
    END AS age_bucket,&#13;
    shift_id&#13;
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s&#13;
  LEFT JOIN UNNEST(actual_working_time_by_date) d ON d.status = &apos;ACCEPTED&apos;&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr &#13;
    ON s.rider_id = dlr.rider_id AND dlr.country_code = &apos;eg&apos;&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z &#13;
