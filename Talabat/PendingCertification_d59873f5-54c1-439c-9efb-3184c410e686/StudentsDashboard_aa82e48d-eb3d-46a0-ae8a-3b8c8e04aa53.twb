FROM base&#13;
GROUP BY Week, age_bucket, Category, zone_name</relation>
          <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query6' type='text'>with riders as (&#13;
  SELECT distinct DATE_TRUNC(created_date,week) as week&#13;
 ,created_date &#13;
,d.rider_id&#13;
,dlr.birth_date&#13;
,zone_id&#13;
  ,TIMESTAMP_DIFF(DATE(d.created_at, o.timezone),dlr.birth_date,YEAR ) as age&#13;
from `fulfillment-dwh-production.curated_data_shared.orders`o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
WHERE LOWER(o.country_code) = &apos;eg&apos;&#13;
AND d.delivery_status = &apos;completed&apos;&#13;
AND DATE(d.created_at, o.timezone) BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
GROUP BY ALL&#13;
 )&#13;
 , whs as (&#13;
  SELECT &#13;
    DATE_TRUNC(day,week) AS week&#13;
  ,day as report_date&#13;
  ,rider_id&#13;
  , SUM(d.duration) / 3600 working_hours&#13;
FROM `fulfillment-dwh-production.curated_data_shared.shifts`&#13;
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = &apos;ACCEPTED&apos;&#13;
where shift_state = &apos;EVALUATED&apos;&#13;
  AND created_date  BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
  AND country_code = &apos;eg&apos;&#13;
GROUP BY ALL&#13;
 )&#13;
&#13;
 SELECT created_date, &#13;
 riders.week,&#13;
CASE WHEN age between 15 AND 21 THEN &apos;15-21&apos;&#13;
     WHEN age between 22 AND 29 THEN &apos;22-29&apos;&#13;
     WHEN age between 30 AND 39 THEN &apos;30-39&apos; &#13;
     WHEN age between 40 AND 49 THEN &apos;40-49&apos;&#13;
     ELSE &apos;+50&apos;END age_bucket,&#13;
 zone_name,&#13;
 AVG(whs.working_hours) as avg_whs&#13;
 FROM riders &#13;
 LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone`z on riders.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
 LEFT JOIN whs on riders.rider_id = whs.rider_id&#13;
 GROUP BY ALL&#13;
 ORDER BY 1</relation>
          <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query2' type='text'>SELECT DATE_TRUNC(DATE(d.created_at,o.timezone),DAY) AS DATE,&#13;
EXTRACT (HOUR FROM DATETIME(d.created_at,o.timezone)) AS Hour,&#13;
zone_name,&#13;
COUNT(DISTINCT rider_id) as riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone`z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
WHERE o.country_code = &apos;eg&apos;&#13;
AND DATE(d.created_at,o.timezone) BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
GROUP BY ALL&#13;
ORDER BY 1,2</relation>
          <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query1' type='text'>SELECT week,&#13;
zone_name,&#13;
count(distinct rider_id) as riders,&#13;
CASE WHEN age between 15 AND 21 THEN &apos;15-21&apos;&#13;
     WHEN age between 22 AND 29 THEN &apos;22-29&apos;&#13;
     WHEN age between 30 AND 39 THEN &apos;30-39&apos; &#13;
     WHEN age between 40 AND 49 THEN &apos;40-49&apos;&#13;
     ELSE &apos;+50&apos;END age_bucket&#13;
FROM (&#13;
SELECT&#13;
DATE_TRUNC(DATE(d.created_at,o.timezone),Week) AS Week,&#13;
zone_name,&#13;
d.rider_id,&#13;
TIMESTAMP_DIFF(DATE(d.created_at,o.timezone),dlr.birth_date,YEAR ) as age&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone`z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
WHERE o.country_code = &apos;eg&apos;&#13;
AND DATE(d.created_at,o.timezone) BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
GROUP BY ALL&#13;
ORDER BY 1&#13;
)&#13;
GROUP BY ALL</relation>
          <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query3' type='text'>WITH dataset AS (&#13;
SELECT DATE(d.rider_dropped_off_at, d.timezone) AS report_date&#13;
,zone_id&#13;
,rider_id&#13;
 ,EXTRACT (HOUR FROM  DATETIME(d.rider_dropped_off_at, d.timezone)) as Hour&#13;
 , COUNT(order_id) orders&#13;
 , NULL AS working_hours&#13;
 ,CASE WHEN vehicle.name in (&apos;Bike&apos;, &apos;Starbucks Bike&apos;,&apos;bike&apos;) THEN &apos;Bike&apos;&#13;
     WHEN vehicle.name = &apos;E-Bike&apos; THEN &apos;E-Bike&apos;&#13;
     WHEN vehicle.name in (&apos;Bicycle&apos;, &apos;Walker&apos;,&apos;bicycle&apos;,&apos;walker&apos;) THEN &apos;Bicycles &amp; Walkers&apos;&#13;
     WHEN vehicle.name in (&apos;Car&apos;, &apos;car&apos;, &apos;Groceries&apos;) THEN &apos;Car&apos; &#13;
     ELSE &apos;Unknown&apos; END as vehicle_type,&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o&#13;
LEFT JOIN  UNNEST(deliveries) d ON d.is_primary&#13;
WHERE created_date BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
 AND country_code=&apos;eg&apos;&#13;
 AND d.delivery_status = &apos;completed&apos;&#13;
 GROUP BY ALL&#13;
&#13;
UNION ALL &#13;
&#13;
&#13;
SELECT &#13;
    day AS report_date&#13;
    ,zone_id&#13;
    ,rider_id&#13;
  ,EXTRACT(HOUR FROM DATETIME(actual_start_at,timezone)) AS Hour &#13;
  , NULL AS orders&#13;
  , SUM(d.duration) / 3600 working_hours&#13;
  ,CASE WHEN vehicle_name in (&apos;Bike&apos;, &apos;Starbucks Bike&apos;,&apos;bike&apos;) THEN &apos;Bike&apos;&#13;
     WHEN vehicle_name = &apos;E-Bike&apos; THEN &apos;E-Bike&apos;&#13;
     WHEN vehicle_name in (&apos;Bicycle&apos;, &apos;Walker&apos;,&apos;bicycle&apos;,&apos;walker&apos;) THEN &apos;Bicycles &amp; Walkers&apos;&#13;
     WHEN vehicle_name in (&apos;Car&apos;, &apos;car&apos;, &apos;Groceries&apos;) THEN &apos;Car&apos; &#13;
     ELSE &apos;Unknown&apos; END as vehicle_type,&#13;
FROM `fulfillment-dwh-production.curated_data_shared.shifts`&#13;
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = &apos;ACCEPTED&apos;&#13;
where shift_state = &apos;EVALUATED&apos;&#13;
  AND created_date BETWEEN &apos;2024-01-01&apos; AND CURRENT_DATE - 1 &#13;
  AND country_code = &apos;eg&apos;&#13;
GROUP BY ALL&#13;
)&#13;
, ages as (&#13;
  SELECT distinct dataset.report_date,&#13;
  dataset.rider_id&#13;
  ,TIMESTAMP_DIFF(DATE(report_date),dlr.birth_date,YEAR ) as age&#13;
  FROM dataset&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON dataset.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
)&#13;
&#13;
SELECT DATE_TRUNC(dataset.report_date,WEEK) as week&#13;
  ,dataset.report_date&#13;
  ,zone_name&#13;
  ,CASE WHEN age between 15 AND 21 THEN &apos;15-21&apos;&#13;
     WHEN age between 22 AND 29 THEN &apos;22-29&apos;&#13;
     WHEN age between 30 AND 39 THEN &apos;30-39&apos; &#13;
     WHEN age between 40 AND 49 THEN &apos;40-49&apos;&#13;
     ELSE &apos;+50&apos;END age_bucket&#13;
  , Hour&#13;
  , SUM(orders) AS orders_completed&#13;
  , SUM(working_hours) AS working_hours&#13;
--   ,SUM(orders)/SUM(working_hours) as UTR&#13;
FROM dataset&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone`z on dataset.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
LEFT JOIN ages on dataset.rider_id = ages.rider_id &#13;
WHERE dataset.report_date is not null&#13;
GROUP BY ALL&#13;
ORDER BY 1,2</relation>
          <relation connection='bigquery.093jgly06twl5w12y0obf0bk0eny' name='Custom SQL Query4' type='text'>SELECT month&#13;
,week&#13;
,zone_name&#13;
,CASE WHEN age between 15 AND 21 THEN &apos;15-21&apos;&#13;
     WHEN age between 22 AND 29 THEN &apos;22-29&apos;&#13;
     WHEN age between 30 AND 39 THEN &apos;30-39&apos; &#13;
     WHEN age between 40 AND 49 THEN &apos;40-49&apos;&#13;
     ELSE &apos;+50&apos;END age_bucket&#13;
      , COUNT(DISTINCT rider_id) as riders&#13;
FROM &#13;
(&#13;
  SELECT distinct DATE_TRUNC(DATE(d.created_at, o.timezone),MONTH) as month&#13;
  , DATE_TRUNC(DATE(d.created_at, o.timezone),week) as week&#13;
,zone_name&#13;
,d.rider_id&#13;
,dlr.birth_date&#13;
  ,TIMESTAMP_DIFF(DATE(d.created_at, o.timezone),dlr.birth_date,YEAR ) as age&#13;
from `fulfillment-dwh-production.curated_data_shared.orders`o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone`z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
WHERE LOWER(o.country_code) = &apos;eg&apos;&#13;
AND d.delivery_status = &apos;completed&apos;&#13;
AND DATE(d.created_at, o.timezone) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE-1&#13;
GROUP BY ALL&#13;
)&#13;
GROUP BY ALL</relation>
