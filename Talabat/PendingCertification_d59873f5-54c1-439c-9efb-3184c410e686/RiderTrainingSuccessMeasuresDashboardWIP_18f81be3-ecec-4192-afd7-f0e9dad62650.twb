  <worksheets>
    <worksheet name='City view'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ec662b'>City Overview KPI&apos;s</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_training_success' name='federated.0f93jxq17jp0l219jq8kt1d6okae' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0f93jxq17jp0l219jq8kt1d6okae].[Calculation_2389159644442505228]' caption='End Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-05#'>
              <calculation class='tableau' formula='#2025-03-05#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0f93jxq17jp0l219jq8kt1d6okae].[Max Date (copy)_2389159644442587149]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-12-01#'>
              <calculation class='tableau' formula='#2024-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f93jxq17jp0l219jq8kt1d6okae'>
            <column caption='total_riders' datatype='integer' name='[Calculation_2389159644322435072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='riders_with_first_shift_within_2_days' datatype='integer' name='[Calculation_2389159644325744641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_first_shift_within_2_days] = true then [rider_id] END' />
            </column>
            <column caption='riders_with_100_orders_within_21_days' datatype='integer' name='[Calculation_2389159644326416386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_completed_100_orders_within_21_days] then [rider_id] END' />
            </column>
            <column caption='% Riders with 100 Orders &lt; 21 Days' datatype='real' name='[Calculation_2389159644357513225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2389159644326416386]) / COUNTD([rider_id])' />
