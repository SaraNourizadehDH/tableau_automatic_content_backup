          <datasource-dependencies datasource='federated.0f93jxq17jp0l219jq8kt1d6okae'>
            <column caption='rider_churned_within_30_days' datatype='integer' name='[Calculation_142285645244248064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_churned_within_30_days] = true then&#10;[rider_id] END' />
            </column>
            <column caption='Rider Churn Rate &lt; 30 Days' datatype='real' name='[Calculation_142285645244518401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_142285645244248064]) / COUNTD([rider_id])' />
            </column>
            <column caption='total_riders' datatype='integer' name='[Calculation_2389159644322435072]' role='measure' type='quantitative'>
