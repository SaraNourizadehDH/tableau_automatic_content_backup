          <datasource-dependencies datasource='federated.0f93jxq17jp0l219jq8kt1d6okae'>
            <column caption='total_riders' datatype='integer' name='[Calculation_2389159644322435072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='riders_with_first_shift_within_2_days' datatype='integer' name='[Calculation_2389159644325744641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_first_shift_within_2_days] = true then [rider_id] END' />
            </column>
            <column caption='riders_with_100_orders_within_21_days' datatype='integer' name='[Calculation_2389159644326416386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_completed_100_orders_within_21_days] then [rider_id] END' />
            </column>
            <column caption='% Riders with 100 Orders &lt; 21 Days' datatype='real' name='[Calculation_2389159644357513225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2389159644326416386]) / COUNTD([rider_id])' />
            </column>
            <column caption='% Rider with 1st Shift &lt; 2 Days' datatype='real' name='[Calculation_2389159644360744970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2389159644325744641]) / COUNTD([rider_id])' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2389159644442505228]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='({ MAX([hired_date]) })' />
            </column>
            <column caption='Date RangeFilter' datatype='string' name='[Calculation_3606609292000882688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[hired_date] &gt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Parameter 1])+1)&#10;and [hired_date] &lt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Parameter 1])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[hired_date] &gt;= [Parameters].[Parameter 2] and [hired_date] &lt;= [Parameters].[Parameter 1]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='Min Date' datatype='datetime' name='[Max Date (copy)_2389159644442587149]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, 300, { MIN([hired_date]) })' />
            </column>
