            <column caption='Rider Churn Rate &lt; 30 Days' datatype='real' name='[Calculation_142285645244518401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_142285645244248064]) / COUNTD([rider_id])' />
