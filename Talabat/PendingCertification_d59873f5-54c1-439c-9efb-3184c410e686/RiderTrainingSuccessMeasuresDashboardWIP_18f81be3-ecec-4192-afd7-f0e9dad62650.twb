        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qsof490t8ynjm143qdfb0l52ls6' name='Custom SQL Query' type='text'><![CDATA[-- extract hired riders with their first shift date
WITH hired_riders AS (
    SELECT DISTINCT
        p.rider_id,
        p.country_code,
        DATE(p.hired_stage_completed_at) AS hired_date,
        MIN(s.actual_start_at_local_date) AS first_shift_date,
        MAX(s.actual_start_at_local_date) AS last_shift_date,
    FROM `tlb-data-prod.data_platform_logistics.fct_logistics_rider_applicant` p
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_rider_shift` s
    USING (country_code, rider_id)
    WHERE 
        p.current_stage_name = 'Hired'
        AND DATE(p.hired_stage_completed_at) >>= '2024-01-01' --adjust this date to get the riders for longer period of time
        AND s.shift_state = 'EVALUATED'
    GROUP BY p.rider_id, p.country_code, hired_date
),

-- aggregate total completed logistics orders for each hired rider within 21 days
orders AS (
SELECT 
    h.rider_id,
    h.country_code,
    p.city_name, 
    h.hired_date,
    h.first_shift_date,
    h.last_shift_date,
    COALESCE(SUM(p.total_completed_logistics_orders), 0) AS total_completed_logistics_orders_within_30_days,
    COALESCE(SUM(CASE 
        WHEN p.created_date BETWEEN h.hired_date AND DATE_ADD(h.hired_date, INTERVAL 21 DAY) 
        THEN p.total_completed_logistics_orders 
        ELSE 0 
    END), 0) AS total_completed_logistics_orders_within_21_days
FROM hired_riders h
LEFT JOIN `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance` p
ON h.rider_id = p.rider_id
AND h.country_code = p.country_code
AND p.created_date BETWEEN h.hired_date AND DATE_ADD(h.hired_date, INTERVAL 30 DAY)
GROUP BY h.rider_id, h.country_code, h.hired_date, h.first_shift_date, h.last_shift_date, p.city_name
),

-- count rider contacts within 21 days of hiring
rider_contacts AS (
    SELECT 
        LOWER(e.country_code) AS country_code,
        e.contact_date_local,
        e.rider_id,
        COUNT(DISTINCT e.contact_id) AS rider_contact_count
    FROM `tlb-data-prod.data_platform.fct_contact` e
    LEFT JOIN `tlb-data-prod.data_platform.dim_contact_reason` cr ON e.contact_reason_id = cr.contact_reason_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_contact_stakeholder` g ON e.stakeholder_id = g.contact_stakeholder_id
    INNER JOIN  hired_riders h on e.rider_id = CAST(h.rider_id AS STRING) and lower(e.country_code) = h.country_code 
    WHERE
      contact_date_local between h.hired_date and DATE_ADD(h.hired_date, INTERVAL 21 DAY)
      and contact_stakeholder = 'Rider'
    GROUP BY e.country_code, e.contact_date_local, e.rider_id
),

-- count rider contacts within 21 days of hiring
customer_contacts AS (
     SELECT
      LOWER(e.country_code) as country_code,
      d.rider_id, 
      e.order_id, 
      e.contact_date_local,
      COUNT(DISTINCT contact_id) AS customer_contact_count
    FROM
      `tlb-data-prod.data_platform.fct_contact` e
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_contact_reason` USING (contact_reason_id)
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_contact_stakeholder` g ON e.stakeholder_id = g.contact_stakeholder_id
    LEFT JOIN
      `tlb-data-prod.data_platform.fct_logistics_delivery` d ON e.order_id = CAST(d.order_id AS STRING) and LOWER(e.country_code) = d.country_code 
          INNER JOIN  hired_riders h 
          ON d.rider_id = h.rider_id AND d.country_code = h.country_code 
    WHERE
      contact_date_local between h.hired_date and DATE_ADD(h.hired_date, INTERVAL 21 DAY)
      and contact_stakeholder = 'Customer'
      and LOWER(contact_reason_l2) like '%rider%'
    GROUP BY ALL 
),

aggregated_rider_contacts as 
(   SELECT
      country_code,
      rider_id,
      SUM(rider_contact_count) AS total_rider_contact_count
    FROM
      rider_contacts
    GROUP BY ALL 
),

aggregated_customer_contacts as 
(   SELECT
      country_code,
      rider_id,
      SUM(customer_contact_count) AS total_customer_contact_count
    FROM
      customer_contacts
    GROUP BY ALL 
),

-- cumulative orders within 21 days
cumulative_ordered_data AS (
    SELECT 
        h.rider_id,
        h.country_code,
        h.hired_date,
        h.first_shift_date,
        p.created_date,
        COALESCE(p.total_completed_logistics_orders, 0) AS daily_orders,
        SUM(COALESCE(p.total_completed_logistics_orders, 0)) 
            OVER (PARTITION BY h.rider_id, h.country_code ORDER BY p.created_date) AS cumulative_orders
    FROM hired_riders h
    LEFT JOIN `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance` p
    ON h.rider_id = p.rider_id
    AND h.country_code = p.country_code
    AND p.created_date BETWEEN h.hired_date AND DATE_ADD(h.hired_date, INTERVAL 21 DAY)
),

cumulative_ordered_data_aggregated AS (
    SELECT 
        rider_id,
        country_code,
        hired_date,
        first_shift_date,
        created_date AS first_day_over_100_orders,
        cumulative_orders,
        LAG(cumulative_orders) OVER (PARTITION BY rider_id, country_code ORDER BY created_date) AS prev_cumulative_orders
    FROM cumulative_ordered_data
),

cumulative_agg AS (
SELECT 
    rider_id,
    country_code,
    hired_date,
    first_shift_date,
    first_day_over_100_orders,
    DATE_DIFF(first_day_over_100_orders, hired_date, DAY) as time_to_adoption_100_orders
FROM cumulative_ordered_data_aggregated
WHERE cumulative_orders >> 100 
AND (prev_cumulative_orders IS NULL OR prev_cumulative_orders <<= 100)
),


-- Final query combining orders, rider contacts, and contract status
final_result AS (
    SELECT 
        o.rider_id,
        o.country_code,
        o.city_name,
        o.hired_date,
        o.first_shift_date,
        o.last_shift_date,
        DATE_DIFF(o.first_shift_date, o.hired_date, DAY) AS days_until_first_shift,
        DATE_ADD(o.hired_date, INTERVAL 21 DAY) AS day_21,
        DATE_ADD(o.hired_date, INTERVAL 30 DAY) AS day_30,
        first_day_over_100_orders,
        time_to_adoption_100_orders,
        o.total_completed_logistics_orders_within_30_days,
        o.total_completed_logistics_orders_within_21_days,
        DATE(rc.end_at) as contract_end_date, 
        DATE(dl.last_contract_end_at) as last_contract_end_date,
        total_rider_contact_count,
        total_customer_contact_count,
        COALESCE(dl.last_termiation_type, 
        CASE WHEN is_active = FALSE AND dl.last_termiation_type IS NULL THEN 'VOLUNTARY' 
        ELSE dl.last_termiation_type END) AS last_termination_type,
        CASE WHEN dl.last_termiation_type = 'NON_VOLUNTARY' THEN TRUE ELSE FALSE END AS is_contract_terminated,
        dl.is_active
    FROM orders o
    LEFT JOIN aggregated_rider_contacts rcr
        ON o.country_code = rcr.country_code
        AND CAST(o.rider_id AS STRING)  = rcr.rider_id

    LEFT JOIN aggregated_customer_contacts cu 
        ON o.country_code = cu.country_code
        AND o.rider_id  = cu.rider_id
    
    LEFT JOIN `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` rc
        ON o.rider_id = rc.rider_id
        AND o.country_code = rc.country_code
        AND o.hired_date BETWEEN DATE(rc.start_at) AND DATE(rc.end_at)
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl
        ON o.rider_id = dl.rider_id
        AND o.country_code = dl.country_code
    LEFT JOIN cumulative_agg c
        ON o.country_code = c.country_code
        AND o.rider_id = c.rider_id
    GROUP BY ALL
)


SELECT *,
        CASE 
            WHEN DATE_DIFF(last_shift_date, day_21, DAY) <<0 and is_active = FALSE THEN TRUE 
            ELSE FALSE 
        END AS is_churned_within_21_days,
        CASE 
            WHEN DATE_DIFF(last_shift_date, day_30, DAY) <<0 and is_active = FALSE THEN TRUE 
            ELSE FALSE 
        END AS is_churned_within_30_days,
        CASE 
            WHEN total_completed_logistics_orders_within_30_days >> 0 AND is_active = true THEN FALSE 
            ELSE TRUE 
        END AS is_churned,
        CASE
            WHEN DATE_DIFF(last_shift_date, day_21, DAY) >> 0
            THEN TRUE
            ELSE FALSE
        END AS is_completed_21_days,
        CASE
            WHEN (total_completed_logistics_orders_within_21_days) >>= 100 THEN TRUE
            ELSE FALSE
        END AS is_completed_100_orders_within_21_days,
        CASE
            WHEN DATE_DIFF(first_shift_date, hired_date, DAY) <<= 2 THEN TRUE
            ELSE FALSE
        END AS is_first_shift_within_2_days,
FROM final_result]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qsof490t8ynjm143qdfb0l52ls6' name='Custom SQL Query' type='text'><![CDATA[-- extract hired riders with their first shift date
