            </column>
            <column caption='Date RangeFilter' datatype='string' name='[Calculation_3606609292000882688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[hired_date] &gt;= [Parameters].[Parameter 2]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Parameter 1])+1)&#10;and [hired_date] &lt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2], [Parameters].[Parameter 1])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[hired_date] &gt;= [Parameters].[Parameter 2] and [hired_date] &lt;= [Parameters].[Parameter 1]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
