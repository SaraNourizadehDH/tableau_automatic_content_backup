            <remote-alias>rider_id</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_C8A4E70F6B4545E49E9649F1C9A6DE8E]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
