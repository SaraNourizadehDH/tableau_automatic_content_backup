      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[avg:days_until_first_shift:qk]&quot;' value='Avg. Days until First Shift' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[avg:time_to_adoption_100_orders:qk]&quot;' value='Avg. Time to Adoption in Days (100 Orders)' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[ctd:Calculation_142285645244248064:qk]&quot;' value='Riders Churned &lt; 30 Days' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[ctd:Calculation_2389159644325744641:qk]&quot;' value='Total Riders with 1st Shift &lt; 2 Days' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[ctd:Calculation_2389159644326416386:qk]&quot;' value='Total Riders with 100 Orders &lt; 21 Days' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[sum:total_completed_logistics_orders_within_21_days:qk]&quot;' value='Total Completed Logistics Orders &lt; 21 Days' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[sum:total_completed_logistics_orders:qk]&quot;' value='Total Completed Logistics Orders ' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[sum:total_customer_contact_count:qk]&quot;' value='Total Customer Contacts about Rider' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[sum:total_rider_contact_count:qk]&quot;' value='Total Rider Contacts' />
          <alias key='&quot;[federated.0f93jxq17jp0l219jq8kt1d6okae].[usr:Calculation_2389159644322435072:qk]&quot;' value='Total Number of Riders' />
        </aliases>
      </column>
      <column caption='rider_churned_within_30_days' datatype='integer' name='[Calculation_142285645244248064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_churned_within_30_days] = true then&#10;[rider_id] END' />
      </column>
      <column caption='Rider Churn Rate &lt; 30 Days' datatype='real' name='[Calculation_142285645244518401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_142285645244248064]) / COUNTD([rider_id])' />
      </column>
      <column caption='Date Filter' datatype='string' name='[Calculation_142285645274497027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [hired_date] = DATETRUNC(&apos;day&apos;, [hired_date]) THEN &apos;Selected Period&apos; &#10;ELSEIF [hired_date] = DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;day&apos;, [hired_date])) THEN &apos;Previous Period&apos; &#10;ELSE &apos;Remaining Days&apos;&#10;END' />
      </column>
      <column caption='Hide Null' datatype='boolean' name='[Calculation_142285645274836996]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='window_period_days' datatype='integer' name='[Calculation_142285645280358405]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// [Current Period Day Count]&#10;DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Parameter 1]) + 1' />
      </column>
      <column caption='period group' datatype='string' name='[Calculation_142285645280468998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// [Period Group]&#10;IF [hired_date] &gt;= [Parameters].[Parameter 2]&#10;   AND [hired_date] &lt;= [Parameters].[Parameter 1] THEN&#10;     &quot;Current&quot;&#10;ELSEIF [hired_date] &gt;= DATEADD(&#10;                      &apos;day&apos;,&#10;                      -[Calculation_142285645280358405],&#10;                      [Parameters].[Parameter 2]&#10;                    )&#10;   AND [hired_date] &lt; [Parameters].[Parameter 2] THEN&#10;     &quot;Previous&quot;&#10;END' />
      </column>
      <column caption='Select KPI Calc' datatype='integer' name='[Calculation_142285645285335047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;total_riders&apos; THEN ([Calculation_2389159644322435072])&#10;    WHEN &apos;total_completed_logistics_orders_within_21_days&apos; THEN sum([total_completed_logistics_orders_within_21_days])&#10;    WHEN &apos;total_completed_logistics_orders_within_30_days&apos; THEN sum([total_completed_logistics_orders_within_30_days])    &#10;    WHEN &apos;riders_churned_within_30_days&apos; THEN COUNTD([Calculation_142285645244248064])&#10;    WHEN &apos;rider contacts&apos; THEN sum([total_rider_contact_count])&#10;    WHEN &apos;customer contacts about rider&apos; THEN sum([total_customer_contact_count])&#10;END' />
      </column>
      <column caption='not logged in' datatype='boolean' name='[Calculation_1542905128293830656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([first_shift_date]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='total_riders' datatype='integer' name='[Calculation_2389159644322435072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='riders_with_first_shift_within_2_days' datatype='integer' name='[Calculation_2389159644325744641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_first_shift_within_2_days] = true then [rider_id] END' />
      </column>
      <column caption='riders_with_100_orders_within_21_days' datatype='integer' name='[Calculation_2389159644326416386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_completed_100_orders_within_21_days] then [rider_id] END' />
      </column>
      <column caption='Hiring month' datatype='string' name='[Calculation_2389159644331814917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [hired_date])' />
      </column>
      <column caption='Last 4 months' datatype='boolean' name='[Calculation_2389159644332396551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [hired_date], TODAY()) &lt;= 4' />
      </column>
      <column caption='% Riders with 100 Orders &lt; 21 Days' datatype='real' name='[Calculation_2389159644357513225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2389159644326416386]) / COUNTD([rider_id])' />
      </column>
      <column caption='% Rider with 1st Shift &lt; 2 Days' datatype='real' name='[Calculation_2389159644360744970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2389159644325744641]) / COUNTD([rider_id])' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_2389159644442505228]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='({ MAX([hired_date]) })' />
      </column>
      <column caption='Date Range Filter' datatype='boolean' name='[Calculation_2389159644442849294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[hired_date] &gt;= [Parameters].[Parameter 2] AND [hired_date] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Date RangeFilter' datatype='string' name='[Calculation_3606609292000882688]' role='dimension' type='nominal'>
