    <worksheet name='Pro Users'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Pro Users</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='9'>Pro Users who placed an order using Partner card</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partner + Overall Data' name='federated.1k86kt30hsaytb17lc90l07pjor7' />
          </datasources>
          <datasource-dependencies datasource='federated.1k86kt30hsaytb17lc90l07pjor7'>
            <column caption='Users' datatype='integer' name='[Calculation_767300831842181120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([user_count])' />
            </column>
            <column caption='Pro Users' datatype='integer' name='[Calculation_767300831847149575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([user_count (Custom SQL Query2)])' />
            </column>
            <column caption='Pro Regular' datatype='integer' name='[Calculation_767300831847411720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[pro_type]=&quot;Pro Regular&quot; then [user_count (Custom SQL Query2)] else 0 end)' />
            </column>
            <column caption='Pro Lite' datatype='integer' name='[Calculation_767300831847702537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[pro_type]=&quot;Pro Lite&quot; then [user_count (Custom SQL Query2)] else 0 end)' />
            </column>
            <column caption='Pro Partnership' datatype='integer' name='[Calculation_767300831847784458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pro_type] = &quot;Pro Partnership&quot; THEN [user_count (Custom SQL Query2)] ELSE 0 END)' />
            </column>
            <column caption='Pro User %' datatype='real' name='[Calculation_807551753740992517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_767300831847149575],0)/[Calculation_767300831842181120]' />
            </column>
            <column datatype='string' name='[agg_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[issuing_bank]' role='dimension' type='nominal' />
