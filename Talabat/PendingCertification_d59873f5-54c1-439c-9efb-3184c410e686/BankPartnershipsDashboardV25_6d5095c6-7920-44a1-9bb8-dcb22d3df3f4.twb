      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Targets' id='Sheet1_04A5EEC504AE4A49A64BCCD2409C97CF'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.0sy576r1nc5hvs1drg83o03cejrv' name='Targets' table='[Sheet1$]' type='table'>
                <columns gridOrigin='A1:C169:no:A1:C169:0' header='yes' outcome='2'>
                  <column datatype='string' name='Country' ordinal='0' />
