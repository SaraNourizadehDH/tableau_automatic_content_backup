          <named-connection caption='Bank Partnership Targets' name='cloudfile:googledrive-excel-direct.0sy576r1nc5hvs1drg83o03cejrv'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1aLQstPl8Qpjv0Iox0GGgeiVPXmnha5xeCqxL0AtL8vI' cloudFileMetadata_-_folder='root' cloudFileName='Bank Partnership Targets.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1aLQstPl8Qpjv0Iox0GGgeiVPXmnha5xeCqxL0AtL8vI/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Bank Partnership Targets.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='zehra.saifuddin@talabat.com' validate='no' workgroup-auth-mode='prompt' />
