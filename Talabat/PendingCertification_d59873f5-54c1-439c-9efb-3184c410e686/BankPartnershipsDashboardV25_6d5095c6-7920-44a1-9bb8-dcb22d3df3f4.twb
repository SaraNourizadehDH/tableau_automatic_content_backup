                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Sheet1_04A5EEC504AE4A49A64BCCD2409C97CF' table='[Extract].[Sheet1_04A5EEC504AE4A49A64BCCD2409C97CF]' type='table' />
            </properties>
          </object>
          <object caption='OKR Overview' id='_01BCF4A432B94EF2BF9B5191A6DE3F82'>
            <properties context=''>
              <relation connection='bigquery.1f5r7ki1ib6oh81d586ou02f81xb' name='OKR Overview' type='text'><![CDATA[WITH
  campaign_data AS (
  SELECT
    dic.incentive_campaign_id,
    dic.campaign_name,
    dic.campaign_start_date,
    dic.campaign_end_date,
    mapping.partner,
    SAFE_CAST(mapping.talabat_cofund AS float64) AS tlb_cofund,
    SAFE_CAST(mapping.bank_cofund AS float64) AS partner_cofund
  FROM
    `tlb-data-prod.data_platform.dim_incentive_campaign` dic
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    dic.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` div
  ON
    dic.incentive_campaign_id = div.incentive_campaign_id
  WHERE
    dic.temp_src_id LIKE '%-1-BIN VOUCHER%'
    AND DATE(dic.campaign_start_date) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 15 MONTH),MONTH)
    AND NOT (LOWER(dic.campaign_name) LIKE '%test%'
      OR LOWER(dic.campaign_name) LIKE '%crm%')
  GROUP BY
    ALL),
  raw_orders_data AS (
  SELECT
    campaign_data.*,
    fiod.country_code,
    fiod.order_date,
    fiod.order_id,
    fiod.incentive_amount_eur,
    foi.gmv_amount_eur,
    foi.account_id
  FROM
    campaign_data
  INNER JOIN
    `tlb-data-prod.data_platform.fct_incentive_order_detail` fiod
  ON
    fiod.incentive_campaign_id = campaign_data.incentive_campaign_id
  INNER JOIN
    `tlb-data-prod.data_platform.fct_order_info` foi
  ON
    foi.order_id = fiod.order_id
  WHERE
    (foi.backoffice_comment IS NULL
      OR backoffice_comment = 'N/A')
    AND foi.is_successful
    AND foi.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
    AND CURRENT_DATE()
  GROUP BY
    ALL),
  monthly_data AS (
  SELECT
    country_code,
    order_date,
    partner,
    orders,
    incentive_eur,
    gmv_eur,
    --tlb_cofund,
    --partner_cofund,
  IF
    (tlb_cofund IS NULL,
    IF
      (incentive_eur >> partner_cofund, incentive_eur-partner_cofund, 0),
    IF
      (partner_cofund IS NULL,
      IF
        (tlb_cofund>>1,
        IF
          (tlb_cofund<<incentive_eur, tlb_cofund,incentive_eur-tlb_cofund), incentive_eur*tlb_cofund), NULL ) ) AS estimated_tlb_cofund_eur
  FROM (
    SELECT
      country_code,
      DATE_TRUNC(order_date, MONTH) AS order_date,
      partner,
      COUNT(DISTINCT(order_id)) AS orders,
      SUM(incentive_amount_eur) AS incentive_eur,
      SUM(gmv_amount_eur) AS gmv_eur,
      tlb_cofund,
      partner_cofund
    FROM
      raw_orders_data
    GROUP BY
      ALL) a ),
  monthly_data_country AS (
  SELECT
    country_code,
    order_date,
    "All" AS partner,
    SUM(orders) AS orders,
    SUM(incentive_eur) AS incentive_eur,
    SUM(gmv_eur) AS gmv_eur,
    SUM(estimated_tlb_cofund_eur) AS estimated_tlb_cofund_eur
  FROM
    monthly_data
  GROUP BY
    ALL ),
  gmv_order_data AS (
  SELECT
    *
  FROM
    monthly_data
  UNION ALL
  SELECT
    *
  FROM
    monthly_data_country ),
  monthly_data_users AS (
  SELECT
    country_code,
    DATE_TRUNC(order_date, month) AS order_date,
    partner,
    COUNT(DISTINCT(account_id)) AS users
  FROM
    raw_orders_data
  GROUP BY
    ALL ),
  monthly_data_country_users AS (
  SELECT
    country_code,
    DATE_TRUNC(order_date, month) AS order_date,
    "All" AS partner,
    COUNT(DISTINCT(account_id)) AS users
  FROM
    raw_orders_data
  GROUP BY
    ALL ),
  user_data AS (
  SELECT
    *
  FROM
    monthly_data_users
  UNION ALL
  SELECT
    *
  FROM
    monthly_data_country_users),
  campaign_data_monthly AS (
  SELECT
    div.country_code,
    mapping.partner,
    DATE_TRUNC(DATE(div.created_on_time_lc),MONTH) AS redemption_date,
    COUNT(DISTINCT(div.account_id)) AS unique_redeemers,
    COUNT(div.account_id) AS num_redemptions,
  FROM
    `tlb-data-prod.data_platform.dim_incentive_campaign` dic
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_country_info` dci
  ON
    UPPER(dci.country)=UPPER(dic.country)
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    dic.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` div
  ON
    dic.incentive_campaign_id = div.incentive_campaign_id
  WHERE
    dic.temp_src_id LIKE '%-1-BIN VOUCHER%'
    AND NOT (LOWER(dic.campaign_name) LIKE '%test%'
      OR LOWER(dic.campaign_name) LIKE '%crm%')
    AND DATE(div.created_on_time_lc) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)
  GROUP BY
    ALL),
  campaign_data_monthly_country AS (
  SELECT
    div.country_code,
    "All" AS partner,
    DATE_TRUNC(DATE(div.created_on_time_lc),MONTH) AS redemption_date,
    COUNT(DISTINCT(div.account_id)) AS unique_redeemers,
    COUNT(div.account_id) AS num_redemptions
  FROM
    `tlb-data-prod.data_platform.dim_incentive_campaign` dic
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_country_info` dci
  ON
    UPPER(dci.country)=UPPER(dic.country)
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    dic.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` div
  ON
    dic.incentive_campaign_id = div.incentive_campaign_id
  WHERE
    dic.temp_src_id LIKE '%-1-BIN VOUCHER%'
    AND NOT (LOWER(dic.campaign_name) LIKE '%test%'
      OR LOWER(dic.campaign_name) LIKE '%crm%')
    AND DATE(div.created_on_time_lc) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)
  GROUP BY
    ALL),
  all_redemption_data AS (
  SELECT
    *
  FROM
    campaign_data_monthly
  UNION ALL
  SELECT
    *
  FROM
    campaign_data_monthly_country )
SELECT
  god.*,
  ud.users,
  ard.unique_redeemers,
  ard.num_redemptions
FROM
  gmv_order_data god
LEFT JOIN
  user_data ud
ON
  ud.order_date = god.order_date
  AND ud.partner = god.partner
  AND ud.country_code = god.country_code
LEFT JOIN
  all_redemption_data ard
ON
  god.order_date = ard.redemption_date
  AND ard.partner = god.partner
  AND ard.country_code = god.country_code]]></relation>
            </properties>
