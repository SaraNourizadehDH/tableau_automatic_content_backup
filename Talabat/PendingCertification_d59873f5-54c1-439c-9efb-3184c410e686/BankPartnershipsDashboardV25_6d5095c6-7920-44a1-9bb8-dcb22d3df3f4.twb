    SUM(a.partner_credit_orders) AS partner_credit_orders,&#13;
    SUM(a.partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
    SUM(a.overall_orders) AS overall_orders,&#13;
    SUM(a.overall_gmv_eur) AS overall_gmv_eur,&#13;
    a.agg_type&#13;
  FROM (&#13;
