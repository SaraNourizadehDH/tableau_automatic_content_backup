  monthly_network_bank AS (&#13;
  SELECT&#13;
    a.country_code,&#13;
    DATE_TRUNC(a.rpd_order_date, MONTH) AS order_date,&#13;
    a.network,&#13;
    a.issuing_bank,&#13;
    a.pro_status,&#13;
    SUM(a.partner_orders) AS partner_orders,&#13;
    SUM(a.partner_gmv_eur) AS partner_gmv_eur,&#13;
    SUM(a.partner_credit_orders) AS partner_credit_orders,&#13;
    SUM(a.partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
    SUM(a.overall_orders) AS overall_orders,&#13;
    SUM(a.overall_gmv_eur) AS overall_gmv_eur,&#13;
    a.agg_type&#13;
  FROM (&#13;
    SELECT&#13;
      mrd.country_code,&#13;
      mrd.rpd_order_date,&#13;
      mrd.issuing_bank,&#13;
      mrd.network,&#13;
      mrd.pro_status,&#13;
      mrd.account_id,&#13;
      SUM(mrd.partner_orders) AS partner_orders,&#13;
      SUM(mrd.partner_gmv_eur) AS partner_gmv_eur,&#13;
      SUM(mrd.partner_credit_orders) AS partner_credit_orders,&#13;
      SUM(mrd.partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
      mrd.overall_orders,&#13;
      mrd.overall_gmv_eur,&#13;
      &quot;monthly&quot; AS agg_type&#13;
    FROM&#13;
      monthly_raw_data mrd&#13;
    GROUP BY&#13;
      ALL) a&#13;
  GROUP BY&#13;
    ALL ),&#13;
  monthly_network AS (&#13;
