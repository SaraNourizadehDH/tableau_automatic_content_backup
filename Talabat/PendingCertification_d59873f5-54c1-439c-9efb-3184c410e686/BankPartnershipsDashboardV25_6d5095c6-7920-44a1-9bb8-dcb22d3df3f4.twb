    ON
      tpro.plan_id = plans.plan_id
      AND tpro.country_code = plans.country
      AND NOT (LOWER(plans.plan_name) LIKE '%trial%'
        OR LOWER(plans.plan_name) LIKE '%test%'
        OR LOWER(plans.plan_name) LIKE '%void%'
        OR LOWER(plans.plan_name) LIKE '%project%')
    WHERE
      DATE(fpg.payment_time) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH)
      AND LAST_DAY(DATE_SUB(CURRENT_DATE(),INTERVAL 1 month))
      AND fpg.transaction_type = 'Order'
      AND fpg.is_backend_data
      AND fpg.has_approved_authorisation
      AND fpg.card_wallet_type IS NULL
      AND fpg.card_bin IS NOT NULL
      AND foi.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH)
      AND foi.country_code IN ('AE',
        'BH',
        'EG',
        'IQ',
        'JO',
        'KW',
        'OM',
        'QA')
      AND foi.is_successful
      AND NOT (foi.is_test
        OR foi.is_duplicated_order)
      AND (foi.backoffice_comment IS NULL
        OR foi.backoffice_comment = 'N/A')
    GROUP BY
      ALL ) a
  WHERE
    card_bin IS NOT NULL
  GROUP BY
    ALL),
  issuer_data AS (
  SELECT
    iss.issuer_id,
    CASE
      WHEN LOWER(issuing_bank) LIKE '%nbk%' THEN 'NATIONAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%commercial%' THEN 'ABU DHABI COMMERCIAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%islamic%' THEN 'ABU DHABI ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%ahli%bank%of%kuwait%' THEN 'AHLI BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%ahli%united%bank%' THEN 'AHLI UNITED BANK'
      WHEN issuing_bank IN ( 'Ahli Bank (S.A.O.G)',
      'AHLI BANK (S.A.O.G)',
      'AHLI BANK LTD. (S.A.O.G.)',
      'AHLI BANK Q.S.C.',
      'Ahli Bank Q.S.C.',
      'Al Ahli Bank' ) THEN 'AHLI BANK'
      WHEN LOWER(issuing_bank) LIKE '%alizz%islamic%bank%' THEN 'ALIZZ ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%african%international%bank%' THEN 'ARAB AFRICAN INTERNATIONAL BANK'
      WHEN issuing_bank IN ('ARAB BANK PLC', 'Arab Bank PLC') THEN 'ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%financial%services%company%' THEN 'ARAB FINANCIAL SERVICES COMPANY'
      WHEN LOWER(issuing_bank) LIKE '%arab%payment%services%' THEN 'ARAB PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%bahrain%islamic%bank%' THEN 'BAHRAIN ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%dhofar%' THEN 'BANK DHOFAR'
      WHEN LOWER(issuing_bank) LIKE '%bank%muscat%' THEN 'BANK MUSCAT'
      WHEN LOWER(issuing_bank) LIKE '%bank%nizwa%' THEN 'BANK NIZWA'
      WHEN LOWER(issuing_bank) LIKE '%bank%al%etihad%' THEN 'BANK AL ETIHAD'
      WHEN LOWER(issuing_bank) LIKE '%middle%east%payment%services%' THEN 'MIDDLE EAST PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%capital%bank%' THEN 'CAPITAL BANK'
