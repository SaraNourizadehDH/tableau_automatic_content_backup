        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11bll3y1nav5f91bpraho0m5s3u9' name='Bin-wise Excel' type='text'><![CDATA[WITH
  raw_data AS (
  SELECT
    a.country_code,
    a.card_bin,
    a.issuer_id,
    DATE_TRUNC(a.order_date, month) AS month,
    a.pro_status,
    SUM(a.gmv_amount_eur) AS gmv_eur,
    COUNT(DISTINCT(a.account_id)) AS users,
    COUNT(DISTINCT(a.order_id)) AS orders
  FROM (
    SELECT
      foi.country_code,
      foi.order_date,
      tpro.date,
      fpg.card_bin,
      foi.account_id,
      foi.order_id,
      foi.gmv_amount_eur,
      fpg.issuer_id,
      CASE
        WHEN tpro.account_id IS NULL THEN 'no'
        ELSE 'yes'
    END
      AS pro_status
    FROM
      `tlb-data-prod.data_platform.fct_payment_gateway_transaction` fpg
    INNER JOIN
      `tlb-data-prod.data_platform.fct_order_info` foi
    ON
      CAST(foi.order_id AS string) = fpg.backend_reference
    LEFT JOIN
      `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
    ON
      CAST(tpro.account_id AS STRING) = fpg.customer_account_id
      AND
    IF
      (DATE_TRUNC(DATE(fpg.payment_time), MONTH) <<>> DATE_TRUNC(CURRENT_DATE(),MONTH), LAST_DAY(DATE_TRUNC(DATE(fpg.payment_time),MONTH)) = tpro.date, DATE(EXTRACT(year
          FROM
            DATE(fpg.payment_time)), EXTRACT(month
          FROM
            DATE(fpg.payment_time)), EXTRACT(day
          FROM
            DATE_SUB(CURRENT_DATE(), INTERVAL 1 day))) = tpro.date)
      AND tpro.subscription_state<<>>'BILLING RETRY'
      AND tpro.date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH)
      AND tpro.country_code = fpg.country_code
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_subscription_plan` plans
    ON
      tpro.plan_id = plans.plan_id
      AND tpro.country_code = plans.country
      AND NOT (LOWER(plans.plan_name) LIKE '%trial%'
        OR LOWER(plans.plan_name) LIKE '%test%'
        OR LOWER(plans.plan_name) LIKE '%void%'
        OR LOWER(plans.plan_name) LIKE '%project%')
    WHERE
      DATE(fpg.payment_time) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH)
      AND LAST_DAY(DATE_SUB(CURRENT_DATE(),INTERVAL 1 month))
      AND fpg.transaction_type = 'Order'
      AND fpg.is_backend_data
      AND fpg.has_approved_authorisation
      AND fpg.card_wallet_type IS NULL
      AND fpg.card_bin IS NOT NULL
      AND foi.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH)
      AND foi.country_code IN ('AE',
        'BH',
        'EG',
        'IQ',
        'JO',
        'KW',
        'OM',
        'QA')
      AND foi.is_successful
      AND NOT (foi.is_test
        OR foi.is_duplicated_order)
      AND (foi.backoffice_comment IS NULL
        OR foi.backoffice_comment = 'N/A')
    GROUP BY
      ALL ) a
  WHERE
    card_bin IS NOT NULL
  GROUP BY
    ALL),
  issuer_data AS (
  SELECT
    iss.issuer_id,
    CASE
      WHEN LOWER(issuing_bank) LIKE '%nbk%' THEN 'NATIONAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%commercial%' THEN 'ABU DHABI COMMERCIAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%islamic%' THEN 'ABU DHABI ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%ahli%bank%of%kuwait%' THEN 'AHLI BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%ahli%united%bank%' THEN 'AHLI UNITED BANK'
      WHEN issuing_bank IN ( 'Ahli Bank (S.A.O.G)',
      'AHLI BANK (S.A.O.G)',
      'AHLI BANK LTD. (S.A.O.G.)',
      'AHLI BANK Q.S.C.',
      'Ahli Bank Q.S.C.',
      'Al Ahli Bank' ) THEN 'AHLI BANK'
      WHEN LOWER(issuing_bank) LIKE '%alizz%islamic%bank%' THEN 'ALIZZ ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%african%international%bank%' THEN 'ARAB AFRICAN INTERNATIONAL BANK'
      WHEN issuing_bank IN ('ARAB BANK PLC', 'Arab Bank PLC') THEN 'ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%financial%services%company%' THEN 'ARAB FINANCIAL SERVICES COMPANY'
      WHEN LOWER(issuing_bank) LIKE '%arab%payment%services%' THEN 'ARAB PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%bahrain%islamic%bank%' THEN 'BAHRAIN ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%dhofar%' THEN 'BANK DHOFAR'
      WHEN LOWER(issuing_bank) LIKE '%bank%muscat%' THEN 'BANK MUSCAT'
      WHEN LOWER(issuing_bank) LIKE '%bank%nizwa%' THEN 'BANK NIZWA'
      WHEN LOWER(issuing_bank) LIKE '%bank%al%etihad%' THEN 'BANK AL ETIHAD'
      WHEN LOWER(issuing_bank) LIKE '%middle%east%payment%services%' THEN 'MIDDLE EAST PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%capital%bank%' THEN 'CAPITAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%housing%bank%' THEN 'HOUSING BANK'
      WHEN LOWER(issuing_bank) LIKE '%islamic%international%arab%bank%' THEN 'ISLAMIC INTERNATIONAL ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%jordan%' THEN 'BANK OF JORDAN'
      WHEN LOWER(issuing_bank) LIKE '%jordan%ahli%bank%' THEN 'JORDAN AHLI BANK'
      WHEN LOWER(issuing_bank) LIKE '%invest%bank%plc%' THEN 'INVEST BANK'
      WHEN LOWER(issuing_bank) LIKE '%jordan%islamic%bank%'THEN'JORDAN ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%of%baghdad%' THEN 'BANK OF BAGHDAD'
      WHEN LOWER(issuing_bank) LIKE '%bank%of%bahrain%kuwait%' THEN 'BANK OF BAHRAIN KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%banque%du%caire%' THEN 'BANQUE DU CAIRE'
      WHEN LOWER(issuing_bank) LIKE '%banque%misr%' THEN 'BANQUE MISR'
      WHEN LOWER(issuing_bank) LIKE '%baraka%islamic%bank%' THEN 'BARAKA ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%boubyan%bank%' THEN 'BOUBYAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%burgan%bank%' THEN 'BURGAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%citibank%' THEN 'CITI BANK'
      WHEN LOWER(issuing_bank) LIKE '%commercial%bank%of%kuwait%' THEN 'COMMERCIAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%commercial%bank%of%qatar%' THEN 'COMMERCIAL BANK OF QATAR'
      WHEN LOWER(issuing_bank) LIKE '%commercial%international%bank%' THEN 'COMMERCIAL INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%credimax%' THEN 'CREDIMAX'
      WHEN LOWER(issuing_bank) LIKE '%credit%agricole%egypt%' THEN 'CREDIT AGRICOLE EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%csc%bank%sal%' THEN 'CSC BANK SAL'
      WHEN LOWER(issuing_bank) LIKE '%doha%bank%' THEN 'DOHA BANK'
      WHEN issuing_bank IN ( 'DUBAI ISLAMIC BANK',
      'Dubai Islamic Bank',
      'DUBAI ISLAMIC BANK PJSC' ) THEN 'DUBAI ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%dukhan%bank%' THEN 'DUKHAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%egyptian%banks%company%for%technological%advancements%' THEN 'EGYPT BANKS COMPANY FOR TECHNOLOGICAL ADVANCEMENTS'
      WHEN LOWER(issuing_bank) LIKE '%emirates%islamic%bank%' THEN 'EMIRATES ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%emirates%nbd%' THEN 'EMIRATES NBD'
      WHEN LOWER(issuing_bank) LIKE '%first%abu%dhabi%bank%' THEN 'FIRST ABU DHABI BANK'
      WHEN LOWER(issuing_bank) LIKE '%first%iraqi%islamic%bank%for%investment%and%finance%' THEN 'FIRST IRAQI ISLAMIC BANK FOR INVESTMENT AND FINANCE'
      WHEN issuing_bank IN ( 'GULF BANK K.S.C.', 'GULF BANK K.S.C. THE', 'GULF BANK K.S.C., THE', 'Gulf Bank of Kuwait', 'THE GULF BANK K.S.C.') THEN 'GULF BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%hilal%bank%' THEN 'AL HILAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%hsbc%bank%egypt%' THEN 'HSBC EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%hsbc%bank%middle%east%' THEN 'HSBC MIDDLE EAST'
      WHEN LOWER(issuing_bank) LIKE '%international%network%for%cards%and%digital%payment%service%' THEN 'INTERNATIONAL NETWORK FOR CARDS AND DIGITAL PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%international%smart%card%' THEN 'INTERNATIONAL SMART CARDS'
      WHEN LOWER(issuing_bank) LIKE '%iraq%electronic%gate%for%financial%services%' THEN 'IRAQ ELECTRONIC GATE FOR FINANCIAL SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%kuwait%finance%house%' THEN 'KUWAIT FINANCE HOUSE'
      WHEN LOWER(issuing_bank) LIKE '%kuwait%international%bank%' THEN 'KUWAIT INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%mashreqbank%' THEN 'MASHREQ BANK'
      WHEN LOWER(issuing_bank) LIKE '%masraf%al%rayan%' THEN 'MASRAF AL RAYAN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%bahrain%' THEN 'NATIONAL BANK OF BAHRAIN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%egypt%' THEN 'NATIONAL BANK OF EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%iraq%' THEN 'NATIONAL BANK OF IRAQ'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%kuwait%' THEN 'NATIONAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%oman%' THEN 'NATIONAL BANK OF OMAN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%ras%al%khaimah%' THEN 'RAK BANK'
      WHEN LOWER(issuing_bank) LIKE '%oman%arab%bank%' THEN 'OMAN ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%international%islamic%bank%' THEN 'QATAR INTERNATIONAL ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%islamic%bank%' THEN 'QATAR ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%national%bank%' THEN 'QATAR NATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%rakbank%' THEN 'RAK BANK'
      WHEN LOWER(issuing_bank) LIKE '%salam%bank%bahrain%' THEN 'AL SALAM BANK'
      WHEN LOWER(issuing_bank) LIKE '%sharjah%islamic%bank%' THEN 'SHARJAH ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%sohar%international%bank%' THEN 'SOHAR INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%standard%chartered%bank%' THEN 'STANDARD CHARTERED BANK'
      WHEN LOWER(issuing_bank) LIKE '%trade%bank%of%iraq%' THEN 'TRADE BANK OF IRAQ'
      WHEN LOWER(issuing_bank) LIKE '%tunis%international%bank%' THEN 'TUNIS INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%unknown%' OR issuer_id IS NULL OR issuing_bank IS NULL THEN 'UNKNOWN'
      WHEN LOWER(issuing_bank) LIKE '%warba%bank%' THEN 'WARBA BANK'
      WHEN LOWER(issuing_bank) LIKE '%wells%fargo%' THEN 'WELLS FARGO'
      WHEN LOWER(issuing_bank) LIKE '%yana%banking%services%company%' THEN 'YANA BANKING SERVICES COMPANY'
      ELSE 'OTHER'
  END
    AS issuing_bank
  FROM
    `tlb-data-prod.data_platform.dim_payment_gateway_issuer` iss )
SELECT
  country_code,
  card_bin,
  IFNULL(issuing_bank,'UNKNOWN') AS issuing_bank,
  month,
  pro_status,
  gmv_eur,
  users,
  orders
FROM
  raw_data
LEFT JOIN
  issuer_data
ON
  IFNULL(raw_data.issuer_id,-1) = issuer_data.issuer_id
WHERE
  month<<>> DATE_TRUNC(CURRENT_DATE(),month)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.11bll3y1nav5f91bpraho0m5s3u9' name='Bin-wise Excel' type='text'><![CDATA[WITH
