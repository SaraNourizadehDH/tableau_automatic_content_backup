    COUNT(DISTINCT(a.account_id)) AS users,
    COUNT(DISTINCT(a.order_id)) AS orders
  FROM (
    SELECT
      foi.country_code,
      foi.order_date,
      tpro.date,
      fpg.card_bin,
      foi.account_id,
      foi.order_id,
      foi.gmv_amount_eur,
