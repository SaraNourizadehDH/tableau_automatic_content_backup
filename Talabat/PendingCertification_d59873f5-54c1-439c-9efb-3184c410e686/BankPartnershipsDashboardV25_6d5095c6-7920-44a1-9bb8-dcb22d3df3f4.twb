    <worksheet name='OKR Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>OKR Overview</run>
            <run>Æ&#10;</run>
            <run fontsize='9' italic='true'>Overall performance of bin discount campaigns on talabat&apos;s platform for the last 12 months</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OKR Overview' name='federated.0nwv6360vmzwv71b5yoyi12gyssj' />
          </datasources>
          <datasource-dependencies datasource='federated.0nwv6360vmzwv71b5yoyi12gyssj'>
            <column caption='Usage %' datatype='real' name='[Calculation_430093811782434816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/sum([num_redemptions])' />
            </column>
            <column caption='Target (Discounted GMV)' datatype='integer' name='[Calculation_430093811790245889]' role='measure' type='quantitative'>
