    <worksheet name='Partner Engagement'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontsize='9' italic='true'>Orders placed using the Partner card</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partner + Overall Data' name='federated.1k86kt30hsaytb17lc90l07pjor7' />
          </datasources>
          <datasource-dependencies datasource='federated.1k86kt30hsaytb17lc90l07pjor7'>
            <column caption='Order Frequency (Non Pro Users)' datatype='real' name='[Calculation_14073794882433026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1438900126195339270]-[Calculation_1438900126195503111])/([Calculation_767300831842181120]-[Calculation_767300831847149575])' />
            </column>
            <column caption='Order Frequency (Pro Users)' datatype='real' name='[Calculation_14073794882703363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126195503111]/[Calculation_767300831847149575]' />
            </column>
            <column caption='Overall Orders' datatype='integer' name='[Calculation_1438900126193487874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([overall_orders])' />
            </column>
            <column caption='Partner Orders' datatype='integer' name='[Calculation_1438900126195339270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([partner_orders])' />
            </column>
            <column caption='Partner Orders (Pro Users)' datatype='integer' name='[Calculation_1438900126195503111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pro_status]=&quot;yes&quot; then [partner_orders] end)' />
            </column>
            <column caption='Partner GMV' datatype='real' name='[Calculation_1438900126195875848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partner_gmv_eur])' />
            </column>
            <column caption='Partner GMV (Pro Users)' datatype='real' name='[Calculation_1438900126196039689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [pro_status] = &quot;yes&quot; then [partner_gmv_eur] end)' />
            </column>
            <column caption='Spend Per User (Non Pro Users)' datatype='real' name='[Calculation_1438900126196514826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1438900126195875848]-[Calculation_1438900126196039689])/([Calculation_767300831842181120]-[Calculation_767300831847149575])' />
            </column>
            <column caption='Spend Per User (Pro Users)' datatype='real' name='[Calculation_1438900126196715531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126196039689]/[Calculation_767300831847149575]' />
            </column>
            <column caption='Partner Utilization' datatype='real' name='[Calculation_1438900126199816206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126195339270]/[Calculation_1438900126193487874]' />
            </column>
            <column caption='Users' datatype='integer' name='[Calculation_767300831842181120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([user_count])' />
            </column>
            <column caption='Pro Users' datatype='integer' name='[Calculation_767300831847149575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([user_count (Custom SQL Query2)])' />
            </column>
            <column datatype='string' name='[agg_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
