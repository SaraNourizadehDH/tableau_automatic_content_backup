      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Campaign Level Data' id='_7E3B8EE43BC24EDEB8539E7BD5C743A4'>
            <properties context=''>
              <relation connection='bigquery.0urin3d1g4en8w1c7lwpx13eej18' name='Campaign Level Data' type='text'><![CDATA[WITH
  campaign_data AS (
  SELECT
    div.incentive_campaign_id,
    div.campaign_name,
    div.campaign_start_date_utc,
    div.campaign_end_date_utc,
    mapping.partner,
    div.campaign_id AS campaign_id,
    UPPER(IFNULL(div.generic_voucher_code,"UNIQUE CODES")) AS code,
    SAFE_CAST(mapping.talabat_cofund AS float64) AS tlb_cofund,
    SAFE_CAST(mapping.bank_cofund AS float64) AS partner_cofund,
  IF
    (partner='Mastercard', NULL, bin.bins) AS bin_list
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher` div
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    div.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` divd
  ON
    divd.incentive_campaign_id = div.incentive_campaign_id
  LEFT JOIN
    `tlb-data-prod.data_platform_loyalty.bins_groups` bin
  ON
    bin.id = div.bin_group_id
  WHERE
    div.bin_group_id IS NOT NULL
    AND DATE(div.campaign_end_date_utc) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 15 MONTH),MONTH)
    AND NOT (LOWER(div.campaign_name) LIKE '%test%'
      OR LOWER(div.campaign_name) LIKE '%crm%')
  GROUP BY
    ALL),
  raw_orders_data AS (
  SELECT
    campaign_data.*,
    fiod.country_code,
    fiod.order_date,
    fiod.order_id,
    fiod.incentive_amount_eur,
    foi.gmv_amount_eur,
    foi.account_id
  FROM
    campaign_data
  INNER JOIN
    `tlb-data-prod.data_platform.fct_incentive_order_detail` fiod
  ON
    fiod.incentive_campaign_id = campaign_data.incentive_campaign_id
  INNER JOIN
    `tlb-data-prod.data_platform.fct_order_info` foi
  ON
    foi.order_id = fiod.order_id
  INNER JOIN
    `tlb-data-prod.data_platform.fct_payment_gateway_transaction` fpg
  ON
    fpg.backend_reference = CAST(foi.order_id AS STRING)
  WHERE
    (foi.backoffice_comment IS NULL
      OR foi.backoffice_comment = 'N/A')
    AND foi.is_successful
    AND foi.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
    AND CURRENT_DATE()
    AND fpg.is_backend_data
    AND fpg.has_approved_authorisation
    AND fpg.transaction_type = 'Order'
  GROUP BY
    ALL),
  daily_data AS (
  SELECT
    country_code,
    order_date,
    campaign_name,
    campaign_id,
    bin_list,
    partner,
    code,
    COUNT(DISTINCT(order_id)) AS orders,
    SUM(incentive_amount_eur) AS incentive_eur,
    SUM(gmv_amount_eur) AS gmv_eur,
    "daily" AS agg_type,
    NULL AS estimated_tlb_cofund_eur
  FROM
    raw_orders_data
  WHERE
    order_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
    AND CURRENT_DATE()
  GROUP BY
    ALL ),
  monthly_data AS (
  SELECT
    country_code,
    order_date,
    campaign_name,
    campaign_id,
    bin_list,
    partner,
    code,
    orders,
    incentive_eur,
    gmv_eur,
    agg_type,
    SUM(
    IF
      (tlb_cofund IS NULL,
      IF
        (incentive_eur >> partner_cofund, incentive_eur-partner_cofund, 0),
      IF
        (partner_cofund IS NULL,
        IF
          (tlb_cofund>>1,
          IF
            (tlb_cofund<<incentive_eur, tlb_cofund,incentive_eur-tlb_cofund), incentive_eur*tlb_cofund), NULL ) )) AS estimated_tlb_cofund_eur
  FROM (
    SELECT
      country_code,
      DATE_TRUNC(order_date, month) AS order_date,
      campaign_name,
      campaign_id,
      bin_list,
      partner,
      code,
      SUM(orders) AS orders,
      SUM(incentive_eur) AS incentive_eur,
      SUM(gmv_eur) AS gmv_eur,
      "monthly" AS agg_type,
      tlb_cofund AS tlb_cofund,
      partner_cofund AS partner_cofund
    FROM (
      SELECT
        country_code,
        order_date,
        campaign_name,
        campaign_id,
        bin_list,
        partner,
        code,
        COUNT(DISTINCT(order_id)) AS orders,
        SUM(incentive_amount_eur) AS incentive_eur,
        SUM(gmv_amount_eur) AS gmv_eur,
        COUNT(DISTINCT(account_id)) AS users,
        tlb_cofund,
        partner_cofund
      FROM
        raw_orders_data
      GROUP BY
        ALL) a
    GROUP BY
      ALL )
  GROUP BY
    ALL ),
  all_agg_data AS (
  SELECT
    *
  FROM
    daily_data
  UNION ALL
  SELECT
    *
  FROM
    monthly_data),
  campaign_data_monthly AS (
  SELECT
    divd.country_code,
    mapping.partner,
    div.campaign_name AS campaign_name,
    div.campaign_id AS campaign_id,
    IFNULL(div.generic_voucher_code, "UNIQUE CODES") AS code,
    DATE_TRUNC(DATE(divd.created_on_time_lc),MONTH) AS redemption_date,
    COUNT(DISTINCT(divd.account_id)) AS unique_redeemers,
    COUNT(divd.account_id) AS num_redemptions,
    "monthly" AS agg_type
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher` div
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    div.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` divd
  ON
    div.incentive_campaign_id = divd.incentive_campaign_id
  WHERE
    div.bin_group_id IS NOT NULL
    AND NOT (LOWER(div.campaign_name) LIKE '%test%'
      OR LOWER(div.campaign_name) LIKE '%crm%')
    AND DATE(divd.created_on_time_lc) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)
  GROUP BY
    ALL),
  campaign_data_daily AS (
  SELECT
    divd.country_code,
    mapping.partner,
    div.campaign_name AS campaign_name,
    div.campaign_id AS campaign_id,
    IFNULL(div.generic_voucher_code, "UNIQUE CODES") AS code,
    DATE(divd.created_on_time_lc) AS redemption_date,
    COUNT(DISTINCT(divd.account_id)) AS unique_redeemers,
    COUNT(divd.account_id) AS num_redemptions,
    "daily" AS agg_type
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher` div
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
  ON
    div.campaign_name = mapping.campaign_name
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` divd
  ON
    div.incentive_campaign_id = divd.incentive_campaign_id
  WHERE
    div.bin_group_id IS NOT NULL
    AND NOT (LOWER(div.campaign_name) LIKE '%test%'
      OR LOWER(div.campaign_name) LIKE '%crm%')
    AND DATE(divd.created_on_time_lc) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
  GROUP BY
    ALL),
  all_redemption_data AS (
  SELECT
    *
  FROM
    campaign_data_monthly
  UNION ALL
  SELECT
    *
  FROM
    campaign_data_daily ),
  monthly_data_users AS (
  SELECT
    country_code,
    DATE_TRUNC(order_date, month) AS order_date,
    campaign_name,
    campaign_id,
    "monthly" AS agg_type,
    COUNT(DISTINCT(account_id)) AS users
  FROM
    raw_orders_data
  GROUP BY
    ALL ),
  daily_data_users AS (
  SELECT
    country_code,
    order_date AS order_date,
    campaign_name,
    campaign_id,
    "daily" AS agg_type,
    COUNT(DISTINCT(account_id)) AS users
  FROM
    raw_orders_data
  GROUP BY
    ALL ),
  user_data AS (
  SELECT
    *
  FROM
    monthly_data_users
  UNION ALL
  SELECT
    *
  FROM
    daily_data_users)
SELECT
  agg_data.*,
  IFNULL(redemptions.num_redemptions,0) AS num_redemptions,
  IFNULL(redemptions.unique_redeemers,0) AS unique_redeemers,
  user_data.users
FROM
  all_agg_data agg_data
LEFT JOIN
  all_redemption_data redemptions
ON
  redemptions.country_code = agg_data.country_code
  AND redemptions.redemption_date = agg_data.order_date
  AND redemptions.campaign_name = agg_data.campaign_name
  AND redemptions.campaign_id = agg_data.campaign_id
  AND redemptions.agg_type = agg_data.agg_type
LEFT JOIN
  user_data
ON
  agg_data.country_code = user_data.country_code
  AND agg_data.order_date = user_data.order_date
  AND agg_data.campaign_name = user_data.campaign_name
  AND agg_data.campaign_id = user_data.campaign_id
  AND agg_data.agg_type = user_data.agg_type
GROUP BY
  ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Partner + Overall Data' inline='true' name='federated.1k86kt30hsaytb17lc90l07pjor7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Platform Data' name='bigquery.1xvy9np1y9qdsc1h8enfs1enkql8'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='server-custom' username='zehra.saifuddin@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xvy9np1y9qdsc1h8enfs1enkql8' name='User Segments' type='text'><![CDATA[WITH
  raw_data AS (
  SELECT
    DISTINCT foi1.country_code AS country_code,
    foi1.order_date AS order_date,
    foi1.account_id AS account_id,
    CASE
      WHEN UPPER(fpg.card_network) LIKE '%MASTERCARD%' OR UPPER(fpg.card_network) LIKE '%MAESTRO%'THEN 'MASTERCARD'
      WHEN UPPER(fpg.card_network) LIKE '%VISA%' THEN 'VISA'
      WHEN UPPER(fpg.card_network) LIKE '%KNET%' THEN 'KNET'
      WHEN UPPER(fpg.card_network) LIKE '%AMEX%'
    OR UPPER(fpg.card_network) LIKE '%AMERICAN EXPRES%' THEN 'AMEX'
      WHEN fpg.card_network IS NULL THEN 'UNKNOWN'
      ELSE 'OTHER'
  END
    AS network,
    fpg.issuer_id
  FROM
    `tlb-data-prod.data_platform.fct_payment_gateway_transaction` fpg
  INNER JOIN
    `tlb-data-prod.data_platform.fct_order_info` foi1
  ON
    CAST(foi1.order_id AS string) = fpg.backend_reference
  WHERE
    foi1.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)
    AND fpg.country_code IN ('AE',
      'BH',
      'EG',
      'IQ',
      'JO',
      'KW',
      'OM',
      'QA')
    AND fpg.transaction_type = 'Order'
    AND fpg.is_backend_data
    AND fpg.has_approved_authorisation
    AND fpg.card_wallet_type IS NULL
    AND foi1.is_successful
    AND NOT (foi1.is_test
      OR foi1.is_duplicated_order)
    AND foi1.account_id >> 0
    AND (foi1.backoffice_comment IS NULL
      OR foi1.backoffice_comment = 'N/A')
  GROUP BY
    ALL ),
  issuers_data AS (
  SELECT
    iss.issuer_id,
    CASE
      WHEN LOWER(issuing_bank) LIKE '%nbk%' THEN 'NATIONAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%commercial%' THEN 'ABU DHABI COMMERCIAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%abu%dhabi%islamic%' THEN 'ABU DHABI ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%ahli%bank%of%kuwait%' THEN 'AHLI BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%ahli%united%bank%' THEN 'AHLI UNITED BANK'
      WHEN issuing_bank IN ( 'Ahli Bank (S.A.O.G)',
      'AHLI BANK (S.A.O.G)',
      'AHLI BANK LTD. (S.A.O.G.)',
      'AHLI BANK Q.S.C.',
      'Ahli Bank Q.S.C.',
      'Al Ahli Bank' ) THEN 'AHLI BANK'
      WHEN LOWER(issuing_bank) LIKE '%alizz%islamic%bank%' THEN 'ALIZZ ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%african%international%bank%' THEN 'ARAB AFRICAN INTERNATIONAL BANK'
      WHEN issuing_bank IN ('ARAB BANK PLC', 'Arab Bank PLC') THEN 'ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%arab%financial%services%company%' THEN 'ARAB FINANCIAL SERVICES COMPANY'
      WHEN LOWER(issuing_bank) LIKE '%arab%payment%services%' THEN 'ARAB PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%bahrain%islamic%bank%' THEN 'BAHRAIN ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%dhofar%' THEN 'BANK DHOFAR'
      WHEN LOWER(issuing_bank) LIKE '%bank%muscat%' THEN 'BANK MUSCAT'
      WHEN LOWER(issuing_bank) LIKE '%bank%nizwa%' THEN 'BANK NIZWA'
      WHEN LOWER(issuing_bank) LIKE '%bank%al%etihad%' THEN 'BANK AL ETIHAD'
      WHEN LOWER(issuing_bank) LIKE '%middle%east%payment%services%' THEN 'MIDDLE EAST PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%capital%bank%' THEN 'CAPITAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%housing%bank%' THEN 'HOUSING BANK'
      WHEN LOWER(issuing_bank) LIKE '%islamic%international%arab%bank%' THEN 'ISLAMIC INTERNATIONAL ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%jordan%' THEN 'BANK OF JORDAN'
      WHEN LOWER(issuing_bank) LIKE '%jordan%ahli%bank%' THEN 'JORDAN AHLI BANK'
      WHEN LOWER(issuing_bank) LIKE '%invest%bank%plc%' THEN 'INVEST BANK'
      WHEN LOWER(issuing_bank) LIKE '%jordan%islamic%bank%'THEN'JORDAN ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%bank%of%baghdad%' THEN 'BANK OF BAGHDAD'
      WHEN LOWER(issuing_bank) LIKE '%bank%of%bahrain%kuwait%' THEN 'BANK OF BAHRAIN KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%banque%du%caire%' THEN 'BANQUE DU CAIRE'
      WHEN LOWER(issuing_bank) LIKE '%banque%misr%' THEN 'BANQUE MISR'
      WHEN LOWER(issuing_bank) LIKE '%baraka%islamic%bank%' THEN 'BARAKA ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%boubyan%bank%' THEN 'BOUBYAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%burgan%bank%' THEN 'BURGAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%citibank%' THEN 'CITI BANK'
      WHEN LOWER(issuing_bank) LIKE '%commercial%bank%of%kuwait%' THEN 'COMMERCIAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%commercial%bank%of%qatar%' THEN 'COMMERCIAL BANK OF QATAR'
      WHEN LOWER(issuing_bank) LIKE '%commercial%international%bank%' THEN 'COMMERCIAL INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%credimax%' THEN 'CREDIMAX'
      WHEN LOWER(issuing_bank) LIKE '%credit%agricole%egypt%' THEN 'CREDIT AGRICOLE EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%csc%bank%sal%' THEN 'CSC BANK SAL'
      WHEN LOWER(issuing_bank) LIKE '%doha%bank%' THEN 'DOHA BANK'
      WHEN issuing_bank IN ( 'DUBAI ISLAMIC BANK',
      'Dubai Islamic Bank',
      'DUBAI ISLAMIC BANK PJSC' ) THEN 'DUBAI ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%dukhan%bank%' THEN 'DUKHAN BANK'
      WHEN LOWER(issuing_bank) LIKE '%egyptian%banks%company%for%technological%advancements%' THEN 'EGYPT BANKS COMPANY FOR TECHNOLOGICAL ADVANCEMENTS'
      WHEN LOWER(issuing_bank) LIKE '%emirates%islamic%bank%' THEN 'EMIRATES ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%emirates%nbd%' THEN 'EMIRATES NBD'
      WHEN LOWER(issuing_bank) LIKE '%first%abu%dhabi%bank%' THEN 'FIRST ABU DHABI BANK'
      WHEN LOWER(issuing_bank) LIKE '%first%iraqi%islamic%bank%for%investment%and%finance%' THEN 'FIRST IRAQI ISLAMIC BANK FOR INVESTMENT AND FINANCE'
      WHEN issuing_bank IN ( 'GULF BANK K.S.C.', 'GULF BANK K.S.C. THE', 'GULF BANK K.S.C., THE', 'Gulf Bank of Kuwait', 'THE GULF BANK K.S.C.') THEN 'GULF BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%hilal%bank%' THEN 'AL HILAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%hsbc%bank%egypt%' THEN 'HSBC EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%hsbc%bank%middle%east%' THEN 'HSBC MIDDLE EAST'
      WHEN LOWER(issuing_bank) LIKE '%international%network%for%cards%and%digital%payment%service%' THEN 'INTERNATIONAL NETWORK FOR CARDS AND DIGITAL PAYMENT SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%international%smart%card%' THEN 'INTERNATIONAL SMART CARDS'
      WHEN LOWER(issuing_bank) LIKE '%iraq%electronic%gate%for%financial%services%' THEN 'IRAQ ELECTRONIC GATE FOR FINANCIAL SERVICES'
      WHEN LOWER(issuing_bank) LIKE '%kuwait%finance%house%' THEN 'KUWAIT FINANCE HOUSE'
      WHEN LOWER(issuing_bank) LIKE '%kuwait%international%bank%' THEN 'KUWAIT INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%mashreqbank%' THEN 'MASHREQ BANK'
      WHEN LOWER(issuing_bank) LIKE '%masraf%al%rayan%' THEN 'MASRAF AL RAYAN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%bahrain%' THEN 'NATIONAL BANK OF BAHRAIN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%egypt%' THEN 'NATIONAL BANK OF EGYPT'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%iraq%' THEN 'NATIONAL BANK OF IRAQ'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%kuwait%' THEN 'NATIONAL BANK OF KUWAIT'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%oman%' THEN 'NATIONAL BANK OF OMAN'
      WHEN LOWER(issuing_bank) LIKE '%national%bank%of%ras%al%khaimah%' THEN 'RAK BANK'
      WHEN LOWER(issuing_bank) LIKE '%oman%arab%bank%' THEN 'OMAN ARAB BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%international%islamic%bank%' THEN 'QATAR INTERNATIONAL ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%islamic%bank%' THEN 'QATAR ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%qatar%national%bank%' THEN 'QATAR NATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%rakbank%' THEN 'RAK BANK'
      WHEN LOWER(issuing_bank) LIKE '%salam%bank%bahrain%' THEN 'AL SALAM BANK'
      WHEN LOWER(issuing_bank) LIKE '%sharjah%islamic%bank%' THEN 'SHARJAH ISLAMIC BANK'
      WHEN LOWER(issuing_bank) LIKE '%sohar%international%bank%' THEN 'SOHAR INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%standard%chartered%bank%' THEN 'STANDARD CHARTERED BANK'
      WHEN LOWER(issuing_bank) LIKE '%trade%bank%of%iraq%' THEN 'TRADE BANK OF IRAQ'
      WHEN LOWER(issuing_bank) LIKE '%tunis%international%bank%' THEN 'TUNIS INTERNATIONAL BANK'
      WHEN LOWER(issuing_bank) LIKE '%unknown%' OR issuing_bank IS NULL THEN 'UNKNOWN'
      WHEN LOWER(issuing_bank) LIKE '%warba%bank%' THEN 'WARBA BANK'
      WHEN LOWER(issuing_bank) LIKE '%wells%fargo%' THEN 'WELLS FARGO'
      WHEN LOWER(issuing_bank) LIKE '%yana%banking%services%company%' THEN 'YANA BANKING SERVICES COMPANY'
      ELSE 'OTHER'
  END
    AS issuing_bank
  FROM
    `tlb-data-prod.data_platform.dim_payment_gateway_issuer` iss ),
  raw_data_with_issuer AS (
  SELECT
    DISTINCT country_code,
    order_date,
    account_id,
    network,
    IFNULL(issuing_bank, "UNKNOWN") AS issuing_bank
  FROM
    raw_data
  LEFT JOIN
    issuers_data
  ON
    IFNULL(raw_data.issuer_id,-1) = issuers_data.issuer_id
  GROUP BY
    ALL ),
  raw_data_overall_orders_monthly AS (
  SELECT
    a.*,
    COUNT(DISTINCT(foi.order_id)) AS orders
  FROM (
    SELECT
      rd.country_code,
      DATE_TRUNC(rd.order_date, MONTH) AS order_date,
      rd.account_id,
      rd.network,
      rd.issuing_bank
    FROM
      raw_data_with_issuer rd
    GROUP BY
      ALL ) a
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` foi
  ON
    a.order_date = DATE_TRUNC(foi.order_date,MONTH)
    AND a.account_id = foi.account_id
    AND foi.country_code = a.country_code
  WHERE
    foi.is_successful
    AND NOT (foi.is_test
      OR foi.is_duplicated_order)
    AND foi.backoffice_comment IS NULL
    AND foi.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)
    AND foi.account_id >> 0
  GROUP BY
    ALL ),
  raw_data_monthly AS (
  SELECT
    a.country_code,
    a.order_date,
    a.network,
    a.issuing_bank,
    a.account_id,
    a.orders,
    b.orders_low,
    b.orders_high,
    CASE
      WHEN a.orders = 1 THEN 'One-Timers'
      WHEN a.orders >> 1
    AND a.orders <<= CAST(b.orders_low AS INT64) THEN 'Low'
      WHEN a.orders >> CAST(b.orders_low AS INT64) AND a.orders << CAST(b.orders_high AS INT64) THEN 'Mid'
      WHEN a.orders >>= CAST(b.orders_high AS INT64) THEN 'High'
      ELSE NULL
  END
    AS growth_order_segment,
  IF
    (a.order_date = DATE_TRUNC(c.acquisition_order_date,month), 1, 0) AS acquisition_flag
  FROM
    raw_data_overall_orders_monthly a
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.dim_growth_segmentation_thresholds` b
  ON
    a.country_code = b.country_iso
  LEFT JOIN
    `tlb-data-prod.data_platform.agg_account_profile` c
  ON
    a.country_code = c.registration_country_code
    AND a.account_id = c.account_id ),
  monthly_network_bank AS (
  SELECT
    country_code,
    order_date,
    network,
    issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "monthly" AS agg_type
  FROM
    raw_data_monthly
  GROUP BY
    ALL ),
  monthly_network AS (
  SELECT
    country_code,
    order_date,
    network,
    "All" AS issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "monthly" AS agg_type
  FROM
    raw_data_monthly
  GROUP BY
    ALL ),
  monthly_bank AS (
  SELECT
    country_code,
    order_date,
    "All" AS network,
    issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "monthly" AS agg_type
  FROM
    raw_data_monthly
  GROUP BY
    ALL ),
  monthly_country AS (
  SELECT
    country_code,
    order_date,
    "All" AS network,
    "All" AS issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "monthly" AS agg_type
  FROM
    raw_data_monthly
  GROUP BY
    ALL ),
  raw_data_overall_orders_daily AS (
  SELECT
    a.*,
    COUNT(DISTINCT(foi.order_id)) AS orders
  FROM (
    SELECT
      rd.country_code,
      rd.order_date,
      rd.account_id,
      rd.network,
      rd.issuing_bank
    FROM
      raw_data_with_issuer rd
    WHERE
      rd.order_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
      AND CURRENT_DATE()
    GROUP BY
      ALL ) a
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` foi
  ON
    foi.order_date BETWEEN DATE_SUB(a.order_date, INTERVAL 29 day)
    AND a.order_date
    AND a.account_id = foi.account_id
    AND foi.country_code = a.country_code
  WHERE
    foi.is_successful
    AND NOT (foi.is_test
      OR foi.is_duplicated_order)
    AND foi.backoffice_comment IS NULL
    AND foi.order_date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)AND foi.account_id >> 0
  GROUP BY
    ALL ),
  raw_data_daily AS (
  SELECT
    a.country_code,
    a.order_date,
    a.network,
    a.issuing_bank,
    a.account_id,
    a.orders,
    b.orders_low,
    b.orders_high,
    CASE
      WHEN a.orders = 1 THEN 'One-Timers'
      WHEN a.orders >> 1
    AND a.orders <<= CAST(b.orders_low AS INT64) THEN 'Low'
      WHEN a.orders >> CAST(b.orders_low AS INT64) AND a.orders << CAST(b.orders_high AS INT64) THEN 'Mid'
      WHEN a.orders >>= CAST(b.orders_high AS INT64) THEN 'High'
      ELSE NULL
  END
    AS growth_order_segment,
  IF
    (a.order_date = c.acquisition_order_date, 1, 0) AS acquisition_flag
  FROM
    raw_data_overall_orders_daily a
  LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.dim_growth_segmentation_thresholds` b
  ON
    a.country_code = b.country_iso
  LEFT JOIN
    `tlb-data-prod.data_platform.agg_account_profile` c
  ON
    a.country_code = c.registration_country_code
    AND a.account_id = c.account_id ),
  daily_network_bank AS (
  SELECT
    country_code,
    order_date,
    network,
    issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "daily" AS agg_type
  FROM
    raw_data_daily
  GROUP BY
    ALL ),
  daily_network AS (
  SELECT
    country_code,
    order_date,
    network,
    "All" AS issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "daily" AS agg_type
  FROM
    raw_data_daily
  GROUP BY
    ALL ),
  daily_bank AS (
  SELECT
    country_code,
    order_date,
    "All" AS network,
    issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "daily" AS agg_type
  FROM
    raw_data_daily
  GROUP BY
    ALL ),
  daily_country AS (
  SELECT
    country_code,
    order_date,
    "All" AS network,
    "All" AS issuing_bank,
    growth_order_segment,
    COUNT(DISTINCT(account_id)) AS user_count,
    COUNT(DISTINCT(
      IF
        (acquisition_flag = 1, account_id, NULL) )) AS acquisition_count,
    "daily" AS agg_type
  FROM
    raw_data_daily
  GROUP BY
    ALL ),
  all_agg_data AS (
  SELECT
    *
  FROM
    monthly_network_bank
  UNION ALL
  SELECT
    *
  FROM
    monthly_network
  UNION ALL
  SELECT
    *
  FROM
    monthly_bank
  UNION ALL
  SELECT
    *
  FROM
    monthly_country
  UNION ALL
  SELECT
    *
  FROM
    daily_network_bank
  UNION ALL
  SELECT
    *
  FROM
    daily_network
  UNION ALL
  SELECT
    *
  FROM
    daily_bank
  UNION ALL
  SELECT
    *
  FROM
    daily_country )
SELECT
  *
FROM
  all_agg_data]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1xvy9np1y9qdsc1h8enfs1enkql8' name='Partner + Overall Engagement' type='text'>WITH&#13;
  raw_data AS (&#13;
  SELECT&#13;
    foi1.country_code AS country_code,&#13;
    foi1.order_date AS order_date,&#13;
    foi1.account_id AS account_id,&#13;
    CASE&#13;
      WHEN UPPER(fpg.card_network) LIKE &apos;%MASTERCARD%&apos; OR UPPER(fpg.card_network) LIKE &apos;%MAESTRO%&apos;THEN &apos;MASTERCARD&apos;&#13;
      WHEN UPPER(fpg.card_network) LIKE &apos;%VISA%&apos; THEN &apos;VISA&apos;&#13;
      WHEN UPPER(fpg.card_network) LIKE &apos;%KNET%&apos; THEN &apos;KNET&apos;&#13;
      WHEN UPPER(fpg.card_network) LIKE &apos;%AMEX%&apos;&#13;
    OR UPPER(fpg.card_network) LIKE &apos;%AMERICAN EXPRES%&apos; THEN &apos;AMEX&apos;&#13;
      WHEN fpg.card_network IS NULL THEN &apos;UNKNOWN&apos;&#13;
      ELSE &apos;OTHER&apos;&#13;
  END&#13;
    AS network,&#13;
    fpg.issuer_id,&#13;
    SUM(foi1.gmv_amount_eur) AS partner_gmv_eur,&#13;
    COUNT(DISTINCT(foi1.order_id)) AS partner_orders,&#13;
    SUM(&#13;
    IF&#13;
      (UPPER(fpg.card_type) = &apos;CREDIT&apos;, foi1.gmv_amount_eur,0)) AS partner_credit_gmv_eur,&#13;
    COUNT(DISTINCT(&#13;
      IF&#13;
        (UPPER(fpg.card_type) = &apos;CREDIT&apos;, foi1.order_id, NULL))) AS partner_credit_orders,&#13;
  FROM&#13;
    `tlb-data-prod.data_platform.fct_payment_gateway_transaction` fpg&#13;
  INNER JOIN&#13;
    `tlb-data-prod.data_platform.fct_order_info` foi1&#13;
  ON&#13;
    CAST(foi1.order_id AS string) = fpg.backend_reference&#13;
  WHERE&#13;
    foi1.order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)&#13;
    AND fpg.country_code IN (&apos;AE&apos;,&#13;
      &apos;BH&apos;,&#13;
      &apos;EG&apos;,&#13;
      &apos;IQ&apos;,&#13;
      &apos;JO&apos;,&#13;
      &apos;KW&apos;,&#13;
      &apos;OM&apos;,&#13;
      &apos;QA&apos;)&#13;
    AND fpg.transaction_type = &apos;Order&apos;&#13;
    AND fpg.is_backend_data&#13;
    AND fpg.has_approved_authorisation&#13;
    AND fpg.card_wallet_type IS NULL&#13;
    AND foi1.is_successful&#13;
    AND NOT (foi1.is_test&#13;
      OR foi1.is_duplicated_order)&#13;
    AND foi1.account_id &gt;&gt; 0&#13;
    AND (foi1.backoffice_comment IS NULL&#13;
      OR foi1.backoffice_comment = &apos;N/A&apos;)&#13;
  GROUP BY&#13;
    ALL ),&#13;
  issuers_data AS (&#13;
  SELECT&#13;
    iss.issuer_id,&#13;
    CASE&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%nbk%&apos; THEN &apos;NATIONAL BANK OF KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%abu%dhabi%commercial%&apos; THEN &apos;ABU DHABI COMMERCIAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%abu%dhabi%islamic%&apos; THEN &apos;ABU DHABI ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%ahli%bank%of%kuwait%&apos; THEN &apos;AHLI BANK OF KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%ahli%united%bank%&apos; THEN &apos;AHLI UNITED BANK&apos;&#13;
      WHEN issuing_bank IN ( &apos;Ahli Bank (S.A.O.G)&apos;,&#13;
      &apos;AHLI BANK (S.A.O.G)&apos;,&#13;
      &apos;AHLI BANK LTD. (S.A.O.G.)&apos;,&#13;
      &apos;AHLI BANK Q.S.C.&apos;,&#13;
      &apos;Ahli Bank Q.S.C.&apos;,&#13;
      &apos;Al Ahli Bank&apos; ) THEN &apos;AHLI BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%alizz%islamic%bank%&apos; THEN &apos;ALIZZ ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%arab%african%international%bank%&apos; THEN &apos;ARAB AFRICAN INTERNATIONAL BANK&apos;&#13;
      WHEN issuing_bank IN (&apos;ARAB BANK PLC&apos;, &apos;Arab Bank PLC&apos;) THEN &apos;ARAB BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%arab%financial%services%company%&apos; THEN &apos;ARAB FINANCIAL SERVICES COMPANY&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%arab%payment%services%&apos; THEN &apos;ARAB PAYMENT SERVICES&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bahrain%islamic%bank%&apos; THEN &apos;BAHRAIN ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%dhofar%&apos; THEN &apos;BANK DHOFAR&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%muscat%&apos; THEN &apos;BANK MUSCAT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%nizwa%&apos; THEN &apos;BANK NIZWA&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%al%etihad%&apos; THEN &apos;BANK AL ETIHAD&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%middle%east%payment%services%&apos; THEN &apos;MIDDLE EAST PAYMENT SERVICES&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%capital%bank%&apos; THEN &apos;CAPITAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%housing%bank%&apos; THEN &apos;HOUSING BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%islamic%international%arab%bank%&apos; THEN &apos;ISLAMIC INTERNATIONAL ARAB BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%jordan%&apos; THEN &apos;BANK OF JORDAN&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%jordan%ahli%bank%&apos; THEN &apos;JORDAN AHLI BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%invest%bank%plc%&apos; THEN &apos;INVEST BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%jordan%islamic%bank%&apos;THEN&apos;JORDAN ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%of%baghdad%&apos; THEN &apos;BANK OF BAGHDAD&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%bank%of%bahrain%kuwait%&apos; THEN &apos;BANK OF BAHRAIN KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%banque%du%caire%&apos; THEN &apos;BANQUE DU CAIRE&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%banque%misr%&apos; THEN &apos;BANQUE MISR&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%baraka%islamic%bank%&apos; THEN &apos;BARAKA ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%boubyan%bank%&apos; THEN &apos;BOUBYAN BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%burgan%bank%&apos; THEN &apos;BURGAN BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%citibank%&apos; THEN &apos;CITI BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%commercial%bank%of%kuwait%&apos; THEN &apos;COMMERCIAL BANK OF KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%commercial%bank%of%qatar%&apos; THEN &apos;COMMERCIAL BANK OF QATAR&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%commercial%international%bank%&apos; THEN &apos;COMMERCIAL INTERNATIONAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%credimax%&apos; THEN &apos;CREDIMAX&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%credit%agricole%egypt%&apos; THEN &apos;CREDIT AGRICOLE EGYPT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%csc%bank%sal%&apos; THEN &apos;CSC BANK SAL&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%doha%bank%&apos; THEN &apos;DOHA BANK&apos;&#13;
      WHEN issuing_bank IN ( &apos;DUBAI ISLAMIC BANK&apos;,&#13;
      &apos;Dubai Islamic Bank&apos;,&#13;
      &apos;DUBAI ISLAMIC BANK PJSC&apos; ) THEN &apos;DUBAI ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%dukhan%bank%&apos; THEN &apos;DUKHAN BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%egyptian%banks%company%for%technological%advancements%&apos; THEN &apos;EGYPT BANKS COMPANY FOR TECHNOLOGICAL ADVANCEMENTS&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%emirates%islamic%bank%&apos; THEN &apos;EMIRATES ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%emirates%nbd%&apos; THEN &apos;EMIRATES NBD&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%first%abu%dhabi%bank%&apos; THEN &apos;FIRST ABU DHABI BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%first%iraqi%islamic%bank%for%investment%and%finance%&apos; THEN &apos;FIRST IRAQI ISLAMIC BANK FOR INVESTMENT AND FINANCE&apos;&#13;
      WHEN issuing_bank IN ( &apos;GULF BANK K.S.C.&apos;, &apos;GULF BANK K.S.C. THE&apos;, &apos;GULF BANK K.S.C., THE&apos;, &apos;Gulf Bank of Kuwait&apos;, &apos;THE GULF BANK K.S.C.&apos;) THEN &apos;GULF BANK OF KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%hilal%bank%&apos; THEN &apos;AL HILAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%hsbc%bank%egypt%&apos; THEN &apos;HSBC EGYPT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%hsbc%bank%middle%east%&apos; THEN &apos;HSBC MIDDLE EAST&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%international%network%for%cards%and%digital%payment%service%&apos; THEN &apos;INTERNATIONAL NETWORK FOR CARDS AND DIGITAL PAYMENT SERVICES&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%international%smart%card%&apos; THEN &apos;INTERNATIONAL SMART CARDS&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%iraq%electronic%gate%for%financial%services%&apos; THEN &apos;IRAQ ELECTRONIC GATE FOR FINANCIAL SERVICES&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%kuwait%finance%house%&apos; THEN &apos;KUWAIT FINANCE HOUSE&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%kuwait%international%bank%&apos; THEN &apos;KUWAIT INTERNATIONAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%mashreqbank%&apos; THEN &apos;MASHREQ BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%masraf%al%rayan%&apos; THEN &apos;MASRAF AL RAYAN&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%bahrain%&apos; THEN &apos;NATIONAL BANK OF BAHRAIN&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%egypt%&apos; THEN &apos;NATIONAL BANK OF EGYPT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%iraq%&apos; THEN &apos;NATIONAL BANK OF IRAQ&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%kuwait%&apos; THEN &apos;NATIONAL BANK OF KUWAIT&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%oman%&apos; THEN &apos;NATIONAL BANK OF OMAN&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%national%bank%of%ras%al%khaimah%&apos; THEN &apos;RAK BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%oman%arab%bank%&apos; THEN &apos;OMAN ARAB BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%qatar%international%islamic%bank%&apos; THEN &apos;QATAR INTERNATIONAL ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%qatar%islamic%bank%&apos; THEN &apos;QATAR ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%qatar%national%bank%&apos; THEN &apos;QATAR NATIONAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%rakbank%&apos; THEN &apos;RAK BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%salam%bank%bahrain%&apos; THEN &apos;AL SALAM BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%sharjah%islamic%bank%&apos; THEN &apos;SHARJAH ISLAMIC BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%sohar%international%bank%&apos; THEN &apos;SOHAR INTERNATIONAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%standard%chartered%bank%&apos; THEN &apos;STANDARD CHARTERED BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%trade%bank%of%iraq%&apos; THEN &apos;TRADE BANK OF IRAQ&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%tunis%international%bank%&apos; THEN &apos;TUNIS INTERNATIONAL BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%unknown%&apos; OR issuing_bank IS NULL THEN &apos;UNKNOWN&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%warba%bank%&apos; THEN &apos;WARBA BANK&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%wells%fargo%&apos; THEN &apos;WELLS FARGO&apos;&#13;
      WHEN LOWER(issuing_bank) LIKE &apos;%yana%banking%services%company%&apos; THEN &apos;YANA BANKING SERVICES COMPANY&apos;&#13;
      ELSE &apos;OTHER&apos;&#13;
  END&#13;
    AS issuing_bank&#13;
  FROM&#13;
    `tlb-data-prod.data_platform.dim_payment_gateway_issuer` iss ),&#13;
  raw_data_with_issuer AS (&#13;
  SELECT&#13;
    country_code,&#13;
    order_date,&#13;
    account_id,&#13;
    network,&#13;
    IFNULL(issuing_bank, &quot;UNKNOWN&quot;) AS issuing_bank,&#13;
    SUM(partner_gmv_eur) AS partner_gmv_eur,&#13;
    SUM(partner_orders) AS partner_orders,&#13;
    SUM(partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
    SUM(partner_credit_orders) AS partner_credit_orders&#13;
  FROM&#13;
    raw_data&#13;
  LEFT JOIN&#13;
    issuers_data&#13;
  ON&#13;
    IFNULL(raw_data.issuer_id,-1) = issuers_data.issuer_id&#13;
  GROUP BY&#13;
    ALL ),&#13;
  raw_data_overall_orders_daily AS (&#13;
  SELECT&#13;
    rd.country_code,&#13;
    rd.order_date,&#13;
    rd.account_id,&#13;
    rd.network,&#13;
    rd.issuing_bank,&#13;
    rd.partner_orders,&#13;
    rd.partner_gmv_eur,&#13;
    rd.partner_credit_orders,&#13;
    rd.partner_credit_gmv_eur,&#13;
    SUM(foi.gmv_amount_eur) AS overall_gmv_eur,&#13;
    COUNT(DISTINCT(foi.order_id)) AS overall_orders,&#13;
    &quot;daily&quot; AS agg_type&#13;
  FROM&#13;
    raw_data_with_issuer rd&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform.fct_order_info` foi&#13;
  ON&#13;
    rd.order_date = foi.order_date&#13;
    AND rd.account_id = foi.account_id&#13;
    AND foi.country_code = rd.country_code&#13;
  WHERE&#13;
    foi.is_successful&#13;
    AND NOT (foi.is_test&#13;
      OR foi.is_duplicated_order)&#13;
    AND (foi.backoffice_comment IS NULL&#13;
      OR foi.backoffice_comment = &apos;N/A&apos;)&#13;
    AND foi.order_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)&#13;
    AND rd.order_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)&#13;
  GROUP BY&#13;
    ALL ),&#13;
  raw_data_overall_orders_monthly AS (&#13;
  SELECT&#13;
    a.*,&#13;
    SUM(foi.gmv_amount_eur) AS overall_gmv_eur,&#13;
    COUNT(DISTINCT(foi.order_id)) AS overall_orders,&#13;
    &quot;monthly&quot; AS agg_type&#13;
  FROM (&#13;
    SELECT&#13;
      rd.country_code,&#13;
      DATE_TRUNC(rd.order_date, MONTH) AS order_date,&#13;
      rd.account_id,&#13;
      rd.network,&#13;
      rd.issuing_bank,&#13;
      SUM(rd.partner_orders) AS partner_orders,&#13;
      SUM(rd.partner_gmv_eur) AS partner_gmv_eur,&#13;
      SUM(rd.partner_credit_orders) AS partner_credit_orders,&#13;
      SUM(rd.partner_credit_gmv_eur) AS partner_credit_gmv_eur&#13;
    FROM&#13;
      raw_data_with_issuer rd&#13;
    GROUP BY&#13;
      ALL ) a&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform.fct_order_info` foi&#13;
  ON&#13;
    a.order_date = DATE_TRUNC(foi.order_date,MONTH)&#13;
    AND a.account_id = foi.account_id&#13;
    AND foi.country_code = a.country_code&#13;
  WHERE&#13;
    foi.is_successful&#13;
    AND NOT (foi.is_test&#13;
      OR foi.is_duplicated_order)&#13;
    AND (foi.backoffice_comment IS NULL&#13;
      OR foi.backoffice_comment = &apos;N/A&apos;)&#13;
    AND foi.order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH),MONTH)&#13;
  GROUP BY&#13;
    ALL ),&#13;
  raw_data_overall_orders AS (&#13;
  SELECT&#13;
    *&#13;
  FROM&#13;
    raw_data_overall_orders_daily&#13;
  UNION ALL&#13;
  SELECT&#13;
    *&#13;
  FROM&#13;
    raw_data_overall_orders_monthly),&#13;
  raw_pro_data AS (&#13;
  SELECT&#13;
    DISTINCT r.*,&#13;
  IF&#13;
    (tpro.is_subscription_active&#13;
      AND NOT (tpro.is_billing_retry&#13;
        OR tpro.is_free_trial&#13;
        OR tpro.is_churned), &quot;yes&quot;,&quot;no&quot;) AS pro_status,&#13;
    tpro.date&#13;
  FROM&#13;
    raw_data_overall_orders r&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro&#13;
  ON&#13;
    tpro.account_id = r.account_id&#13;
    AND&#13;
  IF&#13;
    (agg_type = &apos;daily&apos;,r.order_date = tpro.date,&#13;
    IF&#13;
      (DATE_TRUNC(CURRENT_DATE(),MONTH) = order_date, DATE_SUB(CURRENT_DATE(), INTERVAL 1 day) = tpro.date, LAST_DAY(order_date)=tpro.date))&#13;
    AND tpro.country_code = r.country_code ),&#13;
  daily_network_bank AS (&#13;
  SELECT&#13;
    s.country_code,&#13;
    s.order_date,&#13;
    s.network,&#13;
    s.issuing_bank,&#13;
