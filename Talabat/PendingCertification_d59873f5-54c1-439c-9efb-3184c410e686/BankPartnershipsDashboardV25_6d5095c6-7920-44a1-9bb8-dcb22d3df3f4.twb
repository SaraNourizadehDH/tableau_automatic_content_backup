    SUM(s.partner_orders) AS partner_orders,&#13;
    SUM(s.partner_gmv_eur) AS partner_gmv_eur,&#13;
    SUM(s.partner_credit_orders) AS partner_credit_orders,&#13;
    SUM(s.partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
    SUM(s.overall_orders) AS overall_orders,&#13;
