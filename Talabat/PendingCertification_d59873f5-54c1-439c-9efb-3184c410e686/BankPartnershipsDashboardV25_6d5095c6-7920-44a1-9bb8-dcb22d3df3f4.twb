    GROUP BY&#13;
      ALL) s&#13;
  GROUP BY&#13;
    ALL),&#13;
  daily_country AS (&#13;
  SELECT&#13;
    s.country_code,&#13;
    s.order_date,&#13;
    &quot;All&quot; AS network,&#13;
    &quot;All&quot; AS issuing_bank,&#13;
    s.pro_status,&#13;
    SUM(partner_orders) AS partner_orders,&#13;
    SUM(partner_gmv_eur) AS partner_gmv,&#13;
    SUM(partner_credit_orders) AS partner_credit_orders,&#13;
    SUM(partner_credit_gmv_eur) AS partner_credit_gmv_eur,&#13;
    SUM(s.overall_orders) AS overall_orders,&#13;
    SUM(s.overall_gmv_eur) AS overall_gmv_eur,&#13;
    &quot;daily&quot; AS agg_type&#13;
  FROM (&#13;
    SELECT&#13;
      country_code,&#13;
