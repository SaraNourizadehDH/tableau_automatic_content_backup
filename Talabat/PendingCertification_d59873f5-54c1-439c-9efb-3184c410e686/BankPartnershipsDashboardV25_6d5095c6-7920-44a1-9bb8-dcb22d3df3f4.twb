    <worksheet name='Partner Share'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Partner Share</run>
            <run>Æ&#10;</run>
            <run fontsize='9' italic='true'>Out of all Platform online Orders via saved cards (excludes Apple Pay)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partner + Overall Data' name='federated.1k86kt30hsaytb17lc90l07pjor7' />
          </datasources>
          <datasource-dependencies datasource='federated.1k86kt30hsaytb17lc90l07pjor7'>
            <column caption='Overall Orders (Pro Users)' datatype='integer' name='[Calculation_1438900126192181248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pro_status]=&quot;yes&quot; then [overall_orders]END)' />
            </column>
            <column caption='Overall GMV (Pro Users)' datatype='real' name='[Calculation_1438900126193197057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pro_status]=&quot;yes&quot; then [overall_gmv_eur] end)' />
            </column>
            <column caption='Overall Orders' datatype='integer' name='[Calculation_1438900126193487874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([overall_orders])' />
            </column>
            <column caption='Overall GMV' datatype='real' name='[Calculation_1438900126193602563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([overall_gmv_eur])' />
            </column>
            <column caption='Spend per User (Overall Orders) (Non Pro Users)' datatype='real' name='[Calculation_1438900126194499588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1438900126193602563]-[Calculation_1438900126193197057])/([Calculation_767300831842181120]-[Calculation_767300831847149575])' />
            </column>
            <column caption='Spend per User (Overall Orders) (Pro Users)' datatype='real' name='[Calculation_1438900126194692101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126193197057]/[Calculation_767300831847149575]' />
            </column>
            <column caption='Partner Orders' datatype='integer' name='[Calculation_1438900126195339270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([partner_orders])' />
            </column>
            <column caption='Partner GMV' datatype='real' name='[Calculation_1438900126195875848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partner_gmv_eur])' />
            </column>
            <column caption='Partner Utilization' datatype='real' name='[Calculation_1438900126199816206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126195339270]/[Calculation_1438900126193487874]' />
            </column>
            <column caption='Partner Orders Fixed' datatype='integer' name='[Calculation_1438900126200479759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[country_code],[order_date],[agg_type]: SUM(IF [issuing_bank] =&quot;All&quot; AND [network]= &quot;All&quot; THEN [partner_orders] ELSE 0 END)}' />
            </column>
            <column caption='Partner Order Share' datatype='real' name='[Calculation_1438900126207365137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126195339270]/sum([Calculation_1438900126200479759])' />
            </column>
            <column caption='Partner Orders GMV Fixed' datatype='real' name='[Calculation_1438900126208438290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[country_code],[order_date],[agg_type]: SUM(IF [issuing_bank] =&quot;All&quot; AND [network]= &quot;All&quot; THEN [partner_gmv_eur] ELSE 0 END)}' />
            </column>
            <column caption='Partner GMV Share' datatype='real' name='[Calculation_1438900126208741395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1438900126195875848]/sum([Calculation_1438900126208438290])' />
            </column>
            <column caption='Partner Orders Credit' datatype='integer' name='[Calculation_1438900126209380372]' role='measure' type='quantitative'>
