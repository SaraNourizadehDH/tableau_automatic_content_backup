            <column caption='AWT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906621628416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avoidable_wait_time_min] / 60.0)/sum([total_orders])' />
            </column>
            <column caption='HBT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906621767681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hold_back_time_min]/60)/SUM([total_orders])' />
            </column>
            <column caption='Assumed Actual PT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906621894658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avg_fir_pt_min])/sum([fir_cnt])' />
            </column>
            <column caption='EPT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906621984771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_prep_time_min])/SUM([total_orders])' />
            </column>
            <column caption='DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906622046212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([DT]/60)/sum([total_orders])' />
            </column>
            <column caption='PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906622119941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt]/60)/SUM([total_orders])' />
            </column>
            <column caption='TCT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4884364906622181382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time_min]/60)/SUM([total_orders])' />
            </column>
            <column caption='%FIR Used' datatype='real' default-format='p0.0%' name='[Calculation_4884364906627547144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([fir_used_orders]/[total_orders])' />
            </column>
            <column caption='%FIR Confident' datatype='real' default-format='p0.0%' name='[Calculation_4884364906627809289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([fir_conf_orders]/[fir_used_orders])' />
            </column>
            <column caption='Vendor Prep Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5094063786210426880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_prep])/SUM([total_orders])' />
            </column>
            <column caption='TVT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6524027032671686662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tvt_min])/SUM([total_orders])' />
            </column>
            <column caption='Queue Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6524027032671731719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([queue_time_min])/SUM([total_orders])' />
            </column>
            <column caption='Rider Acceptance Time' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_6524027032671936520]' role='measure' type='quantitative'>
