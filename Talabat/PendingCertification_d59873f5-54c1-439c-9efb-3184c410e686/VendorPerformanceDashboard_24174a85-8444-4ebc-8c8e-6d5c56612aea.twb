                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Country&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The prep time startegy of the vendor, at the time of order created, select latest date range to view the latest performance by startegy&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Prep Time Strategy&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;To adjust the timeline for sepecific period data&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Date Range&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;To view the chart either on day level or week or month&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Granularity&quot;' />
                      </groupfilter>
                    </groupfilter>
                  </groupfilter>
                  <groupfilter function='crossjoin'>
                    <groupfilter function='member' level='[none:Type:nk]' member='&quot;Metric&quot;' />
                    <groupfilter function='union'>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Average Assumed Actual Prep Time for each country/vertical for the selected date range (as per filters)&#10;The AAPT is calculated by DH using the same logic and filters as the EPT model logic&#10;sum(AAPT)/total completed orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Assumed Actual Prep Time&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Average Delivery Time for each country/vertical for the selected date range (as per filters)&#10;sum(DT)/total completed orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;DT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Average Estimated Prep Time for each country/vertical for the selected date range (as per filters)&#10;sum(EPT)/total completed orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;EPT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;FIR Confident Orders/FIR Used Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;\%FIR Confidence&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;FIR Used Orders/Completed Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;\%FIR Used&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Hold Back Time, the time for which order is held before sending to vendor.&#10;sum(HBT)/Total completed Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;HBT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Our definition/calculation of actual prep time taken by vendors to prep the orders.&#10;Logic: if FIR is confident then FIR Prep Time, else Rider picked up- order sent to vendor&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Vendor Prep time&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Out of total completed orders, for how many of them vendors used the &apos;Food is Ready&apos; button&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;FIR Used Orders&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Out of total FIR used orders, for how many of them the usage of FIR button was confident.&#10;FIR confident logic: If FIR is used before rider arrival and rider picks up the order within 5 mins of their arrival, then FIR Confident&#10;If FIR Used after rider arrival and rider picks up the order within 5 mins of FIR usage, then FIR confident&#10;Rider Arrival: If 30m geofence triggers then rider at 30m geofence+1mins, else rider at 150m geofence + est. walk in time&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;FIR Confident Orders&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Predicted Delivery Time, the delivery time generated by model for each order.&#10;sum(PDT)/Total completed Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;PDT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;Share of orders with avoidable wait time &gt;10 mins&#10;Orders with AWT&gt;10 mins/Total Completed Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;\%Orders with AWT&gt;10&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The Average Avoidable Wait Time for each country/vertical for the selected date range (as per filters)&#10;sum(Avoidable wait time)/total completed orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;AWT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The combined metric of estimated prep time and avoidable wait time, to indetify how long vendor takes to prepare the order and hand it over to the rider.&#10;Avg(EPT)+Avg(AWT)&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;EPT+AWT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The time for which the order is held back before sending to rider.&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Queue Time&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The time taken by rider to accept the order&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Rider Acceptance Time&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;The total completed orders in the time range selected for the country/vertical (as per the filters)&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;Completed Orders&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;To Customer Time, the time taken by rider to reach customer location.&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;TCT&quot;' />
                      </groupfilter>
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Definition:nk]' member='&quot;To vendor Time, the time taken by riders to reach vendor location&#10;sum(TVT)/Total completed Orders&quot;' />
                        <groupfilter function='member' level='[none:Name:nk]' member='&quot;TVT&quot;' />
                      </groupfilter>
                    </groupfilter>
                  </groupfilter>
                </groupfilter>
              </groupfilter>
              <order>
                <hierarchy name='[none:Definition:nk]' />
                <hierarchy name='[none:Name:nk]' />
                <hierarchy name='[none:Type:nk]' />
                <hierarchy name='[none:Used in Tab:nk]' />
