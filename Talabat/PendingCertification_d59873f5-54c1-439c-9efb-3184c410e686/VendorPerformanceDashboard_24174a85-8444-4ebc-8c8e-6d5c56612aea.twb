    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Show Top Reasons' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;Top 5&quot;'>
        <calculation class='tableau' formula='&quot;Top 5&quot;' />
        <members>
          <member value='&quot;All&quot;' />
          <member value='&quot;Top 5&quot;' />
        </members>
      </column>
      <column alias='15 mins' caption='DT_Benchmark' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;15&quot;'>
        <calculation class='tableau' formula='&quot;15&quot;' />
        <aliases>
          <alias key='&quot;15&quot;' value='15 mins' />
          <alias key='&quot;45&quot;' value='45 mins' />
          <alias key='&quot;PDT+10&quot;' value='PDT+10 mins' />
        </aliases>
        <members>
          <member value='&quot;PDT&quot;' />
          <member alias='45 mins' value='&quot;45&quot;' />
          <member alias='15 mins' value='&quot;15&quot;' />
          <member alias='PDT+10 mins' value='&quot;PDT+10&quot;' />
        </members>
      </column>
      <column caption='Sort By' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Orders Completed&quot;'>
        <calculation class='tableau' formula='&quot;Total Orders Completed&quot;' />
        <members>
          <member value='&quot;Total Orders Completed&quot;' />
          <member value='&quot;Within Benchmark DT&quot;' />
          <member value='&quot;Vendor Delay V2&gt;10&quot;' />
