          <member value='&quot;Orders delivered by Car&quot;' />
          <member value='&quot;Others&quot;' />
          <member value='&quot;Split Orders&quot;' />
        </members>
      </column>
      <column caption='Sort Order' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Ascending&quot;'>
        <calculation class='tableau' formula='&quot;Ascending&quot;' />
        <members>
          <member value='&quot;Ascending&quot;' />
          <member value='&quot;Descending&quot;' />
        </members>
      </column>
      <column caption='Top N Rows' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='10'>
        <calculation class='tableau' formula='10' />
        <range max='10000' min='10' />
      </column>
      <column caption='Rank By' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Within Benchmark DT&quot;'>
        <calculation class='tableau' formula='&quot;Within Benchmark DT&quot;' />
        <members>
          <member value='&quot;Total Completed Orders&quot;' />
          <member value='&quot;Within Benchmark DT&quot;' />
          <member value='&quot;Vendor Delay V2&gt;10&quot;' />
