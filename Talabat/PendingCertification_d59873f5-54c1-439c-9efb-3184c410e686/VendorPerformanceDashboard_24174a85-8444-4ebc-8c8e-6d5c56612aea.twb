            <column caption='Granular date' datatype='datetime' name='[Calculation_4884364906632884234]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [day])&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [day], &apos;sunday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [day])&#10;END' />
