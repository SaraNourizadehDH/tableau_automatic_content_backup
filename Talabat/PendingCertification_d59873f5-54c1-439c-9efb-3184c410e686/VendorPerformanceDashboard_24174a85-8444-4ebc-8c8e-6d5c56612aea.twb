            <column caption='Vendor Prep Time AWT&gt;10' datatype='real' name='[Calculation_5094063786450702337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_prep_awt_10])/SUM([orders_awt_10])' />
            </column>
            <column caption='%FIR Used AWT&gt;10' datatype='real' default-format='p0.0%' name='[Calculation_6902399772242206729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fir_used_orders_awt_10])/SUM([orders_awt_10])' />
            </column>
            <column caption='%FIR Conf AWT&gt;10' datatype='real' default-format='p0.0%' name='[Calculation_6902399772242362378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fir_conf_orders_awt_10])/sum([fir_used_orders_awt_10])' />
            </column>
            <column caption='Avg AWT &gt;10' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6902399772242669579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avoidable_wait_time_min_10]/60)/SUM([orders_awt_10])' />
            </column>
            <column caption='DT AWT&gt;10' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6902399772244680716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([DT_awt_10]/60)/SUM([orders_awt_10])' />
            </column>
            <column caption='EPT AWT&gt;10' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6902399772245303310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ept_awt_10])/SUM([orders_awt_10])' />
            </column>
            <column caption='Assumed Actual PT AWT&gt;10' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6902399772245434383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_fir_pt_min_awt_10])/SUM([fir_conf_orders_awt_10])' />
