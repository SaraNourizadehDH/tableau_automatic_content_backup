      <aliases enabled='yes' />
      <column caption='%Vendor Fail Rate (Groups)' datatype='real' default-format='p0.00%' name='[Calculation_5094063790014771203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vf_orders])/WINDOW_SUM(SUM([net_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Granular Date' datatype='datetime' default-format='*m/d/yyyy' name='[Calculation_5094063790072606724]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [date])&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [date], &apos;sunday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [date])&#10;END' />
      </column>
      <column caption='Total Net Orders (Fixed)' datatype='integer' name='[Calculation_5094063791411212293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_5094063790072606724] : SUM([net_orders]) }' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_5094063791469232135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(([Calculation_5094063790014771203]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Vendors' datatype='boolean' name='[Calculation_5094063791469400072]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5094063791469232135] &lt;= [Parameters].[Parameter 7]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='%VFR Overall' datatype='real' default-format='p0.00%' name='[Calculation_5094063791475204105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vf_orders])/SUM([net_orders])' />
      </column>
      <column caption='Grouping Field' datatype='string' name='[Calculation_732046079789387776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8]=&apos;Reason&apos; THEN [reason]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Country&apos; THEN [country_code]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Vertical&apos; THEN [vertical] &#10;ELSEIF [Parameters].[Parameter 8]=&apos;Device&apos; THEN [device] &#10;ELSEIF [Parameters].[Parameter 8]=&apos;Pos Integration Type&apos; THEN [pos_integration_type]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Vendor Age Group&apos; THEN [vendor_age_group]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Zone&apos; THEN [zone_name]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;City&apos; THEN [city_name]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;TGO&apos; THEN [is_tgo]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;DH Kitchen&apos; THEN [is_dh_kitchen]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Kitchen&apos; THEN [is_kitchen]&#10;END' />
      </column>
      <column caption='%vFR Share' datatype='real' default-format='p0.0%' name='[Calculation_732046080179421186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vf_orders])/WINDOW_SUM(SUM([vf_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Measure' datatype='string' name='[Calculation_732046080181305347]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;%vFR&quot; THEN STR(ROUND([Calculation_5094063790014771203] * 100, 2)) + &quot;%&quot;&#10;WHEN &quot;Vendor Failed Orders&quot; THEN STR(SUM([vf_orders]))&#10;WHEN &quot;%vFR Share&quot; THEN STR(ROUND([Calculation_732046080179421186] * 100, 2)) + &quot;%&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Reason Filter' datatype='boolean' name='[Calculation_732046080222285830]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 10] = &apos;All&apos; THEN TRUE&#10;ELSE&#10;    RANK_UNIQUE(SUM([vf_orders]), &apos;desc&apos;) &lt;= 5&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
