      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.13szwps13wcuu112g2dqy0brtvwg]&quot;' value='OKR Target Value' />
          <alias key='&quot;[federated.13szwps13wcuu112g2dqy0brtvwg].[pcdf:sum:Okr Actual Value (copy)_6672012490476707843:qk:2]&quot;' value='OKR Δ % vs. Previous Period' />
        </aliases>
      </column>
      <column caption='Color Indicator' datatype='string' name='[Calculation_4230357807768375300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [okr_actual_value] &gt;= [Okr Target Value (copy)_6672012490422902784] then&#10;    if [is_positive_indicator] then &apos;Green&apos;&#10;    ELSE &apos;Red&apos;&#10;    END&#10;else &#10;    if [is_positive_indicator] then &apos;Red&apos; &#10;    else &apos;Green&apos; &#10;    END&#10;end' />
      </column>
      <column caption='OKR Value ' datatype='string' name='[Calculation_4230357807773208582]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [value_format] = &quot;percentage&quot; THEN&#10;    if [okr_actual_value]&gt;0.1 then &#10;    left(STR(ROUND([okr_actual_value] * 100, 2)),5) + &quot;%&quot;&#10;    else &#10;    left(STR(ROUND([okr_actual_value] * 100, 2)),4) + &quot;%&quot;&#10;    end&#10;ELSEIF  [value_format]=&quot;decimal_0&quot; then &#10;    str(int([okr_actual_value]) )&#10;ELSE&#10;    STR(FLOOR([okr_actual_value])) + &quot;.&quot; + LEFT(STR(FLOOR([okr_actual_value] * 100) - (FLOOR([okr_actual_value]) * 100)), 2) &#10;END' />
      </column>
      <column caption='Rounded OKR' datatype='real' name='[Calculation_4230357807828754444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [value_format] = &quot;percentage&quot; THEN&#10;    ROUND([okr_actual_value] * 100, 0)&#10;ELSE&#10;    ROUND([okr_actual_value], 2)&#10;END' />
      </column>
      <column caption='Okr active' datatype='boolean' name='[Calculation_5290111095521103872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, TODAY())=[quarter_date]' />
      </column>
      <column caption='current week' datatype='datetime' name='[Calculation_5290111095525638145]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, today(), &quot;monday&quot;)' />
      </column>
      <column caption='all months' datatype='date' name='[Calculation_5290111095526416388]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [granularity]=&quot;month&quot; then date end' />
      </column>
      <column caption='Month date str' datatype='string' name='[Calculation_5290111095527854087]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [date]) + &apos; &apos; + RIGHT(STR(YEAR([date])), 2)' />
      </column>
      <column caption='Week date str' datatype='string' name='[Calculation_5290111095528992776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [date]), 3) + &apos; &apos; +&#10;STR(DAY([date])) + &apos; / W&apos; +&#10;STR(DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, [date])))' />
      </column>
      <column caption='Date str' datatype='string' name='[Calculation_5290111095529197577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [granularity]=&apos;month&apos; then [Calculation_5290111095527854087]&#10;else [Calculation_5290111095528992776]&#10;end' />
      </column>
      <column caption='Upper country code' datatype='string' name='[Calculation_5290111095530500106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;OKRs for &quot; + UPPER([country_code])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_6672012490425114625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;day&apos; THEN&#10;    IF [date] = [date] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [date]) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Parameter 2])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [granularity] = &apos;month&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
      </column>
      <column caption='OKR Target Deviance' datatype='real' default-format='p0.0%' name='[Calculation_6672012490425741314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([okr_actual_value])-sum([Okr Target Value (copy)_6672012490422902784]))&#10;/&#10;sum([Okr Target Value (copy)_6672012490422902784])' />
      </column>
      <column caption='Relative Period Filter' datatype='boolean' name='[Calculation_6672012491180662791]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;month&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 1] and&#10;   [date] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 1])&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 2] and&#10;   [date] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 2])&#10;end' />
      </column>
      <column caption='granularity is month' datatype='boolean' name='[Calculation_6672012491195928592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;month&apos;' />
      </column>
      <column caption='View' datatype='boolean' name='[Calculation_6672012491202191379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;OKR Actuals&apos;' />
      </column>
      <column caption='Color Indicator against previous' datatype='string' name='[Color Indicator (copy)_4230357807770587141]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([okr_actual_value]) &gt;= LOOKUP(ZN(SUM([okr_actual_value])), -1) THEN&#10;    // When the current OKR Value is greater than or equal to the previous OKR Value&#10;    IF MAX([is_positive_indicator]) THEN&#10;        &quot;Green&quot;&#10;    ELSE&#10;        &quot;Red&quot;&#10;    END&#10;ELSE&#10;    // When the current OKR Value is less than the previous OKR Value&#10;    IF MAX([is_positive_indicator]) THEN&#10;        &quot;Red&quot;&#10;    ELSE&#10;        &quot;Green&quot;&#10;    END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='OKR Target ' datatype='string' name='[OKR Value  (copy)_4230357807793119242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [value_format] = &quot;percentage&quot; THEN&#10;    STR(ROUND([okr_target_value] * 100, 0)) + &quot;%&quot;&#10;ELSE&#10;    STR(ROUND([okr_target_value], 0))&#10;END' />
      </column>
      <column caption='Okr Actual Value %' datatype='real' default-format='p0.0%' name='[Okr Actual Value (copy)_6672012490476707843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[okr_actual_value]' />
      </column>
      <column caption='Okr Name ' datatype='string' name='[Okr Name (copy)_4230357807787200521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[okr_name]' />
