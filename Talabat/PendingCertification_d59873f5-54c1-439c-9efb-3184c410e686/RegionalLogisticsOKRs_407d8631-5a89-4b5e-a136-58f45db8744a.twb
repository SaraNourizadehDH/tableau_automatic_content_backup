              <calculation class='tableau' formula='if [okr_actual_value] &gt;= [Okr Target Value (copy)_6672012490422902784] then&#10;    if [is_positive_indicator] then &apos;Green&apos;&#10;    ELSE &apos;Red&apos;&#10;    END&#10;else &#10;    if [is_positive_indicator] then &apos;Red&apos; &#10;    else &apos;Green&apos; &#10;    END&#10;end' />
