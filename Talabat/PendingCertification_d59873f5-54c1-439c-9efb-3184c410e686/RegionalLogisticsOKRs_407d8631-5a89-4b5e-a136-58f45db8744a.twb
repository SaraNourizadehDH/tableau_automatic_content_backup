            <column caption='Date Range' datatype='string' name='[Calculation_6672012490425114625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;day&apos; THEN&#10;    IF [date] = [date] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [date]) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 2]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Parameter 2])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [granularity] = &apos;month&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
            </column>
            <column caption='OKR Target Deviance' datatype='real' default-format='p0.0%' name='[Calculation_6672012490425741314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([okr_actual_value])-sum([Okr Target Value (copy)_6672012490422902784]))&#10;/&#10;sum([Okr Target Value (copy)_6672012490422902784])' />
            </column>
            <column caption='Color Indicator against previous' datatype='string' name='[Color Indicator (copy)_4230357807770587141]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([okr_actual_value]) &gt;= LOOKUP(ZN(SUM([okr_actual_value])), -1) THEN&#10;    // When the current OKR Value is greater than or equal to the previous OKR Value&#10;    IF MAX([is_positive_indicator]) THEN&#10;        &quot;Green&quot;&#10;    ELSE&#10;        &quot;Red&quot;&#10;    END&#10;ELSE&#10;    // When the current OKR Value is less than the previous OKR Value&#10;    IF MAX([is_positive_indicator]) THEN&#10;        &quot;Red&quot;&#10;    ELSE&#10;        &quot;Green&quot;&#10;    END&#10;END'>
