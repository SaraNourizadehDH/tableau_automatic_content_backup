      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_okr_value+ (data_platform)' name='federated.13szwps13wcuu112g2dqy0brtvwg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[current week (copy)_5290111095525875714]' _.fcp.ParameterDefaultValues.true...source-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[Calculation_5290111095526416388]' caption='Month' datatype='date' default-format='*mmm yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-11-01#'>
              <calculation class='tableau' formula='#2024-11-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[Calculation_5290111095525638145]' _.fcp.ParameterDefaultValues.true...source-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[all months (copy)_5290111095526838278]' caption='Week' datatype='date' default-format='*mmm dd /\ \Www' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
            <column caption='Relative Period' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range granularity='1' max='30' min='1' />
            </column>
            <column alias='Month' caption='Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13szwps13wcuu112g2dqy0brtvwg'>
            <column caption='OKR Value ' datatype='string' name='[Calculation_4230357807773208582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [value_format] = &quot;percentage&quot; THEN&#10;    if [okr_actual_value]&gt;0.1 then &#10;    left(STR(ROUND([okr_actual_value] * 100, 2)),5) + &quot;%&quot;&#10;    else &#10;    left(STR(ROUND([okr_actual_value] * 100, 2)),4) + &quot;%&quot;&#10;    end&#10;ELSEIF  [value_format]=&quot;decimal_0&quot; then &#10;    str(int([okr_actual_value]) )&#10;ELSE&#10;    STR(FLOOR([okr_actual_value])) + &quot;.&quot; + LEFT(STR(FLOOR([okr_actual_value] * 100) - (FLOOR([okr_actual_value]) * 100)), 2) &#10;END' />
            </column>
            <column caption='Okr active' datatype='boolean' name='[Calculation_5290111095521103872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, TODAY())=[quarter_date]' />
            </column>
            <column caption='current week' datatype='datetime' name='[Calculation_5290111095525638145]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, today(), &quot;monday&quot;)' />
            </column>
            <column caption='all months' datatype='date' name='[Calculation_5290111095526416388]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [granularity]=&quot;month&quot; then date end' />
            </column>
            <column caption='Relative Period Filter' datatype='boolean' name='[Calculation_6672012491180662791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;month&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 1] and&#10;   [date] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 1])&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 2] and&#10;   [date] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 2])&#10;end' />
            </column>
            <column caption='all weeks' datatype='date' name='[all months (copy)_5290111095526838278]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [granularity]=&quot;week&quot; then [date] end' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;regional&quot;' value=' regional' />
              </aliases>
            </column>
            <column caption='current month' datatype='datetime' name='[current week (copy)_5290111095525875714]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, today())' />
