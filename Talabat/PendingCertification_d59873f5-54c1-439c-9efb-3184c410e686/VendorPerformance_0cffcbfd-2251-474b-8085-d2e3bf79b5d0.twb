            <datasource caption='Vendor Data' name='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj' />
          </datasources>
          <datasource-dependencies datasource='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj'>
            <column caption='ABV (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (LC) (copy)_230809527890165770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([basket_lc])/SUM([successful_orders])' />
            </column>
            <column caption='ABS' datatype='real' name='[Calculation_230809527888072713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_qty_delivered])/SUM([successful_orders])' />
            </column>
            <column caption='Commission earning (LC)' datatype='real' name='[Calculation_230809527909687310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_lc])' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_639511193781186563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Platform acquisition' datatype='integer' name='[Calculation_639511193787023369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([platform_acquisition])' />
            </column>
            <column caption='Order Modification Rate%' datatype='real' hidden='true' name='[Calculation_639511193788416010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if ([qty_delivered] &lt; [qty_ordered]) and not [has_item_replacement] and not [has_item_not_found] then [order_id] end)/countd([order_id])' />
            </column>
            <column caption='Successful order with OOS items' datatype='integer' name='[Calculation_639511193788919819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders])' />
            </column>
            <column caption='Failed orders OOS' datatype='integer' name='[Calculation_639511193789292556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_oos_failed_orders])' />
            </column>
            <column caption='OOS%' datatype='real' name='[Calculation_639511193789386765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_639511193788919819] + [Calculation_639511193789292556]) / SUM([net_orders])' />
            </column>
            <column caption='Net Orders' datatype='integer' hidden='true' name='[Calculation_639511193796796431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_net]= True then [order_id] END)' />
            </column>
            <column caption='Healthy orders%' datatype='real' hidden='true' name='[Calculation_639511193796878352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_639511193781186563] - [Calculation_639511193788919819])/ [Calculation_639511193796796431]' />
            </column>
            <column caption='Vendor NFR%' datatype='real' name='[Calculation_639511193797595153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_due_to_vendor])/SUM([net_orders])' />
            </column>
            <column caption='AOV (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_639511193798828051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivered_lc])/SUM([successful_orders])' />
            </column>
            <column caption='Vendor Failed Orders' datatype='integer' name='[Failed Orders  (copy)_230809527885307911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_due_to_vendor])' />
