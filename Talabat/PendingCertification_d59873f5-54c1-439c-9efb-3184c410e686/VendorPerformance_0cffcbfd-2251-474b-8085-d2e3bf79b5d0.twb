      </column>
      <column caption='ABV (EUR) ' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[ABV (LC) (copy)_1438055713255915520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basket_eur])/SUM([successful_orders])' />
      </column>
      <column caption='AOV (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (LC) (copy)_1438055713256947714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivered_gmv])/SUM([successful_orders])' />
