      <column caption='Online date - Creation date' datatype='integer' name='[Aging (copy)_2153283606358417411]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[creation_date], [first_online_date])' />
      </column>
      <column caption='Yesterday' datatype='boolean' hidden='true' name='[Calculation_1365998113985835008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = TODAY()-1' />
