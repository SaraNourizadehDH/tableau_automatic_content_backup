    <worksheet name='Acquisition Rep Performance- sheet'>
      <repository-location id='AcquisitionRepPerformance-sheet' path='/t/Talabat/workbooks/VendorPerformance_17372645689570' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Data' name='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj' />
          </datasources>
          <datasource-dependencies datasource='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj'>
            <column caption='New vendors with =&gt;15 ' datatype='integer' hidden='true' name='[% Viable vendors (copy)_738871832427126799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF { INCLUDE [source_system_vendor_id] : COUNTD(if [is_successful]= True and ([date] &lt; ( [first_online_date] + 16)) then [order_id] END) } &gt;= 15&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_639511193781186563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Successful order with OOS items' datatype='integer' name='[Calculation_639511193788919819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders])' />
            </column>
            <column caption='Failed orders OOS' datatype='integer' name='[Calculation_639511193789292556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_oos_failed_orders])' />
            </column>
            <column caption='OOS%' datatype='real' name='[Calculation_639511193789386765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_639511193788919819] + [Calculation_639511193789292556]) / SUM([net_orders])' />
            </column>
            <column caption='Vendor NFR%' datatype='real' name='[Calculation_639511193797595153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_due_to_vendor])/SUM([net_orders])' />
            </column>
            <column caption='Avg orders per vendor' datatype='real' name='[Calculation_738871829715730437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_639511193781186563] / COUNTD([vendor_id])' />
            </column>
            <column caption='CR%' datatype='real' hidden='true' name='[Calculation_738871829716545543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Commissoin earning (LC) (copy)_1438055713257803780]/[GMV (LC) (copy)_1438055713257394179]' />
            </column>
            <column caption='Viable Vendors' datatype='integer' hidden='true' name='[Calculation_738871830255345672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF { INCLUDE [vendor_id]: SUM(if [is_successful]then [order_id] END)} &gt; 25&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='% of loved brands' datatype='real' name='[Calculation_738871832420007948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_loved_brand] then [source_system_vendor_id] end)/COUNTD([source_system_vendor_id])' />
            </column>
            <column caption='% Viable vendors' datatype='real' hidden='true' name='[Calculation_738871832425074702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_738871830255345672]/COUNTD([source_system_vendor_id])' />
            </column>
            <column caption='Commission earning (EUR)' datatype='real' name='[Commissoin earning (LC) (copy)_1438055713257803780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])' />
            </column>
            <column caption='GMV (EUR) ' datatype='real' name='[GMV (LC) (copy)_1438055713257394179]' role='measure' type='quantitative'>
