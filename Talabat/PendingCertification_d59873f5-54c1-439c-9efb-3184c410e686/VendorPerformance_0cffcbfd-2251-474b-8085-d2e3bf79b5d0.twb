        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0yx79fp1o4d4rp1ctzr4k18ecs3v' name='Vendor Data' type='text'><![CDATA[SELECT
chains.country_name,
    city_name,
    zone_name,
    area_name,
    chains.country_code,
    chains.chain_size as main_cuisine,
    source_system_chain_id,
    chain_name,
    source_system_vendor_id,
    vertical,
    sub_vertical,
    vendors.vendor_id,
    vendor_name,
    vendors.account_manager_name,
    order_flow_type,
    is_migrated_to_dh_menu,
    is_dsaas,
    is_exclusive,
    is_active,
    commission_signed,
    vendors.salesforce_id,
    CONCAT( firstname, " ", lastname) as acquisition_rep,
    total_skus,
    active_skus,
    skus_with_image,
    skus_with_description,
    is_tgo,
    case when not is_tgo then true end as is_tmp,
    CASE WHEN lead_data_origin = 'PP' THEN TRUE ELSE FALSE END AS is_preferred_partner,
    CASE WHEN lead_data_origin in ('LB','PP') THEN TRUE ELSE FALSE END AS is_loved_brand,
    is_pickup_enabled,
    closedate as first_online_date,
    date(creation_time) as creation_date,

    q.* except (vendor_id)

FROM `tlb-data-prod.data_platform.dim_chain` chains
left join `tlb-data-prod.data_platform.dim_vendor_info` vendors
on chains.source_system_chain_id =  vendors.chain_id
LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` q on vendors.vendor_id = q.vendor_id
left join `tlb-data-prod.data_platform.dim_location_info` locations on vendors.location_id = locations.location_id
left join (select vendor_id, count(distinct skus)as total_skus, count(distinct case when is_active then skus end) as active_skus from `tlb-data-prod.data_platform_dmart.dim_product` group by 1) products
on cast(vendors.vendor_id as string) = products.vendor_id
LEFT JOIN (SElECT chain_id, count(distinct case when is_active and is_item_image then product_sku end) as skus_with_image, count(distinct case when is_active and is_item_description then product_sku end ) as skus_with_description 
from `tlb-data-prod.data_platform.dim_item` group by 1) items
on chains.chain_id = items.chain_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` account ON account.grid__c = vendors.salesforce_id
LEFT JOIN (
  SELECT
    c.grid__c salesforce_id,
    opportunity.ownerid,
    max(closedate) closedate,
    MAX(commission__c) commission_signed,
    max(case when name__c = 'TGO Service Fee' then commission_per_order__c end) as tgo_service_commission
  FROM
    `fulfillment-dwh-production.curated_data_shared_salesforce.contract` cont
  INNER JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.account` c
  ON
    c.id = cont.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` opportunity ON  c.id = opportunity.accountid
  WHERE
  stagename = 'Closed Won' and business_type__c in ('New Business', 'Win Back', 'Franchise Extension', 'Switch')
  GROUP BY 1,2 ) contract
ON  contract.salesforce_id = vendors.salesforce_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` user on contract.ownerid = user.id
where vertical<<>>'food' and (sub_vertical= 'marketplace' or sub_vertical is null or is_dsaas)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
