    <worksheet name='New vendor performance - sheet'>
      <repository-location id='Newvendorperformance-sheet' path='/t/Talabat/workbooks/VendorPerformance_17372645689570' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Data' name='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj' />
          </datasources>
          <datasource-dependencies datasource='federated.1qohi7e0lmz4wj1e7e7ql1i27fwj'>
            <column caption='Online date - Creation date' datatype='integer' name='[Aging (copy)_2153283606358417411]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[creation_date], [first_online_date])' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_639511193781186563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Platform acquisition' datatype='integer' name='[Calculation_639511193787023369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([platform_acquisition])' />
            </column>
            <column caption='Successful order with OOS items' datatype='integer' name='[Calculation_639511193788919819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders])' />
            </column>
            <column caption='Failed orders OOS' datatype='integer' name='[Calculation_639511193789292556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_oos_failed_orders])' />
            </column>
            <column caption='OOS%' datatype='real' name='[Calculation_639511193789386765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_639511193788919819] + [Calculation_639511193789292556]) / SUM([net_orders])' />
            </column>
            <column caption='Vendor NFR%' datatype='real' name='[Calculation_639511193797595153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_due_to_vendor])/SUM([net_orders])' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_738871828541100032]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
            </column>
            <column caption='Aging' datatype='integer' name='[Calculation_738871828541304833]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[first_online_date], [Calculation_738871828541100032])' />
            </column>
            <column caption='Days to first order' datatype='integer' name='[Calculation_738871829663019010]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,min([first_online_date]), min([date]))' />
            </column>
            <column caption='Image ratio%' datatype='real' name='[Calculation_738871832417832970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max([skus_with_image])/max([active_skus])' />
            </column>
            <column caption='Description ratio%' datatype='real' name='[Calculation_738871832418021387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max([skus_with_description])/max([active_skus])' />
            </column>
            <column caption='Chain_id' datatype='integer' name='[Chain id (copy)_1977643208101814272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[source_system_chain_id]' />
            </column>
            <column caption='Failed orders OOS (first 15days)' datatype='integer' name='[Failed orders OOS (copy)_1507580014378598401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [date]&lt;=[first_online_date]+15 then [vendor_oos_failed_orders] END)' />
            </column>
            <column caption='GMV (EUR) (first 30 days)' datatype='real' name='[GMV (EUR) (first 15 days) (copy)_1430174405380571138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+30 then [delivered_gmv] END)' />
            </column>
            <column caption='GMV (EUR) ' datatype='real' name='[GMV (LC) (copy)_1438055713257394179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivered_gmv])' />
            </column>
            <column caption='GMV (LC) (first 15 days)' datatype='real' name='[GMV (LC) (copy)_2153283606321213440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+15 then [delivered_lc] END)' />
            </column>
            <column caption='GMV (LC) (first 30 days) ' datatype='real' name='[GMV (LC) (first 15 days) (copy)_1430174405380374529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+30 then [delivered_lc] END)' />
            </column>
            <column caption='GMV (EUR) (first 15 days)' datatype='real' name='[GMV (LC) (first 15 dyas) (copy)_2153283606350581761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+15 then [delivered_gmv] END)' />
            </column>
            <column caption='Lost GMV (EUR) - Vendor' datatype='real' name='[Lost GMV (LC) - Vendor (copy)_1438055713258098693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lost_gmv_eur_due_to_vendor_failed_orders])' />
            </column>
            <column caption='OOS% (first 15 days)' datatype='real' name='[OOS% (copy)_1507580014378385408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Successful order with OOS items (copy)_1507580014378721282] + [Failed orders OOS (copy)_1507580014378598401]) / SUM(if [date] &lt;= [first_online_date]+15 then [net_orders] end)' />
            </column>
            <column caption='Vertical acquisition' datatype='integer' name='[Platform acquisition (copy)_2780409824085331968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vertical_acquisition])' />
            </column>
            <column caption='Sessions' datatype='integer' name='[Sessions (first 15 days)  (copy)_1150177139518185475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([menu_sessions])' />
            </column>
            <column caption='Successful Orders (first 15 days)' datatype='integer' name='[Successful Orders (copy)_2153283606356701186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+15 then [successful_orders] END)' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Successful Orders (copy)_639511193798557714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivered_lc])' />
            </column>
            <column caption='Sessions (first 15 days) ' datatype='integer' name='[Successful Orders (first 15 days) (copy)_1150177139516903424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+15 then [menu_sessions] END)' />
            </column>
            <column caption='Successful Orders (first 30 days)' datatype='integer' name='[Successful Orders (first 15 days) (copy)_1430174405378265088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+30 then [successful_orders] END)' />
            </column>
            <column caption='Sessions (first 30 days)' datatype='integer' name='[Successful Orders (first 30 days) (copy)_1150177139517083649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date &lt;= [first_online_date]+30 then [menu_sessions] END)' />
            </column>
            <column caption='Successful order with OOS items (first 15 days)' datatype='integer' name='[Successful order with OOS items (copy)_1507580014378721282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if date&lt;=[first_online_date]+15 then [partially_fulfilled_orders] end)' />
            </column>
            <column caption='Vendor NFR% (first 15 days)' datatype='real' name='[Vendor NFR% (copy)_1507580014379442179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if date &lt; [first_online_date] + 15 then [failed_orders_due_to_vendor] end)/SUM(if date &lt; [first_online_date] + 15  then [net_orders] end)' />
