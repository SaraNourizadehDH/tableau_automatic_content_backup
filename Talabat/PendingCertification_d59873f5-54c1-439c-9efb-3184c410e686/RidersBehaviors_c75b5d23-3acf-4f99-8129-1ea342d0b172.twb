      <aliases enabled='yes' />
      <column caption='avg_whs_current' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_636696419428425729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Month]) = DATETRUNC(&apos;month&apos;,TODAY()) THEN&#13;&#10;    [Calculation_711287285849092097]&#13;&#10;END' />
      </column>
      <column caption='avg_whs_previous' datatype='real' name='[Calculation_636696419430060034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#13;&#10;    [Calculation_711287285849092097]&#13;&#10;END' />
      </column>
      <column caption='avg_whs_%change' datatype='real' default-format='p0.0%' name='[Calculation_636696419430154243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Calculation_636696419428425729]) - AVG([Calculation_636696419430060034])) / AVG([Calculation_636696419430060034])' />
