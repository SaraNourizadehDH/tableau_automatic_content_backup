        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0q0p7an09ramkr1conrbk090wisb' name='Custom SQL Query' type='text'>SELECT zone_name,&#13;
CASE WHEN age between 15 AND 19 THEN &apos;15-19&apos;&#13;
     WHEN age between 20 AND 29 THEN &apos;20-29&apos;&#13;
     WHEN age between 30 AND 39 THEN &apos;30-39&apos; &#13;
     WHEN age between 40 AND 49 THEN &apos;40-49&apos;&#13;
     ELSE &apos;+50&apos;END age_bucket,&#13;
COUNT(DISTINCT rider_id) as riders&#13;
FROM &#13;
(&#13;
  SELECT&#13;
  distinct d.rider_id&#13;
,dlr.birth_date&#13;
,last_operating_zone_name as zone_name&#13;
,TIMESTAMP_DIFF(CURRENT_DATE,dlr.birth_date,YEAR ) as age&#13;
from `fulfillment-dwh-production.curated_data_shared.orders`o&#13;
LEFT JOIN UNNEST(deliveries) d ON is_primary&#13;
-- LEFT JOIN  `tlb-data-prod.data_platform.dim_logistics_zone`z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
WHERE LOWER(o.country_code) = &apos;eg&apos;&#13;
AND d.delivery_status = &apos;completed&apos;&#13;
AND EXTRACT(MONTH FROM DATE(d.created_at, o.timezone)) = EXTRACT(MONTH FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))&#13;
AND EXTRACT(YEAR FROM DATE(d.created_at, o.timezone)) = EXTRACT(YEAR FROM CURRENT_DATE())&#13;
GROUP BY ALL&#13;
)&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
