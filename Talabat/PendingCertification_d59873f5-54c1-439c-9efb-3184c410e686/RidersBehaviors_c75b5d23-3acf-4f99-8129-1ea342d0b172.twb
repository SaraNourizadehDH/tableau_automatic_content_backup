    <datasource caption='Monthly average WHs &amp; Orders' inline='true' name='federated.1sxgqcq0hzaeds1br87u90y8n9jx' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ymiupf13vul4o141auk01ak7fgh'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='habiba.amr.2@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ymiupf13vul4o141auk01ak7fgh' name='Custom SQL Query' type='text'><![CDATA[SELECT Month, 
zone_name,
CASE WHEN vehicle_type in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_type = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_type in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_type in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE vehicle_type END as vehicle_type,
rider_id,
SUM(working_hours) as total_whs,
working_days,
SUM(working_hours)/working_days as avg_daily_whs
FROM (
  SELECT 
  DATE_TRUNC(created_date, MONTH) as Month
  ,rider_id
  ,zone_name
  ,vehicle_name as vehicle_type
  , SUM(d.duration) / 3600 working_hours
  ,count(distinct created_date) as working_days
FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
LEFT JOIN  `tlb-data-prod.data_platform.dim_logistics_zone`z on s.zone_id = z.zone_id AND z.country_code = 'eg'
where shift_state = 'EVALUATED'
-- AND created_date BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
-- AND EXTRACT(MONTH FROM created_date) = EXTRACT(MONTH FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))
-- AND EXTRACT(YEAR FROM created_date) = EXTRACT(YEAR FROM CURRENT_DATE())
AND DATE(created_date) <<= CURRENT_DATE and DATE(created_date) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  AND s.country_code = 'eg'
GROUP BY ALL
 )
 GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0ymiupf13vul4o141auk01ak7fgh' name='Custom SQL Query' type='text'><![CDATA[SELECT Month, 
zone_name,
CASE WHEN vehicle_type in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_type = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_type in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_type in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE vehicle_type END as vehicle_type,
rider_id,
SUM(working_hours) as total_whs,
working_days,
SUM(working_hours)/working_days as avg_daily_whs
FROM (
  SELECT 
  DATE_TRUNC(created_date, MONTH) as Month
  ,rider_id
  ,zone_name
  ,vehicle_name as vehicle_type
  , SUM(d.duration) / 3600 working_hours
  ,count(distinct created_date) as working_days
FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
LEFT JOIN  `tlb-data-prod.data_platform.dim_logistics_zone`z on s.zone_id = z.zone_id AND z.country_code = 'eg'
where shift_state = 'EVALUATED'
-- AND created_date BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
-- AND EXTRACT(MONTH FROM created_date) = EXTRACT(MONTH FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))
-- AND EXTRACT(YEAR FROM created_date) = EXTRACT(YEAR FROM CURRENT_DATE())
AND DATE(created_date) <<= CURRENT_DATE and DATE(created_date) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  AND s.country_code = 'eg'
GROUP BY ALL
 )
 GROUP BY ALL]]></relation>
          <relation connection='bigquery.0ymiupf13vul4o141auk01ak7fgh' name='Custom SQL Query1' type='text'><![CDATA[SELECT DATE_TRUNC(DAY, MONTH) as Month,
AVG(orders) as avg_daily_orders 
FROM (
 SELECT DATE_TRUNC( DATE(d.created_at, o.timezone), DAY) as DAY,
 rider_id,
  count(distinct order_id) as orders,
from `fulfillment-dwh-production.curated_data_shared.orders`o
LEFT JOIN UNNEST(deliveries) d ON is_primary
WHERE LOWER(o.country_code) = 'eg'
AND d.delivery_status = 'completed'
-- AND EXTRACT(MONTH FROM DATE(d.created_at, o.timezone)) = EXTRACT(MONTH FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))
-- AND EXTRACT(YEAR FROM DATE(d.created_at, o.timezone)) = EXTRACT(YEAR FROM CURRENT_DATE())
AND DATE(created_date) <<= CURRENT_DATE and DATE(created_date) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
GROUP BY ALL
)
GROUP BY ALL]]></relation>
          <relation connection='bigquery.0ymiupf13vul4o141auk01ak7fgh' name='Custom SQL Query3' type='text'><![CDATA[SELECT
  DATE_TRUNC(created_Date, MONTH) AS Month
  -- ,o.order_id
  ,CASE WHEN vehicle_type in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_type = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_type in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_type in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE vehicle_type END as vehicle_type
  ,SUM(rdds.pickup_distance_google) / 1000 AS total_pickup_distance
  ,SUM(rdds.dropoff_distance_google) / 1000 AS total_dropoff_distance
  ,COUNT(DISTINCT rdds.order_id) as orders
  FROM`fulfillment-dwh-production.curated_data_shared.rider_payment_delivery_distance_service` rdds
  where rdds.country_code in ('eg')
  and delivery_status = 'COMPLETED'
  AND DATE(created_date) <<= CURRENT_DATE and DATE(created_date) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  GROUP BY ALL]]></relation>
          <relation connection='bigquery.0ymiupf13vul4o141auk01ak7fgh' name='Custom SQL Query2' type='text'><![CDATA[SELECT Month, 
zone_name,
rider_id,
AVG(shift_duration) as avg_shift
FROM (
  SELECT 
  DATE_TRUNC(created_date, MONTH) as Month
  ,rider_id
  ,zone_name
  , actual_working_time/ 3600 shift_duration
  ,count(distinct created_date) as working_days
FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
LEFT JOIN  `tlb-data-prod.data_platform.dim_logistics_zone`z on s.zone_id = z.zone_id AND z.country_code = 'eg'
where shift_state = 'EVALUATED'
AND DATE(created_date) <<= CURRENT_DATE and DATE(created_date) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  AND s.country_code = 'eg'
GROUP BY ALL
 )
 GROUP BY ALL]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
