      <column caption='avg_pu_distance' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_824158752933273600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_pickup_distance])/SUM([orders])' />
