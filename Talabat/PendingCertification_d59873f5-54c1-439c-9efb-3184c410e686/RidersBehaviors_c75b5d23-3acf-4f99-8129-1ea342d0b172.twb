-- LEFT JOIN  `tlb-data-prod.data_platform.dim_logistics_zone`z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dlr ON d.rider_id = dlr.rider_id and dlr.country_code = &apos;eg&apos;&#13;
WHERE LOWER(o.country_code) = &apos;eg&apos;&#13;
AND d.delivery_status = &apos;completed&apos;&#13;
AND EXTRACT(MONTH FROM DATE(d.created_at, o.timezone)) = EXTRACT(MONTH FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH))&#13;
AND EXTRACT(YEAR FROM DATE(d.created_at, o.timezone)) = EXTRACT(YEAR FROM CURRENT_DATE())&#13;
GROUP BY ALL&#13;
)&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
