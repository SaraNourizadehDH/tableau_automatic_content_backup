      <aliases enabled='yes' />
      <column caption='%One Time' datatype='real' default-format='p0.00%' name='[%Acquisitions (copy)_136867267932778499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_one_time_customers])/SUM([total_unique_customers])' />
      </column>
      <column caption='%Repeated Customers' datatype='real' default-format='p0.00%' name='[%One Time (copy)_136867267932897284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_repeated_order_customers])/SUM([total_unique_customers])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0jdrhbe0r163fl1bce6vh1goh9i0].[sum:total_chain_acquisitions:qk]&quot;' value='Total Chain Acquisitions' />
          <alias key='&quot;[federated.0jdrhbe0r163fl1bce6vh1goh9i0].[sum:total_one_time_customers:qk]&quot;' value='Total One Time Customers' />
          <alias key='&quot;[federated.0jdrhbe0r163fl1bce6vh1goh9i0].[sum:total_repeated_order_customers:qk]&quot;' value='Total Repeated Order Customers' />
          <alias key='&quot;[federated.0jdrhbe0r163fl1bce6vh1goh9i0].[sum:total_unique_customers:qk]&quot;' value='Total Customers' />
        </aliases>
      </column>
      <column caption='%Acquisitions' datatype='real' default-format='p0.00%' name='[Calculation_136867267932401666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_chain_acquisitions])/SUM([total_unique_customers])' />
      </column>
      <column caption='KPIs' datatype='integer' name='[Calculation_4742290467756847104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Total customers&apos; then [total_unique_customers]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Total one time order customers&apos; then&#10;[total_one_time_customers]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Total repeated order customers&apos; then&#10;[total_repeated_order_customers]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Total chain acquisition&apos; then&#10;[total_chain_acquisitions]&#10;END' />
      </column>
      <column caption='%Diff' datatype='real' default-format='p0.00%' name='[Calculation_4759882653890928644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_4742290467756847104])) - LOOKUP(ZN(SUM([Calculation_4742290467756847104])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_4742290467756847104])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
