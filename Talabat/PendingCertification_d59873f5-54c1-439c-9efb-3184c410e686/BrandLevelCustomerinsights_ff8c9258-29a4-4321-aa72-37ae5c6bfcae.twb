      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='custom sql query' id='_76D9C4DBBA9046E6B69A297BB19BC7CA'>
            <properties context=''>
              <relation connection='redshift.0u00doe1mxpuai16o8w3c125wg7e' name='custom sql query' type='text'>with data as (select
--                      r.chain_id,
                     case
                         when drc.chain_name in (&apos;KFC&apos;,&apos;KFC - Governorates&apos;, &apos;KFC - Tourist&apos;) then &apos;KFC&apos;
                         when drc.chain_name in (&apos;Hardee\&apos;s&apos;,&apos;Hardee\&apos;s - North Coast&apos;, &apos;Hardees&apos;) then &apos;Hardee\&apos;s&apos;
                         when drc.chain_name in (&apos;Pizza Hut&apos;,&apos;Pizza Hut - Tourist&apos;) then &apos;Pizza Hut&apos;
                         when drc.chain_name in (&apos;McDonald\&apos;s&apos;,&apos;McDonald&apos;&apos;s - Tourist&apos;
                                                ,&apos;McDonald&apos;&apos;s Breakfast&apos;, &apos;McDonald&apos;&apos;s TGO&apos;, &apos;McDonalds&apos;
                                                ) then &apos;McDonald\&apos;s&apos;
                         else drc.chain_name
                    END             chain_name,
country_iso,
analytical_customer_id,
--                      is_acquisition,
max(case when customer_chain_rank = 1 then 1 else 0 end)::bool is_chain_acquisition,
count(order_id)                                                orders,
case when count(order_id) &gt;&gt; 1 then true else false end         is_repeated_orders
              from dwh_il.ranked_fct_order r
                       inner join dwh_il.dim_countries c
                                  on r.source_id = c.source_id
                       inner join dwh_il.dim_restaurant_chain drc on drc.source_id = r.source_id
                  and drc.chain_id = r.chain_id

--               where chain_id = 4621
--                 and analytical_customer_id = &apos;QF2Jf409RNWzwRFQ3U7SDw&apos;
              where order_date::date &gt;&gt;= current_date - interval &apos;12 month&apos;
              group by 1, 2, 3
              order by 1 DESC
)
select
--        chain_id,
chain_name,
country_iso,
count(distinct analytical_customer_id)                                         total_unique_customers,
count(distinct case when is_chain_acquisition then analytical_customer_id end) total_chain_acquisitions,
count(case when is_repeated_orders then analytical_customer_id end)            total_repeated_order_customers,
count(case when is_repeated_orders is false then analytical_customer_id end)   total_one_time_customers
from data

-- where chain_name = &apos;Subway&apos; and country_iso = &apos;EG&apos;
-- where chain_id = 8357
group by 1, 2
order by 1 DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
