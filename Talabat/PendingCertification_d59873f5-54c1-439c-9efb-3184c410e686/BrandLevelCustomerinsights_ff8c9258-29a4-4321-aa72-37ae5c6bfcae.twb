      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='custom sql query' id='_911B1B7A917E4BDD946D6FFAB28A31E3'>
            <properties context=''>
              <relation connection='redshift.1rxymua0vl5xvd18zjhja0evhw48' name='custom sql query' type='text'>with total_customers as (
    with base as (
        select date_trunc(&apos;month&apos;, order_date)::DATE                          report_month,
                     case
                         when drc.chain_name in (&apos;KFC&apos;,&apos;KFC - Governorates&apos;, &apos;KFC - Tourist&apos;) then &apos;KFC&apos;
                         when drc.chain_name in (&apos;Hardee\&apos;s&apos;,&apos;Hardee\&apos;s - North Coast&apos;, &apos;Hardees&apos;) then &apos;Hardee\&apos;s&apos;
                         when drc.chain_name in (&apos;Pizza Hut&apos;,&apos;Pizza Hut - Tourist&apos;) then &apos;Pizza Hut&apos;
                         when drc.chain_name in (&apos;McDonald\&apos;s&apos;,&apos;McDonald&apos;&apos;s - Tourist&apos;
                                                ,&apos;McDonald&apos;&apos;s Breakfast&apos;, &apos;McDonald&apos;&apos;s TGO&apos;, &apos;McDonalds&apos;
                                                ) then &apos;McDonald\&apos;s&apos;
                         else drc.chain_name
                    END             chain_name,
               country_iso,
--            is_acquisition,
               analytical_customer_id,
               max(case when customer_chain_rank = 1 then 1 else 0 end)::bool is_chain_acquisition,
               count(order_id)                                                orders,
               case when count(order_id) &gt;&gt; 1 then true else false end         is_repeated_orders
        from dwh_il.ranked_fct_order r
                 inner join dwh_il.dim_countries c on c.source_id = r.source_id
                 inner join dwh_il.dim_restaurant_chain drc on drc.source_id = r.source_id
            and drc.chain_id = r.chain_id and c.is_active
--         where analytical_customer_id = &apos;t_JLkGlySSSlrDiBZhZcqg&apos;
        group by 1, 2, 3, 4
        order by 1 DESC
    )
    select t1.report_month,
           t1.chain_name,
           t1.country_iso,
           t1.analytical_customer_id,
           datediff(&apos;month&apos;, t1.report_month, t2.report_month)::int cohort
    from (select report_month, analytical_customer_id, chain_name, country_iso
          from base
         ) t1
             inner join (select report_month, analytical_customer_id, chain_name, country_iso
                         from base
    ) t2 on t1.analytical_customer_id = t2.analytical_customer_id and t1.chain_name = t2.chain_name
        and t1.country_iso = t2.country_iso
    where t2.report_month &gt;&gt;= t1.report_month
    order by 1
)
   ,
    repeated_orders as (
        with base as (
            select date_trunc(&apos;month&apos;, order_date)::DATE                          report_month,
                     case
                         when drc.chain_name in (&apos;KFC&apos;,&apos;KFC - Governorates&apos;, &apos;KFC - Tourist&apos;) then &apos;KFC&apos;
                         when drc.chain_name in (&apos;Hardee\&apos;s&apos;,&apos;Hardee\&apos;s - North Coast&apos;, &apos;Hardees&apos;) then &apos;Hardee\&apos;s&apos;
                         when drc.chain_name in (&apos;Pizza Hut&apos;,&apos;Pizza Hut - Tourist&apos;) then &apos;Pizza Hut&apos;
                         when drc.chain_name in (&apos;McDonald\&apos;s&apos;,&apos;McDonald&apos;&apos;s - Tourist&apos;
                                                ,&apos;McDonald&apos;&apos;s Breakfast&apos;, &apos;McDonald&apos;&apos;s TGO&apos;, &apos;McDonalds&apos;
                                                ) then &apos;McDonald\&apos;s&apos;
                         else drc.chain_name
                    END             chain_name,
                   country_iso,
--            is_acquisition,
                   analytical_customer_id,
                   max(case when customer_chain_rank = 1 then 1 else 0 end)::bool is_chain_acquisition,
                   count(order_id)                                                orders,
                   case when count(order_id) &gt;&gt; 1 then true else false end         is_repeated_orders
            from dwh_il.ranked_fct_order r
                     inner join dwh_il.dim_countries c on c.source_id = r.source_id
                     inner join dwh_il.dim_restaurant_chain drc on drc.source_id = r.source_id
                and drc.chain_id = r.chain_id and c.is_active
--         where analytical_customer_id = &apos;t_JLkGlySSSlrDiBZhZcqg&apos;
            group by 1, 2, 3, 4
            order by 1 DESC
        )
        select t1.report_month,
               t1.chain_name,
               t1.country_iso,
               t1.analytical_customer_id,
               datediff(&apos;month&apos;, t1.report_month, t2.report_month)::int cohort
        from (select report_month, analytical_customer_id, chain_name, country_iso
              from base
              where is_repeated_orders
             ) t1
                 inner join (select report_month, analytical_customer_id, chain_name, country_iso
                             from base
        ) t2 on t1.analytical_customer_id = t2.analytical_customer_id and t1.chain_name = t2.chain_name
            and t1.country_iso = t2.country_iso
        where t2.report_month &gt;&gt;= t1.report_month
        order by 1
    )

   , aquisitions as (
    with base as (
        select date_trunc(&apos;month&apos;, order_date)::DATE                          report_month,
                     case
                         when drc.chain_name in (&apos;KFC&apos;,&apos;KFC - Governorates&apos;, &apos;KFC - Tourist&apos;) then &apos;KFC&apos;
                         when drc.chain_name in (&apos;Hardee\&apos;s&apos;,&apos;Hardee\&apos;s - North Coast&apos;, &apos;Hardees&apos;) then &apos;Hardee\&apos;s&apos;
                         when drc.chain_name in (&apos;Pizza Hut&apos;,&apos;Pizza Hut - Tourist&apos;) then &apos;Pizza Hut&apos;
                         when drc.chain_name in (&apos;McDonald\&apos;s&apos;,&apos;McDonald&apos;&apos;s - Tourist&apos;
                                                ,&apos;McDonald&apos;&apos;s Breakfast&apos;, &apos;McDonald&apos;&apos;s TGO&apos;, &apos;McDonalds&apos;
                                                ) then &apos;McDonald\&apos;s&apos;
                         else drc.chain_name
                    END             chain_name,
               country_iso,
--            is_acquisition,
               analytical_customer_id,
               max(case when customer_chain_rank = 1 then 1 else 0 end)::bool is_chain_acquisition,
               count(order_id)                                                orders,
               case when count(order_id) &gt;&gt; 1 then true else false end         is_repeated_orders
        from dwh_il.ranked_fct_order r
                 inner join dwh_il.dim_countries c on c.source_id = r.source_id
                 inner join dwh_il.dim_restaurant_chain drc on drc.source_id = r.source_id
            and drc.chain_id = r.chain_id and c.is_active
--         where analytical_customer_id = &apos;t_JLkGlySSSlrDiBZhZcqg&apos;
        group by 1, 2, 3, 4
        order by 1 DESC
    )
    select t1.report_month,
           t1.chain_name,
           t1.country_iso,
           t1.analytical_customer_id,
           datediff(&apos;month&apos;, t1.report_month, t2.report_month)::int cohort
    from (select report_month, analytical_customer_id, chain_name, country_iso
          from base
          where is_chain_acquisition
         ) t1
             inner join (select report_month, analytical_customer_id, chain_name, country_iso
                         from base
    ) t2 on t1.analytical_customer_id = t2.analytical_customer_id and t1.chain_name = t2.chain_name
        and t1.country_iso = t2.country_iso
    where t2.report_month &gt;&gt;= t1.report_month
    order by 1
)

   , one_time as (
    with base as (
        select date_trunc(&apos;month&apos;, order_date)::DATE                          report_month,
                     case
                         when drc.chain_name in (&apos;KFC&apos;,&apos;KFC - Governorates&apos;, &apos;KFC - Tourist&apos;) then &apos;KFC&apos;
                         when drc.chain_name in (&apos;Hardee\&apos;s&apos;,&apos;Hardee\&apos;s - North Coast&apos;, &apos;Hardees&apos;) then &apos;Hardee\&apos;s&apos;
                         when drc.chain_name in (&apos;Pizza Hut&apos;,&apos;Pizza Hut - Tourist&apos;) then &apos;Pizza Hut&apos;
                         when drc.chain_name in (&apos;McDonald\&apos;s&apos;,&apos;McDonald&apos;&apos;s - Tourist&apos;
                                                ,&apos;McDonald&apos;&apos;s Breakfast&apos;, &apos;McDonald&apos;&apos;s TGO&apos;, &apos;McDonalds&apos;
                                                ) then &apos;McDonald\&apos;s&apos;
                         else drc.chain_name
                    END             chain_name,
               country_iso,
--            is_acquisition,
               analytical_customer_id,
               max(case when customer_chain_rank = 1 then 1 else 0 end)::bool is_chain_acquisition,
               count(order_id)                                                orders,
               case when count(order_id) &gt;&gt; 1 then true else false end         is_repeated_orders
        from dwh_il.ranked_fct_order r
                 inner join dwh_il.dim_countries c on c.source_id = r.source_id
                 inner join dwh_il.dim_restaurant_chain drc on drc.source_id = r.source_id
            and drc.chain_id = r.chain_id and c.is_active
--         where analytical_customer_id = &apos;t_JLkGlySSSlrDiBZhZcqg&apos;
        group by 1, 2, 3, 4
        order by 1 DESC
    )
    select t1.report_month,
           t1.chain_name,
           t1.country_iso,
           t1.analytical_customer_id,
           datediff(&apos;month&apos;, t1.report_month, t2.report_month)::int cohort
    from (select report_month, analytical_customer_id, chain_name, country_iso
          from base
          where is_repeated_orders is false
         ) t1
             inner join (select report_month, analytical_customer_id, chain_name, country_iso
                         from base
    ) t2 on t1.analytical_customer_id = t2.analytical_customer_id and t1.chain_name = t2.chain_name
        and t1.country_iso = t2.country_iso
    where t2.report_month &gt;&gt;= t1.report_month
    order by 1
)
select *
from (select report_month,
             country_iso,
             chain_name,
             &apos;total_customers&apos;                      cohort_type,
             cohort,
             count(distinct analytical_customer_id) customers
      from total_customers
      where report_month &gt;&gt;= current_date - interval &apos;13 month &apos;
--         and country_iso = &apos;AE&apos;
--         and chain_name = &apos;KFC&apos;
      group by 1, 2, 3, 4, 5
      order by 3) as t
union
select *
from (select report_month,
             country_iso,
             chain_name,
             &apos;repeated_orders&apos;                      cohort_type,
             cohort,
             count(distinct analytical_customer_id) customers
      from repeated_orders
      where report_month &gt;&gt;= current_date - interval &apos;13 month &apos;
 --       and country_iso = &apos;AE&apos;
 --       and chain_name = &apos;KFC&apos;
      group by 1, 2, 3, 4, 5
      order by 3) as tc

union select * from (select  report_month,
       country_iso,
       chain_name,
       &apos;aquisitions&apos;                      cohort_type,
       cohort,
       count(distinct analytical_customer_id) customers
from aquisitions
where report_month &gt;&gt;= current_date - interval &apos;13 month &apos;
--   and country_iso = &apos;AE&apos;
--   and chain_name = &apos;KFC&apos;
group by 1, 2, 3, 4, 5
order by 3) as tc2

union
select * from (select  report_month,
       country_iso,
       chain_name,
       &apos;one_time&apos;                      cohort_type,
       cohort,
       count(distinct analytical_customer_id) customers
from one_time
where report_month &gt;&gt;= current_date - interval &apos;13 month &apos;
--   and country_iso = &apos;AE&apos;
--   and chain_name = &apos;KFC&apos;
group by 1, 2, 3, 4, 5
order by 3) as tc3</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
