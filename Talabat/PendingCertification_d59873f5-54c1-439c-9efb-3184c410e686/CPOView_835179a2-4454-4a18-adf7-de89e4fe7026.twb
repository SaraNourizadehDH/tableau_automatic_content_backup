          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Orders' id='_3963BF8DD3104AAAA69522872EACC16A'>
            <properties context=''>
              <relation connection='bigquery.05mbv0m1agoy6x1f4wxun0g4tdj1' name='Custom SQL Query1' type='text'>SELECT&#13;
     DATE_TRUNC(order_date, MONTH) as MONTH,&#13;
     city_name,&#13;
     zone_name,&#13;
     CASE WHEN vehicle_type in (&apos;Bike&apos;, &apos;Starbucks Bike&apos;,&apos;bike&apos;) THEN &apos;Bike&apos;&#13;
     WHEN vehicle_type = &apos;E-Bike&apos; THEN &apos;E-Bike&apos;&#13;
     WHEN vehicle_type in (&apos;Bicycle&apos;, &apos;Walker&apos;,&apos;bicycle&apos;,&apos;walker&apos;) THEN &apos;Bicycles &amp; Walkers&apos;&#13;
     WHEN vehicle_type in (&apos;Car&apos;, &apos;car&apos;, &apos;Groceries&apos;) THEN &apos;Car&apos; &#13;
     ELSE &apos;Unknown&apos; END as vehicle_type,&#13;
     CASE WHEN vertical_type  in (&quot;restaurants&quot;, &quot;coffee&quot;, &quot;bakery&quot;) THEN &quot;Food&quot;&#13;
      WHEN vertical_type  = &quot;darkstores&quot; THEN &quot;TMart&quot;&#13;
      ELSE &quot;NFV&quot; END AS Vertical ,&#13;
    count(distinct fct_order_info.order_id) as completed_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info`&#13;
     AS fct_order_info&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`&#13;
     AS dim_order_status ON dim_order_status.order_status_id = fct_order_info.order_status_id&#13;
INNER JOIN (&#13;
  SELECT o.order_id&#13;
  ,DATE_TRUNC(DATE(o.created_at,o.timezone),MONTH) as created_date&#13;
  ,o.zone_id&#13;
  ,zone_name&#13;
  ,city_name&#13;
  ,o.vehicle_id&#13;
  ,vehicle_type&#13;
  ,vertical_type&#13;
  FROM `tlb-data-prod.data_platform.fct_logistics_order`  o&#13;
LEFT JOIN `tlb-data-dev.data_platform.dim_logistics_rider_vehicle` v on o.vehicle_id = v.vehicle_id and o.country_code = v.country_code&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on o.zone_id = z.zone_id AND z.country_code = &apos;eg&apos;&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` c on o.city_id = c.city_id AND c.country_code = &apos;eg&apos;&#13;
  WHERE o.country_code = &apos;eg&apos; &#13;
  AND z.is_Active&#13;
--   AND delivery_status = &apos;completed&apos;&#13;
  AND o.order_status = &apos;completed&apos;&#13;
--   AND d.order_status = &apos;completed&apos;&#13;
  AND DATE(o.created_date) BETWEEN  DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE&#13;
) o on o.order_id = fct_order_info.order_id AND o.created_date = DATE_TRUNC(fct_order_info.order_date,MONTH)&#13;
WHERE (fct_order_info.is_tgo ) &#13;
AND ((UPPER(( dim_order_status.status  )) = UPPER(&apos;SUCCESS&apos;))) &#13;
  GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='_3963BF8DD3104AAAA69522872EACC16A' table='[Extract].[_3963BF8DD3104AAAA69522872EACC16A]' type='table' />
            </properties>
          </object>
          <object caption='UTRs' id='_65FB85B2015440F18687907C690D59FD'>
            <properties context=''>
              <relation connection='bigquery.05mbv0m1agoy6x1f4wxun0g4tdj1' name='Custom SQL Query2' type='text'><![CDATA[-- DECLARE start_date date;
-- DECLARE end_date date;
-- -- SET start_date = '2025-02-01';
-- -- SET end_date= '2025-02-28';
-- SET start_date = DATE_ADD(CURRENT_DATE(), INTERVAL -7 MONTH); -- start date
-- SET end_date = CURRENT_DATE; -- end date

WITH dataset AS (
SELECT o.city_id
 ,zone_id
 ,  DATE(d.rider_dropped_off_at, d.timezone) AS report_date
 , COUNT(order_id) orders
 , NULL AS working_hours
 ,CASE WHEN vehicle.name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle.name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle.name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle.name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.orders` o
LEFT JOIN  UNNEST(deliveries) d ON d.is_primary
WHERE created_date >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
AND created_date <<= CURRENT_DATE
 AND country_code='eg'
 AND d.delivery_status = 'completed'
 GROUP BY 1,2,3,6

UNION ALL 


SELECT city_id
  ,zone_id
  , day AS report_date
  , NULL AS orders
  , SUM(d.duration) / 3600 working_hours
  ,CASE WHEN vehicle_name in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle_name = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle_name in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle_name in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE 'Unknown' END as vehicle_type,
FROM `fulfillment-dwh-production.curated_data_shared.shifts`
LEFT JOIN UNNEST (actual_working_time_by_date) d ON d.status = 'ACCEPTED'
where shift_state = 'EVALUATED'
  AND created_date >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  AND created_date <<= CURRENT_DATE
  AND country_code = 'eg'
GROUP BY 1,2,3,6
)

SELECT date_trunc(dataset.report_date, month) as Month 
  ,city_name 
  ,zone_name
  ,vehicle_type
  , SUM(orders) AS orders_completed
  , SUM(working_hours) AS working_hours
  , ROUND(SAFE_DIVIDE(SUM(orders),SUM(working_hours)), 2) AS UTR
FROM dataset
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on dataset.zone_id = z.zone_id AND z.country_code = 'eg'
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` c on dataset.city_id = c.city_id AND c.country_code = 'eg'
GROUP BY 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_65FB85B2015440F18687907C690D59FD' table='[Extract].[_65FB85B2015440F18687907C690D59FD]' type='table' />
            </properties>
          </object>
          <object caption='Main' id='_AB81C749AD93418CBC0AD20ED720972C'>
            <properties context=''>
              <relation connection='bigquery.05mbv0m1agoy6x1f4wxun0g4tdj1' name='Custom SQL Query' type='text'><![CDATA[-- DECLARE commission numeric;
-- DECLARE start_date date;
-- DECLARE end_date date;
-- SET commission = 0.11; -- 3pls commission
-- -- SET start_date = '2025-03-01';
-- -- SET end_date = '2025-03-31';
-- SET start_date = DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH); -- start date
-- SET end_date = CURRENT_DATE; -- end date

with dat as (

WITH base_data AS (
  SELECT DISTINCT
    -- DATE_TRUNC(DATE(order_created_at, timezone), DAY) AS day,
       DATE_TRUNC(DATE(order_created_at, timezone),Month) as order_date,
    rider_id,
    order_id,
    vehicle_name as vehicle,
    order_status,
    CASE
      WHEN payment_category = 'scoring' THEN 'batch_pay'
      WHEN rule_type = 'PER_HOUR' THEN 'pay_per_hour'
      WHEN rule_sub_type = 'RETURN_TRIP_DISTANCES' THEN 'return_distance_pay'
      WHEN rule_sub_type = 'DROPOFF_DISTANCES' THEN 'dropoff_distance_pay'
      WHEN rule_sub_type = 'PICKEDUP_DELIVERIES' AND payment_category = 'basic' THEN 'pickup_pay'
      WHEN rule_sub_type = 'COMPLETED_DELIVERIES' AND payment_category = 'basic' THEN 'drop_off_pay'
      WHEN payment_category = 'tips' THEN 'tips'  
      WHEN rule_type = 'PER_KM' THEN 'unknown_per_KM'
      WHEN payment_category LIKE '%referral%' THEN 'Referral Bonus'
      WHEN payment_category LIKE '%new_hire%' THEN 'NHB'
      ELSE 'unknown'
    END AS payment_cluster,
    SUM(total) AS total_pay
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` payment_data
  WHERE DATE(order_created_at, timezone) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND payment_data.country_code IN ('eg') 
    -- and rider_id = 2253387
  GROUP BY ALL
)
, incentives AS (
   SELECT DISTINCT DATE_TRUNC( DATE(payment_data.payment_created_at, timezone),MONTH) as Month,
  -- start_date,
  -- end_date,
    payment_data.rider_id,
    SUM(CASE WHEN payment_category = 'referral_payments' THEN total end) as referrals,
    SUM(CASE WHEN payment_category = 'new_hire' THEN total end) as NHB,
    SUM(CASE WHEN payment_category = 'quest' THEN total end) as quests,
    SUM(total) AS total_pay,
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` payment_data
  WHERE DATE(payment_data.payment_created_at, timezone) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND payment_data.country_code IN ('eg')
    AND payment_category in ('referral_payments','new_hire','quest')
  GROUP BY ALL
)
, pph AS (
   SELECT DISTINCT DATE_TRUNC( DATE(payment_data.payment_created_at, timezone),MONTH) as Month,
  -- start_date,
  -- end_date,
    payment_data.rider_id,
    SUM(total) AS total_pay,
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` payment_data
  WHERE DATE(payment_data.payment_created_at, timezone) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
    AND payment_data.country_code IN ('eg')
    AND rule_type = 'PER_HOUR'
  GROUP BY ALL
)
,orders_per_rider as (
  SELECT DATE_TRUNC(DATE(order_created_at, timezone),Month) as Month,
  -- start_date,
  -- end_date,
  rider_id,
  count(distinct o.order_id) as orders
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery`  o
 WHERE country_code = 'eg' 
 AND delivery_status = 'completed'
 AND DATE(order_created_at, timezone) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
 GROUP BY ALL
)
, orders as (
  SELECT o.order_id
  ,o.created_at
  ,rider_id
  ,d.delivery_id
  ,o.zone_id
  ,zone_name
  ,city_name
  ,vehicle_name
  ,is_any_delivery_stacked as Stacked
  ,vertical_type
  ,o.order_status
  ,delivery_status
  FROM `tlb-data-prod.data_platform.fct_logistics_order`  o
  LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_delivery` d on d.order_id = o.order_id and d.country_code = o.country_code
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z on o.zone_id = z.zone_id AND z.country_code = 'eg'
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` c on o.city_id = c.city_id AND c.country_code = 'eg'
  WHERE o.country_code = 'eg' 
  AND z.is_Active
  AND DATE(o.created_at, o.timezone) BETWEEN  DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH) AND CURRENT_DATE
)
,
shift_details as (
  SELECT
      rs.actual_start_at,
      rs.actual_end_at,
      rider_id,
      rv.vehicle_type
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_shift` AS rs
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider_vehicle` rv
    ON rv.vehicle_id = rs.vehicle_id
    AND rs.country_code = rv.country_code
  WHERE DATE(rs.shift_start_at, timezone) <<= CURRENT_DATE and DATE(rs.shift_end_at, timezone) >>= DATE_ADD(CURRENT_DATE(), INTERVAL -6 MONTH)
  AND UPPER(rs.country_code) LIKE CASE WHEN 'no' = 'yes' THEN '%' ELSE 'EG' END
  AND rs.shift_state = 'EVALUATED'
  GROUP BY ALL
)

select 
order_date
,rider_id
,city_name
,zone_name
,order_id
,order_status
,vehicle
,vertical
,round(sum(total_cpo),2) as cpo
,count(distinct order_id) as orders
,round(sum(commission),2) as commission
,round(sum(total_cpo)-sum(commission),2) as cpo_without_commission
,round(sum(Basic_pay),2) as basic_pay
,round(sum(Distance_Pay),2) as distance_pay
,round(sum(Bonuses_CPO),2) as incentives
,round(sum(referrals),2) as referrals
,round(sum(NHB),2) as NHB
,round(sum(quests),2) as quests
from
(
SELECT
 *,
-- SUM(Basic_pay) as basic,
-- SUM(Distance_Pay) as distance,
-- SUM(commission) as commission3pls, 
-- SUM(Bonuses_CPO) as incentives,
ROUND((coalesce(Basic_pay,0) + coalesce(Distance_Pay,0) + coalesce(commission,0) + coalesce(Bonuses_CPO,0)) + coalesce(pph_CPO,0),2) AS Total_CPO
FROM (
SELECT DISTINCT
order_date
,a.rider_id
,a.order_id
,zone_name
,city_name
,a.vehicle
-- ,coalesce(a.vehicle,sd.vehicle_type) as vehicle
,Stacked
,CASE WHEN vertical_type  in ("restaurants", "coffee", "bakery") THEN "Food"
      WHEN vertical_type  = "darkstores" THEN "TMart"
      ELSE "NFV" END AS Vertical 
,orders.order_status
,delivery_id
,delivery_status
,SUM(CASE WHEN a.payment_cluster IN ('batch_pay', 'drop_off_pay', 'pickup_pay') THEN a.total_pay END) AS Basic_pay
,COALESCE(ROUND(SUM(CASE WHEN a.payment_cluster IN ('dropoff_distance_pay','return_distance_pay' ) THEN a.total_pay END),2),0) AS Distance_Pay
,COALESCE(ROUND(SUM(CASE WHEN a.payment_cluster IN ('3PLs Commission' ) THEN a.total_pay END),2),0) AS commission
,ROUND(incentives.total_pay/nullif(orders_per_rider.orders,0),2) AS Bonuses_CPO
,ROUND(incentives.referrals/nullif(orders_per_rider.orders,0),2) AS referrals
,ROUND(incentives.NHB/nullif(orders_per_rider.orders,0),2) AS NHB
,ROUND(incentives.quests/nullif(orders_per_rider.orders,0),2) AS quests
-- ,NHB
-- ,quests
,ROUND(pph.total_pay/nullif(o1.orders,0),2) AS pph_CPO
FROM (
SELECT * FROM base_data

UNION ALL

SELECT
  order_date,
  rider_id,
  order_id, 
  vehicle,
  order_status,
  '3PLs Commission' AS payment_cluster,
  SUM(CASE WHEN payment_cluster in ('pickup_pay','drop_off_pay','batch_pay') THEN total_pay END) * 0.11 AS total_pay
FROM base_data
WHERE payment_cluster IN ('batch_pay', 'drop_off_pay', 'pickup_pay')
GROUP BY ALL
ORDER BY order_id
) a
LEFT JOIN incentives
ON a.rider_id = incentives.rider_id AND a.order_date = incentives.Month
LEFT JOIN pph
ON a.rider_id = pph.rider_id AND a.order_date = pph.Month
LEFT JOIN orders_per_rider 
ON a.rider_id = orders_per_rider.rider_id AND a.order_date = orders_per_rider.Month
-- AND incentives.start_date = orders_per_rider.start_date and incentives.end_date = orders_per_rider.end_date
LEFT JOIN orders_per_rider o1 
ON a.rider_id = o1.rider_id AND a.order_date = o1.Month
-- AND pph.start_date = o1.start_date and pph.end_date = o1.end_date
LEFT JOIN orders
ON a.order_id = orders.order_id AND a.rider_id = orders.rider_id
LEFT JOIN shift_details as sd
  ON sd.rider_id = orders.rider_id
  AND orders.created_at BETWEEN sd.actual_start_at AND sd.actual_end_at
GROUP BY ALL
HAVING Basic_pay >> 0
)
-- where order_status = 'completed'
)
group by all
) 
-- select * from dat
SELECT
DATE_TRUNC(order_date, MONTH) as Month,
coalesce(zone_name,"Unknown") zone_name,
-- city_name,
coalesce(city_name,"Unknown") city_name,
vertical,
count(distinct order_id) as total_orders,
count(distinct case when order_status = 'completed' then order_id end) as completed_orders,
-- completed_orders.orders as completed_orders,
--  COALESCE(SUM(CASE WHEN( dat.is_successful ) THEN 1  ELSE NULL END), 0) AS Orders,
-- COUNT(distinct case when is_successful then order_id end) as test,
SUM(cpo) as total_payments,
SUM(commission) as total_commission, 
SUM(cpo_without_commission) as total_payments_without_commission,
SUM(basic_pay) as basic_pay,
SUM(distance_pay) as distance_pay,
SUM(incentives) as incentives,
CASE WHEN vehicle in ('Bike', 'Starbucks Bike','bike') THEN 'Bike'
     WHEN vehicle = 'E-Bike' THEN 'E-Bike'
     WHEN vehicle in ('Bicycle', 'Walker','bicycle','walker') THEN 'Bicycles & Walkers'
     WHEN vehicle in ('Car', 'car', 'Groceries') THEN 'Car' 
     ELSE vehicle END as vehicle_type,
-- ,referrals
-- ,NHB
-- ,quests
SUM(referrals) as referrals,
SUM(NHB) as NHB,
SUM(quests) as Quests
-- CASE 
--     WHEN COUNT(DISTINCT CASE WHEN order_status = 'completed' THEN order_id END) = 0 THEN 0
--     ELSE SUM(CPO) / COUNT(DISTINCT CASE WHEN order_status = 'completed' THEN order_id END) END AS Zone_CPO
from dat
-- WHERE zone_name is not null
GROUP BY ALL
ORDER BY 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_AB81C749AD93418CBC0AD20ED720972C' table='[Extract].[_AB81C749AD93418CBC0AD20ED720972C]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[city_name]' />
                <expression op='[city_name (Custom SQL Query1)]' />
