      <column caption='Cars' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bicycles (copy)_1118300097203281994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(if [vehicle_type]=&apos;Car&apos; then [total_payments] end)/sum(if [vehicle_type]=&apos;Car&apos; then [completed_orders (Custom SQL Query1)] end))&#13;&#10;/(sum(if [vehicle_type]=&apos;Bike&apos; then [total_payments] end)/sum(if [vehicle_type]=&apos;Bike&apos; then [completed_orders (Custom SQL Query1)] end))' />
      </column>
      <column caption='Bicycles' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bikes (copy)_1118300097202843721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(if [vehicle_type]=&apos;Bicycles &amp; Walkers&apos; then [total_payments] end)/sum(if [vehicle_type]=&apos;Bicycles &amp; Walkers&apos; then [completed_orders (Custom SQL Query1)] end))&#13;&#10;/(sum(if [vehicle_type]=&apos;Bike&apos; then [total_payments] end)/sum(if [vehicle_type]=&apos;Bike&apos; then [completed_orders (Custom SQL Query1)] end))' />
      </column>
