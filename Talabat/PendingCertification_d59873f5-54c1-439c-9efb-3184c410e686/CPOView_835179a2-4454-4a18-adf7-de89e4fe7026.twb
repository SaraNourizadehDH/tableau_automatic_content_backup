              <bucket>&quot;Portsaid city&quot;</bucket>
            </map>
            <map to='#ff9d9a'>
              <bucket>&quot;Ras el bar&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;Hurghada&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;Ain shams&quot;</bucket>
