              </expression>
              <expression op='='>
                <expression op='[vehicle_type]' />
                <expression op='[vehicle_type (Custom SQL Query2)]' />
              </expression>
            </expression>
            <first-end-point object-id='_AB81C749AD93418CBC0AD20ED720972C' />
