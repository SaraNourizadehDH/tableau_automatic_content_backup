      <column caption='Current month' datatype='boolean' name='[Calculation_2339901533416538112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&quot;month&quot;,TODAY()) = [dated] THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Adoption movement' datatype='real' name='[Calculation_4035929001738821647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([rewards_pro_customers_adop])) - LOOKUP(ZN(SUM([rewards_pro_customers_adop])), 1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Adoption color' datatype='string' name='[Calculation_4035929001738989584]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4035929001738821647] &gt;0 THEN &quot;GREEN&quot; ELSE &quot;RED&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_6345994134555688960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;Monthly&apos; THEN [dated] &gt;= DATEADD(&apos;month&apos;,-12,TODAY()) AND [dated] &lt;= DATEADD(&apos;month&apos;,0,TODAY())&#10;ELSEIF  [granularity] = &apos;Daily&apos; THEN [dated] &gt;= TODAY() - 120 END' />
      </column>
