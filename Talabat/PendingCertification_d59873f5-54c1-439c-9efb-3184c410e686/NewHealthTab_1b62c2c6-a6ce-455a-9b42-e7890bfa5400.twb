      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_76ED470E74274EADB925514E49290436'>
            <properties context=''>
              <relation connection='bigquery.0m99f6m13f5e5m10ih4hf0ngbkcj (copy)' name='daily kpis' type='text'><![CDATA[---Monthly Health Tab View------------------------------------------
with eom_active as
(
SELECT 
 date,
  country_code,
  SUM(CASE WHEN tpro_subs_type = "Regular" THEN COALESCE(acquisitions_count, 0) + COALESCE(winbacks_count, 0) + COALESCE(billing_retry_count, 0) ELSE 0 END) AS acq_winbacks_regular,
  SUM(COALESCE(acquisitions_count, 0) + COALESCE(winbacks_count, 0) + COALESCE(billing_retry_count, 0)) AS acq_winbacks_all,
  SUM(CASE WHEN tpro_subs_type = "Regular" THEN COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0) ELSE 0 END) AS tpro_subscribers_regular,
  SUM(COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0)) AS tpro_subscribers_all,
  SUM(CASE WHEN tpro_subs_type = "Regular" AND plan_type = "LTP" THEN COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0) ELSE 0 END) AS tpro_ltp_active_subscribers
FROM
  `tlb-data-prod.data_platform.agg_tpro_net_user_movement` AS u
WHERE 
  aggregation_type = "Daily"
GROUP BY 
 1,2
),

tpro_kpis as 
(
select 
 o.country,
 date as date,
 sum(CASE WHEN TYPE IN ("Daily") and sp.plan_id in (31,34,41,42) then (gmv_overall_eur) else 0 end )as Partner_GMVProCustomers,
 sum(CASE WHEN TYPE IN ("Daily") and sp.plan_id not in (31,34,41,42) then (gmv_overall_eur) else 0 end )as Regular_GMVProCustomers,
 sum(case when type in ("Daily") and sp.plan_id in (31,34,41,42) and extract (day from date)<< extract(day from current_date()) 
         then gmv_overall_eur end) as Partner_GMVProCustomersMTD,
 sum(case when type in ("Daily") and sp.plan_id not in (31,34,41,42) and extract (day from date)<< extract(day from current_date()) 
          then gmv_overall_eur end) as Regular_GMVProCustomersMTD,
sum(case when  type in ("Daily") and sp.plan_id in (31,34,41,42) then tpro_orders  else 0 end ) as partner_utilisation_tpro_orders,
sum(case when type in ("Daily") and sp.plan_id in (31,34,41,42) then overall_orders else 0 end ) as partner_utilisation_all_orders,
sum(case when  type in ("Daily") and sp.plan_id not in (31,34,41,42) then tpro_orders  else 0 end ) as regular_utilisation_tpro_orders,
sum(case when type in ("Daily") and sp.plan_id not in (31,34,41,42) then overall_orders else 0 end ) as regular_utilisation_all_orders

from `tlb-data-prod.data_platform.agg_tpro_orders` as o 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on o.plan_id=sp.plan_id
where 
is_visible
and date>>="2022-03-01"  --and type in ("Monthly")
and subs_type_upd = 'All'
group by 1,2
),


talabat_kpis as 
(
select 
 order_date,
 country_iso,
 sum(gmv_amount_eur) as talabatgmv,
 count(distinct order_id) as talabat_orders,
 sum(case when extract (day from order_date)<< extract(day from current_date()) then gmv_amount_eur end) as talabatgmvmtd,
 sum(coalesce(gmv_amount_lc,0)) as platform_gmv

from `tlb-data-prod.data_platform.fct_order_info` fi
inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
on  fi.vendor_id = dv.vendor_id 
and  is_successful 
where is_successful
and order_date>>="2023-01-01"
group by 1,2
)

,churn as (select
date,
country_code,
count(distinct case when tpro_subscription_status_including_partnership="Churned" then account_id end) as all_churn_count,
count(distinct account_id) as all_upforrenewal_count,

count(distinct case when tpro_subscription_status_excluding_partnership="Churned" and plan_id not in (31,34) then account_id end) as regular_churn_count,
count(distinct case when plan_id not in (31,34) then account_id end) as regular_upforrenewal_count,

from
`tlb-data-prod.data_platform.fct_tpro_churn`
where lower(snapshot_interval)="daily"
group by all
)



select 
 a.date,
 a.country_code,
 acq_winbacks_regular,
 acq_winbacks_all,
 tpro_subscribers_regular,
 tpro_subscribers_all,
 talabatgmv,talabatgmvmtd,
 platform_gmv,
 all_churn_count,
 all_upforrenewal_count,
 regular_churn_count,
 regular_upforrenewal_count,
 Partner_GMVProCustomers,
 Regular_GMVProCustomers,
 Partner_GMVProCustomersMTD,
 Regular_GMVProCustomersMTD,
 a.tpro_ltp_active_subscribers,
 partner_utilisation_tpro_orders,
 regular_utilisation_tpro_orders,
 partner_utilisation_all_orders,
 regular_utilisation_all_orders,
 talabat_orders,

from eom_active a
left join talabat_kpis as b
on a.date=b.order_date
and a.country_code=b.country_iso
left join tpro_kpis as e
on a.date=e.date
and a.country_code=e.country
left join churn as g
on a.date=g.date
and a.country_code=g.country_code
where a.date>>="2023-01-01" and a.date<<current_date()
order by a.date desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Health Tab Monthly' inline='true' name='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0cr40up0kdefp819hjmyn08g3h5j (copy)'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='steve.chia@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Targets For Health Tab' name='cloudfile:googledrive-excel-direct.1dee1di1b4q7du0zwau3i17pindn'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1-iiWkafmh5eVDo0wN3WPOFLEfWrB3oCPboHAEIsZ3Ik' cloudFileMetadata_-_folder='root' cloudFileName='Targets For Health Tab.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1-iiWkafmh5eVDo0wN3WPOFLEfWrB3oCPboHAEIsZ3Ik/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Targets For Health Tab.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='steve.chia@talabat.com' validate='no' workgroup-auth-mode='prompt' />
