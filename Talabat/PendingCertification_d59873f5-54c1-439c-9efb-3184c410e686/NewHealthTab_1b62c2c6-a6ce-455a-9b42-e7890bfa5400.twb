        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1dee1di1b4q7du0zwau3i17pindn' name='Pro Targets' table='[&apos;Pro Targets$&apos;]' type='table'>
          <columns gridOrigin='A1:D73:no:A1:D73:0' header='yes' outcome='2'>
            <column datatype='date' name='dated' ordinal='0' />
            <column datatype='string' name='country_code' ordinal='1' />
            <column datatype='real' name='pro customer adoption target' ordinal='2' />
            <column datatype='real' name='pro customer gmv adoption target' ordinal='3' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0cr40up0kdefp819hjmyn08g3h5j (copy)' name='Main Code' type='text'><![CDATA[---Monthly Health Tab View------------------------------------------
with eom_active as (
SELECT 
  DATE_TRUNC(date, MONTH) AS month,
  country_code,
  SUM(CASE WHEN tpro_subs_type = "Regular" THEN COALESCE(acquisitions_count, 0) + COALESCE(winbacks_count, 0) + COALESCE(billing_retry_count, 0) ELSE 0 END) AS acq_winbacks_regular,
  SUM(COALESCE(acquisitions_count, 0) + COALESCE(winbacks_count, 0) + COALESCE(billing_retry_count, 0)) AS acq_winbacks_all,
  SUM(CASE WHEN tpro_subs_type = "Regular" THEN COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0) ELSE 0 END) AS tpro_subscribers_regular,
  SUM(COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0)) AS tpro_subscribers_all,
  SUM(CASE WHEN tpro_subs_type = "Regular" AND plan_type = "LTP" THEN COALESCE(free_trial_active_users_nd_count, 0) + COALESCE(paid_active_users_nd_count, 0) ELSE 0 END) AS tpro_ltp_active_subscribers
FROM
  `tlb-data-prod.data_platform.agg_tpro_net_user_movement` AS u
WHERE 
  aggregation_type = "Monthly"
GROUP BY 
  month, country_code

)


-------------------------------------------GMV, orders KPIS------------------------------------------------------------------------
,tpro_kpis as (
select o.country,
  date_trunc(date,year) as year,
  date_trunc(date, month) as month,
  sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_price_lc=0 then (gmv_overall) else 0 end )as Partner_GMVProCustomers,
  sum(CASE WHEN TYPE IN ("Monthly") and sp.plan_price_lc<<>>0 then (gmv_overall) else 0 end )as Regular_GMVProCustomers,

  sum(case when type in ("Daily") and sp.plan_price_lc=0 and extract (day from date)<< extract(day from current_date()) then 
  gmv_overall end) as Partner_GMVProCustomersMTD,
  sum(case when type in ("Daily") and sp.plan_price_lc<<>>0  and extract (day from date)<< extract(day from current_date()) then 
  gmv_overall end) as Regular_GMVProCustomersMTD,

 sum(case when  type in ("Monthly") and sp.plan_price_lc=0  then tpro_orders  else 0 end ) as partner_utilisation_tpro_orders,
 sum(case when type in ("Monthly") and sp.plan_price_lc=0  then overall_orders else 0 end ) as partner_utilisation_all_orders,

 sum(case when  type in ("Monthly")  and sp.plan_price_lc<<>>0  then tpro_orders  else 0 end ) as regular_utilisation_tpro_orders,
 sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then overall_orders else 0 end ) as regular_utilisation_all_orders,


 sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then non_signed_rests_food else 0 end) as non_signed_rests_food,
 sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then non_signed_rests_nfv else 0 end) as non_signed_rests_nfv,
 sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then non_tpro_less_than_mov_nfv else 0 end) as 
  non_tpro_less_than_mov_nfv,
 sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then non_tpro_less_than_mov_food else 0 end) as 
  non_tpro_less_than_mov_food,
sum(case when type in ("Monthly") and sp.plan_price_lc<<>>0  then tmart_orders else 0 end) as non_tpro_less_than_mov_tmart,

from `tlb-data-prod.data_platform.agg_tpro_orders` as o 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on o.plan_id=sp.plan_id
where 
is_visible
and date>>="2023-03-01"  
and subs_type_upd = 'All'
group by 1,2,3
)
----------------------------vendor coverage ------------------------------------------------------------------------------

, tpro_vendor_history_daily AS (
SELECT
 date_add(date,interval - 1 day) as date    
 ,vendor_id
FROM
 `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history`
WHERE DATE_TRUNC(date, MONTH)>>="2023-03-01"
GROUP BY ALL
)

,vendor_vertical as (
SELECT distinct date,a.chain_id,vendor_id,vertical_class,sub_vertical
from 
(select distinct date,v.chain_id,vendor_id
from `tlb-data-prod.data_platform.dim_vendor_info` v
left join `tlb-data-prod.data_platform.dim_chain` c
on v.chain_id = c.chain_id
cross join `tlb-data-prod.data_platform.dim_date` dd
where date between date_add(date_trunc((current_date),month), interval -12 month) and current_date  
) as a
left join `tlb-data-prod.data_platform.dim_chain_history` as dv
on a.chain_id=dv.chain_id
and a.date between dv.valid_from and dv.valid_to

)




,talabat_kpis as (
SELECT
  fi.order_date
  ,fi.country_iso
  ,fi.vendor_id
  ,sum(fi.gmv_amount_lc) as  talabat_gmv_amount_lc
  ,sum(case when extract (day from order_date)<< extract(day from current_date()) then gmv_amount_lc end) as talabat_gmv_amount_lc_mtd
  
FROM `tlb-data-prod.data_platform.fct_order_info` fi
WHERE is_successful
AND DATE_TRUNC(fi.order_date, MONTH) >>="2023-04-01"
GROUP BY ALL
)



,vendors_online_status_daily as ( 
SELECT 
   date,
   a.country_code
   ,a.vendor_id
     FROM 
     ( select RIGHT(global_entity_id,2)as country_code, b.chain_id,a.vendor_id,date(valid_at) as date
      FROM
     `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors_history` a
     INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` as b
     ON a.vendor_id=cast(b.vendor_id as string)
     WHERE is_online = true
    AND global_entity_id in ('HF_EG','TB_BH','TB_JO','TB_IQ','TB_KW','TB_OM','TB_QA','TB_AE','HS-SA')
    AND DATE_TRUNC(DATE(valid_at), MONTH)>>="2023-01-01"
    GROUP BY ALL
     ) as a




  GROUP BY ALL
)


,vendors_active_online_status_daily as (SELECT order_date as date,country_iso country_code,cast(vendor_id as string) as vendor_id
from talabat_kpis
union all
select date,country_code,vendor_id
from vendors_online_status_daily)


,tpro_vendor_status_monthly as (
SELECT       
 "Monthly" as aggregation_level
 ,date_trunc(os.date,month) as date
 ,os.country_code
,CASE WHEN lower(vv.vertical_class)="food" THEN "Food"
 WHEN lower(vv.vertical_class)="non-food" and lower(vv.sub_vertical)="darkstore" then "tmart"
 else "NFV" end as vendor_vertical_type
 ,count(distinct os.vendor_id) as talabat_active_online_vendor_count
 ,count(distinct th.vendor_id) as pro_active_online_vendor_count
FROM
vendors_active_online_status_daily as os
LEFT JOIN (select 
                vendor_id,
                date_trunc(case when date_trunc(tw.date,month)=date_trunc(current_date(),month) 
                              then current_date()-1 else last_day(date_trunc(tw.date,month)) end,month) as month
            from  tpro_vendor_history_daily   as tw
            where  case when date_trunc(tw.date,month)=date_trunc(current_date(),month) 
            then current_date()-1 else last_day(date_trunc(tw.date,month)) end =date
            GROUP BY ALL
            ) as th          
ON  os.vendor_id=cast(th.vendor_id as string)
AND date_trunc(os.date,month)=th.month 
LEFT JOIN 
(select distinct date,vendor_id,vertical_class,sub_vertical
 FROM vendor_vertical as vv
  WHERE case when date_trunc(date,month)=date_trunc(current_date(),month) 
            then current_date()-1 else last_day(date_trunc(date,month)) end =date
)  as vv
ON os.vendor_id=cast(vv.vendor_id as string)
AND date_trunc(os.date,month)=date_trunc(vv.date,month)
GROUP by all
),
final_vendor_count_data as (
 SELECT    
  aggregation_level
 ,date
 ,country_code
 ,vendor_vertical_type
 ,talabat_active_online_vendor_count
 ,pro_active_online_vendor_count
 FROM tpro_vendor_status_monthly
)


,final_gmv_data as (
SELECT

 "Monthly" as aggregation_level
 ,country_iso as country_code
 ,date_trunc(order_date,month) as date
 ,CASE WHEN lower(vv.vertical_class)="food" THEN "Food"
 WHEN lower(vv.vertical_class)="non-food" and lower(vv.sub_vertical)="darkstore" then "tmart"
 else "NFV" end as vendor_vertical_type
 ,sum(talabat_gmv_amount_lc) as talabat_gmv_lc

 ,sum(case when tw.vendor_id is not null then talabat_gmv_amount_lc else 0 end ) as pro_vendor_gmv_lc 
 ,sum(talabat_gmv_amount_lc_mtd) as talabat_gmv_amount_lc_mtd
FROM
talabat_kpis as t
LEFT join (select vendor_id,date_trunc(case when date_trunc(tw.date,month)=date_trunc(current_date(),month) then 
                                   current_date()-1 else last_day(date_trunc(tw.date,month)) end,month) as month
            from tpro_vendor_history_daily   as tw
                        where case when date_trunc(tw.date,month)=date_trunc(current_date(),month) then 
                                   current_date()-1 else last_day(date_trunc(tw.date,month)) end =date
                                    
           
      
            group by 1,2) as tw
ON t.vendor_id=tw.vendor_id
AND date_trunc((order_date),month)=tw.month
LEFT JOIN 
(select distinct date,vendor_id,vertical_class,sub_vertical
 FROM vendor_vertical as vv
 WHERE case when date_trunc(date,month)=date_trunc(current_date(),month) 
            then current_date()-1 else last_day(date_trunc(date,month)) end =date
 

)  as vv
ON t.vendor_id=vv.vendor_id 
AND date_trunc(t.order_date,month)=date_trunc(vv.date,month)
GROUP by all
)


,final_vendor_coverage as (
select 
 fgd.aggregation_level,
 fgd.country_code,
 fgd.date,
 sum(pro_vendor_gmv_lc) as pro_vendor_gmv_lc,
 sum(talabat_gmv_lc) as talabat_gmv_lc,
 sum(talabat_gmv_amount_lc_mtd) as talabat_gmv_amount_lc_mtd,

 sum(case when fgd.vendor_vertical_type="NFV" then pro_vendor_gmv_lc else 0 end) as pro_nfv_vendor_gmv_lc,
 sum(case when fgd.vendor_vertical_type="NFV" then talabat_gmv_lc else 0 end) as talabat_nfv_gmv_lc, 
 sum(case when fgd.vendor_vertical_type="Food" then pro_vendor_gmv_lc else 0 end) as pro_food_gmv_lc,
 sum(case when fgd.vendor_vertical_type="Food" then talabat_gmv_lc else 0 end)  as talabat_food_gmv_lc,
 sum(pro_active_online_vendor_count) as pro_vendor_count,
 sum(talabat_active_online_vendor_count) as talabat_vendor_count,
 sum(case when tm.vendor_vertical_type="NFV" then pro_active_online_vendor_count else 0 end) as pro_nfv_vendor_count,
 sum(case when tm.vendor_vertical_type="NFV" then    talabat_active_online_vendor_count else 0 end)  as talabat_nfv_vendor_count, 
 sum(case when tm.vendor_vertical_type="Food" then pro_active_online_vendor_count else 0 end) as pro_food_vendor_count,
 sum( case when tm.vendor_vertical_type="Food" then talabat_active_online_vendor_count else 0 end) as talabat_food_vendor_count

from final_gmv_data as fgd
left join final_vendor_count_data as tm
on fgd.date=tm.date
and fgd.aggregation_level=tm.aggregation_level
and fgd.country_code=tm.country_code
and fgd.vendor_vertical_type=tm.vendor_vertical_type
group by all

)


---------------------------------churn----------------------------------------------------------------------------------------
,churned as (
select 
date as month,
 country_code,
 count(distinct account_id) as all_upforrenewal_count,
 count(distinct case when tpro_subscription_status_including_partnership="Churned" then account_id end) as all_churn_count,
 count(distinct case when churn_type_including_partnership='Voluntary Churn' then account_id end ) as all_voluntary_churn_count,
 count(distinct case when churn_type_including_partnership='Involuntary Churn' then account_id end ) as all_involuntary_churn_count,
 count(distinct case when tpro_subscription_status_excluding_partnership="Churned" and plan_price_lc <<>>0 then account_id end) as 
  regular_churn_count,
 count(distinct case when  plan_price_lc <<>>0 then account_id end) as regular_upforrenewal_count,
 count(distinct case when churn_type_excluding_partnership='Voluntary Churn' and plan_price_lc <<>>0 then account_id end ) as 
  regular_voluntary_churn_count,
 count(distinct case when churn_type_excluding_partnership='Involuntary Churn'  and plan_price_lc <<>>0 then account_id end ) as regular_involuntary_churn_count,

from
`tlb-data-prod.data_platform.fct_tpro_churn` as c
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on c.plan_id=sp.plan_id
where lower(snapshot_interval)="monthly"
group by all

)
-----------------------------------------------addressable base----------------------------------------------------------------------
, addressable_base as (
select 
country_code,
date as month,
talabat_user_count as addressable_talabat_user_count,
tpro_subscriber_count as addressable_tpro_subscriber_count
from 
tlb-data-prod.data_platform.agg_tpro_addressable_universe_monthly_weekly
where addressable_universe_tag="Addressable Universe"
and aggregation_level="Monthly"
and date>>="2023-06-01")
--------------------------------------------roi---------------------------------------------------------------------------------------
,pro_savings as (select 
e.country_code,
month_start_date as month,
sum(case when plan_type="1M" then membership_revenue_lc else 0 end) as stp_tpro_subfee,
sum(case when plan_type="LTP" then membership_revenue_lc else 0 end) as ltp_tpro_subfee,

sum(case when plan_type="1M" then  tmart_delivery_fee_funding_lc else 0 end) as stp_tmart_df,
sum(case when plan_type="LTP" then tmart_delivery_fee_funding_lc else 0 end) as ltp_tmart_df,

sum(case when plan_type="1M" then actual_tgo_delivery_fee_lc else 0 end) as stp_tgo_df,
sum(case when plan_type="LTP" then actual_tgo_delivery_fee_lc else 0 end) as ltp_tgo_df,

sum(case when plan_type="1M" then actual_tmp_delivery_fee_lc else 0 end) as stp_tmp_df,
sum(case when plan_type="LTP" then actual_tmp_delivery_fee_lc else 0 end) as ltp_tmp_df,

sum(case when plan_type="1M" then coalesce(rewards_voucher_savings_lc,0)+coalesce(cash_burn_savings_lc,0) else 0 end) as stp_rewards_savings,
sum(case when plan_type="LTP" then coalesce(rewards_voucher_savings_lc,0)+coalesce(cash_burn_savings_lc,0) else 0 end) as ltp_rewards_savings

from
`tlb-data-prod.data_platform.agg_tpro_economics` e
left join `tlb-data-prod.data_platform.dim_country_info` tax on UPPER(e.country_code) = UPPER(tax.country_code)
where tpro_subs_type="Regular"
group by all order by 1,2 desc
)




---------------------------------------------------------------------------------------------------------------------------------------
select 
a.month,
a.country_code,
acq_winbacks_regular as regular_acquisitions,

acq_winbacks_all as total_acquisitions,

 tpro_subscribers_regular as tpro_active_subscribers,
 tpro_subscribers_all as total_active_subscribers,
talabat_gmv_amount_lc_mtd,
coalesce(talabat_l30_active_user_count,talabat_active_user_count) as talabat_active_users,
talabat_order_count,





all_churn_count,
all_upforrenewal_count,
all_voluntary_churn_count,
all_involuntary_churn_count,
regular_churn_count,
regular_upforrenewal_count,
regular_voluntary_churn_count,
regular_involuntary_churn_count,


Partner_GMVProCustomers,
Regular_GMVProCustomers,
Partner_GMVProCustomersMTD,
Regular_GMVProCustomersMTD,

tpro_ltp_active_subscribers,
partner_utilisation_tpro_orders,
regular_utilisation_tpro_orders,
partner_utilisation_all_orders,
regular_utilisation_all_orders,


pro_vendor_gmv_lc,
e.talabat_gmv_lc,
pro_nfv_vendor_gmv_lc,
talabat_nfv_gmv_lc, 
pro_food_gmv_lc,
talabat_food_gmv_lc,
pro_vendor_count,
talabat_vendor_count,
pro_nfv_vendor_count,
talabat_nfv_vendor_count, 
pro_food_vendor_count,
talabat_food_vendor_count,

non_signed_rests_nfv,
non_signed_rests_food,
non_tpro_less_than_mov_tmart,
non_tpro_less_than_mov_food,
non_tpro_less_than_mov_nfv,


addressable_talabat_user_count,
addressable_tpro_subscriber_count,

stp_tpro_subfee,
ltp_tpro_subfee,

stp_tmart_df,
ltp_tmart_df,

stp_tgo_df,
ltp_tgo_df,

stp_tmp_df,
ltp_tmp_df,

stp_rewards_savings,
ltp_rewards_savings




from eom_active a

inner join tpro_kpis as c
on a.month=c.month
and a.country_code=c.country
inner join churned as d
on a.month=d.month
and a.country_code=d.country_code
inner join final_vendor_coverage as e
on a.month=e.date
and a.country_code=e.country_code
inner join  `tlb-data-prod.data_platform.agg_tpro_order_contribution` as f
on a.country_code=f.country_code
and a.month=f.date
and f.aggregation_level="Monthly"
inner join addressable_base as g
on a.month=g.month
and a.country_code=g.country_code
left join pro_savings as h
on a.month=h.month
and a.country_code=h.country_code

