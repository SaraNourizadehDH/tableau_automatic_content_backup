      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Rewards Targets' id='Rewards Targets_D8B97EA0C3EA4D1CBFAEADF8D5DF8E45'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.1wwc7qa092twe21bz38v11nbnr4w' name='Rewards Targets' table='[&apos;Rewards Targets$&apos;]' type='table'>
                <columns gridOrigin='A1:D97:no:A1:D97:0' header='yes' outcome='2'>
                  <column datatype='date' name='dated' ordinal='0' />
                  <column datatype='string' name='country_code' ordinal='1' />
                  <column datatype='real' name='rewards customer adoption target' ordinal='2' />
                  <column datatype='real' name='rewards customer gmv adoption target' ordinal='3' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Rewards Targets_D8B97EA0C3EA4D1CBFAEADF8D5DF8E45' table='[Extract].[Rewards Targets_D8B97EA0C3EA4D1CBFAEADF8D5DF8E45]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_C2F1207D167C44EC977CCE0AEA825DA3'>
            <properties context=''>
              <relation connection='bigquery.0w75jsx0jww9f9135rt0c1bqtiws' name='Custom SQL Query' type='text'><![CDATA[with okr as
(
(select 
  date_trunc(order_date, month) as dated,
  country_iso as country_code,
  'Monthly' as granularity,
  count(distinct account_id) as active_customer_count,
  sum(gmv_amount_lc) as active_customer_gmv
from `tlb-data-prod.data_platform.fct_order_info`
where is_successful = True and order_date >>= '2023-01-01'
group by 1,2,3)
union all
(select 
  order_date as dated,
  country_iso as country_code,
  'Daily' as granularity,
  count(distinct account_id) as active_customers_count,
  sum(gmv_amount_lc) as active_customer_gmv,
from `tlb-data-prod.data_platform.fct_order_info`
where is_successful = True and order_date >>= '2023-01-01'
group by 1,2,3))

,rewards_customer_gmv as
(select 
  dated, 
  country_code,
  'Monthly' as granularity,
  sum(case when rewards_pro_category in ("Rewards-only", "Rewards + Pro") then total_gmv_amount_lc end) as active_rewards_customer_gmv
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_okr_level`
where denominator_category = 'Active'
group by 1,2,3)

,eligible as
(select 
  date as dated,
  country_code,
  granularity,
  sum(eligible_customer_count) as eligible_customer_count
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_earning_customers`
where order_segment <<>> 'Inactive'
group by 1,2,3)

,redemptions as
(select 
  date as dated,
  country_code,
  type as granularity,
  sum(redeeming_customers) as redeeming_customers,
  sum(redemptions) as redemptions
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_redeeming_customers`
group by 1,2,3)

,adoption as
(select 
  dated,
  country_code,
  'Monthly' as granularity,
  sum(case when raffle_category = "Excl. Raffle" then customer_adoption end) as cust_adoption_excl_raffle,
  sum(case when raffle_category = "Incl. Raffle" then customer_adoption end) as cust_adoption_incl_raffle,
  sum(case when raffle_category = "Excl. Raffle" then gmv_coverage end) as gmv_adoption_excl_raffle,
  sum(case when raffle_category = "Incl. Raffle" then gmv_coverage end) as gmv_adoption_incl_raffle
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_okr_level`
where 
  rewards_pro_category <<>> "Pro-only"
  and denominator_category = "Active"
group by 1,2,3
)

,burn_earn as
((select 
  dated,
  country_code,
  'Monthly' as granularity,
  SAFE_DIVIDE(sum(coalesce(burned_points,0)),sum(coalesce(earned_points,0))) as burn_earn_ratio
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_finance_level`
group by 1,2,3)
union all
(SELECT 
  DATE(DATE(TIMESTAMP(a.transaction_date_time_utc), z.timezone)) AS dated,
  z.country_code,
  'Daily' as granularity,
  SAFE_DIVIDE(
  SUM(case when a.transaction_type_id in (200/*burn*/,
                                          220 /*Burn on Partners*/,
                                          201/*charity*/,
                                          230/*Burn on raffles*/) then loyalty_points_delta end)*(-1),
  SUM(case when a.transaction_type_id in (300/*welcome_gift*/,
                                          301/*Welcome gift correction*/,
                                          100/*earn*/,
                                          102/*earn_cancellation*/,
                                          101/*earn_compensation*/,
                                          400 /*earn pro*/) then loyalty_points_delta end)) as burn_earn_ratio
FROM
  `tlb-data-prod.data_platform.fct_loyalty_transaction` a
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z ON a.transaction_country_id = z.country_id
WHERE DATE_TRUNC(DATE(TIMESTAMP(a.transaction_date_time_utc), z.timezone), month) >>= '2023-01-01'
group by 1,2,3))

,active_rewards_chains as (
  select
    distinct z.country_code,
    DATE_TRUNC(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone), month) as month,
    cc.brand_id,
    min(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone)) as first_red_date,
    max(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone)) as last_red_date
  from
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
    INNER join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
    INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
    INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z ON b.country_id = z.country_id
  where
    cc.discriminator in ('LOYALTY', 'TPRO')
    and is_deleted = FALSE
    and DATE_TRUNC(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone), month) >>= '2023-01-01'
  GROUP BY 1,2,3
)

,vendor_gmv_coverage as
((select
  a.order_date as dated,
  a.country_code,
  'Daily' as granularity,
  count(distinct case when b.brand_id is not null and is_non_food = False then b.brand_id end) as vendors_food,
  count(distinct case when b.brand_id is not null and is_non_food = True then b.brand_id end) as vendors_nfv,
  count(distinct case when b.brand_id is not null then b.brand_id end) as vendors_all,
  sum(case when b.brand_id is not null and is_non_food = False then gmv_amount_lc end)/sum(case when is_non_food = False then gmv_amount_lc end) as vendor_gmv_share_food_only,
  sum(case when b.brand_id is not null and is_non_food = True then gmv_amount_lc end)/sum(case when is_non_food = True then gmv_amount_lc end) as vendor_gmv_share_nfv_only,
  sum(case when b.brand_id is not null then gmv_amount_lc end)/sum(case when True then gmv_amount_lc end) as vendor_gmv_share_all
from
  `tlb-data-prod.data_platform.fct_order_info` a
  left join active_rewards_chains b on b.brand_id = a.chain_id
  and b.country_code = a.country_iso
  and b.month = date_trunc(a.order_date, month)
  and a.order_date between b.first_red_date and b.last_red_date
where
  is_successful
  and order_date >>= '2023-01-01'
group by 1,2,3)
union all
(select
  date_trunc(a.order_date, month) as dated,
  a.country_code,
  'Monthly' as granularity,
  count(distinct case when b.brand_id is not null and is_non_food = False then b.brand_id end) as vendors_food,
  count(distinct case when b.brand_id is not null and is_non_food = True then b.brand_id end) as vendors_nfv,
  count(distinct case when b.brand_id is not null then b.brand_id end) as vendors_all,
  sum(case when b.brand_id is not null and is_non_food = False then gmv_amount_lc end)/sum(case when is_non_food = False then gmv_amount_lc end) as vendor_gmv_share_food_only,
  sum(case when b.brand_id is not null and is_non_food = True then gmv_amount_lc end)/sum(case when is_non_food = True then gmv_amount_lc end) as vendor_gmv_share_nfv_only,
  sum(case when b.brand_id is not null then gmv_amount_lc end)/sum(case when True then gmv_amount_lc end) as vendor_gmv_share_all
from
  `tlb-data-prod.data_platform.fct_order_info` a
  left join active_rewards_chains b on b.brand_id = a.chain_id
  and b.country_code = a.country_iso
  and b.month = date_trunc(a.order_date, month)
  and a.order_date between b.first_red_date
  and b.last_red_date
where
  is_successful
  and order_date >>= '2023-01-01'
group by 1,2,3))

select 
  a.dated, 
  a.country_code, 
  a.granularity,
  a.active_customer_count,
  SAFE_DIVIDE(b.eligible_customer_count,a.active_customer_count) as eligible_customer_perc,
  COALESCE(adop.cust_adoption_incl_raffle, SAFE_DIVIDE(c.redeeming_customers,a.active_customer_count)) as redeeming_customer_perc_incl_raffle,
  COALESCE(adop.cust_adoption_excl_raffle) as redeeming_customer_perc_excl_raffle,
  COALESCE(adop.gmv_adoption_incl_raffle, SAFE_DIVIDE(f.active_rewards_customer_gmv,a.active_customer_gmv)) as redeeming_customer_gmv_perc_incl_raffle,
  COALESCE(adop.gmv_adoption_excl_raffle) as redeeming_customer_gmv_perc_excl_raffle,
  c.redemptions,
  d.burn_earn_ratio,
  coalesce(vendor_gmv_share_food_only,0) vendor_gmv_share_food_only,
  coalesce(vendor_gmv_share_nfv_only,0) vendor_gmv_share_nfv_only,
  coalesce(vendor_gmv_share_all,0) vendor_gmv_share_all
from okr a
left join adoption adop on a.dated = adop.dated and a.country_code = adop.country_code and a.granularity = adop.granularity
left join eligible b on a.dated = b.dated and a.country_code = b.country_code and b.granularity = a.granularity
left join redemptions c on a.dated = c.dated and a.country_code = c.country_code and c.granularity = a.granularity
left join burn_earn d on a.dated = d.dated and a.country_code = d.country_code and d.granularity = a.granularity
left join vendor_gmv_coverage e on a.dated = e.dated and a.country_code = e.country_code and e.granularity = a.granularity
left join rewards_customer_gmv f on a.dated = f.dated and a.country_code = f.country_code and b.granularity = f.granularity]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_C2F1207D167C44EC977CCE0AEA825DA3' table='[Extract].[_C2F1207D167C44EC977CCE0AEA825DA3]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[country_code]' />
                <expression op='[country_code (Rewards Targets)]' />
              </expression>
              <expression op='='>
                <expression op='[dated]' />
                <expression op='[dated (Rewards Targets)]' />
              </expression>
              <expression op='='>
                <expression op='[granularity]' />
                <expression _.fcp.RelationshipCalculations.false...op='[&quot;Monthly&quot;]' _.fcp.RelationshipCalculations.true...op='&quot;Monthly&quot;' />
              </expression>
            </expression>
            <first-end-point object-id='_C2F1207D167C44EC977CCE0AEA825DA3' />
            <second-end-point object-id='Rewards Targets_D8B97EA0C3EA4D1CBFAEADF8D5DF8E45' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Pro (excluding Partnerships)'>
      <repository-location derived-from='http://ip-172-31-0-94:8935/t/Talabat/workbooks/NewHealthTab-WIP/ProexcludingPartnerships?rev=' id='ProexcludingPartnerships' path='/t/Talabat/workbooks/NewHealthTab-WIP' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Health Tab Monthly' name='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)'>
            <column caption='% orders below MOV (nfv)' datatype='real' name='[% orders below MOV (food) (copy)_1208372085561593865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_nfv])/ SUM([regular_utilisation_all_orders])' />
            </column>
            <column caption='% orders below MOV (tmart)' datatype='real' name='[% orders below MOV (food) (copy)_1208372085561892874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_tmart])/ SUM([regular_utilisation_all_orders])' />
            </column>
            <column caption='Adoption GMV GAP' datatype='real' name='[Adoption GAP (copy)_495958958543286286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_665969841676664836]-SUM([pro customer gmv adoption target])' />
            </column>
            <column caption='Adoption GMV color 2' datatype='string' name='[Adoption GMV color (copy)_495958958545141777]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([pro customer gmv adoption target]) &lt;&gt; 0 THEN &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
            </column>
            <column caption='Adoption GMV color' datatype='string' name='[Adoption color (copy)_495958958543302671]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Adoption GAP (copy)_495958958543286286] &gt; 0 then &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Adoption color 2' datatype='string' name='[Adoption color (copy)_495958958544867344]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([pro customer adoption target]) &lt;&gt; 0 THEN &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
            </column>
            <column caption='LTP Adoption% ' datatype='real' name='[Adoption% (copy)_644577743855095808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers])/SUM([tpro_active_subscribers])' />
            </column>
            <column caption='Voluntary Churn%' datatype='real' name='[Calculation_1208372085304090629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_voluntary_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='% orders from non-pro vendors' datatype='real' name='[Calculation_1208372085321326599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([non_signed_rests_food])+SUM([non_signed_rests_nfv]))/SUM(&#13;&#10;[regular_utilisation_all_orders])' />
            </column>
            <column caption='% orders below MOV (food)' datatype='real' name='[Calculation_1208372085561102344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_food])/ SUM([regular_utilisation_all_orders])' />
            </column>
            <column caption='% Adoption from Addressable Base' datatype='real' name='[Calculation_1208372085601329163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([addressable_tpro_subscriber_count])/SUM([addressable_talabat_user_count])' />
            </column>
            <column caption='Customers Savings Multiple - Overall' datatype='real' name='[Calculation_1569785976578138112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ltp_rewards_savings]+[ltp_tgo_df]+[ltp_tmart_df]+[ltp_tmp_df]&#13;&#10;+[stp_rewards_savings]+[stp_tgo_df]+[stp_tmart_df]+[stp_tmp_df])/&#13;&#10;sum([ltp_tpro_subfee]+[stp_tpro_subfee])' />
            </column>
            <column caption='Empty' datatype='integer' name='[Calculation_495958958532915204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Adoption GAP' datatype='real' name='[Calculation_495958958542004236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_665969841674248192] - SUM([pro customer adoption target])' />
            </column>
            <column caption='Adoption color' datatype='string' name='[Calculation_495958958542397453]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_495958958542004236] &gt; 0 then &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Utilization%' datatype='real' name='[Calculation_644577743855374337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_utilisation_tpro_orders])/SUM([regular_utilisation_all_orders])' />
            </column>
            <column caption='Vendor Count Coverage (Overall)' datatype='real' name='[Calculation_644577744151666690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_vendor_count])/SUM([talabat_vendor_count])' />
            </column>
            <column caption='Vendor Count Coverage %(Food)' datatype='real' name='[Calculation_644577744171859972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_food_vendor_count])/SUM([talabat_food_vendor_count])' />
            </column>
            <column caption='Customer Order%' datatype='real' name='[Calculation_644577744459816966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_utilisation_all_orders])/SUM([talabat_order_count])' />
            </column>
            <column caption='Adoption%' datatype='real' name='[Calculation_665969841674248192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_active_subscribers])/SUM([talabat_active_users])' />
            </column>
            <column caption='Churned %' datatype='real' name='[Calculation_665969841676103682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='Customer GMV%' datatype='real' name='[Calculation_665969841676664836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Regular_GMVProCustomers])/SUM([talabat_gmv_lc])' />
            </column>
            <column caption='Customer GMV MTD%' datatype='real' name='[Calculation_665969841677021189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Regular_GMVProCustomersMTD])/SUM([talabat_gmv_amount_lc_mtd])' />
            </column>
            <column caption='Vendor GMV (food) % ' datatype='real' name='[Calculation_665969841677660166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_food_gmv_lc])/SUM([talabat_food_gmv_lc])' />
            </column>
            <column caption='Vendor GMV (NFV)%' datatype='real' name='[Calculation_665969841678200839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_nfv_vendor_gmv_lc])/SUM([talabat_nfv_gmv_lc])' />
            </column>
            <column caption='Vendor GMV% (Overall)' datatype='real' name='[Calculation_665969841678389256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_vendor_gmv_lc])/SUM([talabat_gmv_lc])' />
            </column>
            <column caption='Customers Savings Multiple - LTP' datatype='real' name='[Customers Savings Multiple - 1M (copy)_1948932751504560130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ltp_rewards_savings]+[ltp_tgo_df]+[ltp_tmart_df]+[ltp_tmp_df])/&#13;&#10;sum([ltp_tpro_subfee])' />
            </column>
            <column caption='Empty (copy) (copy)' datatype='integer' name='[Empty (copy) (copy)_495958958533120006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
