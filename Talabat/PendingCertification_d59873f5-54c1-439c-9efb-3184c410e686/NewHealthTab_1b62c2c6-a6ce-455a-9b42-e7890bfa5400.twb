    <worksheet name='Pro (including Partnerships)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Health Tab Monthly' name='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)'>
            <column caption='Empty' datatype='integer' name='[Calculation_495958958532915204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='All Pro Subscribers' datatype='integer' name='[Calculation_644577744468733959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_active_subscribers]' />
            </column>
            <column caption='Total Adoption %' datatype='real' name='[Calculation_644577744469291017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_644577744468733959])/SUM([talabat_active_users])' />
            </column>
            <column caption='Total Customer Order %' datatype='real' name='[Calculation_644577744469663754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([regular_utilisation_all_orders])+SUM([partner_utilisation_all_orders]))/SUM([talabat_order_count])' />
            </column>
            <column caption='Total Customer GMV%' datatype='real' name='[Calculation_644577744469975051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Partner_GMVProCustomers])+SUM([Regular_GMVProCustomers]))/&#13;&#10;SUM([talabat_gmv_lc])' />
            </column>
            <column caption='Churn % (Pro+Partnerships)' datatype='real' name='[Calculation_644577744475193357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_churn_count])/SUM([all_upforrenewal_count])' />
            </column>
            <column caption='Empty (copy)' datatype='integer' name='[Empty (copy)_495958958533103621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column datatype='real' name='[Partner_GMVProCustomersMTD]' role='measure' type='quantitative' />
            <column datatype='real' name='[Partner_GMVProCustomers]' role='measure' type='quantitative' />
            <column datatype='real' name='[Regular_GMVProCustomersMTD]' role='measure' type='quantitative' />
            <column datatype='real' name='[Regular_GMVProCustomers]' role='measure' type='quantitative' />
            <column caption='Total Customer GMV MTD%' datatype='real' name='[Total Customer GMV% (copy)_644577744470380556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Regular_GMVProCustomersMTD]+IFNULL([Partner_GMVProCustomersMTD],0))/SUM([talabat_gmv_amount_lc_mtd])' />
            </column>
            <column datatype='integer' name='[all_churn_count]' role='measure' type='quantitative' />
