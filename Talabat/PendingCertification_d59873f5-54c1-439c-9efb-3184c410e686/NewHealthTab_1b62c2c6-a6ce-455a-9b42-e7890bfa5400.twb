        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1wwc7qa092twe21bz38v11nbnr4w' name='Rewards Targets' table='[&apos;Rewards Targets$&apos;]' type='table'>
          <columns gridOrigin='A1:D97:no:A1:D97:0' header='yes' outcome='2'>
            <column datatype='date' name='dated' ordinal='0' />
            <column datatype='string' name='country_code' ordinal='1' />
            <column datatype='real' name='rewards customer adoption target' ordinal='2' />
            <column datatype='real' name='rewards customer gmv adoption target' ordinal='3' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0w75jsx0jww9f9135rt0c1bqtiws' name='Custom SQL Query' type='text'><![CDATA[with okr as
(
(select 
  date_trunc(order_date, month) as dated,
  country_iso as country_code,
  'Monthly' as granularity,
  count(distinct account_id) as active_customer_count,
  sum(gmv_amount_lc) as active_customer_gmv
from `tlb-data-prod.data_platform.fct_order_info`
where is_successful = True and order_date >>= '2023-01-01'
group by 1,2,3)
union all
(select 
  order_date as dated,
  country_iso as country_code,
  'Daily' as granularity,
  count(distinct account_id) as active_customers_count,
  sum(gmv_amount_lc) as active_customer_gmv,
from `tlb-data-prod.data_platform.fct_order_info`
where is_successful = True and order_date >>= '2023-01-01'
group by 1,2,3))

,rewards_customer_gmv as
(select 
  dated, 
  country_code,
  'Monthly' as granularity,
  sum(case when rewards_pro_category in ("Rewards-only", "Rewards + Pro") then total_gmv_amount_lc end) as active_rewards_customer_gmv
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_okr_level`
where denominator_category = 'Active'
group by 1,2,3)

,eligible as
(select 
  date as dated,
  country_code,
  granularity,
  sum(eligible_customer_count) as eligible_customer_count
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_earning_customers`
where order_segment <<>> 'Inactive'
group by 1,2,3)

,redemptions as
(select 
  date as dated,
  country_code,
  type as granularity,
  sum(redeeming_customers) as redeeming_customers,
  sum(redemptions) as redemptions
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_redeeming_customers`
group by 1,2,3)

,adoption as
(select 
  dated,
  country_code,
  'Monthly' as granularity,
  sum(case when raffle_category = "Excl. Raffle" then customer_adoption end) as cust_adoption_excl_raffle,
  sum(case when raffle_category = "Incl. Raffle" then customer_adoption end) as cust_adoption_incl_raffle,
  sum(case when raffle_category = "Excl. Raffle" then gmv_coverage end) as gmv_adoption_excl_raffle,
  sum(case when raffle_category = "Incl. Raffle" then gmv_coverage end) as gmv_adoption_incl_raffle
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_okr_level`
where 
  rewards_pro_category <<>> "Pro-only"
  and denominator_category = "Active"
group by 1,2,3
)

,burn_earn as
((select 
  dated,
  country_code,
  'Monthly' as granularity,
  SAFE_DIVIDE(sum(coalesce(burned_points,0)),sum(coalesce(earned_points,0))) as burn_earn_ratio
from `tlb-data-prod.data_platform_rest_tables.agg_trewards_dashboard_finance_level`
group by 1,2,3)
union all
(SELECT 
  DATE(DATE(TIMESTAMP(a.transaction_date_time_utc), z.timezone)) AS dated,
  z.country_code,
  'Daily' as granularity,
  SAFE_DIVIDE(
  SUM(case when a.transaction_type_id in (200/*burn*/,
                                          220 /*Burn on Partners*/,
                                          201/*charity*/,
                                          230/*Burn on raffles*/) then loyalty_points_delta end)*(-1),
  SUM(case when a.transaction_type_id in (300/*welcome_gift*/,
                                          301/*Welcome gift correction*/,
                                          100/*earn*/,
                                          102/*earn_cancellation*/,
                                          101/*earn_compensation*/,
                                          400 /*earn pro*/) then loyalty_points_delta end)) as burn_earn_ratio
FROM
  `tlb-data-prod.data_platform.fct_loyalty_transaction` a
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z ON a.transaction_country_id = z.country_id
WHERE DATE_TRUNC(DATE(TIMESTAMP(a.transaction_date_time_utc), z.timezone), month) >>= '2023-01-01'
group by 1,2,3))

,active_rewards_chains as (
  select
    distinct z.country_code,
    DATE_TRUNC(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone), month) as month,
    cc.brand_id,
    min(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone)) as first_red_date,
    max(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone)) as last_red_date
  from
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
    INNER join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
    INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
    INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z ON b.country_id = z.country_id
  where
    cc.discriminator in ('LOYALTY', 'TPRO')
    and is_deleted = FALSE
    and DATE_TRUNC(DATE(TIMESTAMP(a.created_on_time_utc), z.timezone), month) >>= '2023-01-01'
  GROUP BY 1,2,3
)

,vendor_gmv_coverage as
((select
  a.order_date as dated,
  a.country_code,
  'Daily' as granularity,
  count(distinct case when b.brand_id is not null and is_non_food = False then b.brand_id end) as vendors_food,
  count(distinct case when b.brand_id is not null and is_non_food = True then b.brand_id end) as vendors_nfv,
  count(distinct case when b.brand_id is not null then b.brand_id end) as vendors_all,
  sum(case when b.brand_id is not null and is_non_food = False then gmv_amount_lc end)/sum(case when is_non_food = False then gmv_amount_lc end) as vendor_gmv_share_food_only,
  sum(case when b.brand_id is not null and is_non_food = True then gmv_amount_lc end)/sum(case when is_non_food = True then gmv_amount_lc end) as vendor_gmv_share_nfv_only,
  sum(case when b.brand_id is not null then gmv_amount_lc end)/sum(case when True then gmv_amount_lc end) as vendor_gmv_share_all
from
  `tlb-data-prod.data_platform.fct_order_info` a
  left join active_rewards_chains b on b.brand_id = a.chain_id
  and b.country_code = a.country_iso
  and b.month = date_trunc(a.order_date, month)
  and a.order_date between b.first_red_date and b.last_red_date
where
  is_successful
  and order_date >>= '2023-01-01'
group by 1,2,3)
union all
(select
  date_trunc(a.order_date, month) as dated,
  a.country_code,
  'Monthly' as granularity,
  count(distinct case when b.brand_id is not null and is_non_food = False then b.brand_id end) as vendors_food,
  count(distinct case when b.brand_id is not null and is_non_food = True then b.brand_id end) as vendors_nfv,
  count(distinct case when b.brand_id is not null then b.brand_id end) as vendors_all,
  sum(case when b.brand_id is not null and is_non_food = False then gmv_amount_lc end)/sum(case when is_non_food = False then gmv_amount_lc end) as vendor_gmv_share_food_only,
  sum(case when b.brand_id is not null and is_non_food = True then gmv_amount_lc end)/sum(case when is_non_food = True then gmv_amount_lc end) as vendor_gmv_share_nfv_only,
  sum(case when b.brand_id is not null then gmv_amount_lc end)/sum(case when True then gmv_amount_lc end) as vendor_gmv_share_all
from
  `tlb-data-prod.data_platform.fct_order_info` a
  left join active_rewards_chains b on b.brand_id = a.chain_id
  and b.country_code = a.country_iso
  and b.month = date_trunc(a.order_date, month)
  and a.order_date between b.first_red_date
  and b.last_red_date
where
  is_successful
  and order_date >>= '2023-01-01'
group by 1,2,3))

select 
  a.dated, 
  a.country_code, 
  a.granularity,
  a.active_customer_count,
  SAFE_DIVIDE(b.eligible_customer_count,a.active_customer_count) as eligible_customer_perc,
  COALESCE(adop.cust_adoption_incl_raffle, SAFE_DIVIDE(c.redeeming_customers,a.active_customer_count)) as redeeming_customer_perc_incl_raffle,
  COALESCE(adop.cust_adoption_excl_raffle) as redeeming_customer_perc_excl_raffle,
  COALESCE(adop.gmv_adoption_incl_raffle, SAFE_DIVIDE(f.active_rewards_customer_gmv,a.active_customer_gmv)) as redeeming_customer_gmv_perc_incl_raffle,
  COALESCE(adop.gmv_adoption_excl_raffle) as redeeming_customer_gmv_perc_excl_raffle,
  c.redemptions,
  d.burn_earn_ratio,
  coalesce(vendor_gmv_share_food_only,0) vendor_gmv_share_food_only,
  coalesce(vendor_gmv_share_nfv_only,0) vendor_gmv_share_nfv_only,
  coalesce(vendor_gmv_share_all,0) vendor_gmv_share_all
from okr a
left join adoption adop on a.dated = adop.dated and a.country_code = adop.country_code and a.granularity = adop.granularity
left join eligible b on a.dated = b.dated and a.country_code = b.country_code and b.granularity = a.granularity
left join redemptions c on a.dated = c.dated and a.country_code = c.country_code and c.granularity = a.granularity
left join burn_earn d on a.dated = d.dated and a.country_code = d.country_code and d.granularity = a.granularity
left join vendor_gmv_coverage e on a.dated = e.dated and a.country_code = e.country_code and e.granularity = a.granularity
left join rewards_customer_gmv f on a.dated = f.dated and a.country_code = f.country_code and b.granularity = f.granularity]]></relation>
