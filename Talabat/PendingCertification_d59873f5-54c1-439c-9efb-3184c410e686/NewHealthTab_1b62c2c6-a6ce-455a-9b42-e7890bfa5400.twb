    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Health Tab - Monthly'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/NewHealthTab-WIP/HealthTab-Monthly?rev=' id='HealthTab-Monthly' path='/t/Talabat/workbooks/NewHealthTab' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_119' value='center' />
          <format attr='vertical-align' id='dash-text_119' value='center' />
