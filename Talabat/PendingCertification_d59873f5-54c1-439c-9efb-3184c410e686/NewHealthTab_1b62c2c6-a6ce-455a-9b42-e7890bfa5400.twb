              <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers])/SUM([tpro_active_subscribers])' />
            </column>
            <column caption='Churned%' datatype='real' name='[Calculation_960111210374733825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='Utilization%' datatype='real' name='[Calculation_960111210375008258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_customers_pro_orders])/SUM([regular_customers_all_orders])' />
            </column>
            <column caption='GMV Vendor Coverage' datatype='real' name='[Calculation_960111210380984324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_vendor_gmv_lc])/SUM([talabat_gmv])' />
            </column>
            <column caption='Exclude Current Week' datatype='boolean' name='[Calculation_960111210696585223]' role='dimension' type='nominal'>
