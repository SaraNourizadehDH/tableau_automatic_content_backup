            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-workload-looker-9617' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='steve.chia@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
