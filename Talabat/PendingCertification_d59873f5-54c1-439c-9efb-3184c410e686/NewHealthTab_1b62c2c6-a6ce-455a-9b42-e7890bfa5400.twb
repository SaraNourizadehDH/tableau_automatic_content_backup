      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_95E5BC4ECC934F46A4BAEE2F478FEB2D'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Custom SQL Query].[country]' />
                      <expression op='[Weekly ROI].[country_code]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Custom SQL Query1].[week_start_date]' />
                      <expression op='[Weekly ROI].[week_start]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='inner' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='[Custom SQL Query].[country]' />
                        <expression op='[Custom SQL Query1].[country]' />
                      </expression>
                      <expression op='='>
                        <expression op='[Custom SQL Query].[week]' />
                        <expression op='[Custom SQL Query1].[week_start_date]' />
                      </expression>
                    </expression>
                  </clause>
                  <relation connection='bigquery.1cjkvj50m3r3sc10dyo3o1nxroat' name='Custom SQL Query' type='text'><![CDATA[with 
eow as (
select 
date_trunc(iso_date,week(monday)) as week,
fs.country ,
count(distinct case when fs.plan_id not in (31,34,41,42) then fs.account_id end) as tpro_active_subscribers,
count(distinct case when plan_duration_days>>31 and is_visible and plan_price_lc <<>> 0 then fs.account_id end ) as tpro_ltp_active_subscribers,
count(distinct fs.account_id) as total_active_subscribers
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` fs
inner join (select week_start_date,week_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date>>= date_sub(date_trunc(current_date(),month),interval 2 month)
            group by 1,2) dd
on      fs.iso_date= (case when week_start_date = date_trunc(current_date,week(monday)) then current_date-1 else week_end_date end )
and     subscription_state <<>> 'BILLING RETRY'
and fs.iso_date>>="2024-03-01"
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as sp
on fs.plan_id=sp.plan_id
where date_trunc(iso_date,month)<<=date_trunc(current_date(),month)
group by 1,2
)

-------------------------------------------vendor coverage----------------------------------------------------------------------
,tpro_vendor_history_daily AS (
SELECT
 date_add(date,interval - 1 day) as date    
 ,vendor_id
FROM
 `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history`
WHERE DATE_TRUNC(date, MONTH)>>="2024-03-01"
GROUP BY ALL
)

,vendor_vertical as (
SELECT distinct date,a.chain_id,vendor_id,vertical_class,sub_vertical
from 
(select distinct date,v.chain_id,vendor_id
from `tlb-data-prod.data_platform.dim_vendor_info` v
left join `tlb-data-prod.data_platform.dim_chain` c
on v.chain_id = c.chain_id
cross join `tlb-data-prod.data_platform.dim_date` dd
where date between date_add(date_trunc((current_date),month), interval -12 month) and current_date  
) as a
left join `tlb-data-prod.data_platform.dim_chain_history` as dv
on a.chain_id=dv.chain_id
and a.date between dv.valid_from and dv.valid_to
)




,talabat_kpis as (
SELECT
  fi.order_date
  ,fi.country_iso
  ,fi.vendor_id
  ,sum(fi.gmv_amount_lc) as  talabat_gmv_amount_lc
  ,sum(fi.gmv_amount_eur) as talabat_gmv_amount_eur
  
FROM `tlb-data-prod.data_platform.fct_order_info` fi
WHERE is_successful
AND DATE_TRUNC(fi.order_date, MONTH) >>="2024-03-01"
GROUP BY ALL
)


,vendors_online_status_daily as ( 
SELECT 
   DATE(valid_at) date,
   RIGHT(global_entity_id,2) country_code,
   a.vendor_id
     FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors_history` a
  WHERE
    is_online = true
    AND global_entity_id in ('HF_EG','TB_BH','TB_JO','TB_IQ','TB_KW','TB_OM','TB_QA','TB_AE','HS-SA')
    AND DATE_TRUNC(DATE(valid_at), MONTH)>>="2024-03-01"
  GROUP BY ALL
)


,vendors_active_online_status_daily as (SELECT order_date as date,country_iso country_code,cast(vendor_id as string) as vendor_id
from talabat_kpis
union all
select date,country_code,vendor_id
from vendors_online_status_daily)



,tpro_vendor_status_weekly as (
SELECT    
 "Weekly" as aggregation_level
 ,date_trunc(os.date,week(monday)) as date
 ,os.country_code
 ,CASE WHEN lower(vv.vertical_class)="food" THEN "Food"
 WHEN lower(vv.vertical_class)="non-food" and lower(vv.sub_vertical)="darkstore" then "tmart"
 else "NFV" end as vendor_vertical_type
 ,count(distinct os.vendor_id) as talabat_active_online_vendor_count
 ,count(distinct th.vendor_id) as pro_active_online_vendor_count
FROM
vendors_active_online_status_daily as os
 LEFT JOIN  (select distinct date,vendor_id,vertical_class,sub_vertical
    FROM vendor_vertical as vv
    WHERE case when date_trunc(date,week(monday))=date_trunc(current_date(),week(monday)) 
            then current_date()-1 else date_add(date_trunc(date,week(monday)),interval 6 day) end =date
   ) as vv
ON os.vendor_id=cast(vv.vendor_id as string)
AND date_trunc(os.date,week(monday))=date_trunc(vv.date,week(monday))
LEFT JOIN   (select 
             vendor_id,
            date_trunc(case when date_trunc(tw.date,week(monday))=date_trunc(current_date(),week(monday)) 
                             then current_date()-1 else date_add(date_trunc(tw.date,week(monday)),interval 6 day) end,week 
            (monday)) as week
            from tpro_vendor_history_daily   as tw
            where case when date_trunc(tw.date,week(monday))=date_trunc(current_date(),week(monday)) 
                      then current_date()-1 else date_add(date_trunc(tw.date,week(monday)),interval 6 day) end=date
            GROUP BY all
                                   
            ) as th /*ensuring vendor is active on tpro on last day of the month(or lastest day for current month)*/
            
ON  os.vendor_id=cast(th.vendor_id as string)
AND date_trunc(os.date,week(monday))=th.week 

GROUP by all
)


,final_vendor_count_data as (
SELECT    
  aggregation_level
 ,date
 ,country_code
 ,vendor_vertical_type
 ,talabat_active_online_vendor_count
 ,pro_active_online_vendor_count
 FROM tpro_vendor_status_weekly
 
)


,final_gmv_data as (
SELECT
"Weekly" as aggregation_level
 ,country_iso as country_code
 ,date_trunc(order_date,week(monday)) as date
 ,CASE WHEN lower(vv.vertical_class)="food" THEN "Food"
 WHEN lower(vv.vertical_class)="non-food" and lower(vv.sub_vertical)="darkstore" then "tmart"
 else "NFV" end as vendor_vertical_type 
 ,sum(talabat_gmv_amount_lc) as talabat_gmv_lc
 ,sum(talabat_gmv_amount_eur) as talabat_gmv_eur
 ,sum(case when tw.vendor_id is not null then talabat_gmv_amount_lc else 0 end ) as pro_vendor_gmv_lc 
 ,sum(case when tw.vendor_id is not null then talabat_gmv_amount_eur else 0 end ) as pro_vendor_gmv_eur

FROM
talabat_kpis as t
LEFT JOIN  (select distinct date,vendor_id,vertical_class,sub_vertical
    FROM vendor_vertical as vv
    WHERE case when date_trunc(date,week(monday))=date_trunc(current_date(),week(monday)) 
            then current_date()-1 else date_add(date_trunc(date,week(monday)),interval 6 day) end =date
   ) as vv
ON t.vendor_id=(vv.vendor_id )
AND date_trunc(t.order_date,week(monday))=date_trunc(vv.date,week(monday))
LEFT JOIN tpro_vendor_history_daily as tw
ON t.vendor_id=tw.vendor_id
AND date_add(date_trunc(t.order_date,week(monday)),interval 6 day)= tw.date
group by all

)



,final_vendor_coverage as (select 
fgd.country_code,
fgd.date,
sum(pro_vendor_gmv_lc) as pro_vendor_gmv_lc,
sum(talabat_gmv_lc) as talabat_gmv_lc,
 sum(case when fgd.vendor_vertical_type="NFV" then pro_vendor_gmv_lc else 0 end) as pro_nfv_vendor_gmv_lc,
 sum(case when fgd.vendor_vertical_type="NFV" then talabat_gmv_lc else 0 end) as talabat_nfv_gmv_lc, 
 sum(case when fgd.vendor_vertical_type="Food" then pro_vendor_gmv_lc else 0 end) as pro_food_gmv_lc,
 sum(case when fgd.vendor_vertical_type="Food" then talabat_gmv_lc else 0 end)  as talabat_food_gmv_lc,
 sum(pro_active_online_vendor_count) as pro_vendor_count,
 sum(talabat_active_online_vendor_count) as talabat_vendor_count,
 sum(case when tm.vendor_vertical_type="NFV" then pro_active_online_vendor_count else 0 end) as pro_nfv_vendor_count,
 sum(case when tm.vendor_vertical_type="NFV" then    talabat_active_online_vendor_count else 0 end)  as talabat_nfv_vendor_count, 
 sum(case when tm.vendor_vertical_type="Food" then pro_active_online_vendor_count else 0 end) as pro_food_vendor_count,
 sum( case when tm.vendor_vertical_type="Food" then talabat_active_online_vendor_count else 0 end) as talabat_food_vendor_count

from
final_gmv_data as fgd
left join final_vendor_count_data as tm
on fgd.date=tm.date
and fgd.aggregation_level=tm.aggregation_level
and fgd.country_code=tm.country_code
and fgd.vendor_vertical_type=tm.vendor_vertical_type
where fgd.aggregation_level="Weekly"
group by all
)



,pro_gmv as (
select
date_trunc(order_date,week(monday)) as week,
o.country_code,
count(distinct o.account_id) as talabat_customers,
sum(gmv_amount_lc) as talabat_gmv,
count(distinct order_id) as talabat_orders,
sum(case when plan_id not in (31,34,41,42) and s.account_id is not null then gmv_amount_lc else 0 end) as regular_customers_gmv,
sum(case when plan_id in (31,34,41,42) and s.account_id is not null then gmv_amount_lc else 0 end) as partnerships_customers_gmv,


count(distinct case when plan_id in (31,34,41,42) and s.account_id is not null then order_id else 0 end) as partnerships_customers_all_orders,
count(distinct case when plan_id in (31,34,41,42) and s.account_id is not null and is_tpro_order then order_id else 0 end) as partnerships_customers_pro_orders,


count(distinct case when plan_id not in (31,34,41,42) and s.account_id is not null then order_id else 0 end) as regular_customers_all_orders,
count(distinct case when plan_id not in (31,34,41,42) and s.account_id is not null and pv.vendor_id is null then order_id else 0 end) as regular_customers_non_pro_vendor_order,
count(distinct case when plan_id not in (31,34,41,42) and s.account_id is not null and is_tpro_order is false then order_id else 0 end) as regular_customers_all_non_pro_order,
count(distinct case when plan_id not in (31,34,41,42) and s.account_id is not null and is_tpro_order then order_id else 0 end) as regular_customers_pro_orders


from
`tlb-data-prod.data_platform.fct_order_info` as o

LEFT join (select * from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as s
            where subscription_state<<>>"BILLING RETRY"
            and iso_date>>= date_sub(date_trunc(current_date(),month),interval 2 month)) as s
 on o.account_id=s.account_id
 and o.order_date=iso_date
 and o.country_code=country
 and order_time between start_date and end_date
 LEFT JOIN  (select date_sub(date,interval 1 day) as date,vendor_id
             from  `tlb-data-prod.data_platform_rest_tables.tpro_vendor_history` pv
             group by all) as pv
 on pv.date=date_add(date_trunc(order_date,week(monday)),interval 6 day)---
 and  pv.vendor_id = o.vendor_id 
where is_successful
and order_date>>= date_sub(date_trunc(current_date(),month),interval 2 month)
group by 1,2
)


,rolling_kpis as (
select
country_code,
week_start_date as week,
count(distinct account_id) as rolling_talabat_customers
from
(select week_start_date,week_end_date from `tlb-data-prod.data_platform.dim_date`where week_start_date>>='2024-02-01'and week_start_date <<current_date  group by 1,2) a
inner join `tlb-data-prod.data_platform.fct_order_info`
on order_date between date_sub(week_end_date,interval 30 day) and week_end_date
and order_date>>= date_sub(date_trunc(current_date(),month),interval 2 month)
and week_start_date>>= date_sub(date_trunc(current_date(),month),interval 2 month)
and is_successful
group by 1,2)

,churn_weekly as (
select
date as week,
country_code,
count(distinct case when tpro_subscription_status_including_partnership="Churned" then account_id end) as all_churn_count,
count(distinct account_id) as all_upforrenewal_count,
count(distinct case when churn_type_including_partnership='Voluntary Churn' then account_id end ) as all_voluntary_churn_count,
count(distinct case when churn_type_including_partnership='Involuntary Churn' then account_id end ) as all_involuntary_churn_count,


count(distinct case when tpro_subscription_status_excluding_partnership="Churned" and plan_id not in (31,34,41,42) then account_id end) as regular_churn_count,
count(distinct case when plan_id not in (31,34) then account_id end) as regular_upforrenewal_count,
count(distinct case when churn_type_excluding_partnership='Voluntary Churn' and plan_id not in (31,34,41,42) then account_id end ) as regular_voluntary_churn_count,
count(distinct case when churn_type_excluding_partnership='Involuntary Churn' and plan_id not in (31,34,41,42) then account_id end ) as regular_involuntary_churn_count
from
tlb-data-prod.data_platform.fct_tpro_churn
where lower(snapshot_interval)="weekly"
group by all
)

,addressable_universe as (
select
 country_code,
 date as week,
 talabat_user_count as addressable_talabat_user_count,
 tpro_subscriber_count as addressable_tpro_subscriber_count

from 
`tlb-data-prod.data_platform.agg_tpro_addressable_universe_monthly_weekly` 
where lower(aggregation_level)="weekly"
and addressable_universe_tag="Addressable Universe"
and date>>="2024-04-01"
)




select
eow.country, 
eow.week,
tpro_active_subscribers,
tpro_ltp_active_subscribers,
total_active_subscribers,
talabat_gmv,
talabat_orders,
regular_customers_gmv,
partnerships_customers_gmv,
partnerships_customers_all_orders,
partnerships_customers_pro_orders,
regular_customers_all_orders,
regular_customers_pro_orders,
regular_customers_non_pro_vendor_order,


talabat_customers,
rolling_talabat_customers,
regular_customers_all_non_pro_order,
all_churn_count,
all_upforrenewal_count,
all_voluntary_churn_count,
all_involuntary_churn_count,
regular_churn_count,
regular_upforrenewal_count,
regular_voluntary_churn_count,
regular_involuntary_churn_count,

addressable_talabat_user_count,
addressable_tpro_subscriber_count,

 pro_vendor_gmv_lc,
 talabat_gmv_lc,
 pro_nfv_vendor_gmv_lc,
talabat_nfv_gmv_lc, 
 pro_food_gmv_lc,
  talabat_food_gmv_lc,
 pro_vendor_count,
 talabat_vendor_count,
 pro_nfv_vendor_count,
 talabat_nfv_vendor_count, 
 pro_food_vendor_count,
talabat_food_vendor_count






from 
eow left join pro_gmv as p
on eow.week=p.week
and eow.country=p.country_code
left join churn_weekly as cw
on cw.week=eow.week
and cw.country_code=eow.country
left join rolling_kpis as rk
on rk.week=eow.week
and rk.country_code=eow.country
left join addressable_universe as au
on eow.week=au.week
and eow.country=au.country_code
left join final_vendor_coverage as vc
on eow.week=vc.date
and eow.country=vc.country_code


group by all
order by 1,2]]></relation>
                  <relation connection='bigquery.1cjkvj50m3r3sc10dyo3o1nxroat' name='Custom SQL Query1' type='text'><![CDATA[with acqns as 
(select 
a.country,
DATE(date_trunc(a.start_date, week(monday))) as week_start_date,
a.account_id,
case when c.plan_price_lc = 0 then 'Lite' else 'Regular' END as plan_type, 
from `tlb-data-prod.data_platform_rest_tables.customers_d` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id
where DATE(date_trunc(a.start_date, MONTH)) between '2021-10-01' and date_trunc(CURRENT_DATE, MONTH)
group by 1,2,3,4)

,


eow as (
select 
a.country, 
DATE(date_trunc(a.iso_date, week(monday))) as week,
a.account_id
from  
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id 
inner join (select week_start_date,week_end_date
            from `tlb-data-prod.data_platform.dim_date` dd 
            where  dd.date >>= '2023-01-01'
            group by 1,2) dd
on      a.iso_date = (case when week_start_date = date_trunc(current_date,week(monday)) then current_date-1 else week_end_date end )
where a.subscription_state <<>> 'BILLING RETRY'
--and account_id=1023407
--and account_id=2561533
group by 1,2,3
order by 1,2,3)
,

-- Acquisitions movement has been studied
acqns_status as 
(select 
a.country, 
a.week_start_date,
count(distinct case when a.plan_type = 'Regular' then a.account_id END) as acqns_reg,
count(distinct case when a.plan_type = 'Lite' then a.account_id END) as acqns_lite,
count(distinct case when a.plan_type = 'Lite' and pln.plan_price_lc <<>> 0 then b.account_id END) as acqns_lite_moved_to_reg,
count(distinct case when a.plan_type = 'Regular' and pln.plan_price_lc = 0 then b.account_id END) as acqns_reg_moved_to_lite
from acqns as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, week(monday)) = a.week_start_date then 
CURRENT_DATE - 1 else last_day(a.week_start_date,week(monday)) END) 
and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
group by 1,2
order by 1,2)

-- select * from acqns_status where country="AE" order by week_start_date
-- and week_start_date>>="2024-03-04"
,

paid as 
(select 
a.country,
DATE(date_trunc(a.start_date, week(monday))) as week_start_date,
a.start_date,
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
subscription_state
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id  
where DATE(date_trunc(a.start_date, week(monday))) between '2021-10-01' and date_trunc(CURRENT_DATE, week(monday))
and subscription_state IN  ('PAID','FREE')
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, week(monday))), a.account_id ORDER BY a.iso_date) = 1)

--select count(distinct account_id) from paid where country="AE" and week_start_date="2024-03-04"
,

winbacks as 
(select 
a.country, 
a.week_start_date, 
DATE_ADD(a.week_start_date, INTERVAL -1 week),
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
a.subscription_state,
case when pln.plan_price_lc = 0 then 'Lite' else 'Regular' END as plan_type
from paid as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln
on a.prev_plan_id = pln.plan_id
left join eow as b 
on a.country = b.country and a.account_id = b.account_id 
and DATE_ADD(a.week_start_date, INTERVAL -1 week) = b.week
left join acqns as c
on a.country = c.country and 
a.account_id = c.account_id and 
a.week_start_date = c.week_start_date
where b.account_id is null and c.account_id is null
)
-- select * from winbacks order by week_start_date
,

winbacks_organic as 
(select 
a.country, 
a.week_start_date,
count(distinct case when a.subscription_state="PAID" then a.account_id end) as regular_winbacks_all,
count(distinct case when a.prev_subs_type_gp <<>> 'BILLING RETRY' and a.subscription_state="PAID" then a.account_id end ) as regular_winbacks_organic,
count(distinct case when a.subscription_state="FREE" then a.account_id end) as partnerships_winbacks_all

from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country 
and b.iso_date = (case when date_trunc(CURRENT_DATE, week(monday)) = a.week_start_date then 
CURRENT_DATE - 1 else last_day(a.week_start_date,week(monday)) END) 
and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
--where a.prev_subs_type_gp <<>> 'BILLING RETRY'
group by 1,2
order by 1,2)

-- select * from winbacks_organic where week_start_date="2024-02-26" and country="AE"
-- and account_id=2561533


--  select * from winbacks_organic where country="AE" and week_start_date="2024-03-04"
-- and account_id=1023407
-- select * from paid where account_id=1023407 order by week_start_date
-- --select * from winbacks order by week_start_date

,
acq_winbacks as  
(select 
a.country,
a.week_start_date,
a.acqns_reg ,
a.acqns_lite,
acqns_lite_moved_to_reg,
acqns_reg_moved_to_lite,
b.regular_winbacks_organic,
b.regular_winbacks_all,
partnerships_winbacks_all,
a.acqns_reg+coalesce(b.regular_winbacks_all,0) + coalesce(a.acqns_lite_moved_to_reg,0)   as regular_acquisitions,
a.acqns_lite +a.acqns_reg + coalesce(a.acqns_lite_moved_to_reg,0)+coalesce(acqns_reg_moved_to_lite,0)  +coalesce(b.partnerships_winbacks_all)+coalesce(b.regular_winbacks_all,0) as total_acquisitions

from 
acqns_status as a 
left join winbacks_organic as b 
on a.country = b.country and a.week_start_date = b.week_start_date 
order by 1,2)

select * from acq_winbacks]]></relation>
                </relation>
                <relation connection='bigquery.1cjkvj50m3r3sc10dyo3o1nxroat' name='Weekly ROI' type='text'><![CDATA[----getting weekly data-----------------------

with weeks as 
(
select
 distinct
 country_code,
 week_start_date as week_start,
 week_end_date as week_end

from 
 (select 
 distinct
 week_start_date,
 week_end_date
 from

 `tlb-data-prod.data_platform.dim_date` 
  where date>>=date_sub(date_trunc(current_date(),week(monday)),interval 4 week) and date <<current_date()
 ) as b
cross join 
( select 
  distinct country_code
 from `tlb-data-prod.data_platform.dim_country_info`
 where country_code not in ("EG","IQ","SA","LB")
)

)
-------------------------------------------------,
,delivery_fee_savings as 
(select
  w.country_code,
  week_start,
  sum(case when b.is_tgo and d.is_grocery_darkstore = FALSE then b.tpro_discount_lc else 0 END) + 
  sum(case when b.is_tgo = FALSE and d.is_grocery_darkstore = FALSE then b.tpro_discount_lc else 0 END)+
  sum(case when b.is_successful and d.is_grocery_darkstore then dps_delivery_fee_local else 0 END) as delivery_savings
from  weeks as w left join 
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
on a.iso_date between date_sub(week_end,interval 30 day) and week_end
and a.country=w.country_code
inner join `tlb-data-prod.data_platform.fct_order_info` as b 
on a.account_id = b.account_id 
and a.iso_date = DATE(b.order_date) 
and (b.order_time between a.start_date and a.end_date) 
and a.country = b.country_iso and b.is_successful  and b.is_tpro_order
and a.plan_id not in (31,34)
inner join `tlb-data-prod.data_platform.dim_chain` as dc on b.chain_id = dc.chain_id 
and b.country_iso = dc.country_code
inner join `tlb-data-prod.data_platform.dim_vendor_info` as d on b.vendor_id = d.vendor_id
inner join `tlb-data-prod.data_platform_billing.billingdata` as bd on b.order_id = bd.orderid and b.transaction_id = bd.transactionid
left join `tlb-data-prod.data_platform.fct_billing` as fn
on b.order_id = fn.order_id 
left join `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps on cast(dps.platform_order_code as int) = b.order_id
and dps.entity_id in ('TB_AE', 'TB_KW', 'TB_QA', 'TB_BH', 'TB_JO', 'TB_OM')
and dps.created_date >>='2024-04-01'
left join `tlb-data-prod.data_platform.fct_incentive_order_detail` as dis on b.order_id = dis.order_id and lower(dis.incentive_sub_type) in ('menu discount')
and lower(campaign_name) not like '%item%'
where b.is_tpro_order 
and date_trunc(a.iso_date, MONTH) between date_sub(date_trunc(current_date(),month),interval 3 month) and current_date()
group by all
)


,reward_discounts as (select
w.country_code,
week_start, 
sum(case when (country_iso in ("BH","OM","JO","KW") and dd.subscription_restriction = 3 and discount_type = "FLAT" and s.account_id is not null) or (country_iso in ("AE") and s.account_id is not null) then order_discount_lc else 0 end) as rewards_discount

from weeks as w left join 
`tlb-data-prod.data_platform.dim_incentives_voucher_details` a
on a.used_date between date_sub(week_end,interval 30 day) and week_end
and a.country_code=w.country_code
inner join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
inner join `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
inner join `tlb-data-prod.data_platform_loyalty.voucher_option_categories` dd on b.voucher_option_category_id = dd.id
inner join `tlb-data-prod.data_platform.fct_order_info` d on a.order_id = cast(d.order_id as string) 
inner join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as s
on d.account_id = s.account_id and d.country_code = s.country  
and d.order_date = s.iso_date and s.subscription_state <<>> 'BILLING RETRY' and s.plan_id not in (31,34)
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on s.plan_id = pln.plan_id and pln.plan_price_lc <<>> 0 
where cc.discriminator in ('TPRO','LOYALTY')
and is_deleted = FALSE
and a.is_used
and d.is_successful
group by all
order by 1,2,3)



,subscription_revenue as (select 
a.country_code,
a.week_start,
a.week_end,
sum(case when (DATE(b.start_date_revised) between DATE_ADD(a.week_end, INTERVAL -30 DAY) and a.week_end)  then paid_monthly  else 0 END) as membership_revenues
from weeks as a
left join `tlb-data-prod.data_platform_rest_tables.tpro_amortized_revenue_monthly` as b  
on a.country_code = b.country
and (DATE(b.start_date_revised) between DATE_ADD(a.week_end, INTERVAL -30 DAY) and a.week_end)
left outer join `tlb-data-prod.data_platform.dim_country_info` as tax ON lower(a.country_code) = lower(tax.country_code)
--where account_id=890030 
group by all
order by 1,2)




, refund_lc_final as (
select 
a.country_code,
a.week_start,
a.week_end,
sum(case when (DATE(b.refund_date) between DATE_ADD(a.week_end, INTERVAL -30 DAY) and a.week_end) then refunds  else 0 END) as refund_lc
from weeks as a 
left join `tlb-data-prod.data_platform_rest_tables.tpro_amortized_revenue_monthly` as b  
on a.country_code = b.country
and (DATE(b.refund_date) between DATE_ADD(a.week_end, INTERVAL -30 DAY) and a.week_end)
left outer join `tlb-data-prod.data_platform.dim_country_info` as tax ON lower(a.country_code) = lower(tax.country_code)
--where account_id=890030 
group by all)



select 
a.country_code,
a.week_start,
(coalesce(a.membership_revenues,0)) membeship_revenue,
(coalesce(refund_lc,0)) as refund_lc,
coalesce(((delivery_savings)),0) as delivery_savings,
coalesce(((rewards_discount)),0) as rewards_discount

from subscription_revenue a 
left join refund_lc_final as b
on a.country_code=b.country_code
and a.week_start=b.week_start
left join delivery_fee_savings as c
on a.country_code=c.country_code
and a.week_start=c.week_start
left join reward_discounts as d
on a.country_code=d.country_code
and a.week_start=d.week_start
group by all]]></relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Health Tab SQL' inline='true' name='federated.1vo1cuu0c7fqkp14uw7cl0ehl8rj' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0w75jsx0jww9f9135rt0c1bqtiws'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='steve.chia@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Targets For Health Tab' name='cloudfile:googledrive-excel-direct.1wwc7qa092twe21bz38v11nbnr4w'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1-iiWkafmh5eVDo0wN3WPOFLEfWrB3oCPboHAEIsZ3Ik' cloudFileMetadata_-_folder='root' cloudFileName='Targets For Health Tab.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1-iiWkafmh5eVDo0wN3WPOFLEfWrB3oCPboHAEIsZ3Ik/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Targets For Health Tab.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='steve.chia@talabat.com' validate='no' workgroup-auth-mode='prompt' />
