            <column caption='Customers Savings Multiple - 1M' datatype='real' name='[ROI (rewards+Pro) - WIP (copy)_1948932751494205440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([stp_tgo_df])+sum([stp_tmart_df])+sum([stp_tmp_df])+sum(stp_rewards_savings))/&#13;&#10;sum([stp_tpro_subfee])' />
