    <worksheet name='Weekly Pro Only'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pro (excluding partnerships)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/NewHealthTab-WIP/WeeklyProOnly?rev=' id='WeeklyProOnly' path='/t/Talabat/workbooks/NewHealthTab-WIP' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Health Tab Weekly' name='federated.1tqhhyi197jplw1blam7f189wb0w' />
          </datasources>
          <datasource-dependencies datasource='federated.1tqhhyi197jplw1blam7f189wb0w'>
            <column caption='Adoption%' datatype='real' name='[Calculation_1208372085250658304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_active_subscribers])/SUM([rolling_talabat_customers])' />
            </column>
            <column caption='Voluntary Churn%' datatype='real' name='[Calculation_1208372085271777281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_voluntary_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='Involuntary Churn%' datatype='real' name='[Calculation_1208372085286330370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_involuntary_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='% orders from pro subscribers on non-pro vendors' datatype='real' name='[Calculation_1208372085290237955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_customers_non_pro_vendor_order])/SUM([regular_customers_all_orders])' />
            </column>
            <column caption='Pro Customer GMV Coverage' datatype='real' name='[Calculation_1536853437642969088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_customers_gmv])/SUM([talabat_gmv])' />
            </column>
            <column caption='% Adoption from Addressable Base' datatype='real' name='[Calculation_1815232136466874368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([addressable_tpro_subscriber_count])/SUM([addressable_talabat_user_count])' />
            </column>
            <column caption='Customers Saving Multiplier' datatype='real' name='[Calculation_1903052330913304577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(([delivery_savings])+([rewards_discount]))/&#13;&#10;(SUM([membeship_revenue])-SUM([refund_lc]))' />
            </column>
            <column caption='Vendor Count Coverage' datatype='real' name='[Calculation_859343135011217408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pro_vendor_count])/sum([talabat_vendor_count])' />
            </column>
            <column caption='Vendor Count Coverage (Food)' datatype='real' name='[Calculation_859343135011815425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_food_vendor_count])/sum([talabat_food_vendor_count])' />
            </column>
            <column caption='LTP Adoption%' datatype='real' name='[Calculation_960111210374422528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers])/SUM([tpro_active_subscribers])' />
            </column>
            <column caption='Churned%' datatype='real' name='[Calculation_960111210374733825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='Utilization%' datatype='real' name='[Calculation_960111210375008258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_customers_pro_orders])/SUM([regular_customers_all_orders])' />
            </column>
            <column caption='tPro Order Share' datatype='real' name='[Calculation_960111210375213059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_customers_all_orders])/SUM([talabat_orders])' />
            </column>
            <column caption='GMV Vendor Coverage' datatype='real' name='[Calculation_960111210380984324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_vendor_gmv_lc])/SUM([talabat_gmv])' />
            </column>
            <column caption='Exclude Current Week' datatype='boolean' name='[Calculation_960111210696585223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [week], TODAY()) != 0' />
            </column>
            <column caption='tpro Acquisitions' datatype='integer' name='[Calculation_960111210716106760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_acquisitions])' />
            </column>
