      <column caption='Adoption GMV Color ' datatype='string' name='[Adoption Color (copy)_495958958546898965]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Adoption GAP (copy)_495958958546604051] &gt; 0 then &quot;RED&quot; ELSE &quot;GREEN&quot; END' />
      </column>
      <column caption='Adoption Color 2' datatype='string' name='[Adoption Color (copy)_495958958547001366]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([rewards customer adoption target]) &lt;&gt; 0 then &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
      </column>
      <column caption='Adoption GMV Color 2' datatype='string' name='[Adoption Color 2 (copy)_495958958547185687]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([rewards customer gmv adoption target]) &lt;&gt; 0 then &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
      </column>
      <column caption='Adoption GMV GAP' datatype='real' name='[Adoption GAP (copy)_495958958546604051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rewards customer gmv adoption target]) - SUM([redeeming_customer_gmv_perc_incl_raffle])' />
      </column>
      <column caption='Empty' datatype='integer' name='[Calculation_495958958536470537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Adoption GAP' datatype='real' name='[Calculation_495958958546386962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rewards customer adoption target]) - SUM([redeeming_customer_perc_incl_raffle])' />
      </column>
      <column caption='Adoption Color' datatype='string' name='[Calculation_495958958546735124]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_495958958546386962] &gt; 0 then &quot;RED&quot; ELSE &quot;GREEN&quot; END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_6684749267226292225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;Monthly&apos; THEN [dated] &gt;= DATEADD(&apos;month&apos;,-12,TODAY()) AND [dated] &lt;= DATEADD(&apos;month&apos;,0,TODAY())&#10;ELSEIF  [granularity] = &apos;Daily&apos; THEN [dated] &gt;= TODAY() - 120 END' />
      </column>
      <column caption='% Redeemers movement' datatype='real' name='[Calculation_6684749267249307653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([redeeming_customer_perc_incl_raffle])) - LOOKUP(ZN(SUM([redeeming_customer_perc_incl_raffle])), 1)'>
          <table-calc ordering-type='Rows' />
