          </metadata-record>
          <metadata-record class='column'>
            <remote-name>orders_late_greater_than_10_min</remote-name>
            <remote-type>20</remote-type>
            <local-name>[orders_late_greater_than_10_min]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>orders_late_greater_than_10_min</remote-alias>
            <local-type>integer</local-type>
