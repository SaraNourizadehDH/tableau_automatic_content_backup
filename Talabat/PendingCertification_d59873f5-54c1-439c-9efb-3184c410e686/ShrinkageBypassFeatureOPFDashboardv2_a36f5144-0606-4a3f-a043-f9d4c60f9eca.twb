            <column-instance column='[order_hour]' derivation='None' name='[none:order_hour:ok]' pivot='key' type='ordinal' />
            <column caption='Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[order_hour]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1896578412782563331]' derivation='Sum' name='[sum:Calculation_1896578412782563331:qk]' pivot='key' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
