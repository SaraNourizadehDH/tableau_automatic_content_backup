          </datasource-dependencies>
          <filter class='categorical' column='[federated.1kvezwk0ztsyie1aauh8a0c39otd].[none:Time Interval (copy)_466967000770736130:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Time Interval (copy)_466967000770736130:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Time Interval (copy)_466967000770736130:nk]' member='&quot;2025-04-27 12:22:00 to 2025-04-28 09:14:00&quot;' />
