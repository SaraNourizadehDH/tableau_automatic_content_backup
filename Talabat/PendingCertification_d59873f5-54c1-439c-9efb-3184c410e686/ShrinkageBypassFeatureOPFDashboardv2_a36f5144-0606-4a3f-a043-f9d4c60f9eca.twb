      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_5D5982AB26D048A1A5B7E8D3C0D5B668'>
            <properties context=''>
              <relation connection='bigquery.1nwjpby1syrwyt14bgfz8102wjfc' name='Custom SQL Query' type='text'>/* ───────────────────────────────
   PARAMETERS
   ─────────────────────────────── */
WITH params AS (
  SELECT
    DATE(&apos;2025-04-28&apos;)                               AS start_date,
    DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)         AS end_date
),

/* ───────────────────────────────
   SHRINKAGE CALENDAR
   ─────────────────────────────── */
shrinkage_dates AS (
  SELECT
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                        &apos;Asia/Dubai&apos;))               AS input_date_utc,
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, end_date),
                        &apos;Asia/Dubai&apos;))               AS end_date_utc,
    DATE(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                   &apos;Asia/Dubai&apos;))                    AS shrinkage_start_date,
    shrinkage_on,
    duration_hours
  FROM `tlb-data-prod.data_platform_google_sheet.logistics_shrinkage_opf_timestamps_experiment`
  ORDER BY 1 DESC
),

/* ───────────────────────────────
   CVR
   ─────────────────────────────── */
cvr AS (
  SELECT
    sc.country_code,
    dil.city_name,
    DATE(sc.sub_session_start_time)                           AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    SAFE_DIVIDE(SUM(CAST(attempted_place_order AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4a,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(attempted_place_order  AS INT64)))   AS mCVR4b
  FROM `tlb-data-prod.data_platform.fct_sub_session_cart` sc
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON sc.sub_session_start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(sc.sub_session_start_time) BETWEEN (SELECT start_date FROM params)
                                           AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   OPF
   ─────────────────────────────── */
opf AS (
  SELECT
    ses.country_code,
    dil.city_name,
    DATE(ses.start_time)                                  AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed     THEN ses.session_id END) AS opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS opf_den,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed
                          AND ses.placed_order              THEN ses.session_id END) AS success_opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS success_opf_den
  FROM `tlb-data-prod.data_platform.fct_session` ses
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON ses.start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(ses.start_time) BETWEEN (SELECT start_date FROM params)
                                 AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   ALL ORDERS
   ─────────────────────────────── */
all_orders AS (
  SELECT
    o.country_code,
    o.order_date,
    dil.city_name,
    o.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.shrinkage_start_date,
    sd.input_date_utc,
    sd.end_date_utc,
    contact_stakeholder,
    contact_reason_l1,
    EXTRACT(HOUR FROM order_time) as order_hour,
    COUNT(DISTINCT o.order_id)                                              AS total_orders,
    COUNT(DISTINCT CASE WHEN o.is_successful                    THEN o.order_id END) AS total_orders_successful,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful                THEN o.order_id END) AS total_orders_failed,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful
                          AND f.is_logistics_reason             THEN o.order_id END) AS total_failed_logistics_orders,
    COUNT(DISTINCT c.contact_id)                                           AS total_contacts,
    COUNT(DISTINCT CASE WHEN c.contact_stakeholder = &apos;customer&apos;
                         THEN c.contact_id END)                            AS total_customer_contacts,
    ROUND(SUM(d.to_vendor_time)      / 60, 2)                              AS sum_to_vendor_time,
    ROUND(SUM(d.to_customer_time)    / 60, 2)                              AS sum_to_customer_time,
    ROUND(SUM(d.actual_delivery_time)/ 60, 2)                              AS sum_delivery_time
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      contact_reason_l1,
      LOWER(contact_stakeholder) AS contact_stakeholder,
      contact_id
    FROM `tlb-data-prod.data_platform.fct_contact` e
    JOIN `tlb-data-prod.data_platform.dim_contact_reason`         USING (contact_reason_id)
    JOIN `tlb-data-prod.data_platform.dim_contact_stakeholder` g  ON e.stakeholder_id = g.contact_stakeholder_id
    WHERE contact_date_utc BETWEEN (SELECT start_date FROM params)
                               AND (SELECT end_date   FROM params)
      AND order_id IS NOT NULL
  ) c ON CAST(o.order_id AS STRING) = c.order_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`   f USING (order_fail_reason_id)
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      to_vendor_time,
      to_customer_time,
      actual_delivery_time
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery`
    WHERE created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  ) d ON o.order_id = d.order_id AND LOWER(o.country_code) = LOWER(d.country_code)
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`       dil ON o.delivery_location_id = dil.location_id
  LEFT JOIN shrinkage_dates sd
         ON o.order_time_utc BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE o.order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
    AND is_non_food = FALSE
    AND is_vendor_under_shrinkage IS NOT NULL
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND o.is_vendor_under_shrinkage = TRUE)
  GROUP BY ALL
),

/* ───────────────────────────────
   DELAY METRICS
   ─────────────────────────────── */
delay AS (
  SELECT
    lo.created_date,
    LOWER(info.country_code)                               AS country_code,
    info.city_id,
    info.city_name,
    info.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(lo.promised_delivery_time) AS total_promised_delivery_time,
    SUM(lo.actual_delivery_time)   AS total_actual_delivery_time,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.rider_late / 60  &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.rider_late IS NOT NULL THEN lo.order_code END)
    ) AS rider_late_orders_10min_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.vendor_late / 60 &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.vendor_late IS NOT NULL THEN lo.order_code END)
    ) AS vendor_delay_10mins_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.primary_stacked_count &gt;&gt; 0 THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN UPPER(lo.order_status) = &apos;COMPLETED&apos; THEN lo.order_code END)
    ) AS stacking_percentage,
    COUNT(DISTINCT CASE WHEN ((CASE WHEN NOT lo.is_logistics_preorder AND lo.order_status=&apos;completed&apos; THEN lo.order_delay/60 END) &gt;&gt; 10) THEN lo.order_code END) AS orders_late_greater_than_10_min,
    SUM(lo.order_delay)                                  AS order_delay,
    COALESCE(SUM(CASE WHEN (lo.vendor_delay_v2 / 60) &gt;&gt; 10 THEN 1 END), 0) AS vendor_delay_v2
  FROM `tlb-data-prod.data_platform.fct_logistics_order` lo
  LEFT JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON lo.order_id = info.order_id AND LOWER(lo.country_code) = info.country_code
  LEFT JOIN shrinkage_dates sd ON lo.created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE lo.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND lo.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND is_vendor_under_shrinkage IS NOT NULL
    AND is_non_food = FALSE
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND info.is_vendor_under_shrinkage = TRUE)
  GROUP BY ALL
),

/* ───────────────────────────────
   DISTANCES
   ─────────────────────────────── */
distances AS (
  SELECT
    ld.country_code,
    dlc.city_name,
    ld.created_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    info.is_vendor_under_shrinkage,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(ld.pickup_distance_manhattan)   AS total_pickup_distance_manhattan,
    SUM(ld.dropoff_distance_manhattan)  AS total_dropoff_distance_manhattan
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery` ld
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` dlc USING (city_id)
  LEFT JOIN shrinkage_dates sd ON ld.order_created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  INNER JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON ld.order_id = info.order_id AND LOWER(ld.country_code) = info.country_code
  WHERE ld.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND ld.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND dlc.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
)

/* ───────────────────────────────
   FINAL AGGREGATION
   ─────────────────────────────── */
SELECT
  LOWER(a.country_code)                              AS country_code,
  a.order_date,
  a.city_name,
  a.is_vendor_under_shrinkage,
  a.shrinkage_on,
  a.input_date_utc,
  a.end_date_utc,
  a.order_hour,
  a.contact_stakeholder,
  a.contact_reason_l1,
  AVG(c.mCVR4a)                                      AS mCVR4a,
  AVG(c.mCVR4)                                       AS mCVR4,
  AVG(c.mCVR4b)                                      AS mCVR4b,
  b.opf_num,
  b.opf_den,
  b.success_opf_num,
  b.success_opf_den,
  d.vendor_delay_v2,
  d.orders_late_greater_than_10_min,
  d.order_delay,
  dis.total_dropoff_distance_manhattan,
  dis.total_pickup_distance_manhattan,
  d.total_promised_delivery_time,
  d.total_actual_delivery_time,
  SUM(a.total_orders)                                AS total_orders,
  SUM(a.total_orders_successful)                     AS total_orders_successful,
  SUM(a.total_orders_failed)                         AS total_orders_failed,
  SUM(a.total_failed_logistics_orders)               AS total_failed_logistics_orders,
  SUM(a.total_contacts)                              AS total_contacts,
  SUM(a.total_customer_contacts)                     AS total_customer_contacts,
  SUM(a.sum_to_vendor_time)                          AS sum_to_vendor_time,
  SUM(a.sum_to_customer_time)                        AS sum_to_customer_time,
  SUM(a.sum_delivery_time)                           AS sum_delivery_time,
  AVG(d.rider_late_orders_10min_percentage)          AS rider_late_orders_10min_percentage,
  AVG(d.vendor_delay_10mins_percentage)              AS vendor_delay_10mins_percentage,
  AVG(d.stacking_percentage)                         AS stacking_percentage
FROM all_orders a
LEFT JOIN cvr c ON a.order_date   = c.session_date
               AND a.country_code = c.country_code
               AND a.city_name    = c.city_name
               AND a.shrinkage_on = c.shrinkage_on
               AND a.input_date_utc = c.input_date_utc
               AND a.end_date_utc   = c.end_date_utc
LEFT JOIN opf b ON a.order_date   = b.session_date
               AND a.country_code = b.country_code
               AND a.city_name    = b.city_name
               AND a.shrinkage_on = b.shrinkage_on
               AND a.input_date_utc = b.input_date_utc
               AND a.end_date_utc   = b.end_date_utc
LEFT JOIN delay d ON a.order_date = d.created_date
                 AND LOWER(a.country_code) = LOWER(d.country_code)
                 AND a.city_name           = d.city_name
                 AND a.shrinkage_on        = d.shrinkage_on
                 AND a.input_date_utc      = d.input_date_utc
                 AND a.end_date_utc        = d.end_date_utc
                 AND a.is_vendor_under_shrinkage = d.is_vendor_under_shrinkage
                 and a.order_hour = d.order_hour
LEFT JOIN distances dis ON a.order_date = dis.created_date
                       AND LOWER(a.country_code) = LOWER(dis.country_code)
                       AND a.city_name           = dis.city_name
                       AND a.shrinkage_on        = dis.shrinkage_on
                       AND a.input_date_utc      = dis.input_date_utc
                       AND a.end_date_utc        = dis.end_date_utc
                       AND a.is_vendor_under_shrinkage = dis.is_vendor_under_shrinkage
                       AND a.order_hour = dis.order_hour
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='opf test 1' inline='true' name='federated.1kvezwk0ztsyie1aauh8a0c39otd' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0rhot5j1wna5ti120nu3p09axyik'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='balderick.bissessur@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='logistics_shrinkage_opf_timestamps_experiment' name='cloudfile:googledrive-excel-direct.05fm2ln1lw2bu919t4crx01xpqco'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1XZvOFRS3v-mW3S1_It4Uhza-RDyfnkKomODN4JzgZJk' cloudFileMetadata_-_folder='root' cloudFileName='logistics_shrinkage_opf_timestamps_experiment.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1XZvOFRS3v-mW3S1_It4Uhza-RDyfnkKomODN4JzgZJk/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='logistics_shrinkage_opf_timestamps_experiment.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='balderick.bissessur@talabat.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rhot5j1wna5ti120nu3p09axyik' name='Custom SQL Query' type='text'>/* ───────────────────────────────
   PARAMETERS
   ─────────────────────────────── */
WITH params AS (
  SELECT
    DATE(&apos;2025-04-28&apos;)                               AS start_date,
    DATE(&apos;2025-05-23&apos;)                               AS end_date
),

/* ───────────────────────────────
   SHRINKAGE CALENDAR
   ─────────────────────────────── */
shrinkage_dates AS (
  SELECT
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                        &apos;Asia/Dubai&apos;))               AS input_date_utc,
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, end_date),
                        &apos;Asia/Dubai&apos;))               AS end_date_utc,
    DATE(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                   &apos;Asia/Dubai&apos;))                    AS shrinkage_start_date,
    shrinkage_on,
    duration_hours
  FROM `tlb-data-prod.data_platform_google_sheet.logistics_shrinkage_opf_timestamps_experiment`
  ORDER BY 1 DESC
),

/* ───────────────────────────────
   CVR
   ─────────────────────────────── */
cvr AS (
  SELECT
    sc.country_code,
    dil.city_name,
    DATE(sc.sub_session_start_time)                           AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    SAFE_DIVIDE(SUM(CAST(attempted_place_order AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4a,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(attempted_place_order  AS INT64)))   AS mCVR4b
  FROM `tlb-data-prod.data_platform.fct_sub_session_cart` sc
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON sc.sub_session_start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(sc.sub_session_start_time) BETWEEN (SELECT start_date FROM params)
                                           AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   OPF
   ─────────────────────────────── */
opf AS (
  SELECT
    ses.country_code,
    dil.city_name,
    DATE(ses.start_time)                                  AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed     THEN ses.session_id END) AS opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS opf_den,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed
                          AND ses.placed_order              THEN ses.session_id END) AS success_opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS success_opf_den
  FROM `tlb-data-prod.data_platform.fct_session` ses
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON ses.start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(ses.start_time) BETWEEN (SELECT start_date FROM params)
                                 AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   ALL ORDERS
   ─────────────────────────────── */
all_orders AS (
  SELECT
    o.country_code,
    o.order_date,
    dil.city_name,
    o.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.shrinkage_start_date,
    sd.input_date_utc,
    sd.end_date_utc,
    EXTRACT(HOUR FROM order_time) as order_hour,
    COUNT(DISTINCT o.order_id)                                              AS total_orders,
    COUNT(DISTINCT CASE WHEN o.is_successful                    THEN o.order_id END) AS total_orders_successful,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful                THEN o.order_id END) AS total_orders_failed,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful
                          AND f.is_logistics_reason             THEN o.order_id END) AS total_failed_logistics_orders,
    COUNT(DISTINCT c.contact_id)                                           AS total_contacts,
    COUNT(DISTINCT CASE WHEN c.contact_stakeholder = &apos;customer&apos;
                         THEN c.contact_id END)                            AS total_customer_contacts,
    ROUND(SUM(d.to_vendor_time)      / 60, 2)                              AS sum_to_vendor_time,
    ROUND(SUM(d.to_customer_time)    / 60, 2)                              AS sum_to_customer_time,
    ROUND(SUM(d.actual_delivery_time)/ 60, 2)                              AS sum_delivery_time,
    ROUND(SUM(lo.promised_delivery_time)/ 60, 2)                              AS sum_pdt,
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  INNER JOIN (
    select order_id,
    country_code,
    promised_delivery_time
    FROM
   `tlb-data-prod.data_platform.fct_logistics_order` 
   where (promised_delivery_time / 60) &gt;&gt; 25 
  ) lo on o.order_id = lo.order_id and lower(o.country_code) = lower(lo.country_code) 
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      LOWER(contact_stakeholder) AS contact_stakeholder,
      contact_id
    FROM `tlb-data-prod.data_platform.fct_contact` e
    JOIN `tlb-data-prod.data_platform.dim_contact_reason`         USING (contact_reason_id)
    JOIN `tlb-data-prod.data_platform.dim_contact_stakeholder` g  ON e.stakeholder_id = g.contact_stakeholder_id
    WHERE contact_date_utc BETWEEN (SELECT start_date FROM params)
                               AND (SELECT end_date   FROM params)
      AND order_id IS NOT NULL
  ) c ON CAST(o.order_id AS STRING) = c.order_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`   f USING (order_fail_reason_id)
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      to_vendor_time,
      to_customer_time,
      actual_delivery_time
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery`
    WHERE created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  ) d ON o.order_id = d.order_id AND LOWER(o.country_code) = LOWER(d.country_code)
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`       dil ON o.delivery_location_id = dil.location_id
  LEFT JOIN shrinkage_dates sd
         ON o.order_time_utc BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE o.order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
    AND is_non_food = FALSE
    AND is_vendor_under_shrinkage IS NOT NULL
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND o.is_vendor_under_shrinkage = TRUE)
  GROUP BY ALL
),

/* ───────────────────────────────
   DELAY METRICS
   ─────────────────────────────── */
delay AS (
  SELECT
    lo.created_date,
    LOWER(info.country_code)                               AS country_code,
    info.city_id,
    info.city_name,
    info.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(lo.promised_delivery_time) AS total_promised_delivery_time,
    SUM(lo.actual_delivery_time)   AS total_actual_delivery_time,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.rider_late / 60  &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.rider_late IS NOT NULL THEN lo.order_code END)
    ) AS rider_late_orders_10min_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.vendor_late / 60 &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.vendor_late IS NOT NULL THEN lo.order_code END)
    ) AS vendor_delay_10mins_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.primary_stacked_count &gt;&gt; 0 THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN UPPER(lo.order_status) = &apos;COMPLETED&apos; THEN lo.order_code END)
    ) AS stacking_percentage,
    COUNT(DISTINCT CASE WHEN ((CASE WHEN NOT lo.is_logistics_preorder AND lo.order_status=&apos;completed&apos; THEN lo.order_delay/60 END) &gt;&gt; 10) THEN lo.order_code END) AS orders_late_greater_than_10_min,
    SUM(lo.order_delay)                                  AS order_delay,
    COALESCE(SUM(CASE WHEN (lo.vendor_delay_v2 / 60) &gt;&gt; 10 THEN 1 END), 0) AS vendor_delay_v2
  FROM `tlb-data-prod.data_platform.fct_logistics_order` lo
  LEFT JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON lo.order_id = info.order_id AND LOWER(lo.country_code) = info.country_code
  LEFT JOIN shrinkage_dates sd ON lo.created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE lo.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND lo.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND is_vendor_under_shrinkage IS NOT NULL
    AND is_non_food = FALSE
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND info.is_vendor_under_shrinkage = TRUE)
    AND (lo.promised_delivery_time / 60) &gt;&gt; 25
  GROUP BY ALL
),

/* ───────────────────────────────
   DISTANCES
   ─────────────────────────────── */
distances AS (
  SELECT
    ld.country_code,
    dlc.city_name,
    ld.created_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    info.is_vendor_under_shrinkage,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(ld.pickup_distance_manhattan)   AS total_pickup_distance_manhattan,
    SUM(ld.dropoff_distance_manhattan)  AS total_dropoff_distance_manhattan
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery` ld
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` dlc USING (city_id)
  LEFT JOIN shrinkage_dates sd ON ld.order_created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  INNER JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON ld.order_id = info.order_id AND LOWER(ld.country_code) = info.country_code
  WHERE ld.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND ld.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND dlc.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

shrinkage as 
(
  SELECT distinct
  s.country_code,
  created_date_local as created_date,
  EXTRACT(HOUR FROM s.created_at) as shrinkage_hour,
  s.city_name,
  sd.shrinkage_on,
  sd.input_date_utc,
  sd.end_date_utc,
  -- area_name, -- uncomment to see by area
  -- brand_grade,  -- uncomment to see by brand grade
  sum(case when is_brand_area_interval_shrinked then 1 else 0 end ) as shrinked_instance,
  count(*) as all_instances,
  sum(case when is_brand_area_interval_shrinked then 1 else 0 end ) / count(*) as shrinkage_percentage,
  sum(shrinked_vendors_count) as shrinked_vendors
  FROM `tlb-data-prod.data_platform.fct_logistics_food_brand_shrinkage` s
  left join `tlb-data-prod.data_platform.dim_location_info` l using(location_id)
  LEFT JOIN shrinkage_dates sd ON s.created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE s.created_Date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  and s.created_Date_local BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  and l.country_code = s.country_code -- removing abnormal locations
  group by all 
)

/* ───────────────────────────────
   FINAL AGGREGATION
   ─────────────────────────────── */
SELECT
  LOWER(a.country_code)                              AS country_code,
  a.order_date,
  a.city_name,
  a.is_vendor_under_shrinkage,
  a.shrinkage_on,
  a.input_date_utc,
  a.end_date_utc,
  a.order_hour,
  AVG(c.mCVR4a)                                      AS mCVR4a,
  AVG(c.mCVR4)                                       AS mCVR4,
  AVG(c.mCVR4b)                                      AS mCVR4b,
  b.opf_num,
  b.opf_den,
  b.success_opf_num,
  b.success_opf_den,
  d.vendor_delay_v2,
  d.orders_late_greater_than_10_min,
  d.order_delay,
  dis.total_dropoff_distance_manhattan,
  dis.total_pickup_distance_manhattan,
  d.total_promised_delivery_time,
  d.total_actual_delivery_time,
  SUM(a.total_orders)                                AS total_orders,
  SUM(a.total_orders_successful)                     AS total_orders_successful,
  SUM(a.total_orders_failed)                         AS total_orders_failed,
  SUM(a.total_failed_logistics_orders)               AS total_failed_logistics_orders,
  SUM(a.total_contacts)                              AS total_contacts,
  SUM(a.total_customer_contacts)                     AS total_customer_contacts,
  SUM(a.sum_to_vendor_time)                          AS sum_to_vendor_time,
  SUM(a.sum_to_customer_time)                        AS sum_to_customer_time,
  SUM(a.sum_delivery_time)                           AS sum_delivery_time,
  SUM(a.sum_pdt)                                     AS sum_pdt,
  AVG(d.rider_late_orders_10min_percentage)          AS rider_late_orders_10min_percentage,
  AVG(d.vendor_delay_10mins_percentage)              AS vendor_delay_10mins_percentage,
  AVG(d.stacking_percentage)                         AS stacking_percentage,
  AVG(s.shrinkage_percentage)                        AS avg_shrinkage_percentage,
  (s.shrinked_vendors)                            AS sum_shrinked_vendors
FROM all_orders a
LEFT JOIN cvr c ON a.order_date   = c.session_date
               AND a.country_code = c.country_code
               AND a.city_name    = c.city_name
               AND a.shrinkage_on = c.shrinkage_on
               AND a.input_date_utc = c.input_date_utc
               AND a.end_date_utc   = c.end_date_utc
LEFT JOIN opf b ON a.order_date   = b.session_date
               AND a.country_code = b.country_code
               AND a.city_name    = b.city_name
               AND a.shrinkage_on = b.shrinkage_on
               AND a.input_date_utc = b.input_date_utc
               AND a.end_date_utc   = b.end_date_utc
LEFT JOIN delay d ON a.order_date = d.created_date
                 AND LOWER(a.country_code) = LOWER(d.country_code)
                 AND a.city_name           = d.city_name
                 AND a.shrinkage_on        = d.shrinkage_on
                 AND a.input_date_utc      = d.input_date_utc
                 AND a.end_date_utc        = d.end_date_utc
                 AND a.is_vendor_under_shrinkage = d.is_vendor_under_shrinkage
                 and a.order_hour = d.order_hour
LEFT JOIN distances dis ON a.order_date = dis.created_date
                       AND LOWER(a.country_code) = LOWER(dis.country_code)
                       AND a.city_name           = dis.city_name
                       AND a.shrinkage_on        = dis.shrinkage_on
                       AND a.input_date_utc      = dis.input_date_utc
                       AND a.end_date_utc        = dis.end_date_utc
                       AND a.is_vendor_under_shrinkage = dis.is_vendor_under_shrinkage
                       AND a.order_hour = dis.order_hour
LEFT JOIN shrinkage s ON a.order_date = s.created_date 
                       AND LOWER(a.country_code) = LOWER(s.country_code)
                       AND a.city_name           = s.city_name
                       AND a.shrinkage_on        = s.shrinkage_on
                       AND a.input_date_utc      = s.input_date_utc
                       AND a.end_date_utc        = s.end_date_utc
                       AND a.order_hour = s.shrinkage_hour                
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0rhot5j1wna5ti120nu3p09axyik' name='Custom SQL Query' type='text'>/* ───────────────────────────────
   PARAMETERS
   ─────────────────────────────── */
WITH params AS (
  SELECT
    DATE(&apos;2025-04-28&apos;)                               AS start_date,
    DATE(&apos;2025-05-23&apos;)                               AS end_date
),

/* ───────────────────────────────
   SHRINKAGE CALENDAR
   ─────────────────────────────── */
shrinkage_dates AS (
  SELECT
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                        &apos;Asia/Dubai&apos;))               AS input_date_utc,
    TIMESTAMP(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, end_date),
                        &apos;Asia/Dubai&apos;))               AS end_date_utc,
    DATE(TIMESTAMP(PARSE_DATETIME(&apos;%m/%d/%Y %H:%M:%S&apos;, input_date),
                   &apos;Asia/Dubai&apos;))                    AS shrinkage_start_date,
    shrinkage_on,
    duration_hours
  FROM `tlb-data-prod.data_platform_google_sheet.logistics_shrinkage_opf_timestamps_experiment`
  ORDER BY 1 DESC
),

/* ───────────────────────────────
   CVR
   ─────────────────────────────── */
cvr AS (
  SELECT
    sc.country_code,
    dil.city_name,
    DATE(sc.sub_session_start_time)                           AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    SAFE_DIVIDE(SUM(CAST(attempted_place_order AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4a,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(started_checkout       AS INT64)))   AS mCVR4,
    SAFE_DIVIDE(SUM(CAST(placed_order          AS INT64)),
                SUM(CAST(attempted_place_order  AS INT64)))   AS mCVR4b
  FROM `tlb-data-prod.data_platform.fct_sub_session_cart` sc
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON sc.sub_session_start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(sc.sub_session_start_time) BETWEEN (SELECT start_date FROM params)
                                           AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   OPF
   ─────────────────────────────── */
opf AS (
  SELECT
    ses.country_code,
    dil.city_name,
    DATE(ses.start_time)                                  AS session_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed     THEN ses.session_id END) AS opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS opf_den,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order
                          AND ses.order_attempt_failed
                          AND ses.placed_order              THEN ses.session_id END) AS success_opf_num,
    COUNT(DISTINCT CASE WHEN ses.attempted_place_order      THEN ses.session_id END) AS success_opf_den
  FROM `tlb-data-prod.data_platform.fct_session` ses
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`   dil USING (location_id)
  LEFT JOIN shrinkage_dates sd
         ON ses.start_time BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE DATE(ses.start_time) BETWEEN (SELECT start_date FROM params)
                                 AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

/* ───────────────────────────────
   ALL ORDERS
   ─────────────────────────────── */
all_orders AS (
  SELECT
    o.country_code,
    o.order_date,
    dil.city_name,
    o.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.shrinkage_start_date,
    sd.input_date_utc,
    sd.end_date_utc,
    EXTRACT(HOUR FROM order_time) as order_hour,
    COUNT(DISTINCT o.order_id)                                              AS total_orders,
    COUNT(DISTINCT CASE WHEN o.is_successful                    THEN o.order_id END) AS total_orders_successful,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful                THEN o.order_id END) AS total_orders_failed,
    COUNT(DISTINCT CASE WHEN NOT o.is_successful
                          AND f.is_logistics_reason             THEN o.order_id END) AS total_failed_logistics_orders,
    COUNT(DISTINCT c.contact_id)                                           AS total_contacts,
    COUNT(DISTINCT CASE WHEN c.contact_stakeholder = &apos;customer&apos;
                         THEN c.contact_id END)                            AS total_customer_contacts,
    ROUND(SUM(d.to_vendor_time)      / 60, 2)                              AS sum_to_vendor_time,
    ROUND(SUM(d.to_customer_time)    / 60, 2)                              AS sum_to_customer_time,
    ROUND(SUM(d.actual_delivery_time)/ 60, 2)                              AS sum_delivery_time,
    ROUND(SUM(lo.promised_delivery_time)/ 60, 2)                              AS sum_pdt,
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  INNER JOIN (
    select order_id,
    country_code,
    promised_delivery_time
    FROM
   `tlb-data-prod.data_platform.fct_logistics_order` 
   where (promised_delivery_time / 60) &gt;&gt; 25 
  ) lo on o.order_id = lo.order_id and lower(o.country_code) = lower(lo.country_code) 
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      LOWER(contact_stakeholder) AS contact_stakeholder,
      contact_id
    FROM `tlb-data-prod.data_platform.fct_contact` e
    JOIN `tlb-data-prod.data_platform.dim_contact_reason`         USING (contact_reason_id)
    JOIN `tlb-data-prod.data_platform.dim_contact_stakeholder` g  ON e.stakeholder_id = g.contact_stakeholder_id
    WHERE contact_date_utc BETWEEN (SELECT start_date FROM params)
                               AND (SELECT end_date   FROM params)
      AND order_id IS NOT NULL
  ) c ON CAST(o.order_id AS STRING) = c.order_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`   f USING (order_fail_reason_id)
  LEFT JOIN (
    SELECT
      country_code,
      order_id,
      to_vendor_time,
      to_customer_time,
      actual_delivery_time
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery`
    WHERE created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  ) d ON o.order_id = d.order_id AND LOWER(o.country_code) = LOWER(d.country_code)
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`       dil ON o.delivery_location_id = dil.location_id
  LEFT JOIN shrinkage_dates sd
         ON o.order_time_utc BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE o.order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
    AND dil.city_name IN (&apos;Cairo&apos;,&apos;Dubai&apos;,&apos;Erbil&apos;)
    AND is_non_food = FALSE
    AND is_vendor_under_shrinkage IS NOT NULL
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND o.is_vendor_under_shrinkage = TRUE)
  GROUP BY ALL
),

/* ───────────────────────────────
   DELAY METRICS
   ─────────────────────────────── */
delay AS (
  SELECT
    lo.created_date,
    LOWER(info.country_code)                               AS country_code,
    info.city_id,
    info.city_name,
    info.is_vendor_under_shrinkage,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(lo.promised_delivery_time) AS total_promised_delivery_time,
    SUM(lo.actual_delivery_time)   AS total_actual_delivery_time,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.rider_late / 60  &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.rider_late IS NOT NULL THEN lo.order_code END)
    ) AS rider_late_orders_10min_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.vendor_late / 60 &gt;&gt; 10  THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN lo.vendor_late IS NOT NULL THEN lo.order_code END)
    ) AS vendor_delay_10mins_percentage,
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN lo.primary_stacked_count &gt;&gt; 0 THEN lo.order_code END),
      COUNT(DISTINCT CASE WHEN UPPER(lo.order_status) = &apos;COMPLETED&apos; THEN lo.order_code END)
    ) AS stacking_percentage,
    COUNT(DISTINCT CASE WHEN ((CASE WHEN NOT lo.is_logistics_preorder AND lo.order_status=&apos;completed&apos; THEN lo.order_delay/60 END) &gt;&gt; 10) THEN lo.order_code END) AS orders_late_greater_than_10_min,
    SUM(lo.order_delay)                                  AS order_delay,
    COALESCE(SUM(CASE WHEN (lo.vendor_delay_v2 / 60) &gt;&gt; 10 THEN 1 END), 0) AS vendor_delay_v2
  FROM `tlb-data-prod.data_platform.fct_logistics_order` lo
  LEFT JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON lo.order_id = info.order_id AND LOWER(lo.country_code) = info.country_code
  LEFT JOIN shrinkage_dates sd ON lo.created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE lo.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND lo.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND is_vendor_under_shrinkage IS NOT NULL
    AND is_non_food = FALSE
    AND NOT (sd.shrinkage_on = &apos;FALSE&apos; AND info.is_vendor_under_shrinkage = TRUE)
    AND (lo.promised_delivery_time / 60) &gt;&gt; 25
  GROUP BY ALL
),

/* ───────────────────────────────
   DISTANCES
   ─────────────────────────────── */
distances AS (
  SELECT
    ld.country_code,
    dlc.city_name,
    ld.created_date,
    sd.shrinkage_on,
    sd.input_date_utc,
    sd.end_date_utc,
    info.is_vendor_under_shrinkage,
    EXTRACT(HOUR FROM created_at) as order_hour,
    SUM(ld.pickup_distance_manhattan)   AS total_pickup_distance_manhattan,
    SUM(ld.dropoff_distance_manhattan)  AS total_dropoff_distance_manhattan
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery` ld
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` dlc USING (city_id)
  LEFT JOIN shrinkage_dates sd ON ld.order_created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  INNER JOIN (
    SELECT
      LOWER(oi.country_code) AS country_code,
      city_id,
      city_name,
      is_vendor_under_shrinkage,
      order_id,
      is_non_food,
      delivery_location_id
    FROM `tlb-data-prod.data_platform.fct_order_info` oi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dil ON oi.delivery_location_id = dil.location_id
    WHERE order_date BETWEEN (SELECT start_date FROM params)
                         AND (SELECT end_date   FROM params)
      AND oi.country_code IN (&apos;AE&apos;,&apos;IQ&apos;,&apos;EG&apos;)
      AND dil.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
      AND is_tgo = TRUE
      AND is_non_food = FALSE
  ) info ON ld.order_id = info.order_id AND LOWER(ld.country_code) = info.country_code
  WHERE ld.created_date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
    AND ld.country_code IN (&apos;ae&apos;,&apos;eg&apos;,&apos;iq&apos;)
    AND dlc.city_name IN (&apos;Dubai&apos;,&apos;Cairo&apos;,&apos;Erbil&apos;)
  GROUP BY ALL
),

shrinkage as 
(
  SELECT distinct
  s.country_code,
  created_date_local as created_date,
  EXTRACT(HOUR FROM s.created_at) as shrinkage_hour,
  s.city_name,
  sd.shrinkage_on,
  sd.input_date_utc,
  sd.end_date_utc,
  -- area_name, -- uncomment to see by area
  -- brand_grade,  -- uncomment to see by brand grade
  sum(case when is_brand_area_interval_shrinked then 1 else 0 end ) as shrinked_instance,
  count(*) as all_instances,
  sum(case when is_brand_area_interval_shrinked then 1 else 0 end ) / count(*) as shrinkage_percentage,
  sum(shrinked_vendors_count) as shrinked_vendors
  FROM `tlb-data-prod.data_platform.fct_logistics_food_brand_shrinkage` s
  left join `tlb-data-prod.data_platform.dim_location_info` l using(location_id)
  LEFT JOIN shrinkage_dates sd ON s.created_at BETWEEN sd.input_date_utc AND sd.end_date_utc
  WHERE s.created_Date BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  and s.created_Date_local BETWEEN (SELECT start_date FROM params)
                           AND (SELECT end_date   FROM params)
  and l.country_code = s.country_code -- removing abnormal locations
  group by all 
)

/* ───────────────────────────────
   FINAL AGGREGATION
   ─────────────────────────────── */
SELECT
  LOWER(a.country_code)                              AS country_code,
  a.order_date,
  a.city_name,
  a.is_vendor_under_shrinkage,
  a.shrinkage_on,
  a.input_date_utc,
  a.end_date_utc,
  a.order_hour,
  AVG(c.mCVR4a)                                      AS mCVR4a,
  AVG(c.mCVR4)                                       AS mCVR4,
  AVG(c.mCVR4b)                                      AS mCVR4b,
  b.opf_num,
  b.opf_den,
  b.success_opf_num,
  b.success_opf_den,
  d.vendor_delay_v2,
  d.orders_late_greater_than_10_min,
  d.order_delay,
  dis.total_dropoff_distance_manhattan,
  dis.total_pickup_distance_manhattan,
  d.total_promised_delivery_time,
  d.total_actual_delivery_time,
  SUM(a.total_orders)                                AS total_orders,
  SUM(a.total_orders_successful)                     AS total_orders_successful,
  SUM(a.total_orders_failed)                         AS total_orders_failed,
  SUM(a.total_failed_logistics_orders)               AS total_failed_logistics_orders,
  SUM(a.total_contacts)                              AS total_contacts,
  SUM(a.total_customer_contacts)                     AS total_customer_contacts,
  SUM(a.sum_to_vendor_time)                          AS sum_to_vendor_time,
  SUM(a.sum_to_customer_time)                        AS sum_to_customer_time,
  SUM(a.sum_delivery_time)                           AS sum_delivery_time,
  SUM(a.sum_pdt)                                     AS sum_pdt,
  AVG(d.rider_late_orders_10min_percentage)          AS rider_late_orders_10min_percentage,
  AVG(d.vendor_delay_10mins_percentage)              AS vendor_delay_10mins_percentage,
  AVG(d.stacking_percentage)                         AS stacking_percentage,
  AVG(s.shrinkage_percentage)                        AS avg_shrinkage_percentage,
  (s.shrinked_vendors)                            AS sum_shrinked_vendors
FROM all_orders a
LEFT JOIN cvr c ON a.order_date   = c.session_date
               AND a.country_code = c.country_code
               AND a.city_name    = c.city_name
               AND a.shrinkage_on = c.shrinkage_on
               AND a.input_date_utc = c.input_date_utc
               AND a.end_date_utc   = c.end_date_utc
LEFT JOIN opf b ON a.order_date   = b.session_date
               AND a.country_code = b.country_code
               AND a.city_name    = b.city_name
               AND a.shrinkage_on = b.shrinkage_on
               AND a.input_date_utc = b.input_date_utc
               AND a.end_date_utc   = b.end_date_utc
LEFT JOIN delay d ON a.order_date = d.created_date
                 AND LOWER(a.country_code) = LOWER(d.country_code)
                 AND a.city_name           = d.city_name
                 AND a.shrinkage_on        = d.shrinkage_on
                 AND a.input_date_utc      = d.input_date_utc
                 AND a.end_date_utc        = d.end_date_utc
                 AND a.is_vendor_under_shrinkage = d.is_vendor_under_shrinkage
                 and a.order_hour = d.order_hour
LEFT JOIN distances dis ON a.order_date = dis.created_date
                       AND LOWER(a.country_code) = LOWER(dis.country_code)
                       AND a.city_name           = dis.city_name
                       AND a.shrinkage_on        = dis.shrinkage_on
                       AND a.input_date_utc      = dis.input_date_utc
                       AND a.end_date_utc        = dis.end_date_utc
                       AND a.is_vendor_under_shrinkage = dis.is_vendor_under_shrinkage
                       AND a.order_hour = dis.order_hour
LEFT JOIN shrinkage s ON a.order_date = s.created_date 
                       AND LOWER(a.country_code) = LOWER(s.country_code)
                       AND a.city_name           = s.city_name
                       AND a.shrinkage_on        = s.shrinkage_on
                       AND a.input_date_utc      = s.input_date_utc
                       AND a.end_date_utc        = s.end_date_utc
                       AND a.order_hour = s.shrinkage_hour                
GROUP BY ALL</relation>
