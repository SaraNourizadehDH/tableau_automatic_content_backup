  <worksheets>
    <worksheet name='cairo'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>% Bypassed orders vs. Shrinkage %  - Cairo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='opf test 1' name='federated.1kvezwk0ztsyie1aauh8a0c39otd' />
          </datasources>
          <datasource-dependencies datasource='federated.1kvezwk0ztsyie1aauh8a0c39otd'>
            <column caption='Time Interval' datatype='string' name='[Calculation_146437368306184192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([input_date_utc]) AND NOT ISNULL([end_date_utc]) THEN&#10;    STR([input_date_utc]) + &quot; to &quot; + STR([end_date_utc])&#10;END' />
            </column>
            <column caption='Bypassed Orders' datatype='integer' name='[Calculation_1896578412755578880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [is_vendor_under_shrinkage] = true THEN [total_orders] END&#10;)' />
            </column>
            <column caption='peak hours' datatype='string' name='[Calculation_1896578412756774913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([order_hour] &gt;= 18 AND [order_hour] &lt;= 22) &#10;   OR ([order_hour] &gt;= 12 AND [order_hour] &lt;= 14) &#10;THEN &apos;peak-hour&apos; &#10;ELSE &apos;non-peak&apos; &#10;END' />
            </column>
            <column caption='Bypassed orders %' datatype='real' name='[Calculation_1896578412782563331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [city_name], [order_date] : ([Calculation_1896578412755578880]) } &#10;/&#10;{ FIXED [city_name], [order_date] : SUM([total_orders]) }' />
            </column>
            <column-instance column='[avg_shrinkage_percentage]' derivation='Avg' name='[avg:avg_shrinkage_percentage:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[avg_shrinkage_percentage]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='datetime' name='[end_date_utc]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[input_date_utc]' role='dimension' type='ordinal' />
            <column caption='is vendor under shrinkage' datatype='boolean' name='[is_vendor_under_shrinkage]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Non-Bypassed Orders' />
                <alias key='true' value='Bypassed Orders' />
              </aliases>
            </column>
            <column-instance column='[Calculation_146437368306184192]' derivation='None' name='[none:Calculation_146437368306184192:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1896578412756774913]' derivation='None' name='[none:Calculation_1896578412756774913:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_hour]' derivation='None' name='[none:order_hour:ok]' pivot='key' type='ordinal' />
            <column caption='Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[order_hour]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1896578412782563331]' derivation='Sum' name='[sum:Calculation_1896578412782563331:qk]' pivot='key' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1kvezwk0ztsyie1aauh8a0c39otd].[Exclusions (Date,peak hours)]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:order_date:qk]' />
                <groupfilter function='level-members' level='[none:Calculation_1896578412756774913:nk]' />
              </groupfilter>
              <groupfilter function='reorder-dimensionality'>
                <groupfilter function='crossjoin'>
                  <groupfilter function='member' level='[none:Calculation_1896578412756774913:nk]' member='&quot;non-peak&quot;' />
                  <groupfilter function='member' level='[none:order_date:qk]' member='#2025-05-02#' />
                </groupfilter>
