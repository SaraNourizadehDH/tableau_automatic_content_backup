          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[avg:vendor_delay_10mins_percentage:qk]&quot;' value='Avg. vendor delay 10mins % - CHANGED TO VENDOR DELAY V2' />
          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[sum:Calculation_1896578412782563331:qk]&quot;' value='Bypassed Orders out of Total Orders %' />
          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[usr:avg dropoff distance manhattan_km (copy)_3978508068164861963:qk]&quot;' value='avg pickup distance manhattan (km)' />
