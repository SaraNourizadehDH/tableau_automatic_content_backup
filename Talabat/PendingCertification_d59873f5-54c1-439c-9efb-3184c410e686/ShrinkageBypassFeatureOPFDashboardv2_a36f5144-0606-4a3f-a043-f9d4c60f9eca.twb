          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[usr:Calculation_3978508067808452610:qk]&quot;' value='avg to vendor time (min)' />
          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[usr:Calculation_3978508068123811849:qk]&quot;' value='Vendor Delay V2 &gt; 10 min %' />
          <alias key='&quot;[federated.1kvezwk0ztsyie1aauh8a0c39otd].[usr:Calculation_3978508068164608010:qk]&quot;' value='avg dropoff distance manhattan (km)' />
        </aliases>
      </column>
      <column caption='avg pdt ' datatype='real' name='[Calculation_1022246761717112832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_pdt]) / sum([total_orders])' />
      </column>
      <column caption='Time Interval' datatype='string' name='[Calculation_146437368306184192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([input_date_utc]) AND NOT ISNULL([end_date_utc]) THEN&#10;    STR([input_date_utc]) + &quot; to &quot; + STR([end_date_utc])&#10;END' />
      </column>
      <column caption='Bypassed Orders' datatype='integer' name='[Calculation_1896578412755578880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [is_vendor_under_shrinkage] = true THEN [total_orders] END&#10;)' />
      </column>
      <column caption='peak hours' datatype='string' name='[Calculation_1896578412756774913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([order_hour] &gt;= 18 AND [order_hour] &lt;= 22) &#10;   OR ([order_hour] &gt;= 12 AND [order_hour] &lt;= 14) &#10;THEN &apos;peak-hour&apos; &#10;ELSE &apos;non-peak&apos; &#10;END' />
      </column>
      <column caption='Bypassed orders %' datatype='real' name='[Calculation_1896578412782563331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city_name], [order_date] : ([Calculation_1896578412755578880]) } &#10;/&#10;{ FIXED [city_name], [order_date] : SUM([total_orders]) }' />
      </column>
      <column caption='Avg. delivery time' datatype='real' name='[Calculation_3978508067808198656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_delivery_time]) / sum([total_orders])' />
      </column>
      <column caption='avg. to customer time' datatype='real' name='[Calculation_3978508067808333825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_to_customer_time]) / sum([total_orders])' />
      </column>
      <column caption='avg to vendor time' datatype='real' name='[Calculation_3978508067808452610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_to_vendor_time]) / sum([total_orders])' />
      </column>
      <column caption='Contact Rate %' datatype='real' name='[Calculation_3978508067808727043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_customer_contacts]) / sum([total_contacts])' />
      </column>
      <column caption='Logistics Fail Rate %' datatype='real' name='[Calculation_3978508067809136644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_failed_logistics_orders]) / sum([total_orders])' />
      </column>
      <column caption='OPF %' datatype='real' name='[Calculation_3978508067809443845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([opf_num]) / sum([opf_den])' />
      </column>
      <column caption='Success OPF %' datatype='real' name='[Calculation_3978508067809558534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([success_opf_num]) / sum([success_opf_den])' />
      </column>
      <column caption='vendor_delay_v2_%' datatype='real' name='[Calculation_3978508068123811849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_delay_v2]) / sum([total_orders])' />
      </column>
      <column caption='avg dropoff distance manhattan_km' datatype='real' name='[Calculation_3978508068164608010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_dropoff_distance_manhattan]) / sum([total_orders]) / 1000' />
      </column>
      <column caption='Orders late &gt; 10 min %' datatype='real' name='[Calculation_3978508068165054476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_late_greater_than_10_min]) / sum([total_orders])' />
      </column>
      <column caption='avg promised delivery time (min)' datatype='real' name='[Calculation_3978508068169359373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_promised_delivery_time]) / 60 ) / sum([total_orders])' />
      </column>
      <column caption='avg actual delivery time (min)' datatype='real' name='[Calculation_3978508068169949198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_actual_delivery_time]) / 60 ) / sum([total_orders])' />
      </column>
      <column caption='Select KPI Calc' datatype='real' name='[Calculation_466967000767500288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Total Orders&apos; THEN SUM([total_orders])&#10;    WHEN &apos;Total Orders Failed&apos; THEN SUM([total_orders_failed])&#10;    WHEN &apos;Logistics Fail Rate %&apos; THEN ([Calculation_3978508067809136644])*100&#10;    WHEN &apos;avg to vendor time&apos; THEN ([Calculation_3978508067808452610])&#10;    WHEN &apos;avg. to customer time&apos; THEN ([Calculation_3978508067808333825])&#10;    WHEN &apos;Avg. delivery time&apos; THEN [Calculation_3978508067808198656]&#10;    WHEN &apos;avg promised delivery time (min)&apos; THEN [Calculation_3978508068169359373]&#10;    WHEN &apos;Contact Rate %&apos; THEN ([Calculation_3978508067808727043])&#10;    WHEN &apos;stacking %&apos; THEN AVG([stacking_percentage])&#10;    WHEN &apos;Orders late &gt; 10 min %&apos;  THEN ([Calculation_3978508068165054476])*100&#10;    WHEN &apos;avg pdt&apos; THEN [Calculation_1022246761717112832]&#10;END' />
      </column>
      <column caption='Date (copy)' datatype='date' name='[Date (copy)_1896578412780474370]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[order_date]' />
      </column>
