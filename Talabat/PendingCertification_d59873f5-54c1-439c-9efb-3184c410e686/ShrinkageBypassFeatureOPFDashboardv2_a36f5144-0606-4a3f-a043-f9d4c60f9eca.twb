    <worksheet name='overall trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Bypassed Orders maintains higher order delays &gt; 10 min % </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='opf test 1' name='federated.1kvezwk0ztsyie1aauh8a0c39otd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders late &gt; 10 min \%&quot;'>
              <calculation class='tableau' formula='&quot;Orders late &gt; 10 min %&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kvezwk0ztsyie1aauh8a0c39otd'>
            <column caption='avg pdt ' datatype='real' name='[Calculation_1022246761717112832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_pdt]) / sum([total_orders])' />
            </column>
            <column caption='Time Interval' datatype='string' name='[Calculation_146437368306184192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([input_date_utc]) AND NOT ISNULL([end_date_utc]) THEN&#10;    STR([input_date_utc]) + &quot; to &quot; + STR([end_date_utc])&#10;END' />
            </column>
            <column caption='Avg. delivery time' datatype='real' name='[Calculation_3978508067808198656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_delivery_time]) / sum([total_orders])' />
            </column>
            <column caption='avg. to customer time' datatype='real' name='[Calculation_3978508067808333825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_to_customer_time]) / sum([total_orders])' />
            </column>
            <column caption='avg to vendor time' datatype='real' name='[Calculation_3978508067808452610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_to_vendor_time]) / sum([total_orders])' />
            </column>
            <column caption='Contact Rate %' datatype='real' name='[Calculation_3978508067808727043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_customer_contacts]) / sum([total_contacts])' />
            </column>
            <column caption='Logistics Fail Rate %' datatype='real' name='[Calculation_3978508067809136644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_failed_logistics_orders]) / sum([total_orders])' />
            </column>
            <column caption='Orders late &gt; 10 min %' datatype='real' name='[Calculation_3978508068165054476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_late_greater_than_10_min]) / sum([total_orders])' />
            </column>
            <column caption='avg promised delivery time (min)' datatype='real' name='[Calculation_3978508068169359373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([total_promised_delivery_time]) / 60 ) / sum([total_orders])' />
            </column>
            <column caption='Select KPI Calc' datatype='real' name='[Calculation_466967000767500288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Total Orders&apos; THEN SUM([total_orders])&#10;    WHEN &apos;Total Orders Failed&apos; THEN SUM([total_orders_failed])&#10;    WHEN &apos;Logistics Fail Rate %&apos; THEN ([Calculation_3978508067809136644])*100&#10;    WHEN &apos;avg to vendor time&apos; THEN ([Calculation_3978508067808452610])&#10;    WHEN &apos;avg. to customer time&apos; THEN ([Calculation_3978508067808333825])&#10;    WHEN &apos;Avg. delivery time&apos; THEN [Calculation_3978508067808198656]&#10;    WHEN &apos;avg promised delivery time (min)&apos; THEN [Calculation_3978508068169359373]&#10;    WHEN &apos;Contact Rate %&apos; THEN ([Calculation_3978508067808727043])&#10;    WHEN &apos;stacking %&apos; THEN AVG([stacking_percentage])&#10;    WHEN &apos;Orders late &gt; 10 min %&apos;  THEN ([Calculation_3978508068165054476])*100&#10;    WHEN &apos;avg pdt&apos; THEN [Calculation_1022246761717112832]&#10;END' />
            </column>
            <column caption='Time Interval (copy)' datatype='string' name='[Time Interval (copy)_466967000770736130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([input_date_utc]) AND NOT ISNULL([end_date_utc]) THEN&#10;    STR([input_date_utc]) + &quot; to &quot; + STR([end_date_utc])&#10;END' />
              <aliases>
                <alias key='&quot;2025-04-27 12:22:00 to 2025-04-28 09:14:00&quot;' value='Day 1' />
                <alias key='&quot;2025-04-28 09:14:00 to 2025-04-29 09:15:00&quot;' value='Day 2' />
                <alias key='&quot;2025-04-29 09:15:00 to 2025-04-30 05:58:00&quot;' value='Day 3' />
                <alias key='&quot;2025-04-30 05:58:00 to 2025-04-30 07:16:00&quot;' value='Day 4' />
                <alias key='&quot;2025-04-30 07:16:00 to 2025-04-30 09:07:00&quot;' value='Day 4a' />
                <alias key='&quot;2025-04-30 09:07:00 to 2025-05-01 09:00:00&quot;' value='Day 4b' />
                <alias key='&quot;2025-05-01 09:00:00 to 2025-05-02 09:17:00&quot;' value='Day 5' />
                <alias key='&quot;2025-05-02 09:17:00 to 2025-05-03 08:15:00&quot;' value='Day 6' />
                <alias key='&quot;2025-05-03 08:15:00 to 2025-05-04 09:03:00&quot;' value='Day 7' />
                <alias key='&quot;2025-05-04 09:03:00 to 2025-05-05 09:01:00&quot;' value='Day 8' />
                <alias key='&quot;2025-05-05 09:01:00 to 2025-05-06 09:08:00&quot;' value='Day 9' />
                <alias key='&quot;2025-05-06 09:08:00 to 2025-05-07 09:15:00&quot;' value='Day 10' />
                <alias key='&quot;2025-05-07 09:15:00 to 2025-05-08 09:46:00&quot;' value='Day 11' />
                <alias key='&quot;2025-05-08 09:46:00 to 2025-05-09 09:04:00&quot;' value='Day 12' />
                <alias key='&quot;2025-05-09 09:04:00 to 2025-05-10 08:56:00&quot;' value='Day 13' />
                <alias key='&quot;2025-05-10 08:56:00 to 2025-05-11 09:09:00&quot;' value='Day 14' />
                <alias key='&quot;2025-05-11 09:09:00 to 2025-05-12 09:54:00&quot;' value='Day 15' />
                <alias key='&quot;2025-05-12 09:54:00 to 2025-05-13 09:03:00&quot;' value='Day 16' />
                <alias key='&quot;2025-05-13 09:03:00 to 2025-05-14 09:05:00&quot;' value='Day 17' />
                <alias key='&quot;2025-05-14 09:05:00 to 2025-05-15 09:04:00&quot;' value='Day 18' />
                <alias key='&quot;2025-05-15 09:04:00 to 2025-05-16 10:36:00&quot;' value='Day 19' />
                <alias key='&quot;2025-05-16 10:36:00 to 2025-05-17 09:07:00&quot;' value='Day 20' />
                <alias key='&quot;2025-05-17 09:07:00 to 2025-05-18 09:05:00&quot;' value='Day 21' />
                <alias key='&quot;2025-05-18 09:05:00 to 2025-05-19 09:30:00&quot;' value='Day 22' />
                <alias key='&quot;2025-05-19 09:30:00 to 2025-05-20 09:00:00&quot;' value='Day 23' />
                <alias key='&quot;2025-05-20 09:00:00 to 2025-05-21 09:10:00&quot;' value='Day 24' />
              </aliases>
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='datetime' name='[end_date_utc]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[input_date_utc]' role='dimension' type='ordinal' />
            <column caption='is vendor under shrinkage' datatype='boolean' name='[is_vendor_under_shrinkage]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Non-Bypassed Orders' />
                <alias key='true' value='Bypassed Orders' />
              </aliases>
            </column>
            <column-instance column='[Calculation_146437368306184192]' derivation='None' name='[none:Calculation_146437368306184192:nk]' pivot='key' type='nominal' />
            <column-instance column='[Time Interval (copy)_466967000770736130]' derivation='None' name='[none:Time Interval (copy)_466967000770736130:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_vendor_under_shrinkage]' derivation='None' name='[none:is_vendor_under_shrinkage:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_hour]' derivation='None' name='[none:order_hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[shrinkage_on]' derivation='None' name='[none:shrinkage_on:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[order_hour]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[orders_late_greater_than_10_min]' role='measure' type='quantitative' />
            <column caption='Shrinkage On' datatype='string' name='[shrinkage_on]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;FALSE&quot;' value='Turned Off' />
