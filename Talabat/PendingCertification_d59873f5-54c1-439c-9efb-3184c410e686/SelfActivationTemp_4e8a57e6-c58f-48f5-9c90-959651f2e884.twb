          <named-connection caption='BigQuery' name='bigquery.0ovu0oq0a06t9a12ipfq00ov3yog'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='vendor_analytics' server-oauth='' username='ffaried@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
