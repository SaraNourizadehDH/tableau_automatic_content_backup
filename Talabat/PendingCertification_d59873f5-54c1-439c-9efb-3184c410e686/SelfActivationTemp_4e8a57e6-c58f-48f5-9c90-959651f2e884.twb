      `fulfillment-dwh-production.curated_data_shared_salesforce.opportunityhistory` h
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
    ON
      h.createdbyid = u.id
    WHERE
      partition_date &gt;&gt;= &apos;2022-01-01&apos;
      -- AND opportunityid =&apos;006bO000009jSqzQAE&apos;
    GROUP BY
      ALL
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY h.createddate DESC) = 1) h
  ON
    h.opportunityid = d.id)
