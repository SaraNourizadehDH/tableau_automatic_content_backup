      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0BB7609BD4F64A29922FE1F99A8517D3'>
            <properties context=''>
              <relation connection='bigquery.0ovu0oq0a06t9a12ipfq00ov3yog' name='Custom SQL Query' type='text'>WITH DATA AS (
  WITH DATA AS (
    WITH
      live AS (
      SELECT
        o.global_entity_id,
        o.createddate,
        a.grid__c,
        o.id,
        o.business_type__c,
        iswon,
        MAX(o.closedate) closedate,
        MAX(o.lastmodifieddate) lastmodifieddate
      FROM
        `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
      INNER JOIN
        `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
      ON
        o.accountid = a.id
      WHERE
        a.grid__c IN (
        SELECT
          RIGHT(b.user_external_id, 6) salesforce_id
        FROM
          `tlb-data-prod.data_platform_partner_engagement.braza_union_engagement_currents_data` b
        WHERE
          communication_name = &apos;self_activation_onboarding&apos;)
        AND business_type__c IN (
          -- &apos;Franchise Extension&apos;,
          &apos;Win Back&apos;,
          &apos;New Business&apos;)
        -- AND iswon is false
      GROUP BY
        ALL
      QUALIFY
        ROW_NUMBER() OVER (PARTITION BY o.id ORDER BY o.createddate DESC ) = 1 ),
      engagement AS (
      SELECT
        RIGHT(user_external_id, 6) AS salesforce_id,
        first_email_delivery_time,
        first_email_open_time,
      FROM
        `tlb-data-prod.data_platform_partner_engagement.braza_union_engagement_currents_data` b
      WHERE
        communication_name = &apos;self_activation_onboarding&apos; )
    SELECT
      e.*,
      l.*
    FROM
      engagement e
    LEFT JOIN
      live l
    ON
      e.salesforce_id = l.grid__c )
  SELECT
    d.*,
    h.* EXCEPT(opportunityid),
    TIMESTAMP_DIFF(last_updated_status,first_email_open_time, hour) open_to_live_hours,
    TIMESTAMP_DIFF(last_updated_status,first_email_delivery_time, hour) delivery_to_live_hours,
    TIMESTAMP_DIFF(last_updated_status,first_email_open_time, hour) &gt;&gt;=0 is_after_the_fact_hours,
    COALESCE(name = &apos;API Vendor Onboarding&apos;, FALSE) is_self_activate, 
    COALESCE(first_email_open_time is not null, FALSE) is_email_open
  FROM
    DATA d
  LEFT JOIN (
    SELECT
      h.createddate last_updated_status,
      h.opportunityid,
      h.stagename,
      u.name,
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.opportunityhistory` h
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
    ON
      h.createdbyid = u.id
    WHERE
      partition_date &gt;&gt;= &apos;2022-01-01&apos;
      -- AND opportunityid =&apos;006bO000009jSqzQAE&apos;
    GROUP BY
      ALL
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY h.createddate DESC) = 1) h
  ON
    h.opportunityid = d.id)
SELECT
  *
FROM
  DATA
WHERE
  first_email_delivery_time is not null</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
