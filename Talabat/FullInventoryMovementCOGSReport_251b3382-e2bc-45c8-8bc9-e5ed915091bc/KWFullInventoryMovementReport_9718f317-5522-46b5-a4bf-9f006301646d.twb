        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,TODAY( ) )' />
      </column>
      <column caption='End WAC' datatype='real' default-format='N' hidden='true' name='[Calculation_1303229200845176832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([end_qty]) = 0 THEN 0 ELSE&#13;&#10;AVG([end_wac])&#13;&#10;END' />
      </column>
      <column caption='AVG Inventory Value' datatype='real' name='[Calculation_1553741929831542784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Beg. Value (copy)_105271668646473731])+ SUM([Calculation_105271668649857041])) / 2' />
      </column>
      <column caption='Month Turnover' datatype='real' name='[Calculation_1553741929832255489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([Calculation_105271668649373710])  / [Calculation_1553741929831542784],0)' />
      </column>
      <column caption='Stock Cover' datatype='real' name='[Calculation_1553741929832394754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([is_dc]) &#13;&#10;&#13;&#10;THEN &#13;&#10;SUM([Calculation_105271668649857041])&#13;&#10;/&#13;&#10;SUM(IF [Calculation_105271668649857041] &gt; 0&#13;&#10;THEN&#13;&#10;{ FIXED [country_code],[mov_month],[sku]:SUM([Calculation_105271668649373710])}&#13;&#10;END)&#13;&#10;*avg([Calculation_886646240171794438])&#13;&#10;&#13;&#10;ELSE&#13;&#10;IFNULL((sum([Calculation_105271668649857041])/sum([Calculation_105271668649373710]))*avg([Calculation_886646240171794438]),0)&#13;&#10;END' />
      </column>
      <column caption='Total Q In ' datatype='integer' name='[Calculation_1553741929832845315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_105271668645879809]+ [Calculation_105271668647993350] + [Calculation_105271668648685577]' />
      </column>
      <column caption='Total Q Out' datatype='real' name='[Calculation_1553741929833103364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_105271668648947723] + [Calculation_105271668649213965]' />
      </column>
      <column caption='Selling Rate' datatype='real' hidden='true' name='[Calculation_1553741929833758725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1553741929833103364] / [Calculation_1553741929832845315],0)' />
      </column>
      <column caption='Ending In Transit Value' datatype='real' name='[Calculation_162411094774325248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mov_month] = [Parameters].[Beg. Month (copy)_105271668645724160] THEN&#13;&#10; [end_outgoing_in_transit_value]&#13;&#10;END' />
      </column>
      <column caption='Supplier Over Stock Days' datatype='real' name='[Calculation_1657606202320551939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Payment Term (days)]) - [Calculation_1553741929832394754]' />
      </column>
      <column caption='Control Visibility: Supplier' datatype='boolean' name='[Calculation_1657606202346307589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &apos;Supplier&apos;' />
      </column>
      <column caption='combined FILTER' datatype='string' name='[Calculation_1790462349413703680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;[beg_qty] =  0 &#13;&#10;AND [Calculation_886646239840677890] =  0 &#13;&#10;AND [beg_stock_value] =  0 &#13;&#10;AND [net_amt_delivered_lc] =  0 &#13;&#10;AND [qty_delivered] =  0 &#13;&#10;AND [qty_returned] =  0 &#13;&#10;AND [net_amount_returned_lc] =  0 &#13;&#10;AND [transfer_in_qty] =  0 &#13;&#10;AND [transfer_in_value] =  0 &#13;&#10;AND [transfer_out_qty] =  0 &#13;&#10;AND [transfer_out_value] =  0 &#13;&#10;AND [qty_sold] =  0 &#13;&#10;AND [net_amt_sales] =  0 &#13;&#10;AND [end_qty] =  0 &#13;&#10;AND  [end_stock_value] =  0 &#13;&#10;AND  [stock_adjustment_value] =  0 &#13;&#10;AND [stock_adjustment_quantity] =  0 &#13;&#10;THEN &apos;None&apos;&#13;&#10;END' />
      </column>
      <column caption='Next Month Filter' datatype='string' name='[Calculation_1790462349417299971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mov_month] = DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,TODAY())) THEN &apos;Next Month&apos; END' />
      </column>
      <column caption='KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_208291495907864584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;GMROI&apos;&#13;&#10;THEN [GMROI (copy)_105271668766613547]&#13;&#10;WHEN &apos;Stock Cover&apos;&#13;&#10;THEN [Stock Cover (copy)_208291495905038343]&#13;&#10;WHEN &apos;Inventory Holding Days&apos;&#13;&#10;THEN [Inventory Holding Days (copy)_208291495904374789]&#13;&#10;WHEN &apos;Annual Inventory Turnover&apos;&#13;&#10;THEN [Annual Inventory Turnover (copy)_208291495900512257]&#13;&#10;WHEN &apos;GP %&apos;&#13;&#10;THEN [GP % (copy)_208291495904645126]*100&#13;&#10;WHEN &quot;Beg. Stock Value&quot;&#13;&#10;THEN SUM([beg_stock_value])&#13;&#10;WHEN &quot;End. Stock Value&quot;&#13;&#10;THEN SUM([end_stock_value])&#13;&#10;END' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_2186216147318083591]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Store&apos;&#13;&#10;THEN [warehouse_name]&#13;&#10;WHEN &apos;Store &gt; Category&apos;&#13;&#10;THEN [warehouse_name] + &quot; | &quot; + [category]&#13;&#10;WHEN &apos;Category&apos;&#13;&#10;THEN [category]&#13;&#10;WHEN &apos;Sub Category&apos;&#13;&#10;THEN [category]+ &quot; | &quot;  + [sub_category] &#13;&#10;WHEN &apos;Supplier&apos;&#13;&#10;THEN [supplier_name]&#13;&#10;WHEN &apos;PIM L1&apos;&#13;&#10;THEN [pim_l1]&#13;&#10;WHEN &apos;PIM L2&apos;&#13;&#10;THEN [pim_l1]+ &quot; | &quot;  + [pim_l2] &#13;&#10;WHEN &apos;PIM L3&apos;&#13;&#10;THEN [pim_l1]+ &quot; | &quot;  + [pim_l2] + &quot; | &quot;  + [pim_l3] &#13;&#10;END' />
      </column>
      <column caption='Variance' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_886646239839453184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_105271668649857041])&#13;&#10;-&#13;&#10;(SUM([Beg. Value (copy)_105271668646473731]) &#13;&#10;+ SUM([Calculation_105271668647526405]) &#13;&#10;+ SUM([Calculation_105271668648800266]) &#13;&#10;+ SUM([Calculation_105271668657975321])&#13;&#10;+SUM([Ending In Transit Value (copy)_1389360523600797696])&#13;&#10;- &#13;&#10;SUM([Calculation_105271668648501256]) &#13;&#10;-SUM([Calculation_105271668649074700])&#13;&#10;-SUM([Calculation_105271668649373710])&#13;&#10;-SUM([Calculation_162411094774325248])&#13;&#10;)' />
      </column>
      <column caption='Beg. WAC' datatype='real' default-format='N' hidden='true' name='[Calculation_886646239840677890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [beg_qty] &gt; 0&#13;&#10;THEN&#13;&#10;[beg_wac]&#13;&#10;ELSE 0&#13;&#10;END' />
