    <datasource caption='Custom SQL Query (data_platform_dmart)' inline='true' name='federated.1ubjgnq163bvt519hzx0y1njwazu' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1kgda81098hifm1gjboqg16jbrwf'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_dmart' server-oauth='' username='eyad.elkhateeb@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Supplier Payment Term_Contracts' name='cloudfile:googledrive-excel-direct.1gkik2r18g72nj12z53gk11oxu0w'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1Jbs_RXn-orRRmzR9PnRjAidMxQhmw0-VWiF5z6CjMzk' cloudFileMetadata_-_folder='root' cloudFileName='Supplier Payment Term_Contracts.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1Jbs_RXn-orRRmzR9PnRjAidMxQhmw0-VWiF5z6CjMzk/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Supplier Payment Term_Contracts.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='eyad.elkhateeb@talabat.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1gkik2r18g72nj12z53gk11oxu0w' name='Consolidated' table='[Consolidated$]' type='table'>
          <columns gridOrigin='A1:G1849:no:A1:G1849:0' header='yes' outcome='2'>
            <column datatype='string' name='Country Code' ordinal='0' />
            <column datatype='string' name='Supplier ID (Supplier Portal)' ordinal='1' />
            <column datatype='string' name='Supplier Name (Supplier Portal)' ordinal='2' />
            <column datatype='string' name='Start Date' ordinal='3' />
            <column datatype='string' name='End date' ordinal='4' />
            <column datatype='string' name='Payment Term (days)' ordinal='5' />
            <column datatype='string' name='Supplier Return Policy' ordinal='6' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1kgda81098hifm1gjboqg16jbrwf' name='Custom SQL Query' type='text'><![CDATA[WITH
products AS(
SELECT
DISTINCT skus AS sku,
p.product_name_english AS product_name,
w.source_system_warehouse_id AS warehouse_id,
w.warehouse_name,
UPPER(p.country_code) AS country_code,
l1_front_category_english AS category,
l2_front_category_english AS sub_category,
master_category_names.level_one AS pim_l1,
master_category_names.level_two AS pim_l2,
master_category_names.level_three AS pim_l3,
is_darkstore,
w.is_dc,
is_dsaas,
ps.supplier_name,
ps.supplier_id,
is_import_flag AS is_imported_sku

FROM `tlb-data-prod.data_platform_dmart.dim_product` p

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v ON
CAST(v.vendor_id AS STRING) = p.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` w
ON p.warehouse_id = w.source_system_warehouse_id

LEFT JOIN (SELECT * FROM `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers`,
UNNEST(suppliers) s,
UNNEST(warehouses) sw

WHERE s.is_preferred
) ps

ON ps.sku = p.skus
AND ps.warehouse_id = p.warehouse_id

WHERE
(is_darkstore OR w.is_dc)
AND UPPER(p.country_code) = 'KW'
AND COALESCE(is_dsaas,FALSE) <<>> TRUE
QUALIFY row_number() OVER(PARTITION BY skus,p.warehouse_id ORDER BY is_deleted, v.parent_vendor_id - v.vendor_id desc) = 1
),

beg_inv AS (
SELECT
DATE_ADD(DATE_TRUNC(stock_date,month), INTERVAL 1 MONTH) AS beg_month,
sm.country_code,
sku,
supplier_id,
supplier_name,
sm.warehouse_id,
dw.warehouse_name,
wac_eod_lc AS beg_wac,
stock_count AS beg_qty,
wac_eod_lc * stock_count AS beg_stock_value,
eod_outgoing_transfer_quantity AS beg_outgoing_in_transit,
eod_outgoing_transfer_quantity * wac_eod_lc AS beg_outgoing_in_transit_value


FROM  `tlb-data-prod.data_platform.fct_grocery_stock_movement` sm

LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` dw
ON sm.platform_warehouse_id = dw.warehouse_id

LEFT JOIN
(
SELECT
DISTINCT vendor_warehouse_id, is_dsaas,
FROM `tlb-data-prod.data_platform.dim_vendor_info`
) v
ON v.vendor_warehouse_id = sm.warehouse_id

WHERE
stock_date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -4 month)
AND sm.country_code = 'KW'
AND COALESCE(is_dsaas,FALSE) <<>> TRUE

QUALIFY ROW_NUMBER() OVER (PARTITION BY sku, sm.warehouse_id, sm.country_code, DATE_TRUNC(stock_date,month) ORDER BY stock_date DESC,stock_count DESC) = 1 
),

end_inv AS(
SELECT
DATE_TRUNC(stock_date,month) AS end_month,
sm.country_code,
sku,
supplier_id,
supplier_name,
sm.warehouse_id,
dw.warehouse_name,
wac_eod_lc AS end_wac,
stock_count AS end_qty,
wac_eod_lc * stock_count AS end_stock_value,
eod_outgoing_transfer_quantity AS end_outgoing_in_transit,
eod_outgoing_transfer_quantity * wac_eod_lc AS end_outgoing_in_transit_value

FROM  `tlb-data-prod.data_platform.fct_grocery_stock_movement` sm

LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` dw
ON sm.platform_warehouse_id = dw.warehouse_id

LEFT JOIN
(
SELECT
DISTINCT vendor_warehouse_id, is_dsaas,
FROM `tlb-data-prod.data_platform.dim_vendor_info`
) v
ON v.vendor_warehouse_id = sm.warehouse_id

WHERE
stock_date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
AND sm.country_code = 'KW'
AND COALESCE(is_dsaas,FALSE) <<>> TRUE

QUALIFY ROW_NUMBER() OVER (PARTITION BY sku, sm.warehouse_id, sm.country_Code, DATE_TRUNC(stock_date,month) ORDER BY stock_date DESC,stock_count DESC) = 1),

products_beg AS(
SELECT
CASE WHEN p.sku IS NULL THEN beg_inv.sku ELSE p.sku END AS sku,
is_imported_sku,
p.product_name,
CASE WHEN p.warehouse_id IS NULL THEN beg_inv.warehouse_id ELSE p.warehouse_id END AS warehouse_id,
CASE WHEN p.warehouse_name IS NULL THEN beg_inv.warehouse_name ELSE p.warehouse_name END as warehouse_name,
CASE WHEN p.country_code IS NULL THEN beg_inv.country_code ELSE p.country_code END AS country_code,
CASE WHEN beg_inv.supplier_name IS NULL THEN p.supplier_name ELSE beg_inv.supplier_name END AS supplier_name,
CASE WHEN beg_inv.supplier_id IS NULL THEN p.supplier_id ELSE beg_inv.supplier_id END AS supplier_id,
p.is_dc,
p.category,
p.sub_category,
p.pim_l1,
p.pim_l2,
p.pim_l3,
beg_month,
beg_qty,
beg_wac,
beg_stock_value,
beg_outgoing_in_transit,
beg_outgoing_in_transit_value

FROM products p

LEFT JOIN beg_inv
ON p.sku = beg_inv.sku
AND p.warehouse_id = beg_inv.warehouse_id
AND p.country_code = beg_inv.country_code
),

products_end AS(
  SELECT
CASE WHEN p.sku IS NULL THEN end_inv.sku ELSE p.sku END AS sku,
p.product_name,
is_imported_sku,
CASE WHEN p.warehouse_id IS NULL THEN end_inv.warehouse_id ELSE p.warehouse_id END AS warehouse_id,
CASE WHEN p.warehouse_name IS NULL THEN end_inv.warehouse_name ELSE p.warehouse_name END as warehouse_name,
CASE WHEN p.country_code IS NULL THEN end_inv.country_code ELSE p.country_code END AS country_code,
CASE WHEN p.supplier_name IS NULL THEN end_inv.supplier_name ELSE p.supplier_name END AS supplier_name,
CASE WHEN p.supplier_id IS NULL THEN end_inv.supplier_id ELSE p.supplier_id END AS supplier_id,


p.is_dc,
p.category,
p.sub_category,
p.pim_l1,
p.pim_l2,
p.pim_l3,
end_month,
end_qty,
end_wac,
end_stock_value,
end_outgoing_in_transit,
end_outgoing_in_transit_value

FROM products p

FULL JOIN end_inv
ON p.sku = end_inv.sku
AND p.warehouse_id = end_inv.warehouse_id
AND p.country_code = end_inv.country_code
),

main_beg_end_query AS(
SELECT
CASE WHEN b.sku IS NULL THEN e.sku ELSE b.sku END AS sku,
CASE WHEN b.product_name IS NULL THEN e.product_name ELSE b.product_name END AS product_name,
CASE WHEN b.is_imported_sku IS NULL THEN e.is_imported_sku ELSE b.is_imported_sku END AS is_imported_sku,
CASE WHEN b.supplier_name IS NULL THEN e.supplier_name ELSE b.supplier_name END AS supplier_name,
CASE WHEN b.supplier_id IS NULL THEN e.supplier_id ELSE b.supplier_id END AS supplier_id,
CASE WHEN b.warehouse_id IS NULL THEN e.warehouse_id ELSE b.warehouse_id END AS warehouse_id,
CASE WHEN b.warehouse_name IS NULL THEN e.warehouse_name ELSE b.warehouse_name END AS warehouse_name,
CASE WHEN b.country_code IS NULL THEN e.country_code ELSE b.country_code END AS country_code,
CASE WHEN b.beg_month IS NULL THEN e.end_month ELSE b.beg_month END AS mov_month,
CASE WHEN b.category IS NULL THEN e.category ELSE b.category END AS category,
CASE WHEN b.sub_category IS NULL THEN e.sub_category ELSE b.sub_category END AS sub_category,
CASE WHEN b.pim_l1 IS NULL THEN e.pim_l1 ELSE b.pim_l1 END AS pim_l1,
CASE WHEN b.pim_l2 IS NULL THEN e.pim_l2 ELSE b.pim_l2 END AS pim_l2,
CASE WHEN b.pim_l3 IS NULL THEN e.pim_l3 ELSE b.pim_l3 END AS pim_l3,
CASE WHEN b.is_dc IS NULL THEN e.is_dc ELSE b.is_dc END AS is_dc,
COALESCE(beg_qty,0) AS beg_qty ,
COALESCE(beg_wac,0)AS beg_wac, 
COALESCE(beg_stock_value,0) AS beg_stock_value ,
COALESCE(end_qty,0) AS end_qty ,
COALESCE(end_wac,0) AS end_wac ,
COALESCE(end_stock_value,0) AS end_stock_value,
COALESCE(beg_outgoing_in_transit,0) AS beg_outgoing_in_transit,
COALESCE(beg_outgoing_in_transit_value,0) AS beg_outgoing_in_transit_value,
COALESCE(end_outgoing_in_transit,0) AS end_outgoing_in_transit,
COALESCE(end_outgoing_in_transit_value,0) AS end_outgoing_in_transit_value

FROM products_beg b

FULL JOIN products_end e
ON b.sku = e.sku
AND b.warehouse_id = e.warehouse_id
AND b.beg_month = e.end_month),

stock_adustment AS(
SELECT
DATE_TRUNC(stock_date,month) AS month,
country_code,
sku,
sm.warehouse_id,
SUM(
CASE 
WHEN stock_move_type_clean NOT IN('customer_order','supplier_order','no_movement','customer_return') 
THEN 
CASE 
WHEN add_or_remove = 'add' THEN quantity
WHEN add_or_remove = 'remove' THEN -quantity
END
END) AS stock_adjustment_quantity,

SUM(
CASE 
WHEN stock_move_type_clean NOT IN('customer_order','supplier_order','no_movement','customer_return') 
THEN 
CASE 
WHEN add_or_remove = 'add' THEN quantity
WHEN add_or_remove = 'remove' THEN -quantity
END * wac_lc
END) AS stock_adjustment_value,

SUM(CASE 
WHEN (LOWER(stock_move_type_clean) = 'customer_replacement' OR LOWER(stock_move_type_clean) = 'expiry' OR LOWER(stock_move_type_clean) = 'damage')
THEN quantity * wac_lc
END
) AS known_shrink,

FROM `tlb-data-prod.data_platform.fct_grocery_stock_movement` sm

WHERE
stock_date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
AND sm.country_code = 'KW'

GROUP BY 1,2,3,4
),

transfers_out AS
(
SELECT
DATE_TRUNC(current_status_modified_at,month) AS completion_month,
dw.source_system_warehouse_id AS src_warehouse_id,
product_sku AS sku,
SUM(picked_quantity) AS transfer_out_qty,
SUM(COALESCE(source_warehouse_sku_wac,0) * picked_quantity) AS transfer_out_value,

FROM `tlb-data-prod.data_platform.fct_warehouse_transfer_item` w
     
LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` dw
ON dw.warehouse_id = w.source_warehouse_id

WHERE
w.country_code = 'KW'
AND w.current_status_modified_at >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
AND current_status = 'COMPLETED'

GROUP BY 1,2,3
),

transfers_in AS
(
SELECT
DATE_TRUNC(current_status_modified_at,month) AS completion_month,
dw.source_system_warehouse_id AS dest_warehouse_id,
product_sku AS sku,
SUM(received_quantity) AS transfer_in_qty,
SUM(CASE
WHEN COALESCE(source_warehouse_sku_wac,0) <<>> 0 THEN source_warehouse_sku_wac
ELSE destination_warehouse_sku_wac
END * received_quantity) AS transfer_in_value,

FROM `tlb-data-prod.data_platform.fct_warehouse_transfer_item` w
     
LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` dw
ON dw.warehouse_id = w.destination_warehouse_id

WHERE
w.country_code = 'KW'
AND w.current_status_modified_at >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
AND current_status = 'COMPLETED'

GROUP BY 1,2,3
),

purchases AS(
SELECT
pp.sku_id,
country_code,
DATE_TRUNC(date(po.received_localtime_at), month) AS purchase_month,
po.warehouse_id,
SUM(pp.quantity_delivered) AS qty_delivered,
SUM(pp.quantity_delivered * pp.item_values_lc.unit_cost_after_discount_lc) AS net_amt_delivered_lc,

FROM `fulfillment-dwh-production.curated_data_shared_dmart.purchase_orders` po,
UNNEST(products_purchased) pp


WHERE
 po.country_code <<>> 'sa'
and po.order_status = 'done'
and date(po.received_localtime_at) >>=  DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)  

and UPPER(country_code) = 'KW'
GROUP BY 1,2,3,4

),

returns AS (
SELECT
product_sku AS sku,
po.country_code,
DATE_TRUNC(return_completed_at, month) AS return_month,
source_system_warehouse_id AS warehouse_id,
SUM(return_quantity) AS qty_returned,
SUM(return_amount_exc_vat) AS net_amount_returned_lc,

FROM `tlb-data-prod.data_platform.fct_purchase_order` AS po
LEFT JOIN `tlb-data-prod.data_platform.fct_purchase_order_return` AS r 
ON po.purchase_order_id = r.purchase_order_id

WHERE 
return_completed_at >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
and po.country_code = 'KW'

GROUP BY 1,2,3,4
),

sales AS (
SELECT 
sku_id AS sku,
DATE_TRUNC(s.order_date,month) AS order_month,
s.warehouse_id,
s.country_code, 
SUM(adjusted_item_subtotal - vat_amount) AS net_amt_sales,
SUM(fulfilled_quantity) AS qty_sold,
SUM(adjusted_item_cogs) AS cogs,

FROM `tlb-data-prod.data_platform_data_extract.CustomerOrdersSKULevel` s

WHERE 
s.order_Date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL -3 month)
AND UPPER(s.country_code) = 'KW'

GROUP BY 1,2,3,4
)

SELECT *
FROM(
SELECT
main.sku,
main.product_name,
COALESCE(main.is_imported_sku,FALSE) AS is_imported_sku,
main.supplier_name,
main.supplier_id,
main.warehouse_id,
main.warehouse_name,
main.is_dc,
main.country_code,
mov_month,
category,
sub_category,
pim_l1,
pim_l2,
pim_l3,
beg_qty,
beg_wac,
beg_stock_value ,
end_qty,
end_wac,
end_stock_value,
beg_outgoing_in_transit,
beg_outgoing_in_transit_value,
end_outgoing_in_transit,
end_outgoing_in_transit_value,
COALESCE(known_shrink,0) AS known_shrink,
COALESCE(stock_adjustment_quantity,0) AS stock_adjustment_quantity,
COALESCE(stock_adjustment_value,0) AS stock_adjustment_value,
COALESCE(transfers_in.transfer_in_qty,0) AS transfer_in_qty,
COALESCE(transfers_in.transfer_in_value,0) AS transfer_in_value,
COALESCE(transfers_out.transfer_out_qty,0) AS transfer_out_qty,
COALESCE(transfers_out.transfer_out_value,0) AS transfer_out_value,
COALESCE(net_amt_sales,0) AS net_amt_sales,
COALESCE(qty_sold,0) AS qty_sold,
COALESCE(cogs,0) AS cogs, 
COALESCE(qty_delivered,0) AS qty_delivered,
COALESCE(net_amt_delivered_lc,0) AS net_amt_delivered_lc,
COALESCE(qty_returned,0) AS qty_returned,
COALESCE(net_amount_returned_lc,0) AS net_amount_returned_lc,

FROM main_beg_end_query main

LEFT JOIN stock_adustment
ON stock_adustment.sku = main.sku
AND stock_adustment.warehouse_id = main.warehouse_id
AND stock_adustment.month =  mov_month

LEFT JOIN transfers_out
ON transfers_out.sku = main.sku
AND transfers_out.src_warehouse_id = main.warehouse_id
AND transfers_out.completion_month =  mov_month

LEFT JOIN transfers_in
ON transfers_in.sku = main.sku
AND transfers_in.dest_warehouse_id = main.warehouse_id
AND transfers_in.completion_month =  mov_month

LEFT JOIN sales
ON sales.sku = main.sku
AND sales.warehouse_id = main.warehouse_id
AND sales.order_month =  mov_month

LEFT JOIN purchases
ON purchases.sku_id = main.sku
AND purchases.warehouse_id = main.warehouse_id
AND purchases.purchase_month =  mov_month

LEFT JOIN returns
ON returns.sku = main.sku
AND returns.warehouse_id = main.warehouse_id
AND returns.return_month =  mov_month
)
WHERE 
mov_month IS NOT NULL]]></relation>
