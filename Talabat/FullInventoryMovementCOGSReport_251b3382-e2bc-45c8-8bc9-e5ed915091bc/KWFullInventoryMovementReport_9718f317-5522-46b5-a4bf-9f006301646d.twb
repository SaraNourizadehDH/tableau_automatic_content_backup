      <column caption='Days' datatype='integer' hidden='true' name='[Calculation_886646240171794438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = DATETRUNC(&apos;month&apos;,TODAY()) AND [Parameters].[Beg. Month (copy)_105271668645724160] = DATETRUNC(&apos;month&apos;,TODAY()) &#13;&#10;THEN   DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1],DATETRUNC(&apos;day&apos;,TODAY()))&#13;&#10;ELSEIF [Parameters].[Parameter 1] &lt;&gt; DATETRUNC(&apos;month&apos;,TODAY()) AND [Parameters].[Beg. Month (copy)_105271668645724160] = DATETRUNC(&apos;month&apos;,TODAY()) &#13;&#10;THEN DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1],DATETRUNC(&apos;day&apos;,TODAY()))&#13;&#10;ELSE DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1],DATEADD(&apos;month&apos;,1,[Parameters].[Beg. Month (copy)_105271668645724160]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Country Code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Days (Trend)' datatype='integer' hidden='true' name='[Days (copy)_105271668766240809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[mov_month]) = DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;THEN  DATEDIFF(&apos;day&apos;,[mov_month],DATETRUNC(&apos;day&apos;,TODAY()))&#13;&#10;ELSE &#13;&#10;DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[mov_month]))))&#13;&#10;END' />
      </column>
      <column caption='Beg, In Transit Q.' datatype='integer' name='[Ending In Transit Q. (copy)_1389360523600797697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mov_month] = [Parameters].[Parameter 1] THEN&#13;&#10; [beg_outgoing_in_transit]&#13;&#10;END' />
