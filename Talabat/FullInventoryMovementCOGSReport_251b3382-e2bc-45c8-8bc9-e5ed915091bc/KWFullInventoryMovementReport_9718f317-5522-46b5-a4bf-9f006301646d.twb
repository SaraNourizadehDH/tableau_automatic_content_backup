        <calculation class='tableau' formula='IF [mov_month] = [Parameters].[Parameter 1] THEN&#13;&#10; [beg_outgoing_in_transit_value]&#13;&#10;END' />
      </column>
      <column caption='Ending In Transit Q.' datatype='integer' name='[Ending In Transit Value (copy)_162411094774562817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mov_month] = [Parameters].[Beg. Month (copy)_105271668645724160] THEN&#13;&#10; [end_outgoing_in_transit]&#13;&#10;END' />
