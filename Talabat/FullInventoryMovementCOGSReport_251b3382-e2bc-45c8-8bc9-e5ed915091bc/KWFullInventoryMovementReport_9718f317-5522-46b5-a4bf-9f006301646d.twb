            <datasource caption='Custom SQL Query (data_platform_dmart)' name='federated.1ubjgnq163bvt519hzx0y1njwazu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ubjgnq163bvt519hzx0y1njwazu].[Calculation_1216253442388656130]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1ubjgnq163bvt519hzx0y1njwazu].[mov_month]' caption='End. Month' datatype='date' name='[Beg. Month (copy)_105271668645724160]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1ubjgnq163bvt519hzx0y1njwazu].[Calculation_1216253442388656130]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1ubjgnq163bvt519hzx0y1njwazu].[mov_month]' caption='Beg. Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ubjgnq163bvt519hzx0y1njwazu'>
            <column caption='AVG Daily COGS (Trend)' datatype='real' name='[AVG Daily COGS (copy)_208291495901155331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([is_dc]) &#13;&#10;THEN SUM({ FIXED [country_code],[mov_month],[sku]:SUM([Calculation_105271668649373710])})&#13;&#10;ELSE&#13;&#10;SUM([Calculation_105271668649373710])&#13;&#10;END&#13;&#10;&#13;&#10;/ AVG([Days (copy)_105271668766240809])' />
            </column>
            <column caption='AVG Inventory Value (Trend)' datatype='real' hidden='true' name='[AVG Inventory Value (copy)_105271668766523434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([beg_stock_value])+ SUM([end_stock_value])) / 2' />
            </column>
            <column caption='Annual GP (Trend)' datatype='real' hidden='true' name='[Annual GP (copy)_105271668766126120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([net_amt_sales])-SUM([cogs]))/AVG([Days (copy)_105271668766240809]))*365' />
            </column>
            <column caption='Annual Inventory Turnover (Trend)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Annual Inventory Turnover (copy)_208291495900512257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([AVG Daily COGS (copy)_208291495901155331]*365) / [AVG Inventory Value (copy)_105271668766523434]' />
            </column>
            <column caption='COGS Calc' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_105271668649373710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [mov_month] &gt;= [Parameters].[Parameter 1] AND [mov_month] &lt;= [Parameters].[Beg. Month (copy)_105271668645724160] THEN&#13;&#10;[cogs]&#13;&#10;END' />
            </column>
            <column caption='End. Value Calc' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_105271668649857041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [mov_month] = [Parameters].[Beg. Month (copy)_105271668645724160] THEN&#13;&#10;[end_stock_value]&#13;&#10;END' />
            </column>
            <column caption='Today()' datatype='datetime' name='[Calculation_1216253442388656130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,TODAY( ) )' />
            </column>
            <column caption='combined FILTER' datatype='string' name='[Calculation_1790462349413703680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;[beg_qty] =  0 &#13;&#10;AND [Calculation_886646239840677890] =  0 &#13;&#10;AND [beg_stock_value] =  0 &#13;&#10;AND [net_amt_delivered_lc] =  0 &#13;&#10;AND [qty_delivered] =  0 &#13;&#10;AND [qty_returned] =  0 &#13;&#10;AND [net_amount_returned_lc] =  0 &#13;&#10;AND [transfer_in_qty] =  0 &#13;&#10;AND [transfer_in_value] =  0 &#13;&#10;AND [transfer_out_qty] =  0 &#13;&#10;AND [transfer_out_value] =  0 &#13;&#10;AND [qty_sold] =  0 &#13;&#10;AND [net_amt_sales] =  0 &#13;&#10;AND [end_qty] =  0 &#13;&#10;AND  [end_stock_value] =  0 &#13;&#10;AND  [stock_adjustment_value] =  0 &#13;&#10;AND [stock_adjustment_quantity] =  0 &#13;&#10;THEN &apos;None&apos;&#13;&#10;END' />
            </column>
            <column caption='Next Month Filter' datatype='string' name='[Calculation_1790462349417299971]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mov_month] = DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,TODAY())) THEN &apos;Next Month&apos; END' />
            </column>
            <column caption='Beg. WAC' datatype='real' default-format='N' hidden='true' name='[Calculation_886646239840677890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [beg_qty] &gt; 0&#13;&#10;THEN&#13;&#10;[beg_wac]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Days (Trend)' datatype='integer' hidden='true' name='[Days (copy)_105271668766240809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[mov_month]) = DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;THEN  DATEDIFF(&apos;day&apos;,[mov_month],DATETRUNC(&apos;day&apos;,TODAY()))&#13;&#10;ELSE &#13;&#10;DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[mov_month]))))&#13;&#10;END' />
            </column>
            <column caption='GMROI (Trend)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMROI (copy)_105271668766613547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Annual GP (copy)_105271668766126120] / [AVG Inventory Value (copy)_105271668766523434]' />
            </column>
            <column caption='GP % (Trend)' datatype='real' default-format='p0.00%' name='[GP % (copy)_208291495904645126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([net_amt_sales])-SUM([cogs])) / SUM([net_amt_sales])' />
            </column>
            <column caption='Inventory Holding Days (Trend)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Inventory Holding Days (copy)_208291495904374789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='365 / [Annual Inventory Turnover (copy)_208291495900512257]' />
            </column>
            <column caption='Stock Cover (Trend)' datatype='real' name='[Stock Cover (copy)_208291495905038343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([is_dc]) &#13;&#10;&#13;&#10;THEN &#13;&#10;SUM([Calculation_105271668649857041])&#13;&#10;/&#13;&#10;SUM(IF [Calculation_105271668649857041] &gt; 0&#13;&#10;THEN&#13;&#10;{ FIXED [country_code],[mov_month],[sku]:SUM([Calculation_105271668649373710])}&#13;&#10;END)&#13;&#10;*avg([Days (copy)_105271668766240809])&#13;&#10;&#13;&#10;ELSE&#13;&#10;IFNULL((sum([end_stock_value])/sum([cogs]))*avg([Days (copy)_105271668766240809]),0)END' />
            </column>
            <column caption='Beg. Qty' datatype='integer' hidden='true' name='[beg_qty]' role='measure' type='quantitative' />
