            <column caption='Stock Cover' datatype='real' name='[Calculation_1553741929832394754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([is_dc]) &#13;&#10;&#13;&#10;THEN &#13;&#10;SUM([Calculation_105271668649857041])&#13;&#10;/&#13;&#10;SUM(IF [Calculation_105271668649857041] &gt; 0&#13;&#10;THEN&#13;&#10;{ FIXED [country_code],[mov_month],[sku]:SUM([Calculation_105271668649373710])}&#13;&#10;END)&#13;&#10;*avg([Calculation_886646240171794438])&#13;&#10;&#13;&#10;ELSE&#13;&#10;IFNULL((sum([Calculation_105271668649857041])/sum([Calculation_105271668649373710]))*avg([Calculation_886646240171794438]),0)&#13;&#10;END' />
