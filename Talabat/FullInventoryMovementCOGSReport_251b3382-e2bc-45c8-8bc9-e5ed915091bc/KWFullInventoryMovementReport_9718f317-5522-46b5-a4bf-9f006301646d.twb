      <column caption='Category Granularity' datatype='string' name='[Granularity (copy)_162411094776844290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Data Granularity (copy)_162411094776860675]&#13;&#10;WHEN &apos;Category&apos;&#13;&#10;THEN [category]&#13;&#10;WHEN &apos;Sub Category&apos;&#13;&#10;THEN [category]+ &quot; | &quot;  + [sub_category] &#13;&#10;WHEN &apos;PIM L1&apos;&#13;&#10;THEN [pim_l1]&#13;&#10;WHEN &apos;PIM L2&apos;&#13;&#10;THEN [pim_l1]+ &quot; | &quot;  + [pim_l2] &#13;&#10;WHEN &apos;PIM L3&apos;&#13;&#10;THEN [pim_l1]+ &quot; | &quot;  + [pim_l2] + &quot; | &quot;  + [pim_l3] &#13;&#10;END' />
