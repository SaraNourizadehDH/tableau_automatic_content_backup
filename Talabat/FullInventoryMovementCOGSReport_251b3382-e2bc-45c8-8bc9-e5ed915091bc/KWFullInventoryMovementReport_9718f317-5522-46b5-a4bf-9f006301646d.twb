              </expression>
              <expression _.fcp.InequalityRelationships.false...op='=' _.fcp.InequalityRelationships.true...op='&lt;='>
                <expression _.fcp.InequalityRelationships.false...op='[mov_month &lt;= DATE(End date)]' _.fcp.InequalityRelationships.true...op='[mov_month]' />
                <expression _.fcp.InequalityRelationships.false...op='[]' _.fcp.InequalityRelationships.true...op='DATE([End date])' />
              </expression>
