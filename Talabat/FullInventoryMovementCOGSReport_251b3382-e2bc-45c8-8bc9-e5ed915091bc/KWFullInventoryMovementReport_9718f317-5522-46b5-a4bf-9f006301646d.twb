            <zone forceUpdate='true' h='28105' id='9' type-v2='text' w='98400' x='800' y='71053'>
              <formatted-text>
                <run bold='true' fontcolor='#ff0000'>Variance =</run>
                <run bold='true' fontcolor='#0c29ff'>Æ </run>
                <run bold='true' fontcolor='#d1d2d3' fontsize='11'>Æ </run>
                <run bold='true' fontcolor='#0c29ff'>Beg. Value + Purch. Value - Returns Value + Transfer In Value - Transfer Out Value - Ending In Transit Value - COGS + Stock Adj. Value - Ending Inventory Value </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>TO =</run>
                <run bold='true' fontcolor='#0c29ff'> COGS / AVG Inv.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>Stock Cover =</run>
                <run bold='true' fontcolor='#0c29ff'> (End Stock Value / COGS) * Days of Month Passed</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff3a00'>Note:</run>
                <run bold='true' fontcolor='#ff903a'>Æ </run>
                <run bold='true' fontcolor='#0c29ff'>DC Stock cover is based on the end stock value of items in-stock in DC at the end of the month / Store COGS of those items.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>Total In =</run>
                <run>Æ </run>
                <run fontcolor='#0c29ff'>Æ </run>
                <run bold='true' fontcolor='#0c29ff'>Beg. Qty + Purchase Q. + Transfer In Q.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>Total Out =</run>
                <run bold='true' fontcolor='#0c29ff'> Transfer Out Q.+ Qty. Sold</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>Modification Rate =</run>
                <run bold='true' fontcolor='#0c29ff'> Modified Orders / Gross Orders</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff0000'>Known Shrink =</run>
                <run bold='true' fontcolor='#0c29ff'> Customer Replacement, Item Expired, Item Damaged</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
              </zone-style>
