              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN SUM([Market Share Gmv])&#10;WHEN &apos;Orders&apos; THEN SUM([Market Share Noo])&#10;WHEN &apos;No of Cards&apos; THEN SUM([Market Share Noc])&#10;END' />
