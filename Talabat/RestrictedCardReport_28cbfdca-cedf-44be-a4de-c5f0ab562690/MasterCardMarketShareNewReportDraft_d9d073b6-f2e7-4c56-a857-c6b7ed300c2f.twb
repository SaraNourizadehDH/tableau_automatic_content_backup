      <column caption='Info Button' datatype='string' name='[Calculation_477381619033948168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;ⓘ&apos;' />
      </column>
      <column caption='GMV (Talabat)' datatype='real' name='[Calculation_6819927630297710596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GMV])*[Parameters].[Parameter 2]' />
      </column>
      <column caption='GMV (Competitor)' datatype='real' name='[Calculation_6819927630297931781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6819927630297710596] / (SUM([Market Share Gmv])/100))&#10;*&#10;((100-SUM([Market Share Gmv]))/100)' />
      </column>
      <column caption='Market GMV' datatype='real' name='[Calculation_6819927630368051206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6819927630297931781] + [Calculation_6819927630297710596]' />
      </column>
      <column caption='Hide Null' datatype='boolean' name='[Calculation_6819927630373814279]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Normalization - Market GMV' datatype='real' name='[Calculation_800444516978606089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_6819927630368051206] - WINDOW_MIN([Calculation_6819927630368051206]) )&#10;/&#10;( WINDOW_MAX([Calculation_6819927630368051206]) - WINDOW_MIN([Calculation_6819927630368051206]) )&#10;+1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Emirate]' role='dimension' type='nominal' />
      <column caption='Orders (Competitor)' datatype='real' name='[GMV (Competitor) (copy)_800444516580261889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([GMV (Talabat) (copy)_800444516580061184] / (SUM([Market Share Noo])/100))&#10;*&#10;((100-SUM([Market Share Noo]))/100)' />
      </column>
      <column caption='Orders (Talabat)' datatype='real' name='[GMV (Talabat) (copy)_800444516580061184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders])*[Parameters].[Parameter 2]' />
      </column>
      <column caption='GMV/Orders (Talabat)' datatype='real' name='[GMV (Talabat) (copy)_800444516583260162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN SUM([GMV])*[Parameters].[Parameter 2]&#10;WHEN &apos;Orders&apos; THEN SUM([Orders])*[Parameters].[Parameter 2]&#10;END' />
      </column>
      <column caption='Market GMV/Orders' datatype='real' name='[Market GMV (copy)_800444516584222723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;GMV&apos; THEN [Calculation_6819927630297931781] + [Calculation_6819927630297710596]&#10;WHEN &apos;Orders&apos; THEN [GMV (Competitor) (copy)_800444516580261889] + [GMV (Talabat) (copy)_800444516580061184]&#10;END' />
      </column>
      <column caption='Market Orders' datatype='real' name='[Market GMV (copy)_800444516976250888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV (Competitor) (copy)_800444516580261889] + [GMV (Talabat) (copy)_800444516580061184]' />
      </column>
      <column caption='Market Share (Competitor)' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Market Share (copy)_800444516589281284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN 100 - SUM([Market Share Gmv])&#10;WHEN &apos;Orders&apos; THEN 100- SUM([Market Share Noo])&#10;WHEN &apos;No of Cards&apos; THEN 100- SUM([Market Share Noc])&#10;END' />
      </column>
      <column caption='Market Share' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Market Share Gmv (copy)_6819927630083682307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN SUM([Market Share Gmv])&#10;WHEN &apos;Orders&apos; THEN SUM([Market Share Noo])&#10;WHEN &apos;No of Cards&apos; THEN SUM([Market Share Noc])&#10;END' />
      </column>
      <column caption='Market Share (GMV)' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Market Share Gmv]' role='measure' type='quantitative' />
