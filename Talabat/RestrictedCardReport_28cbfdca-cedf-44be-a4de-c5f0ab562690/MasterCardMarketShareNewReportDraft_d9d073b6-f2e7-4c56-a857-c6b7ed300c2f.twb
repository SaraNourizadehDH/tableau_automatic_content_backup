      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09oveuv1helu1y16uruq81d7ka12].[pcdf:usr:Calculation_6819927630368051206:qk:3]&quot;' value='Market Growth GMV' />
