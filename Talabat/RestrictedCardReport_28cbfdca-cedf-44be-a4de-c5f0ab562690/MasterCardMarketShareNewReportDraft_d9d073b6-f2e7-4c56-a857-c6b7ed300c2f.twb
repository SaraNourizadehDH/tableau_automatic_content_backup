            <column caption='Market GMV/Orders' datatype='real' name='[Market GMV (copy)_800444516584222723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;GMV&apos; THEN [Calculation_6819927630297931781] + [Calculation_6819927630297710596]&#10;WHEN &apos;Orders&apos; THEN [GMV (Competitor) (copy)_800444516580261889] + [GMV (Talabat) (copy)_800444516580061184]&#10;END' />
            </column>
