              <calculation class='tableau' formula='([GMV (Talabat) (copy)_800444516580061184] / (SUM([Market Share Noo])/100))&#10;*&#10;((100-SUM([Market Share Noo]))/100)' />
            </column>
            <column caption='Orders (Talabat)' datatype='real' name='[GMV (Talabat) (copy)_800444516580061184]' role='measure' type='quantitative'>
