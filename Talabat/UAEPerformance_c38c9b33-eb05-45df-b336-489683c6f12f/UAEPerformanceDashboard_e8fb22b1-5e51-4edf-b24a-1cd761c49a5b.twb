    <worksheet name='Dataset 2-3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>KPI&apos;s</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1o7rss10x25hkm1fcefbp1lch10n' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='POS Vendor for FIR%' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
              <calculation class='tableau' formula='12.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o7rss10x25hkm1fcefbp1lch10n'>
            <column caption='Day' datatype='date' name='[Calculation_1305199502088626181]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [date]))' />
            </column>
            <column caption='Week' datatype='date' name='[Calculation_1305199502088781830]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [date]))' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_1305199502089363463]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Report Date' datatype='date' name='[Calculation_1305199502089445384]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Calculation_1305199502088626181]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Calculation_1305199502088781830]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MTD&apos; and [granularity] = &apos;MTD&apos; then [Calculation_993888180307652612]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Calculation_1305199502089363463]&#13;&#10;END' />
            </column>
            <column caption='Fir usage, %' datatype='real' name='[Calculation_1305199502141394978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Food_ready_used_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_Food_ready_used_orders_fir]&#13;&#10;    end)&#13;&#10;/&#13;&#10;sum(if [Parameters].[Parameter 2] = &quot;Exclude&quot; &#13;&#10;        then [daily_Non_POS_Total_completed_orders_fir]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;        then [daily_total_completed_orders_fir]&#13;&#10;    end)' />
            </column>
            <column caption='Avg Effective Fee TGO' datatype='real' name='[Calculation_1305199502433673256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Calculation_993888180357890060] end)&#13;&#10;+ sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Calculation_993888180357890060] end))&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='% Vendor Late &gt; 10min V2' datatype='real' default-format='p0.00%' name='[Calculation_1305199502440886316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_orders_10min_V2])&#13;&#10;/sum([all_vendor_late_orders_V2])' />
            </column>
            <column caption='TGO Share, % ' datatype='real' default-format='p0.0%' name='[Calculation_1305199502441336877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement]=&quot;TGO&quot; then [daily_successful_order_count] else 0 end) /SUM([daily_successful_order_count])' />
            </column>
            <column caption='Avg Daily Orders' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502441902126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_successful_order_count])/COUNTD([date])' />
            </column>
            <column caption='Avg Daily GMV' datatype='real' name='[Calculation_1305199502442123311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_993888180350599173])/COUNTD([date])' />
            </column>
            <column caption='Avg Estimated Prep Time (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502471319602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_estimated_prep_time])&#13;&#10;/&#13;&#10;sum([daily_estimated_prep_time_orders])' />
            </column>
            <column caption='% Incentivized Orders (Incl. Gems)' datatype='real' default-format='p0.00%' name='[Calculation_1305199502473269301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Customer Contact Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_1305199502474973241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_contacts])&#13;&#10;/&#13;&#10;sum([gross_orders])' />
            </column>
            <column caption='Net Fail Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_1305199502476124218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_net_failed_order_count])&#13;&#10;/&#13;&#10;sum([daily_net_order_count])' />
            </column>
            <column caption='Avg Delivery Time (min)' datatype='real' name='[Calculation_1305199502476906555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_delivery_time_min])&#13;&#10;/&#13;&#10;sum([daily_delivery_time_orders])' />
            </column>
            <column caption='Avg Promised Delivery Time (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502477537340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_promised_delivery_time])&#13;&#10;/&#13;&#10;sum([daily_promised_delivery_orders])' />
            </column>
            <column caption='% Order Late &gt; 10min' datatype='real' default-format='p0.00%' name='[Calculation_1305199502478204990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_Delivery_late_10min])&#13;&#10;/&#13;&#10;sum([daily_eligible_delivery_late_order])' />
            </column>
            <column caption='% Rider Late &gt; 10min' datatype='real' default-format='p0.00%' name='[Calculation_1305199502479429695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_rider_late_orders_10min])&#13;&#10;/&#13;&#10;sum([daily_all_rider_late_orders])' />
            </column>
            <column caption='Avg Delivery Distance (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502479806528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_delivery_distance])/SUM([daily_completed_non_pre_gps_error_orders])' />
            </column>
            <column caption='Avg Driving Time (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502480392257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_driving_time_min])/SUM([daily_completed_non_pre_orders])' />
            </column>
            <column caption='% Orders with Stacking' datatype='real' default-format='p0.00%' name='[Calculation_1305199502481174594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_stacked_orders])&#13;&#10;/&#13;&#10;sum([daily_logistics_completed_orders])' />
            </column>
            <column caption='Avg Hold Back Time (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502481911875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_hold_back_time])&#13;&#10;/&#13;&#10;sum([daily_hold_back_time_orders])' />
            </column>
            <column caption='CVR by Subsessions' datatype='real' default-format='p0.00%' name='[Calculation_1305199502484267076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_placed_order_sub_session_count])/SUM([daily_viewed_menu_subsession_count])' />
            </column>
            <column caption='Avg Discount Amount' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502486073416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_993888180359475213])&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Net Take Rate, %' datatype='real' default-format='p0.00%' name='[Calculation_1305199502487068745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1305199502487212106]&#13;&#10;/&#13;&#10;sum([daily_successful_order_gmv_lc])' />
            </column>
            <column caption='Net Take' datatype='real' name='[Calculation_1305199502487212106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_993888180360962063]))&#13;&#10;+&#13;&#10;ZN(sum([Calculation_993888180360671246]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Calculation_993888180357890060] END))&#13;&#10;+&#13;&#10;ZN(sum([Calculation_993888180352491527]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_1305199502487875659]' />
            </column>
            <column caption='Delivery Cost' datatype='real' name='[Calculation_1305199502487875659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 3] = &quot;Local&quot;&#13;&#10;    then [Parameters].[Parameter 4]&#13;&#10;    *[daily_successful_order_count]&#13;&#10;    &#13;&#10;    ELSEIF [delivery_arrangement]=&quot;TGO&quot; and [Parameters].[Parameter 3] = &quot;Eur&quot;&#13;&#10;    THEN ([Parameters].[Parameter 4] * [exchange_rate_to_eur]&#13;&#10;    * [daily_successful_order_count])&#13;&#10;END)&#13;&#10;)' />
            </column>
            <column caption='Net Take per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1305199502490361932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1305199502487212106]&#13;&#10;/&#13;&#10;sum([daily_successful_order_count])' />
            </column>
            <column caption='Commission Rate [Sales Defn] %' datatype='real' default-format='p0.00%' name='[Calculation_1305199502491349069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([daily_successful_commission_amount_lc]) + sum([daily_successful_tgo_amount_lc]))&#13;&#10;/&#13;&#10;sum([daily_successful_commissionable_gmv_amount_lc])' />
            </column>
            <column caption='Commission Rev. % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_1305199502491844686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([daily_successful_commission_amount_lc]) + sum([daily_successful_tgo_amount_lc]))&#13;&#10;/&#13;&#10;sum([daily_successful_order_gmv_lc])' />
            </column>
            <column caption='Trends Label' datatype='string' name='[Calculation_584060616673935360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Trends&quot;' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_993888180283871233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MTD&apos; then [granularity] = &apos;MTD&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; then CONTAINS([granularity] , &apos;month&apos;)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granularity &lt;&gt; RR Filter' datatype='boolean' name='[Calculation_993888180295794691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]&lt;&gt; &apos;month-runrate-mtf&apos;' />
            </column>
            <column caption='MTD' datatype='date' name='[Calculation_993888180307652612]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_993888180350599173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_order_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_order_gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='Service Fee' datatype='real' name='[Calculation_993888180352491527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_service_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_service_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_993888180357099528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='sum([Basket Amount])/sum([Successful orders ])' datatype='real' name='[Calculation_993888180357333001]' role='measure' type='quantitative' user:unnamed='Sheet 1 (5)'>
              <calculation class='tableau' formula='sum([Calculation_993888180357099528])/sum([daily_successful_order_count])' />
            </column>
            <column caption='sum([GMV])/SUM([Successful orders ])' datatype='real' name='[Calculation_993888180357431306]' role='measure' type='quantitative' user:unnamed='Sheet 1 (5)'>
              <calculation class='tableau' formula='sum([Calculation_993888180350599173])/SUM([daily_successful_order_count])' />
            </column>
            <column caption='sum([Service Fee])/sum([Successful orders ])' datatype='real' name='[Calculation_993888180357627915]' role='measure' type='quantitative' user:unnamed='Sheet 1 (5)'>
              <calculation class='tableau' formula='sum([Calculation_993888180352491527])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_993888180357890060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_delivery_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_delivery_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Discount Amount' datatype='real' name='[Calculation_993888180359475213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_discount_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_discount_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='TGO Amount' datatype='real' name='[Calculation_993888180360671246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_tgo_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_tgo_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_993888180360962063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[all_vendor_late_orders_V2]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[customer_contacts]' role='measure' type='quantitative' />
            <column datatype='real' name='[daily_Delivery_late_10min]' role='measure' type='quantitative' />
            <column datatype='real' name='[daily_Food_ready_used_orders_fir]' role='measure' type='quantitative' />
            <column datatype='real' name='[daily_Non_POS_Food_ready_used_orders_fir]' role='measure' type='quantitative' />
