  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Measure II' datatype='string' name='[Measure I (copy)_1494913646994759686]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
        <calculation class='tableau' formula='&quot;GMV&quot;' />
        <members>
          <member value='&quot;Successful Orders&quot;' />
          <member value='&quot;GMV&quot;' />
          <member value='&quot;AOV&quot;' />
          <member value='&quot;Avg Basket Value&quot;' />
          <member value='&quot;Avg Delivery Fee TGO&quot;' />
          <member value='&quot;Avg Delivery Fee TMP&quot;' />
          <member value='&quot;Avg Service Fee&quot;' />
          <member value='&quot;TGO Share, \%&quot;' />
          <member value='&quot;TGO Orders&quot;' />
          <member value='&quot;TMP Orders&quot;' />
          <member value='&quot;Pickup Orders&quot;' />
          <member value='&quot;None&quot;' />
        </members>
      </column>
      <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
        <calculation class='tableau' formula='&quot;Month&quot;' />
        <members>
          <member value='&quot;Day&quot;' />
          <member value='&quot;Week&quot;' />
          <member value='&quot;Month&quot;' />
          <member value='&quot;MTD&quot;' />
        </members>
      </column>
      <column caption='POS Vendor for FIR%' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
        <calculation class='tableau' formula='&quot;Include&quot;' />
        <members>
          <member value='&quot;Include&quot;' />
          <member value='&quot;Exclude&quot;' />
        </members>
      </column>
      <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
        <calculation class='tableau' formula='&quot;Local&quot;' />
        <members>
          <member value='&quot;Local&quot;' />
          <member value='&quot;Eur&quot;' />
        </members>
      </column>
      <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
        <calculation class='tableau' formula='12.5' />
      </column>
      <column caption='Measure I' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
        <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
        <members>
          <member value='&quot;Successful Orders&quot;' />
          <member value='&quot;GMV&quot;' />
          <member value='&quot;AOV&quot;' />
          <member value='&quot;Avg Basket Value&quot;' />
          <member value='&quot;Avg Delivery Fee TGO&quot;' />
          <member value='&quot;Avg Delivery Fee TMP&quot;' />
          <member value='&quot;Avg Service Fee&quot;' />
          <member value='&quot;TGO Share, \%&quot;' />
          <member value='&quot;TGO Orders&quot;' />
          <member value='&quot;TMP Orders&quot;' />
          <member value='&quot;Pickup Orders&quot;' />
        </members>
      </column>
      <column caption='Metric' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Actual&quot;'>
        <calculation class='tableau' formula='&quot;Actual&quot;' />
        <members>
          <member value='&quot;Actual&quot;' />
          <member value='&quot;BE&quot;' />
          <member value='&quot;Budget&quot;' />
        </members>
      </column>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[Parameter 6]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Actual&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
