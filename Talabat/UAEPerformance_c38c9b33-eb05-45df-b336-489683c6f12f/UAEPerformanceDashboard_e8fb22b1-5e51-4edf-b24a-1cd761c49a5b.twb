      <aliases enabled='yes' />
      <column caption='Date Group' datatype='string' name='[Calculation_993888181016793106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;year&apos;  then STR(YEAR([date]))&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos;  then DATENAME(&apos;month&apos;,[date]) +&apos;, &apos;+ STR(YEAR([date]))&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos;  then &apos;Week &apos; + str(DATEPART(&apos;week&apos;,[date]))&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Daily&apos; then LEFT(DATENAME(&apos;month&apos;,[date]),3) +&apos; &apos;+ STR(DAY([date]))+&apos;, &apos;+ STR(YEAR([date]))&#13;&#10;END' />
      </column>
      <column caption='City Filter' datatype='boolean' name='[Calculation_993888181019062291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[city_name] != &apos;all&apos;&#13;&#10;AND [city_name] != &apos;Unknown&apos;' />
      </column>
      <column caption='Avg Daily Orders' datatype='real' name='[Calculation_993888181033197588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([daily_successful_order_count])/COUNTD([date])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Area Performance' datatype='table' name='[__tableau_internal_object_id__].[_A3AB1A43A0CE4737840E4AF9B28AC51D]' role='measure' type='quantitative' />
      <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Succesful Orders' datatype='integer' name='[daily_successful_order_count]' role='measure' type='quantitative' />
      <column caption='GMV' datatype='real' name='[daily_successful_order_gmv_lc]' role='measure' type='quantitative' />
      <drill-paths>
        <drill-path name='country_name, city_name'>
          <field>[country_name]</field>
          <field>[city_name]</field>
        </drill-path>
      </drill-paths>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Area Performance' id='_A3AB1A43A0CE4737840E4AF9B28AC51D'>
            <properties context=''>
              <relation connection='bigquery.0u4uwt6168pt5h14bhfi90f9d690' name='Custom SQL Query' type='text'><![CDATA[select *from tlb-data-prod.data_platform.agg_order_performance 

where country_name="UAE"

AND DATE >>=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -6 MONTH)

AND vertical<<>>"all" and city_name<<>>"all" and area_name<<>>"all"]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
