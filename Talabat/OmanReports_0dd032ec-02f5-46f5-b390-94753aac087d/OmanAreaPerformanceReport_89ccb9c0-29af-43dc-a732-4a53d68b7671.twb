COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT fct_logistics_order.is_logistics_preorder AND fct_logistics_order.order_status='completed' THEN fct_logistics_order.order_delay/60 END) >> 45) THEN fct_logistics_order.order_code ELSE NULL END ) as od_orders_45_mins, 


COUNT(DISTINCT CASE WHEN fct_logistics_order.order_delay IS NOT NULL AND NOT fct_logistics_order.is_logistics_preorder  THEN fct_logistics_order.order_code END ) AS od_order_base,

COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   AND  dim_order_fail_reason.owner   = 'VENDOR' THEN  1   ELSE 0 END ), 0) as vfr_orders,
COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful    and dim_order_fail_reason.is_logistics_reason  THEN  1   ELSE 0 END ), 0) as lfr_orders,

COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0) AS fail_order_base,

FROM
