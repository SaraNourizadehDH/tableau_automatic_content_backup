      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1o7rss10x25hkm1fcefbp1lch10n' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Measure I (copy)_2394507683910381568]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Daily Orders&quot;'>
              <calculation class='tableau' formula='&quot;Avg Daily Orders&quot;' />
            </column>
            <column caption='Granuality' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='POS Vendor for FIR%' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column caption='Cost per Order (Add only in LC)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='12.5'>
              <calculation class='tableau' formula='12.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o7rss10x25hkm1fcefbp1lch10n'>
            <column caption='Day' datatype='date' name='[Calculation_1305199502088626181]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [date]))' />
            </column>
            <column caption='Week' datatype='date' name='[Calculation_1305199502088781830]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [date]))' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_1305199502089363463]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Report Date' datatype='date' name='[Calculation_1305199502089445384]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; and [granularity] = &apos;day&apos; then [Calculation_1305199502088626181]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; and [granularity] = &apos;week&apos; then [Calculation_1305199502088781830]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MTD&apos; and [granularity] = &apos;MTD&apos; then [Calculation_993888180307652612]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; and CONTAINS([granularity],&apos;month&apos;) then [Calculation_1305199502089363463]&#13;&#10;END' />
            </column>
            <column caption='Net Take' datatype='real' name='[Calculation_1305199502487212106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(sum([Calculation_993888180360962063]))&#13;&#10;+&#13;&#10;ZN(sum([Calculation_993888180360671246]))&#13;&#10;+&#13;&#10;ZN(sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Calculation_993888180357890060] END))&#13;&#10;+&#13;&#10;ZN(sum([Calculation_993888180352491527]))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;[Calculation_1305199502487875659]' />
            </column>
            <column caption='Delivery Cost' datatype='real' name='[Calculation_1305199502487875659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; and [Parameters].[Parameter 3] = &quot;Local&quot;&#13;&#10;    then [Parameters].[Parameter 4]&#13;&#10;    *[daily_successful_order_count]&#13;&#10;    &#13;&#10;    ELSEIF [delivery_arrangement]=&quot;TGO&quot; and [Parameters].[Parameter 3] = &quot;Eur&quot;&#13;&#10;    THEN ([Parameters].[Parameter 4] * [exchange_rate_to_eur]&#13;&#10;    * [daily_successful_order_count])&#13;&#10;END)&#13;&#10;)' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_2394507683949334534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_993888180283871233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MTD&apos; then [granularity] = &apos;MTD&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; then [granularity] = &apos;month&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granularity &lt;&gt; RR Filter' datatype='boolean' name='[Calculation_993888180295794691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]&lt;&gt; &apos;month-runrate-mtf&apos;' />
            </column>
            <column caption='MTD' datatype='date' name='[Calculation_993888180307652612]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_993888180350599173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_order_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_order_gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='Service Fee' datatype='real' name='[Calculation_993888180352491527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_service_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_service_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_993888180357099528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Local&apos; then &#13;&#10;[daily_successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_993888180357890060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_delivery_fee_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_delivery_fee_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Discount Amount' datatype='real' name='[Calculation_993888180359475213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_discount_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_discount_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='TGO Amount' datatype='real' name='[Calculation_993888180360671246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_tgo_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_tgo_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Commission Amount' datatype='real' name='[Calculation_993888180360962063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_commission_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_commission_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Measure Value II' datatype='string' datatype-customized='true' name='[Measure Value (copy)_661747729821208579]' role='measure' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Measure I (copy)_2394507683910381568] &#13;&#10;when &quot;Total Orders&quot; then &#13;&#10;//str(round(sum([Successful orders ]), 0)) &#13;&#10;&#13;&#10;//IF LEN(str(round(sum([Successful orders ]), 0)) ) &lt;= 3 THEN str(round(sum([Successful orders ]), 0)) &#13;&#10;//ELSEIF LEN(str(round(sum([Successful orders ]), 0)) ) = 4 OR LEN(str(round(sum([Successful orders ]), 0)) ) = 5 or LEN(str(round(sum([Successful orders ]), 0)) ) = 6 THEN&#13;&#10;//LEFT(str(round(sum([Successful orders ]), 0)) , LEN(str(round(sum([Successful orders ]), 0)) ) - 3) + &apos;,&apos; + RIGHT(str(round(sum([Successful orders ]), 0)), 3)&#13;&#10;&#13;&#10;//ELSE&#13;&#10;//LEFT(str(round(sum([Successful orders ]), 0)), LEN(str(round(sum([Successful orders ]), 0))) - 6) + &apos;,&apos; +&#13;&#10;//RIGHT(str(round(sum([Successful orders ]), 0)), 3) + &apos;,&apos; +&#13;&#10;//RIGHT(LEFT(str(round(sum([Successful orders ]), 0)), LEN(str(round(sum([Successful orders ]), 0))) - 3), 3)&#13;&#10;//END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;IF LEN(str(round(sum([daily_successful_order_count]), 0))) &lt;= 3 THEN&#13;&#10;    str(round(sum([daily_successful_order_count]), 0)) &#13;&#10;ELSEIF (LEN(str(round(sum([daily_successful_order_count]), 0))) = 4 OR LEN(str(round(sum([daily_successful_order_count]), 0))) = 5 OR LEN(str(round(sum([daily_successful_order_count]), 0))) = 6) THEN&#13;&#10;    LEFT(str(round(sum([daily_successful_order_count]), 0)), LEN(str(round(sum([daily_successful_order_count]), 0))) - 3) &#13;&#10;    + &apos;,&apos; + RIGHT(str(round(sum([daily_successful_order_count]), 0)), 3)&#13;&#10;ELSE&#13;&#10;    LEFT(str(round(sum([daily_successful_order_count]), 0)), LEN(str(round(sum([daily_successful_order_count]), 0))) - 6) &#13;&#10;    + &apos;,&apos; + MID(str(round(sum([daily_successful_order_count]), 0)), LEN(str(round(sum([daily_successful_order_count]), 0))) - 5, 3) &#13;&#10;    + &apos;,&apos; + RIGHT(str(round(sum([daily_successful_order_count]), 0)), 3)&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;when &quot;GMV&quot; then &#13;&#10;//str(round(sum([GMV]), 0)) &#13;&#10;&#13;&#10;IF LEN(str(round(sum([Calculation_993888180350599173]), 0)) ) &lt;= 3 THEN str(round(sum([Calculation_993888180350599173]), 0)) &#13;&#10;ELSEIF (LEN(str(round(sum([Calculation_993888180350599173]), 0)) ) = 4 OR LEN(str(round(sum([Calculation_993888180350599173]), 0)) ) = 5 or LEN(str(round(sum([Calculation_993888180350599173]), 0)) ) = 6) THEN&#13;&#10;LEFT(str(round(sum([Calculation_993888180350599173]), 0)) , LEN(str(round(sum([Calculation_993888180350599173]), 0)) ) - 3) + &apos;,&apos; + RIGHT(str(round(sum([Calculation_993888180350599173]), 0)), 3)&#13;&#10;&#13;&#10;ELSE&#13;&#10;    LEFT(str(round(sum([Calculation_993888180350599173]), 0)), LEN(str(round(sum([Calculation_993888180350599173]), 0))) - 6) &#13;&#10;    + &apos;,&apos; + MID(str(round(sum([Calculation_993888180350599173]), 0)), LEN(str(round(sum([Calculation_993888180350599173]), 0))) - 5, 3) &#13;&#10;    + &apos;,&apos; + RIGHT(str(round(sum([Calculation_993888180350599173]), 0)), 3)&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;//IF LEN(STR(ROUND(SUM([Successful orders ]), 0))) &lt;= 3 THEN&#13;&#10;  //  STR(ROUND(SUM([Successful orders ]), 0))&#13;&#10;//ELSE&#13;&#10;  //  LEFT(STR(ROUND(SUM([Successful orders ]), 0)), LEN(STR(ROUND(SUM([Successful orders ]), 0))) - 3) + &apos;,&apos; +&#13;&#10;  //  RIGHT(LEFT(STR(ROUND(SUM([Successful orders ]), 0)), LEN(STR(ROUND(SUM([Successful orders ]), 0))) - 3), 3)&#13;&#10;//END&#13;&#10;&#13;&#10;//IF LEN(str(round(sum([Successful orders ]), 0)) ) &lt;= 3 THEN str(round(sum([Successful orders ]), 0)) &#13;&#10;//ELSEIF LEN(str(round(sum([Successful orders ]), 0)) ) = 7 OR LEN(str(round(sum([Successful orders ]), 0)) ) = 8 THEN&#13;&#10; //   LEFT(str(round(sum([Successful orders ]), 0)) , LEN(str(round(sum([Successful orders ]), 0)) ) - 3) + &apos;,&apos; + RIGHT(str(round(sum([Successful orders ]), 0)), 3)&#13;&#10;//END&#13;&#10;&#13;&#10;//IF &#13;&#10;//LEN(str(round(sum([Successful orders ]), 0)) ) &lt;= 6 THEN (str(round(sum([Successful orders ]), 0)) )&#13;&#10;//ELSE&#13;&#10;  //  LEFT(str(round(sum([Successful orders ]), 0)), LEN(str(round(sum([Successful orders ]), 0))) - 6) + &apos;,&apos; +&#13;&#10;   // RIGHT(str(round(sum([Successful orders ]), 0)), 3) + &apos;,&apos; +&#13;&#10;   // RIGHT(LEFT(str(round(sum([Successful orders ]), 0)), LEN(str(round(sum([Successful orders ]), 0))) - 3), 3)&#13;&#10;//END&#13;&#10;&#13;&#10;//STR(FORMAT([Measure Value II], &quot;#,##0&quot;))&#13;&#10;//STR(FORMAT([Number], &quot;#,##0&quot;))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &quot;Avg Daily Orders&quot; THEN&#13;&#10;        &#13;&#10;&#13;&#10;//STR(ROUND(SUM(IF [Time Period] = &quot;Day&quot; THEN [average_daily_successful_orders] &#13;&#10;&#13;&#10;//ELSEIF [Time Period] = &quot;Week&quot; THEN [average_daily_successful_orders]&#13;&#10;//ELSEIF [Time Period] = &quot;Month&quot; THEN [average_daily_successful_orders]&#13;&#10;//ELSEIF [Time Period] = &quot;MTD&quot; THEN [average_daily_successful_orders]&#13;&#10;//END)&#13;&#10;///&#13;&#10;// COUNTD(IF [Time Period] = &quot;Day&quot; THEN [date] &#13;&#10;// ELSEIF  [Time Period] = &quot;Week&quot; THEN [date] &#13;&#10;// ELSEIF  [Time Period] = &quot;Month&quot; THEN [date] &#13;&#10;// ELSEIF  [Time Period] = &quot;MTD&quot; THEN [date] &#13;&#10;//END), 0)) &#13;&#10;&#13;&#10;IF LEN(STR(ROUND(SUM(IF [Parameters].[Parameter 1] = &quot;Day&quot; THEN [average_daily_successful_orders] &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Week&quot; THEN [average_daily_successful_orders]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Month&quot; THEN [average_daily_successful_orders]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;MTD&quot; THEN [average_daily_successful_orders]&#13;&#10;END)&#