      <column caption='date v2' datatype='real' name='[Calculation_1277333508873228288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date])' />
      </column>
      <column caption='new date' datatype='datetime' name='[Calculation_1277333508875857921]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; THEN DATETRUNC(&quot;day&quot;, [date])&#13;&#10;when &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;, [date])&#13;&#10;when &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;, [date])&#13;&#10;END' />
      </column>
      <column caption='Last' datatype='integer' name='[Calculation_1277333508879781890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FIR Usage %' datatype='real' name='[Calculation_1626080999939895296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fir_used])/sum([fir_order_base])' />
      </column>
      <column caption='VD2  &gt;10 mins %' datatype='real' name='[Calculation_1626080999940149249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vd_orders])/SUM([vd_order_base])' />
      </column>
      <column caption='OD &gt;10 mins %' datatype='real' name='[Calculation_1626080999940435970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([od_orders])/SUM([od_order_base])' />
      </column>
      <column caption='Stacking %' datatype='real' name='[Calculation_1626080999940612099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders])/SUM([stacked_order_base])' />
      </column>
      <column caption='RL &gt;10 mins %' datatype='real' name='[Calculation_1626080999940796420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rl_orders])/SUM([rl_order_base])' />
      </column>
      <column caption='Avg successful Orders' datatype='real' name='[Calculation_1626080999941107717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_count])/COUNTD([date])' />
      </column>
      <column caption='Avg GMV (LC)' datatype='real' name='[Calculation_1626080999941226502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_amount_lc])/COUNTD([date])' />
      </column>
      <column caption='NFR %' datatype='real' name='[Calculation_1626080999941459975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nfr_order])/SUM([nfr_order_base])' />
      </column>
      <column caption='Customer Contact Rate %' datatype='real' name='[Calculation_1626080999941586952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_contact_orders])/SUM([customer_contact_order_base])' />
      </column>
      <column caption='Actual DT (mins)' datatype='real' name='[Calculation_1626080999941980169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_actual_delivery_time])/SUM([actual_dt_base])' />
      </column>
      <column caption='Promised DT (mins)' datatype='real' name='[Calculation_1626080999942189066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_promised_delivery_time])/sum([promised_dt_base])' />
      </column>
      <column caption='Estimated driving time (mins)' datatype='real' name='[Calculation_1626080999942320139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_estimated_driving_time])/SUM([drive_time_base])' />
      </column>
      <column caption='Avg hold back time (mins)' datatype='real' name='[Calculation_1626080999942647820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_hold_back_time])/SUM([hold_back_base])' />
      </column>
      <column caption='Avg DF (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1626080999942848525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_delivery_fee_amount_lc])/SUM([orders_count])' />
      </column>
      <column caption='Avg SF (LC)' datatype='real' name='[Calculation_1626080999943032846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_service_fee_amount_lc])/SUM([orders_count])' />
      </column>
      <column caption='Incentivized Order Share %' datatype='real' name='[Calculation_1626080999943602191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_incentivized_with_gem])/SUM([orders_count])' />
