    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.1o7rss10x25hkm1fcefbp1lch10n' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.14stm290zh1lxs16p04lh1n3sfn1'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='natasha.sango@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.14stm290zh1lxs16p04lh1n3sfn1' name='Custom SQL Query' type='text'><![CDATA[select * from 

(SELECT
   country_name,
  city_name,
  CASE
    WHEN UPPER(shop_type)="NFV" THEN "LS"
    ELSE shop_type
END
  AS shop_type,

  vertical,
  delivery_arrangement,
  granularity,
  date,
  is_exclusive,
  CASE
    WHEN shop_type="Restaurant" AND current_assigned_team_leader_name IN ('Adem Colak' ,'Salma Soueif') THEN TRUE
  ELSE
  FALSE
END
  AS is_food_ka,
    CASE
    WHEN kitchen_group_name="Delivery Hero Kitchens" THEN true
    ELSE false
END
  AS is_dh_kitchen,
  ANY_VALUE(exchange_rate_to_eur) AS exchange_rate_to_eur,
  SUM(daily_successful_order_count) AS daily_successful_order_count,
  SUM(daily_order_new_customer_count) AS daily_order_new_customer_count,
  SUM(daily_successful_order_gmv_lc) AS daily_successful_order_gmv_lc,
  SUM(daily_successful_basket_amount_lc) AS daily_successful_basket_amount_lc,
  SUM(daily_successful_delivery_fee_amount_lc) AS daily_successful_delivery_fee_amount_lc,
  SUM(daily_successful_gem_commission_amount_lc) AS daily_successful_gem_commission_amount_lc,
  SUM(daily_net_failed_order_count) AS daily_net_failed_order_count,
  SUM(daily_successful_commission_amount_lc) AS daily_successful_commission_amount_lc,
  SUM(daily_successful_commissionable_gmv_amount_lc) AS daily_successful_commissionable_gmv_amount_lc,
  SUM(daily_successful_tgo_amount_lc) AS daily_successful_tgo_amount_lc,
  SUM(daily_successful_service_fee_amount_lc) AS daily_successful_service_fee_amount_lc,
  SUM(daily_successful_incentivized_order_count_wo_gem) AS daily_successful_incentivized_order_count_wo_gem,
  SUM(daily_successful_incentivized_order_count_with_gem) AS daily_successful_incentivized_order_count_with_gem,
  SUM(daily_successful_fd_order_count) AS daily_successful_fd_order_count,
  SUM(daily_successful_discount_amount_lc) AS daily_successful_discount_amount_lc,
  SUM(daily_successful_gem_discount_amount_lc) AS daily_successful_gem_discount_amount_lc,
  SUM(daily_successful_tpro_order_count) AS daily_successful_tpro_order_count,
  SUM(gross_orders) AS gross_orders,
  SUM(customer_contacts) AS customer_contacts,
  SUM(daily_logistics_order_count) AS daily_logistics_order_count,
  SUM(daily_vendor_late_orders_5min) AS daily_vendor_late_orders_5min,
  SUM(daily_vendor_late_orders_10min) AS daily_vendor_late_orders_10min,
  SUM(daily_all_vendor_late_orders) AS daily_all_vendor_late_orders,
  SUM(daily_vendor_clean_time_orders) AS daily_vendor_clean_time_orders,
  SUM(daily_vendor_late_min) AS daily_vendor_late_min,
  SUM(daily_vendor_clean_time_min) AS daily_vendor_clean_time_min,
  SUM(daily_delivery_time_min) AS daily_delivery_time_min,
  SUM(daily_promised_delivery_time) AS daily_promised_delivery_time,
  SUM(daily_rider_late_orders_5min) AS daily_rider_late_orders_5min,
  SUM(daily_rider_late_orders_10min) AS daily_rider_late_orders_10min,
  SUM(daily_all_delivery_late_orders) AS daily_all_delivery_late_orders,
  SUM(daily_all_rider_late_orders) AS daily_all_rider_late_orders,
  SUM(daily_food_ready_prep_min) AS daily_food_ready_prep_min,
  SUM(daily_delivery_distance) AS daily_delivery_distance,
