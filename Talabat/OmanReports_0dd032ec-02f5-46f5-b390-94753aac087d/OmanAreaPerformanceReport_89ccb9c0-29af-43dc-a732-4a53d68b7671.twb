EN 1&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 0&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;Commission Rate [Sales Defn] %&quot; &#13;&#10;Then IF [Calculation_147492948350971905] &gt; 0 THEN 1&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 0&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;Commission Rev. % of GMV&quot; &#13;&#10;Then IF [Calculation_147492948350971905] &gt; 0 THEN 1&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 0&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;TGO Share, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 1&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 0&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;OD&gt;10 mins, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;OD&gt;20 mins, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;OD&gt;30 mins, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;OD&gt;45 mins, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;when &quot;VFR, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;&#13;&#10;when &quot;LFR, %&quot; Then IF [Calculation_147492948350971905] &gt; 0 THEN 0&#13;&#10;ELSEIF [Calculation_147492948350971905] &lt; 0 THEN 1&#13;&#10;ELSE 0.5 END&#13;&#10;&#13;&#10;&#13;&#10;   ELSE 0.5&#13;&#10;&#13;&#10;&#13;&#10;END'>
