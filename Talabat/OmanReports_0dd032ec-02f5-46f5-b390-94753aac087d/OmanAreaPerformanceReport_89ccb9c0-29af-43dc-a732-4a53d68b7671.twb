&#13;&#10;     ROUND([Calculation_1765692585910882311] * 100, 2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Measure I (copy)_2394507683910381568] = &apos;CVR by Subsessions&apos; THEN&#13;&#10;     ROUND([Calculation_1765692585910882311] * 100, 2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Measure I (copy)_2394507683910381568] = &apos;Commission Rev. % of GMV&apos; THEN&#13;&#10;     ROUND([Calculation_1765692585910882311] * 100, 2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Measure I (copy)_2394507683910381568] = &apos;Commission Rate [Sales Defn] %&apos; THEN&#13;&#10;     ROUND([Calculation_1765692585910882311] * 100, 2)&#13;&#10;ELSEIF [Parameters].[Measure I (copy)_2394507683910381568] = &apos;NTR, %&apos; THEN&#13;&#10;     ROUND([Calculation_1765692585910882311] * 100, 2)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [Calculation_1765692585910882311]&#13;&#10;END' />
      </column>
