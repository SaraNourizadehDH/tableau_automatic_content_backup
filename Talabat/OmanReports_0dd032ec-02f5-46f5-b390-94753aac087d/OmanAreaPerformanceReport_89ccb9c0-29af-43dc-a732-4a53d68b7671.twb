COUNT(DISTINCT CASE WHEN fct_logistics_order.order_delay IS NOT NULL THEN fct_logistics_order.order_code END ) AS od_order_base,&#13;
COUNT(DISTINCT CASE WHEN (( fct_logistics_order.rider_late/60 ) &gt;&gt; 10) THEN fct_logistics_order.order_code ELSE NULL END) as rl_orders,&#13;
COUNT(DISTINCT CASE WHEN NOT (( fct_logistics_order.rider_late/60 ) IS NULL) THEN fct_logistics_order.order_code ELSE NULL END ) AS rl_order_base,&#13;
&#13;
&#13;
sum(fct_logistics_order.estimated_driving_time/60 ) AS avg_estimated_driving_time,&#13;
&#13;
COUNT(DISTINCT CASE WHEN fct_logistics_order.primary_stacked_count &gt;&gt; 0 THEN fct_logistics_order.order_code END) as stacked_orders, &#13;
&#13;
COUNT(DISTINCT CASE WHEN (UPPER( fct_logistics_order.order_status ) = UPPER(&apos;completed&apos;)) THEN fct_logistics_order.order_code ELSE NULL END) AS stacked_order_base,&#13;
&#13;
sum(fct_logistics_order.hold_back_time/60 ) AS avg_hold_back_time,&#13;
&#13;
count(distinct if(fct_logistics_order.estimated_driving_time is not null, fct_order_info.order_id,null)) as drive_time_base,&#13;
count(distinct if(fct_logistics_order.hold_back_time is not null, fct_order_info.order_id,null)) as hold_back_base,&#13;
count(distinct if(fct_logistics_order.actual_delivery_time is not null, fct_order_info.order_id,null)) as actual_dt_base,&#13;
count(distinct if(fct_logistics_order.promised_delivery_time is not null, fct_order_info.order_id,null)) as promised_dt_base,&#13;
count(distinct if(fct_logistics_order.estimated_prep_time is not null, fct_order_info.order_id,null)) as ept_dt_base,&#13;
&#13;
&#13;
--AVG(CAST( fct_order_info.service_fee_amount_lc   AS NUMERIC)) AS average_service_fee_lc&#13;
&#13;
&#13;
FROM&#13;
  `tlb-data-prod.data_platform.fct_order_info` AS fct_order_info&#13;
LEFT JOIN&#13;
  `tlb-data-prod.data_platform.fct_logistics_order` AS fct_logistics_order&#13;
ON&#13;
  fct_logistics_order.order_id = fct_order_info.order_id&#13;
  AND fct_logistics_order.is_talabat&#13;
  AND fct_logistics_order.is_rider_order&#13;
  AND fct_logistics_order.created_date &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -7 MONTH)&#13;
&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_order_status` AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_location_info` AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id&#13;
&#13;
WHERE&#13;
 fct_order_info.country_code=&quot;OM&quot; &#13;
 AND fct_order_info.order_date &gt;&gt;=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -6 MONTH)&#13;
&#13;
GROUP BY 1,2,3,4,5,6,7,8,9) main &#13;
&#13;
&#13;
Left join (SELECT&#13;
&#13;
 fct_order_info.country_code as country,&#13;
  fct_order_info.order_date AS date,&#13;
&#13;
EXTRACT(HOUR FROM fct_order_info.order_time ) AS hour_of_day,&#13;
delivery_location.city_name AS city,&#13;
fct_order_info.delivery_arrangement  AS delivery_arrangement,&#13;
   &#13;
case&#13;
    when dim_chain.vertical_class = &apos;food&apos; then &apos;Restaurant&apos;&#13;
    when dim_chain.sub_vertical = &apos;darkstore&apos; then &apos;Darkstore&apos;&#13;
    else &apos;NFV&apos;&#13;
    end as vertical,&#13;
     &#13;
     dim_chain.vertical  AS sub_vertical,&#13;
     case when dim_chain.vertical_class = &apos;food&apos; and  dim_vendor_info.team_leader_name  IN (&apos;Adem Colak&apos; , &apos;Salma Soueif&apos;)  then true else false end as is_food_ka,&#13;
    case when dim_vendor_info.is_exclusive  then true else false end as is_kpp,&#13;
&#13;
&#13;
&#13;
COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE NULL END), 0) as customer_contact_orders,&#13;
&#13;
&#13;
&#13;
&#13;
 ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  1   ELSE NULL END&#13;
,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat(&apos;0x&apos;, substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END&#13;
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat(&apos;0x&apos;, substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END&#13;
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat(&apos;0x&apos;, substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END&#13;
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat(&apos;0x&apos;, substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END&#13;
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) AS customer_contact_order_base&#13;
&#13;
&#13;
&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` AS fct_order_info&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`&#13;
     AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_location_info`&#13;
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.fct_contact` AS fct_contact ON fct_contact.order_id = (CAST(fct_order_info.order_id AS STRING))&#13;
    and  (DATE(fct_contact.created_at_time_local )) &gt;&gt;= DATE_ADD(DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -180 DAY), YEAR), INTERVAL -2 YEAR)&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_contact_reason`&#13;
     AS dim_contact_reason ON fct_contact.contact_reason_id=dim_contact_reason.contact_reason_id&#13;
&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id&#13;
&#13;
WHERE  fct_order_info.country_code=&quot;OM&quot; &#13;
 AND fct_order_info.order_date &gt;&gt;=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -6 MONTH)&#13;
&#13;
AND not fct_order_info.is_test&#13;
&#13;
GROUP BY&#13;
    1,2,3,4,5,6,7,8,9&#13;
) contact_rate using (country,date,hour_of_day,city,delivery_arrangement,vertical,sub_vertical,is_food_ka,is_kpp)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
