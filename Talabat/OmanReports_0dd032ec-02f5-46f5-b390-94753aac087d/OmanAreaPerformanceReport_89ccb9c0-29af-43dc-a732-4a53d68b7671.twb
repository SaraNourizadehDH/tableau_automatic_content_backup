  SUM(vendor_late_orders_10min_V2) AS vendor_late_orders_10min_V2,
  SUM(all_vendor_late_orders_V2) AS all_vendor_late_orders_V2,
  SUM(daily_total_completed_orders_fir) AS daily_total_completed_orders_fir,
