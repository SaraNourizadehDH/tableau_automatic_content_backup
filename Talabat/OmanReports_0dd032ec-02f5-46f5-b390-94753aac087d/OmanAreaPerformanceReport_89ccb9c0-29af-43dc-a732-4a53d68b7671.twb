            </column>
            <column caption='Measure I' datatype='real' name='[Calculation_1494913646988873732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[KPI (copy)_972214632283451394] &#13;&#10;&#13;&#10;when &quot;Total Orders&quot; then sum([daily_successful_order_count])&#13;&#10;when &quot;Avg Daily Orders&quot; then [Calculation_2394507683951202311]&#13;&#10;when &quot;GMV&quot; then sum([Calculation_993888180350599173])&#13;&#10;&#13;&#10;when &quot;ABV&quot; then ([Calculation_2394507683929485316])&#13;&#10;when &quot;AOV&quot; then ([Calculation_2394507683929186307])&#13;&#10;when &quot;Avg. SF&quot; then ([Calculation_2394507683929845765])&#13;&#10;when &quot;Avg Delivery Fee TGO&quot; then ([Calculation_157907526782533632])&#13;&#10;when &quot;Avg EF TGO&quot; then ([Calculation_1305199502433673256])&#13;&#10;when &quot;VD2 &gt;10 mins, %&quot; then [Calculation_1305199502440886316]&#13;&#10;&#13;&#10;when &quot;FIR usage, %&quot; then ([Calculation_1305199502141394978])&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;when &quot;EPT (min)&quot; then ([Calculation_1305199502471319602])&#13;&#10;when &quot;% Incentivized Orders (Incl. Gems)&quot; then ([Calculation_1305199502473269301])&#13;&#10;when &quot;Incentivized Orders (Incl gem)&quot; then sum([daily_successful_incentivized_order_count_with_gem])&#13;&#10;&#13;&#10;when &quot;Customer CR, %&quot; then [Calculation_1305199502474973241]&#13;&#10;when &quot;NFR, %&quot; then [Calculation_1305199502476124218]&#13;&#10;&#13;&#10;when &quot;Avg DT (min)&quot; then [Calculation_1305199502476906555]&#13;&#10;when &quot;Avg PDT (min)&quot; then [Calculation_1305199502477537340]&#13;&#10;when &quot;LFR, %&quot; then [Calculation_4266316268320526337]&#13;&#10;when &quot;OD&gt;10 mins, %&quot; then [Calculation_1305199502478204990]&#13;&#10;when &quot;OD&gt;20 mins, %&quot; then [Calculation_4266316268321583106]&#13;&#10;when &quot;OD&gt;30 mins, %&quot; then [Calculation_4266316268322025475]&#13;&#10;when &quot;OD&gt;45 mins, %&quot; then [Calculation_4266316268322152452]&#13;&#10;when &quot;% RL &gt; 10min&quot; then [Calculation_1305199502479429695]&#13;&#10;&#13;&#10;when &quot;Avg Delivery Distance (km)&quot; then [Calculation_1305199502479806528]&#13;&#10;when &quot;Avg Driving Time (min)&quot; then [Calculation_1305199502480392257]&#13;&#10;when &quot;% Orders with Stacking&quot; then [Calculation_1305199502481174594]&#13;&#10;when &quot;Avg Hold Back Time (min)&quot; then [Calculation_1305199502481911875]&#13;&#10;when &quot;Platform Acquisition&quot; then SUM([daily_order_new_customer_count])&#13;&#10;when &quot;Viewed Menu Subsessions&quot; then sum([daily_viewed_menu_subsession_count])&#13;&#10;when &quot;Placed Order Subsessions&quot; then SUM([daily_placed_order_sub_session_count])&#13;&#10;when &quot;CVR by Subsessions&quot; then [Calculation_1305199502484267076]&#13;&#10;when &quot;Avg Discount Amount&quot; then [Calculation_1305199502486073416]&#13;&#10;when &quot;Net Take per Order&quot; then [Calculation_1305199502490361932]&#13;&#10;when &quot;NTR, %&quot; then [Calculation_1305199502487068745]&#13;&#10;when &quot;Commission Rate [Sales Defn] %&quot; then [Calculation_1305199502491349069]&#13;&#10;when &quot;Commission Rev. % of GMV&quot; then [Calculation_1305199502491844686]&#13;&#10;when &quot;TGO Share, %&quot; then [Calculation_1305199502441336877]&#13;&#10;when &quot;VFR, %&quot; then [Calculation_4266316263003361280]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Avg Delivery Fee TGO' datatype='real' name='[Calculation_157907526782533632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_arrangement] = &quot;TGO&quot; then [Calculation_993888180357890060] end)&#13;&#10;/&#13;&#10;sum(IF [delivery_arrangement] = &quot;TGO&quot; then [daily_successful_order_count] end)' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_2394507683929186307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_993888180350599173])/SUM([daily_successful_order_count])' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_2394507683929485316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_993888180357099528])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Avg. SF' datatype='real' name='[Calculation_2394507683929845765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_993888180352491527])/sum([daily_successful_order_count])' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_2394507683949334534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Daily Orders ' datatype='real' name='[Calculation_2394507683951202311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Week&apos; THEN SUM([average_daily_successful_orders])&#13;&#10;&#13;&#10;    WHEN &apos;Day&apos; THEN SUM([average_daily_successful_orders]) / COUNTD([date])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN SUM([average_daily_successful_orders])&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;    WHEN &apos;MTD&apos; THEN SUM([average_daily_successful_orders])/COUNTD([date])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='VFR, %' datatype='real' name='[Calculation_4266316263003361280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_count])&#13;&#10;/&#13;&#10;sum(vfr_net_order_count)' />
            </column>
            <column caption='LFR, %' datatype='real' name='[Calculation_4266316268320526337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([lfr_orders])&#13;&#10;/&#13;&#10;sum(fail_order_base)' />
            </column>
            <column caption='OD &gt;20 mins, %' datatype='real' name='[Calculation_4266316268321583106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_orders_20_mins])&#13;&#10;/&#13;&#10;sum(od_order_base)' />
            </column>
            <column caption='OD&gt;30 mins, %' datatype='real' name='[Calculation_4266316268322025475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_orders_30_mins])&#13;&#10;/&#13;&#10;sum(od_order_base)' />
            </column>
            <column caption='OD&gt;45 mins, %' datatype='real' name='[Calculation_4266316268322152452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_orders_45_mins])&#13;&#10;/&#13;&#10;sum(od_order_base)' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_993888180283871233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; then [granularity] = &apos;day&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; then [granularity] = &apos;week&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MTD&apos; then [granularity] = &apos;MTD&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; then [granularity] = &apos;month&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='MTD' datatype='date' name='[Calculation_993888180307652612]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_993888180350599173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local&quot; then&#13;&#10;[daily_successful_order_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 3] = &quot;Eur&quot; then &#13;&#10;[daily_successful_order_gmv_eur]&#13;&#10;END' />
