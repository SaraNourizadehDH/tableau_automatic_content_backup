 where business_entity=&quot;AE&quot; and not is_forecast&#13;
 and DATE BETWEEN DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -7 MONTH)&#13;
 and current_date()-1</relation>
