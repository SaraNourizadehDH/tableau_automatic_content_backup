COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT fct_logistics_order.is_logistics_preorder AND fct_logistics_order.order_status='completed' THEN fct_logistics_order.order_delay/60 END) >> 10) THEN fct_logistics_order.order_code ELSE NULL END ) as od_orders_10_mins, 

COUNT(DISTINCT CASE WHEN (( CASE WHEN NOT fct_logistics_order.is_logistics_preorder AND fct_logistics_order.order_status='completed' THEN fct_logistics_order.order_delay/60 END) >> 20) THEN fct_logistics_order.order_code ELSE NULL END ) as od_orders_20_mins, 

