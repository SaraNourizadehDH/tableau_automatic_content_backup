      <column caption='Date range (table)' datatype='string' name='[Calculation_173388599066402846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 4 1] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Month (copy)_3498804330573443079]) THEN &apos;Selected Period&apos;&#10;    &#10;    ELSEIF [Parameters].[Parameter 22 1] = &apos;Previous Month&apos; and&#10;    [date] = DATEADD(&apos;month&apos;, -1, [Parameters].[Month (copy)_3498804330573443079]) &#10;    THEN &quot;Comparison Period&quot;&#10;    ELSEIF [Parameters].[Parameter 22 1] = &apos;Previous Quarter&apos; and&#10;    [date] = DATEADD(&apos;quarter&apos;, -1, [Parameters].[Month (copy)_3498804330573443079]) &#10;    THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
      </column>
      <column caption='Order Contribution' datatype='real' default-format='p0.00%' name='[Calculation_173388599352991775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_active_order_count])/sum([Active Users (copy)_173388599385296932])' />
