      </column>
      <column caption='Exclusive Deal Metric 2' datatype='real' name='[Exclusive Deal Metric (copy)_121104662777503750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;when &apos;Adoption %&apos; then (sum([pro_exclusive_deal_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;when &apos;Utilization %&apos; then (sum([pro_exclusive_deal_order_count])/sum([pro_active_order_count]))*-1&#10;when &apos;Orders&apos; then sum([pro_exclusive_deal_order_count])&#10;when &apos;Customers&apos; then sum([pro_exclusive_deal_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_exclusive_deal_order_count])/sum([pro_exclusive_deal_user_count])&#10;when &apos;GMV&apos; then sum([pro_exclusive_deal_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([pro_exclusive_deal_gmv_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_exclusive_deal_savings_amount_lc])&#10;when &apos;Avg. Savings per Order&apos; then sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_user_count])&#10;when &apos;Spend per Customer&apos; then sum([pro_exclusive_deal_gmv_amount_lc])/sum([pro_exclusive_deal_user_count])&#10;end' />
      </column>
      <column caption='Free Delivery Metric 2' datatype='real' name='[Free Delivery Metric (copy)_121104662777434116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;when &apos;Adoption %&apos; then (sum([pro_free_delivery_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;when &apos;Utilization %&apos; then (sum([pro_free_delivery_order_count])/sum([pro_active_order_count]))*-1&#10;when &apos;Orders&apos; then sum([pro_free_delivery_order_count])&#10;when &apos;Customers&apos; then sum([pro_free_delivery_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_free_delivery_order_count])/sum([pro_free_delivery_user_count])&#10;when &apos;GMV&apos; then sum([pro_free_delivery_gmv_amount_lc])&#10;when &apos;AOV&apos; then  sum([pro_free_delivery_gmv_amount_lc])/sum([pro_free_delivery_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_free_delivery_basket_amount_lc])/sum([pro_free_delivery_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_free_delivery_savings_amount_lc])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_free_delivery_savings_amount_lc])/sum([pro_free_delivery_user_count])&#10;When &apos;Avg. Savings per Order&apos; then sum([pro_free_delivery_savings_amount_lc])/sum([pro_free_delivery_order_count])&#10;when &apos;Spend per Customer&apos; then sum([pro_free_delivery_gmv_amount_lc])/sum([pro_free_delivery_user_count])&#10;end' />
      </column>
      <column caption='Basket Value' datatype='real' name='[GMV (copy)_6255148043360813068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;Pro&apos; then [pro_benefit_basket_amount_lc]&#10;when &apos;Booster&apos; THEN [pro_booster_basket_amount_lc]&#10;when &apos;Exclusive Deal&apos; then [pro_exclusive_deal_basket_amount_lc]&#10;when &apos;Free Delivery&apos; then [pro_free_delivery_basket_amount_lc]&#10;end' />
      </column>
      <column caption='Metric' datatype='real' name='[Metric 1 Usage Booster (copy)_5796132724679401521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;&#10;&#10;when &apos;Booster&apos; then if [Parameters].[Parameter 21] = &apos;Best Seller&apos; then [Calculation_5796132724920139829] else [Booster Metric (copy)_5796132724920242230] end&#13;&#10;when &apos;Exclusive Deal&apos; then [Booster Metric (copy)_5796132724920242230]&#13;&#10;when &apos;Free Delivery&apos; then [Booster Metric (copy)_5796132724920242230]&#10;else  [tPro Benefit Metric (copy)_5397212361593352198]&#10;end' />
      </column>
      <column caption='Booster Metric' datatype='real' name='[Metric 2 (copy)_5796132724920475703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 20]&#10;when &apos;Orders&apos; then sum([pro_booster_order_count])&#10;when &apos;Customers&apos; then sum([pro_booster_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_booster_order_count])/sum([pro_booster_user_count])&#10;when &apos;GMV&apos; then sum([pro_booster_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([pro_booster_gmv_amount_lc])/sum([pro_booster_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_booster_basket_amount_lc])/sum([pro_booster_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_booster_savings_amount_lc])&#10;when &apos;Avg. Savings per Order&apos; then sum([pro_booster_savings_amount_lc])/sum([pro_booster_order_count])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_booster_savings_amount_lc])/sum([pro_booster_user_count])&#10;end' />
      </column>
