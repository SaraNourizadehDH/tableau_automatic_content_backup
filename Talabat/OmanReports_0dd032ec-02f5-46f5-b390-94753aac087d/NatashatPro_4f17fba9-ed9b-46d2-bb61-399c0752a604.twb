      </column>
      <column caption='Utilization %' datatype='real' default-format='p0.00%' name='[Adoption % (copy)_5397212361343299587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;tPro&apos; then [Best Seller Utilization (copy)_6255148043371737113]&#10;when &apos;Booster&apos; then [Calculation_6255148043359186955]&#10;when &apos;Exclusive Deal&apos; then [Best Seller Utilization (copy)_6255148043371880474]&#10;when &apos;Free Delivery&apos; then [Best Seller Utilization (copy)_6255148043371737113]&#10;end' />
      </column>
      <column caption='Avg. Total Savings per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average Total Savings per Customer (copy)_6255148043241533443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6255148043237724160]/sum(if [Parameters].[Parameter 18] = &apos;tPro&apos; then [pro_active_order_count] else [pro_benefit_order_count] end)' />
      </column>
      <column caption='Avg. Best Seller Savings per Customer' datatype='real' name='[Avg. Booster Savings per Customer (copy)_5796132724916809779]' role='measure' type='quantitative'>
