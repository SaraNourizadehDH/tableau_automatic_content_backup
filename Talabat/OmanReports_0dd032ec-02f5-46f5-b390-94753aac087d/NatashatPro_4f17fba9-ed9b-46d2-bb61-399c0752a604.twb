      <column caption='Best Seller Metric 2' datatype='real' name='[Best Seller Metric (copy)_121104662777376771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;when &apos;Adoption %&apos; then (sum([best_seller_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;when &apos;Utilization %&apos; then (sum([best_seller_order_count])/sum([pro_active_order_count]))*-1&#10;when &apos;Orders&apos; then sum([best_seller_order_count])&#10;when &apos;Customers&apos; then sum([best_seller_user_count])&#10;when &apos;Order Frequency&apos; then sum([best_seller_order_count])/sum([best_seller_user_count])&#10;when &apos;GMV&apos; then sum([best_seller_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([best_seller_gmv_amount_lc])/sum([best_seller_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([best_seller_basket_amount_lc])/sum([best_seller_order_count])&#10;WHEN &apos;Discount&apos; then sum([best_seller_saving_amount_lc])&#10;when &apos;Avg. Savings per Customer&apos; then sum([best_seller_saving_amount_lc])/sum([best_seller_user_count])&#10;When &apos;Avg. Savings per Order&apos; then sum([best_seller_saving_amount_lc])/sum([best_seller_order_count])&#10;when &apos;Spend per Customer&apos; then sum([best_seller_gmv_amount_lc])/sum([best_seller_user_count])&#10;end' />
      </column>
      <column caption='Pro Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Best Seller Order Frequency (copy)_6255148043369988117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_benefit_order_count])/sum([pro_benefit_user_count])' />
      </column>
      <column caption='Pro Utilization' datatype='real' default-format='p0.0%' name='[Best Seller Utilization (copy)_6255148043371737113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_benefit_order_count])/SUM([pro_active_order_count])' />
      </column>
      <column caption='Exclusive Deals Utilization' datatype='real' default-format='p0.0%' name='[Best Seller Utilization (copy)_6255148043371880474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_exclusive_deal_order_count])/sum([pro_active_order_count])' />
      </column>
      <column caption='Booster Share of Best Seller with Pro Benefit Metric 2' datatype='real' name='[Best Seller with Pro Benefit Metric 2 (copy)_62487501506785282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;WHEN &apos;Avg. Savings per Customer&apos; THEN SUM([pro_benefit_best_seller_booster_savings_amount_lc])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;Avg. Savings per Order&apos; THEN SUM([pro_benefit_best_seller_booster_savings_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;END' />
      </column>
      <column caption='Best Seller Free Delivery %' datatype='real' default-format='p0.00%' name='[Booster Free Delivery % (copy)_6255148043365343248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([best_seller_with_pro_benefit_order_count])/sum([best_seller_order_count])' />
      </column>
      <column caption='Booster Metric 2' datatype='real' name='[Booster Metric (copy)_121104662777462789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;when &apos;Adoption %&apos; then (sum([pro_booster_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;when &apos;Utilization %&apos; then (sum([pro_booster_order_count])/sum([pro_active_order_count]))*-1&#10;when &apos;Orders&apos; then sum([pro_booster_order_count])&#10;when &apos;Customers&apos; then sum([pro_booster_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_booster_order_count])/sum([pro_booster_user_count])&#10;when &apos;GMV&apos; then sum([pro_booster_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([pro_booster_gmv_amount_lc])/sum([pro_booster_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_booster_basket_amount_lc])/sum([pro_booster_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_booster_savings_amount_lc])&#10;when &apos;Avg. Savings per Order&apos; then sum([pro_booster_savings_amount_lc])/sum([pro_booster_order_count])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_booster_savings_amount_lc])/sum([pro_booster_user_count])&#10;when &apos;Spend per Customer&apos; then sum([pro_booster_gmv_amount_lc])/sum([pro_booster_user_count])&#10;end' />
      </column>
      <column caption='tPro Benefit Metric' datatype='real' name='[Booster Metric (copy)_5796132724920242230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 20]&#10;when &apos;Orders&apos; then sum([pro_benefit_order_count])&#10;when &apos;Customers&apos; then sum([pro_benefit_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_benefit_order_count])/sum([pro_benefit_user_count])&#10;when &apos;GMV&apos; then sum([pro_benefit_gmv_amount_lc])&#10;when &apos;AOV&apos; then  sum([pro_benefit_gmv_amount_lc])/sum([pro_benefit_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_benefit_basket_amount_lc])/sum([pro_benefit_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_benefit_savings_amount_lc])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_benefit_savings_amount_lc])/sum([pro_benefit_user_count])&#10;When &apos;Avg. Savings per Order&apos; then sum([pro_benefit_savings_amount_lc])/sum([pro_benefit_order_count])&#10;end' />
      </column>
      <column caption='Exclusive Deal Metric' datatype='real' name='[Booster Metric 2 (copy)_5796132724920524856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 20]&#10;when &apos;Orders&apos; then sum([pro_exclusive_deal_order_count])&#10;when &apos;Customers&apos; then sum([pro_exclusive_deal_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_exclusive_deal_order_count])/sum([pro_exclusive_deal_user_count])&#10;when &apos;GMV&apos; then sum([pro_exclusive_deal_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([pro_exclusive_deal_gmv_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_exclusive_deal_savings_amount_lc])&#10;when &apos;Avg. Savings per Order&apos; then sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_order_count])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_exclusive_deal_savings_amount_lc])/sum([pro_exclusive_deal_user_count])&#10;end' />
      </column>
      <column caption='Free Delivery Share of Best Seller with Pro Benefit Metric 2' datatype='real' name='[Booster Share of Best Seller with Pro Benefit Metric 2 (copy)_62487501507350531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;WHEN &apos;Avg. Savings per Customer&apos; THEN SUM([pro_benefit_best_seller_free_delivery_savings_amount_lc])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;Avg. Savings per Order&apos; THEN SUM([pro_benefit_best_seller_free_delivery_savings_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;END' />
      </column>
      <column caption='Best Seller Share of Best Seller with Pro Benefit Metric 2' datatype='real' name='[Booster Share of Best Seller with Pro Benefit Metric 2 (copy)_62487501507727364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;WHEN &apos;Avg. Savings per Customer&apos; THEN SUM([pro_benefit_best_seller_savings_amount_lc] - [pro_benefit_best_seller_free_delivery_savings_amount_lc] - [pro_benefit_best_seller_booster_savings_amount_lc])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;Avg. Savings per Order&apos; THEN SUM([pro_benefit_best_seller_savings_amount_lc] - [pro_benefit_best_seller_free_delivery_savings_amount_lc] - [pro_benefit_best_seller_booster_savings_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;END' />
      </column>
      <column caption='Best Seller Utilization' datatype='real' default-format='p0.0%' name='[Booster Utilization (copy)_6255148043366801426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([best_seller_order_count])/sum([pro_active_order_count])' />
      </column>
      <column caption='tpro program filter ' datatype='boolean' name='[Booster program filter (copy)_5397212361605349384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 18] = &apos;tPro&apos;' />
      </column>
      <column caption='program filter' datatype='boolean' name='[Booster program filter (copy)_5397212361605795849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 18] != &apos;Booster&apos; and [Parameters].[Parameter 18] != &apos;tPro&apos;' />
      </column>
      <column caption='Exclusive Deal x Free Delivery' datatype='real' name='[Booster x Free Delivery (copy)_62487501510791174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_free_delivery_exclusive_deal_order_count])/sum([pro_exclusive_deal_order_count])' />
      </column>
      <column caption='Pro Users' datatype='integer' name='[Calculation_1276489086199877633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [date]: SUM(IF [plan_type] = &apos;ALL&apos; AND [plan_duration] = &apos;ALL&apos; AND [plan_name (Custom SQL Query)] = &apos;ALL&apos; AND [subscription_state] = &apos;ALL&apos; AND [vertical] = &apos;ALL&apos; THEN [pro_users] END)}' />
      </column>
      <column caption='Metric 2 %' datatype='real' default-format='p0%' name='[Calculation_1530098027816767488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5796132724678164528] / [Metric 1 Usage Booster (copy)_5796132724679401521]' />
      </column>
      <column caption='max date' datatype='date' name='[Calculation_1530098027825954817]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([date])}' />
      </column>
      <column caption='max month' datatype='date' name='[Calculation_1530098027826126850]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max(if [aggregation_level] = &apos;Monthly&apos; then [date] end)}' />
      </column>
      <column caption='show week filter' datatype='boolean' name='[Calculation_244812912965505025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;Weekly&apos;' />
      </column>
      <column caption='booster Vendor Funded %' datatype='real' default-format='p0.0%' name='[Calculation_244812912989638659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([booster_vendor_funded_amount_lc])/sum([pro_booster_savings_amount_lc])' />
      </column>
      <column caption='view is country' datatype='boolean' name='[Calculation_5397212361333338112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 22] = 1' />
      </column>
      <column caption='Month' datatype='date' name='[Calculation_5796132723892699138]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_5796132723893927940]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Daily&apos; THEN&#10;    IF [date] = [Parameters].[Date lifecycle (copy)_5796132723892355073] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [Parameters].[Date lifecycle (copy)_5796132723892355073]) &#10;    THEN &quot;Comparison Period&quot;&#10;    &#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Month Usage (copy)_6920766041811431425]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Month Usage (copy)_6920766041811431425])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Month Penetration (copy)_5796132723892088832]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Month Penetration (copy)_5796132723892088832])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
      </column>
      <column caption='Date frequency' datatype='boolean' name='[Calculation_5796132723926487045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[aggregation_level] = [Parameters].[Parameter 4]' />
      </column>
      <column caption='14 day filter' datatype='boolean' name='[Calculation_5796132723926720518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Daily&apos; THEN&#10;    [date] &lt;= [Parameters].[Date lifecycle (copy)_5796132723892355073] and&#10;   [date] &gt; DATEADD(&apos;day&apos;, -14, [Parameters].[Date lifecycle (copy)_5796132723892355073])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN&#10;    [date] &lt;= [Parameters].[Month Penetration (copy)_5796132723892088832] and&#10;   [date] &gt; DATEADD(&apos;month&apos;, -14, [Parameters].[Month Penetration (copy)_5796132723892088832])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN&#10;    [date] &lt;= [Parameters].[Month Usage (copy)_6920766041811431425] and&#10;   [date] &gt; DATEADD(&apos;week&apos;, -14, [Parameters].[Month Usage (copy)_6920766041811431425])&#10;end' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_5796132724636315678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;tPro&apos; then [pro_benefit_order_count]&#10;when &apos;Booster&apos; THEN [pro_booster_order_count]&#10;when &apos;Exclusive Deal&apos; then [pro_exclusive_deal_order_count]&#10;when &apos;Free Delivery&apos; then [pro_free_delivery_order_count]&#10;end' />
      </column>
      <column caption='Users' datatype='integer' name='[Calculation_5796132724636917791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;tPro&apos; then [pro_benefit_user_count]&#10;when &apos;Booster&apos; THEN [pro_booster_user_count]&#10;when &apos;Exclusive Deal&apos; then [pro_exclusive_deal_user_count]&#10;when &apos;Free Delivery&apos; then [pro_free_delivery_user_count]&#10;end' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_5796132724637245472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;tPro&apos; then [pro_benefit_gmv_amount_lc]&#10;when &apos;Booster&apos; THEN [pro_booster_gmv_amount_lc]&#10;when &apos;Exclusive Deal&apos; then [pro_exclusive_deal_gmv_amount_lc]&#10;when &apos;Free Delivery&apos; then [pro_free_delivery_gmv_amount_lc]&#10;end' />
      </column>
      <column caption='Select Metric (Usage)' datatype='real' name='[Calculation_5796132724650459169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case   [Parameters].[Parameter 19]&#10;when &apos;Orders&apos; then sum([Calculation_5796132724636315678])&#10;when &apos;Users&apos; then sum([Calculation_5796132724636917791])&#10;when &apos;GMV&apos; then sum([Calculation_5796132724637245472])&#10;when &apos;Avg. Savings per Order&apos; then [Orders (copy)_6255148043254722567]&#10;end' />
      </column>
      <column caption='Avg. Booster Savings per Order' datatype='real' name='[Calculation_5796132724653002786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_booster_savings_amount_lc])/sum([pro_booster_order_count])' />
      </column>
      <column caption='Adoption %' datatype='real' default-format='p0.00%' name='[Calculation_5796132724662947879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;tPro&apos; then sum([pro_benefit_user_count])/sum([Calculation_1276489086199877633])&#10;when &apos;Booster&apos; then sum([pro_booster_user_count]) / sum([Calculation_1276489086199877633])&#10;when &apos;Exclusive Deal&apos; then sum([pro_exclusive_deal_user_count]) / sum([Calculation_1276489086199877633])&#10;when &apos;Free Delivery&apos; then sum([pro_free_delivery_user_count]) / sum([Calculation_1276489086199877633])&#10;end' />
      </column>
      <column caption='Adoption remaining' datatype='real' default-format='p0%' name='[Calculation_5796132724664979497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_5796132724662947879]' />
      </column>
      <column caption='Booster Share of Best Seller Orders' datatype='real' default-format='p0.00%' name='[Calculation_5796132724676001838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_booster_order_count]) / sum([best_seller_order_count])' />
      </column>
      <column caption='Metric 2' datatype='real' name='[Calculation_5796132724678164528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 18]&#10;when &apos;Booster&apos;  then [Metric 2 (copy)_5796132724920475703] &#10;when &apos;Exclusive Deal&apos; then [Booster Metric 2 (copy)_5796132724920524856]&#10;when &apos;Free Delivery&apos; then [tPro Benefit Metric (copy)_5397212361594404871]&#10;when &apos;tPro&apos; then [Booster Metric (copy)_5796132724920242230]&#10;end' />
      </column>
      <column caption='Booster / Best Seller' datatype='real' default-format='p0.0%' name='[Calculation_5796132724682649650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5796132724678164528]/([Metric 1 Usage Booster (copy)_5796132724679401521])' />
      </column>
      <column caption='Best Seller Metric' datatype='real' name='[Calculation_5796132724920139829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 20]&#10;when &apos;Orders&apos; then sum([best_seller_order_count])&#10;when &apos;Customers&apos; then sum([best_seller_user_count])&#10;when &apos;Order Frequency&apos; then sum([best_seller_order_count])/sum([best_seller_user_count])&#10;when &apos;GMV&apos; then sum([pro_benefit_best_seller_gmv_amount_lc])&#10;when &apos;AOV&apos; then sum([pro_benefit_best_seller_gmv_amount_lc])/sum([best_seller_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([pro_benefit_best_seller_basket_amount_lc])/sum([best_seller_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_benefit_best_seller_savings_amount_lc])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_benefit_best_seller_savings_amount_lc])/sum([best_seller_user_count])&#10;When &apos;Avg. Savings per Order&apos; then sum([pro_benefit_best_seller_savings_amount_lc])/sum([best_seller_order_count])&#10;end' />
      </column>
      <column caption='Metric 1 Label' datatype='string' name='[Calculation_5796132724922343481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 18] = &apos;Exclusive Deal&apos; then &apos;tPro&apos; else &apos;Best Seller&apos; end' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_5796132724924727354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5796132724637245472])/sum([Calculation_5796132724636315678])' />
      </column>
      <column caption='Booster Free Delivery %' datatype='real' default-format='p0.00%' name='[Calculation_5796132724925771838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_free_delivery_booster_order_count])/sum([pro_booster_order_count])' />
      </column>
      <column caption='Best Seller with Pro Benefit Metric 2' datatype='real' name='[Calculation_62487501504430080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;WHEN &apos;Adoption %&apos; then (sum([best_seller_and_pro_benefit_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;WHEN &apos;Utilization %&apos; then (sum([best_seller_with_pro_benefit_order_count])/sum([pro_active_order_count]))*-1&#13;&#10;WHEN &apos;Order Frequency&apos; THEN SUM([best_seller_with_pro_benefit_order_count])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;AOV&apos; THEN SUM([pro_benefit_best_seller_gmv_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;WHEN &apos;ABV&apos; THEN SUM([pro_benefit_best_seller_basket_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;WHEN &apos;Spend per Customer&apos; THEN SUM([pro_benefit_best_seller_gmv_amount_lc])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;Avg. Savings per Customer&apos; THEN SUM([pro_benefit_best_seller_savings_amount_lc])/SUM([best_seller_and_pro_benefit_user_count])&#13;&#10;WHEN &apos;Avg. Savings per Order&apos; THEN SUM([pro_benefit_best_seller_savings_amount_lc])/SUM([best_seller_with_pro_benefit_order_count])&#13;&#10;END' />
      </column>
      <column caption='Empty' datatype='integer' name='[Calculation_62487501505683457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='Booster x Free Delivery' datatype='real' name='[Calculation_62487501510651909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_free_delivery_booster_order_count])/sum([pro_booster_order_count])' />
      </column>
      <column caption='Total Discounts' datatype='real' name='[Calculation_6255148043237724160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_booster_savings_amount_lc]) + sum([pro_exclusive_deal_savings_amount_lc]) + sum([pro_free_delivery_savings_amount_lc])' />
      </column>
      <column caption='Total Savu' datatype='real' name='[Calculation_6255148043238658049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Avg. Total Savings per Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6255148043239559170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6255148043237724160]/sum([pro_benefit_user_count])' />
      </column>
      <column caption='Booster program filter' datatype='boolean' name='[Calculation_6255148043266932744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 18] = &apos;Booster&apos;' />
      </column>
      <column caption='Usage Trend Label' datatype='string' name='[Calculation_6255148043268935689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 18] = &apos;Booster&apos; and [Parameters].[Parameter 21] = &apos;Best Seller&apos; then &apos;Best Seller&apos; else &apos;tPro&apos; end' />
      </column>
      <column caption='Booster Utilization' datatype='real' default-format='p0.0%' name='[Calculation_6255148043359186955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_booster_order_count])/sum([pro_active_order_count])' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6255148043362177038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5796132724636315678])/sum([Calculation_5796132724636917791])' />
      </column>
      <column caption='Pro Benefit Acquisitions' datatype='integer' name='[Calculation_6920766041816993795]' role='measure' type='quantitative'>
