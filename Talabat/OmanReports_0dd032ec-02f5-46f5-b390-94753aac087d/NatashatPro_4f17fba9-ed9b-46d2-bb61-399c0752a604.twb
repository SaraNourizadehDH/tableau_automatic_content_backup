      <column caption='Overall Pro Benefit Metric 2' datatype='real' default-format='*#,##0;0.0%' name='[Overall Pro Benefit Metric (copy)_121104662777327618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Select Metric (Usage Trend) (copy)_121104662776025088]&#13;&#10;when &apos;Adoption %&apos; then (sum([pro_active_user_count])/sum([Calculation_1276489086199877633]))*-1&#13;&#10;when &apos;Utilization %&apos; then NULL&#10;when &apos;Orders&apos; then sum([pro_active_order_count])&#10;when &apos;Customers&apos; then sum([pro_active_user_count])&#10;when &apos;Order Frequency&apos; then sum([pro_active_order_count])/sum([pro_active_user_count])&#10;when &apos;GMV&apos; then sum([gmv_amount_lc])&#10;when &apos;AOV&apos; then  sum([gmv_amount_lc])/sum([pro_active_order_count])&#10;WHEN &apos;ABV&apos; THEN sum([basket_amount_lc])/sum([pro_active_order_count])&#10;WHEN &apos;Discount&apos; then sum([pro_benefit_savings_amount_lc])&#10;when &apos;Avg. Savings per Customer&apos; then sum([pro_benefit_savings_amount_lc])/sum([pro_active_user_count])&#10;When &apos;Avg. Savings per Order&apos; then sum([pro_benefit_savings_amount_lc])/sum([pro_active_order_count])&#10;when &apos;Spend per Customer&apos; then sum([gmv_amount_lc])/sum([pro_active_user_count])&#10;end' />
      </column>
      <column caption='Select Metric (Usage - all tpro)' datatype='real' name='[Select Metric (Usage) (copy)_6255148043247480838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case   [Parameters].[Parameter 19]&#10;when &apos;Orders&apos; then sum(if [Parameters].[Parameter 18] = &apos;tPro&apos; then [pro_active_order_count] else [pro_benefit_order_count] end)&#10;when &apos;Users&apos; then sum( if [Parameters].[Parameter 18] = &apos;tPro&apos; then [pro_active_user_count] else [pro_benefit_user_count] end)&#10;when &apos;GMV&apos; then sum( if [Parameters].[Parameter 18] = &apos;tPro&apos; then  [gmv_amount_lc] else [pro_benefit_gmv_amount_lc] end)&#10;when &apos;Avg. Savings per Order&apos; then [Average Total Savings per Customer (copy)_6255148043241533443]&#10;end' />
