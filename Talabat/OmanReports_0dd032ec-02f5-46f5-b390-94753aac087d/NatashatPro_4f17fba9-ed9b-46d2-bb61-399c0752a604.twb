      <column caption='Adoption GMV GAP' datatype='real' name='[Adoption GAP (copy)_495958958543286286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_665969841676664836]-SUM([pro customer gmv adoption target])' />
      </column>
      <column caption='Adoption GMV color 2' datatype='string' name='[Adoption GMV color (copy)_495958958545141777]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([pro customer gmv adoption target]) &lt;&gt; 0 THEN &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
      </column>
      <column caption='Adoption GMV color' datatype='string' name='[Adoption color (copy)_495958958543302671]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Adoption GAP (copy)_495958958543286286] &gt; 0 then &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
      </column>
      <column caption='Adoption color 2' datatype='string' name='[Adoption color (copy)_495958958544867344]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([pro customer adoption target]) &lt;&gt; 0 THEN &quot;BLACK&quot; ELSE &quot;GREY&quot; END' />
      </column>
      <column caption='Churned movement' datatype='real' name='[Adoption movement (copy)_4035929001735303175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([Calculation_665969841676103682])) - LOOKUP(ZN(([Calculation_665969841676103682])), 1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LTP Adoption% ' datatype='real' name='[Adoption% (copy)_644577743855095808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers_count])/SUM([total_active_subscribers_count])' />
      </column>
      <column caption='Voluntary Churn%' datatype='real' name='[Calculation_1208372085304090629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([regular_voluntary_churn_count])/SUM([regular_upforrenewal_count])' />
      </column>
      <column caption='% orders from non-pro vendors' datatype='real' name='[Calculation_1208372085321326599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([non_signed_rests_food_count])+SUM([non_signed_rests_nfv_count]))/SUM(&#13;&#10;[regular_utilisation_all_order_count])' />
      </column>
      <column caption='% orders below MOV (food)' datatype='real' name='[Calculation_1208372085561102344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([non_tpro_less_than_mov_food])/ SUM([regular_utilisation_all_order_count])' />
      </column>
      <column caption='% Adoption from Addressable Base' datatype='real' name='[Calculation_1208372085601329163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([addressable_tpro_subscriber_count])/SUM([addressable_talabat_user_count])' />
      </column>
      <column caption='Last Refresh Date' datatype='date' name='[Calculation_1406811989807693824]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case   ([regular_gmvprocustomers])  WHEN  NULL then TODAY()-1 else TODAY() END' />
      </column>
      <column caption='Refresh Details' datatype='string' name='[Calculation_1406811989809487873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;The dashboard refreshes everyday at 6:30 AM UTC for current month and previous month values.In case of a delayed refreshed, KPIS for both months can be affected.&quot;' />
      </column>
      <column caption='Customers Savings Multiple - Overall' datatype='real' name='[Calculation_1569785976578138112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ltp_rewards_savings]+[ltp_tgo_df]+[ltp_tmart_df]+[ltp_tmp_df]&#13;&#10;+[stp_rewards_savings]+[stp_tgo_df]+[stp_tmart_df]+[stp_tmp_df])/&#13;&#10;sum([ltp_tpro_subfee]+[stp_tpro_subfee])' />
      </column>
      <column caption='mr' datatype='real' name='[Calculation_1789899428594393088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tpro_subfee])-SUM([refund_lc])' />
      </column>
      <column caption='Pro Savings' datatype='real' name='[Calculation_1789899428596973570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tmart_savings])+SUM([tgo_df])+SUM([tmp_df])' />
      </column>
      <column caption='ROI - tPro' datatype='real' name='[Calculation_1834653948897681408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([tmart_savings])*1)+SUM([tgo_df])+SUM([tmp_df])))/&#13;&#10;SUM([tpro_subfee])' />
      </column>
      <column caption='Adoption movement' datatype='real' name='[Calculation_4035929001735196678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([Calculation_665969841674248192])) - LOOKUP(ZN(([Calculation_665969841674248192])), 1)'>
