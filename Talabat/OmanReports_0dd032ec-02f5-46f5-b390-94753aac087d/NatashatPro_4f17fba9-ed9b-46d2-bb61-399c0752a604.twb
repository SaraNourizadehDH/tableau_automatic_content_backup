          <datasource-dependencies datasource='federated.1dspsjq15ygdnl1bej6tf0m2ef6n (copy)'>
            <column caption='% orders below MOV (nfv)' datatype='real' name='[% orders below MOV (food) (copy)_1208372085561593865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_nfv])/ SUM([regular_utilisation_all_order_count])' />
            </column>
            <column caption='% orders below MOV (tmart)' datatype='real' name='[% orders below MOV (food) (copy)_1208372085561892874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_tmart])/ SUM([regular_utilisation_all_order_count])' />
            </column>
            <column caption='LTP Adoption% ' datatype='real' name='[Adoption% (copy)_644577743855095808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_ltp_active_subscribers_count])/SUM([total_active_subscribers_count])' />
            </column>
            <column caption='Voluntary Churn%' datatype='real' name='[Calculation_1208372085304090629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_voluntary_churn_count])/SUM([regular_upforrenewal_count])' />
            </column>
            <column caption='% orders from non-pro vendors' datatype='real' name='[Calculation_1208372085321326599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([non_signed_rests_food_count])+SUM([non_signed_rests_nfv_count]))/SUM(&#13;&#10;[regular_utilisation_all_order_count])' />
            </column>
            <column caption='% orders below MOV (food)' datatype='real' name='[Calculation_1208372085561102344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_tpro_less_than_mov_food])/ SUM([regular_utilisation_all_order_count])' />
            </column>
            <column caption='% Adoption from Addressable Base' datatype='real' name='[Calculation_1208372085601329163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([addressable_tpro_subscriber_count])/SUM([addressable_talabat_user_count])' />
            </column>
            <column caption='Customers Savings Multiple - Overall' datatype='real' name='[Calculation_1569785976578138112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ltp_rewards_savings]+[ltp_tgo_df]+[ltp_tmart_df]+[ltp_tmp_df]&#13;&#10;+[stp_rewards_savings]+[stp_tgo_df]+[stp_tmart_df]+[stp_tmp_df])/&#13;&#10;sum([ltp_tpro_subfee]+[stp_tpro_subfee])' />
            </column>
            <column caption='Empty' datatype='integer' name='[Calculation_495958958532915204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Utilization%' datatype='real' name='[Calculation_644577743855374337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([regular_utilisation_tpro_order_count])/SUM([regular_utilisation_all_order_count])' />
            </column>
            <column caption='Vendor Count Coverage (Overall)' datatype='real' name='[Calculation_644577744151666690]' role='measure' type='quantitative'>
