      <column caption='ABV' datatype='real' name='[AOV (copy)_5796132724924903483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GMV (copy)_6255148043360813068])/sum([Calculation_5796132724636315678])' />
      </column>
      <column caption='Best Seller AOV' datatype='real' name='[AOV (copy)_5796132724925132860]' role='measure' type='quantitative'>
