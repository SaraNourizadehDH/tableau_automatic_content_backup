      <column caption='Acquisition and Winback Rate' datatype='real' default-format='p0.0%' name='[Acquisition Rate (copy)_173388599034187787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1805380515192209412] + [tpro_winbacks_count])/sum([Calculation_3247306499866030084])' />
      </column>
      <column caption='Never Subscribed to Pro' datatype='integer' name='[Active Users (copy)_173388598998413316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [date], [vertical], [order_segment]: SUM(CASE [plan_duration] WHEN &apos;1M&apos; then IF NOT CONTAINS([plan_name],&quot;family&quot;) THEN ZN([talabat_never_subscribed_user_count]) END END)}' />
      </column>
      <column caption='Platform Orders' datatype='integer' name='[Active Users (copy)_173388599385296932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [date], [vertical], [order_segment]: SUM(CASE [plan_duration] WHEN &apos;1M&apos; THEN IF NOT CONTAINS([plan_name],&quot;family&quot;) THEN  ZN([talabat_order_count]) END END)}' />
      </column>
      <column caption='Active Pro Users' datatype='integer' name='[Active Users (copy)_3247306499868479497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, TODAY()) WHEN [date] THEN [tpro_l30_active_user_count] ELSE [tpro_active_user_count] END' />
      </column>
      <column caption='Pro Users' datatype='integer' name='[Active tPro Users (copy)_173388599003320325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, TODAY()) WHEN [date] then [tpro_l30_subscriber_count] ELSE [tpro_subscriber_count] END' />
