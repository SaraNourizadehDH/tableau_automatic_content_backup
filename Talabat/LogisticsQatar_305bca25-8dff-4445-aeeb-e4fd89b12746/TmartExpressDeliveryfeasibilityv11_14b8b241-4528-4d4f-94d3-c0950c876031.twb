      <aliases enabled='yes' />
      <column caption='Avg daily orders-overall' datatype='real' name='[Avg daily orders (copy)_1234267839827709972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :COUNTD([order_code])}/{COUNTD([order_date])}' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_code]) / TOTAL(COUNTD([order_code]))'>
          <table-calc ordering-field='[federated.1bjqdgp0uzs4q312j0os91ut2ttt].[DT 15 split (copy)_1234267839731224582]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_code]) / TOTAL(COUNTD([order_code]))'>
          <table-calc ordering-field='[federated.1bjqdgp0uzs4q312j0os91ut2ttt].[DT 15 split (copy)_1234267839731224582]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='integer' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])), -1)'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='week_start_date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_1234267839723089920]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, 1, DATETRUNC(&apos;week&apos;, [order_date])))' />
      </column>
      <column aggregation='Sum' caption='re_order 14 days' datatype='integer' name='[Calculation_1234267839725481985]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [order_date], [next_order_at]) &lt;= 14 THEN 1 ELSE 0 END' />
      </column>
      <column caption='re_order 14days%' datatype='real' name='[Calculation_1234267839726039043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1234267839725481985]) / COUNT([order_code])' />
      </column>
      <column caption='DriveTime  split' datatype='string' name='[Calculation_1234267839726870532]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if([Calculation_811492425091276801])&lt;9 then &apos;within 9 mins&apos; ELSEIF ([Calculation_811492425091276801])&gt;=12 then &apos;&gt;12 mins&apos; else &apos;in between&apos; end' />
      </column>
      <column caption='Order_Value' datatype='real' name='[Calculation_1234267839736774663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[hurrier_order_value]/100' />
      </column>
      <column caption='Avg daily orders' datatype='real' name='[Calculation_1234267839826632715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_area (group)]:COUNTD([order_code])}/{COUNTD([order_date])}' />
      </column>
      <column caption='% of overall' datatype='real' name='[Calculation_1234267839827845141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1234267839826632715]/[Avg daily orders (copy)_1234267839827709972]' />
      </column>
      <column caption='dt' datatype='real' name='[Calculation_1234267839828385814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual_delivery_time]/60' />
      </column>
      <column caption='Avg DT' datatype='real' name='[Calculation_1234267839828611095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_area (group)]: AVG([Calculation_1234267839828385814])}' />
      </column>
