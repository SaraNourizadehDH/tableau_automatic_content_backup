      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_05D3874B3B0D492D9A5F213633AA64C2'>
            <properties context=''>
              <relation connection='bigquery.0a6tznj1jz9x7l1ft0bnn03olroi' name='Custom SQL Query' type='text'>WITH parameters AS (&#13;
  SELECT&#13;
    DATE(&apos;2024-05-01&apos;) AS start_date1,&#13;
    DATE(&apos;2024-09-25&apos;) AS end_date1&#13;
)&#13;
&#13;
SELECT DISTINCT&#13;
  o.country_code,&#13;
  DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone) AS order_date,&#13;
  o.order_code,&#13;
  o.vendor_code,&#13;
  net_order.analytical_customer_id,&#13;
  o.order_id,&#13;
o.hurrier_order_value,&#13;
o.promised_delivery_time,&#13;
o.actual_delivery_time,&#13;
o.estimated_driving_time,&#13;
net_order.location_id,&#13;
net_order.customer_area,&#13;
  -- Get the next order date&#13;
  LEAD(DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone)) OVER (PARTITION BY net_order.analytical_customer_id, o.vendor_code ORDER BY DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone)) AS next_order_at,&#13;
&#13;
  -- Calculate orders in the next 30 days for the same analytical_customer_id and vendor_code combination&#13;
  COUNT(*) OVER (&#13;
    PARTITION BY net_order.analytical_customer_id, o.vendor_code &#13;
    ORDER BY UNIX_DATE(DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone))&#13;
    RANGE BETWEEN 1 FOLLOWING AND 30 FOLLOWING&#13;
  ) AS orders_next_30_days,&#13;
  COUNT(*) OVER (&#13;
    PARTITION BY net_order.analytical_customer_id, o.vendor_code &#13;
    ORDER BY UNIX_DATE(DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone))&#13;
    RANGE BETWEEN 1 FOLLOWING AND 15 FOLLOWING&#13;
  ) AS orders_next_15_days&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_logistics_order` o&#13;
CROSS JOIN parameters&#13;
&#13;
LEFT JOIN (&#13;
  SELECT DISTINCT&#13;
    LOWER(country_iso) AS country_code,&#13;
    order_id,&#13;
    is_net,&#13;
    ord.location_id,&#13;
  loc.area_name as customer_area,&#13;
    analytical_customer_id,&#13;
    is_failed,&#13;
    gmv_amount_eur&#13;
  FROM `tlb-data-prod.data_platform.fct_order` ord&#13;
left join `tlb-data-prod.data_platform.dim_location` loc on loc.location_id = ord.location_id&#13;
  CROSS JOIN parameters&#13;
&#13;
  WHERE (order_date BETWEEN start_date1 AND DATE_ADD(end_date1, INTERVAL 14 DAY))&#13;
    AND CAST(vendor_id AS STRING) IN  (&apos;647093&apos;,&apos;619614&apos;,&apos;600710&apos;,&apos;613147&apos;,&apos;604315&apos;,&apos;604314&apos;,&apos;610747&apos;)&#13;
) net_order USING(country_code, order_id)&#13;
&#13;
WHERE (DATE(COALESCE(o.primary_rider_dropped_off_at, o.hurrier_order_placed_at), o.timezone) BETWEEN start_date1 AND DATE_ADD(end_date1, INTERVAL 14 DAY))&#13;
  AND o.brand_name = &apos;Talabat&apos;&#13;
  AND o.order_status = &apos;completed&apos;&#13;
  AND o.is_talabat&#13;
  AND o.is_rider_order&#13;
  AND NOT o.is_logistics_preorder&#13;
  AND o.vendor_code IN   (&apos;647093&apos;,&apos;619614&apos;,&apos;600710&apos;,&apos;613147&apos;,&apos;604315&apos;,&apos;604314&apos;,&apos;610747&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
