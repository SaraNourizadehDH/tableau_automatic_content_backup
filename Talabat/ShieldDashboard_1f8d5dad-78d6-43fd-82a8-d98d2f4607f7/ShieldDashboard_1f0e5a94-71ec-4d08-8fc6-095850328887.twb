    <worksheet name='Fraud Rate ScoreCard/Marketing'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>Fraud Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_campaign_daily (data_platform_fraud)' name='federated.13aopdr1dryy3r11z0x6j1d9rxaa' />
          </datasources>
          <datasource-dependencies datasource='federated.13aopdr1dryy3r11z0x6j1d9rxaa'>
            <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_895653388294168576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actionable_request_count])/SUM([evaluated_request_count])' />
            </column>
            <column caption='Actionable Request Count' datatype='integer' name='[actionable_request_count]' role='measure' type='quantitative' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Evaluated Request Count' datatype='integer' name='[evaluated_request_count]' role='measure' type='quantitative' />
            <column caption='Is Acquisition Campaign' datatype='boolean' name='[is_acquisition_campaign]' role='dimension' type='nominal' />
