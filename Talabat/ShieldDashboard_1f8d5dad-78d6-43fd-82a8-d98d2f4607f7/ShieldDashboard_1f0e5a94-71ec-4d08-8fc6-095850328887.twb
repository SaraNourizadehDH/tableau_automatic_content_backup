        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([matched_request_count]) / TOTAL(SUM([matched_request_count]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Saving' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1004584205563518977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Saved Amount Eur Parameter] = &quot;Eur&quot;&#13;&#10;Then&#13;&#10;[saved_amount_eur]&#13;&#10;ELSE&#13;&#10;[saved_amount_lc]&#13;&#10;END' />
      </column>
      <column caption='Workflow swap' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_212513630311096320]' role='dimension' type='nominal'>
