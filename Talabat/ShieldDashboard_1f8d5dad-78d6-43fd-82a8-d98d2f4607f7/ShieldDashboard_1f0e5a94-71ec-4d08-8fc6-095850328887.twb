            <column caption='Matched Shadow Request Count' datatype='integer' name='[matched_shadow_request_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2681541775164563463]' derivation='None' name='[none:Calculation_2681541775164563463:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4233524432048943107]' derivation='None' name='[none:Calculation_4233524432048943107:nk]' pivot='key' type='nominal' />
