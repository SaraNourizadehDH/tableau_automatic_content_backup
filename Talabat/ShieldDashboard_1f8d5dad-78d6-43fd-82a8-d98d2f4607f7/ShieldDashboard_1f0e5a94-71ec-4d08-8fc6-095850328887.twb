      <column caption='# Fraud Redeem Attempts' datatype='integer' name='[# Fraud Orders (copy)_803611071583633409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [workflow] = &apos;Voucher&apos; THEN [matched_request_count] ELSE 0 END)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.13aopdr1dryy3r11z0x6j1d9rxaa].[pcto:sum:saved_amount_eur:qk]&quot;' value='% Saving' />
          <alias key='&quot;[federated.13aopdr1dryy3r11z0x6j1d9rxaa].[sum:Calculation_1004584205563518977:qk]&quot;' value='$ Saving' />
