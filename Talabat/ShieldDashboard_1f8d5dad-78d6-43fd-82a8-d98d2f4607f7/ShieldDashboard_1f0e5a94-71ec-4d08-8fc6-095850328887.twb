            <column caption='Is Whitelist Rule' datatype='boolean' name='[is_whitelist_rule]' role='dimension' type='nominal' />
            <column caption='Matched Request Count' datatype='integer' name='[matched_request_count]' role='measure' type='quantitative' />
            <column caption='Matched Shadow Request Count' datatype='integer' name='[matched_shadow_request_count]' role='measure' type='quantitative' />
