      </column>
      <column caption='% Leakage' datatype='real' default-format='p0.000%' name='[Calculation_526639703479214080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(campaign_false_negative_transaction_count)/sum([campaign_transaction_count] - [actionable_request_count])' />
      </column>
