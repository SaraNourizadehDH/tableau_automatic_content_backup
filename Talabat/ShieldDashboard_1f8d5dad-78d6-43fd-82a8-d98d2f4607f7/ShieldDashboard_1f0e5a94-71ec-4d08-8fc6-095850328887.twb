    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Rules'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/ShieldDashboard4/Rules?rev=' id='Rules' path='/t/Talabat/workbooks/ShieldDashboard4' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='wrap' value='on' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#000000' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='color' value='#ff5a00' />
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='1477' maxwidth='1600' minheight='1477' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='agg_rule_daily (data_platform_fraud)' name='federated.07na8vh0ubzaer15hluop1ub58bg' />
