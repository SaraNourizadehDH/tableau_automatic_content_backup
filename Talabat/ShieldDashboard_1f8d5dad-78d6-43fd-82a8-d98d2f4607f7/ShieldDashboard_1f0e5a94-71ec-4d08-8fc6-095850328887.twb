      <datasource-dependencies datasource='Parameters'>
        <column caption='Start &amp; End Date' datatype='string' name='[Currency (copy)_2681541775160713220]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fraud Start &amp; End Date&quot;'>
          <calculation class='tableau' formula='&quot;Fraud Start &amp; End Date&quot;' />
          <members>
            <member value='&quot;Fraud Start &amp; End Date&quot;' />
            <member value='&quot;Fraud Shadow Start &amp; End Date&quot;' />
            <member value='&quot;Execution Start &amp; End Date&quot;' />
          </members>
        </column>
        <column caption='Choose to display 1' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fraud Trx&quot;'>
          <calculation class='tableau' formula='&quot;Fraud Trx&quot;' />
          <members>
            <member value='&quot;Fraud Trx&quot;' />
            <member value='&quot;Fraud Shadow&quot;' />
            <member value='&quot;Evaluated&quot;' />
            <member value='&quot;Fraud Rate&quot;' />
            <member value='&quot;Fraud/ Workflow&quot;' />
            <member value='&quot;\% of Actionable/ Fraud&quot;' />
            <member value='&quot;Actionable vs. Unique Actionable&quot;' />
            <member value='&quot;Evaluated vs. Fraud&quot;' />
            <member value='&quot;Fraud Throttled&quot;' />
            <member value='&quot;Stale&quot;' />
            <member value='&quot;TimeOut&quot;' />
            <member value='&quot;Whitelisted&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Saved Amount Eur Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
          <calculation class='tableau' formula='&quot;Eur&quot;' />
          <members>
            <member value='&quot;Eur&quot;' />
            <member value='&quot;Lc&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.07na8vh0ubzaer15hluop1ub58bg'>
        <column caption='Rule Status' datatype='string' name='[Calculation_2681541775164563463]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF {FIXED [rule_name] : max([Evaluated Start Date (copy)_2681541775160242178]) = max({FIXED : MAX(if [evaluated_request_count] &gt; 0 then [report_date] END)})}&#10;THEN &quot;Enabled&quot;&#10;ELSEIF {FIXED [rule_name] : max([Evaluated Start Date (copy)_2681541775160242178]) &lt; max({FIXED : MAX(if [evaluated_request_count] &gt; 0 then [report_date] END)})}&#10;THEN &quot;Disabled&quot;&#10;END' />
        </column>
        <column caption='Rule Mode' datatype='string' name='[Calculation_669628984314978304]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF {FIXED [rule_name] : SUM([matched_request_count])}  = 0 &#13;&#10;AND {FIXED [rule_name] : SUM([matched_shadow_request_count])}  = 0&#13;&#10;THEN &quot;Obsolete&quot;&#13;&#10;ELSEIF {FIXED [rule_name] : SUM([matched_request_count])}  = 0 &#13;&#10;AND {FIXED [rule_name] : SUM([matched_shadow_request_count])}  &gt; 0&#13;&#10;THEN &quot;Shadow&quot;&#13;&#10;ELSE &quot;Active&quot;&#13;&#10;END' />
        </column>
        <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Fraud Pattern' datatype='string' name='[fraud_pattern]' role='dimension' type='nominal' />
        <column caption='Is Whitelist Rule' datatype='boolean' name='[is_whitelist_rule]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_2681541775164563463]' derivation='None' name='[none:Calculation_2681541775164563463:nk]' pivot='key' type='nominal' />
