      <table>
        <view>
          <datasources>
            <datasource caption='agg_rule_daily (data_platform_fraud)' name='federated.07na8vh0ubzaer15hluop1ub58bg' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose to display 1' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fraud Trx&quot;'>
              <calculation class='tableau' formula='&quot;Fraud Trx&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07na8vh0ubzaer15hluop1ub58bg'>
            <column caption='Rule Status' datatype='string' name='[Calculation_2681541775164563463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [rule_name] : max([Evaluated Start Date (copy)_2681541775160242178]) = max({FIXED : MAX(if [evaluated_request_count] &gt; 0 then [report_date] END)})}&#10;THEN &quot;Enabled&quot;&#10;ELSEIF {FIXED [rule_name] : max([Evaluated Start Date (copy)_2681541775160242178]) &lt; max({FIXED : MAX(if [evaluated_request_count] &gt; 0 then [report_date] END)})}&#10;THEN &quot;Disabled&quot;&#10;END' />
            </column>
            <column caption='combined_actionable_request_count' datatype='integer' name='[Calculation_4233524432041304064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actionable_request_count]-[unique_actionable_request_count]' />
            </column>
            <column caption='Rule Action Mode' datatype='string' name='[Calculation_4233524432048943107]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [rule_name] : SUM([unique_actionable_request_count])}  &gt; 0 &#10;AND {FIXED [rule_name] : SUM([Calculation_4233524432041304064])}  = 0&#10;THEN &quot;Solo&quot;&#10;ELSEIF {FIXED [rule_name] : SUM([unique_actionable_request_count])}  = 0 &#10;AND {FIXED [rule_name] : SUM([Calculation_4233524432041304064])}  &gt; 0&#10;THEN &quot;Combined&quot;&#10;ELSEIF {FIXED [rule_name] : SUM([actionable_request_count])}  = 0&#10;THEN &quot;Not Actionable&quot;&#10;ELSE &quot;Mixed&quot;&#10;END' />
            </column>
            <column caption='par' datatype='string' name='[Calculation_560135218043998208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1 1]' />
            </column>
            <column caption='Rule Mode' datatype='string' name='[Calculation_669628984314978304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [rule_name] : SUM([matched_request_count])}  = 0 &#13;&#10;AND {FIXED [rule_name] : SUM([matched_shadow_request_count])}  = 0&#13;&#10;THEN &quot;Obsolete&quot;&#13;&#10;ELSEIF {FIXED [rule_name] : SUM([matched_request_count])}  = 0 &#13;&#10;AND {FIXED [rule_name] : SUM([matched_shadow_request_count])}  &gt; 0&#13;&#10;THEN &quot;Shadow&quot;&#13;&#10;ELSE &quot;Active&quot;&#13;&#10;END' />
            </column>
            <column caption='Actioned/Fraud' datatype='real' default-format='p0%' name='[Calculation_877076035081650176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actionable_request_count]) / SUM([matched_request_count])' />
            </column>
            <column caption='% of stale/fraud' datatype='real' default-format='p0.00%' name='[Calculation_877076035209625610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stale_matched_request_count])/SUM([stale_request_count])' />
            </column>
            <column caption='Evaluated End Date' datatype='date' name='[Evaluated Start Date (copy)_2681541775160242178]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [rule_name]: MAX(IF [evaluated_request_count] &gt; 0 THEN [report_date] END)}' />
            </column>
