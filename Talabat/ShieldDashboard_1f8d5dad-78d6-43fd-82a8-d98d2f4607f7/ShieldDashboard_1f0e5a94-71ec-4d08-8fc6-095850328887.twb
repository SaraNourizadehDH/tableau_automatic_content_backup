      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='leakage' id='_097311A77E0340CCA1042C3C24962095'>
            <properties context=''>
              <relation connection='bigquery.1r4al2b19o3csr1cyl8oq0r4bycu' name='Custom SQL Query' type='text'>with leakage as
         (SELECT *
          FROM `tlb-data-prod.data_platform_fraud.fct_order_acquisition_leakage`
          where labelling_date = current_date - 2
            and is_fraud_false_negative
            and not is_fraud)

Select fo.order_date,
       fo.voucher_wallet_campaign_id                                                           campaign_id,
       p.name                                                                                  campaign_name,
       fo.country                                                                              country,
       count(distinct fo.order_id)                                                             order_count,
       count(distinct case when fo.is_sent then fo.order_id end)                               successful_order_count,
       count(distinct case when ssc_source_reason like &apos;%Shield%&apos; then fo.order_id end)        fraud_order_count,
       count(distinct case when is_sent and l.is_fraud_false_negative then fo.order_id end)    leakage_order_count,
       count(distinct fo.customer_id)                                                          customer_count,
       count(distinct case when fo.is_sent then fo.customer_id end)                            successful_customer_count,
       count(distinct case when ssc_source_reason like &apos;%Shield%&apos; then fo.customer_id end)     fraud_customer_count,
       count(distinct case when is_sent and l.is_fraud_false_negative then fo.customer_id end) leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_app_version_leakage
                              then fo.customer_id end)                                         app_version_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_duplicate_gmail_account
                              then fo.customer_id end)                                         duplicate_gmail_account_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_customer_network
                              then fo.customer_id end)                                         suspicious_customer_network_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_ip_and_name
                              then fo.customer_id end)                                         suspicious_ip_and_name_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_fake_talabat_account
                              then fo.customer_id end)                                         fake_talabat_account_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_selected_geohash
                              then fo.customer_id end)                                         suspicious_selected_geohash_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_actual_geohash
                              then fo.customer_id end)                                         suspicious_actual_geohash_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_different_registratoin_device
                              then fo.customer_id end)                                         different_registratoin_device_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_fast_redemption
                              then fo.customer_id end)                                         fast_redemption_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_international_number
                              then fo.customer_id end)                                         international_number_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_landline
                              then fo.customer_id end)                                         suspicious_landline_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_mobile
                              then fo.customer_id end)                                         suspicious_mobile_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_suspicious_device
                              then fo.customer_id end)                                         suspicious_device_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_free_delivery_abuse
                              then fo.customer_id end)                                         free_delivery_abuse_leakage_customer_count,
       count(distinct case
                          when is_sent and l.is_customer_voucher_false_acquistion
                              then fo.customer_id end)                                         customer_voucher_false_acquistion_leakage_customer_count
from `tlb-data-prod.data_platform_fraud.fct_order` fo
         left join leakage l on fo.order_id = l.order_id
         inner join `tlb-data-prod`.data_platform_loyalty.voucher_options p on p.id = fo.voucher_wallet_campaign_id and
                                                                               targeted_segment_reference_id in
                                                                               (&apos;600667c6-77e0-4332-9446-f17fcf5b1d86&apos;,
                                                                                &apos;130162c6-0120-4d81-89a0-898705c06782&apos;,
                                                                                &apos;64657cfa-fdb7-4fdb-ac4f-32b45d4c62c9&apos;)
where voucher_wallet_campaign_id is not null
  and fo.order_date &gt;&gt;= &apos;2021-08-01&apos;
group by 1, 2, 3, 4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
