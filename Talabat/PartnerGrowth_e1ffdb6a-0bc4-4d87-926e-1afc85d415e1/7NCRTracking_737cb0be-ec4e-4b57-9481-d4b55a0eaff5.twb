          </filter>
          <manual-sort column='[federated.0ns4l6y1qugfak1ft1qul102vvfo].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.0ns4l6y1qugfak1ft1qul102vvfo].[sum:nba_topup_budget:qk]&quot;</bucket>
