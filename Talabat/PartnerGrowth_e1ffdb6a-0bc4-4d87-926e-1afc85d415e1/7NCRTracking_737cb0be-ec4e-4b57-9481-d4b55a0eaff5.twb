        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='7%' id='_C2BCD10DC19D4B8BB27DEEC6C6338F1A'>
            <properties context=''>
              <relation connection='bigquery.0iwdglf1az3z4n11624600hrpsfd' name='Custom SQL Query' type='text'>with multioutlet as (with entity AS (
SELECT
brand_name
, sub_entity
, global_entity_id
FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
WHERE is_entity_online = TRUE
and management_entity=&apos;Talabat&apos;
),

raw_data as
(Select date_trunc(fielddate, month) as date_month,
fielddate,
brand_name,
a.global_entity_id, event_timestamp_utc, user_id,
(SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;is_multiple_outlets_landing&apos;) is_multiple_outlets_landing,
(SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;is_multiple_outlets_mode&apos;) is_multiple_outlets_mode,
(SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;multiple_outlets_available&apos;) is_multiple_outlets_available,

SPLIT((select coalesce(params.value.string_value, cast(params.value.int_value as string), cast(params.value.float_value as string), cast(params.value.double_value as string)) FROM unnest(event_params) as params WHERE params.key = &apos;budget_value&apos;), &apos;,&apos;) as budget_value,

SPLIT((select coalesce(params.value.string_value, cast(params.value.int_value as string), cast(params.value.float_value as string), cast(params.value.double_value as string)) FROM unnest(event_params) as params WHERE params.key = &apos;currency_code&apos;), &apos;,&apos;) as currency_code,

SPLIT((select coalesce(params.value.string_value, cast(params.value.int_value as string), cast(params.value.float_value as string), cast(params.value.double_value as string)) FROM unnest(event_params) as params WHERE params.key = &apos;campaign_id&apos;), &apos;,&apos;) as campaign_id

FROM fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events a
JOIN entity e on a.global_entity_id=e.global_entity_id
WHERE date_trunc(fielddate, month) &gt;&gt;= &apos;2025-01-01&apos;
and COALESCE(is_impersonated, &apos;no&apos;)=&apos;no&apos;
and device_platform=&apos;WEB&apos;
and event_name = &apos;request_succeed&apos;
and label = &apos;booking_confirm&apos;
and (SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;page_name&apos;) =&apos;cpc_booking&apos;
and (SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;plugin_code&apos;) = &apos;MIDAS&apos;
and ((SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;is_multiple_outlets_mode&apos;) = &apos;true&apos;
OR
(SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;is_multiple_outlets_landing&apos;) = &apos;true&apos;
OR
(SELECT params.value.string_value FROM unnest(event_params) as params WHERE params.key = &apos;multiple_outlets_available&apos;) = &apos;true&apos;)
GROUP BY ALL),

vertical_parent as
(select a.global_entity_id, campaign_id, advertiser.type as vertical_parent, pricing.budget_eur, vendors.id as vendor_id,
case when pricing.budget_eur &gt;&gt;
((stddev(pricing.budget_eur) over (partition by a.global_entity_id)) * 6) then 1 else 0 end as is_outlier
FROM `fulfillment-dwh-production.curated_data_shared_adtech.dim_campaigns` a , unnest(advertiser.vendors) vendors
JOIN entity e on a.global_entity_id=e.global_entity_id
WHERE date(created_at_utc)&gt;&gt;=&apos;2025-01-01&apos;
and product in (&apos;premium_placements&apos;, &apos;organic_placements&apos;)
and origin=&apos;vendor&apos;
qualify row_number() OVER (PARTITION BY global_entity_id, campaign_id ORDER BY modified_at_utc) = 1
),

raw_data_vertical as
(select
date_month,
fielddate,
brand_name,
a.global_entity_id,
event_timestamp_utc,
user_id,
is_outlier,
vendor_id,
vertical_parent,
campaign_id,
budget_eur,
is_multiple_outlets_landing,
is_multiple_outlets_mode,
is_multiple_outlets_available
FROM raw_data a, UNNEST(campaign_id) campaign_id
JOIN vertical_parent b on a.global_entity_id=b.global_entity_id and campaign_id=b.campaign_id
GROUP BY ALL)

select
distinct date_month as month,
global_entity_id,
sum(budget_eur) as multioutlet_budget_eur
FROM raw_data_vertical
WHERE coalesce(is_multiple_outlets_landing,is_multiple_outlets_mode)=&apos;true&apos;
and vertical_parent = &apos;restaurants&apos;
GROUP BY ALL)

, nba as 
(-- Define online entities
WITH entity AS (
    SELECT
        brand_name,
        global_entity_id
    FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
    WHERE is_entity_online = TRUE
),

-- Count distinct sessions for page loads
sessions AS (
    SELECT
        COUNT(DISTINCT session_id) AS page_load_sessions,
        fielddate,
        global_entity_id
    FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
    UNNEST(event_params) AS params
    WHERE 
        fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
        AND label = &apos;page_load&apos; 
        AND event_name = &apos;page_open&apos; 
        AND section = &apos;cpc.performance_landing_page&apos; 
        AND is_impersonated = &apos;no&apos; 
        AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
    GROUP BY fielddate, global_entity_id
),

-- Count sessions where recommendations were shown
shown AS (
    SELECT
        fielddate,
        global_entity_id,
        COUNT(DISTINCT session_id) AS shown_sessions
    FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
    UNNEST(event_params) AS params
    WHERE 
        fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
        AND label = &apos;page_load&apos; 
        AND section = &apos;cpc.performance_landing_page&apos; 
        AND params.key = &quot;rec_actions_count&quot; 
        AND params.value.int_value = 1 
        AND is_impersonated = &apos;no&apos; 
        AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
    GROUP BY fielddate, global_entity_id
),

-- Count sessions with &quot;add budget&quot; button clicked
clicked AS (
    SELECT
        fielddate,
        global_entity_id,
        COUNT(DISTINCT session_id) AS clicked_sessions
    FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
    UNNEST(event_params) AS params
    WHERE 
        fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
        AND event_name = &apos;button_tap&apos; 
        AND (label = &apos;add_budget_action&apos;  or label = &apos;rec_card_clicked&apos;)
        AND section = &apos;cpc.performance_landing_page&apos; 
        AND is_impersonated = &apos;no&apos; 
        AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
    GROUP BY fielddate, global_entity_id
),

-- Count sessions with budget increase confirmations
top_up AS (
    SELECT
        fielddate,
        global_entity_id,
        COUNT(DISTINCT session_id) AS top_up_sessions
    FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
    UNNEST(event_params) AS params
    WHERE 
        fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
        AND event_name = &apos;request_succeed&apos; 
        AND label = &apos;increase_budget_confirm&apos; 
        AND section = &apos;cpc.performance_landing_page&apos; 
        AND params.key = &apos;budget_increase_value&apos; 
        AND is_impersonated = &apos;no&apos; 
        AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
    GROUP BY fielddate, global_entity_id
),

-- Calculate total budget increase in EUR
increase AS (
    WITH budget_values AS (
        SELECT
            fielddate,
            session_id,
            global_entity_id,
	        event_timestamp_utc, --- added this line 05 11
            CASE 
                -- Replace [object Object] with the correct currency_code based on global_entity_id
                WHEN (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;currency_code&apos;) = &apos;[object Object]&apos; THEN
                    CASE global_entity_id
                        WHEN &apos;YS_TR&apos; THEN &apos;TRY&apos;
                        WHEN &apos;TB_QA&apos; THEN &apos;QAR&apos;
                        WHEN &apos;TB_OM&apos; THEN &apos;OMR&apos;
                        WHEN &apos;TB_KW&apos; THEN &apos;KWD&apos;
                        WHEN &apos;TB_JO&apos; THEN &apos;JOD&apos;
                        WHEN &apos;TB_IQ&apos; THEN &apos;IQD&apos;
                        WHEN &apos;TB_BH&apos; THEN &apos;BHD&apos;
                        WHEN &apos;TB_AE&apos; THEN &apos;AED&apos;
                        WHEN &apos;PY_VE&apos; THEN &apos;VEF&apos;
                        WHEN &apos;PY_UY&apos; THEN &apos;UYU&apos;
                        WHEN &apos;PY_PY&apos; THEN &apos;PYG&apos;
                        WHEN &apos;PY_PE&apos; THEN &apos;PEN&apos;
                        WHEN &apos;PY_NI&apos; THEN &apos;NIO&apos;
                        WHEN &apos;PY_HN&apos; THEN &apos;HNL&apos;
                        WHEN &apos;PY_GT&apos; THEN &apos;GTQ&apos;
                        WHEN &apos;PY_EC&apos; THEN &apos;USD&apos;
                        WHEN &apos;PY_DO&apos; THEN &apos;DOP&apos;
                        WHEN &apos;PY_CL&apos; THEN &apos;CLP&apos;
                        WHEN &apos;PY_BO&apos; THEN &apos;BOB&apos;
                        WHEN &apos;PY_AR&apos; THEN &apos;ARS&apos;
                        WHEN &apos;PO_FI&apos; THEN &apos;EUR&apos;
                        WHEN &apos;OP_SE&apos; THEN &apos;SEK&apos;
                        WHEN &apos;NP_HU&apos; THEN &apos;HUF&apos;
                        WHEN &apos;MJM_AT&apos; THEN &apos;EUR&apos;
                        WHEN &apos;HS_SA&apos; THEN &apos;SAR&apos;
                        WHEN &apos;HF_EG&apos; THEN &apos;EGP&apos;
                        WHEN &apos;FP_TW&apos; THEN &apos;TWD&apos;
                        WHEN &apos;FP_TH&apos; THEN &apos;THB&apos;
                        WHEN &apos;FP_SG&apos; THEN &apos;SGD&apos;
                        WHEN &apos;FP_PK&apos; THEN &apos;PKR&apos;
                        WHEN &apos;FP_PH&apos; THEN &apos;PHP&apos;
                        WHEN &apos;FP_MY&apos; THEN &apos;MYR&apos;
                        WHEN &apos;FP_KH&apos; THEN &apos;USD&apos;
                        WHEN &apos;FP_HK&apos; THEN &apos;HKD&apos;
                        WHEN &apos;FP_BD&apos; THEN &apos;BDT&apos;
                        WHEN &apos;FO_NO&apos; THEN &apos;NOK&apos;
                        WHEN &apos;DJ_CZ&apos; THEN &apos;CZK&apos;
                        WHEN &apos;CG_QA&apos; THEN &apos;OMR&apos;
                        WHEN &apos;AP_PA&apos; THEN &apos;USD&apos;
                        ELSE NULL -- Handle unexpected cases
                    END
                ELSE (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;currency_code&apos;)
            END AS currency_code,
            coalesce(params.value.string_value, cast(params.value.int_value as string), cast(params.value.double_value as string)) AS total_budget_increase_value
        FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
        UNNEST(event_params) AS params
        WHERE 
            fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
            AND event_name = &apos;request_succeed&apos; 
            AND label = &apos;increase_budget_confirm&apos; 
            AND section = &apos;cpc.performance_landing_page&apos; 
            AND params.key = &apos;budget_increase_value&apos; 
            AND is_impersonated = &apos;no&apos; 
            AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
      		AND (
      				session_id != &apos;f729f378525a0c6a2e73b62b6afb764e&apos; -- oct
      				and
              		session_id != &apos;38d3dc0f7811cc2d8b3554c47dd45500&apos; -- 28 nov
              )
        GROUP BY all
    )
    SELECT
        fielddate,
        global_entity_id,
        SUM(CAST(total_budget_increase_value AS FLOAT64) / CAST(fx_rate_eur AS FLOAT64)) AS total_budget_in_eur
    FROM budget_values a
    JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` b 
        ON a.currency_code = b.currency_code 
        AND a.fielddate = b.fx_rate_date
    GROUP BY fielddate, global_entity_id
)

-- Aggregate results with LEFT JOINs across session metrics and budget increases
SELECT 
DATE_TRUNC(fielddate,month) AS month,
sessions.global_entity_id,
sum(total_budget_in_eur) as nba_topup_budget,
ROUND((SUM(shown_sessions) / NULLIF(SUM(page_load_sessions), 0)) * 100, 2) AS nba_shown_rate,
ROUND((SUM(clicked_sessions) / NULLIF(SUM(shown_sessions), 0)) * 100, 2) AS nba_click_rate,
ROUND((SUM(top_up_sessions) / NULLIF(SUM(clicked_sessions), 0)) * 100, 2) AS nba_applied_rate,
SUM(page_load_sessions) as nba_page_load_sessions,
SUM(shown_sessions) as nba_shown_sessions,
SUM(clicked_sessions) as nba_clicked_sessions,
SUM(top_up_sessions)as nba_top_up_sessions,

FROM sessions 
LEFT JOIN entity USING (global_entity_id)
LEFT JOIN shown USING (fielddate, global_entity_id)
LEFT JOIN clicked USING (fielddate, global_entity_id)
LEFT JOIN top_up USING (fielddate, global_entity_id)
LEFT JOIN increase USING (fielddate, global_entity_id)
group by all)


, newbranch as
(-- Define online entities
WITH entity AS (
SELECT
brand_name,
global_entity_id
FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
WHERE is_entity_online = TRUE
),



-- Count distinct sessions, users for page loads
nba_outlets_views AS (
SELECT
date_trunc(fielddate, month) as date_month,
brand_name,
global_entity_id,
count(distinct session_id) as sessions_brand_reporting_views,
count(distinct user_id) as users_brand_reporting_views,
COUNT(DISTINCT CASE WHEN is_grow_outlets_available=&apos;true&apos; then session_id END) as sessions_nba_outlets_views,
COUNT(DISTINCT CASE WHEN is_grow_outlets_available=&apos;true&apos; then user_id END) as users_nba_outlets_views
FROM
(SELECT
brand_name,
session_id,
user_id,
fielddate,
a.global_entity_id,
(SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;is_grow_outlets_available&apos;) as is_grow_outlets_available
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events` a,
UNNEST(event_params) AS params
JOIN entity e ON a.global_entity_id=e.global_entity_id
WHERE
fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
AND label = &apos;outlets_list_load&apos;
AND event_name = &apos;section_succeed&apos;
AND section = &apos;cpc.performance_landing_page&apos;
AND is_impersonated = &apos;no&apos;
AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
GROUP BY ALL)
GROUP BY ALL
),
-- Count sessions with &quot;grow all your outlets&quot; button clicked
nba_outlets_clicks AS (
SELECT
fielddate,
global_entity_id,
session_id,
user_id,
MIN(event_timestamp_utc) as nba_click_timestamp_utc
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events`,
UNNEST(event_params) AS params
WHERE
fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
AND ((event_name = &apos;button_tap&apos;
AND label = &apos;rec_card_clicked&apos;)
OR
(event_name = &apos;drawer_button_tap&apos;
AND label = &apos;add_budget_action&apos;))
AND (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;grow_outlets_count&apos;) &gt;&gt;0
AND section = &apos;cpc.performance_landing_page&apos;
AND is_impersonated = &apos;no&apos;
AND (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
GROUP BY ALL
),

nba_outlets_clicks_agg AS (
SELECT DATE_TRUNC(fielddate, MONTH) as date_month,
global_entity_id,
COUNT(DISTINCT session_id) sessions_clicks,
COUNT(DISTINCT user_id) users_clicks
FROM nba_outlets_clicks
GROUP BY ALL
),


-- Bookings data
bookings AS (
SELECT
session_id,
user_id,
event_timestamp_utc as booking_timestamp_utc,
global_entity_id,
fielddate,
(SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;campaign_id&apos;) as campaign_id,
SPLIT((SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &apos;selected_vendor_id&apos;), &apos;;&apos; )[OFFSET(1)] as vendor_id
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events`,
UNNEST(event_params) AS params
WHERE
fielddate BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 100 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
AND event_name = &apos;request_succeed&apos;
AND label = &apos;booking_confirm&apos;
AND section in (&apos;cpc.booking_page&apos;, &apos;cpc.landing_page&apos;)
AND is_impersonated = &apos;no&apos;
GROUP BY ALL
),


-- Bookings data from nba
nba_outlets_bookings AS (
SELECT
a.session_id,
a.user_id,
booking_timestamp_utc as nba_booking_timestamp_utc,
a.global_entity_id,
a.fielddate,
campaigns as campaign_id,
vendor_id
FROM bookings a, UNNEST(SPLIT(a.campaign_id,&apos;,&apos;)) campaigns
JOIN nba_outlets_clicks b on a.global_entity_id=b.global_entity_id and a.session_id=b.session_id and booking_timestamp_utc&gt;&gt;=nba_click_timestamp_utc
QUALIFY ROW_NUMBER() OVER (PARTITION BY a.global_entity_id, a.session_id ORDER BY booking_timestamp_utc)=1
),


-- Bookings data from nba with budgets
nba_outlets_bookings_budget AS (
SELECT
date_month,
global_entity_id,
COUNT(DISTINCT session_id) as sessions_bookings,
COUNT(DISTINCT user_id) as users_bookings,
COUNT(DISTINCT campaign_id) as bookings,
SUM(budget_eur) as budget_eur
FROM
(SELECT
DATE_TRUNC(fielddate, MONTH) as date_month,
a.global_entity_id,
session_id,user_id,
a.campaign_id,
pricing.budget_eur
FROM nba_outlets_bookings a
JOIN fulfillment-dwh-production.curated_data_shared_adtech.dim_campaigns b ON a.global_entity_id=b.global_entity_id and a.campaign_id=b.campaign_id
QUALIFY ROW_NUMBER() OVER (PARTITION BY b.global_entity_id, b.campaign_id ORDER BY modified_at_utc)=1
)
GROUP BY ALL
)

-- Totals
SELECT
a.date_month as month,
a.global_entity_id,
budget_eur as nba_new_branch
FROM nba_outlets_views a
LEFT JOIN nba_outlets_clicks_agg b ON a.global_entity_id=b.global_entity_id and a.date_month=b.date_month
LEFT JOIN nba_outlets_bookings_budget c ON a.global_entity_id=c.global_entity_id and a.date_month=c.date_month
GROUP BY ALL
)

, ncr_reporting as

(WITH cmp AS (
  SELECT
    global_entity_id,
    CAST(vendor.id AS STRING) AS vendor_id,
    campaign_id,
    origin,
    DATE_TRUNC(DATE(started_at_utc), MONTH) AS month,
    FORMAT_TIMESTAMP(&apos;%Y-%m-%d %H:%M&apos;, MIN(started_at_utc)) AS started,
    FORMAT_TIMESTAMP(&apos;%Y-%m-%d %H:%M&apos;, MIN(ended_at_utc)) AS ended_at_utc
  FROM `fulfillment-dwh-production.curated_data_shared_adtech.dim_campaigns`,
  UNNEST(advertiser.vendors) AS vendor
  WHERE DATE(started_at_utc) &gt;&gt;= DATE(&apos;2025-05-01&apos;)  -- adjust start date as needed
  GROUP BY
    global_entity_id,
    vendor_id,
    campaign_id,
    origin,
    month
),

rep AS (
  SELECT
    global_entity_id,
    DATE_TRUNC(DATE(fielddate), MONTH) AS month,
    (SELECT SPLIT(p.value.string_value, &apos;;&apos;)[SAFE_OFFSET(1)]
     FROM UNNEST(event_params) AS p
     WHERE p.key = &apos;selected_vendor_id&apos;) AS vendor_id,
    TRUE AS visited
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events`
  WHERE DATE(fielddate) &gt;&gt;= DATE(&apos;2025-05-01&apos;)  -- same window as cmp
    AND label = &apos;page_load&apos;
    AND event_name = &apos;page_open&apos;
    AND section = &apos;cpc.performance_landing_page&apos;
    AND is_impersonated = &apos;no&apos;
    AND (SELECT p.value.string_value FROM UNNEST(event_params) AS p WHERE p.key = &apos;tag&apos;) = &apos;GA4.cpc_performance&apos;
  GROUP BY
    global_entity_id,
    month,
    vendor_id
)

, final as (SELECT
  cmp.month,
  CASE
    WHEN ge.brand IN (&apos;Appetito24&apos;, &apos;Damejidlo&apos;, &apos;Hungry&apos;, &apos;Mjam&apos;, &apos;NetPincer&apos;) THEN &apos;Foodora&apos;
    ELSE ge.brand
  END AS brand,
  cmp.global_entity_id,
  cmp.origin,
  CASE
    WHEN rep.visited = TRUE THEN &apos;true&apos;
    WHEN rep.visited IS NULL THEN &apos;false&apos;
    ELSE &apos;other&apos;
  END AS opened_report,
  COUNT(DISTINCT cmp.vendor_id) AS unique_vendor_count
FROM cmp
LEFT JOIN rep
  ON cmp.vendor_id = rep.vendor_id
  AND cmp.global_entity_id = rep.global_entity_id
  AND cmp.month = rep.month
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS ge
  ON cmp.global_entity_id = ge.global_entity_id
GROUP BY
  cmp.month,
  CASE
    WHEN ge.brand IN (&apos;Appetito24&apos;, &apos;Damejidlo&apos;, &apos;Hungry&apos;, &apos;Mjam&apos;, &apos;NetPincer&apos;) THEN &apos;Foodora&apos;
    ELSE ge.brand
  END,
  cmp.global_entity_id,
  cmp.origin,
  CASE
    WHEN rep.visited = TRUE THEN &apos;true&apos;
    WHEN rep.visited IS NULL THEN &apos;false&apos;
    ELSE &apos;other&apos;
  END
ORDER BY
  cmp.month,
  cmp.global_entity_id,
  cmp.origin,
  opened_report)


  SELECT 
  distinct month,
  global_entity_id,
  SUM(CASE WHEN opened_report=&quot;true&quot; then unique_vendor_count end) as ncr_adopted_vendors,
  sum(unique_vendor_count) as ncr_adopted_total
  from final
  GROUP BY ALL)


, vfd as 
(WITH vpe AS (
  SELECT
    event_timestamp_utc,
    fielddate AS event_date,
    user_id,
    session_id,
    global_vendor_count,
    is_impersonated,
    event_name,
    global_entity_id,

    geo_continent,
    geo_region,
    geo_country,
    geo_city,

    vpm_webview_id,
    app_id,
    device_category,
    device_os,
    device_brand,
    device_model,

    section,
    subsection,
    label,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;plugin_id&quot;) AS plugin_id,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;plugin_name&quot;) AS plugin_name,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;page_name&quot;) AS page_name,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;plugin_code&quot;) AS plugin_code,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;tag&quot;) AS tag,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;selected_vendor_id&quot;) AS selected_vendor_id,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;selected_vendor_count&quot;) AS selected_vendor_count,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_notification_banner&quot;) AS is_notification_banner_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_form&quot;) AS is_create_form_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_carousel&quot;) AS is_carousel_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_report&quot;) AS is_report_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_listing&quot;) AS is_listing_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_membership&quot;) AS is_subscription_loaded,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_referral&quot;) AS is_referral_loaded,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;subscription_program_id&quot;) AS subscription_program_id,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;audience_targeting&quot;) AS audience_targeting,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;menu_selection_available&quot;) AS menu_selection_available,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;branch_selection_available&quot;) AS branch_selection_available,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;selected_value&quot;) AS selected_string_value,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;selected_value&quot;) AS selected_int_value,
    (SELECT params.value.float_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;selected_value&quot;) AS selected_float_value,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_type&quot;) AS discount_type,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;audience_selected&quot;) AS audience_selected,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;num_menu_items_selected&quot;) AS num_menu_items_selected,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;num_vendors_selected&quot;) AS num_vendors_selected,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;min_order_value&quot;) AS min_order_value,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;max_order_value&quot;) AS max_order_value,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_value&quot;) AS discount_value,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;start_date&quot;) AS start_date,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;end_date&quot;) AS end_date,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;is_full_day&quot;) AS is_full_day,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;is_recurring&quot;) AS is_recurring,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;days_of_week&quot;) AS days_of_week,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;template_id&quot;) AS template_id,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_1&quot;) AS carousel_pos_1,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_2&quot;) AS carousel_pos_2,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_3&quot;) AS carousel_pos_3,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_4&quot;) AS carousel_pos_4,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_5&quot;) AS carousel_pos_5,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_6&quot;) AS carousel_pos_6,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_7&quot;) AS carousel_pos_7,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_8&quot;) AS carousel_pos_8,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_9&quot;) AS carousel_pos_9,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;carousel_pos_10&quot;) AS carousel_pos_10,
    (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_campaign_pos&quot;) AS discount_campaign_pos,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_campaign_id&quot;) AS discount_campaign_id,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;deal_id&quot;) AS deal_id,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_level_report&quot;) AS discount_level_report,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_edit&quot;) AS discount_edit,
    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = &quot;discount_cancel&quot;) AS discount_cancel,

    (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key LIKE &quot;%error%&quot;) AS error_msg

  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_events`
  WHERE user_id IS NOT NULL
    AND fielddate &gt;&gt;= &quot;2024-12-01&quot;
),

vp_users AS (
  SELECT
    user_id,
    ven.vendor_id,
    ven.global_entity_id,
    ven.role AS user_role
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_users`
  LEFT JOIN UNNEST(vendors) AS ven
  WHERE ven.role IN (&quot;ADMIN&quot;, &quot;MANAGER&quot;)
),

md AS (
  SELECT DISTINCT event_date, user_id, vendor_id, session_id
  FROM vpe
  LEFT JOIN vp_users AS vpu USING(user_id)
  WHERE event_name = &quot;page_view&quot;
    AND plugin_code = &quot;VENDOR_DEALS&quot;
    AND label = &quot;view_performance_tab&quot;
),

adopted_vendors AS (
  SELECT
    DATE_TRUNC(event_date, MONTH) AS month,
    vendor_id,
    COUNT(DISTINCT session_id) AS no_of_sessions
  FROM md
  GROUP BY month, vendor_id
),

vfd AS (
  SELECT
    month,
    country_code,
    vendor_id,
    SUM(incentive_amount_eur) AS savings
  FROM (
    SELECT
      DATE_TRUNC(order_date, MONTH) AS month,
      b.country_code,
      orders.vendor_id,
      orders.vertical,
      a.vendor_name,
      a.chain_id,
      d.system_creation,
      d.platform_campaign_type,
      a.account_manager_name AS am,
      orders.campaign_id,
      incentive_sub_type,
      incentive_amount_eur,
      order_id,
      a.is_dh_kitchen,
      gmv_amount_eur
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` a
      ON a.vendor_id = orders.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` b
      ON b.chain_id = a.chain_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` d
      ON orders.campaign_id = d.campaign_id
    WHERE order_date &gt;&gt;= &quot;2024-12-01&quot;
      AND is_successful = TRUE
      AND orders.vertical = &apos;food&apos;
      AND incentive_sub_type IN (&apos;menu discount&apos;,&apos;item discount&apos;)
  )
  WHERE country_code != &apos;SA&apos;
  GROUP BY month, country_code, vendor_id
),

final AS (
  SELECT
    vfd.*,
    av.no_of_sessions
  FROM vfd
  LEFT JOIN adopted_vendors av
    ON SAFE_CAST(vfd.vendor_id AS STRING) = av.vendor_id
    AND vfd.month = av.month
),

final2 AS (
  SELECT
    *,
    CASE WHEN no_of_sessions &gt;&gt;= 1 THEN &quot;Y&quot; ELSE &quot;N&quot; END AS adopted_flag
  FROM final
)

SELECT
  month,
CASE 
    WHEN country_code = &apos;EG&apos; THEN CONCAT(&apos;HF_&apos;, country_code)
    ELSE CONCAT(&apos;TB_&apos;, country_code)
END AS global_entity_id,
  COUNT(DISTINCT vendor_id) AS total_vfd_vendors,
  COUNT(DISTINCT CASE WHEN adopted_flag = &quot;Y&quot; THEN vendor_id END) AS adopted_vendors
FROM final2
GROUP BY month, country_code
ORDER BY month, country_code)



SELECT distinct mt.* ,nba.* except(global_entity_id,month),nb.* except(global_entity_id,month),ncr.* except(month,global_entity_id),vfd.* except(month,global_entity_id)
FROM multioutlet mt
JOIN nba 
ON mt.month=nba.month and mt.global_entity_id=nba.global_entity_id
JOIN newbranch nb
ON mt.month=nb.month and mt.global_entity_id=nb.global_entity_id
JOIN ncr_reporting ncr
ON safe_cast(mt.month as string)=safe_cast(ncr.month as string) and mt.global_entity_id=ncr.global_entity_id
JOIN vfd
ON mt.month=vfd.month and mt.global_entity_id=vfd.global_entity_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
