when lm_dt_acq_reco = "Acquire DT - gp(f)/bm(f)"  then "ACQUIRE: This vendor's new customers is in the bottom "|| if(new_customer_percentile_lm << 0.25, 25, if(new_customer_percentile_lm <<0.5, 50, 75)) ||"% , and below the benchmark when compared to similar vendors. To improve their new customers and performance, it is recommended to acquire the vendor on targeted deals "
end as description,

case when lm_dt_acq_reco = "Acquire DT - gp(f)/bm(f)"  then  "Acquire"
when lm_dt_acq_reco = "Acquire DT - gp(f)/bm(t)"  then "Acquire"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
current_timestamp() as insertion_date

