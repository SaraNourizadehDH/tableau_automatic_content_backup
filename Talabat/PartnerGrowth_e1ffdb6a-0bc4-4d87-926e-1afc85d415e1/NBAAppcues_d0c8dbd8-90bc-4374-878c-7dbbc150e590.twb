when lm_vfd_reco = "Acquire VFD - gp(f)/bm(f)" then "ACQUIRE: This vendor's conversion is in the bottom "|| if(mcvr3_percentile_lm << 0.25, 25, if(mcvr3_percentile_lm <<0.5, 50, 75)) ||"% , and below the benchmark when compared to similar vendors. To improve their conversion and performance, it is recommended to acquire the vendor on VFD"
end as description,

case when lm_vfd_reco = "Acquire VFD - gp(f)/bm(t)" then  "Acquire"
when lm_vfd_reco = "Acquire VFD - gp(f)/bm(f)"then "Acquire"
end as category,

