and vendor_fail_rate_ratio >> vendor_fail_rate_threshold)


, uhl2 as 
(
SELECT 
DATE(REGEXP_REPLACE(start_date__c, r':000\+', ':00+')) AS formatted_date,
start_date__c,
vendor_id,
vendor_name,
owner_email,
global_entity_id,
Type__c,name,
category

FROM UHL
WHERE 
UHL.Type__c in ('CPC','Deal Targeting','Display Ads','GEM','Promotion')
)

, users as ( with md as (SELECT v.user_id,i.vendor_id,v.internal_flag,i.role,
FROM `fulfillment-dwh-production.curated_data_shared_vendor.vp_sessions` v, unnest(vendors_info) i
WHERE fielddate BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
)

SELECT *
FROM md
WHERE
role = 'ADMIN'
and internal_flag = false
group by all
)

, aov as (
 SELECT
    CAST(vendor_id AS string) vendor_id,
    ROUND(SUM(gmv_amount_eur)/COUNT(DISTINCT order_id), 2) vendor_aov,
    MAX(c.cl3maov) country_aov
  FROM
    `tlb-data-prod.data_platform.fct_order_info`
  INNER JOIN (
    SELECT
      country_id,
      country_code,
      ROUND(SUM(gmv_amount_eur)/COUNT(DISTINCT order_id), 2) cl3maov
    FROM
      `tlb-data-prod.data_platform.fct_order_info`
    WHERE
      is_successful
      AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
    GROUP BY
      1,
      2) c
  USING
    (country_id)
  WHERE
    is_successful
    AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
  GROUP BY ALL)


,discounts as 
(SELECT 
  vendor_id,
  STRING_AGG(DISTINCT discount_type) AS discount_types
FROM (
  SELECT 
    DISTINCT
    m.vendor_id,
    m.discount_type
  FROM (
    SELECT 
      DISTINCT 
      DATE_TRUNC(order_date, MONTH) AS month,
      orders.vendor_id,
      orders.campaign_id,
      incentive_sub_type AS discount_type,
      order_id
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` a
      ON a.vendor_id = orders.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` b
      ON b.chain_id = a.chain_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` d
      ON orders.campaign_id = d.campaign_id
    WHERE 
      DATE(order_date) BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) 
                           AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
      AND is_successful = TRUE
      AND incentive_sub_type IN ('menu discount', 'item discount')
      AND orders.vertical = 'food'
  ) m
) 
GROUP BY vendor_id)

## for the uhl vendors, check which users are creating a session in the last month, do this by joing to the users table.
, combo1 as 

( 
  SELECT uhl2.*,users.* except(vendor_id)
FROM uhl2
left join users
ON safe_cast(uhl2.vendor_id as string)=users.vendor_id
)

## for the uhl vendors, and the users for those, lets check

, combo2 as 

( SELECT combo1.*,aov.* except(vendor_id)
FROM combo1
LEFT JOIN aov
on safe_cast(combo1.vendor_id as string)=aov.vendor_id)

, combo3 as (
  SELECT combo2.*,discounts.* except(vendor_id)
FROM combo2
left join discounts
ON combo2.vendor_id=discounts.vendor_id
)

select * except(start_date__c,owner_email),
case when name = 'Acquire Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_acq_promotions_fmd_50_percent" ## checked
when name = 'Acquire Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_acq_promotions_fmd_20_percent"
when name = 'Acquire Promotions' and (discount_types in ('item discount')) THEN "tlb_acq_promotions_item_30_percent" ## checked

when name = 'Retain Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_rt_promotions_fmd_50_percent" ## checked
when name = 'Retain Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_rt_promotions_fmd_20_percent"
when name = 'Retain Promotions' and (discount_types in ('item discount')) THEN "tlb_rt_promotions_item_30_percent" ## checked

when name = 'Reactivate Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_ra_promotions_fmd_50_percent" ## checked
when name = 'Reactivate Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_ra_promotions_fmd_20_percent"
when name = 'Reactivate Promotions' and (discount_types in ('item discount')) THEN "tlb_ra_promotions_item_30_percent" ## checked
else name
end as final_action
from combo3]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
