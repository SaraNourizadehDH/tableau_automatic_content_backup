agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Menu Optimisation' as Type__c,
sf.id as sf_account_id,
'Fix DLP' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
"This vendor has a low DLP (dish level photo) rate of "|| round((100* agg.dish_level_picture_ratio),2)  ||". Fix DLP to improve performance"  as description,

"DLP" as category,
'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
join `tlb-data-prod.data_platform.dim_vendor_info`   vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lifecycle_status_lm  not in ( "New_nb_wb","New_fe")
and dish_level_picture_ratio <<  dish_level_picture_threshold

union all 

select
--DLD reco for exisiting / churned vendors
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Menu Optimisation' as Type__c,
sf.id as sf_account_id,
'Fix DLD' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
"This vendor has a low DLD (dish level description) rate of "|| round((100* agg.dish_level_description_ratio),2)  ||". Fix DLD to improve performance"  as description,

"DLD" as category,
'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
join `tlb-data-prod.data_platform.dim_vendor_info`  vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lifecycle_status_lm not in ( "New_nb_wb","New_fe")
and dish_level_description_ratio << dish_level_description_threshold



union all 

select
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'VFR' as Type__c,
sf.id as sf_account_id,
'Fix Vendor Fail Rate' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
"This vendor has a high vendor fail rate of "|| round((100* agg.vendor_fail_rate_ratio),2)  ||". Fix VFR to improve performance"  as description,

"VFR" as category,
'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
join `tlb-data-prod.data_platform.dim_vendor_info`   vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c 
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lifecycle_status_lm not in ( "New_nb_wb","New_fe")
and vendor_fail_rate_ratio >> vendor_fail_rate_threshold)


, uhl2 as 
(
SELECT 
DATE(REGEXP_REPLACE(start_date__c, r':000\+', ':00+')) AS formatted_date,
start_date__c,
vendor_id,
vendor_name,
owner_email,
global_entity_id,
Type__c,name,
category

FROM UHL
WHERE 
UHL.Type__c in ('CPC','Deal Targeting','Display Ads','GEM','Promotion')
)

, users as ( with md as (SELECT v.user_id,i.vendor_id,v.internal_flag,i.role,
FROM `fulfillment-dwh-production.curated_data_shared_vendor.vp_sessions` v, unnest(vendors_info) i
WHERE fielddate BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
)

SELECT *
FROM md
WHERE
role = 'ADMIN'
and internal_flag = false
group by all
)

, aov as (
 SELECT
    CAST(vendor_id AS string) vendor_id,
    ROUND(SUM(gmv_amount_eur)/COUNT(DISTINCT order_id), 2) vendor_aov,
    MAX(c.cl3maov) country_aov
  FROM
    `tlb-data-prod.data_platform.fct_order_info`
  INNER JOIN (
    SELECT
      country_id,
      country_code,
      ROUND(SUM(gmv_amount_eur)/COUNT(DISTINCT order_id), 2) cl3maov
    FROM
      `tlb-data-prod.data_platform.fct_order_info`
    WHERE
      is_successful
      AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
    GROUP BY
      1,
      2) c
  USING
    (country_id)
  WHERE
    is_successful
    AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH) 
                     AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
  GROUP BY ALL)


,discounts as 
(SELECT 
  vendor_id,
  STRING_AGG(DISTINCT discount_type) AS discount_types
FROM (
  SELECT 
    DISTINCT
    m.vendor_id,
    m.discount_type
  FROM (
    SELECT 
      DISTINCT 
      DATE_TRUNC(order_date, MONTH) AS month,
      orders.vendor_id,
      orders.campaign_id,
      incentive_sub_type AS discount_type,
      order_id
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` orders
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` a
      ON a.vendor_id = orders.vendor_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_chain` b
      ON b.chain_id = a.chain_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` d
      ON orders.campaign_id = d.campaign_id
    WHERE 
      DATE(order_date) BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) 
                           AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
      AND is_successful = TRUE
      AND incentive_sub_type IN ('menu discount', 'item discount')
      AND orders.vertical = 'food'
  ) m
) 
GROUP BY vendor_id)

## for the uhl vendors, check which users are creating a session in the last month, do this by joing to the users table.
, combo1 as 

( 
  SELECT uhl2.*,users.* except(vendor_id)
FROM uhl2
left join users
ON safe_cast(uhl2.vendor_id as string)=users.vendor_id
)

## for the uhl vendors, and the users for those, lets check

, combo2 as 

( SELECT combo1.*,aov.* except(vendor_id)
FROM combo1
LEFT JOIN aov
on safe_cast(combo1.vendor_id as string)=aov.vendor_id)

, combo3 as (
  SELECT combo2.*,discounts.* except(vendor_id)
FROM combo2
left join discounts
ON combo2.vendor_id=discounts.vendor_id
)

select * except(start_date__c,owner_email),
case when name = 'Acquire Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_acq_promotions_fmd_50_percent" ## checked
when name = 'Acquire Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_acq_promotions_fmd_20_percent"
when name = 'Acquire Promotions' and (discount_types in ('item discount')) THEN "tlb_acq_promotions_item_30_percent" ## checked

when name = 'Retain Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_rt_promotions_fmd_50_percent" ## checked
when name = 'Retain Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_rt_promotions_fmd_20_percent"
when name = 'Retain Promotions' and (discount_types in ('item discount')) THEN "tlb_rt_promotions_item_30_percent" ## checked

when name = 'Reactivate Promotions' and (vendor_aov >>= country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_ra_promotions_fmd_50_percent" ## checked
when name = 'Reactivate Promotions' and (vendor_aov << country_aov) and (discount_types in ('menu discount','menu discount,item discount','item discount,menu discount') or discount_types is null) THEN "tlb_ra_promotions_fmd_20_percent"
when name = 'Reactivate Promotions' and (discount_types in ('item discount')) THEN "tlb_ra_promotions_item_30_percent" ## checked
else name
end as final_action
from combo3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.147he5s0nk6zld11wcf410bf16zi' name='Custom SQL Query' type='text'><![CDATA[-- #### All the UHL data coming from DH side


with uhl as (select

agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email, 
sf.global_entity_id,
'CPC' as Type__c,
sf.id as sf_account_id,
'Acquire CPC' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,

case when lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(f)"  and r.vendor_id is null then  "ACQUIRE: This vendor's session count is in the bottom "|| if(viewed_session_percentile_lm << 0.25, 25, if(viewed_session_percentile_lm <<0.5, 50, 75)) ||"% , and below the benchmark when compared to similar vendors. To improve their visibility and performance, it is recommended to acquire the vendor on CPC"
when  lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(f)" and  cast(r.vendor_id  as int) = agg.vendor_id then "ACQUIRE the vendor on CPC: Recommendation for budget(LC) and areas - Budget: "||central_ll_recommended_budget ||" | Area:  "||central_ll_recommended_promo_areas ||""

when lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(t)" and r.vendor_id is null then   "ACQUIRE: This vendor's month-over-month sessions is "|| round((mom_viewed_sessions_lm *100),1)||"% - which is below the month-over-month sessions of other similar vendors. To address this, acquire the vendor on CPC to boost their session count and improve performance"
when lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(t)" and cast(r.vendor_id  as int) = agg.vendor_id then "ACQUIRE the vendor on CPC: Recommendation for budget(LC) and areas - Budget: "||central_ll_recommended_budget ||" | Area:  "||central_ll_recommended_promo_areas ||""
end as description,

case when lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(t)" then  "Acquire"
when lm_cpc_acq_reco = "Acquire CPC - gp(f)/bm(f)" then "Acquire"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
current_timestamp() as insertion_date 

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg 
join `tlb-data-prod.data_platform.dim_vendor_info`   vendor on vendor.vendor_id=agg.vendor_id
left join `fulfillment-dwh-production.curated_data_shared_sales_revenue.atl_re_talabat_recommendations` r on cast(r.vendor_id  as int) = agg.vendor_id 
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 

and lm_cpc_acq_reco in 
(
"Acquire CPC - gp(f)/bm(t)",
"Acquire CPC - gp(f)/bm(f)" 
 ) 
and lifecycle_status_lm = "Active"
and is_dish_level_picture_compliant = true 
and is_vendor_fail_rate_ratio_compliant = true

union all   

select

agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
sf.global_entity_id,
'Display Ads' as Type__c,
sf.id as sf_account_id,
'Acquire on Display Ads' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
case when lm_da_acq_reco = "Acquire DA - gp(f)/bm(f)"  and r.vendor_id is null then  "ACQUIRE: This vendor's session count is in the bottom "|| if(viewed_session_percentile_lm << 0.25, 25, if(viewed_session_percentile_lm <<0.5, 50, 75)) ||"% , and below the benchmark when compared to similar vendors. To improve their visibility and performance, it is recommended to acquire the vendor on Display Ads"
when  lm_da_acq_reco = "Acquire DA - gp(f)/bm(f)" and  cast(r.vendor_id  as int) = agg.vendor_id then "ACQUIRE the vendor on ddisplay ads"

when lm_da_acq_reco = "Acquire DA - gp(f)/bm(t)" and r.vendor_id is null then   "ACQUIRE: This vendor's month-over-month sessions is "|| round((mom_viewed_sessions_lm *100),1)||"% - which is below the month-over-month sessions of other similar vendors. To address this, acquire the vendor on Display Ads to boost their session count and improve performance"
when lm_da_acq_reco = "Acquire DA - gp(f)/bm(t)" and cast(r.vendor_id  as int) = agg.vendor_id then "ACQUIRE the vendor on display ads "
end as description,

case when lm_da_acq_reco = "Acquire DA - gp(f)/bm(t)" then  "Acquire"
when lm_da_acq_reco = "Acquire DA - gp(f)/bm(f)" then "Acquire"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
current_timestamp() as insertion_date 

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg 
join `tlb-data-prod.data_platform.dim_vendor_info`  vendor on vendor.vendor_id=agg.vendor_id
left join `fulfillment-dwh-production.curated_data_shared_sales_revenue.atl_re_talabat_recommendations` r on cast(r.vendor_id  as int) = agg.vendor_id 
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 

and lm_da_acq_reco in 
(
"Acquire DA - gp(f)/bm(t)",
"Acquire DA - gp(f)/bm(f)" 
 ) 
and lifecycle_status_lm = "Active"

and is_dish_level_picture_compliant = true 
and is_vendor_fail_rate_ratio_compliant = true

union all

select

agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
sf.global_entity_id,
'CPC' as Type__c,
sf.id as sf_account_id, 
'Reactivate CPC' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
 case
when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(f)" AND  r.vendor_id is null  then "REACTIVATE: This vendor has churned from CPC in the last six months and their session count is in the bottom "|| if(viewed_session_percentile_lm << 0.25, 25, if(viewed_session_percentile_lm <<0.5, 50, 75))||"% , and below the benchmark when compared to similar vendors. Reactivate their CPC campaign to improve their session count and performance"
when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(f)" and  cast(r.vendor_id  as int) = agg.vendor_id   then "ACQUIRE the vendor on CPC: Recommendation for budget(LC) and areas - Budget: "||central_ll_recommended_budget ||" | Area:  "||central_ll_recommended_promo_areas ||""

when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(t)" and    r.vendor_id is null then "REACTIVATE: This vendor has churned from CPC in the last six months and has experienced a month-over-month decrease in sessions by "|| round((mom_viewed_sessions_lm*100),1)||"%. Reactivate their CPC campaign to improve their session count and performance"

when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(t)" and  cast(r.vendor_id  as int) = agg.vendor_id then "ACQUIRE the vendor on CPC: Recommendation for budget(LC) and areas - Budget: "||central_ll_recommended_budget ||" | Area:  "||central_ll_recommended_promo_areas ||""
end as description,
 
case 
when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(t)" then "Reactivate"
when lm_cpc_reco =  "Reactivate CPC - gp(f)/bm(f)" then "Reactivate"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
current_timestamp() as insertion_date

from  `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
left join `fulfillment-dwh-production.curated_data_shared_sales_revenue.atl_re_talabat_recommendations` r on cast(r.vendor_id  as int) = agg.vendor_id 
join `tlb-data-prod.data_platform.dim_vendor_info`   vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lm_cpc_reco in 
(
'Reactivate CPC - gp(f)/bm(f)',
'Reactivate CPC - gp(f)/bm(t)'
) 
and lifecycle_status_lm = "Active"

and is_dish_level_picture_compliant = true 
and is_vendor_fail_rate_ratio_compliant = true

union all 


select
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Display Ads' as Type__c,
sf.id as sf_account_id,
'Reactivate Display ads' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
case
when LM_display_ads_reco =  "Reactivate DA - gp(f)/bm(t)" then "REACTIVATE: This vendor has churned from Display ads in the last six months and has experienced a month-over-month decrease in sessions by "|| round((mom_viewed_sessions_lm*100),1)||"%. Reactivate their Display ads to improve their session count and performance"

when LM_display_ads_reco =  "Reactivate DA - gp(f)/bm(f)" then "REACTIVATE: This vendor has churned from Display ads in the last six months and their session count is in the bottom "|| if(viewed_session_percentile_lm << 0.25, 25, if(viewed_session_percentile_lm <<0.5, 50, 75))||"% , and below the benchmark when compared to similar vendors. Reactivate their Display ads to improve their session count and performance"
end as description,

case
when lm_display_ads_reco =  "Reactivate DA - gp(f)/bm(t)" then "Reactivate"
when lm_display_ads_reco =  "Reactivate DA - gp(f)/bm(f)"  then  "Reactivate"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from  `tlb-data-dev.data_playground.agg_recommendations_monthly_pg` agg
join `tlb-data-prod.data_platform.dim_vendor_info` vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lm_display_ads_reco in 
(
"Reactivate DA - gp(f)/bm(t)",
"Reactivate DA - gp(f)/bm(f)" 
) 
and lifecycle_status_lm = "Active"

and is_dish_level_picture_compliant = true 
and is_vendor_fail_rate_ratio_compliant = true

union all

select
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Display Ads' as Type__c,
sf.id as sf_account_id,
'Retain Display ads' as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
case 
when lm_display_ads_reco =  "Retain DA - gp(t)/bm(f)" then "RETAIN: This vendor was on Display ads last month, but their session count is in the bottom "|| if(viewed_session_percentile_lm << 0.25, 25, if(viewed_session_percentile_lm <<0.5, 50, 75))||"%, and still below the benchmark when compared to similar vendors. To improve their performance, continue to keep the vendor on the Display ads"

when lm_display_ads_reco =  "Retain DA - gp(t)/bm(t)" then "RETAIN: This vendor was on Display ads last month and their session count is above the benchmark compared to similar vendors. Continue to keep the vendor on Display ads to maintain and further improve their performance"
end as description,

case 
when lm_display_ads_reco =  "Retain DA - gp(t)/bm(f)" then "Retain"
when lm_display_ads_reco =  "Retain DA - gp(t)/bm(t)" then "Retain"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
join `tlb-data-prod.data_platform.dim_vendor_info`  vendor on vendor.vendor_id=agg.vendor_id
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

where 1=1 
and lm_display_ads_reco in 
(
'Retain DA - gp(t)/bm(f)',
'Retain DA - gp(t)/bm(t)'
 ) 
and lifecycle_status_lm = "Active"
and is_dish_level_picture_compliant = true 
and is_vendor_fail_rate_ratio_compliant = true

union all

select
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Promotion' as Type__c,
sf.id as sf_account_id,
case when lower(agg.country_code) <<>> "ae"  then 'Acquire Promotions' 
when lower(agg.country_code) = "ae" and bs.salesforce_id = agg.salesforce_id and bs.salesforce_id is not null  then 'Acquire Promotions - BestSellers' 
when lower(agg.country_code) = "ae" and bs.salesforce_id  is null  then 'Acquire Promotions' 
end  as Name,

sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
