select
agg.date_month,
agg.vendor_id,
vendor.vendor_name, 
vendor.owner_email,
global_entity_id,
'Promotion' as Type__c,
sf.id as sf_account_id, 
case when lower(agg.country_code) <<>> "ae"  then 'Retain Promotions' 
when lower(agg.country_code) = "ae" and  vfd_type is null  then 'Retain Promotions' 
when lower(agg.country_code) = "ae" and  vfd_type = "Bestseller" then 'Retain Promotions - BestSellers' 
when lower(agg.country_code) = "ae" and  vfd_type = "Supersaver"  then 'Retain Promotions - SuperSavers' end  as Name,
sf.ownerid as Ownerid,
1 as Score_Weighting__c,
(CONCAT(firstname, ' ', lastname)) AS owner_name,
case when lm_vfd_reco =  "Retain VFD - gp(t)/bm(f)"  and vfd_type is not null then "RETAIN: This vendor was on VFD last month, but their conversion (mcvr3) is in the bottom "|| if(mcvr3_percentile_lm << 0.25, 25, if(mcvr3_percentile_lm <<0.5, 50, 75))||"%, and below the benchmark when compared to similar vendors. To improve their performance, retain the vendor on the VFD."

when lm_vfd_reco =  "Retain VFD - gp(t)/bm(f)"  and vfd_type is null then "RETAIN: This vendor was on VFD last month, but their conversion (mcvr3) is in the bottom "|| if(mcvr3_percentile_lm << 0.25, 25, if(mcvr3_percentile_lm <<0.5, 50, 75))||"%, and below the benchmark when compared to similar vendors. To improve their performance, retain the vendor on the VFD."

when lm_vfd_reco =  "Retain VFD - gp(t)/bm(t)" and vfd_type is not null  then "RETAIN: This vendor was on VFD last month and their conversion (mcvr3) is above the benchmark compared to similar vendors. Continue to keep the vendor on VFD to maintain and further improve their performance."

when lm_vfd_reco =  "Retain VFD - gp(t)/bm(t)" and vfd_type is  null  then "RETAIN: This vendor was on VFD last month and their conversion (mcvr3) is above the benchmark compared to similar vendors. Continue to keep the vendor on VFD to maintain and further improve their performance"
end as description,

case 
when lm_vfd_reco =   "Retain VFD - gp(t)/bm(f)"  then "Retain"
when lm_vfd_reco =   "Retain VFD - gp(t)/bm(t)"  then "Retain"
end as category,

'01269000000qHPVAA2' as RecordTypeId,
concat(datetime(( date_add(date_month,interval 1 month))),'0+0000') as Start_Date__c,
concat(datetime(date_sub( date_add(date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

