concat(datetime(date_sub( date_add(agg.date_month,interval 2 month), interval 1 day)),'0+0000') as End_Date__c,
 current_timestamp() as insertion_date

from   `tlb-data-dev.data_playground.agg_recommendations_monthly_pg`  agg
join `tlb-data-prod.data_platform.dim_vendor_info`  vendor on vendor.vendor_id=agg.vendor_id
left join `tlb-data-prod.data_platform_google_sheet.bestseller_master_list` bs on agg.salesforce_id = bs.salesforce_id -- to send bestseller reco
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` sf on vendor.salesforce_id = sf.grid__c
left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = sf.ownerid

