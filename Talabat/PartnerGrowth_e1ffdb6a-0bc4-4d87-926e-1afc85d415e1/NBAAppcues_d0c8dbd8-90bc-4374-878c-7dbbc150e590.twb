      <aliases enabled='yes' />
      <column caption='Window' datatype='string' name='[Calculation_2504494017528532994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [campaign_start_date] &gt;= [date] AND [campaign_start_date] &lt;= [date]+28 then &quot;TRUE&quot;&#10;ELSE &quot;FALSE&quot;&#10;END' />
      </column>
      <column caption='# Users' datatype='integer' name='[Calculation_3931220305745506304]' role='measure' type='quantitative'>
