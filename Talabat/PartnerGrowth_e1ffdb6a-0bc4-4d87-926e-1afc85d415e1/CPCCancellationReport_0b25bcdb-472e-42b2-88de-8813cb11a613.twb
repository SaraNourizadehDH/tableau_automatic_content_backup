            <connection CATALOG='publicdata' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='server-custom' username='muhammad.afzal@talabat.com' workgroup-auth-mode='prompt' />
