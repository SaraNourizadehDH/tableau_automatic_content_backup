      <aliases enabled='yes' />
      <column caption='Budget utilized' datatype='real' name='[Budget Booked (copy)_2806446307132628998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budget_utilized])' />
      </column>
      <column caption='# Chains' datatype='integer' name='[Calculation_2806446307132092417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([chain_id])' />
      </column>
      <column caption='# Vendors' datatype='integer' name='[Calculation_2806446307132231682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_name])' />
      </column>
      <column caption='# Campaigns' datatype='integer' name='[Calculation_2806446307132338179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([campaign_id])' />
      </column>
      <column caption='Budget booked' datatype='real' name='[Calculation_2806446307132571653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budget_booked])' />
      </column>
      <column caption='Lost budget' datatype='real' name='[Calculation_2806446307132809223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(budget_booked)-SUM(budget_utilized)' />
      </column>
      <column caption='Cancelled Budget (Agent)' datatype='real' name='[Calculation_2806446307171037193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [updated_by_actor] = &apos;agent&apos; THEN [budget_booked] &#10;    END&#10;)' />
      </column>
      <column caption='[User Filter]' datatype='boolean' name='[Calculation_5355483696943947776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#10;END' />
      </column>
      <column caption='Cancelled Budget (Vendor)' datatype='real' name='[Cancelled Budget (Agent) (copy)_2806446307171590154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [updated_by_actor] = &apos;vendor&apos; THEN [budget_booked] &#10;    END&#10;)' />
      </column>
