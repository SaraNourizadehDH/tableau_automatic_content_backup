      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='CPC Cancellation Report' id='_1BFFD01F221E4E89B23DA7170F8966DB'>
            <properties context=''>
              <relation connection='bigquery.14ctz6n1hzobfj1696ivy0xeflou' name='Custom SQL Query' type='text'><![CDATA[with md as (WITH
  c1 AS (
  SELECT
    DISTINCT 
    global_entity_id as country,
    campaign_id,
    ended_at_utc,
    modified_at_utc,
    updated_by_actor,
    product,
    status,
    vendor.id,
    vendor.chain_id,
  FROM
    `fulfillment-dwh-production.curated_data_shared_adtech.dim_campaigns`,
    UNNEST (advertiser.vendors) AS vendor
  WHERE
product= 'organic_placements'
    AND status = 'cancelled'
    AND EXTRACT(YEAR FROM ended_at_utc) = EXTRACT(YEAR FROM CURRENT_DATE())
  AND EXTRACT(MONTH FROM ended_at_utc) = EXTRACT(MONTH FROM CURRENT_DATE())
  AND date(ended_at_utc) << CURRENT_DATE()
    GROUP BY ALL ),
  
  c2 AS (
  SELECT
    DISTINCT 
    date,
    vendor_id,
    campaign_id,
    SUM(revenue_eur) OVER (PARTITION BY vendor_id, campaign_id ORDER BY date) AS budget_utilized,
    max(budget.eur) AS budget_booked
  FROM
    `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily_local_v2`
  WHERE
    product = 'organic_placements'
    AND EXTRACT(YEAR FROM date) = EXTRACT(YEAR FROM CURRENT_DATE())
  AND EXTRACT(MONTH FROM date) = EXTRACT(MONTH FROM CURRENT_DATE())
  AND date << CURRENT_DATE()
  GROUP BY date,vendor_id,campaign_id,revenue_eur
  order by vendor_id)
SELECT
  DISTINCT c1.*,
  c2.* EXCEPT(campaign_id,
    vendor_id,date),
  i.vendor_name,
  i.account_manager_name,
  i.team_leader_email,
  i.account_manager_email,
  ch.vertical
FROM
  c1
FULL JOIN
  c2
ON
  c1.campaign_id=c2.campaign_id
  AND c1.id=c2.vendor_id and date(c1.ended_at_utc)=c2.date
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` i
ON
  SAFE_CAST(c1.id AS int64)=i.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch
ON safe_cast(c1.chain_id as int64)=ch.chain_id
)


  SELECT *
  FROM md 
  WHERE 
  id is not null
  and vertical = 'food']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
