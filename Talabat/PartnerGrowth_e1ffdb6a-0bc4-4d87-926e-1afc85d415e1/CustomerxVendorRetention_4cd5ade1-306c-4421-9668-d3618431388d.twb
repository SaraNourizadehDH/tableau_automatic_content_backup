    <worksheet name='Retention Monthly (183)'>
      <layout-options>
        <title>
          <formatted-text>
            <run> Monthly Customer Retention (180 Day View)
</run>
            <run fontcolor='#e6e6e6'>-</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='new_customer_retention' name='federated.0t924ip0uyngaq14jhqvy1uw8056' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Split Type 2' datatype='string' name='[Choose Split Type (copy)_4056547005048639489]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer Lifecycle Segment&quot;'>
              <calculation class='tableau' formula='&quot;Customer Lifecycle Segment&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t924ip0uyngaq14jhqvy1uw8056'>
            <column caption='Unique Customer v3' datatype='integer' name='[Calculation_4056547005062021128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Lifecycle Segment&quot; THEN &#10;SUM(IF [Calculation_5278218772032127011] = &quot;Acquired in later months&quot; THEN NULL&#10;ELSEIF [Calculation_5278218772032127011] = &quot;last order before 181 days&quot; THEN NULL&#10;ELSEIF [Calculation_5278218772032127011] = &quot;Lapsed&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END)&#10;ELSEIF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Frequency Type (t)&quot;&#10;THEN SUM(&#10;IF [customer_freq_segment_0_90] = &quot;Other&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END &#10;)&#10;ELSEIF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Frequency Type (t-90)&quot;&#10;THEN SUM(&#10;IF [customer_freq_segment_91_181] = &quot;Other&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END &#10;)&#10;ELSE SUM([Calculation_5278218772218581031]) END' />
            </column>
            <column caption='Customer Lifecycle Segment v1' datatype='string' name='[Calculation_5278218772032127011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[customer_lifecycle_segment] = &quot;Not completed 181 days - no order in 0 to 90 day&quot; &#10;THEN &quot;Lapsed&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot;&#10;THEN &quot;Returning&quot;&#10;ELSE [customer_lifecycle_segment]&#10;END' />
            </column>
            <column caption='Unique Customer v1' datatype='integer' name='[Calculation_5278218772218581031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Calculation_5278218772032127011] = &quot;Acquired in later months&quot; THEN NULL&#10;ELSEIF [Calculation_5278218772032127011] = &quot;last order before 181 days&quot; THEN NULL&#10;ELSE [Unique_Customers] END)' />
            </column>
            <column caption='Choose Split Type Calc 2' datatype='string' name='[Choose Split Type Calc (copy)_4056547005048582144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Split Type (copy)_4056547005048639489]&#10;WHEN &quot;Overall&quot; THEN &quot;&quot;&#10;WHEN &quot;Customer Frequency Type (t)&quot; THEN [customer_freq_segment_0_90]&#10;WHEN &quot;Customer Frequency Type (t-90)&quot; THEN [customer_freq_segment_91_181]&#10;WHEN &quot;Customer Lifecycle Segment&quot; THEN [Customer Lifecycle Segment v1 (copy)_5278218772218462246]&#10;END' />
            </column>
            <column caption='Customer Lifecycle Segment v2' datatype='string' name='[Customer Lifecycle Segment v1 (copy)_5278218772218462246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[customer_lifecycle_segment] = &quot;Not completed 181 days - no order in 0 to 90 day&quot; &#10;THEN &quot;Lapsed&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Reactivated&quot;&#10;THEN &quot;Reactivated&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Lapsed&quot;&#10;THEN &quot;Lapsed&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;New to vendor 90&quot;&#10;THEN &quot;New&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot;&#10;THEN &quot;Returning&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Returning&quot;&#10;THEN &quot;Returning&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;Acquired in later months&quot;&#10;THEN &quot;Other&quot;&#10;ELSEIF [customer_lifecycle_segment] = &quot;last order before 181 days&quot;&#10;THEN &quot;Other&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Unique Customers' datatype='integer' name='[Unique_Customers]' role='measure' type='quantitative' />
            <column caption='Customer Freq Segment t' datatype='string' name='[customer_freq_segment_0_90]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Other&quot;' value='Churned' />
              </aliases>
            </column>
            <column caption='Customer Freq Segment t-90' datatype='string' name='[customer_freq_segment_91_181]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Other&quot;' value='Churned' />
              </aliases>
            </column>
            <column datatype='string' name='[customer_lifecycle_segment]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' default-format='*DD-MMM-YY' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Choose Split Type Calc (copy)_4056547005048582144]' derivation='None' name='[none:Choose Split Type Calc (copy)_4056547005048582144:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4056547005062021128]' derivation='User' name='[usr:Calculation_4056547005062021128:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0t924ip0uyngaq14jhqvy1uw8056].[tmn:month:qk]' scope='cols' value='' />
