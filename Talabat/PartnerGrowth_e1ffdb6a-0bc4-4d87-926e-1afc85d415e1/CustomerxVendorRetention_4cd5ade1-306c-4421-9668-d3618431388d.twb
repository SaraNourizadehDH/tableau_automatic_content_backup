              </aliases>
            </column>
            <column caption='Customer Freq Segment t-90' datatype='string' name='[customer_freq_segment_91_181]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Other&quot;' value='Churned' />
              </aliases>
            </column>
            <column datatype='string' name='[customer_lifecycle_segment]' role='dimension' type='nominal' />
            <column datatype='integer' name='[customers_90_day]' role='measure' type='quantitative' />
            <column caption='Is AAA?' datatype='boolean' name='[is_aaa_account]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_adex_acq]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Non ADEX Acquisition' />
              </aliases>
            </column>
            <column datatype='boolean' name='[is_incentive_acq]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Non Incentive Acquisition' />
                <alias key='true' value='Incentive Acquisition' />
              </aliases>
            </column>
