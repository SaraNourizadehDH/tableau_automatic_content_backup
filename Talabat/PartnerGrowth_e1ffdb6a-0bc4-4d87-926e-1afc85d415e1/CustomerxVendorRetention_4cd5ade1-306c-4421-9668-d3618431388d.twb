      <column caption='Unique Customer v3' datatype='integer' name='[Calculation_4056547005062021128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Lifecycle Segment&quot; THEN &#10;SUM(IF [Calculation_5278218772032127011] = &quot;Acquired in later months&quot; THEN NULL&#10;ELSEIF [Calculation_5278218772032127011] = &quot;last order before 181 days&quot; THEN NULL&#10;ELSEIF [Calculation_5278218772032127011] = &quot;Lapsed&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END)&#10;ELSEIF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Frequency Type (t)&quot;&#10;THEN SUM(&#10;IF [customer_freq_segment_0_90] = &quot;Other&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END &#10;)&#10;ELSEIF [Parameters].[Choose Split Type (copy)_4056547005048639489] = &quot;Customer Frequency Type (t-90)&quot;&#10;THEN SUM(&#10;IF [customer_freq_segment_91_181] = &quot;Other&quot; THEN -[Calculation_5278218772218581031]&#10;ELSE [Calculation_5278218772218581031] END &#10;)&#10;ELSE SUM([Calculation_5278218772218581031]) END' />
      </column>
