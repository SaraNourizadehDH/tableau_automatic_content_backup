    <worksheet name='Retention % Organic vs InOrganic'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold'>Understanding Retention by Customer Acquisition Type</run>
            <run>Æ&#10;</run>
            <run fontcolor='#e6e6e6' fontname='Tableau Semibold'>-</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='new_customer_retention' name='federated.0t924ip0uyngaq14jhqvy1uw8056' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Breakdown&quot;'>
              <calculation class='tableau' formula='&quot;No Breakdown&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t924ip0uyngaq14jhqvy1uw8056'>
            <column caption='Retention % M0' datatype='real' name='[Calculation_4910330970800316419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m0])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M1' datatype='real' name='[Calculation_4910330970800525316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([ret_m1])/SUM([monthly_active_customers]) = 0,NULL,SUM([ret_m1])/SUM([monthly_active_customers]))' />
            </column>
            <column caption='Retention % M2' datatype='real' name='[Calculation_4910330970800640005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m2])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Breakdown Type' datatype='string' name='[Calculation_919156546465050644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;No Breakdown&quot; THEN &quot;No Breakdown&quot;&#10;WHEN &quot;Organic Acquisition&quot; THEN STR([organic_acq])&#10;WHEN &quot;ADEX Acquisition&quot; THEN STR([is_adex_acq])&#10;WHEN &quot;tPro Acquisition&quot; THEN STR([tpro_acq])&#10;WHEN &quot;Incentive Acquisition&quot; THEN STR([is_incentive_acq])&#10;WHEN &quot;AAA vs Non AAA&quot; THEN STR([is_aaa_account])&#10;WHEN &quot;RKA vs Non RKA&quot; THEN STR([is_regional_key_account])&#10;END' />
            </column>
            <column caption='Retention % M3' datatype='real' name='[Retention % M2 (copy)_4910330970800824326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m3])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M4' datatype='real' name='[Retention % M3 (copy)_4910330970800865287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m4])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M6' datatype='real' name='[Retention % M4 (copy) (copy)_4910330970800918537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m6])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M5' datatype='real' name='[Retention % M4 (copy)_4910330970800906248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m5])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M7' datatype='real' name='[Retention % M6 (copy)_4910330970800996362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m7])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M10' datatype='real' name='[Retention % M7 (copy) (copy) (copy)_4910330970801061901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m10])/SUM([monthly_active_customers])' />
            </column>
            <column caption='Retention % M9' datatype='real' name='[Retention % M7 (copy) (copy)_4910330970801053708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ret_m9])/SUM([monthly_active_customers])' />
