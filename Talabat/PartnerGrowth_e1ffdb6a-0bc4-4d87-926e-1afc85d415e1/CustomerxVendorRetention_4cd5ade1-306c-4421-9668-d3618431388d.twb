    <worksheet name='Comparison Part 1 (t) 2nd'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Retention Metrics Current vs Previous Timeframe</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='new_customer_retention' name='federated.0t924ip0uyngaq14jhqvy1uw8056' />
          </datasources>
          <datasource-dependencies datasource='federated.0t924ip0uyngaq14jhqvy1uw8056'>
            <column caption='Avg. Order Frequency Retention (90 Day)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Order Frequency Retention (180 Day) (copy)_5278218771868028961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Retention Base (copy)_5278218771867201564]/[Inflow Customers (copy)_5278218771866894363]' />
            </column>
            <column caption='Orders 90 Day' datatype='integer' name='[Calculation_4056547005074014220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_90_day])' />
            </column>
            <column caption='Customers 90 Day' datatype='integer' name='[Calculation_4056547005074120718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_90_day])' />
            </column>
            <column caption='Retention (180 Day)' datatype='real' default-format='p0.00%' name='[Calculation_5278218771850293261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [Unique_Customers] END))&#10;/&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Lapsed&quot; THEN [Unique_Customers] END)&#10;)' />
            </column>
            <column caption='Avg. Order Frequency (90 Day)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5278218771863597072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_90_day])/SUM([customers_90_day])' />
            </column>
            <column caption='Outflow Customers' datatype='integer' name='[Calculation_5278218771865849878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// New + Reactivated Customers&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Lapsed&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - no order in 0 to 90 day&quot; THEN [Unique_Customers] END)&#10;)' />
            </column>
            <column caption='Orders Delta' datatype='integer' name='[Calculation_5278218771866312728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Outflow Customers (copy)_5278218771866087447] - [Inflow Customers (copy)_5278218771865399315]' />
            </column>
            <column caption='Customer Quick Ratio' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5278218771866472473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Retention (180 Day) (copy)_5278218771864186898]/[Calculation_5278218771865849878]' />
            </column>
            <column caption='Orders Delta Retention' datatype='integer' name='[Calculation_5278218771868139554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Retention Base (copy)_5278218771867201564]-[Retention Base Orders (90 Day) (copy)_5278218771867316253]' />
            </column>
            <column caption='Space 1' datatype='integer' default-format='*#,##0; -#,##0.;&quot;&quot;' name='[Calculation_5278218772229550123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(0)' />
            </column>
            <column caption='Inflow Customers Orders' datatype='integer' name='[Inflow Customers (copy)_5278218771865399315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// New + Reactivated Customers&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;New to vendor 90&quot; THEN [orders_90_day] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Reactivated&quot; THEN [orders_90_day] END)&#10;)' />
            </column>
            <column caption='Retention Base' datatype='integer' name='[Inflow Customers (copy)_5278218771866894363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [Unique_Customers] END)&#10;)' />
            </column>
            <column caption='Outflow Customers Orders' datatype='integer' name='[Outflow Customers (copy)_5278218771866087447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// New + Reactivated Customers&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Lapsed&quot; THEN [orders_91_181_day] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - no order in 0 to 90 day&quot; THEN [orders_91_181_day] END)&#10;)' />
            </column>
            <column caption='Inflow Customers' datatype='integer' name='[Retention (180 Day) (copy)_5278218771864186898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// New + Reactivated Customers&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;New to vendor 90&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Reactivated&quot; THEN [Unique_Customers] END)&#10;)' />
            </column>
            <column caption='Retention (Overall) ' datatype='real' default-format='p0.00%' name='[Retention (Type 1) Denominator (copy)_5278218771850993678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [Unique_Customers] END))&#10;/&#10;(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - no order in 0 to 90 day&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [Unique_Customers] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Lapsed&quot; THEN [Unique_Customers] END)&#10;)' />
            </column>
            <column caption='Retention Base Orders (90 Day)' datatype='integer' name='[Retention Base (copy)_5278218771867201564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot; THEN [orders_90_day] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [orders_90_day] END)&#10;)' />
            </column>
            <column caption='Retention Base Orders (180 Day)' datatype='integer' name='[Retention Base Orders (90 Day) (copy)_5278218771867316253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [customer_lifecycle_segment] = &quot;Not completed 181 days - ordered in 0 to 90 day&quot; THEN [orders_91_181_day] END)&#10;+&#10;SUM(IF [customer_lifecycle_segment] = &quot;Returning&quot; THEN [orders_91_181_day] END)&#10;)' />
