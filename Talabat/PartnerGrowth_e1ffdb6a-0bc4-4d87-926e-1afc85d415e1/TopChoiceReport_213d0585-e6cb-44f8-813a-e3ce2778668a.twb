              <zone forceUpdate='true' h='7424' id='342' type-v2='text' w='49332' x='50001' y='39706'>
                <formatted-text>
                  <run bold='true' fontsize='12' underline='true'>Next Month Forecasting:</run>
                  <run>Æ&#10;</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    Goal Reached:</run>
                  <run fontalignment='0' fontcolor='#555555'> Vendors which maintain or got promoted to Exceptional</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    Improving</run>
                  <run fontalignment='0' fontcolor='#555555'>: Vendors which went one level up. Moving from Fair to Good or Poor to Fair</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    Declining</run>
                  <run fontalignment='0' fontcolor='#555555'>: Vendors which went one level down. Moving from Good to Fair or Fair to Poor</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    No Change</run>
                  <run fontalignment='0' fontcolor='#555555'>: Vendors with same status</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    Exceptional Churn:</run>
                  <run fontalignment='0' fontcolor='#555555'> Vendors which lost Exceptional Status</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#555555'>    1-2 Default Metrics: </run>
