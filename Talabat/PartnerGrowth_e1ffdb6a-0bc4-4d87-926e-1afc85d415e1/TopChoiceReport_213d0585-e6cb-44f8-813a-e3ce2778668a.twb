      <column caption='Good Orders' datatype='real' name='[A-Order Share (copy)_804455509313605640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [overall_tier] = &quot;b&quot; THEN orders END) / SUM([orders])' />
