      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='TopChoice3-DailyLevel' id='_C95A90B1EAD240E78290E01E075AA546'>
            <properties context=''>
              <relation connection='bigquery.0f3l8x11csb62j1bv8qxt1lpby8x' name='Custom SQL Query' type='text'><![CDATA[WITH vendors AS (
  SELECT DISTINCT r.global_entity_id
    , r.vendor_id
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vri_cl_performance_report` AS r
    INNER JOIN  `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` AS v
      USING (global_entity_id, vendor_id)
    INNER JOIN UNNEST(v.delivery_types) AS delivery_type
  WHERE date_local BETWEEN "2023-11-20" AND CURRENT_DATE() - 1
    AND v.vertical_type = 'restaurants'
    AND r.global_entity_id = 'TB_AE'
    AND v.global_entity_id = 'TB_AE'
), date_range AS (
  SELECT date_local
  FROM UNNEST(GENERATE_DATE_ARRAY("2023-11-20", CURRENT_DATE() - 1)) AS date_local
), vendors_dates AS (
  SELECT DISTINCT global_entity_id
  , vendor_id
  , date_local
  FROM vendors
  CROSS JOIN date_range
), latest_aggregated_rating AS (
  SELECT ar.content.global_entity_id AS global_entity_id
   , ar.content.entity_id AS vendor_id
   , date(ar.content.timestamp, "Asia/Dubai") as date_local
   , CASE
        WHEN topics.max_rating IS NULL AND ar.content.global_entity_id <<>> 'YS_TR'
          THEN ROUND(CAST(topics.rating AS NUMERIC), 1)
        WHEN max_rating IS NULL AND ar.content.global_entity_id = 'YS_TR'
          THEN ROUND(CAST(topics.rating/2 AS NUMERIC), 1)
        WHEN max_rating IS NOT NULL AND topics.max_rating >> 0
          THEN ROUND(CAST(topics.rating/(topics.max_rating/5) AS NUMERIC), 1)
        ELSE ROUND(CAST(topics.rating AS NUMERIC), 1)
      END AS rating,
  FROM  `fulfillment-dwh-production.curated_data_shared_data_stream.aggregated_rating_update_stream` AS ar
    CROSS JOIN UNNEST(content.ratings) AS topics
  WHERE ar.content.global_entity_id = "TB_AE"--= "TB_AE"
    AND topics.topic = 'overall'
    and date(ar.timestamp, "Asia/Dubai") BETWEEN "2023-11-20" AND CURRENT_DATE() - 1
  QUALIFY ROW_NUMBER() OVER(PARTITION BY ar.content.global_entity_id, ar.content.entity_id, date(ar.timestamp, "Asia/Dubai") ORDER BY ar.timestamp DESC) = 1
), vri_cl_prepare_orders AS (
  WITH entity_timezone AS (
      SELECT * FROM  UNNEST (
              [
                  STRUCT('HF_EG' AS global_entity_id, 'Africa/Cairo' AS timezone),
      STRUCT('FP_DE' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('DJ_CZ' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('FP_SK' AS global_entity_id, 'Europe/Bratislava' AS timezone),
      STRUCT('DN_BA' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('DN_ME' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('DN_RS' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('FO_NO' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('MJM_AT' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('NP_HU' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('OP_SE' AS global_entity_id, 'Europe/Berlin' AS timezone),
      STRUCT('PZ_HR' AS global_entity_id, 'Europe/Zagreb' AS timezone),
      STRUCT('CD_GR' AS global_entity_id, 'Europe/Athens' AS timezone),
      STRUCT('EF_GR' AS global_entity_id, 'Europe/Athens' AS timezone),
      STRUCT('FP_BG' AS global_entity_id, 'Europe/Sofia' AS timezone),
      STRUCT('FP_RO' AS global_entity_id, 'Europe/Bucharest' AS timezone),
      STRUCT('PO_FI' AS global_entity_id, 'Europe/Helsinki' AS timezone),
      STRUCT('FY_CY' AS global_entity_id, 'Asia/Nicosia' AS timezone),
      STRUCT('TB_JO' AS global_entity_id, 'Asia/Amman' AS timezone),
      STRUCT('HS_BH' AS global_entity_id, 'Asia/Bahrain' AS timezone),
      STRUCT('HS_SA' AS global_entity_id, 'Asia/Riyadh' AS timezone),
      STRUCT('TB_BH' AS global_entity_id, 'Asia/Bahrain' AS timezone),
      STRUCT('TB_KW' AS global_entity_id, 'Asia/Kuwait' AS timezone),
      STRUCT('TB_QA' AS global_entity_id, 'Asia/Qatar' AS timezone),
      STRUCT('TB_SA' AS global_entity_id, 'Asia/Riyadh' AS timezone),
      STRUCT('TB_IQ' AS global_entity_id, 'Asia/Baghdad' AS timezone),
      STRUCT('TB_AE' AS global_entity_id, 'Asia/Dubai' AS timezone),
      STRUCT('TB_OM' AS global_entity_id, 'Asia/Muscat' AS timezone),
      STRUCT('YS_TR' AS global_entity_id, 'Asia/Istanbul' AS timezone),
      STRUCT('HN_DK' AS global_entity_id, 'Europe/Copenhagen' AS timezone),
          STRUCT('FP_BD' AS global_entity_id, 'Asia/Dhaka' AS timezone),
      STRUCT('FP_MM' AS global_entity_id, 'Asia/Yangon' AS timezone),
      STRUCT('FP_LA' AS global_entity_id, 'Asia/Vientiane' AS timezone),
      STRUCT('FP_KH' AS global_entity_id, 'Asia/Phnom_Penh' AS timezone),
      STRUCT('FP_TH' AS global_entity_id, 'Asia/Bangkok' AS timezone),
      STRUCT('FP_HK' AS global_entity_id, 'Asia/Hong_Kong' AS timezone),
      STRUCT('FP_MY' AS global_entity_id, 'Asia/Kuala_Lumpur' AS timezone),
      STRUCT('FP_PH' AS global_entity_id, 'Asia/Manila' AS timezone),
      STRUCT('FP_SG' AS global_entity_id, 'Asia/Singapore' AS timezone),
      STRUCT('FP_TW' AS global_entity_id, 'Asia/Taipei' AS timezone),
      STRUCT('FP_JP' AS global_entity_id, 'Asia/Tokyo' AS timezone),
      STRUCT('FP_PK' AS global_entity_id, 'Asia/Karachi' AS timezone),
          STRUCT('PY_AR' AS global_entity_id, 'America/Argentina/Buenos_Aires' AS timezone),
      STRUCT('PY_UY' AS global_entity_id, 'America/Montevideo' AS timezone),
      STRUCT('PY_BO' AS global_entity_id, 'America/La_Paz' AS timezone),
      STRUCT('PY_VE' AS global_entity_id, 'America/Caracas' AS timezone),
      STRUCT('PY_DO' AS global_entity_id, 'America/Santo_Domingo' AS timezone),
      STRUCT('PY_PR' AS global_entity_id, 'America/Puerto_Rico' AS timezone),
      STRUCT('PY_PY' AS global_entity_id, 'America/Asuncion' AS timezone),
      STRUCT('PY_CL' AS global_entity_id, 'America/Santiago' AS timezone),
      STRUCT('AP_PA' AS global_entity_id, 'America/Panama' AS timezone),
      STRUCT('CD_CO' AS global_entity_id, 'America/Bogota' AS timezone),
      STRUCT('CD_EC' AS global_entity_id, 'America/Bogota' AS timezone),
      STRUCT('CD_PE' AS global_entity_id, 'America/Bogota' AS timezone),
      STRUCT('PY_EC' AS global_entity_id, 'America/Bogota' AS timezone),
      STRUCT('PY_PA' AS global_entity_id, 'America/Panama' AS timezone),
      STRUCT('PY_PE' AS global_entity_id, 'America/Lima' AS timezone),
      STRUCT('PY_MX' AS global_entity_id, 'America/Mexico_City' AS timezone),
      STRUCT('PY_CR' AS global_entity_id, 'America/Costa_Rica' AS timezone),
      STRUCT('PY_GT' AS global_entity_id, 'America/Guatemala' AS timezone),
      STRUCT('PY_HN' AS global_entity_id, 'America/Tegucigalpa' AS timezone),
      STRUCT('PY_NI' AS global_entity_id, 'America/Managua' AS timezone),
      STRUCT('PY_SV' AS global_entity_id, 'America/El_Salvador' AS timezone)
              ]
          )
  ), orders AS (
      SELECT
          o.content.vendor.id AS vendor_id,
          o.content.global_entity_id AS global_entity_id,
          o.content.order_id AS order_id,
          -- order_value : subtotal of the items + taxes
          -- peya custom request : remove discount from order value
          CASE
              WHEN o.global_entity_id in  ('')
              THEN o.content.order.order_value - o.content.vendor.charges.discount_fee
              ELSE o.content.order.order_value
          END AS order_value,
          o.content.corporate AS corporate,
          o.content.customer.payment.payment_method AS payment_method,
          -- total_order_value : amount paid by a customer
          o.content.customer.payment.total_order_value AS total_order_value,
          o.content.customer.payment.paid AS paid,
          CASE
          -- VRI-901 : fix Yemek payment issue should be removed 06/2023
              WHEN o.content.corporate = true THEN o.content.corporate
              WHEN o.content.global_entity_id = 'YS_TR' AND o.content.customer.payment.payment_method in('yemekpay_creditcard','balance','Online Kredi/Banka Kartı','Cüzdan') THEN true
              WHEN o.content.global_entity_id = 'YS_TR' AND o.content.customer.payment.payment_method not in('yemekpay_creditcard','balance','Online Kredi/Banka Kartı','Cüzdan') THEN false
              ELSE o.content.customer.payment.paid
          END AS online,
          o.content.delivery.provider AS delivery_type,
          CASE WHEN o.content.delivery.provider ='pickup' THEN true ELSE false END AS pickup,
          ARRAY(
              SELECT AS STRUCT
                  -- some product (and parent) names have null unicode symbol which causes problem when inserted into
                  -- postgres. That is why we are removing it here
                  REPLACE(ii.name, chr(0), '') AS name,
                  REPLACE(ii.product_parent.name, chr(0), '') AS parent_name,
                  ii.quantity,
                  ii.unit_price,
                  ii.options
              FROM unnest(o.content.order.items) ii
          ) AS items,
          STRUCT(o.content.delivery.location.district, o.content.delivery.location.postal_code AS zipcode) AS location,
          o.content.place_timestamp,
          o.content.timestamp,
          ROW_NUMBER() OVER(PARTITION BY o.content.global_entity_id, o.content.vendor.id, o.content.order_id ORDER BY o.content.timestamp DESC) AS o_rn
      FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_stream` o
      WHERE true
          AND o.created_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
          AND o.created_date <<= CURRENT_DATE() - 1
          AND o.content.test_order = false
  ), latest_order AS (
      select * from orders where orders.o_rn = 1
  ), order_status_only_is_billable AS (
      SELECT
          os.global_entity_id,
          os.content.order_id,
          os.content.status,
          os.content.is_billable,
          ROW_NUMBER() OVER(PARTITION BY os.global_entity_id, os.content.order_id, os.content.status ORDER BY os.content.timestamp DESC) os_rn
      FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS os
      WHERE True
          AND os.created_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
          AND os.created_date <<= CURRENT_DATE() - 1
          AND os.metadata.source NOT IN ('rps', 'HURRIER')
  ), latest_order_status_only_is_billable AS (
      SELECT * EXCEPT(os_rn) FROM order_status_only_is_billable os WHERE os.os_rn = 1
  ), order_status AS (
          SELECT
              os.content.timestamp  AS status_message_time,
              os.content.status,
              os.global_entity_id,
              os.content.vendor.id as vendor_id,
              os.content.order_id as order_id,
              os.content.cancelled.details.owner as cancel_owner,
              os.content.cancelled.details.reason as cancel_reason,
              ARRAY_AGG(STRUCT<<status STRING, `timestamp` TIMESTAMP >>(os.content.status, os.content.timestamp))  OVER(PARTITION BY os.global_entity_id, os.content.vendor.id, os.content.order_id) as status_history,
              ROW_NUMBER() OVER(PARTITION BY os.global_entity_id, os.content.vendor.id, os.content.order_id ORDER BY os.content.timestamp DESC) os_rn
              FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS os
              Where true
                  AND os.created_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
                  AND os.created_date <<= CURRENT_DATE() - 1
  ), latest_order_status AS (
          select * from order_status where order_status.os_rn = 1
  ), curated_orders AS (
          SELECT
              o.order_id ,
              o.vendor_id ,
              o.global_entity_id ,
              o.order_value,
              o.corporate,
              o.payment_method,
              o.total_order_value,
              o.paid,
              o.online,
              o.delivery_type,
              o.pickup,
              o.items,
              o.location,
              date(o.place_timestamp, et.timezone) order_created_date,
              extract(HOUR FROM o.place_timestamp AT TIME ZONE et.timezone) order_created_hour,
              date(os.status_message_time, et.timezone)  AS status_message_date,
              date(o.timestamp, et.timezone)  AS order_message_date,
              os.status_message_time  AS status_message_ts,
              o.timestamp  AS order_message_ts,
              os.status,
              os.cancel_owner,
              os.cancel_reason,
              os_b.is_billable,
              os.status_history,
              EXISTS (SELECT 1 FROM UNNEST (os.status_history) where status in ('DISPLAYED_AT_VENDOR', 'ACCEPTED', 'EXPIRED', 'SENDING_TO_VENDOR', 'DELIVERED', 'PICKED_UP', 'SENT_TO_TRANSMISSION')) is_visible
          FROM latest_order o INNER JOIN entity_timezone et USING (global_entity_id)
          INNER JOIN latest_order_status AS os USING (global_entity_id, vendor_id, order_id)
          LEFT JOIN latest_order_status_only_is_billable AS os_b USING (global_entity_id, order_id, status)
  )
  , vendors as (
                  SELECT DISTINCT o.vendor_id , o.global_entity_id, o.order_created_date
                  FROM curated_orders AS o
                  where
                      o.order_message_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
                      OR o.status_message_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
          )

              SELECT o.* , (status='CANCELLED') is_cancelled
              FROM curated_orders o INNER JOIN vendors AS vd USING (global_entity_id, vendor_id, order_created_date)
              WHERE o.is_visible = true
), vri_cl_order_rejection_report AS (
WITH
-- ignore_orders AS (
--       -- SELECT o.order_id FROM `dhh-ncr-live.vt_vri.vt-ri-europe-v1_prepare_orders_20231030T230500`  o
--       SELECT o.order_id FROM vri_cl_prepare_orders  o
--       LEFT JOIN `dhh-ncr-live.vt_vri.normal_cancelled_vendors_rollout` vr
--           on o.vendor_id = vr.vendor_id
--       WHERE
--           vr.vendor_id is null
--           AND o.status='CANCELLED' AND o.cancel_owner != 'VENDOR'
--           AND o.global_entity_id IN ('AP_PA', 'BO_CA', 'CD_CO', 'FO_CA', 'PY_AR', 'PY_CL', 'PY_CR', 'PY_HN', 'PY_MX', 'PY_PA', 'PY_PR', 'PY_PY', 'PY_UY', 'PY_VE')
--           AND o.order_created_date  >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
--           AND o.order_created_date  <<= CURRENT_DATE() - 1
--   ),
rejections AS(
      SELECT
          o.global_entity_id ,
          o.vendor_id ,
          o.order_created_date,
          o.cancel_reason,
          COUNT(*) as total_order_count,
          COUNTIF(o.status='CANCELLED' AND o.cancel_owner='VENDOR') as rejected_order_count,
          CAST(SUM(IF(o.status='CANCELLED' AND o.cancel_owner='VENDOR',o.order_value,0)) AS NUMERIC) AS revenue_loss,
          COUNTIF(o.status IN ('DELIVERED', 'PICKED_UP', 'ACCEPTED', 'ORDER_PREPARED') AND o.delivery_type IN ('own_delivery', 'platform_delivery')) as total_own_delivery_order_delivered,
          COUNTIF(o.status IN ('DELIVERED', 'PICKED_UP', 'ACCEPTED', 'ORDER_PREPARED') AND o.delivery_type IN ('vendor_delivery', 'partner_delivery')) as total_vendor_delivery_order_delivered,
      -- FROM `dhh-ncr-live.vt_vri.vt-ri-europe-v1_prepare_orders_20231030T230500` AS o
      FROM vri_cl_prepare_orders AS o
      -- LEFT JOIN ignore_orders ON ignore_orders.order_id = o.order_id
      WHERE
      -- ignore_orders.order_id IS NULL
          -- AND
          o.is_visible = true
          AND o.order_created_date  >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
          AND o.order_created_date  <<= CURRENT_DATE() - 1
          -- AND o.global_entity_id IN ('HF_EG', 'FP_DE', 'DJ_CZ', 'FP_SK', 'DN_BA', 'DN_ME', 'DN_RS', 'FO_NO', 'MJM_AT', 'NP_HU', 'OP_SE', 'PZ_HR', 'CD_GR', 'EF_GR', 'FP_BG', 'FP_RO', 'PO_FI', 'FY_CY', 'TB_JO', 'HS_BH', 'HS_SA', 'TB_BH', 'TB_KW', 'TB_QA', 'TB_SA', 'TB_IQ', 'TB_AE', 'TB_OM', 'YS_TR', 'HN_DK')
      GROUP BY global_entity_id, vendor_id, order_created_date, cancel_reason
  )
  SELECT
      global_entity_id,
      vendor_id,
      order_created_date AS date_local,
      SUM(rejected_order_count) AS rejected_order_count,
      SUM(total_order_count) AS total_order_count,
      SUM(total_own_delivery_order_delivered) AS total_own_delivery_order_delivered,
      SUM(total_vendor_delivery_order_delivered) AS total_vendor_delivery_order_delivered,
      SUM(revenue_loss) AS revenue_loss,
      -- null instead of empty array if no rejected orders
      IF(SUM(rejected_order_count) = 0, NULL,
          ARRAY_AGG(
              -- null instead of empty object if no rejected orders
              IF(rejected_order_count = 0,
                  NULL,
                  STRUCT<<cancel_reason STRING, revenue_loss NUMERIC, rejected_order_count INT64>>
                      (cancel_reason, revenue_loss, rejected_order_count)
                ) IGNORE NULLS)
          ) AS reasons
    FROM rejections
  GROUP BY global_entity_id, vendor_id, date_local
), order_rejection AS ( --replace with daily
  SELECT r.global_entity_id
    , r.vendor_id
    , r.date_local
    , SUM(r.total_order_count) AS order_count
    , SUM(r.rejected_order_count) AS rejected_order_count
   , SUM(r.total_vendor_delivery_order_delivered) AS vendor_delivery_order_delivered
  -- FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vri_cl_order_rejection_report` AS r
  FROM vri_cl_order_rejection_report AS r
  WHERE date_local BETWEEN "2023-11-20" AND CURRENT_DATE() - 1
    AND r.global_entity_id = "TB_AE"
  GROUP BY r.global_entity_id, r.vendor_id, r.date_local
), order_delay AS ( --replace with daily
  SELECT r.global_entity_id
    , r.vendor_id
    , r.date_local
    , SUM(r.delayed_orders_count) AS delayed_orders_count
    , SUM(r.delayed_orders_denominator) AS delayed_orders_denominator
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vri_cl_preparation_time_report` AS r
  WHERE date_local BETWEEN "2023-11-20" AND CURRENT_DATE() - 1
    AND r.global_entity_id = "TB_AE"
  GROUP BY r.global_entity_id, r.vendor_id, r.date_local
), vri_cl_contact_rate_report AS (
    WITH vendor_contacts AS (
      -- we can have more than one contact per order leading to the fact that contact rate could be >>100%
    SELECT
      c.global_entity_id,
      c.vendor_id,
      c.created_date_localtime AS date_local,
      -- filters according to this spreadsheet https://docs.google.com/spreadsheets/d/1YDvqgcN9zUrDOl2d_YVo0fHXGUxUXvvx6dtKmrB9JWs/edit#gid=0
      COUNT(
        IF(
          (global_cr_code in ('2H.2','2H.1','2C.6','2C.4','2C.2','2C.5','2A.1','2C.1','2A.2','2C.8','2A.4','2B.1','2A.3','1B.2','1A.14','2D.4','2D.2','2D.3','2D.1','1A.1','1A.2','1A.15','1A.13','1A.12','1A.4','1C.5','1C.1') and delivery_type = 'Vendor Delivery')
          OR
          (global_cr_code in ('2H.1','2C.6','2C.4','2C.2','2A.2','2C.8','2A.4','2B.1','2A.3') and delivery_type in ('Own Delivery', 'Pick-Up'))
          , c.contact_id
          , NULL
        )
      ) AS cnt_contacts_received,
      COUNT(DISTINCT CASE
            WHEN ((c.delivery_type = 'Vendor Delivery' AND c.contact_reason_l3 IN ('Spilled food', 'Damaged item', 'Food temperature'))
              OR (c.contact_reason_l3 IN ('Wrong item', 'Wrong order', 'Missing item', 'Expired Item', 'Food portion', 'Food quality', 'Foreign Object', 'Food poisoning')))
            THEN c.contact_id
          END
        ) AS cnt_customer_contacts_received,
      COUNT(DISTINCT CASE
            WHEN (c.delivery_type = 'Own Delivery' AND c.contact_reason_l3 IN ('Complaint about severe delay', 'Extreme Delay', 'Moderate Delay', 'Severe Delay', 'Short Delay', 'Check order status', 'Complain about late order', 'Complaint about extreme delay', 'Complaint about moderate delay', 'Complaint about short delay'))
            THEN c.contact_id
          END
        ) AS cnt_own_delivery_vendor_delay_contacts_received,
      COUNT(DISTINCT CASE
            WHEN (c.delivery_type = 'Vendor Delivery' AND c.contact_reason_l3 IN ('Complaint about severe delay', 'Extreme Delay', 'Moderate Delay', 'Severe Delay', 'Short Delay', 'Check order status', 'Complain about late order', 'Complaint about extreme delay', 'Complaint about moderate delay', 'Complaint about short delay'))
            THEN c.contact_id
          END
        ) AS cnt_vendor_delivery_vendor_delay_contacts_received
    FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` c
    WHERE c.created_date >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
        AND c.created_date <<= CURRENT_DATE() - 1
        -- AND c.global_entity_id IN ('HF_EG', 'FP_DE', 'DJ_CZ', 'FP_SK', 'DN_BA', 'DN_ME', 'DN_RS', 'FO_NO', 'MJM_AT', 'NP_HU', 'OP_SE', 'PZ_HR', 'CD_GR', 'EF_GR', 'FP_BG', 'FP_RO', 'PO_FI', 'FY_CY', 'TB_JO', 'HS_BH', 'HS_SA', 'TB_BH', 'TB_KW', 'TB_QA', 'TB_SA', 'TB_IQ', 'TB_AE', 'TB_OM', 'YS_TR', 'HN_DK')
        AND c.created_date_localtime >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
        AND c.created_date_localtime <<= CURRENT_DATE() - 1
    GROUP BY c.global_entity_id, c.vendor_id, c.created_date_localtime
  ), vendor_orders AS (
  SELECT
    o.entity_id AS global_entity_id,
    o.vendor_code AS vendor_id,
    DATE(o.created_at, o.timezone) AS date_local,
    COUNT(DISTINCT o.order_code) AS cnt_orders_received,
  FROM `fulfillment-dwh-production.curated_data_shared.orders_v2` o
  WHERE o.created_date >>= DATE_SUB(DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH), INTERVAL 1 DAY)
    AND o.created_date <<= DATE_ADD(CURRENT_DATE() - 1, INTERVAL 1 DAY)
    AND DATE(o.created_at, o.timezone) >>= DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH)
    AND DATE(o.created_at, o.timezone) <<= CURRENT_DATE() - 1
  GROUP BY o.entity_id, o.vendor_code, DATE(o.created_at, o.timezone)
  )
  SELECT
      vc.global_entity_id,
      vc.vendor_id,
      vc.date_local,
      vc.cnt_contacts_received,
      vc.cnt_customer_contacts_received,
      vc.cnt_own_delivery_vendor_delay_contacts_received,
      vc.cnt_vendor_delivery_vendor_delay_contacts_received,
  FROM vendor_contacts vc
  GROUP BY vc.global_entity_id, vc.vendor_id, vc.date_local, vc.cnt_contacts_received, vc.cnt_customer_contacts_received, vc.cnt_own_delivery_vendor_delay_contacts_received, vc.cnt_vendor_delivery_vendor_delay_contacts_received
), contact AS (
  SELECT c.global_entity_id
    , c.vendor_id
    , c.date_local
    , SUM(c.cnt_customer_contacts_received) AS customer_contacts
    , SUM(c.cnt_vendor_delivery_vendor_delay_contacts_received) AS vendor_delivery_vendor_delay_contacts
  -- FROM `dhh-ncr-live.vt_vri.vri_cl_contact_rate_report` AS c
  FROM vri_cl_contact_rate_report AS c
  WHERE date_local BETWEEN "2023-11-20" AND CURRENT_DATE() - 1
    AND c.global_entity_id = "TB_AE"
  GROUP BY c.global_entity_id, c.vendor_id, c.date_local
), order_delay_historical AS (
  SELECT pt.global_entity_id
    , SUM(pt.delayed_orders_count) AS entity_delayed_orders_count
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.vri_cl_preparation_time_report` AS pt
  WHERE date_local BETWEEN DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH) AND CURRENT_DATE() - 1
    AND pt.global_entity_id = "TB_AE"
  GROUP BY pt.global_entity_id
), own_delivery_delay_contact_historical AS (
  SELECT c.global_entity_id
    , SUM(c.cnt_own_delivery_vendor_delay_contacts_received) AS entity_own_delivery_vendor_delay_contacts_received
  -- FROM `dhh-ncr-live.vt_vri.vri_cl_contact_rate_report` AS c
  FROM vri_cl_contact_rate_report AS c
  WHERE date_local BETWEEN DATE_SUB(DATE_TRUNC("2023-11-20", MONTH), INTERVAL 2 MONTH) AND CURRENT_DATE() - 1
    AND c.global_entity_id = "TB_AE"
  GROUP BY c.global_entity_id
), metrics AS (
  SELECT DISTINCT v.global_entity_id
    , v.vendor_id
    , v.date_local
    -- , IF(p.vendor_markup_flag IS NOT NULL, FALSE, TRUE) AS price_parity
    -- , IFNULL(SAFE_DIVIDE(total_images, total_products), 0) AS picture_coverage_percentage
    , IFNULL(r.rating, 0) AS rating --done
    -- , IFNULL(SAFE_DIVIDE(od.offline_duration, od.scheduled_duration), 0) AS offline_rate
    , IFNULL(o.order_count, 0) AS orders --done
    , IFNULL(SAFE_DIVIDE(o.rejected_order_count, o.order_count), 0) AS rejection_rate --done
    , IFNULL(SAFE_DIVIDE(c.customer_contacts, o.order_count), 0) AS inaccurate_orders_rate
    , IFNULL(SAFE_DIVIDE(
        ( -- delay rate numerator
          IFNULL(d.delayed_orders_count, 0)
          + LEAST(
              IFNULL(c.vendor_delivery_vendor_delay_contacts, 0) -- VD late contacts, deafulted to 0 if missing (to remove impact on delay rate)
              * IFNULL(SAFE_DIVIDE(odoh.entity_delayed_orders_count, odch.entity_own_delivery_vendor_delay_contacts_received), 1) -- Delay factor, defaulted to 1 if missing (for multiplication ease)
              , IFNULL(o.vendor_delivery_order_delivered, 0)
          ) -- Least value between "number of VD successful orders" and "delay factor added contacts" since "delay factor added contacts" can be higher than "number of VD delivered orders" due to the factor being high (i.e. OD contact rate is low)
        )
        , ( -- delay rate denominator
          IFNULL(d.delayed_orders_denominator, 0)
          + IFNULL(IF(c.vendor_delivery_vendor_delay_contacts >> 0, o.vendor_delivery_order_delivered, 0), 0) -- VD successful orders is only added to denominator if the vendor had VD delay contacts as well
        )
      ), 0) AS order_delay_rate
  FROM vendors_dates AS v
    -- LEFT JOIN price_parity AS p
    --   USING (global_entity_id, vendor_id)
    -- LEFT JOIN picture_coverage_rate AS pc
    --   USING (global_entity_id, vendor_id)
    LEFT JOIN latest_aggregated_rating AS r --done
      USING (global_entity_id, vendor_id, date_local)
    -- LEFT JOIN offline_duration AS od
    --   USING (global_entity_id, vendor_id)
    LEFT JOIN order_rejection AS o --done
      USING (global_entity_id, vendor_id, date_local)
    LEFT JOIN order_delay AS d --done
      USING (global_entity_id, vendor_id, date_local)
    LEFT JOIN contact AS c --done
      USING (global_entity_id, vendor_id, date_local)
    LEFT JOIN order_delay_historical AS odoh
      USING (global_entity_id) --done
    LEFT JOIN own_delivery_delay_contact_historical AS odch
      USING (global_entity_id) --done
)


SELECT m.*,i.account_manager_name,i.vendor_name,i.is_kitchen,k.type
FROM metrics m
JOIN `tlb-data-dev.data_platform.dim_vendor_info` i
ON SAFE_CAST(m.vendor_id AS INT64)= i.vendor_id
LEFT JOIN
(SELECT
  DISTINCT v.vendor_id,
IF(key_account_sub_category__c IS NULL, 'Non KA', key_account_sub_category__c) AS type,
FROM `tlb-data-prod.data_platform.dim_vendor_info` v
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
ON v.salesforce_id = a.grid__c
and (a.global_entity_id LIKE 'TB%' OR a.global_entity_id = 'HF_EG')) as k
ON SAFE_CAST(m.vendor_id AS INT64)=k.vendor_id
WHERE account_manager_name Is not null]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
