      <column caption='Exceptional Vendors' datatype='integer' name='[A Vendors % (copy)_804455510343311374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [overall_tier] = &quot;a&quot; THEN [vendor_id] END)' />
