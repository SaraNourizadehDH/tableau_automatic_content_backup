      <aliases enabled='yes' />
      <column caption='Metric' datatype='string' name='[Calculation_804455510895943727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &apos;vCR %&apos; THEN STR([Calculation_804455511059935282])&#13;&#10;  WHEN &apos;Delay Rate %&apos; THEN STR([vFR % (copy)_804455511062917172]) &#13;&#10;  WHEN &apos;Orders&apos; THEN STR([orders])&#13;&#10;  WHEN &apos;Ratings&apos; THEN STR([vCR % (copy)_804455511070015542])&#13;&#10;  WHEN &apos;vFR %&apos; THEN STR([vCR % (copy)_804455511062552627])&#13;&#10;END' />
      </column>
      <column caption='vCR %' datatype='string' name='[Calculation_804455511059935282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([inaccurate_orders_rate] * 100, 0)) + &apos;%&apos;' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='TopChoice3-DailyLevel' datatype='table' name='[__tableau_internal_object_id__].[_C95A90B1EAD240E78290E01E075AA546]' role='measure' type='quantitative' />
      <column caption='AM' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
      <column caption='vCR' datatype='real' name='[inaccurate_orders_rate]' role='measure' type='quantitative' />
      <column caption='Is Kitchen' datatype='boolean' name='[is_kitchen]' role='dimension' type='nominal' />
      <column caption='Delay Rate' datatype='real' name='[order_delay_rate]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Orders' datatype='integer' name='[orders]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='Rating' datatype='real' name='[rating]' role='dimension' type='ordinal' />
      <column caption='vFR' datatype='real' name='[rejection_rate]' role='measure' type='quantitative' />
      <column caption='vFR %' datatype='string' name='[vCR % (copy)_804455511062552627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([rejection_rate] * 100, 0)) + &apos;%&apos;' />
      </column>
      <column caption='Ratings' datatype='string' name='[vCR % (copy)_804455511070015542]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([rating],0))' />
      </column>
      <column caption='Delay Rate % ' datatype='string' name='[vFR % (copy)_804455511062917172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([order_delay_rate] * 100, 0)) + &apos;%&apos;' />
      </column>
      <column caption='Vendor ID' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
