    <datasource caption='TopChoice 1' inline='true' name='federated.0lxoj7e05sepkb11ajvf21kih4ty' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0a2sbzf0z86sti11dr4h01qr2s20'>
            <connection CATALOG='publicdata' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='' username='muhammad.afzal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
