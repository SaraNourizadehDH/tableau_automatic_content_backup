      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='TopChoice2' id='_D233119377C34DCEAE1EE7C655151992'>
            <properties context=''>
              <relation connection='bigquery.1ltvb7h0pndrcx1dhs6hh0sbyk4n' name='Custom SQL Query' type='text'>SELECT t.*,k.type&#13;
FROM `tlb-data-dev.data_playground.agg_tstar_daily_tiers` t&#13;
LEFT JOIN &#13;
&#13;
(SELECT&#13;
  DISTINCT v.vendor_id,&#13;
IF(key_account_sub_category__c IS NULL, &apos;Non KA&apos;, key_account_sub_category__c) AS type,&#13;
FROM `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a&#13;
ON v.salesforce_id = a.grid__c&#13;
and (a.global_entity_id LIKE &apos;TB%&apos; OR a.global_entity_id = &apos;HF_EG&apos;)) as k&#13;
&#13;
ON&#13;
&#13;
t.vendor_id=k.vendor_id&#13;
&#13;
&#13;
WHERE country_iso = &quot;AE&quot;&#13;
AND overall_tier != &quot;not_eligible&quot;&#13;
AND date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH)&#13;
AND SAFE_CAST(date as string) IN &#13;
(&apos;2023-01-31&apos;,&apos;2023-02-28&apos;,&apos;2023-03-31&apos;,&apos;2023-04-30&apos;,&apos;2023-05-31&apos;,&apos;2023-06-30&apos;,&apos;2023-07-31&apos;,&apos;2023-08-31&apos;,&apos;2023-09-30&apos;,&apos;2023-10-31&apos;,&apos;2023-11-30&apos;,&apos;2023-12-31&apos;,&apos;2024-01-31&apos;,&apos;2024-02-29&apos;,&apos;2024-03-31&apos;,&apos;2024-04-30&apos;,&apos;2024-05-31&apos;,&apos;2024-06-30&apos;,&apos;2024-07-31&apos;,&apos;2024-08-31&apos;,&apos;2024-09-30&apos;,&apos;2024-10-31&apos;,&apos;2024-11-30&apos;,&apos;2024-12-31&apos;)&#13;
ORDER BY 1</relation>
            </properties>
