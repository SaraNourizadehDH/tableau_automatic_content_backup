        <calculation class='tableau' formula='CASE [last_month_tier]&#13;&#10;  WHEN &apos;a&apos; THEN &apos;Exceptional&apos;&#13;&#10;  WHEN &apos;b&apos; THEN &apos;Good&apos;&#13;&#10;  WHEN &apos;c&apos; THEN &apos;Fair&apos;&#13;&#10;  WHEN &apos;d&apos; THEN &apos;Poor&apos;&#13;&#10;  ELSE &apos;-&apos;&#13;&#10;END' />
