            <column caption='Show Up For Renewal' datatype='string' name='[Parameter 4 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Value&quot;'>
              <calculation class='tableau' formula='&quot;Value&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.159h8zz0lxcrof18mer7e1q11ip8'>
            <column caption='AFV' datatype='real' name='[Calculation_1381760723820748801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_lc]/[total_orders]' />
            </column>
            <column caption='All Churners %' datatype='real' name='[Calculation_1381760723821342725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [churned]=1 then [account_id] else null end)&#13;&#10;/&#13;&#10;countd([account_id])' />
            </column>
            <column caption='Plan Type' datatype='string' name='[Calculation_1381760723821645831]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [prev_planid]  &#13;&#10;WHEN 16 then &apos;1 Month AE&apos;&#13;&#10;WHEN 22 then &apos;6 Months AE&apos;&#13;&#10;WHEN 23 then &apos;12 Months AE&apos;&#13;&#10;WHEN 21 then &apos;Free Coffee AE&apos;&#13;&#10;WHEN 26 then &apos;Pizza 3 Months AE&apos;&#13;&#10;WHEN 27 then &apos;Pizza 6 Months AE&apos;&#13;&#10;WHEN 19 then &apos;1 Month KW&apos;&#13;&#10;WHEN 24 then &apos;6 Months KW&apos;&#13;&#10;WHEN 25 then &apos;1 Month QA&apos; &#13;&#10;WHEN 33 then &apos;12 Month BH&apos;&#13;&#10;WHEN 29 then &apos;1 Month BH&apos;&#13;&#10;WHEN 28 then &apos;12 Month QA&apos;&#13;&#10;WHEN 37 then &apos;1 Month JO&apos;&#13;&#10;WHEN 38 then &apos;12 Month JO&apos;&#13;&#10;WHEN 39 then &apos;1 Month OM&apos;&#13;&#10;WHEN 40 then &apos;12 Month OM&apos;&#13;&#10;END' />
            </column>
            <column caption='Invol Churners %' datatype='real' name='[Calculation_1381760723821989896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [churned]=1 and [vol_churn]=0 then [account_id] else null end)&#13;&#10;/&#13;&#10;countd([account_id])' />
            </column>
            <column caption='Up for Renewal Cal' datatype='real' name='[Calculation_1381760723822235657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4 2] when &apos;Percent&apos; then COUNT([account_id]) / TOTAL(COUNT([account_id])) else COUNT([account_id]) end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vol Churners %' datatype='real' name='[Calculation_1381760723822387210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [vol_churn]=1 then [account_id] else null end)&#13;&#10;/&#13;&#10;countd([account_id])' />
            </column>
            <column caption='AFV Bucket' datatype='string' name='[Calculation_1381760723824078859]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [Calculation_1381760723820748801] &lt;=4 or ISNULL([Calculation_1381760723820748801]) then &apos;0-4&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=5 then &apos;4-5&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=7 then &apos;5-7&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;7 then &apos;7+&apos; &#13;&#10;     else null end )&#13;&#10;    when &apos;AE&apos; then&#13;&#10;    (if [Calculation_1381760723820748801] &lt;=30 or ISNULL([Calculation_1381760723820748801]) then &apos;0-30&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=40 then &apos;31-40&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=60 then &apos;41-60&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;60 then &apos;60+&apos; &#13;&#10;     else null end )&#13;&#10;    when &apos;QA&apos; then&#13;&#10;    (if [Calculation_1381760723820748801] &lt;=30 or ISNULL([Calculation_1381760723820748801]) then &apos;0-30&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=40 then &apos;31-40&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=60 then &apos;41-60&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;60 then &apos;60+&apos; &#13;&#10;     else null end )&#13;&#10;    when &apos;BH&apos; then&#13;&#10;    (if [Calculation_1381760723820748801] &lt;=2 or ISNULL([Calculation_1381760723820748801]) then &apos;0-2&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=3 then &apos;3-4&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=4 then &apos;4-5&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;5 then &apos;5+&apos; &#13;&#10;     else null end )&#13;&#10;    when &apos;JO&apos; then&#13;&#10;    (if [Calculation_1381760723820748801] &lt;=2 or ISNULL([Calculation_1381760723820748801]) then &apos;0-2&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=3 then &apos;3-4&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=4 then &apos;4-5&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;5 then &apos;5+&apos; &#13;&#10;     else null end )&#13;&#10;    &#13;&#10;   &#13;&#10;else &#13;&#10;    (if [Calculation_1381760723820748801] &lt;=40 or ISNULL([Calculation_1381760723820748801]) then &apos;0-40&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723820748801]&lt;=60 then &apos;41-60&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801]&lt;=90 then &apos;61-90&apos;&#13;&#10;     ELSEIF [Calculation_1381760723820748801] &gt;90 then &apos;90+&apos; &#13;&#10;     else null end )&#13;&#10;END' />
            </column>
            <column caption='KPI' datatype='string' name='[Calculation_1381760723824820238]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 3]=&apos;Orders&apos; then [Calculation_1381760723825303568] &#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;AFV&apos; then [Calculation_1381760723824078859]&#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Pro Orders&apos; then [Calculation_1381760723825606675] &#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Pro Restaurant Orders&apos; then [Calculation_1381760723825704980] &#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Ratings&apos; then [Calculation_1381760723825807381] &#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Savings&apos; then [Calculation_1381760723825897494]&#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Tenure&apos; then [Calculation_1381760723826540569]&#13;&#10;ELSEIF [Parameters].[Parameter 1 3]=&apos;Segment&apos; then [Calculation_1381760723826384919] &#13;&#10;else null end' />
            </column>
            <column caption='Last3M Filter' datatype='boolean' name='[Calculation_1381760723825074191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;, [date]) &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;, today()-1)) &#13;&#10;and DATETRUNC(&apos;month&apos;, [date]) &lt;= date(DATETRUNC(&apos;month&apos;, today()))&#13;&#10;then true else false end' />
            </column>
            <column caption='Orders Bucket' datatype='string' name='[Calculation_1381760723825303568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [total_orders]&gt;=0 and [total_orders] &lt;=4 then &quot;0-4&quot;&#13;&#10;ELSEIF  [total_orders]&gt;=5 and [total_orders] &lt;=9 then &quot;5-9&quot;&#13;&#10;ELSEIF  [total_orders]&gt;=10 and [total_orders] &lt;=14 then &quot;10-14&quot;&#13;&#10;ELSEIF  [total_orders]&gt;=15 and [total_orders] &lt;=19 then &quot;15-19&quot;&#13;&#10;ELSEIF  [total_orders] &gt;=20 THEN &quot;20+&quot; END&#13;&#10;//case [Country] when &apos;KW&apos; then&#13;&#10;  //  (if [Total Orders] &gt;=0 and [Total Orders]&lt;=6 then &apos;0-6&apos;&#13;&#10;    // ELSEIF  [Total Orders] &gt;=7 and [Total Orders]&lt;=12 then &apos;7-12&apos;&#13;&#10;     //ELSEIF [Total Orders] &gt;=13 and [Total Orders]&lt;=21 then &apos;13-21&apos;&#13;&#10;     //ELSEIF [Total Orders] &gt;21 then &apos;22+&apos;&#13;&#10;     //else null end )&#13;&#10;//else&#13;&#10;  //  (if [Total Orders] &gt;=0 and [Total Orders]&lt;=5 then &apos;0-5&apos;&#13;&#10;    // ELSEIF  [Total Orders] &gt;=6 and [Total Orders]&lt;=10 then &apos;6-10&apos;&#13;&#10;     //ELSEIF [Total Orders] &gt;=11 and [Total Orders]&lt;=20 then &apos;11-20&apos;&#13;&#10;     //ELSEIF [Total Orders] &gt;20 then &apos;21+&apos;&#13;&#10;     //else null end )&#13;&#10;//end' />
            </column>
            <column caption='Pro Orders Bucket' datatype='string' name='[Calculation_1381760723825606675]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [pro_orders] &gt;=0 and [pro_orders]&lt;=1 then &apos;0-1 orders&apos;&#13;&#10;     ELSEIF  [pro_orders] &gt;=2 and [pro_orders]&lt;=3 then &apos;2-3 orders&apos;&#13;&#10;     ELSEIF [pro_orders] &gt;=4 and [pro_orders]&lt;=9 then &apos;4-9 orders&apos;&#13;&#10;     ELSEIF [pro_orders] &gt;9 then &apos;10+ orders&apos; &#13;&#10;     else null end )&#13;&#10;else&#13;&#10;    (if [pro_orders] &gt;=0 and [pro_orders]&lt;=2 then &apos;0-2 orders&apos;&#13;&#10;     ELSEIF  [pro_orders] &gt;=3 and [pro_orders]&lt;=5 then &apos;3-5 orders&apos;&#13;&#10;     ELSEIF [pro_orders] &gt;=6 and [pro_orders]&lt;=10 then &apos;6-10 orders&apos;&#13;&#10;     ELSEIF [pro_orders] &gt;10 then &apos;11+ orders&apos; &#13;&#10;     else null end )&#13;&#10;    &#13;&#10;end' />
            </column>
            <column caption='Pro Rest Orders Bucket' datatype='string' name='[Calculation_1381760723825704980]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [orders_pro_restaurants] &gt;=0 and [orders_pro_restaurants]&lt;=1 then &apos;0-1 orders&apos;&#13;&#10;     ELSEIF  [orders_pro_restaurants] &gt;=2 and [orders_pro_restaurants]&lt;=5 then &apos;2-5 orders&apos;&#13;&#10;     ELSEIF [orders_pro_restaurants] &gt;=6 and [orders_pro_restaurants]&lt;=10 then &apos;6-10 orders&apos;&#13;&#10;     ELSEIF [orders_pro_restaurants] &gt;10 then &apos;11+ orders&apos; &#13;&#10;     else null end )&#13;&#10;else&#13;&#10;    (if [orders_pro_restaurants] &gt;=0 and [orders_pro_restaurants]&lt;=3 then &apos;0-3 orders&apos;&#13;&#10;     ELSEIF  [orders_pro_restaurants] &gt;=4 and [orders_pro_restaurants]&lt;=6 then &apos;4-6 orders&apos;&#13;&#10;     ELSEIF [orders_pro_restaurants] &gt;=7 and [orders_pro_restaurants]&lt;=13 then &apos;7-13 orders&apos;&#13;&#10;     ELSEIF [orders_pro_restaurants] &gt;13 then &apos;14+ orders&apos; &#13;&#10;     else null end )&#13;&#10;    &#13;&#10;end' />
            </column>
            <column caption='Ratings Bucket' datatype='string' name='[Calculation_1381760723825807381]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([avg_rating]) then &apos;No Ratings&apos;&#13;&#10;elseif [avg_rating]&gt;=0 and [avg_rating]&lt;=3 then &apos;0-3&apos;&#13;&#10;elseif [avg_rating]&gt;3 and [avg_rating]&lt;=4 then &apos;3-4&apos;&#13;&#10;else &apos;4+&apos;&#13;&#10;end' />
            </column>
            <column caption='Savings Bucket' datatype='string' name='[Calculation_1381760723825897494]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [pro_savings] &lt;=1 or ISNULL([Calculation_1381760723820748801]) then &apos;0-1&apos;&#13;&#10;     ELSEIF  [pro_savings]&lt;=3 then &apos;2-3&apos;&#13;&#10;     ELSEIF [pro_savings]&lt;=6 then &apos;4-6&apos;&#13;&#10;     ELSEIF [pro_savings] &gt;6 then &apos;6+&apos; &#13;&#10;     else null end )&#13;&#10;else&#13;&#10;    (if [pro_savings] &lt;=10 or ISNULL([Calculation_1381760723820748801]) then &apos;0-10&apos;&#13;&#10;     ELSEIF  [pro_savings]&lt;=30 then &apos;11-30&apos;&#13;&#10;     ELSEIF [pro_savings]&lt;=70 then &apos;31-70&apos;&#13;&#10;     ELSEIF [pro_savings] &gt;70 then &apos;70+&apos; &#13;&#10;     else null end )    &#13;&#10;    &#13;&#10;end' />
            </column>
            <column caption='Segment Bucket' datatype='string' name='[Calculation_1381760723826384919]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [total_orders]&gt;=8 and [Calculation_1381760723820748801] &gt;=4.5  then &apos;Segment A&apos;&#13;&#10;     ELSEIF  ((([total_orders]&gt;=5 and [total_orders]&lt;8)  and [Calculation_1381760723820748801] &gt;=4.5 ) or ([total_orders]&gt;=8 and ([Calculation_1381760723820748801]&gt;= 3.5 and [Calculation_1381760723820748801]&lt;=4.5))) then &apos;Segment B&apos;&#13;&#10;     ELSE &apos;Segment C&apos;  end )&#13;&#10;when &apos;AE&apos; then&#13;&#10;    (if [total_orders]&gt;=8 and [Calculation_1381760723820748801] &gt;=30  then &apos;Segment A&apos;&#13;&#10;     ELSEIF  ((([total_orders]&gt;=5 and [total_orders]&lt;8)  and [Calculation_1381760723820748801] &gt;=30 ) or ([total_orders]&gt;=8 and ([Calculation_1381760723820748801]&gt;= 20 and [Calculation_1381760723820748801]&lt;=30))) then &apos;Segment B&apos;&#13;&#10;     ELSE &apos;Segment C&apos; end)&#13;&#10;else &#13;&#10;    (if [total_orders]&gt;=7 and [Calculation_1381760723820748801] &gt;=60  then &apos;Segment A&apos;&#13;&#10;     ELSEIF  ((([total_orders]&gt;=5 and [total_orders]&lt;6)  and [Calculation_1381760723820748801] &gt;=60 ) or ([total_orders]&gt;=7 and ([Calculation_1381760723820748801]&gt;= 40 and [Calculation_1381760723820748801]&lt;=60))) then &apos;Segment B&apos;&#13;&#10;     ELSE &apos;Segment C&apos;  end)&#13;&#10;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Tenure Bucket' datatype='string' name='[Calculation_1381760723826540569]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [country] when &apos;KW&apos; then &#13;&#10;    (if [Calculation_1381760723826884634] &lt;=15 or ISNULL([Calculation_1381760723820748801]) then &apos;0-15 days&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723826884634]&lt;=60 then &apos;16-60 days&apos;&#13;&#10;     ELSEIF [Calculation_1381760723826884634]&lt;=1600 then &apos;61-1600 days&apos;&#13;&#10;     ELSEIF [Calculation_1381760723826884634] &gt;1600 then &apos;1600 days&apos; &#13;&#10;     else null end )&#13;&#10;else&#13;&#10;    (if [Calculation_1381760723826884634] &lt;=15 or ISNULL([Calculation_1381760723820748801]) then &apos;0-15 days&apos;&#13;&#10;     ELSEIF  [Calculation_1381760723826884634]&lt;=30 then &apos;16-30 days&apos;&#13;&#10;     ELSEIF [Calculation_1381760723826884634]&lt;=60 then &apos;31-60 days&apos;&#13;&#10;     ELSEIF [Calculation_1381760723826884634] &gt;60 then &apos;60+ days&apos; &#13;&#10;     else null end )    &#13;&#10;    &#13;&#10;end' />
            </column>
            <column caption='Tenure' datatype='integer' name='[Calculation_1381760723826884634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[up_for_renewal_date]-[first_order_date]' />
