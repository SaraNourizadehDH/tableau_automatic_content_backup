      <aliases enabled='yes' />
      <column caption='Churn Status' datatype='string' name='[Calculation_1344324513509486598]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [vol_churn] =0 then &apos;Involuntary Churn&apos; else &apos;Voluntary Churn&apos; end' />
      </column>
      <column caption='Plan Type' datatype='string' name='[Calculation_1344324513518448647]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [prev_planid] &#13;&#10;WHEN 16 then &apos;1 Month AE&apos;&#13;&#10;WHEN 22 then &apos;6 Months AE&apos;&#13;&#10;WHEN 23 then &apos;12 Months AE&apos;&#13;&#10;WHEN 21 then &apos;Free Coffee AE&apos;&#13;&#10;WHEN 26 then &apos;Pizza 3 Months AE&apos;&#13;&#10;WHEN 27 then &apos;Pizza 6 Months AE&apos;&#13;&#10;WHEN 19 then &apos;1 Month KW&apos;&#13;&#10;WHEN 24 then &apos;6 Months KW&apos;&#13;&#10;WHEN 25 then &apos;1 Month QA&apos; &#13;&#10;WHEN 33 then &apos;12 Month BH&apos;&#13;&#10;WHEN 29 then &apos;1 Month BH&apos;&#13;&#10;WHEN 28 then &apos;12 Month QA&apos;&#13;&#10;WHEN 37 then &apos;1 Month JO&apos;&#13;&#10;WHEN 38 then &apos;12 Month JO&apos;&#13;&#10;WHEN 39 then &apos;1 Month OM&apos;&#13;&#10;WHEN 40 then &apos;12 Month OM&apos;&#13;&#10;END' />
      </column>
