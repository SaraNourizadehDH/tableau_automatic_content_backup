      <aliases enabled='yes' />
      <column caption='All Transactions' datatype='integer' name='[AllTransactions]' role='measure' type='quantitative' />
      <column caption='SuccessRate' datatype='real' name='[Calculation_1264667103651069952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_transactions])/sum([AllTransactions])' />
      </column>
      <column caption='subscription_state_mod' datatype='string' name='[Calculation_1264667103653117953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if LOWER([subscription_state]) in (&apos;free trial&apos;,&apos;free&apos;) then &apos;Free Trial/Free&apos;&#13;&#10;ELSEIF  lower([subscription_state]) in (&apos;grace period&apos;,&apos;billing retry&apos;) then &apos;Grace Period/Billing Retry&apos;&#13;&#10;else [subscription_state] end' />
      </column>
      <column caption='Card_Calc' datatype='string' name='[Calculation_1264667103710064649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF lower([card_wallet_type]) = &apos;apple pay&apos; then &apos;Apple Pay&apos; else [card_type] end' />
      </column>
      <column caption='date filter' datatype='boolean' name='[Calculation_1450159114411126784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [date]&lt;TODAY() then TRUE else FALSE end' />
      </column>
      <column caption='FailedTransactions_Day (copy)' datatype='integer' name='[FailedTransactions_Day (copy)_1264667103706988550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date]:SUM([failed_transactions])}' />
      </column>
      <column caption='FailedRate' datatype='real' name='[SuccessRate (copy) (copy)_1264667103659880451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_transactions])/sum([AllTransactions])' />
      </column>
      <column caption='PendingRate' datatype='real' name='[SuccessRate (copy)_1264667103659868162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pending_transactions])/sum([AllTransactions])' />
      </column>
      <column caption='FailedTransactions_DayCountry' datatype='integer' name='[SuccessRate (copy)_1264667103703486469]' role='measure' type='quantitative'>
