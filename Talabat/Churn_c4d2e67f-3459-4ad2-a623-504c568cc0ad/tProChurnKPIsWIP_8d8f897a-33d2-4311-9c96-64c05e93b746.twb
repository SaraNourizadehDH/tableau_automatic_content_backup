            <column caption='Iso Date' datatype='date' name='[iso_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1693916450267992072]' derivation='None' name='[none:Calculation_1693916450267992072:ok]' pivot='key' type='ordinal' />
