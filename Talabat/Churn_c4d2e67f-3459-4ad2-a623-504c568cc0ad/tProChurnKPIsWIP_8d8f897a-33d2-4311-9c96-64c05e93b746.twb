    <worksheet name='BQ-ChurnOverTime (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ed7d31' fontsize='18'>% Churn Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_deepdive_all (data_playground)' name='federated.1lwdrtp16elu3x115maj818jjbkb' />
            <datasource caption='agg_tpro_churn_segments (data_platform)' name='federated.159h8zz0lxcrof18mer7e1q11ip8' />
          </datasources>
          <datasource-dependencies datasource='federated.159h8zz0lxcrof18mer7e1q11ip8'>
            <column caption='Plan Type' datatype='string' name='[Calculation_1381760723821645831]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [prev_planid]  &#13;&#10;WHEN 16 then &apos;1 Month AE&apos;&#13;&#10;WHEN 22 then &apos;6 Months AE&apos;&#13;&#10;WHEN 23 then &apos;12 Months AE&apos;&#13;&#10;WHEN 21 then &apos;Free Coffee AE&apos;&#13;&#10;WHEN 26 then &apos;Pizza 3 Months AE&apos;&#13;&#10;WHEN 27 then &apos;Pizza 6 Months AE&apos;&#13;&#10;WHEN 19 then &apos;1 Month KW&apos;&#13;&#10;WHEN 24 then &apos;6 Months KW&apos;&#13;&#10;WHEN 25 then &apos;1 Month QA&apos; &#13;&#10;WHEN 33 then &apos;12 Month BH&apos;&#13;&#10;WHEN 29 then &apos;1 Month BH&apos;&#13;&#10;WHEN 28 then &apos;12 Month QA&apos;&#13;&#10;WHEN 37 then &apos;1 Month JO&apos;&#13;&#10;WHEN 38 then &apos;12 Month JO&apos;&#13;&#10;WHEN 39 then &apos;1 Month OM&apos;&#13;&#10;WHEN 40 then &apos;12 Month OM&apos;&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1381760723821645831]' derivation='None' name='[none:Calculation_1381760723821645831:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Prev Planid' datatype='integer' name='[prev_planid]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lwdrtp16elu3x115maj818jjbkb'>
            <column caption='Up for renewal customers' datatype='integer' name='[Calculation_1693916450264944644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [status] == &apos;up for renewal&apos; then customers end )' />
            </column>
            <column caption='[Churned Customers]/([Up for renewal customers])' datatype='real' name='[Calculation_1693916450265989127]' role='measure' type='quantitative' user:unnamed='BQ-ChurnOverTime (2)'>
              <calculation class='tableau' formula='[Up for renewal customers (copy)_1693916450265485317]/([Calculation_1693916450264944644])' />
            </column>
            <column aggregation='Sum' caption='Date Filter 2' datatype='integer' name='[Calculation_1693916450267992072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [type] == &apos;monthly&apos; then&#13;&#10;        if [iso_date] &gt;= DATEADD(&apos;month&apos;,-6,TODAY()) then 1 else 0 end &#13;&#10;ELSEIF  [type] == &apos;weekly&apos; then &#13;&#10;        if [iso_date] &gt;= DATEADD(&apos;week&apos;,-12,TODAY()) then 1 else 0 end &#13;&#10;elseif [type] == &apos;daily&apos; then &#13;&#10;         if [iso_date] &gt;= DATEADD(&apos;day&apos;,-60,TODAY()) then 1 else 0 end end' />
            </column>
            <column caption='[Voluntary Churned Customers ]/[Up for renewal customers]' datatype='real' name='[Calculation_1693916450273726479]' role='measure' type='quantitative' user:unnamed='BQ-ChurnOverTime (2)'>
              <calculation class='tableau' formula='[Churned Customers (copy)_1693916450272411657]/[Calculation_1693916450264944644]' />
            </column>
            <column caption='[Involuntary Churned Customers ]/[Up for renewal customers]' datatype='real' name='[Calculation_1693916450273767440]' role='measure' type='quantitative' user:unnamed='BQ-ChurnOverTime (2)'>
              <calculation class='tableau' formula='[Voluntary Churned Customers  (copy)_1693916450272669706]/[Calculation_1693916450264944644]' />
            </column>
            <column caption='Datefilter' datatype='string' name='[Calculation_555631627113218051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [iso_date]&lt;=today()-1 then &apos;T&apos; else &apos;F&apos; end' />
            </column>
            <column caption='Plan Type' datatype='string' name='[Calculation_555631627117690884]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [plan_id] &#13;&#10;WHEN 16 then &apos;1 Month AE&apos;&#13;&#10;WHEN 22 then &apos;6 Months AE&apos;&#13;&#10;WHEN 23 then &apos;12 Months AE&apos;&#13;&#10;WHEN 21 then &apos;Free Coffee AE&apos;&#13;&#10;WHEN 26 then &apos;Pizza 3 Months AE&apos;&#13;&#10;WHEN 27 then &apos;Pizza 6 Months AE&apos;&#13;&#10;WHEN 19 then &apos;1 Month KW&apos;&#13;&#10;WHEN 24 then &apos;6 Months KW&apos;&#13;&#10;WHEN 25 then &apos;1 Month QA&apos; &#13;&#10;WHEN 33 then &apos;12 Month BH&apos;&#13;&#10;WHEN 29 then &apos;1 Month BH&apos;&#13;&#10;WHEN 28 then &apos;12 Month QA&apos;&#13;&#10;WHEN 37 then &apos;1 Month JO&apos;&#13;&#10;WHEN 38 then &apos;12 Month JO&apos;&#13;&#10;WHEN 39 then &apos;1 Month OM&apos;&#13;&#10;WHEN 40 then &apos;12 Month OM&apos;&#13;&#10;END' />
            </column>
            <column caption='Voluntary Churned Customers ' datatype='integer' name='[Churned Customers (copy)_1693916450272411657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [status] == &apos;churned&apos; and  [churn_type] == &apos;Voluntary Churn&apos;  then [customers] end )' />
            </column>
            <column caption='Churned Customers' datatype='integer' name='[Up for renewal customers (copy)_1693916450265485317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [status] == &apos;churned&apos; then [customers] end )' />
            </column>
            <column caption='Involuntary Churned Customers ' datatype='integer' name='[Voluntary Churned Customers  (copy)_1693916450272669706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [status] == &apos;churned&apos; and  [churn_type] == &apos;Involuntary Churn&apos;  then [customers] end )' />
            </column>
            <column caption='Churn Type' datatype='string' name='[churn_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
