      <datasource-dependencies datasource='federated.0ukp06s0r6jyv313vt6o306qqqb0'>
        <column caption='Currenncy Value Chart' datatype='real' name='[Currenncy Value (copy)_1203024064408506376]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN ZN([Pivot Field Values])&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ZN([Pivot Field Values]) / [Orders]&#13;&#10;WHEN &quot;EUR&quot; THEN ZN([Pivot Field Values])*[FX]&#13;&#10;WHEN &quot;EUR / Order&quot; THEN (ZN([Pivot Field Values])*[FX]) / [Orders]&#13;&#10;WHEN  &quot;Margin %&quot; THEN ZN([Pivot Field Values]) / [Revenue] * 100&#13;&#10;&#13;&#10;END' />
        </column>
        <column caption='Currenncy Value Chart (copy2)' datatype='real' name='[Currenncy Value Chart (copy) (copy)_141018981418373121]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;//WHEN &quot;EGP&quot; THEN AVG( ZN([Values 2])  )&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ZN([Pivot Field Values]) / [Orders]&#13;&#10;//WHEN &quot;EUR&quot; THEN AVG( ZN([Values 2])*[FX]   )&#13;&#10;WHEN &quot;EUR / Order&quot; THEN ZN([Pivot Field Values])*[FX] / [Orders]&#13;&#10;WHEN  &quot;Margin %&quot; THEN ZN([Pivot Field Values]) // { FIXED [Months]: MIN([Revenue])} * 100&#13;&#10;&#13;&#10;END' />
        </column>
        <column caption='P1 Value old' datatype='real' name='[Currenncy Value Chart (copy)_936467261549940740]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN AVG( ZN([Pivot Field Values])  )&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM( ZN([Pivot Field Values])) / SUM([Orders]) &#13;&#10;WHEN &quot;EUR&quot; THEN AVG( ZN([Pivot Field Values])*[FX]   )&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM( ZN([Pivot Field Values])*[FX]) / SUM([Orders])&#13;&#10;//WHEN  &quot;Margin %&quot; THEN AVG( ZN([Values 2])  / { FIXED [Months 2]: MIN([Revenue])})  * 100&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM( ZN([Pivot Field Values])) / SUM([Revenue]) * 100&#13;&#10;&#13;&#10;END' />
        </column>
      </datasource-dependencies>
