              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN SUM(ZN([Pivot Field Values]))&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM(ZN([Pivot Field Values])) / AVG([Orders])&#13;&#10;WHEN &quot;EUR&quot; THEN SUM(ZN([Pivot Field Values])*[FX])&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM((ZN([Pivot Field Values])*[FX])) / AVG([Orders])&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM(ZN([Pivot Field Values])) / AVG([Revenue]) * 100&#13;&#10;WHEN &quot;Orders&quot; THEN AVG([Orders])&#13;&#10;WHEN &quot;Orders / Day&quot; THEN AVG([Orders]) / AVG([Days])&#13;&#10;&#13;&#10;END' />
