      <aliases enabled='yes' />
      <column caption='Act/Be/Bud' datatype='string' name='[ACT/BE/BUD]' role='dimension' type='nominal' />
      <column caption='Currency Value chart 2' datatype='real' name='[Calculation_1203024064409198603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN ZN([Pivot Field Values])&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ZN([Pivot Field Values]) / [Orders]&#13;&#10;WHEN &quot;EUR&quot; THEN ZN([Pivot Field Values])*[FX]&#13;&#10;WHEN &quot;EUR / Order&quot; THEN (ZN([Pivot Field Values])*[FX]) / [Orders]&#13;&#10;WHEN  &quot;Margin %&quot; THEN ZN([Pivot Field Values]) / [Revenue] * 100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Value Chart' datatype='real' name='[Calculation_1203024064409391116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//ABS(&#13;&#10;//AVG([Copy of P&amp;L Lines+ (EG BE22 + BUD23 Summary)].[Currenncy Value Chart]) -&#13;&#10;//AVG([Currency Value chart 2])&#13;&#10;//)&#13;&#10;&#13;&#10;ABS(&#13;&#10;[federated.0ukp06s0r6jyv313vt6o306qqqb0].[Currenncy Value Chart (copy)_936467261549940740] - &#13;&#10;[Currency Value chart 2 (copy)_494833026938433536]&#13;&#10;)' />
      </column>
      <column caption='Color' datatype='integer' name='[Calculation_1203024064425148429]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF &#13;&#10;(AVG([federated.0ukp06s0r6jyv313vt6o306qqqb0].[Currenncy Value (copy)_1203024064408506376]) -&#13;&#10;AVG([Calculation_1203024064409198603])) &lt; 0 then 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Sort' datatype='real' name='[Calculation_1203024064426201102]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='-[Calculation_1203024064409391116]' />
      </column>
      <column caption='P 1 AVG' datatype='real' name='[Calculation_1203024064427122704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([federated.0ukp06s0r6jyv313vt6o306qqqb0].[Currenncy Value (copy)_1203024064408506376])' />
      </column>
      <column caption='P 2 AVG' datatype='real' name='[Calculation_1203024064427257873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1203024064409198603])' />
      </column>
      <column caption='test' datatype='real' name='[Calculation_268527148119674880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//{ FIXED [L7] : SUM([Values 2])}&#13;&#10;&#13;&#10;if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889] then [Pivot Field Values] end' />
      </column>
      <column caption='test 3' datatype='real' name='[Calculation_268527148132102150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_268527148119674880]) - ZN([test (copy)_268527148131762181])' />
      </column>
      <column caption='Currency Value chart 2 (copy2)' datatype='real' name='[Currency Value chart 2 (copy) (copy)_141018981417811968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;//WHEN &quot;EGP&quot; THEN AVG( ZN([Values 2])  )&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ZN([Pivot Field Values]) / [Orders]&#13;&#10;//WHEN &quot;EUR&quot; THEN AVG( ZN([Values 2])*[FX]   )&#13;&#10;WHEN &quot;EUR / Order&quot; THEN ZN([Pivot Field Values])*[FX] / [Orders]&#13;&#10;WHEN  &quot;Margin %&quot; THEN ZN([Pivot Field Values]) // { FIXED [Months 2]: MIN([Revenue])} * 100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='P2 Value' datatype='real' name='[Currency Value chart 2 (copy)_494833026938433536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN AVG( ZN([Pivot Field Values])  )&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM( ZN([Pivot Field Values])) / SUM([Orders]) &#13;&#10;WHEN &quot;EUR&quot; THEN AVG( ZN([Pivot Field Values])*[FX]   )&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM( ZN([Pivot Field Values])*[FX]) / SUM([Orders])&#13;&#10;//WHEN  &quot;Margin %&quot; THEN AVG( ZN([Values 2])  / { FIXED [Months 2]: MIN([Revenue])})  * 100&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM( ZN([Pivot Field Values])) / SUM([Revenue]) * 100&#13;&#10;&#13;&#10;END' />
      </column>
