            </column>
            <column caption='P1 EGP' datatype='real' name='[Calculation_1954562259109408768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN ZN([Pivot Field Values])  END) /&#13;&#10;COUNTD(if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN [Pivot Field Names] END)' />
            </column>
            <column caption='P1 EGP/Order' datatype='real' name='[Calculation_1954562259109556225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN ZN([Pivot Field Values])  END) / &#13;&#10;//SUM( if [Months] &gt;= [from] and [Months]&lt;= [to]  THEN [Orders]  END)&#13;&#10;SUM({ FIXED [Pivot Field Names] :min(if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889] THEN [Orders] END)})' />
            </column>
            <column caption='P1 Value' datatype='real' name='[Calculation_1954562259111092229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN ROUND([Calculation_1954562259109408768], 0)&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ROUND([Calculation_1954562259109556225], 2)&#13;&#10;WHEN &quot;EUR&quot; THEN ROUND([P1 EGP (copy)_1954562259109818370], 0)&#13;&#10;WHEN &quot;EUR / Order&quot; THEN ROUND([P1 EGP/Order (copy)_1954562259110273027], 2)&#13;&#10;WHEN &quot;Margin %&quot; THEN ROUND([P1 EGP/Order (copy)_1954562259113848839], 2)&#13;&#10;&#13;&#10;END' />
