    <worksheet name='Progression over time wo line'>
      <table>
        <view>
          <datasources>
            <datasource caption='Copy of P&amp;L Lines+ (EG BE22 + BUD23 Summary)' name='federated.0ukp06s0r6jyv313vt6o306qqqb0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Level 2' datatype='string' name='[Level 1 (copy)_1203024064402706434]' param-domain-type='list' role='measure' type='nominal' value='&quot;L2&quot;'>
              <calculation class='tableau' formula='&quot;L2&quot;' />
            </column>
            <column caption='Level 3' datatype='string' name='[Level 2 (copy)_936467261547536386]' param-domain-type='list' role='measure' type='nominal' value='&quot;L5&quot;'>
              <calculation class='tableau' formula='&quot;L5&quot;' />
            </column>
            <column caption='Measure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EGP&quot;'>
              <calculation class='tableau' formula='&quot;EGP&quot;' />
            </column>
            <column caption='Level 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;L1&quot;'>
              <calculation class='tableau' formula='&quot;L1&quot;' />
            </column>
            <column caption='Chart Type' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;without zero line&quot;'>
              <calculation class='tableau' formula='&quot;without zero line&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ukp06s0r6jyv313vt6o306qqqb0'>
            <column caption='Currenncy Value' datatype='real' name='[Calculation_1203024064397139968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN SUM(ZN([Pivot Field Values]))&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM(ZN([Pivot Field Values])) / SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN &quot;EUR&quot; THEN SUM(ZN([Pivot Field Values])*[FX])&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM((ZN([Pivot Field Values])*[FX])) / SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM(ZN([Pivot Field Values])) / SUM( { FIXED [Pivot Field Names]: MIN([Revenue])} ) * 100&#13;&#10;WHEN &quot;Orders&quot; THEN SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN &quot;Orders / Day&quot; THEN SUM( { FIXED [Pivot Field Names]: MIN([Orders])} ) / SUM( { FIXED [Pivot Field Names]: MIN([Days])} )&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Level1 Vlaue' datatype='string' name='[Calculation_1203024064402817027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;L0&quot; THEN [L0]&#13;&#10;WHEN &quot;L1&quot; THEN [L1]&#13;&#10;WHEN &quot;L2&quot; THEN [L2]&#13;&#10;WHEN &quot;L3&quot; THEN [L3]&#13;&#10;WHEN &quot;L4&quot; THEN [L4]&#13;&#10;WHEN &quot;L5&quot; THEN [L5]&#13;&#10;WHEN &quot;L6&quot; THEN [L6]&#13;&#10;WHEN &quot;L7&quot; THEN [L7]&#13;&#10;WHEN &quot;Joker Level&quot; THEN [Joker Level]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Selected Chart' datatype='string' name='[Calculation_299770874412822528]' role='dimension' type='nominal'>
