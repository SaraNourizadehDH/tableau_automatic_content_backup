      <aliases enabled='yes' />
      <column caption='Act/Be/Bud' datatype='string' name='[ACT/BE/BUD]' role='dimension' type='nominal' />
      <column caption='Currenncy Value' datatype='real' name='[Calculation_1203024064397139968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN SUM(ZN([Pivot Field Values]))&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM(ZN([Pivot Field Values])) / SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN &quot;EUR&quot; THEN SUM(ZN([Pivot Field Values])*[FX])&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM((ZN([Pivot Field Values])*[FX])) / SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM(ZN([Pivot Field Values])) / SUM( { FIXED [Pivot Field Names]: MIN([Revenue])} ) * 100&#13;&#10;WHEN &quot;Orders&quot; THEN SUM( { FIXED [Pivot Field Names]: MIN([Orders])} )&#13;&#10;WHEN &quot;Orders / Day&quot; THEN SUM( { FIXED [Pivot Field Names]: MIN([Orders])} ) / SUM( { FIXED [Pivot Field Names]: MIN([Days])} )&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Level1 Vlaue' datatype='string' name='[Calculation_1203024064402817027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;L0&quot; THEN [L0]&#13;&#10;WHEN &quot;L1&quot; THEN [L1]&#13;&#10;WHEN &quot;L2&quot; THEN [L2]&#13;&#10;WHEN &quot;L3&quot; THEN [L3]&#13;&#10;WHEN &quot;L4&quot; THEN [L4]&#13;&#10;WHEN &quot;L5&quot; THEN [L5]&#13;&#10;WHEN &quot;L6&quot; THEN [L6]&#13;&#10;WHEN &quot;L7&quot; THEN [L7]&#13;&#10;WHEN &quot;Joker Level&quot; THEN [Joker Level]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Date Level' datatype='string' name='[Calculation_1764566648365486080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [Date Granularity]=&apos;Month&apos; then STR(DATENAME(&apos;month&apos;,[Months])) + str(year([Months])) &#13;&#10;IF [Parameters].[Parameter 4]=&apos;Month&apos; then STR(YEAR([Pivot Field Names])) + &apos;-&apos; + STR(MONTH([Pivot Field Names]))&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then str(year([Pivot Field Names])) + &quot; - Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Pivot Field Names]))&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Year&apos; then str(year([Pivot Field Names])) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Half&apos; then str(year([Pivot Field Names])) + IF DATEPART(&apos;quarter&apos;, [Pivot Field Names]) &lt; 3 THEN &apos; H1&apos; ELSE &apos; H2&apos; END&#13;&#10;END' />
      </column>
      <column caption='P1 EGP' datatype='real' name='[Calculation_1954562259109408768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN ZN([Pivot Field Values])  END) /&#13;&#10;COUNTD(if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN [Pivot Field Names] END)' />
      </column>
      <column caption='P1 EGP/Order' datatype='real' name='[Calculation_1954562259109556225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889]  THEN ZN([Pivot Field Values])  END) / &#13;&#10;//SUM( if [Months] &gt;= [from] and [Months]&lt;= [to]  THEN [Orders]  END)&#13;&#10;SUM({ FIXED [Pivot Field Names] :min(if [Pivot Field Names] &gt;= [Parameters].[Parameter 5] and [Pivot Field Names]&lt;= [Parameters].[from (copy)_268527148126629889] THEN [Orders] END)})' />
      </column>
      <column caption='P1 Value' datatype='real' name='[Calculation_1954562259111092229]' role='measure' type='quantitative'>
