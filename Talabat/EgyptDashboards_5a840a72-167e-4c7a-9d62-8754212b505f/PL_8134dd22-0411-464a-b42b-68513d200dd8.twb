      <aliases enabled='yes' />
      <column caption='Act/Be/Bud' datatype='string' name='[ACT/BE/BUD]' role='dimension' type='nominal' />
      <column caption='BUD Value' datatype='real' name='[Calculation_702280071245422594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN SUM(ZN([Pivot Field Values]))&#13;&#10;WHEN &quot;EGP / Order&quot; THEN SUM(ZN([Pivot Field Values])) / AVG([Orders])&#13;&#10;WHEN &quot;EUR&quot; THEN SUM(ZN([Pivot Field Values])*[FX])&#13;&#10;WHEN &quot;EUR / Order&quot; THEN SUM((ZN([Pivot Field Values])*[FX])) / AVG([Orders])&#13;&#10;WHEN  &quot;Margin %&quot; THEN SUM(ZN([Pivot Field Values])) / AVG([Revenue]) * 100&#13;&#10;WHEN &quot;Orders&quot; THEN AVG([Orders])&#13;&#10;WHEN &quot;Orders / Day&quot; THEN AVG([Orders]) / AVG([Days])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='P2 EGP' datatype='real' name='[Calculation_702280071272091657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9]  THEN ZN([Pivot Field Values])  END)' />
      </column>
      <column caption='P2 EGP/Order' datatype='real' name='[Calculation_702280071272284170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9]  THEN ZN([Pivot Field Values])  END) / &#13;&#10;SUM({ FIXED [Pivot Field Names] :min(if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9] THEN [Orders] END)})' />
      </column>
      <column caption='P2 EUR' datatype='real' name='[Calculation_702280071272398859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9]  THEN ZN([Pivot Field Values]) * [FX]  END)' />
      </column>
      <column caption='P2 EUR/Order' datatype='real' name='[Calculation_702280071272726540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9]  THEN ZN([Pivot Field Values]) * [FX]  END) / &#13;&#10;SUM({ FIXED [Pivot Field Names] :min(if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9] THEN [Orders] END)})' />
      </column>
      <column caption='P2 Margin%' datatype='real' name='[Calculation_702280071273123853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9]  THEN ZN([Pivot Field Values])  END) / &#13;&#10;SUM({ FIXED [Pivot Field Names] :min(if [Pivot Field Names] &gt;= [Parameters].[Parameter 8] and [Pivot Field Names]&lt;= [Parameters].[Parameter 9] THEN [Revenue] END)}) * 100' />
      </column>
      <column caption='P2 Value' datatype='real' name='[Calculation_702280071273275406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;EGP&quot; THEN ROUND([Calculation_702280071272091657], 0)&#13;&#10;WHEN &quot;EGP / Order&quot; THEN ROUND([Calculation_702280071272284170], 2)&#13;&#10;WHEN &quot;EUR&quot; THEN ROUND([Calculation_702280071272398859], 0)&#13;&#10;WHEN &quot;EUR / Order&quot; THEN ROUND([Calculation_702280071272726540], 2)&#13;&#10;WHEN &quot;Margin %&quot; THEN ROUND([Calculation_702280071273123853], 2)&#13;&#10;&#13;&#10;END' />
      </column>
