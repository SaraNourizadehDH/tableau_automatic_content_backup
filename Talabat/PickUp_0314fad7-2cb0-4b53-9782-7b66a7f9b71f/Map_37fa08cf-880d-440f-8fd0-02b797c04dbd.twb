      <column caption='Starbucks' datatype='integer' name='[Calculation_2070248477509668866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD (if lower([vendor_name])= &apos;%starbucks%&apos; then [order_id] END)' />
