        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Sessions&apos; THEN SUM([homepage_loaded_session_count])&#10;WHEN &apos;Placed Orders&apos; THEN SUM([vendor_placed_order_session_count])&#10;WHEN &apos;Acquisitions&apos; THEN [Calculation_6973542549386809344]&#10;WHEN &apos;GMV&apos; THEN SUM([vendor_placed_order_gmv_sum])&#10;&#10;END' />
