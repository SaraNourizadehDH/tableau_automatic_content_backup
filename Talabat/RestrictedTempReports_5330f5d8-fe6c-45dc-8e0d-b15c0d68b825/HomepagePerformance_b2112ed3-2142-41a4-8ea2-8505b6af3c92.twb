      <table>
        <view>
          <datasources>
            <datasource caption='agg_homepage_performance_remix (data_playground_finding)' name='federated.0mp6otr1q7pjof1dupi4k04bkyur' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Component Name Toggle' datatype='boolean' name='[Component Type Toggle (copy)_427841966062977031]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Component Detail Toggle' datatype='boolean' name='[Component Type Toggle (copy)_427841966064533514]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Component Type Toggle' datatype='boolean' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0mp6otr1q7pjof1dupi4k04bkyur].[Calculation_5711197710948880389]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-10#'>
              <calculation class='tableau' formula='#2024-11-10#' />
            </column>
            <column caption='Remix Flag Toggle' datatype='boolean' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0mp6otr1q7pjof1dupi4k04bkyur].[Default Date - Start (copy)_5711197710948954118]' caption='End Date' datatype='date' name='[Start Date (copy)_5711197710948687875]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-17#'>
              <calculation class='tableau' formula='#2024-11-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mp6otr1q7pjof1dupi4k04bkyur'>
            <column caption='CVR' datatype='real' default-format='p0.0%' name='[CTR (copy)_3723491730507436033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(subscription_success_session_count) + SUM(vendor_placed_order_session_count) )&#10;/ SUM(homepage_loaded_session_count)' />
            </column>
            <column caption='mCVR3' datatype='real' default-format='p0.0%' name='[CVR (copy)_3723491730508521474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(vendor_started_checkout_session_count)&#10;/ SUM(vendor_menu_viewed_session_count)' />
            </column>
            <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_3723491730507108352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(component_clicked_session_count) / sum(homepage_loaded_session_count)' />
            </column>
            <column caption='Filter - Remove Countries' datatype='boolean' name='[Calculation_427841966029148160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code] != &apos;na&apos;&#10;AND&#10;[country_code] != &apos;LB&apos;&#10;AND&#10;[country_code] != &apos;SA&apos;' />
            </column>
            <column caption='Remix Flag ' datatype='string' name='[Calculation_427841966061441028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 8] THEN [remix_home_flag] ELSE &apos;Total&apos; END' />
            </column>
            <column caption='Date Filter' datatype='string' name='[Calculation_5711197710948749316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_5711197710948687875])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_5711197710948687875]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_5711197710948687875])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF&#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_5711197710948687875]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='Default Date - Start' datatype='date' name='[Calculation_5711197710948880389]' role='dimension' type='ordinal'>
