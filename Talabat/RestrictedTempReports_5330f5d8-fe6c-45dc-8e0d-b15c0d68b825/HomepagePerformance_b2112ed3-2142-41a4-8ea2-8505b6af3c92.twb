        <calculation class='tableau' formula='if [CTR (copy)_3723491730507436033] &lt; .28 THEN&#10;&#10;1 - ([Calculation_2258414491645501446] + [Calculation_93871929805230080])&#10;ELSE 1 - [CTR (copy)_3723491730507436033]&#10;&#10;END' />
      </column>
      <column caption='mCVR3' datatype='real' default-format='p0.0%' name='[CVR (copy)_3723491730508521474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(vendor_started_checkout_session_count)&#10;/ SUM(vendor_menu_viewed_session_count)' />
      </column>
      <column caption='CTR (remaining)' datatype='real' default-format='p0.0%' name='[CVR (remaining) (copy)_1933451681623175173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3723491730507108352] &lt; .28 THEN&#10;&#10;1 - ([CVR (Red) (copy)_1933451681623175174] + [CVR Target (copy)_1933451681623175175])&#10;ELSE 1 - [Calculation_3723491730507108352]&#10;&#10;END' />
      </column>
      <column caption='CTR Target' datatype='real' name='[CVR Target (copy)_1933451681623175175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3723491730507108352] &lt; .28 THEN&#10;&#10;0.28 - [CVR (Red) (copy)_1933451681623175174]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='Button (Up)' datatype='boolean' name='[Calculation1 (copy)_2513853017981378567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] = &apos;▲&apos;' />
      </column>
      <column caption='CVR (Red)' datatype='real' name='[Calculation_2258414491645501446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [CTR (copy)_3723491730507436033] &lt; .28 THEN&#10;&#10;[CTR (copy)_3723491730507436033]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='Button (Down)' datatype='boolean' name='[Calculation_2513853017980436485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] = &apos;▼&apos;' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_3723491730507108352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(component_clicked_session_count) / sum(homepage_loaded_session_count)' />
