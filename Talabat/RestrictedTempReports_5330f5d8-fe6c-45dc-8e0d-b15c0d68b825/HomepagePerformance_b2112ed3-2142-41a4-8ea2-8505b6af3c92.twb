      <column caption='CVR' datatype='real' default-format='p0.0%' name='[CTR (copy)_3723491730507436033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(subscription_success_session_count) + SUM(vendor_placed_order_session_count) )&#10;/ SUM(homepage_loaded_session_count)' />
      </column>
      <column caption='CTR (Green)' datatype='real' name='[CVR (Green) (copy)_1933451681623175172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3723491730507108352] &gt;= .28 THEN&#10;&#10;[Calculation_3723491730507108352]&#10;ELSE 0&#10;&#10;END' />
      </column>
      <column caption='CTR (Red)' datatype='real' name='[CVR (Red) (copy)_1933451681623175174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3723491730507108352] &lt; .28 THEN&#10;&#10;[Calculation_3723491730507108352]&#10;ELSE 0&#10;&#10;END' />
      </column>
