        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Country&apos; THEN [country_code]&#10;WHEN &apos;OS&apos; THEN [operating_system]&#10;WHEN &apos;Remix Flag&apos; THEN [remix_home_flag]&#10;//WHEN &apos;QC Customer Segment&apos; THEN [Qc Customer Segment]&#10;&#10;END' />
