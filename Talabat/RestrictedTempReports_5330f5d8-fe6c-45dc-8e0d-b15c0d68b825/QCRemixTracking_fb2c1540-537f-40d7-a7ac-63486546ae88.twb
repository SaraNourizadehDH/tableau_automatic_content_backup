              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Measure' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Sessions&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0ofliy3136izjk0zryp3v02furrh].[shop_type]' caption='Shop Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ofliy3136izjk0zryp3v02furrh].[Default Date - Start (copy)_5711197710948954118]' caption='End Date' datatype='date' name='[Start Date (copy)_5711197710948687875]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-24#'>
              <calculation class='tableau' formula='#2024-09-24#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ofliy3136izjk0zryp3v02furrh'>
            <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1432637327203627008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_5711197710946963456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks])/SUM([sessions])' />
            </column>
            <column caption='Selected Metric' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5711197710952480778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Sessions&apos; THEN SUM([sessions])&#10;WHEN &apos;Placed Orders&apos; THEN SUM([transactions])&#10;WHEN &apos;Users&apos; THEN SUM([users])&#10;WHEN &apos;GMV&apos; THEN SUM([gmv])&#10;&#10;END' />
            </column>
            <column caption='Shop Type Filter' datatype='boolean' name='[Calculation_5711197710989570064]' role='dimension' type='nominal'>
