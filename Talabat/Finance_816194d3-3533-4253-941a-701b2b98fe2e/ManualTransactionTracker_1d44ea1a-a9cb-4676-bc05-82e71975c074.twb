      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='auto_manual_2024' id='auto_manual_2024_6C193A2552CB4D89AC2447E4C7A7DC4C'>
            <properties context=''>
              <relation connection='bigquery.11bqd5b0cya37h1h9d2vq0um9ksn' name='Custom SQL Query' type='text'><![CDATA[with temp as (
SELECT DISTINCT
   REPLACE(DATAAREAID, 'FD', '') AS country_code,
  INVOICETXT as invoice_text,
  DESCRIPTION as description,
  LEDGERDIMENSIONDISPLAYVALUE as ledger_account,
  ma.name as ledger_name,
  DATE(INVOICEDATE) AS invoice_date,
  FREETEXTNUMBER AS invoice_id,
  CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR*3.67) ELSE (AMOUNTCUR*1.0) END AS amount_lc,
  exc.exchange_rate_value,
  (CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR *3.67) ELSE (AMOUNTCUR*1.0) END )/exc.exchange_rate_value AS amount_eur,
  CASE WHEN SUBSTR(FREETEXTNUMBER, 1, 2) = 'CN' THEN 'Credit Note' ELSE 'Invoice' END AS invoice_type
FROM
  ( SELECT * FROM `tlb-data-prod.data_platform_msdynamics.FreeTextInvoiceStaging` 
  WHERE DATE(INVOICEDATE)>>= '2024-01-01' 
  and DATAAREAID like 'FD%') as fti
LEFT JOIN
  `tlb-data-prod.data_platform.dim_exchange_rate` exc
ON
  DATE(fti.INVOICEDATE) = DATE(exc.exchange_rate_date)
  AND UPPER(REPLACE(TRIM(DATAAREAID), 'FD', '')) =UPPER(CASE WHEN TRIM(exc.country_code)= 'IQ' THEN 'RQ' ELSE TRIM(exc.country_code) END)
  AND exc.exchange_rate_base = 'EUR'
  AND DATE(exc.exchange_rate_date)>>= '2024-01-01'
  AND exc.country_code IS NOT NULL
  AND exc.country_id IS NOT NULL
LEFT JOIN `tlb-data-prod.data_platform_msdynamics.MainAccountStaging` ma on SAFE_CAST(ma.MAINACCOUNTID AS INTEGER) = SAFE_CAST(LEDGERDIMENSIONDISPLAYVALUE AS INTEGER)
  group by ALL
)
,
base as
(SELECT
     t1.country_code,
        t1.invoice_text,
        t1.description,
        t1.ledger_account,
        t1.ledger_name,
        t1.invoice_date,
        t1.invoice_id,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_lc 
        END AS amount_lc,
        t1.exchange_rate_value,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_eur 
        END AS amount_eur,
        t1.invoice_type,
        t2.LEDGER_ACCOUNT_FLAG
FROM
  temp t1
  LEFT join `tlb-data-prod.data_platform_google_sheet.dynamics_accounts_flagged_billingsystem` t2 on SAFE_CAST(t1.ledger_account as INT64) = SAFE_CAST(t2.ledger_account_number as INT64)
GROUP BY
  all
),

final_output as 
(
select  *  from  base  where DATE_TRUNC(invoice_date, month) << DATE_TRUNC(current_date(), month) 
)

SELECT
    t.*,
    SUM(amount_eur) over (partition by country_code, invoice_date) as country_amount_eur,
    SUM(amount_eur) over (partition by invoice_date) as mena_amount_eur,
FROM
    final_output t]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='flexi_gem' inline='true' name='federated.1v6cpn017jjcy71e2dmf01e208ve' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1yhm8qw1urtj1216qybb50u8uckb'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_billing' server-oauth='' username='manjunath.lonikar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1yhm8qw1urtj1216qybb50u8uckb' name='Custom SQL Query' type='text'><![CDATA[SELECT
  foi.country_code AS global_entity_id,
  jo.vendor_id,
  DATE(order_placed_at) order_date,
  jo.order_id,
  joker_type,
  order_status,
  joker_fee AS joker_fee_lc,
  SAFE_DIVIDE(joker_fee,foi.exchange_rate_to_eur) joker_fee
FROM
  `tlb-data-prod.data_platform_billing.joker_orders` jo
JOIN
  `tlb-data-prod.data_platform.fct_order_info` foi
ON
  jo.order_id = foi.order_id
WHERE
  joker_fee_type = 0
  AND joker_fee >> 0
  AND DATE(jo.order_placed_at) << DATE_TRUNC(current_date,month)
  AND DATE(foi.order_date) >>= '2024-04-01'
  AND DATE(foi.order_date) << DATE_TRUNC(current_date,month)
GROUP BY
  ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1yhm8qw1urtj1216qybb50u8uckb' name='Custom SQL Query' type='text'><![CDATA[SELECT
  foi.country_code AS global_entity_id,
  jo.vendor_id,
  DATE(order_placed_at) order_date,
  jo.order_id,
  joker_type,
  order_status,
  joker_fee AS joker_fee_lc,
  SAFE_DIVIDE(joker_fee,foi.exchange_rate_to_eur) joker_fee
FROM
  `tlb-data-prod.data_platform_billing.joker_orders` jo
JOIN
  `tlb-data-prod.data_platform.fct_order_info` foi
ON
  jo.order_id = foi.order_id
WHERE
  joker_fee_type = 0
  AND joker_fee >> 0
  AND DATE(jo.order_placed_at) << DATE_TRUNC(current_date,month)
  AND DATE(foi.order_date) >>= '2024-04-01'
  AND DATE(foi.order_date) << DATE_TRUNC(current_date,month)
GROUP BY
  ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
