        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11bqd5b0cya37h1h9d2vq0um9ksn' name='Custom SQL Query' type='text'><![CDATA[with temp as (
SELECT DISTINCT
   REPLACE(DATAAREAID, 'FD', '') AS country_code,
  INVOICETXT as invoice_text,
  DESCRIPTION as description,
  LEDGERDIMENSIONDISPLAYVALUE as ledger_account,
  ma.name as ledger_name,
  DATE(INVOICEDATE) AS invoice_date,
  FREETEXTNUMBER AS invoice_id,
  CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR*3.67) ELSE (AMOUNTCUR*1.0) END AS amount_lc,
  exc.exchange_rate_value,
  (CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR *3.67) ELSE (AMOUNTCUR*1.0) END )/exc.exchange_rate_value AS amount_eur,
  CASE WHEN SUBSTR(FREETEXTNUMBER, 1, 2) = 'CN' THEN 'Credit Note' ELSE 'Invoice' END AS invoice_type
FROM
  ( SELECT * FROM `tlb-data-prod.data_platform_msdynamics.FreeTextInvoiceStaging` 
  WHERE DATE(INVOICEDATE)>>= '2024-01-01' 
  and DATAAREAID like 'FD%') as fti
LEFT JOIN
  `tlb-data-prod.data_platform.dim_exchange_rate` exc
ON
  DATE(fti.INVOICEDATE) = DATE(exc.exchange_rate_date)
  AND UPPER(REPLACE(TRIM(DATAAREAID), 'FD', '')) =UPPER(CASE WHEN TRIM(exc.country_code)= 'IQ' THEN 'RQ' ELSE TRIM(exc.country_code) END)
  AND exc.exchange_rate_base = 'EUR'
  AND DATE(exc.exchange_rate_date)>>= '2024-01-01'
  AND exc.country_code IS NOT NULL
  AND exc.country_id IS NOT NULL
LEFT JOIN `tlb-data-prod.data_platform_msdynamics.MainAccountStaging` ma on SAFE_CAST(ma.MAINACCOUNTID AS INTEGER) = SAFE_CAST(LEDGERDIMENSIONDISPLAYVALUE AS INTEGER)
  group by ALL
)
,
base as
(SELECT
     t1.country_code,
        t1.invoice_text,
        t1.description,
        t1.ledger_account,
        t1.ledger_name,
        t1.invoice_date,
        t1.invoice_id,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_lc 
        END AS amount_lc,
        t1.exchange_rate_value,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_eur 
        END AS amount_eur,
        t1.invoice_type,
        t2.LEDGER_ACCOUNT_FLAG
FROM
  temp t1
  LEFT join `tlb-data-prod.data_platform_google_sheet.dynamics_accounts_flagged_billingsystem` t2 on SAFE_CAST(t1.ledger_account as INT64) = SAFE_CAST(t2.ledger_account_number as INT64)
GROUP BY
  all
),

final_output as 
(
select  *  from  base  where DATE_TRUNC(invoice_date, month) << DATE_TRUNC(current_date(), month) 
)

SELECT
    t.*,
    SUM(amount_eur) over (partition by country_code, invoice_date) as country_amount_eur,
    SUM(amount_eur) over (partition by invoice_date) as mena_amount_eur,
FROM
    final_output t]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.11bqd5b0cya37h1h9d2vq0um9ksn' name='Custom SQL Query' type='text'><![CDATA[with temp as (
SELECT DISTINCT
   REPLACE(DATAAREAID, 'FD', '') AS country_code,
  INVOICETXT as invoice_text,
  DESCRIPTION as description,
  LEDGERDIMENSIONDISPLAYVALUE as ledger_account,
  ma.name as ledger_name,
  DATE(INVOICEDATE) AS invoice_date,
  FREETEXTNUMBER AS invoice_id,
  CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR*3.67) ELSE (AMOUNTCUR*1.0) END AS amount_lc,
  exc.exchange_rate_value,
  (CASE WHEN CURRENCYCODE ='USD' THEN (AMOUNTCUR *3.67) ELSE (AMOUNTCUR*1.0) END )/exc.exchange_rate_value AS amount_eur,
  CASE WHEN SUBSTR(FREETEXTNUMBER, 1, 2) = 'CN' THEN 'Credit Note' ELSE 'Invoice' END AS invoice_type
FROM
  ( SELECT * FROM `tlb-data-prod.data_platform_msdynamics.FreeTextInvoiceStaging` 
  WHERE DATE(INVOICEDATE)>>= '2024-01-01' 
  and DATAAREAID like 'FD%') as fti
LEFT JOIN
  `tlb-data-prod.data_platform.dim_exchange_rate` exc
ON
  DATE(fti.INVOICEDATE) = DATE(exc.exchange_rate_date)
  AND UPPER(REPLACE(TRIM(DATAAREAID), 'FD', '')) =UPPER(CASE WHEN TRIM(exc.country_code)= 'IQ' THEN 'RQ' ELSE TRIM(exc.country_code) END)
  AND exc.exchange_rate_base = 'EUR'
  AND DATE(exc.exchange_rate_date)>>= '2024-01-01'
  AND exc.country_code IS NOT NULL
  AND exc.country_id IS NOT NULL
LEFT JOIN `tlb-data-prod.data_platform_msdynamics.MainAccountStaging` ma on SAFE_CAST(ma.MAINACCOUNTID AS INTEGER) = SAFE_CAST(LEDGERDIMENSIONDISPLAYVALUE AS INTEGER)
  group by ALL
)
,
base as
(SELECT
     t1.country_code,
        t1.invoice_text,
        t1.description,
        t1.ledger_account,
        t1.ledger_name,
        t1.invoice_date,
        t1.invoice_id,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_lc 
        END AS amount_lc,
        t1.exchange_rate_value,
        CASE 
            WHEN t1.ledger_account = '750106022' AND t1.invoice_date >>= '2024-03-01' THEN 0 
            ELSE t1.amount_eur 
        END AS amount_eur,
        t1.invoice_type,
        t2.LEDGER_ACCOUNT_FLAG
FROM
  temp t1
  LEFT join `tlb-data-prod.data_platform_google_sheet.dynamics_accounts_flagged_billingsystem` t2 on SAFE_CAST(t1.ledger_account as INT64) = SAFE_CAST(t2.ledger_account_number as INT64)
GROUP BY
  all
),

final_output as 
(
select  *  from  base  where DATE_TRUNC(invoice_date, month) << DATE_TRUNC(current_date(), month) 
)

SELECT
    t.*,
    SUM(amount_eur) over (partition by country_code, invoice_date) as country_amount_eur,
    SUM(amount_eur) over (partition by invoice_date) as mena_amount_eur,
FROM
    final_output t]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
