      <_.fcp.ObjectModelTableType.true...column caption='flexi_gem_revenue' datatype='table' name='[__tableau_internal_object_id__].[_74203FC5696F4901BCBA7AE3E4BA7023]' role='measure' type='quantitative' />
      <column caption='Country Code' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
