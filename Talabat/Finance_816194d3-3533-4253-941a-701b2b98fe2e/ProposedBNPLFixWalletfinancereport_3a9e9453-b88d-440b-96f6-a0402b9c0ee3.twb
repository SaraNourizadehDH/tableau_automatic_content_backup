              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_4084C24D58A94EB7930A8AC9EC3BEE3E]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
            </metadata-record>
            <metadata-record class='column'>
              <remote-name>currency</remote-name>
              <remote-type>129</remote-type>
              <local-name>[currency]</local-name>
              <parent-name>[Extract]</parent-name>
              <remote-alias>currency</remote-alias>
              <ordinal>9</ordinal>
              <family>Custom SQL Query</family>
              <local-type>string</local-type>
              <aggregation>Count</aggregation>
              <approx-count>2</approx-count>
              <contains-null>true</contains-null>
              <collation flag='0' name='LROOT' />
              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_4084C24D58A94EB7930A8AC9EC3BEE3E]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
            </metadata-record>
          </metadata-records>
        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4084C24D58A94EB7930A8AC9EC3BEE3E'>
            <properties context=''>
              <relation connection='bigquery.0z0t4u319ipgya1ahr4p20urapgw' name='Custom SQL Query' type='text'><![CDATA[(
      with movement as (
            select country,
                  date,
                  wallet_bucket_name,
                  Reversal,
                  case
                        when wallet_bucket_name in (
                              'ADCB touchpoints redemption',
                              'Cobranded Card Gift'
                        )
                        and action_type = 'Earn' then 'Credit'
                        when action_type = 'Burn-Deactivation' then 'Burn-Deactivation'
                        else burn_type
                  end as burn_type,
                  campaign_name,
                  wallet_bucket_id,
                  action_type,
                  SUM(detail_amount_eur) as movement_amount_eur,
                  SUM(detail_amount_lc) as movement_amount_lc,
                  max(dwh_entry_timestamp) as last_refresh
            from (
                        select fwtd.created_time_lc,
                              fwtd.date,
                              case
                                    when fwtd.transaction_type_id = 23 then 'Burn-Deactivation'
                                    else fwtd.action_type
                              end as action_type,
                              dci.country,
                              coalesce(dwb.wallet_bucket_name, 'No Bucket') wallet_bucket_name,
                              dwtt.burn_type,
                              fwtd.detail_amount_eur,
                              fwtd.detail_amount_lc,
                              fwtd.wallet_bucket_id,
                              case
                                    when fwtd.is_reversal then 'Reversal'
                                    else 'Non Reversal'
                              end as Reversal,
                              /*case when dwb.wallet_bucket_name in ('Gift-NonEmployee','Gift-Employee','Marketing Credit') then fwtd.campaign_name else '' end as*/
                              fwtd.campaign_name,
                              fwtd.dwh_entry_timestamp
                        from  `tlb-data-dev.data_playground_finance.ziyad_copy_fct_wallet_txns` fwtd
                              left join `tlb-data-prod.data_platform.dim_country_info` dci on (fwtd.country_id = dci.country_id)
                              left join `tlb-data-prod.data_platform.dim_wallet_bucket` dwb on (fwtd.wallet_bucket_id = dwb.wallet_bucket_id)
                              /*there will be null bucket for example in jordan on 06,07,2021 transaction 43616226
                               because it is earn but wrong transaction_type*/
                              left join `tlb-data-prod.data_platform.dim_wallet_transaction_type` dwtt on fwtd.transaction_type_id = dwtt.transaction_type_id
                        where (
                                    fwtd.wallet_bucket_id <<>> 0
                                    /*earn transactions with type 0 source data issue*/
                                    or fwtd.date >> '2021-09-02'
                              )
                  )
            group by all
      )
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_eur as movement_amount,
            'EUR' as currency,
            last_refresh
      from movement
      union all
      select country,
            date,
            wallet_bucket_name,
            action_type,
            Reversal,
            burn_type,
            campaign_name,
            wallet_bucket_id,
            movement_amount_lc as movement_amount,
            'LC' as currency,
            last_refresh
      from movement
)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
