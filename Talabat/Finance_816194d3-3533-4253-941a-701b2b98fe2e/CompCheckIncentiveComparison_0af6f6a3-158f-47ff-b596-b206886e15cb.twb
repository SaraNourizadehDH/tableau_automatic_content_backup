      <aliases enabled='yes' />
      <column caption='data_incentive' datatype='real' name='[Calculation_4887461172750336000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [data_source]= &apos;data&apos; THEN [incentive_amount] else 0 end))' />
      </column>
      <column caption='billing_incentive' datatype='real' name='[Calculation_4887461172750618625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [data_source]&lt;&gt; &apos;data&apos; THEN [incentive_amount] else 0 end))' />
      </column>
      <column caption='Delta' datatype='real' hidden='true' name='[Calculation_4887461173127028739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([incentive_amount])) - LOOKUP(ZN(SUM([incentive_amount])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='flag' datatype='boolean' name='[Calculation_6021594223354765312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='zn(ROUND(abs([Calculation_4887461172750618625])))=zn(ROUND(abs([Calculation_4887461172750336000])))' />
      </column>
