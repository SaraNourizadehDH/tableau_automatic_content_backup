      <aliases enabled='yes' />
      <column datatype='string' hidden='true' name='[ACCOUNT_DISPLAY_VALUE]' role='dimension' type='nominal' />
      <column caption='Billing Team Undertaken' datatype='string' hidden='true' name='[BILLING_TEAM_UNDERTAKEN]' role='dimension' type='nominal' />
      <column caption='Component' datatype='string' hidden='true' name='[COMPONENT]' role='dimension' type='nominal' />
      <column caption='Dynamics Chain' datatype='string' name='[Calculation_2213378492450164736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(TRIM([dynamics_chain_name]))' />
      </column>
      <column caption='Dynamics ID' datatype='string' name='[Calculation_2213378492450283521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([dynamics_chain_id])' />
      </column>
      <column caption='is_reversal' datatype='boolean' name='[Calculation_2584714360658685986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(UPPER([voucher_note]), &quot;REVERSE&quot;) OR&#10;    CONTAINS(UPPER([voucher_note]), &quot;REFUND&quot;) OR&#10;    CONTAINS(UPPER([voucher_note]), &quot;CN&quot;) OR&#10;    CONTAINS(UPPER([voucher_note]), &quot;ADJUSTMENT&quot;) OR&#10;    CONTAINS(UPPER([voucher_note]), &quot;REVERSAL&quot;)' />
      </column>
      <column caption='IsAgency' datatype='boolean' name='[Calculation_2702370890767945728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(LEFT(UPPER([Calculation_2213378492450283521]),3)=&apos;AGE&apos;) THEN TRUE ELSE FALSE END' />
      </column>
