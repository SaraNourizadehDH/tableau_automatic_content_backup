          <calculation class='tableau' formula='CASE [ledger_account_number] &#10;    WHEN &apos;750101014&apos; THEN &apos;ADV. PARTNERSHIP&apos;&#10;    WHEN &apos;750101015&apos; THEN &apos;ADV. PARTNERSHIP&apos;&#10;&#10;    WHEN &apos;730101211&apos; THEN &apos;Banner ADV. REVENUE FROM PLATFORM&apos;&#10;    WHEN &apos;750101007&apos; THEN &apos;Banner ADV. REVENUE FROM PLATFORM&apos;&#10;    WHEN &apos;750101008&apos; THEN &apos;Banner ADV. REVENUE FROM PLATFORM&apos;&#10;    WHEN &apos;750101009&apos; THEN &apos;Banner ADV. REVENUE FROM PLATFORM&apos;&#10;    WHEN &apos;750101010&apos; THEN &apos;Banner ADV. REVENUE FROM PLATFORM&apos;&#10;&#10;    WHEN &apos;750101017&apos; THEN &apos;Featured Products&apos;&#10;    WHEN &apos;750101018&apos; THEN &apos;Featured Products&apos;&#10;&#10;    WHEN &apos;750101004&apos; THEN &apos;Joker Revenue&apos;&#10;    WHEN &apos;750101005&apos; THEN &apos;Joker Revenue&apos;&#10;&#10;    WHEN &apos;750101011&apos; THEN &apos;Offline Ad&apos;&#10;    WHEN &apos;750101012&apos; THEN &apos;Offline Ad&apos;&#10;&#10;    WHEN &apos;750104001&apos; THEN &apos;Subscription Fee&apos;&#10;    WHEN &apos;750104002&apos; THEN &apos;Subscription Fee&apos;&#10;    WHEN &apos;750104004&apos; THEN &apos;Subscription Fee&apos;&#10;    WHEN &apos;750104007&apos; THEN &apos;Subscription Fee&apos;&#10;    WHEN &apos;750104011&apos; THEN &apos;Subscription Fee&apos;&#10;    WHEN &apos;750104012&apos; THEN &apos;Subscription Fee&apos;&#10;&#10;    WHEN &apos;750105004&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105005&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105007&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105011&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105014&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105017&apos; THEN &apos;Start package&apos;&#10;    WHEN &apos;750105018&apos; THEN &apos;Start package&apos;&#10;&#10;    WHEN &apos;750101001&apos; THEN &apos