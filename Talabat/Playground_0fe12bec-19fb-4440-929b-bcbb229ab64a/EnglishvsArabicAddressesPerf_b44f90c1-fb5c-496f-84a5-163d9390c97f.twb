      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Egypt&quot;' />
      </semantic-values>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='eng_35' />
        <field-sort-custom-order field='eng_60' />
        <field-sort-custom-order field='eng_85' />
        <field-sort-custom-order field='delivery_arrangement' />
        <field-sort-custom-order field='successful_o' />
        <field-sort-custom-order field='Calculation_74027961644105730' />
        <field-sort-custom-order field='net_total' />
        <field-sort-custom-order field='net_failed' />
        <field-sort-custom-order field='Calculation_74027961642590208' />
        <field-sort-custom-order field='on_time_n' />
        <field-sort-custom-order field='Calculation_74027961642950657' />
        <field-sort-custom-order field='on_time_d' />
      </field-sort-info>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_61BB23DD30224BDE93F732F5A518ED75'>
            <properties context=''>
              <relation connection='bigquery.013qaus0d5glt311a7p9u014thga' name='Custom SQL Query' type='text'><![CDATA[WITH address AS (select *,
  case when percentage_of_arabic<<=0.35 then true else false end eng_35, --english address more than 35%, arabic less than or equal 35% 
  case when percentage_of_arabic<<=0.60 then true else false end eng_60,
  case when percentage_of_arabic<<=0.85 then true else false end eng_85,
  from(
    select *,
      length(trim(no_eng_num_addr)) addr_len, 
      length(trim(arabic))+length(eng_num) ar_len,
      SAFE_DIVIDE(IFNULL(length(trim(arabic)),0)+length(eng_num), length(trim(addr))) percentage_of_arabic
    from(
      select order_id, addr, 
        REGEXP_REPLACE(addr, '[0-9]+', '') no_eng_num_addr, 
        array_to_string(REGEXP_EXTRACT_All(addr, r'([\p{Arabic}]+)'), ' ') arabic,
        regexp_replace(addr, '[^0-9]', '') eng_num
      from(
        select distinct order_id,
          concat(delivery_building_no, " ", delivery_floor, " ", delivery_street, " ", delivery_suite) addr, 
          
        from `tlb-data-prod.data_platform.fct_order_info` o
        where o.country_id=9 and not o.is_test and lower(delivery_arrangement)!='pickup'
          and o.order_date>>=date_sub(current_date(), INTERVAL 3 month)
        order by 1)))
        )

, eng_35 as(
  select case when eng_35 then 'Arabic <<= 35%'
  when not eng_35 then 'Arabic >> 35%'
  -- when eng_60 then 'Arabic <<= 60%'
  -- when not eng_60 then 'Arabic >> 60%'
  -- when eng_85 then 'Arabic <<= 85%'
  -- when not eng_85 then 'Arabic >> 85%' 
  end Address
  ,delivery_arrangement
  ,count(distinct case when o.is_successful then o.order_id end) successful_o
  ,count(distinct case when s.is_net then o.order_id end) as net_total 
  ,count(distinct case when s.is_net and not o.is_successful then o.order_id end) as net_failed
  ,count(if(g.order_delay>>=-600 and g.order_delay<<=600 and g.is_rider_order, o.order_id, null)) on_time_n
  ,count(case when g.is_rider_order then g.order_delay end) on_time_d
  ,count(distinct o.order_date) days

from `tlb-data-prod.data_platform.fct_order_info` o
right join address a using(order_id)
left join (SELECT *, ROW_NUMBER() OVER(PARTITION BY order_id order by COALESCE(DATE(primary_rider_dropped_off_at, timezone), DATE(created_at, timezone)) desc) AS RN  
  FROM `tlb-data-prod.data_platform.fct_logistics_order`) g on o.order_id = g.order_id and is_rider_order and RN=1 
left join `tlb-data-prod.data_platform.dim_order_status` s on o.order_status_id = s.order_status_id 

where o.country_id=9 and not o.is_test and lower(delivery_arrangement)!='pickup'
  and o.order_date>>=date_sub(current_date(), INTERVAL 3 month)
group by 1,2
)

, eng_60 as(
  select case 
  -- when eng_35 then 'Arabic <<= 35%'
  -- when not eng_35 then 'Arabic >> 35%'
  when eng_60 then 'Arabic <<= 60%'
  when not eng_60 then 'Arabic >> 60%'
  -- when eng_85 then 'Arabic <<= 85%'
  -- when not eng_85 then 'Arabic >> 85%' 
  end Address_60
  ,delivery_arrangement
  ,count(distinct case when o.is_successful then o.order_id end) successful_o
  ,count(distinct case when s.is_net then o.order_id end) as net_total 
  ,count(distinct case when s.is_net and not o.is_successful then o.order_id end) as net_failed
  ,count(if(g.order_delay>>=-600 and g.order_delay<<=600 and g.is_rider_order, o.order_id, null)) on_time_n
  ,count(case when g.is_rider_order then g.order_delay end) on_time_d
  ,count(distinct o.order_date) days

from `tlb-data-prod.data_platform.fct_order_info` o
right join address a using(order_id)
left join (SELECT *, ROW_NUMBER() OVER(PARTITION BY order_id order by COALESCE(DATE(primary_rider_dropped_off_at, timezone), DATE(created_at, timezone)) desc) AS RN  
  FROM `tlb-data-prod.data_platform.fct_logistics_order`) g on o.order_id = g.order_id and is_rider_order and RN=1 
left join `tlb-data-prod.data_platform.dim_order_status` s on o.order_status_id = s.order_status_id 

where o.country_id=9 and not o.is_test and lower(delivery_arrangement)!='pickup'
  and o.order_date>>=date_sub(current_date(), INTERVAL 3 month)
group by 1,2
)

, eng_85 as(
  select case 
  -- when eng_35 then 'Arabic <<= 35%'
  -- when not eng_35 then 'Arabic >> 35%'
  -- when eng_60 then 'Arabic <<= 60%'
  -- when not eng_60 then 'Arabic >> 60%'
  when eng_85 then 'Arabic <<= 85%'
  when not eng_85 then 'Arabic >> 85%' 
  end Address_85
  ,delivery_arrangement
  ,count(distinct case when o.is_successful then o.order_id end) successful_o
  ,count(distinct case when s.is_net then o.order_id end) as net_total 
  ,count(distinct case when s.is_net and not o.is_successful then o.order_id end) as net_failed
  ,count(if(g.order_delay>>=-600 and g.order_delay<<=600 and g.is_rider_order, o.order_id, null)) on_time_n
  ,count(case when g.is_rider_order then g.order_delay end) on_time_d
  ,count(distinct o.order_date) days

from `tlb-data-prod.data_platform.fct_order_info` o
right join address a using(order_id)
left join (SELECT *, ROW_NUMBER() OVER(PARTITION BY order_id order by COALESCE(DATE(primary_rider_dropped_off_at, timezone), DATE(created_at, timezone)) desc) AS RN  
  FROM `tlb-data-prod.data_platform.fct_logistics_order`) g on o.order_id = g.order_id and is_rider_order and RN=1 
left join `tlb-data-prod.data_platform.dim_order_status` s on o.order_status_id = s.order_status_id 

where o.country_id=9 and not o.is_test and lower(delivery_arrangement)!='pickup'
  and o.order_date>>=date_sub(current_date(), INTERVAL 3 month)
group by 1,2
)


select * from eng_35
union all
select * from eng_60
union all
select * from eng_85]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
