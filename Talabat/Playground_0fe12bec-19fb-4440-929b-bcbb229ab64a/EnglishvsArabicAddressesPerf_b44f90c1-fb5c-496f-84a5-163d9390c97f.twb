      <column caption='OOT%' datatype='real' default-format='p0.0%' name='[Calculation_74027961642950657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([on_time_n])/sum([on_time_d])' />
      </column>
      <column caption='AVG. Daily Successful' datatype='real' name='[Calculation_74027961644105730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_o])/MIN([days])' />
      </column>
      <column caption='no. of days' datatype='integer' name='[Calculation_74027961645035523]' role='measure' type='quantitative'>
