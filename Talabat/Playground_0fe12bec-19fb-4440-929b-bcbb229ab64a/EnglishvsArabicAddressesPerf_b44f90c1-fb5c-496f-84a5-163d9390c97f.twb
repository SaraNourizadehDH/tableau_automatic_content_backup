    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.0cwdu081mhu46m17xanql16zm5yj' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.013qaus0d5glt311a7p9u014thga'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hoda.tomoum@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
