        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1y325p21o06s9z1ehdv9m1985754' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  DISTINCT analytical_customer_id cust_id,
  MAX(CASE WHEN is_nfv THEN 1 ELSE 0 END) NFV,
  MAX(CASE WHEN is_darkstore THEN 1 ELSE 0 END) TMart,
  MAX(CASE WHEN NOT is_non_food THEN 1 ELSE 0 END) Food,

FROM `tlb-data-prod.data_platform.fct_order_info`
WHERE is_successful AND NOT is_test AND country_id = 9
   AND order_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 6 MONTH)
    AND order_date BETWEEN <[Parameters].[Parameter 1]> AND <[Parameters].[Parameter 2]>


GROUP BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1y325p21o06s9z1ehdv9m1985754' name='Custom SQL Query' type='text'><![CDATA[SELECT 
