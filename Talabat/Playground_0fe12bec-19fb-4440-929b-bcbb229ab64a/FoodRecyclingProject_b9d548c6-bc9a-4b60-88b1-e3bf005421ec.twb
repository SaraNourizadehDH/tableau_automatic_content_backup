        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07ms3s9185utiv15h75620z8ky2g' name='Custom SQL Query' type='text'>with s as (
  SELECT DISTINCT item_id, brand_name, product_sku, item_category_name
  FROM `tlb-data-prod.data_platform.dim_item`
  WHERE REGEXP_CONTAINS(LOWER(item_name_en), r&apos;\b(can|cans|redbull|red bull|red-bull)\b&apos;)
  AND LOWER(item_name_en) NOT LIKE &quot; %can&apos;t% &quot;
  GROUP BY 1,2,3,4
)
SELECT
  dl.cluster_name cluster, 
  dl.zone_name_final,
  v.chain_name_en,
  v.name_en,
  item_name_en,
  o.order_date,
  o.order_id,
  delivered_quantity,

FROM s 
LEFT JOIN `tlb-data-prod.data_platform.fct_order_item` oi
  ON oi.item_id = s.item_id
LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` o
  ON o.order_id = oi.order_id
LEFT JOIN `tlb-data-prod.data_platform.fct_order_item_choice`  oic
  ON (oi.item_id = oic.parent_item_id)
  AND (oi.order_id = oic.order_id)
  AND (original_choice_price_lc IS NOT NULL)
LEFT JOIN `tlb-data-prod.data_platform.dim_item` i
  ON i.item_id = oi.item_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` vi
  ON o.vendor_id = vi.vendor_id
  AND NOT vi.is_kitchen
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` v
  ON vi.vendor_id = v.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.sq_dim_location_eg` dl
  ON o.delivery_location_id = dl.location_id

WHERE o.is_successful
AND NOT o.is_test
AND NOT o.is_abandoned
AND NOT o.is_non_food
AND o.country_id = 9
AND o.order_date &gt;&gt;= &apos;2025-01-01&apos;
AND NOT vi.is_kitchen

GROUP BY ALL
ORDER BY delivered_quantity DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.07ms3s9185utiv15h75620z8ky2g' name='Custom SQL Query' type='text'>with s as (
  SELECT DISTINCT item_id, brand_name, product_sku, item_category_name
  FROM `tlb-data-prod.data_platform.dim_item`
  WHERE REGEXP_CONTAINS(LOWER(item_name_en), r&apos;\b(can|cans|redbull|red bull|red-bull)\b&apos;)
  AND LOWER(item_name_en) NOT LIKE &quot; %can&apos;t% &quot;
  GROUP BY 1,2,3,4
)
SELECT
  dl.cluster_name cluster, 
  dl.zone_name_final,
  v.chain_name_en,
  v.name_en,
  item_name_en,
  o.order_date,
  o.order_id,
  delivered_quantity,

FROM s 
LEFT JOIN `tlb-data-prod.data_platform.fct_order_item` oi
  ON oi.item_id = s.item_id
LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` o
  ON o.order_id = oi.order_id
LEFT JOIN `tlb-data-prod.data_platform.fct_order_item_choice`  oic
  ON (oi.item_id = oic.parent_item_id)
  AND (oi.order_id = oic.order_id)
  AND (original_choice_price_lc IS NOT NULL)
LEFT JOIN `tlb-data-prod.data_platform.dim_item` i
  ON i.item_id = oi.item_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` vi
  ON o.vendor_id = vi.vendor_id
  AND NOT vi.is_kitchen
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` v
  ON vi.vendor_id = v.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.sq_dim_location_eg` dl
  ON o.delivery_location_id = dl.location_id

WHERE o.is_successful
AND NOT o.is_test
AND NOT o.is_abandoned
AND NOT o.is_non_food
AND o.country_id = 9
AND o.order_date &gt;&gt;= &apos;2025-01-01&apos;
AND NOT vi.is_kitchen

GROUP BY ALL
ORDER BY delivered_quantity DESC</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
