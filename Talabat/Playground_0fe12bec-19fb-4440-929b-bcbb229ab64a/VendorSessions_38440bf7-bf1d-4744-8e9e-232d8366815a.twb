      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_709BE88FCDEB413CAD2F5C39AD8D1676'>
            <properties context=''>
              <relation connection='bigquery.0un7bmq1qd3dzl1akman10h3zezt' name='Custom SQL Query' type='text'><![CDATA[SELECT 
chain_id
,chain_name
,clicked_vendor_id
,vendor_name
,count(distinct session_id)/count(distinct date) daily_sessions
,count( distinct case when added_to_cart is TRUE then session_id end)/count(distinct date) daily_added_to_cart_sessions
,count( distinct case when added_to_cart is TRUE then session_id end) added_to_cart_sessions
,count(distinct session_id) total_sessions
,count(distinct account_id)/count(distinct date) total_users
,sum(time_spent_mins) total_time_spent_mins
,count(distinct sub_session_id) sub_sess_count
FROM(
SELECT 
S.date
,S.session_id
,SV.sub_session_id
,S.added_to_cart
,S.account_id
,CH.chain_id
,CH.chain_name
,clicked_vendor_id
,vendor_name
,TIMESTAMP_DIFF(SV.sub_session_end_time, SV.sub_session_start_time, MINUTE) time_spent_mins
FROM `tlb-data-prod.data_platform.fct_session` S
left join  `tlb-data-prod.data_platform.fct_sub_session_click_vendor` SV on S.session_id=SV.session_id
right join `tlb-data-prod.data_platform.dim_vendor_info` V on SV.clicked_vendor_id= V.vendor_id
left join `tlb-data-prod.data_platform.dim_chain` CH on V.chain_id = CH.chain_id
-- right join `tlb-data-prod.data_platform.dim_customer_info` C on S.account_id= C.latest_account_id
WHERE SV.user_selected_country='Egypt' and SV.user_selected_city IS NOT NULL 
and SV.user_selected_area IS NOT NULL
and  S.date >>= date(current_date - interval 1 month) --and C.email = 'suhaila.alkholy@talabat.com'
and not V.is_non_food
Group by 1,2,3,4,5,6,7,8,9,SV.sub_session_end_time, SV.sub_session_start_time
having time_spent_mins <<= <[Parameters].[Parameter 4]>
)
Group by 1,2,3,4
order by 1,2 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
