            <column caption='total_orders_per_week' datatype='integer' name='[Calculation_1100285730483576833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [week]: SUM([num_orders])}' />
            </column>
            <column caption='orders_pct' datatype='real' default-format='p0.0%' name='[Calculation_1100285730483916803]' role='measure' type='quantitative'>
