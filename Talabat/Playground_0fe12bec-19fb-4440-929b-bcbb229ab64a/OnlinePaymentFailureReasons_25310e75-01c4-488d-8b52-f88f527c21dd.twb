        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1iq8tqe0f1bbtc1evt61a106ku3c' name='Custom SQL Query' type='text'>SELECT DATE_TRUNC(order_time, WEEK) week, o.is_successful is_successful_order, reason, payment_gateway_response_description, t.is_successful is_successful_transaction, COUNT(DISTINCT(order_id)) num_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.dim_order_fail_reason` fail using(order_fail_reason_id)&#13;
left join `tlb-data-prod.data_platform_fraud.fct_card_transaction` t on cast(o.transaction_id as string) = t.transaction_id&#13;
WHERE o.country_id=9 AND NOT is_test AND order_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
GROUP BY 1, 2, 3, 4, 5&#13;
ORDER BY 1 DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1iq8tqe0f1bbtc1evt61a106ku3c' name='Custom SQL Query' type='text'>SELECT DATE_TRUNC(order_time, WEEK) week, o.is_successful is_successful_order, reason, payment_gateway_response_description, t.is_successful is_successful_transaction, COUNT(DISTINCT(order_id)) num_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.dim_order_fail_reason` fail using(order_fail_reason_id)&#13;
left join `tlb-data-prod.data_platform_fraud.fct_card_transaction` t on cast(o.transaction_id as string) = t.transaction_id&#13;
WHERE o.country_id=9 AND NOT is_test AND order_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
GROUP BY 1, 2, 3, 4, 5&#13;
ORDER BY 1 DESC</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
