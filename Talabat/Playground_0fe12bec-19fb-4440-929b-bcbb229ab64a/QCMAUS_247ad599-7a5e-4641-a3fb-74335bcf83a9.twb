select date_trunc(order_date, month) o_month,
  count(distinct analytical_customer_id) maus,
  count(distinct case when is_non_food then analytical_customer_id end) qc_maus,
  count(distinct case when tmart>>0 and nfv<<=0 then analytical_customer_id end) tmart_only_maus,
  count(distinct case when nfv>>0 and tmart<<=0 then analytical_customer_id end) nfv_only_maus,
  count(distinct case when nfv>>0 and tmart>>0 then analytical_customer_id end) nfv_tmart_maus,
  count(distinct case when tmart>>0 then analytical_customer_id end) tmart_maus,
  count(distinct case when nfv>>0 then analytical_customer_id end) nfv_maus,
 
  
from `tlb-data-prod.data_platform.fct_order_info` o
left join customers c on date_trunc(o.order_date, month)=c.o_month and o.analytical_customer_id=c.cust_id
where country_id = 9 and is_successful and not is_test 
  and date_trunc(o.order_date, month)>>='2020-01-01'
  and o.analytical_customer_id is not null
group by 1
-- order by 1 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
