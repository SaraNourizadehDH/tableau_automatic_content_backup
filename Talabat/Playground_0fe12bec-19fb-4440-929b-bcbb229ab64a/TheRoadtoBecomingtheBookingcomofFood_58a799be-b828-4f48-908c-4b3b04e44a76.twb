      <aliases enabled='yes' />
      <column caption='Calculation1 (copy)' datatype='real' name='[Calculation1 (copy)_1096908019289948162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_mean_rev_city]) + SUM([orders_max_rev_city]))/ 2' />
      </column>
      <column caption='Daily Lost Orders' datatype='real' name='[Calculation_1096908019287728129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//((SUM([Orders Mean Rev Zone]) + SUM([Orders Max Rev Zone])) / 2)&#13;&#10;&#13;&#10;((0.005 + ([totalScore] - 3) * 0.01) * [reviewsCount]) + 14' />
      </column>
      <column caption='Reviews' datatype='string' name='[Calculation_1297599682220011520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE(STR([reviewsCount]),&quot;\d{1,3}(?=(\d{3})+(?!\d))&quot;,&quot;$0,&quot;)' />
      </column>
      <column caption='Score' datatype='string' name='[Calculation_1297599682220281857]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(ATTR([totalScore]), 1))' />
      </column>
      <column caption='Paramter' datatype='string' name='[Calculation_1297599682254262276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Zone&quot; THEN [zone_name]&#13;&#10;WHEN &quot;City&quot; THEN [city]&#13;&#10;WHEN &quot;Cluster&quot; then [cluster_name]&#13;&#10;WHEN &quot;Category&quot; THEN [categoryName]&#13;&#10;WHEN &quot;Rating&quot; THEN [score_bucket]&#13;&#10;WHEN &quot;Null&quot; THEN NULL&#13;&#10;END' />
      </column>
      <column caption='Is Restaurant / Cafe' datatype='boolean' name='[Calculation_1330532253190430720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([categoryName]), &apos;restaurant&apos;)&#13;&#10;OR LOWER([categoryName]) = &apos;cafe&apos;&#13;&#10;OR LOWER([categoryName]) = &apos;coffee shop&apos;&#13;&#10;THEN TRUE else FALSE&#13;&#10;END' />
      </column>
      <column caption='Chain Daily Searches' datatype='real' name='[Calculation_589127171148251136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([daily_subsessions])' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_749286430427648000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([mapped_sk]) THEN [cleaned_title_3] ELSE [mapped_sk] END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='final' datatype='table' name='[__tableau_internal_object_id__].[final_E5EE04E7B06D4E81BAFB711634872D00]' role='measure' type='quantitative' />
      <column caption='Category Name' datatype='string' name='[categoryName]' role='dimension' type='nominal' />
      <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
      <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Cluster Name' datatype='string' name='[cluster_name]' role='dimension' type='nominal' />
      <column caption='Geometry' datatype='string' name='[geometry]' role='dimension' type='nominal' />
