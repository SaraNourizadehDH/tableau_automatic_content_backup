        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1998ci6114crro1es3g4s1ev3ufi' name='TP SCORE' table='[&apos;TP SCORE$&apos;]' type='table'>
          <columns gridOrigin='A1:C10001:no:A1:C10001:0' header='yes' outcome='2'>
            <column datatype='datetime' name='DATE' ordinal='0' />
