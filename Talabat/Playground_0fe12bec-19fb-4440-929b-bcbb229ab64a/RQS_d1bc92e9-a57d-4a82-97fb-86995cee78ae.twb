            <column caption='Rider CR' datatype='real' default-format='p0.0%' name='[Calculation_1069886433291280384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((sum(contacts)/sum([gross_orders])))' />
            </column>
            <column caption='Vendor Rating' datatype='real' default-format='p0.0%' name='[Calculation_1069886433293643777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([gross_orders])-SUM([neg_vendor_rating]))/SUM([gross_orders]))' />
            </column>
            <column caption='Customer Rating' datatype='real' default-format='p0.0%' name='[Calculation_1069886433313763330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(((&#13;&#10;    (&#13;&#10;        (SUM(R1)*1)&#13;&#10;        +(SUM(R2)*2)&#13;&#10;        +(SUM(R3)*3)&#13;&#10;        +(SUM(R4)*4)&#13;&#10;        +(SUM(R5)*5)&#13;&#10;        +(SUM(R_null)*4)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    SUM([successful_orders]))&#13;&#10;-1)*0.25)' />
            </column>
            <column caption='VR2' datatype='real' default-format='p0.0%' name='[Calculation_1185009656932782085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1069886433293643777]-min([VR2 (copy)_1185009656935645190])) / (1-min([VR2 (copy)_1185009656935645190]))' />
            </column>
            <column caption='TPS' datatype='real' default-format='p0.0%' name='[Calculation_137922796040314881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(AVG([Score]))' />
            </column>
            <column caption='RQS' datatype='real' default-format='p0.0%' name='[Calculation_137922796040978434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((1-[Calculation_1069886433291280384])*0.15)&#13;&#10;+([Calculation_1069886433313763330]*0.1)&#13;&#10;+((1-[Critical Cases (copy)_750130867917852674])*0.25)&#13;&#10;&#13;&#10;+([Calculation_137922796040314881]*0.25)&#13;&#10;&#13;&#10;+([Calculation_1069886433293643777]*0.25)' />
            </column>
            <column caption='CC Count' datatype='integer' name='[Calculation_750130867916476417]' role='measure' type='quantitative'>
