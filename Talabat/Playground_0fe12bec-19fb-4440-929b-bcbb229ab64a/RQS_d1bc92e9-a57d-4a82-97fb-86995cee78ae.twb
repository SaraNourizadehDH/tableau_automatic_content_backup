                  <column datatype='string' name='impacted_vendors' ordinal='17' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Valid Critical Cases_F7E6DA021D23480C93517C279ED48118' table='[Extract].[Valid Critical Cases_F7E6DA021D23480C93517C279ED48118]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_B259CB92114E43B9B6A8B4A3A53F8938'>
            <properties context=''>
              <relation connection='bigquery.15osjhp18dtcmv18wwm6x08di52u' name='Custom SQL Query' type='text'>WITH contacts AS (&#13;
  SELECT c.order_id, COUNT(contact_id) total_contacts&#13;
  FROM `tlb-data-prod.data_platform.fct_contact` c&#13;
  LEFT JOIN `tlb-data-prod.data_platform.dim_contact_reason` r on c.contact_reason_id=r.contact_reason_id  &#13;
  WHERE country_id=9 AND stakeholder_id=1&#13;
    AND contact_reason_l3 IN (&apos;Order never arrived&apos;, &apos;Inappropriate behaviour&apos;, &apos;Missing item&apos;, &apos;Order marked as delivered but didn\&apos;t receive&apos;, &apos;Wrong order&apos;, &apos;Spilled food&apos;, &apos;Damaged item&apos;, &apos;Money collection issue&apos;, &apos;Rider related&apos;)&#13;
  GROUP BY 1&#13;
)&#13;
&#13;
SELECT o.order_date, cast(log.primary_rider_id as string) primary_rider_id, &#13;
  COUNT(DISTINCT o.order_id) gross_orders,&#13;
  SUM(CASE WHEN o.is_successful THEN 1 ELSE 0 END) successful_orders,&#13;
  SUM(c.total_contacts) contacts,&#13;
  SUM(CASE WHEN rate.driver_rating=5 AND o.is_successful THEN 1 ELSE 0 END) R5,&#13;
  SUM(CASE WHEN rate.driver_rating=4 AND o.is_successful THEN 1 ELSE 0 END) R4,&#13;
  SUM(CASE WHEN rate.driver_rating=3 AND o.is_successful THEN 1 ELSE 0 END) R3,&#13;
  SUM(CASE WHEN rate.driver_rating=2 AND o.is_successful THEN 1 ELSE 0 END) R2,&#13;
  SUM(CASE WHEN rate.driver_rating=1 AND o.is_successful THEN 1 ELSE 0 END) R1,&#13;
  SUM(CASE WHEN (rate.driver_rating=0 OR rate.driver_rating IS NULL) AND o.is_successful THEN 1 ELSE 0 END) R_null,&#13;
  --SUM(CASE WHEN v_rate.rider_review=&apos;negative&apos; THEN 1 ELSE 0 END) neg_vendor_rating,&#13;
  SUM(CASE WHEN log.vendor_rider_review_emotion=&apos;negative&apos; THEN 1 ELSE 0 END) neg_vendor_rating&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
LEFT JOIN (SELECT *, ROW_NUMBER() OVER(PARTITION BY order_id order by created_at desc) AS RN &#13;
  FROM `tlb-data-prod.data_platform.fct_logistics_order`) log ON o.order_id = log.order_id and is_rider_order and RN=1&#13;
LEFT JOIN `tlb-data-prod.data_platform.fct_rating` rate ON rate.order_id=o.order_id&#13;
LEFT JOIN contacts c ON c.order_id=cast(o.order_id as string)&#13;
-- LEFT JOIN (SELECT orders.id id, rider_review.emotion rider_review&#13;
--   FROM `fulfillment-dwh-production.curated_data_shared.vendor_client_events`&#13;
--   WHERE event_name IN (&apos;performance_submit_rider_review_btn_clicked&apos;)) v_rate ON v_rate.id = log.vendor_order_id&#13;
&#13;
WHERE o.country_id=9 AND NOT o.is_test AND o.is_tgo&#13;
 AND o.order_date&gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 3 MONTH)&#13;
&#13;
GROUP BY 1,2</relation>
            </properties>
            <properties context='extract'>
              <relation name='_B259CB92114E43B9B6A8B4A3A53F8938' table='[Extract].[_B259CB92114E43B9B6A8B4A3A53F8938]' type='table' />
            </properties>
          </object>
        </objects>
