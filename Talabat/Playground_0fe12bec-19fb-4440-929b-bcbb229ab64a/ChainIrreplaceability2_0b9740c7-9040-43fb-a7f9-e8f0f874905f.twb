left join `tlb-data-prod.data_platform.dim_chain` ch on c.prefered_chain_id=ch.chain_id 
left join chain_orders co on co.chain_id=c.prefered_chain_id 

where prefered_chain_percent>>0.3 and account_id in (select distinct account_id from customers_with_10_orders)

group by prefered_chain_name, prefered_chain_id, main_cuisine 
--order by 3 desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
