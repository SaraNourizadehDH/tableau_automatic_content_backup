        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0um2o4212sk3we1g5ho5111k452m' name='Custom SQL Query' type='text'><![CDATA[with n_orders as  
(
  select 
  account_id,
  count(*) as orders,

  from `tlb-data-prod.data_platform.fct_order_info`
  where order_date>>='2020-09-01' and country_id=9 and is_successful and not is_test 
  group by 1 
),

customers_with_10_orders as
(
  select account_id
  from n_orders
  where orders>>=10
),

chain_orders as   
(
  select chain_id, count(*) as orders, count(*) / count(distinct order_date) as avg_daily_orders
  from `tlb-data-prod.data_platform.fct_order_info`
  where order_date>>='2023-05-01' and order_date<<='2023-09-30' and country_id=9 and is_successful and not is_test 
  group by chain_id
)

SELECT 

prefered_chain_name,
cast(prefered_chain_id as string) as prefered_chain_id,
ch.main_cuisine,
count(*) as num_customers,
sum(case 
    when New_Health_flag='VIP' then 10
    when New_Health_flag='Healthy' then 3
    when New_Health_flag='Semi-Healthy' then 1
    else 0 
    end) as weighted_count,

min(co.orders) as orders,
min(co.avg_daily_orders) as avg_daily_orders,

FROM `tlb-data-dev.performance_management_egypt.CT_dim_customer` c
left join `tlb-data-prod.data_platform.dim_chain` ch on c.prefered_chain_id=ch.chain_id 
left join chain_orders co on co.chain_id=c.prefered_chain_id 

where prefered_chain_percent>>0.3 and account_id in (select distinct account_id from customers_with_10_orders)

group by prefered_chain_name, prefered_chain_id, main_cuisine 
--order by 3 desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0um2o4212sk3we1g5ho5111k452m' name='Custom SQL Query' type='text'><![CDATA[with n_orders as  
