      <column caption='% Change (Non-tPro): AOV' datatype='real' default-format='p0.0%' name='[% Change: AOV (copy)_1364309256574529549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Jan Non-tPro AOV (copy)_1364309256573583371]/[Jan AOV (copy)_1364309256573280266]-1' />
      </column>
      <column caption='% Change (Non-tPro): Drop-Off Distance' datatype='real' default-format='p0.0%' name='[% Change: Drop-Off Distance (copy)_1364309256571293701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum({fixed[Calculation_768989680186593280]:sum([nontpro_jul_drop_off_dist])})/sum({fixed[Calculation_768989680186593280]:sum([nontpro_jul_orders])}))&#13;&#10;/&#13;&#10;(sum({fixed[Calculation_768989680186593280]:sum([nontpro_jan_drop_off_dist])})/sum({fixed[Calculation_768989680186593280]:sum([nontpro_jan_orders])}))&#13;&#10;-1' />
      </column>
      <column caption='% Change: AOV' datatype='real' default-format='p0.0%' name='[% Change: Orders (copy)_1364309256570421252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Jan AOV (copy)_610519268599013393]/[Calculation_610519268597985296]-1' />
