  <worksheets>
    <worksheet name='ROI of July tPro'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.12pqmn61o9lc2h1e41o8a1u0exjz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivery Arrangement&quot;'>
              <calculation class='tableau' formula='&quot;Delivery Arrangement&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12pqmn61o9lc2h1e41o8a1u0exjz'>
            <column caption='% Change (Non-tPro): Orders' datatype='real' default-format='p0.0%' name='[% Change (Non-tPro): AOV (copy) (copy)_1364309256574685198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Jan Non-tPro Orders (Avg. Daily) (copy)_1364309256572411911]/[Jan Orders (Avg. Daily) (copy)_1364309256572252166]-1' />
            </column>
            <column caption='% Change (Non-tPro): GMV' datatype='real' default-format='p0.0%' name='[% Change (Non-tPro): Orders (copy)_1364309256574890000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Jan Non- tPro GMV (Avg. Daily) (copy)_1364309256572612616]/[Jan GMV (Avg. Daily) (copy)_610519268589424646]-1' />
            </column>
            <column caption='% Change (Non-tPro): AOV' datatype='real' default-format='p0.0%' name='[% Change: AOV (copy)_1364309256574529549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Jan Non-tPro AOV (copy)_1364309256573583371]/[Jan AOV (copy)_1364309256573280266]-1' />
            </column>
            <column caption='% Change (Non-tPro): Drop-Off Distance' datatype='real' default-format='p0.0%' name='[% Change: Drop-Off Distance (copy)_1364309256571293701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum({fixed[Calculation_768989680186593280]:sum([nontpro_jul_drop_off_dist])})/sum({fixed[Calculation_768989680186593280]:sum([nontpro_jul_orders])}))&#13;&#10;/&#13;&#10;(sum({fixed[Calculation_768989680186593280]:sum([nontpro_jan_drop_off_dist])})/sum({fixed[Calculation_768989680186593280]:sum([nontpro_jan_orders])}))&#13;&#10;-1' />
            </column>
            <column caption='% Change: AOV' datatype='real' default-format='p0.0%' name='[% Change: Orders (copy)_1364309256570421252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Jan AOV (copy)_610519268599013393]/[Calculation_610519268597985296]-1' />
            </column>
            <column caption='% Change: tPro GMV' datatype='real' default-format='p0.0%' name='[% Change: Orders (copy)_610519268588773381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Jan GMV (Avg. Daily) (copy)_610519268586541059]/[Jan Orders (Avg. Daily) (copy)_610519268586364930]-1' />
            </column>
            <column caption='ROI %' datatype='real' default-format='p0.0%' name='[% Change: Orders (copy)_610519268597604367]' role='measure' type='quantitative'>
