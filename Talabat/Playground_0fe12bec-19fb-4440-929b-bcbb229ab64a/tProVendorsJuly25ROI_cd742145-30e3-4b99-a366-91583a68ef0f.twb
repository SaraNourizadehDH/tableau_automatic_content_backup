        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1sdg7d61fuhuu611im83w08dlc8j'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hoda.tomoum@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1sdg7d61fuhuu611im83w08dlc8j' name='Custom SQL Query' type='text'><![CDATA[with jan_vendors as(
  select vendor_id, 
    count(distinct order_id) orders,
    sum(gmv_amount_lc) gmv,
    sum(delivery_birdseye_distance_m) dist,
    count(distinct order_date) o_days,
    count(distinct case when delivery_arrangement='TGO' then order_id end) tgo, 
    count(distinct case when delivery_arrangement='TMP' then order_id end) tmp
  from `tlb-data-prod.data_platform.fct_order_info`  
  where country_id=9 and not is_test and is_successful and not is_non_food
    and order_date between '2025-01-01' and '2025-01-31'
    and chain_id not in (694639, 677850, 677778, 686788, 689801, 687553)
  group by 1
  having o_days=31
)


,jul_vendors as(
  select * except(jul_tpro_ven_orders, o_days), 
    case 
    when jul_tpro_ven_orders=jul_orders then 'tpro' 
    when jul_tpro_ven_orders=0 and other_tpro_ven_orders=0 then 'non-tpro' 
    -- when jul_tpro_ven_orders=0 and other_tpro_ven_orders>>0 then '3-tPro Ended Before July'
    -- else '4-Other' 
      end ven_group,
    case 
    when all_tgo>>0 and all_tmp>>0 then 'TGO/TMP'
    when all_tgo>>0 and (all_tmp=0 or all_tmp is null) then 'TGO'
    when all_tmp>>0 and (all_tgo=0 or all_tgo is null) then 'TMP'
     end new_arrangement,
    case
    when ven_funded_orders>>0 and tal_funded_orders=0 then 'Vendor Funded'
    when (ven_funded_orders>>0 and tal_funded_orders>>0 and funded_orders=jul_tpro_orders) or (tal_funded_orders=jul_tpro_orders) then 'Cofunded/Talabat Funded'
    when ven_funded_orders>>0 and tal_funded_orders>>0 and funded_orders!=jul_tpro_orders then 'Partially/Inconsistently Cofunded'
      end fund_type2,
    tal_deliv_disc+tal_exec_deal+tal_booster tal_tpro_fund,
    ven_deliv_disc+ven_exec_deal+ven_booster ven_tpro_fund

  from
    (
      select jan.*, vendor_name, chain_name,
      main_cuisine,
      city_name, cluster_name,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' then order_id end) jul_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and is_tpro_order then order_id end) jul_tpro_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and is_tpro_vendor then order_id end) jul_tpro_ven_orders,
      sum(case when o.order_date between '2025-07-01' and '2025-07-31' then gmv_amount_lc end) jul_gmv,
      sum(case when o.order_date between '2025-07-01' and '2025-07-31' then delivery_birdseye_distance_m end) jul_dist,
      min(case when o.order_date between '2025-07-01' and '2025-07-31' then o.order_date end) f_jul_order_date,
      max(case when o.order_date between '2025-07-01' and '2025-07-31' then o.order_date end) l_jul_order_date,
      max(o.order_date) l_order_date,
      count(distinct case when o.order_date between '2025-02-01' and '2025-06-30' and is_tpro_vendor then order_id end) other_tpro_ven_orders,
    
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_delivery_discount_incentive_amount_lc end,0)) ven_deliv_disc,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_exclusive_deal_incentive_amount_lc end,0)) ven_exec_deal,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_booster_discount_incentive_amount_lc end,0)) ven_booster,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_delivery_discount_incentive_amount_lc end,0)) tal_deliv_disc,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_exclusive_deal_incentive_amount_lc end,0)) tal_exec_deal,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_booster_discount_incentive_amount_lc end,0)) tal_booster,

      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TGO' then order_id end) jul_tgo,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TMP' then order_id end) jul_tmp,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TGO' then order_id end)
      + min(tgo) all_tgo,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TMP' then order_id end)
      + min(tmp) all_tmp,

      sum(gmv)/sum(orders) jan_aov,

      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and (vendor_tpro_delivery_discount_incentive_amount_lc>>0 
        or vendor_tpro_exclusive_deal_incentive_amount_lc>>0 or vendor_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) ven_funded_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31'and (platform_tpro_delivery_discount_incentive_amount_lc>>0 
        or platform_tpro_exclusive_deal_incentive_amount_lc>>0 or platform_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) tal_funded_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and (vendor_tpro_delivery_discount_incentive_amount_lc>>0 
        or vendor_tpro_exclusive_deal_incentive_amount_lc>>0 or vendor_tpro_booster_discount_incentive_amount_lc>>0) then order_id end)
      + count(distinct case when o.order_date between '2025-07-01' and '2025-07-31'and (platform_tpro_delivery_discount_incentive_amount_lc>>0 
        or platform_tpro_exclusive_deal_incentive_amount_lc>>0 or platform_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) funded_orders,

    from jan_vendors jan
    left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
    left join `tlb-data-prod.data_platform.dim_chain` using(chain_id)
    left join `tlb-data-prod.data_platform.sq_fct_order_fund_eg` using(order_id)
    left join `tlb-data-prod.data_platform.dim_vendor_info` using(vendor_id)
    left join `tlb-data-prod.data_platform.sq_dim_location_eg` using(location_id)
    where o.country_id=9 and not is_test and o.is_successful and not o.is_non_food
      and o.order_date>>='2025-02-01' and o.order_date<<'2025-08-14'
      and o.chain_id not in (694639, 677850, 677778, 686788, 689801, 687553)
    group by all
    having l_order_date>>='2025-07-31' and jul_orders>>=1)
)


select vendor_id, vendor_name, chain_name,
  new_arrangement, main_cuisine,
  city_name, cluster_name, 
  case when ven_group='tpro' then
    case
    when ven_funded_orders>>=0.95*jul_tpro_orders and tal_funded_orders<<=0.05*jul_tpro_orders then 'Vendor Funded'
    when tal_funded_orders>>=0.95*jul_tpro_orders and ven_funded_orders<<=0.05*jul_tpro_orders then 'Talabat Funded'
    when tal_funded_orders>>=0.95*jul_tpro_orders and ven_funded_orders>>=0.95*jul_tpro_orders then 'Cofunded'
    else 'Inconsistent' end 
      end fund_type,

  case when jan_aov<<280 then 'Low' when jan_aov between 280 and 400 then 'Medium' when jan_aov>>400 then 'High' end aov_tier,

  count(case when ven_group='tpro' then vendor_id end) tpro_ven_count, count(case when ven_group='non-tpro' then vendor_id end) nontpro_ven_count,
  sum(case when ven_group='tpro' then orders end) tpro_jan_orders, sum(case when ven_group='non-tpro' then orders end) nontpro_jan_orders,
  sum(case when ven_group='tpro' then jul_orders end) tpro_jul_orders, sum(case when ven_group='non-tpro' then jul_orders end) nontpro_jul_orders,
  sum(case when ven_group='tpro' then jul_tpro_orders end) tpro_jul_tpro_orders,
  sum(case when ven_group='tpro' then funded_orders end) funded_orders,
  sum(case when ven_group='tpro' then ven_funded_orders end) ven_funded_orders,
  sum(case when ven_group='tpro' then tal_funded_orders end) tal_funded_orders,
  sum(case when ven_group='tpro' then gmv end) tpro_jan_gmv, sum(case when ven_group='non-tpro' then gmv end) nontpro_jan_gmv,
  sum(case when ven_group='tpro' then jul_gmv end) tpro_jul_gmv, sum(case when ven_group='non-tpro' then jul_gmv end) nontpro_jul_gmv,
  sum(case when ven_group='tpro' then dist end) tpro_jan_drop_off_dist, sum(case when ven_group='non-tpro' then dist end) nontpro_jan_drop_off_dist,
  sum(case when ven_group='tpro' then jul_dist end) tpro_jul_drop_off_dist, sum(case when ven_group='non-tpro' then jul_dist end) nontpro_jul_drop_off_dist,
  -- sum(case when ven_group='tpro' then ven_deliv_disc end) ven_deliv_disc,
  -- sum(case when ven_group='tpro' then ven_exec_deal end) ven_exec_deal,
  -- sum(case when ven_group='tpro' then ven_booster end) ven_booster,
  sum(case when ven_group='tpro' then ven_tpro_fund end) ven_tpro_fund, sum(ven_deliv_disc) v,
  sum(case when ven_group='tpro' then tal_tpro_fund end) tal_tpro_fund

from jul_vendors
where ven_group is not null  
-- and lower(vendor_name) like 'mcdonald\'s%'
group by 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1sdg7d61fuhuu611im83w08dlc8j' name='Custom SQL Query' type='text'><![CDATA[with jan_vendors as(
  select vendor_id, 
    count(distinct order_id) orders,
    sum(gmv_amount_lc) gmv,
    sum(delivery_birdseye_distance_m) dist,
    count(distinct order_date) o_days,
    count(distinct case when delivery_arrangement='TGO' then order_id end) tgo, 
    count(distinct case when delivery_arrangement='TMP' then order_id end) tmp
  from `tlb-data-prod.data_platform.fct_order_info`  
  where country_id=9 and not is_test and is_successful and not is_non_food
    and order_date between '2025-01-01' and '2025-01-31'
    and chain_id not in (694639, 677850, 677778, 686788, 689801, 687553)
  group by 1
  having o_days=31
)


,jul_vendors as(
  select * except(jul_tpro_ven_orders, o_days), 
    case 
    when jul_tpro_ven_orders=jul_orders then 'tpro' 
    when jul_tpro_ven_orders=0 and other_tpro_ven_orders=0 then 'non-tpro' 
    -- when jul_tpro_ven_orders=0 and other_tpro_ven_orders>>0 then '3-tPro Ended Before July'
    -- else '4-Other' 
      end ven_group,
    case 
    when all_tgo>>0 and all_tmp>>0 then 'TGO/TMP'
    when all_tgo>>0 and (all_tmp=0 or all_tmp is null) then 'TGO'
    when all_tmp>>0 and (all_tgo=0 or all_tgo is null) then 'TMP'
     end new_arrangement,
    case
    when ven_funded_orders>>0 and tal_funded_orders=0 then 'Vendor Funded'
    when (ven_funded_orders>>0 and tal_funded_orders>>0 and funded_orders=jul_tpro_orders) or (tal_funded_orders=jul_tpro_orders) then 'Cofunded/Talabat Funded'
    when ven_funded_orders>>0 and tal_funded_orders>>0 and funded_orders!=jul_tpro_orders then 'Partially/Inconsistently Cofunded'
      end fund_type2,
    tal_deliv_disc+tal_exec_deal+tal_booster tal_tpro_fund,
    ven_deliv_disc+ven_exec_deal+ven_booster ven_tpro_fund

  from
    (
      select jan.*, vendor_name, chain_name,
      main_cuisine,
      city_name, cluster_name,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' then order_id end) jul_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and is_tpro_order then order_id end) jul_tpro_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and is_tpro_vendor then order_id end) jul_tpro_ven_orders,
      sum(case when o.order_date between '2025-07-01' and '2025-07-31' then gmv_amount_lc end) jul_gmv,
      sum(case when o.order_date between '2025-07-01' and '2025-07-31' then delivery_birdseye_distance_m end) jul_dist,
      min(case when o.order_date between '2025-07-01' and '2025-07-31' then o.order_date end) f_jul_order_date,
      max(case when o.order_date between '2025-07-01' and '2025-07-31' then o.order_date end) l_jul_order_date,
      max(o.order_date) l_order_date,
      count(distinct case when o.order_date between '2025-02-01' and '2025-06-30' and is_tpro_vendor then order_id end) other_tpro_ven_orders,
    
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_delivery_discount_incentive_amount_lc end,0)) ven_deliv_disc,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_exclusive_deal_incentive_amount_lc end,0)) ven_exec_deal,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then vendor_tpro_booster_discount_incentive_amount_lc end,0)) ven_booster,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_delivery_discount_incentive_amount_lc end,0)) tal_deliv_disc,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_exclusive_deal_incentive_amount_lc end,0)) tal_exec_deal,
      sum(ifnull(case when o.order_date between '2025-07-01' and '2025-07-31' then platform_tpro_booster_discount_incentive_amount_lc end,0)) tal_booster,

      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TGO' then order_id end) jul_tgo,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TMP' then order_id end) jul_tmp,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TGO' then order_id end)
      + min(tgo) all_tgo,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and o.delivery_arrangement='TMP' then order_id end)
      + min(tmp) all_tmp,

      sum(gmv)/sum(orders) jan_aov,

      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and (vendor_tpro_delivery_discount_incentive_amount_lc>>0 
        or vendor_tpro_exclusive_deal_incentive_amount_lc>>0 or vendor_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) ven_funded_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31'and (platform_tpro_delivery_discount_incentive_amount_lc>>0 
        or platform_tpro_exclusive_deal_incentive_amount_lc>>0 or platform_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) tal_funded_orders,
      count(distinct case when o.order_date between '2025-07-01' and '2025-07-31' and (vendor_tpro_delivery_discount_incentive_amount_lc>>0 
        or vendor_tpro_exclusive_deal_incentive_amount_lc>>0 or vendor_tpro_booster_discount_incentive_amount_lc>>0) then order_id end)
      + count(distinct case when o.order_date between '2025-07-01' and '2025-07-31'and (platform_tpro_delivery_discount_incentive_amount_lc>>0 
        or platform_tpro_exclusive_deal_incentive_amount_lc>>0 or platform_tpro_booster_discount_incentive_amount_lc>>0) then order_id end) funded_orders,

    from jan_vendors jan
    left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
    left join `tlb-data-prod.data_platform.dim_chain` using(chain_id)
    left join `tlb-data-prod.data_platform.sq_fct_order_fund_eg` using(order_id)
    left join `tlb-data-prod.data_platform.dim_vendor_info` using(vendor_id)
    left join `tlb-data-prod.data_platform.sq_dim_location_eg` using(location_id)
    where o.country_id=9 and not is_test and o.is_successful and not o.is_non_food
      and o.order_date>>='2025-02-01' and o.order_date<<'2025-08-14'
      and o.chain_id not in (694639, 677850, 677778, 686788, 689801, 687553)
    group by all
    having l_order_date>>='2025-07-31' and jul_orders>>=1)
)


select vendor_id, vendor_name, chain_name,
  new_arrangement, main_cuisine,
  city_name, cluster_name, 
  case when ven_group='tpro' then
    case
    when ven_funded_orders>>=0.95*jul_tpro_orders and tal_funded_orders<<=0.05*jul_tpro_orders then 'Vendor Funded'
    when tal_funded_orders>>=0.95*jul_tpro_orders and ven_funded_orders<<=0.05*jul_tpro_orders then 'Talabat Funded'
    when tal_funded_orders>>=0.95*jul_tpro_orders and ven_funded_orders>>=0.95*jul_tpro_orders then 'Cofunded'
    else 'Inconsistent' end 
      end fund_type,

  case when jan_aov<<280 then 'Low' when jan_aov between 280 and 400 then 'Medium' when jan_aov>>400 then 'High' end aov_tier,

  count(case when ven_group='tpro' then vendor_id end) tpro_ven_count, count(case when ven_group='non-tpro' then vendor_id end) nontpro_ven_count,
  sum(case when ven_group='tpro' then orders end) tpro_jan_orders, sum(case when ven_group='non-tpro' then orders end) nontpro_jan_orders,
  sum(case when ven_group='tpro' then jul_orders end) tpro_jul_orders, sum(case when ven_group='non-tpro' then jul_orders end) nontpro_jul_orders,
  sum(case when ven_group='tpro' then jul_tpro_orders end) tpro_jul_tpro_orders,
  sum(case when ven_group='tpro' then funded_orders end) funded_orders,
  sum(case when ven_group='tpro' then ven_funded_orders end) ven_funded_orders,
  sum(case when ven_group='tpro' then tal_funded_orders end) tal_funded_orders,
  sum(case when ven_group='tpro' then gmv end) tpro_jan_gmv, sum(case when ven_group='non-tpro' then gmv end) nontpro_jan_gmv,
  sum(case when ven_group='tpro' then jul_gmv end) tpro_jul_gmv, sum(case when ven_group='non-tpro' then jul_gmv end) nontpro_jul_gmv,
  sum(case when ven_group='tpro' then dist end) tpro_jan_drop_off_dist, sum(case when ven_group='non-tpro' then dist end) nontpro_jan_drop_off_dist,
  sum(case when ven_group='tpro' then jul_dist end) tpro_jul_drop_off_dist, sum(case when ven_group='non-tpro' then jul_dist end) nontpro_jul_drop_off_dist,
  -- sum(case when ven_group='tpro' then ven_deliv_disc end) ven_deliv_disc,
  -- sum(case when ven_group='tpro' then ven_exec_deal end) ven_exec_deal,
  -- sum(case when ven_group='tpro' then ven_booster end) ven_booster,
  sum(case when ven_group='tpro' then ven_tpro_fund end) ven_tpro_fund, sum(ven_deliv_disc) v,
  sum(case when ven_group='tpro' then tal_tpro_fund end) tal_tpro_fund

from jul_vendors
where ven_group is not null  
-- and lower(vendor_name) like 'mcdonald\'s%'
group by 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
