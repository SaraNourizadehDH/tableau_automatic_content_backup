  <datasources>
    <datasource caption='Custom SQL Query (data_platform)' inline='true' name='federated.1j0apgj1l2zth213ogmce0uyp2v4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.01e233815rpaiq1d4huox1yln9m9'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hoda.tomoum@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.01e233815rpaiq1d4huox1yln9m9' name='Custom SQL Query' type='text'>select o_month,&#13;
  safe_divide(&#13;
    safe_divide(&#13;
      sum(case when delivery_arrangement=&apos;TGO&apos; then total_paid_ef else 0 end),&#13;
      sum(case when delivery_arrangement=&apos;TGO&apos; then orders else 0 end)&#13;
    ),&#13;
    safe_divide(&#13;
      sum(case when delivery_arrangement=&apos;TMP&apos; then adf else 0 end),&#13;
      sum(case when delivery_arrangement=&apos;TMP&apos; then orders else 0 end)&#13;
    ) &#13;
  ) TGO_EF_TMP_DF,&#13;
  safe_divide(&#13;
      sum(case when delivery_arrangement=&apos;TGO&apos; then total_paid_ef else 0 end),&#13;
      sum(case when delivery_arrangement=&apos;TGO&apos; then orders else 0 end)&#13;
    ) TGO_EF,&#13;
   safe_divide(&#13;
      sum(case when delivery_arrangement=&apos;TMP&apos; then adf else 0 end),&#13;
      sum(case when delivery_arrangement=&apos;TMP&apos; then orders else 0 end)&#13;
    ) TMP_DF&#13;
&#13;
from&#13;
(select date_trunc(o.order_date, month) o_month,&#13;
delivery_arrangement,&#13;
count(order_id) orders,&#13;
sum(o.delivery_fee_amount_lc) adf,&#13;
-- sum(o.service_fee_amount_lc) asf,&#13;
-- sum(ifnull(small_order_fee_lc,0))+sum(ifnull(small_order_fee_vat_lc,0)) sof&#13;
sum(o.delivery_fee_amount_lc) + sum(o.service_fee_amount_lc) +&#13;
sum(ifnull(small_order_fee_lc,0))+sum(ifnull(small_order_fee_vat_lc,0)) total_paid_ef&#13;
&#13;
&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
-- left join `tlb-data-prod.data_platform.sq_cv_fct_order_financials_eg_table` using(order_id)&#13;
-- left join `tlb-data-prod.data_platform.sq_fct_order_fund_eg` using(order_id)&#13;
left join `tlb-data-prod.data_platform.fct_billing` using(order_id)&#13;
where o.country_id=9 and not is_test and o.is_successful and o.order_date&gt;&gt;=&apos;2022-01-01&apos; &#13;
and not is_non_food and not o.is_tpro_order&#13;
group by 1,2)&#13;
group by 1&#13;
order by 1 desc,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.01e233815rpaiq1d4huox1yln9m9' name='Custom SQL Query' type='text'>select o_month,&#13;
