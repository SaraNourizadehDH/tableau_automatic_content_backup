      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select a KPI ' datatype='string' name='[KPI selection (copy)_1668865186833072132]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR_M1&quot;'>
          <calculation class='tableau' formula='&quot;RR_M1&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_92EB7D3B0EED47B98C340636AEADDC63'>
            <properties context=''>
              <relation connection='bigquery.0l60eiu08vgef211vigcj0syx3ww' name='Custom SQL Query' type='text'>with calender as (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE(&apos;2021-01-01&apos;), CURRENT_DATE(), INTERVAL 1 MONTH)) AS month where month != date_trunc(CURRENT_DATE(), month))&#13;
&#13;
----ALL DATA WITH LOCATIONS&#13;
,locations_data as (SELECT &#13;
OI.order_id,&#13;
OI.analytical_customer_id,&#13;
OI.order_date,OI.order_time,&#13;
OI.country_iso,&#13;
ifnull((case when OI.country_iso=&apos;EG&apos; then L.city_name else OI.country_iso end),&apos;null&apos;) as city,&#13;
ifnull((case when OI.country_iso=&apos;EG&apos; then L.cluster_name else OI.country_iso end),&apos;null&apos;) as cluster_name,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info`  OI&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` L on OI.delivery_location_id=L.location_id&#13;
where OI.analytical_customer_id is not null and OI.is_successful and not OI.is_test and order_date &gt;&gt;= &apos;2016-01-01&apos;)&#13;
&#13;
&#13;
--GET CITY OF ACQUISITION&#13;
,acquisition_city as(select distinct analytical_customer_id &#13;
,city&#13;
,cluster_name&#13;
,date_trunc(order_date,month) acquisition_month&#13;
,country_iso,&#13;
row_number() over (partition by analytical_customer_id order by order_time ) I&#13;
from locations_data &#13;
Qualify I = 1) &#13;
&#13;
,modified_ld_ac as (select distinct ld.analytical_customer_id,ac.country_iso, ac.city,ac.cluster_name,ac.acquisition_month&#13;
from locations_data ld&#13;
left join acquisition_city ac on ld.analytical_customer_id = ac.analytical_customer_id)&#13;
&#13;
&#13;
,all_customer_month_data as (select distinct  modified_ld_ac.*, month  &#13;
from modified_ld_ac&#13;
cross join calender&#13;
where month &gt;&gt;= acquisition_month&#13;
)&#13;
&#13;
,orders as (SELECT OI.analytical_customer_id,&#13;
OI.country_iso,&#13;
OI.city ,&#13;
OI.cluster_name ,&#13;
date_trunc(OI.order_date, month) month,&#13;
count(OI.order_id) as successful_orders,&#13;
count(distinct case when FB.voucher_discount_amount_lc = 0 or FB.voucher_discount_amount_lc is null then OI.order_id else null end) non_vouchered_orders&#13;
from locations_data OI&#13;
left join `tlb-data-prod.data_platform.fct_billing` FB on OI.order_id = FB.order_id &#13;
&#13;
group by 1,2,3,4,5)&#13;
&#13;
&#13;
,join_with_orders_and_new_customers as(select distinct cmd.analytical_customer_id,cmd.month,cmd.country_iso,o.successful_orders ,acquisition_month,cmd.city,cmd.cluster_name,o.non_vouchered_orders&#13;
from all_customer_month_data cmd&#13;
left join orders o on cmd.analytical_customer_id = o.analytical_customer_id and cmd.month = o.month and cmd.city = o.city and cmd.cluster_name = o.cluster_name&#13;
)&#13;
&#13;
,t1 as (select distinct country_iso,city,cluster_name,&#13;
analytical_customer_id ,&#13;
month,acquisition_month,&#13;
ifnull(successful_orders,0) this_month_orders,&#13;
ifnull(lead(non_vouchered_orders,1) over(partition by analytical_customer_id order by month  ),0)  _1st_month_non_vouchered_orders,&#13;
ifnull(lead(non_vouchered_orders,2) over(partition by analytical_customer_id order by month  ),0)  _2nd_month_non_vouchered_orders,&#13;
ifnull(lead(successful_orders,1) over(partition by  city,cluster_name,analytical_customer_id order by month  ),0)  _1st_month_orders,&#13;
ifnull(lead(successful_orders,2) over(partition by city,cluster_name,analytical_customer_id order by month ),0) _2nd_month_orders&#13;
&#13;
from join_with_orders_and_new_customers&#13;
)&#13;
&#13;
&#13;
select &#13;
country_iso,city,cluster_name,month,&#13;
count(distinct case when month = acquisition_month then analytical_customer_id else null end) M0_Acquisitions,&#13;
count(distinct case when this_month_orders &gt;&gt; 0 then analytical_customer_id else null end) this_month_customers,&#13;
count(distinct case when this_month_orders &gt;&gt; 0 and _1st_month_orders &gt;&gt; 0 then analytical_customer_id else null end ) M1_customers,&#13;
count(distinct case when this_month_orders &gt;&gt; 0 and _2nd_month_orders &gt;&gt; 0 then analytical_customer_id else null end ) M2_customers,&#13;
count(case when this_month_orders &gt;&gt; 0 and (_1st_month_orders &gt;&gt; 0 or _2nd_month_orders &gt;&gt; 0) then analytical_customer_id else null end) M1_or_M2_customers,&#13;
count(case when this_month_orders &gt;&gt; 0 and  (_1st_month_orders &gt;&gt; 0 and _2nd_month_orders &gt;&gt; 0) then analytical_customer_id else null end) M1_and_M2_customers,&#13;
&#13;
count(distinct case when this_month_orders &gt;&gt; 0 and _1st_month_non_vouchered_orders &gt;&gt; 0 then analytical_customer_id else null end ) M1_non_vouchered_customers,&#13;
&#13;
count(case when this_month_orders &gt;&gt; 0 and (_1st_month_non_vouchered_orders &gt;&gt; 0 or _2nd_month_non_vouchered_orders &gt;&gt; 0) then analytical_customer_id else null end) M1_or_M2_non_vouchered_customers,&#13;
&#13;
count(case when this_month_orders &gt;&gt; 0 and  (_1st_month_non_vouchered_orders &gt;&gt; 0 and _2nd_month_non_vouchered_orders &gt;&gt; 0) then analytical_customer_id else null end) M1_and_M2_non_vouchered_customers,&#13;
&#13;
FROM t1 t&#13;
&#13;
group by 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
