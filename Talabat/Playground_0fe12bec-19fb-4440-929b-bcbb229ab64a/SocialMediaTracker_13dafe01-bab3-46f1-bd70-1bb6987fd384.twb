            <column caption='Group Name' datatype='string' name='[group_name]' role='dimension' type='nominal' />
            <column caption='Id' datatype='string' name='[id]' role='dimension' type='nominal' />
            <column caption='Link' datatype='string' name='[link]' role='dimension' type='nominal' />
            <column caption='Talabat Sentiment' datatype='string' name='[llm_sentiment]' role='dimension' type='nominal' />
