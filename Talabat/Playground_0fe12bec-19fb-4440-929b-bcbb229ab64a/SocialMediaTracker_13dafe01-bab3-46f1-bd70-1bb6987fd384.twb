    <worksheet name='Summay Statistics (Emplifi)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (social_media_impact)' name='federated.07bis2i1nycsm8116tsik1xqxkny' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity (emplifi)' datatype='string' name='[Granularity (copy)_1459729267721707520]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column alias='Content Type' caption='Dimention Name (emplifi)' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;content type&quot;'>
              <calculation class='tableau' formula='&quot;content type&quot;' />
              <aliases>
                <alias key='&quot;content topic&quot;' value='Content Topic' />
                <alias key='&quot;content type&quot;' value='Content Type' />
                <alias key='&quot;emplifi sentiment&quot;' value='Emplifi Sentiment' />
                <alias key='&quot;profile name&quot;' value='Profile Name' />
                <alias key='&quot;talabat sentiment&quot;' value='Talabat Sentiment' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07bis2i1nycsm8116tsik1xqxkny'>
            <column caption='Avg Comments Per Post' datatype='real' name='[Avg Reactions Per Post (copy)_604045338456858626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([comment_count])' />
            </column>
            <column caption='Created Date' datatype='date' name='[Calculation_311874303809552384]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([created_time])' />
            </column>
            <column caption='Formatted Date' datatype='string' name='[Calculation_604045338409517056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1459729267721707520]&#13;&#10;    WHEN &quot;Year&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Quarter&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384])) + &quot; Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Month&quot; THEN&#13;&#10;      LEFT(DATENAME(&apos;month&apos;, [Calculation_311874303809552384]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Week&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384]))), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384]))), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384])))&#13;&#10;&#13;&#10;    WHEN &quot;Day&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Calculation_311874303809552384])), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, [Calculation_311874303809552384])), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Avg Reactions Per Post' datatype='real' name='[Calculation_604045338456608769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([like_count])' />
