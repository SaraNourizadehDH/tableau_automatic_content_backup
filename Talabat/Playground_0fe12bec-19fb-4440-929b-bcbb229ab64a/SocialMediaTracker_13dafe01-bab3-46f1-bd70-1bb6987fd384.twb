            <column caption='Granular Date' datatype='datetime' name='[Calculation_311874304112447500]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1459729267721707520]&#13;&#10;    WHEN &quot;Day&quot; THEN [Calculation_311874303809552384]&#13;&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384])&#13;&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [Calculation_311874303809552384])&#13;&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [Calculation_311874303809552384])&#13;&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [Calculation_311874303809552384])&#13;&#10;END' />
            </column>
            <column caption='Formatted Date' datatype='string' name='[Calculation_604045338409517056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1459729267721707520]&#13;&#10;    WHEN &quot;Year&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Quarter&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384])) + &quot; Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Month&quot; THEN&#13;&#10;      LEFT(DATENAME(&apos;month&apos;, [Calculation_311874303809552384]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;    WHEN &quot;Week&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384]))), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384]))), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [Calculation_311874303809552384])))&#13;&#10;&#13;&#10;    WHEN &quot;Day&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Calculation_311874303809552384])), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, [Calculation_311874303809552384])), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, [Calculation_311874303809552384]))&#13;&#10;&#13;&#10;END' />
            </column>
