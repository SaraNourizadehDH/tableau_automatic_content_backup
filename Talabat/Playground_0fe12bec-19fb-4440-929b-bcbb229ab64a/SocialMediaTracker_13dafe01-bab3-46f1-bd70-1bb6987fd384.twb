      <column caption='Positive %' datatype='real' default-format='p0%' name='[Calculation_604045338458226691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [llm_sentiment] == &quot;positive&quot; THEN 1 ELSE 0 END) / (SUM(IF [llm_sentiment] == &quot;positive&quot; THEN 1 ELSE 0 END) + SUM(IF [llm_sentiment] == &quot;negative&quot; THEN 1 ELSE 0 END) + SUM(IF [llm_sentiment] == &quot;neutral&quot; THEN 1 ELSE 0 END))' />
