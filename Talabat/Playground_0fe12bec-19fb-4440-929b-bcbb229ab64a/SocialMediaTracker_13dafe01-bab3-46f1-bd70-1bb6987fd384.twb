      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0a3ppgi1mfuh9e18gukj60oippin].[sum:num_comments:qk]&quot;' value='comments' />
          <alias key='&quot;[federated.0a3ppgi1mfuh9e18gukj60oippin].[sum:num_reactions:qk]&quot;' value='reactions' />
          <alias key='&quot;[federated.0a3ppgi1mfuh9e18gukj60oippin].[usr:Calculation_1000925051413647363:qk]&quot;' value='reactions per post' />
          <alias key='&quot;[federated.0a3ppgi1mfuh9e18gukj60oippin].[usr:Calculation_1730226717828804608:qk]&quot;' value='comments per post' />
