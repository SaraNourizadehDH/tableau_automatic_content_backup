    <worksheet name='Negative Content Category Line Chart (Manual Scraped)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (combined_posts_data)' name='federated.0a3ppgi1mfuh9e18gukj60oippin' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Year&quot;'>
              <calculation class='tableau' formula='&quot;Year&quot;' />
            </column>
            <column caption='Dimension Name' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Group&quot;'>
              <calculation class='tableau' formula='&quot;Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a3ppgi1mfuh9e18gukj60oippin'>
            <column caption='Dimension Name' datatype='string' name='[Calculation_1000925051414589446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Group&quot; THEN [group_name]&#13;&#10;    WHEN &quot;Profile&quot; THEN [profile_name]&#13;&#10;    WHEN &quot;Topic&quot; THEN [content_category]&#13;&#10;    WHEN &quot;Sentiment&quot; THEN [llm_sentiment]&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='positive_and_neutral_topics' />
              </aliases>
            </column>
            <column caption='Formatted Date' datatype='string' name='[Calculation_1000925051717193736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Year&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [date]))&#13;&#10;&#13;&#10;    WHEN &quot;Quarter&quot; THEN&#13;&#10;      STR(DATEPART(&apos;year&apos;, [date])) + &quot; Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date]))&#13;&#10;&#13;&#10;    WHEN &quot;Month&quot; THEN&#13;&#10;      LEFT(DATENAME(&apos;month&apos;, [date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#13;&#10;&#13;&#10;    WHEN &quot;Week&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [date]))), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [date]))), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [date])))&#13;&#10;&#13;&#10;    WHEN &quot;Day&quot; THEN&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [date])), 2) + &quot;/&quot; +&#13;&#10;      RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, [date])), 2) + &quot;/&quot; +&#13;&#10;      STR(DATEPART(&apos;year&apos;, [date]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granular Date' datatype='datetime' name='[Calculation_389561401577848835]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Day&quot; THEN [date]&#13;&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;, [date])&#13;&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [date])&#13;&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [date])&#13;&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [date])&#13;&#10;END' />
            </column>
            <column caption='category_count' datatype='integer' name='[Calculation_389561401592840198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [llm_sentiment] == &quot;negative&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='category_total_count' datatype='integer' name='[Calculation_389561401593024519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_389561401577848835]: SUM(IF [llm_sentiment] == &quot;negative&quot; THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='category_pct' datatype='real' default-format='p0%' name='[Calculation_389561401593151496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([Calculation_389561401593024519])) == 0 &#13;&#10;    THEN 0 &#13;&#10;    ELSE [Calculation_389561401592840198] / TOTAL([Calculation_389561401592840198])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
