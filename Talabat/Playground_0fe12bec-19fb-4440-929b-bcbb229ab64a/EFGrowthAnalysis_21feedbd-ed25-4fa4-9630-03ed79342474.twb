        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0t2htdc1n4tf3a1cy69q306167j3' name='Custom SQL Query' type='text'>select date_trunc(order_date, month) month,&#13;
case &#13;
when not is_non_food then &apos;Food&apos;&#13;
when is_non_food and is_darkstore then &apos;tMart&apos;&#13;
when is_non_food and not is_darkstore then &apos;LS&apos;&#13;
end as vertical, &#13;
count(order_id)/monthly_orders orders&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` a&#13;
left join (select date_trunc(order_date, month) month,&#13;
count(order_id) monthly_orders&#13;
from `tlb-data-prod.data_platform.fct_order_info` &#13;
where is_successful and not is_test and country_id = 9 and order_date &gt;&gt;= &apos;2022-01-01&apos;&#13;
group by 1) m on date_trunc(a.order_date, month) = m.month&#13;
&#13;
where is_successful and not is_test and country_id = 9 and order_date &gt;&gt;= &apos;2022-01-01&apos;&#13;
&#13;
group by 1,2,monthly_orders</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0t2htdc1n4tf3a1cy69q306167j3' name='Custom SQL Query' type='text'>select date_trunc(order_date, month) month,&#13;
