    <worksheet name='ADO ABs vs EF/AFV ABs'>
      <repository-location id='ADOABsvsEFAFVABs' path='/t/Talabat/workbooks/EFGrowthAnalysis' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='TGO EF/ TMP DF' name='federated.0whwi880p87dtr1ek2mf90ujr9mb' />
          </datasources>
          <datasource-dependencies datasource='federated.0whwi880p87dtr1ek2mf90ujr9mb'>
            <column caption='Total Paid EF' datatype='real' name='[Calculation_304274494281269249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[service_fee]+[t_df]+[small_order_fee]' />
            </column>
            <column caption='ADO' datatype='real' name='[Calculation_304274494287372292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total]/[count_days]' />
            </column>
            <column datatype='integer' name='[DF_count]' role='measure' type='quantitative' />
            <column caption='EF TGO / AFV TGO' datatype='real' default-format='p0.00%' name='[EF TGO / DF TMP (copy)_304274494341648391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_304274494281269249])/SUM([DF_count]))&#13;&#10;/&#13;&#10;(SUM([Food_Value])/SUM([tgo]))' />
