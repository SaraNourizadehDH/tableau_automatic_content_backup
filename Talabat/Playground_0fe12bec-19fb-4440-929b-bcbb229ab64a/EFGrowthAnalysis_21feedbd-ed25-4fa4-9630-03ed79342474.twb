      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E40F69A673D24FEFBDBFD9CBAE4207A8'>
            <properties context=''>
              <relation connection='bigquery.1j8bemi0ko4rsu11li10x0tjp2ua' name='Custom SQL Query' type='text'>select date_trunc(o.order_date, month) month,&#13;
count(case when o.is_tgo then o.order_id end) as tgo,&#13;
count(o.order_id) total,&#13;
count(distinct o.order_date) count_days,&#13;
&#13;
sum(case when o.is_successful and o.is_tgo and not o.is_darkstore and o.chain_id!=625984 then o.basket_amount_lc end) as Food_Value,&#13;
sum(case when o.is_successful and o.is_tgo and not o.is_darkstore and o.chain_id!=625984 then fof_new.rev_df end)*1.14 t_df,&#13;
-- divided by&#13;
  sum(case when o.is_successful and o.is_tgo and not o.is_darkstore and o.chain_id!=625984 then 1 else 0 end) as DF_count, &#13;
--total df including vendor funded free/discounted delivery (excluding tmart and EDR)&#13;
&#13;
  sum(case when o.is_successful and o.delivery_arrangement!=&apos;PICKUP&apos; and not o.is_darkstore and o.chain_id!=625984 then o.service_fee_amount_lc else 0 end) as service_fee,&#13;
  sum(case when o.is_successful and o.delivery_arrangement!=&apos;PICKUP&apos; and not o.is_darkstore and o.chain_id!=625984 then fof_new.rev_small_order_sf else 0 end)*1.14 as small_order_fee, &#13;
--both divided by&#13;
  sum(case when o.is_successful and o.delivery_arrangement!=&apos;PICKUP&apos; and not o.is_darkstore and o.chain_id!=625984 then 1 else 0 end) as sf_d,&#13;
&#13;
sum(case when delivery_arrangement = &apos;TMP&apos; then delivery_fee_amount_lc end) as tmp_df,&#13;
count(case when delivery_arrangement = &apos;TMP&apos; then o.order_id end) as tmp,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
&#13;
left join `tlb-data-prod.data_platform.sq_cv_fct_order_financials_eg_table` fof_new on o.order_id = fof_new.order_id&#13;
&#13;
where o.is_successful and not is_test and country_id = 9 and o.order_date &gt;&gt;= &apos;2023-01-01&apos;&#13;
and not is_non_food and not ifnull(is_tpro_order,false) and not ifnull(is_fdnc_order,false)&#13;
&#13;
group by 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
