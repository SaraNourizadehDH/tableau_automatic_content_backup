      <column caption='Reorder Rate' datatype='real' name='[Calculation_1252282237660655620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([re_ordered]) / SUM([orders])' />
      </column>
      <column caption='avg' datatype='real' name='[Calculation_1252282237663621125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([re_ordered])} / { FIXED : SUM([orders])}&#13;&#10;//SUM(IF [bucket]=&apos;no rating&apos; THEN [re_ordered] END) / SUM(IF [bucket]=&apos;no rating&apos; THEN [orders] END)' />
