LEFT JOIN UNNEST(SPLIT(coalesce(r.customer_rating_reason, 'null'), ",")) customer_rating_reasons WITH offset o2 ON o0 = o2

--where x.order_id=2022576596
)

select 
--*,

case 
  when customer_rating_reasons='null' and original_rating is null then 'no rating'
  --when customer_rating_reasons='null' and original_rating is not null then 'no reason'
  --else customer_rating_reasons
  when original_rating>>=4 then concat(coalesce(customer_rating_reasons, 'null') , ' / good') 
  when original_rating<<4 then concat(coalesce(customer_rating_reasons, 'null') , ' / bad') 
end as bucket,

case 
  when customer_rating_reasons='null' and original_rating is null then 'no rating'
  when customer_rating_reasons='null' and original_rating is not null then 'no reason'
  else customer_rating_reasons
end as reason,

order_rating_bucket,
city_name,

count(distinct(order_id)) as orders,
count(distinct(nxt_order_id)) re_ordered,

--safe_divide(count(distinct(nxt_order_id)), count(distinct(order_id))) * 100

from main

group by bucket, city_name, reason, order_rating_bucket]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
