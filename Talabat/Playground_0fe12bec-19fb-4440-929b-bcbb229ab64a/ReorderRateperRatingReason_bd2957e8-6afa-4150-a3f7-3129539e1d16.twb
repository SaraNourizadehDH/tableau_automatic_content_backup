--LEFT JOIN UNNEST(SPLIT(coalesce(r.customer_rating_reason, 'null'), ",")) customer_rating_reasons WITH offset o2 ON o0 = o2

--where x.order_id=2022576596
)

select 
--*,

case 
  when driver_rating_reasons='null' and driver_rating is null then 'no rating'
  --when customer_rating_reasons='null' and original_rating is not null then 'no reason'
  --else customer_rating_reasons
  when driver_rating>>=4 then concat(coalesce(driver_rating_reasons, 'null') , ' / good') 
  when driver_rating<<4 then concat(coalesce(driver_rating_reasons, 'null') , ' / bad') 
end as bucket,

case 
  when driver_rating_reasons='null' and driver_rating is null then 'no rating'
  when driver_rating_reasons='null' and driver_rating is not null then 'no reason'
  else driver_rating_reasons
end as reason,

driver_rating_bucket,
city_name,

count(distinct(order_id)) as orders,
count(distinct(nxt_order_id)) re_ordered,

--safe_divide(count(distinct(nxt_order_id)), count(distinct(order_id))) * 100

from main

group by bucket, city_name, reason, driver_rating_bucket]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
