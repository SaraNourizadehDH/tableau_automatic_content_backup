    <datasource caption='reorder rate driver per city' inline='true' name='federated.0t797ul1a77kkl13y5gwf1p2mim6' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0bzewj50uyf0lp185s6mn087tgzc'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='youssef.wageeh@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bzewj50uyf0lp185s6mn087tgzc' name='Custom SQL Query' type='text'><![CDATA[with next_order as 
(
select order_id, account_id, is_successful, order_date, order_time, vendor_id, analytical_customer_id 

from `tlb-data-prod.data_platform.fct_order_info`

where order_date>>='2024-10-01' and order_date<<='2025-01-31' and country_id=9 and is_successful and not is_test and not is_non_food 
),

current_order as 
(
  select order_id, account_id, is_successful, order_date, order_time, vendor_id, analytical_customer_id, l.city_name 

from `tlb-data-prod.data_platform.fct_order_info` o
left join `tlb-data-prod.data_platform.sq_dim_location_eg` l on o.delivery_location_id=l.location_id

where order_date>>='2024-10-01' and order_date<<='2024-12-31' 
and country_id=9 and is_successful and not is_test and not is_non_food 
),

x as (
select 
--co.*, nxo.*, 
co.order_id, co.order_date, co.order_time, co.vendor_id, co.analytical_customer_id, co.city_name, 
nxo.order_id as nxt_order_id, nxo.order_date, nxo.order_time, 
--r.original_rating, r.customer_rating_reason, r.driver_rating, r.driver_rating_reason, 
--case when r.driver_rating>>=4 then 'good order rating' else 'bad order rating' end as order_rating_bucket,
--case when r.driver_rating>>=4 then 'good driver rating' else 'bad driver rating' end as driver_rating_bucket,
row_number() over(partition by co.order_id order by nxo.order_time) RR,
--dense_rank() over(partition by co.order_id order by nxo.order_time) RR,

from current_order co 
left join next_order nxo on co.analytical_customer_id=nxo.analytical_customer_id and  co.vendor_id=nxo.vendor_id and nxo.order_time>>co.order_time and date_diff(nxo.order_date, co.order_date, day)<<=30

qualify RR=1
),

main as (
select x.*,
driver_rating_reasons,
r.original_rating, r.driver_rating, 
-- case 
--   when r.original_rating>>=4 or r.original_rating is null then 'good order rating' else 'bad order rating' 
-- end as order_rating_bucket,
case 
  when r.driver_rating>>=4 or r.driver_rating is null then 'good order rating' else 'bad order rating' 
end as driver_rating_bucket,
--case when r.driver_rating>>=4 then 'good driver rating' else 'bad driver rating' end as driver_rating_bucket,

from x
left join `tlb-data-prod.data_platform.fct_rating` r on x.order_id=r.order_id
--, UNNEST(GENERATE_ARRAY(0, GREATEST(ARRAY_LENGTH(SPLIT(coalesce(r.customer_rating_reason, 'null'), ",")), ARRAY_LENGTH(SPLIT(coalesce(r.driver_rating_reason, 'null'), ","))) - 1)) o0

,UNNEST(GENERATE_ARRAY(0, ARRAY_LENGTH(SPLIT(coalesce(r.driver_rating_reason, 'null'), ","))- 1)) o0

LEFT JOIN UNNEST(SPLIT(coalesce(r.driver_rating_reason, 'null'), ",")) driver_rating_reasons WITH offset o2 ON o0 = o2
--LEFT JOIN UNNEST(SPLIT(coalesce(r.customer_rating_reason, 'null'), ",")) customer_rating_reasons WITH offset o2 ON o0 = o2

--where x.order_id=2022576596
)

select 
--*,

case 
  when driver_rating_reasons='null' and driver_rating is null then 'no rating'
  --when customer_rating_reasons='null' and original_rating is not null then 'no reason'
  --else customer_rating_reasons
  when driver_rating>>=4 then concat(coalesce(driver_rating_reasons, 'null') , ' / good') 
  when driver_rating<<4 then concat(coalesce(driver_rating_reasons, 'null') , ' / bad') 
end as bucket,

case 
  when driver_rating_reasons='null' and driver_rating is null then 'no rating'
  when driver_rating_reasons='null' and driver_rating is not null then 'no reason'
  else driver_rating_reasons
end as reason,

driver_rating_bucket,
city_name,

count(distinct(order_id)) as orders,
count(distinct(nxt_order_id)) re_ordered,

--safe_divide(count(distinct(nxt_order_id)), count(distinct(order_id))) * 100

from main

group by bucket, city_name, reason, driver_rating_bucket]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
