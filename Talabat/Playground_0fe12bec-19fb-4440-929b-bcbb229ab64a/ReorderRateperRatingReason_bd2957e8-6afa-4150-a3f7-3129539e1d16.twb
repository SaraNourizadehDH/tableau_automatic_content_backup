      <aliases enabled='yes' />
      <column caption='Reorder Rate' datatype='real' name='[Calculation_1252282237820567565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([re_ordered]) / SUM([orders])' />
      </column>
      <column aggregation='Attribute' caption='avg no rating' datatype='real' name='[Calculation_1252282237844865038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [bucket]: SUM(IF [bucket]=&apos;no rating&apos; THEN [re_ordered] END) } /&#13;&#10;{ EXCLUDE [bucket]: SUM(IF [bucket]=&apos;no rating&apos; THEN [orders] END) }' />
      </column>
      <column caption='impact' datatype='real' name='[Calculation_1252282237845041167]' role='measure' type='quantitative'>
