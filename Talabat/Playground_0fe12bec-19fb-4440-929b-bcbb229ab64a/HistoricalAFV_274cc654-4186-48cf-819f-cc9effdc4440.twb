      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.039ew1q0ezehyn1dxj3ru0jsqo30'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='youssef.wageeh@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.039ew1q0ezehyn1dxj3ru0jsqo30' name='Custom SQL Query' type='text'><![CDATA[select 
date_trunc(o.order_date, month) month, 

case 
  when top_by_score is not null then top_by_score 
  else ch.main_cuisine
end as cuisine,

sum(case when o.is_successful then 1 else 0 end) as successful , 
sum(case when o.is_successful then o.basket_amount_lc else 0 end) as basket,
sum(case when o.is_successful and i.sold_quantity<<100000 then i.sold_quantity end) as sold_quantity, 

from `tlb-data-prod.data_platform.fct_order_info` o
left join `tlb-data-dev.performance_management_egypt.suggested_cuisine` c on o.chain_id=c.chain_id 
left join `tlb-data-prod.data_platform.dim_chain` ch on o.chain_id=ch.chain_id

--Items
left join (select i.order_id, 
            sum(case when o.is_non_food then delivered_quantity else sold_quantity end) as sold_quantity 
            from `tlb-data-prod.data_platform.fct_order_item` i 
            left join `tlb-data-prod.data_platform.fct_order_info` o on i.order_id=o.order_id 
            where o.order_date >>= '2021-01-01'
            group by order_id
          ) i on o.order_id=i.order_id 

where o.country_id = 9 and not o.is_test and not o.is_non_food and o.chain_id!=625984
and o.order_date >>= '2021-01-01' 

group by month,cuisine
--order by month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.039ew1q0ezehyn1dxj3ru0jsqo30' name='Custom SQL Query' type='text'><![CDATA[select 
date_trunc(o.order_date, month) month, 

case 
  when top_by_score is not null then top_by_score 
  else ch.main_cuisine
end as cuisine,

sum(case when o.is_successful then 1 else 0 end) as successful , 
sum(case when o.is_successful then o.basket_amount_lc else 0 end) as basket,
sum(case when o.is_successful and i.sold_quantity<<100000 then i.sold_quantity end) as sold_quantity, 

from `tlb-data-prod.data_platform.fct_order_info` o
left join `tlb-data-dev.performance_management_egypt.suggested_cuisine` c on o.chain_id=c.chain_id 
left join `tlb-data-prod.data_platform.dim_chain` ch on o.chain_id=ch.chain_id

--Items
left join (select i.order_id, 
            sum(case when o.is_non_food then delivered_quantity else sold_quantity end) as sold_quantity 
            from `tlb-data-prod.data_platform.fct_order_item` i 
            left join `tlb-data-prod.data_platform.fct_order_info` o on i.order_id=o.order_id 
            where o.order_date >>= '2021-01-01'
            group by order_id
          ) i on o.order_id=i.order_id 

where o.country_id = 9 and not o.is_test and not o.is_non_food and o.chain_id!=625984
and o.order_date >>= '2021-01-01' 

group by month,cuisine
--order by month]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
