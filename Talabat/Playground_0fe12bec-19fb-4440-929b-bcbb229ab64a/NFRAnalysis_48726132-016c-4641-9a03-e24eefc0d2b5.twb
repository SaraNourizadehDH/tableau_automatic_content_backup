      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_61BB23DD30224BDE93F732F5A518ED75'>
            <properties context=''>
              <relation connection='bigquery.013qaus0d5glt311a7p9u014thga' name='Custom SQL Query' type='text'>select order_date,&#13;
case when not is_non_food then &apos;Food&apos;&#13;
when is_nfv then &apos;NFV&apos;&#13;
when is_darkstore then &apos;tMart&apos;&#13;
end main_vertical,&#13;
&#13;
delivery_arrangement,&#13;
&#13;
case when o.is_online_payment then &apos;Online&apos; else &apos;Cash&apos; end pay_type,&#13;
&#13;
country_code,&#13;
&#13;
case &#13;
when not is_non_food and delivery_arrangement=&apos;TGO&apos; and o.is_online_payment then &apos;Food, TGO, Online&apos;&#13;
when not is_non_food and delivery_arrangement=&apos;TGO&apos; and not o.is_online_payment then &apos;Food, TGO, Cash&apos;&#13;
when not is_non_food and delivery_arrangement=&apos;TMP&apos; and o.is_online_payment then &apos;Food, TMP, Online&apos;&#13;
when not is_non_food and delivery_arrangement=&apos;TMP&apos; and not o.is_online_payment then &apos;Food, TMP, Cash&apos;&#13;
when not is_non_food and delivery_arrangement=&apos;PICKUP&apos; and o.is_online_payment then &apos;Food, PICKUP, Online&apos;&#13;
when not is_non_food and delivery_arrangement=&apos;PICKUP&apos; and not o.is_online_payment then &apos;Food, PICKUP, Cash&apos;&#13;
&#13;
when is_nfv and delivery_arrangement=&apos;TGO&apos; and o.is_online_payment then &apos;NFV, TGO, Online&apos;&#13;
when is_nfv and delivery_arrangement=&apos;TGO&apos; and not o.is_online_payment then &apos;NFV, TGO, Cash&apos;&#13;
when is_nfv and delivery_arrangement=&apos;TMP&apos; and o.is_online_payment then &apos;NFV, TMP, Online&apos;&#13;
when is_nfv and delivery_arrangement=&apos;TMP&apos; and not o.is_online_payment then &apos;NFV, TMP, Cash&apos;&#13;
when is_nfv and delivery_arrangement=&apos;PICKUP&apos; and o.is_online_payment then &apos;NFV, PICKUP, Online&apos;&#13;
when is_nfv and delivery_arrangement=&apos;PICKUP&apos; and not o.is_online_payment then &apos;NFV, PICKUP, Cash&apos;&#13;
&#13;
when is_darkstore and delivery_arrangement=&apos;TGO&apos; and o.is_online_payment then &apos;tMart, TGO, Online&apos;&#13;
when is_darkstore and delivery_arrangement=&apos;TGO&apos; and not o.is_online_payment then &apos;tMart, TGO, Cash&apos;&#13;
&#13;
end comb_dim,&#13;
&#13;
talabat_reason,&#13;
&#13;
count(distinct case when is_successful then order_id end) successful_o,&#13;
&#13;
(select count(distinct order_id) from `tlb-data-prod.data_platform.fct_order_info` &#13;
where country_id=9 and not is_test and order_date&gt;&gt;=date_trunc(date_sub(current_date(), INTERVAL 3 month), month) and is_successful) t_successful,&#13;
&#13;
count(distinct case when s.is_net then o.order_id end) as net_total,&#13;
count(distinct case when s.is_net and not o.is_successful then o.order_id end) as net_failed,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.dim_order_status` s on o.order_status_id = s.order_status_id &#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` f ON o.order_fail_reason_id = f.order_fail_reason_id&#13;
&#13;
where not o.is_test and o.order_date&gt;&gt;=date_trunc(date_sub(current_date(), INTERVAL 3 month), month)&#13;
group by 1,2,3,4,5,6,7&#13;
having comb_dim is not null&#13;
order by 1 desc</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
