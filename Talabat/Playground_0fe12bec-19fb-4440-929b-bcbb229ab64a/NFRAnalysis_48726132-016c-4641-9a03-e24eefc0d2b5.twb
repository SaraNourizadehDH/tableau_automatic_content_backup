      <aliases enabled='yes' />
      <column caption='Parameter Calc' datatype='real' default-format='p0.00%' name='[Calculation_1013028485001908224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;% of NFR&apos; THEN [NFR% (copy)_1029916982941696002]&#13;&#10;WHEN &apos;NFR Contribution&apos; THEN [Calculation_1029916982938869761]&#13;&#10;WHEN &apos;NFR%&apos; THEN [NFR% (reason) (copy)_1029916982945947651]&#13;&#10;END' />
      </column>
      <column caption='Weight' datatype='real' default-format='p0.0%' name='[Calculation_1029916982938353664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([successful_o])/sum({fixed[order_date]: SUM([successful_o])})&#13;&#10;sum([net_total])/sum({fixed[order_date],[country_code]: SUM([net_total])})' />
      </column>
      <column caption='NFR Contrib.' datatype='real' default-format='p0.00%' name='[Calculation_1029916982938869761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_74027961642590208]*[Calculation_1029916982938353664]' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_5113907790931886146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed[country_code]: sum([net_total])})' />
      </column>
      <column caption='NFR%' datatype='real' default-format='p0.0%' name='[Calculation_74027961642590208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_failed])/sum([net_total])' />
      </column>
      <column caption='AVG. Daily Successful' datatype='real' name='[Calculation_74027961644105730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_o])/125' />
      </column>
      <column caption='no. of days' datatype='integer' name='[Calculation_74027961645035523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, -3,DATETRUNC(&apos;month&apos;, today()))))' />
      </column>
      <column caption='NFR% (reason)' datatype='real' default-format='p0.00%' name='[NFR% (copy)_1029916982941696002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_failed])&#13;&#10;/sum({fixed[pay_type], [main_vertical], [delivery_arrangement],[country_code]: sum([net_failed])})' />
      </column>
      <column caption='NFR% (reason * countries) ' datatype='real' default-format='p0.00%' name='[NFR% (reason) (copy)_1029916982945947651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_failed])&#13;&#10;/SUM({ EXCLUDE [talabat_reason]: SUM([net_total])})' />
      </column>
      <column caption='Overall NFR% (copy)' datatype='real' default-format='p0.00%' name='[Overall NFR% (copy)_540150523761258496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [comb_dim]: [Calculation_1029916982938353664]} * { FIXED [comb_dim]: [Calculation_74027961642590208]}&#13;&#10;//[NFR%]*[Weight]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_61BB23DD30224BDE93F732F5A518ED75]' role='measure' type='quantitative' />
