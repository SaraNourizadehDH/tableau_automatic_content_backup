              <calculation class='tableau' formula='if [Country Code]=&apos;MA&apos; then 67349160 &#13;&#10;ELSEIF [Country Code]=&apos;PN&apos; then 41286348&#13;&#10;END' />
            </column>
            <column caption='new comp' datatype='integer' name='[Calculation_143270808766136337]' role='measure' type='quantitative'>
