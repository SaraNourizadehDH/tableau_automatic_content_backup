      <aliases enabled='yes' />
      <column caption='shouldn&apos;t be comp. orders' datatype='integer' name='[Calculation_1342354210291707904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Is Compensated?]=&apos;Yes&apos; and [delay]&lt;10 then 1 END' />
      </column>
      <column caption='shouldn&apos;t be comp. orders percent' datatype='real' name='[Calculation_1342354210292318209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1342354210291707904]) / [Calculation_143270808372203520]' />
      </column>
      <column caption='H2 Projected Cost' datatype='real' name='[Calculation_1342354210293223428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[shouldn&apos;t be comp. orders] * [wrong comp. amount]&#13;&#10;&#13;&#10;IF [Country Code]=&apos;MA&apos; THEN [Parameters].[Parameter 2]*[Calculation_1342354210291707904] * [Parameters].[Parameter 5]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;ELSEIF [Country Code]=&apos;PN&apos; THEN [Parameters].[MA H2 Projected Orders (copy)_143270808412803084]*[Calculation_1342354210291707904] * [Parameters].[Parameter 5]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;END' />
      </column>
      <column caption='Orders with mistakes' datatype='integer' name='[Calculation_1342354210297544709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_143270808383578113]) + SUM([Calculation_1342354210291707904])' />
      </column>
      <column caption='mistakes %' datatype='real' name='[Calculation_1342354210297720838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1342354210297544709] / [Calculation_143270808372203520]' />
      </column>
      <column caption='H2 projected agents mistakes cost' datatype='real' name='[Calculation_1342354210297950215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1431581777590493184]) + SUM([Calculation_1342354210293223428])' />
      </column>
      <column caption='H2 Adj. Comp. Amount' datatype='real' name='[Calculation_1431581777590493184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_143270808413192206] * [Parameters].[Parameter 4]' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_143270808372203520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Order ID])' />
      </column>
      <column caption='should be comp. Orders' datatype='integer' name='[Calculation_143270808383578113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF [Is Compensated?]=&apos;No&apos; and [Compensation]&gt;0 then 1 ELSE 0 END&#13;&#10;IF [Is Compensated?]=&apos;No&apos; and [Calculation_143270808766136337]&gt;0 then 1 ELSE 0 END' />
      </column>
      <column caption='customers count' datatype='integer' name='[Calculation_143270808385228802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//COUNTD(IF [Is Compensated?]=&apos;No&apos; and [Compensation]&gt;0 then [Customer Account ID] END)&#13;&#10;&#13;&#10;COUNTD([Customer Account ID])' />
      </column>
      <column caption='percent of orders' datatype='real' name='[Calculation_143270808388284420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_143270808383578113]) / [Calculation_143270808372203520]' />
      </column>
      <column caption='no contact' datatype='integer' name='[Calculation_143270808404209672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Agent contacted?]=&apos;No&apos; and [compensation]&gt;0 then 1 END' />
      </column>
      <column caption='Dim 1' datatype='string' name='[Calculation_143270808411156490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Country&apos; THEN [Country Code]&#13;&#10;WHEN &apos;is Food&apos; THEN [Is Food Order?]&#13;&#10;WHEN &apos;is Modified&apos; THEN [Is Modified?]&#13;&#10;END' />
      </column>
      <column caption='H2 Projected Comp. Amount' datatype='real' name='[Calculation_143270808413192206]' role='measure' type='quantitative'>
