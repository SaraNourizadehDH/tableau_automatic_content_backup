          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_143270808411119625]' param-domain-type='list' role='measure' type='nominal' value='&quot;is Food&quot;'>
              <calculation class='tableau' formula='&quot;is Food&quot;' />
            </column>
            <column caption='PN H2 Projected Orders' datatype='integer' name='[MA H2 Projected Orders (copy)_143270808412803084]' param-domain-type='any' role='measure' type='quantitative' value='41286348'>
              <calculation class='tableau' formula='41286348' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='MA H2 Projected Orders' datatype='integer' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='67349160'>
              <calculation class='tableau' formula='67349160' />
            </column>
            <column caption='Redeemed Compensation %' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.9'>
              <calculation class='tableau' formula='0.9' />
            </column>
            <column caption='X Adj. Compensation' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
            </column>
            <column caption='wrong comp. amount' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='20'>
              <calculation class='tableau' formula='20' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1f5zr5v1bezmsq133vzgg08985gf'>
            <column datatype='datetime' name='[Actual Delivery Time]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Agent Contact Reason]' role='dimension' type='nominal' />
            <column caption='shouldn&apos;t be comp. orders' datatype='integer' name='[Calculation_1342354210291707904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is Compensated?]=&apos;Yes&apos; and [delay]&lt;10 then 1 END' />
            </column>
            <column caption='H2 Projected Cost' datatype='real' name='[Calculation_1342354210293223428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[shouldn&apos;t be comp. orders] * [wrong comp. amount]&#13;&#10;&#13;&#10;IF [Country Code]=&apos;MA&apos; THEN [Parameters].[Parameter 2]*[Calculation_1342354210291707904] * [Parameters].[Parameter 5]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;ELSEIF [Country Code]=&apos;PN&apos; THEN [Parameters].[MA H2 Projected Orders (copy)_143270808412803084]*[Calculation_1342354210291707904] * [Parameters].[Parameter 5]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;END' />
            </column>
            <column caption='Orders with mistakes' datatype='integer' name='[Calculation_1342354210297544709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_143270808383578113]) + SUM([Calculation_1342354210291707904])' />
            </column>
            <column caption='mistakes %' datatype='real' name='[Calculation_1342354210297720838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1342354210297544709] / [Calculation_143270808372203520]' />
            </column>
            <column caption='H2 projected agents mistakes cost' datatype='real' name='[Calculation_1342354210297950215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1431581777590493184]) + SUM([Calculation_1342354210293223428])' />
            </column>
            <column caption='H2 Adj. Comp. Amount' datatype='real' name='[Calculation_1431581777590493184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_143270808413192206] * [Parameters].[Parameter 4]' />
            </column>
            <column caption='orders' datatype='integer' name='[Calculation_143270808372203520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Order ID])' />
            </column>
            <column caption='should be comp. Orders' datatype='integer' name='[Calculation_143270808383578113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [Is Compensated?]=&apos;No&apos; and [Compensation]&gt;0 then 1 ELSE 0 END&#13;&#10;IF [Is Compensated?]=&apos;No&apos; and [Calculation_143270808766136337]&gt;0 then 1 ELSE 0 END' />
            </column>
            <column caption='Dim 1' datatype='string' name='[Calculation_143270808411156490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Country&apos; THEN [Country Code]&#13;&#10;WHEN &apos;is Food&apos; THEN [Is Food Order?]&#13;&#10;WHEN &apos;is Modified&apos; THEN [Is Modified?]&#13;&#10;END' />
            </column>
            <column caption='H2 Projected Comp. Amount' datatype='real' name='[Calculation_143270808413192206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Country Code]=&apos;MA&apos; THEN [Parameters].[Parameter 2]*[not comp (copy)_143270808393383943]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;ELSEIF [Country Code]=&apos;PN&apos; THEN [Parameters].[MA H2 Projected Orders (copy)_143270808412803084]*[not comp (copy)_143270808393383943]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;END' />
            </column>
            <column caption='new comp' datatype='integer' name='[Calculation_143270808766136337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;NOT ISNULL([compensation]) THEN [compensation]&#13;&#10;ELSEIF (NOT ISNULL([Promised Delivery Time])) AND ISNULL([Actual Delivery Time]) &#13;&#10;THEN &#13;&#10;IF [Agent Contact Reason]=&apos;Delay Complaint - Short&apos; THEN 15 &#13;&#10;ELSEIF [Agent Contact Reason]=&apos;Delay Complaint - Moderate&apos; OR [Agent Contact Reason]=&apos;Delay Complaint&apos; THEN 20&#13;&#10;ELSEIF [Agent Contact Reason]=&apos;Delay Complaint - Extreme&apos; OR [Agent Contact Reason]=&apos;Delay Complaint - Severe&apos; THEN 25&#13;&#10;END&#13;&#10;END' />
            </column>
