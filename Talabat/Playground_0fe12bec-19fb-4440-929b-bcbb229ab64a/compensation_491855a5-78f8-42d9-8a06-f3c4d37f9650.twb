            </column>
            <column caption='Dim 1' datatype='string' name='[Calculation_143270808411156490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Country&apos; THEN [Country Code]&#13;&#10;WHEN &apos;is Food&apos; THEN [Is Food Order?]&#13;&#10;WHEN &apos;is Modified&apos; THEN [Is Modified?]&#13;&#10;END' />
            </column>
            <column caption='H2 Projected Comp. Amount' datatype='real' name='[Calculation_143270808413192206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Country Code]=&apos;MA&apos; THEN [Parameters].[Parameter 2]*[not comp (copy)_143270808393383943]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;ELSEIF [Country Code]=&apos;PN&apos; THEN [Parameters].[MA H2 Projected Orders (copy)_143270808412803084]*[not comp (copy)_143270808393383943]/[orders (copy)_143270808385777667] * [Parameters].[Parameter 3]&#13;&#10;END' />
            </column>
            <column caption='new comp' datatype='integer' name='[Calculation_143270808766136337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;NOT ISNULL([compensation]) THEN [compensation]&#13;&#10;ELSEIF (NOT ISNULL([Promised Delivery Time])) AND ISNULL([Actual Delivery Time]) &#13;&#10;THEN &#13;&#10;IF [Agent Contact Reason]=&apos;Delay Complaint - Short&apos; THEN 15 &#13;&#10;ELSEIF [Agent Contact Reason]=&apos;Delay Complaint - Moderate&apos; OR [Agent Contact Reason]=&apos;Delay Complaint&apos; THEN 20&#13;&#10;ELSEIF [Agent Contact Reason]=&apos;Delay Complaint - Extreme&apos; OR [Agent Contact Reason]=&apos;Delay Complaint - Severe&apos; THEN 25&#13;&#10;END&#13;&#10;END' />
            </column>
