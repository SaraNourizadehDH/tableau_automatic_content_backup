            <column caption='Dim 2' datatype='string' name='[Dim 1 (copy)_143270808411447307]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_143270808411119625]&#13;&#10;WHEN &apos;Country&apos; THEN [Country Code]&#13;&#10;WHEN &apos;is Food&apos; THEN [Is Food Order?]&#13;&#10;WHEN &apos;is Modified&apos; THEN [Is Modified?]&#13;&#10;WHEN &apos; &apos; THEN &apos; &apos;&#13;&#10;END' />
