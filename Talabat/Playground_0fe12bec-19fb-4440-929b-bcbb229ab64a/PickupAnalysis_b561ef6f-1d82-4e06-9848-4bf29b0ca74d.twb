    <worksheet name='Pickup-to-Food Frequency Ratio'>
      <table>
        <view>
          <datasources>
            <datasource caption='PICKUP analysis' name='federated.0aiaow30erhcbe16t6pvh1hjx0it' />
            <datasource caption='PICKUP cities' name='federated.0qpg6be0tfmu4o1b25xnx0xfb0si' />
          </datasources>
          <datasource-dependencies datasource='federated.0aiaow30erhcbe16t6pvh1hjx0it'>
            <column caption='Freq ratio' datatype='real' name='[Calculation_1255378428234080262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders]) / SUM([maus])) /&#13;&#10;(SUM([total_orders]) / SUM([total_maus]))' />
            </column>
            <column datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[maus]' role='measure' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_iso]' derivation='None' name='[none:country_iso:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_maus]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1255378428234080262]' derivation='User' name='[usr:Calculation_1255378428234080262:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
