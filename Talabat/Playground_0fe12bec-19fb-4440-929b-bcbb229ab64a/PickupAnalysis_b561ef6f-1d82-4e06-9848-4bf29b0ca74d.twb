          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11kni3r0zydce413u1um01a67a8t'>
            <column caption='MAUs Penetration' datatype='real' name='[Calculation_1255378428204965891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vip_pickup_maus]) / SUM([vip_maus])' />
            </column>
            <column caption='Heavy MAUs Penetration' datatype='real' name='[Calculation_1255378428205178884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(zn(SUM([apr_vip_heavy_pickup_customers])) + zn(SUM([jun_vip_heavy_pickup_customers])))&#13;&#10;/ SUM([vip_maus])' />
            </column>
            <column caption='Orders Penetration' datatype='real' name='[Calculation_1255378428206043141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_orders]) / SUM([orders])' />
            </column>
            <column datatype='integer' name='[apr_vip_heavy_pickup_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[jun_vip_heavy_pickup_customers]' role='measure' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pickup_orders]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:ok]' pivot='key' type='ordinal' />
