            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_maus]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_888335063566594054]' derivation='User' name='[usr:Calculation_888335063566594054:qk]' pivot='key' type='quantitative' />
