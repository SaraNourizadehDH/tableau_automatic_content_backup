      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A31842391575414F89E81666BD622B69'>
            <properties context=''>
              <relation connection='bigquery.1yyzqii0lewaqj168rxzw1np5iys' name='Custom SQL Query' type='text'>select &#13;
&#13;
date_trunc(o.order_date, month) month,&#13;
l.city_name,&#13;
v.vendor_name,&#13;
&#13;
count(*) as food_orders,&#13;
sum(case when o.delivery_arrangement=&apos;PICKUP&apos; then 1 end) as pickup_orders,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` v on o.vendor_id=v.vendor_id &#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` l on o.delivery_location_id=l.location_id&#13;
&#13;
where order_date&gt;&gt;=&apos;2024-01-01&apos; and o.is_successful and not o.is_test and o.country_id=9 and not o.is_non_food &#13;
&#13;
group by 1,2,3</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='PICKUP cities' inline='true' name='federated.0qpg6be0tfmu4o1b25xnx0xfb0si' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.00rxbt30gnevnh11nsjlp06031q8'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='youssef.wageeh@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00rxbt30gnevnh11nsjlp06031q8' name='Custom SQL Query' type='text'>with pickup_users as &#13;
(&#13;
  select &#13;
  distinct date_trunc(order_date, month) month, l.city_name, analytical_customer_id, &#13;
  count(*) as orders,&#13;
  sum(basket_amount_eur) basket_amount_lc,&#13;
  count(distinct vendor_id) as active_pickup_vendors,&#13;
&#13;
  from `tlb-data-prod.data_platform.fct_order_info` o&#13;
  left join `tlb-data-prod.data_platform.sq_dim_location_eg` l on o.delivery_location_id=l.location_id &#13;
&#13;
  where order_date&gt;&gt;=&apos;2024-01-01&apos; and is_successful and not is_test &#13;
  and not is_darkstore and not is_nfv and delivery_arrangement=&apos;PICKUP&apos; and country_id=9&#13;
  group by 1,2,3&#13;
),&#13;
&#13;
food_users as &#13;
(&#13;
  select &#13;
  distinct date_trunc(order_date, month) month, l.city_name, analytical_customer_id, &#13;
  count(*) as food_orders,&#13;
  sum(basket_amount_eur) basket_amount_lc,&#13;
&#13;
  from `tlb-data-prod.data_platform.fct_order_info` o&#13;
  left join `tlb-data-prod.data_platform.sq_dim_location_eg` l on o.delivery_location_id=l.location_id &#13;
&#13;
  where order_date&gt;&gt;=&apos;2024-01-01&apos; and is_successful and not is_test &#13;
  and not is_darkstore and not is_nfv and country_id=9&#13;
  group by 1,2,3&#13;
),&#13;
&#13;
total as (&#13;
  select &#13;
  date_trunc(order_date, month) month, l.city_name, &#13;
  count(distinct o.vendor_id) as active_food_vendors,&#13;
  count(distinct case when delivery_arrangement=&apos;PICKUP&apos; then o.vendor_id end) as active_pickup_vendors,&#13;
&#13;
  from `tlb-data-prod.data_platform.fct_order_info` o&#13;
  left join `tlb-data-prod.data_platform.sq_dim_location_eg` l on o.delivery_location_id=l.location_id &#13;
&#13;
  where order_date&gt;&gt;=&apos;2024-01-01&apos; and is_successful and not is_test &#13;
  and not is_darkstore and not is_nfv and country_id=9&#13;
  --and not is_darkstore and not is_nfv and delivery_arrangement=&apos;PICKUP&apos; and country_id=9&#13;
  group by 1,2 &#13;
),&#13;
&#13;
pickup as (&#13;
select &#13;
p.month,&#13;
p.city_name,&#13;
&#13;
-- sum(p.orders) / count(distinct p.analytical_customer_id) as freq,&#13;
count(distinct c.analytical_customer_id) / count(distinct(p.analytical_customer_id)) * 100 as retention,&#13;
-- sum(p.basket_amount_lc) / sum(p.orders) as AFV,&#13;
&#13;
count(distinct(p.analytical_customer_id)) as maus,&#13;
sum(p.basket_amount_lc) as basket_amount,&#13;
sum(p.orders) as orders,&#13;
count(distinct c.analytical_customer_id) as retained_customers,&#13;
&#13;
from pickup_users as p&#13;
left join food_users as c &#13;
  on p.analytical_customer_id=c.analytical_customer_id and p.month=date_sub(c.month, INTERVAL 1 MONTH) and p.city_name=c.city_name &#13;
&#13;
group by p.month,2&#13;
order by p.month,2&#13;
),&#13;
&#13;
food as (&#13;
select &#13;
p.month,&#13;
p.city_name,&#13;
&#13;
count(distinct c.analytical_customer_id) / count(distinct(p.analytical_customer_id)) * 100 as food_retention,&#13;
count(distinct(p.analytical_customer_id)) as total_maus,&#13;
sum(p.food_orders) as total_orders,&#13;
&#13;
from food_users as p&#13;
left join food_users as c &#13;
  on p.analytical_customer_id=c.analytical_customer_id and p.month=date_sub(c.month, INTERVAL 1 MONTH) and p.city_name=c.city_name&#13;
&#13;
group by p.month,2&#13;
order by p.month,2&#13;
)&#13;
&#13;
select *,&#13;
&#13;
lag(retention,1) over(partition by city_name order by month) retention_test,&#13;
lag(food_retention,1) over(partition by city_name order by month) food_retention_test,&#13;
&#13;
from food&#13;
left join pickup ts using(month, city_name)&#13;
left join total t using(month, city_name)&#13;
&#13;
order by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
