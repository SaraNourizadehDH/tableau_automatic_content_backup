      <aliases enabled='yes' />
      <column caption='AFV EUR' datatype='real' name='[Calculation_1255378428174876672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basket_amount]) / SUM([orders])' />
      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_1255378428175757313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) /&#13;&#10;SUM(&#13;&#10;{ FIXED [month]:&#13;&#10;MIN(&#13;&#10;IF MONTH([month]) = MONTH(TODAY()) and YEAR([month])=YEAR(TODAY()) THEN&#13;&#10;(DAY(TODAY()) - 1)&#13;&#10;//DAY([max_date])&#13;&#10;&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [month]))))&#13;&#10;END&#13;&#10;)&#13;&#10;}&#13;&#10;)' />
      </column>
      <column caption='MAUs Penetration' datatype='real' name='[Calculation_1255378428195655682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([maus]) / SUM([total_maus])' />
      </column>
      <column caption='Freq ratio' datatype='real' name='[Calculation_1255378428234080262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders]) / SUM([maus])) /&#13;&#10;(SUM([total_orders]) / SUM([total_maus]))' />
      </column>
      <column caption='Pickup Retention Ratio' datatype='real' name='[Calculation_1271141026951249920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[retention_test] / [food_retention_test]' />
      </column>
      <column caption='Pickup Share of Orders' datatype='real' name='[Calculation_477663067877847041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([total_orders])' />
      </column>
      <column caption='Pickup Frequnecy' datatype='real' name='[Calculation_477663067878756354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([maus])' />
      </column>
      <column caption='Food Frequncy' datatype='real' name='[Calculation_477663067879165955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) / SUM([total_maus])' />
      </column>
      <column caption='Food MAUs' datatype='integer' name='[Calculation_477663067880804356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_maus])' />
      </column>
      <column caption='Food Daily Orders' datatype='real' name='[Daily Orders (copy)_477663067877347328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) /&#13;&#10;SUM(&#13;&#10;{ FIXED [month]:&#13;&#10;MIN(&#13;&#10;IF MONTH([month]) = MONTH(TODAY()) and YEAR([month])=YEAR(TODAY()) THEN&#13;&#10;(DAY(TODAY()) - 1)&#13;&#10;//DAY([max_date])&#13;&#10;&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [month]))))&#13;&#10;END&#13;&#10;)&#13;&#10;}&#13;&#10;)' />
      </column>
