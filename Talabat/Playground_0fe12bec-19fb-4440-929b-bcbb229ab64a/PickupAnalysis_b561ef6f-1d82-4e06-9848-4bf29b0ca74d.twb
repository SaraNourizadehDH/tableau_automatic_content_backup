      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_888335063515348992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) /&#13;&#10;SUM(&#13;&#10;{ FIXED [month]:&#13;&#10;MIN(&#13;&#10;IF MONTH([month]) = MONTH(TODAY()) and YEAR([month])=YEAR(TODAY()) THEN&#13;&#10;(DAY(TODAY()) - 1)&#13;&#10;//DAY([max_date])&#13;&#10;&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [month]))))&#13;&#10;END&#13;&#10;)&#13;&#10;}&#13;&#10;)' />
      </column>
      <column caption='Food Daily Orders' datatype='real' name='[Calculation_888335063556825089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) /&#13;&#10;SUM(&#13;&#10;{ FIXED [month]:&#13;&#10;MIN(&#13;&#10;IF MONTH([month]) = MONTH(TODAY()) and YEAR([month])=YEAR(TODAY()) THEN&#13;&#10;(DAY(TODAY()) - 1)&#13;&#10;//DAY([max_date])&#13;&#10;&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [month]))))&#13;&#10;END&#13;&#10;)&#13;&#10;}&#13;&#10;)' />
      </column>
      <column caption='pickup share of orders' datatype='real' name='[Calculation_888335063562063874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([total_orders])' />
      </column>
      <column caption='MAUs Penetration' datatype='real' name='[Calculation_888335063563784195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([maus]) / SUM([total_maus])' />
      </column>
      <column caption='pickup frequency' datatype='real' name='[Calculation_888335063565713412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([maus])' />
      </column>
      <column caption='Freq. ratio' datatype='real' name='[Calculation_888335063566594054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders]) / SUM([maus])) /&#13;&#10;(SUM([total_orders]) / SUM([total_maus]))' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_9EB2CF64425D43D0B9B931F2A9859108]' role='measure' type='quantitative' />
      <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='food frequency' datatype='real' name='[pickup frequency (copy)_888335063565942789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) / SUM([total_maus])' />
      </column>
