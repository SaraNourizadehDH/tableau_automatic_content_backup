        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0i0ats501052mp1by37fp12z8kis' name='Custom SQL Query' type='text'>with apr as (&#13;
select &#13;
month,&#13;
count(distinct analytical_customer_id) as apr_vip_heavy_pickup_customers&#13;
&#13;
from (&#13;
select &#13;
date_trunc(order_date, month) month, &#13;
o.analytical_customer_id,&#13;
count(*) as apr_pickup_orders,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.sq_ct_dim_customer` c using(account_id)&#13;
&#13;
where date_trunc(order_date, month) in (&apos;2025-04-01&apos;)&#13;
and is_successful and not is_test &#13;
and not is_darkstore and not is_nfv and country_id=9&#13;
and c.New_Health_flag=&apos;VIP&apos; and o.delivery_arrangement=&apos;PICKUP&apos;&#13;
&#13;
group by 1,2&#13;
having apr_pickup_orders&gt;&gt;=3 &#13;
)&#13;
group by 1&#13;
),&#13;
&#13;
jun as (&#13;
select &#13;
month,&#13;
count(distinct analytical_customer_id) as jun_vip_heavy_pickup_customers&#13;
&#13;
from (&#13;
select &#13;
date_trunc(order_date, month) month, &#13;
o.analytical_customer_id,&#13;
count(*) as apr_pickup_orders,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.sq_ct_dim_customer` c using(account_id)&#13;
&#13;
where date_trunc(order_date, month) in (&apos;2025-06-01&apos;)&#13;
and is_successful and not is_test &#13;
and not is_darkstore and not is_nfv and country_id=9&#13;
and c.New_Health_flag=&apos;VIP&apos; and o.delivery_arrangement=&apos;PICKUP&apos;&#13;
&#13;
group by 1,2&#13;
having apr_pickup_orders&gt;&gt;=3 &#13;
)&#13;
group by 1&#13;
),&#13;
&#13;
vip as (&#13;
select &#13;
date_trunc(order_date, month) month, &#13;
count( distinct o.analytical_customer_id) as vip_maus, &#13;
count( distinct case when o.delivery_arrangement=&apos;PICKUP&apos; then o.analytical_customer_id end) as vip_pickup_maus,&#13;
--count( distinct case when o.delivery_arrangement=&apos;PICKUP&apos; then o.analytical_customer_id end) as vip_pickup_maus,&#13;
&#13;
