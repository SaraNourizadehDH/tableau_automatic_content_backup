        </calculation>
      </column>
      <column caption='heur_sum' datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Calculation_837106591888977924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(if [max_sbheur (copy)_837106591885959171] then [Calculation_846958214591156231] else 0 end)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='b_avg_daily_orders' datatype='real' name='[Calculation_846958214580629504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([b_gfv (copy)_1161084288226783246])/SUM([a_days (copy)_891431260635848704])' />
      </column>
      <column caption='a_gv_contrib' datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Calculation_846958214587723779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([a_comm_amt (copy)_1161084288226418700])/SUM({Fixed :SUM([a_comm_amt (copy)_1161084288226418700])})' />
      </column>
      <column caption='heuristic' datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Calculation_846958214591156231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([b_comm_contrib (copy)_846958214590324741]-[a_gfv_contrib (copy)_846958214589448196]) - ([Calculation_846958214587723779]-[a_gfv_contrib (copy)_846958214590738438])' />
      </column>
      <column caption='Reason' datatype='string' name='[Calculation_846958214622011404]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_846958214591156231] &lt; 0 &#13;&#10;  THEN (&#13;&#10;      IF ([b_comm (copy)_1161084288233291795] - [b_comm_amt (copy)_1161084288233005074])*100 &lt; -0.45 THEN &quot;-VE: Commission% Dropped&quot;&#13;&#10;      ELSEIF SUM([a_comm_amt (copy)_1161084288226418700]) = 0 THEN &quot;-VE: Chain Left, High Commission&quot;&#13;&#10;      ELSEIF SUM([b_comm_amt (copy)_1161084288226631693]) = 0 THEN &quot;-VE: New Chain, Low Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND [b_afv (copy)_1161084288237424660] &lt; [a_afv (copy)_1161084288228413457] AND sum([a_gfv (copy)_1161084288226938895]) &lt; sum([b_gfv (copy)_1161084288226783246])&#13;&#10;      THEN &quot;-VE: Weight Increased, Low Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &gt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;-VE: AFV/AOV Increased, Low Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &lt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1)   &#13;&#10;      THEN &quot;-VE: Orders Increased, Low Commission&quot; &#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND [b_afv (copy)_1161084288237424660] &gt; [a_afv (copy)_1161084288228413457] AND sum([a_gfv (copy)_1161084288226938895]) &gt; sum([b_gfv (copy)_1161084288226783246])&#13;&#10;      THEN &quot;-VE: Weight Decreased, High Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &gt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;-VE: Orders Decreased, High Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &lt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;-VE: AFV/AOV Decreased, High Commission&quot; &#13;&#10;      END&#13;&#10;  )   &#13;&#10; &#13;&#10;ELSEIF  [Calculation_846958214591156231] &gt; 0&#13;&#10;  THEN ( &#13;&#10;      IF ([b_comm (copy)_1161084288233291795] - [b_comm_amt (copy)_1161084288233005074])*100 &gt; 0.45 THEN &quot;+VE: Commission% Increased&quot;&#13;&#10;      ELSEIF sum([a_comm_amt (copy)_1161084288226418700]) = 0 THEN &quot;+VE: Chain Left, Low Commission &quot;&#13;&#10;      ELSEIF sum([b_comm_amt (copy)_1161084288226631693]) = 0 THEN &quot;+VE: New Chain, High Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND [b_afv (copy)_1161084288237424660] &lt; [a_afv (copy)_1161084288228413457] AND sum([a_gfv (copy)_1161084288226938895]) &lt; sum([b_gfv (copy)_1161084288226783246])&#13;&#10;      THEN &quot;+VE: Weight Increased, High Commission&quot; &#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &gt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;+VE: AFV/AOV Increased, High Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &gt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &lt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;+VE: Orders Increased, High Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND [b_afv (copy)_1161084288237424660] &gt; [a_afv (copy)_1161084288228413457] AND sum([a_gfv (copy)_1161084288226938895]) &gt; sum([b_gfv (copy)_1161084288226783246])&#13;&#10;      THEN &quot;+VE: Weight Decreased, Low Commission&quot; &#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &gt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;+VE: Orders Decreased, Low Commission&quot;&#13;&#10;      ELSEIF [b_comm_amt (copy)_1161084288233005074] &lt; [b_comm_amt (copy)_891431260639797249] AND (([b_afv (copy)_1161084288237424660]/[a_afv (copy)_1161084288228413457])-1) &lt; (sum([a_gfv (copy)_1161084288226938895])/sum([b_gfv (copy)_1161084288226783246])-1) &#13;&#10;      THEN &quot;+VE: AFV/AOV Decreased, Low Commission&quot;&#13;&#10;      END      &#13;&#10;  )&#13;&#10;  ELSE &quot;No Significant Change&quot;&#13;&#10;  END' />
      </column>
