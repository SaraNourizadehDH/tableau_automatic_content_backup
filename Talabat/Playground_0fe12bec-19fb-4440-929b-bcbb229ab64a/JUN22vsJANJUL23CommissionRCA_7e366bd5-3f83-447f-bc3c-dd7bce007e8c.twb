      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_07C4AC43AED9488EA3CF956A549AFC42'>
            <properties context=''>
              <relation connection='bigquery.0ipnhb20hvuscu10p3tep1xa50f2' name='Custom SQL Query' type='text'>SELECT ch.chain_id,&#13;
  ch.chain_name, &#13;
  o.order_date,&#13;
  o.delivery_arrangement,&#13;
  --sales.Sales_team TL,&#13;
  --sales.account_manager AM,&#13;
&#13;
  SUM(orf.adj_commissionable_gmv) comm_gmv_eg,&#13;
  COUNT(distinct o.order_id) orders,&#13;
  SUM(orf.rev_commission) comm_amt_eg,&#13;
 -- SUM(bill.commission_amount_lc) comm_amt,&#13;
  --SUM(bill.commissionable_gmv_amount_lc) comm_gmv&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
--LEFT JOIN `tlb-data-prod.data_platform.fct_billing` bill&#13;
--ON bill.order_id = o.order_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch &#13;
ON ch.chain_id = o.chain_id&#13;
LEFT JOIN `tlb-data-dev.performance_management_egypt.cv_fct_order_financials_eg` orf&#13;
ON orf.order_id = o.order_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_country_info` c&#13;
ON o.country_id = c.country_id&#13;
--LEFT JOIN `tlb-data-dev.performance_management_egypt.cv_dim_chain` sales&#13;
--ON ch.chain_id = sales.chain_id&#13;
&#13;
WHERE o.is_successful AND NOT o.is_test AND o.country_id=9 and not is_non_food&#13;
AND date_trunc(o.order_date,month) IN (&apos;2022-06-01&apos;,&apos;2023-01-01&apos;, &apos;2023-07-1&apos;)&#13;
GROUP BY 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
