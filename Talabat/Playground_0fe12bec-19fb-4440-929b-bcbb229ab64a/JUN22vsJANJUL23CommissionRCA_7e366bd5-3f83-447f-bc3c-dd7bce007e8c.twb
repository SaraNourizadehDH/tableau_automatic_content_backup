      </column>
      <column caption='b_comm_amt' datatype='real' name='[Calculation_1161084287957680137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(if [order_date] &gt;= (#2022-06-01#) and [order_date] &lt;= (#2022-06-30#)&#13;&#10; then [comm_amt_eg] end)' />
      </column>
      <column caption='Actual Month' datatype='integer' datatype-customized='true' name='[Calculation_661747711753822208]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Actual Month Parameter]=&apos;January 2023&apos;&#13;&#10;then 1&#13;&#10; //[Actual-From]=(#2023-01-01#) and [Actual-To]=(#2023-01-31#) &#13;&#10;elseif [Parameters].[Actual Month Parameter]=&apos;July 2023&apos; &#13;&#10;then 7&#13;&#10;//[Actual-From]=(#2023-07-01#) and [Actual-To]=(#2023-07-31#) &#13;&#10;end' />
      </column>
