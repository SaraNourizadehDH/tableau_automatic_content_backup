        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03zbu2g03saum51d0alt81jocczd' name='Custom SQL Query' type='text'>select *, rank() over(partition by country_iso,vertical order by orders desc) rank&#13;
from(&#13;
&#13;
select chain_name&#13;
,country_iso&#13;
,case when not is_non_food then &apos;food&apos; &#13;
when is_non_food and not is_darkstore then &apos;NFV&apos;&#13;
when is_non_food and is_darkstore then &apos;tMart&apos; end as vertical&#13;
,count(distinct chain_id) unique_chains&#13;
,count(order_id) orders&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info`&#13;
left join `tlb-data-prod.data_platform.dim_chain` using(chain_id)&#13;
where is_successful and not is_test and order_date &gt;&gt;= current_date - interval 6 month&#13;
group by all)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.03zbu2g03saum51d0alt81jocczd' name='Custom SQL Query' type='text'>select *, rank() over(partition by country_iso,vertical order by orders desc) rank&#13;
