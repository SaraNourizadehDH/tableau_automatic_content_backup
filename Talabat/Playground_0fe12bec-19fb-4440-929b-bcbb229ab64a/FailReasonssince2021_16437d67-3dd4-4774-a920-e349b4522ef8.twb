      <aliases enabled='yes' />
      <column caption='Date Level' datatype='datetime' name='[Calculation_281193540027432960]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Day&apos; then [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [order_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;END' />
      </column>
      <column caption='HFR' datatype='real' name='[Calculation_281193540027944961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Failed]) / SUM([Gross]) * 100' />
      </column>
      <column caption='reason FR' datatype='real' name='[Calculation_281193540028043266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Failed]) / TOTAL( SUM([Gross]) ) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Historical' datatype='string' name='[Calculation_521573150190465024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;for the last 12 months, check Historical Dashboard&quot;' />
      </column>
      <column caption='Reason: Sub Reason' datatype='string' name='[Calculation_982910658685767681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reason]+ if not ([sub_reason] = &quot;N/A&quot;) then &quot;:&quot;+[sub_reason] else &quot;&quot; END' />
      </column>
      <column caption='HFR owner' datatype='real' name='[HFR (copy)_850054432677924864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Failed]) / SUM( { FIXED [order_date] : SUM([Gross])} ) * 100&#13;&#10;&#13;&#10;//SUM([Failed])&#13;&#10;&#13;&#10;//SUM( { FIXED [order_date] : SUM([Gross])} )&#13;&#10;&#13;&#10; SUM([Failed]) / SUM( { FIXED [order_date]:SUM([Gross])} ) * 100' />
      </column>
