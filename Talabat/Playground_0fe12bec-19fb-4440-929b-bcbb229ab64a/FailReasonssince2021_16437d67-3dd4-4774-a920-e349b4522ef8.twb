          <named-connection caption='BigQuery' name='bigquery.1fqukiu0wr15qa12r2g8w17d0qpc'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='noura.abdelatef@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1fqukiu0wr15qa12r2g8w17d0qpc' name='Custom SQL Query' type='text'>select &#13;
&#13;
date_trunc(F.order_date,month) order_date, &#13;
F.delivery_arrangement as is_tgo, &#13;
&#13;
DL.cluster_name as city_cluster,&#13;
DL.city_name,&#13;
DL.zone_name_final as zone,&#13;
&#13;
L.reason,&#13;
L.sub_reason,&#13;
L.owner,&#13;
&#13;
V.vendor_name,&#13;
V.account_manager_name,&#13;
C.chain_name,&#13;
&#13;
count(*) as Gross,&#13;
sum(case when F.is_successful = false then 1 else 0 end) as Failed, &#13;
&#13;
--Main Vertical&#13;
case&#13;
 when not F.is_non_food then &apos;Food&apos;&#13;
  when F.is_non_food and not F.is_darkstore then &apos;NFV&apos;&#13;
  when F.is_darkstore then &apos;tmart&apos; &#13;
end as main_vertical , &#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` F &#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` L ON F.order_fail_reason_id = L.order_fail_reason_id&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on F.delivery_location_id = DL.location_id &#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` V on F.vendor_id = V.vendor_id &#13;
left join `tlb-data-prod.data_platform.dim_chain` C on F.chain_id = C.chain_id &#13;
&#13;
where F.country_id = 9 &#13;
and F.order_date &gt;&gt;= &apos;2021-01-01&apos;&#13;
and not F.is_test  &#13;
&#13;
group by ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1fqukiu0wr15qa12r2g8w17d0qpc' name='Custom SQL Query' type='text'>select &#13;
&#13;
date_trunc(F.order_date,month) order_date, &#13;
F.delivery_arrangement as is_tgo, &#13;
&#13;
DL.cluster_name as city_cluster,&#13;
DL.city_name,&#13;
DL.zone_name_final as zone,&#13;
&#13;
L.reason,&#13;
L.sub_reason,&#13;
L.owner,&#13;
&#13;
V.vendor_name,&#13;
V.account_manager_name,&#13;
C.chain_name,&#13;
&#13;
count(*) as Gross,&#13;
sum(case when F.is_successful = false then 1 else 0 end) as Failed, &#13;
&#13;
--Main Vertical&#13;
case&#13;
 when not F.is_non_food then &apos;Food&apos;&#13;
  when F.is_non_food and not F.is_darkstore then &apos;NFV&apos;&#13;
  when F.is_darkstore then &apos;tmart&apos; &#13;
end as main_vertical , &#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` F &#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` L ON F.order_fail_reason_id = L.order_fail_reason_id&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on F.delivery_location_id = DL.location_id &#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` V on F.vendor_id = V.vendor_id &#13;
left join `tlb-data-prod.data_platform.dim_chain` C on F.chain_id = C.chain_id &#13;
&#13;
where F.country_id = 9 &#13;
and F.order_date &gt;&gt;= &apos;2021-01-01&apos;&#13;
and not F.is_test  &#13;
&#13;
group by ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
