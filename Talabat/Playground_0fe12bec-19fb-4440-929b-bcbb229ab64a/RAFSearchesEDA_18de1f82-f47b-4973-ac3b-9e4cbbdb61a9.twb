            <column caption='Search Filter Match' datatype='boolean' name='[Calculation_81346281951125504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_MATCH(LOWER([searched_words]), [Parameters].[Parameter 2])' />
