      </semantic-values>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='date' />
        <field-sort-custom-order field='zone' />
        <field-sort-custom-order field='searched_words' />
        <field-sort-custom-order field='Calculation_164944348595793921' />
        <field-sort-custom-order field='Calculation_567735040616378372' />
        <field-sort-custom-order field='Geometry (generated)' />
        <field-sort-custom-order field='Latitude (generated)' />
        <field-sort-custom-order field='Longitude (generated)' />
        <field-sort-custom-order field='Calculation_164944348595449856' />
        <field-sort-custom-order field=':Measure Names' />
        <field-sort-custom-order field='Multiple Values' />
      </field-sort-info>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot; &quot;'>
          <calculation class='tableau' formula='&quot; &quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_48B6FF05955E4B88B1DCD2DC388996BE'>
            <properties context=''>
              <relation connection='bigquery.0z14hgx1s3k71u1fomgzj1ehsagv' name='Custom SQL Query' type='text'><![CDATA[SELECT
  date,
  COALESCE(dl.zone_name, 'Unknown') AS zone,
  CASE 
    WHEN TIME(sub_session_start_time) >> '01:00:00' AND TIME(sub_session_start_time) << '07:00:00' THEN 'Night Owl'
    WHEN TIME(sub_session_start_time) >>= '07:00:00' AND TIME(sub_session_start_time) <<= '13:00:00' THEN 'Breakfast'
    WHEN TIME(sub_session_start_time) >> '13:00:00' AND TIME(sub_session_start_time) <<= '19:00:00' THEN 'Lunch'
    WHEN (TIME(sub_session_start_time) >> '19:00:00' AND TIME(sub_session_start_time) <<= '23:59:59') 
    OR (TIME(sub_session_start_time) >>= '00:00:00' AND TIME(sub_session_start_time) <<= '01:00:00') THEN 'Dinner'
  END AS search_tod,

  CASE 
    WHEN TIME(placed_order_time) >> '01:00:00' AND TIME(placed_order_time) << '07:00:00' THEN 'Night Owl'
    WHEN TIME(placed_order_time) >>= '07:00:00' AND TIME(placed_order_time) <<= '13:00:00' THEN 'Breakfast'
    WHEN TIME(placed_order_time) >> '13:00:00' AND TIME(placed_order_time) <<= '19:00:00' THEN 'Lunch'
    WHEN (TIME(placed_order_time) >> '19:00:00' AND TIME(placed_order_time) <<= '23:59:59') 
    OR (TIME(placed_order_time) >>= '00:00:00' AND TIME(placed_order_time) <<= '01:00:00') THEN 'Dinner'
  END AS order_tod,

  IFNULL(search_query_entered, partial_search_queries_entered) searched_words,
  placed_order,


FROM `tlb-data-prod.data_platform.fct_sub_session_search` s
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dl
 ON s.location_id = dl.location_id


WHERE s.country_code = 'EG'
AND date >>= '2025-01-01'
AND LOWER(partial_search_queries_entered) LIKE ANY( 'raf_', 'raf', '%raf coffee%', '%raf speciality coffee%')

ORDER BY 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='vasko' inline='true' name='federated.0o41c690snuqxd13q65ee10430bw' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gldsk41vqfhys1bi5vma0lbfz60'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='fatimah.farouk@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gldsk41vqfhys1bi5vma0lbfz60' name='Custom SQL Query' type='text'><![CDATA[SELECT
 date,
 COALESCE(dl.zone_name, 'Unknown') AS zone,

 CASE 
  WHEN TIME(sub_session_start_time) >> '01:00:00' AND TIME(sub_session_start_time) << '07:00:00' THEN 'Night Owl'
  WHEN TIME(sub_session_start_time) >>= '07:00:00' AND TIME(sub_session_start_time) <<= '13:00:00' THEN 'Breakfast'
  WHEN TIME(sub_session_start_time) >> '13:00:00' AND TIME(sub_session_start_time) <<= '19:00:00' THEN 'Lunch'
  WHEN (TIME(sub_session_start_time) >> '19:00:00' AND TIME(sub_session_start_time) <<= '23:59:59') 
   OR (TIME(sub_session_start_time) >>= '00:00:00' AND TIME(sub_session_start_time) <<= '01:00:00') THEN 'Dinner'
 END AS search_tod,

 CASE 
  WHEN TIME(placed_order_time) >> '01:00:00' AND TIME(placed_order_time) << '07:00:00' THEN 'Night Owl'
  WHEN TIME(placed_order_time) >>= '07:00:00' AND TIME(placed_order_time) <<= '13:00:00' THEN 'Breakfast'
  WHEN TIME(placed_order_time) >> '13:00:00' AND TIME(placed_order_time) <<= '19:00:00' THEN 'Lunch'
  WHEN (TIME(placed_order_time) >> '19:00:00' AND TIME(placed_order_time) <<= '23:59:59') 
   OR (TIME(placed_order_time) >>= '00:00:00' AND TIME(placed_order_time) <<= '01:00:00') THEN 'Dinner'
 END AS order_tod,

 s.transaction_id,
 o.order_id,
 placed_order,
 IFNULL(search_query_entered, partial_search_queries_entered) AS searched_words,
 clicked_vendor_id

FROM `tlb-data-prod.data_platform.fct_sub_session_search` s

LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dl
 ON s.location_id = dl.location_id

LEFT JOIN (
 SELECT o.*
 FROM `tlb-data-prod.data_platform.fct_order_info` o
 JOIN `tlb-data-prod.data_platform.dim_vendor` v ON o.vendor_id = v.vendor_id
 JOIN `tlb-data-prod.data_platform.dim_chain` c ON v.chain_id = c.chain_id
 WHERE c.country_id = 9 AND LOWER(c.chain_name) LIKE '%vasko%'
) o
 ON CAST(o.order_id AS STRING) = s.transaction_id
 AND o.vendor_id = s.clicked_vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` v
 ON s.clicked_vendor_id = v.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c
 ON v.chain_id = c.chain_id

WHERE s.country_code = 'EG'
AND date >>= '2025-02-01'
AND LOWER(partial_search_queries_entered) LIKE ANY('vasko_', 'vasco_', '%vasko coffe%', '%فاسكو%')

ORDER BY 1, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gldsk41vqfhys1bi5vma0lbfz60' name='Custom SQL Query' type='text'><![CDATA[SELECT
