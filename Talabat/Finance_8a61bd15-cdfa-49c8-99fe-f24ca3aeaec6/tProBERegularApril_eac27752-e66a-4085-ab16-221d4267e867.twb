      <column caption='Membership Price (VAT EXC) - 1 month' datatype='real' name='[Calculation_1448188805498306570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN 29/1.05&#13;&#10;WHEN &apos;KW&apos; THEN 3.5&#13;&#10;WHEN &apos;QA&apos; THEN 40&#13;&#10;WHEN &apos;BH&apos; THEN 2.5/1.1&#13;&#10;WHEN &apos;JO&apos; THEN 3/1.16&#13;&#10;WHEN &apos;OM&apos; THEN 2.4/1.05&#13;&#10;END' />
      </column>
      <column caption='Trial Period' datatype='real' name='[Calculation_1448188805498789900]' role='measure' type='quantitative'>
