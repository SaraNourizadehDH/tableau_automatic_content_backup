      <column caption='Churned' datatype='integer' name='[Calculation_2115565974932242437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([acqns_reg_moved_to_lite]) + ZN([acqns_reg_moved_to_bt]) + ZN([acqns_reg_churned]) + &#13;&#10;ZN([winbacks_reg_churned]) + ZN([winbacks_lite_churned]) +&#13;&#10;ZN([active_lm_moved_to_lite]) + ZN([active_lm_moved_to_bt]) + ZN([active_lm_churned]) + &#13;&#10;ZN([bt_moved_to_lite]) + ZN([bt_moved_to_bt]) + ZN([bt_churned]))' />
