      <column caption='Co-funded tPro orders Percentage - Low Basket' datatype='real' name='[Calculation_1448188805499523088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[co_funded_orders]/([food_tgo_tpro_orders] + [nfv_tgo_tpro_orders])' />
