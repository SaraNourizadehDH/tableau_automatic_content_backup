sum(case when b.is_tgo and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as nfv_tgo_gfv_net_discounts,

-- NFV TMP Orders
count(distinct case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then order_id END) as nfv_tmp_orders,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc END) as nfv_tmp_gmv,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then basket_amount_lc END) as nfv_tmp_gfv,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as nfv_tmp_gfv_net_discounts,

-- DHK TGO Orders
