              <calculation class='tableau' formula='ZN([tpro_service_fee_revenue]) + ZN([tpro_ncr]) + ZN([tpro_commission_revenue]) + ZN([tpro_revenue_reduction_others])' />
            </column>
            <column caption='Platform Related Cost' datatype='real' name='[Calculation_1760344556487045132]' role='measure' type='quantitative'>
