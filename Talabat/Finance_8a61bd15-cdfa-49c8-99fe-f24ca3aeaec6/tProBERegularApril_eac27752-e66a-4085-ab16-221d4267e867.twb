      <column caption='Membership Price (VAT EXC) - 1 month' datatype='real' name='[Calculation_1448188805498306570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN 29/1.05&#13;&#10;WHEN &apos;KW&apos; THEN 3.5&#13;&#10;WHEN &apos;QA&apos; THEN 40&#13;&#10;WHEN &apos;BH&apos; THEN 2.5/1.1&#13;&#10;WHEN &apos;JO&apos; THEN 3/1.16&#13;&#10;WHEN &apos;OM&apos; THEN 2.4/1.05&#13;&#10;END' />
      </column>
      <column caption='Trial Period' datatype='real' name='[Calculation_1448188805498789900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN 0.5&#13;&#10;WHEN &apos;KW&apos; THEN 0.5&#13;&#10;WHEN &apos;QA&apos; THEN if [iso_date] &gt;= #2024-01-01# then 0.5 else 1 END&#13;&#10;WHEN &apos;BH&apos; THEN 1&#13;&#10;WHEN &apos;JO&apos; THEN if [iso_date] &gt;= #2024-01-01# then 0.5 else 1 END&#13;&#10;WHEN &apos;OM&apos; THEN 0.5&#13;&#10;END' />
      </column>
      <column caption='Delivery Fees Paid by Merchants' datatype='real' name='[Calculation_1448188805498937357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN 7/1.05&#13;&#10;WHEN &apos;KW&apos; THEN 0.7&#13;&#10;WHEN &apos;QA&apos; THEN 10&#13;&#10;WHEN &apos;BH&apos; THEN 0&#13;&#10;WHEN &apos;JO&apos; THEN 0.6/1.16&#13;&#10;WHEN &apos;OM&apos; THEN 0.55/1.05&#13;&#10;END' />
      </column>
      <column caption='Double discounted order share' datatype='real' name='[Calculation_1448188805499109390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[double_discounted_orders]/([Calculation_2115565974933639177]+[Food - Pro Orders (copy)_2115565974933819402])' />
      </column>
      <column caption='tMart DF Funded by Talabat' datatype='integer' name='[Calculation_1448188805499363343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Co-funded tPro orders Percentage - Low Basket' datatype='real' name='[Calculation_1448188805499523088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[co_funded_orders]/([food_tgo_tpro_orders] + [nfv_tgo_tpro_orders])' />
      </column>
      <column caption='Co-funded tPro orders cost - Low Basket' datatype='real' name='[Calculation_1448188805499711505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN if [iso_date] &gt;= #2024-01-01# then 0 else 3/1.05 END&#13;&#10;WHEN &apos;KW&apos; THEN 0.3&#13;&#10;WHEN &apos;QA&apos; THEN if [iso_date] &gt;= #2024-01-01# then 10 else 0 END&#13;&#10;WHEN &apos;BH&apos; THEN 0&#13;&#10;WHEN &apos;OM&apos; THEN 0.3/1.05&#13;&#10;END' />
      </column>
      <column caption='Capped Orders Percentage' datatype='real' name='[Calculation_1448188805500096530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[capped_orders]/[food_tgo_tpro_orders]' />
