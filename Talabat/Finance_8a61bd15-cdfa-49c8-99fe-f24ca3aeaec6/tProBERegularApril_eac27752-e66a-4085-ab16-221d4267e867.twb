              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Partnership Price (VAT EXC)' datatype='integer' name='[Assumptions - Subscription (copy)_1448188805498081289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
