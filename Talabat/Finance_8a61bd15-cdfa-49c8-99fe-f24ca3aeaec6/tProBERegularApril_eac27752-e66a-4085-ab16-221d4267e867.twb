            </column>
            <column caption='Overall Subscribers Orders' datatype='integer' name='[Calculation_2115565974933127176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[food_tgo_tpro_orders] + [food_tmp_tpro_orders] + [tmart_tpro_orders] + [nfv_tgo_tpro_orders] + [nfv_tmp_tpro_orders] + [dhk_tgo_orders] + [dhk_tmp_orders] + [non_pro_orders]' />
