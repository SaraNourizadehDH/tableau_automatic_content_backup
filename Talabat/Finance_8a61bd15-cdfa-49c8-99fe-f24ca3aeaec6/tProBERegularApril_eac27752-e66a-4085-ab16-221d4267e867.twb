        <calculation class='tableau' formula='CASE [country_iso]&#13;&#10;WHEN &apos;AE&apos; THEN (19*12)/1.05&#13;&#10;WHEN &apos;KW&apos; THEN 2.5*6 &#13;&#10;WHEN &apos;QA&apos; THEN 360&#13;&#10;WHEN &apos;BH&apos; THEN 24/1.1&#13;&#10;WHEN &apos;JO&apos; THEN 30/1.16&#13;&#10;WHEN &apos;OM&apos; THEN (1.5*12)/1.05&#13;&#10;end' />
