      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-aliased-fields='true' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7E9E0AA4A4BA4463A99EFF8895D64AA0'>
            <properties context=''>
              <relation connection='bigquery.0uytwt31piqizh13v1aer12nd5dt' name='Custom SQL Query' type='text'><![CDATA[-- Active Users Movement
with talabat_active as 
(
select
  country_iso,
  date_trunc(order_date, MONTH) as iso_date,
  count(distinct account_id) as talabat_active,
  count(distinct order_id) as talabat_orders,
  sum(gmv_amount_lc) as talabat_gmv,
  sum(basket_amount_lc) as talabat_basket
from
  `tlb-data-prod.data_platform.fct_order_info`
where
  is_successful and country_iso in ('AE', 'KW', 'QA', 'BH', 'JO', 'OM')
and date_trunc(order_date, MONTH) between '2024-03-01' and DATE_ADD(date_trunc(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
group by
  1,
  2
order by 
  1,
  2
),

-- Acquisitions to Regular and lite plans
acqns as 
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.account_id,
case when c.plan_price_lc = 0 then 'Lite' else 'Regular' END as plan_type, 
from `tlb-data-prod.data_platform_rest_tables.customers_d` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id
where DATE(date_trunc(a.start_date, MONTH)) between '2024-03-01' and DATE_ADD(date_trunc(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
group by 1,2,3,4),

-- Movement in Acquisitions 
acqns_status as 
(select 
a.country, 
a.start_month,
count(distinct case when a.plan_type = 'Regular' then a.account_id END) as acqns_reg,
count(distinct case when a.plan_type = 'Lite' then a.account_id END) as acqns_lite,

count(distinct case when a.plan_type = 'Regular' and pln.plan_price_lc = 0 then b.account_id END) as acqns_reg_moved_to_lite,
count(distinct case when a.plan_type = 'Lite' and pln.plan_price_lc <<>> 0 then b.account_id END) as acqns_lite_moved_to_reg,

count(distinct case when a.plan_type = 'Regular' and b.account_id is null then a.account_Id END) as acqns_reg_churned,
count(distinct case when a.plan_type = 'Lite' and b.account_id is null then a.account_Id END) as acqns_lite_churned,

count(distinct case when a.plan_type = 'Regular' and b.subscription_state = 'BILLING RETRY' then a.account_Id END) as acqns_reg_moved_to_bt

from acqns as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = last_day(a.start_month) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
group by 1,2
order by 1,2),

-- Active Subscribers Split based on 1M and LTP.
active_eom as 
(select 
a.country, 
date_trunc(iso_date, MONTH) as iso_month,
a.account_id,
case when c.plan_duration_days = 31 then '1M'
     when c.plan_duration_days <<>> 31 then 'LTP' END as plan_duration
from  
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where  date_trunc(iso_date, MONTH) between '2024-02-01' and DATE_ADD(date_trunc(CURRENT_DATE, MONTH), INTERVAL -1 MONTH) and iso_date = last_day(date_trunc(iso_date, MONTH))
and a.subscription_state <<>> 'BILLING RETRY'
group by 1,2,3,4
order by 1,2,3,4),

-- Active Subscribers Movement
active_lm_but_moved as 
(select 
a.country, 
a.iso_month,
count(distinct a.account_id) as active_lm,
count(distinct case when pln.plan_price_lc <<>> 0 and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_active,
count(distinct case when pln.plan_price_lc = 0 then b.account_id END) as active_lm_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as active_lm_churned

from active_eom as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = last_day(DATE_ADD(a.iso_month, INTERVAL 1 MONTH)) 
and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
group by 1,2
order by 1,2),

paid as 
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.start_date,
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0 
where DATE(date_trunc(a.start_date, MONTH)) between '2024-03-01' and 
DATE_ADD(date_trunc(CURRENT_DATE, MONTH), INTERVAL -1 MONTH) and subscription_state = 'PAID'
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date) = 1),

winbacks as 
(select 
a.country, 
a.start_month, 
a.account_id,
a.prev_plan_id,
prev_subs_type_gp,
case when pln.plan_price_lc = 0 then 'Lite' else 'Regular' END as plan_type, 
from paid as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln
on a.prev_plan_id = pln.plan_id
left join active_eom as b 
on a.country = b.country and a.account_id = b.account_id 
and DATE_ADD(a.start_month, INTERVAL -1 MONTH) = b.iso_month
left join acqns as c
on a.country = c.country and a.account_id = c.account_id and 
a.start_month = c.start_month 
where b.account_id is null and c.account_id is null),

-- Winbacks Organic
winbacks_from_regular as 
(select 
a.country, 
a.start_month,
count(distinct a.account_id) as winbacks_reg,
count(distinct case when pln.plan_price_lc <<>> 0 and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as winbacks_reg_active,
count(distinct case when pln.plan_price_lc = 0 then b.account_id END) as winbacks_reg_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as winbacks_reg_churned
from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = last_day(a.start_month) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where a.prev_subs_type_gp <<>> 'BILLING RETRY' and plan_type = 'Regular'
group by 1,2
order by 1,2),

winbacks_from_lite as 
(select 
a.country, 
a.start_month,
count(distinct a.account_id) as winbacks_lite,
count(distinct case when pln.plan_price_lc <<>> 0 and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as winbacks_lite_active,
count(distinct case when pln.plan_price_lc = 0 then b.account_id END) as winbacks_lite_moved_to_reg,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as winbacks_lite_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as winbacks_lite_churned
from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = last_day(a.start_month) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where a.prev_subs_type_gp <<>> 'BILLING RETRY' and plan_type = 'Lite'
group by 1,2
order by 1,2),

-- Winbacks Converted from Billing Retry
converted_from_bt as 
(select 
a.country, 
a.start_month,
count(distinct a.account_id) as bt,
count(distinct case when pln.plan_price_lc = 0 then b.account_id END) as bt_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as bt_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as bt_churned
from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = last_day(a.start_month) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where a.prev_subs_type_gp = 'BILLING RETRY'
group by 1,2
order by 1,2),

active_data as 
(select
country, 
iso_month,
count(distinct case when plan_duration = '1M' then account_id END) as active_users_1m,
count(distinct case when plan_duration = 'LTP' then account_id END) as active_users_ltp
from active_eom
group by 1,2
order by 1,2),

customer_view as 
(select 
a.country,
DATE_ADD(a.iso_month, interval 1 month) as iso_month, 
a.active_users_1m as active_users_1m_previous_month,
a.active_users_ltp as active_users_ltp_previous_month,
b.acqns_reg,
b.acqns_reg_moved_to_lite,
b.acqns_reg_moved_to_bt,
b.acqns_reg_churned,
b.acqns_lite_moved_to_reg,
c.winbacks_reg, 
c.winbacks_reg_moved_to_lite,
c.winbacks_reg_moved_to_bt,
c.winbacks_reg_churned,
d.winbacks_lite, 
d.winbacks_lite_moved_to_reg,
d.winbacks_lite_moved_to_bt,
d.winbacks_lite_churned,
e.bt,
e.bt_moved_to_lite,
e.bt_moved_to_bt,
e.bt_churned,
f.active_lm,
f.active_lm_active,
f.active_lm_moved_to_lite,
f.active_lm_moved_to_bt,
f.active_lm_churned,
g.active_users_1m as active_users_1m_current_month,
g.active_users_ltp as active_users_ltp_current_month
from active_data as a 
left join acqns_status as b 
on a.country = b.country and a.iso_month = DATE_ADD(b.start_month, INTERVAL -1 MONTH)
left join winbacks_from_regular as c 
on a.country = c.country and a.iso_month = DATE_ADD(c.start_month, INTERVAL -1 MONTH) 
left join winbacks_from_lite as d 
on a.country = d.country and a.iso_month = DATE_ADD(d.start_month, INTERVAL -1 MONTH) 
left join converted_from_bt as e 
on a.country = e.country and a.iso_month = DATE_ADD(e.start_month, INTERVAL -1 MONTH)
left join active_lm_but_moved as f 
on a.country = f.country and a.iso_month = f.iso_month
left join active_data as g 
on a.country = g.country and DATE_ADD(a.iso_month, INTERVAL 1 MONTH) = g.iso_month
order by a.country, a.iso_month),

-- Subscriber Orders Performance.
order_view as 
(select 
a.country,
date,
sum(non_pro_orders) as non_pro_orders,
sum(capped_orders) as capped_orders,
sum(commission_savings) as commission_savings,
sum(gmv_overall) as pro_customer_gmv_overall
from `tlb-data-prod.data_platform.agg_tpro_orders` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c on a.plan_id = c.plan_id
and c.plan_price_lc <<>> 0
where a.country in ('AE','KW','QA','BH','JO','OM')
and subs_type_upd = 'All'
and type = 'Monthly'
and a.date between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
group by 1,2),

tpro_order_view as 
(select 
b.country_iso, 
date_trunc(b.order_date, MONTH) as iso_date,
count(distinct a.account_id) as tpro_active,
count(distinct b.order_id) as tpro_orders,

-- Food TGO 
count(distinct case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then b.order_id END) as food_tgo_orders,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then b.basket_amount_lc END) as food_tgo_basket,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then b.gmv_amount_lc END) as food_tgo_gmv,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then bd.calculatedtprocommission / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.calculatedtprocommission END) END) as food_tgo_delivery_fee,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then b.service_fee_amount_lc END) as food_tgo_service_fee,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then (case when b.order_date >>= tax.vat_start_date
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as food_tgo_service_fee_without_vat,
sum(case when v.vertical_class = 'food' and b.is_tgo and d.is_dh_kitchen is false then 
case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END + coalesce(tgo_amount_lc, 0) END) as food_tgo_commission_revenue,

-- Food TMP
count(distinct case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then b.order_id END) as food_tmp_orders,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then b.basket_amount_lc END) as food_tmp_basket,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then b.gmv_amount_lc END) as food_tmp_gmv,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then platformdeliveryfund*-1 / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.platformdeliveryfund*-1 END) END) as food_tmp_delivery_fee,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then b.service_fee_amount_lc END) as food_tmp_service_fee,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then (case when b.order_date >>= tax.vat_start_date
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as food_tmp_service_fee_without_vat,
sum(case when v.vertical_class = 'food' and b.is_tgo is false and d.is_dh_kitchen is false then bn.commission_amount_lc + coalesce(tgo_amount_lc, 0) END) as food_tmp_commission_revenue,

-- tMart
count(distinct case when d.is_grocery_darkstore then b.order_id END) as tmart_orders,
sum(case when d.is_grocery_darkstore then b.basket_amount_lc END) as tmart_basket,
sum(case when d.is_grocery_darkstore then b.gmv_amount_lc END) as tmart_gmv,
sum(case when d.is_grocery_darkstore then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then dps.dps_delivery_fee_local*-1 / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE dps.dps_delivery_fee_local*-1 END) END) as tmart_delivery_fee,
sum(case when d.is_grocery_darkstore then b.service_fee_amount_lc END) as tmart_service_fee,
sum(case when d.is_grocery_darkstore then 
(case when b.order_date >>= tax.vat_start_date 
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as tmart_service_fee_without_vat,
sum(case when d.is_grocery_darkstore then bn.commission_amount_lc + coalesce(tgo_amount_lc, 0) END) as tmart_commission_revenue,

-- NFV TGO
count(distinct case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then b.order_id END) as nfv_tgo_orders,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then b.basket_amount_lc END) as nfv_tgo_basket,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then b.gmv_amount_lc END) as nfv_tgo_gmv,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then bd.calculatedtprocommission / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.calculatedtprocommission END) END) as nfv_tgo_delivery_fee,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then b.service_fee_amount_lc END) as nfv_tgo_service_fee,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then 
(case when b.order_date >>= tax.vat_start_date 
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as nfv_tgo_service_fee_without_vat,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo and d.is_dh_kitchen is false then 
case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END + coalesce(tgo_amount_lc, 0) END) as nfv_tgo_commission_revenue,

-- NFV TMP
count(distinct case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then b.order_id END) as nfv_tmp_orders,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then b.basket_amount_lc END) as nfv_tmp_basket,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then b.gmv_amount_lc END) as nfv_tmp_gmv,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then (case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then bd.platformdeliveryfund*-1 / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.platformdeliveryfund*-1 END) END) as nfv_tmp_delivery_fee,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then b.service_fee_amount_lc END) as nfv_tmp_service_fee,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then (case when b.order_date >>= tax.vat_start_date
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as nfv_tmp_service_fee_without_vat,
sum(case when v.vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and b.is_tgo is false and d.is_dh_kitchen is false then bn.commission_amount_lc + coalesce(tgo_amount_lc, 0) END) as nfv_tmp_commission_revenue,

-- DHK TGO 
count(distinct case when d.is_dh_kitchen and b.is_tgo then b.order_id END) as dhk_tgo_orders,
sum(case when d.is_dh_kitchen and b.is_tgo then b.basket_amount_lc END) as dhk_tgo_basket,
sum(case when d.is_dh_kitchen and b.is_tgo then b.gmv_amount_lc END) as dhk_tgo_gmv,
sum(case when d.is_dh_kitchen and b.is_tgo then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then bd.calculatedtprocommission / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.calculatedtprocommission END) END) as dhk_tgo_delivery_fee,
sum(case when d.is_dh_kitchen and b.is_tgo then b.service_fee_amount_lc END) as dhk_tgo_service_fee,
sum(case when d.is_dh_kitchen and b.is_tgo then (case when b.order_date >>= tax.vat_start_date
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as dhk_tgo_service_fee_without_vat,
sum(case when d.is_dh_kitchen and b.is_tgo then 
case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END + coalesce(tgo_amount_lc, 0) END) as dhk_tgo_commission_revenue,

-- DHK TMP
count(distinct case when d.is_dh_kitchen and b.is_tgo is false then b.order_id END) as dhk_tmp_orders,
sum(case when d.is_dh_kitchen and b.is_tgo is false then b.basket_amount_lc END) as dhk_tmp_basket,
sum(case when d.is_dh_kitchen and b.is_tgo is false then b.gmv_amount_lc END) as dhk_tmp_gmv,
sum(case when d.is_dh_kitchen and b.is_tgo is false then 
(case when b.order_date >>= tax.vat_start_date and tax.is_vat_delivery_charges is TRUE 
then platformdeliveryfund*-1 / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE bd.platformdeliveryfund*-1 END) END) as dhk_tmp_delivery_fee,
sum(case when d.is_dh_kitchen and b.is_tgo is false then b.service_fee_amount_lc END) as dhk_tmp_service_fee,
sum(case when d.is_dh_kitchen and b.is_tgo is false then (case when b.order_date >>= tax.vat_start_date
then b.service_fee_amount_lc / ((100 + COALESCE(tax.vat_percentage, 0)) / 100) ELSE b.service_fee_amount_lc END) END) as dhk_tmp_service_fee_without_vat,
sum(case when d.is_dh_kitchen and b.is_tgo is false then bn.commission_amount_lc + coalesce(tgo_amount_lc, 0) END) as dhk_tmp_commission_revenue

from 
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.fct_order_info` as b 
on a.account_id = b.account_id 
and a.iso_date = DATE(b.order_date) 
and (b.order_time between a.start_date and a.end_date) 
and a.country = b.country_iso and b.is_successful
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln
on a.plan_id = pln.plan_id and pln.plan_price_lc <<>> 0
inner join `tlb-data-prod.data_platform.dim_vertical` v on b.vertical_id = v.vertical_id
inner join `tlb-data-prod.data_platform.dim_vendor_info` as d on b.vendor_id = d.vendor_id 
inner join `tlb-data-prod.data_platform.fct_billing` as bn on b.order_id = bn.order_id  
inner join `tlb-data-prod.data_platform_billing.billingdata` as bd on b.order_id = bd.orderid and b.transaction_id = bd.transactionid
left join `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps on cast(dps.platform_order_code as int) = b.order_id
  and dps.entity_id in ('TB_AE', 'TB_KW', 'TB_QA', 'TB_BH', 'TB_JO', 'TB_OM')
  and dps.created_date >>='2023-01-01'

left join `tlb-data-prod.data_platform.dim_country_info` tax on UPPER(b.country_code) = UPPER(tax.country_code)

where date_trunc(b.order_date, MONTH) between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH) and b.country_iso in ('AE','KW','QA','BH','JO','OM') and b.is_tpro_order
group by 1,2),

rev_refunds_split as (
  select
    a.country,
    month_start_date,
    sum(case when c.plan_duration_days = 31 then 
             case when month_start_date >>= tax.vat_start_date then paid_monthly /((100 + COALESCE(tax.vat_percentage, 0))/ 100) else paid_monthly END END) as membership_revenues_lc_1m,
    sum(case when c.plan_duration_days <<>> 31 then
             case when month_start_date >>= tax.vat_start_date then paid_monthly /((100 + COALESCE(tax.vat_percentage, 0))/ 100) else paid_monthly END END) as membership_revenues_lc_ltp,
    sum(case when c.plan_duration_days = 31 then 
             case when month_start_date >>= tax.vat_start_date then refunds /((100 + COALESCE(tax.vat_percentage, 0))/ 100) else refunds END END) as refund_lc_1m,
    sum(case when c.plan_duration_days <<>> 31 then
             case when month_start_date >>= tax.vat_start_date then refunds /((100 + COALESCE(tax.vat_percentage, 0))/ 100) else refunds END END) as refund_lc_ltp
  from
    `tlb-data-prod.data_platform_rest_tables.tpro_amortized_revenue_monthly` as a
    left join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
    on a.plan_id = c.plan_id and a.country = c.country
    left outer join `tlb-data-prod.data_platform.dim_country_info` as tax ON lower(a.country) = lower(tax.country_code)
  where
    month_start_date between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
  group by
    1,
    2
),

rev_refunds as  
(select 
country,
month_start_date, 
ROUND(membership_revenues_lc_1m/(membership_revenues_lc_1m + membership_revenues_lc_ltp),4) as mem_rev_1m_share,
ROUND(membership_revenues_lc_ltp/(membership_revenues_lc_1m + membership_revenues_lc_ltp),4) as mem_rev_ltp_share,
ROUND(SAFE_DIVIDE(refund_lc_1m,(refund_lc_1m + refund_lc_ltp)),4) as refund_1m_share,
ROUND(SAFE_DIVIDE(refund_lc_ltp,(refund_lc_1m + refund_lc_ltp)),4) as refund_ltp_share
from rev_refunds_split 
order by 1,2),

pro_kpis_current_month as 
(select 
a.country, 
DATE_TRUNC(iso_date, MONTH) as iso_date,
sum(case when b.is_tgo = TRUE then fn.tgo_amount_lc END) as logistics_fee,
sum(case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END) as original_commission,
sum(b.service_fee_amount_lc) as service_fee
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
left join `tlb-data-prod.data_platform.fct_order_info` as b 
on a.account_id = b.account_id 
and a.iso_date = DATE(b.order_date) 
and (b.order_time between a.start_date and a.end_date) 
and a.country = b.country_iso and b.is_successful
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln on a.plan_id = pln.plan_id 
and pln.plan_price_lc <<>> 0
left join `tlb-data-prod.data_platform.dim_vendor_info` as d on b.vendor_id = d.vendor_id
left join `tlb-data-prod.data_platform.dim_vertical` v on b.vertical_id = v.vertical_id
left join `tlb-data-prod.data_platform_billing.billingdata` as bd on b.order_id = bd.orderid
and b.transaction_id = bd.transactionid
left join `tlb-data-prod.data_platform.fct_billing` as fn on b.order_id = fn.order_id
where b.is_tpro_order and date_trunc(b.order_date, MONTH) = DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
group by
  1,
  2
),

economics_dash as 
(select 
country_code, 
month_start_date,
sum(case when plan_type = '1M' then membership_revenues_lc END) as membership_revenues_lc_1m,
sum(case when plan_type = 'LTP' then membership_revenues_lc END) as membership_revenues_lc_ltp,
sum(case when plan_type = '1M' then refund_lc END) as refund_lc_1m,
sum(case when plan_type = 'LTP' then refund_lc END) as refund_lc_ltp,
sum(tmart_df_funding) as tmart_df_funding,
sum(commission_capping_savings) as commission_capping_savings,
sum(dd_tgo_orders) as dd_tgo_orders,
sum(double_discounted_cost) as double_discounted_cost,
sum(low_basket_orders) as low_basket_orders,
sum(low_basket_orders_cost) as low_basket_orders_cost,
sum(fully_funded + partial_funded) as special_brands_funding,
sum(actual_tgo_df_fee + actual_tmp_df_fee + tmart_df_funding) as wavied_df,
sum(expected_df) as expected_df,
sum(df_commission) as df_commission 
from `tlb-data-dev.data_playground.tpro_economics_dashboard_latest`
where month_start_date between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
and tpro_subs_type = 'Regular'
group by 1,2),

tpro_financials as 
(select
country_code, 
order_month, 
sum(successful_orders) as successful_orders,
sum(ncr_total_exclude_gem_lc + gem_fee_income_lc) AS ncr,
sum(commission_lc) as commission_revenue,
sum(service_fee_income_amount_lc) as service_fee_revenue,
sum(card_fee_lc + loyalty_revenue_reduction_lc + revenue_reduction_others_lc) as revenue_reduction_others,


-- Revenue Elements
sum(commission_lc + delivery_service_revenue_lc + coalesce(tpro_subscription_revenue_lc,0) + card_fee_lc + loyalty_revenue_reduction_lc + revenue_reduction_others_lc + ncr_total_exclude_gem_lc + gem_fee_income_lc + service_fee_income_amount_lc) as total_revenue,

-- tMart Cross Charge
sum(case when finance_vertical = 'tmart' then delivery_service_revenue_lc END) as tmart_cross_charge,

-- Delivery Cost
sum(fully_loaded_cpo_lc + shoppers_cost_lc + kitchen_related_cost_lc + darkstore_related_cost_lc) as total_cost,

-- Cost of Sales
sum(server_transmission_lc + contact_center_lc + payment_cost_lc + bad_debt_lc + other_costs_lc) as cost_of_sales,

-- Others Costs
sum(tmart_delivery_fee_funding_lc + commission_capping_savings_lc) as other_costs,

-- Free Delivery Incentive Amount 
sum(free_delivery_incentive_amount_lc) as free_delivery_incentive_amount_lc

from `data_playground.agg_tpro_gpo_monthly`
where order_month between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
and plan_type = 'Regular'

group by 1,2
order by 1,2),

platform_financials as 
(select
country_code, 
order_month, 
sum(successful_order_count) as successful_orders,
sum(successful_tgo_order_count) as successful_tgo_order_count,
sum(card_fee_lc) as card_fees,
sum(server_transmission_lc + contact_center_lc + payment_cost_lc + bad_debt_lc + other_costs_lc) as cost_of_sales,
sum(ncr_total_exclude_gem_lc + gem_fee_income_lc) AS ncr,

-- Revenue Elements
sum(commission_revenue_lc + delivery_service_revenue_lc + service_fee_income_amount_lc + tpro_subscription_revenue_lc + card_fee_lc + loyalty_revenue_reduction_lc + revenue_reduction_others_lc + ncr_total_exclude_gem_lc + gem_fee_income_lc) as total_revenue,

-- Delivery Cost
sum(fully_loaded_cpo_lc + shoppers_cost_lc + kitchen_related_cost_lc + darkstore_related_cost_lc) as total_cost,

-- Others Costs
sum(server_transmission_lc + contact_center_lc + payment_cost_lc + bad_debt_lc + other_costs_lc) as other_costs

from `tlb-data-prod.data_platform.agg_platform_gpo_monthly`
where order_month between '2024-03-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)

group by 1,2
order by 1,2),

financials as 
(select 
d.country_code,
d.month_start_date,

-- tPro Financials
b.ncr as tpro_ncr,
coalesce(b.commission_revenue, e.original_commission + e.logistics_fee)  as tpro_commission_revenue,
coalesce(b.tmart_cross_charge,0) as tpro_tmart_cross_charges,
coalesce(b.service_fee_revenue, e.service_fee) as tpro_service_fee_revenue,
b.revenue_reduction_others as tpro_revenue_reduction_others,
b.successful_orders as tpro_successful_orders,
b.total_revenue + b.total_cost + b.cost_of_sales + b.other_costs as tpro_gross_profit,
b.cost_of_sales as tpro_cost_of_sales,
b.total_cost as tpro_total_cost,
b.free_delivery_incentive_amount_lc as tpro_free_delivery_incentive,


-- Platform Financials
c.successful_orders as platform_successful_orders,
c.successful_tgo_order_count as platform_successful_tgo_orders,
c.card_fees as platform_card_fees,
c.cost_of_sales as platform_cost_of_sales,
c.ncr as platform_ncr,
c.total_cost as platform_delivery_cost,
c.total_revenue + c.total_cost + c.other_costs as platform_gross_profit,

-- Economics Dashboard
d.membership_revenues_lc_1m,
d.membership_revenues_lc_ltp,
d.refund_lc_1m*-1 as refund_lc_1m,
d.refund_lc_ltp*-1 as refund_lc_ltp,
d.tmart_df_funding*-1 as tmart_df_funding,
d.commission_capping_savings*-1 as commission_capping_savings,
d.double_discounted_cost*-1 as double_discounted_cost,
d.dd_tgo_orders,
d.low_basket_orders,
d.low_basket_orders_cost*-1 as low_basket_orders_cost,
special_brands_funding*-1 as special_brands_funding,
wavied_df,
d.expected_df,
d.df_commission

from economics_dash as d 
left join tpro_financials as b
on d.country_code = b.country_code and d.month_start_date = b.order_month
left join platform_financials as c 
on d.country_code = c.country_code and d.month_start_date = c.order_month
left join pro_kpis_current_month as e
on d.country_code = e.country and d.month_start_date = e.iso_date)

select 
-- Platform View
a.*,
-- Pro Order View
b.food_tgo_orders,
b.food_tgo_basket,
b.food_tgo_gmv,
b.food_tgo_delivery_fee,
b.food_tgo_service_fee,
b.food_tgo_service_fee_without_vat,
b.food_tgo_commission_revenue,
b.food_tmp_orders,
b.food_tmp_basket,
b.food_tmp_gmv,
b.food_tmp_delivery_fee,
b.food_tmp_service_fee,
b.food_tmp_service_fee_without_vat,
b.food_tmp_commission_revenue,
b.tmart_orders,
b.tmart_basket,
b.tmart_gmv,
b.tmart_delivery_fee,
b.tmart_service_fee,
b.tmart_service_fee_without_vat,
b.tmart_commission_revenue,
b.nfv_tgo_orders,
b.nfv_tgo_basket,
b.nfv_tgo_gmv,
b.nfv_tgo_delivery_fee,
b.nfv_tgo_service_fee,
b.nfv_tgo_service_fee_without_vat,
b.nfv_tgo_commission_revenue,
b.nfv_tmp_orders,
b.nfv_tmp_basket,
b.nfv_tmp_gmv,
b.nfv_tmp_delivery_fee,
b.nfv_tmp_service_fee,
b.nfv_tmp_service_fee_without_vat,
b.nfv_tmp_commission_revenue,
b.dhk_tgo_orders,
b.dhk_tgo_basket,
b.dhk_tgo_gmv,
b.dhk_tgo_delivery_fee,
b.dhk_tgo_service_fee,
b.dhk_tgo_service_fee_without_vat,
b.dhk_tgo_commission_revenue,
b.dhk_tmp_orders,
b.dhk_tmp_basket,
b.dhk_tmp_gmv,
b.dhk_tmp_delivery_fee,
b.dhk_tmp_service_fee,
b.dhk_tmp_service_fee_without_vat,
b.dhk_tmp_commission_revenue,
-- tPro Customer View
c.active_users_1m_previous_month,
c.active_users_ltp_previous_month,
c.acqns_reg,
c.acqns_reg_moved_to_lite,
c.acqns_reg_moved_to_bt,
c.acqns_reg_churned,
c.acqns_lite_moved_to_reg,
c.winbacks_reg, 
c.winbacks_reg_moved_to_lite,
c.winbacks_reg_moved_to_bt,
c.winbacks_reg_churned,
c.winbacks_lite, 
c.winbacks_lite_moved_to_reg,
c.winbacks_lite_moved_to_bt,
c.winbacks_lite_churned,
c.bt,
c.bt_moved_to_lite,
c.bt_moved_to_bt,
c.bt_churned,
c.active_lm,
c.active_lm_active,
c.active_lm_moved_to_lite,
c.active_lm_moved_to_bt,
c.active_lm_churned,
c.active_users_1m_current_month,
c.active_users_ltp_current_month,
-- tPro Order View
b.food_tgo_orders as food_tgo_tpro_orders,
b.food_tmp_orders as food_tmp_tpro_orders,
b.tmart_orders as tmart_tpro_orders,
b.nfv_tgo_orders as nfv_tgo_tpro_orders,
b.nfv_tmp_orders as nfv_tmp_tpro_orders,
d.non_pro_orders,
e.dd_tgo_orders as double_discounted_orders,
e.low_basket_orders as co_funded_orders,
d.capped_orders,
d.commission_savings,
d.pro_customer_gmv_overall,
-- Financial KPIs
e.membership_revenues_lc_1m,
e.membership_revenues_lc_ltp,
e.refund_lc_1m,
e.refund_lc_ltp,
e.tpro_ncr,
e.tpro_commission_revenue,
e.tpro_tmart_cross_charges,
e.tpro_service_fee_revenue,
e.tpro_revenue_reduction_others,
e.tpro_successful_orders,
e.tpro_gross_profit,
e.tpro_total_cost,
e.tpro_cost_of_sales,
e.platform_successful_orders,
e.platform_successful_tgo_orders,
e.platform_card_fees,
e.platform_cost_of_sales,
e.platform_ncr,
e.platform_delivery_cost,
e.platform_gross_profit,
e.tmart_df_funding,
e.commission_capping_savings,
e.double_discounted_cost,
e.low_basket_orders_cost,
e.special_brands_funding,
e.wavied_df,
e.expected_df,
e.df_commission,
e.tpro_free_delivery_incentive
from talabat_active as a 
left join tpro_order_view as b
on a.country_iso = b.country_iso and a.iso_date = b.iso_date
left join customer_view as c 
on a.country_iso = c.country and a.iso_date = c.iso_month
left join order_view as d 
on a.country_iso = d.country and a.iso_date = d.date
left join financials as e
on a.country_iso = e.country_code and a.iso_date = e.month_start_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Pro Customer Orders' inline='true' name='federated.0sncz5x0lkcyh31codeqh1ivyw5w' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13crz3608ewtcs16zgpth14jrlu1'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tdine-export' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='aravind.jayachandran@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13crz3608ewtcs16zgpth14jrlu1' name='Custom SQL Query' type='text'><![CDATA[select 
a.country, 
date_trunc(b.order_date, MONTH) as iso_date, 
b.is_tpro_order,

-- All Orders
count(distinct order_id) as orders,
sum(gmv_amount_lc) as gmv,
sum(basket_amount_lc) as gfv,
sum(gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0)) as gfv_net_discounts,

-- Food TGO Orders
count(distinct case when b.is_tgo and vertical_class = 'food' and d.is_dh_kitchen is false then order_id END) as food_tgo_orders,
sum(case when b.is_tgo and vertical_class = 'food' and d.is_dh_kitchen is false then gmv_amount_lc END) as food_tgo_gmv,
sum(case when b.is_tgo and vertical_class = 'food' and d.is_dh_kitchen is false then basket_amount_lc END) as food_tgo_gfv,
sum(case when b.is_tgo and vertical_class = 'food' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as food_tgo_gfv_net_discounts,

-- Food TMP Orders
count(distinct case when b.is_tgo = FALSE and vertical_class = 'food' and d.is_dh_kitchen is false then order_id END) as food_tmp_orders,
sum(case when b.is_tgo = FALSE and vertical_class = 'food' and d.is_dh_kitchen is false then gmv_amount_lc END) as food_tmp_gmv,
sum(case when b.is_tgo = FALSE and vertical_class = 'food' and d.is_dh_kitchen is false then basket_amount_lc END) as food_tmp_gfv,
sum(case when b.is_tgo = FALSE and vertical_class = 'food' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as food_tmp_gfv_net_discounts,

-- tMart Orders
count(distinct case when v.vertical_class = 'non-food' and sub_vertical = 'darkstore' then order_id END) as tmart_orders,
sum(case when v.vertical_class = 'non-food' and sub_vertical = 'darkstore' then gmv_amount_lc END) as tmart_gmv,
sum(case when v.vertical_class = 'non-food' and sub_vertical = 'darkstore' then basket_amount_lc END) as tmart_gfv,
sum(case when v.vertical_class = 'non-food' and sub_vertical = 'darkstore' then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as tmart_gfv_net_discounts,

-- NFV TGO Orders
count(distinct case when b.is_tgo and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then order_id END) as nfv_tgo_orders,
sum(case when b.is_tgo and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc END) as nfv_tgo_gmv,
sum(case when b.is_tgo and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then basket_amount_lc END) as nfv_tgo_gfv,
sum(case when b.is_tgo and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as nfv_tgo_gfv_net_discounts,

-- NFV TMP Orders
count(distinct case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then order_id END) as nfv_tmp_orders,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc END) as nfv_tmp_gmv,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then basket_amount_lc END) as nfv_tmp_gfv,
sum(case when b.is_tgo = FALSE and vertical_class = 'non-food' and sub_vertical <<>> 'darkstore' and d.is_dh_kitchen is false then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as nfv_tmp_gfv_net_discounts,

-- DHK TGO Orders
count(distinct case when b.is_tgo and d.is_dh_kitchen then order_id END) as dhk_tgo_orders,
sum(case when b.is_tgo and d.is_dh_kitchen then gmv_amount_lc END) as dhk_tgo_gmv,
sum(case when b.is_tgo and d.is_dh_kitchen then basket_amount_lc END) as dhk_tgo_gfv,
sum(case when b.is_tgo and d.is_dh_kitchen then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as dhk_tgo_gfv_net_discounts,

-- DHK TMP Orders
count(distinct case when b.is_tgo = FALSE and d.is_dh_kitchen then order_id END) as dhk_tmp_orders,
sum(case when b.is_tgo = FALSE and d.is_dh_kitchen then gmv_amount_lc END) as dhk_tmp_gmv,
sum(case when b.is_tgo = FALSE and d.is_dh_kitchen then basket_amount_lc END) as dhk_tmp_gfv,
sum(case when b.is_tgo = FALSE and d.is_dh_kitchen then gmv_amount_lc - delivery_fee_amount_lc - coalesce(service_fee_amount_lc,0) END) as dhk_tmp_gfv_net_discounts

from 
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on a.plan_id = pln.plan_id and pln.plan_price_lc <<>> 0
left join `tlb-data-prod.data_platform.fct_order_info` as b on a.account_id = b.account_id 
and a.iso_date = DATE(b.order_date) 
and (b.order_time between a.start_date and a.end_date) 
and a.country = b.country_iso 
and b.is_successful 
inner join `tlb-data-prod.data_platform.dim_vendor_info` as d on b.vendor_id = d.vendor_id
inner join `tlb-data-prod.data_platform.dim_vertical` v on b.vertical_id = v.vertical_id 
where date_trunc(b.order_date, MONTH) between '2023-01-01' and DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -1 MONTH)
and a.subscription_state <<>> 'BILLING RETRY'
group by 1,2,3
order by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.13crz3608ewtcs16zgpth14jrlu1' name='Custom SQL Query' type='text'><![CDATA[select 
