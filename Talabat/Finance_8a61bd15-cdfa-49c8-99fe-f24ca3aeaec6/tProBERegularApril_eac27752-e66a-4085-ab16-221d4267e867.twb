      </column>
      <column caption='Double discounted order share' datatype='real' name='[Calculation_1448188805499109390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[double_discounted_orders]/([Calculation_2115565974933639177]+[Food - Pro Orders (copy)_2115565974933819402])' />
