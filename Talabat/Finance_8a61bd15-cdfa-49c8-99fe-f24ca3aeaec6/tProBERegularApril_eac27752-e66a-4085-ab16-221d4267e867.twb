        <calculation class='tableau' formula='[Extension (copy)_1760344556473487363] + [Calculation_880735204654071808]' />
      </column>
      <column caption='Net Subscription Revenue' datatype='real' name='[Calculation_1760344556473794565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_913386353953787918] + [Membership Revenues 1m (copy)_913386353953849359] + [Calculation_1760344556473274370] + [Calculation_913386353953329165]' />
      </column>
