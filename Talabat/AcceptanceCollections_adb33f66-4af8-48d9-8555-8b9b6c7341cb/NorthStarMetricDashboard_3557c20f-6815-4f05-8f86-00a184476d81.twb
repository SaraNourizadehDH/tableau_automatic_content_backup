        <objects>
          <object caption='Custom SQL Query' id='_329972CDF61D4515AC01E954CF07D554'>
            <properties context=''>
              <relation connection='bigquery.1tedqhw0gkiw241fkiuuh05i2j5r' name='Custom SQL Query' type='text'>SELECT
date,
country,
metric,
maturity_date,
is_maturity,
numerator,
denominator,
numerator_1,
denominator_1,
FROM `tlb-data-dev.data_playground_finance.fintech_northstar_metrics`

UNION ALL

SELECT
date,
country,
&apos;Collection Rate&apos; AS metric,
MIN(maturity_date) maturity_date,
MIN(is_maturity) is_maturity,
SUM(numerator) numerator,
SUM(denominator) denominator,
SUM(numerator_1) numerator_1,
SUM(denominator_1) denominator_1,
FROM `tlb-data-dev.data_playground_finance.fintech_northstar_metrics`
WHERE metric IN (&apos;Collection Rate tPro Subs.&apos;, &apos;Collection Rate PostPaid&apos;)
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
