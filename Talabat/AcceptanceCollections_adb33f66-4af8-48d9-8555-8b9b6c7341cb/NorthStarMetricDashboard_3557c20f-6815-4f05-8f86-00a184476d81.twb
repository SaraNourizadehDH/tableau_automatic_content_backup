    <worksheet name='Metric Test'>
      <table>
        <view>
          <datasources>
            <datasource caption='northstar metrics query' name='federated.1r8ku2s1eyxhwp1bnovww0twmje2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregated By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Transaction Count&quot;'>
              <calculation class='tableau' formula='&quot;Transaction Count&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r8ku2s1eyxhwp1bnovww0twmje2'>
            <column caption='Value' datatype='real' name='[Calculation_346073518083051521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; THEN [Calculation_733453452601413632]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Amount&apos; THEN [Value % (copy)_346073518082932736] &#10;END' />
            </column>
            <column caption='Acceptance Latest # Filter' datatype='string' name='[Calculation_346073518103969799]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()-1) AND&#10;   DATEPART(&apos;month&apos;, [date]) = DATEPART(&apos;month&apos;, TODAY()-1) AND&#10;   DAY([date]) &lt;= DAY(TODAY()-1) THEN &quot;True&quot;&#10;ELSEIF DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()-1)) AND&#10;       DATEPART(&apos;month&apos;, [date]) = DATEPART(&apos;month&apos;, TODAY()-1) AND&#10;       DAY([date]) &lt;= DAY(TODAY()-1) THEN &quot;True&quot;&#10;ELSE &quot;False&quot;&#10;END&#10;/*filters the days considered in current months MTD calc*/' />
            </column>
            <column caption='Latest # Flag' datatype='string' name='[Calculation_346073518112276489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [metric] = &apos;Acceptance Rate&apos;  THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Success Rate&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Recovery Rate&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Single Attempt Success Rate&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Multiple Attempt Success Rate&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Collection Rate&apos; THEN [Include non Matured Month (copy)_346073518121504778]&#10;ELSEIF [metric] = &apos;Collection Rate PostPaid&apos; THEN [Include non Matured Month (copy)_346073518121504778]&#10;ELSEIF [metric] = &apos;Collection Rate tPro Subs.&apos; THEN [Include non Matured Month (copy)_346073518121504778]&#10;ELSEIF [metric] = &apos;Online Payment Share&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Apple Pay Payment Share&apos; THEN [Calculation_346073518103969799]&#10;ELSEIF [metric] = &apos;Saved Card Payment Share&apos; THEN [Calculation_346073518103969799]&#10;END&#10;/*Collections are based on the latest mature month &amp; Acceptance is based on MTD YoY(eg.Jul&apos;24-Jul&apos;25)*/' />
            </column>
            <column caption='Latest Metric Date' datatype='date' name='[Calculation_346073518126161932]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [metric]: max(if [Calculation_346073518112276489] = &quot;True&quot; then [date] end)}' />
            </column>
            <column caption='Latest Metric Month Flag' datatype='boolean' name='[Calculation_346073518126747661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Calculation_346073518126161932]) = MONTH(date)' />
            </column>
            <column caption='Value %' datatype='real' default-format='p0.0%' name='[Calculation_733453452601413632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([numerator])/sum([denominator])' />
            </column>
            <column caption='Numerator (param)' datatype='real' name='[Denominator (param) (copy)_1328210085078986758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; THEN [numerator]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Amount&apos; THEN [numerator_1]&#10;END' />
            </column>
            <column caption='Collections Latest # Filter' datatype='string' name='[Include non Matured Month (copy)_346073518121504778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [date]) &gt;= DATETRUNC(&apos;month&apos;, {fixed [metric]: max(if [is_maturity] then [date] end)})&#10;then &apos;False&apos;&#10;else &apos;True&apos;&#10;END' />
            </column>
            <column caption='Value %_1' datatype='real' default-format='p0.0%' name='[Value % (copy)_346073518082932736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([numerator_1])/sum([denominator_1])' />
            </column>
            <column caption='Denominator (param)' datatype='real' name='[Value (copy)_1328210085078781957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; THEN [denominator]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Amount&apos; THEN [denominator_1]&#10;END' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[denominator]' role='measure' type='quantitative' />
            <column datatype='real' name='[denominator_1]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_maturity]' role='dimension' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Month' name='[mn:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_346073518112276489]' derivation='None' name='[none:Calculation_346073518112276489:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_346073518126747661]' derivation='None' name='[none:Calculation_346073518126747661:nk]' pivot='key' type='nominal' />
            <column-instance column='[metric]' derivation='None' name='[none:metric:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[numerator]' role='measure' type='quantitative' />
            <column datatype='real' name='[numerator_1]' role='measure' type='quantitative' />
            <column-instance column='[Denominator (param) (copy)_1328210085078986758]' derivation='Sum' name='[sum:Denominator (param) (copy)_1328210085078986758:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Value (copy)_1328210085078781957]' derivation='Sum' name='[sum:Value (copy)_1328210085078781957:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_346073518083051521]' derivation='User' name='[usr:Calculation_346073518083051521:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1r8ku2s1eyxhwp1bnovww0twmje2].[none:Calculation_346073518112276489:nk]'>
            <groupfilter function='member' level='[none:Calculation_346073518112276489:nk]' member='&quot;True&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1r8ku2s1eyxhwp1bnovww0twmje2].[none:Calculation_346073518126747661:nk]'>
            <groupfilter function='member' level='[none:Calculation_346073518126747661:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.1r8ku2s1eyxhwp1bnovww0twmje2].[none:metric:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Acceptance Rate&quot;</bucket>
              <bucket>&quot;Success Rate (DH)&quot;</bucket>
              <bucket>&quot;Success Rate&quot;</bucket>
              <bucket>&quot;Recovery Rate (DH)&quot;</bucket>
              <bucket>&quot;Success Rate (tlb)&quot;</bucket>
              <bucket>&quot;First Attempt Success Rate&quot;</bucket>
              <bucket>&quot;Recovery Rate (tlb)&quot;</bucket>
              <bucket>&quot;tPro Subscriptions Collection Rate&quot;</bucket>
              <bucket>&quot;PostPaid Collection Rate&quot;</bucket>
              <bucket>&quot;Outstanding Balance Collection Rate&quot;</bucket>
              <bucket>&quot;Recovery Rate&quot;</bucket>
              <bucket>&quot;Single Attempt Success Rate&quot;</bucket>
              <bucket>&quot;Multiple Attempt Success Rate&quot;</bucket>
              <bucket>&quot;Collection Rate&quot;</bucket>
              <bucket>&quot;Collection Rate PostPaid&quot;</bucket>
              <bucket>&quot;Collection Rate tPro Subs.&quot;</bucket>
              <bucket>&quot;Online Payment Share&quot;</bucket>
              <bucket>&quot;Apple Pay Payment Share&quot;</bucket>
              <bucket>&quot;Saved Card Payment Share&quot;</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1r8ku2s1eyxhwp1bnovww0twmje2].[none:Calculation_346073518126747661:nk]</column>
            <column>[federated.1r8ku2s1eyxhwp1bnovww0twmje2].[none:Calculation_346073518112276489:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
