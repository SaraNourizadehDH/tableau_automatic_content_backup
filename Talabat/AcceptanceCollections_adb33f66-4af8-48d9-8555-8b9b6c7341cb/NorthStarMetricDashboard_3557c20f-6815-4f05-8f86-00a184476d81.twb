            <column caption='Numerator Name (tooltip)' datatype='string' name='[deno (copy) (copy)_346073518336118810]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Acceptance Rate&apos;  THEN &apos;Accepted Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Success Rate&apos; THEN &apos;Successful Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Recovery Rate&apos; THEN &apos;Recovered Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Single Attempt Success Rate&apos; THEN &apos;Successful Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Multiple Attempt Success Rate&apos; THEN &apos;Recovered Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Collection Rate&apos; THEN &apos;Total Collected&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Collection Rate PostPaid&apos; THEN &apos;Total Collected&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Collection Rate tPro Subs.&apos; THEN &apos;Total Collected&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Online Payment Share&apos; THEN &apos;Online Payment Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Apple Pay Payment Share&apos; THEN &apos;Apple Pay Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Count&apos; AND [metric] = &apos;Saved Card Payment Share&apos; THEN &apos;Saved Card Orders&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Amount&apos; AND [metric] = &apos;Acceptance Rate&apos;  THEN &apos;Accepted Amount&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Transaction Amount&apos; AND [metric] = &apos;Success Rate&apos; THEN &apos;S