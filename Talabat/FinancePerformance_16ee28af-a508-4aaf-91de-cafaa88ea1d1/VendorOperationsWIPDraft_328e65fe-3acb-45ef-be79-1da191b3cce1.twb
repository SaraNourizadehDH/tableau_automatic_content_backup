      <column caption='Gap' datatype='integer' hidden='true' name='[Calculation_2226889337749893120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_slot_duration_seconds]-([total_available_duration_seconds]+[total_unavailable_duration_seconds])' />
      </column>
      <column caption='Available %' datatype='real' default-format='p0%' name='[Calculation_2226889337750138881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_unavailable_duration_seconds])/SUM([total_slot_duration_seconds])' />
      </column>
      <column caption='Total Unavailable Duration' datatype='real' name='[Calculation_2226889337798533124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [total_available_duration_seconds]/3600&#10;when &apos;min&apos; then [total_available_duration_seconds]/60&#10;when &apos;sec&apos; then [total_available_duration_seconds]&#10;else [total_available_duration_seconds] end' />
      </column>
