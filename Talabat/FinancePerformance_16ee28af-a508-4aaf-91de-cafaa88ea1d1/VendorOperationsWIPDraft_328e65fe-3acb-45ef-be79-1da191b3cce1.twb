      </column>
      <column caption='Offline Duration-VP' datatype='real' name='[Offline Duration-Availability (copy)_2226889337801150475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [offline_duration_seconds_vendor_portal]/3600&#10;when &apos;min&apos; then [offline_duration_seconds_vendor_portal]/60&#10;when &apos;sec&apos; then [offline_duration_seconds_vendor_portal]&#10;else [offline_duration_seconds_vendor_portal] end' />
      </column>
