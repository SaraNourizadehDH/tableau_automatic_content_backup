      <table>
        <view>
          <datasources>
            <datasource caption='overall' name='federated.0vjs3pa0zji4cj1exkofl1kqh1w9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Hour' caption='Time Toggle' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;hr&quot;'>
              <calculation class='tableau' formula='&quot;hr&quot;' />
              <aliases>
                <alias key='&quot;hr&quot;' value='Hour' />
                <alias key='&quot;min&quot;' value='Minutes' />
                <alias key='&quot;sec&quot;' value='Seconds' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vjs3pa0zji4cj1exkofl1kqh1w9'>
            <column caption='Offline Duration-Client' datatype='real' name='[Offline Duration-Availability (copy)_2226889337800744967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [offline_duration_seconds_client]/3600&#10;when &apos;min&apos; then [offline_duration_seconds_client]/60&#10;when &apos;sec&apos; then [offline_duration_seconds_client]&#10;else [offline_duration_seconds_client] end' />
            </column>
            <column caption='Offline Duration-VP' datatype='real' name='[Offline Duration-Availability (copy)_2226889337801150475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [offline_duration_seconds_vendor_portal]/3600&#10;when &apos;min&apos; then [offline_duration_seconds_vendor_portal]/60&#10;when &apos;sec&apos; then [offline_duration_seconds_vendor_portal]&#10;else [offline_duration_seconds_vendor_portal] end' />
            </column>
            <column caption='Offline Duration-Monitor' datatype='real' name='[Offline Duration-Client (copy)_2226889337800839176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [offline_duration_seconds_monitor]/3600&#10;when &apos;min&apos; then [offline_duration_seconds_monitor]/60&#10;when &apos;sec&apos; then [offline_duration_seconds_monitor]&#10;else [offline_duration_seconds_monitor] end' />
            </column>
            <column caption='Offline Duration-Platform' datatype='real' name='[Offline Duration-Client (copy)_2226889337800990729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;hr&apos; then [offline_duration_seconds_platform]/3600&#10;when &apos;min&apos; then [offline_duration_seconds_platform]/60&#10;when &apos;sec&apos; then [offline_duration_seconds_platform]&#10;else [offline_duration_seconds_platform] end' />
