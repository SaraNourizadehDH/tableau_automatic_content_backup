          <datasource-dependencies datasource='federated.0vcdjmn019uvvc1cpneos1qg8pdv'>
            <column caption='% Early' datatype='real' default-format='p0.0%' name='[% Late (copy)_5557793809225936915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_orders])/sum([total_orders])' />
            </column>
            <column caption='% Late' datatype='real' default-format='p0.0%' name='[% Ontime (copy)_5557793809225867282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders])/sum([total_orders])' />
            </column>
            <column datatype='real' name='[AVTC]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPO1]' role='measure' type='quantitative' />
            <column caption='% Manual Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_5557793809218195458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([manual_delivery_count])/sum([delivery_count])' />
            </column>
            <column caption='1st to Last Rider Arrival' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809218711558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(first_to_last_rider_arrival)/sum(total_orders)' />
            </column>
            <column caption='Avg. AVTC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809218797575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(AVTC)/sum(total_orders)' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_5557793809218981896]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [created_date]&lt;= TODAY()-2 then [created_date] end' />
            </column>
            <column caption='Avg. Daily Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5557793809219092489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(total_orders)/countd([Calculation_5557793809218981896])' />
            </column>
            <column caption='Avg. DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809219268618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(DT)/sum(total_orders)' />
            </column>
            <column caption='Order Flow' datatype='string' name='[Calculation_5557793809220747277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;&#10;[country_code]=&apos;eg&apos; and [vertical_type]=&apos;darkstores&apos; and NOT [vendor_code] IN (&quot;619847&quot;) and [Calculation_5557793809218981896]&gt;=DATE(&quot;2023-11-20&quot;) then &quot;Auto-Split&quot;&#10;ELSEIF [country_code]=&apos;eg&apos; and [vertical_type]=&apos;darkstores&apos; and [vendor_code] IN (&quot;619847&quot;) and [Calculation_5557793809218981896]&gt;=DATE(&quot;2023-9-25&quot;) then &quot;Auto-Split&quot;&#10;ELSEIF [country_code]=&apos;ae&apos; and [vertical_type]=&apos;darkstores&apos; and [Calculation_5557793809218981896]&gt;=DATE(&quot;2023-7-1&quot;) then &quot;Auto-Split&quot;&#10;ELSEIF [country_code]=&apos;ae&apos; and [vertical_type]=&apos;groceries&apos; and [Calculation_5557793809218981896] &gt;= DATE(&quot;2023-11-1&quot;) and vendor_code = &apos;697969&apos; then &quot;Auto-Split&quot; &#10;ELSEIF [country_code]=&apos;ae&apos; and [vertical_type]=&apos;groceries&apos; and [Calculation_5557793809218981896]&gt;=DATE(&quot;2023-11-13&quot;) and vendor_code in (&apos;706045&apos;,&apos;704122&apos;,&apos;701716&apos;,&apos;701679&apos;) then &quot;Auto-Split&quot; &#10;ELSEIF [country_code]=&apos;ae&apos; and [vertical_type]=&apos;groceries&apos; and [Calculation_5557793809218981896]&gt;=DATE(&quot;2023-11-21&quot;) and vendor_code in (&apos;697969&apos;,&apos;698001&apos;,&apos;701088&apos;,&apos;701090&apos;,&apos;704120&apos;,&apos;704241&apos;,&apos;704122&apos;,&apos;701089&apos;,&apos;701092&apos;,&apos;706041&apos;,&apos;701679&apos;,&apos;701716&apos;,&apos;706044&apos;,&apos;708495&apos;,&apos;706046&apos;,&apos;713329&apos;,&apos;706043&apos;,&apos;706045&apos;,&apos;707290&apos;,&apos;713935&apos;,&apos;704121&apos;) then &quot;Auto-Split&quot; &#10;&#10;ELSE &quot;Regular&quot;&#10;END' />
            </column>
            <column caption='CPO-1' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809224810510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(CPO1)/sum(total_orders)' />
            </column>
            <column caption='Avg. PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809225486352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(PDT)/sum(total_orders)' />
            </column>
            <column caption='% Ontime' datatype='real' default-format='p0.0%' name='[Calculation_5557793809225543697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ontime_orders])/sum([total_orders])' />
