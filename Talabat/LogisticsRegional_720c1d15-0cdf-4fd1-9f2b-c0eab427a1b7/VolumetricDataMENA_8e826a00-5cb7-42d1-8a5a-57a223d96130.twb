            <column caption='% RCR' datatype='real' default-format='p0.0%' name='[Calculation_5557793809226231829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rcr_count])/SUM([total_orders])' />
            </column>
            <column caption='% Split' datatype='real' default-format='p0.0%' name='[Calculation_5557793809226498070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_split] then [total_orders] END) / SUM([total_orders])' />
