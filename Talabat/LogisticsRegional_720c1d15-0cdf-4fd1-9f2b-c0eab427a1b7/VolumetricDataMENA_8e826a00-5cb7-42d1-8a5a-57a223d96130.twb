      <aliases enabled='yes' />
      <column datatype='real' name='[AVTC]' role='measure' type='quantitative' />
      <column datatype='real' name='[AVT]' role='measure' type='quantitative' />
      <column caption='% Change in Big Orders (Bikes)' datatype='real' default-format='*+0.0%;-0.0%' name='[Big Orders Impact (Cars) (copy)_2913688246561124361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
      </column>
      <column caption='% Change in Big Orders (Cars)' datatype='real' default-format='*+0.0%;-0.0%' name='[Big Orders Impact (copy)_2913688246558949384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
      </column>
      <column caption='CPO Impact (Overall)' datatype='real' default-format='*+0.0%;-0.0%' name='[Big Orders Impact (copy)_983332855647653907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [cpo_eur] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [cpo_eur] end) / sum(IF  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end))&#10;)-1' />
      </column>
      <column caption='% Change in Split Orders' datatype='real' default-format='p0.0%' name='[Big Orders Impact (copy)_983332855648395286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(sum(IF [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_split] then [total_orders] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_split] then [total_orders] end) / sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
      </column>
      <column caption='CPO Impact (Overall WA)' datatype='real' default-format='p0.0%' name='[CPO (copy)_5889582438522368001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Big Orders Impact (copy)_983332855647653907] * MIN({ INCLUDE  [country_code]: [CPO Impact (Overall) (copy)_5889582438523494402] })' />
      </column>
      <column caption='CPO (WA)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPO (copy)_5889582438701072391]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='[Calculation_983332855647567890]*[CPO Impact (Overall) (copy)_5889582438523494402]' />
      </column>
      <column caption='CPO Impact (Split Orders WA)' datatype='real' default-format='p0.0%' name='[CPO Impact (Overall WA) (copy)_5889582438569603075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPO Impact (copy)_2913688246561320970] * MIN({ INCLUDE [country_code]: [CPO Impact (Overall) (copy)_5889582438523494402] })' />
      </column>
      <column caption='% Share' datatype='real' default-format='*+0.0%;-0.0%' name='[CPO Impact (Overall) (copy)_5889582438523494402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({EXCLUDE  [Calculation_983332855644938242]  : SUM([total_orders]) } )&#10;/&#10;SUM({EXCLUDE  [Calculation_983332855644938242],[country_code]  : SUM([total_orders]) } )' />
      </column>
      <column caption='CPO Impact (Split Orders)' datatype='real' default-format='*+0.0%;-0.0%' name='[CPO Impact (copy)_2913688246561320970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(sum(IF [is_split] and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then cpo_eur end) / sum(IF [is_split] and  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then total_orders end))&#10;/&#10;(sum(IF [is_split] and  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then cpo_eur end) / sum(IF [is_split] and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then total_orders end))&#10;)-1' />
      </column>
      <column caption='Date Range' datatype='date' default-format='*m/d/yyyy' name='[Calculation_2913688246590713867]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date]&lt;= TODAY()-2 then [created_date] end' />
      </column>
      <column caption='Full Rollout Date' datatype='date' name='[Calculation_983332855643955201]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;[country_code]=&quot;om&quot; then DATE(&quot;2023-11-27&quot;)&#10;ELSEIF &#10;[country_code] in (&quot;ae&quot;,&quot;iq&quot;) then DATE(&quot;2023-11-23&quot;)&#10;ELSEIF &#10;[country_code]=&quot;kw&quot; then DATE(&quot;2023-11-21&quot;)&#10;ELSEIF &#10;[country_code]=&quot;qa&quot; then DATE(&quot;2023-11-1&quot;)&#10;ELSEIF &#10;[country_code]=&quot;bh&quot; AND [vertical_type]=&quot;darkstores&quot; then DATE(&quot;2023-10-18&quot;)&#10;END' />
      </column>
      <column caption='Order Flow' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_983332855644938242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2913688246590713867] &gt;= [Calculation_983332855643955201] then &quot;Smart Vehicle Flow&quot;&#10;ELSE &quot;Regular Flow&quot;&#10;END' />
      </column>
      <column caption='% Big Orders' datatype='real' default-format='p0%' name='[Calculation_983332855645188099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_large] then [total_orders] end) / SUM([total_orders])' />
      </column>
      <column caption='% CCR' datatype='real' name='[Calculation_983332855645442052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ccr])/SUM([total_orders])' />
      </column>
      <column caption='% Early' datatype='real' default-format='p0%' name='[Calculation_983332855645544453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([early_orders])/SUM([total_orders])' />
      </column>
      <column caption='% Ontime' datatype='real' default-format='p0%' name='[Calculation_983332855645630470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ontime_orders])/SUM([total_orders])' />
      </column>
      <column caption='% Late' datatype='real' default-format='p0%' name='[Calculation_983332855645679623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_orders])/SUM([total_orders])' />
      </column>
      <column caption='% FR' datatype='real' name='[Calculation_983332855645810696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders])' />
