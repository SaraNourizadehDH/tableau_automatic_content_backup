              <calculation class='tableau' formula='(&#10;(sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle]=&quot;Car&quot; and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
            </column>
            <column caption='CPO Impact (Overall)' datatype='real' default-format='*+0.0%;-0.0%' name='[Big Orders Impact (copy)_983332855647653907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [cpo_eur] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [cpo_eur] end) / sum(IF  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end))&#10;)-1' />
            </column>
            <column caption='% Share' datatype='real' default-format='*+0.0%;-0.0%' name='[CPO Impact (Overall) (copy)_5889582438523494402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({EXCLUDE  [Calculation_983332855644938242]  : SUM([total_orders]) } )&#10;/&#10;SUM({EXCLUDE  [Calculation_983332855644938242],[country_code]  : SUM([total_orders]) } )' />
            </column>
            <column caption='CPO Impact (Split Orders)' datatype='real' default-format='*+0.0%;-0.0%' name='[CPO Impact (copy)_2913688246561320970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF [is_split] and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then cpo_eur end) / sum(IF [is_split] and  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then total_orders end))&#10;/&#10;(sum(IF [is_split] and  [Calculation_983332855644938242]=&quot;Regular Flow&quot; then cpo_eur end) / sum(IF [is_split] and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then total_orders end))&#10;)-1' />
