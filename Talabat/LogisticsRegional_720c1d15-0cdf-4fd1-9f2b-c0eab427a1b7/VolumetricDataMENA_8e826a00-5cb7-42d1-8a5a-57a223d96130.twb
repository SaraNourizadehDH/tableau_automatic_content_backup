    <worksheet name='SC - Impact'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Smart Vehicle Dispatch' name='federated.0jtexm10a77ndd1785r9n0ngaonp' />
          </datasources>
          <datasource-dependencies datasource='federated.0jtexm10a77ndd1785r9n0ngaonp'>
            <column caption='% Change in Split Orders' datatype='real' default-format='p0.0%' name='[Big Orders Impact (copy)_983332855648395286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_split] then [total_orders] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_split] then [total_orders] end) / sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
            </column>
            <column caption='Date Range' datatype='date' default-format='*m/d/yyyy' name='[Calculation_2913688246590713867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date]&lt;= TODAY()-2 then [created_date] end' />
            </column>
            <column caption='Full Rollout Date' datatype='date' name='[Calculation_983332855643955201]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[country_code]=&quot;om&quot; then DATE(&quot;2023-11-27&quot;)&#10;ELSEIF &#10;[country_code] in (&quot;ae&quot;,&quot;iq&quot;) then DATE(&quot;2023-11-23&quot;)&#10;ELSEIF &#10;[country_code]=&quot;kw&quot; then DATE(&quot;2023-11-21&quot;)&#10;ELSEIF &#10;[country_code]=&quot;qa&quot; then DATE(&quot;2023-11-1&quot;)&#10;ELSEIF &#10;[country_code]=&quot;bh&quot; AND [vertical_type]=&quot;darkstores&quot; then DATE(&quot;2023-10-18&quot;)&#10;END' />
            </column>
            <column caption='Order Flow' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_983332855644938242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2913688246590713867] &gt;= [Calculation_983332855643955201] then &quot;Smart Vehicle Flow&quot;&#10;ELSE &quot;Regular Flow&quot;&#10;END' />
            </column>
            <column caption='% Change in Big Orders' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_983332855646883857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_large] then [total_orders] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_large] then [total_orders] end) / sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
            </column>
            <column caption='% Change in Stacked Orders' datatype='real' default-format='p0.0%' name='[Split Orders Impact (copy)_983332855650619415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_stacked] then [total_orders] end) / sum(IF  [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_stacked] then [total_orders] end) / sum(IF [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
            </column>
