    <worksheet name='Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Smart Vehicle Dispatch' name='federated.0jtexm10a77ndd1785r9n0ngaonp' />
          </datasources>
          <datasource-dependencies datasource='federated.0jtexm10a77ndd1785r9n0ngaonp'>
            <column datatype='real' name='[AVTC]' role='measure' type='quantitative' />
            <column datatype='real' name='[AVT]' role='measure' type='quantitative' />
            <column caption='Date Range' datatype='date' default-format='*m/d/yyyy' name='[Calculation_2913688246590713867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date]&lt;= TODAY()-2 then [created_date] end' />
            </column>
            <column caption='Full Rollout Date' datatype='date' name='[Calculation_983332855643955201]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[country_code]=&quot;om&quot; then DATE(&quot;2023-11-27&quot;)&#10;ELSEIF &#10;[country_code] in (&quot;ae&quot;,&quot;iq&quot;) then DATE(&quot;2023-11-23&quot;)&#10;ELSEIF &#10;[country_code]=&quot;kw&quot; then DATE(&quot;2023-11-21&quot;)&#10;ELSEIF &#10;[country_code]=&quot;qa&quot; then DATE(&quot;2023-11-1&quot;)&#10;ELSEIF &#10;[country_code]=&quot;bh&quot; AND [vertical_type]=&quot;darkstores&quot; then DATE(&quot;2023-10-18&quot;)&#10;END' />
            </column>
            <column caption='Order Flow' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_983332855644938242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2913688246590713867] &gt;= [Calculation_983332855643955201] then &quot;Smart Vehicle Flow&quot;&#10;ELSE &quot;Regular Flow&quot;&#10;END' />
            </column>
            <column caption='% Big Orders' datatype='real' default-format='p0%' name='[Calculation_983332855645188099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_large] then [total_orders] end) / SUM([total_orders])' />
            </column>
            <column caption='% CCR' datatype='real' name='[Calculation_983332855645442052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ccr])/SUM([total_orders])' />
            </column>
            <column caption='% Early' datatype='real' default-format='p0%' name='[Calculation_983332855645544453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Ontime' datatype='real' default-format='p0%' name='[Calculation_983332855645630470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ontime_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Late' datatype='real' default-format='p0%' name='[Calculation_983332855645679623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders])/SUM([total_orders])' />
            </column>
            <column caption='% FR' datatype='real' name='[Calculation_983332855645810696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Manual Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_983332855645913097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_manual_deliveries])/SUM([total_orders])' />
            </column>
            <column caption='% RCR' datatype='real' name='[Calculation_983332855646031882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rcr])/SUM([total_orders])' />
            </column>
            <column caption='% Split' datatype='real' default-format='p0.0%' name='[Calculation_983332855646412811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_split] then [total_orders] end) / SUM([total_orders])' />
            </column>
            <column caption='% Stacked' datatype='real' default-format='p0.0%' name='[Calculation_983332855646486540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_stacked] then [total_orders] end) / SUM([total_orders])' />
            </column>
            <column caption='% ICE Split' datatype='real' name='[Calculation_983332855646527501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_ice_split] then [total_orders] end) / SUM([total_orders])' />
            </column>
            <column caption='Avg. AVT' datatype='real' name='[Calculation_983332855646625806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AVT])/SUM([total_orders])' />
            </column>
            <column caption='Avg. AVTC' datatype='real' name='[Calculation_983332855646695439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AVTC])/SUM([total_orders])' />
            </column>
            <column caption='Avg. DT' datatype='real' name='[Calculation_983332855646777360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT]) &#10;/ &#10;SUM([total_orders])' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_983332855647567890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpo_eur])&#10;/&#10;SUM([total_orders])' />
            </column>
