            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5557793809218981896]' derivation='Day-Trunc' name='[tdy:Calculation_5557793809218981896:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5557793809218195458]' derivation='User' name='[usr:Calculation_5557793809218195458:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5557793809224810510]' derivation='User' name='[usr:Calculation_5557793809224810510:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5557793809226498070]' derivation='User' name='[usr:Calculation_5557793809226498070:qk]' pivot='key' type='quantitative' />
