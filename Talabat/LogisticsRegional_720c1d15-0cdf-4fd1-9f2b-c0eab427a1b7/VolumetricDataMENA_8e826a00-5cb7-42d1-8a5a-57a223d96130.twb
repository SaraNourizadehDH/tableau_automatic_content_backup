              <calculation class='tableau' formula='sum(if [Calculation_5557793809220747277]=&apos;Auto-Split&apos; then [AVTC] end) / sum(if [Calculation_5557793809220747277]=&apos;Auto-Split&apos; then total_orders end)&#10;-&#10;sum(if [Calculation_5557793809220747277]=&apos;Regular&apos; then [AVTC] end) / sum(if [Calculation_5557793809220747277]=&apos;Regular&apos; then total_orders end)' />
