          </datasources>
          <datasource-dependencies datasource='federated.0jtexm10a77ndd1785r9n0ngaonp'>
            <column caption='% Change in Big Orders (Bikes)' datatype='real' default-format='*+0.0%;-0.0%' name='[Big Orders Impact (Cars) (copy)_2913688246561124361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242] =&quot;Smart Vehicle Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Smart Vehicle Flow&quot; then [total_orders] end))&#10;/&#10;(sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Regular Flow&quot; and [is_large] then [total_orders] end) / sum(IF [primary_vehicle] in (&quot;Motorbike&quot;,&quot;Bike&quot;) and [Calculation_983332855644938242]=&quot;Regular Flow&quot; then [total_orders] end)) &#10;)-1' />
