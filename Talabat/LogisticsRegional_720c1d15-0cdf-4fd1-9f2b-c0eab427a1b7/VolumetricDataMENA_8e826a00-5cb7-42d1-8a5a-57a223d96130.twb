    <worksheet name='CPO Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Auto-Split' name='federated.0vcdjmn019uvvc1cpneos1qg8pdv' />
          </datasources>
          <datasource-dependencies datasource='federated.0vcdjmn019uvvc1cpneos1qg8pdv'>
            <column datatype='real' name='[CPO1]' role='measure' type='quantitative' />
            <column caption='% Manual Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_5557793809218195458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([manual_delivery_count])/sum([delivery_count])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_5557793809218981896]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [created_date]&lt;= TODAY()-2 then [created_date] end' />
            </column>
            <column caption='CPO-1' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5557793809224810510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(CPO1)/sum(total_orders)' />
            </column>
            <column caption='% Split' datatype='real' default-format='p0.0%' name='[Calculation_5557793809226498070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_split] then [total_orders] END) / SUM([total_orders])' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[delivery_count]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_split]' role='dimension' type='nominal' />
            <column datatype='integer' name='[manual_delivery_count]' role='measure' type='quantitative' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_code]' derivation='None' name='[none:vendor_code:nk]' pivot='key' type='nominal' />
