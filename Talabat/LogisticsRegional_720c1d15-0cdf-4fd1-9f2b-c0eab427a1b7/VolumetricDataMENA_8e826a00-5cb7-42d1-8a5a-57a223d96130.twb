      <aliases enabled='yes' />
      <column caption='% Items with Volumetric' datatype='real' default-format='p0.0%' name='[Calculation_2913688246647554061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (&#10;&#9;(SUM([items_no_volume] + [items_no_weight])) / (sum([total_items])*2)&#10;)' />
      </column>
      <column caption='% No Transmission' datatype='real' default-format='p0.0%' name='[Calculation_2913688246647644174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_transmission_issue] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Orders with Full Volumetric' datatype='real' default-format='p0.0%' name='[Calculation_2913688246647857167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_full_volumetric] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Orders with No Volumetric' datatype='real' default-format='p0.0%' name='[Calculation_2913688246648021008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_no_volumetric] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Orders with Partial Volumetric' datatype='real' default-format='p0.0%' name='[Calculation_2913688246648090641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_partial_volumetric] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Split' datatype='real' default-format='p0.0%' name='[Calculation_2913688246648234002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_split] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Stacked' datatype='real' default-format='p0.0%' name='[Calculation_2913688246648311827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_stacked] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='% Surpassing Limit' datatype='real' default-format='p0.0%' name='[Calculation_2913688246648393748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_surpassing_limit] then [total_orders] end) / sum([total_orders])' />
      </column>
      <column caption='Date Range' datatype='date' default-format='*m/d/yyyy' name='[Calculation_2913688246648508437]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date]&lt;=TODAY()-2 then [created_date] end' />
      </column>
      <column caption='Avg. Daily Split' datatype='real' name='[Calculation_2913688246648643606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_split] then [total_orders] end) / countd([Calculation_2913688246648508437])' />
      </column>
      <column caption='Avg. Daily Surpassing Limit' datatype='real' name='[Calculation_2913688246649061399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_surpassing_limit] then [total_orders] end) / countd([Calculation_2913688246648508437])' />
      </column>
      <column caption='Volumetric Data Completion' datatype='string' name='[Calculation_2913688246649290776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[is_transmission_issue] then &apos;No Transmission&apos;&#10;ELSEIF [is_full_volumetric] then &apos;Full Volumetric&apos;&#10;ELSEIF [is_partial_volumetric] then &apos;Partial Volumetric&apos;&#10;ELSEIF [is_no_volumetric] then &apos;No Volumetric&apos;&#10;end' />
      </column>
