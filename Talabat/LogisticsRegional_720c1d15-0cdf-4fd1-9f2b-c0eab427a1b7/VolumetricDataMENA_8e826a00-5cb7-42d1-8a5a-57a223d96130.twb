          <datasource-dependencies datasource='federated.0jtexm10a77ndd1785r9n0ngaonp'>
            <column caption='Date Range' datatype='date' default-format='*m/d/yyyy' name='[Calculation_2913688246590713867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date]&lt;= TODAY()-2 then [created_date] end' />
            </column>
            <column caption='% Manual Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_983332855645913097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_manual_deliveries])/SUM([total_orders])' />
            </column>
            <column caption='% Split' datatype='real' default-format='p0.0%' name='[Calculation_983332855646412811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_split] then [total_orders] end) / SUM([total_orders])' />
            </column>
            <column caption='% Stacked' datatype='real' default-format='p0.0%' name='[Calculation_983332855646486540]' role='measure' type='quantitative'>
