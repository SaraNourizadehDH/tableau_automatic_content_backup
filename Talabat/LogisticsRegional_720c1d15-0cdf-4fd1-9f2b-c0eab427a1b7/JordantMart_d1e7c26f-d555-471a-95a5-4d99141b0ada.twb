      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_78E4815895784AE0825B6010EB53F6EE'>
            <properties context=''>
              <relation connection='bigquery.0caf5ny1kooa951avvvxs1lgre8v' name='Custom SQL Query' type='text'>------------------------------------------------------------------------------------------------
---------------------Jordan tMart---------------------------------------------------
------------------------------------------------------------------------------------------------
WITH vendor_info AS 
(
  SELECT 
    dvi.vendor_id,
    dvi2.parent_vendor_id,
    dvi2.vendor_name,
    dvi.country_code,
    dli.city_name as city,
  FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
  LEFT JOIN ( SELECT 
                parent_vendor_id,
                vendor_name,
                country_code
            FROM `tlb-data-prod.data_platform.dim_vendor_info`
            WHERE 1=1
              AND is_darkstore
              AND parent_vendor_id - vendor_id = 0
              AND country_code = &apos;JO&apos;
  )AS dvi2 ON dvi.parent_vendor_id = dvi2.parent_vendor_id AND dvi.country_code=dvi2.country_code
  WHERE  dvi.country_code = &apos;JO&apos;
    AND dvi.is_darkstore 
),

base AS 
(
  SELECT 
  --order level data  
    o.country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.vendor.vertical_type,
    o.order_id,
    o.platform_order_code,
    date(o.created_at,o.timezone) AS order_date,
    o.timings.to_vendor_time/60 AS tvt_mins,
    o.timings.at_vendor_time/60 AS avt_mins,
    o.timings.at_vendor_time_cleaned/60 AS avtc_mins,
    o.timings.to_customer_time/60 AS tct_mins,
    o.timings.promised_delivery_time/60 AS pdt_mins,
    o.timings.actual_delivery_time/60 AS adt_mins,
  --delivery level data
    d.is_stacked_intravendor AS is_stacked,
    timestamp_diff(d.rider_dispatched_at,o.created_at,second)/60 AS rdt_mins,
    timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)/60 AS rat_mins,
    timestamp_diff(d.rider_picked_up_at,o.created_at,second)/60 AS pickup_mins,
    (timestamp_diff(d.rider_dispatched_at,o.created_at,second)+timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)+o.timings.to_vendor_time)/60 AS rrv_mins,
    v.vendor_name,
    city
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  WHERE o.created_date &gt;&gt;= &apos;2023-12-31&apos;
    AND o.entity.id = &apos;TB_JO&apos;
    AND d.is_primary
    AND d.is_returning IS FALSE
    AND d.is_redelivery IS FALSE
    AND o.order_status=&apos;completed&apos;
    AND d.delivery_status=&apos;completed&apos;
),


picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    lower(pickers.country_code) AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as total_prep_time,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
  WHERE created_date&gt;&gt;=&apos;2023-12-31&apos;
    AND global_entity_id = &apos;TB_JO&apos;
)

  SELECT 
    rd.country_code,
    rd.city,
    vendor_name,
    date_trunc(order_date,month) order_month,
    count(DISTINCT rd.order_id) AS order_count_d,
    count(rd.order_id) AS order_count,
    count(CASE WHEN is_stacked THEN rd.order_id END) AS stacked_order_count,
    sum(rd.tvt_mins) AS tvt_mins,
    sum(rd.avt_mins) AS avt_mins,
    sum(rd.avtc_mins) AS avtc_mins,
    sum(rd.tct_mins) AS tct_mins,
    sum(rd.pdt_mins) AS pdt_mins,
    sum(rd.adt_mins) AS adt_mins,
    sum(rd.rdt_mins) AS rdt_mins, 
    sum(rd.rat_mins) AS rat_mins, 
    sum(rd.rrv_mins) AS rrv_mins, 
    sum(rd.pickup_mins) AS pickup_mins, 
    count(p.order_id) AS picking_order_count,
    sum(total_prep_time) AS total_prep_time,
    sum(store_dispatch_time) AS store_dispatch_time
  FROM base rd
    LEFT JOIN picking_data p ON rd.country_code=p.country_code AND rd.platform_order_code=cast(p.order_id AS string)
      WHERE order_date BETWEEN &apos;2024-01-01&apos; AND (current_date()-1)
        GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
