        <column caption='Metrics 1' datatype='string' name='[Primary value (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders Completed [NO.]&quot;'>
          <calculation class='tableau' formula='&quot;Orders Completed [NO.]&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F3B77C9D055C41808D3173A3CFC090EA'>
            <properties context=''>
              <relation connection='bigquery.1gariuq06gmzao132332v11ps6p3' name='Custom SQL Query' type='text'>with parameters as
(
select
date_add(date_trunc(current_date,month), interval -2 month) as date_start,
current_date as date_end,
)
, contact as (
SELECT distinct
lower(country_code) as country_code,
cast(order_id as integer) as order_id,
string_agg(distinct contact_reason_l3,&apos;; &apos;) contact_reasons,
FROM `tlb-data-prod.data_platform.fct_contact` c
left join `tlb-data-prod.data_platform.dim_contact_reason` cr on cr.contact_reason_id = c.contact_reason_id
left join `tlb-data-prod.data_platform.dim_contact_stakeholder` s on s.contact_stakeholder_id = c.stakeholder_id
cross join parameters
where contact_date_utc&gt;&gt;=date_start
and s.contact_stakeholder =&apos;Customer&apos;
and order_id is not null
group by 1,2
)
, splits as (
select
country_code,
entity_id,
order_id,
string_agg(distinct delivery_reason,&quot;,&quot;) reason_list,
count(distinct delivery_id) as no_of_delivery,
from `tlb-data-prod.data_platform.fct_logistics_delivery`
cross join parameters
where created_date&gt;&gt;=date_start
group by 1,2,3
)

, dispatch as (
SELECT distinct
country_code,
entity_id,
order_id,
undispatch_type,
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
cross join parameters
where created_date&gt;&gt;=date_start
and undispatch_type=&apos;manual_dispatch&apos;
)

, reassign as (
select distinct
country_code,
entity_id,
order_id,
max(no_of_accepted) as no_of_reassigned,
true as is_reassigned
from (
    SELECT 
    country_code,
    entity_id,
    order_id,
    delivery_id,
    count(state) as no_of_accepted
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date&gt;&gt;=date_start
    and state=&apos;accepted&apos;
    group by 1,2,3,4
    having count(state)&gt;&gt;1
)
group by 1,2,3
)

, acceptance as (
    SELECT distinct
    country_code,
    entity_id,
    order_id,
    count(case when state=&apos;courier_notified&apos; then state end) as notif_no,
    count(case when state=&apos;accepted&apos; then state end) as accepted_no, 
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date&gt;&gt;=date_start
    group by 1,2,3
)


, log_fail as (
select lower(country_Code) as country_code,
cast(order_id as int64) order_id,
if (lower(reason) in
(
  &apos;application issue / it&apos;,
&apos;cold food &amp; spilt delivery&apos;,
&apos;courier accident&apos;,
&apos;courier unreachable&apos;,
&apos;delivery eta too long&apos;,
&apos;do not deliver to this area&apos;,
&apos;failing to punch order (expired)&apos;,
&apos;failing to punch order (missed)&apos;,
&apos;lack of delivery men&apos;,
&apos;late delivery&apos;,
&apos;missing / wrong order&apos;,
&apos;never delivered&apos;,
&apos;no pickers&apos;,
&apos;reason unknown&apos;,
&apos;outside of service hours&apos;,
&apos;pos reason unknown&apos;,
&apos;too busy&apos;,
&apos;unavailable menu items&apos;,
&apos;unprofessional behaviour from the driver&apos;,
&apos;vendor closed&apos;,
&apos;vendor location is incorrect&apos;
), True, False) is_log_fail
  from `tlb-data-prod.data_platform.fct_order_info` foi 
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` AS ofr using(order_fail_reason_id)
  cross join parameters
  WHERE (foi.order_date)&gt;&gt;=date_start
  and lower(foi.country_iso) in (&apos;qa&apos;, &apos;om&apos;, &apos;jo&apos;, &apos;eg&apos;, &apos;ae&apos;, &apos;kw&apos;, &apos;bh&apos;, &apos;iq&apos;)
  and is_tgo

)


SELECT distinct
country_code,
city_name,
vendor_code,
vendor_name,
vertical_type,
date_trunc(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone), day) day,
order_status,
order_id,
actual_delivery_time/60 as DT,
hold_back_time/60 as HBT,
vendor_transmission_time/60 as transmission_time_min,
primary_dropoff_distance_manhattan/1000 as drop_off_distance_km,
accepted_no,
notif_no,
dispatching_time/60 as dispatching_time_min,
rider_late/60 as rider_late_min,
vendor_late/60 as vendor_late_min,
to_customer_time/60 as to_customer_time_min,
to_vendor_time/60 as to_vendor_time_min,
estimated_vendor_walk_in_duration/60 as vendor_walk_in_min,
rider_reaction_time/60 as rider_reaction_time,
(datetime_diff(picked_up_at,vendor_prepared_at,second)/60) as order_waiting_time_min,
order_delay/60 as order_delay_min,
rider_reaction_time/60 as acceptance_time_min,
contact_reasons,
case when reason_list like &apos;%Big order/split order%&apos; then true else false end as is_split_orders,
case when primary_stacked_count&gt;&gt;=1 then true else false end as is_stacked,
case when primary_stacked_count=2 then true else false end as is_double_stacked,
case when contact.contact_reasons like &apos;%Missing item%&apos; then true else false end as is_missing_item,
estimated_prep_time/60 as estimated_prep_time_min,
estimated_prep_buffer/60 as estimated_prep_buffer_min,
case when undispatch_type=&apos;manual_dispatch&apos; then true else false end as is_manual_dispatch,
assumed_actual_preparation_time/60 as assumed_actual_prep_time_min,
at_vendor_time_cleaned/60 as avtc_min,
at_vendor_time/60 as avt_min,
is_log_fail,
case when is_log_fail is not null then true else false end as is_part_of_log_fail

FROM `tlb-data-prod.data_platform.fct_logistics_order`
left join `tlb-data-prod.data_platform.dim_logistics_vendor` using(country_code, entity_id, vendor_code, city_id)
left join contact using(country_code, order_id)
left join splits using(entity_id, country_code, order_id)
left join dispatch using(entity_id, country_code, order_id)
left join reassign using(entity_id, country_code, order_id)
left join acceptance using(entity_id, country_code, order_id)
left join log_fail using(country_code, order_id)
left join (select city_id, city_name, country_code from `tlb-data-prod.data_platform.dim_logistics_city` where is_active) using(country_code, city_id)
cross join parameters
where created_date&gt;&gt;=date_start
and country_code IN (&apos;qa&apos;, &apos;om&apos;, &apos;jo&apos;, &apos;eg&apos;, &apos;ae&apos;, &apos;kw&apos;, &apos;bh&apos;, &apos;iq&apos;)
and (lower(vendor_name) like &apos;%talabat mart%&apos; or lower(vendor_name) like &apos;tmart%&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Monthly data' inline='true' name='federated.1gydsoy1pichc515lpqy21i3r66b' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.002pc5r046s1ho1gpptnr1kzxlk4'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='' server-oauth='' username='mohammad.mansoor@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='(2)' name='cloudfile:googledrive-excel-direct.04yj7jl0xrsaj81h1kght1jmqwk9'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='18qPXpug-6y3qlIgbvBCSvClMuG8XWZtbXg2KzSQGVIE' cloudFileMetadata_-_folder='root' cloudFileName='Tmart Strategic Scorecard Value.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/18qPXpug-6y3qlIgbvBCSvClMuG8XWZtbXg2KzSQGVIE/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Tmart Strategic Scorecard Value.xlsx' google-sheets-upgraded='true' interpretationMode='0' server='' server-oauth='server-custom' userLanguage='en' username='mohammad.mansoor@talabat.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.002pc5r046s1ho1gpptnr1kzxlk4' name='Custom SQL Query' type='text'><![CDATA[with parameters as
(
select
date_add(date_trunc(current_date,month), interval -6 month) as date_start,
date("2022-06-01") as date_end,
)

, contact as (
SELECT distinct
global_entity_id as entity_id,
cast(order_id as integer) as order_id,
string_agg(distinct contact_reason_l3,'; ') contact_reasons,
FROM `fulfillment-dwh-production.curated_data_shared_gcc_service.all_contacts`
cross join parameters
where created_date>>=date_start
and stakeholder='Customer'
and order_id is not null
group by 1,2

)

, splits as (
select
country_code,
entity_id,
order_id,
string_agg(distinct delivery_reason,",") reason_list,
count(distinct delivery_id) as no_of_delivery,
from `tlb-data-prod.data_platform.fct_logistics_delivery`
cross join parameters
where created_date>>=date_start
group by 1,2,3
)

, dispatch as (
SELECT distinct
country_code,
entity_id,
order_id,
undispatch_type,
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
cross join parameters
where created_date>>=date_start
and undispatch_type='manual_dispatch'
)

, reassign as (
select
country_code,
entity_id,
order_id,
max(no_of_accepted) as no_of_reassigned,
true as is_reassigned
from (
    SELECT 
    country_code,
    entity_id,
    order_id,
    delivery_id,
    count(state) as no_of_accepted
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date>>=date_start
    and state='accepted'
    group by 1,2,3,4
    having count(state)>>1
)
group by 1,2,3
)

, log_fail as (
select lower(country_Code) as country_code,
cast(order_id as int64) order_id,
if (lower(reason) in
(
  'application issue / it',
'cold food & spilt delivery',
'courier accident',
'courier unreachable',
'delivery eta too long',
'do not deliver to this area',
'failing to punch order (expired)',
'failing to punch order (missed)',
'lack of delivery men',
'late delivery',
'missing / wrong order',
'never delivered',
'no pickers',
'reason unknown',
'outside of service hours',
'pos reason unknown',
'too busy',
'unavailable menu items',
'unprofessional behaviour from the driver',
'vendor closed',
'vendor location is incorrect'
), True, False) is_log_fail
  from `tlb-data-prod.data_platform.fct_order_info` foi 
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` AS ofr using(order_fail_reason_id)
  cross join parameters
  WHERE (foi.order_date)>>=date_start
  and lower(foi.country_iso) in ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
  and is_tgo
)


, orders as (
select if(country_Code is null,'Regional',country_code) as country_code,
* except(country_code) from
(
SELECT
country_code,
date_trunc(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone), month) day,
count(distinct case when order_delay is not null then order_code end) no_of_orders,
count (distinct order_id) as no_of_all_orders,
avg(actual_delivery_time)/60 as DT,
(approx_quantiles(actual_delivery_time/60,100))[offset(75)] as DT_p75,
count(distinct case when actual_delivery_time/60<<20 then order_id end) as DT_20,
count(distinct case when actual_delivery_time/60<<30 then order_id end) as DT_30,

count(distinct case when is_log_fail then order_id end) as fail_order_count,
count(distinct case when contact_reasons is not null then order_id end) as contacted_order_count,
count(distinct case when contact_reasons like '%Missing item%' then order_id end) as missing_order_count,
count(distinct case when reason_list like '%Big order/split order%' then order_id end) as split_order_count,
count(distinct case when primary_stacked_count>>=1 then order_id end) as stacked_order_count,
avg(datetime_diff(vendor_prepared_at, accepted_by_vendor_at, second)/60) as FIR,
avg(at_vendor_time_cleaned)/60 as avtc,
count(distinct case when vendor_late/60 >> 10 then order_id end)/count(distinct case when vendor_late is not null then order_id end) as vlate_10,
count(distinct case when rider_late/60 >> 10 then order_id end)/count(distinct case when rider_late is not null then order_id end) as rlate_10,
count(distinct case when is_reassigned then order_id end) as reassigned_order_count


FROM `tlb-data-prod.data_platform.fct_logistics_order`
left join `tlb-data-prod.data_platform.dim_logistics_vendor` using(country_code, entity_id, vendor_code)
left join contact using(entity_id, order_id)
left join splits using(entity_id, country_code, order_id)
left join dispatch using(entity_id, country_code, order_id)
left join reassign using(entity_id, country_code, order_id)
left join log_fail using(country_code, order_id)
cross join parameters
where created_date>>=date_start
and country_code IN ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
and (lower(vendor_name) like '%talabat mart%' or lower(vendor_name) like 'tmart%')
group by rollup(2,1)
) where day is not null)

select
country_code,
timing,
case
  when measures in('DT [min]','DT 75th pct [%]','DT<<20 [%]','DT<<30 [%]','CR - Logistics [%]',
    'FR - Logistics [%]','CR- Missing Items [%]') then 'CX experience'
  when measures in('Split [%]','Stacked [%]','Manual dispatched orders [%]','Reassigned orders [%]') then 'Order setup'
  when measures in('FIR [min]','At vendor time cleaned [min]','Vendor Late >> 10 mins [%]','Rider Late >> 10 mins [%]') then 'Vendor performance'
end as metric_group,
measures,
value
from (
        select
        country_code,
        day as timing,
        DT,
        DT_p75,
        safe_divide(DT_20,no_of_orders) as DT_20_pct,
        safe_divide(DT_30,no_of_orders) as DT_30_pct,
        safe_divide(contacted_order_count,no_of_all_orders) as contact_rate,
        safe_divide(missing_order_count,no_of_all_orders) as missing_contact_rate,
        safe_divide(fail_order_count,no_of_all_orders) as log_fail_rate,
        safe_divide(split_order_count,no_of_all_orders) as split_order_pct,
        safe_divide(stacked_order_count,no_of_all_orders) as stacked_order_pct,
        safe_divide(reassigned_order_count,no_of_all_orders) as reassigned_order_pct,
        FIR,
        avtc,
        vlate_10,
        rlate_10
        from orders
        where day is not null
) p

unpivot
(value  for measures in 
  (
DT as "DT [min]" ,
DT_p75 as "DT 75th pct [%]", 
DT_20_pct as "DT<<20 [%]", 
DT_30_pct as "DT<<30 [%]", 
contact_rate as "CR - Logistics [%]",
missing_contact_rate as "CR- Missing Items [%]",
log_fail_rate as "FR - Logistics [%]",
split_order_pct as "Split [%]",
stacked_order_pct as "Stacked [%]",
reassigned_order_pct as "Reassigned orders [%]",
FIR as "FIR [min]",
avtc as "At vendor time cleaned [min]",
vlate_10 as "Vendor Late >> 10 mins [%]",
rlate_10 as "Rider Late >> 10 mins [%]"
)
) as unpvt
order by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.002pc5r046s1ho1gpptnr1kzxlk4' name='Custom SQL Query' type='text'><![CDATA[with parameters as
(
select
date_add(date_trunc(current_date,month), interval -6 month) as date_start,
date("2022-06-01") as date_end,
)

, contact as (
SELECT distinct
global_entity_id as entity_id,
cast(order_id as integer) as order_id,
string_agg(distinct contact_reason_l3,'; ') contact_reasons,
FROM `fulfillment-dwh-production.curated_data_shared_gcc_service.all_contacts`
cross join parameters
where created_date>>=date_start
and stakeholder='Customer'
and order_id is not null
group by 1,2

)

, splits as (
select
country_code,
entity_id,
order_id,
string_agg(distinct delivery_reason,",") reason_list,
count(distinct delivery_id) as no_of_delivery,
from `tlb-data-prod.data_platform.fct_logistics_delivery`
cross join parameters
where created_date>>=date_start
group by 1,2,3
)

, dispatch as (
SELECT distinct
country_code,
entity_id,
order_id,
undispatch_type,
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
cross join parameters
where created_date>>=date_start
and undispatch_type='manual_dispatch'
)

, reassign as (
select
country_code,
entity_id,
order_id,
max(no_of_accepted) as no_of_reassigned,
true as is_reassigned
from (
    SELECT 
    country_code,
    entity_id,
    order_id,
    delivery_id,
    count(state) as no_of_accepted
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date>>=date_start
    and state='accepted'
    group by 1,2,3,4
    having count(state)>>1
)
group by 1,2,3
)

, log_fail as (
select lower(country_Code) as country_code,
cast(order_id as int64) order_id,
if (lower(reason) in
(
  'application issue / it',
'cold food & spilt delivery',
'courier accident',
'courier unreachable',
'delivery eta too long',
'do not deliver to this area',
'failing to punch order (expired)',
'failing to punch order (missed)',
'lack of delivery men',
'late delivery',
'missing / wrong order',
'never delivered',
'no pickers',
'reason unknown',
'outside of service hours',
'pos reason unknown',
'too busy',
'unavailable menu items',
'unprofessional behaviour from the driver',
'vendor closed',
'vendor location is incorrect'
), True, False) is_log_fail
  from `tlb-data-prod.data_platform.fct_order_info` foi 
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` AS ofr using(order_fail_reason_id)
  cross join parameters
  WHERE (foi.order_date)>>=date_start
  and lower(foi.country_iso) in ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
  and is_tgo
)


, orders as (
select if(country_Code is null,'Regional',country_code) as country_code,
* except(country_code) from
(
SELECT
country_code,
date_trunc(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone), month) day,
count(distinct case when order_delay is not null then order_code end) no_of_orders,
count (distinct order_id) as no_of_all_orders,
avg(actual_delivery_time)/60 as DT,
(approx_quantiles(actual_delivery_time/60,100))[offset(75)] as DT_p75,
count(distinct case when actual_delivery_time/60<<20 then order_id end) as DT_20,
count(distinct case when actual_delivery_time/60<<30 then order_id end) as DT_30,

count(distinct case when is_log_fail then order_id end) as fail_order_count,
count(distinct case when contact_reasons is not null then order_id end) as contacted_order_count,
count(distinct case when contact_reasons like '%Missing item%' then order_id end) as missing_order_count,
count(distinct case when reason_list like '%Big order/split order%' then order_id end) as split_order_count,
count(distinct case when primary_stacked_count>>=1 then order_id end) as stacked_order_count,
avg(datetime_diff(vendor_prepared_at, accepted_by_vendor_at, second)/60) as FIR,
avg(at_vendor_time_cleaned)/60 as avtc,
count(distinct case when vendor_late/60 >> 10 then order_id end)/count(distinct case when vendor_late is not null then order_id end) as vlate_10,
count(distinct case when rider_late/60 >> 10 then order_id end)/count(distinct case when rider_late is not null then order_id end) as rlate_10,
count(distinct case when is_reassigned then order_id end) as reassigned_order_count


FROM `tlb-data-prod.data_platform.fct_logistics_order`
left join `tlb-data-prod.data_platform.dim_logistics_vendor` using(country_code, entity_id, vendor_code)
left join contact using(entity_id, order_id)
left join splits using(entity_id, country_code, order_id)
left join dispatch using(entity_id, country_code, order_id)
left join reassign using(entity_id, country_code, order_id)
left join log_fail using(country_code, order_id)
cross join parameters
where created_date>>=date_start
and country_code IN ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
and (lower(vendor_name) like '%talabat mart%' or lower(vendor_name) like 'tmart%')
group by rollup(2,1)
) where day is not null)

select
country_code,
timing,
case
  when measures in('DT [min]','DT 75th pct [%]','DT<<20 [%]','DT<<30 [%]','CR - Logistics [%]',
    'FR - Logistics [%]','CR- Missing Items [%]') then 'CX experience'
  when measures in('Split [%]','Stacked [%]','Manual dispatched orders [%]','Reassigned orders [%]') then 'Order setup'
  when measures in('FIR [min]','At vendor time cleaned [min]','Vendor Late >> 10 mins [%]','Rider Late >> 10 mins [%]') then 'Vendor performance'
end as metric_group,
measures,
value
from (
        select
        country_code,
        day as timing,
        DT,
        DT_p75,
        safe_divide(DT_20,no_of_orders) as DT_20_pct,
        safe_divide(DT_30,no_of_orders) as DT_30_pct,
        safe_divide(contacted_order_count,no_of_all_orders) as contact_rate,
        safe_divide(missing_order_count,no_of_all_orders) as missing_contact_rate,
        safe_divide(fail_order_count,no_of_all_orders) as log_fail_rate,
        safe_divide(split_order_count,no_of_all_orders) as split_order_pct,
        safe_divide(stacked_order_count,no_of_all_orders) as stacked_order_pct,
        safe_divide(reassigned_order_count,no_of_all_orders) as reassigned_order_pct,
        FIR,
        avtc,
        vlate_10,
        rlate_10
        from orders
        where day is not null
) p

unpivot
(value  for measures in 
  (
DT as "DT [min]" ,
DT_p75 as "DT 75th pct [%]", 
DT_20_pct as "DT<<20 [%]", 
DT_30_pct as "DT<<30 [%]", 
contact_rate as "CR - Logistics [%]",
missing_contact_rate as "CR- Missing Items [%]",
log_fail_rate as "FR - Logistics [%]",
split_order_pct as "Split [%]",
stacked_order_pct as "Stacked [%]",
reassigned_order_pct as "Reassigned orders [%]",
FIR as "FIR [min]",
avtc as "At vendor time cleaned [min]",
vlate_10 as "Vendor Late >> 10 mins [%]",
rlate_10 as "Rider Late >> 10 mins [%]"
)
) as unpvt
order by 1,2,3]]></relation>
