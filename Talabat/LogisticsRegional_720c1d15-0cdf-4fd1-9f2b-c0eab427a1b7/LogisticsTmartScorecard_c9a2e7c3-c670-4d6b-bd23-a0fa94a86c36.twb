              <calculation class='tableau' formula='countd(if [DT]&lt;20 then [order_id] else null end)/countd(if not ISNULL([DT]) then [order_id] else null end)' />
            </column>
            <column caption='DT &gt; 45 [%]' datatype='real' name='[DT &lt; 30 [%]]  (copy)_2027675428983644173]' role='measure' type='quantitative'>
