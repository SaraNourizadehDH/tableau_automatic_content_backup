      </column>
      <column caption='heatmap value' datatype='real' name='[value display (copy)_3051259164755087363]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='case  ([measures])&#10;    when &apos;DT [min]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;DT 75th pct [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;DT&lt;20 [%]&apos; then round(100+100*(([value]-[threshold])/[threshold]))&#10;    when &apos;DT&lt;30 [%]&apos; then round(100+100*(([value]-[threshold])/[threshold]))&#10;    when &apos;CR - Logistics [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;FR - Logistics [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Split [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Stacked [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Manual dispatched orders [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Reassigned orders [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;FIR [min]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;At vendor time cleaned [min]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Vendor Late &gt; 10 mins [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;    when &apos;Rider Late &gt; 10 mins [%]&apos; then round(100+100*(-([value]-[threshold])/[threshold]))&#10;else null&#10;end' />
      </column>
      <column caption='threshold display' datatype='string' name='[value display (copy)_3051259164762808325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case  ([measures])&#10;    when &apos;DT [min]&apos; then left(str(round(([threshold]),5)),4)&#10;    when &apos;DT 75th pct [%]&apos; then left(str(round(([threshold]),5)),4)&#10;    when &apos;DT&lt;20 [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;DT&lt;30 [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;CR - Logistics [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;FR - Logistics [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;Split [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;Stacked [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;Manual dispatched orders [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;Reassigned orders [%]&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;    when &apos;Assumed actual prep time [min]&apos; then left(str(round(([threshold]),5)),4)&#10;    when &apos;At vendor time cleaned [min]&apos; then left(str(round(([threshold]),5)),4)&#10;    when &apos;DF (LC)&apos; then left(str(round(([threshold]),5)),4)&#10;    when &apos;DF as % of food GMV (%)&apos; then left(str(round(([threshold]*100),5)),4)+&quot;%&quot;&#10;else null&#10;end' />
      </column>
