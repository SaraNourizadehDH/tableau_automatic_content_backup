      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_EBACDB47108F42D28F23CC88E2BAC8ED'>
            <properties context=''>
              <relation connection='bigquery.002pc5r046s1ho1gpptnr1kzxlk4' name='Custom SQL Query' type='text'><![CDATA[with parameters as
(
select
date_add(date_trunc(current_date,month), interval -6 month) as date_start,
date("2022-06-01") as date_end,
)

, contact as (
SELECT distinct
global_entity_id as entity_id,
cast(order_id as integer) as order_id,
string_agg(distinct contact_reason_l3,'; ') contact_reasons,
FROM `fulfillment-dwh-production.curated_data_shared_gcc_service.all_contacts`
cross join parameters
where created_date>>=date_start
and stakeholder='Customer'
and order_id is not null
group by 1,2

)

, splits as (
select
country_code,
entity_id,
order_id,
string_agg(distinct delivery_reason,",") reason_list,
count(distinct delivery_id) as no_of_delivery,
from `tlb-data-prod.data_platform.fct_logistics_delivery`
cross join parameters
where created_date>>=date_start
group by 1,2,3
)

, dispatch as (
SELECT distinct
country_code,
entity_id,
order_id,
undispatch_type,
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
cross join parameters
where created_date>>=date_start
and undispatch_type='manual_dispatch'
)

, reassign as (
select
country_code,
entity_id,
order_id,
max(no_of_accepted) as no_of_reassigned,
true as is_reassigned
from (
    SELECT 
    country_code,
    entity_id,
    order_id,
    delivery_id,
    count(state) as no_of_accepted
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date>>=date_start
    and state='accepted'
    group by 1,2,3,4
    having count(state)>>1
)
group by 1,2,3
)

, log_fail as (
select lower(country_Code) as country_code,
cast(order_id as int64) order_id,
if (lower(reason) in
(
  'application issue / it',
'cold food & spilt delivery',
'courier accident',
'courier unreachable',
'delivery eta too long',
'do not deliver to this area',
'failing to punch order (expired)',
'failing to punch order (missed)',
'lack of delivery men',
'late delivery',
'missing / wrong order',
'never delivered',
'no pickers',
'reason unknown',
'outside of service hours',
'pos reason unknown',
'too busy',
'unavailable menu items',
'unprofessional behaviour from the driver',
'vendor closed',
'vendor location is incorrect'
), True, False) is_log_fail
  from `tlb-data-prod.data_platform.fct_order_info` foi 
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` AS ofr using(order_fail_reason_id)
  cross join parameters
  WHERE (foi.order_date)>>=date_start
  and lower(foi.country_iso) in ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
  and is_tgo
)


, orders as (
select if(country_Code is null,'Regional',country_code) as country_code,
* except(country_code) from
(
SELECT
country_code,
date_trunc(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone), month) day,
count(distinct case when order_delay is not null then order_code end) no_of_orders,
count (distinct order_id) as no_of_all_orders,
avg(actual_delivery_time)/60 as DT,
(approx_quantiles(actual_delivery_time/60,100))[offset(75)] as DT_p75,
count(distinct case when actual_delivery_time/60<<20 then order_id end) as DT_20,
count(distinct case when actual_delivery_time/60<<30 then order_id end) as DT_30,

count(distinct case when is_log_fail then order_id end) as fail_order_count,
count(distinct case when contact_reasons is not null then order_id end) as contacted_order_count,
count(distinct case when contact_reasons like '%Missing item%' then order_id end) as missing_order_count,
count(distinct case when reason_list like '%Big order/split order%' then order_id end) as split_order_count,
count(distinct case when primary_stacked_count>>=1 then order_id end) as stacked_order_count,
avg(datetime_diff(vendor_prepared_at, accepted_by_vendor_at, second)/60) as FIR,
avg(at_vendor_time_cleaned)/60 as avtc,
count(distinct case when vendor_late/60 >> 10 then order_id end)/count(distinct case when vendor_late is not null then order_id end) as vlate_10,
count(distinct case when rider_late/60 >> 10 then order_id end)/count(distinct case when rider_late is not null then order_id end) as rlate_10,
count(distinct case when is_reassigned then order_id end) as reassigned_order_count


FROM `tlb-data-prod.data_platform.fct_logistics_order`
left join `tlb-data-prod.data_platform.dim_logistics_vendor` using(country_code, entity_id, vendor_code)
left join contact using(entity_id, order_id)
left join splits using(entity_id, country_code, order_id)
left join dispatch using(entity_id, country_code, order_id)
left join reassign using(entity_id, country_code, order_id)
left join log_fail using(country_code, order_id)
cross join parameters
where created_date>>=date_start
and country_code IN ('qa', 'om', 'jo', 'eg', 'ae', 'kw', 'bh', 'iq')
and (lower(vendor_name) like '%talabat mart%' or lower(vendor_name) like 'tmart%')
group by rollup(2,1)
) where day is not null)

select
country_code,
timing,
case
  when measures in('DT [min]','DT 75th pct [%]','DT<<20 [%]','DT<<30 [%]','CR - Logistics [%]',
    'FR - Logistics [%]','CR- Missing Items [%]') then 'CX experience'
  when measures in('Split [%]','Stacked [%]','Manual dispatched orders [%]','Reassigned orders [%]') then 'Order setup'
  when measures in('FIR [min]','At vendor time cleaned [min]','Vendor Late >> 10 mins [%]','Rider Late >> 10 mins [%]') then 'Vendor performance'
end as metric_group,
measures,
value
from (
        select
        country_code,
        day as timing,
        DT,
        DT_p75,
        safe_divide(DT_20,no_of_orders) as DT_20_pct,
        safe_divide(DT_30,no_of_orders) as DT_30_pct,
        safe_divide(contacted_order_count,no_of_all_orders) as contact_rate,
        safe_divide(missing_order_count,no_of_all_orders) as missing_contact_rate,
        safe_divide(fail_order_count,no_of_all_orders) as log_fail_rate,
        safe_divide(split_order_count,no_of_all_orders) as split_order_pct,
        safe_divide(stacked_order_count,no_of_all_orders) as stacked_order_pct,
        safe_divide(reassigned_order_count,no_of_all_orders) as reassigned_order_pct,
        FIR,
        avtc,
        vlate_10,
        rlate_10
        from orders
        where day is not null
) p

unpivot
(value  for measures in 
  (
DT as "DT [min]" ,
DT_p75 as "DT 75th pct [%]", 
DT_20_pct as "DT<<20 [%]", 
DT_30_pct as "DT<<30 [%]", 
contact_rate as "CR - Logistics [%]",
missing_contact_rate as "CR- Missing Items [%]",
log_fail_rate as "FR - Logistics [%]",
split_order_pct as "Split [%]",
stacked_order_pct as "Stacked [%]",
reassigned_order_pct as "Reassigned orders [%]",
FIR as "FIR [min]",
avtc as "At vendor time cleaned [min]",
vlate_10 as "Vendor Late >> 10 mins [%]",
rlate_10 as "Rider Late >> 10 mins [%]"
)
) as unpvt
order by 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_EBACDB47108F42D28F23CC88E2BAC8ED' table='[Extract].[_EBACDB47108F42D28F23CC88E2BAC8ED]' type='table' />
            </properties>
          </object>
          <object caption='threshold' id='threshold_16F13862A0D54919BD003804FC396895'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.04yj7jl0xrsaj81h1kght1jmqwk9' name='threshold' table='[threshold$]' type='table'>
                <columns gridOrigin='A1:C113:no:A1:C113:0' header='yes' outcome='2'>
                  <column datatype='string' name='country_code' ordinal='0' />
                  <column datatype='string' name='metric' ordinal='1' />
                  <column datatype='real' name='threshold' ordinal='2' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='threshold_16F13862A0D54919BD003804FC396895' table='[Extract].[threshold_16F13862A0D54919BD003804FC396895]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[country_code]' />
                <expression op='[country_code (threshold)]' />
              </expression>
              <expression op='='>
                <expression op='[measures]' />
                <expression op='[metric]' />
              </expression>
            </expression>
            <first-end-point guaranteed-value='true' object-id='_EBACDB47108F42D28F23CC88E2BAC8ED' />
            <second-end-point guaranteed-value='true' object-id='threshold_16F13862A0D54919BD003804FC396895' />
          </relationship>
        </relationships>
