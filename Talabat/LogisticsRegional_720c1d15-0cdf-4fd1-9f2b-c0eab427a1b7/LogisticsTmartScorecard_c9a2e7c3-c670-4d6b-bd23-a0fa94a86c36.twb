    <worksheet name='fixed vendor'>
      <table>
        <view>
          <datasources>
            <datasource caption='Ops scorecard data' name='federated.12iship0uksr0a16i10930okro14' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12iship0uksr0a16i10930okro14'>
            <column caption='At Vendor Time Cleaned [min]' datatype='real' name='[At vendor time [min]] (copy)_2027675428989534251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avtc_min])' />
            </column>
            <column caption='Est. Prep Buffer [min]' datatype='real' name='[Avg. order waiting time [min]] (copy)_2027675428989595692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([estimated_prep_buffer_min])' />
            </column>
            <column caption='DT [min]' datatype='real' name='[Calculation_2027675428980469760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([DT])' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_2027675429577515060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Metrics (copy)] when &apos;Day&apos; then str([day])&#10;when &apos;Week&apos; then str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;iso-week&apos;,[day])))+&quot;-W&quot;+str(isoweek(DATE(DATETRUNC(&apos;iso-week&apos;,[day]))))&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;month&apos;,[day])))+&quot;-&quot;+STR(month(DATETRUNC(&apos;month&apos;,[day])))&#10;&#10;end' />
            </column>
            <column caption='EPT+AVTC [min]' datatype='real' name='[Calculation_3851703637362335744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Est. Prep Buffer [min]] (copy)_2027675428989648941]+[At vendor time [min]] (copy)_2027675428989534251]' />
            </column>
            <column caption='Missing Item Contacts [NO.]' datatype='integer' name='[Calculation_4139933991312220162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_missing_item]=True then order_id end)' />
            </column>
            <column caption='Fail Rate [%]' datatype='real' name='[Contact rate [%]] (copy)_2027675428984700947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [order_status]=&apos;cancelled&apos; then [order_id] end)/COUNTD([order_id])' />
            </column>
            <column caption='DT - 99th percentile [%]' datatype='real' name='[DT - 95th percentile [%]] (copy)_2027675428981022726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='PERCENTILE([DT],0.99)' />
            </column>
            <column caption='DT - 90th percentile [%]' datatype='real' name='[DT 50th percentile [%]] (copy) (copy 2)_2027675428980785157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='PERCENTILE([DT],0.9)' />
            </column>
            <column caption='DT - 95th percentile [%]' datatype='real' name='[DT 50th percentile [%]] (copy) (copy)_2027675428980727811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='PERCENTILE([DT],0.95)' />
            </column>
            <column caption='DT 75th percentile [%]' datatype='real' name='[DT 50th percentile [%]] (copy)_2027675428980715522]' role='measure' type='quantitative'>
