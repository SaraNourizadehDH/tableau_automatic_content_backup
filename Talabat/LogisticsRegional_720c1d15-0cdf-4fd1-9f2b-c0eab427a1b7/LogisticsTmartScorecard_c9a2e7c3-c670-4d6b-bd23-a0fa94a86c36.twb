    <datasource caption='weekly data' inline='true' name='federated.17d49ek04he4eh159wcjo0569uqx' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1b0m5np0iyptis13b2lw40khrgrm'>
            <connection CATALOG='bta---talabat' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='BTA - Talabat' schema='data_platform' server-oauth='' username='mohammad.mansoor@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Tmart Strategic Scorecard Value' name='cloudfile:googledrive-excel-direct.1ilk6jp1abb2211fvqqec0o6qpio'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='18qPXpug-6y3qlIgbvBCSvClMuG8XWZtbXg2KzSQGVIE' cloudFileMetadata_-_folder='root' cloudFileName='Tmart Strategic Scorecard Value.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/18qPXpug-6y3qlIgbvBCSvClMuG8XWZtbXg2KzSQGVIE/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Tmart Strategic Scorecard Value.xlsx' google-sheets-upgraded='true' interpretationMode='0' server='' server-oauth='server-custom' userLanguage='en' username='mohammad.mansoor@talabat.com' validate='no' workgroup-auth-mode='prompt' />
