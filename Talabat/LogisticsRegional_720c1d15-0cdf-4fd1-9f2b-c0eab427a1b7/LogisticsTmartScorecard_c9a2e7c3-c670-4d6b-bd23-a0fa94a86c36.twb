        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gariuq06gmzao132332v11ps6p3' name='Custom SQL Query' type='text'>with parameters as
(
select
date_add(date_trunc(current_date,month), interval -2 month) as date_start,
current_date as date_end,
)
, contact as (
SELECT distinct
lower(country_code) as country_code,
cast(order_id as integer) as order_id,
string_agg(distinct contact_reason_l3,&apos;; &apos;) contact_reasons,
FROM `tlb-data-prod.data_platform.fct_contact` c
left join `tlb-data-prod.data_platform.dim_contact_reason` cr on cr.contact_reason_id = c.contact_reason_id
left join `tlb-data-prod.data_platform.dim_contact_stakeholder` s on s.contact_stakeholder_id = c.stakeholder_id
cross join parameters
where contact_date_utc&gt;&gt;=date_start
and s.contact_stakeholder =&apos;Customer&apos;
and order_id is not null
group by 1,2
)
, splits as (
select
country_code,
entity_id,
order_id,
string_agg(distinct delivery_reason,&quot;,&quot;) reason_list,
count(distinct delivery_id) as no_of_delivery,
from `tlb-data-prod.data_platform.fct_logistics_delivery`
cross join parameters
where created_date&gt;&gt;=date_start
group by 1,2,3
)

, dispatch as (
SELECT distinct
country_code,
entity_id,
order_id,
undispatch_type,
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
cross join parameters
where created_date&gt;&gt;=date_start
and undispatch_type=&apos;manual_dispatch&apos;
)

, reassign as (
select distinct
country_code,
entity_id,
order_id,
max(no_of_accepted) as no_of_reassigned,
true as is_reassigned
from (
    SELECT 
    country_code,
    entity_id,
    order_id,
    delivery_id,
    count(state) as no_of_accepted
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date&gt;&gt;=date_start
    and state=&apos;accepted&apos;
    group by 1,2,3,4
    having count(state)&gt;&gt;1
)
group by 1,2,3
)

, acceptance as (
    SELECT distinct
    country_code,
    entity_id,
    order_id,
    count(case when state=&apos;courier_notified&apos; then state end) as notif_no,
    count(case when state=&apos;accepted&apos; then state end) as accepted_no, 
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery_transition`
    cross join parameters
    where created_date&gt;&gt;=date_start
    group by 1,2,3
)


, log_fail as (
select lower(country_Code) as country_code,
cast(order_id as int64) order_id,
if (lower(reason) in
(
  &apos;application issue / it&apos;,
&apos;cold food &amp; spilt delivery&apos;,
&apos;courier accident&apos;,
&apos;courier unreachable&apos;,
&apos;delivery eta too long&apos;,
&apos;do not deliver to this area&apos;,
&apos;failing to punch order (expired)&apos;,
&apos;failing to punch order (missed)&apos;,
&apos;lack of delivery men&apos;,
&apos;late delivery&apos;,
&apos;missing / wrong order&apos;,
&apos;never delivered&apos;,
&apos;no pickers&apos;,
&apos;reason unknown&apos;,
&apos;outside of service hours&apos;,
&apos;pos reason unknown&apos;,
&apos;too busy&apos;,
&apos;unavailable menu items&apos;,
&apos;unprofessional behaviour from the driver&apos;,
&apos;vendor closed&apos;,
&apos;vendor location is incorrect&apos;
), True, False) is_log_fail
  from `tlb-data-prod.data_platform.fct_order_info` foi 
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` AS ofr using(order_fail_reason_id)
  cross join parameters
  WHERE (foi.order_date)&gt;&gt;=date_start
  and lower(foi.country_iso) in (&apos;qa&apos;, &apos;om&apos;, &apos;jo&apos;, &apos;eg&apos;, &apos;ae&apos;, &apos;kw&apos;, &apos;bh&apos;, &apos;iq&apos;)
  and is_tgo

)


SELECT distinct
country_code,
city_name,
vendor_code,
vendor_name,
vertical_type,
date_trunc(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone), day) day,
order_status,
order_id,
actual_delivery_time/60 as DT,
hold_back_time/60 as HBT,
vendor_transmission_time/60 as transmission_time_min,
primary_dropoff_distance_manhattan/1000 as drop_off_distance_km,
accepted_no,
notif_no,
dispatching_time/60 as dispatching_time_min,
rider_late/60 as rider_late_min,
vendor_late/60 as vendor_late_min,
to_customer_time/60 as to_customer_time_min,
to_vendor_time/60 as to_vendor_time_min,
estimated_vendor_walk_in_duration/60 as vendor_walk_in_min,
rider_reaction_time/60 as rider_reaction_time,
(datetime_diff(picked_up_at,vendor_prepared_at,second)/60) as order_waiting_time_min,
order_delay/60 as order_delay_min,
rider_reaction_time/60 as acceptance_time_min,
contact_reasons,
case when reason_list like &apos;%Big order/split order%&apos; then true else false end as is_split_orders,
case when primary_stacked_count&gt;&gt;=1 then true else false end as is_stacked,
case when primary_stacked_count=2 then true else false end as is_double_stacked,
case when contact.contact_reasons like &apos;%Missing item%&apos; then true else false end as is_missing_item,
estimated_prep_time/60 as estimated_prep_time_min,
estimated_prep_buffer/60 as estimated_prep_buffer_min,
case when undispatch_type=&apos;manual_dispatch&apos; then true else false end as is_manual_dispatch,
assumed_actual_preparation_time/60 as assumed_actual_prep_time_min,
at_vendor_time_cleaned/60 as avtc_min,
at_vendor_time/60 as avt_min,
is_log_fail,
case when is_log_fail is not null then true else false end as is_part_of_log_fail

FROM `tlb-data-prod.data_platform.fct_logistics_order`
left join `tlb-data-prod.data_platform.dim_logistics_vendor` using(country_code, entity_id, vendor_code, city_id)
left join contact using(country_code, order_id)
left join splits using(entity_id, country_code, order_id)
left join dispatch using(entity_id, country_code, order_id)
left join reassign using(entity_id, country_code, order_id)
left join acceptance using(entity_id, country_code, order_id)
left join log_fail using(country_code, order_id)
left join (select city_id, city_name, country_code from `tlb-data-prod.data_platform.dim_logistics_city` where is_active) using(country_code, city_id)
cross join parameters
where created_date&gt;&gt;=date_start
and country_code IN (&apos;qa&apos;, &apos;om&apos;, &apos;jo&apos;, &apos;eg&apos;, &apos;ae&apos;, &apos;kw&apos;, &apos;bh&apos;, &apos;iq&apos;)
and (lower(vendor_name) like &apos;%talabat mart%&apos; or lower(vendor_name) like &apos;tmart%&apos;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
