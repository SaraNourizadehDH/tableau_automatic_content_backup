            <column caption='Value' datatype='string' name='[Calculation_4564609379483791364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case  ([measures])&#10;    when &apos;DT [min]&apos; then left(str(round((value),5)),4)&#10;    when &apos;DT 75th pct [%]&apos; then left(str(round((value),5)),4)&#10;    when &apos;DT&lt;20 [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;DT&lt;30 [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;CR - Logistics [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;FR - Logistics [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;CR- Missing Items [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;Split [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;Stacked [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;Manual dispatched orders [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;Reassigned orders [%]&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;    when &apos;Assumed actual prep time [min]&apos; then left(str(round((value),5)),4)&#10;    when &apos;At vendor time cleaned [min]&apos; then left(str(round((value),5)),4)&#10;    when &apos;DF (LC)&apos; then left(str(round((value),5)),4)&#10;    when &apos;DF as % of food GMV (%)&apos; then left(str(round((value*100),5)),4)+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='value proper' datatype='real' name='[Calculation_4564609379488247816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case  ([measures])&#10;    when &apos;DT [min]&apos; then [value]*-1&#10;    when &apos;DT 75th pct [%]&apos; then [value]*-1&#10;    when &apos;DT&lt;20 [%]&apos; then [value]&#10;    when &apos;DT&lt;30 [%]&apos; then [value]&#10;    when &apos;CR - Logistics [%]&apos; then [value]*-1&#10;    when &apos;FR - Logistics [%]&apos; then [value]*-1&#10;    when &apos;CR - Logistics [%]&apos; then [value]*-1&#10;    when &apos;Split [%]&apos; then [value]*-1&#10;    when &apos;Stacked [%]&apos; then [value]*-1&#10;    when &apos;Manual dispatched orders [%]&apos; then [value]*-1&#10;    when &apos;Reassigned orders [%]&apos; then [value]*-1&#10;    when &apos;FIR [min]&apos; then [value]*-1&#10;    when &apos;At vendor time cleaned [min]&apos; then [value]*-1&#10;    when &apos;DF (LC)&apos; then [value]&#10;    when &apos;DF as % of food GMV (%)&apos; then [value]&#10;else null&#10;end' />
            </column>
            <column caption='(ZN(SUM([value proper])) - LOOKUP(ZN(SUM([value proper])), -1...' datatype='real' name='[Calculation_4564609379491536907]' role='measure' type='quantitative' user:unnamed='last 4 weeks'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_4564609379488247816])) - LOOKUP(ZN(SUM([Calculation_4564609379488247816])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_4564609379488247816])), -1))'>
