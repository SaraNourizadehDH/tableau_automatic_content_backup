        <column caption='Metrics to compare' datatype='string' name='[Metrics 2 (copy)_2027675429600456761]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rider notification term [min]&quot;'>
          <calculation class='tableau' formula='&quot;Rider notification term [min]&quot;' />
