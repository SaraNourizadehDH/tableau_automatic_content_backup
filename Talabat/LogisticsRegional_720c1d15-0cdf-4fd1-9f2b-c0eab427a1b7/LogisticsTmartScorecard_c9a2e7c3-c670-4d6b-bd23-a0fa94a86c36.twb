            <column caption='DT &lt; 10 [%]' datatype='real' name='[DT 75th percentile [%]] (copy)_2027675428981141511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [DT]&lt;10 then [order_id] else null end)/countd(if not ISNULL([DT]) then [order_id] else null end)' />
