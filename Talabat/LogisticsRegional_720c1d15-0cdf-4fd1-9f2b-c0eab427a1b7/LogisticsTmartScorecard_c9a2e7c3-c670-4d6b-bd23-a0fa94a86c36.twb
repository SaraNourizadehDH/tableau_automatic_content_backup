      <column caption='Measure alias' datatype='string' name='[value display (copy)_3051259164753424386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case  ([measures])&#10;    when &apos;DT [min]&apos; then &apos;DT&apos;&#10;    when &apos;DT 75th pct [%]&apos; then &apos;DT P75&apos;&#10;    when &apos;DT&lt;20 [%]&apos; then &apos;DT&lt;20&apos;&#10;    when &apos;DT&lt;30 [%]&apos; then &apos;DT&lt;30&apos;&#10;    when &apos;CR - Logistics [%]&apos; then &apos;CR-log&apos;&#10;    when &apos;FR - Logistics [%]&apos; then &apos;FR-log&apos;&#10;    when &apos;CR- Missing Items [%]&apos; then &apos;CRMI&apos;&#10;    when &apos;Split [%]&apos; then &apos;split&apos;&#10;    when &apos;Stacked [%]&apos; then &apos;stacked&apos;&#10;    when &apos;Manual dispatched orders [%]&apos; then &apos;ManualDisp&apos;&#10;    when &apos;FIR [min]&apos; then &apos;FIR&apos;&#10;    when &apos;Reassigned orders [%]&apos; then &apos;ReaOrder&apos;&#10;    when &apos;At vendor time cleaned [min]&apos; then &apos;AVTC&apos;&#10;    when &apos;Vendor Late &gt; 10 mins [%]&apos; then &apos;VendorLate&gt;10min&apos;&#10;    when &apos;Rider Late &gt; 10 mins [%]&apos; then &apos;RiderLate&gt;10min&apos;&#10;else null&#10;end' />
        <aliases>
          <alias key='%null%' value='FIR ' />
