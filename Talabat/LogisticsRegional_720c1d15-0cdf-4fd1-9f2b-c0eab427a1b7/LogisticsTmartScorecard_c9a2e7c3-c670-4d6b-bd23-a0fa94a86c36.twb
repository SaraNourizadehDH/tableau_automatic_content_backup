    <datasource caption='Ops scorecard data' inline='true' name='federated.12iship0uksr0a16i10930okro14' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1gariuq06gmzao132332v11ps6p3'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='mohammad.mansoor@talabat.com' workgroup-auth-mode='prompt' />
