      <datasource-dependencies datasource='Parameters'>
        <column caption='Metrics 2' datatype='string' name='[Metrics (copy 2)_2027675429582729271]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order On Time [\%]&quot;'>
          <calculation class='tableau' formula='&quot;Order On Time [%]&quot;' />
