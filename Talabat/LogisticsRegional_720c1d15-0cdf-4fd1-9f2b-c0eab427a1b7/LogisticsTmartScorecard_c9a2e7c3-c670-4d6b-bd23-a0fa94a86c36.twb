            <column caption='Metric 1' datatype='real' name='[Calculation_2027675429002952753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Primary value (copy)]&#10;when &apos;Orders Completed [NO.]&apos; then [Failed Orders [NO.]] (copy)_2027675428985577498]&#10;when &apos;Fail Rate [%]&apos; then [Contact rate [%]] (copy)_2027675428984700947]&#10;when &apos;Failed Orders [NO.]&apos; then [Fail Rate [%]] (copy)_2027675428984971285]&#10;when &apos;Acceptance Rate [%]&apos; then [Failed Orders [NO.]] (copy)_2027675428985663515]&#10;when &apos;Contact rate [%]&apos; then [Transmission time [min]] (copy)_2027675428984086545]&#10;when &apos;Drop Off Distance Manhattan [KM]&apos; then [DT [min]] (copy)_2027675428984602642]&#10;when &apos;Split orders [%]&apos; then [Fail Rate [%]] (copy)_2027675428988985381]&#10;when &apos;Stacked orders (Double) [%]&apos; then [Stacked Orders [%]] (copy)_2027675428989300776]&#10;when &apos;Stacked Orders [%]&apos; then [Split orders [%]] (copy)_2027675428989095974]&#10;when &apos;Stacked Orders [NO.]&apos; then [Stacked Orders [%]] (copy)_2027675428989194279]&#10;when &apos;DT [min]&apos; then [Calculation_2027675428980469760]&#10;when &apos;Order On Time [%]&apos; then [Order Late &gt; 5 [%]]  (copy)_2027675428985384985]&#10;when &apos;Order Early &gt; 10 [%]&apos; then [DT &lt; 10 [%]] (copy)_2027675428985110550]&#10;when &apos;Order Late &gt; 10 [%]&apos; then [Order Early &gt; 10 [%]] (copy)_2027675428985241623]&#10;when &apos;Order Late &gt; 5 [%]&apos; then [Order Late &gt; 10 [%]] (copy)_2027675428985311256]&#10;when &apos;DT &lt; 10 [%]&apos; then [DT 75th percentile [%]] (copy)_2027675428981141511]&#10;when &apos;DT &lt; 15 [%]&apos; then [DT &lt; 10 [%]] (copy)_2027675428982702088]&#10;when &apos;DT &lt; 20 [%]&apos; then [DT &lt; 15 [%]]  (copy)_2027675428983410697]&#10;when &apos;DT &lt; 30 [%]&apos; then [DT &lt; 15 [%]]  (copy) (copy)_2027675428983427082]&#10;when &apos;DT &gt; 45 [%]&apos; then [DT &lt; 30 [%]]  (copy)_2027675428983644173]&#10;when &apos;DT &gt; 60 [%]&apos; then [DT &lt; 45 [%]] (copy)_2027675428983721998]&#10;when &apos;DT 50th percentile [%]&apos; then [DT [min]] (copy)_2027675428980568065]&#10;when &apos;DT 75th percentile [%]&apos; then [DT 50th percentile [%]] (copy)_2027675428980715522]&#10;when &apos;DT - 90th percentile [%]&apos; then [DT 50th percentile [%]] (copy) (copy 2)_2027675428980785157]&#10;when &apos;DT - 95th percentile [%]&apos; then [DT 50th percentile [%]] (copy) (copy)_2027675428980727811]&#10;when &apos;DT - 99th percentile [%]&apos; then [DT - 95th percentile [%]] (copy)_2027675428981022726]&#10;when &apos;Rider Late &gt; 10 [%]&apos; then [Order Late &gt; 10 [%]] (copy)_2027675428988321823]&#10;when &apos;Rider Late &gt; 5 [%]&apos; then [Rider Late &gt; 10 [%]] (copy)_2027675428988432416]&#10;when &apos;Vendor Late &gt; 10 [%]&apos; then [Vendor Late &gt; 5 [%]] (copy)_2027675428996665392]&#10;when &apos;Vendor Late &gt; 5 [%]&apos; then [Rider Late &gt; 10 [%]] (copy)_2027675428989829166]&#10;when &apos;Dispatching time [min]&apos; then [Transmission time [min]] (copy)_2027675428986822685]&#10;when &apos;Rider notification term [min]&apos; then [Transmission time [min]] (copy)_2027675428986597404]&#10;when &apos;Rider acceptance term [min]&apos; then [Transmission time [min]] (copy)_2027675428988260382]&#10;when &apos;To vendor time [min]&apos; then [To customer time [min]] (copy)_2027675428988665890]&#10;when &apos;Vendor Walk in Time [min]&apos; then [To vendor time [min]] (copy)_2027675428988817443]&#10;when &apos;At vendor time [min]&apos; then [Vendor Walk in Time [min]] (copy)_2027675428989448234]&#10;when &apos;At Vendor Time Cleaned [min]&apos; then [At vendor time [min]] (copy)_2027675428989534251]&#10;when &apos;Avg. order waiting time [min]&apos; then [Vendor Walk in Time [min]] (copy)_2027675428988870692]&#10;when &apos;Transmission time [min]&apos; then [Hold Back Time [min]] (copy)_2027675428983980048]&#10;when &apos;Hold Back Time [min]&apos; then [DT [min]] (copy)_2027675428983889935]&#10;when &apos;Assumed Actual Prep Time [min]&apos; then [Transmission time [min]] (copy)_2027675428989378601]&#10;when &apos;Est. Prep Buffer [min]&apos; then [Avg. order waiting time [min]] (copy)_2027675428989595692]&#10;when &apos;Est. Prep Time [min]&apos; then [Est. Prep Buffer [min]] (copy)_2027675428989648941]&#10;when &apos;To customer time [min]&apos; then [Rider notification term [min]] (copy)_2027675428988583969]&#10;when &apos;Fail rate - Logistics [%]&apos; then [Fail Rate [%]] (copy)_2027675429574619187]&#10;when &apos;[No comparison]&apos; then null&#10;end' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_2027675429577515060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Metrics (copy)] when &apos;Day&apos; then str([day])&#10;when &apos;Week&apos; then str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;iso-week&apos;,[day])))+&quot;-W&quot;+str(isoweek(DATE(DATETRUNC(&apos;iso-week&apos;,[day]))))&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;month&apos;,[day])))+&quot;-&quot;+STR(month(DATETRUNC(&apos;month&apos;,[day])))&#10;&#10;end' />
