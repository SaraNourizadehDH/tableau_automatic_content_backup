      <column caption='Color threshold' datatype='string' name='[color (copy)_4564609379735392268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([value display (copy)_3051259164755087363]) then &apos;no data&apos;&#10;elseif [value display (copy)_3051259164755087363]&lt;80 then &apos;need attention (below threshold)&apos;&#10;elseif [value display (copy)_3051259164755087363]&gt;=80 and [value display (copy)_3051259164755087363]&lt;100 then &apos;Fair (almost above threshold)&apos;&#10;elseif [value display (copy)_3051259164755087363]&gt;=100 then &apos;good (above threshold)&apos;&#10;end' />
