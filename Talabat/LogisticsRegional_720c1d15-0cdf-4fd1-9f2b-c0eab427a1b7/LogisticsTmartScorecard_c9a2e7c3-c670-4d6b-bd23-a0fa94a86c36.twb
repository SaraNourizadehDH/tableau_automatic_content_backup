      <datasource-dependencies datasource='Parameters'>
        <column caption='Primary value' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Score&quot;'>
          <calculation class='tableau' formula='&quot;Score&quot;' />
        </column>
        <column caption='Secondary value' datatype='string' name='[Value to show (copy)_3051259164767047688]' param-domain-type='list' role='measure' type='nominal' value='&quot;n/a&quot;'>
