    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/tMart-Jordan/Glossary?rev=' id='Glossary' path='/t/Talabat/workbooks/tMart-Jordan' revision='' site='Talabat' />
      <style />
      <size maxheight='1300' maxwidth='1300' minheight='1300' minwidth='1300' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='4923' id='3' type-v2='text' w='98770' x='615' y='615'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>tMart - Jordan</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Glossary</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#e9652b' />
            </zone-style>
          </zone>
          <zone h='93847' id='5' param='vert' type-v2='layout-flow' w='98770' x='615' y='5538'>
            <zone fixed-size='615' forceUpdate='true' h='47923' id='6' is-fixed='true' type-v2='text' w='98770' x='615' y='5538'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='12'>Tabs</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>- Average Metrics </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>The metrics on this tab show</run>
                <run bold='true' fontcolor='#000000' fontsize='10'> average values</run>
                <run fontcolor='#000000' fontsize='10'>. In this tab, calculations are dynamic so the values will be recalculated according to selected filters.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>-Percentile Metrics</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>The metrics on this tab show</run>
                <run bold='true' fontcolor='#000000' fontsize='10'> percentile values</run>
                <run fontcolor='#000000' fontsize='10'>.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='12'>Filters</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>1. Time Granularity</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Average Metrics)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>What it does:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>This parameter lets you choose the </run>
                <run bold='true' fontcolor='#000000'>time scale</run>
                <run fontcolor='#000000'> used in the average calculations and visualizations:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Day → Averages are calculated per day</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Week → Averages are calculated by week</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Month → Averages are calculated by month</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>2. View </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>What it does</run>
                <run fontcolor='#000000'>: Switches between viewing metrics at different levels:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Country → Shows pre-calculated country-level values</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>City → Shows pre-calculated city-level values</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Store → Shows pre-calculated store-level values</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Important</run>
                <run fontcolor='#000000'>: These values are </run>
                <run bold='true' fontcolor='#000000'>pre-calculated</run>
                <run fontcolor='#000000'> and </run>
                <run bold='true' fontcolor='#000000'>do not change</run>
                <run fontcolor='#000000'> based on filters (e.g., filtering to specific stores will not recalculate country-level numbers).</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>3. Percentile </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>What it does</run>
                <run fontcolor='#000000'>: Switches the percentile metric shown across the dashboard.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Percentile 75 → Shows the 75th percentile</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Percentile 90 → Shows the 90th percentile</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>How it works</run>
                <run fontcolor='#000000'>: Like the view filter, these values are </run>
                <run bold='true' fontcolor='#000000'>pre-aggregated</run>
                <run fontcolor='#000000'>, so they simply display the appropriate pre-calculated P75 or P90 value for the chosen view.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>4. City and Store Filters </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>What they do</run>
                <run fontcolor='#000000'>: Help you quickly </run>
                <run bold='true' fontcolor='#000000'>navigate</run>
                <run fontcolor='#000000'> to specific cities or stores — especially helpful when you&apos;re viewing </run>
                <run bold='true' fontcolor='#000000'>City</run>
                <run fontcolor='#000000'> or </run>
                <run bold='true' fontcolor='#000000'>Store</run>
                <run fontcolor='#000000'> level data.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Important</run>
                <run fontcolor='#000000'>:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>These filters </run>
                <run bold='true' fontcolor='#000000'>do not recalculate</run>
                <run fontcolor='#000000'> P75 or P90 at </run>
                <run bold='true' fontcolor='#000000'>higher levels (like Country)</run>
                <run fontcolor='#000000'>.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>They are intended for </run>
                <run bold='true' fontcolor='#000000'>navigation</run>
                <run fontcolor='#000000'>, not for slicing the data at the aggregate level.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>(e.g. </run>
                <run bold='true' fontcolor='#000000'>Country view</run>
                <run fontcolor='#000000'>, the country-level P75/P90 will </run>
                <run bold='true' fontcolor='#000000'>not</run>
                <run fontcolor='#000000'> reflect just those filtered stores — it remains fixed.)</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='45924' id='17' name='Metric Glossary' show-title='false' w='98770' x='615' y='53461'>
              <layout-cache fixed-size-h='781' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='23' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98770' id='22' param='vert' type-v2='layout-flow' w='98770' x='615' y='615'>
                <zone forceUpdate='true' h='4923' id='3' type-v2='text' w='98770' x='615' y='615'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>tMart - Jordan</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Glossary</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#e9652b' />
                  </zone-style>
                </zone>
                <zone fixed-size='615' forceUpdate='true' h='47923' id='6' type-v2='text' w='98770' x='615' y='5538'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Tabs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>- Average Metrics </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>The metrics on this tab show</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'> average values</run>
                    <run fontcolor='#000000' fontsize='10'>. In this tab, calculations are dynamic so the values will be recalculated according to selected filters.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>-Percentile Metrics</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>The metrics on this tab show</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'> percentile values</run>
                    <run fontcolor='#000000' fontsize='10'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Filters</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>1. Time Granularity</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Average Metrics)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What it does:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>This parameter lets you choose the </run>
                    <run bold='true' fontcolor='#000000'>time scale</run>
                    <run fontcolor='#000000'> used in the average calculations and visualizations:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Day → Averages are calculated per day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Week → Averages are calculated by week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Month → Averages are calculated by month</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>2. View </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What it does</run>
                    <run fontcolor='#000000'>: Switches between viewing metrics at different levels:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Country → Shows pre-calculated country-level values</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>City → Shows pre-calculated city-level values</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Store → Shows pre-calculated store-level values</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>Important</run>
                    <run fontcolor='#000000'>: These values are </run>
                    <run bold='true' fontcolor='#000000'>pre-calculated</run>
                    <run fontcolor='#000000'> and </run>
                    <run bold='true' fontcolor='#000000'>do not change</run>
                    <run fontcolor='#000000'> based on filters (e.g., filtering to specific stores will not recalculate country-level numbers).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>3. Percentile </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What it does</run>
                    <run fontcolor='#000000'>: Switches the percentile metric shown across the dashboard.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Percentile 75 → Shows the 75th percentile</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Percentile 90 → Shows the 90th percentile</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>How it works</run>
                    <run fontcolor='#000000'>: Like the view filter, these values are </run>
                    <run bold='true' fontcolor='#000000'>pre-aggregated</run>
                    <run fontcolor='#000000'>, so they simply display the appropriate pre-calculated P75 or P90 value for the chosen view.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>4. City and Store Filters </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>(Tab:Percentile Metrics)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What they do</run>
                    <run fontcolor='#000000'>: Help you quickly </run>
                    <run bold='true' fontcolor='#000000'>navigate</run>
                    <run fontcolor='#000000'> to specific cities or stores — especially helpful when you&apos;re viewing </run>
                    <run bold='true' fontcolor='#000000'>City</run>
                    <run fontcolor='#000000'> or </run>
                    <run bold='true' fontcolor='#000000'>Store</run>
                    <run fontcolor='#000000'> level data.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>Important</run>
                    <run fontcolor='#000000'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>These filters </run>
                    <run bold='true' fontcolor='#000000'>do not recalculate</run>
                    <run fontcolor='#000000'> P75 or P90 at </run>
                    <run bold='true' fontcolor='#000000'>higher levels (like Country)</run>
                    <run fontcolor='#000000'>.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>They are intended for </run>
                    <run bold='true' fontcolor='#000000'>navigation</run>
                    <run fontcolor='#000000'>, not for slicing the data at the aggregate level.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>(e.g. </run>
                    <run bold='true' fontcolor='#000000'>Country view</run>
                    <run fontcolor='#000000'>, the country-level P75/P90 will </run>
                    <run bold='true' fontcolor='#000000'>not</run>
                    <run fontcolor='#000000'> reflect just those filtered stores — it remains fixed.)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='45924' id='17' is-fixed='true' name='Metric Glossary' show-title='false' w='98770' x='615' y='53461'>
                  <layout-cache fixed-size-h='781' type-h='fixed' type-w='fixed' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{90982084-BD19-4E1B-A688-DCD1AC112201}' />
