      <table>
        <view>
          <datasources>
            <datasource caption='tMart - Jordan' name='federated.0yq2d0i0debgl119s12eu0x855d5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Percentile' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;90th Percentile&quot;'>
              <calculation class='tableau' formula='&quot;90th Percentile&quot;' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yq2d0i0debgl119s12eu0x855d5'>
            <column caption='UTR' datatype='real' name='[% Idle Time (copy)_1252352555567931447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [city], [order_date]:MAX([utr_order_count])})/&#10;SUM({ FIXED [city], [order_date]:MAX([working_time_mins]/60)})' />
            </column>
            <column caption='%Orders Late&gt;10 Mins' datatype='real' name='[%DT&lt;25 Mins (copy)_1252352555547897903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10_mins])/SUM([order_count])' />
            </column>
            <column caption='%Orders Late&gt;5 Mins' datatype='real' name='[%Order Late&gt;10 Mins (copy)_1252352555547992112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_5_mins])/SUM([order_count])' />
            </column>
            <column caption='%Orders Late&gt;15 Mins' datatype='real' name='[%Order Late&gt;5 Mins (copy)_1252352555548061745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_15_mins])/SUM([order_count])' />
            </column>
            <column caption='%Orders - On Time' datatype='real' name='[%Order Late&gt;5 Mins (copy)_1252352555548250162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_order_count])/SUM([order_count])' />
            </column>
            <column caption='%Stacking' datatype='real' name='[%Orders - On Time (copy)_1252352555549691957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_order_count])/SUM([order_count])' />
            </column>
            <column caption='%Vendor Delay v2 &gt;10 Mins' datatype='real' name='[%Orders Late&gt;15 Mins (copy)_1252352555548839987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_v2_10_mins])/SUM([order_count])' />
            </column>
            <column caption='%Vendor Delay v2 &gt;5 Mins' datatype='real' name='[%Vendor Delay v2 &gt;10 Mins (copy)_1252352555548966964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_v2_5_mins])/SUM([order_count])' />
            </column>
            <column caption='Avg. DT' datatype='real' name='[Avg. AVT (copy)_1252352555542016030]' role='measure' type='quantitative'>
