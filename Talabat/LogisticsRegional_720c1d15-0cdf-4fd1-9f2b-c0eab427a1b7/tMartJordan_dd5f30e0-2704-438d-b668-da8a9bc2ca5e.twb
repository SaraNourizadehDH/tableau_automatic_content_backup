    percentile_cont(rd.rdt_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rdt_mins_p90_vendor_day,
    percentile_cont(rd.rat_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rat_mins_p90_vendor_day,
    percentile_cont(rd.rrv_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rrv_mins_p90_vendor_day,
    percentile_cont(rd.pickup_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS pickup_mins_p90_vendor_day,
    percentile_cont(rd.total_prep_time,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS total_prep_time_p90_vendor_day,
    percentile_cont(rd.store_dispatch_time,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS store_dispatch_time_p90_vendor_day,
    percentile_cont(rd.assignment_time_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS assignment_time_mins_p90_vendor_day,
