  p.rdt_mins_p90_vendor_day,
  p.rat_mins_p90_vendor_day,
  p.rrv_mins_p90_vendor_day,
  p.pickup_mins_p90_vendor_day,
  p.total_prep_time_p90_vendor_day,
  p.store_dispatch_time_p90_vendor_day,
  p.assignment_time_mins_p90_vendor_day,
  p.picking_time_mins_p90_vendor_day,
  p.packaging_time_mins_p90_vendor_day,
  p.ept_mins_p75_city_day,
  p.fir_mins_p75_city_day,
  p.tvt_mins_p75_city_day,
  p.avt_mins_p75_city_day,
  p.avtc_mins_p75_city_day,
  p.tct_mins_p75_city_day,
  p.pdt_mins_p75_city_day,
  p.adt_mins_p75_city_day,
  p.rdt_mins_p75_city_day,
  p.rat_mins_p75_city_day,
  p.rrv_mins_p75_city_day,
