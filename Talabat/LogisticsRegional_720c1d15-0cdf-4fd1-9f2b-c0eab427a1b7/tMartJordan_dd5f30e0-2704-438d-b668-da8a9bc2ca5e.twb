---p90,country,day
    percentile_cont(rd.ept_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS ept_mins_p90_country_day,
    percentile_cont(rd.fir_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS fir_mins_p90_country_day,
    percentile_cont(rd.tvt_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS tvt_mins_p90_country_day,
