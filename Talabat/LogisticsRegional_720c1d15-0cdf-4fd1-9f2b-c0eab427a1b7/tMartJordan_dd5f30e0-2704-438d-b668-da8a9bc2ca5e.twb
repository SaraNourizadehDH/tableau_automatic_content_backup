    percentile_cont(rd.adt_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS adt_mins_p90_country_day,
    percentile_cont(rd.rdt_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS rdt_mins_p90_country_day,
    percentile_cont(rd.rat_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS rat_mins_p90_country_day,
    percentile_cont(rd.rrv_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS rrv_mins_p90_country_day,
    percentile_cont(rd.pickup_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS pickup_mins_p90_country_day,
    percentile_cont(rd.total_prep_time,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS total_prep_time_p90_country_day,
    percentile_cont(rd.store_dispatch_time,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS store_dispatch_time_p90_country_day,
    percentile_cont(rd.assignment_time_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS assignment_time_mins_p90_country_day,
    percentile_cont(rd.picking_time_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS picking_time_mins_p90_country_day,
    percentile_cont(rd.packaging_time_mins,0.90) OVER (PARTITION BY rd.country_code, rd.order_date) AS packaging_time_mins_p90_country_day,
  FROM rd
),
utr_timings AS 
(

  SELECT 
    country_code,
    lower(city_name) AS city_name,
    date(rider_dropped_off_at,timezone) AS report_date,
    sum(idle_time/60 )                       AS idle_time_mins,
    sum((reaction_time+to_vendor_time+at_vendor_time+to_customer_time+at_customer_time+idle_time)/60) as working_time_mins,
    count(DISTINCT order_id)            AS utr_order_count
  FROM `fulfillment-dwh-production.curated_data_shared.utr_timings` u 
    WHERE created_date>>= '2025-01-01'
      AND country_code='jo' 
      AND date(rider_dropped_off_at,timezone)>>='2025-04-01'
        GROUP BY ALL
)

SELECT
