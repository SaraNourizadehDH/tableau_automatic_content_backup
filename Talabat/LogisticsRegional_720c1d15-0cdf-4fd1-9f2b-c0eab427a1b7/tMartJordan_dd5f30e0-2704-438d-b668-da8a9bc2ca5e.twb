    percentile_cont(rd.picking_time_mins,0.90) OVER (PARTITION BY rd.country_code, city,rd.order_date) AS picking_time_mins_p90_city_day,
    percentile_cont(rd.packaging_time_mins,0.90) OVER (PARTITION BY rd.country_code, city,rd.order_date) AS packaging_time_mins_p90_city_day,
---p75,country,day
