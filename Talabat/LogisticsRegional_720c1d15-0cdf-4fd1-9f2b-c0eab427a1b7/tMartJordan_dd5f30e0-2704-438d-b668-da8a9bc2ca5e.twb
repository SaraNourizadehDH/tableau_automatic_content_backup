              <calculation class='tableau' formula='MAX(IF [Parameters].[Parameter 1]=&apos;75th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;Country&apos; THEN [pdt_mins_p75_country_day]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;75th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;City&apos; THEN [pdt_mins_p75_city_day]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;75th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;Store&apos; THEN [pdt_mins_p75_vendor_day]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;Country&apos; THEN [pdt_mins_p90_country_day]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;City&apos; THEN [pdt_mins_p90_city_day]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90th Percentile&apos; AND [Parameters].[Parameter 2]=&apos;Store&apos; THEN [pdt_mins_p90_vendor_day] END)' />
