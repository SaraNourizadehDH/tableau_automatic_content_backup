      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tMart - Jordan' id='_28A7F68B16354AF3BFF09F1E6C0EE516'>
            <properties context=''>
              <relation connection='bigquery.07lcx5k156ttdq1fhoar21jy1b5r' name='Custom SQL Query' type='text'><![CDATA[------------------------------------------------------------------------------------------------
---------------------Jordan tMart---------------------------------------------------
------------------------------------------------------------------------------------------------
WITH vendor_info AS 
(
  SELECT 
    dvi.vendor_id,
    dvi2.parent_vendor_id,
    dvi2.vendor_name,
    dvi.country_code,
    dli.city_name as city,
  FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
  LEFT JOIN ( SELECT 
                parent_vendor_id,
                vendor_name,
                country_code
            FROM `tlb-data-prod.data_platform.dim_vendor_info`
            WHERE 1=1
              AND is_darkstore
              AND parent_vendor_id - vendor_id = 0
              AND country_code = 'JO'
  )AS dvi2 ON dvi.parent_vendor_id = dvi2.parent_vendor_id AND dvi.country_code=dvi2.country_code
  WHERE  dvi.country_code = 'JO'
    AND dvi.is_darkstore 
),

base AS 
(
  SELECT 
  --order level data  
    o.country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.vendor.vertical_type,
    o.order_id,
    o.platform_order_code,
    date(o.created_at,o.timezone)                                       AS order_date,
    "wait_for_assembled" IN UNNEST(tags)                                AS is_grocery_flow,
    o.estimated_prep_time/60                                            AS ept_mins,
    timestamp_diff(o.food_is_ready_at,o.sent_to_vendor_at,second)/60    AS fir_mins,
    o.timings.to_vendor_time/60                                         AS tvt_mins,
    o.timings.at_vendor_time/60                                         AS avt_mins,
    o.timings.at_vendor_time_cleaned/60                                 AS avtc_mins,
    o.timings.to_customer_time/60                                       AS tct_mins,
    o.timings.promised_delivery_time/60                                 AS pdt_mins,
    o.timings.actual_delivery_time/60                                   AS adt_mins,
    o.timings.order_delay/60                                            AS order_late_mins,
    o.timings.order_delay/60  BETWEEN -10 AND 10                        AS on_time,
  --delivery level data
    d.is_stacked_intravendor                                            AS is_stacked,
    timestamp_diff(d.rider_dispatched_at,o.created_at,second)/60        AS rdt_mins,
    timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)/60 AS rat_mins,
    timestamp_diff(d.rider_picked_up_at,o.created_at,second)/60         AS pickup_mins,
    (timestamp_diff(d.rider_dispatched_at,o.created_at,second)+timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)+o.timings.to_vendor_time)/60                 AS rrv_mins,
    v.vendor_name,
    city
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  WHERE o.created_date >>= '2025-03-31'
    AND o.entity.id = 'TB_JO'
    AND d.is_primary
    AND d.is_returning IS FALSE
    AND d.is_redelivery IS FALSE
    AND o.order_status='completed'
    AND d.delivery_status='completed'
),

o AS
(
  SELECT 
    o.order_id,
    o.order_code,
    o.country_code,
    o.vendor_delay_v2/60            AS vendor_delay_v2_mins
  FROM `tlb-data-prod.data_platform.fct_logistics_order` o
    WHERE created_date >>= '2025-03-31'
      AND o.entity_id='TB_JO'
      AND o.is_talabat
      AND o.is_rider_order
      AND NOT o.is_logistics_preorder
),
picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    lower(pickers.country_code) AS country_code,
    assignment_time_seconds/60 AS assignment_time_mins,
    picking_time_seconds/60 AS picking_time_mins,
    packaging_time_seconds/60 AS packaging_time_mins,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as total_prep_time,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
  WHERE created_date>>='2025-03-31'
    AND global_entity_id = 'TB_JO'
),
rd AS 
(
  SELECT
    rd.*,
    p.order_id AS order_id_p,
    p.total_prep_time,
    p.store_dispatch_time,
    p.assignment_time_mins,
    p.picking_time_mins,
    p.packaging_time_mins,
    o.vendor_delay_v2_mins
  FROM base rd
  LEFT JOIN picking_data p ON rd.country_code=p.country_code AND rd.platform_order_code=cast(p.order_id AS string)
  LEFT JOIN o  ON rd.country_code=o.country_code AND rd.platform_order_code=o.order_code
    WHERE rd.order_date BETWEEN '2025-04-01' AND (current_date()-1)
),
agg AS 
(
  SELECT 
    rd.country_code,
    rd.city,
    vendor_name,
    order_date,
    date_trunc(order_date,month) order_month,
    date_trunc(order_date,isoweek) order_week,
    is_grocery_flow,
    rd.is_stacked,
    count(DISTINCT rd.order_id) AS order_count_d,
    count(rd.order_id) AS order_count,
    count(CASE WHEN is_stacked THEN rd.order_id END) AS stacked_order_count,
    count(CASE WHEN on_time THEN rd.order_id END) AS on_time_order_count,
    count(CASE WHEN vendor_delay_v2_mins>>5 THEN rd.order_id END) AS vendor_delay_v2_5_mins,
    count(CASE WHEN vendor_delay_v2_mins>>10 THEN rd.order_id END) AS vendor_delay_v2_10_mins,
    count(CASE WHEN order_late_mins>>5 THEN rd.order_id END) AS order_late_5_mins,
    count(CASE WHEN order_late_mins>>10 THEN rd.order_id END) AS order_late_10_mins,
    count(CASE WHEN order_late_mins>>15 THEN rd.order_id END) AS order_late_15_mins,
    count(CASE WHEN rd.adt_mins<<25 THEN rd.order_id END) AS dt_25_mins,
    sum(rd.ept_mins) AS ept_mins,
    sum(rd.fir_mins) AS fir_mins,
    sum(rd.tvt_mins) AS tvt_mins,
    sum(rd.avt_mins) AS avt_mins,
    sum(rd.avtc_mins) AS avtc_mins,
    sum(rd.tct_mins) AS tct_mins,
    sum(rd.pdt_mins) AS pdt_mins,
    sum(rd.adt_mins) AS adt_mins,
    sum(rd.rdt_mins) AS rdt_mins, 
    sum(rd.rat_mins) AS rat_mins, 
    sum(rd.rrv_mins) AS rrv_mins, 
    sum(rd.pickup_mins) AS pickup_mins, 
    count(rd.order_id_p) AS picking_order_count,
    sum(rd.total_prep_time) AS total_prep_time,
    sum(rd.store_dispatch_time) AS store_dispatch_time,
    sum(rd.assignment_time_mins) AS assignment_time_mins,
    sum(rd.picking_time_mins) AS picking_time_mins,
    sum(rd.packaging_time_mins) AS packaging_time_mins,
  FROM rd
    GROUP BY ALL
),
perc AS 
(
  SELECT DISTINCT
    rd.country_code,
    rd.city,
    rd.vendor_name,
    rd.order_date,
    date_trunc(rd.order_date,month) order_month,
    date_trunc(rd.order_date,isoweek) order_week,
    rd.is_grocery_flow,
---p75,vendor,day
    percentile_cont(rd.ept_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS ept_mins_p75_vendor_day,
    percentile_cont(rd.fir_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS fir_mins_p75_vendor_day,
    percentile_cont(rd.tvt_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS tvt_mins_p75_vendor_day,
    percentile_cont(rd.avt_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS avt_mins_p75_vendor_day,
    percentile_cont(rd.avtc_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS avtc_mins_p75_vendor_day,
    percentile_cont(rd.tct_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS tct_mins_p75_vendor_day,
    percentile_cont(rd.pdt_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS pdt_mins_p75_vendor_day,
    percentile_cont(rd.adt_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS adt_mins_p75_vendor_day,
    percentile_cont(rd.rdt_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rdt_mins_p75_vendor_day,
    percentile_cont(rd.rat_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rat_mins_p75_vendor_day,
    percentile_cont(rd.rrv_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS rrv_mins_p75_vendor_day,
    percentile_cont(rd.pickup_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS pickup_mins_p75_vendor_day,
    percentile_cont(rd.total_prep_time,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS total_prep_time_p75_vendor_day,
    percentile_cont(rd.store_dispatch_time,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS store_dispatch_time_p75_vendor_day,
    percentile_cont(rd.assignment_time_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS assignment_time_mins_p75_vendor_day,
    percentile_cont(rd.picking_time_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS picking_time_mins_p75_vendor_day,
    percentile_cont(rd.packaging_time_mins,0.75) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS packaging_time_mins_p75_vendor_day,
---p90,vendor,day
    percentile_cont(rd.ept_mins,0.90) OVER (PARTITION BY rd.country_code, city,vendor_name,rd.order_date) AS ept_mins_p90_vendor_day,
