  p.rat_mins_p90_country_day,
  p.rrv_mins_p90_country_day,
  p.pickup_mins_p90_country_day,
  p.total_prep_time_p90_country_day,
  p.store_dispatch_time_p90_country_day,
  p.assignment_time_mins_p90_country_day,
  p.picking_time_mins_p90_country_day,
  p.packaging_time_mins_p90_country_day,
  u.utr_order_count,
  u.working_time_mins,
  u.idle_time_mins
FROM agg a
  LEFT JOIN perc p ON a.country_code=p.country_code AND a.city=p.city AND a.vendor_name=p.vendor_name AND a.order_date=p.order_date AND a.is_grocery_flow=p.is_grocery_flow
  LEFT JOIN utr_timings u ON a.country_code=u.country_code AND lower(a.city)=u.city_name AND a.order_date=u.report_date]]></relation>
