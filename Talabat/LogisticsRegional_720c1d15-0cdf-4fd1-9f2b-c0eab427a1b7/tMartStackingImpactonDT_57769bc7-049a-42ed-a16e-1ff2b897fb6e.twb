    (&apos;om&apos;, &apos;Muttrah&apos;, 8.984034053, 9.85768705, 0.3863381321, 0.9287458761, 0.0),
    (&apos;om&apos;, &apos;Amerat&apos;, 4.67255531, 9.08524685, 0.2370694048, 0.9178503394, 0.0),
    (&apos;om&apos;, &apos;Sohar&apos;, 6.037765469, 13.12423117, 0.434337607, 0.9166402579, 0.0),
    (&apos;om&apos;, &apos;Salalah&apos;, 4.574806719, 12.22532763, 0.4017794785, 0.8381838667, 0.0),
    (&apos;om&apos;, &apos;Bosher&apos;, 7.978493079, 10.75328373, 0.6879824125, 0.8234373332, 0.0),
    (&apos;om&apos;, &apos;Seeb&apos;, 4.26035775, 11.29365343, 0.3255599967, 0.8142635277, 0.0),
    (&apos;qa&apos;, &apos;Doha&apos;, 5.043912864, 11.95391765, 0.1754947088, 0.9133889372, 0.0)
  ])
)

SELECT
  a.*,
  t.tct_slope,
  t.tct_intercept,
  t.tct_rmse,
  t.tct_r_squared,
  t.tct_p_value,
  avt.avt_slope,
  avt.avt_intercept,
  avt.avt_rmse,
  avt.avt_r_squared,
  avt.avt_p_value
FROM agg_data a
  LEFT JOIN tct_regression_results t ON t.country_code=a.country_code AND t.city=a.city
  LEFT JOIN avt_regression_results avt ON avt.country_code=a.country_code AND avt.city=a.city</relation>
            </properties>
