    (&apos;eg&apos;, &apos;Cairo&apos;, -0.2209703549, 6.44708357, 0.391199997, 0.007501278167, 1.074973),
    (&apos;jo&apos;, &apos;Amman&apos;, 4.331479691, 6.064594946, 0.8592093426, 0.6061554417, 0.000028),
    (&apos;jo&apos;, &apos;Irbid&apos;, 1.410040486, 4.604344611, 0.5216751432, 0.2548701309, 0.013989),
    (&apos;jo&apos;, &apos;Aqaba&apos;, 1.807259657, 4.4351719, 0.389105846, 0.2024460218, 0.101521),
    (&apos;jo&apos;, &apos;Salt&apos;, -0.276031975, 3.548597325, 0.2861320071, 0.03167585974, 0.487019),
    (&apos;jo&apos;, &apos;Zarqa&apos;, 0.2848707188, 3.625077203, 0.4063519234, 0.02988609889, 0.400313),
    (&apos;kw&apos;, &apos;Hawally&apos;, 2.831355485, 7.351842036, 0.3533054275, 0.5350802046, 0.001624),
    (&apos;kw&apos;, &apos;Farwaniya&apos;, 5.133945422, 8.230260384, 0.848389204, 0.5345739678, 0.000571),
