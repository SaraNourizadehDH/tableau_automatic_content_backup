    <worksheet name='Stacking Simulation'>
      <table>
        <view>
          <datasources>
            <datasource caption='Stacking Impact on DT components' name='federated.10c60dg1rmid9b10670vs0qx9tii' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Adjusted Stacking %' datatype='real' default-format='p0%' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10c60dg1rmid9b10670vs0qx9tii'>
            <column caption='AVT' datatype='real' name='[% of Stacking (copy)_3369185126371352577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avt_mins])/SUM([order_count])' />
            </column>
            <column caption='RRV' datatype='real' name='[AVT (copy)_3369185126371463170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rrv_mins])/SUM([order_count])' />
            </column>
            <column caption='Actual Stacking %' datatype='real' name='[Calculation_3369185126371217408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_order_count])/SUM([order_count])' />
            </column>
            <column caption='Estimated TCT (Adjusted Stacking %)' datatype='real' name='[Calculation_3369185126374293510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]*[tct_slope]+[tct_intercept]' />
            </column>
            <column caption='Estimated DT (Adjusted Stacking %)' datatype='real' name='[Calculation_3369185126374961160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_3369185126374293510])+AVG([Estimated TCT (copy)_3369185126374801415])+[AVT (copy)_3369185126371463170]' />
            </column>
            <column caption='% Delta Estimated DT(Adjusted Stacking %) vs Actual' datatype='real' name='[Calculation_3564739866520518656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3369185126374961160]-[TCT (copy)_3369185126371594244])/[TCT (copy)_3369185126371594244]' />
            </column>
            <column caption='Estimated DT (Actual Stacking %)' datatype='real' name='[Estimated DT (copy)_3369185126377553929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Estimated TCT (copy)_3369185126377697290]+[Estimated TCT 2 (copy)_3369185126377873419]+[AVT (copy)_3369185126371463170]' />
            </column>
            <column caption='Estimated AVT (Adjusted Stacking %)' datatype='real' name='[Estimated TCT (copy)_3369185126374801415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]*[avt_slope]+[avt_intercept]' />
            </column>
            <column caption='Estimated TCT (Actual Stacking %)' datatype='real' name='[Estimated TCT (copy)_3369185126377697290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3369185126371217408]*avg([tct_slope])+avg([tct_intercept])' />
            </column>
            <column caption='Estimated AVT (Actual Stacking %)' datatype='real' name='[Estimated TCT 2 (copy)_3369185126377873419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3369185126371217408]*avg([avt_slope])+avg([avt_intercept])' />
