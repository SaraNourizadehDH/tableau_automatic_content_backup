        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18feorz1v90y391dvkyig108o4c0' name='Custom SQL Query' type='text'>WITH vendor_info AS 
(
  SELECT 
    dvi.vendor_id,
    dvi.vendor_name,
    dvi.country_code,
    dli.city_name as city,
  FROM tlb-data-prod.data_platform.dim_vendor_info AS dvi
  LEFT JOIN tlb-data-prod.data_platform.dim_location_info AS dli ON (dvi.location_id = dli.location_id)
  WHERE  dvi.country_code IN (&apos;AE&apos;,&apos;BH&apos;,&apos;EG&apos;,&apos;JO&apos;,&apos;KW&apos;,&apos;OM&apos;,&apos;QA&apos;)
    AND dvi.is_darkstore 
),

base AS 
(
  SELECT 
  --order level data  
    o.country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.vendor.vertical_type,
    o.order_id,
    o.platform_order_code,
    date(o.created_at,o.timezone)                                       AS order_date,
    o.timings.at_vendor_time/60                                         AS avt_mins,
    o.timings.to_customer_time/60                                       AS tct_mins,
    o.timings.actual_delivery_time/60                                   AS adt_mins,
    d.is_stacked_intravendor                                            AS is_stacked,
    (timestamp_diff(d.rider_dispatched_at,o.created_at,second)+timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)+o.timings.to_vendor_time)/60                 AS rrv_mins,
    v.vendor_name,
    city
  FROM fulfillment-dwh-production.curated_data_shared.orders o
  LEFT JOIN UNNEST(deliveries) d
  INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  WHERE o.created_at&gt;&gt;=&apos;2022-12-31&apos;
    AND date(o.created_at,o.timezone)&gt;&gt;= &apos;2023-01-01&apos;
    AND o.entity.id IN (&apos;TB_AE&apos;,&apos;TB_BH&apos;,&apos;HF_EG&apos;,&apos;TB_JO&apos;,&apos;TB_KW&apos;,&apos;TB_OM&apos;,&apos;TB_QA&apos;)
    AND d.is_primary
    AND d.is_returning IS FALSE
    AND d.is_redelivery IS FALSE
    AND o.order_status=&apos;completed&apos;
    AND d.delivery_status=&apos;completed&apos;
    AND o.vendor.vertical_type=&apos;darkstores&apos;
),

agg_data AS 
(
  SELECT 
    b.country_code,
    b.city,
    --b.order_date,
    date_trunc(b.order_date, month) AS order_month,
    count(platform_order_code) AS order_count,
    count(CASE WHEN is_stacked THEN platform_order_code END) AS stacked_order_count,
    --round(count(CASE WHEN is_stacked THEN platform_order_code END)/count(platform_order_code),2) AS stacking_percentage,
    sum(rrv_mins) AS rrv_mins,
    sum(avt_mins) AS avt_mins,
    sum(tct_mins) AS tct_mins,
    sum(adt_mins) AS dt_mins,
    --sum(avt_mins)/count(platform_order_code) AS daily_avt_mins,
    --sum(tct_mins)/count(platform_order_code) AS daily_tct_mins,
    --sum(adt_mins)/count(platform_order_code) AS daily_adt_mins
  FROM base b
    GROUP BY ALL
  ),

avt_regression_results AS (
  SELECT * FROM UNNEST([
    STRUCT(&apos;ae&apos; AS country_code, &apos;Abu Dhabi&apos; AS city, 1.623601228 AS avt_slope, 3.604318976 AS avt_intercept, 0.1353305709 AS avt_rmse, 0.8668393022 AS avt_r_squared, 0.0 AS avt_p_value),
    (&apos;ae&apos;, &apos;Al Ain&apos;, 1.938906439, 3.355358825, 0.2173006114, 0.8347584796, 0.0),
    (&apos;ae&apos;, &apos;Ajman&apos;, 2.180154561, 3.031087782, 0.2593383551, 0.8135081557, 0.0),
