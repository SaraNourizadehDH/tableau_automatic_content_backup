SELECT
  a.*,
  t.tct_slope,
  t.tct_intercept,
  t.tct_rmse,
  t.tct_r_squared,
  t.tct_p_value,
  avt.avt_slope,
  avt.avt_intercept,
  avt.avt_rmse,
  avt.avt_r_squared,
  avt.avt_p_value
FROM agg_data a
  LEFT JOIN tct_regression_results t ON t.country_code=a.country_code AND t.city=a.city
  LEFT JOIN avt_regression_results avt ON avt.country_code=a.country_code AND avt.city=a.city</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
