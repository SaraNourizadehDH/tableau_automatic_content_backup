                </zone>
                <zone fixed-size='176' forceUpdate='true' h='23000' id='6' type-v2='text' w='100000' x='0' y='8625'>
                  <formatted-text>
                    <run fontcolor='#000000'>This dashboard is designed to help understand </run>
                    <run bold='true' fontcolor='#000000'>how stacking affects key delivery metrics</run>
                    <run fontcolor='#000000'> such as </run>
                    <run bold='true' fontcolor='#000000'>DT, AVT </run>
                    <run fontcolor='#000000'>and</run>
                    <run bold='true' fontcolor='#000000'> TCT.</run>
                    <run fontcolor='#000000'> It allows users to explore how different stacking levels impact these metrics and estimate how changes in stacking could influence overall delivery performance.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>The data is aggregated at the </run>
                    <run bold='true' fontcolor='#000000'>city</run>
                    <run fontcolor='#000000'> and </run>
                    <run bold='true' fontcolor='#000000'>monthly</run>
                    <run fontcolor='#000000'> levels for high-level trend analysis.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>The dashboard </run>
                    <run bold='true' fontcolor='#000000'>updates on the first day of each month</run>
                    <run fontcolor='#000000'>, providing a complete view of the previous month&apos;s data.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='68372' id='7' is-fixed='true' name='Glossary ' show-title='false' w='100000' x='0' y='31625'>
                  <layout-cache cell-count-h='7' non-cell-size-h='53' type-h='cell' type-w='fixed' />
