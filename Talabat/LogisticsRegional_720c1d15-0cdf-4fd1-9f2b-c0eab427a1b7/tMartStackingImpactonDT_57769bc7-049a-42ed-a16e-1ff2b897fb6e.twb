    (&apos;jo&apos;, &apos;Zarqa&apos;, 1.430552765, 10.81845869, 0.7582033667, 0.1797927595, 0.028092),
    (&apos;kw&apos;, &apos;Ahmadi&apos;, 11.98150217, 11.24987928, 0.4750133128, 0.9304299021, 0.0),
