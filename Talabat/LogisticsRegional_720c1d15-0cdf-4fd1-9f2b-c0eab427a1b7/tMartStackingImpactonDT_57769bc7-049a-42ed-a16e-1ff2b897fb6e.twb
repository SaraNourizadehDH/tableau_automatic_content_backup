    (&apos;kw&apos;, &apos;Kuwait City (Capital)&apos;, 3.464199584, 7.95272973, 0.6425381776, 0.4019805205, 0.006071),
    (&apos;kw&apos;, &apos;Al Jahra&apos;, 6.553788963, 7.355860308, 1.250205575, 0.3544121117, 0.01314),
    (&apos;kw&apos;, &apos;Mubarak Al-kabir&apos;, 1.183877159, 7.811092258, 0.9102099292, 0.07601019153, 0.172492),
    (&apos;om&apos;, &apos;Seeb&apos;, 3.401823334, 5.13307683, 0.5154447001, 0.518298949, 0.001128),
    (&apos;om&apos;, &apos;Muttrah&apos;, 1.987722814, 3.760743956, 0.3892032159, 0.4017959918, 0.005425),
    (&apos;om&apos;, &apos;Salalah&apos;, 1.177365514, 3.439671188, 0.2914613867, 0.4011684842, 0.002724),
    (&apos;om&apos;, &apos;Bosher&apos;, 3.395172024, 4.33573468, 0.751939185, 0.4008550563, 0.003543),
    (&apos;om&apos;, &apos;Amerat&apos;, 1.770365399, 3.453894484, 0.4116350857, 0.3523125029, 0.008018),
    (&apos;om&apos;, &apos;Sohar&apos;, 0.2502369097, 2.528013716, 0.3289213831, 0.03188528453, 0.398562),
    (&apos;qa&apos;, &apos;Doha&apos;, 3.878363135, 4.841429113, 0.5721878784, 0.3831494743, 0.015527)
  ])
),

tct_regression_results AS (
