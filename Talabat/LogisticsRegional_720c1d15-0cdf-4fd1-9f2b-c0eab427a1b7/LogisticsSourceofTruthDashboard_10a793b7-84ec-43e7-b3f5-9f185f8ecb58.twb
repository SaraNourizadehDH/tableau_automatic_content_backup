              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[City Filter (copy)_2095933065737691137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;MENA&quot; THEN TRUE ELSE &#10;[country_code] = [Parameters].[Parameter 9]&#10;END' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) YTD YoY' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD MoM (copy)_4283767692324622344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT YTD YoY' datatype='real' name='[DT MTD MoM (copy)_4283767692324622345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))' />
            </column>
            <column caption='YTD YoY title' datatype='string' name='[MTD MoM title (copy)_4283767692324257795]' role='dimension' type='nominal'>
