              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_on_time_dh] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [order_on_time_denominator] END))' />
            </column>
            <column caption='% Shrink YTD YoY' datatype='real' name='[% Shrink MTD MoM (copy)_4283767692324622342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [shrinked_instance] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [shrinked_instance] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [shrinked_instance] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='City Filter' datatype='boolean' name='[Calculation_1554375209498640433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Select a city] = &quot;MENA&quot; THEN TRUE ELSE &#10;[city_name] = [Parameters].[Select a country (copy)_2095933065736368128]' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) YTD YoY' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD MoM (copy)_4283767692324622344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT YTD YoY' datatype='real' name='[DT MTD MoM (copy)_4283767692324622345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))' />
            </column>
            <column caption='YTD YoY title' datatype='string' name='[MTD MoM title (copy)_4283767692324257795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD YoY&apos;' />
