        <calculation class='tableau' formula='[country_code]' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_5013984139425648681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[city_name]' />
      </column>
      <column caption='Zone' datatype='string' hidden='true' name='[Calculation_5013984139425706026]' role='dimension' type='nominal'>
