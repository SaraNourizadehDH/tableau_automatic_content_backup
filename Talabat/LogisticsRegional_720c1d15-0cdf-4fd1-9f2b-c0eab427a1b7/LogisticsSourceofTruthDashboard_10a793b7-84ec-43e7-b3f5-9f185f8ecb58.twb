              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN REGEXP_REPLACE(STR(INT([Calculation_5013984138629906447])), &quot;(?&lt;=\d)(?=(\d{3})+$)&quot;, &quot;,&quot;)&#10;    WHEN &quot;UTR&quot; THEN STR(ROUND([Calculation_5013984138630025232], 2))&#10;    WHEN &quot;AVG DT&quot; THEN STR(ROUND([Calculation_5013984139416248358], 1)) + &quot; min&quot;&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN STR(ROUND([AVG DT (copy)_5013984139416363047], 1)) + &quot; min&quot;&#10;    WHEN &quot;% Orders on time&quot; THEN STR(ROUND([Calculation_5013984138611777543]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;% Orders Late&quot; THEN STR(ROUND([Calculation_5013984139369463841]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Supply Position&quot; THEN STR(ROUND([AVP % (copy)_1165517526436405248], 1))&#10;    WHEN &quot;Offline Hours %&quot; THEN STR(ROUND([Total Offline Hours (copy)_1165517526437281793]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Shrink %&quot; THEN STR(ROUND([% VFR (copy)_6465409858547515394]*100, 2)) + &quot;%&quot;&#10;    WHEN &quot;% Orders DT &gt;45 mins&quot; THEN STR(ROUND([AVG DT (min) (copy)_5013984138677772309]*100, 1)) + &quot;%&quot;&#10;    ELSE &quot;N/A&quot;&#10;END' />
