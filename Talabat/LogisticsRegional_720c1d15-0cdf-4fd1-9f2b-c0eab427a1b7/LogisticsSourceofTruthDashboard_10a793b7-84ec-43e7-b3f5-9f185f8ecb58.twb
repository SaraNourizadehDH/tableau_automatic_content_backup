              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_late_dh] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_completed_orders] END))' />
            </column>
