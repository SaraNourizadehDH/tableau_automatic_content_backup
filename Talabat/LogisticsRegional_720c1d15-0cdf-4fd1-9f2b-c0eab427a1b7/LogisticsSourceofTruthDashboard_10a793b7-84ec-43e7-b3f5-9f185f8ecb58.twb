          <calculation class='tableau' formula='#2025-07-01#' />
        </column>
        <column caption='exCo KPIs' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Hours \%&quot;'>
          <calculation class='tableau' formula='&quot;Offline Hours %&quot;' />
          <aliases>
            <alias key='&quot;\% Orders DT &gt;45 mins&quot;' value='Orders with &gt;45 Delivery Time' />
            <alias key='&quot;AVG DT&quot;' value='Average Delivery Time' />
          </aliases>
        </column>
        <column alias='Sunday' caption='Week Start Day' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
          <aliases>
            <alias key='1' value='Sunday' />
            <alias key='2' value='Monday' />
            <alias key='3' value='Tuesday' />
            <alias key='4' value='Wednesday' />
            <alias key='5' value='Thursday' />
            <alias key='6' value='Friday' />
            <alias key='7' value='Saturday' />
          </aliases>
        </column>
        <column alias='UAE' caption='Select a country' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;ae&quot;'>
          <calculation class='tableau' formula='&quot;ae&quot;' />
          <aliases>
            <alias key='&quot;ae&quot;' value='UAE' />
            <alias key='&quot;bh&quot;' value='Bahrain' />
            <alias key='&quot;eg&quot;' value='Egypt' />
            <alias key='&quot;iq&quot;' value='Iraq' />
            <alias key='&quot;jo&quot;' value='Jordan' />
            <alias key='&quot;kw&quot;' value='Kuwait' />
            <alias key='&quot;om&quot;' value='Oman' />
            <alias key='&quot;qa&quot;' value='Qatar' />
          </aliases>
        </column>
        <column caption='Select a city' datatype='string' name='[Select a country (copy)_2095933065736368128]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dubai&quot;'>
          <calculation class='tableau' formula='&quot;Dubai&quot;' />
          <aliases>
            <alias key='&quot;Cairo&quot;' value='Cairo' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Orders' id='_04B5BEBB3EFD41E7B654BE5F32B3E724'>
            <properties context=''>
              <relation connection='bigquery.11c2b9d0al7zic1h8z68y0n20b3a' name='Custom SQL Query' type='text'>WITH 

date_param AS (
    SELECT 
    DATE(&apos;2024-01-01&apos;) AS start_date,
    DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) AS end_date
),

orders AS (
  SELECT 
        order_date_local AS date,
        country_code,
        city_id,
        city_name,
        vertical_type,
        SUM(total_orders) AS total_orders,
        SUM(total_completed_orders) AS total_completed_orders,
        SUM(total_deliveries) AS total_deliveries,
        SUM(total_completed_deliveries) AS total_completed_deliveries,
        SUM(total_actual_delivery_time) AS total_actual_delivery_time,
        SUM(total_dt_dtp_lower_than_12_min) AS total_dt_dtp_lower_than_12_min,
        SUM(total_orders_dt_greater_than_45_min) AS total_orders_dt_greater_than_45_min,
        SUM(dt_denominator) AS dt_denominator,
        SUM(total_orders_on_time_dh) AS total_orders_on_time_dh,
        SUM(order_on_time_denominator) AS order_on_time_denominator,
        SUM(total_orders_late_dh) AS total_orders_late_dh,

-- other KPIs from the original query
        SUM(total_rider_accepting_time) AS total_rider_accepting_time,
        SUM(rat_denominator) AS rat_denominator,
        SUM(total_estimated_prep_time) AS total_estimated_prep_time,
        SUM(count_ept) AS count_ept,
        SUM(total_at_vendor_time) AS total_at_vendor_time,
        SUM(count_avtc) AS count_avtc,
        SUM(count_avtc_ept) AS count_avtc_ept,
        SUM(ept_avtc_denominator) AS ept_avtc_denominator,
        SUM(ept_denominator) AS ept_denominator,
        SUM(avtc_denominator) AS avtc_denominator,
        SUM(total_to_vendor_time) AS total_to_vendor_time,
        SUM(total_to_customer_time) AS total_to_customer_time,
        SUM(tct_denominator) AS tct_denominator,
        SUM(tvt_denominator) AS tvt_denominator,
        SUM(total_pickup_distance_google) AS total_pickup_distance_google,
        SUM(total_dropoff_distance_google) AS total_dropoff_distance_google,
        SUM(pickup_distance_google_denominator) AS pickup_distance_google_denominator,
        SUM(dropoff_distance_google_denominator) AS dropoff_distance_google_denominator,
        SUM(total_stacked_orders) AS total_stacked_orders,
        SUM(total_spilt_orders) AS total_spilt_orders,
        SUM(total_orders_on_time) AS total_orders_on_time,
        SUM(total_orders_late_greater_than_10_min) AS total_orders_late_greater_than_10_min,
        SUM(total_orders_late_greater_than_15_min) AS total_orders_late_greater_than_15_min,
        SUM(vendor_delay_count) AS vendor_delay_count,
        SUM(vendor_delay_over_10mins) AS vendor_delay_over_10mins,
        SUM(rider_late_10) AS rider_late_10,
        SUM(orders_on_fixed_ept) AS orders_on_fixed_ept,
        SUM(cancelled_orders) AS cancelled_orders,
        SUM(total_failed_order_nfr) AS total_failed_order_nfr,
        SUM(total_failed_order_lfr) AS total_failed_order_lfr,
        SUM(total_failed_order_vendor) AS total_failed_order_vendor,
        SUM(fail_rate_denominator) AS fail_rate_denominator,
        SUM(notified_count) AS notified_count,
        SUM(accepted_count) AS accepted_count,
        SUM(manual_undispatch_count) AS manual_undispatch_count
        -- ,SUM(DT_90p) AS DT_90p   
  FROM `tlb-data-prod.data_platform.agg_logistics_sot_orders_daily` 
  WHERE order_date_local BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
  AND country_code IN (&quot;ae&quot;, &quot;bh&quot;, &quot;eg&quot;, &quot;iq&quot;, &quot;jo&quot;, &quot;kw&quot;, &quot;om&quot;, &quot;qa&quot;)
  GROUP BY ALL
),

offline_hours AS (
    -- getting unreachable offline duration for each schedule
    SELECT DISTINCT
        LOWER(ue.country_code) AS country_code,
        l.city_id,
        l.city_name,
        --c.vertical,
        CASE
            WHEN v.is_darkstore THEN &apos;Darkstores&apos;
            WHEN c.vertical = &apos;food&apos; THEN &apos;Food&apos;
            ELSE &apos;NFV&apos;
        END AS vertical_type,
        --ue.vendor_id,
        schedule_date_local AS date,
        --CONCAT(schedule_start_timestamp_local, schedule_end_timestamp_local) AS schedule_id,
        SUM(TIMESTAMP_DIFF(schedule_end_timestamp_local, schedule_start_timestamp_local, SECOND)) AS schedule_duration_seconds,
        COALESCE(SUM(
            CASE
                WHEN
                    is_offline AND UPPER(unavailability_event_reason) IN (&quot;UNREACHABLE&quot;, &quot;DEVICE_CONNECTIVITY&quot;)
                    THEN TIMESTAMP_DIFF(event_end_timestamp, event_start_timestamp, SECOND)
            END
        ), 0) AS unreachable_offline_duration_seconds,

        ROUND(COALESCE(SUM(CASE WHEN is_offline THEN event_duration_in_seconds/3600 ELSE 0 END), 0),2) AS offline_time,
        ROUND(COALESCE(SUM(CASE WHEN ue.is_offline AND ue.is_unreachable THEN ue.event_duration_in_seconds/3600 ELSE 0 END), 0),2) AS offline_due_to_unreachable,
        ROUND(COALESCE(SUM(CASE WHEN v.is_non_food = TRUE AND v.is_darkstore = FALSE AND v.lead_data_origin = &apos;PP&apos;
            THEN ue.event_duration_in_seconds / 3600 ELSE 0 END), 0),2) AS AAA_offline_hours


    FROM `tlb-data-prod.data_platform.fct_vendor_schedule_unavailability_event` ue
        LEFT JOIN `tlb-data-prod.data_platform.dim_unavailability_event_reason` r ON ue.event_reason_id = r.unavailability_event_reason_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_unavailability_event_source` es ON ue.event_source_id = es.unavailability_event_source_id
        LEFT JOIN
            `tlb-data-prod.data_platform.dim_vendor_info` v
        ON
            ue.vendor_id = CAST(v.vendor_id AS string)
        INNER JOIN `tlb-data-prod.data_platform.dim_chain` c 
          ON ue.chain_id = c.chain_id
        INNER JOIN `tlb-data-prod.data_platform.dim_vendor_history` vh
          ON CAST(vh.vendor_id AS STRING) = ue.vendor_id 
          AND ue.schedule_date BETWEEN vh.valid_from AND vh.valid_to
        INNER JOIN
            (SELECT l.* EXCEPT(zone_name), 
            CASE WHEN country_id = 9 THEN COALESCE(dle.zone_name_final,l.zone_name)
            ELSE l.zone_name END AS zone_name
            FROM `tlb-data-prod.data_platform.dim_location` l
            LEFT JOIN `tlb-data-prod.data_platform.sq_dim_location_eg` dle USING(location_id)) l
        USING
            (location_id)
    WHERE ue.schedule_date_local BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
    --    AND c.vertical = &quot;food&quot;
        AND LOWER(vh.account_status) = &quot;active&quot;  -- only pick salesforce active vendors
        AND LOWER(ue.country_code) IN (&quot;ae&quot;, &quot;bh&quot;, &quot;eg&quot;, &quot;iq&quot;, &quot;jo&quot;, &quot;kw&quot;, &quot;om&quot;, &quot;qa&quot;)
    GROUP BY ALL
), 

utr_fill_rate AS (
  SELECT
    country_code,
    created_date_local,
    city_id,
    city_name,
    SUM(total_orders_utr) AS total_orders_utr,
    SUM(evaluations_working_time) AS evaluations_working_time,
    SUM(open_slots_size) AS open_slots_size,
    SUM(open_slots_assigned) AS open_slots_assigned
  FROM `tlb-data-prod.data_platform.agg_logistics_sot_fr_utr_daily`
  WHERE created_date_local &gt;&gt;= (SELECT start_date FROM date_param)
    AND country_code IN (&quot;ae&quot;, &quot;bh&quot;, &quot;eg&quot;, &quot;iq&quot;, &quot;jo&quot;, &quot;kw&quot;, &quot;om&quot;, &quot;qa&quot;)
  GROUP BY ALL
),

shrinkage AS (
    SELECT distinct
        LOWER(s.country_code) AS country_code,
        created_date_local AS created_date,
        s.city_name,
        sum(case when is_brand_area_interval_shrinked then 1 else 0 end ) as shrinked_instance,
        count(*) as all_instances,
        --(SUM(CASE WHEN is_brand_area_interval_shrinked THEN 1 ELSE 0 END) / COUNT(*))*100.00 AS shrinkage_percentage

    FROM `tlb-data-prod.data_platform.fct_logistics_food_brand_shrinkage` s
    left join `tlb-data-prod.data_platform.dim_location_info` l using(location_id)
    left join `tlb-data-prod.data_platform.agg_brand_grade` bg on bg.country_code=s.country_code and bg.city_id=l.city_id and bg.pluto_brand_id=s.pluto_brand_id and bg.date = date_trunc(s.created_date_local, month)
    WHERE s.created_Date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
    GROUP BY 1,2,3
)

SELECT
    o.*,
    o.date AS order_date_local,
    COALESCE(oh.offline_time, 0) AS offline_time,
    COALESCE(oh.offline_due_to_unreachable, 0) AS offline_due_to_unreachable,
    COALESCE(oh.AAA_offline_hours, 0) AS AAA_offline_hours,
    COALESCE(oh.schedule_duration_seconds, 0) AS schedule_duration_seconds,
    COALESCE(oh.unreachable_offline_duration_seconds, 0) AS unreachable_offline_duration_seconds,
    COALESCE(ufr.total_orders_utr, 0) AS total_orders_utr,
    COALESCE(ufr.evaluations_working_time, 0) AS evaluations_working_time,
    COALESCE(ufr.open_slots_size, 0) AS open_slots_size,
    COALESCE(ufr.open_slots_assigned, 0) AS open_slots_assigned,
    COALESCE(s.shrinked_instance, 0) AS shrinked_instance,
    COALESCE(s.all_instances, 0) AS all_instances
FROM orders o
LEFT JOIN offline_hours oh 
    ON o.country_code = oh.country_code
    AND o.city_id = oh.city_id
    AND o.date = oh.date
    AND o.vertical_type = oh.vertical_type
LEFT JOIN utr_fill_rate ufr 
    ON o.country_code = ufr.country_code
    AND o.city_id = ufr.city_id
    AND o.date = ufr.created_date_local
LEFT JOIN shrinkage s
    ON o.country_code = s.country_code
    AND o.city_name = s.city_name
    AND o.date = s.created_date
WHERE o.date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
