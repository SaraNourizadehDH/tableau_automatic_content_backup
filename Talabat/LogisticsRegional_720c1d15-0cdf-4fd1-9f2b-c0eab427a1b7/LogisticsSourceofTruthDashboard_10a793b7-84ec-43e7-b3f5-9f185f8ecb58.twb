          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00kj9ah102uuxj11e5am10guaqdj'>
            <column caption='Supply Position (tbd)' datatype='integer' name='[AVP % (copy)_1165517526436405248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(1)//SUM([actual_vs_planned])/SUM([total_shifts])' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1165517526456807432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type]' />
            </column>
            <column caption='Week Start Date' datatype='datetime' name='[Calculation_1554375209445937180]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,&#10;  -1 * ((DATEPART(&apos;weekday&apos;, [Parameters].[Parameter 6]) - INT([Parameters].[Parameter 8]) + 7) % 7),&#10;  [Parameters].[Parameter 6]&#10;)' />
            </column>
