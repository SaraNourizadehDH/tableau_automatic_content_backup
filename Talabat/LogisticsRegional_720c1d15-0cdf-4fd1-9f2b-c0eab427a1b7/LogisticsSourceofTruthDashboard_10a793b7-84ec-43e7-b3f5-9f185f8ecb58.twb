              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_on_time_dh] END) &#10;/ SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [order_on_time_denominator] END))' />
            </column>
            <column caption='% Shrink YTD' datatype='real' name='[% Shrink MTD (copy)_1554375209505427511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [shrinked_instance] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='City Filter' datatype='boolean' name='[Calculation_1554375209498640433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Select a city] = &quot;MENA&quot; THEN TRUE ELSE &#10;[city_name] = [Parameters].[Select a country (copy)_2095933065736368128]' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) YTD' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD (copy)_1554375209505427515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT YTD' datatype='real' name='[DT MTD (copy)_1554375209505427516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)))' />
            </column>
            <column caption='% Orders DT &gt;45 mins YTD' datatype='real' name='[DT YTD (copy)_4654188759330983968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)))' />
            </column>
            <column caption='YTD title' datatype='string' name='[MTD title (copy)_1554375209460564014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD&apos;' />
            </column>
            <column caption='Offline Hours % YTD' datatype='real' name='[Offline Hours % MTD (copy)_1554375209505427513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [offline_time] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [schedule_duration_seconds]/3600 END))' />
            </column>
            <column caption='Orders YTD' datatype='integer' name='[Orders MTD (copy)_1554375209505427514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_completed_orders] END)' />
            </column>
            <column caption='UTR YTD' datatype='real' name='[UTR MTD (copy)_1554375209505427517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_utr] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [evaluations_working_time] END))' />
            </column>
            <column datatype='integer' name='[all_instances]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[dt_denominator]' role='measure' type='quantitative' />
            <column datatype='real' name='[evaluations_working_time]' role='measure' type='quantitative' />
            <column caption='is_current_year' datatype='boolean' name='[is_current_month main (copy)_1554375209457987625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [order_date_local], [Parameters].[Parameter 6]) = 0&#10;AND DAY([order_date_local]) &lt;= DAY([Parameters].[Parameter 6])' />
            </column>
