    <worksheet name='Metrics by Zone'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SoT sources' name='federated.00kj9ah102uuxj11e5am10guaqdj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.00kj9ah102uuxj11e5am10guaqdj'>
            <column caption='% Order Delay &gt; 15 min' datatype='real' name='[% Order Delay &gt; 10 min (copy)_5013984139369570338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_late_greater_than_15_min])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='% NFR' datatype='real' name='[% VFR (copy)_5013984138984779801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders]) //SUM([total_orders])&#10;//SUM([total_failed_order_nfr])/SUM([fail_rate_denominator])&#10;//Net Fail Rate' />
            </column>
            <column caption='AVG working days' datatype='real' name='[% of riders with &lt;8 working hours per day (tbd) (copy)_2485846269734711302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [rider_id], [Date  (copy)_3751428140860055552] : COUNTD([date]) })' />
            </column>
            <column datatype='real' hidden='true' name='[AAA_offline_hours]' role='measure' type='quantitative' />
            <column caption='AVG DT (&lt;= 12 mins DTP)' datatype='real' name='[AVG DT (copy)_5013984139416363047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dt_dtp_lower_than_12_min])/SUM([dt_denominator])' />
            </column>
            <column caption='% Orders DT &gt;45 mins' datatype='real' name='[AVG DT (min) (copy)_5013984138677772309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_dt_greater_than_45_min])/SUM([dt_denominator])' />
            </column>
            <column caption='DT 90th percentile' datatype='real' name='[AVG DT (min) (copy)_6465409858551955467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([DT_90p])' />
            </column>
            <column caption='AVG DO Distance' datatype='real' name='[AVG PU Distance (copy)_1466836483895910406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dropoff_distance_google])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='AVG TVT' datatype='real' name='[AVG TCT (copy)_5013984139369738276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984139369193503]/sum([tvt_denominator])' />
            </column>
            <column caption='Rider Late %' datatype='real' name='[AVP % (copy)_1466836483895328772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Fill Rate %' datatype='real' name='[AVP % (copy)_1466836483971489804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned (Custom SQL Query5)])/SUM([open_slots_size (Custom SQL Query5)])' />
            </column>
            <column caption='% of riders with &lt;8 working hours per day' datatype='real' name='[Break % (copy)_2485846269734617093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shift_less_than_8hours_rider_count])/[Calculation_2485846271261765644]' />
            </column>
            <column caption='AVP %' datatype='real' name='[Break % (copy)_5013984139367657501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([actual_vs_planned])/SUM([total_shifts])&#10;SUM([total_working_hours])/SUM([total_planned_working_hours])' />
            </column>
            <column caption='AVG PU Distance' datatype='real' name='[Calculation_1466836483895754757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_pickup_distance_google])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Date Local' datatype='date' name='[Calculation_1466836483917897737]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date_local]' />
            </column>
            <column caption='Location' datatype='string' name='[Calculation_1466836483943874571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Zone&apos; THEN [zone_name]&#10;ELSE [area_name]&#10;END' />
            </column>
            <column caption='Rider Accepting Time' datatype='real' name='[Calculation_2485846269734289412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_accepting_time])/SUM([rat_denominator])' />
            </column>
            <column caption='Days Worked' datatype='integer' name='[Calculation_2485846271261765644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_count])' />
            </column>
            <column caption='Total Working Hours ' datatype='real' name='[Calculation_2485846271262351373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluations_working_time])&#10;// From shift table' />
            </column>
            <column caption='No Show %' datatype='real' name='[Calculation_5013984137949687808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_no_show_shifts])/SUM([total_evaluated_shifts])' />
            </column>
            <column caption='Late Login %' datatype='real' name='[Calculation_5013984137950056449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_late_login_shifts])/sum([total_evaluated_shifts])' />
            </column>
            <column caption='AVG Working Hours' datatype='real' name='[Calculation_5013984137950437378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluations_working_time])/SUM([rider_count])&#10;//SUM([sum_actual_working_hours])/SUM([total_active_riders])' />
            </column>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_5013984137950777348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984139368022046]/SUM([notified_count])' />
            </column>
            <column caption='% Orders on time' datatype='real' name='[Calculation_5013984138611777543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_on_time_dh])/[Calculation_5013984138629906447]&#10;//SUM([total_orders_on_time])/sum([order_on_time_denominator])' />
            </column>
            <column caption='% VD2' datatype='real' name='[Calculation_5013984138612334600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_over_10mins])/SUM([total_completed_orders]) &#10;//replace with deliveries&#10;// Vendor Delay 2' />
            </column>
            <column caption='% VFR' datatype='real' name='[Calculation_5013984138612928521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_failed_order_vendor])/SUM([fail_rate_denominator])&#10;// Vendor Fail Rate' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_5013984138613534730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_stacked_orders])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Split %' datatype='real' name='[Calculation_5013984138614382603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_spilt_orders])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Total EPT' datatype='real' name='[Calculation_5013984138626433037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_estimated_prep_time])' />
            </column>
            <column caption='Total AVTC' datatype='real' name='[Calculation_5013984138626699278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_at_vendor_time])' />
            </column>
            <column caption='Total Completed Orders' datatype='integer' name='[Calculation_5013984138629906447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_5013984138630025232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_orders_utr])/sum([evaluations_working_time])//SUM([total_working_hours])' />
            </column>
            <column caption='Total EPT + AVTC' datatype='real' name='[Calculation_5013984138638753810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984138626699278] + [Calculation_5013984138626433037]' />
            </column>
            <column caption='AVG EPT' datatype='real' name='[Calculation_5013984138678718486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984138626433037]/SUM([count_ept])&#10;//SUM([ept_denominator])' />
            </column>
            <column caption='AVG AVTC' datatype='real' name='[Calculation_5013984138678800407]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984138626699278]/SUM([count_avtc])&#10;//SUM([avtc_denominator])' />
            </column>
            <column caption='AVG EPT + AVTC' datatype='real' name='[Calculation_5013984138678882328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984138638753810]/SUM([count_avtc_ept])&#10;//SUM([ept_avtc_denominator])' />
            </column>
            <column caption='Break %' datatype='real' name='[Calculation_5013984139352363036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_break_hours])/(SUM([total_working_hours])+SUM([total_break_hours]))' />
            </column>
            <column caption='Total Acceptance Count' datatype='integer' name='[Calculation_5013984139368022046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepted_count]) - SUM([manual_undispatch_count])' />
            </column>
            <column caption='Total TVT' datatype='real' hidden='true' name='[Calculation_5013984139369193503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_to_vendor_time])' />
            </column>
            <column caption='% Order Delay &gt; 10 min' datatype='real' name='[Calculation_5013984139369463841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_late_dh])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='AVG TCT' datatype='real' name='[Calculation_5013984139369668643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total TVT (copy)_5013984139369275424]/sum([tct_denominator])' />
            </column>
            <column caption='AVG DT (min)' datatype='real' name='[Calculation_5013984139416248358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total AVTC (copy)_5013984139416109093]/SUM([dt_denominator])' />
            </column>
            <column caption='LFR %' datatype='real' name='[Calculation_5013984140381339692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_failed_order_lfr])/SUM([fail_rate_denominator])' />
            </column>
            <column datatype='real' hidden='true' name='[DT_90p]' role='measure' type='quantitative' />
            <column caption='Date working days' datatype='date' name='[Date  (copy)_3751428140860055552]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Rider Fraud %' datatype='real' name='[Lack of Delivery Men % (tbd) (copy)_1466836483971731470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fraud_riders])/sum([rider_base_fraud])' />
            </column>
            <column caption='% Suspended Riders' datatype='real' name='[Lack of Delivery Men % (tbd) (copy)_1466836483971821583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([suspended_riders])/SUM([rider_base_fraud])' />
            </column>
            <column caption='AAA Total Offline Hours (NFV)' datatype='real' name='[Offline Hours (tbd) (copy) (copy) (copy)_2485846269731766275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AAA_offline_hours])/(SUM([schedule_duration_seconds])/3600)' />
            </column>
            <column caption='% Orders on fixed EPT' datatype='real' name='[Offline Hours (tbd) (copy) (copy)_2485846269731741698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_on_fixed_ept])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Offline Hours due to unreachable %' datatype='real' name='[Offline Hours (tbd) (copy)_2485846269731733505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_offline_duration_seconds])/SUM([schedule_duration_seconds])' />
            </column>
            <column caption='Total DT' datatype='real' hidden='true' name='[Total AVTC (copy)_5013984139416109093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_actual_delivery_time])' />
            </column>
            <column caption='Offline Hours %' datatype='real' name='[Total Offline Hours (copy)_1165517526437281793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_time])/(SUM([schedule_duration_seconds])/3600)' />
            </column>
