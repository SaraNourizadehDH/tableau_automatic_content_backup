        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.11c2b9d0al7zic1h8z68y0n20b3a'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='francois.carro@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
