)&#10;        * 100, 1)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;Supply Position&quot; THEN &#10;        STR(ROUND([AVP % (copy)_1165517526436405248], 1))&#10;    &#10;    WHEN &quot;Offline Hours %&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [offline_time] END)&#10;            /&#10;            SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [schedule_duration_seconds]/3600 END)&#10;        * 100, 1)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;Shrink %&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [shrinked_instance] END)&#10;            /&#10;            SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [all_instances] END)&#10;        * 100, 2)) + &quot;%&quot;&#10;    WHEN &apos;% Orders DT &gt;45 mins&apos; THEN&#10;        STR(ROUND(        &#10;            (SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_dt_greater_than_45_min] END)&#10;        /&#10;        SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))&#10;        * 100, 1)) + &quot;%&quot;&#10;    ELSE &quot;N/A&quot;&#10;END' />
