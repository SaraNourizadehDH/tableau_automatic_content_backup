    <worksheet name='30 days exco city'>
      <table>
        <view>
          <datasources>
            <datasource caption='SoT sources' name='federated.00kj9ah102uuxj11e5am10guaqdj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.00kj9ah102uuxj11e5am10guaqdj].[Calculation_1165517526451916804]' caption='End Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column caption='exCo KPIs' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Hours \%&quot;'>
              <calculation class='tableau' formula='&quot;Offline Hours %&quot;' />
              <aliases>
                <alias key='&quot;\% Orders DT &gt;45 mins&quot;' value='Orders with &gt;45 Delivery Time' />
                <alias key='&quot;AVG DT&quot;' value='Average Delivery Time' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00kj9ah102uuxj11e5am10guaqdj'>
            <column caption='% Shrink' datatype='real' name='[% VFR (copy)_6465409858547515394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinked_instance])/SUM([all_instances])//SUM([vendor_event_hours])/SUM([all_vendors]*24)' />
            </column>
            <column caption='AVG DT (&lt;= 12 mins DTP)' datatype='real' name='[AVG DT (copy)_5013984139416363047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dt_dtp_lower_than_12_min])/SUM([dt_denominator])' />
            </column>
            <column caption='% Orders DT &gt;45 mins' datatype='real' name='[AVG DT (min) (copy)_5013984138677772309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_dt_greater_than_45_min])/SUM([dt_denominator])' />
            </column>
            <column caption='Supply Position (tbd)' datatype='integer' name='[AVP % (copy)_1165517526436405248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(1)//SUM([actual_vs_planned])/SUM([total_shifts])' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='exCo Metric' datatype='real' name='[Calculation_1165517526454562823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN [Calculation_5013984138629906447]&#10;    WHEN &quot;UTR&quot; THEN [Calculation_5013984138630025232]&#10;    WHEN &quot;AVG DT&quot; THEN [Calculation_5013984139416248358]&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN [AVG DT (copy)_5013984139416363047]&#10;    WHEN &quot;% Orders on time&quot; THEN [Calculation_5013984138611777543]&#10;    WHEN &quot;% Orders Late&quot; THEN [Calculation_5013984139369463841]&#10;    WHEN &quot;Supply Position&quot; THEN [AVP % (copy)_1165517526436405248]&#10;    WHEN &quot;Offline Hours %&quot; THEN [Total Offline Hours (copy)_1165517526437281793]&#10;    WHEN &quot;Shrink %&quot; THEN [% VFR (copy)_6465409858547515394]&#10;    WHEN &quot;% Orders DT &gt;45 mins&quot; THEN [AVG DT (min) (copy)_5013984138677772309]&#10;    ELSE NULL &#10;END' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1165517526456807432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type]' />
            </column>
            <column caption='City Name' datatype='string' name='[Calculation_1165517526459584521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Date Local' datatype='date' name='[Calculation_1466836483917897737]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date_local]' />
            </column>
            <column caption='empty' datatype='string' name='[Calculation_1554375209464852527]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos; &apos;' />
            </column>
            <column caption='exCo Metrics format' datatype='string' name='[Calculation_2377408039246622720]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN REGEXP_REPLACE(STR(INT([Calculation_5013984138629906447])), &quot;(?&lt;=\d)(?=(\d{3})+$)&quot;, &quot;,&quot;)&#10;    WHEN &quot;UTR&quot; THEN STR(ROUND([Calculation_5013984138630025232], 2))&#10;    WHEN &quot;AVG DT&quot; THEN STR(ROUND([Calculation_5013984139416248358], 1)) + &quot; min&quot;&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN STR(ROUND([AVG DT (copy)_5013984139416363047], 1)) + &quot; min&quot;&#10;    WHEN &quot;% Orders on time&quot; THEN STR(ROUND([Calculation_5013984138611777543]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;% Orders Late&quot; THEN STR(ROUND([Calculation_5013984139369463841]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Supply Position&quot; THEN STR(ROUND([AVP % (copy)_1165517526436405248], 1))&#10;    WHEN &quot;Offline Hours %&quot; THEN STR(ROUND([Total Offline Hours (copy)_1165517526437281793]*100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Shrink %&quot; THEN STR(ROUND([% VFR (copy)_6465409858547515394]*100, 2)) + &quot;%&quot;&#10;    WHEN &quot;% Orders DT &gt;45 mins&quot; THEN STR(ROUND([AVG DT (min) (copy)_5013984138677772309]*100, 1)) + &quot;%&quot;&#10;    ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='% Orders on time' datatype='real' name='[Calculation_5013984138611777543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_on_time_dh])/[Calculation_5013984138629906447]&#10;//SUM([total_orders_on_time])/sum([order_on_time_denominator])' />
            </column>
            <column caption='Total Completed Orders' datatype='integer' name='[Calculation_5013984138629906447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_5013984138630025232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_orders_utr])/sum([evaluations_working_time])//SUM([total_working_hours])' />
            </column>
            <column caption='% Order Delay &gt; 10 min' datatype='real' name='[Calculation_5013984139369463841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_late_dh])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='AVG DT (min)' datatype='real' name='[Calculation_5013984139416248358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total AVTC (copy)_5013984139416109093]/SUM([dt_denominator])' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_5013984139425615912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column caption='Country ' datatype='string' name='[Country (copy)_6465409858549129219]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column caption='Last 30 Days' datatype='boolean' name='[Last 3 Days (copy) (copy)_1165517526452109318]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date_local] &gt; DATEADD(&apos;day&apos;,-30,[Parameters].[Parameter 6])&#10;and [order_date_local] &lt;= [Parameters].[Parameter 6]' />
            </column>
            <column caption='Total DT' datatype='real' hidden='true' name='[Total AVTC (copy)_5013984139416109093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_actual_delivery_time])' />
            </column>
            <column caption='Offline Hours %' datatype='real' name='[Total Offline Hours (copy)_1165517526437281793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_time])/(SUM([schedule_duration_seconds])/3600)' />
            </column>
            <column caption='Trend 30 days' datatype='string' name='[Trend 7 days (copy)_2377408039253753858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Trend 30 days&apos;' />
