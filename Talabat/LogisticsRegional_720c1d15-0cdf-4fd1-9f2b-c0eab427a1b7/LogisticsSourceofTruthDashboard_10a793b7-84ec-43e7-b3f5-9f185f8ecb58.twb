            <column caption='Orders MTD' datatype='integer' name='[Calculation_2377408040973295625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_completed_orders] END)' />
            </column>
            <column caption='% Orders DT &gt;45 mins MTD' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD (copy)_4654188759328931870]' role='measure' type='quantitative'>
