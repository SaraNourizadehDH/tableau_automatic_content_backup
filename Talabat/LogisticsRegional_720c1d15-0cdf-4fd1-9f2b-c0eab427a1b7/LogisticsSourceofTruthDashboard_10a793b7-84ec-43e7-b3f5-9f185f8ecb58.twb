              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_utr] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_utr] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_utr] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [evaluations_working_time] END))' />
