            </column>
            <column caption='exCo Metric' datatype='real' name='[Calculation_1165517526454562823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN [Calculation_5013984138629906447]&#10;    WHEN &quot;UTR&quot; THEN [Calculation_5013984138630025232]&#10;    WHEN &quot;AVG DT&quot; THEN [Calculation_5013984139416248358]&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN [AVG DT (copy)_5013984139416363047]&#10;    WHEN &quot;% Orders on time&quot; THEN [Calculation_5013984138611777543]&#10;    WHEN &quot;% Orders Late&quot; THEN [Calculation_5013984139369463841]&#10;    WHEN &quot;Supply Position&quot; THEN [AVP % (copy)_1165517526436405248]&#10;    WHEN &quot;Offline Hours %&quot; THEN [Total Offline Hours (copy)_1165517526437281793]&#10;    WHEN &quot;Shrink %&quot; THEN [% VFR (copy)_6465409858547515394]&#10;    WHEN &quot;% Orders DT &gt;45 mins&quot; THEN [AVG DT (min) (copy)_5013984138677772309]&#10;    ELSE NULL &#10;END' />
