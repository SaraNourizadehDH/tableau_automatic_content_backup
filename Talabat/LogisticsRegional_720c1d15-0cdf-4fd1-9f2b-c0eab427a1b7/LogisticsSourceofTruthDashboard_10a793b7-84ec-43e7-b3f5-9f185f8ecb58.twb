            <column-instance column='[Calculation_2485846270886223883]' derivation='None' name='[none:Calculation_2485846270886223883:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
