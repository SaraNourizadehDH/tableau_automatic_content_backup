    <worksheet name='Rider Metric - City'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SoT sources' name='federated.00kj9ah102uuxj11e5am10guaqdj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.00kj9ah102uuxj11e5am10guaqdj'>
            <column caption='Rider Late %' datatype='real' name='[AVP % (copy)_1466836483895328772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10])/[Calculation_5013984138629906447]' />
            </column>
            <column caption='Fill Rate %' datatype='real' name='[AVP % (copy)_1466836483971489804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned (Custom SQL Query5)])/SUM([open_slots_size (Custom SQL Query5)])' />
            </column>
            <column caption='AVP %' datatype='real' name='[Break % (copy)_5013984139367657501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([actual_vs_planned])/SUM([total_shifts])&#10;SUM([total_working_hours])/SUM([total_planned_working_hours])' />
            </column>
            <column caption='Date Local' datatype='date' name='[Calculation_1466836483917897737]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date_local]' />
            </column>
            <column caption='No Show %' datatype='real' name='[Calculation_5013984137949687808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_no_show_shifts])/SUM([total_evaluated_shifts])' />
            </column>
            <column caption='Late Login %' datatype='real' name='[Calculation_5013984137950056449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_late_login_shifts])/sum([total_evaluated_shifts])' />
            </column>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_5013984137950777348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5013984139368022046]/SUM([notified_count])' />
            </column>
            <column caption='Total Completed Orders' datatype='integer' name='[Calculation_5013984138629906447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_5013984138630025232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_orders_utr])/sum([evaluations_working_time])//SUM([total_working_hours])' />
            </column>
            <column caption='Break %' datatype='real' name='[Calculation_5013984139352363036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_break_hours])/(SUM([total_working_hours])+SUM([total_break_hours]))' />
            </column>
            <column caption='Total Acceptance Count' datatype='integer' name='[Calculation_5013984139368022046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepted_count]) - SUM([manual_undispatch_count])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_5013984139425648681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Metric Rider' datatype='real' name='[Calculation_6465409858192089089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;AvP&apos; THEN [Break % (copy)_5013984139367657501]&#10;WHEN &apos;No Show&apos; THEN [Calculation_5013984137949687808]&#10;WHEN &apos;Late Login&apos; THEN [Calculation_5013984137950056449]&#10;WHEN &apos;Break %&apos; THEN [Calculation_5013984139352363036]&#10;WHEN &apos;Acceptance Rate&apos; THEN [Calculation_5013984137950777348]&#10;WHEN &apos;UTR&apos; THEN [Calculation_5013984138630025232]&#10;WHEN &apos;Rider Late&apos; THEN [AVP % (copy)_1466836483895328772]&#10;WHEN &apos;Fill Rate&apos; THEN [AVP % (copy)_1466836483971489804]&#10;WHEN &apos;Rider Fraud&apos; THEN [Lack of Delivery Men % (tbd) (copy)_1466836483971731470]&#10;WHEN &apos;Suspensions&apos; THEN [Lack of Delivery Men % (tbd) (copy)_1466836483971821583]&#10;END' />
            </column>
            <column caption='City ' datatype='string' name='[City (copy)_6465409858549129220]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Country ' datatype='string' name='[Country (copy)_6465409858549129219]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column caption='Rider Fraud %' datatype='real' name='[Lack of Delivery Men % (tbd) (copy)_1466836483971731470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fraud_riders])/sum([rider_base_fraud])' />
            </column>
            <column caption='% Suspended Riders' datatype='real' name='[Lack of Delivery Men % (tbd) (copy)_1466836483971821583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([suspended_riders])/SUM([rider_base_fraud])' />
            </column>
            <column caption='Location c/z' datatype='string' name='[Location (copy)_6465409858549710856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Zone / Area (copy)_6465409858549587975] = &apos;Zone&apos; THEN [Zone (copy)_6465409858549129221]&#10;ELSEIF  [Parameters].[Zone / Area (copy)_6465409858549587975] = &apos;City&apos; THEN [City (copy)_6465409858549129220]&#10;ELSE [Country (copy)_6465409858549129219]&#10;END' />
            </column>
            <column caption='Zone ' datatype='string' name='[Zone (copy)_6465409858549129221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[zone_name]' />
            </column>
            <column datatype='integer' hidden='true' name='[accepted_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[evaluations_working_time]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[fraud_riders]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[manual_undispatch_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1466836483917897737]' derivation='None' name='[none:Calculation_1466836483917897737:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Location (copy)_6465409858549710856]' derivation='None' name='[none:Location (copy)_6465409858549710856:nk]' pivot='key' type='nominal' />
            <column datatype='integer' hidden='true' name='[notified_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[open_slots_assigned (Custom SQL Query5)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[open_slots_size (Custom SQL Query5)]' role='measure' type='quantitative' />
            <column datatype='date' name='[order_date_local]' role='dimension' type='ordinal' />
            <column datatype='integer' hidden='true' name='[rider_base_fraud]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[rider_late_10]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[suspended_riders]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_break_hours]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_completed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_evaluated_shifts]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[total_late_login_shifts]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_no_show_shifts]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders_utr]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_planned_working_hours]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_working_hours]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6465409858192089089]' derivation='User' name='[usr:Calculation_6465409858192089089:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[zone_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.00kj9ah102uuxj11e5am10guaqdj].[Action (City)]'>
            <groupfilter function='level-members' level='[Calculation_5013984139425648681]' user:ui-action-filter='[Action1_C4F6C8C4E5094F039E7720E3C2F6E342]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
