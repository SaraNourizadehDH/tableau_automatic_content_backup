          <datasource-dependencies datasource='federated.00kj9ah102uuxj11e5am10guaqdj'>
            <column caption='% Orders DT &gt;45 mins Daily WoW' datatype='real' name='[% Orders DT &gt;45 mins WTD WoW (copy)_4654188759360368677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))' />
            </column>
            <column caption='% Orders late Daily WoW' datatype='real' name='[% Orders late WTD WoW (copy)_4654188759360368673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_orders_late_dh] END) / SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_completed_orders] END)) &#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_completed_orders] END))) &#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_completed_orders] END))' />
            </column>
            <column caption='% Orders on time Daily WoW' datatype='real' name='[% Orders on time WTD WoW (copy)_4654188759360368674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_orders_on_time_dh] END) / SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [order_on_time_denominator] END))' />
            </column>
            <column caption='% Shrink Daily WoW' datatype='real' name='[% Shrink WTD WoW (copy)_4654188759360368675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [shrinked_instance] END)/SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [shrinked_instance] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [shrinked_instance] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='City Filter' datatype='boolean' name='[Calculation_1554375209498640433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Select a city] = &quot;MENA&quot; THEN TRUE ELSE &#10;[city_name] = [Parameters].[Select a country (copy)_2095933065736368128]' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) Daily WoW' datatype='real' name='[DT (&lt;= 12 mins PDT) WTD WoW (copy)_4654188759360368676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT Daily WoW' datatype='real' name='[DT WTD WoW (copy)_4654188759360368678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_actual_delivery_time] END)) / (SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))' />
            </column>
            <column caption='Offline Hours % Daily WoW' datatype='real' name='[Offline Hours % WTD WoW (copy)_4654188759360368679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [offline_time] END)/SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [offline_time] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [offline_time] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [schedule_duration_seconds]/3600 END))' />
            </column>
            <column caption='Orders Daily WoW' datatype='real' name='[Orders WTD WoW (copy)_4654188759360368680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_completed_orders] END) - SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_completed_orders] END))&#10;        /SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_completed_orders] END)' />
            </column>
            <column caption='UTR Daily WoW' datatype='real' name='[UTR WTD WoW (copy)_4654188759360368681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_orders_utr] END)/SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_utr] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_utr] END)/SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [evaluations_working_time] END))' />
            </column>
            <column caption='Daily WoW title' datatype='string' name='[WTD WoW title (copy)_4654188759363964970]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Daily WoW&apos;' />
