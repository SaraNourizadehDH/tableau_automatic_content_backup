              <calculation class='tableau' formula='(((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END)))' />
