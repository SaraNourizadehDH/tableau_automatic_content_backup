            <column caption='Offline Hours % YTD YoY' datatype='real' name='[Offline Hours % MTD MoM (copy)_4283767692324622346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [offline_time] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [offline_time] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [offline_time] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [schedule_duration_seconds]/3600 END))' />
            </column>
            <column caption='Orders YTD YoY' datatype='real' name='[Orders MTD MoM  (copy)_4283767692324622347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_completed_orders] END) - SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_completed_orders] END))&#10;/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_completed_orders] END)' />
            </column>
            <column caption='UTR YTD YTD YoY' datatype='real' name='[UTR YTD MTD MoM (copy)_4283767692324622348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_utr] END)/SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_orders_utr] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_orders_utr] END)/SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [evaluations_working_time] END))' />
            </column>
