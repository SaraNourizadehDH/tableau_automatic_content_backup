              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_late_dh] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_completed_orders] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))' />
            </column>
            <column caption='% Orders on time MTD MoM' datatype='real' name='[% Orders on time YTD (copy) (copy)_4654188759288573961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_on_time_dh] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [order_on_time_denominator] END))' />
            </column>
            <column caption='% Shrink MTD MoM' datatype='real' name='[% Shrink YTD (copy) (copy)_4654188759288573962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [shrinked_instance] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
