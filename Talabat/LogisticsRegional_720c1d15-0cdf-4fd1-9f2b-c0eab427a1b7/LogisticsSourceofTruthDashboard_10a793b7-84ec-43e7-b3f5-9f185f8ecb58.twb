            <column caption='Offline Hours % WTD WoW' datatype='real' name='[Offline Hours % YTD (copy)_4654188759288504325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [offline_time] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [offline_time] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [offline_time] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [schedule_duration_seconds]/3600 END))' />
            </column>
            <column caption='Orders WTD WoW' datatype='real' name='[Orders YTD (copy)_4654188759288504326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_completed_orders] END) - SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END))&#10;        /SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END)' />
            </column>
            <column caption='Previous Week End Date' datatype='datetime' name='[Previous Week Start Date (copy)_1554375209446260766]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Previous WTD End Date&#10;DATEADD(&apos;day&apos;, [Calculation_1554375209446895648], DATEADD(&apos;week&apos;, -1, [Calculation_1554375209445937180]))' />
