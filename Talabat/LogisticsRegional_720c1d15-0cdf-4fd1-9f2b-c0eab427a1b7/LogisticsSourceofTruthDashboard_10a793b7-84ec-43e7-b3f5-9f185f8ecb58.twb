            <column caption='Country ' datatype='string' name='[Country (copy)_6465409858549129219]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_code]' />
            </column>
            <column caption='YTD' datatype='string' name='[MTD (copy)_1554375209458487340]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN &#10;        REGEXP_REPLACE(STR(INT(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_completed_orders] END))), &quot;(?&lt;=\d)(?=(\d{3})+$)&quot;, &quot;,&quot;)&#10;    &#10;    WHEN &quot;UTR&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_utr] END)&#10;            / &#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [evaluations_working_time] END)&#10;        , 2))&#10;    &#10;    WHEN &quot;AVG DT&quot; THEN&#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)&#10;            /&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)&#10;        , 1)) + &quot; min&quot;&#10;    &#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END)&#10;            / &#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)&#10;        , 1)) + &quot; min&quot;&#10;    &#10;    WHEN &quot;% Orders on time&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_on_time_dh] END)&#10;            / &#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [order_on_time_denominator] END)&#10;        * 100, 1)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;% Orders Late&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_late_dh] END)&#10;            / &#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_completed_orders] END)&#10;        * 100, 1)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;Supply Position&quot; THEN &#10;        STR(ROUND([AVP % (copy)_1165517526436405248], 1))&#10;    &#10;    WHEN &quot;Offline Hours %&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [offline_time] END)&#10;            /&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [schedule_duration_seconds]/3600 END)&#10;        * 100, 1)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;Shrink %&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [shrinked_instance] END)&#10;            /&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [all_instances] END)&#10;        * 100, 2)) + &quot;%&quot;&#10;    &#10;    WHEN &quot;% Orders DT &gt;45 mins&quot; THEN &#10;        STR(ROUND(&#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_orders_dt_greater_than_45_min] END)&#10;            / &#10;            SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)&#10;        * 100, 1)) + &quot;%&quot;&#10;&#10;    ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='WTD WoW' datatype='real' name='[MTD MoM (copy)_1554375209448992801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN &#10;        (SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_completed_orders] END) - SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END))&#10;        /SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END)&#10;    WHEN &quot;UTR&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_utr] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_utr] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_utr] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [evaluations_working_time] END))&#10;    WHEN &quot;AVG DT&quot; THEN&#10;        (((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))&#10;&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))&#10;    WHEN &quot;% Orders on time&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_on_time_dh] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [order_on_time_denominator] END))&#10;    WHEN &quot;% Orders Late&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_late_dh] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_completed_orders] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_completed_orders] END))&#10;    WHEN &quot;Supply Position&quot; THEN &#10;        [AVP % (copy)_1165517526436405248] //tbd&#10;    WHEN &quot;Offline Hours %&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [offline_time] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [offline_time] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [offline_time] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [schedule_duration_seconds]/3600 END))&#10;    WHEN &quot;Shrink %&quot; THEN &#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [shrinked_instance] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [shrinked_instance] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [shrinked_instance] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [all_instances] END))&#10;    WHEN &apos;% Orders DT &gt;45 mins&apos; THEN&#10;        ((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_dt_greater_than_45_min] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END))&#10;        - ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))))&#10;        / ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))&#10;    ELSE NULL &#10;END' />
            </column>
            <column caption='YTD title' datatype='string' name='[MTD title (copy)_1554375209460564014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD&apos;' />
            </column>
            <column caption='Previous Week End Date' datatype='datetime' name='[Previous Week Start Date (copy)_1554375209446260766]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Previous WTD End Date&#10;DATEADD(&apos;day&apos;, [Calculation_1554375209446895648], DATEADD(&apos;week&apos;, -1, [Calculation_1554375209445937180]))' />
            </column>
            <column datatype='integer' name='[all_instances]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[dt_denominator]' role='measure' type='quantitative' />
            <column datatype='real' name='[evaluations_working_time]' role='measure' type='quantitative' />
            <column caption='MTD MoM' datatype='real' name='[exCo Metric (copy 2)_1554375209115037696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Total Completed Orders&quot; THEN &#10;        (SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_completed_orders] END) - SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))&#10;        /SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END)&#10;    WHEN &quot;UTR&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_utr] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_utr] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_utr] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [evaluations_working_time] END))&#10;    WHEN &quot;AVG DT&quot; THEN&#10;        (((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END)))&#10;&#10;    WHEN &quot;AVG DT (&lt;= 12 mins PDT)&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))&#10;    WHEN &quot;% Orders on time&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_on_time_dh] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [order_on_time_denominator] END))&#10;    WHEN &quot;% Orders Late&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_late_dh] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_completed_orders] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_late_dh] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))&#10;    WHEN &quot;Supply Position&quot; THEN &#10;        [AVP % (copy)_1165517526436405248] //tbd&#10;    WHEN &quot;Offline Hours %&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [offline_time] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [offline_time] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [offline_time] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [schedule_duration_seconds]/3600 END))&#10;    WHEN &quot;Shrink %&quot; THEN &#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [shrinked_instance] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END))&#10;    WHEN &apos;% Orders DT &gt;45 mins&apos; THEN&#10;        ((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_dt_greater_than_45_min] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))&#10;        - ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))))&#10;        / ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END)))&#10;    ELSE NULL &#10;END' />
