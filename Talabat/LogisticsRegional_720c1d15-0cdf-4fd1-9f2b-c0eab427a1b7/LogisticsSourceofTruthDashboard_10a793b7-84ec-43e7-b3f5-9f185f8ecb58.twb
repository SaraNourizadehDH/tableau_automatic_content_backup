      </column>
      <column caption='Metric Rider' datatype='real' name='[Calculation_6465409858192089089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;AvP&apos; THEN [Break % (copy)_5013984139367657501]&#10;WHEN &apos;No Show&apos; THEN [Calculation_5013984137949687808]&#10;WHEN &apos;Late Login&apos; THEN [Calculation_5013984137950056449]&#10;WHEN &apos;Break %&apos; THEN [Calculation_5013984139352363036]&#10;WHEN &apos;Acceptance Rate&apos; THEN [Calculation_5013984137950777348]&#10;WHEN &apos;UTR&apos; THEN [Calculation_5013984138630025232]&#10;WHEN &apos;Rider Late&apos; THEN [AVP % (copy)_1466836483895328772]&#10;WHEN &apos;Fill Rate&apos; THEN [AVP % (copy)_1466836483971489804]&#10;WHEN &apos;Rider Fraud&apos; THEN [Lack of Delivery Men % (tbd) (copy)_1466836483971731470]&#10;WHEN &apos;Suspensions&apos; THEN [Lack of Delivery Men % (tbd) (copy)_1466836483971821583]&#10;END' />
      </column>
      <column caption='City ' datatype='string' name='[City (copy)_6465409858549129220]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='[city_name]' />
      </column>
      <column caption='Country Filter' datatype='boolean' name='[City Filter (copy)_2095933065737691137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;MENA&quot; THEN TRUE ELSE &#10;[country_code] = [Parameters].[Parameter 9]&#10;END' />
      </column>
      <column caption='Country ' datatype='string' name='[Country (copy)_6465409858549129219]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_code]' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) YTD' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD (copy)_1554375209505427515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END))' />
      </column>
      <column caption='% Orders DT &gt;45 mins MTD' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD (copy)_4654188759328931870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) YTD YoY' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD MoM (copy)_4283767692324622344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END))' />
      </column>
      <column caption='% Orders DT &gt;45 mins MTD MoM' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD MoM (copy)_4654188759328931869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) Daily WoW' datatype='real' name='[DT (&lt;= 12 mins PDT) WTD WoW (copy)_4654188759360368676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [same_day_last_week main (copy)_4654188759304216599] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_week main (copy)_4654188759303557139] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) MTD MoM' datatype='real' name='[DT (&lt;= 12 mins PDT) YTD (copy) (copy)_4654188759288573963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) WTD WoW' datatype='real' name='[DT (&lt;= 12 mins PDT) YTD (copy)_4654188759288504323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT (&lt;= 12 mins PDT) MTD' datatype='real' name='[DT MTD (copy)_1554375209146003470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))' />
      </column>
      <column caption='DT YTD' datatype='real' name='[DT MTD (copy)_1554375209505427516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END)))' />
      </column>
      <column caption='DT YTD YoY' datatype='real' name='[DT MTD MoM (copy)_4283767692324622345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209457987625] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month (copy)_4283767692323512321] THEN [dt_denominator] END)))' />
