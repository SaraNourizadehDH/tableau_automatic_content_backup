              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [shrinked_instance] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [shrinked_instance] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[City Filter (copy)_2095933065737691137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;MENA&quot; THEN TRUE ELSE &#10;[country_code] = [Parameters].[Parameter 9]&#10;END' />
            </column>
            <column caption='% Orders DT &gt;45 mins MTD MoM' datatype='real' name='[DT (&lt;= 12 mins PDT) MTD MoM (copy)_4654188759328931869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_dt_greater_than_45_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) MTD MoM' datatype='real' name='[DT (&lt;= 12 mins PDT) YTD (copy) (copy)_4654188759288573963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END))' />
            </column>
            <column caption='DT MTD MoM' datatype='real' name='[DT YTD (copy) (copy)_4654188759288573964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [dt_denominator] END)))' />
            </column>
            <column caption='MTD MoM title' datatype='string' name='[MTD title (copy)_4654188759291879440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD MoM&apos;' />
            </column>
            <column caption='Offline Hours % MTD MoM' datatype='real' name='[Offline Hours % YTD (copy) (copy)_4654188759288573965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [offline_time] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [schedule_duration_seconds]/3600 END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [offline_time] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [schedule_duration_seconds]/3600 END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [offline_time] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [schedule_duration_seconds]/3600 END))' />
            </column>
            <column caption='Orders MTD MoM ' datatype='real' name='[Orders YTD (copy) (copy)_4654188759288573966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_completed_orders] END) - SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END))&#10;/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_completed_orders] END)' />
            </column>
            <column caption='UTR YTD MTD MoM' datatype='real' name='[UTR YTD (copy) (copy)_4654188759288573967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [total_orders_utr] END)/SUM(IF [is_current_month sq5 (copy)_1554375209142280204] THEN [evaluations_working_time] END))&#10;        - (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_utr] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [evaluations_working_time] END)))&#10;        / (SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [total_orders_utr] END)/SUM(IF [is_previous_month sq5 (copy)_1554375209142280203] THEN [evaluations_working_time] END))' />
            </column>
            <column datatype='integer' name='[all_instances]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[dt_denominator]' role='measure' type='quantitative' />
            <column datatype='real' name='[evaluations_working_time]' role='measure' type='quantitative' />
            <column caption='is_current_month' datatype='boolean' name='[is_current_month sq5 (copy)_1554375209142280204]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [order_date_local], [Parameters].[Parameter 6]) = 0&#10;AND DAY([order_date_local]) &lt;= DAY([Parameters].[Parameter 6])' />
            </column>
            <column caption='is_previous_month' datatype='boolean' name='[is_previous_month sq5 (copy)_1554375209142280203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date_local] &gt;= DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 6]))&#10;AND [order_date_local] &lt; DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 6])&#10;AND DAY([order_date_local]) &lt;= DAY([Parameters].[Parameter 6])' />
            </column>
