            <column caption='% Orders on time WTD WoW' datatype='real' name='[% Orders on time YTD (copy)_4654188759288504321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_on_time_dh] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [order_on_time_denominator] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [order_on_time_denominator] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_on_time_dh] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [order_on_time_denominator] END))' />
            </column>
            <column caption='% Shrink WTD WoW' datatype='real' name='[% Shrink YTD (copy)_4654188759288504322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [shrinked_instance] END)/SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [all_instances] END))&#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [shrinked_instance] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [all_instances] END)))&#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [shrinked_instance] END)/SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [all_instances] END))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_1165517526451916804]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX([order_date_local])}' />
            </column>
            <column caption='Week Start Date' datatype='datetime' name='[Calculation_1554375209445937180]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,&#10;  -1 * ((DATEPART(&apos;weekday&apos;, [Parameters].[Parameter 6]) - INT([Parameters].[Parameter 8]) + 7) % 7),&#10;  [Parameters].[Parameter 6]&#10;)' />
            </column>
            <column caption='Previous Week Start Date' datatype='datetime' name='[Calculation_1554375209446162461]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;week&apos;, -1, [Calculation_1554375209445937180])' />
            </column>
            <column caption='Week Day Offset' datatype='integer' name='[Calculation_1554375209446895648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_1554375209445937180], [Parameters].[Parameter 6])' />
            </column>
            <column caption='City Filter' datatype='boolean' name='[Calculation_1554375209498640433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Select a city] = &quot;MENA&quot; THEN TRUE ELSE &#10;[city_name] = [Parameters].[Select a country (copy)_2095933065736368128]' />
            </column>
            <column caption='DT (&lt;= 12 mins PDT) WTD WoW' datatype='real' name='[DT (&lt;= 12 mins PDT) YTD (copy)_4654188759288504323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END)) &#10;        - (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))) &#10;        / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_dt_dtp_lower_than_12_min] END) / SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END))' />
            </column>
            <column caption='% Orders DT &gt;45 mins WTD WoW' datatype='real' name='[DT WTD WoW (copy)_4654188759329976351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_orders_dt_greater_than_45_min] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))' />
            </column>
            <column caption='DT WTD WoW' datatype='real' name='[DT YTD (copy)_4654188759288504324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_current_month main (copy)_1554375209444986902] THEN [dt_denominator] END))) &#10;        - ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))) &#10;        / ((SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [total_actual_delivery_time] END)) / (SUM(IF [is_previous_month main (copy)_1554375209444986906] THEN [dt_denominator] END)))' />
