      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Jordan' id='_FA0AE187E60545AEA1E91DA08D14DBC5'>
            <properties context=''>
              <relation connection='bigquery.1acey7i1d3z4b017yj3b80gti1vw' name='Custom SQL Query' type='text'>/* ====================================================================== */
/* 1 ─ Sessions that triggered the address-error            */
/* ====================================================================== */
WITH sessions AS (
  SELECT
    f.session_id,
    f.device_id,
    f.user_id,
    f.location_lat,
    f.location_lon,
    jslibs.h3.ST_H3(
        ST_GEOGPOINT(CAST(f.location_lon AS FLOAT64),
                     CAST(f.location_lat AS FLOAT64)),
        9)                                   AS location_hex,
    f.date                                   AS session_date,
    dli.city_name,
    dli.country_code
  FROM  `tlb-data-prod.data_platform.fct_hit`                AS f
  JOIN  `tlb-data-prod.data_platform.dim_app`                AS da  ON da.app_id = f.app_id
  JOIN  `tlb-data-prod.data_platform.dim_session_event`      AS dse ON dse.session_event_id = f.session_event_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`  AS dli ON dli.location_id      = f.location_id
  WHERE f.map_error_message            = &apos;MapErrorMessage.outOfDelivery&apos;
    AND dse.event_action               = &apos;address_error.shown&apos;
    AND da.app_version BETWEEN &apos;12.34.0&apos; AND &apos;12.99.99&apos;
    AND lower(f.country_code)                 = &apos;jo&apos;
    AND f.date                        &gt;&gt;= &apos;2025-01-01&apos;
),

/* ====================================================================== */
/* 2 ─ Explode every area_polygon into its *polygon* parts only           */
/* ====================================================================== */
area_polygons AS (
  SELECT
    l.location_id,
    l.country_code,
    l.city_name,
    l.area_name,
    part_geog                       AS poly             -- single POLYGON/MULTIPOLYGON
  FROM `tlb-data-prod.data_platform.dim_location_info` AS l
  -- keep only valid BH polygons
  CROSS JOIN UNNEST(
               -- ST_DUMP returns every component;
               -- we filter to POLYGON &amp; MULTIPOLYGON
               ARRAY(
                 SELECT p
                 FROM UNNEST( ST_DUMP( ST_GEOGFROMTEXT(l.area_polygon) ) ) AS p
                 WHERE ST_GEOMETRYTYPE(p) LIKE &apos;POLYGON%&apos;
               )
             ) AS part_geog
  WHERE l.is_valid_area_polygon = TRUE
    AND l.country_code          = &apos;JO&apos;
),

/* ====================================================================== */
/* 3 ─ Poly-fill each polygon part (res-9) and dedupe hex IDs             */
/* ====================================================================== */
area_hex AS (
  SELECT DISTINCT
    location_id,
    hex
  FROM area_polygons
  CROSS JOIN UNNEST(
               jslibs.h3.ST_H3_POLYFILLFROMGEOG(poly, 9)
             ) AS hex
),

/* ====================================================================== */
/* 4 ─ Count devices per hex that lies *outside* every delivery area      */
/* ====================================================================== */
agg AS (
  SELECT
    EXTRACT(MONTH FROM session_date) AS session_month,
    country_code,
    city_name,
    location_hex,
    COUNT(DISTINCT device_id)        AS devices,
    COUNT(DISTINCT session_id)      AS sessions
  FROM sessions
  WHERE location_hex NOT IN (SELECT hex FROM area_hex)
  GROUP BY session_month, country_code, location_hex,city_name
  HAVING COUNT(DISTINCT device_id) &gt;&gt; 4
)

/* ====================================================================== */
/* 5 ─ Final output at H3 resolution-7                                    */
/* ====================================================================== */
SELECT
  session_month,
  country_code,
  city_name,
  jslibs.h3.h3ToParent(location_hex, 7)  AS large_hex,
  ST_AsText(
  jslibs.h3.ST_GEOGPOINTFROMH3(
    jslibs.h3.h3ToParent(location_hex, 7)
  )
) AS large_hex_centroid,
  jslibs.h3.ST_H3_BOUNDARY(location_hex) AS location_hex_9_geom,
  location_hex,
  devices,
  sessions
FROM agg</relation>
            </properties>
