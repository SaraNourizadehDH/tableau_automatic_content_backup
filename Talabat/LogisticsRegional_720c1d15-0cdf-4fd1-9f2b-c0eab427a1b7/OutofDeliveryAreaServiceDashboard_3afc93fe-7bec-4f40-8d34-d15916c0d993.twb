WITH sessions AS (
  SELECT
    f.session_id,
    f.device_id,
    f.user_id,
    f.location_lat,
    f.location_lon,
    jslibs.h3.ST_H3(
        ST_GEOGPOINT(CAST(f.location_lon AS FLOAT64),
