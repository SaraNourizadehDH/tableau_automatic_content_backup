      <aliases enabled='yes' />
      <column caption='Notified Deliveries' datatype='integer' name='[Calculation_699746849995485184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( if [NotifiedTime] &gt; 0 then [delivery_id] END )' />
      </column>
      <column caption='Accepted Deliveries' datatype='integer' name='[Calculation_699746849996193793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( if [AcceptedTime]&gt;0 then [delivery_id] end )' />
      </column>
      <column caption='Accept Rate' datatype='real' name='[Calculation_699746849996279810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([AcceptedTime])/sum([NotifiedTime])' />
      </column>
      <column caption='PU distance km' datatype='real' name='[Calculation_699746850019377155]' role='measure' type='quantitative'>
