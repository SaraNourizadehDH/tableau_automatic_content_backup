      <aliases enabled='yes' />
      <column caption='HBT' datatype='real' name='[Calculation_1205838866341376000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([HBT])/sum([TotalDeliveries])' />
      </column>
      <column caption='total_deliveries' datatype='integer' name='[Calculation_801077848078372868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveries])' />
      </column>
      <column caption='DT' datatype='real' name='[Calculation_801077848079106054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalDeliveryTime])/sum([TotalDeliveries])' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_801077848079618055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveries])/sum([EvaluatedHours])' />
      </column>
      <column caption='idle_time' datatype='real' name='[Calculation_801077848079912968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([BusyTime])/SUM([EvaluatedHours]))' />
      </column>
      <column caption='% stacking' datatype='real' name='[Calculation_801077848080080905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([SingleStackedOrders])+sum([DoubleStackedStackedTotalOrders])+sum([TripleMoreStackedStackedTotalOrders]))/sum([TotalOrders])' />
      </column>
      <column caption='delivery_delay' datatype='real' name='[Calculation_801077848080396298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveryDelay])/sum([TotalDeliveries])' />
      </column>
      <column caption='manual_shifts %' datatype='real' name='[Calculation_801077848082518027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalManualShifts])/sum([TotalShifts])' />
      </column>
      <column caption='PU_km' datatype='real' name='[Calculation_801077848115146764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalPU_Dist_KM])/sum([TotalDeliveries])' />
      </column>
      <column caption='DO_km' datatype='real' name='[Calculation_801077848115363853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDO_Dist_KM])/sum([TotalDeliveries])' />
      </column>
      <column caption='#Riders' datatype='real' name='[Calculation_801077848119955472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code], [city_name], [zone_name],[VehicleBag], [VehicleProfile], [VehicleName] : AVG([RiderCount])}' />
      </column>
      <column caption='week' datatype='string' name='[Calculation_801077848122900497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([OrderDate]))+ &apos;-&apos; + STR(WEEK([OrderDate]))' />
      </column>
      <column caption='HBT_total' datatype='real' name='[HBT]' role='measure' type='quantitative' />
      <column datatype='date' name='[OrderDate (Exact)]' role='dimension' type='quantitative' user:agg-type='None' user:base-field='OrderDate' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='[OrderDate]' />
      </column>
      <column datatype='date' default-format='*yyyy-mm-dd' name='[OrderDate]' role='dimension' type='ordinal' />
