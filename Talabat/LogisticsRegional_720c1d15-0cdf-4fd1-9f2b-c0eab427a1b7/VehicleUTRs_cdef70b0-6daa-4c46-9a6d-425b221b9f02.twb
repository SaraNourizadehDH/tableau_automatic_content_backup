      <aliases enabled='yes' />
      <column caption='TotalDeliveries_' datatype='integer' name='[Calculation_3547429192962527232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveries])' />
      </column>
      <column caption='DT' datatype='real' name='[Calculation_3547429192963342338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveryTime])/sum([TotalDeliveries])' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_3547429192963751939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveries])/sum([EvaluatedHours])' />
      </column>
      <column caption='EvaluatedHoursAGG' datatype='real' name='[Calculation_3547429192964067332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([EvaluatedHours])' />
      </column>
      <column caption='HBT' datatype='real' name='[Calculation_3547429192964935685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalHBT])/sum([TotalDeliveries])' />
      </column>
      <column caption='ToVendorTime' datatype='real' hidden='true' name='[Calculation_3547429192968667142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalRiderToVendorTime])/sum([TotalDeliveries])' />
      </column>
      <column caption='#RidersStaffed' datatype='real' name='[Calculation_3547429193021911047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([totalRiders])' />
      </column>
      <column caption='ColumnDim' datatype='string' name='[Calculation_3547429193023086600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN STR([OrderDate])&#13;&#10;WHEN &apos;Weekday&apos; THEN STR(DATENAME(&quot;weekday&quot;,[OrderDate]))&#13;&#10;WHEN &apos;Week&apos; THEN STR(YEAR([OrderDate]))+ &apos;-&apos; + STR(WEEK([OrderDate]))&#13;&#10;WHEN &apos;Hour&apos; then STR(datepart(&apos;hour&apos;, [OrderPlacedHour]))&#13;&#10;WHEN &apos;None&apos; THEN null&#13;&#10;END' />
      </column>
      <column caption='AtVendorTime' datatype='real' hidden='true' name='[Calculation_3547429193028722699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalAt_Customer_Time_Mins])/sum([TotalDeliveries])' />
      </column>
      <column caption='AtVendorTimeCleaned' datatype='real' hidden='true' name='[Calculation_3547429193029279756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalAt_Vendor_Time_Cleaned])/sum([TotalDeliveries])' />
      </column>
      <column caption='%ManualShifts' datatype='real' name='[Calculation_3547429193632010253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalManualShifts])/sum([TotalShifts])' />
      </column>
      <column caption='%HurrierShifts' datatype='real' name='[Calculation_3547429193632641038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalHurrierShifts])/sum([TotalShifts])' />
      </column>
      <column caption='Hour' datatype='string' name='[Calculation_3547429193633087503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(datepart(&apos;hour&apos;, [OrderPlacedHour]))' />
      </column>
      <column caption='%ApplicationShifts' datatype='real' name='[Calculation_3547429193634209808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalApplicationShifts])/sum([TotalShifts])' />
      </column>
      <column caption='%SwapShifts' datatype='real' name='[Calculation_3547429193634316305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalSwapShifts])/sum([TotalShifts])' />
      </column>
      <column caption='PU_dist' datatype='real' name='[Calculation_3547429193635242002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalPU_Dist_KM])/sum([TotalDeliveries])' />
      </column>
      <column caption='DO_dist' datatype='real' name='[Calculation_3547429193637482515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDO_Dist_KM])/sum([TotalDeliveries])' />
      </column>
      <column caption='%singleStackedO' datatype='real' name='[Calculation_3547429193639698453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([SingleStackedTotalOrders])/sum([TotalOrderss__])' />
      </column>
      <column caption='%doubleStackedO' datatype='real' name='[Calculation_3547429193639940118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([DoubleStackedStackedTotalOrders])/sum([TotalDeliveries])' />
      </column>
      <column caption='%TripleMoreStacked' datatype='real' name='[Calculation_3547429193640275991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TripleMoreStackedStackedTotalOrders])/sum([TotalDeliveries])' />
      </column>
      <column caption='%StackedOrders' datatype='real' name='[Calculation_3547429193645355032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([SingleStackedTotalOrders])+sum([DoubleStackedStackedTotalOrders])+sum([TripleMoreStackedStackedTotalOrders]))/sum([TotalOrderss__])' />
      </column>
      <column caption='RowDimension' datatype='string' name='[Calculation_3547429193651343385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Day&apos; THEN STR([OrderDate])&#13;&#10;WHEN &apos;Weekday&apos; THEN STR(DATENAME(&quot;weekday&quot;,[OrderDate]))&#13;&#10;WHEN &apos;Week&apos; THEN STR(YEAR([OrderDate]))+ &apos;-&apos; + STR(WEEK([OrderDate]))&#13;&#10;END' />
      </column>
      <column caption='OrderWeek' datatype='string' name='[Calculation_3547429193657483291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([OrderDate]))+ &apos;-&apos; + STR(WEEK([OrderDate]))' />
      </column>
      <column caption='#Shift' datatype='integer' name='[Calculation_3547429193660157980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalShifts])' />
      </column>
      <column caption='DeliveryDelay' datatype='real' name='[Calculation_3547429193661108254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TotalDeliveryDelay])/sum([TotalDeliveries])' />
      </column>
      <column caption='IdleTime' datatype='real' name='[Calculation_3547429193853243425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([BusyTime])/SUM([EvaluatedHours]))' />
      </column>
      <column caption='DailyRiders' datatype='real' name='[Calculation_801077848047632385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[totalRiders]/[TotalDeliveries]' />
