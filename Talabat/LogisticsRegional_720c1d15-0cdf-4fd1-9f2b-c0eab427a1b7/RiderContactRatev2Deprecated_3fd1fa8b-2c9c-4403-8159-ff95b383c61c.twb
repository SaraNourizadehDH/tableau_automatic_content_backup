              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>First contact resolved orders: </run>
              <run fontsize='12'>Contacts for unique orders that were resolved within 10 minutes, and non-order related that were resolved within 10 minutes</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Unique Combinations: </run>
              <run fontsize='12'>Counts the combined contacts within 10 minutes timeframe</run>
