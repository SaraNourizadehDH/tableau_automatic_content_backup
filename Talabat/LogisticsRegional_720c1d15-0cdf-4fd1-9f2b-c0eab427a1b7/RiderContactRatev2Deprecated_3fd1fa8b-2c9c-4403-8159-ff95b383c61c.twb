    <worksheet name='Over Time Per Vehicle FCR'>
      <table>
        <view>
          <datasources>
            <datasource caption='logistics_performance_rcr (dwh_bl.logistics_performance_rcr) (dwh_bl)' name='federated.0wkysht0wy0kk31e3x8hu1gygrf0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
            <column caption='FCR Definition' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order &amp; Reason&quot;'>
              <calculation class='tableau' formula='&quot;Order &amp; Reason&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wkysht0wy0kk31e3x8hu1gygrf0'>
            <column caption='Date' datatype='date' name='[Calculation_1546986537613287424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[report_day]))' />
            </column>
            <column caption='FCR Order reason ' datatype='real' default-format='p0.00%' name='[Calculation_1586322638477471745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_reason_fcr_count])/sum([order_reason_cr_count])' />
            </column>
            <column caption='FCR 5 Minutes' datatype='real' default-format='p0.00%' name='[Calculation_1586322638871437315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_fcr_count_time_5])/sum([order_fcr_count_time_5]+[order_none_fcr_count_time_5])' />
            </column>
            <column caption='FCR' datatype='real' default-format='p0.00%' name='[Calculation_1586322639506604037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;Order &amp; Reason&apos; then [Calculation_1586322638477471745]&#10;when &apos;Order&apos; then [GST FCR (copy)_1586322638863228930]&#10;when &apos;Time - 5minutes&apos; then [Calculation_1586322638871437315]&#10;when &apos;Time - 10 minutes&apos; then [FCR 5 Minutes (copy)_1586322638871777284]&#10;end' />
            </column>
            <column caption='FCR 10 Minutes ' datatype='real' default-format='p0.00%' name='[FCR 5 Minutes (copy)_1586322638871777284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_fcr_count_time_10])/sum([order_fcr_count_time_10]+[order_none_fcr_count_time_10])' />
            </column>
            <column caption='Orders FCR' datatype='real' default-format='p0.00%' name='[GST FCR (copy)_1586322638863228930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_fcr_count])/sum([order_cr_count])' />
            </column>
            <column datatype='string' name='[agent_email]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Contact Reason L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Dont Unselect for Riders (NULL)' />
              </aliases>
            </column>
            <column caption='Contract Name' datatype='string' name='[contract_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1546986537613287424]' derivation='None' name='[none:Calculation_1546986537613287424:qk]' pivot='key' type='quantitative' />
            <column-instance column='[agent_email]' derivation='None' name='[none:agent_email:nk]' pivot='key' type='nominal' />
