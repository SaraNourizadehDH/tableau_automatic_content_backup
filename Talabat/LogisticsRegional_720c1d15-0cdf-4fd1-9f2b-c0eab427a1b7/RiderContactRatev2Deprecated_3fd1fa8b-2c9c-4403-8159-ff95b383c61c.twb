      <aliases enabled='yes' />
      <column caption='# of Orders (overall)' datatype='integer' default-format='n#,##0;-#,##0' name='[# of Orders (copy)_1332221065619664896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE  [rider_id],[rider_name],[contact_reason_l1],[contact_reason_l2],[vendor_id],[vendor_name]:sum([orders_count])}' />
      </column>
      <column caption='# of Orders (Rider)' datatype='integer' default-format='n#,##0;-#,##0' name='[# of Orders (overall) (copy)_769834062508343298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE   [contact_reason_l1],[contact_reason_l2]:sum(&#13;&#10;&#13;&#10;&#13;&#10;{ FIXED [country],[zone_name],[city],[rider_id],[rider_name],[report_day]:sum([orders_count])})}' />
      </column>
      <column caption='vehicle null' datatype='boolean' name='[Calculation_1075375188206616576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([vehicle_profile])' />
      </column>
      <column caption='rider id null' datatype='boolean' name='[Calculation_1075375188215353345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='isnull([rider_id])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1546986537613287424]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[report_day]))' />
      </column>
      <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1546986537613488129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(sum([cr_count])=0) then 0&#13;&#10;ELSEIF (sum({ FIXED [country],[zone_name],[city],[report_day],[rider_id],[rider_name]:sum([orders_count])})=0) then 1&#13;&#10;else sum([cr_count])/&#13;&#10;&#13;&#10;sum({ FIXED [country],[zone_name],[city],[report_day],[rider_id],[rider_name]:sum([orders_count])})&#13;&#10;end' />
      </column>
      <column caption='FCR Order reason ' datatype='real' default-format='p0.00%' name='[Calculation_1586322638477471745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_reason_fcr_count])/sum([order_reason_cr_count])' />
      </column>
      <column caption='FCR 5 Minutes' datatype='real' default-format='p0.00%' name='[Calculation_1586322638871437315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_fcr_count_time_5])/sum([order_fcr_count_time_5]+[order_none_fcr_count_time_5])' />
      </column>
      <column caption='FCR' datatype='real' default-format='p0.00%' name='[Calculation_1586322639506604037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;Order &amp; Reason&apos; then [Calculation_1586322638477471745]&#10;when &apos;Order&apos; then [GST FCR (copy)_1586322638863228930]&#10;when &apos;Time - 5minutes&apos; then [Calculation_1586322638871437315]&#10;when &apos;Time - 10 minutes&apos; then [FCR 5 Minutes (copy)_1586322638871777284]&#10;end' />
      </column>
      <column aggregation='Sum' caption='Rider Tenure' datatype='real' name='[Calculation_3994763286638309376]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [country],[rider_id]:max([tenure])}' />
