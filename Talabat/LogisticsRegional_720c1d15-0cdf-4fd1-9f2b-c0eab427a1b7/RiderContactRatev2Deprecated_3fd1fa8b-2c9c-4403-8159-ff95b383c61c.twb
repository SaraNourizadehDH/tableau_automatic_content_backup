          <zone forceUpdate='true' h='98400' id='3' type-v2='text' w='98400' x='800' y='800'>
            <formatted-text>
              <run bold='true' fontsize='14'>FCR (First Contact Resolution)</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>Order &amp; Reason</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>The calculation of FCR here is based on contacts for the same order and under the same L2 Reason</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>First contact resolved orders: </run>
              <run fontsize='12'>Contacts for a unique order and reason that were resolved from the first contact</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Unique Combinations: </run>
              <run fontsize='12'>Counts the distinct combinations of orders and reasons that had a corresponding contact</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>FCR: </run>
              <run fontsize='12'>First contact resolved orders/</run>
              <run fontsize='12'>Unique Combinations</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>Order</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>The calculation of FCR here is based on contacts for the same order</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>First contact resolved orders: </run>
              <run fontsize='12'>Contacts for unique orders that were resolved from the first contact</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Unique Combinations: </run>
              <run fontsize='12'>Counts the distinct orders that had a corresponding contact</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>FCR: </run>
              <run fontsize='12'>First contact resolved orders/</run>
              <run fontsize='12'>Unique Combinations</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>Time - 5 minutes</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>The calculation of FCR here is based on the existance of another contact within 5 minutes</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>First contact resolved orders: </run>
              <run fontsize='12'>Contacts for unique orders that were resolved within 5 minutes, and non-order related that were resolved within 5 minutes</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Unique Combinations: </run>
              <run fontsize='12'>Counts the combined contacts within 5 minutes timeframe</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>FCR: </run>
              <run fontsize='12'>First contact resolved orders/</run>
              <run fontsize='12'>Unique Combinations</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='14'>Time - 10 minutes</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>The calculation of FCR here is based on the existance of another contact within 10 minutes</run>
