      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0ifzug20cw4u7f1eboj681co2sei' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Axis Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;drive time&quot;'>
              <calculation class='tableau' formula='&quot;drive time&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ifzug20cw4u7f1eboj681co2sei'>
            <column caption='Axis Selected' datatype='string' name='[Calculation_186336501646532612]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;week&apos; then [Calculation_1932044295167803403]&#13;&#10;WHEN &apos;drive time&apos; then STR([porygon_drive_time])&#13;&#10;END' />
            </column>
            <column caption='Net Fail Rate' datatype='real' name='[Calculation_1932044295166656522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([net_failed_orders])/sum([order_count])' />
            </column>
            <column caption='Weeks' datatype='string' name='[Calculation_1932044295167803403]' role='dimension' type='nominal'>
