      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[avg:da_area_km2:qk]&quot;' value='DA Area km2' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[avg:max_dtp:vtmax:qk]&quot;' value='Avg. DTP' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[max:max_dtp:vtmax:qk]&quot;' value='Max DTP' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[sum:fct_completed_order_count:qk]&quot;' value='Completed Orders' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[usr:Calculation_1232016033060499458:qk]&quot;' value='Ord. Late 10' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[usr:Calculation_1932044295165784069:qk]&quot;' value='Retention 7Days' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[usr:Calculation_1932044295165972486:qk]&quot;' value='Retention 14Days' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[usr:Calculation_1932044295166484489:qk]&quot;' value='Fail Rate %' />
          <alias key='&quot;[federated.0ifzug20cw4u7f1eboj681co2sei].[usr:Calculation_1932044295166656522:qk]&quot;' value='NFR%' />
        </aliases>
      </column>
      <column caption='Metric Selection' datatype='real' name='[Calculation_1208653558409109504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Completed Orders&quot; then sum([fct_completed_order_count])&#13;&#10;WHEN &quot;Fail Rate&quot; then [Calculation_1232016033061908483]*1.0&#13;&#10;WHEN &quot;DT&quot; then [Calculation_1414411817756065792]*1.0&#13;&#10;WHEN &quot;Retention&quot; then [Calculation_1932044295165784069]*1.0&#13;&#10;WHEN &quot;Distance CPO&quot; then [Calculation_1232016033082957834]*1.0&#13;&#10;WHEN &quot;Order Late&quot; then [Calculation_1232016033060499458]*1.0&#13;&#10;WHEN &quot;Net Fail Rate&quot; then [Calculation_1932044295166656522]*1.0&#13;&#10;WHEN &quot;Rider Late&quot; then [Calculation_1414411817778806787]*1.0&#13;&#10;WHEN &quot;Effective Fee&quot; then [Calculation_1232016033081651209]*1.0&#13;&#10;WHEN &quot;Delivery Fee&quot; then [Calculation_1932044295166263304]*1.0&#13;&#10;WHEN &quot;On Time %&quot; then [Calculation_1232016033053376512]*1.0&#13;&#10;WHEN &quot;DO Distance&quot; then [Calculation_1232016033076744200]*1.0&#13;&#10;WHEN &quot;Total Rider CPO&quot; then [Calculation_1232016033195364364]*1.0&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_1208653558418739201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(STR([year])+ &quot; - &quot; + STR (&#13;&#10;CASE DATEPART(&apos;month&apos;,[order_date])&#13;&#10;&#13;&#10;    WHEN 1 THEN &apos;Jan&apos;&#13;&#10;&#13;&#10;    WHEN 2 THEN &apos;Feb&apos;&#13;&#10;&#13;&#10;    WHEN 3 THEN &apos;Mar&apos;&#13;&#10;&#13;&#10;    WHEN 4 THEN &apos;Apr&apos;&#13;&#10;&#13;&#10;    WHEN 5 THEN &apos;May&apos;&#13;&#10;&#13;&#10;    WHEN 6 THEN &apos;Jun&apos;&#13;&#10;&#13;&#10;    WHEN 7 THEN &apos;Jul&apos;&#13;&#10;&#13;&#10;    WHEN 8 THEN &apos;Aug&apos;&#13;&#10;&#13;&#10;    WHEN 9 THEN &apos;Sep&apos;&#13;&#10;&#13;&#10;    WHEN 10 THEN &apos;Oct&apos;&#13;&#10;&#13;&#10;    WHEN 11 THEN &apos;Nov&apos;&#13;&#10;&#13;&#10;    WHEN 12 THEN &apos;Dec&apos;&#13;&#10;&#13;&#10;END))' />
      </column>
      <column caption='On Time %' datatype='real' name='[Calculation_1232016033053376512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([on_time])/sum([order_delay_count])' />
      </column>
      <column caption='OL10' datatype='real' name='[Calculation_1232016033060499458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delay_10])/sum([order_delay_count])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_1232016033061908483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([order_count])' />
      </column>
      <column caption='To Customer Time' datatype='real' name='[Calculation_1232016033065713670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([to_customer_time])/60.0/sum([to_customer_time_count])' />
      </column>
      <column caption='DO distance' datatype='real' name='[Calculation_1232016033076744200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dropoff_distance_manhattan])/1000.0/sum([dropoff_distance_manhattan_count])' />
      </column>
      <column caption='Effective Fee' datatype='real' name='[Calculation_1232016033081651209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([delivery_fee_amount_lc])+sum([service_fee_amount_lc]))*1.0/sum([fct_completed_order_count])' />
      </column>
      <column caption='Distance CPO' datatype='real' name='[Calculation_1232016033082957834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_earnings_total_basic_distance])*1.0/sum([fct_completed_order_count])' />
      </column>
      <column caption='Total Rider CPO' datatype='real' name='[Calculation_1232016033195364364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_earnings_total])/sum([fct_completed_order_count])' />
      </column>
      <column caption='DT' datatype='real' name='[Calculation_1414411817756065792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([DT])/60.0/sum([fct_completed_order_count])' />
      </column>
      <column caption='ATVC' datatype='real' name='[Calculation_1414411817772285953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([at_vendor_time_cleaned])/60/sum([atvc_order_count])' />
      </column>
      <column caption='RD&gt;10%' datatype='real' name='[Calculation_1414411817778806787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_late_10])/sum([rider_late_count])' />
      </column>
      <column caption='DA_size' datatype='real' name='[Calculation_186336501641871360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([da_area_km2])/COUNTD([vendor_code])' />
      </column>
      <column caption='Axis Selected' datatype='string' name='[Calculation_186336501646532612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;week&apos; then [Calculation_1932044295167803403]&#13;&#10;WHEN &apos;drive time&apos; then STR([porygon_drive_time])&#13;&#10;END' />
      </column>
      <column caption='View Covg By' datatype='real' name='[Calculation_186336501763846149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;DTP&quot; then [max_dtp]&#13;&#10;WHEN &quot;DA Size&quot; then [da_area_km2]&#13;&#10;END' />
      </column>
      <column caption='Retention7Days' datatype='real' name='[Calculation_1932044295165784069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([prev_order_id_7_days])/sum([order_count])' />
      </column>
      <column caption='Retention14Days' datatype='real' name='[Calculation_1932044295165972486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([prev_order_id_14_days])/sum([order_count])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1932044295166136327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_amount_lc])/sum([fct_completed_order_count])' />
      </column>
      <column caption='DF' datatype='real' name='[Calculation_1932044295166263304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_fee_amount_lc])/sum([fct_completed_order_count])' />
      </column>
      <column caption='FR' datatype='real' name='[Calculation_1932044295166484489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([order_count])' />
      </column>
      <column caption='Net Fail Rate' datatype='real' name='[Calculation_1932044295166656522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_failed_orders])/sum([order_count])' />
      </column>
      <column caption='Weeks' datatype='string' name='[Calculation_1932044295167803403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([year])+&quot;-&quot;+STR([week])' />
      </column>
      <column caption='Commission' datatype='real' name='[Calculation_1932044295223963660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([commission_amount_lc])/sum([fct_completed_order_count])' />
      </column>
      <column caption='Vendor Count' datatype='integer' name='[Calculation_2342153338784100353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Delivery Time' datatype='integer' name='[DT]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_A02A9321BC9442DCBB17D1D1FE0C6F3A]' role='measure' type='quantitative' />
      <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
