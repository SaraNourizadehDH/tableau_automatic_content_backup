            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ifzug20cw4u7f1eboj681co2sei'>
            <column caption='To Customer Time' datatype='real' name='[Calculation_1232016033065713670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_customer_time])/60.0/sum([to_customer_time_count])' />
