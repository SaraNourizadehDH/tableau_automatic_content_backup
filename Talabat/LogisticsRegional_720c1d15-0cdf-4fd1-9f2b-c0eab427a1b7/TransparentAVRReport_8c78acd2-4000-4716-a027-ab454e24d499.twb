    <worksheet name='Eff Fee AVR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Sitka Banner'>Effective Fee [(DF+SF)/OrdersCompleted]</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0ifzug20cw4u7f1eboj681co2sei' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Axis Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;drive time&quot;'>
              <calculation class='tableau' formula='&quot;drive time&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ifzug20cw4u7f1eboj681co2sei'>
            <column caption='Effective Fee' datatype='real' name='[Calculation_1232016033081651209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([delivery_fee_amount_lc])+sum([service_fee_amount_lc]))*1.0/sum([fct_completed_order_count])' />
