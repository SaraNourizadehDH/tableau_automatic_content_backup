            <column caption='okr_target_value decimal_2 ' datatype='string' name='[okr_value decimal_2 (copy)_3766557411005878305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#10;  INT( INT([okr_target_value] * 100 + 0.5) / 100 )&#10;)&#10;+ &quot;.&quot;&#10;+&#10;IF&#10;  (&#10;    INT([okr_target_value] * 100 + 0.5)&#10;    - INT( INT([okr_target_value] * 100 + 0.5) / 100 ) * 100&#10;  ) &lt; 10&#10;THEN&#10;  &quot;0&quot; + STR(&#10;    INT([okr_target_value] * 100 + 0.5)&#10;    - INT( INT([okr_target_value] * 100 + 0.5) / 100 ) * 100&#10;  )&#10;ELSE&#10;  STR(&#10;    INT([okr_target_value] * 100 + 0.5)&#10;    - INT( INT([okr_target_value] * 100 + 0.5) / 100 ) * 100&#10;  )&#10;END' />
