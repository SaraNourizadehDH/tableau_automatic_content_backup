          <datasource-dependencies datasource='federated.13szwps13wcuu112g2dqy0brtvwg'>
            <column caption='null actual or target' datatype='boolean' name='[Calculation_2360730631976349696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([okr_actual_value])  &#10;and ISNULL([Okr Target Value (copy)_6672012490422902784])' />
