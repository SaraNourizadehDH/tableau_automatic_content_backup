            </column>
            <column caption='OKR Target Deviance' datatype='real' default-format='p0.0%' name='[Calculation_6672012490425741314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([okr_actual_value])-sum([Okr Target Value (copy)_6672012490422902784]))&#10;/&#10;sum([Okr Target Value (copy)_6672012490422902784])' />
            </column>
            <column caption='Relative Period Filter' datatype='boolean' name='[Calculation_6672012491180662791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;month&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 1] and&#10;   [date] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 1])&#10;ELSEIF [granularity] = &apos;week&apos; THEN&#10;    [date] &lt;= [Parameters].[Parameter 2] and&#10;   [date] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 3], [Parameters].[Parameter 2])&#10;ELSEIF [granularity] = &apos;day&apos; THEN&#10;    [date] &lt;= [Parameters].[Month (copy)_6722466903353917440] and&#10;   [date] &gt; DATEADD(&apos;day&apos;, -[Parameters].[Parameter 3], [Parameters].[Month (copy)_6722466903353917440])&#10;end' />
            </column>
