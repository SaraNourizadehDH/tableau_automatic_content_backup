            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='shahroze.tariq@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zdux7s1eofouu1f1we0v0i229ea' name='Custom SQL Query' type='text'>with baseline_targets as (
  SELECT 
  date(quarter_date) as quarter_date, okr_number, 
  lower(country_code) as country_code, 
  any_value(baseline_type) baseline_type, 
  any_value(target_type) target_type,
  sum(safe_cast( baseline as float64)) as baseline,
  sum(safe_cast(target as float64)) as target,
  FROM `tlb-data-prod.data_platform_google_sheet.logistics_okr_baseline_targets` 
  where quarter_date is not null and country_code is not null and okr_number is not null
  group by all 
)

select 
upper(country_code) as country_code,
o.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id, country_code), 
d.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id),

bt.baseline_type as bt_baseline_type, 
bt.target_type as bt_target_type, 
bt.baseline as bt_baseline,
bt.target as bt_target,

from  `tlb-data-prod.data_platform.fct_logistics_okr_value` o
left join `tlb-data-prod.data_platform.dim_logistics_okr` d using(okr_id)
left join baseline_targets bt using(quarter_date, country_code, okr_number)
where is_active
and not (country_code=&apos;regional&apos; and quarter_date=&apos;2025-07-01&apos; and okr_number in (&apos;1.1&apos;, &apos;1.2&apos;, &apos;11.1&apos;) ) -- exluding dubai okrs from regional for H2 2025</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0zdux7s1eofouu1f1we0v0i229ea' name='Custom SQL Query' type='text'>with baseline_targets as (
  SELECT 
  date(quarter_date) as quarter_date, okr_number, 
  lower(country_code) as country_code, 
  any_value(baseline_type) baseline_type, 
  any_value(target_type) target_type,
  sum(safe_cast( baseline as float64)) as baseline,
  sum(safe_cast(target as float64)) as target,
  FROM `tlb-data-prod.data_platform_google_sheet.logistics_okr_baseline_targets` 
  where quarter_date is not null and country_code is not null and okr_number is not null
  group by all 
)

select 
upper(country_code) as country_code,
o.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id, country_code), 
d.* except(dwh_entry_timestamp, dwh_update_timestamp, okr_id),

bt.baseline_type as bt_baseline_type, 
