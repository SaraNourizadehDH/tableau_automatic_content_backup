            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[Calculation_5290111095525638145]' _.fcp.ParameterDefaultValues.true...source-field='[federated.13szwps13wcuu112g2dqy0brtvwg].[all months (copy)_5290111095526838278]' caption='Week' datatype='date' default-format='*mmm dd /\ \Www' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-28#'>
