            </column>
            <column caption='current month' datatype='datetime' datatype-customized='true' name='[current week (copy)_5290111095525875714]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// DATETIME(max(date (DATETRUNC(&quot;month&quot;, [Date]))))&#10;&#10;DATETRUNC(&apos;month&apos;, today()-1)' />
            </column>
            <column datatype='date' default-format='*m/d/yyyy' name='[date]' role='dimension' type='ordinal' />
            <column caption='granularity filter' datatype='boolean' name='[granularity is month (copy)_6672012491196477457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4] = [granularity]' />
