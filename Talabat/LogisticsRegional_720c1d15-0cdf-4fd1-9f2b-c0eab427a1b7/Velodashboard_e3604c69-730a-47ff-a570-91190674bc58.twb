          <datasource-dependencies datasource='federated.1oxrr5k1xgfi2q13oerw30oj55o3'>
            <column caption='Week Start' datatype='datetime' name='[Calculation_774267329258131458]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;)' />
            </column>
            <column caption='Order flag' datatype='boolean' name='[Calculation_774267329258201091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [Calculation_774267329258131458], [rider_id] : SUM([order_count]) } &gt;= 1 THEN True ELSE False END' />
            </column>
            <column caption='Last 4 Full Weeks Filter' datatype='boolean' name='[Calculation_774267329258799108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &gt;= 1&#10;AND&#10;DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &lt;= 4' />
            </column>
            <column caption='Weekly Active Fleet' datatype='integer' name='[Calculation_774267331664371748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : COUNTD(&#10;    IF [Calculation_774267329258799108] = TRUE AND [Calculation_774267329258201091] = TRUE&#10;    THEN [rider_id]&#10;    END&#10;)}' />
            </column>
