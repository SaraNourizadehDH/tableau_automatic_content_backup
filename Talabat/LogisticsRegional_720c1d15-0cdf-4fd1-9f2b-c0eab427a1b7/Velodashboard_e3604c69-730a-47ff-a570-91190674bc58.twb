            <datasource caption='Custom SQL Query (data_platform)' name='federated.1oxrr5k1xgfi2q13oerw30oj55o3' />
          </datasources>
          <datasource-dependencies datasource='federated.1oxrr5k1xgfi2q13oerw30oj55o3'>
            <column caption='Integrity Compliant riders share' datatype='real' name='[Calculation_400961144172253184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [absolute_score] &lt; 27.75 THEN [rider_id] END)/COUNTD([rider_id])' />
            </column>
            <column caption='Integrity Score' datatype='real' name='[Calculation_774267331671285798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : AVG([absolute_score]) }' />
            </column>
            <column caption='P90 riders' datatype='integer' name='[Compliant riders (copy)_774267329925013530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [p90_flag]&#10;WHEN 1 THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column datatype='real' name='[absolute_score]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_774267331671285798]' derivation='Avg' name='[avg:Calculation_774267331671285798:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Compliant riders (copy)_774267329925013530]' derivation='CountD' name='[ctd:Compliant riders (copy)_774267329925013530:qk]' pivot='key' type='quantitative' />
            <column-instance column='[rider_id]' derivation='CountD' name='[ctd:rider_id:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[p90_flag]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
            <column datatype='date' name='[shift_date]' role='dimension' type='ordinal' />
            <column-instance column='[shift_date]' derivation='Month-Trunc' name='[tmn:shift_date:qk]' pivot='key' type='quantitative' />
