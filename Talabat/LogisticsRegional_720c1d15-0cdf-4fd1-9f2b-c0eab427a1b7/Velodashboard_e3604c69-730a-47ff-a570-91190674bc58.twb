    <worksheet name='Sheet 15'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1oxrr5k1xgfi2q13oerw30oj55o3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EBITDA&quot;'>
              <calculation class='tableau' formula='&quot;EBITDA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oxrr5k1xgfi2q13oerw30oj55o3'>
            <column caption='Integrity Compliant riders share' datatype='real' name='[Calculation_400961144172253184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [absolute_score] &lt; 27.75 THEN [rider_id] END)/COUNTD([rider_id])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_400961144175939585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;UTR&apos; THEN [Calculation_774267329256558592]&#10;WHEN &apos;AVG Working Hours&apos; THEN [Working Hours (copy)_774267329565044744]&#10;WHEN &apos;Integrity&apos; THEN [Calculation_400961144172253184]&#10;WHEN &apos;Fleet size&apos; THEN COUNTD([rider_id])&#10;WHEN &apos;AVP %&apos; THEN [Calculation_774267329256673281]&#10;WHEN &apos;Orders delivered/day&apos; THEN [Calculation_774267329582563346]&#10;WHEN &apos;EBITDA&apos; THEN [Calculation_400961149118099467]&#10;END' />
            </column>
            <column caption='Month' datatype='datetime' name='[Calculation_400961144190779395]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[shift_date])' />
            </column>
            <column caption='Fleet Size' datatype='integer' name='[Calculation_400961144501207045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='EBITDA ' datatype='real' name='[Calculation_400961149118099467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amount])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_774267329256558592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count])/SUM([total_working_hours])' />
            </column>
            <column caption='AVP %' datatype='real' name='[Calculation_774267329256673281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_working_hours])/SUM([total_planned_working_hours]))' />
            </column>
            <column caption='P90 riders %' datatype='real' name='[Calculation_774267329563230213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Compliant riders (copy)_774267329925013530])/COUNTD([rider_id])' />
            </column>
            <column caption='Legally Compliant riders' datatype='integer' name='[Calculation_774267329563734022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_fully_compliant]&#10;WHEN TRUE THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Is Active 28 Days' datatype='integer' name='[Calculation_774267329571586059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [shift_date] &gt;= TODAY() - 28 AND [order_count] &gt; 0 THEN 1 ELSE 0 END&#10;    )&#10;}' />
            </column>
            <column caption='Active Riders' datatype='integer' name='[Calculation_774267329571799052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_774267329571586059] = 1 THEN [rider_id] END&#10;)' />
            </column>
            <column caption='Max Nationality Share %' datatype='real' name='[Calculation_774267329572397070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : &#10;    MAX(&#10;        { FIXED [country_of_birth] : COUNTD([rider_id]) }&#10;    )&#10;} / &#10;{ FIXED : COUNTD([rider_id]) }' />
            </column>
            <column caption='Orders Delivered Per Day' datatype='real' name='[Calculation_774267329582563346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/(COUNT([shift_date]))' />
            </column>
            <column caption='Days Worked' datatype='integer' name='[Calculation_774267329584947222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shift_date])' />
            </column>
            <column caption='Max date' datatype='date' name='[Calculation_774267329925427227]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : MAX([shift_date]) }' />
            </column>
            <column caption='Is max shift date' datatype='boolean' name='[Calculation_774267329925599260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[shift_date] = [Calculation_774267329925427227]' />
            </column>
            <column caption='Is P90' datatype='integer' name='[Calculation_774267329926168605]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [Calculation_774267329925599260] THEN [p90_flag] ELSE 0 END&#10;    )&#10;}' />
            </column>
            <column caption='Latest Integrity score' datatype='real' name='[Calculation_774267329926451230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [Calculation_774267329925599260] THEN [absolute_score] ELSE 0 END&#10;    )&#10;}' />
            </column>
            <column caption='Legally Compliant Riders %' datatype='real' name='[Calculation_774267330953068575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_774267329563734022])/COUNTD([rider_id])' />
            </column>
            <column caption='Integrity Score' datatype='real' name='[Calculation_774267331671285798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id] : AVG([absolute_score]) }' />
            </column>
            <column caption='P90 riders' datatype='integer' name='[Compliant riders (copy)_774267329925013530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [p90_flag]&#10;WHEN 1 THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='AVG Days Worked ' datatype='real' name='[Days Worked (copy)_400961144500826116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([shift_date])/COUNTD([rider_id])' />
            </column>
            <column caption='Integrity Compliant Riders %' datatype='real' name='[P90 riders % (copy)_774267331660001315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [Compliant riders (copy)_774267329925013530] END)}&#10;/&#10;{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [rider_id] END)}' />
            </column>
            <_.fcp.ObjectModelTableType.false...column caption='Custom SQL Query' datatype='integer' name='[__tableau_internal_object_id__].[_2F9DE31091784D1ABC634488001C913D]' role='measure' type='quantitative' />
            <column caption='AVG Active Working Hours' datatype='real' name='[Working Hours (copy)_774267329565044744]' role='measure' type='quantitative'>
