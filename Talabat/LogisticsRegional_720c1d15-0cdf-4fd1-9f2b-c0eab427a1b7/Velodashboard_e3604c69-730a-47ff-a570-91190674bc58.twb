      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[max:Calculation_774267329603063832:qk]&quot;' value='RSAT' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[max:Calculation_774267329926168605:qk]&quot;' value='Is P90' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[sum:Calculation_774267329572397070:qk]&quot;' value='Diversity' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[usr:Calculation_774267329256673281:qk]&quot;' value='AVP (Actual VS Planned)' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[usr:Calculation_774267329571799052:qk]&quot;' value='Fleet Size' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[usr:Calculation_774267329582563346:qk]&quot;' value='Orders Delivered/Day' />
          <alias key='&quot;[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[usr:Working Hours (copy)_774267329565044744:qk]&quot;' value='AVG Active WH' />
        </aliases>
      </column>
      <column caption='Integrity Compliant riders share' datatype='real' name='[Calculation_400961144172253184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [absolute_score] &lt; 27.75 THEN [rider_id] END)/COUNTD([rider_id])' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_400961144175939585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;UTR&apos; THEN [Calculation_774267329256558592]&#10;WHEN &apos;AVG Working Hours&apos; THEN [Working Hours (copy)_774267329565044744]&#10;WHEN &apos;Integrity&apos; THEN [Calculation_400961144172253184]&#10;WHEN &apos;Fleet size&apos; THEN COUNTD([rider_id])&#10;WHEN &apos;AVP %&apos; THEN [Calculation_774267329256673281]&#10;WHEN &apos;Orders delivered/day&apos; THEN [Calculation_774267329582563346]&#10;WHEN &apos;EBITDA&apos; THEN [Calculation_400961149118099467]&#10;END' />
      </column>
      <column caption='KPI format' datatype='string' name='[Calculation_400961144177905666]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;UTR&apos; THEN STR(ROUND([Calculation_774267329256558592], 2))&#10;WHEN &apos;AVG Working Hours&apos; THEN STR(ROUND([Working Hours (copy)_774267329565044744], 2))&#10;WHEN &apos;Integrity&apos; THEN STR(ROUND([Calculation_400961144172253184]*100, 1)) + &quot;%&quot;&#10;WHEN &apos;Fleet size&apos; THEN STR(ROUND(COUNTD([rider_id]), 0))&#10;WHEN &apos;AVP %&apos; THEN STR(ROUND([Calculation_774267329256673281]*100, 1)) + &quot;%&quot;&#10;WHEN &apos;Orders delivered/day&apos; THEN STR(ROUND([Calculation_774267329582563346], 2))&#10;WHEN &apos;EBITDA&apos; THEN STR(ROUND([Calculation_400961149118099467],0))&#10;END' />
      </column>
      <column caption='Month' datatype='datetime' name='[Calculation_400961144190779395]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[shift_date])' />
      </column>
      <column caption='Fleet Size' datatype='integer' name='[Calculation_400961144501207045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='Is Integrity Compliant' datatype='boolean' name='[Calculation_400961146657783814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_774267329926168605] = 1 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='EBITDA ' datatype='real' name='[Calculation_400961149118099467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount])' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_774267329256558592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_order_count])/SUM([total_working_hours])' />
      </column>
      <column caption='AVP %' datatype='real' name='[Calculation_774267329256673281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_working_hours])/SUM([total_planned_working_hours]))' />
      </column>
      <column caption='Week Start' datatype='datetime' name='[Calculation_774267329258131458]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;)' />
      </column>
      <column caption='Order flag' datatype='boolean' name='[Calculation_774267329258201091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Calculation_774267329258131458], [rider_id] : SUM([order_count]) } &gt;= 1 THEN True ELSE False END' />
      </column>
      <column caption='Last 4 Full Weeks Filter' datatype='boolean' name='[Calculation_774267329258799108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &gt;= 1&#10;AND&#10;DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &lt;= 4' />
      </column>
      <column caption='P90 riders %' datatype='real' name='[Calculation_774267329563230213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Compliant riders (copy)_774267329925013530])/COUNTD([rider_id])' />
      </column>
      <column caption='Legally Compliant riders' datatype='integer' name='[Calculation_774267329563734022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_fully_compliant]&#10;WHEN TRUE THEN [rider_id]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Working Hours' datatype='real' name='[Calculation_774267329564839943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_active_working_hours])/COUNTD([rider_id])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_774267329569263625]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[shift_date]' />
      </column>
      <column caption='3PL' datatype='string' name='[Calculation_774267329570144266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[last_contract_name]' />
      </column>
      <column caption='Is Active 28 Days' datatype='integer' name='[Calculation_774267329571586059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [shift_date] &gt;= TODAY() - 28 AND [order_count] &gt; 0 THEN 1 ELSE 0 END&#10;    )&#10;}' />
      </column>
      <column caption='Active Riders' datatype='integer' name='[Calculation_774267329571799052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_774267329571586059] = 1 THEN [rider_id] END&#10;)' />
      </column>
      <column caption='Max Nationality Share %' datatype='real' name='[Calculation_774267329572397070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : &#10;    MAX(&#10;        { FIXED [country_of_birth] : COUNTD([rider_id]) }&#10;    )&#10;} / &#10;{ FIXED : COUNTD([rider_id]) }' />
      </column>
      <column caption='Top Nationality Label' datatype='string' name='[Calculation_774267329572622351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// This calculation identifies the country with the most riders.&#10;// It compares each country&apos;s rider count to the overall maximum.&#10;IF {FIXED [country_of_birth] : COUNTD([rider_id])} = &#10;   {FIXED : MAX({FIXED [country_of_birth] : COUNTD([rider_id])})}&#10;THEN [country_of_birth]&#10;END' />
      </column>
      <column caption='Orders Delivered Per Day' datatype='real' name='[Calculation_774267329582563346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count])/(COUNT([shift_date]))' />
      </column>
      <column caption='Successful deliveries' datatype='integer' name='[Calculation_774267329584799765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_order_count])' />
      </column>
      <column caption='Days Worked' datatype='integer' name='[Calculation_774267329584947222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([shift_date])' />
      </column>
      <column caption='Total Active Working Hours' datatype='real' name='[Calculation_774267329585115159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_active_working_hours])' />
      </column>
      <column caption='RSAT' datatype='real' name='[Calculation_774267329603063832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [month] : MAX([final_overall_score_percentage]) }' />
      </column>
      <column caption='Riders with NPS score' datatype='real' name='[Calculation_774267329604403225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Calculates the percentage of riders with a valid NPS score using an LOD.&#10;{FIXED : COUNTD(IF NOT ISNULL([nps_score]) THEN [rider_id] END)}&#10;/&#10;{FIXED : COUNTD([rider_id])}' />
      </column>
      <column caption='Max date' datatype='date' name='[Calculation_774267329925427227]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : MAX([shift_date]) }' />
      </column>
      <column caption='Is max shift date' datatype='boolean' name='[Calculation_774267329925599260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[shift_date] = [Calculation_774267329925427227]' />
      </column>
      <column caption='Is P90' datatype='integer' name='[Calculation_774267329926168605]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [Calculation_774267329925599260] THEN [p90_flag] ELSE 0 END&#10;    )&#10;}' />
      </column>
      <column caption='Latest Integrity score' datatype='real' name='[Calculation_774267329926451230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : &#10;    MAX(&#10;        IF [Calculation_774267329925599260] THEN [absolute_score] ELSE 0 END&#10;    )&#10;}' />
      </column>
      <column caption='Legally Compliant Riders %' datatype='real' name='[Calculation_774267330953068575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_774267329563734022])/COUNTD([rider_id])' />
      </column>
      <column caption='Country of Birth' datatype='string' name='[Calculation_774267331658223649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_of_birth]' />
      </column>
      <column caption='P90 flag new' datatype='boolean' name='[Calculation_774267331658571810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [p90_flag]&#10;WHEN 0 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Weekly Active Fleet' datatype='integer' name='[Calculation_774267331664371748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : COUNTD(&#10;    IF [Calculation_774267329258799108] = TRUE AND [Calculation_774267329258201091] = TRUE&#10;    THEN [rider_id]&#10;    END&#10;)}' />
      </column>
      <column caption='Integrity Score Group' datatype='string' name='[Calculation_774267331670036517]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [absolute_score] &gt; 27.5&#10;THEN &quot;P90&quot;&#10;ELSE &quot;Not P90&quot;&#10;END' />
      </column>
      <column caption='Integrity Score' datatype='real' name='[Calculation_774267331671285798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : AVG([absolute_score]) }' />
      </column>
      <column caption='P90 riders' datatype='integer' name='[Compliant riders (copy)_774267329925013530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [p90_flag]&#10;WHEN 1 THEN [rider_id]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='AVG Days Worked ' datatype='real' name='[Days Worked (copy)_400961144500826116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([shift_date])/COUNTD([rider_id])' />
      </column>
      <column caption='RSAT %' datatype='real' name='[Integrity Compliant Riders % (copy)_400961148424998922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [Calculation_774267329603063832] END)}&#10;/&#10;{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [Calculation_774267329603063832] END)}' />
      </column>
      <column caption='Is max month' datatype='boolean' name='[Is max shift date (copy)_400961148098547719]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_400961144190779395] = [Max date (copy)_400961148098678792]' />
      </column>
      <column caption='Max month' datatype='datetime' name='[Max date (copy)_400961148098678792]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [rider_id] : MAX(DATETRUNC(&apos;month&apos;,[shift_date])) }' />
      </column>
      <column caption='Integrity Compliant Riders %' datatype='real' name='[P90 riders % (copy)_774267331660001315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [Compliant riders (copy)_774267329925013530] END)}&#10;/&#10;{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [rider_id] END)}' />
      </column>
      <column caption='AVG Active Working Hours' datatype='real' name='[Working Hours (copy)_774267329565044744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_active_working_hours])/COUNT([shift_date])' />
      </column>
