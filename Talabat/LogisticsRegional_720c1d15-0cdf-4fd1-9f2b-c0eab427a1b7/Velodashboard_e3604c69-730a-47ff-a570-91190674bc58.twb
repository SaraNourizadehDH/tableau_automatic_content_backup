    <worksheet name='KPIs per Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1oxrr5k1xgfi2q13oerw30oj55o3' />
          </datasources>
          <datasource-dependencies datasource='federated.1oxrr5k1xgfi2q13oerw30oj55o3'>
            <column caption='Integrity Compliant riders share' datatype='real' name='[Calculation_400961144172253184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [absolute_score] &lt; 27.75 THEN [rider_id] END)/COUNTD([rider_id])' />
            </column>
            <column caption='Fleet Size' datatype='integer' name='[Calculation_400961144501207045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_774267329256558592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count])/SUM([total_working_hours])' />
            </column>
            <column caption='AVP %' datatype='real' name='[Calculation_774267329256673281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_working_hours])/SUM([total_planned_working_hours]))' />
            </column>
            <column caption='Legally Compliant riders' datatype='integer' name='[Calculation_774267329563734022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_fully_compliant]&#10;WHEN TRUE THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='3PL' datatype='string' name='[Calculation_774267329570144266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[last_contract_name]' />
            </column>
            <column caption='Orders Delivered Per Day' datatype='real' name='[Calculation_774267329582563346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/(COUNT([shift_date]))' />
            </column>
            <column caption='Successful deliveries' datatype='integer' name='[Calculation_774267329584799765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count])' />
            </column>
            <column caption='RSAT' datatype='real' name='[Calculation_774267329603063832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month] : MAX([final_overall_score_percentage]) }' />
            </column>
            <column caption='Legally Compliant Riders %' datatype='real' name='[Calculation_774267330953068575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_774267329563734022])/COUNTD([rider_id])' />
            </column>
            <column caption='AVG Days Worked ' datatype='real' name='[Days Worked (copy)_400961144500826116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([shift_date])/COUNTD([rider_id])' />
            </column>
            <column caption='AVG Active Working Hours' datatype='real' name='[Working Hours (copy)_774267329565044744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_active_working_hours])/COUNT([shift_date])' />
            </column>
            <column datatype='real' name='[absolute_score]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[final_overall_score_percentage]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_fully_compliant]' role='dimension' type='nominal' />
            <column datatype='string' name='[last_contract_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_774267329603063832]' derivation='Max' name='[max:Calculation_774267329603063832:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_774267329570144266]' derivation='None' name='[none:Calculation_774267329570144266:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
            <column datatype='date' name='[shift_date]' role='dimension' type='ordinal' />
