          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[tmn:shift_date:qk]' scope='cols' value='' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1oxrr5k1xgfi2q13oerw30oj55o3].[usr:Calculation_400961144172253184:qk]' value='p0.0%' />
