            <column aggregation='Sum' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
            <column datatype='date' name='[shift_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[successful_order_count]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:qk]' pivot='key' type='quantitative' />
