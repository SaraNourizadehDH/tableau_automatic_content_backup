    <worksheet name='KPIs 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1oxrr5k1xgfi2q13oerw30oj55o3' />
          </datasources>
          <datasource-dependencies datasource='federated.1oxrr5k1xgfi2q13oerw30oj55o3'>
            <column caption='Month' datatype='datetime' name='[Calculation_400961144190779395]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[shift_date])' />
            </column>
            <column caption='EBITDA ' datatype='real' name='[Calculation_400961149118099467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amount])' />
            </column>
            <column caption='Week Start' datatype='datetime' name='[Calculation_774267329258131458]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;)' />
            </column>
            <column caption='Order flag' datatype='boolean' name='[Calculation_774267329258201091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [Calculation_774267329258131458], [rider_id] : SUM([order_count]) } &gt;= 1 THEN True ELSE False END' />
            </column>
            <column caption='Last 4 Full Weeks Filter' datatype='boolean' name='[Calculation_774267329258799108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &gt;= 1&#10;AND&#10;DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, [shift_date], &apos;monday&apos;), DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)) &lt;= 4' />
            </column>
            <column caption='Legally Compliant riders' datatype='integer' name='[Calculation_774267329563734022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_fully_compliant]&#10;WHEN TRUE THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='3PL' datatype='string' name='[Calculation_774267329570144266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[last_contract_name]' />
            </column>
            <column caption='RSAT' datatype='real' name='[Calculation_774267329603063832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month] : MAX([final_overall_score_percentage]) }' />
            </column>
            <column caption='Legally Compliant Riders %' datatype='real' name='[Calculation_774267330953068575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_774267329563734022])/COUNTD([rider_id])' />
            </column>
            <column caption='Weekly Active Fleet' datatype='integer' name='[Calculation_774267331664371748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : COUNTD(&#10;    IF [Calculation_774267329258799108] = TRUE AND [Calculation_774267329258201091] = TRUE&#10;    THEN [rider_id]&#10;    END&#10;)}' />
            </column>
            <column caption='P90 riders' datatype='integer' name='[Compliant riders (copy)_774267329925013530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [p90_flag]&#10;WHEN 1 THEN [rider_id]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Integrity Compliant Riders %' datatype='real' name='[P90 riders % (copy)_774267331660001315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [Compliant riders (copy)_774267329925013530] END)}&#10;/&#10;{FIXED : COUNTD(IF [Calculation_400961144190779395] = {MAX([Calculation_400961144190779395])} THEN [rider_id] END)}' />
            </column>
            <column datatype='real' name='[amount]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[final_overall_score_percentage]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_fully_compliant]' role='dimension' type='nominal' />
            <column datatype='string' name='[last_contract_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_774267329603063832]' derivation='Max' name='[max:Calculation_774267329603063832:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_774267329570144266]' derivation='None' name='[none:Calculation_774267329570144266:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p90_flag]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
            <column datatype='date' name='[shift_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_774267331664371748]' derivation='Sum' name='[sum:Calculation_774267331664371748:qk]' pivot='key' type='quantitative' />
            <column-instance column='[P90 riders % (copy)_774267331660001315]' derivation='Sum' name='[sum:P90 riders % (copy)_774267331660001315:qk]' pivot='key' type='quantitative' />
