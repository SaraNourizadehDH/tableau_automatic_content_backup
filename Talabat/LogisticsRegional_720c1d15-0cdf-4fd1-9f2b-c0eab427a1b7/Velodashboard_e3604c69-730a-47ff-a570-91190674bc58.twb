    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location id='Glossary' path='/t/Talabat/workbooks/Velodashboard' revision='' site='Talabat' />
      <style />
      <size maxheight='1000' maxwidth='1300' minheight='1000' minwidth='1300' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='5500' id='5' type-v2='text' w='98770' x='615' y='800'>
            <formatted-text>
              <run fontalignment='2' fontcolor='#d5fe51' fontname='Tableau Bold' fontsize='15'>Velo Dashboard</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#401b1c' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='92900' id='103' type-v2='text' w='98770' x='615' y='6300'>
            <formatted-text>
              <run fontcolor='#030ff5' fontsize='13'>Objectiv</run>
              <run fontcolor='#030ff5' fontsize='11'>e</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='11'>This dashboard provides a view on the main operational KPIs of talabat&apos;s own riders working under Velo contracts.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#030ff5' fontsize='11'>KPIs</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Fleet Size:</run>
              <run fontcolor='#000000' fontsize='11'> Count of active riders who have delivered 1 order in last 28 days.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Weekly Active Fleet:</run>
              <run fontcolor='#000000' fontsize='11'> Weekly Average of # of riders who delivered at least 1 order across 4 weeks (Monday-Sun) of the month. </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Profitability:</run>
              <run fontcolor='#000000' fontsize='11'> Profitability for Velo orders vs cost of Velo riders.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Working Hours:</run>
              <run fontcolor='#000000' fontsize='11'> Average # of working hours across rider fleet.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Orders delivered per day per driver:</run>
              <run fontcolor='#000000' fontsize='11'> # of orders delivered divided by (# of active working days X # active riders)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>UTR:</run>
              <run fontcolor='#000000' fontsize='11'> Productivity of rider order delivery in an hour.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>AVP (Actual VS Planned):</run>
              <run fontcolor='#000000' fontsize='11'> # of actual working hours as a percent of # of planned hours.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Compliance:</run>
              <run fontcolor='#000000' fontsize='11'> Rider adherence to talabat working policies:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>         - Legal Compliance: all legal documents are in order based on the legal compliance requirements</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='6'>Æ        </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='DM Sans' fontsize='11'>Æ        </run>
              <run fontcolor='#000000' fontsize='11'><![CDATA[- Integrity Compliance: P90 rider (integrity score < 27.75)]]></run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>RSAT:</run>
              <run fontcolor='#000000' fontsize='11'> Rider satisfaction score based on percentage of good responses which are values 4 or 5 only.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#f18c60' fontsize='11'>Diversity:</run>
              <run fontcolor='#000000' fontsize='11'> % share of largest nationality in the rider fleet.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='4000' id='82' is-centered='0' is-scaled='1' param='Image/Talabat_logo.png' type-v2='bitmap' w='42846' x='1077' y='1500' />
      </zones>
