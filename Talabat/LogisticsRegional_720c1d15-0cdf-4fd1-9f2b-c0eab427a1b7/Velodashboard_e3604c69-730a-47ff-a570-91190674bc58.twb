      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='EBITDA' id='_1EAAC9B5FE374F298A449D0246EAF46F'>
            <properties context=''>
              <relation connection='bigquery.13j6y0y0qo24jn15uqqrt0wm8etd' name='Custom SQL Query2' type='text'>SELECT *
FROM 
  (SELECT PARSE_DATE(&apos;%b-%y&apos;, month) AS month, category, 
  - CAST(
    REPLACE(
      REGEXP_REPLACE(amount, r&apos;^\((.*)\)$&apos;, r&apos;-\1&apos;),
      &apos;,&apos;, &apos;&apos;
    ) AS FLOAT64
  ) AS amount,
  &apos;costs&apos; AS type 
  FROM `tlb-data-prod.data_platform_google_sheet.velo_ebitda_costs`) c
UNION ALL 
  (SELECT PARSE_DATE(&apos;%b-%y&apos;, month) AS month, category,
  CAST(
    REPLACE(
      REGEXP_REPLACE(amount, r&apos;^\((.*)\)$&apos;, r&apos;-\1&apos;),
      &apos;,&apos;, &apos;&apos;
    ) AS FLOAT64
  ) AS amount,
  &apos;revenue&apos; AS type 
  FROM `tlb-data-prod.data_platform_google_sheet.velo_ebitda_revenue`)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_1EAAC9B5FE374F298A449D0246EAF46F' table='[Extract].[_1EAAC9B5FE374F298A449D0246EAF46F]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_2F9DE31091784D1ABC634488001C913D'>
            <properties context=''>
              <relation connection='bigquery.13j6y0y0qo24jn15uqqrt0wm8etd' name='Custom SQL Query' type='text'>WITH
date_param AS (
    SELECT
        DATE(&apos;2025-01-01&apos;) AS start_date,
        CURRENT_DATE()-1 AS end_date
),

filtered_riders AS (
  SELECT country_code, rider_id
  FROM `tlb-data-prod.data_platform.dim_logistics_rider`
  WHERE LOWER(last_contract_name) like &apos;%velo%logistics%&apos; 
  --last_contract_name = &apos;Zone Delivery Services L.L.C&apos;
  --AND is_active = TRUE
),

shift AS (
    SELECT
        s.country_code, 
        s.rider_id, 
        DATE(s.actual_start_at) AS shift_date,
        MIN(s.actual_start_at) AS actual_start_at,
        MAX(s.actual_end_at) AS actual_end_at,
        ROUND(COALESCE(SUM(ROUND(COALESCE(s.actual_working_time/3600.0, 0.0), 6)), 0.0), 6) AS total_working_hours,
        ROUND(COALESCE(SUM(ROUND(COALESCE(s.planned_shift_duration/3600.0, 0.0), 6)), 0.0), 6) AS total_planned_working_hours,
        ROUND(COALESCE(SUM(ROUND(COALESCE(s.actual_break_time/3600.0, 0.0), 6)), 0.0), 6) AS total_break_hours,
        ROUND(COALESCE(SUM(ROUND(COALESCE((s.actual_working_time - s.actual_break_time)/3600.0, 0.0), 6)), 0.0), 6) AS total_active_working_hours
    FROM `tlb-data-prod.data_platform.fct_logistics_rider_shift` s
    INNER JOIN filtered_riders fr USING (country_code, rider_id)
    WHERE DATE(s.actual_start_at) BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
    GROUP BY ALL
),

orders AS (
    SELECT
        d.rider_id, 
        d.country_code, 
        order_code, 
        created_date,
        order_status,
        delivery_status,
        rider_accepted_at,
        rider_near_restaurant_at
    FROM `tlb-data-prod.data_platform.fct_logistics_delivery` d
    INNER JOIN filtered_riders fr USING (country_code, rider_id)
    WHERE DATE(created_date) BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        --AND delivery_status = &apos;completed&apos; AND order_status = &apos;completed&apos; 
),

shift_order AS (
    SELECT
        s.country_code, 
        s.rider_id, 
        s.shift_date,
        -- s.actual_start_at,
        -- s.actual_end_at,
        s.total_working_hours,
        s.total_planned_working_hours,
        s.total_active_working_hours,
        COUNT(DISTINCT CASE WHEN order_status = &apos;completed&apos; 
        AND delivery_status = &apos;completed&apos; THEN order_code END) AS successful_order_count,
        COUNT(DISTINCT order_code) AS order_count     
    FROM shift s
    LEFT JOIN orders o 
        ON s.country_code = o.country_code 
        AND s.rider_id = o.rider_id 
        AND o.rider_near_restaurant_at BETWEEN s.actual_start_at AND s.actual_end_at
    GROUP BY ALL
),

integrity AS (
  -- This query calculates a risk score for delivery riders based on various behavioral metrics like fraud,
-- misbehavior, and non-compliance. It aggregates data monthly for each rider.

WITH

date_param AS (
    SELECT
        DATE(&apos;2025-01-01&apos;) AS start_date,
        CURRENT_DATE()-1 AS end_date
),

filtered_riders AS (
  SELECT country_code, rider_id
  FROM `tlb-data-prod.data_platform.dim_logistics_rider`
  WHERE LOWER(last_contract_name) like &apos;%velo%logistics%&apos; 
  --last_contract_name = &apos;Zone Delivery Services L.L.C&apos;
  --AND is_active = TRUE
),

-- 1. Unauthorized Apps CTE
unauthorized_apps_cte AS (
    WITH
    parsed_data AS (
        SELECT
            c.country_code,
            c.rider_id,
            created_date,
            DATE(TIMESTAMP(DATETIME(created_date)), timezone) AS date_tz,
            DATE_TRUNC(DATE(TIMESTAMP(DATETIME(created_date)), timezone), MONTH) AS month,
            DATE_TRUNC(DATE(TIMESTAMP(DATETIME(created_date)), timezone), WEEK) AS week,
            violations
        FROM `fulfillment-dwh-production.curated_data_shared.rider_compliance` c
        INNER JOIN filtered_riders fr USING (country_code, rider_id)
        WHERE created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
    ),
    unnested_violations AS (
        SELECT
            country_code,
            rider_id,
            created_date,
            date_tz,
            month,
            week,
            violation
        FROM parsed_data, UNNEST(violations) AS violation
    ),
    unnested_rules AS (
        SELECT
            month,
            country_code,
            rider_id,
            created_date
        FROM
            unnested_violations,
            UNNEST(violation.rules) AS rule,
            UNNEST(violation.actions) AS actions,
            UNNEST(violation.evidence) AS evidence
        WHERE rule.violation_type = &apos;UNAUTHORISED_APP&apos;
    )
    SELECT
        month,
        country_code,
        rider_id,
        &apos;Unauthorized Apps&apos; AS fraud_pillar,
        COUNT(DISTINCT created_date) AS issue_count
    FROM unnested_rules
    GROUP BY 1, 2, 3
),

------------------------------------------------------------------------------------------------------------------------------
-- 2. Fake GPS CTE
fake_gps_cte AS (
    SELECT
        DATE_TRUNC(DATE(i.created_at, i.timezone), MONTH) AS month,
        i.country_code,
        i.rider_id,
        issue_name AS fraud_pillar,
        COUNT(DISTINCT issue_id) AS issue_count
    FROM `fulfillment-dwh-production.curated_data_shared.issues` AS i
    INNER JOIN filtered_riders fr USING (country_code, rider_id)
    WHERE
        i.created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        AND issue_name = &apos;Courier Fake GPS Usage Detected&apos;
        AND i.rider_id IS NOT NULL
    GROUP BY 1, 2, 3, 4
),

------------------------------------------------------------------------------------------------------------------------------
-- 3. Orders CTE
orders_cte AS (
    SELECT
        DATE_TRUNC(orders.created_date, MONTH) AS month,
        orders.created_date,
        orders.country_code,
        orders.city_id,
        orders.primary_rider_id AS rider_id,
        orders.order_id,
        orders.order_status,
        orders.vendor_order_status,
        orders.cancellation_reason
    FROM `tlb-data-prod.data_platform.fct_logistics_order` AS orders
    INNER JOIN filtered_riders fr
      ON fr.rider_id = orders.primary_rider_id AND fr.country_code = orders.country_code
    LEFT JOIN (
        SELECT order_id, country_code
        FROM `tlb-data-prod.data_platform.fct_order_info`
        WHERE order_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
    ) AS fct_order_info
        ON orders.order_id = fct_order_info.order_id
        AND LOWER(orders.country_code) = LOWER(fct_order_info.country_code)
    WHERE
        orders.created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        AND is_talabat IS TRUE
        AND is_rider_order IS TRUE
        AND orders.primary_rider_id IS NOT NULL
),

------------------------------------------------------------------------------------------------------------------------------
-- 4. Aggregated Orders
aggregated_orders AS (
    SELECT
        month,
        country_code,
        rider_id,
        &apos;Cancelled MAD&apos; AS fraud_pillar,
        COUNT(DISTINCT order_id) AS total_orders,
        COUNT(DISTINCT CASE WHEN vendor_order_status = &apos;cancelled&apos; AND cancellation_reason = &apos;UNPROFESSIONAL_BEHAVIOUR&apos; THEN order_id END) AS mad_orders
    FROM orders_cte
    GROUP BY 1, 2, 3
),

------------------------------------------------------------------------------------------------------------------------------
-- 5. Misbehaviours
orders_misbehaviours AS (
    WITH
    undispatchs AS (
        SELECT DISTINCT
            o.country_code,
            t.rider_id,
            DATE_TRUNC(DATE(d.created_at, d.timezone), MONTH) AS month,
            COUNT(undispatch_type) AS undispatch
        FROM `fulfillment-dwh-production.curated_data_shared.orders` AS o
        LEFT JOIN UNNEST(o.deliveries) AS d
        LEFT JOIN UNNEST(d.transitions) AS t
        INNER JOIN filtered_riders fr 
          ON fr.rider_id = t.rider_id AND fr.country_code = o.country_code
        WHERE
            o.created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
            AND t.rider_id IS NOT NULL
            AND NOT is_preorder
            AND undispatch_type IN (&apos;manual_undispatch&apos;)
        GROUP BY ALL
    ),
    raw AS (
        SELECT DISTINCT
            o.country_code,
            d.rider_id,
            DATE_TRUNC(DATE(d.created_at, d.timezone), MONTH) AS month,
            COUNT(DISTINCT CASE WHEN ST_DISTANCE(dropoff, customer.location) &gt;&gt; 1000 THEN platform_order_code END) AS outside_geofence
        FROM `fulfillment-dwh-production.curated_data_shared.orders` AS o
        CROSS JOIN UNNEST(o.deliveries) AS d
        INNER JOIN filtered_riders fr USING (country_code, rider_id)
        WHERE o.created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        GROUP BY ALL
    )
    SELECT DISTINCT
        r.country_code,
        r.rider_id,
        r.month,
        r.outside_geofence AS outside_geofence,
        u.undispatch AS undispatch
    FROM raw AS r
    FULL JOIN undispatchs AS u
        ON r.rider_id = u.rider_id AND r.month = u.month
),

------------------------------------------------------------------------------------------------------------------------------
-- 6. Ghost Riders CTE
facial_recognition_base AS (
    SELECT
        DATE_TRUNC(DATE(iv.created_at), MONTH) AS month,
        r.country_code,
        r.rider_id,
        COUNT(DISTINCT iv.id) AS selfies_mismatch_count
    FROM `fulfillment-dwh-production.curated_data_shared.riders` r, UNNEST(identity_verifications) AS iv
    INNER JOIN filtered_riders fr USING (country_code, rider_id)
    WHERE
        DATE(iv.created_at) BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        AND result = &apos;NO_MATCH&apos;
    GROUP BY 1, 2, 3
),

------------------------------------------------------------------------------------------------------------------------------
-- 7. GPS Off CTE
gps_off_cte AS (
    SELECT
        DATE_TRUNC(DATE(i.created_at, i.timezone), MONTH) AS month,
        i.country_code,
        i.rider_id,
        issue_name AS fraud_pillar,
        COUNT(DISTINCT issue_id) AS gps_off_count
    FROM `fulfillment-dwh-production.curated_data_shared.issues` AS i
    INNER JOIN filtered_riders fr USING (country_code, rider_id)
    WHERE
        i.created_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        AND issue_name = &apos;Courier GPS off for X minutes&apos;
        AND i.rider_id IS NOT NULL
    GROUP BY 1, 2, 3, 4
),

------------------------------------------------------------------------------------------------------------------------------
-- 8. RCR CTE
rcr_cte AS (
    SELECT
        DATE_TRUNC(contacts.created_date_localtime, MONTH) AS month,
        SAFE_CAST(contacts.stakeholder_id AS INT64) AS rider_id,
        CASE
            WHEN global_entity_id = &apos;HF_EG&apos; THEN &apos;eg&apos;
            WHEN global_entity_id = &apos;TB_IQ&apos; THEN &apos;iq&apos;
            WHEN global_entity_id = &apos;TB_BH&apos; THEN &apos;bh&apos;
            WHEN global_entity_id = &apos;TB_QA&apos; THEN &apos;qa&apos;
            WHEN global_entity_id = &apos;TB_OM&apos; THEN &apos;om&apos;
            WHEN global_entity_id = &apos;TB_JO&apos; THEN &apos;jo&apos;
            WHEN global_entity_id = &apos;TB_KW&apos; THEN &apos;kw&apos;
            WHEN global_entity_id = &apos;TB_AE&apos; THEN &apos;ae&apos;
        END AS country_code,
        COUNT(DISTINCT contacts.contact_id) as total_contacts
    FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` AS contacts
    INNER JOIN filtered_riders fr
      ON fr.rider_id = SAFE_CAST(contacts.stakeholder_id AS INT64)
      AND fr.country_code = CASE
            WHEN global_entity_id = &apos;HF_EG&apos; THEN &apos;eg&apos;
            WHEN global_entity_id = &apos;TB_IQ&apos; THEN &apos;iq&apos;
            WHEN global_entity_id = &apos;TB_BH&apos; THEN &apos;bh&apos;
            WHEN global_entity_id = &apos;TB_QA&apos; THEN &apos;qa&apos;
            WHEN global_entity_id = &apos;TB_OM&apos; THEN &apos;om&apos;
            WHEN global_entity_id = &apos;TB_JO&apos; THEN &apos;jo&apos;
            WHEN global_entity_id = &apos;TB_KW&apos; THEN &apos;kw&apos;
            WHEN global_entity_id = &apos;TB_AE&apos; THEN &apos;ae&apos;
        END
    WHERE
        stakeholder = &apos;Rider&apos;
        AND contacts.created_date_localtime BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
        AND contacts.contact_reason_l3 IN (
            &quot;Not willing to do the order&quot;, &apos;Unable to contact&apos;, &apos;Large order&apos;, &apos;App issue&apos;, &apos;Equipment issue&apos;,
            &apos;Late preparation&apos;, &apos;Refuse to accept order&apos;, &apos;Address change&apos;, &apos;Wrong address/pinpoint&apos;,
            &apos;Order taken by other rider&apos;, &apos;Chat reason unknown&apos;, &apos;Checking status&apos;, &apos;Updating status&apos;,
            &apos;Break request&apos;, &apos;End break&apos;, &apos;Break status&apos;, &apos;Accident&apos;
        )
    GROUP BY 1, 2, 3
),

------------------------------------------------------------------------------------------------------------------------------
-- 9. Final Aggregated Data
final_aggregated_cte AS (
    SELECT
        aggregated_orders.month,
        aggregated_orders.country_code,
        aggregated_orders.rider_id,
        aggregated_orders.total_orders,
        aggregated_orders.mad_orders,
        aggregated_orders.mad_orders / aggregated_orders.total_orders AS mad_percent,
        COALESCE(unauthorized_apps_cte.issue_count, 0) AS unauthorized_apps,
        COALESCE(fake_gps_cte.issue_count, 0) AS fake_gps,
        COALESCE(orders_misbehaviours.outside_geofence, 0) AS outside_geofence,
        COALESCE(orders_misbehaviours.undispatch, 0) AS undispatch,
        COALESCE(rcr_cte.total_contacts, 0) AS total_contacts,
        COALESCE(rcr_cte.total_contacts, 0) / aggregated_orders.total_orders AS contact_rate,
        COALESCE(gps_off_cte.gps_off_count, 0) AS gps_off_count,
        COALESCE(facial_recognition_base.selfies_mismatch_count, 0) AS selfies_mismatch_count,
        riders.last_contract_name,
        cities.city_name,
        riders.last_operating_zone_name AS zone,
        riders.current_batch_number
    FROM aggregated_orders
    LEFT JOIN unauthorized_apps_cte
        ON unauthorized_apps_cte.rider_id = aggregated_orders.rider_id
        AND unauthorized_apps_cte.month = aggregated_orders.month
        AND unauthorized_apps_cte.country_code = aggregated_orders.country_code
    LEFT JOIN fake_gps_cte
        ON fake_gps_cte.rider_id = aggregated_orders.rider_id
        AND fake_gps_cte.month = aggregated_orders.month
        AND fake_gps_cte.country_code = aggregated_orders.country_code
    LEFT JOIN orders_misbehaviours
        ON orders_misbehaviours.country_code = aggregated_orders.country_code
        AND orders_misbehaviours.rider_id = aggregated_orders.rider_id
        AND orders_misbehaviours.month = aggregated_orders.month
    LEFT JOIN rcr_cte
        ON rcr_cte.rider_id = aggregated_orders.rider_id
        AND rcr_cte.month = aggregated_orders.month
        AND rcr_cte.country_code = aggregated_orders.country_code
    LEFT JOIN gps_off_cte
        ON gps_off_cte.rider_id = aggregated_orders.rider_id
        AND gps_off_cte.month = aggregated_orders.month
        AND gps_off_cte.country_code = aggregated_orders.country_code
    LEFT JOIN facial_recognition_base
        ON facial_recognition_base.rider_id = aggregated_orders.rider_id
        AND facial_recognition_base.month = aggregated_orders.month
        AND facial_recognition_base.country_code = aggregated_orders.country_code
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` AS riders
        ON riders.rider_id = aggregated_orders.rider_id
        AND riders.country_code = aggregated_orders.country_code
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS cities
        ON cities.country_code = riders.country_code
        AND cities.city_id = riders.last_city_id
    WHERE
        aggregated_orders.total_orders &gt;&gt; 0
        OR (unauthorized_apps_cte.issue_count &gt;&gt; 0 OR fake_gps_cte.issue_count &gt;&gt; 0)
        OR (aggregated_orders.mad_orders / aggregated_orders.total_orders) &gt;&gt; 0
        OR orders_misbehaviours.outside_geofence &gt;&gt; 0
        OR orders_misbehaviours.undispatch &gt;&gt; 0
        OR rcr_cte.total_contacts &gt;&gt; 0
        OR gps_off_cte.gps_off_count &gt;&gt; 0
        OR facial_recognition_base.selfies_mismatch_count &gt;&gt; 0
),

------------------------------------------------------------------------------------------------------------------------------
stats AS (
    SELECT
        MIN(mad_orders) AS min_mad,
        MAX(mad_orders) AS max_mad,
        MIN(unauthorized_apps) AS min_unauth,
        MAX(unauthorized_apps) AS max_unauth,
        MIN(fake_gps) AS min_fake,
        MAX(fake_gps) AS max_fake,
        MIN(outside_geofence) AS min_geo,
        MAX(outside_geofence) AS max_geo,
        MIN(undispatch) AS min_delivery,
        MAX(undispatch) AS max_delivery,
        MIN(contact_rate) AS min_contact_rate,
        MAX(contact_rate) AS max_contact_rate,
        MIN(total_contacts) AS min_total_contacts,
        MAX(total_contacts) AS max_total_contacts,
        MIN(gps_off_count) AS min_gps_off_count,
        MAX(gps_off_count) AS max_gps_off_count,
        MIN(selfies_mismatch_count) AS min_selfies_mismatch_count,
        MAX(selfies_mismatch_count) AS max_selfies_mismatch_count
    FROM final_aggregated_cte
),

------------------------------------------------------------------------------------------------------------------------------
normalized AS (
    SELECT
        final_aggregated_cte.*,
        SAFE_DIVIDE(mad_orders - s.min_mad, s.max_mad - s.min_mad) AS norm_mad,
        SAFE_DIVIDE(unauthorized_apps - s.min_unauth, s.max_unauth - s.min_unauth) AS norm_unauth,
        SAFE_DIVIDE(fake_gps - s.min_fake, s.max_fake - s.min_fake) AS norm_fake,
        SAFE_DIVIDE(outside_geofence - s.min_geo, s.max_geo - s.min_geo) AS norm_geo,
        SAFE_DIVIDE(undispatch - s.min_delivery, s.max_delivery - s.min_delivery) AS norm_delivery,
        SAFE_DIVIDE(contact_rate - s.min_contact_rate, s.max_contact_rate - s.min_contact_rate) AS norm_contact_rate,
        SAFE_DIVIDE(total_contacts - s.min_total_contacts, s.max_total_contacts - s.min_total_contacts) AS norm_total_contacts,
        SAFE_DIVIDE(gps_off_count - s.min_gps_off_count, s.max_gps_off_count - s.min_gps_off_count) AS norm_gps_off_count,
        SAFE_DIVIDE(selfies_mismatch_count - s.min_selfies_mismatch_count, s.max_selfies_mismatch_count - s.min_selfies_mismatch_count) AS norm_min_selfies_mismatch_count
    FROM final_aggregated_cte
    CROSS JOIN stats AS s
)

------------------------------------------------------------------------------------------------------------------------------
SELECT
    normalized.month,
    normalized.country_code,
    normalized.rider_id,
    normalized.total_orders,
    normalized.mad_orders,
    normalized.mad_percent,
    normalized.unauthorized_apps,
    normalized.fake_gps,
    normalized.outside_geofence,
    normalized.undispatch AS reassignments,
    normalized.contact_rate,
    normalized.total_contacts,
    normalized.gps_off_count,
    normalized.selfies_mismatch_count,
    (
        5.4 * normalized.mad_orders
        + 4 * (normalized.unauthorized_apps + normalized.fake_gps)
        + 0.1 * normalized.outside_geofence
        + 0.15 * normalized.undispatch
        + 0.1 * normalized.total_contacts
        + 0.2 * normalized.gps_off_count
        + 0.05 * normalized.selfies_mismatch_count
    ) AS absolute_score,
    CASE
        WHEN (
            5.4 * normalized.mad_orders
            + 4 * (normalized.unauthorized_apps + normalized.fake_gps)
            + 0.1 * normalized.outside_geofence
            + 0.15 * normalized.undispatch
            + 0.1 * normalized.total_contacts
            + 0.2 * normalized.gps_off_count
            + 0.05 * normalized.selfies_mismatch_count
        ) &gt;&gt;= 27.75 THEN 0
        ELSE 1
    END AS p90_flag,
    normalized.last_contract_name,
    normalized.city_name,
    normalized.zone,
    normalized.current_batch_number
FROM normalized
WHERE country_code = &apos;ae&apos;
)

SELECT 
    r.country_code, 
    r.rider_id, 
    r.country_of_birth, 
    r.nationality, 
    r.last_contract_name, 
    s.shift_date,
    DATE_TRUNC(DATE(s.shift_date), MONTH) AS month,
    s.total_working_hours,
    s.total_planned_working_hours,
    s.total_active_working_hours,
    s.successful_order_count,
    s.order_count,
    c.is_fully_compliant,
    i.absolute_score,
    i.p90_flag
FROM shift_order s
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` r USING (country_code, rider_id)
LEFT JOIN
    (SELECT
        country_code,
        rider_id,
        MAX(compliance_status != &apos;compliant&apos;) = FALSE AS is_fully_compliant
    FROM `tlb-data-prod.data_platform.fct_logistics_rider_compliance`
    GROUP BY 1,2) c
ON s.country_code = c.country_code
AND s.rider_id = c.rider_id
LEFT JOIN integrity i
  ON i.rider_id = s.rider_id
  AND i.country_code = s.country_code
  AND i.month = DATE_TRUNC(s.shift_date, MONTH)
WHERE s.shift_date BETWEEN (SELECT start_date FROM date_param) AND (SELECT end_date FROM date_param)
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='_2F9DE31091784D1ABC634488001C913D' table='[Extract].[_2F9DE31091784D1ABC634488001C913D]' type='table' />
            </properties>
          </object>
          <object caption='calendar' id='_31C3A2189F614116A6C7CAFCAB509820'>
            <properties context=''>
              <relation connection='bigquery.13j6y0y0qo24jn15uqqrt0wm8etd' name='Custom SQL Query3' type='text'>SELECT date, month_start_date
FROM `tlb-data-prod.data_platform.dim_date`
WHERE date BETWEEN &apos;2025-01-01&apos; AND CURRENT_DATE()</relation>
            </properties>
            <properties context='extract'>
              <relation name='_31C3A2189F614116A6C7CAFCAB509820' table='[Extract].[_31C3A2189F614116A6C7CAFCAB509820]' type='table' />
            </properties>
          </object>
          <object caption='RSAT_survey' id='_D0CE9D0BCAFD433D8F05D8580A9203DE'>
            <properties context=''>
              <relation connection='bigquery.13j6y0y0qo24jn15uqqrt0wm8etd' name='Custom SQL Query1' type='text'>-- Build RSAT component scores
WITH RsatComponentScore AS (
  SELECT
    country_code,
    last_contract_name,
    month,
    (
      COALESCE(SAFE_DIVIDE(COUNTIF(question LIKE &apos;QID2_1%&apos; AND CAST(answer AS INT64) &gt;&gt;= 4),
                           COUNTIF(question LIKE &apos;QID2_1%&apos;)), 0) * 0.35 +
      COALESCE(SAFE_DIVIDE(COUNTIF(question LIKE &apos;QID2_3%&apos; AND CAST(answer AS INT64) &gt;&gt;= 4),
                           COUNTIF(question LIKE &apos;QID2_3%&apos;)), 0) * 0.30 +
      COALESCE(SAFE_DIVIDE(COUNTIF(question LIKE &apos;QID2_2%&apos; AND CAST(answer AS INT64) &gt;&gt;= 4),
                           COUNTIF(question LIKE &apos;QID2_2%&apos;)), 0) * 0.10 +
      COALESCE(SAFE_DIVIDE(COUNTIF(question LIKE &apos;QID2_4%&apos; AND CAST(answer AS INT64) &gt;&gt;= 4),
                           COUNTIF(question LIKE &apos;QID2_4%&apos;)), 0) * 0.10
    ) AS satisfaction_percentage
  FROM (
    SELECT
      r.country_code,
      q.question,
      q.answer,
      DATE_TRUNC(DATE(r.created_at), MONTH) AS month,
      lr.last_contract_name
    FROM
      `fulfillment-dwh-production.curated_data_shared.rsat_responses` AS r,
      UNNEST(r.responses) AS q
    LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` lr
      USING (rider_id, country_code)
    WHERE q.question NOT LIKE &apos;%TEXT%&apos;
      AND lr.last_contract_name = &apos;Zone Delivery Services L.L.C&apos;
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY r.rider_id, q.question, DATE_TRUNC(DATE(r.created_at), MONTH)
      ORDER BY r.created_at DESC
    ) = 1
  )
  GROUP BY 1,2,3
),

-- Build CSAT component scores
CsatComponentScore AS (
  SELECT
    SUBSTR(LOWER(h.global_entity_id), -2) AS country_code,
    lr.last_contract_name,
    DATE_TRUNC(DATE(h.created_date), MONTH) AS month,
    SAFE_DIVIDE(COUNTIF(c.csat &gt;&gt;= 4), COUNT(c.csat)) AS csat_percentage
  FROM
    `fulfillment-dwh-production.curated_data_shared.herocare_chats` AS h
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared.all_csat_responses` AS c
      ON c.chat_id = h.hc_identifier
      AND c.stakeholder = &quot;Rider&quot;
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` lr
    ON SUBSTR(LOWER(h.global_entity_id), -2) = lr.country_code
   AND SAFE_CAST(h.customer_id AS INT64) = lr.rider_id
  WHERE h.stakeholder = &quot;Rider&quot;
    AND h.created_date &gt;&gt;= &quot;2025-06-01&quot;
    AND c.csat IS NOT NULL
    AND lr.last_contract_name = &apos;Zone Delivery Services L.L.C&apos;
  GROUP BY 1,2,3
)

-- Final weighted overall score
SELECT
  COALESCE(rsat.country_code, csat.country_code) AS country_code,
  COALESCE(rsat.month, csat.month) AS month,
  COALESCE(rsat.last_contract_name,  csat.last_contract_name) AS last_contract_name,
  rsat.satisfaction_percentage,
  csat.csat_percentage,
  (
    COALESCE(rsat.satisfaction_percentage, 0) * 0.85 +
    COALESCE(csat.csat_percentage, 0) * 0.15
  ) AS final_overall_score_percentage
FROM RsatComponentScore rsat
FULL OUTER JOIN CsatComponentScore csat
  ON rsat.country_code = csat.country_code
  AND rsat.last_contract_name = csat.last_contract_name
  AND rsat.month = csat.month
ORDER BY country_code, last_contract_name, month</relation>
            </properties>
