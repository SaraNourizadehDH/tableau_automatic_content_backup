          <named-connection caption='BigQuery' name='bigquery.03w5jpa1um4f1x1d2iyq804nvumh'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_logistics' server-oauth='server-custom' username='andrew.iskandar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03w5jpa1um4f1x1d2iyq804nvumh' name='Custom SQL Query' type='text'><![CDATA[with vars as (
  select 
  greatest(date('2024-10-1'), date_sub(current_date(), interval 90 day)) as start,
  current_date() as stop,
  --100 as awt_threshold
  <[Parameters].[Parameter 1]>*60 as awt_threshold
)

, delivery_geo as (
  select 
  country_code,
  delivery_id,
  rider_30m_to_pickup_at is not null as is_30m_trigger,
  rider_30m_to_pickup_at as rider_at_restaurant_at,
  rider_30m_to_pickup_exit_at as rider_left_restaurant_at,
  rider_picked_up_at between rider_30m_to_pickup_at and rider_30m_to_pickup_exit_at as is_pu_accurate,
  
  from vars, `fulfillment-dwh-production.curated_data_shared.deliveries_geofence_timings`

  where 0=0 
  and created_date between start and stop
)

, deliveries as (
  select 
  o.created_date,
  o.country_code,
  o.vendor.vertical_type,
  platform_order_code,
  d.id as delivery_id,
  delivery_status,
  original_scheduled_pickup_at as committed_pu_time,
  rider_picked_up_at,
  is_primary,
  -- vendor_delay_v2,
  -- vendor_delay_v3,
  o.timings.order_delay,
  stacked_deliveries_rank,
  stacked_deliveries_rank is not null as is_stacked,
  stacked_deliveries_rank = max(stacked_deliveries_rank) over(partition by o.country_code, platform_order_code) as is_last_stack_rank,

  from vars, `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) d
  -- join `tlb-data-prod.data_platform.fct_logistics_order` lo on (lo.country_code = o.country_code and o.platform_order_code = lo.order_code)

  where 0=0
  and o.created_date between start and stop
  and platform in ("TB","TB_OT")
  and o.country_code is not null
  and o.vendor.vertical_type is not null
)

, vendor_delay_calc as (
  select 
  o.country_code,
  platform_order_code,
  d.id as delivery_id,
  CASE
      WHEN rider_30m_to_pickup_at <<= original_scheduled_pickup_at THEN TIMESTAMP_DIFF(d.rider_picked_up_at, original_scheduled_pickup_at, SECOND)
      ELSE TIMESTAMP_DIFF(d.rider_picked_up_at, rider_30m_to_pickup_at,SECOND)
  END AS vendor_delay_v2_calc,

  from vars, `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) d
--  left join `fulfillment-dwh-production.curated_data_shared.deliveries_geofence_timings` g on (g.country_code = o.country_code and g.delivery_id = d.id)

  where 0=0
  and o.created_date between start and stop
  and platform in ("TB","TB_OT")
  and o.country_code is not null
)

select 
country_code,
vertical_type,
date_trunc(created_date, week) as week,
is_pu_accurate,
g.rider_at_restaurant_at << d.committed_pu_time as is_rider_early,
(not is_stacked or (is_stacked and is_last_stack_rank)) and timestamp_diff(rider_at_restaurant_at, committed_pu_time, second) <<=600 and vendor_delay_v2_calc >>= awt_threshold as is_chargeable_awt,
count (distinct delivery_id) as total_deliveries,
count (distinct case when delivery_status ='cancelled' then delivery_id end) as cancelled_deliveries,
count (distinct case when vendor_delay_v2_calc/60 >> 10 then delivery_id end) vendor_late_deliveries,
count (distinct case when order_delay/60 >> 10 then delivery_id end) late_deliveries,
count (distinct case when order_delay/60 between -10 and 10 then delivery_id end) ontime_deliveries,
count (distinct case when is_stacked then delivery_id end) as stacked_deliveries,
sum(timestamp_diff(rider_picked_up_at, rider_at_restaurant_at, second))/60 as avt_30,
sum (
  case 
    when (not is_stacked or (is_stacked and is_last_stack_rank)) and rider_at_restaurant_at << committed_pu_time then timestamp_diff(rider_picked_up_at, committed_pu_time, second) -- not stacked or is last stack, rider early
    when (not is_stacked or (is_stacked and is_last_stack_rank)) and rider_at_restaurant_at >> committed_pu_time and timestamp_diff(rider_picked_up_at, committed_pu_time, second) << awt_threshold and vendor_delay_v2_calc >> awt_threshold then timestamp_diff(rider_picked_up_at, rider_at_restaurant_at, second) -- not stacked or is last stack, rider late by <<10min and vendor late >>10min
    when (not is_stacked or (is_stacked and is_last_stack_rank)) and rider_at_restaurant_at >> committed_pu_time and timestamp_diff(rider_picked_up_at, committed_pu_time, second) >> awt_threshold then 0 -- not stacked or is last stack, rider late by >>10min
    else 0
  end
)/60 as awt,

sum (
  case 
    when (not is_stacked or (is_stacked and is_last_stack_rank)) and timestamp_diff(rider_at_restaurant_at, committed_pu_time, second) <<=600 then vendor_delay_v2_calc -- not stacked or is last stack, rider late by <<10min and vendor late >>10min
    else 0
  end
)/60 as awt_v2,

from vars, deliveries d 
left join delivery_geo g using (country_code, delivery_id) 
left join vendor_delay_calc v using (country_code, delivery_id) 

where 0=0
and is_primary

group by all]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
