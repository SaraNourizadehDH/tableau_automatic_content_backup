      <aliases enabled='yes' />
      <column caption='% Ontime' datatype='real' default-format='p0.0%' name='[% Vendor Delay (30m) (copy) (copy)_6614591598756941831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ontime_deliveries]) / SUM([total_deliveries])' />
      </column>
      <column caption='% Order Late ' datatype='real' default-format='p0.0%' name='[% Vendor Delay (30m) (copy)_6614591598756929542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_deliveries]) / SUM([total_deliveries])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0b7av7p1kv6vye13x1p8019zeok0].[pcto:sum:total_deliveries:qk:2]&quot;' value='% Share Total Deliveries' />
          <alias key='&quot;[federated.0b7av7p1kv6vye13x1p8019zeok0].[pcto:sum:total_deliveries:qk]&quot;' value='% of Total Total Deliveries' />
        </aliases>
      </column>
      <column caption='% Chargeable Orders' datatype='real' default-format='p0.0%' name='[Calculation_4734549887109701632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_chargeable_awt] THEN [total_deliveries] END) &#10;/ &#10;SUM([total_deliveries])' />
      </column>
      <column caption='Total Variable Fees' datatype='real' name='[Calculation_6614591598754840577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6614591598763036681] * SUM([total_deliveries]) * [Parameters].[Parameter 2]' />
      </column>
      <column caption='Avg. AWT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6614591598755840004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([awt_v2]) / SUM([total_deliveries])' />
      </column>
      <column caption='% Vendor Delay (30m)' datatype='real' default-format='p0.0%' name='[Calculation_6614591598756032517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_deliveries]) / SUM([total_deliveries])' />
      </column>
      <column caption='AVT 30m' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6614591598758473736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avt_30]) / SUM([total_deliveries])' />
      </column>
      <column caption='Avg. Chargeable AWT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6614591598763036681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_chargeable_awt] THEN [awt_v2] - ([Parameters].[Parameter 1]*[total_deliveries]) END) &#10;/ &#10;SUM([total_deliveries])' />
      </column>
      <column aggregation='Sum' caption='Month' datatype='integer' name='[Calculation_6614591599750950923]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MONTH([week])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_6614591599752269836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[AWT Threshold (min) (copy)] = &quot;Rider Arrival&quot; THEN [Calculation_6614591599752896525]&#10;ELSEIF [Parameters].[AWT Threshold (min) (copy)] = &quot;Vertical&quot; THEN [vertical_type]&#10;ELSE [country_code]&#10;END' />
      </column>
      <column caption='Rider Arrival' datatype='string' name='[Calculation_6614591599752896525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_rider_early] THEN &quot;3. Rider Early&quot; &#10;ELSEIF NOT [is_rider_early] THEN &quot;2. Rider Late&quot;&#10;ELSE &quot;1. NULL&quot; &#10;END' />
      </column>
      <column caption='Total Fixed Fees' datatype='real' name='[Total Variable Fees (copy)_6614591598755053571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_chargeable_awt] THEN [total_deliveries] END) * [Parameters].[Parameter 3]' />
      </column>
      <column caption='Total Chargeable Fees' datatype='real' name='[Total Variable Fees (copy)_6614591598764392458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Variable Fees (copy)_6614591598755053571] + [Calculation_6614591598754840577]' />
      </column>
