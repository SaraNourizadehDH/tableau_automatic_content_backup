      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='8'>You can expand the view at the Country/City/Vendor/TCT Vicinity Distance level. Please hover over Country and click on the &apos;+&apos; button to expand it.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='New Tmart Targets &amp; Simulation' name='federated.0izac2g19rviwa10x7llu0bywurb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Zone Breakdown' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0izac2g19rviwa10x7llu0bywurb'>
            <column caption='% Orders DT&lt;= 15 AVT 90% Optimized' datatype='real' name='[% Orders DT&lt;= 15 AVT Optimized (copy)_452893252293668882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avt_optimized_compliant_orders_90])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 All exc Store Openings 90% Optimized' datatype='real' name='[% Orders DT&lt;= 15 All exc Store Openings Optimized (copy)_452893252264960000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([optimized_except_store_compliant_orders_90])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 Prep Time 90% Optimized' datatype='real' name='[% Orders DT&lt;= 15 Prep Time Optimized (copy)_452893252265164801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_optimized_compliant_orders_90])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 RRV 90% Optimized' datatype='real' name='[% Orders DT&lt;= 15 RRV Optimized (copy) (copy) (copy)_452893252266012683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rrv_optimized_compliant_orders_90])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 Logistics 90% Optimized' datatype='real' name='[% Orders DT&lt;= 15 RRV and Stacking Optimized (copy) (copy)_452893252265668615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_optimized_compliant_orders_90])/SUM([order_count])' />
            </column>
            <column caption='%Orders DT&lt;= 15' datatype='real' name='[Calculation_3824400523017773056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_compliant_orders])/SUM([order_count])' />
            </column>
            <column caption='Zone' datatype='string' name='[Calculation_452893252271005709]' role='dimension' type='nominal'>
