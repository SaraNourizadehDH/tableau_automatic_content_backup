    <datasource caption='New Tmart Targets &amp; Simulation' inline='true' name='federated.0izac2g19rviwa10x7llu0bywurb' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.190mrew174mtbw17zapci1t80xjs'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='duygu.chaturvedi@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.190mrew174mtbw17zapci1t80xjs' name='Custom SQL Query' type='text'><![CDATA[------------------------------------------------------------------------------------------------
---------------------H2 Target Setting tMart ---------------------------------------------------
------------------------------------------------------------------------------------------------

WITH vendor_info AS 
(
  SELECT 
      dvi.vendor_id,
      dvi.vendor_name,
      dvi.country_code,
      dli.city_name as city
    FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
    WHERE  dvi.country_code IN ('AE','BH','EG','OM','QA')
      AND dvi.is_darkstore
      AND vendor_id=parent_vendor_id
),
q AS 
(
SELECT 
  country_code,
  order_id,
  unique_items_count,
  sold_quantity
FROM `tlb-data-prod.data_platform.agg_order_item` 
WHERE order_date >>= '2025-01-01'
  AND country_code IN ('AE','BH','EG','OM','QA')
  ) ,
base AS 
(
  SELECT 
  --order level data  
    upper(o.country_code) AS country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.order_id,
    o.platform_order_code,
    date(o.created_at,o.timezone) AS order_date,
    o.timings.to_vendor_time/60 AS tvt_mins,
    o.timings.at_vendor_time/60 AS avt_mins,
    o.timings.at_vendor_time_cleaned/60 AS avtc_mins,
    o.timings.to_customer_time/60 AS tct_mins,
    o.timings.actual_delivery_time/60 AS adt_mins,
  --delivery level data
    d.id AS delivery_id, 
    d.delivery_status,
    date(d.created_at,o.timezone) AS delivery_date,
    d.is_stacked_intravendor AS is_stacked,
    d.vehicle.vehicle_bag,
    d.vehicle.name AS vehicle_name,
    d.stacked_deliveries_rank,
    CASE WHEN d.is_stacked_intravendor IS FALSE THEN 'Non-Stacked'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=1 THEN 'First Delivery of Stacked Orders'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=2 THEN 'Second Delivery of Stacked Orders'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=3 THEN 'Third Delivery of Stacked Orders' 
         WHEN d.is_stacked_intravendor IS TRUE THEN 'Stacked Order' END stacking_type,
    d.delivery_distance/1000 AS delivery_distance_km,
    d.dropoff_distance_manhattan/1000 AS dropoff_distance_km,
    (timestamp_diff(d.rider_dispatched_at, o.created_at, second)+timestamp_diff(d.rider_accepted_at, d.rider_dispatched_at, second)+o.timings.to_vendor_time)/60 AS rrv_mins,
    v.vendor_name,
    city,
    CASE WHEN unique_items_count<<10 THEN TRUE ELSE FALSE END AS below_10_unique_items,
      CASE WHEN o.country_code='ae' AND LOWER(d.vehicle.name) NOT LIKE '%car%' THEN TRUE
           WHEN o.country_code<<>>'ae' THEN TRUE ELSE FALSE END AS vehicle_scope,
      CASE WHEN o.country_code='om' AND vendor_name IN ('Talabat Mart, Amerat, Mahaj',
                                                      'talabat mart, Al Khuwayr South',
                                                      'Talabat Mart, Ruwi',
                                                      'talabat mart, Hail South',
                                                      'talabat mart,Maabela South',
                                                      'Talabat Mart, Ghala') THEN TRUE
           WHEN o.country_code IN ('ae','bh','qa') THEN TRUE
           WHEN o.country_code='eg' AND city IN ('Alexandria', 'Cairo') THEN TRUE ELSE FALSE END AS store_scope,
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  LEFT JOIN q ON o.platform_order_code=cast(q.order_id AS string) AND o.country_code=lower(q.country_code)
  WHERE o.created_date >>= '2024-12-31'
    AND UPPER(o.country_code) IN ('AE','BH','EG','OM','QA')
    AND d.is_primary 
    AND d.is_returning IS FALSE
    AND d.is_redelivery IS FALSE
    AND o.order_status = 'completed'
    AND d.delivery_status = 'completed'
),
tmart_targets AS -- these values are calculated as p75th of every metric of January data (hardcoded to increase the efficiency of the query)
( 
  SELECT 'AE' AS country_code,1.767 AS rider_tvt_perc,2.767 AS total_prep_time_perc,3.691 AS handover_time_perc,4.383 AS avt_perc,8.267 AS tct_perc,0.507 AS speed_perc
  UNION ALL
  SELECT 'BH' AS country_code,1.983 AS rider_tvt_perc,3.895 AS total_prep_time_perc,2.855 AS handover_time_perc,4.35 AS avt_perc,8.417 AS tct_perc,0.442 AS speed_perc
  UNION ALL
  SELECT 'OM' AS country_code,1.5 AS rider_tvt_perc,3.18 AS total_prep_time_perc,2.854 AS handover_time_perc,4.283 AS avt_perc,8.633 AS tct_perc,0.562 AS speed_perc
  UNION ALL
  SELECT 'EG' AS country_code,2.967 AS rider_tvt_perc,2.474 AS total_prep_time_perc,4.571 AS handover_time_perc,4.333 AS avt_perc,7.367 AS tct_perc,0.395 AS speed_perc
  UNION ALL
  SELECT 'QA' AS country_code,1.583 AS rider_tvt_perc,3.745 AS total_prep_time_perc,1.906 AS handover_time_perc,3.8 AS avt_perc,9.183 AS tct_perc,0.502 AS speed_perc
),

tmart_targets_new AS -- these values are 2nd version we worked on
( 
  SELECT 'AE' AS country_code,3 AS rider_tvt_perc,3 AS total_prep_time_perc,4.27 AS handover_time_perc,4.27 AS avt_perc,8.27 AS tct_perc,0.507 AS speed_perc
  UNION ALL
  SELECT 'BH' AS country_code,2.5 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.35 AS handover_time_perc,4.35 AS avt_perc,8.42 AS tct_perc,0.442 AS speed_perc
  UNION ALL
  SELECT 'OM' AS country_code,2.74 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.48 AS handover_time_perc,4.24 AS avt_perc,8.63 AS tct_perc,0.562 AS speed_perc
  UNION ALL
  SELECT 'EG' AS country_code,3.75 AS rider_tvt_perc,3 AS total_prep_time_perc,4.87 AS handover_time_perc,4.87 AS avt_perc,7.37 AS tct_perc,0.395 AS speed_perc
  UNION ALL
  SELECT 'QA' AS country_code,2.32 AS rider_tvt_perc,4 AS total_prep_time_perc,2.44 AS handover_time_perc,4.12 AS avt_perc,9.18 AS tct_perc,0.502 AS speed_perc
),

zone1 AS --store level
(
  SELECT
    b.*,
    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' THEN 'Jan-Feb' 
         WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' THEN 'May' END AS month_group,
    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' AND b.tct_mins<<=tct_perc THEN 'TCT Vicinity' 
         WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' AND b.tct_mins>>tct_perc THEN 'Out of TCT Vicinity' END AS tct_zone_jf,
    CASE WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' AND b.tct_mins<<=tct_perc THEN 'TCT Vicinity' 
         WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' AND b.tct_mins>>tct_perc THEN 'Out of TCT Vicinity' END AS tct_zone_may,
    
    CASE WHEN b.tct_mins<<=tct_perc THEN 1 ELSE 0 END AS within_tct_target,

    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' THEN dropoff_distance_km END AS dropoff_distance_km_jf,
    CASE WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' THEN dropoff_distance_km END AS dropoff_distance_km_may
  FROM base b
    LEFT JOIN tmart_targets t ON b.country_code=t.country_code
    WHERE store_scope
      AND vehicle_scope
      AND (stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1)
),

tct_dist AS 
(
  SELECT 
    country_code,
    city,
    vendor_name,
    tct_mins,
    tct_zone_jf,
    dropoff_distance_km_jf,
    tct_zone_may,
    dropoff_distance_km_may,
    month_group,
    platform_order_code,
    row_number() OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_jf, tct_mins )                     AS cum_total_jf,
    sum(within_tct_target) OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_jf, tct_mins,platform_order_code ) AS cum_within_target_jf,
    row_number() OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_may, tct_mins ) AS cum_total_may,
    sum(within_tct_target) OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_may, tct_mins,platform_order_code ) AS cum_within_target_may
  FROM zone1
    WHERE tct_mins is not null
    AND month_group IS NOT NULL
),

ratio_data AS 
(
SELECT
  country_code,
  city,
  vendor_name,
  dropoff_distance_km_jf,
  dropoff_distance_km_may,
  month_group,
  CASE WHEN month_group='Jan-Feb' THEN cum_within_target_jf/cum_total_jf END AS target_tct_ratio_jf,
  CASE WHEN month_group='May' THEN cum_within_target_may/cum_total_may END AS target_tct_ratio_may,
FROM tct_dist
)
,
do_dist AS 
(
SELECT
  country_code,
  city,
  vendor_name,
  month_group,
  max(dropoff_distance_km_jf ) AS dropoff_distance_km_jf,
  max(dropoff_distance_km_may) AS dropoff_distance_km_may
FROM ratio_data
  WHERE (target_tct_ratio_jf>>0.75 OR target_tct_ratio_may>>0.75)
  GROUP BY ALL
  
),
tct_distance AS 
(
SELECT 
  country_code,
  city,
  vendor_name,
  coalesce(max(dropoff_distance_km_jf), max(dropoff_distance_km_may)) AS tct_distance_km
FROM do_dist
GROUP BY ALL
),


stacking_effect AS 
(
  SELECT DISTINCT
    b.country_code,
    b.city,
    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) as non_stacked_tct,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) as stacked_tct,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city)/
    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) AS stacking_coeff,

    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN adt_mins END,0.75) OVER (PARTITION BY country_code, city) as non_stacked_adt,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN adt_mins END,0.75) OVER (PARTITION BY country_code, city) as stacked_adt
  FROM base b
    WHERE store_scope
      AND vehicle_scope
      AND order_date BETWEEN '2025-05-01' AND '2025-05-14'
)
,
stacking_target AS 
(
  SELECT 'AE' AS country_code, 0.28 AS stacking_target --exceptDubai. Dubai: .38 same as week of april 7
  UNION ALL
  SELECT 'BH' AS country_code, 0.28 AS stacking_target
  UNION ALL
  SELECT 'OM' AS country_code, 0.25 AS stacking_target
  UNION ALL
  SELECT 'EG' AS country_code,0.34 AS stacking_target -- same as week of april 7
  UNION ALL
  SELECT 'QA' AS country_code,.194 AS stacking_target -- same as week of april 7
),

picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    pickers.country_code AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as prep_time_mins,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
  WHERE created_date>>='2024-12-31'
    AND pickers.country_code IN ('AE','BH','EG','OM','QA')
),
optimization AS 
(
  SELECT  
    b.country_code,
    b.city,
    b.vendor_name,
    date_trunc(b.order_date, month) AS order_month,
    order_date,
    platform_order_code,
    tct_mins,
    rrv_mins,
    avt_mins,
    p.prep_time_mins,
    p.store_dispatch_time,
    adt_mins,
    is_stacked,
    stacked_deliveries_rank,
    delivery_distance_km,
    dropoff_distance_km,
    b.stacking_type,
    t.rider_tvt_perc,
    t.total_prep_time_perc,
    t.handover_time_perc,
    t.avt_perc,
    t.tct_perc,
    t.speed_perc,
    zp.tct_distance_km,
    row_number() OVER(PARTITION BY b.country_code,b.city, date_trunc(order_date, month), stacked_deliveries_rank ORDER BY FARM_FINGERPRINT(CONCAT(platform_order_code, 'stacking')) ) stacking_rn,

    CASE WHEN (stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1) AND dropoff_distance_km <<=tct_distance_km THEN 'TCT Vicinity'
        WHEN stacked_deliveries_rank=2 AND delivery_distance_km <<=tct_distance_km THEN 'TCT Vicinity' 
        ELSE 'Out of TCT Vicinity' END zone_type,
    CASE WHEN rrv_mins>>t.rider_tvt_perc THEN t.rider_tvt_perc ELSE rrv_mins END AS rrv_optimized,
    CASE WHEN avt_mins>>t.avt_perc THEN t.avt_perc ELSE avt_mins END AS avt_optimized,
    CASE WHEN prep_time_mins>>t.total_prep_time_perc THEN t.total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized,

    CASE WHEN stacked_deliveries_rank=2 AND tct_mins>>(delivery_distance_km/t.speed_perc)*s.stacking_coeff THEN (delivery_distance_km/t.speed_perc)*s.stacking_coeff  ELSE tct_mins END AS tct_optimized_1, --better stacking --check optimized tct calc is it division or what

    CASE WHEN stacked_deliveries_rank=2 THEN delivery_distance_km/t.speed_perc END AS nonstacked_tct --if the 2nd delivery of stacked orders would be delivered without stacking
  FROM base b
      LEFT JOIN tmart_targets_new t ON b.country_code=t.country_code
      LEFT JOIN tct_distance zp ON zp.country_code=b.country_code AND zp.city=b.city AND zp.vendor_name=b.vendor_name
      LEFT JOIN picking_data p ON b.country_code=p.country_code AND b.platform_order_code=cast(p.order_id AS string)
      LEFT JOIN stacking_effect s ON b.country_code=s.country_code AND s.city=b.city
        WHERE vehicle_scope
          AND store_scope
          AND below_10_unique_items
          AND order_date>>='2025-01-01'
),
rn AS 
(
  SELECT 
    o.country_code,
    city,
    order_month,
    CASE WHEN city='Dubai' THEN 0.38 ELSE stacking_target END AS stacking_percentage,
    count(platform_order_code) AS order_count
  FROM optimization o
    LEFT JOIN stacking_target s ON s.country_code=o.country_code
      GROUP BY ALL
),
randomized AS 
(
  SELECT 
    *,
    row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'rrv')) ) rrv_random_rn,
      row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'avt')) ) avt_random_rn,
      row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'prep_time')) ) prep_time_random_rn,
  FROM optimization o
),
max_rn AS 
(
  SELECT 
    country_code,
    city,
    vendor_name,
    order_month,
    zone_type,
    count(platform_order_code) AS total_orders
  FROM randomized
    GROUP BY ALL
),

randomized_opt AS 
(
  SELECT 
    o.country_code,
    o.city,
    o.order_month,
    o.vendor_name,
    o.zone_type,
    0.9 - count(CASE WHEN rrv_random_rn/total_orders>>0.9 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_90,
    0.8 - count(CASE WHEN rrv_random_rn/total_orders>>0.8 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_80,
    0.7 - count(CASE WHEN rrv_random_rn/total_orders>>0.7 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_70,
    
    0.9 - count(CASE WHEN avt_random_rn/total_orders>>0.9 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_90,
    0.8 - count(CASE WHEN avt_random_rn/total_orders>>0.8 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_80,
    0.7 - count(CASE WHEN avt_random_rn/total_orders>>0.7 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_70,
    
    0.9 - count(CASE WHEN prep_time_random_rn/total_orders>>0.9 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_90,
    0.8 - count(CASE WHEN prep_time_random_rn/total_orders>>0.8 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_80,
    0.7 - count(CASE WHEN prep_time_random_rn/total_orders>>0.7 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_70,
    
/*
--90% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=0.9 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_90,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=0.9 THEN avt_perc ELSE avt_mins END AS avt_optimized_90,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=0.9 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_90     */   
  FROM randomized o 
    LEFT JOIN max_rn m ON m.country_code=o.country_code AND m.city=o.city AND m.order_month=o.order_month AND m.vendor_name=o.vendor_name AND m.zone_type=o.zone_type  
      GROUP BY ALL
),
output AS 
(
  SELECT 
    o.*,
    CASE WHEN stacked_deliveries_rank=2 AND o.stacking_rn/rn.order_count<<=stacking_percentage/2 THEN tct_optimized_1 
         WHEN o.city='Dubai' AND stacked_deliveries_rank=2 THEN tct_mins -- check this and delete dubai condition later on
         WHEN stacked_deliveries_rank=2 AND o.stacking_rn/rn.order_count>>stacking_percentage/2  THEN nonstacked_tct
         WHEN (stacked_deliveries_rank=1 OR stacked_deliveries_rank IS NULL)                    THEN tct_optimized_1 END AS tct_optimized,

--90% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_90 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_90,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=avt_optimize_90 THEN avt_perc ELSE avt_mins END AS avt_optimized_90,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_90 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_90,

--80% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_80 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_80,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<avt_optimize_80 THEN avt_perc ELSE avt_mins END AS avt_optimized_80,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_90 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_80,
        
--70% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_70 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_70,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=avt_optimize_70 THEN avt_perc ELSE avt_mins END AS avt_optimized_70,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_70 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_70
        
  FROM randomized o 
    LEFT JOIN rn ON rn.country_code=o.country_code AND rn.city=o.city AND rn.order_month=o.order_month
    LEFT JOIN max_rn m ON m.country_code=o.country_code AND m.city=o.city AND m.order_month=o.order_month AND m.vendor_name=o.vendor_name AND m.zone_type=o.zone_type  
    LEFT JOIN randomized_opt ro ON ro.country_code=o.country_code AND ro.city=o.city AND ro.order_month=o.order_month AND ro.vendor_name=o.vendor_name AND ro.zone_type=o.zone_type  

)
SELECT 
  country_code,
  city,
  vendor_name,
  tct_distance_km,
  order_month,
  zone_type,
  rider_tvt_perc,
  total_prep_time_perc,
  handover_time_perc,
  avt_perc,
  tct_perc,
  speed_perc,
  stacking_type,
  count(platform_order_code) AS order_count,
  count(DISTINCT platform_order_code) AS order_count_distinct,
  count(CASE WHEN adt_mins<<16 THEN platform_order_code END) AS dt_compliant_orders,
  count(CASE WHEN rrv_mins<<=rider_tvt_perc THEN platform_order_code END) AS rrv_compliant_orders,
  count(CASE WHEN tct_mins<<=tct_perc THEN platform_order_code END) AS tct_compliant_orders,
  count(CASE WHEN avt_mins<<=tct_perc THEN platform_order_code END) AS avt_compliant_orders,
  count(CASE WHEN prep_time_mins<<=total_prep_time_perc THEN platform_order_code END) AS prep_time_compliant_orders,
--uplift  
  count(CASE WHEN rrv_optimized+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders,
  count(CASE WHEN rrv_optimized+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders,
  count(CASE WHEN rrv_mins+avt_optimized+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders,
  count(CASE WHEN rrv_mins+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  stacking_optimized_compliant_orders,
  count(CASE WHEN prep_time_optimized+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders,
  count(CASE WHEN rrv_optimized+avt_optimized+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders,
--90% optimized uplift  
  count(CASE WHEN rrv_optimized_90+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_90,
  count(CASE WHEN rrv_optimized_90+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_90,
  count(CASE WHEN rrv_mins+avt_optimized_90+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_90,
  count(CASE WHEN prep_time_optimized_90+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_90,
  count(CASE WHEN rrv_optimized_90+avt_optimized_90+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_90,
--80% optimized uplift  
  count(CASE WHEN rrv_optimized_80+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_80,
  count(CASE WHEN rrv_optimized_80+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_80,
  count(CASE WHEN rrv_mins+avt_optimized_80+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_80,
  count(CASE WHEN prep_time_optimized_80+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_80,
  count(CASE WHEN rrv_optimized_80+avt_optimized_80+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_80,
--70% optimized uplift  
  count(CASE WHEN rrv_optimized_70+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_70,
  count(CASE WHEN rrv_optimized_70+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_70,
  count(CASE WHEN rrv_mins+avt_optimized_70+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_70,
  count(CASE WHEN prep_time_optimized_70+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_70,
  count(CASE WHEN rrv_optimized_70+avt_optimized_70+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_70,
FROM output
  GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.190mrew174mtbw17zapci1t80xjs' name='Custom SQL Query' type='text'><![CDATA[------------------------------------------------------------------------------------------------
---------------------H2 Target Setting tMart ---------------------------------------------------
------------------------------------------------------------------------------------------------

WITH vendor_info AS 
(
  SELECT 
      dvi.vendor_id,
      dvi.vendor_name,
      dvi.country_code,
      dli.city_name as city
    FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
    WHERE  dvi.country_code IN ('AE','BH','EG','OM','QA')
      AND dvi.is_darkstore
      AND vendor_id=parent_vendor_id
),
q AS 
(
SELECT 
  country_code,
  order_id,
  unique_items_count,
  sold_quantity
FROM `tlb-data-prod.data_platform.agg_order_item` 
WHERE order_date >>= '2025-01-01'
  AND country_code IN ('AE','BH','EG','OM','QA')
  ) ,
base AS 
(
  SELECT 
  --order level data  
    upper(o.country_code) AS country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.order_id,
    o.platform_order_code,
    date(o.created_at,o.timezone) AS order_date,
    o.timings.to_vendor_time/60 AS tvt_mins,
    o.timings.at_vendor_time/60 AS avt_mins,
    o.timings.at_vendor_time_cleaned/60 AS avtc_mins,
    o.timings.to_customer_time/60 AS tct_mins,
    o.timings.actual_delivery_time/60 AS adt_mins,
  --delivery level data
    d.id AS delivery_id, 
    d.delivery_status,
    date(d.created_at,o.timezone) AS delivery_date,
    d.is_stacked_intravendor AS is_stacked,
    d.vehicle.vehicle_bag,
    d.vehicle.name AS vehicle_name,
    d.stacked_deliveries_rank,
    CASE WHEN d.is_stacked_intravendor IS FALSE THEN 'Non-Stacked'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=1 THEN 'First Delivery of Stacked Orders'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=2 THEN 'Second Delivery of Stacked Orders'
         WHEN d.is_stacked_intravendor IS TRUE AND d.stacked_deliveries_rank=3 THEN 'Third Delivery of Stacked Orders' 
         WHEN d.is_stacked_intravendor IS TRUE THEN 'Stacked Order' END stacking_type,
    d.delivery_distance/1000 AS delivery_distance_km,
    d.dropoff_distance_manhattan/1000 AS dropoff_distance_km,
    (timestamp_diff(d.rider_dispatched_at, o.created_at, second)+timestamp_diff(d.rider_accepted_at, d.rider_dispatched_at, second)+o.timings.to_vendor_time)/60 AS rrv_mins,
    v.vendor_name,
    city,
    CASE WHEN unique_items_count<<10 THEN TRUE ELSE FALSE END AS below_10_unique_items,
      CASE WHEN o.country_code='ae' AND LOWER(d.vehicle.name) NOT LIKE '%car%' THEN TRUE
           WHEN o.country_code<<>>'ae' THEN TRUE ELSE FALSE END AS vehicle_scope,
      CASE WHEN o.country_code='om' AND vendor_name IN ('Talabat Mart, Amerat, Mahaj',
                                                      'talabat mart, Al Khuwayr South',
                                                      'Talabat Mart, Ruwi',
                                                      'talabat mart, Hail South',
                                                      'talabat mart,Maabela South',
                                                      'Talabat Mart, Ghala') THEN TRUE
           WHEN o.country_code IN ('ae','bh','qa') THEN TRUE
           WHEN o.country_code='eg' AND city IN ('Alexandria', 'Cairo') THEN TRUE ELSE FALSE END AS store_scope,
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  LEFT JOIN q ON o.platform_order_code=cast(q.order_id AS string) AND o.country_code=lower(q.country_code)
  WHERE o.created_date >>= '2024-12-31'
    AND UPPER(o.country_code) IN ('AE','BH','EG','OM','QA')
    AND d.is_primary 
    AND d.is_returning IS FALSE
    AND d.is_redelivery IS FALSE
    AND o.order_status = 'completed'
    AND d.delivery_status = 'completed'
),
tmart_targets AS -- these values are calculated as p75th of every metric of January data (hardcoded to increase the efficiency of the query)
( 
  SELECT 'AE' AS country_code,1.767 AS rider_tvt_perc,2.767 AS total_prep_time_perc,3.691 AS handover_time_perc,4.383 AS avt_perc,8.267 AS tct_perc,0.507 AS speed_perc
  UNION ALL
  SELECT 'BH' AS country_code,1.983 AS rider_tvt_perc,3.895 AS total_prep_time_perc,2.855 AS handover_time_perc,4.35 AS avt_perc,8.417 AS tct_perc,0.442 AS speed_perc
  UNION ALL
  SELECT 'OM' AS country_code,1.5 AS rider_tvt_perc,3.18 AS total_prep_time_perc,2.854 AS handover_time_perc,4.283 AS avt_perc,8.633 AS tct_perc,0.562 AS speed_perc
  UNION ALL
  SELECT 'EG' AS country_code,2.967 AS rider_tvt_perc,2.474 AS total_prep_time_perc,4.571 AS handover_time_perc,4.333 AS avt_perc,7.367 AS tct_perc,0.395 AS speed_perc
  UNION ALL
  SELECT 'QA' AS country_code,1.583 AS rider_tvt_perc,3.745 AS total_prep_time_perc,1.906 AS handover_time_perc,3.8 AS avt_perc,9.183 AS tct_perc,0.502 AS speed_perc
),

tmart_targets_new AS -- these values are 2nd version we worked on
( 
  SELECT 'AE' AS country_code,3 AS rider_tvt_perc,3 AS total_prep_time_perc,4.27 AS handover_time_perc,4.27 AS avt_perc,8.27 AS tct_perc,0.507 AS speed_perc
  UNION ALL
  SELECT 'BH' AS country_code,2.5 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.35 AS handover_time_perc,4.35 AS avt_perc,8.42 AS tct_perc,0.442 AS speed_perc
  UNION ALL
  SELECT 'OM' AS country_code,2.74 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.48 AS handover_time_perc,4.24 AS avt_perc,8.63 AS tct_perc,0.562 AS speed_perc
  UNION ALL
  SELECT 'EG' AS country_code,3.75 AS rider_tvt_perc,3 AS total_prep_time_perc,4.87 AS handover_time_perc,4.87 AS avt_perc,7.37 AS tct_perc,0.395 AS speed_perc
  UNION ALL
  SELECT 'QA' AS country_code,2.32 AS rider_tvt_perc,4 AS total_prep_time_perc,2.44 AS handover_time_perc,4.12 AS avt_perc,9.18 AS tct_perc,0.502 AS speed_perc
),

zone1 AS --store level
(
  SELECT
    b.*,
    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' THEN 'Jan-Feb' 
         WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' THEN 'May' END AS month_group,
    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' AND b.tct_mins<<=tct_perc THEN 'TCT Vicinity' 
         WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' AND b.tct_mins>>tct_perc THEN 'Out of TCT Vicinity' END AS tct_zone_jf,
    CASE WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' AND b.tct_mins<<=tct_perc THEN 'TCT Vicinity' 
         WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' AND b.tct_mins>>tct_perc THEN 'Out of TCT Vicinity' END AS tct_zone_may,
    
    CASE WHEN b.tct_mins<<=tct_perc THEN 1 ELSE 0 END AS within_tct_target,

    CASE WHEN order_date >>= '2025-01-01' AND order_date<<= '2025-02-01' THEN dropoff_distance_km END AS dropoff_distance_km_jf,
    CASE WHEN order_date >>= '2025-05-01' AND order_date<<= '2025-05-31' THEN dropoff_distance_km END AS dropoff_distance_km_may
  FROM base b
    LEFT JOIN tmart_targets t ON b.country_code=t.country_code
    WHERE store_scope
      AND vehicle_scope
      AND (stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1)
),

tct_dist AS 
(
  SELECT 
    country_code,
    city,
    vendor_name,
    tct_mins,
    tct_zone_jf,
    dropoff_distance_km_jf,
    tct_zone_may,
    dropoff_distance_km_may,
    month_group,
    platform_order_code,
    row_number() OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_jf, tct_mins )                     AS cum_total_jf,
    sum(within_tct_target) OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_jf, tct_mins,platform_order_code ) AS cum_within_target_jf,
    row_number() OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_may, tct_mins ) AS cum_total_may,
    sum(within_tct_target) OVER (PARTITION BY country_code,city,vendor_name,month_group ORDER BY dropoff_distance_km_may, tct_mins,platform_order_code ) AS cum_within_target_may
  FROM zone1
    WHERE tct_mins is not null
    AND month_group IS NOT NULL
),

ratio_data AS 
(
SELECT
  country_code,
  city,
  vendor_name,
  dropoff_distance_km_jf,
  dropoff_distance_km_may,
  month_group,
  CASE WHEN month_group='Jan-Feb' THEN cum_within_target_jf/cum_total_jf END AS target_tct_ratio_jf,
  CASE WHEN month_group='May' THEN cum_within_target_may/cum_total_may END AS target_tct_ratio_may,
FROM tct_dist
)
,
do_dist AS 
(
SELECT
  country_code,
  city,
  vendor_name,
  month_group,
  max(dropoff_distance_km_jf ) AS dropoff_distance_km_jf,
  max(dropoff_distance_km_may) AS dropoff_distance_km_may
FROM ratio_data
  WHERE (target_tct_ratio_jf>>0.75 OR target_tct_ratio_may>>0.75)
  GROUP BY ALL
  
),
tct_distance AS 
(
SELECT 
  country_code,
  city,
  vendor_name,
  coalesce(max(dropoff_distance_km_jf), max(dropoff_distance_km_may)) AS tct_distance_km
FROM do_dist
GROUP BY ALL
),


stacking_effect AS 
(
  SELECT DISTINCT
    b.country_code,
    b.city,
    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) as non_stacked_tct,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) as stacked_tct,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city)/
    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN tct_mins END,0.75) OVER (PARTITION BY country_code, city) AS stacking_coeff,

    percentile_cont(CASE WHEN stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1 THEN adt_mins END,0.75) OVER (PARTITION BY country_code, city) as non_stacked_adt,
    percentile_cont(CASE WHEN stacked_deliveries_rank=2 THEN adt_mins END,0.75) OVER (PARTITION BY country_code, city) as stacked_adt
  FROM base b
    WHERE store_scope
      AND vehicle_scope
      AND order_date BETWEEN '2025-05-01' AND '2025-05-14'
)
,
stacking_target AS 
(
  SELECT 'AE' AS country_code, 0.28 AS stacking_target --exceptDubai. Dubai: .38 same as week of april 7
  UNION ALL
  SELECT 'BH' AS country_code, 0.28 AS stacking_target
  UNION ALL
  SELECT 'OM' AS country_code, 0.25 AS stacking_target
  UNION ALL
  SELECT 'EG' AS country_code,0.34 AS stacking_target -- same as week of april 7
  UNION ALL
  SELECT 'QA' AS country_code,.194 AS stacking_target -- same as week of april 7
),

picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    pickers.country_code AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as prep_time_mins,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
  WHERE created_date>>='2024-12-31'
    AND pickers.country_code IN ('AE','BH','EG','OM','QA')
),
optimization AS 
(
  SELECT  
    b.country_code,
    b.city,
    b.vendor_name,
    date_trunc(b.order_date, month) AS order_month,
    order_date,
    platform_order_code,
    tct_mins,
    rrv_mins,
    avt_mins,
    p.prep_time_mins,
    p.store_dispatch_time,
    adt_mins,
    is_stacked,
    stacked_deliveries_rank,
    delivery_distance_km,
    dropoff_distance_km,
    b.stacking_type,
    t.rider_tvt_perc,
    t.total_prep_time_perc,
    t.handover_time_perc,
    t.avt_perc,
    t.tct_perc,
    t.speed_perc,
    zp.tct_distance_km,
    row_number() OVER(PARTITION BY b.country_code,b.city, date_trunc(order_date, month), stacked_deliveries_rank ORDER BY FARM_FINGERPRINT(CONCAT(platform_order_code, 'stacking')) ) stacking_rn,

    CASE WHEN (stacked_deliveries_rank IS NULL OR stacked_deliveries_rank=1) AND dropoff_distance_km <<=tct_distance_km THEN 'TCT Vicinity'
        WHEN stacked_deliveries_rank=2 AND delivery_distance_km <<=tct_distance_km THEN 'TCT Vicinity' 
        ELSE 'Out of TCT Vicinity' END zone_type,
    CASE WHEN rrv_mins>>t.rider_tvt_perc THEN t.rider_tvt_perc ELSE rrv_mins END AS rrv_optimized,
    CASE WHEN avt_mins>>t.avt_perc THEN t.avt_perc ELSE avt_mins END AS avt_optimized,
    CASE WHEN prep_time_mins>>t.total_prep_time_perc THEN t.total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized,

    CASE WHEN stacked_deliveries_rank=2 AND tct_mins>>(delivery_distance_km/t.speed_perc)*s.stacking_coeff THEN (delivery_distance_km/t.speed_perc)*s.stacking_coeff  ELSE tct_mins END AS tct_optimized_1, --better stacking --check optimized tct calc is it division or what

    CASE WHEN stacked_deliveries_rank=2 THEN delivery_distance_km/t.speed_perc END AS nonstacked_tct --if the 2nd delivery of stacked orders would be delivered without stacking
  FROM base b
      LEFT JOIN tmart_targets_new t ON b.country_code=t.country_code
      LEFT JOIN tct_distance zp ON zp.country_code=b.country_code AND zp.city=b.city AND zp.vendor_name=b.vendor_name
      LEFT JOIN picking_data p ON b.country_code=p.country_code AND b.platform_order_code=cast(p.order_id AS string)
      LEFT JOIN stacking_effect s ON b.country_code=s.country_code AND s.city=b.city
        WHERE vehicle_scope
          AND store_scope
          AND below_10_unique_items
          AND order_date>>='2025-01-01'
),
rn AS 
(
  SELECT 
    o.country_code,
    city,
    order_month,
    CASE WHEN city='Dubai' THEN 0.38 ELSE stacking_target END AS stacking_percentage,
    count(platform_order_code) AS order_count
  FROM optimization o
    LEFT JOIN stacking_target s ON s.country_code=o.country_code
      GROUP BY ALL
),
randomized AS 
(
  SELECT 
    *,
    row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'rrv')) ) rrv_random_rn,
      row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'avt')) ) avt_random_rn,
      row_number() OVER(PARTITION BY country_code, city, vendor_name, order_month ORDER BY FARM_FINGERPRINT(CONCAT(CAST(platform_order_code AS STRING), 'prep_time')) ) prep_time_random_rn,
  FROM optimization o
),
max_rn AS 
(
  SELECT 
    country_code,
    city,
    vendor_name,
    order_month,
    zone_type,
    count(platform_order_code) AS total_orders
  FROM randomized
    GROUP BY ALL
),

randomized_opt AS 
(
  SELECT 
    o.country_code,
    o.city,
    o.order_month,
    o.vendor_name,
    o.zone_type,
    0.9 - count(CASE WHEN rrv_random_rn/total_orders>>0.9 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_90,
    0.8 - count(CASE WHEN rrv_random_rn/total_orders>>0.8 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_80,
    0.7 - count(CASE WHEN rrv_random_rn/total_orders>>0.7 AND rrv_mins<<=rider_tvt_perc THEN platform_order_code END)/min(total_orders) AS rrv_optimize_70,
    
    0.9 - count(CASE WHEN avt_random_rn/total_orders>>0.9 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_90,
    0.8 - count(CASE WHEN avt_random_rn/total_orders>>0.8 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_80,
    0.7 - count(CASE WHEN avt_random_rn/total_orders>>0.7 AND avt_mins<<=avt_perc THEN platform_order_code END)/min(total_orders) AS avt_optimize_70,
    
    0.9 - count(CASE WHEN prep_time_random_rn/total_orders>>0.9 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_90,
    0.8 - count(CASE WHEN prep_time_random_rn/total_orders>>0.8 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_80,
    0.7 - count(CASE WHEN prep_time_random_rn/total_orders>>0.7 AND prep_time_mins<<=total_prep_time_perc THEN platform_order_code END)/min(total_orders) AS prep_time_optimize_70,
    
/*
--90% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=0.9 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_90,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=0.9 THEN avt_perc ELSE avt_mins END AS avt_optimized_90,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=0.9 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_90     */   
  FROM randomized o 
    LEFT JOIN max_rn m ON m.country_code=o.country_code AND m.city=o.city AND m.order_month=o.order_month AND m.vendor_name=o.vendor_name AND m.zone_type=o.zone_type  
      GROUP BY ALL
),
output AS 
(
  SELECT 
    o.*,
    CASE WHEN stacked_deliveries_rank=2 AND o.stacking_rn/rn.order_count<<=stacking_percentage/2 THEN tct_optimized_1 
         WHEN o.city='Dubai' AND stacked_deliveries_rank=2 THEN tct_mins -- check this and delete dubai condition later on
         WHEN stacked_deliveries_rank=2 AND o.stacking_rn/rn.order_count>>stacking_percentage/2  THEN nonstacked_tct
         WHEN (stacked_deliveries_rank=1 OR stacked_deliveries_rank IS NULL)                    THEN tct_optimized_1 END AS tct_optimized,

--90% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_90 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_90,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=avt_optimize_90 THEN avt_perc ELSE avt_mins END AS avt_optimized_90,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_90 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_90,

--80% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_80 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_80,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<avt_optimize_80 THEN avt_perc ELSE avt_mins END AS avt_optimized_80,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_90 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_80,
        
--70% optimized
    CASE WHEN rrv_mins>>rider_tvt_perc AND rrv_random_rn/total_orders<<=rrv_optimize_70 THEN rider_tvt_perc ELSE rrv_mins END AS rrv_optimized_70,
    CASE WHEN avt_mins>>avt_perc AND avt_random_rn/total_orders<<=avt_optimize_70 THEN avt_perc ELSE avt_mins END AS avt_optimized_70,
    CASE WHEN prep_time_mins>>total_prep_time_perc AND prep_time_random_rn/total_orders<<=prep_time_optimize_70 THEN total_prep_time_perc ELSE prep_time_mins END AS prep_time_optimized_70
        
  FROM randomized o 
    LEFT JOIN rn ON rn.country_code=o.country_code AND rn.city=o.city AND rn.order_month=o.order_month
    LEFT JOIN max_rn m ON m.country_code=o.country_code AND m.city=o.city AND m.order_month=o.order_month AND m.vendor_name=o.vendor_name AND m.zone_type=o.zone_type  
    LEFT JOIN randomized_opt ro ON ro.country_code=o.country_code AND ro.city=o.city AND ro.order_month=o.order_month AND ro.vendor_name=o.vendor_name AND ro.zone_type=o.zone_type  

)
SELECT 
  country_code,
  city,
  vendor_name,
  tct_distance_km,
  order_month,
  zone_type,
  rider_tvt_perc,
  total_prep_time_perc,
  handover_time_perc,
  avt_perc,
  tct_perc,
  speed_perc,
  stacking_type,
  count(platform_order_code) AS order_count,
  count(DISTINCT platform_order_code) AS order_count_distinct,
  count(CASE WHEN adt_mins<<16 THEN platform_order_code END) AS dt_compliant_orders,
  count(CASE WHEN rrv_mins<<=rider_tvt_perc THEN platform_order_code END) AS rrv_compliant_orders,
  count(CASE WHEN tct_mins<<=tct_perc THEN platform_order_code END) AS tct_compliant_orders,
  count(CASE WHEN avt_mins<<=tct_perc THEN platform_order_code END) AS avt_compliant_orders,
  count(CASE WHEN prep_time_mins<<=total_prep_time_perc THEN platform_order_code END) AS prep_time_compliant_orders,
--uplift  
  count(CASE WHEN rrv_optimized+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders,
  count(CASE WHEN rrv_optimized+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders,
  count(CASE WHEN rrv_mins+avt_optimized+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders,
  count(CASE WHEN rrv_mins+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  stacking_optimized_compliant_orders,
  count(CASE WHEN prep_time_optimized+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders,
  count(CASE WHEN rrv_optimized+avt_optimized+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders,
--90% optimized uplift  
  count(CASE WHEN rrv_optimized_90+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_90,
  count(CASE WHEN rrv_optimized_90+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_90,
  count(CASE WHEN rrv_mins+avt_optimized_90+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_90,
  count(CASE WHEN prep_time_optimized_90+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_90,
  count(CASE WHEN rrv_optimized_90+avt_optimized_90+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_90,
--80% optimized uplift  
  count(CASE WHEN rrv_optimized_80+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_80,
  count(CASE WHEN rrv_optimized_80+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_80,
  count(CASE WHEN rrv_mins+avt_optimized_80+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_80,
  count(CASE WHEN prep_time_optimized_80+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_80,
  count(CASE WHEN rrv_optimized_80+avt_optimized_80+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_80,
--70% optimized uplift  
  count(CASE WHEN rrv_optimized_70+avt_mins+tct_optimized<<16 THEN platform_order_code END) AS  log_optimized_compliant_orders_70,
  count(CASE WHEN rrv_optimized_70+avt_mins+tct_mins<<16 THEN platform_order_code END)      AS  rrv_optimized_compliant_orders_70,
  count(CASE WHEN rrv_mins+avt_optimized_70+tct_mins<<16 THEN platform_order_code END)      AS  avt_optimized_compliant_orders_70,
  count(CASE WHEN prep_time_optimized_70+store_dispatch_time+tct_mins<<16 THEN platform_order_code END) AS prep_time_optimized_compliant_orders_70,
  count(CASE WHEN rrv_optimized_70+avt_optimized_70+tct_optimized<<16 THEN platform_order_code END) AS  optimized_except_store_compliant_orders_70,
FROM output
  GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
