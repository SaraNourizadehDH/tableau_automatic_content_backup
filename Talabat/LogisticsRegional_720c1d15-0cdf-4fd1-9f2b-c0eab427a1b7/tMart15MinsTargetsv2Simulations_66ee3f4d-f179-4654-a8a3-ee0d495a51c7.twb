      <table>
        <view>
          <datasources>
            <datasource caption='New Tmart Targets &amp; Simulation' name='federated.0izac2g19rviwa10x7llu0bywurb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Zone Breakdown' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0izac2g19rviwa10x7llu0bywurb'>
            <column caption='% Orders DT&lt;= 15 AVT 80% Optimized' datatype='real' name='[% Orders DT&lt;= 15 AVT Optimized (copy) (copy)_452893252293677075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avt_optimized_compliant_orders_80])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 All exc Store Openings 80% Optimized' datatype='real' name='[% Orders DT&lt;= 15 All exc Store Openings 90% Optimized (copy) (copy)_452893252265394181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([optimized_except_store_compliant_orders_80])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 Prep Time 80% Optimized' datatype='real' name='[% Orders DT&lt;= 15 Prep Time 90% Optimized (copy)_452893252265234434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_optimized_compliant_orders_80])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 RRV 80% Optimized' datatype='real' name='[% Orders DT&lt;= 15 RRV Optimized (copy) (copy)_452893252266000394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rrv_optimized_compliant_orders_80])/SUM([order_count])' />
            </column>
            <column caption='% Orders DT&lt;= 15 Logistics 80% Optimized' datatype='real' name='[% Orders DT&lt;= 15 RRV and Stacking Optimized (copy) (copy 2)_452893252265680904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_optimized_compliant_orders_80])/SUM([order_count])' />
            </column>
            <column caption='%Orders DT&lt;= 15' datatype='real' name='[Calculation_3824400523017773056]' role='measure' type='quantitative'>
