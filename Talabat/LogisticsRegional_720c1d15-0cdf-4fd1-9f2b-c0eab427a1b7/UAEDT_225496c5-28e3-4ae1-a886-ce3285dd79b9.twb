    <worksheet name='Area Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='14'>Map View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Area' name='federated.0kaf0s30xfhuzc10ym98n0cw27id' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0kaf0s30xfhuzc10ym98n0cw27id'>
            <column caption='Area Segmentation' datatype='string' name='[Calculation_2887299983806926848]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Calculation_3907435663036170244] - SUM([Calculation_4196651206643200000]) &lt;= 1 THEN &#10;        &quot;Green&quot;&#10;ELSE&#10;        &quot;Red&quot;&#10;    End' />
            </column>
            <column caption='AVG DT' datatype='real' name='[Calculation_3907435663036170244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='% Late Orders &gt; 10' datatype='real' name='[Calculation_3907435663073144838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_56295035934642177]) / SUM([total_orders])' />
            </column>
            <column caption='Dynamic Aggregation' datatype='real' name='[Calculation_4196651206643200000]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [country_code] , [city_name (Custom SQL Query)] , [vertical_type (Custom SQL Query)] , [DTP] : SUM([DT (Custom SQL Query)]) / SUM([total_orders]) }' />
            </column>
            <column caption='Late Orders' datatype='integer' name='[Calculation_56295035934642177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_late] then [total_orders] END' />
            </column>
            <column caption='Net Fail Rate' datatype='real' name='[Calculation_56295036240912387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / sum([gross_orders])' />
            </column>
            <column datatype='real' name='[DT (Custom SQL Query)]' role='measure' type='quantitative' />
            <column datatype='string' name='[DTP]' role='dimension' type='nominal' />
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='Logistics Fail Rate' datatype='real' name='[Net Fail Rate (copy)_56295036241833988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([logistics_fail]) / sum([gross_orders])' />
            </column>
            <column aggregate-role-from='[city_name (Custom SQL Query)]' caption='Area Name' datatype='string' name='[area_name (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column aggregate-role-from='[country_code]' caption='City Name' datatype='string' name='[city_name (Custom SQL Query)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Geometry]' derivation='Collect' name='[clct:Geometry:nk]' pivot='key' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column caption='Total Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_late]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Fale' />
