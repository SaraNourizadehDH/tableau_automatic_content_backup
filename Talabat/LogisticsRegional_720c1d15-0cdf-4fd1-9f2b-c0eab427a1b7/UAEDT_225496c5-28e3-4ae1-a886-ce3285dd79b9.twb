              <column datatype='string' name='city_id' ordinal='3' />
              <column datatype='string' name='city_name' ordinal='4' />
              <column datatype='string' name='area_id' ordinal='5' />
              <column datatype='string' name='area_name' ordinal='6' />
              <column datatype='string' name='area_lat' ordinal='7' />
              <column datatype='string' name='area_long' ordinal='8' />
              <column datatype='spatial' name='Geometry' ordinal='9' />
            </columns>
          </relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
