    <worksheet name='Rider Side Full DT '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Book' fontsize='14'>DT Full BreakDown - Rider Side</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='11'>Use the </run>
            <run fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Book' fontsize='11'>Data Granularity</run>
            <run bold='false' fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Book' fontsize='11'>Æ </run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='11'>filter to change the view</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Area' name='federated.0kaf0s30xfhuzc10ym98n0cw27id' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kaf0s30xfhuzc10ym98n0cw27id'>
            <column caption='Customer Handover' datatype='real' name='[At Custmer Time (copy)_3907435663166095377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_time (Custom SQL Query)] - [customer_walk_out (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column caption='Vendor Handover' datatype='real' name='[At Vendor Time (copy)_3907435663167254548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time (Custom SQL Query)] - [est_vendor_walk_in (Custom SQL Query)])) / SUM([total_orders])' />
            </column>
            <column caption='Queed Time' datatype='real' name='[Calculation_196821426689634305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Queue_time (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='DATE' datatype='date' default-format='S' name='[Calculation_3197696510023536657]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE[Parameters].[Parameter 1]&#10;WHEN &apos;Month&apos; THEN [Day (copy)_3197696510023389200]&#10;WHEN &apos;Week&apos; THEN [Day (copy)_3197696510023331855]&#10;WHEN &apos;Day&apos; THEN [Day]&#10;END' />
            </column>
            <column caption='Compliance Time' datatype='real' name='[Calculation_3907435663125790728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compliance_time (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='To Vendor' datatype='real' name='[Calculation_3907435663126122505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column caption='Est. Vendor Walk-In' datatype='real' name='[Calculation_3907435663126949899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([est_vendor_walk_in (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column caption='Customer Walk-Out' datatype='real' name='[Customer Walk In (copy)_3907435663166378002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_walk_out (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column datatype='string' name='[DTP]' role='dimension' type='nominal' />
            <column caption='Week' datatype='date' default-format='*\Www' name='[Day (copy)_3197696510023331855]' role='dimension' type='quantitative' user:agg-type='ISO-Week-Trunc' user:base-field='created_date (Custom SQL Query)' user:ui-builder='date-bin-builder'>
