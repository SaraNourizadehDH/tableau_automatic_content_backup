    <worksheet name='Area Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='14'>Area Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='11'>Includes all DT-related metrics at the area level.</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='11'>Collapse or expand the month to adjust the level of granularity.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Area' name='federated.0kaf0s30xfhuzc10ym98n0cw27id' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0kaf0s30xfhuzc10ym98n0cw27id'>
            <column datatype='real' name='[AVTC]' role='measure' type='quantitative' />
            <column caption='AVG Est To Vendor Time' datatype='real' name='[Calculation_196821426974306327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([organic_to_vendor]) / SUM([total_orders])' />
            </column>
            <column caption='Reassignment Rate' datatype='real' name='[Calculation_196821426974634008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([undispatch_count]) / SUM([total_orders])' />
            </column>
            <column caption='AVG To Vendor Late' datatype='real' name='[Calculation_196821426975408153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_late]) / SUM([total_orders])' />
            </column>
            <column caption='AVG AVTC' datatype='real' name='[Calculation_196821426976206874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AVTC]) / SUM([gross_orders])' />
            </column>
            <column caption='AVG VD_30_Geo' datatype='real' name='[Calculation_196821426977144859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VD_30]) / SUM([total_orders])' />
            </column>
            <column caption='AVG Est Drive Time' datatype='real' name='[Calculation_196821427010007068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([drive_time]) / SUM([total_orders])' />
            </column>
            <column caption='AVG To Customer Time Late - Stacking' datatype='real' name='[Calculation_196821427010293789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='AVG To Customer Late' datatype='real' name='[Calculation_196821427011788830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_gap]) / SUM([gross_orders])' />
            </column>
            <column caption='AVG Order Delay' datatype='real' name='[Calculation_196821427025338399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_delay] / 60)/SUM([total_orders])' />
            </column>
            <column caption='Stacking' datatype='real' name='[Calculation_196821427344003105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders]) / SUM([total_orders])' />
            </column>
            <column caption='PU Distance' datatype='real' name='[Calculation_2941554287602794498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PU_distance (Custom SQL Query)]) / SUM([gross_orders])' />
            </column>
            <column caption='AVG DT' datatype='real' name='[Calculation_3907435663036170244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='% Late Orders &gt; 10' datatype='real' name='[Calculation_3907435663073144838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_56295035934642177]) / SUM([total_orders])' />
            </column>
            <column caption='Compliance Time' datatype='real' name='[Calculation_3907435663125790728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compliance_time (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='To Vendor' datatype='real' name='[Calculation_3907435663126122505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column caption='Est. Vendor Walk-In' datatype='real' name='[Calculation_3907435663126949899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([est_vendor_walk_in (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column caption='At Vendor' datatype='real' name='[Calculation_3907435663127261196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time (Custom SQL Query)]) / SUM([total_orders])' />
            </column>
            <column caption='Late Orders' datatype='integer' name='[Calculation_56295035934642177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_late] then [total_orders] END' />
            </column>
            <column caption='Net Fail Rate' datatype='real' name='[Calculation_56295036240912387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / sum([gross_orders])' />
            </column>
            <column caption='RAT' datatype='real' name='[Calculation_81346309197750277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([compliance_time (Custom SQL Query)]) + SUM([notify_time (Custom SQL Query)]))&#10;/ SUM([total_orders])' />
            </column>
            <column caption='At Customer' datatype='real' name='[Customer Walk In (copy)_3907435663157350416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_time (Custom SQL Query)])/SUM([total_orders])' />
            </column>
            <column datatype='real' name='[DO_distance (Custom SQL Query)]' role='measure' type='quantitative' />
            <column datatype='real' name='[DT (Custom SQL Query)]' role='measure' type='quantitative' />
