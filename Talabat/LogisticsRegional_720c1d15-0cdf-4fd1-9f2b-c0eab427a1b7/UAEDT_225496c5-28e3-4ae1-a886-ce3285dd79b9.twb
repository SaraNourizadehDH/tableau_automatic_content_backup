        <calculation class='tableau' formula='SUM([to_customer_time]) / SUM([tota_orders])' />
      </column>
      <column caption='AVG Est Prep Time' datatype='real' name='[AVG Vendor Walk In (copy)_1836765007103987727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([est_prep_time]) / SUM([tota_orders])' />
      </column>
      <column caption='AVG Est Drive Time' datatype='real' name='[AVG Vendor Walk In (copy)_1836765007104196624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([drive_time]) / SUM([tota_orders])' />
      </column>
      <column caption='AVG DO Distance' datatype='real' name='[AVG Vendor Walk In (copy)_1836765007104491537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DO_distance]) / SUM([tota_orders])' />
      </column>
      <column caption='AVG DT' datatype='real' name='[AVG Vendor Walk In (copy)_1836765007110701079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DT]) / SUM([tota_orders])' />
      </column>
      <column caption='AVG Order Delay' datatype='real' name='[AVG Vendor Walk In (copy)_3124161184032952320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_delay] / 60) / SUM([tota_orders])' />
      </column>
      <column caption='AVG AVTC' datatype='real' name='[Calculation_1836765007095255040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AVTC]) / SUM([tota_orders])' />
      </column>
      <column caption='% Late &gt; 10' datatype='real' name='[Calculation_1836765007098675201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_late] THEN [tota_orders] END) / SUM([tota_orders])' />
      </column>
      <column caption='AVG Rider Late To Customer' datatype='real' name='[Calculation_1836765007104679954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_to_customer]) / SUM([tota_orders])' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_1836765007166291994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(([Calculation_1836765007098675201] ) + (SUM([tota_orders]))/100000000)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Day Hour' datatype='integer' name='[Calculation_1836765007224643617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Hour])' />
      </column>
      <column caption='Vendor Rank' datatype='integer' name='[Calculation_196821426861735941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK((SUM([Late_orders])/30) + ([Calculation_196821426866819078] * 30))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Late By Vendor' datatype='real' name='[Calculation_196821426866819078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Late_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Rider Rank' datatype='integer' name='[Calculation_196821426883031047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([undispatchs]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rider Delay' datatype='real' name='[Calculation_196821426912780297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([rider_shortage]) + SUM([rider_compliance]) &#10;) /&#10;SUM([tota_orders])' />
      </column>
      <column caption='Vendor Delay' datatype='real' name='[Calculation_196821426912882698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([vendor_compliance (copy)_196821426860417027]) +&#10;SUM([WFA_late]) +&#10;SUM([wasting_time]) &#10;)&#10;/ SUM([tota_orders])' />
      </column>
      <column caption='To Customer Late' datatype='real' name='[Calculation_196821426913112075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([stacking_impact_to_customer]) +&#10;SUM([wrong_est]) +&#10;SUM([dropoff_compliance]) &#10;) /&#10;SUM([tota_orders])' />
      </column>
      <column caption='Other Issues' datatype='real' name='[Calculation_196821426913558540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([tota_orders]) -&#10;(SUM([rider_shortage]) + &#10;SUM([rider_compliance]) + &#10;SUM([vendor_compliance (copy)_196821426860417027]) + &#10;SUM([WFA_late]) + &#10;SUM([wasting_time]) + &#10;SUM([stacking_impact_to_customer]) + &#10;SUM ([dropoff_compliance]) +&#10;SUM([wrong_est]))&#10;) / SUM([tota_orders])' />
      </column>
      <column caption='Rider Shortage' datatype='real' name='[Calculation_196821426916020237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_shortage])/ SUM([tota_orders])' />
      </column>
      <column caption='Compliance Time' datatype='real' name='[Calculation_196821426916216846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compliance_time]) / SUM([tota_orders])' />
      </column>
      <column caption='Vendor Prep Compliance' datatype='real' name='[Calculation_196821426916429839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_compliance (copy)_196821426860417027])/ SUM([tota_orders])' />
      </column>
      <column caption='Delay at First Order Drop-Off' datatype='real' name='[Calculation_196821426916696080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacking_impact_to_customer])/ SUM([tota_orders])' />
      </column>
      <column caption='To Customer Compliance' datatype='real' name='[Calculation_196821426916880401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dropoff_compliance])/ SUM([tota_orders])' />
      </column>
      <column caption='Rider Compliance' datatype='real' name='[Calculation_196821426948706322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_compliance])/ SUM([tota_orders])' />
      </column>
      <column caption='Waiting for Second Order' datatype='real' name='[Calculation_196821426948997139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([wasting_time])/ SUM([tota_orders])' />
      </column>
      <column caption='Estimation Error' datatype='real' name='[Calculation_196821426949636117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([wrong_est])/ SUM([tota_orders])' />
      </column>
      <column caption='Stacking' datatype='real' name='[Calculation_196821427343421472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders]) / SUM([tota_orders])' />
      </column>
