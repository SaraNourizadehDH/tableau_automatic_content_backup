            <relation connection='bigquery.1vojsqx08ggy2c1gv8kxq0uz67zb' name='metrics' type='text'><![CDATA[-- StandardSQL
WITH
  -- 1️⃣  Parameter window
  parameters AS (
    SELECT
      DATE '2025-06-16' AS start_date_stack_kw,
      DATE '2025-06-29' AS end_date_stack_kw
  ),

  -- 2️⃣  A look-up table that tags each day as Control or Treatment
  date_type_map AS (
    SELECT DATE '2025-06-16' AS order_date, 'Control'   AS type UNION ALL
    SELECT DATE '2025-06-17',            'Treatment' UNION ALL
    SELECT DATE '2025-06-18',            'Control'   UNION ALL
    SELECT DATE '2025-06-19',            'Treatment' UNION ALL
    SELECT DATE '2025-06-20',            'Control'   UNION ALL
    SELECT DATE '2025-06-21',            'Treatment' UNION ALL
    SELECT DATE '2025-06-22',            'Control'   UNION ALL
    SELECT DATE '2025-06-23',            'Treatment' UNION ALL
    SELECT DATE '2025-06-24',            'Control'   UNION ALL
    SELECT DATE '2025-06-25',            'Treatment' UNION ALL
    SELECT DATE '2025-06-26',            'Control'   UNION ALL
    SELECT DATE '2025-06-27',            'Treatment' UNION ALL
    SELECT DATE '2025-06-28',            'Control'   UNION ALL
    SELECT DATE '2025-06-29',            'Treatment'
  ),

  -- 3️⃣  Order base enriched with a usable timestamp
  base_orders AS (
    SELECT
      *,
      COALESCE(primary_rider_dropped_off_at, hurrier_order_placed_at) AS order_ts
    FROM `tlb-data-prod.data_platform.fct_logistics_order`
    left join
  (SELECT distinct
    global_entity_id as entity_id,
    safe_cast(order_id as integer) as order_id,
    string_agg(distinct contact_reason_l3,'; ') contact_reasons,
    FROM `fulfillment-dwh-production.curated_data_shared.all_contacts`
    cross join parameters
    where created_date between start_date_stack_kw and end_date_stack_kw
    and stakeholder='Customer'
    and order_id is not null
    and lower(global_entity_id) = 'tb_kw'
    group by 1,2
  ) cust_contact using (entity_id, order_id)
    WHERE brand_name             = 'Talabat'
      AND is_talabat
      AND is_rider_order
      AND NOT is_logistics_preorder
      AND ABS(order_delay / 3600) << 24          -- filter obvious outliers
  )

SELECT DISTINCT
  o.country_code,                                             -- 1
  entity_id,                                                  -- 2
  city_name,                                                  -- 3
  v.vertical_type,                                            -- 4
  zone_name,                                                  -- 5
  DATE(order_ts, o.timezone)                      AS order_date,   -- 6
  EXTRACT(HOUR FROM DATETIME(order_ts, o.timezone)) AS order_hour, -- 7
  CASE WHEN stacked_deliveries >>= 1 THEN TRUE ELSE FALSE END AS is_stacked,           -- 8
  dt.type                                                    AS type,                 -- 9  ⬅️ new column

  -- ───────────────────────── aggregations ─────────────────────────
  COUNT(DISTINCT o.order_id)                                 AS total_orders,
  COUNT(DISTINCT CASE WHEN o.order_status = 'completed' THEN o.order_id END) AS no_of_completed_orders,
  COUNT(DISTINCT CASE WHEN o.order_status = 'cancelled' THEN o.order_id END) AS failed_orders,

  SUM(o.actual_delivery_time / 60)                           AS DT_numer,
  COUNT(o.actual_delivery_time)                              AS DT_denom,
  SUM(promised_delivery_time / 60)                           AS PDT_numer,
  COUNT(promised_delivery_time)                              AS PDT_denom,

  COUNT(DISTINCT CASE WHEN order_delay IS NOT NULL THEN o.order_code END)   AS orders_for_delay,
  COUNT(DISTINCT CASE WHEN order_delay / 60 << -10 THEN o.order_code END)    AS early_10,
  COUNT(DISTINCT CASE WHEN ABS(order_delay / 60) <<= 10 THEN o.order_code END) AS on_time,
  COUNT(DISTINCT CASE WHEN order_delay / 60 >> 10 THEN o.order_code END)     AS late_10min,
  COUNT(DISTINCT CASE WHEN order_delay / 60 >> 30 THEN o.order_code END)     AS late_30min,
  COUNT(DISTINCT CASE WHEN o.actual_delivery_time / 60 >> 45 THEN o.order_code END) AS dt_45,
  COUNT(DISTINCT CASE WHEN o.actual_delivery_time / 60 >> 20 THEN o.order_code END) AS dt_20,
  COUNT(DISTINCT CASE WHEN o.actual_delivery_time / 60 >> 30 THEN o.order_code END) AS dt_30,  
  COUNT(DISTINCT CASE WHEN o.rider_late / 60 >> 10 THEN o.order_code END)    AS rider_late,

  COUNT(DISTINCT CASE WHEN vendor_delay_v2 / 60 >> 10 THEN o.order_code END) AS vendor_delay_v2_numer,
  COUNT(DISTINCT CASE WHEN vendor_delay_v2 IS NOT NULL THEN o.order_code END) AS vendor_delay_v2_denom,

  SUM(vendor_preparation_time)                               AS vendor_preparation_time_numer,
  COUNT(vendor_preparation_time)                             AS vendor_preparation_time_denom,

  SUM(o.at_vendor_time)                                      AS at_vendor_time_numer,
  COUNT(o.at_vendor_time)                                    AS at_vendor_time_denom,
  SUM(o.at_vendor_time_cleaned)                              AS at_vendor_time_cleaned_numer,
  COUNT(o.at_vendor_time_cleaned)                            AS at_vendor_time_cleaned_denom,

  SUM(primary_pickup_distance_manhattan / 1000)              AS sum_pickup_distance_km,
  COUNT(primary_pickup_distance_manhattan)                   AS count_pickup_distance_km,
  SUM(primary_dropoff_distance_manhattan / 1000)             AS sum_dropoff_distance_km,
  COUNT(primary_dropoff_distance_manhattan)                  AS count_dropoff_distance_km,
  SUM((primary_pickup_distance_manhattan + primary_dropoff_distance_manhattan) / 1000) AS sum_PU_DO_distance_km,
  COUNT((primary_pickup_distance_manhattan + primary_dropoff_distance_manhattan))       AS count_PU_DO_distance_km,

  COUNT(DISTINCT vo.order_code)                              AS transport_orders,
  COUNT(DISTINCT CASE WHEN LOWER(vo.cancellation.owner) = 'transport' THEN vo.order_code END) AS transport_canc,

  SUM(CASE WHEN o.order_status = 'completed'
           THEN (TIMESTAMP_DIFF(d.rider_accepted_at, o.created_at, MINUTE) -
                 (d.rider_accepting_time / 60))
           ELSE 0 END)                                       AS Queue_time,
  SUM(d.rider_accepting_time / 60)                           AS RAT,

  SUM(o.to_vendor_time / 60)                                 AS to_vendor_time,
  SUM(o.to_customer_time / 60)                               AS to_customer_time,

count(distinct case when REGEXP_CONTAINS(contact_reasons,'Complain about late order|Complaint about extreme delay|Complaint about moderate delay|Complaint about severe delay|Complaint about short delay|ETA is stuck or increasing|Extreme delay|Moderate delay|Severe delay|Short delay') then o.order_id end) as no_of_customer_contacted_orders_for_delay,

FROM base_orders o
CROSS JOIN parameters
LEFT  JOIN `tlb-data-prod.data_platform.fct_logistics_delivery`          d  USING(country_code, entity_id, city_id, vendor_code, order_code, order_id)
LEFT  JOIN `tlb-data-prod.data_platform.dim_logistics_city`                   USING(country_code, city_id)
LEFT  JOIN `tlb-data-prod.data_platform.dim_logistics_vendor`           v  USING(country_code, entity_id, vendor_code)
LEFT  JOIN `fulfillment-dwh-production.curated_data_shared_vendor.growth_vendor_orders` vo
       ON  vo.country_code = o.country_code AND vo.order_code = o.order_code
LEFT  JOIN `tlb-data-prod.data_platform.dim_logistics_zone`             z
       ON  d.country_code = z.country_code AND d.zone_id = z.zone_id
LEFT  JOIN date_type_map dt
       ON  DATE(order_ts, o.timezone) = dt.order_date

WHERE
  DATE(order_ts, o.timezone) BETWEEN start_date_stack_kw AND end_date_stack_kw
  AND LOWER(o.country_code) = 'kw'

GROUP BY
  1,2,3,4,5,6,7,8,9]]></relation>
            <relation connection='bigquery.1vojsqx08ggy2c1gv8kxq0uz67zb' name='staffing' type='text'>with parameters as (&#13;
select&#13;
&#13;
date(&apos;2025-06-16&apos;) as start_date_stack_kw,&#13;
date(&apos;2025-06-29&apos;) as end_date_stack_kw, &#13;
&#13;
# add dates for new tests&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
country_code,&#13;
city_name,&#13;
zone_name,&#13;
date(created_at,timezone) created_date ,&#13;
EXTRACT(HOUR FROM DATETIME(created_at, timezone)) AS order_hour,&#13;
&#13;
sum(idle_time)/3600 as idle_time,&#13;
&#13;
sum(reaction_time+to_vendor_time+at_vendor_time+to_customer_time+at_customer_time+idle_time)/3600 as working_time,&#13;
&#13;
count(distinct order_id) total_orders_utr&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared.utr_timings`&#13;
cross join parameters&#13;
&#13;
where &#13;
&#13;
  &#13;
  (created_date between start_date_stack_kw and end_date_stack_kw&#13;
  and lower(country_code) in (&apos;kw&apos;) )&#13;
  &#13;
  &#13;
group by 1,2,3,4,5</relation>
          </relation>
          <relation connection='bigquery.1vojsqx08ggy2c1gv8kxq0uz67zb' name='cpo' type='text'>with date_param as(&#13;
  select  date(&apos;2025-06-16&apos;) as start_date,&#13;
  date(&apos;2025-06-29&apos;) as end_date&#13;
),&#13;
&#13;
vendor_details AS &#13;
(&#13;
  select distinct country_code, vendor_code, vendor_name, entity_id, vertical_type &#13;
  from `tlb-data-prod.data_platform.dim_logistics_vendor`  &#13;
),&#13;
&#13;
payments as(&#13;
select distinct&#13;
payment_data.country_code,&#13;
city_name,&#13;
&#13;
case when lower(vendor_name) like &quot;talabat%mart&quot; or lower(vendor_name) like &quot;t%mart&quot; then &quot;TMART&quot; else vertical_type end as vertical_type,&#13;
date(payment_created_at) payment_created_at,&#13;
count(distinct case when delivery_status = &apos;completed&apos; and is_primary then order_code end) primary_orders_completed,&#13;
count(distinct case when order_status= &apos;completed&apos; then order_code end) total_completed_orders,&#13;
count(distinct case when rider_dropped_off_at is not null and delivery_status=&apos;completed&apos; then delivery_id end) total_completed_deliveries,&#13;
count(distinct case when boa_is_successful then order_code end) BOA_completed_orders,&#13;
count(distinct case when rider_picked_up_at is not null then delivery_id end) pickups,&#13;
count(distinct case when rider_dropped_off_at is not null then delivery_id end) dropoffs,&#13;
count(distinct case when delivery_status = &apos;completed&apos; and is_primary and is_stacked_intravendor is true then order_code end) stacked_orders,&#13;
&#13;
--contractor earnings&#13;
coalesce(sum( case when payment_category like &apos;%hidden%&apos; then total end ),0) contractor_earnings_total,&#13;
coalesce(sum( case when payment_category = &apos;hidden_basic&apos; and rule_type = &apos;PER_DELIVERY&apos; and rule_sub_type = &apos;PICKEDUP_DELIVERIES&apos; then total end ),0) contractor_earnings_total_pickup_pay,&#13;
coalesce(sum( case when payment_category = &apos;hidden_basic&apos; and rule_type = &apos;PER_DELIVERY&apos; and rule_sub_type = &apos;COMPLETED_DELIVERIES&apos; then total end ),0) contractor_earnings_total_dropoff_pay,&#13;
&#13;
&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` payment_data&#13;
cross join date_param&#13;
LEFT JOIN vendor_details &#13;
on payment_data.vendor_code = vendor_details.vendor_code &#13;
and vendor_details.country_code = payment_data.country_code &#13;
and vendor_details.entity_id = payment_data.entity_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` c on payment_data.country_code = c.country_code and payment_data.city_id = c.city_id&#13;
&#13;
WHERE &#13;
  date(order_created_at) between start_date and end_date&#13;
  and payment_data.country_code in (&apos;kw&apos;)&#13;
  group by 1,2,3,4&#13;
  order by 1,2,3&#13;
)&#13;
&#13;
select &#13;
* &#13;
from payments</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
