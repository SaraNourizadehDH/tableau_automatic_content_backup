      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.0hqqgs81hz4n2d1394fib1316zvh' />
          </datasources>
          <datasource-dependencies datasource='federated.0hqqgs81hz4n2d1394fib1316zvh'>
            <column caption='% DT &gt; 20 mins' datatype='real' default-format='p0.0%' name='[% DT &gt; 45 mins (copy) (copy)_587156828144238593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_20])/SUM([orders_for_delay])' />
            </column>
            <column caption='% DT &gt; 30 mins' datatype='real' default-format='p0.0%' name='[% DT &gt; 45 mins (copy)_587156828144226304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_30])/SUM([orders_for_delay])' />
            </column>
            <column caption='% DT &gt; 45 mins' datatype='real' default-format='p0.0%' name='[% on time (copy)_1174313627787751426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_45])/SUM([orders_for_delay])' />
            </column>
            <column datatype='integer' name='[BOA_completed_orders]' role='measure' type='quantitative' />
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1174313627525341184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contractor_earnings_total])/SUM([BOA_completed_orders])' />
            </column>
            <column caption='% early &gt; 10 mins' datatype='real' name='[Calculation_1214283074171387904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_10])/SUM([orders_for_delay])' />
            </column>
            <column caption='% late &gt; 10 mins' datatype='real' name='[Calculation_1214283074171486209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_10min])/SUM([orders_for_delay])' />
            </column>
            <column caption='% late &gt; 30 mins' datatype='real' name='[Calculation_1214283074171547650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_30min])/SUM([orders_for_delay])' />
            </column>
            <column caption='% on time' datatype='real' name='[Calculation_1214283074171891715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time])/SUM([orders_for_delay])' />
            </column>
            <column caption='avg. DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074172129284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT_numer])/SUM([DT_denom])' />
            </column>
            <column caption='% stacks' datatype='real' name='[Calculation_1214283074172182533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_stacked] = TRUE THEN [no_of_completed_orders] END) / SUM([no_of_completed_orders] )' />
            </column>
            <column caption='% TFR' datatype='real' default-format='p0.00%' name='[Calculation_1214283074172694534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transport_canc])/SUM([transport_orders])' />
            </column>
            <column caption='AVT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074172854279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time_numer])/SUM([at_vendor_time_denom]))/60' />
            </column>
            <column caption='AVTC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074172882952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time_cleaned_numer])/SUM([at_vendor_time_cleaned_denom]))/60' />
            </column>
            <column caption='DO distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1214283074173128713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_dropoff_distance_km])/SUM([count_dropoff_distance_km])' />
            </column>
            <column caption='PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074173272074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PDT_numer])/SUM([PDT_denom])' />
            </column>
            <column caption='Prep time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074173513739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_preparation_time_numer])/SUM([vendor_preparation_time_denom])/60' />
            </column>
            <column caption='PU distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1214283074173669388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_pickup_distance_km])/SUM([count_pickup_distance_km])' />
            </column>
            <column caption='Queue Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074173767693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Queue_time])/SUM([no_of_completed_orders])' />
            </column>
            <column caption='Rider Accepatance Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074173841422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([RAT])/SUM([no_of_completed_orders])' />
            </column>
            <column caption='TCT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074174009359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time])/SUM([total_orders])' />
            </column>
            <column caption='TVT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1214283074174083088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time])/SUM([total_orders])' />
            </column>
            <column caption='Vendor delay &gt; 10 mins' datatype='real' default-format='p0.0%' name='[Calculation_1214283074174226449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_v2_numer])/SUM([vendor_delay_v2_denom])' />
            </column>
            <column caption='rider late &gt; 10 mins' datatype='real' default-format='p0.0%' name='[Calculation_1214283074174685202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late])/sum([orders_for_delay])' />
            </column>
            <column caption='% CCR (delay)' datatype='real' default-format='p0.00%' name='[Calculation_1214283074185445395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_of_customer_contacted_orders_for_delay])/SUM([no_of_completed_orders])' />
            </column>
            <column caption='% idle time' datatype='real' default-format='p0.0%' name='[Calculation_1214283074188644372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([idle_time])/SUM([working_time])' />
