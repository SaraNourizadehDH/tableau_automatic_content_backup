    <worksheet name='Overview Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_rider_applicant (data_platform_logistics)' name='federated.15pmxcb0nwd6ya1g51aw00ma69bl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Compare By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15pmxcb0nwd6ya1g51aw00ma69bl'>
            <column caption='RR Downloaded Riders' datatype='integer' name='[Activated Riders (copy)_1026468917157978112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Countd(if not isnull([first_app_session]) then [rider_id] end)' />
            </column>
            <column caption='Welcome 1 Riders' datatype='integer' name='[Activated Riders (copy)_1026468917159931909]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='Countd(if not isnull([welcome_stage_1_started_at]) and [created_date]&gt;DATE(&quot;2022-12-01&quot;) then [applicant_id] end)' />
            </column>
            <column caption='Exclude Nulls' datatype='boolean' name='[Calculation_1319695441989709824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([company_name]) and [country_code] in (&apos;ae&apos;,&apos;kw&apos;,&apos;bh&apos;,&apos;iq&apos;,&apos;qa&apos;) &#10;then TRUE else FALSE &#10;end' />
            </column>
            <column caption='Delta Applicants-Hired' datatype='integer' name='[Calculation_193795525211291648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952132191281153]-[Calculation_3194952132189720576]' />
            </column>
            <column caption='Hired Riders' datatype='integer' name='[Calculation_3194952132189720576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if [current_stage_name] = &quot;Hired&quot; then 1 else 0 END)' />
            </column>
            <column caption='Applicants' datatype='integer' name='[Calculation_3194952132191281153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([applicant_id])' />
            </column>
            <column caption='Comparision' datatype='string' name='[Calculation_3194952133153968159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Country&apos; then [country_code]&#10;elseif [Parameters].[Parameter 3] = &apos;Week&apos; then str(date(DATETRUNC(&apos;week&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Month&apos; then str(date(DATETRUNC(&apos;month&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Vehicle&apos; then [Calculation_5292644399653277715]&#10;elseif [Parameters].[Parameter 3] = &apos;Workflow&apos; then [workflow_name]&#10;elseif [Parameters].[Parameter 3] = &apos;Channel&apos; then [utm_source]&#10;end' />
            </column>
            <column caption='Activated Riders' datatype='integer' name='[Calculation_5292644398235480064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Countd(if not isnull([First_shift_date]) then [rider_id] end)' />
            </column>
            <column caption='Lead to Hire %' datatype='real' default-format='p0.00%' name='[Calculation_5292644398236491777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952132189720576]/[Calculation_3194952132191281153]' />
            </column>
            <column caption='Lead-to-Street CVR %' datatype='real' default-format='p0.00%' name='[Calculation_5292644398237163522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5292644398235480064]/[Calculation_3194952132191281153]' />
            </column>
            <column caption='Lead to Hire Time (Days)' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5292644398240677891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_at],[hired_stage_completed_at])&#10;// /86400' />
            </column>
            <column caption='Vehicle' datatype='string' name='[Calculation_5292644399653277715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  CONTAINS(lower([vehicle_type]), &quot;bike&quot;) then &quot;Motorbike&quot;&#10;elseif Contains(LOWER([vehicle_type]), &quot;motorbike&quot;) then &quot;Motorbike&quot;&#10;elseif contains(LOWER([vehicle_type]), &quot;car&quot;) then &quot;Car&quot; &#10;elseif contains(lower([vehicle_type]), &quot;walk&quot;) then &quot;Walker&quot; &#10;elseif contains(lower([vehicle_type]), &quot;cycle&quot;) then &quot;Bicycle&quot;&#10;elseif contains(lower([vehicle_type]), &quot;scooter&quot;) then &quot;Scooter&quot;&#10;ELSEIF ISNULL([vehicle_type]) then [vehicle_type]&#10;else &quot;Other&quot; end' />
            </column>
            <column caption='Delta Hired-Activated' datatype='integer' name='[Delta Applicants-Hired (copy)_193795525218344963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952132189720576]-[Calculation_5292644398235480064]' />
            </column>
            <column caption='Delta Hired-RR Downloaded' datatype='integer' name='[Delta Hired-Activated (copy)_1026468917158682625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952132189720576]-[Activated Riders (copy)_1026468917157978112]' />
            </column>
            <column caption='Delta RR Downloaded-Activated' datatype='integer' name='[Delta Hired-RR Downloaded (copy)_1026468917158998018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Activated Riders (copy)_1026468917157978112]-[Calculation_5292644398235480064]' />
            </column>
            <column datatype='date' name='[First_shift_date]' role='dimension' type='ordinal' />
            <column caption='Rejected Applicants' datatype='integer' name='[Hired Riders (copy)_193795525211914241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if [current_stage_name] = &quot;Failed&quot; then 1 else 0 END)' />
            </column>
            <column caption='Hired to RR Downloaded Time (Days)' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Hired to Street Time (Days)  (copy)_1026468917159276547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[hired_stage_completed_at],[first_app_session])&#10;// /86400' />
            </column>
            <column caption='Lead-to-Street CVR2 %' datatype='real' default-format='p0.00%' name='[Lead to Hire % (copy)_1026468917159632900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952132189720576]/[Activated Riders (copy)_1026468917159931909]' />
            </column>
            <column caption='Lead to Street Time (Days)' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Lead to Hire Time (Days) (copy)_5292644398241226756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_at],[First_shift_date])&#10;// /86400' />
            </column>
            <column caption='Adjusted Lead to Street % ' datatype='real' default-format='p0.00%' name='[Lead to Street % (copy)_1018728324208578560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_1319695441989709824] = False&#10;and not isnull([First_shift_date]) then rider_id end)/&#10;countd(if [Calculation_1319695441989709824] = False then [applicant_id] end)&#10;&#10;&#10;// if [Exclude Nulls] = False then &#10;//[Activated Riders]/[Applicants]' />
            </column>
            <column caption='Hired to Street %' datatype='real' default-format='p0.00%' name='[Lead to Street % (copy)_1024850453750767616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5292644398235480064]/[Calculation_3194952132189720576]' />
            </column>
            <column caption='Hired to Street Time (Days) ' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Lead to Street Time (Days) (copy)_1024850453752270849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[hired_stage_completed_at],[First_shift_date])&#10;// /86400' />
            </column>
            <column caption='Pending Applicants' datatype='integer' name='[Rejected Applicants (copy)_193795525212631042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_193795525211291648]-[Hired Riders (copy)_193795525211914241]' />
            </column>
            <column caption='Spam check (copy)' datatype='boolean' name='[Spam check (copy)_6192449531411910656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [country_code]= &apos;ae&apos; and CONTAINS([applicant_phone_number],&apos;+971&apos;)&#10;or [country_code]= &apos;bh&apos; and CONTAINS([applicant_phone_number],&apos;+973&apos;)&#10;or [country_code]= &apos;eg&apos; and CONTAINS([applicant_phone_number],&apos;+201&apos;)&#10;or [country_code]= &apos;iq&apos; and CONTAINS([applicant_phone_number],&apos;+964&apos;)&#10;or [country_code]= &apos;jo&apos; and CONTAINS([applicant_phone_number],&apos;+962&apos;)&#10;or [country_code]= &apos;kw&apos; and CONTAINS([applicant_phone_number],&apos;+965&apos;)&#10;or [country_code]= &apos;om&apos; and CONTAINS([applicant_phone_number],&apos;+968&apos;)&#10;or [country_code]= &apos;qa&apos; and CONTAINS([applicant_phone_number],&apos;+974&apos;)&#10;then true else false end' />
            </column>
            <column caption='Welcome 2 Riders' datatype='integer' name='[Welcome 1 Riders (copy)_1026468917160165382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Countd(if not isnull([welcome_stage_2_started_at]) &#10;and [created_date]&gt;DATE(&quot;2022-12-01&quot;)&#10;then [applicant_id] end)' />
            </column>
