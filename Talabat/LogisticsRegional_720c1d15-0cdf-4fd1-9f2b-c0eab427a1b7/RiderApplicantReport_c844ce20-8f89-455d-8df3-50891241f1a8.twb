                    <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ&#10;</run>
                    <run bold='true' fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Lead to Hire CVR2 %:</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'> Total Hired/ Total Applicants that entered Welcome Stage 1(Tier 0)</run>
                    <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ&#10;</run>
