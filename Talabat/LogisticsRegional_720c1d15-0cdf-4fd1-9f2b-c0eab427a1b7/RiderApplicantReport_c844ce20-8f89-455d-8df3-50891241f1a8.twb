    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='http://ip-172-31-0-83:8691/t/Talabat/workbooks/WIPRiderApplicants/Definitions?rev=' id='Definitions' path='/t/Talabat/workbooks/WIPRiderApplicants' revision='' site='Talabat' />
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='60889' id='3' type-v2='text' w='98666' x='667' y='10778'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Definitions:</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Applicants: </run>
              <run fontcolor='#000000' fontsize='12'>Riders that have submitted details on Arara landing page.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Hired Riders: </run>
              <run fontcolor='#000000' fontsize='12'>Riders that have completed the &quot;Hired&quot; stage.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Activated Riders:</run>
              <run fontcolor='#000000' fontsize='12'> Riders that have completed an evaluated shift.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Rejected Applicants: </run>
              <run fontcolor='#000000' fontsize='12'>Applicants who have been been rejected. Current Stage Name = &quot;Failed&quot;.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Pending Applicants: </run>
              <run fontcolor='#000000' fontsize='12'>Applicants who are still part of the onboarding funnel </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>RR Downloaded Applicants:</run>
              <run fontcolor='#000000' fontsize='12'> Riders that have downloaded the Road Runner App</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Lead to Hire CVR %:</run>
              <run fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Total Hired /Total Applicants (Includes all applicants, auto rejections)</run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Lead to Hire CVR2 %:</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'> Total Hired/ Total Applicants that entered Welcome Stage 1(Tier 0)</run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Lead to Hire CVR3 %:</run>
              <run bold='true' fontcolor='#0000ff' fontname='Tableau Book' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'> Total Hired/ Total Applicants that entered Welcome Stage 2(Tier 1) </run>
              <run fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Lead to Street %: </run>
              <run fontcolor='#000000' fontsize='12'>The percentage of applicants who have completed an evaluated shift</run>
              <run fontcolor='#000000' fontsize='12'>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Lead to Hire Time:  </run>
              <run fontcolor='#000000' fontsize='12'>Time taken for applicants to reach the &quot;Hired&quot; stage in Arara, from when they first started in Arara.</run>
              <run fontcolor='#000000' fontsize='12'>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Lead to Street Time: </run>
              <run fontcolor='#000000' fontsize='12'>Time taken for applicants to complete their first shift(evaluated), rom when they first started in Arara.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Conversion: </run>
              <run fontcolor='#000000' fontsize='12'> Total Applicants who landed on the stage/Total Applicants who completed the stage.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Time Per Stage:</run>
              <run fontcolor='#000000' fontsize='12'> The time taken from when an applicant landed on the stage to when the stage was completed.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>RAF Conversion:</run>
              <run fontcolor='#000000' fontsize='12'> Total RAF Hired  /Total RAF Applicants.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>RAF % of Total Hires:</run>
              <run fontcolor='#000000' fontsize='12'> Total RAF Hired/ Total Hired Riders</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Current Stage:</run>
              <run fontcolor='#000000' fontsize='12'> The current Arara stage that the applicant is in currently.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#0000ff' fontsize='12'>Failure Stage:</run>
              <run fontcolor='#000000' fontsize='12'> If the current stage is &quot;Failed&quot;, the last stage that the applicant reached before being failed.</run>
