            <column caption='Lead to Hire Time (Days)' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5292644398240677891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_at],[hired_stage_completed_at])&#10;// /86400' />
            </column>
            <column caption='Delta Hired-Activated' datatype='integer' name='[Delta Applicants-Hired (copy)_193795525218344963]' role='measure' type='quantitative'>
