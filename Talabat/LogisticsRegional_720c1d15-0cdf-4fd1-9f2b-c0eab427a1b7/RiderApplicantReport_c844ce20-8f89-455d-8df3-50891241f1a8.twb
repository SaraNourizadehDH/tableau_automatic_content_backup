    <datasource caption='fct_logistics_rider_applicant (data_platform_logistics)' inline='true' name='federated.15pmxcb0nwd6ya1g51aw00ma69bl' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ld75e1130y3q216h3vwg0uf68rn'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='ezeftawy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ld75e1130y3q216h3vwg0uf68rn' name='Custom SQL Query' type='text'>With shifts as(
Select 
Rider_ID,
Min(created_date) First_shift_date
from `tlb-data-prod.data_platform.fct_logistics_rider_shift`
where shift_state = &apos;EVALUATED&apos;
group by 1
)

Select a.* except (company_name),
case when a.country_code = &apos;jo&apos; and a.company_name is null then &quot;freelancer&quot;
    when a.country_code = &apos;jo&apos; and a.company_name =&quot;-&quot; then &quot;freelancer&quot;
    else a.company_name end as company_name,
s.First_shift_date,
c.city_name,
r.first_app_session
from `tlb-data-prod.data_platform_logistics.fct_logistics_rider_applicant` a
left outer join shifts s on s.rider_id = a.rider_id
left join `tlb-data-prod.data_platform.dim_logistics_city` c on c.city_id = a.city_id and c.country_code = a.country_code and c.is_Active
left join `tlb-data-prod.data_platform.dim_logistics_rider` r on r.rider_id = a.rider_id and r.country_code=a.country_code</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ld75e1130y3q216h3vwg0uf68rn' name='Custom SQL Query' type='text'>With shifts as(
Select 
Rider_ID,
Min(created_date) First_shift_date
from `tlb-data-prod.data_platform.fct_logistics_rider_shift`
where shift_state = &apos;EVALUATED&apos;
group by 1
)

Select a.* except (company_name),
case when a.country_code = &apos;jo&apos; and a.company_name is null then &quot;freelancer&quot;
    when a.country_code = &apos;jo&apos; and a.company_name =&quot;-&quot; then &quot;freelancer&quot;
    else a.company_name end as company_name,
s.First_shift_date,
c.city_name,
r.first_app_session
from `tlb-data-prod.data_platform_logistics.fct_logistics_rider_applicant` a
left outer join shifts s on s.rider_id = a.rider_id
left join `tlb-data-prod.data_platform.dim_logistics_city` c on c.city_id = a.city_id and c.country_code = a.country_code and c.is_Active
left join `tlb-data-prod.data_platform.dim_logistics_rider` r on r.rider_id = a.rider_id and r.country_code=a.country_code</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
