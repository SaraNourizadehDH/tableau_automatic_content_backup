    <worksheet name='Hours Data Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_rider_applicant (data_platform_logistics)' name='federated.15pmxcb0nwd6ya1g51aw00ma69bl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hours&quot;'>
              <calculation class='tableau' formula='&quot;Hours&quot;' />
            </column>
            <column caption='Compare By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15pmxcb0nwd6ya1g51aw00ma69bl'>
            <column caption='Welcome Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132199424005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Welcome Stage Completed At]-[Welcome Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[welcome_stage_started_at],[welcome_stage_completed_at])/3600' />
            </column>
            <column caption='Doc Collection Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132201672710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Doc Collection Stage Completed At]-[Doc Collection Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_collection_stage_started_at],[doc_collection_stage_completed_at])/3600' />
            </column>
            <column caption='Doc Review Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132205391879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Doc Review Stage Completed At]-[Doc Review Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_review_stage_started_at],[doc_review_stage_completed_at])/3600' />
            </column>
            <column caption='Quiz Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132442009608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[quiz_stage_started_at],[quiz_stage_completed_at])/3600' />
            </column>
            <column caption='Phone Call Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132442652681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[phone_call_stage_started_at],[phone_call_stage_completed_at])/3600' />
            </column>
            <column caption='Scheduled Onboarding Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132443934731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[scheduled_onboarding_stage_started_at],[scheduled_onboarding_stage_completed_at])/3600' />
            </column>
            <column caption='Doc Collection Stage Time' datatype='real' name='[Calculation_3194952132458041364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132201672710] else [Doc Collection Stage Time(Hrs) (copy)_3194952132455460878] end' />
            </column>
            <column caption='Doc Review Stage Time' datatype='real' name='[Calculation_3194952132458450965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132205391879] else [Doc Review Stage Time(Min) (copy)_3194952132449366028] end' />
            </column>
            <column caption='Phone Call Stage Time' datatype='real' name='[Calculation_3194952132458639382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132442652681] else [Phone Call Stage Time(Hrs) (copy)_3194952132455571471] end' />
            </column>
            <column caption='Quiz Stage Time' datatype='real' name='[Calculation_3194952132458803223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132442009608] else [Quiz Stage Time(Hrs) (copy)_3194952132455727120] end' />
            </column>
            <column caption='Scheduled Onboarding Stage Time' datatype='real' name='[Calculation_3194952132459245592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132443934731] else [Scheduled Onbarding Stage Time(Hrs) (copy)_3194952132455960593] end' />
            </column>
            <column caption='Service Agreement Stage Time' datatype='real' name='[Calculation_3194952132459687961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132443934731] else [Scheduled Onbarding Stage Time(Hrs) (copy)_3194952132455960593] end' />
            </column>
            <column caption='Welcome Stage Time' datatype='real' name='[Calculation_3194952132459905050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Hours&quot; then [Calculation_3194952132199424005] else [Welcome Stage Time(Hrs) (copy)_3194952132457086995] end' />
            </column>
            <column caption='Comparision' datatype='string' name='[Calculation_3194952133153968159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Country&apos; then [country_code]&#10;elseif [Parameters].[Parameter 3] = &apos;Week&apos; then str(date(DATETRUNC(&apos;week&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Month&apos; then str(date(DATETRUNC(&apos;month&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Vehicle&apos; then [Calculation_5292644399653277715]&#10;elseif [Parameters].[Parameter 3] = &apos;Workflow&apos; then [workflow_name]&#10;elseif [Parameters].[Parameter 3] = &apos;Channel&apos; then [utm_source]&#10;end' />
            </column>
            <column caption='Vehicle' datatype='string' name='[Calculation_5292644399653277715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  CONTAINS(lower([vehicle_type]), &quot;bike&quot;) then &quot;Motorbike&quot;&#10;elseif Contains(LOWER([vehicle_type]), &quot;motorbike&quot;) then &quot;Motorbike&quot;&#10;elseif contains(LOWER([vehicle_type]), &quot;car&quot;) then &quot;Car&quot; &#10;elseif contains(lower([vehicle_type]), &quot;walk&quot;) then &quot;Walker&quot; &#10;elseif contains(lower([vehicle_type]), &quot;cycle&quot;) then &quot;Bicycle&quot;&#10;elseif contains(lower([vehicle_type]), &quot;scooter&quot;) then &quot;Scooter&quot;&#10;ELSEIF ISNULL([vehicle_type]) then [vehicle_type]&#10;else &quot;Other&quot; end' />
            </column>
            <column caption='Doc Collection Stage Time(Days)' datatype='real' name='[Doc Collection Stage Time(Hrs) (copy)_3194952132455460878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Doc Collection Stage Completed At]-[Doc Collection Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_collection_stage_started_at],[doc_collection_stage_completed_at])/86400' />
            </column>
            <column caption='Doc Review Stage Time(Days)' datatype='real' name='[Doc Review Stage Time(Min) (copy)_3194952132449366028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Doc Review Stage Completed At]-[Doc Review Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_review_stage_started_at],[doc_review_stage_completed_at])/86400' />
            </column>
            <column caption='Phone Call Stage Time(Days)' datatype='real' name='[Phone Call Stage Time(Hrs) (copy)_3194952132455571471]' role='measure' type='quantitative'>
