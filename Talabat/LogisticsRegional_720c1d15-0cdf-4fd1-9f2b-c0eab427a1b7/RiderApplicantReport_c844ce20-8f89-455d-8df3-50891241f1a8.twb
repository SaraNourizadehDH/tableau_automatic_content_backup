              <calculation class='tableau' formula='[Calculation_4424716306464604160]/[Calculation_3194952132191281153]' />
            </column>
            <column caption='Vehicle' datatype='string' name='[Calculation_5292644399653277715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  CONTAINS(lower([vehicle_type]), &quot;bike&quot;) then &quot;Motorbike&quot;&#10;elseif Contains(LOWER([vehicle_type]), &quot;motorbike&quot;) then &quot;Motorbike&quot;&#10;elseif contains(LOWER([vehicle_type]), &quot;car&quot;) then &quot;Car&quot; &#10;elseif contains(lower([vehicle_type]), &quot;walk&quot;) then &quot;Walker&quot; &#10;elseif contains(lower([vehicle_type]), &quot;cycle&quot;) then &quot;Bicycle&quot;&#10;elseif contains(lower([vehicle_type]), &quot;scooter&quot;) then &quot;Scooter&quot;&#10;ELSEIF ISNULL([vehicle_type]) then [vehicle_type]&#10;else &quot;Other&quot; end' />
            </column>
            <column caption='Spam check (copy)' datatype='boolean' name='[Spam check (copy)_6192449531411910656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [country_code]= &apos;ae&apos; and CONTAINS([applicant_phone_number],&apos;+971&apos;)&#10;or [country_code]= &apos;bh&apos; and CONTAINS([applicant_phone_number],&apos;+973&apos;)&#10;or [country_code]= &apos;eg&apos; and CONTAINS([applicant_phone_number],&apos;+201&apos;)&#10;or [country_code]= &apos;iq&apos; and CONTAINS([applicant_phone_number],&apos;+964&apos;)&#10;or [country_code]= &apos;jo&apos; and CONTAINS([applicant_phone_number],&apos;+962&apos;)&#10;or [country_code]= &apos;kw&apos; and CONTAINS([applicant_phone_number],&apos;+965&apos;)&#10;or [country_code]= &apos;om&apos; and CONTAINS([applicant_phone_number],&apos;+968&apos;)&#10;or [country_code]= &apos;qa&apos; and CONTAINS([applicant_phone_number],&apos;+974&apos;)&#10;then true else false end' />
            </column>
            <column caption='Applicant Id' datatype='string' name='[applicant_id]' role='dimension' type='nominal' />
            <column caption='Applicant Phone Number' datatype='string' name='[applicant_phone_number]' role='dimension' type='nominal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
