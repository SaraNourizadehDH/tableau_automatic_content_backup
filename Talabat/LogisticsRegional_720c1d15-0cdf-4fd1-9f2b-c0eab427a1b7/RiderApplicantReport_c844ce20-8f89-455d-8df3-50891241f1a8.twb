            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15pmxcb0nwd6ya1g51aw00ma69bl'>
            <column caption='Applicants Landed Welcome' datatype='integer' name='[Applicants Completed Welcome (copy)_5292644399637680133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([welcome_stage_started_at]) then 1 else 0 END)' />
            </column>
            <column caption='Applicants' datatype='integer' name='[Calculation_3194952132191281153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([applicant_id])' />
            </column>
            <column caption='Applicants Completed Welcome' datatype='integer' name='[Calculation_3194952132195188738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([welcome_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Applicants Completed Doc Collection' datatype='integer' name='[Calculation_3194952132196732931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_collection_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Applicants Completed Doc Review' datatype='integer' name='[Calculation_3194952132196864004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_review_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Comparision' datatype='string' name='[Calculation_3194952133153968159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Country&apos; then [country_code]&#10;elseif [Parameters].[Parameter 3] = &apos;Week&apos; then str(date(DATETRUNC(&apos;week&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Month&apos; then str(date(DATETRUNC(&apos;month&apos;,[created_date])))&#10;elseif [Parameters].[Parameter 3] = &apos;Vehicle&apos; then [Calculation_5292644399653277715]&#10;elseif [Parameters].[Parameter 3] = &apos;Workflow&apos; then [workflow_name]&#10;elseif [Parameters].[Parameter 3] = &apos;Channel&apos; then [utm_source]&#10;end' />
            </column>
            <column caption='Applicants Completed Phone Call' datatype='integer' name='[Calculation_3194952133160407072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([phone_call_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Applicants Completed Quiz' datatype='integer' name='[Calculation_3194952133160890401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([quiz_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Applicants Completed Scheduled Onboarding' datatype='integer' name='[Calculation_3194952133161099298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([scheduled_onboarding_stage_completed_at]) then 1 else 0 END)' />
