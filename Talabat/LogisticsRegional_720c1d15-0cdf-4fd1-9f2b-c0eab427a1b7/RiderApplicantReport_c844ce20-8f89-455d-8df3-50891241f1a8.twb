              <calculation class='tableau' formula='[Calculation_3194952133160407072]/[Calculation_3194952132191281153]' />
            </column>
            <column caption='Quiz Total Conversion' datatype='real' default-format='p0.00%' name='[Calculation_4424716306465046530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952133160890401]/[Calculation_3194952132191281153]' />
