            <column caption='Vehicle' datatype='string' name='[Calculation_5292644399653277715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  CONTAINS(lower([vehicle_type]), &quot;bike&quot;) then &quot;Motorbike&quot;&#10;elseif Contains(LOWER([vehicle_type]), &quot;motorbike&quot;) then &quot;Motorbike&quot;&#10;elseif contains(LOWER([vehicle_type]), &quot;car&quot;) then &quot;Car&quot; &#10;elseif contains(lower([vehicle_type]), &quot;walk&quot;) then &quot;Walker&quot; &#10;elseif contains(lower([vehicle_type]), &quot;cycle&quot;) then &quot;Bicycle&quot;&#10;elseif contains(lower([vehicle_type]), &quot;scooter&quot;) then &quot;Scooter&quot;&#10;ELSEIF ISNULL([vehicle_type]) then [vehicle_type]&#10;else &quot;Other&quot; end' />
