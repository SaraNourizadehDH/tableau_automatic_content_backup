      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_rider_applicant (data_platform_logistics)' name='federated.15pmxcb0nwd6ya1g51aw00ma69bl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hours&quot;'>
              <calculation class='tableau' formula='&quot;Hours&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15pmxcb0nwd6ya1g51aw00ma69bl'>
            <column caption='Welcome Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132199424005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Welcome Stage Completed At]-[Welcome Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[welcome_stage_started_at],[welcome_stage_completed_at])/3600' />
            </column>
            <column caption='Doc Collection Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132201672710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Doc Collection Stage Completed At]-[Doc Collection Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_collection_stage_started_at],[doc_collection_stage_completed_at])/3600' />
            </column>
            <column caption='Doc Review Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132205391879]' role='measure' type='quantitative'>
