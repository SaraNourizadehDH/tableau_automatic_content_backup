      <aliases enabled='yes' />
      <column caption='RR Downloaded Riders' datatype='integer' name='[Activated Riders (copy)_1026468917157978112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Countd(if not isnull([first_app_session]) then [rider_id] end)' />
      </column>
      <column caption='Welcome 1 Riders' datatype='integer' name='[Activated Riders (copy)_1026468917159931909]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='Countd(if not isnull([welcome_stage_1_started_at]) and [created_date]&gt;DATE(&quot;2022-12-01&quot;) then [applicant_id] end)' />
      </column>
      <column caption='Applicants Landed Doc Collection' datatype='integer' name='[Applicants Completed Doc Collection (copy)_5292644399639883782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_collection_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Doc Review' datatype='integer' name='[Applicants Completed Doc Review (copy)_5292644399640264711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_review_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Phone Call' datatype='integer' name='[Applicants Completed Phone Call (copy)_5292644399640723465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([phone_call_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Quiz' datatype='integer' name='[Applicants Completed Quiz (copy)_5292644399640567816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([quiz_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Scheduled Onboarding' datatype='integer' name='[Applicants Completed Scheduled Onboarding (copy)_5292644399640997898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([scheduled_onboarding_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Service Agreement' datatype='integer' name='[Applicants Completed Service Agreement (copy)_5292644399641223179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([service_agreement_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Landed Welcome' datatype='integer' name='[Applicants Completed Welcome (copy)_5292644399637680133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([welcome_stage_started_at]) then 1 else 0 END)' />
      </column>
      <column caption='Avg Hires/RAF User' datatype='real' name='[Avg Leads/RAF User (copy)_3237384483347173377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[RAF Conversion (copy)_2078833487055814657]/[Avg Leads/RAF User (copy)_3237384483352408069]' />
      </column>
      <column caption='RAF Users' datatype='integer' name='[Avg Leads/RAF User (copy)_3237384483352408069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([referred_by_id])' />
      </column>
      <column caption='Exclude Nulls' datatype='boolean' name='[Calculation_1319695441989709824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([company_name]) and [country_code] in (&apos;ae&apos;,&apos;kw&apos;,&apos;bh&apos;,&apos;iq&apos;,&apos;qa&apos;) &#10;then TRUE else FALSE &#10;end' />
      </column>
      <column caption='Delta Applicants-Hired' datatype='integer' name='[Calculation_193795525211291648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3194952132191281153]-[Calculation_3194952132189720576]' />
      </column>
      <column caption='Hired Riders' datatype='integer' name='[Calculation_3194952132189720576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if [current_stage_name] = &quot;Hired&quot; then 1 else 0 END)' />
      </column>
      <column caption='Applicants' datatype='integer' name='[Calculation_3194952132191281153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD([applicant_id])' />
      </column>
      <column caption='Applicants Completed Welcome' datatype='integer' name='[Calculation_3194952132195188738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([welcome_stage_completed_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Completed Doc Collection' datatype='integer' name='[Calculation_3194952132196732931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_collection_stage_completed_at]) then 1 else 0 END)' />
      </column>
      <column caption='Applicants Completed Doc Review' datatype='integer' name='[Calculation_3194952132196864004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_review_stage_completed_at]) then 1 else 0 END)' />
      </column>
      <column caption='Welcome Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132199424005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Welcome Stage Completed At]-[Welcome Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[welcome_stage_started_at],[welcome_stage_completed_at])/3600' />
      </column>
      <column caption='Doc Collection Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132201672710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Doc Collection Stage Completed At]-[Doc Collection Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_collection_stage_started_at],[doc_collection_stage_completed_at])/3600' />
      </column>
      <column caption='Doc Review Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132205391879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Doc Review Stage Completed At]-[Doc Review Stage Started At])*1000&#10;DATEDIFF(&apos;second&apos;,[doc_review_stage_started_at],[doc_review_stage_completed_at])/3600' />
      </column>
      <column caption='Quiz Stage Time(Hrs)' datatype='real' name='[Calculation_3194952132442009608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[quiz_stage_started_at],[quiz_stage_completed_at])/3600' />
