            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15pmxcb0nwd6ya1g51aw00ma69bl'>
            <column caption='Applicants Landed Doc Collection' datatype='integer' name='[Applicants Completed Doc Collection (copy)_5292644399639883782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([doc_collection_stage_started_at]) then 1 else 0 END)' />
