            <column caption='Applicants Completed Service Agreement' datatype='integer' name='[Calculation_4424716306464604160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if NOT ISNULL([service_agreement_stage_completed_at]) then 1 else 0 END)' />
            </column>
            <column caption='Scheduled Onboarding Total Conversion' datatype='real' default-format='p0.00%' name='[Calculation_4424716306465234947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194952133161099298]/[Calculation_3194952132191281153]' />
