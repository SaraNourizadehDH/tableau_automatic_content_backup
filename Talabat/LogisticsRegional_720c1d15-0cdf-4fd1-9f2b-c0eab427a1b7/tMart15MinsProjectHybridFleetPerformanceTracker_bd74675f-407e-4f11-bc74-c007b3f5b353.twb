            </column>
            <column caption='% Stacking' datatype='real' name='[Calculation_2739666321430024203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_stacked]=TRUE AND [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='% Idle Time' datatype='real' name='[Calculation_2739666321430499340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [idle_time_mins] &#10;       ELSEIF [Calculation_2739666321446645779]&lt;&gt;&apos;Hybrid Fleet&apos; THEN [regular_fleet_city_idle_time_mins] END )/&#10;SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [working_time_mins]&#10;    ELSEIF [Calculation_2739666321446645779]&lt;&gt;&apos;Hybrid Fleet&apos; THEN [regular_fleet_city_working_time_mins] END))' />
            </column>
            <column caption='% DT&lt;= 15 Mins' datatype='real' name='[Calculation_2739666321439563794]' role='measure' type='quantitative'>
