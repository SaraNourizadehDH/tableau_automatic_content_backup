              <relation connection='cloudfile:googledrive-excel-direct.0uia3l311nmmqw1avmmcd0cpinx3' name='Algo Tracker &amp; Hybrid Fleet Glo' table='[&apos;Algo Tracker &amp; Hybrid Fleet Glo$&apos;]' type='table'>
                <columns gridOrigin='A1:D26:no:A1:D26:0' header='yes' outcome='6'>
                  <column datatype='string' name='Tab of the Metric' ordinal='0' />
