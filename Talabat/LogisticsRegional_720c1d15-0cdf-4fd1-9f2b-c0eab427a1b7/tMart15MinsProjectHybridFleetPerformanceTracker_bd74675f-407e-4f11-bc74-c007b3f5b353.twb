        <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
        <column aggregation='Sum' caption='Rider ID' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
        <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
