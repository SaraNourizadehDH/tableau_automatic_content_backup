    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Hybrid Fleet Rider Data '>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/tMart15MinsProject-HybridFleetPerformanceTracker/HybridFleetRiderData?rev=' id='HybridFleetRiderData' path='/t/Talabat/workbooks/tMart15MinsProject-HybridFleetPerformanceTracker' revision='' site='Talabat' />
      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Hybrid Fleet Rider Data' name='federated.1wzncj20ksyvu21fi87fv1xfdcoc (copy)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Time Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
            <member value='&quot;Overall&quot;' />
          </members>
        </column>
        <column caption='View Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rider View&quot;'>
          <calculation class='tableau' formula='&quot;Rider View&quot;' />
          <members>
            <member value='&quot;Vendor View&quot;' />
            <member value='&quot;Rider View&quot;' />
          </members>
        </column>
        <column caption='Breakdown' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <members>
            <member value='true' />
            <member value='false' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1wzncj20ksyvu21fi87fv1xfdcoc (copy)'>
        <column caption='is Hybrid Fleet Test Store' datatype='boolean' name='[Calculation_4217339581164007426]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [vendor_name]=&apos;Talabat Mart , Al Hosn&apos;&#10;OR ([order_date] &lt;= DATE(&apos;2025-05-15&apos;) AND  [vendor_name]=&apos;talabat mart, Al Quoz Industrial Area 1&apos;)&#10;OR ([order_date] &gt; DATE(&apos;2025-05-15&apos;) AND  [vendor_name]=&apos;Talabat Mart , Palm Jumeirah&apos;)&#10;OR [vendor_name]=&apos;talabat mart, Al Nasserya&apos; THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='is Primary Delivery' datatype='boolean' name='[is_primary_delivery]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_4217339581164007426]' derivation='None' name='[none:Calculation_4217339581164007426:nk]' pivot='key' type='nominal' />
