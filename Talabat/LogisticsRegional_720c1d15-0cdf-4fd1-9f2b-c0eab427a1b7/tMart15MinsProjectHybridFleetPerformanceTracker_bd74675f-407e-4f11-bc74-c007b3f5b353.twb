            </column>
            <column caption='Fleet Type' datatype='string' name='[Calculation_2739666321446645779]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([vehicle_bag]), &apos;tmart - dedicated&apos;) THEN &apos;Hybrid Fleet&apos;&#10;ELSEIF CONTAINS(LOWER([vehicle_bag]), &apos;bike&apos;) THEN &apos;Regular Fleet&apos; END' />
            </column>
            <column caption='Hybrid vs Regular Fleet Date Filter' datatype='boolean' name='[Calculation_2739666321479598103]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [order_date]&gt;DATE(&apos;2025-04-27&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Order Date parameter' datatype='datetime' name='[Calculation_2739666321485819929]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Overall&apos; THEN DATE(&apos;&apos;) &#10;ELSEIF [Parameters].[Parameter 3]=&apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date]) &#10;ELSEIF [Parameters].[Parameter 3]=&apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;) &#10;ELSE [order_date] END' />
            </column>
            <column caption='Hybrid Fleet Rider Count' datatype='integer' name='[Hybrid Fleet Rider Count (copy)_2739666321849253922]' role='measure' type='quantitative'>
