  <worksheets>
    <worksheet name='Before &amp; After Hybrid Fleet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>(</run>
            <run fontcolor='#000000' fontsize='8'>This tab presents a before-and-after analysis of all fleets within the dedicated kilometer range, at the store level.The &quot;Before&quot; period refers to February 2025, while the &quot;After&quot; period covers April 28, 2025, to the current date.)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Hybrid Fleet Analysis' name='federated.0avr2wf0840vne1h3pr0f1nszcwy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0avr2wf0840vne1h3pr0f1nszcwy'>
            <column caption='% Idle Time - Hybrid Fleet' datatype='real' name='[% Idle Time (copy 2)_2739666321858785315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [idle_time_mins] END )/&#10;SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [working_time_mins] END))' />
            </column>
            <column caption='% Idle Time - Regular Fleet' datatype='real' name='[% Idle Time (copy 2)_2739666321859067940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_2739666321446645779]&lt;&gt;&apos;Hybrid Fleet&apos; THEN [regular_fleet_city_idle_time_mins] END )/&#10;SUM(IF [Calculation_2739666321446645779]&lt;&gt;&apos;Hybrid Fleet&apos; THEN [regular_fleet_city_working_time_mins] END))' />
            </column>
            <column caption='% Orders within Distance and TCT Scope' datatype='real' name='[% Orders within Distance Scope (copy)_2739666321438949393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] AND [within_tct_scope] THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='% Orders within Distance Scope' datatype='real' name='[% Orders within TCT Scope (copy)_2739666321433026574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 1Min' datatype='real' name='[%Rider Late - 1 Min (copy)_261771739932852226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_2_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 2 Mins' datatype='real' name='[%Rider Late - 2 Mins (copy)_261771739932938243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_3_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 5 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy) (copy) (copy)_261771739933331462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_6_10_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt;10 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy) (copy)_261771739933319173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_10_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 3 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy)_261771739933302788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_4_5_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='TCT' datatype='real' name='[AVT (copy) (copy) (copy)_2739666321429262346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [tct_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='DT' datatype='real' name='[AVT (copy) (copy)_2739666321429250057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [dt_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='PDT' datatype='real' name='[AVT (copy)_2739666321429237768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [pdt_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='AVT Compliance' datatype='real' name='[AVT (copy)_2739666321523965978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [avt_compliant_order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='TCT Compliance' datatype='real' name='[AVT Compliance (copy) (copy)_2739666321524195356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [tct_compliant_order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='RRV Compliance' datatype='real' name='[AVT Compliance (copy)_2739666321524187163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rrv_compliant_order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Prep Time Compliance' datatype='real' name='[AVT Compliance (copy)_2739666321526681629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [prep_time_compliant_order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late' datatype='real' name='[Calculation_261771739932704769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_1_min] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='TVT' datatype='real' name='[Calculation_2739666321422409729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [tvt_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='% Stacking' datatype='real' name='[Calculation_2739666321430024203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_stacked]=TRUE AND [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='% DT&lt;= 15 Mins' datatype='real' name='[Calculation_2739666321439563794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] THEN [dt_15] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] THEN [order_count] END)' />
            </column>
            <column caption='Fleet Type' datatype='string' name='[Calculation_2739666321446645779]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([vehicle_bag]), &apos;tmart - dedicated&apos;) THEN &apos;Hybrid Fleet&apos;&#10;ELSEIF CONTAINS(LOWER([vehicle_bag]), &apos;bike&apos;) THEN &apos;Regular Fleet&apos; END' />
            </column>
            <column caption='Order Date parameter' datatype='datetime' name='[Calculation_2739666321485819929]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Overall&apos; THEN DATE(&apos;&apos;) &#10;ELSEIF [Parameters].[Parameter 3]=&apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date]) &#10;ELSEIF [Parameters].[Parameter 3]=&apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;) &#10;ELSE [order_date] END' />
            </column>
            <column caption='Hybrid Fleet Launch' datatype='string' name='[Hybrid vs Regular Fleet Date Filter (copy)_2739666321482006552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_date] &gt;= DATE(&apos;2025-02-01&apos;) AND [order_date] &lt;= DATE(&apos;2025-02-28&apos;)  THEN &apos;Before&apos; &#10;ELSEIF [order_date]&gt;=DATE(&apos;2025-04-28&apos;) THEN &apos;After&apos; END' />
            </column>
            <column caption='Store Dispatch Time' datatype='real' name='[PDT (copy)_2739666321448615956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [store_dispatch_time] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Rider 30m Geofence to Pickup' datatype='real' name='[Rider 150 m to 30 m Geofence (copy)_130674764518793218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_30m_picked_up] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Rider Pickup to 30m Geofence' datatype='real' name='[Rider 150 m to 30 m Geofence (copy)_130674764518973443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_picked_up_30m_exit] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Rider Dispatch Time (Last Dispatch)' datatype='real' name='[Rider Acceptance Time (copy)_2739666321425522691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rdt_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Rider Dispatch Time (First Dispatch)' datatype='real' name='[Rider Dispatch Time (copy)_130674764519481349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rdt_first_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Rider 30m to 150m Geofence' datatype='real' name='[Rider Pickup to 30 m Geofence (copy)_130674764519165956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_30m_150m_exit] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Prep Time' datatype='real' name='[Store Dispatch Time (copy)_2739666321448853525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [total_prep_time] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='Successful Orders (All)' datatype='integer' name='[Successful Orders (copy)_2739666321438412816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='% Orders within TCT Scope' datatype='real' name='[TCT (copy)_2739666321432834061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_tct_scope] THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='Rider 150m to 30m Geofence' datatype='real' name='[TVT (copy)_130674764518498305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_150_30m] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='RRV' datatype='real' name='[TVT (copy)_2739666321427247108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rrv_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='AVT' datatype='real' name='[TVT (copy)_2739666321428877318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [avt_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='AVTC' datatype='real' name='[TVT (copy)_2739666321428938759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [avtc_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='UTR - Hybrid Fleet' datatype='real' name='[UTR (copy)_2739666321859686437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [order_count] END )/&#10;SUM(IF [Calculation_2739666321446645779]=&apos;Hybrid Fleet&apos; AND [within_distance_scope]=TRUE THEN [working_time_mins]/60 END))' />
            </column>
            <column caption='UTR - Regular Fleet' datatype='real' name='[UTR (copy)_2739666321859829798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([Calculation_2739666321446645779])=&apos;Regular Fleet&apos; THEN SUM([regular_fleet_city_order_count])/sum([regular_fleet_city_working_time_mins]/60)&#10;END' />
