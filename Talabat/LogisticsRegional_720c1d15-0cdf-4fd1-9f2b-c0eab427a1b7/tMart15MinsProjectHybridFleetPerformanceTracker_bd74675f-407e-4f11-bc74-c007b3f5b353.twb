    <worksheet name='Hybrid vs Regular Fleet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>(</run>
            <run fontcolor='#000000' fontsize='8'>This tab displays a comparison between hybrid and regular fleets within the dedicated kilometer range, at the store level, over the same time frame.)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Hybrid Fleet Analysis' name='federated.0avr2wf0840vne1h3pr0f1nszcwy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0avr2wf0840vne1h3pr0f1nszcwy'>
            <column caption='% Orders within Distance and TCT Scope' datatype='real' name='[% Orders within Distance Scope (copy)_2739666321438949393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] AND [within_tct_scope] THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='% Orders within Distance Scope' datatype='real' name='[% Orders within TCT Scope (copy)_2739666321433026574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope] THEN [order_count] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 1Min' datatype='real' name='[%Rider Late - 1 Min (copy)_261771739932852226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_2_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 2 Mins' datatype='real' name='[%Rider Late - 2 Mins (copy)_261771739932938243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_3_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 5 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy) (copy) (copy)_261771739933331462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_6_10_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt;10 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy) (copy)_261771739933319173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_10_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='%Rider Late &gt; 3 Mins' datatype='real' name='[%Rider Late - 3 Mins (copy)_261771739933302788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [rider_late_4_5_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
            <column caption='TCT' datatype='real' name='[AVT (copy) (copy) (copy)_2739666321429262346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [tct_mins] END)/&#10;SUM(IF [order_status]=&apos;completed&apos; AND [within_distance_scope]=TRUE THEN [order_count] END)' />
            </column>
