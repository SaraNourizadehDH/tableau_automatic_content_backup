      <column caption='% Late Login &gt;10 Mins' datatype='real' name='[% Late Login (copy) (copy)_6532752742090018817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([late_login_10])}&#10;)/&#10;SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([shift_count])}&#10;)' />
      </column>
      <column caption='% of Break' datatype='real' name='[% Late Login (copy)_211106239785472003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([actual_break_time_mins])}&#10;)/&#10;SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([actual_working_time_mins])}&#10;)' />
      </column>
      <column caption='% Late Login &gt;5 Mins' datatype='real' name='[% Late Login (copy)_6532752742090006528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([late_login_5])}&#10;)/&#10;SUM(&#10;{ FIXED [vendor_name], [order_date], [rider_id]: MAX([shift_count])}&#10;)' />
      </column>
      <column caption='% Rider Late &gt; 5 Mins' datatype='real' name='[% Rider Late - 3-5 Mins (copy)_261771739947769865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_6_10_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='% Rider Late &gt; 10 Mins' datatype='real' name='[% Rider Late - 6-10 Mins (copy)_261771739947921418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_10_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='% Rider Late &gt; 2 Mins' datatype='real' name='[% Rider Late &lt;=2 Mins (copy)_261771739947610120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_3_5_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='AVTC' datatype='real' name='[AVT (copy)_4217339581173436422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avtc_mins])/ SUM([successful_delivery_count])' />
      </column>
      <column caption='% Stacked Orders' datatype='real' name='[Calculation_211106239835025412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_order_count])/SUM([successful_order_count])' />
      </column>
      <column caption='% Rider Late' datatype='real' name='[Calculation_261771739947368455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_0_2_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='View' datatype='string' name='[Calculation_4217339581157871616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Vendor View&apos; THEN [vendor_name] ELSE STR([rider_id]) END' />
      </column>
      <column caption='is Hybrid Fleet Test Store' datatype='boolean' name='[Calculation_4217339581164007426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vendor_name]=&apos;Talabat Mart , Al Hosn&apos;&#10;OR ([order_date] &lt;= DATE(&apos;2025-05-15&apos;) AND  [vendor_name]=&apos;talabat mart, Al Quoz Industrial Area 1&apos;)&#10;OR ([order_date] &gt; DATE(&apos;2025-05-15&apos;) AND  [vendor_name]=&apos;Talabat Mart , Palm Jumeirah&apos;)&#10;OR [vendor_name]=&apos;talabat mart, Al Nasserya&apos; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='DT' datatype='real' name='[Calculation_4217339581171187715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([adt_mins])/ SUM([successful_delivery_count])' />
      </column>
      <column caption='Rider Acceptance Time' datatype='real' name='[Calculation_4217339581173542919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rat_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='Rider Dispatch Time' datatype='real' name='[Calculation_4217339581173727240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rdt_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='TCT' datatype='real' name='[Calculation_4217339581173895177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tct_mins])/SUM([successful_order_count])' />
      </column>
      <column caption='Prep Time' datatype='real' name='[Calculation_4217339581174767627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_prep_time])/SUM([successful_order_count])' />
      </column>
      <column caption='% Late Delivery Cancellation' datatype='real' name='[Calculation_4217339581175947277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_delivery_cancellation_count])/SUM([total_order_count])' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_4217339581176590350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count_utr])/SUM([working_time_mins]/60)' />
