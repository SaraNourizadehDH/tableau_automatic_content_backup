    </datasource>
    <datasource caption='Hybrid Fleet Rider Data' inline='true' name='federated.1wzncj20ksyvu21fi87fv1xfdcoc (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17zejlu0yo3d431g2iq5n0zaac8h'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='duygu.chaturvedi@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17zejlu0yo3d431g2iq5n0zaac8h' name='Custom SQL Query' type='text'><![CDATA[------------------------------------------------------------------------------------------------
---------------------Hybrid Fleet Rider Data----------------------------------------------------
------------------------------------------------------------------------------------------------
WITH vendor_info AS 
(
  SELECT 
      dvi.vendor_id,
      dvi.vendor_name,
      dvi.country_code,
      dli.city_name as city
    FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
    WHERE  dvi.country_code = 'AE' --IN ('AE','BH','EG','OM','QA')
),
base AS 
(
  SELECT 
  --order level data  
    o.country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.vendor.vertical_type,
    o.order_id,
    o.platform_order_code,
    o.order_status,
    date(o.created_at,o.timezone) AS order_date,
    o.timings.to_vendor_time/60 AS tvt_mins,
    o.timings.at_vendor_time/60 AS avt_mins,
    o.timings.at_vendor_time_cleaned/60 AS avtc_mins,
    o.timings.to_customer_time/60 AS tct_mins,
    o.timings.promised_delivery_time/60 AS pdt_mins,
    o.timings.actual_delivery_time/60 AS adt_mins,
    o.timings.rider_late/60 AS rider_late_mins,
    o.cancellation.reason AS cancellation_reason,--LATE_DELIVERY
  --delivery level data
    d.id AS delivery_id, 
    d.delivery_status,
    date(d.created_at,o.timezone) AS delivery_date,
    d.rider_id,
    d.is_stacked_intravendor AS is_stacked,
    d.is_primary AS is_primary_delivery, 
    d.is_returning,
    d.is_redelivery,
    d.dropoff_distance_manhattan/1000 AS dropoff_distance_manhattan_km,
    d.delivery_distance/1000 AS delivery_distance_km,
    timestamp_diff(d.rider_dispatched_at,o.created_at,second)/60 AS rdt_mins,
    timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)/60 AS rat_mins,
    timestamp(datetime(d.rider_accepted_at,o.timezone)) AS rider_accepted_at,
    d.vehicle.vehicle_bag,
    d.vehicle.name AS vehicle_name,
    d.timings.to_vendor_time/60 AS d_tvt_mins,
    d.timings.at_vendor_time/60 AS d_avt_mins,
    d.timings.at_vendor_time_cleaned/60 AS d_avtc_mins,
    d.timings.to_customer_time/60 AS d_tct_mins,
    d.timings.actual_delivery_time/60 AS d_adt_mins,
  --transition level data  
    t.rider_id AS t_rider_id,
    timestamp(datetime(t.created_at,o.timezone)) AS transition_at,
    date(t.created_at,o.timezone) AS transition_date,
    t.undispatch_type,--filter manual_undispatch
    v.vendor_name,
    city,
    CASE WHEN date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 3  
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.8  
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 2.4
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.1
      WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.7 END AS scope_distance,
    CASE WHEN (CASE WHEN date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
                    WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 3  
                    WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.8  
                    WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 2.4
                    WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.1
                    WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.7 END 
                )>>=d.delivery_distance/1000 THEN TRUE
         ELSE FALSE END AS within_distance_scope,
    CASE WHEN d.timings.to_customer_time/60<<=8.5 THEN TRUE ELSE FALSE END AS within_tct_scope
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  LEFT JOIN UNNEST(d.transitions) t
  LEFT JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  WHERE o.created_date >>= '2025-04-27'
    AND o.entity.id = 'TB_AE'
    AND d.vehicle.name='tmart - Dedicated'
),
scope_filter AS 
(
SELECT 
  country_code,
  rider_id,
  order_id,
  platform_order_code,
  within_distance_scope,
  within_tct_scope,
FROM base
),
rider_shifts AS 
(--riders within 9 am-10 pm shifts
  SELECT DISTINCT
    date(shift_start_at,timezone) AS shift_date,
    rider_id,
    country_code,
    min(timestamp(datetime(actual_start_at,timezone))) AS shift_start,
    max(timestamp(datetime(actual_end_at,timezone))) AS shift_end
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
  WHERE 1=1
    AND created_date>>='2025-01-31'
    AND extract(hour from timestamp(datetime(shift_start_at,timezone)))>>=9
    AND time(datetime(shift_end_at,timezone)) <<= time '22:00:00'
    AND time(datetime(shift_end_at,timezone)) >>= time '09:00:00'
    AND country_code = 'ae'
    AND shift_state='EVALUATED'
    GROUP BY ALL
    ORDER BY 1,2,3
),
rider_manual_undispatch AS 
(
  SELECT
    b.country_code,
    transition_date,
    t_rider_id AS rider_id,
    vendor_code,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    count(DISTINCT CASE WHEN undispatch_type='manual_undispatch' THEN delivery_id END) AS manual_undispatch_count,
    count(DISTINCT CASE WHEN undispatch_type IS NOT NULL THEN delivery_id END) AS total_undispatch_count
  FROM base b
    INNER JOIN rider_shifts r ON r.rider_id=b.t_rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.transition_at  AND r.shift_end>>=b.transition_at
      GROUP BY ALL
),
all_orders AS 
(
  SELECT 
    b.country_code,
    b.rider_id,
    order_date,
    vendor_code,
    vendor_name,
    city,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    scope_distance,
    count(DISTINCT order_id) AS total_order_count,
    count(DISTINCT CASE WHEN is_primary_delivery AND delivery_status = 'completed' THEN order_id END) AS utr_order_count,
    count(DISTINCT CASE WHEN cancellation_reason='LATE_DELIVERY' THEN order_id END) AS late_delivery_cancellation_count
  FROM base b
    INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
      GROUP BY ALL
),
geofence AS (
SELECT
  country_code,
  delivery_id,
  timestamp_diff(rider_30m_to_pickup_at,rider_near_pickup_at,second)/60 as rider_150_30m,
  timestamp_diff(rider_picked_up_at,rider_30m_to_pickup_at,second)/60 as rider_30m_picked_up,
  timestamp_diff(rider_30m_to_pickup_exit_at,rider_picked_up_at,second)/60 as rider_picked_up_30m_exit,
  timestamp_diff(rider_150m_to_pickup_exit_at,rider_30m_to_pickup_exit_at,second)/60 as rider_30m_150m_exit
FROM `fulfillment-dwh-production.curated_data_shared.deliveries_geofence_timings` g
  WHERE created_date>>='2025-04-25'
    AND country_code='ae'
    AND entity_id='TB_AE'
    GROUP BY ALL
),
rider_delivery_data AS 
(
  SELECT DISTINCT
    b.country_code,
    b.rider_id,
    vendor_code,
    order_date,
    b.delivery_id,
    is_primary_delivery,
    is_stacked,
    within_distance_scope,
    within_tct_scope,
    order_id,
    platform_order_code,
    d_tvt_mins,
    d_avt_mins,
    d_avtc_mins,
    d_tct_mins,
    pdt_mins,
    d_adt_mins,
    rdt_mins,
    rat_mins,
    rider_150_30m,
    rider_30m_picked_up,
    rider_picked_up_30m_exit,
    rider_30m_150m_exit,
    rider_late_mins
  FROM base b 
    INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
    LEFT JOIN geofence g ON b.delivery_id=g.delivery_id AND b.country_code=g.country_code 
    WHERE order_status='completed'
      AND delivery_status='completed'
),
order_list AS 
(
SELECT DISTINCT
  b.country_code,
  b.rider_id,
  order_id,
  within_distance_scope,
    within_tct_scope,
  platform_order_code
FROM base b
  INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
),
picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    lower(pickers.country_code) AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as total_prep_time,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
    INNER JOIN order_list o ON o.platform_order_code=cast(pickers.order_id AS string) AND o.country_code=lower(pickers.country_code)
  WHERE created_date>>='2025-04-27'
    AND global_entity_id = 'TB_AE'
),

rider_data AS --successful orders and deliveries
(
  SELECT 
    rd.country_code,
    rider_id,
    vendor_code,
    order_date,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    count(delivery_id) AS delivery_count,
    count(DISTINCT rd.order_id) AS order_count,
    count(CASE WHEN is_stacked THEN delivery_id END) AS stacked_order_count,
    sum(rd.d_tvt_mins) AS tvt_mins,
    sum(rd.d_avt_mins) AS avt_mins,
    sum(rd.d_avtc_mins) AS avtc_mins,
    sum(rd.d_tct_mins) AS tct_mins,
    sum(rd.pdt_mins) AS pdt_mins,
    sum(rd.d_adt_mins) AS adt_mins,
    sum(rd.rdt_mins) AS rdt_mins, 
    sum(rd.rat_mins) AS rat_mins, 
    count(p.order_id) AS picking_order_count,
    sum(total_prep_time) AS total_prep_time,
    sum(store_dispatch_time) AS store_dispatch_time,
    sum(rider_150_30m) AS rider_150_30m,
    sum(rider_30m_picked_up) AS rider_30m_picked_up,
    sum(rider_picked_up_30m_exit) AS rider_picked_up_30m_exit,
    sum(rider_30m_150m_exit) AS rider_30m_150m_exit,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>10 THEN rd.delivery_id END) rider_late_10_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>5 THEN rd.delivery_id END) rider_late_6_10_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>2 THEN rd.delivery_id END) rider_late_3_5_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>0 THEN rd.delivery_id END) rider_late_0_2_mins
  FROM rider_delivery_data rd
    LEFT JOIN picking_data p ON rd.country_code=p.country_code AND rd.platform_order_code=cast(p.order_id AS string)
    GROUP BY ALL
),

utr_timings AS -- rider level data
(
  SELECT 
    delivery_date,
    ut.country_code,
    ut.rider_id,
    ut.vendor_code,
    ut.is_primary AS is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    sum(idle_time/60) as idle_time_mins,
    sum((reaction_time+to_vendor_time+at_vendor_time+to_customer_time+at_customer_time+idle_time)/60) as working_time_mins,
    count(delivery_id) AS delivery_count,
    count(DISTINCT ut.order_id) AS order_count,
  FROM `fulfillment-dwh-production.curated_data_shared.utr_timings`ut
    INNER JOIN (SELECT DISTINCT country_code, rider_id, vehicle_bag FROM base ) r ON r.country_code=ut.country_code AND r.rider_id=ut.rider_id AND r.vehicle_bag=ut.vehicle_bag
    INNER JOIN order_list o ON o.order_id=ut.order_id AND o.country_code=ut.country_code
    WHERE created_date>>='2025-04-27' 
      AND entity_id = 'TB_AE'
      GROUP BY ALL
),
utr_timings_2 AS
(
  SELECT
    delivery_date,
    country_code,
    rider_id,
    sum(idle_time_mins) AS idle_time_mins,
    sum(working_time_mins) AS working_time_mins,
    sum(delivery_count) AS delivery_count,
    sum(order_count) AS order_count
  FROM utr_timings
    GROUP BY ALL

),

tmart_targets AS -- these values are calculated according as p75th of every metric of January data (hardcoded to increase the efficiency of the query)
( 
SELECT 'AE' AS country_code,1.767 AS rider_tvt_perc,2.767 AS total_prep_time_perc,3.691 AS handover_time_perc,4.383 AS avt_perc,8.267 AS tct_perc,0.507 AS speed_perc
UNION ALL
SELECT 'BH' AS country_code,1.983 AS rider_tvt_perc,3.895 AS total_prep_time_perc,2.855 AS handover_time_perc,4.35 AS avt_perc,8.417 AS tct_perc,0.442 AS speed_perc
UNION ALL
SELECT 'OM' AS country_code,1.5 AS rider_tvt_perc,3.18 AS total_prep_time_perc,2.854 AS handover_time_perc,4.283 AS avt_perc,8.633 AS tct_perc,0.562 AS speed_perc
UNION ALL
SELECT 'EG' AS country_code,2.967 AS rider_tvt_perc,2.474 AS total_prep_time_perc,4.571 AS handover_time_perc,4.333 AS avt_perc,7.367 AS tct_perc,0.395 AS speed_perc
UNION ALL
SELECT 'QA' AS country_code,1.583 AS rider_tvt_perc,3.745 AS total_prep_time_perc,1.906 AS handover_time_perc,3.8 AS avt_perc,9.183 AS tct_perc,0.502 AS speed_perc
),
evaluated_shifts AS 
(
  SELECT 
      s.rider_id,
      date(s.actual_start_at,timezone) AS shift_date,
      country_code,
      count(DISTINCT shift_id) AS shift_count_d,
      count(shift_id) AS shift_count,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>0 THEN shift_id END) AS late_login,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>5 THEN shift_id END) AS late_login_5,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>10 THEN shift_id END) AS late_login_10,
      sum(actual_working_time/60) AS actual_working_time_mins,
      sum(actual_break_time/60) AS actual_break_time_mins
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
  WHERE 1=1
    AND created_date>>='2025-01-31'
    AND extract(hour from timestamp(datetime(shift_start_at,timezone)))>>=9
    AND time(datetime(shift_end_at,timezone)) <<= time '22:00:00'
    AND time(datetime(shift_end_at,timezone)) >>= time '09:00:00'
    AND country_code = 'ae'
    AND created_date>>='2025-04-27'
    AND shift_state='EVALUATED'
    AND lower(vehicle_bag) LIKE ('%tmart - dedicated%')
      GROUP BY ALL
)

SELECT 
  current_timestamp() AS last_updated_at,
  o.rider_id,
  o.order_date,
  o.vendor_code,
  o.vendor_name,
  o.city,
  o.country_code,
  o.total_order_count,
  o.utr_order_count,
  o.late_delivery_cancellation_count,
  o.is_primary_delivery,
  o.within_distance_scope,
  o.within_tct_scope,
  o.scope_distance,
  rd.delivery_count AS successful_delivery_count,
  rd.order_count AS successful_order_count,
  rd.tvt_mins,
  rd.avt_mins,
  rd.avtc_mins,
  rd.tct_mins,
  rd.adt_mins,
  rd.pdt_mins,
  rd.rdt_mins,
  rd.rat_mins,
  rd.picking_order_count,
  rd.total_prep_time,
  rd.store_dispatch_time,
  rd.stacked_order_count,
  rd.rider_150_30m,
  rd.rider_30m_picked_up,
  rd.rider_picked_up_30m_exit,
  rd.rider_30m_150m_exit,
  rd.rider_late_10_mins,
  rd.rider_late_6_10_mins,
  rd.rider_late_3_5_mins,
  rd.rider_late_0_2_mins,
  ut.idle_time_mins,
  ut.working_time_mins,
  ut.delivery_count AS delivery_count_utr,
  ut.order_count AS order_count_utr,
  mu.manual_undispatch_count,
  mu.total_undispatch_count,
  s.actual_break_time_mins,
  s.actual_working_time_mins,
  s.late_login,
  s.late_login_5,
  s.late_login_10,
  s.shift_count,
  s.shift_count_d,
  utr2.idle_time_mins AS idle_time_mins_city_level,
  utr2.working_time_mins AS working_time_mins_city_level,
  utr2.delivery_count AS delivery_count_city_level_utr,
  utr2.order_count AS order_count_city_level_utr,
FROM all_orders o
  LEFT JOIN rider_data rd ON rd.country_code=o.country_code AND rd.vendor_code=o.vendor_code AND rd.order_date=o.order_date AND rd.rider_id=o.rider_id AND rd.is_primary_delivery=o.is_primary_delivery AND rd.within_tct_scope=o.within_tct_scope AND rd.within_distance_scope=o.within_distance_scope
  LEFT JOIN utr_timings ut ON ut.country_code=o.country_code AND ut.vendor_code=o.vendor_code AND ut.delivery_date=o.order_date AND ut.rider_id=o.rider_id AND ut.is_primary_delivery=o.is_primary_delivery AND ut.within_tct_scope=o.within_tct_scope AND ut.within_distance_scope=o.within_distance_scope 
  LEFT JOIN rider_manual_undispatch mu ON mu.country_code=o.country_code AND mu.vendor_code=o.vendor_code AND mu.transition_date=o.order_date AND mu.rider_id=o.rider_id AND mu.is_primary_delivery=o.is_primary_delivery AND mu.within_tct_scope=o.within_tct_scope AND mu.within_distance_scope=o.within_distance_scope
  LEFT JOIN evaluated_shifts s ON s.country_code=o.country_code AND s.rider_id=o.rider_id AND s.shift_date=o.order_date
  LEFT JOIN utr_timings_2 utr2 ON utr2.country_code=o.country_code AND utr2.rider_id=o.rider_id AND utr2.delivery_date=o.order_date
WHERE o.city IS NOT NULL
  AND o.order_date BETWEEN '2025-04-28' AND current_date()-1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17zejlu0yo3d431g2iq5n0zaac8h' name='Custom SQL Query' type='text'><![CDATA[------------------------------------------------------------------------------------------------
---------------------Hybrid Fleet Rider Data----------------------------------------------------
------------------------------------------------------------------------------------------------
WITH vendor_info AS 
(
  SELECT 
      dvi.vendor_id,
      dvi.vendor_name,
      dvi.country_code,
      dli.city_name as city
    FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
    WHERE  dvi.country_code = 'AE' --IN ('AE','BH','EG','OM','QA')
),
base AS 
(
  SELECT 
  --order level data  
    o.country_code,
    o.city_id,
    o.vendor.vendor_code,
    o.vendor.vertical_type,
    o.order_id,
    o.platform_order_code,
    o.order_status,
    date(o.created_at,o.timezone) AS order_date,
    o.timings.to_vendor_time/60 AS tvt_mins,
    o.timings.at_vendor_time/60 AS avt_mins,
    o.timings.at_vendor_time_cleaned/60 AS avtc_mins,
    o.timings.to_customer_time/60 AS tct_mins,
    o.timings.promised_delivery_time/60 AS pdt_mins,
    o.timings.actual_delivery_time/60 AS adt_mins,
    o.timings.rider_late/60 AS rider_late_mins,
    o.cancellation.reason AS cancellation_reason,--LATE_DELIVERY
  --delivery level data
    d.id AS delivery_id, 
    d.delivery_status,
    date(d.created_at,o.timezone) AS delivery_date,
    d.rider_id,
    d.is_stacked_intravendor AS is_stacked,
    d.is_primary AS is_primary_delivery, 
    d.is_returning,
    d.is_redelivery,
    d.dropoff_distance_manhattan/1000 AS dropoff_distance_manhattan_km,
    d.delivery_distance/1000 AS delivery_distance_km,
    timestamp_diff(d.rider_dispatched_at,o.created_at,second)/60 AS rdt_mins,
    timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)/60 AS rat_mins,
    timestamp(datetime(d.rider_accepted_at,o.timezone)) AS rider_accepted_at,
    d.vehicle.vehicle_bag,
    d.vehicle.name AS vehicle_name,
    d.timings.to_vendor_time/60 AS d_tvt_mins,
    d.timings.at_vendor_time/60 AS d_avt_mins,
    d.timings.at_vendor_time_cleaned/60 AS d_avtc_mins,
    d.timings.to_customer_time/60 AS d_tct_mins,
    d.timings.actual_delivery_time/60 AS d_adt_mins,
  --transition level data  
    t.rider_id AS t_rider_id,
    timestamp(datetime(t.created_at,o.timezone)) AS transition_at,
    date(t.created_at,o.timezone) AS transition_date,
    t.undispatch_type,--filter manual_undispatch
    v.vendor_name,
    city,
    CASE WHEN date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 3  
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.8  
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 2.4
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.1
      WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.7 END AS scope_distance,
    CASE WHEN (CASE WHEN date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
                    WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 3  
                    WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.8  
                    WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 2.4
                    WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.1
                    WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.7 END 
                )>>=d.delivery_distance/1000 THEN TRUE
         ELSE FALSE END AS within_distance_scope,
    CASE WHEN d.timings.to_customer_time/60<<=8.5 THEN TRUE ELSE FALSE END AS within_tct_scope
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
  LEFT JOIN UNNEST(deliveries) d
  LEFT JOIN UNNEST(d.transitions) t
  LEFT JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
  WHERE o.created_date >>= '2025-04-27'
    AND o.entity.id = 'TB_AE'
    AND d.vehicle.name='tmart - Dedicated'
),
scope_filter AS 
(
SELECT 
  country_code,
  rider_id,
  order_id,
  platform_order_code,
  within_distance_scope,
  within_tct_scope,
FROM base
),
rider_shifts AS 
(--riders within 9 am-10 pm shifts
  SELECT DISTINCT
    date(shift_start_at,timezone) AS shift_date,
    rider_id,
    country_code,
    min(timestamp(datetime(actual_start_at,timezone))) AS shift_start,
    max(timestamp(datetime(actual_end_at,timezone))) AS shift_end
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
  WHERE 1=1
    AND created_date>>='2025-01-31'
    AND extract(hour from timestamp(datetime(shift_start_at,timezone)))>>=9
    AND time(datetime(shift_end_at,timezone)) <<= time '22:00:00'
    AND time(datetime(shift_end_at,timezone)) >>= time '09:00:00'
    AND country_code = 'ae'
    AND shift_state='EVALUATED'
    GROUP BY ALL
    ORDER BY 1,2,3
),
rider_manual_undispatch AS 
(
  SELECT
    b.country_code,
    transition_date,
    t_rider_id AS rider_id,
    vendor_code,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    count(DISTINCT CASE WHEN undispatch_type='manual_undispatch' THEN delivery_id END) AS manual_undispatch_count,
    count(DISTINCT CASE WHEN undispatch_type IS NOT NULL THEN delivery_id END) AS total_undispatch_count
  FROM base b
    INNER JOIN rider_shifts r ON r.rider_id=b.t_rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.transition_at  AND r.shift_end>>=b.transition_at
      GROUP BY ALL
),
all_orders AS 
(
  SELECT 
    b.country_code,
    b.rider_id,
    order_date,
    vendor_code,
    vendor_name,
    city,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    scope_distance,
    count(DISTINCT order_id) AS total_order_count,
    count(DISTINCT CASE WHEN is_primary_delivery AND delivery_status = 'completed' THEN order_id END) AS utr_order_count,
    count(DISTINCT CASE WHEN cancellation_reason='LATE_DELIVERY' THEN order_id END) AS late_delivery_cancellation_count
  FROM base b
    INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
      GROUP BY ALL
),
geofence AS (
SELECT
  country_code,
  delivery_id,
  timestamp_diff(rider_30m_to_pickup_at,rider_near_pickup_at,second)/60 as rider_150_30m,
  timestamp_diff(rider_picked_up_at,rider_30m_to_pickup_at,second)/60 as rider_30m_picked_up,
  timestamp_diff(rider_30m_to_pickup_exit_at,rider_picked_up_at,second)/60 as rider_picked_up_30m_exit,
  timestamp_diff(rider_150m_to_pickup_exit_at,rider_30m_to_pickup_exit_at,second)/60 as rider_30m_150m_exit
FROM `fulfillment-dwh-production.curated_data_shared.deliveries_geofence_timings` g
  WHERE created_date>>='2025-04-25'
    AND country_code='ae'
    AND entity_id='TB_AE'
    GROUP BY ALL
),
rider_delivery_data AS 
(
  SELECT DISTINCT
    b.country_code,
    b.rider_id,
    vendor_code,
    order_date,
    b.delivery_id,
    is_primary_delivery,
    is_stacked,
    within_distance_scope,
    within_tct_scope,
    order_id,
    platform_order_code,
    d_tvt_mins,
    d_avt_mins,
    d_avtc_mins,
    d_tct_mins,
    pdt_mins,
    d_adt_mins,
    rdt_mins,
    rat_mins,
    rider_150_30m,
    rider_30m_picked_up,
    rider_picked_up_30m_exit,
    rider_30m_150m_exit,
    rider_late_mins
  FROM base b 
    INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
    LEFT JOIN geofence g ON b.delivery_id=g.delivery_id AND b.country_code=g.country_code 
    WHERE order_status='completed'
      AND delivery_status='completed'
),
order_list AS 
(
SELECT DISTINCT
  b.country_code,
  b.rider_id,
  order_id,
  within_distance_scope,
    within_tct_scope,
  platform_order_code
FROM base b
  INNER JOIN rider_shifts r ON r.rider_id=b.rider_id AND r.country_code=b.country_code AND r.shift_start<<=b.rider_accepted_at  AND r.shift_end>>=b.rider_accepted_at
),
picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    lower(pickers.country_code) AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as total_prep_time,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
    INNER JOIN order_list o ON o.platform_order_code=cast(pickers.order_id AS string) AND o.country_code=lower(pickers.country_code)
  WHERE created_date>>='2025-04-27'
    AND global_entity_id = 'TB_AE'
),

rider_data AS --successful orders and deliveries
(
  SELECT 
    rd.country_code,
    rider_id,
    vendor_code,
    order_date,
    is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    count(delivery_id) AS delivery_count,
    count(DISTINCT rd.order_id) AS order_count,
    count(CASE WHEN is_stacked THEN delivery_id END) AS stacked_order_count,
    sum(rd.d_tvt_mins) AS tvt_mins,
    sum(rd.d_avt_mins) AS avt_mins,
    sum(rd.d_avtc_mins) AS avtc_mins,
    sum(rd.d_tct_mins) AS tct_mins,
    sum(rd.pdt_mins) AS pdt_mins,
    sum(rd.d_adt_mins) AS adt_mins,
    sum(rd.rdt_mins) AS rdt_mins, 
    sum(rd.rat_mins) AS rat_mins, 
    count(p.order_id) AS picking_order_count,
    sum(total_prep_time) AS total_prep_time,
    sum(store_dispatch_time) AS store_dispatch_time,
    sum(rider_150_30m) AS rider_150_30m,
    sum(rider_30m_picked_up) AS rider_30m_picked_up,
    sum(rider_picked_up_30m_exit) AS rider_picked_up_30m_exit,
    sum(rider_30m_150m_exit) AS rider_30m_150m_exit,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>10 THEN rd.delivery_id END) rider_late_10_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>5 THEN rd.delivery_id END) rider_late_6_10_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>2 THEN rd.delivery_id END) rider_late_3_5_mins,
    count(DISTINCT CASE WHEN rd.rider_late_mins>>0 THEN rd.delivery_id END) rider_late_0_2_mins
  FROM rider_delivery_data rd
    LEFT JOIN picking_data p ON rd.country_code=p.country_code AND rd.platform_order_code=cast(p.order_id AS string)
    GROUP BY ALL
),

utr_timings AS -- rider level data
(
  SELECT 
    delivery_date,
    ut.country_code,
    ut.rider_id,
    ut.vendor_code,
    ut.is_primary AS is_primary_delivery,
    within_distance_scope,
    within_tct_scope,
    sum(idle_time/60) as idle_time_mins,
    sum((reaction_time+to_vendor_time+at_vendor_time+to_customer_time+at_customer_time+idle_time)/60) as working_time_mins,
    count(delivery_id) AS delivery_count,
    count(DISTINCT ut.order_id) AS order_count,
  FROM `fulfillment-dwh-production.curated_data_shared.utr_timings`ut
    INNER JOIN (SELECT DISTINCT country_code, rider_id, vehicle_bag FROM base ) r ON r.country_code=ut.country_code AND r.rider_id=ut.rider_id AND r.vehicle_bag=ut.vehicle_bag
    INNER JOIN order_list o ON o.order_id=ut.order_id AND o.country_code=ut.country_code
    WHERE created_date>>='2025-04-27' 
      AND entity_id = 'TB_AE'
      GROUP BY ALL
),
utr_timings_2 AS
(
  SELECT
    delivery_date,
    country_code,
    rider_id,
    sum(idle_time_mins) AS idle_time_mins,
    sum(working_time_mins) AS working_time_mins,
    sum(delivery_count) AS delivery_count,
    sum(order_count) AS order_count
  FROM utr_timings
    GROUP BY ALL

),

tmart_targets AS -- these values are calculated according as p75th of every metric of January data (hardcoded to increase the efficiency of the query)
( 
SELECT 'AE' AS country_code,1.767 AS rider_tvt_perc,2.767 AS total_prep_time_perc,3.691 AS handover_time_perc,4.383 AS avt_perc,8.267 AS tct_perc,0.507 AS speed_perc
UNION ALL
SELECT 'BH' AS country_code,1.983 AS rider_tvt_perc,3.895 AS total_prep_time_perc,2.855 AS handover_time_perc,4.35 AS avt_perc,8.417 AS tct_perc,0.442 AS speed_perc
UNION ALL
SELECT 'OM' AS country_code,1.5 AS rider_tvt_perc,3.18 AS total_prep_time_perc,2.854 AS handover_time_perc,4.283 AS avt_perc,8.633 AS tct_perc,0.562 AS speed_perc
UNION ALL
SELECT 'EG' AS country_code,2.967 AS rider_tvt_perc,2.474 AS total_prep_time_perc,4.571 AS handover_time_perc,4.333 AS avt_perc,7.367 AS tct_perc,0.395 AS speed_perc
UNION ALL
SELECT 'QA' AS country_code,1.583 AS rider_tvt_perc,3.745 AS total_prep_time_perc,1.906 AS handover_time_perc,3.8 AS avt_perc,9.183 AS tct_perc,0.502 AS speed_perc
),
evaluated_shifts AS 
(
  SELECT 
      s.rider_id,
      date(s.actual_start_at,timezone) AS shift_date,
      country_code,
      count(DISTINCT shift_id) AS shift_count_d,
      count(shift_id) AS shift_count,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>0 THEN shift_id END) AS late_login,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>5 THEN shift_id END) AS late_login_5,
      count(DISTINCT CASE WHEN timestamp_diff(s.actual_start_at,s.shift_start_at,second)/60>>10 THEN shift_id END) AS late_login_10,
      sum(actual_working_time/60) AS actual_working_time_mins,
      sum(actual_break_time/60) AS actual_break_time_mins
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
  WHERE 1=1
    AND created_date>>='2025-01-31'
    AND extract(hour from timestamp(datetime(shift_start_at,timezone)))>>=9
    AND time(datetime(shift_end_at,timezone)) <<= time '22:00:00'
    AND time(datetime(shift_end_at,timezone)) >>= time '09:00:00'
    AND country_code = 'ae'
    AND created_date>>='2025-04-27'
    AND shift_state='EVALUATED'
    AND lower(vehicle_bag) LIKE ('%tmart - dedicated%')
      GROUP BY ALL
)

SELECT 
  current_timestamp() AS last_updated_at,
  o.rider_id,
  o.order_date,
  o.vendor_code,
  o.vendor_name,
  o.city,
  o.country_code,
  o.total_order_count,
  o.utr_order_count,
  o.late_delivery_cancellation_count,
  o.is_primary_delivery,
  o.within_distance_scope,
  o.within_tct_scope,
  o.scope_distance,
  rd.delivery_count AS successful_delivery_count,
  rd.order_count AS successful_order_count,
  rd.tvt_mins,
  rd.avt_mins,
  rd.avtc_mins,
  rd.tct_mins,
  rd.adt_mins,
  rd.pdt_mins,
  rd.rdt_mins,
  rd.rat_mins,
  rd.picking_order_count,
  rd.total_prep_time,
  rd.store_dispatch_time,
  rd.stacked_order_count,
  rd.rider_150_30m,
  rd.rider_30m_picked_up,
  rd.rider_picked_up_30m_exit,
  rd.rider_30m_150m_exit,
  rd.rider_late_10_mins,
  rd.rider_late_6_10_mins,
  rd.rider_late_3_5_mins,
  rd.rider_late_0_2_mins,
  ut.idle_time_mins,
  ut.working_time_mins,
  ut.delivery_count AS delivery_count_utr,
  ut.order_count AS order_count_utr,
  mu.manual_undispatch_count,
  mu.total_undispatch_count,
  s.actual_break_time_mins,
  s.actual_working_time_mins,
  s.late_login,
  s.late_login_5,
  s.late_login_10,
  s.shift_count,
  s.shift_count_d,
  utr2.idle_time_mins AS idle_time_mins_city_level,
  utr2.working_time_mins AS working_time_mins_city_level,
  utr2.delivery_count AS delivery_count_city_level_utr,
  utr2.order_count AS order_count_city_level_utr,
FROM all_orders o
  LEFT JOIN rider_data rd ON rd.country_code=o.country_code AND rd.vendor_code=o.vendor_code AND rd.order_date=o.order_date AND rd.rider_id=o.rider_id AND rd.is_primary_delivery=o.is_primary_delivery AND rd.within_tct_scope=o.within_tct_scope AND rd.within_distance_scope=o.within_distance_scope
  LEFT JOIN utr_timings ut ON ut.country_code=o.country_code AND ut.vendor_code=o.vendor_code AND ut.delivery_date=o.order_date AND ut.rider_id=o.rider_id AND ut.is_primary_delivery=o.is_primary_delivery AND ut.within_tct_scope=o.within_tct_scope AND ut.within_distance_scope=o.within_distance_scope 
  LEFT JOIN rider_manual_undispatch mu ON mu.country_code=o.country_code AND mu.vendor_code=o.vendor_code AND mu.transition_date=o.order_date AND mu.rider_id=o.rider_id AND mu.is_primary_delivery=o.is_primary_delivery AND mu.within_tct_scope=o.within_tct_scope AND mu.within_distance_scope=o.within_distance_scope
  LEFT JOIN evaluated_shifts s ON s.country_code=o.country_code AND s.rider_id=o.rider_id AND s.shift_date=o.order_date
  LEFT JOIN utr_timings_2 utr2 ON utr2.country_code=o.country_code AND utr2.rider_id=o.rider_id AND utr2.delivery_date=o.order_date
WHERE o.city IS NOT NULL
  AND o.order_date BETWEEN '2025-04-28' AND current_date()-1]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>last_updated_at</remote-name>
            <remote-type>7</remote-type>
            <local-name>[last_updated_at]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>last_updated_at</remote-alias>
            <local-type>datetime</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_008183DE16894BCA9CC1E9BB3D3C398C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>rider_id</remote-name>
            <remote-type>20</remote-type>
            <local-name>[rider_id]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>rider_id</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_008183DE16894BCA9CC1E9BB3D3C398C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>order_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[order_date]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>order_date</remote-alias>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_008183DE16894BCA9CC1E9BB3D3C398C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>vendor_code</remote-name>
            <remote-type>130</remote-type>
            <local-name>[vendor_code]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>vendor_code</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_008183DE16894BCA9CC1E9BB3D3C398C]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>vendor_name</remote-name>
            <remote-type>130</remote-type>
            <local-name>[vendor_name]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>vendor_name</remote-alias>
            <local-type>string</local-type>
