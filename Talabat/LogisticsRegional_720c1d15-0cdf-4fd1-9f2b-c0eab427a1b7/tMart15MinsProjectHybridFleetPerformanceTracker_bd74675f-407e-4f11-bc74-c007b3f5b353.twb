              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[Algo Tracker &amp; Hybrid Fleet Glo_A69977BC1DC94FC691EA52940ED61BCA]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
            </metadata-record>
            <metadata-record class='column'>
              <remote-name>Metric</remote-name>
              <remote-type>129</remote-type>
              <local-name>[Metric]</local-name>
