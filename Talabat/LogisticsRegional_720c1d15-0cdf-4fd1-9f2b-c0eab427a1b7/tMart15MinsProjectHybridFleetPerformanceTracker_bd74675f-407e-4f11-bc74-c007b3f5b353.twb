      <filter class='categorical' column='[federated.0avr2wf0840vne1h3pr0f1nszcwy].[none:vendor_name:nk]'>
        <groupfilter function='union' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[none:vendor_name:nk]' member='&quot;talabat mart , AD - Al Forsan&quot;' />
          <groupfilter function='member' level='[none:vendor_name:nk]' member='&quot;Talabat Mart , Al Hosn&quot;' />
          <groupfilter function='member' level='[none:vendor_name:nk]' member='&quot;talabat mart , Business Bay&quot;' />
          <groupfilter function='member' level='[none:vendor_name:nk]' member='&quot;Talabat Mart , Palm Jumeirah&quot;' />
          <groupfilter function='member' level='[none:vendor_name:nk]' member='&quot;Talabat Mart, Al Bahya - AD&quot;' />
