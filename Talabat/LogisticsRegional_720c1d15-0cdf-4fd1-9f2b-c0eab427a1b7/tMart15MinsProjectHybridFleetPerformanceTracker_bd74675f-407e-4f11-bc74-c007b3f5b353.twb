            </column>
            <column caption='UTR' datatype='real' name='[Calculation_2739666321418006528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Calculation_2739666321446645779])=&apos;Hybrid Fleet&apos; THEN &#10;(SUM(IF [within_distance_scope]=TRUE THEN [order_count] END )/&#10;SUM(IF [within_distance_scope]=TRUE THEN [working_time_mins]/60 END))&#10;ELSE SUM([regular_fleet_city_order_count])/sum([regular_fleet_city_working_time_mins]/60)&#10;END' />
            </column>
            <column caption='TVT' datatype='real' name='[Calculation_2739666321422409729]' role='measure' type='quantitative'>
