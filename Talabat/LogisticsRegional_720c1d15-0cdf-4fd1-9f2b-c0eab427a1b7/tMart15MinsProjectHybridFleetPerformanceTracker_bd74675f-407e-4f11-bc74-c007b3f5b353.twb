      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Hybrid Fleet Analysis' id='_3DD49AAB5C6D44D4873596134AA094DE'>
            <properties context=''>
              <relation connection='bigquery.1v53fa810ozazm1fdssfi11k0s28' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_info AS 
(
  SELECT 
      dvi.vendor_id,
      dvi.vendor_name,
      dvi.country_code,
      dli.city_name as city
    FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dli ON (dvi.location_id = dli.location_id)
    WHERE  dvi.country_code = 'AE' --IN ('AE','BH','EG','OM','QA')
      AND dvi.is_darkstore 
      AND dvi.vendor_id=dvi.parent_vendor_id
),

rider_shifts AS 
(--riders within 9 am-10 pm shifts
  SELECT DISTINCT
    date(shift_start_at,timezone) AS shift_date,
    rider_id,
    min(timestamp(datetime(actual_start_at,timezone))) AS shift_start,
    max(timestamp(datetime(actual_end_at,timezone))) AS shift_end
  FROM `fulfillment-dwh-production.curated_data_shared.shifts` s
  WHERE 1=1
    AND created_date>>='2025-01-31'
    AND extract(hour from timestamp(datetime(shift_start_at,timezone)))>>=9
    AND time(datetime(shift_end_at,timezone)) <<= time '22:00:00'
    AND time(datetime(shift_end_at,timezone)) >>= time '09:00:00'
    AND country_code = 'ae'
    AND shift_state='EVALUATED'
    GROUP BY ALL
    ORDER BY 1,2,3
),
base AS
(
  SELECT DISTINCT
    date(o.created_at,o.timezone) order_date,
    o.order_id,
    o.platform_order_code AS order_code,
    o.country_code,
    o.entity.id                                                         AS entity_id,
    o.city_id,
    o.vendor.vertical_type,
    o.vendor.vendor_code,
    d.is_stacked_intravendor                                            AS is_stacked,
    o.order_status,
    o.timings.actual_delivery_time/60    AS dt_mins,
    o.timings.promised_delivery_time/60  AS pdt_mins,
    o.timings.rider_late/60              AS rider_late_mins,
    o.timings.at_vendor_time/60          AS avt_mins,
    o.timings.at_vendor_time_cleaned/60  AS avtc_mins,
    o.timings.to_vendor_time/60          AS tvt_mins,
    o.timings.to_customer_time/60        AS tct_mins,
    d.pickup_distance_manhattan/1000  AS pu_dist_km,
    d.dropoff_distance_manhattan/1000 AS do_dist_km,
    timestamp_diff(d.rider_dispatched_at,o.created_at,second)/60        AS rdt_mins,
    timestamp_diff(d.rider_accepted_at,d.rider_dispatched_at,second)/60 AS rat_mins,
    d.delivery_distance/1000            AS delivery_distance,
    d.vehicle.vehicle_bag,
    vehicle.name AS vehicle_name,
    d.rider_id                          AS primary_rider_id,
    d.id AS delivery_id,
    rider_dispatched_at AS last_rider_dispatched_at,
    MIN(CASE WHEN t.state='dispatched' THEN t.created_at END) AS first_rider_dispatched_at,
    timestamp_diff(MIN(CASE WHEN t.state='dispatched' THEN t.created_at END),MIN(o.created_at),second)/60 AS rdt_first_mins,
    rider_accepted_at AS last_rider_accepted_at,
    v.vendor_name,
    v.city,
    CASE 
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 3  
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.8  
      WHEN v.city='Abu Dhabi' AND date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-19' THEN 2.4
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.1
      WHEN v.city='Dubai' AND date(o.created_at,o.timezone)<<='2025-05-05' THEN 3
      WHEN v.city='Ajman' AND date(o.created_at,o.timezone)>>='2025-06-25' THEN 2.8
      WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)>>'2025-05-05' THEN 2.7 
      WHEN v.city='Sharjah' AND date(o.created_at,o.timezone)<<='2025-05-05' THEN 3 END AS scope_distance
  FROM `fulfillment-dwh-production.curated_data_shared.orders` o
    LEFT JOIN UNNEST(deliveries) d
    LEFT JOIN unnest(d.transitions) t
    INNER JOIN vendor_info v ON cast(v.vendor_id as string)= o.vendor.vendor_code AND lower(v.country_code)=o.country_code
    INNER JOIN rider_shifts r ON r.rider_id=d.rider_id AND r.shift_start<<=timestamp(datetime(d.rider_accepted_at,d.timezone))  AND r.shift_end<<=timestamp(datetime(d.rider_dropped_off_at,d.timezone))
    WHERE created_date >>= '2025-01-31'
      AND o.country_code = 'ae'
      AND o.entity.brand_id in ("TB","TB_OT","HF")
      AND NOT o.is_preorder
      AND d.is_primary
      AND NOT d.is_returning
      AND NOT d.is_redelivery
      AND t.state ='dispatched'
      AND (lower(d.vehicle.vehicle_bag) LIKE '%bike%' OR lower(d.vehicle.vehicle_bag) LIKE '%tmart - dedicated%')
        GROUP BY ALL
),

dedicated_vendor_list AS 
(
SELECT DISTINCT 
  country_code,
  vendor_code
FROM base 
  WHERE lower(vehicle_bag) LIKE '%tmart - dedicated%'
    AND order_date>>='2025-04-28'
),

o AS 
(
  SELECT 
    b.*
  FROM base b
    INNER JOIN dedicated_vendor_list dvl ON b.country_code=dvl.country_code AND b.vendor_code=dvl.vendor_code
),

utr_timings_2 AS 
(

  SELECT 
    country_code,
    lower(city_name) AS city_name,
    rider_id,
    entity_id,
    date(rider_dropped_off_at,timezone) AS report_date,
    timestamp(datetime(u.rider_dropped_off_at,u.timezone)) AS dropped_off_at,
    idle_time/60 as idle_time_mins,
    (reaction_time+to_vendor_time+at_vendor_time+to_customer_time+at_customer_time+idle_time)/60 as working_time_mins,
    order_id,
    platform_order_code,
    vehicle_bag
  FROM `fulfillment-dwh-production.curated_data_shared.utr_timings` u 
    WHERE created_date>>= '2025-01-31'
      AND country_code='ae' 
      AND lower(city_name) IN ('dubai','abu dhabi','sharjah','ajman')
      AND date(rider_dropped_off_at,timezone)>>='2025-02-01'
),
utr_timings AS 
(
  SELECT 
    entity_id,
    country_code,
    city_name,
    order_id,
    platform_order_code,
    sum(idle_time_mins) as idle_time_mins,
    sum(working_time_mins) as working_time_mins,
  FROM utr_timings_2 
      GROUP BY ALL
),

city_utr AS 
(
  SELECT 
    country_code,
    city_name, 
    report_date,
    sum(idle_time_mins) AS idle_time_mins,
    sum(working_time_mins) AS working_time_mins,
    count(DISTINCT order_id) AS order_count,
    count(DISTINCT order_id)/(sum(working_time_mins)/60) AS utr,
    count(DISTINCT u.rider_id) AS rider_count
  FROM utr_timings_2 u
    INNER JOIN rider_shifts r ON u.report_date=r.shift_date AND u.rider_id=r.rider_id AND r.shift_start<<=u.dropped_off_at AND r.shift_end>>=u.dropped_off_at
    WHERE lower(vehicle_bag) LIKE '%bike%'
    GROUP BY ALL
    ORDER BY 2,3
),
geofence AS (
SELECT
  country_code,
  delivery_id,
  timestamp_diff(rider_30m_to_pickup_at,rider_near_pickup_at,second)/60 as rider_150_30m,
  timestamp_diff(rider_picked_up_at,rider_30m_to_pickup_at,second)/60 as rider_30m_picked_up,
  timestamp_diff(rider_30m_to_pickup_exit_at,rider_picked_up_at,second)/60 as rider_picked_up_30m_exit,
  timestamp_diff(rider_150m_to_pickup_exit_at,rider_30m_to_pickup_exit_at,second)/60 as rider_30m_150m_exit
FROM `fulfillment-dwh-production.curated_data_shared.deliveries_geofence_timings` g
  WHERE created_date>>='2025-01-31'
    AND country_code='ae'
    AND entity_id='TB_AE'
    GROUP BY ALL
),

tmart_targets AS 
( 
  SELECT 'AE' AS country_code,3 AS rider_tvt_perc,3 AS total_prep_time_perc,4.27 AS handover_time_perc,4.27 AS avt_perc,8.27 AS tct_perc,0.507 AS speed_perc
  UNION ALL
  SELECT 'BH' AS country_code,2.5 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.35 AS handover_time_perc,4.35 AS avt_perc,8.42 AS tct_perc,0.442 AS speed_perc
  UNION ALL
  SELECT 'OM' AS country_code,2.74 AS rider_tvt_perc,3.5 AS total_prep_time_perc,3.48 AS handover_time_perc,4.24 AS avt_perc,8.63 AS tct_perc,0.562 AS speed_perc
  UNION ALL
  SELECT 'EG' AS country_code,3 AS rider_tvt_perc,3 AS total_prep_time_perc,4.87 AS handover_time_perc,4.87 AS avt_perc,7.37 AS tct_perc,0.395 AS speed_perc
  UNION ALL
  SELECT 'QA' AS country_code,2.32 AS rider_tvt_perc,3.5 AS total_prep_time_perc,2.94 AS handover_time_perc,4.12 AS avt_perc,9.18 AS tct_perc,0.502 AS speed_perc
),

picking_data as 
(
  SELECT DISTINCT
    pickers.order_id,
    lower(country_code) AS country_code,
    (assignment_time_seconds + picking_time_seconds + packaging_time_seconds)/60 as total_prep_time,
    store_dispatch_time_seconds/60 AS store_dispatch_time
  FROM `tlb-data-prod.data_platform.fct_picker_order` as pickers
  WHERE created_date>>='2025-01-31'
    AND global_entity_id = 'TB_AE'
),
output AS 
(
SELECT  
  o.order_date,
  o.entity_id,
  UPPER(o.country_code) AS country_code,
  o.city,
  o.vendor_name,
  o.vertical_type,
  o.is_stacked,
  o.order_status,
  o.vehicle_bag,
  o.scope_distance,
  o.vehicle_name,
  CASE WHEN lower(o.vehicle_bag) LIKE '%tmart - dedicated%' AND scope_distance>>=do_dist_km THEN TRUE 
    WHEN lower(o.vehicle_bag) LIKE '%bike%' AND scope_distance>>=delivery_distance THEN TRUE 
  ELSE FALSE END AS within_distance_scope,
  CASE WHEN tct_mins<<=8.27 THEN TRUE ELSE FALSE END AS within_tct_scope,
  sum(o.dt_mins) AS dt_mins,
  sum(o.pdt_mins) AS pdt_mins,
  count( o.order_id) AS order_count_nd,
  count(DISTINCT o.order_id) AS order_count,
  count(DISTINCT CASE WHEN o.dt_mins<< 16 THEN o.order_code END) dt_15,
  count(DISTINCT CASE WHEN o.rider_late_mins>>10 THEN o.order_code END) rider_late_10_mins,
  count(DISTINCT CASE WHEN o.rider_late_mins>>5 THEN o.order_code END) rider_late_6_10_mins,
  count(DISTINCT CASE WHEN o.rider_late_mins>>3 THEN o.order_code END) rider_late_4_5_mins,
  count(DISTINCT CASE WHEN o.rider_late_mins>>2 THEN o.order_code END) rider_late_3_mins,
  count(DISTINCT CASE WHEN o.rider_late_mins>>1 THEN o.order_code END) rider_late_2_mins,
  count(DISTINCT CASE WHEN o.rider_late_mins>>0 THEN o.order_code END) rider_late_1_min,
  
  count(DISTINCT CASE WHEN (rdt_mins+rat_mins+tvt_mins)<<=tt.rider_tvt_perc THEN o.order_code END) rrv_compliant_order_count,
  count(DISTINCT CASE WHEN total_prep_time<<=tt.total_prep_time_perc THEN o.order_code END) prep_time_compliant_order_count,
  count(DISTINCT CASE WHEN avt_mins<<=tt.avt_perc THEN o.order_code END) avt_compliant_order_count,
  count(DISTINCT CASE WHEN tct_mins<<=tt.tct_perc THEN o.order_code END) tct_compliant_order_count,

  sum(avt_mins) AS avt_mins,
  sum(avtc_mins) AS avtc_mins,
  count(avtc_mins) AS avtc_mins_denom,
  sum(tvt_mins) AS tvt_mins,
  sum(tct_mins) AS tct_mins,
  sum(utr.idle_time_mins)  AS idle_time_mins,
  sum(utr.working_time_mins)  AS working_time_mins,
  sum(pu_dist_km) AS pu_dist_km,
  sum(do_dist_km) AS do_dist_km,
  sum(rdt_mins) AS rdt_mins,
  sum(rdt_first_mins) AS rdt_first_mins,
  sum(rat_mins) AS rat_mins,
  sum(rdt_mins+rat_mins+tvt_mins) AS rrv_mins,
  sum(p.total_prep_time) AS total_prep_time,
  sum(p.store_dispatch_time) AS store_dispatch_time,
  count(g.delivery_id) AS geofence_delivery_count,-- delete if equal to delivery or order count
  sum(rider_150_30m) AS rider_150_30m,
  sum(rider_30m_picked_up) AS rider_30m_picked_up,
  sum(rider_picked_up_30m_exit) AS rider_picked_up_30m_exit,
  sum(rider_30m_150m_exit) AS rider_30m_150m_exit
FROM o
  LEFT JOIN utr_timings utr ON o.country_code=utr.country_code AND o.entity_id=utr.entity_id AND o.order_code=utr.platform_order_code
  LEFT JOIN geofence g ON g.country_code=o.country_code AND g.delivery_id=o.delivery_id
  LEFT JOIN tmart_targets tt ON lower(tt.country_code)=o.country_code
  LEFT JOIN picking_data p ON p.country_code = o.country_code AND cast(p.order_id AS string) = o.order_code
  WHERE o.order_date BETWEEN '2025-02-01' AND (current_date()-1)
    GROUP BY ALL
),
hybrid_rider AS 
(
SELECT 
  city,
  vendor_name,
  order_date,
  count(DISTINCT primary_rider_id ) AS hybrid_rider_count
FROM o
  WHERE lower(vehicle_bag) LIKE '%tmart - dedicated%'
  GROUP BY ALL
)
SELECT 
  o.*,
  c.idle_time_mins AS regular_fleet_city_idle_time_mins,
  c.working_time_mins AS regular_fleet_city_working_time_mins,
  c.order_count AS regular_fleet_city_order_count,
  c.utr AS regular_fleet_city_utr,
  c.rider_count AS regular_fleet_city_rider_count,
  hr.hybrid_rider_count
FROM output o
  LEFT JOIN city_utr c ON lower(o.city)=c.city_name AND o.order_date=c.report_date
  LEFT JOIN hybrid_rider hr ON o.city=hr.city AND o.order_date=hr.order_date AND o.vendor_name=hr.vendor_name]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
