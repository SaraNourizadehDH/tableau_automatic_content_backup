            <column-instance column='[Calculation_8346929360591097864]' derivation='Sum' name='[sum:Calculation_8346929360591097864:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8346929360591323145]' derivation='Sum' name='[sum:Calculation_8346929360591323145:qk]' pivot='key' type='quantitative' />
