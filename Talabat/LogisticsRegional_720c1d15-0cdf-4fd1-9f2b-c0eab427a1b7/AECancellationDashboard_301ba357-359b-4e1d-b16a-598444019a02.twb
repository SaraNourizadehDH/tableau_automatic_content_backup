            <column-instance column='[Calculation_5967058432516104241]' derivation='None' name='[none:Calculation_5967058432516104241:nk]' pivot='key' type='nominal' />
            <column-instance column='[cancellation_reason]' derivation='None' name='[none:cancellation_reason:nk]' pivot='key' type='nominal' />
