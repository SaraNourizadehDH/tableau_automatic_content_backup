      <repository-location derived-from='http://ip-172-31-0-77:8504/t/Talabat/workbooks/AECancellationDashboard/Sheet1?rev=' id='Sheet1' path='/t/Talabat/workbooks/AECancellationDashboard' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.0k6787q1cgbxi81gfzxff0izf3wq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Break By Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
              <aliases>
                <alias key='&quot;city_name&quot;' value='City Name' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0k6787q1cgbxi81gfzxff0izf3wq'>
            <column caption='RIDER RELATED REASON FLAG' datatype='boolean' name='[Calculation_5967058432505679917]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cancellation_reason] IN &#10;    (&apos;LATE_DELIVERY&apos;,&#10;     &apos;NEVER_DELIVERED&apos;,&#10;     &apos;UNPROFESSIONAL_BEHAVIOUR&apos;,&#10;     &apos;FOOD_QUALITY_SPILLAGE&apos;,&#10;     &apos;COURIER_UNREACHABLE&apos;,&#10;     &apos;UNABLE_TO_FIND&apos;)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Break By Field' datatype='string' name='[Calculation_5967058432507940911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;None&apos; then &quot;&quot;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;city_name&apos; then [city_name]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Talabat Reason&apos; then [talabat_reason]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Global Reason&apos; then [cancellation_reason]&#10;END' />
            </column>
            <column caption='date agg.' datatype='date' name='[Calculation_8346929360590778375]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;day&apos; THEN DATE(DATETRUNC(&apos;day&apos;, [created_date]))&#10;    WHEN &apos;week&apos; THEN DATE(DATETRUNC(&apos;week&apos;, [created_date]))&#10;    WHEN &apos;month&apos; THEN DATE(DATETRUNC(&apos;month&apos;, [created_date]))&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='DAILY CITY ORDERS' datatype='real' name='[Calculation_8346929360591097864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [created_date],[city_name] : AVG([city_orders])}' />
            </column>
            <column caption='DAILY COUNTRY ORDERS' datatype='real' name='[Calculation_8346929360591323145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [created_date],[country_code] : SUM([Calculation_8346929360591097864])}' />
            </column>
            <column caption='CANCELLATION PERCENTAGE' datatype='real' name='[Calculation_8346929360591552522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / SUM([Calculation_8346929360591097864])' />
            </column>
            <column caption='Global Reason' datatype='string' name='[cancellation_reason]' role='dimension' type='nominal' />
            <column datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[city_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
