      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='rider level query' id='_7C73D2749EEF4890BA52EFB2525B7BC6'>
            <properties context=''>
              <relation connection='bigquery.0m7ntm717ayc2t1b9uxxs1pkja7u' name='Custom SQL Query1' type='text'>select
date_trunc(orders.created_date,month) as month,
orders.country_code,
cities.city_name,
primary_rider_id as rider_id,
count(distinct orders.order_id) total_orders,
count(distinct case when orders.cancellation_reason IN (&apos;LATE_DELIVERY&apos;,&apos;NEVER_DELIVERED&apos;,&apos;UNPROFESSIONAL_BEHAVIOUR&apos;,&apos;FOOD_QUALITY_SPILLAGE&apos;,&apos;COURIER_UNREACHABLE&apos;,&apos;UNABLE_TO_FIND&apos;)
then orders.order_id end) as rider_related_cancelled_orders,
count(distinct case when orders.cancellation_reason IN (&apos;LATE_DELIVERY&apos;,&apos;NEVER_DELIVERED&apos;,&apos;UNPROFESSIONAL_BEHAVIOUR&apos;,&apos;FOOD_QUALITY_SPILLAGE&apos;,&apos;COURIER_UNREACHABLE&apos;,&apos;UNABLE_TO_FIND&apos;) then orders.order_id end) / count(distinct orders.order_id) as rider_related_cancellation_percentage,
count(distinct case when (orders.vendor_order_status = &apos;cancelled&apos; OR orders.order_status = &apos;cancelled&apos;) then orders.order_id end) as total_cancelled_orders,
count(distinct case when (orders.vendor_order_status = &apos;cancelled&apos; OR orders.order_status = &apos;cancelled&apos;) then orders.order_id end) / count(distinct orders.order_id) as total_cancellation_percentage

from `tlb-data-prod.data_platform.fct_logistics_order` as orders

left join `tlb-data-prod.data_platform.dim_logistics_city` as cities
on cities.country_code = orders.country_code
and cities.city_id = orders.city_id

where 1=1
and created_date &gt;&gt;= &apos;2025-01-01&apos;
and is_talabat is true
and is_rider_order is true
and orders.country_code = &apos;ae&apos;
and orders.primary_rider_id IS NOT NULL

group by all
  
having 1=1
and count(distinct orders.order_id) &gt;&gt; 0


order by orders.primary_rider_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='_7C73D2749EEF4890BA52EFB2525B7BC6' table='[Extract].[_7C73D2749EEF4890BA52EFB2525B7BC6]' type='table' />
            </properties>
          </object>
          <object caption='order level query' id='_B81A3606C34441C487EC208C0156AD7F'>
            <properties context=''>
              <relation connection='bigquery.0m7ntm717ayc2t1b9uxxs1pkja7u' name='Custom SQL Query2' type='text'>select
date_trunc(orders.created_date,month) as month,
date_trunc(orders.created_date,week) as week,
orders.created_date,
orders.country_code,
cities.city_name,
orders.primary_rider_id as rider_id,
orders.order_id,
fct_order_info.gmv_amount_lc,
fct_order_info.gmv_amount_eur,
orders.order_status,
orders.vendor_order_status,
orders.cancellation_reason,
dim_order_fail_reason.talabat_reason,
orders.cancellation_owner,
fct_order_info.account_id as customer_acocunt_id,
fct_order_info.analytical_customer_id

from `tlb-data-prod.data_platform.fct_logistics_order` as orders

left join `tlb-data-prod.data_platform.fct_order_info` as fct_order_info
ON orders.order_id = fct_order_info.order_id
and lower(orders.country_code) = lower(fct_order_info.country_code)
and order_date &gt;&gt;= &apos;2025-07-01&apos;

LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`AS dim_order_fail_reason
ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id

left join `tlb-data-prod.data_platform.dim_logistics_city` as cities
on cities.country_code = orders.country_code
and cities.city_id = orders.city_id

where 1=1
and created_date &gt;&gt;= &apos;2025-07-01&apos;
and is_talabat is true
and is_rider_order is true
and orders.country_code = &apos;ae&apos;

and (orders.vendor_order_status = &apos;cancelled&apos; OR orders.order_status = &apos;cancelled&apos;)
and orders.cancellation_reason IN (&apos;LATE_DELIVERY&apos;,&apos;NEVER_DELIVERED&apos;,&apos;UNPROFESSIONAL_BEHAVIOUR&apos;,&apos;FOOD_QUALITY_SPILLAGE&apos;,&apos;COURIER_UNREACHABLE&apos;,&apos;UNABLE_TO_FIND&apos;)
and orders.primary_rider_id IS NOT NULL


order by orders.primary_rider_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='_B81A3606C34441C487EC208C0156AD7F' table='[Extract].[_B81A3606C34441C487EC208C0156AD7F]' type='table' />
            </properties>
          </object>
          <object caption='city level query' id='_CCFD186DF9C246A999C28B5146C8720C'>
            <properties context=''>
              <relation connection='bigquery.0m7ntm717ayc2t1b9uxxs1pkja7u' name='Custom SQL Query' type='text'>with orders_base_cte as (
select
date_trunc(orders.created_date,month) as month,
date_trunc(orders.created_date,week) as week,
orders.created_date,
orders.country_code,
cities.city_name,
orders.primary_rider_id as rider_id,
orders.order_id,
fct_order_info.gmv_amount_lc,
fct_order_info.gmv_amount_eur,
orders.order_status,
orders.vendor_order_status,
orders.cancellation_reason,
dim_order_fail_reason.talabat_reason,
fct_order_info.account_id as customer_acocunt_id,
fct_order_info.analytical_customer_id


from `tlb-data-prod.data_platform.fct_logistics_order` as orders

left join `tlb-data-prod.data_platform.fct_order_info` as fct_order_info
ON orders.order_id = fct_order_info.order_id
and lower(orders.country_code) = lower(fct_order_info.country_code)
and fct_order_info.order_date &gt;&gt;= &apos;2025-01-01&apos;

LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`AS dim_order_fail_reason
ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id

left join `tlb-data-prod.data_platform.dim_logistics_city` as cities
on cities.country_code = orders.country_code
and cities.city_id = orders.city_id

where 1=1
and orders.created_date &gt;&gt;= &apos;2025-01-01&apos;
and is_talabat is true
and is_rider_order is true
and orders.primary_rider_id IS NOT NULL
and orders.country_code = &apos;ae&apos;
),
----------------------------------------------------------------------------------------------------------------------
city_orders_cte as (
select
created_date,
country_code,
city_name,
count(distinct order_id) as city_orders

from orders_base_cte

group by all

)
----------------------------------------------------------------------------------------------------------------------
select 
orders_base_cte.month,
orders_base_cte.week,
orders_base_cte.created_date,
orders_base_cte.country_code,
orders_base_cte.city_name,
orders_base_cte.cancellation_reason,
orders_base_cte.talabat_reason,
count(distinct orders_base_cte.order_id) as cancelled_orders,
city_orders_cte.city_orders

from orders_base_cte

left join city_orders_cte
on city_orders_cte.created_date = orders_base_cte.created_date
and city_orders_cte.city_name = orders_base_cte.city_name

where 1=1
and orders_base_cte.cancellation_reason is not null

group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='_CCFD186DF9C246A999C28B5146C8720C' table='[Extract].[_CCFD186DF9C246A999C28B5146C8720C]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[month (Custom SQL Query1)]' />
                <expression op='[month (Custom SQL Query2)]' />
              </expression>
              <expression op='='>
                <expression op='[rider_id]' />
                <expression op='[rider_id (Custom SQL Query2)]' />
              </expression>
              <expression op='='>
                <expression op='[city_name (Custom SQL Query1)]' />
                <expression op='[city_name (Custom SQL Query2)]' />
              </expression>
            </expression>
            <first-end-point object-id='_7C73D2749EEF4890BA52EFB2525B7BC6' />
            <second-end-point object-id='_B81A3606C34441C487EC208C0156AD7F' />
          </relationship>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[city_name (Custom SQL Query1)]' />
                <expression op='[city_name]' />
              </expression>
              <expression op='='>
                <expression op='[month (Custom SQL Query1)]' />
                <expression op='[month]' />
              </expression>
            </expression>
            <first-end-point object-id='_7C73D2749EEF4890BA52EFB2525B7BC6' />
            <second-end-point object-id='_CCFD186DF9C246A999C28B5146C8720C' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
