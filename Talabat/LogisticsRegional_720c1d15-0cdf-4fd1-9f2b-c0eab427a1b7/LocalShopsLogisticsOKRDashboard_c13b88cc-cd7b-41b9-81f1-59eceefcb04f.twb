      <aliases enabled='yes' />
      <column caption=' Rider Idle Time% - City Level' datatype='real' name='[ Rider UTR - City Level (copy)_2904329214702284812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [country_iso], [city], [order_date]: MIN([idle_time_mins]/60)})&#10;/&#10;SUM({ FIXED [country_iso], [city], [order_date]: MIN([working_time_mins]/60)})' />
      </column>
      <column caption='# Pickers' datatype='integer' name='[ Rider UTR - City Level (copy)_2904329214874853441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [country_iso], [city], [order_date], [vendor_id]: MIN([picker_count])})' />
      </column>
      <column caption=' Rider UTR - City Level' datatype='real' name='[ Rider UTR ORDER (copy)_2904329214688964614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [country_iso], [city], [order_date]: MIN([utr_order_count])})&#10;/&#10;SUM({ FIXED [country_iso], [city], [order_date]: MIN([working_time_mins]/60)})' />
      </column>
      <column caption='% Orders on-time' datatype='real' name='[% Order Early &gt; 10 min (copy)_2626372694550171655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([on_time_orders])/sum([on_time_orders_denom])' />
      </column>
      <column caption='% Vendor Late v2 &gt; 15 min' datatype='real' default-format='p0.0%' name='[% Rider Late &gt; 15 min (copy)_4230287478091726868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_delayed_orders])/sum([vendor_delayed_orders_denom])' />
      </column>
      <column caption='% Manual splits' datatype='real' default-format='p0.0%' name='[% Split (copy)_4230287478077497350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mannual_split_orders])/sum([successful_orders])' />
      </column>
