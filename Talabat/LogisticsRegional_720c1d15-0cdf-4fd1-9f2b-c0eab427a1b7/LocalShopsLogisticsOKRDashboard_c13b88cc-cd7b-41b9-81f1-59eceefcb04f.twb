            <column caption='Avg EPT [min]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg DT [min]] (copy)_4230287478079401996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([EPT_sum])/sum([EPT_denom])' />
            </column>
            <column caption='Avg FIR [min] ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg EPT [min]] (copy)_4230287478079741965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FIR_sum])/sum([FIR_denom])' />
