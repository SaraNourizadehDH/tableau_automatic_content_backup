    <worksheet name='Vendor View'>
      <table>
        <view>
          <datasources>
            <datasource caption='LS OKR Dashboard' name='federated.1tlhirx0gs0lgc1264rkn1kdi8gf' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1tlhirx0gs0lgc1264rkn1kdi8gf'>
            <column caption=' Rider Idle Time% - City Level' datatype='real' name='[ Rider UTR - City Level (copy)_2904329214702284812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [country_iso], [city], [order_date]: MIN([idle_time_mins]/60)})&#10;/&#10;SUM({ FIXED [country_iso], [city], [order_date]: MIN([working_time_mins]/60)})' />
            </column>
            <column caption=' Rider UTR - City Level' datatype='real' name='[ Rider UTR ORDER (copy)_2904329214688964614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [country_iso], [city], [order_date]: MIN([utr_order_count])})&#10;/&#10;SUM({ FIXED [country_iso], [city], [order_date]: MIN([working_time_mins]/60)})' />
            </column>
            <column caption='% Orders on-time' datatype='real' name='[% Order Early &gt; 10 min (copy)_2626372694550171655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([on_time_orders])/sum([on_time_orders_denom])' />
            </column>
            <column caption='% Vendor Late v2 &gt; 15 min' datatype='real' default-format='p0.0%' name='[% Rider Late &gt; 15 min (copy)_4230287478091726868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_delayed_orders])/sum([vendor_delayed_orders_denom])' />
            </column>
            <column caption='% Manual splits' datatype='real' default-format='p0.0%' name='[% Split (copy)_4230287478077497350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mannual_split_orders])/sum([successful_orders])' />
            </column>
            <column caption='ABS [LC]' datatype='real' name='[ABS [Eur]] (copy)_2904329214711439379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([basket_amount_lc_sum])/SUM([basket_amount_lc_denom])' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[AVTC_denom]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[AVTC_sum]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[AsT_denom]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[AsT_sum]' role='dimension' type='ordinal' />
            <column caption='Avg AVTC v2 [min]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg AVTC [min]] (copy)_2904329214692544519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc_v2_sum])/sum([avtc_v2_denom])' />
            </column>
            <column caption='Avg AVT [min]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg AVTC [min]] (copy)_2904329214709932048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avt_sum])/sum([avt_denom])' />
            </column>
            <column caption='Avg Picking time [min]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Assignment time [min]] (copy)_4230287478081802256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([PiT_sum])/sum([PiT_denom])' />
            </column>
            <column caption='Avg Packing time [min]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Assignment time [min]] (copy)_4230287478081937425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([PaT_sum])/sum([PaT_denom])' />
            </column>
            <column caption='Avg RRV [min]  ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg DT [min]] (copy)_2904329214538129411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rrv_mins_sum])/sum([rrv_mins_denom])' />
