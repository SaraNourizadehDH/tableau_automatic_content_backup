            <column caption='Time Granularity' datatype='string' name='[Calculation_4230287478062964736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[vendor_delayed_orders Parameter] WHEN &apos;Day&apos; THEN str([order_date])&#10;WHEN &apos;Week - Monday&apos; THEN str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;)))+&quot;-W&quot;+str(week(DATE(DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;))))&#10;WHEN &apos;Week - Sunday&apos; THEN str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;week&apos;,[order_date],&apos;sunday&apos;)))+&quot;-W&quot;+str(week(DATE(DATETRUNC(&apos;week&apos;,[order_date],&apos;sunday&apos;))))&#10;WHEN &apos;Month&apos; THEN str(DATENAME(&apos;year&apos;,DATETRUNC(&apos;month&apos;,[order_date])))+&quot;-&quot;+STR(month(DATETRUNC(&apos;month&apos;,[order_date])))&#10;end' />
            </column>
            <column caption='% Net FR' datatype='real' default-format='p0.0%' name='[Calculation_4230287478063869953]' role='measure' type='quantitative'>
