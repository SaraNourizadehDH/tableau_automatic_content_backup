    <worksheet name='Shifts'>
      <table>
        <view>
          <datasources>
            <datasource caption='Riders Details' name='federated.175jur81v180tc19n15xe1xiijz2' />
          </datasources>
          <datasource-dependencies datasource='federated.175jur81v180tc19n15xe1xiijz2'>
            <column caption='Actual Shift End At Calc' datatype='datetime' name='[Actual Shift Start At Calc (copy)_1367124029813481473]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [new_shift_id], [shift_date]: max([actual_end_at]) }' />
            </column>
            <column caption='Shift Duration (Minutes)' datatype='integer' name='[Shift Duration (Minutes) (copy)_1367124029814239235]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [Shift Status (copy)_1367124029812916224], [Actual Shift Start At Calc (copy)_1367124029813481473])' />
            </column>
            <column caption='Shift Fraud' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Fraud (copy)_1367124029816233989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &lt; 240 or&#13;&#10;[Shift Duration (Minutes) (copy)_1367124029814239235] &gt; 720&#13;&#10;then 1 else 0 end' />
            </column>
            <column caption='Shift Normal' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Normal (copy)_1367124029815885828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &gt;= 240 or&#13;&#10;[Shift Duration (Minutes) (copy)_1367124029814239235] &lt;= 720&#13;&#10;then 1 else 0 end' />
            </column>
            <column caption='Actual Shift Start At Calc' datatype='datetime' name='[Shift Status (copy)_1367124029812916224]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [new_shift_id], [shift_date]: min([actual_start_at]) }' />
            </column>
            <column caption='Total Fraud Shift' datatype='integer' name='[Total Normal Shift (copy)_929711915400544262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [shift_fraud] = 1 then 1 else 0 end' />
            </column>
            <column caption='Total Fraud Shift Count' datatype='integer' name='[Total Normal Shift Count (copy)_929711915400679431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [shift_id], [shift_date]: COUNTD(IF [Total Normal Shift (copy)_929711915400544262] = 1 THEN [shift_id] END) }' />
            </column>
            <column caption='Total Normal Shift Count' datatype='integer' name='[Total Selfie False Count (copy)_929711915400069125]' role='measure' type='quantitative'>
