      <aliases enabled='yes' />
      <column caption='% Riders No Selfie' datatype='real' default-format='p0.00%' name='[% Riders Selfie (copy)_994451140925116424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Riders with Selfie (copy)_1795528924938940417]) / COUNTD([rider_id])' />
      </column>
      <column caption='%Riders Shift &gt; 12' datatype='real' default-format='p0.00%' name='[%Riders Shift &gt; 10  (copy)_1565563872280473604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Riders Count Shift &gt; 10 Hours (copy)_994451140920877060])/COUNTD([rider_id])' />
      </column>
      <column caption='Actual Shift End At Calc' datatype='datetime' name='[Actual Shift Start At Calc (copy)_1367124029813481473]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [rider_id], [new_shift_id], [shift_date]: max([actual_end_at]) }' />
      </column>
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_1565563872283062277])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Shift Duration Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1565563872262553603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Shift Daily Duration (Minutes)  (copy)_929711915418755082]/60' />
      </column>
      <column caption='No Selfies per Month' datatype='integer' name='[Calculation_1565563872283062277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if COUNTD([Riders with Selfie (copy)_1795528924938940417]) &gt;= 1 and COUNTD([Riders Count with Selfie (copy)_1795528924938706944]) = 0 then 1 else 0 end' />
      </column>
      <column caption='Avg Shifts per Rider' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_994451140914393089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([new_shift_id]) / COUNTD([rider_id])' />
      </column>
      <column aggregation='Sum' caption='Riders Count Shift &gt; 10 Hours' datatype='integer' name='[Calculation_994451140917362690]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &gt; 600 then [rider_id] end' />
      </column>
      <column caption='%Riders Shift &gt; 10 ' datatype='real' default-format='p0.00%' name='[Calculation_994451140918685699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_994451140917362690])/COUNTD([rider_id])' />
      </column>
      <column caption='Total Selfie True' datatype='integer' name='[Calculation_994451140923240453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [selfie_true] = 1 then 1 else 0 end' />
      </column>
      <column caption='% Riders Selfie' datatype='real' default-format='p0.00%' name='[Calculation_994451140923953158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Riders Count with Selfie (copy)_1795528924938706944]) / COUNTD([rider_id])' />
      </column>
      <column caption='Fraud Break &gt; 4' datatype='integer' name='[Calculation_994451140926578698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [fraud_break] &gt; 4 then 1 else 0 end' />
      </column>
      <column caption='normal_break &gt; 0' datatype='integer' name='[Calculation_994451140927483915]' role='measure' type='quantitative'>
