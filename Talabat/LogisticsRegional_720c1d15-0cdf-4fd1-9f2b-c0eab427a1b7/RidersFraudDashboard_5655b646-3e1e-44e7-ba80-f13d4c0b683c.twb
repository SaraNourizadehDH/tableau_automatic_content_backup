      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/RidersFraudDashboard/RidersAccumulatedShifts?rev=' id='RidersAccumulatedShifts' path='/t/Talabat/workbooks/RidersFraudDashboard' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Riders Details' name='federated.175jur81v180tc19n15xe1xiijz2' />
