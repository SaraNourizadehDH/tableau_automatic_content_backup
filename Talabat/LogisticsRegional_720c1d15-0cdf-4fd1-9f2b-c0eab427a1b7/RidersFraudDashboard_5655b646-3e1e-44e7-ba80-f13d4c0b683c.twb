else case when break_duration_minutes between 3 and 5 then '(3 - 5) minutes'
else case when break_duration_minutes between 5 and 10 then '(5 - 10) minutes'
else case when break_duration_minutes between 10 and 15 then '(10 - 15) minutes'
else case when break_duration_minutes between 15 and 30 then '(15 - 30) minutes'
else case when break_duration_minutes between 30 and 60 then '(30 - 60) minutes'
