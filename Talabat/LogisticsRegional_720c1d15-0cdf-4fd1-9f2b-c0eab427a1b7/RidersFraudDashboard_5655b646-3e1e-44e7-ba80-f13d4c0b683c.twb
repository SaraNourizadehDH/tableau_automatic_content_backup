            </column>
            <column caption='Actual Shift Start At Calc' datatype='datetime' name='[Shift Status (copy)_1367124029812916224]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [new_shift_id], [shift_date]: min([actual_start_at]) }' />
            </column>
            <column caption='Total Earning (Country Currency)' datatype='integer' name='[Total Earning (copy)_1949495753113223168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(int([total_earning]), 0)' />
            </column>
            <column caption='Total Earning Max' datatype='real' name='[Total Earning (copy)_929711915388362754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [rider_name], [shift_id], [shift_date]: max(IFNULL([total_earning], 0)) }' />
            </column>
            <column caption='Total Selfie False Count' datatype='integer' name='[Total Selfie False (copy)_929711915386556417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Total Selfie True (copy)_929711915385106432] &gt;= 1 then 0 else&#13;&#10;{ FIXED [rider_id], [new_shift_id], [shift_date]: Max([Riders with Selfie (copy)_994451140924387335]) }&#13;&#10;end' />
            </column>
            <column caption='Total Earnings Total' datatype='real' name='[Total Selfie False (copy)_929711915389882371]' role='measure' type='quantitative'>
