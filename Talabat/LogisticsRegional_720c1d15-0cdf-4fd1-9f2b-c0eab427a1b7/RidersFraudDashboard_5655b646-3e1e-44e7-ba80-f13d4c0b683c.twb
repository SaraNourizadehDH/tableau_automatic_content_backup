d.created_date,
STRING_AGG(DISTINCT d.app_info.version ORDER BY d.app_info.version ASC) AS version, -- Aggregating unique versions
STRING_AGG(DISTINCT d.app_info.id ORDER BY d.app_info.id ASC) AS app_id, -- Aggregating unique app IDs
STRING_AGG(DISTINCT d.app_info.install_source ORDER BY d.app_info.install_source ASC) AS install_source -- Aggregating unique install sources
FROM
`fulfillment-dwh-production.curated_data_shared.rider_devices` d
WHERE
d.created_date >>= current_date() - 15
GROUP BY
d.rider_id, d.country_code, d.created_date
) apps
on apps.created_date = breaks.shift_date
and apps.country_code = breaks.country_code
and apps.rider_id = breaks.rider_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
