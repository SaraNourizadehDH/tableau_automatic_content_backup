      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-aliased-fields='true' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:break_group:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;(1 - 3) minutes&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;(15 - 30) minutes&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;(10 - 15) minutes&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Less than 1 minute&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;(5 - 10) minutes&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;(30 - 60) minutes&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;(3 - 5) minutes&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;More than 1 Hour&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_39694916862447A4A09406EC4C249322'>
            <properties context=''>
              <relation connection='bigquery.1v005z11amqosq11s0u9e19uc7zz' name='Custom SQL Query' type='text'><![CDATA[select breaks.*,
total_earning,
case when break_duration_minutes << 1 then 'fraud_break' else 'normal_break' end as break_status,
case when break_duration_minutes << 1 then 'Less than 1 minute'
else case when break_duration_minutes between 1 and 3 then '(1 - 3) minutes'
else case when break_duration_minutes between 3 and 5 then '(3 - 5) minutes'
else case when break_duration_minutes between 5 and 10 then '(5 - 10) minutes'
else case when break_duration_minutes between 10 and 15 then '(10 - 15) minutes'
else case when break_duration_minutes between 15 and 30 then '(15 - 30) minutes'
else case when break_duration_minutes between 30 and 60 then '(30 - 60) minutes'
else case when break_duration_minutes >> 60 then 'More than 1 Hour'
end end end end end end end end as break_group,
violation_type,
violation_count,
install_source,
app_id,
version
from
(
SELECT
  b.shift_id,
  b.rider_id,
  rider_name,
  b.country_code,
  b.created_date AS shift_date,
  break_type,
  break_reason,
  break_performed_by,
  break_start_at,
  break_end_at,
    TIMESTAMP_DIFF(
    TIMESTAMP(break_end_at), 
    TIMESTAMP(break_start_at), 
    MINUTE
  ) as break_duration_minutes
  FROM
`tlb-data-prod.data_platform.fct_logistics_rider_break` b
inner join `tlb-data-prod.data_platform.dim_logistics_rider` riders
on
riders.rider_id = b.rider_id
where created_date >>= current_date() - 15
) breaks
left join
(
 SELECT country_code, created_date, rider_id, shift_id,
sum(total) as total_earning
FROM `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` 
WHERE created_date >>= current_date() - 15
and shift_id is not null
group by 1,2,3,4
order by 1,2,5
) earnings
on earnings.rider_id = breaks.rider_id
and earnings.country_code = breaks.country_code
and earnings.created_date = breaks.shift_date
and earnings.shift_id = breaks.shift_id

left join
(
SELECT
rider_id,
country_code,
created_date,
rule.violation_type violation_type,
COUNT(*) AS violation_count
FROM
`fulfillment-dwh-production.curated_data_shared.rider_compliance`, UNNEST(violations) AS violation, UNNEST(violation.rules) AS rule
WHERE
--AND rule.rule_name = 'Evgenii Sokolov Test' -- Replace with the rule name you are interested in
date(violation.created_at) >>= current_date() - 15
GROUP BY
rider_id, country_code, created_date, violation_type
) riders_violations
on riders_violations.created_date = breaks.shift_date
and riders_violations.country_code = breaks.country_code
and riders_violations.rider_id = breaks.rider_id

left join
(
  SELECT
d.rider_id,
d.country_code,
d.created_date,
STRING_AGG(DISTINCT d.app_info.version ORDER BY d.app_info.version ASC) AS version, -- Aggregating unique versions
STRING_AGG(DISTINCT d.app_info.id ORDER BY d.app_info.id ASC) AS app_id, -- Aggregating unique app IDs
STRING_AGG(DISTINCT d.app_info.install_source ORDER BY d.app_info.install_source ASC) AS install_source -- Aggregating unique install sources
FROM
`fulfillment-dwh-production.curated_data_shared.rider_devices` d
WHERE
d.created_date >>= current_date() - 15
GROUP BY
d.rider_id, d.country_code, d.created_date
) apps
on apps.created_date = breaks.shift_date
and apps.country_code = breaks.country_code
and apps.rider_id = breaks.rider_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
