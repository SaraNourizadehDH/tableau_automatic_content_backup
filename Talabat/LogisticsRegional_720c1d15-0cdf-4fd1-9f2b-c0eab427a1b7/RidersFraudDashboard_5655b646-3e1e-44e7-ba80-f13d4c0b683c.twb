          <datasource-dependencies datasource='federated.175jur81v180tc19n15xe1xiijz2'>
            <column caption='Actual Shift End At Calc' datatype='datetime' name='[Actual Shift Start At Calc (copy)_1367124029813481473]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [new_shift_id], [shift_date]: max([actual_end_at]) }' />
            </column>
            <column caption='Shift Duration Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1565563872262553603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Shift Daily Duration (Minutes)  (copy)_929711915418755082]/60' />
            </column>
            <column caption='Total Selfie True' datatype='integer' name='[Calculation_994451140923240453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [selfie_true] = 1 then 1 else 0 end' />
            </column>
            <column caption='Delivery Count Max' datatype='integer' default-format='n#,##0;-#,##0' name='[Delivery Count (copy)_929711915407319048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [rider_name], [shift_id], [shift_date]: max([delivery_count]) }' />
            </column>
            <column caption='Total Selfie False' datatype='integer' name='[Riders with Selfie (copy)_994451140924387335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Selfie False Total (copy)_2039286273865007104] = 1 then 1 else 0 end' />
            </column>
            <column caption='Selfie False Total 2' datatype='integer' default-format='n#,##0;-#,##0' name='[Selfie False Total (copy)_2039286273865007104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [selfie_true] = 1 then 0 else 1 end' />
            </column>
            <column caption='Shift Daily Duration (Minutes)  Max' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Daily Duration (Minutes)  (copy)_929711915418755082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [rider_id], [rider_name], [shift_id], [shift_date]: max([shift_duration_minutes]) }' />
            </column>
            <column caption='Shift Duration (Minutes)' datatype='integer' name='[Shift Duration (Minutes) (copy)_1367124029814239235]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [Shift Status (copy)_1367124029812916224], [Actual Shift Start At Calc (copy)_1367124029813481473])' />
            </column>
            <column caption='Shift Fraud' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Fraud (copy)_1367124029816233989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &lt; 240 or&#13;&#10;[Shift Duration (Minutes) (copy)_1367124029814239235] &gt; 720&#13;&#10;then 1 else 0 end' />
            </column>
            <column caption='Shift Normal' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Normal (copy)_1367124029815885828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &gt;= 240 or&#13;&#10;[Shift Duration (Minutes) (copy)_1367124029814239235] &lt;= 720&#13;&#10;then 1 else 0 end' />
            </column>
            <column caption='Shift Start At (Grouped)' datatype='datetime' datatype-customized='true' name='[Shift Start At (copy)_1565563872256667648]' role='dimension' type='ordinal'>
