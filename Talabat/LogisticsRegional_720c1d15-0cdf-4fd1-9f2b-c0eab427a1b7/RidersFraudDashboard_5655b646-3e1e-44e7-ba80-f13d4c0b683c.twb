date(violation.created_at) >>= current_date() - 15
GROUP BY
rider_id, country_code, created_date, violation_type
) riders_violations
on riders_violations.created_date = breaks.shift_date
and riders_violations.country_code = breaks.country_code
and riders_violations.rider_id = breaks.rider_id

left join
