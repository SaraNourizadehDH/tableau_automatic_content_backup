            <column caption='Shift Duration (Minutes)' datatype='integer' name='[Shift Duration (Minutes) (copy)_1367124029814239235]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [Shift Status (copy)_1367124029812916224], [Actual Shift Start At Calc (copy)_1367124029813481473])' />
            </column>
            <column caption='Shift Fraud' datatype='integer' default-format='n#,##0;-#,##0' name='[Shift Fraud (copy)_1367124029816233989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Shift Duration (Minutes) (copy)_1367124029814239235] &lt; 240 or&#13;&#10;[Shift Duration (Minutes) (copy)_1367124029814239235] &gt; 720&#13;&#10;then 1 else 0 end' />
