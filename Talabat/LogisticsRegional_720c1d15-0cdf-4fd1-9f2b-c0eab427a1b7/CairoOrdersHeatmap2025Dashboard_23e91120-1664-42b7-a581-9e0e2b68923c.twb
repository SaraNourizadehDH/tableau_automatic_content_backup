        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1bgy3xc0txutis15n7htp1uy133r' name='Custom SQL Query' type='text'><![CDATA[with orders as (
SELECT 
EXTRACT(MONTH FROM order_date) AS order_month,
city_name,
area_name,
area_lat,
area_long,
area_polygon,
order_id

FROM `tlb-data-prod.data_platform.fct_order_info` fct_order

INNER JOIN `tlb-data-prod.data_platform.dim_location_info` dim_location_info 
ON dim_location_info.location_id = fct_order.delivery_location_id 
where fct_order.country_code = 'EG'
and order_date >>= '2025-01-01'
and dim_location_info.is_active_area = true 
),

agg as 
(
select 
order_month,
area_name,
count(distinct order_id) as total_orders
from
orders 
group by all 
)

select distinct
o.order_month,
city_name,
o.area_name,
area_lat,
area_long,
area_polygon,
total_orders,
CASE
    
    WHEN total_orders <<= 100 THEN '0-100'
    WHEN total_orders between 101 and 200 THEN '100-200'
    WHEN total_orders between 201 and 300 THEN '200-300'
    WHEN total_orders between 301 and 400 THEN '300-400'
    WHEN total_orders between 401 and 500 THEN '400-500'
    WHEN total_orders between 501 and 1000 THEN '100-200'
    WHEN total_orders between 1001 and 1500 THEN '1000-1500'
    WHEN total_orders between 1501 and 2000 THEN '1500-2000'
    WHEN total_orders between 2001 and 3000 THEN '2000-3000'
    WHEN total_orders between 3001 and 4000 THEN '3000-4000'
    WHEN total_orders between 4001 and 5000 THEN '4000-5000'
    WHEN total_orders between 5001 and 10000 THEN '5000-10000'
    WHEN total_orders between 10001 and 15000 THEN '10000-15000'
    WHEN total_orders between 15001 and 20000 THEN '15000-20000'
    WHEN total_orders between 20001 and 50000 THEN '20000-50000'
    WHEN total_orders between 50001 and 100000 THEN '50000-100000'
    ELSE '100K+'
  END AS orders_bin
from orders o
left join agg a on o.area_name = a.area_name and o.order_month = a.order_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
