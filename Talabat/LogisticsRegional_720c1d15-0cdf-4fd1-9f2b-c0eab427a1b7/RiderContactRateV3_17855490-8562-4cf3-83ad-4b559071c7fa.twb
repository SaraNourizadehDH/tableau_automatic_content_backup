        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1dlpuck1ithich18oprzr1lgiqt0' name='Custom SQL Query' type='text'>SELECT  
gc.* except (agent_email,agent_id,net_gross_orders,net_completed_orders,completed_orders)
FROM `tlb-data-prod.data_platform.agg_logistics_rider_contact` gc
where created_date between DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1dlpuck1ithich18oprzr1lgiqt0' name='Custom SQL Query' type='text'>SELECT  
