      <aliases enabled='yes' />
      <column caption='Calculation3' datatype='string' name='[Calculation_2828260591300411392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Glossary&quot;' />
      </column>
      <column caption='RCR%' datatype='real' name='[Calculation_5239164131308990464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contact_count])/SUM([Calculation_5239164132213100551])' />
      </column>
      <column caption='Calculation1' datatype='real' hidden='true' name='[Calculation_5239164131309346817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[contact_count]/[gross_orders]' />
      </column>
      <column caption='Satisfied survey' datatype='integer' name='[Calculation_5239164132207067139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [csat_score] when 4 then 1&#10;WHEN 5 then 1 &#10;ELSE 0 end' />
      </column>
      <column caption='total survey' datatype='integer' name='[Calculation_5239164132208156676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([csat_score]) then 0 ELSE 1 END' />
      </column>
      <column caption='RSAT%' datatype='real' name='[Calculation_5239164132208807941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5239164132207067139])/SUM([Calculation_5239164132208156676])' />
      </column>
      <column caption='gross fixed' datatype='integer' hidden='true' name='[Calculation_5239164132212260870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_date],[country_code],[city_name],[contract_name],[bpo_name] : SUM([gross_orders])}' />
      </column>
      <column caption='gross orders' datatype='integer' name='[Calculation_5239164132213100551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [contact_reason_l2],[contact_reason_l3],[local_contact_reason]:SUM([gross_orders])}' />
      </column>
      <column caption='Calculation4' datatype='string' hidden='true' name='[Calculation_5689312992334979073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;RCR%&#10;&#10;FCR%&#10;&#10;RSAT%&quot;' />
      </column>
      <column caption='fcr orders' datatype='integer' name='[Calculation_6191112503509852160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_fcr] then 1 else 0 end' />
      </column>
      <column caption='FCR%' datatype='real' name='[Calculation_6191112503509995521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6191112503509852160])/SUM([order_count])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_6191112505937952770]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[created_date]))' />
      </column>
      <column caption='Contact Reason' datatype='string' hidden='true' name='[Calculation_6191112506063818756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;&#10;WHEN  &quot;Contact Reason L2&quot; then [contact_reason_l2]&#10;WHEN  &quot;Contact Reason L3&quot; then [contact_reason_l3]&#10;WHEN  &quot;Contact Reason Local&quot; THEN [local_contact_reason]&#10;END' />
      </column>
      <column caption='Calculation2' datatype='integer' hidden='true' name='[Calculation_6191112506107469829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5239164131308990464]&gt;0 then 1 else 0 end' />
      </column>
      <column caption='# gross orders' datatype='integer' hidden='true' name='[Calculation_6191112506110459911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [contact_reason_l2],[contact_reason_l3],[local_contact_reason]:SUM(&#10;&#10;{ FIXED [country_code],[zone_name],[city_name],[rider_id],[created_date],[bpo_name]:sum([gross_orders])})}' />
      </column>
      <column caption='null reason' datatype='boolean' hidden='true' name='[Calculation_6191112506128535560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([contact_reason_l2])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_91338654793265153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3] &#10;WHEN &quot;RCR%&quot; then [Calculation_5239164131308990464]&#10;WHEN &quot;FCR%&quot; then [Calculation_6191112503509995521]&#10;when &quot;RSAT%&quot; THEN [Calculation_5239164132208807941]&#10;END' />
      </column>
      <column caption='metric name' datatype='string' name='[Calculation_91338654795366403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3] &#10;WHEN &quot;RCR%&quot; then &quot;RCR%&quot;&#10;WHEN &quot;FCR%&quot; then &quot;FCR%&quot;&#10;when &quot;RSAT%&quot; THEN &quot;RSAT%&quot;&#10;END' />
      </column>
      <column caption='null csat' datatype='boolean' name='[Calculation_91338654937751562]' role='dimension' type='nominal'>
