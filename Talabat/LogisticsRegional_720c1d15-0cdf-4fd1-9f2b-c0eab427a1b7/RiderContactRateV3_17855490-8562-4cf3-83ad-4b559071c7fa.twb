    <worksheet name='country view'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.19f5rkj1k959pk1dbmwan084wo7a' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Chose Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RCR\%&quot;'>
              <calculation class='tableau' formula='&quot;RCR%&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19f5rkj1k959pk1dbmwan084wo7a'>
            <column caption='RCR%' datatype='real' name='[Calculation_5239164131308990464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contact_count])/SUM([Calculation_5239164132213100551])' />
            </column>
            <column caption='Satisfied survey' datatype='integer' name='[Calculation_5239164132207067139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [csat_score] when 4 then 1&#10;WHEN 5 then 1 &#10;ELSE 0 end' />
            </column>
            <column caption='total survey' datatype='integer' name='[Calculation_5239164132208156676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([csat_score]) then 0 ELSE 1 END' />
            </column>
            <column caption='RSAT%' datatype='real' name='[Calculation_5239164132208807941]' role='measure' type='quantitative'>
