    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.19f5rkj1k959pk1dbmwan084wo7a' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1dlpuck1ithich18oprzr1lgiqt0'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ezeftawy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
