    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary '>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/RiderContactRateV3/Glossary?rev=' id='Glossary' path='/t/Talabat/workbooks/RiderContactRateV3' revision='' site='Talabat' />
      <style />
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='3' name='Sheet 20' show-title='false' w='98400' x='800' y='800'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='58600' id='5' type-v2='text' w='97300' x='1300' y='29600'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>This comprehensive dashboard focuses on three key metrics: Rider Contact Rate (RCR%), First Contact Resolution (FCR%), and Rider Satisfaction (RSAT%).</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14' underline='true'>Metrics Definitions</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Rider Contact Rate (RCR%):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The percentage of Rider Contacts, calculated by dividing the total number of contacts by the gross number of orders.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>RCR% = (Total Contacts / Gross Orders) * 100</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>First Contact Resolution (FCR%):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The percentage of orders that were resolved with only one contact, calculated by dividing the number of FCR (First Contact Resolution) orders by the total number of chats related to orders.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>FCR% = (FCR Orders / Total Order-related Chats) * 100</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Rider Satisfaction (RSAT%):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The percentage of surveys with scores 4 and 5 over all survey responses, indicating rider satisfaction.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>RSAT% = (Satisfied Surveys / Total Surveys) * 100</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14' underline='true'>Dimensions Definitions</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Contact Count: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The total number of chats that occurred within the specified timeframe.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Contacted Orders: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The total number of chats specifically related to an order.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>FCR Order: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The total number of orders that were successfully resolved with just one contact.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Satisfied Surveys: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The total number of surveys where respondents provided scores of 4 or 5, indicating high satisfaction.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Total Surveys: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The overall number of survey responses received.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>BPO Name: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The name of the company for which the agent works (Business Process Outsourcing).</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Chat Language: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>The language used in the chat conversation.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='3700' id='23' type-v2='text' w='48700' x='2200' y='6800'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Before using the dashboard</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>:</run>
          </formatted-text>
        </zone>
        <zone h='19300' id='24' is-scaled='1' param='Image/Screen Shot 2023-11-23 at 4.21.25 PM.png' type-v2='bitmap' w='27000' x='57400' y='5500' />
        <zone forceUpdate='true' h='8300' id='25' type-v2='text' w='48700' x='5400' y='12300'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>- Chose the needed metric (</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>RCR%, FCR%, RSAT%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>).</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>- Chose the Granularity level (</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Month, Week, Day</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>)</run>
          </formatted-text>
        </zone>
