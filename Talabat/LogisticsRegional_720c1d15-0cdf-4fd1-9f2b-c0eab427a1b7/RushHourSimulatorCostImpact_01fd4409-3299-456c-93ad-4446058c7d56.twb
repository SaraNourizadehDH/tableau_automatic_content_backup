    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.06s2ud51jhfxc51fu7wyh10h88rc' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1456cgv0vhatys164i82k116nxgp'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='server-custom' username='siddhant.farwaha@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
