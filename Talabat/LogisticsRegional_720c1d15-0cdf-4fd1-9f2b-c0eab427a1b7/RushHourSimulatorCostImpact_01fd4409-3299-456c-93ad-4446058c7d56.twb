      <aliases enabled='yes' />
      <column caption='Dynamic Column Date' datatype='string' name='[Calculation_195836256969748481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Day&quot; THEN STR([Date])&#10;    WHEN &quot;Month&quot; THEN DATENAME(&apos;month&apos;, [Date]) + &quot; &quot; + STR(YEAR([Date]))&#10;END' />
      </column>
      <column caption='Expected Riders' datatype='real' name='[Calculation_195836256971411460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_forecast])/[Parameters].[Parameter 2]' />
      </column>
      <column caption='Expected Cost' datatype='real' name='[Calculation_195836256974041094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_forecast])*[Parameters].[Parameter 4]' />
      </column>
      <column caption='Expected CPO' datatype='real' name='[Calculation_195836256974475271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195836256974041094]/SUM([order_forecast])' />
      </column>
      <column caption='Expected Cost     (After Rush Bonus)' datatype='real' name='[Calculation_195836256975122440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_forecast])*[Parameters].[Parameter 4]*[Parameters].[Parameter 3]' />
      </column>
      <column caption='Expected CPO     (After Rush Bonus)' datatype='real' name='[Calculation_195836256975552521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195836256975122440]/SUM([order_forecast])' />
      </column>
      <column caption='Historical CPO' datatype='real' name='[Calculation_195836256983924746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basic_pay])/SUM([orders_historical])' />
      </column>
      <column caption='Historical Cost    (After Rush Bonus)' datatype='real' name='[Calculation_195836256984436747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basic_pay])*[Parameters].[Parameter 3]' />
      </column>
      <column caption='Historical CPO    (After Rush Bonus)' datatype='real' name='[Calculation_195836256984686604]' role='measure' type='quantitative'>
