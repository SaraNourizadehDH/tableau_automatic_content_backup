      </semantic-values>
      <date-options start-of-week='saturday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
        </column>
        <column caption='UTR Input (Future)' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='1.4'>
          <calculation class='tableau' formula='1.4' />
        </column>
        <column caption='Rush Input (Future &amp; Past)' datatype='real' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='1.1'>
          <calculation class='tableau' formula='1.1' />
        </column>
        <column caption='Earnings Input (Delivery + Distance)' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='0.85'>
          <calculation class='tableau' formula='0.85' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C4EE53CE98264DD9A82509D73461919E'>
            <properties context=''>
              <relation connection='bigquery.1456cgv0vhatys164i82k116nxgp' name='Custom SQL Query' type='text'>WITH future_data AS 
(
WITH RankedForecasts AS (
  -- First, select the raw data and rank it to find the most recent entry for each time
  SELECT
    o.country_code,
    c.zone_name,
    f.forecast_for_local,
    SUM(CASE WHEN o.model_name = &apos;rooster_adjusted&apos; THEN f.orders ELSE 0 END) AS adjusted_forecast,
    ROW_NUMBER() OVER(
      PARTITION BY o.country_code, c.zone_name, f.forecast_for_local
      ORDER BY f.created_at DESC
    ) AS rn
  FROM
    `fulfillment-dwh-production.curated_data_shared.order_forecasts` AS o
  LEFT JOIN
    UNNEST(o.forecasts) AS f
  LEFT JOIN (
    SELECT
      country_code,
      zo.id AS zone_id,
      zo.name AS zone_name
    FROM
      `fulfillment-dwh-production.curated_data_shared.countries` AS co
    LEFT JOIN
      UNNEST(co.cities) AS ci
    LEFT JOIN
      UNNEST(ci.zones) AS zo
    WHERE
      zo.name IS NOT NULL
  ) AS c ON o.country_code = c.country_code AND o.zone_id = c.zone_id
  WHERE
    -- 1. Date range is now from the current date to 14 days in the future
    DATE(f.forecast_for_local) BETWEEN CURRENT_DATE() AND DATE_ADD(CURRENT_DATE(), INTERVAL 14 DAY)
    AND o.model_name IN (&apos;rooster&apos;, &apos;rooster_adjusted&apos;)
    -- 2. Country code is now in the specified list
    AND o.country_code IN (&apos;ae&apos;, &apos;bh&apos;, &apos;eg&apos;, &apos;iq&apos;, &apos;jo&apos;, &apos;kw&apos;, &apos;om&apos;, &apos;qa&apos;)
  GROUP BY
    1, 2, 3, f.created_at
)
-- Then, select from the ranked data to build the final table
SELECT
  country_code AS Country,
  DATE(forecast_for_local) AS Date,
  zone_name AS Zone,
  CONCAT(
    FORMAT_TIME(&apos;%R&apos;, TIME(forecast_for_local)),
    &apos; - &apos;,
    FORMAT_TIME(&apos;%R&apos;, TIME_ADD(TIME(forecast_for_local), INTERVAL 30 MINUTE))
  ) AS Hour_Minute,
  adjusted_forecast AS order_forecast
FROM
  RankedForecasts
WHERE
  rn = 1
ORDER BY 1,2,3,4
)

,past_data AS (
WITH

a AS (
  SELECT
    created_date,
    country_code,
    rider_id,
    shift_id,
    delivery_id,
    SUM(total) AS total, -- accurate pay per delivery
    MIN(DATETIME(rider_accepted_at,timezone)) AS rider_accepted_at -- earliest time for interval bucketing
  FROM
    `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping`
  WHERE
    created_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 15 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND payment_category = &apos;basic&apos;
    AND order_status = &apos;completed&apos;
    AND total &gt;&gt; 0
  GROUP BY created_date, country_code, rider_id, shift_id, delivery_id
),

b AS (
  SELECT DISTINCT
    DATE(DATETIME(shift_start_at, s.timezone)) AS shift_date,
    s.country_code,
    s.rider_id,
    c.city_name,
    z.zone_name,
    s.shift_id
  FROM
    `fulfillment-dwh-production.curated_data_shared.shifts` AS s
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS c 
    ON c.country_code = s.country_code AND c.city_id = s.city_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` AS z 
    ON z.country_code = s.country_code AND z.zone_id = s.zone_id
  WHERE
    shift_state IN (&apos;EVALUATED&apos;)
    AND DATE(DATETIME(shift_start_at, s.timezone)) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 15 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
)

SELECT
  a.country_code AS Country,
  a.created_date AS Date,
  IFNULL(b.zone_name, &apos;Unknown&apos;) AS Zone,

  -- 30-minute interval
  CONCAT(
    FORMAT_TIMESTAMP(&apos;%R&apos;, TIMESTAMP_BUCKET(a.rider_accepted_at, INTERVAL 30 MINUTE)),
    &apos; - &apos;,
    FORMAT_TIMESTAMP(&apos;%R&apos;, TIMESTAMP_ADD(TIMESTAMP_BUCKET(a.rider_accepted_at, INTERVAL 30 MINUTE), INTERVAL 30 MINUTE))
  ) AS Hour_Minute,

  COUNT(DISTINCT a.rider_id) AS rider_count_historical,
  COUNT(DISTINCT a.delivery_id) AS orders_historical,
  ROUND(SUM(a.total), 0) AS basic_pay

FROM a

LEFT JOIN b 
  ON a.created_date = b.shift_date 
  AND a.country_code = b.country_code 
  AND a.rider_id = b.rider_id 
  AND a.shift_id = b.shift_id

WHERE a.country_code IN (&apos;ae&apos;, &apos;bh&apos;, &apos;eg&apos;, &apos;iq&apos;, &apos;jo&apos;, &apos;kw&apos;, &apos;om&apos;, &apos;qa&apos;)

GROUP BY ALL
ORDER BY 1,2,3,4,5
)  

SELECT
    Country,
    Date,
    Zone,
    Hour_Minute,
    order_forecast,
    NULL AS rider_count_historical,
    NULL AS orders_historical,
    NULL AS basic_pay
FROM
    future_data

UNION ALL

SELECT
    Country,
    Date,
    Zone,
    Hour_Minute,
    NULL AS order_forecast,
    rider_count_historical,
    orders_historical,
    basic_pay
FROM
    past_data

ORDER BY
    Country,
    Date,
    Zone,
    Hour_Minute</relation>
            </properties>
