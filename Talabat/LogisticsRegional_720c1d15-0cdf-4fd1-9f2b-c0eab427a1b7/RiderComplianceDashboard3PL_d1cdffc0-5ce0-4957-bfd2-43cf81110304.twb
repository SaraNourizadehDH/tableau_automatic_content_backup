      <column caption='% On-Shift Compliant' datatype='real' name='[Fully compliant % (copy)_3066810626516217870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Fully compliant count (copy)_3066810626515832844] / ([Fully compliant count (copy)_3066810626515832844] + [Fully compliant count (copy) (copy)_3066810626515841037])' />
      </column>
      <column caption='Number On-Shift Non-Compliant' datatype='integer' name='[Fully compliant count (copy) (copy)_3066810626515841037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([Calculation_2973360938505764871] = true AND NOT [rider_status] = &apos;Verified Rider&apos;, [rider_id], NULL))' />
      </column>
      <column caption='Number On-Shift Compliant' datatype='integer' name='[Fully compliant count (copy)_3066810626515832844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([Calculation_2973360938505764871] = true AND [rider_status] = &apos;Verified Rider&apos;, [rider_id], NULL))' />
