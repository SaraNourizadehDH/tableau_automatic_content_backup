              <calculation class='tableau' formula='//rider_id&#10;[rider_id (Custom SQL Query2)]' />
            </column>
            <column caption='country' datatype='string' name='[Calculation_4111082815163404298]' role='dimension' type='nominal' user:unnamed='Rider Level Document Compliance'>
              <calculation class='tableau' formula='//country&#10;&#10;//country&#10;[country_code (Custom SQL Query2)]' />
            </column>
            <column datatype='string' name='[city_name (Custom SQL Query2)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_code (Custom SQL Query2)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[doc_compliance]' role='dimension' type='nominal' />
            <column datatype='string' name='[doc_value]' role='dimension' type='nominal' />
            <column datatype='string' name='[document]' role='dimension' type='nominal' />
            <column datatype='string' name='[last_contract_name (Custom SQL Query2)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1038431605545488387]' derivation='None' name='[none:Calculation_1038431605545488387:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1038431605545918468]' derivation='None' name='[none:Calculation_1038431605545918468:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2465650451465351172]' derivation='None' name='[none:Calculation_2465650451465351172:nk]' pivot='key' type='nominal' />
