          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Only collected' caption='Documents Collection' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Only collected&quot;'>
              <calculation class='tableau' formula='&quot;Only collected&quot;' />
              <aliases>
                <alias key='&quot;Include not collected&quot;' value='Include not collected' />
                <alias key='&quot;Only collected&quot;' value='Only collected' />
