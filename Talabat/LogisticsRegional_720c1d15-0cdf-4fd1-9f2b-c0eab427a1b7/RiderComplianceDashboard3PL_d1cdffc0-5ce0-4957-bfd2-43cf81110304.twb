            <column datatype='string' name='[vehicle (Custom SQL Query2)]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.15w8y7w117trkx125e5mm0ub4t32].[none:Calculation_1038431605545488387:nk]'>
            <groupfilter function='member' level='[none:Calculation_1038431605545488387:nk]' member='false' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.15w8y7w117trkx125e5mm0ub4t32].[none:Calculation_1038431605545918468:nk]'>
