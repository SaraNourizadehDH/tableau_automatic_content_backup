      </column>
      <column caption='AVG days to docs expiry' datatype='real' name='[AVG days to docs expiry (copy)_3066810626511187975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;  IIF(ISNULL([driver_licence_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [driver_licence_expiration_date]))&#10;  +&#10;  IIF(ISNULL([health_insurance_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [health_insurance_expiration_date]))&#10;  +&#10;  IIF(ISNULL([id_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [id_expiration_date]))&#10;  +&#10;  IIF(ISNULL([labor_card_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [labor_card_expiration_date]))&#10;  +&#10;  IIF(ISNULL([passport_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [passport_expiration_date]))&#10;  +&#10;  IIF(ISNULL([qualification_certificate_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [qualification_certificate_expiration_date]))&#10;  +&#10;  IIF(ISNULL([vehicle_registration_expiration_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [vehicle_registration_expiration_date]))&#10;  +&#10;  IIF(ISNULL([work_permit_expiry_date]), 0, DATEDIFF(&apos;day&apos;, TODAY(), [work_permit_expiry_date]))&#10;)' />
      </column>
      <column caption='Number Not Fully Compliant' datatype='integer' name='[Active rider count (copy) (copy)_3066810626514890762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([legally_compliant] = &apos;Non compliant&apos; OR ([Calculation_2973360938505764871] = true AND NOT [rider_status] = &apos;Verified Rider&apos;), [rider_id], NULL))' />
      </column>
      <column caption='Number of riders with valid document' datatype='integer' name='[Active riders requiring document (copy)_3066810626809831441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([doc_validity] IN (&apos;Valid&apos;), [rider_id (Custom SQL Query2)], NULL))' />
      </column>
      <column caption='Not dob' datatype='boolean' name='[Calculation_1038431605545488387]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[document] = &apos;field_date_of_birth&apos;' />
      </column>
      <column caption='Expiring within 30 days' datatype='boolean' name='[Calculation_1038431605545918468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([doc_value]) &gt;= TODAY() AND DATE([doc_value]) &lt;= TODAY() + 30 THEN&#10;    TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='0' datatype='integer' name='[Calculation_1543749530013413376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Not Collected' datatype='integer' name='[Calculation_1543749530337792008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [valid_document] = &apos;Not collected&apos; THEN [rider_id (Custom SQL Query2)] END)' />
      </column>
      <column caption='Display' datatype='string' name='[Calculation_2172283199302574081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Documents Collection (copy)_2172283199301988352]' />
      </column>
      <column caption='Selected collection' datatype='string' name='[Calculation_2465650450689531905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Include not collected' datatype='string' name='[Calculation_2465650451465351172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Number requiring doc by rule' datatype='integer' name='[Calculation_2465650451755802634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([Compliance] IN (&apos;Compliant&apos;,&apos;Non compliant&apos;), [rider_id], 0))' />
      </column>
      <column caption='test' datatype='integer' name='[Calculation_2812568390252584960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id (Custom SQL Query1)] : &#10;  SUM(IF [Rule] = &apos;criminal_record_compliant&apos; AND [Compliance] = &apos;Compliant&apos; AND&#10;         [Rule] = &apos;driver_licence_compliant&apos; AND [Compliance] = &apos;Compliant&apos; AND&#10;         [Rule] = &apos;vehicle_registration_compliant&apos; AND [Compliance] = &apos;Compliant&apos;&#10;      THEN 1 ELSE 0 END)&#10;}' />
      </column>
      <column caption='Number Active Riders (week)' datatype='integer' name='[Calculation_2973360938605604877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([active_w] = &apos;Active&apos;, [rider_id (Custom SQL Query3)],NULL))' />
      </column>
      <column caption='Total Active Riders' datatype='integer' name='[Calculation_3066810626504507394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([is_active] = true, [rider_id], NULL))' />
      </column>
      <column caption='Doc expiring in 30 days' datatype='integer' name='[Calculation_3066810626505981955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;  [driver_licence_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [food_handling_certificate_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [health_insurance_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [id_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [labor_card_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [passport_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [qualification_certificate_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [vehicle_registration_expiration_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;  OR [work_permit_expiry_date] &lt;= DATEADD(&apos;day&apos;, 30, TODAY())&#10;THEN&#10;  [rider_id]&#10;END' />
      </column>
      <column caption='Number Fully Compliant' datatype='integer' name='[Calculation_3066810626506539013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([legally_compliant] = &apos;Compliant&apos; AND ([Calculation_2973360938505764871] = true AND [rider_status] = &apos;Verified Rider&apos;), [rider_id], NULL))' />
      </column>
      <column caption='% Fully Compliant' datatype='real' name='[Calculation_3066810626515304459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3066810626506539013] / ([Active rider count (copy) (copy)_3066810626514890762] + [Calculation_3066810626506539013])' />
      </column>
      <column caption='Active Riders Requiring Document' datatype='integer' name='[Calculation_3066810626808901648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([doc_compliance] IN (&apos;Required&apos;, &apos;Not collected&apos;), [rider_id (Custom SQL Query2)], NULL))' />
      </column>
      <column caption='% Active Fleet with Valid Document' datatype='real' name='[Calculation_3066810626810482706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active riders requiring document (copy)_3066810626809831441] / [Calculation_3066810626808901648]' />
