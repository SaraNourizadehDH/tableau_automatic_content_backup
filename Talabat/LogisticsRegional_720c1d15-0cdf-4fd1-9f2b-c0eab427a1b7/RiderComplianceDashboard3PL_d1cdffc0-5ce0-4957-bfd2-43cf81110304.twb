              <calculation class='tableau' formula='[document] = &apos;field_date_of_birth&apos;' />
            </column>
            <column caption='Expiring within 30 days' datatype='boolean' name='[Calculation_1038431605545918468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([doc_value]) &gt;= TODAY() AND DATE([doc_value]) &lt;= TODAY() + 30 THEN&#10;    TRUE&#10;ELSE&#10;    FALSE&#10;END' />
            </column>
