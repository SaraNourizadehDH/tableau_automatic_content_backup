      <column caption='Not Collected but Valid' datatype='integer' name='[Not Collected (copy)_2973360937366339584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [valid_document] = &apos;Not collected&apos; AND [doc_validity] = &apos;Valid&apos; THEN [rider_id (Custom SQL Query2)] END)' />
      </column>
      <column caption='Number Non-Compliant (legal compliance)' datatype='integer' name='[Number Compliant (legal compliance) (copy)_3066810626938392597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([legally_compliant] != &apos;Compliant&apos;, [rider_id], NULL))' />
