      <aliases enabled='yes' />
      <column caption='% Fully Compliant (copy)' datatype='real' name='[% Fully Compliant (copy)_2465650451501031429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3066810626506539013] / ([Active rider count (copy) (copy)_3066810626514890762] + [Calculation_3066810626506539013])' />
      </column>
      <column caption='% Legally compliant ' datatype='real' name='[% Fully compliant (copy)_3066810626938732566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3066810626938069012] / ([Calculation_3066810626938069012] + [Number Compliant (legal compliance) (copy)_3066810626938392597])' />
      </column>
      <column caption='% Potential Ghost Riders' datatype='real' name='[% Ghost Riders (copy)_385550369534308358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Ghost Riders (copy)_385550369532854277] / ([On-Shift Compliant (copy)_385550369528553472]+[Calculation_385550369529106433]+[Ghost Riders (copy)_385550369532854277])' />
      </column>
      <column caption='% Legally compliant  (including non collected docs)' datatype='real' name='[% Legally compliant  (copy)_2465650450659315712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3066810626938069012] / ([Calculation_3066810626938069012] + [Number Compliant (legal compliance) (copy)_3066810626938392597])' />
      </column>
      <column caption='% Verified Riders' datatype='real' name='[% On-Shift Compliant (copy)_385550369530142723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[On-Shift Compliant (copy)_385550369528553472] / ([On-Shift Compliant (copy)_385550369528553472]+[Calculation_385550369529106433]+[Ghost Riders (copy)_385550369532854277])' />
      </column>
      <column caption='% PP Uploaded' datatype='real' name='[% Verified Riders (copy)_385550369537900552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Verified Riders (copy)_385550369537310727] / COUNTD([rider_id (Custom SQL Query3)])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15w8y7w117trkx125e5mm0ub4t32].[__tableau_internal_object_id__].[cnt:_E10089F0EC094EE18BD253814786F7BD:qk]&quot;' value='rider count' />
