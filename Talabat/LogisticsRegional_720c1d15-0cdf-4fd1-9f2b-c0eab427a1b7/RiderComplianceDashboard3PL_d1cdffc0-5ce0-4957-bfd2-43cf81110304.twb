      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Unpivot docs' id='_214432AC15944AEDBBC99FAF4799333D'>
            <properties context=''>
              <relation connection='bigquery.0cumb9f0lzje9t138pm720w0pcf5' name='Custom SQL Query2' type='text'><![CDATA[WITH main AS (
SELECT
rid.country_code,
rid.rider_id,
rid.is_active,
COALESCE(field_date_of_birth,birth_date) AS field_date_of_birth,
nationality,
country_of_birth,
CASE
    WHEN rid.country_code IN ('ae', 'eg', 'qa', 'jo', 'iq') THEN COALESCE(country_of_birth, nationality)
    WHEN rid.country_code IN ('bh', 'kw', 'om') THEN COALESCE(nationality, country_of_birth)
END AS rider_nationality,
vehicle,
ci.city_name,
is_id_card_front_uploaded,
is_id_card_back_uploaded,
id_expiration_date,
CAST(work_permit_expiry_date AS DATE) AS work_permit_expiry_date,
CAST(work_permit_expiration_date AS DATE) AS work_permit_expiration_date,
is_passport_front_uploaded,
passport_expiration_date,
visa_type,
is_driver_licence_front_uploaded,
is_driver_licence_back_uploaded,
driver_licence_expiration_date,
driver_license_expiry_date,
is_vehicle_registration_front_uploaded,
is_vehicle_registration_back_uploaded,
vehicle_registration_expiration_date,
vehicle_verification_expiration_date,
is_vehicle_insurance_front_uploaded,
vehicle_insurance_expiration_date,
is_work_permit_front_uploaded,
is_proof_of_residence_front_uploaded,
visa_tag,
is_labor_card_front_uploaded,
labor_card_expiration_date,
residency_visa_job_title,
is_criminal_record_front_uploaded,
is_criminal_record_back_uploaded,
criminal_record_issuance_date,
criminal_record_result,
is_contract_between_rider_and_supplier_uploaded,
last_contract_name,
is_health_insurance_certificate_front_uploaded,
is_health_insurance_certificate_back_uploaded,
health_insurance_expiration_date,
is_hygiene_uploaded,
--sak_contract_expiry_date,
qualification_certificate_expiration_date,
is_qualification_certificate_front_uploaded,
is_occupational_health_card_uploaded,
ohc_expiration_date,
is_food_handling_certificate_uploaded,
food_handling_certificate_expiration_date,
qid_occupation,
is_secondment_approval_uploaded,
--is_company_uploaded,
CAST(last_contract_end_at AS DATE) AS last_contract_end_at,

CASE

    WHEN rid.country_code = 'om' AND LOWER(nationality) NOT LIKE 'oman%' AND LOWER(last_contract_name) NOT LIKE '%freelancer%' --AND vehicle = 'Motorbike' 
    THEN '3PL Rider foreigner'
    WHEN rid.country_code = 'om' AND LOWER(nationality) LIKE 'oman%' AND LOWER(last_contract_name) NOT LIKE '%freelancer%' THEN '3PL Rider Omani'
    WHEN rid.country_code = 'om' AND LOWER(nationality) LIKE 'oman%' AND LOWER(last_contract_name) LIKE '%freelancer%' THEN 'Freelancer'
    WHEN rid.country_code = 'eg' AND (LOWER(country_of_birth) LIKE '%egypt%' OR LOWER(country_of_birth) LIKE '%cairo%' OR LOWER(nationality) LIKE '%egypt%') THEN 'Egyptian'
    WHEN rid.country_code = 'eg' AND (LOWER(country_of_birth) NOT LIKE '%egypt%' OR LOWER(country_of_birth) NOT LIKE '%cairo%' OR LOWER(nationality) NOT LIKE '%egypt%' OR COALESCE(country_of_birth,nationality) IS NULL) THEN 'Foreigner'
    WHEN rid.country_code = 'bh' AND LOWER(nationality) NOT LIKE 'bahrain%' AND visa_tag IN (1) THEN '3PL foreigner'
    WHEN rid.country_code = 'bh' AND LOWER(nationality) NOT LIKE 'bahrain%' AND visa_tag IN (2) THEN '4PL foreigner'
    WHEN rid.country_code = 'bh' AND visa_tag = 3 THEN 'Work Permit Card'
    WHEN rid.country_code = 'bh' AND LOWER(nationality) LIKE 'bahrain%' AND visa_tag = 6 AND LOWER(last_contract_name) LIKE '%ft%internal%' THEN 'FT Rider Carriage (Bahraini)'
    WHEN rid.country_code = 'bh' AND LOWER(nationality) LIKE 'bahrain%' AND visa_tag = 6 AND LOWER(last_contract_name) NOT LIKE '%ft%internal%' THEN '3PL (Bahraini)'
    WHEN rid.country_code = 'kw' AND (LOWER(country_of_birth) NOT LIKE '%kuwait%' OR LOWER(nationality) NOT LIKE '%kuwait%' OR COALESCE(country_of_birth,nationality) IS NULL) AND LOWER(visa_type) LIKE '%visa18full%' THEN '3PL: Visa 18 FT'
    WHEN rid.country_code = 'kw' AND (LOWER(country_of_birth) LIKE '%kuwait%' OR LOWER(nationality) LIKE '%kuwait%') AND LOWER(visa_type) NOT LIKE '%part%' THEN 'National'
    WHEN rid.country_code = 'jo' AND LOWER(last_contract_name) LIKE '%internal driver%' THEN 'talabat employee'
    WHEN rid.country_code = 'jo' AND LOWER(last_contract_name) LIKE '%freelancer%' THEN 'Freelancer'
    WHEN rid.country_code = 'jo' AND (LOWER(last_contract_name) NOT LIKE '%internal driver%' OR LOWER(last_contract_name) NOT LIKE '%freelancer%') THEN '3PL Rider'
    WHEN rid.country_code = 'ae' AND LOWER(visa_type) LIKE '%3pl%' AND LOWER(visa_type) NOT LIKE '%temp%' THEN '3PL Visa Sponsored'	
    WHEN rid.country_code = 'ae' AND LOWER(visa_type) LIKE '%3pl%temp%' THEN '3PL Work Permit Sponsored'
    WHEN rid.country_code = 'ae' AND LOWER(visa_type) LIKE '%amnp%' THEN 'Manpower Company'
    WHEN rid.country_code = 'qa' AND LOWER(visa_type) LIKE '%freelancer%' THEN 'Freelancer'
    WHEN rid.country_code = 'qa' AND LOWER(visa_type) LIKE '%3pl%' THEN '3PL'
    WHEN rid.country_code = 'qa' AND LOWER(visa_type) LIKE '%4pl%' THEN '4PL'
    WHEN rid.country_code = 'qa' AND LOWER(visa_type) LIKE '%talabat%internal%' THEN 'talabat employee'
    WHEN rid.country_code = 'iq' AND (LOWER(country_of_birth) LIKE '%iraq%' OR LOWER(nationality) LIKE '%iraq%') THEN 'Iraqi'
    WHEN rid.country_code = 'iq' AND (LOWER(country_of_birth) NOT LIKE '%iraq%' OR LOWER(nationality) NOT LIKE '%iraq%' OR COALESCE(country_of_birth,nationality) IS NULL) THEN 'Foreigner'

    ELSE 'Other'


END AS rider_category,

FROM `tlb-data-prod.data_platform.dim_logistics_rider` rid
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` ci
ON rid.last_city_id = ci.city_id
AND rid.country_code = ci.country_code
WHERE ci.is_Active = TRUE
AND rid.is_active = TRUE
AND rid.country_code NOT IN ('dp-kw','k3')
AND (rid.last_contract_name NOT IN ('Talabat Internal Rider','Test Contract A','Test Contract B','RQS','Internal Drivers','RDDS_Test','TBOM_TEST') AND LOWER(rid.last_contract_name) NOT LIKE '%test%')
),

unpiv AS (

    SELECT country_code, rider_id, document, CAST(doc_value AS STRING) AS doc_value,
    CASE
        WHEN doc_value = TRUE 
        --OR doc_value = 'true' 
        THEN 'Valid'
        WHEN doc_value = FALSE --OR doc_value = 'false' 
        OR doc_value IS NULL THEN 'Invalid'
        ELSE NULL
    END AS doc_validity
    FROM main
    UNPIVOT(doc_value FOR document IN (
        is_contract_between_rider_and_supplier_uploaded,
        is_criminal_record_back_uploaded,
        is_criminal_record_front_uploaded,
        is_driver_licence_back_uploaded,
        is_driver_licence_front_uploaded,
        is_food_handling_certificate_uploaded,
        is_health_insurance_certificate_front_uploaded,
        is_health_insurance_certificate_back_uploaded,
        is_hygiene_uploaded,
        is_id_card_back_uploaded,
        is_id_card_front_uploaded,
        is_labor_card_front_uploaded,
        is_occupational_health_card_uploaded,
        is_passport_front_uploaded,
        is_proof_of_residence_front_uploaded,
        is_qualification_certificate_front_uploaded,
        is_vehicle_insurance_front_uploaded,
        is_vehicle_registration_back_uploaded,
        is_vehicle_registration_front_uploaded,
        is_secondment_approval_uploaded,
        --is_company_uploaded,
        is_work_permit_front_uploaded  
    ))    


),

unpiv_date AS (
    SELECT country_code, rider_id, document, CAST(doc_value AS STRING) AS doc_value,
        CASE

        -- criminal record issuance expired only 2 years after issuance
        WHEN country_code = 'jo' AND document = 'criminal_record_issuance_date' AND doc_value >>= DATE_ADD(CURRENT_DATE(), INTERVAL -24 MONTH) THEN 'Valid'
        WHEN country_code = 'jo' AND document = 'criminal_record_issuance_date' AND (doc_value << DATE_ADD(CURRENT_DATE(), INTERVAL -24 MONTH) OR doc_value IS NULL) THEN 'Invalid' 
        WHEN country_code = 'jo' AND document NOT IN ('field_date_of_birth','criminal_record_issuance_date') AND doc_value >>= CURRENT_DATE() THEN 'Valid'
        WHEN country_code = 'jo' AND document NOT IN ('field_date_of_birth','criminal_record_issuance_date') AND (doc_value << CURRENT_DATE() OR doc_value IS NULL) THEN 'Invalid'

        WHEN country_code != 'jo' AND document != 'field_date_of_birth' AND doc_value >>= CURRENT_DATE() THEN 'Valid'
        WHEN country_code != 'jo' AND document != 'field_date_of_birth' AND doc_value << CURRENT_DATE() OR doc_value IS NULL THEN 'Invalid'
        WHEN document = 'field_date_of_birth' AND EXTRACT(YEAR FROM CURRENT_DATE()) - EXTRACT(YEAR FROM doc_value) >>= 18 THEN 'Valid'
        WHEN document = 'field_date_of_birth' AND (EXTRACT(YEAR FROM CURRENT_DATE()) - EXTRACT(YEAR FROM doc_value) << 18 OR doc_value IS NULL) THEN 'Invalid'
        ELSE NULL
    END AS doc_validity
    FROM main
    UNPIVOT(doc_value FOR document IN (
        driver_licence_expiration_date,
        driver_license_expiry_date,
        food_handling_certificate_expiration_date,
        health_insurance_expiration_date,
        id_expiration_date,
        labor_card_expiration_date,
        passport_expiration_date,
        qualification_certificate_expiration_date,
        vehicle_registration_expiration_date,
        vehicle_verification_expiration_date,
        work_permit_expiry_date,
        work_permit_expiration_date,
        vehicle_insurance_expiration_date,
        last_contract_end_at,
        --sak_contract_expiry_date,
        field_date_of_birth,
        ohc_expiration_date,
        criminal_record_issuance_date))
    
),

unpiv_string AS (
    SELECT country_code, rider_id, document, doc_value,
    CASE
        WHEN country_code = 'qa' AND document = 'qid_occupation' AND (doc_value != '1' OR doc_value IS NULL) THEN 'Invalid'
        WHEN country_code = 'qa' AND document = 'qid_occupation' AND doc_value = '1' THEN 'Valid'
        
        WHEN country_code = 'ae' AND vehicle = 'Motorbike' AND document = 'residency_visa_job_title' AND (doc_value != '1' OR doc_value IS NULL) THEN 'Invalid'
        WHEN country_code = 'ae' AND vehicle = 'Motorbike' AND document = 'residency_visa_job_title' AND doc_value = '1' THEN 'Valid'
        WHEN country_code = 'ae' AND vehicle != 'Motorbike' AND document = 'residency_visa_job_title' AND doc_value NOT IN ('1','2') THEN 'Invalid'
        WHEN country_code = 'ae' AND vehicle != 'Motorbike' AND document = 'residency_visa_job_title' AND doc_value IN ('1','2') THEN 'Valid'

        WHEN country_code = 'eg' AND document = 'criminal_record_result' AND (doc_value NOT IN ('clean','lifted') OR doc_value IS NULL) THEN 'Invalid'
        WHEN country_code = 'eg' AND document = 'criminal_record_result' AND doc_value IN ('clean','lifted') THEN 'Valid'

        --WHEN country_code = 'ae' AND document = 'residency_visa_job_title' AND (doc_value != 'Motorcycle Driver' OR doc_value IS NULL) THEN 'Invalid'
        --WHEN country_code = 'ae' AND document = 'residency_visa_job_title' AND doc_value = 'Motorcycle Driver' THEN 'Valid'
        ELSE NULL
    END AS doc_validity
    FROM main
    UNPIVOT(doc_value FOR document IN (
        qid_occupation,
        residency_visa_job_title,
        criminal_record_result
        ))
),

fill AS (
    SELECT 
    country_code, rider_category, rider_id, is_active, field_date_of_birth, country_of_birth, nationality, rider_nationality, city_name, visa_type, visa_tag, last_contract_name, vehicle,
    doc.document, NULL AS a
    FROM
    main
    CROSS JOIN
    (
        SELECT 'field_date_of_birth' AS document UNION ALL
        SELECT 'is_id_card_front_uploaded' AS document UNION ALL
        SELECT 'is_id_card_back_uploaded' AS document UNION ALL
        SELECT 'id_expiration_date' AS document UNION ALL
        SELECT 'passport_expiration_date' AS document UNION ALL
        SELECT 'is_passport_front_uploaded' AS document UNION ALL
        SELECT 'is_driver_licence_front_uploaded' AS document UNION ALL
        SELECT 'is_driver_licence_back_uploaded' AS document UNION ALL
        SELECT 'driver_licence_expiration_date' AS document UNION ALL
        SELECT 'driver_license_expiry_date' AS document UNION ALL
        SELECT 'is_vehicle_insurance_front_uploaded' AS document UNION ALL
        SELECT 'vehicle_insurance_expiration_date' AS document UNION ALL
        SELECT 'is_vehicle_registration_front_uploaded' AS document UNION ALL
        SELECT 'is_vehicle_registration_back_uploaded' AS document UNION ALL
        SELECT 'vehicle_registration_expiration_date' AS document UNION ALL
        SELECT 'vehicle_verification_expiration_date' AS document UNION ALL
        SELECT 'is_criminal_record_front_uploaded' AS document UNION ALL
        SELECT 'is_criminal_record_back_uploaded' AS document UNION ALL
        SELECT 'criminal_record_issuance_date' AS document UNION ALL
        SELECT 'criminal_record_result' AS document UNION ALL
        SELECT 'is_health_insurance_certificate_front_uploaded' AS document UNION ALL
        SELECT 'is_health_insurance_certificate_back_uploaded' AS document UNION ALL
        SELECT 'health_insurance_expiration_date' AS document UNION ALL
        SELECT 'is_contract_between_rider_and_supplier_uploaded' AS document UNION ALL
        SELECT 'is_proof_of_residence_front_uploaded' AS document UNION ALL
        SELECT 'is_labor_card_front_uploaded' AS document UNION ALL
        SELECT 'labor_card_expiration_date' AS document UNION ALL
        SELECT 'is_work_permit_front_uploaded' AS document UNION ALL
        SELECT 'work_permit_expiry_date' AS document UNION ALL
        SELECT 'work_permit_expiration_date' AS document UNION ALL
        SELECT 'last_contract_end_at' AS document UNION ALL        
        SELECT 'is_qualification_certificate_front_uploaded' AS document UNION ALL
        SELECT 'qualification_certificate_expiration_date' AS document UNION ALL                
        SELECT 'is_food_handling_certificate_uploaded' AS document UNION ALL
        SELECT 'food_handling_certificate_expiration_date' AS document UNION ALL
        SELECT 'is_hygiene_uploaded' AS document UNION ALL
        SELECT 'is_occupational_health_card_uploaded' AS document UNION ALL       
        SELECT 'qid_occupation' AS document UNION ALL
        --SELECT 'sak_contract_expiry_date' AS document UNION ALL
        --SELECT 'is_company_uploaded' AS document UNION ALL 
        SELECT 'is_secondment_approval_uploaded' AS document UNION ALL
        SELECT 'ohc_expiration_date' AS document UNION ALL
        SELECT 'residency_visa_job_title' AS document
        
    ) doc
),

up AS (
    SELECT * FROM unpiv
    UNION ALL SELECT * FROM unpiv_date
    UNION ALL SELECT * FROM unpiv_string
),

jn AS (
    SELECT fill.*, 
    COALESCE(up.doc_validity, NULL) AS doc_validity,
    COALESCE(up.doc_value, NULL) AS doc_value
    FROM fill
    LEFT JOIN up
    ON fill.country_code = up.country_code AND fill.rider_id = up.rider_id AND fill.document = up.document
),

sub AS(
SELECT jn.country_code, jn.rider_category, jn.rider_id, jn.is_active, jn.field_date_of_birth AS date_of_birth, jn.rider_nationality, jn.city_name, jn.visa_type, jn.visa_tag, jn.last_contract_name, jn.vehicle, jn.document, jn.doc_value, jn.doc_validity, 
 

CASE 
    WHEN document = 'field_date_of_birth' THEN 'Required'

--- UAE
    WHEN country_code = 'ae' AND rider_category IN ('3PL Visa Sponsored','3PL Work Permit Sponsored','Manpower Company') AND 
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','work_permit_expiration_date','is_proof_of_residence_front_uploaded','health_insurance_expiration_date',
    'is_health_insurance_certificate_front_uploaded','residency_visa_job_title') 
    THEN 'Required'

    WHEN country_code = 'ae' AND rider_category = '3PL Work Permit Sponsored' AND document IN ('is_labor_card_front_uploaded','labor_card_expiration_date') 
    THEN 'Required'

    WHEN country_code = 'ae' AND rider_category IN ('3PL Visa Sponsored','3PL Work Permit Sponsored','Manpower Company') AND city_name = 'Dubai' AND vehicle = 'Motorbike' AND 
    document IN ('is_qualification_certificate_front_uploaded','qualification_certificate_expiration_date')
    THEN 'Required'
    
    WHEN country_code = 'ae' AND rider_category IN ('3PL Visa Sponsored','3PL Work Permit Sponsored','Manpower Company') AND city_name IN ('Fujairah', 'Rak', 'Sharjah','Ajman') AND vehicle IN ('Motorbike','Car','walker') AND
    document IN ('is_occupational_health_card_uploaded','ohc_expiration_date')
    THEN 'Required'

    WHEN country_code = 'ae' AND rider_category IN ('3PL Visa Sponsored','3PL Work Permit Sponsored','Manpower Company') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('is_driver_licence_back_uploaded','is_driver_licence_front_uploaded','driver_licence_expiration_date','is_vehicle_registration_back_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    THEN 'Required'

--- KW

    WHEN country_code = 'kw' AND rider_category IN ('3PL: Visa 18 FT','National') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date','is_criminal_record_front_uploaded','last_contract_end_at','food_handling_certificate_expiration_date','is_hygiene_uploaded')
    THEN 'Required' --'is_health_insurance_certificate_front_uploaded','health_insurance_expiration_date'

    WHEN country_code = 'kw' AND rider_category = '3PL: Visa 18 FT' AND document IN ('is_passport_front_uploaded','passport_expiration_date','is_work_permit_front_uploaded','work_permit_expiration_date')
    THEN 'Required'

    WHEN country_code = 'kw' AND rider_category IN ('3PL: Visa 18 FT','National') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('driver_licence_expiration_date','is_driver_licence_back_uploaded','is_driver_licence_front_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    THEN 'Required'

--- OM
    WHEN country_code = 'om' AND rider_category IN ('3PL Rider foreigner','3PL Rider Omani','Freelancer') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date','is_criminal_record_front_uploaded')
    THEN 'Required'

    WHEN country_code = 'om' AND rider_category IN ('3PL Rider foreigner','3PL Rider Omani','Freelancer') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('driver_licence_expiration_date','is_driver_licence_back_uploaded','is_driver_licence_front_uploaded','is_vehicle_registration_back_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    THEN 'Required'
    
--- BH
    WHEN country_code = 'bh' AND rider_category IN ('3PL foreigner','4PL foreigner','3PL (Bahraini)','FT Rider Carriage (Bahraini)','Work Permit Card') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date','is_criminal_record_front_uploaded')
    THEN 'Required'

    WHEN country_code = 'bh' AND rider_category IN ('3PL foreigner','4PL foreigner','Work Permit Card') 
    AND document IN ('is_work_permit_front_uploaded','work_permit_expiry_date','is_passport_front_uploaded','passport_expiration_date') THEN 'Required'

    WHEN country_code = 'bh' AND rider_category IN ('3PL (Bahraini)','3PL foreigner','4PL foreigner','Work Permit Card') AND
    document IN ('is_contract_between_rider_and_supplier_uploaded')
    THEN 'Required'

    WHEN country_code = 'bh' AND rider_category IN ('3PL foreigner','4PL foreigner','3PL (Bahraini)','FT Rider Carriage (Bahraini)','Work Permit Card') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('driver_license_expiry_date','is_driver_licence_back_uploaded','is_driver_licence_front_uploaded','is_vehicle_insurance_front_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    THEN 'Required'

--- EG

    WHEN country_code = 'eg' AND rider_category IN ('Egyptian','Foreigner') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date')
    THEN 'Required'

    WHEN country_code = 'eg' AND rider_category = 'Egyptian' AND
    document IN ('criminal_record_result') 
    THEN 'Required'

    WHEN country_code = 'eg' AND rider_category = 'Foreigner' AND
    document IN ('is_passport_front_uploaded','passport_expiration_date')
    THEN 'Required'

    WHEN country_code = 'eg' AND rider_category IN ('Egyptian','Foreigner') AND LOWER(vehicle) NOT LIKE '%walk%' AND LOWER(vehicle) NOT LIKE '%bicycle%' AND
    document IN ('is_vehicle_registration_back_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    THEN 'Required'
    -- 'driver_license_expiry_date','is_driver_licence_back_uploaded','is_driver_licence_front_uploaded'

--- JO

    WHEN country_code = 'jo' AND rider_category IN ('3PL Rider','Freelancer','talabat employee') AND 
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date',
    'is_criminal_record_front_uploaded','criminal_record_issuance_date')
    THEN 'Required'

    WHEN country_code = 'jo' AND rider_category IN ('talabat employee') AND LOWER(vehicle) NOT LIKE '%walk%' AND 
    document IN ('is_vehicle_insurance_front_uploaded','vehicle_insurance_expiration_date')
    THEN 'Required'

    WHEN country_code = 'jo' AND (LOWER(country_of_birth) NOT LIKE '%jordan%' OR LOWER(nationality) NOT LIKE 'jo%' OR COALESCE(country_of_birth,nationality) IS NULL) AND
    document IN ('is_passport_front_uploaded','passport_expiration_date')
    THEN 'Required'

    WHEN country_code = 'jo' AND rider_category IN ('3PL Rider','Freelancer') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('is_driver_licence_front_uploaded','is_vehicle_registration_front_uploaded') 
    THEN 'Required'    

    WHEN country_code = 'jo' AND rider_category = 'talabat employee' AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('driver_licence_expiration_date','is_driver_licence_front_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date') 
    THEN 'Required'    

--- QA

    WHEN country_code = 'qa' AND rider_category IN ('3PL','4PL','Freelancer','talabat employee') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date','food_handling_certificate_expiration_date','is_food_handling_certificate_uploaded','is_passport_front_uploaded',
    'passport_expiration_date','qid_occupation')
    -- 'is_health_insurance_certificate_front_uploaded', 'is_health_insurance_certificate_back_uploaded'
    THEN 'Required'

    -- WHEN country_code = 'qa' AND rider_category IN ('3PL','4PL') AND
    -- document IN ('is_company_uploaded' ,'sak_contract_expiry_date')
    -- THEN 'Required'

    WHEN country_code = 'qa' AND rider_category IN ('Freelancer') AND (CURRENT_DATE() BETWEEN DATE(EXTRACT(YEAR FROM CURRENT_DATE()) || '-06-01') AND DATE(EXTRACT(YEAR FROM CURRENT_DATE()) || '-09-15')) AND document = 'is_secondment_approval_uploaded'
    THEN 'Required'

    WHEN country_code = 'qa' AND rider_category IN ('3PL','4PL','Freelancer','talabat employee') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    document IN ('driver_licence_expiration_date','is_driver_licence_back_uploaded','is_driver_licence_front_uploaded','is_vehicle_registration_front_uploaded','vehicle_verification_expiration_date')
    THEN 'Required'

--- IQ

    WHEN country_code = 'iq' AND rider_category IN ('Iraqi','Foreigner') AND
    document IN ('is_id_card_front_uploaded','is_id_card_back_uploaded','id_expiration_date','is_proof_of_residence_front_uploaded',
    'is_criminal_record_front_uploaded', 'last_contract_end_at')
    THEN 'Required'

    WHEN country_code = 'iq' AND rider_category = 'Foreigner' AND document IN ('is_passport_front_uploaded','passport_expiration_date')
    THEN 'Required'

    -- WHEN country_code = 'iq' AND rider_category = 'Iraqi' AND document IN ('is_criminal_record_front_uploaded', 'last_contract_end_at')
    -- THEN 'Required'

    -- WHEN country_code = 'iq' AND rider_category IN ('Iraqi','Foreigner') AND LOWER(vehicle) NOT LIKE '%walk%' AND
    -- document IN ('is_vehicle_registration_back_uploaded','is_vehicle_registration_front_uploaded','vehicle_registration_expiration_date')
    -- THEN 'Required'

    WHEN country_code = 'iq' AND LOWER(vehicle) NOT LIKE '%walk%' AND (COALESCE(LOWER(country_of_birth),LOWER(nationality)) NOT LIKE '%syr%' OR COALESCE(LOWER(nationality),LOWER(country_of_birth)) NOT LIKE '%syr%') AND
    document IN ('is_driver_licence_front_uploaded')
    --'driver_licence_expiration_date',
    THEN 'Required'

    -- WHEN country_code = 'iq' AND rider_category IN ('Iraqi','Foreigner')  AND city_name = 'Baghdad' AND document IN ('is_contract_between_rider_and_supplier_uploaded')
    -- THEN 'Not collected'

    ELSE 'Not required'
END AS doc_compliance

FROM jn

)

SELECT *,

CASE
    WHEN doc_compliance = 'Not required' THEN 'Not required'
    WHEN doc_compliance = 'Not collected' AND doc_validity = 'Valid' THEN 'Not collected - Valid'
    WHEN doc_compliance = 'Not collected' AND (doc_validity = 'Invalid' OR doc_validity IS NULL) THEN 'Not collected - Invalid'
    WHEN doc_compliance = 'Required' AND doc_validity = 'Valid' THEN 'Valid'
    WHEN doc_compliance = 'Required' AND (doc_validity = 'Invalid' OR doc_value IS NULL) THEN 'Invalid'
    ELSE doc_validity

END AS valid_document

FROM sub
WHERE document IS NOT NULL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Docs Near Expiry'>
