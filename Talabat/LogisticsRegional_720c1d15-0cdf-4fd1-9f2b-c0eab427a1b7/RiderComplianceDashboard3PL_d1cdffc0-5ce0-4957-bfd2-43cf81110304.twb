              <calculation class='tableau' formula='//Document&#10;[document]' />
            </column>
            <column caption='3PL' datatype='string' name='[Calculation_4111082815119032321]' role='dimension' type='nominal' user:unnamed='Document Compliance Sheet (2)'>
              <calculation class='tableau' formula='//3PL&#10;[last_contract_name (Custom SQL Query2)]' />
            </column>
