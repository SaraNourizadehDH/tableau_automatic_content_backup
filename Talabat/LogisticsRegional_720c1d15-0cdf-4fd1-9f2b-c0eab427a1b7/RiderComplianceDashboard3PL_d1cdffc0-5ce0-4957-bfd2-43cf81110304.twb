      <column caption='Number Compliant (legal compliance)' datatype='integer' name='[Calculation_3066810626938069012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([legally_compliant] = &apos;Compliant&apos;, [rider_id], NULL))' />
      </column>
      <column caption='Ghost Riders' datatype='integer' name='[Calculation_385550369529106433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([rider_status] = &apos;Ghost Rider&apos;, [rider_id (Custom SQL Query3)], NULL))' />
      </column>
      <column caption='% Ghost Riders' datatype='real' name='[Calculation_385550369532129284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_385550369529106433] / ([On-Shift Compliant (copy)_385550369528553472]+[Calculation_385550369529106433]+[Ghost Riders (copy)_385550369532854277])' />
