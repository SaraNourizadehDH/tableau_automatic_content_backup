          <datasource-dependencies datasource='federated.15w8y7w117trkx125e5mm0ub4t32'>
            <column caption='Number of riders with valid document' datatype='integer' name='[Active riders requiring document (copy)_3066810626809831441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IIF([doc_validity] IN (&apos;Valid&apos;), [rider_id (Custom SQL Query2)], NULL))' />
            </column>
            <column caption='Include not collected' datatype='string' name='[Calculation_2465650451465351172]' role='dimension' type='nominal'>
