            <column-instance column='[Calculation_4111082815119032321]' derivation='None' name='[none:Calculation_4111082815119032321:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4111082815163158535]' derivation='None' name='[none:Calculation_4111082815163158535:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4111082815163404298]' derivation='None' name='[none:Calculation_4111082815163404298:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name (Custom SQL Query2)]' derivation='None' name='[none:city_name (Custom SQL Query2):nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code (Custom SQL Query2)]' derivation='None' name='[none:country_code (Custom SQL Query2):nk]' pivot='key' type='nominal' />
            <column-instance column='[doc_compliance]' derivation='None' name='[none:doc_compliance:nk]' pivot='key' type='nominal' />
