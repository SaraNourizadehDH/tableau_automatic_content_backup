      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1i5ir2g0p9ape819tjabe0blwmmg].[sum:active_riders:qk]&quot;' value='Total Active Riders in Churn Month' />
