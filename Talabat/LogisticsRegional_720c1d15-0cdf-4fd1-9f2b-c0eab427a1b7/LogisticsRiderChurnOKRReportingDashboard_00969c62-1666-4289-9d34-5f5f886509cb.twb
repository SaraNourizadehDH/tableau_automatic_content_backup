    <worksheet name='mtd_daily'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Daily Trend for Rider Churn</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider churn_mtd view' name='federated.0iymvzn0n5d6bz1cvjggx0jqsrkk' />
          </datasources>
          <datasource-dependencies datasource='federated.0iymvzn0n5d6bz1cvjggx0jqsrkk'>
            <column caption='Date Buckets' datatype='string' name='[Calculation_4779726628937412610]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 3 THEN &quot;≤ 3 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 7 THEN &quot;≤ 7 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 14 THEN &quot;≤ 14 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 21 THEN &quot;≤ 21 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 30 THEN &quot;≤ 30 Days&quot;&#10;ELSE &quot;&gt; 30 Days&quot;&#10;END' />
              <aliases>
                <alias key='&quot;≤ 14 Days&quot;' value='8 ≤ 14 Days' />
                <alias key='&quot;≤ 21 Days&quot;' value='15 ≤ 21 Days' />
                <alias key='&quot;≤ 30 Days&quot;' value='22 ≤ 30 Days' />
                <alias key='&quot;≤ 7 Days&quot;' value='4 ≤ 7 Days' />
              </aliases>
            </column>
            <column caption='Total Riders' datatype='integer' name='[Calculation_4779726628937461763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='Is Newbie Rider Flag' datatype='boolean' name='[Calculation_4779726628956819469]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [first_order_date], TODAY()) &lt;= 60 THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[first_order_date]' role='dimension' type='ordinal' />
            <column caption='Is Valid Delivery Associate' datatype='boolean' name='[is_valid_delivery_associate]' role='dimension' type='nominal' />
            <column caption='3PL' datatype='string' name='[last_contract_name]' role='dimension' type='nominal' />
            <column caption='Last Order Date' datatype='date' name='[last_order_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4779726628937412610]' derivation='None' name='[none:Calculation_4779726628937412610:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4779726628956819469]' derivation='None' name='[none:Calculation_4779726628956819469:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_order_date]' derivation='None' name='[none:first_order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[is_valid_delivery_associate]' derivation='None' name='[none:is_valid_delivery_associate:nk]' pivot='key' type='nominal' />
            <column-instance column='[last_contract_name]' derivation='None' name='[none:last_contract_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[last_order_date]' derivation='None' name='[none:last_order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[last_order_date]' derivation='None' name='[none:last_order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vehicle_type]' derivation='None' name='[none:vehicle_type:nk]' pivot='key' type='nominal' />
