      <datasource-dependencies datasource='federated.0iymvzn0n5d6bz1cvjggx0jqsrkk'>
        <column caption='Date Buckets' datatype='string' name='[Calculation_4779726628937412610]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 3 THEN &quot;≤ 3 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 7 THEN &quot;≤ 7 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 14 THEN &quot;≤ 14 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 21 THEN &quot;≤ 21 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 30 THEN &quot;≤ 30 Days&quot;&#10;ELSE &quot;&gt; 30 Days&quot;&#10;END' />
          <aliases>
            <alias key='&quot;≤ 14 Days&quot;' value='8 ≤ 14 Days' />
            <alias key='&quot;≤ 21 Days&quot;' value='15 ≤ 21 Days' />
            <alias key='&quot;≤ 30 Days&quot;' value='22 ≤ 30 Days' />
            <alias key='&quot;≤ 7 Days&quot;' value='4 ≤ 7 Days' />
          </aliases>
        </column>
        <column caption='Is Newbie Rider Flag' datatype='boolean' name='[Calculation_4779726628956819469]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [first_order_date], TODAY()) &lt;= 60 THEN TRUE&#10;ELSE FALSE&#10;END' />
