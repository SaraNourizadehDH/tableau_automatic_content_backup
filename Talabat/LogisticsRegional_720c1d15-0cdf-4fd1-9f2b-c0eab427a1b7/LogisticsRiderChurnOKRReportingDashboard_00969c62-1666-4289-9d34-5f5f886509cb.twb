    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Rider List View'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/LogisticsRiderChurnOKRReportingDashboard_17576600464500/RiderListView?rev=' id='RiderListView' path='/t/Talabat/workbooks/LogisticsRiderChurnOKRReportingDashboard_17576600464500' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_85' value='top' />
        </style-rule>
      </style>
      <size maxheight='1300' maxwidth='1300' minheight='1300' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='rider_list_churn' name='federated.067b9iv1i853v810i3ngw1nwago3' />
      </datasources>
      <datasource-dependencies datasource='federated.067b9iv1i853v810i3ngw1nwago3'>
        <column caption='Is Dubai Rider' datatype='boolean' name='[Calculation_1618903370293940225]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [clusters] = &apos;Dubai&apos; &#10;then TRUE&#10;ELSE FALSE&#10;END' />
        </column>
        <column datatype='date' name='[active_month]' role='dimension' type='ordinal' />
        <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='boolean' name='[is_valid_delivery_associate]' role='dimension' type='nominal' />
        <column caption='3PL' datatype='string' name='[last_contract_name]' role='dimension' type='nominal' />
        <column caption='Last Contract Start' datatype='datetime' name='[last_contract_start_at]' role='dimension' type='ordinal' />
        <column-instance column='[active_month]' derivation='MY' name='[my:active_month:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Calculation_1618903370293940225]' derivation='None' name='[none:Calculation_1618903370293940225:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_valid_delivery_associate]' derivation='None' name='[none:is_valid_delivery_associate:nk]' pivot='key' type='nominal' />
        <column-instance column='[last_contract_name]' derivation='None' name='[none:last_contract_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[vehicle_type]' derivation='None' name='[none:vehicle_type:nk]' pivot='key' type='nominal' />
        <column caption='Vehicle Type' datatype='string' name='[vehicle_type]' role='dimension' type='nominal' />
        <column-instance column='[last_contract_start_at]' derivation='Year' name='[yr:last_contract_start_at:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='12' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98770' id='39' param='horz' type-v2='layout-flow' w='98770' x='615' y='615'>
            <zone h='98770' id='37' type-v2='layout-basic' w='98770' x='615' y='615'>
              <zone h='3990' id='11' param='vert' type-v2='layout-flow' w='98770' x='615' y='615'>
                <zone h='3990' id='10' param='horz' type-v2='layout-flow' w='98770' x='615' y='615'>
                  <zone h='3374' id='8' is-centered='0' is-scaled='1' param='Image/talabat logo_Secondary_EN_RGB_Brown 2.png' type-v2='bitmap' w='45769' x='923' y='923'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
