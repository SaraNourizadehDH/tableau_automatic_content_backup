      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4BD74D56CBD34AC7AB51E5CA085980BD'>
            <properties context=''>
              <relation connection='bigquery.0kjli6h0ebvfpn1cxd75z1sjv695' name='Custom SQL Query' type='text'>-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- Here: base_activity = riders active in the last 30 days (adjust as needed)

WITH vehicles_month AS (
  SELECT
    LOWER(a.country_code)             AS country_code_norm,
    b.rider_id,
    DATE_TRUNC(b.created_date, MONTH) AS active_month,
    a.vehicle_type
  FROM `tlb-data-prod.data_platform.dim_logistics_rider_vehicle` a
  JOIN `tlb-data-prod.data_platform.fct_logistics_rider_shift`   b
    ON a.vehicle_id   = b.vehicle_id
   AND a.country_code = b.country_code
  WHERE b.created_date &gt;&gt;= DATE &apos;2024-12-01&apos;
  QUALIFY
    ROW_NUMBER() OVER (
      PARTITION BY LOWER(a.country_code), b.rider_id, DATE_TRUNC(b.created_date, MONTH)
      ORDER BY b.shift_start_at DESC
    ) = 1
),

base_activity AS (
  SELECT
    r.country_code,
    r.city_name,
    r.rider_id,
    MAX(r.date) AS last_order_date,
    DATE_TRUNC(MAX(r.date), MONTH) AS active_month  -- month S
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r
  WHERE r.total_completed_logistics_deliveries &gt;&gt; 0
    AND r.date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) 
                   AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) 
  GROUP BY r.country_code, r.city_name, r.rider_id
),

adjusted_base AS (
  SELECT 
    b.*,
    MIN(r.date) AS first_order_date
  FROM base_activity b
  LEFT JOIN `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` r 
    USING (country_code, rider_id) 
  GROUP BY ALL
),

vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))           AS country_code_norm,
    CAST(rider_id AS STRING)            AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
)

SELECT
  b.country_code,
  b.city_name,
  b.rider_id,
  dl.rider_name,
  dl.rider_email,
  dl.phone_number,
  dl.last_contract_name,
  dl.is_active,
  dl.vehicle,
  vm.vehicle_type,   -- added vehicle_type from vehicles_month
  b.last_order_date,
  b.first_order_date,
  CASE 
    WHEN v.is_valid_delivery_associate IS NULL 
    THEN FALSE 
    ELSE v.is_valid_delivery_associate 
  END AS is_valid_delivery_associate                      
FROM adjusted_base b
LEFT JOIN vda_prev v
  ON LOWER(TRIM(b.country_code)) = v.country_code_norm
 AND CAST(b.rider_id AS STRING)   = v.rider_id_norm
 AND v.active_month               = DATE_SUB(b.active_month, INTERVAL 1 MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl 
  ON b.country_code = dl.country_code 
 AND b.rider_id     = dl.rider_id
LEFT JOIN vehicles_month vm
  ON LOWER(b.country_code) = vm.country_code_norm
 AND b.rider_id            = vm.rider_id
 AND b.active_month        = vm.active_month</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='fct_logistics_churn' inline='true' name='federated.1i5ir2g0p9ape819tjabe0blwmmg' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.06z5hlh0sblmpg1fpa31x077zj8j'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='balderick.bissessur@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.06z5hlh0sblmpg1fpa31x077zj8j' name='Custom SQL Query' type='text'><![CDATA[-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- + vehicle_type carried through correctly.
WITH
-- 0) One vehicle per rider-month, using the LATEST shift in that month
vehicles_month AS (
  SELECT
    LOWER(a.country_code)                      AS country_code_norm,
    b.rider_id,
    DATE_TRUNC(b.created_date, MONTH)          AS active_month,
    a.vehicle_type
  FROM `tlb-data-prod.data_platform.dim_logistics_rider_vehicle` a
  JOIN `tlb-data-prod.data_platform.fct_logistics_rider_shift`   b
    ON a.vehicle_id   = b.vehicle_id
   AND a.country_code = b.country_code
  WHERE b.created_date >>= DATE '2024-12-01'
  QUALIFY
    ROW_NUMBER() OVER (
      PARTITION BY LOWER(a.country_code), b.rider_id, DATE_TRUNC(b.created_date, MONTH)
      ORDER BY b.shift_start_at DESC
    ) = 1
),

-- 1) Rider-month activity (any delivery >> 0)
base_activity AS (
  SELECT
    country_code,
    city_name,
    rider_id,
    DATE_TRUNC(date, MONTH) AS active_month
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily`
  WHERE total_completed_logistics_deliveries >> 0
    AND date >>= DATE '2024-12-01'
),

-- 2) Country-level and Dubai slices; union together
country_level AS (
  SELECT country_code, CAST(NULL AS STRING) AS city_name, rider_id, active_month
  FROM base_activity
),
dubai_only AS (
  SELECT country_code, 'Dubai' AS city_name, rider_id, active_month
  FROM base_activity
  WHERE LOWER(city_name) = 'dubai'
),
activity AS (
  SELECT * FROM country_level
  UNION ALL
  SELECT * FROM dubai_only
),

-- 3) Reporting months S this year, excluding current month
months_of_year AS (
  SELECT DISTINCT
    a.active_month AS month_s,
    DATE_SUB(a.active_month, INTERVAL 1 MONTH) AS month_p
  FROM activity a
  WHERE EXTRACT(YEAR FROM a.active_month) = EXTRACT(YEAR FROM CURRENT_DATE())
    AND a.active_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
),

-- 4) Riders active in previous month P
riders_prev AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    moy.month_s,  -- S
    moy.month_p   -- P
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_p
),

-- 5) Riders active in reporting month S
riders_curr AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    a.active_month AS month_s
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_s
),

-- 6) VDA flags (normalized)
vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))                   AS country_code_norm,
    CAST(rider_id AS STRING)                    AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE)  AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
),

/* 6b) Active base in S by VDA(S) and vehicle_type(S) */
active_riders_month_by_flag AS (
  SELECT
    rc.country_code,
    rc.city_name,
    rc.month_s,
    IFNULL(v_s.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in S
    vm_s.vehicle_type,                              -- vehicle_type in S
    COUNT(DISTINCT rc.rider_id) AS active_riders_by_flag
  FROM riders_curr rc
  LEFT JOIN vda_prev v_s
    ON v_s.country_code_norm = LOWER(TRIM(rc.country_code))
   AND v_s.rider_id_norm     = CAST(rc.rider_id AS STRING)
   AND v_s.active_month      = rc.month_s
  LEFT JOIN vehicles_month vm_s
    ON vm_s.country_code_norm = LOWER(TRIM(rc.country_code))
   AND vm_s.rider_id          = rc.rider_id
   AND vm_s.active_month      = rc.month_s
  GROUP BY 1,2,3,4,5
),

-- 7) Rider-level churners: active in P, not active in S, carry VDA(P) and vehicle_type(P)
rider_churn_list AS (
  SELECT
    rp.country_code,
    rp.city_name,
    rp.month_s AS active_month,                 -- S (churn month)
    rp.month_p AS prev_month,                   -- P
    rp.rider_id,
    IFNULL(v_p.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in P (S-1)
    vm_p.vehicle_type                              -- vehicle_type in P (S-1)
  FROM riders_prev rp
  LEFT JOIN riders_curr rc
    ON rc.country_code = rp.country_code
   AND IFNULL(rc.city_name,'ALL') = IFNULL(rp.city_name,'ALL')
   AND rc.rider_id = rp.rider_id
   AND rc.month_s  = rp.month_s
  LEFT JOIN vda_prev v_p
    ON v_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND v_p.rider_id_norm     = CAST(rp.rider_id AS STRING)
   AND v_p.active_month      = rp.month_p
  LEFT JOIN vehicles_month vm_p
    ON vm_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND vm_p.rider_id          = rp.rider_id
   AND vm_p.active_month      = rp.month_p
  WHERE rc.rider_id IS NULL  -- not active in S → churned
),

-- 8) De-duplicated rider list with cluster label (carry vehicle_type from P)
rider_list AS (
  SELECT DISTINCT
    CASE WHEN city_name = 'Dubai' THEN 'Dubai' ELSE country_code END AS cluster,
    active_month,
    prev_month,
    country_code,
    city_name,
    rider_id,
    is_valid_delivery_associate,   -- VDA in P (S-1)
    vehicle_type                   -- vehicle_type in P (S-1)
  FROM rider_churn_list
)

-- 9) Final: churners by VDA(P) & vehicle_type(P) + active base by VDA(S) & vehicle_type(S)
SELECT
  rl.cluster,
  rl.active_month,
  rl.is_valid_delivery_associate,        -- S-1 flag for churn
  rl.vehicle_type,                        -- from P
  COUNT(DISTINCT rl.rider_id) AS churned_riders,
  COALESCE(arbf.active_riders_by_flag, 0) AS active_riders  -- split by VDA(S), vehicle_type(S)
FROM rider_list rl
LEFT JOIN active_riders_month_by_flag arbf
  ON arbf.country_code = rl.country_code
 AND IFNULL(arbf.city_name,'ALL') = IFNULL(rl.city_name,'ALL')
 AND arbf.month_s = rl.active_month
 AND arbf.is_valid_delivery_associate = rl.is_valid_delivery_associate
 AND (arbf.vehicle_type = rl.vehicle_type OR (arbf.vehicle_type IS NULL AND rl.vehicle_type IS NULL))
GROUP BY ALL
ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.06z5hlh0sblmpg1fpa31x077zj8j' name='Custom SQL Query' type='text'><![CDATA[-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- + vehicle_type carried through correctly.
WITH
-- 0) One vehicle per rider-month, using the LATEST shift in that month
vehicles_month AS (
  SELECT
    LOWER(a.country_code)                      AS country_code_norm,
    b.rider_id,
    DATE_TRUNC(b.created_date, MONTH)          AS active_month,
    a.vehicle_type
  FROM `tlb-data-prod.data_platform.dim_logistics_rider_vehicle` a
  JOIN `tlb-data-prod.data_platform.fct_logistics_rider_shift`   b
    ON a.vehicle_id   = b.vehicle_id
   AND a.country_code = b.country_code
  WHERE b.created_date >>= DATE '2024-12-01'
  QUALIFY
    ROW_NUMBER() OVER (
      PARTITION BY LOWER(a.country_code), b.rider_id, DATE_TRUNC(b.created_date, MONTH)
      ORDER BY b.shift_start_at DESC
    ) = 1
),

-- 1) Rider-month activity (any delivery >> 0)
base_activity AS (
  SELECT
    country_code,
    city_name,
    rider_id,
    DATE_TRUNC(date, MONTH) AS active_month
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily`
  WHERE total_completed_logistics_deliveries >> 0
    AND date >>= DATE '2024-12-01'
),

-- 2) Country-level and Dubai slices; union together
country_level AS (
  SELECT country_code, CAST(NULL AS STRING) AS city_name, rider_id, active_month
  FROM base_activity
),
dubai_only AS (
  SELECT country_code, 'Dubai' AS city_name, rider_id, active_month
  FROM base_activity
  WHERE LOWER(city_name) = 'dubai'
),
activity AS (
  SELECT * FROM country_level
  UNION ALL
  SELECT * FROM dubai_only
),

-- 3) Reporting months S this year, excluding current month
months_of_year AS (
  SELECT DISTINCT
    a.active_month AS month_s,
    DATE_SUB(a.active_month, INTERVAL 1 MONTH) AS month_p
  FROM activity a
  WHERE EXTRACT(YEAR FROM a.active_month) = EXTRACT(YEAR FROM CURRENT_DATE())
    AND a.active_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
),

-- 4) Riders active in previous month P
riders_prev AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    moy.month_s,  -- S
    moy.month_p   -- P
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_p
),

-- 5) Riders active in reporting month S
riders_curr AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    a.active_month AS month_s
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_s
),

-- 6) VDA flags (normalized)
vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))                   AS country_code_norm,
    CAST(rider_id AS STRING)                    AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE)  AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
),

/* 6b) Active base in S by VDA(S) and vehicle_type(S) */
active_riders_month_by_flag AS (
  SELECT
    rc.country_code,
    rc.city_name,
    rc.month_s,
    IFNULL(v_s.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in S
    vm_s.vehicle_type,                              -- vehicle_type in S
    COUNT(DISTINCT rc.rider_id) AS active_riders_by_flag
  FROM riders_curr rc
  LEFT JOIN vda_prev v_s
    ON v_s.country_code_norm = LOWER(TRIM(rc.country_code))
   AND v_s.rider_id_norm     = CAST(rc.rider_id AS STRING)
   AND v_s.active_month      = rc.month_s
  LEFT JOIN vehicles_month vm_s
    ON vm_s.country_code_norm = LOWER(TRIM(rc.country_code))
   AND vm_s.rider_id          = rc.rider_id
   AND vm_s.active_month      = rc.month_s
  GROUP BY 1,2,3,4,5
),

-- 7) Rider-level churners: active in P, not active in S, carry VDA(P) and vehicle_type(P)
rider_churn_list AS (
  SELECT
    rp.country_code,
    rp.city_name,
    rp.month_s AS active_month,                 -- S (churn month)
    rp.month_p AS prev_month,                   -- P
    rp.rider_id,
    IFNULL(v_p.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in P (S-1)
    vm_p.vehicle_type                              -- vehicle_type in P (S-1)
  FROM riders_prev rp
  LEFT JOIN riders_curr rc
    ON rc.country_code = rp.country_code
   AND IFNULL(rc.city_name,'ALL') = IFNULL(rp.city_name,'ALL')
   AND rc.rider_id = rp.rider_id
   AND rc.month_s  = rp.month_s
  LEFT JOIN vda_prev v_p
    ON v_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND v_p.rider_id_norm     = CAST(rp.rider_id AS STRING)
   AND v_p.active_month      = rp.month_p
  LEFT JOIN vehicles_month vm_p
    ON vm_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND vm_p.rider_id          = rp.rider_id
   AND vm_p.active_month      = rp.month_p
  WHERE rc.rider_id IS NULL  -- not active in S → churned
),

-- 8) De-duplicated rider list with cluster label (carry vehicle_type from P)
rider_list AS (
  SELECT DISTINCT
    CASE WHEN city_name = 'Dubai' THEN 'Dubai' ELSE country_code END AS cluster,
    active_month,
    prev_month,
    country_code,
    city_name,
    rider_id,
    is_valid_delivery_associate,   -- VDA in P (S-1)
    vehicle_type                   -- vehicle_type in P (S-1)
  FROM rider_churn_list
)

-- 9) Final: churners by VDA(P) & vehicle_type(P) + active base by VDA(S) & vehicle_type(S)
SELECT
  rl.cluster,
  rl.active_month,
  rl.is_valid_delivery_associate,        -- S-1 flag for churn
  rl.vehicle_type,                        -- from P
  COUNT(DISTINCT rl.rider_id) AS churned_riders,
  COALESCE(arbf.active_riders_by_flag, 0) AS active_riders  -- split by VDA(S), vehicle_type(S)
FROM rider_list rl
LEFT JOIN active_riders_month_by_flag arbf
  ON arbf.country_code = rl.country_code
 AND IFNULL(arbf.city_name,'ALL') = IFNULL(rl.city_name,'ALL')
 AND arbf.month_s = rl.active_month
 AND arbf.is_valid_delivery_associate = rl.is_valid_delivery_associate
 AND (arbf.vehicle_type = rl.vehicle_type OR (arbf.vehicle_type IS NULL AND rl.vehicle_type IS NULL))
GROUP BY ALL
ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
