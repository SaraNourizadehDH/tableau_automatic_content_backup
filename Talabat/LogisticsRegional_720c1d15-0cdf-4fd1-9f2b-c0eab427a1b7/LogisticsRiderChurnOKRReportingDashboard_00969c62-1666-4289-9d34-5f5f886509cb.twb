      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/LogisticsRiderChurnOKRReportingDashboard_17576600464500/RollingView?rev=' id='RollingView' path='/t/Talabat/workbooks/LogisticsRiderChurnOKRReportingDashboard_17576600464500' revision='' site='Talabat' />
      <style>
