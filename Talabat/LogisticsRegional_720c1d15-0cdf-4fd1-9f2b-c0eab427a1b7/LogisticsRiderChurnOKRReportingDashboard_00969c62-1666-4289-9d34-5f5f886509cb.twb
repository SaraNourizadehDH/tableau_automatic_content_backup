    moy.month_s,  -- S
    moy.month_p   -- P
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_p
),

-- 5) Riders active in reporting month S
riders_curr AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    a.active_month AS month_s
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_s
),

-- 6) VDA flags (normalized)
vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))                   AS country_code_norm,
    CAST(rider_id AS STRING)                    AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE)  AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
),

-- 7) Rider-level churners: active in P, not active in S, carry VDA(P) and vehicle_type(P)
rider_churn_list AS (
  SELECT
    rp.country_code,
    rp.city_name,
    rp.month_s AS active_month,                 -- S (churn month)
    rp.month_p AS prev_month,                   -- P
    rp.rider_id,
    IFNULL(v_p.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in P (S-1)
    vm_p.vehicle_type                                                   -- vehicle_type in P (S-1), aliased to 'vehicle' to match Query 1
  FROM riders_prev rp
  LEFT JOIN riders_curr rc
    ON rc.country_code = rp.country_code
   AND IFNULL(rc.city_name,'ALL') = IFNULL(rp.city_name,'ALL')
   AND rc.rider_id = rp.rider_id
   AND rc.month_s  = rp.month_s
  LEFT JOIN vda_prev v_p
    ON v_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND v_p.rider_id_norm     = CAST(rp.rider_id AS STRING)
   AND v_p.active_month      = rp.month_p
  LEFT JOIN vehicles_month vm_p
    ON vm_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND vm_p.rider_id          = rp.rider_id
   AND vm_p.active_month      = rp.month_p
  WHERE rc.rider_id IS NULL  -- not active in S → churned
),

-- 8) De-duplicated rider list with cluster label (match column names to Query 1)
rider_list AS (
