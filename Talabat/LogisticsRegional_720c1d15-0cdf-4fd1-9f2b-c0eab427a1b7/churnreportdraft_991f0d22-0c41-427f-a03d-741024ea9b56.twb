        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0smunts1kz90h61apxcs919qg92x' name='Custom SQL Query' type='text'>with a as (

SELECT  
a.country_code,
city_name,
--extract(month from month_date) month,
a.date as week_date,
case when lower(vehicle_type) = &apos;car&apos; then &apos;car&apos;
when lower(vehicle_type) = &apos;bike&apos; then &apos;bike&apos;
else &apos;other&apos; end as vehicle_type,
count(distinct (case when rider_weekly_status = &apos;churn - no contract&apos; then a.rider_id end)) churn_no_contract,
count(distinct (case when rider_weekly_status = &apos;newbie&apos; then a.rider_id end)) newbie,
count(distinct (case when rider_weekly_status = &apos;terminated rider&apos; then a.rider_id end)) terminated_rider,
count(distinct (case when rider_weekly_status = &apos;join new fleet and terminated&apos; then a.rider_id end)) join_new_fleet_and_terminated,
count(distinct (case when rider_weekly_status = &apos;inactive newbie - no contract&apos; then a.rider_id end)) inactive_newbie_no_contract,
count(distinct (case when rider_weekly_status = &apos;reactivated&apos; then a.rider_id end)) reactivated,
count(distinct (case when rider_weekly_status = &apos;revived terminated&apos; then a.rider_id end)) revived_terminated,
count(distinct (case when rider_weekly_status = &apos;newbie exit fleet&apos; then a.rider_id end)) newbie_exit_fleet,
count(distinct (case when rider_weekly_status = &apos;revived inactive - exit fleet&apos; then a.rider_id end)) revived_inactive_exit_fleet,
count(distinct (case when rider_weekly_status = &apos;terminated newbie&apos; then a.rider_id end)) terminated_newbie,
count(distinct (case when rider_weekly_status = &apos;join and exit fleet&apos; then a.rider_id end)) join_and_exit_fleet,
count(distinct (case when rider_weekly_status = &apos;absent rider&apos; then a.rider_id end)) absent_rider,
count(distinct (case when rider_weekly_status = &apos;old churn&apos; then a.rider_id end)) old_churn,
count(distinct (case when rider_weekly_status = &apos;inactive newbie - old contract&apos; then a.rider_id end)) inactive_newbie_old_contract,
count(distinct (case when rider_weekly_status = &apos;churn this week&apos; then a.rider_id end)) churn_this_week,
count(distinct (case when rider_weekly_status = &apos;inactive newbie - new contract&apos; then a.rider_id end)) inactive_newbie_new_contract,
count(distinct (case when rider_weekly_status = &apos;revived&apos; then a.rider_id end)) revived,
count(distinct (case when rider_weekly_status = &apos;revived - exit fleet&apos; then a.rider_id end)) revived_exit_fleet,
count(distinct (case when rider_weekly_status = &apos;active&apos; then a.rider_id end)) active,   
count(distinct (case when rider_weekly_status = &apos;revived inactive&apos; then a.rider_id end)) revived_inactive,
count(distinct (case when rider_weekly_status = &apos;join new fleet&apos; then a.rider_id end)) join_new_fleet,
count(distinct (case when rider_weekly_status = &apos;exit fleet&apos; then a.rider_id end)) exit_fleet,


---------OB-----------
-- (
-- count(distinct (case when rider_weekly_status = &apos;active&apos; then a.rider_id end)) 
-- +
-- count(distinct (case when rider_weekly_status = &apos;churn this week&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;old churn&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;reactivated&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;inactive newbie - old contract&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;absent rider&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;terminated rider&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;exit fleet&apos; then a.rider_id end))
-- ) as fleet_ob,



-------------CB---------

-- (
--   count(distinct (case when rider_weekly_status = &apos;active&apos; then a.rider_id end)) 
-- +
-- count(distinct (case when rider_weekly_status = &apos;churn this week&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;old churn&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;reactivated&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;inactive newbie - old contract&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;absent rider&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;terminated rider&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;exit fleet&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;newbie&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;join new fleet&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;revived&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;revived inactive&apos; then a.rider_id end))
-- +
-- count(distinct (case when rider_weekly_status = &apos;inactive newbie - new contract&apos; then a.rider_id end))
-- -
-- count(distinct (case when rider_weekly_status = &apos;terminated rider&apos; then a.rider_id end))
-- ) as fleet_cb


FROM
`tlb-data-prod.data_platform.agg_logistics_rider_performance_weekly` a

--
left join
(
  select
    distinct
    date_trunc(dd.date,week(Monday)) as date,
    cnt.rider_id,
    cnt.country_code,
    last_value(cnt.city_name ignore nulls) over(partition by date_trunc(dd.date,week(Monday)), cnt.rider_id order by cnt.start_at, cnt.end_at) as city_name
  from
    `tlb-data-prod.data_platform.dim_date` dd
    left join `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` cnt
    on dd.date between date(cnt.start_at) and date(cnt.end_at)
  where
    dd.date between &apos;2024-01-01&apos; and current_date 
    -- and country_code = &apos;eg&apos;
  qualify rank() over(partition by date_trunc(dd.date,week(Monday)), cnt.rider_id order by start_at desc, end_at desc) = 1
) b
on a.country_code = b.country_code
and a.rider_id = b.rider_id
and a.date = b.date
--
where
  a.date &gt;&gt;= &apos;2024-01-01&apos;
-- and a.country_code = &apos;eg&apos;
group by rollup(1,2,3,4)
order by 2,3


)

select * 

from a 
where week_date is not null</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
