      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2FCE3FC388D347289E9DF30EEB71BDA8'>
            <properties context=''>
              <relation connection='bigquery.1fetscm0vju70818202400sa548m' name='Custom SQL Query' type='text'><![CDATA[with a as (
  WITH RIDER_COUNTS AS
(
  SELECT
    country_code,
    city_name,
    c.date as month_start_date,
    last_day(c.date) as month_end_date,
    count(distinct (case when rider_cohort = 'active rider' then rider_id end)) active_rider,
    count(distinct (case when rider_cohort = 'reactivated rider' then rider_id end)) reactivated_rider,
    count(distinct (case when rider_cohort = 'churned this month' then rider_id end)) churned_this_month,
    count(distinct (case when rider_cohort = 'inactive newbie - new contract' then rider_id end)) inactive_newbie_new_contract,
    count(distinct (case when rider_cohort = 'inactive newbie - old contract' then rider_id end)) inactive_newbie_old_contract,
    count(distinct (case when rider_cohort = 'terminated newbie rider' then rider_id end)) terminated_newbie_rider,
    count(distinct (case when rider_cohort = 'newbie' then rider_id end)) newbie,
    count(distinct (case when rider_cohort = 'revived rider' then rider_id end)) revived_rider,
    count(distinct (case when rider_cohort = 'terminated rider' then rider_id end)) terminated_rider,
    count(distinct (case when rider_cohort = 'revived terminated rider' then rider_id end)) revived_terminated_rider,
    --
    count(distinct (case when rider_cohort in ('active rider','reactivated rider','churned this month','inactive newbie - old contract','terminated rider') then rider_id end)) opening_balance,
    count(distinct (case when rider_cohort in ('active rider','reactivated rider','churned this month','inactive newbie - new contract', 'inactive newbie - old contract','newbie', 'revived rider') then rider_id end)) closing_balance

  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_monthly` c
  where
    c.date >>= '2024-01-01'
  -- and country_code = 'ae'
  group by 1,2,3,4
)


SELECT
  country_code,
  city_name,
  month_start_date,
  month_end_date,
  active_rider,
  reactivated_rider,
  churned_this_month,
  inactive_newbie_new_contract,
  inactive_newbie_old_contract,
  terminated_newbie_rider,
  newbie,
  revived_rider,
  terminated_rider,
  revived_terminated_rider,
  opening_balance,
  LEAD(opening_balance) OVER(PARTITION BY country_code, city_name ORDER BY month_end_date ASC) as closing_balance,
  CASE
    WHEN closing_balance - LEAD(opening_balance) OVER(PARTITION BY country_code, city_name ORDER BY month_end_date ASC) << 0
    THEN closing_balance - LEAD(opening_balance) OVER(PARTITION BY country_code, city_name ORDER BY month_end_date ASC)
    ELSE 0
  END AS moved_out_from_city,
  CASE
    WHEN closing_balance - LEAD(opening_balance) OVER(PARTITION BY country_code, city_name ORDER BY month_end_date ASC) >> 0
    THEN closing_balance - LEAD(opening_balance) OVER(PARTITION BY country_code, city_name ORDER BY month_end_date ASC)
    ELSE 0
  END AS moved_in_to_city

FROM
  RIDER_COUNTS
ORDER BY
  city_name,
  month_start_date
)

select
 
* except (moved_out_from_city,moved_in_to_city),
if (moved_out_from_city << 0, moved_out_from_city*-1,moved_out_from_city) as moved_out_from_city,
if (moved_in_to_city << 0, moved_in_to_city*-1,moved_in_to_city) as moved_in_to_city

from a]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
