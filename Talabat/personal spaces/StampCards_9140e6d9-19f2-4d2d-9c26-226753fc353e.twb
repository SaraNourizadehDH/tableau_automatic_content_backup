  count(reward_id) as reward_cnt,
  count(reward_redeemed_at_time_utc) as reward_redeemed_cnt,
  sum(stamps_collected_count) as stamps_collected_cnt
from  
  `tlb-data-prod.data_platform.dim_stamp_card_campaign_detail`  dsccd
left join
