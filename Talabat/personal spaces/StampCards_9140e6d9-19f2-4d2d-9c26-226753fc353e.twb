      <aliases enabled='yes' />
      <column caption='Stampcards (1 stamp)' datatype='integer' name='[Calculation_6722115091910500396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stamps_collected_count] = 1 THEN [stampcard_cnt] END' />
      </column>
      <column caption='Stampcards (2 stamps)' datatype='integer' name='[Calculation_6722115091911106605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stamps_collected_count] = 2 THEN [stampcard_cnt] END' />
      </column>
      <column caption='Stampcards (3 stamps)' datatype='integer' name='[Calculation_6722115091911249966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stamps_collected_count] = 3 THEN [stampcard_cnt] END' />
      </column>
      <column caption='Completion Rate, %' datatype='real' name='[Calculation_6722115091912441903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reward_cnt]) / SUM([stampcard_cnt])' />
      </column>
      <column caption='Redemption Rate, %' datatype='real' name='[Calculation_6722115091913502768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reward_redeemed_cnt]) / SUM ([reward_cnt])' />
      </column>
