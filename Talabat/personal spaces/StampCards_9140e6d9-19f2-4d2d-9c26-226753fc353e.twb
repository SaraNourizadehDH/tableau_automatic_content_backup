      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='stamp_cards_chain_lvl_daily' id='_02C421330ADD4581B871702C74D9B2BB'>
            <properties context=''>
              <relation connection='bigquery.1o0tew10p7taib11xr8l11q3ab0x' name='Custom SQL Query' type='text'>select 
  dsccd.country_code, 
  act.chain_monetisation_tiers,
  dc.main_cuisine,
  dc.chain_id,
  dc.chain_name,
  created_at_date_utc, 
  stamps_collected_count,
  count(distinct dc.chain_id) as chain_cnt,
  count(stamp_card_id) as stampcard_cnt,
  count(reward_id) as reward_cnt,
  count(reward_redeemed_at_time_utc) as reward_redeemed_cnt,
  sum(stamps_collected_count) as stamps_collected_cnt
from  
  `tlb-data-prod.data_platform.dim_stamp_card_campaign_detail`  dsccd
left join
  `tlb-data-prod.data_platform.dim_chain` dc using(chain_id)
left join
  `tlb-data-prod.data_platform.agg_chain_tiers` act on dsccd.chain_id = act.chain_id and act.date = &apos;2025-04-01&apos;
where 
  created_at_date_utc &gt;&gt;= &apos;2025-03-12&apos; 
  and dsccd.country_code in (&apos;BH&apos;, &apos;IQ&apos;, &apos;JO&apos;)
group by
  all 
order by 
  country_code</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
