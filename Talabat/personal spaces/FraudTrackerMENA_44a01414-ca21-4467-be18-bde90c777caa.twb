        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
        </column>
        <column alias='Yes' caption='Break By Country' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <aliases>
            <alias key='false' value='No' />
            <alias key='true' value='Yes' />
          </aliases>
        </column>
        <column alias='Yes' caption='Break By Fraud Pillar' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <aliases>
            <alias key='false' value='No' />
            <alias key='true' value='Yes' />
          </aliases>
        </column>
        <column caption='Calculation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;sum of issues&quot;'>
          <calculation class='tableau' formula='&quot;sum of issues&quot;' />
        </column>
        <column caption='Measures Parameter' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;date&quot;'>
          <calculation class='tableau' formula='&quot;date&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_51AA941B52B34684B9E22CE56E1F8838'>
            <properties context=''>
              <relation connection='bigquery.1w92zc10gvltyt1aeutj90pkygeh' name='Custom SQL Query' type='text'><![CDATA[WITH issues AS (
SELECT
date(created_at,timezone) as date,
country_code,
rider_id,
issue_name,
count(distinct issue_id) as issue_count

FROM `fulfillment-dwh-production.curated_data_shared.issues`


WHERE 1=1
and date_trunc(date(created_at, timezone), week) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 8 WEEK)
AND issue_name IN ('Courier Fake GPS Usage Detected','Courier GPS off for X minutes','Dropoff - no gps and delayed','Order clicked through')
AND rider_id IS NOT NULL

GROUP BY 1,2,3,4
),
------------------------------------------------------------------------------------------------------------------------------------------------
contacts_cte AS (
select
contacts.created_date_localtime,
o.country_code,
o.primary_rider_id as rider_id,
contacts.contact_reason_l3 as issue_name,
count(distinct contacts.order_id) as issue_count

from `fulfillment-dwh-production.curated_data_shared.all_contacts` as contacts

left join `tlb-data-prod.data_platform.fct_logistics_order` as o
on cast(o.order_id as string) = contacts.order_id
and o.entity_id = contacts.global_entity_id

where 1=1
--and contacts.created_date_localtime >>= '2024-11-01'
--and global_entity_id = 'TB_BH'
and date_trunc(contacts.created_date_localtime,week) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 8 WEEK)
and (global_entity_id LIKE '%TB%' OR global_entity_id LIKE '%HF_EG%')
and global_entity_id <<>> 'TB_SA'
and stakeholder = 'Customer'
--and channel = 'Chat'
and contacts.contact_reason_l3 in ("Order marked as delivered but didn't receive","Missing item")
and o.primary_rider_id is not null
and is_rider_order
and is_talabat
group by 1,2,3,4
),
------------------------------------------------------------------------------------------------------------------------------------------------
unioned_query as (
select *

from issues

UNION ALL

select *

from contacts_cte
)
------------------------------------------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------------------------------------------
select
unioned_query.*,

performance.city_name,
performance.contract_name,
performance.is_active,
performance.tenure_weeks,
performance.current_batch_number,
performance.total_logistics_orders,
performance.vehicle_name


from unioned_query


left join `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance` as performance
on performance.rider_id = unioned_query.rider_id
and lower(performance.country_code) = lower(unioned_query.country_code)
and performance.created_date = unioned_query.date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='City / Reason'>
      <repository-location derived-from='http://ip-172-31-0-141:8162/t/Talabat/workbooks/FraudTrackerMENA/CountryReason?rev=' id='CountryReason' path='/t/Talabat/workbooks/FraudTrackerMENA' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.1mnc5mb11imslp11avsy30zf9h9g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Calculation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;sum of issues&quot;'>
              <calculation class='tableau' formula='&quot;sum of issues&quot;' />
            </column>
            <column caption='Measures Parameter' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;date&quot;'>
              <calculation class='tableau' formula='&quot;date&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mnc5mb11imslp11avsy30zf9h9g'>
            <column caption='date agg.' datatype='date' name='[Calculation_3575576642946347009]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;day&apos; THEN DATE(DATETRUNC(&apos;day&apos;, [date]))&#13;&#10;    WHEN &apos;week&apos; THEN DATE(DATETRUNC(&apos;week&apos;, [date]))&#13;&#10;    WHEN &apos;month&apos; THEN DATE(DATETRUNC(&apos;month&apos;, [date]))&#13;&#10;    WHEN &apos;quarter&apos; THEN DATE(DATETRUNC(&apos;quarter&apos;, [date]))&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Dynamic Measures Field' datatype='string' name='[Calculation_4493044330208153627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;date&apos; THEN STR([Calculation_3575576642946347009])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;fraud pillar&apos; THEN [issue_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;vehicle type&apos; THEN [vehicle_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;tenure&apos; THEN [Calculation_4493044330211336220]&#10;END' />
              <aliases>
                <alias key='&quot;Courier Fake GPS Usage Detected&quot;' value='Courier Fake GPS Usage Detected' />
              </aliases>
            </column>
            <column caption='tenure bins' datatype='string' name='[Calculation_4493044330211336220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tenure_weeks] &lt; 4 THEN &apos;&lt; 4&apos;&#10;ELSEIF [tenure_weeks] &gt;= 4 AND [tenure_weeks] &lt; 8 THEN &apos;4 - 8&apos;&#10;ELSEIF [tenure_weeks] &gt;= 8 AND [tenure_weeks] &lt; 12 THEN &apos;8 - 12&apos;&#10;ELSEIF [tenure_weeks] &gt;= 12 AND [tenure_weeks] &lt; 16 THEN &apos;12 - 16&apos;&#10;ELSEIF [tenure_weeks] &gt;= 16 AND [tenure_weeks] &lt; 20 THEN &apos;16 - 20&apos;&#10;ELSEIF [tenure_weeks] &gt;= 20 AND [tenure_weeks] &lt; 24 THEN &apos;20 - 24&apos;&#10;ELSEIF [tenure_weeks] &gt;= 24 AND [tenure_weeks] &lt; 28 THEN &apos;24 - 28&apos;&#10;ELSEIF [tenure_weeks] &gt;= 28 AND [tenure_weeks] &lt; 32 THEN &apos;28 - 32&apos;&#10;ELSEIF [tenure_weeks] &gt;= 32 AND [tenure_weeks] &lt; 36 THEN &apos;32 - 36&apos;&#10;ELSEIF [tenure_weeks] &gt;= 36 AND [tenure_weeks] &lt; 40 THEN &apos;36 - 40&apos;&#10;ELSEIF [tenure_weeks] &gt;= 40 AND [tenure_weeks] &lt; 44 THEN &apos;40 - 44&apos;&#10;ELSEIF [tenure_weeks] &gt;= 44 AND [tenure_weeks] &lt; 48 THEN &apos;44 - 48&apos;&#10;ELSEIF [tenure_weeks] &gt;= 48 AND [tenure_weeks] &lt; 52 THEN &apos;48 - 52&apos;&#10;ELSE &apos;&gt; 52&apos;&#10;END' />
            </column>
            <column caption='Country Level Riders' datatype='integer' name='[Calculation_6334946209431130130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code],DATETRUNC([Parameters].[Parameter 1],[date]) : COUNTD([rider_id])}' />
            </column>
            <column caption='week number' datatype='string' datatype-customized='true' name='[Calculation_6334946209432915987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(WEEK([date]))' />
            </column>
            <column caption='issue per rider' datatype='real' name='[Calculation_8966596503788982284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([issue_count]) / COUNTD([rider_id])' />
            </column>
            <column caption='Calculation Field' datatype='real' name='[Calculation_8966596503789264909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;issue per rider&apos; then [Calculation_8966596503788982284]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;sum of issues&apos; then SUM([issue_count])&#10;END' />
            </column>
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[rider_id]' derivation='CountD' name='[ctd:rider_id:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[issue_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[issue_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Courier GPS off for X minutes&quot;' value='Courier GPS off for X minutes' />
              </aliases>
            </column>
