      <aliases enabled='yes' />
      <column caption='date agg.' datatype='date' name='[Calculation_3575576642946347009]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;day&apos; THEN DATE(DATETRUNC(&apos;day&apos;, [date]))&#13;&#10;    WHEN &apos;week&apos; THEN DATE(DATETRUNC(&apos;week&apos;, [date]))&#13;&#10;    WHEN &apos;month&apos; THEN DATE(DATETRUNC(&apos;month&apos;, [date]))&#13;&#10;    WHEN &apos;quarter&apos; THEN DATE(DATETRUNC(&apos;quarter&apos;, [date]))&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='country break field' datatype='string' name='[Calculation_3575576642947616770]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = TRUE THEN [country_code]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = FALSE THEN &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Measures Field' datatype='string' name='[Calculation_4493044330208153627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;date&apos; THEN STR([Calculation_3575576642946347009])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;fraud pillar&apos; THEN [issue_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;vehicle type&apos; THEN [vehicle_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;tenure&apos; THEN [Calculation_4493044330211336220]&#10;END' />
        <aliases>
          <alias key='&quot;Courier Fake GPS Usage Detected&quot;' value='Courier Fake GPS Usage Detected' />
        </aliases>
      </column>
      <column caption='tenure bins' datatype='string' name='[Calculation_4493044330211336220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure_weeks] &lt; 4 THEN &apos;&lt; 4&apos;&#10;ELSEIF [tenure_weeks] &gt;= 4 AND [tenure_weeks] &lt; 8 THEN &apos;4 - 8&apos;&#10;ELSEIF [tenure_weeks] &gt;= 8 AND [tenure_weeks] &lt; 12 THEN &apos;8 - 12&apos;&#10;ELSEIF [tenure_weeks] &gt;= 12 AND [tenure_weeks] &lt; 16 THEN &apos;12 - 16&apos;&#10;ELSEIF [tenure_weeks] &gt;= 16 AND [tenure_weeks] &lt; 20 THEN &apos;16 - 20&apos;&#10;ELSEIF [tenure_weeks] &gt;= 20 AND [tenure_weeks] &lt; 24 THEN &apos;20 - 24&apos;&#10;ELSEIF [tenure_weeks] &gt;= 24 AND [tenure_weeks] &lt; 28 THEN &apos;24 - 28&apos;&#10;ELSEIF [tenure_weeks] &gt;= 28 AND [tenure_weeks] &lt; 32 THEN &apos;28 - 32&apos;&#10;ELSEIF [tenure_weeks] &gt;= 32 AND [tenure_weeks] &lt; 36 THEN &apos;32 - 36&apos;&#10;ELSEIF [tenure_weeks] &gt;= 36 AND [tenure_weeks] &lt; 40 THEN &apos;36 - 40&apos;&#10;ELSEIF [tenure_weeks] &gt;= 40 AND [tenure_weeks] &lt; 44 THEN &apos;40 - 44&apos;&#10;ELSEIF [tenure_weeks] &gt;= 44 AND [tenure_weeks] &lt; 48 THEN &apos;44 - 48&apos;&#10;ELSEIF [tenure_weeks] &gt;= 48 AND [tenure_weeks] &lt; 52 THEN &apos;48 - 52&apos;&#10;ELSE &apos;&gt; 52&apos;&#10;END' />
      </column>
      <column caption='pillar break field' datatype='string' name='[Calculation_6073596692514238478]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = TRUE THEN [issue_name]&#10;ELSEIF [Parameters].[Parameter 3] = FALSE THEN &quot;&quot;&#10;END' />
      </column>
      <column caption='Country Level Riders' datatype='integer' name='[Calculation_6334946209431130130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code],DATETRUNC([Parameters].[Parameter 1],[date]) : COUNTD([rider_id])}' />
      </column>
      <column caption='week number' datatype='string' datatype-customized='true' name='[Calculation_6334946209432915987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(WEEK([date]))' />
      </column>
      <column caption='month field' datatype='datetime' name='[Calculation_6556818863006081036]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
      </column>
      <column caption='Fraud Riders IDs Flag' datatype='integer' name='[Calculation_8644026184068022303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [issue_name] = &apos;Courier Fake GPS Usage Detected&apos; AND [Calculation_8966596507343929368] &gt;= 1 THEN 1&#10;ELSEIF [issue_name] = &apos;Dropoff - no gps and delayed&apos; AND [Calculation_8966596507343929368] &gt;= 2 THEN 1&#10;ELSEIF [issue_name] = &apos;Order clicked through&apos; AND [Calculation_8966596507343929368] &gt;= 2 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;ae&apos; AND [Calculation_8966596507343929368] &gt;= 5 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;bh&apos; AND [Calculation_8966596507343929368] &gt;= 27 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;eg&apos; AND [Calculation_8966596507343929368] &gt;= 8 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;iq&apos; AND [Calculation_8966596507343929368] &gt;= 6 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;jo&apos; AND [Calculation_8966596507343929368] &gt;= 5 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;kw&apos; AND [Calculation_8966596507343929368] &gt;= 11 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;om&apos; AND [Calculation_8966596507343929368] &gt;= 11 THEN 1&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;qa&apos; AND [Calculation_8966596507343929368] &gt;= 8 THEN 1&#10;ELSEIF [issue_name] = &quot;Order marked as delivered but didn&apos;t receive&quot; AND [Calculation_8966596507343929368] &gt;= 2 THEN 1&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;ae&apos; AND [Calculation_8966596507343929368] &gt;= 3 THEN 1&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_co