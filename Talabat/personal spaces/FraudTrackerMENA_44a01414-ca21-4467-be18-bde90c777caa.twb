    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.1mnc5mb11imslp11avsy30zf9h9g' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1w92zc10gvltyt1aeutj90pkygeh'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='server-custom' username='akram.awad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1w92zc10gvltyt1aeutj90pkygeh' name='Custom SQL Query' type='text'><![CDATA[WITH issues AS (
SELECT
date(created_at,timezone) as date,
country_code,
rider_id,
issue_name,
count(distinct issue_id) as issue_count

FROM `fulfillment-dwh-production.curated_data_shared.issues`


WHERE 1=1
and date_trunc(date(created_at, timezone), week) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 8 WEEK)
AND issue_name IN ('Courier Fake GPS Usage Detected','Courier GPS off for X minutes','Dropoff - no gps and delayed','Order clicked through')
AND rider_id IS NOT NULL

GROUP BY 1,2,3,4
),
------------------------------------------------------------------------------------------------------------------------------------------------
contacts_cte AS (
select
contacts.created_date_localtime,
o.country_code,
o.primary_rider_id as rider_id,
contacts.contact_reason_l3 as issue_name,
count(distinct contacts.order_id) as issue_count

from `fulfillment-dwh-production.curated_data_shared.all_contacts` as contacts

left join `tlb-data-prod.data_platform.fct_logistics_order` as o
on cast(o.order_id as string) = contacts.order_id
and o.entity_id = contacts.global_entity_id

where 1=1
--and contacts.created_date_localtime >>= '2024-11-01'
--and global_entity_id = 'TB_BH'
and date_trunc(contacts.created_date_localtime,week) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 8 WEEK)
and (global_entity_id LIKE '%TB%' OR global_entity_id LIKE '%HF_EG%')
and global_entity_id <<>> 'TB_SA'
and stakeholder = 'Customer'
--and channel = 'Chat'
and contacts.contact_reason_l3 in ("Order marked as delivered but didn't receive","Missing item")
and o.primary_rider_id is not null
and is_rider_order
and is_talabat
group by 1,2,3,4
),
------------------------------------------------------------------------------------------------------------------------------------------------
unioned_query as (
select *

from issues

UNION ALL

select *

from contacts_cte
)
------------------------------------------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------------------------------------------
select
unioned_query.*,

performance.city_name,
performance.contract_name,
performance.is_active,
performance.tenure_weeks,
performance.current_batch_number,
performance.total_logistics_orders,
performance.vehicle_name


from unioned_query


left join `tlb-data-prod.data_platform_logistics.agg_logistics_rider_performance` as performance
on performance.rider_id = unioned_query.rider_id
and lower(performance.country_code) = lower(unioned_query.country_code)
and performance.created_date = unioned_query.date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1w92zc10gvltyt1aeutj90pkygeh' name='Custom SQL Query' type='text'><![CDATA[WITH issues AS (
