        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.1mnc5mb11imslp11avsy30zf9h9g' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mnc5mb11imslp11avsy30zf9h9g'>
            <column caption='monthly issue count' datatype='integer' name='[Calculation_8966596507343929368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;month&apos;, [date]), [issue_name], [rider_id]: SUM([issue_count])}' />
            </column>
            <column caption='Fraud Riders IDs' datatype='string' name='[Calculation_8966596507347116058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [issue_name] = &apos;Courier Fake GPS Usage Detected&apos; AND [Calculation_8966596507343929368] &gt;= 1 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Dropoff - no gps and delayed&apos; AND [Calculation_8966596507343929368] &gt;= 2 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Order clicked through&apos; AND [Calculation_8966596507343929368] &gt;= 2 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;ae&apos; AND [Calculation_8966596507343929368] &gt;= 5 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;bh&apos; AND [Calculation_8966596507343929368] &gt;= 27 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;eg&apos; AND [Calculation_8966596507343929368] &gt;= 8 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;iq&apos; AND [Calculation_8966596507343929368] &gt;= 6 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;jo&apos; AND [Calculation_8966596507343929368] &gt;= 5 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;kw&apos; AND [Calculation_8966596507343929368] &gt;= 11 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;om&apos; AND [Calculation_8966596507343929368] &gt;= 11 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Courier GPS off for X minutes&apos; AND [country_code] = &apos;qa&apos; AND [Calculation_8966596507343929368] &gt;= 8 THEN [rider_id]&#10;&#10;ELSEIF [issue_name] = &quot;Order marked as delivered but didn&apos;t receive&quot; AND [Calculation_8966596507343929368] &gt;= 2 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;ae&apos; AND [Calculation_8966596507343929368] &gt;= 3 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;bh&apos; AND [Calculation_8966596507343929368] &gt;= 3 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;eg&apos; AND [Calculation_8966596507343929368] &gt;= 4 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;iq&apos; AND [Calculation_8966596507343929368] &gt;= 4 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;jo&apos; AND [Calculation_8966596507343929368] &gt;= 4 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;kw&apos; AND [Calculation_8966596507343929368] &gt;= 4 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;om&apos; AND [Calculation_8966596507343929368] &gt;= 4 THEN [rider_id]&#10;ELSEIF [issue_name] = &apos;Missing item&apos; AND [country_code] = &apos;qa&apos; AND [Calculation_8966596507343929368] &gt;= 3 THEN [rider_id]&#10;&#10;END' />
            </column>
