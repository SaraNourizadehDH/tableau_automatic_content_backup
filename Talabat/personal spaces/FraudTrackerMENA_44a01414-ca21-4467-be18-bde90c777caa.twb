          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column alias='Yes' caption='Break By Country' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column alias='Yes' caption='Break By Fraud Pillar' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='Calculation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;sum of issues&quot;'>
              <calculation class='tableau' formula='&quot;sum of issues&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mnc5mb11imslp11avsy30zf9h9g'>
            <column caption='date agg.' datatype='date' name='[Calculation_3575576642946347009]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;day&apos; THEN DATE(DATETRUNC(&apos;day&apos;, [date]))&#13;&#10;    WHEN &apos;week&apos; THEN DATE(DATETRUNC(&apos;week&apos;, [date]))&#13;&#10;    WHEN &apos;month&apos; THEN DATE(DATETRUNC(&apos;month&apos;, [date]))&#13;&#10;    WHEN &apos;quarter&apos; THEN DATE(DATETRUNC(&apos;quarter&apos;, [date]))&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='pillar break field' datatype='string' name='[Calculation_6073596692514238478]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = TRUE THEN [issue_name]&#10;ELSEIF [Parameters].[Parameter 3] = FALSE THEN &quot;&quot;&#10;END' />
            </column>
            <column caption='issue per rider' datatype='real' name='[Calculation_8966596503788982284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([issue_count]) / COUNTD([rider_id])' />
            </column>
            <column caption='Calculation Field' datatype='real' name='[Calculation_8966596503789264909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;issue per rider&apos; then [Calculation_8966596503788982284]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;sum of issues&apos; then SUM([issue_count])&#10;END' />
