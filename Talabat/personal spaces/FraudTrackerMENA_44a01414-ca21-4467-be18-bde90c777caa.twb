              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;day&apos; THEN DATE(DATETRUNC(&apos;day&apos;, [date]))&#13;&#10;    WHEN &apos;week&apos; THEN DATE(DATETRUNC(&apos;week&apos;, [date]))&#13;&#10;    WHEN &apos;month&apos; THEN DATE(DATETRUNC(&apos;month&apos;, [date]))&#13;&#10;    WHEN &apos;quarter&apos; THEN DATE(DATETRUNC(&apos;quarter&apos;, [date]))&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='issue per rider' datatype='real' name='[Calculation_8966596503788982284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([issue_count]) / COUNTD([rider_id])' />
            </column>
            <column caption='Calculation Field' datatype='real' name='[Calculation_8966596503789264909]' role='measure' type='quantitative'>
