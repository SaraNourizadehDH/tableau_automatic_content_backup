        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1knaqrj1l1v2iw1f8quoj1oxgglz' name='Custom SQL Query' type='text'><![CDATA[WITH orders AS (
    SELECT hr.country_code,
           hr.zone_id,
           zone_name,
           TIMESTAMP_TRUNC(datetime(hr.created_at,timezone), HOUR) AS order_hour
    FROM `tlb-data-prod.data_platform.fct_logistics_order` AS hr
    left join `tlb-data-prod.data_platform.dim_logistics_zone` z
on hr.country_code = z.country_code and hr.city_id = z.city_id and hr.zone_id = z.zone_id
    WHERE datetime(hr.created_at,timezone) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
    GROUP BY 1, 2, 3, 4
),
staff AS (
    SELECT s.country_code,
           zone_name,
           s.zone_id,
           order_hour, 
           COUNT(DISTINCT shift_id) AS riders_count
    FROM orders
    LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_rider_shift` AS s
           ON orders.country_code = s.country_code AND orders.zone_id = s.zone_id
    WHERE datetime(s.actual_start_at,timezone) << order_hour
      AND datetime(s.actual_end_at,timezone) >> order_hour
      AND s.shift_state = 'EVALUATED'
      AND DATE(datetime(s.actual_start_at,timezone)) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
    GROUP BY 1, 2, 3, 4
),
ranks AS (
    SELECT e.country_code,
           e.zone_id,
           value,
           RANK() OVER (
               PARTITION BY e.country_code,e.zone_id
               ORDER BY value DESC
           ) AS event_rank
    FROM `fulfillment-dwh-production.curated_data_shared.delivery_areas_multiple_events` AS e
    WHERE DATE(datetime(start_at,timezone)) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
      AND value IS NOT NULL AND activation_threshold IS NOT NULL AND is_active
    GROUP BY 1, 2, 3
)

SELECT e.country_code,
       zone_name,
       e.zone_id,
       city_name city_name,
       NULL AS order_hour,
       datetime(start_at,e.timezone) as start_at,
       datetime(end_at,e.timezone) as end_at,
       duration,
       CASE 
           WHEN activation_threshold IS NULL THEN 'Manual/Scheduled' 
           ELSE 'Automatic' 
       END AS event_type,
       e.title,
       action,
       e.value,
       activation_threshold,
       deactivation_threshold,
       event_rank,
       0 AS orders_count,
       0 AS sum_order_delay,
       0 AS sum_order_delay_d,
       0 AS sum_dt,
       0 AS sum_dt_d,
       0 AS sum_dod,
       0 AS sum_dod_d,
       0 AS sum_pdt,
       0 AS sum_pdt_d,
       0 AS sum_vendor_late,
       0 AS sum_vendor_late_d,
       0 AS sum_vendor_late_10,
       0 AS sum_rider_late,
       0 AS sum_rider_late_d,
       0 AS sum_rider_late_10,
       0 AS sum_rider_delay_max,
       0 AS sum_rider_delay,
       0 AS sum_rider_delay_d,
       0 AS riders_count,
       NULL AS vendors_count

FROM `fulfillment-dwh-production.curated_data_shared.delivery_areas_multiple_events` AS e
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` AS z 
ON e.country_code = z.country_code AND e.zone_id = z.zone_id AND z.is_active
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS c
ON c.city_id = z.city_id AND c.country_code = z.country_code AND c.is_active
LEFT JOIN ranks 
ON ranks.country_code = e.country_code AND ranks.zone_id = e.zone_id AND ranks.value = e.value
WHERE DATE(datetime(start_at,e.timezone)) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
  AND e.is_active
  AND c.is_active

UNION ALL

SELECT hr.country_code,
       zone_name,
       hr.zone_id,
       city_name AS city_name,
       TIMESTAMP_TRUNC(datetime(hr.created_at,hr.timezone), HOUR) AS order_hour,
       NULL AS start_at,
       NULL AS end_at,
       NULL AS duration,
       NULL AS event_type,
       NULL AS title,
       NULL AS action,
       NULL AS value,
       NULL AS activation_threshold,
       NULL AS deactivation_threshold,
       NULL AS event_rank,
       COUNT(DISTINCT CASE WHEN order_status = 'completed' THEN order_id END) AS orders_count,
       SUM(order_delay) AS sum_order_delay,
       COUNTIF(order_delay IS NOT NULL) AS sum_order_delay_d,
       SUM(CASE WHEN NOT is_logistics_preorder AND order_status = 'completed' THEN actual_delivery_time END) AS sum_dt,
       COUNTIF(NOT is_logistics_preorder AND order_status = 'completed' AND actual_delivery_time IS NOT NULL) AS sum_dt_d,
       SUM(primary_dropoff_distance_manhattan) AS sum_dod,
       COUNTIF(primary_dropoff_distance_manhattan IS NOT NULL) AS sum_dod_d,
       SUM(CASE WHEN NOT is_logistics_preorder AND order_status = 'completed' THEN promised_delivery_time END) AS sum_pdt,
       COUNTIF(NOT is_logistics_preorder AND order_status = 'completed' AND promised_delivery_time IS NOT NULL) AS sum_pdt_d,
       SUM(vendor_late) AS sum_vendor_late,
       COUNTIF(vendor_late IS NOT NULL) AS sum_vendor_late_d,
       COUNTIF(vendor_late >> 600) AS sum_vendor_late_10,
       SUM(rider_late) AS sum_rider_late,
       COUNTIF(vendor_late IS NOT NULL) AS sum_rider_late_d,
       COUNTIF(rider_late >> 600) AS sum_rider_late_10,
       MAX(estimated_courier_delay) AS sum_rider_delay_max,
       SUM(estimated_courier_delay) AS sum_rider_delay,
       COUNTIF(estimated_courier_delay IS NOT NULL) AS sum_rider_delay_d,
       MIN(riders_count) AS riders_count,
       NULL AS vendors_count

FROM `tlb-data-prod.data_platform.fct_logistics_order` AS hr
LEFT JOIN staff AS s 
ON s.country_code = hr.country_code AND s.zone_id = hr.zone_id AND s.order_hour = TIMESTAMP_TRUNC(datetime(hr.created_at,hr.timezone), HOUR)
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS c
ON c.city_id = hr.city_id AND c.country_code = hr.country_code AND is_active

WHERE DATE(datetime(hr.created_at,hr.timezone)) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
AND c.is_active

GROUP BY 1, 2, 3, 4, 5

UNION ALL

SELECT hr.country_code,
       zone_name,
       hr.zone_id,
       city_name AS city_name,
       NULL AS order_hour,
       NULL AS start_at,
       NULL AS end_at,
       NULL AS duration,
       NULL AS event_type,
       NULL AS title,
       NULL AS action,
       NULL AS value,
       NULL AS activation_threshold,
       NULL AS deactivation_threshold,
       NULL AS event_rank,
       NULL AS orders_count,
       NULL AS sum_order_delay,
       NULL AS sum_order_delay_d,
       NULL AS sum_dt,
       NULL AS sum_dt_d,
       NULL AS sum_dod,
       NULL AS sum_dod_d,
       NULL AS sum_pdt,
       NULL AS sum_pdt_d,
       NULL AS sum_vendor_late,
       NULL AS sum_vendor_late_d,
       NULL AS sum_vendor_late_10,
       NULL AS sum_rider_late,
       NULL AS sum_rider_late_d,
       NULL AS sum_rider_late_10,
       NULL AS sum_rider_delay_max,
       NULL AS sum_rider_delay,
       NULL AS sum_rider_delay_d,
       NULL AS riders_count,
       COUNT(DISTINCT vendor_id) AS vendors_count

FROM `tlb-data-prod.data_platform.fct_logistics_order` AS hr
LEFT JOIN staff AS s  
ON s.country_code = hr.country_code AND s.zone_id = hr.zone_id
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS c
ON c.city_id = hr.city_id AND c.country_code = hr.country_code AND is_active

WHERE DATE(datetime(hr.created_at,hr.timezone)) >>= date_add(date_trunc(current_date(), day), INTERVAL -30 day)
AND c.is_active

GROUP BY 1, 2, 3, 4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
