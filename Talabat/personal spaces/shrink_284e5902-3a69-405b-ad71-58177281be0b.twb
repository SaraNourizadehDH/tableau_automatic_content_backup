      <aliases enabled='yes' />
      <column caption='#of Hours' datatype='integer' name='[#of Days (copy)_618119054880210944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='18' />
      </column>
      <column caption='%Shrinkage' datatype='real' default-format='p0.00%' name='[%Closure (copy)_1849853547410399241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Closure Hours (copy)_1849853547394826241]/([Calculation_1849853547395981315]*24)' />
      </column>
      <column caption='%Lost on Shrink ' datatype='real' default-format='p0.00%' name='[%Lost on Close (copy)_1041738949177163777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.1bt1hwl0k3riwn1gz19mf0rtkqlz].[Closure Lost Orders (copy)_886364742578757633])/SUM([federated.1bt1hwl0k3riwn1gz19mf0rtkqlz].[total_orders])' />
      </column>
      <column caption='%Of Operation (C) ' datatype='real' default-format='p0.00%' name='[%Of Operation (C) (copy)_7724728902001020928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(zn(sum([Hours (copy)_1849853547406667784]))/&#13;&#10;zn(sum([VendorsCount (copy)_7724728902001303553])*ATTR([Calculation_1849853547395981315])*ATTR([#of Days (copy)_618119054880210944]))&#13;&#10;,0)' />
      </column>
      <column caption='%Of Operation Hours' datatype='real' default-format='p0.00%' name='[%Of Operation (copy)_1849853547442790412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Hours (copy)_1849853547406667784])/&#13;&#10;&#13;&#10;IF([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;day&apos;) then (sum([Calculation_1849853547406290951])*24)&#13;&#10;ELSEIF ([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;week&apos;) then (sum([Calculation_1849853547406290951])*24*7)&#13;&#10;ELSEIF ([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;month&apos;) then (sum([Calculation_1849853547406290951])*24*30)&#13;&#10;END' />
      </column>
      <column caption='%Of Operation' datatype='real' default-format='p0.00%' name='[%Shrinkage (copy)_1849853547430043659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Hours (copy)_1849853547406667784])/(sum([Calculation_1849853547406290951])*ATTR([Calculation_1849853547395981315])*ATTR([#of Days (copy)_618119054880210944]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1bt1hwl0k3riwn1gz19mf0rtkqlz].[sum:total_orders:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.1wpbpe90l2c1hu15zqgbn1mli5rj (copy)].[pcto:sum:Calculation_1323495397302472727:qk:2]&quot;' value='% Shrinkage' />
          <alias key='&quot;[federated.1wpbpe90l2c1hu15zqgbn1mli5rj (copy)].[usr:Calculation_1061723618639278080:qk]&quot;' value='Avg Estimated Courier Delay' />
          <alias key='&quot;[federated.1wpbpe90l2c1hu15zqgbn1mli5rj (copy)].[usr:Calculation_1061723618663723010:qk]&quot;' value='Max Estimated Courier Delay  ' />
        </aliases>
      </column>
      <column caption='Avg PDT' datatype='real' name='[Avg DT (copy)_1323495397232779277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_pdt]/60)/sum([sum_pdt_d])' />
      </column>
      <column caption='Date range Fix' datatype='boolean' name='[Calculation_104145767813292032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&quot;week&quot;,[Calculation_1323495396257353735]) &gt;= dateadd(&quot;week&quot;,-5,DATETRUNC(&quot;week&quot;,{max([Calculation_1323495396257353735])}))&#13;&#10;then true&#13;&#10;else FALSE&#13;&#10;END' />
      </column>
      <column caption='%Lost on Close' datatype='real' default-format='p0.00%' name='[Calculation_1041738949177044992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.1bt1hwl0k3riwn1gz19mf0rtkqlz].[Calculation_886364742578372608])/SUM([federated.1bt1hwl0k3riwn1gz19mf0rtkqlz].[total_orders])' />
      </column>
      <column caption='Estimated Courier Delay' datatype='real' name='[Calculation_1061723618639278080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_rider_delay])/sum(60*[sum_rider_delay_d])' />
      </column>
      <column caption='Activation' datatype='boolean' name='[Calculation_1061723618654060545]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if([Calculation_1061723618663723010]&gt;MIN([activation_threshold])) then true else false end' />
      </column>
      <column caption='Estimated Courier Delay Maximum ' datatype='real' name='[Calculation_1061723618663723010]' role='measure' type='quantitative'>
