          <datasource-dependencies datasource='federated.1wpbpe90l2c1hu15zqgbn1mli5rj'>
            <column caption='%Of Operation Hours' datatype='real' default-format='p0.00%' name='[%Of Operation (copy)_1849853547442790412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Hours (copy)_1849853547406667784])/&#13;&#10;&#13;&#10;IF([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;day&apos;) then (sum([Calculation_1849853547406290951])*24)&#13;&#10;ELSEIF ([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;week&apos;) then (sum([Calculation_1849853547406290951])*24*7)&#13;&#10;ELSEIF ([Parameters].[Granularity  (copy)_1849853547445850125]=&apos;month&apos;) then (sum([Calculation_1849853547406290951])*24*30)&#13;&#10;END' />
            </column>
            <column caption='Time' datatype='datetime' name='[Calculation_1323495396208545792]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([start_at],[order_hour])' />
            </column>
            <column caption='DATETIME' datatype='datetime' name='[Calculation_1323495397316628504]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2],[Calculation_1323495396208545792])' />
            </column>
            <column caption='datetimefilter' datatype='date' name='[Calculation_1323495397318176793]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([Calculation_1323495397316628504])' />
            </column>
            <column caption='VendorsCount' datatype='integer' name='[Calculation_1849853547406290951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[zone_name],[zone_id],[city_name]: sum([vendors_count])}' />
            </column>
            <column caption='is TB?' datatype='boolean' name='[Calculation_2901866339486842880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if upper(left([title],3))=&apos;ODR&apos; then FALSE&#10;elseif upper(left([title],2))=&apos;ZO&apos; then FALSE&#10;else TRUE&#10;end' />
            </column>
            <column caption='DATETIME -' datatype='datetime' name='[DATETIME (copy)_1849853547446128654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETIME(DATETRUNC([Parameters].[Granularity  (copy)_1849853547445850125],[Calculation_1323495396208545792]))' />
