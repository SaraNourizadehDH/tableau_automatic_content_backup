    <worksheet name='Events Duration Regional'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='9'>Events Durations / % of Operation Hours</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='EventsDurationRegional' path='/t/Talabat/workbooks/PorygonEvents' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='logistics_performance_events (dwh_bl.logistics_performance_events) (dwh_bl)' name='federated.1wpbpe90l2c1hu15zqgbn1mli5rj' />
            <datasource caption='logistics_performance_events (dwh_bl.logistics_performance_events) (dwh_bl) (2)' name='federated.1wpbpe90l2c1hu15zqgbn1mli5rj (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity ' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wpbpe90l2c1hu15zqgbn1mli5rj'>
            <column caption='#of Hours' datatype='integer' name='[#of Days (copy)_618119054880210944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='18' />
            </column>
            <column caption='%Of Operation (C) ' datatype='real' default-format='p0.00%' name='[%Of Operation (C) (copy)_7724728902001020928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Hours (copy)_1849853547406667784])/(sum([VendorsCount (copy)_7724728902001303553])*ATTR([Calculation_1849853547395981315])*ATTR([#of Days (copy)_618119054880210944]))' />
            </column>
            <column caption='%Of Operation' datatype='real' default-format='p0.00%' name='[%Shrinkage (copy)_1849853547430043659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Hours (copy)_1849853547406667784])/(sum([Calculation_1849853547406290951])*ATTR([Calculation_1849853547395981315])*ATTR([#of Days (copy)_618119054880210944]))' />
            </column>
            <column caption='Time' datatype='datetime' name='[Calculation_1323495396208545792]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([start_at],[order_hour])' />
            </column>
            <column caption='Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1323495397302472727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[duration]/3600' />
            </column>
            <column caption='DATETIME' datatype='datetime' name='[Calculation_1323495397316628504]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2],[Calculation_1323495396208545792])' />
            </column>
            <column caption='datetimefilter' datatype='date' name='[Calculation_1323495397318176793]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([Calculation_1323495397316628504])' />
            </column>
            <column caption='#of Days' datatype='integer' name='[Calculation_1849853547395981315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE   [city_name],[zone_name],[action],[event_rank],[value],[activation_threshold],[deactivation_threshold],[title] :countd(date([Calculation_1323495396208545792]))}' />
            </column>
            <column caption='VendorsCount' datatype='integer' name='[Calculation_1849853547406290951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[zone_name],[zone_id],[city_name]: sum([vendors_count])}' />
            </column>
            <column caption='is TB?' datatype='boolean' name='[Calculation_2901866339486842880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if upper(left([title],3))=&apos;ODR&apos; then FALSE&#10;elseif upper(left([title],2))=&apos;ZO&apos; then FALSE&#10;else TRUE&#10;end' />
            </column>
            <column caption='Dim.' datatype='string' name='[Calculation_408772085512011776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Regional&apos;' />
            </column>
            <column caption='Hours (w)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Hours (copy)_1849853547406667784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1849853547406290951]*[duration]/3600' />
            </column>
            <column caption='VendorsCount (c)' datatype='integer' name='[VendorsCount (copy)_7724728902001303553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[city_name]: sum([vendors_count])}' />
            </column>
            <column caption='Action' datatype='string' name='[action]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Activation Threshold' datatype='integer' name='[activation_threshold]' role='dimension' type='ordinal' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
