  <column aggregation='Count' caption='Activation Status' datatype='string' default-type='nominal' name='[Activation status (copy)_6016457282948100116]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if  ifnull([order_0_30_day],0) &gt;= 1 then &quot;Activated&quot;&\#10;elseif  [is_activated] = 1 THEN  &quot;Activated&quot; &\#10;else &quot;Not Activated&quot; end' />
  </column>
  <column aggregation='User' caption='Calculation1' datatype='integer' default-type='quantitative' name='[Calculation_100205138830794752]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNT([vendor_id])' />
  </column>
  <column aggregation='User' caption='Offline duration 30 days' datatype='real' default-type='quantitative' name='[Calculation_100205138837782531]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30])/sum([actual_duration_in_hrs_0_30])' />
  </column>
  <column aggregation='User' caption='CVR 30 days' datatype='real' default-type='quantitative' name='[Calculation_100205138837917700]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([placed_order_session_count_0_30])/sum([viewed_menu_session_count_0_30])' />
  </column>
  <column aggregation='Count' caption='vendor grade' datatype='string' default-type='nominal' name='[Calculation_1085789731678420992]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='lower([vendor_grade])' />
  </column>
  <column aggregation='User' caption='Activated\%' datatype='real' default-type='quantitative' name='[Calculation_1344535618004455424]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([is_activated]) / sum([coldstart_denominator])' />
  </column>
  <column aggregation='Count' caption='offline bm check' datatype='boolean' default-type='nominal' name='[Calculation_1348124409283043328]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='{FIXED  [vendor_id] : [Calculation_100205138837782531] &lt; avg([Calculation_302937451466973185])}' />
  </column>
  <column aggregation='Sum' caption='coldstart vendors with healthy ops' datatype='integer' default-type='quantitative' name='[Calculation_1348124409286422530]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='if [Calculation_6366752872450056195] = &quot;Coldstart&quot; then ({FIXED [vendor_id] , [is_coldstart] = 1 : &\#10;sum(if [Calculation_1348124409283043328] = true and [offline bm check (copy)_1348124409283436545] = true then 1 else 0 end)  })&\#10;else 0 end' />
  </column>
  <column aggregation='Count' caption='Ops quality' datatype='string' default-type='nominal' name='[Calculation_1348124409407713283]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
