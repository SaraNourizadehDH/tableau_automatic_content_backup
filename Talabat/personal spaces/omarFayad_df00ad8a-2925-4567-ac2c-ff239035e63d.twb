  <column aggregation='Count' caption='Activation Status (copy)' datatype='string' default-type='nominal' name='[Activation Status (copy)_2074963191508295705]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if  ifnull([order_0_30_day],0) &gt;= 1 then &quot;Activated&quot;&\#10;elseif  [is_activated] = 1 THEN  &quot;Activated&quot; &\#10;else &quot;Not Activated&quot; end' />
