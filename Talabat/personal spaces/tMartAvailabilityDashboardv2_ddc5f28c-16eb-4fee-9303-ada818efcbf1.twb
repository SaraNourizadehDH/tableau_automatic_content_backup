      <connection channel='https' class='sqlproxy' dbname='tMartItemAvailabilityV2' directory='/dataserver' port='443' server='tableau.deliveryhero.net' server-oauth='' username='' workgroup-auth-mode='prompt'>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Aggregation Column (copy)_2334412761856864259]' formula='CASE  [Parameters].[Availability Aggregation (copy)_2334412761855700994]&#10;WHEN &quot;Brand Name&quot; THEN [brand]&#10;WHEN &quot;Warehouse Name&quot; THEN [warehouse_name]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;PIM Category Level 1&quot; THEN [category_name_level_one]&#10;WHEN &quot;PIM Category Level 2&quot; THEN [category_name_level_two]&#10;WHEN &quot;PIM Category Level 3&quot; THEN [category_name_level_three]&#10;WHEN &quot;Front-End Category&quot; THEN [category_parent_english]&#10;WHEN &quot;Front-End Sub-category&quot; THEN [category_english]&#10;WHEN &quot;Price Tier&quot; THEN [price_tier]&#10;WHEN &quot;Supplier Name&quot; THEN [supplier_name]&#10;WHEN &quot;Country&quot; THEN [country_code]&#10;WHEN &quot;Date&quot; THEN STR(DATE([stock_date]))&#10;WHEN &quot;ABC Categorization&quot; THEN [abc_bucket]&#10;WHEN &quot;XYZ Categorization&quot; THEN [xyz_bucket]&#10;WHEN &quot;ABC-XYZ Categorization&quot; THEN [abc_bucket]+[xyz_bucket]&#10;END' />
          <calculation column='[Availability % (copy)_2317242780222713859]' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
          <calculation column='[Available SKUs (copy)_2317242780231315461]' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
          <calculation column='[Available SKUs per Warehouse (copy)_4695635967610191873]' formula='AVG({ INCLUDE [warehouse_id]: COUNTD(&#10;&#10;CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [is_available_day] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_evening&quot; THEN IF [is_available_evening] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_perc&quot; THEN IF[is_available_day] = 1 THEN [sku] ELSE NULL END&#10;END&#10;&#10;&#10;) })' />
          <calculation column='[Calculation_2317242780218630144]' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_evening&quot; THEN [is_available_evening]&#10;WHEN &quot;is_available_perc&quot; THEN [availability_perc]&#10;WHEN &quot;is_available_eod&quot; THEN [is_available_day]&#10;END' />
          <calculation column='[Calculation_2317242780222386177]' formula='COUNTD([sku])' />
          <calculation column='[Calculation_2317242780352823308]' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
          <calculation column='[Calculation_2334412761854545921]' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Brand Name&quot; THEN [brand]&#10;WHEN &quot;Warehouse Name&quot; THEN [warehouse_name]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;PIM Category Level 1&quot; THEN [category_name_level_one]&#10;WHEN &quot;PIM Category Level 2&quot; THEN [category_name_level_two]&#10;WHEN &quot;PIM Category Level 3&quot; THEN [category_name_level_three]&#10;WHEN &quot;Front-End Category&quot; THEN [category_parent_english]&#10;WHEN &quot;Front-End Sub-category&quot; THEN [category_english]&#10;WHEN &quot;Price Tier&quot; THEN [price_tier]&#10;WHEN &quot;Supplier Name&quot; THEN [supplier_name]&#10;WHEN &quot;Country&quot; THEN [country_code]&#10;WHEN &quot;Date&quot; THEN STR(DATE([stock_date]))&#10;WHEN &quot;ABC Categorization&quot; THEN [abc_bucket]&#10;WHEN &quot;XYZ Categorization&quot; THEN [xyz_bucket]&#10;WHEN &quot;ABC-XYZ Categorization&quot; THEN [abc_bucket]+[xyz_bucket]&#10;END' />
          <calculation column='[Calculation_2998271490763743232]' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSE   DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;&#10;END' />
          <calculation column='[Calculation_3010515655962755072]' formula='[abc_bucket] + [xyz_bucket]' />
          <calculation column='[Calculation_345229103887466499]' formula='IF [category_name_level_one] in (&apos;Dairy / Chilled / Eggs&apos; , &apos;Bread / Bakery&apos;) THEN &apos;Ultra-Fresh&apos;&#10;ELSEIF [category_name_level_one] in (&apos;Produce&apos; , &apos;Ready To Consume&apos;, &apos;Meat / Seafood&apos;) THEN &apos;Fresh&apos;&#10;ELSE NULL &#10;END' />
          <calculation column='[Calculation_34621459044360192]' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Daily&apos;  THEN [stock_date]&#10;&#10;&#10;END' />
          <calculation column='[Calculation_5920403965931667456]' formula='{ FIXED [country_code], [warehouse_name]: SUM([customer_order_count]) }' />
          <calculation column='[Calculation_5920403965931892737]' formula='{ FIXED [country_code], [category_name_level_two]: SUM([customer_order_count]) }' />
          <calculation column='[Category Sum (copy)_345229103538688000]' formula='{ FIXED [country_code], [category_name_level_two], [stock_date]: SUM([customer_order_count]) }' />
          <calculation column='[SKUs per Warehouse (copy)_2317242780356296719]' formula='AVG({ INCLUDE [warehouse_id]: COUNTD(&#10;&#10;CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [is_available_day] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_evening&quot; THEN IF [is_available_evening] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_perc&quot; THEN IF[is_available_day] = 1 THEN [sku] ELSE NULL END&#10;END&#10;&#10;&#10;) })' />
          <calculation column='[Warehouse Sum (copy)_345229103538966529]' formula='{ FIXED [country_code], [warehouse_name], [stock_date]: SUM([customer_order_count]) }' />
        </calculations>
