              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Daily&apos;  THEN [stock_date]&#10;&#10;&#10;END' />
            </column>
            <column caption='Fresh / UF' datatype='string' name='[Fresh / UF (copy)_4336051696738189312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [category_name_level_one] in (&apos;Dairy / Chilled / Eggs&apos; , &apos;Bread / Bakery&apos;) THEN &apos;Fresh&apos;&#10;ELSEIF [category_name_level_one] in (&apos;Produce&apos; , &apos;Ready To Consume&apos;, &apos;Meat / Seafood&apos;) THEN &apos;Ultra-Fresh&apos;&#10;ELSE NULL &#10;END' />
