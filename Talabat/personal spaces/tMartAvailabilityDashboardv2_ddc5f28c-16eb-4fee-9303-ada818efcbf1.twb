            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;CASE [Parameters].[Parameter 5]
WHEN \&quot;Brand Name\&quot; THEN [brand]
WHEN \&quot;Warehouse Name\&quot; THEN [warehouse_name]
WHEN \&quot;Vendor Name\&quot; THEN [vendor_name]
WHEN \&quot;PIM Category Level 1\&quot; THEN [category_name_level_one]
WHEN \&quot;PIM Category Level 2\&quot; THEN [category_name_level_two]
WHEN \&quot;PIM Category Level 3\&quot; THEN [category_name_level_three]
WHEN \&quot;Front-End Category\&quot; THEN [category_parent_english]
WHEN \&quot;Front-End Sub-category\&quot; THEN [category_english]
WHEN \&quot;Price Tier\&quot; THEN [price_tier]
WHEN \&quot;Supplier Name\&quot; THEN [supplier_name]
WHEN \&quot;Country\&quot; THEN [country_code]
WHEN \&quot;Date\&quot; THEN STR(DATE([stock_date]))
WHEN \&quot;ABC Categorization\&quot; THEN [abc_bucket]
WHEN \&quot;XYZ Categorization\&quot; THEN [xyz_bucket]
WHEN \&quot;ABC-XYZ Categorization\&quot; THEN [abc_bucket]+[xyz_bucket]
END&quot;</attribute>
