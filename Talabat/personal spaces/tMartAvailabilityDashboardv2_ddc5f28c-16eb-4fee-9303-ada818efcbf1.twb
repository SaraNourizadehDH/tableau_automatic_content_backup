    <worksheet name='Availability by ABC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='16'>% of active SKUs available per warehouse by ABC Categorization</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tMart Item Availability [V2] (2)' name='sqlproxy.1mc8ovj05l2me31e6xznb0yogfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Hourly Availability %' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_perc&quot;'>
              <calculation class='tableau' formula='&quot;is_available_perc&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_evening&quot;' value='6PM Availability' />
                <alias key='&quot;is_available_perc&quot;' value='Hourly Availability %' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1mc8ovj05l2me31e6xznb0yogfkn'>
            <column aggregation='Sum' caption='Availability %' datatype='real' default-format='p0.00%' default-type='quantitative' layered='true' name='[Calculation_2317242780218630144]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_evening&quot; THEN [is_available_evening]&#10;WHEN &quot;is_available_perc&quot; THEN [availability_perc]&#10;WHEN &quot;is_available_eod&quot; THEN [is_available_day]&#10;END' />
            </column>
            <column aggregation='User' caption='SKUs per Warehouse' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2317242780352823308]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
            </column>
            <column aggregation='Year' caption='Date Select' datatype='datetime' default-format='*MMM DD' default-type='ordinal' layered='true' name='[Calculation_34621459044360192]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Daily&apos;  THEN [stock_date]&#10;&#10;&#10;END' />
