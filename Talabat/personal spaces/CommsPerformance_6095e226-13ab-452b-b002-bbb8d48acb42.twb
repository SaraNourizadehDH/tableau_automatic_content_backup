        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1po441k1qlr60w0zrg0xc1bsbdeg' name='Targets_Tracker' table='[Targets_Tracker$]' type='table'>
          <columns gridOrigin='A1:B12:no:A1:B12:0' header='yes' outcome='2'>
            <column datatype='date' name='date_month' ordinal='0' />
