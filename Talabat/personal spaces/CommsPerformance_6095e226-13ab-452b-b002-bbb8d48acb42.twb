  (c.external_user_id IS NOT NULL, TRUE, FALSE ) is_clicked,
IF
  (sp.external_user_id IS NOT NULL, TRUE, FALSE ) is_spammed
FROM
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Send_1206` s
