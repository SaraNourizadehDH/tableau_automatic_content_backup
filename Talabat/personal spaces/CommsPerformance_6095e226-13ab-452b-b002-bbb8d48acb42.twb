  <worksheets>
    <worksheet name='Comms revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontname='Tableau Semibold'>Monthly KPI Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Comms Performance' name='federated.0oly9gd11jucij18qccl41eg3mvu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Comms' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
              <calculation class='tableau' formula='&quot;Revenue&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oly9gd11jucij18qccl41eg3mvu'>
            <column caption='No. of campaigns' datatype='integer' name='[Calculation_1036390900031774720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([campaign_name])' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_1053560872886444032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([discount_type]) THEN [revenue] END)' />
            </column>
            <column caption='No. of targeted vendors' datatype='integer' name='[Calculation_1053560872890224641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='No. of Booked vendors' datatype='integer' name='[Calculation_1053560872890699778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1053560872890904579])' />
            </column>
            <column caption='Cal2' datatype='integer' name='[Calculation_1053560872890904579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [revenue] &gt; 0&#13;&#10;THEN [vendor_id]&#13;&#10;END' />
            </column>
            <column caption='KPI Comms' datatype='real' name='[Calculation_1996220571234861056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 14]&#13;&#10;    WHEN &apos;Targeted vendors&apos; THEN [Calculation_1053560872890224641]&#13;&#10;    WHEN &apos;Booked vendors&apos; THEN [Calculation_1053560872890699778]&#13;&#10;    WHEN &apos;Revenue&apos; THEN [Calculation_1053560872886444032]&#13;&#10;    WHEN &apos;Campaigns&apos; THEN [Calculation_1036390900031774720]&#13;&#10;    WHEN &apos;Opened vendors&apos; THEN [Calculation_276689940687831041]&#13;&#10;END' />
            </column>
            <column caption='cal3' datatype='integer' name='[Calculation_276689940687749120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_open] = TRUE THEN [vendor_id] END' />
            </column>
            <column caption='No. of opened vendors' datatype='integer' name='[Calculation_276689940687831041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_276689940687749120])' />
            </column>
            <column caption='Campaign name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Date month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Discount type' datatype='string' name='[discount_type]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_open]' role='dimension' type='nominal' />
            <column-instance column='[objective]' derivation='None' name='[none:objective:nk]' pivot='key' type='nominal' />
            <column-instance column='[product]' derivation='None' name='[none:product:nk]' pivot='key' type='nominal' />
            <column caption='Objective' datatype='string' name='[objective]' role='dimension' type='nominal' />
