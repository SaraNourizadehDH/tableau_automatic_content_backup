ff as(
 select distinct  vendor_id,grid_id, origin, product,vendor_name,campaign_name,is_open,country_name,created_at_utc,booking_id,campaign_date, booked_budget,budget_utilized from final2 ),

 ff2 as( select a.*,b.chain_id from ff a left join (select distinct vendor_id,vendor_name,chain_id from tlb-data-prod.data_platform.dim_vendor_info) b
 using(vendor_id)

 )

select 
