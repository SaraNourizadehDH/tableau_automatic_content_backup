ON
  c.campaign_id = s.campaign_id
  AND c.external_user_id = s.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_MarkAsSpam_1173` sp
ON
  sp.campaign_id = s.campaign_id
  AND sp.external_user_id = s.external_user_id
WHERE
  s.campaign_id IS NOT NULL

union all 

SELECT
  DISTINCT 'campaign' AS commuincation_type,
  s.campaign_name,
  s.external_user_id,
  TRUE is_send,
IF
  (o.external_user_id IS NOT NULL, TRUE, FALSE ) is_open,
