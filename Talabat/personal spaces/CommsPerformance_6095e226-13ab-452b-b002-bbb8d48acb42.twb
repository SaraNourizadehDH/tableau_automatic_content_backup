a.vendor_id,
a.grid_id,
a.origin,
a.product,
a.vendor_name,
a.canvas_name as campaign_name,
SUBSTR(a.grid_id, 1, STRPOS(a.grid_id, '_') - 1) as country_name,
a.created_at_utc,
a.booking_id,
a.canvas_date as campaign_date,
a.chain_id,
b.chain_monetisation_tiers,
b.country_code,
a.is_open,
sum(a.booked_budget) as booked_budget,
sum(a.budget_utilized) as budget_utilized
from ff2 a left join tier b 
using(chain_id) where canvas_date >>= '2024-07-01' group by all


)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
