      <column caption='cal2' datatype='integer' name='[Calculation_1553460456315453451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) AND [budget_utilized] &gt; 0 THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
