sum(a.budget_utilized) as budget_utilized
from ff2 a left join tier b 
using(chain_id) where campaign_date >>= '2024-02-04' group by all)


#### connect automated canvas data


UNION ALL

(
with bookings_base as(
SELECT
  DISTINCT 
  base.campaign_id as booking_id,
