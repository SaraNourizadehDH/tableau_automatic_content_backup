            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_1053560872886444032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([discount_type]) THEN [revenue] END)' />
