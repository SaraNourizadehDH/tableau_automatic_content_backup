          <datasource-dependencies datasource='federated.1hv506v00gbi4g199kkyw1cis3bi'>
            <column caption='Budget Utilized €' datatype='real' name='[Budget Booked € (copy)_771522970326355971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([budget_utilized])' />
            </column>
            <column caption='Calculation1' datatype='integer' name='[Calculation_1553460456020504581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
            </column>
            <column caption='No. of Booked Vendors' datatype='integer' name='[Calculation_1553460456023400454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1553460456020504581])' />
            </column>
            <column caption='No. of campaigns' datatype='integer' name='[Calculation_1553460456288866314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([campaign_name])' />
            </column>
            <column caption='cal2' datatype='integer' name='[Calculation_1553460456315453451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) AND [budget_utilized] &gt; 0 THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
            </column>
            <column caption='No. of revenue vendors' datatype='integer' name='[Calculation_1553460456315518988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1553460456315453451])' />
            </column>
            <column caption='No. of opened vendors' datatype='integer' name='[Calculation_487514682970185738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_open] THEN [vendor_id] END)' />
            </column>
            <column caption='Open rate' datatype='real' name='[Calculation_487514682970423307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_487514682970185738]/[No. of bookings (copy)_771522970325983233]' />
            </column>
            <column caption='Booking rate' datatype='real' name='[Calculation_487514682970710028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1553460456023400454]/[No. of bookings (copy)_771522970325983233]' />
            </column>
            <column caption='No. of bookings' datatype='integer' name='[Calculation_771522970325905408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([booking_id])' />
            </column>
            <column caption='Budget Booked €' datatype='real' name='[Calculation_771522970326163458]' role='measure' type='quantitative'>
