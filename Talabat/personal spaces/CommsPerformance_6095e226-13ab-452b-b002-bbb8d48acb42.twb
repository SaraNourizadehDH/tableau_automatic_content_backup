    <datasource caption='COMMS - CPC Top up' inline='true' name='federated.0hbgsql1a47fmu15yq3y11whf8ol' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0mxapc60l0m6wh13kuuyk1pdakvu'>
            <connection CATALOG='publicdata' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='server-custom' username='sara.ali@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0mxapc60l0m6wh13kuuyk1pdakvu' name='Custom SQL Query' type='text'><![CDATA[(WITH comms as (
  SELECT
    DISTINCT a.*,
    b.vendor_id,
    b.vendor_name,
    b.country_code,
    b.chain_id
  FROM (with data as (SELECT
  DISTINCT 'campaign' AS commuincation_type,
  s.campaign_id,
  s.campaign_name,
  s.external_user_id,
  TRUE is_send,
IF
  (o.external_user_id IS NOT NULL, TRUE, FALSE ) is_open,
IF
  (c.external_user_id IS NOT NULL, TRUE, FALSE ) is_clicked,
IF
  (sp.external_user_id IS NOT NULL, TRUE, FALSE ) is_spammed
FROM
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Send_*` s
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Open_*` o
ON
  s.campaign_id = o.campaign_id
  AND s.external_user_id = o.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Click_*` c
ON
  c.campaign_id = s.campaign_id
  AND c.external_user_id = s.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_MarkAsSpam_*` sp
ON
  sp.campaign_id = s.campaign_id
  AND sp.external_user_id = s.external_user_id
WHERE
  s.campaign_id IS NOT NULL

)
 select
 SAFE_CAST(FORMAT_DATE('%Y-%m-%d', PARSE_DATE('%Y%m%d', REGEXP_EXTRACT(campaign_name, r'(\d{8})'))) as date) AS campaign_date,
 campaign_name,
 external_user_id as grid_id,
 is_send,is_clicked,is_spammed
from data where commuincation_type = 'campaign' and  lower(campaign_name) like ("%top%up%")
) a
  JOIN (
    SELECT
      DISTINCT i.vendor_id,
      i.vendor_name,
      i.salesforce_id,
      d.country_code,
      i.chain_id
    FROM
      `tlb-data-prod.data_platform.dim_vendor_info` i
    JOIN `tlb-data-prod.data_platform.dim_chain` d
    on i.chain_id=d.chain_id) b
  ON
    SPLIT(grid_id, '_')[
  OFFSET
    (1)]=b.salesforce_id )

, comms2 as 
( 
select *,lead(campaign_date) over (partition by vendor_id order by campaign_date) as lead_date, max(campaign_date) over (partition by vendor_id) as latest_campaign_date from comms --where grid_id="AE_4OMNEJ"
)

## overall booking data as
, combo1 as (
  SELECT
  DISTINCT
  cd.vendor_id,
  cd.vendor_name,
  cd.campaign_name,
  safe_cast(cd.campaign_date as string) as campaign_date,
  cd.country_code,
  cd.chain_id,
  cd.lead_date,
  --if (cd.lead_date is null,latest_campaign_date,cd.lead_date) as lead_date  ,
  ROUND(
    MAX(
        CASE 
            WHEN safe_cast(cd.campaign_date as date)-1 = safe_cast(date as date)
                AND EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date) 
                and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date)
                --and safe_cast(cd.campaign_date as string)<<safe_cast(cd.lead_date as string) 
                THEN budget.local 
            ELSE NULL 
        END
    ),
    0
) AS max_budget_pre_campaign_local,
  ROUND(
    MAX(
        CASE 
            WHEN --safe_cast(cd.campaign_date as string) << safe_cast(date as string)
                EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date) 
                and if (cd.lead_date is null

                ,safe_cast(date as string)>>=safe_cast(cd.campaign_date as string)
                and EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date)

                ,safe_cast(date as string)<<safe_cast(cd.lead_date as string) 
                and EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date)and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date))
                THEN budget.local
            ELSE NULL 
        END
    ),
    0
)
 AS max_budget_post_campaign_local,
   ROUND(
    MAX(
        CASE 
            WHEN safe_cast(cd.campaign_date as date)-1 = safe_cast(date as date)
                AND EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date) 
                and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date)
                --and safe_cast(cd.campaign_date as string)<<safe_cast(cd.lead_date as string) 
                THEN budget.eur
            ELSE NULL 
        END
    ),
    0
) AS max_budget_pre_campaign,
  ROUND(
    MAX(
        CASE 
            WHEN --safe_cast(cd.campaign_date as string) << safe_cast(date as string)
                EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date) 
                and if (cd.lead_date is null

                ,safe_cast(date as string)>>=safe_cast(cd.campaign_date as string)
                and EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date)

                ,safe_cast(date as string)<<safe_cast(cd.lead_date as string) 
                and EXTRACT(MONTH FROM cd.campaign_date) = EXTRACT(MONTH FROM date)and EXTRACT(year FROM cd.campaign_date) = EXTRACT(year FROM date))
                THEN budget.eur
            ELSE NULL 
        END
    ),
    0
)
 AS max_budget_post_campaign,
  ROW_NUMBER() OVER (PARTITION BY cd.vendor_id ORDER BY campaign_date DESC) AS row_num
FROM comms2 cd
LEFT join `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily`d
on cast(cd.vendor_id as string)=d.vendor_id
group by 1,2,3,4,5,6,cd.campaign_date,7
ORDER BY
  2 desc
  )

  
, combo2 as (
select c.*,b.tier
from combo1 c
left join
(SELECT
    DISTINCT LOWER(country_code) AS country_code,
    (LOWER(chain_name)) AS chain_name,
    chain_id,
  IF
    (chain_monetisation_tiers IS NULL, "Tier E", chain_monetisation_tiers ) AS tier
  FROM
    `tlb-data-prod.data_platform.agg_chain_tiers`
  WHERE
    date = "2024-01-01") b
on c.chain_id=b.chain_id)
, combo3 as (select *,if((max_budget_post_campaign_local>>max_budget_pre_campaign_local),(max_budget_post_campaign - max_budget_pre_campaign),0) as top_up
from combo2)
select "campaign" as flag,c.*
from combo3 c
--where vendor_id=716170
--order by vendor_id

)



## Now UNION Automated Canvas Data here



UNION ALL


( WITH comms as (
  SELECT
    DISTINCT a.*,
    b.vendor_id,
    b.vendor_name,
    b.country_code,
    b.chain_id
  FROM (with data as (
SELECT
  DISTINCT 'campaign' AS commuincation_type,
  s.campaign_id,
  s.campaign_name,
  s.canvas_name,
  s.canvas_id,
  s.time,
  s.external_user_id,
  TRUE is_send,
IF
  (o.external_user_id IS NOT NULL, TRUE, FALSE ) is_open,
IF
  (c.external_user_id IS NOT NULL, TRUE, FALSE ) is_clicked,
IF
  (sp.external_user_id IS NOT NULL, TRUE, FALSE ) is_spammed
FROM
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Send_*` s
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Open_*` o
ON
  s.canvas_id = o.canvas_id
  AND s.external_user_id = o.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Click_*` c
ON
  c.canvas_id = s.canvas_id
  AND c.external_user_id = s.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_MarkAsSpam_*` sp
ON
  sp.canvas_id = s.canvas_id
  AND sp.external_user_id = s.external_user_id
-- WHERE
--   s.campaign_id IS NOT NULL

)
 select
 FORMAT_TIMESTAMP('%Y-%m-%d', TIMESTAMP_SECONDS(time)) AS canvas_date,
 campaign_name,
 canvas_name,
 canvas_id,
 external_user_id as grid_id,
 max(is_open) as is_open
from data where commuincation_type = 'campaign' and  (lower(canvas_name) like ("%top%up%") or lower(canvas_name) like "%topup%")
GROUP BY ALL
) a
  JOIN (
    SELECT
      DISTINCT i.vendor_id,
      i.vendor_name,
      i.salesforce_id,
      d.country_code,
      i.chain_id
    FROM
      `tlb-data-prod.data_platform.dim_vendor_info` i
    JOIN `tlb-data-prod.data_platform.dim_chain` d
    on i.chain_id=d.chain_id) b
  ON
    SPLIT(grid_id, '_')[
  OFFSET
    (1)]=b.salesforce_id )

, comms2 as 
( 
select *,lead(canvas_date) over (partition by vendor_id order by canvas_date) as lead_date from comms
)


## overall booking data as
, combo1 as (
  SELECT
  DISTINCT
  cd.vendor_id,
  cd.vendor_name,
  cd.canvas_name as campaign_name,
  safe_cast(cd.canvas_date as string) as campaign_date,
  cd.country_code,
  cd.chain_id,
  safe_cast(cd.lead_date as date) as lead_date,
   ROUND(
    MAX(
         CASE 
            WHEN safe_cast(cd.canvas_date as date)-1 = safe_cast(date  as date)
                AND  EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date) 
                and  EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date))= EXTRACT(year FROM date)
                --and safe_cast(cd.campaign_date as string)<<safe_cast(cd.lead_date as string) 
                THEN budget.local
            ELSE NULL 
        END
    ),
    0
) AS max_budget_pre_campaign_local,
  ROUND(
    MAX(
        CASE 
            WHEN --safe_cast(cd.campaign_date as string) << safe_cast(date as string)
                EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date) 
                and if (cd.lead_date is null

                ,safe_cast(date as string)>>=safe_cast(cd.canvas_date as string)
                and EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(year FROM date)

                ,safe_cast(date as string)<<safe_cast(cd.lead_date as string) 
                and EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(year FROM date))
                THEN budget.local
            ELSE NULL 
        END
    ),
    0
)
 AS max_budget_post_campaign_local,  
  ROUND(
    MAX(
         CASE 
            WHEN safe_cast(cd.canvas_date as date)-1 = safe_cast(date  as date)
                AND  EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date) 
                and  EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date))= EXTRACT(year FROM date)
                --and safe_cast(cd.campaign_date as string)<<safe_cast(cd.lead_date as string) 
                THEN budget.eur 
            ELSE NULL 
        END
    ),
    0
) AS max_budget_pre_campaign,
  ROUND(
    MAX(
        CASE 
            WHEN --safe_cast(cd.campaign_date as string) << safe_cast(date as string)
                EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date) 
                and if (cd.lead_date is null

                ,safe_cast(date as string)>>=safe_cast(cd.canvas_date as string)
                and EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(year FROM date)

                ,safe_cast(date as string)<<safe_cast(cd.lead_date as string) 
                and EXTRACT(MONTH FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(MONTH FROM date)
                and EXTRACT(year FROM PARSE_DATE('%Y-%m-%d', cd.canvas_date)) = EXTRACT(year FROM date))
                THEN budget.eur 
            ELSE NULL 
        END
    ),
    0
)
 AS max_budget_post_campaign,
  ROW_NUMBER() OVER (PARTITION BY cd.vendor_id ORDER BY canvas_date DESC) AS row_num
FROM comms2 cd
LEFT join `fulfillment-dwh-production.curated_data_shared_adtech.sponsored_listings_daily`d
