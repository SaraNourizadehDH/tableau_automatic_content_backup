  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Open_1446` o
ON
  s.canvas_id = o.canvas_id
  AND s.external_user_id = o.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_Click_1435` c
ON
  c.canvas_id = s.canvas_id
  AND c.external_user_id = s.external_user_id
LEFT JOIN
  `tlb-data-prod.data_platform_rest_tables.users_messages_email_MarkAsSpam_1470` sp
ON
  sp.canvas_id = s.canvas_id
  AND sp.external_user_id = s.external_user_id
WHERE
s.campaign_id IS NOT NULL
)


 select 
 FORMAT_DATE('%Y-%m-%d', PARSE_DATE('%Y%m%d', REGEXP_EXTRACT(campaign_name, r'(\d{8})'))) AS campaign_date,
 campaign_name,
 external_user_id as grid_id,
 is_send,is_clicked,is_spammed

from data where commuincation_type = 'campaign' and lower(campaign_name) like  ('%supersaver%')

) a 

left join (select distinct vendor_id,salesforce_id,vendor_name from tlb-data-prod.data_platform.dim_vendor_info) b
on  split(grid_id, '_')[offset(1)]=b.salesforce_id
)

, base as 
(
Select 
DISTINCT c.vendor_id AS vendor_id,
dim_chain.vertical,
dim_chain.country_name AS country_name,
dim_vendor_info.vendor_name AS vendor_name,
dim_chain.chain_id AS chain_id,
dim_chain.chain_name AS chain_name,
dim_incentives_voucher.source_system_platform_campaign_type AS discount_type,
COUNT(*) AS total_orders,
(COUNT(*)*2) AS super_saver_revenue_eur

FROM campaigns c

LEFT JOIN `tlb-data-prod.data_platform.fct_incentive_order_detail` AS fct_incentive_order_detail 
ON c.vendor_id=fct_incentive_order_detail.vendor_id
AND (fct_incentive_order_detail.order_date >> "2024-02-12" and fct_incentive_order_detail.order_date <<= '2024-03-10' and fct_incentive_order_detail.is_successful = TRUE)

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dim_vendor_info 
ON c.vendor_id = dim_vendor_info.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dim_vendor_location 
ON dim_vendor_location.location_id = dim_vendor_info.location_id 
AND (dim_vendor_location.country_code like case when 'yes'='yes' then '%' else 'AE' end)

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain 
ON dim_chain.chain_id = dim_vendor_info.chain_id 
AND ((UPPER(( dim_chain.country_name )) = UPPER('UAE')))

LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` AS dim_incentives_voucher 
ON fct_incentive_order_detail.campaign_id=dim_incentives_voucher.campaign_id 
AND ((UPPER(( dim_incentives_voucher.source_system_platform_campaign_type )) = UPPER('SUPERSAVER')))

GROUP BY
1,2,3,4,5,6,7
)

SELECT b.*,"2024-02-12" as campaign_date, "20240211_SuperSaver_Awar_Com_Regional" as campaign_name,t.tier
from base b

LEFT JOIN 

(SELECT
distinct
lower(country_code) as country_code,
(lower(chain_name)) as chain_name,
chain_id,
if (chain_monetisation_tiers is null , "Tier E" , chain_monetisation_tiers ) as tier
FROM `tlb-data-prod.data_platform.agg_chain_tiers`
where date = "2024-02-01") t
on b.chain_id=t.chain_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
