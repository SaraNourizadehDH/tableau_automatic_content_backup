  AND sp.external_user_id = s.external_user_id
-- WHERE
--   s.campaign_id IS NOT NULL

)
 select
 FORMAT_TIMESTAMP('%Y-%m-%d', TIMESTAMP_SECONDS(time)) AS canvas_date,
 campaign_name,
 canvas_name,
 canvas_id,
 external_user_id as grid_id,
 max(is_open) as is_open
from data where commuincation_type = 'campaign' and  (lower(canvas_name) like ("%top%up%") or lower(canvas_name) like "%topup%")
GROUP BY ALL
) a
  JOIN (
    SELECT
      DISTINCT i.vendor_id,
