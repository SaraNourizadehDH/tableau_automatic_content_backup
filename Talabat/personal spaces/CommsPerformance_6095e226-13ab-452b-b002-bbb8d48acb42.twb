      <column caption='Calculation1' datatype='integer' name='[Calculation_1553460456020504581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
