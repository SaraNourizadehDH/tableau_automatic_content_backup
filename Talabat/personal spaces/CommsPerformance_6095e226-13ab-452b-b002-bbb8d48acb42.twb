      <aliases enabled='yes' />
      <column caption='No. of campaigns' datatype='integer' name='[Calculation_604045300353560576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([campaign_name])' />
      </column>
      <column caption='No. of Targeted Vendors' datatype='integer' name='[Calculation_888335088470081536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='No. of Booked Vendors' datatype='integer' name='[Calculation_888335088470224897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_888335088477159429])' />
      </column>
      <column caption='No. of Bookings' datatype='integer' name='[Calculation_888335088470298626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([booking_id])' />
      </column>
      <column caption='Budget Booked € ' datatype='real' name='[Calculation_888335088470437891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([booked_budget])' />
      </column>
      <column caption='Budget Utilized € ' datatype='real' name='[Calculation_888335088476860420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budget_utilized])' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_888335088477159429]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
      </column>
      <column caption='Country Name' datatype='string' name='[Calculation_888335088481894406]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='UPPER([country_code])' />
      </column>
      <column caption='Metric CPC WhatsApp' datatype='real' name='[Calculation_888335088486154248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#13;&#10;    WHEN &apos;No. of targeted vendors&apos; THEN [Calculation_888335088470081536]&#13;&#10;    WHEN &apos;No. of bookings&apos; THEN [Calculation_888335088470298626]&#13;&#10;    WHEN &apos;Budget booked €&apos; THEN [Calculation_888335088470437891]&#13;&#10;    WHEN &apos;Budget utilized €&apos; THEN [Calculation_888335088476860420]&#13;&#10;    WHEN &apos;No. of booked vendors&apos; THEN [Calculation_888335088470224897]&#13;&#10;END' />
      </column>
      <column caption='No. of revenue vendors' datatype='integer' name='[Calculation_888335088490774537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_888335088490848266])' />
      </column>
      <column caption='cal2' datatype='string' name='[Calculation_888335088490848266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([booking_id]) AND [budget_utilized] &gt; 0 THEN&#13;&#10;    ([vendor_id])&#13;&#10;END' />
      </column>
