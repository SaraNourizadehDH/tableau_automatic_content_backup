              <calculation class='tableau' formula='[Parameters].[Parameter 1] * [Calculation_288511908842070018]' />
            </column>
            <column caption='Comission Paid Avg.' datatype='real' name='[Comission Paid  (copy)_1536009008408764430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] * ([Parameters].[Parameter 2] + [Calculation_1536009008403496962])' />
