    <worksheet name='Sheet 4'>
      <table>
        <view>
          <datasources>
            <datasource caption='Operational Costs' name='federated.1vw9xii1lrawb216udsec0r3o4an' />
            <datasource name='Parameters' />
            <datasource caption='Cogs' name='federated.015vc480twnb0q1319wq80abe158' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cogs' datatype='real' default-format='p0.00%' name='[Commission Taken by Talabat (copy)]' param-domain-type='any' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
            </column>
            <column caption='Gems' datatype='integer' name='[Parameter 10]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
            <column caption='Revenue Before Talabat' datatype='integer' default-format='n#,##0;-#,##0' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='5000000'>
              <calculation class='tableau' formula='5000000' />
            </column>
            <column caption='Talabat&apos;s Revenue' datatype='integer' default-format='c#,##0;(#,##0)' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='300000'>
              <calculation class='tableau' formula='300000' />
            </column>
            <column caption='Investment Amount' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='10000'>
              <calculation class='tableau' formula='10000' />
            </column>
            <column caption='Cuisine' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pizza&quot;'>
              <calculation class='tableau' formula='&quot;Pizza&quot;' />
            </column>
            <column caption='Commission Taken by Talabat' datatype='real' default-format='p0.00%' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
            </column>
            <column caption='Opex % ' datatype='real' default-format='p0.00%' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='0.3472'>
              <calculation class='tableau' formula='0.3472' />
            </column>
            <column caption='CPC' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
            <column caption='Display Ads' datatype='integer' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
            <column caption='Targeted Deals' datatype='integer' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.015vc480twnb0q1319wq80abe158'>
            <column caption='Cogs Absolute After Talabat' datatype='real' name='[Calculation_1244682405043077126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([federated.1vw9xii1lrawb216udsec0r3o4an].[Calculation_288511908858449931])/48 * [Parameters].[Commission Taken by Talabat (copy)]' />
            </column>
            <column caption='Selected Cogs' datatype='real' name='[Calculation_288511908840996864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Cuisine] = [Parameters].[Parameter 4] THEN [cogs %] END' />
            </column>
            <column datatype='string' name='[Cuisine]' role='dimension' type='nominal' />
            <column caption='Cogs %' datatype='real' default-format='p0.00%' name='[cogs %]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_288511908840996864]' derivation='Sum' name='[sum:Calculation_288511908840996864:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1244682405043077126]' derivation='User' name='[usr:Calculation_1244682405043077126:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vw9xii1lrawb216udsec0r3o4an'>
            <column datatype='real' default-format='p0.00%' name='[% from Revenue]' role='measure' type='quantitative' />
            <column caption='Opex after increase' datatype='real' name='[Calculation_1244682405027454977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Expense] IN (&quot;Depreciation&quot;,&quot;Maintenance Group&quot;) &#13;&#10;THEN&#13;&#10;[Calculation_288511908857634824] * (1+(0.5*[Calculation_288511908860633102]))&#13;&#10;&#13;&#10;ELSEIF [Expense] IN (&quot;Bank Services Charge&quot;,&quot;Bank Commission&quot;)&#13;&#10;THEN &#13;&#10;[Calculation_288511908857634824] +(0.0175*(0.4*[Parameters].[Parameter 2]))&#13;&#10;&#13;&#10;ELSEIF [Expense] IN (&quot;Water&quot;,&quot;Gas pump &amp; bills&quot;,&quot;Electricity&quot;,&quot;Gas - Anabeb&quot;) &#13;&#10;THEN &#13;&#10;[Calculation_288511908857634824]*(1+[Calculation_288511908860633102])&#13;&#10;&#13;&#10;ELSE [Calculation_288511908857634824]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% from Revenue Adjusted' datatype='real' default-format='p0.00%' name='[Calculation_1244682405034733570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1244682405027454977] / [Calculation_288511908858449931]' />
            </column>
            <column caption='ROAS' datatype='integer' name='[Calculation_1244682405036036100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='5 * [Parameters].[Parameter 3]' />
            </column>
            <column caption='Total Opex Absolute After Talabat' datatype='real' name='[Calculation_1244682405043515399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Opex % (copy)_1244682405035540483] * [Calculation_288511908858449931]' />
            </column>
            <column caption='Marketing Investmen' datatype='integer' name='[Calculation_1536009008402542593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7] + [Parameters].[Parameter 8] + [Parameters].[Parameter 9] + [Parameters].[Parameter 10]' />
            </column>
            <column caption='Total Opex %' datatype='real' name='[Calculation_288511908842070018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
            </column>
            <column caption='Total Opex Absolute' datatype='real' name='[Calculation_288511908848250886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] * [Calculation_288511908842070018]' />
            </column>
            <column caption='Opex Before Increase' datatype='real' name='[Calculation_288511908857634824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% from Revenue] * [Parameters].[Parameter 1]' />
            </column>
            <column caption='Total Sales Revenue' datatype='integer' name='[Calculation_288511908858449931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 1] + [Parameters].[Parameter 2] + [Calculation_1244682405036036100] )' />
            </column>
            <column caption='Growth After Talabat' datatype='real' default-format='p0.00%' name='[Calculation_288511908860633102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_288511908858449931]/[Parameters].[Parameter 1])-1' />
            </column>
            <column datatype='string' name='[Expense]' role='dimension' type='nominal' />
            <column caption='Total Opex %  after inc. (copy)' datatype='real' name='[Total Opex %  after inc. (copy)_1244682405114257419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Opex Absolute After Talabat (copy)_1244682405110665225] / [Calculation_288511908858449931]' />
            </column>
            <column caption='Total Opex %  after inc.' datatype='real' name='[Total Opex % (copy)_1244682405035540483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1244682405034733570])' />
            </column>
            <column caption='Total Opex Absolute After Talabat Manual Input' datatype='real' name='[Total Opex Absolute After Talabat (copy)_1244682405110665225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_288511908848250886] + 0.014*[Parameters].[Parameter 1]*0.5*[Calculation_288511908860633102]&#13;&#10;+(0.0175*(0.4*([Parameters].[Parameter 2]+[Calculation_1244682405036036100]))) + 0.0066*[Calculation_288511908860633102]' />
            </column>
            <column-instance column='[Calculation_1244682405036036100]' derivation='Attribute' name='[attr:Calculation_1244682405036036100:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1536009008402542593]' derivation='Attribute' name='[attr:Calculation_1536009008402542593:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_288511908858449931]' derivation='Attribute' name='[attr:Calculation_288511908858449931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_288511908860633102]' derivation='Attribute' name='[attr:Calculation_288511908860633102:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Opex %  after inc. (copy)_1244682405114257419]' derivation='Attribute' name='[attr:Total Opex %  after inc. (copy)_1244682405114257419:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Opex Absolute After Talabat (copy)_1244682405110665225]' derivation='Attribute' name='[attr:Total Opex Absolute After Talabat (copy)_1244682405110665225:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1244682405043515399]' derivation='User' name='[usr:Calculation_1244682405043515399:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Opex % (copy)_1244682405035540483]' derivation='User' name='[usr:Total Opex % (copy)_1244682405035540483:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
