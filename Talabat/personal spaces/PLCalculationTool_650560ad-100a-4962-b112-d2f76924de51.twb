            <column caption='Net Profit Avg. Case' datatype='real' default-format='c#,##0;(#,##0)' name='[Net Profiet Talabats Partner (avg.) (copy)_1536009008773111824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Sales Revenue (copy)_1536009008405360646] -&#13;&#10;([federated.015vc480twnb0q1319wq80abe158].[Cogs Absolute After Talabat (copy)_1536009008406212616]+&#13;&#10;[Total Opex Absolute After Talabat Manual Input (copy)_1536009008407871500]+&#13;&#10;[Calculation_1536009008402542593]+&#13;&#10;[Comission Paid  (copy)_1536009008408764430])' />
            </column>
            <column caption='Net Profit Worst Case' datatype='real' name='[Net Profit Avg. Case (copy)_1034139126705979393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Sales Revenue Avg. (copy)_1536009008405450759] -&#13;&#10;([federated.015vc480twnb0q1319wq80abe158].[Cogs Absolute After Talabat Avg. (copy)_1536009008406405129]+&#13;&#10;[Total Opex Absolute After Talabat Avg. (copy)_1536009008408248333]+&#13;&#10;[Calculation_1536009008402542593]+&#13;&#10;[Comission Paid Avg. (copy)_1536009008408866831])' />
            </column>
            <column caption='Total Opex Absolute After Talabat WCS' datatype='real' name='[Total Opex Absolute After Talabat Avg. (copy)_1536009008408248333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_288511908848250886] &#13;&#10;+ ((0.014*[Parameters].[Parameter 1])*0.5*[Growth After Talabat Avg. (copy)_1536009008407736331]) &#13;&#10;+ ((0.0066*[Parameters].[Parameter 1])*[Growth After Talabat Avg. (copy)_1536009008407736331])&#13;&#10;+(0.0175*(0.4*([Parameters].[Parameter 2]+[Calculation_1536009008404074499])))' />
            </column>
            <column caption='Total Opex Absolute After Talabat Avg.' datatype='real' name='[Total Opex Absolute After Talabat Manual Input (copy)_1536009008407871500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_288511908848250886] &#13;&#10;+ ((0.014*[Parameters].[Parameter 1])*0.5*[Growth After Talabat (copy)_1536009008407638026]) &#13;&#10;+ ((0.0066*[Parameters].[Parameter 1])*[Growth After Talabat (copy)_1536009008407638026])&#13;&#10;+(0.0175*(0.4*([Parameters].[Parameter 2]+[Calculation_1536009008403496962])))' />
