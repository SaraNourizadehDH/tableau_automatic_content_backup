              <text column='[federated.1vw9xii1lrawb216udsec0r3o4an].[usr:Total Opex % (copy)_1244682405035540483:qk]' />
              <text column='[federated.1vw9xii1lrawb216udsec0r3o4an].[attr:Calculation_1244682405036036100:qk]' />
