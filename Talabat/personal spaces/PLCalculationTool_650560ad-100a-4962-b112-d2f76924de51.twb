      <column caption='Opex after increase' datatype='real' name='[Calculation_1244682405027454977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Expense] IN (&quot;Depreciation&quot;,&quot;Maintenance Group&quot;) &#13;&#10;THEN&#13;&#10;[Calculation_288511908857634824] * (1+(0.5*[Calculation_288511908860633102]))&#13;&#10;&#13;&#10;ELSEIF [Expense] IN (&quot;Bank Services Charge&quot;,&quot;Bank Commission&quot;)&#13;&#10;THEN &#13;&#10;[Calculation_288511908857634824] +(0.0175*(0.4*[Parameters].[Parameter 2]))&#13;&#10;&#13;&#10;ELSEIF [Expense] IN (&quot;Water&quot;,&quot;Gas pump &amp; bills&quot;,&quot;Electricity&quot;,&quot;Gas - Anabeb&quot;) &#13;&#10;THEN &#13;&#10;[Calculation_288511908857634824]*(1+[Calculation_288511908860633102])&#13;&#10;&#13;&#10;ELSE [Calculation_288511908857634824]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='% from Revenue Adjusted' datatype='real' default-format='p0.00%' name='[Calculation_1244682405034733570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1244682405027454977] / [Calculation_288511908858449931]' />
      </column>
      <column caption='ROAS' datatype='integer' name='[Calculation_1244682405036036100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='5 * [Parameters].[Parameter 3]' />
      </column>
      <column caption='Net Profit After Talabat' datatype='real' name='[Calculation_1244682405037494277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_288511908858449931]&#13;&#10;*(1-([Parameters].[Commission Taken by Talabat (copy)] + [Total Opex %  after inc. (copy)_1244682405114257419]))&#13;&#10;-[Parameters].[Parameter 3]&#13;&#10;-([Parameters].[Parameter 5] * ([Parameters].[Parameter 2]+[Calculation_1244682405036036100]))' />
      </column>
      <column caption='Total Opex Absolute After Talabat' datatype='real' name='[Calculation_1244682405043515399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Opex % (copy)_1244682405035540483] * [Calculation_288511908858449931]' />
      </column>
      <column caption='Comission Paid ' datatype='real' name='[Calculation_1244682405045268488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] * ([Parameters].[Parameter 2] + [Calculation_1244682405036036100])' />
      </column>
      <column caption='Marketing Investmen' datatype='integer' name='[Calculation_1536009008402542593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7] + [Parameters].[Parameter 8] + [Parameters].[Parameter 9] + [Parameters].[Parameter 10]' />
      </column>
      <column caption='ROAS Avg.' datatype='real' default-format='c#,##0;(#,##0)' name='[Calculation_1536009008403496962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Parameters].[Parameter 7]*5) + ([Parameters].[Parameter 8]*7) + ([Parameters].[Parameter 9]*5.9) + ([Parameters].[Parameter 10]*2.5)' />
      </column>
      <column caption='ROAS WCS' datatype='real' name='[Calculation_1536009008404074499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Parameters].[Parameter 7]*3) + ([Parameters].[Parameter 8]*3.5) + ([Parameters].[Parameter 9]*3) + ([Parameters].[Parameter 10]*2)' />
      </column>
      <column caption='Net Profiet Talabats Partner (avg.)' datatype='real' name='[Calculation_1536009008404353028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Sales Revenue (copy)_1536009008405360646]&#13;&#10;*(1-([Parameters].[Commission Taken by Talabat (copy)] + [Total Opex %  after inc. (copy)_1244682405114257419]))&#13;&#10;-[Calculation_1536009008402542593]&#13;&#10;-([Parameters].[Parameter 5] * ([Parameters].[Parameter 2]+[Calculation_1536009008403496962]))' />
      </column>
      <column caption='Total Opex %' datatype='real' name='[Calculation_288511908842070018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='Net profit Without Talabat' datatype='real' default-format='c#,##0;(#,##0)' name='[Calculation_288511908843696131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] * (1-([Parameters].[Commission Taken by Talabat (copy)]+[Calculation_288511908842070018]))' />
