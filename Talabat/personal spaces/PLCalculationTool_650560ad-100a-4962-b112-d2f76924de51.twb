              <calculation class='tableau' formula='5000000' />
            </column>
            <column caption='Talabat&apos;s Revenue' datatype='integer' default-format='c#,##0;(#,##0)' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='300000'>
              <calculation class='tableau' formula='300000' />
            </column>
            <column caption='Commission Taken by Talabat' datatype='real' default-format='p0.00%' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
            </column>
            <column caption='Opex % ' datatype='real' default-format='p0.00%' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='0.3472'>
              <calculation class='tableau' formula='0.3472' />
            </column>
            <column caption='CPC' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
            <column caption='Display Ads' datatype='integer' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
            <column caption='Targeted Deals' datatype='integer' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='5000'>
              <calculation class='tableau' formula='5000' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.015vc480twnb0q1319wq80abe158'>
            <column caption='Cogs Absolute After Talabat Avg.' datatype='real' name='[Cogs Absolute After Talabat (copy)_1536009008406212616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([federated.1vw9xii1lrawb216udsec0r3o4an].[Total Sales Revenue (copy)_1536009008405360646])/48 * [Parameters].[Commission Taken by Talabat (copy)]' />
            </column>
            <column caption='Cogs Absolute After Talabat WCS' datatype='real' name='[Cogs Absolute After Talabat Avg. (copy)_1536009008406405129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([federated.1vw9xii1lrawb216udsec0r3o4an].[Total Sales Revenue Avg. (copy)_1536009008405450759])/48 * [Parameters].[Commission Taken by Talabat (copy)]' />
            </column>
            <column caption='Cogs Talabat WCS -ve ' datatype='real' default-format='c#,##0;(#,##0)' name='[Cogs Talabat Avg. -ve (copy)_533958093432188937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Cogs Absolute After Talabat Avg. (copy)_1536009008406405129] * -1' />
            </column>
            <column-instance column='[Cogs Talabat Avg. -ve (copy)_533958093432188937]' derivation='User' name='[usr:Cogs Talabat Avg. -ve (copy)_533958093432188937:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vw9xii1lrawb216udsec0r3o4an'>
            <column caption='Marketing Investmen' datatype='integer' name='[Calculation_1536009008402542593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7] + [Parameters].[Parameter 8] + [Parameters].[Parameter 9] + [Parameters].[Parameter 10]' />
            </column>
            <column caption='ROAS Avg.' datatype='real' default-format='c#,##0;(#,##0)' name='[Calculation_1536009008403496962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 7]*5) + ([Parameters].[Parameter 8]*7) + ([Parameters].[Parameter 9]*5.9) + ([Parameters].[Parameter 10]*2.5)' />
            </column>
            <column caption='ROAS WCS' datatype='real' name='[Calculation_1536009008404074499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 7]*3) + ([Parameters].[Parameter 8]*3.5) + ([Parameters].[Parameter 9]*3) + ([Parameters].[Parameter 10]*2)' />
            </column>
            <column caption='Total Opex %' datatype='real' name='[Calculation_288511908842070018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
            </column>
            <column caption='Revenue Before Talabat' datatype='integer' default-format='c#,##0;(#,##0)' name='[Calculation_288511908845391876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Total Opex Absolute' datatype='real' name='[Calculation_288511908848250886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] * [Calculation_288511908842070018]' />
            </column>
            <column caption='Comission Paid Avg.' datatype='real' name='[Comission Paid  (copy)_1536009008408764430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] * ([Parameters].[Parameter 2] + [Calculation_1536009008403496962])' />
            </column>
            <column caption='Comission Paid WCS' datatype='real' name='[Comission Paid Avg. (copy)_1536009008408866831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] * ([Parameters].[Parameter 2] + [Calculation_1536009008404074499])' />
            </column>
            <column caption='Comission Paid WCS -ve  ' datatype='real' default-format='c#,##0;(#,##0)' name='[Comission Paid Avg. -ve  (copy)_533958093433917451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Comission Paid Avg. (copy)_1536009008408866831] * -1' />
            </column>
            <column caption='Growth After Talabat Avg.' datatype='real' default-format='p0.00%' name='[Growth After Talabat (copy)_1536009008407638026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Sales Revenue (copy)_1536009008405360646]/[Parameters].[Parameter 1])-1' />
            </column>
            <column caption='Growth After Talabat WCS' datatype='real' default-format='p0.00%' name='[Growth After Talabat Avg. (copy)_1536009008407736331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Sales Revenue Avg. (copy)_1536009008405450759]/[Parameters].[Parameter 1])-1' />
