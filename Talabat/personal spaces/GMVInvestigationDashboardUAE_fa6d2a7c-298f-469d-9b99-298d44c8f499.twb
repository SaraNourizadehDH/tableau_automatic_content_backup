     AS dim_vendor_info ON agg_vendor_performance_summarised_daily.vendor_id = (CAST(dim_vendor_info.vendor_id AS STRING))

LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS dim_vendor_location ON dim_vendor_location.location_id = dim_vendor_info.location_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = dim_vendor_info.chain_id
WHERE agg_vendor_performance_summarised_daily.date>>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 MONTH)

AND (UPPER(dim_vendor_location.city_name) = UPPER('Abu Dhabi') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Ajman') 
OR UPPER( dim_vendor_location.city_name) = UPPER('Al Ain') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Dubai') 
OR UPPER( dim_vendor_location.city_name) = UPPER('Fujairah') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Ras Al Khaima') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Sharjah') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Umm Al-Quwain'))

GROUP BY
    1,
    2,
    3,
    4
    
    
    
    
    ) using (country,city,month,vertical)




LEFT JOIN (SELECT 

     
     "UAE" as country,
     date_trunc(fct_order_info.order_date,month) as month,
     delivery_location.city_name as city,


     CASE
    WHEN dim_chain.vertical_class = 'food' THEN 'Food'
    WHEN dim_chain.sub_vertical = 'darkstore' THEN 'tMart'
    ELSE 'LS'
  END as vertical, 

 COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0) AS net_orders,

    COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0) AS net_failed_orders,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0), COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0)) AS net_fail_rate,

COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('CUSTOMER')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS customer_cancellation,

    COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('VENDOR')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS vendor_cancellation,

COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('N/A') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('CUSTOMER/PLATFORM') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('FULFILMENT') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('PLATFORM')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS talabat_cancellation,

    COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('TRANSPORT')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS transport_cancellation,


COUNT(DISTINCT CASE WHEN  agg_customer_profile.acquisition_order_id   =  fct_order_info.order_id   THEN  fct_order_info.analytical_customer_id   END) AS Acquisition ,
COUNT(DISTINCT CASE WHEN fct_order_info.is_successful  THEN fct_order_info.analytical_customer_id  ELSE NULL END) AS MAU,

COUNT(DISTINCT CASE WHEN fct_order_info.is_successful  THEN fct_order_info.analytical_customer_id  ELSE NULL END)-COUNT(DISTINCT CASE WHEN  agg_customer_profile.acquisition_order_id   =  fct_order_info.order_id   THEN  fct_order_info.analytical_customer_id   END) as existing_mau



FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id

INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id

 LEFT JOIN `tlb-data-prod.data_platform.agg_customer_profile`
     AS agg_customer_profile ON agg_customer_profile.analytical_customer_id = fct_order_info.analytical_customer_id    
     

INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id


INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
     AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id


WHERE fct_order_info.order_date >>=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 Month) and fct_order_info.country_iso="AE"

GROUP BY 1,2,3,4


union all

SELECT 

     
     "UAE" as country,
     date_trunc(fct_order_info.order_date,month) as month,
     delivery_location.city_name as city,


"All" vertical, 

 COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0) AS net_orders,

    COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0) AS net_failed_orders,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0), COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0)) AS net_fail_rate,

COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('CUSTOMER')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS customer_cancellation,

    COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('VENDOR')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS vendor_cancellation,

COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('N/A') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('CUSTOMER/PLATFORM') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('FULFILMENT') OR UPPER( dim_order_fail_reason.owner  ) = UPPER('PLATFORM')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS talabat_cancellation,

    COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('TRANSPORT')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS transport_cancellation,

    COUNT(DISTINCT CASE WHEN  agg_customer_profile.acquisition_order_id   =  fct_order_info.order_id   THEN  fct_order_info.analytical_customer_id   END) AS Acquisition ,
COUNT(DISTINCT CASE WHEN fct_order_info.is_successful  THEN fct_order_info.analytical_customer_id  ELSE NULL END) AS MAU,

COUNT(DISTINCT CASE WHEN fct_order_info.is_successful  THEN fct_order_info.analytical_customer_id  ELSE NULL END)-COUNT(DISTINCT CASE WHEN  agg_customer_profile.acquisition_order_id   =  fct_order_info.order_id   THEN  fct_order_info.analytical_customer_id   END) as existing_mau


