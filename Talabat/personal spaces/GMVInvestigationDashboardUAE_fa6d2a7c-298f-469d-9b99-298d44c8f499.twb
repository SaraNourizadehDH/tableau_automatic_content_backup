    COALESCE(SUM(CASE WHEN (UPPER( dim_order_fail_reason.owner  ) = UPPER('VENDOR')) THEN CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END  ELSE NULL END), 0) AS vendor_cancellation,

