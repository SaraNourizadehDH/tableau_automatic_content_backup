    <worksheet name='Discount % Change'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.17lhqpm1fznaat0zsajk70zfs2az' />
            <datasource caption='Custom SQL Query (data_platform) (2)' name='federated.1a00xzh1qzq3hp103jflg1fllddp' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17lhqpm1fznaat0zsajk70zfs2az'>
            <column caption='Vs Previous' datatype='string' name='[Calculation_1002895410002857984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Vs Previous Period&apos;' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_1002895410020421634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Overall Discounts' datatype='real' name='[Calculation_1002895410331758600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1002895410617806858]+[Calculation_1002895410618241035]+[Calculation_1002895410345947145]' />
            </column>
            <column caption='Avg Discount' datatype='real' name='[Calculation_1002895410345947145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount_lc])/SUM([successful_orders])' />
            </column>
            <column caption='Avg GEM Discount' datatype='real' name='[Calculation_1002895410617806858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gem_discount_amount_lc])/SUM([successful_orders])' />
            </column>
            <column caption='Avg Voucher Discount' datatype='real' name='[Calculation_1002895410618241035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_discount_amount_lc])/SUM([successful_orders])' />
            </column>
            <column caption='NFR %' datatype='real' name='[Calculation_1127870255417847820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([net_failed_orders])/sum([net_order_count])' />
            </column>
            <column caption='EF' datatype='real' name='[Calculation_1127870255701450765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1767381399630172172]+[Calculation_1767381399631691790]' />
            </column>
            <column caption='Net Fail Rate %' datatype='real' name='[Calculation_1767381399330660352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([net_failed_order_count])&#13;&#10;/&#13;&#10;sum([net_order_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1767381399618617347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[successful_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1767381399620677638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1767381399618617347])/SUM([successful_orders])' />
            </column>
            <column caption='Platform Acquisition' datatype='real' name='[Calculation_1767381399625715719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([platform_acquisition])' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1767381399628902409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1767381399629238282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1767381399628902409])/sum([successful_orders])' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_1767381399629639691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[successful_df_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_df_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_1767381399630172172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1767381399629639691])/sum([successful_orders])' />
            </column>
            <column caption='Service Fee' datatype='real' name='[Calculation_1767381399631486989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[successful_sf_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_sf_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='Avg SF' datatype='real' name='[Calculation_1767381399631691790]' role='measure' type='quantitative'>
