      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='GMV Investigation Query' id='_E565632B52384417A0FB8675361DDA83'>
            <properties context=''>
              <relation connection='bigquery.1j44fgl12yvnbq1bh4ms212nc7ap' name='Custom SQL Query' type='text'><![CDATA[select * from 


(select  country_name as country,city_name as city,

date_trunc(date,month) as month,

case when shop_type="NFV" THEN "LS" 
when shop_type="Restaurant" THEN "Food"
when shop_type="Darkstore" THEN "tMart"
else shop_type end as vertical,

--vertical,

--delivery_arrangement,

--any_value(exchange_rate_to_eur) as exchange_rate_to_eur,

sum(daily_net_failed_order_count) as net_failed_order_count,

sum(daily_net_order_count) as net_order_count,

safe_divide(sum(daily_net_order_count),count(distinct date)) as avg_daily_net_orders,


sum(daily_total_orders_count) as total_orders,
SUM(gross_orders) AS gross_orders,

sum(daily_successful_order_count) as successful_orders,

safe_divide(sum(daily_successful_order_count),count(distinct date)) as avg_daily_orders,

sum(daily_order_new_customer_count) as platform_acquisition,

sum(daily_total_order_gmv_lc) as total_gmv_lc,
sum(daily_total_order_gmv_eur) as total_gmv_eur,

sum(daily_successful_order_gmv_lc) as successful_gmv_lc,
sum(daily_successful_order_gmv_eur) as successful_gmv_eur,


safe_divide(sum(daily_successful_order_gmv_lc),count(distinct date)) as avg_daily_successful_gmv_lc,
safe_divide(sum(daily_successful_order_gmv_eur),count(distinct date)) as avg_daily_successful_gmv_eur,




sum(daily_successful_incentivized_order_count_wo_gem) as incentivized_orders_wo_gem,
sum(daily_successful_incentivized_order_count_with_gem) as incentivized_orders_with_gem,

SUM(daily_successful_basket_amount_lc) AS successful_basket_amount_lc,
SUM(daily_successful_basket_amount_eur) AS successful_basket_amount_eur,

SUM(daily_successful_delivery_fee_amount_lc) AS successful_df_amount_lc,
SUM(daily_successful_delivery_fee_amount_eur) AS successful_df_amount_eur,

SUM(daily_successful_service_fee_amount_lc) AS successful_sf_amount_lc,
SUM(daily_successful_service_fee_amount_eur) AS successful_sf_amount_eur,

sum(daily_successful_discount_amount_lc) as discount_amount_lc,
sum(daily_successful_discount_amount_eur) as discount_amount_eur,

sum(daily_successful_voucher_discount_amount_lc) as voucher_discount_amount_lc,
sum(daily_successful_voucher_discount_amount_eur) as voucher_discount_amount_eur,


sum(daily_successful_free_delivery_incentive_amount_lc) as fd_amount_lc,
sum(daily_successful_free_delivery_incentive_amount_eur) as fd_amount_eur,

sum(daily_successful_gem_discount_amount_lc) as gem_discount_amount_lc,
sum(daily_successful_gem_discount_amount_eur) as gem_discount_amount_eur,


SUM(daily_viewed_menu_session_count) AS viewed_menu_session_count,
SUM(daily_viewed_menu_subsession_count) AS viewed_menu_subsession_count,

