        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tjuoft1wn4ju617rlrwh1rc979k' name='Custom SQL Query' type='text'><![CDATA[WITH orders AS 

(select * from (
  SELECT fct_order_info.country_code
        ,fct_order_info.order_date
        ,fct_order_info.order_id
        ,fct_order_info.vendor_id
        ,fct_order_info.is_tpro_order
        ,fct_order_info.delivery_fee_amount_lc
        ,fct_order_info.dps_vendor_price_scheme_type
        ,fct_order_info.is_fdnc_order,

         case 
         when dim_vendor_info.is_everyday_roastery then "tMart"
         when (dim_vendor_info.is_dh_kitchen or kitchen_group_name = 'Sweetheart Kitchen') then "kitchen"
         when not dim_vendor_info.is_non_food then "Food"
         when dim_vendor_info.is_non_food and dim_vendor_info.is_darkstore then "tMart"
         else "LS" end as vertical,
         
         delivery_location.city_name as city,

  FROM `tlb-data-prod.data_platform.fct_order_info` fct_order_info
  LEFT JOIN tlb-data-prod.data_platform.dim_vendor_info dim_vendor_info USING (vendor_id)
  INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id

  WHERE fct_order_info.is_tgo 
  AND fct_order_info.is_successful
  AND NOT fct_order_info.is_test
  AND NOT fct_order_info.is_market_place
  AND UPPER(fct_order_info.delivery_arrangement) = 'TGO'
  AND fct_order_info.order_date >>=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 Month)
  AND fct_order_info.country_code="AE"
)

where vertical not in ('Kitchen')
)



 select DATE_TRUNC(order_date, MONTH) AS month,
 vertical,City,
 "ASA" as dps_vendor_price_scheme_type,
 count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
 --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
 --COALESCE(AVG(delivery_fee_amount_lc), 0) as avg_df
 from orders
 where dps_vendor_price_scheme_type NOT IN ('Experiment', 'Campaign')
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  AND NOT (is_fdnc_order AND delivery_fee_amount_lc = 0 AND dps_vendor_price_scheme_type <<>> 'Experiment')


group by 1,2,3,4


union all

 select DATE_TRUNC(order_date, MONTH) AS month,
 "All" as vertical,City,
 "ASA" as dps_vendor_price_scheme_type,
 count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
 --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
 --COALESCE(AVG(delivery_fee_amount_lc), 0) as avg_df
 from orders
 where dps_vendor_price_scheme_type NOT IN ('Experiment', 'Campaign')
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  AND NOT (is_fdnc_order AND delivery_fee_amount_lc = 0 AND dps_vendor_price_scheme_type <<>> 'Experiment')


group by 1,2,3,4


union all

 select DATE_TRUNC(order_date, MONTH) AS month,
 "All" vertical,"All" City,
 "ASA" as dps_vendor_price_scheme_type,
 count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
 --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
 --COALESCE(AVG(delivery_fee_amount_lc), 0) as avg_df
 from orders
 where dps_vendor_price_scheme_type NOT IN ('Experiment', 'Campaign')
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  AND NOT (is_fdnc_order AND delivery_fee_amount_lc = 0 AND dps_vendor_price_scheme_type <<>> 'Experiment')


group by 1,2,3,4


union all

 select DATE_TRUNC(order_date, MONTH) AS month,
 vertical,"All" City,
 "ASA" as dps_vendor_price_scheme_type,
 count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
 --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
 --COALESCE(AVG(delivery_fee_amount_lc), 0) as avg_df
 from orders
 where dps_vendor_price_scheme_type NOT IN ('Experiment', 'Campaign')
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  AND NOT (is_fdnc_order AND delivery_fee_amount_lc = 0 AND dps_vendor_price_scheme_type <<>> 'Experiment')


group by 1,2,3,4





UNION ALL

  SELECT DATE_TRUNC(order_date, MONTH) AS month,vertical,city,
  "Experiment" as dps_vendor_price_scheme_type,
   count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
   
   --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
  --COALESCE(AVG(delivery_fee_amount_lc), 0) AS avg_df
  FROM orders
  WHERE  dps_vendor_price_scheme_type = 'Experiment'
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  GROUP BY 1, 2,3,4


union all

  SELECT DATE_TRUNC(order_date, MONTH) AS month,"All" vertical,city,
  "Experiment" as dps_vendor_price_scheme_type,
   count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
   
   --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
  --COALESCE(AVG(delivery_fee_amount_lc), 0) AS avg_df
  FROM orders
  WHERE  dps_vendor_price_scheme_type = 'Experiment'
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  GROUP BY 1, 2,3,4


  union all

    SELECT DATE_TRUNC(order_date, MONTH) AS month,"All" vertical,"All" city,
  "Experiment" as dps_vendor_price_scheme_type,
   count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
   
   --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
  --COALESCE(AVG(delivery_fee_amount_lc), 0) AS avg_df
  FROM orders
  WHERE  dps_vendor_price_scheme_type = 'Experiment'
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  GROUP BY 1, 2,3,4

  union all

    SELECT DATE_TRUNC(order_date, MONTH) AS month,vertical,"All" as city,
  "Experiment" as dps_vendor_price_scheme_type,
   count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
   
   --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
  --COALESCE(AVG(delivery_fee_amount_lc), 0) AS avg_df
  FROM orders
  WHERE  dps_vendor_price_scheme_type = 'Experiment'
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  GROUP BY 1, 2,3,4




union all


  SELECT DATE_TRUNC(order_date, MONTH) AS month,vertical,city,
  "Campaign" as dps_vendor_price_scheme_type,
 count(*) as order_count,sum(delivery_fee_amount_lc) as total_df, 
 --safe_divide(sum(delivery_fee_amount_lc),count(*)) as avg_df,
 -- COALESCE(AVG(delivery_fee_amount_lc), 0) AS avg_df
  FROM orders
  WHERE  dps_vendor_price_scheme_type = 'Campaign'
  AND NOT (is_tpro_order AND delivery_fee_amount_lc = 0)
  AND NOT (is_fdnc_order AND delivery_fee_amount_lc = 0 AND dps_vendor_price_scheme_type <<>> 'Experiment')

