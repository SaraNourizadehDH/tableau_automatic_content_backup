WHERE agg_vendor_performance_summarised_daily.date>>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 MONTH)

AND (UPPER(dim_vendor_location.city_name) = UPPER('Abu Dhabi') 
OR UPPER(dim_vendor_location.city_name) = UPPER('Ajman') 
OR UPPER( dim_vendor_location.city_name) = UPPER('Al Ain') 
