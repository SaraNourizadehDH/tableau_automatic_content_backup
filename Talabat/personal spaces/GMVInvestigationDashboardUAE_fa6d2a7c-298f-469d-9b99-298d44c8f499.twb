     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id

INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id

     
 LEFT JOIN `tlb-data-prod.data_platform.agg_customer_profile`
     AS agg_customer_profile ON agg_customer_profile.analytical_customer_id = fct_order_info.analytical_customer_id    

INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id


INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
     AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id


WHERE fct_order_info.order_date >>=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 Month) and fct_order_info.country_iso="AE"

GROUP BY 1,2,3,4


) using (country,city,month,vertical)


LEFT JOIN (SELECT 
   "UAE" as country,
     date_trunc(fct_order_info.order_date,month) as month,
     
     delivery_location.city_name as city,
 CASE
    WHEN dim_chain.vertical_class = 'food' THEN 'Food'
    WHEN dim_chain.sub_vertical = 'darkstore' THEN 'tMart'
    ELSE 'LS'
  END as vertical, 
  
    COALESCE(SUM(CAST( agg_order_item.ordered_quantity   AS NUMERIC)), 0) AS total_items,
   -- COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0) AS successful_orders,
  --  COALESCE(SUM(fct_order_info.basket_amount_lc ), 0) AS basket_amount

FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
     AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id
LEFT JOIN `tlb-data-prod.data_platform.agg_order_item`
     AS agg_order_item ON fct_order_info.order_id = agg_order_item.order_id
      and fct_order_info.order_date = agg_order_item.order_date
      and ordered_quantity<<500


WHERE (fct_order_info.is_successful ) AND fct_order_info.order_date >>=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 Month)

 AND UPPER(fct_order_info.country_iso) = UPPER('AE') AND  fct_order_info.country_iso="AE"

GROUP BY
    1,
    2,
    3,
    4

union all

SELECT  
   "UAE" as country,
     date_trunc(fct_order_info.order_date,month) as month,
     
     delivery_location.city_name as city,
"All" as vertical, 
  
    COALESCE(SUM(CAST( agg_order_item.ordered_quantity   AS NUMERIC)), 0) AS total_items,
   -- COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0) AS successful_orders,
  --  COALESCE(SUM(fct_order_info.basket_amount_lc ), 0) AS basket_amount

FROM `tlb-data-prod.data_platform.fct_order_info`
