            </column>
            <column caption='Last' datatype='integer' name='[Calculation_1002895410020421634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NFR %' datatype='real' name='[Calculation_1127870255417847820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([net_failed_orders])/sum([net_order_count])' />
            </column>
            <column caption='EF' datatype='real' name='[Calculation_1127870255701450765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1767381399630172172]+[Calculation_1767381399631691790]' />
            </column>
            <column caption='Net Fail Rate %' datatype='real' name='[Calculation_1767381399330660352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([net_failed_order_count])&#13;&#10;/&#13;&#10;sum([net_order_count])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1767381399618617347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; then&#13;&#10;[successful_gmv_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1767381399620677638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1767381399618617347])/SUM([successful_orders])' />
            </column>
            <column caption='Platform Acquisition' datatype='real' name='[Calculation_1767381399625715719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([platform_acquisition])' />
            </column>
            <column caption='Basket Amount' datatype='real' name='[Calculation_1767381399628902409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; then &#13;&#10;[successful_basket_amount_lc]&#13;&#10;elseif [Parameters].[Parameter 1] = &quot;Eur&quot; then &#13;&#10;[successful_basket_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1767381399629238282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1767381399628902409])/sum([successful_orders])' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_1767381399629639691]' role='measure' type='quantitative'>
