)

Left join (SELECT 
    dim_vendor_location.country_name  AS country,
        date_trunc(agg_vendor_performance_summarised_daily.date ,month) AS month,
    dim_vendor_location.city_name  AS city,

CASE
    WHEN dim_chain.vertical_class = 'food' THEN 'Food'
    WHEN dim_chain.sub_vertical = 'darkstore' THEN 'tMart'
    ELSE 'LS'
  END as vertical, 


-- SAFE_DIVIDE(COALESCE(SUM(agg_vendor_performance_summarised_daily.placed_order_session_count ), 0), COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0)) AS vendor_cvr,
-- SAFE_DIVIDE(COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0), COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0)) AS mcvr3,
-- SAFE_DIVIDE(COALESCE(SUM(agg_vendor_performance_summarised_daily.added_to_cart_session_count ), 0), COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0)) AS mcvr3a,
-- SAFE_DIVIDE(COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0),COALESCE(SUM(agg_vendor_performance_summarised_daily.added_to_cart_session_count ), 0)) AS mcvr3b,
-- SAFE_DIVIDE(COALESCE(SUM(agg_vendor_performance_summarised_daily.placed_order_session_count ), 0), COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0)) AS mcvr4,


COALESCE(SUM(agg_vendor_performance_summarised_daily.placed_order_session_count ), 0) as placed_order_sessions,
COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0) as menu_view_sessions,

COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0) as started_checkout_sessions,
--COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0) as menu_view_sessions,

--COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0) as started_checkout_sessions,
COALESCE(SUM(agg_vendor_performance_summarised_daily.added_to_cart_session_count ), 0) as added_to_cart_session,


-- COALESCE(SUM(agg_vendor_performance_summarised_daily.placed_order_session_count ), 0) as placed_order_session_count,
-- COALESCE(SUM(agg_vendor_performance_summarised_daily.started_checkout_sessions_count ), 0) as started_checkout_sessions,


FROM `tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily`
     AS agg_vendor_performance_summarised_daily
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
     AS dim_vendor_info ON agg_vendor_performance_summarised_daily.vendor_id = (CAST(dim_vendor_info.vendor_id AS STRING))

LEFT JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS dim_vendor_location ON dim_vendor_location.location_id = dim_vendor_info.location_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = dim_vendor_info.chain_id
WHERE agg_vendor_performance_summarised_daily.date>>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 MONTH)

