        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12ai0c91qp2kbn13242jf18nl53g' name='Custom SQL Query' type='text'>SELECT&#13;
&#13;
&#13;
     &quot;UAE&quot; as country,&#13;
     date_trunc(fct_order_info.order_date,month) as month,&#13;
     &#13;
     delivery_location.city_name as City,&#13;
&#13;
&#13;
    CASE&#13;
    WHEN dim_chain.vertical_class = &apos;food&apos; THEN &apos;Food&apos;&#13;
    WHEN dim_chain.sub_vertical = &apos;darkstore&apos; THEN &apos;tMart&apos;&#13;
    ELSE &apos;LS&apos;&#13;
  END as vertical, &#13;
&#13;
&#13;
&#13;
    dim_order_fail_reason.talabat_reason  AS fail_reason,&#13;
&#13;
    dim_order_fail_reason.owner  AS fail_reason_owner,&#13;
   &#13;
&#13;
&#13;
&#13;
  (CASE WHEN fct_order_info.is_successful  THEN &apos;Yes&apos; ELSE &apos;No&apos; END) AS is_successful,&#13;
&#13;
    COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0) AS net_orders_count&#13;
&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_order_info`&#13;
     AS fct_order_info&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`&#13;
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`&#13;
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_chain`&#13;
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_location_info`&#13;
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id&#13;
&#13;
WHERE fct_order_info.order_date &gt;&gt;=DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -13 Month)&#13;
&#13;
 AND ((UPPER(( fct_order_info.country_iso  )) = UPPER(&apos;AE&apos;))) AND (NOT (dim_order_status_flags.is_incomplete_online_payment ) OR (dim_order_status_flags.is_incomplete_online_payment ) IS NULL) AND (dim_order_status_flags.is_net ) AND  fct_order_info.country_iso=&quot;AE&quot;&#13;
&#13;
&#13;
&#13;
   &#13;
GROUP BY&#13;
    1,&#13;
    2,&#13;
    3,&#13;
    4,&#13;
    5,&#13;
    6,&#13;
    7&#13;
&#13;
&#13;
    union all&#13;
&#13;
    SELECT&#13;
&#13;
&#13;
     &quot;UAE&quot; as country,&#13;
     date_trunc(fct_order_info.order_date,month) as month,&#13;
