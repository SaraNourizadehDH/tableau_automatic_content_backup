            <properties context=''>
              <relation connection='bigquery.0cp32jg0qhryg31fbqypl0yn4v9h' name='Custom SQL Query' type='text'><![CDATA[--DECLARE myArray ARRAY <<STRING>> ;

with myarray as (

select * from 

unnest(["UAE"]) as country,
unnest(['Food','tMart','LS','All']) as vertical,
unnest(['One-Timers','HVC','MVC','LVC','All']) as customer_segment,

unnest(['Abu Dhabi','Ajman','Al Ain','Dubai','Fujairah','Ras Al Khaima','Sharjah','Umm Al-Quwain','All']) as city,

unnest(generate_date_array(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -6 MONTH), current_date(), interval 1 month)) as month

)


select * from myarray

LEFT JOIN (SELECT "UAE" as country,
    date_trunc(fct_order_info.order_date,Month) as Month ,

    city_name AS city,
    
   -- fct_order_info.delivery_arrangement  AS delivery_arrangement,

    case
    when dim_chain.vertical_class = 'food' then 'Food'
    when dim_chain.sub_vertical = 'darkstore' then 'tMart'
    else 'LS'
    end as vertical,
     
  CASE 
  WHEN growth_customer_segment like "%One-Timers%" THEN "One-Timers"
  WHEN growth_customer_segment like "%High Frequency%" THEN "HVC"
  WHEN growth_customer_segment like "%Mid Frequency%" THEN "MVC"
  WHEN growth_customer_segment like "%Low Frequency%" THEN "LVC"
  else NULL end as customer_segment,

  COUNT(DISTINCT fct_order_info.analytical_customer_id) AS MAU,
  Count(DISTINCT fct_order_info.order_id) as Order_count 


-- COUNT(DISTINCT fct_order_info.order_id) AS orders,

FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id


INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id

