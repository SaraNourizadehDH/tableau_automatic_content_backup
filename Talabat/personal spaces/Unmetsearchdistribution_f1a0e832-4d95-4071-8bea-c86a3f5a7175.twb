        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ad9kdp16y5koy1bshdba1d3b2e7' name='Custom SQL Query' type='text'>SELECT 
b.country_code, 
pluto_brand_id, 
-- vendor_name,
count(distinct session_id) as branded_search_session,
count(distinct case when unserviceability_reason=&apos;OUT_OF_COVERAGE&apos; then session_id end) as unmet_branded_search_session,
count(distinct case when unserviceability_reason is null then session_id end) as met_branded_search_session,
count(distinct case when unserviceability_reason is null and placed_order then session_id end) as met_converted_session,
count(distinct case when unserviceability_reason=&apos;OUT_OF_COVERAGE&apos; and placed_order then session_id end) as unmet_converted_session,

FROM `tlb-data-prod.data_platform.fct_logistics_brand_search` b
-- left join `tlb-data-dev.data_platform.pluto_mid_food_brand_vendor_lookup` using(pluto_brand_id, country_code)
WHERE true
and date &gt;&gt;= current_date-90
and vertical=&apos;food&apos;
group by all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ad9kdp16y5koy1bshdba1d3b2e7' name='Custom SQL Query' type='text'>SELECT 
