sum(actual_delivery_time/60) as DT_numer,
count(distinct case when (actual_delivery_time/60)&gt;&gt;45 then order_id end) as no_of_orders_dt45,
count(distinct case when order_status != &apos;completed&apos; then order_id end) as failed_orders,
FROM `tlb-data-prod.data_platform.fct_logistics_order`

left join `tlb-data-prod.data_platform.dim_logistics_city` using(country_code, city_id, timezone)
left join `tlb-data-prod.data_platform.dim_logistics_zone` using(country_code, city_id, zone_id)
where
(date(coalesce(primary_rider_dropped_off_at , hurrier_order_placed_at),timezone) &gt;&gt;= date_add(current_date,interval -3 month))
and country_code IN (&apos;ae&apos;,&apos;bh&apos;,&apos;eg&apos;,&apos;iq&apos;,&apos;jo&apos;,&apos;kw&apos;,&apos;om&apos;,&apos;qa&apos;)
-- and city_name=&apos;Dubai&apos;
and is_rider_order
and not is_logistics_preorder
and zone_id is not null
group by all
order by 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
