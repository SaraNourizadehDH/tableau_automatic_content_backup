          <named-connection caption='BigQuery' name='bigquery.1m7x26h1wnttfo1h1rtfs120qdx3'>
            <connection CATALOG='tlb-datateam-analysis-6343' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-datateam-analysis' schema='bq_logs' server-oauth='server-custom' username='weichun.chang@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1m7x26h1wnttfo1h1rtfs120qdx3' name='Custom SQL Query' type='text'><![CDATA[with temp as(
select o.order_date
  , country_iso
  --, Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) delay_time
  , case when repayment_reason = 'Early delivery' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) << 30 then 1
      when repayment_reason = 'Severe delay' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) not between 10 and 20 then 1
      --when repayment_reason = 'Late Delivery>>Late Order - Restaurant' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) not between 10 and 20 then 1
      when repayment_reason = 'Extreme delay' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) not between 20 and 30 then 1
      --when repayment_reason = 'Request: order is late, does not want to wait' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) >> 20 then 1
      --when repayment_reason = 'Request: order will take longer than expected' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) >> 10 then 1
      --when repayment_reason = 'Complain about late order - Delay from 11-20 mins' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) not between 10 and 20 then 1
      --when repayment_reason = 'Complain about late order - Delay>>30 mins' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) >> 30 then 1
      --when repayment_reason = 'Complain about late order - Delay from 21-30 mins' and Timestamp_diff(cast(repayment_time_utc as timestamp) ,l.promised_delivery_at,minute) not between 20 and 30 then 1
      when repayment_reason in ('Wrong item - Side','Wrong item - Dessert/Drink') and contact_reason_l3 != 'Wrong item' then 1
      when repayment_reason in ('Missing item - Side','Wrong item - Main','Missing item - Dessert/Drink') and contact_reason_l3 != 'Missing item' then 1
      when repayment_reason in ('Food poisoning','Food portion','Spilled food - Side','Food quality - Taste issue (Side)','Food quality - Food not edible (Side)'
                              ,'Food quality - Taste issue (Main)','Cold Item','Cooking instructions were not followed','Moderate delay','Food temperature') 
                              and contact_reason_l3 != 'Food quality' then 1
        else 0 end non_compliance
  , case when repayment_reason = 'Early delivery' then '>> 30 mins'
      when repayment_reason = 'Severe delay' then '10 - 20 mins'
      when repayment_reason = 'Extreme delay' then '20 - 30 mins'
      when repayment_reason in ('Wrong item - Side','Wrong item - Dessert/Drink') then 'Wrong item'
      when repayment_reason in ('Missing item - Side','Wrong item - Main','Missing item - Dessert/Drink') then 'Missing item'
      when repayment_reason in ('Food poisoning','Food portion','Spilled food - Side','Food quality - Taste issue (Side)','Food quality - Food not edible (Side)'
                              ,'Food quality - Taste issue (Main)','Cold Item','Cooking instructions were not followed','Moderate delay','Food temperature') then 'Food quality'
        else repayment_reason
      end as repayment_type
  , sum(repayment_amount_eur) repayment_amount_eur
  , count(distinct repayment_id) compensations
from `tlb-data-prod.data_platform.fct_order_info` o
  left join `tlb-data-prod.data_platform.fct_logistics_order` l 
    on o.order_id = l.order_id 
      and lower(o.country_Code)=lower(l.country_code)
      and created_date >>='2024-08-01'
  inner join `tlb-data-prod.data_platform.fct_repayment` r
    on o.order_id = r.order_id 
      and lower(o.country_Code)=lower(r.country_code)
      and repayment_date_utc >>= '2024-08-01'
  left join `tlb-data-prod.data_platform.dim_repayment_type` rt
    on r.repayment_type_id = rt.repayment_type_id
      and rt.repayment_type in ('Compensation Order Related','Partial Refund')
      and automation_type != 'autoPartialRefund'
  inner join `tlb-data-dev.data_platform.dim_repayment_reason` rr
    on r.repayment_reason_id = rr.repayment_reason_id
      and repayment_reason in ('Extreme delay','Severe delay','Early delivery','Wrong item - Side','Wrong item - Dessert/Drink','Missing item - Side','Wrong item - Main'
              ,'Missing item - Dessert/Drink','Food poisoning','Food portion','Spilled food - Side','Food quality - Taste issue (Side)','Food quality - Food not edible (Side)'
                              ,'Food quality - Taste issue (Main)','Cold Item','Cooking instructions were not followed','Moderate delay','Food temperature')
  left join `fulfillment-dwh-production.curated_data_shared.herocare_chats` contact
    on cast(o.order_id as string) = contact.order_id
where o.order_date>>='2024-08-01'
  --and o.order_date << '2024-10-31'
  AND o.country_iso <<>> 'SA'
  AND not o.is_test and not o.is_abandoned
  AND o.delivery_arrangement = 'TGO'
group by all
)
select order_date
  , country_iso
  , repayment_type
  , non_compliance
  , sum(compensations) as compensations
  , sum(repayment_amount_eur) repayment_amount_eur
from temp 
group by all
order by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
