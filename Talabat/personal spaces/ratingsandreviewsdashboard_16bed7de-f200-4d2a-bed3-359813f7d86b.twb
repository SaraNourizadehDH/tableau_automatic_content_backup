        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nahyg21e9yk6i1h4hmcs1sx992c' name='Custom SQL Query' type='text'>select 
date,
country_code,
event_action, 
event_origin,
count(distinct perseus_session_id) as sessions
-- count(distinct case when event_origin = &apos;order_list&apos; then perseus_session_id end) as  past_order_screen_sessions,
-- count(distinct case when event_origin = &apos;home&apos; then perseus_session_id end) as  home_sessions
from 
`tlb-data-prod.data_platform.fct_hit` h
left join 
`tlb-data-prod.data_platform.dim_session_event` e on h.session_event_id = e.session_event_id
where date &gt;&gt;= &apos;2024-07-01&apos;
and event_action in (&apos;order_rate.loaded&apos;,&apos;order_rate.submitted&apos;,&apos;order_rate.closed&apos;,&apos;order_rate.clicked&apos;)
and screen_name is not null
and event_origin in (&apos;order_list&apos;,&apos;home&apos;)
group by 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1nahyg21e9yk6i1h4hmcs1sx992c' name='Custom SQL Query' type='text'>select 
date,
country_code,
event_action, 
event_origin,
count(distinct perseus_session_id) as sessions
-- count(distinct case when event_origin = &apos;order_list&apos; then perseus_session_id end) as  past_order_screen_sessions,
-- count(distinct case when event_origin = &apos;home&apos; then perseus_session_id end) as  home_sessions
from 
`tlb-data-prod.data_platform.fct_hit` h
left join 
`tlb-data-prod.data_platform.dim_session_event` e on h.session_event_id = e.session_event_id
where date &gt;&gt;= &apos;2024-07-01&apos;
and event_action in (&apos;order_rate.loaded&apos;,&apos;order_rate.submitted&apos;,&apos;order_rate.closed&apos;,&apos;order_rate.clicked&apos;)
and screen_name is not null
and event_origin in (&apos;order_list&apos;,&apos;home&apos;)
group by 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
