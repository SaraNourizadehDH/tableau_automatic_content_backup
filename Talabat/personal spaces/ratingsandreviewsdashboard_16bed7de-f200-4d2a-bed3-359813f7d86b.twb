        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13f9njr1lpjpnv1h5xmja169ogl6' name='Custom SQL Query' type='text'>select 
order_date as date,
o.country_code, 
is_non_food,
-- null as event_action,
count(distinct o.order_id) as succesful_order,
count(distinct r.order_id) as rated_orders,
avg(r.original_rating) as avg_rating
from `tlb-data-prod.data_platform.fct_order_info` o 
left join 
`tlb-data-prod.data_platform.fct_rating` r on o.order_id = r.order_id 
where order_date &gt;&gt;= &apos;2024-07-01&apos; 
and is_successful
and o.country_code not in (&apos;SA&apos;)
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
