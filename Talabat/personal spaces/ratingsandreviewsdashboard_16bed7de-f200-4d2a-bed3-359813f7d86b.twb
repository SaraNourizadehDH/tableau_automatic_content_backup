            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='server-custom' username='favaz.azeez@talabat.com' workgroup-auth-mode='as-is' />
