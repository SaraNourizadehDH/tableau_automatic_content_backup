              <calculation class='tableau' formula='{FIXED:(COUNTD(if [order_date] &gt;= [Parameters].[Before (copy)_1161084287952760834] and [order_date] &lt;= [Parameters].[After (copy)_1161084287952986116] then [order_date] end))}' />
            </column>
            <column caption='Reasons' datatype='string' name='[Calculation_1900800524076691456]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1986087441300201495] &lt; 0 &#13;&#10;  THEN (&#13;&#10;      IF [A. AVG SF (copy)_1986087441288368143]&lt;[country_a_sf (copy)_1986087441296744468] AND [A. AVG SF % of GFV (copy)_1986087441295294483]&gt;=[country_a_sf (copy)_1986087441296744468] THEN &quot;-VE: SF% Decreased&quot;&#13;&#10;      ELSEIF [b_avg_daily_orders (copy)_846958214580871169] = 0 THEN &quot;-VE: Chain Left, High SF%&quot;&#13;&#10;      ELSEIF [b_avg_daily_orders (copy)_846958214580871169] = 0 THEN &quot;-VE: New Chain, Low SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND [Calculation_1986087441301725210] &lt; [A. AFV (copy)_1986087441301917723] AND [b_avg_daily_orders (copy)_846958214580871169] &lt; [Calculation_846958214580629504]&#13;&#10;      THEN &quot;-VE: Weight Increased, Low SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &gt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)&#13;&#10;      THEN &quot;-VE: AFV Increased, Low SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &lt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)   &#13;&#10;      THEN &quot;-VE: Orders Increased, Low SF%&quot; &#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND [Calculation_1986087441301725210] &gt; [A. AFV (copy)_1986087441301917723] AND [b_avg_daily_orders (copy)_846958214580871169] &lt; [Calculation_846958214580629504]&#13;&#10;      THEN &quot;-VE: Weight Decreased, High SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &gt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)&#13;&#10;      THEN &quot;-VE: Orders Decreased, High SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &lt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)&#13;&#10;      THEN &quot;-VE: AFV Decreased, High SF%&quot; &#13;&#10;      END&#13;&#10;  )   &#13;&#10; &#13;&#10;ELSEIF [Calculation_1986087441300201495] &gt; 0&#13;&#10;  THEN ( &#13;&#10;      IF [A. AVG SF (copy)_1986087441288368143]&gt;=[country_a_sf (copy)_1986087441296744468] AND [A. AVG SF % of GFV (copy)_1986087441295294483]&lt;[country_a_sf (copy)_1986087441296744468] THEN &quot;+VE: SF% Increased&quot;&#13;&#10;      ELSEIF [b_avg_daily_orders (copy)_846958214580871169] = 0 THEN &quot;+VE: Chain Left, Low SF%&quot;&#13;&#10;      ELSEIF [Calculation_846958214580629504] = 0 THEN &quot;+VE: New Chain, High SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND [Calculation_1986087441301725210] &lt; [A. AFV (copy)_1986087441301917723] AND [b_avg_daily_orders (copy)_846958214580871169] &lt; [Calculation_846958214580629504]&#13;&#10;      THEN &quot;+VE: Weight Increased, High SF%&quot; &#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &gt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1) &#13;&#10;      THEN &quot;+VE: AFV Increased, High SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &gt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &lt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)&#13;&#10;      THEN &quot;+VE: Orders Increased, High SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND [Calculation_1986087441301725210] &gt; [A. AFV (copy)_1986087441301917723] AND [b_avg_daily_orders (copy)_846958214580871169] &gt; [Calculation_846958214580629504]&#13;&#10;      THEN &quot;+VE: Weight Decreased, Low SF%&quot; &#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &gt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1)&#13;&#10;      THEN &quot;+VE: Orders Decreased, Low SF%&quot;&#13;&#10;      ELSEIF [A. AVG SF % of GFV (copy)_1986087441295294483] &lt; [country_a_sf % of gfv (copy)_1986087441296990229] AND (([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723])-1) &lt; (([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504])-1) &#13;&#10;      THEN &quot;+VE: AFV Decreased, Low SF%&quot;&#13;&#10;      END      &#13;&#10;  )&#13;&#10;  ELSE &quot;No Significant Change&quot;&#13;&#10;  END' />
            </column>
            <column caption='heur_sf' datatype='real' default-format='n#,##0.000000;-#,##0.000000' name='[Calculation_1986087441300201495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([a_df_contrib (copy)_1986087441283371009]-[b_df_contrib (copy)_1986087441283751940])&#13;&#10;-&#13;&#10;([a_sf_contrib (copy)_1986087441300484120]-[a_gfv_contrib (copy)_1986087441300766745])' />
            </column>
            <column caption='A. AFV' datatype='real' name='[Calculation_1986087441301725210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([a_sf (copy)_1986087441288622096])/SUM([a_gfv (copy)_1161084288226938895])' />
            </column>
            <column caption='B. AVG Daily Orders' datatype='real' name='[Calculation_846958214580629504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b_gfv (copy)_1161084288226783246])/SUM([a_days (copy)_891431260635848704])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_874261280838877184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Chain&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Zone&apos; THEN[Zone]&#13;&#10;WHEN &apos;Hour of Day&apos; THEN STR([order_hour])&#13;&#10;WHEN &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;, [order_date])&#13;&#10;WHEN &apos;Acquisition&apos; THEN [Acquisition]&#13;&#10;END' />
            </column>
            <column caption='dynamic date B_from' datatype='datetime' name='[Calculation_968273988312436736]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='//DATEPART(&apos;week&apos;,[today],&apos;Sunday&apos;)&#13;&#10;DATETRUNC(&apos;week&apos;, TODAY(), &apos;Sunday&apos;)-(7*2)' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Contrib to SF Change' datatype='real' default-format='n#,##0.000000;-#,##0.000000' name='[Contrib to DF (copy)_1986087441283928070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1986087441300201495]/[heur_sum (copy)_1986087441307734046]*[country_sf_diff (copy)_1986087441299222550]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Main_Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[Zone]' role='dimension' type='nominal' />
            <column caption='b_days' datatype='integer' name='[a_days (copy)_891431260635848704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED:(COUNTD(if [order_date] &gt;= [Parameters].[order_date Parameter] and [order_date] &lt;= [Parameters].[Before From (copy)_1161084287952920579] then [order_date] end))}' />
            </column>
            <column caption='a_sf' datatype='real' name='[a_df (copy)_1986087441283284992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(if [order_date] &gt;= [Parameters].[Before (copy)_1161084287952760834] and [order_date] &lt;= [Parameters].[After (copy)_1161084287952986116] THEN [sf] END)' />
            </column>
            <column caption='a_sf_contrib' datatype='real' default-format='p0.0000%' name='[a_df_contrib (copy)_1986087441283371009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([a_df (copy)_1986087441283284992])/SUM({Fixed :SUM([a_df (copy)_1986087441283284992])})' />
            </column>
            <column caption='a_orders' datatype='integer' name='[a_gfv (copy)_1161084288226938895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(if [order_date] &gt;= [Parameters].[Before (copy)_1161084287952760834] and [order_date] &lt;= [Parameters].[After (copy)_1161084287952986116] then [orders] end)' />
