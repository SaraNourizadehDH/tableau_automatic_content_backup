      <column caption='Reason-SF' datatype='string' name='[Reason-DF (copy)_844424936078430208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//+VE&#13;&#10;IF [Calculation_1986087441300201495] &gt; 0&#13;&#10;  THEN (&#13;&#10;      IF [Calculation_846958214580629504]=0 THEN &apos;+VE: New Chain&apos;&#13;&#10;       &#13;&#10;      //high high &#13;&#10;      ELSEIF [A. AVG SF (copy)_1986087441288368143]&gt;=[country_a_sf (copy)_1986087441296744468] AND [A. AVG SF % of GFV (copy)_1986087441295294483]&lt;[country_a_sf % of gfv (copy)_1986087441296990229]&#13;&#10;        THEN &quot;+VE: SF% Increased&quot;&#13;&#10;      ELSEIF [A. AVG SF (copy)_1986087441288368143]&gt;=[country_a_sf (copy)_1986087441296744468] AND [A. AVG SF % of GFV (copy)_1986087441295294483]&gt;=[country_a_sf % of gfv (copy)_1986087441296990229]&#13;&#10;       THEN(&#13;&#10;        IF [A. AVG DF (copy)_1986087441283526658]&gt;[B. AVG DF (copy)_1986087441283768325] AND [Calculation_1986087441301725210]&lt;[A. AFV (copy)_1986087441301917723]&#13;&#10;            THEN &quot;+VE: AFV Decreased, High Service Fee&quot;&#13;&#10;        //ELSE&#13;&#10;        END)&#13;&#10;      ELSEIF [A. AVG SF (copy)_1986087441288368143]&lt;[country_a_sf (copy)_1986087441296744468] AND [A. AVG SF % of GFV (copy)_1986087441295294483]&lt;[country_a_sf % of gfv (copy)_1986087441296990229]&#13;&#10;        THEN&#13;&#10;            IF ABS([Calculation_1986087441301725210]/[A. AFV (copy)_1986087441301917723]-1)&gt;=([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&#13;&#10;                THEN &quot;+VE: AFV Decreased, Low SF%&quot;&#13;&#10;            ELSE &quot;+VE: Average Daily Orders Decreased, Low SF%&quot;&#13;&#10;            END&#13;&#10;      END)&#13;&#10;            &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/*&#13;&#10;&#13;&#10;&#13;&#10;           IF ABS([A. AVG Daily Orders]/[B. AVG Daily Orders]-1)&gt;=ABS([A. AVG DF]/[B. AVG DF]-1) AND [A. AVG Daily Orders]&gt;=[B. AVG Daily Orders]&#13;&#10;               THEN &quot;+VE: Orders Increased, High Delivery Fee&quot;&#13;&#10;           ELSEIF ABS([A. AVG Daily Orders]/[B. AVG Daily Orders]-1)&gt;=ABS([A. AVG DF]/[B. AVG DF]-1) AND [orders_contrib_diff]&gt;=0&#13;&#10;               THEN &quot;+VE: Orders Contribution Increased, High Delivery Fee&quot;&#13;&#10;           ELSEIF[A. AVG DF]&gt;=[B. AVG DF] &#13;&#10;               THEN &quot;+VE: Avg Delivery Fee Increased&quot;&#13;&#10;          // ELSE &quot;ERROR (high high)&quot; &#13;&#10;           END)&#13;&#10;&#13;&#10;      //low low df&#13;&#10;      ELSEIF [A. AVG DF]&lt;=[country_a_df] AND [B. AVG DF]&lt;=[country_b_df]&#13;&#10;        THEN (&#13;&#10;            IF ABS([A. AVG Daily Orders]/[B. AVG Daily Orders]-1)&gt;=ABS([A. AVG DF]/[B. AVG DF]-1) AND [A. AVG Daily Orders]&lt;=[B. AVG Daily Orders]&#13;&#10;                THEN &quot;+VE: Orders Decreased, Low Delivery Fee&quot;&#13;&#10;            ELSEIF ABS([A. AVG Daily Orders]/[B. AVG Daily Orders]-1)&gt;=ABS([A. AVG DF]/[B. AVG DF]-1) AND [orders_contrib_diff]&lt;=0&#13;&#10;                THEN &quot;+VE: Orders Contribution Decreased, Low Delivery Fee&quot;&#13;&#10;            ELSEIF [A. AVG DF]&gt;=[B. AVG DF]&#13;&#10;                THEN &quot;+VE: Avg Delivery Fee Increased&quot;&#13;&#10;            //ELSE  &quot;ERROR (low low)&quot;&#13;&#10;            END)&#13;&#10;&#13;&#10;        //high low df&#13;&#10;       ELSEIF [A. AVG DF]&gt;=[country_a_df] AND [B. AVG DF]&lt;[country_b_df]&#13;&#10;         THEN &quot;+VE: Avg Delivery Fee Increased&quot;&#13;&#10;&#13;&#10;        END&#13;&#10;    )&#13;&#10;*/&#13;&#10;&#13;&#10;//-VE &#13;&#10;&#13;&#10;ELSE &quot;No Significant Change&quot;&#13;&#10;END' />
      </column>
