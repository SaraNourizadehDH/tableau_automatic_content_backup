      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_07C4AC43AED9488EA3CF956A549AFC42'>
            <properties context=''>
              <relation connection='bigquery.0ipnhb20hvuscu10p3tep1xa50f2' name='Custom SQL Query' type='text'>SELECT o.order_date,&#13;
  EXTRACT(HOUR FROM o.order_time) order_hour,&#13;
  ch.chain_id,&#13;
  ch.chain_name, &#13;
  loc.zone_name_final Zone,&#13;
  loc.city_name City,&#13;
  loc.cluster_name,&#13;
  CASE WHEN o.is_acquisition THEN &apos;New Customers&apos; ELSE &apos;Existing Customers&apos; END Acquisition,&#13;
  CASE WHEN o.is_nfv THEN &quot;NFV&quot; WHEN NOT o.is_non_food THEN &quot;Food&quot; END Main_Vertical,&#13;
  COUNT(distinct o.order_id) orders,&#13;
  SUM(service_fee_amount_lc) sf,&#13;
  SUM(basket_amount_lc) gfv,&#13;
  -- Delivery Fees&#13;
  sum(case when o.vendor_id in (616304,&#13;
  616297,616303,616313,616320,616292,616274,616283,616302,616277,616260,616250,616244,616254,616265,616264,616253,616300,616318,616275,616272,616310,&#13;
  616287,616262,616294,616249,616280,616261,616293,616271,616273,616269,616285,616268,616251,616295,616266,616298,616319,616276,616288,616289,616308,&#13;
  616321,616281,616248,616284,616279,616270,616263,616299,616311,616307,616291,616267,616314,616315,508472,513068,507788,507782,502655,507795,507789,&#13;
  507802,507801,507786,507804,507803,514137,507798,502657,507787,502612,502635,502626,502601,502637,502679,502660,502628,502644,502652,502606,502658,&#13;
  502607,502648,502654,502619,502662,502661,502627,502636,502649,502630,502650,502663,502609,502629,502624,502622,502634,502640,502611,502638,510517,&#13;
  510518,502633,502623,502608,502643,515562,513063,502632,514139,502647,648494,648493,510513,502616,502674,502672,502682,506609,509111,502653,502615,&#13;
  514117,502666,509816,502668,502605,502621,506615,510175,502614,502664,511062,502620,506606,502602,513065,514315,502685,512997,514822,502665,508471,&#13;
  502639,502613,502603,511181,502683,502610,502675,514114,502656,511916,502669,502651,502641,511063,515587,515582,515581,515578,515591,515575,515599,&#13;
  515592,515586,515580,515589,515585,515579,515584,515572,515574,510390,506613,507794,502670,502680,502677,502618,506616,502681,507793,506614,507800,&#13;
  502671,502625,502631,502642,511180,502676,502604,506557,507799,507796,502678,502646,506607,506611,502617,502645,502659,515576,515577,515597,515598,&#13;
  515590,512531,506612,502673,502684,502686,502667,506610,506602,513071,649050,649049,661906,500054,500309,501210,501142) &#13;
  then 0.08 * o.delivery_fee_amount_lc &#13;
  else o.delivery_fee_amount_lc  END) df,&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` o&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch USING(chain_id)&#13;
LEFT JOIN `tlb-data-prod.data_platform.sq_dim_location_eg` loc ON o.delivery_location_id = loc.location_id &#13;
&#13;
WHERE o.is_successful AND NOT o.is_test AND NOT o.is_abandoned AND o.country_id=9&#13;
  AND o.is_tgo AND NOT o.is_darkstore&#13;
  AND o.order_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 3 MONTH)&#13;
&#13;
GROUP BY 1,2,3,4,5,6,7,8,9</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
