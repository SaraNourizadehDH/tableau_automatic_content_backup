[b_eg_comm% (copy)_846958214586818562] AND [a_avg_df (copy)_959266743372091396]&lt;[b_comm_amt (copy)_891431260639797249]&#13;&#10;          THEN &quot;+VE: Avg Delivery Fee Increased&quot;&#13;&#10;&#13;&#10;&#13;&#10;        END&#13;&#10;    )&#13;&#10;&#13;&#10;&#13;&#10;ELSE &quot;No Significant Change&quot;&#13;&#10;END' />
