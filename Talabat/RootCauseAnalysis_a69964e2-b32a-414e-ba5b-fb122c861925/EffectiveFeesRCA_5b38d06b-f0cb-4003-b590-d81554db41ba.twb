              <calculation class='tableau' formula='#2024-11-10#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1mopkaf18uh7jh1gdhfd81af1x7u].[dynamic date (copy)_968273988328316929]' caption='Benchmark-To' datatype='date' name='[Before From (copy)_1161084287952920579]' param-domain-type='range' role='measure' type='quantitative' value='#2024-11-09#'>
              <calculation class='tableau' formula='#2024-11-09#' />
            </column>
            <column caption='Top% of MAX' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='25.'>
              <calculation class='tableau' formula='25.' />
              <range max='100.0' min='0.0' />
            </column>
            <column caption='Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1mopkaf18uh7jh1gdhfd81af1x7u].[Calculation_968273988312436736]' caption='Benchmark-From' datatype='date' name='[order_date Parameter]' param-domain-type='range' role='measure' type='quantitative' value='#2024-11-03#'>
              <calculation class='tableau' formula='#2024-11-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mopkaf18uh7jh1gdhfd81af1x7u'>
            <column datatype='string' name='[Acquisition]' role='dimension' type='nominal' />
            <column caption='a_days' datatype='integer' name='[Calculation_1161084288254140440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED:(COUNTD(if [order_date] &gt;= [Parameters].[Before (copy)_1161084287952760834] and [order_date] &lt;= [Parameters].[After (copy)_1161084287952986116] then [order_date] end))}' />
            </column>
            <column caption='Contrib to DF' datatype='real' default-format='n#,##0.0000;-#,##0.0000' name='[Calculation_342273580542169088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846958214591156231]/[Calculation_837106591888977924]*[Calculation_846958214644764687]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='heur_sum' datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Calculation_837106591888977924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(if [max_sbheur (copy)_837106591885959171] then [Calculation_846958214591156231] else 0 end)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='B. AVG Daily Orders' datatype='real' name='[Calculation_846958214580629504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b_gfv (copy)_1161084288226783246])/SUM([a_days (copy)_891431260635848704])' />
            </column>
            <column caption='a_df_contrib' datatype='real' default-format='p0.0000%' name='[Calculation_846958214587723779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([a_gfv (copy)_959266743371624449])/SUM({Fixed :SUM([a_gfv (copy)_959266743371624449])})' />
            </column>
            <column caption='heuristic' datatype='real' default-format='n#,##0.000000;-#,##0.000000' name='[Calculation_846958214591156231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_846958214587723779]-[a_gfv_contrib (copy)_846958214590738438])-([a_gv_contrib (copy)_1202742580856279040]-[a_orders_contrib (copy)_1202742580857401345])' />
            </column>
            <column caption='country_df_diff' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846958214644764687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[b_eg_comm% (copy)_846958214586818562] - [b_comm_amt (copy)_891431260639797249]' />
            </column>
            <column caption='sortbyheur' datatype='real' default-format='n#,##0.000000;-#,##0.000000' name='[Calculation_854558039308587009]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_846958214644764687] &gt;=0 THEN [Calculation_846958214591156231] ELSE -[Calculation_846958214591156231] END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_874261280838877184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Chain&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Zone&apos; THEN[Zone]&#13;&#10;WHEN &apos;Hour of Day&apos; THEN STR([order_hour])&#13;&#10;WHEN &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;, [order_date])&#13;&#10;WHEN &apos;Acquisition&apos; THEN [Acquisition]&#13;&#10;END' />
            </column>
            <column caption='Reason-DF' datatype='string' name='[Calculation_874261280877105153]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//-VE&#13;&#10;IF [Calculation_846958214591156231] &lt; 0 &#13;&#10;  THEN (    &#13;&#10;      IF [Calculation_846958214580629504]=0 THEN &apos;-VE: New Chain, Low Delivery Fee&apos;&#13;&#10;      ELSEIF [b_avg_daily_orders (copy)_846958214580871169]=0 THEN &apos;-VE: Chain Left: High Delivery Fee&apos;&#13;&#10;&#13;&#10;      //low low df&#13;&#10;      ELSEIF [Calculation_959266743371935747]&lt;=[b_eg_comm% (copy)_846958214586818562] AND [a_avg_df (copy)_959266743372091396]&lt;=[b_comm_amt (copy)_891431260639797249]&#13;&#10;        THEN (&#13;&#10;            IF ABS([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&gt;=ABS([Calculation_959266743371935747]/[a_avg_df (copy)_959266743372091396]-1) AND [b_avg_daily_orders (copy)_846958214580871169]&gt;=[Calculation_846958214580629504]&#13;&#10;                THEN &quot;-VE: Orders Increased, Low Delivery Fee&quot;&#13;&#10;            ELSEIF ABS([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&gt;=ABS([Calculation_959266743371935747]/[a_avg_df (copy)_959266743372091396]-1) AND [gfv_contrib_diff (copy)_109212300576468993]&gt;=0&#13;&#10;                THEN &quot;-VE: Orders Contribution Increased, Low Delivery Fee&quot;&#13;&#10;            ELSEIF [Calculation_959266743371935747]&lt;=[a_avg_df (copy)_959266743372091396]&#13;&#10;                THEN &quot;-VE: Avg Delivery Fee Decreased&quot;&#13;&#10;            //ELSE  &quot;ERROR -(low low)&quot;&#13;&#10;            END)&#13;&#10;&#13;&#10;       //high high df&#13;&#10;       ELSEIF [Calculation_959266743371935747]&gt;=[b_eg_comm% (copy)_846958214586818562] AND [a_avg_df (copy)_959266743372091396]&gt;=[b_comm_amt (copy)_891431260639797249]&#13;&#10;        THEN(&#13;&#10;            IF ABS([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&gt;=ABS([Calculation_959266743371935747]/[a_avg_df (copy)_959266743372091396]-1) AND [b_avg_daily_orders (copy)_846958214580871169]&lt;=[Calculation_846958214580629504]&#13;&#10;                THEN &quot;-VE: Orders Decreased, High Delivery Fee&quot;&#13;&#10;            ELSEIF ABS([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&gt;=ABS([Calculation_959266743371935747]/[a_avg_df (copy)_959266743372091396]-1) AND [gfv_contrib_diff (copy)_109212300576468993]&lt;=0&#13;&#10;                THEN &quot;-VE: Orders Contribution Decreased, High Delivery Fee&quot;&#13;&#10;            ELSEIF[Calculation_959266743371935747]&lt;=[a_avg_df (copy)_959266743372091396] &#13;&#10;                THEN &quot;-VE: Avg Delivery Fee Decreased&quot;&#13;&#10;            //ELSE &quot;ERROR -(high high)&quot; &#13;&#10;            END)&#13;&#10;&#13;&#10;        //low high df&#13;&#10;        ELSEIF [Calculation_959266743371935747]&lt;=[b_eg_comm% (copy)_846958214586818562] AND [a_avg_df (copy)_959266743372091396]&gt;[b_comm_amt (copy)_891431260639797249]&#13;&#10;          THEN &quot;-VE: Avg Delivery Fee Decreased&quot;&#13;&#10;&#13;&#10;&#13;&#10;        END&#13;&#10;    )&#13;&#10;&#13;&#10;&#13;&#10;//+VE &#13;&#10;ELSEIF  [Calculation_846958214591156231] &gt; 0&#13;&#10;  THEN (&#13;&#10;      IF [Calculation_846958214580629504]=0 THEN &apos;+VE: New Chain, High Delivery Fee&apos;&#13;&#10;      ELSEIF [b_avg_daily_orders (copy)_846958214580871169]=0 THEN &apos;+VE: Chain Left, Low Delivery Fee&apos;&#13;&#10;&#13;&#10;      //low low df&#13;&#10;      ELSEIF [Calculation_959266743371935747]&lt;=[b_eg_comm% (copy)_846958214586818562] AND [a_avg_df (copy)_959266743372091396]&lt;=[b_comm_amt (copy)_891431260639797249]&#13;&#10;        THEN (&#13;&#10;            IF ABS([b_avg_daily_orders (copy)_846958214580871169]/[Calculation_846958214580629504]-1)&gt;=ABS([Calculation_959266743371935747]/[a_avg_df (copy)_959266743372091396]-1) AND [b_avg_daily_orders (copy)_846958214580871169]&lt;=[Calculation_846958214580629504]&#