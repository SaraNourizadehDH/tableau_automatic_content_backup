          <named-connection caption='BigQuery' name='bigquery.1fa6c5u1c78mrd10v1nrp1l5ouz6'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='chandrapu.reddy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1fa6c5u1c78mrd10v1nrp1l5ouz6' name='Custom SQL Query' type='text'><![CDATA[with acquisition as
(
select   dc.chain_id,
         dc.chain_name,
         av.account_id,
         fi.country_code,
         first_order_id as order_id
        ,date_trunc(date(first_order_time),month) as month
from `tlb-data-prod.data_platform.agg_account_vendor` av
inner join `tlb-data-prod.data_platform.dim_chain` dc 
on av.chain_id = dc.chain_id 
inner join `tlb-data-prod.data_platform.fct_order_info` fi 
on fi.order_id = av.first_order_id
and fi.is_successful 
and av.is_chain_acquesition
and fi.order_date>>='2025-06-01'
where date_trunc(date(first_order_time),month) >>='2025-06-01'
group by all
)

,winbacks as
(
select
    distinct account_id,
    country_code, 
    chain_id,
    chain_name,
    DATE_TRUNC(order_date, MONTH) as month,
    order_id
FROM
    (
SELECT  account_id,
        order_id,
        order_date,
        a.chain_id,
        b.chain_name,
        a.country_code,
        COALESCE(date_diff(order_date, lag(order_date) over(partition by account_id, a.country_id, a.chain_id order by order_date), day), 0) day_d
    FROM `tlb-data-prod.data_platform.fct_order_info` a
    INNER JOIN `tlb-data-prod.data_platform.dim_chain` b
    ON a.chain_id = b.chain_id
    and a.order_date>>='2025-04-01'
    where 
        a.is_successful = True 
        and a.account_id >> 0 
    )
where
  day_d >> 30
  and DATE_TRUNC(order_date, MONTH) >>='2025-06-01'
)

,platform as
(
SELECT 
    e.country_code,
    DATE_TRUNC(e.order_date, month) as month,
    e.chain_id,
    dc.chain_name,
    dv.vertical,
    e.account_id,
    max(case when acq.order_id is not null then 1 else 0 end) as is_acq,
    max(case when wb.order_id is not null then 1 else 0 end) as is_winback,
    count(distinct e.order_id) as platform_orders,
    sum(e.gmv_amount_lc) as platform_gmv_lc,
    SUM(COALESCE(e.gmv_amount_lc, 0) - COALESCE(e.delivery_fee_amount_lc, 0) - COALESCE(e.service_fee_amount_lc, 0)) AS gfv
FROM `tlb-data-prod.data_platform.fct_order_info` e 
INNER JOIN `tlb-data-prod.data_platform.dim_chain` dc on e.chain_id = dc.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_vertical` dv on e.vertical_id = dv.vertical_id
LEFT JOIN acquisition acq 
on e.country_code = acq.country_code 
and DATE_TRUNC(e.order_date, month) = acq.month 
and dc.chain_id = acq.chain_id 
and dc.chain_name = acq.chain_name 
and e.account_id = acq.account_id 
and e.order_id = acq.order_id
LEFT JOIN winbacks wb 
on e.country_code = wb.country_code 
and DATE_TRUNC(e.order_date, month) = wb.month 
and dc.chain_id = wb.chain_id 
and dc.chain_name = wb.chain_name 
and e.account_id = wb.account_id 
and e.order_id = wb.order_id
WHERE
    e.is_successful = True
    and DATE_TRUNC(e.order_date, month) >>='2025-06-01'
GROUP BY ALL
)

,rewards_cust as
(SELECT 
    distinct
    e.country_code, 
    DATE_TRUNC(e.order_date, month) as month,
    dc.chain_id,
    dc.chain_name,
    e.account_id,
    max(case when acq.order_id is not null then 1 else 0 end) as is_acq,
    max(case when wb.order_id is not null then 1 else 0 end) as is_winback,
    count(distinct e.order_id) as rewards_orders,
    sum(e.gmv_amount_lc) as rewards_order_gmv_lc,
    SUM(case 
        when cc.discriminator = "TPRO" then (a.order_discount_lc - bd.calculatedtprocommission)
        when cc.discriminator = "LOYALTY" then (a.order_discount_lc*cc.talabat_share_percentage)/100 end) as cost_to_platform,
    SUM(case 
        when cc.discriminator = "TPRO" then bd.calculatedtprocommission
        when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end) as cost_to_partner,
    SUM(case when pro.account_id is not null then
        case
          when cc.discriminator = "TPRO" then bd.calculatedtprocommission
          when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end else 0 end) as cost_to_partner_pro_customer,
    SUM(case when pro.account_id is null then
        case
          when cc.discriminator = "TPRO" then bd.calculatedtprocommission
          when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end else 0 end) as cost_to_partner_non_pro_customer,
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
INNER join `tlb-data-prod.data_platform.dim_incentives_voucher` b 
on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc  
on cc.id = a.voucher_option_id
inner join `tlb-data-prod.data_platform_loyalty.voucher_option_categories` dd 
on b.voucher_option_category_id = dd.id 
inner join `tlb-data-prod.data_platform.fct_order_info` e 
on a.order_id = cast(e.order_id as string) and e.is_successful = True
inner join `tlb-data-prod.data_platform.dim_chain` dc on e.chain_id = dc.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z 
ON b.country_id = z.country_id
INNER JOIN `tlb-data-prod.data_platform_billing.billingdata` bd 
on e.order_id = bd.orderid
LEFT JOIN acquisition acq 
on e.country_code = acq.country_code 
and DATE_TRUNC(e.order_date, month) = acq.month 
and dc.chain_id = acq.chain_id
and dc.chain_name = acq.chain_name 
and e.account_id = acq.account_id 
and e.order_id = acq.order_id
LEFT JOIN winbacks wb 
on e.country_code = wb.country_code 
and DATE_TRUNC(e.order_date, month) = wb.month 
and dc.chain_id = wb.chain_id
and dc.chain_name = wb.chain_name 
and e.account_id = wb.account_id 
and e.order_id = wb.order_id
LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` pro 
on e.account_id = pro.account_id and e.country_code = pro.country and e.order_time between pro.start_date and pro.end_date and e.order_date = pro.iso_date and pro.subscription_state <<>> "BILLING RETRY"
WHERE
    cc.discriminator in ('LOYALTY', 'TPRO')
    and is_deleted = FALSE
    and a.is_used = True
    and DATE_TRUNC(e.order_date, month) >>='2025-06-01'
    and points_cost <<>> 0
    and cc.voucher_option_category_id not in (1466, 1765)
GROUP BY ALL)

,vendor_list as
(
  (select 
    distinct
    date_trunc(a.date, month) as month,
    a.country_code,
    a.chain_id,
    b.chain_name,
    b.account_manager_email,
    b.team_leader_email,
    "" as entry_point
  from `tlb-data-dev.data_playground.rewards_vendor_history` a
  inner join `tlb-data-prod.data_platform.dim_chain` b on a.chain_id = b.chain_id
  where date << "2024-09-01")
UNION ALL
  (SELECT *
  FROM
    (select 
      date_trunc(a.date, month) as month,
      a.country_code,
      a.chain_id,
      b.chain_name, 
      b.account_manager_email,
      b.team_leader_email,
      CONCAT(COALESCE(CASE WHEN MAX(is_basket_enabled) then "Basket" end,""),
      COALESCE(CASE WHEN MAX(is_menu_enabled) then "Menu" end,""),
      COALESCE(CASE WHEN MAX(is_catalog_enabled) then "Catalog" end,"")) as entry_point
    from `tlb-data-prod.data_platform.dim_rewards_vendor_history` a
    inner join `tlb-data-prod.data_platform.dim_chain` b on a.chain_id = b.chain_id
    where date >>= "2024-09-01"
    group by all)
  )
)

SELECT
    vl.country_code,
    vl.month as month,
   -- vl.chain_id,
    vl.chain_name,
    --vl.account_manager_email,
   -- vl.team_leader_email,
    vl.entry_point as vertical,
    COALESCE(count(distinct a.account_id),0) as chain_customers,
    COALESCE(sum(a.platform_orders),0) as chain_orders,
    COALESCE(sum(a.platform_gmv_lc),0) as chain_gmv_lc,
    COALESCE(count(distinct case when b.account_id is not null then a.account_id end),0) as rewards_customers,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.rewards_orders) end),0) as rewards_orders,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.rewards_order_gmv_lc) end),0) as rewards_order_gmv_lc,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.platform_orders) end),0) as rewards_customers_orders,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.platform_gmv_lc) end),0) as rewards_customers_gmv,
    COALESCE(count(distinct case when a.is_acq = 1 then a.account_id end),0) as chain_acq,
    COALESCE(count(distinct case when a.is_winback = 1 then a.account_id end),0) as chain_wb,
    COALESCE(count(distinct case when b.is_acq = 1 then b.account_id end),0) as rewards_chain_acq,
    COALESCE(count(distinct case when b.is_winback = 1 then b.account_id end),0) as rewards_chain_wb,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_platform) end),0) as cost_to_platform,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner) end),0) as cost_to_partner,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner_pro_customer) end),0) as cost_to_partner_pro_customer,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner_non_pro_customer) end),0) as cost_to_partner_non_pro_customer,
    COALESCE(sum(a.gfv),0) as chain_customer_spend,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.gfv,0) end),0) as rewards_customers_spend
FROM vendor_list vl
LEFT JOIN platform a on vl.country_code = a.country_code and vl.month = a.month and vl.chain_id = a.chain_id and vl.chain_name = a.chain_name
LEFT JOIN rewards_cust b on a.country_code = b.country_code and a.month = b.month 
and a.chain_id = b.chain_id 
and a.chain_name = b.chain_name 
and a.account_id = b.account_id
where vl.month>>='2025-06-01'
GROUP BY ALL

union all 
select *
from `tlb-data-dev.data_playground.rewards_vendor_performance_initial_load_chain`]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1fa6c5u1c78mrd10v1nrp1l5ouz6' name='Custom SQL Query' type='text'><![CDATA[with acquisition as
(
select   dc.chain_id,
         dc.chain_name,
         av.account_id,
         fi.country_code,
         first_order_id as order_id
        ,date_trunc(date(first_order_time),month) as month
from `tlb-data-prod.data_platform.agg_account_vendor` av
inner join `tlb-data-prod.data_platform.dim_chain` dc 
on av.chain_id = dc.chain_id 
inner join `tlb-data-prod.data_platform.fct_order_info` fi 
on fi.order_id = av.first_order_id
and fi.is_successful 
and av.is_chain_acquesition
and fi.order_date>>='2025-06-01'
where date_trunc(date(first_order_time),month) >>='2025-06-01'
group by all
)

,winbacks as
(
select
    distinct account_id,
    country_code, 
    chain_id,
    chain_name,
    DATE_TRUNC(order_date, MONTH) as month,
    order_id
FROM
    (
SELECT  account_id,
        order_id,
        order_date,
        a.chain_id,
        b.chain_name,
        a.country_code,
        COALESCE(date_diff(order_date, lag(order_date) over(partition by account_id, a.country_id, a.chain_id order by order_date), day), 0) day_d
    FROM `tlb-data-prod.data_platform.fct_order_info` a
    INNER JOIN `tlb-data-prod.data_platform.dim_chain` b
    ON a.chain_id = b.chain_id
    and a.order_date>>='2025-04-01'
    where 
        a.is_successful = True 
        and a.account_id >> 0 
    )
where
  day_d >> 30
  and DATE_TRUNC(order_date, MONTH) >>='2025-06-01'
)

,platform as
(
SELECT 
    e.country_code,
    DATE_TRUNC(e.order_date, month) as month,
    e.chain_id,
    dc.chain_name,
    dv.vertical,
    e.account_id,
    max(case when acq.order_id is not null then 1 else 0 end) as is_acq,
    max(case when wb.order_id is not null then 1 else 0 end) as is_winback,
    count(distinct e.order_id) as platform_orders,
    sum(e.gmv_amount_lc) as platform_gmv_lc,
    SUM(COALESCE(e.gmv_amount_lc, 0) - COALESCE(e.delivery_fee_amount_lc, 0) - COALESCE(e.service_fee_amount_lc, 0)) AS gfv
FROM `tlb-data-prod.data_platform.fct_order_info` e 
INNER JOIN `tlb-data-prod.data_platform.dim_chain` dc on e.chain_id = dc.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_vertical` dv on e.vertical_id = dv.vertical_id
LEFT JOIN acquisition acq 
on e.country_code = acq.country_code 
and DATE_TRUNC(e.order_date, month) = acq.month 
and dc.chain_id = acq.chain_id 
and dc.chain_name = acq.chain_name 
and e.account_id = acq.account_id 
and e.order_id = acq.order_id
LEFT JOIN winbacks wb 
on e.country_code = wb.country_code 
and DATE_TRUNC(e.order_date, month) = wb.month 
and dc.chain_id = wb.chain_id 
and dc.chain_name = wb.chain_name 
and e.account_id = wb.account_id 
and e.order_id = wb.order_id
WHERE
    e.is_successful = True
    and DATE_TRUNC(e.order_date, month) >>='2025-06-01'
GROUP BY ALL
)

,rewards_cust as
(SELECT 
    distinct
    e.country_code, 
    DATE_TRUNC(e.order_date, month) as month,
    dc.chain_id,
    dc.chain_name,
    e.account_id,
    max(case when acq.order_id is not null then 1 else 0 end) as is_acq,
    max(case when wb.order_id is not null then 1 else 0 end) as is_winback,
    count(distinct e.order_id) as rewards_orders,
    sum(e.gmv_amount_lc) as rewards_order_gmv_lc,
    SUM(case 
        when cc.discriminator = "TPRO" then (a.order_discount_lc - bd.calculatedtprocommission)
        when cc.discriminator = "LOYALTY" then (a.order_discount_lc*cc.talabat_share_percentage)/100 end) as cost_to_platform,
    SUM(case 
        when cc.discriminator = "TPRO" then bd.calculatedtprocommission
        when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end) as cost_to_partner,
    SUM(case when pro.account_id is not null then
        case
          when cc.discriminator = "TPRO" then bd.calculatedtprocommission
          when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end else 0 end) as cost_to_partner_pro_customer,
    SUM(case when pro.account_id is null then
        case
          when cc.discriminator = "TPRO" then bd.calculatedtprocommission
          when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end else 0 end) as cost_to_partner_non_pro_customer,
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
INNER join `tlb-data-prod.data_platform.dim_incentives_voucher` b 
on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc  
on cc.id = a.voucher_option_id
inner join `tlb-data-prod.data_platform_loyalty.voucher_option_categories` dd 
on b.voucher_option_category_id = dd.id 
inner join `tlb-data-prod.data_platform.fct_order_info` e 
on a.order_id = cast(e.order_id as string) and e.is_successful = True
inner join `tlb-data-prod.data_platform.dim_chain` dc on e.chain_id = dc.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS z 
ON b.country_id = z.country_id
INNER JOIN `tlb-data-prod.data_platform_billing.billingdata` bd 
on e.order_id = bd.orderid
LEFT JOIN acquisition acq 
on e.country_code = acq.country_code 
and DATE_TRUNC(e.order_date, month) = acq.month 
and dc.chain_id = acq.chain_id
and dc.chain_name = acq.chain_name 
and e.account_id = acq.account_id 
and e.order_id = acq.order_id
LEFT JOIN winbacks wb 
on e.country_code = wb.country_code 
and DATE_TRUNC(e.order_date, month) = wb.month 
and dc.chain_id = wb.chain_id
and dc.chain_name = wb.chain_name 
and e.account_id = wb.account_id 
and e.order_id = wb.order_id
LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` pro 
on e.account_id = pro.account_id and e.country_code = pro.country and e.order_time between pro.start_date and pro.end_date and e.order_date = pro.iso_date and pro.subscription_state <<>> "BILLING RETRY"
WHERE
    cc.discriminator in ('LOYALTY', 'TPRO')
    and is_deleted = FALSE
    and a.is_used = True
    and DATE_TRUNC(e.order_date, month) >>='2025-06-01'
    and points_cost <<>> 0
    and cc.voucher_option_category_id not in (1466, 1765)
GROUP BY ALL)

,vendor_list as
(
  (select 
    distinct
    date_trunc(a.date, month) as month,
    a.country_code,
    a.chain_id,
    b.chain_name,
    b.account_manager_email,
    b.team_leader_email,
    "" as entry_point
  from `tlb-data-dev.data_playground.rewards_vendor_history` a
  inner join `tlb-data-prod.data_platform.dim_chain` b on a.chain_id = b.chain_id
  where date << "2024-09-01")
UNION ALL
  (SELECT *
  FROM
    (select 
      date_trunc(a.date, month) as month,
      a.country_code,
      a.chain_id,
      b.chain_name, 
      b.account_manager_email,
      b.team_leader_email,
      CONCAT(COALESCE(CASE WHEN MAX(is_basket_enabled) then "Basket" end,""),
      COALESCE(CASE WHEN MAX(is_menu_enabled) then "Menu" end,""),
      COALESCE(CASE WHEN MAX(is_catalog_enabled) then "Catalog" end,"")) as entry_point
    from `tlb-data-prod.data_platform.dim_rewards_vendor_history` a
    inner join `tlb-data-prod.data_platform.dim_chain` b on a.chain_id = b.chain_id
    where date >>= "2024-09-01"
    group by all)
  )
)

SELECT
    vl.country_code,
    vl.month as month,
   -- vl.chain_id,
    vl.chain_name,
    --vl.account_manager_email,
   -- vl.team_leader_email,
    vl.entry_point as vertical,
    COALESCE(count(distinct a.account_id),0) as chain_customers,
    COALESCE(sum(a.platform_orders),0) as chain_orders,
    COALESCE(sum(a.platform_gmv_lc),0) as chain_gmv_lc,
    COALESCE(count(distinct case when b.account_id is not null then a.account_id end),0) as rewards_customers,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.rewards_orders) end),0) as rewards_orders,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.rewards_order_gmv_lc) end),0) as rewards_order_gmv_lc,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.platform_orders) end),0) as rewards_customers_orders,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.platform_gmv_lc) end),0) as rewards_customers_gmv,
    COALESCE(count(distinct case when a.is_acq = 1 then a.account_id end),0) as chain_acq,
    COALESCE(count(distinct case when a.is_winback = 1 then a.account_id end),0) as chain_wb,
    COALESCE(count(distinct case when b.is_acq = 1 then b.account_id end),0) as rewards_chain_acq,
    COALESCE(count(distinct case when b.is_winback = 1 then b.account_id end),0) as rewards_chain_wb,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_platform) end),0) as cost_to_platform,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner) end),0) as cost_to_partner,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner_pro_customer) end),0) as cost_to_partner_pro_customer,
    COALESCE(sum(case when b.account_id is not null then COALESCE(b.cost_to_partner_non_pro_customer) end),0) as cost_to_partner_non_pro_customer,
    COALESCE(sum(a.gfv),0) as chain_customer_spend,
    COALESCE(sum(case when b.account_id is not null then COALESCE(a.gfv,0) end),0) as rewards_customers_spend
FROM vendor_list vl
LEFT JOIN platform a on vl.country_code = a.country_code and vl.month = a.month and vl.chain_id = a.chain_id and vl.chain_name = a.chain_name
LEFT JOIN rewards_cust b on a.country_code = b.country_code and a.month = b.month 
and a.chain_id = b.chain_id 
and a.chain_name = b.chain_name 
and a.account_id = b.account_id
where vl.month>>='2025-06-01'
GROUP BY ALL

union all 
select *
from `tlb-data-dev.data_playground.rewards_vendor_performance_initial_load_chain`]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
