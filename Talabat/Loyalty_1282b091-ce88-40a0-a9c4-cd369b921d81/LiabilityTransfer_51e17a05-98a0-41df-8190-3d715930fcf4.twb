        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gf4zp11321f0i18ggnmz0aa46ot' name='Custom SQL Query' type='text'><![CDATA[with opening_points as
(select account_id, opening_month, 
  sum(case when transaction_country_id = 1 then opening_balance else 0 end) as kw_opening,
  sum(case when transaction_country_id = 2 then opening_balance else 0 end) as ksa_opening,
  sum(case when transaction_country_id = 3 then opening_balance else 0 end) as bah_opening,
  sum(case when transaction_country_id = 4 then opening_balance else 0 end) as uae_opening,
  sum(case when transaction_country_id = 5 then opening_balance else 0 end) as oman_opening,
  sum(case when transaction_country_id = 6 then opening_balance else 0 end) as qa_opening,
  sum(case when transaction_country_id = 7 then opening_balance else 0 end) as leb_opening,
  sum(case when transaction_country_id = 8 then opening_balance else 0 end) as jor_opening,
  sum(case when transaction_country_id = 9 then opening_balance else 0 end) as egy_opening,
  sum(case when transaction_country_id = 10 then opening_balance else 0 end) as iraq_opening
from
(select  account_id, date_sub(date_trunc(current_date, month), interval 1 month) as opening_month, transaction_country_id, 
sum(loyalty_points_delta) opening_balance
from `tlb-data-prod.data_platform.fct_loyalty_transaction`
where DATE(date_trunc(transaction_date_time_utc, month)) << date_sub(date_trunc(current_date, month), interval 1 month)
group by 1,2,3
order by 1, 2)
group by 1,2
order by 1),

earned as
(select account_id, earn_month,  
  sum(case when transaction_country_id = 1 then earned_points else 0 end) as kw_earn,
  sum(case when transaction_country_id = 2 then earned_points else 0 end) as ksa_earn,
  sum(case when transaction_country_id = 3 then earned_points else 0 end) as bah_earn,
  sum(case when transaction_country_id = 4 then earned_points else 0 end) as uae_earn,
  sum(case when transaction_country_id = 5 then earned_points else 0 end) as oman_earn,
  sum(case when transaction_country_id = 6 then earned_points else 0 end) as qa_earn,
  sum(case when transaction_country_id = 7 then earned_points else 0 end) as leb_earn,
  sum(case when transaction_country_id = 8 then earned_points else 0 end) as jor_earn,
  sum(case when transaction_country_id = 9 then earned_points else 0 end) as egy_earn,
  sum(case when transaction_country_id = 10 then earned_points else 0 end) as iraq_earn
from
(select account_id, date_sub(date_trunc(current_date, month), interval 1 month) as earn_month, transaction_country_id, sum(loyalty_points_delta) as earned_points
from `tlb-data-prod.data_platform.fct_loyalty_transaction` a
inner join `tlb-data-prod.data_platform.dim_loyalty_transaction_type` b
on a.transaction_type_id = b.transaction_type_id
where DATE(date_trunc(transaction_date_time_utc, month)) = date_sub(date_trunc(current_date, month), interval 1 month)
and b.transaction_type_name in ('earn','earn_cancellation','earn_compensation','Earn pro', 'welcome_gift', 'Welcome gift correction')
and account_id >> 0
group by 1,2,3
order by 1)
group by 1,2
order by 1),

expired as
(select account_id, expiry_month, 
  sum(case when transaction_country_id = 1 then expired_points else 0 end) as kw_exp,
  sum(case when transaction_country_id = 2 then expired_points else 0 end) as ksa_exp,
  sum(case when transaction_country_id = 3 then expired_points else 0 end) as bah_exp,
  sum(case when transaction_country_id = 4 then expired_points else 0 end) as uae_exp,
  sum(case when transaction_country_id = 5 then expired_points else 0 end) as oman_exp,
  sum(case when transaction_country_id = 6 then expired_points else 0 end) as qa_exp,
  sum(case when transaction_country_id = 7 then expired_points else 0 end) as leb_exp,
  sum(case when transaction_country_id = 8 then expired_points else 0 end) as jor_exp,
  sum(case when transaction_country_id = 9 then expired_points else 0 end) as egy_exp,
  sum(case when transaction_country_id = 10 then expired_points else 0 end) as iraq_exp
from
(select account_id, date_sub(date_trunc(current_date, month), interval 1 month) as expiry_month, transaction_country_id, sum(loyalty_points_delta) as expired_points
from `tlb-data-prod.data_platform.fct_loyalty_transaction` a
inner join `tlb-data-prod.data_platform.dim_loyalty_transaction_type` b
on a.transaction_type_id = b.transaction_type_id
where DATE(date_trunc(transaction_date_time_utc, month)) = date_sub(date_trunc(current_date, month), interval 1 month)
and b.transaction_type_name in ('Points Expired')
and account_id >> 0
group by 1,2,3
order by 1)
group by 1,2
order by 1),

burned as
(select account_id, burn_month, 
  sum(case when transaction_country_id = 1 then burn_points else 0 end) as kw_burn,
  sum(case when transaction_country_id = 2 then burn_points else 0 end) as ksa_burn,
  sum(case when transaction_country_id = 3 then burn_points else 0 end) as bah_burn,
  sum(case when transaction_country_id = 4 then burn_points else 0 end) as uae_burn,
  sum(case when transaction_country_id = 5 then burn_points else 0 end) as oman_burn,
  sum(case when transaction_country_id = 6 then burn_points else 0 end) as qa_burn,
  sum(case when transaction_country_id = 7 then burn_points else 0 end) as leb_burn,
  sum(case when transaction_country_id = 8 then burn_points else 0 end) as jor_burn,
  sum(case when transaction_country_id = 9 then burn_points else 0 end) as egy_burn,
  sum(case when transaction_country_id = 10 then burn_points else 0 end) as iraq_burn
from
(select account_id, date_sub(date_trunc(current_date, month), interval 1 month) as burn_month, transaction_country_id, sum(loyalty_points_delta) as burn_points
from `tlb-data-prod.data_platform.fct_loyalty_transaction` a
inner join `tlb-data-prod.data_platform.dim_loyalty_transaction_type` b
on a.transaction_type_id = b.transaction_type_id
where DATE(date_trunc(transaction_date_time_utc, month)) = date_sub(date_trunc(current_date, month), interval 1 month)
and b.transaction_type_name in ('burn','Burn on Partners','charity', 'Burn on raffles')
and account_id >> 0
group by 1,2,3
order by 1)
group by 1,2
order by 1),

closing_points as 
(select op.account_id, opening_month as month, op.* except(account_id, opening_month), e.* except(account_id, earn_month), ex.* except(account_id, expiry_month), b.* except(account_id, burn_month),
  coalesce(kw_opening,0) + coalesce(kw_earn,0) + coalesce(kw_exp,0) + coalesce(kw_burn,0) as kw_closing,
  coalesce(ksa_opening,0) + coalesce(ksa_earn,0) + coalesce(ksa_exp,0) + coalesce(ksa_burn,0) as ksa_closing,
  coalesce(bah_opening,0) + coalesce(bah_earn,0) + coalesce(bah_exp,0) + coalesce(bah_burn,0) as bah_closing,
  coalesce(uae_opening,0) + coalesce(uae_earn,0) + coalesce(uae_exp,0) + coalesce(uae_burn,0) as uae_closing,
  coalesce(oman_opening,0) + coalesce(oman_earn,0) + coalesce(oman_exp,0) + coalesce(oman_burn,0) as oman_closing,
  coalesce(qa_opening,0) + coalesce(qa_earn,0) + coalesce(qa_exp,0) + coalesce(qa_burn,0) as qa_closing,
  coalesce(leb_opening,0) + coalesce(leb_earn,0) + coalesce(leb_exp,0) + coalesce(leb_burn,0) as leb_closing,
  coalesce(jor_opening,0) + coalesce(jor_earn,0) + coalesce(jor_exp,0) + coalesce(jor_burn,0) as jor_closing,
  coalesce(egy_opening,0) + coalesce(egy_earn,0) + coalesce(egy_exp,0) + coalesce(egy_burn,0) as egy_closing,
  coalesce(iraq_opening,0) + coalesce(iraq_earn,0) + coalesce(iraq_exp,0) + coalesce(iraq_burn,0) as iraq_closing
from opening_points op
left join earned e on op.account_id = e.account_id
left join expired ex on op.account_id = ex.account_id
left join burned b on op.account_id = b.account_id
order by 1)

select *
from closing_points
order by 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
