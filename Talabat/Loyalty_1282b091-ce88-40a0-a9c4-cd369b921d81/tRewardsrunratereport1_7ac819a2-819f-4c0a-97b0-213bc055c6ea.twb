    <worksheet name='Change in liability lc'>
      <table>
        <view>
          <datasources>
            <datasource caption='Main Data Query' name='federated.0eh70xy0yphz8215ryntf1be3so9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eh70xy0yphz8215ryntf1be3so9'>
            <column caption='B/E Ratio 2m' datatype='real' default-format='p0.00%' name='[B/E Ratio (copy)_3836292881210892304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[burned_points_2m]/[earned_points_2m]' />
            </column>
            <column caption='Current month' datatype='datetime' name='[Calculation_3836292881195249665]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,TODAY())' />
            </column>
            <column caption='Number of Days Till Date' datatype='integer' name='[Calculation_3836292881199063045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(TODAY()) - 1' />
            </column>
            <column caption='Number of days in the month' datatype='integer' name='[Calculation_3836292881199169542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [opening_month]))))' />
            </column>
            <column caption='Outstanding balance (pts)' datatype='integer' default-format='N' name='[Calculation_3836292881210515469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[opening_balance] + [earned_points] + [burned_points] + [expired_points]' />
            </column>
            <column caption='Expected earned points' datatype='real' name='[Calculation_3836292881215324177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[earned_points]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected outstanding balance (pts)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3836292881215721492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[opening_balance] + [Calculation_3836292881215324177] + [Expected earned points (copy)_3836292881215508498] + [Expected earned points (copy)_3836292881215631379]' />
            </column>
            <column caption='Current month true' datatype='boolean' name='[Calculation_3836292881215914005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3836292881195249665] = [opening_month] then TRUE else FALSE END' />
            </column>
            <column caption='Outstanding balance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3836292881222234138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3836292881210515469]*[B/E Ratio (copy)_3836292881210892304]*[Points Cost (LC) (copy)_1011269285543010305]*(-1)' />
            </column>
            <column caption='Change in Liability (Expected vs LM)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4468204204249346053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Outstanding balance (LC) (copy)_3836292881222733852]) - [Calculation_5060779399284101125]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LM Outstanding LC' datatype='real' name='[Calculation_5060779399284101125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([Calculation_3836292881222234138]),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Expected burned points' datatype='real' name='[Expected earned points (copy)_3836292881215508498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[burned_points]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected expired points' datatype='real' name='[Expected earned points (copy)_3836292881215631379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[expired_points]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected Outstanding balance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Outstanding balance (LC) (copy)_3836292881222733852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3836292881215721492]*[B/E Ratio (copy)_3836292881210892304]*[Points Cost (LC) (copy)_1011269285543010305]*(-1)' />
            </column>
            <column caption='Points Cost (LC) (copy)' datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Points Cost (LC) (copy)_1011269285543010305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;LC&quot; THEN [Points Cost (LC)]&#10;ELSE [Points Cost (LC)]*[exchange_rate] END' />
            </column>
            <column datatype='real' default-format='n#,##0.00000000;-#,##0.00000000' name='[Points Cost (LC)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[burned_points]' role='measure' type='quantitative' />
            <column datatype='integer' name='[burned_points_2m]' role='measure' type='quantitative' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[earned_points]' role='measure' type='quantitative' />
