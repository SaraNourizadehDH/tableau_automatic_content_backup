    <worksheet name='BE vs RR (total)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Main Data Query' name='federated.0eh70xy0yphz8215ryntf1be3so9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eh70xy0yphz8215ryntf1be3so9'>
            <column caption='Current month' datatype='datetime' name='[Calculation_3836292881195249665]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,TODAY())' />
            </column>
            <column caption='Number of Days Till Date' datatype='integer' name='[Calculation_3836292881199063045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(TODAY()) - 1' />
            </column>
            <column caption='Number of days in the month' datatype='integer' name='[Calculation_3836292881199169542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [opening_month]))))' />
            </column>
            <column caption='Current month true' datatype='boolean' name='[Calculation_3836292881215914005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3836292881195249665] = [opening_month] then TRUE else FALSE END' />
            </column>
            <column caption='TBFunded Actual' datatype='integer' name='[Calculation_4587971806848323584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cb_usage] + [charity_usage]' />
            </column>
            <column caption='raffle cost actual' datatype='integer' name='[Calculation_4587971806849015809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(0)' />
            </column>
            <column caption='TBFunded cost Actual' datatype='real' name='[Calculation_4587971806849982466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;LC&quot; THEN [cb_usage_cost_platform] + [charity_usage]*0.00&#10;ELSE ([cb_usage_cost_platform] + [charity_usage]*0.00)*[exchange_rate] END' />
            </column>
            <column caption='Expected vendor usage' datatype='real' name='[Calculation_4587971806850392067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vendor_used_vouchers]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='be vs rr vendor cost' datatype='real' name='[Calculation_6024549719619108864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Vendor - Cost (copy)_5240571540693528597]) - SUM([Expected vendor usage (copy)_4587971806851117064])' />
            </column>
            <column caption='be vs rr total usage' datatype='real' name='[Calculation_6024549719621070860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[be vs rr vendor cost (copy)_6024549719620030470] + [be vs rr tmart cost (copy)_6024549719620042759] + &#10;[be vs rr edr cost (copy)_6024549719620079626] + [be vs rr tbfunded cost (copy)_6024549719620173835] + &#10;[be vs rr lifestyle cost (copy)_6024549719620067337] + [be vs rr raffle cost (copy)_6024549719620055048]' />
            </column>
            <column caption='EDR - Cost (copy)' datatype='real' datatype-customized='true' name='[EDR - Cost (copy)_5240571540693569562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;LC&quot; THEN [EDR - Cost] &#10;ELSE [EDR - Cost]*[exchange_rate] END' />
            </column>
            <column datatype='real' datatype-customized='true' name='[EDR - Cost]' role='measure' type='quantitative' />
            <column datatype='real' datatype-customized='true' name='[EDR - Count]' role='measure' type='quantitative' />
            <column caption='Expected edr usage cost' datatype='real' name='[Expected edr usage (copy)_4587971806851391499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[edr_usage_cost_platform (copy)_5240571540689018892]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected lifestyle usage' datatype='real' name='[Expected raffle usage (copy)_4587971806867755044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[lifestyle_usage]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected raffle usage' datatype='real' name='[Expected tbfunded usage (copy)_4587971806850748423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[raffle_usage]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
            </column>
            <column caption='Expected tbfunded usage cost' datatype='real' name='[Expected tbfunded usage (copy)_4587971806851301386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4587971806849982466]*([Calculation_3836292881199169542]/[Calculation_3836292881199063045])' />
