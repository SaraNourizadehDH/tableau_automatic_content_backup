                  <column datatype='real' name='Points Cost (LC)' ordinal='2' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Points Cost_B4933DF84F5D43E6A1EEC29A97B9CA9E' table='[Extract].[Points Cost_B4933DF84F5D43E6A1EEC29A97B9CA9E]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_F706E5517D594C278DBE1367298B1795'>
            <properties context=''>
              <relation connection='bigquery.1q22v5h09893k614rhuhy0ngoqlr' name='Custom SQL Query' type='text'><![CDATA[WITH
  dates AS (
  SELECT
    DISTINCT DATE(month_start_date) opening_month
    ,country_code
    ,country_id
    ,timezone
  FROM
    `tlb-data-prod.data_platform.dim_date` dd
    inner join `tlb-data-prod.data_platform.dim_country_info` dc
    on 1=1
  and 
    DATE(month_start_date) BETWEEN DATE_SUB(DATE_TRUNC(current_date, month), INTERVAL 1 month) AND current_date
    and country_code not in ('SA','LB')
    group by all
    ),opening_points as 
    (
select d.opening_month,
       d.country_code,
       --for outstanding balance
       sum(case when date(transaction_date_time_utc,timezone)<<d.opening_month then fl.loyalty_points_delta end) as opening_balance
       ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) = d.opening_month and fl.transaction_type_id in (300,301,100,102,101,400) then fl.loyalty_points_delta end),0) as earned_points
       ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) = d.opening_month and fl.transaction_type_id in (200,201,220,230) then fl.loyalty_points_delta end),0) as burned_points
       ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) = d.opening_month and fl.transaction_type_id in (900) then fl.loyalty_points_delta end),0) as expired_points
       ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) between DATE_SUB(d.opening_month, INTERVAL 2 month) and DATE_SUB(d.opening_month, INTERVAL 1 month) and fl.transaction_type_id in (300,301,100,102,101,400) then fl.loyalty_points_delta end),0) as earned_points_2m
       ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) between DATE_SUB(d.opening_month, INTERVAL 2 month) and DATE_SUB(d.opening_month, INTERVAL 1 month) and fl.transaction_type_id in (200,201,220,230) then fl.loyalty_points_delta end),0) as burned_points_2m
      --  ,coalesce(sum(case when date_trunc(date(transaction_date_time_utc,timezone),month) between DATE_SUB(d.opening_month, INTERVAL 2 month) and DATE_SUB(d.opening_month, INTERVAL 1 month) and fl.transaction_type_id in (900) then fl.loyalty_points_delta end),0) as expired_points_2m
      -- For Usage and Cost for Charity
      ,count(distinct case when date_trunc(date(fl.transaction_date_time_utc,timezone),month) = d.opening_month and transaction_type_id in (201) then transaction_id end) as charity_usage
      ,count(distinct case when date_trunc(date(fl.transaction_date_time_utc,timezone),month) = d.opening_month and transaction_type_id in (230) then transaction_id end) as raffle_usage
      ,count(distinct case when date_trunc(date(fl.transaction_date_time_utc,timezone),month) = d.opening_month then COALESCE(case when fl.transaction_type_id = 200 then fl.wallet_credit_amount_lc when fl.transaction_type_id = 201 then CASE WHEN CAST(REGEXP_EXTRACT(fl.loyalty_channel, r'\d+') as FLOAT64) = 0.0 then CAST(REGEXP_EXTRACT(fl.loyalty_channel, r'\d+(\.\d+)?') as FLOAT64) ELSE CAST(REGEXP_EXTRACT(fl.loyalty_channel, r'\d+') as FLOAT64) END end, 0) end) as cb_usage_cost_platform
from dates d
inner join `tlb-data-prod.data_platform.fct_loyalty_transaction` fl
on d.country_id  = fl.transaction_country_id
and date(transaction_date_time_utc,timezone) <<= d.opening_month  
group by all
    )

,used_vouchers AS
(SELECT 
  DATE_TRUNC(current_date, month) as dated,
  country_code,
  COUNT( DISTINCT CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then order_id end) as vendor_used_vouchers,
  COUNT( DISTINCT CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("tmart") then order_id end) as tmart_used_vouchers,
  COUNT( DISTINCT CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("edr") then order_id end) as edr_used_vouchers,
  COUNT( DISTINCT CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("tbfunded") then order_id end) as cb_usage,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then cost_to_platform end) as vendor_usage_cost_platform,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("tmart") then cost_to_platform end) as tmart_usage_cost_platform,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("edr") then cost_to_platform end) as edr_usage_cost_platform,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("tbfunded") then cost_to_platform end) as cb_usage_cost_platform,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("tmart") then cost_to_vendor end) as tmart_usage_cost_vendor,
  SUM( CASE when DATE_TRUNC(order_date, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH) AND usage_category in ("edr") then cost_to_vendor end) as edr_usage_cost_vendor,
  -- NEW METHODOLOGY
  -- TMART
  -- Usage
    count(distinct case when order_date between date_sub(date_trunc(current_date, month), interval 1 month) and date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) - 1 day) AND usage_category in ("tmart") then order_id end) as tmart_usage_prev_month_x_days,
    count(distinct case when order_date between date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) day) and date_sub(date_trunc(current_date, month), interval 1 day) AND usage_category in ("tmart") then order_id end) as tmart_usage_prev_month_remaining,
    -- Usage Cost to Platform
    SUM(case when order_date between date_sub(date_trunc(current_date, month), interval 1 month) and date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) - 1 day) AND usage_category in ("tmart") then cost_to_platform end) as tmart_usage_cost_plat_prev_month_x_days,
    SUM(case when order_date between date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) day) and date_sub(date_trunc(current_date, month), interval 1 day) AND usage_category in ("tmart") then cost_to_platform end) as tmart_usage_cost_plat_prev_month_remaining,
    -- Usage Cost to Vendor
    SUM(case when order_date between date_sub(date_trunc(current_date, month), interval 1 month) and date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) - 1 day) AND usage_category in ("tmart") then cost_to_vendor end) as tmart_usage_cost_vendor_prev_month_x_days,
    SUM(case when order_date between date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) day) and date_sub(date_trunc(current_date, month), interval 1 day) AND usage_category in ("tmart") then cost_to_vendor end) as tmart_usage_cost_vendor_prev_month_remaining,

    -- CARC AND Revenue reduction
    -- CARC
    SUM(case when date_trunc(order_date, month) = date_sub(date_trunc(current_date, month), interval 1 month) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then CARC end) as CARC_prev_complete_month,
    SUM(case when order_date between date_sub(date_trunc(current_date, month), interval 1 month) and date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) - 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then CARC end) as CARC_prev_month_x_days,
    SUM(case when order_date between date_trunc(current_date, month) and date_sub(current_date, interval 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then CARC end) as CARC_current_month_x_days,
    SUM(case when order_date between date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) day) and date_sub(date_trunc(current_date, month), interval 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then CARC end) as CARC_prev_month_remaining,
    -- Revenue Reduction
    SUM(case when date_trunc(order_date, month) = date_sub(date_trunc(current_date, month), interval 1 month) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then RR end) as RR_prev_complete_month,
    SUM(case when order_date between date_sub(date_trunc(current_date, month), interval 1 month) and date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) - 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then RR end) as RR_prev_month_x_days,
    SUM(case when order_date between date_trunc(current_date, month) and date_sub(current_date, interval 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then RR end) as RR_current_month_x_days,
    SUM(case when order_date between date_add(date_sub(date_trunc(current_date, month), interval 1 month), interval date_diff(current_date, date_trunc(current_date, month), day) day) and date_sub(date_trunc(current_date, month), interval 1 day) AND usage_category in ("vendor", "pro_user_fd", "non_pro_user_fd") then RR end) as RR_prev_month_remaining

FROM
(  
  SELECT
    e.order_date,
    e.country_code,
    e.order_id,
    CASE
    WHEN
      LOWER(a.voucher_name) like "%all%access%" then 'tbfunded'
    WHEN
      LOWER(a.voucher_name) LIKE '%talabat mart%'
      OR LOWER(a.voucher_name) LIKE '%tmart%'
      THEN 'tmart'
    WHEN
      LOWER(a.voucher_name) LIKE '%everyday roastery%'
      OR LOWER(a.voucher_name) LIKE '%edr%'
      THEN 'edr'
    WHEN
      (
        LOWER(a.voucher_name) NOT LIKE '%talabat mart%'
        OR LOWER(a.voucher_name) NOT LIKE '%everyday roastery%'
        OR LOWER(a.voucher_name) NOT LIKE '%all%access%'
        OR LOWER(COALESCE(a.campaign_reference_id, 'abc')) NOT LIKE '%free del%'
        OR COALESCE(a.campaign_reference_id, 'abc') NOT LIKE '%FD%'
      )
      AND cc.discount_type = 'FLAT'
      THEN 'vendor'
    WHEN
      (
        LOWER(a.voucher_name) NOT LIKE '%talabat mart%'
        OR LOWER(a.voucher_name) NOT LIKE '%tmart%'
        OR LOWER(a.voucher_name) NOT LIKE '%all%access%'
        OR LOWER(a.voucher_name) NOT LIKE '%everyday roastery%'
        OR LOWER(a.voucher_name) NOT LIKE '%edr%'
        AND cc.discount_type <<>> 'FLAT'
      )
      AND cc.discount_type LIKE '%PERCENTAGE%'
      AND dd.subscription_restriction = 3
      THEN 'pro_user_fd'
    WHEN
      (
        LOWER(a.voucher_name) NOT LIKE '%talabat mart%'
        OR LOWER(a.voucher_name) NOT LIKE '%tmart%'
        OR LOWER(a.voucher_name) NOT LIKE '%everyday roastery%'
        OR LOWER(a.voucher_name) NOT LIKE '%edr%'
        AND cc.discount_type <<>> 'FLAT'
      )
      AND cc.discount_type LIKE '%PERCENTAGE%'
      AND dd.subscription_restriction <<>> 3
      THEN 'non_pro_user_fd'
  END AS usage_category,
    COALESCE(case 
      when cc.discriminator = "TPRO" then (a.order_discount_lc - bd.calculatedtprocommission)
      when cc.discriminator = "LOYALTY" then (a.order_discount_lc*cc.talabat_share_percentage)/100 end, 0) as cost_to_platform,
    COALESCE(case 
      when cc.discriminator = "TPRO" then bd.calculatedtprocommission
      when cc.discriminator = "LOYALTY" then (a.order_discount_lc*(100-cc.talabat_share_percentage))/100 end, 0) as cost_to_vendor,
    -- CARC and RR
    COALESCE(CASE WHEN discriminator = "LOYALTY" THEN (a.order_discount_lc*cc.talabat_share_percentage)/100 END, 0) as CARC,
    COALESCE(CASE WHEN discriminator = "TPRO" THEN (a.order_discount_lc - bd.calculatedtprocommission) END, 0) as RR,
  FROM `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
  INNER JOIN `tlb-data-prod.data_platform.dim_incentives_voucher` b ON a.voucher_id = b.voucher_id
  INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc ON a.voucher_option_id = cc.id
  INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_option_categories` dd ON b.voucher_option_category_id = dd.id
  INNER JOIN `tlb-data-prod.data_platform.fct_order_info` e ON a.order_id = CAST(e.order_id AS STRING) AND e.is_successful = TRUE
  INNER JOIN `tlb-data-prod.data_platform_billing.billingdata` bd ON e.order_id = bd.orderid
  WHERE
    cc.discriminator IN ('LOYALTY', 'TPRO')
    AND is_deleted = FALSE
    AND a.is_used = TRUE 
    AND e.is_successful = TRUE
    AND points_cost <<>> 0
    AND cc.voucher_option_category_id NOT IN (1466, 1765)
    AND DATE_TRUNC(e.order_date, month) >>= DATE_SUB(DATE_TRUNC(current_date, month), INTERVAL 1 MONTH))
GROUP BY ALL)

,lifestyle_usage as
(SELECT
  DATE_TRUNC(current_date, month) as dated,
  c.country_code,
  count(distinct account_id) as lifestyle_usage
FROM `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
INNER JOIN `tlb-data-prod.data_platform.dim_incentives_voucher` b ON a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc ON a.voucher_option_id = cc.id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_option_categories` dd ON b.voucher_option_category_id = dd.id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` c on b.country_id = c.country_id
WHERE
  cc.discriminator IN ('NFP')
  AND is_deleted = FALSE
  AND points_cost <<>> 0
  AND cc.voucher_option_category_id NOT IN (1466, 1765)
  AND DATE_TRUNC(DATE(a.created_on_time_utc, c.timezone), MONTH) = DATE_TRUNC(current_date, month)
GROUP BY ALL)


SELECT
  a.* EXCEPT (cb_usage_cost_platform),
  COALESCE(b.cb_usage,0) as cb_usage,
  COALESCE(a.cb_usage_cost_platform,0) + COALESCE(b.cb_usage_cost_platform,0) as cb_usage_cost_platform,
  ROUND(1/c.exchange_rate_value,8) as exchange_rate,
  COALESCE(b.vendor_used_vouchers,0) as vendor_used_vouchers,
  COALESCE(b.tmart_used_vouchers,0) as tmart_used_vouchers,
  COALESCE(b.edr_used_vouchers,0) as edr_used_vouchers,
  COALESCE(b.vendor_usage_cost_platform,0) as vendor_usage_cost_platform,
  COALESCE(b.tmart_usage_cost_platform,0) as tmart_usage_cost_platform,
  COALESCE(b.edr_usage_cost_platform,0) as edr_usage_cost_platform,
  COALESCE(d.lifestyle_usage,0) as lifestyle_usage,
  COALESCE(b.tmart_usage_cost_vendor,0) as tmart_usage_cost_partner,
  COALESCE(b.edr_usage_cost_vendor,0) as edr_usage_cost_partner,

  COALESCE(COALESCE(tmart_used_vouchers,0) + COALESCE(CEILING(SAFE_DIVIDE(tmart_used_vouchers,tmart_usage_prev_month_x_days)*tmart_usage_prev_month_remaining),0),0) as tmart_usage_expected,
  COALESCE(COALESCE(tmart_usage_cost_platform,0) + COALESCE(CEILING(SAFE_DIVIDE(tmart_usage_cost_platform,tmart_usage_cost_plat_prev_month_x_days)*tmart_usage_cost_plat_prev_month_remaining),0),0) as tmart_cost_to_platform_expected,
  COALESCE(COALESCE(tmart_usage_cost_vendor,0) + COALESCE(CEILING(SAFE_DIVIDE(tmart_usage_cost_vendor,tmart_usage_cost_vendor_prev_month_x_days)*tmart_usage_cost_vendor_prev_month_remaining),0),0) as tmart_cost_to_vendor_expected,

  COALESCE(CARC_prev_complete_month, 0) as CARC_prev_complete_month,
  COALESCE(CARC_current_month_x_days, 0) as CARC_run_rate,
  COALESCE(RR_prev_complete_month, 0) as RR_prev_complete_month,
  COALESCE(RR_current_month_x_days, 0) as RR_run_rate,
  COALESCE(COALESCE(CARC_current_month_x_days,0) + COALESCE(CEILING(SAFE_DIVIDE(CARC_current_month_x_days,CARC_prev_month_x_days)*CARC_prev_month_remaining),0),0) as CARC_expected,
  COALESCE(COALESCE(RR_current_month_x_days,0) + COALESCE(CEILING(SAFE_DIVIDE(RR_current_month_x_days,RR_prev_month_x_days)*RR_prev_month_remaining),0),0) as RR_expected
FROM opening_points a
INNER JOIN `tlb-data-prod.data_platform.dim_exchange_rate` c on a.opening_month = c.exchange_rate_date and a.country_code = c.country_code and c.exchange_rate_base = "EUR"
LEFT JOIN used_vouchers b on a.opening_month = b.dated and a.country_code = b.country_code
LEFT JOIN lifestyle_usage d on a.opening_month = d.dated and a.country_code = d.country_code]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_F706E5517D594C278DBE1367298B1795' table='[Extract].[_F706E5517D594C278DBE1367298B1795]' type='table' />
