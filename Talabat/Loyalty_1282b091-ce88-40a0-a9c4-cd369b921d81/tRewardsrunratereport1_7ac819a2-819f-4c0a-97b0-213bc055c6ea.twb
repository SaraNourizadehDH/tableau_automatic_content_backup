            <column-instance column='[opening_month]' derivation='Month-Trunc' name='[tmn:opening_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4468204204249346053]' derivation='User' name='[usr:Calculation_4468204204249346053:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
