            <column datatype='real' name='[exchange_rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[expired_points]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3836292881215914005]' derivation='None' name='[none:Calculation_3836292881215914005:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
