          <named-connection caption='BigQuery' name='bigquery.1q22v5h09893k614rhuhy0ngoqlr'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='chandrapu.reddy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='tRewards RUN RATE report - Ali&apos;s input' name='cloudfile:googledrive-excel-direct.19nmonz0dmh0fq1fww3q80ildh4j'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1LAYRfE-PBDwnkhOAUOgdzGaj4bq2XrSjwq4KEzydKLU' cloudFileMetadata_-_folder='root' cloudFileName='tRewards RUN RATE report - Ali&apos;s input.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1LAYRfE-PBDwnkhOAUOgdzGaj4bq2XrSjwq4KEzydKLU/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='tRewards RUN RATE report - Ali&apos;s input.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='chandrapu.reddy@talabat.com' validate='no' workgroup-auth-mode='prompt' />
