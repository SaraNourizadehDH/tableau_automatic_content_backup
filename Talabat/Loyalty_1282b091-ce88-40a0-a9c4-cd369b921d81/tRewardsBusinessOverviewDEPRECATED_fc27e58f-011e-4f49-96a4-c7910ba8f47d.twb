      <table>
        <view>
          <datasources>
            <datasource caption='agg_loyalty (data_platform)' name='federated.02szdi100w1mhc1gma4c017kp07j' />
          </datasources>
          <datasource-dependencies datasource='federated.02szdi100w1mhc1gma4c017kp07j'>
            <column caption='SUM([Redeeming Customers])/SUM([Active Customers])' datatype='real' name='[Calculation_3036200234537484289]' role='measure' type='quantitative' user:unnamed='Daily 2'>
              <calculation class='tableau' formula='SUM([redeeming_customers])/SUM([active_customers])' />
            </column>
            <column caption='Earn-Burn Ratio' datatype='real' name='[Calculation_5851653676754505729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([burned_points])/SUM([points_earned]))' />
            </column>
            <column caption='Country Name' datatype='string' name='[Calculation_5851653676758888450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_id] = 1 then &apos;Kuwait&apos;&#10;ELSEIF [country_id] = 4 then &apos;UAE&apos;&#10;ELSEIF [country_id] = 6 then &apos;Qatar&apos;&#10;ELSEIF [country_id] = 3 then &apos;Bahrain&apos;&#10;ELSE &apos;Others&apos; END' />
            </column>
            <column caption='Total Usage' datatype='integer' name='[Calculation_5851653676761858052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[loyalty_usage]+[nfp_redemptions]' />
            </column>
            <column caption='Use to Redemption ratio' datatype='real' name='[Calculation_622481926004285440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([Calculation_5851653676761858052])/SUM([total_redemptions]))' />
            </column>
            <column caption='SUM([Eligible Customers])/SUM([Active Customers])' datatype='real' name='[Calculation_622481926271008774]' role='measure' type='quantitative' user:unnamed='Daily 2'>
              <calculation class='tableau' formula='SUM([eligible_customers])/SUM([active_customers])' />
            </column>
            <column caption='Health tab daily' datatype='string' name='[Health tab monthly (copy)_622481926006439938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[date] &gt;= DATEADD(&apos;day&apos;,-31,TODAY())&#10;AND [date] &lt; TODAY() - 1 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
