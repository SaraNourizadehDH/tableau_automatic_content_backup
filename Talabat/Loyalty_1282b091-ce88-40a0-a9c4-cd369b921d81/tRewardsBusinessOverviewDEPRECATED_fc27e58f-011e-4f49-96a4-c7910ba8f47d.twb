      <column caption='redeemer%' datatype='real' name='[Calculation_1994179881720008704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([redeeming_customers])/SUM([active_customers])' />
      </column>
      <column caption='gmv_rewards_only' datatype='real' name='[Calculation_2051530400393265158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [rewards_pro_category] WHEN &apos;Rewards only&apos; THEN [gmv] ELSE 0 END' />
      </column>
      <column caption='%gmv_rewards_only' datatype='real' name='[Calculation_2051530400393547783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2051530400393265158]/[Calculation_2051530400393887752]' />
      </column>
      <column caption='monthly_gmv' datatype='real' name='[Calculation_2051530400393887752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_id (Custom SQL Query1)], [order_month] : SUM(gmv)}' />
      </column>
      <column caption='before yesterday' datatype='date' name='[Calculation_4043317701204746240]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 2' />
      </column>
      <column caption='Graph Filter' datatype='boolean' name='[Calculation_5366179703551258624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type] = &apos;Daily&apos; then [date] &gt;= DATEADD(&apos;day&apos;,-60,TODAY())&#10;ELSEIF [type] = &apos;Monthly&apos; then [date] &gt;= DATEADD(&apos;month&apos;,-24,TODAY())&#10;END' />
      </column>
      <column caption='Redemptions per customer' datatype='real' name='[Calculation_5851653676754079744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_redemptions]/[redeeming_customers]' />
      </column>
      <column caption='Earn-Burn Ratio' datatype='real' name='[Calculation_5851653676754505729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([burned_points])/SUM([points_earned]))' />
      </column>
      <column caption='Country Name' datatype='string' name='[Calculation_5851653676758888450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_id] = 1 then &apos;Kuwait&apos;&#10;ELSEIF [country_id] = 4 then &apos;UAE&apos;&#10;ELSEIF [country_id] = 6 then &apos;Qatar&apos;&#10;ELSEIF [country_id] = 3 then &apos;Bahrain&apos;&#10;ELSE &apos;Others&apos; END' />
      </column>
      <column caption='Vendor Redemptions' datatype='integer' name='[Calculation_5851653676759994371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[loyalty_redemptions] - ([tmart_redemptions]+[everyday_roastery_redemptions]+[optics_redemptions]+[order_pro_fd_redemptions]+[order_non_pro_fd_redemptions])' />
      </column>
      <column caption='Total Usage' datatype='integer' name='[Calculation_5851653676761858052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[loyalty_usage]+[nfp_redemptions]' />
      </column>
      <column caption='Vendor Usage' datatype='integer' name='[Calculation_5851653676762042373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5851653676761858052]-([tmart_usage]+[everyday_roastery_usage]+[optics_usage]+[order_pro_fd_usage]+[order_non_pro_fd_usage]+[nfp_redemptions])' />
      </column>
      <column caption='Nfp Usage' datatype='integer' name='[Calculation_5851653676762632198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nfp_redemptions]' />
      </column>
      <column caption='vendor red%' datatype='real' name='[Calculation_5851653676776407048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5851653676759994371]/([total_partner_redeemptions])' />
      </column>
      <column caption='tmart red%' datatype='real' name='[Calculation_5851653677769429002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[tmart_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='total red%' datatype='integer' name='[Calculation_5851653677769572363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='order pro fd red%' datatype='real' name='[Calculation_5851653677770264588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_pro_fd_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='order non pro fd red%' datatype='real' name='[Calculation_5851653677770391565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_non_pro_fd_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='edr red%' datatype='real' name='[Calculation_5851653677770645519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[everyday_roastery_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='optics red%' datatype='real' name='[Calculation_5851653677770825744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[optics_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='nfp red%' datatype='real' name='[Calculation_5851653677770919953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nfp_redemptions]/([total_partner_redeemptions])' />
      </column>
      <column caption='order pro fd usage%' datatype='real' name='[Calculation_5851653677773021204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_pro_fd_usage]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='order non pro fd usage%' datatype='real' name='[Calculation_5851653677773148181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_non_pro_fd_usage]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='edr usage%' datatype='real' name='[Calculation_5851653677773275158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[everyday_roastery_usage]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='optics usage%' datatype='real' name='[Calculation_5851653677773328407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[optics_usage]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='nfp usage%' datatype='real' name='[Calculation_5851653677773402136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5851653676762632198]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='vendor usage%' datatype='real' name='[Calculation_5851653677773512729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5851653676762042373]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='total usage%' datatype='integer' name='[Calculation_5851653677773586458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='tmart usage%' datatype='real' name='[Calculation_5851653677773787163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[tmart_usage]/([Calculation_5851653676761858052])' />
      </column>
      <column caption='Avg. Time diff between redemption and usage' datatype='real' name='[Calculation_5851653677777670172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([usage_redemption_total_time_diff]/[loyalty_usage])/1440' />
      </column>
      <column caption='avg. time diff' datatype='integer' name='[Calculation_5851653677778575389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='Select date' datatype='boolean' name='[Calculation_5851653677781856286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date]=[Parameters].[Parameter 3]' />
      </column>
      <column caption='return red' datatype='integer' name='[Calculation_5851653677793411103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[redeeming_customers]-[new_redeeming_customers]' />
      </column>
      <column caption='return users' datatype='integer' name='[Calculation_5851653677793734688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[using_customers]-[new_using_customers]' />
      </column>
      <column caption='running sum of new redeemers' datatype='integer' name='[Calculation_5851653677832675378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([new_redeeming_customers]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active and not redeeming' datatype='integer' name='[Calculation_5851653677833744435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_redeeming_customers_count] - [redeeming_customers]' />
      </column>
      <column caption='Use to Redemption ratio' datatype='real' name='[Calculation_622481926004285440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([Calculation_5851653676761858052])/SUM([total_redemptions]))' />
      </column>
      <column caption='Health tab monthly' datatype='string' name='[Calculation_622481926005686273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;,[date]) &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;, TODAY()))&#10;AND DATETRUNC(&apos;month&apos;,[date]) &lt;= DATETRUNC(&apos;month&apos;, TODAY()) THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
