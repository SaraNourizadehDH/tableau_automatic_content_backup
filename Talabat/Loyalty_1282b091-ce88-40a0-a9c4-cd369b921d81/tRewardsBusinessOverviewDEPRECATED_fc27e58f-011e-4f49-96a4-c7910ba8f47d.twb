            <properties context=''>
              <relation connection='bigquery.040qya11uhr3gy1gka3xz1eugod8' name='Custom SQL Query' type='text'><![CDATA[with 
multi_subs_fix as 
(select country, account_id, subscriber_id, subscription_state, start_date, end_date, subscription_payment_id, plan_id from 
(select country, account_id, subscriber_id, subscription_state, start_date, 
case when country = 'AE' then DATE_ADD(a.end_date,INTERVAL 4 HOUR) else DATE_ADD(a.end_date,INTERVAL 3 HOUR) END as end_date, subscription_payment_id, ROW_NUMBER() OVER(PARTITION BY country, account_id, start_date 
ORDER BY (case when subscription_state = 'FREE TRIAL' THEN 1 
               when subscription_state = 'GRACE PERIOD' THEN 4
               when subscription_state = 'PAID' THEN 3 END)) as dupli_subs, a.plan_id
from `tlb-data-prod.data_platform.fct_subscription_history` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c on a.plan_id = c.plan_id and c.is_visible)
where dupli_subs = 1),

-- Pre-processing the Start Date
subs_date_fix as
(select country, account_id, subscriber_id, ROW_NUMBER() OVER(PARTITION BY country, account_id ORDER BY start_date) as 
subs_rnk, LAG(a.end_date,1) OVER(PARTITION BY country, account_id ORDER BY a.start_date) as prev_end_date,
case when subscription_state = 'GRACE PERIOD' THEN 
          (case when country = 'AE' then DATE_ADD(DATE_ADD(a.start_date,INTERVAL 4 HOUR),INTERVAL 1 DAY) 
                else DATE_ADD(DATE_ADD(a.start_date,INTERVAL 3 HOUR),INTERVAL 1 DAY) END)
     when subscription_state = 'PAID' and ROW_NUMBER() OVER(PARTITION BY country, account_Id ORDER BY start_date) >> 1 
          and DATE(start_date) << DATE(LAG(a.end_date,1) OVER(PARTITION BY country, account_id ORDER BY start_date)) then (case  when country = 'AE' then DATE_ADD(DATE_ADD(a.start_date,INTERVAL 4 HOUR),INTERVAL 1 DAY) else DATE_ADD(DATE_ADD(a.start_date,INTERVAL 3 HOUR),INTERVAL 1 DAY) END)
else (case when country = 'AE' then DATE_ADD(a.start_date,INTERVAL 4 HOUR) else DATE_ADD(a.start_date,INTERVAL 3 HOUR) END) END AS start_date, end_date, subscription_state, subscription_payment_id, plan_id from multi_subs_fix as a),

-- Customers active on a given day 
all_dates_d as 
(select date as iso_date, 
  case 
  when country = 'AE' then 4 
  when country = 'KW' then 1 
  when country = 'QA' then 6 
  when country = 'SA' then 2 
  when country = 'BH' then 3 
  when country = 'OM' then 5 
  when country = 'JO' then 8 
  when country = 'EG' then 9 
  when country = 'IQ' then 10 end as country_id
	, account_id, subscriber_id, subs_rnk, start_date, end_date, prev_end_date, subscription_state,
diff_days,
NTH_VALUE(CASE WHEN subscription_state = 'GRACE PERIOD' THEN NULL ELSE subscription_state END,1 IGNORE NULLS) OVER prev_subs as prev_subs_type, 
LAG(subscription_state,1) OVER(PARTITION BY country, account_id ORDER BY date) as prev_subs_type_gp, plan_id
from 
(select b.date, country, account_id, subscriber_id, ROW_NUMBER() OVER(PARTITION BY date, country, account_id ORDER BY (case when subscription_state = 'FREE TRIAL' THEN 1 
                                          when subscription_state = 'GRACE PERIOD' THEN 4
                                          when subscription_state = 'PAID' THEN 3 END)) as subs_rnk, start_date, end_date, 
a.prev_end_date, a.subscription_state, DATE_DIFF(end_date, start_date, DAY) as diff_days, plan_id
from subs_date_fix as a 
inner join `tlb-data-prod.data_platform.dim_date` as b on DATE(b.date) >>= DATE(a.start_date) and DATE(b.date) <<= DATE(a.end_date) where DATE(start_date) <<= CURRENT_DATE - 1
order by 1,2,3,6 desc)
where subs_rnk = 1 and last_day(DATE_TRUNC(date,MONTH)) = date
WINDOW prev_subs AS 
  (PARTITION BY country, account_id ORDER BY date DESC ROWS BETWEEN 1 FOLLOWING and UNBOUNDED FOLLOWING)),

category as
(select distinct a.account_id as customer_account_id, a.country_id, a.order_time
from `tlb-data-prod.data_platform.fct_order_info` a
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id 
inner join `tlb-data-prod.data_platform.dim_vertical` c on a.vertical_id = c.vertical_id
where account_id >> 0 and status = 'SUCCESS' and date_trunc(a.order_date, month) >>= '2022-01-01'
order by 1,2,3)

,customers as 
( select distinct customer_account_id, order_month, country_id, 
	case
	when is_pro=0 and is_rewards=0 then 'None'
	when is_pro=0 and is_rewards>>0 then 'Rewards only'
	when is_pro>>0 and is_rewards=0 then 'Pro only'
	when is_pro>>0 and is_rewards>>0 then 'Rewards + Pro'
	end as rewards_pro_category
	from
( select
	customer_account_id, date_trunc(order_date, month) as order_month, country_id,
	sum(is_pro) as is_pro, sum(is_rewards) as is_rewards
	from (
		select distinct cat.customer_account_id, date_trunc(cat.order_time, day) order_date, cat.country_id,
                case when s.account_id is not null then 1 else 0 end as is_pro,
                case when a.account_id is not null then 1 else 0 end as is_rewards
		from category cat
		left join all_dates_d s
		on cat.customer_account_id = s.account_id and s.start_date <<= cat.order_time and s.end_date >>= cat.order_time and s.country_id = cat.country_id 
		and s.subscription_state = 'PAID' and subscription_state = 'PAID' and DATE(DATE_TRUNC(cat.order_time,MONTH)) = DATE(DATE_TRUNC(s.iso_date,MONTH))
		left join 
				(select distinct account_id, transaction_date_utc, transaction_type_name
				from `tlb-data-prod.data_platform.fct_loyalty_transaction` fl
				inner join `tlb-data-prod.data_platform.dim_loyalty_transaction_type` b on fl.transaction_type_id = b.transaction_type_id
				left join `tlb-data-prod.data_platform_loyalty.voucher_options` c on fl.campaign_id = c.id) as a
				on cat.customer_account_id = a.account_id and date_trunc(cat.order_time, month) = date_trunc(a.transaction_date_utc, month)
				and a.transaction_type_name in ('burn','Burn on Partners','charity', 'Burn on raffle') and date_trunc(a.transaction_date_utc, month) >>= '2022-01-01' and a.transaction_date_utc << CURRENT_DATE
		group by 1,2,3,4,5
		order by 1
		)
group by 1,2,3))

select 
	rewards_pro_category,
	c.order_month,
	c.country_id,
        'Monthly' as type,
    count(distinct c.customer_account_id) as base_cust,
	count(distinct b.account_id) as active_cust
from customers c
left join
(select distinct a.account_id, a.order_date, a.country_id
from `tlb-data-prod.data_platform.fct_order_info` a 
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id and account_id >> 0 and status = 'SUCCESS' and a.order_date is not null
group by 1,2,3) b
on c.customer_account_id = b.account_id and c.order_month = date_sub(date_trunc(b.order_date, month), INTERVAL 1 month) and c.country_id = b.country_id
where date_trunc(c.order_month, month) << date_sub(date_trunc(current_date, month), INTERVAL 1 month)
group by 1,2,3
order by 2,1,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
