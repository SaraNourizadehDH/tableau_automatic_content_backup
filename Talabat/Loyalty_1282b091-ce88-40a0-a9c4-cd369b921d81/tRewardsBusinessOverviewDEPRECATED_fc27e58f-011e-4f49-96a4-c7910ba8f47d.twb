    <datasource caption='agg_loyalty (data_platform)' inline='true' name='federated.02szdi100w1mhc1gma4c017kp07j' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02al7tv1y5o9st1a9dxno1r6qpow'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='aman.agarwal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02al7tv1y5o9st1a9dxno1r6qpow' name='Custom SQL Query' type='text'><![CDATA[with tpro_subs as
(select distinct /*'Daily' as type,*/ d.date, b.account_id, e.country_id
from `data_platform.fct_subscription_history` b
inner join `data_platform.dim_date`  d on d.date >>= b.start_date and d.date <<= b.end_date
inner join `data_platform.dim_subscription_plan` c on b.plan_id=c.plan_id
inner join `data_platform.dim_country_info` e on c.country=e.country_code
where lower(c.plan_name) like '%pro%'),

top_5_best_selling_vouchers as (
select *
from
(SELECT order_dated, country_id, voucher_name, tpro_tag, orders, ROW_NUMBER() over (PARTITION BY order_dated, country_id, tpro_tag ORDER BY orders desc) AS ranked
FROM (
select c.order_date as order_dated, b.country_id, cc.name as voucher_name, c.tpro_tag, COUNT(DISTINCT c.order_id) as orders
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
inner join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
inner join 
(select a.order_id, CAST(a.order_date as DATE) as order_date, a.country_id, case when c.account_id is null then 'Non Tpro' else 'Tpro' end as tpro_tag
from `tlb-data-prod.data_platform.fct_order_info` a
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id
left join tpro_subs c on c.account_id = a.account_id and c.date = a.order_date and c.country_id = a.country_id
where a.account_id >> 0 and status = 'SUCCESS' and order_date >>= '2022-01-01') c on a.order_id = CAST(c.order_id as string)
and b.country_id = c.country_id 
and CAST(c.order_date as DATE) >>= '2022-01-01' AND CAST(c.order_date as DATE) << CURRENT_DATE
where b.incentive_type_detail in ('LOYALTY', 'NFP') and cc.id not in ('1e0f4916-12bb-4be9-9b15-646d9a3d63e5','301e0237-57a6-41a9-954c-14947aa7e40c') AND is_used 
GROUP BY 1,2,3,4 ORDER BY 1,2,3,4)) WHERE ranked << 6
),

top_selling_chains as (
SELECT * 
FROM 
(SELECT order_dated, country_id, chain_name, tpro_tag, orders, ROW_NUMBER() over (PARTITION BY order_dated, country_id, tpro_tag ORDER BY orders desc) AS ranked
FROM (
SELECT c.order_date as order_dated, b.country_id, tpro_tag, trim(lower(d.chain_name)) as chain_name,COUNT(DISTINCT c.order_id) as orders
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
inner join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
inner join
(select a.order_id, CAST(a.order_date as DATE) as order_date, a.country_id, case when c.account_id is null then 'Non Tpro' else 'Tpro' end as tpro_tag
from `tlb-data-prod.data_platform.fct_order_info` a
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id
left join tpro_subs c on c.account_id = a.account_id and c.date = a.order_date and c.country_id = a.country_id
where a.account_id >> 0 and status = 'SUCCESS' and order_date >>= '2022-01-01') c on a.order_id = CAST(c.order_id as string)
and b.country_id = c.country_id 
LEFT JOIN `tlb-data-prod.data_platform_loyalty.brand_groups` bg ON bg.id = cc.brand_group_id
LEFT JOIN `tlb-data-prod.data_platform_loyalty.brand_groups_brands` bgb ON bgb.brand_group_id = bg.id
inner join `tlb-data-prod.data_platform.dim_chain` d 
ON CAST(d.chain_id as STRING) = CAST((case when bgb.brand_id is null then cc.brand_id else bgb.brand_id end) as STRING) and 
d.country_id = b.country_id
WHERE b.incentive_type_detail in ('LOYALTY', 'NFP')
AND (cc.brand_id is not null or bgb.brand_id is not null)
and CAST(a.created_on_date_utc as DATE) << CURRENT_DATE
GROUP BY 1,2,3,4 ORDER BY 1 DESC,5)) WHERE ranked << 6),

top_5_best_selling_vouchers_monthly as (
select *
from
(SELECT order_dated, country_id, voucher_name, tpro_tag, orders, ROW_NUMBER() over (PARTITION BY order_dated, country_id,tpro_tag ORDER BY orders desc) AS ranked
FROM (
select date_trunc(c.order_date, month) as order_dated, b.country_id, tpro_tag, cc.name as voucher_name,COUNT(DISTINCT c.order_id) as orders
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
inner join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
inner join 
(select a.order_id, CAST(a.order_date as DATE) as order_date, a.country_id, case when c.account_id is null then 'Non Tpro' else 'Tpro' end as tpro_tag
from `tlb-data-prod.data_platform.fct_order_info` a
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id
left join tpro_subs c on c.account_id = a.account_id and c.date = a.order_date and c.country_id = a.country_id
where a.account_id >> 0 and status = 'SUCCESS' and order_date >>= '2022-01-01') c on a.order_id = CAST(c.order_id as string)
and b.country_id = c.country_id 
and CAST(c.order_date as DATE) >>= '2022-01-01' AND CAST(c.order_date as DATE) << CURRENT_DATE
where b.incentive_type_detail in ('LOYALTY', 'NFP') and cc.id not in ('1e0f4916-12bb-4be9-9b15-646d9a3d63e5','301e0237-57a6-41a9-954c-14947aa7e40c') AND is_used 
GROUP BY 1,2,3,4 ORDER BY 1,2,3,4)) WHERE ranked << 6
),

top_selling_chains_monthly as (
SELECT * 
FROM 
(SELECT order_dated, country_id, chain_name, tpro_tag, orders, ROW_NUMBER() over (PARTITION BY order_dated, country_id, tpro_tag ORDER BY orders desc) AS ranked
FROM (
SELECT date_trunc(c.order_date,month) as order_dated, b.country_id, tpro_tag, trim(lower(d.chain_name)) as chain_name,COUNT(DISTINCT c.order_id) as orders
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
inner join `tlb-data-prod.data_platform.dim_incentives_voucher` b on a.voucher_id = b.voucher_id
INNER JOIN `tlb-data-prod.data_platform_loyalty.voucher_options` cc on cc.id = a.voucher_option_id
inner join
(select a.order_id, CAST(a.order_date as DATE) as order_date, a.country_id, case when c.account_id is null then 'Non Tpro' else 'Tpro' end as tpro_tag
from `tlb-data-prod.data_platform.fct_order_info` a
inner join `tlb-data-prod.data_platform.dim_order_status` b on a.order_status_id = b.order_status_id
left join tpro_subs c on c.account_id = a.account_id and c.date = a.order_date and c.country_id = a.country_id
where a.account_id >> 0 and status = 'SUCCESS' and order_date >>= '2022-01-01') c on a.order_id = CAST(c.order_id as string)
and b.country_id = c.country_id 
LEFT JOIN `tlb-data-prod.data_platform_loyalty.brand_groups` bg ON bg.id = cc.brand_group_id
LEFT JOIN `tlb-data-prod.data_platform_loyalty.brand_groups_brands` bgb ON bgb.brand_group_id = bg.id
inner join `tlb-data-prod.data_platform.dim_chain` d 
ON CAST(d.chain_id as STRING) = CAST((case when bgb.brand_id is null then cc.brand_id else bgb.brand_id end) as STRING) and 
d.country_id = b.country_id
WHERE b.incentive_type_detail in ('LOYALTY', 'NFP')
AND (cc.brand_id is not null or bgb.brand_id is not null)
and CAST(a.created_on_date_utc as DATE) << CURRENT_DATE
GROUP BY 1,2,3,4 ORDER BY 1 DESC,5)) WHERE ranked << 6)

(SELECT 'Daily' as type,'Voucher' AS type_1, tpro_tag as customer_type, a.iso_date,b.country_id,b.voucher_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT date as iso_date, day_of_month, day_of_week FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_5_best_selling_vouchers b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct
(SELECT 'Daily' as type,'Chain' AS type_1, tpro_tag as customer_type,a.iso_date,b.country_id,trim(lower(b.chain_name)) as chain_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT date as iso_date, day_of_month,day_of_week FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_selling_chains b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct 
(SELECT 'Monthly' as type,'Voucher' AS type_1, tpro_tag as customer_type,iso_date,b.country_id,b.voucher_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT DATE_TRUNC(date, month) as iso_date FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_5_best_selling_vouchers_monthly b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct 
(SELECT 'Monthly' as type,'Chain' AS type_1, tpro_tag as customer_type, iso_date,b.country_id,trim(lower(b.chain_name)) as chain_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT DATE_TRUNC(date, month) as iso_date FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_selling_chains_monthly b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
