and CAST(a.created_on_date_utc as DATE) << CURRENT_DATE
GROUP BY 1,2,3,4 ORDER BY 1 DESC,5)) WHERE ranked << 6)

(SELECT 'Daily' as type,'Voucher' AS type_1, tpro_tag as customer_type, a.iso_date,b.country_id,b.voucher_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT date as iso_date, day_of_month, day_of_week FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_5_best_selling_vouchers b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct
(SELECT 'Daily' as type,'Chain' AS type_1, tpro_tag as customer_type,a.iso_date,b.country_id,trim(lower(b.chain_name)) as chain_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT date as iso_date, day_of_month,day_of_week FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_selling_chains b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct 
(SELECT 'Monthly' as type,'Voucher' AS type_1, tpro_tag as customer_type,iso_date,b.country_id,b.voucher_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT DATE_TRUNC(date, month) as iso_date FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_5_best_selling_vouchers_monthly b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)
union distinct 
(SELECT 'Monthly' as type,'Chain' AS type_1, tpro_tag as customer_type, iso_date,b.country_id,trim(lower(b.chain_name)) as chain_name,sum(orders) as successful_orders,'Overall' as launch_num
FROM (SELECT DISTINCT DATE_TRUNC(date, month) as iso_date FROM `tlb-data-prod.data_platform.dim_date` WHERE date>>= '2022-01-01' AND date << CURRENT_DATE) a
LEFT JOIN top_selling_chains_monthly b on a.iso_date = b.order_dated
GROUP BY 1,2,3,4,5,6)]]></relation>
          <relation connection='bigquery.02al7tv1y5o9st1a9dxno1r6qpow' name='Custom SQL Query1' type='text'><![CDATA[with earning_customers as
(select 
  distinct account_id, transaction_country_id as country_id, datetime(timestamp(a.transaction_date_time_utc), z.timezone) as order_time
from `tlb-data-prod.data_platform.fct_loyalty_transaction` a
inner join `tlb-data-prod.data_platform.dim_country_info` as z on a.transaction_country_id = z.country_id
where transaction_date_utc >>= '2022-01-01'
and transaction_type_id in (300/*welcome_gift*/,
                            301/*Welcome gift correction*/,
                            100/*earn*/,
                            102/*earn_cancellation*/,
                            101/*earn_compensation*/,
                            400 /*earn pro*/)
and loyalty_points_delta <<>> 0)

,customers as 
(select distinct account_id, order_month, country_id, 
	case
	when is_pro=0 and is_rewards=0 then 'None'
	when is_pro=0 and is_rewards>>0 then 'Rewards only'
	when is_pro>>0 and is_rewards=0 then 'Pro only'
	when is_pro>>0 and is_rewards>>0 then 'Rewards + Pro'
	end as rewards_pro_category
	from
(select
	account_id, date_trunc(order_date, month) as order_month, country_id,
	sum(is_pro) as is_pro, sum(is_rewards) as is_rewards
	from (
		select distinct cat.account_id, date_trunc(cat.order_time, day) order_date, cat.country_id,
                case when s.account_id is not null then 1 else 0 end as is_pro,
                case when a.account_id is not null then 1 else 0 end as is_rewards
		from earning_customers cat
		left join 
			(select 
					distinct a.account_id, date_trunc(datetime(timestamp(a.transaction_date_time_utc), z.timezone), month) as month
				from `tlb-data-prod.data_platform.fct_loyalty_transaction` a
				inner join `tlb-data-prod.data_platform.dim_country_info` as z on a.transaction_country_id = z.country_id
				where transaction_date_utc >>= '2022-01-01'
				and transaction_type_id in (200/*burn*/,
																		220 /*Burn on Partners*/,
																		201/*charity*/,
																		230/*Burn on raffles*/)
				and loyalty_points_delta <<>> 0) as a
				on cat.account_id = a.account_id and date_trunc(DATETIME(cat.order_time), month) = a.month
		left join 
			`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` s
			on cat.account_id = s.account_id and DATETIME(cat.order_time) between s.start_date and s.end_date 
    	and cat.country_id = case 
                          when s.country = 'KW' then 1
                          when s.country = 'SA' then 2
                          when s.country = 'BH' then 3
                          when s.country = 'AE' then 4
                          when s.country = 'OM' then 5
													when s.country = 'QA' then 6
                          when s.country = 'JO' then 8
                          when s.country = 'EG' then 9
                          when s.country = 'IQ' then 10 end
		and s.subscription_state = 'PAID' and date(cat.order_time) = s.iso_date
		group by 1,2,3,4,5
		order by 1
	)
group by 1,2,3))

select 
	rewards_pro_category,
	c.order_month,
	c.country_id,
        'Monthly' as type,
	count(distinct c.account_id) as customers,
	count(distinct a.order_id) as orders,
  sum(gmv_amount_lc) as gmv
from customers c
left join `tlb-data-prod.data_platform.fct_order_info` a on c.account_id = a.account_id and date_trunc(a.order_date, month) = c.order_month and c.country_id = a.country_id
and a.account_id >> 0 and is_successful and order_date is not null
group by 1,2,3
order by 2,1]]></relation>
