            <column caption='active_monthly' datatype='integer' name='[Calculation_397653792297590791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [order_month]: SUM([active_cust])}' />
            </column>
            <column caption='base_monthly' datatype='integer' name='[Calculation_397653792297701384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [order_month]: SUM([base_cust])}' />
            </column>
            <column caption='churn rate' datatype='real' name='[Calculation_397653792297820169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[active_cust]/[base_cust]' />
            </column>
            <column caption='churn rate monthly' datatype='real' name='[Calculation_397653792297877514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_397653792297590791]/[Calculation_397653792297701384]' />
            </column>
            <column caption='Country Name' datatype='string' name='[Calculation_397653792298078219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_id] = 1 then &apos;Kuwait&apos;&#10;ELSEIF [country_id] = 4 then &apos;UAE&apos;&#10;ELSEIF [country_id] = 6 then &apos;Qatar&apos;&#10;ELSE &apos;Others&apos; END' />
            </column>
            <column caption='month' datatype='datetime' name='[Calculation_397653792302546956]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,1,[order_month])' />
            </column>
