        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1ybod7c0a3mhgj1gejhbs0b741c2' name='Custom SQL Query' type='text'><![CDATA[WITH
  dates AS (
  SELECT
    DISTINCT DATE(month_start_date) opening_month
  FROM
    `tlb-data-prod.data_platform.dim_date`
  WHERE
    DATE(month_start_date) BETWEEN '2023-01-01'
    AND current_date),

opening_points AS (
  SELECT
    date_add(a.opening_month, interval -1 month) as closing_month,
    c.country_code,
    SUM(loyalty_points_delta) AS closing_balance
  FROM
    dates a
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_loyalty_transaction` b
  JOIN
    `tlb-data-prod.data_platform.dim_country_info` c
  ON
    b.transaction_country_id = c.country_id
  ON
    DATE(b.transaction_date_utc) << a.opening_month
    AND b.loyalty_points_delta <<>> 0
  GROUP BY
    1,
    2),

eb_ratio AS (
  SELECT
    date_add(opening_month, interval -1 month) as closing_month,
    country_code,
    SAFE_DIVIDE(burned_points, earned_points) AS earn_burn_ratio
  FROM (
    SELECT
      a.opening_month,
      c.country_code,
      SUM(CASE
          WHEN b.transaction_type_id IN (200/*burn*/, 220 /*Burn on Partners*/, 201/*charity*/, 230/*Burn on raffles*/) THEN b.loyalty_points_delta
      END
        )*(-1) AS burned_points,
      SUM(CASE
          WHEN b.transaction_type_id IN (300/*welcome_gift*/, 301/*Welcome gift correction*/, 100/*earn*/, 102/*earn_cancellation*/, 101/*earn_compensation*/, 400 /*earn pro*/) THEN b.loyalty_points_delta
      END
        ) AS earned_points
    FROM
      dates a
    LEFT JOIN
      `tlb-data-prod.data_platform.fct_loyalty_transaction` b
    JOIN
      `tlb-data-prod.data_platform.dim_country_info` c
    ON
      b.transaction_country_id = c.country_id
    ON
      DATE_TRUNC(b.transaction_date_utc,month) >>= DATE_SUB(a.opening_month, INTERVAL 2 month)
      AND DATE_TRUNC(b.transaction_date_utc,month) << a.opening_month
      AND b.loyalty_points_delta <<>> 0
    GROUP BY
      1,
      2))

SELECT
  a.closing_month,
  a.country_code,
  closing_balance,
  earn_burn_ratio as earn_burn_ratio
FROM
  opening_points a
LEFT JOIN
  eb_ratio b
ON
  a.closing_month = b.closing_month
  AND a.country_code = b.country_code]]></relation>
