            <column caption='Outstanding Liability' datatype='real' name='[Calculation_1476195545554747392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[closing_balance]*[earn_burn_ratio]*&#10;(CASE [closing_month]&#10;WHEN date(&quot;2023-1-1&quot;) THEN [Jan-2023]&#10;WHEN date(&quot;2023-2-1&quot;) THEN [Feb-2023]&#10;WHEN date(&quot;2023-3-1&quot;) THEN [Mar-2023]&#10;WHEN date(&quot;2023-4-1&quot;) THEN [Apr-2023]&#10;WHEN date(&quot;2023-5-1&quot;) THEN [May-2023]&#10;WHEN date(&quot;2023-6-1&quot;) THEN [Jun-2023]&#10;WHEN date(&quot;2023-7-1&quot;) THEN [Jul-2023]&#10;WHEN date(&quot;2023-8-1&quot;) THEN [Aug-2023]&#10;WHEN date(&quot;2023-9-1&quot;) THEN [Sep-2023]&#10;WHEN date(&quot;2023-10-1&quot;) THEN [Oct-2023]&#10;WHEN date(&quot;2023-11-1&quot;) THEN [Nov-2023]&#10;WHEN date(&quot;2023-12-1&quot;) THEN [Dec-2023]&#10;WHEN date(&quot;2024-1-1&quot;) THEN [Jan-2024]&#10;WHEN date(&quot;2024-2-1&quot;) THEN [Feb-2024]&#10;WHEN date(&quot;2024-3-1&quot;) THEN [Mar-2024]&#10;WHEN date(&quot;2024-4-1&quot;) THEN [Apr-2024]&#10;WHEN date(&quot;2024-5-1&quot;) THEN [May-2024]&#10;WHEN date(&quot;2024-6-1&quot;) THEN [Jun-2024]&#10;WHEN date(&quot;2024-7-1&quot;) THEN [Jul-2024]&#10;WHEN date(&quot;2024-8-1&quot;) THEN [Aug-2024]&#10;WHEN date(&quot;2024-9-1&quot;) THEN [Sep-2024]&#10;WHEN date(&quot;2024-10-1&quot;) THEN [Oct-2024]&#10;WHEN date(&quot;2024-11-1&quot;) THEN [Nov-2024]&#10;WHEN date(&quot;2024-12-1&quot;) THEN [Dec-2024]&#10;ELSE 0&#10;END)' />
            </column>
            <column datatype='real' name='[Dec-2023]' role='measure' type='quantitative' />
            <column datatype='real' name='[Dec-2024]' role='measure' type='quantitative' />
            <column datatype='real' name='[Feb-2023]' role='measure' type='quantitative' />
