      <aliases enabled='yes' />
      <column caption='ABV(LC)' datatype='real' name='[AOV(LC) (copy)_1734730327742160897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful (dim_vendor_info)]= True then [basket_amount_lc] END)/&#13;&#10;COUNTD(if [is_successful (dim_vendor_info)]= True then [order_id (dim_vendor_info)] END)' />
      </column>
      <column caption='Average daily order' datatype='real' name='[Average daily orders (copy)_1240178807507464195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful (dim_vendor_info)] = True then [order_id (dim_vendor_info)] END)/ max([Calculation_1240178807507992580])' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_1195424265282293760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful (dim_vendor_info)]= True then [order_id (dim_vendor_info)] END)' />
      </column>
      <column caption='Month days' datatype='integer' name='[Calculation_1195424265294864387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[order_date (dim_vendor_info)]))))' />
      </column>
      <column caption='Average daily orders' datatype='real' name='[Calculation_1195424265295044612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful (dim_vendor_info)] = True then [order_id (dim_vendor_info)] END)/ max([Calculation_1195424265294864387])' />
      </column>
      <column caption='MTD' datatype='integer' name='[Calculation_1240178807507992580]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date (dim_vendor_info)], TODAY())' />
      </column>
      <column caption='Pace' datatype='real' name='[Calculation_1402871322817138689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1/30) * (DATEPART(&apos;day&apos;, TODAY()))' />
      </column>
      <column caption='AOV(LC)' datatype='real' name='[Calculation_1498854297171648512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful (dim_vendor_info)]= True then [gmv_amount_lc (dim_vendor_info)] END)/&#13;&#10;COUNTD(if [is_successful (dim_vendor_info)]= True then [order_id (dim_vendor_info)] END)' />
      </column>
      <column caption='Affordability %' datatype='real' name='[Calculation_1498854297172299777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful (dim_vendor_info)]= True then [saving_amount_eur] END)/&#13;&#10;SUM(if [is_successful (dim_vendor_info)]= True then [gmv_amount_eur] END)' />
      </column>
      <column caption='MTD (copy)' datatype='integer' name='[MTD (copy)_1005710151940198400]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1240178807507992580]&gt;31 then [Calculation_1195424265294864387] else [Calculation_1240178807507992580] END' />
      </column>
      <column caption='Pace (copy)' datatype='real' name='[Pace (copy)_2436165970867048448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1/30) * (DATEPART(&apos;day&apos;, TODAY()))' />
      </column>
