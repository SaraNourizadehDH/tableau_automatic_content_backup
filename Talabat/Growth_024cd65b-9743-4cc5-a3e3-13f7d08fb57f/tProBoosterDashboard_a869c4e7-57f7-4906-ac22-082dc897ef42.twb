      <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1b0gtf309wmzld11gvplb0rtl3g0].[Calculation_2481553813363896337]' caption='End Date' datatype='date' name='[Date Parameter]' param-domain-type='range' role='measure' type='quantitative' value='#2024-08-21#'>
        <calculation class='tableau' formula='#2024-08-21#' />
