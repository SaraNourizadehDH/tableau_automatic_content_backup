    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/tProBoosterDashboard/Glossary?rev=' id='Glossary' path='/t/Talabat/workbooks/tProBoosterDashboard_17235523792230' revision='' site='Talabat' />
      <style />
      <size maxheight='500' maxwidth='1000' minheight='500' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='96800' id='3' type-v2='text' w='98400' x='800' y='1600'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontsize='12'>Definitions</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontsize='10'>Customers</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Average Booster savings per Customer : total booster discount/ count of customers using booster discount</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Average total savings per Customer: total savings (booster + free delivery)/ count of customers using booster discount</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Average Booster savings per order: total booster discount/count of booster orders</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Average total savings per Boosted order: total savings (booster+free delivery)/ count of booster orders</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontsize='10'>Platform</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Orders : count of  booster orders</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Customers  : count of  booster users</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Adoption% : count of booster users in the time period / total tpro customers in the time period</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>Order Frequency : count of  booster orders/ count of booster customers</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>AOV  (gmv/orders) : GMV of booster orders/ count of booster orders</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='10'>GMV : GMV of booster orders</run>
              <run fontalignment='0'>Æ&#10;</run>
