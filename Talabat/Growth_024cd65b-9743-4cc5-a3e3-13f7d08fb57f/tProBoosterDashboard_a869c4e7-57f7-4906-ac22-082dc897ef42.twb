            <column datatype='real' name='[tpro_booster_discount_amount_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[tpro_booster_incentive_discount_amount_lc]' role='measure' type='quantitative' />
            <column datatype='integer' name='[tpro_booster_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[tpro_booster_tpro_discount_lc]' role='measure' type='quantitative' />
