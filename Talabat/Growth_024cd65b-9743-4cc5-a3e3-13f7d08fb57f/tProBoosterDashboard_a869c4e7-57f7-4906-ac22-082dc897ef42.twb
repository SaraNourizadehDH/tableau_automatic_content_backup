      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tPro booster' id='_9E1EE7145D5B4AB994BA5771649F79EC'>
            <properties context=''>
              <relation connection='bigquery.1b9jnxc12e8l0911a0si008fizeg' name='Custom SQL Query' type='text'><![CDATA[with first_tpro_order as (
    SELECT
        fct_bill.account_id
        , fct_bill.country_code
        , max(case when first_booster_order_time <<= first_tpro_order_time then 1 else 0 end) as booster_acquisition
    FROM (
        select
            account_id, country_code
            , min(order_time) as first_booster_order_time
        from tlb-data-prod.data_platform.fct_billing
        where order_date >>= '2024-07-21'
        and tpro_booster_discount_amount_lc <<>> 0
        group by all
    ) fct_bill
    LEFT JOIN (
        SELECT account_id, country_code
            , min(order_time) as first_tpro_order_time
        FROM `tlb-data-prod.data_platform.fct_order_info`
        WHERE order_date >>= '2021-10-01'
        AND is_tpro_order
        AND is_successful
        AND is_test = FALSE
        GROUP BY ALL
    ) fct_ord on fct_bill.account_id = fct_ord.account_id and fct_bill.country_code = fct_ord.country_code
    GROUP BY ALL

), tpro_acquisition as (
    select
        date
        , account_id
        , country_code
        , array_agg(entry_point order by hit_timestamp_utc asc limit 1)[OFFSET(0)] as first_acquired_entrypoint
        , min(hit_timestamp_utc) as first_acquired_timestamp
    from (
        SELECT
            event.date
            , event.account_id
            , event.country_code
            , hit_timestamp_utc
            , is_payment_successful
            , COALESCE(CASE WHEN event.event_type <<>> 'Entry' THEN LAST_VALUE(conf.found_via IGNORE NULLS) OVER (PARTITION BY event.session_id, event.date ORDER BY event.hit_number)
                WHEN event.event_type = 'Entry' AND conf.found_via_loading IS NOT NULL THEN conf.found_via_loading
                ELSE conf.found_via
                END, 'unrecognized'
            ) AS entry_point
        FROM tlb-data-prod.data_platform.fct_subscription_event event
        INNER JOIN `tlb-data-prod.data_platform.dim_subscription_event_config` conf ON event.subscription_event_id = conf.subscription_event_id
        WHERE date >>= '2024-07-21'
    )
    where is_payment_successful
    group by all

), best_seller_order AS (
    SELECT
        a.order_date AS date,
        a.order_id,
        a.incentive_amount_lc,
        a.vendor_id,
    TRUE AS is_on_best_seller_campaign
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` a
    INNER JOIN (
        SELECT
            country_code,
            date,
            account_id
            from `tlb-data-prod.data_platform.fct_subscription_cohort_daily` as o
        where is_churned is false
        and is_billing_retry is false
        and date >>= '2024-07-21'
        group by all
    ) tpro on tpro.account_id = a.account_id and a.country_code = tpro.country_code and tpro.date = a.order_date
    LEFT JOIN `tlb-data-prod.data_platform.dim_incentive_campaign` b ON a.incentive_campaign_id = b.incentive_campaign_id
    WHERE 1 = 1
    and a.incentive_sub_type = 'item discount'
    AND (
        (case when a.country_code in ('AE','KW','QA','BH','JO','OM') then b.platform_campaign_type IN ('Best Sellers') 
                when a.country_code = 'KW' then b.platform_campaign_type IN ('Mega Deal') or b.campaign_name LIKE '%Mega Deal%' or b.campaign_name LIKE '%Mega deal%'
                end)
    )
    AND a.order_date >>= DATE('2024-07-21')

), daily as (
    select
        "Daily" as date_aggregation,
        o.country_code,
        o.order_date as order_date,
        o.account_id as customers,
        IF(ta.account_id IS NOT NULL AND tpro_booster_discount_amount_lc <<>> 0, TRUE, FALSE) as booster_entrypoint_acquisition,
        IF(booster_acquisition = 1, TRUE, FALSE) as is_first_tpro_order,
        count(distinct oi.order_id) as best_seller_orders,
        count(distinct if(tpro_booster_discount_amount_lc <<>> 0, oi.order_id, null)) as tpro_booster_orders,


        sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc,
        sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc,

        sum(bs.incentive_amount_lc + o.tpro_booster_discount_amount_lc) as best_seller_discount_amount_lc,
        sum(if(tpro_booster_discount_amount_lc <<>> 0, bs.incentive_amount_lc + tpro_booster_discount_amount_lc, null)) as tpro_booster_incentive_discount_amount_lc,
        sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc,

        sum(tpro_discount_lc) as best_seller_tpro_discount_lc,
        sum(if(tpro_booster_discount_amount_lc <<>> 0,tpro_discount_lc,null)) as tpro_booster_tpro_discount_lc,

        sum(gmv_amount_lc) as best_seller_gmv_amount_lc,
        sum(if(tpro_booster_discount_amount_lc <<>> 0, gmv_amount_lc, null)) as tpro_booster_gmv_amount_lc,

        sum(basket_amount_lc) as best_seller_basket_amount_lc,
        sum(if(tpro_booster_discount_amount_lc <<>> 0, basket_amount_lc, null)) as tpro_booster_basket_amount_lc,

        count(distinct case when tpro_discount_lc <<>>0 then o.order_id end) as best_seller_free_delivery_orders,
        count(distinct case when tpro_discount_lc <<>>0 and tpro_booster_discount_amount_lc <<>> 0 then o.order_id end) as tpro_booster_free_delivery_orders


    from `tlb-data-prod.data_platform.fct_order_info` as oi
    inner join best_seller_order bs on bs.order_id = oi.order_id
    inner join `tlb-data-prod.data_platform.fct_billing` as o on o.order_id=oi.order_id
    inner join `tlb-data-prod.data_platform.dim_chain` as c on o.chain_id=c.chain_id
    left join first_tpro_order fto on fto.account_id = oi.account_id and fto.country_code = oi.country_code
    LEFT JOIN tpro_acquisition ta ON ta.date = oi.order_date AND ta.account_id = oi.account_id AND ta.country_code = oi.country_code AND first_acquired_entrypoint in ('Vendor Menu','OTP','Cart','Checkout')
    where o.is_successful
    and o.order_date>>= "2024-07-21"
    and bs.incentive_amount_lc <<>> 0
    group by all
    order by 1,2

), weekly as (
    select
        "Weekly" as date_aggregation,
        country_code,
        date_trunc(order_date,week) as order_date,
        count(distinct if(best_seller_orders >> 0, customers, null)) as best_seller_customers,
        count(distinct if(tpro_booster_orders >> 0, customers, null)) as tpro_booster_customers,

        sum(best_seller_orders) as best_seller_orders,
        sum(tpro_booster_orders) as tpro_booster_orders,

        count(distinct if(booster_entrypoint_acquisition is TRUE, customers, null)) as acquisition_through_booster_customers,
        count(distinct if(is_first_tpro_order is TRUE, customers, null)) as is_first_tpro_order_customers,

        sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc,
        sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc,

        sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc,
        sum(tpro_booster_incentive_discount_amount_lc) as tpro_booster_incentive_discount_amount_lc,
        sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc,

        sum(best_seller_tpro_discount_lc) as best_seller_tpro_discount_lc,
        sum(tpro_booster_tpro_discount_lc) as tpro_booster_tpro_discount_lc,

        sum(best_seller_gmv_amount_lc) as best_seller_gmv_amount_lc,
        sum(tpro_booster_gmv_amount_lc) as tpro_booster_gmv_amount_lc,

        sum(best_seller_basket_amount_lc) as best_seller_basket_amount_lc,
        sum(tpro_booster_basket_amount_lc) as tpro_booster_basket_amount_lc,

        sum(best_seller_free_delivery_orders) as best_seller_free_delivery_orders,
        sum(tpro_booster_free_delivery_orders) as tpro_booster_free_delivery_orders

    from daily
    group by all

),monthly as (
    select
        "Monthly" as date_aggregation,
        country_code,
        date_trunc(order_date,month) as order_date,
        count(distinct if(best_seller_orders >> 0, customers, null)) as best_seller_customers,
        count(distinct if(tpro_booster_orders >> 0, customers, null)) as tpro_booster_customers,

        sum(best_seller_orders) as best_seller_orders,
        sum(tpro_booster_orders) as tpro_booster_orders,

        count(distinct if(booster_entrypoint_acquisition is TRUE, customers, null)) as acquisition_through_booster_customers,
        count(distinct if(is_first_tpro_order is TRUE, customers, null)) as is_first_tpro_order_customers,

        sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc,
        sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc,

        sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc,
        sum(tpro_booster_incentive_discount_amount_lc) as tpro_booster_incentive_discount_amount_lc,
        sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc,

        sum(best_seller_tpro_discount_lc) as best_seller_tpro_discount_lc,
        sum(tpro_booster_tpro_discount_lc) as tpro_booster_tpro_discount_lc,

        sum(best_seller_gmv_amount_lc) as best_seller_gmv_amount_lc,
        sum(tpro_booster_gmv_amount_lc) as tpro_booster_gmv_amount_lc,

        sum(best_seller_basket_amount_lc) as best_seller_basket_amount_lc,
        sum(tpro_booster_basket_amount_lc) as tpro_booster_basket_amount_lc,

        sum(best_seller_free_delivery_orders) as best_seller_free_delivery_orders,
        sum(tpro_booster_free_delivery_orders) as tpro_booster_free_delivery_orders

    from daily
    group by all

), final_booster as (
    select
        date_aggregation,
        country_code,
        date_trunc(order_date,day) as order_date,
        count(distinct if(best_seller_orders >> 0, customers, null)) as best_seller_customers,
        count(distinct if(tpro_booster_orders >> 0, customers, null)) as tpro_booster_customers,

        sum(best_seller_orders) as best_seller_orders,
        sum(tpro_booster_orders) as tpro_booster_orders,

        count(distinct if(booster_entrypoint_acquisition is TRUE, customers, null)) as acquisition_through_booster_customers,
        count(distinct if(is_first_tpro_order is TRUE, customers, null)) as is_first_tpro_order_customers,

        sum(talabat_paid_tpro_booster_discount_amount_lc) as talabat_paid_tpro_booster_discount_amount_lc,
        sum(vendor_paid_tpro_booster_discount_amount_lc) as vendor_paid_tpro_booster_discount_amount_lc,

        sum(best_seller_discount_amount_lc) as best_seller_discount_amount_lc,
        sum(tpro_booster_incentive_discount_amount_lc) as tpro_booster_incentive_discount_amount_lc,
        sum(tpro_booster_discount_amount_lc) as tpro_booster_discount_amount_lc,

        sum(best_seller_tpro_discount_lc) as best_seller_tpro_discount_lc,
        sum(tpro_booster_tpro_discount_lc) as tpro_booster_tpro_discount_lc,

        sum(best_seller_gmv_amount_lc) as best_seller_gmv_amount_lc,
        sum(tpro_booster_gmv_amount_lc) as tpro_booster_gmv_amount_lc,

        sum(best_seller_basket_amount_lc) as best_seller_basket_amount_lc,
        sum(tpro_booster_basket_amount_lc) as tpro_booster_basket_amount_lc,

        sum(best_seller_free_delivery_orders) as best_seller_free_delivery_orders,
        sum(tpro_booster_free_delivery_orders) as tpro_booster_free_delivery_orders
    from daily
    group by all

    union all

    select *
    from weekly
    group by all

    union all

    select * from monthly
    group by all

), daily_users as (
    select
        "Daily" as date_aggregation,
        country_code,
        date,
        account_id as all_tpro_customers,
        sum(order_count) as all_orders_pro_customers
        from `tlb-data-prod.data_platform.fct_subscription_cohort_daily` as o
    where is_churned is false
    and is_billing_retry is false
    and date >>= '2024-07-21'

    group by all

), weekly_users as (
    select
        "Weekly" as date_aggregation,
        country_code,
        date_trunc(date,week) as date,
        count(distinct   all_tpro_customers) as all_tpro_customers,
        sum(all_orders_pro_customers) all_orders_pro_customers
    from daily_users
    group by all

), monthly_users as (
    select
        "Monthly" as date_aggregation,
        country_code,
        date_trunc(date,month) as date,
        count(distinct all_tpro_customers) as all_tpro_customers,
        sum(all_orders_pro_customers) all_orders_pro_customers
    from daily_users
    group by all

), final_users as (
    select
        date_aggregation,
        country_code,
        date,
        count(distinct all_tpro_customers) all_tpro_customers,
        sum(all_orders_pro_customers) as all_orders_pro_customers
    from daily_users
    group by all

    union all

    select *
    from weekly_users


    union all

    select *
    from monthly_users

)


select f.*
     , all_tpro_customers
     , all_orders_pro_customers
from final_booster as f
inner join final_users as u on f.date_aggregation=u.date_aggregation and f.country_code=u.country_code and f.order_date=u.date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
