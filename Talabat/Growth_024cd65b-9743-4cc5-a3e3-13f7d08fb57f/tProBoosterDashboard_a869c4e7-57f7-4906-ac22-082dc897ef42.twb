          </datasources>
          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.1b0gtf309wmzld11gvplb0rtl3g0'>
            <column caption='Average Best Seller savings per Customer' datatype='real' name='[Average Booster savings per Customer (copy)_3834744763921092609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tpro_booster_incentive_discount_amount_lc]) - SUM([tpro_booster_discount_amount_lc]))&#10;/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Free Delivery savings per Customer' datatype='real' name='[Average Booster savings per Customer (copy)_3834744763921362946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_tpro_discount_lc])/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Best Seller savings per Order' datatype='real' name='[Average Booster savings per Order (copy)_3834744763922059267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tpro_booster_incentive_discount_amount_lc]) - SUM([tpro_booster_discount_amount_lc]))&#10;/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average Free Delivery savings per Order' datatype='real' name='[Average Booster savings per Order (copy)_3834744763922493444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_tpro_discount_lc])/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average Booster savings per Customer' datatype='real' name='[Average Booster savings per Order (copy)_913949296780337157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_discount_amount_lc])/sum([tpro_booster_customers])' />
            </column>
            <column caption='Average Savings per customer' datatype='real' name='[Average Savings per Boosted Order (copy)_913949297420939277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tpro_booster_tpro_discount_lc])+SUM([tpro_booster_incentive_discount_amount_lc]))/&#13;&#10;SUM([tpro_booster_customers])' />
            </column>
            <column caption='Average Booster savings per Order' datatype='real' name='[Calculation_913949296779644932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_booster_discount_amount_lc])/SUM([tpro_booster_orders])' />
            </column>
            <column caption='Average total savings per Order' datatype='real' name='[Calculation_913949296781238278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([tpro_booster_tpro_discount_lc])+SUM([tpro_booster_incentive_discount_amount_lc])))&#10;/&#10;sum([tpro_booster_orders])' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Frequency' datatype='string' name='[date_aggregation]' role='dimension' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_aggregation]' derivation='None' name='[none:date_aggregation:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
