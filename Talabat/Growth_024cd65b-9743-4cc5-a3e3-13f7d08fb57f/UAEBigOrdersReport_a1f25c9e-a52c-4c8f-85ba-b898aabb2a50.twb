    <datasource caption='Custom SQL Query (bq_logs)' inline='true' name='federated.095j1gv03276u91alaasq18yvppv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.132fz1a04lq0ix1evb7bp0ipq5eu'>
            <connection CATALOG='tlb-datateam-analysis-6343' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-datateam-analysis' schema='bq_logs' server-oauth='server-custom' username='weichun.chang@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.132fz1a04lq0ix1evb7bp0ipq5eu' name='Custom SQL Query' type='text'>select o.content.order_id
    , o.created_date order_date
    , chain_name_en
    , name_en
    --, s.status
    , o.content.vendor.id
    , is_tgo
    , vertical
    , content.`order`.order_value
    --, b.content.order_values.total_order_value_gross
    , concat(o.content.customer.profile.first_name, &apos; &apos;, o.content.customer.profile.last_name) Customer_Name
    , o.content.customer.profile.phone
    , content.`order`.`items`[SAFE_OFFSET(0)].quantity
  from `fulfillment-dwh-production.curated_data_shared_data_stream.order_stream` o
    inner join `tlb-data-prod.data_platform.dim_vendor` v
      on o.content.vendor.id = cast(v.vendor_id as string)
        and v.vertical in (&apos;food&apos;,&apos;electronics&apos;)
--    inner join `tlb-data-prod.data_platform.fct_order_status_transaction` s
--      on content.order_id = cast(s.order_id as string)
  ---inner join `fulfillment-dwh-production.curated_data_shared_data_stream.billing_order_stream` b 
  --    on cast(oi.order_id as string) = cast(b.content.order_id as string)
  --      and date(b.timestamp) &gt;&gt;= current_date - interval 1 day
  where 1=1
    --and b.content.order_values.total_order_value_gross &gt;&gt;= 350
    and (content.`order`.order_value &gt;&gt;= 350
    or content.`order`.`items`[SAFE_OFFSET(0)].quantity &gt;&gt;= 14)
    and o.content.country_code = &apos;AE&apos;
    and o.created_date = current_date
    and o.content.delivery.location.city in (&apos;Dubai&apos;,&apos;Abu Dhabi&apos;)
  group by all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.132fz1a04lq0ix1evb7bp0ipq5eu' name='Custom SQL Query' type='text'>select o.content.order_id
    , o.created_date order_date
    , chain_name_en
    , name_en
    --, s.status
    , o.content.vendor.id
    , is_tgo
    , vertical
    , content.`order`.order_value
    --, b.content.order_values.total_order_value_gross
    , concat(o.content.customer.profile.first_name, &apos; &apos;, o.content.customer.profile.last_name) Customer_Name
    , o.content.customer.profile.phone
    , content.`order`.`items`[SAFE_OFFSET(0)].quantity
  from `fulfillment-dwh-production.curated_data_shared_data_stream.order_stream` o
    inner join `tlb-data-prod.data_platform.dim_vendor` v
      on o.content.vendor.id = cast(v.vendor_id as string)
        and v.vertical in (&apos;food&apos;,&apos;electronics&apos;)
--    inner join `tlb-data-prod.data_platform.fct_order_status_transaction` s
--      on content.order_id = cast(s.order_id as string)
  ---inner join `fulfillment-dwh-production.curated_data_shared_data_stream.billing_order_stream` b 
  --    on cast(oi.order_id as string) = cast(b.content.order_id as string)
  --      and date(b.timestamp) &gt;&gt;= current_date - interval 1 day
  where 1=1
    --and b.content.order_values.total_order_value_gross &gt;&gt;= 350
    and (content.`order`.order_value &gt;&gt;= 350
    or content.`order`.`items`[SAFE_OFFSET(0)].quantity &gt;&gt;= 14)
    and o.content.country_code = &apos;AE&apos;
    and o.created_date = current_date
    and o.content.delivery.location.city in (&apos;Dubai&apos;,&apos;Abu Dhabi&apos;)
  group by all</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
