      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9A5D7BA99C3C4A9090AE54238E11B42A'>
            <properties context=''>
              <relation connection='bigquery.0vay52c1hulqvp1g0zci61plbvnz (copy 3)' name='Custom SQL Query' type='text'><![CDATA[-- All below data is extracted only for Pro Regular or Pro Family plans

-- Splitting the repeat customers into free trial and paid users
with active_eom as 
(select 
a.country, 
date_trunc(iso_date, MONTH) as iso_month,
a.account_id,
subscription_id,
c.plan_group,
case when a.subscription_state = 'GRACE PERIOD' then a.prev_subs_type else a.subscription_state END as subs_type,
c.plan_duration, 
c.plan_type, 
c.plan_name,
a.end_date,
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from  
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(a.start_date) << DATE(CURRENT_DATE) 
and date_trunc(iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
and (case when iso_date = (case when date_trunc(iso_date, MONTH) = date_trunc(CURRENT_DATE, MONTH) then CURRENT_DATE - 1 else last_day(date_trunc(iso_date, MONTH)) END) /*and a.subscription_state <<>> 'BILLING RETRY'*/ then true END) = true
group by ALL),

-- Last month active customers movement
active_lm_but_moved as 
(select 
a.country, 
a.iso_month,
a.plan_type, 
a.plan_duration,
count(distinct a.account_id) as active_lm,
count(distinct case when a.subs_type = 'FREE TRIAL' then a.account_id END) as active_lm_ft,
count(distinct case when a.subs_type = 'PAID' then a.account_id END) as active_lm_paid,

-- Stayed within the same plan type and plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_active_same,
-- Stayed within the same plan type but changed plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_active_diff,
-- Changed the plan type and moved to 1M in the new plan type
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days <<>> 31 then b.account_id END) as active_lm_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as active_lm_reg_active_family_12m,

-- Checking whether they continue to be active on free trial or paid
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_active,
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_active,

-- Checking whether there are paid users up for renewal in this month
count(distinct case when a.subs_type = 'PAID' and DATE_TRUNC(DATE_ADD(date(a.end_date), INTERVAL 1 DAY), MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then a.account_id END) as paid_up_for_renewal,

-- capturing all churned occurences
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as active_lm_churned,
count(distinct case when b.account_id is null and a.subs_type = 'FREE TRIAL' then a.account_Id END) as active_lm_ft_churned,
count(distinct case when b.account_id is null and a.subs_type = 'PAID' then a.account_Id END) as active_lm_paid_churned,

-- Users continuing to be on free trial but entering grace period - considered in up for renewal calculation
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_gp,

-- Users continuing to be on free trial and not entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_stay,

-- Users staying on paid status throughout the month without renewing
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and a.subscription_id = b.subscription_id then b.account_id END) as active_lm_paid_stay,

-- Users staying on paid status throughout the month but entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and b.subscription_state = 'GRACE PERIOD' then b.account_id END) as active_lm_paid_gp

from active_eom as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then 
CURRENT_DATE - 1 else last_day(DATE_ADD(a.iso_month, INTERVAL 1 MONTH)) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id
where a.subs_type <<>> 'BILLING RETRY'
and (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL),

-- Getting the list of users who get access to second free trial (partnerships migration or winbacks retargeting).
-- Currently this is applicable only for Pro Regular plans
second_free_trial as 
(SELECT
    a.country,
    date_trunc(a.iso_date, MONTH) as start_month,
    a.account_id,
    a.subscription_state,
    pln.plan_group, 
    pln.plan_type,
    pln.plan_duration,
    pln.plan_name,
    CASE WHEN TRIM(JSON_VALUE(c.metadata, "$.migration.type")) = "BP_PLAN_TO_MONTHLY" THEN 1 ELSE 0 END AS is_partnership
FROM `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` a
INNER JOIN `tlb-data-prod.data_platform.dim_subscription_plan` as pln on a.plan_id = pln.plan_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_acquisition_daily` b
        ON a.country = b.country_code AND a.account_id = b.account_id AND a.iso_date = DATE(b.start_date)
    LEFT JOIN `tlb-data-prod.data_platform.fct_subscription_current` c
        ON a.subscriber_id = c.subscriber_id
    LEFT JOIN active_eom as d
        ON a.country = d.country AND a.account_id = d.account_id 
        AND DATE_ADD(DATE(date_trunc(a.start_date, MONTH)), INTERVAL -1 MONTH) = d.iso_month AND d.subs_type <<>> 'BILLING RETRY' AND pln.plan_group = d.plan_group
WHERE a.subscription_state = 'FREE TRIAL' AND b.account_id IS NULL AND d.account_id IS NULL AND a.iso_date = DATE(a.start_date)
    AND date_trunc(a.iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
    AND (CASE WHEN pln.plan_type = 'Pro Regular' THEN TRUE 
              WHEN pln.plan_type = 'Pro Family' and a.manager_account_id is NULL THEN TRUE END) = TRUE
    QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date DESC) = 1), 

-- The following status updates only for Pro Regular
second_free_trial_status AS (
    SELECT
        a.country,
        a.start_month,
        a.plan_duration,
        a.plan_type,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 THEN a.account_id END) AS renewed_from_partnerships,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 THEN a.account_id END) AS winback_target,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS renewed_from_partnerships_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS renewed_from_partnerships_active_diff,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days <<>> 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_12m,


        count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as renewed_from_partnerships_reg_active_family_1m,
count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as renewed_from_partnerships_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS renewed_from_partnerships_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.account_id IS NULL THEN a.account_Id END) AS renewed_from_partnerships_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS renewed_from_partnerships_moved_to_bt,

        count(distinct case when is_partnership = 1 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as renewed_from_partnerships_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS renewed_from_partnerships_active_stay,

                COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS winback_target_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS winback_target_active_diff,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS winback_target_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days <<>> 31 THEN a.account_id
        END) AS winback_target_active_diff_type_12m,


        count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winback_target_reg_active_family_1m,
count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as winback_target_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS winback_target_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.account_id IS NULL THEN a.account_Id END) AS winback_target_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS winback_target_moved_to_bt,

        count(distinct case when is_partnership = 0 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as winback_target_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS winback_target_active_stay

    FROM second_free_trial a
        LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` b
            ON a.country = b.country AND b.iso_date = (CASE WHEN DATE_TRUNC(CURRENT_DATE, MONTH) = a.start_month
                        THEN
                            CURRENT_DATE - 1
                    ELSE LAST_DAY(a.start_month)
                END) AND a.account_id = b.account_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_subscription_plan` pln
            ON b.plan_id = pln.plan_id
    GROUP BY ALL
),

acqns as
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.account_id, 
a.subscription_state,   
c.plan_type, 
c.plan_group, 
c.plan_name,
c.plan_duration, 
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from 
(SELECT
    country,
    account_id,
    subscription_state,
    start_date,
    plan_id,
    manager_account_id
FROM
    `tlb-data-prod.data_platform_rest_tables.subs_date_fix` as a 
QUALIFY ROW_NUMBER() OVER (PARTITION BY country, account_Id ORDER BY start_date) = 1) as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)),

-- Acquisitions movement has been studied
acqns_status as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
count(distinct a.account_id) as acqns_reg,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' 
then a.account_id END) as acqns_reg_active_same,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'  
then a.account_id END) as acqns_reg_active_diff,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 31 then a.account_id END) as acqns_reg_active_diff_type_1m,
count(distinct case when a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days <<>> 31 then a.account_id END) as acqns_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as acqns_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as acqns_reg_active_family_12m,

count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as acqns_reg_moved_to_lite,
count(distinct case when b.account_id is null then a.account_Id END) as acqns_reg_churned,
count(distinct case when b.subscription_state = 'BILLING RETRY' then a.account_Id END) as acqns_reg_moved_to_bt,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_gp,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_stay,

from acqns as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE

group by ALL),

-- Extracting the list of users who came back to Pro
paid as 
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.start_date,
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
a.subscription_payment_id,
c.plan_type, 
c.plan_group,
c.plan_name, 
c.plan_duration,
case when c.plan_type = 'Pro Family' then 
     case when a.manager_account_id is null then 'Manager'
          else 'Member' END END as family_sub_type
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0 
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)
AND (CASE WHEN c.plan_type = 'Pro Regular' AND subscription_state = 'PAID' THEN TRUE
    WHEN c.plan_type = 'Pro Family' then 
         case when a.manager_account_id is null and subscription_state = 'PAID' THEN TRUE
              when a.manager_account_id is not null and subscription_state IN ('FREE TRIAL', 'PAID') THEN TRUE END
    WHEN c.plan_group = 'Lite' AND subscription_state IN ('FREE', 'FREE TRIAL') THEN TRUE
END) = TRUE
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date) = 1),

winbacks as 
(select 
a.country, 
a.start_month, 
a.account_id,
a.prev_plan_id,
prev_subs_type_gp,
a.plan_group,
a.plan_type, 
a.plan_name,
a.plan_duration,
a.subscription_payment_id,
a.family_sub_type
from paid as a 
left join active_eom as b 
on a.country = b.country and a.account_id = b.account_id 
and DATE_ADD(a.start_month, INTERVAL -1 MONTH) = b.iso_month and b.subs_type <<>> 'BILLING RETRY' and a.plan_group = b.plan_group
-- and (b.family_sub_type = 'Manager' or b.family_sub_type is null)
left join acqns as c
on a.country = c.country and a.account_id = c.account_id and 
a.start_month = c.start_month and a.plan_group = c.plan_group
left JOIN second_free_trial d
ON a.country = d.country AND a.account_id = d.account_id
AND a.start_month = d.start_month and a.plan_group = d.plan_group
where b.account_id is null and c.account_id is null and d.account_id is null),

winbacks_split as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
COUNT(DISTINCT CASE WHEN d.requester IN (100, 300) THEN a.account_id END) AS winbacks_reg,
count(distinct CASE WHEN d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as winbacks_reg_active_same,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
then a.account_id END) as winbacks_reg_active_diff,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as winbacks_reg_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days <<>> 31
then a.account_id END) as winbacks_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winbacks_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as winbacks_reg_active_family_12m,

count(distinct case when d.requester IN (100, 300) and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_lite,
count(distinct case when d.requester IN (100, 300) AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_bt,
count(distinct case when d.requester IN (100, 300) AND b.account_id is null then a.account_Id END) as winbacks_reg_churned,

COUNT(DISTINCT CASE WHEN d.requester = 200 THEN a.account_id END) AS bt,
count(distinct CASE WHEN d.requester = 200
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as bt_active_same,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
then a.account_id END) as bt_active_diff,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as bt_active_diff_type_1m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days <<>> 31
then a.account_id END) as bt_active_diff_type_12m,

count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as bt_active_family_1m,
count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days <<>> 31 then b.account_id END) as bt_active_family_12m,

count(distinct case when d.requester = 200 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as bt_moved_to_lite,
count(distinct case when d.requester = 200 AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as bt_moved_to_bt,
count(distinct case when d.requester = 200 AND b.account_id is null then a.account_Id END) as bt_churned

from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
inner join `tlb-data-prod.data_platform_subscription.PaymentsHistory` as c
on a.subscription_payment_id = c.id
inner join `tlb-data-prod.data_platform_subscription.SubscriptionTransactions` as d
on c.subscriptiontransactionid = d.id

where (case when a.plan_type = 'Pro Family' and a.family_sub_type = 'Manager' then true   
  when a.plan_type = 'Pro Regular' then true END) = TRUE
group by ALL),

active_data as 
(select
country, 
iso_month,
plan_type,
plan_duration,
count(distinct case when subs_type <<>> 'BILLING RETRY' THEN account_id END) as active_users,
count(distinct case when subs_type = 'FREE TRIAL' THEN account_id END) as active_users_ft,
count(distinct case when subs_type = 'PAID' THEN account_id END) as active_users_paid,
count(distinct case when subs_type = 'BILLING RETRY' then account_id END) as bt_users
from active_eom
where (case when plan_type = 'Pro Family' then 
         case when family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL)

select 
g.country,
g.iso_month, 
g.plan_type,
g.plan_duration,
a.active_users,
a.active_users_ft,
a.active_users_paid,
a.bt_users,
b.acqns_reg,
CAST(0 AS INT64) as acqns_lite,
b.acqns_reg_active_same, 
b.acqns_reg_active_diff,
b.acqns_reg_active_diff_type_1m,
b.acqns_reg_active_diff_type_12m,
b.acqns_reg_active_family_1m,
b.acqns_reg_active_family_12m,
b.acqns_reg_moved_to_lite,
b.acqns_reg_moved_to_bt,
b.acqns_reg_churned,
b.acqns_reg_active_gp,
b.acqns_reg_active_stay,
c.winbacks_reg,
c.winbacks_reg_active_same,
c.winbacks_reg_active_diff, 
c.winbacks_reg_active_diff_type_1m, 
c.winbacks_reg_active_diff_type_12m, 
c.winbacks_reg_active_family_1m,
c.winbacks_reg_active_family_12m,
c.winbacks_reg_moved_to_lite,
c.winbacks_reg_moved_to_bt,
c.winbacks_reg_churned,
c.bt,
c.bt_active_same,
c.bt_active_diff, 
c.bt_active_diff_type_1m,
c.bt_active_diff_type_12m,
c.bt_active_family_1m,
c.bt_active_family_12m,
c.bt_moved_to_lite,
c.bt_moved_to_bt,
c.bt_churned,
f.active_lm,
f.active_lm_active_same,
f.active_lm_active_diff, 
f.active_lm_active_diff_type_1m, 
f.active_lm_active_diff_type_12m, 
f.active_lm_reg_active_family_1m,
f.active_lm_reg_active_family_12m,
f.active_lm_ft_active,
f.active_lm_paid_active,
f.paid_up_for_renewal,
f.active_lm_moved_to_lite,
f.active_lm_ft_moved_to_lite,
f.active_lm_paid_moved_to_lite,
f.active_lm_moved_to_bt,
f.active_lm_ft_moved_to_bt,
f.active_lm_paid_moved_to_bt,
f.active_lm_churned,
f.active_lm_ft_churned,
f.active_lm_paid_churned,
f.active_lm_ft_stay,
f.active_lm_ft_gp,
f.active_lm_paid_stay,
f.active_lm_paid_gp,
g.active_users as active_nm,
h.renewed_from_partnerships,
h.renewed_from_partnerships_active_same,
h.renewed_from_partnerships_active_diff,
h.renewed_from_partnerships_active_diff_type_1m,
h.renewed_from_partnerships_active_diff_type_12m,
h.renewed_from_partnerships_reg_active_family_1m,
h.renewed_from_partnerships_reg_active_family_12m,
h.renewed_from_partnerships_moved_to_lite,
h.renewed_from_partnerships_churned,
h.renewed_from_partnerships_moved_to_bt,
h.renewed_from_partnerships_active_gp,
h.renewed_from_partnerships_active_stay,
h.winback_target,
h.winback_target_active_same,
h.winback_target_active_diff,
h.winback_target_active_diff_type_1m,
h.winback_target_active_diff_type_12m,
h.winback_target_reg_active_family_1m,
h.winback_target_reg_active_family_12m,
h.winback_target_moved_to_lite,
h.winback_target_churned,
h.winback_target_moved_to_bt,
h.winback_target_active_gp,
h.winback_target_active_stay,
g.bt_users as bt_users_nm
from active_data as g 
left join acqns_status as b
on g.country = b.country and g.iso_month = b.start_month
and g.plan_duration = b.plan_duration and g.plan_type = b.plan_type
left join winbacks_split as c 
on g.country = c.country and g.iso_month = c.start_month 
and g.plan_duration = c.plan_duration and g.plan_type = c.plan_type
left join active_lm_but_moved as f 
on g.country = f.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = f.iso_month
and g.plan_duration = f.plan_duration and g.plan_type = f.plan_type
left join active_data as a
on g.country = a.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = a.iso_month
and g.plan_duration = a.plan_duration and g.plan_type = a.plan_type
left join second_free_trial_status as h 
on g.country = h.country and g.iso_month = h.start_month
and g.plan_duration = h.plan_duration and g.plan_type = h.plan_type
where  g.iso_month <<= 
date_trunc(CURRENT_DATE, MONTH)
order by country, iso_month, plan_duration]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='tPro Projections Actuals KW' inline='true' name='federated.09jaajv1d9imf51a6aiy11w46y2b (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0vay52c1hulqvp1g0zci61plbvnz (copy)'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='' server-oauth='' username='aravind.jayachandran@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vay52c1hulqvp1g0zci61plbvnz (copy)' name='Custom SQL Query' type='text'><![CDATA[-- Splitting the repeat customers into free trial and paid users
with active_eom as 
(select 
a.country, 
date_trunc(iso_date, MONTH) as iso_month,
a.account_id,
subscription_id,
c.plan_group,
case when a.subscription_state = 'GRACE PERIOD' then a.prev_subs_type else a.subscription_state END as subs_type,
c.plan_duration, 
c.plan_type, 
c.plan_name,
a.end_date,
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from  
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(a.start_date) << DATE(CURRENT_DATE) 
and date_trunc(iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
and (case when iso_date = (case when date_trunc(iso_date, MONTH) = date_trunc(CURRENT_DATE, MONTH) then CURRENT_DATE - 1 else last_day(date_trunc(iso_date, MONTH)) END) /*and a.subscription_state <<>> 'BILLING RETRY'*/ then true END) = true
group by ALL),

-- Last month active customers movement
active_lm_but_moved as 
(select 
a.country, 
a.iso_month,
a.plan_type, 
a.plan_duration,
a.plan_name,
count(distinct a.account_id) as active_lm,
count(distinct case when a.subs_type = 'FREE TRIAL' then a.account_id END) as active_lm_ft,
count(distinct case when a.subs_type = 'PAID' then a.account_id END) as active_lm_paid,

-- Stayed within the same plan type and plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_active_same,
-- Stayed within the same plan type but changed plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 then b.account_id END) as active_lm_active_diff_1m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 then b.account_id END) as active_lm_active_diff_6m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 then b.account_id END) as active_lm_active_diff_12m,
-- Changed the plan type and moved to 1M in the new plan type
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 180 then b.account_id END) as active_lm_active_diff_type_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 365 then b.account_id END) as active_lm_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as active_lm_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as active_lm_reg_active_family_12m,

-- Checking whether they continue to be active on free trial or paid
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_active,
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_active,

-- Checking whether there are paid users up for renewal in this month
count(distinct case when a.subs_type = 'PAID' and DATE_TRUNC(DATE_ADD(date(a.end_date), INTERVAL 1 DAY), MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then a.account_id END) as paid_up_for_renewal,

-- capturing all churned occurences
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as active_lm_churned,
count(distinct case when b.account_id is null and a.subs_type = 'FREE TRIAL' then a.account_Id END) as active_lm_ft_churned,
count(distinct case when b.account_id is null and a.subs_type = 'PAID' then a.account_Id END) as active_lm_paid_churned,

-- Users continuing to be on free trial but entering grace period - considered in up for renewal calculation
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_gp,

-- Users continuing to be on free trial and not entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_stay,

-- Users staying on paid status throughout the month without renewing
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and a.subscription_id = b.subscription_id then b.account_id END) as active_lm_paid_stay,

-- Users staying on paid status throughout the month but entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and b.subscription_state = 'GRACE PERIOD' then b.account_id END) as active_lm_paid_gp

from active_eom as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then 
CURRENT_DATE - 1 else last_day(DATE_ADD(a.iso_month, INTERVAL 1 MONTH)) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id
where a.subs_type <<>> 'BILLING RETRY'
and (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL),

second_free_trial as 
(SELECT
    a.country,
    date_trunc(a.iso_date, MONTH) as start_month,
    a.account_id,
    a.subscription_state,
    pln.plan_group, 
    pln.plan_type,
    pln.plan_duration,
    pln.plan_name,
    CASE WHEN TRIM(JSON_VALUE(c.metadata, "$.migration.type")) = "BP_PLAN_TO_MONTHLY" THEN 1 ELSE 0 END AS is_partnership
FROM `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` a
INNER JOIN `tlb-data-prod.data_platform.dim_subscription_plan` as pln on a.plan_id = pln.plan_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_acquisition_daily` b
        ON a.country = b.country_code AND a.account_id = b.account_id AND a.iso_date = DATE(b.start_date)
    LEFT JOIN `tlb-data-prod.data_platform.fct_subscription_current` c
        ON a.subscriber_id = c.subscriber_id
      LEFT JOIN active_eom as d
        ON a.country = d.country AND a.account_id = d.account_id 
        AND DATE_ADD(DATE(date_trunc(a.start_date, MONTH)), INTERVAL -1 MONTH) = d.iso_month AND d.subs_type <<>> 'BILLING RETRY' AND pln.plan_group = d.plan_group      
WHERE a.subscription_state = 'FREE TRIAL' AND b.account_id IS NULL AND d.account_id IS NULL AND a.iso_date = DATE(a.start_date)
    AND date_trunc(a.iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
    AND (CASE WHEN pln.plan_type = 'Pro Regular' THEN TRUE 
              WHEN pln.plan_type = 'Pro Family' and a.manager_account_id is NULL THEN TRUE END) = TRUE
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date DESC) = 1),

-- The following status updates only for Pro Regular
second_free_trial_status AS (
    SELECT
        a.country,
        a.start_month,
        a.plan_duration,
        a.plan_type,
        a.plan_name,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 THEN a.account_id END) AS renewed_from_partnerships,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 THEN a.account_id END) AS winback_target,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS renewed_from_partnerships_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_12m,


        count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as renewed_from_partnerships_reg_active_family_1m,
        count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as renewed_from_partnerships_reg_active_family_6m,
count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as renewed_from_partnerships_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS renewed_from_partnerships_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.account_id IS NULL THEN a.account_Id END) AS renewed_from_partnerships_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS renewed_from_partnerships_moved_to_bt,

        count(distinct case when is_partnership = 1 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as renewed_from_partnerships_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS renewed_from_partnerships_active_stay,

                COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS winback_target_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS winback_target_active_diff_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS winback_target_active_diff_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS winback_target_active_diff_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS winback_target_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS winback_target_active_diff_type_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS winback_target_active_diff_type_12m,


        count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winback_target_reg_active_family_1m,
        count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as winback_target_reg_active_family_6m,
count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as winback_target_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS winback_target_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.account_id IS NULL THEN a.account_Id END) AS winback_target_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS winback_target_moved_to_bt,

        count(distinct case when is_partnership = 0 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as winback_target_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS winback_target_active_stay

    FROM second_free_trial a
        LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` b
            ON a.country = b.country AND b.iso_date = (CASE WHEN DATE_TRUNC(CURRENT_DATE, MONTH) = a.start_month
                        THEN
                            CURRENT_DATE - 1
                    ELSE LAST_DAY(a.start_month)
                END) AND a.account_id = b.account_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_subscription_plan` pln
            ON b.plan_id = pln.plan_id
    GROUP BY ALL
),

acqns as
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.account_id, 
a.subscription_state,   
c.plan_type, 
c.plan_group, 
c.plan_name,
c.plan_duration, 
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from 
(SELECT
    country,
    account_id,
    subscription_state,
    start_date,
    plan_id,
    manager_account_id
FROM
    `tlb-data-prod.data_platform_rest_tables.subs_date_fix` as a 
QUALIFY ROW_NUMBER() OVER (PARTITION BY country, account_Id ORDER BY start_date) = 1) as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)),

-- Acquisitions movement has been studied
acqns_status as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
a.plan_name,
count(distinct a.account_id) as acqns_reg,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' 
then a.account_id END) as acqns_reg_active_same,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31
then a.account_id END) as acqns_reg_active_diff_1m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180
then a.account_id END) as acqns_reg_active_diff_6m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365
then a.account_id END) as acqns_reg_active_diff_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 31 then a.account_id END) as acqns_reg_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 180 then a.account_id END) as acqns_reg_active_diff_type_6m,
count(distinct case when a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 365 then a.account_id END) as acqns_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as acqns_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as acqns_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as acqns_reg_active_family_12m,

count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as acqns_reg_moved_to_lite,
count(distinct case when b.account_id is null then a.account_Id END) as acqns_reg_churned,
count(distinct case when b.subscription_state = 'BILLING RETRY' then a.account_Id END) as acqns_reg_moved_to_bt,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_gp,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_stay,

from acqns as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE

group by ALL),

-- Extracting the list of users who came back to Pro
paid as 
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.start_date,
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
a.subscription_payment_id,
c.plan_type, 
c.plan_group,
c.plan_name, 
c.plan_duration,
case when c.plan_type = 'Pro Family' then 
     case when a.manager_account_id is null then 'Manager'
          else 'Member' END END as family_sub_type
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0 
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)
AND (CASE WHEN c.plan_type = 'Pro Regular' AND subscription_state = 'PAID' THEN TRUE
    WHEN c.plan_type = 'Pro Family' then 
         case when a.manager_account_id is null and subscription_state = 'PAID' THEN TRUE
              when a.manager_account_id is not null and subscription_state IN ('FREE TRIAL', 'PAID') THEN TRUE END
    WHEN c.plan_group = 'Lite' AND subscription_state IN ('FREE', 'FREE TRIAL') THEN TRUE
END) = TRUE
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date) = 1),

winbacks as 
(select 
a.country, 
a.start_month, 
a.account_id,
a.prev_plan_id,
prev_subs_type_gp,
a.plan_group,
a.plan_type, 
a.plan_name,
a.plan_duration,
a.subscription_payment_id,
a.family_sub_type
from paid as a 
left join active_eom as b 
on a.country = b.country and a.account_id = b.account_id 
and DATE_ADD(a.start_month, INTERVAL -1 MONTH) = b.iso_month and b.subs_type <<>> 'BILLING RETRY' and a.plan_group = b.plan_group
-- and (b.family_sub_type = 'Manager' or b.family_sub_type is null)
left join acqns as c
on a.country = c.country and a.account_id = c.account_id and 
a.start_month = c.start_month and a.plan_group = c.plan_group
left JOIN second_free_trial d
ON a.country = d.country AND a.account_id = d.account_id
AND a.start_month = d.start_month and a.plan_group = d.plan_group
where b.account_id is null and c.account_id is null and d.account_id is null),

winbacks_split as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
a.plan_name,
COUNT(DISTINCT CASE WHEN d.requester IN (100, 300) THEN a.account_id END) AS winbacks_reg,
count(distinct CASE WHEN d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as winbacks_reg_active_same,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as winbacks_reg_active_diff_1m,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as winbacks_reg_active_diff_6m,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as winbacks_reg_active_diff_12m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as winbacks_reg_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as winbacks_reg_active_diff_type_6m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as winbacks_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winbacks_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as winbacks_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as winbacks_reg_active_family_12m,

count(distinct case when d.requester IN (100, 300) and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_lite,
count(distinct case when d.requester IN (100, 300) AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_bt,
count(distinct case when d.requester IN (100, 300) AND b.account_id is null then a.account_Id END) as winbacks_reg_churned,

COUNT(DISTINCT CASE WHEN d.requester = 200 THEN a.account_id END) AS bt,
count(distinct CASE WHEN d.requester = 200
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as bt_active_same,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as bt_active_diff_1m,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as bt_active_diff_6m,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as bt_active_diff_12m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as bt_active_diff_type_1m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as bt_active_diff_type_6m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as bt_active_diff_type_12m,

count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as bt_active_family_1m,
count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as bt_active_family_6m,
count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as bt_active_family_12m,

count(distinct case when d.requester = 200 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as bt_moved_to_lite,
count(distinct case when d.requester = 200 AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as bt_moved_to_bt,
count(distinct case when d.requester = 200 AND b.account_id is null then a.account_Id END) as bt_churned

from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
inner join `tlb-data-prod.data_platform_subscription.PaymentsHistory` as c
on a.subscription_payment_id = c.id
inner join `tlb-data-prod.data_platform_subscription.SubscriptionTransactions` as d
on c.subscriptiontransactionid = d.id

where (case when a.plan_type = 'Pro Family' and a.family_sub_type = 'Manager' then true   
  when a.plan_type = 'Pro Regular' then true END) = TRUE
group by ALL),

active_data as 
(select
country, 
iso_month,
plan_type,
plan_duration,
plan_name,
count(distinct case when subs_type <<>> 'BILLING RETRY' THEN account_id END) as active_users,
count(distinct case when subs_type = 'FREE TRIAL' THEN account_id END) as active_users_ft,
count(distinct case when subs_type = 'PAID' THEN account_id END) as active_users_paid,
count(distinct case when subs_type = 'BILLING RETRY' then account_id END) as bt_users
from active_eom
where (case when plan_type = 'Pro Family' then 
         case when family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL)

select 
g.country,
g.iso_month, 
g.plan_type,
g.plan_duration,
g.plan_name,
a.active_users,
a.active_users_ft,
a.active_users_paid,
a.bt_users,
b.acqns_reg,
CAST(0 AS INT64) as acqns_lite,
b.acqns_reg_active_same, 
b.acqns_reg_active_diff_1m,
b.acqns_reg_active_diff_6m,
b.acqns_reg_active_diff_12m,
b.acqns_reg_active_diff_type_1m,
b.acqns_reg_active_diff_type_6m,
b.acqns_reg_active_diff_type_12m,
b.acqns_reg_active_family_1m,
b.acqns_reg_active_family_6m,
b.acqns_reg_active_family_12m,
b.acqns_reg_moved_to_lite,
b.acqns_reg_moved_to_bt,
b.acqns_reg_churned,
b.acqns_reg_active_gp,
b.acqns_reg_active_stay,
c.winbacks_reg,
c.winbacks_reg_active_same,
c.winbacks_reg_active_diff_1m,
c.winbacks_reg_active_diff_6m,
c.winbacks_reg_active_diff_12m, 
c.winbacks_reg_active_diff_type_1m, 
c.winbacks_reg_active_diff_type_6m, 
c.winbacks_reg_active_diff_type_12m, 
c.winbacks_reg_active_family_1m,
c.winbacks_reg_active_family_6m,
c.winbacks_reg_active_family_12m,
c.winbacks_reg_moved_to_lite,
c.winbacks_reg_moved_to_bt,
c.winbacks_reg_churned,
c.bt,
c.bt_active_same,
c.bt_active_diff_1m, 
c.bt_active_diff_6m,
c.bt_active_diff_12m,
c.bt_active_diff_type_1m,
c.bt_active_diff_type_6m,
c.bt_active_diff_type_12m,
c.bt_active_family_1m,
c.bt_active_family_6m,
c.bt_active_family_12m,
c.bt_moved_to_lite,
c.bt_moved_to_bt,
c.bt_churned,
f.active_lm,
f.active_lm_active_same,
f.active_lm_active_diff_1m, 
f.active_lm_active_diff_6m,
f.active_lm_active_diff_12m,
f.active_lm_active_diff_type_1m, 
f.active_lm_active_diff_type_6m,
f.active_lm_active_diff_type_12m, 
f.active_lm_reg_active_family_1m,
f.active_lm_reg_active_family_6m,
f.active_lm_reg_active_family_12m,
f.active_lm_ft_active,
f.active_lm_paid_active,
f.paid_up_for_renewal,
f.active_lm_moved_to_lite,
f.active_lm_ft_moved_to_lite,
f.active_lm_paid_moved_to_lite,
f.active_lm_moved_to_bt,
f.active_lm_ft_moved_to_bt,
f.active_lm_paid_moved_to_bt,
f.active_lm_churned,
f.active_lm_ft_churned,
f.active_lm_paid_churned,
f.active_lm_ft_stay,
f.active_lm_ft_gp,
f.active_lm_paid_stay,
f.active_lm_paid_gp,
g.active_users as active_nm,
h.renewed_from_partnerships,
h.renewed_from_partnerships_active_same,
h.renewed_from_partnerships_active_diff_1m,
h.renewed_from_partnerships_active_diff_6m,
h.renewed_from_partnerships_active_diff_12m,
h.renewed_from_partnerships_active_diff_type_1m,
h.renewed_from_partnerships_active_diff_type_6m,
h.renewed_from_partnerships_active_diff_type_12m,
h.renewed_from_partnerships_reg_active_family_1m,
h.renewed_from_partnerships_reg_active_family_6m,
h.renewed_from_partnerships_reg_active_family_12m,
h.renewed_from_partnerships_moved_to_lite,
h.renewed_from_partnerships_churned,
h.renewed_from_partnerships_moved_to_bt,
h.renewed_from_partnerships_active_gp,
h.renewed_from_partnerships_active_stay,
h.winback_target,
h.winback_target_active_same,
h.winback_target_active_diff_1m,
h.winback_target_active_diff_6m,
h.winback_target_active_diff_12m,
h.winback_target_active_diff_type_1m,
h.winback_target_active_diff_type_6m,
h.winback_target_active_diff_type_12m,
h.winback_target_reg_active_family_1m,
h.winback_target_reg_active_family_6m,
h.winback_target_reg_active_family_12m,
h.winback_target_moved_to_lite,
h.winback_target_churned,
h.winback_target_moved_to_bt,
h.winback_target_active_gp,
h.winback_target_active_stay,
g.bt_users as bt_users_nm
from active_data as g 
left join acqns_status as b
on g.country = b.country and g.iso_month = b.start_month
and g.plan_duration = b.plan_duration and g.plan_type = b.plan_type and g.plan_name = b.plan_name
left join winbacks_split as c 
on g.country = c.country and g.iso_month = c.start_month 
and g.plan_duration = c.plan_duration and g.plan_type = c.plan_type and g.plan_name = c.plan_name
left join active_lm_but_moved as f 
on g.country = f.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = f.iso_month
and g.plan_duration = f.plan_duration and g.plan_type = f.plan_type and g.plan_name = f.plan_name
left join active_data as a
on g.country = a.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = a.iso_month
and g.plan_duration = a.plan_duration and g.plan_type = a.plan_type and g.plan_name = a.plan_name
left join second_free_trial_status as h 
on g.country = h.country and g.iso_month = h.start_month
and g.plan_duration = h.plan_duration and g.plan_type = h.plan_type and g.plan_name = h.plan_name
where  g.iso_month <<= 
date_trunc(CURRENT_DATE, MONTH)
order by country, iso_month, plan_duration, plan_name]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vay52c1hulqvp1g0zci61plbvnz (copy)' name='Custom SQL Query' type='text'><![CDATA[-- Splitting the repeat customers into free trial and paid users
with active_eom as 
(select 
a.country, 
date_trunc(iso_date, MONTH) as iso_month,
a.account_id,
subscription_id,
c.plan_group,
case when a.subscription_state = 'GRACE PERIOD' then a.prev_subs_type else a.subscription_state END as subs_type,
c.plan_duration, 
c.plan_type, 
c.plan_name,
a.end_date,
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from  
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(a.start_date) << DATE(CURRENT_DATE) 
and date_trunc(iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
and (case when iso_date = (case when date_trunc(iso_date, MONTH) = date_trunc(CURRENT_DATE, MONTH) then CURRENT_DATE - 1 else last_day(date_trunc(iso_date, MONTH)) END) /*and a.subscription_state <<>> 'BILLING RETRY'*/ then true END) = true
group by ALL),

-- Last month active customers movement
active_lm_but_moved as 
(select 
a.country, 
a.iso_month,
a.plan_type, 
a.plan_duration,
a.plan_name,
count(distinct a.account_id) as active_lm,
count(distinct case when a.subs_type = 'FREE TRIAL' then a.account_id END) as active_lm_ft,
count(distinct case when a.subs_type = 'PAID' then a.account_id END) as active_lm_paid,

-- Stayed within the same plan type and plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_active_same,
-- Stayed within the same plan type but changed plan name
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 then b.account_id END) as active_lm_active_diff_1m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 then b.account_id END) as active_lm_active_diff_6m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 then b.account_id END) as active_lm_active_diff_12m,
-- Changed the plan type and moved to 1M in the new plan type
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 180 then b.account_id END) as active_lm_active_diff_type_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
AND pln.plan_duration_days = 365 then b.account_id END) as active_lm_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as active_lm_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as active_lm_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as active_lm_reg_active_family_12m,

-- Checking whether they continue to be active on free trial or paid
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_active,
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_active,

-- Checking whether there are paid users up for renewal in this month
count(distinct case when a.subs_type = 'PAID' and DATE_TRUNC(DATE_ADD(date(a.end_date), INTERVAL 1 DAY), MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then a.account_id END) as paid_up_for_renewal,

-- capturing all churned occurences
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_lite,
count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_lite,
count(distinct case when b.subscription_state = 'BILLING RETRY' then b.account_id END) as active_lm_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_moved_to_bt,
count(distinct case when b.subscription_state = 'BILLING RETRY' and a.subs_type = 'PAID' then b.account_id END) as active_lm_paid_moved_to_bt,
count(distinct case when b.account_id is null then a.account_Id END) as active_lm_churned,
count(distinct case when b.account_id is null and a.subs_type = 'FREE TRIAL' then a.account_Id END) as active_lm_ft_churned,
count(distinct case when b.account_id is null and a.subs_type = 'PAID' then a.account_Id END) as active_lm_paid_churned,

-- Users continuing to be on free trial but entering grace period - considered in up for renewal calculation
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_gp,

-- Users continuing to be on free trial and not entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'FREE TRIAL' then b.account_id END) as active_lm_ft_stay,

-- Users staying on paid status throughout the month without renewing
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and a.subscription_id = b.subscription_id then b.account_id END) as active_lm_paid_stay,

-- Users staying on paid status throughout the month but entering grace period
count(distinct case when a.plan_type = pln.plan_type and b.subscription_state <<>> 'BILLING RETRY'
and a.subs_type = (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) and a.subs_type = 'PAID' and b.subscription_state = 'GRACE PERIOD' then b.account_id END) as active_lm_paid_gp

from active_eom as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = DATE_ADD(a.iso_month, INTERVAL 1 MONTH) then 
CURRENT_DATE - 1 else last_day(DATE_ADD(a.iso_month, INTERVAL 1 MONTH)) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id
where a.subs_type <<>> 'BILLING RETRY'
and (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL),

second_free_trial as 
(SELECT
    a.country,
    date_trunc(a.iso_date, MONTH) as start_month,
    a.account_id,
    a.subscription_state,
    pln.plan_group, 
    pln.plan_type,
    pln.plan_duration,
    pln.plan_name,
    CASE WHEN TRIM(JSON_VALUE(c.metadata, "$.migration.type")) = "BP_PLAN_TO_MONTHLY" THEN 1 ELSE 0 END AS is_partnership
FROM `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` a
INNER JOIN `tlb-data-prod.data_platform.dim_subscription_plan` as pln on a.plan_id = pln.plan_id
    LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_acquisition_daily` b
        ON a.country = b.country_code AND a.account_id = b.account_id AND a.iso_date = DATE(b.start_date)
    LEFT JOIN `tlb-data-prod.data_platform.fct_subscription_current` c
        ON a.subscriber_id = c.subscriber_id
      LEFT JOIN active_eom as d
        ON a.country = d.country AND a.account_id = d.account_id 
        AND DATE_ADD(DATE(date_trunc(a.start_date, MONTH)), INTERVAL -1 MONTH) = d.iso_month AND d.subs_type <<>> 'BILLING RETRY' AND pln.plan_group = d.plan_group      
WHERE a.subscription_state = 'FREE TRIAL' AND b.account_id IS NULL AND d.account_id IS NULL AND a.iso_date = DATE(a.start_date)
    AND date_trunc(a.iso_date, MONTH) between '2022-12-01' and date_trunc(CURRENT_DATE, MONTH)
    AND (CASE WHEN pln.plan_type = 'Pro Regular' THEN TRUE 
              WHEN pln.plan_type = 'Pro Family' and a.manager_account_id is NULL THEN TRUE END) = TRUE
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date DESC) = 1),

-- The following status updates only for Pro Regular
second_free_trial_status AS (
    SELECT
        a.country,
        a.start_month,
        a.plan_duration,
        a.plan_type,
        a.plan_name,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 THEN a.account_id END) AS renewed_from_partnerships,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 THEN a.account_id END) AS winback_target,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS renewed_from_partnerships_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS renewed_from_partnerships_active_diff_type_12m,


        count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as renewed_from_partnerships_reg_active_family_1m,
        count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as renewed_from_partnerships_reg_active_family_6m,
count(distinct case when is_partnership = 1 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as renewed_from_partnerships_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS renewed_from_partnerships_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.account_id IS NULL THEN a.account_Id END) AS renewed_from_partnerships_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 1 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS renewed_from_partnerships_moved_to_bt,

        count(distinct case when is_partnership = 1 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as renewed_from_partnerships_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 1 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS renewed_from_partnerships_active_stay,

                COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name = pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' THEN a.account_id
        END) AS winback_target_active_same,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS winback_target_active_diff_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS winback_target_active_diff_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS winback_target_active_diff_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31 THEN a.account_id
        END) AS winback_target_active_diff_type_1m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180 THEN a.account_id
        END) AS winback_target_active_diff_type_6m,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name
                AND b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365 THEN a.account_id
        END) AS winback_target_active_diff_type_12m,


        count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winback_target_reg_active_family_1m,
        count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as winback_target_reg_active_family_6m,
count(distinct case when is_partnership = 0 and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as winback_target_reg_active_family_12m,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' THEN b.account_id END)
            AS winback_target_moved_to_lite,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.account_id IS NULL THEN a.account_Id END) AS winback_target_churned,
        COUNT(DISTINCT CASE WHEN is_partnership = 0 and b.subscription_state = 'BILLING RETRY' THEN a.account_Id END) AS winback_target_moved_to_bt,

        count(distinct case when is_partnership = 0 and a.plan_type = pln.plan_type
                       AND (case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
                       a.subscription_state and b.subscription_state = 'GRACE PERIOD' and a.plan_type = 'Regular' then a.account_id END) as winback_target_active_gp,

        COUNT(DISTINCT CASE WHEN is_partnership = 0 and a.plan_type = pln.plan_type
                AND (CASE WHEN b.subscription_state = 'GRACE PERIOD' THEN b.prev_subs_type ELSE b.subscription_state END)
                = a.subscription_state AND b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' THEN a.account_id
        END) AS winback_target_active_stay

    FROM second_free_trial a
        LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` b
            ON a.country = b.country AND b.iso_date = (CASE WHEN DATE_TRUNC(CURRENT_DATE, MONTH) = a.start_month
                        THEN
                            CURRENT_DATE - 1
                    ELSE LAST_DAY(a.start_month)
                END) AND a.account_id = b.account_id
        LEFT JOIN `tlb-data-prod.data_platform.dim_subscription_plan` pln
            ON b.plan_id = pln.plan_id
    GROUP BY ALL
),

acqns as
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.account_id, 
a.subscription_state,   
c.plan_type, 
c.plan_group, 
c.plan_name,
c.plan_duration, 
case when c.plan_type = 'Pro Family' THEN 
     case when a.manager_account_id is null then 'Manager' 
     ELSE 'Member' END END as family_sub_type
from 
(SELECT
    country,
    account_id,
    subscription_state,
    start_date,
    plan_id,
    manager_account_id
FROM
    `tlb-data-prod.data_platform_rest_tables.subs_date_fix` as a 
QUALIFY ROW_NUMBER() OVER (PARTITION BY country, account_Id ORDER BY start_date) = 1) as a 
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)),

-- Acquisitions movement has been studied
acqns_status as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
a.plan_name,
count(distinct a.account_id) as acqns_reg,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name = pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' 
then a.account_id END) as acqns_reg_active_same,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 31
then a.account_id END) as acqns_reg_active_diff_1m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 180
then a.account_id END) as acqns_reg_active_diff_6m,
count(distinct case when a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and pln.plan_duration_days = 365
then a.account_id END) as acqns_reg_active_diff_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 31 then a.account_id END) as acqns_reg_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 180 then a.account_id END) as acqns_reg_active_diff_type_6m,
count(distinct case when a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY'
and pln.plan_duration_days = 365 then a.account_id END) as acqns_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as acqns_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as acqns_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as acqns_reg_active_family_12m,

count(distinct case when a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as acqns_reg_moved_to_lite,
count(distinct case when b.account_id is null then a.account_Id END) as acqns_reg_churned,
count(distinct case when b.subscription_state = 'BILLING RETRY' then a.account_Id END) as acqns_reg_moved_to_bt,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state = 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_gp,

count(distinct case when a.plan_type = pln.plan_type and 
(case when b.subscription_state = 'GRACE PERIOD' then b.prev_subs_type else b.subscription_state END) = 
a.subscription_state and b.subscription_state <<>> 'BILLING RETRY' and b.subscription_state <<>> 'GRACE PERIOD' then a.account_id END) as acqns_reg_active_stay,

from acqns as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
where (case when a.plan_type = 'Pro Family' then 
         case when a.family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE

group by ALL),

-- Extracting the list of users who came back to Pro
paid as 
(select 
a.country,
DATE(date_trunc(a.start_date, MONTH)) as start_month,
a.start_date,
a.account_id,
a.prev_plan_id,
a.prev_subs_type_gp,
a.subscription_payment_id,
c.plan_type, 
c.plan_group,
c.plan_name, 
c.plan_duration,
case when c.plan_type = 'Pro Family' then 
     case when a.manager_account_id is null then 'Manager'
          else 'Member' END END as family_sub_type
from `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.dim_subscription_plan` as c 
on a.plan_id = c.plan_id and c.plan_price_lc <<>> 0 
where DATE(date_trunc(a.start_date, MONTH)) between '2023-01-01' and date_trunc(CURRENT_DATE, MONTH)
AND (CASE WHEN c.plan_type = 'Pro Regular' AND subscription_state = 'PAID' THEN TRUE
    WHEN c.plan_type = 'Pro Family' then 
         case when a.manager_account_id is null and subscription_state = 'PAID' THEN TRUE
              when a.manager_account_id is not null and subscription_state IN ('FREE TRIAL', 'PAID') THEN TRUE END
    WHEN c.plan_group = 'Lite' AND subscription_state IN ('FREE', 'FREE TRIAL') THEN TRUE
END) = TRUE
QUALIFY ROW_NUMBER() OVER(PARTITION BY a.country, DATE(date_trunc(a.start_date, MONTH)), a.account_id ORDER BY a.iso_date) = 1),

winbacks as 
(select 
a.country, 
a.start_month, 
a.account_id,
a.prev_plan_id,
prev_subs_type_gp,
a.plan_group,
a.plan_type, 
a.plan_name,
a.plan_duration,
a.subscription_payment_id,
a.family_sub_type
from paid as a 
left join active_eom as b 
on a.country = b.country and a.account_id = b.account_id 
and DATE_ADD(a.start_month, INTERVAL -1 MONTH) = b.iso_month and b.subs_type <<>> 'BILLING RETRY' and a.plan_group = b.plan_group
-- and (b.family_sub_type = 'Manager' or b.family_sub_type is null)
left join acqns as c
on a.country = c.country and a.account_id = c.account_id and 
a.start_month = c.start_month and a.plan_group = c.plan_group
left JOIN second_free_trial d
ON a.country = d.country AND a.account_id = d.account_id
AND a.start_month = d.start_month and a.plan_group = d.plan_group
where b.account_id is null and c.account_id is null and d.account_id is null),

winbacks_split as 
(select 
a.country, 
a.start_month,
a.plan_type,
a.plan_duration,
a.plan_name,
COUNT(DISTINCT CASE WHEN d.requester IN (100, 300) THEN a.account_id END) AS winbacks_reg,
count(distinct CASE WHEN d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as winbacks_reg_active_same,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as winbacks_reg_active_diff_1m,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as winbacks_reg_active_diff_6m,
count(distinct case when d.requester IN (100, 300)
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as winbacks_reg_active_diff_12m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as winbacks_reg_active_diff_type_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as winbacks_reg_active_diff_type_6m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300)
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as winbacks_reg_active_diff_type_12m,

count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as winbacks_reg_active_family_1m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as winbacks_reg_active_family_6m,
count(distinct case when a.plan_group = pln.plan_group and d.requester IN (100, 300) and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as winbacks_reg_active_family_12m,

count(distinct case when d.requester IN (100, 300) and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_lite,
count(distinct case when d.requester IN (100, 300) AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as winbacks_reg_moved_to_bt,
count(distinct case when d.requester IN (100, 300) AND b.account_id is null then a.account_Id END) as winbacks_reg_churned,

COUNT(DISTINCT CASE WHEN d.requester = 200 THEN a.account_id END) AS bt,
count(distinct CASE WHEN d.requester = 200
                    AND a.plan_type = pln.plan_type
                    AND b.subscription_state <<>> 'BILLING RETRY'
                    AND pln.plan_name = a.plan_name
then a.account_id END) as bt_active_same,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as bt_active_diff_1m,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as bt_active_diff_6m,
count(distinct case when d.requester = 200
                    AND a.plan_type = pln.plan_type and a.plan_name <<>> pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as bt_active_diff_12m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 31
then a.account_id END) as bt_active_diff_type_1m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 180
then a.account_id END) as bt_active_diff_type_6m,
count(distinct case when d.requester = 200
                    AND a.plan_type <<>> pln.plan_type and a.plan_name = pln.plan_name
                    and b.subscription_state <<>> 'BILLING RETRY'
                    and pln.plan_duration_days = 365
then a.account_id END) as bt_active_diff_type_12m,

count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 31 then b.account_id END) as bt_active_family_1m,
count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 180 then b.account_id END) as bt_active_family_6m,
count(distinct case when d.requester = 200 and a.plan_type = 'Pro Regular' and a.plan_type <<>> pln.plan_type and a.plan_name <<>> pln.plan_name and b.subscription_state <<>> 'BILLING RETRY' and b.manager_account_id is null 
AND pln.plan_duration_days = 365 then b.account_id END) as bt_active_family_12m,

count(distinct case when d.requester = 200 and a.plan_group <<>> pln.plan_group and b.subscription_state <<>> 'BILLING RETRY' then b.account_id END) as bt_moved_to_lite,
count(distinct case when d.requester = 200 AND b.subscription_state = 'BILLING RETRY' then b.account_id END) as bt_moved_to_bt,
count(distinct case when d.requester = 200 AND b.account_id is null then a.account_Id END) as bt_churned

from winbacks as a
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as b 
on a.country = b.country and b.iso_date = (case when date_trunc(CURRENT_DATE, MONTH) = a.start_month then 
CURRENT_DATE - 1 else last_day(a.start_month) END) and a.account_id = b.account_id
left join `tlb-data-prod.data_platform.dim_subscription_plan` as pln 
on b.plan_id = pln.plan_id 
inner join `tlb-data-prod.data_platform_subscription.PaymentsHistory` as c
on a.subscription_payment_id = c.id
inner join `tlb-data-prod.data_platform_subscription.SubscriptionTransactions` as d
on c.subscriptiontransactionid = d.id

where (case when a.plan_type = 'Pro Family' and a.family_sub_type = 'Manager' then true   
  when a.plan_type = 'Pro Regular' then true END) = TRUE
group by ALL),

active_data as 
(select
country, 
iso_month,
plan_type,
plan_duration,
plan_name,
count(distinct case when subs_type <<>> 'BILLING RETRY' THEN account_id END) as active_users,
count(distinct case when subs_type = 'FREE TRIAL' THEN account_id END) as active_users_ft,
count(distinct case when subs_type = 'PAID' THEN account_id END) as active_users_paid,
count(distinct case when subs_type = 'BILLING RETRY' then account_id END) as bt_users
from active_eom
where (case when plan_type = 'Pro Family' then 
         case when family_sub_type = 'Manager' then true END
         else TRUE END) = TRUE
group by ALL)

select 
g.country,
g.iso_month, 
g.plan_type,
g.plan_duration,
g.plan_name,
a.active_users,
a.active_users_ft,
a.active_users_paid,
a.bt_users,
b.acqns_reg,
CAST(0 AS INT64) as acqns_lite,
b.acqns_reg_active_same, 
b.acqns_reg_active_diff_1m,
b.acqns_reg_active_diff_6m,
b.acqns_reg_active_diff_12m,
b.acqns_reg_active_diff_type_1m,
b.acqns_reg_active_diff_type_6m,
b.acqns_reg_active_diff_type_12m,
b.acqns_reg_active_family_1m,
b.acqns_reg_active_family_6m,
b.acqns_reg_active_family_12m,
b.acqns_reg_moved_to_lite,
b.acqns_reg_moved_to_bt,
b.acqns_reg_churned,
b.acqns_reg_active_gp,
b.acqns_reg_active_stay,
c.winbacks_reg,
c.winbacks_reg_active_same,
c.winbacks_reg_active_diff_1m,
c.winbacks_reg_active_diff_6m,
c.winbacks_reg_active_diff_12m, 
c.winbacks_reg_active_diff_type_1m, 
c.winbacks_reg_active_diff_type_6m, 
c.winbacks_reg_active_diff_type_12m, 
c.winbacks_reg_active_family_1m,
c.winbacks_reg_active_family_6m,
c.winbacks_reg_active_family_12m,
c.winbacks_reg_moved_to_lite,
c.winbacks_reg_moved_to_bt,
c.winbacks_reg_churned,
c.bt,
c.bt_active_same,
c.bt_active_diff_1m, 
c.bt_active_diff_6m,
c.bt_active_diff_12m,
c.bt_active_diff_type_1m,
c.bt_active_diff_type_6m,
c.bt_active_diff_type_12m,
c.bt_active_family_1m,
c.bt_active_family_6m,
c.bt_active_family_12m,
c.bt_moved_to_lite,
c.bt_moved_to_bt,
c.bt_churned,
f.active_lm,
f.active_lm_active_same,
f.active_lm_active_diff_1m, 
f.active_lm_active_diff_6m,
f.active_lm_active_diff_12m,
f.active_lm_active_diff_type_1m, 
f.active_lm_active_diff_type_6m,
f.active_lm_active_diff_type_12m, 
f.active_lm_reg_active_family_1m,
f.active_lm_reg_active_family_6m,
f.active_lm_reg_active_family_12m,
f.active_lm_ft_active,
f.active_lm_paid_active,
f.paid_up_for_renewal,
f.active_lm_moved_to_lite,
f.active_lm_ft_moved_to_lite,
f.active_lm_paid_moved_to_lite,
f.active_lm_moved_to_bt,
f.active_lm_ft_moved_to_bt,
f.active_lm_paid_moved_to_bt,
f.active_lm_churned,
f.active_lm_ft_churned,
f.active_lm_paid_churned,
f.active_lm_ft_stay,
f.active_lm_ft_gp,
f.active_lm_paid_stay,
f.active_lm_paid_gp,
g.active_users as active_nm,
h.renewed_from_partnerships,
h.renewed_from_partnerships_active_same,
h.renewed_from_partnerships_active_diff_1m,
h.renewed_from_partnerships_active_diff_6m,
h.renewed_from_partnerships_active_diff_12m,
h.renewed_from_partnerships_active_diff_type_1m,
h.renewed_from_partnerships_active_diff_type_6m,
h.renewed_from_partnerships_active_diff_type_12m,
h.renewed_from_partnerships_reg_active_family_1m,
h.renewed_from_partnerships_reg_active_family_6m,
h.renewed_from_partnerships_reg_active_family_12m,
h.renewed_from_partnerships_moved_to_lite,
h.renewed_from_partnerships_churned,
h.renewed_from_partnerships_moved_to_bt,
h.renewed_from_partnerships_active_gp,
h.renewed_from_partnerships_active_stay,
h.winback_target,
h.winback_target_active_same,
h.winback_target_active_diff_1m,
h.winback_target_active_diff_6m,
h.winback_target_active_diff_12m,
h.winback_target_active_diff_type_1m,
h.winback_target_active_diff_type_6m,
h.winback_target_active_diff_type_12m,
h.winback_target_reg_active_family_1m,
h.winback_target_reg_active_family_6m,
h.winback_target_reg_active_family_12m,
h.winback_target_moved_to_lite,
h.winback_target_churned,
h.winback_target_moved_to_bt,
h.winback_target_active_gp,
h.winback_target_active_stay,
g.bt_users as bt_users_nm
from active_data as g 
left join acqns_status as b
on g.country = b.country and g.iso_month = b.start_month
and g.plan_duration = b.plan_duration and g.plan_type = b.plan_type and g.plan_name = b.plan_name
left join winbacks_split as c 
on g.country = c.country and g.iso_month = c.start_month 
and g.plan_duration = c.plan_duration and g.plan_type = c.plan_type and g.plan_name = c.plan_name
left join active_lm_but_moved as f 
on g.country = f.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = f.iso_month
and g.plan_duration = f.plan_duration and g.plan_type = f.plan_type and g.plan_name = f.plan_name
left join active_data as a
on g.country = a.country and DATE_ADD(g.iso_month, INTERVAL -1 MONTH) = a.iso_month
and g.plan_duration = a.plan_duration and g.plan_type = a.plan_type and g.plan_name = a.plan_name
left join second_free_trial_status as h 
on g.country = h.country and g.iso_month = h.start_month
and g.plan_duration = h.plan_duration and g.plan_type = h.plan_type and g.plan_name = h.plan_name
where  g.iso_month <<= 
date_trunc(CURRENT_DATE, MONTH)
order by country, iso_month, plan_duration, plan_name]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
