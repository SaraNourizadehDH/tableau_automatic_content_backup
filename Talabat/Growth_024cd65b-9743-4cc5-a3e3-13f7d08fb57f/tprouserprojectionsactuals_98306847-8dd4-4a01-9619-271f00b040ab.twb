          <datasource-dependencies datasource='federated.09jaajv1d9imf51a6aiy11w46y2b'>
            <column caption='12M to different plan type - Regular' datatype='integer' name='[12M to 12M different plan type - Family (copy)_1241586128580243467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED country, [iso_month]: SUM(&#13;&#10;IF [plan_type] = &apos;Pro Regular&apos; THEN &#13;&#10;IF [plan_duration] = &apos;LTP&apos; then &#13;&#10;ZN([acqns_reg_active_diff_type_12m]) + ZN([winbacks_reg_active_diff_type_12m]) + ZN([bt_active_diff_type_12m]) + ZN([active_lm_active_diff_type_12m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_12m]) + ZN([winback_target_active_diff_type_12m]) + &#13;&#10;ZN([acqns_reg_active_diff_type_1m]) + ZN([winbacks_reg_active_diff_type_1m]) + ZN([bt_active_diff_type_1m]) + ZN([active_lm_active_diff_type_1m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_1m])&#13;&#10;+ ZN([winback_target_active_diff_type_1m])&#13;&#10;else 0 END END)}' />
            </column>
            <column caption='1M to 1M different plan type - Family' datatype='integer' name='[12M to 12M different plan type - Family (copy)_1241586128580501516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED country, [iso_month]: SUM(&#13;&#10;IF [plan_type] = &apos;Pro Family&apos; THEN &#13;&#10;IF [plan_duration] = &apos;1M&apos; then &#13;&#10;ZN([acqns_reg_active_diff_type_1m]) + ZN([winbacks_reg_active_diff_type_1m]) + ZN([bt_active_diff_type_1m]) + ZN([active_lm_active_diff_type_1m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_1m])&#13;&#10;+ ZN([winback_target_active_diff_type_1m])&#13;&#10;else 0 END END)}' />
            </column>
            <column caption='1M to 12M different plan type - Family' datatype='integer' name='[12M to 12M different plan type - Family (copy)_1241586128581062671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED country, [iso_month]: SUM(&#13;&#10;IF [plan_type] = &apos;Pro Family&apos; THEN &#13;&#10;IF [plan_duration] = &apos;1M&apos; then &#13;&#10;ZN([acqns_reg_active_diff_type_12m]) + ZN([winbacks_reg_active_diff_type_12m]) + ZN([bt_active_diff_type_12m]) + ZN([active_lm_active_diff_type_12m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_12m])&#13;&#10;+ ZN([winback_target_active_diff_type_12m])&#13;&#10;else 0 END END)}' />
            </column>
            <column caption='12M to 1M different plan type - Family' datatype='integer' name='[12M to 12M different plan type - Family (copy)_1241586128581394450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED country, [iso_month]: SUM(&#13;&#10;IF [plan_type] = &apos;Pro Family&apos; THEN &#13;&#10;IF [plan_duration] = &apos;LTP&apos; then &#13;&#10;ZN([acqns_reg_active_diff_type_1m]) + ZN([winbacks_reg_active_diff_type_1m]) + ZN([bt_active_diff_type_1m]) + ZN([active_lm_active_diff_type_1m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_1m])&#13;&#10;+ ZN([winback_target_active_diff_type_1m])&#13;&#10;else 0 END END)}' />
            </column>
            <column caption='1M to 12M same plan type' datatype='integer' name='[12M to 1M same plan type (copy)_1241586128577679363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country], [iso_month], [plan_type]: SUM(&#13;&#10;IF [plan_duration] = &apos;1M&apos; then &#13;&#10;ZN([acqns_reg_active_diff]) + ZN([winbacks_reg_active_diff]) + ZN([bt_active_diff]) + ZN([active_lm_active_diff]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff])&#13;&#10;+ ZN([winback_target_active_diff])&#13;&#10;else 0 END)}' />
            </column>
            <column caption='1M to different plan type - Regular' datatype='integer' name='[12M to different plan type - Regular (copy)_1241586128580886542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED country, [iso_month]: SUM(&#13;&#10;IF [plan_type] = &apos;Pro Regular&apos; THEN &#13;&#10;IF [plan_duration] = &apos;1M&apos; then &#13;&#10;ZN([acqns_reg_active_diff_type_1m]) + ZN([winbacks_reg_active_diff_type_1m]) + ZN([bt_active_diff_type_1m]) + ZN([active_lm_active_diff_type_1m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_1m]) + ZN([winback_target_active_diff_type_1m]) +&#13;&#10;ZN([acqns_reg_active_diff_type_12m]) + ZN([winbacks_reg_active_diff_type_12m]) + ZN([bt_active_diff_type_12m]) + ZN([active_lm_active_diff_type_12m]) &#13;&#10;+ ZN([renewed_from_partnerships_active_diff_type_12m])&#13;&#10;+ ZN([winback_target_active_diff_type_12m])&#13;&#10;else 0 END END)}' />
