    <datasource caption='agg_growth_accounting_daily' inline='true' name='federated.0x3afrf0xykpe51ehhm9y1pk96y9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ku6qfu0qhgrjf1da79g80k7pu46'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='amro.elnour@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ku6qfu0qhgrjf1da79g80k7pu46' name='Custom SQL Query' type='text'>WITH
  df AS (
  SELECT
    *
  FROM
    `tlb-data-prod.data_platform.agg_growth_accounting_daily` ),
  df_t_1 AS (
  SELECT
    snapshot_date,
    use_case,
    frequency,
    signal,
    country,
    (new_customer_count+contracting_customer_count+expanding_customer_count+resurrected_customer_count+retained_customer_count) AS active_customer_base_t_1
  FROM
    df )
SELECT
  df.*,
  (new_customer_count+contracting_customer_count+expanding_customer_count+resurrected_customer_count+retained_customer_count) AS active_customer_base,
  df_t_1.active_customer_base_t_1
FROM
  df
LEFT JOIN
  df_t_1
ON
  df.use_case = df_t_1.use_case
  AND df.frequency = df_t_1.frequency
  AND df.signal = df_t_1.signal
  AND df.country = df_t_1.country
  AND (CASE
      WHEN df.frequency = &apos;monthly&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 1 month)
      WHEN df.frequency = &apos;7 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 7 day)
      WHEN df.frequency = &apos;14 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 14 day)
      WHEN df.frequency = &apos;28 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 28 day)
  END
    )
    WHERE df.country is not null</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ku6qfu0qhgrjf1da79g80k7pu46' name='Custom SQL Query' type='text'>WITH
