      <column caption='Current Month Flag' datatype='boolean' name='[Calculation_139259775790587905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency] = &apos;monthly&apos; AND DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &lt; [snapshot_date]&#10;THEN TRUE ELSE FALSE&#10;END' />
      </column>
      <column caption='hide null' datatype='boolean' name='[Calculation_160088919000219649]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous Period' datatype='integer' name='[Calculation_160088919065612298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([frequency]) = &apos;28 days&apos; then&#10;LOOKUP(ZN(SUM([Calculation_160088919089471503])), -31)&#10;ELSEIF MAX([frequency]) = &apos;14 days&apos; then&#10;LOOKUP(ZN(SUM([Calculation_160088919089471503])), -15)&#10;ELSEIF MAX([frequency]) = &apos;7 days&apos; then&#10;LOOKUP(ZN(SUM([Calculation_160088919089471503])), -7)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index Filter' datatype='boolean' name='[Calculation_160088919066816525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if max([frequency]) = &apos;28 days&apos; then&#10;INDEX()&gt;29&#10;elseif max([frequency]) = &apos;14 days&apos; then&#10;INDEX()&gt;15&#10;elseif max([frequency]) = &apos;7 days&apos; then&#10;INDEX()&gt;8&#10;elseif max([frequency]) = &apos;monthly&apos; then&#10;INDEX()&gt;2&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Customer Count' datatype='integer' name='[Calculation_160088919089471503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_customer_count] +[resurrected_customer_count] + [expanding_customer_count] + [retained_customer_count] +[contracting_customer_count]' />
      </column>
      <column caption='frequency_number' datatype='integer' name='[Calculation_160088919104421904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [frequency] &#10;when &apos;28 days&apos; then 28 &#10;when &apos;14 days&apos; then 14&#10;when &apos;7 days&apos; then 8&#10;end' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_400468548799639553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(CASE [signal] when &apos;order&apos; then [signal_value] END)&#10;SUM([signal_value])&#10;/ SUM([customer_count])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_400468548802060291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// current date&#10;&#10;//comparsion : snapshot date - frequency days - 1&#10;&#10;IF [Parameters].[Parameter 1] = [snapshot_date]&#10;THEN &apos;Current Date&apos;&#10;&#10;ELSEIF [frequency] = &apos;28 days&apos; and &#10;[snapshot_date] = DATEADD(&apos;day&apos;, -29, [Parameters].[Parameter 1])&#10;THEN &apos;Comparison Period&apos;&#10;&#10;ELSEIF [frequency] = &apos;14 days&apos; and &#10;[snapshot_date] = DATEADD(&apos;day&apos;, -15, [Parameters].[Parameter 1])&#10;THEN &apos;Comparison Period&apos;&#10;&#10;ELSEIF [frequency] = &apos;7 days&apos; and &#10;[snapshot_date] = DATEADD(&apos;day&apos;, -8, [Parameters].[Parameter 1])&#10;THEN &apos;Comparison Period&apos;&#10;&#10;ELSEIF [frequency] = &apos;monthly&apos; and &#10;[snapshot_date] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]))&#10;THEN &apos;Comparison Period&apos;&#10;&#10;ELSEIF [frequency] = &apos;monthly&apos; and &#10;[snapshot_date] = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1])&#10;THEN &apos;Current Date&apos;&#10;&#10;END' />
      </column>
      <column caption='Default Date' datatype='date' name='[Calculation_4218606238338232320]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([snapshot_date]) }' />
      </column>
      <column caption='Snapshot Day Flag' datatype='boolean' name='[Calculation_699324611003723777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency] &lt;&gt; &apos;monthly&apos; and&#10;DATEPART(&apos;day&apos;,[Parameters].[Parameter 1]) = DATEPART(&apos;day&apos;,[snapshot_date]) &#10;then True &#10;ELSEIF [frequency] = &apos;monthly&apos; &#10;THEN True&#10;ELSE False&#10;END' />
      </column>
      <column caption='Date Range (trend)' datatype='boolean' name='[Date Range (copy)_160088919058272260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency] = &apos;28 days&apos; then &#10;[snapshot_date] &lt;= [Parameters].[Parameter 1]&#10;AND &#10;[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -21, [Parameters].[Parameter 1])&#10;&#10;ELSEIF [frequency] = &apos;14 days&apos; then &#10;[snapshot_date] &lt;= [Parameters].[Parameter 1]&#10;AND &#10;[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -21, [Parameters].[Parameter 1])&#10;&#10;ELSEIF [frequency] = &apos;7 days&apos; then &#10;[snapshot_date] &lt;= [Parameters].[Parameter 1]&#10;AND &#10;[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -21, [Parameters].[Parameter 1])&#10;&#10;ELSEIF [frequency] = &apos;monthly&apos; then &#10;[snapshot_date] &lt;= [Parameters].[Parameter 1]&#10;AND &#10;[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -22, [Parameters].[Parameter 1])&#10;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_0801E86ABAAF4AF6A294183431AA3F06]' role='measure' type='quantitative' />
      <column caption='active_customer_base (temp_fix)' datatype='real' name='[active_customer_base (copy)_6980157243332710400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [snapshot_date] = #14/11/2023# then [active_customer_base]/2 &#10;elseif [snapshot_date] = #12/12/2023# and [frequency] = &apos;28 days&apos; then [active_customer_base]/2 &#10;&#10;else [active_customer_base] END' />
      </column>
