      <column caption='commutative signal value Per Customer' datatype='real' name='[commutative signal value (copy)_699324611013189634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Running sum only for non-null values.&#10;IF ISNULL(SUM([signal_value])) = FALSE THEN&#10;    RUNNING_SUM(SUM([signal_value]))/sum([original_cohort_customer_count])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
