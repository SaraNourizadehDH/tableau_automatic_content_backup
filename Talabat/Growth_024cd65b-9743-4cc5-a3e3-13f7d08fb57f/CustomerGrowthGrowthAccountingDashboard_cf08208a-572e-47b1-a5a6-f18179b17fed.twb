      <column caption='customer retention rate' datatype='real' name='[Calculation_1532490544197783552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([customer_count])/sum([original_cohort_customer_count])' />
      </column>
      <column caption='original_customer_count_updated' datatype='integer' name='[Calculation_1532490544223748097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cohort_number] = 0 and  ISNULL([original_cohort_customer_count])&#10;then [customer_count]&#10;else [original_cohort_customer_count]&#10;END' />
      </column>
      <column caption='Signal Retention Rate' datatype='real' name='[Calculation_1532490544236802050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([signal_value]) / sum([original_cohort_signal_value])' />
      </column>
      <column caption='Cumulative Signal Value' datatype='real' name='[Calculation_1532490544237342723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Running sum only for non-null values.&#10;IF ISNULL(SUM([signal_value])) = FALSE THEN&#10;    RUNNING_SUM(SUM([signal_value]))&#10;END'>
