      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0801E86ABAAF4AF6A294183431AA3F06'>
            <properties context=''>
              <relation connection='bigquery.1ku6qfu0qhgrjf1da79g80k7pu46' name='Custom SQL Query' type='text'>WITH
  df AS (
  SELECT
    *
  FROM
    `tlb-data-prod.data_platform.agg_growth_accounting_daily` ),
  df_t_1 AS (
  SELECT
    snapshot_date,
    use_case,
    frequency,
    signal,
    country,
    (new_customer_count+contracting_customer_count+expanding_customer_count+resurrected_customer_count+retained_customer_count) AS active_customer_base_t_1
  FROM
    df )
SELECT
  df.*,
  (new_customer_count+contracting_customer_count+expanding_customer_count+resurrected_customer_count+retained_customer_count) AS active_customer_base,
  df_t_1.active_customer_base_t_1
FROM
  df
LEFT JOIN
  df_t_1
ON
  df.use_case = df_t_1.use_case
  AND df.frequency = df_t_1.frequency
  AND df.signal = df_t_1.signal
  AND df.country = df_t_1.country
  AND (CASE
      WHEN df.frequency = &apos;monthly&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 1 month)
      WHEN df.frequency = &apos;7 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 7 day)
      WHEN df.frequency = &apos;14 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 14 day)
      WHEN df.frequency = &apos;28 days&apos; THEN df.snapshot_date = DATE_ADD(df_t_1.snapshot_date,INTERVAL 28 day)
  END
    )
    WHERE df.country is not null</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
