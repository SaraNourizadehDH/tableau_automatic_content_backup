      <column aggregation='Sum' caption='Calculation1' datatype='integer' name='[Calculation_104286505945546752]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [cohort_number] = 0 then [customer_count] END' />
      </column>
      <column caption='Index Filter 1' datatype='boolean' name='[Calculation_104286505950294017]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Date Flag' datatype='boolean' name='[Calculation_37154728016855042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [frequency] = &apos;monthly&apos; AND DATETRUNC(&apos;month&apos;,TODAY()) = [snapshot_date]&#10;THEN TRUE ELSE FALSE&#10;END' />
      </column>
      <column caption='commutative signal value' datatype='real' name='[Calculation_37154728018755588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Running sum only for non-null values.&#10;IF ISNULL(SUM([signal_value])) = FALSE THEN&#10;    RUNNING_SUM(SUM([signal_value]))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_400468548818661383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_count])/SUM([original_cohort_signal_value_updated (copy)_699324611095240708])' />
      </column>
      <column caption='original_cohort_signal_value_updated' datatype='real' name='[Calculation_699324611094077443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cohort_number] = 0 and  ISNULL([original_cohort_signal_value])&#10;then [signal_value]&#10;else [original_cohort_signal_value]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Cohort Number original' datatype='integer' name='[Cohort Number (copy)_37154728017833987]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[cohort_number]' />
      </column>
      <column caption='Index Filter 2' datatype='boolean' name='[Index Filter 1 (copy)_104286505950777346]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Signal Retention Rate' datatype='real' name='[Retention Rate (copy)_37154728016265216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([signal_value])/SUM([Calculation_699324611094077443])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_649E8719A83340B297B8457B6F500FE1]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Cohort Number' datatype='integer' name='[cohort_number]' role='dimension' type='ordinal'>
