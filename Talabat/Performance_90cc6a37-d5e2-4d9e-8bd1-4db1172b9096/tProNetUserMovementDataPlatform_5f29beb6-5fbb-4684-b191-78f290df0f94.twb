    <worksheet name='Daily Summarized Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' italic='true'>Daily tPro User Movement</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_tpro_net_user_movement (data_platform)' name='federated.1h3ch00072j09s13jp98t1pznbhg' />
          </datasources>
          <datasource-dependencies datasource='federated.1h3ch00072j09s13jp98t1pznbhg'>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_1053279396427485185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([acquisitions_count]) + ZN([winbacks_count]) + ZN([billing_retry_count])' />
            </column>
            <column caption='Free Trial - Vol' datatype='integer' name='[Calculation_1053279396427911171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([active_ld_free_trial_churned_vol_count]) + ZN([active_ld_free_trial_different_subs_type_count]&#13;&#10;))*-1' />
            </column>
            <column caption='Free Trial - Invol' datatype='integer' name='[Calculation_1053279396428185604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([active_ld_free_trial_churned_invol_count]) + ZN([active_ld_free_trial_billing_retry_count]))*-1' />
            </column>
            <column caption='Paid - Vol' datatype='integer' name='[Calculation_1053279396428402693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([active_ld_paid_churned_vol_count]) + ZN([active_ld_paid_different_subs_type_count]))*-1' />
            </column>
            <column caption='Paid - Invol' datatype='integer' name='[Calculation_1053279396428566534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([active_ld_paid_churned_invol_count]) + ZN([active_ld_paid_billing_retry_count]))*-1' />
            </column>
            <column caption='Churn - Voluntary' datatype='integer' name='[Calculation_1053279396428791815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1053279396427911171] + [Calculation_1053279396428402693]' />
            </column>
            <column caption='Churn - Involuntary' datatype='integer' name='[Calculation_1053279396428840968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1053279396428185604] + [Calculation_1053279396428566534]' />
            </column>
            <column caption='Churned' datatype='integer' name='[Calculation_1053279396428906505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1053279396428791815] + [Calculation_1053279396428840968]' />
            </column>
            <column caption='Upgrades' datatype='integer' name='[Calculation_1053279396459409419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;1M&apos; then ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Downgrades' datatype='integer' name='[Calculation_1053279396460007436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;LTP&apos; then ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Active Users EOD' datatype='integer' name='[Calculation_1053279396460695565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([active_ld_count]) + ZN([acquisitions_count]) + ZN([winbacks_count]) + ZN([billing_retry_count]) + ZN([Calculation_1053279396428791815]) + ZN([Calculation_1053279396428840968]) +&#13;&#10;CASE [plan_type] WHEN &apos;1M&apos; then [Calculation_1053279396459409419]*-1&#13;&#10;else [Calculation_1053279396459409419] END  + &#13;&#10;CASE [plan_type] WHEN &apos;LTP&apos; then [Calculation_1053279396460007436]*-1&#13;&#10;else [Calculation_1053279396460007436] END' />
            </column>
            <column caption='SUM([Churned]*-1)' datatype='integer' name='[Calculation_1053279396494086168]' role='measure' type='quantitative' user:unnamed='Daily Summarized Trend'>
              <calculation class='tableau' formula='SUM([Calculation_1053279396428906505]*-1)' />
            </column>
            <column caption='SUM([Churn - Voluntary]*-1)' datatype='integer' name='[Calculation_1053279396772556825]' role='measure' type='quantitative' user:unnamed='Daily Summarized Trend'>
              <calculation class='tableau' formula='SUM([Calculation_1053279396428791815]*-1)' />
