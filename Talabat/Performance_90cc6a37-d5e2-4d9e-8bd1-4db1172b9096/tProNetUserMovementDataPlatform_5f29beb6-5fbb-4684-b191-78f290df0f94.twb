    <worksheet name='Paid Breakdown - Monthly'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' italic='true'>tPro Monthly Daily Paid User Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_tpro_net_user_movement (data_platform)' name='federated.1h3ch00072j09s13jp98t1pznbhg' />
          </datasources>
          <datasource-dependencies datasource='federated.1h3ch00072j09s13jp98t1pznbhg'>
            <column caption='Active Lm Count' datatype='integer' name='[Active Ld Count (copy)_1053279396486332430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[active_ld_count]' />
            </column>
            <column caption='Active Users Current Month' datatype='integer' name='[Active Users EOD (copy)_1053279396489035797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Active Ld Count (copy)_1053279396486332430] + [Calculation_1053279396427485185] + [Churned (copy)_1053279396488597524] + &#13;&#10;CASE [plan_type] WHEN &apos;1M&apos; then [Upgrades (copy)_1053279396823883817]*-1&#13;&#10;else [Upgrades (copy)_1053279396823883817] END  + &#13;&#10;CASE [plan_type] WHEN &apos;LTP&apos; then [Upgrades Monthly (copy)_1053279396824621098]*-1&#13;&#10;else [Upgrades Monthly (copy)_1053279396824621098] END' />
            </column>
            <column caption='Billing Retry Count (copy)' datatype='integer' name='[Billing Retry Count (copy)_1053279396803084326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[billing_retry_count]' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_1053279396427485185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([acquisitions_count]) + ZN([winbacks_count]) + ZN([billing_retry_count])' />
            </column>
            <column caption='Free Trial Churned' datatype='integer' name='[Calculation_1053279396487413778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([acquisitions_different_subs_type_count]) + ZN([acquisitions_billing_retry_count]) + ZN([acquisitions_churned_count]) + &#13;&#10;ZN([active_ld_free_trial_different_subs_type_count]) + ZN([active_ld_free_trial_billing_retry_count]) + ZN([active_ld_free_trial_churned_invol_count]))*-1' />
            </column>
            <column caption='Paid Churned Count' datatype='integer' name='[Calculation_1053279396487950355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([winbacks_different_subs_type_count]) + ZN([winbacks_billing_retry_count]) + ZN([winbacks_churned_count]) + &#13;&#10;ZN([billing_retry_different_subs_type_count]) + ZN([billing_retry_to_billing_retry_count]) + ZN([billing_retry_churned_count]) + &#13;&#10;ZN([active_ld_paid_different_subs_type_count]) + ZN([active_ld_paid_billing_retry_count]) + ZN([active_ld_paid_churned_invol_count]))*-1' />
            </column>
            <column caption='Renewed from Paid' datatype='integer' name='[Calculation_1053279396801740835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([paid_active_users_ld_count])) - (SUM(ZN([active_ld_paid_different_subs_type_count])) + SUM(ZN([active_ld_paid_billing_retry_count])) + SUM(ZN([active_ld_paid_churned_invol_count])) + SUM(ZN([active_ld_paid_churned_vol_count])) + &#13;&#10;SUM(ZN([active_ld_paid_full_period_count])) + SUM(ZN([active_ld_paid_grace_period_count])) + SUM(ZN([active_ld_paid_active_different_plan_type_count])))' />
            </column>
            <column caption='Existing' datatype='integer' name='[Calculation_1053279396802777124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_ld_paid_full_period_count]) + SUM([active_ld_paid_grace_period_count])' />
            </column>
            <column caption='Renewed from Free Trial Monthly' datatype='integer' name='[Calculation_1053279396816916520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Free Trial Active Users Ld Count (copy)_1053279396486471695])) - SUM(ZN([active_ld_free_trial_different_subs_type_count])) + SUM(ZN([active_ld_free_trial_billing_retry_count])) + SUM(ZN([active_ld_free_trial_churned_invol_count])) + SUM(ZN([active_ld_free_trial_full_period_count])) + SUM(ZN([active_ld_free_trial_different_plan_type_count]))&#13;&#10;+ SUM(ZN([Calculation_1053279396427485185])) - SUM(ZN([acquisitions_different_subs_type_count])) + SUM(ZN([acquisitions_billing_retry_count])) + SUM(ZN([acquisitions_churned_count])) + SUM(ZN([acquisitions_stay_full_period_count])) + SUM(ZN([acquisitions_different_plan_type_count]))' />
            </column>
            <column caption='Churned Monthly' datatype='integer' name='[Churned (copy)_1053279396488597524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1053279396487413778] + [Calculation_1053279396487950355]' />
            </column>
            <column caption='Downgrades Monthly (copy)' datatype='integer' name='[Downgrades Monthly (copy)_1053279396826714156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;LTP&apos; then ZN([acquisitions_different_plan_type_count] ) + ZN([winbacks_different_plan_type_count]) + ZN([billing_retry_different_plan_type_count]) + ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Free Trial Active Users Lm Count' datatype='integer' name='[Free Trial Active Users Ld Count (copy)_1053279396486471695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[free_trial_active_users_ld_count]' />
            </column>
            <column caption='Free Trial Active Users Nm Count' datatype='integer' name='[Free Trial Active Users Nd Count (copy)_1053279396489367574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[free_trial_active_users_nd_count]' />
            </column>
            <column caption='Paid Active Users Nm Count' datatype='integer' name='[Paid Active Users Nd Count (copy)_1053279396489424919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[paid_active_users_nd_count]' />
            </column>
            <column caption='Upgrades Monthly' datatype='integer' name='[Upgrades (copy)_1053279396823883817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;1M&apos; then ZN([acquisitions_different_plan_type_count] ) + ZN([winbacks_different_plan_type_count]) + ZN([billing_retry_different_plan_type_count]) + ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Downgrades Monthly' datatype='integer' name='[Upgrades Monthly (copy)_1053279396824621098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;LTP&apos; then ZN([acquisitions_different_plan_type_count] ) + ZN([winbacks_different_plan_type_count]) + ZN([billing_retry_different_plan_type_count]) + ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Upgrades Monthly (copy)' datatype='integer' name='[Upgrades Monthly (copy)_1053279396826636331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [date], [tpro_subs_type], [aggregation_type]: SUM(CASE [plan_type] WHEN &apos;1M&apos; then ZN([acquisitions_different_plan_type_count] ) + ZN([winbacks_different_plan_type_count]) + ZN([billing_retry_different_plan_type_count]) + ZN([active_ld_free_trial_different_plan_type_count]) + ZN([active_ld_paid_active_different_plan_type_count]) else 0 END)}' />
            </column>
            <column caption='Winbacks Count (copy)' datatype='integer' name='[Winbacks Count (copy)_1053279396802990117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[winbacks_count]' />
            </column>
            <column caption='Acquisitions Billing Retry Count' datatype='integer' name='[acquisitions_billing_retry_count]' role='measure' type='quantitative' />
            <column caption='Acquisitions Churned Count' datatype='integer' name='[acquisitions_churned_count]' role='measure' type='quantitative' />
            <column caption='Acquisitions Count' datatype='integer' name='[acquisitions_count]' role='measure' type='quantitative' />
            <column caption='Acquisitions Different Plan Type Count' datatype='integer' name='[acquisitions_different_plan_type_count]' role='measure' type='quantitative' />
            <column caption='Acquisitions Different Subs Type Count' datatype='integer' name='[acquisitions_different_subs_type_count]' role='measure' type='quantitative' />
            <column caption='Acquisitions Stay Full Period Count' datatype='integer' name='[acquisitions_stay_full_period_count]' role='measure' type='quantitative' />
            <column caption='Active Ld Count' datatype='integer' name='[active_ld_count]' role='measure' type='quantitative' />
            <column caption='Active Ld Free Trial Billing Retry Count' datatype='integer' name='[active_ld_free_trial_billing_retry_count]' role='measure' type='quantitative' />
            <column caption='Active Ld Free Trial Churned Invol Count' datatype='integer' name='[active_ld_free_trial_churned_invol_count]' role='measure' type='quantitative' />
            <column caption='Active Ld Free Trial Different Plan Type Count' datatype='integer' name='[active_ld_free_trial_different_plan_type_count]' role='measure' type='quantitative' />
            <column caption='Active Ld Free Trial Different Subs Type Count' datatype='integer' name='[active_ld_free_trial_different_subs_type_count]' role='measure' type='quantitative' />
