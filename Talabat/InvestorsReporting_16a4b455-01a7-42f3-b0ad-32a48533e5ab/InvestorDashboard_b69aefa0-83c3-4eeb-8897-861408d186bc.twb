            <column datatype='boolean' name='[real_transaction]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[current_own_qty]' derivation='Sum' name='[sum:current_own_qty:qk]' pivot='key' type='quantitative' />
