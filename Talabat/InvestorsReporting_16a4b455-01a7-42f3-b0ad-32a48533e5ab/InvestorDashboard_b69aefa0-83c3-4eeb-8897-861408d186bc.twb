      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E91D2B350584496DA17DA24482AB3C64'>
            <properties context=''>
              <relation connection='bigquery.1swl9q10pcoxb01cq2tjr1uyjn4t' name='Custom SQL Query' type='text'>WITH latest_date AS (
  SELECT MAX(report_date) AS max_report_date
  FROM `tlb-security-8603.investor_dashboard.sample_fct_investor_info`
),
latest_rows AS (
  SELECT
    investor_number,
    investor_name,
    client_type,
    nationality,
    previous_own_qty,
    current_own_qty,
    owned_qty_change,
    is_ipo_base,
    is_new_investor,
    report_date,
    ROW_NUMBER() OVER (PARTITION BY investor_number ORDER BY report_date DESC) AS rn
  FROM `tlb-security-8603.investor_dashboard.sample_fct_investor_info`
)
SELECT
  report_date,
  investor_number,
  investor_name,
  client_type,
  nationality,
  previous_own_qty,
  current_own_qty,
  owned_qty_change,
  is_ipo_base,
  is_new_investor,
  TRUE AS real_transaction
FROM `tlb-security-8603.investor_dashboard.sample_fct_investor_info`

UNION ALL

SELECT
  ld.max_report_date AS report_date,
  lr.investor_number,
  lr.investor_name,
  lr.client_type,
  lr.nationality,
  lr.previous_own_qty,
  lr.current_own_qty,
  lr.owned_qty_change,
  lr.is_ipo_base,
  lr.is_new_investor,
  FALSE AS real_transaction
FROM latest_rows lr
CROSS JOIN latest_date ld
WHERE lr.rn = 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
