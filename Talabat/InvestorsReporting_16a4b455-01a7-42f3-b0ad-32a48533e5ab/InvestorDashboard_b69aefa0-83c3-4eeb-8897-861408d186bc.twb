              <calculation class='tableau' formula='#2024-12-11#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0tvfmey1i87wku0zq7mt30ngyaca].[Calculation_4154781776505298981]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0tvfmey1i87wku0zq7mt30ngyaca].[report_date]' caption='End Date' datatype='date' name='[Start Date (copy)_4154781773008080896]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-18#'>
              <calculation class='tableau' formula='#2025-02-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tvfmey1i87wku0zq7mt30ngyaca'>
            <column caption='Sell' datatype='real' default-format='p0%' name='[Buy % (copy)_4154781775156277278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Sold Qty (copy)_4154781775153246232] / [Total New Investors (within selected period) (copy)_4154781775109582869]' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_4154781773008531457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 1] AND [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896] THEN&#10;    &quot;Selected&quot;&#10;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4154781773008080896]) - 1, [Parameters].[Parameter 1])&#10;    AND [report_date] &lt;= DATEADD(&apos;day&apos;, -DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4154781773008080896]) - 1, [Parameters].[Start Date (copy)_4154781773008080896]) THEN&#10;    &quot;Comparison&quot;&#10;&#10;ELSE&#10;    &quot;Remaining&quot;&#10;END' />
            </column>
            <column caption='Buy' datatype='real' default-format='p0%' name='[Calculation_4154781775156117533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Sell Transactions (copy)_4154781775153463321] / [Total New Investors (within selected period) (copy)_4154781775109582869]' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_4154781776505298981]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column caption='Min Date' datatype='date' datatype-customized='true' name='[Max Date (copy)_4154781776505462822]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MIN([report_date])}' />
            </column>
            <column caption='Total Transactions' datatype='integer' name='[Total New Investors (within selected period) (copy)_4154781775109582869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(if [Calculation_4154781773008531457] = &apos;Selected&apos; and [real_transaction] then [investor_number] end)' />
            </column>
            <column caption='Total Buy Transactions' datatype='integer' name='[Total Sell Transactions (copy)_4154781775153463321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [owned_qty_change] &gt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then [investor_number] end)' />
            </column>
            <column caption='Total Sell Transactions' datatype='integer' name='[Total Sold Qty (copy)_4154781775153246232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [owned_qty_change] &lt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then [investor_number] end)' />
            </column>
            <column datatype='integer' name='[current_own_qty]' role='measure' type='quantitative' />
            <column caption='Investor Number' datatype='string' name='[investor_number]' role='dimension' type='nominal' />
            <column-instance column='[investor_number]' derivation='None' name='[none:investor_number:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[owned_qty_change]' role='measure' type='quantitative' />
