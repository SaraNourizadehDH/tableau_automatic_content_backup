      <aliases enabled='yes' />
      <column caption='Sell' datatype='real' default-format='p0%' name='[Buy % (copy)_4154781775156277278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Sold Qty (copy)_4154781775153246232] / [Total New Investors (within selected period) (copy)_4154781775109582869]' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_4154781773008531457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 1] AND [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896] THEN&#10;    &quot;Selected&quot;&#10;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4154781773008080896]) - 1, [Parameters].[Parameter 1])&#10;    AND [report_date] &lt;= DATEADD(&apos;day&apos;, -DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4154781773008080896]) - 1, [Parameters].[Start Date (copy)_4154781773008080896]) THEN&#10;    &quot;Comparison&quot;&#10;&#10;ELSE&#10;    &quot;Remaining&quot;&#10;END' />
      </column>
      <column caption='Latest Transaction Date' datatype='date' name='[Calculation_4154781773013712898]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [investor_number] : MAX([report_date]) }' />
      </column>
      <column caption='Latest Qty per Investor' datatype='integer' name='[Calculation_4154781773015134211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [investor_number] :&#10;   MAX(&#10;     IF [report_date] = &#10;        { FIXED [investor_number] : MAX([report_date]) } &#10;     THEN [current_own_qty] &#10;     END&#10;   )&#10;}' />
      </column>
      <column caption='Latest Transaction Date Before or On Selected' datatype='date' name='[Calculation_4154781774346846212]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [investor_number] :&#10;   MAX(&#10;     IF [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896] THEN [report_date] END&#10;   )&#10;}' />
      </column>
      <column caption='Total Shares Owned as of Selected Date' datatype='integer' name='[Calculation_4154781774347169797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [investor_number] :&#10;   MAX(&#10;     IF [report_date] = &#10;         { FIXED [investor_number] :&#10;            MAX(IF [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896] THEN [report_date] END)&#10;         }&#10;     THEN [current_own_qty]&#10;     END&#10;   )&#10;}' />
      </column>
      <column caption='Total Investors' datatype='integer' name='[Calculation_4154781774683435016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896] then [investor_number] end)' />
      </column>
      <column caption='Total Bought Qty' datatype='integer' name='[Calculation_4154781774684119049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [owned_qty_change] &gt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; and [real_transaction] then [owned_qty_change] end)' />
      </column>
      <column caption='Ownership %' datatype='real' default-format='p0.0%' name='[Calculation_4154781775055892494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([owned_qty_change (copy)_4154781774688948237])/AVG([Calculation_4154781775056674831])' />
      </column>
      <column caption='Total Tradable Pool' datatype='integer' name='[Calculation_4154781775056674831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='22540647014' />
      </column>
      <column caption='Carry Forward Current Own Qty' datatype='integer' name='[Calculation_4154781775105462289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(sum([current_own_qty]))&#10;THEN PREVIOUS_VALUE(0)&#10;&#10;ELSE sum([current_own_qty])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Buy' datatype='real' default-format='p0%' name='[Calculation_4154781775156117533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Sell Transactions (copy)_4154781775153463321] / [Total New Investors (within selected period) (copy)_4154781775109582869]' />
      </column>
      <column caption='Transaction Type' datatype='string' name='[Calculation_4154781775403294751]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [owned_qty_change] &gt; 0 and [real_transaction] then &apos;Buy&apos; &#10;elseif [real_transaction] then &apos;Sell&apos; end' />
      </column>
      <column caption='Trend Selected period' datatype='boolean' name='[Calculation_4154781775407931424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896]' />
      </column>
      <column caption='New Investor ' datatype='boolean' name='[Calculation_4154781776504643620]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX([Total New Investors (copy)_4154781775433302051])' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_4154781776505298981]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([report_date])}' />
      </column>
      <column caption='Exclude IPO Date' datatype='boolean' name='[Calculation_4154781776510394408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date]&gt; [Max Date (copy)_4154781776505462822]' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_4154781776887373866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 14 day' datatype='boolean' name='[Exclude IPO Date (copy)_4154781776527130665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;=&#10;DATEADD(&apos;day&apos;, -14,[Parameters].[Start Date (copy)_4154781773008080896])&#10;and [report_date] &lt;= [Parameters].[Start Date (copy)_4154781773008080896]' />
      </column>
      <column caption='Min Date' datatype='date' datatype-customized='true' name='[Max Date (copy)_4154781776505462822]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([report_date])}' />
      </column>
      <column caption='Net Position' datatype='integer' name='[Net Position (copy)_4154781775432753185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_4154781773008531457] = &apos;Selected&apos; then [owned_qty_change] end' />
      </column>
      <column caption='Total Sold Qty' datatype='integer' name='[Total Bought Qty (copy)_4154781774684282890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [owned_qty_change] &lt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; and [real_transaction] then [owned_qty_change] end)' />
      </column>
      <column caption='Churned' datatype='boolean' name='[Total Churned Investors (copy)_4154781775433105442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [current_own_qty] = 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then true else false end' />
      </column>
      <column caption='Total Churned Investors' datatype='integer' name='[Total IPO Investors (copy)_4154781774684676108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [current_own_qty] = 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then [investor_number] end)' />
      </column>
      <column caption='Total New Investors' datatype='integer' name='[Total Investors (copy)_4154781774684459019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_4154781773008531457] = &apos;Selected&apos; and [is_new_investor] then [investor_number] end)' />
      </column>
      <column caption='New Investor' datatype='boolean' name='[Total New Investors (copy)_4154781775433302051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_4154781773008531457] = &apos;Selected&apos; and [is_new_investor] then true else false end' />
      </column>
      <column caption='Total Transactions' datatype='integer' name='[Total New Investors (within selected period) (copy)_4154781775109582869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [Calculation_4154781773008531457] = &apos;Selected&apos; and [real_transaction] then [investor_number] end)' />
      </column>
      <column caption='Total Buy Transactions' datatype='integer' name='[Total Sell Transactions (copy)_4154781775153463321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if [owned_qty_change] &gt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then [investor_number] end)' />
      </column>
      <column caption='Total Sell Transactions' datatype='integer' name='[Total Sold Qty (copy)_4154781775153246232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if [owned_qty_change] &lt; 0 and [Calculation_4154781773008531457] = &apos;Selected&apos; then [investor_number] end)' />
      </column>
      <column caption='Total Transactions (Lifetime)' datatype='integer' name='[Total Transactions (copy)_4154781776509997095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [real_transaction] then [investor_number] end)' />
