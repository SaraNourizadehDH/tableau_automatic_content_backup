AND DATE_DIFF( fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN CASE WHEN dim_vendor_info.is_tgo THEN 0 ELSE (CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END) END
