    <worksheet name='Admin Productivity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='12'>Admin Productivity Score Card</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Admin Productivity Score Card' name='federated.1oec8k80e272vs18xhoer1tmpmse' />
          </datasources>
          <datasource-dependencies datasource='federated.1oec8k80e272vs18xhoer1tmpmse'>
            <column caption='Vendors taken live' datatype='integer' name='[Calculation_3570369386208612352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Avg shipment time (days)' datatype='integer' name='[Calculation_3570369386208940033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[shipment_request_started_at],[shipment_delivered_at])' />
            </column>
            <column caption='Avg onboarding time (day)' datatype='integer' name='[Calculation_3570369386209062914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[onboarding_case_created_at],[onboarding_case_closed_at])' />
            </column>
            <column caption='onboarding + shipment time' datatype='real' name='[Calculation_3570369386209234947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(avg((IFNULL([Calculation_3570369386209062914],0) )))+avg((IFNULL([Calculation_3570369386208940033],0)))' />
            </column>
            <column caption='onb time ranks' datatype='integer' name='[Calculation_3570369386209353732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_3570369386209234947],&apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='VFR 0_30 days' datatype='real' name='[Calculation_3570369386209615877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([vendor_failed_orders_0_30])/sum([net_order_0_30]),0)' />
            </column>
            <column caption='vfr ranks' datatype='integer' name='[Calculation_3570369386209722374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_3570369386209615877],&apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='self onboarded?' datatype='string' name='[Calculation_3570369386209992711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if lower([sales_admin_name]) &lt;&gt; &quot;self onboarded&quot; then &quot;Not Self onboarded&quot; else &quot;Self onboarded&quot; end' />
            </column>
            <column caption='Total vendors' datatype='integer' name='[Calculation_3570369386210275336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [onboarding_month],[country], [case_type],[vertical],[Calculation_3570369386209992711] : [Calculation_3570369386208612352]}' />
            </column>
            <column caption='Trained vendors %' datatype='real' name='[Calculation_3570369386210385929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])/ SUM([Calculation_3570369386210275336])' />
            </column>
            <column caption='vendor perc ranks ' datatype='integer' name='[Calculation_3570369386210525194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_3570369386210385929],&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='wtd score' datatype='real' name='[Calculation_3570369386210676747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_3570369386210385929] &gt;0.05 &#10;then (([Calculation_3570369386210525194] *0.20) &#10;+([Calculation_3570369386209722374] *0.70) + ([Calculation_3570369386209353732]*0.10))&#10;else 0 end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Final rank' datatype='integer' name='[Calculation_3570369386210787340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_3570369386210676747] = 0 then 0 else RANK_UNIQUE([Calculation_3570369386210676747],&apos;asc&apos;)  end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Eligible for scoring?' datatype='boolean' name='[Calculation_3570369386210914317]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3570369386210787340] &gt; 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='UMI failed orders %' datatype='real' name='[Calculation_3570369386213912590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([umi_vendor_failed_orders_0_30])/sum([net_order_0_30]),0)' />
            </column>
            <column caption='max limit' datatype='integer' name='[Calculation_3570369386214346767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_3570369386210787340]  &lt; 1 then WINDOW_COUNT([Calculation_3570369386210787340]) else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='count of zeros' datatype='integer' name='[Calculation_3570369386214453264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_COUNT([Calculation_3570369386214346767])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Final Ranks' datatype='integer' name='[Calculation_3570369386214518801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3570369386210787340] - [Calculation_3570369386214453264]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Final ranks' datatype='integer' name='[Calculation_3570369386214576146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_3570369386214518801] &lt; 0 then 0 else [Calculation_3570369386214518801] end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[case_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[onboarding_month]' derivation='MY' name='[my:onboarding_month:ok]' pivot='key' type='ordinal' />
