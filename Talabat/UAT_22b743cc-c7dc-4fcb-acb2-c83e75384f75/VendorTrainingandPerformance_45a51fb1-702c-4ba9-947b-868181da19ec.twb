            <column caption='VFR 0 to 30 day' datatype='real' name='[Calculation_3980971025521131520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum([net_order_0_30])' />
            </column>
            <column caption='VFR 30 to 60 day' datatype='real' name='[Calculation_3980971025521287169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_30_60]) / sum([net_order_30_60])' />
            </column>
            <column caption='VFR 60 to 90 day' datatype='real' name='[Calculation_3980971025521442818]' role='measure' type='quantitative'>
