                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>#Trained Vendors: </run>
                  <run fontcolor='#411517' fontsize='11'>vendors case closed by admin</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>#Staff Training Completion: </run>
                  <run fontcolor='#411517' fontsize='11'>vendors case closed by admin &amp; staff ticked right</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>#Manager Training Completion: </run>
                  <run fontcolor='#411517' fontsize='11'>vendors case closed by admin &amp; manager ticked right</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>vFR%: </run>
                  <run fontcolor='#411517' fontsize='11'>vendor failed orders / total orders </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>Offline Rate%: </run>
                  <run fontcolor='#411517' fontsize='11'>offline duration / actual duration</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>Vendor Delay: </run>
                  <run fontcolor='#411517' fontsize='11'>TGO orders delayed more than 10 minutes / all orders delayed </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff6a07' fontsize='11'>FIR Usage%: </run>
