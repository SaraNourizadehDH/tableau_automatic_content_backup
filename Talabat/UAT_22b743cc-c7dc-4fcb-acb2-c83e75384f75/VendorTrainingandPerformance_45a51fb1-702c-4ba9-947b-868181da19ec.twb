              <calculation class='tableau' formula='SUM([numerator_0_30d])/SUM([denominator_0_30d])' />
            </column>
            <column caption='VFR 0 to 30 day' datatype='real' name='[Calculation_3980971025521131520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum([net_order_0_30])' />
