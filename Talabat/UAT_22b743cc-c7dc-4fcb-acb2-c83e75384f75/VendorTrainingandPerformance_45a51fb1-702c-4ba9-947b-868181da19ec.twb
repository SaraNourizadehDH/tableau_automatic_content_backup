      <column caption='Scheduled Time Agg' datatype='integer' name='[Calculation_3570369389385379878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id],[month] : max([scheduled_duration_in_seconds])}' />
      </column>
      <column caption='Offline Rate %' datatype='real' name='[Calculation_3570369389385498663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actual_offline_duration_in_seconds]) / sum([Calculation_3570369389385379878])' />
      </column>
      <column caption='SF Status' datatype='boolean' name='[Calculation_3570369389388554280]' role='dimension' type='nominal'>
