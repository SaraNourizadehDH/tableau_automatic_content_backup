    <worksheet name='Fail Reasons Vendor List'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Fail Reasons List</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_training' name='federated.0iuj17h17ugp8y1cglnen1qi3w0v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Format' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iuj17h17ugp8y1cglnen1qi3w0v'>
            <column caption='failures' datatype='integer' name='[Calculation_3570369388677980187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fct_order_info_net_failed_orders_count])' />
            </column>
            <column caption='all fixed fail reasons' datatype='integer' name='[Calculation_3570369388678578204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code (Custom SQL Query2)], [dim_vendor_info_first_online_month], [vendor_id (Custom SQL Query2)]&#10;    : SUM([fct_order_info_net_failed_orders_count]) }' />
            </column>
            <column caption='Fixed percentage' datatype='real' name='[Calculation_3570369388678684701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3570369388677980187] / SUM([Calculation_3570369388678578204])' />
            </column>
            <column caption='Training Logic' datatype='string' name='[Calculation_3980971026449149980]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [training_provided__c] = &quot;Yes&quot;&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF ISNULL([training_provided__c])&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;Yes&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;No&quot;&#10;   AND [case_modified_by_name] &lt;&gt; &quot;API Vendor Onboarding&quot; THEN &quot;Not Trained&quot;&#10;&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='Format Group' datatype='string' name='[Calculation_656047854591127567]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Percentage&quot; THEN STR(ROUND([Calculation_3570369388678684701]*100,2)) + &quot;%&quot;&#10;    WHEN &quot;Absolute&quot; THEN STR(SUM([fct_order_info_net_failed_orders_count]))&#10;END' />
            </column>
            <column datatype='string' name='[case_modified_by_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code (Custom SQL Query2)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[dim_order_fail_reason_talabat_reason]' role='dimension' type='nominal' />
            <column datatype='string' name='[dim_vendor_info_first_online_month]' role='dimension' type='nominal' />
            <column datatype='integer' name='[fct_order_info_net_failed_orders_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3980971026449149980]' derivation='None' name='[none:Calculation_3980971026449149980:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code (Custom SQL Query2)]' derivation='None' name='[none:country_code (Custom SQL Query2):nk]' pivot='key' type='nominal' />
            <column-instance column='[dim_order_fail_reason_talabat_reason]' derivation='None' name='[none:dim_order_fail_reason_talabat_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[dim_vendor_info_first_online_month]' derivation='None' name='[none:dim_vendor_info_first_online_month:nk]' pivot='key' type='nominal' />
