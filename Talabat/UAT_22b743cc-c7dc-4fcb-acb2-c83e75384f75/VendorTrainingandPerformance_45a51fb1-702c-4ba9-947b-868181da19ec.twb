              <calculation class='tableau' formula='[order_failure]/[offline_duration_in_hours_0_30]' />
            </column>
            <column caption='Ownership Change' datatype='real' name='[Calculation_3570369389759164471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ownership_change]/[offline_duration_in_hours_0_30]' />
