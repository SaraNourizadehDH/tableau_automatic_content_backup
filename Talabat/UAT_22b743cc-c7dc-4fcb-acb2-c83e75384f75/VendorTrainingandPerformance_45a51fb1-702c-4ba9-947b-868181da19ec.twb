 'Request: order will take longer than expected','Complain about late order','Complaint about severe delay','Extreme Delay','Moderate Delay','Severe Delay','Short Delay')
AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN (CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END) ELSE 0 END), 0)
