THEN 0.001 ELSE 0 END AS BIGNUMERIC)))
- SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 31 AND 60 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 31 AND 60 THEN fct_order_info.order_id END AS STRING))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001 AS NUMERIC),0),6)
) AS fct_contact_vf_customer_contact_rate_30_60d,

-- Customer contact rate, 60–90d since first_online 
SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id = 1 AND NOT dim_vendor_info.is_tgo AND dim_contact_reason.contact_reason_l3 IN (
