        </members>
      </column>
      <column caption='Metric Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline time (hour)&quot;'>
        <calculation class='tableau' formula='&quot;Offline time (hour)&quot;' />
        <members>
          <member value='&quot;Offline time (hour)&quot;' />
          <member value='&quot;Vendors&quot;' />
