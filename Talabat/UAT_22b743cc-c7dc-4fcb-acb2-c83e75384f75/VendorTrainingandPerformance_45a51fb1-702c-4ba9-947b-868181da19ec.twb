    </datasource>
    <datasource caption='Admin Productivity Score Card' inline='true' name='federated.1oec8k80e272vs18xhoer1tmpmse' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0insxms0om5q9v1158nx91akc13u'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground' server-oauth='' username='elisabeth.jouaneh@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0insxms0om5q9v1158nx91akc13u' name='Custom SQL Query' type='text'><![CDATA[with admin as
(WITH
  salesforce_opportunity AS (
  WITH
    opp AS (
    SELECT
      o.id,
      o.global_entity_id,
      o.name,
      a.grid__c AS salesforce_id,
      i.vendor_id,
      CASE
        WHEN LOWER(o.name) LIKE '%test%' THEN TRUE
      ELSE
      FALSE
    END
      is_test_opportunity,
      CASE
        WHEN LOWER(o.name) LIKE '%photo%' THEN TRUE
      ELSE
      FALSE
    END
      is_photo_related,
      o.accountid,
      o.type,
      o.business_type__c AS business_type,
      o.ownerid,
      o.closedate,
      o.stagename,
    IF
      (o.lost_reason__c='None', NULL, o.lost_reason__c) lost_reason__c,
    IF
      (o.leadsource = 'None', NULL, o.leadsource) lead_source,
      o.iswon,
      o.createdbyid,
      o.createddate,
      o.recordtypeid,
      a.vendor_grade__c,
      CONCAT(u.firstname, ' ', u.lastname) opportunity_owner_name,
      u.title opportunity_owner_title,
      a.vertical__c AS vertical,
      a.vertical_segment__c AS vertical_segment,
      a.key_vip_account__c key_vip_account,
      a.record_country__c country,
      dl.city_name,
      a.account_status__c,
      u.central_job_role__c
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
    ON
      a.id = o.accountid
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
    ON
      u.id = o.ownerid
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_vendor_info` i
    ON
      i.salesforce_id = a.grid__c
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_location_info` dl
    ON
      dl.location_id = i.location_id )
  SELECT
    *
  FROM
    opp ),
  cases AS (
  SELECT
    c.global_entity_id,
    c.id,
    grid_fm__c,
    opportunity__c,
    status,
    closed_reason__c,
    reason,
    casenumber,
    c.accountid,
    closeddate,
    c.createddate,
    c.type,
    ownerid,
    CONCAT(u.firstname, ' ', u.lastname) AS sales_admin_name,
    u.title AS sales_admin_title,
    origin,
    c.lastmodifiedbyid,
    CONCAT(ul.firstname, ' ', ul.lastname) AS case_modified_by_name,

    ROW_NUMBER() OVER (PARTITION BY c.global_entity_id, opportunity__c ORDER BY c.createddate DESC) sales_admin_rank_desc,
        ROW_NUMBER() OVER (PARTITION BY c.global_entity_id, opportunity__c ORDER BY c.createddate asc) sales_admin_rank_asc

  FROM
    `fulfillment-dwh-production.curated_data_shared_salesforce.case` c
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  ON
    c.ownerid = u.id
      LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.user` ul on ul.id = c.lastmodifiedbyid
  -- WHERE
  --   c.type = 'Onboarding'
   ),

 final as (
select * from 
(
SELECT
  o.*,
  c.id case_id,
  c.ownerid case_owner_id,
  c.createddate onboarding_case_created_at,
  c.closeddate onboarding_case_closed_at,
  -- c.status,
  closed_reason__c,
  c.reason,
  c.sales_admin_name,
  c.sales_admin_title,
  c.sales_admin_rank_desc,
  c.sales_admin_rank_asc,
  c.lastmodifiedbyid as lastmodifiedbyid,
  c.case_modified_by_name,
  c.type as case_type
FROM
  salesforce_opportunity o
LEFT JOIN
  cases c
ON
  c.global_entity_id = o.global_entity_id
  AND c.opportunity__c = o.id
WHERE
  o.business_type IN ('Franchise Extension',
    'New Business',
    'Switch',
    'Win Back')
  AND iswon
 AND closedate >>= CURRENT_DATE() - INTERVAL 12 month
 --AND o.id ='0061r00000zTZN3AAO' -- test
  --AND o.salesforce_id ='HZMYSI'
)
where sales_admin_rank_desc = 1 
 )

 select 
 id as opportunity_id,
global_entity_id,
name as vendor_name,
salesforce_id,
vendor_id,
is_test_opportunity,
accountid,
type,
business_type,
ownerid,
closedate,
stagename,
lost_reason__c,
lead_source,
iswon,
createdbyid,
createddate,
recordtypeid,
vendor_grade__c,
opportunity_owner_name,
opportunity_owner_title,
vertical,
vertical_segment,
key_vip_account,
country,
city_name,
account_status__c,
case_id,
case_owner_id,
case_type,
onboarding_case_created_at,
onboarding_case_closed_at,
date_trunc(date(onboarding_case_closed_at),month) as onboarding_month,
closed_reason__c,
reason,
sales_admin_name,
sales_admin_title,
sales_admin_rank_desc,
sales_admin_rank_asc,
case_modified_by_name,
central_job_role__c
 
from final),

 shipment AS (
    WITH
    shipment AS(
    SELECT
    distinct
      c.id,
      c.account__c,
      a.grid__c,
      c.createddate,
      status__c,
      type__c,
      opportunity__c,
      h.createddate shipment_history_date,
      -- MIN(c.createddate) OVER(PARTITION BY c.id) shipment_history_date,
      newvalue,
      oldvalue,
      MIN(c.createddate) OVER(PARTITION BY c.id) shipment_started_at,
      MAX(h.createddate) OVER(PARTITION BY c.id) shimpent_ended_at,
      TIMESTAMP_DIFF(MAX(h.createddate) OVER(PARTITION BY c.id),MIN(c.createddate) OVER(PARTITION BY c.id), MINUTE) shipment_duration_in_mins,
      ROW_NUMBER() OVER(PARTITION BY c.id ORDER BY h.createddate DESC) modifier
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.shipment_order__c` c
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
    ON
      c.account__c = a.id
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.shipment_order__history` h
    ON
      h.parentid = c.id
      AND field = 'Status__c'
      AND type__c = 'DH to Vendor' 
      -- where a.grid__c = 'HW1OYM' and 
      where 
      newvalue = 'Delivered'
      )
  SELECT
    *EXCEPT (modifier,
      oldvalue)
  FROM
    shipment
  WHERE
    modifier = 1) ,

  salesforce_vendors as 
(
  select 
    v.*,
    sf.vendor_grade,
    sf.status,
    sf.sf_country,
    sf.sf_city
  from 
  (
    (
      select 
      
        dv.vendor_id,
        vendor_name,
        first_online_date,
        dv.salesforce_id,
        main_cuisine,
        chain_name,
        l.country_code,
        is_exclusive,
        dv.is_non_food,
        vertical,
        city_name
      from `tlb-data-prod.data_platform.dim_vendor_info` dv
      left join `tlb-data-prod.data_platform.dim_chain` ch on dv.chain_id = ch.chain_id
      left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = dv.location_id 
    )v
    left join 
    (
      select
        grid__c,
        a.country_code as sf_country, 
        a.restaurant_city__c as sf_city,
        account_status__c as status,
        vendor_grade__c as vendor_grade
        from `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
        left join `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c ON a.id = c.accountid
        
        where account_status__c in ('Active', 'Terminated')     
        group by 1,2,3,4,5

    ) sf
    on sf.grid__c = v.salesforce_id 
  )
),

new_vendor as
(
  select 
    o.country_iso,
    o.vendor_id,
    vendor_name,
    order_id as first_order_id,
    order_date  as first_order_date,
    first_online_date,
    main_cuisine,
    chain_name,
    i.salesforce_id
  from `tlb-data-prod.data_platform.fct_order` o 
  left join `tlb-data-prod.data_platform.dim_vendor_info` i on i.vendor_id = o.vendor_id 
  left join `tlb-data-prod.data_platform.dim_chain` ch on i.chain_id = ch.chain_id
  left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = i.location_id 
  where --o.is_successful = true 
  date_trunc(order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
  qualify row_number() over (partition BY o.vendor_id order by order_date asc) = 1
),
succ_new_vendor as
(
  select 
    o.country_iso,
    o.vendor_id,
    vendor_name,
    order_id as first_order_id,
    order_date as successful_first_order_date,
    first_online_date,
    main_cuisine,
    chain_name,
    i.salesforce_id
  from `tlb-data-prod.data_platform.fct_order` o 
  left join `tlb-data-prod.data_platform.dim_vendor_info` i on i.vendor_id = o.vendor_id 
  left join `tlb-data-prod.data_platform.dim_chain` ch on i.chain_id = ch.chain_id
  left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = i.location_id 
  where o.is_successful = true 
  and date_trunc(order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
  qualify row_number() over (partition BY o.vendor_id order by order_date asc) = 1
),

orders as 
(
  select 
  o.order_id,
  o.vendor_id,
  o.is_successful,
  o.order_date,
  o.order_time,
  o.analytical_customer_id,
  s.is_net,
  r.owner,
  l.vendor_responce_time,
  l.vendor_preparation_minutes,
  s.is_canceled_by_vendor,
  s.is_sent,
  l.vendor_late,
  r.talabat_reason,
  o.is_tgo,
  o.gmv_amount_eur as gmv,
  o.is_test,
  r.reason,
  l.fir_used,
  l.order_code,
  l.primary_rider_near_restaurant_at

from `tlb-data-prod.data_platform.fct_order` o  
left join `tlb-data-prod.data_platform.fct_order_info`  i on o.order_id = i.order_id
left join `tlb-data-prod.data_platform.dim_order_status` s on s.order_status_id = o.order_status_id 
left join  `tlb-data-prod.data_platform.dim_order_fail_reason` r on r.order_fail_reason_id = i.order_fail_reason_id
left join `tlb-data-prod.data_platform.fct_logistics_order` l on l.order_id = o.order_id 
where  date_trunc(o.order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
),

first_order_metrics as 
(
  select 
  n.vendor_id,
  is_successful as fo_is_successful,
  talabat_reason as fo_fail_reason,
  o.is_test as fo_is_test,
  count(distinct o.order_id) as total_first_order,
  count(distinct(case when is_successful = true then o.order_id else null end)) as successful_first_orders,
  count(distinct(CASE WHEN  is_net   AND NOT  o.is_successful   AND  owner   = 'VENDOR' THEN  o.order_id   ELSE null END )) as first_order_vendor_failed, 
  count(distinct(case when is_successful = true then n.vendor_id else null end)) as successful_vendors,
  sum(case when (is_successful = true and  (vendor_responce_time/60)>>3) then 1 else 0   end  ) AS first_order_response_time_abv_3min,
  avg(case when (o.is_successful = true)  then  (vendor_responce_time/60)  else 0   end  ) AS fo_response_time,
  COALESCE(SUM(CASE WHEN ( is_canceled_by_vendor  ) AND ( is_sent ) THEN 1  ELSE NULL END), 0) AS first_order_vendor_cancelled,
  AVG(case when o.is_successful = true then vendor_preparation_minutes else null end  ) AS fo_avg_vendor_preparation_minutes,
  sum( CASE WHEN (( vendor_late/60  ) >> 10) THEN 1  ELSE 0 END) AS fo_vendor_delay_10mins_orders,
  sum( CASE WHEN (( vendor_late/60  ) >> 5) THEN 1  ELSE 0 END) AS fo_vendor_delay_5min,
  count(distinct(CASE WHEN  is_net   THEN  o.order_id   ELSE null END )) as net_orders

  from 
  new_vendor n join orders o on n.first_order_id = o.order_id --and n.vendor_id = o.vendor_id
  left join succ_new_vendor s on s.vendor_id = n.vendor_id 
  group by 1,2,3,4 
),

first_month as 
(
  select 
  o.vendor_id,
  count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day ) then  o.order_id else null end )) as total_order_0_30_day,
  count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true )then o.analytical_customer_id else null end )) as customers_0_30_day,
count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true) then o.order_id else null end )) as successful_order_0_30_day,
COALESCE(SUM(CASE WHEN  (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_net   AND NOT  is_successful   AND  o.owner   = 'VENDOR') THEN  1   ELSE 0 END ), 0) AS  vendor_failed_orders_0_30,

COALESCE(SUM(CASE WHEN  (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_net   AND NOT  is_successful and lower(o.reason) in ("unavailable menu item","unavailable menu items")  AND  o.owner   = 'VENDOR') THEN  1   ELSE 0 END ), 0) AS  umi_vendor_failed_orders_0_30,


sum(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true and  (vendor_responce_time/60)>>3) then 1 else 0   end  ) AS response_time_abv_3min_0_30,
sum( CASE WHEN ((o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and (vendor_late/60  ) >> 10) THEN 1  ELSE 0 END) AS vendor_delay_10mins_orders_0_30,
avg(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true)  then  (vendor_responce_time/60)  else 0   end  ) AS avg_response_time_0_30,
COALESCE(SUM(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_canceled_by_vendor   AND  is_sent ) THEN 1  ELSE NULL END), 0) AS vendor_cancelled_0_30,
AVG(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true) then vendor_preparation_minutes else null end  ) AS avg_vendor_preparation_minutes_0_30,
COALESCE(SUM(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day)  THEN gmv  ELSE NULL END), 0) AS vendor_gmv_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   is_net  THEN o.order_id  ELSE null END))) AS net_order_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   fir_used = true   THEN o.order_code  ELSE null END))) AS fir_used_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   primary_rider_near_restaurant_at   IS NOT NULL  THEN o.order_code  ELSE null END))) AS fir_used_den_0_30


  from admin sf 
  join new_vendor n on sf.salesforce_id = n.salesforce_id 
  join orders o on o.vendor_id = sf.vendor_id 
  group by 1 
)

select
a.*,
sf.vendor_grade,
sf.main_cuisine,
--sf.vertical,
--sf.vendor_name,
--sf.vendor_id,
sf.status,
sf.first_online_date,
sf.chain_name,
sf.is_non_food,
sf.is_exclusive,
n.first_order_date as first_order_date,
s.successful_first_order_date as successful_first_order_date,
fo.* except(vendor_id),
fm.* except (vendor_id),
CASE WHEN lower(business_type) in ("win back","switch") and date(first_order_date) << date(onboarding_case_closed_at) then "not activated after wb/switch" else "others" end as wb_switch_fo_date_lower_than_online_date_sanity_flag,
CASE WHEN lower(business_type) not in ("win back","switch") and  date(first_order_date) << date(onboarding_case_closed_at) then "took order before successful onboarding" else "others" end as order_before_successful_onb_sanity_flag,
CASE WHEN date(first_order_date) << date(onboarding_case_closed_at) then 0 else 1 end as onb_sanity_flag,
sh.newvalue as shipment_delivered,
shipment_started_at as shipment_request_started_at,
shimpent_ended_at as shipment_delivered_at,
shipment_duration_in_mins,
case when case_modified_by_name = "API Vendor Onboarding" then "SSU" else "other" end as SSU_tag

from 
  (
 select 
*
 from 
 (

 select 
*,
 row_number() over(partition by salesforce_id order by closedate desc) as noe
 from admin
 )
 where noe =1 
 --and country = "United Arab Emirates"
 and date_trunc(closedate,month) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
 ) a
left join salesforce_vendors sf on sf.salesforce_id = a.salesforce_id
left join new_vendor n on n.vendor_id = a.vendor_id
left join succ_new_vendor s on s.vendor_id = a.vendor_id
left join first_order_metrics fo on fo.vendor_id = a.vendor_id 
left join first_month fm on fm.vendor_id = a.vendor_id
left join shipment sh on sh.grid__c = a.salesforce_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0insxms0om5q9v1158nx91akc13u' name='Custom SQL Query' type='text'><![CDATA[with admin as
(WITH
  salesforce_opportunity AS (
  WITH
    opp AS (
    SELECT
      o.id,
      o.global_entity_id,
      o.name,
      a.grid__c AS salesforce_id,
      i.vendor_id,
      CASE
        WHEN LOWER(o.name) LIKE '%test%' THEN TRUE
      ELSE
      FALSE
    END
      is_test_opportunity,
      CASE
        WHEN LOWER(o.name) LIKE '%photo%' THEN TRUE
      ELSE
      FALSE
    END
      is_photo_related,
      o.accountid,
      o.type,
      o.business_type__c AS business_type,
      o.ownerid,
      o.closedate,
      o.stagename,
    IF
      (o.lost_reason__c='None', NULL, o.lost_reason__c) lost_reason__c,
    IF
      (o.leadsource = 'None', NULL, o.leadsource) lead_source,
      o.iswon,
      o.createdbyid,
      o.createddate,
      o.recordtypeid,
      a.vendor_grade__c,
      CONCAT(u.firstname, ' ', u.lastname) opportunity_owner_name,
      u.title opportunity_owner_title,
      a.vertical__c AS vertical,
      a.vertical_segment__c AS vertical_segment,
      a.key_vip_account__c key_vip_account,
      a.record_country__c country,
      dl.city_name,
      a.account_status__c,
      u.central_job_role__c
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
    ON
      a.id = o.accountid
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
    ON
      u.id = o.ownerid
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_vendor_info` i
    ON
      i.salesforce_id = a.grid__c
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_location_info` dl
    ON
      dl.location_id = i.location_id )
  SELECT
    *
  FROM
    opp ),
  cases AS (
  SELECT
    c.global_entity_id,
    c.id,
    grid_fm__c,
    opportunity__c,
    status,
    closed_reason__c,
    reason,
    casenumber,
    c.accountid,
    closeddate,
    c.createddate,
    c.type,
    ownerid,
    CONCAT(u.firstname, ' ', u.lastname) AS sales_admin_name,
    u.title AS sales_admin_title,
    origin,
    c.lastmodifiedbyid,
    CONCAT(ul.firstname, ' ', ul.lastname) AS case_modified_by_name,

    ROW_NUMBER() OVER (PARTITION BY c.global_entity_id, opportunity__c ORDER BY c.createddate DESC) sales_admin_rank_desc,
        ROW_NUMBER() OVER (PARTITION BY c.global_entity_id, opportunity__c ORDER BY c.createddate asc) sales_admin_rank_asc

  FROM
    `fulfillment-dwh-production.curated_data_shared_salesforce.case` c
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  ON
    c.ownerid = u.id
      LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.user` ul on ul.id = c.lastmodifiedbyid
  -- WHERE
  --   c.type = 'Onboarding'
   ),

 final as (
select * from 
(
SELECT
  o.*,
  c.id case_id,
  c.ownerid case_owner_id,
  c.createddate onboarding_case_created_at,
  c.closeddate onboarding_case_closed_at,
  -- c.status,
  closed_reason__c,
  c.reason,
  c.sales_admin_name,
  c.sales_admin_title,
  c.sales_admin_rank_desc,
  c.sales_admin_rank_asc,
  c.lastmodifiedbyid as lastmodifiedbyid,
  c.case_modified_by_name,
  c.type as case_type
FROM
  salesforce_opportunity o
LEFT JOIN
  cases c
ON
  c.global_entity_id = o.global_entity_id
  AND c.opportunity__c = o.id
WHERE
  o.business_type IN ('Franchise Extension',
    'New Business',
    'Switch',
    'Win Back')
  AND iswon
 AND closedate >>= CURRENT_DATE() - INTERVAL 12 month
 --AND o.id ='0061r00000zTZN3AAO' -- test
  --AND o.salesforce_id ='HZMYSI'
)
where sales_admin_rank_desc = 1 
 )

 select 
 id as opportunity_id,
global_entity_id,
name as vendor_name,
salesforce_id,
vendor_id,
is_test_opportunity,
accountid,
type,
business_type,
ownerid,
closedate,
stagename,
lost_reason__c,
lead_source,
iswon,
createdbyid,
createddate,
recordtypeid,
vendor_grade__c,
opportunity_owner_name,
opportunity_owner_title,
vertical,
vertical_segment,
key_vip_account,
country,
city_name,
account_status__c,
case_id,
case_owner_id,
case_type,
onboarding_case_created_at,
onboarding_case_closed_at,
date_trunc(date(onboarding_case_closed_at),month) as onboarding_month,
closed_reason__c,
reason,
sales_admin_name,
sales_admin_title,
sales_admin_rank_desc,
sales_admin_rank_asc,
case_modified_by_name,
central_job_role__c
 
from final),

 shipment AS (
    WITH
    shipment AS(
    SELECT
    distinct
      c.id,
      c.account__c,
      a.grid__c,
      c.createddate,
      status__c,
      type__c,
      opportunity__c,
      h.createddate shipment_history_date,
      -- MIN(c.createddate) OVER(PARTITION BY c.id) shipment_history_date,
      newvalue,
      oldvalue,
      MIN(c.createddate) OVER(PARTITION BY c.id) shipment_started_at,
      MAX(h.createddate) OVER(PARTITION BY c.id) shimpent_ended_at,
      TIMESTAMP_DIFF(MAX(h.createddate) OVER(PARTITION BY c.id),MIN(c.createddate) OVER(PARTITION BY c.id), MINUTE) shipment_duration_in_mins,
      ROW_NUMBER() OVER(PARTITION BY c.id ORDER BY h.createddate DESC) modifier
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.shipment_order__c` c
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
    ON
      c.account__c = a.id
    LEFT JOIN
      `fulfillment-dwh-production.curated_data_shared_salesforce.shipment_order__history` h
    ON
      h.parentid = c.id
      AND field = 'Status__c'
      AND type__c = 'DH to Vendor' 
      -- where a.grid__c = 'HW1OYM' and 
      where 
      newvalue = 'Delivered'
      )
  SELECT
    *EXCEPT (modifier,
      oldvalue)
  FROM
    shipment
  WHERE
    modifier = 1) ,

  salesforce_vendors as 
(
  select 
    v.*,
    sf.vendor_grade,
    sf.status,
    sf.sf_country,
    sf.sf_city
  from 
  (
    (
      select 
      
        dv.vendor_id,
        vendor_name,
        first_online_date,
        dv.salesforce_id,
        main_cuisine,
        chain_name,
        l.country_code,
        is_exclusive,
        dv.is_non_food,
        vertical,
        city_name
      from `tlb-data-prod.data_platform.dim_vendor_info` dv
      left join `tlb-data-prod.data_platform.dim_chain` ch on dv.chain_id = ch.chain_id
      left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = dv.location_id 
    )v
    left join 
    (
      select
        grid__c,
        a.country_code as sf_country, 
        a.restaurant_city__c as sf_city,
        account_status__c as status,
        vendor_grade__c as vendor_grade
        from `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
        left join `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c ON a.id = c.accountid
        
        where account_status__c in ('Active', 'Terminated')     
        group by 1,2,3,4,5

    ) sf
    on sf.grid__c = v.salesforce_id 
  )
),

new_vendor as
(
  select 
    o.country_iso,
    o.vendor_id,
    vendor_name,
    order_id as first_order_id,
    order_date  as first_order_date,
    first_online_date,
    main_cuisine,
    chain_name,
    i.salesforce_id
  from `tlb-data-prod.data_platform.fct_order` o 
  left join `tlb-data-prod.data_platform.dim_vendor_info` i on i.vendor_id = o.vendor_id 
  left join `tlb-data-prod.data_platform.dim_chain` ch on i.chain_id = ch.chain_id
  left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = i.location_id 
  where --o.is_successful = true 
  date_trunc(order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
  qualify row_number() over (partition BY o.vendor_id order by order_date asc) = 1
),
succ_new_vendor as
(
  select 
    o.country_iso,
    o.vendor_id,
    vendor_name,
    order_id as first_order_id,
    order_date as successful_first_order_date,
    first_online_date,
    main_cuisine,
    chain_name,
    i.salesforce_id
  from `tlb-data-prod.data_platform.fct_order` o 
  left join `tlb-data-prod.data_platform.dim_vendor_info` i on i.vendor_id = o.vendor_id 
  left join `tlb-data-prod.data_platform.dim_chain` ch on i.chain_id = ch.chain_id
  left join `tlb-data-prod.data_platform.dim_location_info` l on l.location_id = i.location_id 
  where o.is_successful = true 
  and date_trunc(order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
  qualify row_number() over (partition BY o.vendor_id order by order_date asc) = 1
),

orders as 
(
  select 
  o.order_id,
  o.vendor_id,
  o.is_successful,
  o.order_date,
  o.order_time,
  o.analytical_customer_id,
  s.is_net,
  r.owner,
  l.vendor_responce_time,
  l.vendor_preparation_minutes,
  s.is_canceled_by_vendor,
  s.is_sent,
  l.vendor_late,
  r.talabat_reason,
  o.is_tgo,
  o.gmv_amount_eur as gmv,
  o.is_test,
  r.reason,
  l.fir_used,
  l.order_code,
  l.primary_rider_near_restaurant_at

from `tlb-data-prod.data_platform.fct_order` o  
left join `tlb-data-prod.data_platform.fct_order_info`  i on o.order_id = i.order_id
left join `tlb-data-prod.data_platform.dim_order_status` s on s.order_status_id = o.order_status_id 
left join  `tlb-data-prod.data_platform.dim_order_fail_reason` r on r.order_fail_reason_id = i.order_fail_reason_id
left join `tlb-data-prod.data_platform.fct_logistics_order` l on l.order_id = o.order_id 
where  date_trunc(o.order_date,month ) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
),

first_order_metrics as 
(
  select 
  n.vendor_id,
  is_successful as fo_is_successful,
  talabat_reason as fo_fail_reason,
  o.is_test as fo_is_test,
  count(distinct o.order_id) as total_first_order,
  count(distinct(case when is_successful = true then o.order_id else null end)) as successful_first_orders,
  count(distinct(CASE WHEN  is_net   AND NOT  o.is_successful   AND  owner   = 'VENDOR' THEN  o.order_id   ELSE null END )) as first_order_vendor_failed, 
  count(distinct(case when is_successful = true then n.vendor_id else null end)) as successful_vendors,
  sum(case when (is_successful = true and  (vendor_responce_time/60)>>3) then 1 else 0   end  ) AS first_order_response_time_abv_3min,
  avg(case when (o.is_successful = true)  then  (vendor_responce_time/60)  else 0   end  ) AS fo_response_time,
  COALESCE(SUM(CASE WHEN ( is_canceled_by_vendor  ) AND ( is_sent ) THEN 1  ELSE NULL END), 0) AS first_order_vendor_cancelled,
  AVG(case when o.is_successful = true then vendor_preparation_minutes else null end  ) AS fo_avg_vendor_preparation_minutes,
  sum( CASE WHEN (( vendor_late/60  ) >> 10) THEN 1  ELSE 0 END) AS fo_vendor_delay_10mins_orders,
  sum( CASE WHEN (( vendor_late/60  ) >> 5) THEN 1  ELSE 0 END) AS fo_vendor_delay_5min,
  count(distinct(CASE WHEN  is_net   THEN  o.order_id   ELSE null END )) as net_orders

  from 
  new_vendor n join orders o on n.first_order_id = o.order_id --and n.vendor_id = o.vendor_id
  left join succ_new_vendor s on s.vendor_id = n.vendor_id 
  group by 1,2,3,4 
),

first_month as 
(
  select 
  o.vendor_id,
  count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day ) then  o.order_id else null end )) as total_order_0_30_day,
  count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true )then o.analytical_customer_id else null end )) as customers_0_30_day,
count(distinct (case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true) then o.order_id else null end )) as successful_order_0_30_day,
COALESCE(SUM(CASE WHEN  (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_net   AND NOT  is_successful   AND  o.owner   = 'VENDOR') THEN  1   ELSE 0 END ), 0) AS  vendor_failed_orders_0_30,

COALESCE(SUM(CASE WHEN  (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_net   AND NOT  is_successful and lower(o.reason) in ("unavailable menu item","unavailable menu items")  AND  o.owner   = 'VENDOR') THEN  1   ELSE 0 END ), 0) AS  umi_vendor_failed_orders_0_30,


sum(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true and  (vendor_responce_time/60)>>3) then 1 else 0   end  ) AS response_time_abv_3min_0_30,
sum( CASE WHEN ((o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and (vendor_late/60  ) >> 10) THEN 1  ELSE 0 END) AS vendor_delay_10mins_orders_0_30,
avg(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true)  then  (vendor_responce_time/60)  else 0   end  ) AS avg_response_time_0_30,
COALESCE(SUM(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and is_canceled_by_vendor   AND  is_sent ) THEN 1  ELSE NULL END), 0) AS vendor_cancelled_0_30,
AVG(case when (o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day and o.is_successful = true) then vendor_preparation_minutes else null end  ) AS avg_vendor_preparation_minutes_0_30,
COALESCE(SUM(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day)  THEN gmv  ELSE NULL END), 0) AS vendor_gmv_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   is_net  THEN o.order_id  ELSE null END))) AS net_order_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   fir_used = true   THEN o.order_code  ELSE null END))) AS fir_used_0_30,
(count(distinct(CASE WHEN ( o.order_date >>= date(sf.onboarding_case_closed_at) and o.order_date <<= date(sf.onboarding_case_closed_at) + interval '30' day) and   primary_rider_near_restaurant_at   IS NOT NULL  THEN o.order_code  ELSE null END))) AS fir_used_den_0_30


  from admin sf 
  join new_vendor n on sf.salesforce_id = n.salesforce_id 
  join orders o on o.vendor_id = sf.vendor_id 
  group by 1 
)

select
a.*,
sf.vendor_grade,
sf.main_cuisine,
--sf.vertical,
--sf.vendor_name,
--sf.vendor_id,
sf.status,
sf.first_online_date,
sf.chain_name,
sf.is_non_food,
sf.is_exclusive,
n.first_order_date as first_order_date,
s.successful_first_order_date as successful_first_order_date,
fo.* except(vendor_id),
fm.* except (vendor_id),
CASE WHEN lower(business_type) in ("win back","switch") and date(first_order_date) << date(onboarding_case_closed_at) then "not activated after wb/switch" else "others" end as wb_switch_fo_date_lower_than_online_date_sanity_flag,
CASE WHEN lower(business_type) not in ("win back","switch") and  date(first_order_date) << date(onboarding_case_closed_at) then "took order before successful onboarding" else "others" end as order_before_successful_onb_sanity_flag,
CASE WHEN date(first_order_date) << date(onboarding_case_closed_at) then 0 else 1 end as onb_sanity_flag,
sh.newvalue as shipment_delivered,
shipment_started_at as shipment_request_started_at,
shimpent_ended_at as shipment_delivered_at,
shipment_duration_in_mins,
case when case_modified_by_name = "API Vendor Onboarding" then "SSU" else "other" end as SSU_tag

from 
  (
 select 
*
 from 
 (

 select 
*,
 row_number() over(partition by salesforce_id order by closedate desc) as noe
 from admin
 )
 where noe =1 
 --and country = "United Arab Emirates"
 and date_trunc(closedate,month) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 12 month)
 ) a
left join salesforce_vendors sf on sf.salesforce_id = a.salesforce_id
left join new_vendor n on n.vendor_id = a.vendor_id
left join succ_new_vendor s on s.vendor_id = a.vendor_id
left join first_order_metrics fo on fo.vendor_id = a.vendor_id 
left join first_month fm on fm.vendor_id = a.vendor_id
left join shipment sh on sh.grid__c = a.salesforce_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
