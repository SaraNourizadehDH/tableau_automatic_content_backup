      <table>
        <view>
          <datasources>
            <datasource caption='vendor_training' name='federated.0iuj17h17ugp8y1cglnen1qi3w0v' />
          </datasources>
          <datasource-dependencies datasource='federated.0iuj17h17ugp8y1cglnen1qi3w0v'>
            <column caption='VFCR 0 to 30 days' datatype='real' name='[Calculation_3570369387252379670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([numerator_0_30d])/SUM([denominator_0_30d])' />
            </column>
            <column caption='VFR 0 to 30 day' datatype='real' name='[Calculation_3980971025521131520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum([net_order_0_30])' />
            </column>
            <column caption='Onboarded vendors' datatype='integer' name='[Calculation_3980971025531953156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Offline rate 0 to 30 day' datatype='real' name='[Calculation_3980971025544626193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30]) / sum([actual_duration_in_hrs_0_30])' />
            </column>
            <column caption='Vendor delay 0 to 30 day' datatype='real' name='[Calculation_3980971025613099033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_delay_v2_0_30_day]) / sum([all_vendor_delay_v2_orders_0_30_day])' />
            </column>
            <column caption='Training Logic' datatype='string' name='[Calculation_3980971026449149980]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [training_provided__c] = &quot;Yes&quot;&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF ISNULL([training_provided__c])&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;Yes&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;No&quot;&#10;   AND [case_modified_by_name] &lt;&gt; &quot;API Vendor Onboarding&quot; THEN &quot;Not Trained&quot;&#10;&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='FIR confidence rate 0 to 30 days' datatype='real' name='[Calculation_3980971026449666077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fir_conf_use_orders_0_30_day]) / sum([total_fir_conf_use_orders_0_30_day])' />
            </column>
            <column caption='Training first online month' datatype='datetime' name='[Calculation_656047853835669505]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_online_date])' />
            </column>
            <column caption='Self Activated Vendors' datatype='integer' name='[Calculation_656047853874823171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[Calculation_656047853835669505] :&#10;    COUNTD( IIF([Calculation_3980971026449149980] = &quot;Self Activated&quot;, [vendor_id], NULL) )&#10;}' />
            </column>
            <column caption='Trained Vendors ' datatype='integer' name='[Calculation_656047853875355652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[Calculation_656047853835669505] :&#10;    COUNTD( IIF([Calculation_3980971026449149980] = &quot;Admin Training&quot;, [vendor_id], NULL) )&#10;}' />
            </column>
            <column caption='FIR usage rate 0 to 30 days' datatype='real' name='[FIR confidence rate 0 to 30 days (copy)_6598969784993685504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fir_orders_0_30_day]) / sum([total_fir_orders_0_30_day])' />
