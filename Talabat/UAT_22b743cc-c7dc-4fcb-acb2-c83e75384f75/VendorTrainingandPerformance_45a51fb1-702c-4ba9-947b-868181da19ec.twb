+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 61 AND 90 THEN fct_order_info.order_id END AS STRING))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001 AS NUMERIC),0),6)
) AS fct_contact_vf_customer_contact_rate_60_90d


FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
     AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info`
     AS dim_country_info ON dim_country_info.country_id = fct_order_info.country_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vertical`
     AS dim_vertical ON dim_vertical.vertical_id = fct_order_info.vertical_id
LEFT JOIN `tlb-data-prod.data_platform.fct_contact` AS fct_contact ON fct_contact.order_id = (CAST(fct_order_info.order_id AS STRING))
    and  (DATE(fct_contact.created_at_time_local )) >>=  DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_contact_reason`
     AS dim_contact_reason ON fct_contact.contact_reason_id=dim_contact_reason.contact_reason_id
--LEFT JOIN `tlb-data-prod.data_platform_metadata.prfl_user_account_manager_hierarchy`  AS prfl_user_account_manager_hierarchy ON  dim_vendor_info.account_manager_email= prfl_user_account_manager_hierarchy.reporting_line
   -- and prfl_user_account_manager_hierarchy.date =DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY)
    --and 1=0



WHERE ((( fct_order_info.order_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -5 MONTH))) 
AND ( fct_order_info.order_date  ) << DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH))) AND ((NOT (fct_order_info.is_test ) OR (fct_order_info.is_test ) IS NULL) 
AND (NOT (dim_order_status_flags.is_incomplete_online_payment ) OR (dim_order_status_flags.is_incomplete_online_payment ) IS NULL)) 
AND (((( dim_vendor_info.first_online_date  ) >>= ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -5 MONTH)))) 
AND ( dim_vendor_info.first_online_date  ) << TIMESTAMP(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH)))))
AND ((UPPER(( dim_vertical.vertical  )) = UPPER('food'))) 
AND ((fct_order_info.order_date >>=DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)) 
AND ((TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) >>=  (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) ) 
AND (TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) <<= TIMESTAMP_ADD( (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) , INTERVAL 90 DAY))))
GROUP BY
    1,
    2,
    3,
    4]]></relation>
          <relation connection='bigquery.0mjkhv91kns12v13p8s8v1f797jm' name='Custom SQL Query3' type='text'><![CDATA[SELECT
    (FORMAT_TIMESTAMP('%Y-%m', dim_vendor_info.first_online_date )) AS dim_vendor_info_first_online_month,
    dim_vendor_info.country_code,
    dim_vendor_info.vendor_id,
            COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id  = 1 AND NOT  dim_vendor_info.is_tgo   AND
           dim_contact_reason.contact_reason_l3   IN ( 'Check order status'
          , 'Complaint about extreme delay'
          , 'Request: order is late, does not want to wait'
          , 'Complaint about short delay'
          , 'Complaint about moderate delay'
          , "Order marked as delivered but didn't receive"
          , 'Request: order will take longer than expected'
          , 'Complain about late order'
          , 'Complaint about severe delay'
          , 'Extreme Delay'
          , 'Moderate Delay'
          , 'Severe Delay'
          , 'Short Delay')
          THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE 0 END ), 0) + (COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Missing item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong order') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0)) + (COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food temperature') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Spilled food') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Damaged item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0)) AS fct_contact_vf_customer_incoming_cases,
    COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id  = 1 AND NOT  dim_vendor_info.is_tgo   AND
           dim_contact_reason.contact_reason_l3   IN ( 'Check order status'
          , 'Complaint about extreme delay'
          , 'Request: order is late, does not want to wait'
          , 'Complaint about short delay'
          , 'Complaint about moderate delay'
          , "Order marked as delivered but didn't receive"
          , 'Request: order will take longer than expected'
          , 'Complain about late order'
          , 'Complaint about severe delay'
          , 'Extreme Delay'
          , 'Moderate Delay'
          , 'Severe Delay'
          , 'Short Delay')
          THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE 0 END ), 0) AS fct_contact_vf_customer_incoming_cases_late_delivery,
        COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Missing item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong order') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0) AS fct_contact_vf_customer_incoming_cases_missing_items,
        COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food temperature') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Spilled food') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Damaged item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0) AS fct_contact_vf_customer_incoming_cases_quality
FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
     AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vertical`
