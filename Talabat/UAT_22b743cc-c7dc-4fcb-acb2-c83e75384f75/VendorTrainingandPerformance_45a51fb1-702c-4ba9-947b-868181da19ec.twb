          <relation connection='bigquery.0mjkhv91kns12v13p8s8v1f797jm' name='Custom SQL Query2' type='text'><![CDATA[SELECT
    (FORMAT_TIMESTAMP('%Y-%m', dim_vendor_info.first_online_date )) AS dim_vendor_info_first_online_month,
    fct_order_info.vendor_id as vendor_id,
fct_order_info.country_code as country_code,
    dim_order_fail_reason.talabat_reason  AS dim_order_fail_reason_talabat_reason,
    dim_order_fail_reason.owner,
    COALESCE(SUM(CASE WHEN dim_order_status_flags.is_net AND NOT fct_order_info.is_successful THEN 1 ELSE 0 END), 0) AS fct_order_info_net_failed_orders_count
FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info`
     AS dim_vendor_info ON dim_vendor_info.vendor_id = fct_order_info.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vertical`
     AS dim_vertical ON dim_vertical.vertical_id = fct_order_info.vertical_id
--LEFT JOIN `tlb-data-prod.data_platform_metadata.prfl_user_account_manager_hierarchy`  AS prfl_user_account_manager_hierarchy ON  dim_vendor_info.account_manager_email= prfl_user_account_manager_hierarchy.reporting_line
    --and prfl_user_account_manager_hierarchy.date =DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY)
    --and 1=0

WHERE ((( fct_order_info.order_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -5 MONTH))) AND ( fct_order_info.order_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -5 MONTH), INTERVAL 5 MONTH))))) AND ((NOT (fct_order_info.is_test ) OR (fct_order_info.is_test ) IS NULL) AND (NOT (dim_order_status_flags.is_incomplete_online_payment ) OR (dim_order_status_flags.is_incomplete_online_payment ) IS NULL)) AND (((( dim_vendor_info.first_online_date  ) >>= ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -5 MONTH)))) AND ( dim_vendor_info.first_online_date  ) << ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -5 MONTH))), INTERVAL 5 MONTH)))))) AND ((UPPER(( dim_vertical.vertical  )) = UPPER('food'))) AND ((fct_order_info.order_date >>=DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)

  ) AND ((TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) >>=  (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) ) AND (TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) <<= TIMESTAMP_ADD( (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) , INTERVAL 30 DAY)))))
GROUP BY
    1,
    2,3,4,5]]></relation>
          <relation connection='bigquery.0mjkhv91kns12v13p8s8v1f797jm' name='Custom SQL Query4' type='text'><![CDATA[WITH lo AS (
  SELECT
    order_id,
    MAX(avoidable_wait_time)/60.0 AS awt_min
  FROM `tlb-data-prod.data_platform.fct_logistics_order`
  WHERE is_talabat
    AND is_rider_order
    AND created_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)
  GROUP BY order_id
),
base AS (
  SELECT
    FORMAT_TIMESTAMP('%Y-%m', dvi.first_online_date) AS first_online_month,
    dci.country_code,
    dvi.vendor_id,
    DATE(foi.order_date) AS order_dt,
    DATE(TIMESTAMP_TRUNC(dvi.first_online_date, DAY)) AS first_online_dt,
    lo.awt_min
  FROM `tlb-data-prod.data_platform.fct_order_info` foi
  LEFT JOIN lo USING (order_id)
  JOIN `tlb-data-prod.data_platform.dim_order_status` dos
    ON dos.order_status_id = foi.order_status_id
  JOIN `tlb-data-prod.data_platform.dim_vendor_info` dvi
    ON dvi.vendor_id = foi.vendor_id
  JOIN `tlb-data-prod.data_platform.dim_country_info` dci
    ON dci.country_id = foi.country_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` dv
    ON dv.vertical_id = foi.vertical_id
  WHERE
    foi.order_date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -4 MONTH)
    AND foi.order_date <<  DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -4 MONTH), INTERVAL 4 MONTH)
    AND ( (NOT foi.is_test) OR foi.is_test IS NULL )
    AND ( (NOT dos.is_incomplete_online_payment) OR dos.is_incomplete_online_payment IS NULL )
    AND dvi.first_online_date >>= TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -4 MONTH))
    AND dvi.first_online_date <<
        TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -4 MONTH))), INTERVAL 4 MONTH))
    AND UPPER(dv.vertical) = 'FOOD'
)

SELECT
  first_online_month,
first_online_dt,
  country_code,
  vendor_id,

  -- 0–30
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 0 AND 29
           THEN awt_min ELSE 0 END)                           AS total_awt_min_0_30,
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 0 AND 29
           AND awt_min IS NOT NULL THEN 1 ELSE 0 END)         AS n_orders_0_30,
  SAFE_DIVIDE(
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 0 AND 29 THEN awt_min END),
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 0 AND 29 AND awt_min IS NOT NULL THEN 1 END)
  ) AS avg_awt_min_0_30,

  -- 30–60
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 30 AND 59
           THEN awt_min ELSE 0 END)                           AS total_awt_min_30_60,
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 30 AND 59
           AND awt_min IS NOT NULL THEN 1 ELSE 0 END)         AS n_orders_30_60,
  SAFE_DIVIDE(
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 30 AND 59 THEN awt_min END),
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 30 AND 59 AND awt_min IS NOT NULL THEN 1 END)
  ) AS avg_awt_min_30_60,

  -- 60–90
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 60 AND 89
           THEN awt_min ELSE 0 END)                           AS total_awt_min_60_90,
  SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 60 AND 89
           AND awt_min IS NOT NULL THEN 1 ELSE 0 END)         AS n_orders_60_90,
  SAFE_DIVIDE(
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 60 AND 89 THEN awt_min END),
    SUM(CASE WHEN DATE_DIFF(order_dt, first_online_dt, DAY) BETWEEN 60 AND 89 AND awt_min IS NOT NULL THEN 1 END)
  ) AS avg_awt_min_60_90

FROM base
GROUP BY 1,2,3,4]]></relation>
