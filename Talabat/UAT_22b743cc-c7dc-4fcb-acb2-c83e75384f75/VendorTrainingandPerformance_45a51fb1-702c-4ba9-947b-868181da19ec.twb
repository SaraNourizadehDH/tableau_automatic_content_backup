    and  (DATE(fct_contact.created_at_time_local )) >>=  DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_contact_reason`
     AS dim_contact_reason ON fct_contact.contact_reason_id=dim_contact_reason.contact_reason_id
