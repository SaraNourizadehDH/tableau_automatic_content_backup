+ COALESCE(SUM(CASE WHEN (fct_contact.stakeholder_id = 1) AND UPPER(dim_contact_reason.contact_reason_l3) IN (UPPER('Missing item'), UPPER('Wrong item'), UPPER('Wrong order'), UPPER('Item unavailable for pickup'))
