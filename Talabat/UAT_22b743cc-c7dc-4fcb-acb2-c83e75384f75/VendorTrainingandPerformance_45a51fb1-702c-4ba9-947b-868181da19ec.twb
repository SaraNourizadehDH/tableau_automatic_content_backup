      <column caption='CVR 30 to 60 day ' datatype='real' name='[CVR 0 to 30 day (copy)_3980971025547792405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([placed_order_session_count_30_60]) / sum([viewed_menu_session_count_30_60])' />
