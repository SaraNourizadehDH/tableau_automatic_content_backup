            </column>
            <column caption='Metrics Group' datatype='real' name='[Calculation_656047854557863950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Offline rate&quot; THEN [Calculation_3980971025544626193]&#10;    WHEN &quot;Fail Rate&quot; THEN [Calculation_3980971025521131520]&#10;    WHEN &quot;VFCR&quot; THEN [Calculation_3570369387252379670]&#10;    WHEN &quot;Vendor Delay&quot; THEN [Calculation_3980971025613099033]&#10;    WHEN &quot;FIR Confidence&quot; THEN [Calculation_3980971026449666077]&#10;    WHEN &quot;FIR Usage&quot; THEN [FIR confidence rate 0 to 30 days (copy)_6598969784993685504]&#10;END' />
            </column>
            <column caption='FIR usage rate 0 to 30 days' datatype='real' name='[FIR confidence rate 0 to 30 days (copy)_6598969784993685504]' role='measure' type='quantitative'>
