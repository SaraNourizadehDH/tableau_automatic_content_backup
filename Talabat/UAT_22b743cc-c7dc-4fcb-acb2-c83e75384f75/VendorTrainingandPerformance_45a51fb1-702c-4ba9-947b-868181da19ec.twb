-- NUMERATOR (0–30d)
(
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND NOT dim_vendor_info.is_tgo
       AND dim_contact_reason.contact_reason_l3 IN (
        'Check order status','Complaint about extreme delay',
        'Request: order is late, does not want to wait',
        'Complaint about short delay','Complaint about moderate delay',
        "Order marked as delivered but didnt receive",
        'Request: order will take longer than expected',
        'Complain about late order','Complaint about severe delay',
        'Extreme Delay','Moderate Delay','Severe Delay','Short Delay'
      )
       AND DATE_DIFF(
             fct_order_info.order_date,
             DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),
             DAY
           ) BETWEEN 0 AND 30
      THEN IF(fct_contact.contact_id IS NOT NULL,1,0)
      ELSE 0
    END
  ), 0)
  +
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND UPPER(dim_contact_reason.contact_reason_l3) IN ('WRONG ITEM','ITEM UNAVAILABLE FOR PICKUP')
       AND DATE_DIFF(
