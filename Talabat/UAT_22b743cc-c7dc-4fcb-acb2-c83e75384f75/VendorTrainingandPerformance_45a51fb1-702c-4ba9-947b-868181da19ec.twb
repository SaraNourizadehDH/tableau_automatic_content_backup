        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Offline Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_training' name='federated.0iuj17h17ugp8y1cglnen1qi3w0v' />
          </datasources>
          <datasource-dependencies datasource='federated.0iuj17h17ugp8y1cglnen1qi3w0v'>
            <column caption='Unreachable' datatype='real' name='[Calculation_3570369389756301359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[unreachable]/[offline_duration_in_hours_0_30]' />
            </column>
            <column caption='Bad Weather' datatype='real' name='[Calculation_3570369389757579312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[bad_weather]/[offline_duration_in_hours_0_30]' />
            </column>
            <column caption='Closed' datatype='real' name='[Calculation_3570369389757968433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[closed]/[offline_duration_in_hours_0_30]' />
            </column>
