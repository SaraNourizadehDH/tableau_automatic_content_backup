    <worksheet name='dlp'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Dish Level Photo Ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_training' name='federated.0iuj17h17ugp8y1cglnen1qi3w0v' />
          </datasources>
          <datasource-dependencies datasource='federated.0iuj17h17ugp8y1cglnen1qi3w0v'>
            <column caption='Team' datatype='string' name='[Calculation_3980971025533374471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in (&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,) then &apos;Field Sales&apos;&#10;ELSEIF  lower([owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;else &apos;Account Managers&apos;&#10;end' />
            </column>
            <column caption='Offline rate 0 to 30 day' datatype='real' name='[Calculation_3980971025544626193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30]) / sum([actual_duration_in_hrs_0_30])' />
            </column>
            <column caption='CVR 0 to 30 day' datatype='real' name='[Calculation_3980971025545113620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([placed_order_session_count_0_30]) / sum([viewed_menu_session_count_0_30])' />
            </column>
            <column caption='DLP on first day ' datatype='real' name='[Calculation_3980971025548099607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_1]) /sum([total_active_menu_items_1])' />
            </column>
            <column caption='Training Logic' datatype='string' name='[Calculation_3980971026449149980]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [training_provided__c] = &quot;Yes&quot;&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF ISNULL([training_provided__c])&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;Yes&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;No&quot;&#10;   AND [case_modified_by_name] &lt;&gt; &quot;API Vendor Onboarding&quot; THEN &quot;Not Trained&quot;&#10;&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='DLP on latest day' datatype='real' name='[DLP on first day  (copy)_3980971025548218392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([items_with_images_yest]) /sum([total_active_menu_items_yest])' />
            </column>
            <column caption='Offline rate 30 to 60 day ' datatype='real' name='[Offline rate 0 to 30 day (copy)_3980971025544736786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_30_60]) / sum([actual_duration_in_hrs_30_60])' />
            </column>
            <column caption='Offline rate 60 to 90 day  ' datatype='real' name='[Offline rate 30 to 60 day  (copy)_3980971025544814611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_60_90]) / sum([actual_duration_in_hrs_60_90])' />
            </column>
            <column datatype='real' name='[actual_duration_in_hrs_0_30]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_duration_in_hrs_30_60]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_duration_in_hrs_60_90]' role='measure' type='quantitative' />
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[case_modified_by_name]' role='dimension' type='nominal' />
            <column caption='Country code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='First Online Date' datatype='datetime' name='[first_online_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[items_with_images_1]' role='measure' type='quantitative' />
            <column datatype='integer' name='[items_with_images_yest]' role='measure' type='quantitative' />
            <column-instance column='[first_online_date]' derivation='MY' name='[my:first_online_date:ok]' pivot='key' type='ordinal' />
