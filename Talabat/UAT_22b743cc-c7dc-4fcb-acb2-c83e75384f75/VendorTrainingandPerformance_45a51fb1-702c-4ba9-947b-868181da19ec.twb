             DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),
             DAY
           ) BETWEEN 0 AND 30
      THEN IF(dim_vendor_info.is_tgo, IF(fct_contact.contact_id IS NOT NULL,1,0), 0)
