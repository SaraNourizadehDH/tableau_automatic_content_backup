        <calculation class='tableau' formula='sum([vendor_delay_v2_0_30_day]) / sum([all_vendor_delay_v2_orders_0_30_day])' />
      </column>
      <column caption='Training Logic' datatype='string' name='[Calculation_3980971026449149980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [training_provided__c] = &quot;Yes&quot;&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF ISNULL([training_provided__c])&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;Yes&quot; THEN &quot;Admin Training&quot;&#10;&#10;ELSEIF [training_provided__c] = &quot;No&quot;&#10;   AND [case_modified_by_name] &lt;&gt; &quot;API Vendor Onboarding&quot; THEN &quot;Not Trained&quot;&#10;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='FIR confidence rate 0 to 30 days' datatype='real' name='[Calculation_3980971026449666077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fir_conf_use_orders_0_30_day]) / sum([total_fir_conf_use_orders_0_30_day])' />
      </column>
      <column caption='self trained or no' datatype='string' name='[Calculation_5741456257770840064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [training_provided__c] = &quot;Yes&quot; &#10;AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; &#10;then &quot;Admin Training&quot; ELSE [training_provided__c] end' />
      </column>
      <column caption='Onboarding - New Business' datatype='integer' name='[Calculation_656047853833150464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code], [Calculation_656047853835669505] :&#10;    COUNTD( IF [business_type] = &quot;New Business&quot; THEN [vendor_id] END )&#10;}' />
      </column>
      <column caption='Training first online month' datatype='datetime' name='[Calculation_656047853835669505]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_online_date])' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_656047853844271106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([training_provided__c])&#10;   AND [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;&#10;&#10;ELSEIF [case_modified_by_name] = &quot;API Vendor Onboarding&quot; THEN &quot;Self Activated&quot;' />
      </column>
      <column caption='Self Activated Vendors' datatype='integer' name='[Calculation_656047853874823171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code],[Calculation_656047853835669505] :&#10;    COUNTD( IIF([Calculation_3980971026449149980] = &quot;Self Activated&quot;, [vendor_id], NULL) )&#10;}' />
      </column>
      <column caption='Trained Vendors ' datatype='integer' name='[Calculation_656047853875355652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code],[Calculation_656047853835669505] :&#10;    COUNTD( IIF([Calculation_3980971026449149980] = &quot;Admin Training&quot;, [vendor_id], NULL) )&#10;}' />
      </column>
      <column caption='Calculation3' datatype='string' name='[Calculation_656047854524067851]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3980971025521131520] &lt; AVG([Fail rate]) THEN &quot;Red&quot;&#10;ELSE &quot;Green&quot;&#10;END' />
      </column>
      <column caption='Metrics Group' datatype='real' name='[Calculation_656047854557863950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Offline rate&quot; THEN [Calculation_3980971025544626193]&#10;    WHEN &quot;Fail Rate&quot; THEN [Calculation_3980971025521131520]&#10;    WHEN &quot;VFCR&quot; THEN [Calculation_3570369387252379670]&#10;    WHEN &quot;Vendor Delay&quot; THEN [Calculation_3980971025613099033]&#10;    WHEN &quot;FIR Confidence&quot; THEN [Calculation_3980971026449666077]&#10;    WHEN &quot;FIR Usage&quot; THEN [FIR confidence rate 0 to 30 days (copy)_6598969784993685504]&#10;END' />
      </column>
      <column caption='Format Group' datatype='string' name='[Calculation_656047854591127567]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Percentage&quot; THEN STR(ROUND([Calculation_3570369388678684701]*100,2)) + &quot;%&quot;&#10;    WHEN &quot;Absolute&quot; THEN STR(SUM([fct_order_info_net_failed_orders_count]))&#10;END' />
      </column>
