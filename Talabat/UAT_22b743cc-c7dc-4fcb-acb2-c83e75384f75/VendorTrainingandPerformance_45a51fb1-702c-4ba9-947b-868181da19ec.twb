    <worksheet name='Performance Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Performance Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_training' name='federated.0iuj17h17ugp8y1cglnen1qi3w0v' />
          </datasources>
          <datasource-dependencies datasource='federated.0iuj17h17ugp8y1cglnen1qi3w0v'>
            <column caption='VFCR 0 to 30 days' datatype='real' name='[Calculation_3570369387252379670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([numerator_0_30d])/SUM([denominator_0_30d])' />
            </column>
            <column caption='VFR 0 to 30 day' datatype='real' name='[Calculation_3980971025521131520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_failed_order_0_30]) / sum([net_order_0_30])' />
            </column>
            <column caption='Onboarded vendors' datatype='integer' name='[Calculation_3980971025531953156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Offline rate 0 to 30 day' datatype='real' name='[Calculation_3980971025544626193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offline_duration_in_hours_0_30]) / sum([actual_duration_in_hrs_0_30])' />
            </column>
            <column caption='Vendor delay 0 to 30 day' datatype='real' name='[Calculation_3980971025613099033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_delay_v2_0_30_day]) / sum([all_vendor_delay_v2_orders_0_30_day])' />
            </column>
            <column caption='Onboarding - New Business' datatype='integer' name='[Calculation_656047853833150464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Calculation_656047853835669505] :&#10;    COUNTD( IF [business_type] = &quot;New Business&quot; THEN [vendor_id] END )&#10;}' />
            </column>
            <column caption='Training first online month' datatype='datetime' name='[Calculation_656047853835669505]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_online_date])' />
            </column>
            <column datatype='real' name='[Fail rate]' role='measure' type='quantitative' />
            <column datatype='real' name='[Offline rate target]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_duration_in_hrs_0_30]' role='measure' type='quantitative' />
            <column datatype='integer' name='[all_vendor_delay_v2_orders_0_30_day]' role='measure' type='quantitative' />
            <column-instance column='[Fail rate]' derivation='Avg' name='[avg:Fail rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Offline rate target]' derivation='Avg' name='[avg:Offline rate target:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column caption='Country code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[denominator_0_30d]' role='measure' type='quantitative' />
            <column caption='First Online Date' datatype='datetime' name='[first_online_date]' role='dimension' type='ordinal' />
            <column-instance column='[first_online_date]' derivation='MY' name='[my:first_online_date:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[net_order_0_30]' role='measure' type='quantitative' />
            <column-instance column='[business_type]' derivation='None' name='[none:business_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[numerator_0_30d]' role='measure' type='quantitative' />
            <column datatype='real' name='[offline_duration_in_hours_0_30]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_656047853833150464]' derivation='Sum' name='[sum:Calculation_656047853833150464:qk]' pivot='key' type='quantitative' />
