            <properties context=''>
              <relation connection='bigquery.0mjkhv91kns12v13p8s8v1f797jm' name='Custom SQL Query1' type='text'><![CDATA[SELECT
    (FORMAT_TIMESTAMP('%Y-%m', dim_vendor_info.first_online_date )) AS first_online_month,
    DATE(dim_vendor_info.first_online_date) AS first_online_day,
    dim_country_info.country_code  AS country_code,
    fct_order_info.vendor_id as vendor_id,
--fct_contact_vendor_contact_rate
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 4) THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE NULL END), 0), ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  1   ELSE NULL END
,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6)) 
AS fct_contact_vendor_contact_rate,
--fct_contact_vf_customer_contact_rate
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id  = 1 AND    NOT  dim_vendor_info.is_tgo   AND
           dim_contact_reason.contact_reason_l3   IN ( 'Check order status'
          , 'Complaint about extreme delay'
          , 'Request: order is late, does not want to wait'
          , 'Complaint about short delay'
          , 'Complaint about moderate delay'
          , "Order marked as delivered but didn't receive"
          , 'Request: order will take longer than expected'
          , 'Complain about late order'
          , 'Complaint about severe delay'
          , 'Extreme Delay'
          , 'Moderate Delay'
          , 'Severe Delay'
          , 'Short Delay')
          THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE 0 END ), 0) + (COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Missing item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong order') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0)) + (COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food temperature') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Spilled food') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Damaged item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0)), ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  1   ELSE NULL END
,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST(CASE WHEN  (NOT COALESCE( fct_order_info.is_abandoned  , FALSE)) AND (NOT COALESCE( fct_order_info.is_test  , FALSE))  THEN  fct_order_info.order_id   ELSE NULL END
 AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6)) 
 AS fct_contact_vf_customer_contact_rate,

 -- n 
 -- NUMERATOR
(
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND NOT dim_vendor_info.is_tgo
       AND dim_contact_reason.contact_reason_l3 IN (
          'Check order status','Complaint about extreme delay','Request: order is late, does not want to wait',
          'Complaint about short delay','Complaint about moderate delay',"Order marked as delivered but didn't receive",
          'Request: order will take longer than expected','Complain about late order','Complaint about severe delay',
          'Extreme Delay','Moderate Delay','Severe Delay','Short Delay'
       )
      THEN IF(fct_contact.contact_id IS NOT NULL,1,0) ELSE 0
    END
  ),0)
  +
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND UPPER(dim_contact_reason.contact_reason_l3) IN ('WRONG ITEM','ITEM UNAVAILABLE FOR PICKUP')
      THEN IF(dim_vendor_info.is_tgo, IF(fct_contact.contact_id IS NOT NULL,1,0), 0)
      ELSE NULL
    END
  ),0)
  +
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND UPPER(dim_contact_reason.contact_reason_l3) IN ('MISSING ITEM','WRONG ITEM','WRONG ORDER','ITEM UNAVAILABLE FOR PICKUP')
      THEN IF(dim_vendor_info.is_tgo, 0, IF(fct_contact.contact_id IS NOT NULL,1,0))
      ELSE NULL
    END
  ),0)
  +
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND UPPER(dim_contact_reason.contact_reason_l3) IN ('FOOD QUALITY','FOOD PORTION','FOOD POISONING','FOREIGN OBJECT','EXPIRED ITEM')
      THEN IF(dim_vendor_info.is_tgo, IF(fct_contact.contact_id IS NOT NULL,1,0), 0)
      ELSE NULL
    END
  ),0)
  +
  COALESCE(SUM(
    CASE
      WHEN fct_contact.stakeholder_id = 1
       AND UPPER(dim_contact_reason.contact_reason_l3) IN ('FOOD QUALITY','FOOD PORTION','FOOD POISONING','FOREIGN OBJECT','EXPIRED ITEM','FOOD TEMPERATURE','SPILLED FOOD','DAMAGED ITEM')
      THEN IF(dim_vendor_info.is_tgo, 0, IF(fct_contact.contact_id IS NOT NULL,1,0))
      ELSE NULL
    END
  ),0)
) AS numerator,

--d 
-- DENOMINATOR
ROUND(
  COALESCE(
    CAST((
      -- first SUM(DISTINCT ...) term
      SUM(DISTINCT (
        CAST(ROUND(
          COALESCE(
            CASE
              WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)
               AND NOT COALESCE(fct_order_info.is_test, FALSE)
              THEN 1 ELSE NULL
            END, 0
          ) * 0.001, 9
        ) AS NUMERIC)
        +
        (
          CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
            CASE
              WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)
               AND NOT COALESCE(fct_order_info.is_test, FALSE)
              THEN fct_order_info.order_id ELSE NULL
            END AS STRING))), 1, 15)) AS INT64) AS NUMERIC) * 4294967296
          +
          CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
            CASE
              WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)
               AND NOT COALESCE(fct_order_info.is_test, FALSE)
              THEN fct_order_info.order_id ELSE NULL
            END AS STRING))), 16, 8)) AS INT64) AS NUMERIC)
        ) * 0.000000001
      ))
      --
      -
      --
      -- second SUM(DISTINCT ...) term
      SUM(DISTINCT (
        (
          CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
            CASE
              WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)
               AND NOT COALESCE(fct_order_info.is_test, FALSE)
              THEN fct_order_info.order_id ELSE NULL
            END AS STRING))), 1, 15)) AS INT64) AS NUMERIC) * 4294967296
          +
          CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
            CASE
              WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)
               AND NOT COALESCE(fct_order_info.is_test, FALSE)
              THEN fct_order_info.order_id ELSE NULL
            END AS STRING))), 16, 8)) AS INT64) AS NUMERIC)
        ) * 0.000000001
      ))
    ) / 0.001 AS NUMERIC)   -- (1/1000*1.0) simplified and wrapped by CAST
  , 0),
  6
) AS denominator,


-- fct_contact_vf_customer_incoming_cases (match Looker month logic)
-- fct_contact_vf_customer_incoming_cases
COALESCE(
  COUNT(DISTINCT IF(
    fct_contact.stakeholder_id = 1
    AND (
      -- Late delivery (non-TGO)
      (NOT dim_vendor_info.is_tgo AND dim_contact_reason.contact_reason_l3 IN (
        'Check order status',
        'Complaint about extreme delay',
        'Request: order is late, does not want to wait',
        'Complaint about short delay',
        'Complaint about moderate delay',
        "Order marked as delivered but didn't receive",
        'Request: order will take longer than expected',
        'Complain about late order',
        'Complaint about severe delay',
        'Extreme Delay','Moderate Delay','Severe Delay','Short Delay'
      ))
      -- Missing items (TGO)
      OR (dim_vendor_info.is_tgo AND UPPER(dim_contact_reason.contact_reason_l3) IN (
        'WRONG ITEM','ITEM UNAVAILABLE FOR PICKUP'
      ))
      -- Missing items (non-TGO)
      OR (NOT dim_vendor_info.is_tgo AND UPPER(dim_contact_reason.contact_reason_l3) IN (
        'MISSING ITEM','WRONG ITEM','WRONG ORDER','ITEM UNAVAILABLE FOR PICKUP'
      ))
      -- Quality (TGO)
      OR (dim_vendor_info.is_tgo AND UPPER(dim_contact_reason.contact_reason_l3) IN (
        'FOOD QUALITY','FOOD PORTION','FOOD POISONING','FOREIGN OBJECT','EXPIRED ITEM'
      ))
      -- Quality (non-TGO)
      OR (NOT dim_vendor_info.is_tgo AND UPPER(dim_contact_reason.contact_reason_l3) IN (
        'FOOD QUALITY','FOOD PORTION','FOOD POISONING',
        'FOREIGN OBJECT','EXPIRED ITEM','FOOD TEMPERATURE',
        'SPILLED FOOD','DAMAGED ITEM'
      ))
    ),
    CAST(fct_contact.order_id AS STRING),   -- de-dupe by unique order_id
    NULL
  ))
, 0) AS fct_contact_vf_customer_incoming_cases,




--fct_contact_vf_customer_incoming_cases_late_delivery
COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id  = 1 AND NOT  dim_vendor_info.is_tgo   AND
           dim_contact_reason.contact_reason_l3   IN ( 'Check order status'
          , 'Complaint about extreme delay'
          , 'Request: order is late, does not want to wait'
          , 'Complaint about short delay'
          , 'Complaint about moderate delay'
          , "Order marked as delivered but didn't receive"
          , 'Request: order will take longer than expected'
          , 'Complain about late order'
          , 'Complaint about severe delay'
          , 'Extreme Delay'
          , 'Moderate Delay'
          , 'Severe Delay'
          , 'Short Delay')
          THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   )  ELSE 0 END ), 0) AS fct_contact_vf_customer_incoming_cases_late_delivery,

--fct_contact_vf_customer_incoming_cases_missing_items
COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Missing item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Wrong order') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Item unavailable for pickup'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0) AS fct_contact_vf_customer_incoming_cases_missing_items,

--fct_contact_vf_customer_incoming_cases_quality
COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) ELSE 0 END  ELSE NULL END), 0) + COALESCE(SUM(CASE WHEN ( fct_contact.stakeholder_id   = 1) AND ((UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food quality') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food portion') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food poisoning') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Foreign Object') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Expired Item') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Food temperature') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Spilled food') OR UPPER( dim_contact_reason.contact_reason_l3  ) = UPPER('Damaged item'))) THEN CASE WHEN  dim_vendor_info.is_tgo   THEN 0 ELSE ( CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END   ) END  ELSE NULL END), 0) AS fct_contact_vf_customer_incoming_cases_quality,

-- Vendor contact rate, 0–30d (since first_online)
SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id = 4 AND fct_contact.contact_id IS NOT NULL AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30 THEN 1
END), 0),
ROUND(COALESCE(CAST(((SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING ))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30
THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18  
+ CAST( CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY ) BETWEEN 0 AND 30 THEN 0.001 ELSE 0 END AS BIGNUMERIC ) ))
- SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001  ) AS NUMERIC),0),6)
) AS fct_contact_vendor_contact_rate_0_30d,

-- Vendor contact rate, 30–60d (since first_online)
SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id = 4 AND fct_contact.contact_id IS NOT NULL AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 31 AND 60 THEN 1
END), 0),
ROUND(COALESCE(CAST(((SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 31 AND 60 THEN fct_order_info.order_id END AS STRING ))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 31 AND 60
THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18  
+ CAST( CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY ) BETWEEN 31 AND 60 THEN 0.001 ELSE 0 END AS BIGNUMERIC ) ))
- SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 31 AND 60 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 31 AND 60 THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001  ) AS NUMERIC),0),6)
) AS fct_contact_vendor_contact_rate_30_60d,

-- Vendor contact rate, 60–90d (since first_online)
SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_contact.stakeholder_id = 4 AND fct_contact.contact_id IS NOT NULL AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 61 AND 90 THEN 1
END), 0),
ROUND(COALESCE(CAST(((SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 61 AND 90 THEN fct_order_info.order_id END AS STRING ))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(
CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 61 AND 90
THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18  
+ CAST( CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY ) BETWEEN 61 AND 90 THEN 0.001 ELSE 0 END AS BIGNUMERIC ) ))
- SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 61 AND 90 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 61 AND 90 THEN fct_order_info.order_id END AS STRING ))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001  ) AS NUMERIC),0),6)
