+ COALESCE(SUM(CASE WHEN (fct_contact.stakeholder_id = 1) AND UPPER(dim_contact_reason.contact_reason_l3) IN (UPPER('Food quality'), UPPER('Food portion'), UPPER('Food poisoning'), UPPER('Foreign Object'), UPPER('Expired Item'))
 AND DATE_DIFF(fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30
 THEN CASE WHEN dim_vendor_info.is_tgo THEN (CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END) ELSE 0 END ELSE NULL END), 0)
+ COALESCE(SUM(CASE WHEN (fct_contact.stakeholder_id = 1) AND UPPER(dim_contact_reason.contact_reason_l3) IN (UPPER('Food quality'), UPPER('Food portion'), UPPER('Food poisoning'), UPPER('Foreign Object'), UPPER('Expired Item'), UPPER('Food temperature'), UPPER('Spilled food'), UPPER('Damaged item')) AND DATE_DIFF(fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN CASE WHEN dim_vendor_info.is_tgo THEN 0 ELSE (CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END) END ELSE NULL END), 0),

ROUND(COALESCE(CAST((SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE)AND NOT COALESCE(fct_order_info.is_test, FALSE)
AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF(fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18
+ CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF(fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30
THEN 0.001 ELSE 0 END AS BIGNUMERIC)))
- SUM(DISTINCT ((CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE)AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)),DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING))), 1, 15)) AS INT64) AS BIGNUMERIC) * 4294967296
+ CAST(CAST(CONCAT('0x', SUBSTR(TO_HEX(MD5(CAST(CASE WHEN NOT COALESCE(fct_order_info.is_abandoned, FALSE) AND NOT COALESCE(fct_order_info.is_test, FALSE) AND DATE_DIFF( fct_order_info.order_date, DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 0 AND 30 THEN fct_order_info.order_id END AS STRING))), 16, 8)) AS INT64) AS BIGNUMERIC)) * 1e-18))) / 0.001 AS NUMERIC),0),6)
