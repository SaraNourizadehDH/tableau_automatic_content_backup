      <column caption='Vendors taken live' datatype='integer' name='[Calculation_3570369386208612352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Avg shipment time (days)' datatype='integer' name='[Calculation_3570369386208940033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[shipment_request_started_at],[shipment_delivered_at])' />
      </column>
      <column caption='Avg onboarding time (day)' datatype='integer' name='[Calculation_3570369386209062914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[onboarding_case_created_at],[onboarding_case_closed_at])' />
      </column>
      <column caption='onboarding + shipment time' datatype='real' name='[Calculation_3570369386209234947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(avg((IFNULL([Calculation_3570369386209062914],0) )))+avg((IFNULL([Calculation_3570369386208940033],0)))' />
      </column>
      <column caption='onb time ranks' datatype='integer' name='[Calculation_3570369386209353732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_3570369386209234947],&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='VFR 0_30 days' datatype='real' name='[Calculation_3570369386209615877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(sum([vendor_failed_orders_0_30])/sum([net_order_0_30]),0)' />
      </column>
      <column caption='vfr ranks' datatype='integer' name='[Calculation_3570369386209722374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_3570369386209615877],&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='self onboarded?' datatype='string' name='[Calculation_3570369386209992711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if lower([sales_admin_name]) &lt;&gt; &quot;self onboarded&quot; then &quot;Not Self onboarded&quot; else &quot;Self onboarded&quot; end' />
      </column>
      <column caption='Total vendors' datatype='integer' name='[Calculation_3570369386210275336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [onboarding_month],[country], [case_type],[vertical],[Calculation_3570369386209992711] : [Calculation_3570369386208612352]}' />
      </column>
      <column caption='Trained vendors %' datatype='real' name='[Calculation_3570369386210385929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])/ SUM([Calculation_3570369386210275336])' />
      </column>
      <column caption='vendor perc ranks ' datatype='integer' name='[Calculation_3570369386210525194]' role='measure' type='quantitative'>
