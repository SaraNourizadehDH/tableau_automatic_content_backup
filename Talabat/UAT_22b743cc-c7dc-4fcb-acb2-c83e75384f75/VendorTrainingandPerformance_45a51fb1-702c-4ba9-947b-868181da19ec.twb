--LEFT JOIN `tlb-data-prod.data_platform_metadata.prfl_user_account_manager_hierarchy`  AS prfl_user_account_manager_hierarchy ON  dim_vendor_info.account_manager_email= prfl_user_account_manager_hierarchy.reporting_line
   -- and prfl_user_account_manager_hierarchy.date =DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY)
    --and 1=0

WHERE ((( fct_order_info.order_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -5 MONTH))) AND ( fct_order_info.order_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -5 MONTH), INTERVAL 5 MONTH))))) AND ((NOT (fct_order_info.is_test ) OR (fct_order_info.is_test ) IS NULL) AND (NOT (dim_order_status_flags.is_incomplete_online_payment ) OR (dim_order_status_flags.is_incomplete_online_payment ) IS NULL)) AND (((( dim_vendor_info.first_online_date  ) >>= ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -5 MONTH)))) AND ( dim_vendor_info.first_online_date  ) << ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(TIMESTAMP(FORMAT_TIMESTAMP('%F %H:%M:%E*S', CURRENT_TIMESTAMP())), DAY), MONTH)), INTERVAL -5 MONTH))), INTERVAL 5 MONTH)))))) AND ((UPPER(( dim_vertical.vertical  )) = UPPER('food'))) AND ((fct_order_info.order_date >>=DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)

  ) AND ((TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) >>=  (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) ) AND (TIMESTAMP( (TIMESTAMP(fct_order_info.order_date )) ) <<= TIMESTAMP_ADD( (TIMESTAMP_TRUNC(dim_vendor_info.first_online_date , DAY)) , INTERVAL 30 DAY)))))
