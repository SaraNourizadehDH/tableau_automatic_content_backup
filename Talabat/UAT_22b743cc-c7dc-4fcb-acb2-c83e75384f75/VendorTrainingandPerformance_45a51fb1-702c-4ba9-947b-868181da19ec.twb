 'Request: order will take longer than expected','Complain about late order','Complaint about severe delay','Extreme Delay','Moderate Delay','Severe Delay','Short Delay')
AND DATE_DIFF(fct_order_info.order_date,DATE(TIMESTAMP_TRUNC(dim_vendor_info.first_online_date, DAY)), DAY) BETWEEN 61 AND 90 THEN (CASE WHEN fct_contact.contact_id IS NOT NULL THEN 1 END) ELSE 0 END), 0)
+ COALESCE(SUM(CASE WHEN (fct_contact.stakeholder_id = 1) AND UPPER(dim_contact_reason.contact_reason_l3) IN (UPPER('Wrong item'), UPPER('Item unavailable for pickup'))
