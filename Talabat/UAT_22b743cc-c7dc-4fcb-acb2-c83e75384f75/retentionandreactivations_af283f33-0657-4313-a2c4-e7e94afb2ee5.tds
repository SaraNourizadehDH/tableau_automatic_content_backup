,reactivations_from_zombies as (


WITH Base AS (
    /* Active vendors in December 2024 */
 --with active_before as (
SELECT 
         k1.vendor_id,
        k1.country_code,
        k1.month,
        max(k2.is_active) as was_active_before
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` k1 
    left join `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`  k2 on k1.vendor_id=k2.vendor_id 
    and k2.month <<= k1.month and k2.vertical='Restaurant'
    WHERE k1.vertical = 'Restaurant'
     and  k1.month >>='2024-12-01'
         and date_trunc(k1.first_online_date,month) <<= k1.month - interval '2' month
   -- and first_online_date <<= month - interval '3' month
    group by all
    having was_active_before=False
    --)

   /* SELECT 
         k1.vendor_id,
         k1.country_code,
         a.was_active_before
        
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` k1 
     join active_before a on k1.vendor_id=a.vendor_id
    WHERE vertical = 'Restaurant'
     and  month =date_trunc(current_date,month) - interval '1' month-- December 2024
    and date_trunc(first_online_date,month) <<= month - interval '2' month
    and not was_active_before
    group by all
*/

),
comm as 
( SELECT 
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ), 
active_before_filtered as (

select * from (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from base  a 
 left join comm c on a.vendor_id=c.vendor_id
    ) 
    where vendor_dineout_flag=false

) 

  
),
date_series AS (
    -- Generate all dates in January 2025
    SELECT date ,date_trunc(date,month) as month
    FROM `tlb-data-prod.data_platform.dim_date` 
    WHERE date_trunc(date,month) between '2025-2-01' and date_trunc(current_date,month) 
),

Active_Base_m0 AS (
    /* Active vendors in December 2024 */
    SELECT 
        vendor_id,
        country_code,
        month,
        is_reactivated_churn
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`
    WHERE vertical = 'Restaurant'
      AND month >>='2025-02-01' 
      AND is_active  -- Only active vendors
      
),
  active_base_m0_filtered as (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from active_base_m0 a 
left join comm c on a.vendor_id=c.vendor_id ) 

    where vendor_dineout_flag=false
  ) 

,orders_M0 AS (
    -- Successful food orders in January 2025
    SELECT
        f.vendor_id,
        f.country_code,
        f.order_date,
        a.month
    FROM `tlb-data-prod.data_platform.fct_order_info` f 
    join active_base_m0_filtered a on f.vendor_id=a.vendor_id and a.month=date_trunc(f.order_date,month)
    WHERE date_trunc(order_date,month) >>= '2025-02-01' --=date_trunc(current_date,month)
      --AND NOT is_non_food
      --AND is_successful
) 
,orders_M0_zom AS (
    -- Successful food orders in January 2025
    SELECT
        f.vendor_id,
        f.country_code,
        f.order_date,
        a.month
    FROM `tlb-data-prod.data_platform.fct_order_info` f 
    join active_base_m0_filtered a on f.vendor_id=a.vendor_id and a.month=date_trunc(f.order_date,month)
    WHERE date_trunc(order_date,month) >>= '2025-02-01' --=date_trunc(current_date,month)
    and not is_reactivated_churn
      --AND NOT is_non_food
      --AND is_successful
) 


select *,max(reactivated_from_zombie) over(partition by country_code) as max_reactivated_from_zombie

from (
SELECT
    d.date,
    b.country_code,
    COUNT(DISTINCT o.vendor_id) AS reactivated_from_zombie,
    COUNT(DISTINCT b.vendor_id) AS churn_last_month,
    ROUND(COUNT(DISTINCT o.vendor_id) * 1.0 / COUNT(DISTINCT b.vendor_id),8) AS reactivation_rate
FROM date_series d
CROSS JOIN base b  -- All active vendors from December
LEFT JOIN orders_M0_zom o
    ON b.vendor_id = o.vendor_id
    AND b.country_code = o.country_code
    AND o.order_date <<= d.date  -- Orders up to the current date
    and date_trunc(o.order_date,month)=b.month+ interval '1' month
    and date_trunc(o.order_date,month)=date_trunc(d.date,month)
GROUP BY all
)
)

,actuals as (
  select *,max(reactivated_churn) over(partition by country_code) as max_reactivated_churn
  from(
    
SELECT
   --distinct  
   d.date,
   d.month,
   extract(day from d.date) as day,
    b.country_code,
   
   -- o.acquisition_business_type
    --b.vendor_id churned,
    COUNT(DISTINCT o.vendor_id) AS reactivated_churn,
    COUNT(DISTINCT b.vendor_id) AS churn_last_month,
    ROUND(COUNT(DISTINCT o.vendor_id) * 1.0 / COUNT(DISTINCT b.vendor_id), 4) AS reactivation_rate
FROM date_series d
CROSS JOIN churn_base_LM_filtered b  -- All active vendors from December
LEFT JOIN order_m0_filt o
    ON b.vendor_id = o.vendor_id
    AND b.country_code = o.country_code
    AND o.order_date <<= d.date  -- Orders up to the current date
    and date_trunc(o.order_date,month)=b.month+ interval '1' month
    and date_trunc(o.order_date,month)=date_trunc(d.date,month)
    where b.country_code <<>> 'SA'
GROUP BY all) 
)
,last_day as (select distinct month_start_date as month, extract(day from month_end_date) as last_day_of_month
  from `tlb-data-prod.data_platform.dim_date`
where month_start_date >>='2025-02-01' and month_start_date <<= date_trunc(current_date, month)
), 
actuals_edited as ( 


select a.*, b.last_day_of_month 
from actuals a 
left join last_day b 
on b.month=date_trunc(a.date, month)

)
select 
a.*,
z.reactivated_from_zombie,
max_reactivated_churn+max_reactivated_from_zombie as max_base,
reactivated_churn+reactivated_from_zombie as total_reactivated,
Target_value,
 round(Target_value*daily_reactivation_churn_weight)  as target_MTD_reactivated,
daily_reactivation_churn_weight
  , w.last_day_of_month
 from actuals_edited a
--join `tlb-data-dev.vendor_analytics.Reactivation_churn_daily_weights_opt` w 
join (select 

date,country_code,
reactivated, churn_last_month, 
reactivated/ max(reactivated) over(partition by country_code) as daily_reactivation_churn_weight, 
max(reactivated) over(partition by country_code) as max_reactivated, 
28 as last_day_of_month
 from tlb-data-dev.vendor_analytics.Reactivation_churn_daily_weights_opt 
 where date <<='2025-01-28'
union all 

select * from tlb-data-dev.vendor_analytics.Reactivation_churn_daily_weights_opt )w
on extract(day from w.date)=extract(day from a.date) and w.last_day_of_month=a.last_day_of_month -- double rows here 
 -- still double rows 
and w.country_code=a.country_code -- i will add here flag whether it's 30 or 31 day month
join `tlb-data-dev.vendor_analytics.Reactivation_targets_materialized` t on t.target_date=date_trunc(a.date,month)
and t.country=a.country_code
join reactivations_from_zombies z on z.country_code=a.country_code 
and extract(day from z.date) =a.day and date_trunc(z.date,month)=date_trunc(a.date,month)

)



 , 
 retn_hist as (/*create or replace table `tlb-data-dev.vendor_analytics.Retention_targets_materialized` 
as select * from tlb-data-dev.vendor_analytics.Retention_targets;

*/
/*create or replace table `tlb-data-dev.vendor_analytics.Retention_targets_materialized` 
as select * from tlb-data-dev.vendor_analytics.Retention_targets;

*/


/* create table only for the daily targets */ 

WITH Active_Base_LM AS (
    /* Active vendors in December 2024 */
    SELECT 
        vendor_id,
        country_code,
        month
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`
    WHERE vertical = 'Restaurant'
      --AND month = date_trunc(current_date,month)-interval '1' month  -- December 2024
      and month >>='2024-12-01'
      AND is_active  -- Only active vendors
),comm as 
( SELECT 
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ), 

  active_base_LM_filtered as (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from active_base_lm a 
left join comm c on a.vendor_id=c.vendor_id ) 
where vendor_dineout_flag=false
    
  ),

Active_Base_m0 AS (
    /* Active vendors in December 2024 */
    SELECT 
        vendor_id,
        country_code,
        month,
        is_retained, 
        previous_segment,
        is_active,
        date_trunc(first_online_date,month) as first_online_month
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`
    WHERE vertical = 'Restaurant'
      AND month >>='2025-2-01' --date_trunc(current_date,month) -- December 2024
      AND is_active  -- Only active vendors
),
  active_base_m0_filtered as (
    select * from (
select a.*,  IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag
 from active_base_m0 a 
left join comm c on a.vendor_id=c.vendor_id ) 
where vendor_dineout_flag=false
    
  )


,
date_series AS (
    -- Generate all dates in January 2025
    SELECT date ,date_trunc(date,month) as month
    FROM `tlb-data-prod.data_platform.dim_date` 
    WHERE date_trunc(date,month) between '2025-02-01' and date_trunc(current_date,month)
),

orders_M0 AS (
    -- Successful food orders in January 2025
    SELECT
        f.vendor_id,
        f.country_code,
        f.order_date,
        a.month,
        a.is_retained,
        a.first_online_month,
        a.previous_segment,
        a.is_active 
    FROM `tlb-data-prod.data_platform.fct_order_info` f 
    join active_base_m0_filtered a on f.vendor_id=a.vendor_id and a.month=date_trunc(f.order_date,month)
    WHERE date_trunc(order_date,month) >>='2025-02-01'
    --and first_online_month <<>> month
      --AND NOT is_non_food
      --AND is_successful
     -- and not(previous_segment='Active' and first_online_month=month)
      and a.is_active 
)
,orders_m0_filt as (
select distinct o.* except(order_date),acquisition_business_type  from orders_m0 o
join `tlb-data-prod.data_platform.dim_vendor_info` f on o.vendor_id=f.vendor_id 
where --vendor_id not in (702005,661003,753851)
 (first_online_month=month and previous_segment='Active')
 and acquisition_business_type <<>> 'Switch'

)
--select * from orders_m0_filt 



,daily_actuals as (
select a.month,
extract(day from date) as day, 
date,
a.country_code, 
--retention_rate,
--retained_vendors,
--a.first_online_month
count(distinct retained_vendors) as retained_vendors,
--active_base_last_month

from (
SELECT
    d.date,
    b.country_code,
    d.month,
    o.vendor_id as retained_vendors,
    --first_online_month,
    --is_retained
    --COUNT(DISTINCT o.vendor_id) AS retained_vendors,
    --COUNT(DISTINCT b.vendor_id) AS active_base_last_month,
    --ROUND(COUNT(DISTINCT o.vendor_id) * 1.0 / COUNT(DISTINCT b.vendor_id), 4) AS retention_rate
FROM date_series d
CROSS JOIN active_base_LM_filtered b  -- All active vendors from December
LEFT JOIN orders_m0 o
    ON b.vendor_id = o.vendor_id
    AND b.country_code = o.country_code
    AND o.order_date <<= d.date  -- Orders up to the current date
    and date_trunc(o.order_date,month)=b.month+ interval '1' month
    and date_trunc(o.order_date,month)=date_trunc(d.date,month)
--GROUP BY all
)a 
left join orders_m0_filt om on om.vendor_id=a.retained_vendors
 and om.month=a.month
where om.vendor_id is  null 
group by all
) 


,active_lm as (


    select country_code, month, 
    count(distinct vendor_id) active_lm
    from active_base_LM_filtered 
    group by all
  ), 

  active_lm_target as (

select country,
target_date as month,
Active_Inventory as lm_active_target 
  from `tlb-data-dev.vendor_analytics.Retention_targets_materialized` 



  )
  ,daily_actuals_v2 as (


    select a.*, alm.lm_active_target as active_base_last_month 
    ,retained_vendors/lm_active_target as retention_rate
    ,lm.active_lm
     from daily_actuals a 
join active_lm_target alm on alm.country=a.country_code 
and alm.month=a.month - interval '1' month

join active_lm lm on lm.country_code=a.country_code 
and lm.month=a.month - interval '1' month





  )

select *,round(target_retention_rate*active_base_last_month)  as target_retained
 from (

select d.*,target_value,
case when month='2025-02-01' and d.day=26 then
(target_value *0.996) 
when month='2025-02-01' and d.day=27 then
(target_value *0.998) 
  when month='2025-02-01' and d.day=28 then 
 (target_value*1) else  
target_value * daily_retention_weight end as target_retention_rate,




 from daily_actuals_v2 d 
join `tlb-data-dev.vendor_analytics.Retention_daily_weights` w 
on d.day=w.day and d.country_code=w.country_code
join `tlb-data-dev.vendor_analytics.Retention_targets_materialized` t on t.target_date=d.month
and t.country=d.country_code and t.Target_date=d.month

)









)






,retn_react as (
select distinct ret.*,
reactivated_churn
,churn_last_month
,max_reactivated_churn
,reactivated_from_zombie
,max_base,
total_reactivated
,rh.target_value as react_target_value_EOM
,target_MTD_reactivated
 from retn_hist ret 
join reactivation_history rh on ret.day=rh.day 
and ret.month=rh.month 
and ret.country_code=rh.country_code
) select * from retn_react]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
