  <column caption='Absolute Diff Retention %' datatype='real' default-format='*0.0%▲;-0.0%▼' name='[Absolute Diff Retention (copy)_2103673660513861651]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([retained_vendors])-sum([target_retained]))/sum([target_retained])' />
  </column>
  <column caption='Absolute Diff react %' datatype='real' name='[Absolute Diff react (copy)_2103673660510904335]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([total_reactivated])-sum([target_MTD_reactivated]))/sum([target_MTD_reactivated])' />
  </column>
  <column caption='Absolute Diff Retention' datatype='real' name='[Absolute Diff react (copy)_2103673660513665042]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([retained_vendors])-sum([target_retained])' />
  </column>
  <column caption='lastday' datatype='boolean' name='[Calculation_2103673660248477705]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF MONTH(TODAY()) = MONTH([month]) THEN&#10;    [day] = day(TODAY())-1&#10;ELSE&#10;    [day] = DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [month])))&#10;END' />
  </column>
  <column caption='Absolute Diff react' datatype='real' name='[Calculation_2103673660510781454]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([total_reactivated])-sum([target_MTD_reactivated])' />
  </column>
  <column caption='Regional' datatype='string' name='[Calculation_2103673660512415760]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&quot;Regional&quot;' />
  </column>
  <column caption='DAY' datatype='boolean' name='[Calculation_2665638407233310734]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    day &lt;= DAY(TODAY()) - 1&#10;ELSE&#10;    TRUE&#10;END' />
  </column>
  <column caption='RetentionRate' datatype='real' default-format='p0.0%' name='[Calculation_2665638407285547033]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([retained_vendors])/sum([active_base_last_month])' />
  </column>
  <column caption='TargetRetentionRate' datatype='real' default-format='p0.0%' name='[Calculation_2665638407285751834]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([target_retained])/sum([active_base_last_month])' />
  </column>
  <column caption='day filter' datatype='boolean' name='[Calculation_3919609459325845505]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY([date]) &lt;= DAY(TODAY()) - 1&#10;ELSE&#10;    TRUE&#10;END' />
  </column>
  <column caption='RetentionRate Actual' datatype='real' default-format='p0.0%' name='[RetentionRate (copy)_3105513452252622848]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([retained_vendors])/sum([active_lm])' />
  </column>
