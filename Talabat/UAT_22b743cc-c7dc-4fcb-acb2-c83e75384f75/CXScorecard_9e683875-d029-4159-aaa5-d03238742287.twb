      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query1' id='_917AA21BB7D7431DBDB907C01022B861'>
            <properties context=''>
              <relation connection='bigquery.1vrm2d40b22t5h12zhzzf1t5j18i' name='Custom SQL Query' type='text'><![CDATA[with a as (
  with in_ac_tmart as (
with repayments as
        (
          select
            date_trunc(repayment_date, week) as week,
            -- repayment_date as day_date,
            lower(fr.country_code) as country_code,
            count(distinct order_id) as inaccurate_orders
          from `tlb-data-prod.data_platform.fct_repayment` fr
          join `tlb-data-prod.data_platform.dim_repayment_type` drt on fr.repayment_type_id = drt.repayment_type_id
          join `tlb-data-prod.data_platform.dim_repayment_reason` drr on fr.repayment_reason_id = drr.repayment_reason_id
          left join `tlb-data-prod.data_platform.fct_order_info` using(order_id)
          where repayment_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and repayment_type = 'Partial Refund'
            and repayment_reason not in ('Coordination Issue>>Refusing offers and gem discounts','Cancelled Orders>>Cancelled Orders')
            and is_darkstore
            and fr.is_completed
          group by all order by 2 desc
        ),
        orders as
        (
          select
            date_trunc(order_date, week) as week,
            -- order_date as day_date,
            lower(country_code) as country_code,
            count(distinct order_id) as orders
          from `tlb-data-prod.data_platform.fct_order_info`
          left join `tlb-data-prod.data_platform.dim_order_status` using (order_status_id)
          where 
          -- is_successful and 
          is_net and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          --
          and is_darkstore
          group by all
        )
        select
        o.week,
        o.country_code,
        sum(r.inaccurate_orders) as inaccurate_orders_tmart,
        sum(o.orders) as orders_tmart,
        -- round(safe_divide(r.inaccurate_orders,o.orders),3) as in_ac_tmart
        from orders o
        left join repayments r
        on o.week = r.week
        and o.country_code = r.country_code
        
        where o.country_code <<>> 'sa'
        group by rollup (1,2)
        order by 1,2
)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
 from in_ac_tmart
where week is not null
),

b as (
  with avg_comp_amount as (


            SELECT
              date_trunc(order_date, week) as week,
              lower(foi.country_code)  AS country_code,
              COUNT(DISTINCT CASE WHEN (UPPER( dp.repayment_type  ) = UPPER('Compensation Order Related') OR UPPER( dp.repayment_type  ) = UPPER('Compensation Non Order Related')) THEN case when  fp.is_completed   then fp.order_id else null end  ELSE NULL END) AS compensated_orders_2,
              COALESCE(SUM(CASE WHEN (UPPER( dp.repayment_type  ) = UPPER('Compensation Order Related') OR UPPER( dp.repayment_type  ) = UPPER('Compensation Non Order Related')) THEN case when  fp.is_completed   then fp.repayment_amount_eur else 0 end  ELSE NULL END), 0) AS compensation_amount_eur
            FROM `tlb-data-prod.data_platform.fct_order_info` foi

            INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` vi
            ON vi.vendor_id = foi.vendor_id

            LEFT JOIN `tlb-data-prod.data_platform.fct_repayment` fp
              ON fp.order_id = foi.order_id
              and fp.repayment_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)

            LEFT JOIN `tlb-data-prod.data_platform.dim_repayment_type` dp
                ON fp.repayment_type_id=dp.repayment_type_id


            WHERE order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
            GROUP BY rollup (1,2)
            order by 1,2


)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from avg_comp_amount
where week is not null
),

c as (
  with compensation_coverage as (
          select
        date_trunc(foi.order_date, week) as week,
        lower(foi.country_Code) as country_code,
        count(distinct case when flo.order_id = foi.order_id then foi.order_id else null end) as delayed_orders,
        count(distinct case when fr.is_completed  and foi.order_id = fr.order_id then foi.order_id else null end ) as compensated_orders_3,
        -- sum(case when fr.is_completed and foi.order_id = fr.order_id then fr.repayment_amount_eur else 0 end ) as compensated_amount,
        -- safe_divide
        --   (count(distinct case when fr.is_completed  and foi.order_id = fr.order_id then foi.order_id else null end ),
        --     count(distinct case when flo.order_id = foi.order_id then foi.order_id else null end)) as compensation_coverage
        from `tlb-data-prod.data_platform.fct_order_info` foi
        inner join (select * from `tlb-data-prod.data_platform.fct_logistics_order` where order_delay/60 >>10 and created_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)) flo
        on foi.order_id = flo.order_id
        and lower(foi.country_code) = lower(flo.country_code)
        left join
        (select fr.*,drt.repayment_channel,drt.repayment_type
          from `tlb-data-prod.data_platform.fct_repayment` fr
          join `tlb-data-prod.data_platform.dim_repayment_type` drt on fr.repayment_type_id = drt.repayment_type_id
          where UPPER( drt.repayment_type  ) = UPPER('Compensation Order Related')
            and UPPER( drt.repayment_channel  ) in (UPPER('Reactive Compensation GHC'),UPPER('Reactive Compensation Agent'))
            and fr.repayment_date>>='2025-01-01'
        )fr on foi.order_id = fr.order_id
        and lower(foi.country_code) = lower(fr.country_code)
        where order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
        group by rollup (1,2)
        order by 1


)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from compensation_coverage
where week is not null
),

d as (
  with csat as (
            with survey_responses
          as(
            select
              session_id,
              created_date_localtime,
              country_code,
              sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and q8 in ('نعم','بەڵێ','Yes') then 1 else 0 end) as yes_res_contact,
              sum(case when survey_type = 'Self Service' and q8 in ('نعم','بەڵێ','Yes') then 1 else 0 end) as yes_res_SS,
              sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and q8 is not null then 1 else 0 end) as res_responses_contact,
              sum(case when survey_type = 'Self Service' and q8 is not null  then 1 else 0 end) as res_responses_SS,
              sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and csat in (4,5) then 1 else 0 end) as csat_contact,
              sum(case when survey_type = 'Self Service' and csat in (4,5) then 1 else 0 end) as csat_SS,
              sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and csat is not null then 1 else 0 end) as csat_responses_contact,
              sum(case when survey_type = 'Self Service' and csat is not null  then 1 else 0 end) as csat_responses_SS,
            from `fulfillment-dwh-production.curated_data_shared.tweety_csat_responses` tr
            left join `tlb-data-prod.data_platform.dim_logistics_entity` e
            on tr.global_entity_id = e.entity_id
            where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and stakeholder = 'Customer'
            group by all
          )
          select
          date_trunc(created_date_localtime, week) as week,
          country_code,
          -- safe_divide(sum(yes_res_contact), sum(res_responses_contact)) as contact_resolution_rate,
          sum(yes_res_contact) as yes_res_contact,
          sum(res_responses_contact) as res_responses_contact,
          -- safe_divide(sum(yes_res_SS), sum(res_responses_SS)) as self_service_resolution_rate,
          sum(yes_res_SS) as yes_res_SS,
          sum(res_responses_SS) as res_responses_SS,
          -- safe_divide(sum(csat_contact), sum(csat_responses_contact)) as contact_CSAT,
          sum(csat_contact) as csat_contact,
          sum(csat_responses_contact) as csat_responses_contact,
          -- safe_divide(sum(csat_SS), sum(csat_responses_SS)) as self_service_CSAT
          sum(csat_SS) as csat_SS,
          sum(csat_responses_SS) as csat_responses_SS
          from survey_responses
          where country_code in ('ae','eg','om','iq','qa','kw','bh','jo')


          group by rollup (1,2)
          order by 1,2
)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from csat
where week is not null
),

e as (
  with fcr as (

          with base as
            (
              select
                date_trunc(DATE(created_at_time_local), week) as week,
                order_id,
                lower(country_code) country_code,
                count(distinct contact_id) as number_of_contacts
              from `tlb-data-prod.data_platform.fct_contact`
              where created_at_time_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
              group by all
            )
          select
            week,
            country_code,
            -- safe_divide(count(distinct case when base.number_of_contacts = 1 then order_id else null end), count(distinct order_id)) as FCR,
            count(distinct case when base.number_of_contacts = 1 then order_id else null end) as fcr_up,
            count(distinct order_id) as fcr_down

          from base 
          group by rollup (1,2)
          order by 1,2


)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from fcr
where week is not null
),

f as (
  with ghc_session_rate as (
            with sessions
          as(
          select
            date_trunc(created_date_localtime, week) as week,
            lower(country_code) as country_code,
            count(distinct session_id) as GHC_sessions,
            count(distinct case when session_type in ('Automated','Deflected') then session_id else null end) as self_service_rate_up,
            count(distinct session_id) as self_service_rate_down,
            count(distinct case when session_type in ('Automated') then session_id else null end) as automated_sessions,

            -- safe_divide( count(distinct case when session_type in ('Automated','Deflected') then session_id else null end), count(distinct session_id)) as self_service_rate,  --self service rate
            -- safe_divide( count(distinct case when session_type in ('Automated') then session_id else null end), count(distinct session_id)) as automation_rate
          from `fulfillment-dwh-production.curated_data_shared.helpcenter_sessions` hs
          left join `tlb-data-prod.data_platform.dim_logistics_entity` e
          on hs.global_entity_id = e.entity_id
          where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and stakeholder = 'Customer'
            and session_type in ('Contacted','Automated','Deflected')
            and is_active_session
          group by all
          ),
          orders
          as(
          select
            date_trunc(order_date, week) as week,
            lower(country_code) as country_code,
            count(distinct order_id) as orders
          from `tlb-data-prod.data_platform.fct_order_info`
          where is_successful --check if this filter is necessary
            and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          group by all
          )
          select
          s.week,
          s.country_code,
          sum (GHC_sessions) as GHC_sessions,
          sum (orders) as orders,
          sum (self_service_rate_up) as self_service_rate_up,
          sum (self_service_rate_down) as self_service_rate_down,
          sum(automated_sessions) as automated_sessions
          -- safe_divide(GHC_sessions, orders) as GHC_session_rate_1,
          -- self_service_rate
          from sessions s
          left join orders o on s.week = o.week
          and s.country_code = o.country_code
          where s.country_code in ('ae','eg','om','iq','qa','kw','bh','jo')
          group by rollup (1,2)
          order by 1


)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from ghc_session_rate
where week is not null
),

g as (
with in_ac_food as (
  with repayments as
        (
          select
            date_trunc(repayment_date, week) as week,
            -- repayment_date as day_date,
            lower(fr.country_code) as country_code,
            count(distinct order_id) as inaccurate_orders
          from `tlb-data-prod.data_platform.fct_repayment` fr
          join `tlb-data-prod.data_platform.dim_repayment_type` drt on fr.repayment_type_id = drt.repayment_type_id
          join `tlb-data-prod.data_platform.dim_repayment_reason` drr on fr.repayment_reason_id = drr.repayment_reason_id
          left join `tlb-data-prod.data_platform.fct_order_info` using(order_id)
          where repayment_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and repayment_type = 'Partial Refund'
            and repayment_reason not in ('Coordination Issue>>Refusing offers and gem discounts','Cancelled Orders>>Cancelled Orders')
            and fr.is_completed
            and not is_non_food
          group by all order by 2 desc
        ),
        orders as
        (
          select
            date_trunc(order_date, week) as week,
            lower(country_code) as country_code,
            count(distinct order_id) as orders
          from `tlb-data-prod.data_platform.fct_order_info`
          left join `tlb-data-prod.data_platform.dim_order_status` using (order_status_id)
          where 
          -- is_successful and 
           is_net and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          --
          and not is_non_food
           
          group by all
        )
        select
        o.week,
        o.country_code,
        sum(r.inaccurate_orders) as inaccurate_orders_food,
        sum(o.orders) as orders_food,
        -- round(safe_divide(r.inaccurate_orders,o.orders),3) as in_ac_food
        from orders o
        left join repayments r
        on o.week = r.week
        and o.country_code = r.country_code
        where o.country_code <<>> 'sa' 
        group by rollup (1,2)
        order by 1
)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
 from in_ac_food
where week is not null

),

h as (
  with late_orders as (
            SELECT
            date_trunc(order_date, week) as week,
            lower(foi.country_Code) as country_code,
            COUNT(DISTINCT CASE WHEN (( case when not flo.is_logistics_preorder and flo.order_status='completed' then flo.order_delay/60  end ) >> 10) THEN flo.order_code  ELSE NULL END) AS orders_late_greater_than_10_min_1,
            COALESCE(SUM(CASE WHEN foi.is_successful  THEN 1  ELSE NULL END), 0) AS successful_orders_count
          FROM `tlb-data-prod.data_platform.fct_order_info` foi
          LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` flo
              ON flo.order_id = foi.order_id and flo.is_talabat and flo.is_rider_order
            
          where lower(foi.country_Code) in ('ae','eg','om','iq','qa','kw','bh','jo')
          and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          GROUP BY rollup (1,2)
          order by 1,2


)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from late_orders
where week is not null
),

i as (
  with leaf_rating as (
          with leaf_ratings
        as(
          select
            session_id,
            created_date_localtime,
            country_code,
            sum(case when leaf_rating is not null then 1 else 0 end) as leafs_rated,
            sum(case when leaf_rating = 1 then 1 else 0 end) as yes_rating,
            sum(case when leaf_rating = 0 then 1 else 0 end) as no_rating
          from `fulfillment-dwh-production.curated_data_shared.helpcenter_navigation_steps` a
          left join `tlb-data-prod.data_platform.dim_logistics_entity` e
          on a.global_entity_id = e.entity_id
          where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and stakeholder = 'Customer' and is_leaf
          group by all
        )
        select
        date_trunc(created_date_localtime, week) as week,
        country_code,
        -- count(distinct session_id) as sessions,
        -- sum(leafs_rated) as leafs_rated,
        -- safe_divide(sum(yes_rating),sum(leafs_rated)) as leaf_rating,
        sum(yes_rating) as yes_rating,
        sum(leafs_rated) as leafs_rated
        from leaf_ratings
        where country_code in ('ae','eg','om','iq','qa','kw','bh','jo')
        group by rollup (1,2)
        order by 1,2


)


select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from leaf_rating
where week is not null
),

j as (
  with nfr as (
          SELECT
            date_trunc(order_date, week) as week,
            lower(foi.country_Code) as country_code,
            -- SAFE_DIVIDE(COALESCE(SUM(CASE WHEN  os.is_net   AND NOT  foi.is_successful   THEN  1   ELSE 0 END ), 0), COALESCE(SUM(CASE WHEN  os.is_net   THEN  1   ELSE 0 END ), 0)) AS net_fail_rate
          COALESCE(SUM(CASE WHEN  os.is_net   AND NOT  foi.is_successful   THEN  1   ELSE 0 END ), 0) nfr_up,
          COALESCE(SUM(CASE WHEN  os.is_net   THEN  1   ELSE 0 END ), 0) nfr_down
          FROM `tlb-data-prod.data_platform.fct_order_info` foi
            
          INNER JOIN `tlb-data-prod.data_platform.dim_order_status` os
              ON os.order_status_id = foi.order_status_id


          where lower(foi.country_Code) in ('ae','eg','om','iq','qa','kw','bh','jo')
          and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          GROUP BY rollup (1,2)
          order by 1,2

)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from nfr
where week is not null
),

k as (
  with orders_compensated as (
            SELECT
            date_trunc(order_date, week) as week,
            lower(foi.country_code)  AS country_code,
            COUNT(DISTINCT CASE WHEN (( case when not flo.is_logistics_preorder and flo.order_status='completed' then flo.order_delay/60  end ) >> 10) THEN flo.order_code  ELSE NULL END) AS orders_late_greater_than_10_min,
            COUNT(DISTINCT CASE WHEN (UPPER( rp.repayment_type  ) = UPPER('Compensation Order Related') OR UPPER( rp.repayment_type  ) = UPPER('Compensation Non Order Related')) THEN case when  fp.is_completed   then fp.order_id else null end  ELSE NULL END) AS compensated_orders_1,
          COUNT(DISTINCT CASE WHEN os.is_net AND NOT foi.is_successful THEN foi.order_id END) net_failed_orders_count,


          count(DISTINCT
            CASE
              WHEN UPPER(fr.talabat_reason) IN (
                'INTERNET ISSUE', 'VEN REFUSE DISCOUNT', 'RIDER REFUSE TO DELIVER',
                'TLB SYSTEM SHOWS DISCREPENCY IN PDT', 'DELAY IN PREPARE PICKUP ORDER',
                'RIDER ACCIDENT', 'REASON UNKNOWN', 'VEN - CONTENT DISCREPANCY',
                'VEN INCORRECT LOCATION', 'BAD WEATHER', 'N/A',
                'VEN - DON\'T DELIVER TO THIS AREA', 'LACK OF DELIVERY MEN',
                'PREPARATION DELAY', 'RIDER UNREACHABLE', 'ORDER NOT DELIVERED',
                'TECHNICAL ISSUE', 'VEN WRONG ORDER', 'ORDER PICKED-UP/ DELIVERED BY ANOTHER RIDER',
                'UNAVAILABLE MENU ITEM', 'PRE_ACCEPTANCE_VOUCHER_NOT_APPLIED',
                'VEN - IGNORED SPECIAL REQUEST', 'ELECTRICITY ISSUE', 'LATE DELIVERY',
                'TLB - SYSTEM ISSUE', 'VENDOR IS TOO BUSY', 'VEN CLOSED',
                'FAILING TO PUNCH ORDER (MISSED)', 'VEN - UNCONTACTABLE',
                'SPILT/ DAMAGED ORDER', 'VEN - DON\'T WORK WITH TALABAT',
                'VEN - REFUSE TO PREPARE ORDER', 'KITCHEN ISSUE', 'TMART NO PICKERS',
                'UNPROFESSIONAL BEHAVIOR FROM RIDER', 'VEN - MIN ORDER VALUE UNREACHED',
                'FAILING TO PUNCH ORDER (EXPIRED)', 'RIDER MIXED UP ORDERS',
                'FOOD IS INEDIBLE', 'PRE_ACCEPTANCE_CHANGED_MIND_NO_REASON',
                'PRE_ACCEPTANCE_DUPLICATE_ORDER'
              )
              AND os.is_net
              AND not foi.is_successful
              THEN foi.order_id
            END
          ) AS eligible_failed_order_for_comp

          FROM `tlb-data-prod.data_platform.fct_order_info` foi

          LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` flo
              ON flo.order_id = foi.order_id and flo.is_talabat and flo.is_rider_order
              and flo.created_date >>=DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)

          INNER JOIN `tlb-data-prod.data_platform.dim_order_status` os
              ON os.order_status_id = foi.order_status_id
          LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` fr
              ON fr.order_fail_reason_id = foi.order_fail_reason_id
          INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` vi
              ON vi.vendor_id = foi.vendor_id

          LEFT JOIN `tlb-data-prod.data_platform.fct_repayment` fp
            ON fp.order_id = foi.order_id
            and fp.repayment_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -23 MONTH), MONTH)

          LEFT JOIN `tlb-data-prod.data_platform.dim_repayment_type` rp
              ON fp.repayment_type_id=rp.repayment_type_id

          WHERE foi.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
          GROUP BY rollup (1,2)
          order by 1,2
 
)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from orders_compensated
where week is not null
),

l as (
  with overall_resolution_rate as (
              with automation_contact
            as(
              select
                session_id,
                global_entity_id,
                sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and q8 in ('نعم','بەڵێ','Yes') then 1 else 0 end) as yes_res_contact,
                sum(case when survey_type = 'Self Service' and q8 in ('نعم','بەڵێ','Yes') then 1 else 0 end) as yes_res_SS,
                sum(case when survey_type = 'After Contact' and (chat_id is not null or case_number is not null)  and q8 is not null then 1 else 0 end) as res_responses_contact,
                sum(case when survey_type = 'Self Service' and q8 is not null  then 1 else 0 end) as res_responses_SS,
              from `fulfillment-dwh-production.curated_data_shared.tweety_csat_responses`
              where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
                and stakeholder = 'Customer'
              group by all
            ),
            leaf_ratings
            as(
              select
                session_id,
                global_entity_id,
                sum(case when leaf_rating is not null then 1 else 0 end) as leafs_rated,
                sum(case when leaf_rating = 1 then 1 else 0 end) as yes_rating,
                sum(case when leaf_rating = 0 then 1 else 0 end) as no_rating
              from `fulfillment-dwh-production.curated_data_shared.helpcenter_navigation_steps`
              where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
                and stakeholder = 'Customer' and is_leaf
              group by all
            ),
            sessions
            as(
            select
              global_entity_id,
              session_id,
              order_id,
              stakeholder_id as account_id,
              created_date_localtime as day,
              session_type
            from `fulfillment-dwh-production.curated_data_shared.helpcenter_sessions`
            where created_date_localtime BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY)
                and stakeholder = 'Customer'
              and session_type in ('Contacted','Automated','Deflected')


            ),
            final_tag
            as(
            select
              s.global_entity_id,
              s.session_id,
              s.account_id,
              s.order_id,
              day,
              session_type,
              case when session_type in ('Deflected') and lr.session_id = s.session_id
                then
                  case when safe_divide(yes_rating, leafs_rated) = 1 then 'Resolved'
                    when safe_divide(no_rating, leafs_rated) >> 0 then 'Unresolved'
                  else 'No response'  end
                when session_type in ('Contacted') and s.session_id = ac.session_id
                  then
                    case when safe_divide(yes_res_contact,res_responses_contact) = 1 then 'Resolved'
                    when (1-safe_divide(yes_res_contact,res_responses_contact)) >> 0 then 'Unresolved'
                    else 'No response' end
                when session_type in ('Automated') and s.session_id = ac.session_id
                  then
                    case when safe_divide(yes_res_SS,res_responses_SS) = 1 then 'Resolved'
                    when (1-safe_divide(yes_res_SS,res_responses_SS)) >> 0 then 'Unresolved'
                    else 'No response' end
                else 'No response'
              end as resolution_flag
            from sessions s
            left join automation_contact ac on s.session_id = ac.session_id
            left join leaf_ratings lr on lr.session_id = s.session_id
            )
            select
            -- session_id,
            date_trunc(day, week) as week,
            -- global_entity_id,
            country_code,
            -- session_type,
            count(distinct case when resolution_flag = 'Resolved' then session_id else null end) as resolved_sessions,
            count(distinct case when resolution_flag <<>> 'No response' then session_id else null end) as resolution_rate_down,
            -- safe_divide(count(distinct case when resolution_flag = 'Resolved' then session_id else null end),
            --   count(distinct case when resolution_flag <<>> 'No response' then session_id else null end)) as resolution_rate,
            -- safe_divide(count(distinct case when resolution_flag <<>> 'No response' then session_id else null end),
            --   count(distinct session_id )) as response_rate,
            count(distinct session_id) as sessions,
            -- count(distinct case when resolution_flag = 'Resolved' then session_id else null end) as resolved_sessions,
            -- count(distinct case when resolution_flag = 'Unresolved' then session_id else null end) as unresolved_sessions,
            -- count(distinct case when resolution_flag = 'No response' then session_id else null end) as no_response_sessions,
            -- count(distinct order_id) as orders
            from final_tag ft
            left join `tlb-data-prod.data_platform.dim_logistics_entity` e
            on ft.global_entity_id = e.entity_id
            where day BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 WEEK), WEEK)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK), INTERVAL 1 DAY) 
            and country_code in ('ae','eg','om','iq','qa','kw','bh','jo')
            group by rollup (1,2)
            order by 1,2


)
select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from overall_resolution_rate
where week is not null
),

m as (
  with contact_rate as (
  with contact as (
  select 
  date_trunc(contact_date_local, week) as week,
  lower(country_code) as country_code,
  count(distinct contact_id) as contact_count
  from `tlb-data-prod.data_platform.fct_contact` c
  left join `tlb-data-prod.data_platform.dim_contact_stakeholder` s
  on c.stakeholder_id = s.contact_stakeholder_id
  where contact_stakeholder = 'Customer'
  and contact_date_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 week), week)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), week), INTERVAL 1 DAY) 
  group by all
),

orders as (
  select 
  date_trunc(order_date, week) as week,
  lower(country_code) as country_code,
  count(distinct order_id) as order_count
  from `tlb-data-prod.data_platform.fct_order_info`
  where is_successful
  and order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 52 week), week)
                AND DATE_SUB(DATE_TRUNC(CURRENT_DATE(), week), INTERVAL 1 DAY) 
  group by all
)

select
        contact.week,
        contact.country_code,
        sum(contact_count) as contact_count,
        sum(order_count) as order_count,
        from contact 
        left join orders using (week, country_code)
        where country_code in ('ae','eg','om','iq','qa','kw','bh','jo')
        group by rollup (1,2)
        order by 1,2
)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
 from contact_rate
where week is not null
),

n as (
  with pr_automated as (
  SELECT 
date_trunc(created_date, week) as week,
country_code,

-- automation_type,
-- resolution,
-- resolution_detail,
-- fallback_type,
-- fallback_reason, 
count(distinct case when resolution_detail='added_to_wallet' then session_id end) as automated,
count(distinct session_id) as seess
FROM `fulfillment-dwh-production.curated_data_shared.helpcenter_automations_v2` hc
left join `tlb-data-prod.data_platform.dim_logistics_entity` e
on hc.global_entity_id = e.entity_id
where automation_type in ('autoPartialRefund','partialRefundV2')
and  created_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) AND current_date()
and country_code in ('ae','eg','kw','qa','bh','iq','jo','om')
group by rollup (1,2)
order by 1,2
)

select * except (country_code),
case when country_code is null then "MENA" else upper(country_code) end as country_code
from pr_automated
where week is not null
)



select a.week,
a.country_code as cont_cont,
a.inaccurate_orders_tmart,
a.orders_tmart,
b.* except (week, country_code),
c.* except (week, country_code),
d.* except (week, country_code),
e.* except (week, country_code),
f.* except (week, country_code),
g.* except (week, country_code),
h.* except (week, country_code),
i.* except (week, country_code),
j.* except (week, country_code),
k.* except (week, country_code),
l.* except (week, country_code),
m.* except (week, country_code),
n.* except (week, country_code)


from a 
left join b using(week, country_code)
left join c using(week, country_code)
left join d using(week, country_code)
left join e using(week, country_code)
left join f using(week, country_code)
left join g using(week, country_code)
left join h using(week, country_code)
left join i using(week, country_code)
left join j using(week, country_code)
left join k using(week, country_code)
left join l using(week, country_code)
left join m using(week, country_code)
left join n using(week, country_code)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0h2t66q11bhrti1fioqqq16fwu4x'>
      <datasources>
        <datasource caption='query' name='federated.0h2t66q11bhrti1fioqqq16fwu4x' />
      </datasources>
      <datasource-dependencies datasource='federated.0h2t66q11bhrti1fioqqq16fwu4x'>
        <column caption='Country ' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
