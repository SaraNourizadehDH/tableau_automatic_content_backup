0 as yes_res_SS,
0 as res_responses_SS,
0 as csat_contact,
0 as csat_responses_contact,
0 as csat_SS,
0 as csat_responses_SS

from c 

union all

select 
day_date,
country_code,
cast (null as string) as session_type,
csat_type,
is_tpro,
is_tgo,
is_darkstore,
is_localshop,
is_non_food,
vertical_type,

