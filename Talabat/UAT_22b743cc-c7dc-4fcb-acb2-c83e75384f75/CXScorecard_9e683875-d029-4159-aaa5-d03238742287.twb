      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_5513391155038638080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_contact])/SUM([csat_responses_contact])' />
      </column>
      <column caption='reso_up' datatype='integer' name='[Calculation_5513391155043393537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [day_date] &gt;= DATE(&apos;2025-05-01&apos;) then [resolved_sessions] ELSE 0 END' />
      </column>
      <column caption='reso_down' datatype='integer' name='[Calculation_5513391155043475458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [day_date] &gt;= DATE(&apos;2025-05-01&apos;) THEN [resolution_rate_down] else 0 END' />
      </column>
      <column caption='Contact CSAT' datatype='real' name='[Calculation_5513391155043614723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_contact])/SUM([csat_responses_contact])' />
      </column>
      <column caption='Leaf Rating' datatype='real' name='[Calculation_5513391155043696644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yes_rating])/SUM([leafs_rated])' />
      </column>
      <column caption='Resolution Rate' datatype='real' name='[Calculation_5513391155043774469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5513391155043393537])/SUM([Calculation_5513391155043475458])' />
      </column>
      <column caption='Response Rate' datatype='real' name='[Calculation_5513391155043860486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([resolution_rate_down])/sum([sessions])' />
      </column>
