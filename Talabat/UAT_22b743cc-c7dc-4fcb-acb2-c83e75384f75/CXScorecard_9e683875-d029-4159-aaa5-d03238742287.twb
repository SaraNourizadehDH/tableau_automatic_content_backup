          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Response Rate&quot;'>
              <calculation class='tableau' formula='&quot;Response Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h2t66q11bhrti1fioqqq16fwu4x'>
            <column caption='Automation Rate' datatype='real' name='[Calculation_1956743708830031872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[automated_sessions]/[GHC_sessions]' />
            </column>
            <column caption='PR Claims Automated' datatype='real' name='[Calculation_3353492916664430597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([automated])/SUM([seess])' />
            </column>
            <column caption='churn_up' datatype='integer' name='[Calculation_3353492916677566472]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='if [month] &lt; DATETRUNC(&quot;month&quot;,TODAY()) then [churn] ELSE 0 END' />
            </column>
            <column caption='churn_down' datatype='integer' name='[Calculation_3353492916679405577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [month] &lt; DATETRUNC(&quot;month&quot;,TODAY()) then [MAU] ELSE 0 END' />
            </column>
            <column caption='Inaccurate Orders (tmart)' datatype='real' name='[Calculation_533887701176926208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[inaccurate_orders_tmart]/[orders_tmart]' />
            </column>
            <column caption='Inaccurate Orders (Food)' datatype='real' name='[Calculation_533887701182210049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[inaccurate_orders_food]/[orders_food]' />
            </column>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_533887701185449986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6278510503386877955]/[Calculation_6278510503387140100]' />
            </column>
            <column caption='Response Rate' datatype='real' name='[Calculation_533887701185540099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[resolution_rate_down]/[sessions]' />
            </column>
            <column caption='compensation coverage' datatype='real' name='[Calculation_533887701188018180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[compensated_orders_3]/[delayed_orders]' />
            </column>
            <column caption='GHC Session Rate' datatype='real' name='[Calculation_533887701190656005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GHC_sessions]/[orders]' />
            </column>
            <column caption='Self-Service Rate' datatype='real' name='[Calculation_533887701190774790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[self_service_rate_up]/[self_service_rate_down]' />
            </column>
            <column caption='Compensation Coverage' datatype='real' name='[Calculation_533887701197791239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[compensated_orders_1]/([eligible_failed_order_for_comp]+ [delayed_orders])' />
            </column>
            <column caption='AVG compensation amount EUR' datatype='real' name='[Calculation_533887701200695304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[compensation_amount_eur]/[compensated_orders_2]' />
            </column>
            <column caption='Leaf Rating' datatype='real' name='[Calculation_533887701203128329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[yes_rating]/[leafs_rated]' />
            </column>
            <column caption='Order Frequency Rate' datatype='real' name='[Calculation_533887701206822922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_frequency_up]/[order_frequency_down]' />
            </column>
            <column caption='late orders' datatype='integer' name='[Calculation_533887701209751563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_late_greater_than_10_min]' />
            </column>
            <column caption='Late Orders' datatype='real' name='[Calculation_533887701209894924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_late_greater_than_10_min_1]/[successful_orders_count]' />
            </column>
            <column caption='Net Fail Rate' datatype='real' name='[Calculation_533887701220220941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[nfr_up]/[nfr_down]' />
            </column>
            <column caption='contact_resolution_rate' datatype='real' name='[Calculation_533887701223342094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[yes_res_contact]/[res_responses_contact]' />
            </column>
            <column caption='self_service_resolution_rate' datatype='real' name='[Calculation_533887701223837711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[yes_res_SS]/[res_responses_SS]' />
