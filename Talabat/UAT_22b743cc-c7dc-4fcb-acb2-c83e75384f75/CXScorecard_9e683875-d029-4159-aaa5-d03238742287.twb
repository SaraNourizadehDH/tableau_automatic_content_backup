    <worksheet name='Score Per Week'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly' name='federated.1s8lhmv1k4nqrb1fgumpi0fuhjpg' />
          </datasources>
          <datasource-dependencies datasource='federated.1s8lhmv1k4nqrb1fgumpi0fuhjpg'>
            <column caption='PR Claims Automated' datatype='real' name='[Calculation_3353492916685230090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([automated])/ sum([seess])' />
            </column>
            <column caption='Contact Rate' datatype='real' name='[Calculation_421016238379139072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([contact_count])/ Sum([order_count])' />
            </column>
            <column caption='Inaccurate Orders (Food)' datatype='real' name='[Calculation_4982247866507620352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inaccurate_orders_food])/sum([orders_food])' />
            </column>
            <column caption='Inaccurate Orders (tmart)' datatype='real' name='[Calculation_4982247866508070913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([inaccurate_orders_tmart])/sum([orders_tmart])' />
            </column>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_4982247866508795906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_6278510503383339009])/sum([Calculation_6278510503383719938])' />
            </column>
            <column caption='Compensation Coverage' datatype='real' name='[Calculation_4982247866520211461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([compensated_orders_1])/(sum([eligible_failed_order_for_comp])+ sum([delayed_orders]))' />
            </column>
            <column caption='Response Rate' datatype='real' name='[Calculation_4982247866520571910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([resolution_rate_down])/sum([sessions])' />
            </column>
            <column caption='GHC Session Rate' datatype='real' name='[Calculation_4982247866521079815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GHC_sessions])/sum([orders])' />
            </column>
            <column caption='Self-Service Rate' datatype='real' name='[Calculation_4982247866521460744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([self_service_rate_up])/sum([self_service_rate_down])' />
            </column>
            <column caption='AVG compensation amount EUR' datatype='real' name='[Calculation_4982247866521690121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([compensation_amount_eur])/sum([compensated_orders_2])' />
            </column>
            <column caption='Leaf Rating' datatype='real' name='[Calculation_4982247866522505226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([yes_rating])/sum([leafs_rated])' />
            </column>
            <column caption='Late Orders' datatype='real' name='[Calculation_4982247866522759179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_late_greater_than_10_min_1])/sum([successful_orders_count])' />
            </column>
            <column caption='Net Fail Rate' datatype='real' name='[Calculation_4982247866523611148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([nfr_up])/sum([nfr_down])' />
            </column>
            <column caption='Automation Rate' datatype='real' name='[Calculation_4982247866523803661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([automated_sessions])/sum([GHC_sessions])' />
            </column>
            <column caption='Contact CSAT' datatype='real' name='[Calculation_4982247866524164110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([csat_contact])/sum([csat_responses_contact])' />
            </column>
            <column caption='Self-Service CSAT' datatype='real' name='[Calculation_4982247866524565519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([csat_SS])/sum([csat_responses_SS])' />
            </column>
            <column caption='First Contact Resolution' datatype='real' name='[Calculation_4982247866524786704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fcr_up])/sum([fcr_down])' />
            </column>
            <column caption='reso_up' datatype='integer' name='[Calculation_6278510503383339009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [week]&gt;= DATE(&apos;2025-05-05&apos;) then [resolved_sessions] ELSE 0 END' />
            </column>
            <column caption='reso_down' datatype='integer' name='[Calculation_6278510503383719938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [week]&gt;= DATE(&apos;2025-05-05&apos;) THEN [resolution_rate_down] ELSE 0 END' />
            </column>
            <column datatype='integer' name='[GHC_sessions]' role='measure' type='quantitative' />
