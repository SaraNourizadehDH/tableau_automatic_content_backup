      <aliases enabled='yes' />
      <column caption='Calculation1dfdf' datatype='string' hidden='true' name='[Calculation_1860197791540236335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Inaccurate Orders - Food&quot; THEN &quot;OKRs&quot;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Inaccurate Orders - Tmart&quot; THEN &quot;OKRs&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Resolution Rate&quot; then &quot;OKRs&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Response Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Compensation Coverage&quot; then &quot;OKRs&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;GHC Session Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Self-Service Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Order Compensated Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;AVG Compensation EUR&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Leaf Rating&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Order Frequency Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Late Orders&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;NFR&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Contact CSAT&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Self Service CSAT&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Churn Rate&quot; then &quot;BAU&quot;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;FCR&quot; then &quot;BAU&quot;&#10;&#10;END' />
      </column>
      <column caption='Automation Rate' datatype='real' name='[Calculation_1956743708830031872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[automated_sessions]/[GHC_sessions]' />
      </column>
      <column caption='PR Claims Automated' datatype='real' name='[Calculation_3353492916664430597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([automated])/SUM([seess])' />
      </column>
      <column caption='Contact Rate' datatype='real' name='[Calculation_3353492916675354631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([contact_count])/ sum([order_count])' />
      </column>
      <column caption='churn_up' datatype='integer' name='[Calculation_3353492916677566472]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='if [month] &lt; DATETRUNC(&quot;month&quot;,TODAY()) then [churn] ELSE 0 END' />
      </column>
      <column caption='churn_down' datatype='integer' name='[Calculation_3353492916679405577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [month] &lt; DATETRUNC(&quot;month&quot;,TODAY()) then [MAU] ELSE 0 END' />
      </column>
      <column caption='selected metric' datatype='real' hidden='true' name='[Calculation_4982247866527547410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Inaccurate Orders - Food&quot; THEN SUM([Calculation_533887701182210049])&#10;ELSEIF  [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Inaccurate Orders - Tmart&quot; THEN SUM([Calculation_533887701176926208])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Resolution Rate&quot; then SUM([Calculation_533887701185449986])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Response Rate&quot; then SUM([Calculation_533887701185540099])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Compensation Coverage&quot; then SUM([Calculation_533887701197791239])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;GHC Session Rate&quot; then sum([Calculation_533887701190656005])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Self-Service Rate&quot; then SUM([Calculation_533887701190774790])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Automation Rate&quot; then SUM([Calculation_1956743708830031872])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;AVG Compensation EUR&quot; then SUM([Calculation_533887701200695304])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Leaf Rating&quot; then SUM([Calculation_533887701203128329])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;PR Claims Automated&quot; THEN ([Calculation_3353492916664430597])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Late Orders&quot; then SUM([Calculation_533887701209894924])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Net Fail Rate&quot; then SUM([Calculation_533887701220220941])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Contact CSAT&quot; then SUM([Calculation_533887701224038416])&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;Self Service CSAT&quot; then SUM([Calculation_533887701224239121])&#10;&#10;ELSEIF [Parameters].[Select Metric (copy)_4982247866525548561] = &quot;First Contact Resolution&quot; then SUM([Calculation_533887701232001043])&#10;&#10;END' />
