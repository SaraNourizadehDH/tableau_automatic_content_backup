  <column caption='Retained' datatype='integer' name='[Calculation_3605624119586951168]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [active_status]=1 and [last_month_active_status]=1 and [index]&gt;0 then [vendor_id] END)' />
  </column>
  <column caption='Retained %' datatype='real' name='[Calculation_3605624119619035137]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_3605624119586951168]/COUNTD([vendor_id])' />
  </column>
  <column caption='Active Status ' datatype='string' name='[Calculation_440789845935165441]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [active_status]=1 then &apos;Activated&apos;&#10;ELSEIF [active_status] = 0 THEN &apos;Not activated&apos;&#10;END' />
  </column>
  <column caption='Activated vs not yet activated' datatype='string' name='[Calculation_440789845937479682]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [m0_status] = 0 AND [index] = 0 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 1 AND [index] = 0 THEN &apos;activated&apos;&#10;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [index] = 1 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 1 AND [index] = 1 THEN &apos;activated&apos;&#10;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [index] = 2 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 1 AND [index] = 2 THEN &apos;activated&apos;&#10;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 0 AND [index] = 3 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 1 AND [index] = 3 THEN &apos;activated&apos;&#10;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 0 AND [m4_active_status] = 0 AND [index] = 4 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 0 AND [m4_active_status] = 1 AND [index] = 4 THEN &apos;activated&apos;&#10;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 0 AND [m4_active_status] = 0 AND [m5_active_status] = 0 AND [index] = 5 THEN &apos;not yet activated&apos;&#10;ELSEIF [m0_status] = 0 AND [m1_active_status] = 0 AND [m2_active_status] = 0 AND [m3_active_status] = 0 AND [m4_active_status] = 0 AND [m5_active_status] = 1 AND [index] = 5 THEN &apos;activated&apos;&#10;&#10;END' />
  </column>
  <column caption='DLP' datatype='real' name='[Calculation_440789845940518915]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([item_with_image_count])/sum([active_menu_item_count])' />
  </column>
  <column caption='DLD' datatype='real' name='[Calculation_440789845940654084]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([item_with_description_count])/sum([active_menu_item_count])' />
  </column>
  <column caption='CVR' datatype='real' name='[Calculation_440789845940789253]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([placed_order_count])/sum([viewed_menu_session_count])' />
  </column>
  <column caption='view_menu_to_vendor_list_impressions' datatype='real' name='[Calculation_440789845940850694]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([viewed_menu_session_count])/sum([vendor_list_impression_count])' />
  </column>
  <column caption='on_cpc' datatype='integer' name='[Calculation_440789845940994055]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='count(if [cpc]&gt;0 then [vendor_id] else null end)' />
  </column>
  <column caption='on discount' datatype='integer' name='[Calculation_440789845941346312]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='count(if [discount]&gt;0 then [vendor_id] else null end)' />
  </column>
  <column caption='Vendors on Adrev' datatype='integer' name='[Calculation_440789845941448713]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='count(if [ad_rev]&gt;0 then [vendor_id] else null end)' />
  </column>
  <column caption='Offline time percent' datatype='real' name='[Calculation_440789845941555210]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([offline_duration_in_hours])/sum([schedule_duration_in_hours])' />
  </column>
  <column caption='#vendors' datatype='integer' name='[Calculation_440789845942054923]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([vendor_id])' />
  </column>
  <column caption='Succ Orders' datatype='real' name='[Calculation_440789845956866060]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:MEDIAN([succ_orders])}' />
  </column>
  <column caption=' OfflineTimePercent' datatype='real' name='[Calculation_440789845957152781]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:sum([offline_duration_in_hours])}/&#10;{fixed [vendor_id],[index]:sum([schedule_duration_in_hours])}' />
  </column>
  <column caption='Time to first order in days' datatype='integer' name='[Calculation_440789845962608654]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[first_order_date]-[first_online_date]' />
  </column>
  <column caption='M-index' datatype='string' name='[Calculation_440789845986099215]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&quot;M&quot; + str([index])' />
  </column>
  <column caption='Vendors with offline time &lt;20%' datatype='integer' name='[Calculation_6566107551969435648]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if([Calculation_440789845957152781]) &lt;0.2 then [vendor_id] else null END)' />
  </column>
  <column caption='Vendors with offline time &lt;20% percent' datatype='real' name='[Calculation_6566107551970091011]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([Calculation_6566107551969435648])/COUNTD([vendor_id])' />
  </column>
  <column caption='tpro vendors' datatype='integer' name='[Calculation_6566107551983439876]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='countd(if [is_tpro] then [vendor_id] else null end)' />
  </column>
  <column caption='Tpro %' datatype='real' name='[Calculation_6566107551983558661]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_6566107551983439876]/COUNTD([vendor_id])' />
  </column>
  <column caption='Avg Schedule per day' datatype='real' name='[Calculation_6566107552026607622]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[schedule_duration_in_hours]/30' />
  </column>
  <column caption='Vendors with schedule &lt;4 hours ' datatype='integer' name='[Calculation_6566107552026882055]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [Calculation_6566107552026607622] &lt;4 then [vendor_id] else null end)' />
  </column>
  <column caption='impressions' datatype='integer' name='[Calculation_6566107552030208008]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:sum([vendor_list_impression_count])}' />
  </column>
  <column caption='Vendor list sessions' datatype='integer' name='[Calculation_6566107552030486537]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:sum([vendor_list_session_count])}' />
  </column>
  <column caption='SuccOrders %' datatype='real' name='[Calculation_6566107552031014922]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:MEDIAN([succ_orders])}/&#10;{fixed [vendor_id],[index]:MEDIAN([placed_order_count])}' />
  </column>
  <column caption='FirstOrder succ%' datatype='real' name='[Calculation_6566107552031481867]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[index]:sum([first_day_successful_order_count])}&#10;/{fixed [vendor_id],[index]:sum([first_day_net_orders])}' />
  </column>
  <column caption='Vendors on CPC' datatype='real' name='[Calculation_6566107552032251917]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_440789845940994055]/COUNTD([vendor_id])' />
  </column>
  <column caption='Vendors on Adrev %' datatype='real' name='[Calculation_6566107552032522254]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_440789845941448713]/COUNTD([vendor_id])' />
  </column>
  <column caption='Vendors on discount' datatype='real' name='[Calculation_6566107552032727055]' role='measure' type='quantitative'>
