lead(active_status,5) over(partition by vendor_id order by index) as m5_active_status,

from output_p1  ) 

where index=0
)


select p1.*, 
coalesce(m0_status,0) as m0_status, 
coalesce(m1_active_status,0) as m1_active_status, 
coalesce(m2_active_status,0) as m2_active_status, 
coalesce(m3_active_status,0) as m3_active_status, 
coalesce(m4_active_status,0) as m4_active_status, 
coalesce(m5_active_status,0) as m5_active_status, 
v.basket_amount_eur,
v.total_spend,
lag(active_status) over(partition by p1.vendor_id order by p1.index) as last_month_active_status
from output_p1 p1 
left join vws_index v on v.vendor_id=p1.vendor_id and v.index=0
join output_p2 p2 on p1.vendor_id=p2.vendor_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
    <metadata-records>
      <metadata-record class='column'>
        <remote-name>vendor_id</remote-name>
        <remote-type>20</remote-type>
        <local-name>[vendor_id]</local-name>
        <parent-name>[Custom SQL Query]</parent-name>
        <remote-alias>vendor_id</remote-alias>
        <local-type>integer</local-type>
        <aggregation>Sum</aggregation>
        <contains-null>true</contains-null>
        <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_7E52BC6491834C26A6B813024FA538DB]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
      </metadata-record>
      <metadata-record class='column'>
