    <field-sort-custom-order field='vendor_active_customers' />
    <field-sort-custom-order field='index' />
    <field-sort-custom-order field='Calculation_440789845986099215' />
    <field-sort-custom-order field='active_status' />
    <field-sort-custom-order field='Calculation_440789845935165441' />
    <field-sort-custom-order field='m0_status' />
    <field-sort-custom-order field='Calculation_6566107553049260049' />
    <field-sort-custom-order field='Calculation_6566107553051983890' />
    <field-sort-custom-order field='m1_active_status' />
    <field-sort-custom-order field='m2_active_status' />
  </field-sort-info>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='Custom SQL Query' id='_7E52BC6491834C26A6B813024FA538DB'>
        <properties context=''>
          <relation connection='bigquery.04k2w321b2rxy919xf0t51nnslb5' name='Custom SQL Query' type='text'><![CDATA[with dineout_logic as
 ( SELECT
     DISTINCT v.vendor_id,
     salesforce_id,
     avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
     avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission
   FROM `tlb-data-prod.data_platform.dim_vendor_info` v
   LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
   ON l.location_id = v.location_id
   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
   ON v.salesforce_id = a.grid__c
   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
   ON a.id = c.accountid
   WHERE 1=1
   AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
   AND c.status = 'Activated'
   AND c.end_date__c IS NULL
   group by 1 ,2
   )
   

   /* 

-- get monthly vendor_id, is_new or not, and acquisition type is not switch 
case when date_diff(month,date_trunc(first_online_date,month),month)=0
and acquisition_business_type<<>>'Switch'
 and is_contracted then vendor_id else null
end as onboarded_m0,

   */
   ,Base as (
   select 
     k.vendor_id,
     k.salesforce_id,
     k.vendor_name, 
     k.chain_id,
     k.chain_name,
     k.country_code,
     is_tpro,
     f.is_managed_by_vendor_helpdesk as is_launchpad,
     f.account_manager_email,
     f.team_leader_email,
     f.account_manager_name,
     f.team_leader_name,
     --f.is_vendor_helpdesk,
     month,
     k.main_cuisine,
     k.is_active,
     k.successful_orders,
     k.m1_successful_orders,
     is_new,
     k.first_online_date, 
     k.first_order_date,
     acquisition_business_type,
     k.vendor_grade,
     ch.group_name,
     date_trunc(k.first_online_date,month) as first_online_month
   from `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` k 
   left join `tlb-data-prod.data_platform.dim_vendor_info` f on k.vendor_id=f.vendor_id
   left join `tlb-data-prod.data_platform.dim_chain` ch on ch.chain_id=k.chain_id
   where k.vertical='Restaurant'
   --and month='2025-09-01'
   and month = date_trunc(current_date - interval '1' day,month) 
   and date_trunc(k.first_online_date,month) >>='2024-10-01'
   and k.country_code <<>> "SA"
   )


,no_dineout as (
select * 
   
   from (
   select b.*, IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag from Base b
     left join dineout_logic c on b.vendor_id=c.vendor_id  
   --where month='2025-05-01'
   --and is_new
   ) 
   where vendor_dineout_flag=False
) 
--- getting the real first order date for winback vendors from fct order info 
,no_dineout_clean as (
select d.*, min(case when first_order_date << first_online_date  then o.order_date end) as win_back_first_order_date
 from no_dineout d 
left join `tlb-data-prod.data_platform.fct_order_info` o 
on d.vendor_id=o.vendor_id and o.is_successful 
and o.order_date >>=d.first_online_date 
--where d.acquisition_business_type='Win Back'

group by all

) 
--sanity check, 
,no_dineout_clean_first_order as (
 select * except(first_order_date,win_back_first_order_date) 
, case when first_order_date << first_online_date  then win_back_first_order_date else first_order_date end as first_order_date
 from no_dineout_clean
 --where onboarded_m0 is not null
 )

/* 
the goal is to take go live month as reference (cohort) 
and check since go live month till current month 
-vendor status 
-vendor orders 
...etc 





*/


,metrics_metadata AS (
     /* Active vendors in December 2024 */
     SELECT
       k.vendor_id,
     IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag,
     k.country_code,
     date_trunc(snapshot_date,month) as month,

     sum(successful_order_count) as succ_orders, 
     sum(gmv_amount_eur) as gmv, 
     sum(vendor_acquisition_customer_count) as new_customers_to_vendors_numbers,
    sum(platform_acquisition_customer_count) as platform_new_customers_to_vendors_numbers,
    sum( IFNULL((cpp_featured_product_revenue_eur),0) +
IFNULL((kwords_revenue_eur),0) +
IFNULL((cpp_revenue_eur),0) +
IFNULL((deal_targeting_revenue_eur),0) +
IFNULL((gem_commission_amount_eur),0) +
--IFNULL((organic_placement_revenue_eur),0) +
IFNULL(display_ads_revenue_eur,0)) ad_rev,
sum(ifnull(cpc_revenue_eur,0)) as cpc,
sum(ifnull(discount_amount_eur,0)) as discount,


--- add here offline time 
sum(offline_duration_in_hours) as offline_duration_in_hours,
sum(schedule_duration_in_hours) as schedule_duration_in_hours,
-- dlp and dld 
max(active_menu_item_count) as active_menu_item_count, 
max(item_with_image_count) as item_with_image_count,
max(item_with_description_count) as item_with_description_count,
-- Engagement vs Impressions 
sum(vendor_list_impression_session_count) as vendor_list_impression_count,
sum(viewed_menu_session_count) as viewed_menu_session_count,
sum(net_order_count) as placed_order_count,
sum(cpc_order_count) as cpc_order_count,
sum(vendor_active_customer_count) as vendor_active_customers,
sum(vendor_list_session_count) as vendor_list_session_count,
sum(case when snapshot_date=date(first_online_date) then schedule_duration_in_hours end) as first_day_schedule_duration_in_hours,
sum(case when snapshot_date=date(first_online_date) then successful_order_count end) as first_day_successful_order_count,
sum(case when snapshot_date=date(first_online_date) then net_order_count end) as first_day_net_orders,





     FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` k
     left join dineout_logic c on k.vendor_id=c.vendor_id  
     left join `tlb-data-prod.data_platform.dim_vendor_info` vf on vf.vendor_id=k.vendor_Id
     WHERE vertical = 'food'
       AND snapshot_date >>= '2024-09-01'  -- December 2024
       and k.country_code <<>> 'SA'
       group by all)

--select * from metrics_metadata
--where vendor_id=36731

/* 
construct the cohort by creating index from snapshot months vs onboarding month 


*/

,vws as (
  
  select 
snapshot_month as month,
w.country_code,
w.vendor_id,
--is_active,
sum(basket_amount_eur) as basket_amount_eur ,
sum(
IFNULL(commission_amount_eur,0) + 
IFNULL(tgo_amount_eur,0) +
IFNULL(featured_product_revenue_eur,0) + 
IFNULL(kwords_search_revenue_eur,0) + 
IFNULL(cpp_monthly_revenue_eur,0) + 
IFNULL(deal_targeting_revenue_eur_excl_vat,0) +
IFNULL(discount_amount_eur,0) + -- discount should not be counted as it's for customer not talabat 
IFNULL(gem_commission_amount_eur,0) + 
IFNULL(organic_placement_revenue_eur,0) +  
IFNULL(cash_fee_eur,0) + 
IFNULL(card_fee_eur,0) + 
IFNULL(vendor_tpro_cost_eur,0)+
IFNULL(display_ads_revenue_eur_excl_vat,0)+
IFNULL(tpro_commission_saving_amount_eur,0)+ -- q 
IFNULL(reward_commission_saving_amount_eur,0)+ -- q 
IFNULL(tpro_discount_amount_eur,0)+ --q 
IFNULL(vendor_reward_cost_eur,0) --q 

) as total_spend,

from `tlb-data-prod.data_platform.agg_vendor_wallet_share_monthly`  w 
left join `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id=w.vendor_id and v.chain_id=w.chain_id
where snapshot_month >>= "2024-09-01"
and vertical = "food"
group by all

)
, vws_index as (


  select base.vendor_id, 
  vws.basket_amount_eur, 
  vws.total_spend, 
  date_diff(vws.month,first_online_month,month) as index,
   from no_dineout_clean_first_order base 
   left join vws  on vws.vendor_id=base.vendor_id 
  and vws.month >>= first_online_month 
)

,output_p1 as (select base.*, 
m.* except(vendor_id,month,country_code,vendor_dineout_flag), 
date_diff(m.month,first_online_month,month) as index,
case when succ_orders >>0 then 1 else 0 end as active_status,


from no_dineout_clean_first_order base
left join metrics_metadata m 
on base.vendor_id=m.vendor_id 
and m.month >>=first_online_month)


,output_p2 as (

  select * from (
select vendor_id,
index,
active_status as m0_status, 
lead(active_status) over(partition by vendor_id order by index) as m1_active_status,
lead(active_status,2) over(partition by vendor_id order by index) as m2_active_status,
lead(active_status,3) over(partition by vendor_id order by index) as m3_active_status,
lead(active_status,4) over(partition by vendor_id order by index) as m4_active_status,
lead(active_status,5) over(partition by vendor_id order by index) as m5_active_status,

from output_p1  ) 

where index=0
)


select p1.*, 
coalesce(m0_status,0) as m0_status, 
coalesce(m1_active_status,0) as m1_active_status, 
coalesce(m2_active_status,0) as m2_active_status, 
coalesce(m3_active_status,0) as m3_active_status, 
coalesce(m4_active_status,0) as m4_active_status, 
coalesce(m5_active_status,0) as m5_active_status, 
v.basket_amount_eur,
v.total_spend,
lag(active_status) over(partition by p1.vendor_id order by p1.index) as last_month_active_status
from output_p1 p1 
left join vws_index v on v.vendor_id=p1.vendor_id and v.index=0
join output_p2 p2 on p1.vendor_id=p2.vendor_id]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
