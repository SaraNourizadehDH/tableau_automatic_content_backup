      <aliases enabled='yes' />
      <column datatype='real' hidden='true' name='[CC Charges]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[COUNT of Order Order Id]' role='measure' type='quantitative' />
      <column caption='Last Month Title' datatype='datetime' hidden='true' name='[Calculation_1541849595632336896]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, TODAY())' />
      </column>
      <column caption='basket_amount_lc_sum_formatted' datatype='string' name='[Calculation_1780329269699592193]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([basket_amount_sum]) &gt;= 1000&#10;THEN STR(ROUND(SUM([basket_amount_sum])/1000, 1)) + &quot;K&quot;&#10;ELSE STR(ROUND(SUM([basket_amount_sum])))&#10;END' />
      </column>
      <column caption='today_date' datatype='date' hidden='true' name='[Calculation_2545800469135384576]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='date_filter_month_current' datatype='boolean' name='[Calculation_2545800469136072705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_year_month] = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1])' />
      </column>
      <column caption='platform_share_text_display' datatype='string' hidden='true' name='[Calculation_2896729396696121344]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4090253666762391552]&#10;THEN &quot;Talabat Share: &quot; + MIN([currency])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='discount_amount_cofunding_platform_lc_sum_display' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_2896729396711813124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4090253666762391552]&#10;THEN SUM([discount_amount_cofunding_platform_lc_sum])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='previous_month' datatype='datetime' name='[Calculation_3279535371054714880]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='show_discount_share' datatype='boolean' hidden='true' name='[Calculation_4090253666762391552]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([discount_amount_cofunding_platform_lc_sum]) &lt;= 0&#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='orders_count_arrow' datatype='string' name='[Calculation_4090253666782294023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([orders_count_perc_diff]) THEN NULL&#10;ELSEIF [orders_count_perc_diff] &gt; 0 THEN &quot;▲&quot;&#10;ELSEIF [orders_count_perc_diff] &lt; 0 THEN &quot;▼&quot;&#10;ELSE &quot;〓&quot;&#10;END' />
      </column>
      <column caption='basket_amount_lc_sum_perc_diff_finance' datatype='real' hidden='true' name='[Calculation_579275546217250822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP((ZN(SUM([SUM of ORDER BASKET VALUE])) - LOOKUP(ZN(SUM([SUM of ORDER BASKET VALUE])), -1)) / ABS(LOOKUP(ZN(SUM([SUM of ORDER BASKET VALUE])), -1)), LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='tip_amount_lc_sum_prev_finance' datatype='real' name='[Calculation_579275546492444688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM(IF [order_year_month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 0, [latest_date_filter])) THEN [tip_amount_lc_sum_finance] ELSE 0 END)&#10;SUM(IF [order_year_month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) THEN [Calculation_6140658135701680143] ELSE 0 END)' />
      </column>
      <column caption='tip_amount_lc_sum_perc_diff_finance_coalesced' datatype='real' name='[Calculation_579275546500657170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(&#10;IF [order_year_month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))&#10;THEN [Calculation_6140658135701680143]&#10;ELSE 0&#10;END) -&#10;[Calculation_579275546492444688]&#10;)/[Calculation_579275546492444688]' />
      </column>
      <column caption='discount_amount_lc_sum_finance' datatype='real' name='[Calculation_6140658135698432006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[SUM of DINEOUT DISCOUNT BY ORDER]' />
      </column>
      <column caption='discount_amount_cofunding_vendor_lc_sum_finance' datatype='real' name='[Calculation_6140658135698644999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6140658135698432006] - [SUM of CO-FUNDING TALABAT&apos;S SHARE BY ORDER]' />
      </column>
      <column caption='tip_amount_lc_sum_finance' datatype='real' name='[Calculation_6140658135701680143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Customer Tips]+[Talabat Cofunded Tips]' />
      </column>
      <column caption='net_payment_to_vendor_lc_sum_finance' datatype='real' name='[Calculation_6140658135712669726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([basket_amount_sum])&#10;- sum([Calculation_6140658135698432006])&#10;+ sum([SUM of CO-FUNDING TALABAT&apos;S SHARE BY ORDER])&#10;+ sum([Calculation_6140658135701680143])&#10;- sum([commission_amount_lc_sum])&#10;- sum([payment_charges_lc_sum])&#10;- sum([others_lc_sum])' />
      </column>
      <column caption='tip_amount_lc_sum_finance_coalesced' datatype='real' name='[Calculation_6623809933494906884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_6140658135701680143]))' />
      </column>
      <column caption='net_payment_to_vendor_lc_sum_finance_coalesced' datatype='real' name='[Calculation_6623809933495681030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(sum([basket_amount_sum]))&#10;- ZN(sum([Calculation_6140658135698432006]))&#10;+ ZN(sum([SUM of CO-FUNDING TALABAT&apos;S SHARE BY ORDER]))&#10;+ ZN(sum([Calculation_6140658135701680143]))&#10;- ZN(sum([commission_amount_lc_sum]))&#10;- ZN(sum([payment_charges_lc_sum]))&#10;- ZN(sum([others_lc_sum]))' />
      </column>
      <column caption='commission_amount_lc_sum_finance' datatype='real' hidden='true' name='[Calculation_6623809933498126345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.00' />
      </column>
