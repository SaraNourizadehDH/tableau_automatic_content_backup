        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query' type='text'><![CDATA[WITH 
  query_params AS (
  SELECT
    CAST('2025-01-01' as DATE) AS start_date, -- DATE_TRUNC(CURRENT_DATE('Asia/Dubai') - INTERVAL 6 MONTH, MONTH),
    CAST(CURRENT_DATE('Asia/Dubai') as DATE) AS end_date,
    4 as decimal_places_percentage,
  ),
  date_series AS (
    SELECT
      *
    FROM
      UNNEST(GENERATE_DATE_ARRAY(
        (SELECT DATE_TRUNC(start_date, MONTH) FROM query_params),
        (SELECT DATE_TRUNC(end_date, MONTH) FROM query_params),
        INTERVAL 1 MONTH
      )) AS order_year_month
  ),
  base AS (
  SELECT
    *
  FROM
    `tlb-data-prod.data_platform.fct_order_info` AS f
  WHERE
    f.is_successful = TRUE
    AND f.is_refunded = FALSE
    AND f.delivery_arrangement = 'TDINE'
    AND f.order_date >>= (SELECT start_date FROM query_params)
    -- AND f.order_date <<= (SELECT end_date FROM query_params)
    AND is_test = FALSE

  ),
  vendor_list AS (
  SELECT
    f.vendor_id
  FROM base f
  UNION distinct
  SELECT
    dvi.vendor_id
  FROM
    `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
  WHERE
    dvi.is_dineout = TRUE 
--   SELECT
--     dvi.vendor_id
--   FROM
--     `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
--   WHERE
--     dvi.vendor_id = 699895
    ),
  cofunding_discounts AS (
  SELECT
    ftcdoi.order_id,
    SUM(ftcdoi.discount_amount_lc) as cofunding_discount_amount_lc_single_order_sum,
    SUM(tdine_tpro_cofunding_platform_amount_lc) as discount_amount_cofunding_platform_lc_sum_single_order_sum,
    -- SUM(tdine_tpro_cofunding_vendor_amount_lc) as discount_amount_cofunding_vendor_lc_single_order_sum,
    SUM(ftcdoi.discount_amount_lc - tdine_tpro_cofunding_platform_amount_lc) as discount_amount_cofunding_vendor_lc_single_order_sum, -- since only cases where talabat cofunds discounts are in fct_tdine_cofunding_discount_order_info, we need to calculate vendor discounts manually

  FROM `tlb-data-prod.data_platform.fct_tdine_cofunding_discount_order_info` AS ftcdoi
  WHERE ftcdoi.is_successful = TRUE
    AND ftcdoi.order_date >>= (SELECT start_date FROM query_params)
    -- AND ftcdoi.order_date <<= (SELECT end_date FROM query_params)
    -- AND is_test = FALSE
  GROUP BY
    ALL ),
  agg_pre AS (
  SELECT
    f.vendor_id,
    DATE_TRUNC(f.order_date, MONTH) AS order_year_month,

    COUNT(DISTINCT f.order_id) AS orders_count,
    SUM(basket_amount_lc) AS basket_amount_sum,
    COUNT(DISTINCT f.account_id) AS users_count,
    
    SUM(f.discount_amount_lc) as discount_amount_lc_sum,
    -- SUM(cd.discount_amount_lc_sum) as cofunding_discount_amount_lc_sum,
    SUM(cd.discount_amount_cofunding_vendor_lc_single_order_sum) as discount_amount_cofunding_vendor_lc_sum,
    SUM(cd.discount_amount_cofunding_platform_lc_sum_single_order_sum) as discount_amount_cofunding_platform_lc_sum,

    SUM(gmv_amount_lc) as gmv_amount_lc_sum,

    SUM(ftwt.tdine_waiter_tip_amount_lc) as tip_customer_amount_lc_sum,
    0 as tip_platform_amount_lc_sum,

    SUM(fb.commission_amount_lc) as commission_amount_lc_sum,
    SUM(COALESCE(fb.credit_card_handling_fee_lc, 0) + COALESCE(fb.debit_card_handling_fee_lc, 0) + COALESCE(fb.talabat_credit_handling_fee_lc, 0)) as payment_charges_lc_sum, --  + COALESCE(fb.cash_handling_fee_lc, 0)
    SUM(fb.net_payment_to_vendor_lc) as net_payment_to_vendor_lc_sum_old,
    0 as others_lc_sum,
  FROM base f
  LEFT JOIN cofunding_discounts cd using (order_id)
  LEFT JOIN `tlb-data-prod.data_platform.fct_tdine_waiter_tips` ftwt on ftwt.order_id=f.order_id and ftwt.is_successful=TRUE
  LEFT JOIN `tlb-data-prod.data_platform.fct_billing` fb on fb.order_id=f.order_id and fb.is_successful=TRUE
  GROUP BY
    ALL
), agg as (
  SELECT 
    ap.*,

    (tip_customer_amount_lc_sum + tip_platform_amount_lc_sum) as tip_amount_lc_sum,
    
    (gmv_amount_lc_sum + discount_amount_cofunding_platform_lc_sum + (tip_customer_amount_lc_sum + tip_platform_amount_lc_sum) - commission_amount_lc_sum - payment_charges_lc_sum - others_lc_sum) as net_payment_to_vendor_lc_sum,

    (net_payment_to_vendor_lc_sum_old + discount_amount_cofunding_platform_lc_sum) as net_payment_to_vendor_lc_sum_old,

  from agg_pre as ap
),
  joined_data AS (
  SELECT
    ds.order_year_month,
    vl.vendor_id,

    COALESCE(a.orders_count, 0) AS orders_count,
    COALESCE(a.basket_amount_sum, 0) AS basket_amount_sum,
    COALESCE(a.users_count, 0) AS users_count,

    COALESCE(a.discount_amount_lc_sum, 0) as discount_amount_lc_sum,
    COALESCE(a.discount_amount_cofunding_vendor_lc_sum, 0) as discount_amount_cofunding_vendor_lc_sum,
    COALESCE(a.discount_amount_cofunding_platform_lc_sum, 0) as discount_amount_cofunding_platform_lc_sum,

    COALESCE(a.gmv_amount_lc_sum, 0) as gmv_amount_lc_sum,

    COALESCE(a.tip_amount_lc_sum, 0) as tip_amount_lc_sum,
    COALESCE(a.tip_customer_amount_lc_sum, 0) as tip_customer_amount_lc_sum,
    COALESCE(a.tip_platform_amount_lc_sum, 0) as tip_platform_amount_lc_sum,

    COALESCE(a.commission_amount_lc_sum, 0) as commission_amount_lc_sum,
    COALESCE(a.net_payment_to_vendor_lc_sum, 0) as net_payment_to_vendor_lc_sum,
    COALESCE(a.payment_charges_lc_sum, 0) as payment_charges_lc_sum,

    COALESCE(a.others_lc_sum, 0) as others_lc_sum,
  FROM
    date_series AS ds
  CROSS JOIN
    vendor_list AS vl
  LEFT JOIN
    agg AS a
  ON
    ds.order_year_month = a.order_year_month
    AND vl.vendor_id = a.vendor_id
    ),
  with_temporal_calc AS (
  SELECT
    *,
    LEAD(orders_count, 1) OVER w AS orders_count_prev,
    LEAD(basket_amount_sum, 1) OVER w AS basket_amount_sum_prev,
    LEAD(users_count, 1) OVER w AS users_count_prev,
    LEAD(tip_amount_lc_sum, 1) OVER w AS tip_amount_lc_sum_prev,
  FROM
    joined_data
  WINDOW
    w AS (
    PARTITION BY
      vendor_id
    ORDER BY
      order_year_month DESC) )
SELECT
--   dvi.vendor_name,
  wtc.*,

  ROUND( (orders_count - orders_count_prev) / NULLIF(orders_count_prev, 0), (SELECT decimal_places_percentage from query_params)) AS orders_count_perc_diff,
  ROUND( (basket_amount_sum - basket_amount_sum_prev) / NULLIF(basket_amount_sum_prev, 0), (SELECT decimal_places_percentage from query_params)) AS basket_amount_sum_perc_diff,
  ROUND( (users_count - users_count_prev) / NULLIF(users_count_prev, 0), (SELECT decimal_places_percentage from query_params)) AS users_count_perc_diff,
  ROUND( (tip_amount_lc_sum - tip_amount_lc_sum_prev) / NULLIF(tip_amount_lc_sum_prev, 0), (SELECT decimal_places_percentage from query_params)) AS tip_amount_lc_sum_perc_diff,

FROM
  with_temporal_calc wtc
-- LEFT JOIN
--   `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
-- USING
--   (vendor_id)
-- limit 1]]></relation>
