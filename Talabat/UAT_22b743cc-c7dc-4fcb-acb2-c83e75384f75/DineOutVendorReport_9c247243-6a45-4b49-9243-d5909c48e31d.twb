          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query1' type='text'>with vendor_list as (
    SELECT
        f.vendor_id
    FROM
        `tlb-data-prod.data_platform.fct_order_info` AS f
    WHERE
        f.is_successful = TRUE
        AND f.delivery_arrangement = &apos;TDINE&apos;
    GROUP BY ALL
UNION ALL
    SELECT
        dvi.vendor_id
    FROM
        `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    WHERE
        dvi.is_dineout = TRUE
    GROUP BY ALL
) 
SELECT
    v.vendor_id, dvi.vendor_name, dv.logo_url, dci.country, dvi.chain_id, dc.chain_name
FROM
    vendor_list as v
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dvi using (vendor_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor` dv using (vendor_id)
LEFT JOIN `tlb-data-prod.data_platform.dim_country_info` dci using (country_code)
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc on dc.chain_id = dvi.chain_id
GROUP BY ALL</relation>
          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query2' type='text'>SELECT
    DISTINCT dci.country, dci.currency
FROM `tlb-data-prod.data_platform.dim_country_info` dci</relation>
