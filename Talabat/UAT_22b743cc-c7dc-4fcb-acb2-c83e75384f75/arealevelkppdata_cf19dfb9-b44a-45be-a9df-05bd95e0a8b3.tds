  <column caption='Vendors' datatype='integer' name='[Calculation_3380303367886020613]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([vendor_id])' />
  </column>
  <column caption='Chains' datatype='integer' name='[Calculation_3380303367948025862]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if ({FIXED [chain_id], [order_month] : sum([successful_orders]) &gt; 0 }) = true then [chain_id] end' />
  </column>
  <column caption='Metric' datatype='real' name='[Calculation_3380303367950565383]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &quot;GMV&quot; then sum([gmv_eur_amount_total])&#10;elseif [Parameters].[Parameter 5] = &quot;Orders&quot; then sum([successful_orders])&#10;ELSEIF [Parameters].[Parameter 5] = &quot;New customers to platform&quot; then sum([platform_new_customers])&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Vendors&quot; then (COUNTD([vendor_id]))&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Chains&quot; then (COUNTD([Calculation_3380303367948025862]))&#10;end' />
  </column>
  <column caption='Dimension 1' datatype='string' name='[Calculation_3380303367956877320]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &quot;Vendor&quot; then [vendor_name]&#10;ELSEIF [Parameters].[Parameter 6] = &quot;Area&quot; then [area_name]&#10;ELSEIF [Parameters].[Parameter 6] = &quot;Cuisine&quot; then [main_cuisine]&#10;else &quot;None&quot;&#10;end' />
  </column>
  <column caption='AOF' datatype='real' name='[Calculation_3380303367968768014]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([successful_orders]) / sum([active_customers])' />
  </column>
  <column caption='KPP Segments' datatype='string' name='[Calculation_5343732103150493724]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if  [kpp_segment] in (&quot; Healthy acquisition drivers&quot;,&quot; Retention drivers&quot;) then &quot;Champions&quot;&#10;else &quot;Others&quot; end' />
  </column>
  <column caption='KPP Champion Orders' datatype='integer' name='[Champion GMV (copy)_5722738185831858180]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Calculation_5343732103150493724] = &quot;Champions&quot; and [is_exclusive] = true then [successful_orders] end' />
  </column>
  <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_3380303367957217292]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Dimension 1 (copy)_3380303367957114889] = &quot;Vendor&quot; then [vendor_name]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3380303367957114889] = &quot;Area&quot; then [area_name]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3380303367957114889] = &quot;Cuisine&quot; then [main_cuisine]&#10;else &quot;None&quot;&#10;end' />
