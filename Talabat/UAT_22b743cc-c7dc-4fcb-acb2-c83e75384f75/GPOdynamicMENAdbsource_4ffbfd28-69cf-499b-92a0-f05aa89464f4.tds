  <aliases enabled='yes' />
  <column caption='Distance (Km)' datatype='string' name='[Calculation_1455788627201081344]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [travel_time_distance_km]&lt;5 THEN &quot;&lt;5&quot;&#13;&#10;ELSEIF  [travel_time_distance_km]&gt;5 AND [travel_time_distance_km]&lt;10 THEN &quot;&lt;10&quot;&#13;&#10;ELSEIF [travel_time_distance_km]&gt;10 AND [travel_time_distance_km] &lt;15 THEN &quot;&lt;15&quot;&#13;&#10;ELSE &quot;&gt;15&quot;&#13;&#10;END' />
  </column>
  <column caption='Profit' datatype='string' name='[Calculation_1455788627202195457]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Calculation_1455788627327406082]&lt;-2 THEN &quot;&lt; -2&quot;&#13;&#10;ELSEIF  [Calculation_1455788627327406082]&gt;=-2 AND [Calculation_1455788627327406082]&lt;-1 THEN &quot;&lt; -1&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082]&gt;=-1 AND [Calculation_1455788627327406082]&lt;-0.5 THEN &quot;&lt; -0.5&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082]&gt;=-0.5 AND [Calculation_1455788627327406082] &lt;0 THEN &quot;&lt; 0&quot;&#13;&#10;ELSEIF  [Calculation_1455788627327406082]=0 THEN &quot;0&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082]&gt;0 AND [Calculation_1455788627327406082] &lt;0.5 THEN &quot;&lt; 0.5&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082]&gt;=0.5 AND [Calculation_1455788627327406082] &lt; 1 THEN &quot;&lt; 1&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082]&gt;=1 AND  [Calculation_1455788627327406082] &lt;2 THEN &quot;&lt; 2&quot;&#13;&#10;ELSE &quot;&gt;2&quot;&#13;&#10;END' />
  </column>
  <column caption='profit_cur' datatype='real' name='[Calculation_1455788627327406082]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1]=&apos;euro&apos; THEN [dps_profit_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1]=&apos;LC&apos; THEN [dps_profit_local]&#13;&#10;END' />
  </column>
  <column caption='gfv_cur' datatype='real' name='[Calculation_1455788627329843203]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1]=&apos;euro&apos; THEN [gfv_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1]=&apos;LC&apos; THEN [gfv_local]&#13;&#10;END' />
  </column>
  <column caption='afv bin' datatype='string' name='[Calculation_1455788627331100677]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Calculation_1455788627329843203]&lt;1 THEN &quot;&lt;1&quot;&#13;&#10;ELSEIF  [Calculation_1455788627329843203]&gt;1 AND [Calculation_1455788627329843203]&lt;3 THEN &quot;&lt;3&quot;&#13;&#10;ELSEIF [Calculation_1455788627329843203]&gt;3 AND [Calculation_1455788627329843203] &lt;6 THEN &quot;&lt;6&quot;&#13;&#10;ELSEIF [Calculation_1455788627329843203]&gt;6 AND [Calculation_1455788627329843203] &lt;12 THEN &quot;&lt;12&quot;&#13;&#10;ELSEIF [Calculation_1455788627329843203]&gt;12 AND [Calculation_1455788627329843203] &lt;15 THEN &quot;&lt;15&quot;&#13;&#10;ELSE &quot;&gt;15&quot;&#13;&#10;END' />
  </column>
  <column caption='Average Profit' datatype='real' name='[Calculation_1986368924242989056]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([Calculation_1455788627327406082])' />
  </column>
  <column caption='Standard Deviation of Profit' datatype='real' name='[Calculation_1986368924243099649]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='STDEV([Calculation_1455788627327406082])' />
  </column>
  <column caption='Dynamic Profit Bin' datatype='string' name='[Calculation_1986368924243161090]' role='measure' type='nominal'>
    <calculation class='tableau' formula='IF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt;= -3 * STDEV([Calculation_1455788627327406082]) AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &lt; -2 * STDEV([Calculation_1455788627327406082]) THEN  &quot;Between &quot; + STR(-3 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(-2 * STDEV([Calculation_1455788627327406082])) &#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt;= -2 * STDEV([Calculation_1455788627327406082]) AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])})&lt; -1 * STDEV([Calculation_1455788627327406082]) THEN  &quot;Between &quot; + STR(-2 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(-1 * STDEV([Calculation_1455788627327406082]))&#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt;= -1 * STDEV([Calculation_1455788627327406082]) AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])})&lt; 0 THEN &quot;Between &quot; + STR(-1 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(-0 * STDEV([Calculation_1455788627327406082]))&#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) = 0 THEN &quot;0&quot;&#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt; 0 AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &lt;= STDEV([Calculation_1455788627327406082]) THEN &quot;Between &quot; + STR(0 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(1 * STDEV([Calculation_1455788627327406082]))&#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt; STDEV([Calculation_1455788627327406082]) AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &lt;= 2 * STDEV([Calculation_1455788627327406082]) THEN &quot;Between &quot; + STR(1 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(2 * STDEV([Calculation_1455788627327406082]))&#13;&#10;ELSEIF MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &gt; 2 * STDEV([Calculation_1455788627327406082]) AND MIN({FIXED[platform_order_code]:sum( [Calculation_1455788627327406082])}) &lt;= 3 * STDEV([Calculation_1455788627327406082]) THEN &quot;Between &quot; + STR(2 * STDEV([Calculation_1455788627327406082])) + &quot; and &quot; + STR(3 * STDEV([Calculation_1455788627327406082]))&#13;&#10;ELSE &quot;Outside 3 Std. Deviation&quot;&#13;&#10;END' />
  </column>
  <column caption='stdev_profit_cur' datatype='real' name='[Calculation_1986368924353462276]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1]=&apos;euro&apos; THEN [stdev_profit_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1]=&apos;LC&apos; THEN [stdev_profit_local]&#13;&#10;END' />
  </column>
  <column caption='Dynamic Profit Bin test' datatype='string' name='[Dynamic Profit Bin (copy)_1986368924341186563]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Calculation_1455788627327406082] &gt;= -3 * [Calculation_1986368924353462276] AND [Calculation_1455788627327406082] &lt; -2 * [Calculation_1986368924353462276] THEN  &#13;&#10;    &quot;Between &quot; + STR(-3 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(-2 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] &gt;= -2 * [Calculation_1986368924353462276] AND [Calculation_1455788627327406082] &lt; -1 * [Calculation_1986368924353462276] THEN  &#13;&#10;    &quot;Between &quot; + STR(-2 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(-1 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] &gt;= -1 * [Calculation_1986368924353462276] AND [Calculation_1455788627327406082] &lt; 0 THEN &#13;&#10;    &quot;Between &quot; + STR(-1 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(-0 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] = 0 THEN &#13;&#10;    &quot;0&quot;&#13;&#10;ELSEIF [Calculation_1455788627327406082] &gt; 0 AND [Calculation_1455788627327406082] &lt;= [Calculation_1986368924353462276] THEN &#13;&#10;    &quot;Between &quot; + STR(0 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(1 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] &gt; [Calculation_1986368924353462276] AND [Calculation_1455788627327406082] &lt;= 2 * [Calculation_1986368924353462276] THEN &#13;&#10;    &quot;Between &quot; + STR(1 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(2 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] &gt; 2 * [Calculation_1986368924353462276] AND [Calculation_1455788627327406082] &lt;= 3 * [Calculation_1986368924353462276] THEN &#13;&#10;    &quot;Between &quot; + STR(2 * [Calculation_1986368924353462276]) + &quot; and &quot; + STR(3 * [Calculation_1986368924353462276])&#13;&#10;ELSEIF [Calculation_1455788627327406082] &lt; -3 * [Calculation_1986368924353462276] THEN &quot;Less than&quot; +STR(-3 * [Calculation_1986368924353462276])&#13;&#10;ELSE &#13;&#10;    &quot;greater than&quot; +STR(3 * [Calculation_1986368924353462276])&#13;&#10;END' />
  </column>
  <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_04E41C009B274D999987D08EAC3ACDA2]' role='measure' type='quantitative' />
  <group caption='Action (Profit,afv bin)' hidden='true' name='[Action (Profit,afv bin)]' name-style='unqualified' user:auto-column='sheet_link'>
    <groupfilter function='crossjoin'>
      <groupfilter function='level-members' level='[Calculation_1455788627202195457]' />
      <groupfilter function='level-members' level='[Calculation_1455788627331100677]' />
    </groupfilter>
  </group>
  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
  </semantic-values>
  <datasource-dependencies datasource='Parameters'>
    <column caption='Currency' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
      <calculation class='tableau' formula='&quot;LC&quot;' />
      <members>
        <member value='&quot;euro&quot;' />
        <member value='&quot;LC&quot;' />
      </members>
    </column>
  </datasource-dependencies>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='Custom SQL Query' id='_04E41C009B274D999987D08EAC3ACDA2'>
        <properties context=''>
          <relation connection='bigquery.1itn1pf1gsslgm1eh5xs30rcystp' name='Custom SQL Query' type='text'>with dpsa as (SELECT DISTINCT entity_id,dpsa.id id,dpsa.name name&#13;
				FROM `fulfillment-dwh-production.curated_data_shared.dps_vendor_asa_config_versions`,&#13;
				UNNEST(`dps_automatic_assignment_history`) dpsa&#13;
				WHERE dpsa.active_to IS NULL&#13;
				 ),&#13;
details as (&#13;
            select  dps.entity_id,&#13;
                    dps.created_date_local, &#13;
                    dps.platform_order_code,&#13;
&#13;
                    dps.vertical_type,&#13;
                    dpsa.name asa_name,&#13;
                    dps.scheme_id,&#13;
                    configs.scheme_name,&#13;
                    dps.vendor_price_scheme_type,&#13;
                    dps.dps_minimum_order_value_local as mov,&#13;
                   -- stddev(avg(cast(dps.profit_local  as FLOAT64))) OVER () stdev_profit_local,&#13;
                    --stddev(avg(cast(dps.profit_eur  as FLOAT64))) OVER () stdev_profit_eur,&#13;
                    avg(cast(dps.delivery_fee_local  as FLOAT64)) as paid_delivery_fee_local,&#13;
                    avg(cast(dps.dps_delivery_fee_local  as FLOAT64)) as dps_delivery_fee_local,&#13;
                    avg(round(cast(dps.profit_local  as FLOAT64),2)) as dps_profit_local,&#13;
                    avg(round(cast(dps.profit_eur  as FLOAT64),2)) as dps_profit_eur,&#13;
                    avg(cast(dps.gfv_local as FLOAT64)) as gfv_local,&#13;
                    avg(cast(dps.gfv_eur as FLOAT64)) as gfv_eur,&#13;
                    avg(dps.travel_time_distance_km) as travel_time_distance_km,&#13;
&#13;
&#13;
            from `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps&#13;
            left join `fulfillment-dwh-production.curated_data_shared.pricing_configuration_versions` configs &#13;
            on configs.scheme_id = dps.scheme_id &#13;
            and configs.country_code = dps.country_code&#13;
            LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` bta&#13;
    ON dps.platform_order_code = CAST(bta.order_id AS STRING) AND lower(dps.country_code) = lower(bta.country_Code)                                                      &#13;
            left join `tlb-data-prod.data_platform.dim_location_info` loc&#13;
            ON bta.delivery_area_id=loc.area_id&#13;
            left join dpsa&#13;
            ON dpsa.id=dps.assignment_id&#13;
            and dpsa.entity_id=dps.entity_id&#13;
            where dps.created_date_local between DATE_ADD(CURRENT_DATE(), INTERVAL -30 DAY) and CURRENT_DATE()&#13;
            and dps.is_own_delivery&#13;
          --  and configs.entity_id = &quot;TB_KW&quot; &#13;
          -- and dps.entity_id = &quot;TB_KW&quot;&#13;
          -- and loc.country_code=&quot;KW&quot;&#13;
            and lower(dps.delivery_status) = &apos;completed&apos;&#13;
            and configs.scheme_active_to is null&#13;
         --   and assignment_id=128&#13;
&#13;
            group by 1,2,3,4,5,6,7,8,9) ,&#13;
&#13;
         std_dev as ( select entity_id,ROUND(STDDEV_POP(dps_profit_local),2) stdev_profit_local,ROUND(STDDEV_POP(dps_profit_eur),2) stdev_profit_eur from details&#13;
         group by 1)&#13;
            &#13;
           SELECT *&#13;
           FROM details&#13;
           LEFT JOIN std_dev&#13;
           using(entity_id)</relation>
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
