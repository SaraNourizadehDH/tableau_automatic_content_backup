    <named-connections>
      <named-connection caption='BigQuery' name='bigquery.1itn1pf1gsslgm1eh5xs30rcystp'>
        <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground_regional_pricing' server-oauth='server-custom' username='elijah.paul@talabat.com' workgroup-auth-mode='prompt' />
      </named-connection>
    </named-connections>
    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1itn1pf1gsslgm1eh5xs30rcystp' name='Custom SQL Query' type='text'>with dpsa as (SELECT DISTINCT entity_id,dpsa.id id,dpsa.name name&#13;
				FROM `fulfillment-dwh-production.curated_data_shared.dps_vendor_asa_config_versions`,&#13;
				UNNEST(`dps_automatic_assignment_history`) dpsa&#13;
				WHERE dpsa.active_to IS NULL&#13;
				 ),&#13;
details as (&#13;
            select  dps.entity_id,&#13;
                    dps.created_date_local, &#13;
                    dps.platform_order_code,&#13;
&#13;
                    dps.vertical_type,&#13;
                    dpsa.name asa_name,&#13;
                    dps.scheme_id,&#13;
                    configs.scheme_name,&#13;
                    dps.vendor_price_scheme_type,&#13;
                    dps.dps_minimum_order_value_local as mov,&#13;
                   -- stddev(avg(cast(dps.profit_local  as FLOAT64))) OVER () stdev_profit_local,&#13;
                    --stddev(avg(cast(dps.profit_eur  as FLOAT64))) OVER () stdev_profit_eur,&#13;
                    avg(cast(dps.delivery_fee_local  as FLOAT64)) as paid_delivery_fee_local,&#13;
                    avg(cast(dps.dps_delivery_fee_local  as FLOAT64)) as dps_delivery_fee_local,&#13;
                    avg(round(cast(dps.profit_local  as FLOAT64),2)) as dps_profit_local,&#13;
                    avg(round(cast(dps.profit_eur  as FLOAT64),2)) as dps_profit_eur,&#13;
                    avg(cast(dps.gfv_local as FLOAT64)) as gfv_local,&#13;
                    avg(cast(dps.gfv_eur as FLOAT64)) as gfv_eur,&#13;
                    avg(dps.travel_time_distance_km) as travel_time_distance_km,&#13;
&#13;
&#13;
            from `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps&#13;
            left join `fulfillment-dwh-production.curated_data_shared.pricing_configuration_versions` configs &#13;
            on configs.scheme_id = dps.scheme_id &#13;
            and configs.country_code = dps.country_code&#13;
            LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` bta&#13;
    ON dps.platform_order_code = CAST(bta.order_id AS STRING) AND lower(dps.country_code) = lower(bta.country_Code)                                                      &#13;
            left join `tlb-data-prod.data_platform.dim_location_info` loc&#13;
            ON bta.delivery_area_id=loc.area_id&#13;
            left join dpsa&#13;
            ON dpsa.id=dps.assignment_id&#13;
            and dpsa.entity_id=dps.entity_id&#13;
            where dps.created_date_local between DATE_ADD(CURRENT_DATE(), INTERVAL -30 DAY) and CURRENT_DATE()&#13;
            and dps.is_own_delivery&#13;
          --  and configs.entity_id = &quot;TB_KW&quot; &#13;
          -- and dps.entity_id = &quot;TB_KW&quot;&#13;
          -- and loc.country_code=&quot;KW&quot;&#13;
            and lower(dps.delivery_status) = &apos;completed&apos;&#13;
            and configs.scheme_active_to is null&#13;
         --   and assignment_id=128&#13;
&#13;
            group by 1,2,3,4,5,6,7,8,9) ,&#13;
&#13;
         std_dev as ( select entity_id,ROUND(STDDEV_POP(dps_profit_local),2) stdev_profit_local,ROUND(STDDEV_POP(dps_profit_eur),2) stdev_profit_eur from details&#13;
         group by 1)&#13;
            &#13;
           SELECT *&#13;
           FROM details&#13;
           LEFT JOIN std_dev&#13;
           using(entity_id)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1itn1pf1gsslgm1eh5xs30rcystp' name='Custom SQL Query' type='text'>with dpsa as (SELECT DISTINCT entity_id,dpsa.id id,dpsa.name name&#13;
