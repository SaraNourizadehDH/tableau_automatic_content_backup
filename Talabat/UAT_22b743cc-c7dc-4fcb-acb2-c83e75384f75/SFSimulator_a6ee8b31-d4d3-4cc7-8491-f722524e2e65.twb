              <calculation class='tableau' formula='SUM((IF  [service_fee_type] = &quot;Percentage&quot; THEN &#13;&#10;MIN([max_cap], MAX([min_cap], ([service_fee]/100)*[avg_afv])) &#13;&#10;ELSE [avg_sf]&#13;&#10;END) * [total_orders]) /SUM([total_orders])' />
            </column>
            <column caption='Min Cap Orders%' datatype='real' name='[Calculation_1664924492172488708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( (IF  ([service_fee]/100)*[avg_afv] &lt;= [min_cap] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
            </column>
            <column caption='SF Actual' datatype='real' name='[Calculation_560698158489427968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_sf]*[total_orders])/SUM([total_orders])' />
            </column>
            <column caption='Max Cap Orders%' datatype='real' name='[Min Cap Orders% (copy)_1664924492173299717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( (IF  ([service_fee]/100)*[avg_afv] &gt;=  [max_cap] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
            </column>
            <column caption='AFV ' datatype='real' name='[SF Actual (copy)_1664924492158775296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_afv]*[total_orders])/SUM([total_orders])' />
            </column>
