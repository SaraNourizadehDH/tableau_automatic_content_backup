      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1fhsgup1fvl9g91ejgni2043rs01].[pcto:sum:total_orders:qk:2]&quot;' value='% of Total Orders' />
          <alias key='&quot;[federated.1fhsgup1fvl9g91ejgni2043rs01].[usr:Calculation_1664924492158980097:qk]&quot;' value='SF Actual%' />
        </aliases>
      </column>
      <column caption='SF Change' datatype='real' name='[Calculation_1014154347403862021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SF Theoritical (copy)_1014154347030933505]-[Calculation_1664924492159508482]' />
      </column>
      <column caption='Revenue Change' datatype='real' name='[Calculation_1014154347411140616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1014154347403862021]* SUM([total_orders])' />
      </column>
      <column caption='SF%' datatype='real' name='[Calculation_1664924492158980097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_560698158489427968]/[SF Actual (copy)_1664924492158775296]' />
      </column>
      <column caption='Current SF Simulated' datatype='real' name='[Calculation_1664924492159508482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((IF  [service_fee_type] = &quot;Percentage&quot; THEN &#13;&#10;MIN([max_cap], MAX([min_cap], ([service_fee]/100)*[avg_afv])) &#13;&#10;ELSE [avg_sf]&#13;&#10;END) * [total_orders]) /SUM([total_orders])' />
      </column>
      <column caption='Min Cap Orders%' datatype='real' name='[Calculation_1664924492172488708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( (IF  ([service_fee]/100)*[avg_afv] &lt;= [min_cap] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
      </column>
      <column caption='SF Actual' datatype='real' name='[Calculation_560698158489427968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_sf]*[total_orders])/SUM([total_orders])' />
      </column>
      <column caption='New Max Cap Orders%' datatype='real' name='[Max Cap Orders% (copy)_1014154347033124868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( (IF  ([Parameters].[Max Cap Orders% Parameter]/100)*[avg_afv] &gt;=  [Parameters].[Max Cap Orders% Parameter 2] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
      </column>
      <column caption='New Min Cap Orders%' datatype='real' name='[Min Cap Orders% (copy)_1014154347032895491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( (IF  ([Parameters].[Max Cap Orders% Parameter]/100)*[avg_afv] &lt;= [Parameters].[Min Cap Orders% Parameter] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Max Cap Orders%' datatype='real' name='[Min Cap Orders% (copy)_1664924492173299717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( (IF  ([service_fee]/100)*[avg_afv] &gt;=  [max_cap] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
      </column>
      <column caption='AFV ' datatype='real' name='[SF Actual (copy)_1664924492158775296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_afv]*[total_orders])/SUM([total_orders])' />
      </column>
      <column caption='SF Simulated' datatype='real' name='[SF Theoritical (copy)_1014154347030933505]' role='measure' type='quantitative'>
