      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1fhsgup1fvl9g91ejgni2043rs01' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='New Max Cap ' datatype='real' name='[Max Cap Orders% Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='3.9'>
              <calculation class='tableau' formula='3.9' />
            </column>
            <column caption='New SF' datatype='real' name='[Max Cap Orders% Parameter]' param-domain-type='any' role='measure' type='quantitative' value='5.'>
              <calculation class='tableau' formula='5.' />
            </column>
            <column caption='New Min Cap' datatype='real' name='[Min Cap Orders% Parameter]' param-domain-type='any' role='measure' type='quantitative' value='0.9'>
              <calculation class='tableau' formula='0.9' />
            </column>
            <column caption='New SF Type' datatype='string' name='[SF% Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
              <calculation class='tableau' formula='&quot;Percentage&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fhsgup1fvl9g91ejgni2043rs01'>
            <column caption='SF Change' datatype='real' name='[Calculation_1014154347403862021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SF Theoritical (copy)_1014154347030933505]-[Calculation_1664924492159508482]' />
            </column>
            <column caption='Revenue Change' datatype='real' name='[Calculation_1014154347411140616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1014154347403862021]* SUM([total_orders])' />
            </column>
            <column caption='Current SF Simulated' datatype='real' name='[Calculation_1664924492159508482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((IF  [service_fee_type] = &quot;Percentage&quot; THEN &#13;&#10;MIN([max_cap], MAX([min_cap], ([service_fee]/100)*[avg_afv])) &#13;&#10;ELSE [avg_sf]&#13;&#10;END) * [total_orders]) /SUM([total_orders])' />
            </column>
            <column caption='New Max Cap Orders%' datatype='real' name='[Max Cap Orders% (copy)_1014154347033124868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( (IF  ([Parameters].[Max Cap Orders% Parameter]/100)*[avg_afv] &gt;=  [Parameters].[Max Cap Orders% Parameter 2] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
            </column>
            <column caption='New Min Cap Orders%' datatype='real' name='[Min Cap Orders% (copy)_1014154347032895491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( (IF  ([Parameters].[Max Cap Orders% Parameter]/100)*[avg_afv] &lt;= [Parameters].[Min Cap Orders% Parameter] &#13;&#10;THEN 1 ELSE 0 END)*[total_orders]) / SUM([total_orders])' />
            </column>
            <column caption='AFV ' datatype='real' name='[SF Actual (copy)_1664924492158775296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_afv]*[total_orders])/SUM([total_orders])' />
            </column>
            <column caption='SF Simulated' datatype='real' name='[SF Theoritical (copy)_1014154347030933505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((IF  [Parameters].[SF% Parameter] = &quot;Percentage&quot; THEN &#13;&#10;MIN([Parameters].[Max Cap Orders% Parameter 2], MAX([Parameters].[Min Cap Orders% Parameter], ([Parameters].[Max Cap Orders% Parameter]/100)*[avg_afv])) &#13;&#10;ELSE [Parameters].[Max Cap Orders% Parameter]&#13;&#10;END) * [total_orders]) /SUM([total_orders])' />
            </column>
            <column caption='SF Simulated%' datatype='real' name='[SF% (copy)_1014154347032375298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SF Theoritical (copy)_1014154347030933505]/[SF Actual (copy)_1664924492158775296]' />
            </column>
            <column datatype='real' name='[avg_afv]' role='measure' type='quantitative' />
