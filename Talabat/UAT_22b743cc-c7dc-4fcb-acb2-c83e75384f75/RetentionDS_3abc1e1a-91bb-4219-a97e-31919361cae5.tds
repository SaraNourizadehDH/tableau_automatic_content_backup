    <calculation class='tableau' formula='([Vendor List Impressions (copy)_6208141725429690389])/[Calculation_6208141725433856025]' />
  </column>
  <column caption='Is AM assigned ?' datatype='string' hidden='true' name='[Calculation_2010435084048855040]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if attr([account_manager_name]) = attr(([federated.0bpjchr0efcgdu1eyt0kj1vxarw4].[owner_name])) then &quot;Not assigned&quot; else &quot;AM assigned&quot; end' />
  </column>
  <column caption='Churn Reason' datatype='string' name='[Calculation_2697374743083323392]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([is_contract_terminated]) then &apos;contract terminated&apos; &#10;ELSEIF [is_contract_terminated]=False and [is_hidden]=True then &apos;Hidden&apos; &#10;ELSEIF [is_contract_terminated]=False and [is_hidden]=False &#10;and [Calculation_366128613318803459]=&apos;High&apos; then &apos;High offline time&apos; &#10;&#10;ELSEIF [is_contract_terminated]=False and [is_hidden]=False &#10;and [Calculation_366128613318803459]=&apos;Low&apos; &#10;and [Calculation_366128613320376325]&#10; then &apos;Drop in menu sessions&apos;&#10;&#10;&#10;ELSEIF [is_contract_terminated]=False and [is_hidden]=False &#10;and [Calculation_366128613318803459]=&apos;Low&apos; &#10;and [Calculation_366128613320376325]=False&#10;and [Drop in Menu sessions (copy)_2697374743085350915]&#10; then &apos;Drop in conversion&apos;&#10;Else &apos;Drop in conversion&apos;&#10; &#10;&#10;END' />
  </column>
  <column caption='Days from onboarding' datatype='integer' hidden='true' name='[Calculation_3297971978520670208]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[first_online_date],[Calculation_3297971978528587779])' />
  </column>
  <column caption='Months frm onb vs rep month' datatype='integer' hidden='true' name='[Calculation_3297971978521825282]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[first_online_date],[month])' />
  </column>
  <column caption='Yesterday' datatype='date' hidden='true' name='[Calculation_3297971978528587779]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='TODAY() - 1' />
  </column>
  <column caption='coldstart deno' datatype='integer' hidden='true' name='[Calculation_3297971978529701893]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_3297971978521825282] = 1 and  [Calculation_3297971978520670208] &gt;= 30 then [vendor_id] &#10;//ELSEIF [Months frm onb vs yesterday] &gt; 1 and [Months frm onb vs rep month] = 1 then [vendor_id]&#10;end' />
  </column>
  <column caption='M-1 VWS' datatype='real' name='[Calculation_366128613306228736]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id]:sum([last_month_total_spend])}/ {fixed [vendor_id]: sum([last_month_basket_amount_eur])}' />
  </column>
  <column caption='3 months avg VWS segment' datatype='string' name='[Calculation_366128613308219393]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([Calculation_1094796961382776834]) &gt;=0.35 then &apos;High VWS (&gt;35%)&apos; &#10;else &apos;Low VWS&apos; END' />
  </column>
  <column caption='3 months  orders segment' datatype='string' name='[Calculation_366128613309001730]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([Calculation_1094796961383694340]) &gt;=100 then &apos;High Orders (&gt;=100)&apos; &#10;else &apos;Low Orders&apos; END' />
  </column>
  <column caption='High Offline time (&gt;50%)' datatype='string' name='[Calculation_366128613318803459]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([Calculation_593701131676758020]) &gt;=0.5 then &apos;High&apos; else &apos;Low&apos; END' />
  </column>
  <column caption='avg M0 viewed menu sessions ' datatype='real' name='[Calculation_366128613319315460]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([viewed_menu_session_count]) / &#10;IF DATETRUNC(&apos;month&apos;, TODAY()) = [month]&#10;THEN DAY(TODAY() -1 )&#10;ELSE 30&#10;END' />
  </column>
  <column caption='Drop in Menu sessions' datatype='boolean' name='[Calculation_366128613320376325]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([Calculation_366128613319315460]) &lt; ([last_month_viewed_menu_session_count]/30) then True else False end' />
  </column>
  <column caption='Online but 0 conversion' datatype='boolean' name='[Calculation_366128613321142278]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([is_contract_terminated])=False &#10;and [is_hidden]=False &#10;and [viewed_menu_session_count] &gt;0 &#10;and [placed_order_count]=0 then True else False end' />
  </column>
  <column caption='High offline Vendors +50%' datatype='integer' name='[Calculation_366128613335773192]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD (if([Calculation_366128613318803459]=&apos;High&apos;) then [vendor_id] else null end)' />
  </column>
  <column caption='DLP' datatype='real' name='[Calculation_366128613336600585]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed vendor_id,[Calculation_1094796961416204294]:sum([index_item_with_image_count])} &#10;/{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_active_menu_item_count])}' />
  </column>
  <column caption='DLD' datatype='real' name='[Calculation_366128613336752138]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed vendor_id,[Calculation_1094796961416204294]:max([index_item_with_description_count])} &#10;/{fixed [vendor_id],[Calculation_1094796961416204294]:max([index_active_menu_item_count])}' />
  </column>
  <column caption='vendors on cpc' datatype='integer' name='[Calculation_366128613337419787]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD (if([index_cpc])&gt;0 then [vendor_id] else null end)' />
  </column>
  <column caption='vendors on disc' datatype='integer' name='[Calculation_366128613337591820]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD (if([index_discount])&gt;0 and ISNULL([index_discount])=False then [vendor_id] else null end)' />
  </column>
  <column caption='Index VWS' datatype='real' name='[Calculation_366128613338562573]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_total_spend])}/ &#10;{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_basket_amount_eur])}' />
  </column>
  <column caption='M0 VWS segment' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_366128613338775566]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([Calculation_366128613338562573]) &gt;=0.35 then &apos;High VWS (&gt;35%)&apos; &#10;else &apos;Low VWS&apos; END' />
  </column>
  <column caption='vendors with high vws 35%' datatype='integer' name='[Calculation_366128613339881488]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='countd (if([Calculation_366128613338562573])&gt;=0.35 then [vendor_id] else null end)' />
  </column>
  <column caption='Success Rate %' datatype='real' name='[Calculation_366128613344165905]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_succ_orders])}&#10;/{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_placed_order_count])}' />
  </column>
  <column caption='median Scheduled Hours ' datatype='real' name='[Calculation_366128613345017874]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[Calculation_1094796961416204294]:MEDIAN([index_schedule_duration_in_hours])}' />
  </column>
  <column caption='Vendors with &lt;4 hours schedule' datatype='integer' name='[Calculation_366128613345230867]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD (if([Calculation_366128613345017874])&lt;4 then [vendor_id] else null end)' />
  </column>
  <column caption='Vendors orders segment' datatype='string' name='[Calculation_366128613345726484]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [succ_orders] &lt; 5 THEN &quot;&lt;5&quot;&#10;ELSEIF [succ_orders] &gt;= 5 AND [succ_orders] &lt; 20 THEN &quot;5-20&quot;&#10;ELSEIF [succ_orders] &gt;= 20 AND [succ_orders] &lt; 30 THEN &quot;20-30&quot;&#10;ELSEIF [succ_orders] &gt;= 30 AND [succ_orders] &lt; 50 THEN &quot;30-50&quot;&#10;ELSEIF [succ_orders] &gt;= 50 AND [succ_orders] &lt; 70 THEN &quot;50-70&quot;&#10;ELSE &quot;70+&quot;&#10;END' />
  </column>
  <column caption='vendors on cpc %' datatype='real' name='[Calculation_366128613346701334]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_366128613337419787]/[Calculation_3908350429770481664]' />
  </column>
  <column caption='vendors on disc %' datatype='real' name='[Calculation_366128613346766871]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_366128613337591820]/[Calculation_3908350429770481664]' />
  </column>
  <column caption='High vws vendors %' datatype='real' name='[Calculation_366128613346943000]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_366128613339881488]/[Calculation_3908350429770481664]' />
  </column>
  <column caption='vendors on tpro' datatype='integer' name='[Calculation_366128613356134426]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='countd(if[is_tpro] then [vendor_id] else null end)' />
  </column>
  <column caption='% vendors on tpro' datatype='real' name='[Calculation_366128613356412955]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_366128613356134426]/[Calculation_3908350429770481664]' />
  </column>
  <column caption='Reactivated churn to active' datatype='integer' hidden='true' name='[Calculation_3713077202160693249]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_4690780494637322246] = &quot;Reactivated&quot; and [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end' />
  </column>
  <column caption='Reactivated to retained' datatype='real' hidden='true' name='[Calculation_3713077202161152004]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([Calculation_3713077202160693249])/ COUNTD(if [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end )' />
  </column>
  <column caption='QR' datatype='real' hidden='true' name='[Calculation_3713077202161684485]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [Lifecycle segments  (copy)_6286251075724922881] in (&quot;Reactivated&quot;,&quot;New&quot;) then [vendor_id] else null end )/ COUNTD(if [Lifecycle segments  (copy)_6286251075724922881] = &quot;Churn&quot; then [vendor_id] else null end )' />
  </column>
  <column caption='Zombie MoM evolution' datatype='string' name='[Calculation_3713077202182250505]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if &#10; [Calculation_4690780494635651075] = &quot;Zombie&quot; and [Calculation_3908350429775085569] = &quot;Active&quot; then &quot;Zombie to Active&quot;&#10;ELSEIF [Calculation_4690780494635651075] = &quot;Zombie&quot; and [Calculation_3908350429775085569] = &quot;Offline&quot; then &quot;Zombie to Offline&quot;&#10;ELSEIF [Calculation_4690780494635651075] = &quot;Active&quot; and [Calculation_3908350429775085569]  = &quot;Zombie&quot; then &quot;Active to Zombies&quot;&#10;ELSEIF  [Calculation_4690780494635651075] = &quot;Offline&quot; and [Calculation_3908350429775085569] = &quot;Zombie&quot; then &quot;Offline to Zombies&quot;&#10;else &quot;others&quot; end' />
  </column>
  <column caption='Zombied MoM' datatype='integer' name='[Calculation_3713077202184585226]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if max([Calculation_3713077202182250505]) in (&quot;Zombie to Active&quot; ,&quot;Zombie to Offline&quot;) then (-1*[Calculation_3908350429770481664]) ELSE [Calculation_3908350429770481664] end' />
  </column>
  <column caption='Zombies' datatype='integer' name='[Calculation_3713077202185601035]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(IF ([Calculation_3908350429775085569]) = &quot;Zombie&quot; then [vendor_id] else null end)' />
  </column>
  <column caption='SFlag' datatype='integer' hidden='true' name='[Calculation_3713077202191581197]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if [first_online_date] &lt;= [month] or [m1_successful_orders] &gt;0 then 1 else 0 end' />
  </column>
  <column caption='contracted' datatype='boolean' hidden='true' name='[Calculation_3713077202192900110]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [previous_segment] in (&quot;Active&quot;)  then true else [is_contracted] end' />
  </column>
  <column caption='vizside' datatype='string' hidden='true' name='[Calculation_3713077202204839951]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&quot;segment&quot;' />
  </column>
  <column caption='Topad' datatype='integer' hidden='true' name='[Calculation_3713077202204901392]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_3713077202204839951] = &apos;segment&apos; then 1 else 49 end' />
  </column>
  <column caption='Zombie MoM delta' datatype='integer' name='[Calculation_3713077202252566546]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [Calculation_3908350429775085569] = &quot;Zombie&quot; then [vendor_id] else null end ) - COUNTD(if  [Calculation_4690780494635651075] = &quot;Zombie&quot; then [vendor_id] else null end)' />
  </column>
  <column caption='ret den' datatype='integer' hidden='true' name='[Calculation_3713077202281705498]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_4690780494637322246] in (&quot;Retained&quot;, &quot;Reactivated&quot;, &quot;New&quot;)  then [vendor_id] else null end' />
  </column>
  <column caption='Vertical flag' datatype='string' name='[Calculation_3835518800872120320]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF  (vertical = &quot;Restaurant&quot;  or lower(vertical_segment__c) in (&quot;bakery&quot;,&quot;drinks&quot;,&quot;snacks_and_sweets&quot;,&quot;specialty_coffee_and_tea&quot;))&#10;then &quot;Restaurant&quot; else &quot;Others&quot; end' />
  </column>
  <column caption='vendors' datatype='integer' name='[Calculation_3908350429770481664]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([vendor_id])' />
  </column>
  <column caption='Activity Segment' datatype='string' name='[Calculation_3908350429775085569]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [is_active] = true then &quot;Active&quot;&#10;ELSEIF [is_zombie] = true then &quot;Zombie&quot;&#10;ELSE &quot;Offline&quot; end' />
  </column>
  <column aggregation='Sum' caption='sanity_flag_v2' datatype='integer' name='[Calculation_4339992309094318080]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if [is_online] = true then 1 else [sanity_flag] end' />
  </column>
  <column caption='Lost GMV amt (eur)' datatype='real' name='[Calculation_4485866764767731712]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_4690780494491779072]' />
  </column>
  <column caption='Added to cart from Viewed menu' datatype='real' hidden='true' name='[Calculation_4624352401844838409]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([added_to_cart_sessions])/sum([viewed_menu_session_count])' />
  </column>
  <column caption='chain gmv' datatype='real' hidden='true' name='[Calculation_4624352401865416722]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{FIXED [chain_id],[country_code],[month] :sum([gmv_eur])}' />
  </column>
  <column caption='No first order%' datatype='real' name='[Calculation_4624352401881264149]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Zombie Vendors (copy)_4624352401880932371]/[Zombie Vendors (copy)_4624352401881092116]' />
  </column>
  <column caption='Total new active vendors ' datatype='integer' hidden='true' name='[Calculation_467178139244982272]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([onboarded M0 (copy)_1071293807976247301])+COUNTD([Active and onboarded M0 (copy)_1071293807976374278])+COUNTD([Active M0 and onboarded M-1 (copy)_1071293807976501255])' />
  </column>
  <column caption='MoM gmv growth' datatype='real' name='[Calculation_4690780494491779072]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum(IFNULL([gmv_eur],0)) - sum(IFNULL([m1_gmv_eur],0))' />
  </column>
  <column caption='Previous segment' datatype='string' name='[Calculation_4690780494635651075]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if IFNULL([previous_segment],&quot;null&quot;) = &apos;null&apos; then &quot;Offline&quot;&#10;ELSEIF [previous_segment] = &quot;Terminated&quot; then &quot;Offline&quot;&#10;else [previous_segment] end' />
  </column>
  <column caption='Next segment' datatype='string' name='[Calculation_4690780494636756996]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if IFNULL([next_segment],&quot;null&quot;) = &apos;null&apos; then &quot;Offline&quot;&#10;ELSEIF [next_segment] = &quot;Terminated&quot; then &quot;Offline&quot;&#10;else [next_segment] end' />
  </column>
  <column caption='Previous Lifecycle segment' datatype='string' name='[Calculation_4690780494637322246]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if lower([previous_status]) in (&quot;not onboarded&quot;,&quot;not onboarded / unsuccessful onboarding&quot;) and [m1_gmv_eur] &gt;0 and [gmv_eur]&gt;0 then  &quot;Retained&quot;&#10;ELSEIF lower([previous_status]) in (&quot;not onboarded&quot;,&quot;not onboarded / unsuccessful onboarding&quot;) and [m1_gmv_eur] &gt;0 then  &quot;Retained&quot;&#10;ELSEIF lower([previous_status]) in (&quot;not onboarded&quot;,&quot;not onboarded / unsuccessful onboarding&quot;) then  &quot;Inactive&quot;&#10;ELSEIF lower([previous_status]) = &quot;not activated&quot; THEN &quot;Not Activated&quot; &#10;ELSEIF lower([previous_status]) = &quot;reactivated churn&quot; THEN &quot;Reactivated&quot; &#10;ELSEIF  IFNULL([previous_status],&quot;null&quot;) = &quot;null&quot; then &quot;Inactive&quot; else   [previous_status] end' />
  </column>
  <column caption='new vendor' datatype='string' hidden='true' name='[Calculation_4754393887042646016]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [coldstart deno (copy)_1578441350398316554] &gt; 0 THEN &quot;New&quot; else &quot;existing&quot; end' />
  </column>
  <column caption='AM title group' datatype='string' name='[Calculation_4887883383097249795]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [account_owner_title] IN (&apos;Account Manager&apos;, &apos;Sales Executive&apos;, &apos;Sr. Analyst - Sales Performance&apos;, &apos; &apos;) THEN &apos;Account Manager&apos;&#10;  elseif [account_owner_title] IN (&apos;Sr. Account Manager&apos;) THEN &apos;Sr. Account Manager&apos;&#10;    elseif [account_owner_title] IN (&apos;Key Account Manager&apos;) THEN &apos;Key Account Manager&apos;&#10;        elseif [account_owner_title] IN (&apos;Sr. Key Account Manager&apos;) THEN &apos;Sr. Key Account Manager&apos;&#10;   elseif [account_owner_title] IN (&apos;Online Account Manager&apos;, &apos;Online Account Manager II&apos;) THEN &apos;Online Account Manager&apos;&#10;        elseif [account_owner_title] IN (&#10;                &apos;Associate Team Lead Account Management&apos;, &apos;Team Lead Account Management&apos;, &apos;Team Lead Online Account Management&apos;, &apos;Team Lead Online Account Management - Bahrain&apos;&#10;            )&#10;            THEN &apos;Team Lead&apos;&#10;        ELSE &apos;Account Manager&apos;&#10;    END' />
  </column>
  <column caption='Last month active vendors wonback ' datatype='boolean' name='[Calculation_4887883383886553096]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[previous_segment]= &quot;Active&quot; and [Lifecycle segments  (copy)_6286251075724922881] =  &quot;New vendors (activated)&quot;' />
  </column>
  <column caption='is_online count' datatype='integer' name='[Calculation_4991747661573562368]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [vendor_id] : COUNTD(IF  [is_online] = TRUE THEN [vendor_id] ELSE NULL END ) }' />
  </column>
  <column caption='CVR' datatype='real' name='[Calculation_4991747661573906433]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([placed_order_session_count])/SUM([viewed_menu_session_count])' />
  </column>
  <column caption='AB vendors' datatype='integer' name='[Calculation_4991747661574094850]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [vendor_grade] in (&quot;A&quot;,&quot;AAA&quot;,&quot;B&quot;) THEN [vendor_id] ELSE NULL END' />
  </column>
  <column caption='index' datatype='integer' name='[Calculation_4991747661580140548]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='INDEX()'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='IFNULL(SUM([GMV_eur ]),0)' datatype='real' hidden='true' name='[Calculation_4991747661604102162]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL(SUM([gmv_eur]),0)' />
  </column>
  <column caption='Current month GMV' datatype='real' name='[Calculation_4991747661604331539]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL([gmv_eur],0)' />
  </column>
  <column caption='Previous month GMV' datatype='real' name='[Calculation_4991747661604577300]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL([m1_gmv_eur],0)' />
  </column>
  <column caption='Less than 30 order' datatype='string' name='[Calculation_5257811866119372800]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='{ FIXED [vendor_id],[month] : if sum([successful_orders]) &lt; 30 then &quot;Less than 30 orders&quot; else &quot;30 or more orders&quot; end }' />
  </column>
  <column caption='Vendors with less than 30 orders a month' datatype='integer' name='[Calculation_5257811866120577025]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_5257811866119372800] = &quot;Less than 30 orders&quot; then [vendor_id] else null end' />
  </column>
  <column caption='Vendors with less than 30 orders%' datatype='real' name='[Calculation_5257811866123694082]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([Calculation_5257811866120577025])/COUNTD([vendor_id])' />
  </column>
  <column caption='Metrics' datatype='real' name='[Calculation_5424022852404760581]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;Orders&quot; then sum([Calculation_1578441350563373071])&#10;ELSEIF  [Parameters].[Parameter 3] = &quot;GMV&quot; then sum([gmv_eur])&#10;ELSEIF  [Parameters].[Parameter 3] = &quot;Availability&quot; then ([Offline rate (copy)_5424022852624961545]*100)&#10;ELSEIF  [Parameters].[Parameter 3] = &quot;CVR&quot; then ([Calculation_4991747661573906433]*100)&#10;ELSEIF  [Parameters].[Parameter 3] = &quot;#Vendors&quot; then [Calculation_3908350429770481664]&#10;ELSEIF  [Parameters].[Parameter 3] = &quot;Viewed menu sessions&quot; then sum([viewed_menu_session_count])&#10;end' />
  </column>
  <column caption='met - neg' datatype='string' name='[Calculation_5424022852622065671]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if ((ZN([Calculation_5424022852404760581]) - LOOKUP(ZN([Calculation_5424022852404760581]), -1)) / ABS(LOOKUP(ZN([Calculation_5424022852404760581]), -1))) &lt;0 then &quot;▼&quot; end'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Retention Rate ' datatype='real' name='[Calculation_593701131676246019]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[#vendors (copy)_593701131674714113]/[Retained Food not dineout vendors  (copy)_593701131675201538]' />
  </column>
  <column caption='Median Offline Time %' datatype='real' name='[Calculation_593701131676758020]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_offline_duration_in_hours])} &#10;/{fixed [vendor_id],[Calculation_1094796961416204294]:sum([index_schedule_duration_in_hours])}' />
  </column>
  <column caption='Median Menu Sessions' datatype='integer' name='[Calculation_593701131677102085]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id],[Calculation_1094796961416204294]:sum([viewed_menu_session_count])}' />
  </column>
  <column caption='#vendors' datatype='integer' name='[Calculation_6208141725170606080]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([vendor_id])' />
  </column>
  <column caption='test ond age' datatype='integer' hidden='true' name='[Calculation_6208141725174054914]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='DATEDIFF(&apos;day&apos; ,[first_online_date],TODAY())' />
  </column>
  <column caption='Viewed Menu Vendors' datatype='integer' name='[Calculation_6208141725425737744]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [viewed_menu_session_count] &gt; 0 then [vendor_id] end )' />
  </column>
  <column caption='Added to Cart Vendors' datatype='integer' name='[Calculation_6208141725426057233]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF ([added_to_cart_sessions]) &gt; 0 then [vendor_id] end )' />
  </column>
  <column caption='Checkout Vendors' datatype='integer' name='[Calculation_6208141725426159634]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF ([started_checkout_sessions]) &gt; 0 then [vendor_id] end )' />
  </column>
  <column caption='No First Order Vendors' datatype='integer' hidden='true' name='[Calculation_6208141725426642963]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [Lifecycle segments  (copy)_6286251075724922881] = &apos;Not Activated&apos; then [vendor_id] end)' />
  </column>
  <column caption='Zombie Vendors' datatype='integer' name='[Calculation_6208141725433856025]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;CASE  [Calculation_3908350429775085569] WHEN &apos;Zombie&apos; Then [vendor_id] end)' />
  </column>
  <column caption='Online Vendors' datatype='integer' name='[Calculation_6208141725434609691]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;CASE [is_online] WHEN TRUE THEN [vendor_id] END&#10;)' />
  </column>
  <column caption='Zombie %' datatype='real' default-format='p0.00%' name='[Calculation_6208141725434683420]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_6208141725433856025]/[Calculation_6208141725434609691]' />
  </column>
  <column caption='MoM gmv growth segment' datatype='string' hidden='true' name='[Calculation_6336775791926816773]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if [MoM order growth (copy)_4624352401849225228] &gt; 0 then &quot;Growing&quot;&#10;ELSEIF  [MoM order growth (copy)_4624352401849225228] = 0 then &quot;same&quot;&#10;ELSEIF [MoM order growth (copy)_4624352401849225228] &lt; 0 then &quot;Declining&quot;&#10;else null end' />
  </column>
  <column caption='User Filter' datatype='boolean' name='[Calculation_6430858794883739648]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN lower(USERNAME()) = lower([account_manager_email] )&#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN lower([team_leader_email]) = {MIN(IF  lower(USERNAME() ) = lower([account_manager_email]) THEN lower([team_leader_email]) ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN lower(USERNAME()) = lower([team_leader_email]) OR lower(USERNAME()) = lower([account_manager_email] )&#10;END' />
  </column>
  <column caption='order buckets' datatype='string' name='[Calculation_644366644839739393]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if ifnull([successful_orders],0) = 0 then &quot;No orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt; 0 and  ifnull([successful_orders],0) &lt; 10  then &quot;&lt; 10 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 10 and  ifnull([successful_orders],0) &lt; 50  then &quot;10 to 50 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 50 and  ifnull([successful_orders],0) &lt; 200  then &quot;50 to 200 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 200 and  ifnull([successful_orders],0) &lt; 500  then &quot;200 to 500 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 500 and  ifnull([successful_orders],0) &lt; 1000  then &quot;500 to 1000 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 1000 and  ifnull([successful_orders],0) &lt; 2000  then &quot;1000 to 2000 orders&quot;&#10;ELSEIF ifnull([successful_orders],0) &gt;= 2000  then &quot;&gt;= 2000 orders&quot;&#10;end' />
  </column>
  <column caption='Groupby' datatype='string' name='[Calculation_6846878850810253314]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[vendor_lifecycle_cohort Parameter]=&apos;country_code&apos; then [country_code] &#10;ELSEIF [Parameters].[vendor_lifecycle_cohort Parameter]=&apos;AM title group&apos; then [Calculation_4887883383097249795] &#10;ELSEIF [Parameters].[vendor_lifecycle_cohort Parameter]=&apos;Chain Tiers&apos; then [tiers]&#10;ELSEIF  [Parameters].[vendor_lifecycle_cohort Parameter]=&apos;AM Name&apos; then [account_manager_name]&#10;END' />
  </column>
  <column caption='Median Menu sessions per month' datatype='real' name='[Calculation_6865737672104869888]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [monthly_index]: MEDIAN([index_viewed_menu_session_count])}' />
  </column>
  <column caption='Vendors with Menu sessions &gt; Median menu sessions' datatype='integer' name='[Calculation_6865737672105238529]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [index_viewed_menu_session_count] &gt; [Calculation_6865737672104869888] then [vendor_id] else null end)' />
  </column>
  <column caption='Segments' datatype='string' name='[Calculation_6965802038326939651]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Active and zombie vendors&quot; then [Calculation_3908350429775085569]&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Lifecycle status&quot; then [Lifecycle segments  (copy)_6286251075724922881]&#10;end' />
  </column>
  <column caption='Newly active vendors' datatype='integer' hidden='true' name='[Churned vendors (copy)_1578441347957452802]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;if  IFNULL([coldstart deno (copy)_1578441350398316554],0) &gt;0  then  [vendor_id] end)' />
  </column>
  <column caption='Active vendors' datatype='integer' hidden='true' name='[Contracted base (copy)_1980035770615275521]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;if   [is_contracted] = true and [is_active] = true then  [vendor_id] end)' />
  </column>
  <column datatype='boolean' hidden='true' name='[DH_kitchen_flag_v2]' role='dimension' type='nominal' />
  <column caption='Drop in conversion' datatype='boolean' name='[Drop in Menu sessions (copy)_2697374743085350915]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([placed_order_count]/[vendor_list_session_count]) &lt; ([last_month_placed_order_count]/[last_month_vendor_list_session_count]) then True else False end' />
  </column>
  <column caption='Greater than 30 order' datatype='string' hidden='true' name='[Less than 30 order (copy)_1578441350419447822]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='{ FIXED [vendor_id],[month] : if sum([successful_orders]) &gt;= 30 then &quot;&gt;=30 orders&quot; else &quot;Less than 30 orders&quot; end }' />
  </column>
  <column caption='Lifecycle Segments  (copy 3)' datatype='string' hidden='true' name='[Lifecycle Segments  (copy 3)_2292754475496222720]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [Calculation_3908350429775085569] = &quot;Active&quot; then   &quot;New vendors (activated)&quot;&#10;&#10;ELSEIF [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and   DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [Calculation_3908350429775085569] &lt;&gt; &quot;Active&quot; then   &quot;New vendors (not activated)&quot;&#10;ELSEIF &#10;[is_reactivated_churn] = true then &quot;Reactivated_churn&quot;&#10;&#10;ELSEIF [was_active_before]=false and  [successful_orders]&gt;0  &#10;and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[first_online_date]),[month])) &gt;=3&#10;  then   &quot;Reactivated_zombie&quot; // first time order&#10;&#10;&#10;&#10;ELSEIF [is_retained] = true   then &quot;Retained&quot;&#10;&#10;//ELSEIF [is_new] = true and  DATETRUNC(&apos;month&apos;,[First Order Date]) = month   then   &quot;Reactivated&quot; // first time order&#10;&#10;ELSEIF ifnull([m1_gmv_eur],0) &gt;0 and IFNULL([gmv_eur],0) = 0   then &quot;Churn&quot;&#10;//ELSEIF [is_reactivated_churn] = true then &quot;Reactivated_churn&quot;&#10;//ELSEIF [is_churn] = true   then &quot;Churn&quot;&#10;ELSEIF [is_inactive] = true then &quot;Inactive&quot;&#10;ELSEIF [is_has_no_first_order] = true  then &quot;Inactive&quot; //&quot;No first order&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Retained&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Reactivated&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and  [previous_status] = &quot;New&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Offline&quot; then &quot;Inactive&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Zombie&quot; then &quot;Inactive&quot;&#10;else null end' />
  </column>
  <column caption='checks Lifecycle Segments  ' datatype='string' hidden='true' name='[Lifecycle Segments  (copy 4)_6445143685923024897]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [Calculation_3908350429775085569] = &quot;Active&quot; then   &quot;New vendors (activated)&quot;&#10;&#10;ELSEIF [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and   DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [Calculation_3908350429775085569] &lt;&gt; &quot;Active&quot; then   &quot;New vendors (not activated)&quot;&#10;&#10;ELSEIF [is_retained] = true   then &quot;Retained&quot;&#10;&#10;&#10;ELSEIF [is_new] = true and  DATETRUNC(&apos;month&apos;,[first_order_date]) = month  &#10;and  DATEDIFF(&apos;month&apos;, month, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date])) = 1 then   &quot;Reactivated ft&quot; // first time order&#10;&#10;ELSEIF ifnull([m1_gmv_eur],0) &gt;0 and IFNULL([gmv_eur],0) = 0   then &quot;Churn&quot;&#10;ELSEIF [is_reactivated_churn] = true then &quot;Reactivated&quot;&#10;//ELSEIF [is_churn] = true   then &quot;Churn&quot;&#10;ELSEIF [is_inactive] = true then &quot;Inactive&quot;&#10;ELSEIF [is_has_no_first_order] = true  then &quot;Inactive&quot; //&quot;No first order&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Retained&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Reactivated&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and  [previous_status] = &quot;New&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Offline&quot; then &quot;Inactive&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Zombie&quot; then &quot;Inactive&quot;&#10;else null end' />
  </column>
  <column caption='Lifecycle Segments_growing_addition' datatype='string' name='[Lifecycle Segments  (copy)_366128613325262855]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [is_pre_churn]=1 then &apos;pre_churn&apos; &#10;else &#10;&#10;(&#10;if&#10;  [is_reactivated_churn] &#10;   AND (&#10;       (DATETRUNC(&apos;month&apos;, [first_online_date]) &lt; DATEADD(&apos;month&apos;, -2, [month])) &#10;       OR &#10;       (DATETRUNC(&apos;month&apos;, [first_online_date]) = DATEADD(&apos;month&apos;, -2, [month]) AND [m_2_successful_order]&gt;0)&#10;       or (ISNULL([first_online_date]) and not ISNULL([first_order_date]))&#10;   ) then &quot;Reactivated&quot;&#10;&#10;ELSEIF [is_active]&#10;and [is_reactivated_churn]=FALSE&#10;and [was_active_before]=FALSE then &quot;Reactivated&quot;&#10;&#10;ELSEIF ifnull([m1_gmv_eur],0) &gt;0 and IFNULL([gmv_eur],0) = 0   then &quot;Churn&quot;&#10;&#10;ELSEIF [is_retained] and [successful_orders]/(IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY(TODAY()) - 1&#10;ELSE&#10;    30 END) &#10;&gt;[m1_successful_orders]/30 then &apos;Growing&apos; &#10;&#10;&#10;ELSEIF [is_retained] and [successful_orders]/(IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY(TODAY()) - 1&#10;ELSE&#10;    30 END) &lt;[m1_successful_orders]/30  &#10;and ISNULL([m_2_successful_order])&#10;&#10;then &apos;1m Degrowing&apos; &#10;&#10;ELSEIF [is_retained] and [successful_orders]/(IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY(TODAY()) - 1&#10;ELSE&#10;    30 END) &lt;[m1_successful_orders]/30  &#10;and ([m1_successful_orders]/30 &gt;= [m_2_successful_order]/30) and not ISNULL([m_2_successful_order])&#10;&#10;then &apos;1m Degrowing&apos; &#10;&#10;&#10;ELSEIF [is_retained] and [successful_orders]/(IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY(TODAY()) - 1&#10;ELSE&#10;    30 END) &lt;[m1_successful_orders]/30  &#10;and [m1_successful_orders]/30 &lt; [m_2_successful_order]/30 and not ISNULL([m_2_successful_order])&#10;then &apos;2m Degrowing&apos; &#10;&#10;&#10;&#10;&#10;&#10;ELSEIF [is_retained] and [successful_orders]/(IF [month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#10;    DAY(TODAY()) - 1&#10;ELSE&#10;    30 END) =[m1_successful_orders]/30 then &apos;Flat&apos; &#10;else null end) END' />
  </column>
  <column caption='Lifecycle Segments  (with new vendor split)' datatype='string' name='[Lifecycle Segments  (copy)_6445143685930471427]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [Calculation_3908350429775085569] = &quot;Active&quot; then   &quot;New vendors (activated)&quot;&#10;&#10;ELSEIF [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and   DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [Calculation_3908350429775085569] &lt;&gt; &quot;Active&quot; then   &quot;New vendors (not activated)&quot;&#10;&#10;ELSEIF [is_retained] = true   then &quot;Retained&quot;&#10;&#10;ELSEIF [is_new] = true and  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 1  then   &quot;Delayed activation - m1&quot; // first time order&#10;ELSEIF [is_new] = true and  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 2  then   &quot;Delayed activation - m2&quot; // first time order&#10;ELSEIF [is_new] = true and  DATETRUNC(&apos;month&apos;,[first_order_date]) = month   then   &quot;Reactivated&quot; // first time order&#10;&#10;ELSEIF ifnull([m1_gmv_eur],0) &gt;0 and IFNULL([gmv_eur],0) = 0   then &quot;Churn&quot;&#10;ELSEIF [is_reactivated_churn] = true then &quot;Reactivated&quot;&#10;//ELSEIF [is_churn] = true   then &quot;Churn&quot;&#10;ELSEIF [is_inactive] = true then &quot;Inactive&quot;&#10;ELSEIF [is_has_no_first_order] = true  then &quot;Inactive&quot; //&quot;No first order&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Retained&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Reactivated&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and  [previous_status] = &quot;New&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Offline&quot; then &quot;Inactive&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Zombie&quot; then &quot;Inactive&quot;&#10;else null end' />
  </column>
  <column caption='Lifecycle Segments ' datatype='string' name='[Lifecycle segments  (copy)_6286251075724922881]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [Calculation_3908350429775085569] = &quot;Active&quot; then   &quot;M0_New_Activated&quot;&#10;ELSEIF ISNULL([acquisition_business_type]) &#10;   AND ISNULL([first_online_date]) &#10;   AND DATETRUNC(&apos;month&apos;, [first_order_date]) = [month] &#10;   AND [is_new] then &quot;missng_sf_info_new_vendors&quot;&#10;&#10;ELSEIF [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and   DATETRUNC(&apos;month&apos;,[first_online_date]) = month and [Calculation_3908350429775085569] &lt;&gt; &quot;Active&quot; then   &quot;New vendors (not activated)&quot;&#10;&#10;Elseif (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 1&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;//and [is_active]&#10;and [successful_orders] &gt;0 and [m1_successful_orders]=0&#10;and [is_contracted]) then &quot;M1_New_Activated&quot;&#10;&#10;ELSEIF  (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month])) = 2&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [successful_orders] &gt;0 &#10;and [m1_successful_orders]=0 &#10;and IFNULL([m_2_successful_order],0)=0&#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;and [is_contracted] then  &quot;M2_New_Activated&quot;&#10;ELSEIF [is_retained] = true   then &quot;Retained&quot;&#10;ELSEIF  [is_reactivated_churn] &#10;   AND (&#10;       (DATETRUNC(&apos;month&apos;, [first_online_date]) &lt; DATEADD(&apos;month&apos;, -2, [month])) &#10;       OR &#10;       (DATETRUNC(&apos;month&apos;, [first_online_date]) = DATEADD(&apos;month&apos;, -2, [month]) AND [m_2_successful_order]&gt;0)&#10;       or (ISNULL([first_online_date]) and not ISNULL([first_order_date]))&#10;   ) then &quot;Reactivated Churn&quot;&#10;&#10;ELSEIF [is_active]&#10;and [is_reactivated_churn]=FALSE&#10;and [was_active_before]=FALSE then &quot;Reactivated from zombie&quot;&#10;&#10;&#10;//ELSEIF [is_new] = true and  DATETRUNC(&apos;month&apos;,[First Order Date]) = month   then   &quot;Reactivated&quot; // first time order&#10;&#10;ELSEIF ifnull([m1_gmv_eur],0) &gt;0 and IFNULL([gmv_eur],0) = 0   then &quot;Churn&quot;&#10;//ELSEIF [is_reactivated_churn] = true then &quot;Reactivated&quot;&#10;//ELSEIF [is_churn] = true   then &quot;Churn&quot;&#10;ELSEIF [is_inactive] = true then &quot;Inactive&quot;&#10;ELSEIF [is_has_no_first_order] = true  then &quot;Inactive&quot; //&quot;No first order&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Retained&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and [previous_status] = &quot;Reactivated&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Active&quot; and  [previous_status] = &quot;New&quot; then &quot;Retained&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Offline&quot; then &quot;Inactive&quot;&#10;ELSEIF [is_not_onboarded] = true  and [Calculation_3908350429775085569] = &quot;Zombie&quot; then &quot;Inactive&quot;&#10;else null end' />
  </column>
  <column caption='M-3 VWS ' datatype='real' name='[M-1 VWS (copy) (copy)_1094796961382498305]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id]:sum([total_spend_lag_3])}/ {fixed [vendor_id]: sum([basket_amount_eur_lag_3])}' />
  </column>
  <column caption='M-2 VWS' datatype='real' name='[M-1 VWS (copy)_1094796961382486016]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{fixed [vendor_id]:sum([total_spend_lag_2])}/ {fixed [vendor_id]: sum([basket_amount_eur_lag_2])}' />
  </column>
  <column caption='MoM order growth ' datatype='real' hidden='true' name='[MoM gmv growth (copy)_4991747661595615246]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum(IFNULL([successful_orders],0)) - sum(IFNULL([m1_successful_orders],0))' />
  </column>
  <column caption='MoM gmv growth %' datatype='real' hidden='true' name='[MoM order growth (copy)_4624352401849225228]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([gmv_eur])/ sum([m1_gmv_eur]))-1' />
  </column>
  <column caption='Months frm onb vs yesterday' datatype='integer' hidden='true' name='[Months frm onboarding (copy)_3297971978530459654]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[first_online_date],(datetrunc(&apos;month&apos;,[Calculation_3297971978528587779])))' />
  </column>
  <column caption='New M-1 active M0' datatype='integer' hidden='true' name='[New and active M-1 (copy)_5575245279471435779]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if &#10;        DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [first_online_date]), [month]) = 1 &#10;    &#10;        AND (&#10;            DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [first_order_date]), [month]) = 0&#10;        )&#10;    THEN [vendor_id]&#10;    ELSE NULL&#10;END' />
  </column>
  <column caption='ret num' datatype='integer' hidden='true' name='[New to active (copy)_3713077202281467929]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_4690780494637322246] in (&quot;Retained&quot;, &quot;Reactivated&quot;, &quot;New&quot;) and [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end' />
  </column>
  <column caption='Retention' datatype='real' hidden='true' name='[New to retained  (copy)_3713077202281435160]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([New to active (copy)_3713077202281467929])/ COUNTD([Calculation_3713077202281705498])' />
  </column>
  <column caption='Next status  (copy)' datatype='string' hidden='true' name='[Next status  (copy)_6524167801547530242]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [next_status] in (&quot;not onboarded&quot;,&quot;not onboarded / unsuccessful onboarding&quot;) then &quot;Not Onboarded&quot;&#10;ELSEIF [next_status] = &quot;not activated&quot; THEN &quot;Not Activated&quot; &#10;ELSEIF  IFNULL([next_status],&quot;null&quot;) = &quot;null&quot; then &quot;Inactive&quot; else   [next_status] end' />
  </column>
  <column caption='Availability' datatype='real' name='[Offline rate (copy)_5424022852624961545]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([actual_duration_in_hours]) - sum([total_offline_duration]))/sum([actual_duration_in_hours])' />
  </column>
  <column caption='Attempted Placed Order Vendors' datatype='integer' name='[Placed Order Vendors (copy 2)_6208141725448097827]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [attempted_placed_order_session_count] &gt; 0 then [vendor_id] end )' />
  </column>
  <column caption='Next status ' datatype='string' name='[Previous status (copy)_4690780494637985799]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [next_status] in (&quot;not onboarded&quot;,&quot;not onboarded / unsuccessful onboarding&quot;) then &quot;Not Onboarded&quot;&#10;ELSEIF [next_status] = &quot;not activated&quot; THEN &quot;Not Activated&quot; &#10;ELSEIF  IFNULL([next_status],&quot;null&quot;) = &quot;null&quot; then &quot;Inactive&quot; else   [next_status] end' />
  </column>
  <column caption='New to active' datatype='integer' hidden='true' name='[Reactivated churn to active (copy)_3713077202160996354]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_4690780494637322246] = &quot;New&quot; and [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end' />
  </column>
  <column caption='Retained to Retained' datatype='integer' hidden='true' name='[Reactivated churn to active (copy)_3713077202161065987]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_4690780494637322246] = &quot;Retained&quot; and [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end' />
  </column>
  <column caption='New to retained ' datatype='real' hidden='true' name='[Reactivated to retained (copy)_3713077202162081798]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([Reactivated churn to active (copy)_3713077202160996354])/ COUNTD(if [Calculation_3908350429775085569] = &quot;Active&quot; then [vendor_id] else null end )' />
  </column>
  <column caption='Retained  orders' datatype='string' hidden='true' name='[Retained  (copy)_4991747661597229071]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='{FIXED [vendor_id],[month]: if [MoM gmv growth (copy)_4991747661595615246] &gt; 0 then &quot;Expanding&quot; ELSEIF &#10;[MoM gmv growth (copy)_4991747661595615246] &lt;0 then  &quot;Contracting&quot; &#10;ELSEIF [MoM gmv growth (copy)_4991747661595615246] = 0 then &quot;Same&quot; end}' />
  </column>
  <column caption='Last Month Active Food not dineout vendors ' datatype='integer' name='[Retained Food not dineout vendors  (copy)_593701131675201538]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD (IF [vendor_dineout_flag]=False&#10; and [vertical]=&apos;Restaurant&apos; &#10;and [previous_segment]=&apos;Active&apos;&#10;then [vendor_id] END)' />
  </column>
