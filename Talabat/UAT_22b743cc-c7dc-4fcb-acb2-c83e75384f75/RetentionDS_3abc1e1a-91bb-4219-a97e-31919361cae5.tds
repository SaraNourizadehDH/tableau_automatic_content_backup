  <column caption='Contracted base' datatype='integer' name='[Zombie Vendors (copy)_4624352401881092116]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;if   [is_contracted] = true then [vendor_id] end)' />
  </column>
  <column caption='Active mom ' datatype='integer' name='[Zombied MoM (copy)_3713077202277199895]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if max([Zombie MoM evolution (copy)_3713077202276589590]) in (&quot;Churned&quot; ) then (-1*[Calculation_3908350429770481664]) ELSE [Calculation_3908350429770481664] end' />
  </column>
  <column caption='Active' datatype='integer' name='[Zombies (copy)_3713077202274078739]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(IF ([Calculation_3908350429775085569]) = &quot;Active&quot; then [vendor_id] else null end)' />
  </column>
