  <column caption='online MoM delta ' datatype='integer' hidden='true' name='[Zombie MoM delta (copy)_4991747661589442572]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [Calculation_3908350429775085569] in (&quot;Active&quot;,&quot;Zombie&quot;) then [vendor_id] else null end ) - COUNTD(if  [Calculation_4690780494635651075] in (&quot;Active&quot;,&quot;Zombie&quot;) then [vendor_id] else null end)' />
  </column>
  <column caption='Active  MoM evolution ' datatype='string' name='[Zombie MoM evolution (copy)_3713077202276589590]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if &#10;//[is_retained] = true then &quot;Retained&quot;&#10;[Lifecycle Segments  (copy)_6445143685930471427] = &quot;Churn&quot; then &quot;Churned&quot;&#10;//ELSEIF [Activity Segment] = &quot;Active&quot; and [Lifecycle segment] = &quot;New&quot;   then &quot;New Vendors taken live in the current month&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot;  and    [is_retained] = false&#10; and  DATETRUNC(&apos;month&apos;,[first_online_date]) = [month]  then &quot;Newly active vendors&quot;&#10;&#10;ELSEIF [Lifecycle Segments  (copy)_6445143685930471427] = &quot;New vendors (activated)&quot; then &quot;Newly active vendors&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot; and [Lifecycle Segments  (copy)_6445143685930471427] = &quot;New&quot; &#10;and DATETRUNC(&apos;month&apos;,[first_order_date]) = [month]  then &quot;Reactivated&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot; and [Lifecycle Segments  (copy)_6445143685930471427]  = &quot;Reactivated&quot; then &quot;Reactivated&quot;&#10;&#10;//ELSEIF [Activity Segment] = &quot;Active&quot; and [Lifecycle Segments  (with new vendor split)]  = &quot;Delayed activation - m1&quot; then &quot;New active vendors this month - onboarded in m-1&quot;&#10;ELSEIF  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 1&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;//and [is_active]&#10;and [successful_orders] &gt;0 and [m1_successful_orders]=0 then &quot;New active vendors this month - onboarded in m-1&quot;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot; and [Lifecycle Segments  (copy)_6445143685930471427]  = &quot;Delayed activation - m2&quot; then &quot;New active vendors this month - onboarded in m-2&quot;&#10;else &quot;others&quot; end' />
  </column>
  <column caption='No first order vendors' datatype='integer' name='[Zombie Vendors (copy)_4624352401880932371]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(&#10;CASE  [Lifecycle segments  (copy)_6286251075724922881] WHEN &apos;No first order&apos; Then [vendor_id] end)' />
