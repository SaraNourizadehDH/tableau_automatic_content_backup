  <column caption='Online  MoM evolution  ' datatype='string' name='[Active  MoM evolution  (copy)_4991747661590142989]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if &#10; [Calculation_4690780494635651075] in (&quot;Active&quot;) and [Calculation_3908350429775085569] in (&quot;Active&quot;)  then  &quot;Active&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Zombie&quot;) and [Calculation_3908350429775085569] in (&quot;Zombie&quot;)  then  &quot;Zombie&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Zombie&quot;) and [Calculation_3908350429775085569] in (&quot;Active&quot;)  then  &quot;Zombie to Active&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Active&quot;) and [Calculation_3908350429775085569] in (&quot;Zombie&quot;)  then  &quot;Active to Zombie&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Offline&quot;) and [Calculation_3908350429775085569] in (&quot;Active&quot;)  then  &quot;Offline to Active&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Offline&quot;) and [Calculation_3908350429775085569] in (&quot;Zombie&quot;)  then  &quot;Offline to Zombie&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Active&quot;) and [Calculation_3908350429775085569] in (&quot;Offline&quot;)  then  &quot;Active to Offline&quot;&#10;ELSEIF    [Calculation_4690780494635651075] in (&quot;Zombie&quot;) and [Calculation_3908350429775085569] in (&quot;Offline&quot;)  then  &quot;Zombie to Offline&quot;&#10;&#10;&#10;else &quot;others&quot; end' />
  </column>
  <column caption='Active  MoM evolution  v2' datatype='string' name='[Active  MoM evolution  (copy)_6445143685931130884]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 1&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;//and [is_active]&#10;and [successful_orders] &gt;0 and [m1_successful_orders]=0 then &quot;New active vendors this month - onboarded in m-1&quot;&#10;//[is_retained] = true then &quot;Retained&quot;&#10;ELSEIF  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 2&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [successful_orders] &gt;0 &#10;and [m1_successful_orders]=0 &#10;and IFNULL([m_2_successful_order],0)=0 Then&#10; &quot;New active vendors this month - onboarded in m-2&quot;&#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;&#10;ELSEIF [Lifecycle Segments  (copy)_6445143685930471427] = &quot;Churn&quot; then &quot;Churned&quot;&#10;//ELSEIF [Activity Segment] = &quot;Active&quot; and [Lifecycle segment] = &quot;New&quot;   then &quot;New Vendors taken live in the current month&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot;  and    [is_retained] = false&#10; and  DATETRUNC(&apos;month&apos;,[first_online_date]) = [month]  then &quot;Newly active vendors&quot;&#10;&#10;ELSEIF [Lifecycle Segments  (copy)_6445143685930471427] = &quot;New vendors (activated)&quot; then &quot;Newly active vendors&quot;&#10;ELSEIF [is_new] and ISNULL([acquisition_business_type]) and ISNULL([first_online_date]) &#10;and DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[first_order_date]),[month]) = 0 then &quot;Newly active vendors&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot; and [Lifecycle Segments  (copy)_6445143685930471427] = &quot;New&quot; &#10;and DATETRUNC(&apos;month&apos;,[first_order_date]) = [month]  then &quot;Reactivated&quot;&#10;&#10;ELSEIF [Calculation_3908350429775085569] = &quot;Active&quot; and [Lifecycle Segments  (copy)_6445143685930471427]  = &quot;Reactivated&quot; then &quot;Reactivated&quot;&#10;&#10;//ELSEIF [Activity Segment] = &quot;Active&quot; and [Lifecycle Segments  (with new vendor split)]  = &quot;Delayed activation - m1&quot; then &quot;New active vendors this month - onboarded in m-1&quot;&#10;//ELSEIF  DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 1&#10;//and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;//and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[First Order Date]),[month])) = 0&#10;//and [is_active]&#10;//and [successful_orders] &gt;0 and [Previous month orders]=0 then &quot;New active vendors this month - onboarded in m-1&quot;&#10;//ELSEIF [Activity Segment] = &quot;Active&quot; and [Lifecycle Segments  (with new vendor split)]  = &quot;Delayed activation - m2&quot; then &quot;New active vendors this month - onboarded in m-2&quot;&#10;else &quot;others&quot; end' />
  </column>
