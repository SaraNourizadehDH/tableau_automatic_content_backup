    <calculation class='tableau' formula='if (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[dim_vendor_first_online_date]),[month]) = 2&#10;and [acquisition_business_type] &lt;&gt; &quot;Switch&quot; &#10;and [is_active]&#10;and (DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;,[first_order_date]),[month])) = 0&#10;&#10;&#10;) then [vendor_id] else null end' />
