  <datasource-dependencies datasource='Parameters'>
    <column caption='Metrics' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;\#Vendors&quot;'>
      <calculation class='tableau' formula='&quot;#Vendors&quot;' />
      <members>
        <member value='&quot;Orders&quot;' />
        <member value='&quot;GMV&quot;' />
        <member value='&quot;\#Vendors&quot;' />
        <member value='&quot;Availability&quot;' />
        <member value='&quot;CVR&quot;' />
        <member value='&quot;Viewed menu sessions&quot;' />
      </members>
    </column>
    <column caption='Segments' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifecycle status&quot;'>
      <calculation class='tableau' formula='&quot;Lifecycle status&quot;' />
      <members>
        <member value='&quot;Active and zombie vendors&quot;' />
        <member value='&quot;Lifecycle status&quot;' />
      </members>
    </column>
    <column caption='Group by ' datatype='string' name='[vendor_lifecycle_cohort Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;country_code&quot;'>
      <calculation class='tableau' formula='&quot;country_code&quot;' />
      <members>
        <member value='&quot;country_code&quot;' />
        <member value='&quot;Chain Tiers&quot;' />
        <member value='&quot;AM title group&quot;' />
        <member value='&quot;AM Name&quot;' />
      </members>
    </column>
  </datasource-dependencies>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='inventory' id='_75AA67F492384F9180547B5A67AF6839'>
        <properties context=''>
          <relation connection='bigquery.0vd7qfl0b128dr155gcuk0979a51 (copy)' name='Custom SQL Query' type='text'><![CDATA[with 

comm as 
( SELECT 
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  ),

tiers as 
(
SELECT 
distinct 
lower(country_code) as country_code,
(chain_id) as chain_id,
date,
lower(chain_name) as chain_name,
chain_monetisation_tiers 
FROM `tlb-data-prod.data_platform.agg_chain_tiers` 
 where date >>= '2025-01-01'
), 

transmission as   
(
SELECT
*
FROM  
(
SELECT 
vendor_id,
dt.transmission_id  AS transmission_id,
dt.transmission_category  AS transmission_category,
dt.pos_integration_name  AS pos_integration_name,
dt.pos_integration_flow  AS pos_integration_flow,
dt.device_os_name  AS transmission_device_os_name,
row_number() over (partition by vendor_id order by end_date desc ) as rno

FROM `tlb-data-prod.data_platform.rltnp_vendor_x_transmission`  vt 
LEFT JOIN `tlb-data-prod.data_platform.dim_transmission` dt ON vt.transmission_id = dt.transmission_id
WHERE 1=1
--and vendor_id = 1038
)
WHERE rno = 1
),


new_ven as    
(
  select 
*
from  
(
select 
  *,
  row_number() over(partition by salesforce_id  order by date(first_online_date) desc ) as rnk
  from  
(
  SELECT
  DISTINCT 
  date_trunc(o.closedate,month) first_online_month,
  ch.country_code as country,
  v.salesforce_id,
  v.vendor_id,
  v.vendor_name,
  o.business_type__c as business_type,
  a.vertical__c as vertical,
  o.closedate as first_online_date,
  vendor_grade,
  account_status__c,
  lower(CONCAT(firstname, ' ', lastname)) AS opp_owner_name,
  u.title as opp_owner_title,
  is_contract_terminated,
  is_hidden,

FROM `tlb-data-prod.data_platform.dim_vendor_info` v 
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch 
ON ch.chain_id = v.chain_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
ON v.salesforce_id = a.grid__c
LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
ON a.id = c.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
ON a.id =o.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON o.ownerid = u.id
WHERE
o.business_type__c IN 
('Franchise Extension',
'New Business',
'Win Back')
AND iswon
)
)
where rnk = 1
) 
,
is_active_before as (
SELECT 
         k1.vendor_id,
        k1.country_code,
        k1.month,
        max(k2.is_active) as was_active_before
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` k1 
    left join `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`  k2
    on k1.vendor_id=k2.vendor_id 
    and k2.month <<= k1.month and k2.vertical='Restaurant' and k2.month >>='2024-01-01'
    WHERE k1.vertical = 'Restaurant'
     and  k1.month >>='2024-1-01'
         and date_trunc(k1.first_online_date,month) <<= k1.month - interval '2' month
   -- and first_online_date <<= month - interval '3' month
    group by all
    having was_active_before=False
    
    )
,inv_metadata as (   
select i.* ,
dv.is_dineout,
dv.is_dh_kitchen,
dv.team_leader_name,
dv.first_online_date as dim_vendor_first_online_date, 
dv.acquisition_business_type, 
nv.opp_owner_name,  
opp_owner_title,
lower(CONCAT(u.firstname, ' ', u.lastname)) AS account_owner_name,
u.title as account_owner_title,
central_job_role__c as account_owner_central_job_role,
case when dh_kitchen_onboarding_date is not null then true else false end as DH_kitchen_flag_v2,
IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag,
transmission_id,
transmission_category,
pos_integration_name,
pos_integration_flow,
transmission_device_os_name,
vertical_segment__c,
ifnull(chain_monetisation_tiers,"Tier E") as tiers,
dv.is_managed_by_vendor_helpdesk 
, current_timestamp as last_updated_timestamp,
dv.account_manager_email,
dv.team_leader_email,
dv.is_hidden, 
dv.is_contract_terminated,
lag(m1_successful_orders) over(partition by i.vendor_id order by i.month ) m_2_successful_order,
ab.was_active_before,
dv.is_tpro,
from `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly`i
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a ON i.salesforce_id = a.grid__c
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u ON a.ownerid = u.id
left join `tlb-data-prod.data_platform.dim_vendor_info` dv on i.vendor_id = dv.vendor_id 
left join comm on comm.salesforce_id = dv.salesforce_id 
left join new_ven nv on nv.vendor_id = i.vendor_id
left join transmission tr on tr.vendor_id = i.vendor_id 
left join tiers t on t.chain_id = i.chain_id and date_trunc(t.date,month) = i.month
left join is_active_before ab on ab.vendor_id=i.vendor_id and ab.month=i.month - interval '1' month
where lower(i.country_code)  in ("ae","qa","jo","iq","kw","bh","om","eg")
and i.month >>='2025-1-01') 

,
metrics_metadata AS (
     /* Active vendors in December 2024 */
     SELECT
       k.vendor_id,
     k.country_code,
     date_trunc(snapshot_date,month) as month,

     sum(successful_order_count) as succ_orders, 
     sum(gmv_amount_eur) as gmv, 
    sum( IFNULL((cpp_featured_product_revenue_eur),0) +
IFNULL((kwords_revenue_eur),0) +
IFNULL((cpp_revenue_eur),0) +
IFNULL((deal_targeting_revenue_eur),0) +
IFNULL((gem_commission_amount_eur),0) +
--IFNULL((organic_placement_revenue_eur),0) +
IFNULL(display_ads_revenue_eur,0)) ad_rev,
sum(ifnull(cpc_revenue_eur,0)) as cpc,
sum(ifnull(discount_amount_eur,0)) as discount,


--- add here offline time 
sum(offline_duration_in_hours) as offline_duration_in_hours,
sum(schedule_duration_in_hours) as schedule_duration_in_hours,
-- dlp and dld 
max(active_menu_item_count) as active_menu_item_count, 
max(item_with_image_count) as item_with_image_count,
max(item_with_description_count) as item_with_description_count,
-- Engagement vs Impressions 
sum(vendor_list_impression_session_count) as vendor_list_impression_count,
sum(viewed_menu_session_count) as viewed_menu_session_count,
sum(net_order_count) as placed_order_count,
sum(cpc_order_count) as cpc_order_count,
sum(vendor_active_customer_count) as vendor_active_customers,
sum(vendor_list_session_count) as vendor_list_session_count,






     FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` k
     left join `tlb-data-prod.data_platform.dim_vendor_info` vf on vf.vendor_id=k.vendor_Id
     WHERE vertical = 'food'
       AND snapshot_date >>= '2025-01-01'  -- December 2024
       and k.country_code <<>> 'SA'
       group by all), 

vws as (
  
  select 
snapshot_month as month,
w.country_code,
w.vendor_id,
--is_active,
sum(basket_amount_eur) as basket_amount_eur ,
sum(
IFNULL(commission_amount_eur,0) + 
IFNULL(tgo_amount_eur,0) +
IFNULL(featured_product_revenue_eur,0) + 
IFNULL(kwords_search_revenue_eur,0) + 
IFNULL(cpp_monthly_revenue_eur,0) + 
IFNULL(deal_targeting_revenue_eur_excl_vat,0) +
IFNULL(discount_amount_eur,0) + -- discount should not be counted as it's for customer not talabat 
IFNULL(gem_commission_amount_eur,0) + 
IFNULL(organic_placement_revenue_eur,0) +  
IFNULL(cash_fee_eur,0) + 
IFNULL(card_fee_eur,0) + 
IFNULL(vendor_tpro_cost_eur,0)+
IFNULL(display_ads_revenue_eur_excl_vat,0)+
IFNULL(tpro_commission_saving_amount_eur,0)+ -- q 
IFNULL(reward_commission_saving_amount_eur,0)+ -- q 
IFNULL(tpro_discount_amount_eur,0)+ --q 
IFNULL(vendor_reward_cost_eur,0) --q 

) as total_spend,

from `tlb-data-prod.data_platform.agg_vendor_wallet_share_monthly`  w 
left join `tlb-data-prod.data_platform.dim_vendor_info` v on v.vendor_id=w.vendor_id and v.chain_id=w.chain_id
where snapshot_month >>= "2025-01-01"
and vertical = "food"
group by all

)
,raw_level as (

select i.* except(viewed_menu_session_count), 
m.* except(vendor_id, month,country_code), 
v.basket_amount_eur,
v.total_spend,
CASE 
  WHEN is_reactivated_churn = TRUE
       AND (
         DATE_TRUNC(first_online_date, MONTH) << DATE_SUB(i.month, INTERVAL 2 MONTH)
         OR (DATE_TRUNC(first_online_date, MONTH) = DATE_SUB(i.month, INTERVAL 2 MONTH) AND m_2_successful_order >> 0)
         OR (first_online_date IS NULL AND first_order_date IS NOT NULL)
       ) THEN 'Reactivated'

  WHEN is_active = TRUE 
       AND is_reactivated_churn = FALSE 
       AND was_active_before = FALSE THEN 'Reactivated'

  WHEN IFNULL(m1_gmv_eur, 0) >> 0 
       AND IFNULL(gmv_eur, 0) = 0 THEN 'Churn'

  WHEN is_retained = TRUE 
       AND successful_orders / 
           (CASE 
              WHEN DATE_TRUNC(i.month, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) THEN EXTRACT(DAY FROM CURRENT_DATE()) - 1 
              ELSE 30 
            END) 
       >> m1_successful_orders / 30 THEN 'Growing'

  WHEN is_retained = TRUE 
       AND successful_orders / 
           (CASE 
              WHEN DATE_TRUNC(i.month, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) THEN EXTRACT(DAY FROM CURRENT_DATE()) - 1 
              ELSE 30 
            END) 
       << m1_successful_orders / 30 THEN 'Degrowing'

  WHEN is_retained = TRUE 
       AND successful_orders / 
           (CASE 
              WHEN DATE_TRUNC(i.month, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) THEN EXTRACT(DAY FROM CURRENT_DATE()) - 1 
              ELSE 30 
            END) 
       = m1_successful_orders / 30 THEN 'Flat'

  ELSE NULL
END AS vendor_lifecycle_cohort, 


lag(m.succ_orders, 1) over(partition by m.vendor_id order by m.month) as last_month_succ_orders,
lag(m.succ_orders, 2) over(partition by m.vendor_id order by m.month) as succ_orders_lag_2,
lag(m.succ_orders, 3) over(partition by m.vendor_id order by m.month) as succ_orders_lag_3,

lag(m.vendor_list_session_count, 1) over(partition by m.vendor_id order by m.month) as last_month_vendor_list_session_count,
lag(m.viewed_menu_session_count, 1) over(partition by m.vendor_id order by m.month) as last_month_viewed_menu_session_count,
lag(m.placed_order_count, 1) over(partition by m.vendor_id order by m.month) as last_month_placed_order_count,
-- For v.*
lag(v.basket_amount_eur, 1) over(partition by v.vendor_id order by v.month) as last_month_basket_amount_eur,
lag(v.basket_amount_eur, 2) over(partition by v.vendor_id order by v.month) as basket_amount_eur_lag_2,
lag(v.basket_amount_eur, 3) over(partition by v.vendor_id order by v.month) as basket_amount_eur_lag_3,

lag(v.total_spend, 1) over(partition by v.vendor_id order by v.month) as last_month_total_spend,
lag(v.total_spend, 2) over(partition by v.vendor_id order by v.month) as total_spend_lag_2,
lag(v.total_spend, 3) over(partition by v.vendor_id order by v.month) as total_spend_lag_3,



 from inv_metadata i 
left join metrics_metadata m on i.vendor_id=m.vendor_id and i.month=m.month 
left join vws v on i.vendor_id=v.vendor_id and i.month=v.month

) 
, pre_churn as 
(


  select vendor_id, date_trunc(rundate,month) as month,
  max(churn_prob) as latest_churn_prob
  from `tlb-data-dev.vendor_analytics.churn_prediction_model_output`
  group by all
)


select a1.*, 

date_diff(a2.month,a1.month,month) as monthly_index,
  a2.succ_orders AS index_succ_orders,
  a2.gmv AS index_gmv,
  a2.ad_rev AS index_ad_rev,
  a2.cpc AS index_cpc,
  a2.discount AS index_discount,
  a2.offline_duration_in_hours AS index_offline_duration_in_hours,
  a2.schedule_duration_in_hours AS index_schedule_duration_in_hours,
  a2.active_menu_item_count AS index_active_menu_item_count,
  a2.item_with_image_count AS index_item_with_image_count,
  a2.item_with_description_count AS index_item_with_description_count,
  a2.vendor_list_impression_count AS index_vendor_list_impression_count,
  a2.viewed_menu_session_count AS index_viewed_menu_session_count,
  a2.placed_order_count AS index_placed_order_count,
  a2.cpc_order_count AS index_cpc_order_count,
  a2.vendor_active_customers AS index_vendor_active_customers,
  a2.vendor_list_session_count AS index_vendor_list_session_count,
  a2.basket_amount_eur AS index_basket_amount_eur,
  a2.total_spend AS index_total_spend,
  case when m.vendor_id is not null then 1 else 0 end as is_pre_churn
 from raw_level a1 
left join raw_level a2 on a1.vendor_id=a2.vendor_id 
and a2.month between a1.month - interval '3' month and a1.month 

left join pre_churn m on m.vendor_id=a1.vendor_id 
and m.month=a1.month 

where ((a1.vendor_lifecycle_cohort is not null) 
or (a1.vendor_lifecycle_cohort is null and a1.is_active)
)]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
