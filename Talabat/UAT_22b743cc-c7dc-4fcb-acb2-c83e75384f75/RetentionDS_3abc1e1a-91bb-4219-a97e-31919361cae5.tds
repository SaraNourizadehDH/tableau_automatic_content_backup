  <column aggregation='None' caption='Topad (bin)' datatype='integer' hidden='true' name='[Topad (bin)]' role='dimension' type='ordinal'>
    <calculation class='bin' decimals='0' formula='[Calculation_3713077202204901392]' peg='0' size='1' />
  </column>
  <column caption='Total new active vendors_ ' datatype='integer' name='[Total new active vendors  (copy)_5890637995078946856]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([onboarded M0 (copy)_1071293807976247301])+COUNTD([Active M0 and onboarded M-1 (copy)_2637561318011015168])+COUNTD([Active M0 and onboarded M-2 (copy 2)_2637561318013276161])' />
  </column>
