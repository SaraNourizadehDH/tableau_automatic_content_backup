    <calculation class='tableau' formula='if &#10;        DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [dim_vendor_first_online_date]), [month]) = 1 &#10;        AND [acquisition_business_type] &lt;&gt; &apos;Switch&apos; &#10;        AND (&#10;            [successful_orders] &gt; 0 or [m1_successful_orders] &gt; 0&#10;            //DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [First Order Date]), [month]) = 1 &#10;            //OR DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [First Order Date]), [month]) = 0&#10;        )&#10;    THEN [vendor_id]&#10;    ELSE NULL&#10;END' />
