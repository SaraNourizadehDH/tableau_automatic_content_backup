  <column caption='Existing / New vendors' datatype='string' hidden='true' name='[Calculation_1578441350215249926]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if (IFNULL([coldstart deno (copy)_1578441350398316554],0)&gt;0  or  datetrunc(&apos;month&apos;,date([first_online_date])) = [month]) then &quot;Newly acquired&quot;&#10;ELSEIF  [Calculation_3297971978521825282] &gt;1 and datetrunc(&apos;month&apos;,date([first_online_date])) &lt; [month] and [is_contracted] = true then &quot;Existing&quot;&#10;else &quot;Existing&quot;&#10;end' />
  </column>
