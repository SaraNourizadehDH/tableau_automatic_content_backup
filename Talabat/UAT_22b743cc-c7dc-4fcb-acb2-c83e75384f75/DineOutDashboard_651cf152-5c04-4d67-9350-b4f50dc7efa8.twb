    <datasource caption='business kpis' inline='true' name='federated.1w5hew51ge1oda1chvm6u1xtaulv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1i5g15n1cc477d16yoce809kph2p'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.thahir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1i5g15n1cc477d16yoce809kph2p' name='Custom SQL Query' type='text'><![CDATA[WITH
  total AS (
  SELECT
    o.order_date,
    o.account_id,
    COUNT(DISTINCT o.order_id) AS total_orders,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.order_id
    END
      ) AS total_orders_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS total_orders_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL THEN o.order_id
    END
      ) AS pro_orders,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.order_id
    END
      ) AS pro_orders_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS pro_orders_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN o.order_id
    END
      ) AS booster_pro_orders,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o. order_id
    END
      ) AS booster_pro_orders_exc_edr,
    COUNT(DISTINCT o.account_id) AS total_users,
    COUNT(DISTINCT
      CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS total_users_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.account_id
    END
      ) AS total_users_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL THEN o.account_id
    END
      ) AS pro_users,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.account_id
    END
      ) AS pro_users_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS pro_users_exc_employees,
    SUM(basket_amount_lc) AS total_basket_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS total_basket_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS total_basket_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(basket_amount_lc,0)
    END
      ) AS pro_basket_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(basket_amount_lc,0)
    END
      ) AS booster_pro_basket_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS pro_basket_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS booster_pro_basket_amount_lc_exc_edr,
    SUM(gmv_amount_lc) AS total_gmv_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS total_gmv_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email not like "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS total_gmv_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_gmv_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_gmv_amount_lc_exc_edr,
    SUM(o.discount_amount_lc) AS total_discount_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS total_discount_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN COALESCE(discount_amount_lc,0)
    END
      ) AS total_discount_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS booster_pro_discount_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_discount_amount_lc_exc_edr,
    SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
    SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc,
    ----------BNPL-------------------
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment THEN o.account_id
    END
      ) AS bnpl_users,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS bnpl_users_exc_employee,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment THEN o.order_id
    END
      ) AS bnpl_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS bnpl_orders_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(basket_amount_lc,0)
    END
      ) AS bnpl_basket_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS bnpl_basket_amount_lc_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS bnpl_gmv_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS bnpl_gmv_amount_lc_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(discount_amount_lc,0)
    END
      ) AS bnpl_discount_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(discount_amount_lc,0)
    END
      ) AS bnpl_discount_amount_lc_exc_employee,

    COUNT(DISTINCT CASE
        WHEN s.account_id IS  NULL THEN o.account_id
    END
      ) AS non_pro_users,
  
       COUNT(DISTINCT CASE
        WHEN s.account_id IS  NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk"  THEN o.account_id
    END
      ) AS non_pro_users_exc_edr,
    
    CASE WHEN b1.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_b1g1,
    COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN o.account_id END) AS b1g1_successful_user,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN o.account_id END) AS b1g1_successful_user_exc_employee,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN o.order_id END) AS b1g1_successful_order,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN o.order_id END) AS b1g1_successful_order_exc_employee,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN gmv_amount_lc END) AS b1g1_successful_gmv,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN gmv_amount_lc END) AS b1g1_successful_gmv_exc_employee,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN discount_amount_lc END) AS b1g1_successful_order_discount,

SUM(coalesce(tdine_waiter_tip_amount_lc,0)) as total_tip_amount_lc,
COUNT(DISTINCT case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then t.order_id end ) as tipped_order_count,
COUNT(DISTINCT case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then o.account_id end ) as tipped_order_user_count,
SUM(case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then coalesce(gmv_amount_lc,0)  end ) as tippped_order_gmv_lc,
SUM(case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then coalesce(discount_amount_lc,0)  end ) as tippped_order_discount_lc,





  FROM
    `tlb-data-prod.data_platform.fct_order_info` AS o
  INNER JOIN
    `tlb-data-prod.data_platform.dim_account` AS a
  ON
    o.account_id=a.account_id
  INNER JOIN
    `tlb-data-prod.data_platform.dim_payment_method` AS p
  ON
    o.payment_method_id = p.payment_method_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  ON
    o.account_id=s.account_id
    AND o.country_code=s.country
    AND o.order_date=s.iso_date
    AND o.order_time BETWEEN start_date
    AND end_date
    AND s.country="AE"
    AND subscription_state<<>> "BILLING RETRY"
    AND o.order_date>>="2024-07-01"
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_vendor_info` AS v
  ON
    o.vendor_id=v.vendor_id
  LEFT JOIN (
    SELECT
      order_id,
      SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
      SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc
    FROM
      `tlb-data-prod.data_platform.fct_tdine_cofunding_discount_order_info` AS co
    WHERE
      is_successful
    GROUP BY
      ALL ) AS co
  ON
    co.order_id=o.order_id
    LEFT JOIN 
         (
         SELECT DISTINCT order_id
         FROM `tlb-data-prod.data_platform.fct_incentive_order_detail`
          WHERE LOWER(campaign_name) LIKE '%dineout-b1%'
         ) AS b1
ON o.order_id = b1.order_id
LEFT JOIN 
     `tlb-data-prod.data_platform.fct_tdine_waiter_tips` AS t
ON o.order_id=t.order_id
WHERE
    o.is_successful
    AND LOWER(delivery_arrangement)="tdine"
    AND o.order_date>>="2024-07-01"
  GROUP BY
    ALL 
)

-- Step 1: total CTE already exists and includes all successful TDINE orders
-- Make sure it includes: account_id, order_date

-- Step 2: Active users by month
, user_monthly_activity AS (
  SELECT DISTINCT
    account_id,
    DATE_TRUNC(order_date, MONTH) AS order_month
  FROM total
)

-- Step 3: First-ever order per user
, first_orders AS (
  SELECT
    account_id,
    MIN(DATE_TRUNC(order_date, MONTH)) AS first_order_month
  FROM total
  GROUP BY account_id
)

-- Step 4: Repeat users = active in current + previous month
, repeat_users AS (
  SELECT
    curr.account_id,
    curr.order_month
  FROM user_monthly_activity curr
  INNER JOIN user_monthly_activity prev
    ON curr.account_id = prev.account_id
    AND curr.order_month = DATE_ADD(prev.order_month, INTERVAL 1 MONTH)
)

-- Step 5: Winback users = active this month, not in previous, but have older history
, winback_users AS (
  SELECT
    ua.account_id,
    ua.order_month
  FROM user_monthly_activity ua
  LEFT JOIN repeat_users r
    ON ua.account_id = r.account_id AND ua.order_month = r.order_month
  LEFT JOIN first_orders f
    ON ua.account_id = f.account_id
  LEFT JOIN user_monthly_activity prev
    ON ua.account_id = prev.account_id
    AND prev.order_month = DATE_SUB(ua.order_month, INTERVAL 1 MONTH)
  WHERE r.account_id IS NULL               -- not repeat
    AND prev.account_id IS NULL            -- not active last month
    AND ua.order_month != f.first_order_month -- not acquisition
)

-- Step 6: Churned users = active last month, not this month
, churned_users AS (
  SELECT
    prev_month.account_id,
    prev_month.order_month AS churn_month
  FROM user_monthly_activity prev_month
  LEFT JOIN user_monthly_activity next_month
    ON prev_month.account_id = next_month.account_id
    AND next_month.order_month = DATE_ADD(prev_month.order_month, INTERVAL 1 MONTH)
  WHERE next_month.account_id IS NULL
)


, monthly_churn_counts AS (
  SELECT
    churn_month AS order_month,
    COUNT(DISTINCT m.account_id) AS churned_user_count
  FROM churned_users as m
  INNER JOIN tlb-data-prod.data_platform.dim_account as a
  ON m.account_id=a.account_id
  where email not like "%talabat.com"
  GROUP BY churn_month
)


-- Step 7: Final monthly aggregation
, monthly_retention_counts AS (
  SELECT
    m.order_month,
    COUNT(DISTINCT CASE WHEN m.order_month = f.first_order_month and email not like "%talabat.com" THEN m.account_id END) AS acquisition_user_count,
    COUNT(DISTINCT case when r.account_id is not null and  email not like "%talabat.com" then r.account_id end) AS repeat_user_count,
    COUNT(DISTINCT case when w.account_id is not null and email not like "%talabat.com"  then w.account_id end ) AS winback_user_count,
    MAX(coalesce(churned_user_count,0)) as churned_user_count,
    COUNT(DISTINCT m.account_id) AS total_active_users
  FROM user_monthly_activity m
  INNER JOIN tlb-data-prod.data_platform.dim_account as a
  ON m.account_id=a.account_id
  LEFT JOIN first_orders f ON m.account_id = f.account_id
  LEFT JOIN repeat_users r ON m.account_id = r.account_id AND m.order_month = r.order_month
  LEFT JOIN winback_users w ON m.account_id = w.account_id AND m.order_month = w.order_month
  LEFT JOIN monthly_churn_counts c ON m.order_month = c.order_month
  GROUP BY m.order_month
)





,
   bnpl_acquisition as 
   
   (

    SELECT
    order_date,
    COUNT(DISTINCT account_id) AS bnpl_acquisition_through_dineout,
  FROM (
    SELECT
      order_date,
      order_id,
      account_id,
      delivery_arrangement,
      vendor_name
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      tlb-data-prod.data_platform.dim_vendor_info AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful = TRUE
      AND o.country_code = "AE"
      and is_bnpl_payment
    QUALIFY ROW_NUMBER() OVER(PARTITION BY account_id ORDER BY order_time) = 1
        )
    where lower(delivery_arrangement)="tdine"
    group by all
      )


,new_to_platform AS (
  SELECT
    order_date,
    COUNT(DISTINCT account_id) AS total_new_to_platform,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS total_new_to_platform_exc_edr
  FROM (
    SELECT
      order_date,
      order_id,
      account_id,
      delivery_arrangement,
      vendor_name
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      tlb-data-prod.data_platform.dim_vendor_info AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful = TRUE
      AND o.country_code = "AE"
    QUALIFY
      ROW_NUMBER() OVER(PARTITION BY account_id ORDER BY order_time) = 1)
  WHERE
    delivery_arrangement = "TDINE"
    AND order_date>>="2024-01-01"
  GROUP BY
    ALL
  ORDER BY
    1 ),


  new_to_dineout AS (
  SELECT
    order_date,
    COUNT(DISTINCT account_id) AS total_new_to_dineout,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS total_new_to_dineout_exc_edr
  FROM (
    SELECT
      account_id,
      order_date,
      order_id,
      vendor_name,
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      `tlb-data-prod.data_platform.dim_vendor_info` AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful
      AND delivery_arrangement="TDINE"
      AND o.country_code="AE"
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY order_time)=1 )
  GROUP BY
    ALL )
    
    
    ,
  pro_acq_date AS (
  SELECT
    account_id,
    MIN(start_date) AS iso_date
  FROM
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  WHERE
    country_code="AE"
    AND subscription_state <<>> "BILLING RETRY"
  GROUP BY
    ALL ),
  pro_user_order_data AS (
  SELECT
    o.account_id,
    order_id,
    order_time,
    delivery_arrangement,
    vendor_name,
    ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY order_time) AS ranked
  FROM (
    SELECT
      account_id
    FROM
      total
    GROUP BY
      ALL ) AS t
  INNER JOIN
    `tlb-data-prod.data_platform.fct_order_info` AS o
  ON
    t.account_id=o.account_id
    AND o.country_code="AE"
    AND is_successful
  INNER JOIN
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  ON
    o.account_id=s.account_id
    AND o.country_code=s.country_code
    AND o.order_date=s.iso_date
    AND o.order_time BETWEEN start_date
    AND end_date
    AND subscription_state<<>>"BILLING RETRY"
    AND o.country_code="AE"
  INNER JOIN
    `tlb-data-prod.data_platform.dim_vendor_info` AS v
  ON
    o.vendor_id=v.vendor_id
  WHERE
    is_successful
    AND subscription_state<<>>"BILLING RETRY"
    AND o.country_code="AE"
  GROUP BY
    ALL ),
  acquisition_to_pro AS (
  SELECT
    DATE(iso_date) AS date,
    COUNT(DISTINCT account_id) AS pro_acquisitions,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name <<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS pro_acquistions_exc_edr
  FROM (
    SELECT
      vendor_name,
      a.account_id,
      iso_date,
      DATE_DIFF(MIN(order_time),iso_date,day) AS days
    FROM
      pro_acq_date AS a
    INNER JOIN (
      SELECT
        account_id,
        vendor_name,
        order_time
      FROM
        pro_user_order_data AS b
      WHERE
        ranked=1
        AND LOWER(delivery_arrangement)="tdine"
      GROUP BY
        ALL ) AS b
    ON
      a.account_id=b.account_id
      AND DATE_TRUNC(iso_date,month)=DATE_TRUNC(DATE(order_time),month)
      AND b.order_time>>=iso_date
    WHERE
      DATE_TRUNC(DATE(iso_date),month)>>="2024-01-01"
    GROUP BY
      ALL )
  GROUP BY
    ALL
  ORDER BY
    1 ),


  daily AS (
  SELECT
    "Daily" AS aggregation,
    t.order_date,
    SUM(total_orders) AS total_order_count,
    SUM(total_orders_exc_edr) AS total_orders_exc_edr,
    SUM(total_orders_exc_employees) AS total_orders_exc_employees,
    SUM(pro_orders) pro_order_count,
    SUM(pro_orders_exc_edr) AS pro_orders_exc_edr,
    SUM(pro_orders_exc_employees) AS pro_orders_exc_employees,
    SUM(booster_pro_orders) AS booster_pro_order_count,
    SUM(booster_pro_orders_exc_edr) AS booster_pro_order_exc_edr_count,
    COUNT(DISTINCT t.account_id) AS total_user_count,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_employees>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN pro_users>>=1 THEN t.account_id
    END
      ) AS pro_user_count,
    COUNT(DISTINCT
      CASE
        WHEN pro_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN pro_orders_exc_employees>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_employees,
    SUM(total_basket_amount_lc) AS total_basket_amount_lc,
    SUM(total_basket_amount_lc_exc_edr) AS total_basket_amount_lc_exc_edr,
    SUM(total_basket_amount_lc_exc_employees) AS total_basket_amount_lc_exc_employees,
    SUM(COALESCE(pro_basket_amount_lc,0)) AS pro_basket_amount_lc,
    SUM(COALESCE(booster_pro_basket_amount_lc,0)) AS booster_pro_basket_amount_lc,
    SUM(pro_basket_amount_lc_exc_edr) AS pro_basket_amount_exc_edr,
    SUM(booster_pro_basket_amount_lc_exc_edr) AS booster_pro_basket_amount_exc_edr,
    SUM(total_gmv_amount_lc) AS total_gmv_amount_lc,
    SUM(total_gmv_amount_lc_exc_edr) AS total_gmv_amount_lc_exc_edr,
    SUM(total_gmv_amount_lc_exc_employees) AS total_gmv_amount_lc_exc_employees,
    SUM(pro_gmv_amount_lc) AS pro_gmv_amount_lc,
    SUM(pro_gmv_amount_lc_exc_edr) AS pro_gmv_amount_lc_exc_edr,
    SUM(booster_pro_gmv_amount_lc) AS booster_pro_gmv_amount_lc,
    SUM(booster_pro_gmv_amount_lc_exc_edr) AS booster_pro_gmv_amount_lc_exc_edr,
    SUM(total_discount_amount_lc) AS total_discount_amount_lc,
    SUM(total_discount_amount_lc_exc_employees) AS total_discount_amount_lc_exc_employees,
    SUM(total_discount_amount_lc_exc_edr) AS total_discount_amount_lc_exc_edr,
    SUM(pro_discount_amount_lc) AS pro_discount_amount_lc,
    SUM(pro_discount_amount_lc_exc_employees) AS pro_discount_amount_lc_exc_employees,
    SUM(pro_discount_amount_lc_exc_edr) AS pro_discount_amount_lc_exc_edr,
    SUM(booster_pro_discount_amount_lc) AS booster_pro_discount_amount_lc,
    SUM(booster_pro_discount_amount_lc_exc_edr) AS booster_pro_discount_amount_lc_exc_edr,
    SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
    SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc,
    SUM( bnpl_orders) AS bnpl_orders,
    SUM( bnpl_orders_exc_employee) AS bnpl_orders_exc_employee,
    SUM( bnpl_basket_amount_lc) AS bnpl_basket_amount_lc,
    SUM(bnpl_basket_amount_lc_exc_employee) AS bnpl_basket_amount_lc_exc_employee,
    SUM( bnpl_gmv_amount_lc) AS bnpl_gmv_amount_lc,
    SUM(bnpl_gmv_amount_lc_exc_employee) AS bnpl_gmv_amount_lc_exc_employee,
    SUM(bnpl_discount_amount_lc) AS bnpl_discount_amount_lc,
    SUM(bnpl_discount_amount_lc_exc_employee) AS bnpl_discount_amount_lc_exc_employee,
    COUNT(distinct case when non_pro_users>>=1 then t.account_id end) as non_tpro_user_count,
    COUNT(distinct case when non_pro_users_exc_edr>>=1 then t.account_id end) as non_tpro_user_exc_edr_count,
    SUM(b1g1_successful_order) AS b1g1_successful_order,
 SUM(b1g1_successful_order_exc_employee) AS b1g1_successful_order_exc_employee,
 SUM(b1g1_successful_gmv) AS b1g1_successful_gmv,
 SUM(b1g1_successful_gmv_exc_employee) AS b1g1_successful_gmv_exc_employee,
 SUM(b1g1_successful_order_discount) AS b1g1_successful_order_discount,
 SUM(total_tip_amount_lc) as total_tipped_amount_lc,
 SUM(tipped_order_count) as tipped_order_count,
 SUM(tipped_order_user_count) as tipped_order_user_count,
 SUM(tippped_order_gmv_lc) as tippped_order_gmv_lc,
 SUM(tippped_order_discount_lc) as tippped_order_discount_lc

  FROM
    total t
  GROUP BY
    ALL ),



  monthly AS (
  SELECT
    "Monthly" AS aggregation,
    DATE_TRUNC(t.order_date,month) AS month,
    SUM(total_orders) AS total_order_count,
    SUM(total_orders_exc_edr) AS total_orders_exc_edr,
    SUM(total_orders_exc_employees) AS total_orders_exc_employees,
    SUM(pro_orders) pro_order_count,
    SUM(pro_orders_exc_edr) AS pro_orders_exc_edr,
    SUM(pro_orders_exc_employees) AS pro_orders_exc_employees,
    SUM(booster_pro_orders) AS booster_pro_order_count,
    SUM(booster_pro_orders_exc_edr) AS booster_pro_order_exc_edr_count,
    COUNT(DISTINCT t.account_id) AS total_user_count,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_employees>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN pro_users>>=1 THEN t.account_id
    END
      ) AS pro_user_count,
    COUNT(DISTINCT
      CASE
        WHEN pro_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN pro_orders_exc_employees>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_employees,
    SUM(total_basket_amount_lc) AS total_basket_amount_lc,
    SUM(total_basket_amount_lc_exc_edr) AS total_basket_amount_lc_exc_edr,
    SUM(total_basket_amount_lc_exc_employees) AS total_basket_amount_lc_exc_employees,
    SUM(COALESCE(pro_basket_amount_lc,0)) AS pro_basket_amount_lc,
    SUM(COALESCE(booster_pro_basket_amount_lc,0)) AS booster_pro_basket_amount_lc,
    SUM(pro_basket_amount_lc_exc_edr) AS pro_basket_amount_exc_edr,
    SUM(booster_pro_basket_amount_lc_exc_edr) AS booster_pro_basket_amount_exc_edr,
    SUM(total_gmv_amount_lc) AS total_gmv_amount_lc,
    SUM(total_gmv_amount_lc_exc_edr) AS total_gmv_amount_lc_exc_edr,
    SUM(total_gmv_amount_lc_exc_employees) AS total_gmv_amount_lc_exc_employees,
    SUM(pro_gmv_amount_lc) AS pro_gmv_amount_lc,
    SUM(pro_gmv_amount_lc_exc_edr) AS pro_gmv_amount_lc_exc_edr,
    SUM(booster_pro_gmv_amount_lc) AS booster_pro_gmv_amount_lc,
    SUM(booster_pro_gmv_amount_lc_exc_edr) AS booster_pro_gmv_amount_lc_exc_edr,
    SUM(total_discount_amount_lc) AS total_discount_amount_lc,
    SUM(total_discount_amount_lc_exc_employees) AS total_discount_amount_lc_exc_employees,
    SUM(total_discount_amount_lc_exc_edr) AS total_discount_amount_lc_exc_edr,
    SUM(pro_discount_amount_lc) AS pro_discount_amount_lc,
    SUM(pro_discount_amount_lc_exc_employees) AS pro_discount_amount_lc_exc_employees,
    SUM(pro_discount_amount_lc_exc_edr) AS pro_discount_amount_lc_exc_edr,
    SUM(booster_pro_discount_amount_lc) AS booster_pro_discount_amount_lc,
    SUM(booster_pro_discount_amount_lc_exc_edr) AS booster_pro_discount_amount_lc_exc_edr,
    SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
    SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc,
    SUM( bnpl_orders) AS bnpl_orders,
    SUM( bnpl_orders_exc_employee) AS bnpl_orders_exc_employee,
    SUM( bnpl_basket_amount_lc) AS bnpl_basket_amount_lc,
    SUM(bnpl_basket_amount_lc_exc_employee) AS bnpl_basket_amount_lc_exc_employee,
    SUM( bnpl_gmv_amount_lc) AS bnpl_gmv_amount_lc,
    SUM(bnpl_gmv_amount_lc_exc_employee) AS bnpl_gmv_amount_lc_exc_employee,
    SUM(bnpl_discount_amount_lc) AS bnpl_discount_amount_lc,
    SUM(bnpl_discount_amount_lc_exc_employee) AS bnpl_discount_amount_lc_exc_employee,
    COUNT(distinct case when non_pro_users>>=1 then t.account_id end) as non_tpro_user_count,
    COUNT(distinct case when non_pro_users_exc_edr>>=1 then t.account_id end) as non_tpro_user_exc_edr_count,
        SUM(b1g1_successful_order) AS b1g1_successful_order,
  SUM(b1g1_successful_order_exc_employee) AS b1g1_successful_order_exc_employee,
  SUM(b1g1_successful_gmv) AS b1g1_successful_gmv,
  SUM(b1g1_successful_gmv_exc_employee) AS b1g1_successful_gmv_exc_employee,
  SUM(b1g1_successful_order_discount) AS b1g1_successful_order_discount,
  SUM(total_tip_amount_lc) as total_tipped_amount_lc,
  SUM(tipped_order_count) as tipped_order_count,
  SUM(tipped_order_user_count) as tipped_order_user_count,
  SUM(tippped_order_gmv_lc) as tippped_order_gmv_lc,
  SUM(tippped_order_discount_lc) as tippped_order_discount_lc


  FROM
    total AS t
    
  GROUP BY
    ALL ),



  
weekly AS (
  SELECT
    "Weekly" AS aggregation,
    DATE_TRUNC(t.order_date,week(monday)) AS week,
    SUM(total_orders) AS total_order_count,
    SUM(total_orders_exc_edr) AS total_orders_exc_edr,
    SUM(total_orders_exc_employees) AS total_orders_exc_employees,
    SUM(pro_orders) pro_order_count,
    SUM(pro_orders_exc_edr) AS pro_orders_exc_edr,
    SUM(pro_orders_exc_edr) AS pro_orders_exc_employees,
    SUM(booster_pro_orders) AS booster_pro_order_count,
    SUM(booster_pro_orders_exc_edr) AS booster_pro_order_exc_edr_count,
    COUNT(DISTINCT t.account_id) AS total_user_count,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN t.total_users_exc_employees>>=1 THEN t.account_id
    END
      ) AS total_user_count_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN pro_users>>=1 THEN t.account_id
    END
      ) AS pro_user_count,
    COUNT(DISTINCT
      CASE
        WHEN pro_users_exc_edr>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN pro_orders_exc_employees>>=1 THEN t.account_id
    END
      ) AS pro_user_count_exc_employees,
    SUM(total_basket_amount_lc) AS total_basket_amount_lc,
    SUM(total_basket_amount_lc_exc_edr) AS total_basket_amount_lc_exc_edr,
    SUM(total_basket_amount_lc_exc_employees) AS total_basket_amount_lc_exc_employees,
    SUM(COALESCE(pro_basket_amount_lc,0)) AS pro_basket_amount_lc,
    SUM(COALESCE(booster_pro_basket_amount_lc,0)) AS booster_pro_basket_amount_lc,
    SUM(pro_basket_amount_lc_exc_edr) AS pro_basket_amount_exc_edr,
    SUM(booster_pro_basket_amount_lc_exc_edr) AS booster_pro_basket_amount_exc_edr,
    SUM(total_gmv_amount_lc) AS total_gmv_amount_lc,
    SUM(total_gmv_amount_lc_exc_edr) AS total_gmv_amount_lc_exc_edr,
    SUM(total_gmv_amount_lc_exc_employees) AS total_gmv_amount_lc_exc_employees,
    SUM(pro_gmv_amount_lc) AS pro_gmv_amount_lc,
    SUM(pro_gmv_amount_lc_exc_edr) AS pro_gmv_amount_lc_exc_edr,
    SUM(booster_pro_gmv_amount_lc) AS booster_pro_gmv_amount_lc,
    SUM(booster_pro_gmv_amount_lc_exc_edr) AS booster_pro_gmv_amount_lc_exc_edr,
    SUM(total_discount_amount_lc) AS total_discount_amount_lc,
    SUM(total_discount_amount_lc_exc_employees) AS total_discount_amount_lc_exc_employees,
    SUM(total_discount_amount_lc_exc_edr) AS total_discount_amount_lc_exc_edr,
    SUM(pro_discount_amount_lc) AS pro_discount_amount_lc,
    SUM(pro_discount_amount_lc_exc_employees) AS pro_discount_amount_lc_exc_employees,
    SUM(pro_discount_amount_lc_exc_edr) AS pro_discount_amount_lc_exc_edr,
    SUM(booster_pro_discount_amount_lc) AS booster_pro_discount_amount_lc,
    SUM(booster_pro_discount_amount_lc_exc_edr) AS booster_pro_discount_amount_lc_exc_edr,
    SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
    SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc,
    SUM( bnpl_orders) AS bnpl_orders,
    SUM( bnpl_orders_exc_employee) AS bnpl_orders_exc_employee,
    SUM( bnpl_basket_amount_lc) AS bnpl_basket_amount_lc,
    SUM(bnpl_basket_amount_lc_exc_employee) AS bnpl_basket_amount_lc_exc_employee,
    SUM( bnpl_gmv_amount_lc) AS bnpl_gmv_amount_lc,
    SUM(bnpl_gmv_amount_lc_exc_employee) AS bnpl_gmv_amount_lc_exc_employee,
    SUM(bnpl_discount_amount_lc) AS bnpl_discount_amount_lc,
    SUM(bnpl_discount_amount_lc_exc_employee) AS bnpl_discount_amount_lc_exc_employee,
    COUNT(distinct case when non_pro_users>>=1 then t.account_id end) as non_tpro_user_count,
    COUNT(distinct case when non_pro_users_exc_edr>>=1 then t.account_id end) as non_tpro_user_exc_edr_count,
        SUM(b1g1_successful_order) AS b1g1_successful_order,
    SUM(b1g1_successful_order_exc_employee) AS b1g1_successful_order_exc_employee,
    SUM(b1g1_successful_gmv) AS b1g1_successful_gmv,
    SUM(b1g1_successful_gmv_exc_employee) AS b1g1_successful_gmv_exc_employee,
    SUM(b1g1_successful_order_discount) AS b1g1_successful_order_discount,
    SUM(total_tip_amount_lc) as total_tipped_amount_lc,
    SUM(tipped_order_count) as tipped_order_count,
    SUM(tipped_order_user_count) as tipped_order_user_count,
    SUM(tippped_order_gmv_lc) as tippped_order_gmv_lc,
    SUM(tippped_order_discount_lc) as tippped_order_discount_lc


  FROM
    total AS t
  GROUP BY
    ALL )


SELECT
  d.*,
  SUM(total_new_to_platform) AS total_new_to_platform,
  SUM(total_new_to_platform_exc_edr) AS total_new_to_platform_exc_edr,
  SUM(total_new_to_dineout) AS total_new_to_dineout,
  SUM(total_new_to_dineout_exc_edr) AS total_new_to_dineout_exc_edr,
  SUM(pro_acquisitions) AS pro_acquisitions,
  SUM(pro_acquistions_exc_edr) AS pro_acquisitions_exc_edr,
  sum( bnpl_acquisition_through_dineout) as  bnpl_acquisition,
  0 AS repeat_user_count,                      
  0 AS winback_user_count,
  0 as acquisition_user_count,
  0 as churn_user_count

  
FROM
  daily AS d
LEFT JOIN
  new_to_dineout AS ntdo
ON
  d.order_date=ntdo.order_date
LEFT JOIN
  new_to_platform AS ntp
ON
  d.order_date=ntp.order_date
LEFT JOIN
  acquisition_to_pro atp
ON
  d.order_date=atp.date

LEFT JOIN bnpl_acquisition as ba
on d.order_date=ba.order_date
GROUP BY
  ALL
UNION ALL
SELECT
  m.*,
  total_new_to_platform,
  total_new_to_platform_exc_edr,
  total_new_to_dineout,
  total_new_to_dineout_exc_edr,
  pro_acquisitions,
  pro_acquisitions_exc_edr,
  bnpl_acquisition_through_dineout as  bnpl_acquisition,
  cOALESCE(rw.repeat_user_count, 0) AS repeat_user_count,
COALESCE(rw.winback_user_count, 0) AS winback_user_count,
COALESCE(rw.acquisition_user_count, 0) AS acquisition__user_count,
COALESCE(rw.churned_user_count, 0) AS churned_user_count
FROM
  monthly AS m
LEFT JOIN (
  SELECT
    DATE_TRUNC(ntdo.order_date,month) month,
    SUM(total_new_to_dineout) AS total_new_to_dineout,
    SUM(total_new_to_dineout_exc_edr) AS total_new_to_dineout_exc_edr
  FROM
    new_to_dineout AS ntdo
  GROUP BY
    ALL ) ntdo
ON
  m.month=ntdo.month
LEFT JOIN (
  SELECT
    DATE_TRUNC(ntp.order_date,month) month,
    SUM(total_new_to_platform) AS total_new_to_platform,
    SUM(total_new_to_platform_exc_edr) AS total_new_to_platform_exc_edr
  FROM
    new_to_platform AS ntp
  GROUP BY
    ALL ) ntp
ON
  m.month=ntp.month
LEFT JOIN (
  SELECT
    DATE_TRUNC(date,month) month,
    SUM(pro_acquisitions) AS pro_acquisitions,
    SUM(pro_acquistions_exc_edr) AS pro_acquisitions_exc_edr
  FROM
    acquisition_to_pro atp
  GROUP BY
    ALL ) atp
ON
  m.month=atp.month

  LEFT JOIN monthly_retention_counts rw
  ON m.month = rw.order_month


  LEFT JOIN (
  SELECT
    DATE_TRUNC(order_date,month) month,
    SUM(bnpl_acquisition_through_dineout) AS bnpl_acquisition_through_dineout
    
  FROM
   bnpl_acquisition
  GROUP BY
    ALL ) ba
  on m.month=ba.month
  ---where m.month="2024-10-01"
GROUP BY
  ALL
UNION ALL
SELECT
  w.*,
  total_new_to_platform,
  total_new_to_platform_exc_edr,
  total_new_to_dineout,
  total_new_to_dineout_exc_edr,
  pro_acquisitions,
  pro_acquisitions_exc_edr,
  bnpl_acquisition_through_dineout,
  0 AS repeat_user_count,                      
  0 AS winback_user_count,
  0 as acquisition_user_count,
  0 as churned_user_count
FROM
  weekly AS w
LEFT JOIN (
  SELECT
    DATE_TRUNC(ntdo.order_date,week(monday)) week,
    SUM(total_new_to_dineout) AS total_new_to_dineout,
    SUM(total_new_to_dineout_exc_edr) AS total_new_to_dineout_exc_edr
  FROM
    new_to_dineout AS ntdo
  GROUP BY
    ALL ) ntdo
ON
  w.week=ntdo.week
LEFT JOIN (
  SELECT
    DATE_TRUNC(ntp.order_date,week(monday)) week,
    SUM(total_new_to_platform) AS total_new_to_platform,
    SUM(total_new_to_platform_exc_edr) AS total_new_to_platform_exc_edr
  FROM
    new_to_platform AS ntp
  GROUP BY
    ALL ) ntp
ON
  w.week=ntp.week
LEFT JOIN (
  SELECT
    DATE_TRUNC(date,week(monday)) week,
    SUM(pro_acquisitions) AS pro_acquisitions,
    SUM(pro_acquistions_exc_edr) AS pro_acquisitions_exc_edr
  FROM
    acquisition_to_pro atp
  GROUP BY
    ALL ) atp
ON
  w.week=atp.week

  LEFT JOIN (
  SELECT
    DATE_TRUNC(order_date,week(monday)) week,
    SUM(bnpl_acquisition_through_dineout) AS bnpl_acquisition_through_dineout
    
  FROM
   bnpl_acquisition
  GROUP BY
    ALL ) ba
  on w.week=ba.week]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1i5g15n1cc477d16yoce809kph2p' name='Custom SQL Query' type='text'><![CDATA[WITH
  total AS (
  SELECT
    o.order_date,
    o.account_id,
    COUNT(DISTINCT o.order_id) AS total_orders,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.order_id
    END
      ) AS total_orders_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS total_orders_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL THEN o.order_id
    END
      ) AS pro_orders,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.order_id
    END
      ) AS pro_orders_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS pro_orders_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN o.order_id
    END
      ) AS booster_pro_orders,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o. order_id
    END
      ) AS booster_pro_orders_exc_edr,
    COUNT(DISTINCT o.account_id) AS total_users,
    COUNT(DISTINCT
      CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS total_users_exc_employees,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.account_id
    END
      ) AS total_users_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL THEN o.account_id
    END
      ) AS pro_users,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN o.account_id
    END
      ) AS pro_users_exc_edr,
    COUNT(DISTINCT
      CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS pro_users_exc_employees,
    SUM(basket_amount_lc) AS total_basket_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS total_basket_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS total_basket_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(basket_amount_lc,0)
    END
      ) AS pro_basket_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(basket_amount_lc,0)
    END
      ) AS booster_pro_basket_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS pro_basket_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS booster_pro_basket_amount_lc_exc_edr,
    SUM(gmv_amount_lc) AS total_gmv_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS total_gmv_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email not like "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS total_gmv_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_gmv_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS pro_gmv_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_gmv_amount_lc_exc_edr,
    SUM(o.discount_amount_lc) AS total_discount_amount_lc,
    SUM(CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS total_discount_amount_lc_exc_edr,
    SUM(CASE
        WHEN a.email NOT LIKE "%talabat.com" THEN COALESCE(discount_amount_lc,0)
    END
      ) AS total_discount_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc_exc_employees,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS booster_pro_discount_amount_lc,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(o.discount_amount_lc,0)
    END
      ) AS pro_discount_amount_lc_exc_edr,
    SUM(CASE
        WHEN s.account_id IS NOT NULL AND has_tpro_booster AND vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS booster_pro_discount_amount_lc_exc_edr,
    SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
    SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc,
    ----------BNPL-------------------
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment THEN o.account_id
    END
      ) AS bnpl_users,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN o.account_id
    END
      ) AS bnpl_users_exc_employee,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment THEN o.order_id
    END
      ) AS bnpl_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN o.order_id
    END
      ) AS bnpl_orders_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(basket_amount_lc,0)
    END
      ) AS bnpl_basket_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(basket_amount_lc,0)
    END
      ) AS bnpl_basket_amount_lc_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS bnpl_gmv_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(gmv_amount_lc,0)
    END
      ) AS bnpl_gmv_amount_lc_exc_employee,
    SUM(CASE
        WHEN is_bnpl_payment THEN COALESCE(discount_amount_lc,0)
    END
      ) AS bnpl_discount_amount_lc,
    SUM(CASE
        WHEN is_bnpl_payment AND a.email NOT LIKE "%talabat.com" THEN COALESCE(discount_amount_lc,0)
    END
      ) AS bnpl_discount_amount_lc_exc_employee,

    COUNT(DISTINCT CASE
        WHEN s.account_id IS  NULL THEN o.account_id
    END
      ) AS non_pro_users,
  
       COUNT(DISTINCT CASE
        WHEN s.account_id IS  NULL AND vendor_name<<>>"Everyday Roastery Coffee, City Walk"  THEN o.account_id
    END
      ) AS non_pro_users_exc_edr,
    
    CASE WHEN b1.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_b1g1,
    COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN o.account_id END) AS b1g1_successful_user,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN o.account_id END) AS b1g1_successful_user_exc_employee,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN o.order_id END) AS b1g1_successful_order,
COUNT(DISTINCT CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN o.order_id END) AS b1g1_successful_order_exc_employee,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN gmv_amount_lc END) AS b1g1_successful_gmv,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful AND a.email NOT LIKE '%talabat.com' THEN gmv_amount_lc END) AS b1g1_successful_gmv_exc_employee,
SUM(CASE WHEN b1.order_id IS NOT NULL AND o.is_successful THEN discount_amount_lc END) AS b1g1_successful_order_discount,

SUM(coalesce(tdine_waiter_tip_amount_lc,0)) as total_tip_amount_lc,
COUNT(DISTINCT case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then t.order_id end ) as tipped_order_count,
COUNT(DISTINCT case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then o.account_id end ) as tipped_order_user_count,
SUM(case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then coalesce(gmv_amount_lc,0)  end ) as tippped_order_gmv_lc,
SUM(case when coalesce(tdine_waiter_tip_amount_lc,0)>>0 then coalesce(discount_amount_lc,0)  end ) as tippped_order_discount_lc,





  FROM
    `tlb-data-prod.data_platform.fct_order_info` AS o
  INNER JOIN
    `tlb-data-prod.data_platform.dim_account` AS a
  ON
    o.account_id=a.account_id
  INNER JOIN
    `tlb-data-prod.data_platform.dim_payment_method` AS p
  ON
    o.payment_method_id = p.payment_method_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  ON
    o.account_id=s.account_id
    AND o.country_code=s.country
    AND o.order_date=s.iso_date
    AND o.order_time BETWEEN start_date
    AND end_date
    AND s.country="AE"
    AND subscription_state<<>> "BILLING RETRY"
    AND o.order_date>>="2024-07-01"
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_vendor_info` AS v
  ON
    o.vendor_id=v.vendor_id
  LEFT JOIN (
    SELECT
      order_id,
      SUM(tdine_tpro_cofunding_platform_amount_lc) AS tdine_tpro_cofunding_platform_amount_lc,
      SUM(tdine_tpro_cofunding_vendor_amount_lc) AS tdine_tpro_cofunding_vendor_amount_lc
    FROM
      `tlb-data-prod.data_platform.fct_tdine_cofunding_discount_order_info` AS co
    WHERE
      is_successful
    GROUP BY
      ALL ) AS co
  ON
    co.order_id=o.order_id
    LEFT JOIN 
         (
         SELECT DISTINCT order_id
         FROM `tlb-data-prod.data_platform.fct_incentive_order_detail`
          WHERE LOWER(campaign_name) LIKE '%dineout-b1%'
         ) AS b1
ON o.order_id = b1.order_id
LEFT JOIN 
     `tlb-data-prod.data_platform.fct_tdine_waiter_tips` AS t
ON o.order_id=t.order_id
WHERE
    o.is_successful
    AND LOWER(delivery_arrangement)="tdine"
    AND o.order_date>>="2024-07-01"
  GROUP BY
    ALL 
)

-- Step 1: total CTE already exists and includes all successful TDINE orders
-- Make sure it includes: account_id, order_date

-- Step 2: Active users by month
, user_monthly_activity AS (
  SELECT DISTINCT
    account_id,
    DATE_TRUNC(order_date, MONTH) AS order_month
  FROM total
)

-- Step 3: First-ever order per user
, first_orders AS (
  SELECT
    account_id,
    MIN(DATE_TRUNC(order_date, MONTH)) AS first_order_month
  FROM total
  GROUP BY account_id
)

-- Step 4: Repeat users = active in current + previous month
, repeat_users AS (
  SELECT
    curr.account_id,
    curr.order_month
  FROM user_monthly_activity curr
  INNER JOIN user_monthly_activity prev
    ON curr.account_id = prev.account_id
    AND curr.order_month = DATE_ADD(prev.order_month, INTERVAL 1 MONTH)
)

-- Step 5: Winback users = active this month, not in previous, but have older history
, winback_users AS (
  SELECT
    ua.account_id,
    ua.order_month
  FROM user_monthly_activity ua
  LEFT JOIN repeat_users r
    ON ua.account_id = r.account_id AND ua.order_month = r.order_month
  LEFT JOIN first_orders f
    ON ua.account_id = f.account_id
  LEFT JOIN user_monthly_activity prev
    ON ua.account_id = prev.account_id
    AND prev.order_month = DATE_SUB(ua.order_month, INTERVAL 1 MONTH)
  WHERE r.account_id IS NULL               -- not repeat
    AND prev.account_id IS NULL            -- not active last month
    AND ua.order_month != f.first_order_month -- not acquisition
)

-- Step 6: Churned users = active last month, not this month
, churned_users AS (
  SELECT
    prev_month.account_id,
    prev_month.order_month AS churn_month
  FROM user_monthly_activity prev_month
  LEFT JOIN user_monthly_activity next_month
    ON prev_month.account_id = next_month.account_id
    AND next_month.order_month = DATE_ADD(prev_month.order_month, INTERVAL 1 MONTH)
  WHERE next_month.account_id IS NULL
)


, monthly_churn_counts AS (
  SELECT
    churn_month AS order_month,
    COUNT(DISTINCT m.account_id) AS churned_user_count
  FROM churned_users as m
  INNER JOIN tlb-data-prod.data_platform.dim_account as a
  ON m.account_id=a.account_id
  where email not like "%talabat.com"
  GROUP BY churn_month
)


-- Step 7: Final monthly aggregation
, monthly_retention_counts AS (
  SELECT
    m.order_month,
    COUNT(DISTINCT CASE WHEN m.order_month = f.first_order_month and email not like "%talabat.com" THEN m.account_id END) AS acquisition_user_count,
    COUNT(DISTINCT case when r.account_id is not null and  email not like "%talabat.com" then r.account_id end) AS repeat_user_count,
    COUNT(DISTINCT case when w.account_id is not null and email not like "%talabat.com"  then w.account_id end ) AS winback_user_count,
    MAX(coalesce(churned_user_count,0)) as churned_user_count,
    COUNT(DISTINCT m.account_id) AS total_active_users
  FROM user_monthly_activity m
  INNER JOIN tlb-data-prod.data_platform.dim_account as a
  ON m.account_id=a.account_id
  LEFT JOIN first_orders f ON m.account_id = f.account_id
  LEFT JOIN repeat_users r ON m.account_id = r.account_id AND m.order_month = r.order_month
  LEFT JOIN winback_users w ON m.account_id = w.account_id AND m.order_month = w.order_month
  LEFT JOIN monthly_churn_counts c ON m.order_month = c.order_month
  GROUP BY m.order_month
)





,
   bnpl_acquisition as 
   
   (

    SELECT
    order_date,
    COUNT(DISTINCT account_id) AS bnpl_acquisition_through_dineout,
  FROM (
    SELECT
      order_date,
      order_id,
      account_id,
      delivery_arrangement,
      vendor_name
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      tlb-data-prod.data_platform.dim_vendor_info AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful = TRUE
      AND o.country_code = "AE"
      and is_bnpl_payment
    QUALIFY ROW_NUMBER() OVER(PARTITION BY account_id ORDER BY order_time) = 1
        )
    where lower(delivery_arrangement)="tdine"
    group by all
      )


,new_to_platform AS (
  SELECT
    order_date,
    COUNT(DISTINCT account_id) AS total_new_to_platform,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS total_new_to_platform_exc_edr
  FROM (
    SELECT
      order_date,
      order_id,
      account_id,
      delivery_arrangement,
      vendor_name
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      tlb-data-prod.data_platform.dim_vendor_info AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful = TRUE
      AND o.country_code = "AE"
    QUALIFY
      ROW_NUMBER() OVER(PARTITION BY account_id ORDER BY order_time) = 1)
  WHERE
    delivery_arrangement = "TDINE"
    AND order_date>>="2024-01-01"
  GROUP BY
    ALL
  ORDER BY
    1 ),


  new_to_dineout AS (
  SELECT
    order_date,
    COUNT(DISTINCT account_id) AS total_new_to_dineout,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name<<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS total_new_to_dineout_exc_edr
  FROM (
    SELECT
      account_id,
      order_date,
      order_id,
      vendor_name,
    FROM
      `tlb-data-prod.data_platform.fct_order_info` AS o
    INNER JOIN
      `tlb-data-prod.data_platform.dim_vendor_info` AS v
    ON
      o.vendor_id=v.vendor_id
    WHERE
      is_successful
      AND delivery_arrangement="TDINE"
      AND o.country_code="AE"
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY order_time)=1 )
  GROUP BY
    ALL )
    
    
    ,
  pro_acq_date AS (
  SELECT
    account_id,
    MIN(start_date) AS iso_date
  FROM
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  WHERE
    country_code="AE"
    AND subscription_state <<>> "BILLING RETRY"
  GROUP BY
    ALL ),
  pro_user_order_data AS (
  SELECT
    o.account_id,
    order_id,
    order_time,
    delivery_arrangement,
    vendor_name,
    ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY order_time) AS ranked
  FROM (
    SELECT
      account_id
    FROM
      total
    GROUP BY
      ALL ) AS t
  INNER JOIN
    `tlb-data-prod.data_platform.fct_order_info` AS o
  ON
    t.account_id=o.account_id
    AND o.country_code="AE"
    AND is_successful
  INNER JOIN
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
  ON
    o.account_id=s.account_id
    AND o.country_code=s.country_code
    AND o.order_date=s.iso_date
    AND o.order_time BETWEEN start_date
    AND end_date
    AND subscription_state<<>>"BILLING RETRY"
    AND o.country_code="AE"
  INNER JOIN
    `tlb-data-prod.data_platform.dim_vendor_info` AS v
  ON
    o.vendor_id=v.vendor_id
  WHERE
    is_successful
    AND subscription_state<<>>"BILLING RETRY"
    AND o.country_code="AE"
  GROUP BY
    ALL ),
  acquisition_to_pro AS (
  SELECT
    DATE(iso_date) AS date,
    COUNT(DISTINCT account_id) AS pro_acquisitions,
    COUNT(DISTINCT
      CASE
        WHEN vendor_name <<>>"Everyday Roastery Coffee, City Walk" THEN account_id
    END
      ) AS pro_acquistions_exc_edr
  FROM (
    SELECT
      vendor_name,
      a.account_id,
      iso_date,
      DATE_DIFF(MIN(order_time),iso_date,day) AS days
    FROM
      pro_acq_date AS a
    INNER JOIN (
      SELECT
        account_id,
        vendor_name,
        order_time
      FROM
        pro_user_order_data AS b
      WHERE
        ranked=1
        AND LOWER(delivery_arrangement)="tdine"
      GROUP BY
        ALL ) AS b
    ON
      a.account_id=b.account_id
      AND DATE_TRUNC(iso_date,month)=DATE_TRUNC(DATE(order_time),month)
      AND b.order_time>>=iso_date
    WHERE
      DATE_TRUNC(DATE(iso_date),month)>>="2024-01-01"
    GROUP BY
      ALL )
  GROUP BY
    ALL
  ORDER BY
    1 ),


  daily AS (
  SELECT
    "Daily" AS aggregation,
    t.order_date,
    SUM(total_orders) AS total_order_count,
    SUM(total_orders_exc_edr) AS total_orders_exc_edr,
    SUM(total_orders_exc_employees) AS total_orders_exc_employees,
    SUM(pro_orders) pro_order_count,
    SUM(pro_orders_exc_edr) AS pro_orders_exc_edr,
