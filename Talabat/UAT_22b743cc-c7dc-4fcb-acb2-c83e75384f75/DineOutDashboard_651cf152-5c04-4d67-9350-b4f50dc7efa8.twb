      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E1C09DF91D474F0589924A1913DA6CE2'>
            <properties context=''>
              <relation connection='bigquery.1ie3r0l0wsijdh1erilp604wje4q' name='Custom SQL Query' type='text'><![CDATA[with customers as 
(
select account_id,dv.vendor_name,fi.order_time,fi.gmv_amount_lc as gmv, fi.discount_amount_lc as discount_availed,dp.payment_method
from `tlb-data-prod.data_platform.fct_order_info` fi 
inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
on fi.vendor_id = dv.vendor_id 
inner join `tlb-data-prod.data_platform.dim_payment_method` dp 
on dp.payment_method_id = fi.payment_method_id
where country_iso = 'AE'
and delivery_arrangement ='TDINE'
and is_successful 
and email not like "%talabat.com"
group by all 
qualify row_number()over(partition by account_id order by order_time asc )  = 1
)
,pre_order_customers as 
(
select date_trunc(date(cu.order_time),month) as month
       ,cu.account_id 
       ,count(distinct fi.order_id ) as orders
       ,sum(coalesce(fi.gmv_amount_lc,0)) as pre_gmv
        ,coalesce(count(distinct case when (coalesce(incentive_amount_lc,0) + coalesce(discount_amount_lc,0)+coalesce(voucher_discount_amount_lc,0)+coalesce(gem_discount_amount_lc,0)) >>0  then fi.order_id end )/nullif(count(distinct fi.order_id),0),0) as pre_discounted_orders
from  customers cu 
left join `tlb-data-prod.data_platform.fct_order_info` fi 
on cu.account_id = fi.account_id 
and fi.order_date between date_add(date(cu.order_time),interval -30 day ) and date_add(date(cu.order_time),interval -1 day )
and fi.is_successful
and fi.country_iso = 'AE'
--and delivery_arrangement = 'TDINE'
where 
--cu.vendor_name <<>>"Everyday Roastery Coffee, City Walk" 
--and
 date(cu.order_time)>>= '2024-07-01' 
group by all
)


,post_orders_customers as 
(
select cu.account_id 
      ,count(distinct fi.order_id ) as post_orders
      ,sum(coalesce(fi.gmv_amount_lc,0)) as post_gmv
      ,coalesce(count(distinct case when (coalesce(incentive_amount_lc,0) + coalesce(discount_amount_lc,0)+coalesce(voucher_discount_amount_lc,0)+coalesce(gem_discount_amount_lc,0)) >>0  then fi.order_id end )
      /nullif(count(distinct fi.order_id),0),0) as post_discounted_share
      ,count(distinct case when delivery_arrangement = 'TDINE' then fi.order_id end) as dineout_orders
      ,sum( case when delivery_arrangement = 'TDINE' then fi.gmv_amount_lc end) as dineout_gmv
from  customers cu 
left join `tlb-data-prod.data_platform.fct_order_info` fi 
on cu.account_id = fi.account_id 
and fi.order_date between date_add(date(cu.order_time),interval 1 day ) and date_add(date(cu.order_time),interval 30 day )
and fi.is_successful
and fi.country_iso = 'AE'
where 
date(cu.order_time)>>= '2024-08-01' 
group by all
)
select 
month,
CASE
                    when po.orders = 0 then '0.Inactive'
                    WHEN po.orders = 1 THEN "1. 1st Timers"
                    WHEN po.orders BETWEEN 2 AND 3 THEN "2. Low"
                    WHEN po.orders BETWEEN 4 AND 8 THEN "3. Mid"
                    WHEN po.orders >>= 9 THEN "4. High"
                END as segment
      ,count(distinct po.account_id ) as customers
      ,sum(po.orders) as pre_orders
      ,avg(pre_discounted_orders) as avg_discounted_order_share
      ,avg(post_discounted_share) as avg_post_discounted_orders
      ,sum(pt.post_orders) as post_orders
      ,sum(pt.post_orders-pt.dineout_orders) as post_orders_excl_dineout
      ,sum(pre_gmv) as pre_gmv
      ,sum(post_gmv) as post_gmv
      ,sum(post_gmv - dineout_gmv)as post_gmv_excl_dineout
      ,count(distinct case when pt.dineout_orders>>0 then pt.account_id end ) as post_dineout_users
from pre_order_customers po
left join post_orders_customers  pt
on po.account_id = pt.account_id 
--where pt.dineout_orders>>0
group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='cuisine' inline='true' name='federated.0nmaxyt0y78klz10w0hul03kv9ro' version='18.1'>
      <connection class='federated'>
        <named-connections>
