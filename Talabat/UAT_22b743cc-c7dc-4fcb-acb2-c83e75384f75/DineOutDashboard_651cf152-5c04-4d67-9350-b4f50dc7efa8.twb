      </column>
      <column caption='AOV - GMV/Orders -  overall' datatype='real' name='[AOV - exc EDR (copy 2)_5870160683800739843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_gmv_amount_lc])/&#10;SUM([total_order_count])' />
      </column>
      <column caption='AOV - exc EDR (copy)' datatype='real' name='[AOV - exc EDR (copy)_5870160683800252417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_gmv_amount_lc_exc_edr])/&#10;SUM([total_orders_exc_edr])' />
      </column>
      <column caption='% Booster order by tPro Users' datatype='real' name='[Calculation_2096355299097526272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([booster_pro_order_exc_edr_count])/SUM([pro_orders_exc_edr])' />
      </column>
      <column caption='value' datatype='integer' datatype-customized='true' name='[Calculation_2096355299133206534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(case [Parameters].[Parameter 1] when       &#10;&quot;Total Orders&quot; then [total_order_count] &#10;when &quot;Total Order exc EDR&quot; then [total_orders_exc_edr]&#10;when &quot;Total Order exc employees&quot; then [total_orders_exc_employees]&#10;when &quot;Total GMV (lc)&quot; then [total_gmv_amount_lc]&#10;when &quot;tPro User GMV (lc)&quot; then [pro_gmv_amount_lc]&#10;when &quot;Total Discount (lc)&quot; then [total_discount_amount_lc]&#10;when &quot;tPro User Discount (lc)&quot; then [pro_discount_amount_lc]&#10;&#10;when &quot;Platform Acquisitions&quot; then [total_new_to_platform]&#10;when &quot;tPro Acquisitions&quot; then [pro_acquisitions]&#10;WHEN &quot;DineOut Acquisitions&quot; then [total_new_to_dineout]&#10;WHEN &quot;Total Users&quot; then [total_user_count]&#10;when &quot;Total Users exc employees&quot; then [total_user_count_exc_employees]&#10;when &quot;B1G1 Orders&quot; then [b1g1_successful_order]&#10;when &quot;B1G1 Orders exc employees&quot; then [b1g1_successful_order_exc_employee]&#10;when &quot;B1G1 GMV&quot; then [b1g1_successful_gmv]&#10;when &quot;B1G1 GMV exc employees&quot; then [b1g1_successful_gmv_exc_employee]&#10;when &quot;% Users non employees&quot; then ([total_user_count_exc_employees]/[total_user_count])*100&#10;&#10;END)' />
      </column>
      <column caption='color' datatype='string' name='[Calculation_2096355299165351943]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF INDEX()&lt;=3 THEN &quot;Dark Red&quot;&#10; ELSEIF INDEX() = 4 THEN &quot;Red&quot;&#10; ELSEIF INDEX() = 5 THEN &quot;Yellow&quot;&#10; ELSE &quot;Green&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Discount of Basket Amount - overall' datatype='real' name='[Calculation_4063865389460774912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_discount_amount_lc])/&#10;SUM([total_basket_amount_lc])' />
      </column>
      <column caption='% non - employee users' datatype='real' name='[Calculation_4063865389471985665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_user_count_exc_employees])/SUM([total_user_count])' />
      </column>
      <column caption='Order Frequency - exc edr' datatype='real' name='[Calculation_4063865389474398210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders_exc_edr])/SUM([total_user_count_exc_edr])' />
      </column>
      <column caption='AOV - exc EDR' datatype='real' name='[Calculation_4063865389474795523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_gmv_amount_lc_exc_edr])/&#10;SUM([total_orders_exc_edr])' />
      </column>
      <column caption='% BNPL orders - exc employee' datatype='real' name='[Calculation_4306778305811480576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bnpl_orders_exc_employee])/SUM([total_orders_exc_employees])' />
      </column>
      <column caption='Orders' datatype='string' name='[Calculation_4364902873539178496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Empty ' datatype='integer' name='[Calculation_4364902873541193730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='% tPro Users -exc employee' datatype='real' name='[Calculation_4364902873542647814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_user_count_exc_employees])/SUM([total_user_count_exc_employees])' />
      </column>
      <column caption='% repeat users of total active' datatype='real' name='[Calculation_5094978567494443008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[repeat_user_count]/[total_user_count_exc_employees]' />
