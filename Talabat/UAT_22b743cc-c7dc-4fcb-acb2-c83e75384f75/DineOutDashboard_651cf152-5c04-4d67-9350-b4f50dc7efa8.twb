    <worksheet name='acquisition seg (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Pre &amp; Post DineOut Acquisition</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='acquisitionseg2' path='/t/Talabat/workbooks/DineOutDashboard' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='prepost' name='federated.07al2jw1x966m911es8q91aro9ue' />
          </datasources>
          <datasource-dependencies datasource='federated.07al2jw1x966m911es8q91aro9ue'>
            <column caption='Pre Order Frequency' datatype='real' name='[Calculation_4426405168354570248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pre_orders])/SUM([customers])' />
            </column>
            <column caption='Change in Order Frequency' datatype='real' name='[Calculation_4426405168355418122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Pre Order Frequency (copy)_4426405168354766857]-[Calculation_4426405168354570248])&#10;/([Calculation_4426405168354570248])' />
            </column>
            <column caption='Change in GMV' datatype='real' name='[Change in Order Frequency (copy)_4426405168373633037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([post_gmv]-[pre_gmv])&#10;/([pre_gmv])' />
            </column>
            <column caption='Post Order(exc DineOut orders) Frequency' datatype='real' name='[Post Order Frequency (copy)_4426405168372449292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([post_orders_excl_dineout])/SUM([customers])' />
            </column>
            <column caption='Post Order Frequency' datatype='real' name='[Pre Order Frequency (copy)_4426405168354766857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([post_orders])/SUM([customers])' />
            </column>
            <column datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[post_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[post_gmv_excl_dineout]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_orders_excl_dineout]' role='measure' type='quantitative' />
            <column datatype='real' name='[pre_gmv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pre_orders]' role='measure' type='quantitative' />
