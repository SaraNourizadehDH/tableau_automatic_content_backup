      <table>
        <view>
          <datasources>
            <datasource caption='business kpis' name='federated.1w5hew51ge1oda1chvm6u1xtaulv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Orders&quot;'>
              <calculation class='tableau' formula='&quot;Total Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5hew51ge1oda1chvm6u1xtaulv'>
            <column caption='value' datatype='integer' datatype-customized='true' name='[Calculation_2096355299133206534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(case [Parameters].[Parameter 1] when       &#10;&quot;Total Orders&quot; then [total_order_count] &#10;when &quot;Total Order exc EDR&quot; then [total_orders_exc_edr]&#10;when &quot;Total Order exc employees&quot; then [total_orders_exc_employees]&#10;when &quot;Total GMV (lc)&quot; then [total_gmv_amount_lc]&#10;when &quot;tPro User GMV (lc)&quot; then [pro_gmv_amount_lc]&#10;when &quot;Total Discount (lc)&quot; then [total_discount_amount_lc]&#10;when &quot;tPro User Discount (lc)&quot; then [pro_discount_amount_lc]&#10;&#10;when &quot;Platform Acquisitions&quot; then [total_new_to_platform]&#10;when &quot;tPro Acquisitions&quot; then [pro_acquisitions]&#10;WHEN &quot;DineOut Acquisitions&quot; then [total_new_to_dineout]&#10;WHEN &quot;Total Users&quot; then [total_user_count]&#10;when &quot;Total Users exc employees&quot; then [total_user_count_exc_employees]&#10;when &quot;B1G1 Orders&quot; then [b1g1_successful_order]&#10;when &quot;B1G1 Orders exc employees&quot; then [b1g1_successful_order_exc_employee]&#10;when &quot;B1G1 GMV&quot; then [b1g1_successful_gmv]&#10;when &quot;B1G1 GMV exc employees&quot; then [b1g1_successful_gmv_exc_employee]&#10;when &quot;% Users non employees&quot; then ([total_user_count_exc_employees]/[total_user_count])*100&#10;&#10;END)' />
            </column>
            <column datatype='string' name='[aggregation]' role='dimension' type='nominal' />
            <column datatype='real' name='[b1g1_successful_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[b1g1_successful_gmv_exc_employee]' role='measure' type='quantitative' />
            <column datatype='integer' name='[b1g1_successful_order]' role='measure' type='quantitative' />
            <column datatype='integer' name='[b1g1_successful_order_exc_employee]' role='measure' type='quantitative' />
            <column-instance column='[aggregation]' derivation='None' name='[none:aggregation:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[pro_acquisitions]' role='measure' type='quantitative' />
            <column datatype='real' name='[pro_discount_amount_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[pro_gmv_amount_lc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2096355299133206534]' derivation='Sum' name='[sum:Calculation_2096355299133206534:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Day-Trunc' name='[tdy:order_date:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[total_discount_amount_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_gmv_amount_lc]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_new_to_dineout]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_new_to_platform]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders_exc_edr]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders_exc_employees]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_user_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_user_count_exc_employees]' role='measure' type='quantitative' />
