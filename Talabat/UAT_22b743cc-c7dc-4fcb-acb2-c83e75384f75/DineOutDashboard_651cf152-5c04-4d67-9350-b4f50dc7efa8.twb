    <datasource caption='tPro savings' inline='true' name='federated.1cp0cvo0gma2oz1fy5t650qiguls' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0frob1z1jnhpak16qj9f61dqxj2w'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.thahir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0frob1z1jnhpak16qj9f61dqxj2w' name='Custom SQL Query' type='text'><![CDATA[----savings pro customers
with pro as (

 select
  
   date_trunc(order_date,month) as month,
   o.account_id,
   max(case when  lower(delivery_arrangement)='tdine' then 1 else 0 end) as tag,
  SUM(COALESCE(tpro_discount_lc, 0)) +
  SUM(CASE WHEN lower(delivery_arrangement)<<>>'tdine' then COALESCE(tpro_BOOSTER_DISCOUNT_amount_LC,0) else 0 END) +
  SUM(CASE WHEN lower(delivery_arrangement)<<>>'tdine' then COALESCE(tpro_exclusive_deal_discount_amount_LC,0) else 0 END) +
  SUM(CASE WHEN lower(delivery_arrangement)='tdine' then COALESCE(discount_amount_lc,0) else 0 END) AS total_savings

 from
 tlb-data-prod.data_platform.fct_order_info as o
 inner join tlb-data-prod.data_platform.fct_tpro_subscriber_daily as sd
 on o.account_id=sd.account_id
 and o.country_code=sd.country_code
 and o.order_date=sd.iso_date
 and order_time between start_date and end_date
 and country="AE"
 and subscription_state <<>> "BILLING RETRY"
 where date_trunc(order_date,month)>>="2025-01-01"
 and o.country_code="AE"
 and is_successful
 and date_trunc(order_date,month)>>="2025-01-01"
 group by all
)



