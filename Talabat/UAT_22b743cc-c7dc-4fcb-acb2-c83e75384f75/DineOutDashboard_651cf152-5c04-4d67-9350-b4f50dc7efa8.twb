        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ezev6g13qs148116e7ya0rnhv39' name='Custom SQL Query' type='text'><![CDATA[select
 main_cuisine,
 area_name,
 count(distinct v.vendor_id) as total_vendor_count,
 count(distinct case when is_dineout then v.vendor_id end) as total_dineout_vendor_count,
 count(distinct order_id) as total_orders,
 sum(coalesce(basket_amount_lc,0)) as total_basket_amount,
 count(distinct case when lower(delivery_arrangement)="tdine" then order_id end ) as total_orders_dineout,
 count(distinct case when lower(delivery_arrangement)="tdine" and vendor_name <<>>"Everyday Roastery Coffee, City Walk" then order_id end) as total_orders_dineout_exc_edr,
 sum( case when lower(delivery_arrangement)="tdine" then coalesce(basket_amount_lc,0) end ) as total_basket_dineout,
sum( case when lower(delivery_arrangement)="tdine" and vendor_name <<>>"Everyday Roastery Coffee, City Walk"then coalesce(basket_amount_lc,0) end ) as total_basket_dineout_exc_edr

 from
 tlb-data-prod.data_platform.dim_vendor_info as v
 inner join tlb-data-prod.data_platform.dim_chain as c
 on v.chain_id=c.chain_id
 inner join tlb-data-prod.data_platform.dim_location as l
 on v.location_id=l.location_id
 left join tlb-data-prod.data_platform.fct_order_info as o
 on v.vendor_id=o.vendor_id
 and is_successful
 and o.country_code="AE"
 --and lower(delivery_arrangement)="tdine"
 --where is_dineout
where is_active
 group by all
  order by 2 desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ezev6g13qs148116e7ya0rnhv39' name='Custom SQL Query' type='text'><![CDATA[select
