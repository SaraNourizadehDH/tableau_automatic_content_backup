    <worksheet name='main table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>  Main KPIS</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='maintable' path='/t/Talabat/workbooks/DineOutDashboard' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='business kpis' name='federated.1w5hew51ge1oda1chvm6u1xtaulv' />
          </datasources>
          <datasource-dependencies datasource='federated.1w5hew51ge1oda1chvm6u1xtaulv'>
            <column caption='% acq users' datatype='real' name='[%  churn users of total active   (copy)_964966603587862530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisition_user_count]/[total_user_count_exc_employees]' />
            </column>
            <column caption='% winbacks users of total active ' datatype='real' name='[% repeat users of total active (copy)_5094978567494758401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[winback_user_count]/[total_user_count_exc_employees]' />
            </column>
            <column caption='% tPro Orders - exc employees' datatype='real' name='[% tPro Users  (copy)_4364902873549168647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_orders_exc_employees])/SUM([total_orders_exc_employees])' />
            </column>
            <column caption='% tPro GMV' datatype='real' name='[% tPro Users  (copy)_4364902873549418504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_gmv_amount_lc])/SUM([total_gmv_amount_lc])' />
            </column>
            <column caption='%  churn users of total active  ' datatype='real' name='[% winbacks users of total active  (copy)_964966603586293760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE MONTH([order_date]) when MONTH(TODAY())&#10;then null else &#10;[churn_user_count]/[total_user_count_exc_employees] END' />
            </column>
            <column caption='AOV - GMV/Orders -  overall' datatype='real' name='[AOV - exc EDR (copy 2)_5870160683800739843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gmv_amount_lc])/&#10;SUM([total_order_count])' />
            </column>
            <column caption='% Discount of Basket Amount - overall' datatype='real' name='[Calculation_4063865389460774912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_discount_amount_lc])/&#10;SUM([total_basket_amount_lc])' />
            </column>
            <column caption='% non - employee users' datatype='real' name='[Calculation_4063865389471985665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_user_count_exc_employees])/SUM([total_user_count])' />
            </column>
            <column caption='Order Frequency - exc edr' datatype='real' name='[Calculation_4063865389474398210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_exc_edr])/SUM([total_user_count_exc_edr])' />
            </column>
            <column caption='AOV - exc EDR' datatype='real' name='[Calculation_4063865389474795523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gmv_amount_lc_exc_edr])/&#10;SUM([total_orders_exc_edr])' />
            </column>
            <column caption='% BNPL orders - exc employee' datatype='real' name='[Calculation_4306778305811480576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bnpl_orders_exc_employee])/SUM([total_orders_exc_employees])' />
            </column>
            <column caption='Empty ' datatype='integer' name='[Calculation_4364902873541193730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='% tPro Users -exc employee' datatype='real' name='[Calculation_4364902873542647814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_user_count_exc_employees])/SUM([total_user_count_exc_employees])' />
            </column>
            <column caption='% repeat users of total active' datatype='real' name='[Calculation_5094978567494443008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[repeat_user_count]/[total_user_count_exc_employees]' />
            </column>
            <column caption='% tipped order count' datatype='real' name='[Calculation_5317273458242613251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tipped_order_count]/[total_order_count]' />
            </column>
            <column caption='Average Tipped Amount' datatype='real' name='[Calculation_5317273458243010564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_tipped_amount_lc]/[tipped_order_count]' />
            </column>
            <column caption='% tip amount of basket' datatype='real' name='[Calculation_5317273458243465221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_tipped_amount_lc]/([tippped_order_gmv_lc]+[tippped_order_discount_lc])' />
            </column>
            <column caption='null' datatype='integer' name='[Calculation_5317273458244018183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='tPro Discount per User - Overall' datatype='real' name='[Calculation_5870160683799642112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pro_discount_amount_lc])/SUM([pro_user_count])' />
            </column>
            <column caption='Basket Amount per Order' datatype='real' name='[Calculation_5870160683800399874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_basket_amount_lc])/SUM([total_order_count])' />
            </column>
            <column caption='churn users exc employees' datatype='integer' name='[Calculation_964966603586859009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case  MONTH([order_date]) WHEN MONTH(TODAY())&#10;then null&#10;else [churn_user_count] END' />
