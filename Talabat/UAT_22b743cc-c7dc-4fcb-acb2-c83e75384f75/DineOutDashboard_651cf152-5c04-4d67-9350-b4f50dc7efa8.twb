        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1jijqxn1bwl6eo10np55p0v6soxr' name='Custom SQL Query' type='text'>with du as (
select 
date_trunc(order_date,month) as month,
fi.account_id,
max(case when delivery_arrangement =&apos;TDINE&apos; and a.email not like &quot;%talabat.com&quot; then 1 else 0 end) as dineout_flag
 from `tlb-data-prod.data_platform.fct_order_info` fi 
 inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
 on fi.vendor_id = dv.vendor_id 
 inner join tlb-data-prod.data_platform.dim_chain as c
 on dv.chain_id=c.chain_id
 inner join `tlb-data-prod.data_platform.dim_payment_method` dp 
 on dp.payment_method_id = fi.payment_method_id
 inner join tlb-data-prod.data_platform.dim_account as a
 on fi.account_id=a.account_id
where country_iso = &apos;AE&apos;
and is_successful 
group by all
)
select 
  du.month,
  case when dineout_flag=1 then &quot;DineOut User&quot; else &quot;Platform User&quot; end as user_type,
  main_cuisine,
  count(distinct case when  lower(delivery_arrangement) not in (&quot;tdine&quot;) then a.account_id end) as delivery_users,
  count(distinct case when  lower(delivery_arrangement) in (&quot;tdine&quot;) then a.account_id end) as tdine_users,

from du inner join 
(
        SELECT 
            date_trunc(order_date,month) as month,
            ord.account_id,
            main_cuisine,
            delivery_arrangement,
            COUNT(order_id) AS orders
        FROM tlb-data-prod.data_platform.fct_order_info ord
        INNER join tlb-data-prod.data_platform.dim_vendor_info as v
        on ord.vendor_id=v.vendor_id
        INNER JOIN tlb-data-prod.data_platform.dim_chain as c
        ON ord.chain_id = c.chain_id
        WHERE is_successful 
        AND lower(vendor_name) not like &quot;everyday roastary%&quot;
        AND order_date &gt;&gt;= date_add(DATE_TRUNC(current_date,month), interval -5 MONTH)
        and v.is_non_food is false
        and ord.country_code=&quot;AE&quot;
        group by all
        

) a 
on du.account_id=a.account_id
and du.month=a.month
group by all order by 1 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
