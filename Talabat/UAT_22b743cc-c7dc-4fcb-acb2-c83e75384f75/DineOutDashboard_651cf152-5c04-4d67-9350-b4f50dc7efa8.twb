      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0u6vi0q1yp57id1dfcaav1f6jahy].[sum:total_session_tile_clicked:qk]&quot;' value='Total Sessions - tile' />
          <alias key='&quot;[federated.0u6vi0q1yp57id1dfcaav1f6jahy].[sum:total_sessions:qk]&quot;' value='Total Sessions' />
          <alias key='&quot;[federated.0u6vi0q1yp57id1dfcaav1f6jahy].[sum:total_users:qk]&quot;' value='Total DineOut ' />
          <alias key='&quot;[federated.0u6vi0q1yp57id1dfcaav1f6jahy].[sum:yalla_sessions_combined:qk]&quot;' value='Total Sessions - Yalla' />
        </aliases>
      </column>
      <column caption='date &lt; current date' datatype='boolean' name='[Calculation_4664884789359116288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date]&lt; TODAY()' />
      </column>
      <column caption='link 3' datatype='string' name='[Calculation_5317273458249814025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Acquisition Attribution&quot;' />
      </column>
      <column caption='tile session' datatype='integer' name='[Calculation_537758011357388809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [entry_point] IN (&#10;&#10;    &quot;Home vertical launcher&quot;&#10;) THEN [entry_point_clicked]&#10;&#10;END' />
      </column>
      <column caption='% sessions Yalla' datatype='real' name='[Calculation_537758011653337103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yalla_sessions_combined])/SUM([total_sessions])' />
      </column>
      <column caption='Overall Sessions' datatype='integer' name='[Calculation_6647242696306147328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [entry_point] IN (&#10;    &quot;CRM&quot;,&#10;    &quot;food tpro collaboration&quot;,&#10;    &quot;home bento banner&quot;,&#10;    &quot;home tpro collaboration&quot;,&#10;    &quot;Home vertical launcher&quot;,&#10;    &quot;Order Tracking Banner&quot;,&#10;    &quot;Yalla explore&quot;&#10;) THEN [entry_point_clicked]&#10;&#10;ELSEIF ISNULL([entry_point]) THEN [collection_loaded] &#10;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='tile sessions %' datatype='real' name='[Calculation_6647242696306528257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [entry_point] IN (&#10;    &#10;    &quot;Home vertical launcher&quot;,&#10;&#10;) THEN [entry_point_clicked]&#10;&#10;END&#10;)/ SUM([Calculation_6647242696306147328])' />
      </column>
      <column caption='yalla session %' datatype='real' name='[Calculation_6647242696315736067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [entry_point] IN (&#10;    &#10;    &quot;Yalla explore&quot;,&#10;&#10;) THEN [entry_point_clicked]&#10;&#10;END&#10;)/ SUM([Calculation_6647242696306147328])' />
      </column>
      <column caption='Click %' datatype='real' name='[Calculation_6647242696337838086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([entry_point_clicked])/SUM([entry_point_loaded])' />
      </column>
      <column caption='Successful Order %' datatype='real' name='[Calculation_6647242696338128903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order])/SUM([attempted_place_order])' />
      </column>
      <column caption='total sessions' datatype='integer' name='[Overall Sessions (copy 2)_6647242696382541836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [entry_point] IN (&#10;    &quot;All&quot;&#10;) THEN [tdine_visit_count]&#10;&#10;&#10;END' />
      </column>
      <column caption='Overall Sessions (copy)' datatype='integer' name='[Overall Sessions (copy)_6647242696382324747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [entry_point] IN (&#10;    &quot;CRM&quot;,&#10;    &quot;food tpro collaboration&quot;,&#10;    &quot;home bento banner&quot;,&#10;    &quot;home tpro collaboration&quot;,&#10;    &quot;Home vertical launcher&quot;,&#10;    &quot;Order Tracking Banner&quot;,&#10;    &quot;Yalla explore&quot;&#10;) THEN [entry_point_clicked]&#10;&#10;&#10;END' />
      </column>
