      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[:Measure Names]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;[federated.07al2jw1x966m911es8q91aro9ue].[pcto:sum:customers:qk]&quot;</bucket>
