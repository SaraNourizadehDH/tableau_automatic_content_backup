      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4A3F2B21E3F3460F87D68EFB1B83EC80'>
            <properties context=''>
              <relation connection='bigquery.0kdbn301lyg0cu12ze9oa137mnrs' name='Custom SQL Query' type='text'><![CDATA[-- Lifetime DineOut user counts
SELECT
  -- Lifetime DineOut Users
  COUNT(DISTINCT o.account_id) AS lifetime_dineout_users,
  COUNT(DISTINCT CASE 
    WHEN a.email NOT LIKE "%talabat.com" THEN o.account_id 
  END) AS lifetime_dineout_users_exc_employees,

  -- Lifetime DineOut TPro Users
  COUNT(DISTINCT CASE 
    WHEN s.account_id IS NOT NULL THEN s.account_id 
  END) AS lifetime_dineout_tpro_users,

  COUNT(DISTINCT CASE 
    WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN s.account_id 
  END) AS lifetime_dineout_tpro_users_exc_employees,

  -- Total TPro Users as of Today (from subscriber table directly)
  (
    SELECT COUNT(DISTINCT account_id)
    FROM `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`
    WHERE iso_date = CURRENT_DATE -1 
      AND country = "AE"
      AND subscription_state <<>> "BILLING RETRY"
  ) AS total_tpro_users_today

FROM `tlb-data-prod.data_platform.fct_order_info` o

INNER JOIN `tlb-data-prod.data_platform.dim_account` a
  ON o.account_id = a.account_id

LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` s
  ON o.account_id = s.account_id
  AND o.order_date = s.iso_date
  AND o.country_code = s.country
  AND o.order_time BETWEEN s.start_date AND s.end_date
  AND s.country = "AE"
  AND s.subscription_state <<>> "BILLING RETRY"

WHERE o.is_successful
  AND LOWER(o.delivery_arrangement) = "tdine"
  AND o.country_code = "AE"]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
