      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_516D41A2F7B94A89B9C61EAC1D93E528'>
            <properties context=''>
              <relation connection='bigquery.0iyguw1021u0ik15x8c3z18e3lei' name='Custom SQL Query' type='text'>with du as (
select 
date_trunc(order_date,month) as month,
fi.account_id,
max(case when delivery_arrangement =&apos;TDINE&apos; and a.email not like &quot;%talabat.com&quot; then 1 else 0 end) as dineout_flag
 from `tlb-data-prod.data_platform.fct_order_info` fi 
 inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
 on fi.vendor_id = dv.vendor_id 
 inner join tlb-data-prod.data_platform.dim_chain as c
 on dv.chain_id=c.chain_id
 inner join `tlb-data-prod.data_platform.dim_payment_method` dp 
 on dp.payment_method_id = fi.payment_method_id
 inner join tlb-data-prod.data_platform.dim_account as a
 on fi.account_id=a.account_id
where country_iso = &apos;AE&apos;
--and delivery_arrangement =&apos;TDINE&apos;
and is_successful 
group by all
)
select

  most_ordered_area,
  case when dineout_flag=1 then &quot;DineOut User&quot; else &quot;Platform User&quot; end as user_type,
  count(distinct a.account_id) as users

from du inner join 
(
        SELECT
            account_id,
            area_name AS most_ordered_area,
            COUNT(order_id) AS orders
        FROM tlb-data-prod.data_platform.fct_order_info ord
            INNER JOIN tlb-data-prod.data_platform.dim_location_info loc ON ord.delivery_location_id = loc.location_id
        WHERE is_successful AND order_date &gt;&gt;= date_add(DATE_TRUNC(current_date,month), interval -5 MONTH)
        and lower(delivery_arrangement) not in (&quot;pickup&quot;,&quot;tdine&quot;)
        and ord.country_code=&quot;AE&quot;
        GROUP BY all
        QUALIFY ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY orders DESC) = 1

) a 
on du.account_id=a.account_id
group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='distance in orders' inline='true' name='federated.1b43d3t17rc9d1155kv0j1gduvhc' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1kcp6670w9e8jf1675fr90uwxw2b'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.thahir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kcp6670w9e8jf1675fr90uwxw2b' name='Custom SQL Query' type='text'><![CDATA[with dineout_orders as 
(
select 
   fi.order_id,
   fi.account_id,
  ST_X(location) AS longitude,
  ST_Y(location) AS latitude
 from `tlb-data-prod.data_platform.fct_order_info` fi 
 inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
 on fi.vendor_id = dv.vendor_id 
 inner join tlb-data-prod.data_platform.dim_chain as c
 on dv.chain_id=c.chain_id
 inner join `tlb-data-prod.data_platform.dim_payment_method` dp 
 on dp.payment_method_id = fi.payment_method_id
 inner join tlb-data-prod.data_platform.dim_account as a
 on fi.account_id=a.account_id
where country_iso = 'AE'
and delivery_arrangement ='TDINE'
and is_successful 
and a.email not like "%talabat.com"

group by all
)
,most_orderded_locations as 
(
select
a.account_id ,ST_Y(fi.customer_selected_location) AS latitude, ST_X(fi.customer_selected_location) AS longitude,count(distinct order_id) as orders
from (select account_id from dineout_orders group by account_id ) a 
inner join `tlb-data-prod.data_platform.fct_order_info` fi 
on a.account_id = fi.account_id 
and fi.country_iso = 'AE'
and fi.is_successful 
and fi.order_date >>='2024-05-01'
and fi.delivery_arrangement not in ('TDINE','PICKUP')
group by all
--QUALIFY ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY orders DESC)=1
)

select case when distance_km <<=1 then "Less than 1KM"
            when distance_km<<=2 then "Less than 2KM"
            when distance_km<<=3 then "Less than 3KM"
            when distance_km<<=4 then "Less than 4KM"
            when distance_km<<=5 then "Less than 5KM"
            when distance_km<<=6 then "Less than 6KM"
            when distance_km<<=7 then "Less than 7KM"
            when distance_km<<=8 then "Less than 8KM"
            else ">>8KM"
            end
            as distance_km, count(distinct order_id) as orders
from (

select d.order_id,d.account_id,min(ST_DISTANCE(
        ST_GEOGPOINT(d.longitude, d.latitude),
        ST_GEOGPOINT(cd.longitude, cd.latitude) ) / 1000 )AS distance_km
from  dineout_orders d
inner join most_orderded_locations cd
on  d.account_id = cd.account_id 
group by all order by 1
) group by all order by 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1kcp6670w9e8jf1675fr90uwxw2b' name='Custom SQL Query' type='text'><![CDATA[with dineout_orders as 
