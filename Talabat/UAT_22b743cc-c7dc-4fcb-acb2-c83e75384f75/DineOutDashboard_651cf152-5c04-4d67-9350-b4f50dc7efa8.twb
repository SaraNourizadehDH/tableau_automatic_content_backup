    <worksheet name='monthly tpro x dineout'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <repository-location id='monthlytproxdineout' path='/t/Talabat/workbooks/DineOutDashboard' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='monthly tPro' name='federated.1e06q5s1iscq671b7d8431w6pqc4' />
          </datasources>
          <datasource-dependencies datasource='federated.1e06q5s1iscq671b7d8431w6pqc4'>
            <column caption='% tPro Adoption' datatype='real' name='[Calculation_4735957242797469696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_tpro_dineout_user])/SUM([active_tpro_users])' />
            </column>
            <column caption='Dubai and Abu Dhabi tPro base' datatype='integer' name='[Calculation_5119889115246657536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [city_name] when   &quot;Dubai&quot;&#10;     &#10;     then [active_tpro_users]&#10;&#10;WHEN   &quot;Abu Dhabi&quot; &#10;then [active_tpro_users]&#10;&#10;END' />
            </column>
            <column caption='% tPro adoption (Dubai Abu Dhabi)' datatype='real' name='[Calculation_5119889115247415297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_tpro_dineout_user])/SUM([Calculation_5119889115246657536])' />
            </column>
            <column datatype='integer' name='[active_tpro_dineout_user]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_tpro_users]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[month]' derivation='Month' name='[mn:month:ok]' pivot='key' type='ordinal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5119889115246657536]' derivation='Sum' name='[sum:Calculation_5119889115246657536:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_tpro_dineout_user]' derivation='Sum' name='[sum:active_tpro_dineout_user:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_tpro_users]' derivation='Sum' name='[sum:active_tpro_users:qk]' pivot='key' type='quantitative' />
