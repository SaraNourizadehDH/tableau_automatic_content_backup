      <datasource-dependencies datasource='Parameters'>
        <column caption='Segment' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Segment&quot;'>
          <calculation class='tableau' formula='&quot;Order Segment&quot;' />
          <aliases>
            <alias key='&quot;Incentive Segment&quot;' value='Discount Segment' />
          </aliases>
