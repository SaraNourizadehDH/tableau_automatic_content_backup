                <zone forceUpdate='true' h='7453' id='58' type-v2='text' w='66583' x='667' y='6853'>
                  <formatted-text>
                    <run bold='true'>Note :</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>1. Yalla tracking issues</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='13'> till 16th April</run>
                    <run bold='true' fontcolor='#1b1b1b'> - entry point could not be correctly determined</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>2.CRM contribution is less than expected as deeplink event trigger is not getting captured.Issue fixed mid May.</run>
