      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E4FB6EE7C02E4202932848ED9731BBD0'>
            <properties context=''>
              <relation connection='bigquery.12fv5yl1mo49ym1ava3sg0oq997x' name='Custom SQL Query' type='text'><![CDATA[WITH users AS (
  SELECT
    DATE_TRUNC(order_date, MONTH) AS month,
    o.account_id,
    COUNT(DISTINCT o.account_id) AS active_tpro_users,
    COUNT(DISTINCT CASE WHEN LOWER(delivery_arrangement) = 'tdine' THEN o.account_id END) AS active_tpro_dineout_user
  FROM `tlb-data-prod.data_platform.fct_order_info` AS o
  INNER JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` AS s
    ON o.account_id = s.account_id
    AND o.order_date = s.iso_date
    AND o.order_time BETWEEN s.start_date AND s.end_date
    AND o.country_code = s.country
  WHERE 
    s.country = 'AE'
    AND s.subscription_state <<>> 'BILLING RETRY'
    AND o.is_successful
    AND o.order_date >>= '2025-01-01'
  GROUP BY 1, 2
),

most_ordered_city AS (
  SELECT
    u.month,
    o.account_id,
    l.city_name,
    COUNT(DISTINCT o.order_id) AS orders,
    RANK() OVER (
      PARTITION BY u.month, o.account_id
      ORDER BY COUNT(DISTINCT o.order_id) DESC, l.city_name
    ) AS rnk
  FROM users AS u
  JOIN `tlb-data-prod.data_platform.fct_order_info` AS o
    ON u.account_id = o.account_id
    AND date_trunc(o.order_date,month) BETWEEN DATE_SUB(u.month, INTERVAL 2 MONTH) AND u.month
  JOIN `tlb-data-prod.data_platform.dim_location_info` AS l
    ON o.delivery_area_id = l.area_id
  WHERE 
    o.is_successful
    AND o.country_iso = 'AE'
  GROUP BY u.month, o.account_id, l.city_name
  QUALIFY rnk = 1
)

SELECT
  u.month,
  COALESCE(m.city_name, 'Unknown') AS city_name,
  SUM(u.active_tpro_users) AS active_tpro_users,
  SUM(u.active_tpro_dineout_user) AS active_tpro_dineout_user
FROM users u
LEFT JOIN most_ordered_city m
  ON u.account_id = m.account_id
  AND u.month = m.month
WHERE u.month >>= '2025-01-01'
GROUP BY 1, 2
ORDER BY 1, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='lifetime customers' inline='true' name='federated.1hei03z1dfsrne162ytzf08pq33n' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0kdbn301lyg0cu12ze9oa137mnrs'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.thahir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0kdbn301lyg0cu12ze9oa137mnrs' name='Custom SQL Query' type='text'><![CDATA[-- Lifetime DineOut user counts
SELECT
  -- Lifetime DineOut Users
  COUNT(DISTINCT o.account_id) AS lifetime_dineout_users,
  COUNT(DISTINCT CASE 
    WHEN a.email NOT LIKE "%talabat.com" THEN o.account_id 
  END) AS lifetime_dineout_users_exc_employees,

  -- Lifetime DineOut TPro Users
  COUNT(DISTINCT CASE 
    WHEN s.account_id IS NOT NULL THEN s.account_id 
  END) AS lifetime_dineout_tpro_users,

  COUNT(DISTINCT CASE 
    WHEN s.account_id IS NOT NULL AND a.email NOT LIKE "%talabat.com" THEN s.account_id 
  END) AS lifetime_dineout_tpro_users_exc_employees,

  -- Total TPro Users as of Today (from subscriber table directly)
  (
    SELECT COUNT(DISTINCT account_id)
    FROM `tlb-data-prod.data_platform.fct_tpro_subscriber_daily`
    WHERE iso_date = CURRENT_DATE -1 
      AND country = "AE"
      AND subscription_state <<>> "BILLING RETRY"
  ) AS total_tpro_users_today

FROM `tlb-data-prod.data_platform.fct_order_info` o

INNER JOIN `tlb-data-prod.data_platform.dim_account` a
  ON o.account_id = a.account_id

LEFT JOIN `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` s
  ON o.account_id = s.account_id
  AND o.order_date = s.iso_date
  AND o.country_code = s.country
  AND o.order_time BETWEEN s.start_date AND s.end_date
  AND s.country = "AE"
  AND s.subscription_state <<>> "BILLING RETRY"

WHERE o.is_successful
  AND LOWER(o.delivery_arrangement) = "tdine"
  AND o.country_code = "AE"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0kdbn301lyg0cu12ze9oa137mnrs' name='Custom SQL Query' type='text'><![CDATA[-- Lifetime DineOut user counts
