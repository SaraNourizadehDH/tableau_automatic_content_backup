and date_add(date_trunc(fi.order_date,month),interval 1 month)=cu.month
where is_successful
and country_code="AE"
group by all
)


select 
cu.month,
CASE
                    when po.orders = 0 then '0.Inactive'
                    when po.orders is null then '0.Inactive'
                    WHEN po.orders = 1 THEN "1. 1st Timers"
                    WHEN po.orders BETWEEN 2 AND 3 THEN "2. Low"
                    WHEN po.orders BETWEEN 4 AND 8 THEN "3. Mid"
                    WHEN po.orders>>= 9 THEN "4. High"
                END as segment,
  tag,
