      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C24009DFF0E540A1BA5E720ACCF9E388'>
            <properties context=''>
              <relation connection='bigquery.1nkmcds1jl3y0x1ebv4yx0c5epxq' name='Custom SQL Query' type='text'><![CDATA[--dineout engagement users ----
with dineout_users as 
(
select 
date_trunc(order_date,month) as month,
fi.account_id,
max(case when delivery_arrangement ='TDINE'  and fi.email not like "%talabat.com" then 1 else 0 end) as dineout_flag,
count(distinct case when (coalesce(discount_amount_lc,0)>>0 or coalesce(voucher_discount_amount_lc,0)>>0 or coalesce(incentive_amount_lc,0)>>0
     or coalesce(gem_discount_amount_lc,0)>>0) and lower(delivery_arrangement)<<>>"tdine" then order_id end) as disocunted_order_count,
count(distinct order_id) as total_orders,
count(distinct vertical_id) as vertical_count
 from `tlb-data-prod.data_platform.fct_order_info` fi 
 inner join `tlb-data-prod.data_platform.dim_vendor_info` dv 
 on fi.vendor_id = dv.vendor_id 
 inner join `tlb-data-prod.data_platform.dim_payment_method` dp 
 on dp.payment_method_id = fi.payment_method_id
 inner join tlb-data-prod.data_platform.dim_account as a
 on fi.account_id=a.account_id
where country_iso = 'AE'
--and delivery_arrangement ='TDINE'
and is_successful 
group by all
)

select
d.month,
case when dineout_flag=1 then "DineOut User" else "Platform User" end as user_type,
CASE
                    when doc.total_orders = 0 then '0.Inactive'
                    WHEN doc.total_orders = 1 THEN "1. 1st Timers"
                    WHEN doc.total_orders BETWEEN 2 AND 3 THEN "2. Low"
                    WHEN doc.total_orders BETWEEN 4 AND 8 THEN "3. Mid"
                    WHEN doc.total_orders >>= 9 THEN "4. High"
                END growth_order_segment,
--growth_incentive_ratio_segment,
--mv_segment_customer,
case when safe_divide(doc.disocunted_order_count,doc.total_orders)>>0.5 then "High" when safe_divide(doc.disocunted_order_count,doc.total_orders)<<0.2
then "Low" else "Medium" end incentive_segment,
case when doc.vertical_count>>1 then "multi-vertical" when doc.vertical_count=1 then "Single Vertical" else "Inactive" end as multi_verticality_tag,
count(distinct d.account_id) as users


 from
 dineout_users as d
--  left join 
--    (select 
--    account_id,
--    growth_order_segment,
--    growth_incentive_ratio_segment,
--    mv_segment_customer,
--    date_trunc(snapshot_date,month) as month
--    from  
--    `tlb-data-prod.data_platform.agg_customer_profile_monthly` as ap
--    inner join `tlb-data-prod.data_platform.dim_account` as a
--    on ap.analytical_customer_id=a.analytical_customer_id
--    where ap.country_code="AE"
--    and date_trunc(snapshot_date,month)>>="2024-01-01"
--    ) as ap 
--  on ap.account_id=d.account_id
--  and date_add(ap.month,interval 1 month)=d.month
 left join 
   ( select 
       month,
       account_id,
       disocunted_order_count,
       total_orders,
       vertical_count
     from dineout_users
     group by all
   ) as doc
on d.account_id=doc.account_id
and d.month=date_add(doc.month,interval 1 month)


 group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='user type' inline='true' name='federated.11azzwn0b5e5ue10zc27z0fwkqed' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1dkd9wd12m04v517sd01n0whhc0v'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ahmed.thahir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1dkd9wd12m04v517sd01n0whhc0v' name='Custom SQL Query' type='text'><![CDATA[with aggregates as 
( 
        
select
   date_trunc(order_date,month) as month,
   o.account_id,
   min(case when lower(delivery_arrangement)="tdine" and s.account_id is not null and is_bnpl_payment then 1
        when lower(delivery_arrangement)="tdine" and is_bnpl_payment then 2
        when lower(delivery_arrangement)="tdine" and s.account_id is not null then 3
        when lower(delivery_arrangement)="tdine" and s.account_id is null then 4
        when is_bnpl_payment then 5
        when s.account_id is not null then 6
        when s.account_id is  null then 7 end) as tag,

count(distinct order_id) as order_total,
sum(gmv_amount_lc) as gmv_total,
sum(basket_amount_lc) as basket_amount_lc,
sum(gmv_amount_lc-coalesce(service_fee_amount_lc,0)- coalesce(delivery_fee_amount_lc,0)) as gfv,


        
count(distinct case when lower(delivery_arrangement)="tdine" then order_id end) as dineout_order_total,
sum(case when  lower(delivery_arrangement)="tdine" then gmv_amount_lc end) as dinout_gmv_total,
sum(case when  lower(delivery_arrangement)="tdine" then basket_amount_lc end) as dineout_basket_amount,
sum(case when  lower(delivery_arrangement)="tdine" then gmv_amount_lc-coalesce(service_fee_amount_lc,0)- coalesce(delivery_fee_amount_lc,0) end) as dineout_gfv,

count(distinct case when is_bnpl_payment then o.account_id end) as total_bnpl_users,
count(distinct case when lower(delivery_arrangement)='tdine' then o.account_id end ) as total_tdine_users,
count(distinct case when s.account_id is not null then o.account_id end) as total_tpro_users,


count(distinct case when is_bnpl_payment then order_id end) as total_bnpl_orders,
count(distinct case when lower(delivery_arrangement)='tdine' then order_id end ) as total_tdine_orders,
count(distinct case when s.account_id is not null then order_id end) as total_tpro_orders,

count(distinct case when is_bnpl_payment and lower(delivery_arrangement)="tdine"then o.account_id end) as total_bnpl_dineout_users,
count(distinct case when is_bnpl_payment and lower(delivery_arrangement)="tdine"then order_id end) as total_bnpl_dineout_orders,
count(distinct case when s.account_id is not null and lower(delivery_arrangement)="tdine" then o.account_id end) as total_tpro_dineout_users,
count(distinct case when s.account_id is not null and lower(delivery_arrangement)="tdine" then o.order_id end) as total_tpro_dineout_orders,

count(distinct case when is_bnpl_payment and  s.account_id is not null then o.account_id end) as overall_bnpl_tpro_users



from
`tlb-data-prod.data_platform.fct_order_info` as o
 inner join  `tlb-data-prod.data_platform.dim_payment_method` AS p
ON  o.payment_method_id = p.payment_method_id
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as s
on o.account_id=s.account_id
and o.country_code=s.country
and o.order_date=s.iso_date
and o.order_time between start_date and end_date
and subscription_state<<>>"BILLING RETRY"
where is_successful 
and date_trunc(order_date,month)>>="2024-12-01"
and o.country_code="AE"
and o.email not like "%talabat.com"
group by all
)




select month,case when tag=1 then "BNPLXtProXDineOut"
                  when tag=2 then "BNPLx DineOut"
                  when tag=3 then "tProxDineOut"
                  when tag=5 then "BNPL only"
                  when tag=4 then "DineOut Nontpro"
                  when tag=6 then "tPro Only"
                  when tag=7 then "Non-tPro"
                  else "N/A" end as tag,
                  sum(order_total) as order_total,
                  sum(gfv) as gfv_total,
                  sum(basket_amount_lc) as basket_amount_lc,
                  sum(dineout_order_total) as dineout_orders,
                  sum(dineout_gfv) as dineout_gfv,
                  sum(dineout_basket_amount) as dineout_basket_amount,
                  sum(total_bnpl_users) as total_bnpl_users,
                  sum(total_bnpl_orders) as total_bnpl_orders,
                  sum(total_tpro_users) as total_tpro_users,
                  sum(total_tpro_orders) as total_tpro_orders,
                  sum(total_tdine_users) as total_tdine_users,
                  sum(total_tdine_orders) as total_tdine_orders,
                  count(distinct account_id) as total_users,
                  sum(total_bnpl_dineout_users) as total_bnpl_dineout_users,
                  sum(total_bnpl_dineout_orders) as total_bnpl_dineout_orders,
                  sum(total_tpro_dineout_users) as total_tpro_dineout_users,
                  sum(total_bnpl_dineout_orders) as total_tpro_dineout_orders,
                  sum(overall_bnpl_tpro_users) as overall_bnpl_tpro_users
        
                  from aggregates
group by all]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1dkd9wd12m04v517sd01n0whhc0v' name='Custom SQL Query' type='text'><![CDATA[with aggregates as 
( 
        
select
   date_trunc(order_date,month) as month,
   o.account_id,
   min(case when lower(delivery_arrangement)="tdine" and s.account_id is not null and is_bnpl_payment then 1
        when lower(delivery_arrangement)="tdine" and is_bnpl_payment then 2
        when lower(delivery_arrangement)="tdine" and s.account_id is not null then 3
        when lower(delivery_arrangement)="tdine" and s.account_id is null then 4
        when is_bnpl_payment then 5
        when s.account_id is not null then 6
        when s.account_id is  null then 7 end) as tag,

count(distinct order_id) as order_total,
sum(gmv_amount_lc) as gmv_total,
sum(basket_amount_lc) as basket_amount_lc,
sum(gmv_amount_lc-coalesce(service_fee_amount_lc,0)- coalesce(delivery_fee_amount_lc,0)) as gfv,


        
count(distinct case when lower(delivery_arrangement)="tdine" then order_id end) as dineout_order_total,
sum(case when  lower(delivery_arrangement)="tdine" then gmv_amount_lc end) as dinout_gmv_total,
sum(case when  lower(delivery_arrangement)="tdine" then basket_amount_lc end) as dineout_basket_amount,
sum(case when  lower(delivery_arrangement)="tdine" then gmv_amount_lc-coalesce(service_fee_amount_lc,0)- coalesce(delivery_fee_amount_lc,0) end) as dineout_gfv,

count(distinct case when is_bnpl_payment then o.account_id end) as total_bnpl_users,
count(distinct case when lower(delivery_arrangement)='tdine' then o.account_id end ) as total_tdine_users,
count(distinct case when s.account_id is not null then o.account_id end) as total_tpro_users,


count(distinct case when is_bnpl_payment then order_id end) as total_bnpl_orders,
count(distinct case when lower(delivery_arrangement)='tdine' then order_id end ) as total_tdine_orders,
count(distinct case when s.account_id is not null then order_id end) as total_tpro_orders,

count(distinct case when is_bnpl_payment and lower(delivery_arrangement)="tdine"then o.account_id end) as total_bnpl_dineout_users,
count(distinct case when is_bnpl_payment and lower(delivery_arrangement)="tdine"then order_id end) as total_bnpl_dineout_orders,
count(distinct case when s.account_id is not null and lower(delivery_arrangement)="tdine" then o.account_id end) as total_tpro_dineout_users,
count(distinct case when s.account_id is not null and lower(delivery_arrangement)="tdine" then o.order_id end) as total_tpro_dineout_orders,

count(distinct case when is_bnpl_payment and  s.account_id is not null then o.account_id end) as overall_bnpl_tpro_users



from
`tlb-data-prod.data_platform.fct_order_info` as o
 inner join  `tlb-data-prod.data_platform.dim_payment_method` AS p
ON  o.payment_method_id = p.payment_method_id
left join `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as s
on o.account_id=s.account_id
and o.country_code=s.country
and o.order_date=s.iso_date
and o.order_time between start_date and end_date
and subscription_state<<>>"BILLING RETRY"
where is_successful 
and date_trunc(order_date,month)>>="2024-12-01"
and o.country_code="AE"
and o.email not like "%talabat.com"
group by all
)




select month,case when tag=1 then "BNPLXtProXDineOut"
                  when tag=2 then "BNPLx DineOut"
                  when tag=3 then "tProxDineOut"
                  when tag=5 then "BNPL only"
                  when tag=4 then "DineOut Nontpro"
                  when tag=6 then "tPro Only"
                  when tag=7 then "Non-tPro"
                  else "N/A" end as tag,
                  sum(order_total) as order_total,
                  sum(gfv) as gfv_total,
                  sum(basket_amount_lc) as basket_amount_lc,
                  sum(dineout_order_total) as dineout_orders,
                  sum(dineout_gfv) as dineout_gfv,
                  sum(dineout_basket_amount) as dineout_basket_amount,
                  sum(total_bnpl_users) as total_bnpl_users,
                  sum(total_bnpl_orders) as total_bnpl_orders,
                  sum(total_tpro_users) as total_tpro_users,
                  sum(total_tpro_orders) as total_tpro_orders,
                  sum(total_tdine_users) as total_tdine_users,
                  sum(total_tdine_orders) as total_tdine_orders,
                  count(distinct account_id) as total_users,
                  sum(total_bnpl_dineout_users) as total_bnpl_dineout_users,
                  sum(total_bnpl_dineout_orders) as total_bnpl_dineout_orders,
                  sum(total_tpro_dineout_users) as total_tpro_dineout_users,
                  sum(total_bnpl_dineout_orders) as total_tpro_dineout_orders,
                  sum(overall_bnpl_tpro_users) as overall_bnpl_tpro_users
        
                  from aggregates
group by all]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
