        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0l0pwev1lwkkwx16zixzd1vzeh3p' name='Custom SQL Query' type='text'><![CDATA[/* 

Goal: get new vendors 

*/



with dineout_logic as 
( SELECT 
    DISTINCT v.vendor_id,
    salesforce_id,
    avg(case when c.name__c = "tDine" then  commission__c/100  end) as tdine_commission,
    avg(case when c.name__c <<>> "tDine" then  commission__c/100  end)  as other_commission

  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid

  WHERE 1=1
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD','tDine','TGO Incremental GMV Commission')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
  group by 1 ,2
  )
, 


vendor_acquisition as (select distinct v.vendor_id, case when  title in 
('Sales Executive','Sales Exeuctive',
'Sr. Sales Executive','Sr. Sales executive',
'Coordinator Riders','Sales Acquisition - IC1',
'Team Lead Acquisition','Manager Acquisition','Head Of Acquisitions & Partnerships','Lead Generator',
'Lead Generator Support','Intern - Sales') then"Field Sales"

when  title  = 'Inside Sales Executive'  then 'Tele Sales'

when title   in ('Account Manager',
'Sr. Key Account Manager',
'Key Account Manager',
'Team Lead Account Management',
'Online Account Manager',
'Sr. Account Manager',
'Online Account Manager II',
'Team lead Online Account Management',
'Phone Account Manager')
then 'Account Managers'

else "Others"
end as team,


FROM `tlb-data-prod.data_platform.dim_vendor_info` v
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch 
ON ch.chain_id = v.chain_id
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dl
ON dl.location_id = v.location_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
ON v.salesforce_id = a.grid__c
-- left join dineout do on do.id = a.id 
LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
ON a.id = c.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
ON a.id =o.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON o.ownerid = u.id
WHERE
  business_type__c IN ('Franchise Extension',
    'New Business',
    'Win Back')
  AND iswon
 and (a.vertical__c = "Restaurant"  or lower(a.vertical_segment__c) in ("bakery","drinks","snacks_and_sweets","specialty_coffee_and_tea"))

 )
,active_base as (
    select * from (
    SELECT 
    k.vendor_id, 
    IFNULL(case when ifnull(tdine_commission,0) >> 0 and  ifnull(other_commission,0) = 0 then TRUE ELSE FALSE END,FALSE)  as vendor_dineout_flag,
    k.country_code,
    k.first_online_date, 
    k.first_order_date, 
    k.vendor_grade,
    acquisition_business_type,
    FROM `tlb-data-prod.data_platform.agg_vendor_inventory_kpi_monthly` k 
    left join `tlb-data-prod.data_platform.dim_vendor_info` f on k.vendor_id=f.vendor_id
    left join dineout_logic c on k.vendor_id=c.vendor_id   
    WHERE vertical = 'Restaurant'
      AND month = '2025-8-01'  -- December 2024
      and k.first_online_date >>='2024-07-01'
      AND k.is_active  -- Only active vendors
      and is_contracted
      group by all)
      where vendor_dineout_flag=false
),



metrics_metadata AS (
     /* Active vendors in December 2024 */
     SELECT
       k.vendor_id,
     k.country_code,
     date_trunc(snapshot_date,month) as month,
     snapshot_date,

     sum(successful_order_count) as succ_orders, 
     sum(gmv_amount_eur) as gmv, 
    sum( IFNULL((cpp_featured_product_revenue_eur),0) +
IFNULL((kwords_revenue_eur),0) +
IFNULL((cpp_revenue_eur),0) +
IFNULL((deal_targeting_revenue_eur),0) +
IFNULL((gem_commission_amount_eur),0) +
--IFNULL((organic_placement_revenue_eur),0) +
IFNULL(display_ads_revenue_eur,0)) ad_rev,
sum(ifnull(cpc_revenue_eur,0)) as cpc,
sum(ifnull(discount_amount_eur,0)) as discount,


--- add here offline time 
sum(offline_duration_in_hours) as offline_duration_in_hours,
sum(schedule_duration_in_hours) as schedule_duration_in_hours,
-- dlp and dld 
max(active_menu_item_count) as active_menu_item_count, 
max(item_with_image_count) as item_with_image_count,
max(item_with_description_count) as item_with_description_count,
-- Engagement vs Impressions 
sum(vendor_list_impression_session_count) as vendor_list_impression_count,
sum(viewed_menu_session_count) as viewed_menu_session_count,
sum(net_order_count) as placed_order_count,
sum(cpc_order_count) as cpc_order_count,
sum(vendor_active_customer_count) as vendor_active_customers,
sum(vendor_list_session_count) as vendor_list_session_count,
sum(tpro_free_delivery_discount_amount_eur) as tpro_discount, 

sum(menu_discount_amount_eur) as menu_discount, 
sum(super_saver_discount_amount_eur) as supersaver_discount, 
sum(item_discount_amount_eur) as item_discount, 
sum(flash_sale_discount_amount_eur) as flashsale_discount,
sum(targeted_deal_discount_amount_eur) as target_deal_discount, 

sum(bestseller_discount_amount_eur) as bestseller_discount, 
sum(booster_discount_amount_eur) as booster_discount, 
sum(buyx_gety_discount_amount_eur) as buyx_gety_discount, 





     FROM `tlb-data-prod.data_platform.agg_vendor_performance_metrics_daily` k
     left join `tlb-data-prod.data_platform.dim_vendor_info` vf on vf.vendor_id=k.vendor_Id
     WHERE vertical = 'food'
       AND snapshot_date >>= '2024-07-01'  -- December 2024x
       and k.country_code <<>> 'SA'
       group by all)
, pre_output as (
       select a.first_online_date,
       a.vendor_grade,
       a.acquisition_business_type,

      
        m.*, 
       
       case when cpc <<>>0 then 1 else 0 end as on_cpc, 
      case when discount <<>>0 then 1 else 0 end as on_discount from active_base a 
       left join metrics_metadata m on a.vendor_id=m.vendor_id 
       and date_trunc(m.snapshot_date,month) >>=date_trunc(a.first_online_date,month) - interval '6' month
) 


select p.vendor_id, 
v.team, 

date_trunc(first_online_date,month) as first_online_month, 
date_trunc(snapshot_date,month) as month, 
country_code,
acquisition_business_type,vendor_grade,
date_diff(date_trunc(snapshot_date,month),date_trunc(first_online_date,month),month) as index,
 max(on_discount) on_discount,
  max(on_cpc) on_cpc, 

sum(gmv) as gmv, 
sum(succ_orders) as succ_orders,
sum(offline_duration_in_hours) as offline_time, 
sum(schedule_duration_in_hours) as schedule_duration,
sum(cpc) as cpc_amount, 
sum(discount) as discount_amount,
max(active_menu_item_count) as active_menu_item_count, 
max(item_with_image_count) as item_with_image_count, 

case when sum(tpro_discount) >>0 then 1 else 0 end as on_tpro_discount, 
case when sum(menu_discount) >> 0 then 1 else 0 end on_menu_discount, 
case when sum(supersaver_discount) >> 0 then 1 else 0 end on_supersaver_discount, 
case when sum(item_discount) >> 0 then 1 else 0 end on_item_discount, 
case when sum(flashsale_discount) >> 0 then 1 else 0 end on_flashsale_discount, 
case when sum(target_deal_discount) >> 0 then 1 else 0 end on_target_deal_discount, 
case when sum(bestseller_discount) >> 0 then 1 else 0 end on_bestseller_discount, 
case when sum(booster_discount) >> 0 then 1 else 0 end on_booster_discount,
case when sum(buyx_gety_discount) >> 0 then 1 else 0 end on_buyx_gety_discount,


from pre_output p 
left join vendor_acquisition v on p.vendor_id=v.vendor_id
--where country_code='AE'
group by all
having safe_divide(offline_time,schedule_duration) <<=0.85 
and safe_divide(item_with_image_count,active_menu_item_count) >>=0.85]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0l0pwev1lwkkwx16zixzd1vzeh3p' name='Custom SQL Query' type='text'><![CDATA[/* 

