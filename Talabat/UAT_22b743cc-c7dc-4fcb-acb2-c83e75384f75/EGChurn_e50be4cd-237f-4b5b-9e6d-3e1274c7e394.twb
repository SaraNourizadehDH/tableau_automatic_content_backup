    , a.vehicle
    , a.Total_orders
    , a.Days_Worked
    , a.Tenurity_in_days
    , DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1   AS tenure_month
    , CASE WHEN DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1 <<= 12
           THEN CAST(DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1 AS STRING)
           ELSE '1+ year' END                                                 AS tenure_bucket
    , CASE WHEN b.rider_id IS NULL THEN a.rider_id END                        AS churn_candidate_rider_id
  FROM base a
  LEFT JOIN base b
    ON b.Month    = DATE_ADD(a.Month, INTERVAL 1 MONTH)
   AND b.rider_id = a.rider_id
  LEFT JOIN FOD
    ON FOD.rider_id = a.rider_id
  -- keep only closed eval months: (M+1) << first day of current month
  WHERE DATE_ADD(a.Month, INTERVAL 1 MONTH) << DATE_TRUNC(CURRENT_DATE, MONTH)
)

,churners_with_contract AS
(
  SELECT DISTINCT
      c.cohort_month
    , c.churn_month
    , c.churn_candidate_rider_id AS rider_id
  FROM cohort c
  JOIN `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` rc
    ON rc.rider_id     = c.churn_candidate_rider_id
   AND rc.country_code = 'eg'
   -- contract active in churn month (month-truncated overlap)
   AND DATE_TRUNC(DATE(rc.start_at), MONTH) <<= c.churn_month
   AND (rc.end_at IS NULL OR DATE_TRUNC(DATE(rc.end_at), MONTH) >>= c.churn_month)
  WHERE c.churn_candidate_rider_id IS NOT NULL
)

,cohort_enriched AS
(
  SELECT
      c.*
    , CASE WHEN cw.rider_id IS NOT NULL THEN c.churn_candidate_rider_id END AS churned_rider_id
  FROM cohort c
  LEFT JOIN churners_with_contract cw
    ON cw.cohort_month = c.cohort_month
   AND cw.churn_month  = c.churn_month
   AND cw.rider_id     = c.churn_candidate_rider_id
)

-- ==================== VIEWS (same as before) ====================

SELECT
    'zone' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , CAST(NULL AS STRING)                                   AS `3pl`
  , Zone                                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE Zone IS NOT NULL AND TRIM(Zone) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, Zone

UNION ALL
SELECT
    '3pl' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , `3pl`
  , CAST(NULL AS STRING)                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
