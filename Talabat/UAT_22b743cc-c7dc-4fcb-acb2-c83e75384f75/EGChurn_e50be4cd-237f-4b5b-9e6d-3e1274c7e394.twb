        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.184ojal1oyu4gt11oxfsb02ihs7d' name='Custom SQL Query' type='text'><![CDATA[WITH FOD AS
(
  SELECT 
      d.rider_id
    , MIN(DATE(d.order_created_at, d.timezone)) AS First_order_date
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery` d 
  INNER JOIN `tlb-data-prod.data_platform.dim_logistics_rider` r
    ON r.rider_id = d.rider_id AND r.country_code = 'eg'
  WHERE d.delivery_status = 'completed'
    AND d.order_status    = 'completed'
    AND d.country_code    = 'eg'
  GROUP BY ALL
)

,base AS
(
  SELECT 
      DATE_TRUNC(DATE(d.order_created_at, d.timezone), MONTH) AS Month
    , d.rider_id
    , FOD.First_order_date
    , z.zone_name                               AS Zone
    , r.last_contract_company_name              AS `3pl`
    , c.city_name
    , r.vehicle
    , COUNT(DISTINCT d.order_id)                AS Total_orders
    , COUNT(DISTINCT DATE(d.order_created_at))  AS Days_Worked
    , DATE_DIFF(MAX(DATE(d.order_created_at, d.timezone)), FOD.First_order_date, DAY) AS Tenurity_in_days
  FROM `tlb-data-prod.data_platform.fct_logistics_delivery` d 
  INNER JOIN `tlb-data-prod.data_platform.dim_logistics_rider` r
    ON r.rider_id     = d.rider_id
   AND r.country_code = 'eg'
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_zone` z
    ON z.zone_id      = r.last_operating_zone_id
   AND z.is_active
   AND z.country_code = 'eg'
  LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` c
    ON r.last_city_id = c.city_id
   AND c.is_active
   AND c.country_code = 'eg'
  LEFT JOIN FOD
    ON FOD.rider_id   = r.rider_id
  WHERE 
    d.delivery_status = 'completed'
    AND d.order_status = 'completed'
    AND d.country_code = 'eg'
    AND DATE(d.order_created_at, d.timezone)
        BETWEEN DATE_TRUNC(CURRENT_DATE, MONTH) - INTERVAL 14 MONTH
            AND   DATE_TRUNC(CURRENT_DATE, MONTH)
  GROUP BY ALL
)

,cohort AS
(
  SELECT
      a.Month                                            AS cohort_month        -- M
    , DATE_ADD(a.Month, INTERVAL 1 MONTH)               AS churn_month         -- M+1
    , a.rider_id
    , a.`3pl`
    , a.Zone
    , a.city_name
    , a.vehicle
    , a.Total_orders
    , a.Days_Worked
    , a.Tenurity_in_days
    , DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1   AS tenure_month
    , CASE WHEN DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1 <<= 12
           THEN CAST(DATE_DIFF(a.Month, DATE_TRUNC(FOD.First_order_date, MONTH), MONTH) + 1 AS STRING)
           ELSE '1+ year' END                                                 AS tenure_bucket
    , CASE WHEN b.rider_id IS NULL THEN a.rider_id END                        AS churn_candidate_rider_id
  FROM base a
  LEFT JOIN base b
    ON b.Month    = DATE_ADD(a.Month, INTERVAL 1 MONTH)
   AND b.rider_id = a.rider_id
  LEFT JOIN FOD
    ON FOD.rider_id = a.rider_id
  -- keep only closed eval months: (M+1) << first day of current month
  WHERE DATE_ADD(a.Month, INTERVAL 1 MONTH) << DATE_TRUNC(CURRENT_DATE, MONTH)
)

,churners_with_contract AS
(
  SELECT DISTINCT
      c.cohort_month
    , c.churn_month
    , c.churn_candidate_rider_id AS rider_id
  FROM cohort c
  JOIN `tlb-data-prod.data_platform.rltnp_logistics_rider_x_contract` rc
    ON rc.rider_id     = c.churn_candidate_rider_id
   AND rc.country_code = 'eg'
   -- contract active in churn month (month-truncated overlap)
   AND DATE_TRUNC(DATE(rc.start_at), MONTH) <<= c.churn_month
   AND (rc.end_at IS NULL OR DATE_TRUNC(DATE(rc.end_at), MONTH) >>= c.churn_month)
  WHERE c.churn_candidate_rider_id IS NOT NULL
)

,cohort_enriched AS
(
  SELECT
      c.*
    , CASE WHEN cw.rider_id IS NOT NULL THEN c.churn_candidate_rider_id END AS churned_rider_id
  FROM cohort c
  LEFT JOIN churners_with_contract cw
    ON cw.cohort_month = c.cohort_month
   AND cw.churn_month  = c.churn_month
   AND cw.rider_id     = c.churn_candidate_rider_id
)

-- ==================== VIEWS (same as before) ====================

SELECT
    'zone' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , CAST(NULL AS STRING)                                   AS `3pl`
  , Zone                                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE Zone IS NOT NULL AND TRIM(Zone) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, Zone

UNION ALL
SELECT
    '3pl' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , `3pl`
  , CAST(NULL AS STRING)                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE `3pl` IS NOT NULL AND TRIM(`3pl`) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, `3pl`

UNION ALL
SELECT
    '3pl_zone' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , `3pl`
  , Zone                                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE `3pl` IS NOT NULL AND TRIM(`3pl`) <<>> ''
  AND Zone  IS NOT NULL AND TRIM(Zone) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, `3pl`, Zone

UNION ALL
SELECT
    'vehicle' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , CAST(NULL AS STRING)                                   AS `3pl`
  , CAST(NULL AS STRING)                                   AS zone
  , vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE vehicle IS NOT NULL AND TRIM(vehicle) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, vehicle

UNION ALL
SELECT
    'zone_vehicle' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , CAST(NULL AS STRING)                                   AS `3pl`
  , Zone                                                   AS zone
  , vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
WHERE Zone    IS NOT NULL AND TRIM(Zone)    <<>> ''
  AND vehicle IS NOT NULL AND TRIM(vehicle) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, Zone, vehicle

UNION ALL
SELECT
    'tenure' AS `view`
  , churn_month
  , cohort_month
  , tenure_month
  , tenure_bucket
  , CAST(NULL AS STRING)                                   AS `3pl`
  , CAST(NULL AS STRING)                                   AS zone
  , CAST(NULL AS STRING)                                   AS vehicle
  , CAST(NULL AS STRING)                                   AS city
  , COUNT(DISTINCT rider_id)                               AS cohort_size
  , COUNT(DISTINCT churned_rider_id)                       AS churned
  , ROUND(SAFE_DIVIDE(COUNT(DISTINCT churned_rider_id),
                      COUNT(DISTINCT rider_id)), 3)        AS churn_rate
  , AVG(Total_orders)                                      AS avg_total_orders
  , AVG(Days_Worked)                                       AS avg_days_worked
  , AVG(Tenurity_in_days)                                  AS avg_tenure_days
FROM cohort_enriched
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket

ORDER BY churn_month, `view`, `3pl`, zone, vehicle, tenure_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.184ojal1oyu4gt11oxfsb02ihs7d' name='Custom SQL Query' type='text'><![CDATA[WITH FOD AS
