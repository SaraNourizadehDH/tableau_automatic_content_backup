FROM cohort_enriched
WHERE `3pl` IS NOT NULL AND TRIM(`3pl`) <<>> ''
  AND Zone  IS NOT NULL AND TRIM(Zone) <<>> ''
GROUP BY churn_month, cohort_month, tenure_month, tenure_bucket, `3pl`, Zone

UNION ALL
SELECT
    'vehicle' AS `view`
  , churn_month
