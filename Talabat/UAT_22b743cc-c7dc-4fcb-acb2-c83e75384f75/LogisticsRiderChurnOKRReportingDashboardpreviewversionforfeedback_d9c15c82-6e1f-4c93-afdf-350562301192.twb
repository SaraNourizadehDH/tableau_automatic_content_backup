      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E8AD3B95AAD44F08B00BC89883827920'>
            <properties context=''>
              <relation connection='bigquery.0q3to2610oo0rv1ac9f6k0iijg4f' name='Custom SQL Query' type='text'><![CDATA[-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- Covers all months in current year up to the last completed month (excludes current/ongoing month).

-- 1) Rider-month activity (any delivery >> 0)
WITH base_activity AS (
  SELECT
    country_code,
    city_name,
    rider_id,
    DATE_TRUNC(date, MONTH) AS active_month
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily`
  WHERE total_completed_logistics_deliveries >> 0
    AND date >>= DATE '2024-12-01' -- keep Dec prev year for Jan S-1
),

-- 2) Country-level and Dubai slices; union together
country_level AS (
  SELECT country_code, CAST(NULL AS STRING) AS city_name, rider_id, active_month
  FROM base_activity
),
dubai_only AS (
  SELECT country_code, 'Dubai' AS city_name, rider_id, active_month
  FROM base_activity
  WHERE LOWER(city_name) = 'dubai'
),
activity AS (
  SELECT * FROM country_level
  UNION ALL
  SELECT * FROM dubai_only
),

-- 3) Identify reporting months S = current year, excluding current month
months_of_year AS (
  SELECT DISTINCT
    a.active_month AS month_s,
    DATE_SUB(a.active_month, INTERVAL 1 MONTH) AS month_p
  FROM activity a
  WHERE EXTRACT(YEAR FROM a.active_month) = EXTRACT(YEAR FROM CURRENT_DATE())
    AND a.active_month << DATE_TRUNC(CURRENT_DATE(), MONTH) -- exclude current month
),

-- 4) Riders active in previous month P (base month)
riders_prev AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    moy.month_s,   -- reporting month S
    moy.month_p    -- previous month P (S-1)
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_p
),

-- 5) Riders active in reporting month S
riders_curr AS (
  SELECT
    a.country_code,
    a.city_name,
    a.rider_id,
    a.active_month AS month_s
  FROM activity a
  JOIN months_of_year moy
    ON a.active_month = moy.month_s
),

-- 6) VDA table (normalized)
vda_prev AS (
  SELECT
    LOWER(TRIM(country_code)) AS country_code_norm,
    CAST(rider_id AS STRING)  AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
),

/* 6b) UPDATED: Active riders in month S split by VDA flag IN S (current month),
   so active_riders matches total_riders which also uses S */
active_riders_month_by_flag AS (
  SELECT
    rc.country_code,
    rc.city_name,
    rc.month_s,
    IFNULL(v_s.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate,  -- VDA in S
    COUNT(DISTINCT rc.rider_id) AS active_riders_by_flag
  FROM riders_curr rc
  LEFT JOIN vda_prev v_s
    ON v_s.country_code_norm = LOWER(TRIM(rc.country_code))
   AND v_s.rider_id_norm     = CAST(rc.rider_id AS STRING)
   AND v_s.active_month      = rc.month_s         -- <<<< use S here (was S-1)
  GROUP BY 1,2,3,4
),

-- 7) Rider-level churn: riders in P but not in S, plus their VDA status from P
rider_churn_list AS (
  SELECT
    rp.country_code,
    rp.city_name,
    rp.month_s AS active_month,                 -- month of churn (S)
    rp.month_p AS prev_month,                   -- previous month (S-1)
    rp.rider_id,
    IFNULL(v_p.is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate  -- S-1 flag
  FROM riders_prev rp
  LEFT JOIN riders_curr rc
    ON rc.country_code = rp.country_code
   AND IFNULL(rc.city_name,'ALL') = IFNULL(rp.city_name,'ALL')
   AND rc.rider_id = rp.rider_id
   AND rc.month_s  = rp.month_s
  LEFT JOIN vda_prev v_p
    ON v_p.country_code_norm = LOWER(TRIM(rp.country_code))
   AND v_p.rider_id_norm     = CAST(rp.rider_id AS STRING)
   AND v_p.active_month      = rp.month_p
  WHERE rc.rider_id IS NULL -- rider was NOT active in month S (churned)
),

-- 8) De-duplicated rider list with cluster label
rider_list AS (
  SELECT DISTINCT
    CASE WHEN city_name = 'Dubai' THEN 'Dubai' ELSE country_code END AS clusters,
    active_month,
    prev_month,
    country_code,
    city_name,
    rider_id,
    is_valid_delivery_associate   -- this is S-1 flag (used for churn grouping)
  FROM rider_churn_list
)

-- 9) Final rider list
SELECT 
 rl.*,
 last_contract_name,
 last_contract_start_at,
 last_contract_end_at,
 vehicle,
 rider_name,
 rider_email,
 phone_number
 FROM rider_list rl
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl on rl.country_code = dl.country_code and rl.rider_id = dl.rider_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='rider churn_mtd view' inline='true' name='federated.0iymvzn0n5d6bz1cvjggx0jqsrkk' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0kjli6h0ebvfpn1cxd75z1sjv695'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='balderick.bissessur@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0kjli6h0ebvfpn1cxd75z1sjv695' name='Custom SQL Query' type='text'>-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- Here: base_activity = riders active in the last 30 days (adjust as needed)

WITH base_activity AS (
  SELECT
    r.country_code,
    r.city_name,
    r.rider_id,
    MAX(r.date) AS last_order_date,
    DATE_TRUNC(MAX(r.date), MONTH) AS active_month  -- month S
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r
  WHERE r.total_completed_logistics_deliveries &gt;&gt; 0
    AND r.date between DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) and DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) 
  GROUP BY r.country_code, r.city_name, r.rider_id
),

adjusted_base AS(
  SELECT b.*,
  min(r.date) as first_order_date,
  FROM
  base_activity b
  LEFT JOIN `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r using (country_code, rider_id) 
  GROUP BY ALL 
),

vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))           AS country_code_norm,
    CAST(rider_id AS STRING)            AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
)

SELECT
  b.country_code,
  b.city_name,
  b.rider_id,
  dl.rider_name,
  dl.rider_email,
  dl.phone_number,
  dl.last_contract_name,
  dl.is_active,
  dl.vehicle,
  b.last_order_date,
  b.first_order_date,
  CASE WHEN v.is_valid_delivery_associate IS NULL THEN FALSE ELSE v.is_valid_delivery_associate END as is_valid_delivery_associate                      
FROM adjusted_base AS b
LEFT JOIN vda_prev AS v
  ON LOWER(TRIM(b.country_code)) = v.country_code_norm
 AND CAST(b.rider_id AS STRING)   = v.rider_id_norm
 AND v.active_month               = DATE_SUB(b.active_month, INTERVAL 1 MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl on b.country_code = dl.country_code and b.rider_id = dl.rider_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0kjli6h0ebvfpn1cxd75z1sjv695' name='Custom SQL Query' type='text'>-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- Here: base_activity = riders active in the last 30 days (adjust as needed)

WITH base_activity AS (
  SELECT
    r.country_code,
    r.city_name,
    r.rider_id,
    MAX(r.date) AS last_order_date,
    DATE_TRUNC(MAX(r.date), MONTH) AS active_month  -- month S
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r
  WHERE r.total_completed_logistics_deliveries &gt;&gt; 0
    AND r.date between DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) and DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) 
  GROUP BY r.country_code, r.city_name, r.rider_id
),

adjusted_base AS(
  SELECT b.*,
  min(r.date) as first_order_date,
  FROM
  base_activity b
  LEFT JOIN `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r using (country_code, rider_id) 
  GROUP BY ALL 
),

vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))           AS country_code_norm,
    CAST(rider_id AS STRING)            AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
)

SELECT
  b.country_code,
  b.city_name,
  b.rider_id,
  dl.rider_name,
  dl.rider_email,
  dl.phone_number,
  dl.last_contract_name,
  dl.is_active,
  dl.vehicle,
  b.last_order_date,
  b.first_order_date,
  CASE WHEN v.is_valid_delivery_associate IS NULL THEN FALSE ELSE v.is_valid_delivery_associate END as is_valid_delivery_associate                      
FROM adjusted_base AS b
LEFT JOIN vda_prev AS v
  ON LOWER(TRIM(b.country_code)) = v.country_code_norm
 AND CAST(b.rider_id AS STRING)   = v.rider_id_norm
 AND v.active_month               = DATE_SUB(b.active_month, INTERVAL 1 MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl on b.country_code = dl.country_code and b.rider_id = dl.rider_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
