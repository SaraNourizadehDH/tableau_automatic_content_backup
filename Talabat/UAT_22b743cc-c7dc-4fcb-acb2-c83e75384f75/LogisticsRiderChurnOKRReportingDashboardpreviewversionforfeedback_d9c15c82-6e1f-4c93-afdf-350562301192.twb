-- 9) Final aggregation: churned riders (by S-1 flag) + active base in S split by S flag
SELECT 
  rl.cluster,
  rl.active_month,
  rl.is_valid_delivery_associate,                       -- S-1 flag (for churn)
  COUNT(DISTINCT rl.rider_id) AS churned_riders,
  COALESCE(arbf.active_riders_by_flag, 0) AS active_riders,  -- S flag (now matches total_riders)
FROM rider_list rl
LEFT JOIN active_riders_month_by_flag arbf
  ON arbf.country_code = rl.country_code
 AND IFNULL(arbf.city_name,'ALL') = IFNULL(rl.city_name,'ALL')
 AND arbf.month_s = rl.active_month
 AND arbf.is_valid_delivery_associate = rl.is_valid_delivery_associate  -- matches Boolean value
