        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 3 THEN &quot;≤ 3 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 7 THEN &quot;≤ 7 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 14 THEN &quot;≤ 14 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 21 THEN &quot;≤ 21 Days&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [last_order_date], TODAY()) &lt;= 30 THEN &quot;≤ 30 Days&quot;&#10;ELSE &quot;&gt; 30 Days&quot;&#10;END' />
