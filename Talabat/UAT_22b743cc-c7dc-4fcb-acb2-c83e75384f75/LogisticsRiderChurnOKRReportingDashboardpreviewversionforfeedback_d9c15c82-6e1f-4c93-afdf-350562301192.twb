      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4BD74D56CBD34AC7AB51E5CA085980BD'>
            <properties context=''>
              <relation connection='bigquery.0kjli6h0ebvfpn1cxd75z1sjv695' name='Custom SQL Query' type='text'>-- RIDER LIST: All riders who churned per month S, with VDA status from month S-1
-- Here: base_activity = riders active in the last 30 days (adjust as needed)

WITH base_activity AS (
  SELECT
    r.country_code,
    r.city_name,
    r.rider_id,
    MAX(r.date) AS last_order_date,
    DATE_TRUNC(MAX(r.date), MONTH) AS active_month  -- month S
  FROM `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r
  WHERE r.total_completed_logistics_deliveries &gt;&gt; 0
    AND r.date between DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) and DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) 
  GROUP BY r.country_code, r.city_name, r.rider_id
),

adjusted_base AS(
  SELECT b.*,
  min(r.date) as first_order_date,
  FROM
  base_activity b
  LEFT JOIN `tlb-data-prod.data_platform.agg_logistics_rider_performance_daily` AS r using (country_code, rider_id) 
  GROUP BY ALL 
),

vda_prev AS (
  SELECT
    LOWER(TRIM(country_code))           AS country_code_norm,
    CAST(rider_id AS STRING)            AS rider_id_norm,
    active_month,
    IFNULL(is_valid_delivery_associate, FALSE) AS is_valid_delivery_associate
  FROM `tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate`
)

SELECT
  b.country_code,
  b.city_name,
  b.rider_id,
  dl.rider_name,
  dl.rider_email,
  dl.phone_number,
  dl.last_contract_name,
  dl.is_active,
  dl.vehicle,
  b.last_order_date,
  b.first_order_date,
  CASE WHEN v.is_valid_delivery_associate IS NULL THEN FALSE ELSE v.is_valid_delivery_associate END as is_valid_delivery_associate                      
FROM adjusted_base AS b
LEFT JOIN vda_prev AS v
  ON LOWER(TRIM(b.country_code)) = v.country_code_norm
 AND CAST(b.rider_id AS STRING)   = v.rider_id_norm
 AND v.active_month               = DATE_SUB(b.active_month, INTERVAL 1 MONTH)
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider` dl on b.country_code = dl.country_code and b.rider_id = dl.rider_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='fct_logistics_churn' inline='true' name='federated.1i5ir2g0p9ape819tjabe0blwmmg' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.06z5hlh0sblmpg1fpa31x077zj8j'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='balderick.bissessur@talabat.com' workgroup-auth-mode='prompt' />
