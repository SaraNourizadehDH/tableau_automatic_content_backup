    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Preface'>
      <repository-location id='Preface' path='/t/Talabat/workbooks/LogisticsRiderChurnOKRReportingDashboard' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_85' value='top' />
        </style-rule>
      </style>
      <size maxheight='1300' maxwidth='1300' minheight='1300' minwidth='1300' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='74231' id='3' type-v2='text' w='100000' x='0' y='4769'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='12'>Welcome to the </run>
              <run bold='true' fontcolor='#ec662b' fontsize='12'>Logistics Rider Churn OKR Dashboard</run>
              <run fontcolor='#000000' fontsize='12'>, where our objective is as following:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Identify riders who have churned by not being active in a calendar month compared to previous month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Example: Rider ABC has worked in July 2025, but did not do a single order in August 2025. This indicates the rider churned. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#030ff5' fontsize='11'>Views:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>Calendar Month views:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>- Summary View: </run>
              <run fontcolor='#000000' fontsize='11'>high-level KPIs are displayed that shows detail on aggregated market, and churn month level view. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>- 3PL View: </run>
              <run fontcolor='#000000' fontsize='11'>Deep-dive provided on the churned riders for 3PL firms</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>- Rider List View: </run>
              <run fontcolor='#000000' fontsize='11'>List of riders who have churned based on the definition of not being active in a calendar month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>Rolling view up to 30 days of rider churn:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>- Rolling View: </run>
              <run fontcolor='#000000' fontsize='11'>Showcase all the riders who have not delivered an order t-minus 3 days as of today up to 30 days before today. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>Rider Winback Campaigns:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>- Rider Winback View: </run>
              <run fontcolor='#000000' fontsize='11'>Highlighting all the riders that we have called to return to our fleet with incentives</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#030ff5' fontsize='11'>Filters:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>Within the views, you can filter on the following (depending per view):</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>- Date</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>- Country</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>- Cluster (Country or City of Dubai)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>- Vehicle Type of the rider (Bike, Car etc.)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>- Valid Delivery Associate</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#030ff5' fontsize='11'>Datasource:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='11'>All rider delivery data comes from the following table: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10' italic='true'>&apos;tlb-data-prod.data_platform.agg_logistics_rider_performance&apos;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10' italic='true'>&apos;tlb-data-prod.data_platform.fct_logistics_rider_valid_delivery_associate&apos;</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>Important:</run>
              <run bold='true' fontcolor='#333333' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>The datasource for this dashboard refreshes in the morning between 09.00 AM - 10.00 AM.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#030ff5' fontsize='11'>Key definitions of dimensions &amp; metrics:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>Total # Riders: </run>
              <run fontcolor='#000000' fontsize='11'>total number of riders who were active in the specific churn calendar month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>Total # Churn Riders : </run>
              <run fontcolor='#000000' fontsize='11'>total number of riders who churned </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>Logistics Rider Churn Percentage: </run>
              <run fontcolor='#000000' fontsize='11'>the total number of churned riders in a calendar month  / the total active riders in the churn month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ec662b' fontsize='11'>Valid Delivery Associate: </run>
              <run fontcolor='#000000' fontsize='11'>Each rider is classified based on the local markets criteria if a rider is eligble as an attractive Keeta Rider for hire</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>For more information, please contact us on the following email or slack-channel:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>tlb-data-logistics@talabat.com or</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>#tlb_data_log</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
