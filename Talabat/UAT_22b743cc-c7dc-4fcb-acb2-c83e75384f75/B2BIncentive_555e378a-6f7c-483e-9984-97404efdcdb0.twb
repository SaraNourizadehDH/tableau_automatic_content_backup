      </column>
      <column caption='B2B Model 1' datatype='string' name='[Calculation_751819719322832902]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([B2B Model],[b2b_model])' />
      </column>
      <column caption='Month' datatype='date' name='[Calculation_751819719322947591]' role='dimension' type='ordinal'>
