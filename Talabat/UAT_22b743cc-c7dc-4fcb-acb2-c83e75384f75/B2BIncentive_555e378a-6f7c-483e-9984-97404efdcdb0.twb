        <aliases>
          <alias key='&quot;[federated.19t2wez1u5uppa1apn80d12d6ku6].[usr:Calculation_175640442009935876:qk]&quot;' value='Target Amount (Issued Incentive)' />
          <alias key='&quot;[federated.19t2wez1u5uppa1apn80d12d6ku6].[usr:Calculation_751819719326695437:qk]&quot;' value='Issued Incentive Amount (includes Sales Estimates)' />
        </aliases>
      </column>
      <column caption='Top/Bottom' datatype='string' name='[Calculation_1394427093665443840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Calculation_751819719323119625])) &lt;= 5&#13;&#10;THEN &quot;Top N&quot;&#13;&#10;ELSEIF&#13;&#10;WINDOW_MAX(RANK(SUM([Calculation_751819719323119625]))) - RANK(SUM([Calculation_751819719323119625])) &lt; 5&#13;&#10;THEN &quot;Bottom N&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Issued Incentive Color' datatype='boolean' name='[Calculation_1555149304343347200]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_751819719326695437] &gt; SUM([Target (EUR)]) then TRUE ELSE FALSE END' />
      </column>
      <column caption='Target Amount' datatype='integer' name='[Calculation_175640442009935876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;EUR&quot;  THEN [Target (EUR)] ELSE NULL END' />
      </column>
      <column caption='Country Code' datatype='string' name='[Calculation_751819719322292227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([country_code],[Country])' />
