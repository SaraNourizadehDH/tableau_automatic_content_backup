      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Scaffold' id='Scaffold_C22D7F69A67B470E86F91C818450B9FB'>
            <properties context=''>
              <relation join='full' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Scaffold].[DataSource]' />
                    <expression op='[Upfront Redemption Usage Incentive].[data_source]' />
                  </expression>
                </clause>
                <relation join='full' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[Scaffold].[DataSource]' />
                      <expression op='[Sales Incentive Data].[Data Source]' />
                    </expression>
                  </clause>
                  <relation connection='cloudfile:googledrive-excel-direct.1qrc37e0bti7rz15h2l1v1us3oe7' name='Scaffold' table='[Scaffold$]' type='table'>
                    <columns gridOrigin='A1:A3:no:A1:A3:0' header='yes' outcome='6'>
                      <column datatype='integer' name='DataSource' ordinal='0' />
                    </columns>
                  </relation>
                  <relation connection='cloudfile:googledrive-excel-direct.00nf7yz0kdwpo312r00f11s7stn4' name='Sales Incentive Data' table='[&apos;Sales Incentive Data$&apos;]' type='table'>
                    <columns gridOrigin='A1:K460:no:A1:K460:0' header='yes' outcome='6'>
                      <column datatype='string' name='Country' ordinal='0' />
                      <column datatype='string' name='Partner' ordinal='1' />
                      <column datatype='integer' name='tlb cofund percentage' ordinal='2' />
                      <column datatype='string' name='B2B Model' ordinal='3' />
                      <column datatype='date' name='Sale Month' ordinal='4' />
                      <column datatype='real' name='Incentive LC' ordinal='5' />
                      <column datatype='real' name='Incentive EUR' ordinal='6' />
                      <column datatype='real' name='talabat Cofund LC' ordinal='7' />
                      <column datatype='real' name='talabat Cofund EUR' ordinal='8' />
                      <column datatype='string' name='Type' ordinal='9' />
                      <column datatype='integer' name='Data Source' ordinal='10' />
                    </columns>
                  </relation>
                </relation>
                <relation connection='bigquery.10v5cqo1qj284y1buz29x0zcucth' name='Upfront Redemption Usage Incentive' type='text'><![CDATA[WITH
  base_voucher_data AS (
  SELECT
    c.country_code,
    b.campaign_id,
    b.campaign_start_date_lc,
    DATE_TRUNC(DATE(b.campaign_start_date_lc), month) AS campaign_created_month,
    DATE_TRUNC(DATE(b.campaign_end_date_lc), month) AS campaign_end_month,
    DATE(b.campaign_start_date_lc) AS campaign_created_date,
    DATE(b.campaign_end_date_lc) AS campaign_end_date,
    b.src_campaign_reference_id,
    CASE
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%coop\\_eg\\_partnership\\_%' THEN SPLIT(LOWER(b.src_campaign_reference_id),"_")[3]
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%\\_iq\\_%'
    AND LOWER(b.src_campaign_reference_id) LIKE '%digitalzonepartnership%' THEN 'digital zone'
      WHEN LOWER(a.campaign_reference_id) LIKE '%tlc%' THEN 'tlc'
      WHEN LOWER(a.campaign_reference_id) LIKE '%merit%' THEN 'merit incentives'
      WHEN LOWER(a.campaign_reference_id) LIKE '%ygag%' THEN 'ygag'
      WHEN LOWER(a.campaign_reference_id) LIKE '%advertisup%' THEN 'advertisup'
      WHEN LOWER(a.campaign_reference_id) LIKE '%ooredoo%' THEN 'ooredoo'
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(b.src_campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " "), r'^[^A-Za-z]') THEN
    CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(b.src_campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " "), r'^[^A-Za-z]') THEN REPLACE(SPLIT(LOWER(b.src_campaign_reference_id), "_")[SAFE_OFFSET(6)], "_", " ")
      ELSE REPLACE(SPLIT(LOWER(b.src_campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " ")
  END
      ELSE REPLACE(SPLIT(LOWER(b.src_campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " ")
  END
    AS partner_name,
    CASE
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%\\_iq\\_%' AND LOWER(b.src_campaign_reference_id) LIKE '%digitalzonepartnership%' THEN 25
      WHEN LOWER(b.src_campaign_reference_id)LIKE '%aimia%'
    AND c.country_code = 'AE' THEN 4.75
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%cameoo%' THEN 3
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%omantel%' THEN 7
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%ygagxboubyan%' THEN 16.67
      WHEN campaign_b2b_talabat_commission_percentage IS NULL THEN SAFE_CAST( (CASE
          WHEN ARRAY_REVERSE(SPLIT(LOWER(b.src_campaign_reference_id), "_"))[SAFE_OFFSET(3)] LIKE "%%discount" THEN SPLIT(ARRAY_REVERSE(SPLIT(LOWER(b.src_campaign_reference_id), "_"))[SAFE_OFFSET(3)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(b.src_campaign_reference_id) LIKE "%_full_%"
        AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(b.src_campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] LIKE "%discount%" THEN SPLIT(ARRAY_REVERSE(SPLIT(SPLIT(LOWER(b.src_campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)], "%")[SAFE_OFFSET(0)]
          WHEN LOWER(b.src_campaign_reference_id) LIKE "%_full_%" AND ARRAY_REVERSE(SPLIT(SPLIT(LOWER(b.src_campaign_reference_id), "_full_")[SAFE_OFFSET(0)], "_"))[SAFE_OFFSET(0)] NOT LIKE "%discount%" AND SPLIT(LOWER(b.src_campaign_reference_id), "_full_")[SAFE_OFFSET(1)] LIKE "%discount%" THEN SPLIT(SPLIT(LOWER(b.src_campaign_reference_id), "_full_")[SAFE_OFFSET(1)], "%")[SAFE_OFFSET(0)]
          ELSE "0"
      END
        ) AS FLOAT64)
      ELSE campaign_b2b_talabat_commission_percentage
  END
    AS talabat_commission_percentage,
  IF
    (b.src_campaign_reference_id = 'VoucherGenericRetention_ae_partnership_B2B_100%_emirates_250304-260304_uc_5000x50AED_Full_20%discount_all_one_op', 3275, b.codes_count) AS issued_vouchers,
    CASE
      WHEN LOWER(b.src_campaign_reference_id) LIKE "%sale%" THEN "Sales"
      WHEN LOWER(b.src_campaign_reference_id) LIKE "%redemption2%"
    OR LOWER(b.src_campaign_reference_id) LIKE "%cameoo%" THEN "Redemption"
      WHEN LOWER(b.src_campaign_reference_id) LIKE "%redemption%" THEN "Usage"
      WHEN LOWER(b.src_campaign_reference_id) LIKE "%full%" THEN "Upfront"
      WHEN b.src_campaign_reference_id IN ( 'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x7000_all_one_bth', 'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x10000_all_one_bth', 'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x5000_all_one_bth' ) THEN "Upfront"
      ELSE "Usage"
  END
    b2b_model,
    cc.discount_type,
    --cc.discount_value AS discount_value_lc,
    a.order_discount_lc AS discount_value_lc,
    c.currency,
    d.order_date,
    d.order_id,
    d.gmv_amount_lc,
    d.gmv_amount_eur,
    DATE(a.created_on_time_lc) AS customer_redeem_date,
    DATE(a.valid_till_time_lc) AS voucher_expiry_date,
    a.voucher_reference_id AS voucher_code_id,
  FROM
    `tlb-data-prod.data_platform.dim_incentives_voucher` b
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` a
  ON
    a.voucher_id = b.voucher_id
  INNER JOIN
    `tlb-data-prod.data_platform_loyalty.voucher_options` cc
  ON
    cc.id = b.campaign_id
  INNER JOIN
    `tlb-data-prod.data_platform.dim_country_info` c
  ON
    b.country_id = c.country_id
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` d
  ON
    CAST(d.order_id AS string) = a.order_id
    AND d.is_successful
  WHERE
    b.bin_group_id IS NULL
    AND b.incentive_type_detail = "VOUCHER_CODE"
    AND b.codes_count >> 0
    AND ((LOWER(b.src_campaign_reference_id) LIKE "%b2b%"
        AND NOT ( b.src_campaign_reference_id IN ( 'VoucherGenericRetention_ae_partnership_B2B_100%_TIERRACAFE_231215-240615_vw_10000x25%AED_Sales_25%discount_all_one_op',
            'VoucherGenericRetention_ae_partnership_B2B_100%_Terra Mezze_231226-240331_uc_30x30AED_Sales_30AED_all_one_op',
            'VoucherGenericRetention_ae_partnership_B2B_100%_KavaandChai_231215-240531_uc_10x30AED_Sales_30AED_all_one_op',
            'coop_jo_Partnership_B2B_100%_Merit_Incentives_230407-240407_uc_20x25JOD_Full_4.5%discount_all_one_op',
            'VoucherGenericRetention_ae_partnership_B2B_100%_emirates_250327-260327_uc_2398x50AED_Full_20%discount_all_one_op_old' )
          OR LOWER(b.src_campaign_reference_id) LIKE '%duplicate%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%test%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%vendor%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%mkt%carc%'
          OR b.campaign_id = '61c78a5f-30d5-4a7a-b3f5-cfcc84e44d51' ))
      OR b.src_campaign_reference_id IN ( 'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x7000_all_one_bth',
        'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x10000_all_one_bth',
        'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x5000_all_one_bth',
        'coop_eg_Partnership_Pril100_241225-250124_vw_15000X100LE_all_one_bth',
        'coop_eg_Partnership_PrilFD_241225-250124_vw_16600XFD_all_one_bth',
        'coop_eg_Partnership_PrilFD2_250127-250210_vw_16600XFD_all_one_bth',
        'coop_eg_Partnership_Samsung1000_241028-241215_gn_2500X1000LE_all_one_bth',
        'coop_eg_Partnership_Samsung1000_250114-250125_gn_30X1000LE_all_one_bth5',
        'coop_eg_Partnership_Shokran100_241205-241231_vw_10000X100LE_all_one_bth',
        'coop_eg_Partnership_Shokran20_241205-241231_vw_10000X20LE_all_one_bth',
        'coop_eg_Partnership_Shokran200_241205-241231_vw_10000X200LE_all_one_bth',
        'coop_eg_Partnership_VF-Digital0Mov_250108-250130_vw_42000X50LE_all_one_bth',
        'coop_eg_Partnership_VF-Digital250Mov_250108-250130_vw_10000X50LE_all_one_bth',
        'coop_eg_Partnership_VF-Red100_241117-241230_vw_10000X100LE_all_one_bth',
        'coop_eg_Partnership_VF-Red1000_241117-241230_vw_10000X1000LE_all_one_bth',
        'coop_eg_Partnership_VF-Red1500_241117-241230_vw_10000X1500LE_all_one_bth',
        'coop_eg_Partnership_VF-Red200_241117-241230_vw_10000X200LE_all_one_bth',
        'coop_eg_Partnership_VF-Red300_241117-241230_vw_10000X300LE_all_one_bth',
        'coop_eg_Partnership_VF-Red500_241117-241230_vw_10000X500LE_all_one_bth',
        'coop_eg_Partnership_VF-Red700_241117-241230_vw_10000X700LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250108-250111_vw_8400X250LE_all_one_bth',
        'coop_eg_Partnership_Coca_250112-250131_vw_1000X50LE_all_one_bth',
        'coop_eg_Partnership_Coca50_241223-240108_vw_3000X50LE_all_one_bth',
        'coop_eg_Partnership_Fit&Fix_250114-250125_gn_7X500LE_all_one_bth',
        'coop_eg_Partnership_Cocacola50_250203-250228_uc_1000X50LE_all_one_bth',
        'coop_eg_Partnership_Fit&Fix_250202-250220_gn_20X500LE_all_one_bth',
        'coop_eg_Partnership_GrillSetup_Owest_250220-250227_uc_2000X100LE_all_one_bth',
        'coop_eg_Partnership_Pril100_250129-250214_vw_11000X100LE_all_mult_bth',
        'coop_eg_Partnership_Pril100_250212-250225_vw_6000X100LE_all_mult_bth',
        'coop_eg_Partnership_Samsung1000_250203-250220_gn_30X1000LE_all_one_bth',
        'coop_eg_Partnership_Shokran100_250210-250228_vw_10000X100LE_all_one_bth',
        'coop_eg_Partnership_Shokran20_250210-250228_vw_10000X20LE_all_one_bth',
        'coop_eg_Partnership_Shokran200_250210-250228_vw_10000X200LE_all_one_bth',
        'coop_eg_Partnership_Tradeline-tmart-Box_250226-250310_vw_350X80LE_all_one_bth',
        'coop_eg_Partnership_VF-Digital200_250203-250228_vw_15000X200LE_all_one_bth',
        'coop_eg_Partnership_VF-Flex100_250211-250228_uc_9000X50LE_all_one_bth',
        'coop_eg_Partnership_VfMass200_250219-250331_uc_5000X200LE_all_one_bth',
        'coop_eg_Partnership_VF-Security_250217-250320_uc_336X800LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box1_250220-250306_vw_3000X60LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box1_250222-250306_vw_3000X175LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box2_250222-250306_vw_2000X220LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box3_250220-250306_vw_1000X120LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box3_250222-250306_vw_1000X320LE_all_one_bth',
        'coop_eg_Partnership_Pril100_250304-250315_uc_2500X100LE_all_mult_bth',
        'coop_eg_Partnership_PrilFD4_250304-250315_uc_10000Xfd_all_mult_bth',
        'coop_eg_Partnership_VF-tmart-Box1_250324-250331_vw_3X175LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box2_250324-250331_vw_8X215LE_all_one_bth',
        'coop_eg_Partnership_VF-tmart-Box3_250324-250331_vw_35X300LE_all_one_bth',
        'coop_eg_Partnership_VfMass50_250219-250331_uc_80000X50LE_all_one_bth',
        'coop_eg_Partnership_VfMass100_250219-250331_uc_30000X100LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250220-250304_vw_10000X100LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250220-250304_vw_10000X150LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250220-250304_vw_10000X200LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250220-250304_vw_15000X250LE_all_one_bth',
        'coop_eg_Partnership_VF-Tmart_250220-250304_vw_10000X300LE_all_one_bth' ))
    AND DATE_TRUNC(b.campaign_start_date_lc, month) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 24 MONTH), MONTH)),
  voucher_upfront_incentive AS (
  SELECT
    country_code,
    partner_name,
    talabat_commission_percentage AS tlb_cofund_percentage,
    b2b_model,
    DATE_TRUNC(DATE(campaign_start_date_lc), MONTH) AS month,
    SUM(incentive_lc) AS incentive_lc,
    SUM(incentive_eur) AS incentive_eur,
    SUM(talabat_cofund_lc) AS talabat_cofund_lc,
    SUM(talabat_cofund_eur) AS talabat_cofund_eur,
    "voucher" AS type,
    1 AS data_source
  FROM (
    SELECT
      a.country_code,
      a.campaign_id,
      a.src_campaign_reference_id,
      a.issued_vouchers,
      a.campaign_start_date_lc,
      a.discount_type,
      a.discount_value_lc,
      a.issued_vouchers*a.discount_value_lc AS incentive_lc,
      a.issued_vouchers*(a.discount_value_lc/exc.exchange_rate_value) AS incentive_eur,
      a.b2b_model,
      a.talabat_commission_percentage,
      a.issued_vouchers*a.discount_value_lc * (a.talabat_commission_percentage / 100) AS talabat_cofund_lc,
      a.issued_vouchers*(a.discount_value_lc/exc.exchange_rate_value) * (a.talabat_commission_percentage / 100) AS talabat_cofund_eur,
      CASE
        WHEN LOWER(a.src_campaign_reference_id) LIKE '%merit%' THEN 'merit incentives'
        ELSE a.partner_name
    END
      AS partner_name
    FROM
      base_voucher_data a
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_exchange_rate` exc
    ON
      exc.exchange_rate_date = DATE(a.campaign_start_date_lc)
      AND exc.country_code = a.country_code
      AND exc.exchange_rate_base = 'EUR'
    WHERE
      b2b_model = 'Upfront'
      AND campaign_start_date_lc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
    GROUP BY
      ALL )
  GROUP BY
    ALL ),
  voucher_usage_incentive AS (
  SELECT
    country_code,
    partner_name,
    talabat_commission_percentage AS tlb_cofund_percentage,
    b2b_model,
    DATE_TRUNC(DATE(order_date), MONTH) AS month,
    SUM(incentive_lc) AS incentive_lc,
    SUM(incentive_eur) AS incentive_eur,
    SUM(talabat_cofund_lc) AS talabat_cofund_lc,
    SUM(talabat_cofund_eur) AS talabat_cofund_eur,
    "voucher" AS type,
    1 AS data_source
  FROM (
    SELECT
      a.country_code,
      a.partner_name,
      a.discount_type,
      a.discount_value_lc AS incentive_lc,
      a.discount_value_lc/exc.exchange_rate_value AS incentive_eur,
      a.src_campaign_reference_id,
      a.campaign_id,
      a.talabat_commission_percentage,
      (a.discount_value_lc * talabat_commission_percentage) /100 AS talabat_cofund_lc,
      ((a.discount_value_lc * talabat_commission_percentage)/exc.exchange_rate_value) / 100 AS talabat_cofund_eur,
      a.b2b_model,
      a.order_date,
      a.order_id,
      a.gmv_amount_lc,
      a.gmv_amount_eur
    FROM
      base_voucher_data a
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_exchange_rate` exc
    ON
      exc.exchange_rate_date = DATE(a.order_date)
      AND exc.country_code = a.country_code
      AND exc.exchange_rate_base = 'EUR'
    WHERE
      a.b2b_model = 'Usage'
      AND order_id IS NOT NULL
      AND a.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)AND partner_name NOT LIKE '%ygag%' )
  GROUP BY
    ALL ),
  voucher_redemption_incentive AS (
  SELECT
    country_code,
    partner_name,
    talabat_commission_percentage AS tlb_cofund_percentage,
    b2b_model,
    DATE_TRUNC(DATE(customer_redeem_date), MONTH) AS month,
    SUM(incentive_lc) AS incentive_lc,
    SUM(incentive_eur) AS incentive_eur,
    SUM(talabat_cofund_lc) AS talabat_cofund_lc,
    SUM(talabat_cofund_eur) AS talabat_cofund_eur,
    "voucher" AS type,
    1 AS data_source
  FROM (
    SELECT
      a.country_code,
      a.partner_name,
      a.discount_type,
      a.discount_value_lc AS incentive_lc,
      a.discount_value_lc/exc.exchange_rate_value AS incentive_eur,
      a.src_campaign_reference_id,
      a.campaign_id,
      a.talabat_commission_percentage,
      (a.discount_value_lc * talabat_commission_percentage) /100 AS talabat_cofund_lc,
      ((a.discount_value_lc * talabat_commission_percentage)/exc.exchange_rate_value) / 100 AS talabat_cofund_eur,
      a.b2b_model,
      a.customer_redeem_date
    FROM
      base_voucher_data a
    LEFT JOIN
      `tlb-data-prod.data_platform.dim_exchange_rate` exc
    ON
      exc.exchange_rate_date = DATE(a.customer_redeem_date)
      AND exc.country_code = a.country_code
      AND exc.exchange_rate_base = 'EUR'
    WHERE
      a.b2b_model = 'Redemption'
      AND a.customer_redeem_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
      AND partner_name NOT LIKE '%ygag%' )
  GROUP BY
    ALL ),
  base_credit_data AS (
  SELECT
    CASE
      WHEN LOWER(c.description) LIKE '%higher colleges of technology%' AND c.date >>= '2025-01-01' THEN 7
      WHEN LOWER(ARRAY_REVERSE(SPLIT(c.description,"_"))[SAFE_OFFSET(2)]) LIKE '%discount%' THEN SAFE_CAST(SPLIT(ARRAY_REVERSE(SPLIT(c.description,"_"))[SAFE_OFFSET(2)],"%")[SAFE_OFFSET(0)] AS NUMERIC)
      WHEN LOWER(c.description) LIKE '%higher colleges of technology%' THEN 6
      WHEN LOWER(c.description) LIKE '%ooredoo%' THEN 2
      WHEN LOWER(c.description) LIKE '%siemens%' THEN 8
      WHEN LOWER(c.description) LIKE '%syngenta%' THEN 10
      WHEN LOWER(c.description) LIKE '%roche%' OR LOWER(c.description) LIKE '%nielsen%' OR LOWER(c.description) LIKE '%aram%meem%' OR LOWER(c.description) LIKE '%arabia%weather%' OR LOWER(c.description) LIKE '%mondelez%' OR LOWER(c.description) LIKE '%atlas%copco%' OR LOWER(c.description) LIKE '%cbk%' OR LOWER(c.description) LIKE '%undp%' OR LOWER(c.description) LIKE '%audiomob%' OR LOWER(c.description) LIKE '%dnatatravel%' OR LOWER(c.description) LIKE '%bms(egypt)%' OR LOWER(c.description) LIKE '%jonson controls%' THEN 0
      ELSE NULL
  END
    AS tlb_cofund_percentage,
    c.country_code,
    c.description,
    c.transaction_id,
    c.account_id,
    c.date AS credit_date,
    c.expiry_date AS credit_expiry_date,
    c.amount_lc,
    c.amount_eur,
    c.amount_lc/c.amount_eur AS conversion_factor,
    CAST(IFNULL(-d.detail_amount_lc,0) AS NUMERIC) AS used_amount_lc,
    o.order_id,
    o.order_date,
    o.is_successful AS is_successful_order,
    o.gmv_amount_eur,
    o.gmv_amount_lc,
    d.order_id AS transaction_order_id,
    d.date AS transaction_order_date,
    -d.detail_amount_lc AS detail_amount_lc,
    -d.detail_amount_eur AS detail_amount_eur,
    d.transaction_type_id,
    CASE
      WHEN c.description LIKE '%Al Mulla%' THEN 'Al Mulla Group'
      WHEN c.description LIKE '%Roche Second Agreement%' THEN 'Roche 2'
      WHEN c.description LIKE '%Roche\\_%' THEN 'Roche'
      WHEN (LOWER(c.description) LIKE '%nielsen%'
      AND LOWER(c.description) LIKE '%clients%') THEN 'Nielsen (July Agreement)'
      WHEN LOWER(c.description) LIKE '%nielsen%' THEN 'Nielsen'
      WHEN LOWER(c.description) LIKE '%\\_mondelez\\_%' THEN 'Mondelez'
      WHEN LOWER(c.description) LIKE '%siemens\\_%' THEN 'Siemens'
      WHEN LOWER(c.description) LIKE '%\\_sigmaegp\\_%' THEN 'Sigma'
      WHEN LOWER(c.description) LIKE '%\\_ego\\_%' THEN 'EGO'
      WHEN LOWER(c.description) LIKE '%\\_bms(egypt)\\_%' THEN 'BMS'
      WHEN LOWER(c.description) LIKE '%\\_audiomob\\_%' THEN 'AudioMob'
      WHEN LOWER(c.description) LIKE '%\\_dnatatravel\\_%' THEN 'dnata Travel'
      WHEN LOWER(c.description) LIKE '%enbd\\_%' THEN 'ENBD'
      WHEN LOWER(c.description) LIKE '%\\_ooredoo%' THEN 'Ooredoo'
      WHEN LOWER(c.description) LIKE '%\\_nbkghatawi\\_%' THEN 'NBK'
      WHEN LOWER(c.description) LIKE '%\\_abk(kuwait)\\_%' THEN 'ABK'
      WHEN (LOWER(c.description) LIKE '%\\_aub%' AND LOWER(c.description) LIKE '%new campaign%') THEN 'Ahli United Bank (New Agreement)'
      WHEN LOWER(c.description) LIKE '%\\_aub%' THEN 'Ahli United Bank'
      WHEN LOWER(c.description) LIKE '%f\\_and\\_g\\_trade%' THEN 'F&G Trade'
      WHEN LOWER(c.description) LIKE '%\\_omantelmakasib\\_%' THEN 'Omantel'
      WHEN LOWER(c.description) LIKE '%\\_fifa\\_%' THEN 'FIFA'
      WHEN LOWER(c.description) LIKE '%\\_kib\\_%' THEN 'KIB'
      WHEN LOWER(c.description) LIKE '%\\_cbk(kuwait)\\_%' THEN 'CBK'
      WHEN LOWER(c.description) LIKE '%\\_techne\\_%' THEN 'Techne Summit (KDGP)'
      WHEN LOWER(c.description) LIKE '%\\_arabia%weather\\_%' THEN 'Arabia Weather'
      WHEN LOWER(c.description) LIKE '%aram%meem%' THEN 'Aram Meem'
      WHEN LOWER(c.description) LIKE '%syngenta eg%' THEN 'Syngenta'
      WHEN LOWER(c.description) LIKE '%atlas copco eg%' THEN 'Atlas Copco'
      WHEN LOWER(c.description) LIKE '%higher colleges of technology%' THEN 'HCT'
      WHEN LOWER(c.description) LIKE '%jonson controls egypt%' THEN 'Johnson Controls Egypt'
      WHEN LOWER(c.description) LIKE '%hayat%' AND LOWER(c.description) LIKE '%egypt%' THEN 'Hayat Egypt'
      ELSE SPLIT(c.description,"_")[1]
  END
    AS partner_name,
    ROW_NUMBER() OVER(PARTITION BY c.country_code, c.transaction_id, o.order_id ORDER BY d.transaction_type_id ASC) AS exclude_row_num_2,
    #excluding duplicates due TO rider tips being double counted AS used amount
    CASE
      WHEN (c.description LIKE '%Roche%' ) OR (LOWER(c.description) LIKE '%nielsen%' AND NOT (LOWER(c.description) LIKE '%clients%')) OR (LOWER(c.description) LIKE '%higher colleges of technology%') OR (LOWER(c.description) LIKE '%redemption%') OR (LOWER(c.description) LIKE '%aram%meem%') OR (LOWER(c.description) LIKE '%arabia%weather%') OR (LOWER(c.description) LIKE '%dnata%' AND LOWER(c.description) NOT LIKE '%extension%' AND EXTRACT(YEAR FROM c.date)=2025) THEN 'Usage'
      ELSE 'Upfront'
  END
    AS b2b_model
  FROM
    `tlb-data-prod.data_platform.fct_wallet_transaction` c
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_wallet_transaction_details` d
  ON
    c.transaction_id = d.parent_earn_transaction_id
    AND (d.transaction_type_id IS NULL
      OR d.transaction_type_id <<>> 11)
  LEFT JOIN
    `tlb-data-prod.data_platform.fct_order_info` o
  ON
    IFNULL(d.order_id,-1) = o.order_id
  WHERE
    c.description LIKE '%B2B%'
    AND DATE_TRUNC(c.date,month)>>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
    AND IFNULL(d.transaction_type_id,0) <<>> 23
  GROUP BY
    ALL ),
  credit_upfront_incentive AS (
  SELECT
    country_code,
    partner_name,
    tlb_cofund_percentage,
    b2b_model,
    DATE_TRUNC(credit_date,MONTH) AS month,
    SUM(amount_lc) AS incentive_amount_lc,
    SUM(amount_eur) AS incentive_amount_eur,
    SUM(talabat_cofund_lc) AS talabat_cofund_lc,
    SUM(talabat_cofund_eur) AS talabat_cofund_eur,
    "credit" AS type,
    1 AS data_source
  FROM (
    SELECT
      country_code,
      description,
      partner_name,
      transaction_id,
      account_id,
      credit_date,
      amount_lc,
      amount_eur,
      tlb_cofund_percentage,
      amount_lc*tlb_cofund_percentage/100 AS talabat_cofund_lc,
      amount_eur*tlb_cofund_percentage/100 AS talabat_cofund_eur,
      b2b_model
    FROM
      base_credit_data
    WHERE
      b2b_model = 'Upfront'
      AND exclude_row_num_2 = 1
    GROUP BY
      ALL )
  GROUP BY
    ALL ),
  credit_usage_incentive AS (
  SELECT
    country_code,
    partner_name,
    tlb_cofund_percentage,
    b2b_model,
    DATE_TRUNC(order_date,MONTH) AS month,
    SUM(incentive_lc) AS incentive_lc,
    SUM(incentive_eur) AS incentive_eur,
    SUM(incentive_lc)*tlb_cofund_percentage/100 AS talabat_cofund_lc,
    SUM(incentive_eur)*tlb_cofund_percentage/100 AS talabat_cofund_eur,
    "credit" AS type,
    1 AS data_source
  FROM (
    SELECT
      ro.country_code,
      ro.partner_name,
      ro.account_id,
      ro.order_id,
      ro.order_date,
      ro.used_amount_lc,
      ro.used_amount_eur,
      SUM(d.detail_amount_lc) AS refunded_amount_lc,
      SUM(d.detail_amount_eur) AS refunded_amount_eur,
      CASE
        WHEN partner_name IN ('Roche', 'Roche 2', 'Nielsen') THEN ro.used_amount_lc - SUM(IFNULL(d.detail_amount_lc,0))
        ELSE ro.used_amount_lc
    END
      AS incentive_lc,
      CASE
        WHEN partner_name IN ('Roche', 'Roche 2', 'Nielsen') THEN ro.used_amount_eur - SUM(IFNULL(d.detail_amount_eur,0))
        ELSE ro.used_amount_eur
    END
      AS incentive_eur,
      credit_date,
      d.transaction_type_id,
      ro.tlb_cofund_percentage,
      ro.b2b_model
    FROM (
      SELECT
        country_code,
        partner_name,
        account_id,
        credit_date,
        IFNULL(order_id, transaction_order_id) AS order_id,
        IFNULL(order_date, transaction_order_date) AS order_date,
        SUM(detail_amount_lc) AS used_amount_lc,
        SUM(detail_amount_eur) AS used_amount_eur,
        tlb_cofund_percentage,
        b2b_model
      FROM
        base_credit_data
      WHERE
        b2b_model = 'Usage'
        AND exclude_row_num_2 = 1
      GROUP BY
        ALL ) ro
    LEFT JOIN
      `tlb-data-prod.data_platform.fct_wallet_transaction_details` d
    ON
      d.order_id = ro.order_id
      AND ((d.parent_earn_transaction_id = 0
          AND d.transaction_type_id IN (3,
            7,
            2,
            303))
        OR (d.transaction_type_id = 23))
    GROUP BY
      ALL )
  GROUP BY
    ALL )
SELECT
  *
FROM
  credit_usage_incentive
WHERE
  incentive_lc IS NOT NULL
  AND month >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
UNION ALL
SELECT
  *
FROM
  credit_upfront_incentive
WHERE
  month >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
UNION ALL
SELECT
  *
FROM
  voucher_usage_incentive
UNION ALL
SELECT
  *
FROM
  voucher_upfront_incentive
UNION ALL
SELECT
  *
FROM
  voucher_redemption_incentive]]></relation>
              </relation>
