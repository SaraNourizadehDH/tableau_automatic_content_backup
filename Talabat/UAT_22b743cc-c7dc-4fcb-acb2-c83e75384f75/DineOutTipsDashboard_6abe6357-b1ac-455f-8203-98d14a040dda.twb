    <worksheet name='Sheet 16'>
      <table>
        <view>
          <datasources>
            <datasource caption='dineout_tips_dashboard' name='federated.0ekbo7n0hp0wt910xbvnz1a781du' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Tip_Selection_Normalization' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders Tipped&quot;'>
              <calculation class='tableau' formula='&quot;Orders Tipped&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ekbo7n0hp0wt910xbvnz1a781du'>
            <column caption='discount_per_basket' datatype='real' name='[Calculation_280841710228258816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([discount_amount_lc_sum])/SUM([basket_amount_sum]) = 0&#10;THEN NULL&#10;ELSE SUM([discount_amount_lc_sum])/SUM([basket_amount_sum])&#10;END' />
            </column>
            <column caption='orders_with_tip_customer_10_perc_count_perc' datatype='real' name='[Calculation_6154380049025171456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6154380049028124677] THEN NULL&#10;ELSE SUM([orders_with_tip_customer_10_perc_count])/[Calculation_6154380049032003590]&#10;END' />
            </column>
            <column caption='normalization_denominator_threshold' datatype='boolean' name='[Calculation_6154380049028124677]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_6154380049032003590] &lt;= 2' />
            </column>
            <column caption='normalization_denominator' datatype='integer' name='[Calculation_6154380049032003590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Orders Tipped&apos; THEN SUM([orders_with_tip_customer_count])&#10;  WHEN &apos;Orders Total&apos; THEN SUM([orders_count])&#10;END' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_6808950102632271872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name]&#10;&#10;//IF [Brand_Original] = &apos;unknown&apos;&#10;//THEN [Chain]&#10;//ELSE [Brand_Original]&#10;//END' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_800233406365929472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([vendor_id (Custom SQL Query1)]) + &apos; - &apos; + [vendor_name (Custom SQL Query1)]' />
            </column>
            <column caption='Area' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[basket_amount_customer_tipped_orders_lc_sum]' role='measure' type='quantitative' />
            <column caption='basket_amount_lc_sum' datatype='real' name='[basket_amount_sum]' role='measure' type='quantitative' />
            <column caption='Chain_Original' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
