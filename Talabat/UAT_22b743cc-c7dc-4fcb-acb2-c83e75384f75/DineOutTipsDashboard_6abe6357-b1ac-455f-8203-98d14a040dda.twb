      <column caption='orders_with_tip_customer_perc' datatype='real' name='[Calculation_5530209283127037954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([orders_count]) &lt;= 1 THEN NULL&#10;ELSE SUM([orders_with_tip_customer_count])/SUM([orders_count])&#10;END' />
      </column>
      <column caption='orders_with_tip_customer_10_perc_count_perc' datatype='real' name='[Calculation_6154380049025171456]' role='measure' type='quantitative'>
