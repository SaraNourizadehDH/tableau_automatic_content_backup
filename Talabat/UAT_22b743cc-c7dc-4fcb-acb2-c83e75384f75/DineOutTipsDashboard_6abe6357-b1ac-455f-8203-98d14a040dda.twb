      <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ekbo7n0hp0wt910xbvnz1a781du].[today_date (copy)_2599491820949831680]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0ekbo7n0hp0wt910xbvnz1a781du].[order_year_month]' caption='latest_date_filter' datatype='date' default-format='*mmm &apos;yy' hidden='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-01#'>
          <calculation class='tableau' formula='#2025-06-01#' />
