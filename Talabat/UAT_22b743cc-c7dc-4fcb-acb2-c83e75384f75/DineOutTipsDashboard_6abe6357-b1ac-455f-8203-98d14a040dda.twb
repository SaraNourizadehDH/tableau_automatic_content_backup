        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query' type='text'><![CDATA[WITH query_params AS (
  SELECT
    CAST(DATE_TRUNC(CURRENT_DATE('Asia/Dubai') - INTERVAL 6 MONTH, MONTH) AS DATE) AS start_date, -- '2025-01-01'
    CAST(DATE_TRUNC(CURRENT_DATE('Asia/Dubai'), MONTH) AS DATE) AS end_date,
),
  base AS (
  SELECT
    *
  FROM
    `tlb-data-prod.data_platform.fct_order_info` AS f
  WHERE
    f.is_successful = TRUE
    AND f.is_refunded = FALSE
    AND f.delivery_arrangement = 'TDINE'
    AND f.order_date >>= (SELECT start_date FROM query_params)
    -- AND f.order_date <<= (SELECT end_date FROM query_params)
    AND is_test = FALSE
  ),
  fct_order_info_ranked AS (
    SELECT
        account_id,
        order_id,
        order_date,

        -- delivery_arrangement,
        
        -- ROW_NUMBER() OVER (window_global ORDER BY order_time_utc ASC) AS rank_global_asc,
        -- ROW_NUMBER() OVER (window_global ORDER BY order_time_utc DESC) AS rank_global_desc,

        CASE WHEN delivery_arrangement = 'TDINE'
             THEN ROW_NUMBER() OVER (window_tdine ORDER BY order_time_utc ASC)
        END AS rank_tdine_asc,
        -- CASE WHEN delivery_arrangement = 'TDINE'
        --      THEN ROW_NUMBER() OVER (window_tdine ORDER BY order_time_utc DESC)
        -- END AS rank_tdine_desc,
    FROM
        `tlb-data-prod.data_platform.fct_order_info`
    WHERE
        is_successful = TRUE
        AND is_refunded = FALSE
        AND is_test = FALSE
    QUALIFY
      -- rank_global_asc = 1
      -- or rank_global_desc = 1
      rank_tdine_asc = 1
      -- or rank_tdine_desc = 1
    WINDOW
      window_global AS (PARTITION BY account_id),
      window_tdine AS (PARTITION BY account_id, delivery_arrangement)
),
  account_first_last AS (
    SELECT
      f.account_id,

      -- MIN(f.order_date) AS order_date_global_first,
      -- MAX(f.order_date) AS order_date_global_latest,

      -- MIN(CASE WHEN f.delivery_arrangement = 'TDINE' THEN f.order_date END) AS order_date_tdine_first,
      -- MAX(CASE WHEN f.delivery_arrangement = 'TDINE' THEN f.order_date END) AS order_date_tdine_latest,

      MAX(CASE WHEN f.rank_tdine_asc = 1 THEN f.order_id END) AS order_id_tdine_first,
      -- MAX(CASE WHEN f.rank_tdine_desc = 1 THEN f.order_id END) AS order_id_tdine_latest,
    FROM fct_order_info_ranked f
    GROUP BY
        f.account_id
  ),
  vendor_list AS (
  SELECT
    f.vendor_id
  FROM base f
  UNION distinct
  SELECT
    dvi.vendor_id
  FROM
    `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
  WHERE
    dvi.is_dineout = TRUE
  -- SELECT
  --   dvi.vendor_id
  -- FROM
  --   `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
  -- WHERE
  --   dvi.vendor_id = 699895
    ),
  agg_pre AS (
  SELECT
    f.vendor_id,
    DATE_TRUNC(f.order_date, MONTH) AS order_year_month,
    CASE
      WHEN f.order_id = afl.order_id_tdine_first THEN 'acquisition'
      ELSE 'repeat'
    END AS order_type_tdine,

    f.account_id,
    f.order_id,
    f.basket_amount_lc,
    f.gmv_amount_lc,
    
    f.discount_amount_lc AS discount_amount_lc,
    ftwt.tdine_waiter_tip_amount_lc AS tip_customer_amount_lc,
    ROUND(ftwt.tdine_waiter_tip_amount_lc / NULLIF(f.basket_amount_lc, 0), 2) AS tip_customer_perc_basket_value,
  FROM base f
  LEFT JOIN `tlb-data-prod.data_platform.fct_tdine_waiter_tips` ftwt
     ON ftwt.order_id=f.order_id
  LEFT JOIN account_first_last AS afl using (account_id)
  GROUP BY
    ALL
),
agg_pre2 AS (
  SELECT
    f.*,
    CASE
      WHEN f.tip_customer_amount_lc >> 0 THEN TRUE
      ELSE FALSE
    END as is_tipped,

    CASE
      WHEN tip_customer_perc_basket_value = 0.10 THEN '10%'
      WHEN tip_customer_perc_basket_value = 0.15 THEN '15%'
      WHEN f.tip_customer_amount_lc = 0 THEN '0'
      WHEN f.tip_customer_amount_lc <<= 2 THEN '<<=2'
      WHEN f.tip_customer_amount_lc <<= 5 THEN '<<=5'
      ELSE '>>5'
    END AS tip_customer_selection_bucket,

    CASE
      WHEN f.discount_amount_lc << 10 THEN '<<=10'
      WHEN f.discount_amount_lc <<= 30 THEN '<<=30'
      WHEN f.discount_amount_lc <<= 50 THEN '<<=50'
      ELSE '>>50'
    END AS discount_amount_lc_bucket,
  FROM agg_pre f
),
  
  agg AS (
  SELECT
    f.vendor_id,
    order_year_month,
    order_type_tdine,

    COUNT(DISTINCT f.order_id) AS orders_count,
    COUNT(DISTINCT CASE WHEN f.is_tipped THEN f.order_id END) AS orders_with_tip_customer_count,

    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '10%' THEN f.order_id END) AS orders_with_tip_customer_10_perc_count,
    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '15%' THEN f.order_id END) AS orders_with_tip_customer_15_perc_count,
    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '0' THEN f.order_id END) AS orders_with_tip_customer_0_lc_count,
    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '<<=2' THEN f.order_id END) AS orders_with_tip_customer_lte_2_lc_count,
    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '<<=5' THEN f.order_id END) AS orders_with_tip_customer_lte_5_lc_count,
    COUNT(DISTINCT CASE WHEN tip_customer_selection_bucket = '>>5' THEN f.order_id END) AS orders_with_tip_customer_gt_5_lc_count,

    SUM(basket_amount_lc) AS basket_amount_sum,
    SUM(CASE WHEN f.is_tipped THEN basket_amount_lc ELSE 0 END) AS basket_amount_customer_tipped_orders_lc_sum,

    SUM(f.discount_amount_lc) AS discount_amount_lc_sum,
    SUM(CASE WHEN f.is_tipped THEN f.discount_amount_lc ELSE 0 END) AS discount_amount_customer_tipped_orders_lc_sum,

    COUNT(DISTINCT CASE WHEN discount_amount_lc_bucket = '<<=10' THEN f.order_id END) AS orders_with_total_discount_lte_10_lc_count,
    COUNT(DISTINCT CASE WHEN discount_amount_lc_bucket = '<<=30' THEN f.order_id END) AS orders_with_total_discount_lte_30_lc_count,
    COUNT(DISTINCT CASE WHEN discount_amount_lc_bucket = '<<=50' THEN f.order_id END) AS orders_with_total_discount_lte_50_lc_count,
    COUNT(DISTINCT CASE WHEN discount_amount_lc_bucket = '>>50' THEN f.order_id END) AS orders_with_total_discount_gt_50_lc_count,

    COUNT(DISTINCT CASE WHEN f.is_tipped and discount_amount_lc_bucket = '<<=10' THEN f.order_id END) AS orders_with_tip_customer_total_discount_lte_10_lc_count,
    COUNT(DISTINCT CASE WHEN f.is_tipped and discount_amount_lc_bucket = '<<=30' THEN f.order_id END) AS orders_with_tip_customer_total_discount_lte_30_lc_count,
    COUNT(DISTINCT CASE WHEN f.is_tipped and discount_amount_lc_bucket = '<<=50' THEN f.order_id END) AS orders_with_tip_customer_total_discount_lte_50_lc_count,
    COUNT(DISTINCT CASE WHEN f.is_tipped and discount_amount_lc_bucket = '>>50' THEN f.order_id END) AS orders_with_tip_customer_total_discount_gt_50_lc_count,

    SUM(gmv_amount_lc) AS gmv_amount_lc_sum,
    SUM(CASE WHEN f.tip_customer_amount_lc >> 0 THEN gmv_amount_lc ELSE 0 END) AS gmv_amount_customer_tipped_orders_lc_sum,

    SUM(f.tip_customer_amount_lc) AS tip_customer_amount_lc_sum

  FROM agg_pre2 f
  GROUP BY
    ALL
)
SELECT
  a.*,
FROM
  agg a
-- LIMIT 10]]></relation>
          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query1' type='text'>with vendor_list as (
    SELECT
        f.vendor_id
    FROM
        `tlb-data-prod.data_platform.fct_order_info` AS f
    WHERE
        f.is_successful = TRUE
        AND f.delivery_arrangement = &apos;TDINE&apos;
UNION DISTINCT
    SELECT
        dvi.vendor_id
    FROM
        `tlb-data-prod.data_platform.dim_vendor_info` AS dvi
    WHERE
        dvi.is_dineout = TRUE
) 
SELECT
    v.vendor_id, dvi.vendor_name, dli.city_name, dli.area_name, dci.country, dc.chain_name, db.brand_name, -- dc.chain_id, db.brand_id,
FROM
    vendor_list as v
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` dvi using (vendor_id)
INNER JOIN `tlb-data-prod.data_platform.dim_location_info` as dli on dli.location_id = dvi.location_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` dci on dci.country_code = dvi.country_code
INNER JOIN `tlb-data-prod.data_platform.dim_chain` dc on dc.chain_id = dvi.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_brand` db on db.brand_id = dvi.brand_id</relation>
          <relation connection='bigquery.15zvgy600wcvp81b3zb0d0tdzlzr' name='Custom SQL Query2' type='text'>SELECT
    DISTINCT dci.country, dci.currency
FROM `tlb-data-prod.data_platform.dim_country_info` dci</relation>
