      <table>
        <view>
          <datasources>
            <datasource caption='sq_vfd_orchestrator_vendor_roi (data_platform)' name='federated.1mr4yu80ukkcs31c5eg8406q71gt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mr4yu80ukkcs31c5eg8406q71gt].[Calculation_2474798410210926606]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mr4yu80ukkcs31c5eg8406q71gt].[Default date (start) (copy)_2474798410211229711]' caption='End Date' datatype='date' name='[Start Date (copy)_4611967530743869440]' param-domain-type='any' role='measure' type='quantitative' value='#2025-09-14#'>
              <calculation class='tableau' formula='#2025-09-14#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mr4yu80ukkcs31c5eg8406q71gt'>
            <column caption='Date Range' datatype='string' name='[Calculation_1377397829883949056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[order_date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4611967530743869440])+1)&#10;and [order_date] &lt;= [Parameters].[Start Date (copy)_4611967530743869440]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_4611967530743869440])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[order_date] &gt;= [Parameters].[Parameter 1] and [order_date] &lt;= [Parameters].[Start Date (copy)_4611967530743869440]&#10;then &apos;Selected Period&apos; &#10;&#10;END' />
            </column>
            <column caption='Discount Adjustment' datatype='real' name='[Calculation_175710784151535616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[variant_discount_rate] - [Control Campaign Discount Rate]&#10;&#10;[campaign_discount_rate] - [control_campaign_discount_rate]' />
            </column>
            <column caption='ROI' datatype='real' name='[Calculation_175710784154816513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;{ FIXED [vendor_id]: SUM([experiment_variation_gmv_amount_eur]) }&#10;+ &#10;{ FIXED [vendor_id]: SUM([experiment_control_gmv_amount_eur]) } ) &#10;&#10;/&#10;(&#10;{ FIXED [vendor_id]: SUM([experiment_variation_vendor_incentive_cost_eur]) } &#10;+ &#10;{ FIXED [vendor_id]: SUM([experiment_control_vendor_incentive_cost_eur]) } )' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_175710784200433668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id], [order_date], [control_campaign_name], [campaign_name]:MAX([campaign_gmv_amount_eur])}' />
            </column>
            <column caption='Orders vs Control' datatype='real' default-format='*⬆0.0%;⬇0.0%' name='[Calculation_175710784299638790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({ FIXED [vendor_id]: SUM([experiment_variation_successful_order_count])})&#10;/&#10;sum({ FIXED [vendor_id]: SUM([experiment_control_successful_order_count])})&#10;-1' />
            </column>
            <column caption='Savings' datatype='real' default-format='p0.0%' name='[Calculation_175710784500080648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: SUM([experiment_variation_vendor_incentive_cost_eur]) }&#10;/&#10;{ FIXED [vendor_id]: SUM([experiment_control_vendor_incentive_cost_eur]) }&#10;&#10;- 1' />
            </column>
            <column caption='Default date (start)' datatype='string' name='[Calculation_2474798410210926606]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;2025-08-01&apos;' />
            </column>
            <column caption='USER FILTER' datatype='boolean' name='[Calculation_4099190486631862272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN LOWER(USERNAME()) = LOWER([account_manager_email]) &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN LOWER([team_leader_email]) = {MIN(IF LOWER(USERNAME()) = LOWER([account_manager_email]) THEN LOWER([team_leader_email]) ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN LOWER(USERNAME()) = LOWER([team_leader_email]) OR LOWER(USERNAME()) = LOWER([account_manager_email])&#10;END' />
            </column>
            <column caption='Default date (end)' datatype='date' name='[Default date (start) (copy)_2474798410211229711]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([order_date])}' />
            </column>
            <column caption='Orders' datatype='integer' name='[GMV (copy)_175710784201105413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id], [order_date], [control_campaign_name], [campaign_name]: MAX([campaign_successful_order_count])}' />
            </column>
            <column caption='Orders Total' datatype='integer' name='[Orders (copy)_3560447381013049344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: SUM([campaign_successful_order_count])}' />
            </column>
            <column caption='GMV vs Control' datatype='real' default-format='*⬆0.0%;⬇0.0%' name='[Orders vs Control (copy)_175710784300302343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [vendor_id]: SUM([experiment_variation_gmv_amount_eur])})&#10;/&#10;sum({ FIXED [vendor_id]: SUM([experiment_control_gmv_amount_eur])})&#10;-1' />
            </column>
            <column caption='ROI vs Control' datatype='real' default-format='*⬆0.0%;⬇0.0%' name='[ROI (copy)_175710784501927947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum({ FIXED [vendor_id]: SUM([experiment_variation_gmv_amount_eur]) })&#10;/&#10;sum({ FIXED [vendor_id]: SUM([experiment_variation_vendor_incentive_cost_eur]) })&#10;)&#10;&#10;/&#10;&#10;(&#10;sum({ FIXED [vendor_id]: SUM([experiment_control_gmv_amount_eur]) })&#10;/&#10;sum({ FIXED [vendor_id]: SUM([experiment_control_vendor_incentive_cost_eur]) })&#10;)&#10;&#10;- 1' />
            </column>
            <column caption='Savings (euro)' datatype='real' default-format='p0.0%' name='[Savings (copy)_2080381601616117918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: SUM([experiment_variation_vendor_incentive_cost_eur]) }&#10;-&#10;{ FIXED [vendor_id]: SUM([experiment_control_vendor_incentive_cost_eur]) }' />
            </column>
