      <column caption='Calculation1 (count)' datatype='real' name='[Calculation1 (copy)_2474798410166374402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &apos;Orders&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Count&apos; THEN SUM([GMV (copy)_175710784201105413])&#10;//WHEN &apos;%&apos; THEN SUM([Orders]) / TOTAL(SUM([Orders]))&#10;END&#10;&#10;WHEN &apos;GMV&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Count&apos; THEN SUM([Calculation_175710784200433668])&#10;//WHEN &apos;%&apos; THEN SUM([GMV]) / TOTAL(SUM([GMV]))&#10;END&#10;&#10;WHEN &apos;ROI&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Count&apos; THEN SUM([Calculation_175710784154816513])&#10;//WHEN &apos;%&apos; THEN SUM([ROI]) / TOTAL(SUM([ROI]))&#10;END&#10;&#10;END' />
      </column>
      <column caption='Calculation1 (%)' datatype='real' default-format='p0%' name='[Calculation1 (count) (copy)_2474798410166439939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &apos;Orders&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;%&apos; THEN SUM([GMV (copy)_175710784201105413]) / TOTAL(SUM([GMV (copy)_175710784201105413]))&#10;END&#10;&#10;WHEN &apos;GMV&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;%&apos; THEN SUM([Calculation_175710784200433668]) / TOTAL(SUM([Calculation_175710784200433668]))&#10;END&#10;&#10;WHEN &apos;ROI&apos; THEN&#10;CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;%&apos; THEN SUM([Calculation_175710784154816513]) / TOTAL(SUM([Calculation_175710784154816513]))&#10;END&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1 (&gt;k)' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation1 (count) (copy)_2474798410192228358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Count&apos; THEN IF [Calculation_2474798410165923841]&gt;= 10000 THEN [Calculation_2474798410165923841] END&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
