        <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Regular&apos; then [migration_from_family_to_solo] end )' />
      </column>
      <column caption='Active Managers' datatype='integer' name='[Calculation_6524871457970163712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
