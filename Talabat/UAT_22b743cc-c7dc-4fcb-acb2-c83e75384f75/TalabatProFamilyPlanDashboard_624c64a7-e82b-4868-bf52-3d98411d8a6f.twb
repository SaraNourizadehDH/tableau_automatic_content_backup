            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[Calculation_2235685402984099867]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[date]' caption='Date performance' datatype='date' name='[Start Date (copy)_6524871462245679134]' param-domain-type='range' role='measure' type='quantitative' value='#2025-09-13#'>
              <calculation class='tableau' formula='#2025-09-13#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1icf54e0loknm71b8ppsn12t2fu5'>
            <column caption='% New Acquisition Members' datatype='real' default-format='p0%' name='[% New Acquisition Managers (copy)_6524871461854957590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Acquisition Managers (copy)_6524871458011295759] / [Total Managers Acquired (copy)_6524871458011394064]' />
            </column>
            <column caption='% Winback Managers' datatype='real' default-format='p0%' name='[% New Acquisition Managers (copy)_6524871461855059991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Acquisition Managers Acquired (copy)_6524871458010755085] / [Calculation_6524871458010124299]' />
            </column>
            <column caption='% Upgraded Members' datatype='real' default-format='p0%' name='[% Upgraded Managers (copy)_6524871461855547418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Upgraded Acquisition Managers (copy)_6524871458011488273] / [Total Managers Acquired (copy)_6524871458011394064]' />
            </column>
            <column caption='% Winback Members' datatype='real' default-format='p0%' name='[% Winback Managers (copy)_6524871461855248408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Winback Acquisition Managers (copy)_6524871458011553810] / [Total Managers Acquired (copy)_6524871458011394064]' />
            </column>
            <column caption='% Upgraded Managers' datatype='real' default-format='p0%' name='[% Winback Managers (copy)_6524871461855363097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Winback Acquisition Managers (copy)_6524871458011070478] / [Calculation_6524871458010124299]' />
            </column>
            <column caption='max date' datatype='date' name='[Calculation_2235685402984099867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
            <column caption='Total Managers Acquired' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_6524871458010124299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Managers Acquired (copy)_6524871458010599436] + [Winback Acquisition Managers (copy)_6524871458011070478] + [New Acquisition Managers Acquired (copy)_6524871458010755085]' />
            </column>
            <column caption='Total Acquisitions on Family Plan' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_6524871458012131347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6524871458010124299] + [Total Managers Acquired (copy)_6524871458011394064]' />
            </column>
            <column caption='% New Acquisition Managers' datatype='real' default-format='p0%' name='[Calculation_6524871461854224405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Managers Acquired (copy)_6524871458010599436] / [Calculation_6524871458010124299]' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_6524871462245416989]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='aggregation' datatype='boolean' name='[Calculation_6524871463008059434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = [aggregation_type]' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Date range (copy)_2686467575674028033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [aggregation_type] = &apos;Daily&apos; THEN&#10;   [date] &lt;= [Parameters].[Start Date (copy)_6524871462245679134] &#10;    and[date] &gt; DATEADD(&apos;day&apos;, -10, [Parameters].[Start Date (copy)_6524871462245679134])&#10;&#10;    &#10;ELSEIF [aggregation_type] = &apos;Monthly&apos; THEN&#10;   [date] &lt;= [Parameters].[Parameter 2]&#10;    and[date] &gt; DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 2])&#10;&#10;END' />
            </column>
            <column caption='New Acquisition Members' datatype='integer' default-format='n#,##0;-#,##0' name='[New Acquisition Managers (copy)_6524871458011295759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Member&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then [acquisitions_count]  end&#10;)' />
            </column>
            <column caption='Winback Acquisition Managers' datatype='integer' name='[New Acquisition Managers Acquired (copy)_6524871458010755085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Manager&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then  [winbacks_count] end&#10;)' />
            </column>
            <column caption='New Acquisition Managers' datatype='integer' name='[Total Managers Acquired (copy)_6524871458010599436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Manager&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then [acquisitions_count]  end&#10;)' />
            </column>
            <column caption='Total Members Acquired' datatype='integer' default-format='n#,##0;-#,##0' name='[Total Managers Acquired (copy)_6524871458011394064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Acquisition Managers (copy)_6524871458011295759] + [Upgraded Acquisition Managers (copy)_6524871458011488273] + [Winback Acquisition Managers (copy)_6524871458011553810]' />
