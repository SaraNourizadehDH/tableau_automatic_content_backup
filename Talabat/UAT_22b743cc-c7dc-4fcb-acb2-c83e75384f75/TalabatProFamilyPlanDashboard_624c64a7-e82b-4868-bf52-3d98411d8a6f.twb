      </column>
      <column caption='% Yearly Family Subscribers' datatype='real' default-format='p0.0%' name='[% Monthly Family Subscribers (copy)_6524871457974558728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [plan_type] = &apos;LTP&apos; and [tpro_subs_type] = &apos;Pro Family&apos; AND [subscriber_account_type] = &apos;Manager&apos; then [active_ld_count] end)/[Calculation_6524871457970163712]' />
