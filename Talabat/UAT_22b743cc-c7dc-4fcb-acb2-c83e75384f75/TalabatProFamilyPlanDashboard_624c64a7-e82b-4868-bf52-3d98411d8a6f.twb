        <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
      </column>
      <column caption='Average Family Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6524871462568394783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)&#10;/&#10;Sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
      </column>
      <column caption='Date range' datatype='string' name='[Calculation_6524871462609637408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [aggregation_type] = &apos;Daily&apos; THEN&#10;    IF [date] = [Parameters].[Start Date (copy)_6524871462245679134] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date (copy)_6524871462245679134]) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [aggregation_type] = &apos;Weekly&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Start Date (copy)_6524871462245679134]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Start Date (copy)_6524871462245679134])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [aggregation_type] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 2])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
