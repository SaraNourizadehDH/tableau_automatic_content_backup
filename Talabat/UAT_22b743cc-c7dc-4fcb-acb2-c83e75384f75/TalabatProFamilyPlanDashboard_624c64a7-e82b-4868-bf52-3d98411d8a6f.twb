      <column caption='Total Involuntary churn' datatype='integer' name='[Calculation_3118883515161464834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Free Trial Voluntary Churners (copy)_415034883486199835] + [Paid Voluntary Churners (copy)_415034883486318620]' />
      </column>
      <column caption='Managers Active Today' datatype='integer' name='[Calculation_415034883107762176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [ct_dau] end)' />
      </column>
      <column caption='% Managers Active Today' datatype='real' default-format='p0%' name='[Calculation_415034883147751428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_415034883107762176] / [Calculation_6524871457970163712]' />
