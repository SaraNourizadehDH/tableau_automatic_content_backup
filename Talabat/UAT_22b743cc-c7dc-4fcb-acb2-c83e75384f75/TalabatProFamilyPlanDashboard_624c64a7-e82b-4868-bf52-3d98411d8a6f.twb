    <worksheet name='Active Family Plan Subscribers (Free Trial vs Paid)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1b1b1b' fontsize='8'>Plan Type : Free Trial vs Paid</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Pro Family Plan' name='federated.1icf54e0loknm71b8ppsn12t2fu5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[Calculation_6524871462245416989]' caption='Month performance' datatype='date' default-format='*mmmm yyyy' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
            <column alias='Day' caption='Aggregation' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Day' />
                <alias key='&quot;Monthly&quot;' value='Month' />
              </aliases>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[Calculation_2235685402984099867]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[date]' caption='Date performance' datatype='date' name='[Start Date (copy)_6524871462245679134]' param-domain-type='range' role='measure' type='quantitative' value='#2025-09-13#'>
              <calculation class='tableau' formula='#2025-09-13#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1icf54e0loknm71b8ppsn12t2fu5'>
            <column caption='% Monthly Family Subscribers' datatype='real' default-format='p0.0%' name='[% Member Family Subscribers (copy)_6524871457974001671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [plan_type] = &apos;1M&apos; and [tpro_subs_type] = &apos;Pro Family&apos; AND [subscriber_account_type] = &apos;Manager&apos; then [active_ld_count] end)/[Calculation_6524871457970163712]' />
            </column>
            <column caption='% Yearly Family Subscribers' datatype='real' default-format='p0.0%' name='[% Monthly Family Subscribers (copy)_6524871457974558728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [plan_type] = &apos;LTP&apos; and [tpro_subs_type] = &apos;Pro Family&apos; AND [subscriber_account_type] = &apos;Manager&apos; then [active_ld_count] end)/[Calculation_6524871457970163712]' />
            </column>
            <column caption='% Free Trial Plan Subscribers' datatype='real' default-format='p0%' name='[% Paid Plan Subscribers (copy)_6524871457976279050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [free_trial_active_users_ld_count] end)&#10;/&#10;&#10;(sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [paid_active_users_ld_count]  end)&#10;+sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [free_trial_active_users_ld_count]  end)&#10;)' />
            </column>
            <column caption='max date' datatype='date' name='[Calculation_2235685402984099867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
            <column caption='Active Managers' datatype='integer' name='[Calculation_6524871457970163712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
