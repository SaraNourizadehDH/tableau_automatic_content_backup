            <column datatype='integer' name='[is_invitation_completed]' role='measure' type='quantitative' />
            <column caption='max month' datatype='date' name='[max date (copy)_2235685402984652830]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([Calculation_2235685402955153433])}' />
            </column>
