            </column>
            <column caption='Platform Acquisition Managers' datatype='integer' name='[Calculation_158751921120030733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [platform_acquisitions_count] end)' />
