            <column caption='Managers Active Today' datatype='integer' name='[Calculation_415034883107762176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [ct_dau] end)' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_6524871462245416989]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='Date Filter (copy)' datatype='boolean' name='[Date Filter (copy)_158751921463353368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN&#10;   [date] &lt;= [Parameters].[Start Date (copy)_6524871462245679134] &#10;    and[date] &gt; DATEADD(&apos;day&apos;, -10, [Parameters].[Start Date (copy)_6524871462245679134])&#10;&#10;    &#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN&#10;   [date] &gt;= [Parameters].[Parameter 2]&#10;    and[date] &lt; DATEADD(&apos;day&apos;, 10, [Parameters].[Parameter 2])&#10;&#10;END' />
            </column>
            <column caption='Members Active Today' datatype='integer' name='[Managers Active Today (copy)_415034883108139009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Member&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [ct_dau] end)' />
            </column>
            <column caption='Managers Active This Month' datatype='integer' name='[Managers Active Today (copy)_415034883108286466]' role='measure' type='quantitative'>
