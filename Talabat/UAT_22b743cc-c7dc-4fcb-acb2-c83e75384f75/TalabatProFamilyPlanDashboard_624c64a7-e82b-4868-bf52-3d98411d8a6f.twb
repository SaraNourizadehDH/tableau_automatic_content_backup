              <aliases>
                <alias key='&quot;Daily&quot;' value='Day' />
                <alias key='&quot;Monthly&quot;' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zyxiey1ekvuba0zueig41d01mm4'>
            <column caption='CVR %' datatype='real' default-format='p0.0%' name='[CTR % (copy)_2235685402637316098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([invitation_sent_session_count])/&#10;SUM([entry_point_loaded_session_count])' />
            </column>
            <column caption='Aggregation' datatype='boolean' name='[Calculation_2235685402635370496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = [granularity]' />
            </column>
            <column caption='CTR %' datatype='real' default-format='p0.0%' name='[Calculation_2235685402636566529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entry_point_clicked_session_count])/&#10;SUM([entry_point_loaded_session_count])' />
            </column>
            <column caption='Date range' datatype='string' name='[Calculation_2235685402655649806]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN&#10;    IF [date] = [Parameters].[End Date (copy)_2235685402945290263] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [Parameters].[End Date (copy)_2235685402945290263]) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Weekly&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[End Date (copy)_2235685402945290263]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[End Date (copy)_2235685402945290263])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Month (copy)_2235685402955026456]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Month (copy)_2235685402955026456])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_2235685402955153433]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [granularity] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='max date' datatype='date' name='[Calculation_2235685402984583197]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
            <column caption='Join Success %' datatype='real' default-format='p0.0%' name='[Invitation Acceptance % (copy)_2235685402644307980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_invitation_completed])/&#10;sum([is_invitation_accepted])' />
