            <column caption='Date Filter (copy)' datatype='boolean' name='[Date Filter (copy)_158751921463353368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN&#10;   [date] &lt;= [Parameters].[Start Date (copy)_6524871462245679134] &#10;    and[date] &gt; DATEADD(&apos;day&apos;, -10, [Parameters].[Start Date (copy)_6524871462245679134])&#10;&#10;    &#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN&#10;   [date] &gt;= [Parameters].[Parameter 2]&#10;    and[date] &lt; DATEADD(&apos;day&apos;, 10, [Parameters].[Parameter 2])&#10;&#10;END' />
