          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0zyxiey1ekvuba0zueig41d01mm4].[Calculation_2235685402984583197]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0zyxiey1ekvuba0zueig41d01mm4].[date]' caption='Date invite' datatype='date' name='[End Date (copy)_2235685402945290263]' param-domain-type='range' role='measure' type='quantitative' value='#2025-09-15#'>
