      <column caption='Platform Acquisition Managers' datatype='integer' name='[Calculation_158751921120030733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [platform_acquisitions_count] end)' />
      </column>
      <column caption='Families with 0 Members' datatype='real' default-format='p0.0%' name='[Calculation_158751921398894612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ct_families_with_0_member])/ (sum([ct_families_with_0_member]) + sum([ct_families_with_1_member]) + sum([ct_families_with_2_members]) + sum([ct_families_with_3_members]))' />
      </column>
      <column caption='max date' datatype='date' name='[Calculation_2235685402984099867]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([date])}' />
      </column>
      <column caption='Total Voluntary Churn' datatype='integer' name='[Calculation_3118883515157622784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_415034883484540953] + [Free Trial Churners (copy)_415034883485102106]' />
