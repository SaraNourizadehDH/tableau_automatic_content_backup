      <table>
        <view>
          <datasources>
            <datasource caption='Pro Family Plan' name='federated.1icf54e0loknm71b8ppsn12t2fu5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[Calculation_6524871462245416989]' caption='Month performance' datatype='date' default-format='*mmmm yyyy' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
            <column alias='Day' caption='Aggregation' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Day' />
                <alias key='&quot;Monthly&quot;' value='Month' />
              </aliases>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[Calculation_2235685402984099867]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1icf54e0loknm71b8ppsn12t2fu5].[date]' caption='Date performance' datatype='date' name='[Start Date (copy)_6524871462245679134]' param-domain-type='range' role='measure' type='quantitative' value='#2025-09-13#'>
              <calculation class='tableau' formula='#2025-09-13#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1icf54e0loknm71b8ppsn12t2fu5'>
            <column caption='Net Growth' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_158751921105252353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)&#10;-&#10;sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_yesterday_ld_count] end)' />
            </column>
            <column caption='max date' datatype='date' name='[Calculation_2235685402984099867]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
            <column caption='% Total Pro Family Subscribers ' datatype='real' default-format='p0.0%' name='[Calculation_6524871457972830212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Managers (copy)_6524871457972645890] / sum([active_ld_count])' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_6524871462245416989]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='aggregation' datatype='boolean' name='[Calculation_6524871463008059434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = [aggregation_type]' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Date range (copy)_2686467575674028033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [aggregation_type] = &apos;Daily&apos; THEN&#10;   [date] &lt;= [Parameters].[Start Date (copy)_6524871462245679134] &#10;    and[date] &gt; DATEADD(&apos;day&apos;, -10, [Parameters].[Start Date (copy)_6524871462245679134])&#10;&#10;    &#10;ELSEIF [aggregation_type] = &apos;Monthly&apos; THEN&#10;   [date] &lt;= [Parameters].[Parameter 2]&#10;    and[date] &gt; DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 2])&#10;&#10;END' />
            </column>
            <column caption='Total Active Family Subscribers' datatype='integer' name='[Managers (copy)_6524871457972645890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
            </column>
            <column datatype='integer' name='[active_ld_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_yesterday_ld_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[aggregation_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
