      <column caption='% Total Pro Family Subscribers ' datatype='real' default-format='p0.0%' name='[Calculation_6524871457972830212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Managers (copy)_6524871457972645890] / sum([active_ld_count])' />
      </column>
      <column caption='% Paid Plan Subscribers' datatype='real' default-format='p0%' name='[Calculation_6524871457975758857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [paid_active_users_ld_count] end)&#10;/&#10;(sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [paid_active_users_ld_count]  end)&#10;+sum (if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [free_trial_active_users_ld_count]  end)&#10;)' />
      </column>
