            <column caption='Month' datatype='date' name='[Calculation_6524871462245416989]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='Average Family Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6524871462568394783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)&#10;/&#10;Sum(if [subscriber_account_type] = &apos;Manager&apos; and [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
            </column>
            <column caption='Date range' datatype='string' name='[Calculation_6524871462609637408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [aggregation_type] = &apos;Daily&apos; THEN&#10;    IF [date] = [Parameters].[Start Date (copy)_6524871462245679134] THEN &apos;Selected Period&apos;&#10;    ELSEIF [date] = DATEADD(&apos;day&apos;, -1, [Parameters].[Start Date (copy)_6524871462245679134]) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [aggregation_type] = &apos;Weekly&apos; THEN&#10;    IF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, [Parameters].[Start Date (copy)_6524871462245679134]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;week&apos;, [date]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, [Parameters].[Start Date (copy)_6524871462245679134])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSEIF [aggregation_type] = &apos;Monthly&apos; THEN&#10;    IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 2]) THEN &apos;Selected Period&apos;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 2])) THEN &quot;Comparison Period&quot;&#10;    ELSE &apos;Remaining Days&apos;&#10;    END&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;END' />
            </column>
            <column caption='aggregation' datatype='boolean' name='[Calculation_6524871463008059434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = [aggregation_type]' />
            </column>
            <column caption='Total Active Family Subscribers' datatype='integer' name='[Managers (copy)_6524871457972645890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_count] end)' />
            </column>
            <column caption='New Acquisition Members' datatype='integer' default-format='n#,##0;-#,##0' name='[New Acquisition Managers (copy)_6524871458011295759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Member&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then [acquisitions_count]  end&#10;)' />
            </column>
            <column caption='Winback Acquisition Managers' datatype='integer' name='[New Acquisition Managers Acquired (copy)_6524871458010755085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Manager&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then  [winbacks_count] end&#10;)' />
            </column>
            <column caption='New Acquisition Managers' datatype='integer' name='[Total Managers Acquired (copy)_6524871458010599436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if subscriber_account_type = &apos;Manager&apos; AND tpro_subs_type = &apos;Pro Family&apos;&#10;then [acquisitions_count]  end&#10;)' />
            </column>
            <column caption='Total Members Acquired' datatype='integer' default-format='n#,##0;-#,##0' name='[Total Managers Acquired (copy)_6524871458011394064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Acquisition Managers (copy)_6524871458011295759] + [Upgraded Acquisition Managers (copy)_6524871458011488273] + [Winback Acquisition Managers (copy)_6524871458011553810]' />
            </column>
            <column caption='Upgraded Acquisition Members' datatype='integer' default-format='n#,##0;-#,##0' name='[Upgraded Acquisition Managers (copy)_6524871458011488273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if   tpro_subs_type = &apos;Pro Regular&apos;&#10;then [upgrade_to_member_count] end&#10;)' />
            </column>
            <column caption='Upgraded Acquisition Managers' datatype='integer' name='[Winback Acquisition Managers (copy)_6524871458011070478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if   tpro_subs_type = &apos;Pro Regular&apos;&#10;then [upgrade_to_manager_count] end&#10;)' />
