              <calculation class='tableau' formula='sum( if   tpro_subs_type = &apos;Pro Regular&apos;&#10;then [upgrade_to_member_count] end&#10;)' />
            </column>
            <column caption='Winback Acquisition Members' datatype='integer' default-format='n#,##0;-#,##0' name='[Winback Acquisition Managers (copy)_6524871458011553810]' role='measure' type='quantitative'>
