            </column>
            <column caption='Total Voluntary Churn' datatype='integer' name='[Calculation_3118883515157622784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_415034883484540953] + [Free Trial Churners (copy)_415034883485102106]' />
            </column>
            <column caption='Free Trial Voluntary Churners' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_415034883484540953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Family&apos; then [active_ld_free_trial_churned_vol_count] end)' />
            </column>
            <column caption='Migrated from Family to Solo' datatype='integer' default-format='p0.00%' name='[Calculation_415034883495309342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [tpro_subs_type] = &apos;Pro Regular&apos; then [migration_from_family_to_solo] end )' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_6524871462245416989]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [aggregation_type] = &apos;Monthly&apos; then [date] end' />
            </column>
            <column caption='Date Filter (copy)' datatype='boolean' name='[Date Filter (copy)_158751921463353368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN&#10;   [date] &lt;= [Parameters].[Start Date (copy)_6524871462245679134] &#10;    and[date] &gt; DATEADD(&apos;day&apos;, -10, [Parameters].[Start Date (copy)_6524871462245679134])&#10;&#10;    &#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN&#10;   [date] &gt;= [Parameters].[Parameter 2]&#10;    and[date] &lt; DATEADD(&apos;day&apos;, 10, [Parameters].[Parameter 2])&#10;&#10;END' />
            </column>
