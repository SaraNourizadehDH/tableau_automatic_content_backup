            <column caption='MFO Sessions' datatype='integer' name='[m41_shown_sessions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_51509956777414660]' derivation='None' name='[none:Calculation_51509956777414660:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[session_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3774860946587697159]' derivation='User' name='[usr:Calculation_3774860946587697159:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.15z5hni0ipz6qj1gfb8tx1l8p8fe].[none:Calculation_51509956777414660:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
