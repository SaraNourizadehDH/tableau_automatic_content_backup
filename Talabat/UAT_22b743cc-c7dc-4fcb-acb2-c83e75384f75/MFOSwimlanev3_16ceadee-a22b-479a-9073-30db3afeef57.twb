      <repository-location id='Trend' path='/t/Talabat/workbooks/MFO_Swimlane' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_playground)' name='federated.15z5hni0ipz6qj1gfb8tx1l8p8fe' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='CVR(%)' caption='Secondary Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
              <calculation class='tableau' formula='&quot;CVR&quot;' />
              <aliases>
                <alias key='&quot;CTO&quot;' value='CTO(%)' />
                <alias key='&quot;CTR&quot;' value='CTR(%)' />
                <alias key='&quot;CVR&quot;' value='CVR(%)' />
                <alias key='&quot;MFO Orders&quot;' value='MFO Orders(%)' />
                <alias key='&quot;Shown Rate&quot;' value='Shown Rate(%)' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.15z5hni0ipz6qj1gfb8tx1l8p8fe].[Calculation_51509956776677378]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-01-26#'>
              <calculation class='tableau' formula='#2025-01-26#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.15z5hni0ipz6qj1gfb8tx1l8p8fe].[Calculation_51509956776857603]' caption='End Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-02-02#'>
              <calculation class='tableau' formula='#2025-02-02#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15z5hni0ipz6qj1gfb8tx1l8p8fe'>
            <column caption='CVR(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946537988096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([m41_shown_sessions])= 0 THEN 0 ELSE sum([m41_placed_order_sessions])/sum([m41_shown_sessions]) END' />
            </column>
            <column caption='CTR(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946544123906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([m41_shown_sessions]) = 0 THEN 0 ELSE SUM(m41_clicked_sessions)/sum([m41_shown_sessions]) END' />
            </column>
            <column caption='CTO(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946574086147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([m41_clicked_sessions]) = 0 THEN 0 ELSE SUM([m41_placed_order_sessions])/sum([m41_clicked_sessions]) END' />
            </column>
            <column caption='Shown Rate(%)' datatype='real' default-format='p0.0000%' name='[Calculation_3774860946574254084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([m41_shown_sessions])/sum([session_count])' />
            </column>
            <column caption='MFO Orders(%)' datatype='real' default-format='p0.0000%' name='[Calculation_3774860946574557189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([m41_food_order_count])/SUM([food_order_count])' />
            </column>
            <column caption='Secondary Metric' datatype='real' default-format='p0.00%' name='[Calculation_3774860946587697159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;CTR&apos; THEN [Calculation_3774860946544123906]&#10;when &apos;CVR&apos; THEN [Calculation_3774860946537988096]&#10;WHEN &apos;CTO&apos; THEN [Calculation_3774860946574086147]&#10;WHEN &apos;MFO Orders&apos; THEN [Calculation_3774860946574557189]&#10;WHEN &apos;Shown Rate&apos; THEN [Calculation_3774860946574254084]&#10;&#10;END' />
            </column>
            <column caption='Default Start Date' datatype='date' name='[Calculation_51509956776677378]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 8' />
            </column>
            <column caption='Default End Date' datatype='date' name='[Calculation_51509956776857603]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 1' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_51509956777414660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[date]&gt;= [Parameters].[Parameter 2] - DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2],[Parameters].[Parameter 3]+1)&#10;AND date &lt;= [Parameters].[Parameter 3]- DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2],[Parameters].[Parameter 3]+1)&#10;then &quot;Comparison Period&quot;&#10;ELSEIF &#10;date &gt;= [Parameters].[Parameter 2] and date &lt;= [Parameters].[Parameter 3]&#10;then &quot;Selected Period&quot;&#10;Else &quot;Remaining Days&quot;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Period' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Food Order Count' datatype='integer' name='[food_order_count]' role='measure' type='quantitative' />
            <column caption='MFO Clicked Sessions' datatype='integer' name='[m41_clicked_sessions]' role='measure' type='quantitative' />
            <column caption='MFO Orders Count' datatype='integer' name='[m41_food_order_count]' role='measure' type='quantitative' />
