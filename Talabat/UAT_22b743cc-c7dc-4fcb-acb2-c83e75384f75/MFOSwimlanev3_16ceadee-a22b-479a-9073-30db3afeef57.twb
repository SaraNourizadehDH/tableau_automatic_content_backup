      <aliases enabled='yes' />
      <column caption='MFO Sessions with 5 vendors' datatype='integer' name='[Calculation_1251226680838283268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5272096722176139269] &gt;= 5 THEN [m41_shown_sessions] ELSE 0 END' />
      </column>
      <column caption='Vendor Check' datatype='integer' name='[Calculation_1251226680838692869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5272096722176139269] &gt;= 5 THEN 1 ELSE 0 END' />
      </column>
      <column caption='MFO Sessions with more than 5 vendors' datatype='real' name='[Calculation_1251226680842571782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL(SUM([Calculation_1251226680838283268]), 0) = 0 AND IFNULL(SUM([m41_shown_sessions]), 0) = 0 &#10;THEN 0 &#10;ELSE IFNULL(SUM([Calculation_1251226680838283268]), 0) / IFNULL(SUM([m41_shown_sessions]), 0)&#10;END' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_1979472812583505921]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 5],[date])' />
      </column>
      <column caption='MFO AOV(eur)' datatype='real' name='[Calculation_2513290103827738624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([m41_food_order_count]) = 0 THEN 0 ELSE SUM([m41_gmv_amount_eur])/SUM([m41_food_order_count]) END' />
      </column>
      <column caption='Select Metric' datatype='real' name='[Calculation_2513290103841779715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Secondary Metric (copy)_2875196555129303040]&#10;when &apos;m41_started_checkout_sessions&apos; THEN [m41_started_checkout_sessions]&#10;when &apos;m41_added_to_cart_sessions&apos; THEN [m41_added_to_cart_sessions]&#10;WHEN &apos;m41_placed_order_sessions&apos; THEN [m41_placed_order_sessions]&#10;when &apos;MFO GMV(eur)&apos; THEN [m41_gmv_amount_eur]&#10;when &apos;MFO Orders Count&apos; THEN [m41_food_order_count]&#10;END' />
      </column>
      <column caption='MFO Sessions to Click' datatype='real' name='[Calculation_2540945025635606532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_clicked_sessions])/sum([m41_shown_sessions])' />
      </column>
      <column caption='MFO Clicked to ATC' datatype='real' name='[Calculation_2540945025635917829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([m41_added_to_cart_sessions])/SUM([m41_clicked_sessions])' />
      </column>
      <column caption='MFO ATC to Checkout' datatype='real' name='[Calculation_2540945025636044806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_started_checkout_sessions])/sum([m41_added_to_cart_sessions])' />
      </column>
      <column caption='MFO Checkout to Place Order' datatype='real' name='[Calculation_2540945025636253703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_placed_order_sessions])/sum([m41_started_checkout_sessions])' />
      </column>
      <column caption='100%' datatype='integer' name='[Calculation_2540945025636704264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Select Country' datatype='string' name='[Calculation_2540945025650094090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_code]' />
      </column>
      <column caption='CVR(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946537988096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([m41_shown_sessions])= 0 THEN 0 ELSE sum([m41_placed_order_sessions])/sum([m41_shown_sessions]) END' />
      </column>
      <column caption='CTR(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946544123906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([m41_shown_sessions]) = 0 THEN 0 ELSE SUM(m41_clicked_sessions)/sum([m41_shown_sessions]) END' />
      </column>
      <column caption='CTO(%)' datatype='real' default-format='p0.00%' name='[Calculation_3774860946574086147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([m41_clicked_sessions]) = 0 THEN 0 ELSE SUM([m41_placed_order_sessions])/sum([m41_clicked_sessions]) END' />
      </column>
      <column caption='Shown Rate(%)' datatype='real' default-format='p0.0000%' name='[Calculation_3774860946574254084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_shown_sessions])/sum([session_count])' />
      </column>
      <column caption='MFO Orders(%)' datatype='real' default-format='p0.0000%' name='[Calculation_3774860946574557189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_food_order_count])/SUM([food_order_count])' />
      </column>
      <column caption='Secondary Metric' datatype='real' default-format='p0.00%' name='[Calculation_3774860946587697159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;CTR&apos; THEN [Calculation_3774860946544123906]&#10;when &apos;CVR&apos; THEN [Calculation_3774860946537988096]&#10;WHEN &apos;CTO&apos; THEN [Calculation_3774860946574086147]&#10;WHEN &apos;MFO Orders&apos; THEN [Calculation_3774860946574557189]&#10;WHEN &apos;Shown Rate&apos; THEN [Calculation_3774860946574254084]&#10;&#10;END' />
      </column>
      <column caption='Total Sessions Count' datatype='integer' name='[Calculation_3774860947291148296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[session_count]' />
      </column>
      <column caption='MCVR3(%)' datatype='real' name='[Calculation_51509956766248960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([m41_started_checkout_sessions])/sum([m41_clicked_sessions])' />
      </column>
      <column caption='MCVR3a(%)' datatype='real' name='[Calculation_51509956767744001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m41_added_to_cart_sessions])/sum([m41_clicked_sessions])' />
      </column>
      <column caption='Default Start Date' datatype='date' name='[Calculation_51509956776677378]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 8' />
      </column>
      <column caption='Default End Date' datatype='date' name='[Calculation_51509956776857603]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 1' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_51509956777414660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[date]&gt;= [Parameters].[Parameter 2] - DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2],[Parameters].[Parameter 3]+1)&#10;AND date &lt;= [Parameters].[Parameter 3]- DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 2],[Parameters].[Parameter 3]+1)&#10;then &quot;Comparison Period&quot;&#10;ELSEIF &#10;date &gt;= [Parameters].[Parameter 2] and date &lt;= [Parameters].[Parameter 3]&#10;then &quot;Selected Period&quot;&#10;Else &quot;Remaining Days&quot;&#10;END' />
