      <column caption='Grocery Session Share' datatype='real' name='[Calculation_2556989096008200192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_grocery_sessions])/sum([total_platform_sessions])' />
      </column>
      <column caption='tMart Session Share' datatype='real' name='[Calculation_2556989096009289730]' role='measure' type='quantitative'>
