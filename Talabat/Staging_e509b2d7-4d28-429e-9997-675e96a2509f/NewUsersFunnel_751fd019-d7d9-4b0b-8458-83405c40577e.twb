      <aliases enabled='yes' />
      <column caption='M1 Retention Rate' datatype='real' name='[Calculation_5135933182554415108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([m1_customers]) / SUM([m0_cohort_size])' />
      </column>
      <column caption='Network' datatype='string' name='[Calculation_5135933182555402246]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([acquisition_pm_network_name], &apos;TikTok&apos;) THEN &apos;TikTok&apos; &#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;ByteDance&apos;) THEN &apos;TikTok&apos;&#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;Google&apos;) THEN &apos;Google&apos;&#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;Adwords&apos;) THEN &apos;Google&apos;&#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;Twitter&apos;) THEN &apos;Twitter&apos;&#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;Apple&apos;) THEN &apos;Apple&apos;&#10;ELSEIF CONTAINS([acquisition_pm_network_name], &apos;Snapchat&apos;) THEN &apos;Snapchat&apos;&#10;ELSE [acquisition_pm_network_name]&#10;END' />
      </column>
      <column caption='Acquisition Rate' datatype='real' name='[M1 Retention Rate (copy)_5135933182554484741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([m0_cohort_size]) / SUM([installs])' />
      </column>
