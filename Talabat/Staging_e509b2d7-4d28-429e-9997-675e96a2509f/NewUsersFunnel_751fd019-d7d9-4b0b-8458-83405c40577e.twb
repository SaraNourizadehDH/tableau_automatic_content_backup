      <table>
        <view>
          <datasources>
            <datasource caption='6. Funnel' name='federated.1t0v3be1x4khmw11g6qj01913g00' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Display CVR ' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Total&quot;'>
              <calculation class='tableau' formula='&quot;% of Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1t0v3be1x4khmw11g6qj01913g00'>
            <column caption='% CVR Total ' datatype='real' name='[% CVR (copy)_3356307646941249564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1+(ZN(SUM([value])) - LOOKUP(ZN(SUM([value])), FIRST())) / ABS(LOOKUP(ZN(SUM([value])), FIRST()))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='val' datatype='integer' name='[Calculation_3356307646586662912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- 1 * [value]' />
            </column>
            <column caption='% CVR' datatype='real' name='[Calculation_3356307646610563075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3356307646586662912]) / LOOKUP(SUM([Calculation_3356307646586662912]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Channel Type' datatype='string' name='[Calculation_3356307646620151812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [install_channel_type] = &apos;PM&apos; THEN &apos;PM&apos; ELSE &apos;Non-PM&apos;&#10;END' />
            </column>
            <column caption='CVR ' datatype='real' name='[Calculation_3356307646952984624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;% of Total&quot; THEN [% CVR (copy)_3356307646941249564]&#10;ELSE [Calculation_3356307646610563075]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[install_channel_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[install_network_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[install_pm_old_channel]' role='dimension' type='nominal' />
