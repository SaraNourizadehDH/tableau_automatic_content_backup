      <column caption='Non-PM Acquisitions CVR' datatype='real' name='[Calculation_5135933182548193280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_pm_acquisitions]) / SUM([non_pm_installs])' />
      </column>
      <column caption='PM % of Total Acquisitions' datatype='real' name='[Calculation_5135933182599290887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_l2_acquisitions]) / SUM([overall_acquisitions])' />
      </column>
      <column caption='PM Acquisitions CVR ' datatype='real' name='[Non-PM Acquisitions CVR (copy)_5135933182548299777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_l2_acquisitions]) / SUM([pm_installs])' />
      </column>
      <column caption='PM % of Total Installs' datatype='real' name='[PM % of Total Acquisitions (copy)_5135933182599393288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_installs]) / SUM([overall_installs])' />
      </column>
