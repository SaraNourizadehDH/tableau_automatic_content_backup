        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18plyga0qh5j7a1dkhupo13y5s53 (copy)' name='Custom SQL Query' type='text'><![CDATA[WITH overall_acquisitions
AS (
  SELECT
    country_code,
    order_date as acquisition_order_date,
    order_id as acquisition_order_id, 
  FROM `tlb-data-prod.data_platform.fct_order_info`
  WHERE order_date >>= '2025-01-01'
  AND   is_successful
  AND   is_acquisition
),

taggings 
AS ( 
  SELECT
    distinct 
    campaign_name,
    network_name, 
    case
      when campaign_name like '%_OBJ-reach_%' then 'Reach'
      when campaign_name like '%_OBJ-xrea_%' then 'Extended Reach'
      when campaign_name like '%_OBJ-rma_%' then 'RMA'
      when campaign_name like '%_OBJ-rmo_%' then 'RMO'
      when campaign_name like '%_OBJ-hva_%' then 'HVA'
      when campaign_name like '%_OBJ-react_%' then 'Reactivations'
      when network_name = 'SEO' then 'SEO'
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), '^(mob_bra|dis_bra|ps_bra|smartly_bra)') then 'Online Branding'
      when lower(campaign_name) like 'mob_reach%' or lower(campaign_name) like 'mob_rma%' then 'App (Reach / RMA)'
      when lower(campaign_name) like 'dis_reach%' or lower(campaign_name) like 'dis_rma%' then 'Display (Reach / RMA)'
      WHEN regexp_contains(lower(campaign_name), '^(ps_reach|smartly_reach|ps_rma|smartly_rma)') then 'Paid Social (Reach / RMA)'
      when lower(campaign_name) like 'sem_bra%' then 'SEM Brand'
      when lower(campaign_name) like 'sem%' AND lower(campaign_name) not like 'sem_bra' then 'SEM non-Brand'
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date >>= '2025-01-01'
),

acquisition_attribution
AS (
  SELECT
    adj.adjust_id,
    adj.campaign_name as acquisition_campaign_name,
    adj.network_name as acquisition_network_name, 
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non-PM'
    end as acquisition_channel_type,
    date as acquisition_date,
    date(installed_timestamp) as install_date,
    date(reattributed_timestamp) as reattribution_date,
    order_id as acquisition_order_id,
    DATE_DIFF(order_date, DATE(installed_timestamp), DAY) <<= 6 OR  DATE_DIFF(order_date, DATE(reattributed_timestamp), DAY) <<= 6  as is_attr_window,
  FROM `tlb-data-prod.data_platform.fct_adjust_event` adj 
  INNER JOIN taggings b USING(campaign_name)
  INNER JOIN `tlb-data-prod.data_platform.fct_order_info` foi  ON SAFE_CAST(adj.transaction_id AS INT64) = foi.transaction_id
  WHERE order_date >>= "2025-01-01"
  AND   date >>= '2025-01-01'
  AND   is_successful
  AND   is_acquisition
  GROUP BY ALL 
),


acquisition_with_previous_events
AS (
  SELECT
    a.*,
    activity_kind as event,
    adj.date as event_date,
    adj.campaign_name, 
    adj.network_name, 
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non'
    end as channel_type,  
  FROM acquisition_attribution a 
  INNER JOIN `tlb-data-prod.data_platform.fct_adjust_event` adj USING(adjust_id)
  INNER JOIN taggings b ON adj.campaign_name = b.campaign_name
  WHERE adj.date >>= '2024-01-01'
  AND   adj.date << a.acquisition_date
  AND   adj.activity_kind IN ('click', "install" , 'install_update', 'att_update', 'reinstall','reattribution', 'reattribution_update', 'reattribution_reinstall')  
),

attribution_influence_tag
AS ( 
  SELECT
    *,
    case
      when acquisition_channel_type = 'PM' then 'PM'
      when acquisition_channel_type = 'Non-PM' and  attributed_channel_types_pre_acqs like '%PM%' then "PM Influenced"
      else 'Non-PM'
    end as attribution_type,
  FROM ( 
    SELECT
      adjust_id, 
      acquisition_channel_type,
      acquisition_network_name,
      acquisition_campaign_name,
      acquisition_date,
      acquisition_order_id,
      is_attr_window,
      min(event_date) as min_pre_acqu_event,
      min(case when channel_type = 'PM' then event_date end) as min_pm_pre_acq,
      string_agg(distinct network_name) as attributed_networks_pre_acqs,
      string_agg(distinct channel_type) as attributed_channel_types_pre_acqs,
    FROM acquisition_with_previous_events 
    GROUP BY ALL 
  )
  QUALIFY ROW_NUMBER() OVER(PARTITION BY acquisition_order_id) = 1
)

SELECT
  attribution_type, 
  count(distinct a.acquisition_order_id) as acquisitions
FROM overall_acquisitions a 
LEFT JOIN attribution_influence_tag b USING(acquisition_order_id)
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
