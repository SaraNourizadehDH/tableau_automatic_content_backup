      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7F9A201B81A84974AE5E2B2C68A77D38'>
            <properties context=''>
              <relation connection='bigquery.07e0yli0i5zzwb0zp0hoa1vui3py' name='Custom SQL Query' type='text'>## Topline Metrics - PM vs Non-PM 

WITH taggings 
AS ( 
  SELECT
    distinct 
    campaign_name,
    network_name, 
    case
      when campaign_name like &apos;%_OBJ-reach_%&apos; then &apos;Reach&apos;
      when campaign_name like &apos;%_OBJ-xrea_%&apos; then &apos;Extended Reach&apos;
      when campaign_name like &apos;%_OBJ-rma_%&apos; then &apos;RMA&apos;
      when campaign_name like &apos;%_OBJ-rmo_%&apos; then &apos;RMO&apos;
      when campaign_name like &apos;%_OBJ-hva_%&apos; then &apos;HVA&apos;
      when campaign_name like &apos;%_OBJ-react_%&apos; then &apos;Reactivations&apos;
      when network_name = &apos;SEO&apos; then &apos;SEO&apos;
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), &apos;^(mob_bra|dis_bra|ps_bra|smartly_bra)&apos;) then &apos;Online Branding&apos;
      when lower(campaign_name) like &apos;mob_reach%&apos; or lower(campaign_name) like &apos;mob_rma%&apos; then &apos;App (Reach / RMA)&apos;
      when lower(campaign_name) like &apos;dis_reach%&apos; or lower(campaign_name) like &apos;dis_rma%&apos; then &apos;Display (Reach / RMA)&apos;
      WHEN regexp_contains(lower(campaign_name), &apos;^(ps_reach|smartly_reach|ps_rma|smartly_rma)&apos;) then &apos;Paid Social (Reach / RMA)&apos;
      when lower(campaign_name) like &apos;sem_bra%&apos; then &apos;SEM Brand&apos;
      when lower(campaign_name) like &apos;sem%&apos; AND lower(campaign_name) not like &apos;sem_bra&apos; then &apos;SEM non-Brand&apos;
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date &gt;&gt;= &apos;2024-01-01&apos;
),

installs
AS (
  SELECT
    upper(ip_country) as country_code, 
    date, 
    count(*) as overall_installs,
    sum(case when pm_new_convention_objective is not null or pm_old_channel is not null then 1 end) as pm_installs,
  FROM `tlb-data-prod.data_platform.fct_adjust_event` adj 
  INNER JOIN taggings b USING(campaign_name)
  WHERE date &gt;&gt;= &apos;2024-01-01&apos;
  AND   activity_kind = &apos;install&apos;
  GROUP BY ALL
),

cost
AS (
  SELECT
    LEFT(entity_id, 2) AS country_code,
    date,
    SUM(amount_eur) AS overall_carc_cost_eur,
    SUM(CASE WHEN cost_type = &apos;PM&apos; THEN amount_eur END) AS pm_cost_eur,
  FROM `tlb-data-prod.data_platform.agg_marketing_finance_daily`
  WHERE date &gt;&gt;= &apos;2024-01-01&apos;
  AND   carc_category = &apos;CAC&apos;
  GROUP BY ALL
),

overall_acquisitions
AS (
  SELECT
    country_code,
    order_date as date, 
    count(distinct order_id) as overall_acquisitions,
  FROM `tlb-data-prod.data_platform.fct_order_info` 
  WHERE order_date &gt;&gt;= &apos;2024-01-01&apos;
  AND   is_successful 
  AND   is_acquisition
  GROUP BY ALL 
),

pm_acquisitions 
AS (
    SELECT
        CASE
            WHEN country = &apos;Qatar&apos; THEN &apos;QA&apos;
            WHEN country = &apos;Bahrain&apos; THEN &apos;BH&apos;
            WHEN country = &apos;United Arab Emirates&apos; THEN &apos;AE&apos;
            WHEN country = &apos;Egypt&apos; THEN &apos;EG&apos;
            WHEN country = &apos;Oman&apos; THEN &apos;OM&apos;
            WHEN country = &apos;Jordan&apos; THEN &apos;JO&apos;
            WHEN country = &apos;Iraq&apos; THEN &apos;IQ&apos;
            WHEN country = &apos;Kuwait&apos; THEN &apos;KW&apos;
        END AS country_code,
        date,
        ROUND(SUM(acquisitions_calibration_ios14fix), 2) AS pm_l2_acquisitions,
    FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed`
    WHERE date &gt;&gt;= &apos;2024-01-01&apos;
        AND management_entity = &apos;Talabat&apos;
        AND (
          (REGEXP_CONTAINS(objective_dh, &apos;_OBJ-reach_|_OBJ-xrea_|_OBJ-rma_|_OBJ-rmo_|_OBJ-hva_|_OBJ-react_&apos;) OR channel = &apos;SEO&apos;)
          OR (channel IN (&apos;APP&apos;, &apos;DISPLAY&apos;, &apos;PAIDSOCIAL&apos;) AND sub_channel != &apos;RMO&apos;) 
          OR (channel = &apos;SEM&apos;) 
          OR (channel = &apos;BRAND&apos; AND sub_channel = &apos;SEM&apos;)
        )
    GROUP BY ALL
)

SELECT
  a.*,
  b.overall_installs,
  b.pm_installs,
  c.overall_carc_cost_eur,
  c.pm_cost_eur,
  d.pm_l2_acquisitions, 
  overall_installs - pm_installs as non_pm_installs,
  overall_acquisitions - pm_l2_acquisitions as non_pm_acquisitions,
  overall_carc_cost_eur - pm_cost_eur as non_pm_cost_eur,
FROM overall_acquisitions  a 
LEFT JOIN installs b USING(country_code, date)
LEFT JOIN cost c USING(country_code, date)
LEFT JOIN pm_acquisitions d USING(country_code, date)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='5.1. Retention Rate' inline='true' name='federated.09ps3lu0xbzgye19dwt9t1ul8p8u (copy 2)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.07e0yli0i5zzwb0zp0hoa1vui3py (copy 2)'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='george.abou@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07e0yli0i5zzwb0zp0hoa1vui3py (copy 2)' name='Custom SQL Query' type='text'><![CDATA[WITH acquisition_order_ids
AS (
  SELECT
      country_code,
      order_id as acquisition_order_id,
      transaction_id as acquisition_transaction_id, 
      order_date as acquisition_order_date,
      analytical_customer_id, 
      case when incentive_amount_eur >> 0 then true else false end as is_incentivized,
  FROM `tlb-data-prod.data_platform.fct_order_info` foi 
  WHERE order_date >>= '2024-01-01'
  AND   is_successful 
  AND   is_acquisition
),

taggings 
AS ( 
  SELECT
    distinct 
    campaign_name,
    network_name, 
    case
      when campaign_name like '%_OBJ-reach_%' then 'Reach'
      when campaign_name like '%_OBJ-xrea_%' then 'Extended Reach'
      when campaign_name like '%_OBJ-rma_%' then 'RMA'
      when campaign_name like '%_OBJ-rmo_%' then 'RMO'
      when campaign_name like '%_OBJ-hva_%' then 'HVA'
      when campaign_name like '%_OBJ-react_%' then 'Reactivations'
      when network_name = 'SEO' then 'SEO'
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), '^(mob_bra|dis_bra|ps_bra|smartly_bra)') then 'Online Branding'
      when lower(campaign_name) like 'mob_reach%' or lower(campaign_name) like 'mob_rma%' then 'App (Reach / RMA)'
      when lower(campaign_name) like 'dis_reach%' or lower(campaign_name) like 'dis_rma%' then 'Display (Reach / RMA)'
      WHEN regexp_contains(lower(campaign_name), '^(ps_reach|smartly_reach|ps_rma|smartly_rma)') then 'Paid Social (Reach / RMA)'
      when lower(campaign_name) like 'sem_bra%' then 'SEM Brand'
      when lower(campaign_name) like 'sem%' AND lower(campaign_name) not like 'sem_bra' then 'SEM non-Brand'
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date >>= '2024-01-01'
),

pm_acquisitions
AS (
  SELECT
    foi.*,
    'PM' as channel_type,
    t.pm_old_channel as pm_channel,
  FROM acquisition_order_ids foi 
  INNER JOIN `tlb-data-prod.data_platform.fct_adjust_event` adj ON foi.acquisition_transaction_id = SAFE_CAST(adj.transaction_id AS INT64)
  INNER JOIN taggings t USING(campaign_name)
  WHERE adj.date >>= '2024-01-01'
  AND   ( t.pm_new_convention_objective IS NOT NULL OR t.pm_old_channel IS NOT NULL ) 
  AND   ( DATE_DIFF(acquisition_order_date, DATE(installed_timestamp), DAY) <<= 6 OR  DATE_DIFF(acquisition_order_date, DATE(reattributed_timestamp), DAY) <<= 6 )
),

pm_vs_non_pm_acquisitions
AS (
  SELECT
    a.*,
    COALESCE(b.channel_type, 'Non-PM') as channel_type,
  FROM acquisition_order_ids a 
  LEFT JOIN pm_acquisitions b USING(acquisition_order_id)
),

orders
AS (
  SELECT
    b.country_code,
    b.analytical_customer_id,
    b.acquisition_order_date,
    b.acquisition_order_id,
    b.channel_type as acquisition_channel_type,
    -- b.is_incentivized as is_incentivized_acquisition,
    a.order_date,
    a.order_id,
    a.gmv_amount_eur,
  FROM `tlb-data-prod.data_platform.fct_order_info` a 
  INNER JOIN pm_vs_non_pm_acquisitions b ON a.analytical_customer_id = b.analytical_customer_id
  WHERE order_date >>= "2024-01-01"
  AND   is_successful 
),

cohorts
AS ( 
  SELECT
    country_code,
    DATE_TRUNC(acquisition_order_date, MONTH ) as acquisition_month,
    DATE_TRUNC(order_date, MONTH ) as order_month,
    DATE_DIFF(order_date, acquisition_order_date, MONTH) AS month_diff,
    acquisition_channel_type, 
    -- is_incentivized_acquisition,
    COUNT(DISTINCT analytical_customer_id) AS acids,
  FROM orders 
  GROUP BY ALL 
  ORDER BY 1,2,3,4,5,6
),

m1_cohorts
AS (
  SELECT
    *,
  FROM (
    SELECT
        a.country_code,
        a.acquisition_month, 
        a.order_month, 
        a.month_diff,
        a.acquisition_channel_type, 
        m0.acids as m0_cohort_size,
        a.acids as m1_customers, 
        -- a.acids / m0.acids as m1_retention_rate,
    FROM cohorts a 
    LEFT JOIN (SELECT * FROM cohorts WHERE month_diff = 0) m0
      USING (country_code, acquisition_month, acquisition_channel_type) -- is_incentivized_acquisition
  )
  WHERE month_diff = 1 
  GROUP BY ALL 
),

installs
AS (
  SELECT
    upper(ip_country) as country_code,
    DATE_TRUNC(date, month) as install_month, 
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non-PM'
    end as install_channel_type,
    COUNT(*) AS installs
  FROM `tlb-data-prod.data_platform.fct_adjust_event` adj 
  INNER JOIN taggings t USING(campaign_name)
  WHERE date >>= '2024-01-01'
  AND   activity_kind = 'install'
  GROUP BY ALL 
)

SELECT
  a.*,
  b.installs, 
  -- a.m0_cohort_size / m0.installs as acquisition_rate,
FROM m1_cohorts a 
LEFT JOIN installs b 
  ON a.country_code = b.country_code
  AND a.acquisition_month = b.install_month 
  AND a.acquisition_channel_type = b.install_channel_type]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.07e0yli0i5zzwb0zp0hoa1vui3py (copy 2)' name='Custom SQL Query' type='text'><![CDATA[WITH acquisition_order_ids
AS (
  SELECT
      country_code,
      order_id as acquisition_order_id,
      transaction_id as acquisition_transaction_id, 
      order_date as acquisition_order_date,
      analytical_customer_id, 
      case when incentive_amount_eur >> 0 then true else false end as is_incentivized,
  FROM `tlb-data-prod.data_platform.fct_order_info` foi 
  WHERE order_date >>= '2024-01-01'
  AND   is_successful 
  AND   is_acquisition
),

taggings 
AS ( 
  SELECT
    distinct 
    campaign_name,
    network_name, 
    case
      when campaign_name like '%_OBJ-reach_%' then 'Reach'
      when campaign_name like '%_OBJ-xrea_%' then 'Extended Reach'
      when campaign_name like '%_OBJ-rma_%' then 'RMA'
      when campaign_name like '%_OBJ-rmo_%' then 'RMO'
      when campaign_name like '%_OBJ-hva_%' then 'HVA'
      when campaign_name like '%_OBJ-react_%' then 'Reactivations'
      when network_name = 'SEO' then 'SEO'
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), '^(mob_bra|dis_bra|ps_bra|smartly_bra)') then 'Online Branding'
      when lower(campaign_name) like 'mob_reach%' or lower(campaign_name) like 'mob_rma%' then 'App (Reach / RMA)'
      when lower(campaign_name) like 'dis_reach%' or lower(campaign_name) like 'dis_rma%' then 'Display (Reach / RMA)'
      WHEN regexp_contains(lower(campaign_name), '^(ps_reach|smartly_reach|ps_rma|smartly_rma)') then 'Paid Social (Reach / RMA)'
      when lower(campaign_name) like 'sem_bra%' then 'SEM Brand'
      when lower(campaign_name) like 'sem%' AND lower(campaign_name) not like 'sem_bra' then 'SEM non-Brand'
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date >>= '2024-01-01'
),

pm_acquisitions
AS (
  SELECT
    foi.*,
    'PM' as channel_type,
    t.pm_old_channel as pm_channel,
  FROM acquisition_order_ids foi 
  INNER JOIN `tlb-data-prod.data_platform.fct_adjust_event` adj ON foi.acquisition_transaction_id = SAFE_CAST(adj.transaction_id AS INT64)
  INNER JOIN taggings t USING(campaign_name)
  WHERE adj.date >>= '2024-01-01'
  AND   ( t.pm_new_convention_objective IS NOT NULL OR t.pm_old_channel IS NOT NULL ) 
  AND   ( DATE_DIFF(acquisition_order_date, DATE(installed_timestamp), DAY) <<= 6 OR  DATE_DIFF(acquisition_order_date, DATE(reattributed_timestamp), DAY) <<= 6 )
),

pm_vs_non_pm_acquisitions
AS (
  SELECT
    a.*,
    COALESCE(b.channel_type, 'Non-PM') as channel_type,
  FROM acquisition_order_ids a 
  LEFT JOIN pm_acquisitions b USING(acquisition_order_id)
),

orders
AS (
  SELECT
    b.country_code,
    b.analytical_customer_id,
    b.acquisition_order_date,
    b.acquisition_order_id,
    b.channel_type as acquisition_channel_type,
    -- b.is_incentivized as is_incentivized_acquisition,
    a.order_date,
    a.order_id,
    a.gmv_amount_eur,
  FROM `tlb-data-prod.data_platform.fct_order_info` a 
  INNER JOIN pm_vs_non_pm_acquisitions b ON a.analytical_customer_id = b.analytical_customer_id
  WHERE order_date >>= "2024-01-01"
  AND   is_successful 
),

cohorts
AS ( 
  SELECT
    country_code,
    DATE_TRUNC(acquisition_order_date, MONTH ) as acquisition_month,
    DATE_TRUNC(order_date, MONTH ) as order_month,
    DATE_DIFF(order_date, acquisition_order_date, MONTH) AS month_diff,
    acquisition_channel_type, 
    -- is_incentivized_acquisition,
    COUNT(DISTINCT analytical_customer_id) AS acids,
  FROM orders 
  GROUP BY ALL 
  ORDER BY 1,2,3,4,5,6
),

m1_cohorts
AS (
  SELECT
    *,
  FROM (
    SELECT
        a.country_code,
        a.acquisition_month, 
        a.order_month, 
        a.month_diff,
        a.acquisition_channel_type, 
        m0.acids as m0_cohort_size,
        a.acids as m1_customers, 
        -- a.acids / m0.acids as m1_retention_rate,
    FROM cohorts a 
    LEFT JOIN (SELECT * FROM cohorts WHERE month_diff = 0) m0
      USING (country_code, acquisition_month, acquisition_channel_type) -- is_incentivized_acquisition
  )
  WHERE month_diff = 1 
  GROUP BY ALL 
),

installs
AS (
  SELECT
    upper(ip_country) as country_code,
    DATE_TRUNC(date, month) as install_month, 
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non-PM'
    end as install_channel_type,
    COUNT(*) AS installs
  FROM `tlb-data-prod.data_platform.fct_adjust_event` adj 
  INNER JOIN taggings t USING(campaign_name)
  WHERE date >>= '2024-01-01'
  AND   activity_kind = 'install'
  GROUP BY ALL 
)

SELECT
  a.*,
  b.installs, 
  -- a.m0_cohort_size / m0.installs as acquisition_rate,
FROM m1_cohorts a 
LEFT JOIN installs b 
  ON a.country_code = b.country_code
  AND a.acquisition_month = b.install_month 
  AND a.acquisition_channel_type = b.install_channel_type]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
