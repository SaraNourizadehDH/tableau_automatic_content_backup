      <aliases enabled='yes' />
      <column caption='% CVR Total ' datatype='real' name='[% CVR (copy)_3356307646941249564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1+(ZN(SUM([value])) - LOOKUP(ZN(SUM([value])), FIRST())) / ABS(LOOKUP(ZN(SUM([value])), FIRST()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='5. Viewed Vendor List or Searched %' datatype='real' name='[3. Viewed Home %  (copy) (copy)_3356307646900641805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;5.1 Viewed Vendor list or searched&quot; THEN [value] END) / SUM(IF [type] = &quot;4. Stayed&quot; THEN [value] END)' />
      </column>
      <column caption='4. Stayed %' datatype='real' name='[3. Viewed Home %  (copy)_3356307646900633612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;4. Stayed&quot; THEN [value] END) / SUM(IF [type] = &quot;3. Viewed Home&quot; THEN [value] END)' />
      </column>
      <column caption='3. Viewed Home % Total' datatype='real' name='[3. Viewed Home % (copy)_3356307646954639409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;3. Viewed Home&quot; THEN [value] END) / SUM(IF [type] = &quot;1. Total users&quot; THEN [value] END)' />
      </column>
      <column caption='4. Stayed % Total' datatype='real' name='[4. Stayed % (copy)_3356307646944301088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;4. Stayed&quot; THEN [value] END) / SUM(IF [type] = &quot;1. Total users&quot; THEN [value] END)' />
      </column>
      <column caption='5. Viewed Vendor List or Searched % Total' datatype='real' name='[5. Viewed Vendor List or Searched % (copy)_3356307646954893363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;5.1 Viewed Vendor list or searched&quot; THEN [value] END) / SUM(IF [type] = &quot;1. Total users&quot; THEN [value] END)' />
      </column>
      <column caption='6.1. Viewed Menu %' datatype='real' name='[5.1. Viewed Vendor List or Searched % (copy)_3356307646900908046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;6.1 Viewed Menu&quot; THEN [value] END) / SUM(IF [type] = &quot;5.1 Viewed Vendor list or searched&quot; THEN [value] END)' />
      </column>
      <column caption='6.2. Added to Cart %' datatype='real' name='[6.1 Viewed Menu % (copy)_3356307646900994063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;6.2 Added to Cart&quot; THEN [value] END) / SUM(IF [type] = &quot;6.1 Viewed Menu&quot; THEN [value] END)' />
      </column>
      <column caption='6.1. Viewed Menu % Total' datatype='real' name='[6.1. Viewed Menu % (copy)_3356307646954950708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;6.1 Viewed Menu&quot; THEN [value] END) / SUM(IF [type] = &quot;1. Total users&quot; THEN [value] END)' />
      </column>
      <column caption='6.3. Viewed Cart %' datatype='real' name='[6.2 Added to Cart %  (copy)_3356307646901125136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [type] = &quot;6.3 Viewed Cart&quot; THEN [value] END) / SUM(IF [type] = &quot;6.2 Added to Cart&quot; THEN [value] END)' />
