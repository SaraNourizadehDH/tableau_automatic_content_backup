      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Step' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;3. Viewed Home \%&quot;'>
          <calculation class='tableau' formula='&quot;3. Viewed Home %&quot;' />
        </column>
        <column caption='Display CVR ' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Total&quot;'>
          <calculation class='tableau' formula='&quot;% of Total&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3580C3B988AF484B8E750E2723C2279F'>
            <properties context=''>
              <relation connection='bigquery.18plyga0qh5j7a1dkhupo13y5s53' name='Custom SQL Query' type='text'><![CDATA[WITH taggings 
AS ( 
  SELECT
    adjust_id, 
    coalesce(idfa, idfv, android_id, gps_adid) as device_id,
    idfa, 
    idfv, 
    android_id, 
    gps_adid,
    date as install_date,
    campaign_name,
    network_name, 
    case
      when campaign_name like '%_OBJ-reach_%' then 'Reach'
      when campaign_name like '%_OBJ-xrea_%' then 'Extended Reach'
      when campaign_name like '%_OBJ-rma_%' then 'RMA'
      when campaign_name like '%_OBJ-rmo_%' then 'RMO'
      when campaign_name like '%_OBJ-hva_%' then 'HVA'
      when campaign_name like '%_OBJ-react_%' then 'Reactivations'
      when network_name = 'SEO' then 'SEO'
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), '^(mob_bra|dis_bra|ps_bra|smartly_bra)') then 'Online Branding'
      when lower(campaign_name) like 'mob_reach%' or lower(campaign_name) like 'mob_rma%' then 'App (Reach / RMA)'
      when lower(campaign_name) like 'dis_reach%' or lower(campaign_name) like 'dis_rma%' then 'Display (Reach / RMA)'
      WHEN regexp_contains(lower(campaign_name), '^(ps_reach|smartly_reach|ps_rma|smartly_rma)') then 'Paid Social (Reach / RMA)'
      when lower(campaign_name) like 'sem_bra%' then 'SEM Brand'
      when lower(campaign_name) like 'sem%' AND lower(campaign_name) not like 'sem_bra' then 'SEM non-Brand'
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date >>= '2025-01-01'
  AND   activity_kind = 'install'
), 

adjust_install_attribution 
AS (
  SELECT
    adjust_id,
    device_id,
    case 
      when pm_new_convention_objective is not null then 'PM'
      when pm_old_channel is not null then 'PM'
      else 'Non-PM'
    end as channel_type,
    pm_old_channel,
    network_name,
  FROM taggings
),

mapping
AS (
  SELECT
    a.anonymous_user_id, 
    date_trunc(first_session_date, month) as month_cohort, 
    a.first_session_date,
    a.country_code,
    a.operating_system,
    coalesce(b.channel_type, c.channel_type) as install_channel_type,
    coalesce(b.pm_old_channel, c.pm_old_channel) as install_pm_old_channel,
    coalesce(b.network_name, c.network_name) as install_network_name,
  FROM `tlb-data-dev.data_playground_growth.prospects_sessions` a 
  LEFT JOIN adjust_install_attribution b ON a.adjust_adid = b.adjust_id 
  LEFT JOIN adjust_install_attribution c ON a.advertising_id = c.device_id
),

session AS (
    SELECT
      anonymous_user_id,
      session_id,
      date,
      landed,
      stayed,
      viewed_home,
      COALESCE(fsss.searched, FALSE) AS searched,
      viewed_vendor_list,
      viewed_menu,
      added_to_cart,
      viewed_cart,
    FROM `tlb-data-prod.data_platform.fct_session` fs
    LEFT JOIN (
      select distinct session_id, date, true as searched
      from `tlb-data-prod.data_platform.fct_sub_session_search`
      where date >>= '2025-01-01'
    ) fsss USING(date, session_id)
    WHERE date >>= '2025-01-01'
),

user_actions AS (
  SELECT
    fs.anonymous_user_id,
    fh.hit_timestamp_utc as date,
    dse.event_action,
  FROM `tlb-data-prod.data_platform.fct_session` fs
  JOIN `tlb-data-prod.data_platform.fct_hit` fh USING(session_id, date)
  JOIN `tlb-data-prod.data_platform.dim_session_event` dse USING (session_event_id)
  WHERE
    date >>= '2025-01-01'
    AND (
      screen_name IN ('Address List Screen', 'Express Checkout Screen')
      OR (event_action = 'hero_banner.clicked' AND event_label = '.hybrid_login')
      OR event_action IN (
        'home_screen.loaded', 'cart.loaded', 'cart.clicked', 'order_coupon.failed',
        'order_coupon.submitted', 'order_coupon.removed', 'disclaimer.clicked',
        'checkout.clicked', 'address_form.shown', 'address_add.clicked', 'map.loaded',
        'address_error.shown', 'save_address.clicked', 'save_address.error',
        'save_address.succeeded', 'subscription_plan.clicked', 'rider_tip.clicked',
        'rider_tip.removed', 'rider_tip.opened', 'order_payment_method.chosen',
        'hybrid_login.loaded', 'hybrid_login.clicked', 'login.failed', 'login.succeeded',
        'register.started', 'register.failed', 'register.completed', 'geolocation.requested',
        'transaction.clicked', 'transaction.failed', 'transaction', 'order_tracking.loaded',
        'cancel_order.clicked', 'cancel_order.confirmed', 'cancel_order.success',
        'app.opened', 'Not applicable', 'screen.opened', 'product_choice.opened'
      )
    )
),

user_action_dates AS (
  SELECT
    anonymous_user_id,
    DATE_TRUNC(DATE(date), month) month_cohort,
    MIN(CASE WHEN event_action = 'checkout.clicked' THEN date END) AS checkout_start_date,
    MIN(CASE WHEN event_action = 'hybrid_login.loaded' THEN date END) AS viewed_login,
    MIN(CASE WHEN event_action IN ('login.succeeded', 'register.completed') THEN date END) AS authentication_date,
    MIN(CASE WHEN event_action = 'map.loaded' THEN date END) AS viewed_map,
    MIN(CASE WHEN event_action = 'address_form.shown' THEN date END) AS viewed_address_form,
    MIN(CASE WHEN event_action = 'save_address.succeeded' THEN date END) AS address_form_saved,
    MIN(CASE WHEN event_action = 'save_address.error' THEN date END) AS address_form_save_error,
    MIN(CASE WHEN event_action = 'save_address.clicked' THEN date END) AS address_form_save_clicked,
    MIN(CASE WHEN event_action = 'transaction.clicked' THEN date END) AS clicked_place_order,
    MIN(CASE WHEN event_action = 'transaction' THEN date END) AS transaction_date,
    MIN(CASE WHEN event_action = 'order_tracking.loaded' THEN date END) AS viewed_order_tracking,
    MIN(CASE WHEN event_action IN ('cancel_order.confirmed', 'cancel_order.success') THEN date END) AS order_cancellation_date,
    MIN(CASE WHEN event_action = 'product_choice.opened' THEN date END) AS viewed_product,
  FROM user_actions
  GROUP BY ALL
),

final 
AS (
  SELECT
    DATE_TRUNC(first_session_date, MONTH) AS period_user_creation,
    month_cohort,
    COALESCE(country_code, 'N/A') as country_code,
    COALESCE(operating_system, 'N/A') as operating_system,
    COALESCE(install_channel_type, "N/A") as install_channel_type,
    COALESCE(install_network_name, "N/A") as install_network_name,
    COALESCE(install_pm_old_channel, "N/A") as install_pm_old_channel,
    COUNT(DISTINCT a.anonymous_user_id) AS total_users,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND landed, a.anonymous_user_id, NULL)) AS users_landed,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND viewed_home, a.anonymous_user_id, NULL)) AS users_viewed_home,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND stayed, a.anonymous_user_id, NULL)) AS users_stayed,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND (viewed_vendor_list OR searched), a.anonymous_user_id, NULL)) AS users_viewed_vendor_list_or_searched,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND viewed_menu, a.anonymous_user_id, NULL)) AS users_viewed_menu,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(viewed_product), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_viewed_product,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND added_to_cart, a.anonymous_user_id, NULL)) AS users_added_to_cart,
    COUNT(DISTINCT IF(DATE_DIFF(date, first_session_date, DAY) <<= 28 AND viewed_cart, a.anonymous_user_id, NULL)) AS users_viewed_cart,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(checkout_start_date), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_clicked_checkout,
    COUNT(DISTINCT IF((DATE_DIFF(DATE(viewed_login), first_session_date, DAY) <<= 28 AND DATE_DIFF(DATE(checkout_start_date), first_session_date, DAY) <<= 28), a.anonymous_user_id, NULL)) AS users_viewed_login,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(viewed_login), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_viewed_login_total,
    COUNT(DISTINCT IF((DATE_DIFF(DATE(authentication_date), first_session_date, DAY) <<= 28 AND DATE_DIFF(DATE(checkout_start_date), first_session_date, DAY) <<= 28), a.anonymous_user_id, NULL)) AS users_authenticated,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(viewed_map), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_viewed_map,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(viewed_address_form), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_viewed_address_form,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(address_form_save_clicked), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_address_form_clicked_save,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(address_form_save_error), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_address_form_save_error,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(address_form_saved), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_address_form_saved,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(clicked_place_order), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_clicked_place_order,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(transaction_date), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_completed_transaction,
    COUNT(DISTINCT IF(DATE_DIFF(DATE(order_cancellation_date), first_session_date, DAY) <<= 28, a.anonymous_user_id, NULL)) AS users_cancelled_order
  FROM mapping a 
  LEFT JOIN session USING(anonymous_user_id)
  LEFT JOIN user_action_dates USING(anonymous_user_id, month_cohort)
  GROUP BY ALL
)

SELECT
  period_user_creation,
  country_code,
  operating_system,
  install_channel_type,
  install_pm_old_channel,
  install_network_name,
  type,
  sum(value) as value
FROM final
UNPIVOT (
  value for type in (
    total_users as '1. Total users',
    users_landed as '2. Landed',
    users_viewed_home as '3. Viewed Home',
    users_stayed as '4. Stayed',
    users_viewed_vendor_list_or_searched as '5.1 Viewed Vendor list or searched',
    users_viewed_menu as '6.1 Viewed Menu',
    users_added_to_cart as '6.2 Added to Cart',
    users_viewed_cart as '6.3 Viewed Cart',
    users_clicked_checkout as '7.1 Clicked Checkout',
    users_viewed_login as '7.2 Viewed login',
    users_authenticated as '7.3 Authenticated',
    -- users_viewed_map as '7.4 Map location Viewed',
    users_viewed_address_form as '7.5 Address entered',
    users_address_form_clicked_save as '7.6 Clicked save address',
    users_address_form_save_error as '7.7 Error save address',
    users_address_form_saved as '7.8 Saved address',
    users_clicked_place_order as '8.1 Attempted to place order',
    users_completed_transaction as '8.2 Placed order (Acquisition)',
    users_cancelled_order as '9.1 Cancelled order'
  )
)
GROUP BY ALL
ORDER BY 1,2,3,4,5]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='4. Acquisition CVR' inline='true' name='federated.1t0v3be1x4khmw11g6qj01913g00 (copy 2)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.18plyga0qh5j7a1dkhupo13y5s53 (copy 2)'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='george.abou@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18plyga0qh5j7a1dkhupo13y5s53 (copy 2)' name='Custom SQL Query' type='text'><![CDATA[WITH taggings 
AS ( 
  SELECT
    distinct 
    campaign_name,
    network_name, 
    case
      when campaign_name like '%_OBJ-reach_%' then 'Reach'
      when campaign_name like '%_OBJ-xrea_%' then 'Extended Reach'
      when campaign_name like '%_OBJ-rma_%' then 'RMA'
      when campaign_name like '%_OBJ-rmo_%' then 'RMO'
      when campaign_name like '%_OBJ-hva_%' then 'HVA'
      when campaign_name like '%_OBJ-react_%' then 'Reactivations'
      when network_name = 'SEO' then 'SEO'
    end pm_new_convention_objective,
    case
      when regexp_contains(lower(campaign_name), '^(mob_bra|dis_bra|ps_bra|smartly_bra)') then 'Online Branding'
      when lower(campaign_name) like 'mob_reach%' or lower(campaign_name) like 'mob_rma%' then 'App (Reach / RMA)'
      when lower(campaign_name) like 'dis_reach%' or lower(campaign_name) like 'dis_rma%' then 'Display (Reach / RMA)'
      WHEN regexp_contains(lower(campaign_name), '^(ps_reach|smartly_reach|ps_rma|smartly_rma)') then 'Paid Social (Reach / RMA)'
      when lower(campaign_name) like 'sem_bra%' then 'SEM Brand'
      when lower(campaign_name) like 'sem%' AND lower(campaign_name) not like 'sem_bra' then 'SEM non-Brand'
    end as pm_old_channel, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event`
  WHERE date >>= '2025-01-01'
), 

installs 
AS (
  SELECT
    upper(ip_country) as country_code,
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non-PM'
      end as channel_type,
      pm_old_channel,
      date,
      count(distinct adjust_id) as all_attributions,
      count(distinct case when activity_kind = 'install' then adjust_id end) as installs, 
  FROM `tlb-data-prod.data_platform.fct_adjust_event` a 
  INNER JOIN taggings b USING(campaign_name)
  WHERE date >>= '2025-01-01'
  AND   activity_kind in ("install" , 'att_update', 'reinstall','reattribution', 'reattribution_update', 'reattribution_reinstall')  
  GROUP BY ALL 
),

acquisitions
AS (
  SELECT
    upper(ip_country) as country_code,
    date,
    case 
        when pm_new_convention_objective is not null then 'PM'
        when pm_old_channel is not null then 'PM'
        else 'Non-PM'
    end as channel_type,
    pm_old_channel,
    COUNT(DISTINCT order_id) AS acquisitions,
    COUNT(DISTINCT 
      CASE 
        WHEN 
          DATE_DIFF(order_date, DATE(installed_timestamp), DAY) <<= 6 OR  DATE_DIFF(order_date, DATE(reattributed_timestamp), DAY) <<= 6 
        THEN order_id 
      END
    ) as acquisitions_attribution_window,
    COUNT(DISTINCT CASE WHEN DATE_DIFF(order_date, DATE(installed_timestamp), DAY) <<= 6 THEN order_id END) as acquisitions_attribution_window_excl_reattr,
  FROM `tlb-data-prod.data_platform.fct_adjust_event` adj 
  INNER JOIN taggings b USING(campaign_name)
  INNER JOIN `tlb-data-prod.data_platform.fct_order_info` foi  ON SAFE_CAST(adj.transaction_id AS INT64) = foi.transaction_id
  WHERE order_date >>= "2025-01-01"
  AND   date >>= '2025-01-01'
  AND   is_successful
  AND   is_acquisition
  GROUP BY ALL 
)

SELECT
  a.*,
  b.acquisitions,
  b.acquisitions_attribution_window,
  acquisitions_attribution_window_excl_reattr,
FROM installs a 
INNER JOIN acquisitions b USING(country_code, date, channel_type, pm_old_channel)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
