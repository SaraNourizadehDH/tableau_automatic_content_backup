      <aliases enabled='yes' />
      <column caption='Dynamic metric' datatype='real' name='[Calculation_376332093603221504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] =  &apos;Orders&apos; then [orders]&#10;ELSEIF [Parameters].[Parameter 1] =  &apos;GMV&apos; THEN  [gmv]&#10;else [acids] end' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_4763612188203741184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &apos;Value Segment&apos; then [customer_value_value_segment]&#10;when &apos;Incentive Seekers&apos; then str([is_incentive_seekers_archetype])&#10;when &apos;Lifecycle - Platform&apos; then [lifecycle_platform]&#10;when &apos;Lifecycle - Food&apos; then [lifecycle_food]&#10;when &apos;Lifecycle - QC&apos; then [lifecycle_qc]&#10;when &apos;Lifecycle - tpro&apos; then [lifecycle_pro]&#10;when &apos;QC MHU&apos; then str([Calculation_7025333995693420551])&#10;when &apos;Frequency Decreasing&apos; then[Calculation_7025333995692867590]&#10;when &apos;Loss Risk&apos; then [Calculation_7025333995628802048]&#10;end' />
        <aliases>
          <alias key='%null%' value='Unsegmented' />
          <alias key='&quot;1_HVC&quot;' value='HVC' />
          <alias key='&quot;2_MVC&quot;' value='MVC' />
          <alias key='&quot;3_LVC&quot;' value='LVC' />
          <alias key='&quot;4_high_loss&quot;' value='High loss' />
          <alias key='&quot;f&quot;' value='Non Incentive Seekers' />
          <alias key='&quot;t&quot;' value='Incentive Seekers' />
        </aliases>
      </column>
      <column caption='Period range' datatype='string' name='[Calculation_4763612188210790403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [period] = &apos;weekly&apos; then&#10;    if [period_start] = [Parameters].[Parameter 5] then &apos;Same period&apos;&#10;    ELSEIF  [Parameters].[Parameter 5] = DATEADD(&apos;day&apos;,7,[period_start]) then &apos;Previous period&apos;&#10;    else &quot;other&quot; end&#10;&#10;ELSE&#10;    if [period_start] = [Parameters].[Parameter 5] then &apos;Same period&apos;&#10;    ELSEIF  [Parameters].[Parameter 5] = DATEADD(&apos;month&apos;,1,[period_start]) then &apos;Previous period&apos;&#10;    else &quot;other&quot; end&#10;end' />
      </column>
      <column caption='total or %' datatype='real' name='[Calculation_4763612188258467845]' role='measure' type='quantitative'>
