      <column caption='Loss Risk' datatype='string' name='[Calculation_7025333995628802048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [lifecycle_platform] in (&apos;Prospect&apos;,&apos;New Customer&apos;) then &quot;Low-Risk&quot;&#10;elseif [lifecycle_platform] = &apos;Active&apos; then&#10;    if [Calculation_7025333995692867590] = &apos;High-freq-drop&apos; then &apos;High-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] = &apos;Med-freq-drop&apos; and [is_incentive_seekers_archetype] then &apos;High-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] = &apos;Med-freq-drop&apos; then &apos;Med-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] in (&apos;Low-freq-drop&apos;,&apos;no-freq-drop&apos;) and [is_incentive_seekers_archetype] then &apos;Med-Risk&apos;&#10;    else &quot;Low-Risk&quot; end&#10;ELSEIF [lifecycle_platform] = &apos;Churn&apos; and [is_incentive_seekers_archetype] then &apos;High-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Churn&apos; then &apos;Med-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Inactive&apos;then &apos;Med-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Lost&apos; then &quot;Low-Risk&quot;&#10;end' />
