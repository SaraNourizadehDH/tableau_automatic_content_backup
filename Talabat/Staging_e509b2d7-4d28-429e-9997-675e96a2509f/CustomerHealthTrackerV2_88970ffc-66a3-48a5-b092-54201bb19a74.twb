      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_4763612188365201433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [period] = &apos;weekly&apos;then  &apos;week&apos;+ str([period_start])&#10;else &apos;Month-&apos; + str([period_start])&#10;end' />
