      <column caption='dynamic coloring' datatype='integer' name='[Calculation_4763612188314210311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Value Segment&quot; and [Parameters].[Select Dimension 1 (copy)_4763612188204027905] = &quot;Incentive Seekers&quot;&#10;or ([Parameters].[Select Dimension 1 (copy)_4763612188204027905] = &quot;Value Segment&quot; and [Parameters].[Parameter 4] = &quot;Incentive Seekers&quot;)&#10;&#10;THEN&#10;if ([Dimension 1 (copy)_4763612188204679170])=&apos;1_HVC&apos;  then 3&#10;    ELSEIF ([customer_value_value_segment]) =&apos;2_MVC&apos; and ([is_incentive_seekers_archetype]) then  3&#10;    ELSEIF ([customer_value_value_segment]) =&apos;2_MVC&apos; then 2&#10;    else 1&#10; end&#10;&#10;else 2 end' />
      </column>
      <column caption='sss' datatype='boolean' name='[Calculation_4763612188335538185]' role='dimension' type='nominal'>
