          <datasources>
            <datasource caption='enterprise_segmentation_acid_final_v3 (data_playground_growth)' name='federated.1k8v90a00tbbdy1fei4nt1gd3lsf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Loss Risk&quot;'>
              <calculation class='tableau' formula='&quot;Loss Risk&quot;' />
            </column>
            <column alias='Month - Aug' caption='Select Period' datatype='date' default-format='*dd-mmm' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
              <aliases>
                <alias key='#2025-05-01#' value='Month - May' />
                <alias key='#2025-05-05#' value='Week - 05/May' />
                <alias key='#2025-05-12#' value='Week - 12/May' />
                <alias key='#2025-05-19#' value='Week - 19/May' />
                <alias key='#2025-05-26#' value='Week - 26/May' />
                <alias key='#2025-06-01#' value='Month - Jun' />
                <alias key='#2025-06-02#' value='Week - 02/Jun' />
                <alias key='#2025-06-09#' value='Week - 09-Jun' />
                <alias key='#2025-06-16#' value='Week - 16-Jun' />
                <alias key='#2025-06-23#' value='Week - 23-Jun' />
                <alias key='#2025-06-30#' value='Week - 30-Jun' />
                <alias key='#2025-07-01#' value='Month - Jul' />
                <alias key='#2025-07-07#' value='Week - 07/Jul' />
                <alias key='#2025-07-14#' value='Week - 14/Jul' />
                <alias key='#2025-07-21#' value='Week - 21/Jul' />
                <alias key='#2025-07-28#' value='Week - 28/Jul' />
                <alias key='#2025-08-01#' value='Month - Aug' />
                <alias key='#2025-08-04#' value='Week - 04/Aug' />
                <alias key='#2025-08-11#' value='Week - 11/Aug' />
                <alias key='#2025-08-18#' value='Week - 18/Aug' />
                <alias key='#2025-08-25#' value='Week - 25/Aug' />
                <alias key='#2025-09-01#' value='Week - 01/Sep' />
              </aliases>
            </column>
            <column caption='Select Dimension 2' datatype='string' name='[Select Dimension 1 (copy)_4763612188204027905]' param-domain-type='list' role='measure' type='nominal' value='&quot;Value Segment&quot;'>
              <calculation class='tableau' formula='&quot;Value Segment&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k8v90a00tbbdy1fei4nt1gd3lsf'>
            <column caption='Dimension 1' datatype='string' name='[Calculation_4763612188203741184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &apos;Value Segment&apos; then [customer_value_value_segment]&#10;when &apos;Incentive Seekers&apos; then str([is_incentive_seekers_archetype])&#10;when &apos;Lifecycle - Platform&apos; then [lifecycle_platform]&#10;when &apos;Lifecycle - Food&apos; then [lifecycle_food]&#10;when &apos;Lifecycle - QC&apos; then [lifecycle_qc]&#10;when &apos;Lifecycle - tpro&apos; then [lifecycle_pro]&#10;when &apos;QC MHU&apos; then str([Calculation_7025333995693420551])&#10;when &apos;Frequency Decreasing&apos; then[Calculation_7025333995692867590]&#10;when &apos;Loss Risk&apos; then [Calculation_7025333995628802048]&#10;end' />
              <aliases>
                <alias key='%null%' value='Unsegmented' />
                <alias key='&quot;1_HVC&quot;' value='HVC' />
                <alias key='&quot;2_MVC&quot;' value='MVC' />
                <alias key='&quot;3_LVC&quot;' value='LVC' />
                <alias key='&quot;4_high_loss&quot;' value='High loss' />
                <alias key='&quot;f&quot;' value='Non Incentive Seekers' />
                <alias key='&quot;t&quot;' value='Incentive Seekers' />
              </aliases>
            </column>
            <column caption='Period range' datatype='string' name='[Calculation_4763612188210790403]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [period] = &apos;weekly&apos; then&#10;    if [period_start] = [Parameters].[Parameter 5] then &apos;Same period&apos;&#10;    ELSEIF  [Parameters].[Parameter 5] = DATEADD(&apos;day&apos;,7,[period_start]) then &apos;Previous period&apos;&#10;    else &quot;other&quot; end&#10;&#10;ELSE&#10;    if [period_start] = [Parameters].[Parameter 5] then &apos;Same period&apos;&#10;    ELSEIF  [Parameters].[Parameter 5] = DATEADD(&apos;month&apos;,1,[period_start]) then &apos;Previous period&apos;&#10;    else &quot;other&quot; end&#10;end' />
            </column>
            <column caption='Loss Risk' datatype='string' name='[Calculation_7025333995628802048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [lifecycle_platform] in (&apos;Prospect&apos;,&apos;New Customer&apos;) then &quot;Low-Risk&quot;&#10;elseif [lifecycle_platform] = &apos;Active&apos; then&#10;    if [Calculation_7025333995692867590] = &apos;High-freq-drop&apos; then &apos;High-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] = &apos;Med-freq-drop&apos; and [is_incentive_seekers_archetype] then &apos;High-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] = &apos;Med-freq-drop&apos; then &apos;Med-Risk&apos;&#10;    elseif [Calculation_7025333995692867590] in (&apos;Low-freq-drop&apos;,&apos;no-freq-drop&apos;) and [is_incentive_seekers_archetype] then &apos;Med-Risk&apos;&#10;    else &quot;Low-Risk&quot; end&#10;ELSEIF [lifecycle_platform] = &apos;Churn&apos; and [is_incentive_seekers_archetype] then &apos;High-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Churn&apos; then &apos;Med-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Inactive&apos;then &apos;Med-Risk&apos;&#10;ELSEIF [lifecycle_platform] = &apos;Lost&apos; then &quot;Low-Risk&quot;&#10;end' />
            </column>
            <column caption='Freq Drop Bucket ' datatype='string' name='[Calculation_7025333995692867590]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([freq_drop_bcuket],&apos;no-freq-drop&apos;)' />
              <aliases>
                <alias key='&quot;High-freq-drop&quot;' value='High drop' />
                <alias key='&quot;Low-freq-drop&quot;' value='Low drop' />
                <alias key='&quot;Med-freq-drop&quot;' value='Med drop' />
                <alias key='&quot;no-freq-drop&quot;' value='No-freq-drop' />
              </aliases>
            </column>
            <column caption='QC MHU' datatype='string' name='[Calculation_7025333995693420551]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [qc_mhu] then &apos;QC Habitual&apos;&#10;else &apos;Non QC Habitual&apos; end' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_4763612188204679170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Select Dimension 1 (copy)_4763612188204027905]&#10;when &apos;Value Segment&apos; then [customer_value_value_segment]&#10;when &apos;Incentive Seekers&apos; then str([is_incentive_seekers_archetype])&#10;when &apos;Lifecycle - Platform&apos; then [lifecycle_platform]&#10;when &apos;Lifecycle - Food&apos; then [lifecycle_food]&#10;when &apos;Lifecycle - QC&apos; then [lifecycle_qc]&#10;when &apos;Lifecycle - tpro&apos; then [lifecycle_pro]&#10;when &apos;QC MHU&apos; then str([Calculation_7025333995693420551])&#10;when &apos;Frequency Decreasing&apos; then[Calculation_7025333995692867590]&#10;when &apos;Loss Risk&apos; then [Calculation_7025333995628802048]&#10;end' />
              <aliases>
                <alias key='%null%' value='Unsegmented (first order)' />
                <alias key='&quot;1_HVC&quot;' value='HVC' />
                <alias key='&quot;2_MVC&quot;' value='MVC' />
                <alias key='&quot;3_LVC&quot;' value='LVC' />
