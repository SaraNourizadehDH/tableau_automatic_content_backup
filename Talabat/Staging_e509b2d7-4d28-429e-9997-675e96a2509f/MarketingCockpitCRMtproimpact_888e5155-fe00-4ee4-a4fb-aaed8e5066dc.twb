      <column caption='Upper View filter ' datatype='string' name='[Bottom View filter (copy)_3203396369828786188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Lifecycle Segmentation&apos;&#10; then &apos;Lifecycle&apos;&#10;else &apos;Value&apos;&#10;end' />
      </column>
      <column caption='segmentation title' datatype='string' name='[Calculation_3203396369833168909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Lifecycle Segmentation&apos; then &apos;Customers by Lifecycle Segments and Churn Ratio&apos;&#10;else &apos;Customer Value Segments by &apos; + [Parameters].[Select Metric (copy)_3203396369814667274]&#10;end' />
      </column>
      <column caption='with negative values' datatype='integer' name='[Calculation_4563764971985485824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [segment] in (&apos;lost_acid_count&apos;,&apos;churned_user_count&apos;,&apos;inactive_acid_count&apos;) then -1* [value]&#10;else [value]&#10;end' />
      </column>
      <column caption='churn ratio' datatype='real' name='[Calculation_4563764971986624513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [segment] = &apos;churned_user_count&apos; then [value] end) &#10;/&#10;SUM(if [segment] in (&apos;reactivated_user_count&apos;,&apos;retained_user_count&apos;,&apos;acquisition_count&apos;) then [value] end)' />
      </column>
