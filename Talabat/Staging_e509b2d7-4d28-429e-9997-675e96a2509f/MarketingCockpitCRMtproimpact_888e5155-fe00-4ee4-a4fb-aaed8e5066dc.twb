            <column caption='M1 Freq' datatype='real' name='[Calculation_3414080425954795523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([m1_order_count])/sum([m1_user_count])' />
            </column>
            <column caption='Dynamic country measure' datatype='real' name='[Calculation_3414080425961222151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;    when &quot;Orders&quot; then [order_count]&#10;    when &quot;GMV&quot; then [gmv]&#10;    when &quot;MAU&quot; then [monthly_active_user_count]&#10;    when &quot;Acquistions&quot; then [acquisition_user_count]&#10;    when &quot;tpro Subs&quot; then [tpro_active_subscriber_count]&#10;end' />
            </column>
            <column caption='lookup(SUM([Dynamic country measure]),-1)' datatype='real' name='[Calculation_5822661805644009473]' role='measure' type='quantitative' user:unnamed='country YoY'>
              <calculation class='tableau' formula='lookup(SUM([Calculation_3414080425961222151]),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_6869256132410896401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/SUM([monthly_active_user_count])' />
            </column>
            <column caption='Month - 1 year' datatype='string' name='[Selected month  (copy)_2052093385971552256]' role='dimension' type='nominal'>
