      </field-sort-info>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select vertical' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Platform&quot;'>
          <calculation class='tableau' formula='&quot;Platform&quot;' />
        </column>
        <column caption='Select Metric (CRM impact tab) 1' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
          <calculation class='tableau' formula='&quot;Orders&quot;' />
        </column>
      </datasource-dependencies>
      <filter class='categorical' column='[Calculation_4760093768123584525]' filter-group='2'>
        <groupfilter function='member' level='[Calculation_4760093768123584525]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_029D8A04231D4B7BA0CFE8395B10DEC6'>
            <properties context=''>
              <relation connection='bigquery.0hih84y0hm3lnj1fzlpeu03nmfy6' name='Custom SQL Query' type='text'><![CDATA[WITH
  user_first_order
  AS
  (
    SELECT
      account_id,
      min(country_iso) country_iso,
      min(order_date) as first_order_date
    FROM `tlb-data-prod.data_platform.fct_order_info`
    WHERE is_successful
    GROUP BY 1
  ),

  CRM_holdout
  AS
  (
    SELECT
      country_iso,
      bu.external_id,
      is_in_global_control_group is_gcg2,
      first_order_date,
      created_at,
    FROM `fulfillment-dwh-production.curated_data_shared_mkt.braze_user_data` bu
    INNER JOIN user_first_order
        ON bu.external_id = CAST(account_id as string)
    INNER JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS eam
        ON bu.external_id = eam.external_id
          AND bu.appgroup_name = eam.appgroup_name
          AND eam.is_most_recent_account
    WHERE DATE(created_at) >> "2022-02-23"
      and first_order_date >>='2023-1-1' and first_order_date >>= date_sub(current_date(), interval 36 month)
      -- and bu.external_id = '32940232'
  ),

  scaffold as (
    select
      distinct
      country_iso,
      external_id,
      is_gcg2,
      created_at,
      first_order_date,
      date_trunc(d.date,quarter) quarter
    from CRM_holdout c
    join `tlb-data-prod.data_platform.dim_date` d
      on d.date >>='2023-1-1'
      and d.date between first_order_date and date_add(first_order_date, interval 12 month)
      and date_trunc(d.date, quarter) != date_trunc(first_order_date, quarter)
    group by all
  ),

  talabat_braze_order_spend
  AS
  (
    SELECT
      o.order_id,
      o.order_date,
      io.country_code,
      sum(io.platform_incentive_cost_eur) braze_incentive_amount_eur,
      sum(IF(o.is_non_food = False, io.platform_incentive_cost_eur, null)) braze_incentive_amount_eur_food,
      sum(IF(o.is_non_food, io.platform_incentive_cost_eur, null)) braze_incentive_amount_eur_qc,
      sum(IF(o.is_darkstore, io.platform_incentive_cost_eur, null)) braze_incentive_amount_eur_tmart
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` io
    JOIN `tlb-data-prod.data_platform.fct_order_info` o
      using(order_id, order_date)
    JOIN `tlb-data-prod.data_platform.dim_incentives_voucher` i
      USING(incentive_campaign_id)
    WHERE io.is_successful
      AND incentive_type_detail = 'MARKETING'
      and not is_stamp_card
      AND LOWER(TRIM(COALESCE(src_campaign_reference_id,braze_ref_id,voucher_name))) not like '%test%'
      AND io.incentive_sub_type = 'voucher wallet'
      and order_date >>='2024-1-1' and order_date >>= date_sub(current_date(), interval 24 month)
    GROUP BY ALL
  ),

  base_orders -- The base can be a calendar month or quarter
  AS
  (
    SELECT
      s.external_id,
      s.quarter,
      s.is_gcg2,
      s.country_iso  as account_country_iso,

      count(DISTINCT order_id) nb_orders,
      count(DISTINCT IF(o.is_non_food = False, order_id, null)) nb_food_orders,
      count(DISTINCT IF(o.is_non_food, order_id, null)) nb_qc_orders,
      count(DISTINCT IF(o.is_darkstore, order_id, null)) nb_tmart_orders,

      count(distinct case when a.acquisition_non_food_order_id = o.order_id then s.external_id end) nb_qc_acquisitions,
      count(distinct case when a.non_food_adoption_date = o.order_date then s.external_id end) nb_qc_adoptions,

      sum(o.gmv_amount_eur) total_gmv_eur,
      sum(IF(o.is_non_food = False, o.gmv_amount_eur, null)) total_gmv_eur_food,
      sum(IF(o.is_non_food, o.gmv_amount_eur, null)) total_gmv_eur_qc,
      sum(IF(o.is_darkstore, o.gmv_amount_eur, null)) total_gmv_eur_tmart,

      sum(sp.braze_incentive_amount_eur) total_braze_incentive_spend_eur,
      sum(sp.braze_incentive_amount_eur_food) total_braze_incentive_spend_eur_food,
      sum(sp.braze_incentive_amount_eur_qc) total_braze_incentive_spend_eur_qc,
      sum(sp.braze_incentive_amount_eur_tmart) total_braze_incentive_spend_eur_tmart
    from scaffold s
    left join `tlb-data-prod.data_platform.fct_order_info` o
      on cast(o.account_id as string) = s.external_id
      and date_trunc(o.order_date,quarter) = quarter
      and o.is_successful
      AND o.order_date >>='2024-1-1' and o.order_date >>= date_sub(current_date(), interval 24 month)
    LEFT JOIN talabat_braze_order_spend sp
      USING(order_id)
    LEFT JOIN `tlb-data-prod.data_platform.agg_account_profile` a
      on s.external_id = cast(a.account_id as string)
    where quarter >>= '2024-1-1' and quarter >>= date_sub(current_date(), interval 24 month)
    GROUP BY ALL
  ),

  tpro as (
    select 
      c.*,
      COALESCE(MAX(CASE WHEN tpro.is_acquired AND tpro.is_free_trial THEN 1 END), 0) AS new_tpro_acquisition,
      COALESCE(MAX(CASE WHEN tpro.is_winback THEN 1 END), 0) AS tpro_winback,
    from base_orders c
    LEFT JOIN `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
        ON CAST(c.external_id AS STRING) = CAST(tpro.account_id AS STRING)
        and date_trunc(tpro.date,quarter) = quarter
        AND tpro.date >>='2024-1-1' and tpro.date >>= date_sub(current_date(), interval 24 month)
    group by all
  ),

  coutnry_ratio as (
  select
    quarter,
    IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
    sum(total_fl_egpo_eur)  /sum(gmv_eur) country_quarter_fl_egpo_ratio,

    sum(total_fl_egpo_eur) country_quarter_fl_egpo,
    sum(IF(is_non_food = False, total_fl_egpo_eur, null)) country_quarter_fl_egpo_food,
    sum(IF(is_non_food, total_fl_egpo_eur, null)) country_quarter_fl_egpo_qc,
    sum(IF(is_darkstore, total_fl_egpo_eur, null)) country_quarter_fl_egpo_tmart,

    sum(gmv_eur) country_quarter_gmv,
    sum(IF(is_non_food = False, gmv_eur, null)) country_quarter_gmv_food,
    sum(IF(is_non_food, gmv_eur, null)) country_quarter_gmv_qc,
    sum(IF(is_darkstore, gmv_eur, null)) country_quarter_gmv_tmart,

    count(distinct order_id) as country_quarter_orders,
    count(distinct IF(is_non_food = False, order_id,null)) as country_quarter_orders_food,
    count(distinct IF(is_non_food, order_id, null)) as country_quarter_orders_qc,
    count(distinct IF(is_darkstore, order_id, null)) as country_quarter_orders_tmart,

    from (
      select
        date_trunc(order_date,quarter) quarter,
        country_code,
        order_id,
        is_darkstore,
        is_non_food,
        gmv_amount_lc /exchange_rate_to_eur as gmv_eur,
        IF(is_finance_closed_month, act_egpo_eur, est_egpo_eur) total_egpo_eur,
        iF(is_finance_closed_month, act_fl_egpo_eur, est_fl_egpo_eur) total_fl_egpo_eur,
      from `tlb-data-prod.data_platform.fct_order_egpo`
      where is_successful
        and order_date >>= '2024-1-1'
        )
    group by rollup(1,(country_code))
    having quarter is not null
  ),

  qc_country_ratio as(
  select
    date_trunc(order_date,quarter) quarter,
    IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
    count(distinct case when a.acquisition_non_food_order_id = o.order_id then account_id end) country_qc_acquisitions,
    count(distinct case when a.non_food_adoption_date = o.order_date then account_id end) country_qc_adoptions,
  from `tlb-data-prod.data_platform.fct_order_info` o
  LEFT JOIN `tlb-data-prod.data_platform.agg_account_profile` a
    using(account_id)
  where order_date >>= '2024-1-1' and order_date >>= date_sub(current_date(), interval 24 month)
  group by rollup(1,(country_code))
      having quarter is not null
  ),

  tpro_counrty_ratio as(
  select 
    quarter,
    IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
    sum(country_new_tpro_acquisition) country_new_tpro_acquisition,
    sum(country_tpro_winback) country_tpro_winback
    from(
      select 
        account_id,
        date_trunc(date,quarter) quarter,
        country_code,
        MAX(CASE WHEN tpro.is_acquired AND tpro.is_free_trial THEN 1 END) AS country_new_tpro_acquisition,
        MAX(CASE WHEN tpro.is_winback THEN 1 END) AS country_tpro_winback,
      from `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
      where tpro.date >>='2024-1-1' and tpro.date >>= date_sub(current_date(), interval 24 month)
      group by all
    )
    group by rollup(1,(country_code))
    having quarter is not null
  ),

  country_qau as(
    select
        date_trunc(order_date, quarter) quarter,
        IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
        count(distinct analytical_customer_id) qau
      from `tlb-data-prod.data_platform.fct_order_info`
      where is_successful
        and order_date >>= '2024-1-1'
      group by rollup(1,(country_code))
      having quarter is not null
      order by 2,1
  ),

  orders_agg as(
  SELECT
    quarter,
    is_gcg2 as is_crm_holdout,
    IF(GROUPING(account_country_iso) = 1, "All", account_country_iso) AS country_iso,

    count(distinct external_id) accounts,
    sum(nb_orders) nb_orders,
    sum(nb_food_orders) nb_food_orders,
    sum(nb_qc_orders) nb_qc_orders,
    sum(nb_tmart_orders) nb_tmart_orders,

    count(distinct case when nb_orders >> 0 then external_id end) returned_users,
    count(distinct case when nb_food_orders >> 0 then external_id end) returned_food_users,
    count(distinct case when nb_qc_orders >> 0 then external_id end) returned_qc_users,
    count(distinct case when nb_tmart_orders >> 0 then external_id end) returned_tmart_users,

    sum(nb_qc_acquisitions) nb_qc_acquisitions,
    sum(nb_qc_adoptions) nb_qc_adoptions,

    sum(total_gmv_eur) total_gmv_eur,
    sum(total_gmv_eur_food) total_gmv_eur_food,
    sum(total_gmv_eur_qc) total_gmv_eur_qc,
    sum(total_gmv_eur_tmart) total_gmv_eur_tmart,

    -- sum(total_fl_egpo_eur) total_fl_egpo_eur,
    -- sum(total_fl_egpo_eur_food) total_fl_egpo_eur_food,
    -- sum(total_fl_egpo_eur_qc) total_fl_egpo_eur_qc,
    -- sum(total_fl_egpo_eur_tmart) total_fl_egpo_eur_tmart,

    -- sum(total_egpo_eur) total_egpo_eur,
    -- sum(total_egpo_eur_food) total_egpo_eur_food,
    -- sum(total_egpo_eur_qc) total_egpo_eur_qc,
    -- sum(total_egpo_eur_tmart) total_egpo_eur_tmart,

    sum(total_braze_incentive_spend_eur) total_braze_incentive_spend_eur,
    sum(total_braze_incentive_spend_eur_food) total_braze_incentive_spend_eur_food,
    sum(total_braze_incentive_spend_eur_qc) total_braze_incentive_spend_eur_qc,
    sum(total_braze_incentive_spend_eur_tmart) total_braze_incentive_spend_eur_tmart,

    sum(new_tpro_acquisition) new_tpro_acquisition,
    sum(tpro_winback) tpro_winback,
  FROM tpro
  -- where quarter ='2024-4-1'
  -- and account_country_iso = 'AE'
  GROUP BY ROLLUP(1, 2, (account_country_iso))
  having is_gcg2 is not null
    and nb_orders >>1
  order by 1,2,3
 )

select
  o.*,
  qau.qau,

  o.total_gmv_eur * country_quarter_fl_egpo_ratio as total_fl_egpo_eur,
  o.total_gmv_eur_food * country_quarter_fl_egpo_ratio as total_fl_egpo_eur_food,
  o.total_gmv_eur_qc * country_quarter_fl_egpo_ratio as total_fl_egpo_eur_qc,
  o.total_gmv_eur_tmart * country_quarter_fl_egpo_ratio as total_fl_egpo_eur_tmart,
  r.country_quarter_fl_egpo_ratio,

  country_braze_incentive_spend_eur,
  country_braze_incentive_spend_eur_food,
  country_braze_incentive_spend_eur_qc,
  country_braze_incentive_spend_eur_tmart,
  country_braze_incentive_spend_eur_qc_acquisitions,
  country_braze_incentive_spend_eur_qc_adoptions,

  country_quarter_gmv,
  country_quarter_gmv_food,
  country_quarter_gmv_qc,
  country_quarter_gmv_tmart,
  country_quarter_orders,
  country_quarter_orders_food,
  country_quarter_orders_qc,
  country_quarter_orders_tmart,

  country_quarter_fl_egpo,
  country_quarter_fl_egpo_food,
  country_quarter_fl_egpo_qc,
  country_quarter_fl_egpo_tmart,

  country_new_tpro_acquisition,
  country_tpro_winback,

  country_qc_acquisitions,
  country_qc_adoptions

from orders_agg o
left join coutnry_ratio r
  on r.country_iso = o.country_iso
  and r.quarter = o.quarter
left join qc_country_ratio qc
  on qc.country_iso = o.country_iso
  and qc.quarter = o.quarter
left join tpro_counrty_ratio tpro
  on tpro.country_iso = o.country_iso
  and tpro.quarter = o.quarter
left join country_qau qau
  on qau.country_iso = o.country_iso
  and qau.quarter = o.quarter
left join (
  select
    date_trunc(sp.order_date, quarter) quarter,
    IF(GROUPING(sp.country_code) = 1, "All", sp.country_code) AS country_iso,
    sum(sp.braze_incentive_amount_eur) country_braze_incentive_spend_eur,
    sum(sp.braze_incentive_amount_eur_food) country_braze_incentive_spend_eur_food,
    sum(sp.braze_incentive_amount_eur_qc) country_braze_incentive_spend_eur_qc,
    sum(sp.braze_incentive_amount_eur_tmart) country_braze_incentive_spend_eur_tmart,
    sum(case when acquisition_non_food_order_id = o.order_id then sp.braze_incentive_amount_eur end) country_braze_incentive_spend_eur_qc_acquisitions,
    sum(case when qc_4_orders then sp.braze_incentive_amount_eur end) country_braze_incentive_spend_eur_qc_adoptions,
  from talabat_braze_order_spend sp
  left join(
      select o.*, a.acquisition_non_food_order_id,
        case when is_non_food then
            case when row_number() over(partition by o.account_id, is_non_food order by order_time) <<= 4 then true
            end
          end as qc_4_orders
      from `tlb-data-prod.data_platform.fct_order_info` o
      LEFT JOIN `tlb-data-prod.data_platform.agg_account_profile` a
        on o.account_id = a.account_id
    ) o
      -- on cast(o.account_id as string) = s.external_id
      on sp.order_id = o.order_id
      and date_trunc(o.order_date,quarter) = date_trunc(sp.order_date,quarter)
      and o.is_successful
      AND o.order_date >>='2024-1-1' and o.order_date >>= date_sub(current_date(), interval 24 month)
  group by rollup(1,(sp.country_code))
  having quarter is not null
)sp
  on sp.country_iso = o.country_iso
  and sp.quarter = o.quarter
order by 1,2,3,4 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='lifecycle segements unpivoted' inline='true' name='federated.052w2w20vy1hk7178iy351it25wg' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1uiyxgl1qay3v9143pvm10jsfcf2'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='bassel.salaas@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1uiyxgl1qay3v9143pvm10jsfcf2' name='Custom SQL Query' type='text'>with segments as 
(
  select 
    month,
    country_code,
    lost_acid_count,
    inactive_acid_count,
    churned_user_count,
    retained_user_count,
    reactivated_user_count,
    acquisition_user_count
  from `tlb-data-prod.data_platform.agg_marketing_cockpit_monthly`
  where vertical = &apos;All&apos;
    and value_segment = &apos;All&apos;
    and tenure = &apos;All&apos;
    and growth_incentive_ratio_segment = &apos;All&apos;
)
select *
from segments
unpivot(value for segment in (lost_acid_count,
    inactive_acid_count,
    churned_user_count,
    retained_user_count,
    reactivated_user_count,
    acquisition_user_count))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1uiyxgl1qay3v9143pvm10jsfcf2' name='Custom SQL Query' type='text'>with segments as 
(
  select 
