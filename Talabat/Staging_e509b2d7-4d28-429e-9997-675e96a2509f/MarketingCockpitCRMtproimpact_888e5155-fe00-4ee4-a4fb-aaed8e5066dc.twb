    <worksheet name='HO - table'>
      <table>
        <view>
          <datasources>
            <datasource caption='incentives and carc' name='federated.0n5lpiy0b85wlh0zwyk771p7dagd' />
            <datasource caption='Cockpit table' name='federated.16iev0b0tdq0wk151d93c1lpog3s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16iev0b0tdq0wk151d93c1lpog3s].[Calculation_2052093385973592065]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16iev0b0tdq0wk151d93c1lpog3s].[month]' caption='Select month' datatype='date' default-format='*mmm-yy' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column caption='CARC or incentives' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;CARC&quot;'>
              <calculation class='tableau' formula='&quot;CARC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n5lpiy0b85wlh0zwyk771p7dagd'>
            <column caption='Selected month ' datatype='string' name='[Calculation_3414080426003329036]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_5127488944008122385]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Calculation_5127488944008122385]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2]))&#10;then &apos;Previous Month&apos;&#10;end' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_5127488942887604224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel (group)]+IFNULL([sub_channel],&apos;na&apos;)' />
            </column>
            <column caption='Dynamic metric' datatype='real' name='[Calculation_5127488942896320517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;CARC&apos; THEN [carc] &#10;else [incenitve] end' />
            </column>
            <column caption='Channel ' datatype='string' name='[Calculation_5127488943975198730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [sub_channel] = &apos;BRAZE&apos; then &apos;CRM (Reach / RMA)&apos; else [channel] end' />
            </column>
            <column caption='monthyear' datatype='date' default-format='*MMMM yyyy' name='[Calculation_5127488944008122385]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATETRUNC(&apos;month&apos;,[month]))' />
            </column>
            <column datatype='real' name='[carc]' role='measure' type='quantitative' />
            <column caption='Channel' datatype='string' name='[channel (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_5127488943975198730]' new-bin='true'>
                <bin default-name='false' value='&quot;CRM Vouchers&quot;'>
                  <value>&quot;CRM (Reach / RMA)&quot;</value>
                  <value>&quot;CRM RMO - Vouchers&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delivery Incentives&quot;'>
                  <value>&quot;Delivery Incentives - Acquisition&quot;</value>
                  <value>&quot;Delivery Incentives - Retention&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Discounts&quot;'>
                  <value>&quot;DH funded Discounts - Acquisition&quot;</value>
                  <value>&quot;DH funded Discounts - Retention&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Subscription Incentives&quot;'>
                  <value>&quot;Subscription Specific Incentives&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Vouchers&quot;'>
                  <value>&quot;Refer a friend&quot;</value>
                  <value>&quot;Vouchers Generic Acquistion&quot;</value>
                  <value>&quot;Vouchers Generic Retention&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='channel (old)' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[incenitve]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_incentivized]' role='dimension' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3414080426003329036]' derivation='None' name='[none:Calculation_3414080426003329036:nk]' pivot='key' type='nominal' />
