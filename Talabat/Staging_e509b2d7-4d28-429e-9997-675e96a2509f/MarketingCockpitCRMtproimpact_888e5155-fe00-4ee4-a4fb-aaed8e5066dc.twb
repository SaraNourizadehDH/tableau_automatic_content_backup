              <calculation class='tableau' formula='if [country_iso] != &apos;IQ&apos; and [Parameters].[Parameter 8] = &apos;Platform&apos; then&#10;{ FIXED [quarter],[country_iso]: &#10;((sum(if not[is_crm_holdout] then [tpro_winback] end)/ sum(if not[is_crm_holdout] then [accounts]end))&#10;/&#10;(sum(if [is_crm_holdout] then [tpro_winback] end) / sum(if [is_crm_holdout] then [accounts]end)))&#10;&#10;}-1&#10;end' />
