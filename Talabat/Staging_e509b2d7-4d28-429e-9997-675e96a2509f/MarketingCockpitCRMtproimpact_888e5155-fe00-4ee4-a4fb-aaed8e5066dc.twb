              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_5127488944008122385]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Calculation_5127488944008122385]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2]))&#10;then &apos;Previous Month&apos;&#10;end' />
