              <calculation class='tableau' formula='if [country_iso] != &apos;IQ&apos; then&#10;({ FIXED [quarter],[country_iso]: &#10;if [Parameters].[Parameter 8] = &apos;Platform&apos; then &#10;((sum(if not[is_crm_holdout] then [new_tpro_acquisition] end)/ sum(if not[is_crm_holdout] then [accounts]end))&#10;/&#10;(sum(if [is_crm_holdout] then [new_tpro_acquisition] end) / sum(if [is_crm_holdout] then [accounts]end)))&#10;&#10;end}-1) * ([country_new_tpro_acquisition])&#10;end' />
