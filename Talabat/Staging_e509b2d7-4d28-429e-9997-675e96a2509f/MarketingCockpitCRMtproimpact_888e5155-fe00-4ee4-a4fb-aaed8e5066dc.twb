  <worksheets>
    <worksheet name='CRM Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt; on</run>
            <run fontcolor='#e28e43'>Æ </run>
            <run bold='true' fontcolor='#e28e43'>&lt;[Parameters].[Parameter 8]&gt; </run>
            <run bold='true'>- </run>
            <run bold='true' fontcolor='#e28e43'><![CDATA[<[CRM impact (local copy)].[tqr:quarter:ok]>]]></run>
            <run>Æ&#10;</run>
            <run fontsize='6'>‎ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM impact ' name='CRM impact (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='CRM impact (local copy)'>
            <column caption='QAU (including gcg) ' datatype='integer' name='[AVG MAU (axcluding gcg) (copy)_4760093767809798151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [quarter],[country_iso]: &#10;&#10;sum(if [is_crm_holdout] then [qau] end) &#10;&#10;}' />
            </column>
            <column caption='if[ROI (eGP)] &lt;0 or SUM([dynamic incremental metric])&lt;0 then ...' datatype='real' name='[Calculation_1405967540037316617]' role='measure' type='quantitative' user:unnamed='CRM Impact'>
              <calculation class='tableau' formula='if[Calculation_725783286853132318] &lt;0 or SUM([Calculation_725783286849839132])&lt;0 then null else SUM([dynamic incremental metric (copy)_4760093767828967432])END' />
            </column>
            <column caption='if[ROI (eGP)] &lt;0 or SUM([dynamic incremental metric])&lt;0 then ...' datatype='real' name='[Calculation_1618621919701729282]' role='measure' type='quantitative' user:unnamed='CRM Impact'>
              <calculation class='tableau' formula='if[Calculation_725783286853132318] &lt;0 or SUM([Calculation_725783286849839132])&lt;0 then null else[Calculation_725783286853132318] END' />
            </column>
            <column caption='if[ROI (eGP)] &lt;0 or SUM([dynamic incremental metric]) &lt;0 then...' datatype='real' name='[Calculation_2058778363818094603]' role='measure' type='quantitative' user:unnamed='CRM Impact'>
              <calculation class='tableau' formula='if[Calculation_725783286853132318] &lt;0 or SUM([Calculation_725783286849839132]) &lt;0 then null else [Calculation_725783286849757211]END' />
            </column>
            <column caption='if[ROI (eGP)] &lt;0  or SUM([dynamic incremental metric]) &lt;0 the...' datatype='real' name='[Calculation_2058778363818229773]' role='measure' type='quantitative' user:unnamed='CRM Impact'>
              <calculation class='tableau' formula='if[Calculation_725783286853132318] &lt;0  or SUM([Calculation_725783286849839132]) &lt;0 then null else&#10;SUM([Calculation_725783286849839132])&#10;END' />
            </column>
            <column caption='quarter filter' datatype='boolean' name='[Calculation_4760093768123584525]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[quarter], TODAY()) &gt;= 60 then true else false end' />
            </column>
            <column caption='if SUM([Incremental returned users]) &lt;0 then null else SUM([I...' datatype='real' name='[Calculation_4760093768196444188]' role='measure' type='quantitative' user:unnamed='CRM Impact'>
              <calculation class='tableau' formula='if SUM([Incremental GMV (copy)_4760093768166166550]) &lt;0 then null else SUM([Incremental GMV (copy)_4760093768166166550]) END' />
            </column>
            <column caption='Incremental Orders ' datatype='real' name='[Calculation_725783286470393861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({ FIXED [quarter],[country_iso]: &#10;(sum(if not[is_crm_holdout] then [Calculation_725783286783098899] end)/ sum(if not[is_crm_holdout] then [accounts]end))&#10;/&#10;(sum(if [is_crm_holdout] then [Calculation_725783286783098899] end) / sum(if [is_crm_holdout] then [accounts]end))&#10;}-1) * ([dynamic incremental metric (copy)_1754503901664153608])' />
            </column>
            <column caption='iCP Order' datatype='real' name='[Calculation_725783286471401479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Dynamic Orders (copy)_725783286783754260])/sum([Calculation_725783286470393861])' />
            </column>
            <column caption='Dynamic Orders' datatype='integer' name='[Calculation_725783286783098899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 8] &#10;    when &quot;Platform&quot; then [nb_orders]&#10;    when &apos;Food&apos; then [nb_food_orders]&#10;    when &quot;tmart&quot; then [nb_tmart_orders]&#10;    when &quot;QC&quot; then [nb_qc_orders]&#10;end' />
            </column>
            <column caption='dynamic icp metric' datatype='real' name='[Calculation_725783286849757211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 9] = &apos;Orders&apos; then [Calculation_725783286471401479] &#10;ELSEIF  [Parameters].[Parameter 9] =  &apos;GMV&apos; then [iCP order (copy)_725783286472646666] &#10;ELSEIF [Parameters].[Parameter 9] =  &apos;eGPO&apos; then [iCP order (copy)_725783286781419537]&#10;ELSEIF [Parameters].[Parameter 9] =  &apos;QC Acquisitions&apos; then [iCP GMV (copy)_2058778363558694917] &#10;ELSEIF [Parameters].[Parameter 9] =  &apos;QC Adoptions&apos; then [iCP QC Acquisitions (copy)_2058778363558764550]&#10;ELSEIF [Parameters].[Parameter 9] =  &apos;tpro Acquisitions&apos; &#10;    and [Parameters].[Parameter 8] = &apos;Platform&apos; then  [iCP QC Acquisitions (copy)_1405967539994738692]  &#10;ELSEIF [Parameters].[Parameter 9] =  &apos;tpro Winbacks&apos; &#10;    and [Parameters].[Parameter 8] = &apos;Platform&apos;then [iCP tpro Acquisitions (copy)_1405967539994812421]&#10;end' />
            </column>
            <column caption='dynamic incremental metric' datatype='real' name='[Calculation_725783286849839132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_crm_holdout]then&#10;case [Parameters].[Parameter 9] &#10;    when &apos;Orders&apos; then [Calculation_725783286470393861]&#10;    when &apos;GMV&apos; then [Incremental orders  (copy 2)_725783286472429577]&#10;    when &apos;eGPO&apos; then [Incremental orders  (copy)_725783286781276175]&#10;    when &apos;QC Acquisitions&apos; then [Incremental GMV (copy)_2058778363555254272]&#10;    when &apos;QC Adoptions&apos; then [Incremental QC Acquistions  (copy)_2058778363555790850]&#10;    when &apos;tpro Acquisitions&apos; then [Incremental QC Acquisitions (copy)_1405967539991281664]&#10;    when &apos;tpro Winbacks&apos; then [Incremental QC Acquisitions (copy)_1405967539991478274]&#10;end end' />
            </column>
            <column caption='ROI (eGP)' datatype='real' name='[Calculation_725783286853132318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF not [Parameters].[Parameter 9] in  (&quot;QC Acquisitions&quot;,&quot;QC Adoptions&quot;,&quot;tpro Acquisitions&quot;,&apos;tpro Winbacks&apos;)  then&#10;    sum(&#10;        ({ FIXED [quarter],[country_iso]: &#10;        (sum(if not[is_crm_holdout] then [Dynamic GMV (copy)_725783286784053270] end)/ sum(if not[is_crm_holdout] then [accounts]end))&#10;        /&#10;        (sum(if [is_crm_holdout] then [Dynamic GMV (copy)_725783286784053270] end) / sum(if [is_crm_holdout] then [accounts]end))&#10;        }-1 ) * ([Dynamic country orders (copy)_1754503901663965191])&#10;    )/sum([Dynamic Orders (copy)_725783286783754260])&#10;end' />
            </column>
            <column caption='Dynamic country orders' datatype='integer' name='[Dynamic Cost (copy)_1754503901663666181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_crm_holdout] then&#10;    case [Parameters].[Parameter 8] &#10;        when &quot;Platform&quot; then [country_quarter_orders]&#10;        when &apos;Food&apos; then [country_quarter_orders_food]&#10;        when &quot;tmart&quot; then [country_quarter_orders_tmart]&#10;        when &quot;QC&quot; then [country_quarter_orders_qc]&#10;    end&#10;end' />
            </column>
            <column caption='Dynamic returned users' datatype='integer' name='[Dynamic GMV (copy)_4760093768164114453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 8] &#10;    when &quot;Platform&quot; then [returned_users]&#10;    when &apos;Food&apos; then [returned_food_users]&#10;    when &quot;tmart&quot; then [returned_tmart_users]&#10;    when &quot;QC&quot; then [returned_qc_users]&#10;end' />
            </column>
            <column caption='Dynamic egpo' datatype='real' name='[Dynamic GMV (copy)_725783286784053270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 8] &#10;    when &quot;Platform&quot; then [total_fl_egpo_eur]&#10;    when &apos;Food&apos; then [total_fl_egpo_eur_food]&#10;    when &quot;tmart&quot; then [total_fl_egpo_eur_tmart]&#10;    when &quot;QC&quot; then [total_fl_egpo_eur_qc]&#10;end' />
            </column>
            <column caption='Dynamic Cost' datatype='real' name='[Dynamic Orders (copy)_725783286783754260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT [is_crm_holdout] THEN&#10;    IF [Parameters].[Parameter 8] = &quot;Platform&quot; THEN [country_braze_incentive_spend_eur]&#10;    ELSEIF [Parameters].[Parameter 8] = &quot;Food&quot; THEN [country_braze_incentive_spend_eur_food]&#10;    ELSEIF [Parameters].[Parameter 8] = &quot;tmart&quot; THEN [country_braze_incentive_spend_eur_tmart]&#10;    ELSEIF [Parameters].[Parameter 8] = &quot;QC&quot; THEN&#10;        IF [Parameters].[Parameter 9] = &quot;QC Acquisitions&quot; THEN [country_braze_incentive_spend_eur_qc_acquisitions]&#10;        ELSEIF [Parameters].[Parameter 9] = &quot;QC Adoptions&quot; THEN [country_braze_incentive_spend_eur_qc_adoptions]&#10;        ELSE [country_braze_incentive_spend_eur_qc]&#10;        END&#10;    END&#10;END' />
            </column>
            <column caption='Dynamic GMV' datatype='real' name='[Dynamic Orders (copy)_725783286783950869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 8] &#10;    when &quot;Platform&quot; then [total_gmv_eur]&#10;    when &apos;Food&apos; then [total_gmv_eur_food]&#10;    when &quot;tmart&quot; then [total_gmv_eur_tmart]&#10;    when &quot;QC&quot; then [total_gmv_eur_qc]&#10;end' />
            </column>
            <column caption='Dynamic country gmv' datatype='real' name='[Dynamic country orders (copy)_1754503901663817734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not [is_crm_holdout] then&#10;    case [Parameters].[Parameter 8] &#10;        when &quot;Platform&quot; then [country_quarter_gmv]&#10;        when &apos;Food&apos; then [country_quarter_gmv_food]&#10;        when &quot;tmart&quot; then [country_quarter_gmv_tmart]&#10;        when &quot;QC&quot; then [country_quarter_gmv_qc]&#10;    end&#10;end' />
            </column>
            <column caption='Dynamic country egpo' datatype='real' name='[Dynamic country orders (copy)_1754503901663965191]' role='measure' type='quantitative'>
