              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = FALSE &#10;    then SUM([Calculation_3414080425945948161]) / TOTAL(SUM([Calculation_3414080425945948161]))&#10;    else SUM([Calculation_3414080425945948161]) END'>
