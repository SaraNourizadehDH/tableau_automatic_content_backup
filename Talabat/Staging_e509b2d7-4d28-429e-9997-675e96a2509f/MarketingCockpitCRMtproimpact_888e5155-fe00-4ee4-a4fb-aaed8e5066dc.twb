            </column>
            <column caption='Incremental tpro Acquisitions %' datatype='real' name='[Incremental QC Acquisitions % (copy)_1405967539991408641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country_iso] != &apos;IQ&apos; and [Parameters].[Parameter 8] = &apos;Platform&apos;then&#10;{ FIXED [quarter],[country_iso]: &#10;((sum(if not[is_crm_holdout] then [new_tpro_acquisition] end)/ sum(if not[is_crm_holdout] then [accounts]end))&#10;/&#10;(sum(if [is_crm_holdout] then [new_tpro_acquisition] end) / sum(if [is_crm_holdout] then [accounts]end)))&#10;&#10;}-1&#10;end' />
