            <remote-alias>nb_tmart_orders</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_029D8A04231D4B7BA0CFE8395B10DEC6]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>returned_users</remote-name>
            <remote-type>20</remote-type>
            <local-name>[returned_users]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>returned_users</remote-alias>
            <local-type>integer</local-type>
