      <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16iev0b0tdq0wk151d93c1lpog3s].[Calculation_2052093385973592065]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16iev0b0tdq0wk151d93c1lpog3s].[month]' caption='Select month' datatype='date' default-format='*mmm-yy' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
          <calculation class='tableau' formula='#2025-07-01#' />
        </column>
        <column caption='CARC or incentives' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;CARC&quot;'>
          <calculation class='tableau' formula='&quot;CARC&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_60972653D49A42EABEDA316C22173ED8'>
            <properties context=''>
              <relation connection='bigquery.0crp7zt17sqv2013mg8cq1ye4qan' name='Custom SQL Query' type='text'><![CDATA[WITH
  incentives AS (
        SELECT
      oi.order_id,
      oi.order_date,
      oi.is_acquisition,
       case 
          WHEN iod.is_fdnc_order THEN 'Delivery Incentives - Acquisition'
          WHEN LOWER(c.mkt_sub_channel) LIKE '%delivery%' 
            OR LOWER(c.incentive_sub_type) LIKE '%delivery%' THEN 'Delivery Incentives - Retention'
        WHEN id.incentive_campaign_id IS NOT NULL THEN 
          CASE
                WHEN iod.is_fdnc_order THEN 'Delivery Incentives - Acquisition'
                WHEN LOWER(c.mkt_sub_channel) LIKE '%delivery%' OR LOWER(c.incentive_sub_type) LIKE '%delivery%' THEN 'Delivery Incentives - Retention'
                WHEN (c.incentive_sub_type) = 'booster discount' OR id.is_tpro_exclusive THEN 'Subscription Specific Incentives'
                WHEN is_acquisition THEN 'DH funded Discounts - Acquisition'
                ELSE 'DH funded Discounts - Retention'
            END
            else CASE
                WHEN is_crma THEN 'CRM (Reach / RMA)'
                WHEN is_crmo THEN 'CRM RMO - Vouchers'
                WHEN is_loyalty OR c.mkt_sub_channel = 'TPRO' THEN 'Vouchers Generic Retention'
                WHEN is_raf THEN 'Refer a friend'
                WHEN oi.is_acquisition THEN 'Vouchers Generic Acquistion'
                when iod.incentive_sub_type in('gem','non-food item discount') then 'DH funded Discounts - Retention'
                ELSE 'Vouchers Generic Retention'
            END end AS channel,
      CASE
        WHEN id.incentive_campaign_id IS NOT NULL THEN 
        CASE
          WHEN ( LOWER(c.incentive_sub_type) LIKE ANY('%delivery%','booster discount')
            OR LOWER(c.mkt_sub_channel) LIKE '%delivery%' ) THEN COALESCE(c.incentive_sub_type, c.mkt_sub_channel)
          WHEN id.is_tpro_exclusive THEN 'tpro exlusive - ' || iod.incentive_sub_type
          WHEN REGEXP_CONTAINS(iod.campaign_name, r'(?i)super saver')
            OR id.platform_campaign_type = 'Super Saver' THEN 'Super Saver'
          WHEN UPPER(id.platform_campaign_type) = ('BEST SELLERS') THEN 'Best Seller'
          WHEN REGEXP_CONTAINS(iod.campaign_name, r'(?i)flash sale')
            OR UPPER(id.platform_campaign_type) IN ('FLASHSALE','FLASH SALE') THEN 'Flash Sale'
          WHEN id.platform_campaign_type IS NOT NULL THEN id.platform_campaign_type
          ELSE COALESCE(c.incentive_sub_type, c.mkt_sub_channel)
        END 
        ELSE 
          case 
            when iod.incentive_sub_type = 'gem' then 'gems'
            when iod.incentive_sub_type='non-food item discount' then 'non-food item discount' 
          else c.mkt_sub_channel end
      END AS sub_channel,
      SUM(iod.incentive_amount_eur) as incentive_amount_eur,
      SUM(case when LOWER(c.campaign_name) LIKE '%pickup discount%%_hf_%' then iod.incentive_amount_eur 
       WHEN c.mkt_sub_channel = 'TPRO' THEN bd.tpro_commission_eur
      else iod.vendor_incentive_cost_eur end) as vendor_incentive_cost_eur,
    FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` iod
      INNER JOIN `tlb-data-prod.data_platform.fct_order_info` oi
          on iod.order_id = oi.order_id
          and iod.order_date = oi.order_date
          and oi.is_successful
          AND NOT oi.is_test
      LEFT JOIN `tlb-data-prod.data_platform.fct_billing` bd
                ON oi.order_id = bd.order_id  
                and billing_date >>= '2023-1-01'
      INNER JOIN `tlb-data-prod.data_platform.dim_incentive_campaign` c
          USING (incentive_campaign_id)
      LEFT JOIN `tlb-data-prod.data_platform.dim_incentives_discount` id
          USING (incentive_campaign_id)
      WHERE iod.order_date >>= '2023-1-01'
        AND iod.is_successful
        AND iod.incentive_sub_type NOT IN ('non-food item discount')--,'compensation','gem')
        AND iod.incentive_amount_lc >> 0
      GROUP BY ALL
  ),

  hva_flagging AS (
      SELECT
        foi.country_code,
        foi.order_id,
        foi.analytical_customer_id,
        foi.order_date,
        foi.is_acquisition,
        i.channel,
        i.sub_channel,
        case 
          -- when i.channel= 'Delivery Incentives - Acquisition' and ifnull(carc_eur,0) + ifnull(vendor_incentive_cost_eur,0) = 0 then i.incentive_amount_eur 
          when i.sub_channel= 'COMPENSATION' then i.incentive_amount_eur
          else ifnull(carc.carc_eur,0) end as carc_eur,
        foi.gmv_amount_eur, 
        foi.basket_amount_eur, 
        i.incentive_amount_eur,
        case when i.sub_channel = 'Bank Partnership' and ifnull(carc.carc_eur,0) = 0 then i.incentive_amount_eur
             when i.sub_channel like ('%delivery%') and ifnull(carc_eur,0)+ifnull(vendor_incentive_cost_eur,0) = 0 then i.incentive_amount_eur
          else i.vendor_incentive_cost_eur end as vendor_incentive_cost_eur 
        from `tlb-data-prod.data_platform.fct_order_info` foi 
        LEFT JOIN incentives i
          ON foi.order_id = i.order_id
          AND foi.order_date = i.order_date
        LEFT JOIN `tlb-data-prod.data_platform_rest_tables.wrk_fct_incentive_order_carc` carc
          ON foi.order_id = carc.order_id
          AND DATE_TRUNC(carc.date, MONTH) >>='2023-1-1'-- and sub_channel != 'Loyalty Liability'
          AND carc.channel = i.channel
          AND carc.sub_channel = i.sub_channel
      WHERE DATE_TRUNC(foi.order_date, MONTH) >>='2023-1-1'
      -- and carc.channel is not null and hva_count >> 1
      --  and hva.order_id = 1730981435
      -- and hva.order_id = 1731012903 
      -- and hva.order_id = 1731065620
      -- order by order_id
      -- limit 999
  ),

  meta AS (
    SELECT  
      *,
      SAFE_DIVIDE(1, 
        IF( COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id) = 0, 1,
            COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id))
      ) AS order_share,

      SAFE_DIVIDE(gmv_amount_eur, 
        IF( COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id) = 0, 1,
            COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id))
      ) AS gmv_share,

      SAFE_DIVIDE(basket_amount_eur, 
        IF( COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id) = 0, 1,
            COUNT(DISTINCT CONCAT(channel, sub_channel, coalesce(carc_eur, 0))) OVER (PARTITION BY order_id))
      ) AS gbv_share,

      ROW_NUMBER() OVER(PARTITION BY order_id) AS instance,
      COUNT( CONCAT(channel, sub_channel, COALESCE(carc_eur, 0))) OVER (PARTITION BY order_id),
      -- row_number() over(pa CONCAT(channel, sub_channel, carc_eur))channels,
      IF(incentive_amount_eur >> 0, TRUE, FALSE) AS is_incentivized,
      IF(carc_eur >> 0, TRUE, FALSE) AS is_dh_incentivized,
      CASE 
        WHEN incentive_amount_eur >> 0 AND vendor_incentive_cost_eur >> 0 AND carc_eur != 0 THEN 'cofunded'
        WHEN incentive_amount_eur >> 0 AND vendor_incentive_cost_eur >> 0 THEN 'vendor funded'
        WHEN incentive_amount_eur >> 0 AND carc_eur != 0 THEN 'dh funded'
      END AS is_cofunded,
    FROM hva_flagging
  )

SELECT 
  DATE_TRUNC(order_date, MONTH) AS month,
  country_code,
  is_incentivized,
  channel,
  sub_channel,
  -- is_cofunded,
  SUM(order_share) AS orders,
  SUM(gmv_share) AS gmv,
  SUM(gbv_share) AS gbv,
  SUM(carc_eur) AS carc,
  SUM(vendor_incentive_cost_eur) AS vendor_incentive,
  SUM(incentive_amount_eur) AS incenitve,
  -- sum(incentive_amount_eur-vendor_incentive_cost_eur-carc_eur) test
FROM meta
WHERE
  DATE_TRUNC(order_date, MONTH) << date_trunc(current_date(),month) and
  ifnull(sub_channel,'na') not like "%B2B%"
GROUP BY ALL
order by 1,2,3,4,5,6,7]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Multivertical acids' inline='true' name='federated.0xx4f6z03uu5ay1fdwace05jbx3m' version='18.1'>
