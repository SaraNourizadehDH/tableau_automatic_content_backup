    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1mj38hb0iccwfu1e8qzin19qg6er' name='Custom SQL Query' type='text'><![CDATA[with calibrated_acquisitions
AS (
  SELECT
    case
      when country = 'Qatar' then 'QA'
      when country = 'Bahrain' then 'BH'
      when country = 'United Arab Emirates' then 'AE'
      when country = 'Egypt' then 'EG'
      when country = 'Oman' then 'OM'
      when country = 'Jordan' then 'JO'
      when country = 'Iraq' then 'IQ'
      when country = 'Kuwait' then 'KW'
    end as country_code,
    date_trunc(date, day) as day,
    case
      when sub_channel = 'BRA' then 'Online Branding'
      when channel = 'APP' and sub_channel in ('REACH', 'RMA') then 'App (Reach / RMA)'
      when channel = 'DISPLAY' and sub_channel in ('REACH', 'RMA') then 'Display (Reach / RMA)'
      when channel = 'PAIDSOCIAL' and sub_channel in ('REACH', 'RMA') then 'Paid Social (Reach / RMA)'
      when channel = 'BRAND' and sub_channel = 'SEM' then 'SEM Brand'
      when channel = 'SEM' then 'SEM non-Brand'
      else channel
    end as channel,
    case
      when sub_channel = 'BRA' then 'Brand'
      when sub_channel = 'REACH' then 'Reach'
      when sub_channel = 'RMA' then 'RMA'
      when sub_channel = 'RMO' then 'RMO'
      when sub_channel = 'SEM' then 'Brand'
      else initcap(lower(sub_channel))
    end as sub_channel,
    round(SUM(acquisitions_calibration_ios14fix), 2) as acquisitions_calibration_ios14fix_count,
    sum(costs_eur) as cost_eur
  FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed`
  WHERE date >>= "2024-01-01"
  AND   management_entity = 'Talabat'
  AND   ( (channel in('APP','DISPLAY','PAIDSOCIAL') AND sub_channel !='RMO') OR (channel = 'SEM') OR (channel = 'BRAND' AND sub_channel = 'SEM') )
  -- AND platform = 'ios'
  GROUP BY all
),
acquisitions_and_cost
as 
(
  select  
    date_trunc(day,month) as month,
    case when channel = 'App (Reach / RMA)' then 'App - Reach / RMA'
      when channel = 'Display (Reach / RMA)' then 'Display - Reach / RMA' 
      when channel = 'Paid Social (Reach / RMA)' then 'Paid Social - Reach / RMA' 
      when channel = 'SEM Brand' then 'SEM - Brand'
      when channel = 'SEM non-Brand' then 'SEM - Non-Brand'
    end as channel,
    IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
    sum(acquisitions_calibration_ios14fix_count) as acquisitions_calibration_ios14fix_count,
    sum(cost_eur) as cost_eur
  from calibrated_acquisitions
  where day >>= "2024-01-01"
    and channel not in ('Online Branding','Programmatic','Paid Social - Riders','Social Engagement (SoMe)')
  GROUP BY ROLLUP(1, 2, (country_code))
),
metrics 
as (
    select
      dci.country_code,
      dc.talabat_channel_name as channel,
      acquisition_order_date as acquisition_date,
      foi.analytical_customer_id,
      date_diff(foi.order_date, acp.acquisition_order_date, MONTH) as month_number,
      ifnull(last_lifetime_gmv_13_weeks_eur,0) as last_lifetime_gmv_13_weeks_eur,
      count(distinct foi.order_id) as total_actual_orders,
      sum(foi.gmv_amount_eur) as total_actual_gmv,
      sum(case when is_finance_closed_month then act_egpo_eur else est_egpo_eur  end) as total_actual_egpo,
      sum(platform_incentive_cost_eur) as platform_incentive_cost_eur,
      count(distinct foi.order_id) order_count
    from `tlb-data-prod.data_platform.agg_customer_profile` acp 
    JOIN `tlb-data-prod.data_platform.dim_country_info` dci on acp.country_id = dci.country_id
    JOIN `tlb-data-prod.data_platform.dim_campaign` dc ON dc.campaign_id = acp.acquisition_campaign_id
    JOIN `tlb-data-prod.data_platform.fct_order_info` foi on foi.analytical_customer_id = acp.analytical_customer_id
    JOIN `tlb-data-prod.data_platform.dim_platform` dp on foi.platform_id = dp.platform_id
    JOIN `tlb-data-prod.data_platform.fct_order_egpo` foe on foe.order_id = foi.order_id 
    LEFT JOIN 
    (select order_id, country_code,sum(platform_incentive_cost_eur) as platform_incentive_cost_eur
      from `tlb-data-prod.data_platform.fct_incentive_order_detail`
      where is_successful
      group by all
    ) fiod on foi.order_id = fiod.order_id
    WHERE dc.talabat_channel_type = 'Paid'
      AND acp.acquisition_order_date >>= "2024-01-01"
      AND foi.is_successful
      AND foi.order_date >>= acquisition_order_date AND foe.order_date >>= acquisition_order_date
      AND foi.order_date << date_add(date_trunc(acquisition_order_date, DAY), INTERVAL 180 DAY)
      -- AND dp.device_group ='iOS'
    group by all
    order by 1,2
  )
  ,
agg_metrics
as(
    select
      country_code,
      channel,
      acquisition_date,
      month_number,
      count(distinct analytical_customer_id) as customers,
      sum(total_actual_orders) as total_actual_orders,
      sum(total_actual_gmv) as total_actual_gmv,
      sum(total_actual_egpo) as total_actual_egpo,
      sum(platform_incentive_cost_eur) as platform_incentive_cost_eur,
      sum(order_count) order_count,
      sum(case when date_diff(current_date-1,acquisition_date,DAY) >>= 180 then total_actual_gmv
            when date_diff(current_date-1,acquisition_date,DAY) >>= 90 then (total_actual_gmv + (safe_divide(last_lifetime_gmv_13_weeks_eur,90) * (180-date_diff(current_date-1,acquisition_date,DAY))))
            else  (total_actual_gmv + last_lifetime_gmv_13_weeks_eur + (safe_divide(last_lifetime_gmv_13_weeks_eur,90) * (90-date_diff(current_date-1,acquisition_date,DAY))))
          end) as total_actual_predicted_gmv_6months
    from metrics
    group by all
    order by 1,2,3
),

final_agg
as(
    select
      date_trunc(am.acquisition_date,MONTH) as month,
      channel,
      IF(GROUPING(country_code) = 1, "All", country_code) AS country_iso,
      sum(case when month_number = 0 then customers else null end) as acquisitions,
      sum(total_actual_egpo) as total_actual_egpo,
      sum(total_actual_gmv) as total_actual_gmv,
      sum(platform_incentive_cost_eur) as platform_incentive_cost_eur,
      sum(order_count) as order_count,
    from agg_metrics am
    GROUP BY ROLLUP(1, 2,(country_code))
    having channel is not null
    order by 1,2,3,4
  )

select
  am.country_iso,
  am.channel,
  am.month,
  cost_eur,  
  acquisitions_calibration_ios14fix_count,
  acquisitions,
  total_actual_egpo - platform_incentive_cost_eur as adj_fl_gpo,
  total_actual_egpo - platform_incentive_cost_eur - cost_eur as final_adj_fl_gpo,
  -- ROI = (flgpo - cost)/cost
  total_actual_gmv,
  order_count,  
from final_agg am
join acquisitions_and_cost ac 
  on am.country_iso = ac.country_iso
  and am.channel = ac.channel
  and am.month = ac.month
order by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
