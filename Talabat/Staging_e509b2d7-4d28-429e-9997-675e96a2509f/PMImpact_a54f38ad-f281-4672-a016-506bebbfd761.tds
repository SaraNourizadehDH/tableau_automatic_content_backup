  <datasource-dependencies datasource='Parameters'>
    <column caption='Select Metric (impact tab)' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
      <calculation class='tableau' formula='&quot;Orders&quot;' />
      <members>
        <member value='&quot;Orders&quot;' />
