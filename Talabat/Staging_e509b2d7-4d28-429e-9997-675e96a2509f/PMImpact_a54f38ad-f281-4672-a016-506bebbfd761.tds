  <aliases enabled='yes' />
  <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
    <aliases>
      <alias key='&quot;[PM Impact].[sum:adj_fl_gpo:qk]&quot;' value='adj_fl_gpo (before - cost)' />
      <alias key='&quot;[PM Impact].[sum:dynamic icp (copy)_725783286835470362:qk]&quot;' value='Incremental Metric*' />
      <alias key='&quot;[PM Impact].[sum:final_adj_fl_gpo:qk]&quot;' value='Fnal adj_egpo' />
      <alias key='&quot;[PM Impact].[usr:Calculation_3122613080800051202:qk]&quot;' value='iCP Order' />
      <alias key='&quot;[PM Impact].[usr:Calculation_725783286835191833:qk]&quot;' value='iCP Metric*' />
    </aliases>
  </column>
  <column caption='iCP Orders' datatype='real' name='[Calculation_3122613080800051202]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([cost_eur])/sum([order_count])' />
  </column>
  <column caption='ROI (eGP)' datatype='real' name='[Calculation_725783286813573144]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([final_adj_fl_gpo])/sum([cost_eur])' />
  </column>
  <column caption='dynamic icp' datatype='real' name='[Calculation_725783286835191833]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='case [Parameters].[Parameter 9] &#10;    when &apos;Orders&apos; then [Calculation_3122613080800051202]&#10;    when &apos;GMV&apos; then [Orders ROI (copy)_3122613080800878597]&#10;    when &apos;eGPO&apos; then [Orders ROI (copy)_3122613080801533958]&#10;end' />
  </column>
  <column caption='iCP GMV' datatype='real' name='[Orders ROI (copy)_3122613080800878597]' role='measure' type='quantitative'>
