            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1pxgzcw1avtxlw1apru4w0bj3aph'>
            <column caption='if SUM([Customer Count]) &lt;600 then null else SUM([Customer Co...' datatype='integer' name='[Calculation_2732488741868564487]' role='measure' type='quantitative' user:unnamed='Sheet 2'>
              <calculation class='tableau' formula='if SUM([customer_count]) &lt;600 then null else SUM([customer_count]) end' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='Area Name' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column-instance column='[area_name]' derivation='Attribute' name='[attr:area_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[location_id]' derivation='Attribute' name='[attr:location_id:qk]' pivot='key' type='quantitative' />
