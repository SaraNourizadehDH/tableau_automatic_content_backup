          <relation connection='bigquery.1fcdstx1oo82km1fuk18v1grkehs' name='Custom SQL Query' type='text'>with customer_value AS (
  SELECT
  distinct 
      dci.analytical_customer_id,
      -- DATE_TRUNC(DATE(bcvs.snapshot_date), MONTH) AS segmentation_date,
      -- DATE(bcvs.snapshot_date) AS segmentation_date,
      bcvs.ds_value_segment AS value_segment,
      (snapshot_date) as segmentation_date,
  FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_customer_value_segmentation` bcvs
      LEFT JOIN `tlb-data-prod.data_platform.dim_customer_info` dci
          ON bcvs.analytical_customer_id = dci.dh_analytical_customer_id
  WHERE DATE(bcvs.snapshot_date)&gt;&gt;=&apos;2025-6-30&apos;
    -- and ds_value_segment = &apos;1_HVC&apos;
  -- group by all
),

abu_dhabi as (
  select 
    distinct 
    oi.account_id,
    oi.analytical_customer_id,
    order_time_utc,
    city_name,
    delivery_location_id,
    case 
      when acquisition_non_food_order_date is null then &apos;never QC&apos;
      when date_diff(current_date(), last_non_food_order_date, day) &gt;&gt;= 31 then &apos;QC churn&apos;
      else &apos;QC active&apos; end as qc_flag,

    case 
      when date_diff(current_date(), last_order_date, day) &gt;&gt;= 31 then &apos;inactive&apos;
      else &apos;active&apos; end as status,
    
    -- if(acquisition_non_food_order_date is null,&apos;never QC&apos;, &apos;QC churn&apos;) as qc_flag,
    -- if(last_order_date &gt;&gt;= &apos;2025-5-1&apos;,&apos;active&apos;,&apos;inactive&apos;) as status,
    case
      when date_diff(current_date(),acquisition_order_date,month) between 3 and 6 then &apos;3-6&apos;
      when date_diff(current_date(),acquisition_order_date,month) between 7 and 12 then &apos;7-12&apos;
      when date_diff(current_date(),acquisition_order_date,month) between 12 and 18 then &apos;13-18&apos;
      when date_diff(current_date(),acquisition_order_date,month) &gt;&gt;=18 then &apos;18+&apos;
      end as tenure,
    row_number() over (partition by oi.analytical_customer_id order by order_time desc) as rn
  FROM  `tlb-data-prod.data_platform.fct_order_info` oi
  inner join `tlb-data-prod.data_platform.dim_location` d
    on d.city_name in (&apos;Abu Dhabi&apos;,&apos;al ain&apos;,&apos;Al Ain&apos;)
    and delivery_location_id = location_id
  inner join `tlb-data-prod.data_platform.agg_customer_profile` a
    on oi.analytical_customer_id = a.analytical_customer_id
  where order_date between &apos;2025-1-1&apos;and&apos;2025-6-30&apos;
    and is_successful
    and country_code = &apos;AE&apos;
    and date_diff(order_date, acquisition_order_date, day) &gt;&gt;= 91
    -- and (a.acquisition_non_food_order_date is null or date_diff(current_date(), last_non_food_order_date, day) &gt;&gt;= 31)
    qualify row_number() over (partition by oi.analytical_customer_id order by order_time_utc desc) =1
),

tpro as(
  select 
    abu_dhabi.* ,
    max(is_acquired) as tpro_is_acquired
  from abu_dhabi
    LEFT JOIN `tlb-data-prod.data_platform.fct_subscription_cohort_daily` tpro
        ON abu_dhabi.account_id = tpro.account_id
            AND tpro.date &gt;&gt;= &apos;2025-5-1&apos;
  group by all
)


select 
  city_name,
  cast(delivery_location_id as string) as delivery_location_id ,
  status,
  qc_flag,
  tenure,
  value_segment,
  case 
    when tpro_is_acquired is null then &apos;Not subed&apos; 
    when tpro_is_acquired = true then &apos;Recently subbed&apos; 
    when tpro_is_acquired = false then &apos;Already subbed&apos; 
    end as tpro,
  count(distinct analytical_customer_id) customer_count,
  count(distinct account_id) account_count,
from tpro
join customer_value
  using(analytical_customer_id)
group by all
order by 1,2,3,4,5,6
-- order by 1,2</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
