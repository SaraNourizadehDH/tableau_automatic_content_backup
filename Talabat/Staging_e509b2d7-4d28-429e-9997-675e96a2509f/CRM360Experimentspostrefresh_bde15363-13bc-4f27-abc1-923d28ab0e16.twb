          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='- Numerator ' datatype='integer' default-format='n#,##0;-#,##0' name='[% Rate (copy)_4827295862850359301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;    WHEN &apos;Delivery %&apos; THEN [delivery_count]&#10;    WHEN &apos;Open %&apos; THEN [open_count]&#10;    WHEN &apos;Click-through %&apos; THEN [click_count]&#10;    WHEN &apos;Spam %&apos; THEN [spam_count]&#10;    WHEN &apos;Unsubscribe %&apos; THEN [unsubscribe_count]&#10;END' />
            </column>
            <column caption='- Denominator text' datatype='string' default-format='p0.0%' name='[- Denominator (copy)_4827295863041101832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Sends&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Direct Opens&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;Deliveries&apos;&#10;    END&#10;)&#10;WHEN &apos;in-app message&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Impressions&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;N/A&apos;&#10;    END&#10;)&#10;WHEN &apos;push notification&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Sends&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Direct Opens&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;Deliveries&apos;&#10;    END&#10;)&#10;END' />
            </column>
            <column caption='- Numerator  text' datatype='string' default-format='p0.0%' name='[- Numerator  (copy)_4827295863041527817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Direct Opens&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Clicks&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;Spam&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;Unsubscribe&apos;&#10;    END&#10;)&#10;WHEN &apos;in-app message&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Clicks&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;N/A&apos;&#10;    END&#10;)&#10;WHEN &apos;push notification&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Deliveries&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Direct Opens&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;N/A&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;Spam&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;Unsubscribe&apos;&#10;    END&#10;)&#10;END' />
            </column>
            <column caption='- Rate % text' datatype='string' default-format='p0.0%' name='[- Numerator  text (copy)_4827295863058489356]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Delivered&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Opened&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Clicked&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;Marked as Spam&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;Unsubscribed&apos;&#10;    END&#10;)&#10;WHEN &apos;in-app message&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;select email or push notifications for Delivery %&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;select email or push notifications for Direct Open %&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;Clicked&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;select email for Marked as Spam %&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;select email for Unsubscribe %&apos;&#10;    END&#10;)&#10;WHEN &apos;push notification&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN &apos;Delivered&apos;&#10;        WHEN &apos;Open %&apos; THEN &apos;Opened&apos;&#10;        WHEN &apos;Click-through %&apos; THEN &apos;select email or in-app messages for Click-through %&apos;&#10;        WHEN &apos;Spam %&apos; THEN &apos;* pending data for push notifications&#10;select email for Marked as Spam %&apos;&#10;        WHEN &apos;Unsubscribe %&apos; THEN &apos;* pending data for push notifications&#10;select email for Marked as Spam %&apos;&#10;    END&#10;)&#10;END' />
            </column>
            <column caption='Denominator filter' datatype='boolean' name='[Calculation_1397875117417533445]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Numerator  (copy)_4827295862850891782] &gt; [Parameters].[Top / Bottom N (copy)_1397875117417234436]' />
            </column>
            <column caption='Adhoc' datatype='boolean' name='[Calculation_1397875117666959370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='- % Rate' datatype='real' default-format='p0.0%' name='[Calculation_4827295862849249284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([channel]) WHEN &apos;email&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN [Calculation_6192308755631566877]&#10;        WHEN &apos;Open %&apos; THEN [Calculation_6724507572359106588]&#10;        WHEN &apos;Click-through %&apos; THEN [Calculation_6724507572360736797]&#10;        WHEN &apos;Spam %&apos; THEN [Unsubscribe % Rate (copy)_1301892146118864898]&#10;        WHEN &apos;Unsubscribe %&apos; THEN [Open % Rate (copy)_1301892146112110593]&#10;    END&#10;)&#10;WHEN &apos;in-app message&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Delivery %&apos; THEN NULL&#10;        WHEN &apos;Open %&apos; THEN NULL&#10;        WHEN &apos;Click-through %&apos; THEN [Calculation_6724507572360736797]&#10;        WHEN &apos;Spam %&apos; THEN NULL&#10;        WHEN &apos;Unsubscribe %&apos; THEN NULL&#10;    END&#10;)&#10;WHEN &apos;push notification&apos; THEN&#10;(&#10;    CASE [Parameters].[Parameter 10]&#10;           WHEN &apos;Delivery %&apos; THEN [Calculation_6192308755631566877]&#10;        WHEN &apos;Open %&apos; THEN [Calculation_6724507572359106588]&#10;        WHEN &apos;Click-through %&apos; THEN NULL&#10;        WHEN &apos;Spam %&apos; THEN NULL&#10;        WHEN &apos;Unsubscribe %&apos; THEN NULL&#10;    END&#10;)&#10;END' />
            </column>
            <column caption='Country filter' datatype='boolean' name='[Calculation_5100608067634057224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 9]=[country] OR [Parameters].[Parameter 9]= &apos;All&apos;' />
            </column>
            <column caption='Current Period' datatype='boolean' name='[Calculation_6192308755551604738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336]' />
            </column>
            <column caption='Delivery %' datatype='real' default-format='p0.0%' name='[Calculation_6192308755631566877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_count])/SUM([sends_count])' />
            </column>
            <column caption='Primary Topic' datatype='string' name='[Calculation_6192308759118082084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_topics], &apos;tPro&apos;) THEN &apos;tPro&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;tMart&apos;) THEN &apos;tMart&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;tRewards&apos;) OR CONTAINS([campaign_topics], &apos;tDine&apos;) THEN &apos;tRewards&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Pickup&apos;) THEN &apos;Pickup&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Welco&apos;) THEN &apos;Welcome&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Prospects&apos;) THEN &apos;Prospects&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Reactivation&apos;) THEN &apos;Reactivation&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Churn&apos;) THEN &apos;Churn&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Charity&apos;) OR CONTAINS([campaign_topics], &apos;Communication&apos;) OR CONTAINS([campaign_topics], &apos;Survey&apos;) THEN &apos;Comms&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Vendor&apos;) OR CONTAINS([campaign_topics], &apos;Promotion&apos;) OR CONTAINS([campaign_topics], &apos;Recommendation&apos;) OR CONTAINS([campaign_topics], &apos;ARO&apos;) THEN &apos;Vendor/Promos&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Segmentation' datatype='string' name='[Calculation_619807913994924032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4827295862849249284] &gt; WINDOW_MEDIAN(AVG([Denominator Median (copy)_619807914006466566])) AND SUM([Numerator  (copy)_4827295862850891782]) &lt; WINDOW_MEDIAN(SUM([Calculation_619807913998753795])) THEN &apos;High &apos;+STR([Parameters].[Parameter 10]) +&apos; &amp; Low &apos;+STR(MAX([- Denominator (copy)_4827295863041101832]))&#10;&#10;ELSEIF [Calculation_4827295862849249284] &gt; WINDOW_MEDIAN(AVG([Denominator Median (copy)_619807914006466566]))  AND SUM([Numerator  (copy)_4827295862850891782]) &gt; WINDOW_MEDIAN(SUM([Calculation_619807913998753795])) THEN &apos;High &apos;+STR([Parameters].[Parameter 10]) +&apos; &amp; High &apos;+STR(MAX([- Denominator (copy)_4827295863041101832]))&#10;&#10;ELSEIF [Calculation_4827295862849249284] &lt; WINDOW_MEDIAN(AVG([Denominator Median (copy)_619807914006466566]))  AND SUM([Numerator  (copy)_4827295862850891782]) &gt; WINDOW_MEDIAN(SUM([Calculation_619807913998753795])) THEN &apos;Low &apos;+STR([Parameters].[Parameter 10]) +&apos; &amp; High &apos;+STR(MAX([- Denominator (copy)_4827295863041101832]))&#10;&#10;ELSE &apos;Low &apos;+STR([Parameters].[Parameter 10]) +&apos; &amp; Low &apos;+STR(MAX([- Denominator (copy)_4827295863041101832]))&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Attribute' caption='Denominator Median' datatype='integer' name='[Calculation_619807913998753795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [Calculation_6192308759118082084]: SUM([Numerator  (copy)_4827295862850891782])}' />
            </column>
            <column caption='Direct Open %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572359106588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_count])/SUM([delivery_count])' />
            </column>
            <column caption='Click-through %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572360736797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_count])/&#10;(&#10;    IF ATTR([channel])= &apos;email&apos; THEN SUM([open_count])&#10;    ELSEIF ATTR([channel])= &apos;in-app message&apos; THEN SUM([impression_count])&#10;    ELSE NULL END&#10;)' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_6836182773286486024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(MAX([entry_date]))}' />
            </column>
            <column caption='Last 30d start date' datatype='date' name='[Calculation_6836182773286662153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;,-30,MAX([entry_date])))}' />
            </column>
            <column caption='Channel (not all)' datatype='string' name='[Channel (email, push) (copy)_6192308755619590172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column aggregation='Attribute' caption='% Rate Median ' datatype='real' name='[Denominator Median (copy)_619807914006466566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [Calculation_6192308759118082084]: sum([% Rate (copy)_4827295862850359301])/sum([Numerator  (copy)_4827295862850891782])}' />
            </column>
            <column caption='- Denominator' datatype='integer' default-format='n#,##0;-#,##0' name='[Numerator  (copy)_4827295862850891782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;    WHEN &apos;Delivery %&apos; THEN [sends_count]&#10;    WHEN &apos;Open %&apos; THEN [delivery_count]&#10;    WHEN &apos;Click-through %&apos; THEN [open_count]+[impression_count]&#10;    WHEN &apos;Spam %&apos; THEN [delivery_count]&#10;    WHEN &apos;Unsubscribe %&apos; THEN [delivery_count]&#10;END' />
            </column>
            <column caption='Unsubscribe %' datatype='real' default-format='p0.00%' name='[Open % Rate (copy)_1301892146112110593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unsubscribe_count])/SUM([delivery_count])' />
            </column>
            <column caption='Mark as Spam %' datatype='real' default-format='p0.00%' name='[Unsubscribe % Rate (copy)_1301892146118864898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([spam_count])/SUM([delivery_count])' />
            </column>
