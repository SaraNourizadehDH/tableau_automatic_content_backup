      <column caption='Unsubscribe % ' datatype='real' default-format='p0.00%' name='[Unsubscribe % (copy)_1397875117667545099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unsubscribe_count])/SUM([delivery_count])' />
