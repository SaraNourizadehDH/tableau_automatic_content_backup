      <column caption='Completed duration Frequency  SE' datatype='real' name='[Calculation_6724507572363038750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1.96*(&#10;(STDEV(&#10;    (IF [Calculation_6724507572023136263] THEN [Calculation_2725944424430018560] END)&#10;))/&#10;(SQRT(&#10;    SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END)&#10;    )&#10;)&#10;)' />
      </column>
      <column caption='Date filter' datatype='boolean' name='[Calculation_6836182773284818951]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7 1] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336 1]' />
