            <column caption='Adhoc' datatype='boolean' name='[Calculation_1397875117666959370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Sends/Impressions' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_4514084582428643328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[impression_count]+[sends_count]' />
            </column>
            <column caption='Sends/Imp text' datatype='string' name='[Calculation_4514084582435262465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [channel] &#10;WHEN &apos;in-app message&apos; THEN &apos;Impressions&apos;&#10;WHEN &apos;email&apos; THEN &apos;Sends&apos;&#10;WHEN &apos;push notification&apos; THEN &apos;Sends&apos;&#10;WHEN &apos;sms&apos; THEN &apos;Sends&apos;&#10;ELSE &apos;Sends/Impressions&apos; END' />
            </column>
            <column caption='Country filter' datatype='boolean' name='[Calculation_5100608067634057224]' role='dimension' type='nominal'>
