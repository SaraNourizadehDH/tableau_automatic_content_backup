    <worksheet name='Campaigns Engagament Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontcolor='#666666' fontname='Tableau Regular' fontsize='14'>Engagement Campaigns </run>
            <run>Æ&#10;</run>
            <run fontcolor='#ff5a00' fontname='Tableau Regular' fontsize='8'>*drill down to campaigns level for Avg. Daily Recipients</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sq_agg_braze_engagement_performance_daily (data_platform)' name='federated.03r760k1u59mf714o4a1m0ab1gid' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286662153]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[entry_date]' caption='Start Date' datatype='date' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-09#'>
              <calculation class='tableau' formula='#2023-12-09#' />
            </column>
            <column caption='Country' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;AllCountries&quot;' value='All Countries' />
              </aliases>
              <desc>
                <formatted-text>
                  <run fontname='Tableau Regular' fontsize='8'>*&apos;AllCountries&apos; only applicable to Braze data</run>
                </formatted-text>
              </desc>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286486024]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[entry_date]' caption='End Date' datatype='date' name='[Start Date (copy)_6192308755550990336]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-08#'>
              <calculation class='tableau' formula='#2024-01-08#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='Avg. Daily Recipients' datatype='real' name='[Calculation_1062497692530778122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Campaign Name (copy)_5585096869167046659]) = MAX([Campaign Name (copy)_5585096869167046659]) &#10;THEN AVG([recipients_count])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Adhoc' datatype='boolean' name='[Calculation_1397875117666959370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Sends/Impressions' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_4514084582428643328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[impression_count]+[sends_count]' />
            </column>
            <column caption='Country filter' datatype='boolean' name='[Calculation_5100608067634057224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 9]=[country] OR [Parameters].[Parameter 9]= &apos;All&apos;' />
            </column>
            <column caption='Current Period' datatype='boolean' name='[Calculation_6192308755551604738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336]' />
            </column>
            <column caption='Delivery %' datatype='real' default-format='p0.0%' name='[Calculation_6192308755631566877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_count])/SUM([sends_count])' />
            </column>
            <column caption='Direct Open %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572359106588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_count])/SUM([delivery_count])' />
            </column>
            <column caption='Click-through %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572360736797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_count])/&#10;(&#10;    IF ATTR([channel])= &apos;email&apos; THEN SUM([open_count])&#10;    ELSEIF ATTR([channel])= &apos;in-app message&apos; THEN SUM([impression_count])&#10;    ELSE NULL END&#10;)' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_6836182773286486024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(MAX([entry_date]))}' />
            </column>
            <column caption='Last 30d start date' datatype='date' name='[Calculation_6836182773286662153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;,-30,MAX([entry_date])))}' />
            </column>
            <column caption='Campaign Country  ' datatype='string' name='[Campaign Country (copy)_5585096869166960641]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country]' />
              <aliases>
                <alias key='&quot;AllCountries&quot;' value='All Countries' />
              </aliases>
            </column>
            <column caption='Campaign Name  ' datatype='string' name='[Campaign Name (copy)_5585096869167046659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[campaign_name]' />
            </column>
            <column caption='Channel  ' datatype='string' name='[Channel (copy)_5585096869166989314]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
              <aliases>
                <alias key='&quot;push notification&quot;' value='push            notification' />
              </aliases>
            </column>
            <column caption='Channel   ' datatype='string' name='[Channel (copy)_6192871712976433167]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Clicks  ' datatype='integer' default-format='n#,##0;-#,##0' name='[Clicks (copy 2)_1397875117663113224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;push notification&apos; THEN NULL ELSE [click_count] END' />
            </column>
            <column caption='Deliveries ' datatype='integer' name='[Deliveries (copy)_5903093224143466501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;in-app message&apos; THEN NULL ELSE [delivery_count] END' />
            </column>
            <column caption='Direct Opens ' datatype='integer' name='[Direct Opens (copy 2)_5100608067626418177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;in-app message&apos; THEN NULL ELSE [open_count] END' />
            </column>
            <column caption='Unsubscribes ' datatype='integer' name='[Mark as Spam  (copy)_5100608067626909701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN [unsubscribe_count] END' />
            </column>
            <column caption='Mark as Spam % ' datatype='real' default-format='p0.00%' name='[Mark as Spam % (copy)_5100608067626807300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Mark as Spam (copy)_5100608067626553346])/SUM([delivery_count])' />
            </column>
            <column caption='Mark as Spam ' datatype='integer' name='[Mark as Spam (copy)_5100608067626553346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN [spam_count] ELSE NULL END' />
            </column>
            <column caption='Unsubscribe %  email only' datatype='real' default-format='p0.00%' name='[Unsubscribe %  (copy)_5100608067627057159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Mark as Spam  (copy)_5100608067626909701])/SUM([delivery_count])' />
            </column>
