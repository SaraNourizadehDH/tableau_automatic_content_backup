            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286486024]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[entry_date]' caption='End Date' datatype='date' name='[Start Date (copy)_6192308755550990336]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-08#'>
              <calculation class='tableau' formula='#2024-01-08#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='Adhoc' datatype='boolean' name='[Calculation_1397875117666959370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Country filter' datatype='boolean' name='[Calculation_5100608067634057224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 9]=[country] OR [Parameters].[Parameter 9]= &apos;All&apos;' />
            </column>
            <column aggregation='Avg' caption='Selected Period (days)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_6192308755551338497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 7],[Parameters].[Start Date (copy)_6192308755550990336])' />
            </column>
            <column caption='Current Period' datatype='boolean' name='[Calculation_6192308755551604738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336]' />
            </column>
            <column caption='Reference Date' datatype='date' datatype-customized='true' default-format='*mmmm dd, yyyy' name='[Calculation_6192308755560824837]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(IF ([Calculation_6192308755551604738]) THEN [entry_date] ELSE DATEADD(&apos;day&apos;, [Calculation_6192308755551338497]+1,[entry_date]) END)' />
            </column>
            <column caption='Date FIlter' datatype='boolean' name='[Calculation_6192308755561918470]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_6192308755551604738] or [Current Period (copy)_6192308755554025476]' />
            </column>
            <column caption='Period Flag' datatype='string' name='[Calculation_6192308755562209287]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [entry_date]&gt;=[Parameters].[Parameter 7] THEN &apos;Current Period&apos; ELSE &apos;Previous Period&apos; END' />
            </column>
            <column caption='Exact Date' datatype='date' datatype-customized='true' default-format='*mmmm dd, yyyy' name='[Calculation_6192308755566981130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Calculation_6192308755562209287]=&apos;Previous Period&apos; THEN DATEADD(&apos;day&apos;,-{MAX([Calculation_6192308755551338497])}-1,[Calculation_6192308755560824837]) ELSE [entry_date] END)' />
            </column>
            <column caption='Click-through %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572360736797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_count])/&#10;(&#10;    IF ATTR([channel])= &apos;email&apos; THEN SUM([open_count])&#10;    ELSEIF ATTR([channel])= &apos;in-app message&apos; THEN SUM([impression_count])&#10;    ELSE NULL END&#10;)' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_6836182773286486024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(MAX([entry_date]))}' />
            </column>
            <column caption='Last 30d start date' datatype='date' name='[Calculation_6836182773286662153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;,-30,MAX([entry_date])))}' />
            </column>
            <column caption='Channel (not all) (copy)' datatype='string' name='[Channel (not all) (copy)_4514084582437175298]' role='dimension' type='nominal'>
