        <calculation class='tableau' formula='(sum(IF NOT [Calculation_6724507572023136263] THEN [Calculation_2725944424430018560]*[users_entered_canvas] END))/&#10;SUM(IF NOT [Calculation_6724507572023136263] THEN [users_entered_canvas] END)' />
