            <column caption='Campaign Topics' datatype='string' name='[campaign_topics]' role='dimension' type='nominal' />
            <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
            <column caption='Campaign Vertical' datatype='string' name='[campaign_vertical]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Campaign Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;AllCountries&quot;' value='All Countries' />
              </aliases>
            </column>
            <column caption='Deliveries' datatype='integer' name='[delivery_count]' role='measure' type='quantitative' />
            <column caption='Entry Date' datatype='date' default-format='*mmm dd, yyyy' name='[entry_date]' role='dimension' type='ordinal' />
            <column caption='Impressions' datatype='integer' name='[impression_count]' role='measure' type='quantitative' />
            <column caption='Is Incentivized' datatype='boolean' name='[is_incentivized]' role='dimension' type='nominal' />
