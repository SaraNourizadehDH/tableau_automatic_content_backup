            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286662153]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[entry_date]' caption='Start Date' datatype='date' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-09#'>
