          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286662153]' caption='Start Date 1' datatype='date' name='[Parameter 7 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-09#'>
              <calculation class='tableau' formula='#2023-12-09#' />
              <range max='#2024-01-04#' min='#2022-01-01#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286486024]' caption='End Date 1' datatype='date' name='[Start Date (copy)_6192308755550990336 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-04#'>
              <calculation class='tableau' formula='#2024-01-04#' />
              <range max='#2024-01-04#' min='#2022-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='Max Date' datatype='date' name='[Calculation_6836182773286486024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(MAX([entry_date]))}' />
            </column>
            <column caption='Last 30d start date' datatype='date' name='[Calculation_6836182773286662153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;,-30,MAX([entry_date])))}' />
            </column>
            <column caption='Campaign Creator Team' datatype='string' name='[campaign_creator_team]' role='dimension' type='nominal' />
            <column caption='Campaign Owner' datatype='string' name='[campaign_owner]' role='dimension' type='nominal' />
            <column caption='Campaign Topics' datatype='string' name='[campaign_topics]' role='dimension' type='nominal' />
            <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
            <column caption='Entry Date' datatype='date' default-format='*mmm dd, yyyy' name='[entry_date]' role='dimension' type='ordinal' />
            <column-instance column='[campaign_creator_team]' derivation='None' name='[none:campaign_creator_team:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_owner]' derivation='None' name='[none:campaign_owner:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_topics]' derivation='None' name='[none:campaign_topics:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_type]' derivation='None' name='[none:campaign_type:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wobj760etqt151gyzrpk0tffzcz'>
            <column caption='Voucher Reception % ' datatype='real' default-format='p0%' name='[Calculation_5589600458549821443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_reception_rate]*[users_entered_canvas])/sum([users_entered_canvas])' />
            </column>
            <column caption='Control' datatype='boolean' name='[Calculation_5589600458563395596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [campaign_variant_name]=&apos;Control&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Adhoc-' datatype='boolean' name='[Calculation_6724507572075122712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Date filter' datatype='boolean' name='[Calculation_6836182773284818951]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7 1] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336 1]' />
            </column>
            <column caption='Users Received Voucher  ' datatype='integer' name='[Users Received Voucher (copy)_1301892146371932168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [campaign_variant_name] when &apos;Control&apos;&#10;THEN NULL&#10;ELSE [users_received_voucher]&#10;END' />
            </column>
            <column caption='Voucher Usage %' datatype='real' default-format='p0%' name='[Vouchers Reception % (copy)_5589600458554286087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([campaign_variant_name]) when &apos;Control&apos;&#10;THEN NULL&#10;ELSE SUM([vouchers_used])/SUM([vouchers_received])&#10;END' />
            </column>
            <column caption='Automation Status' datatype='string' name='[automation_status]' role='dimension' type='nominal' />
