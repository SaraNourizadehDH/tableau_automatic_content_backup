    <worksheet name='campaign details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontcolor='#666666' fontname='Tableau Regular' fontsize='14'>Engagement Campaigns </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sq_agg_braze_engagement_performance_daily (data_platform)' name='federated.03r760k1u59mf714o4a1m0ab1gid' />
          </datasources>
          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='Adhoc' datatype='boolean' name='[Calculation_1397875117666959370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='NULL primary topic' datatype='boolean' name='[Calculation_1457758919749107712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([Calculation_6192308759118082084])' />
            </column>
            <column caption='Delivery %' datatype='real' default-format='p0.0%' name='[Calculation_6192308755631566877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_count])/SUM([sends_count])' />
            </column>
            <column caption='Primary Topic' datatype='string' name='[Calculation_6192308759118082084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_topics], &apos;tPro&apos;) THEN &apos;tPro&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;tMart&apos;) THEN &apos;tMart&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;tRewards&apos;) OR CONTAINS([campaign_topics], &apos;tDine&apos;) THEN &apos;tRewards&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Pickup&apos;) THEN &apos;Pickup&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Welco&apos;) THEN &apos;Welcome&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Prospects&apos;) THEN &apos;Prospects&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Reactivation&apos;) THEN &apos;Reactivation&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Churn&apos;) THEN &apos;Churn&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Charity&apos;) OR CONTAINS([campaign_topics], &apos;Communication&apos;) OR CONTAINS([campaign_topics], &apos;Survey&apos;) THEN &apos;Comms&apos;&#10;ELSEIF CONTAINS([campaign_topics], &apos;Vendor&apos;) OR CONTAINS([campaign_topics], &apos;Promotion&apos;) OR CONTAINS([campaign_topics], &apos;Recommendation&apos;) OR CONTAINS([campaign_topics], &apos;ARO&apos;) THEN &apos;Vendor/Promos&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Direct Open %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572359106588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_count])/SUM([delivery_count])' />
            </column>
            <column caption='Click-through %' datatype='real' default-format='p0.0%' name='[Calculation_6724507572360736797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_count])/&#10;(&#10;    IF ATTR([channel])= &apos;email&apos; THEN SUM([open_count])&#10;    ELSEIF ATTR([channel])= &apos;in-app message&apos; THEN SUM([impression_count])&#10;    ELSE NULL END&#10;)' />
            </column>
            <column caption='Channel   ' datatype='string' name='[Channel (copy)_6192871712976433167]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Clicks  ' datatype='integer' default-format='n#,##0;-#,##0' name='[Clicks (copy 2)_1397875117663113224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;push notification&apos; THEN NULL ELSE [click_count] END' />
            </column>
            <column caption='Deliveries ' datatype='integer' name='[Deliveries (copy)_5903093224143466501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;in-app message&apos; THEN NULL ELSE [delivery_count] END' />
            </column>
            <column caption='Direct Opens ' datatype='integer' name='[Direct Opens (copy 2)_5100608067626418177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;in-app message&apos; THEN NULL ELSE [open_count] END' />
            </column>
            <column caption='Unsubscribes ' datatype='integer' name='[Mark as Spam  (copy)_5100608067626909701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN [unsubscribe_count] END' />
            </column>
            <column caption='Mark as Spam % ' datatype='real' default-format='p0.00%' name='[Mark as Spam % (copy)_5100608067626807300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Mark as Spam (copy)_5100608067626553346])/SUM([delivery_count])' />
            </column>
            <column caption='Mark as Spam ' datatype='integer' name='[Mark as Spam (copy)_5100608067626553346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel] WHEN &apos;email&apos; THEN [spam_count] ELSE NULL END' />
            </column>
            <column caption='Sends/Impressions ' datatype='integer' default-format='n#,##0;-#,##0' name='[Sends/Impressions (copy)_1397875117655789575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[impression_count]+[sends_count]' />
            </column>
            <column caption='Unsubscribe %  email only' datatype='real' default-format='p0.00%' name='[Unsubscribe %  (copy)_5100608067627057159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Mark as Spam  (copy)_5100608067626909701])/SUM([delivery_count])' />
            </column>
            <column caption='Automation' datatype='string' name='[automation]' role='dimension' type='nominal' />
            <column-instance column='[recipients_count]' derivation='Avg' name='[avg:recipients_count:qk]' pivot='key' type='quantitative' />
