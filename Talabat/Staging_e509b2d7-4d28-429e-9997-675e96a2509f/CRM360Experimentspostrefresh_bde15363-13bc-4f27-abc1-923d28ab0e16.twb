              <calculation class='tableau' formula='&quot;Return %&quot;' />
              <aliases>
                <alias key='&quot;Return \%&quot;' value='Return Rate %' />
              </aliases>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286662153]' caption='Start Date 1' datatype='date' name='[Parameter 7 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-09#'>
              <calculation class='tableau' formula='#2023-12-09#' />
              <range max='#2024-01-04#' min='#2022-01-01#' />
            </column>
            <column alias='14 Days' caption='Selecet Duration' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='14'>
              <calculation class='tableau' formula='14' />
              <aliases>
                <alias key='14' value='14 Days' />
                <alias key='30' value='30 Days' />
                <alias key='90' value='90 Days' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;AllCountries&quot;' value='All Countries' />
              </aliases>
              <desc>
                <formatted-text>
                  <run fontname='Tableau Regular' fontsize='8'>*&apos;AllCountries&apos; only applicable to Braze data</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Select Duration Metric' datatype='string' name='[Select % Metric (copy)_6724507572024889356]' param-domain-type='list' role='measure' type='nominal' value='&quot;Frequency&quot;'>
              <calculation class='tableau' formula='&quot;Frequency&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.03r760k1u59mf714o4a1m0ab1gid].[Calculation_6836182773286486024]' caption='End Date 1' datatype='date' name='[Start Date (copy)_6192308755550990336 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-04#'>
              <calculation class='tableau' formula='#2024-01-04#' />
              <range max='#2024-01-04#' min='#2022-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03r760k1u59mf714o4a1m0ab1gid'>
            <column caption='Max Date' datatype='date' name='[Calculation_6836182773286486024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(MAX([entry_date]))}' />
            </column>
            <column caption='Last 30d start date' datatype='date' name='[Calculation_6836182773286662153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;,-30,MAX([entry_date])))}' />
            </column>
            <column caption='Entry Date' datatype='date' default-format='*mmm dd, yyyy' name='[entry_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wobj760etqt151gyzrpk0tffzcz'>
            <column caption='Users Metric ' datatype='integer' default-format='N' name='[% Metric (copy)_5589600458876604430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;WHEN &apos;Reception %&apos; THEN [Users Received Voucher (copy)_1301892146371932168]&#10;WHEN &apos;Voucher Usage %&apos; THEN [vouchers_used]&#10;WHEN &apos;Avg. User Usage %&apos; THEN [Users Used Voucher (copy)_1301892146371624967]&#10;WHEN &apos;Return %&apos; THEN [Dynamic GMV eur (copy)_2725944424431869956]&#10;END' />
            </column>
            <column caption='SE' datatype='real' default-format='*(+/- 0.0)' name='[30d (copy 2)_6724507572375167011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select % Metric (copy)_6724507572024889356] &#10;WHEN &apos;Frequency&apos; THEN [Calculation_6724507572363038750]&#10;WHEN &apos;Avg. GMV (EUR)&apos; THEN [30d GMV (EUR) (copy)_6724507572374855714]&#10;WHEN &apos;Avg. EGPO (EUR)&apos; THEN [Completed duration GMV (EUR)  SE (copy)_3306908778982428676]&#10;END' />
            </column>
            <column caption='Up to duration GMV (EUR)' datatype='real' name='[30d GMV (EUR) (copy)_6724507572024160265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF NOT [Calculation_6724507572023136263] THEN [Dynamic Orders  (copy)_2725944424430391297]*[users_entered_canvas]  END))/&#10;SUM(IF NOT [Calculation_6724507572023136263] THEN [users_entered_canvas] END)' />
            </column>
            <column caption='Completed duration GMV (EUR)  SE' datatype='real' name='[30d GMV (EUR) (copy)_6724507572374855714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.96*&#10;STDEV(&#10;    (IF [Calculation_6724507572023136263] THEN ([Dynamic Orders  (copy)_2725944424430391297])  END)&#10;)/&#10;SQRT(&#10;    SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END)&#10;    )' />
            </column>
            <column caption='Completed duration Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. GMV EUR (weighted)  (copy)_5589600458560311307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [Calculation_6724507572023136263] THEN [Calculation_2725944424430018560]*[users_entered_canvas]  END))/&#10;SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END)' />
            </column>
            <column caption='Country filter' datatype='boolean' name='[Calculation_1301892146410024975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 9]=[country] OR [Parameters].[Parameter 9]= &apos;All&apos;' />
            </column>
            <column caption='Dynamic Orders ' datatype='real' name='[Calculation_2725944424430018560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 8] &#10;When 14 then [order_count_post_14_days]&#10;When 30 then [order_count_post_30_days]&#10;When 90 then [order_count_post_90_days]&#10;END' />
            </column>
            <column caption='Total Entrants filter' datatype='boolean' name='[Calculation_4513169789520048129]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [source_system_campaign_id]: sum([users_entered_canvas])} &gt;= [Parameters].[Parameter 12]' />
            </column>
            <column caption='Voucher Reception % ' datatype='real' default-format='p0%' name='[Calculation_5589600458549821443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_reception_rate]*[users_entered_canvas])/sum([users_entered_canvas])' />
            </column>
            <column caption='Control' datatype='boolean' name='[Calculation_5589600458563395596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [campaign_variant_name]=&apos;Control&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='% Metric' datatype='real' default-format='p0%' name='[Calculation_5589600458874859533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;WHEN &apos;Reception %&apos; THEN [Calculation_5589600458549821443]&#10;WHEN &apos;Voucher Usage %&apos; THEN [Vouchers Reception % (copy)_5589600458554286087]&#10;WHEN &apos;Avg. User Usage %&apos; THEN [Usage % (copy)_1301892146368626693]&#10;WHEN &apos;Return %&apos; THEN [Voucher Reception % (weighted) (copy)_5589600458556338185]&#10;END' />
            </column>
            <column caption='Contamination Campaigns List' datatype='string' name='[Calculation_6724507572010029059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT [Calculation_5589600458563395596]&#10;THEN&#10;TRIM(&#10;[contamination_campaigns - Split 1]+&quot;&#10;&quot;+[contamination_campaigns - Split 2]+&quot;&#10;&quot;+[contamination_campaigns - Split 3]+&quot;&#10;&quot;+[contamination_campaigns - Split 4]+&quot;&#10;&quot;+[contamination_campaigns - Split 5]+&quot;&#10;&quot;+[contamination_campaigns - Split 6]+&quot;&#10;&quot;+[contamination_campaigns - Split 7]+&quot;&#10;&quot;+[contamination_campaigns - Split 8]+&quot;&#10;&quot;+[contamination_campaigns - Split 9]+&quot;&#10;&quot;+[contamination_campaigns - Split 10])&#10;END' />
            </column>
            <column caption='Duration completed' datatype='boolean' name='[Calculation_6724507572023136263]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[entry_date],TODAY()) &gt; [Parameters].[Parameter 8]' />
            </column>
            <column caption='Adhoc-' datatype='boolean' name='[Calculation_6724507572075122712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([campaign_name],&apos;_AH_&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Completed duration Frequency  SE' datatype='real' name='[Calculation_6724507572363038750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.96*(&#10;(STDEV(&#10;    (IF [Calculation_6724507572023136263] THEN [Calculation_2725944424430018560] END)&#10;))/&#10;(SQRT(&#10;    SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END)&#10;    )&#10;)&#10;)' />
            </column>
            <column caption='Date filter' datatype='boolean' name='[Calculation_6836182773284818951]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [entry_date])&gt;=[Parameters].[Parameter 7 1] AND DATETRUNC(&apos;day&apos;, [entry_date])&lt;=[Parameters].[Start Date (copy)_6192308755550990336 1]' />
            </column>
            <column caption='Completed duration EGPO (EUR)  SE' datatype='real' name='[Completed duration GMV (EUR)  SE (copy)_3306908778982428676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.96*&#10;STDEV(&#10;    (IF [Calculation_6724507572023136263] THEN ([Dynamic GMV eur (copy)_3306908778976350208])  END)&#10;)/&#10;SQRT(&#10;    SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END)&#10;    )' />
            </column>
            <column caption='Completed duration EGPO (EUR) ' datatype='real' default-format='n#,##0;-#,##0' name='[Completed duration GMV (EUR) (copy)_3306908778976710658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((IF [Calculation_6724507572023136263] THEN [Dynamic GMV eur (copy)_3306908778976350208] END)*(IF[Calculation_6724507572023136263] THEN[users_entered_canvas] END))&#10;/(SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END))' />
            </column>
            <column caption='Dynamic Returend Users' datatype='integer' name='[Dynamic GMV eur (copy)_2725944424431869956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 8] &#10;When 14 then [returned_user_count_14_days]&#10;When 30 then [returned_user_count_30_days]&#10;When 90 then [returned_user_count_90_days]&#10;END' />
            </column>
            <column caption='Dynamic  EGPO eur ' datatype='real' default-format='n#,##0;-#,##0' name='[Dynamic GMV eur (copy)_3306908778976350208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 8] &#10;When 14 then [fully_loaded_egpo_post_14_days_eur]&#10;When 30 then [fully_loaded_egpo_post_30_days_eur]&#10;When 90 then [fully_loaded_egpo_post_90_days_eur]&#10;END' />
            </column>
            <column caption='Dynamic GMV eur' datatype='real' default-format='n#,##0;-#,##0' name='[Dynamic Orders  (copy)_2725944424430391297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 8] &#10;When 14 then [gmv_post_14_days_eur]&#10;When 30 then [gmv_post_30_days_eur]&#10;When 90 then [gmv_post_90_days_eur]&#10;END' />
            </column>
            <column caption='Dynamic Reorder Rate' datatype='real' name='[Dynamic Returend users (copy)_2725944424432349189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 8] &#10;When 14 then [reorder_rate_14_days]&#10;When 30 then [reorder_rate_30_days]&#10;When 90 then [reorder_rate_90_days]&#10;END' />
            </column>
            <column caption='Up to duration Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Frequency (copy)_6724507572022943750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF NOT [Calculation_6724507572023136263] THEN [Calculation_2725944424430018560]*[users_entered_canvas] END))/&#10;SUM(IF NOT [Calculation_6724507572023136263] THEN [users_entered_canvas] END)' />
            </column>
            <column caption='Completed duration GMV (EUR)' datatype='real' default-format='n#,##0;-#,##0' name='[Gmv 30D Post Eur (copy)_6724507572023832584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((IF [Calculation_6724507572023136263] THEN [Dynamic Orders  (copy)_2725944424430391297] END)*(IF[Calculation_6724507572023136263] THEN[users_entered_canvas] END))&#10;/(SUM(IF [Calculation_6724507572023136263] THEN [users_entered_canvas] END))' />
            </column>
            <column caption='Contamination %' datatype='real' default-format='p0%' name='[ReOrder % (weighted) (copy)_6724507571992645632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if max([is_incentivized])= false then null else &#10;sum([contamination_rate]*[users_entered_canvas])/sum([users_entered_canvas]) end' />
            </column>
            <column caption='Up to duration EGPO (EUR) ' datatype='real' name='[Up to duration GMV (EUR) (copy)_3306908778983243782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF NOT [Calculation_6724507572023136263] THEN [Dynamic GMV eur (copy)_3306908778976350208] * [users_entered_canvas]  END))/&#10;SUM(IF NOT [Calculation_6724507572023136263] THEN [users_entered_canvas] END)' />
            </column>
            <column caption='Within Duration' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Uplift on (copy)_6724507572028239887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select % Metric (copy)_6724507572024889356] &#10;WHEN &apos;Frequency&apos; THEN [Frequency (copy)_6724507572022943750]&#10;WHEN &apos;Avg. GMV (EUR)&apos; THEN [30d GMV (EUR) (copy)_6724507572024160265] &#10;WHEN &apos;Avg. EGPO (EUR)&apos; THEN [Up to duration GMV (EUR) (copy)_3306908778983243782] &#10;END' />
            </column>
            <column caption='Avg. User Usage %' datatype='real' default-format='p0%' name='[Usage % (copy)_1301892146368626693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([campaign_variant_name]) when &apos;Control&apos;&#10;THEN NULL&#10;ELSE SUM([avg_user_voucher_redemption_rate]*[Users Received Voucher (copy)_1301892146371932168])/SUM([Users Received Voucher (copy)_1301892146371932168])&#10;END' />
