        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0s2otpd0ecqd931f47kzr0hq0u3x' name='Custom SQL Query' type='text'>SELECT
    foi.country_code,
    dli.city_name, 
    dli.area_name,
    dli.area_lat,
    dli.area_long, 
    foi.order_date,
    count(distinct order_id) as acquisitions, 
FROM `tlb-data-prod.data_platform.fct_order_info` foi 
INNER JOIN `tlb-data-prod.data_platform.dim_location_info` dli ON foi.delivery_location_id = dli.location_id
