      <column caption='Dimension' datatype='string' name='[Calculation_1358116788781912066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Country&apos; then [Calculation_2935502555503267840]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Channel&apos; then [channel]&#10;end' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_1358116788782219267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Select Metric (copy)_1358116788781715456] = &apos;Spend&apos; then sum([ad_spend_eur])&#10;elseif [Parameters].[Select Metric (copy)_1358116788781715456] = &apos;Orders&apos; then sum([aj_orders_0w]) &#10;elseif [Parameters].[Select Metric (copy)_1358116788781715456] = &apos;QC Orders&apos; then sum([qc_orders_aj_0w])&#10;elseif [Parameters].[Select Metric (copy)_1358116788781715456] = &apos;CPO&apos; then [Calculation_2935502555503992833] &#10;end' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_2935502555503267840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([brand], &apos;Bah&apos;) THEN &apos;BH&apos; &#10;ELSEIF CONTAINS([brand], &apos;Egy&apos;) THEN &apos;EG&apos; &#10;ELSEIF CONTAINS([brand], &apos;Iraq&apos;) THEN &apos;IQ&apos; &#10;ELSEIF CONTAINS([brand], &apos;Jo&apos;) THEN &apos;JO&apos; &#10;ELSEIF CONTAINS([brand], &apos;Kuw&apos;) THEN &apos;KW&apos; &#10;ELSEIF CONTAINS([brand], &apos;Om&apos;) THEN &apos;OM&apos; &#10;ELSEIF CONTAINS([brand], &apos;Qat&apos;) THEN &apos;QA&apos; &#10;ELSEIF CONTAINS([brand], &apos;UAE&apos;) THEN &apos;AE&apos; &#10;END' />
      </column>
      <column caption='CPO' datatype='real' name='[Calculation_2935502555503992833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ad_spend_eur]) / sum([aj_orders_0w])' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_2935502555506085890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,date([date])) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,date([date])) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#10;then &apos;Previous Month&apos;&#10;else &apos;Remaining&apos;&#10;end' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_2935502555506450435]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([date])' />
