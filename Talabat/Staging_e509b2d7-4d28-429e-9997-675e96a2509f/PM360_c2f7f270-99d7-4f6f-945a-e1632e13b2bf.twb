              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[month]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#10;then &apos;Previous Month&apos;&#10;else &apos;Remaining&apos;&#10;end' />
