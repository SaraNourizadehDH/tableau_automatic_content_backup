      <column caption='Cost per Install' datatype='real' default-format='n&quot;€ &quot;#,##0.0;-&quot;€ &quot;#,##0.0' name='[Calculation_1236238160790556674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur])/sum([total_installs_count])' />
      </column>
      <column caption='Metric' datatype='real' default-format='c&quot;€ &quot;#,##0.0;-&quot;€ &quot;#,##0.0' name='[Calculation_1236238161809453061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;Cost per Acquisition (Eur)&apos; then [Cost per Install (Eur) (copy)_1236238160790786051] &#10;elseif [Parameters].[Parameter 5] = &apos;Acquisitions&apos; then sum([acquisitions_calibration_ios14fix_count]) &#10;elseif [Parameters].[Parameter 5] = &apos;Installs&apos; then sum([total_installs_count])&#10;elseif [Parameters].[Parameter 5] = &apos;Cost per Install (Eur)&apos; then [Calculation_1236238160790556674] end' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1236238161817264134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Country&apos; then [country_code]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Channel&apos; then [channel]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Sub-Channel&apos; then [sub_channel]&#10;end' />
