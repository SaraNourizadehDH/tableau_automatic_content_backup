      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E3460518D0EC4B92A639A1B13ABD00CF'>
            <properties context=''>
              <relation connection='bigquery.0pwxgfn1cuyo4b14ws4bl0z60a9g' name='Custom SQL Query' type='text'>with t1
as (
  select
    distinct 
    month,
    REGEXP_EXTRACT(month, r&apos;([A-Za-z]+)&apos;) AS month_name,
    REGEXP_EXTRACT(month, r&apos;(\d{4})&apos;) AS year 
  from `tlb-data-dev.regional_marketing_analytics_qa.cs_rmo_incremental_ytd_20240529`
),

month_fixed
as (
  select
    t1.month as month_,
    cast(concat(t1.year, &apos;-&apos;, month_padded,&apos;-&apos;,&apos;01&apos;) as date) as month
  from t1 
  left join `tlb-data-prod.data_platform.dim_date` dd on t1.month_name = dd.long_month_name
  qualify row_number() over(partition by month_) = 1 
),

incrementality
as (
  select
    a.* except(month),
    b.month
  from `tlb-data-dev.regional_marketing_analytics_qa.cs_rmo_incremental_ytd_20240529` a 
  inner join month_fixed b on a.month = b.month_
),

rmo 
as (
  select
    brand,
    date_trunc(date(date), month) as date,
    rmo_segment,
    channel,
    sum(ad_spend_eur) as ad_spend_eur,
    sum(aj_orders_0w) as aj_orders_0w,
    sum(qc_orders_aj_0w) as qc_orders_aj_0w,
  from `tlb-data-dev.regional_marketing_analytics_qa.cs_ytd_rmo_20240529`
  group by 1,2,3,4
)

select
  rmo.*,
  inc.* except (brand, month, rmo_campaign, ad_spend, Orders_AJ_0w, Qcom_Orders_AJ_0w, CPO_AJ_0w)
from rmo 
left join incrementality inc on rmo.date = inc.month and rmo.brand=inc.brand and rmo.rmo_segment=inc.rmo_campaign</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
