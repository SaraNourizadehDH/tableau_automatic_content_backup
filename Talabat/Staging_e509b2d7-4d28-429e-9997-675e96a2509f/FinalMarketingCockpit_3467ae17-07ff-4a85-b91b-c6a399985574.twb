      <column caption='Dynamic metric' datatype='real' name='[Calculation_3414080425945948161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;    when &apos;Orders&apos; then [vertical_orders]&#10;    WHEN &apos;GMV&apos; then [vertical_gmv]&#10;    else [vertical_mau]&#10;end' />
      </column>
      <column caption='M1 Freq' datatype='real' name='[Calculation_3414080425954795523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([m1_orders])/sum([m1_acids])' />
      </column>
      <column caption='Dynamic country measure' datatype='real' name='[Calculation_3414080425961222151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;    when &quot;Orders&quot; then [vertical_orders]&#10;    when &quot;GMV&quot; then [vertical_gmv]&#10;    when &quot;MAU&quot; then [vertical_mau]&#10;    when &quot;Acquistions&quot; then [acquisitions]&#10;    when &quot;tpro Subs&quot; then [active_subscribers]&#10;end' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_3414080425969233929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vertical_gmv])/sum([vertical_orders])' />
      </column>
      <column caption='Selected month ' datatype='string' name='[Calculation_3414080426003329036]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[month]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 2]))&#10;then &apos;Previous Month&apos;&#10;end' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_6869256132410896401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vertical_orders])/SUM([vertical_mau])' />
      </column>
      <column caption='tpro Adoption Rate ' datatype='real' name='[Calculation_6869256132413825042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_subscribers])/sum([talabat_active])' />
      </column>
      <column caption='view fitler' datatype='boolean' name='[Calculation_920141764024000537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &apos;Customers&apos;' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_2F698030EF3F47ACA6226DC9F586AB4C]' role='measure' type='quantitative' />
