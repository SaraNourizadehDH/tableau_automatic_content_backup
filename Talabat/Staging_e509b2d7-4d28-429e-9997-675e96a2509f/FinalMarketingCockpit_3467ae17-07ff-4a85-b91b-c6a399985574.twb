        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03f0wpk1t39ivb124vvns1tefg7g' name='Custom SQL Query' type='text'>with orders
as(
  select
  distinct
    oi.country_code,
    date_trunc(oi.order_date, month) month,
    case
      when is_darkstore then &apos;tmart&apos;
      when is_non_food then &apos;LS&apos;
      else &apos;food&apos; end as vertical,
    oi.analytical_customer_id,
  from `tlb-data-prod.data_platform.fct_order_info` oi
  where order_date &gt;&gt;=  date_sub(date_trunc(current_date(),month),interval 24 month)
    and is_successful 
    and not is_test
),

mv_flagging as(
  select  
    month,
    country_code,
    analytical_customer_id,
    string_agg(vertical, &apos;,&apos; order by vertical) mv, 
    from orders
    group by all
)

select
  month,
  country_code,
  mv,
  count(distinct analytical_customer_id) mv_acids,
from mv_flagging
group by all
order by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
