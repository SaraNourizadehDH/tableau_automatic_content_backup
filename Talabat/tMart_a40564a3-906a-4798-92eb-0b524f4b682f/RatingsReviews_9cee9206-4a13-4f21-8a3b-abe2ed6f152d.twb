      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_36581A20CFC64C878C1E4C7AA8D59969'>
            <properties context=''>
              <relation connection='bigquery.0tfvouq1lf1wlb15ycymv0amum6o' name='Custom SQL Query' type='text'><![CDATA[SELECT 
order_date AS date,
CAST(r.rating_time AS STRING) as id,
r.original_rating,
r.converted_rating,
r.food_rating,
r.delivery_rating,
r.service_rating,
r.value_rating,
r.review,
r.driver_rating,
orders.analytical_customer_id,
orders.order_id,
vendor_name,
orders.country_iso,
CASE WHEN vendor_name LIKE '%Everyday%' OR vendor_name LIKE '%everyday%' THEN 'Yes' ELSE 'No' END AS edyesno

FROM `tlb-data-prod.data_platform.fct_order_info` as orders

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` as vendor
ON orders.vendor_id = vendor.source_system_vendor_id

left join `tlb-data-prod.data_platform.fct_rating` as r
on r.order_id = orders.order_id

WHERE (orders.is_darkstore OR vendor_name LIKE '%Everyday%' OR vendor_name LIKE '%everyday%') 
AND ( order_date BETWEEN <[Parameters].[Parameter 1]> AND <[Parameters].[Parameter 2]>)
AND order_date >>= '2021-01-01' 
AND (vendor_name NOT LIKE '%Baqalet%' AND vendor_name NOT LIKE '%Sushi%' AND vendor_name NOT LIKE '%Dose%' AND vendor_name NOT LIKE '%GO%' )]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
