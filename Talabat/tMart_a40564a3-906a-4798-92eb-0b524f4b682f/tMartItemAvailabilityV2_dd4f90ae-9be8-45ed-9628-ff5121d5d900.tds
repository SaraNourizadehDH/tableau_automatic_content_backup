  </column>
  <column caption='Warehouse Sum' datatype='integer' name='[Calculation_5920403965931667456]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [country_code], [warehouse_name]: SUM([customer_order_count]) }' />
