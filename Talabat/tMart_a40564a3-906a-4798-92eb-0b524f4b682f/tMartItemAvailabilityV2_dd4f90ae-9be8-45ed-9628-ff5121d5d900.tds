    </named-connections>
    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vajo9h0kqv2tk10sx2zi017ypn5' name='Custom SQL Query' type='text'><![CDATA[SELECT 
	avail.warehouse_id,
	avail.warehouse_name,
        avail.vendor_id,
        avail.vendor_name,
	avail.supplier_name,
        avail.stock_date as transaction_date,
	avail.stock_date,
	avail.stock_count_day,
	avail.product_age_bucket,
	avail.product_name,
        avail.category_name_level_one,
        avail.category_name_level_two,
        avail.category_name_level_three,
	avail.category_english,
	avail.category_parent_english,
	avail.brand_name as brand,
        COALESCE(avail.is_dc_sku, FALSE) as is_dc_sku,
        COALESCE(avail.is_active_warehouse, FALSE) as is_active_warehouse,
        COALESCE(avail.is_promo_sku, FALSE) as is_promo_sku,
        IF(avail.is_available_bool,1,0) as is_available_day,
        IF(avail.is_available_evening,1,0) as is_available_evening,
	IF(avail.is_available_am,1,0) as is_available_am,
	IF(avail.is_available_pm,1,0) as is_available_pm,
	avail.percent_hours_available_full_day as availability_perc,
	avail.country_code,
        COALESCE(avail.item_role, 'Not set on PIM') as price_tier,
        avail.sku,
	case 
		when dh_is_stale_day then false 
		else true end 
	as is_stale_filter,

        case 
		when tlb_is_stale_day then false 
		else true end 
	as tlb_is_stale_filter,

        case 
		when is_stale_day then false 
		else true end 
	as combined_is_stale_filter,

        abc_bucket,
        xyz_bucket,
        customer_order_count,
from `tlb-data-prod.data_platform.agg_grocery_stock_availability_v2` avail

where 
	1=1
	AND stock_date >>=  '2023-01-01'
	AND stock_date <<=  CURRENT_DATE()
	AND lower(avail.brand_name) <<>> 'comboproduct brand'
        AND NOT COALESCE(dh_is_stale_day, FALSE)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vajo9h0kqv2tk10sx2zi017ypn5' name='Custom SQL Query' type='text'><![CDATA[SELECT 
	avail.warehouse_id,
	avail.warehouse_name,
        avail.vendor_id,
        avail.vendor_name,
	avail.supplier_name,
        avail.stock_date as transaction_date,
	avail.stock_date,
	avail.stock_count_day,
	avail.product_age_bucket,
	avail.product_name,
        avail.category_name_level_one,
        avail.category_name_level_two,
        avail.category_name_level_three,
	avail.category_english,
	avail.category_parent_english,
	avail.brand_name as brand,
        COALESCE(avail.is_dc_sku, FALSE) as is_dc_sku,
        COALESCE(avail.is_active_warehouse, FALSE) as is_active_warehouse,
        COALESCE(avail.is_promo_sku, FALSE) as is_promo_sku,
        IF(avail.is_available_bool,1,0) as is_available_day,
        IF(avail.is_available_evening,1,0) as is_available_evening,
	IF(avail.is_available_am,1,0) as is_available_am,
	IF(avail.is_available_pm,1,0) as is_available_pm,
	avail.percent_hours_available_full_day as availability_perc,
	avail.country_code,
        COALESCE(avail.item_role, 'Not set on PIM') as price_tier,
        avail.sku,
	case 
		when dh_is_stale_day then false 
		else true end 
	as is_stale_filter,

        case 
		when tlb_is_stale_day then false 
		else true end 
	as tlb_is_stale_filter,

        case 
		when is_stale_day then false 
		else true end 
	as combined_is_stale_filter,

        abc_bucket,
        xyz_bucket,
        customer_order_count,
from `tlb-data-prod.data_platform.agg_grocery_stock_availability_v2` avail

where 
	1=1
	AND stock_date >>=  '2023-01-01'
	AND stock_date <<=  CURRENT_DATE()
	AND lower(avail.brand_name) <<>> 'comboproduct brand'
        AND NOT COALESCE(dh_is_stale_day, FALSE)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
