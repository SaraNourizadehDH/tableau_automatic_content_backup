  <column caption='Aggregation Rows' datatype='string' name='[Aggregation Column (copy)_2334412761856864259]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE  [Parameters].[Availability Aggregation (copy)_2334412761855700994]&#10;WHEN &quot;Brand Name&quot; THEN [brand]&#10;WHEN &quot;Warehouse Name&quot; THEN [warehouse_name]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;PIM Category Level 1&quot; THEN [category_name_level_one]&#10;WHEN &quot;PIM Category Level 2&quot; THEN [category_name_level_two]&#10;WHEN &quot;PIM Category Level 3&quot; THEN [category_name_level_three]&#10;WHEN &quot;Front-End Category&quot; THEN [category_parent_english]&#10;WHEN &quot;Front-End Sub-category&quot; THEN [category_english]&#10;WHEN &quot;Price Tier&quot; THEN [price_tier]&#10;WHEN &quot;Supplier Name&quot; THEN [supplier_name]&#10;WHEN &quot;Country&quot; THEN [country_code]&#10;WHEN &quot;Date&quot; THEN STR(DATE([stock_date]))&#10;WHEN &quot;ABC Categorization&quot; THEN [abc_bucket]&#10;WHEN &quot;XYZ Categorization&quot; THEN [xyz_bucket]&#10;WHEN &quot;ABC-XYZ Categorization&quot; THEN [abc_bucket]+[xyz_bucket]&#10;END' />
  </column>
  <column caption='Available SKUs' datatype='string' default-role='measure' default-type='quantitative' name='[Availability % (copy)_2317242780222713859]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
  </column>
  <column caption='Available SKUs (copy)' datatype='string' default-role='measure' default-type='quantitative' name='[Available SKUs (copy)_2317242780231315461]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
  </column>
  <column caption='Available SKUs per Warehouse (P2)' datatype='real' name='[Available SKUs per Warehouse (copy)_4695635967610191873]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD(&#10;&#10;CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [is_available_day] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_evening&quot; THEN IF [is_available_evening] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_perc&quot; THEN IF[is_available_day] = 1 THEN [sku] ELSE NULL END&#10;END&#10;&#10;&#10;) })' />
  </column>
  <column caption='Availability %' datatype='real' default-format='p0.00%' name='[Calculation_2317242780218630144]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_evening&quot; THEN [is_available_evening]&#10;WHEN &quot;is_available_perc&quot; THEN [availability_perc]&#10;WHEN &quot;is_available_eod&quot; THEN [is_available_day]&#10;END' />
  </column>
  <column caption='Active SKUs' datatype='integer' name='[Calculation_2317242780222386177]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([sku])' />
  </column>
  <column caption='SKUs per Warehouse' datatype='real' name='[Calculation_2317242780352823308]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
  </column>
  <column caption='Aggregation Column' datatype='string' name='[Calculation_2334412761854545921]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Brand Name&quot; THEN [brand]&#10;WHEN &quot;Warehouse Name&quot; THEN [warehouse_name]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;PIM Category Level 1&quot; THEN [category_name_level_one]&#10;WHEN &quot;PIM Category Level 2&quot; THEN [category_name_level_two]&#10;WHEN &quot;PIM Category Level 3&quot; THEN [category_name_level_three]&#10;WHEN &quot;Front-End Category&quot; THEN [category_parent_english]&#10;WHEN &quot;Front-End Sub-category&quot; THEN [category_english]&#10;WHEN &quot;Price Tier&quot; THEN [price_tier]&#10;WHEN &quot;Supplier Name&quot; THEN [supplier_name]&#10;WHEN &quot;Country&quot; THEN [country_code]&#10;WHEN &quot;Date&quot; THEN STR(DATE([stock_date]))&#10;WHEN &quot;ABC Categorization&quot; THEN [abc_bucket]&#10;WHEN &quot;XYZ Categorization&quot; THEN [xyz_bucket]&#10;WHEN &quot;ABC-XYZ Categorization&quot; THEN [abc_bucket]+[xyz_bucket]&#10;END' />
  </column>
  <column caption='Date Select Download' datatype='datetime' name='[Calculation_2998271490763743232]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSE   DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;&#10;END' />
  </column>
  <column caption='abc_xyz_categorization' datatype='string' name='[Calculation_3010515655962755072]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[abc_bucket] + [xyz_bucket]' />
  </column>
  <column caption='Fresh / UF' datatype='string' name='[Calculation_345229103887466499]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [category_name_level_one] in (&apos;Dairy / Chilled / Eggs&apos; , &apos;Bread / Bakery&apos;) THEN &apos;Ultra-Fresh&apos;&#10;ELSEIF [category_name_level_one] in (&apos;Produce&apos; , &apos;Ready To Consume&apos;, &apos;Meat / Seafood&apos;) THEN &apos;Fresh&apos;&#10;ELSE NULL &#10;END' />
