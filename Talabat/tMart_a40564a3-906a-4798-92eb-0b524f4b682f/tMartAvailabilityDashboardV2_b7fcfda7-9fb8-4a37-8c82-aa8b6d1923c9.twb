    <window class='dashboard' name='Availability Overview'>
      <viewpoints>
        <viewpoint name='ABC Availability Trend'>
          <zoom type='entire-view' />
          <highlight>
            <color-one-way>
              <field>[tMart Item Availability [V2]] (local copy)].[none:abc_bucket:nk]</field>
            </color-one-way>
          </highlight>
        </viewpoint>
        <viewpoint name='Active v/s Available SKUs'>
          <zoom type='entire-view' />
          <highlight field='[tMart Item Availability [V2]] (local copy)].[:Measure Names]'>
            <bucket-selection />
          </highlight>
        </viewpoint>
        <viewpoint name='Availability Trend'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='Availability by ABC' />
        <viewpoint name='Availability by Country' />
        <viewpoint name='Availability by Price Tier' />
        <viewpoint name='Availability by Warehouse' />
