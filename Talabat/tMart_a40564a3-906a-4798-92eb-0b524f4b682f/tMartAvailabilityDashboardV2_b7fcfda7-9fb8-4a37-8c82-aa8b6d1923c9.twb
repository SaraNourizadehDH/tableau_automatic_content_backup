      <object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8A16FE97312B497E914A90EB72BC890B'>
            <properties context=''>
              <relation connection='bigquery.0vajo9h0kqv2tk10sx2zi017ypn5' name='Custom SQL Query' type='text'>SELECT &#10;&#9;avail.warehouse_id,&#10;&#9;avail.warehouse_name,&#10;        avail.vendor_id,&#10;        avail.vendor_name,&#10;&#9;avail.supplier_name,&#10;        avail.stock_date as transaction_date,&#10;&#9;avail.stock_date,&#10;&#9;avail.stock_count_day,&#10;&#9;avail.product_age_bucket,&#10;&#9;avail.product_name,&#10;        avail.category_name_level_one,&#10;        avail.category_name_level_two,&#10;        avail.category_name_level_three,&#10;&#9;avail.category_english,&#10;&#9;avail.category_parent_english,&#10;&#9;avail.brand_name as brand,&#10;        COALESCE(avail.is_dc_sku, FALSE) as is_dc_sku,&#10;        COALESCE(avail.is_active_warehouse, FALSE) as is_active_warehouse,&#10;        COALESCE(avail.is_promo_sku, FALSE) as is_promo_sku,&#10;        IF(avail.is_available_bool,1,0) as is_available_day,&#10;        IF(avail.is_available_evening,1,0) as is_available_evening,&#10;&#9;IF(avail.is_available_am,1,0) as is_available_am,&#10;&#9;IF(avail.is_available_pm,1,0) as is_available_pm,&#10;&#9;avail.percent_hours_available_full_day as availability_perc,&#10;&#9;avail.country_code,&#10;        COALESCE(avail.item_role, &apos;Not set on PIM&apos;) as price_tier,&#10;        avail.sku,&#10;&#9;case &#10;&#9;&#9;when dh_is_stale_day then false &#10;&#9;&#9;else true end &#10;&#9;as is_stale_filter,&#10;&#10;        case &#10;&#9;&#9;when tlb_is_stale_day then false &#10;&#9;&#9;else true end &#10;&#9;as tlb_is_stale_filter,&#10;&#10;        case &#10;&#9;&#9;when is_stale_day then false &#10;&#9;&#9;else true end &#10;&#9;as combined_is_stale_filter,&#10;&#10;        abc_bucket,&#10;        xyz_bucket,&#10;        customer_order_count,&#10;from `tlb-data-prod.data_platform.agg_grocery_stock_availability_v2` avail&#10;&#10;where &#10;&#9;1=1&#10;&#9;AND stock_date &gt;&gt;=  &apos;2023-01-01&apos;&#10;&#9;AND stock_date &lt;&lt;=  CURRENT_DATE()&#10;&#9;AND lower(avail.brand_name) &lt;&lt;&gt;&gt; &apos;comboproduct brand&apos;&#10;        AND NOT COALESCE(dh_is_stale_day, FALSE)&#10;        AND NOT is_edr_sku&#10;        AND NOT is_deleted_sku</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
