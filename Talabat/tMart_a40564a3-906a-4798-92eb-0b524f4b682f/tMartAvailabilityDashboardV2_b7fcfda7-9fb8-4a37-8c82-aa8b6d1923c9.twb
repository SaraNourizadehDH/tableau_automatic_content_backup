  <worksheets>
    <worksheet name='80-20 Availability by Category and Store'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='16'>% of active SKUs available by PIM Level 2</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='10' italic='true'>Rows sorted by Sales of Category in country</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='10' italic='true'>Columns sorted by Sales of Warehouse in country</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#e15759' fontsize='10'>*Country selection is necessary</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='tMart Item Availability [V2] (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Hourly Availability %' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_perc&quot;'>
              <calculation class='tableau' formula='&quot;is_available_perc&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_evening&quot;' value='6PM Availability' />
                <alias key='&quot;is_available_perc&quot;' value='Hourly Availability %' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='tMart Item Availability [V2] (local copy)'>
            <column caption='Availability %' datatype='real' default-format='p0.00%' name='[Calculation_2317242780218630144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_evening&quot; THEN [is_available_evening]&#10;WHEN &quot;is_available_perc&quot; THEN [availability_perc]&#10;WHEN &quot;is_available_eod&quot; THEN [is_available_day]&#10;END' />
            </column>
            <column caption='SKUs per Warehouse' datatype='real' name='[Calculation_2317242780352823308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
