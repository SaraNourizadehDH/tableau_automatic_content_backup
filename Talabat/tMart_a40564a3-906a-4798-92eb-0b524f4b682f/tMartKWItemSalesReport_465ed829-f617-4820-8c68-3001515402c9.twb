            4,&#13;
            5,&#13;
            6,&#13;
            7,&#13;
            8,&#13;
            9,&#13;
            10,&#13;
            11),&#13;
     combined_data AS&#13;
  (SELECT ord.* except(item_id),&#13;
                dim_item.*,&#13;
   FROM order_item_data AS ord&#13;
   LEFT JOIN&#13;
     (SELECT item_id,&#13;
             product_sku,&#13;
             item_name_en AS product_name,&#13;
             brand_name,&#13;
             category_name_level_one AS pim_l1,&#13;
             category_name_level_two AS pim_l2&#13;
      FROM `tlb-data-prod.data_platform.dim_item`&#13;
      GROUP BY 1,&#13;
               2,&#13;
               3,&#13;
               4,&#13;
               5,&#13;
               6) AS dim_item ON (ord.item_id = dim_item.item_id))&#13;
SELECT order_date,&#13;
       warehouse_id,&#13;
       vendor_warehouse_name,&#13;
       product_sku,&#13;
       pim_l1,&#13;
       pim_l2,&#13;
       product_name,&#13;
       brand_name,&#13;
       sum(sold_quantity) AS units_sold,&#13;
       sum(total_price_paid_net_lc) AS net_sales_lc,&#13;
       sum(total_price_paid_net_eur) AS net_sales_eur,&#13;
       COUNT(DISTINCT order_id) AS total_orders&#13;
FROM combined_data&#13;
GROUP BY 1,&#13;
         2,&#13;
         3,&#13;
         4,&#13;
         5,&#13;
         6,&#13;
         7,&#13;
         8</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
