              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [order_date]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#13;&#10;&#13;&#10;END)' />
