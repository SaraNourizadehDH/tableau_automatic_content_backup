      <column caption='Date Aggregation' datatype='date' datatype-customized='true' name='[Calculation_470063215713656832]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [order_date]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='Metric to Display' datatype='string' name='[Calculation_839076930688512000]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;&#13;&#10;WHEN &apos;Units Sold&apos; THEN str(round([Calculation_904379168164638721],0))&#13;&#10;&#13;&#10;WHEN &apos;Net Sales&apos; THEN str(round([Calculation_904379168164638721],2))&#13;&#10;&#13;&#10;WHEN &apos;Total Orders&apos; THEN str(round([Calculation_904379168164638721],0))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_904379168163373056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &apos;EUR&apos; THEN [net_sales_eur]&#13;&#10;&#13;&#10;WHEN &apos;LC&apos; THEN [net_sales_lc]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Metric to Plot' datatype='real' name='[Calculation_904379168164638721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 3]&#13;&#10;&#13;&#10;WHEN &apos;Units Sold&apos; THEN [units_sold]&#13;&#10;&#13;&#10;WHEN &apos;Net Sales&apos; THEN [Calculation_904379168163373056]&#13;&#10;&#13;&#10;WHEN &apos;Total Orders&apos; THEN [total_orders]&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='Start Date Calc' datatype='date' name='[Calculation_985443895193751552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([order_date])-29}' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_985443895201243138]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_date] &gt;= [Parameters].[Parameter 4]&#13;&#10;&#13;&#10;AND [order_date] &lt;= [Parameters].[Start Param (copy)_985443895238430723]&#13;&#10;&#13;&#10;THEN TRUE&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='End Date Calc' datatype='date' name='[Start Date Calc (copy)_985443895195815937]' role='dimension' type='ordinal'>
