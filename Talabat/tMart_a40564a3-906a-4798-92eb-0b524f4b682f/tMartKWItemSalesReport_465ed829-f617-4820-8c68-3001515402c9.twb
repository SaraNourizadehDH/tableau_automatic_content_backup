              WHEN foi.vendor_id = dv.parent_vendor_id THEN foi.vendor_id&#13;
              ELSE dv.parent_vendor_id&#13;
          END AS vendor_id,&#13;
          dv.vendor_warehouse_id warehouse_id,&#13;
                                 vendor_warehouse_name&#13;
   FROM `tlb-data-prod.data_platform.fct_order_info` foi&#13;
   LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dv ON (foi.vendor_id = dv.vendor_id)&#13;
   WHERE is_successful&#13;
     AND dv.is_darkstore&#13;
     AND DATE_TRUNC(order_date,MONTH) &gt;&gt;= DATE_TRUNC(DATE_ADD(CURRENT_DATE,interval -3 MONTH),MONTH)&#13;
     AND foi.country_code = &apos;KW&apos;&#13;
   GROUP BY 1,&#13;
            2,&#13;
            3,&#13;
            4,&#13;
            5,&#13;
            6,&#13;
            7),&#13;
     order_item_data AS&#13;
  (SELECT ord.*,&#13;
          item_id,&#13;
          sold_quantity,&#13;
          total_price_paid_net_lc,&#13;
          total_price_paid_net_eur&#13;
   FROM `tlb-data-prod.data_platform.fct_order_item` AS item&#13;
   LEFT JOIN order_base AS ord ON (item.order_id = ord.order_id)&#13;
   WHERE ord.order_id IS NOT NULL&#13;
   GROUP BY 1,&#13;
