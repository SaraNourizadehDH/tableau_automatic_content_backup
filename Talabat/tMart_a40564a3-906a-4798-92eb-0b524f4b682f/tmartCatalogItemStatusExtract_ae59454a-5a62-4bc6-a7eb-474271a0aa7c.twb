          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vq70l30ymouj111pjvvy1wec7nl' name='Custom SQL Query' type='text'>SELECT&#13;
  p.country_code,&#13;
  p.skus AS sku,&#13;
  is_deleted AS vendor_product_is_deleted,&#13;
  p.master_code,&#13;
  global_product_id,&#13;
  p.product_created_at,&#13;
  p.category_parent_english AS Category,&#13;
  p.master_category_names.level_one AS PIM_L1,&#13;
  p.master_category_names.level_two AS PIM_L2,&#13;
  barcodes,&#13;
  product_name_english,&#13;
  v.vendor_warehouse_id AS warehouse_id,&#13;
  w.warehouse_name,&#13;
  vendor_name,&#13;
  is_dsaas,&#13;
  p.vendor_id,&#13;
  p.vendor_product_status AS status,&#13;
  p.is_active,&#13;
  p.sales_buffer,&#13;
  CASE v.vendor_id - v.parent_vendor_id WHEN 0 THEN &apos;True&apos; ELSE &apos;False&apos; END AS is_parent_store,&#13;
  CASE WHEN COALESCE(catalog_original_price_lc,0) = 0 THEN 0 ELSE catalog_price_lc END AS discounted_sp,&#13;
  COALESCE(catalog_original_price_lc,catalog_price_lc) AS regular_sp,&#13;
&#13;
FROM&#13;
  `tlb-data-prod.data_platform_dmart.dim_product` p&#13;
&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
ON p.vendor_id = CAST(v.vendor_id AS STRING)&#13;
&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_warehouse` w ON w.source_system_warehouse_id = v.vendor_warehouse_id&#13;
&#13;
WHERE &#13;
(v.is_darkstore OR is_dc)&#13;
AND (v.parent_vendor_id = v.vendor_id OR is_dc)&#13;
&#13;
ORDER BY sku</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
