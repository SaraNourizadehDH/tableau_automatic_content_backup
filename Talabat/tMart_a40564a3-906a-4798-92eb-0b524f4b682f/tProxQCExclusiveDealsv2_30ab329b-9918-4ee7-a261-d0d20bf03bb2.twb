    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location id='Definitions' path='/t/Talabat/workbooks/tProxQCExclusiveDealsv2' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='3' param='horz' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone forceUpdate='true' h='98000' id='5' type-v2='text' w='98400' x='800' y='1000'>
              <formatted-text>
                <run bold='true' fontcolor='#e96b1c' fontsize='14'>Metric Definitions</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>tPro xQC Deals Customer Count</run>
                <run>
Count of customers that purchased an item from tPro Exclusive Deals 
[ Count of distinct </run>
                <run bold='true'>account_id </run>
                <run>based on timeframe / aggregation selected ]

</run>
                <run bold='true'>tPro xQC Deals Order Count</run>
                <run>&#10;Count of </run>
                <run bold='true'>order_id </run>
                <run>that had at least one tPro Exclusive Deals item in the order

</run>
                <run bold='true'>tPro xQC Deals Order Basket Value (€)</run>
                <run>&#10;Sum of </run>
                <run bold='true'>basket_value_amount_eur </run>
                <run>of </run>
                <run bold='true'>order_id(s) </run>
                <run>that had at least one tPro Exclusive Deals item in the order

</run>
                <run bold='true'>tPro xQC Deals Item Sales (€)</run>
                <run>
Total sales of tPro Exclusive Deals items to tPro Customers at discounted price

</run>
                <run bold='true'>tPro xQC Deals Quantity Sold </run>
                <run>
Total units of tPro Exclusive Deals Items sold to tPro Customers

</run>
                <run bold='true'># Unique Items on Discount</run>
                <run>&#10;Number of </run>
                <run bold='true'>unique items </run>
                <run>that were part of  tPro Exclusive Deals
[Count of distinct </run>
                <run bold='true'>item_id </run>
                <run>based on aggregated timeframe]

</run>
                <run bold='true'># Unique Items Sold</run>
                <run>&#10;Number of </run>
                <run bold='true'>unique items </run>
                <run>that were part of  tPro Exclusive Deals and purchased at least one in the selected aggregated timeframe 
[Count of distinct </run>
                <run bold='true'>item_id </run>
                <run>that had &gt;0 sold quantity based on aggregated timeframe]

</run>
                <run bold='true'>Utilization Rate (%)</run>
                <run>
[ # Unique Items Sold / # Unique Items on Discount ]

</run>
                <run bold='true'>Average Discount Availed (%)</run>
                <run>
Net discount availed on tPro Exclusive Deals Items 
[ ABS( SUM( Discounted Item Price * Sold Quantity) / SUM(Original Item Price * Sold Quantity) - 1) ]

</run>
                <run bold='true'>Frequency</run>
                <run>
[ xQC Deals Order Count  / #tPro Customers on xQC Deals ] 

</run>
                <run bold='true'>ABV (€)</run>
                <run>
[ Basket value of xQC Deals Orders / xQC Deals Order Count ]</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
