      <column caption='Spend per User (€)' datatype='real' name='[AOV (€) (copy)_986147632237178898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([xqc_customer_gmv_amount_eur]) / SUM([xqc_customer_count])' />
      </column>
      <column caption='ABV (€)' datatype='real' name='[Calculation_986147632236871696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basket_amount_eur]) / SUM([order_count])' />
      </column>
      <column caption='AOV (€)' datatype='real' name='[Calculation_986147632237031441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_amount_eur]) / SUM([order_count])' />
      </column>
      <column caption='Difference %' datatype='real' name='[Calculation_986147632239468564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM( if [is_tpro_customer] then [xqc_customer_gmv_amount_eur] end) / SUM( if [is_tpro_customer] then [xqc_customer_count] end) )&#10;&#10;/&#10;&#10;( SUM( if not [is_tpro_customer] then [xqc_customer_gmv_amount_eur] end) / SUM( if not [is_tpro_customer] then [xqc_customer_count] end) )&#10;&#10;-1' />
      </column>
      <column caption='RMA 28D - Spend (€)' datatype='real' name='[Calculation_986147632242069525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([basket_amount_eur])/SUM([customer_count]), -27, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Quantity Sold' datatype='real' name='[Calculation_986147632245354521]' role='measure' type='quantitative'>
