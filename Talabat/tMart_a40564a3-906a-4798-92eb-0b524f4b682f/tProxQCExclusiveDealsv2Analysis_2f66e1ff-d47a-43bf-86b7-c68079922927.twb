    <worksheet name='tPro x QC Item (DiD Uplift %)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[DiD] Pre-Post Item Level ' name='federated.0rt884v1ct4mth10k7wdt1s7dss5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month Date Filter' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-08-15#'>
              <calculation class='tableau' formula='#2024-08-15#' />
              <range min='#2024-06-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rt884v1ct4mth10k7wdt1s7dss5'>
            <column caption='[PRE] Quantity per User' datatype='real' name='[Calculation_1852879456362024963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pre_qty]) / COUNTD(if [pre_qty]&gt;0 then [account_id] end)' />
            </column>
            <column caption='[PRE] Customer Count' datatype='integer' name='[Calculation_1852879456363786248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [pre_qty] &gt; 0 then [account_id] end)' />
            </column>
            <column caption='[POST] Quantity Per User ' datatype='real' name='[Calculation_1852879456364986378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([during_qty]) / COUNTD(if [during_qty]&gt;0 then [account_id] end)' />
            </column>
            <column caption='[DELTA] Quantity per User' datatype='real' name='[Calculation_1852879456366796811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1852879456364986378] / [Calculation_1852879456362024963] - 1' />
            </column>
            <column caption='Non-zero filter' datatype='boolean' name='[Calculation_1852879456400277517]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1852879456363786248] = 0 then TRUE else FALSE END' />
            </column>
            <column caption='Is discounted on date' datatype='boolean' name='[Calculation_3866551441600016384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] &lt;= [campaign_end_date] and [Parameters].[Parameter 2] &gt;= [campaign_start_date]' />
            </column>
            <column caption='[POST] Customer Count' datatype='integer' name='[[POST]] tPro Customer Count (copy)_1091489644768485387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [during_qty] &gt; 0 then [account_id] end)' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Campaign Duration' datatype='integer' name='[campaign_duration]' role='dimension' type='ordinal' />
