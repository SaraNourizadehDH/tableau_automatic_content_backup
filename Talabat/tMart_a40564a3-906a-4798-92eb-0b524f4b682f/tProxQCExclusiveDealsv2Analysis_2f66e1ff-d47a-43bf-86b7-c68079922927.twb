      <column caption='[PRE] Non-tPro Customer Count' datatype='integer' name='[[PRE]] Customer Count (copy)_1091489644754665479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if not [is_tpro_customer] and [pre_qty] &gt; 0 then [account_id] end)' />
