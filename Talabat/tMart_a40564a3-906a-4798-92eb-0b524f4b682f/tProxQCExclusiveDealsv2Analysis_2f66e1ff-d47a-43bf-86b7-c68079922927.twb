      <aliases enabled='yes' />
      <column caption='[POST] tPro Quantity' datatype='integer' name='[Calculation_1091489644752048129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_tpro_customer] then [during_qty] end)' />
      </column>
      <column caption='[POST] Non-tPro Quantity' datatype='integer' name='[Calculation_1091489644753027074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if not [is_tpro_customer] then [during_qty] end)' />
      </column>
      <column caption='[PRE] tPro Quantity' datatype='integer' name='[Calculation_1091489644753199107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_tpro_customer] then [pre_qty] end)' />
      </column>
      <column caption='tPro Quantity Per User Growth (%)' datatype='real' name='[Calculation_1091489644754997256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1091489644752048129] / [Pre - tPro Customer Count (copy)_1852879456364298249])&#10;/&#10;([Calculation_1091489644753199107] / [[PRE]] Customer Count (copy)_1091489644754145285])&#10;-1' />
      </column>
      <column caption='DiD Estimated Quantity Per User Uplift (%)' datatype='real' name='[Calculation_1091489644755632138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1091489644754997256] - [tPro Quantity Per User Growth (%) (copy)_1091489644755423241]' />
      </column>
      <column caption='[PRE] tPro QPU' datatype='real' name='[Calculation_1091489644769308684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1091489644753199107] / [[PRE]] Customer Count (copy)_1091489644754145285]' />
      </column>
      <column caption='[PRE] Quantity per User' datatype='real' name='[Calculation_1852879456362024963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pre_qty]) / COUNTD(if [pre_qty]&gt;0 then [account_id] end)' />
      </column>
      <column caption='[PRE] Customer Count' datatype='integer' name='[Calculation_1852879456363786248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [pre_qty] &gt; 0 then [account_id] end)' />
      </column>
      <column caption='[POST] Quantity Per User ' datatype='real' name='[Calculation_1852879456364986378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([during_qty]) / COUNTD(if [during_qty]&gt;0 then [account_id] end)' />
      </column>
      <column caption='[DELTA] Quantity per User' datatype='real' name='[Calculation_1852879456366796811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1852879456364986378] / [Calculation_1852879456362024963] - 1' />
      </column>
      <column caption='Non-zero filter' datatype='boolean' name='[Calculation_1852879456400277517]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1852879456363786248] = 0 then TRUE else FALSE END' />
      </column>
      <column caption='Is discounted on date' datatype='boolean' name='[Calculation_3866551441600016384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] &lt;= [campaign_end_date] and [Parameters].[Parameter 2] &gt;= [campaign_start_date]' />
      </column>
      <column caption='[POST] tPro Customer Count' datatype='integer' name='[Pre - tPro Customer Count (copy)_1852879456364298249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [during_qty] &gt; 0 and [is_tpro_customer] then [account_id] end)' />
      </column>
      <column caption='[POST] Non-tPro Customer Count' datatype='integer' name='[[POST]] tPro Customer Count (copy)_1091489644754522118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if not [is_tpro_customer] and [during_qty] &gt; 0 then [account_id] end)' />
      </column>
      <column caption='[POST] Customer Count' datatype='integer' name='[[POST]] tPro Customer Count (copy)_1091489644768485387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [during_qty] &gt; 0 then [account_id] end)' />
      </column>
      <column caption='[PRE] tPro Customer Count' datatype='integer' name='[[PRE]] Customer Count (copy)_1091489644754145285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_tpro_customer] and [pre_qty] &gt; 0 then [account_id] end)' />
