      <aliases enabled='yes' />
      <column caption='ABV (€)' datatype='real' name='[Calculation_1852879454290341888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_986147631920963592])' />
      </column>
      <column caption='tPro xQC Deals Item Sales (€)' datatype='real' name='[Calculation_1852879455271317506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_tpro_customer] then [order_item_price_eur] * [sold_quantity] end)' />
      </column>
      <column caption='Quantity per User' datatype='real' name='[Calculation_986147631896526848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sold_quantity])/COUNTD([account_id])' />
      </column>
      <column caption='tPro xQC Deals Customer Count' datatype='integer' name='[Calculation_986147631897620481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( if [is_tpro_customer] then [account_id] end )' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_986147631899299842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_tpro_customer] then [order_id] end) / COUNTD(if [is_tpro_customer] then [account_id] end)' />
      </column>
      <column caption='tPro xQC Deals Order Count' datatype='integer' name='[Calculation_986147631900168195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_tpro_customer] then [order_id] end)' />
      </column>
      <column caption='# Unique Items on Discount' datatype='integer' name='[Calculation_986147631900872708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([item_id])' />
      </column>
      <column caption='# Unique Items Sold' datatype='integer' name='[Calculation_986147631901016069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [sold_quantity] &gt; 0 and [is_tpro_customer] then [item_id] end)' />
      </column>
      <column caption='Utilization Rate %' datatype='real' name='[Calculation_986147631901351942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_986147631901016069] / [Calculation_986147631900872708]' />
      </column>
      <column caption='Average Discount Availed (%)' datatype='real' name='[Calculation_986147631902445575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(&#10;(sum(if [is_tpro_customer] then [order_item_price_eur] end * if [is_tpro_customer] then [sold_quantity] end) &#10;/&#10;sum(if [is_tpro_customer] then [original_item_price_eur] end * if [is_tpro_customer] then [sold_quantity] end) &#10;)-1&#10;)' />
      </column>
      <column caption='tPro xQC Deals Basket Value (€)' datatype='real' name='[Calculation_986147631920963592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED if [is_tpro_customer] then [order_id] end: MAX(if [is_tpro_customer] then [basket_amount_eur] end)}' />
      </column>
      <column caption='AOV (€)' datatype='real' name='[Calculation_986147631921307657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_tpro_customer] then [Calculation_986147631920963592] end) / COUNTD(if [is_tpro_customer] then [order_id] end)' />
      </column>
      <column caption='# Customers' datatype='integer' name='[Calculation_986147632170643466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([account_id])' />
      </column>
      <column caption='tPro xQC Deals Quantity Sold' datatype='integer' name='[Calculation_986147632173379595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_tpro_customer] and [is_tpro_xqc_order] then [sold_quantity] end)' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_986147632221446159]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &quot;week&quot; THEN DATETRUNC(&quot;week&quot;, [date])&#10;  WHEN &quot;day&quot; THEN DATETRUNC(&quot;day&quot;, [date])&#10;  WHEN &quot;month&quot; THEN DATETRUNC(&quot;month&quot;, [date])&#10;END' />
      </column>
