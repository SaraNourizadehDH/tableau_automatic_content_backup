          </named-connection>
        </named-connections>
        <relation connection='bigquery.1ei266d1bl9t7j18e2iap1q9nzlh' name='Custom SQL Query' type='text'>with temp as(&#10;  select partition_date date&#10;  , di.category_name_level_one&#10;  , b.country&#10;  , b.shopId vendor_id&#10;  , dv.vendor_name&#10;  , di.item_id&#10;  , di.item_name_en&#10;  , di.item_name_ar&#10;  , count(distinct b.sessionId) oos_sessions&#10;  , count(distinct b.clientId) oos_clients&#10;from `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_events_talabat` b,&#10;    unnest(eventVariables) event&#10;  inner join `tlb-data-prod.data_platform.dim_chain` c&#10;    on b.chainid = cast(c.chain_id as string)&#10;  inner join `tlb-data-prod.data_platform.dim_item` di&#10;    on event.name = &apos;productSKU&apos;&#10;      and di.product_sku = event.value&#10;  inner join `tlb-data-prod.data_platform.dim_vendor_info` dv&#10;    on cast(b.shopId as int) = dv.vendor_id&#10;  where 1=1 &#10;    and b.partition_date =&apos;2025-01-01&apos; --between &apos;2025-01-01&apos; and &apos;2025-01-31&apos;&#10;    and b.eventaction in (&apos;product_impressions.loaded&apos;)&#10;    and c.vertical = &apos;grocery&apos;&#10;    and b.shoptype = &apos;darkstores&apos;&#10;    and b.screenname = &apos;vendor_search_results&apos;&#10;    --and b.country in (&apos;EG&apos;,&apos;KW&apos;)&#10;    and json_extract_scalar(eventvariables_json, &apos;$.isItemOutOfStock&apos;) = &apos;true&apos;&#10;group by all &#10;having count(distinct b.sessionId) &gt;&gt; 50&#10;), processed as(&#10;select date&#10;  , temp.category_name_level_one&#10;  , temp.country&#10;  , temp.item_id&#10;  , temp.item_name_en&#10;  , temp.item_name_ar&#10;  , temp.vendor_id&#10;  , temp.vendor_name&#10;  , oos_sessions&#10;  , oos_clients&#10;  , count(distinct foi.order_id) orders&#10;  , sum(sold_quantity) total_sold_quantity&#10;from `tlb-data-prod.data_platform.fct_order_item` foi&#10;  inner join temp&#10;    on foi.item_id = temp.item_id&#10;      and foi.country_code = temp.country&#10;      and foi.vendor_id = cast(temp.vendor_id as int)&#10;where foi.order_date = &apos;2025-01-01&apos;&#10;group by all&#10;)&#10;select *&#10;from processed&#10;order by oos_sessions*orders desc</relation>
