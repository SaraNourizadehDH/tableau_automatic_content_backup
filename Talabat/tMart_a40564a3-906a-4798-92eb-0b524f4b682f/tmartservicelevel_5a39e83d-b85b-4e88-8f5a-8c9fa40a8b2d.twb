        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0p4kpju1s5ig1c18kcpu91wx3kd3' name='Custom SQL Query' type='text'><![CDATA[with records as(
  select date(po.created_at) po_date
    , poi.product_sku
    , po.warehouse_id
  from `tlb-data-prod.data_platform.fct_purchase_order` po
  inner join `tlb-data-prod.data_platform.fct_purchase_order_item` poi
    on po.purchase_order_id = poi.purchase_order_id
      and date(poi.created_at) between current_date - interval 49 day and current_date
  where date(po.created_at) between current_date - interval 49 day and current_date
    and po.country_code = 'AE'
  group by all
),temp as(
select date_trunc(gsa.stock_date, week) week_date
  , dw.warehouse_name
  , gsa.category_name_level_one
  , gsa.category_name_level_two
  , gsa.brand_name
  , ds.supplier_name
  , gsa.sku
  , po.warehouse_id
  , poi.product_sku
  , gsa.product_name
  , gsa.country_code
  , gsa.abc_bucket
  , available_events_weightage
  , case when po.warehouse_id is not null then sum(poi.total_ordered_quantity) else null end total_ordered_quantity
  , sum(poi.total_delivered_quantity) total_delivered_quantity
from `tlb-data-prod.data_platform.agg_grocery_stock_availability_v2` gsa
  inner join records
    on records.product_sku = gsa.sku
      and records.warehouse_id = gsa.warehouse_id
      and date_diff(gsa.stock_date, records.po_date, day) between 0 and 21
  inner join `tlb-data-prod.data_platform.dim_vendor_item` dvi
    on gsa.item_id = dvi.item_id
      and dvi.is_item_active_catalogue
      and dvi.is_item_available
  inner join `tlb-data-prod.data_platform.dim_warehouse` dw
      on gsa.warehouse_id = dw.warehouse_id
        and dw.is_dmart
  inner join `tlb-data-prod.data_platform.dim_supplier` ds
      on gsa.supplier_id = ds.supplier_id
  left join `tlb-data-prod.data_platform.fct_purchase_order` po
    on po.warehouse_id = gsa.warehouse_id
      and date(po.created_at) between current_date - interval 28 day and current_date
      and po.country_code = 'AE'
      
  left join `tlb-data-prod.data_platform.fct_purchase_order_item` poi
    on po.purchase_order_id = poi.purchase_order_id
      and date(poi.created_at) between current_date - interval 28 day and current_date
      and gsa.sku = poi.product_sku
        
where 1=1
  and gsa.stock_date between current_date - interval 28 day and current_date
  and gsa.stock_date = date(po.received_at)
  and (not is_available_am and not is_available_pm and not is_available_evening and not is_available_night)
group by all
)
select *
  , case when total_ordered_quantity is null then 'No Order Placed'
  when total_delivered_quantity = 0 or total_delivered_quantity is null then '0% SL'
  when total_delivered_quantity/total_ordered_quantity >> 0 and total_delivered_quantity/total_ordered_quantity <<= 0.2 then '1% - 20% SL'
  when total_delivered_quantity/total_ordered_quantity between 0.2 and 0.5 then '21% - 50% SL'
  when total_delivered_quantity/total_ordered_quantity between 0.5 and 0.8 then '51% - 80% SL'
  when total_delivered_quantity/total_ordered_quantity >> 0.8 and total_delivered_quantity/total_ordered_quantity << 1 then '81% - 99% SL'
  when total_delivered_quantity/total_ordered_quantity = 1 then '100% SL'
  end SL_Brasket
from temp
group by all
order by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
