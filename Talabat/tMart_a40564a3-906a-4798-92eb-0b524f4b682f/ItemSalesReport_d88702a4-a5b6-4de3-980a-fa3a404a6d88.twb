      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
          <calculation class='tableau' formula='&quot;LC&quot;' />
        </column>
        <column caption='Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Units Sold&quot;'>
          <calculation class='tableau' formula='&quot;Units Sold&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4F55F949DC9D43299E05BF429F167B3E'>
            <properties context=''>
              <relation connection='bigquery.1adu89n11sjl321ba8tea048kbbr' name='Custom SQL Query' type='text'><![CDATA[WITH order_raw_data AS
  (SELECT ord.order_date,
          ord.order_id,
          country_code,
          vendor_id,
          item_id,
          sold_quantity,
          total_price_paid_net_lc,
          total_price_paid_net_eur
   FROM `tlb-data-prod.data_platform.fct_order_item` AS item
   LEFT JOIN
     (SELECT order_date,
             order_id,
             analytical_customer_id
      FROM `tlb-data-prod.data_platform.fct_order_info`
      WHERE is_successful
        AND is_darkstore
        AND DATE_TRUNC(order_date,MONTH) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE,interval -6 MONTH),MONTH)
        AND country_code <<>> 'SA'
      GROUP BY 1,
               2,
               3) AS ord ON (item.order_id = ord.order_id)
   WHERE ord.order_id IS NOT NULL
   GROUP BY 1,
            2,
            3,
            4,
            5,
            6,
            7,
            8),
     combined_data AS
  ( SELECT ord.* except(item_id, vendor_id),
                 dim_item.*,
                 CASE
                     WHEN ord.vendor_id = dim_ven.parent_vendor_id THEN ord.vendor_id
                     ELSE dim_ven.parent_vendor_id
                 END AS vendor_id,
                 dim_ven.vendor_warehouse_id warehouse_id,
                                             vendor_warehouse_name
   FROM order_raw_data AS ord
   LEFT JOIN
     (SELECT item_id,
             product_sku,
             item_name_en AS product_name,
             brand_name,
             category_name_level_one AS pim_l1,
             category_name_level_two AS pim_l2
      FROM `tlb-data-prod.data_platform.dim_item`
      GROUP BY 1,
               2,
               3,
               4,
               5,
               6 ) AS dim_item ON (ord.item_id = dim_item.item_id)
   LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dim_ven ON (ord.vendor_id = dim_ven.vendor_id))
SELECT order_date,
       country_code,
       warehouse_id,
       vendor_warehouse_name,
       product_sku,
       pim_l1, 
       pim_l2, 
       product_name, 
       brand_name, 
       sum(sold_quantity) AS units_sold,
       sum(total_price_paid_net_lc) AS net_sales_lc,
       sum(total_price_paid_net_eur) AS net_sales_eur,
       COUNT(DISTINCT order_id) AS total_orders
FROM combined_data
GROUP BY 1,
         2,
         3,
         4,
         5,
         6,
         7,
         8,
         9]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
