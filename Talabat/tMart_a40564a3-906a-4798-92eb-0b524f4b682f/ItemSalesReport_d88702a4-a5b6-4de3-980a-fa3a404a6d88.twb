                 END AS vendor_id,
                 dim_ven.vendor_warehouse_id warehouse_id,
                                             vendor_warehouse_name
   FROM order_raw_data AS ord
   LEFT JOIN
     (SELECT item_id,
             product_sku,
             item_name_en AS product_name,
             brand_name,
             category_name_level_one AS pim_l1,
             category_name_level_two AS pim_l2
      FROM `tlb-data-prod.data_platform.dim_item`
      GROUP BY 1,
               2,
               3,
               4,
               5,
               6 ) AS dim_item ON (ord.item_id = dim_item.item_id)
   LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dim_ven ON (ord.vendor_id = dim_ven.vendor_id))
SELECT order_date,
       country_code,
       warehouse_id,
       vendor_warehouse_name,
       product_sku,
       pim_l1, 
       pim_l2, 
       product_name, 
       brand_name, 
       sum(sold_quantity) AS units_sold,
       sum(total_price_paid_net_lc) AS net_sales_lc,
       sum(total_price_paid_net_eur) AS net_sales_eur,
       COUNT(DISTINCT order_id) AS total_orders
FROM combined_data
GROUP BY 1,
         2,
         3,
         4,
         5,
         6,
         7,
         8,
         9]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
