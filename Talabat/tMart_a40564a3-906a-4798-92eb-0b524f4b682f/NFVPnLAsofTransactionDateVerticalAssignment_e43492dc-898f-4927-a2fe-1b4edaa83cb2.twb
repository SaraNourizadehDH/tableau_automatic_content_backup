          </bin>
        </calculation>
      </column>
      <column caption='AVG Delivery Fee / Order' datatype='real' name='[Calculation_1912059542405144576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_504966133808910338]) / [Calculation_504966133809360901]' />
      </column>
      <column caption='Total Commission Amount % ' datatype='real' default-format='p0.00%' name='[Calculation_1912059542506737665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2365234257425330178]) / SUM([Calculation_504966133808738305])' />
      </column>
      <column caption='Last Recorded Sales Data' datatype='date' name='[Calculation_1912059542662148098]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([order_date])' />
      </column>
      <column caption='Commission (Financially Successful)' datatype='real' name='[Calculation_2365234257425104897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [commission_financially_successful_lc]&#13;&#10;WHEN 2 THEN [commission_financially_successful_eur]&#13;&#10;END' />
      </column>
      <column caption='Total Commission Amount' datatype='real' name='[Calculation_2365234257425330178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_504966133809160196] + [Calculation_2365234257425104897]' />
      </column>
      <column caption='Row ' datatype='integer' name='[Calculation_2365234257429975049]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_504966133808332800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [gmv_amount_lc] &#13;&#10;WHEN 2 THEN [gmv_amount_eur]&#13;&#10;END' />
      </column>
      <column caption='GFV / Products&apos; Sales (Inc. Tax)' datatype='real' name='[Calculation_504966133808738305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [basket_amount_lc] &#13;&#10;WHEN 2 THEN [basket_amount_eur]&#13;&#10;END' />
      </column>
      <column caption='Delivery Fees' datatype='real' name='[Calculation_504966133808910338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [delivery_fee_amount_lc]&#13;&#10;WHEN 2 THEN [delivery_fee_amount_eur]&#13;&#10;END' />
      </column>
      <column caption='Vouchers&apos; Value' datatype='real' name='[Calculation_504966133809053699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [voucher_discount_amount_lc]&#13;&#10;WHEN 2 THEN [voucher_discount_amount_eur]&#13;&#10;END' />
      </column>
      <column caption='Commission  (Successful Orders)' datatype='real' name='[Calculation_504966133809160196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]  &#13;&#10;WHEN 1 THEN [commission_sucessful_orders_lc]&#13;&#10;WHEN 2 THEN [commission_sucessful_orders_eur]&#13;&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_504966133809360901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_504966133809434630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_504966133808738305]) / [Calculation_504966133809360901]' />
      </column>
      <column caption='Calc - Filter' datatype='boolean' name='[Calculation_504966133811974155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] &lt;= [Parameters].[Final - Start Date (copy)_504966133811781641]&#13;&#10;AND [order_date] &gt;= [Parameters].[Input - Start Date (copy)_504966133811707912]' />
      </column>
      <column caption='Apply Button' datatype='string' name='[Calculation_504966133812264972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Apply&apos;' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_BCD3D23955E346858039F7066C245713]' role='measure' type='quantitative' />
      <column caption='Country' datatype='string' name='[country_Code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
