        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1l8tmio16ys28p13z0zug1dlaibn' name='Custom SQL Query' type='text'><![CDATA[SELECT 
oi.order_date,
oi.country_Code,
oi.order_id AS all_orders,
oi.is_successful,
delivery_arrangement,
CASE WHEN oi.is_successful THEN oi.order_id ELSE NULL END AS order_id,
CASE WHEN oi.is_successful THEN oi.gmv_amount_lc ELSE 0 END AS gmv_amount_lc,
CASE WHEN oi.is_successful THEN oi.gmv_amount_eur ELSE 0 END AS gmv_amount_eur,
CASE WHEN oi.is_successful THEN oi.basket_amount_lc ELSE 0 END AS basket_amount_lc,
CASE WHEN oi.is_successful THEN oi.basket_amount_eur ELSE 0 END AS basket_amount_eur,
CASE WHEN oi.is_successful THEN oi.delivery_fee_amount_lc ELSE 0 END AS delivery_fee_amount_lc,
CASE WHEN oi.is_successful THEN oi.delivery_fee_amount_eur ELSE 0 END AS delivery_fee_amount_eur,
CASE WHEN oi.is_successful THEN oi.voucher_discount_amount_lc ELSE 0 END AS voucher_discount_amount_lc,
CASE WHEN oi.is_successful THEN oi.voucher_discount_amount_eur ELSE 0 END AS voucher_discount_amount_eur,
CASE WHEN oi.is_successful THEN commission_amount_lc ELSE 0 END AS commission_sucessful_orders_lc,
CASE WHEN oi.is_successful THEN commission_amount_eur ELSE 0 END AS commission_sucessful_orders_eur,
CASE WHEN oi.is_successful = false THEN commission_amount_lc ELSE 0 END AS commission_financially_successful_lc,
CASE WHEN oi.is_successful = false THEN commission_amount_eur ELSE 0 END AS commission_financially_successful_eur,
dv.vertical,
dv.sub_vertical,
chain_name

 FROM `tlb-data-prod.data_platform.fct_order_info` oi

 LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  v.source_system_vendor_id = oi.vendor_source_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id


LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` dv
ON oi.vertical_id = dv.vertical_id

LEFT Join `tlb-data-prod.data_platform.fct_billing` b
ON b.order_id = oi.order_id
AND oi.country_id = b.country_id


WHERE
dv.vertical<<>>'food' 
AND (dv.sub_vertical='marketplace' OR dv.sub_vertical = 'N/A' )
AND dv.vertical <<>> 'N/A'
AND oi.order_date >>= <[Parameters].[Parameter 2]>
AND oi.order_date <<= <[Parameters].[Input - Start Date (copy)_504966133811855370]>]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1l8tmio16ys28p13z0zug1dlaibn' name='Custom SQL Query' type='text'><![CDATA[SELECT 
oi.order_date,
oi.country_Code,
oi.order_id AS all_orders,
oi.is_successful,
delivery_arrangement,
CASE WHEN oi.is_successful THEN oi.order_id ELSE NULL END AS order_id,
CASE WHEN oi.is_successful THEN oi.gmv_amount_lc ELSE 0 END AS gmv_amount_lc,
CASE WHEN oi.is_successful THEN oi.gmv_amount_eur ELSE 0 END AS gmv_amount_eur,
CASE WHEN oi.is_successful THEN oi.basket_amount_lc ELSE 0 END AS basket_amount_lc,
CASE WHEN oi.is_successful THEN oi.basket_amount_eur ELSE 0 END AS basket_amount_eur,
CASE WHEN oi.is_successful THEN oi.delivery_fee_amount_lc ELSE 0 END AS delivery_fee_amount_lc,
CASE WHEN oi.is_successful THEN oi.delivery_fee_amount_eur ELSE 0 END AS delivery_fee_amount_eur,
CASE WHEN oi.is_successful THEN oi.voucher_discount_amount_lc ELSE 0 END AS voucher_discount_amount_lc,
CASE WHEN oi.is_successful THEN oi.voucher_discount_amount_eur ELSE 0 END AS voucher_discount_amount_eur,
CASE WHEN oi.is_successful THEN commission_amount_lc ELSE 0 END AS commission_sucessful_orders_lc,
CASE WHEN oi.is_successful THEN commission_amount_eur ELSE 0 END AS commission_sucessful_orders_eur,
CASE WHEN oi.is_successful = false THEN commission_amount_lc ELSE 0 END AS commission_financially_successful_lc,
CASE WHEN oi.is_successful = false THEN commission_amount_eur ELSE 0 END AS commission_financially_successful_eur,
dv.vertical,
dv.sub_vertical,
chain_name

 FROM `tlb-data-prod.data_platform.fct_order_info` oi

 LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  v.source_system_vendor_id = oi.vendor_source_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id


LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` dv
ON oi.vertical_id = dv.vertical_id

LEFT Join `tlb-data-prod.data_platform.fct_billing` b
ON b.order_id = oi.order_id
AND oi.country_id = b.country_id


WHERE
dv.vertical<<>>'food' 
AND (dv.sub_vertical='marketplace' OR dv.sub_vertical = 'N/A' )
AND dv.vertical <<>> 'N/A'
AND oi.order_date >>= <[Parameters].[Parameter 2]>
AND oi.order_date <<= <[Parameters].[Input - Start Date (copy)_504966133811855370]>]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
