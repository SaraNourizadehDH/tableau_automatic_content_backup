            <connection CATALOG='bta---talabat' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='BTA - Talabat' schema='data_platform' server-oauth='' username='eyad.elkhateeb@talabat.com' workgroup-auth-mode='prompt' />
