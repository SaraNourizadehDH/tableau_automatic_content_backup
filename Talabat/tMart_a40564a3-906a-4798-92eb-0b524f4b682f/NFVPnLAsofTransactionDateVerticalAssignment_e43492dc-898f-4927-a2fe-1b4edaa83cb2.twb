    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location id='Definitions' path='/t/Talabat/workbooks/NFVPnLAsofTransactionDateVerticalAssignment' revision='' site='Talabat' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone forceUpdate='true' h='66875' id='3' type-v2='text' w='99600' x='400' y='2375'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' underline='true'>GMV &amp; GFV:</run>
            <run>Æ&#10;</run>
            <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/WAL/Other+documents?preview=%2F358104228%2F358104233%2FGMV+definition+v4.00.pdf&amp;quot;'>https://confluence.deliveryhero.com/display/WAL/Other+documents?preview=%2F358104228%2F358104233%2FGMV+definition+v4.00.pdf</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>Commission (Successful Orders):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Commission value of the successful orders</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>Commission (Financially Successful):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Commission value of orders which were failed but have a commission charged</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>Total commission amount :</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Commission (Successful Orders) +</run>
            <run bold='true' fontcolor='#000000'> Commission (Financially Successful)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>Total commission amount %:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Total commission amount / GFV</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>Delivery Fees Exc. VAT:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Delivery fee exc. VAT. is manually calculated as per the below table since there is no field in the data source of this dashboard that represents the VAT amount</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>EG = 14%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>SA = 15%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>AE = 5%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>JO = 16%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Any other country = 0%</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000'>Note: please reach out to </run>
            <run fontcolor='#4e79a7' underline='true'>eyad.elkhateeb@talabat.com</run>
            <run fontcolor='#000000' underline='true'>Æ </run>
            <run fontcolor='#000000'>incase there are any adjustments required for the VAT</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>ABV (Average Basket Value):</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>sum of GFV / successful orders</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' underline='true'>AVG delivery fee / order:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>sum of delivery fees / successful orders</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#f5eddc' />
          </zone-style>
        </zone>
      </zones>
