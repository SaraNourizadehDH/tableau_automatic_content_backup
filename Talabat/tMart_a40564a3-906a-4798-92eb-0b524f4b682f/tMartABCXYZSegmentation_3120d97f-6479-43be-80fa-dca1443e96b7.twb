      <aliases enabled='yes' />
      <column caption='PIM Level 2 Sales' datatype='integer' name='[Calculation_715790898770726913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[pim_level_two], [country_code]: SUM([units_sold])}' />
      </column>
      <column caption='Share of Sales (%)' datatype='real' name='[Calculation_715790898770857986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([running_total])/SUM([Calculation_715790898770726913])' />
      </column>
      <column caption='ABC bucketing' datatype='string' name='[Calculation_715790899528450052]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_715790898770857986] &lt; 0.7 THEN &apos;A&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_715790898770857986] &lt; 0.9 THEN &apos;B&apos; &#13;&#10;&#13;&#10;ELSE &apos;C&apos; &#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_715790900105879557]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SKU Count' datatype='integer' name='[Calculation_974466406003249152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(str([skus]) + &quot;&amp;&quot; + [warehouse_name])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_C516C98C1B2D4F32A72329737C146894]' role='measure' type='quantitative' />
      <column caption='ABC' datatype='string' name='[abc_bucketing]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='PIM L1' datatype='string' name='[pim_level_one]' role='dimension' type='nominal' />
      <column caption='PIM L2' datatype='string' name='[pim_level_two]' role='dimension' type='nominal' />
      <column caption='SKU' datatype='string' name='[skus]' role='dimension' type='nominal' />
