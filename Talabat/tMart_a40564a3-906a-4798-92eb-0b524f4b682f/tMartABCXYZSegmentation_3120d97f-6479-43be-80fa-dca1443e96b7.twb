   FROM product_masterset AS prod
   LEFT JOIN sales_data AS sales ON (prod.skus = sales.product_sku)
   AND (prod.country_code = sales.country_code)
   AND (prod.warehouse_id = sales.warehouse_id)
   WHERE pim_level_one IS NOT NULL
   GROUP BY 1,
            2,
