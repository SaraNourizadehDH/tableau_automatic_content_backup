   WHERE store_type = 'darkstores'
     AND lower(avail.brand_name) <<>> 'comboproduct brand'
     AND stock_date >>= DATE_ADD(CURRENT_DATE,interval -180 DAY)
     AND avail.country_code <<>> 'SA'
     AND status IN ('ACTIVE',
                    'BLOCKED',
                    'ON_HOLD')
     AND NOT is_stale_day)
SELECT warehouse_name,
       country_code,
       sku,
       avg(availability_perc) AS availability
FROM availability_raw_data
WHERE is_used_calc = 'Y'
GROUP BY 1,
