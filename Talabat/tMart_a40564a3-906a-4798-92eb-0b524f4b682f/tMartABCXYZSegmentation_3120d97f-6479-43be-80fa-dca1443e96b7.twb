                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14'>Definitions: </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='14' italic='true'>All definitions are based on the previous 90 days of sales</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>ABC: </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>A: Items Contributing to 0-80% of the total L2 category sales volume.</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>B: Items contributing to 81-95% of the total L2 category sales volume. </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>C: Items contributing to 96-100%  of the total L2 category sales volume.</run>
                      <run fontalignment='1' fontcolor='#000000'>Æ </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>XYZ: </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>Coefficient of Variance: standard deviation of daily unit sales/average daily sales. </run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'><![CDATA[X: Coefficient of Variance < 40%]]></run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>Y: Coefficient of Variace between 40% and 80%</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#000000' fontsize='10'>Z: Coefficient of Variance &gt; 80%</run>
                    </formatted-text>
