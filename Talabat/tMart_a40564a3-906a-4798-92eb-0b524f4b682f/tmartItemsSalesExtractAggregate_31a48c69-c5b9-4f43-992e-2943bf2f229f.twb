SUM(order_item_price_lc * sold_quantity) AS total_price_paid_lc,
SUM(total_price_paid_net_lc) AS total_price_paid_net_lc,
SUM(cogs_lc) AS cogs_lc,
SUM(CASE WHEN item_discount_lc >> 0 THEN order_item_price_lc * sold_quantity ELSE 0 END) AS promo_sales_lc,
SUM(CASE WHEN item_discount_lc >> 0 THEN total_price_paid_net_lc ELSE 0 END) AS net_promo_sales_lc,
SUM(CASE WHEN item_discount_lc >> 0 THEN cogs_lc * sold_quantity ELSE 0 END) AS promo_cogs_lc,
