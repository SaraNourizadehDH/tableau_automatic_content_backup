      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontcolor='#666666' fontname='Tableau Light' fontsize='15'>Competitor Vendor and Area Data Availability</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>This report is limited to specific platforms only.
Percentage represents number of delivery areas observed over baseline.
Green indicator (color) signifies the data unavailability is within acceptable limits
Yellow indicator (color) signifies the data unavailability is slightly beyond the threshold
Red indicator (color) signifies the data unavailability is significantly above the threshold</run>
          </formatted-text>
        </caption>
      </layout-options>
