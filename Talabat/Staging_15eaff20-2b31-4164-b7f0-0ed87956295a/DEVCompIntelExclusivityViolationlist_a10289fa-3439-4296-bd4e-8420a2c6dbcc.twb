          <named-connection caption='BigQuery' name='bigquery.0o6noqg1nmey821apqm0f1yj0e6g'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='soujanya.nandala@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0o6noqg1nmey821apqm0f1yj0e6g' name='Custom SQL Query' type='text'><![CDATA[with comp_details as
(
select scrape_date, competitor_platform, vendor_id, competitor_vendor_id, competitor_vendor_name, country_name, city_name,
max(is_competitor_vendor_available) as is_competitor_vendor_available
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where vendor_distance_between_competitor_talabat/1000 <<= 0.4
and scrape_date >>= current_date - 8
and scrape_date <<= current_date - 1
  group by 1,2,3,4,5,6,7
  ),

  metric_30days as
  ( 
    select 
vendor_id, 
sum(successful_order_count) as vendor_order_last_30, sum(gmv_value_sum) as vendor_gmv_amount_lc_last_30, sum(gmv_value_sum_eur) as vendor_gmv_amount_eur_last_30 from (
select vendor_id,
date, agg_vendor_performance_summarised_daily.successful_order_count as successful_order_count, agg_vendor_performance_summarised_daily.gmv_value_sum, agg_vendor_performance_summarised_daily.gmv_value_sum_eur
from
`tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily` agg_vendor_performance_summarised_daily

where date >>= current_date - 31
and date <<= current_date - 1
group by 1,2,3,4,5)
group by 1),

excl_comp_details as
(
select scrape_date, vendor_id
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where vendor_distance_between_competitor_talabat/1000 <<= 0.4
and competitor_platform is not null
  group by 1,2
  ),

exclusivity_changes as (
SELECT vendor_id, is_exclusive, valid_from, valid_to, is_commission_rate_changed, commission_rate
FROM `tlb-data-prod.data_platform.dim_vendor_history` 
-- WHERE is_exclusive
group by 1,2,3,4,5,6
)

select * from (
  select comp_details.*, account_manager_name, is_exclusive , is_key_vip_account, is_tgo, vendor_name, vendor_order_last_30, vendor_gmv_amount_lc_last_30, vendor_gmv_amount_eur_last_30, first_exclusivity_breach_date, latest_commission_updated_date, latest_commission_rate
  from comp_details
  left join `tlb-data-prod.data_platform.agg_comp_intel_vendor_daily` vendors
  USING (scrape_date, competitor_platform, vendor_id)
  left join metric_30days
  on comp_details.vendor_id = cast(metric_30days.vendor_id as int)
  left join 
  (select excl_comp_details.vendor_id, min(valid_from) as first_exclusivity_breach_date
    from excl_comp_details
    join exclusivity_changes
    on excl_comp_details.vendor_id = exclusivity_changes.vendor_id
    and scrape_date between valid_from and valid_to
    and is_exclusive
    group by 1
    -- QUALIFY RANK() OVER (PARTITION BY excl_comp_details.vendor_id ORDER BY valid_from) = 1
    ) exclusivity_breach
  on comp_details.vendor_id = exclusivity_breach.vendor_id
  left join 
  (select vendor_id, valid_from as latest_commission_updated_date, commission_rate as latest_commission_rate
    from exclusivity_changes
    where is_commission_rate_changed
    QUALIFY RANK() OVER (PARTITION BY vendor_id ORDER BY valid_from desc) = 1
    ) commission
    on comp_details.vendor_id = commission.vendor_id
    )
  -- where vendor_id = 15737
  -- where latest_commission_updated_date is not null
  -- limit 10]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0o6noqg1nmey821apqm0f1yj0e6g' name='Custom SQL Query' type='text'><![CDATA[with comp_details as
(
select scrape_date, competitor_platform, vendor_id, competitor_vendor_id, competitor_vendor_name, country_name, city_name,
max(is_competitor_vendor_available) as is_competitor_vendor_available
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where vendor_distance_between_competitor_talabat/1000 <<= 0.4
and scrape_date >>= current_date - 8
and scrape_date <<= current_date - 1
  group by 1,2,3,4,5,6,7
  ),

  metric_30days as
  ( 
    select 
vendor_id, 
sum(successful_order_count) as vendor_order_last_30, sum(gmv_value_sum) as vendor_gmv_amount_lc_last_30, sum(gmv_value_sum_eur) as vendor_gmv_amount_eur_last_30 from (
select vendor_id,
date, agg_vendor_performance_summarised_daily.successful_order_count as successful_order_count, agg_vendor_performance_summarised_daily.gmv_value_sum, agg_vendor_performance_summarised_daily.gmv_value_sum_eur
from
`tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily` agg_vendor_performance_summarised_daily

where date >>= current_date - 31
and date <<= current_date - 1
group by 1,2,3,4,5)
group by 1),

excl_comp_details as
(
select scrape_date, vendor_id
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where vendor_distance_between_competitor_talabat/1000 <<= 0.4
and competitor_platform is not null
  group by 1,2
  ),

exclusivity_changes as (
SELECT vendor_id, is_exclusive, valid_from, valid_to, is_commission_rate_changed, commission_rate
FROM `tlb-data-prod.data_platform.dim_vendor_history` 
-- WHERE is_exclusive
group by 1,2,3,4,5,6
)

select * from (
  select comp_details.*, account_manager_name, is_exclusive , is_key_vip_account, is_tgo, vendor_name, vendor_order_last_30, vendor_gmv_amount_lc_last_30, vendor_gmv_amount_eur_last_30, first_exclusivity_breach_date, latest_commission_updated_date, latest_commission_rate
  from comp_details
  left join `tlb-data-prod.data_platform.agg_comp_intel_vendor_daily` vendors
  USING (scrape_date, competitor_platform, vendor_id)
  left join metric_30days
  on comp_details.vendor_id = cast(metric_30days.vendor_id as int)
  left join 
  (select excl_comp_details.vendor_id, min(valid_from) as first_exclusivity_breach_date
    from excl_comp_details
    join exclusivity_changes
    on excl_comp_details.vendor_id = exclusivity_changes.vendor_id
    and scrape_date between valid_from and valid_to
    and is_exclusive
    group by 1
    -- QUALIFY RANK() OVER (PARTITION BY excl_comp_details.vendor_id ORDER BY valid_from) = 1
    ) exclusivity_breach
  on comp_details.vendor_id = exclusivity_breach.vendor_id
  left join 
  (select vendor_id, valid_from as latest_commission_updated_date, commission_rate as latest_commission_rate
    from exclusivity_changes
    where is_commission_rate_changed
    QUALIFY RANK() OVER (PARTITION BY vendor_id ORDER BY valid_from desc) = 1
    ) commission
    on comp_details.vendor_id = commission.vendor_id
    )
  -- where vendor_id = 15737
  -- where latest_commission_updated_date is not null
  -- limit 10]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
