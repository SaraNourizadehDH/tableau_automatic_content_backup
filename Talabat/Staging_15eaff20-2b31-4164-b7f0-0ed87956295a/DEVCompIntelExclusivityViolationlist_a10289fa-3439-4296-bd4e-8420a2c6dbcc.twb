        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rafcir0r6y0t31ces8i20g3anym' name='Custom SQL Query' type='text'><![CDATA[with comp_details as
(
select scrape_date, competitor_platform, vendor_id, competitor_vendor_id, competitor_vendor_name, 
country_name, city_name,
max(is_competitor_vendor_available) as is_competitor_vendor_available
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where scrape_date >>= '2023-01-01'
and vendor_distance_between_competitor_talabat/1000 <<= 0.4
and country_name not in ('Egypt', 'Qatar')
  group by 1,2,3,4,5,6,7
  )

  select comp_details.*, is_exclusive, is_key_vip_account, avg_vendor_distance_between_competitor_talabat, 
  from comp_details
  left join `tlb-data-prod.data_platform.agg_comp_intel_vendor_daily` vendors
  USING (scrape_date, competitor_platform, vendor_id)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1rafcir0r6y0t31ces8i20g3anym' name='Custom SQL Query' type='text'><![CDATA[with comp_details as
(
select scrape_date, competitor_platform, vendor_id, competitor_vendor_id, competitor_vendor_name, 
country_name, city_name,
max(is_competitor_vendor_available) as is_competitor_vendor_available
from
  `tlb-data-prod.data_platform.agg_comp_intel_vendor_delivery_area_daily`
  where scrape_date >>= '2023-01-01'
and vendor_distance_between_competitor_talabat/1000 <<= 0.4
and country_name not in ('Egypt', 'Qatar')
  group by 1,2,3,4,5,6,7
  )

  select comp_details.*, is_exclusive, is_key_vip_account, avg_vendor_distance_between_competitor_talabat, 
  from comp_details
  left join `tlb-data-prod.data_platform.agg_comp_intel_vendor_daily` vendors
  USING (scrape_date, competitor_platform, vendor_id)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
