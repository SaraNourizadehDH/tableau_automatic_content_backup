      <aliases enabled='yes' />
      <column caption='Total vendors' datatype='integer' default-format='N' name='[Calculation_212584035751034880]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='row number2' datatype='integer' name='[Calculation_261912466331103232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Exclusivity violated vendors' datatype='integer' name='[Calculation_3341248771286749185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#10;  IF [is_exclusive] THEN&#10;[vendor_id]&#10;    &#10;&#10;  END&#10;&#10;)' />
      </column>
      <column caption='% Exclusive vendors' datatype='real' default-format='p0%' name='[Calculation_3341248771302305794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3341248771286749185]/[Calculation_212584035751034880]' />
      </column>
      <column caption='row number' datatype='integer' hidden='true' name='[Calculation_4344918169587421184]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders (30 days)' datatype='integer' hidden='true' name='[Calculation_4344918169592455170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_4344918169593778179] THEN [vendor_order_count] ELSE 0 END)' />
      </column>
      <column caption='Last 30' datatype='boolean' hidden='true' name='[Calculation_4344918169593778179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[scrape_date],TODAY()) &lt;= 30 AND [scrape_date] &lt;= TODAY()' />
      </column>
      <column caption='Selected trend' datatype='datetime' name='[Calculation_5254997143426494464]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;Week&apos; then DATETRUNC(&apos;week&apos;, [scrape_date], &apos;monday&apos;)&#10;when &apos;Month&apos; then DATETRUNC(&apos;month&apos;, [scrape_date])&#10;END' />
      </column>
      <column caption='Date Filter by Parameter' datatype='boolean' name='[Calculation_5254997143426953217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Week&quot; THEN &#10;    IF DATEDIFF(&apos;week&apos;, [scrape_date], TODAY()) &lt;= 11 THEN TRUE ELSE FALSE END&#10;WHEN &quot;Month&quot; THEN &#10;    IF DATEDIFF(&apos;month&apos;, [scrape_date], TODAY()) &lt;= 11 THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column caption='Period End Date' datatype='boolean' name='[Calculation_5254997143427158018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 2] = &apos;Week&apos;) and ([scrape_date] = ({Fixed DATETRUNC(&apos;week&apos;, [scrape_date], &apos;monday&apos;) : Max([scrape_date])}))&#10;THEN TRUE&#10;ELSEIF ([Parameters].[Parameter 2] = &apos;Month&apos;) and ([scrape_date] = ({Fixed DATETRUNC(&apos;month&apos;, [scrape_date]) : Max([scrape_date])}))&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='Monday' datatype='datetime' name='[Calculation_5254997143610171395]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [scrape_date], &apos;monday&apos;)' />
      </column>
