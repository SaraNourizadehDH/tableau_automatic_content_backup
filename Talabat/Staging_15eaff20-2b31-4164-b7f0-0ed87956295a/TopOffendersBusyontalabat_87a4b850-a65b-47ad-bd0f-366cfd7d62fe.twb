        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0klwm221vxnbr115v3c490yb59h9' name='Custom SQL Query' type='text'><![CDATA[--Hitlist
WITH vendor_busy_events AS (
select
-- schedule_date,
vendor_id, vendor_name,  
account_manager_name,
team_leader_name,
string_agg(distinct trigger_reason) as unavailability_reason,
sum(event_difference_minutes) AS vendor_closing_minutes
 from (
SELECT 
schedule_date,
e.vendor_id, vendor_name, 
vendor.account_manager_name,
team_leader_name,
gsr.trigger_reason,
event_start_timestamp, event_end_timestamp,
TIMESTAMP_DIFF(event_end_timestamp, event_start_timestamp, MINUTE) AS event_difference_minutes,
-- sum(event_end_timestamp - event_start_timestamp),

FROM `tlb-data-prod.data_platform.fct_vendor_schedule_unavailability_event` e
Left join `tlb-data-prod.data_platform.dim_unavailability_event_reason` r 
  on e.event_reason_id=r.unavailability_event_reason_id
Left join `tlb-data-prod.data_platform.dim_unavailability_event_source` s 
  on e.event_source_id = s.unavailability_event_source_id
Left join `tlb-data-prod.data_platform_google_sheet.talabat_vendor_busy_mapped_reasons` gsr
  on trim(gsr.author_service) = trim(s.unavailability_event_source)
  and gsr.trigger_reason = r.unavailability_event_reason
inner join `tlb-data-prod.data_platform.fct_cwatch_vendor_list_parity` parity
  on CAST(e.vendor_id AS INT64) = parity.vendor_id
  and e.schedule_date = parity.scrape_date
  and parity.scrape_time between e.event_start_timestamp and e.event_end_timestamp
JOIN `tlb-data-prod.data_platform.dim_cwatch_competitor_vendor`
  USING (competitor_vendor_id) 
JOIN `tlb-data-prod.data_platform.dim_vendor_info` vendor
  on parity.vendor_id = vendor.vendor_id

WHERE EXTRACT(YEAR FROM schedule_date) = EXTRACT(YEAR FROM CURRENT_DATE())
  AND EXTRACT(MONTH FROM schedule_date) = EXTRACT(MONTH FROM CURRENT_DATE())
and e.country_code = 'AE'
and entity_id = 'TB_AE'
and is_offline
and schedule_duration_in_seconds <<>> 0
and is_same_branch
and is_competitor_vendor_available
and not(is_vendor_available)
and gsr.talabat_author in ('Vendor Monitor','Vendor')
-- and e.vendor_id = '41031'
group by 1,2,3,4,5,6,7,8)
group by 1,2,3,4
),

vendor_schedules AS (
select 
-- schedule_date,
vendor_id, 
sum(schedule_difference_minutes) AS vendor_schedule_minutes
 from (
SELECT 
schedule_date,
e.vendor_id,
schedule_start_timestamp, schedule_end_timestamp, 
TIMESTAMP_DIFF(schedule_end_timestamp, schedule_start_timestamp, MINUTE) AS schedule_difference_minutes,

FROM `tlb-data-prod.data_platform.fct_vendor_schedule_unavailability_event` e

WHERE EXTRACT(YEAR FROM schedule_date) = EXTRACT(YEAR FROM CURRENT_DATE())
  AND EXTRACT(MONTH FROM schedule_date) = EXTRACT(MONTH FROM CURRENT_DATE())
and e.country_code = 'AE'
and entity_id = 'TB_AE'
and schedule_duration_in_seconds <<>> 0
-- and e.vendor_id = '41031'
group by 1,2,3,4,5)
group by 1
),

-- CTE to fetch the aggregated performance metrics of vendors over the last 30 days
vendor_gmv AS (
    SELECT 
        vendor_id, 
        SUM(gmv_value_sum_eur) AS vendor_gmv_amount_eur_this_month
    FROM `tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily`
    WHERE EXTRACT(YEAR FROM date) = EXTRACT(YEAR FROM CURRENT_DATE())
    AND EXTRACT(MONTH FROM date) = EXTRACT(MONTH FROM CURRENT_DATE())
    GROUP BY vendor_id
)

-- level - schedule_date, vendor_id

select 
-- schedule_date,
vendor_schedules.vendor_id, vendor_name,  
account_manager_name,
team_leader_name,
unavailability_reason,
vendor_schedule_minutes,
vendor_closing_minutes,
vendor_gmv_amount_eur_this_month
 from vendor_busy_events
 left join vendor_schedules
 USING (vendor_id)
  LEFT JOIN vendor_gmv 
  USING (vendor_id)
-- group by 1,2,3
-- having count(*) >> 1
order by vendor_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
