              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahbdt207dgahe10sdodv16jokdo'>
            <column caption='Selected trend' datatype='datetime' datatype-customized='true' name='[Calculation_3457779414918975488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 13]&#10;when &apos;Week&apos; then DATETRUNC(&apos;week&apos;, [reporting_date], &apos;monday&apos;)&#10;when &apos;Month&apos; then DATETRUNC(&apos;month&apos;, [reporting_date])&#10;END' />
            </column>
            <column caption='Platform' datatype='boolean' name='[Calculation_3954160483138367488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = [competitor_platform] THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Date Filter by Parameter' datatype='boolean' name='[Calculation_539657911675756544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#10;WHEN &quot;Week&quot; THEN &#10;    IF DATEDIFF(&apos;week&apos;, [reporting_date], TODAY()) &lt;= 12 THEN TRUE ELSE FALSE END&#10;WHEN &quot;Month&quot; THEN &#10;    IF DATEDIFF(&apos;month&apos;, [reporting_date], TODAY()) &lt;= 12 THEN TRUE ELSE FALSE END&#10;END' />
            </column>
            <column caption='Period End Date' datatype='boolean' name='[Calculation_6852226897261010944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 13] = &apos;Week&apos;) and ([reporting_date] = ({Fixed DATETRUNC(&apos;week&apos;, [reporting_date], &apos;monday&apos;) : Min([reporting_date])}))&#10;THEN TRUE&#10;ELSEIF ([Parameters].[Parameter 13] = &apos;Month&apos;) and ([reporting_date] = ({Fixed DATETRUNC(&apos;month&apos;, [reporting_date]) : Min([reporting_date])}))&#10;THEN TRUE&#10;END' />
            </column>
