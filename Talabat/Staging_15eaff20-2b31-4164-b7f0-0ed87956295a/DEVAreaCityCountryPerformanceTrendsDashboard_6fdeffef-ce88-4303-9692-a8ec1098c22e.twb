      <column caption='Indicator Price Parity' datatype='string' name='[Indicator Fee matched (copy)_4051902670224207873]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([talabat_price_more_affordable]) &gt; SUM([competitor_price_more_affordable]) Then &quot;Green&quot;&#10;&#10;ELSEIF SUM([talabat_price_more_affordable]) &gt; SUM([competitor_price_more_affordable]) Then &quot;Red&quot;&#10;&#10;ELSE &quot;Yellow&quot;&#10;&#10;END' />
