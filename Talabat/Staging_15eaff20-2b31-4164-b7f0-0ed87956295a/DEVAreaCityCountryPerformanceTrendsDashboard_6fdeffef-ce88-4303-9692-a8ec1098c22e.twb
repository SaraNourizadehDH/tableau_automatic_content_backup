          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select trend' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column alias='Careem' caption='Platform Param' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;careem&quot;'>
              <calculation class='tableau' formula='&quot;careem&quot;' />
              <aliases>
                <alias key='&quot;ahlan&quot;' value='Ahlan' />
                <alias key='&quot;careem&quot;' value='Careem' />
                <alias key='&quot;deliveroo&quot;' value='Deliveroo' />
