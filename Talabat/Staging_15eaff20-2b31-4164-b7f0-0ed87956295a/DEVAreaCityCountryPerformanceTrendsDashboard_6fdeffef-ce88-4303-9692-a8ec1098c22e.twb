            <properties context=''>
              <relation connection='bigquery.1gb5nir1sg09hj1eckha21kzyv59' name='Custom SQL Query' type='text'>SELECT 
reporting_date, 
competitor_platform, 
delivery_area_name,
delivery_city_name AS vendor_city_name, 
delivery_country_name AS vendor_country_name, 
matched_vendor_count AS matched_vendors,
competitor_vendor_count AS competitor_vendors, 
competitor_delivery_eta_avg AS avg_competitor_eta, 
competitor_matched_vendor_delivery_eta_avg AS avg_competitor_eta_where_matched, 
competitor_delivery_fee_lc_avg AS avg_competitor_fee_lc, 
competitor_matched_vendor_delivery_fee_lc_avg AS avg_competitor_fee_lc_where_matched, 
talabat_vendor_count AS count_talabat_vendor, 
talabat_delivery_eta_avg AS avg_talabat_eta, 
talabat_matched_vendor_delivery_eta_avg AS avg_talabat_eta_where_matched, 
talabat_delivery_fee_lc_avg AS avg_talabat_fee_lc, 
talabat_matched_vendor_delivery_fee_lc_avg AS avg_talabat_fee_lc_where_matched, 
talabat_lower_promotion_matched_vendor_count AS count_competitor_promo_more_affordable, 
talabat_higher_promotion_matched_vendor_count AS count_talabat_promo_more_affordable, 
less_affordable_vendor_count AS count_competitor_price_more_affordable, 
more_affordable_vendor_count AS count_talabat_price_more_affordable, 
talabat_area_max_vendor_distance_meter_avg AS avg_max_talabat_vendor_distance_kilometers, 
talabat_overlapping_area_max_vendor_distance_meter_avg AS avg_max_talabat_vendor_distance_kilometers_where_matched, 
competitor_area_max_vendor_distance_meter_avg AS avg_max_competitor_vendor_distance_kilometers, 
competitor_overalpping_area_max_vendor_distance_meter_avg AS avg_max_competitor_vendor_distance_kilometers_where_matched, 
order_count AS orders_count
FROM `tlb-data-prod.data_platform.agg_comp_intel_delivery_area_daily` 
WHERE reporting_date &gt;&gt;= &apos;2023-01-01&apos;
-- AND delivery_area_name = &apos;All&apos;
-- AND vendor_country_name != &apos;KSA&apos;</relation>
            </properties>
          </object>
        </objects>
