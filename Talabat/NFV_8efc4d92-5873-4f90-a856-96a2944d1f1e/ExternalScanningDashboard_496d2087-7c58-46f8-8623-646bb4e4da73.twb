              <calculation class='tableau' formula='[AVG Daily Enabled [Scan]] (copy)_1146025402323136522]/[sd_scanned_barcode_scanning_date (copy)_1146025402324602893]' />
            </column>
            <column caption='% Enabled + Not Active [Scan]' datatype='real' default-format='p0.00%' name='[% Enabled [Scan]] (copy)_1146025402357534769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Not Enabled + Active [F30D]] (copy)_1146025402356863020]/[sd_scanned_barcode_scanning_date (copy)_1146025402324602893]' />
            </column>
            <column caption='% Not Enabled + PIM' datatype='real' default-format='p0.00%' name='[% Not Enabled + PIM [Current]] (copy)_1146025402327539733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [% Not Enabled + PIM [F30D]] (copy)_1146025402326183955]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [% Enabled [Current]] (copy)_1146025402325774353]&#10;ELSE [% Enabled [F30D]] (copy)_1146025402326007826]&#10;END' />
            </column>
            <column caption='% Not Enabled + PIM [Scan]' datatype='real' default-format='p0.00%' name='[% Not Enabled + PIM [F30D]] (copy)_1146025402326183955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sd_not_enabled_pim_as_of_scanning_date (copy)_1146025402325606416]/[sd_scanned_barcode_scanning_date (copy)_1146025402324602893]' />
            </column>
            <column caption='Assortment Parity % [Scan]' datatype='real' default-format='p0.00%' name='[AVG Daily Assortment Parity % [Current]] (copy)_1146025402327986199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Assortment Parity % [Current]] (copy)_1146025402327879702])' />
            </column>
            <column caption='Enabled [Scan]' datatype='real' name='[AVG Daily Enabled [Current]] (copy)_1146025402323054601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [category_name_level_one], [category_name_level_two], [category_name_level_three],[is_enabled_and_active_last_30_days] &gt; 0 : AVG([sd_enabled_as_of_scanning_date])})' />
            </column>
            <column caption='AVG Daily Enabled [F30D]' datatype='real' name='[AVG Daily Enabled [Scan]] (copy)_1146025402323136522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [category_name_level_one], [category_name_level_two], [category_name_level_three],[is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_first_30_days])})' />
            </column>
            <column caption='Assortment Parity % [Scan] - Calc' datatype='real' name='[Assortment Parity % [Current]] (copy)_1146025402327879702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sd_enabled_active_l30d_scanning_date]/[sd_scanned_barcode_scanning_date]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1146025402319163392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    // Format: &quot;23 Jul&apos;25 | Tue&quot;&#10;    // If you want to revert to this, uncomment the below and comment out the line below it&#10;    // STR(DATEPART(&apos;day&apos;,[date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[date]),3)  + &quot;&apos;&quot; + MID(STR(DATETRUNC(&apos;year&apos;,[date])),3,2) + &quot; | &quot;  +  LEFT(DATENAME(&apos;weekday&apos;,[date]),3)&#10;    STR([date])&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    // Format: Week start date&#10;    LEFT(STR(DATETRUNC(&apos;week&apos;,[date], &apos;sunday&apos;)), 10)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    // Format: &quot;Jul 2025&quot;&#10;    LEFT(DATENAME(&apos;month&apos;,[date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Quarterly&apos; THEN&#10;    // Format: &quot;Q3 2025&quot;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Yearly&apos; THEN&#10;    // Format: &quot;2025&quot;&#10;    STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;END' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1146025402319314945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;=  [Parameters].[Parameter 2]&#10;AND [date] &lt;= [Parameters].[Parameter 1]&#10;// AND DAY([date]) &lt;= DAY([End Date])' />
            </column>
            <column caption='Scanned Barcodes [L90D]' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1146025402320285699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [country_code], [category_name_level_one], [category_name_level_two], [category_name_level_three]: AVG([barcodes_scanned_l90d])})' />
            </column>
            <column caption='Assortment Parity % [Current] - Calc' datatype='real' name='[Calculation_1146025402321575941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_enabled_and_active_last_30_days]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='Assortment Parity % [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1146025402321711110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_1146025402321575941])' />
            </column>
            <column caption='AVG Daily Enabled [Current]' datatype='real' name='[Calculation_1146025402322259975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [category_name_level_one], [category_name_level_two], [category_name_level_three],[is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date])})' />
            </column>
            <column caption='% Enabled [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1146025402322722824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1146025402322259975]/[Calculation_1146025402320285699]' />
            </column>
            <column caption='% Enabled' datatype='real' default-format='p0.00%' name='[Calculation_1146025402327089172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [% Enabled [Current]] (copy)_1146025402323267595]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [Calculation_1146025402322722824]&#10;ELSE [% Enabled [Scan]] (copy)_1146025402323738636]&#10;END' />
            </column>
            <column caption='Availability %' datatype='real' default-format='p0.00%' name='[Calculation_1146025402346725409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([morning_is_enabled_active] + [afternoon_is_enabled_active] + [evening_is_enabled_active])/SUM([enabled_active_l30d_availability] * 3)' />
            </column>
            <column caption='Items OOS %' datatype='real' default-format='p0.00%' name='[Calculation_1146025402347139107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_quantity_sr] + [oos_quantity_failed])/SUM([net_ordered_quantity])' />
            </column>
            <column caption='Items Not Delivered %' datatype='real' default-format='p0.00%' name='[Calculation_1146025402347733028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_quantity_sr_not_found] + [oos_quantity_failed])/SUM([net_ordered_quantity])' />
            </column>
            <column caption='Basket Penetration %' datatype='real' default-format='p0.00%' name='[Calculation_1146025402347986981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([basket_size])' />
            </column>
            <column caption='GPV [EUR]' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1146025402348511270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpv])' />
            </column>
