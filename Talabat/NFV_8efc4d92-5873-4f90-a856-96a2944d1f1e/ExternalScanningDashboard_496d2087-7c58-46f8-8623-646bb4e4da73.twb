      <repository-location id='ParityDeepDive' path='/t/Talabat/workbooks/ExternalScanningDashboard_17531575598440' revision='' site='Talabat' />
      <style />
      <size maxheight='2200' maxwidth='1500' minheight='2200' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL Query (data_platform)' name='federated.1ekd7i70jh8zf41dadxy31oor0p0' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[Calculation_1708130929644273665]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='End Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-19#'>
          <calculation class='tableau' formula='#2025-08-19#' />
        </column>
        <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-01#'>
          <calculation class='tableau' formula='#2025-02-01#' />
        </column>
        <column caption='Date Aggregation' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
          <members>
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Quarterly&quot;' />
