        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date], [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;END&#10;&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
