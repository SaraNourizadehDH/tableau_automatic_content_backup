      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1ekd7i70jh8zf41dadxy31oor0p0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[Calculation_1708130929644273665]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='End Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-19#'>
              <calculation class='tableau' formula='#2025-08-19#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='Max Date' datatype='date' name='[Calculation_1708130929644273665]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1708130929645379586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    // Format: &quot;23 Jul&apos;25 | Tue&quot;&#10;    // If you want to revert to this, uncomment the below and comment out the line below it&#10;    // STR(DATEPART(&apos;day&apos;,[date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[date]),3)  + &quot;&apos;&quot; + MID(STR(DATETRUNC(&apos;year&apos;,[date])),3,2) + &quot; | &quot;  +  LEFT(DATENAME(&apos;weekday&apos;,[date]),3)&#10;    STR([date])&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    // Format: Week start date&#10;    LEFT(STR(DATETRUNC(&apos;week&apos;,[date], &apos;sunday&apos;)), 10)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    // Format: &quot;Jul 2025&quot;&#10;    LEFT(DATENAME(&apos;month&apos;,[date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Quarterly&apos; THEN&#10;    // Format: &quot;Q3 2025&quot;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Yearly&apos; THEN&#10;    // Format: &quot;2025&quot;&#10;    STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;END' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1708130929647476739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;=  [Parameters].[Parameter 2]&#10;AND [date] &lt;= [Parameters].[Parameter 1]&#10;// AND DAY([date]) &lt;= DAY([End Date])' />
            </column>
            <column caption='L90D' datatype='boolean' name='[Calculation_1708130929653882889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_scanning_date], DATE([Calculation_1708130929665515540])) &lt;= 90 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Scanned Branches (L90D)' datatype='integer' name='[Calculation_1708130929654431754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//COUNTD(IF [L90D] AND [AAA] AND [Target Vendor] THEN [Vendor ID] END)&#10;MAX({ FIXED [country_code], [Calculation_1708130929653882889], [is_aaa_vendor], [is_target_vendor], MONTH([date]) :COUNTD([vendor_id])})' />
            </column>
            <column caption='Effective End Date' datatype='datetime' name='[Calculation_1708130929665515540]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &quot;Monthly&quot; THEN DATE(DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]) + 1) - 1&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [Parameters].[Parameter 1]) + 6  // Optional: End of week&#10;  ELSE [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='AVG Daily Vendor Scanned Barcodes L90D [Current]' datatype='real' name='[Calculation_1708130929991319654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [country_code]: AVG([barcodes_scanned_l90d])})' />
            </column>
            <column caption='Date | original date' datatype='datetime' name='[Date (copy)_1708130929676070937]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    DATE([date])  // Keep as real date so missing values can be shown&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    DATETRUNC(&apos;week&apos;, DATE([date]), &apos;sunday&apos;)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    DATETRUNC(&apos;month&apos;, DATE([date]))&#10;&#10;END' />
            </column>
            <column caption='Effective End Date (copy)' datatype='datetime' name='[Effective End Date (copy)_1708130929681543199]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &quot;Monthly&quot; THEN DATE(DATETRUNC(&apos;month&apos;, [Date (copy)_1708130929676070937]) + 1) - 1&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [Date (copy)_1708130929676070937]) + 6  // Optional: End of week&#10;  ELSE [Date (copy)_1708130929676070937]&#10;END' />
            </column>
            <column caption='L90D | Original date' datatype='boolean' name='[L90D (copy 2)_1708130929683075105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_scanning_date], DATE([Effective End Date (copy)_1708130929681543199])) &lt;= 90 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Scanned Barcodes [Current] (copy)' datatype='real' name='[Scanned Barcodes [Current]] (copy)_1708130930051498110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([barcodes_scanned_l90d])/[Scanned Branches (L90D) (copy)_1708130929683165218]' />
            </column>
            <column caption='Scanned Branches (L90D) [Current]' datatype='integer' name='[Scanned Branches (L90D) (copy)_1708130929683165218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [L90D (copy 2)_1708130929683075105] AND [is_aaa] AND [is_target_vendor] THEN [vendor_id] END)' />
            </column>
            <column caption='Vendor Segment' datatype='string' name='[account_classification_segment]' role='dimension' type='nominal' />
            <column caption='Scanned Barcodes [Current]' datatype='real' name='[barcodes_scanned (copy)_1708130929660805136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([barcodes_scanned])/COUNTD([date])' />
            </column>
            <column datatype='integer' name='[barcodes_scanned]' role='measure' type='quantitative' />
            <column datatype='integer' name='[barcodes_scanned_l90d]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Chain ID' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
