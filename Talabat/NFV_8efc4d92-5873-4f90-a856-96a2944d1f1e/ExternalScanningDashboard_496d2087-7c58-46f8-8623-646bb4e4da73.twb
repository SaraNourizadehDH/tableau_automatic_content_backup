          <datasource-dependencies datasource='federated.10e23zv0dbz7331dlik7r0yppzaa'>
            <column caption='% Enabled + Not Active' datatype='real' default-format='p0.00%' name='[% Enabled (copy 2)_1146025402357731378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [% Enabled [Scan]] (copy)_1146025402357534769]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [% Enabled [Current]] (copy)_1146025402357178414]&#10;ELSE [% Enabled [F30D]] (copy)_1146025402357334064]&#10;END' />
