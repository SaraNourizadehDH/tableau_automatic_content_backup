              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [% Not Enabled + PIM [F30D]] (copy)_1146025402326183955]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [% Enabled [Current]] (copy)_1146025402325774353]&#10;ELSE [% Enabled [F30D]] (copy)_1146025402326007826]&#10;END' />
            </column>
