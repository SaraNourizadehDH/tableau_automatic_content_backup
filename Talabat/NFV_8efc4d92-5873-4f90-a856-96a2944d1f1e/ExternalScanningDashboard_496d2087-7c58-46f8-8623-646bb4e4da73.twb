              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [% Enabled [Current]] (copy)_1146025402323267595]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [Calculation_1146025402322722824]&#10;ELSE [% Enabled [Scan]] (copy)_1146025402323738636]&#10;END' />
            </column>
            <column caption='Items OOS %' datatype='real' default-format='p0.00%' name='[Calculation_1146025402347139107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_quantity_sr] + [oos_quantity_failed])/SUM([net_ordered_quantity])' />
