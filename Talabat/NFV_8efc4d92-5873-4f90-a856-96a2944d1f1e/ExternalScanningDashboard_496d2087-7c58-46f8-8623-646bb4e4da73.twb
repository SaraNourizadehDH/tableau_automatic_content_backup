            <column datatype='integer' name='[is_enabled_and_active_last_30_days]' role='measure' type='quantitative' />
            <column datatype='integer' name='[is_gap_as_of_scanning]' role='measure' type='quantitative' />
            <column datatype='integer' name='[is_gap_first_30_days]' role='measure' type='quantitative' />
