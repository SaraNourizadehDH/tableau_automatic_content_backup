            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[Calculation_1708130929644273665]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='End Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-19#'>
              <calculation class='tableau' formula='#2025-08-19#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ekd7i70jh8zf41dadxy31oor0p0].[date]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-01#'>
