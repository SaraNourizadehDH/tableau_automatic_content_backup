            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='AVG Daily Vendor Enabled [Current]' datatype='real' name='[AVG Daily Vendor Enabled +  Active  [Current]]  (copy)_1708130930055311490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id],[is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date])})' />
            </column>
            <column caption='AVG Daily Vendor Enabled % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + Active % [Current]] (copy)_1708130930055495811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[AVG Daily Vendor Enabled [Current]]]/[AVG Daily Vendor Scanned Barcodes L90D [Current]]]&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date], [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_1708130929644273665]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1708130929645379586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    // Format: &quot;23 Jul&apos;25 | Tue&quot;&#10;    // If you want to revert to this, uncomment the below and comment out the line below it&#10;    // STR(DATEPART(&apos;day&apos;,[date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[date]),3)  + &quot;&apos;&quot; + MID(STR(DATETRUNC(&apos;year&apos;,[date])),3,2) + &quot; | &quot;  +  LEFT(DATENAME(&apos;weekday&apos;,[date]),3)&#10;    STR([date])&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    // Format: Week start date&#10;    LEFT(STR(DATETRUNC(&apos;week&apos;,[date], &apos;sunday&apos;)), 10)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    // Format: &quot;Jul 2025&quot;&#10;    LEFT(DATENAME(&apos;month&apos;,[date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Quarterly&apos; THEN&#10;    // Format: &quot;Q3 2025&quot;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Yearly&apos; THEN&#10;    // Format: &quot;2025&quot;&#10;    STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;END' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1708130929647476739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;=  [Parameters].[Parameter 2]&#10;AND [date] &lt;= [Parameters].[Parameter 1]&#10;// AND DAY([date]) &lt;= DAY([End Date])' />
            </column>
            <column caption='Vendor Segment' datatype='string' name='[account_classification_segment]' role='dimension' type='nominal' />
            <column datatype='integer' name='[barcodes_scanned_l90d]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Chain ID' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
