      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/ExternalScanningDashboard_17531575598440/FunnelView?rev=' id='FunnelView' path='/t/Talabat/workbooks/ExternalScanningDashboard_17531575598440' revision='' site='Talabat' />
