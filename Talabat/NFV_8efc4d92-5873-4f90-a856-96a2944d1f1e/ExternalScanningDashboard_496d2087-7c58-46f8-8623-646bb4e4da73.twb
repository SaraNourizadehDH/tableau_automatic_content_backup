          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='AVG Daily Vendor Assortment Actioned % [F30D]' datatype='real' default-format='p0.0%' name='[AVG Daily Vendor Assortment Actioned % [Current]] (copy)_1708130930014556276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]): AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date] : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;END&#10;&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
            </column>
            <column caption='AVG Daily Vendor Assortment Parity % [Scan]' datatype='real' default-format='p0.0%' name='[AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930011119724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]): AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]) : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]) &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]) : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date]: AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;END&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
            </column>
            <column caption='AVG Daily Vendor Enabled + Not Active % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930016198775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929690656810])})' />
            </column>
            <column caption='AVG Daily Vendor Enabled % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + Active % [Current]] (copy)_1708130930055495811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[AVG Daily Vendor Enabled [Current]]]/[AVG Daily Vendor Scanned Barcodes L90D [Current]]]&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date], [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;END' />
            </column>
            <column caption='AVG Daily Vendor Not Enabled + PIM %  [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + Not Active % [Current]] (copy)_1708130930022166651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929691676720])})' />
