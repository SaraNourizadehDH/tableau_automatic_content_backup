              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='AVG Daily Vendor Not Enabled [Current]' datatype='real' name='[AVG Daily Vendor Enabled + Not Active L30D [Current]] (copy)_1708130930016624760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id],[is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_not_enabled_as_of_date])})' />
            </column>
            <column caption='AVG Daily Vendor Not Enabled  %  [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + PIM %  [Current]] (copy)_1708130930022613117]' role='measure' type='quantitative'>
