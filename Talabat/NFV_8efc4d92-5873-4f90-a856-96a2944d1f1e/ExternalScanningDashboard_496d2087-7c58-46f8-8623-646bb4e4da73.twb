              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Scanning Date&apos; THEN [AVG Daily Vendor Enabled +  Active  [Current]]  (copy)_1708130930059051140]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Current&apos; THEN [AVG Daily Vendor Enabled + Not Active  [Current]] (copy)_1708130930054672512]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;First 30 Days&apos; THEN [AVG Daily Vendor Enabled +  Active  [Scan]] (copy)_1708130930059186309]&#10;END' />
