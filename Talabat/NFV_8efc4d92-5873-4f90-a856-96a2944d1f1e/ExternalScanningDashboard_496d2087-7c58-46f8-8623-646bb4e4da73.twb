            <column caption='Assortment Parity % [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1146025402321711110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_1146025402321575941])' />
