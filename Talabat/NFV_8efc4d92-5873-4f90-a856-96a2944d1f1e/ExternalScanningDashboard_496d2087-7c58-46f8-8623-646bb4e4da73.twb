          <datasource-dependencies datasource='federated.1ekd7i70jh8zf41dadxy31oor0p0'>
            <column caption='% Branches Scanned (L90D) [Current]' datatype='real' default-format='p0.00%' name='[% Branches Scanned (L90D) (copy)_1708130929683279907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Scanned Branches (L90D) (copy)_1708130929683165218]/[Scanned Branches (L90D) (copy)_1708130929658818571]' />
            </column>
            <column caption='AVG Daily Vendor Assortment Actioned % [F30D]' datatype='real' default-format='p0.0%' name='[AVG Daily Vendor Assortment Actioned % [Current]] (copy)_1708130930014556276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]): AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]) : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date] : AVG(IF ([assortment_parity]) = 0 THEN NULL ELSE (1 - [is_gap_first_30_days]/[is_gap_as_of_scanning]) END)})&#10;END&#10;&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
            </column>
            <column caption='AVG Daily Vendor Assortment Parity % [Scan]' datatype='real' default-format='p0.0%' name='[AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930011119724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]): AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]) : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]) &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]) : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date]: AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})&#10;END&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
            </column>
            <column caption='AVG Daily Vendor Enabled + Not Active % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Assortment Parity % [Current]] (copy)_1708130930016198775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929690656810])})' />
            </column>
            <column caption='AVG Daily Vendor Enabled % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + Active % [Current]] (copy)_1708130930055495811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[AVG Daily Vendor Enabled [Current]]]/[AVG Daily Vendor Scanned Barcodes L90D [Current]]]&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date], [is_enabled_and_active_last_30_days] &gt; 0 : AVG([is_enabled_as_of_date]/[barcodes_scanned_l90d])})&#10;END' />
            </column>
            <column caption='AVG Daily Vendor Not Enabled + PIM %  [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + Not Active % [Current]] (copy)_1708130930022166651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929691676720])})' />
            </column>
            <column caption='AVG Daily Vendor Not Enabled + Not PIM %  [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + PIM %  [Current]] (copy)_1708130930022310012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929691349038])})' />
            </column>
            <column caption='AVG Daily Vendor Not Enabled  %  [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Enabled + PIM %  [Current]] (copy)_1708130930022613117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Calculation_1708130929691029548])})' />
            </column>
            <column caption='AVG Daily Vendor Assortment Actioned % [Current]' datatype='real' default-format='p0.00%' name='[AVG Daily Vendor Gap [Scan]] (copy)_1708130930013151346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [date], [vendor_id], [is_enabled_and_active_last_30_days] &gt; 0: AVG([Assortment Actioned % [Current]] (copy)_1708130930013003889])})' />
            </column>
            <column caption='Assortment Actioned % [Current] (copy)' datatype='real' default-format='p0.00%' name='[Assortment Actioned % [Current]] (copy)_1708130930013003889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([is_gap_as_of_scanning]-[is_gap_as_of_date])/[is_gap_as_of_scanning]' />
            </column>
            <column caption='Assortment Parity % [Current]' datatype='real' default-format='p0.0%' name='[Assortment Parity % [Current]] (copy)_1708130929649414151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Monthly&apos; THEN&#10;AVG({ FIXED [vendor_id], MONTH([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos; THEN&#10;AVG({ FIXED [vendor_id], WEEK([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Quarterly&apos; THEN&#10;AVG({ FIXED [vendor_id], QUARTER([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Yearly&apos; THEN &#10;AVG({ FIXED [vendor_id], YEAR([date]), [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;ELSE &#10;AVG({ FIXED [vendor_id], [date], [is_enabled_and_active_last_30_days] &gt; 0 : AVG(IF [assortment_parity] =0 THEN NULL ELSE [assortment_parity] END)})&#10;END&#10;&#10;&#10;// AVG({ FIXED [Vendor ID], MONTH([date]), [sd_enabled_active_l30d_scanning_date] &gt; 0 : AVG(IF [sd_assortment_parity] = 0 THEN NULL ELSE [sd_assortment_parity] END)})' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_1708130929644273665]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1708130929645379586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    // Format: &quot;23 Jul&apos;25 | Tue&quot;&#10;    // If you want to revert to this, uncomment the below and comment out the line below it&#10;    // STR(DATEPART(&apos;day&apos;,[date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[date]),3)  + &quot;&apos;&quot; + MID(STR(DATETRUNC(&apos;year&apos;,[date])),3,2) + &quot; | &quot;  +  LEFT(DATENAME(&apos;weekday&apos;,[date]),3)&#10;    STR([date])&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    // Format: Week start date&#10;    LEFT(STR(DATETRUNC(&apos;week&apos;,[date], &apos;sunday&apos;)), 10)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    // Format: &quot;Jul 2025&quot;&#10;    LEFT(DATENAME(&apos;month&apos;,[date]), 3) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Quarterly&apos; THEN&#10;    // Format: &quot;Q3 2025&quot;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;WHEN &apos;Yearly&apos; THEN&#10;    // Format: &quot;2025&quot;&#10;    STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;END' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1708130929647476739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;=  [Parameters].[Parameter 2]&#10;AND [date] &lt;= [Parameters].[Parameter 1]&#10;// AND DAY([date]) &lt;= DAY([End Date])' />
            </column>
            <column caption='% Enabled Not Active [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1708130929690656810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_enabled_not_active_as_of_date]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='% Not Enabled [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1708130929691029548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_not_enabled_as_of_date]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='% not Enabled | not in PIM [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1708130929691349038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_not_pim_not_enabled_as_of_date]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='% not Enabled | in PIM [Current]' datatype='real' default-format='p0.00%' name='[Calculation_1708130929691676720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_pim_not_enabled_as_of_date]/[barcodes_scanned_l90d]' />
            </column>
            <column caption='Date | original date' datatype='datetime' name='[Date (copy)_1708130929676070937]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Daily&apos; THEN&#10;    DATE([date])  // Keep as real date so missing values can be shown&#10;&#10;WHEN &apos;Weekly&apos; THEN&#10;    DATETRUNC(&apos;week&apos;, DATE([date]), &apos;sunday&apos;)&#10;&#10;WHEN &apos;Monthly&apos; THEN&#10;    DATETRUNC(&apos;month&apos;, DATE([date]))&#10;&#10;END' />
            </column>
            <column caption='Effective End Date (copy)' datatype='datetime' name='[Effective End Date (copy)_1708130929681543199]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &quot;Monthly&quot; THEN DATE(DATETRUNC(&apos;month&apos;, [Date (copy)_1708130929676070937]) + 1) - 1&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [Date (copy)_1708130929676070937]) + 6  // Optional: End of week&#10;  ELSE [Date (copy)_1708130929676070937]&#10;END' />
            </column>
            <column caption='L90D | Original date' datatype='boolean' name='[L90D (copy 2)_1708130929683075105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [last_scanning_date], DATE([Effective End Date (copy)_1708130929681543199])) &lt;= 90 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Target Vendor Count' datatype='integer' name='[Scanned Branches (L90D) (copy)_1708130929658818571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// COUNTD(IF [Target Vendor] THEN [Vendor ID] END)&#10;MAX({ FIXED [country_code], [is_target_vendor] : COUNTD([vendor_id])})' />
