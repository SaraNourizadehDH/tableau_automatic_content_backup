        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0v29mco00l9yqq16xecjq0r8331f'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='sharad.jain@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0v29mco00l9yqq16xecjq0r8331f' name='Custom SQL Query' type='text'><![CDATA[WITH verticals AS (
  SELECT DISTINCT   DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- case when vertical = 'grocery' then 
  -- case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
  -- ELSE vertical end as vertical
  vertical,
FROM `tlb-data-prod.data_platform.dim_chain`
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
where (lead_data_origin <<>> 'SS' or lead_data_origin is null)
and v.is_non_food
and not v.is_darkstore
and order_date >>='2021-01-01'

UNION ALL 
  SELECT DISTINCT   DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- case when vertical = 'grocery' then 
  -- case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
  -- ELSE vertical end as vertical
    "Speciality Stores" as vertical
FROM `tlb-data-prod.data_platform.dim_chain`
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
where (lead_data_origin <<>> 'SS' or lead_data_origin is null)
and v.is_non_food
and not v.is_darkstore
and order_date >>='2021-01-01'),

countries AS (
  SELECT DISTINCT country_code
  FROM `tlb-data-prod.data_platform.dim_chain` c
  WHERE country_code IN ('AE', 'BH', 'EG', 'IQ', 'JO', 'KW', 'OM', 'QA', 'SA')
),

pre_final AS (
SELECT
  DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- o.order_date,
  c.country_code,
  -- case when vertical = 'grocery' then 
  -- case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
  -- ELSE vertical end as vertical,
  vertical,
  -- vs.vertical,
  sum(CASE WHEN o.is_successful then gmv_amount_eur ELSE 0 END) AS delivered_gmv,
  sum(CASE WHEN o.is_successful then gmv_amount_lc ELSE 0 END) AS delivered_lc,
  COUNT(DISTINCT order_id) AS num_orders,
  -- COALESCE(SUM(case when o.order_date BETWEEN '2024-04-01' and '2024-04-30' then net_orders end), 0) as net_orders,
FROM `tlb-data-prod.data_platform.dim_chain` c
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
-- CROSS JOIN verticals vs
where (lead_data_origin <<>> 'SS' or lead_data_origin is null)
and v.is_non_food
and not v.is_darkstore
-- AND c.country_code = 'AE'
-- AND vertical IN ('pet shop', 'pharmacy')
and order_date >>='2021-01-01'
group by 1,2,3

union all

SELECT 
DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- o.order_date,
  c.country_code,
  "Speciality Stores" as vertical,
    -- vs.vertical,
  sum(CASE WHEN o.is_successful then gmv_amount_eur ELSE 0 END) AS delivered_gmv,
  sum(CASE WHEN o.is_successful then gmv_amount_lc ELSE 0 END) AS delivered_lc,
  -- COALESCE(SUM(case when a.date BETWEEN '2024-04-01' and '2024-04-30' then net_orders end), 0) as net_orders,
  COUNT(DISTINCT order_id) AS num_orders,
FROM `tlb-data-prod.data_platform.dim_chain` c
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
-- CROSS JOIN verticals vs
where lead_data_origin = 'SS'
and v.is_non_food
and not v.is_darkstore
and order_date >>='2021-01-01'
group by 1,2,3),

pre_final2 AS (
SELECT *
FROM verticals vs 
CROSS JOIN countries)

SELECT order_date,
vertical,
country_code,
COALESCE(delivered_gmv, 0) AS delivered_gmv,
COALESCE(delivered_lc, 0) AS delivered_lc,
COALESCE(num_orders, 0) AS num_orders
FROM pre_final2 
LEFT JOIN pre_final USING(order_date, vertical, country_code)
-- WHERE country_code = 'AE'
ORDER BY 2,1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
