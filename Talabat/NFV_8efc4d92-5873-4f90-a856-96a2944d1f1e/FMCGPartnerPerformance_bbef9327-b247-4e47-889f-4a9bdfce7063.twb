      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_order (data_platform)' name='sqlproxy.0tahf150fiy70p14zh2lc0e7zyxo' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.0tahf150fiy70p14zh2lc0e7zyxo'>
            <column aggregation='User' caption='OOS%' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1497446894067806208]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='([Calculation_1497446894067916801] + [Calculation_1497446894068436994]) / COUNTD(if [is_net]= True then [order_id] end)' />
            </column>
            <column aggregation='User' caption='Successful orders with  OOS' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1497446894067916801]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
