              <calculation class='tableau' formula='([Calculation_1497446894067916801] + [Calculation_1497446894068436994]) / COUNTD(if [is_net]= True then [order_id] end)' />
            </column>
            <column aggregation='User' caption='Successful orders with  OOS' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1497446894067916801]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='COUNTD(if [is_sent]= true and ([pelican_status] IN (&apos;NOT_FOUND&apos;,&apos;REPLACED&apos;) OR [qty_delivered]&lt;[qty_ordered]) then [order_id] END)' />
            </column>
            <column aggregation='User' caption='Failed orders OOS' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1497446894068436994]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='COUNTD(if [is_sent]= FALSE and [is_net]= True and [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) then [order_id] END)' />
