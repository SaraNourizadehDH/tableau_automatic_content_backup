      <column aggregation='User' caption='OOS%' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1497446894067806208]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='([Calculation_1497446894067916801] + [Calculation_1497446894068436994]) / COUNTD(if [is_net]= True then [order_id] end)' />
      </column>
      <column aggregation='User' caption='Successful orders with  OOS' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1497446894067916801]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(if [is_sent]= true and ([pelican_status] IN (&apos;NOT_FOUND&apos;,&apos;REPLACED&apos;) OR [qty_delivered]&lt;[qty_ordered]) then [order_id] END)' />
      </column>
      <column aggregation='User' caption='Failed orders OOS' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1497446894068436994]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(if [is_sent]= FALSE and [is_net]= True and [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) then [order_id] END)' />
      </column>
      <column aggregation='Count' caption='Completed months' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_264305042670518275]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='[date]&gt;=dateadd(&apos;month&apos;,-2,datetrunc(&apos;month&apos;, today()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;[date]&lt;datetrunc(&apos;month&apos;,today())' />
      </column>
      <column aggregation='User' caption='Successful Orders' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_264305042672873478]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(if [is_sent]= True then [order_id] END)' />
      </column>
      <column aggregation='User' caption='SKUs per vendor' datatype='real' default-type='quantitative' layered='true' name='[Calculation_264305042680438797]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
