      <column aggregation='Count' caption='Analytical Customer Id (copy)' datatype='string' default-type='nominal' layered='true' name='[Analytical Customer Id (copy)_264305042674139144]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='[analytical_customer_id]' />
