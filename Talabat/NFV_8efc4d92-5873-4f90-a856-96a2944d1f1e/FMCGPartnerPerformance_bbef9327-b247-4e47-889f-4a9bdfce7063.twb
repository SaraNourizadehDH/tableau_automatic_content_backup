  <column aggregation='Count' caption='Analytical Customer Id (copy)' datatype='string' default-type='nominal' name='[Analytical Customer Id (copy)_264305042674139144]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
