          <named-connection caption='BigQuery' name='bigquery.0jsh3he1fpywyr10yuepm0kr1zve'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='aleeza.shakir@talabat.com' workgroup-auth-mode='prompt' />
