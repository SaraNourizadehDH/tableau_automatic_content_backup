      <column caption='Average Basket Size - cap not changed ' datatype='real' name='[Average Basket Size - cap changed (copy)_4778319264507604999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_net_qty_ordered_cap_not_changed])/sum([non_cap_changed_orders])' />
      </column>
      <column caption='CVR% - Cap not changed' datatype='real' name='[CVR% (copy)_4778319264554074123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_cap_not_changed]) / sum([sessions_cap_not_changed])' />
      </column>
      <column caption='Available vendors' datatype='integer' name='[Calculation_1080793608015347714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [available] &gt; 1 then [vendor_id] end)' />
      </column>
      <column caption='Cap changed vendors' datatype='integer' name='[Calculation_1080793608016949251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [cap_changed] &gt; 1 then [vendor_id] end)' />
      </column>
      <column caption='Cap enabled vendors' datatype='integer' name='[Calculation_1080793608021639172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [cap_enabled] &gt; 1 then [vendor_id] end)' />
      </column>
      <column caption='Enabled vendors %' datatype='real' name='[Calculation_1080793608025800709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1080793608021639172] / [Calculation_1080793608015347714]' />
      </column>
      <column caption='Cap changed vendors %' datatype='real' name='[Calculation_1080793608026062854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1080793608016949251] / [Calculation_1080793608021639172]' />
      </column>
      <column caption='Cap enabled items %' datatype='real' name='[Calculation_1080793609007861767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cap_enabled])/ sum([available])' />
      </column>
      <column caption='Cap Changed items %' datatype='real' name='[Calculation_1080793609008140296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cap_changed])/sum([cap_enabled])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4778319263376769025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, DATE([date]))' />
      </column>
      <column caption='Cap not changed branches' datatype='integer' name='[Calculation_4778319263377297411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([total_items_cap_not_Changed]) &gt; 0 THEN [vendor_id] END)' />
      </column>
      <column caption='Average Basket Size - cap changed' datatype='real' name='[Calculation_4778319264490700804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_net_qty_ordered_cap_changed])/sum([cap_changed_orders])' />
      </column>
      <column caption='Items OOS%' datatype='real' name='[Calculation_4778319264491606021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_partially_fulfilled_items_cap_changed]) + sum([total_failed_items_due_to_vendor_cap_changed])) / sum([total_net_qty_ordered_cap_changed])' />
      </column>
      <column caption='CVR%' datatype='real' name='[Calculation_4778319264493068294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_cap_changed]) / sum([sessions_cap_changed])' />
