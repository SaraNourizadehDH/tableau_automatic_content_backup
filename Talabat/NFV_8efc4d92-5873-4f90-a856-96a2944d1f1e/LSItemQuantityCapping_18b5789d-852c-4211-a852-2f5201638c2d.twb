        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jsh3he1fpywyr10yuepm0kr1zve' name='Custom SQL Query' type='text'>select qm.*, v.vendor_name, c.country_code, v.account_manager_name, case when lead_data_origin = &apos;PP&apos; then true else false end as preferred_partner, c.chain_id, c.chain_name,      CASE 
            WHEN (v.is_darkstore OR v.is_grocery_darkstore) THEN &apos;tmart&apos; 
            WHEN c.sub_vertical IS NULL THEN c.vertical
            ELSE CONCAT(c.vertical, &quot; - &quot;, c.sub_vertical)
        END AS vertical, from `tlb-data-dev.data_playground_grocery.ls_item_qty_mapping` qm left join `tlb-data-prod.data_platform.dim_vendor_info` v using (vendor_id) left join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0jsh3he1fpywyr10yuepm0kr1zve' name='Custom SQL Query' type='text'>select qm.*, v.vendor_name, c.country_code, v.account_manager_name, case when lead_data_origin = &apos;PP&apos; then true else false end as preferred_partner, c.chain_id, c.chain_name,      CASE 
            WHEN (v.is_darkstore OR v.is_grocery_darkstore) THEN &apos;tmart&apos; 
            WHEN c.sub_vertical IS NULL THEN c.vertical
            ELSE CONCAT(c.vertical, &quot; - &quot;, c.sub_vertical)
        END AS vertical, from `tlb-data-dev.data_playground_grocery.ls_item_qty_mapping` qm left join `tlb-data-prod.data_platform.dim_vendor_info` v using (vendor_id) left join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
