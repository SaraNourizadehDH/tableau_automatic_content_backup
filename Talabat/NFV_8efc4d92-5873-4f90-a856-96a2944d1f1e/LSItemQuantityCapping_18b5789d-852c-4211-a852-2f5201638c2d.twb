      <column caption='Chain Capped CVR' datatype='real' name='[Calculation_5419800680325214208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([chain_capped_orders])/sum([chain_capped_sessions])' />
      </column>
      <column caption='Vertical Capped CVR' datatype='real' name='[Calculation_5419800680325521409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vertical_capped_orders])/sum([vertical_capped_sessions])' />
      </column>
      <column caption='Vendor Capped CVR' datatype='real' name='[Calculation_5419800680325636098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_capped_orders])/sum([vendor_capped_sessions])' />
      </column>
      <column caption='Chain non capped CVR' datatype='real' name='[Calculation_5419800680325730307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([chain_non_capped_orders])/sum([chain_non_capped_sessions])' />
      </column>
      <column caption='Vertical non capped CVR' datatype='real' name='[Calculation_5419800680325861380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vertical_non_capped_orders])/sum([vertical_non_capped_sessions])' />
      </column>
      <column caption='Vendor non capped CVR' datatype='real' name='[Calculation_5419800680326041605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_non_capped_orders])/sum([vendor_non_capped_sessions])' />
      </column>
      <column caption='Capped CVR' datatype='real' name='[Calculation_5419800681029255174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([capped_orders])/sum([capped_sessions])' />
      </column>
      <column caption='Non Capped CVR%' datatype='real' name='[Calculation_5419800681036185607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([non_capped_orders])/sum([non_capped_sessions])' />
      </column>
      <column caption='Data granularity' datatype='string' name='[Calculation_5419800681038880776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;vertical&apos; THEN vertical&#10;ELSEIF [Parameters].[Parameter 1] = &apos;chain&apos; THEN STR([chain_name])&#10;ELSEIF [Parameters].[Parameter 1]= &apos;vendor&apos; THEN STR([vendor_name])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Level = data granularity' datatype='boolean' name='[Calculation_5419800681091215369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[level] = [Parameters].[Parameter 1]' />
