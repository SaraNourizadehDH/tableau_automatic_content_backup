          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kxav8a09bsxe81g87zve1ggkgzc'>
            <column caption='Average Basket Size - cap not changed ' datatype='real' name='[Average Basket Size - cap changed (copy)_4778319264507604999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_net_qty_ordered_cap_not_changed])/sum([non_cap_changed_orders])' />
            </column>
            <column caption='account manager ' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
