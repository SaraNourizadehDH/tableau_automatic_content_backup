            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#0433ff' fontname='Tableau Light' fontsize='8'>Items cap enabled</run>
                <run bold='true' fontname='Tableau Light' fontsize='8'>: </run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Items having the maximum quantity  as non 0 or not null that can be sold </run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#f28e2b' fontname='Tableau Light' fontsize='8'>Items cap changed: </run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Items having non zero previous item max sales quantity AND item max sales quantity AND previous item max sales quantity NOT equal to item max sales quantity, implying the change in cap</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#f28e2b' fontname='Tableau Light' fontsize='8'>Items cap not changed:</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> Items having zero previous item max sales quantity AND item max sales quantity </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#0433ff' fontname='Tableau Light' fontsize='8'>Items cap enabled </run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>= </run>
                <run fontcolor='#f28e2b' fontname='Tableau Light' fontsize='8'>items cap changed + items cap not changed</run>
              </formatted-text>
            </customized-tooltip>
