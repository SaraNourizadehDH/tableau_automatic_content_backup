      </column>
      <column caption='Average Basket Size - cap not changed ' datatype='real' name='[Average Basket Size - cap changed (copy)_4778319264507604999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_net_qty_ordered_cap_not_changed])/sum([non_cap_changed_orders])' />
      </column>
      <column caption='CVR% - Cap not changed' datatype='real' name='[CVR% (copy)_4778319264554074123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_cap_not_changed]) / sum([sessions_cap_not_changed])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4778319263376769025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, MAKEDATE(2024, [month], 1))' />
      </column>
      <column caption='Cap enabled  branches' datatype='integer' name='[Calculation_4778319263376986114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([total_items_cap_Changed]) &gt; 0 THEN [vendor_id] END)' />
      </column>
      <column caption='Cap not changed branches' datatype='integer' name='[Calculation_4778319263377297411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([total_items_cap_not_Changed]) &gt; 0 THEN [vendor_id] END)' />
      </column>
      <column caption='Average Basket Size - cap changed' datatype='real' name='[Calculation_4778319264490700804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_net_qty_ordered_cap_changed])/sum([cap_changed_orders])' />
      </column>
      <column caption='Items OOS%' datatype='real' name='[Calculation_4778319264491606021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_partially_fulfilled_items_cap_changed]) + sum([total_failed_items_due_to_vendor_cap_changed])) / sum([total_net_qty_ordered_cap_changed])' />
      </column>
      <column caption='CVR%' datatype='real' name='[Calculation_4778319264493068294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_cap_changed]) / sum([sessions_cap_changed])' />
      </column>
      <column caption='Vendor %' datatype='real' name='[Calculation_4778319264550096904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_vendors_Cap_changed])/sum([total_vendors_Cap_enabled])' />
      </column>
      <column caption='Cap changed %' datatype='real' name='[Calculation_4778319264552689673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_items_Cap_changed])/sum([total_items_Cap_enabled])' />
      </column>
      <column caption='Cap not changed %' datatype='real' name='[Cap changed % (copy)_4778319264552923146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_items_Cap_not_changed])/sum([total_items_Cap_enabled])' />
      </column>
      <column caption='Items OOS% - cap not changed' datatype='real' name='[Items OOS% (copy)_4778319264554504204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_partially_fulfilled_items_cap_not_changed]) + sum([total_failed_items_due_to_vendor_cap_not_changed])) / sum([total_net_qty_ordered_cap_not_changed])' />
      </column>
