          <datasources>
            <datasource caption='Availability Main Query' name='federated.0gz9kf01s506it158z8uq05z4fj3' />
          </datasources>
          <datasource-dependencies datasource='federated.0gz9kf01s506it158z8uq05z4fj3'>
            <column caption='KVI Availability %' datatype='real' name='[Calculation_4886827858802954240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_group_availability_hours])/(SUM([total_groups] *[store_active_hours]))' />
            </column>
            <column caption='KVI Availability % (Enabled)' datatype='real' name='[Calculation_4886827858803286017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_group_availability_hours])/(SUM([total_enabled_groups]*[store_active_hours]))' />
            </column>
            <column caption='KVI Parity %' datatype='real' name='[Calculation_4886827858803679234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_enabled_groups])/SUM([total_groups])' />
            </column>
            <column caption='Subs Ratio' datatype='real' name='[Calculation_4886827858803884035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([vendor_enabled_sub])/AVG([vendor_enabled_kvi])' />
            </column>
            <column caption='Calculation1' datatype='real' name='[Calculation_5195254066911944705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(SUM({ FIXED [date], [country_code], [chain_id], [category_level_1], [category_level_2], [category_level_3]: SUM([chain_kvi])}&#10;/&#10;{FIXED [date], [country_code], [chain_id]: COUNTD([vendor_id])}))'>
