          <alias key='&quot;[federated.0gz9kf01s506it158z8uq05z4fj3].[pcdf:usr:Calculation_4886827858803884035:qk:21]&quot;' value='% Diff (Subs Ratio)' />
        </aliases>
      </column>
      <column caption='Time Granularity' datatype='datetime' name='[Calculation_3686900034897301504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN DATE([date]) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, DATE([date]), &apos;sunday&apos;)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, DATE([date]), &apos;sunday&apos;)&#10;ELSE DATETRUNC(&apos;year&apos;, DATE([date]), &apos;sunday&apos;) END' />
      </column>
      <column caption='KPI 1' datatype='real' name='[Calculation_3686900034915049476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;KVI Availability %&apos; THEN [Calculation_4886827858802954240]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;KVI Availability (Enabled) %&apos; THEN [Calculation_4886827858803286017]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;KVI Parity %&apos; THEN [Calculation_4886827858803679234]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Sub Ratio&apos; THEN [Calculation_4886827858803884035]&#10;END' />
      </column>
      <column caption='KVI Availability %' datatype='real' name='[Calculation_4886827858802954240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_group_availability_hours])/(SUM([total_groups] *[store_active_hours]))' />
      </column>
      <column caption='KVI Availability % (Enabled)' datatype='real' name='[Calculation_4886827858803286017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_group_availability_hours])/(SUM([total_enabled_groups]*[store_active_hours]))' />
      </column>
      <column caption='KVI Parity %' datatype='real' name='[Calculation_4886827858803679234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_enabled_groups])/SUM([total_groups])' />
      </column>
      <column caption='Subs Ratio' datatype='real' name='[Calculation_4886827858803884035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([vendor_enabled_sub])/AVG([vendor_enabled_kvi])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_5195254066911944705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM({ FIXED [date], [country_code], [chain_id], [category_level_1], [category_level_2], [category_level_3]: SUM([chain_kvi])}&#10;/&#10;{FIXED [date], [country_code], [chain_id]: COUNTD([vendor_id])}))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
