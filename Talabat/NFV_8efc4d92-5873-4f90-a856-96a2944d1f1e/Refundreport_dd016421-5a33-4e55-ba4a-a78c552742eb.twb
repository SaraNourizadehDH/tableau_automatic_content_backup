        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ihl3ws1tz3qdv11nkb0e0rqw89a' name='Custom SQL Query' type='text'>SELECT order_date, country_iso, vertical, c.chain_id, chain_name, v.vendor_id, vendor_name, repayment_reason, repayment_channel, count(distinct o.order_id) as orders, sum(repayment_amount_lc) as refund_amount_lc, sum(repayment_amount_eur) as refund_amount_eur  &#13;
FROM `tlb-data-prod.data_platform.dim_chain` c&#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)&#13;
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)&#13;
left join `tlb-data-prod.data_platform.fct_repayment` f  using(order_id)&#13;
left join `tlb-data-prod.data_platform.dim_repayment_reason` r using(repayment_reason_id)&#13;
left join `tlb-data-dev.data_platform.dim_repayment_type` t using(repayment_type_id)&#13;
where o.order_date &gt;&gt;=&apos;2022-01-01&apos;&#13;
and v.is_non_food&#13;
and not v.is_darkstore&#13;
and is_active&#13;
and f.order_id is not null&#13;
group by 1,2,3,4,5,6,7,8,9&#13;
order by 1,2,3,4,5,6,7,8,9</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ihl3ws1tz3qdv11nkb0e0rqw89a' name='Custom SQL Query' type='text'>SELECT order_date, country_iso, vertical, c.chain_id, chain_name, v.vendor_id, vendor_name, repayment_reason, repayment_channel, count(distinct o.order_id) as orders, sum(repayment_amount_lc) as refund_amount_lc, sum(repayment_amount_eur) as refund_amount_eur  &#13;
FROM `tlb-data-prod.data_platform.dim_chain` c&#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)&#13;
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)&#13;
left join `tlb-data-prod.data_platform.fct_repayment` f  using(order_id)&#13;
left join `tlb-data-prod.data_platform.dim_repayment_reason` r using(repayment_reason_id)&#13;
left join `tlb-data-dev.data_platform.dim_repayment_type` t using(repayment_type_id)&#13;
where o.order_date &gt;&gt;=&apos;2022-01-01&apos;&#13;
and v.is_non_food&#13;
and not v.is_darkstore&#13;
and is_active&#13;
and f.order_id is not null&#13;
group by 1,2,3,4,5,6,7,8,9&#13;
