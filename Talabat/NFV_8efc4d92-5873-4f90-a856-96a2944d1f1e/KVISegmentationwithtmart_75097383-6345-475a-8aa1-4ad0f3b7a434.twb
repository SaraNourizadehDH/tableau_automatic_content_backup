        <calculation class='tableau' formula='COUNTD( &#10;if [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [Parameters].[Parameter 2] = [chain_name] and [is_active_item]  then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [is_active_item] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2] = [chain_name] and [is_active_item] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [is_active_item] then [vendor_id]  END)' />
