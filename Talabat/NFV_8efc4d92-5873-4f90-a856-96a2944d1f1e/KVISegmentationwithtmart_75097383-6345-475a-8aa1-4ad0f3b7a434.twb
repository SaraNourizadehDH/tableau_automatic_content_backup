      <column caption='KVI Availability %' datatype='real' name='[Calculation_1983624591980343296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([active_kvi_items])/avg([Calculation_398357522893504524])' />
      </column>
      <column caption='KVIs per country' datatype='integer' name='[Calculation_398357522893504524]' role='measure' type='quantitative'>
