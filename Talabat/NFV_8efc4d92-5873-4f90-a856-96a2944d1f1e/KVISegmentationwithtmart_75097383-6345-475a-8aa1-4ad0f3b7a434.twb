  <worksheets>
    <worksheet name='SKU Level-sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_kvi_segmentation (data_playground_grocery)' name='federated.1uxn1lt0gznw8215fbl321jwblfu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Account Manager' datatype='string' name='[Country (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
            <column caption='Chain name' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uxn1lt0gznw8215fbl321jwblfu'>
            <column caption='Promotion for total vendors as filters %' datatype='real' name='[Availability % (copy)_1983624592457539608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total vendors (copy)_1983624592389189644])/avg([Calculation_192880789786103811])' />
            </column>
            <column caption='Availability as per the select filters' datatype='integer' name='[Availability (available in X number of vendors) (copy)_398357522813366272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( &#10;if [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [Parameters].[Parameter 2] = [chain_name] and [is_active_item]  then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [is_active_item] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2] = [chain_name] and [is_active_item] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [is_active_item] then [vendor_id]  END)' />
            </column>
            <column caption='Quantity sold ' datatype='integer' name='[Average sold price of SKU (copy)_398357522814865412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_quantity])' />
            </column>
            <column caption='Total vendors as per the filters' datatype='integer' name='[Calculation_192880789786103811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date],[country_code] : COUNTD(&#10;if [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [Parameters].[Parameter 2] = [chain_name]  then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2] = [chain_name] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; then [vendor_id]  END) }' />
            </column>
            <column caption='Availability %' datatype='real' name='[Calculation_398357522813771778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Availability (available in X number of vendors) (copy)_398357522813366272])/avg([Calculation_192880789786103811])' />
            </column>
            <column caption='SKU Sales (Monetary)' datatype='real' name='[Calculation_398357522815619078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( CASE [Parameters].[Parameter 1]&#10;when &quot;LC&quot; then [order_item_price_lc]&#10;when &quot;EUR&quot;  then [order_item_price_eur] END)' />
            </column>
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column caption='Average quantity sold per vendor' datatype='real' name='[Quantity sold  (copy)_398357522815164421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_quantity])/COUNTD([vendor_id])' />
            </column>
            <column caption='Orders' datatype='integer' name='[SKU Sales (Monetary) (copy)_398357522816618503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Total vendors with promotion' datatype='integer' name='[Total vendors (copy)_1983624592389189644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( &#10;if [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [Parameters].[Parameter 2] = [chain_name] and [is_active_item] and [is_promotion] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [Parameters].[Country (copy)]=[account_manager_name] and [is_active_item] and [is_promotion] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]&lt;&gt;&apos;All&apos; and [Parameters].[Parameter 2] = [chain_name] and [is_active_item] and [is_promotion] then [vendor_id]&#10;ELSEIF [Parameters].[Country (copy)]=&apos;All&apos; and [Parameters].[Parameter 2]=&apos;All&apos; and [is_active_item] and [is_promotion] then [vendor_id]  END)' />
            </column>
            <column caption='Total vendors with promotionas per the filters' datatype='integer' name='[Total vendors as per the filters (copy)_1983624592393031694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[city_name],[area_name],[chain_id],[chain_name],[account_manager_name],[Product_Name] : COUNTD(if [is_promotion] then [vendor_id] END) }' />
            </column>
            <column caption='Average sold price of SKU' datatype='real' name='[Total vendors as per the filters (copy)_398357522814468099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( CASE [Parameters].[Parameter 1]&#10;when &quot;LC&quot; then [order_item_price_lc]&#10;when &quot;EUR&quot;  then [order_item_price_eur] END)' />
            </column>
