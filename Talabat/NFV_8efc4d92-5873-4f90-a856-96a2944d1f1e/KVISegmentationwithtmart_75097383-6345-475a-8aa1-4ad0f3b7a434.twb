              <calculation class='tableau' formula='{ FIXED [date],[country_code], [area_name], [Product_Name] : AVG( CASE [Parameters].[Parameter 1]&#10;when &quot;LC&quot; then [order_item_price_lc]&#10;when &quot;EUR&quot;  then [order_item_price_eur] END)}' />
            </column>
            <column caption='Average Selling Price in the City' datatype='real' name='[Average Selling Price in the Area (copy)_398357522827124745]' role='measure' type='quantitative'>
