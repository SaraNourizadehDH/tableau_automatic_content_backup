          <datasource-dependencies datasource='federated.1hgilsm1b9aksn112an370tccc4d'>
            <column caption='Customer (breakdown)' datatype='integer' name='[Calculation_1755207641734479872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[customers count Parameter]&#10;WHEN &quot;Unique customers&quot; THEN [Calculation_3658400664281849867]&#10;WHEN &quot;Unique customers - GMP&quot; THEN [customers tmart (copy)_3658400664282603533]&#10;WHEN &quot;Unique customers - tMart&quot; THEN [customers count (copy)_3658400664282255372]&#10;WHEN &quot;Customers - GMP &amp; tMart&quot; THEN [Calculation_3658400664283451406]&#10;WHEN &quot;Customers only GMP&quot; THEN [customers only tmart (copy)_3658400664285159440]&#10;WHEN &quot;Customers only tMart&quot; THEN [Calculation_3658400664284418063]&#10;end' />
