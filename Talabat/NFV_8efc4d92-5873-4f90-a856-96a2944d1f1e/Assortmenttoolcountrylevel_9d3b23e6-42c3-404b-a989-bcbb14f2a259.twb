      </column>
      <column caption='customers GMP' datatype='integer' name='[customers tmart (copy)_3658400664282603533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if not [is_grocery_darkstore] then [analytical_customer_id] end)' />
      </column>
      <column datatype='date' datatype-customized='true' default-format='*dd mmm' name='[date]' role='dimension' type='ordinal' />
      <column caption='order contribution' datatype='integer' name='[distinct orders (copy)_3658400664272556033]' role='measure' type='quantitative'>
