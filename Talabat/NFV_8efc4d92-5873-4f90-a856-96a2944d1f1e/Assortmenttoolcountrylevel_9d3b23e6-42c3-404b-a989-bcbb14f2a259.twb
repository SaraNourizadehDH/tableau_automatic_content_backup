      <aliases enabled='yes' />
      <column caption='Time dimension' datatype='real' name='[Calculation_1449033235533357056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[distinct orders Parameter] &#10;WHEN &quot;Orders&quot; THEN COUNTD([order_id])&#10;WHEN &quot;tMart revenue share&quot; THEN [Calculation_5326210274918952961]&#10;WHEN &quot;GMP revenue share&quot; THEN [tMart revenue share (copy)_5326210274919424002]&#10;end' />
      </column>
      <column caption='tMart share revenue' datatype='real' name='[Calculation_1449033235535687681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[tmart orders (copy)_3658400664279392262]/ ([tmart orders (copy)_3658400664279392262] +[tmart revenue (copy)_3658400664279654407])' />
      </column>
      <column caption='Customer (breakdown)' datatype='integer' name='[Calculation_1755207641734479872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[customers count Parameter]&#10;WHEN &quot;Unique customers&quot; THEN [Calculation_3658400664281849867]&#10;WHEN &quot;Unique customers - GMP&quot; THEN [customers tmart (copy)_3658400664282603533]&#10;WHEN &quot;Unique customers - tMart&quot; THEN [customers count (copy)_3658400664282255372]&#10;WHEN &quot;Customers - GMP &amp; tMart&quot; THEN [Calculation_3658400664283451406]&#10;WHEN &quot;Customers only GMP&quot; THEN [customers only tmart (copy)_3658400664285159440]&#10;WHEN &quot;Customers only tMart&quot; THEN [Calculation_3658400664284418063]&#10;end' />
      </column>
      <column caption='distinct orders' datatype='integer' name='[Calculation_3658400664270712832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='tmart orders' datatype='integer' name='[Calculation_3658400664273059842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_grocery_darkstore] then [order_id] end)' />
      </column>
      <column caption='tmart contribution' datatype='real' name='[Calculation_3658400664274579460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3658400664273059842]/[Calculation_3658400664270712832]' />
      </column>
      <column caption='SKU count' datatype='integer' name='[Calculation_3658400664280223752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([master_id])' />
      </column>
      <column caption='customers count' datatype='integer' name='[Calculation_3658400664281849867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='customers GMP &amp; tMart' datatype='integer' name='[Calculation_3658400664283451406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers count (copy)_3658400664282255372] +[customers tmart (copy)_3658400664282603533] - [Calculation_3658400664281849867]' />
      </column>
      <column caption='customers only tmart' datatype='integer' name='[Calculation_3658400664284418063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers count (copy)_3658400664282255372] - [Calculation_3658400664283451406]' />
      </column>
      <column caption='total revenue' datatype='real' name='[Calculation_5326210274918715392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([item_revenue])' />
      </column>
      <column caption='tMart revenue share' datatype='real' default-format='p0.00%' name='[Calculation_5326210274918952961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[tmart orders (copy)_3658400664279392262]/[Calculation_5326210274918715392]' />
      </column>
      <column caption='SKU count - tMart' datatype='integer' name='[SKU count (copy)_3658400664280657929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_grocery_darkstore] then [master_id] end)' />
      </column>
      <column caption='SKU count -  GMP' datatype='integer' name='[SKU count - tMart (copy)_3658400664281042954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if NOT [is_grocery_darkstore] then [master_id] end)' />
      </column>
