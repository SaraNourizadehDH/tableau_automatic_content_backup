        <calculation class='tableau' formula='COUNTD(if [is_grocery_darkstore] then [analytical_customer_id] end)' />
      </column>
      <column caption='customers only GMP' datatype='integer' name='[customers only tmart (copy)_3658400664285159440]' role='measure' type='quantitative'>
