        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1in9fwe1cjc0es1givf3q12j5m47' name='Custom SQL Query' type='text'><![CDATA[SELECT date, chains.chain_id, chain_name, page_vertical, count(distinct session_id) as total_sessions FROM `tlb-data-prod.data_platform.fct_sub_session_click_vendor` sessions
left join `tlb-data-prod.data_platform.dim_vendor_info` vendors on sessions.clicked_vendor_id = vendors.vendor_id  
left join `tlb-data-prod.data_platform.dim_chain` chains on vendors.chain_id = chains.chain_id
WHERE date >>= "2022-06-01"
and vertical<<>>'food' and (sub_vertical= 'marketplace' or sub_vertical is null or is_dsaas) 
and country_code = 'AE'
and page_vertical is not null group by 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1in9fwe1cjc0es1givf3q12j5m47' name='Custom SQL Query' type='text'><![CDATA[SELECT date, chains.chain_id, chain_name, page_vertical, count(distinct session_id) as total_sessions FROM `tlb-data-prod.data_platform.fct_sub_session_click_vendor` sessions
