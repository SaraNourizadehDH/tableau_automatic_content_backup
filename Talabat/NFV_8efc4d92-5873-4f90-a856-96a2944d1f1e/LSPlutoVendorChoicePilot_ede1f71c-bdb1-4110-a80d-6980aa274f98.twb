    <worksheet name='Coverage Gap Donut'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f28e2b' fontsize='12'>Chain Coverage Gap</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Across vendor delivery locations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Agg NFV Vendor Choice ' name='federated.0syly0c0g2nljt128dhd4109bvxf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.0syly0c0g2nljt128dhd4109bvxf].[observed_at_date]' caption='Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-06-20#'>
              <calculation class='tableau' formula='#2025-06-20#' />
              <range granularity='1' period-type-v2='day' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0syly0c0g2nljt128dhd4109bvxf].[location_id]' caption='Location Parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0syly0c0g2nljt128dhd4109bvxf].[platform_vendor_list_type]' caption='Vendor List Parameter' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0syly0c0g2nljt128dhd4109bvxf].[country_code]' caption='Country Code Parameter' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;AE&quot;'>
              <calculation class='tableau' formula='&quot;AE&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0syly0c0g2nljt128dhd4109bvxf].[platform_code]' alias='Deliveroo' caption='Platform Code Parameter' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;do&quot;'>
              <calculation class='tableau' formula='&quot;do&quot;' />
              <aliases>
                <alias key='&quot;do&quot;' value='Deliveroo' />
                <alias key='&quot;su&quot;' value='Snoonu' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0syly0c0g2nljt128dhd4109bvxf'>
            <column caption='Chain Coverage Gap %' datatype='real' default-format='p0.0%' name='[Calculation_6188157008580182031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - ([coverage_matched_chain_location_count] / [chain_matched_chain_location_count])' />
            </column>
            <column caption='Is on date' datatype='boolean' name='[Calculation_6188157008649461778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = [observed_at_date]' />
            </column>
            <column caption='# Chain Covered Locations' datatype='integer' name='[Calculation_6188157008698507286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[coverage_matched_chain_location_count]' />
            </column>
            <column caption='Location Filter' datatype='boolean' name='[Calculation_6188157009370578973]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[location_id] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_6188157009393229856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
