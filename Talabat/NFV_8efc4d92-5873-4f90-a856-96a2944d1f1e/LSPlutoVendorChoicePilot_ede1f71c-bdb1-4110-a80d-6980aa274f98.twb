      <aliases enabled='yes' />
      <column caption='# Chain Coverage Matched Location' datatype='integer' name='[# Coverage Matched Vendor Locations (copy)_6188157008701816857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_matched_chain_location_count]' />
      </column>
      <column caption='# Coverage Matched Vendor Locations (copy)' datatype='integer' name='[# Coverage Matched Vendor Locations (copy)_6188157009401815077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_matched_chain_location_count]' />
      </column>
      <column caption='# Unmatched Chains' datatype='integer' name='[# Total Chains (copy)_6188157009394860065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[competitor_vendor_count] - [chain_matched_vendor_count]' />
      </column>
      <column caption='# Vendor Inventory Gap Locations' datatype='integer' name='[# Unmatched Vendors (copy)_1102115293864845313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vendor_unmatched_inventory_location_count]' />
      </column>
      <column caption='% Vendor Match' datatype='real' default-format='p0.00%' name='[% Chain Match (copy)_6188157008579080205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inventory_unmatched_vendor_count] / [chain_matched_vendor_count]' />
      </column>
      <column caption='# Matched Vendor Inventory' datatype='integer' name='[Calculation_1102115293865365506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[chain_matched_vendor_count] - [# Unmatched Vendors (copy)_1102115293864845313]' />
      </column>
      <column caption='# No Gap Locations' datatype='integer' name='[Calculation_1102115294166331396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[availability_matched_chain_location_count]' />
      </column>
      <column caption='% Vendor Gaps' datatype='real' default-format='p0.00%' name='[Calculation_1102115294190243845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([churned_vendor_inventory_location_count] + [vendor_unmatched_coverage_location_count] + [# Unmatched Vendors (copy)_1102115293864845313]) /[chain_matched_location_count]' />
      </column>
      <column caption='# Chain Matched Locations' datatype='integer' name='[Calculation_1102115295557259270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[chain_matched_chain_location_count]' />
      </column>
      <column caption='# Churned Vendor Count' datatype='integer' name='[Calculation_1102115295595532296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inventory_unmatched_churned_vendor_count]' />
      </column>
      <column caption='# Vendors with Coverage Gap' datatype='integer' name='[Calculation_1102115295595806729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_unmatched_vendor_count]' />
      </column>
      <column caption='# Vendors to Acquire' datatype='integer' name='[Calculation_1102115295596068874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inventory_unmatched_vendor_count]' />
      </column>
      <column caption='Vendor Match Count' datatype='integer' name='[Calculation_6188157008249638913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [gap_reason] = &quot;Chain not on Talabat&quot;&#10;then [pluto_vendor_id] end&#10;)' />
      </column>
      <column caption='Inventory Gap' datatype='real' default-format='p0.00%' name='[Calculation_6188157008282521604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (COUNTD([tlb_vendor_id]) / COUNTD([pluto_vendor_id]))' />
      </column>
      <column caption='Chain Inventory Gap' datatype='real' default-format='p0.00%' name='[Calculation_6188157008573296645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6188157008574140422] / [Calculation_6188157008574484487]' />
      </column>
      <column caption='# Chains Matched' datatype='integer' name='[Calculation_6188157008574140422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[chain_matched_vendor_count]' />
      </column>
      <column caption='# Total Chains' datatype='integer' name='[Calculation_6188157008574484487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[competitor_vendor_count]' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_6188157008574730248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='% Chain Match' datatype='real' default-format='p0.00%' name='[Calculation_6188157008576921609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([chain_matched_vendor_count] / [competitor_vendor_count])' />
      </column>
      <column caption='# Vendors Matched' datatype='integer' name='[Calculation_6188157008578301962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inventory_matched_vendor_count]' />
      </column>
      <column caption='# Total Competitor Vendors' datatype='integer' name='[Calculation_6188157008578543627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[competitor_vendor_count]' />
      </column>
      <column caption='Vendor-location-grain' datatype='string' name='[Calculation_6188157008579850254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pluto_vendor_id] + STR([location_id])' />
      </column>
      <column caption='Chain Coverage Gap %' datatype='real' default-format='p0.0%' name='[Calculation_6188157008580182031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([coverage_matched_chain_location_count] / [chain_matched_chain_location_count])' />
      </column>
      <column caption='Is on date' datatype='boolean' name='[Calculation_6188157008649461778]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [observed_at_date]' />
      </column>
      <column caption='Last 14 days' datatype='boolean' name='[Calculation_6188157008697180179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[observed_at_date] &lt;= [Parameters].[Parameter 1] and [observed_at_date] &gt;= [Parameters].[Parameter 1] - 14' />
      </column>
      <column caption='# Vendor Matched Locations' datatype='integer' name='[Calculation_6188157008698392597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vendor_matched_location_count]' />
      </column>
      <column caption='# Chain Covered Locations' datatype='integer' name='[Calculation_6188157008698507286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_matched_chain_location_count]' />
      </column>
      <column caption='# Accessible Vendor Locations' datatype='integer' name='[Calculation_6188157008700153879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[availability_matched_chain_location_count]' />
      </column>
      <column caption='Heatmap Color' datatype='real' name='[Calculation_6188157009316507674]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Chain Inventory Gap&apos; THEN [Calculation_6188157008576921609]&#10;    WHEN &apos;Vendor Inventory Gap&apos; THEN [% Chain Match (copy)_6188157008579080205]&#10;    WHEN &apos;Coverage Gap&apos; THEN [Calculation_6188157008580182031]&#10;    WHEN &apos;Accessibility Gap&apos; THEN [Coverage Gap % (copy)_6188157008582819856]&#10;END' />
      </column>
      <column caption='Location Filter' datatype='boolean' name='[Calculation_6188157009370578973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[location_id] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='MIN(1)' datatype='integer' name='[Calculation_6188157009393229856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='# Unmatched Vendors' datatype='integer' name='[Calculation_6188157009399459874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[chain_matched_vendor_count] - [vendor_matched_vendor_count]' />
      </column>
      <column caption='# Unmatched Coverage Locations' datatype='integer' name='[Calculation_6188157009399906339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_unmatched_chain_location_count]' />
      </column>
      <column caption='# Inaccessible Coverage Matched' datatype='integer' name='[Calculation_6188157009401262116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage_matched_chain_location_count] - [availability_matched_chain_location_count]' />
      </column>
      <column caption='Platform Code Filter' datatype='boolean' name='[Calculation_6188157009639264298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] = [platform_code]' />
      </column>
      <column caption='Country Code Filter' datatype='boolean' name='[Calculation_6188157009642090539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_code] = [Parameters].[Parameter 5]' />
      </column>
      <column caption='Accessibility Gap %' datatype='real' default-format='p0.0%' name='[Coverage Gap % (copy)_6188157008582819856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([availability_matched_chain_location_count] / [coverage_matched_chain_location_count])' />
      </column>
      <column caption='Pie Parameter 1' datatype='integer' name='[Heatmap Color (copy)_6188157009339285531]' role='measure' type='quantitative'>
