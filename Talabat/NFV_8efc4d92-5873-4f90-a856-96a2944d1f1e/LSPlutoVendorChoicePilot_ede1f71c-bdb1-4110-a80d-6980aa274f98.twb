            <column caption='Area Name' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column-instance column='[location_id]' derivation='Attribute' name='[attr:location_id:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[availability_matched_chain_location_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[chain_matched_chain_location_count]' role='measure' type='quantitative' />
