        <param name='target' value='Pluto Choice Gap' />
      </command>
    </action>
    <edit-parameter-action caption='Parameter1' name='[Action1_E20F65F363D5433A872540987A56D46A]'>
      <activation type='on-select' />
      <source dashboard='Pluto Choice Gap' type='sheet' worksheet='Main Map' />
