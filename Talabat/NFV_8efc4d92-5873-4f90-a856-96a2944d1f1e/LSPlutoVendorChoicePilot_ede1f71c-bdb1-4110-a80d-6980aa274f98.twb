  <actions>
    <action caption='Stats -&gt; Action' name='[Action2_F99FE989696C4C5281D1980B2669618A]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Pluto Choice Gap' type='sheet' worksheet='Gap Stats' />
