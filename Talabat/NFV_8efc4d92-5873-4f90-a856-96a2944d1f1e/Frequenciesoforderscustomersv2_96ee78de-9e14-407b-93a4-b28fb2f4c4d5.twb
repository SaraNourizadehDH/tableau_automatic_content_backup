      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_379FF564F9E14FA984CB026F59D6FFA6'>
            <properties context=''>
              <relation connection='bigquery.1qu91sa0yyqvpj17lq2pl0o8k19b' name='Custom SQL Query' type='text'><![CDATA[select * from (SELECT  
month,country_iso,vendor_id
,count(distinct case when total_orders = 1 then analytical_customer_id else null end ) as _1_
,count(distinct case when total_orders >>= 2 and total_orders <<=3 then analytical_customer_id else null end ) _2_3_
,count(distinct case when total_orders >>= 4 and total_orders <<=6 then analytical_customer_id else null end ) _4_6_
,count(distinct case when total_orders >>= 7 and total_orders <<=9 then analytical_customer_id else null end ) _7_9_
,count(distinct case when total_orders >>= 10  then analytical_customer_id else null end ) _10_and_more_
,count(distinct analytical_customer_id) total_cusotmers
,sum(total_orders) total_orders
,sum(case when total_orders = 1 then total_orders else 0 end ) as _1_orders
,sum(case when total_orders >>= 2 and total_orders <<=3 then total_orders else 0 end ) _2_3_orders
,sum(case when total_orders >>= 4 and total_orders <<=6 then total_orders else 0 end ) as _4_6_orders
,sum(case when total_orders >>= 7 and total_orders <<=9 then total_orders else 0 end ) _7_9_orders
,sum(case when total_orders >>= 10  then total_orders else 0 end ) _10_and_more_orders

FROM (SELECT 
analytical_customer_id,country_iso,vendor_id,
date_trunc(order_date, month) month
,count(distinct order_id) as total_orders
 FROM (select analytical_customer_id, order_date,order_id, is_successful ,country_iso,vendor_id

from `bta---talabat.data_platform.fct_order_info` 
where 
date_trunc(safe_cast(order_date as date), month)>>= '2019-01-01'
  and order_date << date_trunc(current_date(),month)
  and is_test is false and is_successful is true and analytical_customer_id is not null )
group by analytical_customer_id,country_iso, date_trunc(order_date, month),vendor_id)
group by  country_iso, month,vendor_id ) orders

left join `bta---talabat.data_platform.dim_vendor_info` vendors
on orders.vendor_id = vendors.source_system_vendor_id
left join `bta---talabat.data_platform.dim_chain` chains
on vendors.chain_id = chains.source_system_chain_id
where vertical<<>>'food' AND (sub_vertical='marketplace' OR sub_vertical IS NULL)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
