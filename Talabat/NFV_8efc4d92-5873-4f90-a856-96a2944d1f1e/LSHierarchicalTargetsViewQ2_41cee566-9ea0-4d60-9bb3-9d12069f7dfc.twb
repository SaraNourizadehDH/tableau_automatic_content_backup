          <datasource-dependencies datasource='federated.0v7pajg124enab1cicgrk1pbkcuf'>
            <column caption='AVG 3M IND' datatype='real' name='[AVG 3M OPS (copy 2)_5065845961362571268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;, &apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) end) /&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;, &apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;)then [net_qty_ordered] end)) then 0&#10;ELSE&#10;&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;, &apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items])  end) /&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;, &apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then [net_qty_ordered] end)&#10;END' />
            </column>
            <column caption='AVG 3M VNFR' datatype='real' name='[AVG 3M OPS (copy 2)_5065845961362784261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;) then [failed_orders_due_to_vendor] end) /&#10;sum(if [vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;) then [net_orders] end)) then 0&#10;ELSE&#10;&#10;sum(if [vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;) then [failed_orders_due_to_vendor] end) /&#10;sum(if [vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;) then [net_orders] end)&#10;END' />
            </column>
            <column caption='AVG Vertical NCR' datatype='real' name='[AVG GMV (copy)_6786713565568114697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ncr_potential_category] = &apos;High&apos; and [Current GMV (copy)_6585458957199040512]=0 then&#10;&#10;((({FIXED [date],[country_code], [vertical]: SUM([ncr_lc])}) / ({FIXED [date],[country_code], [vertical]: SUM([gmv])})) * ({FIXED [date],[country_code], [vertical], [chain_category], [chain_name]: SUM([gmv])/3})) * 0.50&#10;&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Vertical OPS' datatype='real' name='[AVG OPS (copy)_3530540665091325964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date],[country_code], [vertical] : ([Calculation_6260355353773420548])}' />
            </column>
            <column datatype='real' name='[Adjusted GMV% (Adjusted%1)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Affordability Targets (Inputs.vertical1)]' role='measure' type='quantitative' />
            <column caption='Adjusted Target GMV' datatype='real' name='[Calculation_1884193529137491969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Chain GMV% (copy)_1718545501197000709] + &#10;&#10;&#10;(sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: ([Target GMV (copy)_4491988820758929408]* MAX([Adjusted GMV% (Adjusted%1)]))}))' />
            </column>
            <column caption='OPS%' datatype='real' name='[Calculation_3530540665092309006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([OPS Targets (Inputs.vertical1)]) - MAX([AVG OPS (copy)_3530540665091325964])) / MAX([AVG OPS (copy)_3530540665091325964])' />
            </column>
            <column caption='Target OPS' datatype='real' name='[Calculation_3530540665095090192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) &gt;=1 then 1 else (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) END' />
            </column>
            <column caption='AVG 3M GMV' datatype='real' name='[Calculation_5628303298836860935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv]/3' />
            </column>
            <column caption='AVG 3M OPS' datatype='real' name='[Calculation_6260355353773420548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;,&apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) else [failed_orders_due_to_vendor] end) /&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;,&apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then [net_qty_ordered] else [net_orders] end)) then 0&#10;ELSE&#10;&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;,&apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) else [failed_orders_due_to_vendor] end) /&#10;sum(if [vertical] in (&apos;Grocery - AAA&apos;,&apos;Grocery - Non-AAA&apos;, &apos;pharmacy&apos;) then [net_qty_ordered] else [net_orders] end)&#10;END' />
            </column>
            <column caption='Target GMV' datatype='real' name='[Chain GMV% (copy)_1718545501197000709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: ([Target GMV (copy)_4491988820758929408])})' />
            </column>
            <column caption='AVG 3M NCR' datatype='real' name='[Current GMV (copy)_6585458957199040512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ncr_lc]/3' />
            </column>
            <column caption='AVG 3M Affordability ' datatype='real' name='[Current OPS (copy)_6786713565563510787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum([total_spu_discount]) /&#10;sum([total_spu_gmv_eur])) then 0&#10;ELSE&#10;&#10;sum([total_spu_discount]) /&#10;sum([total_spu_gmv_eur])&#10;END' />
            </column>
            <column datatype='real' name='[GMV Targets (Inputs.vertical1)]' role='measure' type='quantitative' />
            <column datatype='real' name='[IND Targets]' role='measure' type='quantitative' />
            <column datatype='real' name='[NCR Targets (Inputs.vertical1)]' role='measure' type='quantitative' />
            <column datatype='real' name='[OPS Targets (Inputs.vertical1)]' role='measure' type='quantitative' />
            <column caption='IND OPS% ' datatype='real' name='[OPS% (copy)_5065845961363656712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([IND Targets]) - MAX([Vertical OPS (copy)_5065845961363001350])) / MAX([Vertical OPS (copy)_5065845961363001350])' />
            </column>
            <column caption='VNFR OPS%' datatype='real' name='[OPS% (copy)_5065845961363922953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([VNFR Targets]) - MAX([Vertical OPS (copy)_5065845961363070983])) / MAX([Vertical OPS (copy)_5065845961363070983])' />
            </column>
            <column caption='Affordability%' datatype='real' name='[OPS% (copy)_6786713565564596229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Affordability Targets (Inputs.vertical1)]) - sum([Vertical OPS (copy)_6786713565564436484])) / sum([Vertical OPS (copy)_6786713565564436484])' />
            </column>
            <column caption='Target GMV calculation' datatype='real' name='[Target GMV (copy)_4491988820758929408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: SUM([gmv])}) / sum({FIXED [date],[country_code], [vertical]: SUM([gmv])}))&#10;*&#10;sum([GMV Targets (Inputs.vertical1)])' />
            </column>
            <column caption='Target NCR' datatype='real' name='[Target GMV (copy)_6786713565561851906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: ([Target NCR (copy)_4491988820767514629])})' />
            </column>
            <column caption='Target VNFR' datatype='real' name='[Target IND (copy)_5065845961368514571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([AVG 3M OPS (copy 2)_5065845961362784261] * [OPS% (copy)_5065845961363922953]) + [AVG 3M OPS (copy 2)_5065845961362784261]) &gt;=1 then 1 else (([AVG 3M OPS (copy 2)_5065845961362784261] * [OPS% (copy)_5065845961363922953]) + [AVG 3M OPS (copy 2)_5065845961362784261]) END' />
            </column>
            <column caption='Adjusted Target NCR' datatype='real' name='[Target NCR (copy 2)_6786713565566836744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: ( IF &#10;([Target GMV (copy)_6786713565561851906] + MAX([AVG GMV (copy)_6786713565568114697])) &gt; (0.001 * [Chain GMV% (copy)_1718545501197000709]) AND MAX([chain_category]) = &apos;PP&apos; THEN (0.001 * [Chain GMV% (copy)_1718545501197000709]) &#10;ELSE ([Target GMV (copy)_6786713565561851906] + MAX([AVG GMV (copy)_6786713565568114697]))&#10;END)})' />
            </column>
            <column caption='Target NCR calculation' datatype='real' name='[Target NCR (copy)_4491988820767514629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: SUM([ncr_lc])}) / sum({FIXED [date],[country_code], [vertical]: SUM([ncr_lc])}))&#10;*&#10;sum([NCR Targets (Inputs.vertical1)])' />
            </column>
            <column caption='Target IND' datatype='real' name='[Target OPS (copy 2)_5065845961365278730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([AVG 3M OPS (copy 2)_5065845961362571268] * [OPS% (copy)_5065845961363656712]) + [AVG 3M OPS (copy 2)_5065845961362571268]) &gt;=1 then 1 else (([AVG 3M OPS (copy 2)_5065845961362571268] * [OPS% (copy)_5065845961363656712]) + [AVG 3M OPS (copy 2)_5065845961362571268]) END' />
            </column>
            <column caption='Target Affordability' datatype='real' name='[Target OPS (copy)_6786713565564928006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (&#10;if ISNULL(&#10;&#10;([Current OPS (copy)_6786713565563510787] * [OPS% (copy)_6786713565564596229]) + [Current OPS (copy)_6786713565563510787]) then 0&#10;ELSE&#10;&#10;([Current OPS (copy)_6786713565563510787] * [OPS% (copy)_6786713565564596229]) + [Current OPS (copy)_6786713565563510787]&#10;END)&gt;=1 then 1 ELSE&#10;&#10;(&#10;if ISNULL(&#10;&#10;([Current OPS (copy)_6786713565563510787] * [OPS% (copy)_6786713565564596229]) + [Current OPS (copy)_6786713565563510787]) then 0&#10;ELSE&#10;&#10;([Current OPS (copy)_6786713565563510787] * [OPS% (copy)_6786713565564596229]) + [Current OPS (copy)_6786713565563510787]&#10;END)&#10;&#10;END' />
            </column>
