      <aliases enabled='yes' />
      <column caption='ncr%' datatype='real' name='[Calculation_6786713565558087680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_lc]) /&#10;sum({ FIXED [country_code], [date] : SUM([ncr_lc])})' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_6AD50EE8EA20459887109F1130F56BC3]' role='measure' type='quantitative' />
      <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='real' name='[gmv]' role='dimension' type='ordinal' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='date' />
        <field-sort-custom-order field='country_code' />
        <field-sort-custom-order field='vertical' />
        <field-sort-custom-order field='chain_category' />
        <field-sort-custom-order field='chain_name' />
        <field-sort-custom-order field='account_manager_name' />
        <field-sort-custom-order field='is_migrated' />
        <field-sort-custom-order field='gmv' />
        <field-sort-custom-order field='gmv_eur' />
        <field-sort-custom-order field='total_spu_discount' />
        <field-sort-custom-order field='total_spu_gmv_eur' />
        <field-sort-custom-order field='ncr_lc' />
        <field-sort-custom-order field='Calculation_6786713565558087680' />
        <field-sort-custom-order field='ncr_eur' />
        <field-sort-custom-order field='net_qty_ordered' />
        <field-sort-custom-order field='vendor_oos_failed_items' />
        <field-sort-custom-order field='partially_fulfilled_orders_removed_items' />
        <field-sort-custom-order field='failed_orders_due_to_vendor' />
        <field-sort-custom-order field='net_orders' />
        <field-sort-custom-order field='ncr_potential_percentile' />
