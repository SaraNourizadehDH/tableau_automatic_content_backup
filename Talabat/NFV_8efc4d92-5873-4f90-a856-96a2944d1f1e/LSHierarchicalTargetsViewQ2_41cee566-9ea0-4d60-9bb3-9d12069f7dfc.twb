        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.0oxq56u06k415j1b2mukm0em5yi1' name='Inputs.vertical1' table='[Inputs#vertical$]' type='table'>
          <columns gridOrigin='A1:N181:no:A1:N181:0' header='yes' outcome='2'>
            <column datatype='date' name='Date' ordinal='0' />
            <column datatype='string' name='Country' ordinal='1' />
            <column datatype='string' name='vertical' ordinal='2' />
            <column datatype='integer' name='GMV Forecasting' ordinal='3' />
            <column datatype='real' name='GMV Targets' ordinal='4' />
            <column datatype='real' name='IND Targets' ordinal='5' />
            <column datatype='real' name='VNFR Targets' ordinal='6' />
            <column datatype='real' name='OPS Targets' ordinal='7' />
            <column datatype='real' name='NCR Targets' ordinal='8' />
            <column datatype='real' name='Affordability Targets' ordinal='9' />
            <column datatype='real' name='GMV% Forecasting' ordinal='10' />
            <column datatype='real' name='NCR Target%' ordinal='11' />
