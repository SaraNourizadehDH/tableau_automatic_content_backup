        <calculation class='tableau' formula='sum({FIXED [date],[country_code], [vertical],[chain_category],[account_manager_name], [chain_name]: ( IF &#10;([Target GMV (copy)_6786713565561851906] + MAX([AVG GMV (copy)_6786713565568114697])) &gt; (0.001 * [Chain GMV% (copy)_1718545501197000709]) AND MAX([chain_category]) = &apos;PP&apos; THEN (0.001 * [Chain GMV% (copy)_1718545501197000709]) &#10;ELSE ([Target GMV (copy)_6786713565561851906] + MAX([AVG GMV (copy)_6786713565568114697]))&#10;END)})' />
      </column>
