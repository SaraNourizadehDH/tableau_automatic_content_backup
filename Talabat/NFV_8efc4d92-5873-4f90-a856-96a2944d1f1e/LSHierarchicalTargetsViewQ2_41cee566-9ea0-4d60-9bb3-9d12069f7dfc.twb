          <object caption='Main query' id='_71DC00A8FDC54D88BB3A79902AA0C6CA'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Main query].[country_code]' />
                      <expression op='[Adjusted%].[Country]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Main query].[date]' />
                      <expression op='DATE([Adjusted%].[Date])' />
                    </expression>
                    <expression op='='>
                      <expression op='[Main query].[vertical]' />
                      <expression op='[Adjusted%].[Vertical]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Main query].[bucket]' />
                      <expression op='[Adjusted%].[Bucket]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Main query].[chain_category]' />
                      <expression op='[Adjusted%].[Category]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.0jgfy27193j21t17t3w3e0n0b7vr' name='Main query' type='text'><![CDATA[with all_data as (with 
date_data as (
SELECT
    distinct
    date_trunc(date, month) AS date  
    FROM
      `tlb-data-prod.data_platform.dim_date`
    WHERE
      date BETWEEN '2024-04-01' AND '2024-06-30'),
gmv_data as (
WITH chain_gmv AS (
    SELECT
        c.country_code,
        case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end vertical,
        CASE 
            WHEN lead_data_origin = 'PP' THEN 'PP'
            ELSE 'LB'
        END AS chain_category,
        c.chain_name,
        max(case when v.vendor_id = 687860 then 'Ahmad Dachach' else  v.account_manager_name end) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_orders end), 0) as net_orders,
        SUM(COALESCE(SUM(delivered_lc), 0)) OVER (PARTITION BY c.country_code ORDER BY SUM(delivered_lc) DESC, c.chain_name) AS country_cumulative_gmv,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

    FROM `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) 
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2023-12-01' and '2024-02-29' 
        AND is_non_food
        AND NOT is_darkstore
        AND vertical = 'grocery'
        AND (lead_data_origin <<>> 'SS' or lead_data_origin is null)
    GROUP BY 1, 2, 3,4
)
SELECT
    country_code,
    vertical,
    CASE 
      WHEN chain_category = 'PP' THEN 'PP'
      WHEN chain_category = 'LB' THEN
        CASE
          WHEN country_code = 'AE' AND country_cumulative_gmv <<= 0.670 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'AE') THEN 'LB'
          WHEN country_code = 'BH' AND country_cumulative_gmv <<= 0.950 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'BH') THEN 'LB'
          WHEN country_code = 'EG' AND country_cumulative_gmv <<= 0.778 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'EG') THEN 'LB'
          WHEN country_code = 'JO' AND country_cumulative_gmv <<= 0.814 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'JO') THEN 'LB'
          WHEN country_code = 'KW' AND country_cumulative_gmv <<= 0.897 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'KW') THEN 'LB'
          WHEN country_code = 'OM' AND country_cumulative_gmv <<= 0.923 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'OM') THEN 'LB'
          WHEN country_code = 'QA' AND country_cumulative_gmv <<= 0.911 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'QA') THEN 'LB'
          ELSE 'LT'
        END
      ELSE 'LT'
    END AS chain_category,
    chain_name,
    account_manager_name,    
    is_migrated,
    gmv,
    gmv_eur,
    total_spu_discount,
    total_spu_gmv_eur,
    ncr_lc,
    ncr_eur,
    net_qty_ordered,        
    vendor_oos_failed_items,
    partially_fulfilled_orders_removed_items,
    failed_orders_due_to_vendor,
    net_orders,
    ncr_potential_percentile,
    CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.60 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category,

FROM
    chain_gmv

union all

select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.60 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        c.country_code,
        vertical,
        vertical AS chain_category,
        c.chain_name,
        max(case when v.vendor_id = 687860 then 'Ahmad Dachach' else  v.account_manager_name end)  as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) 
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2023-12-01' and '2024-02-29'
        AND is_non_food
        AND NOT is_darkstore
        AND vertical <<>> 'grocery'
        group by 1,2,3,4) a


union all
select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.60 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        c.country_code,
        "Speciality Stores" as vertical,
        vertical AS chain_category,
        c.chain_name,
        max(case when v.vendor_id = 687860 then 'Ahmad Dachach' else  v.account_manager_name end)  as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pp.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-01-01' and '2024-01-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) 
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2023-12-01' and '2024-02-29'
        AND is_non_food
        AND NOT is_darkstore
        AND lead_data_origin = 'SS'
        group by 1,2,3,4) a)

select 
  date, 
  g.*,
  case when vertical in ('grocery', 'pharmacy') then safe_divide((partially_fulfilled_orders_removed_items + vendor_oos_failed_items), net_qty_ordered) 
  else safe_divide(failed_orders_due_to_vendor, net_orders) end as ops,

from date_data
cross join gmv_data g where g.gmv>>0),

median_data AS (
  SELECT
  distinct
    date,
    country_code,
    vertical,
    chain_category,
    chain_name,
    PERCENTILE_CONT(gmv/3, 0.5) OVER (PARTITION BY country_code,vertical,chain_category) AS median_gmv,
    PERCENTILE_CONT(ops, 0.5) OVER (PARTITION BY country_code,vertical,chain_category) AS median_ops,

  FROM
    all_data )

  select a.*,median_gmv,median_ops,
  case when gmv/3 >>= median_gmv and ops<<= median_ops then "High GMV - Good OPS"
  when gmv/3 >>= median_gmv and ops>> median_ops then "High GMV - Bad OPS" 
  when gmv/3 << median_gmv and ops<<= median_ops then "Low GMV - Good OPS" 
  else "Low GMV - Bad OPS"
  END as bucket
  from all_data a
  left join median_data m on a.country_code = m.country_code and a.vertical = m.vertical and a.chain_category = m.chain_category and a.date = m.date and a.chain_name= m.chain_name]]></relation>
                <relation connection='cloudfile:googledrive-excel-direct.0oxq56u06k415j1b2mukm0em5yi1' name='Adjusted%' table='[&apos;Adjusted%$&apos;]' type='table'>
