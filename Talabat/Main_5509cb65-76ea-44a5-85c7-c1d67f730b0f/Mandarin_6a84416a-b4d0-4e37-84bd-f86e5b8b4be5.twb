        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0lm94eh1dzkvmk1ece7x60z68myd' name='Custom SQL Query' type='text'><![CDATA[with
vendors_data as (
select
  case when is_non_food and is_darkstore then 'tmart' 
  when is_non_food and not is_darkstore then 'NFV' end as vertical,
  city_name,
  area_name,
  chain_id,
  chain_name,
  vendor_id,
  vendor_name
from `tlb-data-prod.data_platform.dim_vendor_info` v
left join `tlb-data-prod.data_platform.dim_chain` c using(chain_id)
left join `tlb-data-prod.data_platform.dim_location_info` l on v.location_id =l.location_id and c.country_code = l.country_code
where ((is_non_food and is_darkstore) or (is_non_food and chain_id in (27514,659615,634298,650795,625588)))
and c.country_code = 'AE'
and is_active
order by 1,2,3,4,5,6,7),
orders_data as (
  select
    o.order_date,
    o.vendor_id,
    product_sku as SKU,
    item_name_en,
    sum(sold_quantity) as qty_sold

  from `tlb-data-prod.data_platform.fct_order_item` o
  left join `tlb-data-prod.data_platform.fct_order_info` f on o.order_id = f.order_id  and o.order_date = f.order_date
  left join `tlb-data-prod.data_platform.dim_item` i on o.item_id = i.item_id
  where o.order_date >>='2023-03-15' and o.order_date <<current_date()
  and is_successful
  and ((is_non_food and is_darkstore) or (is_non_food and f.chain_id in (27514,659615,634298,650795,625588)))
  group by 1,2,3,4
)

select
  v.*, o.* except(vendor_id)
  from vendors_data v
left join orders_data o on v.vendor_id = o.vendor_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
