      <column caption='CVR' datatype='real' name='[Calculation_1375005264193888256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order_sessions])/SUM([sessions])' />
      </column>
      <column caption='AOV(LC)' datatype='real' name='[Calculation_1375005264194990081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_gmv])/SUM([successful_orders])' />
      </column>
      <column caption='Fail rate%' datatype='real' name='[Calculation_2534119219383504896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
      </column>
      <column caption='Average Discount/ Order' datatype='real' name='[Calculation_2534119219383857153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_incentive])/sum([successful_orders])' />
