      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Data source' id='_9B01FC0B3DFB4F85BB57C6A068B97E5E'>
            <properties context=''>
              <relation connection='bigquery.1njsj7e035cwlz11qg93s1f1ebe8' name='Custom SQL Query' type='text'><![CDATA[with
time_data as (
  SELECT DATETIME(TIMESTAMP_SECONDS(seconds)) as time
FROM UNNEST(GENERATE_ARRAY(
    UNIX_SECONDS(DATE_TRUNC(TIMESTAMP('2023-03-15'), DAY)),
    UNIX_SECONDS(DATE_TRUNC(TIMESTAMP(CURRENT_DATE()), DAY)) + 86399,
    1
)) as seconds

),
 vendors_data as (
select
  case when is_non_food and is_darkstore then 'tmart' 
  when is_non_food and not is_darkstore then 'NFV' end as vertical,
  city_name,
  area_name,
  chain_id,
  chain_name,
  vendor_id,
  vendor_name
from `tlb-data-prod.data_platform.dim_vendor_info` v
left join `tlb-data-prod.data_platform.dim_chain` c using(chain_id)
left join `tlb-data-prod.data_platform.dim_location_info` l on v.location_id =l.location_id and c.country_code = l.country_code
where ((is_non_food and is_darkstore) or (is_non_food and chain_id in (27514,659615,634298,650795,625588)))
and c.country_code = 'AE'
and is_active
order by 1,2,3,4,5,6,7),
sessions_data as (
  select
    FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', DATETIME(start_time_lc)) AS session_time,
    vendor_id,
    count(distinct session_id) as sessions,
    count(distinct user_id) as users,
    count(distinct case when added_to_cart then session_id end) as added_to_cart_sessions,
    count(distinct case when started_checkout then session_id end) as started_checkout_sessions,
    count(distinct case when placed_order then session_id end) as placed_order_sessions,
from
`tlb-data-prod.data_platform.fct_session_vendor_today`
group by 1,2

  union all
  select
    FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', DATETIME(sub_session_start_time)) AS session_time,
    cast(vendor_id as string) as vendor_id,
    count(distinct session_id) as sessions,
    count(distinct user_id) as users,
    count(distinct case when added_to_cart then session_id end) as added_to_cart_sessions,
    count(distinct case when started_checkout then session_id end) as started_checkout_sessions,
    count(distinct case when placed_order then session_id end) as placed_order_sessions,
from
`tlb-data-prod.data_platform.fct_sub_session_menu`
  where date >>='2023-03-15' and date <<current_date()

group by 1,2
),
orders_data as (
  select
  FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', DATETIME(order_time_lc)) AS order_time_lc,
  vendor_id,
  count(distinct order_id) as total_orders,
  sum(gmv_amount_lc) as total_gmv_lc,
  sum(incentive_amount_lc) as discount_gmv_lc,
  count(distinct case when status = 'DELIVERED' then order_id end) as successful_orders,
  count(distinct case when status = 'CANCELLED' then order_id end) as failed_orders,
  sum(distinct case when status = 'DELIVERED' then gmv_amount_lc end) as successful_gmv,
  sum(distinct case when status = 'CANCELLED' then gmv_amount_lc end) as lost_gmv,
  count(distinct case when status = 'DELIVERED' and not is_account_first_order then account_id end) as existing_customers,
  count(distinct case when status = 'DELIVERED' and is_account_first_order then account_id end) as platform_acquisition,
  count(distinct case when status = 'DELIVERED' and is_account_chain_first_order then account_id end) as chain_acquisition,
  sum(distinct case when status = 'DELIVERED' then incentive_amount_lc end) as successful_incentive,
  count(distinct case when status = 'DELIVERED' then account_id end) as active_users,

  from `tlb-data-prod.data_platform.fct_order_today`
  group by 1,2
  
  union all
  select
  FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', DATETIME(order_time)) AS order_time_lc ,
  vendor_id, 
  count(distinct o.order_id) as total_orders,
  sum(gmv_amount_lc) as total_gmv_lc,
  sum(incentive_amount_lc) as discount_gmv_lc,
  count(distinct case when is_successful then o.order_id end) as successful_orders,
  count(distinct case when not is_successful then o.order_id end) as failed_orders,
  sum(distinct case when is_successful then gmv_amount_lc end) as successful_gmv,
  sum(distinct case when not is_successful then gmv_amount_lc end) as lost_gmv,
  count(distinct case when is_successful and not is_acquisition then analytical_customer_id end) as existing_customers,
  count(distinct case when is_successful and is_acquisition then analytical_customer_id end) as platform_acquisition,
  count(distinct case when is_successful and customer_chain_order_index = 1 then analytical_customer_id end) as chain_acquisition,
  sum(distinct case when is_successful then incentive_amount_lc end) as successful_incentive,
  count(distinct case when is_successful then analytical_customer_id end) as active_users,
  from `tlb-data-prod.data_platform.fct_order_info` o
  left join `tlb-data-prod.data_platform.fct_order_rank` r 
  on o.order_id = r.order_id and o.order_date = r.order_date
  where o.order_date >>='2023-03-15' and o.order_date <<current_date()
  and ((is_non_food and is_darkstore) or (is_non_food and chain_id in (27514,659615,634298,650795,625588)))
  group by 1,2
)

select
  t.time, v.*, s.*except (vendor_id, session_time), o.* except(vendor_id, order_time_lc)
  from time_data t
cross join 
vendors_data v
left join sessions_data s on cast(v.vendor_id as string) = s.vendor_id and FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', t.time) = s.session_time
left join orders_data o on v.vendor_id = o.vendor_id and FORMAT_DATETIME('%Y-%m-%dT%H:%M:%S', t.time) = o.order_time_lc]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
