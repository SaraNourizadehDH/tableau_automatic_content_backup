            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_9B01FC0B3DFB4F85BB57C6A068B97E5E]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>vertical</remote-name>
