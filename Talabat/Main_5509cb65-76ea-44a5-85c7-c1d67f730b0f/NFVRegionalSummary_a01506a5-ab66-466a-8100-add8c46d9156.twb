      <column caption='Active customers' datatype='integer' name='[Active vendors (copy)_1265792981149208581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful]= True then [analytical_customer_id] END)' />
      </column>
      <column caption='ABV' datatype='real' name='[Average basket size (copy)_1559089944013398018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos; then SUM([basket_amount_lc])/COUNTD(if [is_successful]= True then [order_id] END)&#13;&#10;WHEN &apos;EUR&apos; then SUM([basket_amount])/COUNTD(if [is_successful]= True then [order_id] END)&#13;&#10;END' />
      </column>
      <column caption='DF+SF(EUR)' datatype='real' name='[Average basket value(EUR) (copy)_1265792981148393476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([df_sf])/COUNTD([order_id])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1009932242964774912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful] = TRUE then [order_id] END)' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1009932242965880833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos; then SUM([delivered_gmv_lc])/COUNTD(if [is_successful]= True then [order_id]  END)&#13;&#10;WHEN &apos;EUR&apos; then SUM([delivered_gmv])/COUNTD(if [is_successful]= True then [order_id]  END)&#13;&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1009932242970370050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos; then SUM([delivered_gmv_lc])&#13;&#10;WHEN &apos;EUR&apos; then SUM([delivered_gmv])&#13;&#10;END' />
      </column>
      <column caption='Verticals' datatype='real' name='[Calculation_1055249720182632448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;All&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]&lt;&gt; &apos;food&apos; and ([sub_vertical]= &apos;marketplace&apos; or ISNULL([sub_vertical])) then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;cosmetics&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;cosmetics&apos; then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] =&apos;electronics&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;electronics&apos; then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] =&apos;flowers&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;flowers&apos; then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] =&apos;grocery&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;grocery&apos; and ([sub_vertical]= &apos;marketplace&apos; or ISNULL([sub_vertical]))then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] =&apos;pet shop&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;pet shop&apos; then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] =&apos;pharmacy&apos; THEN&#13;&#10;&#13;&#10;COUNTD(if [vertical]= &apos;pharmacy&apos; then [order_id] end)/countd([order_id])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='verticalss' datatype='string' name='[Calculation_1055249720184840193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vertical]' />
      </column>
      <column caption='ordered gmv' datatype='real' name='[Calculation_1265792981133717504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivered_gmv]) + [GMV LOSS% (copy)_2938598772931010560]' />
      </column>
      <column caption='Item fill rate%' datatype='real' name='[Calculation_1265792981142368258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful] then [qty_delivered] END)/SUM(if [is_successful] then [qty_ordered] END)' />
      </column>
      <column caption='% orders with &gt; 10 items' datatype='real' name='[Calculation_1265792981143617539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [qty_ordered] &gt; 10 then [order_id] END)/COUNTD([order_id])' />
      </column>
      <column caption='Average basket size' datatype='real' name='[Calculation_1559089944012455937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_successful]=  True then [qty_delivered] END) / COUNTD(if [is_successful]= True then [order_id] END)' />
      </column>
      <column caption='Display Filter' datatype='boolean' name='[Calculation_1653384041096417280]' role='measure' type='nominal'>
        <calculation class='tableau' formula='COUNTD([country_iso]) = COUNTD([country_iso])' />
      </column>
      <column caption='NFV Share%' datatype='real' name='[Calculation_1653384041101680641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [vertical]&lt;&gt; &apos;food&apos; and [sub_vertical]&lt;&gt;&apos;darkstore&apos; then [order_id] end)/countd([order_id])' />
      </column>
      <column caption='OOS%' datatype='real' name='[Calculation_1837187204336578561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1837187204337025027] + [Calculation_1837187204336734210]) / COUNTD([order_id])' />
      </column>
      <column caption='Failed orders OOS' datatype='integer' name='[Calculation_1837187204336734210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [vendor_failed_oos_order] then [order_id] END)' />
      </column>
      <column caption='Successful orders with OOS' datatype='integer' name='[Calculation_1837187204337025027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [successful_oos_order] then [order_id] END)' />
      </column>
      <column caption='Active vendors' datatype='integer' name='[Calculation_2380152430884696064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful]= True then [vendor_id] END)' />
      </column>
      <column caption='% Savings in SPU' datatype='real' name='[Calculation_2938598772945616899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([total_discount_spu]) + SUM( [total_gmv_lc_spu])) / SUM([total_gmv_lc_spu])) - 1' />
      </column>
      <column caption='Vertical' datatype='string' name='[Calculation_3009249003494662144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [vertical]= &apos;food&apos; then &apos;Food&apos;&#13;&#10;ELSEIF [sub_vertical]=&apos;darkstore&apos; then &apos;Tmart&apos;&#13;&#10;else &apos;NFV&apos;&#13;&#10;END' />
      </column>
      <column caption='Acquisition' datatype='integer' name='[Calculation_3009249003497865218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful] = True and [is_acquisition_backend]= true then [analytical_customer_id] END)' />
      </column>
      <column caption='Countries' datatype='string' name='[Calculation_3009249003506835460]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([country_iso] = &apos;AE&apos; or [country_iso] = &apos;BH&apos; or [country_iso] = &apos;EG&apos; or [country_iso] = &apos;JO&apos; or [country_iso] = &apos;KW&apos; or [country_iso] = &apos;OM&apos; or [country_iso] = &apos;QA&apos;) then &apos;Regional&apos;&#13;&#10;ELSEIF [country_iso] = &apos;AE&apos; then &apos;AE&apos;&#13;&#10;ELSEIF [country_iso] = &apos;BH&apos; then &apos;BH&apos;&#13;&#10;ELSEIF [country_iso] = &apos;EG&apos; then &apos;EG&apos;&#13;&#10;ELSEIF [country_iso] = &apos;JO&apos; then &apos;JO&apos;&#13;&#10;ELSEIF [country_iso] = &apos;KW&apos; then &apos;KW&apos;&#13;&#10;ELSEIF [country_iso] = &apos;OM&apos; then &apos;OM&apos;&#13;&#10;ELSEIF [country_iso] = &apos;QA&apos; then &apos;QA&apos;&#13;&#10;END' />
      </column>
      <column caption='Commission % of GMV' datatype='real' name='[Calculation_3009249003540439045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivered_commission_amount_eur]) /sum([delivered_gmv])' />
      </column>
      <column caption='GMV LOSS%' datatype='real' default-format='p0.00%' name='[Calculation_455708038445273088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV LOSS% (copy)_2938598772931010560] / [Calculation_1265792981133717504]' />
      </column>
      <column caption='Vendor discount % of GMV' datatype='real' name='[Calculation_456833914383761412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful]= True then [total_discount] end)/ SUM(if [is_successful]= True then [delivered_gmv] end)' />
      </column>
      <column caption='VNFR%' datatype='real' name='[Calculation_456833914511220744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_vendor_net_failed] then [order_id] end)/ COUNTD([order_id])' />
      </column>
      <column caption='NFV Acquisition' datatype='boolean' name='[Calculation_642044442949259264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_acquisition_backend]' />
      </column>
      <column caption='Completed weeks' datatype='boolean' name='[Calculation_861313488462422016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date]&gt;=dateadd(&apos;week&apos;,-3,datetrunc(&apos;week&apos;, today()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;[order_date]&lt;datetrunc(&apos;week&apos;,today())' />
      </column>
      <column caption='Completed months' datatype='boolean' name='[Completed weeks (copy) (copy)_861313488468918274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date]&gt;=dateadd(&apos;month&apos;,-4,datetrunc(&apos;month&apos;, today()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;[order_date]&lt;datetrunc(&apos;month&apos;,today())' />
      </column>
      <column caption='Completed weeks (copy)' datatype='boolean' name='[Completed weeks (copy)_861313488464400385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date]&gt;=dateadd(&apos;week&apos;,-4,datetrunc(&apos;week&apos;, today()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;[order_date]&lt;datetrunc(&apos;week&apos;,today())' />
      </column>
      <column caption='Total lost' datatype='real' default-format='p0.00%' name='[GMV LOSS% (copy)_2938598772931010560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loss_failed_gmv]) + SUM([loss_mod_gmv])' />
      </column>
      <column caption='GMV LOSS % Exc. Other failures' datatype='real' default-format='p0.00%' name='[GMV LOSS% (copy)_2938598772933115905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([GMV LOSS% (copy)_2938598772931010560] - SUM([other_owners_failed_lost_gmv])) / [Calculation_1265792981133717504]' />
      </column>
      <column caption='Fill GMV OOS%' datatype='real' default-format='p0.00%' name='[GMV LOSS% (copy)_455708038446215169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([loss_failed_oos_gmv])+ SUM([loss_partially_fulfilled_oos_gmv])) / [Calculation_1265792981133717504]' />
      </column>
      <column datatype='string' name='[Regional]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='categorical-bin' column='[country_iso]' new-bin='true'>
