          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1i2vjm314e6s861a5hrpm1egdi3k].[Max Date (copy)_4641592758675275788]' caption='Start Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1i2vjm314e6s861a5hrpm1egdi3k].[Calculation_4236479941543251968]' caption='End Date' datatype='date' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-16#'>
              <calculation class='tableau' formula='#2025-08-16#' />
            </column>
