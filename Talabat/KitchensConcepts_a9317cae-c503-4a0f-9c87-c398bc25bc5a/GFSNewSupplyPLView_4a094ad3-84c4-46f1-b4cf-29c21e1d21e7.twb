            <column datatype='real' name='[successful_commissionable_gmv_amount_lc]' role='measure' type='quantitative' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_722194445590904846]' derivation='User' name='[usr:Calculation_722194445590904846:qk]' pivot='key' type='quantitative' />
