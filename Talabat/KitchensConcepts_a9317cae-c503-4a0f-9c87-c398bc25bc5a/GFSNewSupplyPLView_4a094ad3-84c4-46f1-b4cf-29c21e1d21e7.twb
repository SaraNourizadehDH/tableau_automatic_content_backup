        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1ntdjji0aiubeq1d6ufur1fd3rik' name='tincubator daily level' type='text'>SELECT 
o.*
FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily` o
LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = o.vendor_id
WHERE v.chain_id IN (686388,698219)</relation>
          <relation connection='cloudfile:googledrive-excel-direct.0scfvlu0hrogbc18aypmg0j9shrv' name='P&amp;L Metrics' table='[&apos;P&amp;L Metrics$&apos;]' type='table'>
            <columns gridOrigin='A1:J81:no:A1:J81:0' header='yes' outcome='2'>
              <column datatype='string' name='b_name' ordinal='0' />
              <column datatype='string' name='chain_id' ordinal='1' />
              <column datatype='string' name='vendor_id' ordinal='2' />
              <column datatype='string' name='location' ordinal='3' />
              <column datatype='string' name='metric' ordinal='4' />
              <column datatype='date' name='month' ordinal='5' />
              <column datatype='string' name='type' ordinal='6' />
              <column datatype='integer' name='value' ordinal='7' />
              <column datatype='string' name='duration_type' ordinal='8' />
              <column datatype='string' name='source' ordinal='9' />
            </columns>
          </relation>
          <relation connection='bigquery.1ntdjji0aiubeq1d6ufur1fd3rik' name='Custom SQL Query' type='text'>SELECT
            v.source_system_vendor_id as vendor_id,
            v.salesforce_id,
            c.source_system_chain_id as chain_id,
            c.salesforce_id as chain_salesforce_id,
            v.vendor_name as vendor_name_en,
            c.chain_name as chain_name_en,
            l.country_name,
            l.area_name as vendor_area_name,
            v.is_tgo,
            v.is_active,
            v.is_tpro,
        FROM
            `tlb-data-prod.data_platform.dim_vendor_info` v
            LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_location` l on l.location_id = v.location_id
    WHERE v.chain_id  IN (686388,698219)</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
