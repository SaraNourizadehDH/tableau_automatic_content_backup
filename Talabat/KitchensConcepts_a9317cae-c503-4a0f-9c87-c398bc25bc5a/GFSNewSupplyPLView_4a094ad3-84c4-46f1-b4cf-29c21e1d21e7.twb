      <column caption='MTD' datatype='date' name='[PMTD (copy)_4592193930601533475]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if MONTH([dates]) = MONTH([Parameters].[Parameter 2]) &#10;AND YEAR([dates]) = YEAR([Parameters].[Parameter 2])&#10;AND [dates] &lt;= [Parameters].[Parameter 2]&#10;THEN [dates] END' />
      </column>
      <column caption='PWTD' datatype='date' name='[PMTD (copy)_4592193930615849001]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if WEEK([dates]) = WEEK(DATEADD(&apos;week&apos;,-1,[Parameters].[Parameter 2])) &#10;AND YEAR([dates]) = YEAR(DATEADD(&apos;week&apos;,-1,[Parameters].[Parameter 2]))&#10;AND [dates] &lt;= DATEADD(&apos;week&apos;,-1,[Parameters].[Parameter 2])&#10;THEN &#10;[dates] END' />
