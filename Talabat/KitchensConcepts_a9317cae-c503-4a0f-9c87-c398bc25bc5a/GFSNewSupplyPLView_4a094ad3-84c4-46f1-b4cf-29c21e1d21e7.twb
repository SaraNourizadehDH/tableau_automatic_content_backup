      <column caption='Delivery Orders' datatype='integer' name='[Calculation_1878704756760784900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5611766612944183297]-([Calculation_1878704756760051713]+[Calculation_1878704756735848448])' />
      </column>
      <column caption='wingstop brands' datatype='boolean' name='[Calculation_2824108878370422786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [chain_id] IN (675444,635169,679757,607490) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Total Incentive Amount (LC)' datatype='real' name='[Calculation_3462634820500512768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incentive_amount_lc])' />
      </column>
      <column caption='Delay Rate' datatype='real' name='[Calculation_3462634820502679553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_orders_10min])/[Calculation_5611766612944183297]' />
      </column>
      <column caption='Rejection Rate' datatype='real' name='[Calculation_3462634820502810626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_rejected_orders_count])/SUM([all_orders])' />
      </column>
      <column caption='Contact Rate' datatype='real' name='[Calculation_3462634820502921219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([vendor_contact_new]))/SUM(ZN([gross_orders]))' />
      </column>
      <column caption='Month' datatype='date' datatype-customized='true' name='[Calculation_4024881083230191616]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[dates]))' />
      </column>
      <column caption='Cost Of Goods Sold (COGS)' datatype='integer' name='[Calculation_4024881083234140164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(SUM(If [metric] = &quot;cost_of_goods_sold&quot; THEN [value] END))' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_4068017105907478532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5611766612944293890]/[Calculation_5611766612944183297]' />
      </column>
      <column caption='PWTD - True' datatype='boolean' name='[Calculation_4068017105938276363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [PMTD (copy)_4592193930615849001] = [dates] then true end' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_4068017105938513932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_4068017105938276363] then [successful_orders] end' />
      </column>
      <column caption='AOV - GMV' datatype='real' name='[Calculation_4068017105982914575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([s_orders_gmv_amount])/[Calculation_5611766612944183297]' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_4068017106588074000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([viewed_menu_session_count]))' />
      </column>
      <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4068017106588323857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([sum_order_rating]))/&#10;ZN(SUM([count_order_rating (tincubator daily level)]))' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_4236479941543251968]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :MAX([dates])}' />
      </column>
      <column caption='Day - Last' datatype='date' name='[Calculation_4592193930158907395]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='YD GMV' datatype='real' name='[Calculation_4592193930221400072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [dates] = [Calculation_4592193930158907395] THEN [successful_commissionable_gmv_amount_lc] ELSE 0 END' />
      </column>
      <column caption='Date Para Field' datatype='date' name='[Calculation_4592193930511056908]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1] &#10;WHEN &apos;DoD&apos; THEN DATE(DATETRUNC(&apos;day&apos;,[dates]))&#10;WHEN &apos;WoW&apos; THEN DATE(DATETRUNC(&apos;week&apos;,[dates]))&#10;WHEN &apos;MoM&apos; THEN DATE(DATETRUNC(&apos;month&apos;,[dates]))&#10;END' />
      </column>
      <column caption='Test' datatype='boolean' datatype-customized='true' name='[Calculation_4592193930530205715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;DoD&apos; AND [Calculation_4592193930511056908] = [Calculation_4592193930158907395] &#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;DoD&apos; AND [Calculation_4592193930511056908] = [YD Date (copy)_4592193930163441669] &#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;WoW&apos; AND [Calculation_4592193930511056908] = [Calculation_4592193930560356375] THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;WoW&apos; AND [Calculation_4592193930511056908] = [CW (copy)_4592193930562076696] THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MoM&apos; AND [Calculation_4592193930511056908] = [Week - Last (copy)_4592193930563186714] THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;MoM&apos; AND [Calculation_4592193930511056908] = [Week - 2nd Last (copy)_4592193930563186713] THEN TRUE&#10;END' />
      </column>
      <column caption='Week - Last' datatype='date' datatype-customized='true' name='[Calculation_4592193930560356375]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[Calculation_4592193930158907395]))' />
      </column>
      <column caption='Last Month Same Day' datatype='boolean' name='[Calculation_4592193930572587036]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[dates])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()))' />
      </column>
      <column caption='Test 2 ' datatype='boolean' name='[Calculation_4592193930579615773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[dates])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()))' />
      </column>
      <column caption='PMTD' datatype='date' name='[Calculation_4592193930599837728]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if MONTH([dates]) = MONTH(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 2])) &#10;AND YEAR([dates]) = YEAR(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 2]))&#10;AND [dates] &lt;= DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 2])&#10;THEN &#10;[dates] END' />
      </column>
      <column caption='Prep Time' datatype='real' name='[Calculation_4592193930646372405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Avg_FIR_Prep_Time_Sum]))/ZN(SUM([Avg_FIR_Prep_Time_count]))' />
