          <object caption='dim_vendor' id='_19B60B31793047969558AF44647E64D2'>
            <properties context=''>
              <relation connection='bigquery.1ntdjji0aiubeq1d6ufur1fd3rik' name='Custom SQL Query' type='text'>SELECT
            v.source_system_vendor_id as vendor_id,
            v.salesforce_id,
            c.source_system_chain_id as chain_id,
            c.salesforce_id as chain_salesforce_id,
            v.vendor_name as vendor_name_en,
            c.chain_name as chain_name_en,
            l.country_name,
            l.area_name as vendor_area_name,
            v.is_tgo,
            v.is_active,
            v.is_tpro,
        FROM
            `tlb-data-prod.data_platform.dim_vendor_info` v
            LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id
            LEFT JOIN `tlb-data-prod.data_platform.dim_location` l on l.location_id = v.location_id
    WHERE v.chain_id  IN (686388,698219)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_19B60B31793047969558AF44647E64D2' table='[Extract].[_19B60B31793047969558AF44647E64D2]' type='table' />
            </properties>
          </object>
          <object caption='tincubator (Orders, Sessions &amp; Marketing)' id='_7ABB8B6F891944CC9EF6B6CE178459A7'>
            <properties context=''>
              <relation connection='bigquery.1ntdjji0aiubeq1d6ufur1fd3rik' name='tincubator daily level' type='text'>SELECT 
o.*
FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily` o
LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = o.vendor_id
WHERE v.chain_id IN (686388,698219)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_7ABB8B6F891944CC9EF6B6CE178459A7' table='[Extract].[_7ABB8B6F891944CC9EF6B6CE178459A7]' type='table' />
            </properties>
          </object>
        </objects>
