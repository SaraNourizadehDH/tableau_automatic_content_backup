      <column caption='Clicks MRR' datatype='real' name='[Orders MRR (copy)_540713434134921227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_540713434141929497]) THEN (SUM([cpc_nb_clicks])*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE SUM([cpc_nb_clicks]) END' />
