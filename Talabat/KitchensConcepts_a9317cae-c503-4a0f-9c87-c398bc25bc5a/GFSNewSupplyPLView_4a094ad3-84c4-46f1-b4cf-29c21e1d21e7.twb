      <column caption='PMTD 2' datatype='boolean' name='[PMTD (copy)_4592193930600869921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[dates]) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()))&#10;AND [dates] &lt;= DATEADD(&apos;month&apos;,-1,TODAY())&#10;THEN TRUE ELSE FALSE END' />
