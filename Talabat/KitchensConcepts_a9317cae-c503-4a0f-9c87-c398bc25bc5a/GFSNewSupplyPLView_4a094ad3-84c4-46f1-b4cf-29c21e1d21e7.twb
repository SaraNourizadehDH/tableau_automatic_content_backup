            <column datatype='real' name='[fp_revenue_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[kwords_search_revenue_lc]' role='measure' type='quantitative' />
            <column caption='Metric' datatype='string' name='[metric]' role='dimension' type='nominal' />
            <column-instance column='[dates]' derivation='MY' name='[my:dates:ok]' pivot='key' type='ordinal' />
