      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1i2vjm314e6s861a5hrpm1egdi3k].[sum:viewed_menu_session_count:qk]&quot;' value='No. Of Sessions' />
        </aliases>
      </column>
      <column caption='ADF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ADF - CP (copy)_4068017105951117326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_fee_total]/[successful_orders]' />
      </column>
      <column caption='AOV (LC) (GMV)' datatype='real' name='[AOV (LC) (copy)_8033366213479075890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([s_orders_gmv_amount])/SUM([successful_orders])' />
      </column>
      <column caption='AOV (EUR)' datatype='real' name='[AOV (LC) (copy)_8673088463719530517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([s_orders_gmv_amount_eur])/SUM([successful_orders])' />
      </column>
      <column caption='S.C. GMV Amount (LC) (RR)' datatype='real' name='[Basket Value (LC) (RR) (copy)_722194452657819691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_540713434141929497]) THEN ([S.C. GMV Amount (copy)_722194445581811712]*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE [S.C. GMV Amount (copy)_722194445581811712]&#10;END' />
      </column>
      <column caption='CPC Clicks Target' datatype='integer' name='[CPC Clicks (DA) (copy)_540713434136375312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_nb_clicks])' />
      </column>
      <column caption='CPC Clicks Diff vs Target' datatype='real' name='[CPC Clicks Diff vs Target (DA) (copy)_540713434144604188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders MRR (copy)_540713434134921227] - [CPC Clicks (DA) (copy)_540713434136375312]' />
      </column>
      <column caption='GEM Spend MRR' datatype='real' name='[CPC Orders MRR (copy)_540713434141171735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_540713434141929497]) THEN  (SUM([GEM_fees_lc])*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE SUM([GEM_fees_lc]) END' />
      </column>
      <column caption='CPC Orders MRR' datatype='real' name='[CPC Spend MRR (copy)_540713434140065812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_540713434141929497]) THEN &#10;(SUM([cpc_nb_orders_successful])*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE SUM([cpc_nb_orders_successful]) END' />
      </column>
      <column caption='CPC Spend (DA)' datatype='real' name='[CPC Spend Target (DA) (copy)_794463125269028890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_lc])/[Calculation_794463123847561216]' />
      </column>
      <column caption='Week - 2nd Last' datatype='date' datatype-customized='true' name='[CW (copy)_4592193930562076696]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;week&apos;,[Calculation_4592193930158907395])))' />
      </column>
      <column caption='No. Of Ratings' datatype='integer' name='[Calculation_1052716439684632576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_order_rating (tincubator daily level)])' />
      </column>
      <column caption='New Customers' datatype='integer' name='[Calculation_1052716439684841473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_customer])' />
      </column>
      <column caption='ReOrder Rate' datatype='real' default-format='p0%' name='[Calculation_1052716439685201922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([repeated_customer])/(SUM([repeated_customer])+[Calculation_1052716439684841473])' />
      </column>
      <column caption='Offline Rate' datatype='real' name='[Calculation_1749578094703288320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration_mins])/SUM([schedule_duration_mins])' />
