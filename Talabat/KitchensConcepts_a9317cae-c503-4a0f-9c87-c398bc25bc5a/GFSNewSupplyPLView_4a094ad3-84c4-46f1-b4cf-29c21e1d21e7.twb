    <worksheet name='Part 2 (Wasl) (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='tincubator' name='federated.1i2vjm314e6s861a5hrpm1egdi3k' />
          </datasources>
          <datasource-dependencies datasource='federated.1i2vjm314e6s861a5hrpm1egdi3k'>
            <column caption='Cost Of Goods Sold (COGS)' datatype='integer' name='[Calculation_4024881083234140164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM(If [metric] = &quot;cost_of_goods_sold&quot; THEN [value] END))' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_4236479941543251968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([dates])}' />
            </column>
            <column caption='Is Current Month?' datatype='boolean' name='[Calculation_540713434141929497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[dates]) = DATETRUNC(&apos;month&apos;,[Calculation_4236479941543251968]) THEN true else false end' />
            </column>
