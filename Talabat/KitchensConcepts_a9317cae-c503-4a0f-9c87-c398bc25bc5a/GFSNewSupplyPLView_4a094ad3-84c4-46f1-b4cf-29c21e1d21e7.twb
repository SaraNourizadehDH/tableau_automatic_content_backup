              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i2vjm314e6s861a5hrpm1egdi3k'>
            <column datatype='integer' name='[Avg_FIR_Prep_Time_Sum]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Avg_FIR_Prep_Time_count]' role='measure' type='quantitative' />
            <column caption='New Customers' datatype='integer' name='[Calculation_1052716439684841473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_customer])' />
            </column>
            <column caption='ReOrder Rate' datatype='real' default-format='p0%' name='[Calculation_1052716439685201922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([repeated_customer])/(SUM([repeated_customer])+[Calculation_1052716439684841473])' />
            </column>
            <column caption='Pickup Orders' datatype='integer' name='[Calculation_1878704756735848448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_order])' />
            </column>
            <column caption='tDine Orders' datatype='integer' name='[Calculation_1878704756760051713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tdine_order])' />
            </column>
            <column caption='Delivery Orders' datatype='integer' name='[Calculation_1878704756760784900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5611766612944183297]-([Calculation_1878704756760051713]+[Calculation_1878704756735848448])' />
            </column>
            <column caption='Total Incentive Amount (LC)' datatype='real' name='[Calculation_3462634820500512768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentive_amount_lc])' />
            </column>
            <column caption='Sessions' datatype='integer' name='[Calculation_4068017106588074000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([viewed_menu_session_count]))' />
            </column>
            <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4068017106588323857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([sum_order_rating]))/&#10;ZN(SUM([count_order_rating (tincubator daily level)]))' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_4236479941543251968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([dates])}' />
            </column>
            <column caption='Prep Time' datatype='real' name='[Calculation_4592193930646372405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Avg_FIR_Prep_Time_Sum]))/ZN(SUM([Avg_FIR_Prep_Time_count]))' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_4592193930646728758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([placed_order_session_count]))/ZN(SUM([viewed_menu_session_count]))' />
            </column>
            <column caption='Is Between Date' datatype='boolean' name='[Calculation_4641592758676250638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dates] &gt;= [Parameters].[Parameter 4] AND [dates] &lt;= [Parameters].[Parameter 5] THEN true else false end' />
            </column>
            <column caption='Date Granularity' datatype='date' name='[Calculation_4641592758681047055]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Day&quot; THEN DATE([dates])&#10;WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;,[dates])&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;,[dates])&#10;WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;,[dates])&#10;WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;,[dates])&#10;END)' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_5611766612944183297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='S.C. GMV Amount' datatype='real' name='[Calculation_5611766612944293890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_commissionable_gmv_amount_lc])' />
            </column>
            <column caption='Act. Delivery Fees' datatype='real' name='[Calculation_5611766613182836740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_total])' />
            </column>
            <column caption='Avg. Delivery Fees' datatype='real' name='[Calculation_5611766613183197189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5611766613182836740]/[Calculation_5611766612944183297]' />
            </column>
            <column caption='Basket Value (LC)' datatype='real' name='[Calculation_5789025516518719504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_basket_amount_total])' />
            </column>
            <column caption='Incentive Orders' datatype='integer' name='[Calculation_6322350257036517376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentivized_orders])' />
            </column>
            <column caption='Customer Acquisitions' datatype='integer' name='[Calculation_6322350257036857345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_talabat_acquisition_customer_count])' />
            </column>
            <column caption='Chain Name New' datatype='string' name='[Calculation_7781657239028695057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([chain_id]) = (&quot;679307&quot;) THEN &quot;Burger28-TK&quot;&#10;ELSEIF STR([chain_id]) = (&quot;673074&quot;) THEN &quot;Burger28-EKA&quot;&#10;ELSE [chain_name_en] END' />
            </column>
            <column caption='GEM Orders' datatype='integer' name='[Calculation_794463125267615766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GEM_orders_ot])' />
            </column>
            <column caption='Incentive Share' datatype='real' default-format='p0.00%' name='[Calculation_8033366213476524080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([successful_commissionable_gmv_amount_lc])/SUM([s_basket_amount_total]))' />
            </column>
            <column caption='ABV (LC)' datatype='real' name='[Calculation_8033366213477457969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_basket_amount_total])/[Calculation_5611766612944183297]' />
            </column>
            <column caption='Calculation2' datatype='real' name='[Calculation_8033366213479465011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([successful_commissionable_gmv_amount_lc])/SUM([s_orders_gmv_amount]))' />
            </column>
            <column caption='Best Seller Order %' datatype='real' name='[Calculation_8033366213483790388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([best_seller_orders])/[Calculation_5611766612944183297]' />
            </column>
            <column caption='GEM Order %' datatype='real' name='[Calculation_8033366213484007477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_794463125267615766]/[Calculation_5611766612944183297]' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_8673088463718776851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount])' />
            </column>
            <column caption='AOV (LC)' datatype='real' name='[Calculation_8673088463719374868]' role='measure' type='quantitative'>
