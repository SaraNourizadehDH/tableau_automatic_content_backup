    <worksheet name='Part 3  (Wasl) (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='tincubator' name='federated.1i2vjm314e6s861a5hrpm1egdi3k' />
          </datasources>
          <datasource-dependencies datasource='federated.1i2vjm314e6s861a5hrpm1egdi3k'>
            <column caption='S.C. GMV Amount (LC) (RR)' datatype='real' name='[Basket Value (LC) (RR) (copy)_722194452657819691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Calculation_540713434141929497]) THEN ([S.C. GMV Amount (copy)_722194445581811712]*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE [S.C. GMV Amount (copy)_722194445581811712]&#10;END' />
            </column>
            <column caption='Cost Of Goods Sold (COGS)' datatype='integer' name='[Calculation_4024881083234140164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM(If [metric] = &quot;cost_of_goods_sold&quot; THEN [value] END))' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_4236479941543251968]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([dates])}' />
            </column>
            <column caption='Is Current Month?' datatype='boolean' name='[Calculation_540713434141929497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[dates]) = DATETRUNC(&apos;month&apos;,[Calculation_4236479941543251968]) THEN true else false end' />
            </column>
            <column caption='Total Product Cost' datatype='integer' name='[Calculation_722194445591683089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4024881083234140164]&#10;+&#10;[cost_of_goods_sold (copy)_722194445587832839]' />
            </column>
            <column caption='Chain Name New' datatype='string' name='[Calculation_7781657239028695057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([chain_id]) = (&quot;679307&quot;) THEN &quot;Burger28-TK&quot;&#10;ELSEIF STR([chain_id]) = (&quot;673074&quot;) THEN &quot;Burger28-EKA&quot;&#10;ELSE [chain_name_en] END' />
            </column>
            <column caption='Completed Days' datatype='integer' name='[Calculation_794463125258706948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([dates])' />
            </column>
            <column caption='Month Days' datatype='integer' name='[Calculation_794463125282496541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [dates]))))' />
            </column>
            <column caption='Cost Of Goods Sold (COGS) (RR)' datatype='real' name='[Cost Of Goods Sold (COGS) (copy)_722194452814557229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF ATTR([Calculation_540713434141929497]) THEN ([Calculation_4024881083234140164]*ATTR([Calculation_794463125282496541]))/[Calculation_794463125258706948]&#10;ELSE [Calculation_4024881083234140164]&#10;END)' />
            </column>
            <column caption='Gross Profit % (RR)' datatype='real' default-format='p0.00%' name='[Gross Profit % (copy)_722194453708812337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Basket Value (LC) (RR) (copy)_722194452657819691]-[Total Product Cost (copy)_722194452815527983])/&#10;[Basket Value (LC) (RR) (copy)_722194452657819691]' />
            </column>
            <column caption='Gross Profit %' datatype='real' default-format='p0.00%' name='[Gross Profit (copy)_722194445592227858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([S.C. GMV Amount (copy)_722194445581811712]-[Calculation_722194445591683089])/&#10;[S.C. GMV Amount (copy)_722194445581811712]' />
            </column>
            <column caption='Gross Profit (RR)' datatype='real' name='[Gross Profit (copy)_722194453708787760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Basket Value (LC) (RR) (copy)_722194452657819691]&#10;-&#10;([Total Product Cost (copy)_722194452815527983])' />
            </column>
            <column caption='Packaging &amp; Consumables (RR)' datatype='real' name='[Packaging &amp; Consumables (copy)_722194452815364142]' role='measure' type='quantitative'>
