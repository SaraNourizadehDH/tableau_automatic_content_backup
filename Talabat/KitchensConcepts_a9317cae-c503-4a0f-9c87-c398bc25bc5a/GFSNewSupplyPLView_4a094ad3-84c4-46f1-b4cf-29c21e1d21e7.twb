    <worksheet name='Part 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run>P&amp;L View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tincubator' name='federated.1i2vjm314e6s861a5hrpm1egdi3k' />
          </datasources>
          <datasource-dependencies datasource='federated.1i2vjm314e6s861a5hrpm1egdi3k'>
            <column caption='AOV (LC) (GMV)' datatype='real' name='[AOV (LC) (copy)_8033366213479075890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount])/SUM([successful_orders])' />
            </column>
            <column caption='Cost Of Goods Sold (COGS)' datatype='integer' name='[Calculation_4024881083234140164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM(If [metric] = &quot;cost_of_goods_sold&quot; THEN [value] END))' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_5611766612944183297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Basket Value (LC)' datatype='real' name='[Calculation_5789025516518719504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_basket_amount_total])' />
            </column>
            <column caption='Avg SC GMV Per Order' datatype='real' name='[Calculation_722194445582635011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[S.C. GMV Amount (copy)_722194445581811712]/[Calculation_5611766612944183297]' />
            </column>
            <column caption='COGS per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_722194445587398661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4024881083234140164]/[Calculation_5611766612944183297]' />
            </column>
            <column caption='COGS %' datatype='real' default-format='p0.00%' name='[Calculation_722194445588471817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4024881083234140164]/[S.C. GMV Amount (copy)_722194445581811712]' />
            </column>
            <column caption='P&amp;C Per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_722194445588725770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost_of_goods_sold (copy)_722194445587832839]/[Calculation_5611766612944183297]' />
            </column>
            <column caption='OPEX Cost' datatype='real' name='[Calculation_722194445590904846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- ([Calculation_5789025516518719504]*[Packaging &amp; Consumables (copy)_722194445589213195])' />
            </column>
            <column caption='Total Other Costs' datatype='real' name='[Calculation_722194445591040015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Marketing Spend (copy)_722194445590040589])&#10;+&#10;ZN([Packaging &amp; Consumables (copy)_722194445589745676])&#10;+&#10;ZN([Calculation_722194445590904846])&#10;+&#10;ZN([OPEX Cost (copy)_722194452137287708])' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Calculation_722194445591605264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[S.C. GMV Amount (copy)_722194445581811712]&#10;-&#10;([Calculation_722194445591683089])' />
            </column>
            <column caption='Total Product Cost' datatype='integer' name='[Calculation_722194445591683089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4024881083234140164]&#10;+&#10;[cost_of_goods_sold (copy)_722194445587832839]' />
            </column>
            <column caption='Chain Name New' datatype='string' name='[Calculation_7781657239028695057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([chain_id]) = (&quot;679307&quot;) THEN &quot;Burger28-TK&quot;&#10;ELSEIF STR([chain_id]) = (&quot;673074&quot;) THEN &quot;Burger28-EKA&quot;&#10;ELSE [chain_name_en] END' />
            </column>
            <column caption='Incentive Share' datatype='real' default-format='p0.00%' name='[Calculation_8033366213476524080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([successful_commissionable_gmv_amount_lc])/SUM([s_basket_amount_total]))' />
            </column>
            <column caption='ABV (LC)' datatype='real' name='[Calculation_8033366213477457969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_basket_amount_total])/[Calculation_5611766612944183297]' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_8673088463718776851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount])' />
            </column>
            <column caption='EBIDTA %' datatype='real' default-format='p0.00%' name='[EBITA (copy)_722194445737123862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gross Profit (copy)_722194445736910868]/[S.C. GMV Amount (copy)_722194445581811712]' />
            </column>
            <column caption='GEM Fees' datatype='real' name='[GEM_fees_lc]' role='measure' type='quantitative' />
            <column caption='Gross Profit %' datatype='real' default-format='p0.00%' name='[Gross Profit (copy)_722194445592227858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([S.C. GMV Amount (copy)_722194445581811712]-[Calculation_722194445591683089])/&#10;[S.C. GMV Amount (copy)_722194445581811712]' />
            </column>
            <column caption='EBIDTA' datatype='real' name='[Gross Profit (copy)_722194445736910868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_722194445591605264] - [Calculation_722194445591040015]' />
            </column>
            <column caption='NCR Spend' datatype='real' name='[Marketing Spend (copy)_722194445590040589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- (ZN(SUM([GEM_fees_lc])) + ZN(SUM([cpc_revenue_lc])) + ZN(SUM([fp_revenue_lc])) + ZN(SUM([kwords_search_revenue_lc]))  + ZN(SUM([other_revenue_lc])))' />
            </column>
            <column caption='Platform Charges' datatype='real' default-format='p0.00%' name='[OPEX (copy)_722194450383876122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(If [metric] = &quot;platform_charges&quot; AND [type] = &quot;percentage&quot; THEN [value]/100 END)' />
            </column>
            <column caption='Platform Charges Cost' datatype='real' name='[OPEX Cost (copy)_722194452137287708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-([S.C. GMV Amount (copy)_722194445581811712]*[OPEX (copy)_722194450383876122])' />
            </column>
            <column caption='P&amp;C %' datatype='real' default-format='p0.00%' name='[Packaging &amp; Consumables (copy)_722194445588049928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost_of_goods_sold (copy)_722194445587832839]/[S.C. GMV Amount (copy)_722194445581811712]' />
            </column>
            <column caption='OPEX' datatype='real' default-format='p0.00%' name='[Packaging &amp; Consumables (copy)_722194445589213195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [metric] = &quot;opex&quot; AND [type] = &quot;percentage&quot; THEN [value]/100 END)' />
            </column>
            <column caption='Personel Costs' datatype='integer' name='[Packaging &amp; Consumables (copy)_722194445589745676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- (SUM(If [metric] = &quot;personel_costs&quot; THEN [value] END))' />
            </column>
            <column caption='S.C. GMV Amount (LC)' datatype='real' name='[S.C. GMV Amount (copy)_722194445581811712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_commissionable_gmv_amount_lc])' />
            </column>
            <column aggregation='Sum' caption='Chain ID' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column caption='Chain Name' datatype='string' name='[chain_name_en]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Shabab Shawarma &quot;' value='Shabab Shawarma  - R' />
              </aliases>
            </column>
            <column caption='Packaging &amp; Consumables' datatype='integer' name='[cost_of_goods_sold (copy)_722194445587832839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM(If [metric] = &quot;packaging_&amp;_consumables&quot; THEN [value] END))' />
