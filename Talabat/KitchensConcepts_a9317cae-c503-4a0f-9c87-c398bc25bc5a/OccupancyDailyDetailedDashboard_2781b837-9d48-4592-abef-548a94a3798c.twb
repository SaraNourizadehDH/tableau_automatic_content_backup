    <worksheet name='Orders (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
          </datasources>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Avg. Daily Orders (copy)' datatype='real' name='[Avg. Daily Orders (copy)_1001136143929815079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289])/COUNTD([date])' />
            </column>
            <column caption='vs Orders Target (var)' datatype='real' name='[Calculation_1001136143669456899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_284571221689298974] - SUM([Calculation_284571221687619609])' />
            </column>
            <column caption='Current Months &amp; Previous Month' datatype='boolean' name='[Calculation_1001136143879372824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_284571221691129888] or [Calculation_284571220270161927] then true else false end' />
            </column>
            <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
            </column>
            <column caption='Occupany (Latest)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_284571220268167171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :COUNTD(if [Calculation_284571220502118409] = [date] AND [occupation] = true AND [Calculation_1001136143893135386] then [Calculation_4329929587734409264] END)}' />
            </column>
            <column caption='SP-LM' datatype='boolean' name='[Calculation_284571220270161927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[date]) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1))&#10;AND [date] &lt;= DATEADD(&apos;month&apos;,-1,TODAY()-1)&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_284571220502118409]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
            </column>
            <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_284571221652619278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289])/[Calculation_5620070187988332548]' />
            </column>
            <column caption='Avg. Daily Order Per Stall' datatype='real' name='[Calculation_284571221653946384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_284571221652619278]/ATTR([Calculation_284571220268167171])' />
            </column>
            <column caption='Orders Target (All Kitchens)' datatype='real' name='[Calculation_284571221687619609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month],[facility_short_name]:SUM([orders_target])}' />
            </column>
            <column aggregation='Sum' caption='Month Length' datatype='integer' name='[Calculation_284571221688320027]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;,DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))))' />
            </column>
            <column caption='Completed Days' datatype='integer' name='[Calculation_284571221689004061]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,TODAY()),MAX([date]))' />
            </column>
            <column caption='Run Rate Orders' datatype='real' name='[Calculation_284571221689298974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289] * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
            </column>
            <column caption='Is Current Month' datatype='boolean' name='[Calculation_284571221691129888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF if DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) = DATETRUNC(&apos;month&apos;,[date]) then true else false end then true else false end' />
            </column>
            <column caption='Avg. Daily Orders Per Kitchen' datatype='real' name='[Calculation_284571221703761960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_284571221652619278]/COUNTD([kitchen_short_name])' />
            </column>
            <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kitchen_short_name]+[stall_number]' />
            </column>
            <column caption='No. Of Days' datatype='integer' name='[Calculation_5620070187988332548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([date])-1' />
            </column>
            <column caption='Successful Orders' datatype='real' name='[Calculation_6263451609632780289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Run Rate Orders (copy)' datatype='real' name='[Run Rate Orders (copy)_1001136143942909994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Calculation_284571221691129888]) THEN (([Calculation_6263451609632780289] * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])) ELSE [Calculation_6263451609632780289] END' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Facility Short Name (TS)' datatype='string' name='[facility_short_name]' role='dimension' type='nominal' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_short_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
