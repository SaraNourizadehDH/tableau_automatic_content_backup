      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Avg. Daily Order Per Stall (copy)' datatype='real' name='[Avg. Daily Order Per Stall (copy)_1001136143929372710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143929815079]/([Calculation_5620070187987116034])' />
            </column>
            <column caption='Avg. Daily Orders (copy)' datatype='real' name='[Avg. Daily Orders (copy)_1001136143929815079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289])/COUNTD([date])' />
            </column>
            <column datatype='real' name='[Avg_FIR_Prep_Time_Sum]' role='measure' type='quantitative' />
            <column datatype='real' name='[Avg_FIR_Prep_Time_count]' role='measure' type='quantitative' />
            <column caption='Vendor Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672229892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
            </column>
            <column caption='Rejection Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672274949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_rejected_orders_count])/SUM([all_orders])' />
            </column>
            <column caption='Delay Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672303622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_orders_10min])/SUM([successful_orders])' />
            </column>
            <column caption='vNet Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143673286664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
            </column>
            <column caption='Offline Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674232842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration_seconds])/SUM([schedule_duration_seconds])' />
            </column>
            <column caption='V. Delay v2 10 Mins %' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674703883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
            </column>
            <column caption='Rating' datatype='real' name='[Calculation_1001136143674912780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_order_rating])/SUM([count_order_rating])' />
            </column>
            <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
            </column>
            <column caption='Avg. FIR Prep TIme' datatype='real' name='[Calculation_2043578700020854788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Avg_FIR_Prep_Time_Sum])/SUM([Avg_FIR_Prep_Time_count])' />
            </column>
            <column caption='Date Granularity' datatype='date' name='[Calculation_2043578767822041089]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN DATE([date])&#10;WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;,[date])&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;,[date])&#10;WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;,[date])&#10;WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
            </column>
            <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
