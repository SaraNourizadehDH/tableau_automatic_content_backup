      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='sales_activity' id='_6160B5624F24473FA17885D3A20FED39'>
            <properties context=''>
              <relation connection='bigquery.1rlg2dz1w5x4to18qw4yr01ykcbj' name='Custom SQL Query' type='text'>SELECT
DISTINCT
b.brandName,
b.countryCode,
f.name AS kitchen_name,
u.name AS fteName,
stallIds,
s.number,
b.category,
&apos;Signed&apos; AS pipelineStatus,
le.priceInfo.rentRevenueLocal,
le.priceInfo.incrementalCommissionPercentage,
EXTRACT(DATE FROM le.signDate) AS signed_date
FROM `hfc-prod.gks_prod.lead` l
JOIN `hfc-prod.gks_prod.brand` b ON l.brandId = b.id AND l.status IN (&apos;Signed&apos;, &apos;Live&apos;)
JOIN `hfc-prod.gks_prod.lease` le ON b.partnerId = le.partnerId AND l.facilityId = le.facilityId
LEFT JOIN UNNEST(stallIds) stallIds
LEFT JOIN `hfc-prod.gks_prod.stall` s ON s.id=stallIds
LEFT JOIN `hfc-prod.gks_prod.user` u ON b.assigneeId=u.id
LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=l.facilityId
WHERE EXTRACT(DATE FROM le.signDate)&gt;&gt;= &apos;2024-01-01&apos; AND b.countryCode IN (&apos;AE&apos;,&apos;BH&apos;,&apos;KW&apos;,&apos;QA&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
