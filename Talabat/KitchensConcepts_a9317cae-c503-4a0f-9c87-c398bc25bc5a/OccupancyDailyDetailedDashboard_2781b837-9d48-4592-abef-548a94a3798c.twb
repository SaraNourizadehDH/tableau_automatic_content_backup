    <worksheet name='Vendor Maturity View'>
      <layout-options>
        <title>
          <formatted-text>
            <run>VENDOR MATURITY VIEW&#10;</run>
            <run fontcolor='#e6e6e6'>-</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
          </datasources>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Vendor Active Days' datatype='integer' name='[Calculation_4329929587377360910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]:SUM(DATEDIFF(&apos;day&apos;,[onboarding_date (Custom SQL Query2)],TODAY()-1))}' />
            </column>
            <column caption='Vendor Maturity' datatype='string' name='[Calculation_4329929587377803279]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4329929587377360910]  &lt;= 30 AND ISNULL([offboarded_date]) then &quot;New&quot;&#10;ELSEIF  [Calculation_4329929587377360910] &gt; 30 AND [Calculation_4329929587377360910] &lt;= 60 AND ISNULL([offboarded_date]) then &quot;Growth&quot;&#10;ELSEIF [Calculation_4329929587377360910] &gt; 90 AND ISNULL([offboarded_date]) then &quot;Aged&quot;&#10;ELSEIF ISNULL([offboarded_date]) THEN &quot;New&quot;&#10;ELSE &quot;Churned&quot;&#10;END' />
            </column>
            <column caption='No. Of Vendors' datatype='integer' name='[Calculation_4329929587378221072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4329929587377803279]' derivation='None' name='[none:Calculation_4329929587377803279:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[offboarded_date]' role='dimension' type='ordinal' />
            <column caption='vendor_onboarding_date' datatype='date' name='[onboarding_date (Custom SQL Query2)]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4329929587378221072]' derivation='User' name='[usr:Calculation_4329929587378221072:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[my:date:ok]'>
            <groupfilter function='member' level='[my:date:ok]' member='202405' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[none:Calculation_4329929587377803279:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;New&quot;</bucket>
              <bucket>&quot;Growth&quot;</bucket>
              <bucket>&quot;Aged&quot;</bucket>
              <bucket>&quot;Churned&quot;</bucket>
            </dictionary>
