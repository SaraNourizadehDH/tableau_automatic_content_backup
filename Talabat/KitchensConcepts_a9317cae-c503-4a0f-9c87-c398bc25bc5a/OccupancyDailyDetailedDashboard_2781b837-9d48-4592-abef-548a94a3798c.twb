            <column-instance column='[Calculation_4329929587349651467]' derivation='User' name='[usr:Calculation_4329929587349651467:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4329929587384442897]' derivation='User' name='[usr:Calculation_4329929587384442897:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4329929587387277333]' derivation='User' name='[usr:Calculation_4329929587387277333:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4329929587389321239]' derivation='User' name='[usr:Calculation_4329929587389321239:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4329929587758886961]' derivation='User' name='[usr:Calculation_4329929587758886961:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Occupancy Rate (copy 2)_4329929587388014614]' derivation='User' name='[usr:Occupancy Rate (copy 2)_4329929587388014614:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders Target (var) (copy)_4329929587385823251]' derivation='User' name='[usr:Orders Target (var) (copy)_4329929587385823251:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders Target (var) (copy)_4329929587386081300]' derivation='User' name='[usr:Orders Target (var) (copy)_4329929587386081300:qk]' pivot='key' type='quantitative' />
