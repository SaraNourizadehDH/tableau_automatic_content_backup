    <worksheet name='Target vs Actual'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Orders Delta by Kitchen Status</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
          </datasources>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
            </column>
            <column caption='Orders Target (All Kitchens)' datatype='real' name='[Calculation_284571221687619609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month],[facility_short_name]:SUM([orders_target])}' />
            </column>
            <column aggregation='Sum' caption='Month Length' datatype='integer' name='[Calculation_284571221688320027]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;,DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))))' />
            </column>
            <column caption='Completed Days' datatype='integer' name='[Calculation_284571221689004061]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,TODAY()),MAX([date]))' />
            </column>
            <column caption='Run Rate Orders' datatype='real' name='[Calculation_284571221689298974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289] * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
            </column>
            <column caption='is_kitchen_active' datatype='boolean' name='[Calculation_4329929587346006024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF date &gt;= [updated_opening_date] then true else false end)' />
            </column>
            <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kitchen_short_name]+[stall_number]' />
            </column>
            <column caption='Is Kitchen Live (Target Sheet) (All Kitchens)' datatype='boolean' name='[Calculation_4329929587766489140]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [facility_short_name]: (If [Calculation_6263451609621622784] = 0 AND SUM([total_stalls]) =0 then false &#10;ELSEIF [Calculation_6263451609621622784] = 0 AND SUM([total_stalls]) &gt;0 then false else true &#10;end)}' />
            </column>
            <column caption='Orders Target (var) (all kitchens)' datatype='real' name='[Calculation_4329929587768823864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_284571221689298974],0)-SUM(IFNULL([Calculation_284571221687619609],0))' />
            </column>
            <column caption='No. Of Stalls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_6263451609621622784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1001136143893135386] AND [Calculation_4329929587346006024] THEN [Calculation_4329929587734409264] END)' />
            </column>
            <column caption='Successful Orders' datatype='real' name='[Calculation_6263451609632780289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Facility Short Name (TS)' datatype='string' name='[facility_short_name]' role='dimension' type='nominal' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_short_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4329929587766489140]' derivation='None' name='[none:Calculation_4329929587766489140:nk]' pivot='key' type='nominal' />
            <column caption='Orders Target' datatype='real' datatype-customized='true' name='[orders_target]' role='measure' type='quantitative' />
            <column caption='Stall Number' datatype='string' name='[stall_number]' role='dimension' type='nominal' />
            <column datatype='real' name='[successful_orders]' role='measure' type='quantitative' />
            <column caption='Total Stalls Target' datatype='real' name='[total_stalls]' role='measure' type='quantitative' />
            <column caption='kitchen_opening_date' datatype='date' name='[updated_opening_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4329929587768823864]' derivation='User' name='[usr:Calculation_4329929587768823864:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[my:month:ok]'>
            <groupfilter function='member' level='[my:month:ok]' member='202405' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[my:month:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
