      </column>
      <column caption='Avg. Daily GMV Per Stall' datatype='real' name='[Avg. Daily Order Per Stall (copy)_1001136143675973646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143675973645]/ATTR([Calculation_284571220268167171])' />
      </column>
      <column caption='Avg. Daily Order Per Stall (copy)' datatype='real' name='[Avg. Daily Order Per Stall (copy)_1001136143929372710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143929815079]/([Calculation_5620070187987116034])' />
      </column>
      <column caption='Avg. Daily GMV' datatype='real' name='[Avg. Daily Orders (copy)_1001136143675973645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([s_orders_gmv_amount_eur])/[Calculation_5620070187988332548]' />
      </column>
      <column caption='Avg. Daily Orders (copy)' datatype='real' name='[Avg. Daily Orders (copy)_1001136143929815079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6263451609632780289])/COUNTD([date])' />
      </column>
      <column caption='Avg. Daily GMV Per Kitchen' datatype='real' name='[Avg. Daily Per Kitchen (copy)_1001136143675973647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143675973645]/COUNTD([kitchen_short_name])' />
      </column>
      <column caption='CM Sessions' datatype='real' name='[CM GMV (copy)_1001136143899209757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_284571221703409702]: SUM(if [Calculation_284571221691129888] then [viewed_menu_session_count] END)}' />
      </column>
      <column caption='CM GMV' datatype='real' name='[CM Orders (copy)_1001136143667875840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_284571221703409702]: SUM(if [Calculation_284571221691129888] then [s_orders_gmv_amount_eur] END)}' />
      </column>
      <column caption='vs Orders Target (var)' datatype='real' name='[Calculation_1001136143669456899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_284571221689298974] - SUM([Calculation_284571221687619609])' />
      </column>
      <column caption='Vendor Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672229892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
      </column>
      <column caption='Rejection Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672274949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_rejected_orders_count])/SUM([all_orders])' />
      </column>
      <column caption='Delay Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672303622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_orders_10min])/SUM([successful_orders])' />
      </column>
      <column caption='vNet Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143673286664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
      </column>
      <column caption='FIR Confidance Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143673421833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fir_confident_use_count])/SUM([total_fir_confident_use_count])' />
      </column>
      <column caption='Offline Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674232842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration_seconds])/SUM([schedule_duration_seconds])' />
      </column>
      <column caption='V. Delay v2 10 Mins %' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674703883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
      </column>
      <column caption='Rating' datatype='real' name='[Calculation_1001136143674912780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_order_rating])/SUM([count_order_rating])' />
      </column>
      <column caption='Avg. Delviery Time' datatype='real' name='[Calculation_1001136143682281490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_delivery_time_sum])/SUM([actual_delivery_time_count])' />
      </column>
      <column caption='AOV Target' datatype='real' name='[Calculation_1001136143701532692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_target])/SUM([orders_target])' />
      </column>
      <column caption='Current Months &amp; Previous Month' datatype='boolean' name='[Calculation_1001136143879372824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_284571221691129888] or [Calculation_284571220270161927] then true else false end' />
      </column>
      <column caption='Calculation5' datatype='boolean' name='[Calculation_1001136143880396825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) = DATETRUNC(&apos;month&apos;,[date]) then true else false end' />
      </column>
      <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
      </column>
      <column caption='Previous Period Same Day Occupancy' datatype='integer' name='[Calculation_1001136143903068193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1001136143935717416]) = ATTR([date]) then [Calculation_5620070187987116034] END' />
      </column>
      <column caption='Same Day Last Month' datatype='date' datatype-customized='true' name='[Calculation_1001136143935717416]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1,[Calculation_284571220502118409]))' />
      </column>
      <column caption='Empty Stalls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2043578700016586755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [occupation] = false then [stall_id] END)' />
      </column>
      <column caption='Avg. FIR Prep TIme' datatype='real' name='[Calculation_2043578700020854788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Avg_FIR_Prep_Time_Sum])/SUM([Avg_FIR_Prep_Time_count])' />
      </column>
      <column caption='OPDPS' datatype='real' name='[Calculation_2043578700030935045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6263451609632780289]/[Calculation_5620070187987116034])/COUNTD([date])' />
      </column>
      <column caption='Date Granularity' datatype='date' name='[Calculation_2043578767822041089]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN DATE([date])&#10;WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;,[date])&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;,[date])&#10;WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;,[date])&#10;WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
      </column>
      <column caption='Sessions' datatype='real' name='[Calculation_2043578767822397442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([viewed_menu_session_count])' />
      </column>
      <column caption='Occupany (Latest)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_284571220268167171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :COUNTD(if [Calculation_284571220502118409] = [date] AND [occupation] = true AND [Calculation_1001136143893135386] then [Calculation_4329929587734409264] END)}' />
      </column>
      <column caption='Calculation3' datatype='integer' name='[Calculation_284571220269633541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :COUNTD(if [latest_occupany] AND [occupation] = true then [stall_id] END)}' />
      </column>
      <column caption='SP-LM' datatype='boolean' name='[Calculation_284571220270161927]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[date]) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1))&#10;AND [date] &lt;= DATEADD(&apos;month&apos;,-1,TODAY()-1)&#10;THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='PM Orders' datatype='real' name='[Calculation_284571220270395400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(if [Calculation_284571220270161927] then [successful_orders] END)}' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_284571220502118409]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
      </column>
      <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_284571221652619278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6263451609632780289])/[Calculation_5620070187988332548]' />
      </column>
      <column caption='Avg. Daily Order Per Stall' datatype='real' name='[Calculation_284571221653946384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_284571221652619278]/ATTR([Calculation_284571220268167171])' />
      </column>
      <column caption='Calculation4' datatype='integer' datatype-customized='true' name='[Calculation_284571221655281684]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='(DATEPART(&apos;day&apos;,[date]))' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_284571221662445589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_target])/[Calculation_5620070187988332548]' />
      </column>
      <column caption='Orders Target (All Kitchens)' datatype='real' name='[Calculation_284571221687619609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [month],[facility_short_name]:SUM([orders_target])}' />
      </column>
      <column aggregation='Sum' caption='Month Length' datatype='integer' name='[Calculation_284571221688320027]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;,DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))))' />
      </column>
      <column caption='Completed Days' datatype='integer' name='[Calculation_284571221689004061]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,TODAY()),MAX([date]))' />
      </column>
      <column caption='Run Rate Orders' datatype='real' name='[Calculation_284571221689298974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6263451609632780289] * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
      </column>
      <column caption='Is Current Month' datatype='boolean' name='[Calculation_284571221691129888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF if DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) = DATETRUNC(&apos;month&apos;,[date]) then true else false end then true else false end' />
      </column>
      <column caption='Month Start' datatype='boolean' name='[Calculation_284571221701058596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE(DATETRUNC(&apos;month&apos;,[date])) = [date] then true else false end' />
      </column>
      <column caption='Month Begining Occupancy' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_284571221701353509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;,[date]): COUNTD(if ([Calculation_284571221701058596]) and [occupation] and [Calculation_1001136143893135386] then [stall_id] end)}' />
      </column>
      <column caption='Month_o' datatype='date' datatype-customized='true' name='[Calculation_284571221703409702]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
      </column>
      <column caption='Avg. Daily Orders Per Kitchen' datatype='real' name='[Calculation_284571221703761960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_284571221652619278]/COUNTD([kitchen_short_name])' />
      </column>
      <column caption='is_kitchen_active' datatype='boolean' name='[Calculation_4329929587346006024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IF date &gt;= [updated_opening_date] then true else false end)' />
      </column>
      <column caption='GMV (EUR)' datatype='real' name='[Calculation_4329929587349651467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([s_orders_gmv_amount_eur])' />
      </column>
      <column caption='Vendor Active Days' datatype='integer' name='[Calculation_4329929587377360910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor_id]:SUM(DATEDIFF(&apos;day&apos;,[onboarding_date (Custom SQL Query2)],TODAY()-1))}' />
      </column>
      <column caption='Vendor Maturity' datatype='string' name='[Calculation_4329929587377803279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4329929587377360910]  &lt;= 30 AND ISNULL([offboarded_date]) then &quot;New&quot;&#10;ELSEIF  [Calculation_4329929587377360910] &gt; 30 AND [Calculation_4329929587377360910] &lt;= 60 AND ISNULL([offboarded_date]) then &quot;Growth&quot;&#10;ELSEIF [Calculation_4329929587377360910] &gt; 90 AND ISNULL([offboarded_date]) then &quot;Aged&quot;&#10;ELSEIF ISNULL([offboarded_date]) THEN &quot;New&quot;&#10;ELSE &quot;Churned&quot;&#10;END' />
      </column>
      <column caption='No. Of Vendors' datatype='integer' name='[Calculation_4329929587378221072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Orders Target (var)' datatype='real' name='[Calculation_4329929587384442897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_target]) - [Calculation_284571221689298974]' />
      </column>
      <column caption='Occupancy Rate Target' datatype='real' default-format='p0.00%' name='[Calculation_4329929587387277333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([occupied_stalls])/SUM([total_stalls])' />
      </column>
      <column caption='Occupancy Rate Target (var)' datatype='real' default-format='p0.00%' name='[Calculation_4329929587389321239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4329929587387277333] - [Occupancy Rate (copy 2)_4329929587388014614]' />
      </column>
      <column caption='Target Orders Daily Avg.' datatype='real' name='[Calculation_4329929587390423064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_target])/ATTR([Calculation_284571221688320027])' />
      </column>
      <column caption='is Kitchen Live' datatype='boolean' name='[Calculation_4329929587553427483]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_6263451609621622784] = 0 AND SUM([total_stalls]) =0 then false &#10;ELSEIF [Calculation_6263451609621622784] = 0 AND SUM([total_stalls]) &gt;0 then false else true &#10;end' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_4329929587572879389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order_session_count])/SUM([viewed_menu_session_count])' />
      </column>
      <column caption='No. Of Kitchens' datatype='integer' name='[Calculation_4329929587573481503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(If [Calculation_4329929587346006024] then [kitchen_short_name] end)' />
      </column>
      <column caption='Last 4 Week AVG' datatype='real' name='[Calculation_4329929587584065573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(([Calculation_6263451609632780289]),-4,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PWTD' datatype='date' name='[Calculation_4329929587608191019]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if WEEK([date]) = WEEK(DATEADD(&apos;week&apos;,-1,[Calculation_284571220502118409])) &#10;AND YEAR(date) = YEAR(DATEADD(&apos;week&apos;,-1,[Calculation_284571220502118409]))&#10;AND date &lt;= DATEADD(&apos;week&apos;,-1,[Calculation_284571220502118409])&#10;THEN &#10;date END' />
      </column>
      <column caption='WTD' datatype='date' name='[Calculation_4329929587608526892]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if WEEK([date]) = WEEK([Calculation_284571220502118409]) &#10;AND YEAR([date]) = YEAR([Calculation_284571220502118409])&#10;AND [date] &lt;= [Calculation_284571220502118409]&#10;THEN &#10;[date] END' />
      </column>
      <column caption='PWTD vs WTD' datatype='boolean' name='[Calculation_4329929587608789037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4329929587608191019] = [date] OR [Calculation_4329929587608526892] = [date] then true else false end' />
      </column>
      <column caption='Hide Nulls' datatype='boolean' name='[Calculation_4329929587610640430]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Ops Metric Trend' datatype='real' name='[Calculation_4329929587623465007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Avg. FIR Prep Time&quot; THEN [Calculation_2043578700020854788]&#10;WHEN &quot;Offline Rate&quot; THEN [Calculation_1001136143674232842]*100&#10;WHEN &quot;Rating&quot; THEN [Calculation_1001136143674912780]&#10;WHEN &quot;VD v2 10Mins %&quot; THEN [Calculation_1001136143674703883]*100&#10;WHEN &quot;Delay Rate&quot; THEN [Calculation_1001136143672303622]*100&#10;WHEN &quot;Rejection Rate&quot; THEN [Calculation_1001136143672274949]*100&#10;END' />
      </column>
      <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[kitchen_short_name]+[stall_number]' />
      </column>
      <column caption='Orders Target Completion %' datatype='real' default-format='p0.00%' name='[Calculation_4329929587758886961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_284571221689298974]/SUM([orders_target]))' />
      </column>
      <column caption='Calculation6' datatype='boolean' name='[Calculation_4329929587765952563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [month]:([Calculation_4329929587553427483])}' />
      </column>
      <column caption='Is Kitchen Live (Target Sheet) (All Kitchens)' datatype='boolean' name='[Calculation_4329929587766489140]' role='dimension' type='nominal'>
