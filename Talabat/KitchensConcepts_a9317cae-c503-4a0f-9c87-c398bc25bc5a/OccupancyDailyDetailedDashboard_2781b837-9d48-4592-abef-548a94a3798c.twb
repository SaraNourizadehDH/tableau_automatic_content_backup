    <worksheet name='GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
          </datasources>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Avg. Daily GMV Per Stall' datatype='real' name='[Avg. Daily Order Per Stall (copy)_1001136143675973646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143675973645]/ATTR([Calculation_284571220268167171])' />
            </column>
            <column caption='Avg. Daily GMV' datatype='real' name='[Avg. Daily Orders (copy)_1001136143675973645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount_eur])/[Calculation_5620070187988332548]' />
            </column>
            <column caption='Avg. Daily GMV Per Kitchen' datatype='real' name='[Avg. Daily Per Kitchen (copy)_1001136143675973647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Daily Orders (copy)_1001136143675973645]/COUNTD([kitchen_short_name])' />
            </column>
            <column caption='CM GMV' datatype='real' name='[CM Orders (copy)_1001136143667875840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_284571221703409702]: SUM(if [Calculation_284571221691129888] then [s_orders_gmv_amount_eur] END)}' />
            </column>
            <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
            </column>
            <column caption='Occupany (Latest)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_284571220268167171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :COUNTD(if [Calculation_284571220502118409] = [date] AND [occupation] = true AND [Calculation_1001136143893135386] then [Calculation_4329929587734409264] END)}' />
            </column>
            <column caption='SP-LM' datatype='boolean' name='[Calculation_284571220270161927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[date]) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY()-1))&#10;AND [date] &lt;= DATEADD(&apos;month&apos;,-1,TODAY()-1)&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_284571220502118409]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
            </column>
            <column aggregation='Sum' caption='Month Length' datatype='integer' name='[Calculation_284571221688320027]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;,DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))))' />
            </column>
            <column caption='Completed Days' datatype='integer' name='[Calculation_284571221689004061]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,TODAY()),MAX([date]))' />
            </column>
            <column caption='Is Current Month' datatype='boolean' name='[Calculation_284571221691129888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF if DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) = DATETRUNC(&apos;month&apos;,[date]) then true else false end then true else false end' />
            </column>
            <column caption='Month_o' datatype='date' datatype-customized='true' name='[Calculation_284571221703409702]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kitchen_short_name]+[stall_number]' />
            </column>
            <column caption='No. Of Days' datatype='integer' name='[Calculation_5620070187988332548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([date])-1' />
            </column>
            <column caption='GMV Target (N)' datatype='real' name='[Orders Target (N) (copy)_1001136143676772368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month]:SUM([gmv_target])}' />
            </column>
            <column caption='PM GMV' datatype='real' name='[PM Orders (copy)_1001136143668006913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED: SUM(if [Calculation_284571220270161927] then [s_orders_gmv_amount_eur] END)}' />
            </column>
            <column caption='Run Rate GMV' datatype='real' name='[Run Rate (copy)_1001136143669006338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([s_orders_gmv_amount_eur]) * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Gmv Target' datatype='real' datatype-customized='true' name='[gmv_target]' role='measure' type='quantitative' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_short_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column caption='Occupation Status' datatype='boolean' name='[occupation]' role='dimension' type='nominal' />
            <column datatype='real' name='[s_orders_gmv_amount_eur]' role='measure' type='quantitative' />
            <column caption='Stall Number' datatype='string' name='[stall_number]' role='dimension' type='nominal' />
            <column-instance column='[CM Orders (copy)_1001136143667875840]' derivation='Sum' name='[sum:CM Orders (copy)_1001136143667875840:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders Target (N) (copy)_1001136143676772368]' derivation='Sum' name='[sum:Orders Target (N) (copy)_1001136143676772368:qk]' pivot='key' type='quantitative' />
            <column-instance column='[PM Orders (copy)_1001136143668006913]' derivation='Sum' name='[sum:PM Orders (copy)_1001136143668006913:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg. Daily Order Per Stall (copy)_1001136143675973646]' derivation='User' name='[usr:Avg. Daily Order Per Stall (copy)_1001136143675973646:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg. Daily Orders (copy)_1001136143675973645]' derivation='User' name='[usr:Avg. Daily Orders (copy)_1001136143675973645:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg. Daily Per Kitchen (copy)_1001136143675973647]' derivation='User' name='[usr:Avg. Daily Per Kitchen (copy)_1001136143675973647:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Run Rate (copy)_1001136143669006338]' derivation='User' name='[usr:Run Rate (copy)_1001136143669006338:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vs Orders Target (var) (copy)_1001136143678427153]' derivation='User' name='[usr:vs Orders Target (var) (copy)_1001136143678427153:qk]' pivot='key' type='quantitative' />
            <column caption='vs GMV Target (var)' datatype='real' name='[vs Orders Target (var) (copy)_1001136143678427153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Run Rate (copy)_1001136143669006338] - SUM([Orders Target (N) (copy)_1001136143676772368])' />
            </column>
