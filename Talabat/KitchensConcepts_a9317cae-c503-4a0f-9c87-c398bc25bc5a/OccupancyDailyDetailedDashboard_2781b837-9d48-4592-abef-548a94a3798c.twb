          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Avg. Daily Per Kitchen (copy)_1001136143675973647:qk]&quot;' value='AD GMV Per Kitchen' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_1001136143672229892:qk]&quot;' value='V. Contact Rate' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_1001136143674703883:qk]&quot;' value='V.D v2 10 Mins %' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_284571221653946384:qk]&quot;' value='AD Order Per Stall' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_284571221689298974:qk]&quot;' value='Run Rate' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_284571221703761960:qk]&quot;' value='AD Orders Per Kitchen' />
          <alias key='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_6263451609632780289:qk]&quot;' value='Orders' />
