    <worksheet name='Kitchen Level Target Tracking'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#e6e6e6' fontsize='8'>-</run>
            <run>Æ&#10;</run>
            <run fontcolor='#e6e6e6' fontsize='8'>-</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Occupancy' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' />
          </datasources>
          <datasource-dependencies datasource='federated.1qssm0l1t6m9be1ajt2md0w2b3bt'>
            <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_284571220502118409]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([date])}' />
            </column>
            <column aggregation='Sum' caption='Month Length' datatype='integer' name='[Calculation_284571221688320027]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;,DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))))' />
            </column>
            <column caption='Completed Days' datatype='integer' name='[Calculation_284571221689004061]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,TODAY()),MAX([date]))' />
            </column>
            <column caption='Run Rate Orders' datatype='real' name='[Calculation_284571221689298974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6263451609632780289] * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
            </column>
            <column caption='Month_o' datatype='date' datatype-customized='true' name='[Calculation_284571221703409702]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='is_kitchen_active' datatype='boolean' name='[Calculation_4329929587346006024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF date &gt;= [updated_opening_date] then true else false end)' />
            </column>
            <column caption='GMV (EUR)' datatype='real' name='[Calculation_4329929587349651467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s_orders_gmv_amount_eur])' />
            </column>
            <column caption='Orders Target (var)' datatype='real' name='[Calculation_4329929587384442897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_target]) - [Calculation_284571221689298974]' />
            </column>
            <column caption='Occupancy Rate Target' datatype='real' default-format='p0.00%' name='[Calculation_4329929587387277333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([occupied_stalls])/SUM([total_stalls])' />
            </column>
            <column caption='Occupancy Rate Target (var)' datatype='real' default-format='p0.00%' name='[Calculation_4329929587389321239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4329929587387277333] - [Occupancy Rate (copy 2)_4329929587388014614]' />
            </column>
            <column caption='unique_stall_id' datatype='string' name='[Calculation_4329929587734409264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kitchen_short_name]+[stall_number]' />
            </column>
            <column caption='Orders Target Completion %' datatype='real' default-format='p0.00%' name='[Calculation_4329929587758886961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_284571221689298974]/SUM([orders_target]))' />
            </column>
            <column caption='No. Of Stalls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_6263451609621622784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1001136143893135386] AND [Calculation_4329929587346006024] THEN [Calculation_4329929587734409264] END)' />
            </column>
            <column caption='Successful Orders' datatype='real' name='[Calculation_6263451609632780289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Occupancy Rate (New)' datatype='real' default-format='p0%' name='[Occupancy Rate (copy 2)_4329929587388014614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Occupany (Latest) (copy)_4329929587385442322])/[Calculation_6263451609621622784]' />
            </column>
            <column caption='Occupany (Latest) New' datatype='integer' default-format='n#,##0;-#,##0' name='[Occupany (Latest) (copy)_4329929587385442322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code],[kitchen_short_name]:COUNTD(if [Calculation_284571220502118409] = [date] AND [occupation] = true AND [Calculation_1001136143893135386] then [stall_id] END)}' />
            </column>
            <column caption='GMV Target (var)' datatype='real' name='[Orders Target (var) (copy)_4329929587385823251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_target]) - [Run Rate (copy)_1001136143669006338]' />
            </column>
            <column caption='Occupancy Target (var)' datatype='real' name='[Orders Target (var) (copy)_4329929587386081300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([occupied_stalls]) - SUM([Occupany (Latest) (copy)_4329929587385442322])' />
            </column>
            <column caption='Run Rate GMV' datatype='real' name='[Run Rate (copy)_1001136143669006338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([s_orders_gmv_amount_eur]) * ATTR([Calculation_284571221688320027]))/([Calculation_284571221689004061])' />
            </column>
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Gmv Target' datatype='real' datatype-customized='true' name='[gmv_target]' role='measure' type='quantitative' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_short_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_284571221703409702]' derivation='MY' name='[my:Calculation_284571221703409702:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[kitchen_short_name]' derivation='None' name='[none:kitchen_short_name:nk]' pivot='key' type='nominal' />
            <column caption='Occupation Status' datatype='boolean' name='[occupation]' role='dimension' type='nominal' />
            <column caption='Occupied Stalls Target' datatype='real' name='[occupied_stalls]' role='measure' type='quantitative' />
            <column caption='Orders Target' datatype='real' datatype-customized='true' name='[orders_target]' role='measure' type='quantitative' />
            <column datatype='real' name='[s_orders_gmv_amount_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[stall_id]' role='dimension' type='nominal' />
            <column caption='Stall Number' datatype='string' name='[stall_number]' role='dimension' type='nominal' />
            <column datatype='real' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Occupany (Latest) (copy)_4329929587385442322]' derivation='Sum' name='[sum:Occupany (Latest) (copy)_4329929587385442322:qk]' pivot='key' type='quantitative' />
            <column-instance column='[gmv_target]' derivation='Sum' name='[sum:gmv_target:qk]' pivot='key' type='quantitative' />
            <column-instance column='[occupied_stalls]' derivation='Sum' name='[sum:occupied_stalls:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_target]' derivation='Sum' name='[sum:orders_target:qk]' pivot='key' type='quantitative' />
            <column caption='Total Stalls Target' datatype='real' name='[total_stalls]' role='measure' type='quantitative' />
            <column caption='kitchen_opening_date' datatype='date' name='[updated_opening_date]' role='dimension' type='ordinal' />
