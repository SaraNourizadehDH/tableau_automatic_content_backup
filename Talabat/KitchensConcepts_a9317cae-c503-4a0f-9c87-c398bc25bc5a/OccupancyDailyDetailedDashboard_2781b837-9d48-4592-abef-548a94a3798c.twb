            <column caption='Activity Count' datatype='integer' name='[Calculation_1001136143728574487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([facility_id]+[stall_id]+[partner_name])' />
            </column>
            <column caption='Onboardings' datatype='string' name='[Calculation_4329929587284361217]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [activity] = &quot;offboarding&quot; OR [activity] =  &quot;offboarding_schedule&quot; then &quot;Offboardings&quot; ELSE &quot;Onboardings&quot; end' />
            </column>
            <column caption='Max Activity Date' datatype='date' name='[Calculation_4329929587286589443]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX(IF [activity] = &quot;offboarding_schedule&quot; THEN [date] END)}' />
            </column>
            <column caption='Is in Date Range' datatype='boolean' name='[Calculation_4329929587289300998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date] &lt;= [Calculation_4329929587286589443] then true else false end' />
            </column>
            <column datatype='string' name='[activity]' role='dimension' type='nominal'>
              <aliases>
