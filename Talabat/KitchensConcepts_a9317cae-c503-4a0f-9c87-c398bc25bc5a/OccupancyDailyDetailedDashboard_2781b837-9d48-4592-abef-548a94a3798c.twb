              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[sum:orders_target:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1qssm0l1t6m9be1ajt2md0w2b3bt].[usr:Calculation_284571221689298974:qk]&quot;' />
