      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='stall_activity' id='_942CF22C9E7F4413AC71940686AF04AA'>
            <properties context=''>
              <relation connection='bigquery.1rzh80r0uswxw812l87cr1ctay68' name='Custom SQL Query' type='text'>WITH  dates AS (
      SELECT *
      FROM UNNEST(GENERATE_DATE_ARRAY(&apos;2024-01-01&apos;, DATE_ADD(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 DAY)) AS date
    ),

    facility_info AS
  (SELECT
  f.countryCode,
  f.name AS kitchen_name,
  f.id as facility_id,
  s.id as stall_id,
  s.number AS stall_number,
  FROM `hfc-prod.gks_prod.stall` s
  LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=s.facilityId
  WHERE countryCode IN (&apos;AE&apos;,&apos;QA&apos;,&apos;BH&apos;,&apos;KW&apos;)
  ),

  all_offboarding_events as (
    SELECT
    p.id as partner_id,
    e.stallId as stall_id,
    ARRAY_AGG(e
    ORDER BY
    e.createdAt DESC
    )[SAFE_OFFSET(0)] latest_offboarding_event,
    FROM `hfc-prod.gks_prod.partner` p LEFT JOIN UNNEST(events) as e
    WHERE
    e.type IN (&quot;OffBoarding&quot;, &quot;OffBoardingScheduled&quot;, &quot;OffboardingCancelled&quot;)
    AND p.facilityType=&apos;Kitchen&apos;
    GROUP BY 1,2
    ),
    all_onboarding_events as (
    SELECT
    p.id as partner_id,
    e.stallId as stall_id,
    ARRAY_AGG(e
    ORDER BY
    e.createdAt DESC
    )[SAFE_OFFSET(0)] latest_onboarding_event,
    FROM `hfc-prod.gks_prod.partner` p LEFT JOIN UNNEST(events) as e
    WHERE
    e.type IN (&quot;OnBoarding&quot;, &quot;OnBoardingScheduled&quot;, &quot;OnboardingCancelled&quot;)
    AND p.facilityType=&apos;Kitchen&apos;
    GROUP BY 1,2
    ),
    final_events as (
    SELECT
    COALESCE(all_offboarding_events.partner_id, all_onboarding_events.partner_id) as partner_id,
    COALESCE(all_offboarding_events.stall_id, all_onboarding_events.stall_id) as stall_id,
    all_onboarding_events.latest_onboarding_event.createdAt as onboarding_date,
    all_onboarding_events.latest_onboarding_event.type as latest_onboarding_type,
    all_offboarding_events.latest_offboarding_event.createdAt as offboarding_date,
    all_offboarding_events.latest_offboarding_event.type as latest_offboarding_type,
    FROM (
    all_offboarding_events FULL JOIN all_onboarding_events
    ON (
    all_offboarding_events.partner_id = all_onboarding_events.partner_id
    AND all_offboarding_events.stall_id = all_onboarding_events.stall_id
    )
    )
    ),

  offboardings AS
    (SELECT
    EXTRACT(DATE FROM offboarding_date) AS date,
    f.id as facility_id,
    s.id as stall_id,
    p.name as partner_name,
    &apos;offboarding&apos; as activity
    FROM final_events
    LEFT JOIN `hfc-prod.gks_prod.partner` as p ON final_events.partner_id = p.id
    LEFT JOIN `hfc-prod.gks_prod.stall` s ON final_events.stall_id = s.id
    LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=s.facilityId
    WHERE
    s.type = &quot;Primary&quot;
    AND offboarding_date &gt;&gt;=&apos;2024-01-01&apos;
    AND offboarding_date &gt;&gt;= onboarding_date
    AND latest_offboarding_type = &quot;OffBoarding&quot;
    AND f.countryCode IN (&apos;AE&apos;,&apos;QA&apos;,&apos;BH&apos;,&apos;KW&apos;)
    ORDER BY 1, 2, 3, 4),

  onboardings as
      (SELECT
      EXTRACT(DATE FROM onboarding_date ) date,
      f.id as facility_id,
      s.id as stall_id,
      p.name as partner_name,
      &apos;onboarding&apos; as activity
      FROM final_events
      LEFT JOIN `hfc-prod.gks_prod.partner` as p ON final_events.partner_id = p.id
      LEFT JOIN `hfc-prod.gks_prod.stall` s ON final_events.stall_id = s.id
      LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=s.facilityId
      WHERE
      s.type = &quot;Primary&quot;
      AND onboarding_date &gt;&gt;=&apos;2024-01-01&apos;
      AND latest_onboarding_type = &quot;OnBoarding&quot;
      AND f.countryCode IN (&apos;AE&apos;,&apos;QA&apos;,&apos;BH&apos;,&apos;KW&apos;)
      ORDER BY 1, 2, 3, 4),

    onboarding_schedule as 
    (
      SELECT
      EXTRACT(DATE FROM schedule.onboarding.scheduledAt) AS date,
      f.id as facility_id,
      s.id as stall_id,
      p.name AS partner_name,
      &apos;onboarding_schedule&apos; as activity
      FROM `hfc-prod.gks_prod.stall` s
      LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=s.facilityId
      LEFT JOIN `hfc-prod.gks_prod.partner` p ON schedule.onboarding.partnerId=p.id
      WHERE schedule.onboarding.partnerId IS NOT NULL AND countryCode IN (&apos;AE&apos;,&apos;QA&apos;,&apos;BH&apos;,&apos;KW&apos;)
    ),

    offboarding_schedule AS
    (
      SELECT
      EXTRACT(DATE FROM schedule.offboarding.scheduledAt) AS date,
      f.id as facility_id,
      s.id as stall_id,
      p.name AS partner_name,
      &apos;offboarding_schedule&apos; as activity
      FROM `hfc-prod.gks_prod.stall` s
      LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=s.facilityId
      LEFT JOIN `hfc-prod.gks_prod.partner` p ON schedule.offboarding.partnerId=p.id
      WHERE schedule.offboarding.partnerId IS NOT NULL AND countryCode IN (&apos;AE&apos;,&apos;QA&apos;,&apos;BH&apos;,&apos;KW&apos;)
    ),

  joins AS
    (
      SELECT * FROM offboardings ofb
      UNION ALL
      SELECT * FROM onboardings onb
      UNION ALL
      SELECT * FROM offboarding_schedule ofbs
      UNION ALL
      SELECT * FROM onboarding_schedule onbs)

      SELECT 
      d.*,
      f.kitchen_name,
      f.stall_number,
      j.* EXCEPT(date),
      f.countryCode
      FROM dates d
      LEFT JOIN joins j on j.DATE = d.date
      LEFT JOIN facility_info f on f.stall_id = j.stall_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Occupancy' inline='true' name='federated.1qssm0l1t6m9be1ajt2md0w2b3bt' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='occupancy' name='bigquery.0tikx291fwzsn917ewsye0dmlkn5'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='gsheet' name='bigquery.0cv7c3c1u5xid815fuf4s0qynnlf'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_google_sheet' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0cv7c3c1u5xid815fuf4s0qynnlf' name='Custom SQL Query2' type='text'>Select * FROM `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info`</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0tikx291fwzsn917ewsye0dmlkn5' name='Custom SQL Query' type='text'><![CDATA[WITH
    dates AS (
      SELECT *
      FROM UNNEST(GENERATE_DATE_ARRAY('2021-01-01', DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY), INTERVAL 1 DAY)) AS date
    ),

    occupany_daily AS 
    (
      SELECT * FROM `fulfillment-dwh-production.curated_data_shared_gfs.occupancy_daily`
      WHERE report_day <<= current_date()-1
    ),

    kitchens AS -- occupancy for incubator
      (
        SELECT 
        DISTINCT kitchen_id    
        FROM occupany_daily so
      ),

    kv AS (
    SELECT 
    * 
    FROM `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendors`
    ),

  stalls_per_vendor AS (
     SELECT
       d.date as report_date,
       kv.vendor_id,
       kv.global_entity_id,
       COUNT(DISTINCT CONCAT(kv.stall_number, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name))) as stalls_per_vendor
     FROM
        dates d
      CROSS JOIN
        kv
     WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
           AND kv.stall_number IS NOT NULL
     GROUP BY 1,2,3
    ),

pre_base AS 
    (
     SELECT
        1 as prio, 
        d.date,
        d.date                           as report_date,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
            THEN TRUE
          ELSE FALSE
        END                              as is_active,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >> d.date)
            THEN FALSE
          ELSE TRUE
        END                              as is_churned,
        LEAST(kv.onboarding_date) AS onboarding_date,
        CASE WHEN d.date = LEAST(kv.onboarding_date)
          THEN 1 ELSE 0 END              as onboarding_count,
        kv.offboarding_date,
        CASE WHEN d.date = kv.offboarding_date
          THEN 1 ELSE 0 END              as offboarding_count,
        kv.global_entity_id,
        INITCAP(v.location.city)                  as city,
        kv.vendor_id,
        kv.kitchen_id,
        CONCAT(kv.vendor_id, kv.global_entity_id, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name), COALESCE(kv.stall_number, 'N/A')) AS uid,
        kv.vendor_name,
        kv.kitchen_short_name,
        kv.official_kitchen_name,
        COALESCE(kv.stall_number, 'N/A') AS stall_number,
        kv.partner_name,
        kv.total_stalls,
        COALESCE(stalls_per_vendor, 1) as stalls_per_vendor,
        kv.brand_name,
        kv.stall_id,
        v.country_code,
    FROM
        dates d
      CROSS JOIN
      kv
      LEFT JOIN `fulfillment-dwh-production.curated_data_shared_gfs.vendors` v ON v.vendor_id = kv.vendor_id AND v.global_entity_id = kv.global_entity_id
      LEFT JOIN stalls_per_vendor sv ON sv.vendor_id = kv.vendor_id AND sv.global_entity_id = kv.global_entity_id AND d.date = sv.report_date
      WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
    ), 
    
    base AS (
      SELECT * EXCEPT(prio)FROM pre_base
      QUALIFY  RANK() OVER (PARTITION BY report_date, vendor_id, global_entity_id ORDER BY prio ASC)  = 1
      ),

    base_vendors AS   
      (SELECT 
      date,
      kitchen_id,
      stall_id,
      vendor_id,
      vendor_name,
      partner_name,
      brand_name,
      kitchen_short_name,
      official_kitchen_name,
      country_code,
      is_active,
      is_churned,
      onboarding_date,
      offboarding_date,
      stalls_per_vendor
      FROM base),

    pre_final AS   
      (SELECT 
      COALESCE (v.date,o.report_day) as date,
      COALESCE (v.kitchen_id,o.kitchen_id) as kitchen_id,
      COALESCE (v.stall_id,o.stall_id) as stall_id,
      COALESCE (o.stall_number,"Insulator") as stall_number,
      COALESCE (v.partner_name,o.occupied_by_partner) as partner_name,
      COALESCE (v.kitchen_short_name,o.kitchen_short_name) as kitchen_short_name,
      COALESCE (v.country_code,o.countryCode) as country_code,
      COALESCE (o.occupation,true) as occupation,
      v.* EXCEPT(date,kitchen_id,stall_id,partner_name,kitchen_short_name,country_code),
      FROM base_vendors v
      FULL OUTER JOIN occupany_daily o on o.stall_id = v.stall_id AND o.report_day = v.date),

    final_stall AS 
    (SELECT 
    pf.*,
    CASE WHEN date = CURRENT_DATE() THEN true ELSE false END as latest_occupany,
    CASE WHEN stall_number = "Insulator" then true else false end as insulator_vendor
    FROM pre_final pf),

    metrics AS 
    (SELECT 
    *
    FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily`)
    
    Select 
    bt.*,
    successful_orders/stalls_per_vendor AS successful_orders,
    net_orders/stalls_per_vendor AS net_orders,
    gross_orders_ot/stalls_per_vendor AS gross_orders_ot,
    all_orders/stalls_per_vendor AS all_orders,
    vendor_rejected_orders_count/stalls_per_vendor AS vendor_rejected_orders_count,
    vendor_net_fail_orders/stalls_per_vendor AS vendor_net_fail_orders,
    net_fail_orders/stalls_per_vendor AS net_fail_orders,
    discounted_orders/stalls_per_vendor AS discounted_orders,
    t_pro_order/stalls_per_vendor AS t_pro_order,
    pickup_order/stalls_per_vendor AS pickup_order,
    tgo_order/stalls_per_vendor AS tgo_order,
    GEM_orders_ot/stalls_per_vendor AS GEM_orders_ot,
    GEM_fees_lc/stalls_per_vendor AS GEM_fees_lc,
    GEM_discount_amount_lc/stalls_per_vendor AS GEM_discount_amount_lc,
    free_delievery_order/stalls_per_vendor AS free_delievery_order,
    gmv_amount_total/stalls_per_vendor AS gmv_amount_total,
    gmv_amount_total_eur/stalls_per_vendor AS gmv_amount_total_eur,
    basket_amount_total/stalls_per_vendor AS basket_amount_total,
    basket_amount_total_eur/stalls_per_vendor AS basket_amount_total_eur,
    s_orders_gmv_amount/stalls_per_vendor AS s_orders_gmv_amount,
