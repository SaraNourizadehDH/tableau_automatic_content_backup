    free_delivery_returning_customer/stalls_per_vendor AS  free_delivery_returning_customer,
    targeted_deal_orders/stalls_per_vendor AS  targeted_deal_orders,
    targeted_deal_incentive_amount_lc/stalls_per_vendor AS  targeted_deal_incentive_amount_lc,
    targeted_deal_incentive_amount_eur/stalls_per_vendor AS  targeted_deal_incentive_amount_eur,
    targeted_deal_gmv_amount_lc/stalls_per_vendor AS  targeted_deal_gmv_amount_lc,
    targeted_deal_gmv_amount_eur/stalls_per_vendor AS  targeted_deal_gmv_amount_eur,
    targeted_deal_new_customer/stalls_per_vendor AS  targeted_deal_new_customer,
    targeted_deal_returning_customer/stalls_per_vendor AS  targeted_deal_returning_customer,
    gross_orders/stalls_per_vendor AS  gross_orders,
    vendor_contact_new/stalls_per_vendor AS  vendor_contact_new,
    contacted_orders/stalls_per_vendor AS  contacted_orders,
    schedule_duration_seconds/stalls_per_vendor AS  schedule_duration_seconds,
    offline_duration_seconds/stalls_per_vendor AS  offline_duration_seconds,
    schedule_duration_mins/stalls_per_vendor AS  schedule_duration_mins,
    offline_duration_mins/stalls_per_vendor AS  offline_duration_mins,
    award_date,
    award_last_date,
    is_top,
    is_currently_tc,
    currently_in_progress,
    current_month_defaulting_in_1_metrics,
    current_month_defaulting_in_2_metrics,
    current_month_defaulting_in_more_than_3_metrics,
    is_vendor_reporting,
    is_bestseller_participation,
    is_gem_participation,
    is_rdf_participation,
    is_free_delivery_participation,
    is_super_saver_participation,
    is_targeted_deal_participation,
    is_cpc_participation,
    is_fp_participation,
    is_kword_participation,
    is_other_adex_participation,
    from final_stall bt
    LEFT JOIN metrics m on bt.vendor_id = CAST(m.vendor_id AS STRING) and m.dates = bt.date]]></relation>
