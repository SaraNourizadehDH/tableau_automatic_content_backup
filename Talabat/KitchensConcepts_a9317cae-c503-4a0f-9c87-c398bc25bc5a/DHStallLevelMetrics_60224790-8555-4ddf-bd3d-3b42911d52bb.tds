    other_nb_clicks/stalls_per_vendor AS  other_nb_clicks,
    other_gmv_amount_lc_successful/stalls_per_vendor AS  other_gmv_amount_lc_successful,
    other_gmv_amount_eur_successful/stalls_per_vendor AS  other_gmv_amount_eur_successful,
    total_incentivized_orders/stalls_per_vendor AS  total_incentivized_orders,
    total_incentive_amount_lc/stalls_per_vendor AS  total_incentive_amount_lc,
    total_incentive_amount_eur/stalls_per_vendor AS  total_incentive_amount_eur,
    total_incentive_gmv_amount_lc/stalls_per_vendor AS  total_incentive_gmv_amount_lc,
    total_incentive_gmv_amount_eur/stalls_per_vendor AS  total_incentive_gmv_amount_eur,
    total_incentives_count/stalls_per_vendor AS  total_incentives_count,
    total_vendor_incentives_count/stalls_per_vendor AS  total_vendor_incentives_count,
    total_vendor_incentive_amount_lc/stalls_per_vendor AS  total_vendor_incentive_amount_lc,
    total_vendor_incentive_amount_eur/stalls_per_vendor AS  total_vendor_incentive_amount_eur,
    total_talabat_incentives_count/stalls_per_vendor AS  total_talabat_incentives_count,
    total_talabat_incentive_amount_lc/stalls_per_vendor AS  total_talabat_incentive_amount_lc,
    total_talabat_incentive_amount_eur/stalls_per_vendor AS  total_talabat_incentive_amount_eur,
    total_incentives_new_customer/stalls_per_vendor AS  total_incentives_new_customer,
