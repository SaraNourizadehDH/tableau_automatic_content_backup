  <column caption='Avg. Daily AOV Per Stall' datatype='real' name='[Avg. Daily GMV Per Stall (copy)_5765663075827466288]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Avg. Daily Order Per Stall (copy)_5765663075826991150]/[Calculation_284571221653946384]' />
  </column>
  <column caption='Avg. Daily GMV Per Stall' datatype='real' name='[Avg. Daily Order Per Stall (copy)_5765663075826991150]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(([Calculation_4329929587349651467])/[Calculation_5620070187988332548])/SUM([Calculation_5765663075566452748])' />
  </column>
  <column caption='Avg. Daily Order Per Stall (N)' datatype='real' name='[Avg. Daily Order Per Stall (copy)_868209605956358145]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='// when looking at week level, this metric duplicates the number of stalls . to avoid that i am applying a day level occupied stalls&#10;&#10;(([Calculation_6263451609632780289])/[Calculation_5620070187988332548])/([Calculation_5620070187987116034])' />
  </column>
  <column caption='Avg. Daily GMV' datatype='real' name='[Avg. Daily Orders (copy)_5765663075826991149]' role='measure' type='quantitative'>
