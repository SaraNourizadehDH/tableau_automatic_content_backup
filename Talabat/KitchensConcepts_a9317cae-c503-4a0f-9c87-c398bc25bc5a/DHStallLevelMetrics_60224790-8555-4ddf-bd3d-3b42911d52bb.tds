  <column caption='Risk Categorization' datatype='string' name='[Calculation_6136365637940191237]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [occupation] AND &#10;[stall_number] &lt;&gt; &quot;Insulator&quot;&#10;THEN &#10;(IF [country_code] = &quot;AE&quot; AND [Calculation_6136365637939777540] &gt;=100000 THEN &quot;No Risk&quot;&#10;ELSEIF [country_code] = &quot;KW&quot; AND [Calculation_6136365637939777540] &gt;=5000 THEN &quot;No Risk&quot;&#10;ELSEIF [Calculation_6136365637939777540] &gt;=75000 AND [Calculation_6136365637939777540] &lt;100000 AND [country_code] = &quot;AE&quot; THEN &quot;Low Risk&quot;&#10;ELSEIF [Calculation_6136365637939777540] &gt;=4500 AND [Calculation_6136365637939777540] &lt;5000 AND [country_code] = &quot;KW&quot; THEN &quot;Low Risk&quot;&#10;ELSEIF [Calculation_6136365637939777540] &gt;=50000 AND [Calculation_6136365637939777540] &lt;75000 AND [country_code] = &quot;AE&quot; THEN &quot;Medium Risk&quot;&#10;ELSEIF [Calculation_6136365637939777540] &gt;=3500 AND [Calculation_6136365637939777540] &lt;4500 AND [country_code] = &quot;KW&quot; THEN &quot;Medium Risk&quot;&#10;ELSEIF [Calculation_6136365637939777540] &lt;50000 AND [country_code] = &quot;AE&quot; THEN &quot;High Risk&quot; &#10;ELSEIF [Calculation_6136365637939777540] &lt;3500 AND [country_code] = &quot;KW&quot; THEN &quot;High Risk&quot; &#10;END) END' />
