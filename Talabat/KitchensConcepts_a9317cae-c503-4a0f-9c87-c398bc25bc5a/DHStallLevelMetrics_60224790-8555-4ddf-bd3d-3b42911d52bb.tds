  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='dim_vendor' id='_5004185B1A4142FE819483CDE342FDED'>
        <properties context=''>
          <relation connection='bigquery.0cv7c3c1u5xid815fuf4s0qynnlf' name='Custom SQL Query2' type='text'>Select * FROM `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info`</relation>
        </properties>
        <properties context='extract'>
          <relation name='_5004185B1A4142FE819483CDE342FDED' table='[Extract].[_5004185B1A4142FE819483CDE342FDED]' type='table' />
        </properties>
      </object>
      <object caption='Occupancy Daily Detailed' id='_5D58D3D5FEFC4427A6E3769D62A27D7F'>
        <properties context=''>
          <relation connection='bigquery.0tikx291fwzsn917ewsye0dmlkn5' name='Custom SQL Query' type='text'><![CDATA[WITH
    dates AS (
      SELECT *
      FROM UNNEST(GENERATE_DATE_ARRAY('2021-01-01', DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY), INTERVAL 1 DAY)) AS date
    ),

    occupany_daily AS 
    (
      SELECT * FROM `fulfillment-dwh-production.curated_data_shared_gfs.occupancy_daily`
      WHERE report_day <<= current_date()-1
    ),

    kitchens AS -- occupancy for incubator
      (
        SELECT 
        DISTINCT kitchen_id    
        FROM occupany_daily so
      ),

    kv AS (
    SELECT 
    * 
    FROM `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendors`
    ),

  stalls_per_vendor AS (
     SELECT
       d.date as report_date,
       kv.vendor_id,
       kv.global_entity_id,
       COUNT(DISTINCT CONCAT(kv.stall_number, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name))) as stalls_per_vendor
     FROM
        dates d
      CROSS JOIN
        kv
     WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
           AND kv.stall_number IS NOT NULL
     GROUP BY 1,2,3
    ),

pre_base AS 
    (
     SELECT
        1 as prio, 
        d.date,
        d.date                           as report_date,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
            THEN TRUE
          ELSE FALSE
        END                              as is_active,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >> d.date)
            THEN FALSE
          ELSE TRUE
        END                              as is_churned,
        LEAST(kv.onboarding_date) AS onboarding_date,
        CASE WHEN d.date = LEAST(kv.onboarding_date)
          THEN 1 ELSE 0 END              as onboarding_count,
        kv.offboarding_date,
        CASE WHEN d.date = kv.offboarding_date
          THEN 1 ELSE 0 END              as offboarding_count,
        kv.global_entity_id,
        INITCAP(v.location.city)                  as city,
        kv.vendor_id,
        kv.kitchen_id,
        CONCAT(kv.vendor_id, kv.global_entity_id, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name), COALESCE(kv.stall_number, 'N/A')) AS uid,
        kv.vendor_name,
        kv.kitchen_short_name,
        kv.official_kitchen_name,
        COALESCE(kv.stall_number, 'N/A') AS stall_number,
        kv.partner_name,
        kv.total_stalls,
        COALESCE(stalls_per_vendor, 1) as stalls_per_vendor,
        kv.brand_name,
        kv.stall_id,
        v.country_code,
    FROM
        dates d
      CROSS JOIN
      kv
      LEFT JOIN `fulfillment-dwh-production.curated_data_shared_gfs.vendors` v ON v.vendor_id = kv.vendor_id AND v.global_entity_id = kv.global_entity_id
      LEFT JOIN stalls_per_vendor sv ON sv.vendor_id = kv.vendor_id AND sv.global_entity_id = kv.global_entity_id AND d.date = sv.report_date
      WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
    ), 
    
    base AS (
      SELECT * EXCEPT(prio)FROM pre_base
      QUALIFY  RANK() OVER (PARTITION BY report_date, vendor_id, global_entity_id ORDER BY prio ASC)  = 1
      ),

    base_vendors AS   
      (SELECT 
      date,
      kitchen_id,
      stall_id,
      vendor_id,
      vendor_name,
      partner_name,
      brand_name,
      kitchen_short_name,
      official_kitchen_name,
      country_code,
      is_active,
      is_churned,
      onboarding_date,
      offboarding_date,
      stalls_per_vendor
      FROM base),

    pre_final AS   
      (SELECT 
      COALESCE (v.date,o.report_day) as date,
      COALESCE (v.kitchen_id,o.kitchen_id) as kitchen_id,
      COALESCE (v.stall_id,o.stall_id) as stall_id,
      COALESCE (o.stall_number,"Insulator") as stall_number,
      COALESCE (v.partner_name,o.occupied_by_partner) as partner_name,
      COALESCE (v.kitchen_short_name,o.kitchen_short_name) as kitchen_short_name,
      COALESCE (v.country_code,o.countryCode) as country_code,
      COALESCE (o.occupation,true) as occupation,
      v.* EXCEPT(date,kitchen_id,stall_id,partner_name,kitchen_short_name,country_code),
      FROM base_vendors v
      FULL OUTER JOIN occupany_daily o on o.stall_id = v.stall_id AND o.report_day = v.date),

    final_stall AS 
    (SELECT 
    pf.*,
    CASE WHEN date = CURRENT_DATE() THEN true ELSE false END as latest_occupany,
    CASE WHEN stall_number = "Insulator" then true else false end as insulator_vendor
    FROM pre_final pf),

    metrics AS 
    (SELECT 
    *
    FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily`)
    
    Select 
    bt.*,
    successful_orders/stalls_per_vendor AS  successful_orders,
    net_orders/stalls_per_vendor AS  net_orders,
    gross_orders_ot/stalls_per_vendor AS  gross_orders_ot,
    all_orders/stalls_per_vendor AS  all_orders,
    vendor_rejected_orders_count/stalls_per_vendor AS  vendor_rejected_orders_count,
    vendor_net_fail_orders/stalls_per_vendor AS  vendor_net_fail_orders,
    net_fail_orders/stalls_per_vendor AS  net_fail_orders,
    discounted_orders/stalls_per_vendor AS  discounted_orders,
    t_pro_order/stalls_per_vendor AS  t_pro_order,
    tgo_order/stalls_per_vendor AS  tgo_order,
    pickup_order/stalls_per_vendor AS  pickup_order,
    GEM_orders_ot/stalls_per_vendor AS  GEM_orders_ot,
    GEM_fees_lc/stalls_per_vendor AS  GEM_fees_lc,
    GEM_discount_amount_lc/stalls_per_vendor AS  GEM_discount_amount_lc,
    free_delievery_order/stalls_per_vendor AS  free_delievery_order,
    gmv_amount_total/stalls_per_vendor AS  gmv_amount_total,
    gmv_amount_total_eur/stalls_per_vendor AS  gmv_amount_total_eur,
    basket_amount_total/stalls_per_vendor AS  basket_amount_total,
    basket_amount_total_eur/stalls_per_vendor AS  basket_amount_total_eur,
    s_orders_gmv_amount/stalls_per_vendor AS  s_orders_gmv_amount,
    s_orders_gmv_amount_eur/stalls_per_vendor AS  s_orders_gmv_amount_eur,
    s_basket_amount_total/stalls_per_vendor AS  s_basket_amount_total,
    s_basket_amount_total_eur/stalls_per_vendor AS  s_basket_amount_total_eur,
    discount_amount_total/stalls_per_vendor AS  discount_amount_total,
    discount_amount_total_eur/stalls_per_vendor AS  discount_amount_total_eur,
    delivery_fee_total/stalls_per_vendor AS  delivery_fee_total,
    delivery_fee_total_eur/stalls_per_vendor AS  delivery_fee_total_eur,
    successful_commissionable_gmv_amount_lc/stalls_per_vendor AS  successful_commissionable_gmv_amount_lc,
    successful_commissionable_gmv_amount_eur/stalls_per_vendor AS  successful_commissionable_gmv_amount_eur,
    avg_order_rating/stalls_per_vendor AS  avg_order_rating,
    sum_order_rating/stalls_per_vendor AS  sum_order_rating,
    count_order_rating/stalls_per_vendor AS  count_order_rating,
    new_customer/stalls_per_vendor AS  new_customer,
    repeated_customer/stalls_per_vendor AS  repeated_customer,
    new_talabat_acquisition_customer_count/stalls_per_vendor AS  new_talabat_acquisition_customer_count,
    chain_acquisition_customer_count/stalls_per_vendor AS  chain_acquisition_customer_count,
    new_customer_order_count/stalls_per_vendor AS  new_customer_order_count,
    repeated_customer_order_count/stalls_per_vendor AS  repeated_customer_order_count,
    stacked_orders/stalls_per_vendor AS  stacked_orders,
    total_stacked_intravendor_orders/stalls_per_vendor AS  total_stacked_intravendor_orders,
    primary_stacked_count/stalls_per_vendor AS  primary_stacked_count,
    hold_back_time_sum/stalls_per_vendor AS  hold_back_time_sum,
    hold_back_time_count/stalls_per_vendor AS  hold_back_time_count,
    hold_back_time_sum_all_orders/stalls_per_vendor AS  hold_back_time_sum_all_orders,
    hold_back_time_count_all_orders/stalls_per_vendor AS  hold_back_time_count_all_orders,
    count_dropoff_manhattan_distance/stalls_per_vendor AS  count_dropoff_manhattan_distance,
    total_dropoff_manhattan_distance/stalls_per_vendor AS  total_dropoff_manhattan_distance,
    sum_promised_delivery_time/stalls_per_vendor AS  sum_promised_delivery_time,
    count_promised_delivery_time/stalls_per_vendor AS  count_promised_delivery_time,
    actual_delivery_time_sum/stalls_per_vendor AS  actual_delivery_time_sum,
    actual_delivery_time_count/stalls_per_vendor AS  actual_delivery_time_count,
    actual_delivery_time_comp_orders_sum/stalls_per_vendor AS  actual_delivery_time_comp_orders_sum,
    actual_delivery_time_comp_orders_count/stalls_per_vendor AS  actual_delivery_time_comp_orders_count,
    sum_actual_delivery_mintues_v2_only_tgo/stalls_per_vendor AS  sum_actual_delivery_mintues_v2_only_tgo,
    count_actual_delivery_minutes_v2_only_tgo/stalls_per_vendor AS  count_actual_delivery_minutes_v2_only_tgo,
    rider_late_sum/stalls_per_vendor AS  rider_late_sum,
    rider_late_count/stalls_per_vendor AS  rider_late_count,
    rider_late_5min/stalls_per_vendor AS  rider_late_5min,
    rider_late_10min/stalls_per_vendor AS  rider_late_10min,
    at_vendor_time_sum/stalls_per_vendor AS  at_vendor_time_sum,
