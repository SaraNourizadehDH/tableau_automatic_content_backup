  <column caption='ADOS Target (AK)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CM DA Targets Orders (All Kitchens) (copy)_2308024473945677851]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(SUM([Calculation_284571221687619609])/SUM([Orders Target (AK) (copy)_1555008534726004750]))/ATTR([Calculation_284571221688320027])' />
  </column>
  <column caption='ADOS Target (LK)' datatype='real' name='[CM DA Targets Orders (Live Kitchens) (copy)_2308024473936969754]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(SUM({ FIXED [month],[kitchen_short_name]: SUM([orders_target])})/SUM([Orders Target (Live Kitchens) (copy)_1555008534725591053]))/ATTR([Calculation_284571221688320027])' />
  </column>
  <column caption='CM DA Targets Orders (All Kitchens)' datatype='real' name='[CM DA Targets Orders (Live Kitchens) (copy)_2416744178414845992]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [month],[facility_short_name]: SUM([Calculation_284571221687619609])}' />
  </column>
  <column caption='CM Sessions' datatype='real' name='[CM GMV (copy)_1001136143899209757]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [Calculation_284571221703409702]: SUM(if [Calculation_284571221691129888] then [viewed_menu_session_count] END)}' />
  </column>
  <column caption='CM GMV' datatype='real' name='[CM Orders (copy)_1001136143667875840]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [Calculation_284571221703409702]: SUM(if [Calculation_284571221691129888] then [s_orders_gmv_amount_eur] END)}' />
  </column>
  <column caption='CM DA Targets GMV (Live Kitchens)' datatype='real' name='[CM Targets Orders (Live Kitchens) (copy)_1555008534679592962]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [month],[kitchen_short_name]: SUM([gmv_target])}' />
  </column>
  <column caption='vs Orders Target (var)' datatype='real' name='[Calculation_1001136143669456899]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_284571221689298974] - ([Calculation_284571221687619609])' />
  </column>
  <column caption='Vendor Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672229892]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vendor_contact_new])/SUM([gross_orders])' />
  </column>
  <column caption='Rejection Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672274949]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vendor_rejected_orders_count])/SUM([all_orders])' />
  </column>
  <column caption='Delay Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143672303622]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vendor_late_orders_10min])/SUM([successful_orders])' />
  </column>
  <column caption='vNet Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143673286664]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vendor_net_fail_orders])/SUM([net_orders])' />
  </column>
  <column caption='FIR Confidance Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143673421833]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([is_fir_confident_use_count])/SUM([total_fir_confident_use_count])' />
  </column>
  <column caption='Offline Rate' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674232842]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([offline_duration_seconds])/SUM([schedule_duration_seconds])' />
  </column>
  <column caption='V. Delay v2 10 Mins %' datatype='real' default-format='p0.00%' name='[Calculation_1001136143674703883]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vendor_late_orders_10min_V2])/SUM([vendor_late_orders_V2])' />
  </column>
  <column caption='Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1001136143674912780]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([sum_order_rating])/SUM([count_order_rating])' />
  </column>
  <column caption='Avg. Delviery Time' datatype='real' name='[Calculation_1001136143682281490]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([actual_delivery_time_sum])/SUM([actual_delivery_time_count])' />
  </column>
  <column caption='AOV Target' datatype='real' name='[Calculation_1001136143701532692]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([gmv_target])/SUM([orders_target])' />
  </column>
  <column caption='Current Months &amp; Previous Month' datatype='boolean' name='[Calculation_1001136143879372824]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Calculation_284571221691129888] or [Same Day Last Month (copy)_5765663075457064962] then true else false end' />
  </column>
  <column caption='Calculation5' datatype='boolean' name='[Calculation_1001136143880396825]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) = DATETRUNC(&apos;month&apos;,[date]) then true else false end' />
  </column>
  <column caption='Is Non incubator?' datatype='boolean' name='[Calculation_1001136143893135386]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [stall_number] = &quot;Insulator&quot; THEN false else true end' />
  </column>
  <column caption='Previous Period Same Day Occupancy' datatype='integer' name='[Calculation_1001136143903068193]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF ATTR([Calculation_1001136143935717416]) = ATTR([date]) then [Calculation_5620070187987116034] END' />
  </column>
  <column caption='Same Day Last Month' datatype='date' datatype-customized='true' name='[Calculation_1001136143935717416]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1,[Calculation_284571220502118409]))' />
  </column>
  <column caption='Max Month New' datatype='date' name='[Calculation_1153554870788886531]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{ FIXED :MAX(DATE(DATETRUNC(&apos;month&apos;,[date])))}' />
  </column>
  <column caption='Calculation4' datatype='real' name='[Calculation_1153554870790189061]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='LOOKUP([Calculation_5765663075810861098],-1)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Max Month Metric' datatype='real' name='[Calculation_1153554870798741516]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if ATTR([Calculation_1153554870788886531]) = ATTR(DATETRUNC(&apos;month&apos;,[date])) then [Calculation_6263451609632780289] END' />
  </column>
  <column caption='MoM Change' datatype='real' name='[Calculation_1153554870799458318]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_1153554870798741516] - [Max Month Metric (copy)_1153554870799011853]' />
  </column>
  <column caption='AVTC v1 ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1259178356459012096]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_sum])/SUM([at_vendor_time_cleaned_count])' />
  </column>
  <column caption='AVTC v2' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1259178356459151361]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_v2_sum])/SUM([at_vendor_time_cleaned_v2_count])' />
  </column>
  <column caption='EPT + AVTC' datatype='real' name='[Calculation_1259178356460400642]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([estimated_prep_time_sum])/SUM([estimated_prep_time_count]) + SUM([at_vendor_time_cleaned_sum])/SUM([at_vendor_time_cleaned_count])' />
  </column>
  <column caption='Calculation8' datatype='real' name='[Calculation_1259178356461064195]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([estimated_prep_time_sum])/SUM([estimated_prep_time_count]) + SUM([at_vendor_time_cleaned_sum])/SUM([at_vendor_time_cleaned_count])' />
  </column>
  <column caption='FIR Usage' datatype='real' name='[Calculation_1259178356463108100]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([fir_used_count])/SUM([primary_rider_near_restaurant_at_count])' />
  </column>
  <column caption='Avg. Hold Back Time' datatype='real' name='[Calculation_1259178356463255557]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([hold_back_time_sum])/SUM([hold_back_time_count])' />
  </column>
  <column caption='Assumed Actual Prep Time' datatype='real' name='[Calculation_1259178356463423494]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([assumed_actual_prep_time_sum])/SUM([assumed_actual_prep_time_count])' />
  </column>
  <column caption='Metric For Targets (Future)' datatype='real' name='[Calculation_1259178356465377288]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &quot;Orders&quot; THEN SUM([orders_target])&#10;WHEN &quot;GMV&quot; THEN SUM([gmv_target])&#10;WHEN &quot;Occupied Stalls&quot; THEN SUM([occupied_stalls])&#10;WHEN &quot;AOV&quot; THEN [Calculation_1001136143701532692]&#10;WHEN &quot;Total Stalls&quot; THEN SUM([total_stalls])&#10;WHEN &quot;Occupancy Rate&quot; THEN (SUM([occupied_stalls])/SUM([total_stalls]))&#10;END' />
  </column>
  <column caption='Empty Stalls (EOM)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1453325704608268295]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_6263451609621622784] - [Calculation_5765663075566452748]' />
  </column>
  <column caption='GMV' datatype='real' name='[Calculation_1453325704669708300]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;EUR&quot; THEN [Calculation_4329929587349651467]&#10;WHEN &quot;LC&quot; THEN [GMV (EUR) (copy)_1453325704669581323]&#10;END' />
  </column>
  <column caption='AOV' datatype='real' name='[Calculation_1453325704669851661]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;EUR&quot; THEN [Calculation_4329929587349651467]/[Calculation_6263451609632780289]&#10;WHEN &quot;LC&quot; THEN [GMV (EUR) (copy)_1453325704669581323]/[Calculation_6263451609632780289]&#10;END' />
  </column>
  <column caption='Calculation7' datatype='real' name='[Calculation_1453325704681062427]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders])), -1))'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='m1 Orders' datatype='real' name='[Calculation_1453325704681865247]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [vendor_id]: SUM(IF [Calculation_284571221703409702] = [Max Month (copy)_1453325704681504798] THEN [successful_orders] ELSE 0 END)}' />
  </column>
  <column caption='diffss' datatype='real' name='[Calculation_1453325704693366817]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Calculation_1453325704681865247])-SUM([federated.061dk1s13yut2z1a8rrkr1m0yl6v].[m1_successful_order_count])' />
  </column>
  <column caption='MoM Order Change' datatype='real' name='[Calculation_1453325704933650467]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IFNULL([Calculation_284571221689298974],0)) - (IFNULL(SUM([federated.061dk1s13yut2z1a8rrkr1m0yl6v].[m1_successful_order_count]),0))' />
  </column>
  <column caption='Incentive Order %' datatype='real' default-format='p0.00%' name='[Calculation_1453325704938979375]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([total_incentivized_orders])/[Calculation_6263451609632780289]' />
  </column>
  <column caption='Incentive Spend x GMV %' datatype='real' default-format='p0.00%' name='[Calculation_1453325704939454512]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([total_incentive_amount_eur])/([Calculation_4329929587349651467])' />
  </column>
  <column caption='Return Customer Order %' datatype='real' default-format='p0.00%' name='[Calculation_1453325704941105202]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([repeated_customer_order_count])/(SUM([repeated_customer_order_count])+SUM([new_customer_order_count]))' />
  </column>
  <column caption='Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1453325704942080051]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_6263451609632780289]/(SUM([repeated_customer])+SUM([new_customer]))' />
  </column>
  <column caption='var Occupied Stalls vs Target (AK)' datatype='real' name='[Calculation_1555008534985117721]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_5765663075566452748] - [Orders Target (AK) (copy)_1555008534726004750]' />
  </column>
  <column caption='Empty Stalls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2043578700016586755]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(if [occupation] = false then [stall_id] END)' />
  </column>
  <column caption='Avg. FIR Prep TIme' datatype='real' name='[Calculation_2043578700020854788]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Avg_FIR_Prep_Time_Sum])/SUM([Avg_FIR_Prep_Time_count])' />
  </column>
  <column caption='OPDPS' datatype='real' name='[Calculation_2043578700030935045]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([Calculation_6263451609632780289]/[Calculation_5620070187987116034])/COUNTD([date])' />
