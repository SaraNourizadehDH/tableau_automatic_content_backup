      <object caption='kitchen_info' id='_6A3E43F2521246E3ACCAD92D2934CE97'>
        <properties context=''>
          <relation connection='bigquery.0cv7c3c1u5xid815fuf4s0qynnlf' name='kitchen_info' type='text'>SELECT 
      DISTINCT
      kitchen_id,
      updated_opening_date
      FROM `fulfillment-dwh-production.curated_data_shared_gfs.occupancy_daily` o
      LEFT JOIN `hfc-prod.gks_prod.facility` f ON f.id=o.kitchen_id
      LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendors_looker` l on l.official_kitchen_name = f.officialName</relation>
        </properties>
        <properties context='extract'>
          <relation name='_6A3E43F2521246E3ACCAD92D2934CE97' table='[Extract].[_6A3E43F2521246E3ACCAD92D2934CE97]' type='table' />
        </properties>
      </object>
      <object caption='dhk_budget_2024_f' id='dhk_budget_2024_f_F0AC9ABB8F5A42FDB092E66A89AD2FF1'>
        <properties context=''>
          <relation connection='bigquery.0cv7c3c1u5xid815fuf4s0qynnlf' name='Custom SQL Query1' type='text'>SELECT 
SAFE_CAST(month as DATE) as month,
country_code,
facility_short_name,
SAFE_CAST(orders_target as FLOAT64) as orders_target,
SAFE_CAST(gmv_target as FLOAT64) as gmv_target,
SAFE_CAST(occupied_stalls as FLOAT64) as occupied_stalls,
SAFE_CAST(rental_revenue as FLOAT64) as rental_revenue,
SAFE_CAST(total_stalls as FLOAT64) as total_stalls,
SAFE_CAST(incremental_comission as FLOAT64) as incremental_comission,
FROM `tlb-data-prod.data_platform_google_sheet.dhk_budget_2024_f`</relation>
        </properties>
        <properties context='extract'>
          <relation name='dhk_budget_2024_f_F0AC9ABB8F5A42FDB092E66A89AD2FF1' table='[Extract].[dhk_budget_2024_f_F0AC9ABB8F5A42FDB092E66A89AD2FF1]' type='table' />
        </properties>
      </object>
