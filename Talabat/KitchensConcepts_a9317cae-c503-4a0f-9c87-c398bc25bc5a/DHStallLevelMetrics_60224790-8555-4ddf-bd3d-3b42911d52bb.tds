    <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)_2416744178311712775]&#10;WHEN &quot;Daily&quot; THEN (IF [date] &gt;= DATEADD(&apos;day&apos;,-60,[Calculation_284571220502118409]) AND [date] &lt;= [Calculation_284571220502118409] THEN 1 ELSE 0 END)&#10;WHEN &quot;Weekly&quot; THEN (IF DATETRUNC(&apos;week&apos;,[date]) &gt;= DATEADD(&apos;week&apos;,-8,[Calculation_284571220502118409]) AND DATETRUNC(&apos;week&apos;,[date]) &lt;= DATETRUNC(&apos;week&apos;,[Calculation_284571220502118409]) THEN 1 ELSE 0 END)&#10;WHEN &quot;Monthly&quot; THEN (IF DATETRUNC(&apos;month&apos;,[date]) &gt;= DATEADD(&apos;month&apos;,-6,[Calculation_284571220502118409]) AND DATETRUNC(&apos;month&apos;,[date]) &lt;= DATETRUNC(&apos;month&apos;,[Calculation_284571220502118409]) THEN 1 ELSE 0 END)&#10;WHEN &quot;Quarterly&quot; THEN (IF DATETRUNC(&apos;quarter&apos;,[date])  &gt;= DATEADD(&apos;quarter&apos;,-4,[Calculation_284571220502118409]) AND DATETRUNC(&apos;quarter&apos;,[date]) &lt;= DATETRUNC(&apos;quarter&apos;,[Calculation_284571220502118409]) THEN 1 ELSE 0 END)&#10;END' />
  </column>
