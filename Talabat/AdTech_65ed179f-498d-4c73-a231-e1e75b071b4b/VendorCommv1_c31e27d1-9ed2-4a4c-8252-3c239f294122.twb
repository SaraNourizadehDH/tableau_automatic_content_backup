            <column caption='EUR Budget outlier para' datatype='real' name='[LC Budget outlier para (copy)_1681813019318120462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Exclude&quot;&#13;&#10;&#13;&#10;THEN &#13;&#10;&#13;&#10;[Budget EU Fixed inclusive of outlier (copy)_1681813019317911565]&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;&#13;&#10;THEN [Budget LC  fixd (copy)_1391330841939763205]&#13;&#10;&#13;&#10;END' />
            </column>
