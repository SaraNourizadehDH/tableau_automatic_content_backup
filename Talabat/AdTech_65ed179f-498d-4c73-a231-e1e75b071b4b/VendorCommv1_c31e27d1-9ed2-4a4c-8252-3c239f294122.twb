  fct.booking_revenue_eur revenue_eur
FROM
  `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_daily` fct
INNER JOIN
  `tlb-data-prod.data_platform.dim_adex_booking_source` booking_source
USING
