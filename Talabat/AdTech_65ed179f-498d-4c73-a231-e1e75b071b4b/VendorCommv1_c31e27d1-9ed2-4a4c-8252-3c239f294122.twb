    <worksheet name='KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Bookings ' name='federated.06u76dz1jxefvr172d8po1g7xp0g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Outlier Switch' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06u76dz1jxefvr172d8po1g7xp0g'>
            <column caption='Budget LC  fixd exclusive of outlier' datatype='real' name='[Budget LC  fixd inclusive of outlier (copy)_1681813019314569224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: MAX([Budget LC inclusive of outlier (copy)_1681813019314176006])}' />
            </column>
            <column caption='Budget LC exclusive of outlier ' datatype='real' name='[Budget LC inclusive of outlier (copy)_1681813019314176006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1681813019312926723] = &quot;Exclude&quot;&#13;&#10;&#13;&#10;THEN [budget_lc]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Clicks Budget' datatype='real' name='[Calculation_1585830043047825410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED month(date),[vendor_id],[booking_id]: MAX([budget_lc])/MAX([click_price_lc])}' />
            </column>
            <column caption='UTR ' datatype='real' name='[Calculation_1585830043048005635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Cost AED fixd (copy)_1585830043348324374])/SUM([Cost AED fixd (copy)_1585830043070046226])' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_1585830043063214092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FIXED orders (copy)_1391330841902882818])/SUM([Cost AED fixd (copy)_1585830043348324374])' />
            </column>
            <column caption='Cost LC Fixed' datatype='real' name='[Calculation_1585830043069837329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: SUM([revenue_lc])}' />
            </column>
            <column caption='Cost LC Fixed 2' datatype='real' name='[Calculation_1585830043070181395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1585830043069837329] &gt; [Calculation_1681813019314872329] THEN [Calculation_1681813019314872329]&#13;&#10;ELSE [Calculation_1585830043069837329]&#13;&#10;END' />
            </column>
            <column caption='Outlier' datatype='string' name='[Calculation_1681813019312926723]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [budget_outlier_tag] = &quot;Outlier (&gt; 12 STD)&quot;&#13;&#10;&#13;&#10;THEN &quot;Include&quot;&#13;&#10;ELSE &quot;Exclude&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='LC Budget outlier para' datatype='real' name='[Calculation_1681813019314872329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Exclude&quot;&#13;&#10;&#13;&#10;THEN &#13;&#10;&#13;&#10;[Budget LC  fixd inclusive of outlier (copy)_1681813019314569224]&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 2] = &quot;Include&quot;&#13;&#10;&#13;&#10;THEN [Cost AED fixd (copy)_1585830043070046226]&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Tag' datatype='integer' name='[Calculation_284571231279075328]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [booking_status] =  &quot;cancelled&quot; and  [clicks] = 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='FIXED clicks' datatype='integer' name='[Calculation_548876231307329537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED month(date),[vendor_id],[booking_id]: SUM([clicks])}' />
            </column>
            <column caption='Budget LC  fixd inclusive of outlier' datatype='real' name='[Cost AED fixd (copy)_1585830043070046226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: MAX([budget_lc])}' />
            </column>
            <column caption='Budget Consumed LC' datatype='real' name='[Cost AED fixd (copy)_1585830043348324374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: SUM([Calculation_1585830043070181395])}' />
            </column>
            <column caption='Orders from CPC' datatype='integer' name='[FIXED clicks (copy)_548876231307423746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED month(date),[vendor_id],[booking_id]: SUM([orders])}' />
            </column>
            <column caption='FIXED GMV LC' datatype='real' name='[FIXED orders (copy)_1391330841902882818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH(date),[booking_id],[vendor_id]: SUM([gmv_amount_lc])}' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='CTO' datatype='real' name='[UTR (copy)_548876231307190272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FIXED clicks (copy)_548876231307423746])/SUM([Calculation_548876231307329537])' />
