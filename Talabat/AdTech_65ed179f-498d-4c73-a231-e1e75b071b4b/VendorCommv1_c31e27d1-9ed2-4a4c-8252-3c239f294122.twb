      <column caption='Booked Budget  (copy)' datatype='real' name='[Booked Budget  (copy)_687080469642297344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;LC&quot;&#13;&#10;&#13;&#10;THEN [Calculation_1681813019314872329]&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;EUR&quot;&#13;&#10;&#13;&#10;THEN [LC Budget outlier para (copy)_1681813019318120462]&#13;&#10;&#13;&#10;END' />
