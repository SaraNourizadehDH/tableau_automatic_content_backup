      <column caption='Calculation1 (copy)' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation1 (copy)_1453536832141877250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1283525939775512576]/SUM([total_customers_in_this_month])' />
      </column>
      <column caption='L2' datatype='string' name='[Calculation_1163336106926002179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [X] &#13;&#10;WHEN &apos;Higher than previous month&apos; THEN &apos;Existing - Returning&apos;&#13;&#10;WHEN &apos;Equal to previous month&apos; THEN &apos;Existing - Returning&apos;&#13;&#10;WHEN &apos;Lower than previous month&apos; THEN &apos;Existing - Returning&apos;&#13;&#10;&#13;&#10;WHEN &apos;Active 2 months ago&apos; THEN &apos;Existing - Reactivation&apos;&#13;&#10;WHEN &apos;Active 3+ months ago&apos; THEN &apos;Existing - Reactivation&apos;&#13;&#10;&#13;&#10;WHEN &apos;New Customer&apos; THEN &apos;New Customer&apos;&#13;&#10;&#13;&#10;WHEN &apos;Inactive this month&apos; THEN &apos;Inactive this month&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='L1' datatype='string' name='[Calculation_1163336106927030276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [X] &#13;&#10;WHEN &apos;Higher than previous month&apos; THEN &apos;Existing Customers&apos;&#13;&#10;WHEN &apos;Equal to previous month&apos; THEN &apos;Existing Customers&apos;&#13;&#10;WHEN &apos;Lower than previous month&apos; THEN &apos;Existing Customers&apos;&#13;&#10;WHEN &apos;Active 2 months ago&apos; THEN &apos;Existing Customers&apos;&#13;&#10;WHEN &apos;Active 3+ months ago&apos; THEN &apos;Existing Customers&apos;&#13;&#10;&#13;&#10;WHEN &apos;New Customer&apos; THEN &apos;New Customers&apos;&#13;&#10;&#13;&#10;WHEN &apos;Inactive this month&apos; THEN &apos;Inactive Customers&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_1163336106928844805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;L1&apos; THEN [Calculation_1163336106927030276]&#13;&#10;WHEN &apos;L2&apos; THEN [Calculation_1163336106926002179]&#13;&#10;WHEN &apos;L3&apos; THEN [Segments (copy)_1163336106925932546]&#13;&#10;END' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_1283525939775512576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([X])=&apos;Inactive this month&apos;&#13;&#10;THEN SUM([Customer_segments])*-1&#13;&#10;ELSE SUM([Customer_segments])&#13;&#10;END' />
      </column>
      <column caption='% of Customers' datatype='real' default-format='p0%' hidden='true' name='[Calculation_1453536832141467649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Customer_segments])/SUM([total_customers_in_this_month])' />
      </column>
      <column caption='Total Active Customers' datatype='integer' name='[Calculation_364510122679566336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([X])=&apos;Inactive this month&apos;&#13;&#10;THEN 0&#13;&#10;ELSE SUM([Customer_segments])&#13;&#10;END' />
      </column>
