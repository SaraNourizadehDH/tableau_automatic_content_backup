          <relation connection='bigquery.0rjagcy0h42o8g13no2a0043iq8a' name='Custom SQL Query' type='text'>with p_orders as (select analytical_customer_id,&#13;
order_id p_id,&#13;
date_trunc(order_date, month) p_month,&#13;
order_date p_date,&#13;
 case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as City&#13;
from `tlb-data-prod.data_platform.fct_order_info` O&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
where not is_test and is_successful and country_id = 9 and O.order_date &gt;&gt;= &apos;2020-09-01&apos;&#13;
-- and analytical_customer_id = &apos;zzzt9jJhSlW5zcnTABCqPg&apos;&#13;
)&#13;
&#13;
,c_orders as (select analytical_customer_id,&#13;
order_id c_id,&#13;
date_trunc(order_date, month) c_month,&#13;
order_date c_date,&#13;
 case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as City&#13;
from `tlb-data-prod.data_platform.fct_order_info` O&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
where not is_test and is_successful and country_id = 9 and O.order_date &gt;&gt;= &apos;2020-09-01&apos;&#13;
-- and analytical_customer_id = &apos;zzzt9jJhSlW5zcnTABCqPg&apos;&#13;
)&#13;
&#13;
&#13;
&#13;
&#13;
select Month,&#13;
Returning_date,&#13;
Returning_month,&#13;
Total_Users_of_Month,&#13;
City,&#13;
&#13;
Total_Users_of_Month - sum(case when Returning_date is null then 0 else Users end) over(partition by Month,City order by Returning_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) Diff_from_total&#13;
&#13;
&#13;
&#13;
from(select distinct Month,&#13;
Returning_date,&#13;
date_trunc(Returning_date, month) Returning_month,&#13;
City,&#13;
&#13;
count(analytical_customer_id) over(partition by Month,City,Returning_date) Users,&#13;
&#13;
&#13;
count(analytical_customer_id) over(partition by Month,City) Total_Users_of_Month&#13;
&#13;
&#13;
from(&#13;
select distinct p_orders.analytical_customer_id,&#13;
p_month Month,&#13;
case when c_orders.City is null then p_orders.City else c_orders.City end as City,&#13;
first_value(c_orders.c_date) over(partition by p_orders.analytical_customer_id,p_month order by c_orders.c_date) Returning_date,&#13;
&#13;
from p_orders&#13;
left join c_orders on p_orders.analytical_customer_id = c_orders.analytical_customer_id and p_orders.City = c_orders.City and c_orders.c_month = p_orders.p_month + interval 1 month&#13;
&#13;
&#13;
))</relation>
