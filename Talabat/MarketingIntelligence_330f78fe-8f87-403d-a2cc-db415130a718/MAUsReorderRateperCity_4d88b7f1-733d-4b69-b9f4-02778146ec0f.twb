      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Total Organic Base' id='_3ED60EABEB484E9193BA7AD57F03B46C'>
            <properties context=''>
              <relation connection='bigquery.0nei5gj1o6xtkp1b8j3r5181uuqq' name='Custom SQL Query2' type='text'>with p_orders as (select analytical_customer_id,&#13;
order_id p_id,&#13;
date_trunc(O.order_date, month) p_month,&#13;
order_date p_date,&#13;
 case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as City,&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` O&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
&#13;
where not is_test and is_successful and country_id = 9 and O.order_date &gt;&gt;= &apos;2020-09-01&apos;&#13;
-- and analytical_customer_id = &apos;zzzt9jJhSlW5zcnTABCqPg&apos;&#13;
)&#13;
&#13;
&#13;
&#13;
,o_c_orders as (select analytical_customer_id,&#13;
o.order_id c_id,&#13;
date_trunc(o.order_date, month) c_month,&#13;
order_date c_date,&#13;
 case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as City,&#13;
ifnull(is_talabat_funded, false) is_talabat_funded&#13;
from `tlb-data-prod.data_platform.fct_order_info` o&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
left join `tlb-data-dev.performance_management_egypt.cv_fct_fund` ff on o.order_id = ff.order_id&#13;
where not is_test and is_successful and country_id = 9 and (not ifnull(is_talabat_funded, false) and not ifnull(is_vendor_funded, false)) and O.order_date &gt;&gt;= &apos;2020-09-01&apos;&#13;
)&#13;
&#13;
&#13;
&#13;
select Month,&#13;
Organic_Returning_Date,&#13;
Organic_Returning_month,&#13;
Total_Users_of_Month,&#13;
City,&#13;
&#13;
Total_Users_of_Month - sum(case when Organic_Returning_Date is null then 0 else Organic_Users end) over(partition by Month,City order by Organic_Returning_Date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) Diff_from_total_organic&#13;
&#13;
&#13;
from(select distinct Month,&#13;
Organic_Returning_Date,&#13;
date_trunc(Organic_Returning_Date, month) Organic_Returning_month,&#13;
City,&#13;
count(analytical_customer_id) over(partition by Month,City,Organic_Returning_Date) Organic_Users,&#13;
&#13;
count(analytical_customer_id) over(partition by Month,City) Total_Users_of_Month&#13;
&#13;
&#13;
from(&#13;
select distinct p_orders.analytical_customer_id,&#13;
p_month Month,&#13;
case when o_c_orders.City is null then p_orders.City else o_c_orders.City end as City,&#13;
first_value(o_c_orders.c_date) over(partition by p_orders.analytical_customer_id,p_month order by o_c_orders.c_date) Organic_Returning_Date&#13;
&#13;
from p_orders&#13;
&#13;
left join o_c_orders on p_orders.analytical_customer_id = o_c_orders.analytical_customer_id and p_orders.City = o_c_orders.City and o_c_orders.c_month = p_orders.p_month + interval 1 month&#13;
&#13;
))</relation>
            </properties>
            <properties context='extract'>
              <relation name='_3ED60EABEB484E9193BA7AD57F03B46C' table='[Extract].[_3ED60EABEB484E9193BA7AD57F03B46C]' type='table' />
            </properties>
          </object>
