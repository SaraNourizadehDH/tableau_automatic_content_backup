      <datasource-dependencies datasource='federated.1ngs11316q9uj519tqqm400dfcxy'>
        <column caption='% from Total Users Organic Talabat' datatype='real' default-format='p0.0%' name='[% from Total Users (copy)_662029174472261632]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='1-(SUM([Diff_from_total_organic])/SUM([Total_Users_of_Month]))' />
        </column>
        <column caption='% from Total Users Organic' datatype='real' default-format='p0.0%' name='[% from Total Users Organic Talabat (copy)_662029175536001029]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='1-(SUM([Diff_from_total_organic (Custom SQL Query2)])/SUM([Total_Users_of_Month]))' />
        </column>
        <column caption='% from Total Users' datatype='real' default-format='p0.0%' name='[Calculation_138204242129760264]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='1-(SUM([Diff_from_total])/SUM([Total_Users_of_Month]))' />
        </column>
