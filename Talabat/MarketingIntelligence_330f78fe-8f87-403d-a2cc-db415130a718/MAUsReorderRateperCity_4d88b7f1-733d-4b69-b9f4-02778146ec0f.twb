        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ukbx2y0dfeqwf1douwxv1pa3c4f' name='Custom SQL Query' type='text'><![CDATA[with calendar as (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE('2020-01-01'), CURRENT_DATE(), INTERVAL 1 MONTH)) AS month)

,new_customers as (
select distinct OI.analytical_customer_id,
DL.city_name acquisition_city,
date_trunc(OI.order_date,month) acquisition_month,


from `tlb-data-prod.data_platform.fct_order_info` OI
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on OI.delivery_location_id = DL.location_id

where not OI.is_test and OI.is_successful and OI.analytical_customer_id is not null and OI.order_date >>= '2016-01-01' and OI.country_id = 9 

QUALIFY row_number() over(partition by analytical_customer_id order by order_time) = 1
)

,all_customer_month_data as (
select analytical_customer_id
,month
,acquisition_city 

from new_customers
cross join calendar
where month >>= acquisition_month
)

,orders as (
SELECT OI.analytical_customer_id,
DL.city_name,
date_trunc(OI.order_date, month) month,
count( OI.order_id) as successful_orders,

from `tlb-data-prod.data_platform.fct_order_info` OI
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on OI.delivery_location_id = DL.location_id

where not OI.is_test and OI.is_successful is true and OI.analytical_customer_id is not null and OI.order_date >>= '2020-01-01' and country_id = 9

group by 1,2,3
)



select distinct acquisition_city
,month
,X
,count(X) over(partition by acquisition_city, month, X) Customer_segments
,count(X) over (partition by acquisition_city, month) Total_customers_in_this_month
from 
(select acquisition_city,
analytical_customer_id,
month,
acquisition_month, 

case when acquisition_month = month then 'New Customer'
when month_1_orders >> 0 and this_month_orders >> month_1_orders then  'Higher than previous month'
when month_1_orders >> 0 and this_month_orders = month_1_orders then  'Equal to previous month'
when month_1_orders >> 0 and this_month_orders >> 0 and this_month_orders << month_1_orders then  'Lower than previous month'
when month_1_orders >> 0 and this_month_orders = 0 then 'Inactive this month'
when month_1_orders = 0 and this_month_orders >> 0 and month_2_orders >> 0 then 'Active 2 months ago'
when month_1_orders = 0 and this_month_orders >> 0 and month_2_orders = 0 then 'Active 3+ months ago' 
else null 
end

AS X

from(select acquisition_city,
analytical_customer_id,
month,
acquisition_month,

ifnull(successful_orders,0) this_month_orders,
ifnull(lead(successful_orders,1) over(partition by analytical_customer_id order by month desc ),0)  month_1_orders,
ifnull(lead(successful_orders,2) over(partition by analytical_customer_id order by month desc),0) month_2_orders,
ifnull(lead(successful_orders,3) over(partition by analytical_customer_id order by month desc),0) month_3_orders

from (select distinct cmd.analytical_customer_id
,cmd.month,cmd.acquisition_city
,o.successful_orders
,acquisition_month

from  all_customer_month_data cmd
left join orders o on cmd.analytical_customer_id=o.analytical_customer_id and cmd.month=o.month and cmd.acquisition_city = o.city_name
left join new_customers nc on cmd.analytical_customer_id=nc.analytical_customer_id and cmd.acquisition_city = nc.acquisition_city

where nc.acquisition_month <<= cmd.month)
)) where  X is not null]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ukbx2y0dfeqwf1douwxv1pa3c4f' name='Custom SQL Query' type='text'><![CDATA[with calendar as (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE('2020-01-01'), CURRENT_DATE(), INTERVAL 1 MONTH)) AS month)

