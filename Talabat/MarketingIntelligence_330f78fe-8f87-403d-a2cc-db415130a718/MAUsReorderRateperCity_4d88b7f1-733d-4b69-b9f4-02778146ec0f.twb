            <column datatype='date' name='[Returning_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Total_Users_of_Month]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_662029174474018819]' derivation='User' name='[diff:usr:Calculation_662029174474018819:qk:3]' pivot='key' type='quantitative'>
