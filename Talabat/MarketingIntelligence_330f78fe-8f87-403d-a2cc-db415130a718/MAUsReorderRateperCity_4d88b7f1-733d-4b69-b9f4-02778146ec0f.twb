          </named-connection>
          <named-connection caption='BigQuery (2)' name='bigquery.0nei5gj1o6xtkp1b8j3r5181uuqq'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='noura.abdelatef@talabat.com' workgroup-auth-mode='prompt' />
