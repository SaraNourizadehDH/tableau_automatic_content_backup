        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1grobaz1mrjv1f11lebcy0as8zmi' name='Custom SQL Query' type='text'>with dim_date as (select date from unnest(generate_date_array(&apos;2021-10-01&apos;, current_date-1)) date)&#13;
&#13;
&#13;
select dd.date order_date, case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as city, count(distinct analytical_customer_id) MAUs, count(distinct order_id) orders&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` O&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
cross join dim_date dd&#13;
&#13;
where country_id = 9 and is_successful and not is_test and order_date between date_trunc(dd.date, month) and dd.date and order_date &gt;&gt;= &apos;2021-10-01&apos;&#13;
&#13;
group by 1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1grobaz1mrjv1f11lebcy0as8zmi' name='Custom SQL Query' type='text'>with dim_date as (select date from unnest(generate_date_array(&apos;2021-10-01&apos;, current_date-1)) date)&#13;
&#13;
&#13;
select dd.date order_date, case when DL.city_name is null then &apos;ESM&apos; else DL.city_name end as city, count(distinct analytical_customer_id) MAUs, count(distinct order_id) orders&#13;
&#13;
from `tlb-data-prod.data_platform.fct_order_info` O&#13;
left join `tlb-data-prod.data_platform.sq_dim_location_eg` DL on O.delivery_location_id = DL.location_id&#13;
cross join dim_date dd&#13;
&#13;
where country_id = 9 and is_successful and not is_test and order_date between date_trunc(dd.date, month) and dd.date and order_date &gt;&gt;= &apos;2021-10-01&apos;&#13;
&#13;
group by 1,2</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
