          <datasource-dependencies datasource='Parameters'>
            <column alias='Normal' caption='Retention % Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
              <aliases>
                <alias key='&quot;Total&quot;' value='Normal' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nipwan0jwpagy106l1dx1x6oqjl'>
            <column caption='Last Date of Month' datatype='date' datatype-customized='true' name='[Calculation_1163336106946158598]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;&#13;&#10;    DATEADD(&apos;day&apos;, -1,&#13;&#10;&#13;&#10;        DATEADD(&apos;month&apos;, 1,&#13;&#10;&#13;&#10;            DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;&#13;&#10;        )&#13;&#10;&#13;&#10;    )&#13;&#10;&#13;&#10;)' />
            </column>
            <column caption='Last Day of Month' datatype='string' name='[Calculation_1163336106950553607]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [order_date]&#13;&#10;when [Calculation_1163336106946158598] then &apos;Y&apos;&#13;&#10;when DATE(DATEADD(&apos;day&apos;,-1,NOW())) then &apos;Y&apos;&#13;&#10;ELSE &apos;N&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
