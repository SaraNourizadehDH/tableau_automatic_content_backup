            <column-instance column='[order_date]' derivation='Month-Trunc' name='[tmn:order_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ngs11316q9uj519tqqm400dfcxy'>
            <column caption='% from Total Users Organic Talabat' datatype='real' default-format='p0.0%' name='[% from Total Users (copy)_662029174472261632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([Diff_from_total_organic])/SUM([Total_Users_of_Month]))' />
            </column>
            <column caption='% from Total Users Organic' datatype='real' default-format='p0.0%' name='[% from Total Users Organic Talabat (copy)_662029175536001029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([Diff_from_total_organic (Custom SQL Query2)])/SUM([Total_Users_of_Month]))' />
            </column>
            <column caption='Last Date of Month' datatype='date' datatype-customized='true' name='[Calculation_1163336106946158598]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [Returning_date]))))' />
            </column>
            <column caption='Last Day of Month' datatype='string' name='[Calculation_1163336106950553607]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Returning_date]&#13;&#10;when [Calculation_1163336106946158598] then &apos;Y&apos;&#13;&#10;when DATE(DATEADD(&apos;day&apos;, -1,NOW())) then &apos;Y&apos;&#13;&#10;&#13;&#10;ELSE &apos;N&apos;&#13;&#10;END' />
            </column>
            <column caption='% from Total Users' datatype='real' default-format='p0.0%' name='[Calculation_138204242129760264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([Diff_from_total])/SUM([Total_Users_of_Month]))' />
            </column>
            <column caption='% of Total Users LM' datatype='real' default-format='p0.0%' name='[Calculation_662029174474018819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Total&apos; THEN  [Calculation_138204242129760264]&#13;&#10;WHEN &apos;Talabat - Organic&apos; THEN [% from Total Users (copy)_662029174472261632]&#13;&#10;WHEN &apos;Organic&apos; THEN [% from Total Users Organic Talabat (copy)_662029175536001029]&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
