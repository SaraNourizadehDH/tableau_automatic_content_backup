        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00p8y0x1291t7p1e9p50u0u1e2pu' name='Custom SQL Query' type='text'>select distinct Month,
fund,
main_vertical,
cluster_name,

count(distinct order_id) over(partition by Month) orders_total,
count(distinct order_id) over(partition by Month,fund) orders_fund,
count(distinct order_id) over(partition by Month,main_vertical) orders_vertical,
count(distinct order_id) over(partition by Month,cluster_name) orders_cluster,
count(distinct order_id) over(partition by Month,fund,main_vertical,cluster_name) orders_all,


count(distinct analytical_customer_id) over(partition by Month) MAUs_total,
count(distinct analytical_customer_id) over(partition by Month,fund) MAUs_fund,
count(distinct analytical_customer_id) over(partition by Month,main_vertical) MAUs_vertical,
count(distinct analytical_customer_id) over(partition by Month,cluster_name) MAUs_cluster,
count(distinct analytical_customer_id) over(partition by Month,fund,main_vertical,cluster_name) MAUs_all,


from(select date_trunc(order_date,month) Month, 

case when ifnull(is_talabat_funded,false) then &apos;Talabat fund&apos;
when ifnull(is_vendor_funded,false) then &apos;Vendor fund&apos;
when not ifnull(is_vendor_funded,false) and not ifnull(is_talabat_funded,false) then &apos;Organic&apos;
else &apos;Both&apos;
end as fund,

case 
when not is_non_food then &apos;Food&apos;
when is_non_food and is_darkstore then &apos;tMart&apos;
else &apos;NFV&apos; end as main_vertical,

cluster_name,

o.order_id,

o.analytical_customer_id,

from `tlb-data-prod.data_platform.fct_order_info` o
left join `tlb-data-prod.data_platform.sq_cv_fct_fund_table` cff on o.order_id = cff.order_id
left join `tlb-data-prod.data_platform.sq_dim_location_eg` cdl on o.delivery_location_id = cdl.location_id

where is_successful and not is_test and country_id = 9 and order_date &gt;&gt;= &apos;2022-01-01&apos;
)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.00p8y0x1291t7p1e9p50u0u1e2pu' name='Custom SQL Query' type='text'>select distinct Month,
