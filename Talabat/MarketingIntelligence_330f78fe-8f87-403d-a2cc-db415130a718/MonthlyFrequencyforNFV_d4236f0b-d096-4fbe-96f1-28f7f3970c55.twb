      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/MonthlyFrequencyforNFV_16937363152380/FrequencyTrend?rev=' id='FrequencyTrend' path='/t/Talabat/workbooks/MonthlyFrequencyforNFV_16937363152380' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1nt5tug0ulmbbv1a5wjl91c9ghqi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nt5tug0ulmbbv1a5wjl91c9ghqi'>
            <column caption='Dimension' datatype='string' name='[Calculation_118219555811106826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Cluster&apos; then [cluster_name]&#13;&#10;WHEN &apos;Fund&apos; then [fund]&#13;&#10;WHEN &apos;Vertical&apos; THEN [main_vertical]&#13;&#10;WHEN &apos;All&apos; then &apos;All&apos;&#13;&#10;END' />
