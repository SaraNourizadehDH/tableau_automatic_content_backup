      <column caption='Frequency Fund' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (copy) (copy)_118219555801882627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_fund])/SUM([MAUs_fund])' />
      </column>
      <column caption='Frequency Cluster' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (copy)_118219555801870337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_cluster])/SUM([MAUs_cluster])' />
      </column>
