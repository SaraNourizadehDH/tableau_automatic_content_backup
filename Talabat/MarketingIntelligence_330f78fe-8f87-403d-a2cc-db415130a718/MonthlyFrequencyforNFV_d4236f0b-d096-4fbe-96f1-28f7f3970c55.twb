      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/MonthlyFrequencyforNFV_16937363152380/AvgDailyOrdersTrend?rev=' id='AvgDailyOrdersTrend' path='/t/Talabat/workbooks/MonthlyFrequencyforNFV_16937363152380' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1nt5tug0ulmbbv1a5wjl91c9ghqi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nt5tug0ulmbbv1a5wjl91c9ghqi'>
            <column caption='Avg Daily Order Vertical' datatype='real' name='[Avg Daily Order (copy) (copy) (copy)_118219555801894916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([orders_vertical])/Min(DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Month])))))' />
            </column>
            <column caption='Avg Daily Order Fund' datatype='real' name='[Avg Daily Order (copy) (copy)_118219555801882626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([orders_fund])/Min(DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Month])))))' />
            </column>
            <column caption='Avg Daily Order Cluster' datatype='real' name='[Avg Daily Order (copy)_118219555801870336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([orders_cluster])/Min(DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Month])))))' />
            </column>
            <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_118219555809947656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Cluster&apos; then [Avg Daily Order (copy)_118219555801870336] &#13;&#10;WHEN &apos;Fund&apos; then [Avg Daily Order (copy) (copy)_118219555801882626]&#13;&#10;WHEN &apos;Vertical&apos; THEN [Avg Daily Order (copy) (copy) (copy)_118219555801894916]&#13;&#10;WHEN &apos;All&apos; then [Calculation_1633962249539678208]&#13;&#10;END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_118219555811106826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Cluster&apos; then [cluster_name]&#13;&#10;WHEN &apos;Fund&apos; then [fund]&#13;&#10;WHEN &apos;Vertical&apos; THEN [main_vertical]&#13;&#10;WHEN &apos;All&apos; then &apos;All&apos;&#13;&#10;END' />
            </column>
            <column caption='Avg Daily Order' datatype='real' name='[Calculation_1633962249539678208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([orders_total])/Min(DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Month])))))' />
            </column>
