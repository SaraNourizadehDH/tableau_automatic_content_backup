          <named-connection caption='BigQuery' name='bigquery.04gas601jwgs0416u7mzs0gzjm4s'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='' username='muhammad.sarmad@talabat.com' workgroup-auth-mode='prompt' />
