  <worksheets>
    <worksheet name='Fail Rate TW vs LW'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>Fail Rate W/W Delta %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data_platform_logistics' name='federated.1oz1euz195y5me1esrrel0lk0lkm' />
          </datasources>
          <datasource-dependencies datasource='federated.1oz1euz195y5me1esrrel0lk0lkm'>
            <column caption='This Week' datatype='boolean' name='[Calculation_324822169020014592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,0,TODAY()))' />
            </column>
            <column caption='LFR TW' datatype='real' default-format='p0.00%' name='[Calculation_324822169022029828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[This Week Orders (copy)_324822169025536009]/[Calculation_324822169025032199]' />
            </column>
            <column caption='Delta TW vs LW' datatype='real' default-format='p0.00%' name='[Calculation_324822169024491526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_324822169022029828]-[LFT TW (copy)_324822169024372741])/[LFT TW (copy)_324822169024372741]' />
            </column>
            <column caption='This Week Orders' datatype='integer' name='[Calculation_324822169025032199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF( [Calculation_324822169020014592] = TRUE) THEN ([orders]) END)' />
            </column>
            <column caption='LFR LW' datatype='real' default-format='p0.00%' name='[LFT TW (copy)_324822169024372741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[This Week Failed Orders (copy)_324822169025634314]/[This Week Orders (copy)_324822169025306632]' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[This Week (copy)_324822169020424193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()))' />
            </column>
            <column caption='Last Week Failed Orders' datatype='integer' name='[This Week Failed Orders (copy)_324822169025634314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF( [This Week (copy)_324822169020424193] = TRUE) THEN ([failed_orders]) END)' />
            </column>
            <column caption='Last Week Orders' datatype='integer' name='[This Week Orders (copy)_324822169025306632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF( [This Week (copy)_324822169020424193] = TRUE) THEN ([orders]) END)' />
            </column>
            <column caption='This Week Failed Orders' datatype='integer' name='[This Week Orders (copy)_324822169025536009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF( [Calculation_324822169020014592] = TRUE) THEN ([failed_orders]) END)' />
            </column>
            <column caption='Date 1' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_324822169024491526]' derivation='User' name='[usr:Calculation_324822169024491526:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
