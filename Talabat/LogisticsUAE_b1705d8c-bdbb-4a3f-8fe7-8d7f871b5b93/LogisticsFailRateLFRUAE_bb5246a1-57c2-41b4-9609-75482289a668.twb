      <aliases enabled='yes' />
      <column caption='LFR %' datatype='real' default-format='p0.00%' name='[Calculation_2029434619629121538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [fail_reason]!=&quot;Null&quot; then [failed_orders] end)/SUM([Calculation_2029434619664478211])' />
      </column>
      <column caption='Total Ordrers By Date Period' datatype='integer' name='[Calculation_2029434619664478211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_2029434619665694724] : SUM([orders])}' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_2029434619665694724]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[date]))' />
      </column>
      <column caption='This Week' datatype='boolean' name='[Calculation_324822169020014592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,0,TODAY()))' />
      </column>
      <column caption='LFR TW' datatype='real' default-format='p0.00%' name='[Calculation_324822169022029828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[This Week Orders (copy)_324822169025536009]/[Calculation_324822169025032199]' />
      </column>
      <column caption='Delta TW vs LW' datatype='real' default-format='p0.00%' name='[Calculation_324822169024491526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_324822169022029828]-[LFT TW (copy)_324822169024372741])/[LFT TW (copy)_324822169024372741]' />
      </column>
      <column caption='This Week Orders' datatype='integer' name='[Calculation_324822169025032199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF( [Calculation_324822169020014592] = TRUE) THEN ([orders]) END)' />
      </column>
      <column caption='Top N' datatype='boolean' name='[Calculation_324822169030193163]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;=[Parameters].[Parameter 2]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_324822169030864908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
