          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oz1euz195y5me1esrrel0lk0lkm'>
            <column caption='Date' datatype='date' name='[Calculation_2029434619665694724]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[date]))' />
            </column>
            <column caption='Naya LFR' datatype='real' default-format='p0.00%' name='[Calculation_324822169887920141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [fail_reason]!=&quot;Null&quot; then [failed_orders] end)/SUM([Total Ordrers By Date Period (copy)_324822169889464334])' />
            </column>
            <column caption='Total Ordrers By Date Period (copy)' datatype='integer' name='[Total Ordrers By Date Period (copy)_324822169889464334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date]  : SUM([orders])}' />
            </column>
            <column-instance column='[Calculation_2029434619665694724]' derivation='Count' name='[cnt:Calculation_2029434619665694724:qk]' pivot='key' type='quantitative' />
            <column caption='Date 1' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Logistics Fail Reason' datatype='string' name='[fail_reason]' role='dimension' type='nominal' />
            <column datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2029434619665694724]' derivation='None' name='[none:Calculation_2029434619665694724:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fail_reason]' derivation='None' name='[none:fail_reason:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_324822169887920141]' derivation='User' name='[usr:Calculation_324822169887920141:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.1oz1euz195y5me1esrrel0lk0lkm].[none:Calculation_2029434619665694724:ok]' direction='DESC' using='[federated.1oz1euz195y5me1esrrel0lk0lkm].[cnt:Calculation_2029434619665694724:qk]' />
          <filter class='quantitative' column='[federated.1oz1euz195y5me1esrrel0lk0lkm].[none:date:qk]' filter-group='3' included-values='in-range-or-null'>
            <min>#2023-11-01#</min>
            <max>#2024-01-18#</max>
          </filter>
          <filter class='categorical' column='[federated.1oz1euz195y5me1esrrel0lk0lkm].[none:fail_reason:nk]'>
            <groupfilter count='[Parameters].[Parameter 2]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
