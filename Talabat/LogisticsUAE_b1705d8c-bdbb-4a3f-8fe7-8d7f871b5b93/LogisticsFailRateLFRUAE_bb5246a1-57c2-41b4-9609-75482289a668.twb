        </calculation>
      </column>
      <column caption='Naya LFR' datatype='real' default-format='p0.00%' name='[Calculation_324822169887920141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [fail_reason]!=&quot;Null&quot; then [failed_orders] end)/SUM([Total Ordrers By Date Period (copy)_324822169889464334])' />
      </column>
      <column caption='LFR_Tmp' datatype='integer' name='[Calculation_324822169919848469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(sum(IF [fail_reason]!=&quot;Null&quot; then [failed_orders] end)/SUM([Total Ordrers By Date Period (copy)_324822169889464334]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
