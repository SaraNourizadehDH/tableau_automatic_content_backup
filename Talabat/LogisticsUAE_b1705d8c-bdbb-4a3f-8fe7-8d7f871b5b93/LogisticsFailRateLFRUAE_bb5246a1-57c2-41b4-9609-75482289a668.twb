        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04gas601jwgs0416u7mzs0gzjm4s' name='Custom SQL Query' type='text'>SELECT a.order_date as date,&#13;
     e.zone_name  AS zone,&#13;
    e.city_name  AS city,&#13;
    case when b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful then c.reason end  AS fail_reason,&#13;
    count(distinct CASE WHEN  b.is_net AND  a.is_tgo  THEN  a.order_id END ) as orders,&#13;
    count(distinct CASE WHEN  b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful   THEN  a.order_id END )AS failed_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` a&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_order_status` b &#13;
ON b.order_status_id = a.order_status_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` c &#13;
ON c.order_fail_reason_id = a.order_fail_reason_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_chain` d &#13;
ON d.chain_id = a.chain_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_location_info` e &#13;
ON e.location_id = a.delivery_location_id&#13;
WHERE  a.order_date  &gt;&gt;= &apos;2023-01-01&apos; &#13;
AND UPPER( d.country_name  ) = UPPER(&apos;UAE&apos;)  &#13;
GROUP BY 1,2,3,4&#13;
having  count(distinct case when a.is_tgo and a.is_successful then a.order_id end) &gt;&gt;0 or &#13;
count(distinct CASE WHEN  b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful   THEN  a.order_id END )&gt;&gt;0</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.04gas601jwgs0416u7mzs0gzjm4s' name='Custom SQL Query' type='text'>SELECT a.order_date as date,&#13;
     e.zone_name  AS zone,&#13;
    e.city_name  AS city,&#13;
    case when b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful then c.reason end  AS fail_reason,&#13;
    count(distinct CASE WHEN  b.is_net AND  a.is_tgo  THEN  a.order_id END ) as orders,&#13;
    count(distinct CASE WHEN  b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful   THEN  a.order_id END )AS failed_orders&#13;
FROM `tlb-data-prod.data_platform.fct_order_info` a&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_order_status` b &#13;
ON b.order_status_id = a.order_status_id&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason` c &#13;
ON c.order_fail_reason_id = a.order_fail_reason_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_chain` d &#13;
ON d.chain_id = a.chain_id&#13;
INNER JOIN `tlb-data-prod.data_platform.dim_location_info` e &#13;
ON e.location_id = a.delivery_location_id&#13;
WHERE  a.order_date  &gt;&gt;= &apos;2023-01-01&apos; &#13;
AND UPPER( d.country_name  ) = UPPER(&apos;UAE&apos;)  &#13;
GROUP BY 1,2,3,4&#13;
having  count(distinct case when a.is_tgo and a.is_successful then a.order_id end) &gt;&gt;0 or &#13;
count(distinct CASE WHEN  b.is_net AND  a.is_tgo AND c.is_logistics_reason  AND NOT  a.is_successful   THEN  a.order_id END )&gt;&gt;0</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
