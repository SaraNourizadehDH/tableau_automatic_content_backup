  <datasources>
    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.0jzmpyl17xl192174o4pn0umsutx' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.03ljo9713gk16h17oja7s0gme7s5'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='server-custom' username='muhammad.sarmad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03ljo9713gk16h17oja7s0gme7s5' name='Custom SQL Query' type='text'><![CDATA[select distinct Month, Country_code, city_name, contract_name,issue_name,is_active,rideR_id,rideR_name, 
case when ((issue_name='Courier GPS off for X minutes' and sum(case_count)  >>=5) 
or (issue_name='Courier Fake GPS Usage Detected' and sum(case_count)  >>=1)
or (issue_name='Dropoff - no gps and delayed' and sum(case_count)  >>=2)
or (issue_name='Order clicked through' and sum(case_count)  >>=2)
or (issue_name="Order marked as delivered but didn't receive" and sum(case_count)  >>=2)
or (issue_name="Missing item" and sum(case_count)  >>=3)
)
then sum(case_count) 
end as case_count
from
(select
  extract(month from i.created_date) as Month,
  i.country_code,
  city_name,
  r.last_contract_name as contract_name,
  issue_name,
  r.is_active,
  rider_id,
  rider_name,
  count(distinct issue_id) case_count,

  from `fulfillment-dwh-production.curated_data_shared.issues` i
  left join `tlb-data-prod.data_platform.dim_logistics_rider` r using (country_code, rider_id)
  left join `tlb-data-prod.data_platform.dim_logistics_city` ci on ci.country_code = r.country_code and ci.city_id = r.last_city_id and ci.is_Active

  where extract(year from i.created_date)=extract(year from current_date())
  and extract(month from i.created_date)>>=extract(month from current_date())-6
    and i.created_date <<= current_date()-2
    and issue_name in ('Courier Fake GPS Usage Detected','Courier GPS off for X minutes','Dropoff - no gps and delayed','Order clicked through')
    and i.rider_id is not null
    and i.country_code = 'ae'
  group by 1,2,3,4,5,6,7,8

  union all

  select
  extract(month from cs.created_date) as Month,
  o.country_code,
  city_name,
  r.last_contract_name as contract_name,
  contact_reason_l3 as issue_name,
  r.is_active,
  primary_rider_id as rider_id,
  rider_name,
  count(distinct case_id) case_count,
  from `tlb-data-prod.data_platform.fct_logistics_order` o
  left join `tlb-data-prod.data_platform.dim_logistics_city` c on o.country_code = c.country_code and o.city_id =c.city_id and c.is_Active
  left join `tlb-data-prod.data_platform.dim_logistics_rider` r on o.country_code = r.country_code and o.primary_rider_id =r.rider_id
  left join (select * from `fulfillment-dwh-production.curated_data_shared_gcc_service.salesforce_cases` where extract(year from created_date)=extract(year from current_date())
  and extract(month from created_date)>>=extract(month from current_date())-6
    and created_date <<= current_date()-2) cs
  on o.order_code = cs.order_id and contact_reason_l3 in ("Order marked as delivered but didn't receive","Missing item")

  where
    extract(year from o.created_date)=extract(year from current_date())
  and extract(month from o.created_date)>>=extract(month from current_date())-6
    and o.created_date <<= current_date()-2
    and contact_reason_l3 is not null
    and primary_rider_id is not null
    and o.country_code = 'ae'

group by 1,2,3,4,5,6,7,8
order by 1,2,3,7
  )
group by 1,2,3,4,5,6,7,8
having  case_count >>0]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.03ljo9713gk16h17oja7s0gme7s5' name='Custom SQL Query' type='text'><![CDATA[select distinct Month, Country_code, city_name, contract_name,issue_name,is_active,rideR_id,rideR_name, 
