039','661046','730798','661024','661004','676698','734439','731052','661016','661018','661019','661002','661005','660989','665633','669381','661056','661000','660988','661059','663462','661058','661006','732574','661022','661028','660996','661023','661052','665629','660974','661055','719555','672948','661079','660982','766218','661086','661067','669374','661087','665624','660976','669376','667470','661090','698210','660980','661035','758372','660970','661081','661088','682312','665623','736743','682317','660993','722902','683485','661033','666944','691565','666947','668150','755837','722901','727309','676045','711100','661066','661025','755838','717998','704908','734404','660977','661068','723582','679240','660992','661082','661053','669257','661043','711666','666948','665628','676697','661015','672787','691568','676044','661050','661013','676047','661076','712702','661048','725769','691562','673268','660983','660995','661089','716139','704909','672785','660978','691564','717217','666946','661063','672786','661042','676046','661078','704910','704911','721929','721930','714542','660975','661074','661065','719554','667953','661080','723926','691569','661051','676043','669382','666952','661077','708676','661062','661008','661047','704514','674652','649876','640320','746437','642477','677435','660743','755234','760874','759975','674519','651604','674517','667784','758515','42425','652986','660554','623876','642860','42486','42485','623875','32647','602725','612121','32651','40240','705676','32649','32654','635542','755282','698457','698512','40166','38684','32657','42565','32658','698521','32648','698519','32897','32652','32659','698513','698458','689122','688960','689121','694772','692382','689119','700395','700393','700394','689123','753800','686472','724664','657955','44116','661250','754721','737611','684537','730690','736760','759340','674531','749860','613236','716144','656672','756575','749402','720468','41873','32545','623573','744377','32441','32444','623346','684494','32390','733844','734037','665689','30281','667595','30280','661128','719570')
  and entity_id = 'TB_AE'
),



od as 
(
  select
     
    c.city_name
    ,vendor.vendor_code
    ,vendor.name as vendor_name
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    -- ,extract(hour from DATEtime(d.created_at, d.timezone)) as hour
    ,global_order_id as order_code
    ,o.order_status
    ,CASE WHEN d.is_stacked_intravendor IS FALSE OR d.is_stacked_intravendor IS NULL THEN FALSE ELSE TRUE END AS is_stacked
    ,d.timings.to_vendor_time/60 as tvt
    ,d.timings.to_customer_time/60 as tct
    ,d.timings.actual_delivery_time/60 as dt
    ,o.timings.promised_delivery_time/60 as pdt
    ,o.timings.rider_accepting_time / 60 AS RAT
    ,o.estimated_prep_time/60 as EPT
    ,d.timings.at_vendor_time_cleaned/60 as AVTC
    ,TIMESTAMP_DIFF(vendor_prepared_at , o.sent_to_vendor_at , MINUTE) as FIR_prep
    ,vendor_delay_v2/60 as vendor_delay
    ,o.timings.rider_late/60 as rider_late
    ,o.timings.order_delay/60 as order_delay

  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  inner join vendors v on v.vendor_code = o.vendor.vendor_code
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  inner join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = d.city_id
  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  and COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  group by all
),

food_orders as 
(
   select
    c.city_name
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    -- ,extract(hour from DATEtime(d.created_at, d.timezone)) as hour
    ,count(distinct case when o.order_status = 'completed' then global_order_id end) as orders
  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  inner join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = d.city_id
  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  and vendor.vertical_type = 'restaurants'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  and COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  group by all
)

select 
o.city_name,
vendor_code,
vendor_name,
o.day,
-- o.hour,
count(distinct case when order_status = 'completed' then order_code end) as orders,
orders as food_orders,
COUNT(DISTINCT CASE WHEN is_stacked AND order_status = 'completed' THEN order_code end) AS stacked_orders,
sum(case when order_status = 'completed' then dt end) as dt,
count(distinct case when order_status = 'completed' and dt is not null then order_code end) as dt_orders,

sum(case when order_status = 'completed' then pdt end) as pdt,
count(distinct case when order_status = 'completed' and pdt is not null then order_code end) as pdt_orders,

sum(case when order_status = 'completed' then tvt end) as tvt,
count(distinct case when order_status = 'completed' and tvt is not null then order_code end) as tvt_orders,

sum(case when order_status = 'completed' then tct end) as tct,
count(distinct case when order_status = 'completed' and tct is not null then order_code end) as tct_orders,

sum(case when order_status = 'completed' then rat end) as rat,
count(distinct case when order_status = 'completed' and rat is not null then order_code end) as rat_orders,

sum(case when order_status = 'completed' then avtc end) as avtc,
count(distinct case when order_status = 'completed' and avtc is not null then order_code end) as avtc_orders,

sum(case when order_status = 'completed' then ept end) as ept,
count(distinct case when order_status = 'completed' and ept is not null then order_code end) as ept_orders,

sum(case when order_status = 'completed' then FIR_prep end) as FIR_prep,
count(distinct case when order_status = 'completed' and FIR_prep is not null then order_code end) as FIR_prep_orders,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then order_delay  end ) >> 10) THEN order_code  ELSE NULL END) as order_delay_10_num,
COUNT(DISTINCT case when order_delay is not null then  order_code end )AS order_delay_10_den,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then vendor_delay  end ) >> 10) THEN order_code  ELSE NULL END) as vendor_delay_10_num,
COUNT(DISTINCT case when vendor_delay is not null then  order_code end )AS vendor_delay_10_den,

COUNT(DISTINCT CASE WHEN ((rider_late) >> 10) THEN order_code  ELSE NULL END) as rider_late_10_num,
COUNT(DISTINCT CASE WHEN NOT ((rider_late) IS NULL) THEN order_code  ELSE NULL END) AS rider_late_10_den,

COUNT(DISTINCT CASE WHEN ((( case when order_status = 'completed' then ((dt) - (pdt))
						else null end ) >> -10 AND ( case when order_status = 'completed' then ((dt) - (pdt))
						else null end ) << 10)) THEN order_code  ELSE NULL END) as OOT_num

from od o
left join food_orders f on f.city_name = o.city_name and f.day = o.day --and f.hour = o.hour
group by all]]></relation>
          <relation connection='bigquery.0hj8wo60kq2znn18t6vno0fp39ta' name='Custom SQL Query1' type='text'><![CDATA[with city as 
(
  select 
    city_name,
    city_id
  from `tlb-data-prod.data_platform.dim_logistics_city`
  where country_code = 'ae'
),

zone as 
(
  select 
    zone_id,
    zone_name,
    city_id
  from `tlb-data-prod.data_platform.dim_logistics_zone`
  where country_code = 'ae'
),

fail_reason as
(
  select distinct order_fail_reason_id
    ,owner
    ,reason
    ,stage
    ,source
    ,talabat_reason
    ,reason_group
from `tlb-data-prod.data_platform.dim_order_fail_reason`
),

fct_info as 
(
  select 
    order_id
    ,o.order_fail_reason_id
    ,owner
    ,reason
    ,talabat_reason
    ,gmv_amount_lc
    ,delivery_location_id
  from `tlb-data-prod.data_platform.fct_order_info` o
  left join fail_reason f on o.order_fail_reason_id = f.order_fail_reason_id
  where country_code = 'AE'
  and order_date >>= '2025-01-01'
  and order_date >>= '2025-06-08'
  and order_date << current_date
),

od as 
(
  
  select
     c.city_name
    ,vendor.vendor_code
    ,DATETIME(d.created_at, d.timezone) as times
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    ,global_order_id as order_code
    ,o.order_status
    ,vendor.vertical_type
    ,owner
    ,reason
    ,talabat_reason
  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  left join fct_info i on cast(i.order_id as string) = o.global_order_id 
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  left join city c on c.city_id = d.city_id
  left join zone z on z.zone_id = o.zone_id

  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  and vendor.vendor_code in ('756000','686221','716696','687465','694100','687329','764852','751586','740240','750374','749070','714122','668854','724527','702695','710216','734819','737494','674306','728262','734982','706029','766554','695572','662765','678664','630107','761499','607003','644617','611374','693649','758364','673666','671098','43376','700703','702383','43377','681498','757358','663589','758365','622520','47099','644619','630136','627127','670633','43378','21869','672658','756871','759737','757360','630122','40698','627123','700701','627126','32100','35500','627124','723376','698324','693986','23527','714694','46986','47242','50573','602470','633030','634768','749780','631717','640074','633034','691838','719537','633029','635229','694858','725705','725707','693896','633033','711900','695529','719538','631714','633025','654102','726306','631927','633031','725697','694649','631716','719539','725710','719492','725699','635405','633094','633035','749995','741607','633027','633014','725704','694859','759267','637780','734712','691599','694862','637778','738667','631715','637783','725698','664005','633026','725708','635230','725713','725702','725711','640077','725701','640078','694860','697436','725706','725709','741609','633913','633011','633013','744548','725700','693641','693642','725712','640076','19653','668437','601041','612916','19647','38726','19644','38728','678157','634786','749196','731553','703262','603262','42893','27498','612467','679473','728387','740073','39353','27505','643775','27502','27499','33765','707083','27495','27501','27496','52211','732980','620804','741714','732906','668620','738343','35420','600083','51814','602984','758881','636150','742388','728919','600081','636151','695451','49850','697672','746730','695452','750219','600432','749740','45512','625167','640148','696622','633602','728913','600082','740377','695427','45511','51812','670944','633632','45514','695425','600084','600084','766585','758886','50475','50494','50895','7