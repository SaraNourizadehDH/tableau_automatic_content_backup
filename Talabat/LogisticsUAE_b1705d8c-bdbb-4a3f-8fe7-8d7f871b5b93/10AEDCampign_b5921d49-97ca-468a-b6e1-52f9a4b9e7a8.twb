      </column>
      <column caption='AVTC Target' datatype='real' name='[Calculation_2362630607162826769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [city_name] = &quot;Dubai&quot; &#10;THEN 4&#10;ELSEIF [city_name] = &quot;Ajman&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Abu dhabi&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Sharjah&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Rak&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Uaq&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Fujairah&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Al ain&quot; &#10;THEN 3.5&#10;END' />
