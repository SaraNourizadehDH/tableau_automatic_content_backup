)


select 
city_name,
day,
vendor_code,
count(distinct case when order_status = 'cancelled' then order_code end) cancel_orders,
count(distinct case when owner = 'VENDOR' and order_status = 'cancelled' then order_code end) vendor_cancel_orders,
count(distinct case when owner = 'TRANSPORT' and order_status = 'cancelled' then order_code end) log_cancel_orders,
count(distinct order_code) as total_orders,
count(distinct case when owner = 'TRANSPORT' and talabat_reason = 'Lack of Delivery Men' and order_status = 'cancelled' then order_code end) no_courier_cancel_orders,
count(distinct case when owner = 'TRANSPORT' and talabat_reason = 'Late Delivery' and order_status = 'cancelled' then order_code end) Late_delivery_cancel_orders,

from od
group by all]]></relation>
          <relation connection='bigquery.0hj8wo60kq2znn18t6vno0fp39ta' name='Custom SQL Query2' type='text'><![CDATA[-- Tableau dashboard
with vendors as
 ( 
  select vendor_code
    ,vendor_name
  from `tlb-data-prod.data_platform.dim_logistics_vendor` v
  where v.country_code = 'ae'
  and vendor_code in ('756000','686221','716696','687465','694100','687329','764852','751586','740240','750374','749070','714122','668854','724527','702695','710216','734819','737494','674306','728262','734982','706029','766554','695572','662765','678664','630107','761499','607003','644617','611374','693649','758364','673666','671098','43376','700703','702383','43377','681498','757358','663589','758365','622520','47099','644619','630136','627127','670633','43378','21869','672658','756871','759737','757360','630122','40698','627123','700701','627126','32100','35500','627124','723376','698324','693986','23527','714694','46986','47242','50573','602470','633030','634768','749780','631717','640074','633034','691838','719537','633029','635229','694858','725705','725707','693896','633033','711900','695529','719538','631714','633025','654102','726306','631927','633031','725697','694649','631716','719539','725710','719492','725699','635405','633094','633035','749995','741607','633027','633014','725704','694859','759267','637780','734712','691599','694862','637778','738667','631715','637783','725698','664005','633026','725708','635230','725713','725702','725711','640077','725701','640078','694860','697436','725706','725709','741609','633913','633011','633013','744548','725700','693641','693642','725712','640076','19653','668437','601041','612916','19647','38726','19644','38728','678157','634786','749196','731553','703262','603262','42893','27498','612467','679473','728387','740073','39353','27505','643775','27502','27499','33765','707083','27495','27501','27496','52211','732980','620804','741714','732906','668620','738343','35420','600083','51814','602984','758881','636150','742388','728919','600081','636151','695451','49850','697672','746730','695452','750219','600432','749740','45512','625167','640148','696622','633602','728913','600082','740377','695427','45511','51812','670944','633632','45514','695425','600084','600084','766585','758886','50475','50494','50895','711702',