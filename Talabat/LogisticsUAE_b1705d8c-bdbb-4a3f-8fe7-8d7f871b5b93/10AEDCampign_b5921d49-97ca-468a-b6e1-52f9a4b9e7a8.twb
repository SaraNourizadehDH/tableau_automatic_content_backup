)


select 
city_name,
day,
vendor_code,
count(distinct case when order_status = 'cancelled' then order_code end) cancel_orders,
count(distinct case when owner = 'VENDOR' and order_status = 'cancelled' then order_code end) vendor_cancel_orders,
count(distinct case when owner = 'TRANSPORT' and order_status = 'cancelled' then order_code end) log_cancel_orders,
count(distinct order_code) as total_orders,
count(distinct case when owner = 'TRANSPORT' and talabat_reason = 'Lack of Delivery Men' and order_status = 'cancelled' then order_code end) no_courier_cancel_orders,
count(distinct case when owner = 'TRANSPORT' and talabat_reason = 'Late Delivery' and order_status = 'cancelled' then order_code end) Late_delivery_cancel_orders,

from od
group by all]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
