    <worksheet name='WOW'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.0ss0pek0wag4vx16ftu1s08u5oun' />
          </datasources>
          <datasource-dependencies datasource='federated.0ss0pek0wag4vx16ftu1s08u5oun'>
            <column caption='WOW - Orders' datatype='real' name='[Calculation_2362630607181205526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [orders] END))-1' />
            </column>
            <column caption='WOW - AVTC' datatype='real' name='[Calculation_2362630607181504535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [avtc] END)/SUM(CASE [day] when TODAY()-1 THEN [avtc_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [avtc] END)/SUM(CASE [day] when TODAY()-8 THEN [avtc_orders] END))-1' />
            </column>
            <column datatype='integer' name='[FIR_prep]' role='measure' type='quantitative' />
            <column datatype='integer' name='[FIR_prep_orders]' role='measure' type='quantitative' />
            <column caption='WOW -  LFR' datatype='real' name='[WOW -  FIR Prep (copy)_2362630607183908894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [log_cancel_orders] END)/SUM(CASE [day] when TODAY()-1 THEN [total_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [log_cancel_orders] END)/SUM(CASE [day] when TODAY()-8 THEN [total_orders] END))-1' />
            </column>
            <column caption='WOW -  Stacking%' datatype='real' name='[WOW -  FIR Prep (copy)_2362630607205175335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [stacked_orders] END)/SUM(CASE [day] when TODAY()-1 THEN [orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [stacked_orders] END)/SUM(CASE [day] when TODAY()-8 THEN [orders] END))-1' />
            </column>
            <column caption='WOW -  NFR' datatype='real' name='[WOW -  LFR (copy)_2362630607184052255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [cancel_orders] END)/SUM(CASE [day] when TODAY()-1 THEN [total_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [cancel_orders] END)/SUM(CASE [day] when TODAY()-8 THEN [total_orders] END))-1' />
            </column>
            <column caption='WOW - Order Delay 10%' datatype='real' name='[WOW -  LFR (copy)_2362630607184261154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [order_delay_10_num] END)/SUM(CASE [day] when TODAY()-1 THEN [order_delay_10_den] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [order_delay_10_num] END)/SUM(CASE [day] when TODAY()-8 THEN [order_delay_10_den] END))-1' />
            </column>
            <column caption='WOW -  RAT' datatype='real' name='[WOW -  LFR (copy)_2362630607184728101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [rat] END)/SUM(CASE [day] when TODAY()-1 THEN [rat_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [rat] END)/SUM(CASE [day] when TODAY()-8 THEN [rat_orders] END))-1' />
            </column>
            <column caption='WOW -  VFR' datatype='real' name='[WOW -  NFR (copy)_2362630607184130080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [vendor_cancel_orders] END)/SUM(CASE [day] when TODAY()-1 THEN [total_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [vendor_cancel_orders] END)/SUM(CASE [day] when TODAY()-8 THEN [total_orders] END))-1' />
            </column>
            <column caption='WOW - DT' datatype='real' name='[WOW - AVTC (copy)_2362630607182921753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [dt] END)/SUM(CASE [day] when TODAY()-1 THEN [dt_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN dt END)/SUM(CASE [day] when TODAY()-8 THEN [dt_orders] END))-1' />
            </column>
            <column caption='WOW -  FIR Prep' datatype='real' name='[WOW - AVTC (copy)_2362630607183298587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [FIR_prep] END)/SUM(CASE [day] when TODAY()-1 THEN [FIR_prep_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [FIR_prep] END)/SUM(CASE [day] when TODAY()-8 THEN [FIR_prep_orders] END))-1' />
