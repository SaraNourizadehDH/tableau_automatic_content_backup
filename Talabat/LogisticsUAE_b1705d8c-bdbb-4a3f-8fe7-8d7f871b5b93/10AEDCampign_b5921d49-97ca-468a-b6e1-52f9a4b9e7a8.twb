od as 
(
  select
     
    c.city_name
    ,vendor.vendor_code
    ,vendor.name as vendor_name
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    -- ,extract(hour from DATEtime(d.created_at, d.timezone)) as hour
    ,global_order_id as order_code
    ,o.order_status
    ,CASE WHEN d.is_stacked_intravendor IS FALSE OR d.is_stacked_intravendor IS NULL THEN FALSE ELSE TRUE END AS is_stacked
    ,d.timings.to_vendor_time/60 as tvt
    ,d.timings.to_customer_time/60 as tct
    ,d.timings.actual_delivery_time/60 as dt
    ,o.timings.promised_delivery_time/60 as pdt
    ,o.timings.rider_accepting_time / 60 AS RAT
    ,o.estimated_prep_time/60 as EPT
    ,d.timings.at_vendor_time_cleaned/60 as AVTC
    ,TIMESTAMP_DIFF(vendor_prepared_at , o.sent_to_vendor_at , MINUTE) as FIR_prep
    ,vendor_delay_v2/60 as vendor_delay
    ,o.timings.rider_late/60 as rider_late
    ,o.timings.order_delay/60 as order_delay

  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  inner join vendors v on v.vendor_code = o.vendor.vendor_code
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  inner join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = d.city_id
  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  and COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  group by all
),

food_orders as 
(
   select
    c.city_name
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    -- ,extract(hour from DATEtime(d.created_at, d.timezone)) as hour
    ,count(distinct case when o.order_status = 'completed' then global_order_id end) as orders
  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  inner join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = d.city_id
  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  and vendor.vertical_type = 'restaurants'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  and COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  group by all
)

select 
o.city_name,
vendor_code,
vendor_name,
o.day,
-- o.hour,
count(distinct case when order_status = 'completed' then order_code end) as orders,
orders as food_orders,
COUNT(DISTINCT CASE WHEN is_stacked AND order_status = 'completed' THEN order_code end) AS stacked_orders,
sum(case when order_status = 'completed' then dt end) as dt,
count(distinct case when order_status = 'completed' and dt is not null then order_code end) as dt_orders,

sum(case when order_status = 'completed' then pdt end) as pdt,
count(distinct case when order_status = 'completed' and pdt is not null then order_code end) as pdt_orders,

sum(case when order_status = 'completed' then tvt end) as tvt,
count(distinct case when order_status = 'completed' and tvt is not null then order_code end) as tvt_orders,

sum(case when order_status = 'completed' then tct end) as tct,
count(distinct case when order_status = 'completed' and tct is not null then order_code end) as tct_orders,

sum(case when order_status = 'completed' then rat end) as rat,
count(distinct case when order_status = 'completed' and rat is not null then order_code end) as rat_orders,

sum(case when order_status = 'completed' then avtc end) as avtc,
count(distinct case when order_status = 'completed' and avtc is not null then order_code end) as avtc_orders,

sum(case when order_status = 'completed' then ept end) as ept,
count(distinct case when order_status = 'completed' and ept is not null then order_code end) as ept_orders,

sum(case when order_status = 'completed' then FIR_prep end) as FIR_prep,
count(distinct case when order_status = 'completed' and FIR_prep is not null then order_code end) as FIR_prep_orders,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then order_delay  end ) >> 10) THEN order_code  ELSE NULL END) as order_delay_10_num,
COUNT(DISTINCT case when order_delay is not null then  order_code end )AS order_delay_10_den,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then vendor_delay  end ) >> 10) THEN order_code  ELSE NULL END) as vendor_delay_10_num,
COUNT(DISTINCT case when vendor_delay is not null then  order_code end )AS vendor_delay_10_den,

COUNT(DISTINCT CASE WHEN ((rider_late) >> 10) THEN order_code  ELSE NULL END) as rider_late_10_num,
COUNT(DISTINCT CASE WHEN NOT ((rider_late) IS NULL) THEN order_code  ELSE NULL END) AS rider_late_10_den,

COUNT(DISTINCT CASE WHEN ((( case when order_status = 'completed' then ((dt) - (pdt))
						else null end ) >> -10 AND ( case when order_status = 'completed' then ((dt) - (pdt))
						else null end ) << 10)) THEN order_code  ELSE NULL END) as OOT_num

from od o
left join food_orders f on f.city_name = o.city_name and f.day = o.day --and f.hour = o.hour
group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_675D37CD871C4DAEBB5BC787AF3DB722' table='[Extract].[_675D37CD871C4DAEBB5BC787AF3DB722]' type='table' />
            </properties>
          </object>
          <object caption='Excluding Camp' id='_A4A20BE92DCB429C9E1D9B24BD743537'>
            <properties context=''>
              <relation connection='bigquery.0hj8wo60kq2znn18t6vno0fp39ta' name='Custom SQL Query2' type='text'><![CDATA[-- Tableau dashboard
with vendors as
 ( 
  select vendor_code
    ,vendor_name
  from `tlb-data-prod.data_platform.dim_logistics_vendor` v
  where v.country_code = 'ae'
  and vendor_code in ('756000','686221','716696','687465','694100','687329','764852','751586','740240','750374','749070','714122','668854','724527','702695','710216','734819','737494','674306','728262','734982','706029','766554','695572','662765','678664','630107','761499','607003','644617','611374','693649','758364','673666','671098','43376','700703','702383','43377','681498','757358','663589','758365','622520','47099','644619','630136','627127','670633','43378','21869','672658','756871','759737','757360','630122','40698','627123','700701','627126','32100','35500','627124','723376','698324','693986','23527','714694','46986','47242','50573','602470','633030','634768','749780','631717','640074','633034','691838','719537','633029','635229','694858','725705','725707','693896','633033','711900','695529','719538','631714','633025','654102','726306','631927','633031','725697','694649','631716','719539','725710','719492','725699','635405','633094','633035','749995','741607','633027','633014','725704','694859','759267','637780','734712','691599','694862','637778','738667','631715','637783','725698','664005','633026','725708','635230','725713','725702','725711','640077','725701','640078','694860','697436','725706','725709','741609','633913','633011','633013','744548','725700','693641','693642','725712','640076','19653','668437','601041','612916','19647','38726','19644','38728','678157','634786','749196','731553','703262','603262','42893','27498','612467','679473','728387','740073','39353','27505','643775','27502','27499','33765','707083','27495','27501','27496','52211','732980','620804','741714','732906','668620','738343','35420','600083','51814','602984','758881','636150','742388','728919','600081','636151','695451','49850','697672','746730','695452','750219','600432','749740','45512','625167','640148','696622','633602','728913','600082','740377','695427','45511','51812','670944','633632','45514','695425','600084','600084','766585','758886','50475','50494','50895','711702','38439','50921','50476','50489','666103','757303','50474','50491','604809','638597','50497','50500','50898','764826','742345','50495','50483','50486','21766','609277','50487','28987','739719','50467','20619','690093','733892','50493','658553','686876','38435','50496','20000','606762','740548','609520','602478','38546','38440','621616','700711','676187','19568','21592','734576','50504','24846','734822','740091','50503','20625','738651','764825','616745','718799','608995','717950','762441','727470','726767','718230','621546','722865','699895','718231','722864','718234','722867','728678','735812','753361','747117','746914','728682','748479','728676','728677','728679','741926','728403','728675','745888','728680','728681','626194','760877','40463','40471','724180','626501','626191','626148','626192','40469','628600','728786','626935','753266','709807','643816','626936','626193','714041','756452','694920','707631','628890','626446','629204','14984','628416','656698','628599','628598','698264','717391','626937','747176','738539','726537','714131','735008','710136','710137','755853','706825','706814','722167','626184','653774','663449','626182','623015','662651','614268','626179','662644','689085','626176','626185','662640','636079','626177','764602','51783','51782','51775','51780','51766','51774','650848','51768','748665','51776','657412','51771','51770','51777','51778','51781','51773','51769','624466','51779','51772','51767','686771','747558','714291','666908','725085','34259','609959','622379','746648','660799','660802','654312','33487','651354','726637','746488','722324','717404','714292','716914','609410','636547','697153','746301','746295','717868','696801','762634','643260','23156','41198','611910','21149','50536','38810','678958','42578','701383','728377','677617','661245','759985','758500','648491','674515','754608','674516','661293','623715','652839','38956','642820','40319','623716','660560','37686','29565','27565','699067','33145','40646','29567','621259','636553','764601','734933','653817','27567','27568','688946','33416','663323','622808','614042','625870','27574','27572','27601','706891','673994','703982','750323','703860','679061','38980','736352','680195','643904','34025','724307','667851','36270','711696','645581','704423','668770','2894','700483','684295','684459','740339','688990','683818','661424','675620','641184','632331','632335','749840','632325','606881','624944','632328','718084','639461','668449','639436','632340','632327','668462','659733','691558','632322','623902','632326','601809','48092','747109','632323','701638','730962','694656','624946','614284','606935','694301','35450','710560','669554','35449','608441','632332','639460','703708','47038','639824','700204','636188','735559','632334','673723','719696','24016','625834','609077','716387','696699','673722','632333','617524','24009','669731','24013','632337','669393','632341','695759','632324','24014','24007','695678','24019','712547','624943','24011','24008','669813','24006','721471','48382','632336','673725','719223','741014','609078','617523','671193','614282','607244','50447','51725','43798','600897','602545','687337','657113','44126','607246','31801','50445','32132','645271','644331','714872','742432','645269','640164','645272','727992','727989','727983','727980','727988','727994','727991','727986','727985','735204','727990','727573','727993','727979','739211','727981','727987','728220','764713','708732','660984','661021','661060','660997','661034','665625','669377','661031','691563','660979','661011','691570','661003','661009','660991','764003','661072','661075','665622','661012','744693','661007','725770','665621','661085','661026','679514','661020','691567','734457','660994','660972','672783','666945','661083','674011','661049','661027','661017','682319','661032','661041','660981','661061','666950','660999','717996','665630','666951','708675','665631','682313','709423','698209','661040','660985','665632','691566','682316','672788','682318','661039','661046','730798','661024','661004','676698','734439','731052','661016','661018','661019','661002','661005','660989','665633','669381','661056','661000','660988','661059','663462','661058','661006','732574','661022','661028','660996','661023','661052','665629','660974','661055','719555','672948','661079','660982','766218','661086','661067','669374','661087','665624','660976','669376','667470','661090','698210','660980','661035','758372','660970','661081','661088','682312','665623','736743','682317','660993','722902','683485','661033','666944','691565','666947','668150','755837','722901','727309','676045','711100','661066','661025','755838','717998','704908','734404','660977','661068','723582','679240','660992','661082','661053','669257','661043','711666','666948','665628','676697','661015','672787','691568','676044','661050','661013','676047','661076','712702','661048','725769','691562','673268','660983','660995','661089','716139','704909','672785','660978','691564','717217','666946','661063','672786','661042','676046','661078','704910','704911','721929','721930','714542','660975','661074','661065','719554','667953','661080','723926','691569','661051','676043','669382','666952','661077','708676','661062','661008','661047','704514','674652','649876','640320','746437','642477','677435','660743','755234','760874','759975','674519','651604','674517','667784','758515','42425','652986','660554','623876','642860','42486','42485','623875','32647','602725','612121','32651','40240','705676','32649','32654','635542','755282','698457','698512','40166','38684','32657','42565','32658','698521','32648','698519','32897','32652','32659','698513','698458','689122','688960','689121','694772','692382','689119','700395','700393','700394','689123','753800','686472','724664','657955','44116','661250','754721','737611','684537','730690','736760','759340','674531','749860','613236','716144','656672','756575','749402','720468','41873','32545','623573','744377','32441','32444','623346','684494','32390','733844','734037','665689','30281','667595','30280','661128','719570')
  and entity_id = 'TB_AE'
),



od as 
(
  select
     
    c.city_name
    ,vendor.vendor_code
    ,vendor.name as vendor_name
    ,COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) as day
    -- ,extract(hour from DATEtime(d.created_at, d.timezone)) as hour
    ,global_order_id as order_code
    ,o.order_status
    ,CASE WHEN d.is_stacked_intravendor IS FALSE OR d.is_stacked_intravendor IS NULL THEN FALSE ELSE TRUE END AS is_stacked
    
    ,d.timings.to_vendor_time/60 as tvt
    ,d.timings.to_customer_time/60 as tct
    ,d.timings.actual_delivery_time/60 as dt
    ,o.timings.promised_delivery_time/60 as pdt
    ,o.timings.rider_accepting_time / 60 AS RAT
    ,o.estimated_prep_time/60 as EPT
    ,d.timings.at_vendor_time_cleaned/60 as AVTC
    ,TIMESTAMP_DIFF(vendor_prepared_at , o.sent_to_vendor_at , MINUTE) as FIR_prep
    ,vendor_delay_v2/60 as vendor_delay
    ,o.timings.rider_late/60 as rider_late
    ,o.timings.order_delay/60 as order_delay

  from `fulfillment-dwh-production.curated_data_shared.orders` o
  left join unnest(deliveries) as d on d.is_primary
  inner join vendors v on v.vendor_code <<>> o.vendor.vendor_code
  left join `tlb-data-prod.data_platform.fct_logistics_order` e on o.platform_order_code = e.order_code
  inner join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = d.city_id
  where o.country_code = 'ae'
  and o.created_date >>= '2025-01-01'
  AND COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) >>= '2025-06-08'
  and COALESCE(DATE(d.rider_dropped_off_at, d.timezone), DATE(d.created_at, d.timezone)) << current_date
  group by all
)

select distinct
o.city_name,
o.day,
-- o.hour,
count(distinct case when order_status = 'completed' then order_code end) as orders,
-- COUNT(DISTINCT CASE WHEN is_stacked AND order_status = 'completed' THEN order_code end) AS stacked_orders,
sum(case when order_status = 'completed' then dt end) as dt,
count(distinct case when order_status = 'completed' and dt is not null then order_code end) as dt_orders,

-- sum(case when order_status = 'completed' then pdt end) as pdt,
-- count(distinct case when order_status = 'completed' and pdt is not null then order_code end) as pdt_orders,

-- sum(case when order_status = 'completed' then tvt end) as tvt,
-- count(distinct case when order_status = 'completed' and tvt is not null then order_code end) as tvt_orders,

-- sum(case when order_status = 'completed' then tct end) as tct,
-- count(distinct case when order_status = 'completed' and tct is not null then order_code end) as tct_orders,

-- sum(case when order_status = 'completed' then rat end) as rat,
-- count(distinct case when order_status = 'completed' and rat is not null then order_code end) as rat_orders,

-- sum(case when order_status = 'completed' then avtc end) as avtc,
-- count(distinct case when order_status = 'completed' and avtc is not null then order_code end) as avtc_orders,

-- sum(case when order_status = 'completed' then ept end) as ept,
-- count(distinct case when order_status = 'completed' and ept is not null then order_code end) as ept_orders,

-- sum(case when order_status = 'completed' then FIR_prep end) as FIR_prep,
-- count(distinct case when order_status = 'completed' and FIR_prep is not null then order_code end) as FIR_prep_orders,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then order_delay  end ) >> 10) THEN order_code  ELSE NULL END) as order_delay_10_num,
COUNT(DISTINCT case when order_delay is not null then  order_code end )AS order_delay_10_den,

COUNT(DISTINCT CASE WHEN (( case when order_status='completed' then vendor_delay  end ) >> 10) THEN order_code  ELSE NULL END) as vendor_delay_10_num,
COUNT(DISTINCT case when vendor_delay is not null then  order_code end )AS vendor_delay_10_den,

COUNT(DISTINCT CASE WHEN ((rider_late) >> 10) THEN order_code  ELSE NULL END) as rider_late_10_num,
COUNT(DISTINCT CASE WHEN NOT ((rider_late) IS NULL) THEN order_code  ELSE NULL END) AS rider_late_10_den,

-- COUNT(DISTINCT CASE WHEN ((( case when order_status = 'completed' then ((dt) - (pdt))
-- 						else null end ) >> -10 AND ( case when order_status = 'completed' then ((dt) - (pdt))
-- 						else null end ) << 10)) THEN order_code  ELSE NULL END) as OOT_num

from od o
group by all]]></relation>
