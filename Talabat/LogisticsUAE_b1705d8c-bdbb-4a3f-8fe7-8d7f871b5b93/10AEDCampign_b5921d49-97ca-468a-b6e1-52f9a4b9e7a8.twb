      <column caption='AVTC - Mins lost / Order' datatype='real' name='[Calculation_2362630607166550035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  ([Calculation_2362630607136780288] - AVG([Calculation_2362630607162826769])) &lt; 0 &#10;THEN 0&#10;ELSE [Calculation_2362630607136780288] - AVG([Calculation_2362630607162826769]) END' />
      </column>
      <column caption='Lost Hours - (AVTC)' datatype='real' name='[Calculation_2362630607168479252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (sum([orders]) * [Calculation_2362630607166550035]) &lt; 0 &#10;THEN 0 &#10;else sum([orders]) * [Calculation_2362630607166550035] END' />
      </column>
      <column caption='WOW - Orders' datatype='real' name='[Calculation_2362630607181205526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [orders] END))-1' />
      </column>
      <column caption='WOW - AVTC' datatype='real' name='[Calculation_2362630607181504535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(CASE [day] when TODAY()-1 THEN [avtc] END)/SUM(CASE [day] when TODAY()-1 THEN [avtc_orders] END))&#10;/&#10;(SUM(CASE [day] when TODAY()-8 THEN [avtc] END)/SUM(CASE [day] when TODAY()-8 THEN [avtc_orders] END))-1' />
