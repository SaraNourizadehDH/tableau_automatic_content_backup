      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_logistics)' name='federated.0ss0pek0wag4vx16ftu1s08u5oun' />
          </datasources>
          <datasource-dependencies datasource='federated.0ss0pek0wag4vx16ftu1s08u5oun'>
            <column caption='Country - AVTC - Mins lost / Order' datatype='real' name='[AVTC - Mins lost / Order (copy)_2362630607552659508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_2362630607136780288] - AVG([AVTC Target (copy)_2362630607552167985])) &lt; 0 &#10;THEN 0&#10;ELSE [Calculation_2362630607136780288] - AVG([AVTC Target (copy)_2362630607552167985]) END' />
            </column>
            <column caption='Country - AVTC Target' datatype='real' name='[AVTC Target (copy)_2362630607552167985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3.7' />
            </column>
            <column caption='AVTC' datatype='real' name='[Calculation_2362630607136780288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avtc])/SUM([avtc_orders])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_2362630607136874497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt])/SUM([dt_orders])' />
            </column>
            <column caption='EPT' datatype='real' name='[Calculation_2362630607137288194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ept])/SUM([ept_orders])' />
            </column>
            <column caption='FIR Prep' datatype='real' name='[Calculation_2362630607137353731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FIR_prep])/SUM([FIR_prep_orders])' />
            </column>
            <column caption='Order Delay 10 %' datatype='real' name='[Calculation_2362630607138406405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_delay_10_num])/SUM([order_delay_10_den])' />
            </column>
            <column caption='Rider Late 10 %' datatype='real' name='[Calculation_2362630607138476038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10_num])/SUM([rider_late_10_den])' />
            </column>
            <column caption='Vendor Delay 10 %' datatype='real' name='[Calculation_2362630607138603015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_10_num])/SUM([vendor_delay_10_den])' />
            </column>
            <column caption='To Vendor Time' datatype='real' name='[Calculation_2362630607138660360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tvt])/SUM([tvt_orders])' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[Calculation_2362630607138721801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tct])/SUM([tct_orders])' />
            </column>
            <column caption='PDT' datatype='real' name='[Calculation_2362630607138983946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt])/SUM([pdt_orders])' />
            </column>
            <column caption='RAT' datatype='real' name='[Calculation_2362630607139045387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rat])/SUM([rat_orders])' />
            </column>
            <column caption='VFR' datatype='real' name='[Calculation_2362630607144267788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='LFR' datatype='real' name='[Calculation_2362630607144337421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='NFR' datatype='real' name='[Calculation_2362630607144800270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='Order Share %' datatype='real' name='[Calculation_2362630607147040783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM({ FIXED [city_name], [day]: MAX([food_orders])})' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_2362630607205015590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([orders])' />
            </column>
            <column datatype='integer' name='[FIR_prep]' role='measure' type='quantitative' />
            <column datatype='integer' name='[FIR_prep_orders]' role='measure' type='quantitative' />
            <column caption='Country - Lost Hours - (AVTC)' datatype='real' name='[Lost Hours - (AVTC) (copy)_2362630607553601591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([orders]) * [AVTC - Mins lost / Order (copy)_2362630607552659508]) &lt; 0 &#10;THEN 0 &#10;else sum([orders]) * [AVTC - Mins lost / Order (copy)_2362630607552659508] END' />
            </column>
            <column caption='Country - Lost Hours - (RAT)' datatype='real' name='[Lost Hours - (RAT) (copy)_2362630607553708088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([orders]) * [RAT - Mins lost / Orders (copy)_2362630607552847925]) &lt; 0 &#10;THEN 0 &#10;else sum([orders]) * [RAT - Mins lost / Orders (copy)_2362630607552847925] END' />
            </column>
            <column caption='Country - Lost Hours - (TVT)' datatype='real' name='[Lost Hours - (TVT) (copy)_2362630607553785913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([orders]) * [TVT - Mins lost / Orders (copy)_2362630607552946230]) &lt; 0 &#10;THEN 0 &#10;else sum([orders]) * [TVT - Mins lost / Orders (copy)_2362630607552946230] END' />
            </column>
            <column caption='Country - RAT - Mins lost / Orders' datatype='real' name='[RAT - Mins lost / Orders (copy)_2362630607552847925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_2362630607139045387] - AVG([RAT Target (copy)_2362630607552368690])) &lt; 0 &#10;THEN 0&#10;ELSE [Calculation_2362630607139045387] - AVG([RAT Target (copy)_2362630607552368690]) END' />
            </column>
            <column caption='Country - RAT Target ' datatype='real' name='[RAT Target (copy)_2362630607552368690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3.5' />
            </column>
            <column caption='Country - TVT - Mins lost / Orders' datatype='real' name='[TVT - Mins lost / Orders (copy)_2362630607552946230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_2362630607138660360] - AVG([TVT Target (copy)_2362630607552483379])) &lt; 0 &#10;THEN 0&#10;ELSE [Calculation_2362630607138660360] - AVG([TVT Target (copy)_2362630607552483379]) END' />
            </column>
            <column caption='Country - TVT Target' datatype='real' name='[TVT Target (copy)_2362630607552483379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='4.6' />
            </column>
