,'636553','764601','734933','653817','27567','27568','688946','33416','663323','622808','614042','625870','27574','27572','27601','706891','673994','703982','750323','703860','679061','38980','736352','680195','643904','34025','724307','667851','36270','711696','645581','704423','668770','2894','700483','684295','684459','740339','688990','683818','661424','675620','641184','632331','632335','749840','632325','606881','624944','632328','718084','639461','668449','639436','632340','632327','668462','659733','691558','632322','623902','632326','601809','48092','747109','632323','701638','730962','694656','624946','614284','606935','694301','35450','710560','669554','35449','608441','632332','639460','703708','47038','639824','700204','636188','735559','632334','673723','719696','24016','625834','609077','716387','696699','673722','632333','617524','24009','669731','24013','632337','669393','632341','695759','632324','24014','24007','695678','24019','712547','624943','24011','24008','669813','24006','721471','48382','632336','673725','719223','741014','609078','617523','671193','614282','607244','50447','51725','43798','600897','602545','687337','657113','44126','607246','31801','50445','32132','645271','644331','714872','742432','645269','640164','645272','727992','727989','727983','727980','727988','727994','727991','727986','727985','735204','727990','727573','727993','727979','739211','727981','727987','728220','764713','708732','660984','661021','661060','660997','661034','665625','669377','661031','691563','660979','661011','691570','661003','661009','660991','764003','661072','661075','665622','661012','744693','661007','725770','665621','661085','661026','679514','661020','691567','734457','660994','660972','672783','666945','661083','674011','661049','661027','661017','682319','661032','661041','660981','661061','666950','660999','717996','665630','666951','708675','665631','682313','709423','698209','661040','660985','665632','691566','682316','672788','682318','661039','661046','730798','661024','661004','676698','734439','731052','661016','661018','661019','661002','661005','660989','665633','669381','661056','661000','660988','661059','663462','661058','661006','732574','661022','661028','660996','661023','661052','665629','660974','661055','719555','672948','661079','660982','766218','661086','661067','669374','661087','665624','660976','669376','667470','661090','698210','660980','661035','758372','660970','661081','661088','682312','665623','736743','682317','660993','722902','683485','661033','666944','691565','666947','668150','755837','722901','727309','676045','711100','661066','661025','755838','717998','704908','734404','660977','661068','723582','679240','660992','661082','661053','669257','661043','711666','666948','665628','676697','661015','672787','691568','676044','661050','661013','676047','661076','712702','661048','725769','691562','673268','660983','660995','661089','716139','704909','672785','660978','691564','717217','666946','661063','672786','661042','676046','661078','704910','704911','721929','721930','714542','660975','661074','661065','719554','667953','661080','723926','691569','661051','676043','669382','666952','661077','708676','661062','661008','661047','704514','674652','649876','640320','746437','642477','677435','660743','755234','760874','759975','674519','651604','674517','667784','758515','42425','652986','660554','623876','642860','42486','42485','623875','32647','602725','612121','32651','40240','705676','32649','32654','635542','755282','698457','698512','40166','38684','32657','42565','32658','698521','32648','698519','32897','32652','32659','698513','698458','689122','688960','689121','694772','692382','689119','700395','700393','700394','689123','753800','686472','724664','657955','44116','661250','754721','737611','684537','730690','736760','759340','674531','749860','613236','716144','656672','756575','749402','720468','41873','32545','623573','744377','32441','32444','62