          <datasource-dependencies datasource='federated.0ss0pek0wag4vx16ftu1s08u5oun'>
            <column caption='TVT Target' datatype='real' name='[AVTC Target (copy)_2362630607542206507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Dubai&quot; &#10;THEN 5.5&#10;ELSEIF [city_name] = &quot;Ajman&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Abu dhabi&quot; &#10;THEN 4.2&#10;ELSEIF [city_name] = &quot;Sharjah&quot; &#10;THEN 4&#10;ELSEIF [city_name] = &quot;Rak&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Uaq&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Fujairah&quot; &#10;THEN 2.5&#10;ELSEIF [city_name] = &quot;Al ain&quot; &#10;THEN 3.5&#10;ELSE 4.5&#10;END' />
            </column>
            <column caption='RAT Target' datatype='real' name='[AVTC Target (copy)_2362630607544803372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Dubai&quot; &#10;THEN 4&#10;ELSEIF [city_name] = &quot;Ajman&quot; &#10;THEN 2.5&#10;ELSEIF [city_name] = &quot;Abu dhabi&quot; &#10;THEN 3.8&#10;ELSEIF [city_name] = &quot;Sharjah&quot; &#10;THEN 2&#10;ELSEIF [city_name] = &quot;Rak&quot; &#10;THEN 1.5&#10;ELSEIF [city_name] = &quot;Uaq&quot; &#10;THEN 1.5&#10;ELSEIF [city_name] = &quot;Fujairah&quot; &#10;THEN 1.4&#10;ELSEIF [city_name] = &quot;Al ain&quot; &#10;THEN 2.3&#10;END' />
            </column>
            <column caption='AVTC' datatype='real' name='[Calculation_2362630607136780288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avtc])/SUM([avtc_orders])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_2362630607136874497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt])/SUM([dt_orders])' />
            </column>
            <column caption='EPT' datatype='real' name='[Calculation_2362630607137288194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ept])/SUM([ept_orders])' />
            </column>
            <column caption='FIR Prep' datatype='real' name='[Calculation_2362630607137353731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FIR_prep])/SUM([FIR_prep_orders])' />
            </column>
            <column caption='Order Delay 10 %' datatype='real' name='[Calculation_2362630607138406405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_delay_10_num])/SUM([order_delay_10_den])' />
            </column>
            <column caption='Rider Late 10 %' datatype='real' name='[Calculation_2362630607138476038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10_num])/SUM([rider_late_10_den])' />
            </column>
            <column caption='Vendor Delay 10 %' datatype='real' name='[Calculation_2362630607138603015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay_10_num])/SUM([vendor_delay_10_den])' />
            </column>
            <column caption='To Vendor Time' datatype='real' name='[Calculation_2362630607138660360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tvt])/SUM([tvt_orders])' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[Calculation_2362630607138721801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tct])/SUM([tct_orders])' />
            </column>
            <column caption='PDT' datatype='real' name='[Calculation_2362630607138983946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt])/SUM([pdt_orders])' />
            </column>
            <column caption='RAT' datatype='real' name='[Calculation_2362630607139045387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rat])/SUM([rat_orders])' />
            </column>
            <column caption='VFR' datatype='real' name='[Calculation_2362630607144267788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='LFR' datatype='real' name='[Calculation_2362630607144337421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='NFR' datatype='real' name='[Calculation_2362630607144800270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancel_orders])/SUM([total_orders])' />
            </column>
            <column caption='Order Share %' datatype='real' name='[Calculation_2362630607147040783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM({ FIXED [city_name], [day]: MAX([food_orders])})' />
            </column>
            <column caption='AVTC Target' datatype='real' name='[Calculation_2362630607162826769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [city_name] = &quot;Dubai&quot; &#10;THEN 4&#10;ELSEIF [city_name] = &quot;Ajman&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Abu dhabi&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Sharjah&quot; &#10;THEN 3.5&#10;ELSEIF [city_name] = &quot;Rak&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Uaq&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Fujairah&quot; &#10;THEN 3&#10;ELSEIF [city_name] = &quot;Al ain&quot; &#10;THEN 3.5&#10;END' />
            </column>
            <column caption='AVTC - Mins lost / Order' datatype='real' name='[Calculation_2362630607166550035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_2362630607136780288] - AVG([Calculation_2362630607162826769])) &lt; 0 &#10;THEN 0&#10;ELSE [Calculation_2362630607136780288] - AVG([Calculation_2362630607162826769]) END' />
            </column>
            <column caption='Lost Hours - (AVTC)' datatype='real' name='[Calculation_2362630607168479252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([orders]) * [Calculation_2362630607166550035]) &lt; 0 &#10;THEN 0 &#10;else sum([orders]) * [Calculation_2362630607166550035] END' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_2362630607205015590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([orders])' />
