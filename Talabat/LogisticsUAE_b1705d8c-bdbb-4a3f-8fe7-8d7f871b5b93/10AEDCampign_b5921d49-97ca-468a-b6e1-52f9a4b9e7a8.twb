      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Fail Rate' id='_6117D551B73743A49FEFC4B037B3E7C4'>
            <properties context=''>
              <relation connection='bigquery.0hj8wo60kq2znn18t6vno0fp39ta' name='Custom SQL Query1' type='text'><![CDATA[with city as 
(
  select 
    city_name,
    city_id
  from `tlb-data-prod.data_platform.dim_logistics_city`
  where country_code = 'ae'
),

zone as 
(
  select 
    zone_id,
    zone_name,
    city_id
  from `tlb-data-prod.data_platform.dim_logistics_zone`
  where country_code = 'ae'
),

fail_reason as
(
  select distinct order_fail_reason_id
    ,owner
    ,reason
    ,stage
    ,source
    ,talabat_reason
    ,reason_group
from `tlb-data-prod.data_platform.dim_order_fail_reason`
),

fct_info as 
(
  select 
    order_id
    ,o.order_fail_reason_id
    ,owner
    ,reason
    ,talabat_reason
    ,gmv_amount_lc
    ,delivery_location_id
  from `tlb-data-prod.data_platform.fct_order_info` o
  left join fail_reason f on o.order_fail_reason_id = f.order_fail_reason_id
