  <datasources>
    <datasource caption='Custom SQL Query (data_platform_logistics)' inline='true' name='federated.01z3nbw0d29d8h13mv24y0unzj7e' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04963z01vp9cxz1f9hf6d0phbml2'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform_logistics' server-oauth='server-custom' username='muhammad.sarmad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04963z01vp9cxz1f9hf6d0phbml2' name='Custom SQL Query' type='text'>SELECT&#13;
    actual_start_at_local_date as date,&#13;
    extract(hour from datetime(break_start_at, a.timezone)) as start_at_hour,&#13;
    rider_id,&#13;
    city_name,&#13;
    case when break_reason=&apos;accident&apos; then &apos;Accident&apos; &#13;
    when break_reason=&apos;break_request&apos; then &apos;Break Request&apos; &#13;
    when break_reason=&apos;health_issue&apos; then &apos;Health Issue&apos; &#13;
    when break_reason=&apos;not_reachable&apos; then &apos;Not Reachable&apos; &#13;
    when break_reason=&apos;refuses_to_deliver_after_acceptance&apos; then &apos;Refuses to deliver after Acceptance&apos; &#13;
    when break_reason=&apos;vehicle_or_equipment_or_phone_issue&apos; then &apos;Vehicle / Equipment / Phone Issue&apos; &#13;
    else break_reason&#13;
    end as break_reason,&#13;
    datetime(break_start_at, a.timezone) as start_at,&#13;
    datetime(break_end_at,a.timezone)  as end_at,&#13;
    (COALESCE ( sum ( break_duration/60  )/60  ,0)) AS actual_break_time_hrs,&#13;
    (COALESCE ( sum ( break_duration/60  )  ,0)) AS fct_logistics_rider_shift_actual_break_time_mins&#13;
&#13;
FROM  `tlb-data-prod.data_platform.fct_logistics_rider_break`  a&#13;
left join `tlb-data-prod.data_platform.dim_logistics_city` b &#13;
on  lower(a.country_code)=loweR(b.country_code)&#13;
and a.city_id=b.city_id&#13;
WHERE  actual_start_at_local_date &gt;&gt;=&apos;2024-01-01&apos; &#13;
     AND (upper(a.country_code) like case when &apos;no&apos;=&apos;yes&apos; then &apos;%&apos; else &apos;AE&apos; end)&#13;
GROUP BY&#13;
    1,2,3,4,5,6,7</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.04963z01vp9cxz1f9hf6d0phbml2' name='Custom SQL Query' type='text'>SELECT&#13;
