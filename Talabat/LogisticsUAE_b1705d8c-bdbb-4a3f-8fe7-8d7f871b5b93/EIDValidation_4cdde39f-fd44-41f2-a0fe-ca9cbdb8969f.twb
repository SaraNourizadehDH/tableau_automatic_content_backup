            <properties context=''>
              <relation connection='bigquery.1v9fcho0kybd5h152ndil0bo58yx' name='Custom SQL Query' type='text'><![CDATA[select
rider_id	
,rider_name
,last_contract_name	
,gender
,last_city_id
,city_name
,date(timestamp_add(last_contract_start_at, interval 4 hour)) as last_contract_start_at
,date(timestamp_add(last_contract_end_at, interval 4 hour)) as last_contract_end_at
,national_id_number as id_numer	
,is_active
,phone_number
,birth_date
,rider_email
from `tlb-data-prod.data_platform.dim_logistics_rider` r
left join (select city_id, city_name from `tlb-data-prod.data_platform.dim_logistics_city` where country_code = 'ae' ) c on c.city_id = r.last_city_id
where country_code = 'ae'
-- and last_contract_name <<>> 'Test'
-- and is_active]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
