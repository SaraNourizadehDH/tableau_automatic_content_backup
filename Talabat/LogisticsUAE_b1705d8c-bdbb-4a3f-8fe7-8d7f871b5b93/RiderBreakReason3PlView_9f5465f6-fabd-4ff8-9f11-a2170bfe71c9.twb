        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1v3n5tk1bhztc713yu7oy163hko4' name='Custom SQL Query' type='text'><![CDATA[with breaks as 
(
  SELECT
    a.created_date,
    break_type,
    a.rider_id,
    break_performed_by,
    break_start_at,
    break_end_at,
    case when break_reason='accident' then 'Accident' 
    when break_reason='break_request' then 'Break Request' 
    when break_reason='health_issue' then 'Health Issue' 
    when break_reason='not_reachable' then 'Not Reachable' 
    when break_reason='refuses_to_deliver_after_acceptance' then 'Refuses to deliver after Acceptance' 
    when break_reason='vehicle_or_equipment_or_phone_issue' then 'Vehicle / Equipment / Phone Issue' 
    else break_reason end as break_reason,
    break_comment,
    sum(break_duration) as break_duration,
FROM  `tlb-data-prod.data_platform.fct_logistics_rider_break`  a
WHERE  a.created_date >>='2023-12-01' 
AND upper(a.country_code) = 'AE'
GROUP BY
    1,2,3,4,5,6,7,8
),

fleet as 
(
  select rider_id
  ,rider_name
  ,last_contract_name
  ,country_code 
  from `tlb-data-prod.data_platform.dim_logistics_rider` 
  where country_code = 'ae'
),

shift as 
(
  select rider_id
  ,city_name
  ,date(actual_start_at,c.timezone) day
  ,sum(actual_working_time) as actual_working_time
  ,sum(actual_break_time) as actual_break_time
  from `tlb-data-prod.data_platform.fct_logistics_rider_shift` c 
  left join `tlb-data-prod.data_platform.dim_logistics_city` b on  lower(c.country_code)=loweR(b.country_code) and c.city_id=b.city_id
  where c.country_code = 'ae'
  and date(actual_start_at,c.timezone) >>= '2023-12-01'
  group by 1,2,3
)

-- select city_name
-- ,sum(actual_working_time) as actual_working_time
-- ,sum(actual_break_time) as actual_break_time
-- ,safe_divide(sum(actual_break_time),(sum(actual_working_time)+sum(actual_break_time))) as bk_pt
-- from 
-- (
-- select 
-- city_name
-- ,s.rider_id
-- ,max(actual_working_time) as actual_working_time
-- ,max(actual_break_time) as actual_break_time
-- -- ,safe_divide(max(actual_break_time),(max(actual_working_time)+max(actual_break_time))) as brek_pt
-- from shift as s
-- left join breaks b on s.rider_id = b.rider_id and b.created_date = s.day
-- -- left join fleet f on f.rider_id = s.rider_id
-- where day = '2024-01-30'
-- -- and s.rider_id = 1724098
-- group by 1,2

-- )
-- group by 1
-- and created_date = current_date - 2

select s.*,b.* except(rider_id),f.* except(rider_id)
from shift as s
left join breaks b on s.rider_id = b.rider_id and b.created_date = s.day
left join fleet f on f.rider_id = s.rider_id
where day << current_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
