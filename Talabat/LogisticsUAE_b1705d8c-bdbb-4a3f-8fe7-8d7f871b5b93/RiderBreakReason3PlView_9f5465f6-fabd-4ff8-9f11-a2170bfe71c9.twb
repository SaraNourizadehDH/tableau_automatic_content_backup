      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0s68rhe1aho0hn13xs3hy0djnr81].[sum:Calculation_2352779011870691328:qk]&quot;' value='Break HR' />
          <alias key='&quot;[federated.0s68rhe1aho0hn13xs3hy0djnr81].[sum:Calculation_2352779011906666497:qk]&quot;' value='Working Hours' />
        </aliases>
      </column>
      <column caption='max_actual_break_time' datatype='real' name='[Calculation_2352779011870691328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id], [day]: max([actual_break_time]/3600) }' />
      </column>
      <column caption='max_actual_working_time' datatype='real' name='[Calculation_2352779011906666497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id], [day]: max([actual_working_time]/3600) }' />
      </column>
      <column caption='Break%' datatype='real' name='[Calculation_2352779011906760706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2352779011870691328])&#10;/(SUM([Calculation_2352779011870691328]) + sum([Calculation_2352779011906666497]))' />
      </column>
      <column caption='Break duration hours' datatype='real' name='[Calculation_2352779011913351171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([break_duration]/3600)' />
      </column>
      <column caption='Default Riders' datatype='string' name='[Calculation_2352779011917094916]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2352779011906760706] &gt; [Parameters].[Parameter 1] THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Break Fixed Flag' datatype='string' name='[Calculation_2352779011921375239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [rider_id], [day]: IF [Calculation_2352779011906760706] &gt; [Parameters].[Parameter 1] THEN &apos;Yes&apos; ELSE &apos;No&apos; END }' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_2352779011928268808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([break_duration])/(sum([Calculation_2352779011906666497])+sum([Calculation_2352779011870691328]))' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_2352779011944009738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2352779011913351171]/COUNTD([rider_id])' />
      </column>
      <column caption='# RIders' datatype='integer' name='[Calculation_2352779011945717771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='WH Filter Flag' datatype='string' name='[Calculation_2352779011950862348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2352779011906666497] &gt;= [Parameters].[Parameter 2] THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Calculation3' datatype='integer' name='[Calculation_2352779011952701453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2352779011906760706] &gt;= [Parameters].[Parameter 1] AND &#10;sum([Calculation_2352779011906666497])&gt;= [Parameters].[Parameter 2] &#10;THEN [Calculation_2352779011945717771] END' />
      </column>
      <column caption='check1' datatype='integer' name='[Calculation_3345893098817617922]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, MIN([day]), MAX([day]))' />
      </column>
      <column caption='Break Count' datatype='integer' name='[Calculation_3345893098857127941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([rider_id])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_A7E994E1EE4745689F7C0141F8D05C34]' role='measure' type='quantitative' />
      <column datatype='string' name='[break_reason]' role='dimension' type='nominal' />
