        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04rgj1d1taslb91h79uww03yczee' name='Custom SQL Query' type='text'>WITH dineout_acquisitions AS (
  SELECT
    o.account_id,
    o.order_id,
    o.order_date,
    l.area_name,
    v.vendor_id,
    v.vendor_name,
    ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY o.order_time) AS rn
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  INNER JOIN `tlb-data-prod.data_platform.dim_account` a
    ON o.account_id = a.account_id
  INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
    ON o.vendor_id = v.vendor_id
  INNER JOIN `tlb-data-prod.data_platform.dim_location_info` l
    ON v.location_id = l.location_id
  WHERE o.is_successful
    AND LOWER(o.delivery_arrangement) = &apos;tdine&apos;
    AND o.country_code = &apos;AE&apos;
),

pre_post_acq AS (
  SELECT
CASE
  WHEN order_date BETWEEN DATE(&apos;2025-07-23&apos;) AND DATE(&apos;2025-08-24&apos;)
    THEN &apos;Post&apos;
  WHEN order_date BETWEEN DATE(&apos;2025-06-02&apos;) AND DATE(&apos;2025-07-22&apos;)
