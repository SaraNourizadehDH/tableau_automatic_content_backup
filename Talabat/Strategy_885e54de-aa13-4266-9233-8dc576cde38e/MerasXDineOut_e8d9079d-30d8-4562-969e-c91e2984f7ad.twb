      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9C361A9EBDEA420788122AEECECBAD89'>
            <properties context=''>
              <relation connection='bigquery.04rgj1d1taslb91h79uww03yczee' name='Custom SQL Query' type='text'>WITH dineout_acquisitions AS (
  SELECT
    o.account_id,
    o.order_id,
    o.order_date,
    l.area_name,
    v.vendor_id,
    v.vendor_name,
    ROW_NUMBER() OVER (PARTITION BY o.account_id ORDER BY o.order_time) AS rn
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  INNER JOIN `tlb-data-prod.data_platform.dim_account` a
    ON o.account_id = a.account_id
  INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
    ON o.vendor_id = v.vendor_id
  INNER JOIN `tlb-data-prod.data_platform.dim_location_info` l
    ON v.location_id = l.location_id
  WHERE o.is_successful
    AND LOWER(o.delivery_arrangement) = &apos;tdine&apos;
    AND o.country_code = &apos;AE&apos;
),

pre_post_acq AS (
  SELECT
CASE
  WHEN order_date BETWEEN DATE(&apos;2025-07-23&apos;) AND DATE(&apos;2025-08-24&apos;)
    THEN &apos;Post&apos;
  WHEN order_date BETWEEN DATE(&apos;2025-06-02&apos;) AND DATE(&apos;2025-07-22&apos;)
    AND NOT (order_date BETWEEN DATE(&apos;2025-06-13&apos;) AND DATE(&apos;2025-06-30&apos;))
    THEN &apos;Pre&apos;
END AS tag,

    order_date,
    area_name,
    case when vendor_id=(699895) then &quot;Everday Roastary&quot; else &quot;Non-Everday&quot; end as vendor_tag,
    -- vendor_name,
    -- vendor_id,
    COUNT(DISTINCT account_id) AS total_acq
  FROM dineout_acquisitions
  WHERE rn=1
  AND order_date&gt;&gt;=&quot;2025-03-28&quot;
  AND area_name IN (
        &apos;Al Wasl&apos;,
        &apos;Jumeirah Beach Residence - JBR&apos;,
        &apos;Al Safa&apos;
    )
  GROUP BY all
),

pre_post_orders AS (
  SELECT
CASE
  WHEN order_date BETWEEN DATE(&apos;2025-07-23&apos;) AND DATE(&apos;2025-08-24&apos;)
    THEN &apos;Post&apos;
  WHEN order_date BETWEEN DATE(&apos;2025-06-02&apos;) AND DATE(&apos;2025-07-22&apos;)
    AND NOT (order_date BETWEEN DATE(&apos;2025-06-13&apos;) AND DATE(&apos;2025-06-30&apos;))
    THEN &apos;Pre&apos;
END AS tag,

    order_date,
    l.area_name,
    case when o.vendor_id=(699895) then &quot;Everday Roastary&quot; else &quot;Non-Everday&quot; end as vendor_tag,
    -- v.vendor_id,
    -- v.vendor_name,
    COUNT(DISTINCT o.order_id) AS total_orders,
    COUNT(DISTINCT o.account_id) AS total_users,
    SUM(COALESCE(o.discount_amount_lc,0)) AS discount_amount_lc,
    SUM(COALESCE(o.gmv_amount_lc,0)) AS gmv_amount_lc
  FROM `tlb-data-prod.data_platform.fct_order_info` o
  INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
    ON o.vendor_id = v.vendor_id
  INNER JOIN `tlb-data-prod.data_platform.dim_location_info` l
    ON v.location_id = l.location_id
  WHERE LOWER(o.delivery_arrangement) = &apos;tdine&apos;
    AND o.order_date &gt;&gt;= DATE(&apos;2025-03-28&apos;)
    AND o.is_successful
    AND area_name IN (
        &apos;Al Wasl&apos;,
        &apos;Jumeirah Beach Residence - JBR&apos;,
        &apos;Al Safa&apos;
    )
  GROUP BY all
)

SELECT a.order_date,a.tag,a.vendor_tag,a.area_name,total_orders,total_users,discount_amount_lc,gmv_amount_lc,b.total_acq
FROM pre_post_orders as a 
left join pre_post_acq as b
on a.tag=b.tag 
and a.area_name=b.area_name  
and a.order_date=b.order_date
and a.vendor_tag=b.vendor_tag
-- and a.vendor_id=b.vendor_id
where a.tag is not null 
order by 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
