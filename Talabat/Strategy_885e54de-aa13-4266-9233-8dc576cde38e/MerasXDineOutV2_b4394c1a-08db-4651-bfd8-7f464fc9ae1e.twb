      <column-instance column='[gmv_amount_lc]' derivation='Sum' name='[sum:gmv_amount_lc:qk]' pivot='key' type='quantitative' />
      <column-instance column='[total_acq]' derivation='Sum' name='[sum:total_acq:qk]' pivot='key' type='quantitative' />
