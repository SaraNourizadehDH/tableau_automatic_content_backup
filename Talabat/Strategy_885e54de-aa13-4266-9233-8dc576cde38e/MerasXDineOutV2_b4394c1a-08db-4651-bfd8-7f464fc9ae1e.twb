      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_9C361A9EBDEA420788122AEECECBAD89]' role='measure' type='quantitative' />
      <column datatype='string' name='[area_name (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[area_name]' new-bin='true'>
          <bin default-name='true' value='&quot;Al Safa &amp; Al Wasl&quot;'>
