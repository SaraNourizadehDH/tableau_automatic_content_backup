      <column caption='week' datatype='datetime' name='[Calculation_255931168825004032]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [order_date])' />
      </column>
      <column caption='Weekly orders' datatype='integer' name='[Calculation_255931168825126913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [area_name (group)], DATETRUNC(&apos;week&apos;, [order_date]) : SUM([total_orders]) }' />
      </column>
      <column caption='Max Orders' datatype='integer' name='[Calculation_255931168830078979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [area_name (group)] : MAX({ FIXED [area_name (group)], DATETRUNC(&apos;week&apos;, [order_date]) : SUM([total_orders]) }) }' />
      </column>
      <column caption='Indexed Orders' datatype='real' name='[Calculation_255931168844943364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_255931168825126913]/[Calculation_255931168830078979]' />
      </column>
      <column caption='Indexed Users' datatype='real' name='[Indexed Orders (copy)_255931168847630341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Weekly orders (copy)_255931168847683590]/[Max Orders (copy)_255931168848003080]' />
      </column>
      <column caption='Indexed Basket' datatype='real' name='[Indexed Users (copy)_255931168848211978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Weekly Users (copy)_255931168847892487]/[Max Users (copy)_255931168848072713]' />
      </column>
      <column caption='Max Discount' datatype='real' name='[Max Basket (copy)_255931169103192075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [area_name (group)] : MAX({ FIXED [area_name (group)], DATETRUNC(&apos;week&apos;, [order_date]) : SUM([discount_amount_lc]) }) }' />
      </column>
      <column caption='Max Users' datatype='integer' name='[Max Orders (copy)_255931168848003080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [area_name (group)] : MAX({ FIXED [area_name (group)], DATETRUNC(&apos;week&apos;, [order_date]) : SUM([total_users]) }) }' />
      </column>
      <column caption='Max Basket' datatype='real' name='[Max Users (copy)_255931168848072713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [area_name (group)] : MAX({ FIXED [area_name (group)], DATETRUNC(&apos;week&apos;, [order_date]) : SUM([basket_amount_lc]) }) }' />
      </column>
      <column caption='Weekly Basket' datatype='real' name='[Weekly Users (copy)_255931168847892487]' role='measure' type='quantitative'>
