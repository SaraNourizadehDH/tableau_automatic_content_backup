          <named-connection caption='BigQuery' name='bigquery.1gfn5q90dvu56a1666vs41fmqahr'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='server-custom' username='chandrapu.reddy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gfn5q90dvu56a1666vs41fmqahr' name='Partnerships voucher data' type='text'>WITH&#13;
  campaigns AS (&#13;
  SELECT&#13;
    id,&#13;
    name,&#13;
    bin_group_id&#13;
  FROM&#13;
    `tlb-data-prod.data_platform_loyalty.voucher_options`&#13;
  WHERE&#13;
    discriminator = &apos;VOUCHER_CODE&apos;&#13;
    AND (name LIKE &apos;%B2B%&apos;&#13;
      OR bin_group_id IS NOT NULL)&#13;
    AND NOT (LOWER(name) LIKE &apos;%test%&apos;&#13;
      OR LOWER(name) LIKE &apos;%vendor%&apos;&#13;
      OR LOWER(name) LIKE &apos;%mkt%&apos;)),&#13;
  redemptions AS (&#13;
  SELECT&#13;
    foi.country_code,&#13;
    foi.order_date,&#13;
    foi.order_id,&#13;
    UPPER(vc.code) AS voucher_code,&#13;
    cv.campaign_reference_id,&#13;
    ven.vendor_name,&#13;
    vd.order_discount_lc,&#13;
    DATE_TRUNC(foi.order_date,MONTH) AS order_month,&#13;
    CASE WHEN c.bin_group_id IS NULL THEN &apos;B2B&apos; ELSE &apos;Bank&apos; END AS type&#13;
  FROM&#13;
    `tlb-data-prod.data_platform_loyalty.customer_vouchers` cv&#13;
  INNER JOIN&#13;
    `tlb-data-prod.data_platform.fct_order_info` foi&#13;
  ON&#13;
    cv.external_reference_id = CAST(foi.order_id AS string)&#13;
    AND foi.is_successful&#13;
    AND DATE_TRUNC(foi.order_date,MONTH) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)&#13;
    AND DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) --UPDATE dates&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform.dim_vendor_info` ven&#13;
  ON&#13;
    foi.vendor_id = ven.vendor_id&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform_loyalty.voucher_codes` vc&#13;
  ON&#13;
    cv.voucher_code_id = vc.id&#13;
  LEFT JOIN&#13;
    `tlb-data-prod.data_platform.dim_incentives_voucher_details` vd&#13;
  ON&#13;
    CAST(foi.order_id AS STRING) = vd.order_id&#13;
  LEFT JOIN campaigns c ON cv.voucher_option_id = c.id&#13;
  WHERE&#13;
    cv.voucher_option_id IN (&#13;
    SELECT&#13;
      DISTINCT id&#13;
    FROM&#13;
      campaigns) )&#13;
SELECT&#13;
  *&#13;
FROM&#13;
  redemptions</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
