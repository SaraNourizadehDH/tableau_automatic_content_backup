        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0i3jenk1prxzoq19p2e5w0sswn8p' name='Custom SQL Query' type='text'><![CDATA[with acquisitions as 
(
select account_id,acquisition_order_id,acquisition_order_date
from `tlb-data-prod.data_platform.agg_account_profile` ag
where acquisition_order_date>>='2025-01-01'
group by all 
)
,bank_acquisitions  as 
(
select date_trunc(acquisition_order_date,month) as acquisition_month,fi.country_iso,fi.account_id as user,fi.order_id,dic.campaign_name,mapping.partner as partner_name
from   acquisitions aq
inner join `tlb-data-prod.data_platform.fct_order_info` fi
on aq.acquisition_order_id = fi.order_id
and aq.acquisition_order_date= fi.order_date 
and fi.is_successful 

inner join `tlb-data-prod.data_platform.fct_incentives_voucher_order` fod
on fod.order_id = fi.order_id 
inner join `tlb-data-prod.data_platform.dim_incentive_campaign` dic
on dic.incentive_campaign_id = fod.incentive_campaign_id

INNER JOIN
`tlb-data-prod.data_platform_loyalty.voucher_options` vo
ON
vo.id = SPLIT(dic.temp_src_id,'-1-BIN VOUCHER')[0]
AND vo.bin_group_id IS NOT NULL
--AND dic.campaign_start_date >>= '2025-04-20' -- update date
AND NOT (LOWER(vo.name) LIKE '%test%'
      OR LOWER(vo.name) LIKE '%crm%')
LEFT JOIN
    `tlb-data-prod.data_platform_google_sheet.bin_partnership_mapping` mapping
ON
    dic.campaign_name = mapping.campaign_name
where fi.order_date>>='2025-01-01'
group by all 
)
,b2b_acquisitions as
(
select date_trunc(acquisition_order_date,month) as acquisition_month,fi.country_iso,b.incentive_type_detail,b.voucher_name,fi.account_id as user,fi.order_id 
       ,CASE
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%coop\\_eg\\_partnership\\_%' THEN SPLIT(LOWER(b.src_campaign_reference_id),"_")[3]
      WHEN LOWER(b.src_campaign_reference_id) LIKE '%\\_iq\\_%'
    AND LOWER(b.src_campaign_reference_id) LIKE '%digitalzonepartnership%' THEN 'digital zone'
      WHEN LOWER(din.campaign_reference_id) LIKE '%tlc%' THEN 'tlc'
      WHEN LOWER(din.campaign_reference_id) LIKE '%merit%' THEN 'merit incentives'
      WHEN LOWER(din.campaign_reference_id) LIKE '%ygag%' THEN 'ygag'
      WHEN LOWER(din.campaign_reference_id) LIKE '%advertisup%' THEN 'advertisup'
      WHEN LOWER(din.campaign_reference_id) LIKE '%ooredoo%' THEN 'ooredoo'
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(din.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " "), r'^[^A-Za-z]') THEN
    CASE
      WHEN REGEXP_CONTAINS(REPLACE(SPLIT(LOWER(din.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " "), r'^[^A-Za-z]') THEN REPLACE(SPLIT(LOWER(din.campaign_reference_id), "_")[SAFE_OFFSET(6)], "_", " ")
      ELSE REPLACE(SPLIT(LOWER(din.campaign_reference_id), "_")[SAFE_OFFSET(4)], "_", " ")
  END
      ELSE REPLACE(SPLIT(LOWER(din.campaign_reference_id), "_")[SAFE_OFFSET(5)], "_", " ")
  END
    AS partner_name,
from   acquisitions aq
inner join `tlb-data-prod.data_platform.fct_order_info` fi
on aq.acquisition_order_id = fi.order_id
and aq.acquisition_order_date= fi.order_date 
and fi.is_successful 
and fi.order_date>>='2025-01-01'
inner join `tlb-data-prod.data_platform.fct_incentives_voucher_order` fod
on fod.order_id = fi.order_id 
inner join `tlb-data-prod.data_platform.dim_incentives_voucher_details` din 
on din.voucher_reference_id = fod.voucher_reference_id
left join `tlb-data-prod.data_platform.dim_incentives_voucher` b 
on b.voucher_id = din.voucher_id 
where fi.order_date>>='2025-01-01'
AND ((LOWER(b.src_campaign_reference_id) LIKE "%b2b%"
        AND NOT ( b.src_campaign_reference_id IN ( 'VoucherGenericRetention_ae_partnership_B2B_100%_TIERRACAFE_231215-240615_vw_10000x25%AED_Sales_25%discount_all_one_op',
            'VoucherGenericRetention_ae_partnership_B2B_100%_Terra Mezze_231226-240331_uc_30x30AED_Sales_30AED_all_one_op',
            'VoucherGenericRetention_ae_partnership_B2B_100%_KavaandChai_231215-240531_uc_10x30AED_Sales_30AED_all_one_op',
  'coop_jo_Partnership_B2B_100%_Merit_Incentives_230407-240407_uc_20x25JOD_Full_4.5%discount_all_one_op',
'VoucherGenericRetention_ae_partnership_B2B_100%_emirates_250327-260327_uc_2398x50AED_Full_20%discount_all_one_op_old' )
          OR LOWER(b.src_campaign_reference_id) LIKE '%duplicate%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%test%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%vendor%'
          OR LOWER(b.src_campaign_reference_id) LIKE '%mkt%carc%'
          OR b.campaign_id = '61c78a5f-30d5-4a7a-b3f5-cfcc84e44d51' ))
      OR b.src_campaign_reference_id IN ( 'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x7000_all_one_bth',
        'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x10000_all_one_bth',
        'other_iq_talabat-MKT-CARC_DigitalZonePartnership_241111-251201_uc_5000x5000_all_one_bth',
        'coop_eg_Partnership_Pril100_241225-250124_vw_15000X100LE_all_one_bth',
