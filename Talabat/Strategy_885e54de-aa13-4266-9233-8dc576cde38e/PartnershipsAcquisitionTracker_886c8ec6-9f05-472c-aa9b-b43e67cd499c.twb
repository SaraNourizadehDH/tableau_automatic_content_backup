        'coop_eg_Partnership_Samsung1000_241028-241215_gn_2500X1000LE_all_one_bth',
        'coop_eg_Partnership_Samsung1000_250114-250125_gn_30X1000LE_all_one_bth5',
        'coop_eg_Partnership_Shokran100_241205-241231_vw_10000X100LE_all_one_bth',
