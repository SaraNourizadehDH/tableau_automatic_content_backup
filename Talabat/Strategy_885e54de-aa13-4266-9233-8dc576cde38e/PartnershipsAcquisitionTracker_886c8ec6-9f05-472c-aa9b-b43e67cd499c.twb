group by all 
)

,credit_vouchers as 
(

SELECT date_trunc(c.date,month) as month
       ,c.account_id 
       ,c.description as campaign_name
       ,fi.order_id
       ,fi.is_successful
       ,fi.gmv_amount_lc as gmv_amount_lc
       ,fi.gmv_amount_eur as gmv_amount_eur
       ,ap.acquisition_order_id as acq_order_id
       ,CASE
        WHEN c.description LIKE '%Al Mulla%' THEN 'Al Mulla Group'
        WHEN c.description LIKE '%Roche Second Agreement%' THEN 'Roche 2'
        WHEN c.description LIKE '%Roche\\_%' THEN 'Roche'
        WHEN (LOWER(c.description) LIKE '%nielsen%'
        AND expiry_days <<= 30) THEN 'Nielsen'
        WHEN (LOWER(c.description) LIKE '%nielsen%' AND expiry_days = 365) THEN 'Nielsen (July Agreement)'
        WHEN LOWER(c.description) LIKE '%\\_mondelez\\_%' THEN 'Mondelez'
        WHEN LOWER(c.description) LIKE '%siemens\\_%' THEN 'Siemens'
        WHEN LOWER(c.description) LIKE '%\\_sigmaegp\\_%' THEN 'Sigma'
        WHEN LOWER(c.description) LIKE '%\\_ego\\_%' THEN 'EGO'
        WHEN LOWER(c.description) LIKE '%\\_bms(egypt)\\_%' THEN 'BMS'
        WHEN LOWER(c.description) LIKE '%\\_audiomob\\_%' THEN 'AudioMob'
        WHEN LOWER(c.description) LIKE '%\\_dnatatravel\\_%' THEN 'dnata Travel'
        WHEN LOWER(c.description) LIKE '%enbd\\_%' THEN 'ENBD'
        WHEN LOWER(c.description) LIKE '%\\_ooredoo%' THEN 'Ooredoo'
        WHEN LOWER(c.description) LIKE '%\\_nbkghatawi\\_%' THEN 'NBK'
        WHEN LOWER(c.description) LIKE '%\\_abk(kuwait)\\_%' THEN 'ABK'
        WHEN (LOWER(c.description) LIKE '%\\_aub%' AND LOWER(c.description) LIKE '%new campaign%') THEN 'Ahli United Bank (New Agreement)'
        WHEN LOWER(c.description) LIKE '%\\_aub%' THEN 'Ahli United Bank'
        WHEN LOWER(c.description) LIKE '%f\\_and\\_g\\_trade%' THEN 'F&G Trade'
        WHEN LOWER(c.description) LIKE '%\\_omantelmakasib\\_%' THEN 'Omantel'
        WHEN LOWER(c.description) LIKE '%\\_fifa\\_%' THEN 'FIFA'
        WHEN LOWER(c.description) LIKE '%\\_kib\\_%' THEN 'KIB'
        WHEN LOWER(c.description) LIKE '%\\_cbk(kuwait)\\_%' THEN 'CBK'
        WHEN LOWER(c.description) LIKE '%\\_techne\\_%' THEN 'Techne Summit (KDGP)'
        WHEN LOWER(c.description) LIKE '%\\_arabiaweather\\_%' THEN 'Arabia Weather'
        WHEN LOWER(c.description) LIKE '%arammeem%' THEN 'Aram Meem'
        WHEN LOWER(c.description) LIKE '%syngenta eg%' THEN 'Syngenta'
        WHEN LOWER(c.description) LIKE '%atlas copco eg%' THEN 'Atlas Copco'
        WHEN LOWER(c.description) LIKE '%higher colleges of technology%' THEN 'HCT'
        WHEN LOWER(c.description) LIKE '%jonson controls egypt%' THEN 'Johnson Controls Egypt'
        ELSE SPLIT(c.description,"_")[1]
    END
      AS partner_name

       
FROM
    `tlb-data-prod.data_platform.fct_wallet_transaction` c
LEFT JOIN
    `tlb-data-prod.data_platform.fct_wallet_transaction_details` d
ON
     c.transaction_id = d.parent_earn_transaction_id
left join `tlb-data-prod.data_platform.fct_order_info` fi
on   fi.order_id = d.order_id 
--and  d.is_reversal is false 
and  lower(d.description) not in ('expired' ) 
--and  fi.is_successful 
left join `tlb-data-prod.data_platform.agg_account_profile` ap
on ap.account_id = fi.account_id
and ap.acquisition_order_id = fi.order_id
where lower(c.description) like '%b2b%'
and is_bulk_gift
AND c.date >>= '2025-01-01'
and  ap.acquisition_order_id is not null 
group by all
)
-- select *
-- from credit_vouchers 
-- --where partner_name is null

select date_trunc(fi.order_date,month)as order_month
        ,fi.country_iso
        ,dl.city_name
        ,case when b2b.order_id is not null or cv.order_id is not null then 'B2B'
              when bk.order_id is not null then 'Bank'
              else 'Other' end as category_name
        ,coalesce(b2b.partner_name,bk.partner_name,cv.partner_name,'non-partnership') as partner_name
        ,coalesce(b2b.voucher_name,bk.campaign_name,cv.campaign_name,'non-partnership') as campaign_name
        ,count(distinct fi.account_id) as acquisitions
        -- ,count(distinct case when b2b.order_id is not null or bk.order_id is not null or cv.order_id is not null  then fi.order_id end ) as partnership_acq
from   acquisitions aq
inner join `tlb-data-prod.data_platform.fct_order_info` fi
on aq.acquisition_order_id = fi.order_id
and aq.acquisition_order_date= fi.order_date 
and fi.is_successful 
inner join `tlb-data-prod.data_platform.dim_location_info` dl 
on dl.location_id = fi.delivery_location_id 
left join b2b_acquisitions b2b
on b2b.order_id = aq.acquisition_order_id 
left join bank_acquisitions bk
on bk.order_id = aq.acquisition_order_id 
left join credit_vouchers cv
on cv.order_id = fi.order_id 
group by all
order by 1,2






