      <column caption='trend mnoth condition' datatype='boolean' name='[Calculation_1365435138208219137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month] &gt;= Date(&apos;2023-09-01&apos;)&#10;AND &#10;[month] &lt;= DATE(&apos;2024-05-01&apos;)' />
      </column>
      <column caption='roas gmv eur' datatype='real' name='[Calculation_1365435138208698371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type] = &apos;Banner&apos; THEN [Act NCR Rev_EUR] ELSE [calc revenue_eur] END' />
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_1365435138208849924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_amount_eur]) / sum([Calculation_1365435138208698371])' />
      </column>
