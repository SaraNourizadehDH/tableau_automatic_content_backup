          </datasources>
          <datasource-dependencies datasource='federated.1mb8blk1r55avt19ff6ze1l0cv4v'>
            <column caption='% of Discounted Items (talabat)' datatype='real' name='[% of Discounted Items (Snoonu) (copy)_79657459712573443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounted_items (talabat_nfv_summary)])/SUM([item_ids (talabat_nfv_summary)])' />
            </column>
            <column caption='Chain Name' datatype='string' name='[Calculation_1028228131578183680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [match_flag]&#13;&#10;WHEN &quot;Only on Snoonu&quot; THEN [name_sn] &#13;&#10;ELSE [name_tlb] &#13;&#10;END' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_1205557365840089088]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Snoonu Shops' datatype='string' name='[Calculation_509751226306564096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [chain_id_sn] in (14059, 9079, 8140, 4540, 18806) &#13;&#10;THEN &quot;Snoonu Shops&quot;&#13;&#10;ELSE &quot;Non-Snoonu Shops&quot;&#13;&#10;END' />
            </column>
            <column caption='tlb &amp; Sn chain ids' datatype='integer' name='[Calculation_541276421153402880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [chain_id_sn]&#13;&#10;WHEN NULL THEN [chain_id_tlb] &#13;&#10;ELSE [chain_id_sn] &#13;&#10;END' />
            </column>
            <column caption='Total Chains' datatype='integer' name='[Calculation_79657459710345217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_541276421153402880])' />
            </column>
            <column caption='% of Discounted Items (Snoonu)' datatype='real' name='[Calculation_79657459711725570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounted_items])/SUM([item_ids])' />
            </column>
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column caption='Chain Account Manager' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
