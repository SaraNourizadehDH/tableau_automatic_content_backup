    <worksheet name='Account Manager - Vendor Actions'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='12'>Account Manager - Vendor Actions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sf_action_items' name='federated.1yjd4k60udgobh167kdfn1c5mnoa' />
          </datasources>
          <datasource-dependencies datasource='federated.1yjd4k60udgobh167kdfn1c5mnoa'>
            <column caption='Actionability (V) ' datatype='integer' default-format='n#,##0;-#,##0' name='[Actionability % (V) (copy)_3727643503664832513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [status_id] &lt;&gt; 0  and [status_id] &lt;&gt; 1 then [vendor_id] end)' />
            </column>
            <column caption='Actionability % (V)' datatype='real' default-format='p0%' name='[Actionability % (copy)_1193031705170309126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actionability % (V) (copy)_3727643503664832513]/ [Calculation_5509731984384397312]' />
            </column>
            <column caption='Actionability (WA) (V)' datatype='real' name='[Actionability (WA) (copy)_1108378113382195206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5509731984384397312]) * ([Actionability % (copy)_1193031705170309126]) / TOTAL(([Actionability % (copy)_1193031705170309126]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='New (V)' datatype='integer' name='[Calculation_1193031705170001922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [vendor_id], [month],[country_code]:&#10;countd(if [vendor_actioned_status] = 1 then [vendor_id] end )&#10;}' />
            </column>
            <column caption='In Progress (V)' datatype='integer' name='[Calculation_1193031705170063363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [vendor_id], [month],[country_code]:&#10;countd(if [vendor_actioned_status] = 2 then [vendor_id] end )&#10;}' />
            </column>
            <column caption='Successful (V)' datatype='integer' name='[Calculation_1193031705170161669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [vendor_actioned_status] = 4 then [vendor_id] end )' />
