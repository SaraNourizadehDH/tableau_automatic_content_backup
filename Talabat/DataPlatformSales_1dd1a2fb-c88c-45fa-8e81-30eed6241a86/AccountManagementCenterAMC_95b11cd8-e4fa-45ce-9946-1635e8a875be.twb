            <column caption='Actionability % (A)' datatype='real' default-format='p0%' name='[Actionability % (copy)_116601032845955074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actionability (V)  (copy)_116601032845815808]/ [Calculation_3383821855770775552]' />
            </column>
            <column caption='Actionability (A)  ' datatype='integer' default-format='n#,##0;-#,##0' name='[Actionability (V)  (copy)_116601032845815808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [status]!= &apos;New&apos; then id end)' />
            </column>
            <column caption='In Progress ' datatype='integer' name='[Calculation_2092203556137324546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if max([status]) = &quot;In Progress&quot; then countd(id) end' />
            </column>
            <column caption='Total Actions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3383821855770775552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id])' />
            </column>
            <column caption='Completed (A)' datatype='integer' name='[Completed (copy)_116601032855617544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Successful (copy)_5922374302344359937])&#10;+zn(([Not Successful (copy)_5922374302344224768]))&#10;+zn(([Calculation_2092203556137324546]))&#10;+zn([Expired (V)  (copy)_6064730242815184897])' />
            </column>
            <column caption='Expired (A)' datatype='integer' name='[Expired (V)  (copy)_6064730242815184897]' role='measure' type='quantitative'>
