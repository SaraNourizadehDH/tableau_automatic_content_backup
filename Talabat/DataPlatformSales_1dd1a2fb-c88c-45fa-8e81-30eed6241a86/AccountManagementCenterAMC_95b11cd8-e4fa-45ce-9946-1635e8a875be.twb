      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Conversion Funnel' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful&quot;'>
          <calculation class='tableau' formula='&quot;Successful&quot;' />
        </column>
        <column alias='Vendor Count' caption='Daily Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Count&quot;'>
          <calculation class='tableau' formula='&quot;Count&quot;' />
          <aliases>
            <alias key='&quot;Adoption&quot;' value='Vendor Adoption' />
            <alias key='&quot;Count&quot;' value='Vendor Count' />
