    <worksheet name='Hitlist x AMC Delta'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='12'>Hitlist Penetration Deltas</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sf_action_items' name='federated.1yjd4k60udgobh167kdfn1c5mnoa' />
          </datasources>
          <datasource-dependencies datasource='federated.1yjd4k60udgobh167kdfn1c5mnoa'>
            <column caption='Successful (V)' datatype='integer' name='[Calculation_1193031705170161669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [vendor_actioned_status] = 4 then [vendor_id] end )' />
            </column>
            <column caption='Vendor - Product peneration' datatype='integer' name='[Calculation_4023473704334278656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [is_successfully_actioned] and [Calculation_4023473704337391619] = [TEST Products (copy)_4023473704337965060] and [Wallet Spend Baseline (copy)_5082804788276944896] &gt;0 &#10;then [vendor_id]  end)' />
            </column>
            <column caption='Growth Product Type' datatype='string' name='[Calculation_4023473704337391619]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [type] &#10;when &apos;CPC&apos; then &apos;Ads&apos;&#10;when &apos;CPC Upsell&apos; then &apos;Ads&apos;&#10;when &apos;Deal&apos; then &apos;Ads&apos;&#10;when &apos;Joker&apos; then &apos;Ads&apos;&#10;when &apos;GEM&apos; then &apos;Ads&apos;&#10;when &apos;Banner&apos; then &apos;Ads&apos;&#10;&#10; when &apos;Co-Funded Deal&apos; then &apos;Savings&apos;&#10;when &apos;Super Saver&apos; then &apos;Savings&apos;&#10;when &apos;Loyalty Program&apos; then &apos;Savings&apos;&#10;when &apos;Tpro&apos; then &apos;Savings&apos;&#10;when &apos;Promotion&apos; then &apos;Savings&apos;&#10;when &apos;Best Seller&apos; then &apos;Savings&apos;&#10;else null&#10;end' />
            </column>
            <column caption='Successful actioned vendors no booking amount ' datatype='integer' name='[Calculation_4220717308994908169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [status] = &apos;Successful&apos; and [Wallet Spend Baseline (copy)_5082804788276944896] &lt; 0 &#10;then [vendor_id]  end)' />
            </column>
            <column caption='Delta - Hitlist vs AMC' datatype='integer' name='[Calculation_4220717308996042764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4023473704334278656]-[Calculation_1193031705170161669]' />
            </column>
            <column caption='Booked Growth Product type' datatype='string' name='[TEST Products (copy)_4023473704337965060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [product_type] &#10;when &apos;CPC&apos; then &apos;Ads&apos;&#10;when &apos;CPC Upsell&apos; then &apos;Ads&apos;&#10;when &apos;Deal Targeting&apos; then &apos;Ads&apos;&#10;when &apos;Joker&apos; then &apos;Ads&apos;&#10;when &apos;GEM&apos; then &apos;Ads&apos;&#10;when &apos;Banner&apos; then &apos;Ads&apos;&#10;&#10; when &apos;Co-Funded Deal&apos; then &apos;Savings&apos;&#10;when &apos;Super Saver&apos; then &apos;Savings&apos;&#10;when &apos;Loyalty Program&apos; then &apos;Savings&apos;&#10;when &apos;Tpro&apos; then &apos;Savings&apos;&#10;when &apos;Promotion&apos; then &apos;Savings&apos;&#10;when &apos;Best Seller&apos; then &apos;Savings&apos;&#10;else null&#10;end' />
            </column>
            <column caption='Product Value (EUR)' datatype='real' name='[Wallet Spend Baseline (copy)_5082804788276944896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [month], [country_code], [vendor_id]:&#10;max([amc_action_spend])&#10;}' />
