    <worksheet name='Growth Product by tiers (AMC)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='12'>Successful Growth Actions by Tier on AMC</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sf_action_items' name='federated.1yjd4k60udgobh167kdfn1c5mnoa' />
          </datasources>
          <datasource-dependencies datasource='federated.1yjd4k60udgobh167kdfn1c5mnoa'>
            <column caption='In Progress (V)' datatype='integer' name='[Calculation_1193031705170063363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [vendor_id], [month],[country_code]:&#10;countd(if [vendor_actioned_status] = 2 then [vendor_id] end )&#10;}' />
            </column>
            <column caption='Successful (V)' datatype='integer' name='[Calculation_1193031705170161669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [vendor_actioned_status] = 4 then [vendor_id] end )' />
            </column>
            <column caption='Not Successful (V)' datatype='integer' name='[Calculation_1193031705170391047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [vendor_id], [month],[country_code]:&#10;countd(if [vendor_actioned_status] = 3 then [vendor_id] end )&#10;}' />
            </column>
            <column caption='Completed (V)' datatype='integer' name='[Calculation_2688437896869552129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_1193031705170161669])&#10;+zn(SUM([Calculation_1193031705170391047]))&#10;+zn(SUM([Calculation_1193031705170063363]))&#10;+zn([Successful (V) (copy)_2688437896867790848])' />
            </column>
            <column caption='Successful % (V)' datatype='real' default-format='p0%' name='[Calculation_2688437896869785602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1193031705170161669]/[Calculation_2688437896869552129]' />
            </column>
            <column caption='chain_monetisation' datatype='string' name='[Calculation_3658259915278770188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [chain_monetisation_tiers] when null then &apos;Tier E&apos; else [chain_monetisation_tiers] end' />
