          <datasource-dependencies datasource='federated.1yjd4k60udgobh167kdfn1c5mnoa'>
            <column caption='Actionability % (A)' datatype='real' default-format='p0%' name='[Actionability % (copy)_116601032845955074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actionability (V)  (copy)_116601032845815808]/ [Calculation_3383821855770775552]' />
            </column>
            <column caption='Actionability (A)  ' datatype='integer' default-format='n#,##0;-#,##0' name='[Actionability (V)  (copy)_116601032845815808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [status]!= &apos;New&apos; then id end)' />
            </column>
            <column caption='Total Actions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3383821855770775552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id])' />
            </column>
            <column caption='chain_monetisation' datatype='string' name='[Calculation_3658259915278770188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [chain_monetisation_tiers] when null then &apos;Tier E&apos; else [chain_monetisation_tiers] end' />
            </column>
            <column caption='vendors' datatype='integer' name='[Calculation_5509731984384397312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Actionability %' datatype='real' default-format='p0%' name='[Calculation_5922374302344499203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([In Progress  (copy)_5922374302344429570] + [Not Successful (copy)_5922374302344224768] + [Successful (copy)_5922374302344359937]) / [Calculation_5509731984384397312]' />
