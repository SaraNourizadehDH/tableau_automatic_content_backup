    <worksheet name='TL  - Leaderboard Successful (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='12'>Team Lead - Leader Board ( Successful)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sf_action_items' name='federated.1yjd4k60udgobh167kdfn1c5mnoa' />
          </datasources>
          <datasource-dependencies datasource='federated.1yjd4k60udgobh167kdfn1c5mnoa'>
            <column caption='Actionability (A)  ' datatype='integer' default-format='n#,##0;-#,##0' name='[Actionability (V)  (copy)_116601032845815808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [status]!= &apos;New&apos; then id end)' />
            </column>
            <column caption='Successful Actionability (WA) ' datatype='real' name='[Actionability&amp; (WA) (copy)_1108378113380503556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Successful Actionability %  (A) (copy)_116601032846143492]) * ([Successful Actionability %  (copy)_116601032846053379]) / TOTAL(([Successful Actionability %  (copy)_116601032846053379]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='In Progress ' datatype='integer' name='[Calculation_2092203556137324546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if max([status]) = &quot;In Progress&quot; then countd(id) end' />
            </column>
            <column caption='Index Actionability' datatype='string' name='[Calculation_6833579132024336384]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF INDEX() &lt;= 10 THEN &apos;Include&apos; &#10;ELSE &apos;Exclude&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
