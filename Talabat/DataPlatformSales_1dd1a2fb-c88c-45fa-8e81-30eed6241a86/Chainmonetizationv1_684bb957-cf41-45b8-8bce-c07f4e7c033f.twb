      <column caption='chain wallet spend' datatype='real' name='[Calculation_676806603667832832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([discount_gmv],0) + &#10;IFNULL([pp_revenue_eur],0) +&#10;IFNULL([cpp_monthly_revenue_eur_total],0) +&#10;IFNULL([gem_commission_amount_eur],0) +&#10;IFNULL([fp_revenue_eur],0) +&#10;IFNULL([deal_target_ncr_eur],0) +&#10;IFNULL([ss_amount_eur],0) +&#10;IFNULL([tpro_savings],0) +&#10;IFNULL([commission_amount_eur],0) +&#10;IFNULL([tgo_amount_eur],0) +&#10;IFNULL([cash_fee],0) +&#10;IFNULL([card_fee],0) )' />
      </column>
      <column caption='Wallet share' datatype='real' name='[Calculation_676806603668295681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_676806603667832832] / sum([successful_gfv])' />
      </column>
      <column caption='CMGR PT 1' datatype='real' name='[Calculation_676806603668578306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [chain_name], [country_code], [no_of_active_months] &gt; 0 : IFNULL(SUM([max_month_gmv])/sum([min_month_gmv]),0)}' />
      </column>
      <column caption='CMGR' datatype='real' name='[Calculation_676806603668783107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(POWER(IFNULL(AVG([Calculation_676806603668578306]),0),IFNULL([Calculation_676806603789500423],0)))-1' />
      </column>
      <column caption='WALLET SHARE CHECK' datatype='boolean' name='[Calculation_676806603670286340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='({FIXED [chain_name],[country_code] : ([Calculation_676806603668295681])}) &gt; 0&#10;AND ({FIXED [chain_name],[country_code] : ([Calculation_676806603668295681])}) &lt; 0.5' />
      </column>
      <column caption='ACTIVE MONTH CHECK' datatype='boolean' name='[Calculation_676806603670503429]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED  [chain_name],[country_code]: SUM([no_of_active_months]) } &gt;0' />
      </column>
      <column caption='CMGR PT 2' datatype='real' name='[Calculation_676806603789500423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/ (MAX([no_of_active_months]))' />
      </column>
      <column caption='CMGR CHECK ' datatype='boolean' name='[WALLET SHARE CHECK (copy)_676806603672207366]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='({FIXED [chain_name],[country_code] ,[chain_id] : ([Calculation_676806603668783107])}) &lt; 2' />
      </column>
