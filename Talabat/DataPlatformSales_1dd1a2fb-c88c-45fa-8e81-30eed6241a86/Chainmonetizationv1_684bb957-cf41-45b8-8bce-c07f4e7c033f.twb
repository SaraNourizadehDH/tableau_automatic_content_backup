      <column caption='AOv percentile  ' datatype='real' name='[AOF  percentile   (copy)_2745506941244178437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(avg([aov]),&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_gmv_eur]) / TOTAL(SUM([successful_gmv_eur]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='gmv percentile' datatype='real' name='[Calculation_2745506941242535936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(sum([successful_gmv_eur]),&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='chains' datatype='integer' name='[Calculation_2745506941245546502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([chain_name])' />
      </column>
      <column caption='chainss' datatype='integer' name='[Calculation_2745506943020130315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [is_regional_key_account] : COUNTD([chain_name])}' />
      </column>
      <column caption='wtd score 1' datatype='real' name='[Calculation_2745506943021600780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2745506941242535936] * 50 ) + ([gmv percentile (copy)_2745506941243645953] * 30) + ([reorder rate  percentile  (copy)_2745506941244010500]  * 20)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median Adrev share %' datatype='real' name='[Calculation_2745506943425036302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='median([adrev_median]) / MEDIAN([gfv_median])' />
      </column>
      <column caption='wallet spend' datatype='real' name='[Calculation_2745506943425200143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([adrev],0) + &#10;IFNULL([tpro_savings_eur],0) +&#10;IFNULL( [total_commisison_revenue],0) +&#10;IFNULL( [card_fee_eur],0) +&#10;IFNULL( [cash_fee_eur],0) + &#10;IFNULL([discount_gmv],0) )' />
      </column>
      <column caption='chain wallet share %' datatype='real' name='[Calculation_2745506943425466384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2745506943425200143]) / sum([gfv])' />
      </column>
      <column caption='Median VFD share %' datatype='real' name='[Calculation_2745506943425675281]' role='measure' type='quantitative'>
