    <worksheet name='tier summary'>
      <repository-location derived-from='http://ip-172-31-0-83:8556/t/Talabat/workbooks/Chainmonetizationv1/tiersummary?rev=' id='tiersummary' path='/t/Talabat/workbooks/Chainmonetizationv1' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Chain monetization' name='federated.1aquprc1itixle16fu9ez0wm8osk' />
          </datasources>
          <datasource-dependencies datasource='federated.1aquprc1itixle16fu9ez0wm8osk'>
            <column caption='chains' datatype='integer' name='[Calculation_2745506941245546502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_name])' />
            </column>
            <column caption='Median Adrev share %' datatype='real' name='[Calculation_2745506943425036302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='median([adrev_median]) / MEDIAN([gfv_median])' />
            </column>
            <column caption='wallet spend' datatype='real' name='[Calculation_2745506943425200143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([adrev],0) + &#10;IFNULL([tpro_savings_eur],0) +&#10;IFNULL( [total_commisison_revenue],0) +&#10;IFNULL( [card_fee_eur],0) +&#10;IFNULL( [cash_fee_eur],0) + &#10;IFNULL([discount_gmv],0) )' />
            </column>
            <column caption='chain wallet share %' datatype='real' name='[Calculation_2745506943425466384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2745506943425200143]) / sum([gfv])' />
            </column>
            <column caption='Median VFD share %' datatype='real' name='[Calculation_2745506943425675281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([discount_gmv_median]) / sum([gfv_median])' />
            </column>
            <column caption='Median commission rate' datatype='real' name='[Calculation_2745506943425818642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([commission_rev_median]) / MEDIAN([gfv_median])' />
            </column>
            <column caption='Median TPRO cost share %' datatype='real' name='[Calculation_2745506943426048019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([tpro_median]) / median([gfv_median])' />
            </column>
            <column caption='Median cash and card fee' datatype='real' name='[Calculation_2745506943426232340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MEDIAN([cash_fee_eur_median]) + MEDIAN([card_fee_eur_medain])) / MEDIAN([gfv_median])' />
            </column>
            <column caption='orders by chain' datatype='real' name='[Calculation_2745506943472656406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [chain_name] : sum([successful_order_count])}' />
            </column>
            <column caption='active chain?' datatype='boolean' name='[Calculation_2745506943472988183]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2745506943472656406] &gt;= 1' />
            </column>
            <column caption='Reorder customer %' datatype='real' name='[Calculation_2745506943590162456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reorder_customers]) / sum([customers])' />
            </column>
            <column caption='AOF' datatype='real' name='[Calculation_2745506943590510617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count])/SUM([customers])' />
            </column>
            <column caption='Delivery types' datatype='string' name='[Calculation_2745506944864100387]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [country_code], [chain_name]: if  sum(IFNULL([tgo_orders],0)) &gt; 0 and sum(IFNULL([tmp_orders],0)) = 0 THEN  &quot;TGO&quot; &#10;ELSEIF sum(IFNULL([tgo_orders],0)) = 0 and sum(IFNULL([tmp_orders],0)) &gt; 0 THEN  &quot;TMP&quot; &#10;ELSEIF sum(IFNULL([tgo_orders],0)) &gt; sum(IFNULL([tmp_orders],0)) THEN  &quot;Hybrid TGO&quot; &#10;ELSEIF sum(IFNULL([tgo_orders],0)) &lt; sum(IFNULL([tmp_orders],0)) THEN  &quot;Hybrid TMP&quot; &#10;else &quot;others&quot; end }' />
            </column>
            <column datatype='real' name='[adrev]' role='measure' type='quantitative' />
            <column datatype='real' name='[adrev_median]' role='measure' type='quantitative' />
            <column datatype='real' name='[card_fee_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[card_fee_eur_medain]' role='measure' type='quantitative' />
            <column datatype='real' name='[cash_fee_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[cash_fee_eur_median]' role='measure' type='quantitative' />
            <column caption='KPP flag' datatype='string' name='[chain_kpp_flag]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Chain tier' datatype='string' name='[chain_segments_reorder]' role='dimension' type='nominal' />
            <column datatype='real' name='[commission_rev_median]' role='measure' type='quantitative' />
            <column caption='country code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_gmv_median]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv_median]' role='measure' type='quantitative' />
            <column caption='is key account?' datatype='boolean' name='[is_regional_key_account]' role='dimension' type='nominal' />
