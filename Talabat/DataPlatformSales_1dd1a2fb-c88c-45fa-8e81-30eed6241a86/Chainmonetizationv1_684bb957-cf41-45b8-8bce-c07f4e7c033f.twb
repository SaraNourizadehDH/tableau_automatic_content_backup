    <worksheet name='chain wallet share x chains x gmv'>
      <repository-location derived-from='http://ip-172-31-0-83:8556/t/Talabat/workbooks/Chainmonetizationv1/chainwalletsharexchainsxgmv?rev=' id='chainwalletsharexchainsxgmv' path='/t/Talabat/workbooks/Chainmonetizationv1' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Chain monetization' name='federated.1aquprc1itixle16fu9ez0wm8osk' />
          </datasources>
          <datasource-dependencies datasource='federated.1aquprc1itixle16fu9ez0wm8osk'>
            <column caption='chains' datatype='integer' name='[Calculation_2745506941245546502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_name])' />
            </column>
            <column caption='wallet spend' datatype='real' name='[Calculation_2745506943425200143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([adrev],0) + &#10;IFNULL([tpro_savings_eur],0) +&#10;IFNULL( [total_commisison_revenue],0) +&#10;IFNULL( [card_fee_eur],0) +&#10;IFNULL( [cash_fee_eur],0) + &#10;IFNULL([discount_gmv],0) )' />
            </column>
            <column caption='orders by chain' datatype='real' name='[Calculation_2745506943472656406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [chain_name] : sum([successful_order_count])}' />
            </column>
            <column caption='active chain?' datatype='boolean' name='[Calculation_2745506943472988183]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2745506943472656406] &gt;= 1' />
            </column>
            <column caption='chain wallet share' datatype='real' name='[Calculation_2745506943752806428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [chain_name], [country_code] : (([Calculation_2745506943425200143]) / sum([gfv]))}' />
            </column>
            <column caption='Delivery types' datatype='string' name='[Calculation_2745506944864100387]' role='dimension' type='nominal'>
