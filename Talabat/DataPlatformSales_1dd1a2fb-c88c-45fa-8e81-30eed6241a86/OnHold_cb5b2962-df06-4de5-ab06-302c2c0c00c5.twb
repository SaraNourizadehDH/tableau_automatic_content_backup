      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='1' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:on_hold_reason__c:nk]' palette='color_blind_10_0' type='palette'>
            <map to='#1170aa'>
              <bucket>&quot;Asset Not Active/Updated&quot;</bucket>
            </map>
            <map to='#57606c'>
              <bucket>&quot;Pending Integration&quot;</bucket>
            </map>
            <map to='#5fa2ce'>
              <bucket>&quot;Self-Onboarding Failure&quot;</bucket>
            </map>
            <map to='#7b848f'>
              <bucket>&quot;Unreachable&quot;</bucket>
            </map>
            <map to='#a3acb9'>
              <bucket>&quot;Menu Issue&quot;</bucket>
            </map>
            <map to='#c85200'>
              <bucket>&quot;Technical Issue&quot;</bucket>
            </map>
            <map to='#fc7d0b'>
              <bucket>&quot;Call Back Requested&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_269255894139427F8936BB616AC394C5'>
            <properties context=''>
              <relation connection='bigquery.0zuae430gkpw4e15do0981hg1nfn' name='Custom SQL Query' type='text'>WITH
  agg AS (
  SELECT
    -- grid__c,
    -- COUNT(DISTINCT casenumber)
    c.global_entity_id,
    c.id,
    c.opportunity__c,
    o.type opportunity_type,
    o.business_type__c AS opportunity_business_type,
    o.vertical__c,
    c.grid__c,
    c.type case_type,
    u.name current_case_owner_name,
    casenumber,
  IF
    (u.name IS NULL, TRUE,FALSE) is_ownership_needed,
    MAX(c.isclosed) is_case_closed,
    c.status,
    c.on_hold_reason__c,
    MIN(case_created_at)case_created_at,
    MIN(c.createddate) first_case_created_at,
    MIN(h.case_onhold_at)onhold_status_created_at,
    MAX(due_date__c) due_date,
    current_timestamp current_timestamp,
    COUNT(DISTINCT c.casenumber) total_onboarding_cases,
    COUNT(DISTINCT
      CASE
        WHEN c.on_hold_reason__c IS NOT NULL THEN on_hold_reason__c
    END
      ) total_on_hold_reasons,
      
    TIMESTAMP_DIFF(MIN(h.case_onhold_at),MAX(c.createddate), hour) lead_time_to_onhold_in_hours,
    TIMESTAMP_DIFF(current_timestamp,MIN(h.case_onhold_at), hour) onhold_status_duration_in_hours,
    TIMESTAMP_DIFF(current_timestamp,MIN(h.case_created_at), hour) onboarding_case_duration_in_hours
  FROM
    `fulfillment-dwh-production.curated_data_shared_salesforce.case` c
  LEFT JOIN (
    SELECT
      -- caseid,
      -- MIN(createddate) onhold_status_created_at
      caseid,
      MIN(CASE
          WHEN field = &apos;created&apos; THEN createddate
      END
        ) case_created_at,
      MIN(CASE
          WHEN field = &apos;Status&apos; AND newvalue = &apos;On Hold&apos; THEN createddate
      END
        ) case_onhold_at,
      MIN(CASE
          WHEN field = &apos;Status&apos; AND newvalue = &apos;Closed&apos; THEN createddate
      END
        ) case_closed_at
    FROM
      `fulfillment-dwh-production.curated_data_shared_salesforce.case_history`
    GROUP BY
      ALL) h
  ON
    h.caseid = c.id
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
  ON
    c.ownerid = u.id
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON
    c.opportunity__c = o.id
  WHERE
    TRUE
    AND c.partition_date &gt;&gt;=&apos;2025-01-01&apos;
    AND c.global_entity_id != &apos;TB_SA&apos;
    AND c.type =&apos;Onboarding&apos;
  GROUP BY
    ALL )
SELECT
  *
FROM
  agg
WHERE
  TRUE
  AND agg.is_case_closed IS NOT TRUE
  AND status = &apos;On Hold&apos;
  -- AND casenumber = &apos;338491358&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
