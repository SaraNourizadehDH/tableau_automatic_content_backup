  ON
    c.opportunity__c = o.id
  WHERE
    TRUE
    AND c.partition_date &gt;&gt;=&apos;2025-01-01&apos;
    AND c.global_entity_id != &apos;TB_SA&apos;
    AND c.type =&apos;Onboarding&apos;
  GROUP BY
    ALL )
SELECT
  *
FROM
  agg
WHERE
  TRUE
  AND agg.is_case_closed IS NOT TRUE
  AND status = &apos;On Hold&apos;
