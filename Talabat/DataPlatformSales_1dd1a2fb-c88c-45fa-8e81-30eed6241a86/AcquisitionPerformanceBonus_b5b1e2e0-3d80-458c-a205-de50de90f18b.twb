type as meeting_type,
subject as subject ,
("2010-01-01") as event_date,
" " as lost_reason__c,
0 as lead_Age__c,
kitchens_tag,
" " as opp_business_type,
competitor__c,
right_competitor_flag,
name as vendor_name,
