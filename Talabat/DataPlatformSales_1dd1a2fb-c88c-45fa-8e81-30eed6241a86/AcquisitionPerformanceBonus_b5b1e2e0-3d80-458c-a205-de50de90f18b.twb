    <worksheet name='REGIONAL'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Funnel tracker' name='federated.1iz4blh190en3218f0zuw0pr6946' />
          </datasources>
          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Live date' datatype='date' name='[Calculation_1131810937084305415]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
            </column>
            <column caption='Total Meetings MTD' datatype='integer' name='[Calculation_132504359031689216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;  IF [tag] = &quot;Meetings&quot; &#10;     AND LOWER([meeting_type]) = &quot;meeting&quot; &#10;     AND DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;  THEN 1 &#10;  END, &#10;0&#10;)' />
            </column>
            <column caption='ALL LEADS ' datatype='string' name='[Calculation_3392969753872642050]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;leads&quot; and LOWER([status]) IN  (&quot;new&quot;,&quot;open&quot;, &quot;contacted&quot;,&quot;long-term follow-up&quot;) then id else null end' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Meeting Yesterday Color' datatype='string' name='[Calculation_576671872609837060]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_6347682949580562432]) &gt;= MIN([Calculation_6347682949583847425]) then &quot;Target Met&quot; &#10;ELSE &quot;Below Target&quot;&#10;END' />
            </column>
            <column caption='Meetings Yesterday' datatype='integer' default-format='n0;-0' name='[Calculation_6347682949580562432]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL(&#10;  IF LOWER([tag]) = &quot;meetings&quot; &#10;     AND LOWER([meeting_type]) = &quot;meeting&quot; &#10;    AND DATE([date]) = DATEADD(&apos;day&apos;, -1, TODAY())&#10;  THEN 1 &#10;  END, &#10;0&#10;)' />
            </column>
            <column aggregation='Sum' caption='Target Meetings Yesterday' datatype='integer' name='[Calculation_6347682949583847425]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='Target Meetings MTD' datatype='real' name='[Calculation_6347682949584109570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 60' />
            </column>
            <column aggregation='Sum' caption='Target Live Vendors Yesterday' datatype='integer' name='[Calculation_6347682949584330755]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Target Live Vendors MTD' datatype='real' name='[Calculation_6347682949584424964]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 25' />
            </column>
            <column caption='All not approached yet' datatype='integer' name='[Calculation_6347682950616190986]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_3392969753872642050])+[Calculation_6467520917815873578]' />
            </column>
            <column caption='Potential closures' datatype='integer' name='[Calculation_6414392512306712577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Feedback Received (copy)_1532772054259945488])+ COUNTD([Quality Check Request (copy)_1532772054260138001])+COUNTD([Please Check (copy)_1532772054260305938])+ COUNTD([Promo and Logistics Queue (copy)_1532772054260518932])&#10;+ COUNTD([Editorial Queue (copy)_1532772054260674581])+ COUNTD([Delivery Pending (copy)_1532772054260920342])+COUNTD([Onboarding (copy)_1532772054261051415]))' />
            </column>
            <column caption='New + Open acc' datatype='integer' name='[Calculation_6467520917815873578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Contact Established (copy)_1532772054139199497])+ COUNTD([Quote sent (copy)_1532772054140547083])' />
            </column>
            <column caption='Vendors taken live yesterday' datatype='string' name='[Calls logged yesterday (copy)_844284200646664194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1131810937084305415] = date([yesterday])  then [Open accounts status  (copy)_1131810937083924486] else null end' />
            </column>
            <column caption='New acc' datatype='string' name='[Contact Established (copy)_1532772054139199497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) in ( &quot;new&quot;,&quot;open&quot;) then id else null end' />
            </column>
            <column caption='Onboarding' datatype='string' name='[Delivery Pending (copy)_1532772054260920342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;onboarding&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Delivery Pending' datatype='string' name='[Editorial Queue (copy)_1532772054260674581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;delivery pending&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Quality Check Request' datatype='string' name='[Feedback Received (copy)_1532772054259945488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;quality check request&quot;)  and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Onboarding Failed' datatype='string' name='[Onboarding (copy)_1532772054261051415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;onboarding failed&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Live vendors' datatype='string' name='[Open accounts status  (copy)_1131810937083924486]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;Live&quot; and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) then  [id] else  null end' />
            </column>
            <column caption='Promo and Logistics Queue' datatype='string' name='[Please Check (copy)_1532772054260305938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;promo and logistics queue&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Editorial Queue' datatype='string' name='[Promo and Logistics Queue (copy)_1532772054260518932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;editorial queue&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Please Check' datatype='string' name='[Quality Check Request (copy)_1532772054260138001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;please check&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Open  acc' datatype='string' name='[Quote sent (copy)_1532772054140547083]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = &quot;open&quot; then id else null end' />
            </column>
            <column caption='Vendors taken live MTD ' datatype='string' name='[Vendors taken live yesterday (copy)_844284200646950915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_1131810937084305415]) = DATETRUNC(&apos;month&apos;,TODAY()) then [Open accounts status  (copy)_1131810937083924486] else null end' />
            </column>
