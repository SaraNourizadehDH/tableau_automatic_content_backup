          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='AB Live vendors' datatype='integer' name='[AB Vendors taken live (copy)_3136968291837247491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTd([Live vendors (copy)_2824882908778078210])' />
            </column>
            <column caption='C Live vendors   (copy)' datatype='string' name='[C Live vendors   (copy)_3136968291837575172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;Live&quot; and lower([vendor_grade__c]) in (&quot;c&quot;)  and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) then [id] else  null end' />
            </column>
            <column caption='C Live vendors' datatype='integer' name='[C Vendors taken live  (copy)_3136968291837624325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([C Live vendors   (copy)_3136968291837575172])' />
            </column>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Live date' datatype='date' name='[Calculation_1131810937084305415]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
            </column>
            <column caption='Target' datatype='integer' name='[Calculation_1532772054261772315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='25' />
            </column>
            <column caption='Achievement' datatype='real' name='[Calculation_1532772054261964828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Open accounts status  (copy)_1131810937083924486]) / max([Calculation_1532772054261772315])' />
            </column>
            <column caption='cpc_vendors' datatype='integer' name='[Calculation_3136968291814842368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [tag]= &quot;Live&quot; and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;)  and  (IFNULL([ncr_eur_excl],0) =0  and IFNULL([cpc_budget_eur],0) &gt; 0 )then [salesforce_id] end)' />
            </column>
            <column caption='DT vendors' datatype='integer' name='[Calculation_3136968291814985729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if tag = &quot;Live&quot; and (IFNULL([ncr_eur_excl],0) &gt;0 and IFNULL([cpc_budget_eur],0) =0 ) then [salesforce_id] end)' />
            </column>
            <column caption='vendors on cpc and dt' datatype='integer' name='[Calculation_3136968291815116802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD (if  [tag]= &quot;Live&quot; and  IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) and (IFNULL([ncr_eur_excl],0) &gt;0 and  IFNULL([cpc_budget_eur],0) &gt;0  ) then [salesforce_id] end)' />
            </column>
            <column caption='Potential closures' datatype='integer' name='[Calculation_6414392512306712577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Feedback Received (copy)_1532772054259945488])+ COUNTD([Quality Check Request (copy)_1532772054260138001])+COUNTD([Please Check (copy)_1532772054260305938])+ COUNTD([Promo and Logistics Queue (copy)_1532772054260518932])&#10;+ COUNTD([Editorial Queue (copy)_1532772054260674581])+ COUNTD([Delivery Pending (copy)_1532772054260920342])+COUNTD([Onboarding (copy)_1532772054261051415]))' />
