            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.18yjm090w2erea13jqkli0j9qfey'>
            <column caption='# Vendors (copy)' datatype='integer' name='[# Vendors (copy)_4508384756118876160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='C Acquisition ' datatype='integer' name='[A + B Acquisition (copy)_6912532891441647624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( case [vendor_grade] when &apos;C&apos; then [vendor_id]&#10;&#10;else null&#10;end)' />
            </column>
            <column caption='C Productivity ' datatype='real' name='[A + B Productivity (copy)_1290070233886617601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[A + B Acquisition (copy)_6912532891441647624]/[Calculation_717690866559967235]' />
            </column>
            <column caption='Unique meetings' datatype='real' name='[Calculation_3632012400362909698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(([federated.1kavuji1l3uoxx19q8sb71nmzgid].[vendors])) / [Calculation_717690866559967235]' />
