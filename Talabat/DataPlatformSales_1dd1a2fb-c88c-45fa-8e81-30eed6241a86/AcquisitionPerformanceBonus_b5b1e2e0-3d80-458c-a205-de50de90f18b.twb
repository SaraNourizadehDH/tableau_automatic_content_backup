            <column caption='JO Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368336388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='QA Target Fill Rate' datatype='integer' name='[Calculation_6467520917368721413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='OM Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368774662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='5' />
