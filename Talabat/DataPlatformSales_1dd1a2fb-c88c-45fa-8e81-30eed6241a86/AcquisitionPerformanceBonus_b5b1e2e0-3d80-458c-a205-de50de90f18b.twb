            </column>
            <column caption='TARGET ACQ' datatype='integer' name='[Calculation_6467520917455474715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country_code] = &quot;ae&quot; then [Calculation_6467520917454647314]&#10;ELSEIF [country_code] = &quot;bh&quot; then [Calculation_6467520917454979096]&#10;ELSEIF [country_code] = &quot;eg&quot; then [Calculation_6467520917454733331]&#10;ELSEIF [country_code] = &quot;iq&quot; then [Calculation_6467520917455011865]&#10;ELSEIF [country_code] = &quot;jo&quot; then [Calculation_6467520917454848021]&#10;ELSEIF [country_code] = &quot;kw&quot; then [Calculation_6467520917454802964]&#10;ELSEIF [country_code] = &quot;om&quot; then [Calculation_6467520917454946327]&#10;ELSEIF [country_code] = &quot;qa&quot; then [Calculation_6467520917454888982]&#10;END' />
            </column>
            <column caption='Delta TAM vs Acq' datatype='integer' name='[Calculation_6467520917698183196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6467520917455073306]-[Calculation_6467520917455474715]' />
