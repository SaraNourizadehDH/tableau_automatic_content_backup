            <column caption='MTD Target Telesales' datatype='real' name='[Calculation_2357493682256711682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 405' />
            </column>
