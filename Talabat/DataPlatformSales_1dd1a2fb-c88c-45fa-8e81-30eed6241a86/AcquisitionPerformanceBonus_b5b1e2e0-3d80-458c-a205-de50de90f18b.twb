            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Meeting logged ' datatype='string' name='[Calls logged (copy)_1532772054135484419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([meeting_type]) = &quot;meeting&quot; and lower([subject]) = &quot;meeting&quot;  then id else null end' />
