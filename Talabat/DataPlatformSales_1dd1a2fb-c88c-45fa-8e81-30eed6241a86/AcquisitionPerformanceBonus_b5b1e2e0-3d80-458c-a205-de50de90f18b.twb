competitor__c,
right_competitor_flag,
a.vendor_name,
0 as cpc_budget_eur,
0 as cpc_nb_budget_clicks,
0 as cpc_revenue_eur_adjusted_excl,
0 as campaigns,
0 as ncr_eur_excl,
0 as ncr_lc_excl,
("2010-01-01") as opp_hist_date,
date(current_date) as last_updated_date,
date_sub(current_date, interval 1 day) as yesterday

 from 
 admin a 
 ) a

left join `tlb-data-prod.data_platform_google_sheet.sales_executives`  lE on  lower(lE.owner_name) =  loweR(a.opportunity_owner_name) 
and date_trunc(date,month) = date_trunc(a.yesterday,month)
