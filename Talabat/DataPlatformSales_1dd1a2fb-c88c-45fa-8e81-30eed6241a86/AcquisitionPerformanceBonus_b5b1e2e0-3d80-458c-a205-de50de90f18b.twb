            </column>
            <column caption='Acquisition Progress AE' datatype='real' name='[Calculation_734931178693894152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Open accounts status  (copy)_1131810937083924486])/[Calculation_6347682950678908940]' />
            </column>
            <column caption='MTD Target Regional' datatype='real' name='[Calculation_734931178982015006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 1475' />
