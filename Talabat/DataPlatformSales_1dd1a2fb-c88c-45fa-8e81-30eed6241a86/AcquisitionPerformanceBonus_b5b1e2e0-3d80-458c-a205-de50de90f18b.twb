0 as campaigns,
0 as ncr_eur_excl,
0 as ncr_lc_excl,
("2010-01-01") as opp_hist_date,
date(current_date) as last_updated_date,
date_sub(current_date, interval 1 day) as yesterday




from
  events a 
)


union all 


select 

a.country_code,
" " as city,
ownerid,
accountid as id,
"Live" as tag,
account_status__c as status,
date(first_online_date) as Date,
title,
