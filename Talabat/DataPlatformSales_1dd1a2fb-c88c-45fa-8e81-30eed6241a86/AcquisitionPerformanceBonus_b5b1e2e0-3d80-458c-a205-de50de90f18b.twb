      <table>
        <view>
          <datasources>
            <datasource caption='Funnel tracker' name='federated.1iz4blh190en3218f0zuw0pr6946' />
          </datasources>
          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Backlog leads  All Time  ' datatype='integer' name='[Backlog All Time  (copy)_1465147634163417090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [tag] = &quot;leads&quot;&#10;        and [status] in (&quot;Contacted&quot;,&quot;Long-term follow-up&quot;,&quot;New&quot;,&quot;Open&quot;)&#10;        AND DATETRUNC(&apos;month&apos;, [Calculation_6414392512427786243]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;    THEN [id]&#10;    END&#10;)' />
            </column>
            <column caption='Backlog accounts  All Time   ' datatype='integer' name='[Backlog leads  All Time   (copy)_1465147634164641795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [tag] = &quot;accounts&quot;&#10;        and [Open leads status (copy)_1131810937066827777] = &quot;Open accounts&quot;&#10;        AND DATETRUNC(&apos;month&apos;, [Calculation_6414392512428232708]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;    THEN [id]&#10;    END&#10;)' />
            </column>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='New leads (this month)' datatype='integer' name='[Calculation_1465147634081902592]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(if [tag] in (&quot;leads&quot;,&quot;accounts&quot;) &#10;and [status] in (&quot;Contacted&quot;,&quot;Long-term follow-up&quot;,&quot;New&quot;,&quot;Open&quot;)  &#10;and DATETRUNC(&apos;month&apos;,[Calculation_6414392512427786243]) = DATETRUNC(&apos;month&apos;,TODAY())&#10;then id  else null end)' />
            </column>
            <column caption='Backlog Universe' datatype='integer' name='[Calculation_1465147634165903364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([Backlog leads  All Time   (copy)_1465147634164641795],0) + ifnull([Backlog All Time  (copy)_1465147634163417090],0)' />
            </column>
            <column caption='Current Open Pipeline' datatype='integer' name='[Calculation_6347682949662904327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1465147634165903364]+[Calculation_1465147634081902592]' />
