      </column>
      <column caption='Registration Fee Achievement   ' datatype='real' default-format='p0.00%' name='[Productivity Achievement   (copy)_4630333751572836364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if &#10;&#10;SUM([registration_fee_lc]) &lt; sum([Reg Fee Month Target (copy)_4630333751573385229]) &#10;&#10;then 0&#10;&#10;ELSE&#10;&#10;SUM([registration_fee_lc]) / sum([Calculation_4630333751238291458] )&#10;&#10;end' />
      </column>
      <column caption='Reg Fee Min Target ' datatype='real' name='[Reg Fee Month Target (copy)_4630333751573385229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [AM], [date_month]: SUM([Registration_fee_min_threshold]) * sum([Calculation_4630333751238119425])}' />
      </column>
      <column caption='Registration Fee (EUR) Achievement     (copy)' datatype='real' default-format='p0.00%' name='[Registration Fee (EUR) Achievement     (copy)_999728766994116620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if &#10;&#10;SUM([registration_fee_eur]) &lt; SUM([Calculation_999728766986326025]) &#10;&#10;then 0&#10;&#10;ELSE&#10;&#10;SUM([registration_fee_eur]) / SUM([Calculation_999728766986326025])&#10;&#10;end' />
      </column>
      <column caption='Registration Fee (EUR) Achievement    ' datatype='real' default-format='p0.00%' name='[Registration Fee Achievement    (copy)_999728766988394507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([registration_fee_eur]) / SUM([Calculation_999728766986326025])' />
      </column>
      <column caption='Manager Validation ' datatype='boolean' name='[TL Validation (copy)_4149363386533588992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if AM = [manager_name] &#10;and lower([Title (Custom SQL Query1)]) = &apos;manager&apos;&#10;then true else false end' />
