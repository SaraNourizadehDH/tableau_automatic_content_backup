          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Live date' datatype='date' name='[Calculation_1131810937084305415]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
            </column>
            <column caption='MTD Target AE' datatype='real' name='[Calculation_576671872601870337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 300' />
            </column>
            <column caption='MTD Progress AE' datatype='real' name='[Calculation_576671872602632194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Vendors taken live yesterday (copy)_844284200646950915])/MIN([Calculation_576671872601870337])' />
            </column>
            <column caption='Acquisition Progress BH' datatype='real' default-format='e0.00e+00' name='[Calculation_6347682950679367693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Open accounts status  (copy)_1131810937083924486])/[Calculation_734931178689171459]' />
            </column>
            <column caption='Target Acquisitions BH' datatype='integer' name='[Calculation_734931178689171459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3*25' />
            </column>
            <column caption='MTD Target BH' datatype='real' name='[Calculation_734931178706493456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DAY(DATEADD(&apos;day&apos;, -1, TODAY())) / 30) * 75' />
            </column>
            <column caption='MTD Progress BH' datatype='real' name='[Calculation_734931178706767890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Vendors taken live yesterday (copy)_844284200646950915])/MIN([Calculation_734931178706493456])' />
            </column>
            <column caption='Live vendors' datatype='string' name='[Open accounts status  (copy)_1131810937083924486]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;Live&quot; and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) then  [id] else  null end' />
            </column>
            <column caption='Vendors taken live MTD ' datatype='string' name='[Vendors taken live yesterday (copy)_844284200646950915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Calculation_1131810937084305415]) = DATETRUNC(&apos;month&apos;,TODAY()) then [Open accounts status  (copy)_1131810937083924486] else null end' />
