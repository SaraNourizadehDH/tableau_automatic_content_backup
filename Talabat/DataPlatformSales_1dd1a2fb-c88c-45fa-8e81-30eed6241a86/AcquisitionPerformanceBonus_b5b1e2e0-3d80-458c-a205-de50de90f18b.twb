              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Total meetings' datatype='integer' name='[Calculation_558516745196265472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull((if tag = &quot;Meetings&quot; and lower([meeting_type]) = &quot;meeting&quot;  then 1 else null end),0))' />
            </column>
            <column caption='Follow up meetings' datatype='integer' name='[Calculation_558516745199898626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [tag] = &quot;Meetings&quot; and [subject] = &quot;Follow up&quot; then [Calculation_558516745196265472] end' />
            </column>
            <column caption='New Meeting' datatype='integer' name='[Follow up meetings (copy)_558516745200050179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [tag] = &quot;Meetings&quot; and [subject]  = (&quot;New Meeting&quot;) then [Calculation_558516745196265472] end' />
            </column>
            <column caption='Vendor dineout flag  - dont use' datatype='boolean' name='[Lead and accounts dineout flag  (copy)_3707729141230116867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_dineout] = &quot;true&quot; then true&#10;else false end' />
            </column>
            <column caption='Meetings' datatype='integer' name='[New Meeting (copy)_558516745200758788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [tag] = &quot;Meetings&quot; and [subject] in (&quot;Meeting&quot;,&quot;meeting&quot;) then [Calculation_558516745196265472] end' />
            </column>
            <column aggregation='CountD' caption='Total vendors met ' datatype='string' default-role='measure' default-type='quantitative' name='[Total meetings (copy)_558516745201102853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((if tag = &quot;Meetings&quot; and lower([meeting_type]) = &quot;meeting&quot;  and DATETRUNC(&apos;month&apos;,date)  = DATETRUNC(&apos;month&apos;,TODAY())then [salesforce_id] else null end))' />
            </column>
            <column aggregation='CountD' caption='Total vendors met  ' datatype='string' default-role='measure' default-type='quantitative' name='[Total vendors met  (copy)_597501051783806979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((if tag = &quot;Meetings&quot; and lower([meeting_type]) = &quot;meeting&quot;  then [salesforce_id] else null end))' />
            </column>
            <column datatype='string' name='[competitor__c]' role='dimension' type='nominal' />
