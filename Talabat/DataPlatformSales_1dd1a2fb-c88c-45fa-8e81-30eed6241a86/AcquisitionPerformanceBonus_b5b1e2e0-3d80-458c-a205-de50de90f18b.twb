            <column caption='Total leads + accounts' datatype='integer' name='[total (copy)_1532772054134624256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1131810937068638210])+COUNTD([Open leads (copy)_1131810937070358532])' />
