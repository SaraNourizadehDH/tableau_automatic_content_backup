            <column caption='Acquisition Progress Regional' datatype='real' name='[Calculation_2159476036116021250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Open accounts status  (copy)_1131810937083924486])/[Calculation_2159476036115664897]' />
            </column>
            <column caption='Target Acquisitions AE ' datatype='integer' name='[Calculation_6347682950678908940]' role='measure' type='quantitative'>
