            <column caption='Live date' datatype='date' name='[Calculation_1131810937084305415]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
            </column>
            <column caption='MTD Progress Regional' datatype='real' name='[Calculation_2159476036115279872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Vendors taken live yesterday (copy)_844284200646950915])/MIN([Calculation_734931178982015006])' />
            </column>
            <column caption='Target Acquisitions Regional' datatype='integer' name='[Calculation_2159476036115664897]' role='measure' type='quantitative'>
