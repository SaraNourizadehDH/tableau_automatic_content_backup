          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='mtd agents' datatype='string' name='[Calculation_3580080237722284032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([validated_agent]) = 1 then [opportunity_owner_name] else null end' />
            </column>
            <column caption='AE Target Fill Rate' datatype='integer' name='[Calculation_6467520917365944320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='12' />
            </column>
            <column caption='BH Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368139777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='EG Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368238082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='15' />
            </column>
            <column caption='KW Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368291331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='4' />
            </column>
            <column caption='JO Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368336388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='QA Target Fill Rate' datatype='integer' name='[Calculation_6467520917368721413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='OM Target Fill Rate ' datatype='integer' name='[Calculation_6467520917368774662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='IQ Target Fill Rate' datatype='integer' name='[Calculation_6467520917368836103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='12' />
            </column>
            <column caption='Fill Rate ' datatype='integer' name='[Calculation_6467520917426921481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country_code] = &quot;ae&quot; then [Calculation_6467520917365944320]&#10;ELSEIF [country_code] = &quot;bh&quot; then [Calculation_6467520917368139777]&#10;ELSEIF [country_code] = &quot;eg&quot; then [Calculation_6467520917368238082]&#10;ELSEIF [country_code] = &quot;iq&quot; then [Calculation_6467520917368836103]&#10;ELSEIF [country_code] = &quot;jo&quot; then [Calculation_6467520917368336388]&#10;ELSEIF [country_code] = &quot;kw&quot; then [Calculation_6467520917368291331]&#10;ELSEIF [country_code] = &quot;om&quot; then [Calculation_6467520917368774662]&#10;ELSEIF [country_code] = &quot;qa&quot; then [Calculation_6467520917368721413]&#10;END' />
            </column>
            <column caption='Delta Fill Rate' datatype='integer' name='[Calculation_6467520917709525029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min([Calculation_6467520917426921481]) - COUNTD([opportunity_owner_name])' />
