    <worksheet name='Account List View'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Account List</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Funnel tracker' name='federated.1iz4blh190en3218f0zuw0pr6946' />
          </datasources>
          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] = &apos;Inside Sales Executive&apos;  then &apos;Tele Sales&apos;&#10;elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Days in the stage' datatype='integer' name='[Calculation_1083397195490721792]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[opp_hist_date],TODAY())' />
            </column>
            <column caption='Open leads status' datatype='string' name='[Calculation_1131810937066078208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;leads&quot; and LOWER([status]) in (&quot;contacted&quot;,&quot;long-term follow-up&quot;,&quot;new&quot;,&quot;open&quot;)  then &quot;Open leads&quot; else null end' />
            </column>
            <column caption='Open leads' datatype='string' name='[Calculation_1131810937068638210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1131810937066078208] = &quot;Open leads&quot; then [id] else null end' />
            </column>
            <column caption='Has Open lead or accounts?' datatype='boolean' name='[Calculation_1131810937105211401]' role='measure' type='nominal'>
              <calculation class='tableau' formula='([total (copy)_1532772054134624256]) &gt; 0' />
            </column>
            <column caption='Days since creation (account)' datatype='integer' name='[Calculation_3392969753901039619]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, DATE([Calculation_6414392512428232708]), TODAY())' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Account created date' datatype='date' default-format='*m/d/yyyy' name='[Calculation_6414392512428232708]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column caption='Open accounts' datatype='string' name='[Open leads (copy)_1131810937070358532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [tag] = &quot;accounts&quot; and [Open leads status (copy)_1131810937066827777] = &quot;Open accounts&quot; then [id] else null end' />
            </column>
            <column caption='Open accounts status ' datatype='string' name='[Open leads status (copy)_1131810937066827777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and [status] = &quot;Win Back failed&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Terminated&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Lost&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Active&quot; then &quot;Other&quot;&#10;else &quot;Open accounts&quot; end' />
            </column>
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[competitor__c]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
