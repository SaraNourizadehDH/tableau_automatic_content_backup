        </aliases>
      </column>
      <column caption='Wallet share %  ' datatype='real' name='[AD  revenue %  (copy)_645351775510528006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;IFNULL([gem_commission_amount_eur],0) + &#10;IFNULL([kw_revenue_eur],0)+ &#10;IFNULL([pp_revenue_eur],0) +  &#10;IFNULL([fp_revenue_eur],0) + &#10;IFNULL([cpp_monthly_revenue_eur_total],0) + &#10;IFNULL([ss_amount_eur],0) + &#10;IFNULL([dt_rev_eur_with_discount],0)+&#10;IFNULL([discount_gmv],0)+&#10;IFNULL([commission_amount_eur],0)+&#10;IFNULL([tgo_amount_eur],0) +&#10;IFNULL([card_fee],0) +&#10;IFNULL([cash_fee],0) +&#10;IFNULL([tpro_savings],0)&#10;)&#10; / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='Commission revenue %' datatype='real' name='[Calculation_645351775508033536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IFNULL([commission_amount_eur],0)) + sum(IFNULL([tgo_amount_eur],0)))  / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='chain wallet spend' datatype='real' name='[Calculation_676806603667832832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([discount_gmv],0) + &#10;IFNULL([pp_revenue_eur],0) +&#10;IFNULL([cpp_monthly_revenue_eur_total],0) +&#10;IFNULL([gem_commission_amount_eur],0) +&#10;IFNULL([fp_revenue_eur],0) +&#10;IFNULL([deal_target_ncr_eur],0) +&#10;IFNULL([ss_amount_eur],0) +&#10;IFNULL([tpro_savings],0) +&#10;IFNULL([commission_amount_eur],0) +&#10;IFNULL([tgo_amount_eur],0) +&#10;IFNULL([cash_fee],0) +&#10;IFNULL([card_fee],0) )' />
      </column>
      <column caption='Wallet share' datatype='real' name='[Calculation_676806603668295681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_676806603667832832] / sum([successful_gfv])' />
      </column>
      <column caption='CMGR PT 1' datatype='real' name='[Calculation_676806603668578306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [chain_name], [country_code], [no_of_active_months] &gt; 0 : IFNULL(SUM([max_month_gmv])/sum([min_month_gmv]),0)}' />
      </column>
      <column caption='CMGR' datatype='real' name='[Calculation_676806603668783107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(POWER(IFNULL(AVG([Calculation_676806603668578306]),0),IFNULL([Calculation_676806603789500423],0)))-1' />
      </column>
      <column caption='WALLET SHARE CHECK' datatype='boolean' name='[Calculation_676806603670286340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='({FIXED [chain_name],[country_code] : ([Calculation_676806603668295681])}) &gt; 0&#10;AND ({FIXED [chain_name],[country_code] : ([Calculation_676806603668295681])}) &lt; 0.5' />
      </column>
      <column caption='ACTIVE MONTH CHECK' datatype='boolean' name='[Calculation_676806603670503429]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED  [chain_name],[country_code]: SUM([no_of_active_months]) } &gt;0' />
      </column>
      <column caption='CMGR PT 2' datatype='real' name='[Calculation_676806603789500423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/ (MAX([no_of_active_months]))' />
      </column>
      <column caption='Card and cash fee % ' datatype='real' name='[Commission revenue % (copy)_645351775508570113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IFNULL([card_fee],0)) + sum(IFNULL([cash_fee],0)))  / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='Untargeted Discounts %' datatype='real' name='[Commission revenue % (copy)_645351775508672514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IFNULL([discount_gmv],0)) - sum(IFNULL([targeted_deals_discounts],0)))  / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='Targeted Discounts %' datatype='real' name='[Commission revenue % (copy)_645351775508828163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IFNULL([targeted_deals_discounts],0))) / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='AD  revenue % ' datatype='real' name='[Commission revenue % (copy)_645351775508930564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;IFNULL([gem_commission_amount_eur],0) + &#10;IFNULL([kw_revenue_eur],0)+ &#10;IFNULL([pp_revenue_eur],0) +  &#10;IFNULL([fp_revenue_eur],0) + &#10;IFNULL([cpp_monthly_revenue_eur_total],0) + &#10;IFNULL([ss_amount_eur],0) + &#10;IFNULL([dt_rev_eur_with_discount],0) )&#10; / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
      <column caption='Tpro cost % ' datatype='real' name='[Commission revenue % (copy)_645351775509417989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IFNULL([tpro_savings],0)))  / &#10;sum(IFNULL([successful_gfv],0))' />
      </column>
