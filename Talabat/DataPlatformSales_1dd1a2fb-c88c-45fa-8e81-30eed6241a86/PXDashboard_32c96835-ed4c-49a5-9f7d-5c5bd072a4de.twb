              <zone fixed-size='502' forceUpdate='true' h='63750' id='629' is-fixed='true' type-v2='text' w='74291' x='22200' y='11826'>
                <formatted-text>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--Vendor contacts:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> Total number of contacts generated by the vendor from all available channels</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--Vendor Contact Rate:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> All contacts initiated by the vendor divided by gross orders.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--SLA metric (TBC, on speed):</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> # Chats served within 30 seconds / Total vendor Chats.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--vSAT:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> vSAT score with 4 or 5 / Total vSAT.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--Coldstart Vendor:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> A new vendor who hasn&apos;t completed at least 30 orders in the first 30 days after onboarding.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--Food customer sessions:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> All customer food sessions on the app.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>--VHC sessions:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> All vendor sessions on Talabat Vendor Help Center.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
