      <column caption='dateoverdate' datatype='string' name='[Calculation_1204150015156928512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;month&quot; then &quot;MoM&quot; &#10;elseif [Parameters].[Parameter 1]=&quot;week&quot; then &quot;WoW&quot;&#10;ELSE  &quot;DoD&quot; end' />
      </column>
      <column caption='measure' datatype='real' name='[Calculation_2052726701186531330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;contacts&quot; then SUM([number_of_contacts])&#10;ELSEIF [Parameters].[Parameter 2]=&quot;vsat&quot; then [Calculation_5708523697647984642]*100&#10;ELSEIF [Parameters].[Parameter 2]=&quot;customer sessions&quot; then AVG([Calculation_6248744547381370883])&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Contact Rate%&quot; then ([Calculation_5708523697647747072])*100&#10;ELSEIF [Parameters].[Parameter 2]=&apos;SLA&apos; then [Calculation_5708523697647865857]*100&#10;ELSEIF [Parameters].[Parameter 2]=&apos;coldstart&apos; then sum([Calculation_6248744547380703233])/sum([Calculation_6248744547380092928])&#10;ELSE AVG([Calculation_6248744547381542916]) END' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_2052726701191254019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if first()=0 then 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Contact Rate %' datatype='real' default-format='p0.00%' name='[Calculation_5708523697647747072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_of_contacts])/SUM([gross_order_count])' />
      </column>
      <column caption='SLA' datatype='real' name='[Calculation_5708523697647865857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(frt30)/sum([number_of_chats])' />
      </column>
      <column caption='VSAT' datatype='real' name='[Calculation_5708523697647984642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([csat_4]+[csat_5])/sum([csat_responses])' />
      </column>
      <column caption='coldstart_den_month' datatype='integer' name='[Calculation_6248744547380092928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed month([date]):max([coldstart_den])}' />
