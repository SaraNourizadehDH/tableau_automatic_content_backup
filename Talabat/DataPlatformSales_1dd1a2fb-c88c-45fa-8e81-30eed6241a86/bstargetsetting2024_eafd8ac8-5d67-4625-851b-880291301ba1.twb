    <worksheet name='gmv share vs target'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (data_platform)' name='federated.19zfmj91oepbdr19n6egf19ydu6w' />
          </datasources>
          <datasource-dependencies datasource='federated.19zfmj91oepbdr19n6egf19ydu6w'>
            <column caption='GMV Bestsellers (eur)' datatype='real' name='[BS GMV (copy)_137641321803534343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_amount_eur (Custom SQL Query1)])' />
            </column>
            <column caption='CAC eur' datatype='real' name='[CAC LC (copy)_137641321803939849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_amount_eur])/sum([vendor_acquisition_customers])' />
            </column>
            <column caption='Order share' datatype='real' name='[Calculation_1006836050169434115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_no_of_orders (Custom SQL Query4)])/sum([total_no_of_orders (Custom SQL Query4)])' />
            </column>
            <column caption='GMV food LC (wow)' datatype='real' name='[Calculation_1140536668018073600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [week],[country_iso]:sum([Calculation_802766693530427392])}' />
            </column>
            <column caption='Total orders wow' datatype='integer' name='[Calculation_1140536668019163138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [week],[country_iso]:sum([order_count])}' />
            </column>
            <column caption='BS GMV' datatype='real' name='[Calculation_137641320690515970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_amount_lc (Custom SQL Query1)])' />
            </column>
            <column caption='GMV Share' datatype='real' default-format='p0.0%' name='[Calculation_137641320690814979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_amount_eur (Custom SQL Query1)])/sum([gmv_amount_eur])' />
            </column>
            <column caption='Good Retention %' datatype='real' name='[Calculation_137641320737996804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD(if [returning_month_vendor] = 1 and [campaign_duration_segment] = &apos;1-2 weeks&apos;&#13;&#10;then vendor_id end)/COUNTD(if [returning_month_vendor] = 1&#13;&#10;then vendor_id end)) * [Calculation_1425952296849100801]' />
            </column>
            <column caption='CAC LC' datatype='real' name='[Calculation_137641320759644165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_amount_lc])/sum([vendor_acquisition_customers])' />
            </column>
            <column caption='% TLB funded vendors' datatype='real' default-format='p0.0%' name='[Calculation_137641321806409738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tlb_funded_vendors])/sum([total_no_of_vendors])' />
            </column>
            <column caption='% Discount TLB funded' datatype='real' default-format='p0.0%' name='[Calculation_137641321808572427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tlb_pay_amount_eur])/sum([incentive_amount_eur])' />
            </column>
            <column caption='Retention (%) ' datatype='real' default-format='p0.0%' name='[Calculation_1425952296849100801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [returning_month_vendor] = 1&#13;&#10;then vendor_id end)/sum([total_no_of_vendors])' />
            </column>
            <column caption='GMV Share (WoW)' datatype='real' name='[Calculation_1709116118466838529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_amount_lc (Custom SQL Query4)])/sum([Calculation_1140536668018073600])' />
            </column>
            <column caption='Vs Target' datatype='real' name='[Calculation_1792432671880192002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([GMV Share (copy 2)_374080264324378630] - AVG([Target]))/AVG([Target])' />
            </column>
            <column caption='GMV food LC (WoW)' datatype='real' name='[Calculation_802766693530427392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [week],[country_iso]: SUM([gmv_amount_lc])}' />
            </column>
            <column caption='Order Share (WoW)' datatype='real' default-format='p0.0%' name='[GMV Share (WoW) (copy)_1709116118477959170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/sum([Calculation_1140536668019163138])' />
            </column>
            <column caption='GMV Share (copy 2)' datatype='real' default-format='p0.0%' name='[GMV Share (copy 2)_374080264324378630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_amount_eur (Custom SQL Query1)])/sum([Total GMV LC (country level)  (copy)_374080264308658179])' />
            </column>
            <column caption='GMV food eur (WoW)' datatype='real' name='[GMV food LC (WoW) (copy)_802766693532139521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [week],[country_iso]: SUM([gmv_amount_eur])}' />
            </column>
            <column caption='Good Retention WoW %' datatype='real' default-format='p0.0%' name='[Good Retention % (copy)_1709116118481825795]' role='measure' type='quantitative'>
