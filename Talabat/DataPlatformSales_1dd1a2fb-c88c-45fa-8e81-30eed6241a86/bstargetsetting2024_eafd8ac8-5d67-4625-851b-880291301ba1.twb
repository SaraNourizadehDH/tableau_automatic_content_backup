      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Total GMV' id='_18570AC544994B92AFD0196A82453436'>
            <properties context=''>
              <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query' type='text'>select &#13;
sum(gmv_amount_eur) gmv_amount_eur&#13;
,sum(gmv_amount_lc) gmv_amount_lc&#13;
,count(order_id) order_count&#13;
,date_trunc(order_date,month) month&#13;
,vendor_id&#13;
,country_iso&#13;
from `tlb-data-prod.data_platform.fct_order_info`&#13;
where is_successful = true &#13;
and NOT is_non_food&#13;
and date_trunc(order_date,month) &gt;&gt;= &apos;2023-08-01&apos;&#13;
and country_iso NOT in (&apos;SA&apos;,&apos;KW&apos;)&#13;
group by 4,5,6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_18570AC544994B92AFD0196A82453436' table='[Extract].[_18570AC544994B92AFD0196A82453436]' type='table' />
            </properties>
          </object>
          <object caption='Dim_vendors_AMs' id='_715E5CE92E9F42A28C430602F5DB930F'>
            <properties context=''>
              <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query3' type='text'>with t1 as (select  &#13;
TRIM(month_date) as converted_date&#13;
,country_code&#13;
,AM&#13;
,Team_Lead &#13;
from tlb-data-prod.data_platform_google_sheet.account_manager_target&#13;
where month_date is NOT null and NOT&#13;
(month_date IS NULL OR TRIM(month_date) = &apos;&apos;))&#13;
&#13;
,t2 as (select &#13;
date_trunc(date(converted_date),month) month&#13;
,country_code&#13;
,AM&#13;
,Team_Lead &#13;
from t1)&#13;
 &#13;
&#13;
select vendor_id&#13;
,a.chain_id&#13;
,chain_name as chain_name_en&#13;
,vendor_name&#13;
,a.account_manager_name&#13;
,t2.country_code as country_iso&#13;
,is_dh_kitchen&#13;
,month&#13;
,AM&#13;
,Team_Lead&#13;
from `tlb-data-prod.data_platform.dim_vendor_info` a&#13;
left join `tlb-data-prod.data_platform.dim_chain` b&#13;
using (chain_id)&#13;
left join t2&#13;
on a.account_manager_name = t2.AM&#13;
where NOT a.is_non_food&#13;
and a.is_active = true</relation>
            </properties>
            <properties context='extract'>
              <relation name='_715E5CE92E9F42A28C430602F5DB930F' table='[Extract].[_715E5CE92E9F42A28C430602F5DB930F]' type='table' />
            </properties>
          </object>
          <object caption='Bestsellers month' id='_8306F4F4E7FA4B4AB4C78FA9E420AE80'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Custom SQL Query1].[vendor_id]' />
                      <expression op='[Custom SQL Query9].[vendor_id]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Custom SQL Query1].[month]' />
                      <expression op='[Custom SQL Query9].[month]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='[Custom SQL Query1].[country_iso]' />
                        <expression op='[Custom SQL Query7].[Country_iso]' />
                      </expression>
                      <expression op='='>
                        <expression op='[Custom SQL Query1].[month]' />
                        <expression op='[Custom SQL Query7].[Month]' />
                      </expression>
                    </expression>
                  </clause>
                  <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query1' type='text'><![CDATA[with t1 as (select 
country_iso
,a.vendor_id
,platform_cost_share
,platform_cost_share/100 * a.incentive_amount_lc AS tlb_pay_amount_lc
,platform_cost_share/100 * a.incentive_amount_eur AS tlb_pay_amount_eur
,date_trunc(a.order_date,month) month
,a.incentive_amount_lc
,a.incentive_amount_eur
,a.gmv_amount_lc
,a.gmv_amount_eur
,a.order_id
,campaign_name
,campaign_id
,a.order_date
,a.is_successful
,is_non_food
,a.analytical_customer_id
,customer_vendor_order_index
,campaign_start_date
,campaign_end_date
,date_diff(date(campaign_end_date),date(campaign_start_date),day) as campaign_duration
,case when platform_cost_share <<>> 0 then 1 else 0 end no_of_tlb_funded_vendors
,case when platform_cost_share = 0 then 1 else 0 end no_of_vfd_vendors
from `tlb-data-prod.data_platform.fct_incentive_order_detail` a
left join `tlb-data-prod.data_platform.fct_order_info` b 
using (order_id) 
left join `tlb-data-prod.data_platform.fct_order_rank` c 
on a.order_id = c.order_id
where (lower(campaign_name) like '%best seller%' 
OR lower(campaign_name) like '%bestseller%'
OR lower(campaign_name) like '%30% off on selected items%'
OR lower(campaign_name) like '%Orange Friday-50% off selected Items%'
OR lower(campaign_name) like '%orange friday%')
and a.order_date >>= '2023-08-01'
and country_iso not in ('SA','KW'))

,t2 as (select 
gmv_amount_eur
,gmv_amount_lc
,order_id
,vendor_id 
,order_date
,country_iso
from `tlb-data-prod.data_platform.fct_order_info`
where order_id IN (select
order_id from `tlb-data-prod.data_platform.fct_incentive_order_detail`
where (lower(campaign_name) like '%best seller%' 
OR lower(campaign_name) like '%bestseller%'
OR lower(campaign_name) like '30% off selected items'
OR lower(campaign_name) like '%30% off on selected items%'
OR lower(campaign_name) like '%Orange Friday-50% off selected Items%'
OR lower(campaign_name) like '%orange friday%'))
and order_date >>= '2023-08-01'
and is_successful = true 
and NOT is_non_food) 

select t1.country_iso
,t1.vendor_id
,date_trunc(t1.order_date,month) month
,count(distinct t1.vendor_id) total_no_of_vendors
,count(distinct order_id) total_no_of_orders
,sum(incentive_amount_lc) incentive_amount_lc
,sum(incentive_amount_eur) incentive_amount_eur
,sum(t2.gmv_amount_lc) gmv_amount_lc
,sum(t2.gmv_amount_eur) gmv_amount_eur
,sum(tlb_pay_amount_lc) tlb_pay_amount_lc
,sum(tlb_pay_amount_eur) tlb_pay_amount_eur
,sum(incentive_amount_lc) - sum(tlb_pay_amount_lc) AS vendor_pay_amount_lc
,sum(incentive_amount_eur) - sum(tlb_pay_amount_eur) AS vendor_pay_amount_eur
,case when platform_cost_share <<>> 0 then count(distinct t1.vendor_id) end AS tlb_funded_vendors
,case when platform_cost_share = 0 then count(distinct t1.vendor_id) end AS funded_vendors
,COUNT(DISTINCT CASE WHEN is_successful  THEN CASE WHEN  customer_vendor_order_index   = 1 THEN  analytical_customer_id   END  ELSE NULL END) AS vendor_acquisition_customers
,COUNT(DISTINCT CASE WHEN is_successful  THEN CASE WHEN  customer_vendor_order_index   >> 1 THEN  analytical_customer_id   END  ELSE NULL END) AS vendor_returning_customers
,avg(campaign_duration) avg_campaign_duration
from t1
left join t2 using (order_id)
where t1.order_date >>= '2023-08-01'
and NOT is_non_food
and is_successful = true 
and cast(campaign_id as string) in (
  select campaign_id
  from `tlb-data-prod.data_platform.dim_incentive_campaign_detail`
  where (lower(campaign_name) like '%best seller%' 
OR lower(campaign_name) like '%bestseller%'
OR lower(campaign_name) like '%30% off on selected items%'
OR lower(campaign_name) like '30% off selected items'
OR lower(campaign_name) like '%Orange Friday-50% off selected Items%'
OR lower(campaign_name) like '%orange friday%' )
)
group by 1,2,3,platform_cost_share

union all 

select * from tlb-data-dev.data_playground_partner_growth.mcdonalds_bs_month]]></relation>
                  <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query7' type='text'>SELECT * FROM `tlb-data-dev.data_playground_partner_growth.bestsellers_country_targets`</relation>
                </relation>
                <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query9' type='text'>with t1 as (select  &#13;
TRIM(month_date) as converted_date&#13;
,country_code&#13;
,AM&#13;
,Team_Lead &#13;
from tlb-data-prod.data_platform_google_sheet.account_manager_target&#13;
where month_date is NOT null and NOT&#13;
(month_date IS NULL OR TRIM(month_date) = &apos;&apos;))&#13;
&#13;
,t2 as (select &#13;
date_trunc(date(converted_date),month) month&#13;
,country_code&#13;
,AM&#13;
,Team_Lead &#13;
from t1)&#13;
 &#13;
select vendor_id&#13;
,b.chain_id&#13;
,chain_name as chain_name_en&#13;
,vendor_name&#13;
,b.account_manager_name&#13;
,t2.country_code as country_iso&#13;
,is_dh_kitchen&#13;
,month&#13;
,AM&#13;
,Team_Lead&#13;
from `tlb-data-prod.data_platform.dim_vendor_info` a&#13;
left join `tlb-data-prod.data_platform.dim_chain` b&#13;
using (chain_id)&#13;
left join t2&#13;
on a.account_manager_name = t2.AM&#13;
where NOT a.is_non_food&#13;
and a.is_active = true</relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='_8306F4F4E7FA4B4AB4C78FA9E420AE80' table='[Extract].[_8306F4F4E7FA4B4AB4C78FA9E420AE80]' type='table' />
            </properties>
          </object>
          <object caption='vendor segmentation' id='_A36F06E5D8FB4C9B940535085567F786'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Custom SQL Query4].[vendor_id]' />
                      <expression op='[Custom SQL Query8].[vendor_id]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Custom SQL Query4].[country_iso]' />
                      <expression op='[Custom SQL Query8].[country_code]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query4' type='text'><![CDATA[with t1 as (select 
a.country_iso
, vendor_id
, sum(gmv_amount_eur) gmv_amount_eur
, rank () over (partition by a.country_iso order by sum(gmv_amount_eur) desc) as rank
, case when rank () over (partition by a.country_iso order by sum(gmv_amount_eur) desc) <<= 100 then 'yes'
else 'no' end Top100
from `tlb-data-prod.data_platform.fct_order_info` a 
where is_successful = true 
and NOT a.is_non_food
and order_date >>= date_add(current_date(), INTERVAL -3 MONTH)
group by 1,2)

,t2 as (select 
a.country_iso
, a.vendor_id
, name_en
, count(order_id)/3 avg_order_month
, b.rating_display
, case when count(order_id)/3 >>= 80 and b.rating_display >>=4 then 'A' 
when count(order_id)/3 >>= 80 and b.rating_display <<4 then 'B'
when count(order_id)/3 << 80 and b.rating_display >>= 4 then 'C'
when count(order_id)/3 << 80 and b.rating_display << 4 then 'D' end vendor_segmentation
from `tlb-data-prod.data_platform.fct_order_info` a 
left join `tlb-data-prod.data_platform.dim_vendor` b 
using (vendor_id)
where is_successful = true 
and NOT a.is_non_food
and order_date >>= date_add(current_date(), INTERVAL -3 MONTH)
group by 1,2,3,5)

select t1.country_iso
,vendor_id
,name_en
,Top100
,vendor_segmentation
from t1 
join t2
using (vendor_id)]]></relation>
                <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query8' type='text'>select &#13;
distinct&#13;
t2.country_code as country_code&#13;
,account_manager_name&#13;
,city_name&#13;
,area_name&#13;
,vendor_id&#13;
&#13;
from `tlb-data-prod.data_platform.dim_vendor_info` t1&#13;
left join `tlb-data-prod.data_platform.dim_location_info` t2&#13;
  on t1.location_id = t2.location_id&#13;
&#13;
where account_manager_name is not null&#13;
and country_Code NOT IN (&apos;SA&apos;,&apos;LB&apos;)&#13;
and t1.is_non_food = FALSE &#13;
and is_active = true</relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='_A36F06E5D8FB4C9B940535085567F786' table='[Extract].[_A36F06E5D8FB4C9B940535085567F786]' type='table' />
            </properties>
          </object>
          <object caption='Retantion' id='_CC80888FD00E469A8D55573733D9F1D9'>
            <properties context=''>
              <relation connection='bigquery.1vyahhq0n5d8u617u36zh0ooirii' name='Custom SQL Query2' type='text'><![CDATA[with t1 as (select 
a.vendor_id
,country_code
,date_diff(campaign_end_date,campaign_start_date,day) AS campaign_duration
,date_trunc(a.order_date,month) month
from `tlb-data-prod.data_platform.fct_incentive_order_detail` a
left join `tlb-data-prod.data_platform.dim_vendor`
using (vendor_id)
where a.campaign_id in (
  select campaign_id
  from `tlb-data-prod.data_platform.dim_incentive_campaign_detail`
  where lower(campaign_name) like '%best seller%' 
OR lower(campaign_name) like '%bestseller%'
)
and a.order_date >>= '2023-07-01'
and is_successful = true
and NOT is_non_food)

,t2 as (select 
a.vendor_id
,country_code
,min(date_trunc(a.order_date,month)) first_month
from `tlb-data-prod.data_platform.fct_incentive_order_detail` a
left join `tlb-data-prod.data_platform.dim_vendor`
using (vendor_id)
where a.campaign_id in (
  select campaign_id
  from `tlb-data-prod.data_platform.dim_incentive_campaign_detail`
  where lower(campaign_name) like '%best seller%' 
OR lower(campaign_name) like '%bestseller%'
)
and a.order_date >>= '2023-07-01'
and is_successful = true
and NOT is_non_food
group by 1,2)

,t3 as (select t1.vendor_id
,date(month) month
,date(first_month) first_month
,t1.country_code
from t1 inner join t2
on t1.vendor_id = t2.vendor_id
and t1.country_code = t2.country_code)

,t4 as (select vendor_id
,country_code
,month - first_month as month_num
,month
from t3)

,t5 as (select
case when cast(month_num as string) = '0-0 0 0:0:0' then 1
else 0 end AS new_month_vendor
,case when cast(month_num as string) <<>> '0-0 0 0:0:0' then 1
else 0 end AS returning_month_vendor
,month
,month_num
,vendor_id
,country_code
from t4
where month >>= '2023-07-01')
-- pivot by number of days on campaign because otherwise it will sow 3 x week.

,t7 as (select distinct
vendor_id
,country_code
,month
,campaign_duration
from t1)

,t8 as (select vendor_id
,country_code
,month
,sum(campaign_duration) campaign_duration
,case when sum(campaign_duration) >> 15 then '>>2 weeks'
when sum(campaign_duration) >>= 6 and sum(campaign_duration) <<=15 then '1-2 weeks'
else '<<1 weeks' end AS campaign_duration_segment
from t7
group by 1,2,3)

select distinct 
new_month_vendor
, returning_month_vendor
,month_num
,t5.vendor_id
,t5.month
,t5.country_code
,campaign_duration_segment
,campaign_duration
from t5 
left join t8
on t5.vendor_id = t8.vendor_id
