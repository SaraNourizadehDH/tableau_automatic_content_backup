      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Bestsellers' id='_75B1075851F44EEAB340A7405F75A16E'>
            <properties context=''>
              <relation connection='bigquery.0h2ucv41m0fner1eyjr7r1ul7unq' name='Custom SQL Query1' type='text'>with t1 as (select &#13;
gmv_amount_eur&#13;
,gmv_amount_lc&#13;
,order_id&#13;
,vendor_id &#13;
,order_date&#13;
,country_iso&#13;
from `tlb-data-prod.data_platform.fct_order_info`&#13;
where order_id IN (select&#13;
order_id from `tlb-data-prod.data_platform.fct_incentive_order_detail`&#13;
where (lower(campaign_name) like &apos;%best seller%&apos; &#13;
OR lower(campaign_name) like &apos;%bestseller%&apos;&#13;
OR lower(campaign_name) like &apos;%30% off on selected items%&apos;&#13;
OR lower(campaign_name) like &apos;%30% off selected items%&apos;&#13;
OR lower(campaign_name) like &apos;%Orange Friday-50% off selected Items%&apos;&#13;
OR lower(campaign_name) like &apos;%orange friday%&apos;))&#13;
and date_trunc(order_date,week) &gt;&gt;= DATE_SUB(current_date(), INTERVAL 1 MONTH) &#13;
and is_successful = true &#13;
and NOT is_non_food) &#13;
&#13;
select &#13;
vendor_id&#13;
,country_iso&#13;
,count(distinct order_id) orders&#13;
,sum(gmv_amount_eur) gmv_amount_eur&#13;
,sum(gmv_amount_lc) gmv_amount_lc&#13;
,date_trunc(order_date,week) week&#13;
from t1 &#13;
where country_iso not in (&apos;SA&apos;)&#13;
group by 1,2,6&#13;
&#13;
union all &#13;
&#13;
SELECT * FROM `tlb-data-dev.data_playground_partner_growth.mcdonalds_bestsellers_week`</relation>
            </properties>
            <properties context='extract'>
              <relation name='_75B1075851F44EEAB340A7405F75A16E' table='[Extract].[_75B1075851F44EEAB340A7405F75A16E]' type='table' />
            </properties>
          </object>
          <object caption='Total GMV' id='_EE647B76D53C4CCBAAEF15C8A35FC6BC'>
            <properties context=''>
              <relation connection='bigquery.0h2ucv41m0fner1eyjr7r1ul7unq' name='Custom SQL Query' type='text'>select &#13;
sum(gmv_amount_eur) gmv_amount_eur&#13;
,sum(gmv_amount_lc) gmv_amount_lc&#13;
,count(order_id) order_count&#13;
,date_trunc(order_date,week) week&#13;
,vendor_id&#13;
,country_iso&#13;
from `tlb-data-prod.data_platform.fct_order_info`&#13;
where is_successful = true &#13;
and NOT is_non_food&#13;
and date_trunc(order_date,week) &gt;&gt;= DATE_SUB(current_date(), INTERVAL 1 MONTH) &#13;
and country_iso NOT in (&apos;SA&apos;,&apos;EG&apos;)&#13;
group by 4,5,6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_EE647B76D53C4CCBAAEF15C8A35FC6BC' table='[Extract].[_EE647B76D53C4CCBAAEF15C8A35FC6BC]' type='table' />
            </properties>
          </object>
        </objects>
