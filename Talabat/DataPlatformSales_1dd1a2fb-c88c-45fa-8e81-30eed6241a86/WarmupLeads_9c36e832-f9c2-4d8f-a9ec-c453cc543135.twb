      <aliases enabled='yes' />
      <column caption='#leads' datatype='integer' name='[Calculation_3891813817063882752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Braze Leads' datatype='integer' name='[Calculation_3891813817200963585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([braze_current_grid_id])' />
      </column>
      <column caption='Valid Emails' datatype='integer' name='[Calculation_3891813817201332226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [is_valid_email] = TRUE &#10;AND [is_email_exist] =TRUE&#10;AND [is_not_avail_during_scrape] = FALSE&#10;AND [is_generic_email] = FALSE&#10;AND [is_internal_email] = FALSE&#10;THEN [id] END&#10;)' />
      </column>
      <column caption='Valid Mobile' datatype='integer' name='[Calculation_3891813817204719619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_gcc] = TRUE THEN [id] END)' />
      </column>
      <column caption='Total Addressable' datatype='integer' name='[Calculation_3891813817205018628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [is_valid_email] = TRUE &#10;AND [is_email_exist] =TRUE&#10;AND [is_not_avail_during_scrape] = FALSE&#10;AND [is_generic_email] = FALSE&#10;AND [is_internal_email] = FALSE OR [is_valid_gcc] = TRUE&#10;THEN [id] END &#10;)' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_3891813817205608453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_email_exist] = TRUE&#10;THEN [id] END)' />
      </column>
      <column caption='Hard Bounced' datatype='integer' name='[Calculation_3891813817207062534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_hardbounce] = TRUE then id end)' />
      </column>
      <column caption='Email Sent' datatype='integer' name='[Calculation_3891813817207410696]' role='measure' type='quantitative'>
