            <column caption='Messages Sent' datatype='integer' name='[Calculation_3891813817209421837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_sent] = TRUE then [id] END)' />
            </column>
            <column caption='Contacted' datatype='integer' name='[Calculation_3891813817216344078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_contacted] THEN [id] END)' />
            </column>
            <column caption='100%' datatype='integer' name='[Calculation_3891813817338834959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Messages Dispatched' datatype='integer' name='[Calculation_3891813817405124629]' role='measure' type='quantitative'>
