            <column-instance column='[Calculation_3891813817341194256]' derivation='Min' name='[min:Calculation_3891813817341194256:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
