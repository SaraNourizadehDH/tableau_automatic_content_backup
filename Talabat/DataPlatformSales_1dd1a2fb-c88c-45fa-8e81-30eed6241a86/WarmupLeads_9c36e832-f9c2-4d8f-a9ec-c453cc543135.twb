      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_5A0813CAE1AD47BFB4B2105DD3523C04'>
            <properties context=''>
              <relation connection='bigquery.1syxpn50z8b0l61fvt4e61me5fgb' name='Custom SQL Query' type='text'>WITH
  last_lead_status AS (
  SELECT
    grid__c AS grid_id,
    status updated_status,
    competitor__c
  FROM
    `fulfillment-dwh-production.curated_data_shared_salesforce.lead`
  GROUP BY
    ALL ),
  connectly AS (
  SELECT
    customer_external_id,
    error_msg,
  IF
    (sent IS NOT NULL, TRUE, FALSE) is_sent,
  IF
    (dispatched_at IS NOT NULL, TRUE, FALSE) is_dispatched,
  IF
    (delivered IS NOT NULL, TRUE, FALSE) is_message_delivered,
  IF
    (read IS NOT NULL, TRUE, FALSE) is_read,
  IF
    (error_msg IS NOT NULL, TRUE, FALSE) is_error,
  IF
    (link_clicks IS NOT NULL, TRUE, FALSE) is_clicked,
    MIN(sent) connectly_sent_at,
    MIN(read) connectly_read_at,
    MIN(delivered) connectly_delivered_at,
    MIN(dispatched_at) connectly_dispatched_at
  FROM
    `tlb-data-prod.data_platform_rest_tables.connectly-vendor-campaigns`
  WHERE
    sendout_name IN (&apos;20250214 Warmup AR Reg&apos;,
      &apos;20250214 warmup scale AR reg&apos;,
      &apos;20250214 warmup Scale en reg&apos;,
      &apos;20250214_Warmup_EN_Reg&apos; )
  GROUP BY
    ALL),
  leads_cleaned AS (
  SELECT
    * EXCEPT(grid__c),
    grid__c AS grid_id
  FROM
    `tlb-data-dev.vendor_analytics.lead_clean_up`
  WHERE
    status = &apos;New&apos;
    AND (
      CASE
        WHEN is_valid_email AND is_email_exist AND is_internal_email IS FALSE AND is_not_avail_during_scrape IS FALSE AND is_generic_email IS FALSE THEN TRUE
        ELSE FALSE
    END
      IS TRUE
      OR is_valid_gcc) ),
  braze_current AS (
  SELECT
    s.external_user_id,
    RIGHT(s.external_user_id, 6)grid_id,
    s.email_address,
    STRING_AGG(bo.bounce_reason) hard_bounce_reason,
    STRING_AGG(b.bounce_reason) soft_bounce_reason,
    s.message_extras,
  IF
    (s.external_user_id IS NOT NULL, TRUE, FALSE) is_send,
  IF
    (d.external_user_id IS NOT NULL, TRUE, FALSE) is_email_delivered,
  IF
    (o.external_user_id IS NOT NULL, TRUE, FALSE) is_open,
  IF
    (b.external_user_id IS NOT NULL, TRUE, FALSE) is_softbounce,
  IF
    (bo.external_user_id IS NOT NULL, TRUE, FALSE) is_hardbounce,
  IF
    (wh.external_user_id IS NOT NULL, TRUE, FALSE) is_webhook,
  IF
    (ma.external_user_id IS NOT NULL, TRUE, FALSE) is_spam,
    TIMESTAMP_SECONDS(MIN(s.time))send_timestamp,
    TIMESTAMP_SECONDS(MIN(d.time))delivered_timestamp,
    TIMESTAMP_SECONDS(MIN(o.time)) open_timestamp,
    TIMESTAMP_SECONDS(MIN(b.time)) softbounced_timestamp,
    TIMESTAMP_SECONDS(MIN(bo.time)) hardbounce_timestamp,
    TIMESTAMP_SECONDS(MIN(wh.time))webhook_timestamp,
    MIN(ma.time) spam_timestamp,
    COUNT(DISTINCT s.external_user_id) total_send,
    COUNT(DISTINCT d.external_user_id) total_delivered,
    COUNT(DISTINCT o.external_user_id) total_open,
    COUNT(DISTINCT b.external_user_id) total_softBounce,
    COUNT(DISTINCT bo.external_user_id) total_hardbounce,
    COUNT(DISTINCT wh.external_user_id) total_webhook,
    COUNT(DISTINCT ma.external_user_id) total_marked_as_spam,
  FROM
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_Send_*` s
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_Open_*` o
  ON
    s.canvas_id = o.canvas_id
    AND s.external_user_id = o.external_user_id
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_Delivery_*` d
  ON
    s.canvas_id = d.canvas_id
    AND s.external_user_id = d.external_user_id
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_SoftBounce_*` b
  ON
    s.canvas_id = b.canvas_id
    AND s.external_user_id = b.external_user_id
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_Bounce_*` bo
  ON
    s.canvas_id = bo.canvas_id
    AND s.external_user_id = bo.external_user_id
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_webhook_Send_*` wh
  ON
    s.canvas_id = wh.canvas_id
    AND s.external_user_id = wh.external_user_id
  LEFT JOIN
    `tlb-data-prod.data_platform_rest_tables.users_messages_email_MarkAsSpam_*` ma
  ON
    s.canvas_id = ma.canvas_id
    AND s.external_user_id = ma.external_user_id
  WHERE
    TRUE
    AND s.canvas_name LIKE &apos;%Warm%&apos;
    AND s.canvas_id =&apos;48ae3657-8b95-488a-925b-004a74a22d08&apos;
  GROUP BY
    ALL
  ORDER BY
    3 DESC ),
  request_call_back AS (
  SELECT
    DISTINCT grid AS grid_id
  FROM
    `tlb-data-dev.vendor_analytics.qualtircs_warm_lead_responses_load`)
SELECT
  l.*,
  b.* EXCEPT(grid_id),
  b.grid_id AS braze_current_grid_id,
  k.grid_id requested_call_back_grid,
IF
  (c.customer_external_id IS NOT NULL, TRUE, FALSE) is_connectly_message,
  c.*,
  s.* EXCEPT(grid_id),
IF
  (l.status != s.updated_status, TRUE, FALSE) is_changed_status,
IF
  (s.updated_status = &apos;Contacted&apos;, TRUE, FALSE) is_contacted,
IF
  (competitor__c IS NOT NULL, TRUE, FALSE) is_exist_competitor
FROM
  leads_cleaned l
LEFT JOIN
  braze_current b
USING
  (grid_id)
LEFT JOIN
  request_call_back k
ON
  lower(trim(k.grid_id)) = lower(trim(l.grid_id))
LEFT JOIN
  connectly c
ON
  c.customer_external_id = l.mobile_number
LEFT JOIN
  last_lead_status s
ON
  s.grid_id = l.grid_id
GROUP BY
  ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
