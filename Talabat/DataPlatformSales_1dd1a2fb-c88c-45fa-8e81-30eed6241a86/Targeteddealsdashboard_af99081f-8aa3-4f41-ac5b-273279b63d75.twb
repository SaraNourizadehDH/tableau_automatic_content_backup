  <worksheets>
    <worksheet name='Acquisitions'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000'>Inventory penetration</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' italic='true'>since launch</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fct table' name='federated.0ysw4fc13ll67918pk6mr04kl1i7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Campaign Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisition&quot;'>
              <calculation class='tableau' formula='&quot;Acquisition&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ysw4fc13ll67918pk6mr04kl1i7'>
            <column caption='Vendors tried acquisition TD' datatype='integer' name='[Acquired vendors (copy)_1179872748548304897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_6330583345645809664],[country_code]: COUNTD([vendor_id] )}' />
            </column>
            <column caption='Vendors tried winback TD' datatype='integer' name='[Acquired_vendors_1 (copy)_1179872748548571138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Acquisition Date acq (copy)_1179872748569894915],[country_code]: COUNTD([vendor_id])}' />
            </column>
            <column caption='Acquisition Date wb' datatype='date' name='[Acquisition Date acq (copy)_1179872748569894915]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [vendor_id]: min(if [has_td_wb_campaign]==TRUE then [date] end)}' />
            </column>
            <column caption='Acquisition Date' datatype='date' name='[Acquisition Date wb (copy)_1179872748569968644]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [vendor_id]: min(if [has_td_wb_campaign]==TRUE or [has_td_acq_campaign]==true then [date] end)}' />
            </column>
            <column caption='Cumulative acquisitions all' datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_758012126817472514]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Join Date' datatype='date' name='[Calculation_1179872749198020622]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Acquisition&apos; THEN [Calculation_6330583345645809664]&#10;WHEN &apos;All&apos; THEN [Acquisition Date wb (copy)_1179872748569968644]&#10;WHEN &apos;Winback&apos; THEN [Acquisition Date acq (copy)_1179872748569894915]&#10;END' />
            </column>
            <column caption='Cumulative Acquisitions' datatype='integer' name='[Calculation_1179872749200359439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Acquisition&apos; THEN [Cumulative acquisitions (copy)_1179872748572745735]&#10;WHEN &apos;All&apos; THEN [Calculation1]&#10;WHEN &apos;Winback&apos; THEN [Cumulative acquisitions acq (copy)_1179872748572909576]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acquisition Date acq' datatype='date' name='[Calculation_6330583345645809664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [vendor_id]: min(if [has_td_acq_campaign]==TRUE then [date] end)}' />
            </column>
            <column caption='Vendor Count' datatype='integer' name='[Calculation_6330583345647648769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed  : COUNTD([vendor_id])}' />
            </column>
            <column caption='Penetration Rate' datatype='real' default-format='p0.00%' name='[Calculation_6330583345678327824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1179872749200359439]/sum([Calculation_6330583345647648769])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acquired vendors' datatype='integer' name='[Calculation_758012126817472514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1179872749198020622],[country_code]: COUNTD([vendor_id])}' />
            </column>
            <column caption='Cumulative acquisitions acq' datatype='integer' name='[Cumulative acquisitions (copy)_1179872748572745735]' role='measure' type='quantitative'>
