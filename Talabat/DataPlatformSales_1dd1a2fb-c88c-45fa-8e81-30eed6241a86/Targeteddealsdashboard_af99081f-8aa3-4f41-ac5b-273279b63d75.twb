      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ysw4fc13ll67918pk6mr04kl1i7].[usr:Calculation_1179872748952481803:qk]&quot;' value='Share in acquisitions' />
          <alias key='&quot;[federated.0ysw4fc13ll67918pk6mr04kl1i7].[usr:Calculation_1179872748957704204:qk]&quot;' value='Share in incentives' />
        </aliases>
      </column>
      <column caption='Vendors tried acquisition TD' datatype='integer' name='[Acquired vendors (copy)_1179872748548304897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_6330583345645809664],[country_code]: COUNTD([vendor_id] )}' />
      </column>
      <column caption='Vendors tried winback TD' datatype='integer' name='[Acquired_vendors_1 (copy)_1179872748548571138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Acquisition Date acq (copy)_1179872748569894915],[country_code]: COUNTD([vendor_id])}' />
      </column>
      <column caption='Acquisition Date wb' datatype='date' name='[Acquisition Date acq (copy)_1179872748569894915]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [vendor_id]: min(if [has_td_wb_campaign]==TRUE then [date] end)}' />
      </column>
      <column caption='Acquisition Date' datatype='date' name='[Acquisition Date wb (copy)_1179872748569968644]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [vendor_id]: min(if [has_td_wb_campaign]==TRUE or [has_td_acq_campaign]==true then [date] end)}' />
      </column>
      <column caption='Booked TD' datatype='boolean' name='[Booked incentives (copy)_164381405900374016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [vendor_id]: if max([has_td_acq_campaign])==true or max([has_td_wb_campaign])==TRUE then true else false end}' />
      </column>
      <column caption='Cumulative acquisitions all' datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
