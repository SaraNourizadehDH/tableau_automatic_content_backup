            <column caption='Date Range' datatype='string' name='[Calculation_1179872749212106774]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#10;[date] &gt;= [Parameters].[End Date (copy)_1179872749211656213]-(DATEDIFF(&apos;day&apos;,[Parameters].[End Date (copy)_1179872749211656213], [Parameters].[Campaign Type (copy)])+1)&#10;and [date] &lt;= [Parameters].[Campaign Type (copy)]-(DATEDIFF(&apos;day&apos;,[Parameters].[End Date (copy)_1179872749211656213], [Parameters].[Campaign Type (copy)])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[End Date (copy)_1179872749211656213] and [date] &lt;= [Parameters].[Campaign Type (copy)]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
            </column>
