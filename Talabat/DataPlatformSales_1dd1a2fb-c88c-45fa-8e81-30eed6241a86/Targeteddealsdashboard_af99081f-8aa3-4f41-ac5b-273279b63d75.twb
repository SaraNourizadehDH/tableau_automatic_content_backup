        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1wbjnra0vwd1001bt6cf70hns5dk' name='Custom SQL Query' type='text'>select avid.vendor_id,
avid.date,
avid.country_code,
 city_name, 
chain_name, 
dvi.vendor_name, 
&quot;Generic&quot; as segment,
dvi.chain_id,
dvi.account_manager_email, 
has_targeted_deal_acquisition_campaign as has_td_acq_campaign, 
has_targeted_deal_win_back_campaign as has_td_wb_campaign,
has_discount_campaign as has_incentive_campaigns,
dvh.is_active,
vendor_order_count as orders,
vendor_gmv_sum_eur as gmv, 
vendor_funded_menu_discount_order_count as vf_menu_discount_orders,
vendor_funded_menu_discount_amount_sum_eur as vf_menu_discount_cost,
acquisition_targeted_deal_order_count as td_acq_orders, 
win_back_targeted_deal_order_count as td_wb_orders,
acquisition_targeted_deal_customer_count as TD_acq_customers,
win_back_targeted_deal_customer_count as TD_wb_customers,
acquisition_targeted_deal_gmv_sum_eur as td_acq_revenue,
win_back_targeted_deal_gmv_sum_eur as td_wb_revenue,
acquisition_targeted_deal_monetized_value_sum_eur as td_acq_gmv,
win_back_targeted_deal_monetized_value_sum_eur as td_wb_gmv,
acquisition_targeted_deal_discount_amount_sum_eur as td_menu_discount_cost_acq,
win_back_targeted_deal_discount_amount_sum_eur as td_menu_discount_cost_wb,
discount_campaign_order_count as incentive_orders,
discount_campaign_customer_count as incentive_customers,
vendor_new_customer_count as new_customers
from `tlb-data-prod.data_platform.agg_vendor_incentive_discount` avid
left join `tlb-data-prod.data_platform.dim_vendor_history` dvh
on dvh.vendor_id=avid.vendor_id 
and avid.date between dvh.valid_from and dvh.valid_to
left join `tlb-data-prod.data_platform.dim_vendor_info` dvi 
on dvi.vendor_id=avid.vendor_id
left join `tlb-data-prod.data_platform.dim_location_info` dli 
on dli.location_id=dvi.location_id 

left join `tlb-data-prod.data_platform.dim_chain` dc 
on dc.chain_id=dvi.chain_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
