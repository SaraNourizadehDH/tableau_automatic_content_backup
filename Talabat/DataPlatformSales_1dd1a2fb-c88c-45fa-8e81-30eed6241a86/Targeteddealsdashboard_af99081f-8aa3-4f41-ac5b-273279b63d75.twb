            </column>
            <column caption='TD revenue' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_1179872748572299270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Acquisition&apos; THEN [td_acq_revenue]&#10;WHEN &apos;All&apos; THEN [td_acq_revenue]+[td_wb_revenue]&#10;WHEN &apos;Winback&apos; THEN [td_wb_revenue]&#10;END' />
            </column>
