      <aliases enabled='yes' />
      <column caption='W3 retention' datatype='real' default-format='p0.00%' name='[Calculation_1289577622823501832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_vendors_w3]/[active_vendors_original]' />
      </column>
      <column caption='Vendors Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_5438940987824615424]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='sum([active_vendors])/sum([active_vendors_original])' />
      </column>
      <column caption='Cohort start vendors' datatype='integer' name='[Calculation_5438940987827183618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [cohort_number]: max(IF [cohort_week]==[week] then [active_vendors] end) }' />
      </column>
      <column caption='Elapsed week' datatype='integer' name='[Calculation_5438940987828936707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;week&apos;,[cohort_week],[week])' />
      </column>
      <column caption='GMV retention' datatype='real' default-format='p0.00%' name='[Vendors Retention Rate (copy)_5438940987824885761]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='sum([gmv])/sum([gmv_original])' />
      </column>
      <column caption='NCR retention' datatype='real' default-format='p0.00%' name='[Vendors Retention Rate (copy)_5438940987832279044]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='sum([order_fees])/sum([order_fees_original])' />
      </column>
