    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='OKRs Metrics Monitor (4)'>
      <style>
        <style-rule element='dash-subtitle'>
          <format attr='font-size' value='12' />
          <format attr='font-weight' value='bold' />
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1000' minheight='900' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='92555' id='7' param='horz' type-v2='layout-flow' w='98400' x='800' y='6556'>
            <zone h='92555' id='5' type-v2='layout-basic' w='98400' x='800' y='6556'>
              <zone forceUpdate='true' h='40888' id='73' type-v2='text' w='98400' x='800' y='6556'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Our Vision:</run>
                  <run fontcolor='#000000' fontsize='10'> by acquiring customers in the right verticals and cementing the experience with a robust ecosystem, we will build strong customer habits that will act as a flywheel for higher frequency and retention. The sum will be greater than the parts.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Our Northstar: </run>
                  <run fontcolor='#000000' fontsize='10'>is to have 24% of our customers as Active Multi-Vertical Adopters (Leading), contributing to an increase in our Customer Lifetime Value (Lagging).</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>Effective Product Marketing and Intelligent CRM will be our main levers to achieving this Northstar cost-efficiently.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definitions of KPIs tp monitor for our OKRs H2 2022: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of active multi-vertical customers : # active customers that have ordered from food and NFV / # active customers in same period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of active multi-vertical trials : # active customers that have ordered from food and NFV and have less than 3 orders in NFV / # active customers in same period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of active multi-vertical adopters : # active customers that have ordered from food and NFV and have more than 3 orders in NFV and more than 3 orders in food / # active customers in same period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of active multi-vertical adopters - tmart : # active customers that have ordered from food and tmart and have more than 3 orders in tmart and more than 3 orders in food / # active customers in same period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of active multi-vertical non-incentivized acquisitions : # active customers that were acquired in NFV for the first time with no incentive / # active customers in same period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>- % of multi-vertical visitors : # users that have visited food and NFV / # users in same period.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='51667' id='74' type-v2='empty' w='98400' x='800' y='47444'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
