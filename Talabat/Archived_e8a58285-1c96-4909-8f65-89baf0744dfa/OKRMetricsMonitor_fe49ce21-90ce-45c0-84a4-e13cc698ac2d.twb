    <worksheet name='Rolling 30 days'>
      <table>
        <view>
          <datasources>
            <datasource caption='multivertical orders' name='federated.0qln54g1a9mosa14l4p2o07wcvi9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrics' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Multi-Vertical Customers&quot;'>
              <calculation class='tableau' formula='&quot;% of Multi-Vertical Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qln54g1a9mosa14l4p2o07wcvi9'>
            <column caption='% of Multi-vertical Adopters (Food, tmart)' datatype='real' default-format='p0.0%' name='[% of Multi-Vertical Adopters (copy)_266486495054008327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mv_adopters_tmart_rolling]) / &#10;SUM([active_customers_rolling])' />
            </column>
            <column caption='% of Organic Non-Incentivized Acquisitions' datatype='real' default-format='p0.0%' name='[% of Multi-Vertical Adopters (copy)_266486495054270472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mv_organic_acquisitions_rolling]) / &#10;SUM([active_customers_rolling])' />
            </column>
            <column caption='% of Multi-Vertical Trials' datatype='real' default-format='p0.0%' name='[% of Multi-Vertical Customers (copy)_266486495052185604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mv_trials_rolling]) / &#10;SUM([active_customers_rolling])' />
            </column>
            <column caption='% of Multi-Vertical Adopters' datatype='real' default-format='p0.0%' name='[% of Multi-Vertical Trials (copy)_266486495052455942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mv_adopters_rolling]) / &#10;SUM([active_customers_rolling])' />
            </column>
            <column caption='% of Multi-Vertical Customers' datatype='real' default-format='p0.0%' name='[Calculation_266486495051628547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mv_customers_rolling]) / &#10;SUM([active_customers_rolling])' />
            </column>
            <column caption='Select Metric %' datatype='real' default-format='p0.0%' name='[Calculation_266486495064657929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;//WHEN &apos;Active Customers&apos; THEN SUM([active_customers_rolling])&#10;WHEN &apos;% of Multi-Vertical Customers&apos; THEN [Calculation_266486495051628547]&#10;WHEN &apos;% of Multi-Vertical Trials&apos; THEN [% of Multi-Vertical Customers (copy)_266486495052185604]&#10;WHEN &apos;% of Multi-Vertical Adopters&apos; THEN [% of Multi-Vertical Trials (copy)_266486495052455942]&#10;WHEN &apos;% of Multi-vertical Adopters (Food, tmart)&apos; THEN [% of Multi-Vertical Adopters (copy)_266486495054008327]&#10;WHEN &apos;% of Organic Non-Incentivized Acquisitions&apos; THEN [% of Multi-Vertical Adopters (copy)_266486495054270472]&#10;END' />
            </column>
            <column caption='Select Metric Combined' datatype='real' default-format='p0.0%' name='[Select Metric (MTD) Combined (copy)_204913844208472070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Active Customers&apos; THEN [Select Metric (copy)_204913844208070661]&#10;ELSE [Calculation_266486495064657929]&#10;END' />
            </column>
            <column caption='Select Metric' datatype='integer' default-format='n#,##0;-#,##0' name='[Select Metric (copy)_204913844208070661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Active Customers&apos; THEN SUM([active_customers_rolling])&#10;//WHEN &apos;% of Multi-Vertical Customers&apos; THEN [% of Multi-Vertical Customers]&#10;//WHEN &apos;% of Multi-Vertical Trials&apos; THEN [% of Multi-Vertical Trials]&#10;//WHEN &apos;% of Multi-Vertical Adopters&apos; THEN [% of Multi-Vertical Adopters]&#10;//WHEN &apos;% of Multi-vertical Adopters (Food, tmart)&apos; THEN [% of Multi-vertical Adopters (Food, tmart)]&#10;//WHEN &apos;% of Organic Non-Incentivized Acquisitions&apos; THEN [% of Organic Non-Incentivized Acquisitions]&#10;END' />
            </column>
            <column datatype='integer' name='[active_customers_rolling]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
