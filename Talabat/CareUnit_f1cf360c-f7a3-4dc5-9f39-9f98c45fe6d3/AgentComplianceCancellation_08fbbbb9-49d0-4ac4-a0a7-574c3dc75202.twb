            <column-instance column='[Calculation_1791940119487496196]' derivation='None' name='[none:Calculation_1791940119487496196:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6882837276462604288]' derivation='None' name='[none:Calculation_6882837276462604288:nk]' pivot='key' type='nominal' />
            <column-instance column='[Food_Non_Food]' derivation='None' name='[none:Food_Non_Food:nk]' pivot='key' type='nominal' />
