        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1c5e6ng0twzy0p1g0fkwd00t8p11'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='sara.ali@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1c5e6ng0twzy0p1g0fkwd00t8p11' name='Custom SQL Query' type='text'><![CDATA[with
base as
(
SELECT
order_id
,action
,datetime(substr(created_on,1,19)) as date_time
,i.email
,reason_text
,Job_Title
,department_group
,is_agent
,contract_type
,i.description
FROM `tlb-data-prod.data_platform.order_activity_log` i
left join `tlb-data-prod.data_platform.dim_employee` u  on lower(i.email) = lower(u.email) and is_current_email_owner
WHERE action = 'CANCEL_ORDER'  
and DATE(_PARTITIONTIME) >>= '2024-01-01'
 and DATE(_PARTITIONTIME) <<  '2024-08-15'
and created_on is not null
--and i.email is not null
-- and order_id not in 
--   (
--   SELECT
--   order_id
--   FROM `tlb-data-prod.data_platform.order_activity_log` 
--   WHERE action = 'MARK_ORDER_AS_SUCCESSFUL' 
--   and DATE(_PARTITIONTIME) >>= '2024-01-01'
--   and DATE(_PARTITIONTIME) <<  current_date()
--   and created_on is not null
--   group by 1
--   )
), 

cancelled_min as 
(
SELECT
order_id
,(action) action
,(date_time ) as date_time
,(email) email
,(department_group)Department_group--,min(agent_dept) agent_dept
,(contract_type) Bpo
,(Job_Title) Job_Title
,(reason_text) reason_text
,(is_agent)is_agent
,(description)description
,rank() over(partition by order_id,action order by date_time) as rank 
FROM base
qualify rank=1
),
cancelled_max as 
(
SELECT
order_id
,(action) action
,(date_time ) date_time
,(email) email
,(reason_text) reason_text
,(department_group)Department_group
,(contract_type) Bpo
,(Job_Title) Job_Title
,(is_agent)is_agent
,rank() over(partition by order_id,action order by date_time desc) as rank 
FROM base
where email is not null 
qualify rank=1
),

change_reason as
(
select 
c.order_id
,c.email           as action_taker1_email
,m.email           as action_taker2_email
,c.Department_group     as action_taker1_dpt
,m.Department_group     as action_taker2_dpt
,c.Job_Title      as action_taker1_title
,m.Job_Title      as action_taker2_title
,c.Bpo      as action_taker1_lob
,m.Bpo      as action_taker2_lob
,case when c.reason_text=""then REGEXP_SUBSTR(description,"Reason:(.*)") else c.reason_text end  as reason_text1
,m.reason_text     as reason_text2
,c.date_time       as action1_time
,m.date_time       as action2_time
,c.action          as action1
,m.action          as action2
,c.is_agent       as is_agent1
,m.is_agent       as is_agent2
,datetime_diff(m.date_time,c.date_time,DAY) as change_action_diff_in_days
from cancelled_min c
inner join cancelled_max m on c.order_id = m.order_id and c.date_time << m.date_time --and c.reason_text <<>> m.reason_text
),

prefinal as
(
select 
i.order_id
,order_date
,a.country_iso as country
-- ,i.action_taker1_email
-- ,i.action_taker2_email
-- ,i.action_taker1_dpt
-- ,i.action_taker2_dpt
-- ,i.action_taker1_title
-- ,i.action_taker2_title
-- ,i.action_taker1_lob
-- ,i.action_taker2_lob
-- ,i.reason_text1
-- ,i.reason_text2
-- ,i.action1_time
-- ,i.action2_time
-- ,i.action1
-- ,i.action2
-- ,i.is_agent1
-- ,i.is_agent2
-- ,case when v.vertical_class='non-food' and v.sub_vertical ='darkstore' then 'Tmart' else v.vertical_class end vertical
-- ,case when a.is_online_payment then 'online' else 'cash'end as payment_method
-- ,case when a.is_tgo then 'TGO' else 'TMP'end as delivery_method
-- ,a.gmv_amount_eur as order_gmv_eur
-- ,case when i.action1 = i.action2 then 'change_cancellation_reason' end as reconciliation_action 
-- ,s.status
-- ,f.owner
-- ,a.order_time
-- ,a.basket_amount_eur
-- ,safe_cast(a.order_time_utc as datetime)order_time_utc
--,f.stage
from change_reason i
left join `tlb-data-prod.data_platform.fct_order_info` a on cast(a.order_id as string) = i.order_id and order_date >>= '2024-01-01' and order_date << '2024-08-15'
left join `tlb-data-prod.data_platform.dim_vertical` v on v.vertical_id = a.vertical_id
left join `tlb-data-prod.data_platform.dim_order_status`s on a.order_status_id=s.order_status_id
LEFT JOIN
    `tlb-data-prod.data_platform.dim_order_fail_reason` f
  ON
    a.order_fail_reason_id=f.order_fail_reason_id
    where 
   a.delivery_arrangement in ("TGO","PICKUP")
)

--New cancellation Rules based on sheet shared from Shaimaa------
--- applying Rules for QC ------------

select 
a.order_date,
  country_iso as country,
  a.order_id,
  talabat_reason,
  delivery_arrangement as delivery_method,
  v.vertical_class Food_Non_Food,
  case when v.vertical_class='non-food' and v.sub_vertical ='darkstore' then 'Tmart' else v.vertical end Vertical_Class,
  v.sub_vertical,
  case when a.is_online_payment then 'OP' else 'COD' end payment_method,
  gmv_amount_eur,
  owner as cancellation_owner,
  STAGE as cancellation_stage,
  source as cancellation_source,
  a.is_tgo,
  a.cancellation_agent_employee_id,
  e.email as agent_email,
  e.department_group,
  e.department,
  case when e.email in("muhamad.abdulrahman.ps5_exjo.ext@talabat.com"
,"lanya.azad.3_exjo.ext@talabat.com") then "Talabat BPO - Extensya" else e.contract_type end as contract_type ,
  e.line_of_business,
  case when ai.country_Q='resturant care' then 'resturant care' else e.sub_line_of_business end sub_line_of_business ,
  e.is_agent,
  case when e.department_group="Logistics-Dispatching" then "Logistics-Dispatching"
       when ai.country_Q='resturant care' then "Partner Care"
       when ai.country_Q="Payment Reconciliation" then "Partner Care"
  else e.line_of_business end as SSC_dep
--Group1 QC
,  case 
    when v.vertical <<>> 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) and stage <<>>'DELIVERY' then 'GP1_violated'
    when v.vertical <<>> 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) and a.is_online_payment and country_iso in("AE","JO","IQ") 
     then'GP1_violated'
--Group1 Food
    when v.vertical = 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) 
    and (stage<<>>'DELIVERY' or (a.is_online_payment and country_iso in("AE","JO") )) then'GP1_violated'
--Group2 dropped for QC------
--Group2 Food 
    when v.vertical = 'food' and talabat_reason in ("CST - Didn't show up for Pickup Order") and delivery_arrangement<<>>"PICKUP"
    then 'GP2_violated'
--Group3 QC
    when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to confirm cash order") and (stage not in ('CONFIRMATION','PREPARATION') or a.is_online_payment) then 'GP3_violated'
    when v.vertical <<>> 'food' and talabat_reason in ("CST - forget to add a voucher") and stage not in ('CONFIRMATION','PREPARATION') then 'GP3_violated'
--Group 3 Food
    when v.vertical = 'food' and talabat_reason in ("CST - Unable to confirm cash order") and (stage not in ('CONFIRMATION') or a.is_online_payment)
    then 'GP3_violated'
    when v.vertical = 'food' and talabat_reason in ("CST - forget to add a voucher") and (stage not in ('CONFIRMATION') )
    then 'GP3_violated'
--Group4 QC 
    when v.vertical <<>> 'food' and talabat_reason in ("Fraud Customer") and (ai.country_Q<<>>"SWAT" or e.email not in ('msaeedhussien@talabat.com','ahmed.n.2@talabat.com'
          ,'mohamed.khoder@talabat.com','nader.ahmed@talabat.com','eman.elemam@talabat.com','mostafa.hamza@talabat.com','mohamed.nasser@talabat.com','abdullah.metwally@talabat.com'))
     then'GP4_violated'
--Group4 Food
     when v.vertical = 'food' and talabat_reason in ("Fraud Customer") and (ai.country_Q<<>>"SWAT" or e.email not in ('msaeedhussien@talabat.com',
'ahmed.n.2@talabat.com',
'mohamed.khoder@talabat.com',
'nader.ahmed@talabat.com',
'eman.elemam@talabat.com',
'mostafa.hamza@talabat.com',
'mohamed.nasser@talabat.com',
'abdullah.metwally@talabat.com'))
  then'GP4_violated'
--Group5 QC
     when v.vertical <<>> 'food' and talabat_reason in
      ("CST - Change Vendor/ item","CST - Change Payment Method"
      ,"CST - Refuse to provide a reason"
      ,"CST - has an Emergency"
    ,"CST - request with extra charge"
    ,"CST - Change Delivery Details" ) and stage not in ('CONFIRMATION','PREPARATION') then'GP5_violated'
--Group5 Food
     when vertical="food" and talabat_reason in (
    "CST - Change Vendor/ item"
    ,"CST - Change Payment Method"
    ,"CST - Refuse to provide a reason"
    ,"CST - has an Emergency"
    ,"CST - request with extra charge") and (stage not in ('CONFIRMATION') )
    then'GP5_violated'

     when vertical="food" and talabat_reason in (
    "CST - Change Delivery Details") and ((stage not in ('CONFIRMATION') ) and delivery_arrangement="TGO")
     then'GP5_violated'
--Group 6 QC
    
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay")  and a.is_online_payment then 'GP6_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay")  and e.department_group <<>> "Logistics-Dispatching"  
     and stage not in ('CONFIRMATION','PREPARATION' ) then 'GP6_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay") and e.department_group = "Logistics-Dispatching"  and stage <<>> 'DELIVERY' then 'GP6_violated'
--Group6 Food
     when v.vertical = 'food' and talabat_reason in ("CST - Unable to pay") and (stage not in ('CONFIRMATION') or a.is_online_payment)
     then'GP6_violated'
--Group7 QC
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Duplicate Order") and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY',"POST_DELIVERY")       
     then'GP7_violated'
--Group7 Food 
     when v.vertical = 'food' and talabat_reason in ("CST - Duplicate Order") and Stage not in('CONFIRMATION','PREPARATION','DELIVERY')
    then'GP7_violated'
--Group8 QC
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address") 
     and e.department_group<<>>"Logistics-Dispatching" and stage not in ('CONFIRMATION','PREPARATION',"POST_DELIVERY")  then'GP8_violated' 

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address") and country_iso in("JO","EG") and stage="POST_DELIVERY" then'GP8_violated'

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address")  and e.department_group="Logistics-Dispatching" and stage <<>> 'DELIVERY' then'GP8_violated'


     when v.vertical <<>> 'food' and talabat_reason in ("CST - Fake order") and e.department_group<<>>"Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION') then'GP8_violated'

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Fake order") and e.department_group="Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
     
     then'GP8_violated'
--Group8 Food 
     when v.vertical = 'food' and talabat_reason in ("CST - Incomplete/Wrong Address")  and e.department_group<<>>"Logistics-Dispatching" and (stage not in ('CONFIRMATION') or vertical<<>>"food") 
      OR talabat_reason in ("CST - Incomplete/Wrong Address") and (e.department_group="Logistics-Dispatching" and (stage not in ('DELIVERY')))
    then'GP8_violated'
    when v.vertical = 'food' and talabat_reason in ("CST - Fake order") and (stage not in ('CONFIRMATION') or vertical<<>>"food") 
    --and e.department_group<<>>"Logistics-Dispatching"
    then'GP8_violated'
--Group9 QC
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Accident','Rider unreachable','Rider Refuse to deliver','Preparation Delay') and not a.is_tgo then 'GP9_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Accident','Rider unreachable') and stage <<>> 'DELIVERY' then 'GP9_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Refuse to deliver','Preparation Delay') and stage not in ('DELIVERY','PREPARATION') then 'GP9_violated'
--Group9 Food 
     when v.vertical = 'food' and talabat_reason in ('Rider Accident','Rider unreachable') and (stage<<>>'DELIVERY' or not a.is_tgo)
    then 'GP9_violated'
    when v.vertical = 'food' and talabat_reason in ('Rider Refuse to deliver','Preparation Delay') and (stage not in ('DELIVERY','PREPARATION') or not a.is_tgo)
    then 'GP9_violated'
--Group10 QC
     when v.vertical <<>> 'food' and talabat_reason in ('Bad Weather') and Stage not in('CONFIRMATION','PREPARATION','DELIVERY') then 'GP10_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Late Delivery') and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY') then 'GP10_violated'  
--Group 10 Food 
     when v.vertical = 'food' and talabat_reason in ('Bad Weather') and Stage not in('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP10_violated'
     when v.vertical = 'food' and talabat_reason in ('Late Delivery') and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP10_violated' 
--Group11 QC
      
     when v.vertical <<>> 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and delivery_arrangement <<>> "PICKUP" then 'GP11_violated'
     when  v.vertical <<>> 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and  stage <<>>'DELIVERY' then 'GP11_violated'
--Group 11 Food
     when v.vertical = 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and (stage<<>>'DELIVERY' or  vertical<<>>"food"  or delivery_arrangement<<>>"PICKUP")
    then 'GP11_violated'

--Group12 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" ) and delivery_arrangement not in ("TGO","PICKUP" ) then 'GP12_violated' 
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" )  and v.sub_vertical ='darkstore' then 'GP12_violated'  
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" ) and stage not in ('DELIVERY','PREPARATION') then 'GP12_violated'
-- Group 12 Food 
     when v.vertical = 'food' and talabat_reason in ("Ven Incorrect Location" ) and (stage not in ('DELIVERY','PREPARATION') or delivery_arrangement not in ("TGO","PICKUP" ))then 'GP12_violated'
 
--Group13    QC 
     when v.vertical <<>> 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") and v.sub_vertical ='darkstore' then 'GP13_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") and stage not in ('CONFIRMATION','PREPARATION') then 'GP13_violated'

--Group13 Food
     when v.vertical = 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") 
    and (stage not in ('CONFIRMATION','PREPARATION'))
    then 'GP13_violated'

--Group14 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Unavailable Menu item","Ven - uncontactable","Ven - Refuse to prepare Order") 
    and stage not in ('CONFIRMATION','PREPARATION') then 'GP14_violated'

   when v.vertical <<>> 'food' and talabat_reason in ("Tlb - System Issue") and e.department_group<<>>"Logistics-Dispatching" 
    and stage not in ('CONFIRMATION','PREPARATION') 
    then 'GP14_violated'

    when v.vertical <<>> 'food' and talabat_reason in ("Tlb - System Issue") and e.department_group="Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP14_violated'

--group14 Food
     when v.vertical = 'food' and talabat_reason in ("Unavailable Menu item","Ven - uncontactable","Ven - Refuse to prepare Order","Tlb - System Issue") 
    and stage not in ('CONFIRMATION','PREPARATION')
    then 'GP14_violated'
--Group15 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
     and delivery_arrangement not in ("TGO","PICKUP" ) then 'GP15_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") and v.sub_vertical ='darkstore' then 'GP15_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
     and stage not in ('CONFIRMATION','PREPARATION') then 'GP15_violated'
--Group15 Food
     when v.vertical = 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
    and (stage not in ('CONFIRMATION','PREPARATION') or a.is_tgo )
    then 'GP15_violated'
--Group16QC
  when v.vertical <<>> 'food' and talabat_reason in ("Ven - Ignored Special Request","Food is inedible")  
  and stage not in ("POST_DELIVERY") then 'GP16_violated'

  when v.vertical <<>> 'food' and talabat_reason in ("Ven - Content Discrepancy") and stage not in ('POST_DELIVERY','DELIVERY','PREPARATION') then 'GP16_violated' --modified
  
     when v.vertical <<>> 'food' and talabat_reason in ("Spilt/ damaged Order","Ven Wrong Order")  and stage not in ('DELIVERY',"POST_DELIVERY") then 'GP16_violated'
--Group16 Food 
     when v.vertical = 'food' and talabat_reason in ("Ven - Content Discrepancy","Ven - Ignored Special Request","Food is inedible ") 
    and stage not in ("POST_DELIVERY")
    then 'GP16_violated'
    when v.vertical = 'food' and talabat_reason in ("Spilt/ damaged Order","Ven Wrong Order") 
    and stage not in ('DELIVERY',"POST_DELIVERY")
    then 'GP16_violated'
--Group17 QC   
     when v.vertical <<>> 'food' and talabat_reason in ("Rider mixed up orders") and not a.is_tgo then 'GP17_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Rider mixed up orders") and stage not in ('DELIVERY',"POST_DELIVERY") then 'GP17_violated'
--Group 17 Food 
     when v.vertical = 'food' and talabat_reason in ("Rider mixed up orders") 
    and (stage not in ('DELIVERY',"POST_DELIVERY") or not a.is_tgo)
    then 'GP17_violated'

--Group18 QC
    
     when v.vertical <<>> 'food' and  talabat_reason in ("Ven - System/ Device Issue") and stage not in ('CONFIRMATION','PREPARATION') 
    then'GP18_violated'
     when v.vertical <<>> 'food' and  talabat_reason in ("Lack of Delivery Men") and stage not in ('CONFIRMATION','PREPARATION',"DELIVERY") 
    then'GP18_violated'
--Group 18 Food
     when v.vertical = 'food' and talabat_reason in ("Unprofessional Behavior from Rider") and stage not in ('PREPARATION',"DELIVERY","POST_DELIVERY") 
    then'GP18_violated'
    when v.vertical = 'food' and talabat_reason in ("Ven - System/ Device Issue") and stage not in ('CONFIRMATION','PREPARATION') 
    then'GP18_violated'
    when v.vertical = 'food' and talabat_reason in ("Lack of Delivery Men") and stage not in ('CONFIRMATION','PREPARATION',"DELIVERY") 
    then'GP18_violated'

--Group19 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Unprofessional Behavior from Rider") and stage not in ('PREPARATION',"DELIVERY","POST_DELIVERY") then'GP19_violated'
--Group19 Food
     when v.vertical = 'food' and talabat_reason in ("Electricity Issue") and (v.vertical_class ='non-food' and v.sub_vertical ='darkstore')
    then'GP19_violated'
--Group20 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("tMart NO pickers") and not a.is_tgo then  'GP20_violated'   
     when v.vertical <<>> 'food' and  talabat_reason in ("tMart NO pickers") and v.sub_vertical <<>> 'darkstore' then 'GP20_violated'
--Group 20 Food 
     when v.vertical = 'food' and talabat_reason in ("tMart NO pickers") 
     or (not a.is_tgo) then'GP20_violated'
--Group21 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("Tlb system shows discripency in PDT") and not a.is_tgo then'GP21_violated'
--Group21 Food 
     when v.vertical = 'food' and  talabat_reason in ("Tlb system shows discripency in PDT") and not a.is_tgo
    then'GP21_violated'
--Group22 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("Order Picked-up/ delivered by another rider") and not a.is_tgo then'GP22_violated' 
     when v.vertical <<>> 'food' and  talabat_reason in ("Order Picked-up/ delivered by another rider") and stage not in ('PREPARATION',"DELIVERY") then'GP22_violated'
--Group22 Food 
     when v.vertical = 'food' and talabat_reason in ("Order Picked-up/ delivered by another rider") and (stage not in ('PREPARATION',"DELIVERY") or not a.is_tgo) then'GP22_violated' 
     else "No Violation"  end as vaiolation_type,


  FROM
    `tlb-data-prod.data_platform.fct_order_info` a
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_order_fail_reason` f
  ON
    a.order_fail_reason_id=f.order_fail_reason_id
  left join `tlb-data-prod.data_platform.dim_order_status` s on s.order_status_id = a.order_status_id
  left join `tlb-data-prod.data_platform.dim_vertical` v on v.vertical_id = a.vertical_id
  left join `tlb-data-prod.data_platform.dim_employee` e on e.employee_id=a.cancellation_agent_employee_id
  left join `tlb-data-prod.data_platform_google_sheet.Active_inhouse` ai on e.email=ai.Business_Email
  left join prefinal p on safe_cast(a.order_id as string)=p.order_id
  WHERE a.order_date >>= '2024-01-01'
  and a.order_date << current_date()
  and not is_successful 
  and a.cancellation_agent_employee_id <<>> -9999
  and a.delivery_arrangement in ("TGO","PICKUP")
  and p.order_id is null
  --and a.order_id=1707506291]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1c5e6ng0twzy0p1g0fkwd00t8p11' name='Custom SQL Query' type='text'><![CDATA[with
base as
(
SELECT
order_id
,action
,datetime(substr(created_on,1,19)) as date_time
,i.email
,reason_text
,Job_Title
,department_group
,is_agent
,contract_type
,i.description
FROM `tlb-data-prod.data_platform.order_activity_log` i
left join `tlb-data-prod.data_platform.dim_employee` u  on lower(i.email) = lower(u.email) and is_current_email_owner
WHERE action = 'CANCEL_ORDER'  
and DATE(_PARTITIONTIME) >>= '2024-01-01'
 and DATE(_PARTITIONTIME) <<  '2024-08-15'
and created_on is not null
--and i.email is not null
-- and order_id not in 
--   (
--   SELECT
--   order_id
--   FROM `tlb-data-prod.data_platform.order_activity_log` 
--   WHERE action = 'MARK_ORDER_AS_SUCCESSFUL' 
--   and DATE(_PARTITIONTIME) >>= '2024-01-01'
--   and DATE(_PARTITIONTIME) <<  current_date()
--   and created_on is not null
--   group by 1
--   )
), 

cancelled_min as 
(
SELECT
order_id
,(action) action
,(date_time ) as date_time
,(email) email
,(department_group)Department_group--,min(agent_dept) agent_dept
,(contract_type) Bpo
,(Job_Title) Job_Title
,(reason_text) reason_text
,(is_agent)is_agent
,(description)description
,rank() over(partition by order_id,action order by date_time) as rank 
FROM base
qualify rank=1
),
cancelled_max as 
(
SELECT
order_id
,(action) action
,(date_time ) date_time
,(email) email
,(reason_text) reason_text
,(department_group)Department_group
,(contract_type) Bpo
,(Job_Title) Job_Title
,(is_agent)is_agent
,rank() over(partition by order_id,action order by date_time desc) as rank 
FROM base
where email is not null 
qualify rank=1
),

change_reason as
(
select 
c.order_id
,c.email           as action_taker1_email
,m.email           as action_taker2_email
,c.Department_group     as action_taker1_dpt
,m.Department_group     as action_taker2_dpt
,c.Job_Title      as action_taker1_title
,m.Job_Title      as action_taker2_title
,c.Bpo      as action_taker1_lob
,m.Bpo      as action_taker2_lob
,case when c.reason_text=""then REGEXP_SUBSTR(description,"Reason:(.*)") else c.reason_text end  as reason_text1
,m.reason_text     as reason_text2
,c.date_time       as action1_time
,m.date_time       as action2_time
,c.action          as action1
,m.action          as action2
,c.is_agent       as is_agent1
,m.is_agent       as is_agent2
,datetime_diff(m.date_time,c.date_time,DAY) as change_action_diff_in_days
from cancelled_min c
inner join cancelled_max m on c.order_id = m.order_id and c.date_time << m.date_time --and c.reason_text <<>> m.reason_text
),

prefinal as
(
select 
i.order_id
,order_date
,a.country_iso as country
-- ,i.action_taker1_email
-- ,i.action_taker2_email
-- ,i.action_taker1_dpt
-- ,i.action_taker2_dpt
-- ,i.action_taker1_title
-- ,i.action_taker2_title
-- ,i.action_taker1_lob
-- ,i.action_taker2_lob
-- ,i.reason_text1
-- ,i.reason_text2
-- ,i.action1_time
-- ,i.action2_time
-- ,i.action1
-- ,i.action2
-- ,i.is_agent1
-- ,i.is_agent2
-- ,case when v.vertical_class='non-food' and v.sub_vertical ='darkstore' then 'Tmart' else v.vertical_class end vertical
-- ,case when a.is_online_payment then 'online' else 'cash'end as payment_method
-- ,case when a.is_tgo then 'TGO' else 'TMP'end as delivery_method
-- ,a.gmv_amount_eur as order_gmv_eur
-- ,case when i.action1 = i.action2 then 'change_cancellation_reason' end as reconciliation_action 
-- ,s.status
-- ,f.owner
-- ,a.order_time
-- ,a.basket_amount_eur
-- ,safe_cast(a.order_time_utc as datetime)order_time_utc
--,f.stage
from change_reason i
left join `tlb-data-prod.data_platform.fct_order_info` a on cast(a.order_id as string) = i.order_id and order_date >>= '2024-01-01' and order_date << '2024-08-15'
left join `tlb-data-prod.data_platform.dim_vertical` v on v.vertical_id = a.vertical_id
left join `tlb-data-prod.data_platform.dim_order_status`s on a.order_status_id=s.order_status_id
LEFT JOIN
    `tlb-data-prod.data_platform.dim_order_fail_reason` f
  ON
    a.order_fail_reason_id=f.order_fail_reason_id
    where 
   a.delivery_arrangement in ("TGO","PICKUP")
)

--New cancellation Rules based on sheet shared from Shaimaa------
--- applying Rules for QC ------------

select 
a.order_date,
  country_iso as country,
  a.order_id,
  talabat_reason,
  delivery_arrangement as delivery_method,
  v.vertical_class Food_Non_Food,
  case when v.vertical_class='non-food' and v.sub_vertical ='darkstore' then 'Tmart' else v.vertical end Vertical_Class,
  v.sub_vertical,
  case when a.is_online_payment then 'OP' else 'COD' end payment_method,
  gmv_amount_eur,
  owner as cancellation_owner,
  STAGE as cancellation_stage,
  source as cancellation_source,
  a.is_tgo,
  a.cancellation_agent_employee_id,
  e.email as agent_email,
  e.department_group,
  e.department,
  case when e.email in("muhamad.abdulrahman.ps5_exjo.ext@talabat.com"
,"lanya.azad.3_exjo.ext@talabat.com") then "Talabat BPO - Extensya" else e.contract_type end as contract_type ,
  e.line_of_business,
  case when ai.country_Q='resturant care' then 'resturant care' else e.sub_line_of_business end sub_line_of_business ,
  e.is_agent,
  case when e.department_group="Logistics-Dispatching" then "Logistics-Dispatching"
       when ai.country_Q='resturant care' then "Partner Care"
       when ai.country_Q="Payment Reconciliation" then "Partner Care"
  else e.line_of_business end as SSC_dep
--Group1 QC
,  case 
    when v.vertical <<>> 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) and stage <<>>'DELIVERY' then 'GP1_violated'
    when v.vertical <<>> 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) and a.is_online_payment and country_iso in("AE","JO","IQ") 
     then'GP1_violated'
--Group1 Food
    when v.vertical = 'food' and talabat_reason in ('CST - Refuse to receive the order',"CST - doesn't response" ) 
    and (stage<<>>'DELIVERY' or (a.is_online_payment and country_iso in("AE","JO") )) then'GP1_violated'
--Group2 dropped for QC------
--Group2 Food 
    when v.vertical = 'food' and talabat_reason in ("CST - Didn't show up for Pickup Order") and delivery_arrangement<<>>"PICKUP"
    then 'GP2_violated'
--Group3 QC
    when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to confirm cash order") and (stage not in ('CONFIRMATION','PREPARATION') or a.is_online_payment) then 'GP3_violated'
    when v.vertical <<>> 'food' and talabat_reason in ("CST - forget to add a voucher") and stage not in ('CONFIRMATION','PREPARATION') then 'GP3_violated'
--Group 3 Food
    when v.vertical = 'food' and talabat_reason in ("CST - Unable to confirm cash order") and (stage not in ('CONFIRMATION') or a.is_online_payment)
    then 'GP3_violated'
    when v.vertical = 'food' and talabat_reason in ("CST - forget to add a voucher") and (stage not in ('CONFIRMATION') )
    then 'GP3_violated'
--Group4 QC 
    when v.vertical <<>> 'food' and talabat_reason in ("Fraud Customer") and (ai.country_Q<<>>"SWAT" or e.email not in ('msaeedhussien@talabat.com','ahmed.n.2@talabat.com'
          ,'mohamed.khoder@talabat.com','nader.ahmed@talabat.com','eman.elemam@talabat.com','mostafa.hamza@talabat.com','mohamed.nasser@talabat.com','abdullah.metwally@talabat.com'))
     then'GP4_violated'
--Group4 Food
     when v.vertical = 'food' and talabat_reason in ("Fraud Customer") and (ai.country_Q<<>>"SWAT" or e.email not in ('msaeedhussien@talabat.com',
'ahmed.n.2@talabat.com',
'mohamed.khoder@talabat.com',
'nader.ahmed@talabat.com',
'eman.elemam@talabat.com',
'mostafa.hamza@talabat.com',
'mohamed.nasser@talabat.com',
'abdullah.metwally@talabat.com'))
  then'GP4_violated'
--Group5 QC
     when v.vertical <<>> 'food' and talabat_reason in
      ("CST - Change Vendor/ item","CST - Change Payment Method"
      ,"CST - Refuse to provide a reason"
      ,"CST - has an Emergency"
    ,"CST - request with extra charge"
    ,"CST - Change Delivery Details" ) and stage not in ('CONFIRMATION','PREPARATION') then'GP5_violated'
--Group5 Food
     when vertical="food" and talabat_reason in (
    "CST - Change Vendor/ item"
    ,"CST - Change Payment Method"
    ,"CST - Refuse to provide a reason"
    ,"CST - has an Emergency"
    ,"CST - request with extra charge") and (stage not in ('CONFIRMATION') )
    then'GP5_violated'

     when vertical="food" and talabat_reason in (
    "CST - Change Delivery Details") and ((stage not in ('CONFIRMATION') ) and delivery_arrangement="TGO")
     then'GP5_violated'
--Group 6 QC
    
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay")  and a.is_online_payment then 'GP6_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay")  and e.department_group <<>> "Logistics-Dispatching"  
     and stage not in ('CONFIRMATION','PREPARATION' ) then 'GP6_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Unable to pay") and e.department_group = "Logistics-Dispatching"  and stage <<>> 'DELIVERY' then 'GP6_violated'
--Group6 Food
     when v.vertical = 'food' and talabat_reason in ("CST - Unable to pay") and (stage not in ('CONFIRMATION') or a.is_online_payment)
     then'GP6_violated'
--Group7 QC
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Duplicate Order") and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY',"POST_DELIVERY")       
     then'GP7_violated'
--Group7 Food 
     when v.vertical = 'food' and talabat_reason in ("CST - Duplicate Order") and Stage not in('CONFIRMATION','PREPARATION','DELIVERY')
    then'GP7_violated'
--Group8 QC
     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address") 
     and e.department_group<<>>"Logistics-Dispatching" and stage not in ('CONFIRMATION','PREPARATION',"POST_DELIVERY")  then'GP8_violated' 

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address") and country_iso in("JO","EG") and stage="POST_DELIVERY" then'GP8_violated'

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Incomplete/Wrong Address")  and e.department_group="Logistics-Dispatching" and stage <<>> 'DELIVERY' then'GP8_violated'


     when v.vertical <<>> 'food' and talabat_reason in ("CST - Fake order") and e.department_group<<>>"Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION') then'GP8_violated'

     when v.vertical <<>> 'food' and talabat_reason in ("CST - Fake order") and e.department_group="Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
     
     then'GP8_violated'
--Group8 Food 
     when v.vertical = 'food' and talabat_reason in ("CST - Incomplete/Wrong Address")  and e.department_group<<>>"Logistics-Dispatching" and (stage not in ('CONFIRMATION') or vertical<<>>"food") 
      OR talabat_reason in ("CST - Incomplete/Wrong Address") and (e.department_group="Logistics-Dispatching" and (stage not in ('DELIVERY')))
    then'GP8_violated'
    when v.vertical = 'food' and talabat_reason in ("CST - Fake order") and (stage not in ('CONFIRMATION') or vertical<<>>"food") 
    --and e.department_group<<>>"Logistics-Dispatching"
    then'GP8_violated'
--Group9 QC
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Accident','Rider unreachable','Rider Refuse to deliver','Preparation Delay') and not a.is_tgo then 'GP9_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Accident','Rider unreachable') and stage <<>> 'DELIVERY' then 'GP9_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Rider Refuse to deliver','Preparation Delay') and stage not in ('DELIVERY','PREPARATION') then 'GP9_violated'
--Group9 Food 
     when v.vertical = 'food' and talabat_reason in ('Rider Accident','Rider unreachable') and (stage<<>>'DELIVERY' or not a.is_tgo)
    then 'GP9_violated'
    when v.vertical = 'food' and talabat_reason in ('Rider Refuse to deliver','Preparation Delay') and (stage not in ('DELIVERY','PREPARATION') or not a.is_tgo)
    then 'GP9_violated'
--Group10 QC
     when v.vertical <<>> 'food' and talabat_reason in ('Bad Weather') and Stage not in('CONFIRMATION','PREPARATION','DELIVERY') then 'GP10_violated'
     when v.vertical <<>> 'food' and talabat_reason in ('Late Delivery') and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY') then 'GP10_violated'  
--Group 10 Food 
     when v.vertical = 'food' and talabat_reason in ('Bad Weather') and Stage not in('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP10_violated'
     when v.vertical = 'food' and talabat_reason in ('Late Delivery') and Stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP10_violated' 
--Group11 QC
      
     when v.vertical <<>> 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and delivery_arrangement <<>> "PICKUP" then 'GP11_violated'
     when  v.vertical <<>> 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and  stage <<>>'DELIVERY' then 'GP11_violated'
--Group 11 Food
     when v.vertical = 'food' and talabat_reason in ("Delay in prepare Pickup order" ) and (stage<<>>'DELIVERY' or  vertical<<>>"food"  or delivery_arrangement<<>>"PICKUP")
    then 'GP11_violated'

--Group12 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" ) and delivery_arrangement not in ("TGO","PICKUP" ) then 'GP12_violated' 
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" )  and v.sub_vertical ='darkstore' then 'GP12_violated'  
     when v.vertical <<>> 'food' and talabat_reason in ("Ven Incorrect Location" ) and stage not in ('DELIVERY','PREPARATION') then 'GP12_violated'
-- Group 12 Food 
     when v.vertical = 'food' and talabat_reason in ("Ven Incorrect Location" ) and (stage not in ('DELIVERY','PREPARATION') or delivery_arrangement not in ("TGO","PICKUP" ))then 'GP12_violated'
 
--Group13    QC 
     when v.vertical <<>> 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") and v.sub_vertical ='darkstore' then 'GP13_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") and stage not in ('CONFIRMATION','PREPARATION') then 'GP13_violated'

--Group13 Food
     when v.vertical = 'food' and talabat_reason in ("Blacklisted Customer","internet issue","Kitchen Issue","Ven - don't work with Talabat","Ven refuse discount","Ven Closed","Vendor is too busy") 
    and (stage not in ('CONFIRMATION','PREPARATION'))
    then 'GP13_violated'

--Group14 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Unavailable Menu item","Ven - uncontactable","Ven - Refuse to prepare Order") 
    and stage not in ('CONFIRMATION','PREPARATION') then 'GP14_violated'

   when v.vertical <<>> 'food' and talabat_reason in ("Tlb - System Issue") and e.department_group<<>>"Logistics-Dispatching" 
    and stage not in ('CONFIRMATION','PREPARATION') 
    then 'GP14_violated'

    when v.vertical <<>> 'food' and talabat_reason in ("Tlb - System Issue") and e.department_group="Logistics-Dispatching" 
     and stage not in ('CONFIRMATION','PREPARATION','DELIVERY')
    then 'GP14_violated'

--group14 Food
     when v.vertical = 'food' and talabat_reason in ("Unavailable Menu item","Ven - uncontactable","Ven - Refuse to prepare Order","Tlb - System Issue") 
    and stage not in ('CONFIRMATION','PREPARATION')
    then 'GP14_violated'
--Group15 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
     and delivery_arrangement not in ("TGO","PICKUP" ) then 'GP15_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") and v.sub_vertical ='darkstore' then 'GP15_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
     and stage not in ('CONFIRMATION','PREPARATION') then 'GP15_violated'
--Group15 Food
     when v.vertical = 'food' and talabat_reason in ("Ven - Min order value unreached","Ven - don't deliver to this area") 
    and (stage not in ('CONFIRMATION','PREPARATION') or a.is_tgo )
    then 'GP15_violated'
--Group16QC
  when v.vertical <<>> 'food' and talabat_reason in ("Ven - Ignored Special Request","Food is inedible")  
  and stage not in ("POST_DELIVERY") then 'GP16_violated'

  when v.vertical <<>> 'food' and talabat_reason in ("Ven - Content Discrepancy") and stage not in ('POST_DELIVERY','DELIVERY','PREPARATION') then 'GP16_violated' --modified
  
     when v.vertical <<>> 'food' and talabat_reason in ("Spilt/ damaged Order","Ven Wrong Order")  and stage not in ('DELIVERY',"POST_DELIVERY") then 'GP16_violated'
--Group16 Food 
     when v.vertical = 'food' and talabat_reason in ("Ven - Content Discrepancy","Ven - Ignored Special Request","Food is inedible ") 
    and stage not in ("POST_DELIVERY")
    then 'GP16_violated'
    when v.vertical = 'food' and talabat_reason in ("Spilt/ damaged Order","Ven Wrong Order") 
    and stage not in ('DELIVERY',"POST_DELIVERY")
    then 'GP16_violated'
--Group17 QC   
     when v.vertical <<>> 'food' and talabat_reason in ("Rider mixed up orders") and not a.is_tgo then 'GP17_violated'
     when v.vertical <<>> 'food' and talabat_reason in ("Rider mixed up orders") and stage not in ('DELIVERY',"POST_DELIVERY") then 'GP17_violated'
--Group 17 Food 
     when v.vertical = 'food' and talabat_reason in ("Rider mixed up orders") 
    and (stage not in ('DELIVERY',"POST_DELIVERY") or not a.is_tgo)
    then 'GP17_violated'

--Group18 QC
    
     when v.vertical <<>> 'food' and  talabat_reason in ("Ven - System/ Device Issue") and stage not in ('CONFIRMATION','PREPARATION') 
    then'GP18_violated'
     when v.vertical <<>> 'food' and  talabat_reason in ("Lack of Delivery Men") and stage not in ('CONFIRMATION','PREPARATION',"DELIVERY") 
    then'GP18_violated'
--Group 18 Food
     when v.vertical = 'food' and talabat_reason in ("Unprofessional Behavior from Rider") and stage not in ('PREPARATION',"DELIVERY","POST_DELIVERY") 
    then'GP18_violated'
    when v.vertical = 'food' and talabat_reason in ("Ven - System/ Device Issue") and stage not in ('CONFIRMATION','PREPARATION') 
    then'GP18_violated'
    when v.vertical = 'food' and talabat_reason in ("Lack of Delivery Men") and stage not in ('CONFIRMATION','PREPARATION',"DELIVERY") 
    then'GP18_violated'

--Group19 QC
     when v.vertical <<>> 'food' and talabat_reason in ("Unprofessional Behavior from Rider") and stage not in ('PREPARATION',"DELIVERY","POST_DELIVERY") then'GP19_violated'
--Group19 Food
     when v.vertical = 'food' and talabat_reason in ("Electricity Issue") and (v.vertical_class ='non-food' and v.sub_vertical ='darkstore')
    then'GP19_violated'
--Group20 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("tMart NO pickers") and not a.is_tgo then  'GP20_violated'   
     when v.vertical <<>> 'food' and  talabat_reason in ("tMart NO pickers") and v.sub_vertical <<>> 'darkstore' then 'GP20_violated'
--Group 20 Food 
     when v.vertical = 'food' and talabat_reason in ("tMart NO pickers") 
     or (not a.is_tgo) then'GP20_violated'
--Group21 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("Tlb system shows discripency in PDT") and not a.is_tgo then'GP21_violated'
--Group21 Food 
     when v.vertical = 'food' and  talabat_reason in ("Tlb system shows discripency in PDT") and not a.is_tgo
    then'GP21_violated'
--Group22 QC
     when v.vertical <<>> 'food' and  talabat_reason in ("Order Picked-up/ delivered by another rider") and not a.is_tgo then'GP22_violated' 
     when v.vertical <<>> 'food' and  talabat_reason in ("Order Picked-up/ delivered by another rider") and stage not in ('PREPARATION',"DELIVERY") then'GP22_violated'
--Group22 Food 
     when v.vertical = 'food' and talabat_reason in ("Order Picked-up/ delivered by another rider") and (stage not in ('PREPARATION',"DELIVERY") or not a.is_tgo) then'GP22_violated' 
     else "No Violation"  end as vaiolation_type,


  FROM
    `tlb-data-prod.data_platform.fct_order_info` a
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_order_fail_reason` f
  ON
    a.order_fail_reason_id=f.order_fail_reason_id
  left join `tlb-data-prod.data_platform.dim_order_status` s on s.order_status_id = a.order_status_id
  left join `tlb-data-prod.data_platform.dim_vertical` v on v.vertical_id = a.vertical_id
  left join `tlb-data-prod.data_platform.dim_employee` e on e.employee_id=a.cancellation_agent_employee_id
  left join `tlb-data-prod.data_platform_google_sheet.Active_inhouse` ai on e.email=ai.Business_Email
  left join prefinal p on safe_cast(a.order_id as string)=p.order_id
  WHERE a.order_date >>= '2024-01-01'
  and a.order_date << current_date()
  and not is_successful 
  and a.cancellation_agent_employee_id <<>> -9999
  and a.delivery_arrangement in ("TGO","PICKUP")
  and p.order_id is null
  --and a.order_id=1707506291]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>order_date</remote-name>
