            <column datatype='string' name='[sub_line_of_business (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[sub_line_of_business]' new-bin='true'>
                <bin default-name='false' value='&quot;Logistics-Dispatching&quot;'>
