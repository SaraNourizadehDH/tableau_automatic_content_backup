            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='sara.ali@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0i4v13p13r8vlo187cwmy1tu20la' name='Custom SQL Query' type='text'><![CDATA[select 
o.order_date
,country_iso as country
,case when o.is_online_payment then 'online' else 'cash' end as payment_method
,count(distinct o.order_id) total_orders
,count(distinct o.account_id) accounts
,count(distinct case when not is_successful then o.order_id end) as failed_orders 
,count(distinct case when not is_successful and is_net then  o.order_id  end ) net_failed_orders
,count(distinct case when is_successful then  o.order_id   end) as successful_orders 
,count(distinct case when not is_abandoned then  o.order_id  end ) as gross_orders
,count(distinct case when is_net then  o.order_id  end ) net_orders
from `tlb-data-prod.data_platform.fct_order_info` o
left join `tlb-data-prod.data_platform.dim_order_fail_reason` f on f.order_fail_reason_id = o.order_fail_reason_id 
left join `tlb-data-prod.data_platform.dim_order_status` s on s.order_status_id = o.order_status_id
where o.order_date >>= '2023-09-01'
  and o.order_date << current_date()
group by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0i4v13p13r8vlo187cwmy1tu20la' name='Custom SQL Query' type='text'><![CDATA[select 
o.order_date
