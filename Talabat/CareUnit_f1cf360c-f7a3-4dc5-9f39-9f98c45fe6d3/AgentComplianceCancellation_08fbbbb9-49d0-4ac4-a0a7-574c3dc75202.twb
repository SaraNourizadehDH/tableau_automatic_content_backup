            <column-instance column='[talabat_reason]' derivation='None' name='[none:talabat_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[vaiolation_type]' derivation='None' name='[none:vaiolation_type:nk]' pivot='key' type='nominal' />
