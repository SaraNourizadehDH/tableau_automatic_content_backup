    <worksheet name='Violation trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#555555' fontsize='12'>Adherance with Cancellation Trend</run>
            <run bold='true' fontcolor='#555555' fontsize='9'>(by agent)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/AgentsViolationsTrackingtestingphaseQCRules/Violationtrend?rev=' id='Violationtrend' path='/t/Talabat/workbooks/AgentsViolationsTrackingtestingphaseQCRules' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='agent violation' name='federated.0n6ru2x0yki4cp1h6z3lm1ymwvdn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n6ru2x0yki4cp1h6z3lm1ymwvdn'>
            <column caption='Cancelled Orders' datatype='integer' name='[Calculation_1791940119450226688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='is_violation ' datatype='boolean' name='[Calculation_1791940119457267713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vaiolation_type (group)]= &quot;Vaiolations&quot; then TRUE else false end' />
            </column>
            <column caption='Violated orders' datatype='integer' name='[Calculation_1791940119459291138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if[Calculation_1791940119457267713] = true then [order_id] end)' />
            </column>
            <column caption='Violation Rate' datatype='real' name='[Calculation_1791940119486521347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1791940119459291138]/COUNTD([order_id])' />
            </column>
            <column caption='Date Granularity' datatype='date' name='[Calculation_1791940119487496196]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parameter 1],[order_date]))' />
            </column>
            <column caption='Reasons Policy Type' datatype='string' name='[Calculation_5273292956587442177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [talabat_reason] in (&#10;&quot;CST - Fake order&quot;,&#10;&quot;Fake Order&quot;,&#10;&quot;CST - Refuse to receive the order&quot;,&#10;&quot;CST - Refuse to provide a reason&quot;,&#10;&quot;Fraud Customer&quot;,&#10;&quot;CST - Incomplete/Wrong Address&quot;,&#10;&quot;Incomplete / Wrong Address&quot;,&#10;&quot;No response from the customer (Upon DeliveCST - doesn&apos;t responsery)&quot;,&#10;&quot;No response from the customer (Upon Delivery)&quot;,&#10;&quot;CST - Didn&apos;t show up for Pickup Order&quot;,&#10;&quot;CST - Unable to confirm cash order&quot;,&#10;&quot;Order modification not possible or extra charge&quot;,&#10;&quot;CST - Change Vendor/ item&quot;,&#10;&quot;CST - Change Delivery Details&quot;,&#10;&quot;CST - Change Payment Method&quot;,&#10;&quot;Card Reader not available&quot;,&#10;&quot;CST - has an Emergency&quot;,&#10;&quot;CST - Duplicate Order&quot;,&#10;&quot;CST - doesn&apos;t response&quot;,&#10;&quot;CST - forget to add a voucher&quot;&#10;) then &quot;Customer Leakage Reasons&quot; else &quot;Other Reasons&quot; end' />
            </column>
            <column caption='Reasons GP' datatype='string' name='[Calculation_6882837276462604288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [talabat_reason] in (&apos;CST - Refuse to receive the order&apos;,&quot;CST - doesn&apos;t response&quot; ) then &quot;GP-1&quot;&#10;ELSEIF [talabat_reason] in (&quot;CST - Didn&apos;t show up for Pickup Order&quot;) then &quot;GP-2&quot;&#10;ELSEIF [talabat_reason] in (&quot;CST - Unable to confirm cash order&quot;,&quot;CST - forget to add a voucher&quot;) then &quot;GP-3&quot;&#10;ELSEIF [talabat_reason] in (&quot;Fraud Customer&quot;)  then &quot;GP-4&quot;&#10;ELSEIF [talabat_reason] in (&#10;    &quot;CST - Change Delivery Details&quot;,&#10;    &quot;CST - Change Vendor/ item&quot;&#10;    ,&quot;CST - Change Payment Method&quot;&#10;    ,&quot;CST - Refuse to provide a reason&quot;&#10;    ,&quot;CST - has an Emergency&quot;&#10;    ,&quot;CST - request with extra charge&quot;) then &quot;GP-5&quot;&#10;ELSEIF [talabat_reason] in (&quot;CST - Unable to pay&quot;) then &quot;GP-6&quot;&#10;ELSEIF [talabat_reason] in (&quot;CST - Duplicate Order&quot;) then &quot;GP-7&quot;&#10;ELSEIF [talabat_reason] in (&quot;CST - Incomplete/Wrong Address&quot;,&quot;CST - Fake order&quot;) &#10;then &quot;GP-8&quot;&#10;ELSEIF [talabat_reason] in (&apos;Rider Accident&apos;,&apos;Rider unreachable&apos;,&apos;Rider Refuse to deliver&apos;,&apos;Preparation Delay&apos;) then &quot;GP-9&quot;&#10;ELSEIF [talabat_reason] in (&apos;Bad weather&apos;,&apos;Late Delivery&apos;) then &quot;GP-10&quot;&#10;ELSEIF [talabat_reason] in (&quot;Delay in prepare Pickup order&quot; ) then &quot;GP-11&quot;&#10;ELSEIF [talabat_reason] in (&quot;Ven Incorrect Location&quot; ) then &quot;GP-12&quot;&#10;ELSEIF [talabat_reason] in (&quot;Blacklisted Customer&quot;,&quot;internet issue&quot;,&quot;Kitchen Issue&quot;,&quot;Ven - don&apos;t work with Talabat&quot;,&quot;Ven refuse discount&quot;,&quot;Ven Closed&quot;,&quot;Vendor is too busy&quot;) then &quot;GP-13&quot;&#10;ELSEIF [talabat_reason] in (&quot;Unavailable Menu item&quot;,&quot;Ven - uncontactable&quot;,&quot;Ven - Refuse to prepare Order&quot;,&quot;Tlb - System Issue&quot;) then &quot;GP-14&quot;&#10;ELSEIF [talabat_reason] in (&quot;Ven - Min order value unreached&quot;,&quot;Ven - don&apos;t deliver to this area&quot;) then &quot;GP-15&quot;&#10;ELSEIF [talabat_reason] in (&quot;Spilt/ damaged Order&quot;,&quot;Ven Wrong Order&quot;,&quot;Ven - Content Discrepancy&quot;,&quot;Ven - Ignored Special Request&quot;,&quot;Food is inedible &quot;)  then &quot;GP-16&quot;&#10;ELSEIF [talabat_reason] in (&quot;Rider mixed up orders&quot;)  then &quot;GP-17&quot;&#10;ELSEIF [talabat_reason] in (&quot;Unprofessional Behavior from Rider&quot;) then &quot;GP-19&quot;&#10;ELSEIF [talabat_reason] in (&quot;Electricity Issue&quot;) then &quot;GP-20&quot;&#10;ELSEIF [talabat_reason] in (&quot;tMart NO pickers&quot;) then &quot;GP-21&quot;&#10;ELSEIF [talabat_reason] in (&quot;Tlb system shows discripency in PDT&quot;) then &quot;GP-22&quot;&#10;ELSEIF [talabat_reason] in (&quot;Order Picked-up/ delivered by another rider&quot;) then &quot;GP-23&quot;&#10;END' />
            </column>
            <column caption='Food_Non_Food (copy)' datatype='string' name='[Food_Non_Food (copy)_3785275541301985280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Food_Non_Food]' />
            </column>
            <column datatype='string' name='[Food_Non_Food]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[SSC_dep (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[SSC_dep]' new-bin='true'>
                <bin default-name='false' value='&quot;Customer Care&quot;'>
                  <value>&quot;Customer care&quot;</value>
                  <value>&quot;Customer Care&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Logistics-Dispatching&quot;'>
                  <value>&quot;Logistics&quot;</value>
                  <value>&quot;Logistics-Dispatching&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Partner Care&quot;'>
                  <value>&quot;Partner care&quot;</value>
                  <value>&quot;Partner Care&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[SSC_dep]' role='dimension' type='nominal' />
            <column datatype='string' name='[Vertical_Class]' role='dimension' type='nominal' />
            <column caption='no Violated orders' datatype='integer' name='[Violated orders (copy)_1791940119488339973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if[Calculation_1791940119457267713] = false then [order_id] end)' />
            </column>
            <column datatype='string' datatype-customized='true' name='[agent_email]' role='dimension' type='nominal' />
            <column datatype='string' name='[cancellation_stage]' role='dimension' type='nominal' />
            <column caption='Site' datatype='string' name='[contract_type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[contract_type]' new-bin='true'>
                <bin default-name='false' value='&quot;Inhouse&quot;'>
                  <value>&quot;Delivery Hero - Egypt SAE&quot;</value>
                  <value>&quot;Delivery Hero Talabat DB LLC&quot;</value>
                  <value>&quot;DH Stores Bahrain W.L.L&quot;</value>
                  <value>&quot;Foodonclick.com&quot;</value>
                  <value>&quot;Inhouse&quot;</value>
                  <value>&quot;Jordanian Stores Company for general Trading LLC&quot;</value>
                  <value>&quot;Store Services Co. Kuwait&quot;</value>
                  <value>&quot;Talabat Electronic &amp; Delivery Services LLC&quot;</value>
                  <value>&quot;Talabat for General Trading and Electronic Commerce Ltd&quot;</value>
                  <value>&quot;Talabat General Trading and Contracting Company WLL&quot;</value>
                  <value>&quot;Talabat QFC LLC&quot;</value>
                  <value>&quot;Talabat Services Company W.L.L&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[contract_type]' role='dimension' type='nominal' />
