      <column caption='Fail Rate%' datatype='real' name='[Calculation_1434396533862428672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
      </column>
      <column caption='Reachability %' datatype='real' name='[Calculation_5812669399223132160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([answered])/sum([trials])' />
      </column>
      <column caption='Failure Ratio' datatype='real' name='[Calculation_5812669399228129281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed])/SUM([trials])' />
      </column>
