      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0re435j0r9a9mn12psn8i032ty5v].[sum:sum:qk]&quot;' value='Total Orders' />
