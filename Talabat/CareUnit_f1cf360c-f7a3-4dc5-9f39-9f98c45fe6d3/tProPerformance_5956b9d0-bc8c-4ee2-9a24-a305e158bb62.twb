      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.17nybqa050cshe17jbbrn1vropvi].[sum:Customer_total_chats:qk]&quot;' value='Chats #' />
