      <column caption='Total orders' datatype='integer' name='[Calculation_510877119135330304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])+SUM([successful_orders])' />
      </column>
      <column caption='FR%' datatype='real' name='[Calculation_510877119135842306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/(SUM([failed_orders])+SUM([successful_orders]))' />
      </column>
      <column caption='Net FR%' datatype='real' name='[Calculation_510877119136223235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_failed_orders])/SUM([net_total_orders])' />
      </column>
      <column caption='CR%' datatype='real' name='[Calculation_510877119136432132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Customer_total_chats])/(SUM([failed_orders])+SUM([successful_orders]))' />
      </column>
      <column caption='CSAT%' datatype='real' name='[Calculation_510877119137742853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Customer_csat_top2_count])/SUM([Customer_csat_survey_count])' />
      </column>
