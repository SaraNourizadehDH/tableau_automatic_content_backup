                <zone fixed-size='191' forceUpdate='true' h='14801' id='103' type-v2='text' w='13584' x='78' y='20161'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Notes </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontname='Tableau Light'>The values for each KPI represent </run>
                    <run bold='true' fontname='Tableau Light'>yesterday&apos;s</run>
                    <run fontname='Tableau Light'> value.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontname='Tableau Light'>The delta is </run>
                    <run bold='true' fontname='Tableau Light'>WoW</run>
                    <run fontname='Tableau Light'> differnce, compared based on the </run>
                    <run bold='true' fontname='Tableau Light'>Yesterday</run>
                    <run fontname='Tableau Light'> to last week </run>
                    <run bold='true' fontname='Tableau Light'>same day</run>
                    <run fontcolor='#898989' fontname='Tableau Light' fontsize='8'> (e.x Tue 18th Oct and Tue 11th Oct)</run>
                    <run bold='true' fontname='Tableau Light'> .</run>
                  </formatted-text>
