                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' fixed-size='51' h='3476' id='1344' mode='compact' param='[Parameters].[Parameter 6]' type-v2='paramctrl' w='12226' x='19592' y='6056'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ff5a00'>Baseline Orders</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8328' id='1347' type-v2='text' w='30564' x='31818' y='6056'>
                  <formatted-text>
                    <run fontname='Tableau Book'> Select your Dashboard configrution </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'> If you need your basline orders to be Gross orders set baseline to gross order </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'> If you need it to be net order  set baseline to net order </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'> all calculation related to order base will be based on your selection </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' h='6676' id='1433' mode='type_in' param='[Parameters].[Parameter 9]' type-v2='paramctrl' w='12226' x='19592' y='14384'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ff5a00'>Cost Per Contact</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6676' id='1434' type-v2='text' w='30564' x='31818' y='14384'>
                  <formatted-text>
                    <run fontname='Tableau Book'>Select your Avg Cost per contact based on your setup</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'>customer cost per contact =1.14 (online cases)</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'>Partner </run>
                    <run fontname='Tableau Book'>cost per contact =0.92 </run>
                    <run fontname='Tableau Book'>(online cases)</run>
                    <run fontname='Tableau Book'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Book'>All offline Cases cost per contact = 3</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='32' forceUpdate='true' h='2753' id='742' type-v2='text' w='81348' x='17868' y='21748'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Dimensions  Definition </run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='289' forceUpdate='true' h='20441' id='695' type-v2='text' w='81348' x='17868' y='24501'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Stakeholder</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>It defines who generated/started the contact (Customer, Rider, Vendor...etc)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Channel</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The origin/source of the contact (Chat, Call, Email, .. etc.)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Delivery Method</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>Orders delivery method (TGO, TMP, Pick-Up) </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Contact Ownership:  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>Showing who was responsible to get this contact generated based on a combination between the contact reason and delivery method. Currently, we defined only vendor ownership with the help of the sales team. All the reasons are mentioned in the below link</run>
                    <run>Æ&#10;&#10;</run>
                    <run auto-url='true' fontcolor='#000000' fontname='Tableau Light' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1TNm2hHnDJpB_bKdl1XBNGvf581-eExzGJPBNq2oyRL0/edit#gid=705210583&amp;quot;'>https://docs.google.com/spreadsheets/d/1TNm2hHnDJpB_bKdl1XBNGvf581-eExzGJPBNq2oyRL0/edit#gid=705210583</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='24' forceUpdate='true' h='2203' id='630' type-v2='text' w='81348' x='17868' y='44942'>
                  <formatted-text>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='15'>Metrics Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='324' forceUpdate='true' h='22850' id='629' type-v2='text' w='81348' x='17868' y='47145'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Customer Contact Rate:</run>
                    <run fontname='Tableau Light' fontsize='8'> All contacts initiated by the customer divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Stakeholder to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Customer</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Vendor Contact Rate:</run>
                    <run fontname='Tableau Light' fontsize='8'> All contacts initiated by the vendor divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Stakeholder to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Vendor</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Vendor Contact Rate (Sales):</run>
                    <run fontname='Tableau Light' fontsize='8'> All contacts initiated by the Customer and driven by vendor divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Stakeholder to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Customer</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Ownership to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Vendor </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Rider Contact Rate:</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run fontname='Tableau Light' fontsize='8'>All contacts initiated by the rider divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Stakeholder to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Rider</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Shopper Contact Rate:</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run fontname='Tableau Light' fontsize='8'>All contacts initiated by the shopper divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> - Set Contact Stakeholder to </run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>Shopper</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>CR(Unique customer contacted orders)</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>:</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run fontname='Tableau Light' fontsize='8'>All unique contacted orders initiated by the customer divided by baseline orders</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='1652' id='417' type-v2='text' w='17084' x='0' y='98347'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#555555'>©</run>
                    <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Google Sans,arial,sans-serif'>Æ </run>
                    <run bold='true' fontalignment='1' fontcolor='#555555'>Care Data Unit</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#d4d4d4' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='0' />
                <format attr='padding' value='0' />
                <format attr='padding-left' value='0' />
                <format attr='background-color' value='#ffffff' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{453F0D7A-6083-49A7-8432-76B4C825D2AB}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Reasons'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/ContactsDashboard-newchanges/Reasons?rev=' id='Reasons' path='/t/Talabat/workbooks/ContactsDashboard' revision='' site='Talabat' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='font-family' value='Calibri' />
        </style-rule>
        <style-rule element='dash-subtitle'>
          <format attr='font-family' value='Calibri' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_156' value='top' />
          <format attr='font-family' value='Calibri' />
        </style-rule>
      </style>
      <size maxheight='1453' maxwidth='1276' minheight='1453' minwidth='1276' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='cntct_wip (data_playground)' name='federated.0kavper1x4zwt01boyk7w1hawv99' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Contact baseline' datatype='string' name='[CR Baseline Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contribution&quot;'>
          <calculation class='tableau' formula='&quot;Contribution&quot;' />
          <aliases>
            <alias key='&quot;Chat AHT&quot;' value='Chat AHT (Min)' />
            <alias key='&quot;CR&quot;' value='CR' />
            <alias key='&quot;Non-Live AHT&quot;' value='Non-Live AHT (Min)' />
            <alias key='&quot;Wrap Time&quot;' value='Avg. Wrap Time (Min)' />
          </aliases>
          <members>
            <member value='&quot;Contribution&quot;' />
            <member alias='CR' value='&quot;CR&quot;' />
            <member value='&quot;Number of contact&quot;' />
            <member alias='Non-Live AHT (Min)' value='&quot;Non-Live AHT&quot;' />
            <member alias='Chat AHT (Min)' value='&quot;Chat AHT&quot;' />
            <member alias='Avg. Wrap Time (Min)' value='&quot;Wrap Time&quot;' />
          </members>
        </column>
        <column alias='Day' caption='Date level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
          <calculation class='tableau' formula='&quot;day&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Day' />
            <alias key='&quot;month&quot;' value='Month' />
            <alias key='&quot;week&quot;' value='Week' />
          </aliases>
          <members>
            <member alias='Day' value='&quot;day&quot;' />
            <member alias='Week' value='&quot;week&quot;' />
            <member alias='Month' value='&quot;month&quot;' />
          </members>
        </column>
        <column caption='Contact Reason Level' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact Reason L3&quot;'>
          <calculation class='tableau' formula='&quot;Contact Reason L3&quot;' />
          <members>
            <member value='&quot;Contact Reason L1&quot;' />
            <member value='&quot;Contact Reason L2&quot;' />
            <member value='&quot;Contact Reason L3&quot;' />
          </members>
        </column>
        <column caption='TOP N' datatype='integer' default-format='N' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='5'>
          <calculation class='tableau' formula='5' />
          <range granularity='5' max='100' min='5' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0kavper1x4zwt01boyk7w1hawv99'>
        <column caption='Daily Original Date' datatype='date' name='[Calculation_3073003092405231616]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='[date]' />
        </column>
        <column caption='Order Related or Non' datatype='string' name='[Calculation_39828748309172224]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [order_related_or_non]=&apos;Order_related&apos; then &quot;Yes&quot; &#10;ELSEIF [order_related_or_non]=&apos;Non order_related&apos; then &quot;No&quot; &#10;END' />
        </column>
        <column caption='Delivery Method 2' datatype='string' name='[Calculation_4776771116238905344]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_165225829968494593] =&apos;TGO&apos; then &apos;TGO&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TMP&apos; then &apos;TMP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;PICKUP&apos; THEN &apos;PICKUP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TDINE&apos; THEN &apos;TDINE&apos;&#10;ELSE &apos;Non Order Related&apos; END' />
        </column>
        <column datatype='string' name='[Vertical (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[vertical]' new-bin='true'>
            <bin default-name='false' value='&quot;Food&quot;'>
              <value>&quot;food&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Non-Food&quot;'>
              <value>&quot;cosmetics&quot;</value>
              <value>&quot;electronics&quot;</value>
              <value>&quot;flowers&quot;</value>
              <value>&quot;grocery&quot;</value>
              <value>&quot;pet shop&quot;</value>
              <value>&quot;pharmacy&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Notmapped&quot;'>
              <value>%null%</value>
              <value>&quot;N/A&quot;</value>
              <value>&quot;null&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;Tmart&quot;'>
              <value>&quot;Tmart&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal' />
        <column caption='Vendor Chain' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
        <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
          <aliases>
            <alias key='%null%' value='Not Order Related' />
          </aliases>
        </column>
        <column caption='Contact Reason L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
        <column caption='Contact Reason L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal' />
        <column caption='Contact Reason L3' datatype='string' name='[contact_reason_l3]' role='dimension' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <aliases>
            <alias key='&quot;KSA&quot;' value='Saudi Arabia' />
          </aliases>
        </column>
        <column caption='Original date' datatype='date' name='[date]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_3073003092405231616]' derivation='None' name='[none:Calculation_3073003092405231616:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_39828748309172224]' derivation='None' name='[none:Calculation_39828748309172224:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_4776771116238905344]' derivation='None' name='[none:Calculation_4776771116238905344:nk]' pivot='key' type='nominal' />
        <column-instance column='[agent_facing_tool]' derivation='None' name='[none:agent_facing_tool:nk]' pivot='key' type='nominal' />
