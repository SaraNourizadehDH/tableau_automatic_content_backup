              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then[number_of_contacts]/{ FIXED[date]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED[date]:SUM([vendor_orders])}&#10;END)' />
