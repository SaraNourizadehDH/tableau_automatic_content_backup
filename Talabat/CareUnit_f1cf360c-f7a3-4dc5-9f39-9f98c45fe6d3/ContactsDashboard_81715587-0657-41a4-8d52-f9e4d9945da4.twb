      <table>
        <view>
          <datasources>
            <datasource caption='cntct_wip (data_playground)' name='federated.0kavper1x4zwt01boyk7w1hawv99' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Baseline' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gross Orders&quot;'>
              <calculation class='tableau' formula='&quot;Gross Orders&quot;' />
              <aliases>
                <alias key='&quot;Vendor Orders&quot;' value='Net Orders' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kavper1x4zwt01boyk7w1hawv99'>
            <column caption='Delivery Method' datatype='string' name='[Calculation_165225829968494593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_arrangement] = &apos;Own Delivery&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Pick-up&apos; THEN &quot;PICKUP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TGO&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TMP&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Vendor Delivery&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Non-order related&apos; THEN &quot;Non-order related&quot;&#10;else [delivery_arrangement] end' />
            </column>
            <column caption='Daily Original Date' datatype='date' name='[Calculation_3073003092405231616]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column caption='Orders fxdate' datatype='integer' name='[Calculation_38280610494541918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then { FIXED [date]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then { FIXED [date]:SUM([vendor_orders])}&#10;&#10;END' />
            </column>
            <column caption='Last Week' datatype='datetime' name='[Calculation_38280610868396147]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX(DATETRUNC(&apos;week&apos;,[date]))}' />
            </column>
            <column caption='Same day ' datatype='boolean' name='[Calculation_38280610871464054]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[date]) = &#10;    DATEPART(&apos;weekday&apos;,DATEADD(&apos;day&apos;, 1, { FIXED : MAX([date])-1}))' />
            </column>
            <column caption='Filter last week' datatype='boolean' name='[Calculation_38280610872496248]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(ATTR(DATETRUNC(&apos;week&apos;,[date])), 0) = ATTR([Calculation_38280610868396147])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Related or Non' datatype='string' name='[Calculation_39828748309172224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_related_or_non]=&apos;Order_related&apos; then &quot;Yes&quot; &#10;ELSEIF [order_related_or_non]=&apos;Non order_related&apos; then &quot;No&quot; &#10;END' />
            </column>
            <column caption='Delivery Method 2' datatype='string' name='[Calculation_4776771116238905344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_165225829968494593] =&apos;TGO&apos; then &apos;TGO&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TMP&apos; then &apos;TMP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;PICKUP&apos; THEN &apos;PICKUP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TDINE&apos; THEN &apos;TDINE&apos;&#10;ELSE &apos;Non Order Related&apos; END' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_4776841475411243008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN USERNAME() = [account_manager_name] &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN [team_leader_name] = {MIN(IF USERNAME() = [account_manager_name] THEN [team_leader_name] ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN USERNAME() = [team_leader_name] OR USERNAME() = [account_manager_name]&#10;END' />
            </column>
            <column datatype='string' name='[Vertical (group)]' role='dimension' type='nominal'>
