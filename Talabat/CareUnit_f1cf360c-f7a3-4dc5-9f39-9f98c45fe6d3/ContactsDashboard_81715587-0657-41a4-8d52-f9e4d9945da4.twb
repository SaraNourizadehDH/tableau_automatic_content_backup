      <column caption='yesterday sla frt' datatype='integer' name='[Agg SLA (copy)_6825697836513013773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [date] = TODAY()- 1 and [channel]=&apos;Chat&apos; then [frt30] END' />
      </column>
      <column caption='Vendor CR' datatype='real' name='[Area CR (copy)_611011820039606275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos;&#10;then&#10;SUM([number_of_contacts])/SUM({ FIXED [chain_name],[Calculation_4776771116238905344]:SUM([gross_order_count])})&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos;&#10;then&#10;SUM([number_of_contacts])/SUM({ FIXED [chain_name],[Calculation_4776771116238905344]:SUM([net_order_count])})&#10;end' />
      </column>
      <column caption='CR Baselinedate' datatype='real' name='[CR Baselinedate (copy 2)_38280610822242405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then[number_of_contacts]/{ FIXED[date]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED[date]:SUM([vendor_orders])}&#10;END)' />
      </column>
      <column caption='IssueRateBaseline' datatype='real' name='[CR Baselinedate (copy 2)_38280610894536828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([number_of_contacts])+SUM(ZN([outbound_calls])))/SUM([Orders Baseline (copy)_38280610826801257])' />
      </column>
      <column caption='yesterdays cr' datatype='real' name='[CR Baselinedate (copy)_6825697836507234308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; and [date] = TODAY()-1 then[number_of_contacts]/{ FIXED[date]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; and [date] = TODAY()-1 then [number_of_contacts]/{ FIXED[date]:SUM([vendor_orders])}&#10;END)' />
      </column>
      <column caption='CR Baselineweek' datatype='real' name='[CR Baselinemonthh (copy)_38280610889842811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then[number_of_contacts]/{ FIXED WEEK([date]):SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED WEEK([date]):SUM([net_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Total Orders&apos; then [number_of_contacts]/{ FIXED WEEK([date]):SUM([order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Successful Orders&apos; then [number_of_contacts]/{ FIXED WEEK([date]):SUM([net_order_count])}&#10;END)' />
      </column>
      <column caption='CR Delivery Baseline' datatype='real' name='[CR Baselinevertical (copy)_4580653421147107329]' role='measure' type='quantitative'>
