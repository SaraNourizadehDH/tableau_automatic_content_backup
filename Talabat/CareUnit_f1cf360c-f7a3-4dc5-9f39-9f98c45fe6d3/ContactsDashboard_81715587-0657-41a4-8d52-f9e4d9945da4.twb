      <column caption='Calculation1' datatype='integer' name='[Calculation_1446781401366056960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then [gross_order_count]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Vendor Orders&apos; then [vendor_orders]&#10;end' />
      </column>
      <column caption='Delivery Method' datatype='string' name='[Calculation_165225829968494593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_arrangement] = &apos;Own Delivery&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Pick-up&apos; THEN &quot;PICKUP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TGO&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TMP&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Vendor Delivery&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Non-order related&apos; THEN &quot;Non-order related&quot;&#10;else [delivery_arrangement] end' />
      </column>
      <column caption='is_today' datatype='boolean' name='[Calculation_1883138011600846848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [date] = (Today()) then true else false end' />
      </column>
      <column caption='CR Vertical Baseline ' datatype='real' name='[Calculation_206532282807824385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then[number_of_contacts]/{ FIXED [date],[Vertical (group)]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED [date],[Vertical (group)]:SUM([vendor_orders])}&#10;END)' />
      </column>
      <column caption='Note' datatype='string' name='[Calculation_2112188244521541632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;*&quot;' />
      </column>
      <column caption='Total Contacted Orders Customer' datatype='integer' name='[Calculation_2167990695443070976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name], [date]:sum([total_contacted_orders_customer])}' />
      </column>
      <column caption='Gross orders' datatype='integer' name='[Calculation_2167990695444082689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name],[date]:SUM([gross_order_count])}' />
      </column>
      <column caption='City number of contacts' datatype='integer' name='[Calculation_2285436102235414528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name],[city_name]: sum([number_of_contacts])}' />
      </column>
      <column caption='Chat number of contacts' datatype='integer' name='[Calculation_2856548822609698816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [channel] =&apos;Chat&apos; then [number_of_contacts] else 0 end)' />
      </column>
      <column caption='Daily Original Date' datatype='date' name='[Calculation_3073003092405231616]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[date]' />
      </column>
      <column caption='Contacts Cost' datatype='real' name='[Calculation_3474104961404825600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[number_of_contacts]*[Parameters].[Parameter 9]' />
      </column>
      <column caption='Contact Reason' datatype='string' name='[Calculation_38280607683305472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Contact Reason L1&apos; then [contact_reason_l1]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Contact Reason L2&apos;then [contact_reason_l2]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Contact Reason L3&apos;then [contact_reason_l3]&#10;END' />
      </column>
      <column caption='CSATDifferenceArrow' datatype='string' name='[Calculation_38280608358797324]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (ZN([Calculation_6241637248531783684]) - LOOKUP(ZN([Calculation_6241637248531783684]), -1)) &gt; 0 then &quot;▲&quot;&#10;ELSEIF  (ZN([Calculation_6241637248531783684]) - LOOKUP(ZN([Calculation_6241637248531783684]), -1)) &lt; 0 then &quot;▼&quot;&#10;ELSE &quot;◄&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Missed Chats%' datatype='real' name='[Calculation_38280608382345235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([chat_status])=&apos;missed&apos; then [number_of_contacts]END)/SUM([number_of_contacts])' />
      </column>
      <column caption='FCR' datatype='real' name='[Calculation_38280608737832980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fcr_ind])/SUM([no_of_contacts_eligible_for_res])' />
      </column>
      <column caption='30days filter' datatype='boolean' name='[Calculation_38280609764003881]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(DATEDIFF(&apos;day&apos;,[date],TODAY()))&lt;30 and MIN(DATEDIFF(&apos;day&apos;,[date],TODAY()))&gt;=0' />
      </column>
      <column caption='WOW' datatype='real' name='[Calculation_38280610173730884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF DATEADD(&apos;week&apos;,-1,TODAY()-1)=[date]then [gross_order_count] END)/SUM(if DATEADD(&apos;day&apos;,-1,TODAY())=[date] then [gross_order_count] end)' />
      </column>
      <column caption='WOW Change Gross' datatype='real' name='[Calculation_38280610176032840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date]=TODAY()-1 then [gross_order_count] END)/[Calculation_38280610173730884]' />
      </column>
      <column caption='WOWChange' datatype='integer' name='[Calculation_38280610177544267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([gross_order_count]),-7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CR%' datatype='real' name='[Calculation_38280610323935320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then&#10;SUM([number_of_contacts])/SUM([gross_order_count])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then&#10;SUM([number_of_contacts])/SUM([net_order_count])&#10;END' />
      </column>
      <column caption='CR Baseline' datatype='real' name='[Calculation_38280610444734553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then [number_of_contacts]/{ FIXED [country_name]:SUM([gross_order_count])} &#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED [country_name]:SUM([net_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Successful Orders&apos; then ([number_of_contacts])/{ FIXED [country_name]:SUM([successful_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Total Orders&apos;then [number_of_contacts]/{ FIXED [country_name]:SUM([order_count])}&#10;END)' />
      </column>
      <column caption='Orders Baseline' datatype='integer' name='[Calculation_38280610482815069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then { FIXED [country_name]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Net Orders&apos; then { FIXED [country_name]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Successful Orders&apos; then { FIXED [country_name]:SUM([successful_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Total Orders&apos; then { FIXED [country_name]:SUM([order_count])}&#10;END' />
      </column>
      <column caption='Orders fxdate' datatype='integer' name='[Calculation_38280610494541918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then { FIXED [date]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then { FIXED [date]:SUM([vendor_orders])}&#10;&#10;END' />
      </column>
      <column caption='CR Baselinemonthh' datatype='real' name='[Calculation_38280610497392735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then[number_of_contacts]/{ FIXED MONTH([date]):SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then [number_of_contacts]/{ FIXED MONTH([date]):SUM([net_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Total Orders&apos; then [number_of_contacts]/{ FIXED MONTH([date]):SUM([order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Successful Orders&apos; then [number_of_contacts]/{ FIXED MONTH([date]):SUM([net_order_count])}&#10;END)' />
      </column>
      <column caption='Last Week' datatype='datetime' name='[Calculation_38280610868396147]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX(DATETRUNC(&apos;week&apos;,[date]))}' />
      </column>
      <column caption='Same day ' datatype='boolean' name='[Calculation_38280610871464054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[date]) = &#10;    DATEPART(&apos;weekday&apos;,DATEADD(&apos;day&apos;, 1, { FIXED : MAX([date])-1}))' />
      </column>
      <column caption='Week' datatype='integer' name='[Calculation_38280610871963767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WEEK([date])' />
      </column>
      <column caption='Filter last week' datatype='boolean' name='[Calculation_38280610872496248]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR(DATETRUNC(&apos;week&apos;,[date])), 0) = ATTR([Calculation_38280610868396147])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders Dimension Baseline' datatype='integer' name='[Calculation_38280610967814269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Country&apos; &#10;or [Parameters].[Parameter 2]=&apos;Delivery Method&apos; &#10;or [Parameters].[Parameter 2]=&apos;Vertical&apos; &#10;or [Parameters].[Parameter 2]=&apos;City&apos; &#10;or [Parameters].[Parameter 2]=&apos;Area&apos; &#10;or [Parameters].[Parameter 2]=&apos;Vendor&apos; &#10;or [Parameters].[Parameter 2]=&apos;Chain&apos; &#10;or [Parameters].[Parameter 2]=&apos;Account Manager Name&apos; &#10;or [Parameters].[Parameter 2]=&apos;AM Team Lead Name&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Country&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Delivery Method&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vertical&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;City&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Area&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vendor&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Chain&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Account Manager Name&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;AM Team Lead Name&apos;  &#10;and [Parameters].[Parameter 6]=&apos;Gross Orders&apos; &#10;then{ FIXED [Calculation_6241637248540016645],[Calculation_6241637250318430241],[Selected Dimension (copy)_990651241197010945]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Country&apos; &#10;or [Parameters].[Parameter 2]=&apos;Delivery Method&apos; &#10;or [Parameters].[Parameter 2]=&apos;Vertical&apos; &#10;or [Parameters].[Parameter 2]=&apos;City&apos; &#10;or [Parameters].[Parameter 2]=&apos;Area&apos; &#10;or [Parameters].[Parameter 2]=&apos;Vendor&apos; &#10;or [Parameters].[Parameter 2]=&apos;Chain&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Country&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Delivery Method&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vertical&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;City&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Area&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vendor&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Chain&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Account Manager Name&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;AM Team Lead Name&apos; &#10;and [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; &#10;then { FIXED [Calculation_6241637248540016645],[Calculation_6241637250318430241],[Selected Dimension (copy)_990651241197010945]:SUM([vendor_orders])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then{ FIXED [Calculation_6241637248540016645]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; then { FIXED [Calculation_6241637248540016645]:SUM([vendor_orders])}&#10;end' />
      </column>
      <column caption='CR BaselineDim' datatype='real' name='[Calculation_38280610972758143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_of_contacts])/SUM([Calculation_38280610967814269])' />
      </column>
      <column caption='fixorder' datatype='integer' name='[Calculation_389772492885606401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date],[vertical] : SUM([order_count])}' />
      </column>
      <column caption='fixcont' datatype='integer' name='[Calculation_389772492886147074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date],[vertical] : SUM([number_of_contacts])}' />
      </column>
      <column caption='Order Related or Non' datatype='string' name='[Calculation_39828748309172224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_related_or_non]=&apos;Order_related&apos; then &quot;Yes&quot; &#10;ELSEIF [order_related_or_non]=&apos;Non order_related&apos; then &quot;No&quot; &#10;END' />
      </column>
      <column caption='Sat' datatype='string' name='[Calculation_4476366946582827010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stakeholder] =&apos;Shopper&apos; then &apos;SH&apos;&#10;ELSEIF [stakeholder] =&apos;Customer&apos; then &apos;C&apos;&#10;ELSEIF [stakeholder] =&apos;Vendor&apos; then &apos;V&apos;&#10;ELSEIF [stakeholder] =&apos;Rider&apos; then &apos;R&apos;&#10;else &apos;SAT&apos;&#10;end' />
      </column>
      <column caption='saat' datatype='string' name='[Calculation_4476366946598182917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;-SAT&quot;' />
      </column>
      <column caption='Non live AHT' datatype='real' name='[Calculation_4530410147399053312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [channel] =&apos;Chat&apos;  then 0&#10;ELSEIF [channel] = &apos;Call&apos; then 0&#10;ELSE [full_resolution_time_in_sec]/([number_of_resolved]) END)/60' />
      </column>
      <column caption='verticals1' datatype='string' name='[Calculation_4580653421142003712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vertical]= &apos;Tmart&apos; then &quot;Tmart&quot;&#10;ELSEIF [vertical] = &apos;food&apos; then &quot;food&quot;&#10;else &quot;other&quot; end' />
      </column>
      <column caption='rank based on cntcts' datatype='integer' name='[Calculation_4580653421156220930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(sum([number_of_contacts]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='RANK to show' datatype='boolean' name='[Calculation_4580653421156986884]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4580653421156220930]&lt;=[Parameters].[Parameter 7]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Method 2' datatype='string' name='[Calculation_4776771116238905344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_165225829968494593] =&apos;TGO&apos; then &apos;TGO&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TMP&apos; then &apos;TMP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;PICKUP&apos; THEN &apos;PICKUP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TDINE&apos; THEN &apos;TDINE&apos;&#10;ELSE &apos;Non Order Related&apos; END' />
      </column>
      <column caption='nfc' datatype='integer' name='[Calculation_4776771116275154955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Country&apos; &#10;or [Parameters].[Parameter 2]=&apos;Vertical&apos; &#10;or [Parameters].[Parameter 2]=&apos;Delivery Method&apos;&#10;or [Parameters].[Parameter 2]=&apos;City&apos; &#10;or [Parameters].[Parameter 2]=&apos;Area&apos;&#10;or [Parameters].[Parameter 2]=&apos;Vendor&apos; &#10;or [Parameters].[Parameter 2]=&apos;Chain&apos;&#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Country&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Delivery Method&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vertical&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;City&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Area&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Vendor&apos; &#10;or [Parameters].[Select Dimension (copy)_990651241196875776]=&apos;Chain&apos; &#10;then{ FIXED [Calculation_6241637248540016645],[Calculation_6241637250318430241],[Selected Dimension (copy)_990651241197010945]:SUM([net_fail_order_count])}&#10;ELSE { FIXED [Calculation_6241637248540016645]:SUM([net_fail_order_count])}&#10;end' />
      </column>
      <column caption='Blk chat' datatype='integer' name='[Calculation_4776771116278575116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(IF [chat_status] &lt;&gt;&apos;Blocked&apos; then [number_of_contacts] END),0)' />
      </column>
      <column caption='User Filter' datatype='boolean' name='[Calculation_4776841475411243008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN USERNAME() = [account_manager_name] &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN [team_leader_name] = {MIN(IF USERNAME() = [account_manager_name] THEN [team_leader_name] ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN USERNAME() = [team_leader_name] OR USERNAME() = [account_manager_name]&#10;END' />
      </column>
      <column caption='order dots' datatype='string' name='[Calculation_5628866231569641475]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if (sum ([Calculation_38280610494541918]))=WINDOW_MIN((sum ([Calculation_38280610494541918]))) &#10;then &apos;min&apos;&#10;elseif (sum ([Calculation_38280610494541918]))=WINDOW_MAX(sum ([Calculation_38280610494541918])) &#10;then&apos;max&apos;&#10;ELSEIF LAST()=0 then &apos;most recent&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='New CR KPI (based on orders)' datatype='real' name='[Calculation_5965369605905121280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([nfc (copy)_1575485872650678272])/sum([Calculation_38280610967814269])' />
      </column>
      <column caption='City CR' datatype='real' name='[Calculation_611011820038238209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2285436102235414528])/SUM({ FIXED [city_name]:SUM([gross_order_count])})' />
      </column>
      <column caption='Gross Orders Vendor' datatype='integer' name='[Calculation_611011820040081412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 6]=&apos;Gross Orders&apos; &#10;then { FIXED [chain_name],[Calculation_4776771116238905344]:SUM([gross_order_count])}&#10;ELSEIF  &#10;[Parameters].[Parameter 6]=&apos;Vendor Orders&apos;&#10;then { FIXED [chain_name],[Calculation_4776771116238905344]:SUM([net_order_count])}&#10;END' />
      </column>
      <column caption='CSAT' datatype='real' name='[Calculation_6241637248531783684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([csat_4]+[csat_5])/SUM([csat_responses]))' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_6241637248540016645]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[date]))' />
      </column>
      <column caption='Fixed gross orders' datatype='integer' name='[Calculation_6241637248568889355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name],[city_name]:SUM([gross_order_count])}' />
      </column>
      <column caption='Gross orders fixed date' datatype='integer' name='[Calculation_6241637249238032397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date]:SUM([gross_order_count])}' />
      </column>
      <column caption='last' datatype='integer' name='[Calculation_6241637249239162895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='last()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CRDifferenceArrow' datatype='string' name='[Calculation_6241637249244180496]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (ZN([Calculation_6241637249238257678]) - LOOKUP(ZN([Calculation_6241637249238257678]), -1)) &gt; 0 then &quot;▲&quot;&#10;ELSEIF  (ZN([Calculation_6241637249238257678]) - LOOKUP(ZN([Calculation_6241637249238257678]), -1)) &lt; 0 then &quot;▼&quot;&#10;ELSE &quot;◄&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
