            <column caption='Vendor CR (copy)' datatype='real' name='[Vendor CR (copy)_39828749385592833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_contacts])/SUM({ FIXED [chain_name],[date]:SUM([gross_order_count])})' />
