            <datasource caption='cntct_wip (data_playground)' name='federated.0kavper1x4zwt01boyk7w1hawv99' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Contact baseline' datatype='string' name='[CR Baseline Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contribution&quot;'>
              <calculation class='tableau' formula='&quot;Contribution&quot;' />
              <aliases>
                <alias key='&quot;Chat AHT&quot;' value='Chat AHT (Min)' />
                <alias key='&quot;CR&quot;' value='CR' />
                <alias key='&quot;Non-Live AHT&quot;' value='Non-Live AHT (Min)' />
                <alias key='&quot;Wrap Time&quot;' value='Avg. Wrap Time (Min)' />
              </aliases>
            </column>
            <column alias='Day' caption='Date level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Contact Reason Level' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact Reason L3&quot;'>
              <calculation class='tableau' formula='&quot;Contact Reason L3&quot;' />
            </column>
            <column caption='Baseline' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gross Orders&quot;'>
              <calculation class='tableau' formula='&quot;Gross Orders&quot;' />
              <aliases>
                <alias key='&quot;Vendor Orders&quot;' value='Net Orders' />
              </aliases>
            </column>
            <column caption='TOP N' datatype='integer' default-format='N' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='5' max='100' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kavper1x4zwt01boyk7w1hawv99'>
            <column caption='Calculation1' datatype='integer' name='[Calculation_1446781401366056960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; then [gross_order_count]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Vendor Orders&apos; then [vendor_orders]&#10;end' />
            </column>
            <column caption='Delivery Method' datatype='string' name='[Calculation_165225829968494593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_arrangement] = &apos;Own Delivery&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Pick-up&apos; THEN &quot;PICKUP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TGO&apos; THEN &quot;TGO&quot;&#10;ELSEIF [delivery_arrangement] = &apos;TMP&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Vendor Delivery&apos; THEN &quot;TMP&quot;&#10;ELSEIF [delivery_arrangement] = &apos;Non-order related&apos; THEN &quot;Non-order related&quot;&#10;else [delivery_arrangement] end' />
            </column>
            <column caption='Daily Original Date' datatype='date' name='[Calculation_3073003092405231616]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column caption='Contact Reason' datatype='string' name='[Calculation_38280607683305472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Contact Reason L1&apos; then [contact_reason_l1]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Contact Reason L2&apos;then [contact_reason_l2]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Contact Reason L3&apos;then [contact_reason_l3]&#10;END' />
            </column>
            <column caption='Order Related or Non' datatype='string' name='[Calculation_39828748309172224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_related_or_non]=&apos;Order_related&apos; then &quot;Yes&quot; &#10;ELSEIF [order_related_or_non]=&apos;Non order_related&apos; then &quot;No&quot; &#10;END' />
            </column>
            <column caption='Non live AHT' datatype='real' name='[Calculation_4530410147399053312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [channel] =&apos;Chat&apos;  then 0&#10;ELSEIF [channel] = &apos;Call&apos; then 0&#10;ELSE [full_resolution_time_in_sec]/([number_of_resolved]) END)/60' />
            </column>
            <column caption='rank based on cntcts' datatype='integer' name='[Calculation_4580653421156220930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(sum([number_of_contacts]),&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RANK to show' datatype='boolean' name='[Calculation_4580653421156986884]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_4580653421156220930]&lt;=[Parameters].[Parameter 7]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Delivery Method 2' datatype='string' name='[Calculation_4776771116238905344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_165225829968494593] =&apos;TGO&apos; then &apos;TGO&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TMP&apos; then &apos;TMP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;PICKUP&apos; THEN &apos;PICKUP&apos;&#10;ELSEIF [Calculation_165225829968494593] =&apos;TDINE&apos; THEN &apos;TDINE&apos;&#10;ELSE &apos;Non Order Related&apos; END' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_4776841475411243008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN USERNAME() = [account_manager_name] &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN [team_leader_name] = {MIN(IF USERNAME() = [account_manager_name] THEN [team_leader_name] ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN USERNAME() = [team_leader_name] OR USERNAME() = [account_manager_name]&#10;END' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_6241637248540016645]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[date]))' />
            </column>
            <column caption='Chat AHT' datatype='real' name='[Calculation_6241637250446487609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [channel]=&apos;Chat&apos; then [handling_time_secs] END)/SUM(IF [channel]=&apos;Chat&apos; then [number_of_contacts]END ))/60' />
            </column>
            <column caption='CR Reason Basline ' datatype='real' name='[Calculation_6290895380443951105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L1&apos; then[number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L2&apos; then[number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Gross Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L3&apos; then[number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([gross_order_count])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L1&apos;  then [number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([vendor_orders])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L2&apos;  then [number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([vendor_orders])}&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Vendor Orders&apos; and [Parameters].[Parameter 3] = &apos;Contact Reason L3&apos;  then [number_of_contacts]/{ FIXED[date],[Parameters].[Parameter 3]:SUM([vendor_orders])} end)' />
            </column>
            <column caption='Percentage' datatype='real' name='[Calculation_7778701742182584321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[CR Baseline Parameter]= &apos;Contribution&apos; then[number_of_contacts]/{ FIXED[Calculation_6241637248540016645],[stakeholder]:SUM([number_of_contacts])}&#10;ELSEIF [Parameters].[CR Baseline Parameter]= &apos;CR&apos; then[number_of_contacts]/{ FIXED [Calculation_6241637248540016645]:SUM([Calculation_1446781401366056960])} &#10;END)' />
            </column>
            <column caption='Absolute value' datatype='real' name='[Metric (copy)_4776771116246560769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[CR Baseline Parameter]=&apos;Number of contact&apos; then sum([number_of_contacts])&#10;ELSEIF [Parameters].[CR Baseline Parameter]=&apos;Non-Live AHT&apos; then [Calculation_4530410147399053312]&#10;ELSEIF [Parameters].[CR Baseline Parameter]=&apos;Chat AHT&apos; then [Calculation_6241637250446487609]&#10;ELSEIF [Parameters].[CR Baseline Parameter]=&apos;Wrap Time&apos; THEN (sum([wrap_up_time_secs])/(60))/SUM(if [channel] =&apos;Chat&apos; then [number_of_contacts] end)&#10;END' />
            </column>
            <column datatype='string' name='[Vertical (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[vertical]' new-bin='true'>
                <bin default-name='false' value='&quot;Food&quot;'>
                  <value>&quot;food&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Non-Food&quot;'>
                  <value>&quot;cosmetics&quot;</value>
                  <value>&quot;electronics&quot;</value>
                  <value>&quot;flowers&quot;</value>
                  <value>&quot;grocery&quot;</value>
                  <value>&quot;pet shop&quot;</value>
                  <value>&quot;pharmacy&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Notmapped&quot;'>
                  <value>%null%</value>
                  <value>&quot;N/A&quot;</value>
                  <value>&quot;null&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Tmart&quot;'>
                  <value>&quot;Tmart&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
