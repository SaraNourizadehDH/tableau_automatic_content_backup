      <aliases enabled='yes' />
      <column caption='Ramadan/Eid' datatype='string' name='[Calculation_1007680445123682304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_date] &gt;= #2021-04-12# AND [order_date] &lt;= #2021-05-11# THEN &apos;Ramadan&apos;&#13;&#10;elseif [order_date] &gt;= #2021-05-12# THEN &apos;Eid&apos;&#13;&#10;Else null&#13;&#10;END' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_2019020018422763520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id])' />
      </column>
      <column caption='delayed_orders_25' datatype='string' name='[Calculation_2019020018423050241]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if (([order_delay]/60)&gt;25) then [order_id] end' />
      </column>
      <column caption='count_delay_orders' datatype='integer' name='[Calculation_2019020018423222274]' role='measure' type='quantitative'>
