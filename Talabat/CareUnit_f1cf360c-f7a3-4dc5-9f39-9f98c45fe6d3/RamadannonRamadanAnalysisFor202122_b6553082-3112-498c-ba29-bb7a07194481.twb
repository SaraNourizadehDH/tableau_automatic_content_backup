        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1u8bo020byuo371akkc791ftb8my' name='Custom SQL Query' type='text'><![CDATA[with raw as  
(
select 
rfo.source_id
,rfo.order_id 
,rfo.restaurant_id
,rfo.order_date
,rfo.is_tgo 
,rfo.vertical
,countries.common_name as country
,hurr.order_status
,hurr.order_placed_at
,hurr.vendor_accepted_at 
,hurr.sent_to_vendor_at
,hurr.original_scheduled_pickup_at
,hurr.promised_delivery_time_at
,hurr.updated_scheduled_pickup_at
,hurr.estimated_prep_time
,hurr.updated_prep_time
,hurr.dispatching_time
,hurr.rider_accepting_time
,hurr.rider_late
,hurr.vendor_late
,hurr.at_customer_time
,hurr.actual_delivery_time
,hurr.promised_delivery_time
,hurr.order_delay
,hurr.cancellation_performed_by
,hurr.delivery_status
,hurr.driving_time
 from `bta---talabat.data_platform_redshift.ranked_fct_order`  rfo
left join `bta---talabat.data_platform_redshift.dim_countries` countries on rfo.source_id=countries.source_id
left join `bta---talabat.data_platform_redshift_logistics.fct_hurrier_order` hurr on rfo.order_id=hurr.order_id and date(hurr.created_date)>>='2021-01-12' and date(created_date)<<='2021-10-12'
where date(order_date)>>='2021-04-12'
and date(order_date)<<'2021-05-16'
)

select date(order_date) as order_date
,extract(hour from order_date) as order_hour 
,order_id 
,country 
,source_id 
,order_delay
,rider_late
,vendor_late 
,restaurant_id
,is_tgo 
,vertical
from raw]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1u8bo020byuo371akkc791ftb8my' name='Custom SQL Query' type='text'><![CDATA[with raw as  
