            <column caption='Datasource (Issues)' datatype='string' name='[Calculation_1496672863292755968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [flag_name] = &apos;fct_data_sources&apos; and [flag_value] THEN &apos;- Your data source is using a fct Table, Using fct tables often processes millions of unnecessary rows and consumes a lot of resources.&apos;&#10;ELSEIF [flag_name] = &apos;dev_data_sources&apos; and [flag_value] THEN &#10;&apos;- Your data source is using a dev Table, dev tables are temporary and can be deleted.&apos;&#10;ELSEIF [flag_name] = &apos;calculation_use&apos; and [flag_value] THEN &#10;&apos;- Pre-calculated ratios or averages in the query may aggregate incorrectly in Tableau.&apos;&#10;ELSEIF &#10;[flag_name] = &apos;fct_data_sources&apos; and [flag_value] = FALSE &#10;and [flag_name] = &apos;dev_data_sources&apos; and [flag_value] = FALSE &#10;and [flag_name] = &apos;calculation_use&apos; and [flag_value] = FALSE &#10;&#10;&#10;THEN &apos;No Issues with your data source.&apos; &#10;&#10;end' />
            </column>
            <column caption='Use of Calculation' datatype='boolean' name='[Calculation_2792935499918815232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(lower([metadata_query]),&apos;/sum(&apos;)&#10;or&#10;CONTAINS(lower([metadata_query]),&apos;/ sum(&apos;)&#10;or&#10;CONTAINS(lower([metadata_query]),&apos;/count(&apos;)&#10;or&#10;CONTAINS(lower([metadata_query]),&apos;/ count(&apos;)' />
            </column>
            <column caption='Data Source Status' datatype='string' name='[Calculation_2792935500179918853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[cnt_fct_data_sources] &gt; 0 and [cnt_dev_data_sources] &gt;0 THEN &apos;❌ Non-Compliant&apos;&#10;ELSEIF [cnt_fct_data_sources] &gt; 0 THEN &apos;❌ Non-Compliant&apos; &#10;ELSEIF [cnt_dev_data_sources] &gt;0 THEN &apos;❌ Non-Compliant&apos;&#10;&#10;else &apos;✅ Compliant&apos; end' />
            </column>
            <column caption='Dev Data Sources' datatype='integer' name='[cnt_dev_data_sources]' role='measure' type='quantitative' />
            <column caption='Fct Data Sources' datatype='integer' name='[cnt_fct_data_sources]' role='measure' type='quantitative' />
