          <alias key='&quot;[federated.05t7mu70dirjwr1h6keq109p9cwu].[sum:evaluated_cases_per_agent_per_week (copy)_1026257771226161155:qk]&quot;' value='Total Cases' />
        </aliases>
      </column>
      <column caption='evaluated_cases_per_agent_per_week' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1026257771225423874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [email],[Calculation_168603515863244810]:COUNT(IF [is_evaluated] = TRUE THEN 1 END)}' />
      </column>
      <column caption='Is Agent Adhered' datatype='boolean' name='[Calculation_1026257771226599428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bpo] != &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &gt;= 6 AND [Calculation_1026257771225423874] &lt; 6 THEN FALSE&#13;&#10;ELSEIF [bpo] != &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &gt;= 6 AND [Calculation_1026257771225423874] &gt;= 6 THEN TRUE&#13;&#10;ELSEIF [bpo] != &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &lt; 6 AND [Calculation_1026257771225423874] &gt;= [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] THEN TRUE&#13;&#10;ELSEIF [bpo] != &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &lt; 6 AND [Calculation_1026257771225423874] &lt; [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] THEN FALSE&#13;&#10;&#13;&#10;ELSEIF [bpo] = &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &gt;= 5 AND [Calculation_1026257771225423874] &lt; 5 THEN FALSE&#13;&#10;ELSEIF [bpo] = &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &gt;= 5 AND [Calculation_1026257771225423874] &gt;= 5 THEN TRUE&#13;&#10;ELSEIF [bpo] = &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &lt; 5 AND [Calculation_1026257771225423874] &gt;= [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] THEN TRUE&#13;&#10;ELSEIF [bpo] = &apos; Ibex FPPK&apos; AND [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] &lt; 5 AND [Calculation_1026257771225423874] &lt; [evaluated_cases_per_agent_per_week (copy)_1026257771226161155] THEN FALSE&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total Agents.' datatype='integer' default-format='N' name='[Calculation_1583789366966792193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([email])' />
      </column>
      <column caption='Evaluated Cases.' datatype='integer' default-format='N' name='[Calculation_168603515861438471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_evaluated] = TRUE THEN [case_id] END)' />
      </column>
      <column caption='% Evaluation' datatype='real' default-format='p0.00%' name='[Calculation_168603515861811209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_168603515861438471]/COUNT([case_id])' />
      </column>
      <column caption='week_number' datatype='integer' name='[Calculation_168603515863244810]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-week&apos;,[Calculation_420242170735316992])' />
      </column>
      <column caption='Total Cases.' datatype='integer' default-format='N' name='[Calculation_168603515863662603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_id])' />
      </column>
      <column caption='Min Evaluations' datatype='integer' name='[Calculation_248542404732485635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR&#13;&#10;(&#13;&#10;IF [bpo] = &quot;Ibex FPPK&quot; THEN 5 &#13;&#10;ELSE 6&#13;&#10;END&#13;&#10;) * COUNTD([email])' />
      </column>
      <column caption='% Min Evaluation' datatype='real' default-format='p0.00%' name='[Calculation_248542404737167364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_168603515861438471]/[Calculation_248542404732485635]' />
      </column>
      <column caption='Assigned Date' datatype='datetime' name='[Calculation_420242170735316992]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_at_local])+3' />
      </column>
      <column caption='Week Assigning' datatype='integer' name='[Calculation_654992279504117764]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-week&apos;, [Calculation_420242170735316992])' />
      </column>
      <column caption='Week Evaluation' datatype='integer' name='[Calculation_654992279504392197]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-week&apos;,[created_at])' />
      </column>
      <column caption='Adhered Agents' datatype='integer' default-format='N' name='[Calculation_654992279772094480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1026257771226599428] = TRUE THEN [email] END)' />
      </column>
      <column caption='Non-Adhered Agents' datatype='integer' default-format='N' name='[Calculation_654992279772233745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1026257771226599428] = FALSE THEN [email] END)' />
      </column>
      <column caption='% Adherence' datatype='real' default-format='p0.00%' name='[Calculation_654992279772598290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [bpo],[Calculation_168603515863244810]: COUNTD(IF [Calculation_1026257771226599428] = TRUE THEN [email] END)/COUNTD([email])}' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
