          <datasources>
            <datasource caption='regional_ssc_commercial_vam_kpi_final (pandata_report)' name='federated.0115hr81ijvx0415ppjqx17nnel5' />
          </datasources>
          <datasource-dependencies datasource='federated.0115hr81ijvx0415ppjqx17nnel5'>
            <column caption='PandaPro Gap To Target' datatype='real' name='[Calculation_104919812040400896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([pandapro_penetration_target] - [pro_deal_penetration_mtd]) * [sf_leads_assigned]' />
            </column>
            <column caption='CPC Share %' datatype='real' name='[Calculation_1310547513824333824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cpc_rev_eur] / [ads_rev_mtd]' />
            </column>
            <column caption='CPC Target' datatype='real' name='[Calculation_1310547513825787906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1310547513824333824] * [ads_target]' />
            </column>
            <column caption='CPC Gap To Target' datatype='real' name='[Calculation_1310547513847152643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1310547513825787906] - [estimate_cpc_rr]' />
            </column>
            <column caption='CPC to be Booked' datatype='real' name='[Calculation_1310547513847951364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1310547513847152643] / ([vendors_cpc_utilization_lm] - 0.1))' />
            </column>
            <column caption='Agent Name' datatype='string' name='[Calculation_1337850601597030400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([agent_email], &apos;@&apos;, 1)' />
            </column>
            <column caption='-SUM([Estimate_Gap_To_Target])' datatype='real' name='[Calculation_293789527079378949]' role='measure' type='quantitative' user:unnamed='TH TCT overview'>
              <calculation class='tableau' formula='-SUM([estimate_gap_to_target])' />
            </column>
            <column caption='Estimate Gap To  Target' datatype='real' name='[Calculation_293789527080382472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(-[estimate_gap_to_target]), 0)' />
            </column>
