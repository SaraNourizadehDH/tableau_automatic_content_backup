          <alias key='&quot;[federated.0115hr81ijvx0415ppjqx17nnel5].[sum:estimate_pb_rr:qk]&quot;' value='Estimated PB RR' />
          <alias key='&quot;[federated.0115hr81ijvx0415ppjqx17nnel5].[sum:pb_rev_eur:qk]&quot;' value='PB Rev MTD' />
          <alias key='&quot;[federated.0115hr81ijvx0415ppjqx17nnel5].[sum:vendors_cpc_utilization_lm:qk]&quot;' value='vendors cpc utilization lm' />
        </aliases>
      </column>
      <column caption='PandaPro Gap To Target' datatype='real' name='[Calculation_104919812040400896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([pandapro_penetration_target] - [pro_deal_penetration_mtd]) * [sf_leads_assigned]' />
      </column>
      <column caption='CPC Share %' datatype='real' name='[Calculation_1310547513824333824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cpc_rev_eur] / [ads_rev_mtd]' />
      </column>
      <column caption='PB Share %' datatype='real' name='[Calculation_1310547513825492993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pb_rev_eur] / [ads_rev_mtd]' />
      </column>
      <column caption='CPC Target' datatype='real' name='[Calculation_1310547513825787906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1310547513824333824] * [ads_target]' />
      </column>
      <column caption='CPC Gap To Target' datatype='real' name='[Calculation_1310547513847152643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1310547513825787906] - [estimate_cpc_rr]' />
      </column>
      <column caption='CPC to be Booked' datatype='real' name='[Calculation_1310547513847951364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_1310547513847152643] / ([vendors_cpc_utilization_lm] - 0.1))' />
      </column>
      <column caption='PB Target' datatype='real' name='[Calculation_1310547513879433221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1310547513825492993] * [ads_target]' />
      </column>
      <column caption='PB Gap to Target' datatype='real' name='[Calculation_1310547513879773190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1310547513879433221] - [estimate_pb_rr]' />
      </column>
      <column caption='Estimated PB Bookings' datatype='real' name='[Calculation_1310547513882202119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//condition 1: when it is the current month &#10;IF DATETRUNC(&apos;month&apos;, [report_month]) = DATETRUNC(&apos;month&apos;, TODAY()) &#10;    THEN [Calculation_1310547513879773190] * (DAY(TODAY()) / DAY((DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [report_month]))))))&#10;ELSE [Calculation_1310547513879773190]&#10;END' />
      </column>
      <column caption='Agent Name' datatype='string' name='[Calculation_1337850601597030400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([agent_email], &apos;@&apos;, 1)' />
      </column>
      <column caption='TIll current month' datatype='boolean' name='[Calculation_2831638282627297280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] &lt;= DATETRUNC(&apos;month&apos;, TODAY())' />
      </column>
      <column caption='Estimate Gap To  Target' datatype='real' name='[Calculation_293789527080382472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(-[estimate_gap_to_target]), 0)' />
      </column>
      <column caption='EST Gap To Target Color' datatype='string' name='[PandaPro Gap To Target (copy)_104919812042518529]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([estimate_gap_to_target]) &lt;= 0  THEN &quot;Green&quot; &#10;ELSE &quot;Red&quot; &#10;END' />
      </column>
