          <datasource-dependencies datasource='federated.1mhwlyh1raszaq1299djc0xk41pi'>
            <column caption='CPC Cancelled ASP' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[CPC Realized ASP (copy)_240942604148752389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_329607219880042497]) / COUNTD([vendor_not_cancel_cpc (copy)_240942604148928518])' />
            </column>
            <column caption='CPP Cancelled ASP' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[CPP ASP (copy)_240942604149374984]' role='measure' type='quantitative'>
