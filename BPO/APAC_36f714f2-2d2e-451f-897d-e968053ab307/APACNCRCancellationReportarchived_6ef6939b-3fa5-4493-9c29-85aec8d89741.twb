  <worksheets>
    <worksheet name='Agent Profile Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Regional_ssc_commercial_tableau_ncr_cancellation (pandata_report)' name='federated.1mhwlyh1raszaq1299djc0xk41pi' />
          </datasources>
          <datasource-dependencies datasource='federated.1mhwlyh1raszaq1299djc0xk41pi'>
            <column caption='% CPP Cancel' datatype='real' default-format='p0.00%' name='[% CPC Cancel (copy)_329607220075012122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_329607219879346176]) / ZN([Calculation_329607219881160706])' />
            </column>
            <column caption='% Rebooked Amount (EUR)' datatype='real' default-format='p0.00%' name='[% Rebooked Amount (copy)_48695198560313355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rebook_amount_eur_cancelled]) / SUM(ZN([price_total_eur]))' />
            </column>
            <column caption='Cancelled CPP' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219879346176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [billing_type] = &apos;CPP&apos;&#13;&#10;THEN [price_cancelled_eur]&#13;&#10;END' />
            </column>
            <column caption='Cancelled CPC' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219880042497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [billing_type] = &apos;CPC&apos;&#13;&#10;THEN [price_cancelled_eur]&#13;&#10;END' />
            </column>
            <column caption='Cancelled Total' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219881160706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_329607219880042497]) + ZN([Calculation_329607219879346176])' />
            </column>
            <column caption='vendor_cancel' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_329607219889844228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [status] = &apos;cancelled&apos; &#13;&#10;THEN [vendor_code]&#13;&#10;END' />
            </column>
            <column caption='% Vendor Cancel' datatype='real' default-format='p0.00%' name='[Calculation_329607219890049029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_329607219889844228]) / COUNTD([vendor_code])' />
            </column>
            <column caption='Cancelled Bookings' datatype='date' name='[Calculation_329607220071661590]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF status = &apos;cancelled&apos;&#13;&#10;THEN [realized_date]&#13;&#10;END' />
            </column>
            <column caption='Cancelled ASP' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607220073164824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_329607219881160706])) / COUNTD([Calculation_329607220071661590])' />
            </column>
            <column caption='% CPC Cancel' datatype='real' default-format='p0.00%' name='[Calculation_329607220074332185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_329607219880042497]) / ZN([Calculation_329607219881160706])' />
            </column>
            <column caption='% Amount Cancelled' datatype='real' default-format='p0.00%' name='[Calculation_329607220078977051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([price_cancelled_eur]) / [price_total_eur]' />
            </column>
            <column caption='# of Cancel' datatype='integer' name='[Calculation_329607220080836636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_329607220071661590])' />
            </column>
            <column caption='# of Booked' datatype='integer' name='[Calculation_329607220081152029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([booking_date])' />
            </column>
            <column caption='# Rebooked' datatype='integer' name='[Calculation_48695198563950606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Cancelled Bookings (copy)_48695198563717132])' />
            </column>
            <column caption='Rebooked Vendors' datatype='string' name='[Calculation_954763143564320768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_rebooked] = true&#13;&#10;THEN [vendor_code]&#13;&#10;END' />
            </column>
            <column caption='# Rebooked Vendors' datatype='integer' name='[Calculation_954763143564595201]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_954763143564320768])' />
            </column>
            <column caption='% Rebooked Vendors' datatype='real' default-format='p0.00%' name='[Calculation_954763143565193219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_954763143564595201] / COUNTD([vendor_code])' />
            </column>
            <column caption='Central Cancelled' datatype='boolean' name='[Calculation_954763143659450386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [booking_source] = &apos;Central&apos; AND [status] = &apos;cancelled&apos;&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Central Bookings' datatype='boolean' name='[Calculation_954763143661441043]' role='dimension' type='nominal'>
