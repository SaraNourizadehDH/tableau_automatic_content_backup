      <column caption='date' datatype='integer' name='[Calculation_456271002483269655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then month([realized_date]) * 100 + DAY ([realized_date]) &#13;&#10;    when &apos;week&apos; then ISOWEEK([realized_date])&#13;&#10;    when &apos;month&apos; then month([realized_date])&#13;&#10;end' />
      </column>
      <column caption='Date (i - 1)' datatype='integer' name='[Calculation_456271002485743640]' role='measure' type='quantitative'>
