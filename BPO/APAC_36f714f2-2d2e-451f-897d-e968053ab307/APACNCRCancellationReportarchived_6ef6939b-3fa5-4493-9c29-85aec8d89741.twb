          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Regional_ssc_commercial_tableau_ncr_cancellation (pandata_report)' name='federated.1mhwlyh1raszaq1299djc0xk41pi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Central Cancellation' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;False&quot;'>
              <calculation class='tableau' formula='&quot;False&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mhwlyh1raszaq1299djc0xk41pi'>
            <column caption='Central Cancellation Selection' datatype='string' name='[Calculation_1104789307588534285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Rebooked Amount (Central)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_129759988721278983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [booking_source] = &apos;Central&apos;&#13;&#10;THEN [Calculation_954763143579373575]&#13;&#10;END' />
            </column>
            <column caption='Cancelled CPP' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219879346176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [billing_type] = &apos;CPP&apos;&#13;&#10;THEN [price_cancelled_eur]&#13;&#10;END' />
            </column>
            <column caption='Cancelled CPC' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219880042497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [billing_type] = &apos;CPC&apos;&#13;&#10;THEN [price_cancelled_eur]&#13;&#10;END' />
            </column>
            <column caption='Cancelled Total' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_329607219881160706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_329607219880042497]) + ZN([Calculation_329607219879346176])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([cancel_date]) &lt; 10 then str(YEAR([cancel_date])) + &quot;-0&quot; + str(month([cancel_date]))&#13;&#10;ELSE str(YEAR([cancel_date])) + &quot;-&quot; + str(month([cancel_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([cancel_date]) &lt; 10 then str(ISOYEAR([cancel_date])) + &quot;-W0&quot; + str(ISOWEEK([cancel_date]))&#13;&#10;ELSE str(ISOYEAR([cancel_date])) + &quot;-W&quot; + str(ISOWEEK([cancel_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([cancel_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([cancel_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([cancel_date]))&#13;&#10;end' />
            </column>
            <column caption='Date (cancelled)' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
            <column caption='Price_EUR - Central Cancelled' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_815151556284186624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_954763143659450386] = TRUE&#13;&#10;THEN [price_cancelled_eur]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Rebooked Amount' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_954763143579373575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[rebook_amount_eur]' />
            </column>
            <column caption='Central Cancelled' datatype='boolean' name='[Calculation_954763143659450386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [booking_source] = &apos;Central&apos; AND [status] = &apos;cancelled&apos;&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Central Bookings' datatype='boolean' name='[Calculation_954763143661441043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [booking_source] = &apos;Central&apos;&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Product' datatype='string' name='[billing_type (group)]' role='dimension' type='nominal'>
