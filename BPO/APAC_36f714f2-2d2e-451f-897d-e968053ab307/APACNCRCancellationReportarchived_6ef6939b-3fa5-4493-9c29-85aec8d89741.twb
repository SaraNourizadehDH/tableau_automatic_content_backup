            </column>
            <column caption='Rebooked Bookings' datatype='date' name='[Cancelled Bookings (copy)_48695198563717132]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [is_rebooked] = TRUE&#13;&#10;THEN [realized_date]&#13;&#10;END' />
            </column>
