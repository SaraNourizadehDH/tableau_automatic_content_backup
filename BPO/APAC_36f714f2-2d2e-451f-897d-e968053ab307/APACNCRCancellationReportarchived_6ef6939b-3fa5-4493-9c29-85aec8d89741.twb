            <column caption='% Rebooked Amount' datatype='real' default-format='p0.00%' name='[Rebooked Amount (copy)_954763143589797896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_954763143579373575]) / SUM(ZN([price_total_eur]))' />
