    <worksheet name='Completion Status'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>Completion Status</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pl_tc_growth_plans_status' name='federated.02k7e800e8lhrw16s740e08k0tgo' />
          </datasources>
          <datasource-dependencies datasource='federated.02k7e800e8lhrw16s740e08k0tgo'>
            <column caption='Status' datatype='string' name='[Calculation_1380212555135471623]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [growth_plans_started] = 1 AND [growth_plans_completed] = 1&#10;THEN &apos;Completed&apos;&#10;ELSEIF [growth_plans_started] = 1 AND isnull([growth_plans_completed])&#10;THEN &apos;In Progress&apos;&#10;ELSE &apos;Pending&apos;&#10;END' />
              <aliases>
                <alias key='&quot;Completed&quot;' value='Submitted' />
                <alias key='&quot;In Progress&quot;' value='Started' />
                <alias key='&quot;Pending&quot;' value='Not Started' />
              </aliases>
            </column>
            <column caption='User Filter Calculation' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Calculation_5676224406702333953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;C-Level&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH - Talent Development&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN &#10;    IF [manager_02_full_name] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [manager_02_full_name] &lt;&gt; &apos;Jeri Lynne Doris&apos; &#10;    AND [department] &lt;&gt; &apos;DH People &amp; Culture&apos;&#10;    AND [department] &lt;&gt; &apos;People&apos;&#10; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=[work_email_manager_03] OR USERNAME()=[Calculation_5676224406999412747]&#10; THEN 1 &#10; &#10;ELSEIF USERNAME()=[work_email_manager_04] OR USERNAME()=[user.name (copy)_7943364612254150656]&#10; THEN 1  &#10;    &#10;ELSEIF (ISMEMBEROF(&apos;Pedidos Ya - Administrator&apos;) OR ISMEMBEROF(&apos;PedidosYa - TD&apos;)) THEN &#10;IF [brand]=&apos;PedidosYa&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;PedidosYa - People Partners&apos;) OR &#10;&#9;ISMEMBEROF(&apos;PedidosYa - People Partners - Argentina&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Bolivia&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Chile&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Contact Center&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Costa Rica&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Dominican Republic&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Ecuador&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - El Salvador&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Guatemala&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Honduras&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Nicaragua&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Non Tech&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Panamá&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Paraguay&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Perú&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Tech&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Uruguay&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partner T&amp;P&apos;)OR &#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Venezuela&apos;)&#10;    )&#10;THEN &#10;IF [brand]=&apos;PedidosYa&apos; AND [department] &lt;&gt; &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Talabat - Administrator&apos;) OR&#10;     ISMEMBEROF(&apos;Talabat - Talent &amp; Development&apos;)) THEN&#10;IF [brand]=&apos;Talabat&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Talabat - People Partner&apos;)&#10;THEN&#10;IF [brand]=&apos;Talabat&apos;AND ([department] &lt;&gt; &apos;People &amp; Culture&apos; OR [department] &lt;&gt; &apos;People and Culture&apos; OR [department] &lt;&gt; &apos;People Operations&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Hungerstation - Administrator&apos;) OR&#10;    ISMEMBEROF(&apos;Hungerstation - Talent Development&apos;))THEN &#10;    IF [brand]=&apos;Hungerstation&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Hungerstation - People Partners&apos;)&#10;THEN&#10;IF [brand]=&apos;Hungerstation&apos; AND [department] &lt;&gt; &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH Europe - Talent Development&apos;)&#10;THEN&#10;IF [brand] = &apos;Foodora&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;DH Europe - People Partners&apos;) OR ISMEMBEROF(&apos;DH Europe - Foodora - People Partners&apos;))&#10;THEN&#10;IF [brand] = &apos;Foodora&apos; AND ([department] &lt;&gt; &apos;People &amp; Culture&apos; OR [department] &lt;&gt; &apos;HR&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Foodpanda - Administrator&apos;) OR ISMEMBEROF(&apos;Foodpanda - OPD&apos;)) THEN&#10;IF [brand]=&apos;Foodpanda&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Foodpanda - PP - Biz Platform&apos;) OR ISMEMBEROF(&apos;Foodpanda - PP - T&amp;P&apos;))&#10;THEN&#10;IF ([brand]=&apos;Foodpanda&apos; AND NOT (CONTAINS([department], &apos;People&apos;) OR CONTAINS([department], &apos;PEOPLE&apos;) OR CONTAINS([department], &apos;HR&apos;))) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;eFood - Talent Development&apos;) OR&#10;    ISMEMBEROF(&apos;eFood - People Partners&apos;))&#10;THEN&#10;IF [brand]=&apos;EFood&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;foody - P&amp;C&apos;) THEN &#10;IF [brand]=&apos;Foody&apos; THEN 1 ELSE 0 END&#10;&#10;END)' />
            </column>
