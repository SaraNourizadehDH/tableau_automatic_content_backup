                </bin>
                <bin default-name='false' value='&quot;S Track&quot;'>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                  <value>&quot;S3&quot;</value>
                  <value>&quot;S4&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Actual' datatype='integer' name='[actual]' role='measure' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column aggregation='Count' caption='Date Month' datatype='datetime' datatype-customized='true' name='[date_month]' role='dimension' type='ordinal' />
