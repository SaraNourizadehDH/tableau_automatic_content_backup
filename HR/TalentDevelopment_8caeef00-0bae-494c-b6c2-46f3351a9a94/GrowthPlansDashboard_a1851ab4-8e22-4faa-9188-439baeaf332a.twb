OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Non Tech&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Panamá&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Paraguay&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Perú&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Tech&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Uruguay&apos;) OR&#10;    ISMEMBEROF(&apos;PedidosYa - People Partner T&amp;P&apos;)OR &#10;    ISMEMBEROF(&apos;PedidosYa - People Partners - Venezuela&apos;)&#10;    )&#10;THEN &#10;IF [brand]=&apos;PedidosYa&apos; AND [department] &lt;&gt; &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Talabat - Administrator&apos;) OR&#10;     ISMEMBEROF(&apos;Talabat - Talent &amp; Development&apos;)) THEN&#10;IF [brand]=&apos;Talabat&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Talabat - People Partner&apos;)&#10;THEN&#10;IF [brand]=&apos;Talabat&apos;AND ([department] &lt;&gt; &apos;People &amp; Culture&apos; OR [department] &lt;&gt; &apos;People and Culture&apos; OR [department] &lt;&gt; &apos;People Operations&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Hungerstation - Administrator&apos;) OR&#10;    ISMEMBEROF(&apos;Hungerstation - Talent Development&apos;))THEN &#10;    IF [brand]=&apos;Hungerstation&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Hungerstation - People Partners&apos;)&#10;THEN&#10;IF [brand]=&apos;Hungerstation&apos; AND [department] &lt;&gt; &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH Europe - Talent Development&apos;)&#10;THEN&#10;IF [brand] = &apos;Foodora&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;DH Europe - People Partners&apos;) OR ISMEMBEROF(&apos;DH Europe - Foodora - People Partners&apos;))&#10;THEN&#10;IF [brand] = &apos;Foodora&apos; AND ([department] &lt;&gt; &apos;People &amp; Culture&apos; OR [department] &lt;&gt; &apos;HR&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Foodpanda - Administrator&apos;) OR ISMEMBEROF(&apos;Foodpanda - OPD&apos;)) THEN&#10;IF [brand]=&apos;Foodpanda&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;Foodpanda - PP - Biz Platform&apos;) OR ISMEMBEROF(&apos;Foodpanda - PP - T&amp;P&apos;))&#10;THEN&#10;IF ([brand]=&apos;Foodpanda&apos; AND NOT (CONTAINS([department], &apos;People&apos;) OR CONTAINS([department], &apos;PEOPLE&apos;) OR CONTAINS([department], &apos;HR&apos;))) THEN 1 ELSE 0 END&#10;&#10;ELSEIF (ISMEMBEROF(&apos;eFood - Talent Development&apos;) OR&#10;    ISMEMBEROF(&apos;eFood - People Partners&apos;))&#10;THEN&#10;IF [brand]=&apos;EFood&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;foody - P&amp;C&apos;) THEN &#10;IF [brand]=&apos;Foody&apos; THEN 1 ELSE 0 END&#10;&#10;END)' />
