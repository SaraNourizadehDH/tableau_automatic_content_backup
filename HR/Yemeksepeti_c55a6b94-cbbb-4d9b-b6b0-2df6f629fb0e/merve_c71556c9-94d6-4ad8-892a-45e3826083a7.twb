          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='# IC' datatype='integer' default-format='n#,##0;-#,##0' name='[# Female (copy)_1132373832864186368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([management_level],&quot;IC&quot;) = TRUE THEN [actual] ELSE 0 END)' />
            </column>
            <column caption='# Central' datatype='integer' default-format='n#,##0;-#,##0' name='[# Field Ops (copy)_1132373833196032015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5354217041970921476] - [# S (copy)_1132373832865562630]' />
            </column>
            <column caption='# M' datatype='integer' default-format='n#,##0;-#,##0' name='[# IC (copy)_1132373832864681985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([management_level],&quot;M&quot;) = TRUE THEN [actual] ELSE 0 END)' />
            </column>
            <column caption='# S' datatype='integer' default-format='n#,##0;-#,##0' name='[# M (copy)_1132373832864743426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([management_level],&quot;S&quot;) = TRUE THEN [actual] ELSE 0 END)' />
            </column>
            <column caption='# Field Ops' datatype='integer' default-format='n#,##0;-#,##0' name='[# S (copy)_1132373832865562630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([Calculation_1132373832878227464],&quot;Field Ops&quot;) = TRUE THEN [actual] ELSE 0 END)' />
            </column>
            <column caption='% IC' datatype='real' default-format='p0.0%' name='[% Female (copy)_1132373832865239043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Female (copy)_1132373832864186368] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='% S' datatype='real' default-format='p0.0%' name='[% IC (copy) (copy)_1132373832865349637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# M (copy)_1132373832864743426] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='% M' datatype='real' default-format='p0.0%' name='[% IC (copy)_1132373832865337348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# IC (copy)_1132373832864681985] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='% Field Ops' datatype='real' default-format='p0.0%' name='[% S (copy)_1132373832866107399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# S (copy)_1132373832865562630] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='2. Demographic Metrics' datatype='integer' name='[1. Workforce Metrics (copy)_1840564874082492419]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if PREVIOUS_VALUE(0) = 1 then 1 else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Workforce' datatype='string' name='[Calculation_1132373832878227464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [systems] = &apos;Bamboo&apos; THEN &apos;Field Ops&apos;&#13;&#10;ELSEIF [systems] = &apos;Workday&apos; AND CONTAINS([warehouse_office_location],&quot;Banabi&quot;) = TRUE THEN &apos;Field Ops&apos;&#13;&#10;ELSE &apos;Central Office&apos;&#13;&#10;END' />
            </column>
            <column caption='Metric to Display 1' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1132373833183485961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;# HC Actual&quot; THEN [Calculation_5354217041970921476]&#13;&#10;    WHEN &quot;# Starters&quot; THEN [Calculation_1132373833185587210]&#13;&#10;    WHEN &quot;# Terminations Effective&quot; THEN [Calculation_5354217041967976449]&#13;&#10;    WHEN &quot;% Attrition&quot; THEN [Calculation_4788593076217315329]*100&#13;&#10;    WHEN &quot;% Attrition YTD&quot; THEN [Calculation_1132373833186177035] *100&#13;&#10;    WHEN &quot;Avg Promotion Speed (m)&quot; THEN [Calculation_4788593076216713216]&#13;&#10;    WHEN &quot;# M-level&quot; THEN [# IC (copy)_1132373832864681985] &#13;&#10;    WHEN &quot;# IC-level&quot; THEN [# Female (copy)_1132373832864186368]&#13;&#10;    WHEN &quot;# S-level&quot; THEN [# M (copy)_1132373832864743426]&#13;&#10;    WHEN &quot;# Central&quot; THEN [# Field Ops (copy)_1132373833196032015]&#13;&#10;    WHEN &quot;# Field Ops&quot; THEN [# S (copy)_1132373832865562630]&#13;&#10;    WHEN &quot;Avg Age (y)&quot; THEN [Calculation_1132373833190174732] &#13;&#10;    WHEN &quot;Avg Tenure (y)&quot; THEN [Calculation_4788593076219265028]&#13;&#10;    WHEN &quot;# Female&quot; THEN [Calculation_1840564874080342016]&#13;&#10;    WHEN &quot;% Female&quot; THEN [Calculation_1840564874080501761] *100&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Starters' datatype='integer' name='[Calculation_1132373833185587210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([starters])' />
            </column>
            <column caption='% Attrition YTD' datatype='real' name='[Calculation_1132373833186177035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Calculation_4788593076217315329])'>
                <table-calc level-break='[federated.05r9snf0pm3fk91dop2ed0zgusim].[qr:month:ok]' ordering-field='[federated.05r9snf0pm3fk91dop2ed0zgusim].[month]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Avg Age (y)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1132373833190174732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_age] * ([actual]+[terminations_effective]))&#13;&#10;/&#13;&#10;SUM(([actual]+[terminations_effective]))' />
            </column>
            <column caption='# Female' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1840564874080342016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [gender] = &apos;Female&apos; THEN [actual] ELSE 0 END)' />
            </column>
            <column caption='% Female' datatype='real' default-format='p0.0%' name='[Calculation_1840564874080501761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1840564874080342016] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='1. Workforce Metrics' datatype='integer' name='[Calculation_1840564874080976898]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if PREVIOUS_VALUE(0) = 1 then 1 else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Promotion Speed (m)' datatype='real' name='[Calculation_4788593076216713216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([promotion_speed] * [promotion_count])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([promotion_count]))&#13;&#10;&#13;&#10;/30' />
            </column>
            <column caption='% Attrition' datatype='real' name='[Calculation_4788593076217315329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5354217041967976449] / [Calculation_5354217041970921476]' />
            </column>
            <column caption='Avg Tenure (y)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4788593076219265028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_tenure] * ([actual] + [terminations_effective]))&#13;&#10;/&#13;&#10;SUM(([actual] + [terminations_effective]))' />
            </column>
            <column caption='# Terminations Effective' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5354217041967976449]' role='measure' type='quantitative'>
