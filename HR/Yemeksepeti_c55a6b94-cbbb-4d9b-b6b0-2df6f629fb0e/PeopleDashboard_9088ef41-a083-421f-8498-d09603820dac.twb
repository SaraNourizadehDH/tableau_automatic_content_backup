      <column caption='Terminations_Yearly' datatype='integer' name='[Calculation_1230819763904086031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(Sum([terminations_effective]),-11,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Yearly Headcount' datatype='real' name='[Calculation_1230819763909505040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([actual]),-11,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Turnover Rate (Yearly)(All)' datatype='real' datatype-customized='true' name='[Calculation_1230819763910021137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1230819763904086031]/[Calculation_1230819763909505040]'>
