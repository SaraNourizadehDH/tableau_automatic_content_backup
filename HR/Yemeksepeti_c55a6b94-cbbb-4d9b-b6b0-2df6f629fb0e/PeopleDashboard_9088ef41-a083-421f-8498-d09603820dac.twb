              <calculation class='tableau' formula='case [management_level]&#10;when &quot;IC1&quot; then &quot;IC&quot;&#10;when &quot;IC2&quot; then &quot;IC&quot;&#10;when &quot;IC3&quot; then &quot;IC&quot;&#10;when &quot;IC4&quot; then &quot;IC&quot;&#10;when &quot;IC5&quot; then &quot;IC&quot;&#10;when &quot;IC6&quot; then &quot;IC&quot;&#10;when &quot;S1&quot; then &quot;S&quot;&#10;when &quot;S2&quot; then &quot;S&quot;&#10;when &quot;S3&quot; then &quot;S&quot;&#10;when &quot;S4&quot; then &quot;S&quot;&#10;when &quot;M1&quot; then &quot;M&quot;&#10;when &quot;M2&quot; then &quot;M&quot;&#10;when &quot;M3&quot; then &quot;M&quot;&#10;when &quot;M4&quot; then &quot;M&quot;&#10;when &quot;M5&quot; then &quot;M&quot;&#10;when &quot;M6&quot; then &quot;M&quot;&#10;&#10;END' />
