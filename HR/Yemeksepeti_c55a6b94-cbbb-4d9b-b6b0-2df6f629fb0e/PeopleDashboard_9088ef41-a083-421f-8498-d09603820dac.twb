          </datasources>
          <datasource-dependencies datasource='federated.1nyn1ce16ie46s177b0ui1j6dajd'>
            <column caption='Filter' datatype='string' name='[Calculation_1230819763925643283]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  DATE([date_month])&lt;=DATE(TODAY())&#10;Then &apos;Show&apos;&#10;Else &apos;Hide&apos;&#10;END' />
            </column>
            <column caption='Brand - Calculated' datatype='string' name='[Calculation_1751618781855780887]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [company_id]&#10;&#10;when &quot;1001&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1014&quot; then &quot;foodora&quot;&#10;when &quot;1050&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1051&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1052&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1053&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1055&quot; then &quot;Delivery Hero&quot;&#10;when &quot;1301&quot; then &quot;foodora&quot;&#10;when &quot;1303&quot; then &quot;foodora&quot;&#10;when &quot;1305&quot; then &quot;foodora&quot;&#10;when &quot;1541&quot; then &quot;foodora&quot;&#10;when &quot;1601&quot; then &quot;foodora&quot;&#10;when &quot;1602&quot; then &quot;foodora&quot;&#10;when &quot;2006&quot; then &quot;foodora&quot;&#10;when &quot;2009&quot; then &quot;foodora&quot;&#10;when &quot;2101&quot; then &quot;foodora&quot;&#10;when &quot;2105&quot; then &quot;foodora&quot;&#10;when &quot;2203&quot; then &quot;foodora&quot;&#10;when &quot;2402&quot; then &quot;foodora&quot;&#10;when &quot;2403&quot; then &quot;foodora&quot;&#10;when &quot;2405&quot; then &quot;foodora&quot;&#10;when &quot;2421&quot; then &quot;foodora&quot;&#10;when &quot;8701&quot; then &quot;Yemeksepeti&quot;&#10;when &quot;8702&quot; then &quot;Yemeksepeti&quot;&#10;when &quot;8703&quot; then &quot;Yemeksepeti&quot;&#10;when &quot;8704&quot; then &quot;Yemeksepeti&quot;&#10;when &quot;8706&quot; then &quot;Yemeksepeti&quot;&#10;else NULL&#10;END' />
