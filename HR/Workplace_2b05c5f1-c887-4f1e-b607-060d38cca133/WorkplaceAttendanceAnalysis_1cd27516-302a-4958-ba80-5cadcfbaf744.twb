                    <column datatype='integer' name='eligible_for_analysis' ordinal='16' />
                    <column datatype='integer' name='noOfMonths' ordinal='17' />
                    <column datatype='integer' name='noOfAttendedDays' ordinal='18' />
                    <column datatype='integer' name='noOfMondays' ordinal='19' />
