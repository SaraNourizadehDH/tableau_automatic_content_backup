      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Average Monthly Attendance' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Detailed Attendance Behaviour' datatype='string' name='[Attendance Behaviour (copy)_482448167529512962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_151996539869614080] &lt;1 THEN &apos;Less than once a month &apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_151996539869614080] &lt; 3 THEN &apos;Once a month&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_151996539869614080] &lt; 5 THEN &apos;Once a week&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_151996539869614080] &lt; 10 THEN &apos;Twice per week&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_151996539869614080] &gt;= 10 THEN &apos;Thrice per week&apos;&#13;&#10;&#13;&#10;ELSE &apos;Error&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Less than once a month &quot;' value='BE - Less than once a month ' />
                <alias key='&quot;Once a month&quot;' value='BE - Once a month' />
                <alias key='&quot;Once a week&quot;' value='ME - Once a week' />
                <alias key='&quot;Thrice per week&quot;' value='AE - Thrice per week' />
                <alias key='&quot;Twice per week&quot;' value='AE - Twice per week' />
              </aliases>
            </column>
            <column caption='Avg. Attendance' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_151996539869614080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;&#13;&#10;IF ROUND([noOfAttendedDays]/[Calculation_151996539883843589],0) &lt; 0 THEN 0 &#13;&#10;ELSEIF ROUND([noOfAttendedDays]/[Calculation_151996539883843589],0) &gt; 20 THEN 20&#13;&#10;ELSE ROUND([noOfAttendedDays]/[Calculation_151996539883843589],0)&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;)' />
            </column>
            <column caption='# of Employees' datatype='integer' name='[Calculation_151996539869982722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([employee_id])' />
            </column>
            <column caption='Attendance Behaviour' datatype='string' name='[Calculation_151996539871510531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_151996539869614080] &lt;3 THEN &apos;Below Expectations&apos;&#13;&#10;ELSEIF [Calculation_151996539869614080] &gt;4 THEN &apos;Above Expectations&apos;&#13;&#10;ELSE &apos;Meets Expectations&apos;&#13;&#10;END' />
            </column>
            <column caption='Months Present' datatype='real' name='[Calculation_151996539883843589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(IF [noOfMonths] = 0 THEN 0&#13;&#10;ELSE [noOfMonths] - [Calculation_151996539885453318]&#13;&#10;END)' />
            </column>
            <column caption='Months On Leave H1' datatype='real' name='[Calculation_151996539885453318]' role='measure' type='quantitative'>
