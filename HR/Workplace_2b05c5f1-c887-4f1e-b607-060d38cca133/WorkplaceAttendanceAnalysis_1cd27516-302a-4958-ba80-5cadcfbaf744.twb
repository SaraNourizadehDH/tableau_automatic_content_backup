        <column caption='Management Level Sub Group' datatype='string' name='[Calculation_584905060437254144]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [employee_id] = &apos;2020-04-0178&apos; THEN &apos;IC3-IC6&apos; ELSE [Management Level (group)] END' />
        </column>
        <column caption='Department' datatype='string' name='[Department (group)]' role='dimension' type='nominal'>
