            <bin default-name='false' value='&quot;Product&quot;'>
              <value>&quot;DH Product&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Tech&quot;'>
              <value>%null%</value>
              <value>&quot;DH Tech&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='Department cc' datatype='string' name='[department (Cost Center Mapping - Department and Sub Departments.csv)]' role='dimension' type='nominal' />
