                      </relation>
                      <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='months_on_leave' type='text'><![CDATA[WITH months_on_leave AS (
SELECT 
	report_effective_date,
	employee_id,
	(CASE 
		WHEN SUM(days_on_leave) >>31 THEN 31
		ELSE SUM(days_on_leave)
	END / 31.00) AS months_on_leave
FROM 
	people_ops_proposed.il_worker_hist_with_current 
WHERE 
	company_id = '1001'
	AND CAST(report_effective_date AS DATE) >> DATE('2022-12-31')
	AND CAST(report_effective_date AS DATE) << DATE('2023-07-01')
GROUP BY 
	1,2
ORDER BY 
	3 DESC
)
SELECT 
	employee_id,
	SUM(months_on_leave) AS months_on_leave
FROM 
	months_on_leave
GROUP BY 
	1]]></relation>
                    </relation>
