            </column>
            <column caption='% of Employees Present' datatype='real' default-format='p0.0%' name='[Calculation_2959498297352753160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_2959498297338544131]' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_2959498297353265162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Audience Group&apos; THEN [Audience (group)]&#10;    WHEN &apos;Audience&apos; THEN [Calculation_2959498297335939073]&#10;    WHEN &apos;Department&apos; THEN [Reporting Field]&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#10;    WHEN &apos;Management Level&apos; THEN [Calculation_2959498297356046347]&#10;    WHEN &apos;C Level&apos; THEN [manager_02_full_name]&#10;    WHEN &apos;Location&apos; THEN [Office Location Country (group)]&#10;END' />
            </column>
            <column caption='Management Level' datatype='string' name='[Calculation_2959498297356046347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([management_level]) = TRUE THEN [management_level_as_of_hire_date] ELSE [management_level] END' />
