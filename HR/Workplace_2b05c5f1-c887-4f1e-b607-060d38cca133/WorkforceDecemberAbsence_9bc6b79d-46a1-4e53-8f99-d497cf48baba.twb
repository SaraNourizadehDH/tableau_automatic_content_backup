        </column>
        <column caption='Location' datatype='string' name='[Office Location Country (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='categorical-bin' column='[office_location_country]' new-bin='true'>
