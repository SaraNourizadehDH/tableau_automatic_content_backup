              <calculation class='tableau' formula='[Calculation_2959498297331617792] - [Calculation_2959498297337741314]' />
            </column>
            <column caption='Audience Group' datatype='string' name='[Audience (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_2959498297335939073]' new-bin='true'>
                <bin default-name='false' value='&quot;Delivery Hero&quot;'>
                  <value>&quot;Business&quot;</value>
                  <value>&quot;CEO &amp; Strategy&quot;</value>
                  <value>&quot;OEC&quot;</value>
                  <value>&quot;People&quot;</value>
                  <value>&quot;Product&quot;</value>
                  <value>&quot;Tech&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Pandora&quot;'>
                  <value>&quot;Pandora&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Turkey Tech Hub&quot;'>
                  <value>&quot;Turkey Tech Hub&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='# Employees' datatype='integer' name='[Calculation_2959498297331617792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( [ID] )' />
            </column>
            <column caption='Audience' datatype='string' name='[Calculation_2959498297335939073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company_id] = &apos;8706&apos; THEN &apos;Turkey Tech Hub&apos;&#10;ELSE [Reporting Field]&#10;END' />
            </column>
            <column caption='# Employees Absent' datatype='integer' name='[Calculation_2959498297337741314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Parameters].[Parameter 1] = [time_off_date] THEN [employee_id] ELSE NULL END)' />
            </column>
            <column caption='% of Employees Absent' datatype='real' default-format='p0.0%' name='[Calculation_2959498297338544131]' role='measure' type='quantitative'>
