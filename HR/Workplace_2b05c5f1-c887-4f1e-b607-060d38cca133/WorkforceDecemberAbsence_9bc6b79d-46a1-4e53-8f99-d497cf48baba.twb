              <calculation class='tableau' formula='#2023-12-18#' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Audience Group&quot;'>
              <calculation class='tableau' formula='&quot;Audience Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t6ov071uiufzu12mjd0t0ymw7x7'>
