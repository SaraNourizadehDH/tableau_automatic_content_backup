      </column>
      <column caption='Shape for Female Velocity Diff' datatype='string' name='[Calculation_2148850396351422465]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2148850396349382656] &gt;= 1 then &apos;up&apos; &#10;ELSEIF [Calculation_2148850396349382656] &gt; -1 and [Calculation_2148850396349382656] &lt; 1 then &apos;straight&apos; &#10;else &apos;down&apos; end' />
      </column>
      <column caption='Promotion %' datatype='real' name='[Calculation_253116418241929217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_promotions])/avg([actual])' />
      </column>
      <column caption='Female Promotion %' datatype='real' name='[Calculation_253116418259574787]' role='measure' type='quantitative'>
