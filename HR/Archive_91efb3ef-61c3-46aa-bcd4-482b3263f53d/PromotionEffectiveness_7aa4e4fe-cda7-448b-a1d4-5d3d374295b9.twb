        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[:Measure Names]' />
              <tooltip column='[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[sum:total_promotions_female:qk]' />
              <tooltip column='[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[sum:total_promotions_male:qk]' />
              <text column='[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[Multiple Values]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#787878'>Promotion Quarter:&#9;</run>
                <run bold='true'><![CDATA[<[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[tqr:promotion_quarter:ok]>]]></run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#666666'>Only  </run>
                <run bold='true' fontcolor='#282c35'><![CDATA[<[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[sum:total_promotions_female:qk]> ]]></run>
                <run fontcolor='#282c35'>female hires after 2019 are included in the calculation of promotion velocity</run>
                <run>Æ&#10;</run>
                <run fontcolor='#282c35'>Only </run>
                <run fontcolor='#666666'>Æ </run>
                <run bold='true' fontcolor='#282c35'><![CDATA[<[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[sum:total_promotions_male:qk]> ]]></run>
                <run fontcolor='#282c35'>male hires after 2019 are included in the calculation of promotion velocity</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#e00012'><![CDATA[<[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[:Measure Names]>:	]]></run>
                <run bold='true' fontcolor='#e00012'><![CDATA[<[federated.1xmg3xp1qpazme13lwxtc1xi67a2].[Multiple Values]>]]></run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#282c35' italic='true'>The total number of promotions might differ from the tab </run>
                <run fontcolor='#282c35' italic='true' underline='true'>2 - Promotions - Department. </run>
                <run fontcolor='#282c35' italic='true'>This is because the promotion process was kiccked off in Workday in 2019 and the employees who were promoted offline do not have a promotion date entered in the system. Since the calculation of promotion velocity relies on knowing this date, we exclude all the employees who were hired before 2019. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#282c35' italic='true'>Example: employee A was hired in 2017 and was promoted twoce: in 2018 and in 2020. Theoretically, the promotion velocity of this employee should be avg(1 year+2 years) = 1,5 year. However, since only the promotion that took place in 2020 was entered into the system, the promotion velocity of this employee will be shown as  3 years (promotion date tracked in Workday - hire date). This high numbers will deviate the real promotion velocity that&apos;s why only the employees with the hire date after 2019 are included in the calculation of the promotion velocity.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='cell'>
                <format attr='vertical-align' value='center' />
              </style-rule>
              <style-rule element='datalabel'>
                <format attr='color-mode' value='auto' />
              </style-rule>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-transparency' value='255' />
              </style-rule>
            </style>
          </pane>
        </panes>
