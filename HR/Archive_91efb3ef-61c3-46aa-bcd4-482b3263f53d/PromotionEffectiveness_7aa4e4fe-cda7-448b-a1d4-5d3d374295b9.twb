      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[promotion].[employee_id]' />
                      <expression op='[Custom SQL Query].[employee_id]' />
                    </expression>
                    <expression op='='>
                      <expression op='[promotion].[promotion_quarter]' />
                      <expression op='[Custom SQL Query].[performance_review_quarter]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[promotion].[nationality]' />
                      <expression op='[nationality].[nationality]' />
                    </expression>
                  </clause>
                  <relation join='inner' type='join'>
                    <clause type='join'>
                      <expression op='='>
                        <expression op='[promotion].[cost_center_id]' />
                        <expression op='[cc_hierarchy_all].[cost_center_id]' />
                      </expression>
                    </clause>
                    <relation connection='athena.1rsc6y91jzjpky1chfd131ew3t1o' name='promotion' table='[people_ops_il].[promotion]' type='table' />
                    <relation connection='athena.1rsc6y91jzjpky1chfd131ew3t1o' name='cc_hierarchy_all' table='[people_ops_il].[cc_hierarchy_all]' type='table' />
                  </relation>
                  <relation connection='athena.1rsc6y91jzjpky1chfd131ew3t1o' name='nationality' type='text'>select nationality, count(*) as nationality_count 
from people_ops_il.worker
where company_id = &apos;1001&apos; and (last_day_of_work is null or last_day_of_work &gt;&gt; current_date)
group by nationality</relation>
                </relation>
                <relation connection='athena.1rsc6y91jzjpky1chfd131ew3t1o' name='Custom SQL Query' type='text'>select case 
when review_template = &apos;End of Year Performance Check-in 2019&apos; then date(&apos;2020-01-01&apos;)
when review_template = &apos;Performance Review June/July 2020&apos; then date(&apos;2020-07-01&apos;)
when review_template = &apos;2020 End of year Performance Review&apos; then date(&apos;2021-01-01&apos;) end as performance_review_quarter,
employee_id, manager_rating 
from people_ops_il.performance</relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
