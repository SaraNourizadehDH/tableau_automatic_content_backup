      <table>
        <view>
          <datasources>
            <datasource caption='promotion_hires (dev)' name='federated.1xmg3xp1qpazme13lwxtc1xi67a2' />
          </datasources>
          <datasource-dependencies datasource='federated.1xmg3xp1qpazme13lwxtc1xi67a2'>
            <column caption='Promotion Velocity Diff' datatype='real' name='[Calculation_2148850396349382656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_390898419621777409 1] - [Calculation_390898419622076418 1]' />
            </column>
            <column caption='Shape for Female Velocity Diff' datatype='string' name='[Calculation_2148850396351422465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_2148850396349382656] &gt;= 1 then &apos;up&apos; &#10;ELSEIF [Calculation_2148850396349382656] &gt; -1 and [Calculation_2148850396349382656] &lt; 1 then &apos;straight&apos; &#10;else &apos;down&apos; end' />
            </column>
            <column caption='Velocity' datatype='real' name='[Calculation_390898419621158912 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([avg_promotion_speed]/30)' />
            </column>
            <column caption='Female Velocity' datatype='real' name='[Calculation_390898419621777409 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([avg_promotion_speed_female]/30)' />
            </column>
            <column caption='Male Velocity' datatype='real' name='[Calculation_390898419622076418 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([avg_promotion_speed_male]/30)' />
            </column>
            <column datatype='real' name='[avg_promotion_speed]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_promotion_speed_female]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_promotion_speed_male]' role='measure' type='quantitative' />
