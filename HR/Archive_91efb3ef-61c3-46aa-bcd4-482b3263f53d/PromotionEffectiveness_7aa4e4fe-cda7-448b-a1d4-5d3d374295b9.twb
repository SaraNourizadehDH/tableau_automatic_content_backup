            <column caption='Eligible' datatype='string' name='[Calculation_1463458775252131846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if TODAY() &gt; DATEADD(&apos;month&apos;, [Parameters].[Parameter 2], [first_day_of_work]) then &apos;yes&apos; else &apos;no&apos; end' />
