      <filter class='categorical' column='[c_level]' filter-group='2'>
        <groupfilter from='&quot;Finance DHSE (Emmanuel Thomassin)&quot;' function='range' level='[c_level]' to='&quot;Tech DHSE (Christian Hardenberg)&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[gender]' filter-group='2'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[gender]' member='&quot;Female&quot;' />
          <groupfilter function='member' level='[gender]' member='&quot;Male&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4FDA67DE49FD4CBD8EBACD7EBD03C263'>
            <properties context=''>
              <relation connection='athena.0650j190jl6x8714jevru1xeuccc' name='Custom SQL Query' type='text'>WITH salary_employees AS
(SELECT
wo.employee_id,
wo.c_level,
wo.job_family_group,
wo.job_family,
wo.is_tech,
wo.management_level,
wp.gender,
s.job_profile,
s.salary_amount_annualized,
s.min_salary_range,
s.mid_salary_range,
s.max_salary_range,
s.last_updated

FROM people_ops_proposed.il_worker_org wo

LEFT JOIN people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wo.employee_id
	
LEFT JOIN people_ops_proposed.il_salary s
	ON s.employee_id = wo.employee_id

WHERE wo.is_terminated = 0
	AND wo.company_id = &apos;1001&apos;
),

stocks AS(
SELECT
	sg.employee_id,
	SUM(CAST(sg.granted_amount AS DOUBLE)) AS granted_amount
FROM people_ops_proposed.il_stock_grant sg
WHERE sg.stock_plan NOT LIKE &apos;Hero Grant%&apos;
GROUP BY 1
)

SELECT 
* 
FROM salary_employees se

LEFT JOIN stocks s
	USING (employee_id)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
