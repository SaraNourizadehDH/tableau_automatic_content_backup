            <run fontalignment='1' fontcolor='#000000' fontsize='8'> vs Female CR</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='# - Compa Ratio (Males)' datatype='real' name='[# - Compa Ratio (Male) (copy)_3943042215332999182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gender] = &apos;Male&apos; THEN [salary_amount_annualized]/[mid_salary_range] end' />
            </column>
            <column caption='# - Compa Ratio (Female)' datatype='real' name='[Calculation_3943042215332478989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gender] = &apos;Female&apos; THEN [salary_amount_annualized]/[mid_salary_range] end' />
            </column>
            <column caption='# - CR Male vs Female' datatype='real' name='[Calculation_3943042215333572623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([# - Compa Ratio (Male) (copy)_3943042215332999182]))-(avg([Calculation_3943042215332478989]))' />
            </column>
            <column-instance column='[# - Compa Ratio (Male) (copy)_3943042215332999182]' derivation='Avg' name='[avg:# - Compa Ratio (Male) (copy)_3943042215332999182:qk]' pivot='key' type='quantitative' />
