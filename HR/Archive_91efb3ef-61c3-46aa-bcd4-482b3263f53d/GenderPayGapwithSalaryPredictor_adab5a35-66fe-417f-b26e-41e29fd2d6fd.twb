      <column caption='# - Mean Female Salaries' datatype='real' name='[# - Mean Male Salaries (copy)_5818932197883850753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3943042215286181891] &gt; 1 THEN AVG([Calculation_3943042215309475848]) ELSE NULL END' />
