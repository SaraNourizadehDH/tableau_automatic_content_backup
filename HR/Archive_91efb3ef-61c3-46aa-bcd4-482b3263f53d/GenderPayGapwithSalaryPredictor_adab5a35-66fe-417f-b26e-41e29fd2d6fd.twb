        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.0650j190jl6x8714jevru1xeuccc' name='Custom SQL Query' type='text'>WITH salary_employees AS
(SELECT
wo.employee_id,
wo.c_level,
wo.job_family_group,
wo.job_family,
wo.is_tech,
wo.management_level,
wp.gender,
s.job_profile,
s.salary_amount_annualized,
s.min_salary_range,
s.mid_salary_range,
s.max_salary_range,
s.last_updated

FROM people_ops_proposed.il_worker_org wo

LEFT JOIN people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wo.employee_id
	
LEFT JOIN people_ops_proposed.il_salary s
	ON s.employee_id = wo.employee_id

WHERE wo.is_terminated = 0
	AND wo.company_id = &apos;1001&apos;
),

stocks AS(
SELECT
	sg.employee_id,
	SUM(CAST(sg.granted_amount AS DOUBLE)) AS granted_amount
FROM people_ops_proposed.il_stock_grant sg
WHERE sg.stock_plan NOT LIKE &apos;Hero Grant%&apos;
GROUP BY 1
)

SELECT 
* 
FROM salary_employees se

LEFT JOIN stocks s
	USING (employee_id)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.0650j190jl6x8714jevru1xeuccc' name='Custom SQL Query' type='text'>WITH salary_employees AS
(SELECT
wo.employee_id,
wo.c_level,
wo.job_family_group,
wo.job_family,
wo.is_tech,
wo.management_level,
wp.gender,
s.job_profile,
s.salary_amount_annualized,
s.min_salary_range,
s.mid_salary_range,
s.max_salary_range,
s.last_updated

FROM people_ops_proposed.il_worker_org wo

LEFT JOIN people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wo.employee_id
	
LEFT JOIN people_ops_proposed.il_salary s
	ON s.employee_id = wo.employee_id

WHERE wo.is_terminated = 0
	AND wo.company_id = &apos;1001&apos;
),

stocks AS(
SELECT
	sg.employee_id,
	SUM(CAST(sg.granted_amount AS DOUBLE)) AS granted_amount
FROM people_ops_proposed.il_stock_grant sg
WHERE sg.stock_plan NOT LIKE &apos;Hero Grant%&apos;
GROUP BY 1
)

SELECT 
* 
FROM salary_employees se

LEFT JOIN stocks s
	USING (employee_id)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
