    <worksheet name='# Pay Gap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>Gender Pay Gap</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#cb001c' fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.1mxslha005o3dj12huq9u1xzd2no].[usr:Calculation_3943042215310258186:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='8'><![CDATA[<[federated.1mxslha005o3dj12huq9u1xzd2no].[usr:Calculation_3943042215311220747:qk]> ]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='8'>vs German Market </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='6' italic='true'>(Source: Statistics Bundesamt 2022)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='# - Male Salaries' datatype='real' name='[# - Female Salaries (copy)_3943042215309983753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([salary_amount_annualized]) ELSE null end' />
            </column>
            <column caption='# - Female Salaries' datatype='real' name='[Calculation_3943042215309475848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Female&apos; THEN([salary_amount_annualized]) ELSE null end' />
            </column>
            <column caption='# - Pay Gap' datatype='real' name='[Calculation_3943042215310258186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(AVG([Calculation_3943042215309475848])/AVG([# - Female Salaries (copy)_3943042215309983753]))' />
            </column>
            <column caption='Pay Gap vs Market' datatype='real' default-format='p0.0%' name='[Calculation_3943042215311220747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3943042215310258186]-(18/100)' />
            </column>
            <column caption='C Level' datatype='string' name='[c_level]' role='dimension' type='nominal' />
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column caption='Job Family Group' datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column caption='Job Profile' datatype='string' name='[job_profile]' role='dimension' type='nominal' />
            <column-instance column='[c_level]' derivation='None' name='[none:c_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family]' derivation='None' name='[none:job_family:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family_group]' derivation='None' name='[none:job_family_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_profile]' derivation='None' name='[none:job_profile:nk]' pivot='key' type='nominal' />
