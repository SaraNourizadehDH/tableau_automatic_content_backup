      <column caption='# - % Male' datatype='real' default-format='p0.0%' name='[# - % Female (copy)_3943042215308271622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# - Female (copy)_3943042215308271621] / COUNTD([employee_id])' />
      </column>
      <column caption='# - CR Female vs Male' datatype='real' name='[# - CR Male vs Female (copy)_3943042215336284177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Calculation_3943042215332478989]))-(avg([# - Compa Ratio (Male) (copy)_3943042215332999182]))' />
      </column>
      <column caption='# - Compa Ratio (Males)' datatype='real' name='[# - Compa Ratio (Male) (copy)_3943042215332999182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gender] = &apos;Male&apos; THEN [salary_amount_annualized]/[mid_salary_range] end' />
      </column>
      <column caption='# - Male' datatype='integer' name='[# - Female (copy)_3943042215308271621]' role='measure' type='quantitative'>
