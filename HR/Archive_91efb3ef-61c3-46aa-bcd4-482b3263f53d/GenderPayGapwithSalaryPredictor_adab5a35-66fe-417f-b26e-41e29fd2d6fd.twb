        <calculation class='tableau' formula='IF [gender] = &apos;Female&apos; THEN [salary_amount_annualized]/[mid_salary_range] end' />
      </column>
      <column caption='# - CR Male vs Female' datatype='real' name='[Calculation_3943042215333572623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([# - Compa Ratio (Male) (copy)_3943042215332999182]))-(avg([Calculation_3943042215332478989]))' />
      </column>
      <column caption='# - Quartiles' datatype='string' name='[Calculation_3943042215337127954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [salary_amount_annualized] &lt;= {fixed: PERCENTILE([salary_amount_annualized], .25)} then &apos;1st Quartile&apos;&#10;ELSEIF [salary_amount_annualized] &gt;= {fixed: PERCENTILE([salary_amount_annualized], .25)} AND [salary_amount_annualized] &lt;= {fixed: PERCENTILE([salary_amount_annualized], .5)} then &apos;2nd Quartile&apos;&#10;ELSEIF [salary_amount_annualized] &gt;= {fixed: PERCENTILE([salary_amount_annualized], .5)} AND [salary_amount_annualized] &lt;= {fixed: PERCENTILE([salary_amount_annualized], .75)} then &apos;3rd Quartile&apos;&#10;ELSEIF [salary_amount_annualized] &gt;= {fixed: PERCENTILE([salary_amount_annualized], .75)} then &apos;4st Quartile&apos;&#10;END' />
      </column>
      <column caption='PayGapClasses' datatype='string' name='[Calculation_4270960586376654863]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2084674062187413540 1] &lt;= 0 THEN &apos;No&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.05 THEN &apos;Low&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.15 THEN &apos;Medium&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &gt;= 0.15 THEN &apos;High&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='Position in the salary band' datatype='real' name='[Calculation_4425349601479376933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([current_salary_annualized]-[min_salary_range])/([max_salary_range]-[min_salary_range])' />
