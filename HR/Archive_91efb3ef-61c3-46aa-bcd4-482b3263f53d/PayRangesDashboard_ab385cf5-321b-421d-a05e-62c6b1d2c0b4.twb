                <zone forceUpdate='true' h='7333' id='12' type-v2='text' w='13429' x='86000' y='667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Last Updated:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='48666' id='14' type-v2='text' w='92430' x='3782' y='10667'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Calculated Fields</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Applications</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of applications, currently not including some purged candidates.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Application Date</run>
                    <run fontsize='12'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Interviews</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of candidates that had their first interview scheduled in the system.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Candidates that applied to several jobs are treated as separate individuals.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>First Interview Date</run>
                    <run fontsize='12'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Offers</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of offers initiated.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Offer Initiated Date.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Hires</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of candidates who accepted their offer and whose data was handed over to the Core Ops team. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Handover To CoreOps Date</run>
                    <run fontsize='12'>, at which point the hire business process is complete. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Total Signed Contracts</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of candidates whose contract was signed by Lauren Prince or Jeri Doris, excluding contracts signed offline.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Contract Signed Date</run>
                    <run fontsize='12'>. </run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='32500' id='15' type-v2='text' w='92430' x='3782' y='59333'>
                  <formatted-text>
                    <run>Æ&#10;</run>
