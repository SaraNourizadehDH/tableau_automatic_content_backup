          <zone forceUpdate='true' h='20400' id='14' type-v2='text' w='92430' x='3782' y='12800'>
            <formatted-text>
              <run bold='true' fontsize='12'>Purpose</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>This dashboard was designed to designed to help hiring managers stay up to date with their recruiting processes and benchmarks. Recruiters will be able to use it to start a conversation with their hiring managers on how to optimize recruiting efforts. </run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>It was created at the request of recruiting leadership, recruiters, and hiring managers. Only the recruiting organisation will have direct access to the dashboard. </run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='54600' id='15' type-v2='text' w='92430' x='3782' y='33200'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Objectives</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>The dashboard was created to answer the following commonly asked questions:</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>1.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>2. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>3. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>4.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>5.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>6.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>7.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>8.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>9. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>10.</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
