      <column caption='Count Eligible Heroes LTIPs' datatype='integer' name='[Calculation_2703215341371510784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [management_level] = &apos;IC2&apos;&#10;OR [management_level] = &apos;IC3&apos;&#10;OR [management_level] = &apos;IC4&apos;&#10;OR [management_level] = &apos;IC5&apos;&#10;OR [management_level] = &apos;IC6&apos;&#10;OR [management_level] = &apos;IC7&apos;&#10;OR [management_level] = &apos;IC8&apos;&#10;OR [management_level] = &apos;M1&apos;&#10;OR [management_level] = &apos;M2&apos;&#10;OR [management_level] = &apos;M3&apos;&#10;OR [management_level] = &apos;M4&apos;&#10;OR [management_level] = &apos;M5&apos;&#10;OR [management_level] = &apos;M6&apos;&#10;THEN [employee_id] &#10;END)' />
      </column>
      <column caption='% Assignment LTIPs' datatype='real' name='[Calculation_2703215341381091330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_676525139974918147]/[Calculation_2703215341371510784]' />
      </column>
      <column caption='Total Compensation (Current)' datatype='real' name='[Calculation_676525139961348096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN [salary_amount_annualized]/[mid_salary_range]&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN [salary_amount_annualized]/[mid_salary_range]&#10;ELSE ([salary_amount_annualized]+ZN([granted_amount]))/([mid_salary_range]+ZN([Calculation_676525139961638913]))&#10;END' />
      </column>
      <column caption='LTI Target Adjusted' datatype='real' name='[Calculation_676525139961638913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([granted_amount]) AND ISNULL([Calculation_676525139961851906]) &#10;THEN [granted_amount]&#10;ELSEIF ISNULL([granted_amount]) AND ISNULL([Calculation_676525139961851906])&#10;THEN 0&#10;ELSE [Calculation_676525139961851906]&#10;END' />
      </column>
      <column caption='LTI Target' datatype='integer' name='[Calculation_676525139961851906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S2&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S3&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S4&apos; THEN 0&#10;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]= 0 THEN 0&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]= 1 THEN 10000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=0 THEN 15000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=1 THEN 17500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=0 THEN 22500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=1 THEN 27500&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=0 THEN 35000&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=1 THEN 45000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=0 THEN 55000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=1 THEN 65000&#10;&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=0 THEN 20000&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=1 THEN 22500&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=0 THEN 30000&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=1 THEN 37500&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=0 THEN 45000&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=1 THEN 52500&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=0 THEN 80000&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=1 THEN 90000&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=0 THEN 112500&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=1 THEN 140000&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=0 THEN 185000&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=1 THEN 230000&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=0 THEN 250000&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=1 THEN 300000&#10;&#10;ELSE NULL END' />
      </column>
      <column caption='Count Assigned LTIPs' datatype='integer' name='[Calculation_676525139974918147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;&#10;(IF [stock_plan] = &apos;LTIP (RSU,SO) - Austria&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU,SO) - Germany&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU) - Austria&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU) - Germany&apos;&#10;OR [stock_plan] = &apos;LTIP (SO)&apos;&#10;OR [stock_plan] = &apos;LTIP (SO)&apos;&#10;AND [granted_amount] &gt; 1&#10;THEN&#10;[employee_id (il_stock_grant)]&#10;END)' />
      </column>
      <column caption='Stock Eligible' datatype='real' name='[Calculation_676525139977674756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id (il_stock_grant)])/COUNTD([employee_id])' />
      </column>
      <column caption='Count Active Heroes' datatype='integer' name='[Calculation_676525140013490184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_terminated] = 0 then 1 else 0 END' />
      </column>
      <column caption='Avg per Person' datatype='real' name='[Calculation_676525140043980810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([granted_amount])/([Calculation_676525139974918147])' />
      </column>
      <column caption='Employee Id (Il Stock Grant) (copy)' datatype='real' datatype-customized='true' name='[Employee Id (Il Stock Grant) (copy)_676525140008161287]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT([employee_id (il_stock_grant)])' />
      </column>
      <column datatype='string' name='[Management Level (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
          <bin default-name='false' value='&quot;E Track&quot;'>
            <value>&quot;E1&quot;</value>
            <value>&quot;E2&quot;</value>
