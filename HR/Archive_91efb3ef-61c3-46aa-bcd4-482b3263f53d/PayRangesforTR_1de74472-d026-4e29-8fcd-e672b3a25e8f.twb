          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Count Eligible Heroes LTIPs' datatype='integer' name='[Calculation_2703215341371510784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [management_level] = &apos;IC2&apos;&#10;OR [management_level] = &apos;IC3&apos;&#10;OR [management_level] = &apos;IC4&apos;&#10;OR [management_level] = &apos;IC5&apos;&#10;OR [management_level] = &apos;IC6&apos;&#10;OR [management_level] = &apos;IC7&apos;&#10;OR [management_level] = &apos;IC8&apos;&#10;OR [management_level] = &apos;M1&apos;&#10;OR [management_level] = &apos;M2&apos;&#10;OR [management_level] = &apos;M3&apos;&#10;OR [management_level] = &apos;M4&apos;&#10;OR [management_level] = &apos;M5&apos;&#10;OR [management_level] = &apos;M6&apos;&#10;THEN [employee_id] &#10;END)' />
            </column>
