    <worksheet name='LTIPS Avg Spent per Person'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>Avg Spent per Person</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Equity' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Count Assigned LTIPs' datatype='integer' name='[Calculation_676525139974918147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#10;&#10;(IF [stock_plan] = &apos;LTIP (RSU,SO) - Austria&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU,SO) - Germany&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU) - Austria&apos;&#10;OR [stock_plan] = &apos;LTIP (RSU) - Germany&apos;&#10;OR [stock_plan] = &apos;LTIP (SO)&apos;&#10;OR [stock_plan] = &apos;LTIP (SO)&apos;&#10;AND [granted_amount] &gt; 1&#10;THEN&#10;[employee_id (il_stock_grant)]&#10;END)' />
            </column>
            <column caption='Avg per Person' datatype='real' name='[Calculation_676525140043980810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([granted_amount])/([Calculation_676525139974918147])' />
            </column>
            <column caption='Type of Stock Plans' datatype='string' name='[Stock Plan (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[stock_plan]' new-bin='true'>
                <bin default-name='false' value='&quot;Hero Grants&quot;'>
                  <value>&quot;Hero Grant - Austria&quot;</value>
                  <value>&quot;Hero Grant - Germany&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;LTIP&quot;'>
                  <value>&quot;LTIP (RSU) - Austria&quot;</value>
                  <value>&quot;LTIP (RSU) - Germany&quot;</value>
                  <value>&quot;LTIP (RSU, SO) - Austria&quot;</value>
                  <value>&quot;LTIP (RSU, SO) - Germany&quot;</value>
                  <value>&quot;LTIP (SO)&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Employee Id (Il Stock Grant)' datatype='string' name='[employee_id (il_stock_grant)]' role='dimension' type='nominal' />
            <column caption='Grant Effective Date' datatype='date' datatype-customized='true' name='[grant_effective_date]' role='dimension' type='ordinal' />
            <column caption='Granted Amount' datatype='real' default-format='C1031%' name='[granted_amount]' role='measure' type='quantitative' />
            <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[stock_plan]' derivation='None' name='[none:stock_plan:nk]' pivot='key' type='nominal' />
            <column caption='Stock Plan' datatype='string' name='[stock_plan]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_676525140043980810]' derivation='User' name='[usr:Calculation_676525140043980810:qk]' pivot='key' type='quantitative' />
            <column-instance column='[grant_effective_date]' derivation='Year' name='[yr:grant_effective_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.05r9snf0pm3fk91dop2ed0zgusim].[Stock Plan (group)]'>
            <groupfilter function='member' level='[Stock Plan (group)]' member='&quot;LTIP&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:stock_plan:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:stock_plan:nk]' />
              <groupfilter function='member' level='[none:stock_plan:nk]' member='%null%' />
            </groupfilter>
