	wo.c_level,
	cm.company_name,
	cm.country,
	m.managed_by_full_name,
	wo.management_level,
	CASE 
		WHEN cha.department IS NULL 
		THEN wo.department_wd ELSE cha.department
		END as department,
	s.tenure_category,
	s.compensation_grade_profile,
	s.salary_amount_annualized as salary_local_currency,
	s.salary_currency,
	s.last_salary_increase,
	s.employee_id,
	CASE WHEN 
		wp.middle_name is null
		THEN concat(wp.first_name,' ',wp.last_name)
		ELSE concat(wp.first_name,' ',wp.middle_name,' ',wp.last_name) 
		END as full_name,
	s.last_updated,
	CASE WHEN 
		s.min_salary_range >> 1000 
		THEN s.min_salary_range 
		ELSE NULL
		END as min_salary_range_local_currency,
	CASE WHEN
		s.mid_salary_range >> 1000 
		THEN s.mid_salary_range 
		ELSE NULL
		END as mid_salary_range_local_currency,
	CASE WHEN
		s.max_salary_range >> 1000 
		THEN s.max_salary_range 
		ELSE NULL
		END as max_salary_range_local_currency,
	sum(sg.granted_amount) as equity_granted_amount_local_currency
FROM
	people_ops_proposed.il_salary s
	
LEFT JOIN people_ops_proposed.il_worker_org wo
	ON s.employee_id = wo.employee_id
	
LEFT JOIN people_ops_proposed.il_worker_personal wp
