    <worksheet name='compa ratio'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>Avg Compa Ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Pay Ranges' name='federated.0m1n1cc0snjj871ewz3w60xjdu3p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Pay Ranges Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m1n1cc0snjj871ewz3w60xjdu3p'>
            <column caption='Salaries' datatype='real' name='[Calculation_2881670493961408512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;EUR&apos; THEN [salary_euro_currency]&#10;WHEN &apos;Local Currency&apos; THEN [salary_local_currency]&#10;END' />
            </column>
            <column caption='Compa Ratio' datatype='real' name='[Calculation_2881670493974085637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2881670493961408512]/[Max Salary Range (copy)_5736108222537867265]' />
            </column>
            <column caption='Mid Salary Range' datatype='real' name='[Max Salary Range (copy)_5736108222537867265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;EUR&apos; THEN [mid_salary_range_euros_currency]&#10;WHEN &apos;Local Currency&apos; THEN [mid_salary_range_local_currency]&#10;END' />
            </column>
            <column-instance column='[Calculation_2881670493974085637]' derivation='Avg' name='[avg:Calculation_2881670493974085637:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[mid_salary_range_euros_currency]' role='measure' type='quantitative' />
            <column datatype='real' name='[mid_salary_range_local_currency]' role='measure' type='quantitative' />
            <column datatype='real' name='[salary_euro_currency]' role='measure' type='quantitative' />
            <column datatype='real' name='[salary_local_currency]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0m1n1cc0snjj871ewz3w60xjdu3p].[avg:Calculation_2881670493974085637:qk]' value='n#,##0.00;-#,##0.00' />
            <format attr='color' field='[federated.0m1n1cc0snjj871ewz3w60xjdu3p].[avg:Calculation_2881670493974085637:qk]' value='#cb001c' />
            <format attr='font-weight' field='[federated.0m1n1cc0snjj871ewz3w60xjdu3p].[avg:Calculation_2881670493974085637:qk]' value='bold' />
            <format attr='font-size' field='[federated.0m1n1cc0snjj871ewz3w60xjdu3p].[avg:Calculation_2881670493974085637:qk]' value='15' />
