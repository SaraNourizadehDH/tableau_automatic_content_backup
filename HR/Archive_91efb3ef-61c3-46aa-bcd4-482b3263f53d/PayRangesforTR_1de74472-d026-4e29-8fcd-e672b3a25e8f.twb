		ELSE min_salary_range_local_currency*currency_exchange_rate 
		END as min_salary_range_euros_currency,
	CASE WHEN
		salary_currency = 'EUR' 
		THEN mid_salary_range_local_currency 
		ELSE mid_salary_range_local_currency*currency_exchange_rate 
		END as mid_salary_range_euros_currency,
	CASE WHEN 
