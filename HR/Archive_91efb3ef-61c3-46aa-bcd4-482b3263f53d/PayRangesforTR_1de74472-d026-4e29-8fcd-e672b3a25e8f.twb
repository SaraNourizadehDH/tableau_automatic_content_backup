      <column caption='Type of Stock Plans' datatype='string' name='[Stock Plan (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[stock_plan]' new-bin='true'>
          <bin default-name='false' value='&quot;Hero Grants&quot;'>
            <value>&quot;Hero Grant - Austria&quot;</value>
