            <column caption='Regrettable - MoM (-) Monthly' datatype='real' name='[FINAL VOL MoM - Attrition (-) (copy)_141722670090608682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [FINAL INVOL MoM - Attrition (Monthly) (copy)_141722670090498089] &lt; 0 THEN(&#10;CASE  [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL INVOL - MoM effective (Monthly) (copy)_141722670089973799]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL REG - MoM effective (Monthly) (copy)_141722670090235944]&#10;END) ELSE 0&#10;END'>
