      <filter class='categorical' column='[company_id]' filter-group='2'>
        <groupfilter function='member' level='[company_id]' member='&quot;1001&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[sub_department]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[sub_department]' />
          <groupfilter function='union'>
            <groupfilter function='member' level='[sub_department]' member='%null%' />
            <groupfilter function='member' level='[sub_department]' member='&quot;&quot;' />
            <groupfilter function='member' level='[sub_department]' member='&quot;-&quot;' />
            <groupfilter function='member' level='[sub_department]' member='&quot;Consumer Data Techn&quot;' />
