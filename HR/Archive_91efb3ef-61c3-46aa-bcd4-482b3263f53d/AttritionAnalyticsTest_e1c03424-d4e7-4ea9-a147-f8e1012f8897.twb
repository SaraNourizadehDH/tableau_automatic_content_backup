                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Regrettable - Attrition Monthly' datatype='real' default-format='p0.0%' name='[FINAL INVOL - Attrition (Monthly) (copy)_141722670089637925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL INVOL Initiated  Atrittion - Monthly (copy)_141722670089318435]&#10;END' />
            </column>
            <column caption='Regrettable - MoM Effective Monthly' datatype='real' name='[FINAL INVOL - MoM effective (Monthly) (copy)_141722670089973799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276])-&#10;LOOKUP((RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276])),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Regrettable - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[FINAL INVOL Initiated  Atrittion - Monthly (copy)_141722670089318435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective_regrettable (copy)_5022076552060747881])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Regrettable - MoM Monthly' datatype='real' name='[FINAL INVOL MoM - Attrition (Monthly) (copy)_141722670090498089]' role='measure' type='quantitative'>
