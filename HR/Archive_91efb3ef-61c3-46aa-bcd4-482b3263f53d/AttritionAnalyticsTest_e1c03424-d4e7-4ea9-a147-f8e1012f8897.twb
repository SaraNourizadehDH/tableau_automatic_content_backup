    <worksheet name='Vol/Invol Performance'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='performance_attrition' name='federated.1p5um9512h4ks70zunoym1vc9bzd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
              <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
            </column>
            <column caption='Years' datatype='integer' default-format='n0;-0' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p5um9512h4ks70zunoym1vc9bzd'>
            <column caption=' Attrition Effective Voluntary' datatype='real' name='[ Attrition Effective (copy)_1740148694716260489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([terminations_initiated_voluntary (copy)_1740148694716137608]))&#10;&#10;/&#10;[HiPe Start HC (copy)_1740148694702923881]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption=' Attrition Initiated Voluntary' datatype='real' name='[ Attrition Effective Voluntary (copy)_1740148694716317834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([Pe Terminations Initiated Voluntary (copy)_1740148694716035207]))&#10;&#10;/&#10;[HiPe Start HC (copy)_1740148694702923881]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption=' Attrition Effective Involuntary' datatype='real' name='[ Attrition Effective Voluntary (copy)_1740148694716977295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([terminations_effective_voluntary (copy)_1740148694716883086]))&#10;&#10;/&#10;[HiPe Start HC (copy)_1740148694702923881]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption=' Attrition Initiated Involuntary' datatype='real' name='[ Attrition Initiated Voluntary (copy)_1740148694717051024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([terminations_initiated_voluntary (copy)_1740148694716752013]))&#10;&#10;/&#10;[HiPe Start HC (copy)_1740148694702923881]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Attrition Voluntary' datatype='real' default-format='p0.0%' name='[Attrition (copy)_1740148694716448908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [ Attrition Effective (copy)_1740148694716260489]&#10;WHEN &apos;Initiated Attrition&apos; THEN [ Attrition Effective Voluntary (copy)_1740148694716317834]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Attrition Involuntary' datatype='real' default-format='p0.0%' name='[Attrition Voluntary (copy)_1740148694717108369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [ Attrition Effective Voluntary (copy)_1740148694716977295]&#10;WHEN &apos;Initiated Attrition&apos; THEN [ Attrition Initiated Voluntary (copy)_1740148694717051024]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='template=years ' datatype='boolean' name='[Calculation_1740148694507196465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 2023 THEN [review_template] = &apos;End of year 2022  Performance review&apos;&#10;WHEN 2022 THEN [review_template] = &apos;End of year 2021 Performance Review_Central&apos;&#10;WHEN 2021 THEN [review_template] = &apos;Performance Review June/July 2020&apos;&#10;WHEN 2020 THEN [review_template] = &apos;End of Year Performance Check-in 2019&apos;&#10;WHEN 2019 THEN [review_template] = &apos;Null&apos;&#10;END' />
            </column>
            <column caption='Not New Starters' datatype='boolean' name='[Calculation_1740148694675472463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_day_of_work]) &lt;= DATETRUNC(&apos;year&apos;, [report_month])' />
            </column>
            <column caption='manager_rating_explained' datatype='string' name='[Calculation_1740148694702370920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manager_rating] &gt; 3 then &apos;High Performers&apos;&#10;ELSEIF [manager_rating] = 3 then &apos;Performers&apos;&#10;ELSEIF [manager_rating] &lt; 3 THEN &apos;Low Performers&apos;&#10;END' />
            </column>
            <column caption='Last' datatype='boolean' name='[Calculation_1740148694703771757]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()=0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption=' Start HC' datatype='integer' name='[HiPe Start HC (copy)_1740148694702923881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IF DATEPART(&apos;month&apos;, [report_month]) = 1 THEN [actuals]&#10;END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Future Leavers' datatype='boolean' name='[Not New Starters (copy)_1740148694675824720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [last_day_of_work]) &gt;= DATETRUNC(&apos;year&apos;, [report_month]) &#10;OR ISNULL([last_day_of_work])' />
            </column>
            <column caption='terminations_initiated_voluntary' datatype='integer' name='[Pe Terminations Initiated Voluntary (copy)_1740148694716035207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; &#10;THEN [terminations_initiated] END' />
            </column>
            <column datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[department]' role='dimension' type='nominal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[first_day_of_work]' role='dimension' type='ordinal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[last_day_of_work]' role='dimension' type='ordinal' />
            <column datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column datatype='string' name='[manager_02_full_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[manager_03_full_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[manager_04_full_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[manager_rating]' role='dimension' type='ordinal' />
