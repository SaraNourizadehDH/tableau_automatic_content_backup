        </calculation>
      </column>
      <column caption='Start Date' datatype='date' name='[Calculation_1740148694438727713]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([report_month])' />
      </column>
      <column caption='HiPe Start HC' datatype='integer' name='[Calculation_1740148694440132645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IF DATEPART(&apos;month&apos;, [report_month]) = 1 THEN [Calculation_1740148694434856986]&#10;END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1' datatype='real' hidden='true' name='[Calculation_1740148694502043695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1740148694434856986]/[Calculation_1740148694440132645]' />
      </column>
      <column caption='template=years ' datatype='boolean' name='[Calculation_1740148694507196465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 2023 THEN [review_template] = &apos;End of year 2022  Performance review&apos;&#10;WHEN 2022 THEN [review_template] = &apos;End of year 2021 Performance Review_Central&apos;&#10;WHEN 2021 THEN [review_template] = &apos;Performance Review June/July 2020&apos;&#10;WHEN 2020 THEN [review_template] = &apos;End of Year Performance Check-in 2019&apos;&#10;WHEN 2019 THEN [review_template] = &apos;Null&apos;&#10;END' />
      </column>
      <column caption='Latest HiPe Attrition Effective' datatype='real' name='[Calculation_1740148694509326386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST()=0 THEN [Calculation_1740148694437040158] END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='HiPe Attrition' datatype='real' default-format='p0.0%' name='[Calculation_1740148694511386678]' role='measure' type='quantitative'>
