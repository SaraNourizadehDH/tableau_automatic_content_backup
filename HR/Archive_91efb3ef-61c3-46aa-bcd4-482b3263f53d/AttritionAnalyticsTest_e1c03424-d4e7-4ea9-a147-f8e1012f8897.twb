      <column caption='Involuntary - MoM (+) Monthly' datatype='real' name='[FINAL INVOL MoM - Attrition (-)  (copy)_141722670088482850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [FINAL VOL MoM - Attrition (Monthly) (copy)_141722670088241183] &gt; 0 THEN(&#10;CASE  [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL INVOL - MoM initiated (Monthly) (copy)_141722670088060958]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL VOL - MoM initiated (Monthly) (copy)_141722670087954461]&#10;END) ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
