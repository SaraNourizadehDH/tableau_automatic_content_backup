        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL Effective  Atrittion - Monthly (copy)_141722670084366352]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL VOL Effective  Atrittion - Monthly (copy)_141722670084517905]&#10;END'>
