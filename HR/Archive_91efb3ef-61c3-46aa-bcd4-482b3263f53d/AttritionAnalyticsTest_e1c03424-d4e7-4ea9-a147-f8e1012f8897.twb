                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Regrettable - MoM Initiated Monthly' datatype='real' name='[FINAL REG - MoM effective (Monthly) (copy)_141722670090235944]' role='measure' type='quantitative'>
