    <worksheet name='Monthly Table Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='9'>Monthly Attrition Details</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='attrition_pl_table' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
              <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
            </column>
            <column caption='Years' datatype='integer' default-format='n0;-0' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='terminations_effective_voluntary' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
            </column>
            <column caption='Involuntary - Attrition Monthly' datatype='real' default-format='p0.0%' name='[Involuntary - Attrition (copy)_141722670134325317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Involuntary - Attrition Effective (copy)_141722670133878848]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Involuntary - Attrition Effective Monthly (copy)_141722670133977153]&#10;END' />
            </column>
            <column caption='Involuntary - Attrition Effective Monthly' datatype='real' default-format='p0.0%' name='[Involuntary - Attrition Effective (copy)_141722670133878848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective_voluntary (copy)_5022076552060502119])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Involuntary - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[Involuntary - Attrition Effective Monthly (copy)_141722670133977153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_initiated])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Overall - Attrition Monthly' datatype='real' default-format='p0.0%' name='[Overall - Attrition (copy)_141722670134755400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Overall - Attrition Effective (copy)_141722670134628422]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Overall - Attrition Initiated (copy)_141722670134640711]&#10;END' />
            </column>
            <column caption='Overall - Attrition Effective Monthly' datatype='real' default-format='p0.0%' name='[Overall - Attrition Effective (copy)_141722670134628422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective])&#10;/&#10;sum([actuals])' />
            </column>
            <column caption='Overall - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[Overall - Attrition Initiated (copy)_141722670134640711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_initiated])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Voluntary - Attrition Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition (copy)_141722670134243396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Voluntary - Attrition Effective (copy)_141722670134071362]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Voluntary - Attrition Initiated (copy)_141722670134165571]&#10;END' />
            </column>
            <column caption='Voluntary - Attrition Effective Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition Effective (copy)_141722670134071362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5022076552060018788])&#10;/&#10;SUM([actuals])' />
