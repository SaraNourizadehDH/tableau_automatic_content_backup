      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7B331195187E457B89FCA121F1CD01FE'>
            <properties context=''>
              <relation connection='athena.1x4p95n0kjlsr51e3tzav1t6rrv8' name='Custom SQL Query' type='text'><![CDATA[WITH performance_1 AS
    (SELECT 
        DATE(review_date) AS month,
        employee_id,
        manager_rating,
        review_template_id,
        row_number () over(partition by employee_id order by review_date) row_num
    FROM 
        people_ops_proposed.il_performance 
        where manager_rating is not null
        and bp_status in('In Progress','Successfully Completed')
    ORDER BY 
        1 DESC
),

performance_2 as 
(
select 
	a.month as month_from,
	coalesce (b.month,date_trunc('month', date_add('month',1,current_date))) as month_until,
	a.employee_id,
	a.manager_rating,
	a.review_template_id
from performance_1 as a
left join performance_1 as b 
on a.employee_id=b.employee_id 
and a.row_num=b.row_num-1
),

performance as (select
	cast(month as date) as date_month,
	month_from,
	month_until,
	employee_id,
	manager_rating,
	review_template_id
from people_ops_proposed.bl_calendar 
inner join performance_2
on cast(month as date)>>=month_from 
and cast(month as date)<<month_until
),

historial_data as (
SELECT
date_trunc('month',cast(wh.report_effective_date as date)) as report_month,
wh.company_id,
wh.first_day_of_work,
wh.last_day_of_work,
cm.brand,
m.manager_02_full_name,
m.manager_03_full_name,
m.manager_04_full_name,
CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
chw.cost_center_name, 
wp.gender,
wh.management_level,
sh.tenure_category,
p.manager_rating,
p.review_template_id,
prt.review_template,
wh.employee_id,
CASE WHEN ti.termination_category IS NULL THEN te.termination_category ELSE ti.termination_category END as termination_category,
CASE WHEN ti.termination_reason IS NULL THEN te.termination_reason ELSE ti.termination_reason END as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
CASE WHEN te.is_termination_regrettable IS NULL THEN ti.is_termination_regrettable 
ELSE te.is_termination_regrettable END as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
te.last_updated

FROM people_ops_proposed.il_worker_hist_with_current wh

LEFT JOIN performance p
	ON p.employee_id = wh.employee_id
	AND p.date_month = date_trunc('month',cast(wh.report_effective_date as date))
	
LEFT JOIN people_ops_proposed.il_manager m
	ON m.employee_id = wh.employee_id
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 	
	
LEFT JOIN
	people_ops_proposed.il_performance_review_template prt
	ON p.review_template_id = prt.review_template_id 		
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 	
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 	
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wh.employee_id	
	
LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh
	ON sh.employee_id = wh.employee_id
	AND date_trunc('month',cast(sh.report_effective_date as date)) = date_trunc('month',cast(wh.report_effective_date as date))	
	
LEFT JOIN people_ops_proposed.il_termination ti 
	ON ti.employee_id = wh.employee_id
	AND date_trunc('month',cast(ti.termination_initiated_date as date)) = date_trunc('month',cast(wh.report_effective_date as date))
LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc('month',cast(te.termination_effective_date as date)) = date_trunc('month',cast(wh.report_effective_date as date))	
	
WHERE (ti.status IS NULL OR ti.status IN ('Successfully Completed','In Progress'))

) 

select
*

from historial_data]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
