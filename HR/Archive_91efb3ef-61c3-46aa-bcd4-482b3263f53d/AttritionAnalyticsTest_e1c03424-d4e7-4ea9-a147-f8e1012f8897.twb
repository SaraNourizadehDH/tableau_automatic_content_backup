            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.1p5um9512h4ks70zunoym1vc9bzd].[usr:Latest LowPe Attrition (copy)_1740148694685040734:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='9'><![CDATA[<[federated.1p5um9512h4ks70zunoym1vc9bzd].[usr:LowPe MoM (copy)_1740148694684848219:qk]> ]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='9'>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='performance_attrition' name='federated.1p5um9512h4ks70zunoym1vc9bzd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
              <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
            </column>
            <column caption='Years' datatype='integer' default-format='n0;-0' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p5um9512h4ks70zunoym1vc9bzd'>
            <column caption='Years Parameter' datatype='boolean' name='[Calculation_1740148694390599688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([report_month])=[Parameters].[Parameter 2]' />
            </column>
            <column caption='template=years ' datatype='boolean' name='[Calculation_1740148694507196465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 2023 THEN [review_template] = &apos;End of year 2022  Performance review&apos;&#10;WHEN 2022 THEN [review_template] = &apos;End of year 2021 Performance Review_Central&apos;&#10;WHEN 2021 THEN [review_template] = &apos;Performance Review June/July 2020&apos;&#10;WHEN 2020 THEN [review_template] = &apos;End of Year Performance Check-in 2019&apos;&#10;WHEN 2019 THEN [review_template] = &apos;Null&apos;&#10;END' />
            </column>
            <column caption='Not New Starters' datatype='boolean' name='[Calculation_1740148694675472463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_day_of_work]) &lt;= DATETRUNC(&apos;year&apos;, [report_month])' />
            </column>
            <column caption='Latest Pe Attrition' datatype='real' default-format='p0.0%' name='[Latest LowPe Attrition (copy)_1740148694685040734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Latest LowPe Attrition Effective (copy)_1740148694684971101]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Latest LowPe Attrition Initiated (copy)_1740148694684909660]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Latest Pe Attrition Effective' datatype='real' name='[Latest LowPe Attrition Effective (copy)_1740148694684971101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN [LowPe Attrition Effective (copy)_1740148694684532823] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Latest Pe Attrition Initiated' datatype='real' name='[Latest LowPe Attrition Initiated (copy)_1740148694684909660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN [LowPe Attrition Initiated (copy)_1740148694684467286] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Pe Actuals' datatype='integer' name='[LowPe Actuals (copy)_1740148694684336212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [manager_rating] = 3 THEN [actuals] END' />
            </column>
            <column caption='Pe Attrition Effective' datatype='real' name='[LowPe Attrition Effective (copy)_1740148694684532823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([LowPe Terminations Effective (copy)_1740148694684213330]))&#10;&#10;/&#10;[LowPe Start HC (copy)_1740148694684389461]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Pe Attrition Initiated' datatype='real' name='[LowPe Attrition Initiated (copy)_1740148694684467286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([LowPe Terminations Initiated (copy)_1740148694684278867]))&#10;&#10;/&#10;[LowPe Start HC (copy)_1740148694684389461]'>
                <table-calc ordering-type='Rows' />
              </calculation>
