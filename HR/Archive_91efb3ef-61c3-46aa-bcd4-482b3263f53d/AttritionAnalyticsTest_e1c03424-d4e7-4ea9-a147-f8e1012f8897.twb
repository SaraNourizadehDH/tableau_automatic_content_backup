          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Calculation_5022076552057204832:qk]&quot;' value='Overall Attrition' />
        </aliases>
      </column>
      <column caption='Year Parameter Highlighter ' datatype='boolean' name='[Calculation_141722670100455479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=year([report_month]) then TRUE else FALSE end' />
      </column>
      <column caption='Previous Year' datatype='integer' datatype-customized='true' name='[Calculation_141722670127280188]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([report_month])=[Parameters].[Parameter 2]then YEAR([report_month])-1 END' />
      </column>
      <column caption='Today Ref Line' datatype='datetime' datatype-customized='true' name='[Calculation_2943806062930866179]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF year([report_month])=YEAR(TODAY()) THEN DATETRUNC(&apos;month&apos;,TODAY()) END' />
      </column>
      <column caption='Years - Parameter' datatype='boolean' name='[Calculation_5022076551914573841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([report_month])&lt;=[Parameters].[Parameter 2]' />
      </column>
      <column caption='Last' datatype='boolean' name='[Calculation_5022076551914856466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='If current year' datatype='boolean' name='[Calculation_5022076552036659281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR({fixed:MAX(if [period]=&apos;Historical Data&apos; then [report_month] end)}) = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Overall - Attrition' datatype='real' default-format='p0.0%' name='[Calculation_5022076552057204832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Effective Involuntary Atrittion (copy)_5022076552284926121]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL Effective  Atrittion - Monthly (copy)_141722670077374476]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='terminations_effective_voluntary' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
      </column>
      <column caption='current_year' datatype='boolean' name='[Calculation_5022076552293089459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([report_month])= YEAR(TODAY())' />
      </column>
      <column caption='Overall - Attrition Effective' datatype='real' default-format='p0.0%' name='[Effective Involuntary Atrittion (copy)_5022076552284926121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([terminations_effective]))&#10;/&#10;sum(&#10;{ FIXED YEAR([report_month]):AVG(&#10;&#10;{ FIXED YEAR([report_month]),MONTH([report_month]):SUM([actuals])})})'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall - MoM Initiated Monthly' datatype='real' name='[FINAL - MoM effective (Monthly) (copy)_141722670077534221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Overall - Attrition Initiated (copy)_141722670134640711])-&#10;&#10;LOOKUP(RUNNING_SUM([Overall - Attrition Initiated (copy)_141722670134640711]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Voluntary - MoM Effective Monthly' datatype='real' name='[FINAL - MoM effective (Monthly) (copy)_141722670084960275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Voluntary - Attrition Effective (copy)_141722670134071362])-&#10;LOOKUP((RUNNING_SUM([Voluntary - Attrition Effective (copy)_141722670134071362])),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall - Attrition Initiated' datatype='real' default-format='p0.0%' name='[FINAL Effective  Atrittion - Monthly (copy)_141722670077374476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([terminations_initiated])&#10;/&#10;SUM([actuals])' />
      </column>
      <column caption='Voluntary - Attrition Effective' datatype='real' default-format='p0.0%' name='[FINAL Effective  Atrittion - Monthly (copy)_141722670084366352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_5022076552060018788]))&#10;/&#10;sum(&#10;{ FIXED YEAR([report_month]):AVG(&#10;&#10;{ FIXED YEAR([report_month]),MONTH([report_month]):SUM([actuals])})})'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Regrettable - Attrition Monthly' datatype='real' default-format='p0.0%' name='[FINAL INVOL - Attrition (Monthly) (copy)_141722670089637925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL INVOL Initiated  Atrittion - Monthly (copy)_141722670089318435]&#10;END' />
      </column>
      <column caption='Regrettable - MoM Effective Monthly' datatype='real' name='[FINAL INVOL - MoM effective (Monthly) (copy)_141722670089973799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276])-&#10;LOOKUP((RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670089482276])),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Involuntary - MoM Effective Monthly' datatype='real' name='[FINAL INVOL - MoM initiated (Monthly) (copy)_141722670088060958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Involuntary - Attrition Effective (copy)_141722670133878848])-&#10;LOOKUP((RUNNING_SUM([Involuntary - Attrition Effective (copy)_141722670133878848])),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Involuntary - Attrition Initiated' datatype='real' default-format='p0.0%' name='[FINAL INVOL Effective  Atrittion - Monthly (copy)_141722670087462938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([terminations_initiated_voluntary (copy)_5022076552060391526]))&#10;/&#10;sum(&#10;{ FIXED YEAR([report_month]):AVG(&#10;&#10;{ FIXED YEAR([report_month]),MONTH([report_month]):SUM([actuals])})})'>
          <table-calc ordering-type='Rows' />
        </calculation>
