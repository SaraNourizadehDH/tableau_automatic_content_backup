          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
              <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
            </column>
            <column caption='Years' datatype='integer' default-format='n0;-0' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p5um9512h4ks70zunoym1vc9bzd'>
            <column caption='Years Parameter' datatype='boolean' name='[Calculation_1740148694390599688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([report_month])=[Parameters].[Parameter 2]' />
            </column>
            <column caption='HiPe Actuals' datatype='integer' name='[Calculation_1740148694434856986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [manager_rating] &gt; 3 THEN [actuals] END' />
            </column>
            <column caption='HiPe Attrition Effective' datatype='real' name='[Calculation_1740148694437040158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([HiPe Actuals (copy)_1740148694436929565]))&#10;/&#10;[Calculation_1740148694440132645]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe Start HC' datatype='integer' name='[Calculation_1740148694440132645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IF DATEPART(&apos;month&apos;, [report_month]) = 1 THEN [Calculation_1740148694434856986]&#10;END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='template=years ' datatype='boolean' name='[Calculation_1740148694507196465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 2023 THEN [review_template] = &apos;End of year 2022  Performance review&apos;&#10;WHEN 2022 THEN [review_template] = &apos;End of year 2021 Performance Review_Central&apos;&#10;WHEN 2021 THEN [review_template] = &apos;Performance Review June/July 2020&apos;&#10;WHEN 2020 THEN [review_template] = &apos;End of Year Performance Check-in 2019&apos;&#10;WHEN 2019 THEN [review_template] = &apos;Null&apos;&#10;END' />
            </column>
            <column caption='Latest HiPe Attrition Effective' datatype='real' name='[Calculation_1740148694509326386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN [Calculation_1740148694437040158] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe Attrition' datatype='real' default-format='p0.0%' name='[Calculation_1740148694511386678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Calculation_1740148694437040158]&#10;WHEN &apos;Initiated Attrition&apos; THEN [HiPe Attrition Effective (copy)_1740148694511140916]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe MoM Effective' datatype='real' name='[Calculation_1740148694513102904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN ([Calculation_1740148694437040158])-&#10;LOOKUP(([Calculation_1740148694437040158]),-1)&#10; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Not New Starters' datatype='boolean' name='[Calculation_1740148694675472463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_day_of_work]) &lt;= DATETRUNC(&apos;year&apos;, [report_month])' />
            </column>
            <column caption='HiPe Terminations Effective' datatype='integer' name='[HiPe Actuals (copy)_1740148694436929565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [manager_rating] &gt; 3 THEN [terminations_effective] END' />
            </column>
            <column caption='Latest HiPe Attrition' datatype='real' default-format='p0.0%' name='[HiPe Attrition (copy)_1740148694511640631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Calculation_1740148694509326386]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Latest HiPe Attrition Effective (copy)_1740148694511247413]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe MoM' datatype='real' default-format='p0.0%' name='[HiPe Attrition (copy)_1740148694515695675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Calculation_1740148694513102904]&#10;WHEN &apos;Initiated Attrition&apos; THEN [HiPe MoM Effective (copy)_1740148694515355706]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe Attrition Initiated' datatype='real' name='[HiPe Attrition Effective (copy)_1740148694511140916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([HiPe Terminations Effective (copy)_1740148694510911539]))&#10;&#10;/&#10;[Calculation_1740148694440132645]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe MoM Initiated' datatype='real' name='[HiPe MoM Effective (copy)_1740148694515355706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN ([HiPe Attrition Effective (copy)_1740148694511140916])-&#10;LOOKUP(([HiPe Attrition Effective (copy)_1740148694511140916]),-1)&#10; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HiPe Terminations Initiated' datatype='integer' name='[HiPe Terminations Effective (copy)_1740148694510911539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [manager_rating] &gt; 3 THEN [terminations_initiated] END' />
            </column>
            <column caption='Latest HiPe Attrition Initiated' datatype='real' name='[Latest HiPe Attrition Effective (copy)_1740148694511247413]' role='measure' type='quantitative'>
