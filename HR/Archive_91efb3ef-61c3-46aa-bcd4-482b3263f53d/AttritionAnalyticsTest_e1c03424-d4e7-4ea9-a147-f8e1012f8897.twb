        </calculation>
      </column>
      <column caption='Not New Starters' datatype='boolean' name='[Calculation_1740148694675472463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_day_of_work]) &lt;= DATETRUNC(&apos;year&apos;, [report_month])' />
