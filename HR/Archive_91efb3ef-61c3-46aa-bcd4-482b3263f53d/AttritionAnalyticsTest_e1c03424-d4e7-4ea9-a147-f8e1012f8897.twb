      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7C559FEFEC1F43A3BB68769B91A38628'>
            <properties context=''>
              <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='Custom SQL Query' type='text'>WITH historic_data as (
SELECT
date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date)) as report_month,
wh.company_id,
&apos;Historical Data&apos; as period,
cm.brand,
CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
chw.cost_center_name, 
sh.tenure_category,
CASE WHEN m.manager_02_full_name IS NULL THEN mh.manager_02_full_name ELSE m.manager_02_full_name END as manager_02_full_name,
CASE WHEN m.manager_03_full_name IS NULL THEN mh.manager_03_full_name ELSE m.manager_03_full_name END as manager_03_full_name,
CASE WHEN m.manager_04_full_name IS NULL THEN mh.manager_04_full_name ELSE m.manager_04_full_name END as manager_04_full_name,
wp.gender,
wh.management_level,
wh.employee_id,
CASE WHEN ti.termination_category IS NULL THEN te.termination_category ELSE ti.termination_category END as termination_category,
CASE WHEN ti.termination_reason IS NULL THEN te.termination_reason ELSE ti.termination_reason END as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
CASE WHEN te.is_termination_regrettable IS NULL THEN ti.is_termination_regrettable 
ELSE te.is_termination_regrettable END as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
te.last_updated

FROM
	people_ops_proposed.il_worker_hist_with_current wh

LEFT JOIN people_ops_proposed.il_manager m
	ON m.employee_id = wh.employee_id
	
LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh
	ON mh.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(mh.report_effective_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wh.employee_id
	
LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh
	ON sh.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(sh.report_effective_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))

LEFT JOIN people_ops_proposed.il_termination ti 
	ON ti.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(ti.termination_initiated_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))

LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(te.termination_effective_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))

WHERE (ti.status IS NULL OR ti.status IN (&apos;Successfully Completed&apos;,&apos;In Progress&apos;))
order by 1 desc

),

next_month as 
(
SELECT
CASE 
    WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
      THEN date_trunc(&apos;month&apos;,date_add(&apos;month&apos;, 1, cast(wh.report_effective_date as date)))
    ELSE null
  END AS report_month,
  wh.company_id,
  &apos;Future Data&apos; as period,
  cm.brand,
  CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
  CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
chw.cost_center_name,
s.tenure_category,
m.manager_02_full_name,
m.manager_03_full_name,
m.manager_04_full_name,
wp.gender,
wh.management_level,
wh.employee_id,
CASE WHEN ti.termination_category IS NULL THEN te.termination_category ELSE ti.termination_category END as termination_category,
CASE WHEN ti.termination_reason IS NULL THEN te.termination_reason ELSE ti.termination_reason END as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
CASE WHEN te.is_termination_regrettable IS NULL THEN ti.is_termination_regrettable 
ELSE te.is_termination_regrettable END as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
te.last_updated
  
FROM
	people_ops_proposed.il_worker_hist_with_current wh
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wh.employee_id = wp.employee_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_salary s
	ON wh.employee_id = s.employee_id 
	
LEFT JOIN
	people_ops_proposed.manager m
	ON wh.employee_id = m.employee_id 
	
LEFT JOIN people_ops_proposed.il_termination ti
	ON ti.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(ti.termination_initiated_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))	
	
LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(te.termination_effective_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))
	
WHERE date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date) 
	AND (ti.status IS NULL OR ti.status IN (&apos;Successfully Completed&apos;,&apos;In Progress&apos;)) 
	
),

next_next_month as 
(
SELECT
CASE 
    WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
      THEN date_trunc(&apos;month&apos;,date_add(&apos;month&apos;, 2, cast(wh.report_effective_date as date)))
    ELSE null
  END AS report_month,
  wh.company_id,
&apos;Future Data&apos; as period,
  cm.brand,
  CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
  CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
chw.cost_center_name,
s.tenure_category,
m.manager_02_full_name,
m.manager_03_full_name,
m.manager_04_full_name,
wp.gender,
wh.management_level,
wh.employee_id,
CASE WHEN ti.termination_category IS NULL THEN te.termination_category ELSE ti.termination_category END as termination_category,
CASE WHEN ti.termination_reason IS NULL THEN te.termination_reason ELSE ti.termination_reason END as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
CASE WHEN te.is_termination_regrettable IS NULL THEN ti.is_termination_regrettable 
ELSE te.is_termination_regrettable END as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
te.last_updated
  
FROM
	people_ops_proposed.il_worker_hist_with_current wh
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wh.employee_id = wp.employee_id 	
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 	
		
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_salary s
	ON wh.employee_id = s.employee_id 
	
LEFT JOIN
	people_ops_proposed.manager m
	ON wh.employee_id = m.employee_id 
	
LEFT JOIN people_ops_proposed.il_termination ti
	ON ti.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(ti.termination_initiated_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,2,current_date))	
	
LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(te.termination_effective_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,2,current_date))
	
WHERE date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
	AND (ti.status IS NULL OR ti.status IN (&apos;Successfully Completed&apos;,&apos;In Progress&apos;)) 
	
),

next_next_next_month as 
(
SELECT
CASE 
    WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
      THEN date_trunc(&apos;month&apos;,date_add(&apos;month&apos;, 3, cast(wh.report_effective_date as date)))
    ELSE null
  END AS report_month,
  wh.company_id,
&apos;Future Data&apos; as period,
  cm.brand,
  CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
  CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
chw.cost_center_name,
s.tenure_category,
m.manager_02_full_name,
m.manager_03_full_name,
m.manager_04_full_name,
wp.gender,
wh.management_level,
wh.employee_id,
CASE WHEN ti.termination_category IS NULL THEN te.termination_category ELSE ti.termination_category END as termination_category,
CASE WHEN ti.termination_reason IS NULL THEN te.termination_reason ELSE ti.termination_reason END as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
CASE WHEN te.is_termination_regrettable IS NULL THEN ti.is_termination_regrettable 
ELSE te.is_termination_regrettable END as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
te.last_updated
  
FROM
	people_ops_proposed.il_worker_hist_with_current wh
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wh.employee_id = wp.employee_id 	
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 	
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_salary s
	ON wh.employee_id = s.employee_id 
	
LEFT JOIN
	people_ops_proposed.manager m
	ON wh.employee_id = m.employee_id 
	
LEFT JOIN people_ops_proposed.il_termination ti
	ON ti.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(ti.termination_initiated_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,3,current_date))	
	
LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(te.termination_effective_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,3,current_date))
	
WHERE date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
	AND (ti.status IS NULL OR ti.status IN (&apos;Successfully Completed&apos;,&apos;In Progress&apos;)) 
	
),

future_data as 
(

SELECT
report_month,
company_id,
period,
brand,
department,
sub_department,
cost_center_name,
tenure_category,
manager_02_full_name,
manager_03_full_name,
manager_04_full_name,
gender,
management_level,
employee_id,
termination_category,
termination_reason,
terminations_initiated,
terminations_effective,
termination_regrettable,
actuals,
last_updated

FROM next_month

UNION 

SELECT
report_month,
company_id,
period,
brand,
department,
sub_department,
cost_center_name,
tenure_category,
manager_02_full_name,
manager_03_full_name,
manager_04_full_name,
gender,
management_level,
employee_id,
termination_category,
termination_reason,
terminations_initiated,
terminations_effective,
termination_regrettable,
actuals,
last_updated

FROM next_next_month

UNION 

SELECT
report_month,
company_id,
period,
brand,
department,
sub_department,
cost_center_name,
tenure_category,
manager_02_full_name,
manager_03_full_name,
manager_04_full_name,
gender,
management_level,
employee_id,
termination_category,
termination_reason,
terminations_initiated,
terminations_effective,
termination_regrettable,
actuals,
last_updated

FROM next_next_next_month

)

SELECT 
report_month,
company_id,
period,
brand,
department,
sub_department,
cost_center_name,
tenure_category,
coalesce (manager_02_full_name,&apos;Null&apos;) as manager_02_full_name,
coalesce (manager_03_full_name,&apos;Null&apos;) as manager_03_full_name,
coalesce (manager_04_full_name,&apos;Null&apos;) as manager_04_full_name,
gender,
management_level,
employee_id,
termination_category,
termination_reason,
terminations_initiated,
terminations_effective,
termination_regrettable,
actuals,
last_updated

FROM historic_data

UNION 

SELECT 
report_month,
company_id,
period,
brand,
department,
sub_department,
cost_center_name,
tenure_category,
coalesce (manager_02_full_name,&apos;Null&apos;) as manager_02_full_name,
coalesce (manager_03_full_name,&apos;Null&apos;) as manager_03_full_name,
coalesce (manager_04_full_name,&apos;Null&apos;) as manager_04_full_name,
gender,
management_level,
employee_id,
termination_category,
termination_reason,
terminations_initiated,
terminations_effective,
termination_regrettable,
actuals,
last_updated

FROM future_data

WHERE department IS NOT NULL 
	AND sub_department IS NOT NULL
	AND cost_center_name IS NOT NULL
	AND tenure_category IS NOT NULL
	AND gender IS NOT NULL
	AND management_level IS NOT NULL</relation>
            </properties>
