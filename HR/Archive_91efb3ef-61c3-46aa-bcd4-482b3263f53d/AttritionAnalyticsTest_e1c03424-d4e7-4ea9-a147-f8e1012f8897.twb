            <column caption='Voluntary - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition Initiated (copy)_141722670134165571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective_voluntary (copy)_5022076552060276837])&#10;/&#10;SUM([actuals])' />
