LEFT JOIN people_ops_proposed.il_termination ti
	ON ti.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(ti.termination_initiated_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))	
	
LEFT JOIN people_ops_proposed.il_termination te 
	ON te.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(te.termination_effective_date as date)) = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))
	
WHERE date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date) 
