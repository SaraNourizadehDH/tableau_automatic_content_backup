      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Calculation_2072640996132937729:qk:1]&quot;' value='Growth Plans Started' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Growth Plans Started \% (copy)_2072640996205391877:qk:6]&quot;' value='Growth Plans Completed' />
        </aliases>
      </column>
      <column caption='Growth Plans Started %' datatype='real' default-format='p0.0%' name='[Calculation_2072640996132937729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(WINDOW_SUM(sum([growth_plans_started]),-12,0))/sum([actual])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Growth Plans Completion' datatype='real' name='[Calculation_2072640996212420615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([growth_plans_completed])/SUM([growth_plans_started])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_2072640996216467466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date_month], [department]:  SUM([actual]) }' />
      </column>
      <column caption='GP Test' datatype='real' name='[Calculation_2072640996265283598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([growth_plans_started])/sum([actual])' />
      </column>
      <column caption='GP Max Date' datatype='string' name='[Calculation_2072640996265828367]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([date_month])=WINDOW_MAX(MAX([date_month])) &#10;&#9;THEN &apos;Max Date&apos; &#10;&#9;ELSE &apos;Other&apos;  &#10;&#9;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimensions' datatype='string' name='[Calculation_2072640996282863634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Department&apos; THEN [department]&#10;WHEN &apos;Career Tracks&apos; THEN [management_level (group)]&#10;WHEN &apos;Gender&apos; THEN [gender (group)]&#10;END' />
      </column>
      <column caption='Growth Plans Completion % (Last)' datatype='real' default-format='p0.0%' name='[Growth Plans Completed % (Last) (copy)_2072640996213026824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST () = 0 then FLOAT(WINDOW_SUM(sum([growth_plans_completed]),-12,0))/sum([actual]) end&#10;/&#10;IF LAST () = 0 then FLOAT(WINDOW_SUM(sum([growth_plans_started]),-12,0))/sum([actual]) end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Growth Plans Completed % (Last)' datatype='real' default-format='p0.0%' name='[Growth Plans Started % (Last) (copy)_2072640996205711366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST () = 0 then FLOAT(WINDOW_SUM(sum([growth_plans_completed]),-12,0))/sum([actual]) end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Growth Plans Started % (Last) (copy)' datatype='integer' default-format='p0.0%' name='[Growth Plans Started % (Last) (copy)_2072640996218753035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [department]: SUM(IF MONTH([date_month])= {MAX(MONTH([date_month]))} &#10;THEN [actual] END) }' />
      </column>
      <column caption='Growth Plans Started % (Last)' datatype='real' default-format='p0.0%' name='[Growth Plans Started % (copy)_2072640996171448324]' role='measure' type='quantitative'>
