        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.0lx0g001ro3z5n11s30zo0ohnm1i' name='Custom SQL Query' type='text'>WITH managers_email as (
	SELECT
		m.employee_id,
		m.managed_by,
		m.managed_by_full_name,
		wo.work_email as work_email_manager
	FROM people_ops_proposed.il_manager m
	LEFT JOIN people_ops_proposed.il_worker_org wo
		ON m.managed_by = wo.employee_id 
),

dimensions_worker AS (
    SELECT 
        wo.employee_id,
        CASE WHEN wp.middle_name is null THEN concat(wp.first_name,&apos; &apos;,wp.last_name) 
        	ELSE concat(wp.first_name,&apos; &apos;,wp.middle_name,&apos; &apos;,wp.last_name) 
        	END as full_name,
        wo.management_level,
        wp.gender,
        cha.department,
        m.manager_02_full_name,
        m.manager_03_full_name,
        me.work_email_manager
    FROM
        people_ops_proposed.il_worker_org wo  
        
    LEFT JOIN people_ops_proposed.il_worker_personal wp 
        ON wo.employee_id = wp.employee_id
        
    LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha
    	ON wo.cost_center_id = cha.cost_center_id
    	
    LEFT JOIN people_ops_proposed.il_manager m
    	ON wo.employee_id = m.employee_id
    
    LEFT JOIN managers_email me
    	ON wo.employee_id = me.employee_id		
    WHERE 
        wo.company_id = &apos;1001&apos;
        AND wo.is_terminated = 0
),

ratings_per_employee AS (
    SELECT 
        employee_id,
        p.manager_rating_explained,
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY prt.review_date DESC) AS rank_manager_rating
    FROM
        people_ops_proposed.il_performance p
    LEFT JOIN 
        people_ops_proposed.il_performance_review_template prt 
        ON p.review_template_id=prt.review_template_id 
    LEFT JOIN 
        people_ops_proposed.il_worker_personal wp 
        USING(employee_id)
    WHERE 
        p.company_id = &apos;1001&apos;
),

latest_rating_per_employee AS (
    SELECT 
        employee_id,
        manager_rating_explained AS last_manager_rating 
    FROM 
        ratings_per_employee 
		WHERE rank_manager_rating = 1
),

growth_plans_started AS (
	SELECT
		gp.employee_id,
		gp.last_updated,
		MAX(date_trunc(&apos;month&apos;,DATE(gp.bp_initiated_date))) AS latest_gp_started,
		COUNT(DISTINCT gp.employee_id) AS growth_plans_started
	FROM
        people_ops_proposed.il_growth_plan gp
        LEFT JOIN 
           people_ops_proposed.il_worker_hist_with_current wh
            ON gp.employee_id = wh.employee_id
            AND date_trunc(&apos;month&apos;,DATE(gp.bp_initiated_date)) = date_trunc(&apos;month&apos;,DATE(wh.report_effective_date))
        WHERE gp.is_growth_plan_started &gt;&gt; 0
        	AND wh.company_id = &apos;1001&apos;
        	AND date_trunc(&apos;month&apos;,DATE(gp.bp_initiated_date)) &gt;&gt;= date_trunc(&apos;year&apos;,current_date)
        GROUP BY
            1,2
    
),
growth_plans_completed AS (
	SELECT
		gp.employee_id,
		MAX(date_trunc(&apos;month&apos;,DATE(gp.bp_completed_date))) AS latest_gp_completed,
		COUNT(DISTINCT gp.employee_id) AS growth_plans_completed
	FROM
        people_ops_proposed.il_growth_plan gp
        LEFT JOIN 
           people_ops_proposed.il_worker_hist_with_current wh
            ON gp.employee_id = wh.employee_id
            AND date_trunc(&apos;month&apos;,DATE(gp.bp_completed_date)) = date_trunc(&apos;month&apos;,DATE(wh.report_effective_date))
        WHERE gp.is_growth_plan_started &gt;&gt; 0
        	AND wh.company_id = &apos;1001&apos;
        	AND date_trunc(&apos;month&apos;,DATE(gp.bp_completed_date)) &gt;&gt;= date_trunc(&apos;year&apos;,current_date)
        GROUP BY
            1
)

select
*

from dimensions_worker

left join latest_rating_per_employee
	using (employee_id)
	
left join growth_plans_started
	using (employee_id)
	
left join growth_plans_completed
	using (employee_id)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
