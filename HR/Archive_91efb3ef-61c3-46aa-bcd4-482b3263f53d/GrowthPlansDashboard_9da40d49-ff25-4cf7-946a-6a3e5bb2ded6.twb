              <relation name='_4C5A458A33E34DAB85FD6279CC5F3126' table='[Extract].[_4C5A458A33E34DAB85FD6279CC5F3126]' type='table' />
            </properties>
          </object>
          <object caption='il_manager' id='il_manager_6B3675B09CEB41D0A3C2FD83FC7BD69D'>
            <properties context=''>
              <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='il_manager' table='[people_ops_proposed].[il_manager]' type='table' />
