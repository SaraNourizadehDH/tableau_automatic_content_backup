              <bucket>&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[__tableau_internal_object_id__].[cnt:_4C5A458A33E34DAB85FD6279CC5F3126:qk]&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:avg_time_in_company:qk]&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:remote_hires_fte:qk]&quot;</bucket>
