            <column caption='Avg. Reward Driver' datatype='real' name='[Calculation_1077204779855192064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Reward Driver] * [Size])&#13;&#10;/ &#13;&#10;SUM([Size])' />
