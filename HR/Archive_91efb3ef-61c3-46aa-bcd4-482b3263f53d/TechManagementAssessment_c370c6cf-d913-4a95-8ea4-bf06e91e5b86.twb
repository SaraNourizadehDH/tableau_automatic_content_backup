              <formatted-text>
                <run bold='true' fontname='Tableau Semibold' fontsize='16'><![CDATA[<[federated.1p8iswu0uwp5r210iy3rn0m9iat0].[usr:Calculation_1077204779855192064:qk]>]]></run>
