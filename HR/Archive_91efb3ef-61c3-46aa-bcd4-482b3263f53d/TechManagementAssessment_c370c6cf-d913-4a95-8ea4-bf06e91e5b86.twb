      <aliases enabled='yes' />
      <column caption='growth_plans' datatype='real' name='[Calculation_288019302206734337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([growth_plans_started])/([Calculation_848013768134762497])' />
      </column>
      <column caption='actuals_new_joiners' datatype='integer' name='[Calculation_288019302219575298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF [first_day_of_work] &gt;= DATE(&apos;2023-01-01&apos;) THEN [employee_id] END)' />
      </column>
      <column caption='female_new_joiners' datatype='real' name='[Calculation_288019302223405065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actuals_new_joiners (copy)_288019302223294472]/[Calculation_288019302219575298]' />
      </column>
      <column caption='continous_low_performers' datatype='real' name='[Calculation_288019302349631498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([continous_low_pe])/sum([low_performers_last])' />
      </column>
      <column caption='actuals' datatype='integer' name='[Calculation_848013768134762497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id])' />
      </column>
      <column caption='attrition_effective' datatype='real' name='[Calculation_848013768137879554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([terminations_count])/([Calculation_848013768134762497])' />
      </column>
      <column caption='Last' datatype='boolean' name='[Calculation_848013768138223619]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()=0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='high_performers_terminations' datatype='integer' name='[Calculation_848013768139157508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [high_performer_last_cycle] = 1 AND [terminations_count] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='promotion_rate' datatype='real' name='[Calculation_848013768142950406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_promotion])/([Calculation_848013768134762497])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_A205F04643B94985A50D1E9D6F0B9E82]' role='measure' type='quantitative' />
      <column caption='terminations_new_joiners' datatype='integer' name='[actuals_new_joiners (copy)_288019302220103685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF [first_day_of_work] &gt;= DATE(&apos;2023-01-01&apos;) AND [terminations_count] &gt; 0&#10;THEN [employee_id] END)' />
      </column>
      <column caption='actuals_new_joiners (Female)' datatype='integer' name='[actuals_new_joiners (copy)_288019302223294472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF [first_day_of_work] &gt;= DATE(&apos;2023-01-01&apos;)&#10;AND [gender]= &apos;Female&apos;&#10;THEN [employee_id] END)' />
      </column>
