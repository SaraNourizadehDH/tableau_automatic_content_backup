      <table>
        <view>
          <datasources>
            <datasource caption='historic_data' name='federated.1p7uw9b1riucu113urcec1tp5jn4' />
          </datasources>
          <datasource-dependencies datasource='federated.1p7uw9b1riucu113urcec1tp5jn4'>
            <column caption='Last' datatype='boolean' name='[Calculation_848013768138223619]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()=0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='high_performers_terminations' datatype='integer' name='[Calculation_848013768139157508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [high_performer_last_cycle] = 1 AND [terminations_count] = 1 THEN 1 ELSE 0 END' />
            </column>
            <column caption='attrition_effective (HiPer)' datatype='real' name='[attrition_effective (copy)_848013768139288581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_848013768139157508])/sum([high_performer_last_cycle])' />
            </column>
            <column-instance column='[Calculation_848013768139157508]' derivation='Sum' name='[cum:sum:Calculation_848013768139157508:qk]' pivot='key' type='quantitative'>
