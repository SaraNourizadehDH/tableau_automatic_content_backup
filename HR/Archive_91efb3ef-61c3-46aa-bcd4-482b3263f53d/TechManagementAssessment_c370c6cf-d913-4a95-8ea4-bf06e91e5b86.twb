        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1eadct80mshnaq1bxensk05qv1n6' name='Custom SQL Query' type='text'>WITH experience AS (&#13;
   SELECT&#13;
      job_requisition_id,&#13;
      SUM(CASE &#13;
      	WHEN answer IN (&apos;10&apos;,&apos;9&apos;) THEN 1&#13;
      	ELSE 0&#13;
      END) AS promoters,&#13;
      SUM(CASE &#13;
      	WHEN answer IN (&apos;8&apos;,&apos;7&apos;) THEN 1&#13;
      	ELSE 0&#13;
      END) AS passives,&#13;
      SUM(CASE &#13;
      	WHEN answer IN (&apos;6&apos;,&apos;5&apos;,&apos;4&apos;,&apos;3&apos;,&apos;2&apos;,&apos;1&apos;,&apos;0&apos;) THEN 1&#13;
      	ELSE 0&#13;
      END) AS detractors&#13;
   FROM&#13;
      people_ops_proposed.il_recruitment_survey_answer&#13;
   WHERE&#13;
      module = &apos;Candidate Experience&apos;&#13;
      AND driver = &apos;NPS&apos;&#13;
   GROUP BY&#13;
      1&#13;
),&#13;
candidates AS (&#13;
   SELECT&#13;
      rc.candidate_wd_id,&#13;
      rc.candidate_id,&#13;
      rc.job_requisition_id,&#13;
      m.managed_by_full_name,&#13;
      m.manager_03_full_name,&#13;
      m.manager_04_full_name,&#13;
      m.manager_05_full_name,&#13;
      m.manager_06_full_name,&#13;
      m.manager_07_full_name,&#13;
      m.manager_08_full_name,&#13;
      m.manager_09_full_name,&#13;
      m.manager_10_full_name,&#13;
      rc.candidate_gender&#13;
   FROM&#13;
      people_ops_proposed.il_recruitment_corpus rc&#13;
      LEFT JOIN people_ops_proposed.il_job_requisition jr ON rc.job_requisition_id = jr.job_requisition_id&#13;
      LEFT JOIN people_ops_proposed.il_manager m ON jr.hiring_manager_id = m.employee_id&#13;
   WHERE&#13;
      m.manager_id_02 = &apos;2020-08-0169&apos;&#13;
      AND date(rc.application_date) &gt;&gt;= date_trunc(&apos;year&apos;, current_date) - interval &apos;1&apos; year&#13;
)&#13;
SELECT&#13;
   c.candidate_wd_id,&#13;
   c.candidate_id,&#13;
   c.job_requisition_id,&#13;
   c.managed_by_full_name,&#13;
   c.manager_03_full_name,&#13;
   c.manager_04_full_name,&#13;
   c.manager_05_full_name,&#13;
   c.manager_06_full_name,&#13;
   c.manager_07_full_name,&#13;
   c.manager_08_full_name,&#13;
   c.manager_09_full_name,&#13;
   c.manager_10_full_name,&#13;
   c.candidate_gender,&#13;
   e.promoters,&#13;
   e.passives,&#13;
   e.detractors&#13;
FROM&#13;
   candidates c&#13;
   LEFT JOIN experience e ON e.job_requisition_id = c.job_requisition_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
