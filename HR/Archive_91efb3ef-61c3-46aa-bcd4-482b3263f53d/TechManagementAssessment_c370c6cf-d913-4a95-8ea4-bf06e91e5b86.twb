    <worksheet name='growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='9'>Growth Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='survey_qualtrics' name='federated.1aou4ut0f9fgy813vs4x210ktxfj' />
          </datasources>
          <datasource-dependencies datasource='federated.1aou4ut0f9fgy813vs4x210ktxfj'>
            <column caption='user.name03' datatype='string' name='[Calculation_202380552904515585]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE([work_email_manager_03],&quot;@deliveryhero.com&quot;,&quot;&quot;)' />
            </column>
            <column caption='User Calculation' datatype='string' name='[Calculation_202380552904822787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH - Talent Development&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN 1&#10;&#10;&#10;ELSEIF USERNAME()=[Calculation_202380552904515585] OR USERNAME()=[work_email_manager_03]&#10; THEN 1 &#10;&#10;ELSEIF USERNAME()=[user.name03 (copy)_202380552904679426] OR USERNAME()=[work_email_manager_04]&#10; THEN 1 &#10;&#10;END)' />
            </column>
            <column caption='G. Career Development 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[G. Career Development (copy)_1077204779936018441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [My manager has had a meaningful discussion with me about my career development in the past six months and assigns stretch oppor (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
            </column>
            <column caption='G. Consideration 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[G. Consideration (copy)_1077204779936018439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [My manager consistently shows consideration for me as a person (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
            </column>
            <column caption='G. Feedback 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[G. Feedback (copy)_1077204779936018443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [My manager actively seeks feedback from the team on their managerial approach and make necessary improvements (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
            </column>
            <column caption='Growth 5' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Growth (copy)_1077204779936518160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;AVG([G. Career Development (copy)_1077204779936018441]) + AVG([G. Consideration (copy)_1077204779936018439]) + AVG([G. Feedback (copy)_1077204779936018443])&#13;&#10;)&#13;&#10;/&#13;&#10;3' />
            </column>
            <column datatype='string' name='[My manager actively seeks feedback from the team on their managerial approach and make necessary improvements (tech!responses!19-01-241)]' role='dimension' type='nominal' />
            <column datatype='string' name='[My manager consistently shows consideration for me as a person (tech!responses!19-01-241)]' role='dimension' type='nominal' />
            <column datatype='string' name='[My manager has had a meaningful discussion with me about my career development in the past six months and assigns stretch oppor (tech!responses!19-01-241)]' role='dimension' type='nominal' />
