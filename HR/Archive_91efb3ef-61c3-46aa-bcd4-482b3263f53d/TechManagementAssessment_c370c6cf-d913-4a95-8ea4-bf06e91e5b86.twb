      <aliases enabled='yes' />
      <column caption='% Detractors' datatype='real' default-format='p0%' name='[% Promoters (copy)_232216899481522178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([detractors]) &#13;&#10;/&#13;&#10;SUM([Calculation_232216899481337856])' />
      </column>
      <column caption='answers' datatype='integer' name='[Calculation_232216899481337856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[promoters] + [passives] + [detractors]' />
      </column>
      <column caption='% Promoters' datatype='real' default-format='p0%' name='[Calculation_232216899481427969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promoters]) &#13;&#10;/&#13;&#10;SUM([Calculation_232216899481337856])' />
      </column>
      <column caption='Candidate NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_232216899481657347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([Calculation_232216899481427969] - [% Promoters (copy)_232216899481522178]) * 100, 0)' />
      </column>
      <column caption='female_candidates' datatype='integer' name='[Calculation_288019302360805390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [candidate_gender] = &apos;female&apos; then [candidate_id] end)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_264C9372B19648039D9C872933C96F91]' role='measure' type='quantitative' />
      <column caption='candidates' datatype='integer' name='[female_candidates (copy)_1077204779881615362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([candidate_id])' />
      </column>
      <column caption='%_female_candidates' datatype='real' name='[female_candidates (copy)_288019302361047055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_288019302360805390]/COUNTD([candidate_id])' />
      </column>
