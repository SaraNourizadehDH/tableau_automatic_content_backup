              <calculation class='tableau' formula='(&#13;&#10;AVG([O. Communication (copy)_1077204779936018442]) + AVG([O. Technical (copy)_1077204779936018436]) + AVG([O. Effective Decisions (copy)_1077204779936018437]) + AVG([O. Workload Balance (copy)_1077204779936018444])&#13;&#10;&#13;&#10;+AVG([C. Value Diverse Perspectives (copy)_1077204779936018438]) + AVG([C. Cross Collaboration (copy)_1077204779936018440]) + AVG([C. Decision Making (copy)_1077204779936018435])&#13;&#10;&#13;&#10;&#13;&#10;+AVG([G. Career Development (copy)_1077204779936018441]) + AVG([G. Consideration (copy)_1077204779936018439]) + AVG([G. Feedback (copy)_1077204779936018443])&#13;&#10;)&#13;&#10;/&#13;&#10;10' />
