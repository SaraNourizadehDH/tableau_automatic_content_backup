    <worksheet name='attrition_new_joiners'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='8'>Attrition  New Joiners</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='historic_data' name='federated.1p7uw9b1riucu113urcec1tp5jn4' />
          </datasources>
          <datasource-dependencies datasource='federated.1p7uw9b1riucu113urcec1tp5jn4'>
            <column caption='actuals_new_joiners' datatype='integer' name='[Calculation_288019302219575298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(IF [first_day_of_work] &gt;= DATE(&apos;2023-01-01&apos;) THEN [employee_id] END)' />
            </column>
            <column caption='Last' datatype='boolean' name='[Calculation_848013768138223619]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()=0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='terminations_new_joiners' datatype='integer' name='[actuals_new_joiners (copy)_288019302220103685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(IF [first_day_of_work] &gt;= DATE(&apos;2023-01-01&apos;) AND [terminations_count] &gt; 0&#10;THEN [employee_id] END)' />
            </column>
            <column caption='attrition_effective (New Joiners)' datatype='real' name='[attrition_effective (HiPer) (copy)_288019302220398598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([actuals_new_joiners (copy)_288019302220103685])/([Calculation_288019302219575298])' />
