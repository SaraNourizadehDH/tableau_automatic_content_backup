        <objects>
          <object caption='Custom SQL Query' id='_4037CB485F1D46F7A21BE1557C3277EC'>
            <properties context=''>
              <relation connection='athena.0pent3f011qqt31atluin0sk5vd3' name='Custom SQL Query' type='text'>select 
	m.manager_id_03,
	m.manager_id_04,
	wo.work_email as work_email_manager_03,
	wo4.work_email as work_email_manager_04
	
	from people_ops_proposed.il_manager m
	
	left join people_ops_proposed.il_worker_org wo
		on wo.employee_id = m.manager_id_03 
		
	left join people_ops_proposed.il_worker_org wo4
		on wo4.employee_id = m.manager_id_04</relation>
            </properties>
            <properties context='extract'>
