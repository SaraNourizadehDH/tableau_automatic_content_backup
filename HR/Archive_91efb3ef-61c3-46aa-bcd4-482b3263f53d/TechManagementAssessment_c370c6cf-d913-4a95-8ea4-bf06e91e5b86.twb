            <column caption='User Calculation' datatype='string' name='[Calculation_202380552904822787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH - Talent Development&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN 1&#10;&#10;&#10;ELSEIF USERNAME()=[Calculation_202380552904515585] OR USERNAME()=[work_email_manager_03]&#10; THEN 1 &#10;&#10;ELSEIF USERNAME()=[user.name03 (copy)_202380552904679426] OR USERNAME()=[work_email_manager_04]&#10; THEN 1 &#10;&#10;END)' />
