      <column caption='C. Cross Collaboration 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[C. Cross Collaboration (copy)_1077204779936018440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [My manager effectively collaborates across boundaries (e.g., team, organizational, has a strong partnership with the product ma (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
      </column>
      <column caption='C. Decision Making 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[C. Decision Making (copy)_1077204779936018435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [My manager actively involves myself and others in decision-making related to projects (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
      </column>
      <column caption='C. Value Diverse Perspectives 5' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[C. Value Diverse Perspectives (copy)_1077204779936018438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [The actions of my manager show they value the perspective I bring to the team, even if it is different from their own (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 2&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 3&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 4&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 5&#13;&#10;END' />
      </column>
      <column caption='C. Decision Making' datatype='integer' name='[C. Value Diverse Perspectives (copy)_1551771583969304583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [My manager actively involves myself and others in decision-making related to projects (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#13;&#10;WHEN &apos;Somewhat disagree&apos; THEN 1&#13;&#10;WHEN &apos;Neither agree nor disagree&apos; THEN 2&#13;&#10;WHEN &apos;Somewhat agree&apos; THEN 3&#13;&#10;WHEN &apos;Strongly agree&apos; THEN 3 &#13;&#10;END' />
      </column>
      <column caption='user.name03' datatype='string' name='[Calculation_202380552904515585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([work_email_manager_03],&quot;@deliveryhero.com&quot;,&quot;&quot;)' />
      </column>
      <column caption='User Calculation' datatype='string' name='[Calculation_202380552904822787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH - Talent Development&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN 1&#10;&#10;&#10;ELSEIF USERNAME()=[Calculation_202380552904515585] OR USERNAME()=[work_email_manager_03]&#10; THEN 1 &#10;&#10;ELSEIF USERNAME()=[user.name03 (copy)_202380552904679426] OR USERNAME()=[work_email_manager_04]&#10; THEN 1 &#10;&#10;END)' />
      </column>
      <column caption='Ownership' datatype='real' name='[Calculation_288019304682721321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG([Delegation (copy)_288019304393920531]) + AVG([Career Development (copy)_288019304394424344]) + AVG([Career Development (copy)_288019304394637338]) + AVG([O. Communication (copy)_1551771583964012548])&#13;&#10;)&#13;&#10;/&#13;&#10;4' />
      </column>
      <column caption='Response Rate' datatype='real' name='[Calculation_3634545678943649792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_440438005036388355])/1937' />
      </column>
      <column caption='Responses' datatype='integer' name='[Calculation_440438005036388355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Recipient Email (tech!responses!19-01-241)])' />
      </column>
      <column caption='min_3_responses' datatype='boolean' datatype-customized='true' name='[Calculation_440438005036433412]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF TOTAL([Calculation_440438005036388355]) &gt;3 THEN TRUE ELSE FALSE END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='O. Technical' datatype='integer' name='[Career Development (copy)_288019304394424344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [My manager has the technical expertise required to effectively manage me (tech!responses!19-01-241)]&#10;WHEN &apos;Strongly Disagree&apos; THEN 1 &#10;WHEN &apos;Somewhat Disagree&apos; THEN 1 &#10;WHEN &apos;Neither agree nor disagree&apos; THEN 2&#10;WHEN &apos;Somewhat Agree&apos; THEN 3&#10;WHEN &apos;Strongly Agree&apos; THEN 3 &#10;END' />
      </column>
