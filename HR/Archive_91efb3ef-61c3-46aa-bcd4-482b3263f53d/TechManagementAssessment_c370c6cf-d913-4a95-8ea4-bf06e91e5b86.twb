        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1kpo8us0zxfmvi10xil5b0aq7453' name='Custom SQL Query' type='text'><![CDATA[WITH high_performers_last AS (
   SELECT
      p.employee_id,
      p.manager_rating_explained
   FROM
      people_ops_proposed.il_performance p
   WHERE
      p.bp_status = 'Successfully Completed'
      AND p.review_date = '2023-01-01'
      AND manager_rating_explained IN ('Exceeding', 'Outstanding')
),
actuals AS (
   SELECT
      date_trunc('month', cast(whc.report_effective_date AS date)) AS report_date,
      date_trunc('month', cast(whc.first_day_of_work AS date)) AS first_day_of_work,
      whc.employee_id,
      mhc.managed_by,
      mhc.managed_by_full_name,
      mhc.manager_02_full_name,
      mhc.manager_03_full_name,
      mhc.manager_04_full_name,
      mhc.manager_05_full_name,
      mhc.manager_06_full_name,
      mhc.manager_07_full_name,
      mhc.manager_08_full_name,
      mhc.manager_09_full_name,
      mhc.manager_10_full_name,
      shc.tenure_category,
      wp.gender,
      CASE
         WHEN hp.employee_id IS NOT NULL THEN 1
         ELSE 0
      END AS high_performer_last_cycle
   FROM
      people_ops_proposed.il_worker_hist_with_current whc
      LEFT JOIN people_ops_proposed.il_manager mhc ON whc.employee_id = mhc.employee_id
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON whc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_salary_hist_with_current shc ON whc.employee_id = shc.employee_id
      AND date_trunc('month', cast(whc.report_effective_date AS date)) = date_trunc('month', cast(shc.report_effective_date AS date))
      LEFT JOIN high_performers_last hp ON whc.employee_id = hp.employee_id
   WHERE
      mhc.manager_id_02 = '2020-08-0169'
      AND date_trunc('month', DATE(whc.report_effective_date)) >>= date_trunc('year', current_date)
),
promotions AS (
   SELECT
      date_trunc('month', cast(p.change_effective_date AS date)) AS promotion_date,
      p.employee_id,
      m.managed_by,
      p.is_promotion
   FROM
      people_ops_proposed.il_promotion p
      LEFT JOIN people_ops_proposed.il_manager m ON p.employee_id = m.employee_id
   WHERE
      m.manager_id_02 = '2020-08-0169'
      AND p.bp_event_category = 'Promotion'
      AND p.bp_status = 'Successfully Completed'
),
development_plans_started AS (
   SELECT
      gp.employee_id,
      m.managed_by,
      MAX(date_trunc('month', DATE(gp.bp_initiated_date))) AS latest_gp_started,
      COUNT(DISTINCT gp.employee_id) AS development_plans_started
   FROM
      people_ops_proposed.il_growth_plan gp
      LEFT JOIN people_ops_proposed.il_manager m ON gp.employee_id = m.employee_id
   WHERE
      (
         gp.reflection_questions_started >> 0
         OR gp.development_item_started >> 0
      )
      AND date_trunc('month', DATE(gp.bp_initiated_date)) >>= date_trunc('year', current_date)
      AND gp.bp_status IN ('In Progress', 'Successfully Completed')
      AND gp.growth_plan_type = 'Development Plan'
   GROUP BY
      1,
      2
),
growth_plans_started AS (
   SELECT
      gp.employee_id,
      m.managed_by,
      MAX(date_trunc('month', DATE(gp.bp_initiated_date))) AS latest_gp_started,
      COUNT(DISTINCT gp.employee_id) AS growth_plans_started
   FROM
      people_ops_proposed.il_growth_plan gp
      LEFT JOIN people_ops_proposed.il_manager m ON gp.employee_id = m.employee_id
   WHERE
      (
         gp.reflection_questions_started >> 0
         OR gp.development_item_started >> 0
      )
      AND date_trunc('month', DATE(gp.bp_initiated_date)) >>= date_trunc('year', current_date)
      AND gp.bp_status IN ('In Progress', 'Successfully Completed')
      AND gp.growth_plan_type = 'Growth Plan'
   GROUP BY
      1,
      2
),
attrition AS (
   SELECT
      date_trunc(
         'month',
         cast(t.termination_effective_date AS date)
      ) AS termination_date,
      t.employee_id,
      m.managed_by,
      count(DISTINCT t.employee_id) AS terminations_count
   FROM
      people_ops_proposed.il_termination t
      LEFT JOIN people_ops_proposed.il_manager m ON t.employee_id = m.employee_id
   WHERE
      t.status <<>> 'Canceled'
      AND date_trunc(
         'month',
         cast(t.termination_effective_date AS date)
      ) >>= date_trunc('year', current_date)
      AND m.manager_id_02 = '2020-08-0169'
   GROUP BY
      1,
      2,
      3
),
onboarding_answers AS (
   SELECT
      employee_id,
      answer,
      max(date_trunc('month', date(response_date))) AS response_date
   FROM
      people_ops_proposed.pl_ps_onboarding_experience_questions_with_attendees s
   WHERE
      survey = 'Onboarding - After 100 days'
      AND question_type = 'Star rating scale'
      AND question = 'Keeping in mind your first 100 days, how likely are you to recommend {org} as an Employer to a friend or former colleague?'
      AND date(s.response_date) >>= date('2023-01-01')
      AND manager_id IS NOT NULL
   GROUP BY
      1,
      2
),
compa_ratio AS (
   SELECT
      employee_id,
      round(salary_amount_annualized) / round(mid_salary_range) AS latest_compa_ratio
   FROM
      people_ops_proposed.il_salary
   WHERE
      mid_salary_range >> 1000
      AND salary_currency = 'EUR'
),
low_performers_last AS (
   SELECT
      p.employee_id,
      p.manager_rating_explained,
      count(p.employee_id) AS low_performers_last
   FROM
      people_ops_proposed.il_performance p
      LEFT JOIN people_ops_proposed.il_manager m ON p.employee_id = m.employee_id
   WHERE
      p.bp_status = 'Successfully Completed'
      AND p.review_date = '2023-01-01'
      AND manager_rating_explained IN (
         'Off Track',
         'Development Needed',
         'Unsatisfactory'
      )
      AND m.manager_id_02 = '2020-08-0169'
   GROUP BY
      1,
      2
),
low_performers_pre AS (
   SELECT
      p.employee_id,
      p.manager_rating_explained
   FROM
      people_ops_proposed.il_performance p
   WHERE
      p.bp_status = 'Successfully Completed'
      AND p.review_date = '2022-07-01'
      AND manager_rating_explained IN (
         'Off Track',
         'Development Needed',
         'Unsatisfactory'
      )
),
continous_low_pe AS (
   SELECT
      lpl.employee_id,
      lpl.manager_rating_explained AS last_rating,
      lpp.manager_rating_explained AS pre_rating,
      CASE
         WHEN lpl.employee_id IS NOT NULL THEN 1
         ELSE 0
      END AS continous_low_pe
   FROM
      low_performers_last lpl
      LEFT JOIN low_performers_pre lpp ON lpl.employee_id = lpp.employee_id
   WHERE
      lpp.employee_id IS NOT NULL
)
SELECT
   a.report_date,
   a.first_day_of_work,
   a.employee_id,
   a.managed_by,
   a.managed_by_full_name,
   a.manager_02_full_name,
   a.manager_03_full_name,
   a.manager_04_full_name,
   a.manager_05_full_name,
   a.manager_06_full_name,
   a.manager_07_full_name,
   a.manager_08_full_name,
   a.manager_09_full_name,
   a.manager_10_full_name,
   a.tenure_category,
   a.gender,
   a.high_performer_last_cycle,
   p.is_promotion,
   gps.growth_plans_started,
   dps.development_plans_started,
   att.terminations_count,
   oa.answer,
   cr.latest_compa_ratio,
   clp.continous_low_pe,
   lpl.low_performers_last
FROM
   actuals a
   LEFT JOIN promotions p ON p.employee_id = a.employee_id
   AND p.promotion_date = a.report_date
   LEFT JOIN growth_plans_started gps ON gps.employee_id = a.employee_id
   AND gps.latest_gp_started = a.report_date
   LEFT JOIN development_plans_started dps ON dps.employee_id = a.employee_id
   AND dps.latest_gp_started = a.report_date
   LEFT JOIN attrition att ON att.employee_id = a.employee_id
   AND att.termination_date = a.report_date
   LEFT JOIN onboarding_answers oa ON oa.employee_id = a.employee_id
   AND oa.response_date = a.report_date
   LEFT JOIN compa_ratio cr ON cr.employee_id = a.employee_id
   LEFT JOIN low_performers_last lpl ON lpl.employee_id = a.employee_id
   LEFT JOIN continous_low_pe clp ON clp.employee_id = a.employee_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
