              <zone forceUpdate='true' h='40123' id='433' type-v2='text' w='98858' x='571' y='10667'>
                <formatted-text>
                  <run fontcolor='#333333' fontsize='12'>Hello! </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#333333' fontsize='12'>A new version of the rider safety dashboard is now available! Please click the following link to access the new dashboard which has more features and metrics:</run>
                  <run>Æ&#10;</run>
                  <run auto-url='true' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/t/GlobalStandardReporting/views/RiderSafetyDashboard/CustomTabularView?%3Aembed=y&amp;amp;%3AisGuestRedirectFromVizportal=y#1&amp;quot;'>https://tableau.deliveryhero.net/t/GlobalStandardReporting/views/RiderSafetyDashboard/CustomTabularView?%3Aembed=y&amp;%3AisGuestRedirectFromVizportal=y#1</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#333333' fontsize='12'>Should you not be able to access it, please follow this link:</run>
                  <run>Æ&#10;</run>
                  <run auto-url='true' fontcolor='#333333' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://product.deliveryhero.net/internal-it/documentation/how-to-request-account-access-using-sailpoint-iiq-self-service/&amp;quot;'>https://product.deliveryhero.net/internal-it/documentation/how-to-request-account-access-using-sailpoint-iiq-self-service/</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#333333' fontsize='12'>If you have any problems with this process, please contact </run>
