      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[_4ED569305B854B3CA5FD8EB0C632D623]' role='measure' type='quantitative' />
      <column caption='c_level (one pager)' datatype='string' name='[c_level (copy)_1468032790984159260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[c_level (group)]' />
        <aliases>
          <alias key='%null%' value='C Level Team' />
        </aliases>
      </column>
      <column datatype='string' name='[c_level (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[c_level]' new-bin='true'>
          <bin default-name='false' value='&quot;C Level team&quot;'>
            <value>%null%</value>
          </bin>
          <bin default-name='false' value='&quot;Marie-Anne Popp&quot;'>
            <value>&quot;Laura Diaconescu&quot;</value>
            <value>&quot;Marie-Anne Popp&quot;</value>
            <value>&quot;Petko Hristov Peev&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Other Direct Reports&quot;'>
            <value>&quot;Anna Slater&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[c_level]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='C Level team' />
        </aliases>
      </column>
      <column caption='C-1' datatype='string' name='[c_minus_1]' role='dimension' type='nominal' />
      <column caption='C-1 Email' datatype='string' name='[c_minus_1_email]' role='dimension' type='nominal' />
      <column caption='C-2' datatype='string' name='[c_minus_2]' role='dimension' type='nominal' />
      <column caption='C-2 Email' datatype='string' name='[c_minus_2_email]' role='dimension' type='nominal' />
      <column datatype='date' name='[date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[day_of_week]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Friday&quot;' value='Fri' />
          <alias key='&quot;Monday&quot;' value='Mon' />
          <alias key='&quot;Thursday&quot;' value='Thu' />
          <alias key='&quot;Tuesday&quot;' value='Tue' />
          <alias key='&quot;Wednesday&quot;' value='Wed' />
        </aliases>
      </column>
      <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
      <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='exclude_current_week (copy)' datatype='integer' name='[exclude_current_week (copy)_5246552882999767040]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF WEEK([date])=WEEK(TODAY()) THEN 0 ELSE 1 END' />
      </column>
      <column caption='entrance_hours' datatype='string' name='[first_entrance&gt;11 (copy)_68679952070287360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [event_date_time]) &lt;= 11 &#10;THEN &apos;9hs - 10hs&apos;&#10;&#10;ELSEIF &#10;DATEPART(&apos;hour&apos;, [event_date_time]) &gt;= 12 AND(DATEPART(&apos;hour&apos;, [event_date_time]) &lt;= 13)&#10;THEN &apos;11hs - 12hs&apos; &#10;&#10;ELSEIF &#10;DATEPART(&apos;hour&apos;, [event_date_time]) &gt; 13 &#10;THEN &apos;13hs &amp; above&apos; &#10;&#10;END' />
      </column>
      <column caption='Employee Name' datatype='string' name='[full_name]' role='dimension' type='nominal' />
      <column caption='HR Analyst' datatype='string' name='[hr_analyst]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[is_terminated]' role='dimension' type='ordinal' />
      <column datatype='string' datatype-customized='true' name='[latest_is_terminated]' role='dimension' type='nominal' />
      <column caption='Direct Manager' datatype='string' name='[managed_by_full_name]' role='dimension' type='nominal' />
      <column caption='Direct Manager Email' datatype='string' name='[managed_by_work_email]' role='dimension' type='nominal' />
      <column datatype='string' name='[management_level (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
