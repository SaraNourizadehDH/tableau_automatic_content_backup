            <column datatype='string' name='[c_level (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[c_level]' new-bin='true'>
                <bin default-name='false' value='&quot;C Level team&quot;'>
                  <value>%null%</value>
