LSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;nicolas.daudin@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Johannes Bruder&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;timo.chambers@deliveryhero.com&apos;) OR USERNAME()=(&apos;timo.chambers&apos;) &#10;THEN &#10;IF [c_level]=&apos;Johannes Bruder&apos; THEN 1 ELSE 0 END&#10;&#10;//OLE&#10;ELSEIF  USERNAME()=(&apos;chirag.dureja@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ole Helliesen&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;guido.anastasia@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ole Helliesen&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;julien.moeller@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ole Helliesen&apos; THEN 1 ELSE 0 END&#10;&#10;//PJ&#10;ELSEIF  USERNAME()=(&apos;giuseppe.randazzo@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;milena.lazarevska@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;philipp.markmann@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;tomaso@talabat.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;//EXECUTIVE ASSISTANTS&#10;&#10;ELSEIF  USERNAME()=(&apos;berit.geiler@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;bianca.balen@deliveryhero.com&apos;) THEN &#10;IF [managed_by_full_name]=&apos;Niklas Östberg&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;madalena.vieira@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Benjamin Mann&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;monica.ivancea@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ana Mitrasevic&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;esther.molitor@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Emmanuel Thomassin&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;anwesha.roy@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Emmanuel Thomassin&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;anna.slater@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Johannes Bruder&apos; THEN 1 ELSE 0 END&#10;&#10;&#10;END' />
