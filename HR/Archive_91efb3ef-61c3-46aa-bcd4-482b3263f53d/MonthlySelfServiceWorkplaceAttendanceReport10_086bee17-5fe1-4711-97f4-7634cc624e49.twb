      </filter>
      <filter class='relative-date' column='[none:date:qk]' filter-group='2' first-period='-5' include-future='true' include-null='false' last-period='0' period-type-v2='month' />
      <filter class='categorical' column='[tenure_category]' filter-group='2'>
