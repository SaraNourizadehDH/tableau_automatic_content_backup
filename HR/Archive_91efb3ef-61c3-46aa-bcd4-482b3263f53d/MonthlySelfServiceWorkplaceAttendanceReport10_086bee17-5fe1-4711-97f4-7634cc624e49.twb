            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#666666' fontsize='9'>- Before Feb 2024: employees that attended the office </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>one</run>
                <run bold='true' fontcolor='#666666' fontsize='9'> day per week. </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#666666' fontsize='9'>- After Feb 2024: employees that attended the office </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>two</run>
                <run bold='true' fontcolor='#666666' fontsize='9'> days per week </run>
                <run fontcolor='#666666' fontsize='7' italic='true'>(*excluding those who had remote working days during the week, business travels or more than 3 days off due to sickness or holidays. If the employee had 2 or less days off due to sickness or holidays they will be considered meet expectations if they attend  1 day during that particular week)</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
