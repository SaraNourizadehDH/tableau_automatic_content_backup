              <calculation class='tableau' formula='IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;natalia.cosa@deliveryhero.com&apos;) THEN 1&#10;&#10;ELSEIF USERNAME()=(&apos;rui.tavares@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;rui.belchior@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;melody.dowling@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;ole.helliesen@deliveryhero.com&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN &#10;    IF [c_level] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [c_level] &lt;&gt; &apos;Jeri Lynne Doris&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=[Calculation_5246552883045548035] OR USERNAME()=[c_level_email]&#10; THEN 1 &#10;&#10;&#10;ELSEIF USERNAME()=(&apos;berrin.altinok@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Vendor Product&apos; &#10;    or [sub_department]=&apos;Vendor Tech&apos;&#10;    or [sub_department]=&apos;Q-Commerce&apos; THEN  1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;lisa.gabler@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Consumer Data Tech&apos; &#10;    or [sub_department]=&apos;Consumer Product&apos;&#10;    or [sub_department]=&apos;Logistics Product&apos;&#10;    or [sub_department]=&apos;Logistics Tech&apos; &#10;    or [sub_department]=&apos;Platform&apos; THEN   1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;zahra.khan@deliveryhero.com&apos;) THEN &#10;    IF [department]=&apos;DH International&apos; &#10;    or [department]=&apos;DH Oeconomicis&apos;&#10;    THEN   1 ELSE 0 END&#10;&#10;&#10;ELSEIF USERNAME()=(&apos;benjamin.mann@foodpanda.com&apos;) OR USERNAME()=(&apos;benjamin.mann@deliveryhero.com&apos;)&#10;&#10;THEN IF [c_level]=&apos;Benjamin Mann&apos; then 1 else 0 end &#10;&#10;&#10;//ANA&#10;ELSEIF  USERNAME()=(&ap