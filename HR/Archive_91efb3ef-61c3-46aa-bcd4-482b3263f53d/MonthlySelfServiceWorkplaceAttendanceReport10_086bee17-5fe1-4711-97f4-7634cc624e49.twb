      <column caption='user.name' datatype='string' name='[Calculation_5246552883045548035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([c_level_email],&quot;@deliveryhero.com&quot;,&quot;&quot;)' />
      </column>
      <column caption='min_4' datatype='boolean' name='[Calculation_582723623363223554]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if (COUNTD([employee_id]))&lt; 4 THEN FALSE ELSE TRUE END' />
      </column>
      <column aggregation='Sum' caption='exclude_current_week' datatype='integer' name='[Calculation_6781435926695510016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF WEEK([date])=WEEK(TODAY()) THEN 0 ELSE 1 END' />
      </column>
      <column caption='month_date' datatype='integer' name='[Calculation_6781435926810304517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MONTH([date])' />
      </column>
      <column caption='#_international_assignment_days' datatype='integer' name='[Calculation_6781435927110176774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF  NOT ISNULL ([remote_tag]) THEN [employee_id] END)' />
      </column>
      <column caption='Eligibility Criteria (old)' datatype='string' name='[Eligibility Criteria (copy)_242772209181077507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED WEEK([date]),YEAR([date]),[employee_id]:&#10;IF SUM([remote_work_days])&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days]+[public_holiday])&gt;4 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days]+[public_holiday])&gt;4 THEN &apos;Not Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=2 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([parent_dependent_less_one_year_old])&lt;&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([part_time_parental_leave])&lt;&gt;0 THEN &apos;Not Eligible&apos;&#10;&#10;ELSEIF SUM([time_off_days]+[public_holiday])&gt;1 AND SUM([time_off_days]+[public_holiday])&lt;5 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days]+[public_holiday])&gt;1 AND SUM([leave_days]+[public_holiday])&lt;5 THEN &apos;Half Eligible&apos;&#10;ELSE &apos;Eligible&apos;&#10;END&#10;}&#10;&#10;&#10;//Working week 4-5 days - 2 days office&#10;//Working week 3 or less than 3 days - 1 day office (2-4 days off)' />
      </column>
      <column aggregation='Sum' caption='User Filter - One Pager' datatype='integer' name='[User Filter - Overall Trends (copy)_5246552883015184386]' role='dimension' type='ordinal'>
