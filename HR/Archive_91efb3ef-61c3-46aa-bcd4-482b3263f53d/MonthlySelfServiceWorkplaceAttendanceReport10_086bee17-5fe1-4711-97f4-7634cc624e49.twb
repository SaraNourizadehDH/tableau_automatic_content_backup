      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1300' minheight='1300' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='1587' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98770' id='1586' param='vert' type-v2='layout-flow' w='98858' x='571' y='615'>
                <zone fixed-size='83' h='7308' id='1565' is-fixed='true' is-scaled='1' param='Image/Untitled design (11).png' type-v2='bitmap' w='7714' x='571' y='615'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
