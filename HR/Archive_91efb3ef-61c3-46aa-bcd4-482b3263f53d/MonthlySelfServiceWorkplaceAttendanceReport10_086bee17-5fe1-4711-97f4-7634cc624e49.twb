      <column caption='c_minus_1_viz' datatype='string' name='[Calculation_1485624981641027586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[C-1 (group)]+&apos; Team&apos;' />
      </column>
      <column caption='first_entrance&gt;11' datatype='integer' name='[Calculation_2325475945955893252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [event_date_time]) &gt; 12 THEN 1 ELSE 0 END' />
      </column>
      <column caption='% first_entrance&gt;11' datatype='real' name='[Calculation_2325475945957548037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2325475945955893252]) / COUNT([event_date_time])' />
      </column>
      <column caption='Work Shift' datatype='integer' name='[Calculation_242772209123770369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [work_shift]&#10;WHEN &apos;5 Day Work Shift (Germany)&apos; THEN 5&#10;WHEN &apos;4 Day Work Shift (Germany)&apos; THEN 4&#10;WHEN &apos;3 Day Work Shift (Germany)&apos; THEN 3&#10;WHEN &apos;2 Day Work Shift (Germany)&apos; THEN 2&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='parents_kid_1yo' datatype='boolean' name='[Calculation_2715318742951190528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[parent_dependent_less_one_year_old]&lt;&gt;0' />
      </column>
      <column caption='before_6_months' datatype='boolean' name='[Calculation_412290527417159681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], TODAY()) &gt; 6' />
      </column>
      <column caption='Last Day of Work vs Date' datatype='boolean' name='[Calculation_412783115741442048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;,[date]) = DATETRUNC(&apos;week&apos;,[last_day_of_work]) THEN FALSE ELSE TRUE END&#10;&#10;//if the last day of the employee is on the same week, we exclude' />
      </column>
      <column caption='exception_cases' datatype='integer' name='[Calculation_4326200027863363585]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [workplace_attendance]=0 AND [date] = DATE(&apos;2024-09-24&apos;) AND [employee_id] IN (&#10;    &apos;2022-03-0049&apos;, &apos;2022-02-0757&apos;, &apos;2019-03-0204&apos;, &apos;2021-07-0949&apos;,&#10;    &apos;2017-07-0003&apos;, &apos;2020-11-2622&apos;, &apos;2020-01-0186&apos;, &apos;2020-10-0067&apos;,&#10;    &apos;2022-04-0127&apos;, &apos;2019-08-0039&apos;, &apos;2024-04-0178&apos;, &apos;2019-10-0042&apos;,&#10;    &apos;2021-11-0128&apos;, &apos;2024-03-0435&apos;, &apos;2020-02-0178&apos;, &apos;2018-10-0015&apos;,&#10;    &apos;2020-07-0306&apos;, &apos;2020-07-0337&apos;, &apos;2020-04-0055&apos;, &apos;2024-03-0474&apos;,&#10;    &apos;2020-08-0043&apos;, &apos;2021-09-1031&apos;, &apos;2020-10-0344&apos;, &apos;2021-09-0223&apos;,&#10;    &apos;2022-02-0807&apos;, &apos;2021-08-0668&apos;, &apos;2021-08-0879&apos;, &apos;2015-06-0009&apos;,&#10;    &apos;2019-04-0088&apos;, &apos;2019-10-0078&apos;, &apos;2022-11-0358&apos;, &apos;2017-08-0012&apos;,&#10;    &apos;2021-09-0625&apos;&#10;) THEN 1&#10;ELSEIF [workplace_attendance]=0 AND [date] = DATE(&apos;2024-12-05&apos;) AND [employee_id] IN (&#10;    &apos;2021-10-0455&apos;, &apos;2021-05-0583&apos;, &apos;2021-08-0798&apos;, &apos;2021-07-0949&apos;,&#10;    &apos;2020-04-0192&apos;, &apos;2017-07-0003&apos;, &apos;2022-09-2239&apos;, &apos;2018-03-0004&apos;,&#10;    &apos;2019-08-0039&apos;, &apos;2022-07-0552&apos;, &apos;2019-12-3691&apos;, &apos;2019-06-0043&apos;,&#10;    &apos;2021-12-0500&apos;, &apos;2021-10-0458&apos;, &apos;2020-02-0178&apos;, &apos;2019-05-0054&apos;,&#10;    &apos;2020-07-0306&apos;, &apos;2022-04-1318&apos;, &apos;2020-07-0337&apos;, &apos;2021-07-1014&apos;,&#10;    &apos;2024-10-0823&apos;, &apos;2023-11-0648&apos;, &apos;2022-04-0695&apos;, &apos;2021-09-1031&apos;,&#10;    &apos;2021-02-0134&apos;, &apos;2021-08-0668&apos;&#10;) THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column aggregation='Sum' caption='User Filter - Overall Trends' datatype='integer' name='[Calculation_5246552883014684673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISMEMBEROF(&apos;C-Level&apos;) THEN 1&#10;ELSEIF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;natalia.cosa@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;rui.tavares@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;rui.belchior@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;melody.dowling@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;ole.helliesen@deliveryhero.com&apos;) THEN 1&#10;ELSEIF USERNAME()=(&apos;ana.mitrasevic@deliveryhero.com&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN &#10;    IF [c_level] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [c_level] &lt;&gt; &apos;Jeri Lynne Doris&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;&#10;ELSEIF USERNAME()=(&apos;berrin.altinok@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Vendor Product&apos; &#10;    or [sub_department]=&apos;Vendor Tech&apos;&#10;    or [sub_department]=&apos;Q-Commerce&apos; THEN  1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;lisa.gabler@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Consumer Data Tech&apos; &#10;    or [sub_department]=&apos;Consumer Product&apos;&#10;    or [sub_department]=&apos;Logistics Product&apos;&#10;    or [sub_department]=&apos;Logistics Tech&apos; &#10;    or [sub_department]=&apos;Platform&apos; THEN   1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;zahra.khan@deliveryhero.com&apos;) THEN &#10;    IF [department]=&apos;DH International&apos; &#10;    or [department]=&apos;DH Oeconomicis&apos;&#10;    THEN   1 ELSE 0 END&#10;&#10;&#10;//ANA&#10;ELSEIF  USERNAME()=(&apos;gladys.wojda@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ana Mitrasevic&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;rob.green@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ana Mitr