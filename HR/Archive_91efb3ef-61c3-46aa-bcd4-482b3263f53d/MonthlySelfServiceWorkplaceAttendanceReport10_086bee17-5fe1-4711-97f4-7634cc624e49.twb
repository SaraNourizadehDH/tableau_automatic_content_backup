      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4ED569305B854B3CA5FD8EB0C632D623'>
            <properties context=''>
              <relation connection='athena.0wfwfwf1hs57j01dzf2gf04orhc0' name='Custom SQL Query' type='text'><![CDATA[WITH calendar_prep AS (						
	SELECT					
		DATE(substr(cast(t.date as varchar),1,10)) as date,				
		WEEK(t.date) AS calendar_week,				
		DATE_TRUNC('month', DATE(t.date)) AS date_month,				
		CASE				
			WHEN day_of_week(DATE(t.date)) IN (6, 7) THEN 'Weekend'			
			ELSE 'Weekday'			
		END AS day_type,				
		CASE				
			WHEN day_of_week(DATE(t.date)) = 5 THEN 'Friday'			
			WHEN day_of_week(DATE(t.date)) = 6 THEN 'Saturday'			
			WHEN day_of_week(DATE(t.date)) = 7 THEN 'Sunday'			
			WHEN day_of_week(DATE(t.date)) = 1 THEN 'Monday'			
			WHEN day_of_week(DATE(t.date)) = 2 THEN 'Tuesday'			
			WHEN day_of_week(DATE(t.date)) = 3 THEN 'Wednesday'			
			WHEN day_of_week(DATE(t.date)) = 4 THEN 'Thursday'			
		END AS day_of_week,				
		day_of_week(DATE(t.date)) AS number_day_week,
		CASE
			WHEN day_of_week(DATE(t.date)) NOT IN (6, 7) AND hc.date IS NOT NULL THEN 1 ELSE 0
		END AS public_holiday
		
	FROM (					
		VALUES(SEQUENCE(DATE('2023-01-01'), DATE_ADD('year', 1, CURRENT_DATE), INTERVAL '1' DAY))) AS t(date_array)				
	CROSS JOIN					
		UNNEST(date_array) AS t(date)
	LEFT JOIN people_ops_proposed.il_holiday_calendar hc
		ON DATE(substr(cast(t.date as varchar),1,10)) = DATE(hc.date)
),
c_level_emails as (
select
m.manager_02_full_name,
m.manager_id_02,
wo.work_email 
from people_ops_proposed.il_manager m
left join people_ops_proposed.il_worker_org wo
	on m.manager_id_02 = wo.employee_id 
where wo.is_terminated = 0	
group by 1,2,3
),
c_mins_1_emails as (
select
m.manager_03_full_name,
m.manager_id_03,
wo.work_email 
from people_ops_proposed.il_manager m
left join people_ops_proposed.il_worker_org wo
	on m.manager_id_03 = wo.employee_id 
where wo.is_terminated = 0	
group by 1,2,3
),
c_mins_2_emails as (
select
m.manager_04_full_name,
m.manager_id_04,
wo.work_email 
from people_ops_proposed.il_manager m
left join people_ops_proposed.il_worker_org wo
	on m.manager_id_04 = wo.employee_id 
where wo.is_terminated = 0	
group by 1,2,3
),				
employees_per_month_prep AS (						
	SELECT					
		DATE_TRUNC('month', DATE(wh.report_effective_date)) AS date_month,				
		wh.company_id,				
		wh.employee_id,	
		wh.is_terminated,
		concat(wp.first_name,' ',wp.last_name) as full_name,
		wo.work_email,
		DATE(wh.first_day_of_work) AS first_day_of_work,				
		DATE(wh.last_day_of_work) AS last_day_of_work,				
		wh.management_level,
		wh.time_type,
		wh.work_shift,
		wh.job_family,				
		wh.job_family_group,				
		wp.gender,				
		cha.sub_department,				
		cha.department,		
		wh.office_location,
		sh.tenure_category,
		wh.remote_tag,
		mh.manager_02_full_name AS c_level,	
		cle.work_email as c_level_email,
		m.manager_03_full_name AS c_minus_1,
		c_1.work_email as c_minus_1_email,
		m.manager_04_full_name AS c_minus_2,
		c_2.work_email as c_minus_2_email,
		m.managed_by_full_name,
		m.managed_by_work_email,
		wra.hr_analyst
	FROM					
		people_ops_proposed.il_worker_hist_with_current wh				
	LEFT JOIN					
		people_ops_proposed.il_manager_hist_with_current mh				
		ON wh.report_effective_date = mh.report_effective_date				
		AND wh.employee_id = mh.employee_id		
	LEFT JOIN					
		people_ops_proposed.il_salary_hist_with_current sh				
		ON wh.report_effective_date = sh.report_effective_date				
		AND wh.employee_id = sh.employee_id				
	LEFT JOIN					
		people_ops_proposed.il_cc_hierarchy_all cha				
		ON wh.cost_center_id = cha.cost_center_id				
	LEFT JOIN					
		people_ops_proposed.il_worker_personal wp				
		ON wh.employee_id = wp.employee_id	
	LEFT JOIN					
		people_ops_proposed.il_manager m				
		ON wh.employee_id = m.employee_id	
	LEFT JOIN					
		people_ops_proposed.il_worker_org wo			
		ON wh.employee_id = wo.employee_id	
	LEFT JOIN c_level_emails cle
		ON m.manager_id_02 = cle.manager_id_02
	LEFT JOIN c_mins_1_emails c_1
		ON m.manager_id_03 = c_1.manager_id_03	
	LEFT JOIN c_mins_2_emails c_2
		ON m.manager_id_04 = c_2.manager_id_04
	LEFT JOIN people_ops_proposed.il_worker_role_assignment wra
		ON wra.employee_id = wh.employee_id 
	WHERE					
		wh.is_terminated = 0								
		AND wh.worker_type = 'Employee'
		AND wh.contract_type NOT IN ('Working Student - Permanent (Trainee)', 'Working Student (Fixed Term) (Trainee)', 'Intern (Fixed Term) (Trainee)')
		AND CAST(wh.report_effective_date AS DATE) >> DATE('2022-12-31')				
		AND cha.sub_department NOT LIKE 'EU Regional%'		
		AND (wh.office_location LIKE 'Berlin%'
		OR wh.employee_id IN (
'2022-11-0078',
'2022-03-0288',
'2021-01-0083',
'2022-04-0597',
'2017-02-0002',
'2021-11-0944',
'2021-10-0840',
'2022-08-0708',
'2023-06-0553',
'2019-04-0065',
'2021-09-1206',
'2022-12-0239',
'2019-12-0009',
