            <column aggregation='Sum' caption='User Filter - List Employees' datatype='integer' name='[User Filter - Overall Trends (copy)_5533375884319526913]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;natalia.cosa@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;rui.tavares@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;rui.belchior@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;melody.dowling@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;ana.mitrasevic@deliveryhero.com&apos;) THEN 1&#10;ELSEIF USERNAME()=(&apos;zahra.khan@deliveryhero.com&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN &#10;    IF [c_level] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [c_level] &lt;&gt; &apos;Jeri Lynne Doris&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;berrin.altinok@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Vendor Product&apos; &#10;    OR [sub_department]=&apos;Vendor Tech&apos;&#10;    OR [sub_department]=&apos;Q-Commerce&apos; THEN  1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=(&apos;lisa.gabler@deliveryhero.com&apos;) THEN &#10;    IF [sub_department]=&apos;Consumer Data Tech&apos; &#10;    OR [sub_department]=&apos;Consumer Product&apos;&#10;    OR [sub_department]=&apos;Logistics Product&apos;&#10;    OR [sub_department]=&apos;Logistics Tech&apos; &#10;    OR [sub_department]=&apos;Platform&apos;&#10;    OR [sub_department]=&apos;Platform &apos; THEN   1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=[Calculation_5246552883045548035] OR USERNAME()=[c_level_email]&#10; THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;benjamin.mann@foodpanda.com&apos;) OR USERNAME()=(&apos;benjamin.mann@deliveryhero.com&apos;)&#10;&#10;THEN IF [c_level]=&apos;Benjamin Mann&apos; then 1 else 0 end &#10;&#10;ELSEIF USERNAME()=(&apos;laura.diaconescu@deliveryhero.com&apos;)&#10;&#10;THEN IF [c_level]=&apos;Emmanuel Thomassin&apos; then 1 else 0 end &#10;&#10;ELSEIF USERNAME()=[user.name (copy)_5811402792817635328] OR USERNAME()=[c_minus_1_email] then 1&#10;&#10;//EXECUTIVE ASSISTANTS&#10;&#10;ELSEIF  USERNAME()=(&apos;berit.geiler@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;PJ Vandepitte&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;bianca.balen@deliveryhero.com&apos;) THEN &#10;IF [managed_by_full_name]=&apos;Niklas Östberg&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;madalena.vieira@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Benjamin Mann&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;monica.ivancea@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Ana Mitrasevic&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;esther.molitor@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Emmanuel Thomassin&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;anwesha.roy@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Emmanuel Thomassin&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF  USERNAME()=(&apos;anna.slater@deliveryhero.com&apos;) THEN &#10;IF [c_level]=&apos;Johannes Bruder&apos; THEN 1 ELSE 0 END&#10;&#10;&#10;END' />
            </column>
