                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#131732' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7335' id='10' type-v2='text' w='90858' x='8571' y='615'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='15'>Workplace Attendance Policy Summary</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#131732' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6923' id='881' type-v2='text' w='46227' x='3773' y='10385'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#3400ff' fontname='Tableau Semibold' fontsize='12'>What is the critera used to measure Workplace Attendance in the Dashboard? </run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='10'>Population out of scope:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='3692' id='1174' type-v2='text' w='43926' x='52286' y='10385'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#3400ff' fontname='Tableau Semibold' fontsize='12'>Important links to have in mind: </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='5538' id='1181' type-v2='text' w='43926' x='52286' y='14077'>
                  <formatted-text>
                    <run bold='true' fontcolor='#2cd76c' fontsize='11'>Access the Workplace Policy</run>
                    <run fontcolor='#2cd76c' fontsize='11'>Æ </run>
                    <run fontsize='11'>to clarify any doubts you might have.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9538' id='1158' type-v2='text' w='43929' x='6071' y='17308'>
                  <formatted-text>
                    <run fontcolor='#1d1c1d' fontname='Tableau Light' italic='true'>These employees are not included in the dashboard to best reflect the latest updates of the DHSE Workplace Policy 2.0, see the link to the policy on the right</run>
                    <run>Æ&#10;</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Tableau Light' lmargin='420'>Employees with a tenure of </run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' lmargin='420'>less than 6 months</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Tableau Light' lmargin='420'>Employees with a contract of domestic (Germany) - </run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' lmargin='420'>remote working</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='144' h='11693' id='1208' is-centered='0' is-fixed='true' is-scaled='1' param='Image/2.png' type-v2='bitmap' url='https://drive.google.com/file/d/1vSY3DYj-vL3M_jG8I20GwHsUHuCq51xR/view?pli=1' w='19500' x='64857' y='19615'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2462' id='1159' type-v2='text' w='46227' x='3773' y='26846'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='10'>Exceptions Contemplated in the Dashboard:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='34000' id='1162' type-v2='text' w='43929' x='6071' y='29308'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'> - Remote Working</run>
                    <run fontcolor='#000000'>: Employees with an approved remote working request or those on a formal international assignment under the company’s Remote Working Program are not expected to attend the office. This data is taken from the GoRemote system.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'> - Working Days Attendance Requirements</run>
                    <run fontcolor='#000000'>: Office attendance expectations are based on the number of working days within a standard workweek (Monday to Friday):</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>   -&gt; For employees working all five days in a week, the expected office attendance is at least </run>
                    <run bold='true' fontcolor='#000000'>two days</run>
                    <run fontcolor='#000000'>, consistent with the policy.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>   -&gt; For employees working fewer than five days in a week due to part-time work, illness, vacation, bank holiday, or any other type of absence:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>          - 4-5 days working week</run>
                    <run fontcolor='#000000'>: At least </run>
                    <run bold='true' fontcolor='#000000'>two days</run>
                    <run fontcolor='#000000'> workplace attendance.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>          - 3 or fewer days working week</run>
                    <run fontcolor='#000000'>: At least </run>
                    <run bold='true' fontcolor='#000000'>one day</run>
                    <run fontcolor='#000000'> workplace attendance.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>- Business Travel:</run>
                    <run fontcolor='#000000'> The days worked abroad during business travel count as office days. This data is taken from CWT system.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>- International Assignments:</run>
                    <run fontcolor='#000000'> When the employee is working in an international assignment 2 or more days during that week, it is not expected to go to the office.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>- Parents with Dependents (Less One Year Old):</run>
                    <run fontcolor='#000000'> When the employee has a child that is less than 12 months old, the workplace policy does not apply, hence the employee is not expected / required to go to the office during those 12 months. This data is taken from Workday.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8307' id='1179' type-v2='text' w='43926' x='52286' y='31308'>
                  <formatted-text>
                    <run fontsize='11'>Learn how to </run>
                    <run bold='true' fontcolor='#2cd76c' fontsize='11'>download</run>
                    <run fontsize='11'> data from the Dashboard and how to set up your subscriptions to </run>
                    <run bold='true' fontcolor='#2cd76c' fontsize='11'>get automated updates:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='33077' id='1213' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Screen Shot 2024-02-14 at 16.53.06.png' type-v2='bitmap' url='https://drive.google.com/file/d/1hLx0yQISF02eI4tRr1c-Yxboi0f8Uo7J/view?usp=sharing' w='15428' x='66643' y='39615'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='2538' id='1164' type-v2='text' w='46227' x='3773' y='63308'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#3400ff' fontname='Tableau Semibold' fontsize='12'>Workplace Attendance Expectations:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='20846' id='1165' type-v2='text' w='46227' x='3773' y='65846'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Above Expectations</run>
                    <run fontcolor='#000000'>:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 4-5 days working week</run>
                    <run fontcolor='#000000'>: When the employee attends the office </run>
                    <run bold='true' fontcolor='#000000'>more than 2 days</run>
                    <run fontcolor='#000000'> during the week.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 3 or fewer days working week</run>
                    <run fontcolor='#000000'>: When the employee attends the office </run>
                    <run bold='true' fontcolor='#000000'>more than</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run bold='true' fontcolor='#000000'>1 day </run>
                    <run fontcolor='#000000'>during the week.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#72b966'>Meets Expectations</run>
                    <run fontcolor='#72b966'>:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 4-5 days working week</run>
                    <run fontcolor='#000000'>: When the employee attends the office</run>
                    <run bold='true' fontcolor='#000000'> exactly 2 days</run>
                    <run fontcolor='#000000'> during the week.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 3 or fewer days working week</run>
                    <run fontcolor='#000000'>: When the employee attends the office </run>
                    <run bold='true' fontcolor='#000000'>exactly</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run bold='true' fontcolor='#000000'>1 day </run>
                    <run fontcolor='#000000'>during the week.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#e15759'>Below Expectations</run>
                    <run fontcolor='#e15759'>:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 4-5 days working week</run>
                    <run fontcolor='#000000'>: When the employee attends the office </run>
                    <run bold='true' fontcolor='#000000'>fewer than 2 days</run>
                    <run fontcolor='#000000'> during the week.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>   -&gt; 3 or fewer days working week</run>
                    <run fontcolor='#000000'>: When the employee does </run>
                    <run bold='true' fontcolor='#000000'>not attend </run>
                    <run fontcolor='#000000'>the office during the week.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' italic='true'>*Attendance is measured by our badging system and it takes into consideration Visitor Cards.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='10231' id='24' type-v2='text' w='92439' x='3773' y='89154'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#444746' fontname='Tableau Light' fontsize='8'>If you have any questions about the Policy please raise a ticket here: </run>
                    <run fontalignment='1' fontcolor='#4996b2' fontname='Tableau Light' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://jira.deliveryhero.com/plugins/servlet/desk/portal/3&amp;quot;'>https://jira.deliveryhero.com/plugins/servlet/desk/portal/3</run>
                    <run fontalignment='1' fontcolor='#444746' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#444746' fontname='Tableau Light' fontsize='8'>If you have any questions about the functionalities of the dashboard please raise a ticket here: </run>
                    <run fontalignment='1' fontcolor='#4996b2' fontname='Tableau Light' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://jira.deliveryhero.com/plugins/servlet/desk/portal/53&amp;quot;'>https://jira.deliveryhero.com/plugins/servlet/desk/portal/53</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>Documentation of the dashboard can be found here: </run>
                    <run fontalignment='1' fontcolor='#4996b2' fontname='Tableau Light' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/DHPANA/Workplace+Attendance+Report&amp;quot;'>https://confluence.deliveryhero.com/display/DHPANA/Workplace+Attendance+Report</run>
                  </formatted-text>
