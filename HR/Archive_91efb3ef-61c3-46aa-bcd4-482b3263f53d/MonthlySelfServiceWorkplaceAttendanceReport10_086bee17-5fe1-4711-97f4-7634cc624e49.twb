      <table>
        <view>
          <datasources>
            <datasource caption='workplace_attendance_tracker_pl_table' name='federated.11etfhc079e88817d6t6m05wdxel' />
          </datasources>
          <datasource-dependencies datasource='federated.11etfhc079e88817d6t6m05wdxel'>
            <column caption='final_workplace_attendance' datatype='integer' name='[Calculation_1468032789230694402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[workplace_attendance]+[business_travel_days]+[Calculation_4326200027863363585]' />
            </column>
            <column caption='workplace_attendance_week/employee' datatype='integer' name='[Calculation_1468032789230874627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [calendar_week],[employee_id],year([date]):&#10;sum([Calculation_1468032789230694402])}' />
            </column>
            <column caption='workplace_attendance_expectations' datatype='string' name='[Calculation_1468032789232963588]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1468032791011397668]= &apos;Not Eligible&apos; THEN &apos;Not Eligible&apos; &#10;&#10;ELSEIF [Calculation_1485624981284057088]=0 THEN &apos;Not Eligible&apos; &#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;) &#10;AND [Calculation_1468032789230874627] &lt;  1 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;)&#10;AND [Calculation_1468032789230874627] = 1 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;)&#10;AND [Calculation_1468032789230874627] &gt; 1 THEN &apos;Above Expectations&apos;&#10;&#10;///////&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] &lt; 2 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] = 2 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] &gt; 2 THEN &apos;Above Expectations&apos;&#10;&#10;/////&#10;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] &lt;1 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] = 1 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] &gt; 1 THEN &apos;Above Expectations&apos;&#10;&#10;END' />
            </column>
            <column caption='previous_week (complete)' datatype='boolean' name='[Calculation_1468032789263081485]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [date], TODAY()) = 1' />
            </column>
            <column caption='Eligibility Criteria' datatype='string' name='[Calculation_1468032791011397668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED WEEK([date]),YEAR([date]),[employee_id]:&#10;IF SUM([remote_work_days])&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([parent_dependent_less_one_year_old])&lt;&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([part_time_parental_leave])&lt;&gt;0 THEN &apos;Not Eligible&apos;&#10;&#10;//5 days work shift &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days]+[public_holiday])&gt;4 AND MIN([Calculation_242772209123770369]) = 5 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days]+[public_holiday])&gt;4 AND MIN([Calculation_242772209123770369]) = 5 THEN &apos;Not Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=2 AND MIN([Calculation_242772209123770369]) = 5 THEN &apos;Not Eligible&apos;&#10;&#10;//4 days work shift &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days])&gt;3 AND MIN([Calculation_242772209123770369]) = 4 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days])&gt;3 AND MIN([Calculation_242772209123770369]) = 4 THEN &apos;Not Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=2 AND MIN([Calculation_242772209123770369]) = 4 THEN &apos;Not Eligible&apos;&#10;&#10;//3 days work shift &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days])&gt;2 AND MIN([Calculation_242772209123770369]) = 3 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days])&gt;2 AND MIN([Calculation_242772209123770369]) = 3 THEN &apos;Not Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=1 AND MIN([Calculation_242772209123770369]) = 3 THEN &apos;Not Eligible&apos;&#10;&#10;//2 days work shift &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days])&gt;1 AND MIN([Calculation_242772209123770369]) = 2 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days])&gt;1 AND MIN([Calculation_242772209123770369]) = 2 THEN &apos;Not Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=1 AND MIN([Calculation_242772209123770369]) = 2 THEN &apos;Not Eligible&apos;&#10;&#10;//5 days work shift &apos;Half Eligible&apos;&#10;ELSEIF SUM([time_off_days]+[public_holiday])&gt;1 AND SUM([time_off_days]+[public_holiday])&lt;5 AND MIN([Calculation_242772209123770369]) = 5 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days]+[public_holiday])&gt;1 AND SUM([leave_days]+[public_holiday])&lt;5 AND MIN([Calculation_242772209123770369]) = 5 THEN &apos;Half Eligible&apos;&#10;&#10;//4 days work shift &apos;Half Eligible&apos;&#10;ELSEIF SUM([time_off_days])&gt;=1 AND SUM([time_off_days])&lt;4 AND MIN([Calculation_242772209123770369]) = 4 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days])&gt;=1 AND SUM([leave_days])&lt;4 AND MIN([Calculation_242772209123770369]) = 4 THEN &apos;Half Eligible&apos;&#10;&#10;//3 days work shift &apos;Half Eligible&apos;&#10;ELSEIF SUM([time_off_days])&lt;3 AND MIN([Calculation_242772209123770369]) = 3 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days])&lt;3 AND MIN([Calculation_242772209123770369]) = 3 THEN &apos;Half Eligible&apos;&#10;&#10;//2 days work shift &apos;Half Eligible&apos;&#10;ELSEIF SUM([time_off_days])&lt;2 AND MIN([Calculation_242772209123770369]) = 2 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days])&lt;2 AND MIN([Calculation_242772209123770369]) = 2 THEN &apos;Half Eligible&apos;&#10;&#10;ELSE &apos;Eligible&apos;&#10;END&#10;}&#10;&#10;&#10;//Working week 4-5 days - 2 days office&#10;//Working week 3 or less than 3 days - 1 day office (2-4 days off)' />
            </column>
            <column aggregation='Sum' caption='Exceptions' datatype='integer' name='[Calculation_1485624981284057088]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date]&gt;=DATE(&apos;2023-12-31&apos;) and [date]&lt;=DATE(&apos;2024-02-18&apos;) and [employee_id]=&apos;2019-10-0075&apos; then 0 &#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-04&apos;) and [date]&lt;=DATE(&apos;2024-02-11&apos;) and [employee_id]=&apos;2021-07-0654&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-01-28&apos;) and [date]&lt;=DATE(&apos;2024-03-03&apos;) and [employee_id]=&apos;2021-12-0173&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-01-28&apos;) and [date]&lt;=DATE(&apos;2024-03-31&apos;) and [employee_id]=&apos;2022-02-0299&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2023-12-31&apos;) and [date]&lt;=DATE(&apos;2024-03-31&apos;) and [employee_id]=&apos;2021-08-0497&apos; then 0&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-05&apos;) and [date]&lt;=DATE(&apos;2024-03-05&apos;) and [employee_id]=&apos;2022-08-0562&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-19&apos;) and [date]&lt;=DATE(&apos;2024-03-05&apos;) and [employee_id]=&apos;2022-04-0782&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-21&apos;) and [date]&lt;=DATE(&apos;2025-02-20&apos;) and [employee_id]=&apos;2019-11-0062&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-22&apos;) and [date]&lt;=DATE(&apos;2024-04-21&apos;) and [employee_id]=&apos;2022-10-0320&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-20&apos;) and [date]&lt;=DATE(&apos;2024-03-13&apos;) and [employee_id]=&apos;2021-07-0553&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-18&apos;) and [date]&lt;=DATE(&apos;2024-03-01&apos;) and [employee_id]=&apos;2018-02-0006&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-26&apos;) and [date]&lt;=DATE(&apos;2024-03-11&apos;) and [employee_id]=&apos;2020-05-0091&apos; then 0&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-03-04&apos;) and [date]&lt;=DATE(&apos;2024-04-15&apos;) and [employee_id]=&apos;2022-08-0562&apos; then 0&#10;ELSEIF [date]&gt;=DATE(&apos;2024-03-11&apos;) and [date