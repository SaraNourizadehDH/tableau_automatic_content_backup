            <column caption='Work Shift' datatype='integer' name='[Calculation_242772209123770369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [work_shift]&#10;WHEN &apos;5 Day Work Shift (Germany)&apos; THEN 5&#10;WHEN &apos;4 Day Work Shift (Germany)&apos; THEN 4&#10;WHEN &apos;3 Day Work Shift (Germany)&apos; THEN 3&#10;WHEN &apos;2 Day Work Shift (Germany)&apos; THEN 2&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='parents_kid_1yo' datatype='boolean' name='[Calculation_2715318742951190528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[parent_dependent_less_one_year_old]&lt;&gt;0' />
            </column>
            <column caption='exception_cases' datatype='integer' name='[Calculation_4326200027863363585]' role='dimension' type='ordinal'>
