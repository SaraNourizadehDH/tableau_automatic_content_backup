          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Latest TS' datatype='real' default-format='n#,##0;-#,##0' name='[Latest NPS (copy)_7012175049955942428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))} THEN [avg_ts] END) }' />
            </column>
            <column caption='TS change (+)' datatype='real' default-format='p0.0%' name='[NPS change (+) (copy)_7012175049955942432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest NPS (copy)_7012175049955942428] &gt; [Previous NPS (copy)_7012175049955942430] THEN&#10;([Latest NPS (copy)_7012175049955942428]-[Previous NPS (copy)_7012175049955942430])/[Previous NPS (copy)_7012175049955942430]&#10;END)' />
            </column>
