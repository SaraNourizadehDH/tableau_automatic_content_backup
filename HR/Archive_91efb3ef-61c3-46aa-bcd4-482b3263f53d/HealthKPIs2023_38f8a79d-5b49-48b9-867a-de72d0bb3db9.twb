            <column caption='Previous AR' datatype='real' name='[Previous NPS (copy)_7012175049950961688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-1 THEN [acceptance_rate] END) }' />
