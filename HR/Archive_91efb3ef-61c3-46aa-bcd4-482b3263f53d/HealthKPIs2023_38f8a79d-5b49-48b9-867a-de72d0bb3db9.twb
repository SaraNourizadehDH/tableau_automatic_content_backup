          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Latest AR' datatype='real' default-format='n#,##0;-#,##0' name='[Latest NPS (copy)_7012175049950814231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))} THEN [acceptance_rate] END) }' />
            </column>
            <column caption='Change AR (+) ' datatype='real' default-format='p0.0%' name='[NPS change (+) (copy)_7012175049953116187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest NPS (copy)_7012175049950814231] &gt; [Previous NPS (copy)_7012175049950961688] THEN&#10;([Latest NPS (copy)_7012175049950814231]-[Previous NPS (copy)_7012175049950961688])/[Previous NPS (copy)_7012175049950961688]&#10;END)' />
