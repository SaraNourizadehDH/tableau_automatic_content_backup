            <column caption='GP PC change (+) ' datatype='real' default-format='p0.0%' name='[GP DH change (+) (copy)_7012175049972830254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest GP DH (copy)_7012175049972830253] &gt; [Previous GP DH (copy)_7012175049972830257] THEN&#10;([Latest GP DH (copy)_7012175049972830253]-[Previous GP DH (copy)_7012175049972830257])&#10;END)' />
