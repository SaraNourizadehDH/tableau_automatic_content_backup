              <calculation class='tableau' formula='zn(IF [Latest NPS (copy)_7012175049955942428] &lt; [Previous NPS (copy)_7012175049955942430] THEN&#10;([Latest NPS (copy)_7012175049955942428]-[Previous NPS (copy)_7012175049955942430])/[Previous NPS (copy)_7012175049955942430]&#10;END)' />
            </column>
            <column caption='TS change' datatype='real' default-format='p0.0%' name='[NPS change (copy)_7012175049955942429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest NPS (copy)_7012175049955942428]-[Previous NPS (copy)_7012175049955942430])/[Previous NPS (copy)_7012175049955942430]' />
            </column>
            <column caption='Previous TS' datatype='real' name='[Previous NPS (copy)_7012175049955942430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-1 THEN [avg_ts] END) }' />
