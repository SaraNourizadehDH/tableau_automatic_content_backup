  <windows source-height='30'>
    <window class='dashboard' maximized='true' name='1 - Total Compensation'>
      <viewpoints>
        <viewpoint name='Last updated' />
        <viewpoint name='TC CR current'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='TC CR forecast'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='TC Summary curr'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='TC summary fore'>
          <zoom type='entire-view' />
