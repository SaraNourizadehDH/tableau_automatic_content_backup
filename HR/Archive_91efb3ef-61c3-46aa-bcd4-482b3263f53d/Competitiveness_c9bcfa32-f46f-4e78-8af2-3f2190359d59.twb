            <column caption='Pay Mix forecast' datatype='real' name='[Pay Mix (copy)_417216322163466279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1)) = 0&#10;AND [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &lt; 0.85&#10;AND [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = FALSE&#10;THEN [CR forecast (copy)_417216322163204134]&#10;ELSE (&#10;    IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt;= 0.5 AND [current_salary_annualized]/[mid_salary_range] &lt; [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]&#10;    THEN (&#10;        IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = TRUE AND ZN([granted_amount]) &lt; ZN([LTIP CR forecast (copy)_2816227553956163587])&#10;        THEN &#10;            [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]/&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;            ZN([LTIP CR forecast (copy)_2816227553956163587]))&#10;        ELSE &#10;            [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]/&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;            ZN([granted_amount]))&#10;        END)&#10;    ELSE (&#10;        IF [is_tech] = 1 THEN&#10;            [CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)/&#10;            ([CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)+&#10;            [LTIP CR (copy)_2944720873037512714]*ZN([LTIP CR forecast (copy)_2816227553956163587])*(1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100))&#10;        ELSEIF [is_tech] = 0 THEN &#10;            [CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)/&#10;            ([CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)+&#10;            [LTIP CR (copy)_2944720873037512714]*ZN([LTIP CR forecast (copy)_2816227553956163587])*(1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100))&#10;        ELSE&#10;            [current_salary_annualized]/(ZN([granted_amount])+[current_salary_annualized])&#10;        END)&#10;    END)&#10;END' />
            </column>
