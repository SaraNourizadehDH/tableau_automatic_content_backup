      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Current and Forecasted Base Salary Comp-Ratio Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Bring all Salaries to a minimum CR of' datatype='real' datatype-customized='true' name='[LTIP Bring All to Target (copy)_5656943389791903759]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range max='1.0' min='0.5' />
            </column>
            <column caption='Midpoint Increase NonTech' datatype='string' datatype-customized='true' name='[Midpoint Increase Tech (copy)_6334735121656946691]' param-domain-type='list' role='measure' type='nominal' value='&quot;0 \%&quot;'>
              <calculation class='tableau' formula='&quot;0 %&quot;' />
            </column>
            <column caption='Salary Increase Tech' datatype='string' datatype-customized='true' name='[Midpoint Increase Tech (copy)_6334735121668395012]' param-domain-type='list' role='measure' type='nominal' value='&quot;0 \%&quot;'>
              <calculation class='tableau' formula='&quot;0 %&quot;' />
            </column>
            <column caption='Midpoint Increase Tech' datatype='string' datatype-customized='true' name='[Midpoint Increase Tech Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;0 \%&quot;'>
              <calculation class='tableau' formula='&quot;0 %&quot;' />
