          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='CR forecast' datatype='real' name='[CR (copy)_2944720873021825024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt; [current_salary_annualized]/[mid_salary_range]&#10;THEN [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]&#10;ELSE (&#10;&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range]) &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099])&#10;            THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSEIF [is_tech] = 0 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&lt;= FLOAT([Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186])&#10;            THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSE [current_salary_annualized]/[mid_salary_range]&#10;    END)&#10;END' />
            </column>
            <column caption='Pay Mix' datatype='real' name='[CR forecast (copy)_417216322163204134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[current_salary_annualized]/([current_salary_annualized]+[granted_amount])' />
            </column>
            <column caption='zero axis' datatype='integer' name='[Calculation_2944720873070489639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='LTI Target' datatype='integer' name='[Calculation_3338926570748366848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S2&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S3&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S4&apos; THEN 0&#10;&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=0 THEN 0&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=1 THEN 10000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=0 THEN 15000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=1 THEN 17500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=0 THEN 22500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=1 THEN 27500&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=0 THEN 35000&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=1 THEN 45000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=0 THEN 55000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=1 THEN 65000&#10;&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=0 THEN 20000&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=1 THEN 22500&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=0 THEN 30000&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=1 THEN 37500&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=0 THEN 45000&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=1 THEN 52500&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=0 THEN 80000&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=1 THEN 90000&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=0 THEN 112500&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=1 THEN 140000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=0 THEN 185000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=1 THEN 230000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=0 THEN 250000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=1 THEN 300000&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='CR bins' datatype='string' name='[Calculation_6445565893758619652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [current_salary_annualized]/[mid_salary_range] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
            </column>
            <column caption='LTIP CR forecast' datatype='real' name='[LTIP CR (copy)_2944720873037512714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352]&#10;THEN (&#10;    IF [granted_amount] &lt; [LTIP CR forecast (copy)_2816227553956163587]&#10;    THEN 1&#10;    ELSE [granted_amount]/ [LTIP CR forecast (copy)_2816227553956163587]&#10;    END)&#10;ELSE (&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;        ELSE (&#10;            IF [granted_amount]/[LTIP CR forecast (copy)_2816227553956163587] &lt;= FLOAT([Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862])&#10;            THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            ELSE [granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            END)&#10;        END)&#10;    ELSE (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;        ELSE (&#10;            IF [granted_amount]/[LTIP CR forecast (copy)_2816227553956163587] &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557])&#10;            THEN (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            ELSE [granted_amount]/((1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            END)&#10;        END)&#10;    END)&#10;END' />
            </column>
            <column caption='LTIP target modified' datatype='integer' name='[LTIP CR forecast (copy)_2816227553956163587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Bring All to Target (copy)_6450350980718161921] THEN&#13;&#10;    (IF [management_level] = &apos;IC1&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC1 NonTech (copy)_1167558249698631680]&#13;&#10;    ELSEIF [management_level] = &apos;IC1&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC3 (copy)_2816227553957830661 1]&#13;&#10;    ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC1 Tech (copy)_1167558249698701313]&#13;&#10;    ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC1 NonTech (copy)_1167558249698717698]&#13;&#10;    ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Bring All to Target (copy)_2816227553954451458]&#13;&#10;    ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC3 (copy)_2816227553957830661]&#13;&#10;    ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC3 Tech (copy)_2816227553958469638]&#13;&#10;    ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC4 Tech (copy)_2816227553958551559]&#13;&#10;    ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC4 Tech (copy)_2816227553958658056]&#13;&#10;    ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC5 Tech (copy)_2816227553958719497]&#13;&#10;    ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC5 Tech (copy)_2816227553958813706]&#13;&#10;    ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target IC6 Tech (copy)_1167558249698979843]&#13;&#10;    ELSEIF [management_level] = &apos;M1&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target IC6 Tech (copy)_2816227553958895627]&#13;&#10;    ELSEIF [management_level] = &apos;M1&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M1 Tech (copy)_2816227553958961164]&#13;&#10;    ELSEIF [management_level] = &apos;M2&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M1 Tech (copy)_2816227553959038989]&#13;&#10;    ELSEIF [management_level] = &apos;M2&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M2 Tech (copy)_2816227553959108622]&#13;&#10;    ELSEIF [management_level] = &apos;M3&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M3 NonTech (copy)_2816227553959227408]&#13;&#10;    ELSEIF [management_level] = &apos;M3&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M2 NonTech (copy)_2816227553959178255]&#13;&#10;    ELSEIF [management_level] = &apos;M4&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M4 NonTech (copy)_2816227553959350290]&#13;&#10;    ELSEIF [management_level] = &apos;M4&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M3 NonTech (copy)_2816227553959297041]&#13;&#10;    ELSEIF [management_level] = &apos;M5&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M4 NonTech (copy 2) (copy 2)_1167558249699147783]&#13;&#10;    ELSEIF [management_level] = &apos;M5&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M4 NonTech (copy 2)_1167558249699106821]&#13;&#10;    ELSEIF [management_level] = &apos;M6&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M4 NonTech (copy)_1167558249699094532]&#13;&#10;    ELSEIF [management_level] = &apos;M6&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M4 NonTech (copy 2) (copy)_1167558249699119110]&#13;&#10;    ELSEIF [management_level] = &apos;E1&apos; AND [is_tech] = 1 THEN [Parameters].[LTIP Target M5 Tech (copy)_1167558249699504137]&#13;&#10;    ELSEIF [management_level] = &apos;E1&apos; AND [is_tech] = 0 THEN [Parameters].[LTIP Target M6 NonTech (copy)_1167558249699487752]&#13;&#10;    END)&#13;&#10;ELSE [Calculation_3338926570748366848] END' />
