            <column caption='CR forecast' datatype='real' name='[CR (copy)_2944720873021825024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt; [current_salary_annualized]/[mid_salary_range]&#10;THEN [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]&#10;ELSE (&#10;&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range]) &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099])&#10;            THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSEIF [is_tech] = 0 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&lt;= FLOAT([Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186])&#10;            THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSE [current_salary_annualized]/[mid_salary_range]&#10;    END)&#10;END' />
            </column>
