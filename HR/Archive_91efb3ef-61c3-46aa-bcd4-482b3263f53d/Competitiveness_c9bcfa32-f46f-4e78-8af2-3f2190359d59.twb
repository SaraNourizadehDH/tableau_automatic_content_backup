      <column caption='Median Salary' datatype='real' hidden='true' name='[Median Female Salary (copy)_2861263539163189255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Female Employees (copy)_2861263539163430922]&gt;1 AND [Calculation_2788502241464504320]&gt;1 and [Male Salaries (copy)_2788502241464741889]&gt;1 THEN MEDIAN([Calculation_2084674062119718923]) ELSE NULL END' />
      </column>
      <column caption='Pay Bill forecast sum' datatype='real' name='[Pay Bill forecast (copy)_2944720873416732746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1)) = 0&#10;AND [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &lt; 0.85&#10;THEN SUM([current_salary_annualized])&#10;ELSE SUM([CR forecast (copy)_2944720873042624530])&#10;END' />
      </column>
      <column caption='LTIP spend forecast' datatype='real' name='[Pay Bill forecast (copy)_3292131375410327556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = TRUE AND [granted_amount] &lt; [LTI Target (copy)_417216322117582876]&#10;THEN [LTIP CR forecast (copy)_2816227553956163587]&#10;ELSE (&#10;&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF  [Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]&#10;        ELSE (&#10;            IF [granted_amount]/([LTI Target (copy)_417216322117582876]) &lt;= FLOAT([Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862])&#10;            THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]&#10;            ELSE [granted_amount]&#10;            END)&#10;        END)&#10;    ELSEIF [is_tech] = 0&#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*[granted_amount]&#10;        ELSE (&#10;            IF [granted_amount]/([LTI Target (copy)_417216322117582876]) &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557])&#10;            THEN (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*[granted_amount]&#10;            ELSE [granted_amount]&#10;            END)&#10;        END)&#10;    ELSE [granted_amount]&#10;    END)&#10;&#10;END' />
      </column>
      <column caption='ltip spend forecast sum' datatype='real' name='[Pay Bill forecast sum (copy)_3292131375411773445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1)) = 0&#10;AND [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = FALSE&#10;THEN SUM([granted_amount])&#10;ELSE SUM([Pay Bill forecast (copy)_3292131375410327556])&#10;END' />
      </column>
      <column caption='Overall pay mix forecast' datatype='real' name='[Pay Bill forecast sum (copy)_417216322172821565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1)) = 0&#10;THEN AVG([CR forecast (copy)_417216322163204134])&#10;ELSE AVG([Pay Mix (copy)_417216322163466279])&#10;END' />
      </column>
      <column caption='Pay Mix adjusted' datatype='real' name='[Pay Mix (copy)_3292131375424512011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(AVG([CR forecast (copy)_417216322163204134])) THEN AVG([Pay Mix (copy)_4144578334957432840]) ELSE AVG([CR forecast (copy)_417216322163204134]) END' />
      </column>
      <column caption='Pay Mix LTIP' datatype='real' name='[Pay Mix (copy)_4144578334957142021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[granted_amount]/([current_salary_annualized]+ZN([granted_amount]))' />
      </column>
      <column caption='Pay Mix ideal' datatype='real' name='[Pay Mix (copy)_4144578334957432840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 1&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN 0.95&#10;ELSEIF [management_level] = &apos;IC3&apos; THEN 0.85&#10;ELSEIF [management_level] = &apos;IC4&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;IC5&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M1&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;M2&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M3&apos; THEN 0.7&#10;ELSEIF [management_level] = &apos;M4&apos; THEN 0.65&#10;ELSEIF [management_level] = &apos;M5&apos; THEN 0.6&#10;END' />
      </column>
      <column caption='Pay Mix forecast' datatype='real' name='[Pay Mix (copy)_417216322163466279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1)) = 0&#10;AND INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1)) = 0&#10;AND [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &lt; 0.85&#10;AND [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = FALSE&#10;THEN [CR forecast (copy)_417216322163204134]&#10;ELSE (&#10;    IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt;= 0.5 AND [current_salary_annualized]/[mid_salary_range] &lt; [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]&#10;    THEN (&#10;        IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = TRUE AND ZN([granted_amount]) &lt; ZN([LTIP CR forecast (copy)_2816227553956163587])&#10;        THEN &#10;            [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]/&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;            ZN([LTIP CR forecast (copy)_2816227553956163587]))&#10;        ELSE &#10;            [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]/&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;            ZN([granted_amount]))&#10;        END)&#10;    ELSE (&#10;        IF [is_tech] = 1 THEN&#10;            [CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)/&#10;            ([CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)+&#10;            [LTIP CR (copy)_2944720873037512714]*ZN([LTIP CR forecast (copy)_2816227553956163587])*(1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100))&#10;        ELSEIF [is_tech] = 0 THEN &#10;            [CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)/&#10;            ([CR (copy)_2944720873021825024]*[mid_salary_range]*(1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)+&#10;            [LTIP CR (copy)_2944720873037512714]*ZN([LTIP CR forecast (copy)_2816227553956163587])*(1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100))&#10;        ELSE&#10;            [current_salary_annualized]/(ZN([granted_amount])+[current_salary_annualized])&#10;        END)&#10;    END)&#10;END' />
      </column>
      <column caption='Pay Mix ltip adjusted' datatype='real' name='[Pay Mix adjusted (copy)_3292131375424716812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(AVG([Pay Mix (copy)_4144578334957142021])) THEN AVG([Pay Mix ideal (copy)_4144578334957862921]) ELSE AVG([Pay Mix (copy)_4144578334957142021]) END' />
      </column>
      <column caption='Pay Mix forecast adjusted' datatype='real' name='[Pay Mix forecast (copy)_3292131375424925709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(AVG([Pay Mix (copy)_417216322163466279])) THEN [Pay Mix (copy)_3292131375424512011] ELSE AVG([Pay Mix (copy)_417216322163466279]) END' />
      </column>
      <column caption='Pay Mix forecast LTIP' datatype='real' name='[Pay Mix forecast (copy)_4144578334957240327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Pay Mix (copy)_417216322163466279]' />
      </column>
      <column caption='Pay Mix forecast ltip adjusted' datatype='real' name='[Pay Mix forecast adjusted (copy)_3292131375425212430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(AVG([Pay Mix forecast (copy)_4144578334957240327])) THEN [Pay Mix adjusted (copy)_3292131375424716812] ELSE AVG([Pay Mix forecast (copy)_4144578334957240327]) END' />
      </column>
      <column caption='Pay Mix ideal LTIP' datatype='real' name='[Pay Mix ideal (copy)_4144578334957862921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Pay Mix (copy)_4144578334957432840]' />
      </column>
      <column caption='TC CR gap to 1' datatype='real' name='[TC CR (copy)_3262295032169492482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized]/[mid_salary_range] - 1&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized]/[mid_salary_range] - 1&#10;ELSE ([current_salary_annualized]+ZN([granted_amount]))/([mid_salary_range]+ZN([LTI Target (copy)_417216322117582876])) - 1&#10;END' />
      </column>
      <column caption='TC CR forecast bins' datatype='string' name='[TC CR bins (copy)_6534511990660730893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CR forecast (copy)_6534511990637326338] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [CR forecast (copy)_6534511990637326338] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [CR forecast (copy)_6534511990637326338] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [CR forecast (copy)_6534511990637326338] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [CR forecast (copy)_6534511990637326338] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [CR forecast (copy)_6534511990637326338] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
      </column>
