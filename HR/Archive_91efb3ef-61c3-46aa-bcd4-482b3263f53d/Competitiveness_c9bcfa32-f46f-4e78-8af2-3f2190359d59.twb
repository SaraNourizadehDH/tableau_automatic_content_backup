      </column>
      <column caption='LTI Target' datatype='integer' name='[Calculation_3338926570748366848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S2&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S3&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S4&apos; THEN 0&#10;&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=0 THEN 0&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=1 THEN 10000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=0 THEN 15000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=1 THEN 17500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=0 THEN 22500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=1 THEN 27500&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=0 THEN 35000&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=1 THEN 45000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=0 THEN 55000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=1 THEN 65000&#10;&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=0 THEN 20000&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=1 THEN 22500&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=0 THEN 30000&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=1 THEN 37500&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=0 THEN 45000&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=1 THEN 52500&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=0 THEN 80000&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=1 THEN 90000&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=0 THEN 112500&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=1 THEN 140000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=0 THEN 185000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=1 THEN 230000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=0 THEN 250000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=1 THEN 300000&#10;&#10;ELSE NULL END' />
      </column>
      <column caption='PayGapClasses' datatype='string' hidden='true' name='[Calculation_4270960586376654863]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2084674062187413540 1] &lt;= 0 THEN &apos;No&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.05 THEN &apos;Low&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.15 THEN &apos;Medium&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &gt;= 0.15 THEN &apos;High&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='Position in the salary band' datatype='real' name='[Calculation_4425349601479376933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([current_salary_annualized]-[min_salary_range])/([max_salary_range]-[min_salary_range])' />
      </column>
      <column caption='Avg Male Stock' datatype='real' hidden='true' name='[Calculation_4614500800762351616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2788502241464504320] &gt; 1 THEN AVG([Calculation_5143814489525088286]) ELSE NULL END' />
      </column>
      <column caption='Stock' datatype='integer' hidden='true' name='[Calculation_5143814489466945541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;THEN INT([granted_amount]) ELSE NULL END' />
      </column>
      <column caption='Employees with Stocks' datatype='string' name='[Calculation_5143814489517449228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;THEN [employee_id] ELSE NULL END' />
      </column>
      <column caption='Female Stock' datatype='real' hidden='true' name='[Calculation_5143814489524744219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;AND [gender] = &apos;Female&apos;&#10;THEN [granted_amount] ELSE NULL END' />
      </column>
      <column caption='Male Stock' datatype='real' hidden='true' name='[Calculation_5143814489525088286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;AND [gender] = &apos;Male&apos;&#10;THEN [granted_amount] ELSE NULL END' />
      </column>
      <column caption='LTI Gap' datatype='real' hidden='true' name='[Calculation_5143814489526308896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF 1-AVG([Calculation_5143814489524744219])/AVG([Calculation_3338926570748366848]) &gt; 0 &#10;THEN 1-AVG([Calculation_5143814489524744219])/AVG([Calculation_3338926570748366848])&#10;ELSEIF  [Male Salaries (copy)_2788502241464741889] &lt;= 1 THEN NULL&#10;ELSEIF  [Calculation_2788502241464504320] &lt;= 1 THEN NULL&#10;ELSE 0 END' />
      </column>
      <column caption='Male Salaries' datatype='real' hidden='true' name='[Calculation_604045329084948481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([current_salary_annualized]) ELSE null end' />
      </column>
      <column caption='Gender Pay Gap' datatype='real' hidden='true' name='[Calculation_604045329085931523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MEDIAN([Calculation_604045329084948481])-MEDIAN([Male Salaries (copy)_604045329085784066]))/MEDIAN([Calculation_604045329084948481])' />
      </column>
      <column caption='Difference on Salaries' datatype='real' hidden='true' name='[Calculation_604045329907085321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([Calculation_604045329084948481])-MEDIAN([Male Salaries (copy)_604045329085784066])' />
      </column>
      <column caption='CF_Quartile' datatype='string' name='[Calculation_604045331203624971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .25)} then &apos;1st Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .25)} AND [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .5)} then &apos;2nd Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .5)} AND [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .75)} then &apos;3rd Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .75)} then &apos;4st Quartile&apos;&#13;&#10;END' />
      </column>
      <column caption='Donut' datatype='integer' hidden='true' name='[Calculation_604045331219836940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Weighted Median' datatype='real' hidden='true' name='[Calculation_604045331301539853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id])/COUNTD([employee_id])' />
      </column>
      <column caption='Zero Axis' datatype='integer' hidden='true' name='[Calculation_604045331350392853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Midpoint Increase Tech' datatype='string' default-role='measure' default-type='quantitative' hidden='true' name='[Calculation_6334735121656061953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Midpoint Increase Tech Parameter]' />
      </column>
      <column caption='CR bins' datatype='string' name='[Calculation_6445565893758619652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_salary_annualized]/[mid_salary_range] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
      </column>
      <column caption='Median Male Salary' datatype='real' hidden='true' name='[Calculation_6562026162530938886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2788502241464504320] &gt; 1 THEN MEDIAN([Calculation_604045329084948481]) ELSE NULL END' />
      </column>
      <column caption='Median Female Salary' datatype='real' hidden='true' name='[Calculation_6562026162531057671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Male Salaries (copy)_2788502241464741889]&gt;1 THEN MEDIAN([Male Salaries (copy)_604045329085784066]) ELSE NULL END' />
      </column>
      <column caption='Avg Male Salary' datatype='real' hidden='true' name='[Calculation_6562026162861510665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2788502241464504320]&gt;1 THEN AVG([Calculation_604045329084948481]) ELSE NULL END' />
      </column>
      <column caption='Tech Pay Gap' datatype='real' hidden='true' name='[Calculation_6562026162874544139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#10;    (1 - AVG(IF [management_level] = &apos;IC1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC4&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC5&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC5&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M4&apos; THEN [current_salary_annualized] ELSE NULL END))&#10;)/9 &gt; 0&#10;&#10;THEN &#10;&#10;(&#10;    (1 - AVG(IF [management_level] = &apos;IC1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC4&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC5&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC5&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M4&apos; THEN [current_salary_annualized] ELSE NULL END))&#10;)/9&#10;&#10;ELSE 0 END' />
      </column>
      <column caption='Median GPG %' datatype='real' hidden='true' name='[Calculation_697495024264040448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if&#13;&#10;(ZN(MEDIAN([current_salary_annualized])) - LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1)) / ABS(LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1))&gt;1&#13;&#10;then 1&#13;&#10;ELSEIF &#13;&#10;(ZN(MEDIAN([current_salary_annualized])) - LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1)) / ABS(LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1))&lt;=-1&#13;&#10;then 0&#13;&#10;else &#13;&#10;(ZN(MEDIAN([current_salary_annualized])) - LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1)) / ABS(LOOKUP(ZN(MEDIAN([current_salary_annualized])), -1))&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median GPG Name' datatype='string' name='[Calculation_697495024265396225]' role='dimension' type='nominal'>
