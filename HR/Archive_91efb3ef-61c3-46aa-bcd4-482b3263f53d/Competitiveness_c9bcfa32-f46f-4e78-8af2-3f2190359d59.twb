            <column caption='LTI Target' datatype='integer' name='[Calculation_3338926570748366848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S1&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S2&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S3&apos; THEN 0&#10;ELSEIF [management_level] = &apos;S4&apos; THEN 0&#10;&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=0 THEN 0&#13;&#10;ELSEIF [management_level] = &apos;IC2&apos; AND [is_tech]=1 THEN 10000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=0 THEN 15000&#10;ELSEIF [management_level] = &apos;IC3&apos; AND [is_tech]=1 THEN 17500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=0 THEN 22500&#10;ELSEIF [management_level] = &apos;IC4&apos; AND [is_tech]=1 THEN 27500&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=0 THEN 35000&#10;ELSEIF [management_level] = &apos;IC5&apos; AND [is_tech]=1 THEN 45000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=0 THEN 55000&#10;ELSEIF [management_level] = &apos;IC6&apos; AND [is_tech]=1 THEN 65000&#10;&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=0 THEN 20000&#10;ELSEIF [management_level] = &apos;M1&apos; AND [is_tech]=1 THEN 22500&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=0 THEN 30000&#10;ELSEIF [management_level] = &apos;M2&apos; AND [is_tech]=1 THEN 37500&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=0 THEN 45000&#10;ELSEIF [management_level] = &apos;M3&apos; AND [is_tech]=1 THEN 52500&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=0 THEN 80000&#10;ELSEIF [management_level] = &apos;M4&apos; AND [is_tech]=1 THEN 90000&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=0 THEN 112500&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; AND [is_tech]=1 THEN 140000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=0 THEN 185000&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; AND [is_tech]=1 THEN 230000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=0 THEN 250000&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; AND [is_tech]=1 THEN 300000&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='CR bins' datatype='string' name='[Calculation_6445565893758619652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [current_salary_annualized]/[mid_salary_range] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
            </column>
            <column caption='LTIP CR forecast' datatype='real' name='[LTIP CR (copy)_2944720873037512714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352]&#10;THEN (&#10;    IF [granted_amount] &lt; [LTIP CR forecast (copy)_2816227553956163587]&#10;    THEN 1&#10;    ELSE [granted_amount]/ [LTIP CR forecast (copy)_2816227553956163587]&#10;    END)&#10;ELSE (&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;        ELSE (&#10;            IF [granted_amount]/[LTIP CR forecast (copy)_2816227553956163587] &lt;= FLOAT([Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862])&#10;            THEN (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            ELSE [granted_amount]/((1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;            END)&#10;        END)&#10;    ELSE (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*[granted_amount]/((1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*[LTIP CR forecast (copy)_2816227553956163587])&#10;        ELSE (&#10;            IF [granted_amount]/[LTIP CR forecast (copy)_2816227553956