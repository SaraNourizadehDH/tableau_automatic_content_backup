    <worksheet name='PM IC1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Open Sans' fontsize='12'>Pay Mix by Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='Pay Mix' datatype='real' name='[CR forecast (copy)_417216322163204134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[current_salary_annualized]/([current_salary_annualized]+[granted_amount])' />
            </column>
            <column caption='CR bins' datatype='string' name='[Calculation_6445565893758619652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [current_salary_annualized]/[mid_salary_range] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
            </column>
            <column caption='Pay Mix adjusted' datatype='real' name='[Pay Mix (copy)_3292131375424512011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(AVG([CR forecast (copy)_417216322163204134])) THEN AVG([Pay Mix (copy)_4144578334957432840]) ELSE AVG([CR forecast (copy)_417216322163204134]) END' />
            </column>
            <column caption='Pay Mix ideal' datatype='real' name='[Pay Mix (copy)_4144578334957432840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 1&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN 0.95&#10;ELSEIF [management_level] = &apos;IC3&apos; THEN 0.85&#10;ELSEIF [management_level] = &apos;IC4&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;IC5&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M1&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;M2&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M3&apos; THEN 0.7&#10;ELSEIF [management_level] = &apos;M4&apos; THEN 0.65&#10;ELSEIF [management_level] = &apos;M5&apos; THEN 0.6&#10;END' />
            </column>
            <column caption='Pay Mix ideal LTIP' datatype='real' name='[Pay Mix ideal (copy)_4144578334957862921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Pay Mix (copy)_4144578334957432840]' />
            </column>
            <column-instance column='[CR forecast (copy)_417216322163204134]' derivation='Avg' name='[avg:CR forecast (copy)_417216322163204134:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Pay Mix ideal (copy)_4144578334957862921]' derivation='Avg' name='[avg:Pay Mix ideal (copy)_4144578334957862921:qk]' pivot='key' type='quantitative' />
            <column caption='C Level' datatype='string' name='[c_level]' role='dimension' type='nominal' />
            <column caption='Current Salary Annualized' datatype='real' name='[current_salary_annualized]' role='measure' type='quantitative' />
            <column caption='First Day Of Work' datatype='date' name='[first_day_of_work]' role='dimension' type='ordinal' />
            <column aggregation='CountD' caption='Granted Amount' datatype='real' datatype-customized='true' name='[granted_amount]' role='measure' type='quantitative' />
            <column caption='Is Tech' datatype='integer' name='[is_tech]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Non Tech' />
                <alias key='1' value='Tech' />
              </aliases>
            </column>
            <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column caption='Job Profile' datatype='string' name='[job_profile]' role='dimension' type='nominal' />
            <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column caption='Mid Salary Range' datatype='real' name='[mid_salary_range]' role='measure' type='quantitative' />
            <column-instance column='[Pay Mix (copy)_4144578334957432840]' derivation='Min' name='[min:Pay Mix (copy)_4144578334957432840:qk]' pivot='key' type='quantitative' />
