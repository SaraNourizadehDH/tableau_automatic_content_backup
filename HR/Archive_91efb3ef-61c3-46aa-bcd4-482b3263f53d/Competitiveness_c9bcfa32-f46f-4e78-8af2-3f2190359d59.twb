            <column caption='Threshold CR for Salary Increase Tech' datatype='string' datatype-customized='true' name='[Threshold CR for Salary Increase NonTech (copy)_156429752705753099]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Threshold CR for LTIP Increase NonTech' datatype='string' datatype-customized='true' name='[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Threshold CR for Salary Increase NonTech' datatype='string' datatype-customized='true' name='[Threshold CR for Salary Increase Tech (copy)_6445565893748957186]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='CR forecast' datatype='real' name='[CR (copy)_2944720873021825024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt; [current_salary_annualized]/[mid_salary_range]&#10;THEN [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]&#10;ELSE (&#10;&#10;    IF [is_tech] = 1 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range]) &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099])&#10;            THEN (1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSEIF [is_tech] = 0 &#10;    THEN (&#10;        IF [Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186] = &apos;All&apos;&#10;        THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;        ELSE (&#10;            IF [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&lt;= FLOAT([Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186])&#10;            THEN (1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            ELSE [current_salary_annualized]/((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])&#10;            END)&#10;        END)&#10;    ELSE [current_salary_annualized]/[mid_salary_range]&#10;    END)&#10;END' />
            </column>
            <column caption='TC CR' datatype='real' name='[CR (copy)_6534511990630928385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized]/[mid_salary_range]&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized]/[mid_salary_range]&#10;ELSE ([current_salary_annualized]+ZN([granted_amount]))/([mid_salary_range]+ZN([LTI Target (copy)_417216322117582876]))&#10;END' />
            </column>
            <column caption='TC CR forecast' datatype='real' name='[CR forecast (copy)_6534511990637326338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; OR [management_level] = &apos;IC2&apos; &#10;THEN [CR (copy)_2944720873021825024]&#10;ELSE (&#10;    IF [Parameters].[LTIP Bring All to Target (copy)_5656943389791903759] &gt; [current_salary_annualized]/[mid_salary_range]&#10;    THEN (&#10;        IF [Parameters].[LTIP Increase NonTech (copy)_2816227553946980352] = TRUE AND ZN([granted_amount]) &lt; ZN([LTI Target (copy)_417216322117582876])&#10;        THEN&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;             ZN([LTI Target (copy)_417216322117582876]))/&#10;            ([mid_salary_range]+&#10;             ZN([LTI Target (copy)_417216322117582876]))&#10;        ELSE&#10;            ([Parameters].[LTIP Bring All to Target (copy)_5656943389791903759]*[mid_salary_range]+&#10;             ZN([granted_amount]))/&#10;            ([mid_salary_range]+&#10;             ZN([LTI Target (copy)_417216322117582876]))&#10;        END)&#10;    ELSE (&#10;&#10;        IF [is_tech] = 1&#10;        THEN (&#10;            IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099] = &apos;All&apos;&#10;            THEN (&#10;                IF [Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862] = &apos;All&apos;&#10;                THEN&#10;                    ((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]+&#10;                    (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*ZN([granted_amount]))/&#10;                    (((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                    (1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                ELSE (&#10;                    IF NOT ISNULL([granted_amount]) AND NOT ISNULL([LTI Target (copy)_417216322117582876]) AND [granted_amount]/[LTI Target (copy)_417216322117582876] &lt;= FLOAT([Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862])&#10;                    THEN&#10;                        ((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]+&#10;                        (1+INT(SPLIT([Parameters].[LTIP Increase NonTech (copy)_2944720873038401552],&apos; &apos;,1))/100)*ZN([granted_amount]))/&#10;                        (((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                        (1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                    ELSE&#10;                        ((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121668395012],&apos; &apos;,1))/100)*[current_salary_annualized]+&#10;                        ZN([granted_amount]))/&#10;                        (((1+INT(SPLIT([Parameters].[Midpoint Increase Tech Parameter],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                        (1+INT(SPLIT([Parameters].[LTIP Target Increase NonTech (copy)_2944720873037901836],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                    END)&#10;                END)&#10;            ELSE (&#10;                IF [current_salary_annualized]/[mid_salary_range] &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase NonTech (copy)_156429752705753099])&#10;                THEN (&#10;                    IF [Parameters].[Threshold CR for LTIP Increase NonTech (copy)_2944720873038286862] = &apos;All&apos;&#10;                    THEN&#10;                        ((1+INT(SPLIT([Parameters].[Midpoint In