          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='Ideal CR' datatype='real' name='[CR bins (copy)_156429753021493272]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_6445565893758619652] = &quot;&lt;0.85&quot; THEN 0.03&#10;ELSEIF [Calculation_6445565893758619652] = &quot;0.85-0.90&quot; THEN 0.07&#10;ELSEIF [Calculation_6445565893758619652] = &quot;0.90-0.95&quot; THEN 0.3&#10;ELSEIF [Calculation_6445565893758619652] = &quot;0.95-1.00&quot; THEN 0.3&#10;ELSEIF [Calculation_6445565893758619652] = &quot;1.00-1.10&quot; THEN 0.2&#10;ELSEIF [Calculation_6445565893758619652] = &quot;&gt;1.10&quot; THEN 0.1&#10;END' />
