    <worksheet name='PM M5'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Open Sans' fontsize='12'>Pay Mix by Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='Pay Mix' datatype='real' name='[CR forecast (copy)_417216322163204134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[current_salary_annualized]/([current_salary_annualized]+[granted_amount])' />
            </column>
            <column caption='CR bins' datatype='string' name='[Calculation_6445565893758619652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [current_salary_annualized]/[mid_salary_range] &lt; 0.85 THEN &quot;&lt;0.85&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.9 THEN &quot;0.85-0.90&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 0.95 THEN &quot;0.90-0.95&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1 THEN &quot;0.95-1.00&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &lt; 1.1 THEN &quot;1.00-1.10&quot;&#10;ELSEIF [current_salary_annualized]/[mid_salary_range] &gt;= 1.1 THEN &quot;&gt;1.10&quot;&#10;ELSE NULL END' />
            </column>
            <column caption='Pay Mix LTIP' datatype='real' name='[Pay Mix (copy)_4144578334957142021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[granted_amount]/([current_salary_annualized]+ZN([granted_amount]))' />
            </column>
            <column-instance column='[CR forecast (copy)_417216322163204134]' derivation='Avg' name='[avg:CR forecast (copy)_417216322163204134:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Pay Mix (copy)_4144578334957142021]' derivation='Avg' name='[avg:Pay Mix (copy)_4144578334957142021:qk]' pivot='key' type='quantitative' />
            <column caption='C Level' datatype='string' name='[c_level]' role='dimension' type='nominal' />
            <column caption='Current Salary Annualized' datatype='real' name='[current_salary_annualized]' role='measure' type='quantitative' />
            <column caption='First Day Of Work' datatype='date' name='[first_day_of_work]' role='dimension' type='ordinal' />
            <column aggregation='CountD' caption='Granted Amount' datatype='real' datatype-customized='true' name='[granted_amount]' role='measure' type='quantitative' />
            <column caption='Is Tech' datatype='integer' name='[is_tech]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Non Tech' />
                <alias key='1' value='Tech' />
