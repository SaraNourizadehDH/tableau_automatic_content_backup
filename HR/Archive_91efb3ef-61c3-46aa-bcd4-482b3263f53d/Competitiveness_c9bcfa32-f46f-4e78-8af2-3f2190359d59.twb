          <filter class='categorical' column='[federated.1mxslha005o3dj12huq9u1xzd2no].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1mxslha005o3dj12huq9u1xzd2no].[avg:Pay Mix (copy)_4144578334957142021:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1mxslha005o3dj12huq9u1xzd2no].[avg:CR forecast (copy)_417216322163204134:qk]&quot;' />
