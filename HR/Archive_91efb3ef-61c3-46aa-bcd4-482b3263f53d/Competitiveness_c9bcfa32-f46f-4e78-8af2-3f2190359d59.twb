)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                        (1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                    ELSE&#10;                        ((1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]+&#10;                        ZN([granted_amount]))/&#10;                        (((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                        (1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                    END)&#10;                END)&#10;            ELSE (&#10;                IF [current_salary_annualized]/[mid_salary_range] &lt;= FLOAT([Parameters].[Threshold CR for Salary Increase Tech (copy)_6445565893748957186])&#10;                THEN (&#10;                    IF [Parameters].[Threshold CR for Salary Increase NonTech (copy)_2944720873038188557] = &apos;All&apos;&#10;                    THEN&#10;                        ((1+INT(SPLIT([Parameters].[Salary Increase Tech (copy)_6445565893748842496],&apos; &apos;,1))/100)*[current_salary_annualized]+&#10;                        (1+INT(SPLIT([Parameters].[Salary Increase NonTech (copy)_2944720873038344207],&apos; &apos;,1))/100)*ZN([granted_amount]))/&#10;                        (((1+INT(SPLIT([Parameters].[Midpoint Increase Tech (copy)_6334735121656946691],&apos; &apos;,1))/100)*[mid_salary_range])+&#10;                        (1+INT(SPLIT([Parameters].[Midpoint Increase NonTech (copy)_2944720873037705227],&apos; &apos;,1))/100)*ZN([LTI Target (copy)_417216322117582876]))&#10;                    ELSE (&#10;                        IF NOT ISNULL([granted_amount]) AND NOT ISNULL([LTI Target (copy)_41721