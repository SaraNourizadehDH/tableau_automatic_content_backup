      <column caption='CR' datatype='real' name='[Calculation_2000653800788893696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[current_salary_annualized]/[mid_salary_range]' />
      </column>
      <column caption='Salaries' datatype='real' name='[Calculation_2084674062119718923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[current_salary_annualized]' />
      </column>
      <column caption='Equal Pay Index' datatype='real' hidden='true' name='[Calculation_2084674062187413540 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF 1-AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_2084674062119718923]) &lt; 0 THEN 0&#10;ELSEIF  [Male Salaries (copy)_2788502241464741889] &lt;= 1 THEN NULL&#10;ELSEIF  [Calculation_2788502241464504320] &lt;= 1 THEN NULL&#10;ELSE 1-AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_2084674062119718923]) END' />
      </column>
      <column caption='Pay gap' datatype='real' hidden='true' name='[Calculation_2084674062187413540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Female Employees (copy)_2861263539163430922]&gt;1 AND [Calculation_2788502241464504320]&gt;1 and [Male Salaries (copy)_2788502241464741889]&gt;1 THEN 1-MEDIAN([Male Salaries (copy)_604045329085784066])/MEDIAN([Calculation_604045329084948481]) ELSE NULL END' />
      </column>
      <column caption='hierarchy track-level' datatype='string' name='[Calculation_2279454755654246415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([management_level],&apos;IC&apos;) THEN &apos;IC&apos;&#10;ELSEIF CONTAINS([management_level],&apos;M&apos;) THEN &apos;M&apos;&#10;ELSE NULL END' />
      </column>
      <column caption='Male Employees' datatype='integer' hidden='true' name='[Calculation_2788502241464504320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [gender]==&apos;Male&apos; THEN [employee_id] ELSE NULL END)' />
      </column>
      <column caption='only_include_dhse' datatype='boolean' name='[Calculation_2861263539274350606]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([compensation_profile],&apos;Company = DHSE&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='count_bins_cr' datatype='integer' name='[Calculation_2944720873066369057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_6445565893758619652])' />
      </column>
