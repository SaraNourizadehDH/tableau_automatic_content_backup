            <column-instance column='[first_day_of_work]' derivation='None' name='[none:first_day_of_work:qk]' pivot='key' type='quantitative' />
            <column-instance column='[is_tech]' derivation='None' name='[none:is_tech:ok]' pivot='key' type='ordinal' />
            <column-instance column='[job_family]' derivation='None' name='[none:job_family:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_profile]' derivation='None' name='[none:job_profile:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
