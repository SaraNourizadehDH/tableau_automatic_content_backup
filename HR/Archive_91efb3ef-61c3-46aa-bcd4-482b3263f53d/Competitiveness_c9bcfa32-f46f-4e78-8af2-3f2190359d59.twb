              <calculation class='tableau' formula='IF [management_level] = &apos;IC1&apos; THEN 1&#10;ELSEIF [management_level] = &apos;IC2&apos; THEN 0.95&#10;ELSEIF [management_level] = &apos;IC3&apos; THEN 0.85&#10;ELSEIF [management_level] = &apos;IC4&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;IC5&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M1&apos; THEN 0.8&#10;ELSEIF [management_level] = &apos;M2&apos; THEN 0.75&#10;ELSEIF [management_level] = &apos;M3&apos; THEN 0.7&#10;ELSEIF [management_level] = &apos;M4&apos; THEN 0.65&#10;ELSEIF [management_level] = &apos;M5&apos; THEN 0.6&#10;END' />
