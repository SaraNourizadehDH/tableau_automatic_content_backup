      <aliases enabled='yes' />
      <column aggregation='User' caption='Workbooks Viewed' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2066800417010479104]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD([workbook_id])' />
      </column>
      <column aggregation='Sum' caption='days' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_255157112087527424]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{fixed DATETRUNC(&apos;month&apos;,[created_at]) : max(day([created_at]))}' />
      </column>
      <column aggregation='Count' caption='Report Month' datatype='string' default-type='nominal' layered='true' name='[Calculation_3937694220331175938]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='STR(YEAR([created_at]))&#10;+ &#10;IIF(MONTH([created_at])&lt;10, &quot;-0&quot;, &quot;-&quot;)&#10;+&#10;STR(MONTH([created_at]))' />
      </column>
      <column caption='Pageviews per User colourcode' datatype='string' name='[Calculation_5693957323473653761]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5812458328699584515] &lt; 23 THEN &quot;Less Engaged&quot;&#10;ELSEIF [Calculation_5812458328699584515] &gt;= 23 AND [Calculation_5812458328699584515] &lt; 46 THEN &quot;Engaged&quot;&#10;ELSEIF [Calculation_5812458328699584515] &gt;= 46 THEN &quot;Highly Engaged&quot;&#10;END' />
      </column>
      <column caption='Dummy' datatype='integer' name='[Calculation_5693957323478765570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column aggregation='Count' caption='Dimension' datatype='string' default-type='nominal' layered='true' name='[Calculation_5812458328697446401]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Site&quot; THEN [site_name]&#10;    WHEN &quot;Project&quot; THEN [project_name]&#10;    WHEN &quot;Workbook&quot; THEN [workbook_name]&#10;    WHEN &quot;WorkbookView&quot; THEN [workbook_name]+&quot;:&quot;+[view_name]&#10;    WHEN &quot;Entity (of User)&quot; THEN [Email Domain (group)]&#10;    WHEN &quot;Email Domain&quot; THEN [email_domain]&#10;    WHEN &quot;User Site Role&quot; THEN [Site Role (group)]&#10;    WHEN &quot;Server&quot; THEN &quot;Server&quot;&#10;    WHEN &quot;Access Type&quot; THEN [how_viewed]&#10;END' />
      </column>
      <column aggregation='User' caption='Pageviews per Workbook' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5812458328699260930]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='SUM([Number of Records])/[Calculation_2066800417010479104]' />
      </column>
      <column aggregation='User' caption='Pageviews per User' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5812458328699584515]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='SUM([Number of Records]) / [Calculation_6266829251120840704]' />
      </column>
      <column aggregation='User' caption='KPI' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5812458328702300165]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Total Pageviews&quot; THEN SUM([Number of Records])&#10;    WHEN &quot;Active Users&quot; THEN [Calculation_6266829251120840704]&#10;    WHEN &quot;Workbooks Viewed&quot; THEN [Calculation_2066800417010479104]&#10;    WHEN &quot;Pageviews per Workbook&quot; THEN [Calculation_5812458328699260930]&#10;    WHEN &quot;Pageviews per User&quot; THEN [Calculation_5812458328699584515]&#10;END' />
      </column>
      <column aggregation='User' caption='Active Users' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_6266829251120840704]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column aggregation='Sum' caption='Sum Daily Users' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_6995708747881594880]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{fixed [user_id], DATETRUNC(&apos;day&apos;,[created_at]) : countd([user_id])}' />
