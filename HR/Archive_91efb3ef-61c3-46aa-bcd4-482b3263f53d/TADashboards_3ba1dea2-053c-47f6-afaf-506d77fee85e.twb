              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Site&quot; THEN [site_name]&#10;    WHEN &quot;Project&quot; THEN [project_name]&#10;    WHEN &quot;Workbook&quot; THEN [workbook_name]&#10;    WHEN &quot;WorkbookView&quot; THEN [workbook_name]+&quot;:&quot;+[view_name]&#10;    WHEN &quot;Entity (of User)&quot; THEN [Email Domain (group)]&#10;    WHEN &quot;Email Domain&quot; THEN [email_domain]&#10;    WHEN &quot;User Site Role&quot; THEN [Site Role (group)]&#10;    WHEN &quot;Server&quot; THEN &quot;Server&quot;&#10;    WHEN &quot;Access Type&quot; THEN [how_viewed]&#10;END' />
