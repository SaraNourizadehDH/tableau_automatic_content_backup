    <worksheet name='PayEquity by tech-nontech'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Fair Pay by Level and Tech/Non Tech</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='Salaries' datatype='real' name='[Calculation_2084674062119718923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[current_salary_annualized]' />
            </column>
            <column caption='Equal Pay Index' datatype='real' name='[Calculation_2084674062187413540 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF 1-AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_2084674062119718923]) &lt; 0 THEN 0&#10;ELSEIF  [Male Salaries (copy)_2788502241464741889] &lt;= 1 THEN NULL&#10;ELSEIF  [Calculation_2788502241464504320] &lt;= 1 THEN NULL&#10;ELSE 1-AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_2084674062119718923]) END' />
            </column>
            <column caption='hierarchy track-level' datatype='string' name='[Calculation_2279454755654246415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([management_level],&apos;IC&apos;) THEN &apos;IC&apos;&#10;ELSEIF CONTAINS([management_level],&apos;M&apos;) THEN &apos;M&apos;&#10;ELSE NULL END' />
            </column>
            <column caption='Male Employees' datatype='integer' name='[Calculation_2788502241464504320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [gender]==&apos;Male&apos; THEN [employee_id] ELSE NULL END)' />
            </column>
            <column caption='LTI Target' datatype='integer' name='[Calculation_3338926570748366848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([position],&apos;IC1&apos;) THEN 0&#10;&#10;ELSEIF CONTAINS([position],&apos;IC2&apos;) AND [is_tech]=0 THEN 0&#10;ELSEIF CONTAINS([position],&apos;IC2&apos;) AND [is_tech]=1 THEN 10000&#10;ELSEIF CONTAINS([position],&apos;IC3&apos;) AND [is_tech]=0 THEN 15000&#10;ELSEIF CONTAINS([position],&apos;IC3&apos;) AND [is_tech]=1 THEN 17500&#10;ELSEIF CONTAINS([position],&apos;IC4&apos;) AND [is_tech]=0 THEN 22500&#10;ELSEIF CONTAINS([position],&apos;IC4&apos;) AND [is_tech]=1 THEN 27500&#10;ELSEIF CONTAINS([position],&apos;IC5&apos;) AND [is_tech]=0 THEN 35000&#10;ELSEIF CONTAINS([position],&apos;IC5&apos;) AND [is_tech]=1 THEN 45000&#10;ELSEIF CONTAINS([position],&apos;IC6&apos;) AND [is_tech]=0 THEN 55000&#10;ELSEIF CONTAINS([position],&apos;IC6&apos;) AND [is_tech]=1 THEN 65000&#10;&#10;ELSEIF CONTAINS([position],&apos;M1&apos;) AND [is_tech]=0 THEN 20000&#10;ELSEIF CONTAINS([position],&apos;M1&apos;) AND [is_tech]=1 THEN 22500&#10;ELSEIF CONTAINS([position],&apos;M2&apos;) AND [is_tech]=0 THEN 30000&#10;ELSEIF CONTAINS([position],&apos;M2&apos;) AND [is_tech]=1 THEN 37500&#10;ELSEIF CONTAINS([position],&apos;M3&apos;) AND [is_tech]=0 THEN 45000&#10;ELSEIF CONTAINS([position],&apos;M3&apos;) AND [is_tech]=1 THEN 52500&#10;ELSEIF CONTAINS([position],&apos;M4&apos;) AND [is_tech]=0 THEN 80000&#10;ELSEIF CONTAINS([position],&apos;M4&apos;) AND [is_tech]=1 THEN 90000&#10;ELSEIF CONTAINS([position],&apos;M5&apos;) AND [is_tech]=0 THEN 112500&#10;ELSEIF CONTAINS([position],&apos;M5&apos;) AND [is_tech]=1 THEN 140000&#10;ELSEIF CONTAINS([position],&apos;M6&apos;) AND [is_tech]=0 THEN 185000&#10;ELSEIF CONTAINS([position],&apos;M6&apos;) AND [is_tech]=1 THEN 230000&#10;ELSEIF CONTAINS([position],&apos;E1&apos;) AND [is_tech]=0 THEN 250000&#10;ELSEIF CONTAINS([position],&apos;E1&apos;) AND [is_tech]=1 THEN 300000&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='PayGapClasses' datatype='string' name='[Calculation_4270960586376654863]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2084674062187413540 1] &lt;= 0 THEN &apos;No&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.05 THEN &apos;Low&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &lt; 0.15 THEN &apos;Medium&apos;&#10;ELSEIF ABS([Calculation_2084674062187413540 1]) &gt;= 0.15 THEN &apos;High&apos;&#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='Stock' datatype='integer' name='[Calculation_5143814489466945541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;THEN INT([granted_amount]) ELSE NULL END' />
            </column>
            <column caption='Female Stock' datatype='real' name='[Calculation_5143814489524744219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;AND [gender] = &apos;Female&apos;&#10;THEN [granted_amount] ELSE NULL END' />
            </column>
            <column caption='Male Stock' datatype='real' name='[Calculation_5143814489525088286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT CONTAINS([position],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC1&apos;)&#10;AND NOT CONTAINS([job_profile],&apos;IC2&apos;)&#10;AND NOT CONTAINS([position],&apos;IC2&apos;)&#10;AND [gender] = &apos;Male&apos;&#10;THEN [granted_amount] ELSE NULL END' />
            </column>
            <column caption='LTI Gap' datatype='real' name='[Calculation_5143814489526308896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF 1-AVG([Calculation_5143814489524744219])/AVG([Calculation_3338926570748366848]) &gt; 0 &#10;THEN 1-AVG([Calculation_5143814489524744219])/AVG([Calculation_3338926570748366848])&#10;ELSEIF  [Male Salaries (copy)_2788502241464741889] &lt;= 1 THEN NULL&#10;ELSEIF  [Calculation_2788502241464504320] &lt;= 1 THEN NULL&#10;ELSE 0 END' />
            </column>
            <column caption='Male Salaries' datatype='real' name='[Calculation_604045329084948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([current_salary_annualized]) ELSE null end' />
            </column>
            <column caption='Avg Female Salary' datatype='real' name='[Calculation_6562026162861441032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Male Salaries (copy)_2788502241464741889]&gt;1 THEN AVG([Male Salaries (copy)_604045329085784066]) ELSE NULL END' />
            </column>
            <column caption='Avg Male Salary' datatype='real' name='[Calculation_6562026162861510665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2788502241464504320]&gt;1 THEN AVG([Calculation_604045329084948481]) ELSE NULL END' />
            </column>
            <column caption='Tech Pay Gap' datatype='real' name='[Calculation_6562026162874544139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    (1 - AVG(IF [management_level] = &apos;IC1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC4&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC5&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC5&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M4&apos; THEN [current_salary_annualized] ELSE NULL END))&#10;)/9 &gt; 0&#10;&#10;THEN &#10;&#10;(&#10;    (1 - AVG(IF [management_level] = &apos;IC1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC4&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;IC5&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;IC5&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M1&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M1&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M2&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M2&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M3&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M3&apos; THEN [current_salary_annualized] ELSE NULL END))+&#10;    (1 - AVG(IF [management_level] = &apos;M4&apos; AND [gender] = &apos;Female&apos; THEN [current_salary_annualized] ELSE NULL END)/AVG(IF [management_level] = &apos;M4&apos; THEN [current_salary_annualized] ELSE NULL END))&#10;)/9&#10;&#10;ELSE 0 END' />
