      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='389' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='388' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='81' h='7750' id='29' is-fixed='true' is-scaled='1' param='Image/images.png' type-v2='bitmap' w='5537' x='571' y='667'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7750' id='10' type-v2='text' w='93321' x='6108' y='667'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone fixed-size='90' h='7500' id='255' is-fixed='true' name='Last updated' show-title='false' w='23143' x='76500' y='1000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='29500' id='334' type-v2='text' w='92432' x='3770' y='15333'>
                  <formatted-text>
                    <run bold='true' fontcolor='#555555' fontname='Open Sans' fontsize='14'>Definitions</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                    <run bold='true' fontname='Open Sans' fontsize='11'>Gender Pay Gap: </run>
                    <run fontname='Open Sans' fontsize='11'>(mean male salary-mean female salary) / mean male salary</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Open Sans' fontsize='11'>Base Salary Pay Quartiles:</run>
                    <run fontname='Open Sans' fontsize='11'> Quartiles based on Base Salary across DHSE. Salaries are sorted in an ascending way. The first quartile is formed by employees within the lowest quarter of salaries.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Open Sans' fontsize='11'>Base Salary Comp Ratio: </run>
                    <run fontname='Open Sans' fontsize='11'>Ratio between employee&apos;s salary and the mid point of their salary band.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Open Sans' fontsize='11'>Equal Pay Index (Base Salary): </run>
                    <run fontname='Open Sans' fontsize='11'>1- ratio between average female salary and average overall salary</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Open Sans' fontsize='11'>Equal Pay Index (LTI): </run>
                    <run fontname='Open Sans' fontsize='11'>1- the average of the ratio between female LTI and LTI target </run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4289' id='24' type-v2='text' w='92432' x='3770' y='92216'>
                  <formatted-text>
                    <run bold='true' fontalignment='1'>Created By: Luigi Rossi</run>
                    <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA</run>
                  </formatted-text>
