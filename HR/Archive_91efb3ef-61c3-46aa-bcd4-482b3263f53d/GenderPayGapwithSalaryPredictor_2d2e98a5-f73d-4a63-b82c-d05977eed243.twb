            <column caption='Pay gap' datatype='real' name='[Calculation_2084674062187413540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Female Employees (copy)_2861263539163430922]&gt;1 THEN 1-(AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_604045329084948481])) ELSE NULL END' />
            </column>
            <column caption='Male Salaries' datatype='real' name='[Calculation_604045329084948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([current_salary_annualized]) ELSE null end' />
            </column>
