        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Weighted Median' datatype='real' name='[Calculation_604045331301539853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id])/COUNTD([employee_id])' />
