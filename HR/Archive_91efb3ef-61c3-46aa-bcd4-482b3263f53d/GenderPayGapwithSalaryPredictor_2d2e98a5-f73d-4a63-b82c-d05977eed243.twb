          <object caption='stock_grant' id='stock_grant_7634D944A82F4EDE8424FFC95C6200B2'>
            <properties context=''>
              <relation connection='athena.0650j190jl6x8714jevru1xeuccc' name='Custom SQL Query' type='text'>SELECT
  &quot;stock_grant&quot;.&quot;company&quot; AS &quot;company__stock_gra&quot;,
  &quot;stock_grant&quot;.&quot;cost_center_id&quot; AS &quot;cost_center_id__st&quot;,
  &quot;stock_grant&quot;.&quot;employee_id&quot; AS &quot;employee_id__stock&quot;,
  SUM(CAST(&quot;stock_grant&quot;.&quot;granted_amount&quot; AS DOUBLE)) AS &quot;granted_amount&quot;
FROM &quot;people_ops_il&quot;.&quot;stock_grant&quot; &quot;stock_grant&quot;
WHERE &quot;stock_grant&quot;.&quot;stock_plan&quot; NOT LIKE &apos;Hero Grant%&apos;
GROUP BY 1,2,3</relation>
            </properties>
