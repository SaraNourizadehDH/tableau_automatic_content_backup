      <column caption='Male Salaries' datatype='real' name='[Calculation_604045329084948481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([current_salary_annualized]) ELSE null end' />
      </column>
      <column caption='Gender Pay Gap' datatype='real' name='[Calculation_604045329085931523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Calculation_604045329084948481])-AVG([Male Salaries (copy)_604045329085784066]))/AVG([Calculation_604045329084948481])' />
      </column>
      <column caption='25th Percentile' datatype='real' name='[Calculation_604045329090211844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='PERCENTILE([current_salary_annualized],0.25)' />
      </column>
      <column caption='Difference on Salaries' datatype='real' name='[Calculation_604045329907085321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_604045329084948481])-AVG([Male Salaries (copy)_604045329085784066])' />
      </column>
      <column caption='CF_Quartile' datatype='string' name='[Calculation_604045331203624971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .25)} then &apos;1st Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .25)} AND [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .5)} then &apos;2nd Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .5)} AND [current_salary_annualized] &lt;= {fixed: PERCENTILE([current_salary_annualized], .75)} then &apos;3rd Quartile&apos;&#10;ELSEIF [current_salary_annualized] &gt;= {fixed: PERCENTILE([current_salary_annualized], .75)} then &apos;4st Quartile&apos;&#13;&#10;END' />
      </column>
