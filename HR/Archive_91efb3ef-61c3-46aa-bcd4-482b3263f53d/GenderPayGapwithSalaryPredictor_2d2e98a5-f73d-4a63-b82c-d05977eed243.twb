    <worksheet name='Pay Equity by Level'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Open Sans' fontsize='12'>Base Salary Pay Gap by Level and Track</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data' name='federated.1mxslha005o3dj12huq9u1xzd2no' />
          </datasources>
          <datasource-dependencies datasource='federated.1mxslha005o3dj12huq9u1xzd2no'>
            <column caption='Pay gap' datatype='real' name='[Calculation_2084674062187413540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Female Employees (copy)_2861263539163430922]&gt;1 THEN 1-(AVG([Male Salaries (copy)_604045329085784066])/AVG([Calculation_604045329084948481])) ELSE NULL END' />
            </column>
            <column caption='hierarchy track-level' datatype='string' name='[Calculation_2279454755654246415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([management_level],&apos;IC&apos;) THEN &apos;IC&apos;&#10;ELSEIF CONTAINS([management_level],&apos;M&apos;) THEN &apos;M&apos;&#10;ELSE NULL END' />
            </column>
            <column caption='Male Salaries' datatype='real' name='[Calculation_604045329084948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Male&apos; THEN([current_salary_annualized]) ELSE null end' />
            </column>
            <column caption='Employees' datatype='integer' name='[Female Employees (copy)_2861263539163430922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([employee_id])' />
            </column>
            <column caption='Female Salaries' datatype='real' name='[Male Salaries (copy)_604045329085784066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&apos;Female&apos; THEN([current_salary_annualized]) ELSE null end' />
            </column>
            <column-instance column='[Calculation_604045329084948481]' derivation='Avg' name='[avg:Calculation_604045329084948481:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Male Salaries (copy)_604045329085784066]' derivation='Avg' name='[avg:Male Salaries (copy)_604045329085784066:qk]' pivot='key' type='quantitative' />
            <column caption='C Level' datatype='string' name='[c_level]' role='dimension' type='nominal' />
            <column caption='Current Salary Annualized' datatype='real' name='[current_salary_annualized]' role='measure' type='quantitative' />
