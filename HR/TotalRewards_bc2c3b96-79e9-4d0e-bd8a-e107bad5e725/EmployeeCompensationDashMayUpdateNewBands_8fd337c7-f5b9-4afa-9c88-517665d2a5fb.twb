    <worksheet name='LTI Comp Ratio Overall (New Hires)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'><![CDATA[LTI CR - <[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[tyr:Hired date:qk]> New Eligible Hires]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Head-counts' datatype='integer' name='[Calculation_1372190511806812160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([Staff file #])' />
            </column>
            <column caption='LTI Comp Range' datatype='string' name='[Calculation_1788773495317737473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.5 then &quot;&lt;0.5&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.5 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.8 then &quot;0.5 - 0.8&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.80 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.95 then &quot;0.8 - 0.95&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.95 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1.05 then &quot;0.95 - 1.05&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1.05 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1.2 then &quot;1.05 - 1.2&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1.20 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;=1.50 then &quot;1.2 - 1.5&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1.50 then &quot;&gt;1.5&quot;&#13;&#10;&#13;&#10;Else &quot;--&quot;&#13;&#10;END' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Sub-department]' role='dimension' type='nominal' />
            <column caption='LTI Elgibility' datatype='boolean' name='[Head Counts LTI (copy)_690739600553603073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If(Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;) then True Else False End' />
            </column>
            <column datatype='date' name='[Hired date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[HoF Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code (HOF Access Dimension)]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='quantitative'>
              <aliases>
