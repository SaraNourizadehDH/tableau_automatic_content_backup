            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9' underline='true'>Comp Ratio Ranges Definition for LTI:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>&lt;0.5:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>Comp Ratio less than 0.5</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>0.50 - 0.80:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 0.5 or more but less than 0.8</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>0.80 - 0.95:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 0.8 or more but less than 0.95 </run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>0.95-1.05:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 0.95 or more but less than 1.05 </run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>1.05-1.25:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 1.05 or more but less than 1.25</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> 1.25 - 1.5:&#9;</run>
