            <column caption='LTI Head-counts' datatype='integer' name='[Calculation_982910624073793536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If((Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;)or [LTI Grant]&gt;0) &#13;&#10;then 1 Else 0 End' />
