            </column>
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='Payroll-ID' datatype='string' name='[Staff file #]' role='dimension' type='nominal' />
            <column caption='LTI Comp Ratio' datatype='real' name='[T Cash Comp Ratio (copy)_1142506933305077766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LTI Grant]/[Mid (LTI)]' />
