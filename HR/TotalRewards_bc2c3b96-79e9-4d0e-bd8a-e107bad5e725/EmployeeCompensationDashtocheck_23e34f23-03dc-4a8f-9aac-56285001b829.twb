        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[2024 SSD+].[Staff file #]' />
              <expression op='[Performance].[Payroll Id]' />
            </expression>
          </clause>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='If([Role Catalogue+].[Band code]&lt;&gt;&quot;Tech&quot; and [Role Catalogue+].[Band code]&lt;&gt;&quot;Product&quot;) then &quot;Non Tech&quot;&#13;&#10;ELSEIF ISNULL([Role Catalogue+].[Band code])=True then &quot;Non Tech&quot;&#13;&#10;else [Role Catalogue+].[Band code] end +&#13;&#10;If ([2024 SSD+].[Location Mapping]=&quot;Egypt&quot; or [2024 SSD+].[Location Mapping]=&quot;Iraq&quot; or [2024 SSD+].[Location Mapping]=&quot;Jordan&quot;) then [2024 SSD+].[Location Mapping] else &quot;GCC&quot; END + [2024 SSD+].[Level code]' />
                  <expression op='[LTI].[Code]' />
                </expression>
                <expression op='='>
                  <expression op='[2024 SSD+].[Snapshottime]' />
                  <expression op='[LTI].[Snapshot date]' />
                </expression>
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='='>
                  <expression op='[2024 SSD+].[HoF code]' />
                  <expression op='[HOF Access Dimension].[HoF code]' />
                </expression>
              </clause>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[2024 SSD+].[Currency PM]' />
                      <expression op='[Exchange Rates].[Currency]' />
                    </expression>
                    <expression op='='>
                      <expression op='[2024 SSD+].[Snapshottime]' />
                      <expression op='[Exchange Rates].[Snapshotdate]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='[2024 SSD+].[Workday Id]' />
                        <expression op='[LTI Grants].[Payroll Id]' />
                      </expression>
                      <expression op='='>
                        <expression op='[2024 SSD+].[Snapshottime]' />
                        <expression op='[LTI Grants].[Snapshot date]' />
                      </expression>
                    </expression>
                  </clause>
                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='AND'>
                        <expression op='='>
                          <expression op='[2024 SSD+].[Location Mapping]+[2024 SSD+].[Currency PM]&#13;&#10;+If(CONTAINS([Role Catalogue+].[Band code],&quot;AAI&quot;)=True or CONTAINS([Role Catalogue+].[Band code],&quot;VAI&quot;)) then &quot;SSC&quot; else [Role Catalogue+].[Band code] END&#13;&#10;+If([2024 SSD+].[Location Mapping]=&quot;Egypt&quot; and ([Role Catalogue+].[Band code]=&quot;Tech&quot; or [Role Catalogue+].[Band code]=&quot;Product&quot;) ) then &quot;All&quot; &#13;&#10; else [Role Catalogue+].[Sub-Band code] END&#13;&#10;+[2024 SSD+].[Level code]' />
                          <expression op='[Salary Structure].[Country]+[Salary Structure].[Currency]+[Salary Structure].[Salary Band]+[Salary Structure].[Sub Band]+[Salary Structure].[Level]' />
                        </expression>
                        <expression op='='>
                          <expression op='[2024 SSD+].[Snapshottime]' />
                          <expression op='[Salary Structure].[Snapshot date]' />
                        </expression>
                      </expression>
                    </clause>
                    <relation join='left' type='join'>
                      <clause type='join'>
                        <expression op='AND'>
