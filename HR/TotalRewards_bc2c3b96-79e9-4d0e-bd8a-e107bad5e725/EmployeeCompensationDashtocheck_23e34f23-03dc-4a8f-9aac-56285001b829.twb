            <run bold='true' fontname='Tableau Bold' fontsize='9'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Band Position Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level&quot;'>
              <calculation class='tableau' formula='&quot;Level&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[Snapshottime]' caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='S-1/3' datatype='real' name='[1/3 (copy)_537898747038441475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([1/3],([Mid]+[Min])/2)' />
            </column>
            <column caption='1/3 of Band' datatype='real' name='[1/3]' role='measure' type='quantitative'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='2/3 of Band' datatype='real' name='[2/3]' role='measure' type='quantitative'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='COLA' datatype='real' datatype-customized='true' name='[COLA (Original Value)]' role='measure' type='quantitative' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='Band Position Selector' datatype='string' name='[Calculation_1190357682519244801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Parameters].[Parameter 2]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Parameter 2]= &quot;HOF Segment&quot;) then [HoF Segment]&#13;&#10;ELSEIF ([Parameters].[Parameter 2]= &quot;HR Department&quot;) then [HR Department]&#13;&#10;ELSEIF ([Parameters].[Parameter 2]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Parameter 2]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Parameter 2]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='c.payroll filter' datatype='string' name='[Calculation_1195424228089913349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Staff file #]' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='TCash LC Monthly' datatype='real' name='[Calculation_477381625280163844]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Salary MIS]+[COLA (Original Value)]' />
            </column>
            <column caption='T Cash Position' datatype='string' name='[Calculation_477381625281105926]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If ([Calculation_477381625280163844]&lt;[Min] and [Calculation_908601226238386176]&lt;1) then &quot;Below Min&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[Min] and [Calculation_477381625280163844]&lt;[1/3 (copy)_537898747038441475] and [Calculation_908601226238386176]&lt;1) &#13;&#10;then &quot;Min to 1/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[1/3 (copy)_537898747038441475] and [Calculation_477381625280163844]&lt;[Mid] and [Calculation_908601226238386176]&lt;1)&#13;&#10;then &quot;1/3 to Mid&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]=[Mid] and [Calculation_908601226238386176]=1) then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[Mid] and [Calculation_477381625280163844]&lt;[S-2/3 (copy)_537898747038322690] and [Calculation_908601226238386176]&gt;=1) &#13;&#10;then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[S-2/3 (copy)_537898747038322690] and [Calculation_477381625280163844]&lt;=[Max]and [Calculation_908601226238386176]&gt;1)&#13;&#10;then &quot;2/3 to Max&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;[Max] and [Calculation_908601226238386176]&gt;1) then &quot;Above Max&quot;&#13;&#10;Else &quot;--&quot; END' />
            </column>
            <column caption='T Cash Comp Ratio' datatype='real' name='[Calculation_908601226238386176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Segment]&lt;&gt;&quot;management&quot;) then [Calculation_477381625280163844]/[Mid] END' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
