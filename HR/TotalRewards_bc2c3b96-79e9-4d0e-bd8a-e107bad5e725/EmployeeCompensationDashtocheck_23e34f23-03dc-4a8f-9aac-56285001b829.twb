            </column>
            <column datatype='string' name='[Level code]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[Location Mapping (copy)_1372190511806988289]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='[Location Mapping]' />
            </column>
            <column datatype='string' name='[Location Mapping]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='integer' name='[Mid (LTI)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Rating]' role='dimension' type='nominal' />
            <column datatype='string' name='[Salary Band]' role='dimension' type='nominal'>
              <aliases>
