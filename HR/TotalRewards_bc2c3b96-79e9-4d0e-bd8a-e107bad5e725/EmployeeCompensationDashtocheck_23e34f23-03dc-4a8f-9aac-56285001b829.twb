            <column datatype='string' name='[Salary Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='Salary' datatype='real' name='[Salary MIS]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='Payroll-ID' datatype='string' name='[Staff file #]' role='dimension' type='nominal' />
            <column caption='TComp Comp Range' datatype='string' name='[T Cash Comp Range (copy)_960955577882710016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_1110418789068595205]&lt;0.8 then &quot;&lt;0.8&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.8 and [Calculation_1110418789068595205]&lt;0.9 then &quot;0.80 - 0.90&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.90 and [Calculation_1110418789068595205]&lt;0.95 then &quot;0.90 - 0.95&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.95 and [Calculation_1110418789068595205]&lt;1.05 then &quot;0.95 - 1.05&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=1.05 and [Calculation_1110418789068595205]&lt;1.1 then &quot;1.05 - 1.1&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=1.1 and [Calculation_1110418789068595205]&lt;=1.25 then &quot;1.1 - 1.25&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;1.25 then &quot;&gt;1.25&quot;&#13;&#10;&#13;&#10;Else &quot;--&quot;&#13;&#10;END' />
            </column>
            <column caption='T Comp Mid' datatype='real' name='[T Comp Min (copy) (copy)_1110418789067063298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Mid]*[Currency to EUR]*12)+([Mid]*[Calculation_309622480074321921]*[Currency to EUR]*12)+ZN([Mid (LTI)])' />
            </column>
