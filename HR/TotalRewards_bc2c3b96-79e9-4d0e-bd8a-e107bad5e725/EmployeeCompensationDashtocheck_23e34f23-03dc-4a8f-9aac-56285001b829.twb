      </column>
      <column caption='Additional-Allowance' datatype='integer' name='[Additional Allowance (copy)_1018939421021601802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Additional Allowance],0)' />
      </column>
      <column datatype='integer' name='[Additional Allowance]' role='measure' type='quantitative' />
      <column caption='Monthly T Cash €' datatype='real' name='[Annual TCash (Euro) (copy)_1111263208087601154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_477381625280163844]*[Currency to EUR]' />
      </column>
      <column caption='T Comp € Annual' datatype='real' name='[Annual TCash € (copy)_309622480075853827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_477381625280163844]*[Currency to EUR]*12)+([Bonus Amount (copy)_1271985428215484438])+ZN([LTI Grant]+[Calculation_444730524070252546])' />
      </column>
      <column caption='Headcounts (New Hire Only)' datatype='integer' name='[Avg. TCash LC (New Hire Only) Monthly (copy)_671599308513099776]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CountD(IF Year([Hired date])=Year(Today()) then [Staff file #] END)' />
        <aliases>
          <alias key='%null%' value='--' />
        </aliases>
      </column>
      <column caption='Comp Ratio Selector' datatype='string' name='[Band Position Selector (copy)_1190357682630041605]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HOF Segment&quot;) then [HoF Segment]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HR department&quot;) then [HR Department]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value='Blank' />
        </aliases>
      </column>
      <column caption='LTI Band' datatype='string' name='[Band]' role='dimension' type='nominal'>
        <aliases>
