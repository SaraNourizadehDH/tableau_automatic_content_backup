                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>1.05-1.1:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 1.05 or more but less than 1.1</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> 1.1 - 1.25:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>At 1.1 or more but less than or at 1.25</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>&gt; 1.25:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>Comp Ratio is more than 1.25</run>
