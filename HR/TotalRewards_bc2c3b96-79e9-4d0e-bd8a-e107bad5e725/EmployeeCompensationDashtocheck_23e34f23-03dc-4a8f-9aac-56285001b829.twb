            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>Total Cash (TCash)</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>:</run>
                <run fontcolor='#000000' fontsize='9'> It&apos;s the sum of the salary and the Cost of Living Allowance &quot;COLA&quot; (Egypt Only).</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Total Cash</run>
                <run fontcolor='#000000' fontsize='9'> does not include any additional business or role allowances.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>LTI Grant:</run>
                <run fontcolor='#000000' fontsize='9'> The annual LTIP grant amount for eligible employees</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Total Compensation (Total Comp):</run>
                <run fontcolor='#000000' fontsize='9'> This includes both guaranteed and variable components of the employees’ compensation</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Total Comp</run>
                <run fontcolor='#000000' fontsize='9'> = (Salary+Cola)/Total Cash + Incentive/Bonus +LTIP</run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
