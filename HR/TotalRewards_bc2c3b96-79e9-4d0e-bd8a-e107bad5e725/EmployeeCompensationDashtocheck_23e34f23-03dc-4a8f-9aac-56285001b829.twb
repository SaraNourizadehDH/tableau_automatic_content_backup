    <worksheet name='TComp Comp Ratio Overall'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>TComp CR - All Employees</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[Snapshottime]' caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='T Comp € Annual' datatype='real' name='[Annual TCash € (copy)_309622480075853827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_477381625280163844]*[Currency to EUR]*12)+([Bonus Amount (copy)_1271985428215484438])+ZN([LTI Grant]+[Calculation_444730524070252546])' />
            </column>
            <column caption='Target Bonus €' datatype='real' name='[Bonus Amount (copy)_1271985428215484438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Bonus/Incentive Target Amt Currency]=&quot;Eur&quot; then [Calculation_309622480060964864] else [Calculation_309622480060964864]*[Currency to EUR] END' />
            </column>
            <column datatype='integer' name='[Bonus/Incentive Target %]' role='measure' type='quantitative' />
            <column datatype='string' name='[Bonus/Incentive Target Amt Currency]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Bonus/Incentive Target amount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Bonus/Incentive Type]' role='dimension' type='nominal' />
            <column caption='COLA' datatype='real' datatype-customized='true' name='[COLA (Original Value)]' role='measure' type='quantitative' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='TComp Comp Ratio' datatype='real' name='[Calculation_1110418789068595205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If ([Segment]&lt;&gt;&quot;management&quot;) then [Annual TCash € (copy)_309622480075853827]/[T Comp Min (copy) (copy)_1110418789067063298] END' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='c.payroll filter' datatype='string' name='[Calculation_1195424228089913349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Staff file #]' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Head-counts' datatype='integer' name='[Calculation_1372190511806812160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([Staff file #])' />
            </column>
            <column caption='Bonus Amount' datatype='real' name='[Calculation_309622480060964864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Bonus/Incentive Type]=&quot;% of Base&quot;) then (([Bonus/Incentive Target %])/100)*([Salary MIS]*12)&#13;&#10;ELSEIF ([Bonus/Incentive Type]=&quot;Amount&quot; And [Segment]&lt;&gt;&quot;Management&quot;) then ([Bonus/Incentive Target amount])*12&#13;&#10;ELSEIF ([Bonus/Incentive Type]=&quot;Amount&quot; And [Segment]=&quot;Management&quot;) then ([Bonus/Incentive Target amount])&#13;&#10;else 0 END' />
            </column>
            <column caption='Target Bonus %' datatype='real' name='[Calculation_309622480074321921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_309622480060964864]/([Salary MIS]*12)' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='Hero Grant Executive' datatype='integer' name='[Calculation_444730524070252546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='TCash LC Monthly' datatype='real' name='[Calculation_477381625280163844]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Salary MIS]+[COLA (Original Value)]' />
            </column>
            <column datatype='real' name='[Currency to EUR]' role='measure' type='quantitative' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Sub-department]' role='dimension' type='nominal' />
            <column datatype='date' name='[Hired date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[HoF Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code (HOF Access Dimension)]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='quantitative'>
              <aliases>
