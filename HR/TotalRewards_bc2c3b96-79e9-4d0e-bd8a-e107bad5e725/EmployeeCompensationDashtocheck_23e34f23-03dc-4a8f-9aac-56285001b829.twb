            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='Payroll-ID' datatype='string' name='[Staff file #]' role='dimension' type='nominal' />
            <column caption='Avg. LTI (New Hire Only) Grant' datatype='real' default-format='n#,##0;-#,##0' name='[TCash LC (New Hire Only) Monthly (copy)_1619888503660531713]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ZN(Sum(IF Year([Hired date])=Year(Today()) then [LTI Grant] END)/[Headcounts (New Hire Only) (copy)_845550844550483968])' />
