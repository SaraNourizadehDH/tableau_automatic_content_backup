              </aliases>
            </column>
            <column caption='3/4 (LTI)' datatype='real' name='[3/4]' role='measure' type='quantitative' />
            <column caption='T Comp € Annual' datatype='real' name='[Annual TCash € (copy)_309622480075853827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_477381625280163844]*[Currency to EUR]*12)+([Calculation_309622480060964864]*[Currency to EUR])+ZN([LTI Grant])' />
            </column>
            <column caption='LTI Band' datatype='string' name='[Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='-' />
              </aliases>
            </column>
            <column caption='Target Bonus €' datatype='real' name='[Bonus Amount (copy)_1271985428215484438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_309622480060964864]*[Currency to EUR]' />
            </column>
            <column datatype='integer' name='[Bonus/Incentive Target %]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Bonus/Incentive Target amount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Bonus/Incentive Type]' role='dimension' type='nominal' />
            <column caption='Bonus Plan' datatype='string' name='[Bonus/Incentives Plan (AX &amp; Rewards only) (copy)_1271985428212322323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Bonus/Incentives Plan (AX &amp; Rewards only)]' />
            </column>
            <column datatype='string' name='[Bonus/Incentives Plan (AX &amp; Rewards only)]' role='dimension' type='nominal' />
            <column caption='COLA' datatype='real' name='[COLA (Original Value)]' role='dimension' type='ordinal' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='Empty' datatype='string' name='[Calculation_1018939420993441799]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot; &quot;' />
            </column>
            <column caption='TComp Comp Ratio' datatype='real' name='[Calculation_1110418789068595205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Annual TCash € (copy)_309622480075853827]/[T Comp Min (copy) (copy)_1110418789067063298]' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Bonus Amount' datatype='real' name='[Calculation_309622480060964864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Bonus/Incentive Type]=&quot;% of Base&quot;) then (([Bonus/Incentive Target %])/100)*([Salary MIS]*12)&#13;&#10;ELSEIF ([Bonus/Incentive Type]=&quot;Amount&quot;) then ([Bonus/Incentive Target amount])*12&#13;&#10;else 0 END' />
            </column>
            <column caption='Target Bonus %' datatype='real' name='[Calculation_309622480074321921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_309622480060964864]/([Salary MIS]*12)' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='TCash LC Monthly' datatype='real' name='[Calculation_477381625280163844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Salary MIS]+[COLA (Original Value)]' />
            </column>
            <column caption='T Cash Position' datatype='string' name='[Calculation_477381625281105926]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_477381625280163844]&lt;[Min] then &quot;Below Min&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=Min and [Calculation_477381625280163844]&lt;[1/3 (copy)_537898747038441475] and [Calculation_908601226238386176]&lt;1) &#13;&#10;then &quot;Min to 1/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[1/3 (copy)_537898747038441475] and [Calculation_477381625280163844]&lt;[Mid] and [Calculation_908601226238386176]&lt;1)&#13;&#10;then &quot;1/3 to Mid&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]=Mid and [Calculation_908601226238386176]=1) then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=Mid and [Calculation_477381625280163844]&lt;[S-2/3 (copy)_537898747038322690] and [Calculation_908601226238386176]&gt;=1) &#13;&#10;then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[S-2/3 (copy)_537898747038322690] and [Calculation_477381625280163844]&lt;=[Max]and [Calculation_908601226238386176]&gt;1)&#13;&#10;then &quot;2/3 to Max&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;Max and [Calculation_908601226238386176]&gt;1) then &quot;Above Max&quot;&#13;&#10;Else &quot;--&quot; END' />
            </column>
            <column caption='2023- EOY Performance' datatype='string' name='[Calculation_671599308553383937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1018939420960710658]' />
            </column>
            <column caption='T Cash € Annual' datatype='real' name='[Calculation_898749668267847682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_477381625280163844]*[Currency to EUR]*12' />
            </column>
            <column caption='T Cash Comp Ratio' datatype='real' name='[Calculation_908601226238386176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_477381625280163844]/[Mid]' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Currency PM]' role='dimension' type='nominal' />
            <column datatype='real' name='[Currency to EUR]' role='measure' type='quantitative' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column caption='HR-Department' datatype='string' name='[HR Department (copy)_1271985428209913871]' role='dimension' type='nominal'>
