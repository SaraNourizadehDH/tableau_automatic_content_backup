            </column>
            <column caption='LTI Position' datatype='string' name='[T Cash Position (copy)_690739600549457920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Head Counts LTI (copy)_690739600553603073]=True) then &#13;&#10;If [LTI Grant]&lt;[Min (LTI)] then &quot;Below Min&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[Min (LTI)] and [LTI Grant]&lt;[1/4] and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1) &#13;&#10;then &quot;Min to 1/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[1/4] and [LTI Grant]&lt;[Mid (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1)&#13;&#10;then &quot;1/4 to Mid&quot;&#13;&#10;ELSEIF ([LTI Grant]=[Mid (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]=1) then &quot;Mid to 3/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[Mid (LTI)] and [LTI Grant]&lt;[3/4] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1) &#13;&#10;then &quot;Mid to 3/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[3/4] and [LTI Grant]&lt;=[Max (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1)&#13;&#10;then &quot;3/4 to Max&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;[Max (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1) then &quot;Above Max&quot;&#13;&#10;Else &quot;--&quot; END&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='-' />
              </aliases>
