                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='AND'>
                        <expression op='='>
                          <expression op='[2024 SSD+].[Location Mapping]+[2024 SSD+].[Currency PM]&#13;&#10;+If(CONTAINS([Role Catalogue+].[Band code],&quot;AAI&quot;)=True or CONTAINS([Role Catalogue+].[Band code],&quot;VAI&quot;)) then &quot;SSC&quot; else [Role Catalogue+].[Band code] END&#13;&#10;+If([2024 SSD+].[Location Mapping]=&quot;Egypt&quot; and ([Role Catalogue+].[Band code]=&quot;Tech&quot; or [Role Catalogue+].[Band code]=&quot;Product&quot;) ) then &quot;All&quot; &#13;&#10;ELSEIF  ([2024 SSD+].[Location Mapping]=&quot;UAE&quot; and [Role Catalogue+].[Band code]=&quot;Tech&quot; and [Role Catalogue+].[Sub-Band code]=&quot;Testing&quot;) &#13;&#10;then &quot;Testing/ Systems&quot; else [Role Catalogue+].[Sub-Band code] END&#13;&#10;+[2024 SSD+].[Level code]' />
