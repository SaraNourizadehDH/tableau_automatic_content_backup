      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='S-1/3' datatype='real' name='[1/3 (copy)_537898747038441475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([1/3],([Mid]+[Min])/2)' />
            </column>
            <column caption='1/3 of Band' datatype='real' name='[1/3]' role='measure' type='quantitative'>
              <aliases>
