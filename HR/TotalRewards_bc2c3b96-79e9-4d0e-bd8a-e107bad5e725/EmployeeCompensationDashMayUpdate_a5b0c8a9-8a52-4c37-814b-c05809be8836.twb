            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column caption='Sub-department' datatype='string' name='[HR Sub-department (copy)_1271985428210020368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[HR Sub-department]' />
