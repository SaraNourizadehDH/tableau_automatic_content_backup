    <worksheet name='LTI Comp Ratio by Parameter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>LTI CR Components by &lt;</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>[Parameters].[Band Position Parameter (copy)_1190357682639810566]</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comp Ratio Parameter' datatype='string' name='[Band Position Parameter (copy)_1190357682639810566]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level&quot;'>
              <calculation class='tableau' formula='&quot;Level&quot;' />
            </column>
            <column caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='Comp Ratio Selector' datatype='string' name='[Band Position Selector (copy)_1190357682630041605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HOF&quot;) then [HoF code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HR department&quot;) then [HR Department]&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='Blank' />
              </aliases>
            </column>
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='LTI Comp Range' datatype='string' name='[Calculation_1788773495317737473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.5 then &quot;&lt;0.5&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.5 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.8 then &quot;0.5 - 0.8&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.80 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;0.95 then &quot;0.8 - 0.95&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=0.95 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1.05 then &quot;0.95 - 1.05&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1.05 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1.2 then &quot;1.05 - 1.2&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1.20 and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;=1.50 then &quot;1.2 - 1.5&quot;&#13;&#10;&#13;&#10;ELSEIF  [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1.50 then &quot;&gt;1.5&quot;&#13;&#10;&#13;&#10;Else &quot;--&quot;&#13;&#10;END' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='LTI Head-counts' datatype='integer' name='[Calculation_982910624073793536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If((Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;)or [LTI Grant]&gt;0) &#13;&#10;then 1 Else 0 End' />
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Sub-department]' role='dimension' type='nominal' />
            <column caption='LTI Elgibility' datatype='boolean' name='[Head Counts LTI (copy)_690739600553603073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If(Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;) then True Else False End' />
            </column>
            <column datatype='date' name='[Hired date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[HoF Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code (HOF Access Dimension)]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='quantitative'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column datatype='string' name='[Level code]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[Location Mapping (copy)_1372190511806988289]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='[Location Mapping]' />
            </column>
            <column datatype='string' name='[Location Mapping]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='integer' name='[Mid (LTI)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Rating]' role='dimension' type='nominal' />
            <column datatype='string' name='[Salary Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='LTI Comp Ratio' datatype='real' name='[T Cash Comp Ratio (copy)_1142506933305077766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LTI Grant]/[Mid (LTI)]' />
            </column>
            <column-instance column='[Band Position Selector (copy)_1190357682630041605]' derivation='None' name='[none:Band Position Selector (copy)_1190357682630041605:nk]' pivot='key' type='nominal' />
