      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[Snapshottime]' caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-09-01#'>
              <calculation class='tableau' formula='#2025-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='1/4 (LTI)' datatype='real' name='[1/4]' role='measure' type='quantitative' />
            <column caption='3/4 (LTI)' datatype='real' name='[3/4]' role='measure' type='quantitative' />
            <column caption='LTI Band' datatype='string' name='[Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='-' />
              </aliases>
            </column>
            <column datatype='string' name='[Business Title]' role='dimension' type='nominal' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='Empty' datatype='string' name='[Calculation_1018939420993441799]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot; &quot;' />
            </column>
            <column caption='c.payroll filter' datatype='string' name='[Calculation_1195424228089913349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Staff file #]' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='c. UAE local exclusion' datatype='string' name='[Calculation_1945625441673515009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;([Country/region (nation)]=&apos;ARE&apos; and [Location Mapping]=&apos;UAE&apos;)&#10;&#10;THEN &quot;Exclude UAE National&quot;&#10;elseif&#10;( LOWER([Business Title]) IN (&#10;    &quot;government relations officer&quot;,&#10;    &quot;public relations officer&quot;,&#10;    &quot;sr. public relations officer&quot;,&#10;    &quot;supervisor government relations officer&quot;,&#10;    &quot;supervisor public relations officer&quot;,&#10;    &quot;executive assistant&quot;,&#10;    &quot;lead executive assistant&quot;,&#10;    &quot;assistant manager government relations&quot;&#10;))&#10;then &#10;&quot;Exclude Other - roles&quot;&#10;ELSE&#10;&quot;Exclude All other employees&quot;&#10;END' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If &#10;([Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) )&#10;or&#10;CONTAINS([Salary Band],&quot;Agents&quot;)&#10;then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='LTI Currency' datatype='string' name='[Calculation_845550844551131137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='LTI Head-counts' datatype='integer' name='[Calculation_982910624073793536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If((Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;)or [LTI Grant]&gt;0) &#13;&#10;then 1 Else 0 End' />
            </column>
            <column datatype='string' name='[Country/region (nation)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' datatype-customized='true' name='[Effective Date (LTI)]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Sub-department]' role='dimension' type='nominal' />
            <column caption='LTI Elgibility' datatype='boolean' name='[Head Counts LTI (copy)_690739600553603073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If(Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;) then True Else False End' />
            </column>
            <column caption='LTI Headcounts (New Hire Only)' datatype='integer' name='[Headcounts (New Hire Only) (copy)_845550844550483968]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COuntD(IF (Year([Hired date])=Year(Today()) and [Head Counts LTI (copy)_690739600553603073]=True) then [Staff file #] END)' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column datatype='date' name='[Hired date]' role='dimension' type='ordinal' />
            <column caption='HoF Segment1' datatype='string' name='[HoF Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code (2025 HOF Access Dimension)]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='ordinal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='Level filter for Peer overview' datatype='string' name='[Level code (copy)_1788773495316205568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Level code]' />
            </column>
            <column datatype='string' name='[Level code]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[Location Mapping (copy)_1372190511806988289]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
