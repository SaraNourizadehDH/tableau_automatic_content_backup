                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>Min to 1/3:</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> At Min or greater but less than 1/3 
</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>1/3 to Mid:</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> At 1/3 or greater but less than Mid
</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>Mid to 2/3:</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> At Mid or greater but less than 2/3 
</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>2/3 to Max:</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> At 2/3 or greater but less than or At Max of Band
</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>Above Max:</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'> Greater than Max of the Band</run>
              </formatted-text>
            </customized-tooltip>
