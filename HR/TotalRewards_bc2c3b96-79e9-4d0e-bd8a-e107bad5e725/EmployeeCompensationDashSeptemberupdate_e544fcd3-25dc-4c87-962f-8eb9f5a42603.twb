      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comp Ratio Parameter' datatype='string' name='[Band Position Parameter (copy)_1190357682639810566]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level&quot;'>
              <calculation class='tableau' formula='&quot;Level&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[Snapshottime]' caption='Selected Quarter' datatype='date' datatype-customized='true' default-format='*&quot;Q&quot;Q-YYYY' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='#2025-09-01#'>
              <calculation class='tableau' formula='#2025-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='Comp Ratio Selector' datatype='string' name='[Band Position Selector (copy)_1190357682630041605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HOF Segment&quot;) then [HoF Segment]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HR department&quot;) then [HR Department]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='Blank' />
              </aliases>
            </column>
            <column datatype='string' name='[Business Title]' role='dimension' type='nominal' />
            <column caption='COLA' datatype='real' datatype-customized='true' name='[COLA (Original Value)]' role='measure' type='quantitative' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;0&quot;)' />
            </column>
            <column caption='T Cash Comp Range' datatype='string' name='[Calculation_1190357682573127684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_908601226238386176]&lt;0.8 then &quot;&lt;0.8&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;=0.8 and [Calculation_908601226238386176]&lt;0.9 then &quot;0.80 - 0.90&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;=0.90 and [Calculation_908601226238386176]&lt;0.95 then &quot;0.90 - 0.95&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;=0.95 and [Calculation_908601226238386176]&lt;1.05 then &quot;0.95 - 1.05&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;=1.05 and [Calculation_908601226238386176]&lt;1.1 then &quot;1.05 - 1.1&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;=1.1 and [Calculation_908601226238386176]&lt;=1.25 then &quot;1.1 - 1.25&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_908601226238386176]&gt;1.25 then &quot;&gt;1.25&quot;&#13;&#10;&#13;&#10;Else &quot;--&quot;&#13;&#10;END' />
            </column>
            <column caption='c.payroll filter' datatype='string' name='[Calculation_1195424228089913349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Staff file #]' />
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_1226949449617006593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Snapshottime]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Head-counts' datatype='integer' name='[Calculation_1372190511806812160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([Staff file #])' />
            </column>
            <column caption='c. UAE local exclusion' datatype='string' name='[Calculation_1945625441673515009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;([Country/region (nation)]=&apos;ARE&apos; and [Location Mapping]=&apos;UAE&apos;)&#10;&#10;THEN &quot;Exclude UAE National&quot;&#10;elseif&#10;( LOWER([Business Title]) IN (&#10;    &quot;government relations officer&quot;,&#10;    &quot;public relations officer&quot;,&#10;    &quot;sr. public relations officer&quot;,&#10;    &quot;supervisor government relations officer&quot;,&#10;    &quot;supervisor public relations officer&quot;,&#10;    &quot;executive assistant&quot;,&#10;    &quot;lead executive assistant&quot;,&#10;    &quot;assistant manager government relations&quot;&#10;))&#10;then &#10;&quot;Exclude Other - roles&quot;&#10;ELSE&#10;&quot;Exclude All other employees&quot;&#10;END' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If &#10;([Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) )&#10;or&#10;CONTAINS([Salary Band],&quot;Agents&quot;)&#10;then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='TCash LC Monthly' datatype='integer' name='[Calculation_477381625280163844]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CEILING([Salary MIS]+[COLA (Original Value)])' />
            </column>
            <column caption='T Cash Comp Ratio' datatype='real' name='[Calculation_908601226238386176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Segment]&lt;&gt;&quot;management&quot;) then [Calculation_477381625280163844]/[Mid] &#10; END' />
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
