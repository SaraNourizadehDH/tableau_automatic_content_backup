      <datasource-dependencies datasource='Parameters'>
        <column caption='Chart Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Band Positioning&quot;'>
          <calculation class='tableau' formula='&quot;Band Positioning&quot;' />
          <members>
            <member value='&quot;Band Positioning&quot;' />
            <member value='&quot;Comp Ratio&quot;' />
