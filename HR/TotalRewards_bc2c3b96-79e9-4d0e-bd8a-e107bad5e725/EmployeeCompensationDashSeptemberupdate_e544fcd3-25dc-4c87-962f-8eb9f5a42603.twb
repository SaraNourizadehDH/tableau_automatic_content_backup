            </column>
            <column caption='c.SSD-check' datatype='string' name='[Calculation_1374794207259697154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Location Mapping]+[Currency PM]&#10;+If(CONTAINS([Band code],&quot;AAI&quot;)=True or CONTAINS([Band code],&quot;VAI&quot;)) then &quot;SSC&quot; else [Band code] END&#10;+If([Location Mapping]=&quot;Egypt&quot; and ([Band code]=&quot;Tech&quot; or [Band code]=&quot;Product&quot;) ) then &quot;All&quot;&#10; else [Sub-Band code] END&#10;+[Level code]' />
            </column>
            <column caption='c.sal bands-check' datatype='string' name='[Calculation_1374794207262130179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Country]+[Currency]+[Salary Band]+[Sub Band]+[Level]' />
            </column>
            <column caption='c. UAE local exclusion' datatype='string' name='[Calculation_1945625441673515009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;([Country/region (nation)]=&apos;ARE&apos; and [Location Mapping]=&apos;UAE&apos;)&#10;&#10;THEN &quot;Exclude UAE National&quot;&#10;elseif&#10;( LOWER([Business Title]) IN (&#10;    &quot;government relations officer&quot;,&#10;    &quot;public relations officer&quot;,&#10;    &quot;sr. public relations officer&quot;,&#10;    &quot;supervisor government relations officer&quot;,&#10;    &quot;supervisor public relations officer&quot;,&#10;    &quot;executive assistant&quot;,&#10;    &quot;lead executive assistant&quot;,&#10;    &quot;assistant manager government relations&quot;&#10;))&#10;then &#10;&quot;Exclude Other - roles&quot;&#10;ELSE&#10;&quot;Exclude All other employees&quot;&#10;END' />
            </column>
            <column caption='c.QC-user-filter' datatype='string' name='[Calculation_2871185552573255680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if USERNAME()=&apos;kaavya.prakash@talabat.com&apos; or  USERNAME()=&apos;diana.mohammad@talabat.com&apos;&#10;THEN&#10;&quot;include&quot;&#10;else &quot;exc&quot;&#10;END' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If &#10;([Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) )&#10;or&#10;CONTAINS([Salary Band],&quot;Agents&quot;)&#10;then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='TCash LC Monthly' datatype='integer' name='[Calculation_477381625280163844]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CEILING([Salary MIS]+[COLA (Original Value)])' />
            </column>
            <column caption='T Cash Position' datatype='string' name='[Calculation_477381625281105926]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If ([Calculation_477381625280163844]&lt;[Min] and [Calculation_908601226238386176]&lt;1) then &quot;Below Min&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[Min] and [Calculation_477381625280163844]&lt;[1/3 (copy)_537898747038441475] and [Calculation_908601226238386176]&lt;1) &#13;&#10;then &quot;Min to 1/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[1/3 (copy)_537898747038441475] and [Calculation_477381625280163844]&lt;[Mid] and [Calculation_908601226238386176]&lt;1)&#13;&#10;then &quot;1/3 to Mid&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]=[Mid] and [Calculation_908601226238386176]=1) then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[Mid] and [Calculation_477381625280163844]&lt;[S-2/3 (copy)_537898747038322690] and [Calculation_908601226238386176]&gt;=1) &#13;&#10;then &quot;Mid to 2/3&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;=[S-2/3 (copy)_537898747038322690] and [Calculation_477381625280163844]&lt;=[Max]and [Calculation_908601226238386176]&gt;1)&#13;&#10;then &quot;2/3 to Max&quot;&#13;&#10;ELSEIF ([Calculation_477381625280163844]&gt;[Max] and [Calculation_908601226238386176]&gt;1) then &quot;Above Max&quot;&#13;&#10;Else &quot;--&quot; END' />
            </column>
            <column caption='T Cash Comp Ratio' datatype='real' name='[Calculation_908601226238386176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Segment]&lt;&gt;&quot;management&quot;) then [Calculation_477381625280163844]/[Mid] &#10; END' />
              <aliases>
