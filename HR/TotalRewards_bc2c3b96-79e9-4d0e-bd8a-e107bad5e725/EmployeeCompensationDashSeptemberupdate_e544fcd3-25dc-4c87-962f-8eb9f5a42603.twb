                <run bold='true' fontcolor='#000000' fontname='Trebuchet MS' fontsize='9'>&lt;0.8:&#9;</run>
                <run fontcolor='#000000' fontname='Trebuchet MS' fontsize='8'>Comp Ratio less than 0.8</run>
