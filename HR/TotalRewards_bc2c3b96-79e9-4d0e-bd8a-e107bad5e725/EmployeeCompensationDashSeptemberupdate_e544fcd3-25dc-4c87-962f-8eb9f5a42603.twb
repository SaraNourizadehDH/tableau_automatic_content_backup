      <datasource-dependencies datasource='Parameters'>
        <column alias='Country' caption='Overview Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
          <aliases>
            <alias key='&quot;Country&quot;' value='Country' />
          </aliases>
          <members>
            <member alias='Country' value='&quot;Country&quot;' />
            <member value='&quot;Level&quot;' />
