            <column caption='Comp Ratio Selector' datatype='string' name='[Band Position Selector (copy)_1190357682630041605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HOF&quot;) then [HoF code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;END' />
