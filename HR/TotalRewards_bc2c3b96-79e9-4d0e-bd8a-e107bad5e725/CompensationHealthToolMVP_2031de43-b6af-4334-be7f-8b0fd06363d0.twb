    <worksheet name='LTI Band Positioning-New Hires'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>LTI Band Positioning - &lt;</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>[federated.0jogo7t0ocsl3f0zuefzl0ndh5ms].[tyr:Hired date:qk]</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>&gt; New Eligible Hires</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
          </datasources>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='LTI-1/4' datatype='real' name='[1/4]' role='measure' type='quantitative' />
            <column caption='LTI-3/4' datatype='real' name='[3/4]' role='measure' type='quantitative' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;No Rating&quot;)' />
            </column>
            <column caption='Head-counts' datatype='integer' name='[Calculation_1372190511806812160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([Staff file #])' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column caption='LTI Elgibility' datatype='boolean' name='[Head Counts LTI (copy)_690739600553603073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If(Left([Level code],1)&lt;&gt;&quot;S&quot; and [Level code]&lt;&gt;&quot;IC1&quot; and [Level code]&lt;&gt;&quot;IC2&quot; and [Location Mapping (copy)_1372190511806988289]&lt;&gt;&quot;Iraq&quot;) then True Else False End' />
            </column>
            <column datatype='date' name='[Hired date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='quantitative' />
            <column datatype='string' name='[Level code]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[Location Mapping (copy)_1372190511806988289]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='[Location Mapping]' />
            </column>
            <column datatype='string' name='[Location Mapping]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='integer' name='[Max (LTI)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Mid (LTI)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Min (LTI)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Rating]' role='dimension' type='nominal' />
            <column datatype='string' name='[Salary Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='Payroll-ID' datatype='string' name='[Staff file #]' role='dimension' type='nominal' />
            <column caption='LTI Comp Ratio' datatype='real' name='[T Cash Comp Ratio (copy)_1142506933305077766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LTI Grant]/[Mid (LTI)]' />
            </column>
            <column caption='LTI Position' datatype='string' name='[T Cash Position (copy)_690739600549457920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Head Counts LTI (copy)_690739600553603073]=True) then &#13;&#10;If [LTI Grant]&lt;[Min (LTI)] then &quot;Below Min&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[Min (LTI)] and [LTI Grant]&lt;[1/4] and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1) &#13;&#10;then &quot;Min to 1/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[1/4] and [LTI Grant]&lt;[Mid (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&lt;1)&#13;&#10;then &quot;1/4 to Mid&quot;&#13;&#10;ELSEIF ([LTI Grant]=[Mid (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]=1) then &quot;Mid to 3/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[Mid (LTI)] and [LTI Grant]&lt;[3/4] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;=1) &#13;&#10;then &quot;Mid to 3/4&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;=[3/4] and [LTI Grant]&lt;=[Max (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1)&#13;&#10;then &quot;3/4 to Max&quot;&#13;&#10;ELSEIF ([LTI Grant]&gt;[Max (LTI)] and [T Cash Comp Ratio (copy)_1142506933305077766]&gt;1) then &quot;Above Max&quot;&#13;&#10;Else &quot;--&quot; END&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='-' />
              </aliases>
            </column>
            <column datatype='string' name='[Updated - HoF code]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1018939420960710658]' derivation='None' name='[none:Calculation_1018939420960710658:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_360569453308309504]' derivation='None' name='[none:Calculation_360569453308309504:nk]' pivot='key' type='nominal' />
            <column-instance column='[Gender]' derivation='None' name='[none:Gender:nk]' pivot='key' type='nominal' />
