    <worksheet name='TComp Comp Ratio by Parameter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>TComp CR Components by &lt;</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>[Parameters].[Band Position Parameter (copy)_1190357682639810566]</run>
            <run fontcolor='#456b94' fontname='Tableau Bold' fontsize='9'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2024 SSD+ (Multiple Connections)' name='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comp Ratio Parameter' datatype='string' name='[Band Position Parameter (copy)_1190357682639810566]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level&quot;'>
              <calculation class='tableau' formula='&quot;Level&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jogo7t0ocsl3f0zuefzl0ndh5ms'>
            <column caption='T Comp € Annual' datatype='real' name='[Annual TCash € (copy)_309622480075853827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_477381625280163844]*[Currency to EUR]*12)+([Calculation_309622480060964864]*[Currency to EUR])+ZN([LTI Grant])' />
            </column>
            <column caption='Comp Ratio Selector' datatype='string' name='[Band Position Selector (copy)_1190357682630041605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Level&quot;) then [Level code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;HOF&quot;) then [HoF code]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Gender&quot;) Then [Gender]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Country&quot;) then [Location Mapping (copy)_1372190511806988289]&#13;&#10;ELSEIF ([Parameters].[Band Position Parameter (copy)_1190357682639810566]= &quot;Performance&quot;) then [Calculation_1018939420960710658]&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='Blank' />
              </aliases>
            </column>
            <column datatype='integer' name='[Bonus/Incentive Target %]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Bonus/Incentive Target amount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Bonus/Incentive Type]' role='dimension' type='nominal' />
            <column caption='COLA' datatype='real' name='[COLA (Original Value)]' role='measure' type='quantitative' />
            <column caption='Performance' datatype='string' name='[Calculation_1018939420960710658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Rating],&quot;No Rating&quot;)' />
            </column>
            <column caption='TComp Comp Ratio' datatype='real' name='[Calculation_1110418789068595205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Annual TCash € (copy)_309622480075853827]/[T Comp Min (copy) (copy)_1110418789067063298])' />
            </column>
            <column caption='Head-counts' datatype='integer' name='[Calculation_1372190511806812160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD([Staff file #])' />
            </column>
            <column caption='Bonus Amount' datatype='real' name='[Calculation_309622480060964864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If([Bonus/Incentive Type]=&quot;% of Base&quot;) then (([Bonus/Incentive Target %])/100)*([Salary MIS]*12)&#13;&#10;ELSEIF ([Bonus/Incentive Type]=&quot;Amount&quot;) then ([Bonus/Incentive Target amount])*12&#13;&#10;else 0 END' />
            </column>
            <column caption='Target Bonus %' datatype='real' name='[Calculation_309622480074321921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_309622480060964864]/([Salary MIS]*12)' />
            </column>
            <column caption='Office Segment' datatype='string' name='[Calculation_360569453308309504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Segment] in (&quot;Non Office&quot;,&quot;Non Office - Kitchens&quot;,&quot;Non Office - Store Staff&quot;&#13;&#10;,&quot;Office SSC &amp; Dispatch - Agent&quot;) then &quot;Non Head Office Incl Agents&quot; Else &quot;Head Office Excl Agents&quot; END' />
            </column>
            <column caption='TCash LC Monthly' datatype='real' name='[Calculation_477381625280163844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Salary MIS]+[COLA (Original Value)]' />
            </column>
            <column datatype='real' name='[Currency to EUR]' role='measure' type='quantitative' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[HoF code]' role='dimension' type='nominal' />
            <column datatype='real' name='[LTI Grant]' role='measure' type='quantitative' />
            <column datatype='string' name='[Level code]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[Location Mapping (copy)_1372190511806988289]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='[Location Mapping]' />
            </column>
            <column datatype='string' name='[Location Mapping]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='integer' name='[Mid (LTI)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Mid]' role='measure' type='quantitative' />
            <column datatype='string' name='[Rating]' role='dimension' type='nominal' />
            <column datatype='string' name='[Salary Band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='--' />
              </aliases>
            </column>
            <column caption='Salary' datatype='real' name='[Salary MIS]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column datatype='date' name='[Snapshottime]' role='dimension' type='ordinal' />
            <column caption='Payroll-ID' datatype='string' name='[Staff file #]' role='dimension' type='nominal' />
            <column caption='TComp Comp Range' datatype='string' name='[T Cash Comp Range (copy)_960955577882710016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_1110418789068595205]&lt;0.8 then &quot;&lt;0.8&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.8 and [Calculation_1110418789068595205]&lt;0.9 then &quot;0.80 - 0.90&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.90 and [Calculation_1110418789068595205]&lt;0.95 then &quot;0.90 - 0.95&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=0.95 and [Calculation_1110418789068595205]&lt;1.05 then &quot;0.95 - 1.05&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=1.05 and [Calculation_1110418789068595205]&lt;1.1 then &quot;1.05 - 1.1&quot;&#13;&#10;&#13;&#10;ELSEIF  [Calculation_1110418789068595205]&gt;=1.1 and [Calculation_1110418789068595205]&lt;=1.25 then &quot;1.1 - 1.25&quot;&#13;&#10;&#13;&#10;Else &quot;&gt;1.25&quot;&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='T Comp Mid' datatype='real' name='[T Comp Min (copy) (copy)_1110418789067063298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Mid]*[Currency to EUR]*12)+([Mid]*[Calculation_309622480074321921]*[Currency to EUR]*12)+ZN([Mid (LTI)])' />
            </column>
            <column datatype='string' name='[Updated - HoF code]' role='dimension' type='nominal' />
            <column-instance column='[Band Position Selector (copy)_1190357682630041605]' derivation='None' name='[none:Band Position Selector (copy)_1190357682630041605:nk]' pivot='key' type='nominal' />
