            <column-instance column='[Updated - HoF code]' derivation='None' name='[none:Updated - HoF code:nk]' pivot='key' type='nominal' />
            <column-instance column='[Staff file #]' derivation='CountD' name='[pcto:ctd:Staff file #:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
