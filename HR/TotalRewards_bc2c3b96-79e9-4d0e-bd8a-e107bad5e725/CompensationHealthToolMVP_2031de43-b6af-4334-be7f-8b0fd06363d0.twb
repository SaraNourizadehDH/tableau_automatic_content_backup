          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='If([Role Catalogue+].[Band code]&lt;&gt;&quot;Tech&quot; and [Role Catalogue+].[Band code]&lt;&gt;&quot;Product&quot;) then &quot;Non Tech&quot; else [Role Catalogue+].[Band code] end +&#13;&#10;If ([2024 SSD+].[Location Mapping]=&quot;Egypt&quot; or [2024 SSD+].[Location Mapping]=&quot;Iraq&quot; or [2024 SSD+].[Location Mapping]=&quot;Jordan&quot;) then [2024 SSD+].[Location Mapping] else &quot;GCC&quot; END + [2024 SSD+].[Level code]' />
