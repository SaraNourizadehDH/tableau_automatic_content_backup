            <column caption='user_filter' datatype='string' name='[Calculation_1918322393000960000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#10;IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) OR ISMEMBEROF(&apos;Glovo - People Leadership&apos;) THEN 1&#10;&#10;ELSEIF USERNAME() IN (&apos;luka.bertasiute@glovoapp.com&apos;,&apos;federico.aquino@glovoapp.com&apos;, &apos;lucia.lopez@glovoapp.com&apos;) THEN 1&#10;&#10;ELSEIF USERNAME() = &apos;sonia.cabrera@glovoapp.com&apos; THEN &#10;    IF [supervisory_group] = &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;agustina.cavotta@glovoapp.com&apos; THEN &#10;    IF [regions] = &apos;Total SEE&apos; OR [supervisory_group] = &apos;Italy&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() IN (&apos;flor.badalucco@glovoapp.com&apos;, &apos;henri.hebrard@glovoapp.com&apos;) THEN &#10;    IF [regions] = &apos;Total PLECA&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;ginevra.motta@glovoapp.com&apos; THEN &#10;    IF [regions] = &apos;Total Africa&apos; OR [supervisory_group] = &apos;Italy&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() IN (&apos;marta.marinello@glovoapp.com&apos;, &apos;nathalie.gallaztegui@glovoapp.com&apos;) THEN &#10;    IF [supervisory_group] = &apos;Spain&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;alberto.garrido@glovoapp.com&apos; THEN &#10;    IF [supervisory_group] = &apos;Portugal&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;alejandra.verges@glovoapp.com&apos; THEN &#10;    IF [supervisory_group] IN (&apos;Live Operations&apos;, &apos;Logistics&apos;, &apos;Partner Operations&apos;, &apos;Rest of Operations&apos;, &apos;P&amp;B Brand Ads&apos;, &apos;P&amp;B Commercial&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;anna.guzowska@glovoapp.com&apos; THEN &#10;    IF [supervisory_group] IN (&apos;Q Commerce&apos;, &apos;Marketing &amp; Growth&apos;, &apos;On Demand&apos;, &apos;Strategy &amp; New Business&apos;, &apos;Finance&apos;, &apos;Global Affairs&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = &apos;martin.drabble@glovoapp.com&apos; THEN &#10;    IF [supervisory_group] IN (&apos;Engineering&apos;, &apos;Product&apos;, &apos;Data&apos;) THEN 1 ELSE 0 END&#10;&#10;END)' />
            </column>
