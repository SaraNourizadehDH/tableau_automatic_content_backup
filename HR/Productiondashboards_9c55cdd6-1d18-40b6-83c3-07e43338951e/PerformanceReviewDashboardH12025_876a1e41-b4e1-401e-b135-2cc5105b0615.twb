        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1bg42hw1ysyvh318ejerx1dtotlv' name='Custom SQL Query' type='text'><![CDATA[WITH pr_cleaning AS (
    SELECT
        employee_id,
        final_9_box_position_in_manager_task AS final_9box,
        CASE
            WHEN final_9_box_position_in_manager_task IN ('Below Expectations/Role Model', 'Below Expectations/Lives', 'Below Expectations/Does not live', 'Solid Contributor/Does not live', 'Exceeds Expectations/Does not live') THEN 'Low'
            WHEN final_9_box_position_in_manager_task IN ('Solid Contributor/Lives') THEN 'Successful'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Lives', 'Solid Contributor/Role Model') THEN 'High'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Role Model') THEN 'Top'
            ELSE 'No Review'
        END AS final_result,
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN DATE '2023-07-31'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN DATE '2024-02-29'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN DATE '2024-07-31'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN DATE '2025-02-28'
            WHEN review_template = 'Glovo - 2025 (H1) Performance Review' THEN DATE '2025-07-29'
            ELSE NULL
        END report_effective_date, -- New PR Added : Update this column
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN 'H1-23 PR'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN 'H2-23 PR'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN 'H1-24 PR'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN 'H2-24 PR'
            WHEN review_template = 'Glovo - 2025 (H1) Performance Review' THEN 'H1-25 PR'
            ELSE NULL
        END AS simplified_review_template -- New PR Added : Update this column
    FROM people_ops_proposed.il_glovo_performance
    WHERE manager_id IS NOT NULL
),
review_dates AS (
    SELECT
        report_effective_date,
        LAG(report_effective_date) OVER (ORDER BY report_effective_date) AS previous_review_date, -- Get the previous performance review date
        COALESCE(
        LEAD(report_effective_date) OVER (ORDER BY report_effective_date), -- Get the next performance review date
        CAST('2100-01-01' AS DATE)) AS next_review_date -- randomly putting far future data in order to get the current months data in pr_supervisory
    FROM (SELECT DISTINCT report_effective_date
          FROM pr_cleaning)
),
pr_ranking AS (
    SELECT
        pr.employee_id,
        pr.simplified_review_template,
        pr.report_effective_date,
        rd.previous_review_date,
        rd.next_review_date,
        pr.final_9box,
        pr.final_result,
        previous.final_result AS previous_final_result,
        CASE
            WHEN pr.final_result = 'Low' THEN 1
            WHEN pr.final_result = 'Successful' THEN 2
            WHEN pr.final_result = 'High' THEN 3
            WHEN pr.final_result = 'Top' THEN 4
            ELSE NULL
        END AS final_result_rank,
        CASE
            WHEN previous.final_result = 'Low' THEN 1
            WHEN previous.final_result = 'Successful' THEN 2
            WHEN previous.final_result = 'High' THEN 3
            WHEN previous.final_result = 'Top' THEN 4
            ELSE NULL
        END AS previous_final_result_rank -- put ranking to compare the review result with the previous round
    FROM pr_cleaning AS pr
    LEFT JOIN review_dates AS rd ON pr.report_effective_date = rd.report_effective_date
    LEFT JOIN pr_cleaning AS previous ON previous.employee_id = pr.employee_id AND previous.report_effective_date = rd.previous_review_date
),
-- growth data
pnum_changes AS (
    SELECT
        employee_id,
        CONCAT(LAG(position) OVER (PARTITION BY employee_id ORDER BY report_effective_date), ' - ', -- merge position and management level
               LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date)) AS previous_job_profile,
        CONCAT(position, ' - ', management_level) AS proposed_job_profile,
        DATE_TRUNC('month', CAST(report_effective_date AS DATE)) AS change_effective_date, -- change to 1st day of month: to join with il_organisational_change data
        CASE
            WHEN LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) IS NOT NULL
             AND LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> position_id
             AND LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> management_level -- check the previous pnumber & manangement level value, if both changed it is promotion
            THEN 'Promotion'
           WHEN LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) IS NOT NULL
             AND LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> position_id
             AND LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date) = management_level -- if only pnumber changed it is lateral move
            THEN 'Lateral Move'
        END AS event_category
    FROM people_ops_proposed.il_worker_hist_with_current
),
pnum_change_rank AS (
    SELECT
        *
    FROM pnum_changes
    WHERE event_category IS NOT NULL -- select only the growth
),
organizational_changes AS (
    SELECT
        employee_id,
        bp_event_category AS event_category,
        previous_job_profile,
        proposed_job_profile,
        DATE_TRUNC('month', CAST(change_effective_date AS DATE)) AS change_effective_date, -- to join the pnum change CTE data
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY change_effective_date DESC) AS event_rank
    FROM people_ops_proposed.il_organisational_change
    WHERE bp_status = 'Successfully Completed'
    AND bp_event_category IN ('Lateral Move', 'Promotion')
),
final_logic AS (
    SELECT
        COALESCE(oc.employee_id, pcr.employee_id) AS employee_id,
        COALESCE(oc.event_category, pcr.event_category) AS event_category, -- prefer organizational change
        COALESCE(oc.previous_job_profile, pcr.previous_job_profile) AS previous_job_profile,
        COALESCE(oc.proposed_job_profile, pcr.proposed_job_profile) AS proposed_job_profile,
        COALESCE(oc.change_effective_date, pcr.change_effective_date) AS change_effective_date
    FROM pnum_change_rank pcr
    FULL OUTER JOIN organizational_changes oc
        ON pcr.employee_id = oc.employee_id
       AND pcr.change_effective_date = oc.change_effective_date
),
growth_events AS (
    SELECT
        fl.employee_id,
        fl.event_category,
        fl.change_effective_date,
        pr.report_effective_date,
        pr.next_review_date,
        ROW_NUMBER() OVER (PARTITION BY fl.employee_id, pr.report_effective_date, fl.event_category ORDER BY fl.change_effective_date DESC) AS rn
    FROM final_logic fl
    INNER JOIN pr_ranking pr ON fl.employee_id = pr.employee_id
        AND fl.change_effective_date >>= pr.report_effective_date
        AND fl.change_effective_date << pr.next_review_date
),
growth_event_summary AS (
    SELECT
        employee_id,
        report_effective_date,
        CASE WHEN MAX(CASE WHEN event_category = 'Promotion' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No'
        END AS promotion,
        CASE WHEN MAX(CASE WHEN event_category = 'Lateral Move' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No'
        END AS lateral_move,
        MAX(CASE WHEN event_category = 'Promotion' THEN change_effective_date ELSE NULL END) AS promotion_effective_date,
        MAX(CASE WHEN event_category = 'Lateral Move' THEN change_effective_date ELSE NULL END) AS lateral_move_effective_date
    FROM growth_events
    WHERE rn = 1 -- remove duplicated growths: let's select only 1 growth, here the main focus is if the employee had Promotion/LM yes or no. If this employee had 2 lateral move after 1 PR, we check the latest one. If not, in the final table we will have duplicated values
    GROUP BY employee_id, report_effective_date
),
previous_growth_events AS ( -- we also need to check if the employee had growth before the PR result. In the final report, we need this for 'Talent Movement after Promotion or Lateral'
    SELECT
        fl.employee_id,
        fl.event_category,
        fl.change_effective_date,
        pr.report_effective_date,
        pr.previous_review_date,
        ROW_NUMBER() OVER (PARTITION BY fl.employee_id, pr.report_effective_date, fl.event_category ORDER BY fl.change_effective_date DESC) AS rn
    FROM final_logic fl
    INNER JOIN pr_ranking pr ON fl.employee_id = pr.employee_id
        AND fl.change_effective_date >>= pr.previous_review_date
        AND fl.change_effective_date << pr.report_effective_date
),
previous_growth_event_summary AS (
    SELECT
        employee_id,
        report_effective_date,
        CASE WHEN MAX(CASE WHEN event_category = 'Promotion' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No' END AS had_promotion_previous_pr,
        CASE WHEN MAX(CASE WHEN event_category = 'Lateral Move' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No' END AS had_lateral_previous_pr
    FROM previous_growth_events
    WHERE rn = 1
    GROUP BY employee_id, report_effective_date
),
-- current_status?
termination AS (
SELECT t.employee_id,
       t.termination_effective_date
FROM people_ops_proposed.il_termination AS t
),
avg_currency AS (
    SELECT
        source_currency,
        target_currency,
        AVG(currency_exchange_rate) AS average_exchange_currency_rate
    FROM people_ops_proposed.bl_currency_exchange_monthly
    WHERE target_currency = 'EUR'
    GROUP BY source_currency, target_currency
),
salary_hist_in_EUR AS (
    SELECT
    sh.employee_id,
    ROUND(
        CASE
            WHEN sh.salary_currency = 'EUR' THEN sh.salary_amount
            ELSE sh.salary_amount * ac.average_exchange_currency_rate
        END,
        0
    ) AS salary_amount,
    sh.salary_currency,
    sh.report_effective_date
    FROM people_ops_proposed.il_salary_hist_with_current AS sh
    LEFT JOIN avg_currency AS ac ON sh.salary_currency = ac.source_currency
    WHERE sh.salary_amount IS NOT NULL
    AND (sh.job_profile IS NULL
    OR NOT (sh.job_profile LIKE '%Picker%' OR sh.job_profile LIKE '%Agent%' OR sh.job_profile LIKE '%Rider%'))
),
-- salary increase
salary_with_previous AS ( -- get the salary increase data
    SELECT
        sh.employee_id,
        sh.salary_amount,
        sh.report_effective_date AS salary_change_date,
        LAG(sh.salary_amount) OVER (PARTITION BY sh.employee_id ORDER BY sh.report_effective_date) AS previous_salary
    FROM salary_hist_in_EUR AS sh
),
salary_increase AS (
    SELECT
        swp.employee_id,
        DATE_TRUNC('month', CAST(swp.salary_change_date AS DATE)) AS salary_change_date,
        swp.salary_amount,
        swp.previous_salary
    FROM salary_with_previous swp
    WHERE swp.previous_salary IS NOT NULL AND swp.salary_amount >> swp.previous_salary -- select only the report_effective_date with increase
),
final_salary_increase AS (
    SELECT
        pr.employee_id,
        pr.report_effective_date,
        MAX(si.salary_change_date) AS salary_increase_month,
        'Yes' AS salary_increase
    FROM salary_increase AS si
    INNER JOIN pr_ranking pr ON si.employee_id = pr.employee_id
        AND DATE(si.salary_change_date) >>= pr.report_effective_date
        AND DATE(si.salary_change_date) << pr.next_review_date -- select increase employees during PR period
    GROUP BY 1,2
),
worker_hist AS (
   SELECT
    wh.report_effective_date,
    wh.employee_id,
    wp.preferred_full_name AS worker,
    wp.gender,
    wh.business_unit_hierarchy AS department,
    wh.business_unit AS division,
    wh.office_location_country AS country,
    wh.region,
    sm.supervisory_group,
    sm.regions,
    CASE WHEN sm.hq_intl_logic = 'Total International' THEN 'International'
        ELSE 'Global HQ' END AS hq_intl,
    wh.is_manager,
    wh.management_level,
    ROUND(CASE WHEN wh.is_terminated = 0 THEN DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.report_effective_date AS DATE)) / 30.0
         ELSE DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.last_day_of_work AS DATE)) / 30.0 END, 1) AS tenure_by_month,
    CASE
        WHEN DATE(t.termination_effective_date) BETWEEN pr.report_effective_date AND pr.next_review_date THEN 1
        ELSE 0
    END AS is_terminated,
    COALESCE(ge.promotion, 'No') AS promotion,
    COALESCE(ge.lateral_move, 'No') AS lateral_move,
    COALESCE(si.salary_increase, 'No') AS salary_increase,
    CASE WHEN COALESCE(prev_ge.had_promotion_previous_pr, 'No') = 'Yes' OR COALESCE(prev_ge.had_lateral_previous_pr, 'No') = 'Yes' THEN 'Yes'
    ELSE 'No' END AS had_growth_in_previous_pr_period,
    ge.promotion_effective_date,
    ge.lateral_move_effective_date,
    si.salary_increase_month,
    pr.simplified_review_template,
    pr.final_9box,
    pr.final_result,
    pr.previous_final_result,
     CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank >> pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS growth,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank >> pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS growth_details,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank << pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS degrowth,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank << pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS degrowth_details,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank = pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS stagnant,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank = pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS stagnant_details
    FROM people_ops_proposed.il_worker_hist_with_current AS wh
    LEFT JOIN people_ops_proposed.il_worker_personal AS wp ON wh.employee_id = wp.employee_id
    LEFT JOIN pr_ranking AS pr ON pr.employee_id = wh.employee_id AND CAST(wh.report_effective_date AS DATE) = pr.report_effective_date
    LEFT JOIN people_ops_proposed.il_supervisory_mapping_glovo AS sm ON sm.supervisory_org_id = wh.supervisory_org_id
    LEFT JOIN growth_event_summary ge ON ge.employee_id = wh.employee_id AND ge.report_effective_date = pr.report_effective_date
    LEFT JOIN termination t ON t.employee_id = wh.employee_id
    LEFT JOIN final_salary_increase AS si ON si.employee_id = wh.employee_id AND si.report_effective_date = pr.report_effective_date
    LEFT JOIN previous_growth_event_summary prev_ge ON prev_ge.employee_id = wh.employee_id AND prev_ge.report_effective_date = pr.report_effective_date
    WHERE pr.simplified_review_template IS NOT NULL
    AND pr.report_effective_date >>= DATE '2024-07-31' -- let's get the PR data from H1-2024
)

SELECT
    *,
    CASE
        WHEN tenure_by_month << 6 THEN 'Newbies'
        WHEN tenure_by_month >>= 6 AND tenure_by_month << 12 THEN '6 to 12 months'
        WHEN tenure_by_month >>= 12 AND tenure_by_month << 24 THEN '1 to 2 years'
        WHEN tenure_by_month >>= 24 AND tenure_by_month << 36 THEN '2 to 3 years'
        WHEN tenure_by_month >>= 36 AND tenure_by_month << 48 THEN '3 to 4 years'
        WHEN tenure_by_month >>= 48 AND tenure_by_month << 60 THEN '4 to 5 years'
        ELSE '5 years above'
    END AS tenure_group,
    CURRENT_DATE AS update_date
FROM worker_hist]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='athena.1bg42hw1ysyvh318ejerx1dtotlv' name='Custom SQL Query' type='text'><![CDATA[WITH pr_cleaning AS (
    SELECT
        employee_id,
        final_9_box_position_in_manager_task AS final_9box,
        CASE
            WHEN final_9_box_position_in_manager_task IN ('Below Expectations/Role Model', 'Below Expectations/Lives', 'Below Expectations/Does not live', 'Solid Contributor/Does not live', 'Exceeds Expectations/Does not live') THEN 'Low'
            WHEN final_9_box_position_in_manager_task IN ('Solid Contributor/Lives') THEN 'Successful'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Lives', 'Solid Contributor/Role Model') THEN 'High'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Role Model') THEN 'Top'
            ELSE 'No Review'
        END AS final_result,
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN DATE '2023-07-31'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN DATE '2024-02-29'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN DATE '2024-07-31'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN DATE '2025-02-28'
            WHEN review_template = 'Glovo - 2025 (H1) Performance Review' THEN DATE '2025-07-29'
            ELSE NULL
        END report_effective_date, -- New PR Added : Update this column
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN 'H1-23 PR'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN 'H2-23 PR'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN 'H1-24 PR'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN 'H2-24 PR'
            WHEN review_template = 'Glovo - 2025 (H1) Performance Review' THEN 'H1-25 PR'
            ELSE NULL
        END AS simplified_review_template -- New PR Added : Update this column
    FROM people_ops_proposed.il_glovo_performance
    WHERE manager_id IS NOT NULL
),
review_dates AS (
    SELECT
        report_effective_date,
        LAG(report_effective_date) OVER (ORDER BY report_effective_date) AS previous_review_date, -- Get the previous performance review date
        COALESCE(
        LEAD(report_effective_date) OVER (ORDER BY report_effective_date), -- Get the next performance review date
        CAST('2100-01-01' AS DATE)) AS next_review_date -- randomly putting far future data in order to get the current months data in pr_supervisory
    FROM (SELECT DISTINCT report_effective_date
          FROM pr_cleaning)
),
pr_ranking AS (
    SELECT
        pr.employee_id,
        pr.simplified_review_template,
        pr.report_effective_date,
        rd.previous_review_date,
        rd.next_review_date,
        pr.final_9box,
        pr.final_result,
        previous.final_result AS previous_final_result,
        CASE
            WHEN pr.final_result = 'Low' THEN 1
            WHEN pr.final_result = 'Successful' THEN 2
            WHEN pr.final_result = 'High' THEN 3
            WHEN pr.final_result = 'Top' THEN 4
            ELSE NULL
        END AS final_result_rank,
        CASE
            WHEN previous.final_result = 'Low' THEN 1
            WHEN previous.final_result = 'Successful' THEN 2
            WHEN previous.final_result = 'High' THEN 3
            WHEN previous.final_result = 'Top' THEN 4
            ELSE NULL
        END AS previous_final_result_rank -- put ranking to compare the review result with the previous round
    FROM pr_cleaning AS pr
    LEFT JOIN review_dates AS rd ON pr.report_effective_date = rd.report_effective_date
    LEFT JOIN pr_cleaning AS previous ON previous.employee_id = pr.employee_id AND previous.report_effective_date = rd.previous_review_date
),
-- growth data
pnum_changes AS (
    SELECT
        employee_id,
        CONCAT(LAG(position) OVER (PARTITION BY employee_id ORDER BY report_effective_date), ' - ', -- merge position and management level
               LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date)) AS previous_job_profile,
        CONCAT(position, ' - ', management_level) AS proposed_job_profile,
        DATE_TRUNC('month', CAST(report_effective_date AS DATE)) AS change_effective_date, -- change to 1st day of month: to join with il_organisational_change data
        CASE
            WHEN LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) IS NOT NULL
             AND LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> position_id
             AND LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> management_level -- check the previous pnumber & manangement level value, if both changed it is promotion
            THEN 'Promotion'
           WHEN LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) IS NOT NULL
             AND LAG(position_id) OVER (PARTITION BY employee_id ORDER BY report_effective_date) <<>> position_id
             AND LAG(management_level) OVER (PARTITION BY employee_id ORDER BY report_effective_date) = management_level -- if only pnumber changed it is lateral move
            THEN 'Lateral Move'
        END AS event_category
    FROM people_ops_proposed.il_worker_hist_with_current
),
pnum_change_rank AS (
    SELECT
        *
    FROM pnum_changes
    WHERE event_category IS NOT NULL -- select only the growth
),
organizational_changes AS (
    SELECT
        employee_id,
        bp_event_category AS event_category,
        previous_job_profile,
        proposed_job_profile,
        DATE_TRUNC('month', CAST(change_effective_date AS DATE)) AS change_effective_date, -- to join the pnum change CTE data
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY change_effective_date DESC) AS event_rank
    FROM people_ops_proposed.il_organisational_change
    WHERE bp_status = 'Successfully Completed'
    AND bp_event_category IN ('Lateral Move', 'Promotion')
),
final_logic AS (
    SELECT
        COALESCE(oc.employee_id, pcr.employee_id) AS employee_id,
        COALESCE(oc.event_category, pcr.event_category) AS event_category, -- prefer organizational change
        COALESCE(oc.previous_job_profile, pcr.previous_job_profile) AS previous_job_profile,
        COALESCE(oc.proposed_job_profile, pcr.proposed_job_profile) AS proposed_job_profile,
        COALESCE(oc.change_effective_date, pcr.change_effective_date) AS change_effective_date
    FROM pnum_change_rank pcr
    FULL OUTER JOIN organizational_changes oc
        ON pcr.employee_id = oc.employee_id
       AND pcr.change_effective_date = oc.change_effective_date
),
growth_events AS (
    SELECT
        fl.employee_id,
        fl.event_category,
        fl.change_effective_date,
        pr.report_effective_date,
        pr.next_review_date,
        ROW_NUMBER() OVER (PARTITION BY fl.employee_id, pr.report_effective_date, fl.event_category ORDER BY fl.change_effective_date DESC) AS rn
    FROM final_logic fl
    INNER JOIN pr_ranking pr ON fl.employee_id = pr.employee_id
        AND fl.change_effective_date >>= pr.report_effective_date
        AND fl.change_effective_date << pr.next_review_date
),
growth_event_summary AS (
    SELECT
        employee_id,
        report_effective_date,
        CASE WHEN MAX(CASE WHEN event_category = 'Promotion' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No'
        END AS promotion,
        CASE WHEN MAX(CASE WHEN event_category = 'Lateral Move' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No'
        END AS lateral_move,
        MAX(CASE WHEN event_category = 'Promotion' THEN change_effective_date ELSE NULL END) AS promotion_effective_date,
        MAX(CASE WHEN event_category = 'Lateral Move' THEN change_effective_date ELSE NULL END) AS lateral_move_effective_date
    FROM growth_events
    WHERE rn = 1 -- remove duplicated growths: let's select only 1 growth, here the main focus is if the employee had Promotion/LM yes or no. If this employee had 2 lateral move after 1 PR, we check the latest one. If not, in the final table we will have duplicated values
    GROUP BY employee_id, report_effective_date
),
previous_growth_events AS ( -- we also need to check if the employee had growth before the PR result. In the final report, we need this for 'Talent Movement after Promotion or Lateral'
    SELECT
        fl.employee_id,
        fl.event_category,
        fl.change_effective_date,
        pr.report_effective_date,
        pr.previous_review_date,
        ROW_NUMBER() OVER (PARTITION BY fl.employee_id, pr.report_effective_date, fl.event_category ORDER BY fl.change_effective_date DESC) AS rn
    FROM final_logic fl
    INNER JOIN pr_ranking pr ON fl.employee_id = pr.employee_id
        AND fl.change_effective_date >>= pr.previous_review_date
        AND fl.change_effective_date << pr.report_effective_date
),
previous_growth_event_summary AS (
    SELECT
        employee_id,
        report_effective_date,
        CASE WHEN MAX(CASE WHEN event_category = 'Promotion' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No' END AS had_promotion_previous_pr,
        CASE WHEN MAX(CASE WHEN event_category = 'Lateral Move' THEN 1 ELSE 0 END) = 1 THEN 'Yes' ELSE 'No' END AS had_lateral_previous_pr
    FROM previous_growth_events
    WHERE rn = 1
    GROUP BY employee_id, report_effective_date
),
-- current_status?
termination AS (
SELECT t.employee_id,
       t.termination_effective_date
FROM people_ops_proposed.il_termination AS t
),
avg_currency AS (
    SELECT
        source_currency,
        target_currency,
        AVG(currency_exchange_rate) AS average_exchange_currency_rate
    FROM people_ops_proposed.bl_currency_exchange_monthly
    WHERE target_currency = 'EUR'
    GROUP BY source_currency, target_currency
),
salary_hist_in_EUR AS (
    SELECT
    sh.employee_id,
    ROUND(
        CASE
            WHEN sh.salary_currency = 'EUR' THEN sh.salary_amount
            ELSE sh.salary_amount * ac.average_exchange_currency_rate
        END,
        0
    ) AS salary_amount,
    sh.salary_currency,
    sh.report_effective_date
    FROM people_ops_proposed.il_salary_hist_with_current AS sh
    LEFT JOIN avg_currency AS ac ON sh.salary_currency = ac.source_currency
    WHERE sh.salary_amount IS NOT NULL
    AND (sh.job_profile IS NULL
    OR NOT (sh.job_profile LIKE '%Picker%' OR sh.job_profile LIKE '%Agent%' OR sh.job_profile LIKE '%Rider%'))
),
-- salary increase
salary_with_previous AS ( -- get the salary increase data
    SELECT
        sh.employee_id,
        sh.salary_amount,
        sh.report_effective_date AS salary_change_date,
        LAG(sh.salary_amount) OVER (PARTITION BY sh.employee_id ORDER BY sh.report_effective_date) AS previous_salary
    FROM salary_hist_in_EUR AS sh
),
salary_increase AS (
    SELECT
        swp.employee_id,
        DATE_TRUNC('month', CAST(swp.salary_change_date AS DATE)) AS salary_change_date,
        swp.salary_amount,
        swp.previous_salary
    FROM salary_with_previous swp
    WHERE swp.previous_salary IS NOT NULL AND swp.salary_amount >> swp.previous_salary -- select only the report_effective_date with increase
),
final_salary_increase AS (
    SELECT
        pr.employee_id,
        pr.report_effective_date,
        MAX(si.salary_change_date) AS salary_increase_month,
        'Yes' AS salary_increase
    FROM salary_increase AS si
    INNER JOIN pr_ranking pr ON si.employee_id = pr.employee_id
        AND DATE(si.salary_change_date) >>= pr.report_effective_date
        AND DATE(si.salary_change_date) << pr.next_review_date -- select increase employees during PR period
    GROUP BY 1,2
),
worker_hist AS (
   SELECT
    wh.report_effective_date,
    wh.employee_id,
    wp.preferred_full_name AS worker,
    wp.gender,
    wh.business_unit_hierarchy AS department,
    wh.business_unit AS division,
    wh.office_location_country AS country,
    wh.region,
    sm.supervisory_group,
    sm.regions,
    CASE WHEN sm.hq_intl_logic = 'Total International' THEN 'International'
        ELSE 'Global HQ' END AS hq_intl,
    wh.is_manager,
    wh.management_level,
    ROUND(CASE WHEN wh.is_terminated = 0 THEN DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.report_effective_date AS DATE)) / 30.0
         ELSE DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.last_day_of_work AS DATE)) / 30.0 END, 1) AS tenure_by_month,
    CASE
        WHEN DATE(t.termination_effective_date) BETWEEN pr.report_effective_date AND pr.next_review_date THEN 1
        ELSE 0
    END AS is_terminated,
    COALESCE(ge.promotion, 'No') AS promotion,
    COALESCE(ge.lateral_move, 'No') AS lateral_move,
    COALESCE(si.salary_increase, 'No') AS salary_increase,
    CASE WHEN COALESCE(prev_ge.had_promotion_previous_pr, 'No') = 'Yes' OR COALESCE(prev_ge.had_lateral_previous_pr, 'No') = 'Yes' THEN 'Yes'
    ELSE 'No' END AS had_growth_in_previous_pr_period,
    ge.promotion_effective_date,
    ge.lateral_move_effective_date,
    si.salary_increase_month,
    pr.simplified_review_template,
    pr.final_9box,
    pr.final_result,
    pr.previous_final_result,
     CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank >> pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS growth,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank >> pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS growth_details,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank << pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS degrowth,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank << pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS degrowth_details,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank = pr.previous_final_result_rank THEN 'Yes'
        ELSE 'No'
    END AS stagnant,
    CASE
        WHEN pr.previous_final_result IS NOT NULL AND pr.final_result IS NOT NULL AND pr.final_result_rank = pr.previous_final_result_rank THEN CONCAT(pr.previous_final_result, ' to ', pr.final_result)
        ELSE NULL
    END AS stagnant_details
    FROM people_ops_proposed.il_worker_hist_with_current AS wh
    LEFT JOIN people_ops_proposed.il_worker_personal AS wp ON wh.employee_id = wp.employee_id
    LEFT JOIN pr_ranking AS pr ON pr.employee_id = wh.employee_id AND CAST(wh.report_effective_date AS DATE) = pr.report_effective_date
    LEFT JOIN people_ops_proposed.il_supervisory_mapping_glovo AS sm ON sm.supervisory_org_id = wh.supervisory_org_id
    LEFT JOIN growth_event_summary ge ON ge.employee_id = wh.employee_id AND ge.report_effective_date = pr.report_effective_date
    LEFT JOIN termination t ON t.employee_id = wh.employee_id
    LEFT JOIN final_salary_increase AS si ON si.employee_id = wh.employee_id AND si.report_effective_date = pr.report_effective_date
    LEFT JOIN previous_growth_event_summary prev_ge ON prev_ge.employee_id = wh.employee_id AND prev_ge.report_effective_date = pr.report_effective_date
    WHERE pr.simplified_review_template IS NOT NULL
    AND pr.report_effective_date >>= DATE '2024-07-31' -- let's get the PR data from H1-2024
)

SELECT
    *,
    CASE
        WHEN tenure_by_month << 6 THEN 'Newbies'
        WHEN tenure_by_month >>= 6 AND tenure_by_month << 12 THEN '6 to 12 months'
        WHEN tenure_by_month >>= 12 AND tenure_by_month << 24 THEN '1 to 2 years'
        WHEN tenure_by_month >>= 24 AND tenure_by_month << 36 THEN '2 to 3 years'
        WHEN tenure_by_month >>= 36 AND tenure_by_month << 48 THEN '3 to 4 years'
        WHEN tenure_by_month >>= 48 AND tenure_by_month << 60 THEN '4 to 5 years'
        ELSE '5 years above'
    END AS tenure_group,
    CURRENT_DATE AS update_date
FROM worker_hist]]></relation>
          <relation connection='athena.1bg42hw1ysyvh318ejerx1dtotlv' name='Custom SQL Query1' type='text'>SELECT
    employee_id,
    review_template,
    &quot;values&quot;,
    values_manager_rating AS value_rating
FROM people_ops_proposed.il_glovo_performance</relation>
