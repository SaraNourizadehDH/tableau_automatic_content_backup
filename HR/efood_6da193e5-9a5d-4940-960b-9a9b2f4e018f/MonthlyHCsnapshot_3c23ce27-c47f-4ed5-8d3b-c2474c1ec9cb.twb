        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.15nneim09zbxdq12nj4w500v26a7' name='Custom SQL Query1' type='text'>SELECT employee_id AS Employee, manager_01_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
