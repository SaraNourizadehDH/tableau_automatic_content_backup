      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Manager Custon sql' id='_002E87FECE574F5FA501A8437FF435AD'>
            <properties context=''>
              <relation connection='athena.15nneim09zbxdq12nj4w500v26a7' name='Custom SQL Query1' type='text'>SELECT employee_id AS Employee, manager_01_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_02_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_03_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_04_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_05_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_06_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_07_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_08_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_09_full_name AS Managers
FROM people_ops_proposed.il_manager
UNION ALL
SELECT employee_id AS Employee, manager_10_full_name AS Managers
FROM people_ops_proposed.il_manager</relation>
            </properties>
            <properties context='extract'>
              <relation name='_002E87FECE574F5FA501A8437FF435AD' table='[Extract].[_002E87FECE574F5FA501A8437FF435AD]' type='table' />
            </properties>
          </object>
          <object caption='HC,ATTR SQL' id='_4AEB364633A347EC88503C7AF38CF834'>
            <properties context=''>
              <relation connection='athena.15nneim09zbxdq12nj4w500v26a7' name='Custom SQL Query' type='text'><![CDATA[SELECT
    wo.employee_id AS "Employee Id",
    w.work_email AS "Work Email",
     wp.first_name AS "First Name",
    wp.last_name AS "Last Name",
    wp.gender AS "Gender",
    wp.nationality AS "Nationality",
    wp.age as "Age",
    wp.age_group as "Age Group",
    wo.company_id AS "Company Id",
wo.cost_center_id AS "Cost center",
    wo.is_terminated AS "Is Terminated",
    wo.contract_type AS "Contract Type",
    wo.office_location AS "Office Location",
    wo.office_location_country AS "Office Location Country",
       CASE
            WHEN date_diff('month', date(wo.first_day_of_work), current_date) << 3 THEN '<< 3 months'
            WHEN date_diff('month', date(wo.first_day_of_work), current_date) BETWEEN 3 AND 5 THEN '3-6 months'
            WHEN date_diff('month', date(wo.first_day_of_work), current_date) BETWEEN 6 AND 11 THEN '6 months to 1 year'
            WHEN date_diff('year', date(wo.first_day_of_work), current_date) = 1 THEN '1-2 years'
            WHEN date_diff('year', date(wo.first_day_of_work), current_date) = 2 THEN '2-3 years'
            WHEN date_diff('year', date(wo.first_day_of_work), current_date) = 3 THEN '3-4 years'
            ELSE '4+ years'
        END AS tenure_category,

      round(date_diff('year', date(wo.first_day_of_work), current_date)
+ (date_diff('month', date(wo.first_day_of_work), current_date) % 12) / 12.0, 2)
    as tenure,
     wo.department_wd AS "Department Wd",
    wo.sub_department_wd AS "Sub Department Wd",
    wo.management_level AS "Management Level",
    wo.original_first_day_of_work AS "Original First Day Of Work",
    wo.last_day_of_work AS "Last Day Of Work",
    wo.is_people_manager as "Is People Manager",
    w.time_in_company AS "Time In Company",
    w.time_in_management_level AS "Time In Management Level",
  wo.report_effective_date as "Report effective date",
   concat_ws(' ',m.manager_id_01,m.manager_id_02,m.manager_id_03,m.manager_id_04,m.manager_id_05,m.manager_id_06,m.manager_id_07,m.manager_id_08,m.manager_id_09,m.manager_id_10) as "Manager ID concat",
    CONCAT_WS('|',
        m.manager_01_full_name,
        m.manager_02_full_name,
        m.manager_03_full_name,
        m.manager_04_full_name,
        m.manager_05_full_name,
        m.manager_06_full_name,
        m.manager_07_full_name,
        m.manager_08_full_name,
        m.manager_09_full_name,
        m.manager_10_full_name
    ) as "Manager Name concat",
    pr.manager_rating AS "Manager Rating",
    pr.manager_rating_explained AS "Manager Rating Explained",
     pr.review_date AS "Review Date",
    t.termination_category AS "Termination Category",
    t.is_termination_regrettable AS "Is Termination Regrettable",
    t.status AS "Status",
    t.last_day_of_work AS "Last Day Of Work (Il Termination)"
FROM
    people_ops_proposed.il_worker_hist_with_current  wo
left join
people_ops_proposed.il_worker_org  w on wo.employee_id = w.employee_id
LEFT JOIN
    people_ops_proposed.il_manager_hist_with_current  m ON wo.employee_id = m.employee_id and DATE_TRUNC('month', date(wo.report_effective_date))=DATE_TRUNC('month', date(m.report_effective_date))
LEFT JOIN
    people_ops_proposed.il_termination t ON wo.employee_id = t.employee_id
LEFT JOIN
    people_ops_proposed.il_worker_personal wp ON wo.employee_id = wp.employee_id
LEFT JOIN
    people_ops_proposed.il_performance  pr ON date(wo.report_effective_date)  = date(pr.review_date ) and wo.employee_id = pr.employee_id
where

wo.is_terminated = 0 and year(date(wo.report_effective_date))>>=2020

order by date(wo.report_effective_date) desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_4AEB364633A347EC88503C7AF38CF834' table='[Extract].[_4AEB364633A347EC88503C7AF38CF834]' type='table' />
            </properties>
          </object>
          <object caption='il_worker_role_ass' id='il_worker_role_assignment_A1CAAB9F25FA43BE8412CAEC3365FBC0'>
