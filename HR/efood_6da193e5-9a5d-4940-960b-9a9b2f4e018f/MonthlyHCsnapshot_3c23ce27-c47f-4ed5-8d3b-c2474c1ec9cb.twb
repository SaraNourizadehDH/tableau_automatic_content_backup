      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0imcdvb0y5eknz1a0wlu40gi6d8r].[ctd:c.eoly (copy)_152840917877702686:qk]&quot;' value='Active HC' />
          <alias key='&quot;[federated.0imcdvb0y5eknz1a0wlu40gi6d8r].[pcto:ctd:c.eoly (copy)_152840917877702686:qk:11]&quot;' value='% of HC' />
        </aliases>
      </column>
      <column datatype='string' name='[Age Group]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='Blank' />
        </aliases>
      </column>
      <column caption='c.term regrettable' datatype='string' hidden='true' name='[Calculation_1055249712516284444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF int([Is Termination Regrettable])=1&#13;&#10;THEN&#13;&#10;&apos;Regrettable Termination&apos;&#13;&#10;ELSE&#13;&#10;&apos;Non-regrettable Termination&apos;&#13;&#10;END' />
      </column>
      <column caption='c.set container' datatype='integer' hidden='true' name='[Calculation_1073545564265869327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='c.manager filter' datatype='string' name='[Calculation_1247848943976239104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Managers]' />
      </column>
      <column caption='Gender [C]' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [Gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='c.is People manager' datatype='string' name='[Calculation_1684135223009738752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Is People Manager]=&apos;1&apos;&#10;then&#10;&quot;People Manager&quot;&#10;else&#10;&quot;Employee&quot;&#10;end' />
      </column>
      <column caption='c.man/gender' datatype='string' name='[Calculation_1684135223028383747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1&#10;THEN&#10;&quot;All&quot;&#10;ELSE&#10;[Calculation_152840919976341549]&#10;&#10;END' />
      </column>
      <column caption='Sub-department [C]' datatype='string' hidden='true' name='[Calculation_1684135223037825031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF lower([Department Wd]+[Sub Department Wd]) in [Concat Set]&#10;THEN&#10;(if CONTAINS([Sub Department Wd], &apos;SSC&apos;)&#10;THEN&#10;&quot;SSC&quot;&#10;ELSE&#10;[Sub Department Wd]&#10;END)&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
      </column>
      <column caption='c.min date' datatype='boolean' hidden='true' name='[Calculation_2009168384679530503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='year(date([Report effective date]))&gt;=2020' />
      </column>
      <column caption='c.age' datatype='string' hidden='true' name='[Calculation_2009168384793587737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([age])&#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;[age_group]&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value='Unspecified' />
        </aliases>
      </column>
      <column caption='c.tenure calc' datatype='real' hidden='true' name='[Calculation_217298730019471367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2253488692914311170]&lt;0.25&#10;THEN&#10;MAX([Calculation_2253488692914311170],0.25)&#10;ELSEIF [Calculation_2253488692914311170]&lt;0.5&#10;THEN&#10;MAX([Calculation_2253488692914311170],0.5)&#10;ELSEIF [Calculation_2253488692914311170]&lt;1&#10;THEN&#10;MAX([Calculation_2253488692914311170],0.999)&#10;ELSE&#10;FLOOR([Calculation_2253488692914311170])&#10;END' />
      </column>
      <column caption='c.Tenure' datatype='real' hidden='true' name='[Calculation_2253488692914311170]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [c.eoly (copy)_152840917877702686]&lt;&gt;&apos;&apos;&#10;THEN&#10;([Report effective date]-[Original First Day Of Work])/365&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.eolm date' datatype='date' hidden='true' name='[Calculation_2332301658988765210]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-DAY(TODAY())' />
      </column>
      <column caption='c.perf cat' datatype='string' hidden='true' name='[Calculation_4806959350162399232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([review_date])=YEAR([Report effective date]) and [Manager Rating]&gt;=4&#10;THEN&#10;&quot;High performer&quot;&#10;ELSEIF YEAR([review_date])=YEAR([Report effective date]) and [Manager Rating]=3&#10;THEN&#10;&quot;Performer&quot;&#10;ELSEIF YEAR([review_date])=YEAR([Report effective date]) and [Manager Rating]&lt;3&#10;THEN&#10;&quot;Low performer&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.ly' datatype='integer' hidden='true' name='[Calculation_4806959350174502916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Report effective date])-1' />
      </column>
      <column caption='c.man level concat' datatype='string' hidden='true' name='[Calculation_5287225962611048448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([c.eoly (copy)_152840917877702686],&quot;&quot;)+&#10;IFNULL([manager_id_01 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_02 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_03 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_04 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_05 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_06 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_07 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_08 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_09 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_10 (il_manager)],&quot;&quot;)' />
      </column>
      <column caption='Department [C]' datatype='string' name='[Calculation_5287225962611671041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2825&quot;) and [Is Terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2806&quot;) or CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-09-0177&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([Department Wd]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Employee Id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[Employee Id]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
      </column>
      <column caption='c.HR partner+analyst email' datatype='string' name='[Calculation_5677913291123118080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([hr_analyst]+[hr_partner],&apos;;&apos;,char(10))' />
