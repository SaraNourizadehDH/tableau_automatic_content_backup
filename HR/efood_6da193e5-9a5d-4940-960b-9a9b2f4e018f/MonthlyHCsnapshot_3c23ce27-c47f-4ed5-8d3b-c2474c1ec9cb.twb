          </datasources>
          <datasource-dependencies datasource='federated.0imcdvb0y5eknz1a0wlu40gi6d8r'>
            <column caption='c.manager filter' datatype='string' name='[Calculation_1247848943976239104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Managers]' />
            </column>
            <column caption='Gender [C]' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [Gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='c.emp type' datatype='string' name='[Calculation_6532400954603532309]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Contract Type],&quot; (&quot;,1)' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_778982036816297985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Calculation_6532400954603532309],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Contract Type]' role='dimension' type='nominal' />
