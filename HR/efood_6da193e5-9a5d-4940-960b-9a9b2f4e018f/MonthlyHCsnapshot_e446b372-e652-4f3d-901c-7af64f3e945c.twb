      <column caption='Keep Year Selection' datatype='boolean' name='[Calculation_1869556834446450689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;This year&quot; THEN DATEPART(&apos;year&apos;, [Reported Date]) = 2025&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Previous year&quot; THEN DATEPART(&apos;year&apos;, [Reported Date]) = 2024&#13;&#10;ELSE DATEPART(&apos;year&apos;, [Reported Date]) = 2025 OR DATEPART(&apos;year&apos;, [Reported Date]) = 2024&#13;&#10;END' />
      </column>
      <column caption='Year Label' datatype='string' name='[Calculation_1869556834448240643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [Reported Date]))' />
      </column>
