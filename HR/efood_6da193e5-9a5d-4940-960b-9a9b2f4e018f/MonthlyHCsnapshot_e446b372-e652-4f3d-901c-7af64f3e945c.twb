        <calculation class='tableau' formula='if CONTAINS(&quot;sirin.seymen@talabat.com&#10;kaavya.prakash@talabat.com&quot;,USERNAME())&#10;THEN&#10;TRUE&#10;ELSEIF CONTAINS([hr_analyst_email]+[hr_partner_email],USERNAME())&#10;THEN&#10;TRUE&#10;ELSE&#10;FALSE&#10;END' />
      </column>
      <column caption='c.null' datatype='boolean' name='[Calculation_6408622302524149762]' role='dimension' type='nominal'>
