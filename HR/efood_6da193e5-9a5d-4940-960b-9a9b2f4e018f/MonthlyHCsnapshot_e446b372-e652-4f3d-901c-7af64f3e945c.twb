      <aliases enabled='yes' />
      <column datatype='real' hidden='true' name='[% of Accidents with Injuries]' role='measure' type='quantitative' />
      <column caption='Injuries %' datatype='real' name='[Calculation_1869556834506756105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Accidents with Injuries]) / SUM([Accidents Reported])' />
      </column>
      <column caption='Out of' datatype='string' name='[Calculation_1869556834507296778]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(SUM([Accidents with Injuries])) + &quot; out of &quot; + STR(SUM([Accidents Reported]))' />
      </column>
      <column caption='Year Filter Logic' datatype='boolean' name='[Calculation_1869556834512388110]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Current Year&quot; THEN&#13;&#10;    YEAR([Reported Date]) = YEAR(TODAY())&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Previous Year&quot; THEN&#13;&#10;    YEAR([Reported Date]) = YEAR(TODAY()) - 1&#13;&#10;&#13;&#10;ELSE // Both Years&#13;&#10;    YEAR([Reported Date]) = YEAR(TODAY())&#13;&#10;    OR YEAR([Reported Date]) = YEAR(TODAY()) - 1&#13;&#10;END' />
      </column>
      <column datatype='date' name='[Reported Date]' role='dimension' type='ordinal' />
