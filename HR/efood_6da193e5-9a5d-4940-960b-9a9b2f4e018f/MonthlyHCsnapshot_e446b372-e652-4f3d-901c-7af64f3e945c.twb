            <column-instance column='[c.emp cat/sub dept (copy)_6408622302532325391]' derivation='None' name='[none:c.emp cat/sub dept (copy)_6408622302532325391:nk]' pivot='key' type='nominal' />
            <column-instance column='[c.emp cat/sub dept (copy)_6408622302532657169]' derivation='Month-Trunc' name='[tmn:c.emp cat/sub dept (copy)_6408622302532657169:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Full HC (copy)_6408622302542016533]' derivation='User' name='[usr:Full HC (copy)_6408622302542016533:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
