    <worksheet name='EDI-Age'>
      <table>
        <view>
          <datasources>
            <datasource caption='HC, ATTR SQL' name='federated.0imcdvb0y5eknz1a0wlu40gi6d8r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p.off/non' datatype='real' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='3.'>
              <calculation class='tableau' formula='3.' />
              <aliases>
                <alias key='1.' value='Operational worker' />
                <alias key='2.' value='Office' />
                <alias key='3.' value='All' />
                <alias key='4.' value='Riders' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0imcdvb0y5eknz1a0wlu40gi6d8r'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column datatype='string' name='[Brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='Full HC' datatype='integer' name='[Calculation_1110981763362021378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=2 THEN&#10;&#10;COUNTD([c.eoly (copy)_152840917877702686])&#10;&#10;ELSEIF [Parameters].[Parameter 3]=1&#10;THEN&#10;countd([Calculation_210965527087554560])&#10;ELSEIF [Parameters].[Parameter 3]=3&#10;THEN&#10;COUNTD([c.eoly (copy)_152840917877702686])+countd([Calculation_210965527087554560])&#10;end' />
            </column>
            <column aggregation='CountD' caption='c.hc(r&amp;h)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_210965527087554560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;  (ISNULL([Termination Date]) &#13;&#10;   OR DATETRUNC(&apos;month&apos;, DATE([Termination Date])) &gt; DATETRUNC(&apos;month&apos;, DATE([Reported Date])))&#13;&#10;AND&#13;&#10;  DATETRUNC(&apos;month&apos;, DATE([Original Hire Date])) &lt;= DATETRUNC(&apos;month&apos;, DATE([Reported Date]))&#13;&#10;THEN&#13;&#10;  [Employee ID]&#13;&#10;ELSE&#13;&#10;  NULL&#13;&#10;END' />
            </column>
            <column caption='c.emp cat/sub dept (aws/sheets)' datatype='string' name='[Calculation_6408622302530113550]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Employee Category],&quot;&quot;)+IFNULL([Sub Department Wd],&quot;&quot;)' />
            </column>
            <column caption='c.age(sheets)' datatype='integer' name='[Calculation_6408622302546214935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[Date of Birth],TODAY())' />
            </column>
            <column datatype='date' name='[Date of Birth]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Department Wd]' role='dimension' type='nominal' />
            <column datatype='string' name='[Division]' role='dimension' type='nominal' />
            <column datatype='string' name='[Employee Category]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' name='[Employee ID]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' name='[Employee Id]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[Is Terminated]' role='dimension' type='ordinal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[Last Day Of Work (Il Termination)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
            <column datatype='string' name='[Office Location]' role='dimension' type='nominal' />
            <column datatype='string' name='[Organisation]' role='dimension' type='nominal' />
            <column datatype='date' name='[Original Hire Date]' role='dimension' type='ordinal' />
            <column datatype='date' datatype-customized='true' name='[Report effective date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Reported Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Sub Department Wd]' role='dimension' type='nominal' />
            <column datatype='date' name='[Termination Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Worker Type]' role='dimension' type='nominal' />
            <column aggregation='None' caption='c..age group (aws/sheets) (bin)' datatype='integer' name='[c..age group (aws/sheets) (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[c.div/dept (aws/sheets) (copy)_6408622302546833433]' peg='0' size='10' />
              <aliases>
                <alias key='0' value='&lt;20' />
                <alias key='1' value='&lt;20 ' />
                <alias key='2' value='20-29' />
                <alias key='3' value='30-39' />
                <alias key='4' value='40-49' />
                <alias key='5' value='50-59' />
                <alias key='6' value='60-69' />
                <alias key='7' value='70-79' />
              </aliases>
            </column>
            <column caption='c..age group (aws/sheets)' datatype='integer' name='[c.div/dept (aws/sheets) (copy)_6408622302546833433]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([Age],0)+IFNULL([Calculation_6408622302546214935],0)' />
            </column>
            <column caption='c.brand (aws/sheets)' datatype='string' name='[c.emp cat/sub dept (aws/sheets) (copy)_6408622302547558426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Organisation],&quot;&quot;)+IFNULL([Brand],&quot;&quot;)' />
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='c.div/dept (aws/sheets)' datatype='string' name='[c.emp cat/sub dept (copy)_6408622302532325391]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Division],&quot;&quot;)+IFNULL([Department Wd],&quot;&quot;)' />
            </column>
            <column caption='c.rep date(aws/sheets-1' datatype='date' datatype-customized='true' name='[c.emp cat/sub dept (copy)_6408622302532657169]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date((IFNULL(STR([Reported Date]),&quot;&quot;))+(IFNULL(STR([Report effective date]),&quot;&quot;)))' />
            </column>
            <column aggregation='CountD' caption='c.eolm' datatype='string' default-role='measure' default-type='quantitative' name='[c.eoly (copy)_152840917877702686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Is Terminated]=0&#10;THEN&#10;[Employee Id]&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATETRUNC(&apos;month&apos;,[Report effective date])&#10;THEN&#10;[Employee Id]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column-instance column='[c.emp cat/sub dept (copy)_6408622302532657169]' derivation='MY' name='[my:c.emp cat/sub dept (copy)_6408622302532657169:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6408622302530113550]' derivation='None' name='[none:Calculation_6408622302530113550:nk]' pivot='key' type='nominal' />
            <column-instance column='[Managers]' derivation='None' name='[none:Managers:nk]' pivot='key' type='nominal' />
