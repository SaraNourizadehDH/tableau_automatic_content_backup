        <calculation class='tableau' formula='DATE(IF YEAR([c.emp cat/sub dept (copy)_6408622302532657169])&gt;2020 and [Calculation_984036538659614724]=TRUE&#10;THEN&#10;DATETRUNC(&apos;month&apos;,[c.emp cat/sub dept (copy)_6408622302532657169])&#10;ELSE&#10;NULL&#10;END)' />
