            <column-instance column='[c.emp cat/sub dept (copy)_6408622302532325391]' derivation='None' name='[none:c.emp cat/sub dept (copy)_6408622302532325391:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1110981763362021378]' derivation='User' name='[pcto:usr:Calculation_1110981763362021378:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column-instance column='[c.emp cat/sub dept (copy)_6408622302532657169]' derivation='Month-Trunc' name='[tmn:c.emp cat/sub dept (copy)_6408622302532657169:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1110981763362021378]' derivation='User' name='[usr:Calculation_1110981763362021378:qk]' pivot='key' type='quantitative' />
