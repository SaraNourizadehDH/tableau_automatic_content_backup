            <column caption='c.choose metric-comment' datatype='string' name='[c.choose metric (complete or not) (copy)_6661527585944121416]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 22]=9 &#10;THEN&#10;&quot;Department is incorrect / Department on Workday is not reflective of Supervisory Org&quot;&#10;ELSEif [Parameters].[Parameter 22]=21&#10;THEN&#10;&quot;Sub-department is incorrect / Department+Sub-department combination is incorrect&quot;&#10;ELSE&#10;STR([Calculation_6661527585592651838])+&quot; blank(s)&quot;&#10;END' />
            </column>
            <column caption='Current WD value' datatype='string' name='[c.choose metric (copy)_6661527585942331463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 22]=1&#10;THEN &#10;[address_city]&#10;ELSEIF [Parameters].[Parameter 22]=2&#10;THEN [account_number]&#10;ELSEIF [Parameters].[Parameter 22]=3&#10;THEN [address_country]&#10;ELSEIF [Parameters].[Parameter 22]=4&#10;THEN str([age])&#10;ELSEIF [Parameters].[Parameter 22]=5&#10;THEN [bank_name]&#10;ELSEIF [Parameters].[Parameter 22]=6&#10;THEN [office_location_country]&#10;ELSEIF [Parameters].[Parameter 22]=7&#10;THEN [birth_date]&#10;ELSEIF [Parameters].[Parameter 22]=8&#10;THEN [department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=9&#10;THEN [department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=10&#10;THEN [gender]&#10;ELSEIF [Parameters].[Parameter 22]=11&#10;THEN [iban]&#10;ELSEIF [Parameters].[Parameter 22]=12&#10;THEN [management_level]&#10;ELSEIF [Parameters].[Parameter 22]=13&#10;THEN [marital_status]&#10;ELSEIF [Parameters].[Parameter 22]=14&#10;THEN [national_ids]&#10;ELSEIF [Parameters].[Parameter 22]=15&#10;THEN [nationality]&#10;ELSEIF [Parameters].[Parameter 22]=16&#10;THEN [office_location]&#10;ELSEIF [Parameters].[Parameter 22]=17&#10;THEN [payroll_id]&#10;ELSEIF [Parameters].[Parameter 22]=18&#10;THEN [personal_email]&#10;ELSEIF [Parameters].[Parameter 22]=19&#10;THEN &quot;-&quot;&#10;ELSEIF [Parameters].[Parameter 22]=20&#10;THEN [sub_department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=21&#10;THEN [sub_department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=22&#10;THEN [work_email]&#10;ELSEIF [Parameters].[Parameter 22]=23&#10;THEN &quot;All Important fields&quot;&#10;END' />
