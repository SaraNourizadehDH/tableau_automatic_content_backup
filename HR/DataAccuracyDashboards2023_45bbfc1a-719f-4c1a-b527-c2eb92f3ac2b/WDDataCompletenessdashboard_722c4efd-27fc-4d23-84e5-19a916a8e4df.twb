      <column caption='c.term regrettable' datatype='string' name='[Calculation_1055249712516284444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF int([is_termination_regrettable])=1&#13;&#10;THEN&#13;&#10;&apos;Regrettable Termination&apos;&#13;&#10;ELSE&#13;&#10;&apos;Non-regrettable Termination&apos;&#13;&#10;END' />
      </column>
      <column caption='c.Voluntary/Involuntary filter' datatype='string' name='[Calculation_1348265178183081987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1467329088963854346]=1&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSEif [c.volunatay termination (copy)_1467329088966033419]=1&#13;&#10;THEN&#13;&#10;&quot;Involuntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
      </column>
      <column caption='c.hc wrt last day' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1400619505216983057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[last_day_of_work 1])&lt;DATE([month]) and ([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#13;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#13;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;[employee_id]&#13;&#10;END' />
      </column>
      <column caption='c.volunatay termination' datatype='integer' name='[Calculation_1467329088963854346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([termination_category],&quot;Involuntary&quot;) &#13;&#10;then 0&#13;&#10;ELSE&#13;&#10;1&#13;&#10;END' />
      </column>
      <column caption='c.% term effective' datatype='real' name='[Calculation_152840916153610240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([c.term initiated (copy)_1498854317518782471])/COUNTD([Calculation_1400619505216983057])' />
      </column>
      <column caption='c.Tenure' datatype='real' name='[Calculation_2253488692914311170]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='([Calculation_2535526658434596876]-[original_first_day_of_work])/365' />
      </column>
      <column caption='c.eolm date' datatype='date' name='[Calculation_2332301658988765210]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-DAY(TODAY())' />
      </column>
      <column caption='c.ten calc date' datatype='datetime' name='[Calculation_2535526658434596876]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [last_day_of_work (il_termination)]&lt;(DATEADD(&apos;month&apos;,1,[month])-1)&#13;&#10;THEN&#13;&#10;[last_day_of_work (il_termination)]&#13;&#10;ELSE&#13;&#10;(DATEADD(&apos;month&apos;,1,[month])-1)&#13;&#10;END' />
      </column>
      <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5025876480482725890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is term]=1&#10;THEN&#10;[Dept-final]&#10;ELSE&#10;[c.dept calc tableau (copy)_68539195521925120]&#10;END' />
      </column>
      <column caption='c.dept TB calc filter' datatype='string' name='[Calculation_5025876480483037187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5025876480482725890]' />
      </column>
      <column caption='c.min date' datatype='boolean' name='[Calculation_520447279237611522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([month])&gt;=[Calculation_84724026715045892]' />
      </column>
      <column caption='c.off/non-off' datatype='string' name='[Calculation_564638842018861056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Calculation_6113566190720225285],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
      </column>
      <column caption='c.emp type' datatype='string' name='[Calculation_6113566190720225285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([contract_type],&quot; (&quot;,1)' />
      </column>
      <column caption='Name' datatype='string' name='[Calculation_6661527584493662208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_name]+&quot; &quot;+[last_name]' />
      </column>
      <column caption='c.off/non' datatype='string' name='[Calculation_6661527584493887489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
      </column>
      <column caption='c.% complete-payroll id' datatype='real' name='[Calculation_6661527584512122882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF(ISNULL([payroll_id]),0,1))/COUNTD([employee_id])' />
      </column>
      <column caption='c.dept calc tb' datatype='string' name='[Calculation_6661527585524412428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#9;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
