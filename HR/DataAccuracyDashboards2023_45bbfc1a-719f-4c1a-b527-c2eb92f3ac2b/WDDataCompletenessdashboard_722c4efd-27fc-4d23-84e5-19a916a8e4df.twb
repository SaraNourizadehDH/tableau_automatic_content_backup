          <datasource-dependencies datasource='federated.09xwbi80lpif4f1clve3i0wge4ef'>
            <column caption='c.off/non' datatype='string' name='[Calculation_6661527584493887489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.dept calc tb' datatype='string' name='[Calculation_6661527585524412428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#9;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.man level concat' datatype='string' name='[Calculation_6661527585524510733]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([employee_id],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_6661527585528533012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  LOWER(TRIM([Calculation_6661527585524412428]+[sub_department_wd])) in [Concat Set]&#10;THEN&#10;[sub_department_wd]&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.country filter' datatype='string' name='[Calculation_6661527585891233860]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[office_location_country]' />
            </column>
            <column caption='c.filter for PP' datatype='boolean' name='[Calculation_6661527585964077134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([Parameters].[Parameter 23])=&apos;(all)&apos;&#10;THEN&#10;TRUE&#10;ELSEIF  &#10;CONTAINS(lower([hr_partner]),lower([Parameters].[Parameter 23]))&#10;THEN&#10;TRUE&#10;ELSE&#10;FALSE&#10;END' />
            </column>
