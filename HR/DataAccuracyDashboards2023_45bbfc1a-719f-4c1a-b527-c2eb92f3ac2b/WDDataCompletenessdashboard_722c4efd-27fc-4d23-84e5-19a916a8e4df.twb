    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Guidelines'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/WD-DataCompletenessdashboard/Guidelines?rev=' id='Guidelines' path='/t/HR/workbooks/WD-DataCompletenessdashboard' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_756' value='top' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1550' minheight='900' minwidth='1550' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='344' param='horz' type-v2='layout-flow' w='98968' x='516' y='889'>
            <zone h='98222' id='269' type-v2='layout-basic' w='98968' x='516' y='889'>
              <zone forceUpdate='true' h='3555' id='11' type-v2='text' w='98968' x='516' y='95556'>
                <formatted-text>
                  <run fontalignment='1'>Created by </run>
                  <run bold='true' fontalignment='1' fontcolor='#ff5215'>People Analytics</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#ff5215' />
                  <format attr='border-style' value='dashed' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='margin-bottom' value='0' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='88334' id='756' type-v2='text' w='98968' x='516' y='7222'>
                <formatted-text>
                  <run bold='true' fontcolor='#ef7336' fontsize='18'>Data set:</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>1. All data is reflective of Workday</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>2. Dashboard is dynamic and updated daily</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>3. Only Active employees are displayed on this dashboard</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ef7336' fontsize='18'>Note:</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>1. DHSE employees are excluded (DHSE employees- Any employee outside Tomaso&apos;s management chain)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>2. The correct department is provided based on Workday Supervisory org</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='16'>3. Completion rate is calculated as -</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='16'>Total completed fields/ Total available fields</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ef7336' fontsize='18'>Bank account requirements:</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='16'>UAE</run>
                  <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='16'>Kuwait</run>
                  <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='16'>Bahrain</run>
                  <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                  <run>Æ&#10;</run>
