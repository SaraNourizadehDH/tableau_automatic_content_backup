      <column caption='c.%term eff-exc vol/inv' datatype='real' name='[c.%term eff (copy)_984036538643345409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([c.term initiated (copy)_1498854317518782471])/([c.HC exc vol/inv (copy 2)_1400619505240301588])' />
      </column>
      <column caption='c.HC exc vol/inv kaav' datatype='integer' name='[c.HC exc vol/inv (copy 2)_1400619505240301588]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX({EXCLUDE      [Calculation_1348265178183081987],[Gender (group) 1], DATE([month]) :COUNTD([Calculation_1400619505216983057])})' />
      </column>
      <column caption='c.attrition rate color' datatype='string' name='[c.attrition rate trend (copy)_84724027288178720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 16]=4&#10;THEN&#10;&quot;Attrition rate&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.choose metric-comment' datatype='string' name='[c.choose metric (complete or not) (copy)_6661527585944121416]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 22]=9 &#10;THEN&#10;&quot;Department is incorrect / Department on Workday is not reflective of Supervisory Org&quot;&#10;ELSEif [Parameters].[Parameter 22]=21&#10;THEN&#10;&quot;Sub-department is incorrect / Department+Sub-department combination is incorrect&quot;&#10;ELSE&#10;STR([Calculation_6661527585592651838])+&quot; blank(s)&quot;&#10;END' />
      </column>
      <column caption='Current WD value' datatype='string' name='[c.choose metric (copy)_6661527585942331463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 22]=1&#10;THEN &#10;[address_city]&#10;ELSEIF [Parameters].[Parameter 22]=2&#10;THEN [account_number]&#10;ELSEIF [Parameters].[Parameter 22]=3&#10;THEN [address_country]&#10;ELSEIF [Parameters].[Parameter 22]=4&#10;THEN str([age])&#10;ELSEIF [Parameters].[Parameter 22]=5&#10;THEN [bank_name]&#10;ELSEIF [Parameters].[Parameter 22]=6&#10;THEN [office_location_country]&#10;ELSEIF [Parameters].[Parameter 22]=7&#10;THEN [birth_date]&#10;ELSEIF [Parameters].[Parameter 22]=8&#10;THEN [department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=9&#10;THEN [department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=10&#10;THEN [gender]&#10;ELSEIF [Parameters].[Parameter 22]=11&#10;THEN [iban]&#10;ELSEIF [Parameters].[Parameter 22]=12&#10;THEN [management_level]&#10;ELSEIF [Parameters].[Parameter 22]=13&#10;THEN [marital_status]&#10;ELSEIF [Parameters].[Parameter 22]=14&#10;THEN [national_ids]&#10;ELSEIF [Parameters].[Parameter 22]=15&#10;THEN [nationality]&#10;ELSEIF [Parameters].[Parameter 22]=16&#10;THEN [office_location]&#10;ELSEIF [Parameters].[Parameter 22]=17&#10;THEN [payroll_id]&#10;ELSEIF [Parameters].[Parameter 22]=18&#10;THEN [personal_email]&#10;ELSEIF [Parameters].[Parameter 22]=19&#10;THEN &quot;-&quot;&#10;ELSEIF [Parameters].[Parameter 22]=20&#10;THEN [sub_department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=21&#10;THEN [sub_department_wd]&#10;ELSEIF [Parameters].[Parameter 22]=22&#10;THEN [work_email]&#10;ELSEIF [Parameters].[Parameter 22]=23&#10;THEN &quot;All Important fields&quot;&#10;END' />
      </column>
      <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2825&quot;) and [is_terminated 1]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_6661527585524510733],&quot;2020-06-2823&quot;)&#9;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
      </column>
      <column caption='c.term status' datatype='string' name='[c.emp stsaus (copy)_84724027254775836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#10;([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#10;and [c.term initiated (copy)_1498854317518782471]&gt;=1 &#10;THEN&#10;&quot;Termination&quot;&#10;ELSE&#10;&quot;Existing HC&quot;&#10;END' />
      </column>
      <column caption='c.term type filter' datatype='string' name='[c.involunatay termination (copy)_2332301658690367492]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [termination_category]=&quot;Involuntary&quot;&#13;&#10;then &quot;Involuntary&quot;&#13;&#10;ELSEIF [termination_category]=&quot;Voluntary&quot;&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
      </column>
      <column caption='c.sub dept calc -wk' datatype='string' name='[c.sub dept calc (copy)_6030882878329425920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sun-dept-final]&lt;&gt;&quot;&quot; and [c.term initiated (copy)_1498854317518782471]=1&#10;THEN&#10;(IF CONTAINS([sun-dept-final],&quot;SSC&quot;)&#10;THEN&#10;&quot;SSC&quot;&#10;ELSE&#10;[sun-dept-final]&#10;END)&#10;ELSE&#10;[sub_department_wd]&#10;END' />
      </column>
      <column caption='c.term effective-wk' datatype='integer' name='[c.term effective (copy 2)_2332301658941657104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[last_day_of_work (il_termination)])=DATE([month]) and&#10;[status]=&quot;Successfully Completed&quot; and [is_terminated 1]=1 and&#10;[last_day_of_work 1]=[last_day_of_work (il_termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
      </column>
      <column caption='c.term effective' datatype='integer' name='[c.term initiated (copy)_1498854317518782471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (DATETRUNC(&apos;month&apos;,[last_day_of_work (il_termination)])=DATE([month]) and&#10;STR([last_day_of_work (il_termination)])&lt;&gt;&apos;&apos; and&#10;[status]=&apos;Successfully Completed&apos; &#13;&#10;and ([Parameters].[c.term type filter Parameter]=[termination_category])) and [is_terminated 1]=1&#10;and [last_day_of_work 1]=[last_day_of_work (il_termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSEIF [Parameters].[c.term type filter Parameter]=&quot;All&quot;&#13;&#10;THEN&#13;&#10;[c.term effective (copy 2)_2332301658941657104]&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
      </column>
      <column caption='c.involunatay termination' datatype='integer' name='[c.volunatay termination (copy)_1467329088966033419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([termination_category],&quot;Involuntary&quot;) &#13;&#10;then 1&#13;&#10;else &#13;&#10;0&#13;&#10;END' />
      </column>
