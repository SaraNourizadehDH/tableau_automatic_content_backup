                <zone forceUpdate='true' h='88334' id='756' type-v2='text' w='98968' x='516' y='7222'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ef7336' fontsize='18'>Data set:</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>1. All data is reflective of Workday</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>2. Dashboard is dynamic and updated daily</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>3. Only Active employees are displayed on this dashboard</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ef7336' fontsize='18'>Note:</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>1. DHSE employees are excluded (DHSE employees- Any employee outside Tomaso&apos;s management chain)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>2. The correct department is provided based on Workday Supervisory org</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>3. Completion rate is calculated as -</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Total completed fields/ Total available fields</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ef7336' fontsize='18'>Bank account requirements:</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>UAE</run>
                    <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Kuwait</run>
                    <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Bahrain</run>
                    <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Qatar</run>
                    <run fontcolor='#000000' fontsize='16'> - Bank name, Account Type, IBAN</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Jordan</run>
