        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1yhapk40hr7kq11aulsu71a2kzk2' name='Custom SQL Query' type='text'>SELECT 
    trim(split_part(unnested_value,&apos;(&apos;,1)) AS UNQ_EMP
FROM 
    people_ops_proposed.il_worker_role_assignment 
CROSS JOIN UNNEST(REGEXP_SPLIT(hr_partner, &apos;;&apos;)) AS t(unnested_value)
UNION ALL
SELECT 
    &apos;(All)&apos; AS UNQ_EMP</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
