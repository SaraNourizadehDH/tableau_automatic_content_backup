    <worksheet name='Global Mobility View - People Ops'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/RelocationStatusofFutureStarters_16442257089040/GlobalMobilityView-PeopleOps?rev=' id='113705' path='/t/HR/workbooks/RelocationStatusofFutureStarters_16442257089040' revision='' site='HR' />
      <table>
        <view>
          <datasources>
            <datasource caption='RSFS' name='federated.04h9ucg0nio6oh1biemmd1lmytvc (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.04h9ucg0nio6oh1biemmd1lmytvc (copy)'>
            <column caption='Visa Required?' datatype='string' name='[Calculation_1218927418870747136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_visa_required] = &quot;no visa required&quot; then &quot;No visa required&quot; else &apos;Visa required&apos; end' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_1218927419840671745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [relocation_status]=&apos;Completed&apos; or ([Calculation_3663819037869752322]=True and [country]=&apos;Germany&apos;) then &apos;Good to Start&apos; else (if [Calculation_1218927418870747136]= &apos;No visa required&apos; &#10;and isnull([arrival_date])= false and [arrival_date] &lt;= [first_day_of_work] then &apos;Good to Start&apos;&#10;elseif [Calculation_1218927418870747136]= &apos;No visa required&apos; &#10;and isnull([arrival_date])= false and [arrival_date] &gt; [first_day_of_work] then &apos;Travel Date TBC&apos;&#10;elseif [Calculation_1218927418870747136]= &apos;No visa required&apos;&#10;and isnull([arrival_date])= true then &apos;Travel Date TBC&apos;&#10;elseif [Calculation_1218927418870747136]= &apos;Visa required (EU)&apos; and [country]= &apos;Germany&apos; and [Calculation_6833156941202030605]= &apos;No&apos;&#10;and isnull([arrival_date])= true then &apos;Travel Date TBC&apos; &#10;elseif [Calculation_1218927418870747136]= &apos;Visa required (EU)&apos;&#10;and isnull([Visa Approval Date (DF) (copy)_6833156938710953994])= false&#10;and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])= true&#10;and isnull([arrival_date])= true then &apos;Visa Pending&apos; &#10;elseif [Calculation_1218927418870747136]= &apos;Visa required (EU)&apos;&#10;and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])= false&#10;and isnull([arrival_date])= true then &apos;Visa Issued - Travel Date TBC&apos; &#10;elseif [Calculation_1218927418870747136]= &apos;Visa required (EU)&apos;&#10;and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])= false&#10;and isnull([arrival_date])= false and [arrival_date] &lt;= [first_day_of_work] then &apos;Good to Start&apos; &#10;elseif [Calculation_1218927418870747136]= &apos;Visa required (EU)&apos;&#10;and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])= false &#10;and isnull([arrival_date])= false and [arrival_date] &gt;= [first_day_of_work] then &apos;Travel Date TBC&apos; &#10;else &apos;Visa Pending&apos;&#10;end) end' />
            </column>
            <column caption='Transfer (y/n)?' datatype='string' name='[Calculation_1982780113594277888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [business_process]= &apos;Change Job&apos; then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Department ' datatype='string' name='[Calculation_2525886132796960771]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([department])=True then &apos;No Department&apos; else [department] end' />
            </column>
            <column caption='Employee Name (wd &lt;&gt; onboarding)' datatype='string' name='[Calculation_3547781003973980160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_4195595698813157377]) THEN [newbie_full_name]&#10;ELSE [Calculation_4195595698813157377]&#10;END' />
            </column>
            <column caption='Employee Name' datatype='string' name='[Calculation_3547781003979374593]' role='dimension' type='nominal' user:unnamed='Global Mobility View - People Ops'>
              <calculation class='tableau' formula='//Employee Name&#10;[Calculation_3547781003973980160]' />
            </column>
            <column caption='Arrival Date' datatype='string' name='[Calculation_3663819037835907072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([arrival_date]) then &apos;&apos; else str([arrival_date]) end' />
            </column>
            <column caption='Policy = Relocation Only' datatype='boolean' hidden='true' name='[Calculation_3663819037869752322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([expath_policy],&apos;Relocation only&apos;)=True' />
            </column>
            <column caption='% Progress Filter' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4195595698812469248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6833156941207834638]*100' />
            </column>
            <column caption='Employee Name' datatype='string' name='[Calculation_4195595698813157377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[first_name] + &apos; &apos; + [last_name]' />
            </column>
            <column caption='Possible to Start in Entity?' datatype='string' name='[Calculation_4275604962740486145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if contains([Can we Hire? GS],&apos;Yes&apos;)=True then &apos;Yes&apos;&#10;elseif contains([Can we Hire? GS],&apos;no&apos;)=True then &apos;No&apos; &#10;else &apos;n\a&apos; end' />
              <aliases>
                <alias key='&quot;n\\a&quot;' value='N/A' />
              </aliases>
            </column>
            <column caption='Relotalent?' datatype='string' hidden='true' name='[Calculation_6833156941202030605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([assignee_internal_id])=True then &apos;No&apos; else &apos;Yes&apos; end' />
            </column>
            <column caption='Progress %' datatype='real' default-format='p0%' name='[Calculation_6833156941207834638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [relocation_status]=&apos;Completed&apos; then 1 &#10;elseif contains([expath_policy],&apos;Relocation only&apos;)=True then 1&#10;elseif [country] = &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;No visa required&apos;  then 1 &#10;elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;No visa required&apos; and isnull([arrival_date])=False and [arrival_date]&lt;= [first_day_of_work] then 1&#10;elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;No visa required&apos; and isnull([arrival_date])=True and DATEDIFF(&apos;week&apos;, [first_day_of_work], today()) &gt;=1 then 0.8&#10;elseif [country]= &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and [Calculation_6833156941202030605]=&apos;No&apos; then 1&#10;elseif [country]= &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and [Calculation_6833156941202030605]=&apos;Yes&apos; and [Visa Approval Date (DF) (copy)_6833156938710953994] &lt; [first_day_of_work] then 1&#10;elseif [country]= &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and [Calculation_6833156941202030605]=&apos;Yes&apos; and isnull([arrival_date]) = True and isnull([Visa Approval Date (DF) (copy)_6833156938710953994]) = True and DATEDIFF(&apos;week&apos;, [first_day_of_work], today()) &gt;=2 then 0.5&#10;Elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])=False and isnull([arrival_date])=False and [arrival_date] &lt;= [first_day_of_work] then 1&#10;Elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and isnull([arrival_date])=True and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])=False and datediff(&apos;week&apos;, [Visa Approval Date (DF) (copy)_6833156938711212043] , [first_day_of_work])&gt;= 1 then 0.8&#10;Elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and isnull([arrival_date])=True and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])=True and&#10;datediff(&apos;week&apos;, [Visa Approval Date (DF) (copy)_6833156938710953994], [first_day_of_work]) &gt;= 6 then 0.6&#10;Elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and isnull([arrival_date])=True and isnull([Visa Approval Date (DF) (copy)_6833156938711212043])=True and&#10;datediff(&apos;week&apos;, [Visa Approval Date (DF) (copy)_6833156938710953994], [first_day_of_work]) &gt;=4 and datediff(&apos;week&apos;,[Visa Approval Date (DF) (copy)_6833156938710953994], [first_day_of_work]) &lt; 6 THEN 0.5&#10;Elseif [country] &lt;&gt; &apos;Germany&apos; and [Calculation_1218927418870747136] = &apos;Visa required (EU)&apos; and isnull([arrival_date])=True and isnull([Visa Approval Date (DF) (copy)_6833156938710953994])=True and DATEDIFF(&apos;week&apos;, [first_day_of_work], today()) &gt;=4 then 0.2&#10;elseif [arrival_date] &lt; [first_day_of_work] then 1&#10;Else 0 END' />
            </column>
            <column caption='Visa Appointment Date' datatype='string' hidden='true' name='[Calculation_783696735795920896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull(str([estimated_visa_approval_date])) then &apos;&apos; else replace(mid(str([estimated_visa_approval_date]), find(str([estimated_visa_approval_date]),&apos;:&apos;)+1,10),&apos;/&apos;,&apos;.&apos;) end' />
            </column>
            <column datatype='string' hidden='true' name='[Can we Hire? GS]' role='dimension' type='nominal' />
            <column caption='User Filter - Row level' datatype='boolean' name='[Raw level security (test2) (copy)_4367717594615685122]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(USERNAME() = [managed_by_work_email]) OR (ISMEMBEROF(&apos;People Solutions - Global Mobility&apos;)) OR (ISMEMBEROF(&apos;DH Global Tech Council&apos;)) OR (ISMEMBEROF(&apos;DH People Extended Leadership&apos;)) OR (ISMEMBEROF(&apos;DH People Partners&apos;)) OR (ISMEMBEROF(&apos;People Solutions - All&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - Executive&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - International&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - Marketing&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - People / Finance&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - Product&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition - Tech&apos;)) OR (ISMEMBEROF(&apos;Talent Acquisition Operations&apos;)) OR (ISMEMBEROF(&apos;Total Rewards&apos;) OR (ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;)))' />
            </column>
            <column caption='Visa Effective Date' datatype='string' hidden='true' name='[Visa Appointment Date (copy)_783696735800737793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull(str([visa_approval_date])) = True or str([visa_approval_date])=&apos;,&apos; then &apos;&apos; else replace(mid(str([visa_approval_date]), find(str([visa_approval_date]),&apos;:&apos;)+1,10),&apos;/&apos;,&apos;.&apos;) end' />
            </column>
            <column caption='Visa Appointment Date (DF)' datatype='date' hidden='true' name='[Visa Approval Date (DF) (copy)_6833156938710953994]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(split([Calculation_783696735795920896],&apos;.&apos;,3)+&quot;-&quot;+split([Calculation_783696735795920896],&apos;.&apos;,2)+&quot;-&quot;+split([Calculation_783696735795920896],&apos;.&apos;,1))' />
            </column>
            <column caption='Visa Effective Date (DF)' datatype='date' hidden='true' name='[Visa Approval Date (DF) (copy)_6833156938711212043]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(split([Visa Appointment Date (copy)_783696735800737793],&apos;.&apos;,3)+&quot;-&quot;+split([Visa Appointment Date (copy)_783696735800737793],&apos;.&apos;,2)+&quot;-&quot;+split([Visa Appointment Date (copy)_783696735800737793],&apos;.&apos;,1))' />
            </column>
            <column datatype='date' datatype-customized='true' hidden='true' name='[arrival_date]' role='dimension' type='ordinal' />
            <column datatype='string' hidden='true' name='[assignee_internal_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4195595698812469248]' derivation='Attribute' name='[attr:Calculation_4195595698812469248:qk]' pivot='key' type='quantitative' />
            <column-instance column='[first_day_of_work]' derivation='Attribute' name='[attr:first_day_of_work:ok]' pivot='key' type='ordinal' />
            <column caption='Business Process' datatype='string' hidden='true' name='[business_process]' role='dimension' type='nominal' />
            <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Employee ID ' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
