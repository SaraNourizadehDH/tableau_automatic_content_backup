          <relation connection='athena.0rgbkp81fbro2f12t8evv18d0er3' name='il_manager' table='[people_ops_proposed].[il_manager]' type='table' />
          <relation connection='athena.0rgbkp81fbro2f12t8evv18d0er3' name='Custom SQL Query1' type='text'>SELECT   
b.managed_by as man_id_abr,
    count (distinct a.employee_id) as no_of_reports
FROM
    people_ops_proposed.il_manager a
LEFT JOIN
    people_ops_proposed.il_manager b ON
        CONCAT_WS(&apos; &apos;,
        a.manager_01_full_name,
        a.manager_02_full_name,
        a.manager_03_full_name,
        a.manager_04_full_name,
        a.manager_05_full_name,
        a.manager_06_full_name,
        a.manager_07_full_name,
        a.manager_08_full_name,
        a.manager_09_full_name,
        a.manager_10_full_name
    ) LIKE CONCAT(&apos;%&apos;, b.managed_by_full_name, &apos;%&apos;)
    left join 
    people_ops_proposed.il_worker_org  c on
    b.managed_by = c.employee_id 
group by 
    b.managed_by</relation>
          <relation connection='athena.0rgbkp81fbro2f12t8evv18d0er3' name='Custom SQL Query' type='text'>SELECT
    a.employee_id as emp_id_abr,
    b.managed_by man_id_abr,
     c.management_level as manager_level_abr,
    b.managed_by_work_email as man_email_abr,
    split_part(b.managed_by_full_name,&apos;(&apos;,1) as man_name_abr
FROM
    people_ops_proposed.il_manager a
LEFT JOIN
    people_ops_proposed.il_manager b ON
        CONCAT_WS(&apos; &apos;,
        a.manager_01_full_name,
        a.manager_02_full_name,
        a.manager_03_full_name,
        a.manager_04_full_name,
        a.manager_05_full_name,
        a.manager_06_full_name,
        a.manager_07_full_name,
        a.manager_08_full_name,
        a.manager_09_full_name,
        a.manager_10_full_name
    ) LIKE CONCAT(&apos;%&apos;, b.managed_by_full_name, &apos;%&apos;)
    left join 
    people_ops_proposed.il_worker_org  c on
    b.managed_by = c.employee_id 
    where c.is_terminated =0
group by 
a.employee_id,
    b.managed_by,
     c.management_level,
    b.managed_by_work_email,
    b.managed_by_full_name
order by a.employee_id asc</relation>
