              <calculation class='tableau' formula='IF [is term]=1&#10;THEN&#10;[Dept-final]&#10;ELSE&#10;[c.dept calc tableau (copy)_68539195521925120]&#10;END' />
            </column>
            <column caption='c.dept TB calc filter' datatype='string' name='[Calculation_5025876480483037187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5025876480482725890]' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_5025876484272406533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  LOWER(TRIM([Calculation_5025876480482725890]+[c.sub dept calc (copy)_6030882878329425920])) in [Concat Set]&#10;THEN&#10;[c.sub dept calc (copy)_6030882878329425920]&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.sg&amp;a' datatype='string' name='[Calculation_5373286955071635463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS(LOWER(&apos;Chief Business OfficeCountry Comms,Finance and LegalAccounting and Control,Finance and LegaltMart Finance,Finance and LegalLegal,Finance and LegalPayroll, Procurement and MPP,Q-commerceLocal Shops - Country,Chief Business OfficeCBO-MD,Chief Business OfficeCountry Marketing,Chief Business OfficeCountry Sales,Q-commerceCommercial-Supplier/Category Management,Q-commerceCommercial-Trade Campaigns,Chief Business OfficeCountry Performance,Strategy and InnovationCEO Office,People and CulturePeople Partnering and Local Core,COOFood Services,TechIT Ops,Q-commerceManagement,Q-commerceOperations,Q-CommerceSupply Chain-Planning,Q-commerceOperations-Inventory,Q-commerceMaintenance,Q-commerceCommercial-Admin,Q-CommerceLocal Shops - Country,COOMarketing-Retention,BrandsBrands,Q-commercePerformance and Project Management,Q-commerceStrategy, Growth and Special Projects,Q-commerceCommercial-Media Solutions and Campaigns,COOSSC-Content,Q-commerceLocal Shops - Regional,Chief Business OfficeChief Business Office,COOSSC-Partner care,Chief Business OfficeBusiness Performance,People and CultureTalent Acquisition,People and CultureOrg Design and Solutions,ProductProduct Management,ProductProduct Design,ProductProduct Operations,COOPartner Growth,Chief Business OfficeCountry NFV,Strategy and InnovationNew Ventures,TechEngineering,TechData,ProductData,Q-CommerceManagement,Q-commerceOperations-Food Safety,Q-commerceSupply Chain-Planning,Q-CommerceCommercial-Admin,Q-commerceOperations-Maintenance,Q-commerceSupply Chain-Management,Q-CommerceCommercial-Trade Campaigns,Q-CommerceOperations,ProductBrands,Q-commerceCommercial-Management,Q-CommerceOperations-Food Safety,Finance and LegalTax,Finance and LegalFinancial Planning,Chief Business OfficeStrategic Accounts,Comms, Public Affairs and SustainabilitySustainability and CR,Comms, Public Affairs and SustainabilityCorporate Comms,Comms, Public Affairs and SustainabilityPublic Affairs,Finance and LegalFinTech,Finance and LegalSystems,Finance and LegalTreasury,COOMarketing-Planning and Growth,Q-CommerceOperations-Inventory,Q-CommercePerformance and Project Management,Q-commerceOperations-Expansion/Facilities,Q-commerceOperations-Performance and Training,Q-commerceQaaS,Q-commerceCommercial-Private Label,Q-commerceRegional NFV,Q-CommerceRegional NFV,Q-CommerceLocal Shops - Regional,Strategy and InnovationStrategy and Innovation,Chief Business OfficeUser Experience,People and CultureTalent and Culture,COOSSC-Core Operations,People and CultureTotal Rewards,ProductProgram Management,COOPartnerships and Business Development,Strategy and InnovationPartnerships,TechSecurity,TechAgile,TechTesting,Q-commerceGeneral Admin-Management,Q-CommerceStrategy, Growth and Special Projects,Q-commerceSupply Chain-Distribution, Logistics and Network,Q-commerceContent,Q-commerceCommercial-Ad Operations,Q-CommerceOperations-Special Project Ops,Q-CommerceCommercial-Media Solutions and Campaigns,Q-CommerceCommercial-Private Label,Q-CommerceCommercial-Supplier/Category Management&apos;),lower([Calculation_5025876480482725890]+[Calculation_5025876484272406533]))&#10;THEN&#10;&quot;SG&amp;A&quot;&#10;ELSE&#10;&quot;Other&quot;&#10;END' />
