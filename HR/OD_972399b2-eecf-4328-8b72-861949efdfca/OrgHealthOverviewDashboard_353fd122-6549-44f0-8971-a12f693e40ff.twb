              <calculation class='tableau' formula='DATE(IF MONTH(TODAY())=1&#10;THEN&#10;DATEADD(&apos;year&apos;,-2,DATETRUNC(&apos;year&apos;,TODAY()))&#10;ELSE&#10;DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY()))&#10;END)' />
            </column>
