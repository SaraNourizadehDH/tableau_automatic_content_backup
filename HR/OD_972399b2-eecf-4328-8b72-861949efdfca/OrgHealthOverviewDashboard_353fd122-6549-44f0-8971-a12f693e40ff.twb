          <datasource-dependencies datasource='federated.1ukqpa00cjnd30121xlen0wypbma'>
            <column caption='c.upto same time ly' datatype='boolean' name='[Calculation_1219208880655454208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;year&apos;&#10;THEN&#10;MONTH([month])&lt;=MONTH(DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSE&#10;TRUE&#10;END' />
            </column>
            <column caption='year-1' datatype='string' datatype-customized='true' name='[Calculation_1333909918119739398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year(DATE(DATEADD(&apos;year&apos;,-1,[month]))))+&quot; EOY&quot;' />
            </column>
            <column aggregation='CountD' caption='c.hc wrt last day' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1400619505216983057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[last_day_of_work])&lt;DATE([month]) and ([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#13;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#13;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;[employee_id]&#13;&#10;END' />
            </column>
            <column caption='c.perf cat' datatype='string' name='[Calculation_2245185217215295526]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([review_date])=YEAR([month]) and [manager_rating]&gt;=4&#10;THEN&#10;&quot;High performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]=3&#10;THEN&#10;&quot;Performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]&lt;3&#10;THEN&#10;&quot;Low performers&quot;&#10;END' />
              <aliases>
                <alias key='&quot;High performers&quot;' value='High performer' />
                <alias key='&quot;Low performers&quot;' value='Low performer' />
                <alias key='&quot;Performers&quot;' value='Performer' />
              </aliases>
            </column>
            <column caption='c.manager-level filter' datatype='string' name='[Calculation_3475160447164547073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[manager_level_abr]' />
            </column>
            <column aggregation='Attribute' caption='c.max view date' datatype='boolean' name='[Calculation_3517029851802624001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='{ EXCLUDE [c.view(date) (copy)_5271393061804875783]:MAX([c.view(date) (copy)_5271393061804875783])}=[c.view(date) (copy)_5271393061804875783]' />
            </column>
            <column caption='c.man level concat' datatype='string' name='[Calculation_5025876480482332673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Calculation_1400619505216983057],&quot;&quot;)+&#10;IFNULL([manager_id_01 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_02 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_03 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_04 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_05 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_06 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_07 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_08 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_09 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_10 (il_manager)],&quot;&quot;)' />
