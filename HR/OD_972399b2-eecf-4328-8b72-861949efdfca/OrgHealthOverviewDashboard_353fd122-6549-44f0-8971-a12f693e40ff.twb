            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.term type filter' datatype='string' name='[c.involunatay termination (copy)_2332301658690367492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [termination_category]=&quot;Involuntary&quot;&#13;&#10;then &quot;Involuntary&quot;&#13;&#10;ELSEIF [termination_category]=&quot;Voluntary&quot;&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
            </column>
            <column caption='c.national' datatype='string' name='[c.nationalization (copy)_3917498374960521216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [nationality]=[office_location_country]&#10;THEN&#10;&quot;National&quot;&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.perf cat-filter abr' datatype='string' name='[c.perf cat-filter3 (copy)_6826682997361328129]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([review_date])=YEAR([month]) and [manager_rating]&gt;=4&#10;THEN&#10;&quot;High performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]=3&#10;THEN&#10;&quot;Performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]&lt;3&#10;THEN&#10;&quot;Low performers&quot;&#10;END' />
              <aliases>
                <alias key='&quot;High performers&quot;' value='High performer' />
                <alias key='&quot;Low performers&quot;' value='Low performer' />
                <alias key='&quot;Performers&quot;' value='Performer' />
              </aliases>
            </column>
            <column caption='c.perf upper' datatype='string' name='[c.reg upper (copy)_5271392995746578523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2245185217215295526]=&quot;High performers&quot;&#10;THEN&#10;&quot;HP&quot;&#10;ELSEIF [Calculation_2245185217215295526]=&quot;Low performers&quot;&#10;THEN&#10;&quot;LP&quot;&#10;ELSEIF [Calculation_2245185217215295526]=&quot;Performers&quot;&#10;THEN&#10;&quot;PERF&quot;&#10;END' />
            </column>
            <column caption='c.sub dept calc -wk' datatype='string' name='[c.sub dept calc (copy)_6030882878329425920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sun-dept-final]&lt;&gt;&quot;&quot; and [c.term initiated (copy)_1498854317518782471]=1&#10;THEN&#10;(IF CONTAINS([sun-dept-final],&quot;SSC&quot;)&#10;THEN&#10;&quot;SSC&quot;&#10;ELSE&#10;[sun-dept-final]&#10;END)&#10;ELSE&#10;[sub_department_wd]&#10;END' />
            </column>
            <column caption='c.term effective-wk' datatype='integer' name='[c.term effective (copy 2)_2332301658941657104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[last_day_of_work (il_termination)])=DATE([month]) and&#10;[status]=&quot;Successfully Completed&quot; and [is_terminated]=1 and&#10;[last_day_of_work]=[last_day_of_work (il_termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column caption='c.term effective' datatype='integer' name='[c.term initiated (copy)_1498854317518782471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (DATETRUNC(&apos;month&apos;,[last_day_of_work (il_termination)])=DATE([month]) and&#10;STR([last_day_of_work (il_termination)])&lt;&gt;&apos;&apos; and&#10;[status]=&apos;Successfully Completed&apos; &#13;&#10;and ([Parameters].[c.term type filter Parameter]=[termination_category])) and [is_terminated]=1&#10;and [last_day_of_work]=[last_day_of_work (il_termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSEIF [Parameters].[c.term type filter Parameter]=&quot;All&quot;&#13;&#10;THEN&#13;&#10;[c.term effective (copy 2)_2332301658941657104]&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column caption='c.upto eoCM' datatype='boolean' name='[c.upto eoLM (copy)_2245185216995856405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([month])&lt;=DATETRUNC(&apos;month&apos;,TODAY())' />
            </column>
            <column caption='c.view(date)-par value' datatype='string' datatype-customized='true' name='[c.view(date) (copy)_2245185216893304836]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;year&apos;&#10;THEN&#10;&apos;vs LY&apos;&#10;ELSEIF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;quarter&apos;&#10;THEN&#10;&apos;vs LQ&apos;&#10;ELSEIF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;month&apos;&#10;THEN&#10;&apos;vs LM&apos;&#10;ELSE&#10;&apos;&apos;&#10;end' />
            </column>
            <column caption='c.view(date) (copy)' datatype='date' datatype-customized='true' name='[c.view(date) (copy)_5271393061804875783]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;range&apos;&#10;THEN&#10;NULL&#10;ELSEif [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;month&apos;&#10;THEN&#10;DATE(DATETRUNC(&apos;month&apos;,[month]))&#10;ELSEif [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;quarter&apos;&#10;THEN&#10;DATE(DATETRUNC(&apos;quarter&apos;,[month]))&#10;ELSEif [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;year&apos;&#10;THEN&#10;DATE(DATETRUNC(&apos;year&apos;,[month]))&#10;END' />
            </column>
            <column caption='c.view(date)-par value act' datatype='string' datatype-customized='true' name='[c.view(date)-par value (copy)_2245185216981725198]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;year&apos;&#10;THEN&#10;&apos;CY&apos;&#10;ELSEIF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;quarter&apos;&#10;THEN&#10;&quot;CQ&quot;&#10;else&#10;&quot;CM&quot;&#10;end' />
            </column>
