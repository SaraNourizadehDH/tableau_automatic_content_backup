        <calculation class='tableau' formula='IF [Calculation_2535526658369359872]&lt;0.25&#13;&#10;THEN&#13;&#10;MAX([Calculation_2535526658369359872],0.25)&#13;&#10;ELSEIF [Calculation_2535526658369359872]&lt;0.5&#13;&#10;THEN&#13;&#10;MAX([Calculation_2535526658369359872],0.5)&#13;&#10;ELSEIF [Calculation_2535526658369359872]&lt;1&#13;&#10;THEN&#13;&#10;MAX([Calculation_2535526658369359872],0.999)&#13;&#10;ELSE&#13;&#10;FLOOR([Calculation_2535526658369359872])&#13;&#10;END' />
      </column>
      <column datatype='string' default-role='measure' default-type='ordinal' hidden='true' name='[c.tenure group final (group)]' role='dimension' type='nominal'>
