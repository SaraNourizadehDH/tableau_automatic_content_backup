    <worksheet name='Manager/employee vs EOY performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#898989' fontsize='9'>Trend (hover)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kaav connections-New DM' name='federated.1ukqpa00cjnd30121xlen0wypbma' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Employee/Manager' caption='p.emp/man' datatype='real' name='[Parameter 24]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Employee/Manager' />
                <alias key='2.' value='Overall' />
              </aliases>
            </column>
            <column caption='p.term type Parameter' datatype='string' name='[c.term type filter Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Year' caption='p.view(date) (str)' datatype='string' datatype-customized='true' name='[p.view(date) (copy)_2245185218320007232]' param-domain-type='list' role='measure' type='nominal' value='&quot;year&quot;'>
              <calculation class='tableau' formula='&quot;year&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;range&quot;' value='Selected Range' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ukqpa00cjnd30121xlen0wypbma'>
            <column caption='c.upto same time ly' datatype='boolean' name='[Calculation_1219208880655454208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[p.view(date) (copy)_2245185218320007232]=&apos;year&apos;&#10;THEN&#10;MONTH([month])&lt;=MONTH(DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSE&#10;TRUE&#10;END' />
            </column>
            <column caption='year-1' datatype='string' datatype-customized='true' name='[Calculation_1333909918119739398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year(DATE(DATEADD(&apos;year&apos;,-1,[month]))))+&quot; EOY&quot;' />
            </column>
            <column aggregation='CountD' caption='c.hc wrt last day' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1400619505216983057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[last_day_of_work])&lt;DATE([month]) and ([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#13;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#13;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;[employee_id]&#13;&#10;END' />
            </column>
            <column caption='c.perf cat' datatype='string' name='[Calculation_2245185217215295526]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([review_date])=YEAR([month]) and [manager_rating]&gt;=4&#10;THEN&#10;&quot;High performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]=3&#10;THEN&#10;&quot;Performers&quot;&#10;ELSEIF YEAR([review_date])=YEAR([month]) and [manager_rating]&lt;3&#10;THEN&#10;&quot;Low performers&quot;&#10;END' />
              <aliases>
                <alias key='&quot;High performers&quot;' value='High performer' />
                <alias key='&quot;Low performers&quot;' value='Low performer' />
                <alias key='&quot;Performers&quot;' value='Performer' />
              </aliases>
            </column>
            <column caption='c.manager-level filter' datatype='string' name='[Calculation_3475160447164547073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[manager_level_abr]' />
            </column>
            <column caption='c.man level concat' datatype='string' name='[Calculation_5025876480482332673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Calculation_1400619505216983057],&quot;&quot;)+&#10;IFNULL([manager_id_01 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_02 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_03 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_04 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_05 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_06 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_07 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_08 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_09 (il_manager)],&quot;&quot;)+&#10;IFNULL([manager_id_10 (il_manager)],&quot;&quot;)' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5025876480482725890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is term]=1&#10;THEN&#10;[Dept-final]&#10;ELSE&#10;[c.dept calc tableau (copy)_68539195521925120]&#10;END' />
            </column>
            <column caption='c.dept TB calc filter' datatype='string' name='[Calculation_5025876480483037187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5025876480482725890]' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_5025876484272406533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  LOWER(TRIM([Calculation_5025876480482725890]+[c.sub dept calc (copy)_6030882878329425920])) in [Concat Set]&#10;THEN&#10;[c.sub dept calc (copy)_6030882878329425920]&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.emp/man' datatype='string' name='[Calculation_5373286954745028610]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 24]=1&#10;THEN&#10;[c.man/non man (copy)_3387973561073479681]&#10;ELSE&#10;&quot;Overall&quot;&#10;END' />
            </column>
            <column caption='c.sg&amp;a' datatype='string' name='[Calculation_5373286955071635463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS(LOWER(&apos;Chief Business OfficeCountry Comms,Finance and LegalAccounting and Control,Finance and LegaltMart Finance,Finance and LegalLegal,Finance and LegalPayroll, Procurement and MPP,Q-commerceLocal Shops - Country,Chief Business OfficeCBO-MD,Chief Business OfficeCountry Marketing,Chief Business OfficeCountry Sales,Q-commerceCommercial-Supplier/Category Management,Q-commerceCommercial-Trade Campaigns,Chief Business OfficeCountry Performance,Strategy and InnovationCEO Office,People and CulturePeople Partnering and Local Core,COOFood Services,TechIT Ops,Q-commerceManagement,Q-commerceOperations,Q-CommerceSupply Chain-Planning,Q-commerceOperations-Inventory,Q-commerceMaintenance,Q-commerceCommercial-Admin,Q-CommerceLocal Shops - Country,COOMarketing-Retention,BrandsBrands,Q-commercePerformance and Project Management,Q-commerceStrategy, Growth and Special Projects,Q-commerceCommercial-Media Solutions and Campaigns,COOSSC-Content,Q-commerceLocal Shops - Regional,Chief Business OfficeChief Business Office,COOSSC-Partner care,Chief Business OfficeBusiness Performance,People and CultureTalent Acquisition,People and CultureOrg Design and Solutions,ProductProduct Management,ProductProduct Design,ProductProduct Operations,COOPartner Growth,Chief Business OfficeCountry NFV,Strategy and InnovationNew Ventures,TechEngineering,TechData,ProductData,Q-CommerceManagement,Q-commerceOperations-Food Safety,Q-commerceSupply Chain-Planning,Q-CommerceCommercial-Admin,Q-commerceOperations-Maintenance,Q-commerceSupply Chain-Management,Q-CommerceCommercial-Trade Campaigns,Q-CommerceOperations,ProductBrands,Q-commerceCommercial-Management,Q-CommerceOperations-Food Safety,Finance and LegalTax,Finance and LegalFinancial Planning,Chief Business OfficeStrategic Accounts,Comms, Public Affairs and SustainabilitySustainability and CR,Comms, Public Affairs and SustainabilityCorporate Comms,Comms, Public Affairs and SustainabilityPublic Affairs,Finance and LegalFinTech,Finance and LegalSystems,Finance and LegalTreasury,COOMarketing-Planning and Growth,Q-CommerceOperations-Inventory,Q-CommercePerformance and Project Management,Q-commerceOperations-Expansion/Facilities,Q-commerceOperations-Performance and Training,Q-commerceQaaS,Q-commerceCommercial-Private Label,Q-commerceRegional NFV,Q-CommerceRegional NFV,Q-CommerceLocal Shops - Regional,Strategy and InnovationStrategy and Innovation,Chief Business OfficeUser Experience,People and CultureTalent and Culture,COOSSC-Core Operations,People and CultureTotal Rewards,ProductProgram Management,COOPartnerships and Business Development,Strategy and InnovationPartnerships,TechSecurity,TechAgile,TechTesting,Q-commerceGeneral Admin-Management,Q-CommerceStrategy, Growth and Special Projects,Q-commerceSupply Chain-Distribution, Logistics and Network,Q-commerceContent,Q-commerceCommercial-Ad Operations,Q-CommerceOperations-Special Project Ops,Q-CommerceCommercial-Media Solutions and Campaigns,Q-CommerceCommercial-Private Label,Q-CommerceCommercial-Supplier/Category Management&apos;),lower([Calculation_5025876480482725890]+[Calculation_5025876484272406533]))&#10;THEN&#10;&quot;SG&amp;A&quot;&#10;ELSE&#10;&quot;Other&quot;&#10;END' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_564638842018861056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Calculation_6113566190720225285],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.emp type' datatype='string' name='[Calculation_6113566190720225285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([contract_type],&quot; (&quot;,1)' />
            </column>
            <column datatype='string' name='[Concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Dept-final]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender (group) 1]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[gender]' new-bin='true'>
                <bin default-name='false' value='&quot;Blanks&quot;'>
                  <value>%null%</value>
                  <value>&quot;Non-binary&quot;</value>
                </bin>
              </calculation>
            </column>
            <column-instance column='[Calculation_1333909918119739398]' derivation='Attribute' name='[attr:Calculation_1333909918119739398:nk]' pivot='key' type='nominal' />
            <column caption='c.%perf' datatype='real' name='[c.%man non (copy)_5271392995455987794]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{INCLUDE [manager_rating_explained] :COUNTD([Calculation_1400619505216983057])}/{ EXCLUDE [manager_rating_explained] :COUNTD([Calculation_1400619505216983057])}' />
            </column>
            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;EN