          <bin default-name='false' value='&quot;0-3 months&quot;'>
            <value>0.25</value>
          </bin>
          <bin default-name='false' value='&quot;1-2 years&quot;'>
            <value>1.0</value>
          </bin>
          <bin default-name='false' value='&quot;2-3 years&quot;'>
            <value>2.0</value>
          </bin>
          <bin default-name='false' value='&quot;3-4 years&quot;'>
            <value>3.0</value>
