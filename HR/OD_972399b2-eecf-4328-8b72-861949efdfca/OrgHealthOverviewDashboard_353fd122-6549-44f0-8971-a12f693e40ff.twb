            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5025876480482332673],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
