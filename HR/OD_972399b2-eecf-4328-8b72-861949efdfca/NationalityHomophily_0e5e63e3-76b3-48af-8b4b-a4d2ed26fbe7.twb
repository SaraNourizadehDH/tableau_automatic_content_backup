                <zone forceUpdate='true' h='4800' id='7' type-v2='text' w='98770' x='615' y='533'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='20'>Homophily by Nationality Segment</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='181' forceUpdate='true' h='12600' id='17' type-v2='text' w='98770' x='615' y='5333'>
                  <formatted-text>
                    <run bold='true' fontcolor='#f66c2e' fontsize='10'>Goal: </run>
                    <run fontcolor='#000000' fontsize='10'>To identify patterns of </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>nationality homophily</run>
                    <run fontcolor='#000000' fontsize='10'> within management reporting structures by </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Country, Department, Sub-department &amp; Level</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#f66c2e' fontsize='10'>Approach:</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontsize='10' italic='true'>Homophily</run>
                    <run fontcolor='#000000' fontsize='10'> refers to the </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>average % of reports sharing the same nationality segment </run>
                    <run fontcolor='#000000' fontsize='10'>as their direct manager.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Note: </run>
                    <run fontcolor='#000000' fontsize='10'>Homophily is calculated as an average segmented by Manager, Manager Country, Employee country, Department, Sub-department and Level</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Dashboard is dynamic and updated daily</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Datasource:</run>
                    <run fontcolor='#000000' fontsize='10'> Workday data excluding interns, operational workers, consultants, contractors, freelancers, baristas, pickers, contingent workers (with a single exception-CEO instashop), and office support-sn </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#e15759' fontsize='10' italic='true'>All charts are filters. click any to view data of that population</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='22800' id='16' is-fixed='true' name='Manager Level (group)' w='28308' x='615' y='22200'>
