                  </zone-style>
                </zone>
                <zone fixed-size='705' forceUpdate='true' h='47533' id='17' type-v2='text' w='98770' x='615' y='5333'>
                  <formatted-text>
                    <run fontcolor='#1b1b1b' fontsize='14'>Nationalities are grouped using</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='14'> Geopolitical / Regional factors </run>
                    <run fontcolor='#1b1b1b' fontsize='14'>as below-</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>North America:</run>
                    <run fontcolor='#000000' fontsize='13'> Canada, United States of America, Mexico</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Western Europe:</run>
                    <run fontcolor='#000000' fontsize='13'> Spain, Portugal, Greece, Austria, Croatia, Germany, France, Italy, Netherlands, Switzerland, United Kingdom, Norway, Ireland, Sweden</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Eastern Europe:</run>
                    <run fontcolor='#000000' fontsize='13'> Türkiye, Russian Federation, Ukraine, Lithuania, Belarus, North Macedonia, Latvia, Bulgaria, Poland, Hungary, Romania, Serbia, Uzbekistan, Moldova</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Pakistan:</run>
                    <run fontcolor='#000000' fontsize='13'> Pakistan</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>India:</run>
                    <run fontcolor='#000000' fontsize='13'> India</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>South Asia:</run>
                    <run fontcolor='#000000' fontsize='13'> Bangladesh, Sri Lanka, Nepal, Bhutan</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>MENA:</run>
                    <run fontcolor='#000000' fontsize='13'> Saudi Arabia, Kuwait, Bahrain, Oman, Iraq, Jordan, Egypt, Sudan, Yemen, State of Palestine, Morocco, Algeria, Djibouti, Lebanon, Tunisia, Syria, United Arab Emirates, Qatar</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Sub-Saharan Africa:</run>
                    <run fontcolor='#000000' fontsize='13'> Nigeria, South Africa, Tanzania, Cameroon, Burundi, Ethiopia, Ghana, Eritrea, Congo, Democratic Republic of the, Mauritania, Uganda, Kenya, Malawi, Zimbabwe</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>East Asia:</run>
                    <run fontcolor='#000000' fontsize='13'> China, Myanmar, Mongolia, Kyrgyzstan</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Southeast Asia:</run>
                    <run fontcolor='#000000' fontsize='13'> Philippines, Vietnam, Indonesia, Singapore, Malaysia</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Latin America:</run>
                    <run fontcolor='#000000' fontsize='13'> Brazil, Argentina, Peru, Chile, Panama, Colombia, El Salvador</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Oceania:</run>
                    <run fontcolor='#000000' fontsize='13'> New Zealand, Australia</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='13'>Other Small Nations:</run>
                    <run fontcolor='#000000' fontsize='13'> Saint Kitts and Nevis, Malta, Monaco</run>
