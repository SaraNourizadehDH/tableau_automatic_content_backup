    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Homophily'>
      <style />
      <size maxheight='1500' maxwidth='1300' minheight='1500' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0retl8t063oooq1bqlimm0vql0iz' />
      </datasources>
      <datasource-dependencies datasource='federated.0retl8t063oooq1bqlimm0vql0iz'>
        <column caption='Sub-department [C]' datatype='string' name='[Calculation_4044584353551372288]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if CONTAINS([sub_department],&apos;SSC&apos;)&#10;THEN&#10;&apos;SSC&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;logistics&apos;)&#10;THEN&#10;&apos;Country Logistics&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;new ventures&apos;)&#10;THEN&#10;&apos;Country Performance&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;partner growth&apos;)&#10;THEN&#10;&apos;Country Sales&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;commercial&apos;)&#10;THEN&#10;&apos;Country Performance&apos;&#10;ELSEIF [department]=&apos;COO&apos; and CONTAINS(lower([sub_department]),&apos;operations&apos;)&#10;THEN&#10;&apos;Kitchens&apos;&#10;ELSE&#10;[sub_department]&#10;END' />
        </column>
        <column datatype='string' name='[Manager Level (group) 1]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[level]' new-bin='true'>
            <bin default-name='true' value='&quot;IC4 &amp; M1&quot;'>
              <value>&quot;IC4&quot;</value>
              <value>&quot;M1&quot;</value>
            </bin>
          </calculation>
        </column>
        <column datatype='string' name='[Manager Level (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[level]' new-bin='true'>
            <bin default-name='false' value='&quot;IC1-IC3&quot;'>
              <value>&quot;IC1&quot;</value>
              <value>&quot;IC2&quot;</value>
              <value>&quot;IC3&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;M1-M2&quot;'>
              <value>&quot;IC4&quot;</value>
              <value>&quot;IC5&quot;</value>
              <value>&quot;M1&quot;</value>
              <value>&quot;M2&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;M3+&quot;'>
              <value>&quot;M3&quot;</value>
              <value>&quot;M4&quot;</value>
              <value>&quot;M5&quot;</value>
              <value>&quot;M6&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;S2-S4&quot;'>
              <value>&quot;S2&quot;</value>
              <value>&quot;S3&quot;</value>
              <value>&quot;S4&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
        <column datatype='string' name='[employee_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Manager Level' datatype='string' name='[level]' role='dimension' type='nominal' />
        <column caption='Manager Country' datatype='string' name='[manager_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Nationality Bucket (manager)' datatype='string' name='[manager_nationality_bucket]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Middle East &amp; North Africa&quot;' value='MENA' />
          </aliases>
        </column>
        <column-instance column='[Calculation_4044584353551372288]' derivation='None' name='[none:Calculation_4044584353551372288:nk]' pivot='key' type='nominal' />
        <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
        <column-instance column='[employee_country]' derivation='None' name='[none:employee_country:nk]' pivot='key' type='nominal' />
        <column-instance column='[manager_country]' derivation='None' name='[none:manager_country:nk]' pivot='key' type='nominal' />
        <column-instance column='[manager_nationality_bucket]' derivation='None' name='[none:manager_nationality_bucket:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
