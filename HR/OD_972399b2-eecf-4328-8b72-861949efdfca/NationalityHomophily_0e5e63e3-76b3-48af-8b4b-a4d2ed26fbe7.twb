        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.049ifes0pl2wt71cxn24m0vckw3b' name='Custom SQL Query' type='text'>--manager table manager_id,man nat,man nat bucket, emp_id , emp nat, emp nat bucket for only current active employees
with 
dept as 
(select m.employee_id as employee_id,
CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name) as full_name,
wo.department_wd as department,
wo.sub_department_wd as sub_department,
CASE 
    WHEN m.manager_04_full_name IS NULL OR m.manager_04_full_name = &apos;&apos; 
    THEN 
    	(case
    		when m.manager_id_03 =m.managed_by  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
    		else m.managed_by_full_name
    	end)   	
    else m.manager_04_full_name
END AS manager_level_4,
CASE 
    WHEN m.manager_05_full_name IS NULL OR m.manager_05_full_name = &apos;&apos; 
    THEN 
    	(case
    		when 
    			(CASE 
				    WHEN m.manager_04_full_name IS NULL OR m.manager_04_full_name = &apos;&apos; 
				    THEN 
				    	(case
				    		when m.manager_id_03 =m.managed_by  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
				    		else m.managed_by_full_name
				    	end)   	
				    else m.manager_04_full_name
				end)=m.managed_by_full_name  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
    		else m.managed_by_full_name
    	end)   	
    else m.manager_05_full_name
END AS manager_level_5
from people_ops_proposed.il_manager m
left join people_ops_proposed.il_worker_personal wp 
on m.employee_id =wp.employee_id
left join people_ops_proposed.il_worker_org  wo
on m.employee_id =wo.employee_id
),

m as
(select 
m0.employee_id ,
m0.managed_by ,
m0.managed_by_work_email ,
m0.managed_by_full_name ,
d.manager_level_4 as manager_level_4,
d.manager_level_5 as manager_level_5,
w1.management_level as &quot;level&quot;,
w1.office_location_country as manager_country,
w.office_location_country as employee_country,
------
case 
	when d.manager_level_4=&apos;Jeremy Doutte&apos; then &apos;CBO&apos;
	when d.manager_level_4=&apos;Pedram Assadi&apos; then &apos;COO&apos;
	when d.manager_level_4=&apos;Khaled M.Tayssir Alfakesh&apos; or d.manager_level_4=&apos;Khaled Alfakesh&apos;then &apos;F&amp;L&apos;
	when d.manager_level_4=&apos;Yi Wei Ang&apos; then &apos;T&amp;P&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; then &apos;Q-comm&apos;
	when lower(d.department) LIKE &apos;%people%&apos; then &apos;P&amp;C&apos;
	when lower(d.department) LIKE &apos;%strategy%&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Moiza Saeed&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;May Mohamed Ahmed Youssef&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Raghavendra Singh&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;SIRIN SEVIM SEYMEN&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Maha Gad&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Melissa Costa&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Melita Reveredo&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Genevieve Owens&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Shereen Shaaban&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; then &apos;Str &amp; Comms&apos;
	else &apos;CEO&apos;
end as department,
case 
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%commercial%&apos; then &apos;Commercial&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%supply chain%&apos; then &apos;Supply Chain&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%operations%&apos; then &apos;Operations&apos;
	when d.manager_level_4=&apos;Yi Wei Ang&apos; and lower(d.sub_department) LIKE &apos;%brand%&apos; then &apos;Brand&apos;
	else d.sub_department
end as sub_department,
------
p1.nationality as manager_nationality,

CASE
    WHEN p1.nationality IN (&apos;Canada&apos;, &apos;United States of America&apos;) THEN &apos;North America&apos;
    WHEN p1.nationality IN (&apos;Spain&apos;, &apos;Portugal&apos;, &apos;Greece&apos;, &apos;Austria&apos;, &apos;Croatia&apos;, &apos;Germany&apos;, &apos;France&apos;, &apos;Italy&apos;, &apos;Netherlands&apos;, &apos;Switzerland&apos;, &apos;United Kingdom&apos;, &apos;Norway&apos;, &apos;Latvia&apos;) THEN &apos;Western Europe&apos;
    WHEN p1.nationality IN (&apos;Bangladesh&apos;, &apos;Sri Lanka&apos;, &apos;Nepal&apos;, &apos;Bhutan&apos;) THEN &apos;South Asia&apos;
    WHEN p1.nationality IN (&apos;Pakistan&apos;) THEN &apos;Pakistan&apos;
    WHEN p1.nationality IN (&apos;India&apos;) THEN &apos;India&apos;
    WHEN p1.nationality IN (&apos;Saudi Arabia&apos;, &apos;Kuwait&apos;, &apos;Bahrain&apos;, &apos;Oman&apos;, &apos;Iraq&apos;, &apos;Jordan&apos;, &apos;Egypt&apos;, &apos;Sudan&apos;, &apos;Yemen&apos;, &apos;State of Palestine&apos;, &apos;Morocco&apos;, &apos;Algeria&apos;, &apos;Djibouti&apos;, &apos;Lebanon&apos;) THEN &apos;Middle East &amp; North Africa&apos;
    WHEN p1.nationality IN (&apos;Nigeria&apos;, &apos;South Africa&apos;, &apos;Tanzania&apos;, &apos;Cameroon&apos;, &apos;Burundi&apos;, &apos;Ethiopia&apos;, &apos;Ghana&apos;, &apos;Eritrea&apos;, &apos;Congo, Democratic Republic of the&apos;, &apos;Mauritania&apos;, &apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Malawi&apos;, &apos;Zimbabwe&apos;) THEN &apos;Sub-Saharan Africa&apos;
    WHEN p1.nationality IN (&apos;China&apos;, &apos;Myanmar&apos;, &apos;Mongolia&apos;) THEN &apos;East Asia&apos;
    WHEN p1.nationality IN (&apos;Philippines&apos;, &apos;Vietnam&apos;, &apos;Indonesia&apos;) THEN &apos;Southeast Asia&apos;
    WHEN p1.nationality IN (&apos;Ukraine&apos;, &apos;Lithuania&apos;, &apos;Belarus&apos;, &apos;North Macedonia&apos;, &apos;Bulgaria&apos;, &apos;Poland&apos;, &apos;Hungary&apos;, &apos;Romania&apos;, &apos;Serbia&apos;, &apos;Uzbekistan&apos;) THEN &apos;Eastern Europe&apos;
    WHEN p1.nationality IN (&apos;Brazil&apos;, &apos;Argentina&apos;, &apos;Peru&apos;, &apos;Chile&apos;, &apos;Panama&apos;, &apos;Mexico&apos;, &apos;El Salvador&apos;) THEN &apos;Latin America&apos;
    WHEN p1.nationality IN (&apos;New Zealand&apos;, &apos;Australia&apos;) THEN &apos;Oceania&apos;
    WHEN p1.nationality IN (&apos;Saint Kitts and Nevis&apos;, &apos;Malta&apos;, &apos;Monaco&apos;) THEN &apos;Other Small Nations&apos;
    ELSE &apos;Unknown&apos;
END as manager_nationality_bucket,
p.nationality as employee_nationality,
CASE
    WHEN p.nationality IN (&apos;Canada&apos;, &apos;United States of America&apos;) THEN &apos;North America&apos;
    WHEN p.nationality IN (&apos;Spain&apos;, &apos;Portugal&apos;, &apos;Greece&apos;, &apos;Austria&apos;, &apos;Croatia&apos;, &apos;Germany&apos;, &apos;France&apos;, &apos;Italy&apos;, &apos;Netherlands&apos;, &apos;Switzerland&apos;, &apos;United Kingdom&apos;, &apos;Norway&apos;, &apos;Latvia&apos;) THEN &apos;Western Europe&apos;
    WHEN p.nationality IN (&apos;Bangladesh&apos;, &apos;Sri Lanka&apos;, &apos;Nepal&apos;, &apos;Bhutan&apos;) THEN &apos;South Asia&apos;
    WHEN p.nationality IN (&apos;Pakistan&apos;) THEN &apos;Pakistan&apos;
    WHEN p.nationality IN (&apos;India&apos;) THEN &apos;India&apos;
    WHEN p.nationality IN (&apos;Saudi Arabia&apos;, &apos;Kuwait&apos;, &apos;Bahrain&apos;, &apos;Oman&apos;, &apos;Iraq&apos;, &apos;Jordan&apos;, &apos;Egypt&apos;, &apos;Sudan&apos;, &apos;Yemen&apos;, &apos;State of Palestine&apos;, &apos;Morocco&apos;, &apos;Algeria&apos;, &apos;Djibouti&apos;, &apos;Lebanon&apos;) THEN &apos;Middle East &amp; North Africa&apos;
    WHEN p.nationality IN (&apos;Nigeria&apos;, &apos;South Africa&apos;, &apos;Tanzania&apos;, &apos;Cameroon&apos;, &apos;Burundi&apos;, &apos;Ethiopia&apos;, &apos;Ghana&apos;, &apos;Eritrea&apos;, &apos;Congo, Democratic Republic of the&apos;, &apos;Mauritania&apos;, &apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Malawi&apos;, &apos;Zimbabwe&apos;) THEN &apos;Sub-Saharan Africa&apos;
    WHEN p.nationality IN (&apos;China&apos;, &apos;Myanmar&apos;, &apos;Mongolia&apos;) THEN &apos;East Asia&apos;
    WHEN p.nationality IN (&apos;Philippines&apos;, &apos;Vietnam&apos;, &apos;Indonesia&apos;) THEN &apos;Southeast Asia&apos;
    WHEN p.nationality IN (&apos;Ukraine&apos;, &apos;Lithuania&apos;, &apos;Belarus&apos;, &apos;North Macedonia&apos;, &apos;Bulgaria&apos;, &apos;Poland&apos;, &apos;Hungary&apos;, &apos;Romania&apos;, &apos;Serbia&apos;, &apos;Uzbekistan&apos;) THEN &apos;Eastern Europe&apos;
    WHEN p.nationality IN (&apos;Brazil&apos;, &apos;Argentina&apos;, &apos;Peru&apos;, &apos;Chile&apos;, &apos;Panama&apos;, &apos;Mexico&apos;, &apos;El Salvador&apos;) THEN &apos;Latin America&apos;
    WHEN p.nationality IN (&apos;New Zealand&apos;, &apos;Australia&apos;) THEN &apos;Oceania&apos;
    WHEN p.nationality IN (&apos;Saint Kitts and Nevis&apos;, &apos;Malta&apos;, &apos;Monaco&apos;) THEN &apos;Other Small Nations&apos;
    ELSE &apos;Unknown&apos;
END as employee_nationality_bucket
from people_ops_proposed.il_manager m0
left join dept d
on
m0.managed_by =d.employee_id
left join people_ops_proposed.il_worker_personal p 
on
m0.employee_id=p.employee_id
left join people_ops_proposed.il_worker_personal p1 
on
m0.managed_by=p1.employee_id
left join people_ops_proposed.il_worker_org w 
on
w.employee_id =m0.employee_id 
left join people_ops_proposed.il_worker_org w1
on
w1.employee_id =m0.managed_by  
left join people_ops_proposed.il_manager m1
on
m1.employee_id  =m0.managed_by  
where w.is_terminated =0 
and w1.is_terminated=0 
--and w1.office_location_country =&apos;United Arab Emirates&apos;
--and w.office_location_country =&apos;United Arab Emirates&apos; 
and m0.manager_id_03 =&apos;2020-06-2823&apos;
and not 
	(lower(w.contract_type) LIKE &apos;%intern%&apos; 
	or lower(w.contract_type) LIKE &apos;%operational worker%&apos;
	or lower(w.contract_type) LIKE &apos;%consultant%&apos;
    OR lower(w.contract_type) LIKE &apos;%contractor%&apos;
    OR lower(w.contract_type) LIKE &apos;%freelancer%&apos;
    OR lower(w.contract_type) LIKE &apos;%barista%&apos;
    OR lower(w.contract_type) LIKE &apos;%picker%&apos;
    OR (lower(w.worker_type) = &apos;contingent worker&apos; and not w.employee_id=&apos;C-2025-05-0023&apos;)
    OR lower(w.business_title) = &apos;office support - sn&apos;
    OR w.employee_id IN (&apos;2020-06-2821&apos;, &apos;2020-06-2822&apos;) -- TALABAT NON-OFFICE and OTHER SMALL POPULATION EXCLUDE
)
--and not 
--	(lower(w1.contract_type) LIKE &apos;%intern%&apos; 
--	or lower(w1.contract_type) LIKE &apos;%operational worker%&apos;
--	or lower(w1.contract_type) LIKE &apos;%consultant%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%contractor%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%freelancer%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%barista%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%picker%&apos;
--    OR lower(w1.worker_type) = &apos;contingent worker&apos;
--    OR lower(w1.business_title) = &apos;office support - sn&apos;
--    OR w1.employee_id IN (&apos;2020-06-2821&apos;, &apos;2020-06-2822&apos;) -- TALABAT NON-OFFICE and OTHER SMALL POPULATION EXCLUDE
--)
),

--manager overall table END

m_new as
(select 
m.managed_by ,
m.managed_by_work_email,
m.managed_by_full_name ,
m.&quot;level&quot;,
m.manager_nationality,
m.manager_nationality_bucket,
m.manager_country,
m.employee_country,
m.manager_level_4 AS manager_level_4,
m.manager_level_5 AS manager_level_5,
m.department,
m.sub_department,
----------------
--CASE 
--    WHEN m.manager_level_4 IS NULL OR m.manager_level_4 = &apos;&apos; THEN m.managed_by_full_name 
--    ELSE m.manager_level_4 
--END AS manager_level_4,
--
--CASE 
--    WHEN m.manager_level_5 IS NULL OR m.manager_level_5 = &apos;&apos; THEN m.managed_by_full_name 
--    ELSE m.manager_level_5 
--END AS manager_level_5,

count(distinct(m.employee_id)) as level_1_reports,
count(distinct(case 
		when m.manager_nationality=m.employee_nationality then m.employee_id else null end)) as same_nat_level_1,
count(distinct(case 
		when m.manager_nationality_bucket=m.employee_nationality_bucket then m.employee_id else null end)) as same_nat_bucket_level_1,
count(distinct(m_level_2.employee_id)) as level_2_reports,
count(distinct(case 
		when m.manager_nationality=m_level_2.employee_nationality then m_level_2.employee_id else null end)) as same_nat_level_2,
count(distinct(case 
		when m.manager_nationality_bucket=m_level_2.employee_nationality_bucket then m_level_2.employee_id else null end)) as same_nat_bucket_level_2,
count(distinct(m_level_3.employee_id)) as level_3_reports,
count(distinct(case 
		when m.manager_nationality=m_level_3.employee_nationality then m_level_3.employee_id else null end)) as same_nat_level_3,
count(distinct(case 
		when m.manager_nationality_bucket=m_level_3.employee_nationality_bucket then m_level_3.employee_id else null end)) as same_nat_bucket_level_3
from m

left join m m_level_2
on
m.employee_id=m_level_2.managed_by

left join m m_level_3
on
m_level_2.employee_id=m_level_3.managed_by

--where m.managed_by=&apos;2023-07-0302&apos;
group by m.managed_by ,
m.managed_by_work_email,
m.managed_by_full_name ,
m.&quot;level&quot;,
m.manager_nationality,
m.manager_nationality_bucket,
m.manager_country,
m.employee_country,
m.manager_level_4 ,
m.manager_level_5 ,
m.department,
m.sub_department
)
--,
--n as (
select 
m_new.managed_by ,
m_new.managed_by_work_email,
m_new.managed_by_full_name ,
m_new.manager_country,
m_new.employee_country,
m_new.&quot;level&quot;,
m_new.department,
m_new.sub_department,
m_new.manager_level_4,
m_new.manager_level_5,
m_new.manager_nationality,
m_new.manager_nationality_bucket,
m_new.level_1_reports,
m_new.same_nat_level_1,
m_new.same_nat_bucket_level_1,

CASE
        WHEN m_new.level_1_reports IS NULL OR m_new.level_1_reports = 0 THEN 0.000
        ELSE ROUND(CAST(m_new.same_nat_level_1 AS DECIMAL(10, 5)) / m_new.level_1_reports, 3)
    END AS &quot;same_nat%_upto_level_1&quot;,

    CASE
        WHEN m_new.level_1_reports IS NULL OR m_new.level_1_reports = 0 THEN 0.000
        ELSE ROUND(CAST(m_new.same_nat_bucket_level_1 AS DECIMAL(10, 5)) / m_new.level_1_reports, 3)
    END AS &quot;same_nat%_bucket_upto_level_1&quot;,

m_new.level_2_reports,
m_new.same_nat_level_2,
m_new.same_nat_bucket_level_2,

 CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_level_1 + m_new.same_nat_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports), 3)
    END AS &quot;same_nat%_upto_level_2&quot;,

    CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_bucket_level_1 + m_new.same_nat_bucket_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports), 3)
    END AS &quot;same_nat%_bucket_upto_level_2&quot;,

m_new.level_3_reports,
m_new.same_nat_level_3,
m_new.same_nat_bucket_level_3,

  CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_level_3 + m_new.same_nat_level_1 + m_new.same_nat_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports), 3)
    END AS &quot;same_nat%_upto_level_3&quot;,

    CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_bucket_level_3 + m_new.same_nat_bucket_level_1 + m_new.same_nat_bucket_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports), 3)
    END AS &quot;same_nat%_bucket_upto_level_3&quot;
from m_new
--where m_new.managed_by=&apos;2023-10-0091&apos;
--m_new.&quot;level&quot;=&apos;M4&apos; or m_new.&quot;level&quot;=&apos;M5&apos; or m_new.&quot;level&quot;=&apos;M6&apos;
--where m_new.manager_level_5=&apos;Tomaso Rodriguez&apos; or m_new.managed_by=&apos;2020-06-2823&apos;
group by 
m_new.managed_by ,
m_new.managed_by_work_email,
m_new.managed_by_full_name ,
m_new.manager_country,
m_new.employee_country,
m_new.&quot;level&quot;,
m_new.department,
m_new.sub_department,
m_new.manager_level_4,
m_new.manager_level_5,
m_new.manager_nationality,
m_new.manager_nationality_bucket,
m_new.level_1_reports,
m_new.same_nat_level_1,
m_new.same_nat_bucket_level_1,
m_new.level_2_reports,
m_new.same_nat_level_2,
m_new.same_nat_bucket_level_2,
m_new.level_3_reports,
m_new.same_nat_level_3,
m_new.same_nat_bucket_level_3
--)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.049ifes0pl2wt71cxn24m0vckw3b' name='Custom SQL Query' type='text'>--manager table manager_id,man nat,man nat bucket, emp_id , emp nat, emp nat bucket for only current active employees
with 
dept as 
(select m.employee_id as employee_id,
CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name) as full_name,
wo.department_wd as department,
wo.sub_department_wd as sub_department,
CASE 
    WHEN m.manager_04_full_name IS NULL OR m.manager_04_full_name = &apos;&apos; 
    THEN 
    	(case
    		when m.manager_id_03 =m.managed_by  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
    		else m.managed_by_full_name
    	end)   	
    else m.manager_04_full_name
END AS manager_level_4,
CASE 
    WHEN m.manager_05_full_name IS NULL OR m.manager_05_full_name = &apos;&apos; 
    THEN 
    	(case
    		when 
    			(CASE 
				    WHEN m.manager_04_full_name IS NULL OR m.manager_04_full_name = &apos;&apos; 
				    THEN 
				    	(case
				    		when m.manager_id_03 =m.managed_by  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
				    		else m.managed_by_full_name
				    	end)   	
				    else m.manager_04_full_name
				end)=m.managed_by_full_name  then CONCAT_WS(&apos; &apos;, wp.first_name, wp.last_name)
    		else m.managed_by_full_name
    	end)   	
    else m.manager_05_full_name
END AS manager_level_5
from people_ops_proposed.il_manager m
left join people_ops_proposed.il_worker_personal wp 
on m.employee_id =wp.employee_id
left join people_ops_proposed.il_worker_org  wo
on m.employee_id =wo.employee_id
),

m as
(select 
m0.employee_id ,
m0.managed_by ,
m0.managed_by_work_email ,
m0.managed_by_full_name ,
d.manager_level_4 as manager_level_4,
d.manager_level_5 as manager_level_5,
w1.management_level as &quot;level&quot;,
w1.office_location_country as manager_country,
w.office_location_country as employee_country,
------
case 
	when d.manager_level_4=&apos;Jeremy Doutte&apos; then &apos;CBO&apos;
	when d.manager_level_4=&apos;Pedram Assadi&apos; then &apos;COO&apos;
	when d.manager_level_4=&apos;Khaled M.Tayssir Alfakesh&apos; or d.manager_level_4=&apos;Khaled Alfakesh&apos;then &apos;F&amp;L&apos;
	when d.manager_level_4=&apos;Yi Wei Ang&apos; then &apos;T&amp;P&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; then &apos;Q-comm&apos;
	when lower(d.department) LIKE &apos;%people%&apos; then &apos;P&amp;C&apos;
	when lower(d.department) LIKE &apos;%strategy%&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Moiza Saeed&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;May Mohamed Ahmed Youssef&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Raghavendra Singh&apos; then &apos;Str &amp; Comms&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;SIRIN SEVIM SEYMEN&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Maha Gad&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Melissa Costa&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Melita Reveredo&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Genevieve Owens&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; and d.manager_level_5=&apos;Shereen Shaaban&apos; then &apos;P&amp;C&apos;
--	when d.manager_level_4=&apos;stefano vecchio&apos; then &apos;Str &amp; Comms&apos;
	else &apos;CEO&apos;
end as department,
case 
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%commercial%&apos; then &apos;Commercial&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%supply chain%&apos; then &apos;Supply Chain&apos;
	when d.manager_level_4=&apos;Wassim Makarem&apos; and lower(d.sub_department) LIKE &apos;%operations%&apos; then &apos;Operations&apos;
	when d.manager_level_4=&apos;Yi Wei Ang&apos; and lower(d.sub_department) LIKE &apos;%brand%&apos; then &apos;Brand&apos;
	else d.sub_department
end as sub_department,
------
p1.nationality as manager_nationality,

CASE
    WHEN p1.nationality IN (&apos;Canada&apos;, &apos;United States of America&apos;) THEN &apos;North America&apos;
    WHEN p1.nationality IN (&apos;Spain&apos;, &apos;Portugal&apos;, &apos;Greece&apos;, &apos;Austria&apos;, &apos;Croatia&apos;, &apos;Germany&apos;, &apos;France&apos;, &apos;Italy&apos;, &apos;Netherlands&apos;, &apos;Switzerland&apos;, &apos;United Kingdom&apos;, &apos;Norway&apos;, &apos;Latvia&apos;) THEN &apos;Western Europe&apos;
    WHEN p1.nationality IN (&apos;Bangladesh&apos;, &apos;Sri Lanka&apos;, &apos;Nepal&apos;, &apos;Bhutan&apos;) THEN &apos;South Asia&apos;
    WHEN p1.nationality IN (&apos;Pakistan&apos;) THEN &apos;Pakistan&apos;
    WHEN p1.nationality IN (&apos;India&apos;) THEN &apos;India&apos;
    WHEN p1.nationality IN (&apos;Saudi Arabia&apos;, &apos;Kuwait&apos;, &apos;Bahrain&apos;, &apos;Oman&apos;, &apos;Iraq&apos;, &apos;Jordan&apos;, &apos;Egypt&apos;, &apos;Sudan&apos;, &apos;Yemen&apos;, &apos;State of Palestine&apos;, &apos;Morocco&apos;, &apos;Algeria&apos;, &apos;Djibouti&apos;, &apos;Lebanon&apos;) THEN &apos;Middle East &amp; North Africa&apos;
    WHEN p1.nationality IN (&apos;Nigeria&apos;, &apos;South Africa&apos;, &apos;Tanzania&apos;, &apos;Cameroon&apos;, &apos;Burundi&apos;, &apos;Ethiopia&apos;, &apos;Ghana&apos;, &apos;Eritrea&apos;, &apos;Congo, Democratic Republic of the&apos;, &apos;Mauritania&apos;, &apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Malawi&apos;, &apos;Zimbabwe&apos;) THEN &apos;Sub-Saharan Africa&apos;
    WHEN p1.nationality IN (&apos;China&apos;, &apos;Myanmar&apos;, &apos;Mongolia&apos;) THEN &apos;East Asia&apos;
    WHEN p1.nationality IN (&apos;Philippines&apos;, &apos;Vietnam&apos;, &apos;Indonesia&apos;) THEN &apos;Southeast Asia&apos;
    WHEN p1.nationality IN (&apos;Ukraine&apos;, &apos;Lithuania&apos;, &apos;Belarus&apos;, &apos;North Macedonia&apos;, &apos;Bulgaria&apos;, &apos;Poland&apos;, &apos;Hungary&apos;, &apos;Romania&apos;, &apos;Serbia&apos;, &apos;Uzbekistan&apos;) THEN &apos;Eastern Europe&apos;
    WHEN p1.nationality IN (&apos;Brazil&apos;, &apos;Argentina&apos;, &apos;Peru&apos;, &apos;Chile&apos;, &apos;Panama&apos;, &apos;Mexico&apos;, &apos;El Salvador&apos;) THEN &apos;Latin America&apos;
    WHEN p1.nationality IN (&apos;New Zealand&apos;, &apos;Australia&apos;) THEN &apos;Oceania&apos;
    WHEN p1.nationality IN (&apos;Saint Kitts and Nevis&apos;, &apos;Malta&apos;, &apos;Monaco&apos;) THEN &apos;Other Small Nations&apos;
    ELSE &apos;Unknown&apos;
END as manager_nationality_bucket,
p.nationality as employee_nationality,
CASE
    WHEN p.nationality IN (&apos;Canada&apos;, &apos;United States of America&apos;) THEN &apos;North America&apos;
    WHEN p.nationality IN (&apos;Spain&apos;, &apos;Portugal&apos;, &apos;Greece&apos;, &apos;Austria&apos;, &apos;Croatia&apos;, &apos;Germany&apos;, &apos;France&apos;, &apos;Italy&apos;, &apos;Netherlands&apos;, &apos;Switzerland&apos;, &apos;United Kingdom&apos;, &apos;Norway&apos;, &apos;Latvia&apos;) THEN &apos;Western Europe&apos;
    WHEN p.nationality IN (&apos;Bangladesh&apos;, &apos;Sri Lanka&apos;, &apos;Nepal&apos;, &apos;Bhutan&apos;) THEN &apos;South Asia&apos;
    WHEN p.nationality IN (&apos;Pakistan&apos;) THEN &apos;Pakistan&apos;
    WHEN p.nationality IN (&apos;India&apos;) THEN &apos;India&apos;
    WHEN p.nationality IN (&apos;Saudi Arabia&apos;, &apos;Kuwait&apos;, &apos;Bahrain&apos;, &apos;Oman&apos;, &apos;Iraq&apos;, &apos;Jordan&apos;, &apos;Egypt&apos;, &apos;Sudan&apos;, &apos;Yemen&apos;, &apos;State of Palestine&apos;, &apos;Morocco&apos;, &apos;Algeria&apos;, &apos;Djibouti&apos;, &apos;Lebanon&apos;) THEN &apos;Middle East &amp; North Africa&apos;
    WHEN p.nationality IN (&apos;Nigeria&apos;, &apos;South Africa&apos;, &apos;Tanzania&apos;, &apos;Cameroon&apos;, &apos;Burundi&apos;, &apos;Ethiopia&apos;, &apos;Ghana&apos;, &apos;Eritrea&apos;, &apos;Congo, Democratic Republic of the&apos;, &apos;Mauritania&apos;, &apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Malawi&apos;, &apos;Zimbabwe&apos;) THEN &apos;Sub-Saharan Africa&apos;
    WHEN p.nationality IN (&apos;China&apos;, &apos;Myanmar&apos;, &apos;Mongolia&apos;) THEN &apos;East Asia&apos;
    WHEN p.nationality IN (&apos;Philippines&apos;, &apos;Vietnam&apos;, &apos;Indonesia&apos;) THEN &apos;Southeast Asia&apos;
    WHEN p.nationality IN (&apos;Ukraine&apos;, &apos;Lithuania&apos;, &apos;Belarus&apos;, &apos;North Macedonia&apos;, &apos;Bulgaria&apos;, &apos;Poland&apos;, &apos;Hungary&apos;, &apos;Romania&apos;, &apos;Serbia&apos;, &apos;Uzbekistan&apos;) THEN &apos;Eastern Europe&apos;
    WHEN p.nationality IN (&apos;Brazil&apos;, &apos;Argentina&apos;, &apos;Peru&apos;, &apos;Chile&apos;, &apos;Panama&apos;, &apos;Mexico&apos;, &apos;El Salvador&apos;) THEN &apos;Latin America&apos;
    WHEN p.nationality IN (&apos;New Zealand&apos;, &apos;Australia&apos;) THEN &apos;Oceania&apos;
    WHEN p.nationality IN (&apos;Saint Kitts and Nevis&apos;, &apos;Malta&apos;, &apos;Monaco&apos;) THEN &apos;Other Small Nations&apos;
    ELSE &apos;Unknown&apos;
END as employee_nationality_bucket
from people_ops_proposed.il_manager m0
left join dept d
on
m0.managed_by =d.employee_id
left join people_ops_proposed.il_worker_personal p 
on
m0.employee_id=p.employee_id
left join people_ops_proposed.il_worker_personal p1 
on
m0.managed_by=p1.employee_id
left join people_ops_proposed.il_worker_org w 
on
w.employee_id =m0.employee_id 
left join people_ops_proposed.il_worker_org w1
on
w1.employee_id =m0.managed_by  
left join people_ops_proposed.il_manager m1
on
m1.employee_id  =m0.managed_by  
where w.is_terminated =0 
and w1.is_terminated=0 
--and w1.office_location_country =&apos;United Arab Emirates&apos;
--and w.office_location_country =&apos;United Arab Emirates&apos; 
and m0.manager_id_03 =&apos;2020-06-2823&apos;
and not 
	(lower(w.contract_type) LIKE &apos;%intern%&apos; 
	or lower(w.contract_type) LIKE &apos;%operational worker%&apos;
	or lower(w.contract_type) LIKE &apos;%consultant%&apos;
    OR lower(w.contract_type) LIKE &apos;%contractor%&apos;
    OR lower(w.contract_type) LIKE &apos;%freelancer%&apos;
    OR lower(w.contract_type) LIKE &apos;%barista%&apos;
    OR lower(w.contract_type) LIKE &apos;%picker%&apos;
    OR (lower(w.worker_type) = &apos;contingent worker&apos; and not w.employee_id=&apos;C-2025-05-0023&apos;)
    OR lower(w.business_title) = &apos;office support - sn&apos;
    OR w.employee_id IN (&apos;2020-06-2821&apos;, &apos;2020-06-2822&apos;) -- TALABAT NON-OFFICE and OTHER SMALL POPULATION EXCLUDE
)
--and not 
--	(lower(w1.contract_type) LIKE &apos;%intern%&apos; 
--	or lower(w1.contract_type) LIKE &apos;%operational worker%&apos;
--	or lower(w1.contract_type) LIKE &apos;%consultant%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%contractor%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%freelancer%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%barista%&apos;
--    OR lower(w1.contract_type) LIKE &apos;%picker%&apos;
--    OR lower(w1.worker_type) = &apos;contingent worker&apos;
--    OR lower(w1.business_title) = &apos;office support - sn&apos;
--    OR w1.employee_id IN (&apos;2020-06-2821&apos;, &apos;2020-06-2822&apos;) -- TALABAT NON-OFFICE and OTHER SMALL POPULATION EXCLUDE
--)
),

--manager overall table END

m_new as
(select 
m.managed_by ,
m.managed_by_work_email,
m.managed_by_full_name ,
m.&quot;level&quot;,
m.manager_nationality,
m.manager_nationality_bucket,
m.manager_country,
m.employee_country,
m.manager_level_4 AS manager_level_4,
m.manager_level_5 AS manager_level_5,
m.department,
m.sub_department,
----------------
--CASE 
--    WHEN m.manager_level_4 IS NULL OR m.manager_level_4 = &apos;&apos; THEN m.managed_by_full_name 
--    ELSE m.manager_level_4 
--END AS manager_level_4,
--
--CASE 
--    WHEN m.manager_level_5 IS NULL OR m.manager_level_5 = &apos;&apos; THEN m.managed_by_full_name 
--    ELSE m.manager_level_5 
--END AS manager_level_5,

count(distinct(m.employee_id)) as level_1_reports,
count(distinct(case 
		when m.manager_nationality=m.employee_nationality then m.employee_id else null end)) as same_nat_level_1,
count(distinct(case 
		when m.manager_nationality_bucket=m.employee_nationality_bucket then m.employee_id else null end)) as same_nat_bucket_level_1,
count(distinct(m_level_2.employee_id)) as level_2_reports,
count(distinct(case 
		when m.manager_nationality=m_level_2.employee_nationality then m_level_2.employee_id else null end)) as same_nat_level_2,
count(distinct(case 
		when m.manager_nationality_bucket=m_level_2.employee_nationality_bucket then m_level_2.employee_id else null end)) as same_nat_bucket_level_2,
count(distinct(m_level_3.employee_id)) as level_3_reports,
count(distinct(case 
		when m.manager_nationality=m_level_3.employee_nationality then m_level_3.employee_id else null end)) as same_nat_level_3,
count(distinct(case 
		when m.manager_nationality_bucket=m_level_3.employee_nationality_bucket then m_level_3.employee_id else null end)) as same_nat_bucket_level_3
from m

left join m m_level_2
on
m.employee_id=m_level_2.managed_by

left join m m_level_3
on
m_level_2.employee_id=m_level_3.managed_by

--where m.managed_by=&apos;2023-07-0302&apos;
group by m.managed_by ,
m.managed_by_work_email,
m.managed_by_full_name ,
m.&quot;level&quot;,
m.manager_nationality,
m.manager_nationality_bucket,
m.manager_country,
m.employee_country,
m.manager_level_4 ,
m.manager_level_5 ,
m.department,
m.sub_department
)
--,
--n as (
select 
m_new.managed_by ,
m_new.managed_by_work_email,
m_new.managed_by_full_name ,
m_new.manager_country,
m_new.employee_country,
m_new.&quot;level&quot;,
m_new.department,
m_new.sub_department,
m_new.manager_level_4,
m_new.manager_level_5,
m_new.manager_nationality,
m_new.manager_nationality_bucket,
m_new.level_1_reports,
m_new.same_nat_level_1,
m_new.same_nat_bucket_level_1,

CASE
        WHEN m_new.level_1_reports IS NULL OR m_new.level_1_reports = 0 THEN 0.000
        ELSE ROUND(CAST(m_new.same_nat_level_1 AS DECIMAL(10, 5)) / m_new.level_1_reports, 3)
    END AS &quot;same_nat%_upto_level_1&quot;,

    CASE
        WHEN m_new.level_1_reports IS NULL OR m_new.level_1_reports = 0 THEN 0.000
        ELSE ROUND(CAST(m_new.same_nat_bucket_level_1 AS DECIMAL(10, 5)) / m_new.level_1_reports, 3)
    END AS &quot;same_nat%_bucket_upto_level_1&quot;,

m_new.level_2_reports,
m_new.same_nat_level_2,
m_new.same_nat_bucket_level_2,

 CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_level_1 + m_new.same_nat_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports), 3)
    END AS &quot;same_nat%_upto_level_2&quot;,

    CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_bucket_level_1 + m_new.same_nat_bucket_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports), 3)
    END AS &quot;same_nat%_bucket_upto_level_2&quot;,

m_new.level_3_reports,
m_new.same_nat_level_3,
m_new.same_nat_bucket_level_3,

  CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_level_3 + m_new.same_nat_level_1 + m_new.same_nat_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports), 3)
    END AS &quot;same_nat%_upto_level_3&quot;,

    CASE
        WHEN (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) IS NULL OR (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports) = 0 THEN 0.000
        ELSE ROUND(CAST((m_new.same_nat_bucket_level_3 + m_new.same_nat_bucket_level_1 + m_new.same_nat_bucket_level_2) AS DECIMAL(10, 5)) / (m_new.level_1_reports + m_new.level_2_reports + m_new.level_3_reports), 3)
    END AS &quot;same_nat%_bucket_upto_level_3&quot;
from m_new
--where m_new.managed_by=&apos;2023-10-0091&apos;
--m_new.&quot;level&quot;=&apos;M4&apos; or m_new.&quot;level&quot;=&apos;M5&apos; or m_new.&quot;level&quot;=&apos;M6&apos;
--where m_new.manager_level_5=&apos;Tomaso Rodriguez&apos; or m_new.managed_by=&apos;2020-06-2823&apos;
group by 
m_new.managed_by ,
m_new.managed_by_work_email,
m_new.managed_by_full_name ,
m_new.manager_country,
m_new.employee_country,
m_new.&quot;level&quot;,
m_new.department,
m_new.sub_department,
m_new.manager_level_4,
m_new.manager_level_5,
m_new.manager_nationality,
m_new.manager_nationality_bucket,
m_new.level_1_reports,
m_new.same_nat_level_1,
m_new.same_nat_bucket_level_1,
m_new.level_2_reports,
m_new.same_nat_level_2,
m_new.same_nat_bucket_level_2,
m_new.level_3_reports,
m_new.same_nat_level_3,
m_new.same_nat_bucket_level_3
--)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
