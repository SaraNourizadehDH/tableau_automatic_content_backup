          <formatted-text>
            <run bold='true' fontsize='11'>Department/Sub-department</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0retl8t063oooq1bqlimm0vql0iz' />
          </datasources>
          <datasource-dependencies datasource='federated.0retl8t063oooq1bqlimm0vql0iz'>
            <column caption='Sub-department [C]' datatype='string' name='[Calculation_4044584353551372288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([sub_department],&apos;SSC&apos;)&#10;THEN&#10;&apos;SSC&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;logistics&apos;)&#10;THEN&#10;&apos;Country Logistics&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;new ventures&apos;)&#10;THEN&#10;&apos;Country Performance&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;partner growth&apos;)&#10;THEN&#10;&apos;Country Sales&apos;&#10;ELSEIF [department]=&apos;CBO&apos; and CONTAINS(lower([sub_department]),&apos;commercial&apos;)&#10;THEN&#10;&apos;Country Performance&apos;&#10;ELSEIF [department]=&apos;COO&apos; and CONTAINS(lower([sub_department]),&apos;operations&apos;)&#10;THEN&#10;&apos;Kitchens&apos;&#10;ELSE&#10;[sub_department]&#10;END' />
