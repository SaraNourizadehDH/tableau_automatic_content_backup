    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/CostCenterKPIReportv2/Definitions?rev=' id='Definitions' path='/t/HR/workbooks/CostCenterKPIReportv2' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_11' value='top' />
          <format attr='text-align' id='dash-text_11' value='left' />
          <format attr='vertical-align' id='dash-text_373' value='top' />
        </style-rule>
      </style>
      <size maxheight='1500' maxwidth='1400' minheight='1500' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='91750' id='7' param='horz' type-v2='layout-flow' w='98858' x='571' y='7717'>
            <zone h='91750' id='5' type-v2='layout-basic' w='98858' x='571' y='7717'>
              <zone forceUpdate='true' h='91750' id='11' type-v2='text' w='96572' x='2857' y='7717'>
                <formatted-text>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>*</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>HC</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>Æ </run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Budget: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#222222' fontsize='12'>Budgeted headcount in SAP per given cost center</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>*</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>HC</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>Æ </run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Actual: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#222222' fontsize='12'>Actual number of headcount,</run>
                  <run fontcolor='#1d1c1d' fontsize='12'> including employees on leave and employees started remotely in another entities</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>*</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>HC</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>Æ </run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Actual (Remote): </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#1d1c1d' fontsize='12'>Actual number of headcount that is temporarily working in another entity until they can relocate to Berlin</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d82229' fontsize='12'>*</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>HC</run>
