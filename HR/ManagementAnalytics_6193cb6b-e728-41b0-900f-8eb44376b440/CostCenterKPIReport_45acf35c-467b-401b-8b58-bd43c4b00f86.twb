      <column caption='Attrition %' datatype='real' name='[Calculation_2091007246781546499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([terminations_effective]))&#10; / SUM(ZN([actual]))' />
      </column>
      <column caption='Female hires %' datatype='real' name='[Calculation_224476328050839553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([female_hires]) &#13;&#10;    / (SUM([female_hires]) + SUM([male_hires]))' />
