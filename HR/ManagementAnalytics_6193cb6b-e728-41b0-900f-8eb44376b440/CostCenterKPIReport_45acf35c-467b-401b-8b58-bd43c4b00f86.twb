      <table>
        <view>
          <datasources>
            <datasource caption='Cost Center KPI report' name='federated.0d05tbf1yreq9j15s97dx0ekxk26' />
          </datasources>
          <datasource-dependencies datasource='federated.0d05tbf1yreq9j15s97dx0ekxk26'>
            <column caption='     Terminations Expected' datatype='real' name='[     Terminations Expected (copy)_1365294377084821504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    ATTR(DATETRUNC(&apos;month&apos;, [date_month])) &#13;&#10;        &lt;= DATETRUNC(&apos;month&apos;, TODAY()) &#13;&#10;THEN NULL&#13;&#10;ELSE &#13;&#10;    IF ATTR([date_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, TODAY())) &#13;&#10;    THEN LOOKUP&#13;&#10;        (SUM([future_terminations_effective]), -1)&#13;&#10;    ELSE PREVIOUS_VALUE(1) * 1.02 &#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Movements' datatype='integer' name='[Calculation_2091007246774325249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([starters]) - ZN([terminations_effective])' />
            </column>
            <column caption='     Starters Expected' datatype='integer' name='[Calculation_511299355833421826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR(DATETRUNC(&apos;month&apos;, [date_month])) &lt;= datetrunc(&apos;month&apos;, TODAY()) THEN NULL&#10;ELSE SUM([starters]) END' />
            </column>
            <column caption='Movements Expected' datatype='integer' name='[Calculation_511299355836309507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR(DATETRUNC(&apos;month&apos;, [date_month]))&#13;&#10;    &lt;= DATETRUNC(&apos;month&apos;, TODAY())&#10;THEN NULL&#13;&#10;ELSE ATTR(ZN([starters]) - ZN([terminations_effective])) &#13;&#10;END' />
            </column>
            <column caption='HC Expected Basic ' datatype='integer' name='[Calculation_6196671670439628845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR(DATETRUNC(&apos;month&apos;, [date_month])) &#13;&#10;    &lt;= DATETRUNC(&apos;month&apos;, TODAY()) &#13;&#10;THEN NULL&#13;&#10;ELSE [HC Expected Test (copy 2) (copy)_6196671670435794985] &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HC Expected Actual' datatype='integer' name='[Calculation_6580322027679137811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([date_month]) &gt; TODAY()&#13;&#10;THEN NULL &#13;&#10;ELSE SUM([actual]) &#13;&#10;END' />
            </column>
            <column caption='Expected Hires Needed Helper' datatype='real' name='[Calculation_966092548032618520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hc_budget]) - [HC Expected Helper (copy)_5116089178473619457]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Expected Starters Needed' datatype='real' name='[Calculation_966092549033984027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR(DATETRUNC(&apos;month&apos;, [date_month]))&#13;&#10;    &lt;= DATETRUNC(&apos;month&apos;, TODAY()) &#13;&#10;THEN NULL&#13;&#10;ELSE [Calculation_966092548032618520] &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HC Expected Advanced' datatype='integer' name='[HC Expected Helper (copy)_5116089178473619457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    LOOKUP ([Calculation_6196671670439628845], -1)) &#13;&#10;THEN [Calculation_6196671670439628845] + [Calculation_511299355836309507] &#13;&#10;ELSE PREVIOUS_VALUE(0) + [Calculation_511299355836309507] &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='HC Expected Simple 2' datatype='integer' name='[HC Expected Test (copy 2) (copy)_6196671670435794985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    LOOKUP(SUM([actual]), -1))&#13;&#10;THEN PREVIOUS_VALUE(0) + SUM([Calculation_2091007246774325249]) &#13;&#10;ELSE LOOKUP(SUM([actual]), -1) + SUM([Calculation_2091007246774325249]) &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
