      <column caption='Movements Expected' datatype='integer' name='[Calculation_511299355836309507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR(DATETRUNC(&apos;month&apos;, [date_month]))&#13;&#10;    &lt;= DATETRUNC(&apos;month&apos;, TODAY())&#10;THEN NULL&#13;&#10;ELSE ATTR(ZN([starters]) - ZN([terminations_effective])) &#13;&#10;END' />
