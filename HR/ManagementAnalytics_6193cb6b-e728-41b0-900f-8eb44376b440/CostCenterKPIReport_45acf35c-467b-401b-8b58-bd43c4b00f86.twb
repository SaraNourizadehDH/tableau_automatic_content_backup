      <aliases enabled='yes' />
      <column caption='     % Involuntary Terminations ' datatype='real' name='[     % Involuntary Terminations (copy)_2091007247120543750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([involuntary_terminations_effective])&#13;&#10;    / AVG([terminations_effective])' />
      </column>
      <column caption='     Attrition % - Involuntary YTD' datatype='real' name='[     Attrition % - Voluntary YTD (copy)_2326461074404225053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;    STR(&#13;&#10;        RUNNING_SUM([Calculation_2326461074392563737])&#13;&#10;        )&#13;&#10;    )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Attrition % - Voluntary YTD' datatype='real' name='[     Attrition % YTD (copy)_2326461074394423323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;    STR(&#13;&#10;        RUNNING_SUM([Attrition % - Involuntary (copy)_2326461074393215002])&#13;&#10;        )&#13;&#10;    )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Hires  YTD' datatype='real' datatype-customized='true' name='[     Offers Created  YTD (copy)_2326461074387042328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;    STR(&#13;&#10;        RUNNING_SUM(SUM([hires]))&#13;&#10;        )&#13;&#10;    )'>
          <table-calc level-address='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[none:date_month:ok]' level-break='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[qr:date_month:ok]' ordering-field='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[date_month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='     Terminations Effective (copy)' datatype='integer' name='[     Terminations Effective (copy)_215469110360338432]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[terminations_effective]' />
      </column>
      <column caption='     Terminations Expected' datatype='real' name='[     Terminations Expected (copy)_1365294377084821504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    ATTR(DATETRUNC(&apos;month&apos;, [date_month])) &#13;&#10;        &lt;= DATETRUNC(&apos;month&apos;, TODAY()) &#13;&#10;THEN NULL&#13;&#10;ELSE &#13;&#10;    IF ATTR([date_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, TODAY())) &#13;&#10;    THEN LOOKUP&#13;&#10;        (SUM([future_terminations_effective]), -1)&#13;&#10;    ELSE PREVIOUS_VALUE(1) * 1.02 &#13;&#10;    END&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0d05tbf1yreq9j15s97dx0ekxk26].[sum:actual_on_leave:qk]&quot;' value='    HC Actual (On Leave)' />
          <alias key='&quot;[federated.0d05tbf1yreq9j15s97dx0ekxk26].[sum:remote_hires:qk]&quot;' value='    HC Actual (Remote)' />
        </aliases>
      </column>
      <column caption='Attrition % - Voluntary' datatype='real' name='[Attrition % - Involuntary (copy)_2326461074393215002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_196117729033052162]))&#13;&#10;    / SUM(ZN([actual]))' />
      </column>
      <column caption='Attrition Invol LookUp Las Month' datatype='real' name='[Attrition Vol LookUp Las Month (copy)_2326461074404352030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([     Attrition % - Voluntary YTD (copy)_2326461074404225053], 11)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='month_until_now' datatype='date' name='[Calculation_1696308955083194368]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [date_month] &lt;= TODAY() THEN [date_month] ELSE NULL END' />
      </column>
      <column caption='Avg. Tenure  ' datatype='real' name='[Calculation_1940769983228665859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([length_of_service]) / 365' />
