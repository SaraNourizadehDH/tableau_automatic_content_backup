    <worksheet name='CC KPI Report'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cost Center KPI report' name='federated.0d05tbf1yreq9j15s97dx0ekxk26' />
          </datasources>
          <datasource-dependencies datasource='federated.0d05tbf1yreq9j15s97dx0ekxk26'>
            <column caption='     % Involuntary Terminations ' datatype='real' name='[     % Involuntary Terminations (copy)_2091007247120543750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([involuntary_terminations_effective])&#13;&#10;    / AVG([terminations_effective])' />
            </column>
            <column caption='     Hires  YTD' datatype='real' datatype-customized='true' name='[     Offers Created  YTD (copy)_2326461074387042328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;    STR(&#13;&#10;        RUNNING_SUM(SUM([hires]))&#13;&#10;        )&#13;&#10;    )'>
                <table-calc level-address='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[none:date_month:ok]' level-break='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[qr:date_month:ok]' ordering-field='[federated.0d05tbf1yreq9j15s97dx0ekxk26].[date_month]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Avg. Tenure  ' datatype='real' name='[Calculation_1940769983228665859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([length_of_service]) / 365' />
            </column>
            <column caption='Female in team %' datatype='real' name='[Calculation_2091007246772391936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([female_count])&#13;&#10;    / SUM([actual])' />
            </column>
            <column caption='Movements' datatype='integer' name='[Calculation_2091007246774325249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([starters]) - ZN([terminations_effective])' />
            </column>
            <column caption='Attrition %' datatype='real' name='[Calculation_2091007246781546499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([terminations_effective]))&#10; / SUM(ZN([actual]))' />
            </column>
            <column caption='Female hires %' datatype='real' name='[Calculation_224476328050839553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([female_hires]) &#13;&#10;    / (SUM([female_hires]) + SUM([male_hires]))' />
            </column>
            <column caption='∆ Budget' datatype='real' name='[Calculation_2275162277579632640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual]) &#13;&#10;    - SUM([hc_budget])' />
            </column>
            <column caption='HC Actual' datatype='integer' name='[actual]' role='measure' type='quantitative' />
