      <column caption='c.emp stsaus' datatype='string' name='[Calculation_694187715303104514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#10;([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#10;&#10;and DATETRUNC(&apos;month&apos;,[Original First Day Of Work])=&#10;DATETRUNC(&apos;month&apos;,[Report effective date])&#10;&#10;and [c.term initiated (copy)_1498854317518782471]=0 &#10;THEN&#10;&quot;New Joiner&quot;&#10;elseif&#10;([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#10;and DATETRUNC(&apos;month&apos;,[Original First Day Of Work])=&#10;DATETRUNC(&apos;month&apos;,[Report effective date])&#10;and  [c.term initiated (copy)_1498854317518782471]&gt;=1&#10;THEN&#10;&quot;New Joiner-termination&quot;&#10;ELSEif &#10;&#10;[c.term initiated (copy)_1498854317518782471]&gt;=1 &#10;THEN&#10;&quot;Termination&quot;&#10;ELSE&#10;&quot;Existing HC&quot;&#10;END' />
      </column>
      <column caption='c.country/dept' datatype='string' name='[Calculation_694187715613552647]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 16]=1&#10;THEN&#10;[Calculation_694187715303104514]&#10;ELSEIF &#10;[Parameters].[Parameter 16]=2&#10;THEN&#10;[Calculation_1348265178183081987]&#10;ELSEIF &#10;[Parameters].[Parameter 16]=3&#10;THEN&#10;[Calculation_1055249712516284444]&#10;ELSEIF &#10;[Parameters].[Parameter 16]=4&#10;THEN&#10;&quot;Termination&quot;&#10;END' />
      </column>
      <column caption='c.new joiner/term filter' datatype='string' name='[Calculation_694187715634974729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 16]=1&#10;THEN&#10;[Calculation_694187715303104514]&#10;ELSEIF &#10;[Parameters].[Parameter 16]=2&#10;THEN&#10;(if [c.term initiated (copy)_1498854317518782471]&gt;=1&#10;THEN&#10;[Calculation_1348265178183081987]&#10;ELSE&#10;&quot;Ignore&quot;&#10;END&#10;)&#10;ELSEIF&#10;[Parameters].[Parameter 16]=3&#10;THEN&#10;(if [c.term initiated (copy)_1498854317518782471]&gt;=1&#10;THEN&#10;[Calculation_1055249712516284444]&#10;ELSE&#10;&quot;Ignore&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Parameters].[Parameter 16]=4&#10;THEN&#10;[c.emp stsaus (copy)_84724027254775836]&#10;END' />
        <aliases>
