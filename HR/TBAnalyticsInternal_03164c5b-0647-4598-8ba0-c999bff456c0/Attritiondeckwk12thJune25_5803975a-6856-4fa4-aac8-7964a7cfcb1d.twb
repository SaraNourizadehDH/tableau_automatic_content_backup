      <column caption='c.low perf term' datatype='string' default-role='measure' default-type='quantitative' name='[c.high perf term (copy)_84724026884395023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [manager_rating]&lt;3 and [c.term initiated (copy)_1498854317518782471]&gt;=1 &#10;and [employee_id (il_performance)]=[Employee Id (Custom SQL Query1)]&#10;THEN&#10;[employee_id (il_performance)]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.term/perf' datatype='string' default-role='measure' default-type='quantitative' name='[c.high perf term (copy)_84724026890121236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [c.term initiated (copy)_1498854317518782471]&gt;=1 &#10;and [employee_id (il_performance)]=[employee_id (il_termination)]&#10;THEN&#10;[employee_id (il_termination)]&#10;ELSE&#10;NULL&#10;END' />
