          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.term type Parameter' datatype='string' name='[c.term type filter Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ukqpa00cjnd30121xlen0wypbma'>
            <column datatype='string' name='[Business Title]' role='dimension' type='nominal' />
            <column caption='c.term regrettable' datatype='string' name='[Calculation_1055249712516284444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF int([Is Termination Regrettable])=1&#13;&#10;THEN&#13;&#10;&apos;Regrettable&apos;&#13;&#10;ELSE&#13;&#10;&apos;Non-regrettable&apos;&#13;&#10;END' />
            </column>
            <column caption='c.Voluntary/Involuntary filter' datatype='string' name='[Calculation_1348265178183081987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1467329088963854346]=1&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSEif [c.volunatay termination (copy)_1467329088966033419]=1&#13;&#10;THEN&#13;&#10;&quot;Involuntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
            </column>
            <column caption='c.hc EOM' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1400619505216983057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Is Terminated]=0&#10;and ([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#10;THEN&#10;[Employee Id (Custom SQL Query1)]&#10;&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.volunatay termination' datatype='integer' name='[Calculation_1467329088963854346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if CONTAINS([Termination Category],&quot;Involuntary&quot;) &#13;&#10;then 0&#13;&#10;ELSE&#13;&#10;1&#13;&#10;END' />
            </column>
            <column caption='c.country exc' datatype='string' name='[Calculation_1864208837528240132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Office Location Country]' />
            </column>
            <column caption='c.sg&amp;a' datatype='string' name='[Calculation_3341530201288515584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS(&#10;&apos;D05D0501,&#10;D05D0502,&#10;D05D0503,&#10;D05D0504,&#10;D05D0505,&#10;D05D0506,&#10;D05D0508,&#10;D05D0509,&#10;D05D0510,&#10;D05D0511,&#10;D06D0601,&#10;D06D0602,&#10;D06D0603,&#10;D06D0604,&#10;D07D0701,&#10;D07D0702,&#10;D07D0704,&#10;D07D0706,&#10;D08D0801,&#10;D09D0901,&#10;D09D0902,&#10;D09D0903,&#10;D09D0904,&#10;D09D0905,&#10;D10D1001,&#10;D11D1101,&#10;D11D1102,&#10;D11D1104,&#10;D11D1105,&#10;D11D1107,&#10;D11D1108,&#10;D11D1109,&#10;D11D1110,&#10;D12D1201,&#10;D12D1202,&#10;D12D1203,&#10;D13D1301,&#10;D13D1302,&#10;D14D1401,&#10;D15D1501,&#10;D16D1601,&#10;D16D1602,&#10;D17D1701,&#10;D17D1702,&#10;D20D2001,&#10;D20D2002,&#10;D20D2003&apos;,RIGHT([Cost center], 8))&#10;THEN&#10;&quot;SG&amp;A&quot;&#10;ELSEIF &#10;CONTAINS(&apos;D01D0102,&#10;D01D0103,&#10;D01D0104,&#10;D01D0105,&#10;D01D0108,&#10;D04D0401,&#10;D04D0421,&#10;D04D0431,&#10;D04D0432,&#10;D04D0433,&#10;D04D0434,&#10;D04D0435,&#10;D18D1802,&#10;D18D1804,&#10;D19D1901&apos;,RIGHT([Cost center], 8))&#10;THEN &quot;Non SG&amp;A&quot; &#10;ELSE&#10;&quot;Other&quot;&#10;END' />
            </column>
            <column caption='upto same time LY' datatype='boolean' name='[Calculation_4419720104317218825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if MONTH([Last Day Of Work])= MONTH(TODAY()) &#10;then&#10;day([Last Day Of Work])&lt;=day(TODAY()) or &#10;MONTH([Report effective date])= MONTH(TODAY())&#10;ELSEIF MONTH([Report effective date])&lt; MONTH(TODAY()) &#10;THEN&#10;MONTH([Report effective date])&lt; MONTH(TODAY())&#10;END' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5025876480482725890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [c.dept calc tableau (copy)_68539195521925120] =&apos;Unspecified&apos;&#10;THEN&#10;(IF CONTAINS([HR Department],[Department Wd])&#10;THEN&#10;[Department Wd]&#10;ELSE&#10;&apos;Unspecified&apos;&#10;end)&#10;ELSE&#10;[c.dept calc tableau (copy)_68539195521925120]&#10;END' />
            </column>
            <column caption='c.dept TB calc filter' datatype='string' name='[Calculation_5025876480483037187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5025876480482725890]' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_5025876484272406533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[c.sub dept calc (copy)_6030882878329425920]' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_564638842018861056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Calculation_6113566190720225285],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
