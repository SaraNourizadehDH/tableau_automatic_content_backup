      </column>
      <column caption='c.% term-high perf' datatype='real' name='[c.high perf term (copy)_84724026726719495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([c.high performers (copy)_84724026725867526])/COUNTD([Calculation_84724026725564421])' />
