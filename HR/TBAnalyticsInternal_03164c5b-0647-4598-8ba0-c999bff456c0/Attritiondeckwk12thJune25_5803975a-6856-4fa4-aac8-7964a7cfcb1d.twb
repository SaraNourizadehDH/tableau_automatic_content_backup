            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2825&quot;) and [Is Terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2806&quot;) or &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2822&quot;)&#9;&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-09-0177&quot;)&#10;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([Department Wd]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Employee Id (Custom SQL Query1)]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[Employee Id (Custom SQL Query1)]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.term type filter' datatype='string' name='[c.involunatay termination (copy)_2332301658690367492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Termination Category]=&quot;Involuntary&quot;&#13;&#10;then &quot;Involuntary&quot;&#13;&#10;ELSEIF [Termination Category]=&quot;Voluntary&quot;&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
            </column>
            <column caption='c.sub dept calc -wk' datatype='string' name='[c.sub dept calc (copy)_6030882878329425920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([Calculation_5025876480482725890]+[Sub Department Wd]) in [Concat Set]&#10;THEN&#10;(if CONTAINS([Sub Department Wd], &apos;SSC&apos;)&#10;THEN&#10;&quot;SSC&quot;&#10;ELSE&#10;[Sub Department Wd]&#10;END)&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.term effective-wk' datatype='integer' name='[c.term effective (copy 2)_2332301658941657104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATEtrunc(&apos;month&apos;,[Report effective date]) and&#10;[Status]=&quot;Successfully Completed&quot;&#10;&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column caption='c.term effective' datatype='integer' name='[c.term initiated (copy)_1498854317518782471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATEtrunc(&apos;month&apos;,[Report effective date]) and&#10;STR([Last Day Of Work (Il Termination)])&lt;&gt;&apos;&apos; and&#10;[Status]=&apos;Successfully Completed&apos; &#13;&#10;and ([Parameters].[c.term type filter Parameter]=[Termination Category])) and [Is Terminated]=1&#10;and [Last Day Of Work]=[Last Day Of Work (Il Termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSEIF [Parameters].[c.term type filter Parameter]=&quot;All&quot;&#13;&#10;THEN&#13;&#10;[c.term effective (copy 2)_2332301658941657104]&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column caption='c.involunatay termination' datatype='integer' name='[c.volunatay termination (copy)_1467329088966033419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if CONTAINS([Termination Category],&quot;Involuntary&quot;) &#13;&#10;then 1&#13;&#10;else &#13;&#10;0&#13;&#10;END' />
