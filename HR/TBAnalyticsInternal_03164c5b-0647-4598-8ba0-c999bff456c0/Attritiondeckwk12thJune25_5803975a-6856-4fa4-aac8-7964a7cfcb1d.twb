      <column caption='c.%new job tech' datatype='real' name='[Calculation_1055249712546897961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Is your new employer a tech company?])/[Calculation_1055249712549617706]' />
      </column>
      <column caption='c.exit interview filled' datatype='integer' name='[Calculation_1055249712549617706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX({EXCLUDE [Is your new employer a tech company?],[Does your new employer operate in the e-commerce/q-commerce space?],[How does your base salary compare to your current comp?],[How does your stock options compare to your current stock options? (if applicable)],[How does your discretionary comp (bonus/performance incentives/etc) compare to your current discretionary comp?]:COUNT([Primary Reason for Leaving])})' />
