      <repository-location derived-from='http://ip-172-31-0-77:8504/t/HR/workbooks/Attrition-deckwk-12thJune25/Guidelines?rev=' id='Guidelines' path='/t/HR/workbooks/Attrition-deckwk-12thJune25' revision='' site='HR' />
