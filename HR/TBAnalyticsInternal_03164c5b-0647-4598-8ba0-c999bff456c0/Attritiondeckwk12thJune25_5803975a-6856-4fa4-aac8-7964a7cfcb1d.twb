              <calculation class='tableau' formula='IF [Parameters].[Parameter 23]=1&#10;THEN&#10;sum([c.term initiated (copy)_1498854317518782471])&#10;ELSEIF  [Parameters].[Parameter 23]=2&#10;THEN&#10;[Calculation_152840916153610240]&#10;END' />
