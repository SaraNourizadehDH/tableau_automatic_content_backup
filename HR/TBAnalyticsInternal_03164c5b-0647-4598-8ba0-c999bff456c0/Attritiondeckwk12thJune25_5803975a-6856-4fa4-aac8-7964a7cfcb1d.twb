  <worksheets>
    <worksheet name='1-LY-CY'>
      <table>
        <view>
          <datasources>
            <datasource caption='Kaav connections-New DM' name='federated.1ukqpa00cjnd30121xlen0wypbma' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p.term type Parameter' datatype='string' name='[c.term type filter Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ukqpa00cjnd30121xlen0wypbma'>
            <column datatype='string' name='[Business Title]' role='dimension' type='nominal' />
            <column caption='c.term regrettable' datatype='string' name='[Calculation_1055249712516284444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF int([Is Termination Regrettable])=1&#13;&#10;THEN&#13;&#10;&apos;Regrettable&apos;&#13;&#10;ELSE&#13;&#10;&apos;Non-regrettable&apos;&#13;&#10;END' />
            </column>
            <column caption='c.hc EOM' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1400619505216983057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Is Terminated]=0&#10;and ([Parameters].[c.term type filter Parameter] = &quot;Voluntary&quot;&#10;OR [Parameters].[c.term type filter Parameter] = &quot;All&quot;&#10;or [Parameters].[c.term type filter Parameter] = &quot;Involuntary&quot;)&#10;THEN&#10;[Employee Id (Custom SQL Query1)]&#10;&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.% term effective' datatype='real' name='[Calculation_152840916153610240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c.term initiated (copy)_1498854317518782471])/COUNTD([Calculation_1400619505216983057])' />
            </column>
            <column caption='c.% attr sum/yr' datatype='real' name='[Calculation_1684205554268491791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([c.term initiated (copy)_1498854317518782471]))/RUNNING_MAX(sum({ FIXED   YEAR([Report effective date]),[Employee Id (Custom SQL Query1)] : countd([c.hc wrt last day (copy)_5154792019616985115])}))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.country exc' datatype='string' name='[Calculation_1864208837528240132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Office Location Country]' />
            </column>
            <column caption='c.eolm date' datatype='date' name='[Calculation_2332301658988765210]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-DAY(TODAY())' />
            </column>
            <column caption='c.sg&amp;a' datatype='string' name='[Calculation_3341530201288515584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS(&#10;&apos;D05D0501,&#10;D05D0502,&#10;D05D0503,&#10;D05D0504,&#10;D05D0505,&#10;D05D0506,&#10;D05D0508,&#10;D05D0509,&#10;D05D0510,&#10;D05D0511,&#10;D06D0601,&#10;D06D0602,&#10;D06D0603,&#10;D06D0604,&#10;D07D0701,&#10;D07D0702,&#10;D07D0704,&#10;D07D0706,&#10;D08D0801,&#10;D09D0901,&#10;D09D0902,&#10;D09D0903,&#10;D09D0904,&#10;D09D0905,&#10;D10D1001,&#10;D11D1101,&#10;D11D1102,&#10;D11D1104,&#10;D11D1105,&#10;D11D1107,&#10;D11D1108,&#10;D11D1109,&#10;D11D1110,&#10;D12D1201,&#10;D12D1202,&#10;D12D1203,&#10;D13D1301,&#10;D13D1302,&#10;D14D1401,&#10;D15D1501,&#10;D16D1601,&#10;D16D1602,&#10;D17D1701,&#10;D17D1702,&#10;D20D2001,&#10;D20D2002,&#10;D20D2003&apos;,RIGHT([Cost center], 8))&#10;THEN&#10;&quot;SG&amp;A&quot;&#10;ELSEIF &#10;CONTAINS(&apos;D01D0102,&#10;D01D0103,&#10;D01D0104,&#10;D01D0105,&#10;D01D0108,&#10;D04D0401,&#10;D04D0421,&#10;D04D0431,&#10;D04D0432,&#10;D04D0433,&#10;D04D0434,&#10;D04D0435,&#10;D18D1802,&#10;D18D1804,&#10;D19D1901&apos;,RIGHT([Cost center], 8))&#10;THEN &quot;Non SG&amp;A&quot; &#10;ELSE&#10;&quot;Other&quot;&#10;END' />
            </column>
            <column caption='upto same time LY' datatype='boolean' name='[Calculation_4419720104317218825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if MONTH([Last Day Of Work])= MONTH(TODAY()) &#10;then&#10;day([Last Day Of Work])&lt;=day(TODAY()) or &#10;MONTH([Report effective date])= MONTH(TODAY())&#10;ELSEIF MONTH([Report effective date])&lt; MONTH(TODAY()) &#10;THEN&#10;MONTH([Report effective date])&lt; MONTH(TODAY())&#10;END' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5025876480482725890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [c.dept calc tableau (copy)_68539195521925120] =&apos;Unspecified&apos;&#10;THEN&#10;(IF CONTAINS([HR Department],[Department Wd])&#10;THEN&#10;[Department Wd]&#10;ELSE&#10;&apos;Unspecified&apos;&#10;end)&#10;ELSE&#10;[c.dept calc tableau (copy)_68539195521925120]&#10;END' />
            </column>
            <column caption='c.dept TB calc filter' datatype='string' name='[Calculation_5025876480483037187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5025876480482725890]' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_5025876484272406533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[c.sub dept calc (copy)_6030882878329425920]' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_564638842018861056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Calculation_6113566190720225285],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.emp type' datatype='string' name='[Calculation_6113566190720225285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Contract Type],&quot; (&quot;,1)' />
            </column>
            <column caption='c.attr_by man' datatype='string' name='[Calculation_710091041765330944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='trim(SPLIT([Managers],&apos;(&apos;,1))' />
            </column>
            <column datatype='string' name='[Concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Contract Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Cost center]' role='dimension' type='nominal' />
            <column datatype='string' name='[Department Wd]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' name='[Employee Id (Custom SQL Query1)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender (group) 1]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Gender]' new-bin='true'>
                <bin default-name='false' value='&quot;Blanks&quot;'>
                  <value>%null%</value>
                  <value>&quot;Non-binary&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[HR Department]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Is Terminated]' role='measure' type='quantitative' />
            <column datatype='string' name='[Is Termination Regrettable]' role='dimension' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[Last Day Of Work (Il Termination)]' role='dimension' type='ordinal' />
            <column datatype='date' datatype-customized='true' name='[Last Day Of Work]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Management Level]' role='dimension' type='nominal' />
            <column datatype='string' name='[Manager ID concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
            <column datatype='string' name='[Office Location Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Office Location]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' datatype-customized='true' name='[Report effective date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Status]' role='dimension' type='nominal' />
            <column datatype='string' name='[Sub Department Wd]' role='dimension' type='nominal' />
            <column datatype='string' name='[Termination Category]' role='dimension' type='nominal' />
            <column caption='c.avg % term effective' datatype='real' name='[c.% term effective (copy)_5367094515512836098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c.term initiated (copy)_1498854317518782471])/&#10;avg({INCLUDE DATETRUNC(&apos;month&apos;,[Report effective date]), DATETRUNC(&apos;year&apos;,[Report effective date]):COUNTD([Calculation_1400619505216983057])})' />
            </column>
            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_68539195521925120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2825&quot;) and [Is Terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2806&quot;) or &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2822&quot;)&#9;&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-09-0177&quot;)&#10;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([Department Wd]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee Id (Custom SQL Query1)],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Employee Id (Custom SQL Query1)]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[Employee Id (Custom SQL Query1)]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.hc run count' datatype='string' default-role='measure' default-type='quantitative' name='[c.hc wrt last day (copy)_5154792019616985115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[Last Day Of Work])&lt;datetrunc(&apos;year&apos;,[Report effective date]) &#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;[Employee Id (Custom SQL Query1)]&#13;&#10;END' />
            </column>
            <column caption='c.term type filter' datatype='string' name='[c.involunatay termination (copy)_2332301658690367492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Termination Category]=&quot;Involuntary&quot;&#13;&#10;then &quot;Involuntary&quot;&#13;&#10;ELSEIF [Termination Category]=&quot;Voluntary&quot;&#13;&#10;THEN&#13;&#10;&quot;Voluntary&quot;&#13;&#10;ELSE&#13;&#10;NULL&#13;&#10;END' />
            </column>
            <column caption='c.sub dept calc -wk' datatype='string' name='[c.sub dept calc (copy)_6030882878329425920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([Calculation_5025876480482725890]+[Sub Department Wd]) in [Concat Set]&#10;THEN&#10;(if CONTAINS([Sub Department Wd], &apos;SSC&apos;)&#10;THEN&#10;&quot;SSC&quot;&#10;ELSE&#10;[Sub Department Wd]&#10;END)&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.term effective-wk' datatype='integer' name='[c.term effective (copy 2)_2332301658941657104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATEtrunc(&apos;month&apos;,[Report effective date]) and&#10;[Status]=&quot;Successfully Completed&quot;&#10;&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column caption='c.term effective' datatype='integer' name='[c.term initiated (copy)_1498854317518782471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATEtrunc(&apos;month&apos;,[Report effective date]) and&#10;STR([Last Day Of Work (Il Termination)])&lt;&gt;&apos;&apos; and&#10;[Status]=&apos;Successfully Completed&apos; &#13;&#10;and ([Parameters].[c.term type filter Parameter]=[Termination Category])) and [Is Terminated]=1&#10;and [Last Day Of Work]=[Last Day Of Work (Il Termination)]&#13;&#10;THEN&#13;&#10;1&#13;&#10;ELSEIF [Parameters].[c.term type filter Parameter]=&quot;All&quot;&#13;&#10;THEN&#13;&#10;[c.term effective (copy 2)_2332301658941657104]&#13;&#10;ELSE&#13;&#10;0&#13;&#10;END' />
            </column>
            <column-instance column='[Report effective date]' derivation='Max' name='[max:Report effective date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Report effective date]' derivation='Month' name='[mn:Report effective date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Business Title]' derivation='None' name='[none:Business Title:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1055249712516284444]' derivation='None' name='[none:Calculation_1055249712516284444:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1864208837528240132]' derivation='None' name='[none:Calculation_1864208837528240132:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2332301658988765210]' derivation='None' name='[none:Calculation_2332301658988765210:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3341530201288515584]' derivation='None' name='[none:Calculation_3341530201288515584:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4419720104317218825]' derivation='None' name='[none:Calculation_4419720104317218825:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5025876480482725890]' derivation='None' name='[none:Calculation_5025876480482725890:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5025876480483037187]' derivation='None' name='[none:Calculation_5025876480483037187:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5025876484272406533]' derivation='None' name='[none:Calculation_5025876484272406533:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_564638842018861056]' derivation='None' name='[none:Calculation_564638842018861056:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_710091041765330944]' derivation='None' name='[none:Calculation_710091041765330944:nk]' pivot='key' type='nominal' />
            <column-instance column='[Employee Id (Custom SQL Query1)]' derivation='None' name='[none:Employee Id (Custom SQL Query1):nk]' pivot='key' type='nominal' />
            <column-instance column='[Management Level]' derivation='None' name='[none:Management Level:nk]' pivot='key' type='nominal' />
