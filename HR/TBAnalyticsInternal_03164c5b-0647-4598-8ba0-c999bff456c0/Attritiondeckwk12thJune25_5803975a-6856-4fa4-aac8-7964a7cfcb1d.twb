      <column caption='c.qtr filter eoLM' datatype='boolean' name='[c.month filter eoLM (copy)_984036538663542791]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='QUARTER([day])&lt;=QUARTER(TODAY()-DAY(TODAY()))' />
