      <column caption='c.cnt perf exc vol/inv' datatype='integer' name='[Calculation_1055249712435716101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Calculation_1348265178183081987]:COUNT([manager_rating_explained])}' />
      </column>
      <column caption='c.% term-perf rating' datatype='real' name='[Calculation_1055249712449056777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([c.term initiated (copy)_1498854317518782471])/MAX([Calculation_1055249712435716101])' />
      </column>
      <column caption='Self rating= Manager rating' datatype='string' name='[Calculation_1055249712490291215]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [self_rating_explained]=[manager_rating_explained]&#13;&#10;THEN&#13;&#10;&apos;Aligned&apos;&#13;&#10;ELSE&#13;&#10;&apos;Misaligned&apos;&#13;&#10;END' />
      </column>
