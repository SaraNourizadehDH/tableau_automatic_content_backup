      </column>
      <column caption='c.low performers ' datatype='string' default-role='measure' default-type='quantitative' name='[c.high performers (copy)_84724026884222990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [manager_rating]&lt;3 and [employee_id (il_performance)]=[Employee Id (Custom SQL Query1)]&#10;THEN&#10;[employee_id (il_performance)]&#10;ELSE&#10;NULL&#10;END' />
