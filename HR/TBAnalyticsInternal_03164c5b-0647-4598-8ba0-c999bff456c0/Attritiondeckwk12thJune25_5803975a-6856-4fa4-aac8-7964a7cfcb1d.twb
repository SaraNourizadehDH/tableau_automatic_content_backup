      <column caption='c.split for shereen' datatype='string' name='[Calculation_4254494331312590850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3341530201288515584]=&quot;SG&amp;A&quot;&#10;THEN&#10;(if ([Management Level]=&quot;M1&quot;&#10;or [Management Level]=&quot;M2&quot;&#10;or [Management Level]=&quot;M3&quot;&#10;or [Management Level]=&quot;M4&quot;&#10;or [Management Level]=&quot;M5&quot;&#10;or [Management Level]=&quot;M6&quot;)&#10;THEN&#10;&quot;M1+&quot;&#10;ELSE&#10;&quot;IC3 and below&quot;&#10;end)&#10;ELSE&#10;&quot;Non-SG&amp;A&quot;&#10;end' />
