          <object caption='il_manager1' id='il_manager_B509B19186B3406E97A7F784D4CD64B7'>
            <properties context=''>
              <relation connection='athena.0rgbkp81fbro2f12t8evv18d0er3' name='Custom SQL Query' type='text'>SELECT employee_id AS Employee, manager_01_full_name AS Managers
FROM people_ops_proposed.il_manager
