    <worksheet name='Total Hires 2022'>
      <table>
        <view>
          <datasources>
            <datasource caption='Budget' name='federated.0ttamet07pxsaf1dt09cl0qa7zuu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Estimated Year Attrition' datatype='real' datatype-customized='true' default-format='p0%' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.20'>
              <calculation class='tableau' formula='0.20' />
              <range max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ttamet07pxsaf1dt09cl0qa7zuu'>
            <column caption='December 2022 HC Budget' datatype='real' name='[Calculation_575334912859316224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_575334912859516929] = TRUE THEN [hc_budget] ELSE 0 END' />
            </column>
            <column caption='December 2022' datatype='boolean' name='[Calculation_575334912859516929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month] = DATE(&quot;2022-12-01&quot;)' />
            </column>
            <column caption='Current Month' datatype='date' name='[Calculation_575334912863383556]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='Last Month&apos;s Actual Headcount' datatype='integer' name='[Calculation_575334912884666376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is Previous Month (copy)_575334912887881738] = TRUE THEN [Calculation_575334912888147979] ELSE 0 END' />
            </column>
            <column caption='Last Month' datatype='date' name='[Calculation_575334912887799817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos; , -1 , [Calculation_575334912863383556]))' />
            </column>
            <column caption='HC Actual' datatype='integer' name='[Calculation_575334912888147979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([actual]) + (IFNULL([remote_hires],0))' />
            </column>
            <column caption='Starters Confirmed' datatype='integer' name='[Calculation_575334913143062544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [YTD (copy)_575334913142734863] = TRUE THEN [future_starters] ELSE 0 END' />
            </column>
            <column caption='Months Left of Current Year' datatype='integer' name='[Calculation_575334913145372690]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='12 - INT(MONTH([Calculation_575334912863383556])) + 1' />
            </column>
            <column caption='Attrition Hires' datatype='real' name='[Calculation_575334913148092436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_575334912884666376] *&#13;&#10;&#13;&#10;(([Parameters].[Parameter 3]/12) * [Calculation_575334913145372690]),0)' />
            </column>
            <column caption='Forecasted Headcount vs Dec Budget' datatype='real' name='[Calculation_575334913151635477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_575334912859316224])&#13;&#10;-&#13;&#10;    (&#13;&#10;        SUM([Calculation_575334912884666376])&#13;&#10;        +&#13;&#10;        SUM([Calculation_575334913143062544])&#13;&#10;        -&#13;&#10;        SUM([Starters Confirmed (copy)_575334913144393745])&#13;&#10;    )' />
            </column>
            <column caption='To Hire in 2022' datatype='real' name='[Calculation_575334913156395032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Left to Hire (copy)_575334913155399703]) + SUM([Calculation_575334913148092436])' />
            </column>
            <column datatype='string' name='[Department (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[department]' new-bin='true'>
                <bin default-name='false' value='&quot;International&quot;'>
                  <value>&quot;DH International&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Marketing&quot;'>
                  <value>&quot;DH Marketing&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Null&quot;'>
                  <value>%null%</value>
                </bin>
                <bin default-name='false' value='&quot;Oeconomicis&quot;'>
                  <value>&quot;DH Legal&quot;</value>
                  <value>&quot;DH Oeconomicis&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;People &amp; Culture&quot;'>
                  <value>&quot;DH People &amp; Culture&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Product&quot;'>
                  <value>&quot;DH Product&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Social Commerce&quot;'>
                  <value>&quot;DH Social Commerce&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Strategy&quot;'>
                  <value>&quot;DH CEO Office &amp; Strategy&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Tech&quot;'>
                  <value>&quot;DH Tech&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Is Last Month' datatype='boolean' name='[Is Previous Month (copy)_575334912887881738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month] = [Calculation_575334912887799817]' />
            </column>
            <column caption='Left to Hire' datatype='real' name='[Left to Hire (copy)_575334913155399703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_575334913151635477] &lt; 0 THEN 0 ELSE [Calculation_575334913151635477] END' />
            </column>
            <column caption='Terminations Confirmed' datatype='integer' name='[Starters Confirmed (copy)_575334913144393745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [YTD (copy)_575334913142734863] = TRUE THEN [future_terminations_effective] ELSE 0 END' />
            </column>
            <column caption='This month until December' datatype='boolean' name='[YTD (copy)_575334913142734863]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month] &gt;= [Calculation_575334912863383556]&#13;&#10;AND YEAR([month]) = YEAR(TODAY())' />
            </column>
            <column caption='Actual' datatype='integer' name='[actual]' role='measure' type='quantitative' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Future Starters' datatype='integer' name='[future_starters]' role='measure' type='quantitative' />
            <column caption='Future Terminations Effective' datatype='integer' name='[future_terminations_effective]' role='measure' type='quantitative' />
            <column caption='Hc Budget' datatype='real' name='[hc_budget]' role='measure' type='quantitative' />
            <column caption='Month' datatype='datetime' name='[month]' role='dimension' type='ordinal' />
            <column caption='Remote Hires' datatype='integer' name='[remote_hires]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_575334913156395032]' derivation='User' name='[usr:Calculation_575334913156395032:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ttamet07pxsaf1dt09cl0qa7zuu].[:Measure Names]'>
