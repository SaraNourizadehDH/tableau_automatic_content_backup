    <worksheet name='Left to Hire'>
      <table>
        <view>
          <datasources>
            <datasource caption='Budget' name='federated.0ttamet07pxsaf1dt09cl0qa7zuu' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Estimated Year Attrition' datatype='real' datatype-customized='true' default-format='p0%' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.20'>
              <calculation class='tableau' formula='0.20' />
              <range max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ttamet07pxsaf1dt09cl0qa7zuu'>
            <column caption='December 2022 HC Budget' datatype='real' name='[Calculation_575334912859316224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_575334912859516929] = TRUE THEN [hc_budget] ELSE 0 END' />
            </column>
            <column caption='December 2022' datatype='boolean' name='[Calculation_575334912859516929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month] = DATE(&quot;2022-12-01&quot;)' />
            </column>
            <column caption='Current Month' datatype='date' name='[Calculation_575334912863383556]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='Last Month&apos;s Actual Headcount' datatype='integer' name='[Calculation_575334912884666376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Is Previous Month (copy)_575334912887881738] = TRUE THEN [Calculation_575334912888147979] ELSE 0 END' />
            </column>
            <column caption='Last Month' datatype='date' name='[Calculation_575334912887799817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos; , -1 , [Calculation_575334912863383556]))' />
            </column>
            <column caption='HC Actual' datatype='integer' name='[Calculation_575334912888147979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([actual]) + (IFNULL([remote_hires],0))' />
            </column>
            <column caption='Starters Confirmed' datatype='integer' name='[Calculation_575334913143062544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [YTD (copy)_575334913142734863] = TRUE THEN [future_starters] ELSE 0 END' />
            </column>
            <column caption='Months Left of Current Year' datatype='integer' name='[Calculation_575334913145372690]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='12 - INT(MONTH([Calculation_575334912863383556])) + 1' />
            </column>
            <column caption='Attrition Hires' datatype='real' name='[Calculation_575334913148092436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_575334912884666376] *&#13;&#10;&#13;&#10;(([Parameters].[Parameter 3]/12) * [Calculation_575334913145372690]),0)' />
