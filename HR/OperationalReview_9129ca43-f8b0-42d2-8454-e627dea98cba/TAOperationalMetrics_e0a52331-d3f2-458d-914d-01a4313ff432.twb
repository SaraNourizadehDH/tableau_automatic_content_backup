        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='AND'>
              <expression op='='>
                <expression op='[oh_cc_summary_mon_].[cost_center_id]' />
                <expression op='[source_performance].[cost_center_id]' />
              </expression>
              <expression op='='>
                <expression op='[oh_cc_summary_mon_].[month]' />
                <expression op='[source_performance].[month]' />
              </expression>
            </expression>
          </clause>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[oh_cc_summary_mon_].[cost_center_id]' />
                <expression op='[cc_hierarchy_all].[cost_center_id]' />
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='AND'>
                  <expression op='='>
                    <expression op='[oh_cc_summary_mon_].[month]' />
                    <expression op='[time_to].[month]' />
                  </expression>
                  <expression op='='>
                    <expression op='[oh_cc_summary_mon_].[cost_center_id]' />
                    <expression op='[time_to].[cost_center_id]' />
                  </expression>
                </expression>
              </clause>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[oh_cc_summary_mon_].[month]' />
                      <expression op='[talenthub_data].[survey_date]' />
                    </expression>
                    <expression op='='>
                      <expression op='[oh_cc_summary_mon_].[cost_center_id]' />
                      <expression op='[talenthub_data].[cost_center_id]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='athena.1mxqu5k1p1eu881ceoh59132o6i8' name='oh_cc_summary_mon_' table='[dev].[oh_cc_summary_mon_dhse]' type='table' />
                <relation connection='athena.1mxqu5k1p1eu881ceoh59132o6i8' name='talenthub_data' type='text'>SELECT&#13;
	date_trunc(&apos;month&apos;,a.response_date) as survey_date,&#13;
	cc.department as department,&#13;
        cc.cost_center_id,&#13;
	(CASE CAST(a.answers as INT)&#13;
		WHEN 10 THEN &apos;Promoter&apos;&#13;
		WHEN 9 THEN &apos;Promoter&apos;&#13;
		WHEN 8 THEN &apos;Passive&apos;&#13;
		WHEN 7 THEN &apos;Passive&apos;&#13;
		WHEN 6 THEN &apos;Detractor&apos;&#13;
		WHEN 5 THEN &apos;Detractor&apos;&#13;
		WHEN 4 THEN &apos;Detractor&apos;&#13;
		WHEN 3 THEN &apos;Detractor&apos;&#13;
		WHEN 2 THEN &apos;Detractor&apos;&#13;
		WHEN 1 THEN &apos;Detractor&apos;&#13;
		WHEN 0 THEN &apos;Detractor&apos;&#13;
		END) as candidate_nps,&#13;
	COUNT(a.answers) as &quot;count&quot;,&#13;
	AVG(CAST(a.answers as INT)) as CPS_Score&#13;
FROM people_ops_il.recruitment_survey_results a&#13;
LEFT JOIN (&#13;
	SELECT  &#13;
		question_id,&#13;
		question,&#13;
		question_type,&#13;
		topic,&#13;
		count(question_id)&#13;
	FROM people_ops_il.recruitment_survey_questions&#13;
	GROUP BY 1,2,3,4&#13;
		) b&#13;
ON a.question_id = b.question_id&#13;
LEFT JOIN people_ops_il.job_requisition jr &#13;
	ON a.job_requisition_id = jr.job_requisition_id&#13;
LEFT JOIN people_ops_il.cc_hierarchy_all cc&#13;
	ON jr.cost_center_id = cc.cost_center_id&#13;
WHERE (b.question_type = &apos;0-10 rating (slider)&apos; or b.question_type = &apos;1-5 rating (stars)&apos;)&#13;
	AND jr.company_id = &apos;1001&apos; and department is not null &#13;
	AND b.question = &apos;How likely would you be to recommend others to apply for a job at {org}?&apos;&#13;
	AND a.survey in &#13;
		(&apos;04 M21 Rejection after interview&apos;,&apos;05 M21 Offer accepted&apos;,&#13;
		&apos;06 M21 Offer rejected&apos;)&#13;
GROUP BY 1,2,3,4</relation>
              </relation>
              <relation connection='athena.1mxqu5k1p1eu881ceoh59132o6i8' name='time_to' type='text'>SELECT&#13;
    date_month as month,&#13;
    cost_center_id,&#13;
	SUM(count_ttf) AS count_ttf,&#13;
	SUM(median_ttf * count_ttf) / SUM(count_ttf) AS ttf,&#13;
	SUM(count_tth) AS count_tth,&#13;
	SUM(median_tth * count_tth) / SUM(count_tth) AS tth,&#13;
	SUM(count_tts) AS count_tts,&#13;
	SUM(median_tts * count_tts) / SUM(count_tts) AS tts&#13;
FROM &#13;
    people_ops_bl.talent_acquisition_metrics&#13;
GROUP BY &#13;
    1, 2</relation>
            </relation>
            <relation connection='athena.1mxqu5k1p1eu881ceoh59132o6i8' name='cc_hierarchy_all' table='[people_ops_il].[cc_hierarchy_all]' type='table' />
          </relation>
          <relation connection='athena.1mxqu5k1p1eu881ceoh59132o6i8' name='source_performance' type='text'>WITH source_applications AS &#13;
	(&#13;
	SELECT&#13;
		date_trunc(&apos;month&apos;,application_date) as &quot;month&quot;,&#13;
		cost_center_id,&#13;
		CASE &quot;source&quot; &#13;
			WHEN &apos;Social Media -&gt;&gt; LinkedIn - corporate page&apos; THEN &apos;LinkedIn&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee Emailed me the job&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; Employee Referral&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee&apos;&apos;s LinkedIn feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employees Twitter feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; I know someone at this company&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Internal -&gt;&gt; Current Worker&apos; THEN &apos;Internal&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Delivery Hero Website&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; HungerStation Career Site&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Talabat Career Site&apos; THEN &apos;Career site&apos;&#13;
			ELSE NULL&#13;
		END as key_source,&#13;
		count(distinct candidate_wd_id) as unique_applicants&#13;
	FROM &#13;
		people_ops_il.recruitment_corpus &#13;
	WHERE &#13;
		company_id = &apos;1001&apos;&#13;
		AND (CASE &quot;source&quot; &#13;
			WHEN &apos;Social Media -&gt;&gt; LinkedIn - corporate page&apos; THEN &apos;LinkedIn&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee Emailed me the job&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; Employee Referral&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee&apos;&apos;s LinkedIn feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employees Twitter feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; I know someone at this company&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Internal -&gt;&gt; Current Worker&apos; THEN &apos;Internal&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Delivery Hero Website&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; HungerStation Career Site&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Talabat Career Site&apos; THEN &apos;Career site&apos;&#13;
			ELSE NULL&#13;
			END) is not null&#13;
	GROUP BY &#13;
		1,2,3&#13;
	),&#13;
source_hires AS &#13;
	(&#13;
	SELECT&#13;
		date_trunc(&apos;month&apos;,w.handover_to_corops_date) as &quot;month&quot;,&#13;
		r.cost_center_id,&#13;
		CASE &quot;source&quot; &#13;
			WHEN &apos;Social Media -&gt;&gt; LinkedIn - corporate page&apos; THEN &apos;LinkedIn&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee Emailed me the job&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; Employee Referral&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee&apos;&apos;s LinkedIn feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employees Twitter feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; I know someone at this company&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Internal -&gt;&gt; Current Worker&apos; THEN &apos;Internal&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Delivery Hero Website&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; HungerStation Career Site&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Talabat Career Site&apos; THEN &apos;Career site&apos;&#13;
			ELSE NULL&#13;
			END as key_source,&#13;
		count(w.employee_id) hires&#13;
	FROM &#13;
		people_ops_il.recruitment_corpus r&#13;
	LEFT JOIN&#13;
		people_ops_il.worker_hired w&#13;
	ON &#13;
		r.job_requisition_id = w.job_requisition_id&#13;
		AND r.employee_id = w.employee_id &#13;
	WHERE &#13;
		r.company_id = &apos;1001&apos;&#13;
		AND (CASE &quot;source&quot; &#13;
			WHEN &apos;Social Media -&gt;&gt; LinkedIn - corporate page&apos; THEN &apos;LinkedIn&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee Emailed me the job&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; Employee Referral&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employee&apos;&apos;s LinkedIn feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Social Referral -&gt;&gt; Employees Twitter feed&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Direct Source -&gt;&gt; I know someone at this company&apos; THEN &apos;Referral&apos;&#13;
			WHEN &apos;Internal -&gt;&gt; Current Worker&apos; THEN &apos;Internal&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Delivery Hero Website&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; HungerStation Career Site&apos; THEN &apos;Career site&apos;&#13;
			WHEN &apos;Career Site -&gt;&gt; Talabat Career Site&apos; THEN &apos;Career site&apos;&#13;
			ELSE NULL&#13;
			END) is not null&#13;
		AND w.handover_to_corops_date is not null&#13;
		GROUP BY&#13;
		1,2,3&#13;
	)	&#13;
SELECT&#13;
	&quot;month&quot;,&#13;
	cost_center_id,&#13;
	key_source,&#13;
	sa.unique_applicants,&#13;
	sh.hires&#13;
FROM &#13;
	source_applications sa&#13;
FULL OUTER JOIN &#13;
	source_hires sh&#13;
USING &#13;
	(&quot;month&quot;,cost_center_id,key_source)</relation>
