    <worksheet name='YoY Variations'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='16'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TA Metrics' name='federated.0sxnvju0lp4c20118bffv0lp5qgg' />
          </datasources>
          <datasource-dependencies datasource='federated.0sxnvju0lp4c20118bffv0lp5qgg'>
            <column caption='# Applicants Internal' datatype='integer' name='[# Applicants Career Site (copy)_397442673053233155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [key_source] = &apos;Internal&apos; THEN { FIXED [month],[cost_center_id] : MIN([unique_applicants]) } END' />
            </column>
            <column caption='# Applicants LinkedIn' datatype='integer' name='[# Applicants Internal (copy)_397442673053294596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [key_source] = &apos;LinkedIn&apos; THEN { FIXED [month],[cost_center_id] : MIN([unique_applicants]) } END' />
            </column>
            <column caption='# Applicants Referral' datatype='integer' name='[# Applicants LinkedIn (copy)_397442673053351941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [key_source] = &apos;Referral&apos; THEN { FIXED [month],[cost_center_id] : MIN([unique_applicants]) } END' />
            </column>
            <column caption='2. Hiring' datatype='integer' name='[1. Headcount &amp; Attrition (copy)_321725916785831960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if PREVIOUS_VALUE(0) = 1 then 1 else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='3. Time To&apos;s' datatype='integer' name='[2. Hiring (copy)_321725916786094105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if PREVIOUS_VALUE(0) = 1 then 1 else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='4. Source Performance' datatype='integer' name='[3. Time To&apos;s (copy) (copy)_397442673028911105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if PREVIOUS_VALUE(0) = 1 then 1 else null end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Actual ' datatype='integer' default-format='N' name='[Actual (copy)_931963668743471108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month],[cost_center_id] : MIN([actual])}' />
            </column>
            <column caption='Median TTF' datatype='real' default-format='n#,##0;-#,##0' name='[Avg TTF (copy)_352406716090834946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TTF (copy)_1387953160390627337] * [Count TTF (copy)_1387953160387358726])&#13;&#10;/&#13;&#10;SUM([Count TTF (copy)_1387953160387358726])' />
            </column>
            <column caption='Median TTH' datatype='real' default-format='n#,##0;-#,##0' name='[Avg TTH (copy)_352406716090920963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TTH (copy)_1387953160390627338] * [Count TTH (copy)_1387953160387358727])&#13;&#10;/&#13;&#10;SUM([Count TTH (copy)_1387953160387358727])' />
            </column>
            <column caption='Median TTS' datatype='real' default-format='n#,##0;-#,##0' name='[Avg TTSc (copy)_352406716091002884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TTS (copy)_1387953160390627339] * [Count TTS (copy)_1387953160387358728])&#13;&#10;/&#13;&#10;SUM([Count TTS (copy)_1387953160387358728])' />
            </column>
            <column caption='Avg. CPS Score' datatype='real' name='[CPS_Score]' role='measure' type='quantitative' />
            <column caption='Current Month' datatype='date' datatype-customized='true' name='[Calculation_1316458484170522627]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='Previous Month' datatype='date' datatype-customized='true' name='[Calculation_1316458484184473617]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos; , -2 , [Calculation_1316458484170522627]))' />
            </column>
            <column caption='Female Count ' datatype='integer' name='[Calculation_1669146654943531008]' role='measure' type='quantitative'>
