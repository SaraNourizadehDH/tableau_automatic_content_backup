          <object caption='il_time_off_balanc' id='il_time_off_balance_BBCC25C771D043EFA90A03F4E9890527'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[il_time_off_balanc].[employee_id]' />
                    <expression op='[Manager].[employee_id]' />
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[il_time_off_balanc].[employee_id]' />
                      <expression op='[il_worker_personal].[employee_id]' />
                    </expression>
                  </clause>
                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='='>
                        <expression op='[il_time_off_balanc].[cost_center_id]' />
                        <expression op='[il_cc_hierarchy_la].[cost_center_id]' />
                      </expression>
                    </clause>
                    <relation join='left' type='join'>
                      <clause type='join'>
                        <expression op='='>
                          <expression op='[il_time_off_balanc].[employee_id]' />
                          <expression op='[il_worker_org].[employee_id]' />
                        </expression>
                      </clause>
                      <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='il_time_off_balanc' table='[people_ops_proposed].[il_time_off_balance]' type='table' />
                      <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='il_worker_org' table='[people_ops_proposed].[il_worker_org]' type='table'>
                        <columns>
                          <column datatype='date' date-parse-format='yyyy-MM-dd' name='first_day_of_work' />
                        </columns>
                      </relation>
                    </relation>
                    <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='il_cc_hierarchy_la' table='[people_ops_proposed].[il_cc_hierarchy_latam]' type='table' />
                  </relation>
                  <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='il_worker_personal' table='[people_ops_proposed].[il_worker_personal]' type='table' />
                </relation>
                <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='Manager' type='text'>select&#13;
m.*,&#13;
i.work_email as mail_manager_04,&#13;
ii.work_email as mail_manager_05,&#13;
iii.work_email as mail_manager_06,&#13;
iiii.work_email as mail_manager_07,&#13;
cc.department,&#13;
cc.sub_department,&#13;
cc.&quot;scope&quot;,&#13;
cc.country&#13;
from &#13;
people_ops_proposed.il_manager m&#13;
&#13;
left join people_ops_proposed.il_worker_org i on &#13;
m.manager_id_04 = i.employee_id &#13;
