    <worksheet name='Tabla resumen'>
      <table>
        <view>
          <datasources>
            <datasource caption='il_time_off_balance+ (people_ops_proposed)' name='federated.1tu4cyy0lm00ae1c53tbx18b2w72' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;País&quot;'>
              <calculation class='tableau' formula='&quot;País&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tu4cyy0lm00ae1c53tbx18b2w72'>
            <column caption='Nombre y Apellido' datatype='string' name='[Calculation_1082552785676288000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[first_name]+&apos; &apos;+[last_name]' />
            </column>
            <column caption='Acumulados' datatype='real' name='[Calculation_1232297468496232448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[balance_as_of_date]-[assigned_this_year]' />
            </column>
            <column caption='Saldo acumulado pendiente' datatype='real' name='[Calculation_1232297468497858562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1232297468496232448]&lt;0&#13;&#10;then 0&#13;&#10;else [Calculation_1232297468496232448]&#13;&#10;END' />
            </column>
            <column caption='Confidencial' datatype='integer' name='[Calculation_1771322028443099138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [mail_manager_04]=USERNAME()&#13;&#10;then 1 &#13;&#10;ELSEIF [mail_manager_05]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [manager_05_full_name]=&apos;Federico de Pro&apos;&#13;&#10;AND ISUSERNAME(&apos;federico.de.2@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [mail_manager_06]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [mail_manager_07]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [manager_06_full_name]=&apos;Santiago Rego Vlahussich&apos;&#13;&#10;AND ISUSERNAME(&apos;Santiago.rego@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_07_full_name]=&apos;Santiago Rego Vlahussich&apos;&#13;&#10;AND ISUSERNAME(&apos;Santiago.rego@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF ISMEMBEROF(&apos;PedidosYa - People Partners&apos;)&#13;&#10;or ISMEMBEROF(&apos;PedidosYa - PMO, Solutions &amp; System&apos;)&#13;&#10;or ISUSERNAME(&apos;daniela.alonso@pedidosya.com&apos;)&#13;&#10;or ISUSERNAME(&apos;sabrina.flores@pedidosya.com&apos;)&#13;&#10;THEN 1  &#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Tipo de licencia' datatype='string' name='[Calculation_1808195270534402048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [time_off_plan]in (&apos;ARG Vacaciones (Ley)&apos;,&apos;ARG Vacaciones (Operational)&apos;,&apos;CRI Holidays - Vacaciones&apos;,&apos;CRI Holidays - Vacaciones (Operational)&apos;,&#13;&#10;&apos;ECU Holidays - Vacaciones&apos;,&apos;ECU Holidays - Vacaciones (Operational)&apos;,&apos;GTM Holidays - Vacaciones (Platform+CW) TOP&apos;,&apos;GTM Holidays - Vacaciones DMARTS (TOP)&apos;,&#13;&#10;&apos;HND Holidays - Vacaciones&apos;,&apos;HND Holidays - Vacaciones Operational&apos;,&apos;Holidays - Vacaciones (BOL)&apos;,&apos;Holidays - Vacaciones (CHL)&apos;,&apos;Holidays - Vacaciones (DOM)&apos;,&#13;&#10;&apos;Holidays - Vacaciones (PAN)&apos;,&apos;Holidays - Vacaciones (PRY)&apos;,&apos;Holidays - Vacaciones (URY)&apos;,&apos;Holidays - Vacaciones Operational (DOM)&apos;,&apos;Holidays - Vacaciones Operational (PAN)&apos;,&#13;&#10;&apos;NIC Holidays - Vacaciones&apos;,&apos;PER Holidays - Vacaciones (2023) Time Off Plan&apos;,&apos;SV Holidays - Vacaciones&apos;,&apos;URY Holidays - Vacaciones (Operational)&apos;,&#13;&#10;&apos;VEN Holidays - Vacaciones&apos;)&#13;&#10;then &apos;Vacaciones Ley&apos;&#13;&#10;ELSEIF CONTAINS([time_off_plan],&quot;eneficio&quot;)&#13;&#10;then &apos;Vacaciones Beneficio&apos;&#13;&#10;ELSE [time_off_plan]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Vacaciones Ley&quot;' value='Vacaciones Ley (hábiles)' />
              </aliases>
            </column>
            <column caption='Vista' datatype='string' name='[Calculation_470063251380133888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;País&apos; THEN [country]&#13;&#10;WHEN &apos;Departamento&apos; THEN [department]&#13;&#10;END' />
            </column>
            <column caption='Antigüedad (años)' datatype='real' name='[Calculation_737745939978149889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[time_in_company]/365' />
            </column>
            <column caption='Assigned This Year' datatype='real' name='[assigned_this_year]' role='dimension' type='quantitative' />
