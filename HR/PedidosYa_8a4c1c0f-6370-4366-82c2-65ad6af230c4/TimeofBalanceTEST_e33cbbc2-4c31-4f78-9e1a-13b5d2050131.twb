        WHEN &apos;URY Vacaciones Extra TO (2023)&apos; THEN &apos;URY Vacaciones Extra TOP&apos;&#13;
        WHEN &apos;VEN Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;VEN Holidays - Vacaciones&apos;&#13;
        ELSE time_off_type&#13;
