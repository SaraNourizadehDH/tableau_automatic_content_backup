          <relation connection='athena.14sqhhi1waogvc12s3o8n0y61zga' name='consulta_sql_perso' type='text'>SELECT &#13;
    employee_id,&#13;
    CASE time_off_type&#13;
        WHEN &apos;ARG Vacaciones (Dias de Beneficio) Time Off (2023)&apos; THEN &apos;ARG Vacaciones (Dias de Beneficio)&apos;&#13;
        WHEN &apos;ARG Vacaciones (Operational) Time Off (2023)&apos; THEN &apos;ARG Vacaciones (Operational)&apos;&#13;
        WHEN &apos;ARG Vacation (Ley) Time Off (2023)&apos; THEN &apos;ARG Vacaciones (Ley)&apos;&#13;
        WHEN &apos;CRI Holidays - Vacaciones (Operational) Time Off (2023)&apos; THEN &apos;CRI Holidays - Vacaciones (Operational)&apos;&#13;
        WHEN &apos;CRI Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;CRI Holidays - Vacaciones&apos;&#13;
        WHEN &apos;ECU Holidays - Vacaciones (Beneficio Pedidos Ya) Time Off&apos; THEN &apos;ECU Holidays - Vacaciones (Beneficio Pedidos Ya)&apos;&#13;
        WHEN &apos;ECU Holidays - Vacaciones (Operational) Time Off (2023)&apos; THEN &apos;ECU Holidays - Vacaciones (Operational)&apos;&#13;
        WHEN &apos;ECU Holidays - Vacaciones Time Off&apos; THEN &apos;ECU Holidays - Vacaciones&apos;&#13;
        WHEN &apos;GTM Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;GTM Holidays - Vacaciones (Platform+CW) TOP&apos;&#13;
        WHEN &apos;GTM Vacaciones Time Off DMARTS (2023)&apos; THEN &apos;GTM Holidays - Vacaciones DMARTS (TOP)&apos;&#13;
        WHEN &apos;HND Holidays - Vacaciones Operational Time Off (2023)&apos; THEN &apos;HND Holidays - Vacaciones Operational&apos;&#13;
        WHEN &apos;HND Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;HND Holidays - Vacaciones&apos;&#13;
        WHEN &apos;Holidays - Vacaciones (DOM)&apos; THEN &apos;Holidays - Vacaciones (DOM)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones (PAN) (2023)&apos; THEN &apos;Holidays - Vacaciones (PAN)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones (URY) (2023)&apos; THEN &apos;Holidays - Vacaciones (URY)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones (URY) Accrual Year&apos; THEN &apos;Holidays - Vacaciones (URY) Accrual Year&apos;&#13;
        WHEN &apos;Holidays - Vacaciones ARG&apos; THEN &apos;ARG Vacaciones (Ley)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones BOL (2023)&apos; THEN &apos;Holidays - Vacaciones (BOL)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones CHL (2023)&apos; THEN &apos;Holidays - Vacaciones (CHL)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones Operational (DOM) Time Off (2023)&apos; THEN &apos;Holidays - Vacaciones Operational (DOM)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones Operational (PAN) (2023)&apos; THEN &apos;Holidays - Vacaciones Operational (PAN)&apos;&#13;
        WHEN &apos;Holidays - Vacaciones PRY (2023)&apos; THEN &apos;Holidays - Vacaciones (PRY)&apos;&#13;
        WHEN &apos;LATAM Casual Days (2023)&apos; THEN &apos;Casual Days (LATAM)&apos;&#13;
        WHEN &apos;LATAM Casual Days (Dmarts) (2023)&apos; THEN &apos;LATAM Casual Days (Dmarts)&apos;&#13;
        WHEN &apos;NIC Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;NIC Holidays - Vacaciones&apos;&#13;
        WHEN &apos;PER Holidays - Vacaciones Time Off&apos; THEN &apos;PER Holidays - Vacaciones (2023) Time Off Plan&apos;&#13;
        WHEN &apos;PER Vacaciones Time Off (2023)&apos; THEN &apos;PER Holidays - Vacaciones (2023) Time Off Plan&apos;&#13;
        WHEN &apos;SV Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;SV Holidays - Vacaciones&apos;&#13;
        WHEN &apos;URY Holidays - Vacaciones (Operational) (2023)&apos; THEN &apos;URY Holidays - Vacaciones (Operational)&apos;&#13;
        WHEN &apos;URY Vacaciones Extra TO (2023)&apos; THEN &apos;URY Vacaciones Extra TOP&apos;&#13;
        WHEN &apos;VEN Holidays - Vacaciones Time Off (2023)&apos; THEN &apos;VEN Holidays - Vacaciones&apos;&#13;
        ELSE time_off_type&#13;
    END AS time_off_type_limpio,&#13;
    SUM(CAST(approved_time_off AS DOUBLE)) AS total&#13;
FROM people_ops_proposed.il_time_off&#13;
WHERE time_off_type IN (&#13;
    &apos;ARG Vacaciones (Dias de Beneficio) Time Off (2023)&apos;,&#13;
    &apos;ARG Vacaciones (Operational) Time Off (2023)&apos;,&#13;
    &apos;ARG Vacation (Ley) Time Off (2023)&apos;,&#13;
    &apos;CRI Holidays - Vacaciones (Operational) Time Off (2023)&apos;,&#13;
    &apos;CRI Holidays - Vacaciones Time Off (2023)&apos;,&#13;
    &apos;ECU Holidays - Vacaciones (Beneficio Pedidos Ya) Time Off&apos;,&#13;
    &apos;ECU Holidays - Vacaciones (Operational) Time Off (2023)&apos;,&#13;
    &apos;ECU Holidays - Vacaciones Time Off&apos;,&#13;
    &apos;GTM Holidays - Vacaciones Time Off (2023)&apos;,&#13;
    &apos;GTM Vacaciones Time Off DMARTS (2023)&apos;,&#13;
    &apos;HND Holidays - Vacaciones Operational Time Off (2023)&apos;,&#13;
    &apos;HND Holidays - Vacaciones Time Off (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones (DOM)&apos;,&#13;
    &apos;Holidays - Vacaciones (PAN) (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones (URY) (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones (URY) Accrual Year&apos;,&#13;
    &apos;Holidays - Vacaciones ARG&apos;,&#13;
    &apos;Holidays - Vacaciones BOL (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones CHL (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones Operational (DOM) Time Off (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones Operational (PAN) (2023)&apos;,&#13;
    &apos;Holidays - Vacaciones PRY (2023)&apos;,&#13;
    &apos;LATAM Casual Days (2023)&apos;,&#13;
    &apos;LATAM Casual Days (Dmarts) (2023)&apos;,&#13;
    &apos;NIC Holidays - Vacaciones Time Off (2023)&apos;,&#13;
    &apos;PER Holidays - Vacaciones Time Off&apos;,&#13;
    &apos;PER Vacaciones Time Off (2023)&apos;,&#13;
    &apos;SV Holidays - Vacaciones Time Off (2023)&apos;,&#13;
    &apos;URY Holidays - Vacaciones (Operational) (2023)&apos;,&#13;
    &apos;URY Vacaciones Extra TO (2023)&apos;,&#13;
    &apos;VEN Holidays - Vacaciones Time Off (2023)&apos;&#13;
)&#13;
AND CAST(time_off_date AS DATE) &gt;&gt; current_date&#13;
GROUP BY employee_id,&#13;
    CASE time_off_type&#13;
        WHEN &apos;ARG Vacaciones (Dias de Beneficio) Time Off (2023)&apos; THEN &apos;ARG Vacaciones (Dias de Beneficio)&apos;&#13;
        WHEN &apos;ARG Vacaciones (Operational) Time Off (2023)&apos; THEN &apos;ARG Vacaciones (Operational)&apos;&#13;
