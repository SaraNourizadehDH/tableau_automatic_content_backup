          <datasource-dependencies datasource='federated.1i49xii1hhq6i516gbz6x181fvrn'>
            <column caption='Sellers' datatype='string' name='[Calculation_1048494289000321024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [position] = &apos;Account Executive&apos; OR &#13;&#10;   [position] = &apos;Sales Executive&apos; OR &#13;&#10;   [position] = &apos;Commercial Intern&apos; OR &#13;&#10;   [position] = &apos;Performance Executive&apos; AND &#13;&#10;   [department] = &apos;Sales&apos; THEN &apos;Sellers&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
            </column>
            <column caption='Asistencia sincronica' datatype='integer' name='[Calculation_1776951594621239298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [¿Diploma?]= &apos;SI&apos; then 1 ELSE 0 END)' />
            </column>
            <column caption='Tasa de asistencia (Sincronica)' datatype='real' name='[Calculation_1776951594621370371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1776951594621239298]/COUNT([Email])' />
            </column>
            <column aggregation='CountD' caption='Elegir Vista S' datatype='string' name='[Calculation_464152304005226496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]     &#13;&#10;    when &quot;Country&quot; then [country]&#13;&#10;    when &quot;Level Category&quot; then [levels]&#13;&#10;    when &quot;Management Level&quot; then [management_level]&#13;&#10;    when &quot;Business Title&quot; then [business_title]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;Curso&quot; then [Curso]&#13;&#10;    when &quot;Location&quot; THEN [office_location]&#13;&#10;    when &quot;Departamento&quot; THEN [department]&#13;&#10;else &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Tasa de ausentismo' datatype='real' name='[Calculation_464152304007909377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- [Calculation_1776951594621370371]' />
            </column>
            <column caption='Inscriptos' datatype='integer' name='[Calculation_464152304008216578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Email])' />
            </column>
