      <aliases enabled='yes' />
      <column caption='Sellers' datatype='string' name='[Calculation_1048494289000321024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [position] = &apos;Account Executive&apos; OR &#13;&#10;   [position] = &apos;Sales Executive&apos; OR &#13;&#10;   [position] = &apos;Commercial Intern&apos; OR &#13;&#10;   [position] = &apos;Performance Executive&apos; AND &#13;&#10;   [department] = &apos;Sales&apos; THEN &apos;Sellers&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='Asistencia sincronica' datatype='integer' name='[Calculation_1776951594621239298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [¿Diploma?]= &apos;SI&apos; then 1 ELSE 0 END)' />
      </column>
      <column caption='Tasa de asistencia (Sincronica)' datatype='real' name='[Calculation_1776951594621370371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1776951594621239298]/COUNT([Email])' />
      </column>
      <column caption='Promotores' datatype='integer' name='[Calculation_1776951595029319697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [¿Cómo calificarías tu satisfacción general de la experiencia de aprendizaje?] &gt; 8 THEN 1 ELSE 0 end' />
      </column>
      <column caption='Detractores' datatype='integer' name='[Calculation_1776951595029405714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [¿Cómo calificarías tu satisfacción general de la experiencia de aprendizaje?] &lt; 6  THEN 1 ELSE 0 end' />
      </column>
      <column caption='Total' datatype='integer' name='[Calculation_1776951595029508115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [¿Cómo calificarías tu satisfacción general de la experiencia de aprendizaje?] &gt; 0 THEN 1 ELSE 0 end' />
      </column>
      <column caption='% Promotores' datatype='real' name='[Calculation_1776951595029655572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1776951595029319697])/SUM([Calculation_1776951595029508115])' />
      </column>
      <column caption='% Detractores' datatype='real' name='[Calculation_1776951595029749781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1776951595029405714])&#13;&#10;/SUM([Calculation_1776951595029508115])' />
      </column>
      <column caption='eNPS' datatype='real' name='[Calculation_1776951595029823510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1776951595029655572]-[Calculation_1776951595029749781])*100' />
      </column>
      <column caption='Personas capacitadas Sincronicas' datatype='real' name='[Calculation_1776951595052093474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [¿Diploma?]= &apos;SI&apos; then       [Email (Curso Presencial)]END)' />
      </column>
      <column caption='# Personas capacitadas' datatype='integer' name='[Calculation_1776951595052318755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [¿Diploma?]= &apos;SI&apos; then       [Email]end )' />
      </column>
      <column caption='Cursos' datatype='integer' name='[Calculation_1776951595052638244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Curso])' />
      </column>
      <column caption='% de personas registradas vs activos' datatype='real' name='[Calculation_1776951595052843045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1776951595052933159]/([Calculation_1776951595053113384])' />
      </column>
      <column caption='Personas inscriptas presencial' datatype='integer' name='[Calculation_1776951595052933159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Email])' />
      </column>
      <column caption='Empleados activos' datatype='integer' name='[Calculation_1776951595053113384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actual])' />
      </column>
      <column aggregation='CountD' caption='Elegir Vista S' datatype='string' name='[Calculation_464152304005226496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]     &#13;&#10;    when &quot;Country&quot; then [country]&#13;&#10;    when &quot;Level Category&quot; then [levels]&#13;&#10;    when &quot;Management Level&quot; then [management_level]&#13;&#10;    when &quot;Business Title&quot; then [business_title]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;Curso&quot; then [Curso]&#13;&#10;    when &quot;Location&quot; THEN [office_location]&#13;&#10;    when &quot;Departamento&quot; THEN [department]&#13;&#10;else &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Tasa de ausentismo' datatype='real' name='[Calculation_464152304007909377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1- [Calculation_1776951594621370371]' />
      </column>
