      <table>
        <view>
          <datasources>
            <datasource caption='Asincrónico' name='federated.1jbmazu1jb75u710vgslo0pzu1qm' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jbmazu1jb75u710vgslo0pzu1qm'>
            <column caption='Sellers' datatype='string' name='[Calculation_1048494289002991617]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [position] = &apos;Account Executive&apos; OR &#13;&#10;   [position] = &apos;Sales Executive&apos; OR &#13;&#10;   [position] = &apos;Commercial Intern&apos; OR &#13;&#10;   [position] = &apos;Performance Executive&apos; AND &#13;&#10;   [department] = &apos;Sales&apos; THEN &apos;Sellers&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
            </column>
            <column caption='Cursos Iniciados' datatype='integer' name='[Calculation_1591178105415454732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Porcentaje de finalización] &gt; 0.09 then 1 else 0 end' />
            </column>
            <column caption='Cursos finalizados' datatype='integer' name='[Calculation_1591178105445249042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Porcentaje de finalización (LIL (2))] = 1 then 1 ELSE 0 END' />
            </column>
            <column caption='Personas activas' datatype='integer' name='[Calculation_1778358965280272384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Email])' />
            </column>
            <column caption='% Cursos finalizados' datatype='real' name='[Calculation_1778358965308846082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1591178105445249042])/sum([Calculation_1591178105415454732])' />
            </column>
            <column caption='Elegir Vista' datatype='string' name='[Calculation_1778358965327880195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]     &#13;&#10;    when &quot;Country&quot; then [country]&#13;&#10;    WHEN &quot;Departamento&quot; THEN [department]&#13;&#10;    when &quot;Level Category&quot; then [levels]&#13;&#10;    when &quot;Management Level&quot; then [management_level]&#13;&#10;    when &quot;Business Title&quot; then [business_title]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;Nombre y Apellido&quot; then [Nombre]&#13;&#10;    when &quot;Contenido&quot; THEN [Nombre del contenido]&#13;&#10;    when &quot;Location&quot; THEN [office_location]&#13;&#10;    WHEN &quot;Email&quot; then [Email (LIL (2))]&#13;&#10;else &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='% Activos en Learning' datatype='real' name='[Calculation_1778358965350854667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1778358965280272384]/([Calculation_197314021433544707])' />
            </column>
            <column caption='Actual Turnover' datatype='integer' name='[Calculation_197314021432193024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual]' />
            </column>
            <column caption='month wh' datatype='datetime' name='[Calculation_197314021432909825]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date_month])' />
            </column>
            <column caption='Meses del año' datatype='integer' name='[Calculation_197314021432995842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_197314021432909825])' />
            </column>
            <column caption='HC promedio' datatype='real' name='[Calculation_197314021433544707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_197314021432193024])/[Calculation_197314021432995842]' />
            </column>
            <column datatype='string' name='[Email (LIL (2))]' role='dimension' type='nominal' />
            <column datatype='string' name='[Email]' role='dimension' type='nominal' />
            <column datatype='string' name='[Grupos (en el momento de interacción)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Nombre del contenido]' role='dimension' type='nominal' />
