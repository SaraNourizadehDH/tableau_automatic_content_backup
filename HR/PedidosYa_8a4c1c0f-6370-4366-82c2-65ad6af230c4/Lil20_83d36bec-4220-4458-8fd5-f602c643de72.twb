      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1jbmazu1jb75u710vgslo0pzu1qm].[usr:Calculation_1778358965280272384:qk]&quot;' value='Activo en Learning' />
          <alias key='&quot;[federated.1jbmazu1jb75u710vgslo0pzu1qm].[usr:Calculation_197314021493092368:qk]&quot;' value='(Promedio de horas/HC promedio)/meses del año' />
        </aliases>
      </column>
      <column caption='Actual cadena' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Actual (copia)_197314021473005581]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([actual])' />
      </column>
      <column caption='Actual Turnover (copia)' datatype='integer' name='[Actual Turnover (copia)_197314021449498631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual]' />
      </column>
      <column caption='Sellers' datatype='string' name='[Calculation_1048494289002991617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [position] = &apos;Account Executive&apos; OR &#13;&#10;   [position] = &apos;Sales Executive&apos; OR &#13;&#10;   [position] = &apos;Commercial Intern&apos; OR &#13;&#10;   [position] = &apos;Performance Executive&apos; AND &#13;&#10;   [department] = &apos;Sales&apos; THEN &apos;Sellers&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
      </column>
      <column caption='Activos' datatype='integer' name='[Calculation_1591178105411166218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [report_date_month])&#13;&#10;= {MAX(DATETRUNC(&apos;month&apos;, [report_date_month]))} THEN&#13;&#10;    [actual]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Users activos en learning' datatype='integer' name='[Calculation_1591178105412808715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Email])' />
      </column>
      <column caption='Cursos Iniciados' datatype='integer' name='[Calculation_1591178105415454732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Porcentaje de finalización] &gt; 0.09 then 1 else 0 end' />
      </column>
      <column caption='Activos/Bajas' datatype='string' name='[Calculation_1591178105437179919]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [actual] = 1 then &apos;Activo&apos; ELSE &apos;Baja&apos; END' />
      </column>
      <column caption='Users active' datatype='string' name='[Calculation_1591178105437388816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1591178105437179919] = &apos;Activo&apos; then  [Email] ELSE &apos;Baja&apos; END' />
      </column>
      <column caption='Finalizado/Comenzado' datatype='string' name='[Calculation_1591178105444995089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Porcentaje de finalización] = 1 then &apos;Finalizado&apos; ELSE &apos;Comenzado&apos; END' />
      </column>
      <column caption='Cursos finalizados' datatype='integer' name='[Calculation_1591178105445249042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Porcentaje de finalización (LIL (2))] = 1 then 1 ELSE 0 END' />
      </column>
      <column caption='Comenzados' datatype='integer' name='[Calculation_1591178105445322771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Email])' />
      </column>
      <column caption='Promedio de Horas' datatype='real' name='[Calculation_1591178105451560980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_197314021433544707]/sum([Horas de visualización (solo contenido de LinkedIn Learning y de la empresa)])' />
      </column>
      <column caption='% Cumplimientos' datatype='real' name='[Calculation_1591178105452425237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1591178105445249042])/sum([Calculation_1591178105415454732])' />
      </column>
      <column caption='Personas activas' datatype='integer' name='[Calculation_1778358965280272384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Email])' />
      </column>
      <column caption='% Cursos finalizados' datatype='real' name='[Calculation_1778358965308846082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1591178105445249042])/sum([Calculation_1591178105415454732])' />
      </column>
      <column caption='Elegir Vista' datatype='string' name='[Calculation_1778358965327880195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]     &#13;&#10;    when &quot;Country&quot; then [country]&#13;&#10;    WHEN &quot;Departamento&quot; THEN [department]&#13;&#10;    when &quot;Level Category&quot; then [levels]&#13;&#10;    when &quot;Management Level&quot; then [management_level]&#13;&#10;    when &quot;Business Title&quot; then [business_title]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;Nombre y Apellido&quot; then [Nombre]&#13;&#10;    when &quot;Contenido&quot; THEN [Nombre del contenido]&#13;&#10;    when &quot;Location&quot; THEN [office_location]&#13;&#10;    WHEN &quot;Email&quot; then [Email (LIL (2))]&#13;&#10;else &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='% Activos en Learning' datatype='real' name='[Calculation_1778358965350854667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1778358965280272384]/([Calculation_197314021433544707])' />
      </column>
      <column caption='Actual Turnover' datatype='integer' name='[Calculation_197314021432193024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual]' />
      </column>
      <column caption='month wh' datatype='datetime' name='[Calculation_197314021432909825]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date_month])' />
      </column>
      <column caption='Meses del año' datatype='integer' name='[Calculation_197314021432995842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_197314021432909825])' />
      </column>
      <column caption='HC promedio' datatype='real' name='[Calculation_197314021433544707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_197314021432193024])/[Calculation_197314021432995842]' />
      </column>
      <column caption='Max date' datatype='string' datatype-customized='true' name='[Calculation_197314021447651334]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MAX(DATETRUNC(&apos;month&apos;, [report_date_month])))' />
      </column>
      <column caption='Actuals activos' datatype='integer' name='[Calculation_197314021469761544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Report Date Month conjunto] THEN&#13;&#10;    [actual]&#13;&#10;END' />
      </column>
      <column caption='Cálculo1' datatype='real' name='[Calculation_197314021473103886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Actual (copia)_197314021473005581] = 1 THEN ([Calculation_1778358965280272384]) END' />
      </column>
      <column caption='Cursos mandatorios completos' datatype='integer' datatype-customized='true' name='[Calculation_197314021475414031]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='INT(if [Nombre del contenido (LIL1)] = &apos;Seguridad de la Información&apos;&#13;&#10; THEN&#13;&#10;[Email (LIL1)] else &apos;&apos; END)' />
      </column>
      <column caption='Promedio de horas/HC promedio' datatype='real' name='[Calculation_197314021493092368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Horas de visualización (solo contenido de LinkedIn Learning y de la empresa)])/sum([Calculation_197314021469761544]))/[Calculation_197314021432995842]' />
      </column>
      <column caption='Recorrido Sustentable' datatype='integer' name='[Calculation_307089263835066369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Nombre del contenido] = &apos;Recorrido Sustentable&apos; AND [Porcentaje de finalización]= 1 THEN&#13;&#10; &#13;&#10;        1&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END' />
      </column>
      <column caption='Cursos mandatorios completos Argentina' datatype='integer' name='[Calculation_307089263849242628]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [country] = &apos;Argentina&apos; AND [Nombre del contenido (Cursos mandatorios)] = &apos;Protección de Datos Personales | Actualización 2023&apos; THEN&#13;&#10;        1&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END' />
      </column>
      <column caption='Cursos mandatorios completos Argentina (copia)' datatype='integer' name='[Cursos mandatorios completos Argentina (copia)_2086292592624390146]' role='measure' type='ordinal'>
