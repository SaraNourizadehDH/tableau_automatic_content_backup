              <calculation class='tableau' formula='IF [position] = &apos;Account Executive&apos; OR &#13;&#10;   [position] = &apos;Sales Executive&apos; OR &#13;&#10;   [position] = &apos;Commercial Intern&apos; OR &#13;&#10;   [position] = &apos;Performance Executive&apos; AND &#13;&#10;   [department] = &apos;Sales&apos; THEN &apos;Sellers&apos;&#13;&#10;ELSE &apos;Other&apos;&#13;&#10;END' />
