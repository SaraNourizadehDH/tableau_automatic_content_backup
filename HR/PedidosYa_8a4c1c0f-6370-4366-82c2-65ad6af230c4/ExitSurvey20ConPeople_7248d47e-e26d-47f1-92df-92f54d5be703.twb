            <column-instance column='[Calculation_1121677782687301634]' derivation='None' name='[none:Calculation_1121677782687301634:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1635088147394023425]' derivation='None' name='[none:Calculation_1635088147394023425:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1725160152522358786]' derivation='None' name='[none:Calculation_1725160152522358786:nk]' pivot='key' type='nominal' />
