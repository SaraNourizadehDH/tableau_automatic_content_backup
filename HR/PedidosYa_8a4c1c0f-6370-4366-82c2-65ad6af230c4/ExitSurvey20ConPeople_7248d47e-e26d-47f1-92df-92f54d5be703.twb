    <worksheet name='Experiencia - Equipo de trabajo'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Equipo de trabajo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HRMW+ (Exit Survey tableau)' name='federated.0zi2jmy0rgjiuy1bgq8qf0ncc7ez' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View I' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mercados&quot;'>
              <calculation class='tableau' formula='&quot;Mercados&quot;' />
            </column>
            <column caption='Switch View' datatype='string' name='[Switch View I (copia)_1715590007151902731]' param-domain-type='list' role='measure' type='nominal' value='&quot;País&quot;'>
              <calculation class='tableau' formula='&quot;País&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zi2jmy0rgjiuy1bgq8qf0ncc7ez'>
            <column caption=' He tenido oportunidades de crecimiento en la compañía' datatype='real' name='[Calculation_1085649009864638464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mayor crecimiento profesional&quot;: ¿Cómo calificarías las siguientes afirmaciones? - He tenido oportuni])' />
            </column>
            <column caption='Me sentí acompañado por mis líderes para mi desarrollo dentro de la compañía' datatype='real' name='[Calculation_1085649009865990145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mayor crecimiento profesional&quot;: ¿Cómo calificarías las siguientes afirmaciones? - Me sentí acompañad])' />
            </column>
            <column caption='Estoy conforme con mi compensación actual' datatype='real' name='[Calculation_1085649009899917315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mejor paquete compensatorio (mejores beneficios, salario y otras formas de compensación)&quot;:¿Cómo valo])' />
            </column>
            <column caption='Agrupador de Mercados' datatype='string' name='[Calculation_1121677782682062849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [company]&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
            <column caption='Last Performance' datatype='string' name='[Calculation_1121677782687301634]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Development Needed&apos; &#13;&#10;or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Low&apos;&#13;&#10;ELSEIF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Mid&apos;&#13;&#10;ELSEIF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
            </column>
            <column caption='Picker/Non picker' datatype='string' name='[Calculation_1635088147394023425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contract_type]= &apos;Operational Worker - Fixed Term (Fixed Term)&apos; &#13;&#10;then &apos;Picker&apos; &#13;&#10;ELSEIF [contract_type]=&apos;Operational Worker - Permanent&apos;&#13;&#10;then &apos;Picker&apos; &#13;&#10;else &apos;Non Picker&apos;&#13;&#10;END' />
            </column>
            <column caption='Elegir Vista I' datatype='string' name='[Calculation_1715590007148654602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    when &quot;Mercados&quot; then [Calculation_1121677782682062849]&#13;&#10;    when &quot;Departamento&quot; then [department]      &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;País&quot; then [country]&#13;&#10;    when &quot;Level&quot; then [management_level]&#13;&#10;    when &quot;Género&quot; then [gender]&#13;&#10;END' />
            </column>
            <column caption='time in compan days' datatype='real' name='[Calculation_1725160152521666561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[last_day_of_work]-[first_day_of_work]' />
            </column>
            <column caption='Antiguedad' datatype='string' name='[Calculation_1725160152522358786]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1725160152521666561] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 180 AND [Calculation_1725160152521666561]  &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 365 AND [Calculation_1725160152521666561]  &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 730 AND [Calculation_1725160152521666561]  &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='En el equipo se aceptaban las diferencias y nos tratábamos todos con respeto.' datatype='real' name='[Calculation_356065870298054661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - En el equipo se aceptaban las d])' />
            </column>
            <column caption='Regularmente recibía feedback de las personas con las que trabajaba.' datatype='real' name='[Calculation_356065870298505222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - Regularmente recibía feedback d])' />
            </column>
            <column caption='Me sentí cómodo/a expresando mi opinión y compartiendo ideas con mis compañeros/as.' datatype='real' name='[Calculation_356065870298738695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - Me sentí cómodo/a expresando mi])' />
            </column>
            <column caption='Estoy conforme con el clima del equipo de trabajo.' datatype='real' name='[Calculation_356065870298943496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - Estoy conforme con el clima del])' />
            </column>
            <column caption='Mi jefe/a cuenta con las habilidades necesarias para liderar el equipo' datatype='real' name='[Calculation_356065870299152393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - Mi jefe/a cuenta con las habili])' />
            </column>
            <column caption='Personnel/Non Personnel' datatype='string' name='[Calculation_592223358027526144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contract_type]=&apos;Freelancer&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Agency Worker&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Consultant&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Intern&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;else &apos;Personnel&apos;&#13;&#10;END' />
            </column>
            <column caption='Nombre y Apellido' datatype='string' name='[Calculation_592223358032420868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level]=&apos;M3&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M4&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M5&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M6&apos;&#13;&#10;THEN NULL&#13;&#10;ELSE [first_name]+&apos; &apos;+[last_name] &#13;&#10;END' />
            </column>
            <column caption='Termination pos implementacion' datatype='string' name='[Calculation_605171211493240832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [last_day_of_work]&gt;DATE(&apos;2021-10-17&apos;)&#13;&#10;THEN &apos;SI&apos;&#13;&#10;ELSE &apos;NO&apos;&#13;&#10;END' />
            </column>
            <column caption='Elegir Vista II' datatype='string' name='[Elegir Vista I (copia)_1715590007152033805]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View I (copia)_1715590007151902731]&#13;&#10;    when &quot;Mercados&quot; then [Calculation_1121677782682062849]&#13;&#10;    when &quot;Departamento&quot; then [department]      &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;País&quot; then [country]&#13;&#10;    when &quot;Level&quot; then [management_level]&#13;&#10;    when &quot;Género&quot; then [gender]&#13;&#10;END' />
            </column>
