        <calculation class='tableau' formula='[Calculation_78531544275591170]+[Calculation_78531544275795972]+[Calculation_78531544276004869]+[Calculation_78531544276254726]+[Calculation_78531544276422663]+[Calculation_78531544276553736]+[Calculation_78531544276709385]' />
      </column>
      <column caption='-Bono' datatype='real' name='[Calculation_565764729407344641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544275591170])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Comedor' datatype='real' name='[Calculation_565764729407524866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544275795972])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Educación' datatype='real' name='[Calculation_565764729407635459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544276004869])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Licencias' datatype='real' name='[Calculation_565764729407741956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544276254726])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Otro' datatype='real' name='[Calculation_565764729407840261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544276422663])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Seguro Médico' datatype='real' name='[Calculation_565764729407938566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544276553736])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='-Vacaciones' datatype='real' name='[Calculation_565764729408036871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_78531544276709385])/SUM([Calculation_565764729407148032])' />
      </column>
      <column caption='Personnel/Non Personnel' datatype='string' name='[Calculation_592223358027526144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [contract_type]=&apos;Freelancer&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Agency Worker&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Consultant&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Intern&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;else &apos;Personnel&apos;&#13;&#10;END' />
      </column>
      <column caption='Nombre y Apellido' datatype='string' name='[Calculation_592223358032420868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level]=&apos;M3&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M4&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M5&apos;&#13;&#10;THEN NULL&#13;&#10;ELSEIF [management_level]=&apos;M6&apos;&#13;&#10;THEN NULL&#13;&#10;ELSE [first_name]+&apos; &apos;+[last_name] &#13;&#10;END' />
      </column>
      <column caption='Termination pos implementacion' datatype='string' name='[Calculation_605171211493240832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [last_day_of_work]&gt;DATE(&apos;2021-10-17&apos;)&#13;&#10;THEN &apos;SI&apos;&#13;&#10;ELSE &apos;NO&apos;&#13;&#10;END' />
      </column>
      <column caption='Full Name' datatype='string' name='[Calculation_713539090541109248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_name]+&apos; &apos;+ [last_name]' />
      </column>
      <column caption='!Bono' datatype='integer' name='[Calculation_78531544275591170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Bono&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Comedor' datatype='integer' name='[Calculation_78531544275795972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Comedor&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Educación' datatype='integer' name='[Calculation_78531544276004869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Educación / Cursos / Becas&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Licencias' datatype='integer' name='[Calculation_78531544276254726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Licencias extendidas (familiar, casual days, etc)&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Otro' datatype='integer' name='[Calculation_78531544276422663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Licencias extendidas (familiar, casual days, etc)&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Seguro Médico' datatype='integer' name='[Calculation_78531544276553736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Seguro Médico Privado&quot;) &#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='!Vacaciones' datatype='integer' name='[Calculation_78531544276709385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([¿Qué beneficios / elementos de compensación valoras de la nueva propuesta? - Selected Choice], &quot;Mayores vacaciones&quot;)&#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='% Completitud' datatype='real' name='[Calculation_842173151297597441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM(if [Calculation_842173151300202498] = &apos;Completo&apos; then 1 end)/sum([Calculation_842173151301992451]))' />
      </column>
      <column caption='Tasa de completitud' datatype='string' name='[Calculation_842173151300202498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Progress] = 100 then &apos;Completo&apos; ELSE &apos;No Completo&apos; END' />
      </column>
      <column caption='All' datatype='integer' name='[Calculation_842173151301992451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_842173151300202498] &lt;&gt; &apos;&apos; then 1 END' />
      </column>
