      <column datatype='string' name='[Aumento Propuesta (grupo)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Aumento Propuesta]' new-bin='true'>
          <bin default-name='false' value='&quot;Le implicó un aumento de más de un 30\%&quot;'>
            <value>&quot;Entre 30\% Y 40\%&quot;</value>
            <value>&quot;Entre 40\% Y 50\%&quot;</value>
            <value>&quot;Por Encima Del 50\%&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Le implicó un aumento de menos de un 30\%&quot;'>
            <value>%null%</value>
            <value>&quot;Entre 10\% Y 20\%&quot;</value>
            <value>&quot;Entre 20\% Y 30\%&quot;</value>
            <value>&quot;Hasta Un 10\%&quot;</value>
            <value>&quot;No&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Aumento Propuesta]' role='dimension' type='nominal' />
      <column caption='Vista IV' datatype='string' name='[Calculation_1024568973628772354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#13;&#10;    when &quot;Quarter&quot; then (&apos;Q&apos;+str((DATENAME(&apos;quarter&apos;, [last_day_of_work]))))&#13;&#10;    when &quot;Meses&quot; then str((DATENAME(&apos;month&apos;, [last_day_of_work])))&#13;&#10;    when &quot;Departamento&quot; then [department]      &#13;&#10;    when &quot;Mercados&quot; then [Calculation_1121677782682062849]&#13;&#10;END' />
      </column>
      <column caption=' He tenido oportunidades de crecimiento en la compañía' datatype='real' name='[Calculation_1085649009864638464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mayor crecimiento profesional&quot;: ¿Cómo calificarías las siguientes afirmaciones? - He tenido oportuni])' />
      </column>
      <column caption='Me sentí acompañado por mis líderes para mi desarrollo dentro de la compañía' datatype='real' name='[Calculation_1085649009865990145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mayor crecimiento profesional&quot;: ¿Cómo calificarías las siguientes afirmaciones? - Me sentí acompañad])' />
      </column>
      <column caption='Estoy conforme con mis beneficios actuales' datatype='real' name='[Calculation_1085649009899790338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mejor paquete compensatorio (mejores beneficios, salario y otras formas de compensación)&quot;:¿Cómo va 1])' />
      </column>
      <column caption='Estoy conforme con mi compensación actual' datatype='real' name='[Calculation_1085649009899917315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Mejor paquete compensatorio (mejores beneficios, salario y otras formas de compensación)&quot;:¿Cómo valo])' />
      </column>
      <column caption='Agrupador de Mercados' datatype='string' name='[Calculation_1121677782682062849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [company]&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
      </column>
      <column caption='Last Performance' datatype='string' name='[Calculation_1121677782687301634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Development Needed&apos; &#13;&#10;or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Low&apos;&#13;&#10;ELSEIF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Mid&apos;&#13;&#10;ELSEIF YEAR([last_day_of_work])=YEAR([review_date (il_performance)])&#13;&#10;AND [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
      </column>
      <column caption='tru?' datatype='boolean' name='[Calculation_1121677782707810311]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[last_day_of_work (il_termination)]=[last_day_of_work]' />
      </column>
      <column caption='Picker/Non picker' datatype='string' name='[Calculation_1635088147394023425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [contract_type]= &apos;Operational Worker - Fixed Term (Fixed Term)&apos; &#13;&#10;then &apos;Picker&apos; &#13;&#10;ELSEIF [contract_type]=&apos;Operational Worker - Permanent&apos;&#13;&#10;then &apos;Picker&apos; &#13;&#10;else &apos;Non Picker&apos;&#13;&#10;END' />
      </column>
      <column caption='top' datatype='integer' name='[Calculation_1668020714763943936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(COUNT([¿Cuál de las siguientes razones refleja mejor el principal motivo de tu salida de la compañía?]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Personas que respondieron' datatype='integer' name='[Calculation_1715590007070236672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ID])' />
      </column>
      <column caption='Terminations Voluntary' datatype='integer' name='[Calculation_1715590007081762818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [termination_category]=&apos;Voluntary&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='Completion Rate' datatype='real' name='[Calculation_1715590007083786244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1715590007070236672])/SUM([Calculation_1715590007081762818])' />
      </column>
      <column caption='Elegir Vista I' datatype='string' name='[Calculation_1715590007148654602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    when &quot;Mercados&quot; then [Calculation_1121677782682062849]&#13;&#10;    when &quot;Departamento&quot; then [department]      &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;País&quot; then [country]&#13;&#10;    when &quot;Level&quot; then [management_level]&#13;&#10;    when &quot;Género&quot; then [gender]&#13;&#10;END' />
      </column>
      <column caption='Respuestas Totales' datatype='integer' name='[Calculation_1715590007167266835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [¿Cuál de las siguientes razones refleja mejor el principal motivo de tu salida de la compañía?]:COUNT([ID])}' />
      </column>
      <column caption='% del Total' datatype='real' name='[Calculation_1715590007167660052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1715590007070236672]/SUM([Calculation_1715590007167266835])' />
      </column>
      <column caption='time in compan days' datatype='real' name='[Calculation_1725160152521666561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[last_day_of_work]-[first_day_of_work]' />
      </column>
      <column caption='Antiguedad' datatype='string' name='[Calculation_1725160152522358786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1725160152521666561] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 180 AND [Calculation_1725160152521666561]  &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 365 AND [Calculation_1725160152521666561]  &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [Calculation_1725160152521666561]  &gt;= 730 AND [Calculation_1725160152521666561]  &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
      </column>
      <column caption='Promotores Peya' datatype='integer' name='[Calculation_255579303202373634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Recomendarías a un familiar / amigo / conocido trabajar en PeYa? - Grupo]=&apos;Promotor&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Detractores  Recomendarías' datatype='integer' name='[Calculation_255579303202799619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Recomendarías a un familiar / amigo / conocido trabajar en PeYa? - Grupo]=&apos;Detractor&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total PeYa' datatype='integer' name='[Calculation_255579303203815428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Recomendarías a un familiar / amigo / conocido trabajar en PeYa? - Grupo]=NULL&#13;&#10;then 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='% Promotores Peya' datatype='real' name='[Calculation_255579303204024325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_255579303202373634])/SUM([Calculation_255579303203815428])' />
      </column>
      <column caption='% Detractores Peya' datatype='real' name='[Calculation_255579303204253702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_255579303202799619])/SUM([Calculation_255579303203815428])' />
      </column>
      <column caption='ENPS PeYa' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_255579303204499464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_255579303204024325]-[Calculation_255579303204253702])*100' />
      </column>
      <column caption='Promotores Saying' datatype='integer' name='[Calculation_255579303205027849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Del 0 al 10 cómo fue tu experiencia en el proceso de salida? - Grupo]=&apos;Promotor&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Detractores Saying' datatype='integer' name='[Calculation_255579303205281802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Del 0 al 10 cómo fue tu experiencia en el proceso de salida? - Grupo]=&apos;Detractor&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Total Saying' datatype='integer' name='[Calculation_255579303205376011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_255579303207215119])+SUM([Calculation_255579303205027849])+SUM([Calculation_255579303205281802])' />
      </column>
      <column caption='% Promotores Saying' datatype='real' name='[Calculation_255579303205613580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_255579303205027849])/[Calculation_255579303205376011]' />
      </column>
      <column caption='% Detractores Saying' datatype='real' name='[Calculation_255579303205777421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_255579303205281802])/[Calculation_255579303205376011]' />
      </column>
      <column caption='ENPS Saying' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_255579303205859342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_255579303205613580]-[Calculation_255579303205777421])*100' />
      </column>
      <column caption='Pasivos Saying' datatype='integer' name='[Calculation_255579303207215119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [¿Del 0 al 10 cómo fue tu experiencia en el proceso de salida? - Grupo]=&apos;Pasivo&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Mi jefe/a me brindó el soporte necesario para realizar mi trabajo.' datatype='real' name='[Calculation_356065870289674240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Liderazgo del área&quot;:¿Cómo calificarías las siguientes afirmaciones? - Mi jefe/a me brindó el soporte])' />
      </column>
      <column caption='A mi jefe/a le importaban mis opiniones.' datatype='real' name='[Calculation_356065870290128897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Liderazgo del área&quot;:¿Cómo calificarías las siguientes afirmaciones? - A mi jefe/a le importaban mis ])' />
      </column>
      <column caption='Regularmente recibía feedback y tenía conversaciones de coaching con mi jefe/a sobre mi performance y desarrollo.' datatype='real' name='[Calculation_356065870290808835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Liderazgo del área&quot;:¿Cómo calificarías las siguientes afirmaciones? - Regularmente recibía feedback ])' />
      </column>
      <column caption='Mis objetivos laborales siempre estuvieron claros' datatype='real' name='[Calculation_356065870291075076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Liderazgo del área&quot;:¿Cómo calificarías las siguientes afirmaciones? - Mis objetivos laborales siempr])' />
      </column>
      <column caption='En el equipo se aceptaban las diferencias y nos tratábamos todos con respeto.' datatype='real' name='[Calculation_356065870298054661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - En el equipo se aceptaban las d])' />
      </column>
      <column caption='Regularmente recibía feedback de las personas con las que trabajaba.' datatype='real' name='[Calculation_356065870298505222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([En relación a tu elección &quot;Equipo de trabajo&quot;:¿Cómo calificarías las siguientes afirmaciones? - Regularmente recibía feedback d])' />
