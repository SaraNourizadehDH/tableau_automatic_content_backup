            <column-instance column='[last_day_of_work]' derivation='Month' name='[mn:last_day_of_work:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1121677782687301634]' derivation='None' name='[none:Calculation_1121677782687301634:nk]' pivot='key' type='nominal' />
