      <table>
        <view>
          <datasources>
            <datasource caption='consulta_sql_perso (people_ops_proposed)' name='federated.0wp8nxf1rof8v11e7qog41bfq32z' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Denominado' caption='Denominado | Percibido' datatype='integer' name='[Parámetro 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Denominado' />
                <alias key='2' value='Percibido' />
              </aliases>
            </column>
            <column caption='Dolar MEP' datatype='integer' name='[Parámetro 3]' param-domain-type='any' role='measure' type='quantitative' value='950'>
              <calculation class='tableau' formula='950' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0wp8nxf1rof8v11e7qog41bfq32z].[Calculation_1525312924043132934]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0wp8nxf1rof8v11e7qog41bfq32z].[report_date_month (copia)_1105352250027118592]' caption='Fecha' datatype='date' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wp8nxf1rof8v11e7qog41bfq32z'>
            <column caption='% de incremento de la masa salarial percibido (mes) ' datatype='real' name='[% de incremento de la masa salarial (mes) (copia)_735775615136256012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Total Salario Bruto (percibido) (copia)_1525312924082761759]) &#13;&#10;&#13;&#10;-[Salario Bruto (Mes pasado) (copia)_735775615135490057])&#13;&#10;&#13;&#10;&#13;&#10;/([Salario Bruto (Mes pasado) (copia)_735775615135490057])' />
            </column>
            <column caption='Bono (percibido)' datatype='real' name='[Bono (copia)_126382278086967303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2250392458803855361]* [Total Salario Bruto para bono (copia)_126382278086451206]' />
            </column>
            <column caption='Bono Total Cash (percibido)' datatype='real' name='[Bono Total Cash (copia)_126382278088982539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Bono (copia)_126382278086967303]) OR [Bono (copia)_126382278086967303] &lt;= 0 THEN 0 ELSE [Bono (copia)_126382278086967303] END' />
            </column>
            <column caption='Performance' datatype='string' name='[Calculation_1079175076830568451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manager_rating_explained]=&apos;Development Needed&apos; &#13;&#10;or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Low Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Solid Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Exceeding&apos; &#13;&#10;or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
            </column>
            <column caption='Gratificación Chile' datatype='integer' name='[Calculation_1211749812706357248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country] = &apos;Chile&apos; then 182083 ELSE 0 END' />
            </column>
            <column caption='Total Salario Bruto (Percibido) sin Doble Nomina' datatype='real' name='[Calculation_1222445869671415811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_126382277856342021]+[comission_plan]+[bonficacion_incentivo]+[Calculation_1211749812706357248]' />
            </column>
            <column caption='Posicionamiento en Banda' datatype='string' name='[Calculation_1252000712161112067]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Compratio (copia)_1480558393925791759]&lt;=0.77 then &apos;Under&apos;&#13;&#10;ELSEIF [Compratio (copia)_1480558393925791759]&gt;=1.22 then &apos;Above&apos;&#13;&#10;ELSEIF [Compratio (copia)_1480558393925791759]&gt;0.77 OR [Compratio (copia)_1480558393925791759]&lt;1.22 then &apos;Inside&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='salary amount (percibido)' datatype='real' name='[Calculation_126382277856342021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(if [country]&lt;&gt; &apos;Argentina&apos; THEN [salary_amount]&#13;&#10;&#13;&#10;ELSEIF  [cluster]=&apos;M3 &amp; UP&apos; &#13;&#10;AND [country] = &apos;Argentina&apos; &#13;&#10;THEN (([salary_amount] / (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;&#13;&#10;ELSEIF [country] = &apos;Argentina&apos; and [tipo_de_banda]= &apos;Tech&apos; and [sub_department] &lt;&gt; &apos;Internal IT&apos;&#13;&#10; and [cluster] &lt;&gt; &apos;M3 &amp; UP&apos; &#13;&#10;THEN (([salary_amount] / (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF   [country] = &apos;Argentina&apos; and [sub_department] = &apos;Finance Systems&apos;&#13;&#10; and [cluster] = &apos;IC2&apos; or [cluster] = &apos;IC3&apos; or&#13;&#10;[cluster] = &apos;IC4&apos; or&#13;&#10;[cluster] = &apos;IC5&apos; or&#13;&#10;[cluster] = &apos;IC1&apos; or&#13;&#10;[cluster] = &apos;M1&apos; or&#13;&#10;[cluster] = &apos;M2&apos; &#13;&#10;and  [employee_id] &lt;&gt; &apos;2020-01-0122&apos;&#13;&#10;&#13;&#10;&#13;&#10;THEN (([salary_amount] / (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [country] = &apos;Argentina&apos; and&#13;&#10;[sub_department]= &apos;Performance Marketing&apos;&#13;&#10;THEN ((([salary_amount]* 0.5)/ (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;+ &#13;&#10;([salary_amount]* 0.5)&#13;&#10;&#13;&#10;ELSEIF [country] = &apos;Argentina&apos; and&#13;&#10;[sub_department]= &apos;Finance System&apos;&#13;&#10;&#13;&#10;and [employee_id] &lt;&gt; &apos;2020-01-0122&apos;&#13;&#10;THEN (([salary_amount] / (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;&#13;&#10;ELSEIF [country] = &apos;Argentina&apos; and&#13;&#10;[sub_department] &lt;&gt; &apos;Performance Marketing&apos; and [sub_department] &lt;&gt; &apos;Finance System&apos; and&#13;&#10;[Management Level] = &apos;M2&apos; or [Management Level] = &apos;IC5&apos;&#13;&#10;&#13;&#10;&#13;&#10;THEN ((([salary_amount]* 0.3)/ (1 / ([currency_exchange_rate (bl_currency_exchan1)]))*[currency_exchange_rate]))*&#13;&#10;([Calculation_1549519770268909569])&#13;&#10;+ &#13;&#10;([salary_amount]* 0.7)&#13;&#10;ELSE [salary_amount]&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END)' />
            </column>
            <column caption='Mid salary' datatype='real' name='[Calculation_1472395613640056840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [employee_id] &lt;&gt; &quot;&quot; then [Salary Midpoint (expressed annual and in local currency)] ELSE 0 END' />
            </column>
            <column caption='% de incremento de la masa salarial (mes)' datatype='real' name='[Calculation_1525312924035366912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Total Salario Bruto (percibido) HOY (copia)_1277614944983998480])-[Calculation_1525312924050784269])/([Calculation_1525312924050784269])' />
            </column>
            <column caption='Last month' datatype='datetime' name='[Calculation_1525312924036366337]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Parameters].[Parámetro 4])' />
            </column>
            <column caption='This month (vista)' datatype='datetime' name='[Calculation_1525312924043132934]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Calculation_1525312924043313159])) }' />
            </column>
            <column caption='month wh' datatype='datetime' name='[Calculation_1525312924043313159]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Salario Bruto (Mes pasado)' datatype='real' name='[Calculation_1525312924050784269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;month&apos;, [Calculation_1525312924043313159]) = [Calculation_1525312924036366337] &#13;&#10;THEN [Calculation_260082885670838274]&#13;&#10;END)' />
            </column>
            <column caption='Mid salary HOY' datatype='real' name='[Calculation_1525312924085645349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [Calculation_1525312924043313159]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [Calculation_1472395613640056840]&#13;&#10;END' />
            </column>
            <column caption='doble' datatype='integer' name='[Calculation_1537134861070061568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Importe (Doble Nomina1)]) THEN 0&#13;&#10;ELSE [Importe (Doble Nomina1)]&#13;&#10;END' />
            </column>
            <column caption='Dolares convertidos' datatype='real' name='[Calculation_1549519770268909569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_effective_date]=TODAY()&#13;&#10;THEN [Parameters].[Parámetro 3]&#13;&#10;ELSE [exchange_rate (Dolares Convertidos1)]&#13;&#10;END' />
            </column>
            <column caption='Ltips Euros' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1705456891795755008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_LTIP]' />
            </column>
            <column caption='LTIPS en pesos' datatype='real' name='[Calculation_1705456891797458946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1705456891795755008] * (1/[currency_exchange_rate (bl_currency_exchan1)]))' />
            </column>
            <column caption='One-Off Hero Grant Euros' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1705456891818749964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Hero_grant]' />
            </column>
            <column caption='Hero Grants en pesos' datatype='real' name='[Calculation_1705456891819380749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_1705456891818749964] * (1/[currency_exchange_rate (bl_currency_exchan1)]))' />
            </column>
            <column caption='Total Comp' datatype='real' name='[Calculation_1705456891836534798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_260082885746921481]*1)+([Calculation_1705456891797458946])+([Calculation_1705456891819380749])' />
            </column>
            <column caption='Doble Nomina en pesos' datatype='real' name='[Calculation_1705456891868409875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1537134861070061568] * (1 / [currency_exchange_rate (bl_currency_exchan1)]))' />
            </column>
            <column caption='Targets bono' datatype='integer' name='[Calculation_2250392458803855361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [tipo_de_banda] = &apos;Tech&apos; AND [management_level] = &apos;M4&apos; THEN 3&#13;&#10;ELSEIF [tipo_de_banda] &lt;&gt; &apos;Tech&apos; AND [management_level] = &apos;M4&apos; THEN 3&#13;&#10;ELSEIF  [tipo_de_banda] = &apos;Tech&apos; AND ([management_level] = &apos;M3&apos; OR [management_level] = &apos;M2&apos; OR [management_level] = &apos;M1&apos; OR [management_level] = &apos;IC4&apos;OR [management_level] = &apos;IC5&apos;OR [management_level] = &apos;IC6&apos;) then 2&#13;&#10;ELSEIF [tipo_de_banda] &lt;&gt; &apos;Tech&apos; AND [management_level] = &apos;M3&apos; THEN 2&#13;&#10;ELSEIF [tipo_de_banda] &lt;&gt; &apos;Tech&apos; AND ([management_level] = &apos;M2&apos; OR [management_level] = &apos;M1&apos; OR [management_level] = &apos;IC4&apos; OR [management_level] = &apos;IC5&apos;) THEN 1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Total Salario Bruto' datatype='real' name='[Calculation_260082885670838274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[salary_amount]+[comission_plan]+[bonficacion_incentivo]+[Calculation_1705456891868409875]&#13;&#10;+[Calculation_1211749812706357248]' />
            </column>
            <column caption='Bono' datatype='real' name='[Calculation_260082885738688519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2250392458803855361]*[Total Salario Bruto (copia)_2052797015578386433]' />
            </column>
            <column caption='Salary Plan Periodo' datatype='integer' datatype-customized='true' name='[Calculation_260082885746184200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(LEFT([period_salary_plan], 2))' />
            </column>
            <column caption='Total Cash' datatype='real' name='[Calculation_260082885746921481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_260082885670838274] * [Calculation_512284468358811657])+([Calculation_260082885748547594])' />
            </column>
            <column caption='Bono Total Cash' datatype='real' name='[Calculation_260082885748547594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_260082885738688519]) OR [Calculation_260082885738688519] &lt;= 0 THEN 0 ELSE [Calculation_260082885738688519] END' />
            </column>
            <column caption='Salary Plan' datatype='real' name='[Calculation_512284468358811657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country] = &apos;Uruguay&apos; &#13;&#10;then 13.67&#13;&#10;ELSEIF [country] = &apos;Chile&apos; &#13;&#10;then 12&#13;&#10;ELSE [Calculation_260082885746184200] &#13;&#10;END' />
            </column>
            <column caption='Picker/ Non picker' datatype='string' name='[Calculation_512284468367294477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [picker_non_picker] = 1 then &apos;Picker&apos; ELSE &apos;Non Picker&apos; END' />
            </column>
            <column caption='Ltips Dolares' datatype='real' name='[Calculation_572238643010846720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country] = &apos;Argentina&apos; then [Calculation_1705456891795755008]*[currency_exchange_rate] ELSE [Calculation_1705456891795755008] END' />
            </column>
            <column caption='Hero grant Dolares' datatype='real' name='[Calculation_572238643011428354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country] = &apos;Argentina&apos; then [Calculation_1705456891818749964]*[currency_exchange_rate] ELSE [Calculation_1705456891818749964] END' />
            </column>
