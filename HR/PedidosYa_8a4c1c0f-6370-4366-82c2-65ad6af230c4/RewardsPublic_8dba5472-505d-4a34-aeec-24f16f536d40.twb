          <object caption='consulta_sql_perso' id='_28165C0D2ECA432892F7A5C05B4DA18C'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[consulta_sql_perso].[employee_id]' />
