                      <column datatype='integer' name='Importe' ordinal='2' />
                      <column datatype='string' name='Moneda' ordinal='3' />
                    </columns>
                  </relation>
                </relation>
                <relation connection='athena.17346w0153qujg14j9x1v11r95dv' name='bl_currency_exchan1' table='[people_ops_proposed].[bl_currency_exchange_monthly]' type='table' />
              </relation>
              <relation connection='cloudfile:googledrive-excel-direct.1hbzzmw1dpa16a18pxy6y0qjfxrm' name='Dolares Convertidos1' table='[&apos;Dolares Convertidos$&apos;]' type='table'>
                <columns gridOrigin='A1:E2738:no:A1:E2738:0' header='yes' outcome='2'>
                  <column datatype='string' name='source_currency' ordinal='0' />
                  <column datatype='string' name='target_currency' ordinal='1' />
                  <column datatype='string' name='currency_exchange_rate' ordinal='2' />
                  <column datatype='date' name='curreny_exchange_date' ordinal='3' />
                  <column datatype='real' name='exchange_rate' ordinal='4' />
                </columns>
              </relation>
            </relation>
            <relation connection='athena.17346w0153qujg14j9x1v11r95dv' name='il_manager_hist_wi' table='[people_ops_proposed].[il_manager_hist_with_current]' type='table' />
          </relation>
          <relation connection='cloudfile:googledrive-excel-direct.1hbzzmw1dpa16a18pxy6y0qjfxrm' name='Histórico Bandas Salariales par' table='[&apos;Histórico Bandas Salariales par$&apos;]' type='table'>
            <columns gridOrigin='A2:F5112:no:A2:F5112:0' header='yes' outcome='2'>
              <column datatype='date' name='Date from' ordinal='0' />
              <column datatype='date' name='Date to' ordinal='1' />
              <column datatype='string' name='Country' ordinal='2' />
              <column datatype='string' name='Job Family Group' ordinal='3' />
              <column datatype='string' name='Management Level' ordinal='4' />
              <column datatype='real' name='Salary Midpoint (expressed annual and in local currency)' ordinal='5' />
            </columns>
          </relation>
          <relation connection='athena.17346w0153qujg14j9x1v11r95dv' name='consulta_sql_perso2' type='text'>SELECT&#13;
*&#13;
    from people_ops_proposed.bl_currency_exchange_monthly &#13;
    where source_currency = &apos;EUR&apos;&#13;
    and target_currency = &apos;USD&apos;</relation>
          <relation connection='athena.17346w0153qujg14j9x1v11r95dv' name='consulta_sql_perso1' type='text'><![CDATA[WITH py_rewards AS (select 
sh.employee_id,
CONCAT(wp.first_name, ' ', wp.last_name) as full_name,
sh.cost_center_id,
sh.salary_frequency,
sh.salary_amount,
sh.salary_currency,
sh.report_effective_date,
 DATE_TRUNC('month', DATE(sh.report_effective_date)) AS report_date_month,
sh.period_salary_plan,
wh.is_terminated,
wh.is_people_manager,
wh.first_day_of_work,
wh.last_day_of_work,
wh.business_title,
wh.management_level,
wp.gender,
CASE 
    	WHEN wh.contract_type IN ('Freelancer', 'Agency Worker', 'Consultant', 'Intern (Fixed Term) (Trainee)')
    	THEN 1
    	ELSE 0
END AS is_personnel, ---personnell/Nonpersonnel calculation (when is personal 1 and when is non personal 0)----
CASE
		when wh.contract_type
		IN ('Operational Worker - Fixed Term (Fixed Term)', 'Operational Worker - Permanent')
		THEN 1
		ELSE 0
END AS picker_non_picker, ---Picker/Nonpicker calculation (when is picker 1 and when is not picker 0)----
case
	when wh.management_level IN ('M3','M4','M5', 'M6', 'E1') then 'M3 & UP'
	when wh.management_level in ('IC1','IC2','IC3', 'IC4', 'IC5') then 'IC'
	when wh.management_level in ('S1','S2','S3', 'S4') then 'S'
	else wh.management_level
end as cluster,
hl.country,
hl.entity,
hl.department,
hl.sub_department,
hl.business_unit,
hl.area,
hl.lucanet_category_1,
hl.scope,
hl.cc_owner,
hl.c_level,
hl.entity_name,
hl.company,
hl.team,
pf.manager_rating_explained,
    CASE
        -- Banda de Tech
        WHEN hl.country IN ('Argentina', 'Uruguay', 'Ecuador', 'Perú') AND
            (hl.lucanet_category_1 = '7- Product Development' OR
             hl.sub_department = 'Data Viz' OR
             (hl.sub_department = 'Finance Systems' AND business_unit <<>> 'Dmarts')) 
             AND NOT (wh.business_title in('Infrastructure Manager','Associate Infrastructure Engineer'))
        	THEN 'Tech'
        -- Banda de Comercial
        WHEN hl.country = 'Argentina' AND
		wh.business_title IN ('Account Executive', 'Sales Executive', 'Telesales Executive','Account Executive Sr','Account Executive Specialist','Sales Executive Specialist','Sales Executive Sr','Account Executive Restaurants') 
			THEN 'Comercial'
        
        -- Banda de Operations
        WHEN hl.country = 'Uruguay' AND
            hl.department = 'Contact Center' AND
            wh.management_level LIKE '%S%'
            THEN 'Operations'
        
        -- Banda de Tech IDs específicos
        WHEN wh.employee_id IN ('2021-02-0230', '2019-12-3531', '2019-12-3583', '2021-09-0854', '2022-09-2533', '2023-04-0325', '2023-06-0427')
        THEN 'Tech'
        
        -- Banda de Staff
        ELSE 'Staff'
    END AS tipo_de_banda
	


FROM
    people_ops_proposed.il_worker_hist_with_current wh
INNER JOIN
    people_ops_proposed.il_worker_personal wp ON wh.employee_id = wp.employee_id
INNER JOIN
    people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id 
LEFT JOIN
    people_ops_proposed.il_cc_hierarchy_latam hl ON hl.cost_center_id = wh.cost_center_id 

LEFT JOIN
    people_ops_proposed.il_salary_hist_with_current sh ON sh.employee_id = wh.employee_id 
    AND sh.report_effective_date = wh.report_effective_date 
left join people_ops_proposed.il_performance AS pf ON sh.employee_id = pf.employee_id
AND EXTRACT(YEAR FROM CAST(sh.report_effective_date AS DATE)) = EXTRACT(YEAR FROM CAST(pf.review_date AS DATE))
AND EXTRACT(MONTH FROM CAST(pf.review_date AS DATE)) = 1


WHERE
    cm.brand = 'PedidosYa'
  
    )SELECT
  pr.employee_id,
  pr.full_name,
  pr.report_effective_date,
  pr.report_date_month,
  SUM(CASE
    WHEN ig_unique.stock_plan LIKE '%LTIP%' 
         AND pr.report_effective_date BETWEEN ig_unique.grant_effective_date 
                                       AND COALESCE(ig_unique.grant_expiration_date, pr.report_effective_date)
    THEN
      CASE
        WHEN ig_unique.vesting_schedule = '2-Year Cliff Vest' THEN ig_unique.granted_amount / 2
        ELSE ig_unique.granted_amount
      END
    ELSE 0
END) AS total_LTIP,
  SUM(CASE
    WHEN ig_unique.stock_plan LIKE '%Hero%' 
         AND pr.report_effective_date BETWEEN ig_unique.grant_effective_date 
                                       AND COALESCE(ig_unique.grant_expiration_date, pr.report_effective_date)
    THEN
      CASE
        WHEN ig_unique.vesting_schedule = '2-Year Cliff Vest' THEN ig_unique.granted_amount / 2
        ELSE ig_unique.granted_amount
      END
    ELSE 0
END) AS Hero_grant
FROM py_rewards pr
LEFT JOIN (
  SELECT DISTINCT ig.employee_id, ig.grant_effective_date, ig.stock_plan, ig.granted_amount, ig.grant_expiration_date, ig.vesting_schedule
  FROM people_ops_proposed.il_stock_grant ig
) ig_unique ON pr.employee_id = ig_unique.employee_id
GROUP BY pr.employee_id, pr.full_name, pr.report_effective_date, pr.report_date_month]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
