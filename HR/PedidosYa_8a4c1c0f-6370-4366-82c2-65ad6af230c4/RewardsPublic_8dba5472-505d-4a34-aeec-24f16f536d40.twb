    <worksheet name='% de incremento de la masa salarial'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontalignment='1' fontsize='8'>&lt;</run>
            <run fontalignment='1' fontsize='8'>Sheet Name</run>
