      <column caption='First Total Comp' datatype='real' name='[Calculation_1475773329915432960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { INCLUDE  [employee_id] : MIN([first_day_of_work])} = [first_day_of_work] THEN [Calculation_1705456891836534798] END' />
