      <aliases enabled='yes' />
      <column caption='% Incremento (año) ' datatype='real' default-format='p0.0%' name='[% Incremento (mes) (copia)_735775615137980430]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN  1 then&#13;&#10;&#13;&#10;[% de incremento de la masa salarial (Q) (copia)_735775615092596742]&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[% de incremento de la masa salarial (año) (copia)_735775615135748107]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='% de incremento de la masa salarial (año)' datatype='real' name='[% de incremento de la masa salarial (Q) (copia)_735775615092596742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Total Salario Bruto (percibido) HOY (copia)_1277614944983998480])- [Calculation_735775615055941634])/[Calculation_735775615055941634]' />
      </column>
      <column caption='% de incremento de la masa salarial percibido (año) ' datatype='real' name='[% de incremento de la masa salarial (año) (copia)_735775615135748107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Total Salario Bruto (percibido) (copia)_1525312924082761759])&#13;&#10;&#13;&#10;&#13;&#10;- [Salario Bruto (año pasado) (copia)_735775615135641610])&#13;&#10;&#13;&#10;&#13;&#10;/[Salario Bruto (año pasado) (copia)_735775615135641610]' />
      </column>
      <column caption='% de incremento de la masa salarial percibido (mes) ' datatype='real' name='[% de incremento de la masa salarial (mes) (copia)_735775615136256012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Total Salario Bruto (percibido) (copia)_1525312924082761759]) &#13;&#10;&#13;&#10;-[Salario Bruto (Mes pasado) (copia)_735775615135490057])&#13;&#10;&#13;&#10;&#13;&#10;/([Salario Bruto (Mes pasado) (copia)_735775615135490057])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0wp8nxf1rof8v11e7qog41bfq32z].[sum:bonficacion_incentivo:qk]&quot;' value='Gratificación Guatemala' />
          <alias key='&quot;[federated.0wp8nxf1rof8v11e7qog41bfq32z].[sum:comission_plan:qk]&quot;' value='Comisiones' />
          <alias key='&quot;[federated.0wp8nxf1rof8v11e7qog41bfq32z].[sum:Salary Midpoint (expressed annual and in local currency):qk]&quot;' value='Punto Medio Total Comp' />
        </aliases>
      </column>
      <column caption='Posicionamiento en BS' datatype='string' name='[Agrupador de Banda Salarial  (copia)_837388075653967873]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [PayGap (copia)_1079175076816703489]&lt;=0.77 then &apos;Under&apos;&#13;&#10;ELSEIF [PayGap (copia)_1079175076816703489]&gt;=1.22 then &apos;Above&apos;&#13;&#10;ELSEIF [PayGap (copia)_1079175076816703489]&gt;0.77 OR [PayGap (copia)_1079175076816703489]&lt;1.22 then &apos;Inside&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Bono (percibido)' datatype='real' name='[Bono (copia)_126382278086967303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2250392458803855361]* [Total Salario Bruto para bono (copia)_126382278086451206]' />
      </column>
      <column caption='Bono Female' datatype='real' name='[Bono (copia)_1995657594955333646]' role='measure' type='quantitative'>
