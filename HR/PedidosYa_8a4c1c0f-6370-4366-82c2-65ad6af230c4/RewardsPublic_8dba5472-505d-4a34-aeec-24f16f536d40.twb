        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='[consulta_sql_perso].[employee_id]' />
                  <expression op='[il_manager_hist_wi].[employee_id]' />
                </expression>
                <expression op='='>
                  <expression op='date([consulta_sql_perso].[report_effective_date])' />
                  <expression op='date([il_manager_hist_wi].[report_effective_date])' />
                </expression>
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='AND'>
                  <expression op='='>
                    <expression op='[consulta_sql_perso].[salary_currency]' />
                    <expression op='[Dolares Convertidos1].[source_currency]' />
                  </expression>
                  <expression op='='>
                    <expression op='DATE([consulta_sql_perso].[report_date_month])' />
                    <expression op='[Dolares Convertidos1].[curreny_exchange_date]' />
                  </expression>
                </expression>
              </clause>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[consulta_sql_perso].[salary_currency]' />
                      <expression op='[bl_currency_exchan1].[source_currency]' />
                    </expression>
                    <expression op='='>
                      <expression op='[consulta_sql_perso].[report_date_month]' />
                      <expression op='[bl_currency_exchan1].[curreny_exchange_date]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='[consulta_sql_perso].[employee_id]' />
                        <expression op='[Doble Nomina1].[WD ID]' />
                      </expression>
                      <expression op='='>
                        <expression op='DATE([consulta_sql_perso].[report_date_month])' />
                        <expression op='[Doble Nomina1].[Fecha]' />
                      </expression>
                    </expression>
                  </clause>
                  <relation connection='athena.17346w0153qujg14j9x1v11r95dv' name='consulta_sql_perso' type='text'>
                    <columns>
                      <column datatype='date' date-parse-format='yyyy-MM-dd' name='first_day_of_work' />
                    </columns>
                    <![CDATA[
                    
WITH py_rewards AS (select 
sh.employee_id,
CONCAT(wp.first_name, ' ', wp.last_name) as full_name,
sh.cost_center_id,
sh.salary_frequency,
CASE
  WHEN sh.salary_frequency = 'Semimonthly' THEN sh.salary_amount * 2
  ELSE sh.salary_amount
end as salary_amount,
sh.salary_currency,
sh.report_effective_date,
 DATE_TRUNC('month', DATE(sh.report_effective_date)) AS report_date_month,
sh.period_salary_plan,
wh.is_terminated,
wh.is_people_manager,
wh.first_day_of_work,
wh.last_day_of_work,
wh.business_title,
wh.management_level,
wh.contract_type,
wp.gender,
CASE 
    	WHEN wh.contract_type IN ('Freelancer', 'Agency Worker', 'Consultant', 'Intern (Fixed Term) (Trainee)')
    	THEN 1
    	ELSE 0
END AS is_personnel, ---personnell/Nonpersonnel calculation (when is personal 1 and when is non personal 0)----
CASE
		when wh.contract_type
		IN ('Operational Worker - Fixed Term (Fixed Term)', 'Operational Worker - Permanent')
		THEN 1
		ELSE 0
END AS picker_non_picker, ---Picker/Nonpicker calculation (when is picker 1 and when is not picker 0)----
case
	
        when wh.management_level IN ('M3','M4','M5', 'M6', 'E1') then 'M3 & UP'
	when wh.management_level IN('M1','M2') then 'M1 & M2'
        when wh.management_level in ('IC1','IC2','IC3', 'IC4', 'IC5','IC6') then 'IC'
	when wh.management_level in ('S1','S2','S3', 'S4') then 'S'
	else wh.management_level
end as cluster,
hl.country,
hl.entity,
hl.department,
hl.sub_department,
hl.business_unit,
hl.area,
hl.lucanet_category_1,
hl.scope,
hl.cc_owner,
hl.c_level,
hl.entity_name,
hl.company,
hl.team,
	case
     when  hl.lucanet_category_1 ='7- Product Development' or hl.area ='Internal IT'
     then 'Tech'
     else 'Non Tech'
	 end as tech_non_tech,
	 
	CASE 
     WHEN wh.contract_type IN ('Freelancer', 'Agency Worker', 'Consultant', 'Intern (Fixed Term) (Trainee)')
     THEN 'Non Personnel'
     ELSE 'Personnel'
 END AS personnel_non_personnel,

pf.manager_rating_explained,
    CASE
        -- Banda de Tech
        WHEN hl.country IN ('Argentina', 'Uruguay', 'Ecuador', 'Perú') AND
            (hl.lucanet_category_1 = '7- Product Development' OR
             hl.sub_department = 'Data Viz' OR
             (hl.sub_department = 'Finance Systems' AND business_unit <<>> 'Dmarts')) 
             AND NOT (wh.business_title in('Infrastructure Manager','Associate Infrastructure Engineer'))
        	THEN 'Tech'
        -- Banda de Comercial
        WHEN hl.country = 'Argentina' AND
		wh.business_title IN ('Account Executive', 'Sales Executive', 'Telesales Executive','Account Executive Sr','Account Executive Specialist','Sales Executive Specialist','Sales Executive Sr','Account Executive Restaurants') 
			THEN 'Comercial'
        
        -- Banda de Operations
        WHEN hl.country = 'Uruguay' AND
            hl.department = 'Contact Center' AND
            wh.management_level LIKE '%S%'
            THEN 'Operations'
        
        -- Banda de Tech IDs específicos
        WHEN wh.employee_id IN ('2021-02-0230', '2019-12-3531', '2019-12-3583', '2021-09-0854', '2022-09-2533', '2023-04-0325', '2023-06-0427')
        THEN 'Tech'
        
        -- Banda de Staff
        ELSE 'Staff'
    END AS tipo_de_banda
	


FROM
    people_ops_proposed.il_worker_hist_with_current wh
INNER JOIN
    people_ops_proposed.il_worker_personal wp ON wh.employee_id = wp.employee_id
INNER JOIN
    people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id 
LEFT JOIN
    people_ops_proposed.il_cc_hierarchy_latam hl ON hl.cost_center_id = wh.cost_center_id 

LEFT JOIN
    people_ops_proposed.il_salary_hist_with_current sh ON sh.employee_id = wh.employee_id 
    AND sh.report_effective_date = wh.report_effective_date 
left join people_ops_proposed.il_performance AS pf ON sh.employee_id = pf.employee_id
AND EXTRACT(YEAR FROM CAST(sh.report_effective_date AS DATE)) = EXTRACT(YEAR FROM CAST(pf.review_date AS DATE))
AND EXTRACT(MONTH FROM CAST(pf.review_date AS DATE)) = 1


WHERE
    cm.brand = 'PedidosYa'
    and is_terminated = 0
     AND YEAR(CAST(wh.report_effective_date AS DATE)) >>= 2021
     AND wh.management_level NOT IN ('E1', 'M5', 'M6')
   
    )


select distinct 

pr.employee_id,
pr.full_name,
pr.cost_center_id,
pr.salary_frequency,
pr.salary_amount,
pr.salary_currency,
pr.report_effective_date,
DATE_FORMAT(pr.report_date_month, '%Y-%m-%d') AS report_date_month,
CASE
    WHEN pr.country = 'Chile' AND pr.report_effective_date << '2023-04-01' THEN '13th Month'
    WHEN pr.country = 'Chile' AND pr.report_effective_date >>= '2023-04-01' THEN '12th Month'
    ELSE pr.period_salary_plan
  	end as period_salary_plan,
pr.is_terminated,
pr.is_people_manager,
pr.first_day_of_work,
pr.last_day_of_work,
pr.business_title,
pr.management_level,
pr.gender,
pr.is_personnel,
pr.picker_non_picker,
pr.contract_type,
pr.cluster,
pr.country,
pr.entity,
pr.department,
pr.sub_department,
pr.business_unit,
pr.area,
pr.lucanet_category_1,
pr.scope,
pr.cc_owner,
pr.c_level,
pr.entity_name,
pr.company,
pr.team,
pr.manager_rating_explained,
pr.personnel_non_personnel,
pr.tech_non_tech,
pr.tipo_de_banda,
    CASE
                WHEN pr.country = 'República Dominicana' AND pr.scope = 'Local' AND pr.tech_non_tech= 'Non Tech'
                AND (pr.employee_id = '2020-07-0326' OR pr.employee_id = '2020-03-0281') THEN 'Dominicana BU'
                WHEN pr.country = 'Bolivia' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Bolivia BU'
                WHEN pr.country = 'Chile' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Chile BU'
                WHEN pr.country = 'Costa Rica' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Costa Rica BU'
                WHEN pr.country = 'Ecuador' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Ecuador BU'
                WHEN pr.country = 'El Salvador' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'El Salvador BU'
                WHEN pr.country = 'Guatemala' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Guatemala BU'
                WHEN pr.country = 'Honduras' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Honduras BU'
                WHEN pr.country = 'Nicaragua' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Nicaragua BU'
                WHEN pr.country = 'Panamá' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Panamá BU'
                WHEN pr.country = 'Paraguay' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Paraguay BU'
                WHEN pr.country = 'Perú' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Perú BU'
                WHEN pr.country = 'Uruguay' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Uruguay BU'
                WHEN pr.country = 'Venezuela' AND pr.scope = 'Local' AND pr.tech_non_tech = 'Non Tech' THEN 'Venezuela BU'
                WHEN pr.country = 'Argentina' AND pr.scope = 'Local'
                AND pr.cost_center_id NOT IN ('6001D09951', '6001203321', '6006209951')
                AND pr.department IN ('Business Management', 'Logistics and Operations', 'Finance', 'People') THEN 'Argentina BU Support'
                WHEN pr.country = 'Argentina' AND pr.scope = 'Local'
                AND (pr.department IN ('Marketing', 'Customer Operations Strategy')
                OR pr.cost_center_id IN ('6001202501', '6001202321', '6001202121')) THEN 'Argentina BU Operations I'
                WHEN pr.country = 'Argentina' AND pr.scope = 'Local' AND pr.department = 'Sales'
                AND pr.cost_center_id NOT IN ('6001202501', '6001202321', '6001202121') THEN 'Argentina BU Operations II'
                WHEN pr.country = 'Argentina' AND pr.scope = 'Local' AND pr.department IN ('Quick Commerce', 'Dmarts')
                AND pr.sub_department NOT IN ('Pickers', 'Shift Supervisors & Store Managers') THEN 'Argentina BU Operations III'
                WHEN pr.country = 'Argentina' AND pr.scope = 'Local'
                AND pr.sub_department IN ('Pickers', 'Shift Supervisors & Store Managers') THEN 'Argentina Tiendas'
                WHEN pr.scope IN ('Regional', 'SSC')
                AND pr.department IN ('Quick Commerce', 'Dmarts', 'Contact Center', 'Logistics and Operations', 'Customer Operations Strategy', 'Sales', 'Business Management')
                AND pr.employee_id NOT IN ('2020-07-0326', '2023-04-0324', '2020-03-028') OR pr.department = 'Supply Chain' THEN 'Dmarts Regional Staff'
                WHEN pr.scope IN ('Regional', 'SSC') AND pr.department IN ('Finance', 'Fintech') THEN 'Regional Fintech'
                WHEN pr.scope IN ('Regional', 'SSC') AND pr.department IN ('Marketing', 'People') THEN 'Regional Mkt-People'
                WHEN pr.tech_non_tech = 'Tech' THEN 'Tech'
                ELSE 'Sin Nadie'
            end as scope_people_partners,
case
	when it.individual_target is not null then it.individual_target
	else 0
end as individual_target,
sum(   case
	when  cpa.compensation_plan  = 'Bonificación Incentivo' and cpa.frequency = 'Semimonthly' THEN CAST(cpa.amount AS DECIMAL(10, 2)) * 2
	when cpa.compensation_plan  = 'Bonificación Incentivo' and cpa.frequency = 'Monthly' THEN CAST(cpa.amount AS DECIMAL(10, 2))

    ELSE 0
    
	end) as bonficacion_incentivo,
sum(	case
	when  cpa.compensation_plan  = 'Other Commission Plan' and cpa.frequency = 'Semimonthly' THEN CAST(cpa.amount AS DECIMAL(10, 2)) * 2
	when  cpa.compensation_plan  = 'Monthly Performance Bonus' and cpa.frequency = 'Semimonthly' THEN CAST(cpa.amount AS DECIMAL(10, 2)) * 2
	when cpa.compensation_plan  = 'Other Commission Plan' and cpa.frequency = 'Monthly' THEN CAST(cpa.amount AS DECIMAL(10, 2))
	when cpa.compensation_plan  = 'Monthly Performance Bonus' and cpa.frequency = 'Monthly' THEN CAST(cpa.amount AS DECIMAL(10, 2))

	ELSE 0 
	end ) as comission_plan
	
	
FROM
    py_rewards pr
 LEFT JOIN
 people_ops_proposed.pl_e_py_compensation_plan_individual_target it on it.employee_id = pr.employee_id
 
LEFT JOIN
    people_ops_proposed.il_compensation_plan_assignment cpa
    ON pr.employee_id = cpa.employee_id
    
 group by 
 pr.employee_id,
pr.full_name,
pr.cost_center_id,
pr.salary_frequency,
pr.salary_amount,
pr.salary_currency,
pr.report_effective_date,
report_date_month,
pr.period_salary_plan,
pr.is_terminated,
pr.is_people_manager,
pr.first_day_of_work,
pr.last_day_of_work,
pr.business_title,
pr.management_level,
pr.gender,
pr.is_personnel,
pr.picker_non_picker,
pr.contract_type,
pr.cluster,
pr.country,
pr.entity,
pr.department,
pr.sub_department,
pr.business_unit,
pr.area,
pr.lucanet_category_1,
pr.scope,
pr.cc_owner,
pr.c_level,
pr.entity_name,
pr.company,
pr.team,
pr.manager_rating_explained,
pr.personnel_non_personnel,
pr.tech_non_tech,
pr.tipo_de_banda,
individual_target                                    ]]>                  </relation>
                  <relation connection='cloudfile:googledrive-excel-direct.1hbzzmw1dpa16a18pxy6y0qjfxrm' name='Doble Nomina1' table='[&apos;Doble Nomina$&apos;]' type='table'>
                    <columns gridOrigin='A1:D1322:no:A1:D1322:0' header='yes' outcome='2'>
                      <column datatype='date' name='Fecha' ordinal='0' />
