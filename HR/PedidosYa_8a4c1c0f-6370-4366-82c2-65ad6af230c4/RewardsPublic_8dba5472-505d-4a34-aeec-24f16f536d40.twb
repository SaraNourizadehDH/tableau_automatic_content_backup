              <calculation class='tableau' formula='ZN(if [country] = &apos;Argentina&apos; then [Calculation_572238643010846720] * &#13;&#10;&#13;&#10;&#13;&#10;[Calculation_1549519770268909569]&#13;&#10;&#13;&#10;&#13;&#10; ELSEIF &#13;&#10;[country] &lt;&gt; &apos;Argentina&apos; then [Calculation_1705456891795755008]*(1/[currency_exchange_rate (bl_currency_exchan1)]) end)' />
