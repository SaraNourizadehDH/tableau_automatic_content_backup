    <worksheet name='Evolución Comp-ratio'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
            <run fontcolor='#fa0050' fontsize='12'> &lt;[Parameters].[Parámetro 2]&gt;</run>
