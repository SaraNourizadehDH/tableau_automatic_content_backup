        <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;quarter&apos;, [report_date_month (copia)_1105352250027118592]) = DATEADD(&apos;quarter&apos;, -1, [Calculation_1525312924036485122])&#13;&#10;THEN [Calculation_260082885670838274]&#13;&#10;END)' />
      </column>
      <column caption='This month (vista)' datatype='datetime' name='[Calculation_1525312924043132934]' role='dimension' type='quantitative'>
