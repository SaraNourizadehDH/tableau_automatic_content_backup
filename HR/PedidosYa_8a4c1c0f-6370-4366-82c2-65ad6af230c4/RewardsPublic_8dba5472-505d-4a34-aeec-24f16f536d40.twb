      <column caption='Fecha ingreso' datatype='datetime' name='[Calculation_1475773329919631362]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,[Parameters].[Parámetro 4]-[first_day_of_work],[Parameters].[Parámetro 4])' />
