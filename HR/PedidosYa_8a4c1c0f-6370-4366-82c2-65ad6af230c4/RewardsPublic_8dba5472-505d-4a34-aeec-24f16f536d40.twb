              <calculation class='tableau' formula='[salary_amount]+[Calculation_1705456891868409875]+[bonficacion_incentivo]+[Calculation_1211749812706357248]' />
            </column>
            <column caption='Total Salario Bruto para bono (percibido)' datatype='real' name='[Total Salario Bruto para bono (copia)_126382278086451206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_126382277856342021]+[Doble Nomina en pesos (copia)_126382277854289922]+[bonficacion_incentivo]+[Calculation_1211749812706357248]' />
