              <calculation class='tableau' formula='IF ISNULL([Bono Female (copia)_572238643046064135]) OR [Bono Female (copia)_572238643046064135] &lt;= 0 THEN 0 ELSE [Bono Female (copia)_572238643046064135] END' />
