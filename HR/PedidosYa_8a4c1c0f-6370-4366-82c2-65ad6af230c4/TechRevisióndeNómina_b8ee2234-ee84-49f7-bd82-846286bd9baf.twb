      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Gender Mix</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='18'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Calculation_754634453995634695:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#661ec8' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo hc mes (copia)_1460010745916182554:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% mes anterior (copia)_1460010745913790487:qk]>]]></run>
            <run fontalignment='1' fontsize='8'>Æ </run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='8'>vs mes anterior </run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo hc año (copia)_1460010745916280859:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% año  anterior (copia)_1460010745914900505:qk]>]]></run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='8'> mismo mes del año anterior</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
          </datasources>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='% año  anterior (mujeres)' datatype='real' default-format='p0.00%' name='[% año  anterior (copia)_1460010745914900505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_754634453995634695]-[Gender Mix (mes anterior) (copia)_1609192491080351747]' />
            </column>
            <column caption='% mes anterior (mujeres)' datatype='real' default-format='p0.00%' name='[% mes anterior (copia)_1460010745913790487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_754634453995634695]-[Gender Mix (hoy) (copia)_1609192491079606274]' />
            </column>
            <column caption='gender mix leader gral' datatype='real' default-format='p0.0%' name='[Calculation_1241023214441873411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([female_leadership])/SUM([leadership])' />
            </column>
            <column caption='Quarter' datatype='boolean' name='[Calculation_1572319274683138048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;quarter&apos;,1,DATETRUNC(&apos;quarter&apos;,[report_effective_date]))) = [report_effective_date]' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Gender Mix (hoy)' datatype='real' default-format='p0.0%' name='[Calculation_754634453995634695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_754634453995364357])/SUM([Calculation_1460010745856528387])' />
            </column>
            <column caption='Positivo/Negativo mujeres año' datatype='string' name='[Postivo/Negativo hc año (copia)_1460010745916280859]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% año  anterior (copia)_1460010745914900505]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='Positivo/Negativo mujeres mes' datatype='string' name='[Postivo/Negativo hc mes (copia)_1460010745916182554]' role='measure' type='nominal'>
