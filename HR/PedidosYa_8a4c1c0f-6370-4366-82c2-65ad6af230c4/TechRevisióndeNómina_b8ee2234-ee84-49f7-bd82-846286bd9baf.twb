          <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='consulta_sql_perso2' type='text'>WITH&#13;
    all_employees AS&#13;
        (SELECT&#13;
            *&#13;
        FROM&#13;
            people_ops_proposed.il_job_requisition &#13;
        ),&#13;
    Open AS&#13;
        (SELECT&#13;
           date(date_trunc(&apos;month&apos;, now())) AS date_month,&#13;
            ae.company_id,&#13;
            ae.cost_center_id,&#13;
            ae.is_evergreen,&#13;
            ae.is_confidential_job,&#13;
            sum(CASE WHEN status  = &apos;Open&apos; THEN CAST(job_openings_total as INT)  ELSE NULL END) AS Open&#13;
        FROM&#13;
            all_employees ae&#13;
        GROUP BY&#13;
            1, 2, 3, 4, 5 )&#13;
SELECT&#13;
    --dimensions&#13;
    date_month,&#13;
    company_id,&#13;
    cost_center_id,&#13;
    is_evergreen,&#13;
    is_confidential_job,&#13;
    --actuals&#13;
    COALESCE(a.Open, 0) AS Open&#13;
FROM &#13;
    Open a</relation>
          <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='consulta_sql_perso1' type='text'>WITH all_employees AS (&#13;
    SELECT *&#13;
    FROM people_ops_proposed.il_worker_hist_with_current&#13;
),&#13;
actuals AS (&#13;
    SELECT&#13;
        date_trunc(&apos;month&apos;, DATE(ae.report_effective_date)) AS date_month,&#13;
        ae.employee_id,&#13;
        ae.company_id,&#13;
        ae.cost_center_id,&#13;
        ae.contract_type,&#13;
        SUM(CAST(ae.fte AS DECIMAL(10, 2))) AS fte,&#13;
        COUNT(DISTINCT CASE WHEN ae.is_terminated = 0 THEN ae.employee_id ELSE NULL END) AS actual&#13;
    FROM all_employees ae&#13;
    WHERE ae.is_terminated = 0&#13;
    GROUP BY 1, 2, 3, 4, 5&#13;
)&#13;
SELECT&#13;
    --dimensions&#13;
    date_month,&#13;
    employee_id,&#13;
    company_id,&#13;
    cost_center_id,&#13;
    contract_type,&#13;
    CAST(fte AS DECIMAL(10, 2)) AS fte,&#13;
    CAST(actual AS DECIMAL(10, 2)) AS actual,&#13;
    --additional field&#13;
    CASE&#13;
        WHEN contract_type LIKE &apos;%Operational Worker%&apos;&#13;
            THEN CAST(fte AS DECIMAL(10, 2))&#13;
        ELSE CAST(actual AS DECIMAL(10, 2))&#13;
    END AS actual_fte&#13;
FROM actuals a</relation>
