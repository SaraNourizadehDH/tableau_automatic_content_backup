          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='Color' datatype='string' name='[Calculation_1001488013157625856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [month wh (copia)_292734017822453762]) = [This month (target) (copia)_292734017826525194]&#13;&#10;then &apos;Este mes&apos;&#13;&#10;else &apos;Otros Meses&apos;&#13;&#10;END)' />
            </column>
            <column caption='Δ delta' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_292734017820430336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([actual_fte]))-SUM([Target])' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Picker/Non Picker (by CeCo)' datatype='string' name='[Calculation_617556128157429760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sub_department]=&apos;Pickers&apos;&#13;&#10;then &apos;Picker&apos;&#13;&#10;ELSE &apos;Non Picker&apos;&#13;&#10;END' />
            </column>
            <column caption='Elegir Vista.' datatype='string' name='[Elegir Vista I (copia)_322007426698379269]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View  (copia)_322007426697707524]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]  &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [country]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Tienda | Location&quot; then [company]&#13;&#10;    when &quot;Owner Ceco&quot; then [cc_owner]&#13;&#10;when &apos;Entity&apos; then str([entity])&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='No aplica para esta sección' />
              </aliases>
            </column>
            <column caption='Elegir Vista I.' datatype='string' name='[Elegir Vista. (copia)_322007426707890185]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View. (copia)_322007426707689478]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]  &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [country]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Tienda | Location&quot; then [company]&#13;&#10;    when &quot;Owner Ceco&quot; then [cc_owner]&#13;&#10;when &apos;Entity&apos; then str([entity])&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
              <aliases>
