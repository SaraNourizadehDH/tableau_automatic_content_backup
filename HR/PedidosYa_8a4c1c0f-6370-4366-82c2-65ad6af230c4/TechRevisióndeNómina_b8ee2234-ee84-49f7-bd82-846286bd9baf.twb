      <column caption='NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1651132214056869892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_1651132214056579074]-[Calculation_1651132214056775683])*100)' />
      </column>
      <column caption='Termination Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
      </column>
      <column caption='Termination Voluntary mes anterior' datatype='integer' name='[Calculation_1669146655069106176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Latest month (copia)_1460010745866440709] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
      </column>
