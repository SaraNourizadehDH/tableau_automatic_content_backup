    <worksheet name='Tabla de Headcount mes by company'>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View ' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Squads&quot;'>
              <calculation class='tableau' formula='&quot;Squads&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
                <alias key='&quot;Gender&quot;' value='Género' />
                <alias key='&quot;Platform/Dmarts&quot;' value='Unidad de Negocio' />
                <alias key='&quot;Subdepartamento&quot;' value='Subdepartamento' />
                <alias key='&quot;Termination Antiguedad&quot;' value='Agrupador por Antiguedad' />
                <alias key='&quot;Termination Antiguedad Picker view&quot;' value='(Picker) Agrupador por Antiguedad' />
                <alias key='&quot;Tribu/LOB&quot;' value='Tribu/LOB' />
              </aliases>
            </column>
            <column caption='Actual o Terminations' datatype='string' name='[Parámetro 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Actual&quot;'>
              <calculation class='tableau' formula='&quot;Actual&quot;' />
            </column>
            <column caption='Switch View I' datatype='string' name='[Switch View  (copia)_733805298216783875]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dominio&quot;'>
              <calculation class='tableau' formula='&quot;Dominio&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
                <alias key='&quot;Gender&quot;' value='Género' />
                <alias key='&quot;Platform/Dmarts&quot;' value='Unidad de Negocio' />
                <alias key='&quot;Subdepartamento&quot;' value='Subdepartamento' />
                <alias key='&quot;Termination Antiguedad&quot;' value='Agrupador por Antiguedad' />
                <alias key='&quot;Termination Antiguedad Picker view&quot;' value='(Picker) Agrupador por Antiguedad' />
                <alias key='&quot;Tribu/LOB&quot;' value='Tribu/LOB' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='PCR' datatype='string' name='[Calculation_1276489074128953345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department]=&apos;Sales&apos;&#13;&#10;then &apos;Sales&apos;&#13;&#10;ELSEIF [picker_non_picker]=&apos;Picker&apos;&#13;&#10;then &apos;Dmarts&apos;&#13;&#10;else &apos;Staff&apos;&#13;&#10;END' />
            </column>
            <column caption='Measure actual o terminations' datatype='real' name='[Calculation_1496602451266736129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 5]&#13;&#10;    when &quot;Actual&quot; then [Calculation_1496602451267571717]&#13;&#10;    WHEN &quot;terminations&quot; THEN [Calculation_1496602451267674118]&#13;&#10;    WHEN &quot;fte&quot; then [Calculation_1496602451268501511]&#13;&#10;END' />
            </column>
            <column caption='actuals' datatype='integer' name='[Calculation_1496602451267571717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(actual)' />
            </column>
            <column caption='termination' datatype='integer' name='[Calculation_1496602451267674118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([terminations])' />
            </column>
            <column caption='ftes' datatype='real' datatype-customized='true' name='[Calculation_1496602451268501511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_982910667737714688] = &apos;Activo&apos; then [fte] END)' />
            </column>
            <column caption='Termination Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Termination Antiguedad Picker view' datatype='string' name='[Calculation_194499214383415296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 90 THEN &quot;Less than 3 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 90 AND [time_in_company_days] &lt; 180 THEN &quot;3 months to 6 month&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Agrupador Performance' datatype='string' name='[Calculation_250231256266432513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manager_rating_explained]=&apos;Development Needed&apos; or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Need Development Talent&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Core Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Good Performance&quot;' value='Mid' />
                <alias key='&quot;High Performance&quot;' value='High ' />
                <alias key='&quot;Low Performance&quot;' value='Low ' />
              </aliases>
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Company_' datatype='string' name='[Calculation_415175643255148545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([company],&apos; &apos;,1)' />
            </column>
            <column caption='Agrupador Tabla HC Detail' datatype='string' name='[Calculation_415175643259981826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [Calculation_415175643255148545]&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
