            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo to año anterior (copia)_1460010746004013118:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% Diferencia turnover YTD (copia)_1609192491111596050:qk]>]]></run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8' italic='true'>(pp) </run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='8'>mismo periodo año anterior</run>
