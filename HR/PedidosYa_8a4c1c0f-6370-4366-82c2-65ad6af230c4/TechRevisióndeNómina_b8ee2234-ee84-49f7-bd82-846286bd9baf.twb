          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='% año  anterior' datatype='real' default-format='p0.00%' name='[% mes anterior (copia)_1460010745904443409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1460010745856528387])/SUM([HC año anterior (copia)_1460010745982963761])-1' />
            </column>
            <column caption='HC Hoy' datatype='integer' name='[Calculation_1460010745856528387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='% mes anterior' datatype='real' default-format='p0.00%' name='[Calculation_1460010745871695881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1460010745856528387])/SUM([HC Hoy (copia)_1460010745865334788])-1' />
            </column>
            <column caption='Positivo/Negativo hc mes' datatype='string' name='[Calculation_1460010745903144975]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1460010745871695881]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='HC mes anterior' datatype='integer' name='[HC Hoy (copia)_1460010745865334788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Latest month (copia)_1460010745866440709] &#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='HC mes año anterior' datatype='integer' name='[HC año anterior (copia)_1460010745982963761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745983529010] &#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='last month' datatype='datetime' name='[Latest month (copia)_1460010745866440709]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Parameters].[Parámetro 4])' />
            </column>
            <column caption='Positivo/Negativo hc año' datatype='string' name='[Postivo/Negativo hc mes (copia)_1460010745905602578]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% mes anterior (copia)_1460010745904443409]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='This month (vista)' datatype='datetime' name='[This month (copia)_164944393257082881]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])) }' />
