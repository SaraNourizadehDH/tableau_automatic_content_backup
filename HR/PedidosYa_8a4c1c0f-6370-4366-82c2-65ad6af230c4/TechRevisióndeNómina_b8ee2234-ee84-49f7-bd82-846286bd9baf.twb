            <column caption='Personnel/Non Personnel (SQL)' datatype='string' name='[Personnel/Non Personnel (copia)_314689074895310848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contract_type]=&apos;Freelancer&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Agency Worker&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Consultant&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Intern (Fixed Term) (Trainee)&apos;&#13;&#10;then &apos;Non Personnel&apos;&#13;&#10;else &apos;Personnel&apos;&#13;&#10;END' />
