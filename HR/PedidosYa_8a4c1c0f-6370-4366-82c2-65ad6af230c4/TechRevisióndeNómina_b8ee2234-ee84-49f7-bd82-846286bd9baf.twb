      <column caption='Dato TO según filtro' datatype='string' name='[Calculation_1305762429213192193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([report_effective_date])= YEAR([This month (copia)_1460010745871441928])&#13;&#10;then &apos;YTD&apos;&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
      </column>
      <column caption='Turnover con vista' datatype='real' default-format='p0.0%' name='[Calculation_1329969287826866176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3 1]=&apos;Voluntaria&apos;&#13;&#10;then [Turnover (voluntary) (copia)_528891529644888069]&#13;&#10;ELSEIF [Parameters].[Parámetro 3 1]=&apos;Involuntaria&apos;&#13;&#10;then [Turnover general (voluntary) (copia 2)_126945223557804032]&#13;&#10;ELSEIF [Parameters].[Parámetro 3 1]=&apos;General&apos;&#13;&#10;then [Turnover (copia)_528891529638322179]&#13;&#10;END' />
      </column>
      <column caption='Fte.' datatype='real' name='[Calculation_1346576333094359043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fte (consulta_sql_perso1)])' />
      </column>
      <column caption='actuals23' datatype='real' name='[Calculation_1346576333127581707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([actual (consulta_sql_perso1)])&#13;&#10;then 0&#13;&#10;else [actual (consulta_sql_perso1)]&#13;&#10;END' />
      </column>
      <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
      </column>
      <column caption='HC Hoy' datatype='integer' name='[Calculation_1460010745856528387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [actual]&#13;&#10;END)' />
      </column>
      <column caption='% mes anterior' datatype='real' default-format='p0.00%' name='[Calculation_1460010745871695881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1460010745856528387])/SUM([HC Hoy (copia)_1460010745865334788])-1' />
      </column>
      <column caption='Positivo/Negativo hc mes' datatype='string' name='[Calculation_1460010745903144975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1460010745871695881]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
      </column>
      <column caption='Termination año anterior' datatype='integer' name='[Calculation_1460010745937309725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF DATETRUNC(&apos;year&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745871413255] &#13;&#10;THEN [terminations]&#13;&#10;END)' />
      </column>
      <column caption='Antigüedad Terminations' datatype='integer' name='[Calculation_1460010746040189000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([last_day_of_work])&#13;&#10;THEN 0&#13;&#10;ELSE [time_in_company_days]&#13;&#10;END' />
      </column>
      <column caption='Momento de egreso' datatype='string' name='[Calculation_1460010746040938569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1460010746040189000]=0&#13;&#10;THEN &apos;&apos;&#13;&#10;ELSEIF  [Calculation_1460010746040189000]&lt;=30&#13;&#10;THEN &apos;&lt;30 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=60&#13;&#10;THEN &apos;60 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=90&#13;&#10;THEN &apos;90 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=180&#13;&#10;THEN &apos;180 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=365&#13;&#10;THEN &apos;1 año&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=730&#13;&#10;THEN &apos;2 años&apos;&#13;&#10;ELSE &apos;+ 3 años&apos;&#13;&#10;END' />
      </column>
      <column caption='Turnover general FC' datatype='real' default-format='p0.0%' name='[Calculation_1460573702632153088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([terminations])-SUM([Turnover (copia)_754634454002827279]))/([Calculation_528891529645621254]-1))/[Calculation_528891529646510087])*12' />
      </column>
      <column caption='Measure actual o terminations' datatype='real' name='[Calculation_1496602451266736129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 5]&#13;&#10;    when &quot;Actual&quot; then [Calculation_1496602451267571717]&#13;&#10;    WHEN &quot;terminations&quot; THEN [Calculation_1496602451267674118]&#13;&#10;    WHEN &quot;fte&quot; then [Calculation_1496602451268501511]&#13;&#10;END' />
      </column>
      <column caption='actuals' datatype='integer' name='[Calculation_1496602451267571717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(actual)' />
