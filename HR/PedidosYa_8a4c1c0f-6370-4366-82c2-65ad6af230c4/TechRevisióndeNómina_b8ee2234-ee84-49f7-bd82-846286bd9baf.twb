            <column caption='Measure actual o terminations' datatype='real' name='[Calculation_1496602451266736129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 5]&#13;&#10;    when &quot;Actual&quot; then [Calculation_1496602451267571717]&#13;&#10;    WHEN &quot;terminations&quot; THEN [Calculation_1496602451267674118]&#13;&#10;    WHEN &quot;fte&quot; then [Calculation_1496602451268501511]&#13;&#10;END' />
