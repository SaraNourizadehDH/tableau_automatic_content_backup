          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View.' datatype='string' name='[Switch View  (copia)_322007426697707524]' param-domain-type='list' role='measure' type='nominal' value='&quot;Linea de Lucanet&quot;'>
              <calculation class='tableau' formula='&quot;Linea de Lucanet&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
