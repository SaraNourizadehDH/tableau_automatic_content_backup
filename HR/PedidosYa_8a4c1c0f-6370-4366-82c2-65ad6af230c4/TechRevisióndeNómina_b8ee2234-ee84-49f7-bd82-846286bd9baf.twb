        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontsize='12'>Headcount (hoy)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='18'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[sum:Calculation_1460010745856528387:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#ffffff' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% mes anterior (copia)_1460010745904443409:qk]> vs mes anterior  ]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#ffffff' fontsize='8'> mismo mes del año anterior</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
