              <calculation class='tableau' formula='ZN(IF DATETRUNC(&apos;month&apos;, [month target (copia)_292734017826598923]) = [This month (target) (copia)_292734017826525194] &#13;&#10;THEN [actual_fte]&#13;&#10;END)' />
            </column>
            <column datatype='string' name='[Nómina]' role='dimension' type='nominal' />
            <column caption='Personnel/Non Personnel (SQL)' datatype='string' name='[Personnel/Non Personnel (copia)_314689074895310848]' role='dimension' type='nominal'>
