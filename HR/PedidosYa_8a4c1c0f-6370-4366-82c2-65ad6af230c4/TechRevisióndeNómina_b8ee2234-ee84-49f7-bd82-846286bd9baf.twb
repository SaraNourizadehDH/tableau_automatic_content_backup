            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[sum:HC Hoy (copia)_1460010746033233984:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#661ec8' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo hc mes (copia)_1460010746035208263:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% mes anterior (copia)_1460010746034327621:qk]>]]></run>
            <run fontalignment='1' fontcolor='#661ec8' fontsize='8'>Æ </run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='8'>vs mes anterior </run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#0659ff' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo hc año (copia)_1460010746035064902:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% año  anterior (copia)_1460010746034155588:qk]>]]></run>
            <run fontalignment='1' fontcolor='#0659ff' fontsize='8'>Æ </run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='8'>mismo mes del año anterior</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='% año  anterior (hiring)' datatype='real' default-format='p0.00%' name='[% año  anterior (copia)_1460010746034155588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([HC Hoy (copia)_1460010746033233984])/SUM([HC mes año anterior (copia)_1460010746033680449]))-1' />
            </column>
            <column caption='% mes anterior (hiring)' datatype='real' default-format='p0.00%' name='[% mes anterior (copia)_1460010746034327621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([HC Hoy (copia)_1460010746033233984])/SUM([HC mes anterior (copia)_1460010746033942595]))-1' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Hiring Hoy' datatype='integer' name='[HC Hoy (copia)_1460010746033233984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4] &#13;&#10;THEN [hires]&#13;&#10;END)' />
            </column>
            <column caption='Hiring mes anterior' datatype='integer' name='[HC mes anterior (copia)_1460010746033942595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Latest month (copia)_1460010745866440709] &#13;&#10;THEN [hires]&#13;&#10;END)' />
            </column>
            <column aggregation='Sum' caption='Hiring mes año anterior' datatype='integer' name='[HC mes año anterior (copia)_1460010746033680449]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745983529010] &#13;&#10;THEN [hires]&#13;&#10;END)' />
            </column>
            <column caption='last month' datatype='datetime' name='[Latest month (copia)_1460010745866440709]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Parameters].[Parámetro 4])' />
            </column>
            <column caption='Positivo/Negativo hiring año' datatype='string' name='[Postivo/Negativo hc año (copia)_1460010746035064902]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% año  anterior (copia)_1460010746034155588]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='Positivo/Negativo hiring mes' datatype='string' name='[Postivo/Negativo hc mes (copia)_1460010746035208263]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% mes anterior (copia)_1460010746034327621]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='This month (vista)' datatype='datetime' name='[This month (copia)_164944393257082881]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])) }' />
            </column>
            <column datatype='integer' name='[actual]' role='measure' type='quantitative' />
            <column caption='Área de Lucanet' datatype='string' name='[area]' role='dimension' type='nominal' />
            <column caption='Unidad de Negocio' datatype='string' name='[business_unit]' role='dimension' type='nominal' />
