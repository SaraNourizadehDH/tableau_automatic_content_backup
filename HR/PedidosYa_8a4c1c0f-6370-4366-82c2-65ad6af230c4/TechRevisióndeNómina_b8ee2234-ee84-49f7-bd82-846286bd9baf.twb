      <column caption='Gender Mix Target' datatype='real' default-format='p0.0%' name='[Calculation_1633680818918674433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_754634453995634695]-0.48' />
      </column>
      <column caption='NPS Texto' datatype='string' name='[Calculation_1638184366151630849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_1651132214056869892],0))' />
      </column>
      <column caption='Reporte (vista)' datatype='string' name='[Calculation_164944393251074048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[report_effective_date])' />
      </column>
      <column caption='Total Peakon' datatype='integer' name='[Calculation_1651132214055391233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promoter])+SUM([demoter])+SUM([passive])' />
      </column>
      <column caption='NPS Promoter' datatype='real' name='[Calculation_1651132214056579074]' role='measure' type='quantitative'>
