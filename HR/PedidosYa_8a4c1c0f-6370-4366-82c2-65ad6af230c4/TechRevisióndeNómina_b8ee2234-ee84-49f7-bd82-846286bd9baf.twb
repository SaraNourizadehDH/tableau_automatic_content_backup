            <column caption='Total Peakon' datatype='integer' name='[Calculation_1651132214055391233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoter])+SUM([demoter])+SUM([passive])' />
            </column>
            <column caption='NPS Promoter' datatype='real' name='[Calculation_1651132214056579074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoter])/[Calculation_1651132214055391233]' />
            </column>
            <column caption='NPS Demoter' datatype='real' name='[Calculation_1651132214056775683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([demoter])/[Calculation_1651132214055391233]' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1651132214056869892]' role='measure' type='quantitative'>
