            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='! HC promedio año anterior turnover' datatype='integer' name='[! HC promedio año anterior (copia)_904660626793644034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE  DATETRUNC(&apos;month&apos;,[last month (copia)_1460010745983529010]):SUM([! Hc año anterior (copia)_904660626793582593])}' />
            </column>
            <column aggregation='Sum' caption='! Hc año anterior turnover' datatype='integer' name='[! Hc año anterior (copia)_904660626793582593]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;year&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745871413255] AND DATETRUNC(&apos;month&apos;,[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])=[last month (copia)_1460010745871413255]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END)' />
            </column>
            <column caption='Actual Turnover' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual (copia)_904660626792480768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual]+[terminations]' />
            </column>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Meses del año' datatype='integer' name='[Calculation_528891529645621254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])' />
            </column>
            <column caption='Hc gral promedio final' datatype='real' name='[Calculation_528891529646510087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Actual (copia)_904660626792480768])/[Calculation_528891529645621254]' />
            </column>
            <column caption='Meses este año' datatype='integer' name='[Calculation_908319751907045379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY())' />
            </column>
            <column caption='HC promedio mensual turnover' datatype='integer' name='[Calculation_992480792774127620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;month&apos;,[report_effective_date])=[Calculation_1460010745856319490]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END)' />
            </column>
            <column caption='HC este año turnover' datatype='integer' name='[HC este año (copia)_904660626794287109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;year&apos;,[report_effective_date])=[This month (copia)_1460010745871441928]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END' />
            </column>
            <column caption='HC promedio anual (año anterior) turnover' datatype='real' name='[HC promedio anual (año anterior) (copia)_904660626795294727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;year&apos;,[last month (copia)_1460010745871413255]):SUM([! Hc año anterior (copia)_904660626793582593])}/12' />
            </column>
            <column caption='HC promedio anual turnover' datatype='real' name='[HC promedio anual (copia)_904660626794172419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([HC este año (copia)_904660626794287109])/[Calculation_908319751907045379]' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
