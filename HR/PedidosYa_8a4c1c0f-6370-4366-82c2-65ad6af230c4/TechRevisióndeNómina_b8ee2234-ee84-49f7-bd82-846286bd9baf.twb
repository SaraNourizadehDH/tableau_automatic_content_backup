      <column caption='Mujeres Tech' datatype='integer' name='[Calculation_1717278838510960642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_322007426734161932]=&apos;Tech&apos; and [gender]=&apos;Female&apos;&#13;&#10;then [actual]&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Span Directo' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1733885895167991831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1460010745856528387])/SUM([HC Hoy (copia)_10414633073418240])' />
