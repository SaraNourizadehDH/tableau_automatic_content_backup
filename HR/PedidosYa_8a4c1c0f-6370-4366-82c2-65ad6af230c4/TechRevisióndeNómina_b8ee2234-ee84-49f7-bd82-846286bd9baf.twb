      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='% año  anterior (Leader mujeres)' datatype='real' default-format='p0.00%' name='[% año  anterior (hiring) (copia)_1460010746046709838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gender Mix (hoy) (copia)_1460010746049773649]-[Gender Mix Leadership (mes anterior) (copia)_1609192491083292679]' />
            </column>
            <column caption='% mes anterior (Leader mujeres)' datatype='real' default-format='p0.00%' name='[% mes anterior (mujeres) (copia)_1460010746049302608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gender Mix (hoy) (copia)_1460010746049773649]-[Gender Mix Leadership (hoy) (copia)_1609192491082543108]' />
            </column>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Gender Mix Leadership (hoy)' datatype='real' default-format='p0.0%' name='[Gender Mix (hoy) (copia)_1460010746049773649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Hiring Hoy (copia)_1460010746046001226])/SUM([HC Hoy (copia)_1460010746050023507])' />
            </column>
            <column caption='Gender Mix Leadership (mes anterior)' datatype='real' default-format='p0.0%' name='[Gender Mix Leadership (hoy) (copia)_1609192491082543108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Hiring mes anterior (copia)_1460010746046525517])/SUM([Leadership (hoy) (copia)_1609192491082895365])' />
            </column>
            <column caption='Gender Mix Leadership (mes año anterior) ' datatype='real' default-format='p0.0%' name='[Gender Mix Leadership (mes anterior) (copia)_1609192491083292679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Hiring mes año anterior (copia)_1460010746046361676])/SUM([Leadership (mes anterior) (copia)_1609192491082981382])' />
            </column>
            <column caption='Gender Mix Leadership Target ' datatype='real' default-format='p0.0%' name='[Gender Mix Target (copia)_1633680818921648132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gender Mix (hoy) (copia)_1460010746049773649]-0.38' />
            </column>
            <column caption='Leadership (hoy)' datatype='integer' name='[HC Hoy (copia)_1460010746050023507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Calculation_1460010745856319490] &#13;&#10;THEN [leadership]&#13;&#10;END)' />
            </column>
            <column caption='Leader Mujeres Hoy' datatype='integer' name='[Hiring Hoy (copia)_1460010746046001226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Calculation_1460010745856319490]&#13;&#10;THEN [female_leadership]&#13;&#10;END)' />
            </column>
            <column caption='Leader Mujeres mes anterior' datatype='integer' name='[Hiring mes anterior (copia)_1460010746046525517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Latest month (copia)_1460010745866440709] &#13;&#10;THEN [female_leadership]&#13;&#10;END)' />
            </column>
            <column caption='Leader Mujeres mes año anterior' datatype='integer' name='[Hiring mes año anterior (copia)_1460010746046361676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745983529010] &#13;&#10;THEN [female_leadership]&#13;&#10;END)' />
