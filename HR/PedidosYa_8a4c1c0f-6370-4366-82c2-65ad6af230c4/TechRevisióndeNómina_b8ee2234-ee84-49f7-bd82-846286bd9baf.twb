    <worksheet name='Hiring Gráfico Género'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='11'><![CDATA[Gender Mix de contrataciones por <[Parameters].[Switch View III (copia)_830914175737618433]>]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='8'>(utilizar </run>
            <run bold='true' fontcolor='#ff0050' fontname='Tableau Book' fontsize='8'>Switch View IV  </run>
            <run bold='true' fontname='Tableau Book' fontsize='8'>para modificar vistas del gráfico)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
            <column alias='País' caption='Switch View IV' datatype='string' name='[Switch View III (copia)_830914175737618433]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country for Location&quot;'>
              <calculation class='tableau' formula='&quot;Country for Location&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
                <alias key='&quot;Gender&quot;' value='Género' />
                <alias key='&quot;Platform/Dmarts&quot;' value='Unidad de Negocio' />
                <alias key='&quot;Subdepartamento&quot;' value='Subdepartamento' />
                <alias key='&quot;Tribu/LOB&quot;' value='Tribu/LOB' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='Reporte (vista)' datatype='string' name='[Calculation_164944393251074048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Termination Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Elegir Vista V' datatype='string' name='[Calculation_830914175737724930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View III (copia)_830914175737618433]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]    &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [Country]&#13;&#10;    when &quot;Level&quot; then [levels]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;Tienda|Location&quot; then [office_location (pl_e_py_people_das)]&#13;&#10;    when &quot;Meses&quot; then [Calculation_164944393251074048]&#13;&#10;    WHEN &quot;C-Level&quot; then [c_level (il_cc_hierarchy_la)]&#13;&#10;     when &quot;Picker/Non Picker&quot; then [picker_non_picker]&#13;&#10;    when &quot;Termination Antiguedad&quot; then [Calculation_1653947027435212800]&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='Incompleto (WD)' />
              </aliases>
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='This month (vista)' datatype='datetime' name='[This month (copia)_164944393257082881]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])) }' />
