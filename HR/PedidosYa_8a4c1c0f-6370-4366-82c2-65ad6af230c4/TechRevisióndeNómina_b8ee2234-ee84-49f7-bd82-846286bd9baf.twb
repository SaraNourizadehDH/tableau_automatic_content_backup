              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
            <column alias='País' caption='Switch View IV' datatype='string' name='[Switch View III (copia)_830914175737618433]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country for Location&quot;'>
              <calculation class='tableau' formula='&quot;Country for Location&quot;' />
              <aliases>
