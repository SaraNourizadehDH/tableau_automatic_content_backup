      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
          </datasources>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='Actual Turnover (mujeres)' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual Turnover (copia)_1296192290218295299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[female]+[terminations (copia)_1296192290218786820]' />
            </column>
            <column caption='Actual Turnover (Hombres)' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual Turnover (mujeres) (copia)_1296192290221293577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[male]+[terminations (mujeres) (copia)_1296192290221080583]' />
            </column>
            <column caption='Hiring Mujeres' datatype='integer' default-format='N' name='[Calculation_1789899384671268865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gender]=&apos;Female&apos;&#13;&#10;then [hires]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='% Hiring Female' datatype='real' default-format='p0.00%' name='[Calculation_1789899384671440898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1789899384671268865])/SUM([hires])' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Meses del año' datatype='integer' name='[Calculation_528891529645621254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])' />
            </column>
            <column caption='Hc gral promedio final (mujeres)' datatype='real' name='[Hc gral promedio final (copia)_1296192290218196994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Actual Turnover (copia)_1296192290218295299])/[Calculation_528891529645621254]' />
            </column>
            <column caption='Hc gral promedio final (hombres)' datatype='real' name='[Hc gral promedio final (mujeres) (copia)_1296192290221625355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Actual Turnover (mujeres) (copia)_1296192290221293577])/[Calculation_528891529645621254]' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Turnover general Mujeres (voluntary)' datatype='real' default-format='p0.00%' name='[Turnover general (voluntary) (copia)_1296192290217558017]' role='measure' type='quantitative'>
