              <calculation class='tableau' formula='IF [department]=&apos;Sales&apos;&#13;&#10;then &apos;Sales&apos;&#13;&#10;ELSEIF [picker_non_picker]=&apos;Picker&apos;&#13;&#10;then &apos;Dmarts&apos;&#13;&#10;else &apos;Staff&apos;&#13;&#10;END' />
            </column>
            <column caption='Termination Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Termination Antiguedad Picker view' datatype='string' name='[Calculation_194499214383415296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 90 THEN &quot;Less than 3 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 90 AND [time_in_company_days] &lt; 180 THEN &quot;3 months to 6 month&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Agrupador Performance' datatype='string' name='[Calculation_250231256266432513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manager_rating_explained]=&apos;Development Needed&apos; or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Need Development Talent&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Core Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Good Performance&quot;' value='Mid' />
                <alias key='&quot;High Performance&quot;' value='High ' />
                <alias key='&quot;Low Performance&quot;' value='Low ' />
              </aliases>
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Elegir Vista I' datatype='string' name='[Calculation_782781913665142789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]   &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [country]&#13;&#10;    when &quot;Level&quot; then [levels]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Squads&quot; then [Squad]&#13;&#10;    when &quot;Dominio&quot; then [Domain]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Agrupador Performance&quot; then [Calculation_250231256266432513]&#13;&#10;    when &quot;Tienda|Location&quot; then [office_location (pl_e_py_people_das)]&#13;&#10;    when &quot;PCR&quot; then [Calculation_1276489074128953345]&#13;&#10;    WHEN &quot;C-Level&quot; then [c_level (il_cc_hierarchy_la)]&#13;&#10;    when &quot;Picker/Non Picker&quot; then [picker_non_picker]&#13;&#10;     when &quot;Termination Antiguedad&quot; then [Calculation_1653947027435212800]&#13;&#10;     when &quot;Termination Antiguedad Picker view&quot; then [Calculation_194499214383415296]&#13;&#10;when &apos;Entity&apos; then [Entity_Code]&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
