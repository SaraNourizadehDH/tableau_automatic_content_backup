      </column>
      <column caption='Union date Performance' datatype='string' name='[Calculation_1859705236081029120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if YEAR([report_date_month]) = YEAR([review_date]) and [manager_rating_explained] &lt;&gt; &quot;&quot; then &quot;ok&quot;&#13;&#10;ELSE &quot;no&quot;&#13;&#10;END' />
      </column>
      <column caption='Termination Antiguedad Picker view' datatype='string' name='[Calculation_194499214383415296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_in_company_days] &lt; 90 THEN &quot;Less than 3 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 90 AND [time_in_company_days] &lt; 180 THEN &quot;3 months to 6 month&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
      </column>
      <column caption='Agrupador Performance' datatype='string' name='[Calculation_250231256266432513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [manager_rating_explained]=&apos;Development Needed&apos; or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Need Development Talent&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Core Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
        <aliases>
          <alias key='&quot;Good Performance&quot;' value='Mid' />
          <alias key='&quot;High Performance&quot;' value='High ' />
          <alias key='&quot;Low Performance&quot;' value='Low ' />
        </aliases>
      </column>
      <column caption='% TO NH (involuntary)' datatype='real' name='[Calculation_279786127111561216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [time_in_company_days]&lt;=90 then [terminations_involuntary] end )/[Hc gral promedio final (copia)_1306043958019448837]' />
      </column>
      <column caption='Δ delta' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_292734017820430336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([actual_fte]))-SUM([Target])' />
      </column>
      <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
      </column>
      <column caption='Aging' datatype='integer' name='[Calculation_386465199542517760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TODAY()-[job_requisition_created_date]' />
      </column>
      <column caption='Terminations año anterior' datatype='integer' name='[Calculation_394064992613937153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;year&apos;, [report_effective_date]) = DATEADD(&apos;year&apos;, -1, [This month (copia)_1460010745871441928])&#13;&#10;THEN [terminations]&#13;&#10;END)' />
      </column>
      <column caption='Company_' datatype='string' name='[Calculation_415175643255148545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([company],&apos; &apos;,1)' />
      </column>
      <column caption='Agrupador Tabla HC Detail' datatype='string' name='[Calculation_415175643259981826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [Calculation_415175643255148545]&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
      </column>
      <column caption='Target NPS' datatype='real' name='[Calculation_415175643268071428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1651132214056869892]-78' />
      </column>
      <column caption='Meses del año' datatype='integer' name='[Calculation_528891529645621254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])' />
      </column>
      <column caption='Hc gral promedio final' datatype='real' name='[Calculation_528891529646510087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual (copia)_904660626792480768])/[Calculation_528891529645621254]' />
      </column>
      <column caption='Tipo de Salida' datatype='string' name='[Calculation_593912264812470275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_982910667737714688]=&apos;Activo&apos;&#13;&#10;THEN &apos;-&apos;&#13;&#10;ELSE [termination_category]&#13;&#10;END' />
      </column>
      <column caption='Fecha Parametro' datatype='date' name='[Calculation_593912264831766533]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([report_date_month])=2023 &#13;&#10;or YEAR([report_date_month])=2022&#13;&#10;or YEAR([report_date_month])=2021&#13;&#10;THEN [report_date_month]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Activos del Mes' datatype='integer' name='[Calculation_593912264842567690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([last_day_of_work])&gt;MONTH([report_effective_date])&#13;&#10;AND YEAR([last_day_of_work])&gt;YEAR([report_effective_date])&#13;&#10;then 0&#13;&#10;ELSEIF DAY([last_day_of_work])&lt;=DAY([report_effective_date])&#13;&#10;AND MONTH([last_day_of_work])=MONTH([report_effective_date])&#13;&#10;AND YEAR([last_day_of_work])=YEAR([report_effective_date])&#13;&#10;and not ISNULL(DATE([last_day_of_work]))&#13;&#10;then 1&#13;&#10;ELSE [actual]&#13;&#10;END' />
      </column>
      <column caption='Fecha de Egreso' datatype='string' name='[Calculation_593912264844754955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([last_day_of_work])&#13;&#10;THEN &apos;-&apos;&#13;&#10;ELSE STR(DATEPART(&apos;day&apos;,[last_day_of_work]))+&quot;/&quot;+ STR(DATEPART(&apos;month&apos;,[last_day_of_work]))+&quot;/&quot;+ STR(DATEPART(&apos;year&apos;,[last_day_of_work]))&#13;&#10;END' />
      </column>
      <column caption='Picker/Non Picker (by CeCo)' datatype='string' name='[Calculation_617556128157429760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sub_department]=&apos;Pickers&apos;&#13;&#10;then &apos;Picker&apos;&#13;&#10;ELSE &apos;Non Picker&apos;&#13;&#10;END' />
      </column>
      <column caption='Mujeres hoy' datatype='integer' name='[Calculation_754634453995364357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Calculation_1460010745856319490]&#13;&#10;THEN [female]&#13;&#10;END)' />
      </column>
      <column caption='Gender Mix (hoy)' datatype='real' default-format='p0.0%' name='[Calculation_754634453995634695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_754634453995364357])/SUM([Calculation_1460010745856528387])' />
      </column>
      <column caption='TTF' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_756041809281265665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[job_requisition_filled_date]-[job_requisition_created_date]' />
      </column>
      <column caption='TTH' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_756041809281736706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[offer_initiated_date]-[job_requisition_created_date]' />
      </column>
      <column caption='Elegir Vista I' datatype='string' name='[Calculation_782781913665142789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]   &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [country]&#13;&#10;    when &quot;Level&quot; then [levels]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Squads&quot; then [Squad]&#13;&#10;    when &quot;Dominio&quot; then [Domain]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Agrupador Performance&quot; then [Calculation_250231256266432513]&#13;&#10;    when &quot;Tienda|Location&quot; then [office_location (pl_e_py_people_das)]&#13;&#10;    when &quot;PCR&quot; then [Calculation_1276489074128953345]&#13;&#10;    WHEN &quot;C-Level&quot; then [c_level (il_cc_hierarchy_la)]&#13;&#10;    when &quot;Picker/Non Picker&quot; then [picker_non_picker]&#13;&#10;     when &quot;Termination Antiguedad&quot; then [Calculation_1653947027435212800]&#13;&#10;     when &quot;Termination Antiguedad Picker view&quot; then [Calculation_194499214383415296]&#13;&#10;when &apos;Entity&apos; then [Entity_Code]&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
        <aliases>
          <alias key='%null%' value='-' />
          <alias key='&quot;Other&quot;' value='No Rated ' />
        </aliases>
