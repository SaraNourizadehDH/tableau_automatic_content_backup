      <column caption='% Diferencia turnover YTD' datatype='real' default-format='p0.00%' name='[Calculation_1609192491105460236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Turnover (copia)_1460010745938645023]-[Calculation_1609192491103322123]' />
