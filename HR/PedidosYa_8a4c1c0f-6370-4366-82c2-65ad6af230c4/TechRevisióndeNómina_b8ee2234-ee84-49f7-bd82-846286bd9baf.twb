            <run bold='true' fontalignment='1' fontcolor='#000000'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Turnover (Año) (copia)_1460010745961025580:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000'>Æ </run>
            <run fontalignment='1' fontcolor='#606b76' fontsize='12'>YTD</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#661ec8' fontsize='8'><![CDATA[<[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:Postivo/Negativo to mes año anteior (copia)_1460010746004287551:nk]><[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[usr:% de Diferecia mes (Turnover) (copia)_1460010745992069175:qk]>]]></run>
            <run fontalignment='1' fontcolor='#661ec8' fontsize='8' italic='true'>(pp)</run>
