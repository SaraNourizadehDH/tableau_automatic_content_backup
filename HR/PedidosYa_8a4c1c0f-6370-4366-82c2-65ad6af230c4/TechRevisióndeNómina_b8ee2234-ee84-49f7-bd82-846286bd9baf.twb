            <column alias='Area de Lucanet' caption='Switch View I.' datatype='string' name='[Switch View. (copia)_322007426707689478]' param-domain-type='list' role='measure' type='nominal' value='&quot;Area&quot;'>
              <calculation class='tableau' formula='&quot;Area&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
                <alias key='&quot;Platform/Dmarts&quot;' value='Unidad de Negocio' />
              </aliases>
            </column>
