    <worksheet name='Turnover Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>Turnove</run>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='10'><![CDATA[r <[Parameters].[Parámetro 3 1]> ]]></run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>por </run>
            <run bold='true' fontcolor='#fa0050' fontname='Tableau Bold' fontsize='10'>Performance</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#898989' fontname='Tableau Medium' fontsize='8'>(Bajas performance / población por performance)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Voluntario' caption='Voluntaria | Involuntaria | General' datatype='string' name='[Parámetro 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Voluntaria&quot;'>
              <calculation class='tableau' formula='&quot;Voluntaria&quot;' />
              <aliases>
                <alias key='&quot;Involuntaria&quot;' value='Involuntario' />
                <alias key='&quot;Voluntaria&quot;' value='Voluntario' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='Actual Turnover' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual (copia)_904660626792480768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual]+[terminations]' />
            </column>
            <column caption='Turnover con vista' datatype='real' default-format='p0.0%' name='[Calculation_1329969287826866176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 3 1]=&apos;Voluntaria&apos;&#13;&#10;then [Turnover (voluntary) (copia)_528891529644888069]&#13;&#10;ELSEIF [Parameters].[Parámetro 3 1]=&apos;Involuntaria&apos;&#13;&#10;then [Turnover general (voluntary) (copia 2)_126945223557804032]&#13;&#10;ELSEIF [Parameters].[Parámetro 3 1]=&apos;General&apos;&#13;&#10;then [Turnover (copia)_528891529638322179]&#13;&#10;END' />
            </column>
            <column caption='Termination Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Union date Performance' datatype='string' name='[Calculation_1859705236081029120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([report_date_month]) = YEAR([review_date]) and [manager_rating_explained] &lt;&gt; &quot;&quot; then &quot;ok&quot;&#13;&#10;ELSE &quot;no&quot;&#13;&#10;END' />
            </column>
            <column caption='Agrupador Performance' datatype='string' name='[Calculation_250231256266432513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manager_rating_explained]=&apos;Development Needed&apos; or [manager_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;then &apos;Need Development Talent&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Performing&apos;&#13;&#10;then &apos;Core Performers&apos;&#13;&#10;ELSEIF [manager_rating_explained]=&apos;Exceeding&apos; or [manager_rating_explained]=&apos;Outstanding&apos;&#13;&#10;then &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Good Performance&quot;' value='Mid' />
                <alias key='&quot;High Performance&quot;' value='High ' />
                <alias key='&quot;Low Performance&quot;' value='Low ' />
              </aliases>
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Meses del año' datatype='integer' name='[Calculation_528891529645621254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])' />
            </column>
            <column caption='Hc gral promedio final' datatype='real' name='[Calculation_528891529646510087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Actual (copia)_904660626792480768])/[Calculation_528891529645621254]' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Turnover general' datatype='real' default-format='p0.0%' name='[Turnover (copia)_528891529638322179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations])/[Calculation_528891529646510087]' />
            </column>
            <column caption='Turnover general (voluntary)' datatype='real' default-format='p0.0%' name='[Turnover (voluntary) (copia)_528891529644888069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_voluntary])/[Calculation_528891529646510087]' />
            </column>
            <column caption='Turnover general (Involuntary)' datatype='real' default-format='p0.00%' name='[Turnover general (voluntary) (copia 2)_126945223557804032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_involuntary])/[Calculation_528891529646510087]' />
            </column>
