      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[This month (copia)_164944393257082881]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0q5x6lf0beybdy0zsuszq0tjlngs].[report_date_month]' caption='Fecha' datatype='date' default-format='*mmm-yy' name='[Parámetro 4]' param-domain-type='list' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='! HC promedio año anterior turnover' datatype='integer' name='[! HC promedio año anterior (copia)_904660626793644034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE  DATETRUNC(&apos;month&apos;,[last month (copia)_1460010745983529010]):SUM([! Hc año anterior (copia)_904660626793582593])}' />
            </column>
            <column aggregation='Sum' caption='! Hc año anterior turnover' datatype='integer' name='[! Hc año anterior (copia)_904660626793582593]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;year&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745871413255] AND DATETRUNC(&apos;month&apos;,[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])=[last month (copia)_1460010745871413255]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END)' />
            </column>
            <column caption='% Diferencia turnover voluntary YTD' datatype='real' default-format='p0.00%' name='[% Diferencia turnover YTD (copia)_1609192491111596050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Turnover (Año) (copia)_1460010745961025580] -[Turnover YTD año anterior (copia)_1609192491111370769]' />
            </column>
            <column caption='% de Diferecia anual (Turnover Voluntary)' datatype='real' default-format='p0.00%' name='[% de Diferecia anual (Turnover) (copia)_1460010745994367037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Turnover (Año) (copia)_1460010745961025580]-[Turnover (Año anterior) (copia)_1460010745993904188]' />
            </column>
            <column caption='% de Diferecia mes año (Turnover Voluntary) ' datatype='real' default-format='p0.00%' name='[% de Diferecia mes (Turnover) (copia)_1460010745992069175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Turnover (mes) (copia)_1460010745959505962]-[Turnover (mes año anterior) (copia)_1460010745992491064]' />
            </column>
            <column caption='Actual Turnover' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual (copia)_904660626792480768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual]+[terminations]' />
            </column>
            <column caption='HC año anterior' datatype='real' name='[Calculation_103019866456887297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;year&apos;, [report_effective_date]) = DATEADD(&apos;year&apos;, -1, [This month (copia)_1460010745871441928])&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END)/[Calculation_992480792746528768]' />
            </column>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Meses del año' datatype='integer' name='[Calculation_528891529645621254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])' />
            </column>
            <column caption='Hc gral promedio final' datatype='real' name='[Calculation_528891529646510087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Actual (copia)_904660626792480768])/[Calculation_528891529645621254]' />
            </column>
            <column caption='Meses este año' datatype='integer' name='[Calculation_908319751907045379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY())' />
            </column>
            <column caption='Meses año 2' datatype='integer' name='[Calculation_992480792746528768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(MONTH(MAX([Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])))' />
            </column>
            <column caption='HC promedio mensual turnover' datatype='integer' name='[Calculation_992480792774127620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;month&apos;,[report_effective_date])=[Calculation_1460010745856319490]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END)' />
            </column>
            <column caption='terminations voluntary año anterior' datatype='integer' name='[Calculation_992480792856834055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF DATETRUNC(&apos;year&apos;, [report_effective_date]) = DATEADD(&apos;year&apos;, -1, [This month (copia)_1460010745871441928])&#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
            </column>
            <column caption='HC este año turnover' datatype='integer' name='[HC este año (copia)_904660626794287109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;year&apos;,[report_effective_date])=[This month (copia)_1460010745871441928]&#13;&#10;THEN [Actual (copia)_904660626792480768]&#13;&#10;END' />
            </column>
            <column caption='HC promedio anual (año anterior) turnover' datatype='real' name='[HC promedio anual (año anterior) (copia)_904660626795294727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;year&apos;,[last month (copia)_1460010745871413255]):SUM([! Hc año anterior (copia)_904660626793582593])}/12' />
            </column>
            <column caption='HC promedio anual turnover' datatype='real' name='[HC promedio anual (copia)_904660626794172419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([HC este año (copia)_904660626794287109])/[Calculation_908319751907045379]' />
            </column>
            <column caption='Positivo/Negativo to v año anterior' datatype='string' name='[Postivo/Negativo to año anterior (copia)_1460010746004013118]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% Diferencia turnover YTD (copia)_1609192491111596050]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='Positivo/Negativo to v mes año anteior' datatype='string' name='[Postivo/Negativo to mes año anteior (copia)_1460010746004287551]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% de Diferecia mes (Turnover) (copia)_1460010745992069175]&lt;0&#13;&#10;then &apos;▼&apos;&#13;&#10;else &apos;▲&apos;&#13;&#10;end' />
            </column>
            <column caption='month wh' datatype='datetime' datatype-customized='true' name='[Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Termination Voluntary año anterior' datatype='integer' name='[Termination año anterior (copia)_1460010745992691769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;year&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745871413255] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
            </column>
            <column caption='Termination Voluntary mes año anterior' datatype='integer' name='[Termination mes año anterior (copia)_1460010745993429051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [last month (copia)_1460010745983529010] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
            </column>
            <column caption='Terminations Voluntary (Año)' datatype='integer' default-format='N' name='[Terminations (Año) (copia)_1460010745961189421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;year&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [This month (copia)_1460010745871441928] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
            </column>
            <column caption='Terminations Voluntary (Hoy)' datatype='integer' name='[Terminations (Hoy) (copia)_1460010745959673899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Calculation_1460010745856319490] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
            </column>
            <column caption='This Year' datatype='datetime' name='[This month (copia)_1460010745871441928]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;year&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='This month (vista)' datatype='datetime' name='[This month (copia)_164944393257082881]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209])) }' />
            </column>
            <column caption='Turnover Voluntary (Año anterior)' datatype='real' default-format='p0.00%' name='[Turnover (Año anterior) (copia)_1460010745993904188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Termination año anterior (copia)_1460010745992691769])/SUM([HC promedio anual (año anterior) (copia)_904660626795294727])' />
            </column>
            <column caption='Turnover Voluntary (Año)' datatype='real' default-format='p0.00%' name='[Turnover (Año) (copia)_1460010745961025580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Terminations (Año) (copia)_1460010745961189421])/[HC promedio anual (copia)_904660626794172419]' />
            </column>
            <column caption='Turnover Voluntary (mes año anterior)' datatype='real' default-format='p0.00%' name='[Turnover (mes año anterior) (copia)_1460010745992491064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Termination mes año anterior (copia)_1460010745993429051])/SUM([! HC promedio año anterior (copia)_904660626793644034])' />
            </column>
