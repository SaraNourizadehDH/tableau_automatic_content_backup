      <column caption='ftes' datatype='real' datatype-customized='true' name='[Calculation_1496602451268501511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_982910667737714688] = &apos;Activo&apos; then [fte] END)' />
      </column>
      <column caption='Quarter' datatype='boolean' name='[Calculation_1572319274683138048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;quarter&apos;,1,DATETRUNC(&apos;quarter&apos;,[report_effective_date]))) = [report_effective_date]' />
      </column>
      <column caption='Openings Totals' datatype='integer' name='[Calculation_1572319274725355521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([job_openings_total])' />
      </column>
      <column caption='Dif' datatype='integer' default-format='N' name='[Calculation_1585830038200221698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1789899384671268865]-[terminations (voluntary) (copia)_1585830038200008705]' />
      </column>
      <column caption='Turnover YTD año anterior' datatype='real' default-format='p0.00%' name='[Calculation_1609192491103322123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_394064992613937153]/[Calculation_103019866456887297]' />
