      </column>
      <column caption='% Participación' datatype='real' default-format='p0%' name='[Calculation_1566126826118832130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_634444612598018075] / TOTAL([Calculation_634444612598018075]),2)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtro' datatype='string' name='[Calculation_1586111512373981184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([review_date])+[review_template_type]' />
      </column>
      <column caption='Periodo' datatype='string' name='[Calculation_1586111512375078914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_status]=&apos;In Progress&apos;&#13;&#10;and DATEPART(&apos;month&apos;,[review_date])=1&#13;&#10;and [review_template_type]=&apos;Full Cycle&apos;&#13;&#10;then &apos;H2&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Año performance (copia)_1520809314561208327]) &lt; 3&#13;&#10;THEN &apos;H1&apos;&#13;&#10;ELSE &apos;H2&apos;&#13;&#10;END +&apos; &apos;+ STR([Calculation_1491817391270969346])' />
      </column>
      <column aggregation='Min' caption='última nota' datatype='datetime' name='[Calculation_1600748212588642312]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED  [review_template_type] : MAX(DATETRUNC(&apos;month&apos;,[review_date]))}' />
      </column>
      <column caption='Agrupador self performance' datatype='string' name='[Calculation_1637058496526131201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [employee_self_rating_explained]=&apos;Development Needed&apos; &#13;&#10;or [employee_self_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;or [employee_self_rating_explained]= &apos;Off Track&apos;&#13;&#10;THEN &apos;Low Performers&apos;&#13;&#10;ELSEIF [employee_self_rating_explained]=&apos;Performing&apos;&#13;&#10;or [employee_self_rating_explained]=&apos;On Track&apos; &#13;&#10;THEN &apos;Solid Performers&apos;&#13;&#10;ELSEIF  [employee_self_rating_explained]=&apos;Exceeding&apos;&#13;&#10;or [employee_self_rating_explained]= &apos;Outstanding&apos;&#13;&#10;THEN &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;END' />
      </column>
      <column caption='Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
      </column>
      <column caption='Elegibles' datatype='string' name='[Calculation_1699827419180544001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([Año performance (copia)_1520809314561208327])&gt;DATE([first_day_of_work])&#13;&#10;then [employee_id]&#13;&#10;END' />
      </column>
      <column caption='Filtro level' datatype='string' name='[Calculation_1792432704296988672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level]IN (&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;)    &#13;&#10;THEN [full_name]&#13;&#10;ELSE [management_level]&#13;&#10;END' />
      </column>
      <column caption='Vista comparativa' datatype='string' name='[Calculation_1847320326690406401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;mismo ciclo periodo anterior&apos;THEN[versus periodo anterior (copia)_1847320326687813632]&#13;&#10;ELSE [versus periodo anterior (copia)_1827054125697548289]&#13;&#10;END' />
      </column>
      <column caption='Last Lows' datatype='integer' name='[Calculation_1875467796504670209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [previous_rating]=&apos;Low Performers&apos;&#13;&#10;then 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Non Low' datatype='integer' name='[Calculation_1875467796505178116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [previous_rating]=&apos;Low Performers&apos;&#13;&#10;and [performance_category]=&apos;Solid Performers&apos;&#13;&#10;then 1 &#13;&#10;ELSEIF [previous_rating]=&apos;Low Performers&apos;&#13;&#10;AND [performance_category]=&apos;High Performers&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='% Poor Performance Correction Rate' datatype='real' default-format='p0.0%' name='[Calculation_1875467796505624581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1875467796505178116])/SUM([Calculation_1875467796504670209])' />
      </column>
      <column caption='Nota Anual' datatype='string' name='[Calculation_2316539097941770241]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [review_template_type]=&apos;Full Cycle&apos;&#13;&#10;and YEAR([review_date])=YEAR(DATEADD(&apos;year&apos;,-1,[review_date]))&#13;&#10;then [manager_rating_explained]&#13;&#10;END' />
      </column>
      <column caption='Control de bajas' datatype='integer' name='[Calculation_339177377152106496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [manager_rating_explained]in (&apos;&apos;,NULL)&#13;&#10;and [is_terminated]=1&#13;&#10;and [bp_status]=&apos;In Progress&apos;&#13;&#10;then 0&#13;&#10;else 1&#13;&#10;END' />
      </column>
      <column caption='Categoría' datatype='string' name='[Calculation_339177377160757249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [department]=&apos;People&apos;&#13;&#10;then &apos;Confidencial&apos;&#13;&#10;else &apos;No confidencial&apos;&#13;&#10;END' />
      </column>
      <column caption='Promotion Request' datatype='string' name='[Calculation_385339249587949568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1004302765792182272]=0&#13;&#10;THEN &apos;No&apos;&#13;&#10;else &apos;Si&apos;&#13;&#10;END' />
      </column>
      <column caption='Test' datatype='integer' name='[Calculation_630222529702989825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [review_date] = {FIXED [employee_id],[review_template_type]: MAX([review_date])} &#13;&#10;THEN [terminations_v2] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Latam North | South' datatype='string' name='[Calculation_634444612472221696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] IN(&apos;Costa Rica&apos;,&apos;Ecuador&apos;,&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;,&apos;Panamá&apos;,&apos;República Dominicana&apos;,&apos;Venezuela&apos;)&#13;&#10;THEN &apos;Latam North&apos;&#13;&#10;ELSE &apos;Latam South&apos;&#13;&#10;END' />
      </column>
      <column caption='View' datatype='string' name='[Calculation_634444612536225798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Evaluación de Performance&apos; THEN [manager_rating_explained]&#13;&#10;WHEN &apos;Agrupador de Evaluación Perfomance&apos; THEN [performance_category]&#13;&#10;WHEN &apos;Agrupador de Autoevaluación&apos; THEN [Calculation_1637058496526131201]&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value='No Rated ' />
          <alias key='&quot;Development Needed&quot;' value='Logra parcialmente las expectativas' />
          <alias key='&quot;Exceeding&quot;' value='Supera las expectativas' />
          <alias key='&quot;Off Track&quot;' value='Necesita ajustar su performance' />
          <alias key='&quot;On Track&quot;' value='Performance en camino a lo esperado' />
          <alias key='&quot;Outstanding&quot;' value='Supera ampliamente las expectativas' />
          <alias key='&quot;Performing&quot;' value='Logra las expectativas' />
          <alias key='&quot;Unsatisfactory&quot;' value='No logra las expectativas' />
        </aliases>
      </column>
      <column caption='Participantes' datatype='integer' default-format='N' name='[Calculation_634444612598018075]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='COUNTD([employee_id])' />
      </column>
      <column caption='Autoevaluación pendiente' datatype='integer' name='[Calculation_689895184874196992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_634444612598018075]-COUNTD([Calculation_1520809314552946688])' />
      </column>
