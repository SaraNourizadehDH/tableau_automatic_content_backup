      <column datatype='date' datatype-customized='true' name='[LDW]' role='dimension' type='ordinal' />
      <column caption='Solid que eran Low' datatype='integer' name='[Low que eran High (copia)_1507298528068702210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Solid o High que eran Low (copia)_1507298528070791171]=&apos;Previous Low Peformer&apos;&#13;&#10;AND [performance_category]=&apos;Solid Performers&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[NPS]' role='measure' type='quantitative' />
      <column caption='Participantes II' datatype='string' name='[Participantes (copia)_1520809314557218821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date_month]=[Año performance (copia)_1520809314561208327]&#13;&#10;AND [picker_non_picker]=&apos;Non Picker&apos;&#13;&#10;AND not CONTAINS([business_title],&apos;Picker&apos;)&#13;&#10;AND  [actual]=1&#13;&#10;then [employee_id]&#13;&#10;else NULL&#13;&#10;END' />
      </column>
      <column caption='País  II' datatype='string' name='[País  (copia)_1385138393380392960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [country]&#13;&#10;ELSEIF [scope]&lt;&gt;&apos;Local&apos;&#13;&#10;then [department]&#13;&#10;ELSE &apos;Otro&apos;&#13;&#10;END' />
      </column>
      <column caption='Periodo (copia)' datatype='string' name='[Periodo (copia)_15199690851606528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_status]=&apos;In Progress&apos;&#13;&#10;and DATEPART(&apos;month&apos;,[review_date])=1&#13;&#10;and [review_template_type]=&apos;Full Cycle&apos;&#13;&#10;then &apos;H2&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Año performance (copia)_1520809314561208327]) &lt; 3&#13;&#10;THEN &apos;H1&apos;&#13;&#10;ELSE &apos;H2&apos;&#13;&#10;END +&apos; &apos;+ STR([Calculation_1491817391270969346])' />
      </column>
      <column caption='Periodo1' datatype='string' name='[Periodo]' role='dimension' type='nominal' />
      <column caption='Previous High Peformer' datatype='string' name='[Previous Low Peformer (copia)_1507298528133345292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_rating]=&apos;High Performers&apos;&#13;&#10;then &apos;Previous High Peformer&apos;&#13;&#10;else null&#13;&#10;END' />
      </column>
      <column caption='Previous Solid Peformer' datatype='string' name='[Previous Low Peformer (copia)_1507298528133484557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_rating]=&apos;Solid Performers&apos;&#13;&#10;then &apos;Previous Solid Peformer&apos;&#13;&#10;else null&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Score]' role='measure' type='quantitative' />
      <column caption='Previous Low Peformer' datatype='string' name='[Solid o High que eran Low (copia)_1507298528070791171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_rating]=&apos;Low Performers&apos;&#13;&#10;then &apos;Previous Low Peformer&apos;&#13;&#10;else null&#13;&#10;END' />
      </column>
      <column caption='Solid &amp; High Performers' datatype='string' name='[Solid o High que eran Low (copia)_1507298528071147525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [performance_category]=&apos;High Performers&apos; &#13;&#10;or [performance_category]=&apos;Solid Performers&apos;&#13;&#10;then &apos;Solid &amp; High&apos;&#13;&#10;else NULL&#13;&#10;END' />
      </column>
      <column caption='High que eran Low' datatype='integer' name='[Solid o High que eran Low (copia)_1547267975388426241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [versus periodo anterior (copia)_1827054125697548289]=&apos;ex Low&apos;&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Sub Department (copia)' datatype='string' name='[Sub Department (copia)_1520809314592157704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_department]' />
      </column>
      <column caption='Performance  ' datatype='string' name='[View (copia)_2316539097966178308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Switch View (copia)_2316539097965916163]&#13;&#10;WHEN &apos;Evaluación de Performance&apos; THEN [manager_rating_explained]&#13;&#10;WHEN &apos;Agrupador de Evaluación Perfomance&apos; THEN [performance_category]&#13;&#10;END' />
