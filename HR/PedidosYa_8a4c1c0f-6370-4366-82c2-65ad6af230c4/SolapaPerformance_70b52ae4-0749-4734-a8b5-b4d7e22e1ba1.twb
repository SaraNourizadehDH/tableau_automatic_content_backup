          <relation connection='athena.1l1hw4f190u3uv1e9il9n1t1o6im' name='consulta_sql_perso1' type='text'>select&#13;
m.*,&#13;
i.work_email as mail_manager_04,&#13;
ii.work_email as mail_manager_05,&#13;
iii.work_email as mail_manager_06,&#13;
iiii.work_email as mail_manager_07,&#13;
cc.department,&#13;
cc.sub_department,&#13;
cc.&quot;scope&quot;,&#13;
cc.country&#13;
from &#13;
people_ops_proposed.il_manager m&#13;
&#13;
left join people_ops_proposed.il_worker_org i on &#13;
m.manager_id_04 = i.employee_id &#13;
left join people_ops_proposed.il_worker_org ii on &#13;
m.manager_id_05 = ii.employee_id&#13;
left join people_ops_proposed.il_worker_org iii on &#13;
m.manager_id_06 = iii.employee_id&#13;
left join people_ops_proposed.il_worker_org iiii on &#13;
m.manager_id_07 = iiii.employee_id &#13;
left join people_ops_proposed.il_cc_hierarchy_latam cc on &#13;
m.cost_center_id  = cc.cost_center_id</relation>
