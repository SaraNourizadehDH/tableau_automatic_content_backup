              <calculation class='tableau' formula='IF [performance_category]=[previous_rating]&#13;&#10;then &apos;Sostenido&apos;&#13;&#10;ELSEif [performance_category]=&apos;Low Performers&apos; &#13;&#10;AND [previous_rating]=&apos;Solid Performers&apos;&#13;&#10;then &apos;ex Solid&apos;&#13;&#10;ELSEif [performance_category]=&apos;Low Performers&apos; &#13;&#10;AND [previous_rating]=&apos;High Performers&apos;&#13;&#10;then &apos;ex High&apos;&#13;&#10;ELSEif [performance_category]=&apos;Solid Performers&apos; &#13;&#10;AND [previous_rating]=&apos;Low Performers&apos;&#13;&#10;then &apos;Mejoró&apos;&#13;&#10;ELSEif [performance_category]=&apos;Solid Performers&apos; &#13;&#10;AND [previous_rating]=&apos;High Performers&apos;&#13;&#10;then &apos;ex High&apos;&#13;&#10;ELSEif [performance_category]=&apos;High Performers&apos; &#13;&#10;AND [previous_rating]=&apos;Low Performers&apos;&#13;&#10;then &apos;ex Low&apos;&#13;&#10;ELSEif [performance_category]=&apos;High Performers&apos; &#13;&#10;AND [previous_rating]=&apos;Solid Performers&apos;&#13;&#10;then &apos;Mejoró&apos;&#13;&#10;ELSE &apos;Sin evaluación anterior&apos;&#13;&#10;END' />
