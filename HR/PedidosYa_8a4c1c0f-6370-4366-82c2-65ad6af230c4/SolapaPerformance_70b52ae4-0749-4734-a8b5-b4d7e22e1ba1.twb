          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='excel-direct.0qrprvj0oejuab1er4m1o05nxirr' name='Peakon 2024 (tableau)' table='[&apos;Peakon 2024 (tableau)$&apos;]' type='table'>
          <columns gridOrigin='A1:F11077:no:A1:F11077:0' header='yes' outcome='6'>
            <column datatype='string' name='Periodo' ordinal='0' />
            <column datatype='string' name='Empleado - Nombre' ordinal='1' />
            <column datatype='string' name='Empleado - Correo electrónico' ordinal='2' />
            <column datatype='string' name='Driver' ordinal='3' />
            <column datatype='integer' name='NPS' ordinal='4' />
            <column datatype='integer' name='Score' ordinal='5' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='athena.1l1hw4f190u3uv1e9il9n1t1o6im' name='consulta_sql_perso' type='text'>
            <columns>
              <column datatype='date' date-parse-format='yyyy-MM-dd' name='last_day_of_work' />
              <column datatype='date' date-parse-format='yyyy-MM-dd' name='LDW' />
            </columns>
WITH tpd AS (&#13;
    SELECT DISTINCT&#13;
        pd.*,&#13;
        p.employee_self_rating,&#13;
        p.employee_self_rating_explained,&#13;
        p.manager_rating,&#13;
        p.manager_rating_explained,&#13;
        p.review_date,&#13;
        p.is_latest_review,&#13;
        p.is_previous_review,&#13;
        p.to_be_promoted,&#13;
        p.is_promoted_before,&#13;
        p.bp_status,&#13;
        p.current_step,&#13;
        p.bp_completion_date,&#13;
        wo.is_terminated as terminations_v2,&#13;
        wo.last_day_of_work as LDW,&#13;
        t.termination_category as cat_term,&#13;
        rt.review_template_type,&#13;
        CASE&#13;
            WHEN p.manager_rating_explained IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;, &apos;Off Track&apos;) THEN &apos;Low Performers&apos;&#13;
            WHEN p.manager_rating_explained IN (&apos;Performing&apos;,&apos;On Track&apos;) THEN &apos;Solid Performers&apos;&#13;
            WHEN p.manager_rating_explained IN (&apos;Exceeding&apos;, &apos;Outstanding&apos;) THEN &apos;High Performers&apos;&#13;
            ELSE &apos;Not rated&apos;&#13;
        END AS performance_category,&#13;
        row_number() OVER (PARTITION BY p.employee_id ORDER BY (p.review_date ) ) AS sort&#13;
    FROM&#13;
        people_ops_proposed.il_performance p&#13;
        LEFT JOIN people_ops_proposed.il_performance_review_template rt ON p.review_template_id = rt.review_template_id&#13;
&#13;
        LEFT JOIN (&#13;
            SELECT &#13;
                employee_id,&#13;
                MAX(report_date_month) AS max_report_date_month&#13;
            FROM people_ops_proposed.pl_e_py_people_dashboard&#13;
            GROUP BY employee_id&#13;
        ) pd_max ON p.employee_id = pd_max.employee_id&#13;
&#13;
        LEFT JOIN people_ops_proposed.pl_e_py_people_dashboard pd &#13;
            ON p.employee_id = pd.employee_id &#13;
            AND (&#13;
                p.review_date = pd.report_date_month&#13;
                OR (cast(p.review_date  as date)&gt;&gt; CURRENT_DATE AND pd.report_date_month = pd_max.max_report_date_month)&#13;
            )&#13;
        LEFT JOIN people_ops_proposed.il_worker_org  wo ON p.employee_id = wo.employee_id &#13;
        LEFT JOIN people_ops_proposed.il_termination t ON t.employee_id = wo.employee_id and wo.last_day_of_work=t.last_day_of_work AND t.status = &apos;Successfully Completed&apos;&#13;
),&#13;
scope_pp AS (&#13;
    SELECT &#13;
    tpd.*,&#13;
    CASE&#13;
		WHEN tpd.country = &apos;República Dominicana&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech= &apos;Non Tech&apos;&#13;
		or (tpd.employee_id = &apos;2020-07-0326&apos; OR tpd.employee_id = &apos;2020-03-0281&apos;) THEN &apos;Dominicana BU&apos;&#13;
		WHEN tpd.country = &apos;Bolivia&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Bolivia BU&apos;&#13;
		WHEN tpd.country = &apos;Chile&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Chile BU&apos;&#13;
		WHEN tpd.country = &apos;Costa Rica&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Costa Rica BU&apos;&#13;
		WHEN tpd.country = &apos;Ecuador&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Ecuador BU&apos;&#13;
		WHEN tpd.country = &apos;El Salvador&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;El Salvador BU&apos;&#13;
		WHEN tpd.country = &apos;Guatemala&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Guatemala BU&apos;&#13;
		WHEN tpd.country = &apos;Honduras&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Honduras BU&apos;&#13;
		WHEN tpd.country = &apos;Nicaragua&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Nicaragua BU&apos;&#13;
		WHEN tpd.country = &apos;Panamá&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Panamá BU&apos;&#13;
		WHEN tpd.country = &apos;Paraguay&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Paraguay BU&apos;&#13;
		WHEN tpd.country = &apos;Perú&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Perú BU&apos;&#13;
		WHEN tpd.country = &apos;Uruguay&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Uruguay BU&apos;&#13;
		WHEN tpd.country = &apos;Venezuela&apos; AND tpd.scope = &apos;Local&apos; AND tpd.tech_non_tech = &apos;Non Tech&apos; THEN &apos;Venezuela BU&apos;&#13;
		WHEN tpd.country = &apos;Argentina&apos; AND tpd.scope = &apos;Local&apos;&#13;
		AND tpd.cost_center_id NOT IN (&apos;6001D09951&apos;, &apos;6001203321&apos;, &apos;6006209951&apos;,&apos;6001209951&apos;)&#13;
		AND tpd.department IN (&apos;Quick Commerce&apos;, &apos;Logistics and Operations&apos;, &apos;Finance&apos;)&#13;
		or  tpd.cost_center_id = &apos;6001218411&apos; THEN &apos;Argentina BU Support&apos;&#13;
		WHEN tpd.country = &apos;Argentina&apos; AND tpd.scope = &apos;Local&apos;&#13;
                AND (tpd.department IN (&apos;Quick Commerce&apos;,&apos;Sales&apos;,&apos;Contact Operations&apos;,&apos;People&apos;,&apos;Marketing&apos;)&#13;
                OR tpd.cost_center_id IN (&apos;6001203321&apos;)) THEN &apos;Argentina BU Operations I&apos;&#13;
		WHEN tpd.country = &apos;Argentina&apos; AND tpd.scope = &apos;Local&apos; AND tpd.department IN (&apos;PedidosYa Market&apos;)&#13;
		AND tpd.sub_department NOT IN (&apos;Pickers&apos;, &apos;Shift Supervisors &amp; Store Managers&apos;,&apos;Operations&apos;) THEN &apos;Argentina BU Operations III&apos;&#13;
		WHEN tpd.country = &apos;Argentina&apos; AND tpd.scope = &apos;Local&apos;&#13;
		AND tpd.sub_department IN (&apos;Pickers&apos;, &apos;Shift Supervisors &amp; Store Managers&apos;,&apos;Operations&apos;) THEN &apos;Argentina Tiendas&apos;&#13;
		WHEN tpd.scope IN (&apos;Regional&apos;, &apos;SSC&apos;)&#13;
		AND tpd.department IN (&apos;Quick Commerce&apos;, &apos;PedidosYa Market&apos;, &apos;Contact Center&apos;,&apos;Contact Operations&apos;, &apos;Logistics and Operations&apos;, &apos;Customer Operations Strategy&apos;, &apos;Sales&apos;, &apos;Business Management&apos;)&#13;
		AND tpd.employee_id NOT IN (&apos;2020-07-0326&apos;, &apos;2023-04-0324&apos;, &apos;2020-03-028&apos;) OR tpd.department = &apos;Supply Chain&apos; THEN &apos;Dmarts Regional Staff&apos;&#13;
		WHEN tpd.scope IN (&apos;Regional&apos;, &apos;SSC&apos;) AND tpd.department IN (&apos;Finance&apos;, &apos;Fintech&apos;, &apos;People&apos;) or tpd.cost_center_id = &apos;6001209951&apos; THEN &apos;Regional Fintech-People&apos;&#13;
		WHEN tpd.scope IN (&apos;Regional&apos;, &apos;SSC&apos;) AND tpd.department = &apos;Marketing&apos; THEN &apos;Regional Mkt&apos;&#13;
		WHEN tpd.tech_non_tech = &apos;Tech&apos; THEN &apos;Tech&apos;&#13;
		ELSE &apos;Sin Nadie&apos;&#13;
            end as scope_people_partners&#13;
            from tpd),&#13;
previous_review AS (&#13;
    SELECT &#13;
        employee_id,&#13;
        sort + 1 AS sort,&#13;
        performance_category AS previous_rating,&#13;
        manager_rating_explained as previous_manager_rating&#13;
        &#13;
    FROM tpd&#13;
),&#13;
previous_review_II  AS (&#13;
    SELECT &#13;
        employee_id,&#13;
        sort + 2 AS sort,&#13;
        performance_category AS previous_rating_Full,&#13;
        manager_rating_explained as previus_manager_rating_II&#13;
    FROM tpd&#13;
),&#13;
previous_review_III  AS (&#13;
    SELECT &#13;
        employee_id,&#13;
        sort + 3 AS sort,&#13;
        performance_category AS previous_rating_III,&#13;
        manager_rating_explained as previus_manager_rating_III&#13;
    FROM tpd&#13;
)&#13;
SELECT DISTINCT spp.*, &#13;
pr.previous_rating,&#13;
pr.previous_manager_rating,&#13;
prii.previous_rating_Full,&#13;
prii.previus_manager_rating_II,&#13;
priii.previous_rating_III,&#13;
priii.previus_manager_rating_III&#13;
FROM scope_pp spp&#13;
LEFT JOIN previous_review pr ON spp.employee_id = pr.employee_id AND spp.sort = pr.sort&#13;
LEFT JOIN previous_review_II prii ON spp.employee_id = prii.employee_id AND spp.sort = prii.sort&#13;
LEFT JOIN previous_review_III priii ON spp.employee_id = priii.employee_id AND spp.sort = priii.sort          </relation>
