            <column caption='versus mismo ciclo periodo anterior' datatype='string' name='[versus periodo anterior (copia)_1847320326687813632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [performance_category]=[previous_rating_Full]&#13;&#10;then &apos;Sostenido&apos;&#13;&#10;ELSEif [performance_category]=&apos;Low Performers&apos; &#13;&#10;AND [previous_rating_Full]=&apos;Solid Performers&apos;&#13;&#10;then &apos;ex Solid&apos;&#13;&#10;ELSEif [performance_category]=&apos;Low Performers&apos; &#13;&#10;AND [previous_rating_Full]=&apos;High Performers&apos;&#13;&#10;then &apos;ex High&apos;&#13;&#10;ELSEif [performance_category]=&apos;Solid Performers&apos; &#13;&#10;AND [previous_rating_Full]=&apos;Low Performers&apos;&#13;&#10;then &apos;Mejoró&apos;&#13;&#10;ELSEif [performance_category]=&apos;Solid Performers&apos; &#13;&#10;AND [previous_rating]=&apos;High Performers&apos;&#13;&#10;then &apos;ex High&apos;&#13;&#10;ELSEif [performance_category]=&apos;High Performers&apos; &#13;&#10;AND [previous_rating_Full]=&apos;Low Performers&apos;&#13;&#10;then &apos;ex Low&apos;&#13;&#10;ELSEif [performance_category]=&apos;High Performers&apos; &#13;&#10;AND [previous_rating_Full]=&apos;Solid Performers&apos;&#13;&#10;then &apos;Mejoró&apos;&#13;&#10;ELSE &apos;Sin evaluación anterior&apos;&#13;&#10;END' />
            </column>
