        <calculation class='tableau' formula='IF [Calculation_1409063756480307207]&lt;=-0.7&#13;&#10;then &apos;rojo&apos;&#13;&#10;ELSEIF [Calculation_1409063756480307207]&gt;=1&#13;&#10;then &apos;rojo&apos;&#13;&#10;ELSE &apos;amarillo&apos;&#13;&#10;END' />
