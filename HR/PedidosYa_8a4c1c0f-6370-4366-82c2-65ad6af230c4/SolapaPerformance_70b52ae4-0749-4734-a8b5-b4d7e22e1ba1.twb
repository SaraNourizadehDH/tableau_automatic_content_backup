          <calculation class='tableau' formula='if [terminations_v2]=1&#13;&#10;then &apos;No&apos;&#13;&#10;ELSEIF [Calculation_1586111512375078914]=&apos;H1 2024&apos; AND [employee_id] IN (&apos;2021-05-0657&apos;,&apos;2022-01-1274&apos;,&apos;2019-12-2783&apos;,&apos;2022-03-0518&apos;,&#13;&#10;&apos;2019-12-2944&apos;,&apos;2021-07-0387&apos;,&apos;2020-01-0087&apos;,&apos;2023-02-0400&apos;,&apos;2023-03-0063&apos;,&apos;2020-09-0304&apos;,&apos;2022-03-0056&apos;,&apos;2023-04-0130&apos;,&#13;&#10;&apos;2023-04-0354&apos;,&apos;2023-03-0237&apos;,&apos;2023-01-0535&apos;,&apos;2020-03-0275&apos;,&apos;2021-08-0861&apos;,&apos;2023-04-0175&apos;,&apos;2020-11-2485&apos;,&apos;2023-06-0116&apos;)&#13;&#10;THEN &apos;Licencias no aplica&apos;&#13;&#10;else &apos;Sí&apos;&#13;&#10;END' />
