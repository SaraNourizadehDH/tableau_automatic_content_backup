            <column caption='% Solid eran Need development ' datatype='real' default-format='p0.0%' name='[% Need development que eran High (copia)_1507298528072134663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Low que eran High (copia)_1507298528068702210])/([Calculation_634444612598018075])' />
