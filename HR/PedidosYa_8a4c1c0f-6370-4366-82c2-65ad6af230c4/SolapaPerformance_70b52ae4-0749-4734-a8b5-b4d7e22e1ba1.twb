apos;Nicaragua BU&apos;,&apos;Panamá BU&apos;,&apos;Venezuela BU&apos;,&apos;Uruguay BU&apos;,&#13;&#10;&apos;Dmarts Regional Staff&apos;,&apos;Bolivia BU&apos;,&apos;Chile BU&apos;,&apos;Perú BU&apos;,&apos;Paraguay BU&apos;,&apos;Argentina Tiendas&apos;,&apos;El Salvador BU&apos;)&#13;&#10;AND ISUSERNAME(&apos;victor.abalos@pedidosya.com&apos;)&#13;&#10;THEN 1&#13;&#10;ELSEIF [scope_people_partners]IN (&apos;Argentina BU Operations I&apos;,&apos;Argentina BU Operations II&apos;,&apos;Argentina BU Operations III&apos;,&#13;&#10;&apos;Argentina BU Support&apos;,&apos;Argentina Tiendas&apos;)&#13;&#10;AND ISUSERNAME(&apos;maria.raris@pedidosya.com&apos;)&#13;&#10;THEN 1&#13;&#10;ELSEIF [department] in (&apos;People&apos;, &apos;Finance&apos;,&apos;Marketing&apos;,&apos;Product&apos;,&apos;Tech&apos;)&#13;&#10;AND ISUSERNAME(&apos;mariano.pavia@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [department]&lt;&gt;&apos;People&apos;&#13;&#10;AND ISUSERNAME(&apos;marianela.laccone@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF USERNAME()=(&apos;sebastian.zelis@pedidosya.com&apos;) &#13;&#10;or USERNAME()=(&apos;alejandra.kabakian@pedidosya.com&apos;)&#13;&#10;or USERNAME()=(&apos;daniela.alonso@pedidosya.com&apos;)&#13;&#10;or USERNAME()=(&apos;ines.bullo@pedidosya.com&apos;)&#13;&#10;or ISMEMBEROF(&apos;PedidosYa - Talent Development&apos;)&#13;&#10;then 1 &#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Año' datatype='integer' name='[Calculation_1491817391270969346]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([review_date])=1&#13;&#10;THEN YEAR([review_date])-1&#13;&#10;ELSE YEAR([review_date])&#13;&#10;END' />
            </column>
            <column caption='País ' datatype='string' name='[Calculation_1547267975391174658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [country]&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
            <column caption='Filtro' datatype='string' name='[Calculation_1586111512373981184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([review_date])+[review_template_type]' />
            </column>
            <column caption='Periodo' datatype='string' name='[Calculation_1586111512375078914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bp_status]=&apos;In Progress&apos;&#13;&#10;and DATEPART(&apos;month&apos;,[review_date])=1&#13;&#10;and [review_template_type]=&apos;Full Cycle&apos;&#13;&#10;then &apos;H2&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Año performance (copia)_1520809314561208327]) &lt; 3&#13;&#10;THEN &apos;H1&apos;&#13;&#10;ELSE &apos;H2&apos;&#13;&#10;END +&apos; &apos;+ STR([Calculation_1491817391270969346])' />
            </column>
            <column caption='Antiguedad' datatype='string' name='[Calculation_1653947027435212800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_in_company_days] &lt; 180 THEN &quot;Less than 6 months&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 180 AND [time_in_company_days] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 365 AND [time_in_company_days] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [time_in_company_days] &gt;= 730 AND [time_in_company_days] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSE &quot;More than 5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='Filtro level' datatype='string' name='[Calculation_1792432704296988672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level]IN (&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;)    &#13;&#10;THEN [full_name]&#13;&#10;ELSE [management_level]&#13;&#10;END' />
            </column>
            <column caption='Vista comparativa' datatype='string' name='[Calculation_1847320326690406401]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;mismo ciclo periodo anterior&apos;THEN[versus periodo anterior (copia)_1847320326687813632]&#13;&#10;ELSE [versus periodo anterior (copia)_1827054125697548289]&#13;&#10;END' />
            </column>
            <column caption='Categoría' datatype='string' name='[Calculation_339177377160757249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department]=&apos;People&apos;&#13;&#10;then &apos;Confidencial&apos;&#13;&#10;else &apos;No confidencial&apos;&#13;&#10;END' />
            </column>
            <column caption='Latam North | South' datatype='string' name='[Calculation_634444612472221696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country] IN(&apos;Costa Rica&apos;,&apos;Ecuador&apos;,&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;,&apos;Panamá&apos;,&apos;República Dominicana&apos;,&apos;Venezuela&apos;)&#13;&#10;THEN &apos;Latam North&apos;&#13;&#10;ELSE &apos;Latam South&apos;&#13;&#10;END' />
            </column>
            <column caption='Participantes' datatype='integer' default-format='N' name='[Calculation_634444612598018075]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='COUNTD([employee_id])' />
            </column>
            <column caption='País  II' datatype='string' name='[País  (copia)_1385138393380392960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [scope]=&apos;Local&apos;&#13;&#10;then [country]&#13;&#10;ELSEIF [scope]&lt;&gt;&apos;Local&apos;&#13;&#10;then [department]&#13;&#10;ELSE &apos;Otro&apos;&#13;&#10;END' />
            </column>
            <column caption='View II' datatype='string' name='[View (copia)_634444612542758920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View (copia)_634444612535943173]&#13;&#10;WHEN &apos;País BU + Regional Departamento&apos; THEN [País  (copia)_1385138393380392960]&#13;&#10;WHEN &apos;País BU + Regional&apos; THEN [Calculation_1547267975391174658]&#13;&#10;WHEN &apos;País&apos; THEN [country]&#13;&#10;WHEN &apos;Level&apos; THEN [levels]&#13;&#10;WHEN &apos;Departamento&apos; THEN [department]&#13;&#10;WHEN &apos;Subdepartamento&apos; THEN [sub_department]&#13;&#10;WHEN &apos;Género&apos; THEN [gender]&#13;&#10;WHEN &apos;Tech | Non tech&apos; THEN [tech_non_tech]&#13;&#10;WHEN &apos;Picker | Non Picker&apos; THEN [picker_non_picker]&#13;&#10;WHEN &apos;Latam North | South&apos; THEN [Calculation_634444612472221696]&#13;&#10;WHEN &apos;Antigüedad&apos; THEN [Calculation_1653947027435212800]&#13;&#10;WHEN &apos;Scope&apos; THEN [scope]&#13;&#10;WHEN &apos;Manager Directo&apos; THEN [managed_by_full_name]&#13;&#10;WHEN &apos;C- level&apos; THEN [c_level]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Development Needed&quot;' value='Logra parcialmente las expectativas' />
                <alias key='&quot;Exceeding&quot;' value='Supera las expectativas' />
                <alias key='&quot;Outstanding&quot;' value='Supera ampliamente las expectativas' />
                <alias key='&quot;Performing&quot;' value='Logra las expectativas' />
                <alias key='&quot;Unsatisfactory&quot;' value='No logra las expectativas' />
              </aliases>
            </column>
