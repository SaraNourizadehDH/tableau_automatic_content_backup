        <caption>
          <formatted-text>
            <run fontalignment='1'>High performers
Egresos voluntarios</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pl_e_py_people_dashboard+ (people_ops_proposed)' name='federated.0o37ojs0wmfefs13xu93215kg1l6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agrupador de Evaluación Perfomance&quot;'>
              <calculation class='tableau' formula='&quot;Agrupador de Evaluación Perfomance&quot;' />
            </column>
            <column caption='Switch View I' datatype='string' name='[Switch View (copia)_634444612535943173]' param-domain-type='list' role='measure' type='nominal' value='&quot;Departamento&quot;'>
              <calculation class='tableau' formula='&quot;Departamento&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o37ojs0wmfefs13xu93215kg1l6'>
            <column caption='Fecha de corte' datatype='datetime' datatype-customized='true' name='[Año performance (copia)_1520809314561208327]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [review_template_type]=&apos;Check-In&apos;&#13;&#10;then DATEADD(&apos;month&apos;,-3,[review_date])&#13;&#10;ELSE DATEADD(&apos;month&apos;,-4,[review_date])&#13;&#10;END' />
            </column>
            <column caption='Año' datatype='integer' name='[Calculation_1491817391270969346]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([review_date])=1&#13;&#10;THEN YEAR([review_date])-1&#13;&#10;ELSE YEAR([review_date])&#13;&#10;END' />
            </column>
            <column caption='Filtro' datatype='string' name='[Calculation_1586111512373981184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([review_date])+[review_template_type]' />
            </column>
            <column caption='Periodo' datatype='string' name='[Calculation_1586111512375078914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bp_status]=&apos;In Progress&apos;&#13;&#10;and DATEPART(&apos;month&apos;,[review_date])=1&#13;&#10;and [review_template_type]=&apos;Full Cycle&apos;&#13;&#10;then &apos;H2&apos;&#13;&#10;ELSEIF DATEPART(&apos;quarter&apos;, [Año performance (copia)_1520809314561208327]) &lt; 3&#13;&#10;THEN &apos;H1&apos;&#13;&#10;ELSE &apos;H2&apos;&#13;&#10;END +&apos; &apos;+ STR([Calculation_1491817391270969346])' />
            </column>
            <column caption='Agrupador self performance' datatype='string' name='[Calculation_1637058496526131201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [employee_self_rating_explained]=&apos;Development Needed&apos; &#13;&#10;or [employee_self_rating_explained]=&apos;Unsatisfactory&apos;&#13;&#10;or [employee_self_rating_explained]= &apos;Off Track&apos;&#13;&#10;THEN &apos;Low Performers&apos;&#13;&#10;ELSEIF [employee_self_rating_explained]=&apos;Performing&apos;&#13;&#10;or [employee_self_rating_explained]=&apos;On Track&apos; &#13;&#10;THEN &apos;Solid Performers&apos;&#13;&#10;ELSEIF  [employee_self_rating_explained]=&apos;Exceeding&apos;&#13;&#10;or [employee_self_rating_explained]= &apos;Outstanding&apos;&#13;&#10;THEN &apos;High Performers&apos;&#13;&#10;ELSE &apos;Not rated&apos;&#13;&#10;END' />
            </column>
            <column caption='Filtro level' datatype='string' name='[Calculation_1792432704296988672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level]IN (&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;)    &#13;&#10;THEN [full_name]&#13;&#10;ELSE [management_level]&#13;&#10;END' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_634444612536225798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Evaluación de Performance&apos; THEN [manager_rating_explained]&#13;&#10;WHEN &apos;Agrupador de Evaluación Perfomance&apos; THEN [performance_category]&#13;&#10;WHEN &apos;Agrupador de Autoevaluación&apos; THEN [Calculation_1637058496526131201]&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='No Rated ' />
                <alias key='&quot;Development Needed&quot;' value='Logra parcialmente las expectativas' />
                <alias key='&quot;Exceeding&quot;' value='Supera las expectativas' />
                <alias key='&quot;Off Track&quot;' value='Necesita ajustar su performance' />
                <alias key='&quot;On Track&quot;' value='Performance en camino a lo esperado' />
                <alias key='&quot;Outstanding&quot;' value='Supera ampliamente las expectativas' />
                <alias key='&quot;Performing&quot;' value='Logra las expectativas' />
                <alias key='&quot;Unsatisfactory&quot;' value='No logra las expectativas' />
              </aliases>
            </column>
            <column caption='Participantes' datatype='integer' default-format='N' name='[Calculation_634444612598018075]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='COUNTD([employee_id])' />
            </column>
            <column caption='Confi Líderes' datatype='integer' name='[Calculation_905223556936671232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [mail_manager_04 (consulta_sql_perso1)]=USERNAME()&#13;&#10;then 1 &#13;&#10;ELSEIF [mail_manager_05 (consulta_sql_perso1)]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [mail_manager_06 (consulta_sql_perso1)]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [mail_manager_07 (consulta_sql_perso1)]=USERNAME()&#13;&#10;then 1&#13;&#10;ELSEIF [manager_05_full_name]=&apos;Federico de Pro&apos;&#13;&#10;AND ISUSERNAME(&apos;federico.de.2@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_06_full_name]=&apos;Santiago Rego Vlahussich&apos;&#13;&#10;AND ISUSERNAME(&apos;Santiago.rego@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_07_full_name]=&apos;Santiago Rego Vlahussich&apos;&#13;&#10;AND ISUSERNAME(&apos;Santiago.rego@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_05_full_name]=&apos;Rafael Eraso Brewer&apos;&#13;&#10;AND ISUSERNAME(&apos;rafael.eraso@appetito24.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_06_full_name]=&apos;Rafael Eraso Brewer&apos;&#13;&#10;AND ISUSERNAME(&apos;rafael.eraso@appetito24.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_05_full_name]=&apos;Agustin Jose Rodriguez&apos;&#13;&#10;AND ISUSERNAME(&apos;agustin.rodriguez@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_06_full_name]=&apos;Agustin Jose Rodriguez&apos;&#13;&#10;AND ISUSERNAME(&apos;agustin.rodriguez@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_05_full_name]=&apos;Maria Aguirre&apos;&#13;&#10;AND ISUSERNAME(&apos;Maria Aguirre&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF [manager_06_full_name]=&apos;Maria Aguirre&apos;&#13;&#10;AND ISUSERNAME(&apos;Maria Aguirre&apos;)&#13;&#10;then 1 &#13;&#10;ELSEIF ISUSERNAME(&apos;daniela.alonso@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF ISUSERNAME(&apos;agustina.gatto@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;ELSEIF ISUSERNAME(&apos;micaela.clementi@pedidosya.com&apos;)&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Bp Status' datatype='string' name='[bp_status]' role='dimension' type='nominal' />
