      <column caption='# Performance' datatype='integer' name='[Calculation_1409063756477464580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [performance_category]=&apos;High Performers&apos;&#13;&#10;then 3&#13;&#10;ELSEIF [performance_category]=&apos;Solid Performers&apos;&#13;&#10;then 2&#13;&#10;ELSEIF [performance_category]=&apos;Low Performers&apos;&#13;&#10;then 1&#13;&#10;ELSE 0&#13;&#10;END' />
