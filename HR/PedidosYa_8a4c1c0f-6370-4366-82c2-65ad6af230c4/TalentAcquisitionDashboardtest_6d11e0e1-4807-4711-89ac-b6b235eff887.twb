        <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Latest month (copia)_1460010745866440709] &#13;&#10;THEN [terminations_voluntary]&#13;&#10;END)' />
