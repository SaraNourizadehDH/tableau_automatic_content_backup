        <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos; &#13;&#10;AND not CONTAINS([business_title],&apos;Associate Infrastructure Engineer&apos;)&#13;&#10;AND [business_title]&lt;&gt; &apos;Infrastructure Manager&apos;&#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND [sub_department]&lt;&gt;&apos;Internal IT&apos;&#13;&#10;and[country]=&apos;Argentina&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [lucanet_category_1]=&apos;7- Product Development&apos; &#13;&#10;AND not CONTAINS([business_title],&apos;Associate Infrastructure Engineer&apos;)&#13;&#10;AND [business_title]&lt;&gt; &apos;Infrastructure Manager&apos;&#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND [sub_department]&lt;&gt;&apos;Internal IT&apos;&#13;&#10;AND  [country]=&apos;Uruguay&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;AND not CONTAINS([business_title],&apos;Associate Infrastructure Engineer&apos;)&#13;&#10;AND [business_title]&lt;&gt; &apos;Infrastructure Manager&apos;&#13;&#10;AND [sub_department]&lt;&gt;&apos;Internal IT&apos;&#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND  [country]=&apos;Ecuador&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [lucanet_category_1]=&apos;7- Product Development&apos; &#13;&#10;AND not CONTAINS([business_title],&apos;Associate Infrastructure Engineer&apos;)&#13;&#10;AND [business_title]&lt;&gt; &apos;Infrastructure Manager&apos;&#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND [sub_department]&lt;&gt;&apos;Internal IT&apos;&#13;&#10;and  [country]=&apos;Perú&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [employee_id]=&apos;2021-02-0230&apos;&#13;&#10;OR[employee_id]=&apos;2019-12-3531&apos;&#13;&#10;OR[employee_id]=&apos;2019-12-3583&apos;&#13;&#10;OR[employee_id]=&apos;2021-09-0854&apos;&#13;&#10;OR[employee_id]=&apos;2022-09-2533&apos;&#13;&#10;OR[employee_id]=&apos;2023-04-0325&apos;&#13;&#10;OR[employee_id]=&apos;2023-06-0427&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF[sub_department]=&apos;Finance Systems&apos; &#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND [country]=&apos;Argentina&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF[sub_department]=&apos;Finance Systems&apos; &#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND  [country]=&apos;Uruguay&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF[sub_department]=&apos;Finance Systems&apos; &#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;and [country]=&apos;Ecuador&apos; &#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF[sub_department]=&apos;Finance Systems&apos; &#13;&#10;AND [business_unit]&lt;&gt;&apos;Dmarts&apos;&#13;&#10;AND  [country]=&apos;Perú&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF  [country]=&apos;Argentina&apos; &#13;&#10;and CONTAINS([business_title],&apos;Account Executive&apos;)&#13;&#10;then &apos;Comercial&apos;&#13;&#10;ELSEIF  [country]=&apos;Argentina&apos; &#13;&#10;and CONTAINS([business_title],&apos;Sales Executive&apos;)&#13;&#10;then &apos;Comercial&apos;&#13;&#10;ELSEIF  [country]=&apos;Argentina&apos;&#13;&#10;and CONTAINS([business_title],&apos;Telesales Executive&apos;)&#13;&#10;then &apos;Comercial&apos;&#13;&#10;ELSEIF [country]=&apos;Uruguay&apos; &#13;&#10;AND [department] = &apos;Contact Center&apos;&#13;&#10;AND CONTAINS([management_level],&apos;S&apos;) &#13;&#10;THEN &apos;Operations&apos;&#13;&#10;ELSEIF [country]=&apos;Argentina&apos; AND [sub_department]=&apos;Data Viz&apos;&#13;&#10;OR [country]=&apos;Uruguay&apos; AND [sub_department]=&apos;Data Viz&apos;&#13;&#10;OR [country]=&apos;Ecuador&apos; AND [sub_department]=&apos;Data Viz&apos;&#13;&#10;OR [country]=&apos;Perú&apos; AND [sub_department]=&apos;Data Viz&apos;&#13;&#10;THEN &apos;Tech&apos;&#13;&#10;ELSE &apos;Staff&apos;&#13;&#10;END' />
      </column>
      <column caption='Cluster Levels' datatype='string' name='[Calculation_1196268711056506880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([level],&apos;S&apos;)&#13;&#10;then &apos;Support&apos;&#13;&#10;ELSEIF CONTAINS([level],&apos;IC&apos;)&#13;&#10;then &apos;Individual Contributor&apos;&#13;&#10;ELSEIF [level]=&apos;M1&apos; OR [level]=&apos;M2&apos;&#13;&#10;then &apos;Manager&apos;&#13;&#10;ELSE &apos;M3&amp;UP&apos;&#13;&#10;END' />
      </column>
      <column caption='% TO NH' datatype='real' default-format='p0.00%' name='[Calculation_1202742634848735232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_433752939299606529])/SUM([Closed Positions (copia)_433752939322195973])' />
      </column>
      <column caption='Status TA Tracking' datatype='string' name='[Calculation_1204994435082264576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([status],&quot;Closed&quot;)&#13;&#10;then &apos;Closed&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;Cancelled&quot;)&#13;&#10;then &apos;Cancelled&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;On Hold&quot;)&#13;&#10;then &apos;On Hold&apos;&#13;&#10;ELSEIF  ISNULL([status])&#13;&#10;then NULL&#13;&#10;ELSE &apos;Open&apos;&#13;&#10;END' />
      </column>
      <column caption='Open Positions' datatype='integer' name='[Calculation_1204994435082973185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1204994435082264576]=&apos;Open&apos; and DATETRUNC(&apos;year&apos;,[Calculation_1245245358401957888])&lt;=[Parameters].[Parámetro 3]&#13;&#10;then 1&#13;&#10;ELSEIF DATETRUNC(&apos;year&apos;,[Open Date (copia)_1245245358403170305])&gt;[Parameters].[Parámetro 3]&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='% de cobertura' datatype='real' default-format='p0.0%' name='[Calculation_1204994435084038148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Open Positions (copia)_1204994435083177986])/(SUM([Open Positions (copia)_1204994435083177986])+SUM([Calculation_1204994435082973185]))' />
      </column>
      <column caption='Scope' datatype='string' name='[Calculation_1204994435089780742]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tech_nontech (il_cc_hierarchy_la1)]=&apos;Tech&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Pickers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Local&apos;&#13;&#10;then &apos;BU&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Headcount DH&apos;&#13;&#10;then &apos;DH&apos;&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
      </column>
      <column caption='Agrupador Aging' datatype='string' name='[Calculation_1204994435099578375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_386465199542517760]&lt;=30&#13;&#10;then &apos;0 a 1 mes&apos;&#13;&#10;ELSEIF [Calculation_386465199542517760]&lt;=60&#13;&#10;then &apos;1 a 2 meses&apos;&#13;&#10;ELSEIF [Calculation_386465199542517760]&lt;=90&#13;&#10;then &apos;2 a 3 meses&apos;&#13;&#10;ELSE &apos;+ 4 meses&apos;&#13;&#10;END' />
