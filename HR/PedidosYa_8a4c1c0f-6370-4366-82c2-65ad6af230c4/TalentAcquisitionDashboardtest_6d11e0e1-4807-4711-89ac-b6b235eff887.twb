              <calculation class='tableau' formula='(SUM([Calculation_754634453995364357])+([Mujeres a contratar Tech (copia)_720294527529181188]+[Calculation_1207246236962738195]))/[Personas a contratar Dic-23 II (copia)_720294527521288194]' />
