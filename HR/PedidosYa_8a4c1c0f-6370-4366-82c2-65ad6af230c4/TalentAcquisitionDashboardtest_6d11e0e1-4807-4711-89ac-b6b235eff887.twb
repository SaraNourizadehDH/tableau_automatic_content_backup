      <repository-location id='Cubiertas' path='/t/HR/workbooks/TalentAcquisitionDashboardtest' revision='' site='HR' />
      <style>
        <style-rule element='dash-title'>
          <format attr='font-family' value='Tableau Book' />
        </style-rule>
        <style-rule element='dash-subtitle'>
          <format attr='font-family' value='Tableau Book' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
          <format attr='font-size' value='11' />
          <format attr='font-family' value='Tableau Book' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='color' value='#fa0050' />
          <format attr='font-family' value='Tableau Book' />
          <format attr='font-weight' value='bold' />
        </style-rule>
      </style>
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' sizing-mode='fixed' />
      <datasources>
