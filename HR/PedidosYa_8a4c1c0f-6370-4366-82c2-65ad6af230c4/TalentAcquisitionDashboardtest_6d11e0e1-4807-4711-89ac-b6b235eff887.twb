      <table>
        <view>
          <datasources>
            <datasource caption='il_worker_hist+ (Varias conexiones)' name='federated.0q5x6lf0beybdy0zsuszq0tjlngs' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Años' datatype='date' default-format='*yyyy' name='[Parámetro 3]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column caption='Switch View IV' datatype='string' name='[Switch View III (copia)_830914175737618433]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level&quot;'>
              <calculation class='tableau' formula='&quot;Level&quot;' />
              <aliases>
                <alias key='&quot;Area&quot;' value='Area de Lucanet' />
                <alias key='&quot;Country for Location&quot;' value='País' />
                <alias key='&quot;Platform/Dmarts&quot;' value='Unidad de Negocio' />
                <alias key='&quot;Subdepartamento&quot;' value='Subdepartamento' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='Status TA Tracking' datatype='string' name='[Calculation_1204994435082264576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([status],&quot;Closed&quot;)&#13;&#10;then &apos;Closed&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;Cancelled&quot;)&#13;&#10;then &apos;Cancelled&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;On Hold&quot;)&#13;&#10;then &apos;On Hold&apos;&#13;&#10;ELSEIF  ISNULL([status])&#13;&#10;then NULL&#13;&#10;ELSE &apos;Open&apos;&#13;&#10;END' />
            </column>
            <column caption='Scope' datatype='string' name='[Calculation_1204994435089780742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tech_nontech (il_cc_hierarchy_la1)]=&apos;Tech&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Pickers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Local&apos;&#13;&#10;then &apos;BU&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Headcount DH&apos;&#13;&#10;then &apos;DH&apos;&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
            <column caption='Fecha reporte' datatype='date' name='[Calculation_1290281340807671809]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;year&apos;,[report_date_month])=[Parameters].[Parámetro 3]&#13;&#10;then [report_date_month]&#13;&#10;else DATE(&quot;1991-03-25&quot;)&#13;&#10;END' />
            </column>
            <column caption='Reporte (vista)' datatype='string' name='[Calculation_164944393251074048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[report_effective_date])' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Elegir Vista V' datatype='string' name='[Calculation_830914175737724930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Switch View III (copia)_830914175737618433]&#13;&#10;    when &quot;Linea de Lucanet&quot; then [lucanet_category_1]&#13;&#10;    when &quot;Area&quot; then [area]&#13;&#10;    when &quot;Departamento&quot; then [department]    &#13;&#10;    when &quot;Subdepartamento&quot; then [sub_department]&#13;&#10;    when &quot;Country for Location&quot; then [company]&#13;&#10;    when &quot;Level&quot; then [levels]&#13;&#10;    when &quot;Scope&quot; then [scope]&#13;&#10;    when &quot;Tribu/LOB&quot; then [team]&#13;&#10;    when &quot;Platform/Dmarts&quot; then [business_unit]&#13;&#10;    when &quot;Gender&quot; then [gender]&#13;&#10;    when &quot;C-level&quot; then [c_level (il_cc_hierarchy_la)]&#13;&#10;    when &quot;Meses&quot; then [Calculation_164944393251074048]&#13;&#10;    else &quot;Other&quot;        &#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='Incompleto (WD)' />
              </aliases>
            </column>
