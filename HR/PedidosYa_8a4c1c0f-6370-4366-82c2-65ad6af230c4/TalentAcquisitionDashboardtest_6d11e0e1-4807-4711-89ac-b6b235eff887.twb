      <column caption='Antigüedad Terminations' datatype='real' datatype-customized='true' name='[Calculation_1460010746040189000]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT(IF [Antigüedad Terminations (copia)_433752939300745219] &lt; 90 THEN &quot;Less than 3 months&quot;&#13;&#10;ELSEIF [Antigüedad Terminations (copia)_433752939300745219] &gt;= 90 AND [Antigüedad Terminations (copia)_433752939300745219] &lt; 180 THEN &quot;3 months to 6 months&quot;&#13;&#10;ELSEIF [Antigüedad Terminations (copia)_433752939300745219] &gt;= 180 AND [Antigüedad Terminations (copia)_433752939300745219] &lt; 365 THEN &quot;6 months to 1 year&quot;&#13;&#10;ELSEIF [Antigüedad Terminations (copia)_433752939300745219] &gt;= 365 AND [Antigüedad Terminations (copia)_433752939300745219] &lt; 730 THEN &quot;1 year to 2 years&quot;&#13;&#10;ELSEIF [Antigüedad Terminations (copia)_433752939300745219] &gt;= 730 AND [Antigüedad Terminations (copia)_433752939300745219] &lt; 1825 THEN &quot;2 years to 5 years&quot;&#13;&#10;ELSEIF [Antigüedad Terminations (copia)_433752939300745219]&gt;=1825 THEN &quot;More than 5 years&quot;&#13;&#10;ELSE &quot;-&quot;&#13;&#10;END)' />
      </column>
      <column caption='Momento de egreso' datatype='string' name='[Calculation_1460010746040938569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1460010746040189000]=0&#13;&#10;THEN &apos;&apos;&#13;&#10;ELSEIF  [Calculation_1460010746040189000]&lt;=30&#13;&#10;THEN &apos;&lt;30 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=60&#13;&#10;THEN &apos;60 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=90&#13;&#10;THEN &apos;90 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=180&#13;&#10;THEN &apos;180 días&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=365&#13;&#10;THEN &apos;1 año&apos;&#13;&#10;ELSEIF [Calculation_1460010746040189000]&lt;=730&#13;&#10;THEN &apos;2 años&apos;&#13;&#10;ELSE &apos;+ 3 años&apos;&#13;&#10;END' />
      </column>
      <column caption='Quarter' datatype='boolean' hidden='true' name='[Calculation_1572319274683138048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;quarter&apos;,1,DATETRUNC(&apos;quarter&apos;,[report_effective_date]))) = [report_effective_date]' />
      </column>
