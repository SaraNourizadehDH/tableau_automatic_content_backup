              <calculation class='tableau' formula='IF CONTAINS([status],&quot;Closed&quot;)&#13;&#10;then &apos;Closed&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;Cancelled&quot;)&#13;&#10;then &apos;Cancelled&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;On Hold&quot;)&#13;&#10;then &apos;On Hold&apos;&#13;&#10;ELSEIF  ISNULL([status])&#13;&#10;then NULL&#13;&#10;ELSE &apos;Open&apos;&#13;&#10;END' />
