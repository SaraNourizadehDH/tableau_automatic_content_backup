            <column caption='PCR' datatype='string' name='[Calculation_1276489074128953345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department]=&apos;Sales&apos;&#13;&#10;then &apos;Sales&apos;&#13;&#10;ELSEIF [picker_non_picker]=&apos;Picker&apos;&#13;&#10;then &apos;Dmarts&apos;&#13;&#10;else &apos;Staff&apos;&#13;&#10;END' />
            </column>
            <column caption='HC Hoy' datatype='integer' name='[Calculation_1460010745856528387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='Agrupador Levels' datatype='string' name='[Calculation_1771884999098892294]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([levels],&apos;IC&apos;)&#13;&#10;THEN &apos;IC&apos;&#13;&#10;ELSEIF CONTAINS([levels],&apos;S&apos;)&#13;&#10;THEN &apos;S&apos;&#13;&#10;ELSE &apos;M&apos;&#13;&#10;END' />
            </column>
