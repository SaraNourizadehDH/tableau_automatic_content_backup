          <datasource-dependencies datasource='Parameters'>
            <column alias='Time to Hire' caption='TTH | TTF' datatype='string' name='[Elegir tipo de Fecha (copia)_501588408629096461]' param-domain-type='list' role='measure' type='nominal' value='&quot;TTH&quot;'>
              <calculation class='tableau' formula='&quot;TTH&quot;' />
              <aliases>
                <alias key='&quot;TTF&quot;' value='Time to Fill' />
                <alias key='&quot;TTH&quot;' value='Time to Hire' />
              </aliases>
            </column>
            <column caption='Años' datatype='date' default-format='*yyyy' name='[Parámetro 3]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column caption=' Switch View' datatype='string' name='[Parámetro 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agrupación de Scope&quot;'>
              <calculation class='tableau' formula='&quot;Agrupación de Scope&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='Cluster Levels' datatype='string' name='[Calculation_1196268711056506880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([level],&apos;S&apos;)&#13;&#10;then &apos;Support&apos;&#13;&#10;ELSEIF CONTAINS([level],&apos;IC&apos;)&#13;&#10;then &apos;Individual Contributor&apos;&#13;&#10;ELSEIF [level]=&apos;M1&apos; OR [level]=&apos;M2&apos;&#13;&#10;then &apos;Manager&apos;&#13;&#10;ELSE &apos;M3&amp;UP&apos;&#13;&#10;END' />
            </column>
            <column caption='Status TA Tracking' datatype='string' name='[Calculation_1204994435082264576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([status],&quot;Closed&quot;)&#13;&#10;then &apos;Closed&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;Cancelled&quot;)&#13;&#10;then &apos;Cancelled&apos;&#13;&#10;ELSEIF  CONTAINS([status],&quot;On Hold&quot;)&#13;&#10;then &apos;On Hold&apos;&#13;&#10;ELSEIF  ISNULL([status])&#13;&#10;then NULL&#13;&#10;ELSE &apos;Open&apos;&#13;&#10;END' />
            </column>
            <column caption='Scope' datatype='string' name='[Calculation_1204994435089780742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tech_nontech (il_cc_hierarchy_la1)]=&apos;Tech&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Pickers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Local&apos;&#13;&#10;then &apos;BU&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Headcount DH&apos;&#13;&#10;then &apos;DH&apos;&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
            <column caption='Agrupador Aging' datatype='string' name='[Calculation_1204994435099578375]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_386465199542517760]&lt;=30&#13;&#10;then &apos;0 a 1 mes&apos;&#13;&#10;ELSEIF [Calculation_386465199542517760]&lt;=60&#13;&#10;then &apos;1 a 2 meses&apos;&#13;&#10;ELSEIF [Calculation_386465199542517760]&lt;=90&#13;&#10;then &apos;2 a 3 meses&apos;&#13;&#10;ELSE &apos;+ 4 meses&apos;&#13;&#10;END' />
            </column>
            <column caption='Open Date' datatype='datetime' name='[Calculation_1245245358401957888]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPARSE(&quot;dd-MM-yyyy&quot;,[open_date_dd_mmm_yy_] )' />
            </column>
            <column caption='Vista Open' datatype='string' name='[Calculation_1245245358443114510]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 5]= &apos;Agrupación de Level&apos;&#13;&#10;then [Calculation_1196268711056506880]&#13;&#10;ELSEIF [Parameters].[Parámetro 5]=&apos;Agrupación de Scope&apos;&#13;&#10;then [Calculation_1204994435089780742]&#13;&#10;ELSEIF [Parameters].[Parámetro 5]=&apos;Meses&apos;&#13;&#10;then [Open Date (Q) (copia)_501588408611139585]&#13;&#10;ELSEIF [Parameters].[Parámetro 5]=&apos;Quarter&apos;&#13;&#10;then [Open Date (copia)_501588408610816000]&#13;&#10;ELSE &apos;otro&apos;&#13;&#10;END' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Aging' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_386465199542517760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TODAY()-[Calculation_1245245358401957888]' />
            </column>
            <column caption='TTH o TTF' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_501588408629211150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Elegir tipo de Fecha (copia)_501588408629096461]=&apos;TTH&apos;&#13;&#10;THEN [Calculation_756041809281736706]&#13;&#10;ELSE [Calculation_756041809281265665]&#13;&#10;END' />
            </column>
            <column caption='TTF' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_756041809281265665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Offer Extension Date (copia)_1245245358403391490]-[Calculation_1245245358401957888])' />
            </column>
            <column caption='TTH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_756041809281736706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Open Date (copia)_1245245358403170305]-[Calculation_1245245358401957888])' />
            </column>
