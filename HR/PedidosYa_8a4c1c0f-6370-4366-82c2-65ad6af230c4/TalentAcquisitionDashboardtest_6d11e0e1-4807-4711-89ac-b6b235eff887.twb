            </column>
            <column caption='Picker/Non Picker by CeCo' datatype='string' name='[Calculation_720294527600619531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sub_department]=&apos;Pickers&apos;&#13;&#10;then &apos;Pickers&apos;&#13;&#10;ELSE &apos;Non Picker&apos;&#13;&#10;END' />
            </column>
