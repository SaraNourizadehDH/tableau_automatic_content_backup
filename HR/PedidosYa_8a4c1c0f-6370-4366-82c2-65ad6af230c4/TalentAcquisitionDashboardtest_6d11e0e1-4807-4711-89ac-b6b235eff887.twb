            <column-instance column='[Calculation_322007426734161932]' derivation='None' name='[none:Calculation_322007426734161932:nk]' pivot='key' type='nominal' />
            <column-instance column='[area]' derivation='None' name='[none:area:nk]' pivot='key' type='nominal' />
