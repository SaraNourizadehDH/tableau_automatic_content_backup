              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='#Mujeres Líderes Dic &apos;23' datatype='integer' name='[#Mujeres Líderes Dic &apos;23 Tech (copia)_1207246236966854679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CEILING([Calculation_1207246236936065031]*[Parameters].[Objetivo Tech (copia)_23081012319768577])' />
            </column>
            <column caption='BHE  Líder' datatype='real' default-format='p0.0%' name='[BHE Tech Líder (copia)_1207246236966453269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1207246236981428258]/[Calculation_1207246236957782030])' />
            </column>
            <column caption='Best Hiring Estimate Líder' datatype='real' default-format='p0.0%' name='[Best Hiring Estimate Líder Tech (copia)_1207246236967280664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [BHE Tech Líder (copia)_1207246236966453269]&lt;0&#13;&#10;then 0&#13;&#10;ELSEIF [BHE Tech Líder (copia)_1207246236966453269]&gt;1&#13;&#10;then 1&#13;&#10;ELSE [BHE Tech Líder (copia)_1207246236966453269]&#13;&#10;END)' />
            </column>
            <column caption='Mujeres Líderes (Dic&apos;22)' datatype='integer' name='[Calculation_1207246236934606849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = DATE(&quot;2023-12-01&quot;) &#13;&#10;THEN [female_leadership]&#13;&#10;END)' />
            </column>
            <column caption='HC Líderes &apos;22' datatype='integer' name='[Calculation_1207246236935122947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = DATE(&quot;2023-12-01&quot;)&#13;&#10;THEN [leadership]&#13;&#10;END)' />
            </column>
            <column caption='Gendermix Leadership &apos;22' datatype='real' default-format='p0.0%' name='[Calculation_1207246236935315460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1207246236934606849])/SUM([Calculation_1207246236935122947])' />
            </column>
            <column caption='Budget Dic &apos;23' datatype='real' name='[Calculation_1207246236935671813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Fecha]=DATE(&quot;2024-12-01&quot;)&#13;&#10;then [Target]&#13;&#10;END' />
            </column>
            <column caption='% Líderes' datatype='real' default-format='p0.0%' name='[Calculation_1207246236935831558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([HC Hoy (copia)_1460010746050023507])/SUM([Calculation_1460010745856528387])' />
            </column>
            <column caption='Líderes a contratar Dic-23 II' datatype='real' name='[Calculation_1207246236936065031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Calculation_1207246236935671813])*[Calculation_1207246236935831558])+0' />
            </column>
            <column caption='Dif Líderes a contratar Dic-23' datatype='real' name='[Calculation_1207246236957782030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1207246236936065031]-SUM([HC Hoy (copia)_1460010746050023507]))' />
            </column>
            <column caption='Líderes a contratar Dic-23 ' datatype='real' name='[Calculation_1207246236976308254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1207246236957782030]&lt;0&#13;&#10;then 0&#13;&#10;else [Calculation_1207246236957782030]&#13;&#10;END' />
            </column>
            <column caption='Lideres Mujeres a contratar Non Tech II' datatype='real' name='[Calculation_1207246236978794528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Lideres Mujeres a contratar Tech (copia)_1207246236967612441]&lt;0&#13;&#10;THEN 0&#13;&#10;ELSE [Lideres Mujeres a contratar Tech (copia)_1207246236967612441]&#13;&#10;END' />
            </column>
            <column caption='Lideres Mujeres a contratar' datatype='integer' name='[Calculation_1207246236981428258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Dif de Lideres Mujeres Tech a contratar (copia)_1207246236966735894]&lt;0&#13;&#10;THEN 0&#13;&#10;ELSE [Dif de Lideres Mujeres Tech a contratar (copia)_1207246236966735894]&#13;&#10;END' />
            </column>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='HC Hoy' datatype='integer' name='[Calculation_1460010745856528387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
