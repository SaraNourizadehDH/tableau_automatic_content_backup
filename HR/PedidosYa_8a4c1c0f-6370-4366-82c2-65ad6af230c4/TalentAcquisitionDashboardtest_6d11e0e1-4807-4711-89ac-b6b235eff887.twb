      <datasource-dependencies datasource='Parameters'>
        <column caption='Elegir tipo de Fecha' datatype='string' name='[ Switch View (copia)_501588408626429961]' param-domain-type='list' role='measure' type='nominal' value='&quot;Meses&quot;'>
