          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='#Mujeres Dic &apos;23 Non Tech' datatype='integer' name='[#Mujeres Líderes Dic &apos;23 Non Tech (copia)_1207246236986585133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CEILING([Líderes a contratar Dic-23 II (copia)_1207246236984274984]*[Parameters].[Objetivo Tech (copia)_23081012319703040])' />
            </column>
            <column caption='BHE Non Tech ' datatype='real' default-format='p0.0%' name='[BHE Non Tech Líder (copia)_1207246236986929200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Mujeres a contratar Tech II (copia)_720294527529299973]/[Dif Líderes a contratar Dic-23 (copia)_1207246236984537130])' />
            </column>
            <column caption='Best Hiring Estimate Non Tech' datatype='real' default-format='p0.0%' name='[Best Hiring Estimate Líder (copia)_720294527523364867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [BHE Non Tech Líder (copia)_1207246236986929200]&lt;0&#13;&#10;then 0&#13;&#10;ELSEIF [BHE Non Tech Líder (copia)_1207246236986929200]&gt;1&#13;&#10;then 1&#13;&#10;ELSE [BHE Non Tech Líder (copia)_1207246236986929200]&#13;&#10;END)' />
            </column>
            <column caption='Budget Dic &apos;23' datatype='real' name='[Calculation_1207246236935671813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Fecha]=DATE(&quot;2024-12-01&quot;)&#13;&#10;then [Target]&#13;&#10;END' />
            </column>
            <column caption='% Líderes' datatype='real' default-format='p0.0%' name='[Calculation_1207246236935831558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([HC Hoy (copia)_1460010746050023507])/SUM([Calculation_1460010745856528387])' />
            </column>
            <column caption='Líderes a contratar Dic-23 II' datatype='real' name='[Calculation_1207246236936065031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([Calculation_1207246236935671813])*[Calculation_1207246236935831558])+0' />
            </column>
            <column caption='#Mujeres Dic &apos;23 Tech' datatype='integer' name='[Calculation_1207246236939350024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CEILING([Líderes a contratar Dic-23 II (copia)_1207246236984274984]*[Parameters].[Parámetro 6])' />
            </column>
            <column caption='Dif de Mujeres Tech a contratar' datatype='integer' name='[Calculation_1207246236953518090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1207246236939350024])-(SUM([Calculation_754634453995364357])-SUM([Hiring Hoy (copia)_1460010746046001226]))' />
            </column>
            <column caption='BHE Tech' datatype='real' default-format='p0.0%' name='[Calculation_1207246236958081039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1207246236982243363]/[Líderes a contratar Dic-23 II (copia)_1207246236984274984])' />
            </column>
            <column caption='Best Hiring Estimate Tech' datatype='real' default-format='p0.0%' name='[Calculation_1207246236958785552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Calculation_1207246236958081039]&lt;0&#13;&#10;then 0&#13;&#10;ELSEIF [Calculation_1207246236958081039]&gt;1&#13;&#10;then 1&#13;&#10;ELSE [Calculation_1207246236958081039]&#13;&#10;END)' />
            </column>
            <column caption='Mujeres a contratar Tech' datatype='real' name='[Calculation_1207246236962738195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Dif Líderes a contratar Dic-23 (copia)_1207246236984537130]*[Calculation_1207246236958785552])' />
            </column>
            <column caption='Mujeres Tech a contratar' datatype='integer' name='[Calculation_1207246236982243363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1207246236953518090]&lt;0&#13;&#10;THEN 0&#13;&#10;ELSE [Calculation_1207246236953518090]&#13;&#10;END' />
            </column>
            <column caption='This month' datatype='datetime' name='[Calculation_1460010745856319490]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATETRUNC(&apos;month&apos;, [Parameters].[Parámetro 4])) }' />
            </column>
            <column caption='HC Hoy' datatype='integer' name='[Calculation_1460010745856528387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF DATETRUNC(&apos;month&apos;, [Report Effective Date (Il Worker Hist Wit) (copia)_1460010745854558209]) = [Parameters].[Parámetro 4]&#13;&#10;THEN [actual]&#13;&#10;END)' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
