            </column>
            <column caption='TTF (WD)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[TTF (copia)_501588408640086032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([job_filled_date]-[job_creation_date])' />
            </column>
            <column caption='TTH (WD)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[TTH (copia)_501588408645468177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([offer_extended_date]-[job_creation_date])' />
            </column>
            <column caption='Elegir ver por' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[TTH o TTF (copia)_501588408645992467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[TTH | TTF (copia)_501588408645836818]=&apos;TTH&apos;&#13;&#10;THEN [TTH (copia)_501588408645468177]&#13;&#10;ELSEIF [Parameters].[TTH | TTF (copia)_501588408645836818]=&apos;TTF&apos;&#13;&#10;THEN [TTF (copia)_501588408640086032]&#13;&#10;ELSE [Calculation_433752939297452032]&#13;&#10;END' />
