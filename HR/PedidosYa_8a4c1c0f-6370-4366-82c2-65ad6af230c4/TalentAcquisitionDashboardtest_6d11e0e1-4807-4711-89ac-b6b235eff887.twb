            </properties>
            <properties context='extract'>
              <relation name='il_ta_tracking_latam_4C82B4C603684083AE0F79427C1DD2C1' table='[Extract].[il_ta_tracking_latam_4C82B4C603684083AE0F79427C1DD2C1]' type='table' />
            </properties>
          </object>
          <object caption='il_ta_tracking_lat' id='il_ta_tracking_latam_F2BE52FF7FCA460AB5DA44E34FF684F1'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[il_ta_tracking_lat].[peya_email_new_candidate]' />
                      <expression op='[il_worker_org1].[work_email]' />
                    </expression>
                    <expression op='='>
                      <expression op='SPLIT([il_ta_tracking_lat].[start_date_dd_mmm_yy_],&apos;-&apos;,3 )' />
                      <expression op='[il_worker_org1].[year_sd]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[il_ta_tracking_lat].[ceco]' />
                      <expression op='[il_cc_hierarchy_la1].[cost_center_id]' />
                    </expression>
                  </clause>
                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='='>
                        <expression op='[il_ta_tracking_lat].[fuente de reclutamiento]' />
                        <expression op='[TA].[Fuentes de reclutamiento]' />
                      </expression>
                    </clause>
                    <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='il_ta_tracking_lat' table='[people_ops_proposed].[il_ta_tracking_latam]' type='table' />
                    <relation connection='excel-direct.13jgv3k04taikr100g9ca0zng29t' name='TA' table='[TA$]' type='table'>
                      <columns gridOrigin='A1:B38:no:A1:B38:0' header='yes' outcome='2'>
                        <column datatype='string' name='Fuentes de reclutamiento' ordinal='0' />
                        <column datatype='string' name='Agrupación de fuentes' ordinal='1' />
                      </columns>
                    </relation>
                  </relation>
                  <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='il_cc_hierarchy_la1' table='[people_ops_proposed].[il_cc_hierarchy_latam]' type='table' />
                </relation>
                <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='il_worker_org1' type='text'>
                  <columns>
                    <column datatype='date' date-parse-format='yyyy-MM-dd' name='last_day_of_work' />
                    <column datatype='date' date-parse-format='yyyy-MM-dd' name='first_day_of_work' />
                  </columns>
select&#13;
org.*,&#13;
CAST(EXTRACT(YEAR FROM DATE(first_day_of_work)) AS VARCHAR) AS year_sd,&#13;
t.termination_type,&#13;
t.termination_category,&#13;
t.termination_reason&#13;
&#13;
from people_ops_proposed.il_worker_org org&#13;
left join people_ops_proposed.il_termination t &#13;
on org.employee_id =t.employee_id &#13;
and org.last_day_of_work =t.last_day_of_work &#13;
and t.status=&apos;Successfully Completed&apos;                </relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='il_ta_tracking_latam_F2BE52FF7FCA460AB5DA44E34FF684F1' table='[Extract].[il_ta_tracking_latam_F2BE52FF7FCA460AB5DA44E34FF684F1]' type='table' />
            </properties>
