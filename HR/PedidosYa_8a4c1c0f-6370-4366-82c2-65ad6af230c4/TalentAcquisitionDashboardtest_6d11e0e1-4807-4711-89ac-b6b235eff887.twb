          </datasources>
          <datasource-dependencies datasource='federated.0q5x6lf0beybdy0zsuszq0tjlngs'>
            <column caption='% female Hiring' datatype='real' default-format='p0.0%' name='[Calculation_1232015991551369216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1789899384671268865])/SUM([hires])' />
            </column>
            <column caption='Levels' datatype='string' name='[Calculation_1232015991561330690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [levels] IN (&apos;M1&apos;,&apos;M2&apos;)&#13;&#10;THEN &apos;M1&amp;M2&apos;&#13;&#10;ELSEIF [levels] IN (&apos;M3&apos;,&apos;M4&apos;,&apos;M5 &amp; UP&apos;)&#13;&#10;THEN &apos;M3&amp;UP&apos;&#13;&#10;ELSE &apos;S &amp; IC&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Product&quot;' value='UX &amp; Product' />
                <alias key='&quot;Tech&quot;' value='Ing. &amp; Data' />
              </aliases>
            </column>
            <column caption='Hiring Mujeres' datatype='integer' default-format='N' name='[Calculation_1789899384671268865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gender]=&apos;Female&apos;&#13;&#10;then [hires]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Tech | Non Tech' datatype='string' name='[Calculation_322007426734161932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lucanet_category_1]=&apos;7- Product Development&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [area]=&apos;Internal IT&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSE &apos;Non Tech&apos;&#13;&#10;end' />
            </column>
            <column caption='Hires' datatype='integer' name='[Calculation_433752939297452032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hires])' />
            </column>
            <column caption='Vista 0' datatype='string' name='[Vista I (copia)_1771884998989373440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Vista Non Picker (copia)_1760063042604560386]=&apos;Arg BU&apos;&#13;&#10;then &apos;Mercedes de la Fuente&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]= &apos;Mercados Locales&apos;&#13;&#10;then &apos;Victor Abalos&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]= &apos;Tiedas Locales&apos;&#13;&#10;then &apos;Victor Abalos&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]= &apos;Tiendas Arg&apos;&#13;&#10;then &apos;Mercedes de la Fuente&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]=&apos;Tech&apos;&#13;&#10;then &apos;Mariano Pavia&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]=&apos;Regional II&apos;&#13;&#10;then &apos;Mariano Pavia&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]=&apos;Regional&apos;&#13;&#10;then &apos;Victor Abalos&apos;&#13;&#10;ELSEIF [Vista Non Picker (copia)_1760063042604560386]=&apos;SSC&apos;&#13;&#10;then &apos;Victor Abalos&apos;&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Grupo I' datatype='string' name='[Vista Non Picker (copia)_1760063042604560386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [picker_non_picker]=&apos;Picker&apos;&#13;&#10;then &apos;Picker&apos;&#13;&#10;ELSEIF [scope]=&apos;Local&apos; AND [country]=&apos;Argentina&apos; and [sub_department]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiendas Arg&apos;&#13;&#10;ELSEIF [scope]=&apos;Local&apos; AND [country]=&apos;Argentina&apos;&#13;&#10;then &apos;Arg BU&apos;&#13;&#10;ELSEIF [scope]=&apos;Local&apos; AND [country]&lt;&gt;&apos;Argentina&apos; and [sub_department]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiedas Locales&apos;&#13;&#10;ELSEIF [scope]=&apos;Local&apos; AND [country]&lt;&gt;&apos;Argentina&apos;&#13;&#10;then &apos;Mercados Locales&apos;&#13;&#10;ELSEIF [tech_nontech]=&apos;Tech&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [department]in (&apos;People&apos;,&apos;Marketing&apos;,&apos;Finance&apos;,&apos;Fintech&apos;) AND [scope]  in (&apos;Regional&apos;,&apos;SCC&apos;)&#13;&#10;then &apos;Regional II&apos;&#13;&#10;ELSE [scope]&#13;&#10;END' />
            </column>
