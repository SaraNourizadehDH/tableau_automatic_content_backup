              <calculation class='tableau' formula='IF CONTAINS([level],&apos;S&apos;)&#13;&#10;then &apos;Support&apos;&#13;&#10;ELSEIF CONTAINS([level],&apos;IC&apos;)&#13;&#10;then &apos;Individual Contributor&apos;&#13;&#10;ELSEIF [level]=&apos;M1&apos; OR [level]=&apos;M2&apos;&#13;&#10;then &apos;Manager&apos;&#13;&#10;ELSE &apos;M3&amp;UP&apos;&#13;&#10;END' />
            </column>
            <column caption='Scope' datatype='string' name='[Calculation_1204994435089780742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tech_nontech (il_cc_hierarchy_la1)]=&apos;Tech&apos;&#13;&#10;then &apos;Tech&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Pickers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [sub_department (il_cc_hierarchy_la1)]=&apos;Shift Supervisors &amp; Store Managers&apos;&#13;&#10;then &apos;Tiendas&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Local&apos;&#13;&#10;then &apos;BU&apos;&#13;&#10;ELSEIF [scope (il_cc_hierarchy_la1)]=&apos;Headcount DH&apos;&#13;&#10;then &apos;DH&apos;&#13;&#10;ELSE &apos;Regional&apos;&#13;&#10;END' />
            </column>
            <column caption='Agrupador Aging' datatype='string' name='[Calculation_1204994435099578375]' role='dimension' type='nominal'>
