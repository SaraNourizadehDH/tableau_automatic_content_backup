          <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='il_ta_tracking_lat1' table='[people_ops_proposed].[il_ta_tracking_latam]' type='table' />
          <relation connection='athena.08yw8cb1i4jw3317730li1elsghu' name='il_sr_job_requisit' table='[people_ops_proposed].[il_sr_job_requisition]' type='table'>
            <columns>
              <column datatype='date' date-parse-format='yyyy-MM-dd HH:mm:ss' name='job_creation_date' />
              <column datatype='date' date-parse-format='yyyy-MM-dd HH:mm:ss' name='job_filled_date' />
