          <calculation class='tableau' formula='if [Handover to CoreOps Date]&gt;DATE(&quot;2021-12-31&quot;)&#13;&#10;AND [Handover to CoreOps Date]&lt;DATE(&quot;2022-12-31&quot;)&#13;&#10;then &quot;Contratados&quot;&#13;&#10;else &quot;No Contratados&quot;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;// TODAS LAS PERSONAS QUE TIENEN FECHA EN EL CAMPO DE HANDOVER (PERSONAS QUE FUERON SELECCIONADAS PARA LA POSICION)' />
