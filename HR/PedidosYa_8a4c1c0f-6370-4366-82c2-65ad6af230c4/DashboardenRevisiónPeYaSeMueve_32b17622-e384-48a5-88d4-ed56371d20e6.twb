            </column>
            <column caption='# Candidatos Internacionales' datatype='string' name='[Calculation_826410545053970444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Worker&apos;s Country] = &quot;Argentina&quot; &#13;&#10;or [Worker&apos;s Country] = &quot;Bolivia&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Chile&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Uruguay&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Paraguay&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Peru&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Ecuador&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Venezuela&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Guatemala&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;El Salvador&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Nicaragua&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Panama&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Dominican Republic&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Costa Rica&quot;&#13;&#10;or [Worker&apos;s Country] = &quot;Honduras&quot; &#13;&#10;then &quot;LATAM&quot; else &quot;País Extranjero&quot; &#13;&#10;end' />
            </column>
            <column caption='# Postulaciones Extranjeras' datatype='integer' name='[Calculation_826410545055817741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_826410545053970444] = &quot;País Extranjero&quot; then 1 else 0 end' />
            </column>
            <column caption='% Postulaciones Extranjeras' datatype='real' name='[Calculation_826410545056391182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_826410545055817741])/[Calculation_826410545024204802]' />
            </column>
            <column datatype='string' name='[Employee ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Worker&apos;s Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_826410545056391182]' derivation='User' name='[usr:Calculation_826410545056391182:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
