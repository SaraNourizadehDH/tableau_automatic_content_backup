              <calculation class='tableau' formula='[cost_center_id]+[department_c]+[department_c]+[work_email]+[original_first_day_of_work]&#13;&#10;+[business_title]+[management_level]+[store_id (consulta_sql_perso)]' />
            </column>
            <column caption='sum (payroll)' datatype='integer' name='[Calculation_1541075544092512258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[name_on_account]+[account_number]+[bank_id]+[company_id]+[compensation_grade_profile]&#13;&#10;+[salary_amount]+[salary_frequency]+[iban]+[pay_groups]+[bic (consulta_sql_perso)]' />
            </column>
            <column caption='sum (personal)' datatype='integer' name='[Calculation_1541075544092745731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_home_address_completed]+[address_country]+ [is_home_address_completed]&#13;&#10;+[address_postal_code]+[birth_date]+[gender]&#13;&#10;+[marital_status]+[national_ids]+[address_city]+[nationality]+[first_name]+[last_name]+[country_of_birth (consulta_sql_perso)]' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1794965928744243200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company_name] = &quot;Delivery Hero SE&quot; THEN [central_department]&#13;&#10;ELSE [department]&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_1794965928745742338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [central_sub_department] = &quot;EU Regional Platform&quot; OR [central_sub_department] = &quot;EU Regional Dmart&quot; THEN &quot;Foodora&quot;&#13;&#10;ELSE [brand]&#13;&#10;END' />
