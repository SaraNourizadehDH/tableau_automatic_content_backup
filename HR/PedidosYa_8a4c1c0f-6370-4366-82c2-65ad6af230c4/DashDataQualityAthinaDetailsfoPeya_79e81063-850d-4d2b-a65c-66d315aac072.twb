              <relation connection='athena.07fu8pc1298t2711oymka06oien9' name='il_athina_data_map' table='[people_ops_proposed].[il_athina_data_mapping]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='il_athina_data_mapping_1C89919BD00E42E9BACF2683DBE00ED5' table='[Extract].[il_athina_data_mapping_1C89919BD00E42E9BACF2683DBE00ED5]' type='table' />
            </properties>
          </object>
        </objects>
