      <table>
        <view>
          <datasources>
            <datasource caption='consulta_sql_perso (people_ops_proposed)' name='federated.0oxevbk0uahwfm1gloj040mt439j' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Switch View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Picker/Non Picker&quot;'>
              <calculation class='tableau' formula='&quot;Picker/Non Picker&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oxevbk0uahwfm1gloj040mt439j'>
            <column caption='sum (job)' datatype='integer' name='[Calculation_1541075544091865088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost_center_id]+[department_c]+[department_c]+[work_email]+[original_first_day_of_work]&#13;&#10;+[business_title]+[management_level]+[store_id (consulta_sql_perso)]' />
            </column>
            <column caption='sum (payroll)' datatype='integer' name='[Calculation_1541075544092512258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[name_on_account]+[account_number]+[bank_id]+[company_id]+[compensation_grade_profile]&#13;&#10;+[salary_amount]+[salary_frequency]+[iban]+[pay_groups]+[bic (consulta_sql_perso)]' />
            </column>
            <column caption='sum (personal)' datatype='integer' name='[Calculation_1541075544092745731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[is_home_address_completed]+[address_country]+ [is_home_address_completed]&#13;&#10;+[address_postal_code]+[birth_date]+[gender]&#13;&#10;+[marital_status]+[national_ids]+[address_city]+[nationality]+[first_name]+[last_name]+[country_of_birth (consulta_sql_perso)]' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1794965928744243200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company_name] = &quot;Delivery Hero SE&quot; THEN [central_department]&#13;&#10;ELSE [department]&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_1794965928745742338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [central_sub_department] = &quot;EU Regional Platform&quot; OR [central_sub_department] = &quot;EU Regional Dmart&quot; THEN &quot;Foodora&quot;&#13;&#10;ELSE [brand]&#13;&#10;END' />
            </column>
            <column caption='Picker/ Non Picker' datatype='string' name='[Calculation_1813261845074944000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [contract_type2] = &apos;Operational Worker - Fixed Term (Fixed Term)&apos; or [contract_type2] = &apos;Operational Worker - Permanent&apos;&#13;&#10;&#9;THEN &apos;Picker&apos;&#13;&#10;&#9;ELSE &apos;Non Picker&apos;&#13;&#10;&#9;end' />
            </column>
            <column caption='Count employees' datatype='integer' name='[Calculation_1876312239923380225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([employee_id])' />
            </column>
            <column caption='Total Errors' datatype='integer' name='[Calculation_2016768252544860161]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_1541075544091865088]+[Calculation_1541075544092512258]+[Calculation_1541075544092745731]' />
            </column>
            <column caption='Accurate' datatype='string' name='[Calculation_2016768252546371587]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2016768252544860161] &gt; 0 THEN &apos;Error&apos; ELSE &apos;Accurate&apos; END' />
            </column>
            <column caption='Accurate employees%' datatype='real' name='[Calculation_2016768252552134665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2016768252546371587] = &apos;Accurate&apos; THEN 1 ELSE 0 END) / COUNT([Calculation_2016768252546371587])' />
            </column>
            <column caption='Number employees' datatype='integer' name='[Calculation_695806194624196615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [employee_id] &lt;&gt; &quot;&quot; then 1 ELSE 0 END' />
            </column>
            <column caption='Data Accurate %' datatype='real' name='[Calculation_772930330838097926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([Calculation_2016768252544860161])/([Total Errors (copia)_1541075544094519303]))' />
            </column>
            <column caption='Choose View' datatype='string' name='[Calculation_835980727101505536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    when &quot;Brand&quot; then [Calculation_1794965928745742338] &#13;&#10;    when &quot;Country&quot; then [country]&#13;&#10;    when &quot;Picker/Non Picker&quot; then [Calculation_1813261845074944000]&#13;&#10;          &#13;&#10;END' />
            </column>
            <column caption='Count Fields' datatype='integer' name='[Total Errors (copia)_1541075544094519303]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[sum (job) (copia)_1541075544093626372]+[sum (payroll) (copia)_1541075544093700101]+[sum (personal) (copia)_1541075544093753350]' />
            </column>
