        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.07fu8pc1298t2711oymka06oien9' name='consulta_sql_perso' type='text'><![CDATA[SELECT
   wp.employee_id,
   cm.country,
   cm.brand,
   cm.company_name,
   cha.department AS central_department,
   cha.sub_department AS central_sub_department,
   wo.department_wd AS department,
   wo.sub_department_wd AS sub_department,
   hl.business_unit,
   hl.area,
   hl.lucanet_category_1,
   hl.scope,
   wo.last_updated,
   wo.contract_type,
   py.payment_type,
    wo.business_title as bussiness_title2,
    wo.contract_type as contract_type2,
   CASE
      WHEN wo.company_id IS NULL
      AND at.company_id = '1' THEN 1
      ELSE 0
   END AS company_id,
   CASE
      WHEN wo.original_first_day_of_work IS NULL
      AND at.original_first_day_of_work = '1' THEN 1
      ELSE 0
   END AS original_first_day_of_work,
   CASE
      WHEN wp.first_name IS NULL
      AND at.first_name = '1' THEN 1
      ELSE 0
   END AS first_name,
   CASE
      WHEN wp.last_name IS NULL
      AND at.last_name = '1' THEN 1
      ELSE 0
   END AS last_name,
   CASE
      WHEN wo.contract_signed_date IS NULL
      AND at.contract_signed_date = '1' THEN 1
      ELSE 0
   END AS contract_signed_date,
   CASE
      WHEN wo.business_title IS NULL
      AND at.business_title = '1' THEN 1
      ELSE 0
   END AS business_title,
   CASE
      WHEN py.pay_type IS NULL
      AND at.pay_type = '1' THEN 1
      ELSE 0
   END AS pay_type,
   CASE
      WHEN wo.cost_center_id IS NULL
      AND at.cost_center_id = '1' THEN 1
      ELSE 0
   END AS cost_center_id,
   CASE
      WHEN wp.is_home_address_completed IS NULL
      AND at.is_home_address_completed = '1' THEN 1
      ELSE 0
   END AS is_home_address_completed,
   CASE
      WHEN wp.address_country IS NULL
      AND at.address_country = '1' THEN 1
      ELSE 0
   END AS address_country,
   CASE
      WHEN wp.address_city IS NULL
      AND at.address_city = '1' THEN 1
      ELSE 0
   END AS address_city,
   CASE
      WHEN wo.department_wd IS NULL
      AND at.department_wd = '1' THEN 1
      ELSE 0
   END AS department_c,
   CASE
      WHEN wp.birth_date IS NULL
      AND at.birth_date = '1' THEN 1
      ELSE 0
   END AS birth_date,
   CASE
      WHEN wp.Gender IS NULL
      AND at.gender = '1' THEN 1
      ELSE 0
   END AS gender,
   CASE
      WHEN py.name_on_account IS NULL
      AND at.name_on_account = '1' THEN 1
      ELSE 0
   END AS name_on_account,
   CASE
      WHEN py.account_number IS NULL
      AND at.account_number = '1' THEN 1
      ELSE 0
   END AS account_number,
   CASE
      WHEN py.bank_id IS NULL
      AND at.bank_id = '1' THEN 1
      ELSE 0
   END AS bank_id,
   CASE
      WHEN SPLIT(wp.national_ids, ' ') [1] IS NULL
      AND at.national_ids = '1' THEN 1
      ELSE 0
   END AS national_ids,
   CASE
      WHEN wp.address_postal_code IS NULL
      AND at.address_postal_code = '1' THEN 1
      ELSE 0
   END AS address_postal_code,
   CASE
      WHEN wp.personal_email IS NULL
      AND at.personal_email = '1' THEN 1
      ELSE 0
   END AS personal_email,
   CASE
      WHEN wo.sub_department_wd IS NULL
      AND at.sub_department = '1' THEN 1
      ELSE 0
   END AS sub_department_c,
   CASE
      WHEN wp.marital_status IS NULL
      AND at.marital_status = '1' THEN 1
      ELSE 0
   END AS marital_status,
   CASE
      WHEN wp.nationality IS NULL
      AND at.nationality = '1' THEN 1
      ELSE 0
   END AS nationality,
   CASE
      WHEN wo.work_email IS NULL
      AND at.work_email = '1' THEN 1
      ELSE 0
   END AS work_email,
   CASE
      WHEN sl.payroll_id IS NULL
      AND at.pay_code = '1' THEN 1
      ELSE 0
   END AS pay_code,
   CASE
      WHEN wo.management_level IS NULL
      AND at.management_level = '1' THEN 1
      ELSE 0
   END AS management_level,
   CASE
      WHEN sl.compensation_grade_profile IS NULL
      AND at.compensation_grade_profile = '1' THEN 1
      ELSE 0
   END AS compensation_grade_profile,
   CASE
      WHEN sl.salary_amount IS NULL
      AND at.salary_amount = '1' THEN 1
      ELSE 0
   END AS salary_amount,
   CASE
      WHEN sl.salary_frequency IS NULL
      AND at.salary_frequency = '1' THEN 1
      ELSE 0
   END AS salary_frequency,
   CASE
      WHEN py.iban IS NULL
      AND at.iban = '1' THEN 1
      ELSE 0
   END AS iban,
   CASE
      WHEN wp.country_of_birth IS NULL
      AND at.country_of_birth = '1' THEN 1
      ELSE 0
   END AS country_of_birth,
   CASE
      WHEN wo.store_id IS NULL
      AND at.store_id = '1' THEN 1
      ELSE 0
   END AS store_id,
   CASE
      WHEN py.pay_group IS NULL
      AND at.pay_group = '1' THEN 1
      ELSE 0
   END AS pay_groups,
   CASE
      WHEN py.bic IS NULL
      AND at.bic = '1' THEN 1
      ELSE 0
   END AS bic
FROM
   people_ops_proposed.il_worker_org wo
   INNER JOIN people_ops_proposed.il_worker_personal wp ON wo.employee_id = wp.employee_id
   INNER JOIN people_ops_proposed.il_worker_payroll py ON wo.employee_id = py.employee_id
   INNER JOIN people_ops_proposed.il_company_mapping cm ON wo.company_id = cm.company_id
   INNER JOIN people_ops_proposed.il_salary sl ON wo.employee_id = sl.employee_id
   LEFT JOIN people_ops_proposed.il_cc_hierarchy_latam hl ON hl.cost_center_id = wo.cost_center_id
   LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON cha.cost_center_id = wo.cost_center_id
   LEFT JOIN people_ops_proposed.il_athina_data_mapping at ON CONCAT(cm.brand, CM.country) = at.brand_country
WHERE
   wo.is_terminated = 0
   AND wo.worker_type <<>> 'Contingent Worker'
   AND cm.brand <<>> 'Woowa']]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
