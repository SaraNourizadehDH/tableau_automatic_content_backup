          <relationship>
            <expression op='='>
              <expression _.fcp.RelationshipCalculations.false...op='[brand+country]' _.fcp.RelationshipCalculations.true...op='[brand]+[country]' />
              <expression op='[brand_country]' />
            </expression>
            <first-end-point object-id='_7FD51D11B9974F6B9A11875F229D75E6' />
            <second-end-point object-id='il_athina_data_mapping_1C89919BD00E42E9BACF2683DBE00ED5' />
