              <calculation class='tableau' formula='IF [cost_center_id] &gt; 0 OR [work_email] &gt; 0 or [department_c] &gt; 0 or [sub_department_c] &gt; 0&#13;&#10;or [original_first_day_of_work] &gt; 0  or [store_id (consulta_sql_perso)] &gt; 0 or [business_title] &gt; 0&#13;&#10;or [management_level] &gt; 0&#13;&#10; THEN &apos;Error work information&apos; ELSE &apos;Accurate&apos; END' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1794965928744243200]' role='dimension' type='nominal'>
