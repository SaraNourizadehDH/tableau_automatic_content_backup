            <column caption='Department' datatype='string' name='[Calculation_1794965928744243200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company_name] = &quot;Delivery Hero SE&quot; THEN [central_department]&#13;&#10;ELSE [department]&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_1794965928745742338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [central_sub_department] = &quot;EU Regional Platform&quot; OR [central_sub_department] = &quot;EU Regional Dmart&quot; THEN &quot;Foodora&quot;&#13;&#10;ELSE [brand]&#13;&#10;END' />
            </column>
            <column caption='Picker/ Non Picker' datatype='string' name='[Calculation_1813261845074944000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [contract_type2] = &apos;Operational Worker - Fixed Term (Fixed Term)&apos; or [contract_type2] = &apos;Operational Worker - Permanent&apos;&#13;&#10;&#9;THEN &apos;Picker&apos;&#13;&#10;&#9;ELSE &apos;Non Picker&apos;&#13;&#10;&#9;end' />
            </column>
            <column caption='Number employees' datatype='integer' name='[Calculation_695806194624196615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [employee_id] &lt;&gt; &quot;&quot; then 1 ELSE 0 END' />
            </column>
            <column caption='Data Accurate %' datatype='real' name='[Calculation_772930330838097926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([Calculation_2016768252544860161])/([Total Errors (copia)_1541075544094519303]))' />
            </column>
            <column caption='Payroll Data Accurate' datatype='real' name='[Calculation_772930330882318353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM(IF [work information (copia)_2016768252577648653] = &apos;Payroll error information&apos; THEN 1 ELSE 0 END) / ([sum (payroll) (copia)_1541075544093700101]))' />
            </column>
            <column caption='Account Number (Il Athina Data Map)' datatype='integer' datatype-customized='true' name='[account_number (il_athina_data_map)]' role='dimension' type='ordinal'>
