      <column caption='MPP Y-Axis' datatype='string' name='[Calculation_982910638536507392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 19]=&quot;Head of Function&quot; then [Head of function] else [TA Lead] END' />
