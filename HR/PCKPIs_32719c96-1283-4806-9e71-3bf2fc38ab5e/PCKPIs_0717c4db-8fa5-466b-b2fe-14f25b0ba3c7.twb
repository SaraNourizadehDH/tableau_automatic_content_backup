      <aliases enabled='yes' />
      <column caption='c.gender abriged' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='c.last day of work' datatype='date' name='[Calculation_168040586320261124]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [last_day_of_work]&lt;&gt;&apos;&apos;&#10;THEN&#10;DATE([last_day_of_work])&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.review template proper' datatype='string' name='[Calculation_168040586407493646]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(Replace([review_template],&quot;  &quot;, &quot; &quot;))' />
      </column>
      <column caption='c.%high perf term' datatype='real' name='[Calculation_168040586411380753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id (il_termination)])/COUNTD([employee_id (il_performance)])' />
      </column>
      <column caption='Date-Filter' datatype='boolean' name='[Calculation_238690799810633728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[Position effective date])&#13;&#10;&lt;=&#13;&#10;DATETRUNC(&quot;month&quot;,DATEADD(&quot;month&quot;,3,DATETRUNC(&quot;month&quot;,Date)))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;DATETRUNC(&quot;month&quot;,[Position effective date])&#13;&#10;&gt;=&#13;&#10;DATETRUNC(&quot;month&quot;,DATEADD(&quot;month&quot;,0,DATETRUNC(&quot;month&quot;,Date)))' />
      </column>
      <column caption='MPP-Month' datatype='string' name='[Calculation_238690799810715649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Date])' />
      </column>
      <column caption='c.man level concat' datatype='string' name='[Calculation_5287225962611048448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([c.eoly (copy)_152840917877702686],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
      </column>
      <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5287225962611671041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs &amp; Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
      </column>
      <column caption='c.last updated' datatype='date' datatype-customized='true' name='[Calculation_6532400954434973716]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[last_updated])-1)' />
      </column>
      <column caption='c.delayed term' datatype='integer' name='[Calculation_808536886688792578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [termination_effective_date]-[Date Initiated]&lt;0 and [Business Process Type]=&quot;Terminaton&quot;&#10;then 1&#10;else&#10;0&#10;end' />
      </column>
      <column caption='c.late bpt' datatype='integer' name='[Calculation_808536886689267715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF TODAY()-[Date Initiated]&gt;14&#10;THEN&#10;1&#10;ELSE&#10;0&#10;END' />
      </column>
      <column caption='c.title check(wd v pr)' datatype='integer' name='[Calculation_808536886691299332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Title - PM]&lt;&gt; [business_title]&#10;THEN&#10;1&#10;ELSE&#10;0&#10;END' />
