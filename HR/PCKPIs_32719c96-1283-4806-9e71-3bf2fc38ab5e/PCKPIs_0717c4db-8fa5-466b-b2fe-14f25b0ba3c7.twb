          <datasource-dependencies datasource='federated.1naewwv0x04f801bsov700ng8c1j'>
            <column caption='c.gender abriged' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='c.last day of work' datatype='date' name='[Calculation_222646773662629893]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [last_day_of_work]&lt;&gt;&apos;&apos;&#10;THEN&#10;DATE([last_day_of_work])&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.eolm' datatype='string' name='[Calculation_222646773662801926]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[Calculation_222646773662629893])&lt;date([month])&#10;THEN&#10;NULL&#10;ELSE&#10;[employee_id]&#10;END' />
            </column>
            <column caption='c.upto eoLM' datatype='boolean' name='[Calculation_222646773662887943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([month])&lt;=(TODAY()-DAY(TODAY()))' />
            </column>
            <column caption='c.man level concat' datatype='string' name='[Calculation_5287225962611048448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Calculation_222646773662801926],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5287225962611671041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs &amp; Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_5287225962611048448],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
