            </properties>
          </object>
          <object caption='Workday dimension-Custom SQL' id='_8899F365521D4C08838498BD27A6ABFE'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='DATE(DATETRUNC(&apos;month&apos;,DATE([Custom SQL Query].[Report effecive date])))' />
                    <expression op='[Calendar1].[Snapshot time]' />
                  </expression>
                </clause>
                <relation connection='athena.0w9228h0jaf7gd19f6ac81hljfnc' name='Custom SQL Query' type='text'>select  wh.employee_id as &quot;Employee ID&quot; ,
case
	when wh.is_terminated=1 then &apos;No&apos;
	else &apos;Yes&apos;
	end as &quot;Worker Active&quot;,
	concat_ws(&apos; &apos;,wp.first_name,wp.last_name) as &quot;Full Name&quot;,
	wo.work_email as &quot;Email&quot;, 
	case
	when wh.is_people_manager=&apos;1&apos; then &apos;Yes&apos;
	else &apos;No&apos;
	end  as &quot;Is People Manager&quot; ,
m.managed_by as &quot;Manager ID&quot;,
m.managed_by_full_name as &quot;Manager Name&quot;,
	wh.business_title as &quot;Business Title&quot; , 
	wh.management_level as &quot;Level&quot; ,
	wh.office_location as &quot;Location&quot; ,
	wh.office_location_country as &quot;Country&quot; , 
	wh.department_wd as &quot;Department WD&quot; ,
	wh.sub_department_wd as &quot;Sub-department WD&quot; ,
	wh.first_day_of_work as &quot;First day of work&quot; , 
wh.last_day_of_work as &quot;Last day of work&quot; , 
	case
		when date_trunc(&apos;month&apos;,date(wh.first_day_of_work))=date_trunc(&apos;month&apos;,date(wh.report_effective_date)) then &apos;New Joiner&apos;
		else &apos;Employee&apos;
	end as &quot;New Joiner/Employee&quot;,
	case 
		when wh.management_level=&apos;M5&apos; or  wh.management_level=&apos;M6&apos; then &apos;Management&apos;
		else &apos;Other&apos; 
	end as &quot;Segment (Manager)&quot;,
	
	concat_ws(&apos; &apos;,m.manager_id_01,m.manager_id_02,m.manager_id_03,m.manager_id_04,m.manager_id_05,m.manager_id_06,m.manager_id_07,m.manager_id_08,m.manager_id_09,m.manager_id_10) as &quot;Manager ID concat&quot;, 
    CONCAT_WS(&apos;|&apos;,
        m.manager_01_full_name,
        m.manager_02_full_name,
        m.manager_03_full_name,
        m.manager_04_full_name,
        m.manager_05_full_name,
        m.manager_06_full_name,
        m.manager_07_full_name,
        m.manager_08_full_name,
        m.manager_09_full_name,
        m.manager_10_full_name
    ) as &quot;Manager Name concat&quot;,
    wh.report_effective_date as &quot;Report effecive date&quot;
   
	
from people_ops_proposed.il_worker_hist_with_current wh
left join 
(select w.employee_id as employee_id, w.work_email as work_email from people_ops_proposed.il_worker_org w) as wo
on wo.employee_id =wh.employee_id
LEFT JOIN 
    people_ops_proposed.il_manager_hist_with_current m
ON 
    m.employee_id = wh.employee_id and DATE_TRUNC(&apos;month&apos;, date(wh.report_effective_date))=DATE_TRUNC(&apos;month&apos;, date(m.report_effective_date))
    LEFT JOIN 
    people_ops_proposed.il_worker_personal wp
ON 
    wh.employee_id = wp.employee_id 
    
where wh.office_location_country=&apos;United Arab Emirates&apos;</relation>
                <relation connection='cloudfile:googledrive-excel-direct.1g20tdg0gt148e17gtken0byqawj' name='Calendar1' table='[Calendar$]' type='table'>
