        <column caption='HOF (WD)' datatype='string' name='[Calculation_891009050404462602]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2825&quot;)&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2806&quot;) or &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2822&quot;)&#9;&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-09-0177&quot;)&#10;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([Department WD]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Employee ID]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[Employee ID]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
        </column>
        <column caption='Office Location ID - filter' datatype='string' name='[Office Location ID (copy)_3150267985953853441]' role='dimension' type='nominal'>
