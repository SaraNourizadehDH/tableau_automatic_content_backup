            <column caption='Office Location ID - filter' datatype='string' name='[Office Location ID (copy)_3150267985953853441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS(lower([Calculation_1112740966091169792]),&apos;talabat hq&apos;)&#10;THEN&#10;&quot;B06&quot;&#10;ELSEif&#10;CONTAINS(lower([Calculation_1112740966091169792]),&apos;talabat local&apos;)&#10;THEN&#10;&quot;B03&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Report effecive date]' role='dimension' type='nominal' />
            <column datatype='string' name='[Sub-department WD]' role='dimension' type='nominal' />
