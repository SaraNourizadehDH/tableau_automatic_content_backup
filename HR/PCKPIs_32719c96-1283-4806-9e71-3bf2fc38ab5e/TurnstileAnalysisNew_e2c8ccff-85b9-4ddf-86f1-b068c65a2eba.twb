            <column caption='Avg. In-Office (Expected Days)-Adjusted' datatype='real' name='[In-Office (Expected Days)-Adjusted (copy)_1615596015932010496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ include [Employee ID]:[Calculation_2872663255560392734]}' />
