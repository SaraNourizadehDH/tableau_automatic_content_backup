            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Employee ID]' role='dimension' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[First day of work]' role='dimension' type='ordinal' />
            <column caption='Absence %' datatype='real' name='[In-Office % (copy)_6255499904330502150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6255499904328069121])/&#10;[Calculation_6255499905680277517]' />
