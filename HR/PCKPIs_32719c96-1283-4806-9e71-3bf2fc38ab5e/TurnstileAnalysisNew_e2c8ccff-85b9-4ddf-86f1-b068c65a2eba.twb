            <column datatype='string' name='[Department WD]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Employee ID]' role='dimension' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[First day of work]' role='dimension' type='ordinal' />
            <column caption='Avg. In-Office (Actual)' datatype='integer' name='[In-Office (Actual) (copy)_1615596015933825026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ include [Employee ID]:[Calculation_2872663255558582298]}' />
            </column>
            <column caption='Avg. In-Office (Actual/Expected)' datatype='real' name='[In-Office (Actual/Expected) (copy)_1615596015941746691]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='Min(1,Max(0,IFNULL(([In-Office (Actual) (copy)_1615596015933825026]/[In-Office (Expected Days)-Adjusted (copy)_1615596015932010496]),1)))' />
