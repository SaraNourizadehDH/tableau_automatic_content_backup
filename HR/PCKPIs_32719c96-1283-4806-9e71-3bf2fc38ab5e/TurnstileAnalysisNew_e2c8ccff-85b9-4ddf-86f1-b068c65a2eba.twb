            </column>
            <column datatype='string' name='[Report effecive date]' role='dimension' type='nominal' />
            <column datatype='string' name='[Sub-department WD]' role='dimension' type='nominal' />
            <column datatype='string' name='[Worker Active]' role='dimension' type='nominal' />
            <column caption='c.working days abr' datatype='date' name='[Working days (copy)_2872663255550840847]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Day-OFF (Calendar1)]=TRUE &#10;or [Calculation_2872663255501463552]=&quot;Sunday&quot;&#10;or [Calculation_2872663255501463552]=&quot;Saturday&quot;&#10;or [Calendar Date (Calendar1)]&lt;[First day of work]&#10;THEN&#10;NULL&#10;ELSE&#10;[Calendar Date (Calendar1)]&#10;END' />
            </column>
            <column datatype='real' datatype-customized='true' name='[approved_time_off]' role='dimension' type='ordinal' />
            <column caption='c.business trips abr' datatype='integer' name='[c.approved time off abr (copy)_2872663255538851853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([Days Count])=TRUE&#10;THEN&#10;0&#10;ELSE&#10;[Days Count]&#10;END' />
            </column>
            <column caption='Attendance % (bucket)' datatype='string' name='[c.attendance % filter (copy)_1930214658339938307]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1930214658337406977]=0&#10;THEN&#10;&quot;0%&quot;&#10;ELSEIF [Calculation_1930214658337406977]&lt;=0.25&#10;THEN&#10;&quot;1%-25%&quot;&#10;ELSEIF [Calculation_1930214658337406977]&lt;=0.5&#10;THEN&#10;&quot;26%-50%&quot;&#10;ELSEIF [Calculation_1930214658337406977]&lt;0.8&#10;THEN&#10;&quot;51%-79%&quot;&#10;ELSE&#10;&quot;80%+&quot;&#10;END' />
            </column>
            <column caption='c.cal date filter-2' datatype='boolean' name='[c.cal date filter (copy)_675047386563858433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calendar Date (Calendar1)]&gt;=DATE(&quot;2024-08-01&quot;)' />
            </column>
            <column caption='c.first day on leave' datatype='date' name='[c.last day on leave abr (copy)_2872663255552040977]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [first_day_on_leave]&gt;date(datetrunc(&apos;month&apos;,DATE([Report effecive date])))&#10;THEN&#10;[first_day_on_leave]&#10;ELSEif ISNULL([first_day_on_leave])=FALSE&#10;THEN&#10;date(datetrunc(&apos;month&apos;,DATE([Report effecive date])))&#10;END' />
