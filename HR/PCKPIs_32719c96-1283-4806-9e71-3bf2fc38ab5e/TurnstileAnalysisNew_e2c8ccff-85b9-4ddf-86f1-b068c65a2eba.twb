    <worksheet name='Department analysis (%)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4e78a7' fontsize='11'>Department Analysis (% AVG)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Turnstile data connection' name='federated.0zn8zu31ip5jr91few2jg0eaybqd' />
          </datasources>
          <datasource-dependencies datasource='federated.0zn8zu31ip5jr91few2jg0eaybqd'>
            <column caption='Approved Absence' datatype='real' name='[Approved time off (copy)_2872663255509921801]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Approved time off (copy)_2872663255553716244]+[Calculation_2872663255552626707]' />
            </column>
            <column caption='c.approved time off abr-2' datatype='integer' name='[Approved time off (copy)_2872663255553716244]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='zn(SUM([Calculation_2872663255509254152]))' />
            </column>
            <column caption='Avg. Business trip (days)' datatype='real' name='[Avg. Approved Absence (copy)_6255499904328458242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2872663255536156682]/COUNTD([Employee ID])' />
            </column>
            <column caption='Avg. WFH (Adjusted days)' datatype='real' name='[Avg. In-Office (Actual) (copy)_6255499904329220099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ include [Employee ID]:[Calculation_2872663255559471133]}' />
            </column>
            <column caption='In-Office %' datatype='real' name='[Avg. In-Office (Actual) (copy)_6255499904330153989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([In-Office % (copy)_6255499905681747982])/&#10;[Calculation_6255499905680277517]' />
            </column>
            <column caption='c.loc abr' datatype='string' name='[Calculation_1112740966091169792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([Correct Location])=FALSE&#10;THEN&#10;[Correct Location]&#10;ELSE&#10;[Location]&#10;END' />
            </column>
            <column caption='c.day of week' datatype='string' name='[Calculation_2872663255501463552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[Calendar Date (Calendar1)])' />
            </column>
            <column caption='c.in office' datatype='date' name='[Calculation_2872663255502344193]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Day-OFF (Calendar1)]=TRUE &#10;or [Calculation_2872663255501463552]=&quot;Sunday&quot;&#10;or [Calculation_2872663255501463552]=&quot;Saturday&quot;&#10;THEN&#10;NULL&#10;ELSE&#10;[DateStamp]&#10;END' />
            </column>
            <column caption='c.worker active during the month' datatype='string' name='[Calculation_2872663255507144708]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Worker Active]=&quot;Yes&quot;&#10;or datetrunc(&apos;month&apos;,date([Last day of work]))=datetrunc(&apos;month&apos;,date([Report effecive date]))&#10;or [Last day of work]=NULL&#10;THEN&#10;&quot;Active&quot;&#10;ELSE&#10;&quot;Not Active&quot;&#10;END' />
            </column>
            <column caption='c.approved time off abr' datatype='integer' name='[Calculation_2872663255509254152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([approved_time_off])=TRUE&#10;or [Calculation_2872663255501463552]=&quot;Sunday&quot;&#10;or [Calculation_2872663255501463552]=&quot;Saturday&quot;&#10;THEN&#10;0&#10;ELSE&#10;INT([approved_time_off])&#10;END' />
            </column>
            <column caption='Business trip days' datatype='integer' name='[Calculation_2872663255536156682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(SUM([c.approved time off abr (copy)_2872663255538851853]))' />
            </column>
            <column caption='c.last day on leave abr' datatype='date' name='[Calculation_2872663255551520784]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [last_day_on_leave]&gt;DATE([Report effecive date])&#10;THEN&#10;DATE([Report effecive date])&#10;ELSEif ISNULL([last_day_on_leave])=FALSE&#10;THEN&#10;[last_day_on_leave]&#10;END' />
            </column>
            <column caption='c.long leave abr' datatype='integer' name='[Calculation_2872663255552475154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF( &quot;week&quot;, [c.last day on leave abr (copy)_2872663255552040977],[Calculation_2872663255551520784] ) * 5 &#10;      - MAX( DATEPART( &quot;weekday&quot;, [c.last day on leave abr (copy)_2872663255552040977] ) - 2, 0 )&#10;       + MIN( DATEPART( &quot;weekday&quot;, [Calculation_2872663255551520784] ) - 1, 5 )' />
            </column>
            <column caption='Approved Long Leave ' datatype='real' name='[Calculation_2872663255552626707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(AVG([Calculation_2872663255552475154]))' />
            </column>
            <column caption='c.upto eocm' datatype='boolean' name='[Calculation_2872663255554961430]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEtrunc(&apos;month&apos;,date([Report effecive date]))&lt;=DATETRUNC(&apos;month&apos;,TODAY())' />
            </column>
            <column caption='c.cal date filter' datatype='boolean' name='[Calculation_2872663255557619735]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calendar Date (Calendar1)]&gt;=DATE(&quot;2023-10-01&quot;) and ISNULL([Day-OFF (Calendar1)] )=TRUE' />
            </column>
            <column caption='In-Office (Actual)' datatype='integer' name='[Calculation_2872663255558582298]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_2872663255502344193])' />
            </column>
            <column caption='WFH (Expected-Days)' datatype='integer' name='[Calculation_2872663255558832155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_891009050404462602]=&quot;Tech&quot; or &#10;[Calculation_891009050404462602]=&quot;Product&quot;&#10;or [Calculation_891009050404462602]=&quot;Tech &amp; Product&quot; &#10;THEN&#10;9&#10;ELSE&#10;4&#10;END' />
            </column>
            <column caption='WFH (Adjusted-Days)' datatype='real' name='[Calculation_2872663255559471133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(iif(&#10;(Iif(([Approved time off (copy)_2872663255509921801]+[Calculation_2872663255536156682])&lt;5,avg([Calculation_2872663255558832155]),&#10;(1-(([Approved time off (copy)_2872663255509921801]+[Calculation_2872663255536156682])/[Calculation_891009050405945355]))*avg([Calculation_2872663255558832155])))&lt;0,0,&#10;(Iif(([Approved time off (copy)_2872663255509921801]+[Calculation_2872663255536156682])&lt;5,avg([Calculation_2872663255558832155]),&#10;(1-(([Approved time off (copy)_2872663255509921801]+[Calculation_2872663255536156682])/[Calculation_891009050405945355]))*avg([Calculation_2872663255558832155]))))&#10;&#10;,0)' />
            </column>
            <column caption='In-Office (Expected Days)-Adjusted' datatype='real' name='[Calculation_2872663255560392734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0,([Calculation_891009050405945355]-[Approved time off (copy)_2872663255509921801]-[Calculation_2872663255536156682]-[Calculation_2872663255559471133]))' />
            </column>
            <column caption='c.exco filter' datatype='string' name='[Calculation_2872663257332576296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Manager ID]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;EXCO&quot;&#10;ELSE&#10;&quot;Other&quot;&#10;END' />
            </column>
            <column caption='c.hof filter' datatype='string' name='[Calculation_2872663257336827945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_891009050404462602]' />
            </column>
            <column caption='Avg. Approved Absence' datatype='real' name='[Calculation_6255499904328069121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Approved time off (copy)_2872663255509921801]/COUNTD([Employee ID])' />
            </column>
            <column caption='Avg. Not in Office (days)' datatype='real' name='[Calculation_6255499904341770250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_891009050405945355]-avg([In-Office % (copy)_6255499905681747982])-[Calculation_6255499904328069121]-[Avg. Approved Absence (copy)_6255499904328458242]-avg([Avg. In-Office (Actual) (copy)_6255499904329220099])' />
            </column>
            <column caption='Not in Offce vs WFH (% delta)' datatype='real' name='[Calculation_6255499904351256588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[In-Office % (copy)_6255499904330690568]-[Not in Office % (copy)_6255499904347635723]' />
            </column>
            <column caption='Avg. In off,abs,bus,wfh,no off' datatype='real' name='[Calculation_6255499905680277517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([In-Office % (copy)_6255499905681747982])+([Calculation_6255499904328069121])+[Avg. Approved Absence (copy)_6255499904328458242]+[Calculation_6255499904341770250]+AVG([Avg. In-Office (Actual) (copy)_6255499904329220099]))' />
            </column>
            <column caption='HOF (WD)' datatype='string' name='[Calculation_891009050404462602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2825&quot;)&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2806&quot;) or &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2822&quot;)&#9;&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-09-0177&quot;)&#10;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([Department WD]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[Employee ID],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[Employee ID]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[Employee ID]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='Working days' datatype='integer' name='[Calculation_891009050405945355]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Working days (copy)_2872663255550840847])' />
            </column>
            <column datatype='date' name='[Calendar Date (Calendar1)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Correct Location]' role='dimension' type='nominal' />
            <column datatype='date' name='[DateStamp]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[Day-OFF (Calendar1)]' role='dimension' type='nominal' />
