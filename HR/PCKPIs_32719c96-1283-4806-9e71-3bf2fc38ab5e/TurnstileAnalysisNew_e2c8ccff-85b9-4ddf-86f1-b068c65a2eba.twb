          <relation connection='athena.0w9228h0jaf7gd19f6ac81hljfnc' name='Custom SQL Query1' type='text'><![CDATA[SELECT 
    employee_id,
    time_off_type,
    date(time_off_date) as time_off_date,
day_of_time_off as day_of_time_off,
    SUM(CAST(approved_time_off AS double)) AS approved_time_off
FROM 
    people_ops_proposed.il_time_off 
    where  time_off_id<<>>''
GROUP BY 
    employee_id,
    time_off_type,
    date(time_off_date),day_of_time_off]]></relation>
