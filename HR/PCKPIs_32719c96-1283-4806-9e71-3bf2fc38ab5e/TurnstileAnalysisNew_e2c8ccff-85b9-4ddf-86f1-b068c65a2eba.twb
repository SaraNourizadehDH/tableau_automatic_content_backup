                <column datatype='integer' name='Calendar Month' ordinal='2' />
                <column datatype='integer' name='Calendar Year' ordinal='3' />
                <column datatype='boolean' name='Day-OFF' ordinal='4' />
                <column datatype='date' name='Snapshot time' ordinal='5' />
              </columns>
            </relation>
          </relation>
