              <calculation class='tableau' formula='&quot;# Starters&quot;' />
            </column>
            <column caption='Dimension to Display 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Systems&quot;'>
