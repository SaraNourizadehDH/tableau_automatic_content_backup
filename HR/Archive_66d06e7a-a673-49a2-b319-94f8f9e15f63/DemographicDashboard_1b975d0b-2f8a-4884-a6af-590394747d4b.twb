            <column caption='Avg Tenure (y)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4788593076219265028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_tenure] * ([actual] + [terminations_effective]))&#13;&#10;/&#13;&#10;SUM(([actual] + [terminations_effective]))' />
