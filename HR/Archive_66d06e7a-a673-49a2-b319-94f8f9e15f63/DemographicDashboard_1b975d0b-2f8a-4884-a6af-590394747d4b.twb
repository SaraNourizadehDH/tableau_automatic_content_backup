      <column caption='Şirketler' datatype='string' name='[Calculation_2968998090971668480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [company] = &quot;Banabi A.S.&quot; THEN &quot;Market&quot;&#10;ELSEIF [company] = &quot;Yemek Sepeti Elektronik İletişim Perakende Gıda Lojistik Anonim Şirketi&quot; THEN &quot;Yemeksepeti&quot;&#10;ELSEIF [company] = &quot;Yemek Sepeti Teknoloji ve Online Hizmetler Anonim Şirketi&quot; THEN &quot;YS Teknoloji&quot; &#10;ELSEIF [company] = &quot;Yemekpay&quot; THEN &quot;Yemekpay&quot;&#10;ELSE &quot;Saha&quot;&#10;END' />
      </column>
      <column caption='Saha/Merkez' datatype='string' name='[Calculation_2968998090975174659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_1132373832878227464]= &quot;Central Office&quot; THEN &quot;Merkez&quot;&#10;ELSE &quot;Saha&quot;&#10;END' />
