      <column caption='Workforce' datatype='string' name='[Calculation_1132373832878227464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [systems] = &apos;Bamboo&apos; THEN &apos;Field Ops&apos;&#13;&#10;ELSEIF [systems] = &apos;Workday&apos; AND CONTAINS([warehouse_office_location],&quot;Banabi&quot;) = TRUE THEN &apos;Field Ops&apos;&#13;&#10;ELSE &apos;Central Office&apos;&#13;&#10;END' />
