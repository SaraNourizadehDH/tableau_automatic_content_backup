          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Workforce' datatype='string' name='[Calculation_1132373832878227464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [systems] = &apos;Bamboo&apos; THEN &apos;Field Ops&apos;&#13;&#10;ELSEIF [systems] = &apos;Workday&apos; AND CONTAINS([warehouse_office_location],&quot;Banabi&quot;) = TRUE THEN &apos;Field Ops&apos;&#13;&#10;ELSE &apos;Central Office&apos;&#13;&#10;END' />
            </column>
            <column caption='Şirketler' datatype='string' name='[Calculation_2968998090971668480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company] = &quot;Banabi A.S.&quot; THEN &quot;Market&quot;&#10;ELSEIF [company] = &quot;Yemek Sepeti Elektronik İletişim Perakende Gıda Lojistik Anonim Şirketi&quot; THEN &quot;Yemeksepeti&quot;&#10;ELSEIF [company] = &quot;Yemek Sepeti Teknoloji ve Online Hizmetler Anonim Şirketi&quot; THEN &quot;YS Teknoloji&quot; &#10;ELSEIF [company] = &quot;Yemekpay&quot; THEN &quot;Yemekpay&quot;&#10;ELSE &quot;Saha&quot;&#10;END' />
            </column>
            <column caption='Saha/Merkez' datatype='string' name='[Calculation_2968998090975174659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_1132373832878227464]= &quot;Central Office&quot; THEN &quot;Merkez&quot;&#10;ELSE &quot;Saha&quot;&#10;END' />
            </column>
            <column caption='Avg Tenure (y)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4788593076219265028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_tenure] * ([actual] + [terminations_effective]))&#13;&#10;/&#13;&#10;SUM(([actual] + [terminations_effective]))' />
            </column>
            <column datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[actual]' role='measure' type='quantitative' />
