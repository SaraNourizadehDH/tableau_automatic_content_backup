          <refresh>
            <refresh-event add-from-file-path='Recruiter Performance KPIs' increment-value='%null%' refresh-type='create' rows-inserted='19447' timestamp-start='2025-01-27 11:46:05.918' />
          </refresh>
          <metadata-records>
            <metadata-record class='column'>
              <remote-name>date_month</remote-name>
