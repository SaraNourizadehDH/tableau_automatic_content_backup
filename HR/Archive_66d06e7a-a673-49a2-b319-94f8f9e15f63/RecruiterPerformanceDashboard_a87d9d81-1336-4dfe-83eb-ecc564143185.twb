		manager_02_full_name,
		manager_03_full_name,
		manager_04_full_name,
		manager_05_full_name,
		manager_06_full_name,
		manager_07_full_name
	) FULL
	OUTER JOIN talenthub_candidate_promoters USING (
		date_month,
		company_id,
		company,
		brand,
		department,
		sub_department,
		cost_center_id,
		cost_center_name,
