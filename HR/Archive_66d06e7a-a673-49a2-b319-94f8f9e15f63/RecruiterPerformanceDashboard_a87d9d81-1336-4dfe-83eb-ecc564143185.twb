      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON rc.cost_center_id = cha.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON rc.cost_center_id = cwd.cost_center_id
      LEFT JOIN worker_org wo ON jr.hiring_manager_email = wo.work_email
      LEFT JOIN recruiters r ON jr.recruiter = r.recruiter
      LEFT JOIN people_ops_proposed.il_manager m ON wo.employee_id = m.employee_id
   WHERE
