	recruiter,
	ta_manager,
	sourcer,
	coordinator,
	hiring_process_type,
	manager_02_full_name,
	manager_03_full_name,
	manager_04_full_name,
	manager_05_full_name,
	manager_06_full_name,
	manager_07_full_name,
	manager_08_full_name,
	interview_status,
	hiring_manager_id,
	initiated_by,
	interview_step,
	COALESCE(interview_events_scheduled, 0) AS interview_events_scheduled,
	COALESCE(interview_sessions_scheduled, 0) AS interview_sessions_scheduled,
	COALESCE(interview_events_planned, 0) AS interview_events_planned,
	COALESCE(interview_sessions_planned, 0) AS interview_sessions_planned,
	COALESCE(interview_sessions_with_feedback, 0) AS interview_sessions_with_feedback,
	current_date AS last_updated
FROM
	interviews_scheduled a FULL
	OUTER JOIN interviews_performed b USING(
		date,
		company_id,
		brand,
		company,
		department,
