      <column caption='Offered Position IDs' datatype='string' name='[Active-filled Position IDs (copy)_1130122048080924676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; &#13;&#10;or [TA-Hiring Status (MPP TA V1-import1)] = &apos;No Action&apos;)&#13;&#10;and &#13;&#10;YEAR([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]) = 2024&#13;&#10;THEN [Position Id (MPP TA V1-import1)]&#13;&#10; ELSE null END' />
      </column>
      <column caption='Hiring Counts/Position' datatype='integer' hidden='true' name='[Calculation1 (copy)_120752791347367936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Position Id (MPP TA V1-import1)] : COUNTD([Calculation_1497165423532646401]) }' />
      </column>
      <column caption='Vacant Position IDs' datatype='string' name='[Calculation_1130122048072908800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Status (MPP TA V1-import1)] = &apos;Vacant&apos; THEN [Position Id (MPP TA V1-import1)] ELSE null END' />
      </column>
      <column caption='Job Start Hiring Date' datatype='string' hidden='true' name='[Calculation_1169247118991831041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[HAD]' />
      </column>
      <column aggregation='CountD' caption='Distinct recruiter (offered/in progress)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1319273237372903425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; or [TA-Hiring Status (MPP TA V1-import1)] = &apos;Hiring in Progress&apos; THEN [TA-Recruiter (MPP TA V1-import1)] else null end' />
      </column>
      <column caption='TA-Recruiter (cleaned)' datatype='real' name='[Calculation_1319273237378224130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([TA-Recruiter (MPP TA V1-import1)] =&quot;Ada&quot;&#13;&#10;or [TA-Recruiter (MPP TA V1-import1)] =&quot;Ada &quot; then &apos;Ada&apos; &#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] = &quot;Amal&quot; then &apos;Amal&apos; &#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;&#13;&#10;Angel Pillai&#13;&#10;Aser Khairat&#13;&#10;Clarence&#13;&#10;Danny&#13;&#10;Dianne Porlares&#13;&#10;Fayza Hesham&#13;&#10;Gavin&#13;&#10;Glory Mathew&#13;&#10;Habiba&#13;&#10;Habiba Kassem&#13;&#10;Habiba Khalil&#13;&#10;Harsha Badlani&#13;&#10;James&#13;&#10;Kareem&#13;&#10;Kemi &#13;&#10;Kemi Johnson&#13;&#10;Kemi Johnson &#13;&#10;Leah&#13;&#10;Leah &#13;&#10;Lydia Raju&#13;&#10;Mae&#13;&#10;Mae Donia&#13;&#10;Maryse Kamel &#13;&#10;Mayar Amer&#13;&#10;Mohammed Seror&#13;&#10;Mohanad Elmaghraby&#13;&#10;Nada Fawzy&#13;&#10;Nada Sultan&#13;&#10;Natalia&#13;&#10;Niall&#13;&#10;Nora&#13;&#10;Reem AbdelAziz&#13;&#10;Reem Babiker&#13;&#10;Rita&#13;&#10;Sarah M&#13;&#10;Sarah P&#13;&#10;Sarah P &#13;&#10;Shaimaa&#13;&#10;Shereen Rashad&#13;&#10;Smridhi Chhabra&#13;&#10;Smridhi Chhabra &#13;&#10;tala&#13;&#10;Tala &#13;&#10;Tariq Ahmad&#13;&#10;TBC &#13;&#10;Yasmin Atef' />
      </column>
      <column caption='Offered/ recruiters count' datatype='real' name='[Calculation_1319273237386387459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Active-filled Position IDs (copy)_1130122048080924676])/ COUNTD([Calculation_1319273237372903425])' />
      </column>
      <column aggregation='CountD' caption='Current Active Positions' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226758021120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position Status (MPP TA V1-import1)] = &apos;Vacant&apos; or [Position Status (MPP TA V1-import1)] = &apos;Replacement&apos; or ([Position Status (MPP TA V1-import1)] = &apos;Active-Filled&apos; and ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos; OR [HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;)) then [Position Id (MPP TA V1-import1)] else null END' />
      </column>
      <column aggregation='CountD' caption='In Progress' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226770063362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=2024&#10;and ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&#10;and [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&lt;TODAY()&#10;then [Position Id (MPP TA V1-import1)] else NULL end' />
      </column>
      <column caption='to be worked on' datatype='integer' name='[Calculation_1409345226770972675]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([Calculation_1409345226771312644])+ COUNTD([Calculation_1409345226771488773])' />
      </column>
      <column aggregation='CountD' caption='Ready to hire new role' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771312644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column aggregation='CountD' caption='ready to hire replacement' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771488773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column aggregation='CountD' caption='Hold hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771656711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [HRBP Release (MPP TA V1-import1)] = &apos;Hold&apos; and ([TA Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos; or (ISNULL([TA Hiring Status (MPP TA V1-import1)]) =TRUE)) then [Position Id (MPP TA V1-import1)] else NULL end' />
      </column>
      <column caption='[Hold hrbp]+[No action hrbp]+[Ready to hire new role]+[ready ...' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226802589711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1409345226771656711]+[Hold hrbp (copy)_1409345226772717577]+[Calculation_1409345226771312644]+[Calculation_1409345226771488773]' />
      </column>
      <column caption='Position-status' datatype='string' hidden='true' name='[Calculation_1476617793469419521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Position status]' />
      </column>
      <column caption='Position ID' datatype='string' name='[Calculation_1517150147079258112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Id (MPP TA V1-import1)] = [Calculation_1409345226770063362]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Active-filled Position IDs (copy)_1130122048080924676]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Calculation_1409345226771312644]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Calculation_1409345226771488773]&#13;&#10; then [Position Id (MPP TA V1-import1)] ELSE null end' />
      </column>
      <column caption='c.position eff date filter' datatype='date' name='[Calculation_1636706642035941377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Position Effective From (MPP TA V1-import1)]' />
      </column>
      <column caption='Time to Hire' datatype='integer' name='[Calculation_1919377887368118272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)] - [Position Effective From (MPP TA V1-import1)]' />
      </column>
      <column caption='To be worked on %' datatype='real' name='[Calculation_1919377887369719809]' role='measure' type='quantitative'>
