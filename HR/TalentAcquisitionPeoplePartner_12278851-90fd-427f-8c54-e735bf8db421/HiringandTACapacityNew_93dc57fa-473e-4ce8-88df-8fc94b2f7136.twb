          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' field='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[:Measure Names]' value='49' />
            <format attr='width' field='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[yr:Position Effective From (MPP TA V1-import1):ok]' value='270' />
