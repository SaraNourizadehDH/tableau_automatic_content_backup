    <worksheet name='forcast roles-exc till Q3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='14'>TA Activity Assessor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MPP TA-V1-Tableau Input' name='federated.1ak5xlz1f0j2sp1c3mkec14vgba4' />
          </datasources>
          <datasource-dependencies datasource='federated.1ak5xlz1f0j2sp1c3mkec14vgba4'>
            <column caption='Offered Position IDs' datatype='string' name='[Active-filled Position IDs (copy)_1130122048080924676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; &#13;&#10;or [TA-Hiring Status (MPP TA V1-import1)] = &apos;No Action&apos;)&#13;&#10;and &#13;&#10;YEAR([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]) = 2024&#13;&#10;THEN [Position Id (MPP TA V1-import1)]&#13;&#10; ELSE null END' />
            </column>
            <column aggregation='CountD' caption='Distinct recruiter (offered/in progress)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1319273237372903425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; or [TA-Hiring Status (MPP TA V1-import1)] = &apos;Hiring in Progress&apos; THEN [TA-Recruiter (MPP TA V1-import1)] else null end' />
            </column>
            <column aggregation='CountD' caption='In Progress' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226770063362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=2024&#10;and ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&#10;and [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&lt;TODAY()&#10;then [Position Id (MPP TA V1-import1)] else NULL end' />
            </column>
            <column caption='to be worked on' datatype='integer' name='[Calculation_1409345226770972675]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_1409345226771312644])+ COUNTD([Calculation_1409345226771488773])' />
            </column>
            <column aggregation='CountD' caption='Ready to hire new role' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771312644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column aggregation='CountD' caption='ready to hire replacement' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771488773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column aggregation='CountD' caption='Hold hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771656711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [HRBP Release (MPP TA V1-import1)] = &apos;Hold&apos; and ([TA Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos; or (ISNULL([TA Hiring Status (MPP TA V1-import1)]) =TRUE)) then [Position Id (MPP TA V1-import1)] else NULL end' />
            </column>
            <column caption='c.to be worked on' datatype='string' name='[Calculation_6397785506303176704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos; or&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column caption='c.status filter' datatype='string' name='[Calculation_6397785506305818627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Position ID (copy)_1517150147082129409]' />
            </column>
            <column caption='c.ta activity assessor(exc hrbp hold+no action)' datatype='real' name='[Calculation_6765673298621304832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676]))/(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])+COUNTD([Calculation_1409345226771312644])+COUNTD([Calculation_1409345226771488773]))' />
            </column>
            <column caption='c.date field' datatype='date' name='[Calculation_8125267807000367110]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([Active-filled Position IDs (copy)_1130122048080924676])=FALSE&#10;THEN&#10;[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF isnull([Calculation_1409345226770063362])=FALSE&#10;THEN&#10;[TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF ISNULL([to be worked on (copy)_6185975586211946500])=FALSE&#10;THEN&#10;[Target Hire Month (MPP TA V1-import1)]&#10;else&#10;null&#10;END' />
            </column>
            <column caption='c.progress+offered' datatype='integer' name='[Calculation_8309563545884090368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( [Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])' />
            </column>
            <column caption='c.expected capacity (exc hold+no act)' datatype='real' name='[Calculation_8309563545884884993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6765673298621304832]*(365))/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today()))' />
            </column>
            <column caption='HR Department' datatype='string' name='[HR Department (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='HR Sub-Department' datatype='string' name='[HR Sub-Department (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='HRBP Release' datatype='string' name='[HRBP Release (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='Head of Function' datatype='string' name='[Head of Function (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='No action hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Hold hrbp (copy)_1409345226772717577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [HRBP Release (MPP TA V1-import1)] = &apos;No Action&apos; and ([Position Status (MPP TA V1-import1)]= &apos;Vacant&apos; or [Position Status (MPP TA V1-import1)]= &apos;Replacement&apos; or [TA-Hiring Status (MPP TA V1-import1)] =null) then [Position Id (MPP TA V1-import1)] else null end' />
            </column>
