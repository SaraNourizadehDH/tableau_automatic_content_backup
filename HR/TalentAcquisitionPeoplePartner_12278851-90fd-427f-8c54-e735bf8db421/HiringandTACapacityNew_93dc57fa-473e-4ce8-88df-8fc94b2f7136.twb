            <run fontname='Tableau Medium' fontsize='14'>TA Activity Assessor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MPP TA-V1-Tableau Input' name='federated.1ak5xlz1f0j2sp1c3mkec14vgba4' />
          </datasources>
          <datasource-dependencies datasource='federated.1ak5xlz1f0j2sp1c3mkec14vgba4'>
            <column caption='Offered Position IDs' datatype='string' name='[Active-filled Position IDs (copy)_1130122048080924676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; &#13;&#10;or [TA-Hiring Status (MPP TA V1-import1)] = &apos;No Action&apos;)&#13;&#10;and &#13;&#10;YEAR([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]) = 2024&#13;&#10;THEN [Position Id (MPP TA V1-import1)]&#13;&#10; ELSE null END' />
            </column>
            <column aggregation='CountD' caption='Distinct recruiter (offered/in progress)' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1319273237372903425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; or [TA-Hiring Status (MPP TA V1-import1)] = &apos;Hiring in Progress&apos; THEN [TA-Recruiter (MPP TA V1-import1)] else null end' />
            </column>
            <column aggregation='CountD' caption='In Progress' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226770063362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=2024&#10;and ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&#10;and [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&lt;TODAY()&#10;then [Position Id (MPP TA V1-import1)] else NULL end' />
            </column>
            <column caption='to be worked on' datatype='integer' name='[Calculation_1409345226770972675]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_1409345226771312644])+ COUNTD([Calculation_1409345226771488773])' />
            </column>
            <column aggregation='CountD' caption='Ready to hire new role' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771312644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column aggregation='CountD' caption='ready to hire replacement' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771488773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column aggregation='CountD' caption='Hold hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771656711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [HRBP Release (MPP TA V1-import1)] = &apos;Hold&apos; and ([TA Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos; or (ISNULL([TA Hiring Status (MPP TA V1-import1)]) =TRUE)) then [Position Id (MPP TA V1-import1)] else NULL end' />
            </column>
            <column caption='c.to be worked on' datatype='string' name='[Calculation_6397785506303176704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos; or&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column caption='c.status filter' datatype='string' name='[Calculation_6397785506305818627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Position ID (copy)_1517150147082129409]' />
            </column>
            <column caption='c.ta activity assessor(exc hrbp hold+no action)' datatype='real' name='[Calculation_6765673298621304832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676]))/(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])+COUNTD([Calculation_1409345226771312644])+COUNTD([Calculation_1409345226771488773]))' />
            </column>
            <column caption='c.date field' datatype='date' name='[Calculation_8125267807000367110]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([Active-filled Position IDs (copy)_1130122048080924676])=FALSE&#10;THEN&#10;[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF isnull([Calculation_1409345226770063362])=FALSE&#10;THEN&#10;[TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF ISNULL([to be worked on (copy)_6185975586211946500])=FALSE&#10;THEN&#10;[Target Hire Month (MPP TA V1-import1)]&#10;else&#10;null&#10;END' />
            </column>
            <column caption='c.progress+offered' datatype='integer' name='[Calculation_8309563545884090368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( [Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])' />
            </column>
            <column caption='c.expected capacity (exc hold+no act)' datatype='real' name='[Calculation_8309563545884884993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6765673298621304832]*(365))/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today()))' />
            </column>
            <column caption='HR Department' datatype='string' name='[HR Department (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='HR Sub-Department' datatype='string' name='[HR Sub-Department (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='HRBP Release' datatype='string' name='[HRBP Release (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='Head of Function' datatype='string' name='[Head of Function (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='No action hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Hold hrbp (copy)_1409345226772717577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [HRBP Release (MPP TA V1-import1)] = &apos;No Action&apos; and ([Position Status (MPP TA V1-import1)]= &apos;Vacant&apos; or [Position Status (MPP TA V1-import1)]= &apos;Replacement&apos; or [TA-Hiring Status (MPP TA V1-import1)] =null) then [Position Id (MPP TA V1-import1)] else null end' />
            </column>
            <column caption='Level' datatype='string' name='[Level (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='Location' datatype='string' name='[Location (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='Position Effective From' datatype='date' name='[Position Effective From (MPP TA V1-import1)]' role='dimension' type='ordinal' />
            <column aggregation='CountD' caption='Status' datatype='string' name='[Position ID (copy)_1517150147082129409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;[Position Id (MPP TA V1-import1)] = [Calculation_1409345226770063362] then &apos;In Progress&apos; &#13;&#10;elseif&#13;&#10;[Position Id (MPP TA V1-import1)] = [c.to be worked on (copy)_6882133572699602951] then &apos;Planned&apos; &#13;&#10;elseif ([Position Id (MPP TA V1-import1)] = [Calculation_6397785506303176704] )&#13;&#10;then &apos;Future planned Not activated&apos;&#13;&#10;ELSEif&#13;&#10; [Position Id (MPP TA V1-import1)] = [Active-filled Position IDs (copy)_1130122048080924676] then &apos;Offered&apos;&#13;&#10;&#13;&#10;&#13;&#10; ELSE null end' />
            </column>
            <column aggregation='CountD' caption='Position Id' datatype='string' name='[Position Id (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='Position Status' datatype='string' name='[Position Status (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column datatype='string' name='[SG&amp;A Flag (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column datatype='string' name='[TA Hiring Status (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column datatype='date' name='[TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]' role='dimension' type='ordinal' />
            <column caption='TA-Hiring Status' datatype='string' name='[TA-Hiring Status (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column caption='TA-Position/JR Closed Date (DD/MMM/YYYY)' datatype='date' name='[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]' role='dimension' type='ordinal' />
            <column caption='TA-Recruiter' datatype='string' name='[TA-Recruiter (MPP TA V1-import1)]' role='dimension' type='nominal' />
            <column datatype='date' name='[Target Hire Month (MPP TA V1-import1)]' role='dimension' type='ordinal' />
            <column caption='c.expected capacity (inc hold+no act)' datatype='real' name='[c.expected capacity (exc hold+no act) (copy)_8309563545886560258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([c.ta activity assessor(exc hrbp hold+no action) (copy)_6765673298622484482]*(365))/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today()))' />
            </column>
            <column caption='c.forcast-based on offered-till Q3' datatype='real' name='[c.forcast-based on offered-full yr (copy)_8309563546558676996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((COUNTD([Active-filled Position IDs (copy)_1130122048080924676])*&#10;datediff(&apos;day&apos;,today(),(MAKEDATE(2024,8,30)))&#10;)&#10;/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today())))' />
            </column>
            <column caption='c.f/c off exc in prog+TBW' datatype='real' name='[c.forcast-based on offered-till Q3 (copy)_8080020703080312846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[c.forcast-based on offered-full yr (copy)_8309563546558676996]-COUNTD([Calculation_1409345226770063362])-[Calculation_1409345226770972675]' />
            </column>
            <column caption='c.ta activity assessor(inc hrbp hold+no action)' datatype='real' name='[c.ta activity assessor(exc hrbp hold+no action) (copy)_6765673298622484482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676]))/(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])+[Calculation_1409345226770972675]+COUNTD([Calculation_1409345226771656711])+COUNTD([Hold hrbp (copy)_1409345226772717577]))' />
            </column>
            <column caption='c.ta planned' datatype='string' name='[c.to be worked on (copy)_6882133572699602951]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=2024&#10;and [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&gt;TODAY()&#10;and ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&#10;then [Position Id (MPP TA V1-import1)] else NULL end' />
            </column>
            <column-instance column='[Calculation_1319273237372903425]' derivation='CountD' name='[ctd:Calculation_1319273237372903425:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8125267807000367110]' derivation='Month' name='[mn:Calculation_8125267807000367110:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6397785506305818627]' derivation='None' name='[none:Calculation_6397785506305818627:nk]' pivot='key' type='nominal' />
            <column-instance column='[HR Department (MPP TA V1-import1)]' derivation='None' name='[none:HR Department (MPP TA V1-import1):nk]' pivot='key' type='nominal' />
            <column-instance column='[HR Sub-Department (MPP TA V1-import1)]' derivation='None' name='[none:HR Sub-Department (MPP TA V1-import1):nk]' pivot='key' type='nominal' />
            <column-instance column='[Head of Function (MPP TA V1-import1)]' derivation='None' name='[none:Head of Function (MPP TA V1-import1):nk]' pivot='key' type='nominal' />
            <column-instance column='[Level (MPP TA V1-import1)]' derivation='None' name='[none:Level (MPP TA V1-import1):nk]' pivot='key' type='nominal' />
            <column-instance column='[Position ID (copy)_1517150147082129409]' derivation='None' name='[none:Position ID (copy)_1517150147082129409:nk]' pivot='key' type='nominal' />
            <column-instance column='[SG&amp;A Flag (MPP TA V1-import1)]' derivation='None' name='[none:SG&amp;A Flag (MPP TA V1-import1):nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_8125267807000367110]' derivation='Quarter' name='[qr:Calculation_8125267807000367110:ok]' pivot='key' type='ordinal' />
            <column caption='to be worked on (copy)' datatype='string' name='[to be worked on (copy)_6185975586211946500]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([Calculation_1409345226771312644],&quot;&quot;)+&#10;IFNULL([Calculation_1409345226771488773],&quot;&quot;)' />
            </column>
            <column-instance column='[Calculation_6765673298621304832]' derivation='User' name='[usr:Calculation_6765673298621304832:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8309563545884090368]' derivation='User' name='[usr:Calculation_8309563545884090368:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8309563545884884993]' derivation='User' name='[usr:Calculation_8309563545884884993:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c.expected capacity (exc hold+no act) (copy)_8309563545886560258]' derivation='User' name='[usr:c.expected capacity (exc hold+no act) (copy)_8309563545886560258:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c.forcast-based on offered-till Q3 (copy)_8080020703080312846]' derivation='User' name='[usr:c.forcast-based on offered-till Q3 (copy)_8080020703080312846:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c.ta activity assessor(exc hrbp hold+no action) (copy)_6765673298622484482]' derivation='User' name='[usr:c.ta activity assessor(exc hrbp hold+no action) (copy)_6765673298622484482:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8125267807000367110]' derivation='Year' name='[yr:Calculation_8125267807000367110:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Position Effective From (MPP TA V1-import1)]' derivation='Year' name='[yr:Position Effective From (MPP TA V1-import1):ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:Calculation_8309563545884090368:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:c.ta activity assessor(exc hrbp hold+no action) (copy)_6765673298622484482:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:Calculation_6765673298621304832:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:c.expected capacity (exc hold+no act) (copy)_8309563545886560258:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:Calculation_8309563545884884993:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (Location (MPP TA V1-import1))]'>
            <groupfilter function='level-members' level='[Location (MPP TA V1-import1)]' user:ui-action-filter='[Action3_26EDD96BD52C4CE49F6B8EAB1CC4D8F2]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (Status)]'>
            <groupfilter function='level-members' level='[Position ID (copy)_1517150147082129409]' user:ui-action-filter='[Action8_E9F5C361067445D49BDCF0628316C748]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (YEAR(c.date field),QUARTER(c.date field))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action6_A24334BF309146DF9FD40908F0453B8D]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[yr:Calculation_8125267807000367110:ok]' />
              <groupfilter function='level-members' level='[qr:Calculation_8125267807000367110:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:Calculation_6397785506305818627:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_6397785506305818627:nk]' />
              <groupfilter function='member' level='[none:Calculation_6397785506305818627:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[:Measure Names]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:HR Department (MPP TA V1-import1):nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:HR Sub-Department (MPP TA V1-import1):nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:SG&amp;A Flag (MPP TA V1-import1):nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (Location (MPP TA V1-import1))]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:Level (MPP TA V1-import1):nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:Head of Function (MPP TA V1-import1):nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (YEAR(c.date field),QUARTER(c.date field))]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:Calculation_6397785506305818627:nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[none:Position ID (copy)_1517150147082129409:nk]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[Action (Status)]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[yr:Calculation_8125267807000367110:ok]</column>
            <column>[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[qr:Calculation_8125267807000367110:ok]</column>
