        <calculation class='tableau' formula='IF (&#10;[HRBP Release] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA Hiring Status]=&quot;No Action&quot; and &#10;(year([Calculation_6948280215220015106])&lt;&gt;2024 &#10;and (year([c.hiring approval date (copy)_6948280215220375555])&lt;&gt;2024 or&#10;ISNULL([c.hiring approval date (copy)_6948280215220375555]))&#10;or&#10;ISNULL([Calculation_6948280215220015106])=true)&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column caption='Hold hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771656711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([HRBP Release] = &apos;Hold&apos;) &#10;and ([TA Hiring Status] =&apos;No Action&apos; or (ISNULL([TA Hiring Status]) =TRUE)) &#10;then [Position ID]  else NULL end' />
      </column>
      <column caption='c.avg offered per month' datatype='integer' name='[Calculation_145733705248079872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE MONTH([Calculation_8125267807000367110]):COUNTD([Calculation_2960483459817734155])}' />
      </column>
      <column caption='c.upto eolm' datatype='boolean' name='[Calculation_145733705253634053]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_8125267807000367110]&lt;DATETRUNC(&apos;month&apos;,TODAY())' />
      </column>
      <column caption='c.choose metric' datatype='string' name='[Calculation_145733705254760454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=1&#10;THEN&#10;[HR Department]&#10;ELSEIF [Parameters].[Parameter 4]=2&#10;THEN&#10;[HR Sub-Department]&#10;ELSEIF [Parameters].[Parameter 4]=3&#10;then&#10;[Head of Function]&#10;ELSEIF [Parameters].[Parameter 4]=4&#10;THEN&#10;[Location]&#10;END' />
      </column>
      <column caption='c.pending ta review-details' datatype='string' name='[Calculation_1639662148033445888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&apos;Pending TA Review&apos;&#10;THEN&#10;(&#10;IF [TA Hiring Status]=&apos;Hiring In Progress&apos;&#10;THEN&#10;(if [HRBP Release]=&apos;Hold&apos; or [HRBP Release]=&apos;No Action&apos;&#10;THEN&#10;&apos;Hiring in Progress + HRBP Release = No Action/Hold&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Calculation_6948280215220015106]) &gt;DATETRUNC(&apos;month&apos;,TODAY())&#10;THEN&#10;&apos;Hiring in Progress + Future Activation date&apos;&#10;ELSE&#10;&apos;Hiring in Progress + No Activation date&apos;&#10;end)&#10;ELSEIF &#10;[TA Hiring Status]=&apos;Offered&apos;&#10;THEN&#10;&apos;Offered + No JR close date&apos;&#10;elseif&#10;[TA Hiring Status]=&apos;TA Planned - Not Activated&apos;&#10;THEN&#10;&#10;(if  DATETRUNC(&apos;month&apos;,[Calculation_6948280215220015106]) &lt;DATETRUNC(&apos;month&apos;,TODAY())&#10;THEN&#10;&apos;TA Planned + Past Activation date&apos;&#10;ELSE&#10;&apos;TA Planned + No Activation date&apos;&#10;end)&#10;&#10;ELSEIF &#10;[TA Hiring Status]=&apos;No Action&apos;&#10;THEN&#10;&apos;No Action + Activation date in 2024&apos;&#10;ELSE&#10;NULL&#10;END&#10;)&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.max c.date' datatype='datetime' name='[Calculation_175710794916442128]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ EXCLUDE [Calculation_8125267807000367110]:max([Calculation_8125267807000367110])}' />
      </column>
      <column caption='c.max c.date T/F' datatype='boolean' name='[Calculation_175710794916634641]' role='measure' type='nominal'>
        <calculation class='tableau' formula='QUARTER([Calculation_8125267807000367110])=QUARTER([Calculation_175710794916442128])' />
