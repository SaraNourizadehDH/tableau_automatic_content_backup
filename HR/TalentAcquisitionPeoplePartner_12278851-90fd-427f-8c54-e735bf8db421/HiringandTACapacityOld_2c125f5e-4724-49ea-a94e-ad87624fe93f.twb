              <calculation class='tableau' formula='if [c.f/c off exc in prog+TBW (copy)_1360438952819146753]&lt;0&#10;then&#10;&quot;Outside TA Capacity&quot;&#10;ELSE&#10;&quot;more within TA Capacity&quot;&#10;END' />
