          <filter class='categorical' column='[sqlproxy.1fviazg0fx9oao11kixyf0cufe02].[Action (Status,c.on hold-txt,c.No Action-txt,c.ready to hire -new-txt,c.ready to hire -replacement-txt )]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action9_88D773A654854745800EE1AA84C1E181]' user:ui-enumeration='all' user:ui-marker='enumerate'>
