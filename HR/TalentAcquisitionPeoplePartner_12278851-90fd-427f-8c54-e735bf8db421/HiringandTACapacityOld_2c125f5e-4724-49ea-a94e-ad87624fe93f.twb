            </column>
            <column caption='c.in prog+plan+Pending TA review' datatype='integer' name='[c.f/c off exc in prog+TBW (copy)_3455457207980748802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1409345226770063362])+COUNT([c.in progress (copy)_67694755596455939])+COUNTD([In Progress (copy)_7529948248181936135])+&#10;COUNTD([Calculation_6397785506303176704])' />
            </column>
            <column caption='c.Hire rate for remaining timeframe' datatype='real' name='[c.forcast-based on offered-full yr (copy)_8309563546558676996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF TODAY() &gt; DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, 1, MIN([Calculation_8125267807000367110])))) THEN&#10;    IFNULL(COUNTD([Active-filled Position IDs (copy)_1130122048080924676]), 0)&#10;ELSE&#10;    ROUND(&#10;        IFNULL(COUNTD([Active-filled Position IDs (copy)_1130122048080924676]), 0) *&#10;        (DATEDIFF(&apos;day&apos;, TODAY(), MIN([Calculation_3247658321619476481]))) /&#10;        NULLIF(SUM(DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;year&apos;, TODAY())), TODAY())), 0),&#10;        1&#10;    )&#10;END' />
            </column>
