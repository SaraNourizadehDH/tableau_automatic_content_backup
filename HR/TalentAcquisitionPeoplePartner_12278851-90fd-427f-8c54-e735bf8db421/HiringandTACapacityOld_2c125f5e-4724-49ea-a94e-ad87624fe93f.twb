              <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&apos;Pending TA Review&apos;&#10;THEN&#10;(&#10;IF [TA Hiring Status]=&apos;Hiring In Progress&apos;&#10;THEN&#10;(if [HRBP Release]=&apos;Hold&apos; or [HRBP Release]=&apos;No Action&apos;&#10;THEN&#10;&apos;Hiring in Progress + HRBP Release = No Action/Hold&apos;&#10;ELSEIF isnull([Calculation_6948280215220015106])=TRUE&#10;THEN&#10;&apos;Hiring in Progress + No Activation date&apos;&#10;ELSEIF YEAR([Calculation_6948280215220015106])&lt;&gt;2024&#10;THEN&#10;&apos;Hiring in Progress + Activation date not in 2024&apos;&#10;end)&#10;ELSEIF &#10;[TA Hiring Status]=&apos;Offered&apos;&#10;THEN&#10;&apos;Offered + No JR close date&apos;&#10;ELSEIF &#10;[TA Hiring Status]=&apos;No Action&apos;&#10;THEN&#10;(if isnull([Calculation_6948280215220015106])=FALSE and YEAR([Calculation_6948280215220015106])=2024&#10;THEN&#10;&apos;TA No Action + Activation date in 2024&apos;&#10;END)&#10;&#10;END&#10;)&#10;ELSE&#10;NULL&#10;END' />
            </column>
