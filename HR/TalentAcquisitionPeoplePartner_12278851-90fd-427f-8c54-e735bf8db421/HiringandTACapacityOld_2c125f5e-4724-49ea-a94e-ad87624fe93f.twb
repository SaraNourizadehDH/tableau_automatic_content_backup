        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.10gi7ty0yiijmf1cwibkg02ca3yi' name='Custom SQL Query' type='text'>SELECT 
    wo.office_location_country AS &quot;Office Location Country&quot;,
    CASE
        WHEN SUBSTRING(wo.cost_center_id, LENGTH(wo.cost_center_id) - 7, 8) IN (
            &apos;D05D0501&apos;, &apos;D05D0502&apos;, &apos;D05D0503&apos;, &apos;D05D0504&apos;, &apos;D05D0505&apos;, &apos;D05D0506&apos;, &apos;D05D0508&apos;,
            &apos;D05D0509&apos;, &apos;D05D0510&apos;, &apos;D05D0511&apos;, &apos;D06D0601&apos;, &apos;D06D0602&apos;, &apos;D06D0603&apos;, &apos;D06D0604&apos;,
            &apos;D07D0701&apos;, &apos;D07D0702&apos;, &apos;D07D0704&apos;, &apos;D07D0706&apos;, &apos;D08D0801&apos;, &apos;D09D0901&apos;, &apos;D09D0902&apos;,
            &apos;D09D0903&apos;, &apos;D09D0904&apos;, &apos;D09D0905&apos;, &apos;D10D1001&apos;, &apos;D11D1101&apos;, &apos;D11D1102&apos;, &apos;D11D1104&apos;,
            &apos;D11D1105&apos;, &apos;D11D1107&apos;, &apos;D11D1108&apos;, &apos;D11D1109&apos;, &apos;D11D1110&apos;, &apos;D12D1201&apos;, &apos;D12D1202&apos;,
            &apos;D12D1203&apos;, &apos;D13D1301&apos;, &apos;D13D1302&apos;, &apos;D14D1401&apos;, &apos;D15D1501&apos;, &apos;D16D1601&apos;, &apos;D16D1602&apos;,
            &apos;D17D1701&apos;, &apos;D17D1702&apos;, &apos;D20D2001&apos;, &apos;D20D2002&apos;, &apos;D20D2003&apos;
        ) THEN &apos;SG&amp;A&apos;
        ELSE &apos;Others&apos;
    END AS &quot;SG&amp;A flag&quot;,
    CASE 
        WHEN POSITION(&apos;2020-06-2823&apos; IN CONCAT_WS(&apos; &apos;, 
            m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
            m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
            m.manager_id_09, m.manager_id_10
        )) &gt;&gt; 0 THEN
            CASE
WHEN POSITION(&apos;2020-06-0247&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Q-commerce&apos;                
WHEN POSITION(&apos;2020-06-1616&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;COO&apos;
                WHEN POSITION(&apos;2020-01-0022&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;COO&apos;
                WHEN POSITION(&apos;2020-06-2813&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Tech&apos;
               
                WHEN POSITION(&apos;2020-06-2822&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Comms, Public Affairs and Sustainability&apos;
                WHEN POSITION(&apos;2020-06-2824&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Finance and Legal&apos;
                WHEN POSITION(&apos;2020-06-2830&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Product&apos;
                WHEN POSITION(&apos;2020-08-0133&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Product&apos;
               WHEN POSITION(&apos;2020-06-0158&apos; IN CONCAT_WS(&apos; &apos;, 
                    m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
                    m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
                    m.manager_id_09, m.manager_id_10
                )) &gt;&gt; 0 THEN &apos;Strategy and Innovation&apos;
