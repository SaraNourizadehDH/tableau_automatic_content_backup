      <column caption='c.# recruiters-forecast (exc hold+no act)-till Q3' datatype='real' name='[Calculation_6075989237586554893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[c.forcast-based on offered-full yr (copy)_8309563546558676996]/&#10;([Calculation_6075989237589114894])' />
      </column>
      <column caption='c.rem avg hires till Q3' datatype='real' name='[Calculation_6075989237589114894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_1319273237386387459]*(365*0.75))/&#10;(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today())))-[Calculation_1319273237386387459]' />
      </column>
      <column caption='c.to be worked on' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_6397785506303176704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([HRBP Release] = &apos;Ready to Hire-NewRole&apos; or[HRBP Release] = &apos;Ready to Hire-Replacement&apos;) and &#10;([TA Hiring Status]=&quot;No Action&quot; or ISNULL([TA Hiring Status])=TRUE) &#10;and&#10;(&#10;ISNULL([c.hiring approval date (copy)_6948280215220375555])=true&#10;or&#10;ISNULL([Calculation_6948280215220015106])=true)&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column caption='c.status exc count' datatype='string' name='[Calculation_6397785506305818627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Pending HRBP&quot; or ISNULL([Position ID (copy)_1517150147082129409])&#10;THEN&#10;NULL&#10;ELSE&#10;[Position ID (copy)_1517150147082129409]&#10;END' />
      </column>
      <column caption='c.TA segment' datatype='string' name='[Calculation_6402148400176119808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SG&amp;A Flag]=&quot;SG&amp;A&quot; and [HR Department]=&quot;Q-commerce&quot;&#10;THEN&#10;&quot;Q-comm + SG&amp;A&quot;&#10;ELSEIF [SG&amp;A Flag]&lt;&gt;&quot;SG&amp;A&quot; and [HR Department]=&quot;Q-commerce&quot;&#10;THEN&#10;&quot;Q-comm + Non-SG&amp;A&quot;&#10;ELSEIF &#10;CONTAINS([HR Sub-Department],&quot;SSC&quot;) or [HR Sub-Department]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;SSC + Dispatch&quot;&#10;ELSEIF [HR Department]=&quot;Tech&quot; &#10;or [HR Department]=&quot;Product&quot; or [HR Department]=&quot;Brands&quot;&#10;THEN&#10;&quot;Tech + Product&quot;&#10;ELSEif [SG&amp;A Flag]=&quot;SG&amp;A&quot; &#10;THEN&#10;&quot;SG&amp;A exc SSC, Dispatch &amp; TP&quot;&#10;ELSE&#10;&quot;Non-SG&amp;A exc SSC, Dispatch &amp; TP&quot;&#10;END' />
      </column>
      <column caption='c.expected hires/month' datatype='real' name='[Calculation_6406229757963190272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(SUM([monthly_KPI])/COUNTD([Name]),1)' />
      </column>
      <column caption='c.capcaity metric' datatype='string' name='[Calculation_6561955811247992834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=1&#10;THEN&#10;[Calculation_447685998408491011]&#10;ELSEIF [Parameters].[Parameter 6]=2&#10;THEN&#10;[Calculation_8047369634800402482]&#10;ELSEIF [Parameters].[Parameter 6]=3&#10;THEN&#10;[Calculation_447685998406533121]&#10;ELSEIF [Parameters].[Parameter 6]=6&#10;THEN&#10;&quot;Overall&quot;&#10;ELSEIF [Parameters].[Parameter 6]=5&#10;THEN&#10;[Level]&#10;ELSEIF [Parameters].[Parameter 6]=7&#10;THEN&#10;[Calculation_6402148400176119808]&#10;ELSEIF [Parameters].[Parameter 6]=8&#10;THEN&#10;[SG&amp;A Flag]&#10;END' />
      </column>
      <column caption='c.today' datatype='date' name='[Calculation_6573566639686631429]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='c.status tooltip' datatype='string' name='[Calculation_67694755606687756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;then&#10;&quot;TA Hiring Status=&apos;Offered&apos; or &apos;No Action&apos;, &#10;JR close date in 2024 and greater than activation date&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;In Progress&quot;&#10;THEN&#10;&quot;TA Hiring Status=&apos;Hiring in Progress&apos;, &#10;Activation date in 2024 and date prior to today&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Planned&quot;&#10;THEN&#10;&quot;TA Hiring Status=&apos;Hiring in Progress&apos;, &#10;Activation date in 2024 and date post today&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Future planned Not activated&quot;&#10;THEN&#10;&quot;HRBP Release=&apos;Ready to Hire-NewRole&apos; or &apos;Ready to Hire-Replacement&apos; and TA-Hiring Status=&apos;No Action&apos; and &#10;Activation date and JR close date is either blank or not in 2024&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Pending HRBP&quot;&#10;THEN&#10;&quot;HRBP Release=&apos;Hold&apos; or HRBP Release=&apos;No Action&apos; and Position Status is NOT cancelled and TA Hiring status is blank&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.cancelled filter' datatype='string' name='[Calculation_67694755986116642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Status]=&apos;Cancelled&apos; and YEAR([TA JR Closed Date])&lt;&gt;2024&#10;THEN&#10;&apos;exc&apos;&#10;ELSE&#10;&apos;ok&apos;&#10;END' />
      </column>
      <column caption='Target hire month-date' datatype='datetime' name='[Calculation_6948280214860394496]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&quot;dd.MMMM.yyyy&quot;,[Calculation_6948280214861578241])' />
      </column>
      <column caption='c.target hire month-parse' datatype='string' name='[Calculation_6948280214861578241]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;1.&quot;+str(LEFT([Target Hire Month],LEN([Target Hire Month])-5))+&quot;.&quot;+str(RIGHT([Target Hire Month],4))' />
      </column>
      <column caption='c.hiring approval date' datatype='date' name='[Calculation_6948280215220015106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if year([TA Hiring Approve Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;([TA Hiring Approve Date])&#10;END' />
      </column>
      <column caption='c.sub dept-COO' datatype='string' name='[Calculation_8047369634800402482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [HR Department]=&quot;COO&quot;&#10;THEN&#10;(&#10;IF contains([HR Sub-Department],&quot;SSC&quot;) or&#10;contains([HR Sub-Department],&quot;Dispatch&quot;)&#10;THEN&#10;&quot;COO - SSC &amp; Dispatch&quot;&#10;ELSE&#10;&quot;COO - Other&quot;&#10;END&#10;)&#10;ELSE&#10;[HR Department]&#10;END' />
      </column>
      <column caption='c.date field' datatype='datetime' name='[Calculation_8125267807000367110]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;THEN&#10;[c.hiring approval date (copy)_6948280215220375555]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;In Progress&apos; &#10;THEN&#10;[Calculation_6948280215220015106]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;Planned&apos;&#10;THEN&#10;[Calculation_6948280215220015106]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;Future planned Not activated&apos;&#10;THEN&#10;[Calculation_6948280214860394496]&#10;ELSEIF [Position ID (copy)_1517150147082129409]= &apos;Pending HRBP&apos; &#10;THEN&#10;[Calculation_6948280214860394496]&#10;ELSEIF [Position ID (copy)_1517150147082129409]= &apos;Pending TA Review&apos;&#10;THEN&#10;[Calculation_6948280214860394496]&#10;else&#10;null&#10;END' />
      </column>
      <column caption='c.in prog exc lead 30 days' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_8363536392422719494]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&quot;In Progress&quot;&#10;and MAKEDATE(2024,6,30)-[Calculation_8125267807000367110]&gt;30&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.closure %' datatype='real' name='[Calculation_8363536392423247879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2960483459817734155])/&#10;(COUNTD([Calculation_2960483459817734155])+COUNTD([Calculation_8363536392422719494]))' />
      </column>
      <column caption='c.h1,h2' datatype='string' name='[Calculation_8363536392423936009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if QUARTER([Calculation_8125267807000367110])&lt;=2&#10;THEN&#10;&quot;H1-&quot;+str(YEAR([Calculation_8125267807000367110]))&#10;ELSEIF QUARTER([Calculation_8125267807000367110])&gt;2 and QUARTER([Calculation_8125267807000367110])&lt;=4&#10;THEN&#10;&quot;H2-&quot;+str(YEAR([Calculation_8125267807000367110]))&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column caption='c.avg hires/rec/month' datatype='real' name='[Calculation_986499450413379585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Offered&quot; and YEAR([Calculation_8125267807000367110])=2024 and DATETRUNC(&apos;month&apos;,[Calculation_8125267807000367110])&lt;=DATETRUNC(&apos;month&apos;,TODAY())&#10;THEN&#10;round({include  DATETRUNC(&apos;month&apos;,[Calculation_8125267807000367110]),[Position ID (copy)_1517150147082129409]: COUNTd([Active-filled Position IDs (copy)_1130122048080924676])}/&#10;{ include  DATETRUNC(&apos;month&apos;,[Calculation_8125267807000367110]): COUNTD([TA Recruiter ])},1)&#10;&#10;ELSE&#10;NULL&#10;END' />
      </column>
