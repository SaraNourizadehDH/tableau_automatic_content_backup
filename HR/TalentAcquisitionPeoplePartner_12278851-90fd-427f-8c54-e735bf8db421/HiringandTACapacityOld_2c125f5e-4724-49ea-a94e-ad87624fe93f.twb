      <column caption='c.status filter' datatype='string' name='[Calculation_2960483459818995724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Position ID (copy)_1517150147082129409]' />
      </column>
      <column caption='c.%status ' datatype='real' name='[Calculation_2960483459935760397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Position ID (copy)_1517150147082129409]:COUNT([Position ID (copy)_1517150147082129409])}/[c.status exc count (copy)_2960483459938525198]' />
      </column>
      <column caption='c.qtr' datatype='date' name='[Calculation_3247658321619476481]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5]=1&#10;THEN&#10;(MAKEDATE(2024,9,30))&#10;ELSEIF [Parameters].[Parameter 5]=2&#10;then&#10;(MAKEDATE(2024,12,31))&#10;END' />
      </column>
      <column caption='c.location(country)' datatype='string' name='[Calculation_447685998406533121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Location]=&quot;BHR&quot;&#10;THEN&#10;&quot;Bahrain&quot;&#10;ELSEIF [Location]=&quot;EGY&quot;&#10;THEN&#10;&quot;Egypt&quot;&#10;ELSEIF [Location]=&quot;IRQ&quot;&#10;THEN&#10;&quot;Iraq&quot;&#10;ELSEIF [Location]=&quot;JOD&quot;&#10;THEN&#10;&quot;Jordan&quot;&#10;ELSEIF [Location]=&quot;KWT&quot;&#10;THEN&#10;&quot;Kuwait&quot;&#10;ELSEIF [Location]=&quot;OMN&quot;&#10;THEN&#10;&quot;Oman&quot;&#10;ELSEIF [Location]=&quot;QAT&quot;&#10;THEN&#10;&quot;Qatar&quot;&#10;ELSEIF [Location]=&quot;UAE&quot;&#10;THEN&#10;&quot;United Arab Emirates&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.level group (mpp ta)' datatype='string' name='[Calculation_447685998408491011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Level]=&quot;M3&quot;&#10;or&#10;[Level]=&quot;M4&quot;&#10;or&#10;[Level]=&quot;M5&quot;&#10;or&#10;[Level]=&quot;M6&quot;&#10;THEN&#10;&quot;M3+&quot;&#10;ELSEIF &#10;&#10;[Level]=&quot;IC4&quot;&#10;or&#10;[Level]=&quot;IC5&quot;&#10;or&#10;[Level]=&quot;M1&quot;&#10;or&#10;[Level]=&quot;M2&quot;&#10;THEN&#10;&quot;IC4-M2&quot;&#10;ELSE&#10;&quot;S1-IC3&quot;&#10;END' />
      </column>
      <column caption='c.date field-year' datatype='integer' name='[Calculation_447685998408929285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Calculation_8125267807000367110])' />
      </column>
      <column caption='c.simulated hires/rec/month' datatype='real' name='[Calculation_447685998425653259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1+[Parameters].[Parameter 7])*AVG([Calculation_986499450413379585])' />
      </column>
      <column caption='c.container' datatype='real' name='[Calculation_587649405220802565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1.3' />
