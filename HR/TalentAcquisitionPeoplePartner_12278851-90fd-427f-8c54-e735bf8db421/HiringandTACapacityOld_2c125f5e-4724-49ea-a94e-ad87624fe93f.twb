        <calculation class='tableau' formula='avg([Calculation_145733705248079872])- PREVIOUS_VALUE(0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.avg offer pos' datatype='real' name='[Calculation_2918684443292389380]' role='measure' type='quantitative'>
