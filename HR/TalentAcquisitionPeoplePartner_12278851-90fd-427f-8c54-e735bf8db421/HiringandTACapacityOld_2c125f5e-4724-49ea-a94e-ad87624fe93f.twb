            </column>
            <column caption='c.capcaity metric' datatype='string' name='[Calculation_6561955811247992834]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=1&#10;THEN&#10;[Calculation_447685998408491011]&#10;ELSEIF [Parameters].[Parameter 6]=2&#10;THEN&#10;[Calculation_8047369634800402482]&#10;ELSEIF [Parameters].[Parameter 6]=3&#10;THEN&#10;[Calculation_447685998406533121]&#10;ELSEIF [Parameters].[Parameter 6]=6&#10;THEN&#10;&quot;Overall&quot;&#10;ELSEIF [Parameters].[Parameter 6]=5&#10;THEN&#10;[Level]&#10;ELSEIF [Parameters].[Parameter 6]=7&#10;THEN&#10;[Calculation_6402148400176119808]&#10;ELSEIF [Parameters].[Parameter 6]=8&#10;THEN&#10;[SG&amp;A Flag]&#10;END' />
            </column>
            <column caption='c.sub dept-COO' datatype='string' name='[Calculation_8047369634800402482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [HR Department]=&quot;COO&quot;&#10;THEN&#10;(&#10;IF contains([HR Sub-Department],&quot;SSC&quot;) or&#10;contains([HR Sub-Department],&quot;Dispatch&quot;)&#10;THEN&#10;&quot;COO - SSC &amp; Dispatch&quot;&#10;ELSE&#10;&quot;COO - Other&quot;&#10;END&#10;)&#10;ELSE&#10;[HR Department]&#10;END' />
