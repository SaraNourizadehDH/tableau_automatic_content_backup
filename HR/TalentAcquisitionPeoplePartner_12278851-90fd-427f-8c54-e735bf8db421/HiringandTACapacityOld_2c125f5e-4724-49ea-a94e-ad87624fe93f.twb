                ELSE &apos;Unspecified&apos;
            END
        ELSE &apos;DHSE&apos;
    END AS &quot;Department_TB&quot;,
    wo.department_wd AS &quot;Department WD&quot;,
    wo.sub_department_wd AS &quot;Sub Department WD&quot;,
    wo.management_level AS &quot;Management Level&quot;,
    DATE_TRUNC(&apos;month&apos;, CAST(wo.last_day_of_work AS date)) AS &quot;Last Day of Work (Month)&quot;,
    SUM(wo.is_terminated) AS &quot;Total Attrition&quot;
FROM 
    people_ops_proposed.il_worker_org wo
LEFT JOIN 
    people_ops_proposed.il_manager m ON wo.employee_id = m.employee_id
GROUP BY
wo.office_location_country,
