              <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&apos;Pending TA Review&apos;&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Level]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Location]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='Status' datatype='string' name='[Position ID (copy)_1517150147082129409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10; [Position ID] = [Active-filled Position IDs (copy)_1130122048080924676] then &apos;Offered&apos;&#13;&#10; elseif&#13;&#10;[Position ID] = [Calculation_1409345226770063362] then &apos;In Progress&apos; &#13;&#10;&#13;&#10;elseif&#13;&#10;[Position ID] = [Calculation_2960483459810656256] then &apos;Pending HRBP&apos; &#13;&#10;elseif&#13;&#10;[Position ID] = [c.to be worked on (copy)_6882133572699602951] then &apos;Planned&apos; &#13;&#10;elseif ([Position ID] = [Calculation_6397785506303176704] )&#13;&#10;then&#13;&#10;&quot;HRBP Release- TA to Allocate&quot; &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;elseif&#13;&#10;[Calculation_1035616855789240321]=&quot;inc&quot;&#13;&#10;THEN&#13;&#10;&quot;Pending TA Review&quot;&#13;&#10; ELSE null end' />
              <aliases>
                <alias key='&quot;Future planned Not activated&quot;' value='HRBP release - TA to Allocate' />
                <alias key='&quot;Planned&quot;' value='Planned- Within TA Capacity' />
              </aliases>
            </column>
