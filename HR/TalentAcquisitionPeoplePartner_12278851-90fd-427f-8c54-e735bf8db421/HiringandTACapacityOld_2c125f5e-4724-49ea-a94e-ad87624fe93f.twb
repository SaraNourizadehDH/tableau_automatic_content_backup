              <calculation class='tableau' formula='IF &#10;[c.hiring approval date (copy)_6948280215220375555] &gt; [Calculation_6948280215220015106] and [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;THEN&#10;[c.hiring approval date (copy)_6948280215220375555] - [Calculation_6948280215220015106]&#10;ELSE&#10;NULL&#10;END' />
