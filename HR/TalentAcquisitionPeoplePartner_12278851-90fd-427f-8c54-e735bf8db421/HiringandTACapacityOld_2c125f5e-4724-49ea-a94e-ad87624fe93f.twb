    <worksheet name='level'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Medium'>Remaining Positions on MPP</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MPP TA Raw Data' name='sqlproxy.1fviazg0fx9oao11kixyf0cufe02' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.1fviazg0fx9oao11kixyf0cufe02'>
            <column aggregation='CountD' caption='Offered Position IDs' datatype='string' default-role='measure' default-type='quantitative' name='[Active-filled Position IDs (copy)_1130122048080924676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([TA Hiring Status] = &apos;Offered&apos; &#13;&#10;or [TA Hiring Status] = &apos;No Action&apos;)&#13;&#10;&#13;&#10;THEN [Position ID]&#13;&#10; ELSE null END' />
            </column>
            <column caption='c.position exclude' datatype='string' name='[Calculation_1035616855789240321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Position Status]=&quot;Active-Filled&quot; &#10;and&#10;[HRBP Release]=&quot;No Action&quot; and &#10;[TA Hiring Status]=&quot;No Action&quot; and&#10;(year([c.hiring approval date (copy)_6948280215220375555])&lt;&gt;2024 or ISNULL([c.hiring approval date (copy)_6948280215220375555])=TRUE))&#10;THEN&#10;&quot;exc&quot;&#10;ELSE&#10;&quot;inc&quot;&#10;END' />
            </column>
            <column caption='In Progress' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226770063362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;([TA Hiring Status]=&quot;Hiring In Progress&quot; and ([HRBP Release]&lt;&gt;&apos;Hold&apos; and [HRBP Release]&lt;&gt;&apos;No Action&apos;))&#10;&#10;and datetrunc(&apos;month&apos;,[Calculation_6948280215220015106])&lt;= DATETRUNC(&apos;month&apos;,today())&#10;&#10;&#10;then [Position ID] else NULL end' />
            </column>
            <column caption='to be worked on' datatype='integer' name='[Calculation_1409345226770972675]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([Calculation_1409345226771312644])+ COUNTD([Calculation_1409345226771488773])' />
            </column>
            <column caption='Ready to hire new role' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771312644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release] = &apos;Ready to Hire-NewRole&apos;&#10;) and [TA Hiring Status]=&quot;No Action&quot; and &#10;(year([Calculation_6948280215220015106])&lt;&gt;2024 &#10;and (year([c.hiring approval date (copy)_6948280215220375555])&lt;&gt;2024 or&#10;ISNULL([c.hiring approval date (copy)_6948280215220375555]))&#10;or&#10;ISNULL([Calculation_6948280215220015106])=true)&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column caption='ready to hire replacement' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771488773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;[HRBP Release] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA Hiring Status]=&quot;No Action&quot; and &#10;(year([Calculation_6948280215220015106])&lt;&gt;2024 &#10;and (year([c.hiring approval date (copy)_6948280215220375555])&lt;&gt;2024 or&#10;ISNULL([c.hiring approval date (copy)_6948280215220375555]))&#10;or&#10;ISNULL([Calculation_6948280215220015106])=true)&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column caption='c.pending ta review-details' datatype='string' name='[Calculation_1639662148033445888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&apos;Pending TA Review&apos;&#10;THEN&#10;(&#10;IF [TA Hiring Status]=&apos;Hiring In Progress&apos;&#10;THEN&#10;(if [HRBP Release]=&apos;Hold&apos; or [HRBP Release]=&apos;No Action&apos;&#10;THEN&#10;&apos;Hiring in Progress + HRBP Release = No Action/Hold&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Calculation_6948280215220015106]) &gt;DATETRUNC(&apos;month&apos;,TODAY())&#10;THEN&#10;&apos;Hiring in Progress + Future Activation date&apos;&#10;ELSE&#10;&apos;Hiring in Progress + No Activation date&apos;&#10;end)&#10;ELSEIF &#10;[TA Hiring Status]=&apos;Offered&apos;&#10;THEN&#10;&apos;Offered + No JR close date&apos;&#10;elseif&#10;[TA Hiring Status]=&apos;TA Planned - Not Activated&apos;&#10;THEN&#10;&#10;(if  DATETRUNC(&apos;month&apos;,[Calculation_6948280215220015106]) &lt;DATETRUNC(&apos;month&apos;,TODAY())&#10;THEN&#10;&apos;TA Planned + Past Activation date&apos;&#10;ELSE&#10;&apos;TA Planned + No Activation date&apos;&#10;end)&#10;&#10;ELSEIF &#10;[TA Hiring Status]=&apos;No Action&apos;&#10;THEN&#10;&apos;No Action + Activation date in 2024&apos;&#10;ELSE&#10;NULL&#10;END&#10;)&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.TA rec-wk' datatype='string' name='[Calculation_2576973829054001157]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]= &apos;In Progress&apos; or&#10;[Position ID (copy)_1517150147082129409]= &apos;Planned&apos; or&#10;[Position ID (copy)_1517150147082129409]= &quot;HRBP Release- TA to Allocate&quot; or&#10;[Position ID (copy)_1517150147082129409]= &quot;Pending TA Review&quot;&#10;THEN&#10;[TA Recruiter ]&#10;&#10; ELSE null end' />
            </column>
            <column caption='c.dept filter' datatype='string' name='[Calculation_2815664598252318728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[HR Department]' />
            </column>
            <column caption='c.pending HRBP' datatype='string' name='[Calculation_2960483459810656256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([HRBP Release] = &apos;Hold&apos;) &#10;and ([TA Hiring Status] =&apos;No Action&apos; or (ISNULL([TA Hiring Status]) =TRUE)) &#10;then [Position ID] &#10;ELSEIF &#10;[HRBP Release] = &apos;No Action&apos; and &#10;(([Position Status]= &apos;Vacant&apos; or [Position Status]= &apos;Replacement&apos;) and ((ISNULL([TA Hiring Status]) =TRUE) or[TA Hiring Status] =&apos;No Action&apos;) ) &#10;then [Position ID]&#10;else NULL &#10;end' />
            </column>
            <column caption='c.level group (mpp ta)' datatype='string' name='[Calculation_447685998408491011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Level]=&quot;M3&quot;&#10;or&#10;[Level]=&quot;M4&quot;&#10;or&#10;[Level]=&quot;M5&quot;&#10;or&#10;[Level]=&quot;M6&quot;&#10;THEN&#10;&quot;M3+&quot;&#10;ELSEIF &#10;&#10;[Level]=&quot;IC4&quot;&#10;or&#10;[Level]=&quot;IC5&quot;&#10;or&#10;[Level]=&quot;M1&quot;&#10;or&#10;[Level]=&quot;M2&quot;&#10;THEN&#10;&quot;IC4-M2&quot;&#10;ELSE&#10;&quot;S1-IC3&quot;&#10;END' />
            </column>
            <column caption='c.to be worked on' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_6397785506303176704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([HRBP Release] = &apos;Ready to Hire-NewRole&apos; or[HRBP Release] = &apos;Ready to Hire-Replacement&apos;) and &#10;([TA Hiring Status]=&quot;No Action&quot; or ISNULL([TA Hiring Status])=TRUE) &#10;and&#10;(&#10;ISNULL([c.hiring approval date (copy)_6948280215220375555])=true&#10;or&#10;ISNULL([Calculation_6948280215220015106])=true)&#10;THEN&#10;[Position ID]&#10;ELSE&#10;NULL&#10;end' />
            </column>
            <column caption='c.TA segment' datatype='string' name='[Calculation_6402148400176119808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [SG&amp;A Flag]=&quot;SG&amp;A&quot; and [HR Department]=&quot;Q-commerce&quot;&#10;THEN&#10;&quot;Q-comm + SG&amp;A&quot;&#10;ELSEIF [SG&amp;A Flag]&lt;&gt;&quot;SG&amp;A&quot; and [HR Department]=&quot;Q-commerce&quot;&#10;THEN&#10;&quot;Q-comm + Non-SG&amp;A&quot;&#10;ELSEIF &#10;CONTAINS([HR Sub-Department],&quot;SSC&quot;) or [HR Sub-Department]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;SSC + Dispatch&quot;&#10;ELSEIF [HR Department]=&quot;Tech&quot; &#10;or [HR Department]=&quot;Product&quot; or [HR Department]=&quot;Brands&quot;&#10;THEN&#10;&quot;Tech + Product&quot;&#10;ELSEif [SG&amp;A Flag]=&quot;SG&amp;A&quot; &#10;THEN&#10;&quot;SG&amp;A exc SSC, Dispatch &amp; TP&quot;&#10;ELSE&#10;&quot;Non-SG&amp;A exc SSC, Dispatch &amp; TP&quot;&#10;END' />
            </column>
            <column caption='c.cancelled filter' datatype='string' name='[Calculation_67694755986116642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Position Status]=&apos;Cancelled&apos; and YEAR([TA JR Closed Date])&lt;&gt;2024&#10;THEN&#10;&apos;exc&apos;&#10;ELSE&#10;&apos;ok&apos;&#10;END' />
            </column>
            <column caption='Target hire month-date' datatype='datetime' name='[Calculation_6948280214860394496]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPARSE(&quot;dd.MMMM.yyyy&quot;,[Calculation_6948280214861578241])' />
            </column>
            <column caption='c.target hire month-parse' datatype='string' name='[Calculation_6948280214861578241]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;1.&quot;+str(LEFT([Target Hire Month],LEN([Target Hire Month])-5))+&quot;.&quot;+str(RIGHT([Target Hire Month],4))' />
            </column>
            <column caption='c.hiring approval date' datatype='date' name='[Calculation_6948280215220015106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if year([TA Hiring Approve Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;([TA Hiring Approve Date])&#10;END' />
            </column>
            <column caption='c.date field' datatype='datetime' name='[Calculation_8125267807000367110]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;THEN&#10;[c.hiring approval date (copy)_6948280215220375555]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;In Progress&apos; &#10;THEN&#10;[Calculation_6948280215220015106]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;Planned&apos;&#10;THEN&#10;[Calculation_6948280215220015106]&#10;ELSEIF [Position ID (copy)_1517150147082129409]=&apos;Future planned Not activated&apos;&#10;THEN&#10;[Calculation_6948280214860394496]&#10;ELSEIF [Position ID (copy)_1517150147082129409]= &apos;Pending HRBP&apos; &#10;THEN&#10;[Calculation_6948280214860394496]&#10;ELSEIF [Position ID (copy)_1517150147082129409]= &apos;Pending TA Review&apos;&#10;THEN&#10;[Calculation_6948280214860394496]&#10;else&#10;null&#10;END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[HR Department]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[HR Sub-Department]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[HRBP Release]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Head of Function]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column datatype='string' name='[Level (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Level]' new-bin='true'>
                <bin default-name='false' value='&quot;IC3-M2&quot;'>
                  <value>&quot;IC3&quot;</value>
                  <value>&quot;IC4&quot;</value>
                  <value>&quot;IC5&quot;</value>
                  <value>&quot;M1&quot;</value>
                  <value>&quot;M2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M3+&quot;'>
                  <value>&quot;M3&quot;</value>
                  <value>&quot;M4&quot;</value>
                  <value>&quot;M5&quot;</value>
                  <value>&quot;M6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;S1-IC2&quot;'>
                  <value>&quot;IC1&quot;</value>
                  <value>&quot;IC2&quot;</value>
                  <value>&quot;Intern&quot;</value>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                  <value>&quot;S3&quot;</value>
                  <value>&quot;S4&quot;</value>
                </bin>
              </calculation>
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Level]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Location]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='Status' datatype='string' name='[Position ID (copy)_1517150147082129409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10; [Position ID] = [Active-filled Position IDs (copy)_1130122048080924676] then &apos;Offered&apos;&#13;&#10; elseif&#13;&#10;[Position ID] = [Calculation_1409345226770063362] then &apos;In Progress&apos; &#13;&#10;&#13;&#10;elseif&#13;&#10;[Position ID] = [Calculation_2960483459810656256] then &apos;Pending HRBP&apos; &#13;&#10;elseif&#13;&#10;[Position ID] = [c.to be worked on (copy)_6882133572699602951] then &apos;Planned&apos; &#13;&#10;elseif ([Position ID] = [Calculation_6397785506303176704] )&#13;&#10;then&#13;&#10;&quot;HRBP Release- TA to Allocate&quot; &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;elseif&#13;&#10;[Calculation_1035616855789240321]=&quot;inc&quot;&#13;&#10;THEN&#13;&#10;&quot;Pending TA Review&quot;&#13;&#10; ELSE null end' />
              <aliases>
                <alias key='&quot;Future planned Not activated&quot;' value='HRBP release - TA to Allocate' />
                <alias key='&quot;Planned&quot;' value='Planned- Within TA Capacity' />
              </aliases>
            </column>
            <column aggregation='CountD' datatype='string' default-type='nominal' layered='true' name='[Position ID]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Position Status]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[SG&amp;A Flag]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[TA Hiring Approve Date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[TA Hiring Status]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[TA JR Closed Date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[TA Mapping]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='CountD' datatype='string' default-type='nominal' layered='true' name='[TA Recruiter ]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Target Hire Month]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='c.TA active rec' datatype='string' name='[c.TA rec-wk (copy)_2576973829054738438]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [TA Recruiter ]in [c.TA rec-wk Set]&#10;THEN&#10;[TA Recruiter ]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.JR close date' datatype='date' name='[c.hiring approval date (copy)_6948280215220375555]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if year([TA JR Closed Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;([TA JR Closed Date])&#10;END' />
            </column>
            <column caption='c.on hold-txt' datatype='string' name='[c.on hold-nos (copy)_2960483459813507079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Pending HRBP&quot;&#10;THEN&#10;&quot;-Hold&quot;&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.No Action-txt' datatype='string' name='[c.on hold-txt (copy)_2960483459813568520]' role='dimension' type='nominal'>
