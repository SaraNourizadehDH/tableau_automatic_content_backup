            &apos;D12D1203&apos;, &apos;D13D1301&apos;, &apos;D13D1302&apos;, &apos;D14D1401&apos;, &apos;D15D1501&apos;, &apos;D16D1601&apos;, &apos;D16D1602&apos;,
            &apos;D17D1701&apos;, &apos;D17D1702&apos;, &apos;D20D2001&apos;, &apos;D20D2002&apos;, &apos;D20D2003&apos;
        ) THEN &apos;SG&amp;A&apos;
        ELSE &apos;Others&apos;
    END AS &quot;SG&amp;A flag&quot;,
    CASE 
        WHEN POSITION(&apos;2020-06-2823&apos; IN CONCAT_WS(&apos; &apos;, 
            m.manager_id_01, m.manager_id_02, m.manager_id_03, m.manager_id_04, 
            m.manager_id_05, m.manager_id_06, m.manager_id_07, m.manager_id_08, 
            m.manager_id_09, m.manager_id_10
        )) &gt;&gt; 0 THEN
            CASE
