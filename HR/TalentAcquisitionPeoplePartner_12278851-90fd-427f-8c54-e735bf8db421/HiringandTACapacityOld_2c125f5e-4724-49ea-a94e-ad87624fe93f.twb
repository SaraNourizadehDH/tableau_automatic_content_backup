            <column caption='c.qtr(attr qry)' datatype='date' name='[Calculation_447685998427267084]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5]=1&#10;THEN&#10;(date(&quot;2024-08-30&quot;))&#10;ELSEIF [Parameters].[Parameter 5]=2&#10;then&#10;(DATE(&quot;2024-11-30&quot;))&#10;END' />
