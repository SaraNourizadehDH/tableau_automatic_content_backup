          <datasource-dependencies datasource='federated.1coffxj1kgeieq1aiz8zs010c2rv'>
            <column caption='c.level(group-attr sql)' datatype='string' name='[Calculation_447685998407753730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Management Level]=&quot;M3&quot;&#10;or&#10;[Management Level]=&quot;M4&quot;&#10;or&#10;[Management Level]=&quot;M5&quot;&#10;or&#10;[Management Level]=&quot;M6&quot;&#10;THEN&#10;&quot;M3+&quot;&#10;ELSEIF &#10;&#10;[Management Level]=&quot;IC4&quot;&#10;or&#10;[Management Level]=&quot;IC5&quot;&#10;or&#10;[Management Level]=&quot;M1&quot;&#10;or&#10;[Management Level]=&quot;M2&quot;&#10;THEN&#10;&quot;IC4-M2&quot;&#10;ELSE&#10;&quot;S1-IC3&quot;&#10;END' />
            </column>
            <column caption='c.expected attr' datatype='real' name='[Calculation_447685998423228425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if TODAY()&gt;DATETRUNC(&apos;year&apos;,dateadd(&apos;year&apos;,1,[Last Day of Work (Month)]))-1&#10;THEN&#10;[Total Attrition]&#10;ELSE&#10;&#10;ifnull([Total Attrition],0)*&#10;DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),[Calculation_447685998427267084])/&#10;DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,TODAY()),TODAY())&#10;END' />
