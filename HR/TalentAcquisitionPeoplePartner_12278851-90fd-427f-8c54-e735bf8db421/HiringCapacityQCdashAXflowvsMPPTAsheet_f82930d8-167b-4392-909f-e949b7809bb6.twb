        <calculation class='tableau' formula='(IF &#10;[HRBP Release]&lt;&gt;&quot;Ready to Hire-NewRole&quot; and [HRBP Release]&lt;&gt;&quot;Ready to Hire-Replacement&quot;&#10;THEN&#10;&quot;HRBP Release is NOT &apos;Ready to Hire&apos;&quot;&#10;ELSEIF &#10;[Calculation_6590595895993495568]=&quot;TA Planned - Not Activated&quot;&#10;THEN&#10;&quot;TA-Hiring status on MPP sheet needs to be ammended to &apos;Hiring in Progress&apos;&quot;&#10;&#10;elseif DATEDIFF(&apos;day&apos;,TODAY(),[TA-Planned Joining Date])&lt;-15&#10;THEN&#10;&quot;Planned Joining date is more than 15 days in the past&quot;&#10;ELSEIF ISNULL([TA-Planned Joining Date])=TRUE&#10;THEN&#10;&quot;Planned Joining date is blank&quot;&#10;ELSEIF [Position Effective From]&gt;[TA-Planned Joining Date]&#10;then&#10;&quot;Planned Joining date is before Position effective date&quot;&#10;ELSE&#10;&quot;Edit made on MPP TA sheet after daily push to AX&quot;&#10;END&#10;)' />
      </column>
      <column caption='JR close date-reason-mpp sheet' datatype='string' name='[HAD date-reason-mpp sheet (copy)_1743526429692952578]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISNULL(attr([TA-Position/JR Closed Date (DD/MMM/YYYY)]))&#10;THEN&#10;(IF &#10;isnull(ATTR([sqlproxy.0f43rrx07d2ac31ch2nou1s29fxk].[Calculation_1867093941673922560]))&#10;THEN&#10;&quot;Edit made on MPP TA sheet after daily push to AX&quot;&#10;ELSE&#10;&quot;Data removals from MPP sheet are not updated on AX&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;Edit made on MPP TA sheet after daily push to AX&quot;&#10;END' />
      </column>
