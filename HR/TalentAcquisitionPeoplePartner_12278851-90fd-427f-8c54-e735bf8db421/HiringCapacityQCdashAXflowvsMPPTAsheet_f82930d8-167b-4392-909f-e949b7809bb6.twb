            <column caption='Mismatch reason' datatype='string' name='[Calculation_5782481238912389150]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF &#10;[HRBP Release]&lt;&gt;&quot;Ready to Hire-NewRole&quot; and [HRBP Release]&lt;&gt;&quot;Ready to Hire-Replacement&quot;&#10;THEN&#10;&quot;HRBP Release is NOT &apos;Ready to Hire&apos;&quot;&#10;&#10;&#10;elseif DATEDIFF(&apos;day&apos;,TODAY(),[Planned Joining Date])&lt;-15&#10;THEN&#10;&quot;Planned Joining date is more than 15 days in the past&quot;&#10;ELSEIF ISNULL([Planned Joining Date])=TRUE&#10;THEN&#10;&quot;Planned Joining date is blank&quot;&#10;ELSEIF [Position Effective From]&gt;[Planned Joining Date]&#10;then&#10;&quot;Planned Joining date is before Position effective date&quot;&#10;ELSE&#10;&quot;Edit made on MPP TA sheet after daily push to AX&quot;&#10;END&#10;)' />
