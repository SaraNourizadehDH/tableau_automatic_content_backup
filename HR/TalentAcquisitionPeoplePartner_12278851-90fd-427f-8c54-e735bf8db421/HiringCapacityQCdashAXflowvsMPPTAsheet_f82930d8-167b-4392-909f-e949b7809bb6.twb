      <column caption='c.hrbp release action date' datatype='datetime' name='[Calculation_1743526429668454400]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([HRBP Release Action Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;[HRBP Release Action Date]&#10;END' />
      </column>
      <column caption='TA JR Closed Date-AX' datatype='date' name='[Calculation_1867093941673922560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([TA JR Closed Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;[TA JR Closed Date]&#10;END' />
      </column>
      <column caption='c.pos status check' datatype='string' name='[Calculation_3713991999560192002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if ISNULL(ATTR([federated.0z2oe820yk43l712abkor0xrnmib].[Position Status]))&#10;THEN&#10;&quot;Position not on MPP TA sheet&quot;&#10;ELSEIF &#10;attr([Position Status])=(ATTR([federated.0z2oe820yk43l712abkor0xrnmib].[Position Status]))&#10;THEN&#10;&quot;OK&quot;&#10;ELSE&#10;&quot;Position Status-Mismatch&quot;&#10;END' />
      </column>
      <column caption='c,target hire month-parse' datatype='string' name='[Calculation_5436689226147491847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;1.&quot;+str(LEFT([Target Hire Month],LEN([Target Hire Month])-5))+&quot;.&quot;+str(RIGHT([Target Hire Month],4))' />
      </column>
      <column caption='Target Hire month-AX' datatype='date' datatype-customized='true' name='[Calculation_5436689226147545096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&quot;dd.MMMM.yyyy&quot;,[Calculation_5436689226147491847]))' />
      </column>
      <column caption='Hiring Approval date-AX' datatype='date' name='[Calculation_5693535142401368064]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([TA Hiring Approve Date])=1900&#10;THEN&#10;NULL&#10;ELSE&#10;[TA Hiring Approve Date]&#10;END' />
      </column>
      <column caption='Mismatch reason' datatype='string' name='[Calculation_5782481238912389150]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IF &#10;[HRBP Release]&lt;&gt;&quot;Ready to Hire-NewRole&quot; and [HRBP Release]&lt;&gt;&quot;Ready to Hire-Replacement&quot;&#10;THEN&#10;&quot;HRBP Release is NOT &apos;Ready to Hire&apos;&quot;&#10;&#10;&#10;elseif DATEDIFF(&apos;day&apos;,TODAY(),[Planned Joining Date])&lt;-15&#10;THEN&#10;&quot;Planned Joining date is more than 15 days in the past&quot;&#10;ELSEIF ISNULL([Planned Joining Date])=TRUE&#10;THEN&#10;&quot;Planned Joining date is blank&quot;&#10;ELSEIF [Position Effective From]&gt;[Planned Joining Date]&#10;then&#10;&quot;Planned Joining date is before Position effective date&quot;&#10;ELSE&#10;&quot;Edit made on MPP TA sheet after daily push to AX&quot;&#10;END&#10;)' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_5782481238914490399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,TODAY(),[Planned Joining Date])' />
      </column>
      <column caption='c.container' datatype='integer' name='[Calculation_623185649789452331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
