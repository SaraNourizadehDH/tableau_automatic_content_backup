      <column datatype='string' hidden='true' name='[Position Type-group]' role='dimension' type='nominal' />
      <column caption='Position status ' datatype='string' hidden='true' name='[Position status (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Position status]' new-bin='true'>
          <bin default-name='false' value='&quot;Hired/Offered&quot;'>
            <value>&quot;Active-Filled&quot;</value>
            <value>&quot;Offered&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Vacant&quot;'>
            <value>&quot;Replacement&quot;</value>
            <value>&quot;Vacant&quot;</value>
          </bin>
        </calculation>
