            </column>
            <column caption='c.forcast-based on offered-till Q3' datatype='real' name='[c.forcast-based on offered-full yr (copy)_8309563546558676996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF datediff(&apos;day&apos;,today(),(MAKEDATE(2024,8,30)))&gt;30&#10;then&#10;((COUNTD([Active-filled Position IDs (copy)_1130122048080924676])*&#10;datediff(&apos;day&apos;,today(),(MAKEDATE(2024,8,30)))&#10;)&#10;/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today())))&#10;ELSE&#10;0&#10;END' />
