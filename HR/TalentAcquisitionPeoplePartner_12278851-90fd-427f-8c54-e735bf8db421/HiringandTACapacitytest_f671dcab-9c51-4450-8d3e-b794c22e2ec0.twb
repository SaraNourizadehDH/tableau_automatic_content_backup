            <column caption='c.cap &lt;30 days till Q3 (T/F)' datatype='boolean' name='[c.cap &lt;30 days till Q3 (copy)_3455457207976361985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF datediff(&apos;day&apos;,today(),(MAKEDATE(2024,8,30)))&lt;30&#10;then&#10;TRUE&#10;ELSE&#10;FALSE&#10;END' />
            </column>
            <column caption='c.cap &lt;30 days till Q3' datatype='string' name='[c.forcast-based on offered-till Q3 (copy 2)_67694755654238237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF datediff(&apos;day&apos;,today(),(MAKEDATE(2024,8,30)))&lt;30&#10;then&#10;&quot;TA requires a lead time of 30 days from today to end of Q3 for hiring. Currently no capacity for hiring.&quot;&#10;ELSE&#10;&quot;exc&quot;&#10;END' />
