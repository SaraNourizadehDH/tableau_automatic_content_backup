        <calculation class='tableau' formula='IF [Position Status (MPP TA V1-import1)] = &apos;Active-Filled&apos; and ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos; or [HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos;) THEN [Position Id (MPP TA V1-import1)] ELSE null END' />
      </column>
      <column caption='Hired Positions Percentage' datatype='real' name='[Vacant Positions Percentage (copy)_1329969278393839617]' role='measure' type='ordinal'>
