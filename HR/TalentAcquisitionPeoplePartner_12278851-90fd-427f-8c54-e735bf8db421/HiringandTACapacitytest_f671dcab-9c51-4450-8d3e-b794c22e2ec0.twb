      <column caption='Offered Position IDs' datatype='string' name='[Active-filled Position IDs (copy)_1130122048080924676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; &#13;&#10;or [TA-Hiring Status (MPP TA V1-import1)] = &apos;No Action&apos;)&#13;&#10;and &#13;&#10;YEAR([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]) = 2024&#13;&#10;THEN [Position Id (MPP TA V1-import1)]&#13;&#10; ELSE null END' />
      </column>
      <column caption='Hiring Counts/Position' datatype='integer' hidden='true' name='[Calculation1 (copy)_120752791347367936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Position Id (MPP TA V1-import1)] : COUNTD([Calculation_1497165423532646401]) }' />
      </column>
      <column caption='Vacant Position IDs' datatype='string' name='[Calculation_1130122048072908800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Status (MPP TA V1-import1)] = &apos;Vacant&apos; THEN [Position Id (MPP TA V1-import1)] ELSE null END' />
      </column>
      <column caption='Job Start Hiring Date' datatype='string' hidden='true' name='[Calculation_1169247118991831041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[HAD]' />
      </column>
      <column aggregation='CountD' caption='Distinct recruiter (offered/in progress)' datatype='string' name='[Calculation_1319273237372903425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409] = &apos;Offered&apos; &#10;THEN [TA-Recruiter (MPP TA V1-import1)] else null end' />
      </column>
      <column caption='TA-Recruiter (cleaned)' datatype='real' name='[Calculation_1319273237378224130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([TA-Recruiter (MPP TA V1-import1)] =&quot;Ada&quot;&#13;&#10;or [TA-Recruiter (MPP TA V1-import1)] =&quot;Ada &quot; then &apos;Ada&apos; &#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] = &quot;Amal&quot; then &apos;Amal&apos; &#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;ELSEIF [TA-Recruiter (MPP TA V1-import1)] =&#13;&#10;&#13;&#10;Angel Pillai&#13;&#10;Aser Khairat&#13;&#10;Clarence&#13;&#10;Danny&#13;&#10;Dianne Porlares&#13;&#10;Fayza Hesham&#13;&#10;Gavin&#13;&#10;Glory Mathew&#13;&#10;Habiba&#13;&#10;Habiba Kassem&#13;&#10;Habiba Khalil&#13;&#10;Harsha Badlani&#13;&#10;James&#13;&#10;Kareem&#13;&#10;Kemi &#13;&#10;Kemi Johnson&#13;&#10;Kemi Johnson &#13;&#10;Leah&#13;&#10;Leah &#13;&#10;Lydia Raju&#13;&#10;Mae&#13;&#10;Mae Donia&#13;&#10;Maryse Kamel &#13;&#10;Mayar Amer&#13;&#10;Mohammed Seror&#13;&#10;Mohanad Elmaghraby&#13;&#10;Nada Fawzy&#13;&#10;Nada Sultan&#13;&#10;Natalia&#13;&#10;Niall&#13;&#10;Nora&#13;&#10;Reem AbdelAziz&#13;&#10;Reem Babiker&#13;&#10;Rita&#13;&#10;Sarah M&#13;&#10;Sarah P&#13;&#10;Sarah P &#13;&#10;Shaimaa&#13;&#10;Shereen Rashad&#13;&#10;Smridhi Chhabra&#13;&#10;Smridhi Chhabra &#13;&#10;tala&#13;&#10;Tala &#13;&#10;Tariq Ahmad&#13;&#10;TBC &#13;&#10;Yasmin Atef' />
      </column>
      <column caption='c.hired pos/rec/month' datatype='real' name='[Calculation_1319273237386387459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([Active-filled Position IDs (copy)_1130122048080924676])/ COUNTD([Calculation_1319273237372903425]))/&#10;((DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,TODAY()),TODAY()))/30)' />
      </column>
      <column caption='Manager' datatype='string' name='[Calculation_1358961212987092992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TA-Recruiter (MPP TA V1-import1)] = &apos;Tala&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Tala Helbaoui&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Leah&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Fayza&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Ada&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Ada Iriso Ivchenco&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Danny&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Nada Fawzy&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;James&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Nada Fawzy&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Angel&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mayar Amer&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Yasmin Atef&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Clarence&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Angel Pillai&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Clarence Domingo&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Danny Thomas&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Fayza Hesham&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Leah Fernandez&apos;&#13;&#10;THEN &apos;Danny&apos; &#13;&#10;ELSEIF &#13;&#10;   [TA-Recruiter (MPP TA V1-import1)] = &apos;Kemi&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Aser Khairat&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Glory&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Shaimaa&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Habiba&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Natalia&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Lydia&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mohanad&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Glory Mathew&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Kemi Johnson&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mohanad elmaghraby&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Natalia Dsousa&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Shaimaa Elsafty&apos;&#13;&#10;THEN &apos;Lydia&apos; &#13;&#10;ELSEIF &#13;&#10;   [TA-Recruiter (MPP TA V1-import1)] = &apos;Nora Mohamed&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Gavin&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Christianne&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Harsha&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mohammed Seror&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Smridhi Chhabra&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Dianne&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Bana&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Rita&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Kareem&apos; &#13;&#10;THEN&apos;Bana&apos; &#13;&#10;ELSEIF &#13;&#10;   [TA-Recruiter (MPP TA V1-import1)] = &apos;Reem Abdelaziz&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)]= &apos;Lydia Raju&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Marwa&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mae&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Genevieve&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Amal&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Niall&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Shereen Rashad&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Sarah Almazrouei&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Sarah P&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Maryse Kamel&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Nada Sultan&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Reem Babiker&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)]= &apos;Tariq Ahmad&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Amal Mussa&apos; &#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Harsha Badlani&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Mae Donia&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Niall Seweify&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Rita Fares&apos;&#13;&#10;OR [TA-Recruiter (MPP TA V1-import1)] = &apos;Sarah Philip&apos;&#13;&#10;THEN &apos;Genevieve&apos;&#13;&#10;ELSE &apos;Uncategorized&apos;&#13;&#10;END' />
      </column>
      <column aggregation='CountD' caption='Current Active Positions' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226758021120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position Status (MPP TA V1-import1)] = &apos;Vacant&apos; or [Position Status (MPP TA V1-import1)] = &apos;Replacement&apos; or ([Position Status (MPP TA V1-import1)] = &apos;Active-Filled&apos; and ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos; OR [HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;)) then [Position Id (MPP TA V1-import1)] else null END' />
      </column>
      <column aggregation='CountD' caption='In Progress' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226770063362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;([TA-Hiring Status (MPP TA V1-import1)]=&quot;Hiring in Progress&quot; and ([HRBP Release (MPP TA V1-import1)]&lt;&gt;&apos;Hold&apos; and [HRBP Release (MPP TA V1-import1)]&lt;&gt;&apos;No Action&apos;))&#10;and&#10;year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=2024&#10;and [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&lt;TODAY()&#10;&#10;&#10;then [Position Id (MPP TA V1-import1)] else NULL end' />
      </column>
      <column caption='to be worked on' datatype='integer' name='[Calculation_1409345226770972675]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([Calculation_1409345226771312644])+ COUNTD([Calculation_1409345226771488773])' />
      </column>
      <column aggregation='CountD' caption='Ready to hire new role' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771312644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column aggregation='CountD' caption='ready to hire replacement' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771488773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]))&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column aggregation='CountD' caption='Hold hrbp' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226771656711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([HRBP Release (MPP TA V1-import1)] = &apos;Hold&apos;) &#10;and ([TA-Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos; or (ISNULL([TA-Hiring Status (MPP TA V1-import1)]) =TRUE)) &#10;then [Position Id (MPP TA V1-import1)]  else NULL end' />
      </column>
      <column caption='[Hold hrbp]+[No action hrbp]+[Ready to hire new role]+[ready ...' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1409345226802589711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1409345226771656711]+[Hold hrbp (copy)_1409345226772717577]+[Calculation_1409345226771312644]+[Calculation_1409345226771488773]' />
      </column>
      <column caption='Position-status' datatype='string' hidden='true' name='[Calculation_1476617793469419521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Position status]' />
      </column>
      <column caption='Position ID' datatype='string' name='[Calculation_1517150147079258112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Id (MPP TA V1-import1)] = [Calculation_1409345226770063362]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Active-filled Position IDs (copy)_1130122048080924676]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Calculation_1409345226771312644]&#13;&#10;or [Position Id (MPP TA V1-import1)] = [Calculation_1409345226771488773]&#13;&#10; then [Position Id (MPP TA V1-import1)] ELSE null end' />
      </column>
      <column caption='c.hired per rec/month new' datatype='real' name='[Calculation_1621858841274789894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;THEN&#10;{include  DATETRUNC(&apos;month&apos;,[Calculation_8125267807000367110]),[Position ID (copy)_1517150147082129409]: COUNT([Position ID (copy)_1517150147082129409])}/&#10;[c.avg rec/month (copy)_1621858841275969544]&#10;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.position eff date filter' datatype='date' name='[Calculation_1636706642035941377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Position Effective From (MPP TA V1-import1)]' />
      </column>
      <column caption='Time to Hire' datatype='integer' name='[Calculation_1919377887368118272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)] - [Position Effective From (MPP TA V1-import1)]' />
      </column>
      <column caption='To be worked on %' datatype='real' name='[Calculation_1919377887369719809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_6397785506303176704])/(COUNTD([Calculation_6397785506303176704])+ COUNTD([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676]))' />
      </column>
      <column caption='Distinct recruiter %' datatype='real' name='[Calculation_1966102733896065024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1319273237372903425]) / 34' />
      </column>
      <column caption='c.pending HRBP' datatype='string' name='[Calculation_2960483459810656256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([HRBP Release (MPP TA V1-import1)] = &apos;Hold&apos;) &#10;and ([TA-Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos; or (ISNULL([TA-Hiring Status (MPP TA V1-import1)]) =TRUE)) &#10;then [Position Id (MPP TA V1-import1)] &#10;ELSEIF &#10;[HRBP Release (MPP TA V1-import1)] = &apos;No Action&apos; and &#10;(([Position Status (MPP TA V1-import1)]= &apos;Vacant&apos; or [Position Status (MPP TA V1-import1)]= &apos;Replacement&apos;) and ([TA-Hiring Status (MPP TA V1-import1)] =null or[TA-Hiring Status (MPP TA V1-import1)] =&apos;No Action&apos;) ) &#10;then [Position Id (MPP TA V1-import1)]&#10;else NULL &#10;end' />
      </column>
      <column caption='c.ready to hire replacement-nos' datatype='string' name='[Calculation_2960483459811717122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HRBP Release (MPP TA V1-import1)]=&quot;Ready to hire-Replacement&quot;&#10;THEN&#10;[Position ID (copy)_1517150147082129409]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column aggregation='Attribute' caption='c.status exc' datatype='integer' name='[Calculation_2960483459816407050]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ EXCLUDE [Position ID (copy)_1517150147082129409]:COUNT([Position ID (copy)_1517150147082129409])}' />
      </column>
      <column caption='c.offered' datatype='string' name='[Calculation_2960483459817734155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position Id (MPP TA V1-import1)] = [Active-filled Position IDs (copy)_1130122048080924676] &#10;THEN&#10;&quot;Offered&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.status filter' datatype='string' name='[Calculation_2960483459818995724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Position ID (copy)_1517150147082129409]' />
      </column>
      <column caption='c.%status ' datatype='real' name='[Calculation_2960483459935760397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Position ID (copy)_1517150147082129409]:COUNT([Position ID (copy)_1517150147082129409])}/[c.status exc count (copy)_2960483459938525198]' />
      </column>
      <column caption='c.ready to hir' datatype='string' name='[Calculation_3197977971284901907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&quot;Future planned Not activated&quot;&#10;THEN&#10;str(([Calculation_1409345226771312644])) +&quot;Ready to Hire-NewRole&quot;&#10;+str(([Calculation_1409345226771488773]))+&quot;   Ready to Hire-Replacement&quot;&#10;else&#10;NULL&#10;end' />
      </column>
      <column caption='c.container' datatype='integer' name='[Calculation_587649405220802565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='c.cap overflow sim-tooltip' datatype='string' name='[Calculation_587649405231034374]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [c.f/c off exc in prog+TBW (copy)_1360438952819146753]&lt;0&#10;then&#10;&quot;deficit&quot;&#10;ELSE&#10;&quot;additional roles available&quot;&#10;END' />
      </column>
      <column caption='c.# recruiters-forecast (exc hold+no act)-till Q3' datatype='real' name='[Calculation_6075989237586554893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[c.forcast-based on offered-full yr (copy)_8309563546558676996]/&#10;([Calculation_6075989237589114894])' />
      </column>
      <column caption='c.rem avg hires till Q3' datatype='real' name='[Calculation_6075989237589114894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_1319273237386387459]*(365*0.75))/&#10;(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today())))-[Calculation_1319273237386387459]' />
      </column>
      <column caption='c.to be worked on' datatype='string' name='[Calculation_6397785506303176704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-NewRole&apos; or&#10;[HRBP Release (MPP TA V1-import1)] = &apos;Ready to Hire-Replacement&apos;&#10;) and [TA-Hiring Status (MPP TA V1-import1)]=&quot;No Action&quot; and &#10;(year([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 &#10;and (year([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])&lt;&gt;2024 or&#10;ISNULL([TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;or&#10;ISNULL([TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)])=true)&#10;THEN&#10;[Position Id (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;end' />
      </column>
      <column caption='c.status exc count' datatype='string' name='[Calculation_6397785506305818627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position ID (copy)_1517150147082129409]=&quot;Pending HRBP&quot; or ISNULL([Position ID (copy)_1517150147082129409])&#10;THEN&#10;NULL&#10;ELSE&#10;[Position ID (copy)_1517150147082129409]&#10;END' />
      </column>
      <column caption='Total Available Positions' datatype='integer' name='[Calculation_648799845715566598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(countd([Calculation_1497165423532646401])+COUNTD([Calculation_511440048980029446]))'>
          <table-calc ordering-type='Rows' />
