      <column caption='Time to Hire (copy)' datatype='integer' name='[Time to Hire (copy)_7693625930192990210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)] &gt; [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;THEN&#10;[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)] - [TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSE&#10;NULL&#10;END' />
