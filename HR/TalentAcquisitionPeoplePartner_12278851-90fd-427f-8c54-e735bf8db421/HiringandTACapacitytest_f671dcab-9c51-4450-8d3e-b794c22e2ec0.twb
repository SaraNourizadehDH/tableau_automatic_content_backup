      <column caption='c.count pos st (copy)' datatype='string' name='[c.count pos st (copy)_7693625930190258177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull([Calculation_2960483459817734155],&quot;&quot;)+ifnull([c.offered (copy)_67694755596206082],&quot;&quot;)+ifnull([c.in progress (copy)_67694755596455939],&quot;&quot;)+ifnull([c.in progress (copy)_67694755596554244],&quot;&quot;)+ifnull([Calculation_2960483459810656256],&quot;&quot;)' />
