            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#4e79a7' fontsize='12'><![CDATA[<[federated.1ak5xlz1f0j2sp1c3mkec14vgba4].[usr:c.forcast-based on offered-till Q3 (copy)_8080020703078150157:qk]>]]></run>
                <run bold='true' fontcolor='#787878'> roles can be hired upto end of Q3 if the recruiter HC is </run>
                <run bold='true' fontcolor='#4e79a7' fontsize='12'>&lt;[Parameters].[Parameter 3]&gt; </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontsize='9'>Enter a recruiter Headcount value above to see what the expected capacity is. Current User input recruiter HC is </run>
