      </column>
      <column caption='c.rec hc for param' datatype='integer' name='[Calculation_6549781993534111756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [TA-Hiring Status (MPP TA V1-import1)] = &apos;Offered&apos; or [TA-Hiring Status (MPP TA V1-import1)] = &apos;Hiring in Progress&apos; THEN 1 else null end' />
      </column>
      <column caption='2023-Filter' datatype='boolean' hidden='true' name='[Calculation_671880791431471104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If(YEAR([Staff joining date])=2023 or Year([HAD])=2023) then True else False end' />
      </column>
      <column caption='c.ta activity assessor(exc hrbp hold+no action)' datatype='real' name='[Calculation_6765673298621304832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676]))/(countd([Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])+COUNTD([Calculation_1409345226771312644])+COUNTD([Calculation_1409345226771488773]))' />
      </column>
      <column caption='c.status tooltip' datatype='string' name='[Calculation_67694755606687756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Position ID (copy)_1517150147082129409]=&quot;Offered&quot;&#10;then&#10;&quot;TA Hiring Status=&apos;Offered&apos; or &apos;No Action&apos;, &#10;JR close date in 2024 and greater than activation date&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;In Progress&quot;&#10;THEN&#10;&quot;TA Hiring Status=&apos;Hiring in Progress&apos;, &#10;Activation date in 2024 and date prior to today&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Planned&quot;&#10;THEN&#10;&quot;TA Hiring Status=&apos;Hiring in Progress&apos;, &#10;Activation date in 2024 and date post today&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Future planned Not activated&quot;&#10;THEN&#10;&quot;HRBP Release=&apos;Ready to Hire-NewRole&apos; or &apos;Ready to Hire-Replacement&apos; and TA-Hiring Status=&apos;No Action&apos; and &#10;Activation date and JR close date is either blank or not in 2024&quot;&#10;elseif [Position ID (copy)_1517150147082129409]=&quot;Pending HRBP&quot;&#10;THEN&#10;&quot;HRBP Release=&apos;Hold&apos; or HRBP Release=&apos;No Action&apos; and Position Status is NOT cancelled and TA Hiring status is blank&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.user filter' datatype='boolean' name='[Calculation_67694755636371484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS(&quot;tomaso@talabat.com&#10;hannanordell@talabat.com&#10;jeremy.doutte@talabat.com&#10;kfaqsh@talabat.com&#10;stefano.vecchio@talabat.com&#10;susanne.stulemeijer@talabat.com&#10;sven.herzing@talabat.com&#10;tareq.barto@talabat.com&#10;wmakarem@talabat.com&#10;yiwei.ang@talabat.comkaavya.prakash@talabat.commelissa.costa@talabat.com&#10;sahar.aljaser@talabat.com&#10;mreveredo@talabat.com&#10;natasha.corbin@talabat.com&#10;shereen.shaaban@talabat.com&#10;sirin.seymen@talabat.comyacine.gaye@talabat.com&#10;natasha.corbin@talabat.com&#10;daniel.thomas@talabat.com&#10;genevieve.owens@talabat.com&#10;lydia.smith@talabat.com&#10;sirin.seymen@talabat.com&#10;diana.arango@talabat.com&#10;laith.alnairat@talabat.com&#10;laura.dillon@talabat.com&#10;lavin.hussein@talabat.com&#10;mariam.ramadan@talabat.com&#10;raid.al@talabat.com&#10;salma.hassan@talabat.com&#10;nora.abdelfattah@talabat.com&#10;yacine.gaye@talabat.com&#10;yumna.abuassali@talabat.com&#10;ebrahim.abdulla@talabat.com&#10;sahar.aljaser@talabat.com&#10;&quot;,USERNAME())&#10;THEN&#10;TRUE&#10;ELSE&#10;FALSE&#10;end' />
      </column>
      <column caption='c.cancelled filter' datatype='string' name='[Calculation_67694755986116642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position Status (MPP TA V1-import1)]=&apos;Cancelled&apos; and [Position ID (copy)_1517150147082129409]&lt;&gt;&apos;Offered&apos;&#10;THEN&#10;&apos;exc&apos;&#10;ELSE&#10;&apos;ok&apos;&#10;END' />
      </column>
      <column caption='c.PED=THD' datatype='boolean' name='[Calculation_7446702006857428998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;,[Position Effective From (MPP TA V1-import1)])=DATETRUNC(&apos;quarter&apos;,[Target Hire Month (MPP TA V1-import1)])' />
      </column>
      <column caption='c.count pos st' datatype='integer' name='[Calculation_7693625930189737984]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([Active-filled Position IDs (copy)_1130122048080924676])+COUNTD([Calculation_1409345226770063362])+[Calculation_1409345226770972675]+COUNTD([c.to be worked on (copy)_6882133572699602951])+[Calculation_77124164811726848]' />
      </column>
      <column caption='HBRP Pending ' datatype='integer' name='[Calculation_77124164811726848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1409345226771656711])+ COUNTD([Hold hrbp (copy)_1409345226772717577])' />
      </column>
      <column caption='Office/ Non Office %' datatype='real' name='[Calculation_7781586899446312973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1497165423532646401])/TOTAL(SUM([Calculation_1497165423532646401]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.null' datatype='boolean' name='[Calculation_8125267805230678016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='null' />
      </column>
      <column caption='c.date field' datatype='date' name='[Calculation_8125267807000367110]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([Active-filled Position IDs (copy)_1130122048080924676])=FALSE&#10;THEN&#10;[TA-Position/JR Closed Date (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF isnull([Calculation_1409345226770063362])=FALSE&#10;THEN&#10;[TA- H.A.D (DD/MMM/YYYY) (MPP TA V1-import1)]&#10;ELSEIF ISNULL([to be worked on (copy)_6185975586211946500])=FALSE&#10;THEN&#10;[Target Hire Month (MPP TA V1-import1)]&#10;else&#10;null&#10;END' />
      </column>
      <column caption='c.progress+offered' datatype='integer' name='[Calculation_8309563545884090368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [Calculation_1409345226770063362])+COUNTD([Active-filled Position IDs (copy)_1130122048080924676])' />
      </column>
      <column caption='c.expected capacity (exc hold+no act)' datatype='real' name='[Calculation_8309563545884884993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6765673298621304832]*(365))/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today()))' />
      </column>
      <column caption='c.orcast-based on offered-full yr' datatype='real' name='[Calculation_8309563546558349315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((COUNTD([Active-filled Position IDs (copy)_1130122048080924676])*(365))/(DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;year&apos;,today()),today())))-COUNTD([Active-filled Position IDs (copy)_1130122048080924676])' />
      </column>
      <column caption='Total Positions count' datatype='integer' hidden='true' name='[Calculation_967711036223123459]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CountD([Position Id (MPP TA V1-import1)])' />
      </column>
      <column caption='Hired Positions' datatype='integer' hidden='true' name='[Calculation_967711036223975428]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [Position status] in (&apos;Active-Filled&apos;,&apos;Offered&apos;) then 1 else 0 END' />
      </column>
