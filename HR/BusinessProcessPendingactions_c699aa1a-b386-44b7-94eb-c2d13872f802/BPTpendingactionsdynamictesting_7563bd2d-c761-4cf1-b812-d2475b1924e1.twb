      <column caption='Awaiting at? (person/team)' datatype='string' name='[Calculation_1640436183914864640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pending at_Final(segment)]=&quot;People Partner&quot; &#13;&#10;THEN&#10;[People Partner-Level 1]&#10;ELSE&#10;[Awaiting person-final]&#10;END' />
