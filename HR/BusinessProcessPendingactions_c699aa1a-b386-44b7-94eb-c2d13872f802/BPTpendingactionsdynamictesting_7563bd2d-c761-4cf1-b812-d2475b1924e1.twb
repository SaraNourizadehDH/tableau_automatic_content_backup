            <column caption='Initiated by?' datatype='string' name='[Awaiting at? (copy)_3765853738993025025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([bp_initiated_by],[employee_name]) &#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],[managed_by_full_name]) &#10;THEN&#10;&quot;Manager&quot;&#10;elseif CONTAINS([bp_initiated_by],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
            </column>
            <column caption='Awaiting at?' datatype='string' name='[Calculation_1361424115620986881]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([awaiting_persons],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([awaiting_persons],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[employee_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[managed_by_full_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Manager&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
