        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.152srce0k19klv1fdwacj0ihudza' name='TB-Guidelines BPT Pending Actio1' table='[&apos;TB-Guidelines BPT Pending Actio$&apos;]' type='table'>
          <columns gridOrigin='A1:G23:no:A1:G23:0' header='yes' outcome='2'>
            <column datatype='boolean' name='FALSE' ordinal='0' />
            <column datatype='string' name='F2' ordinal='1' />
            <column datatype='integer' name='Key' ordinal='2' />
            <column datatype='string' name='Title' ordinal='3' />
            <column datatype='string' name='Pending at' ordinal='4' />
            <column datatype='string' name='Pending at 2' ordinal='5' />
            <column datatype='string' name='Action:' ordinal='6' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='athena.175i5i41ol0w5l19rrc491qo10w8' name='Custom SQL Query' type='text'>
            <columns>
              <column datatype='date' date-parse-format='yyyy-MM-dd' name='last_updated' />
              <column datatype='date' date-parse-format='yyyy-MM-dd' name='bp_effective_date' />
              <column datatype='date' date-parse-format='yyyy-MM-dd' name='bp_initiated_date' />
            </columns>
SELECT
    il_bp_transaction_pending.bp_step_wd_id, 
	il_bp_transaction_pending.employee_id, 
	concat_ws(&apos; &apos;, il_worker_personal.first_name,  il_worker_personal.last_name) as employee_name,
	il_bp_transaction_pending.hr_analyst_at_current_date, 
	il_bp_transaction_pending.hr_partner_at_current_date, 
	il_bp_transaction_pending.bp_initiated_date, 
        il_bp_transaction_pending.bp_initiated_by, 
	il_bp_transaction_pending.bp_effective_date, 
	il_bp_transaction_pending.bp_name, 
	il_bp_transaction_pending.status, 
	il_bp_transaction_pending.awaiting_persons, 
	il_bp_transaction_pending.sent_back, 
	il_bp_transaction_pending.last_updated, 
	--LISTAGG(b.element,b3.l1_name1,b2.l1_name12, &apos;, &apos;) WITHIN GROUP (ORDER BY b.element) as level_1_final,
	LISTAGG(distinct(b.element), &apos;, &apos;) WITHIN GROUP (ORDER BY b.element) AS level_1,
    LISTAGG(distinct(b3.l1_name1), &apos;, &apos;) WITHIN GROUP (ORDER BY b3.l1_name1) AS level_1_1,
    LISTAGG(distinct(b2.l1_name12), &apos;, &apos;) WITHIN GROUP (ORDER BY b2.l1_name12) AS level_1_2,
    LISTAGG(distinct(b2.element), &apos;, &apos;) WITHIN GROUP (ORDER BY b2.element) AS level_2,
    LISTAGG(distinct(b3.l2_name2), &apos;, &apos;) WITHIN GROUP (ORDER BY b3.l2_name2) AS level_2_2,
    LISTAGG(distinct(b3.element), &apos;, &apos;) WITHIN GROUP (ORDER BY b3.element) AS level_3    
FROM
         people_ops_proposed.il_bp_transaction_pending
left JOIN people_ops_proposed.il_worker_personal  ON il_bp_transaction_pending.employee_id=il_worker_personal.employee_id       
LEFT JOIN
    (
        SELECT
            CONCAT(p2.first_name, &apos; &apos;, p2.last_name) AS element
        FROM
            people_ops_proposed.il_manager b
        LEFT JOIN
            people_ops_proposed.il_worker_personal ON b.employee_id = il_worker_personal.employee_id
        LEFT JOIN
            people_ops_proposed.il_worker_org ON b.employee_id = il_worker_org.employee_id
        LEFT JOIN
            people_ops_proposed.il_worker_personal p2 ON b.managed_by = p2.employee_id
        WHERE
            managed_by IN (
                SELECT employee_id
                FROM people_ops_proposed.il_manager
                WHERE managed_by_work_email = &apos;hannanordell@talabat.com&apos;
            )
            AND il_worker_org.is_terminated = 0
    ) b
ON
   il_bp_transaction_pending.hr_analyst_at_current_date LIKE CONCAT(&apos;%&apos;, b.element, &apos;%&apos;) 
LEFT JOIN
    (
        SELECT
            concat( il_worker_personal.first_name,&apos; &apos;, il_worker_personal.last_name) as element, (concat_ws(&apos; &apos;, p2.first_name,  p2.last_name)) as l1_name12
        FROM
            people_ops_proposed.il_manager b2
        LEFT JOIN
            people_ops_proposed.il_worker_personal ON b2.employee_id = il_worker_personal.employee_id
        LEFT JOIN
            people_ops_proposed.il_worker_org ON b2.employee_id = il_worker_org.employee_id
        LEFT JOIN
            people_ops_proposed.il_worker_personal p2 ON b2.managed_by = p2.employee_id
        WHERE
            managed_by IN (
                SELECT employee_id
                FROM people_ops_proposed.il_manager
                WHERE managed_by_work_email = &apos;hannanordell@talabat.com&apos;
            )
            AND il_worker_org.is_terminated = 0
    ) b2
ON
   il_bp_transaction_pending.hr_analyst_at_current_date LIKE CONCAT(&apos;%&apos;, b2.element, &apos;%&apos;) 
LEFT JOIN
    (
        SELECT  distinct(concat_ws(&apos; &apos;, p3.first_name,  p3.last_name)) as l1_name1,concat( il_worker_personal.first_name,&apos; &apos;, il_worker_personal.last_name) as l2_name2,CONCAT(p2.first_name, &apos; &apos;, p2.last_name) as element
		FROM people_ops_proposed.il_manager 
		left JOIN people_ops_proposed.il_worker_org  ON il_manager.employee_id=il_worker_org.employee_id 
		left JOIN people_ops_proposed.il_worker_personal  ON il_manager.employee_id=il_worker_personal.employee_id 
		left JOIN people_ops_proposed.il_manager  m2 ON il_manager.employee_id =m2.managed_by
		left JOIN people_ops_proposed.il_worker_personal p2 ON m2.employee_id =p2.employee_id 
		left JOIN people_ops_proposed.il_worker_personal p3 ON il_manager .managed_by =p3.employee_id 
		WHERE il_manager.managed_by  IN (select employee_id  from people_ops_proposed.il_manager 
		where managed_by_work_email =&apos;hannanordell@talabat.com&apos;) and il_worker_org.is_terminated=0
    ) b3
ON
   il_bp_transaction_pending.hr_analyst_at_current_date LIKE CONCAT(&apos;%&apos;, b3.element, &apos;%&apos;) 
where
      il_bp_transaction_pending.status=&apos;In Progress&apos;  
GROUP BY
    il_bp_transaction_pending.bp_step_wd_id, 
	il_bp_transaction_pending.employee_id, 
	il_bp_transaction_pending.hr_analyst_at_current_date, 
	il_bp_transaction_pending.hr_partner_at_current_date, 
	il_bp_transaction_pending.bp_initiated_date, 
        il_bp_transaction_pending.bp_initiated_by, 
	il_bp_transaction_pending.bp_effective_date, 
	il_bp_transaction_pending.bp_name, 
	il_bp_transaction_pending.status, 
	il_bp_transaction_pending.awaiting_persons, 
	il_bp_transaction_pending.sent_back, 
