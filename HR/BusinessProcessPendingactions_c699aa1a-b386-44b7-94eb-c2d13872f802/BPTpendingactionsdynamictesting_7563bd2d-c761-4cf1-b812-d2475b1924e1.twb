            <column caption='c.PP level 2-wk2' datatype='string' name='[c.PP level 1-wk2 (copy)_5359213188280983556]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(left([c.PP level 1-wk1 (copy)_5359213188280619011],1)=&quot;,&quot;,RIGHT([c.PP level 1-wk1 (copy)_5359213188280619011],len([c.PP level 1-wk1 (copy)_5359213188280619011])-2),&#10;IIF(right([c.PP level 1-wk1 (copy)_5359213188280619011],1)=&quot;,&quot;,left([c.PP level 1-wk1 (copy)_5359213188280619011],len([c.PP level 1-wk1 (copy)_5359213188280619011])-1),trim([c.PP level 1-wk1 (copy)_5359213188280619011])&#10;))' />
