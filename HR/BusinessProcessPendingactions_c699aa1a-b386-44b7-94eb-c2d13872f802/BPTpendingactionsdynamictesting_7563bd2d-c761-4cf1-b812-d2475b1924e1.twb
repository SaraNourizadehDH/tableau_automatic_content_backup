      <column caption='Action:1' datatype='string' name='[Action:]' role='dimension' type='nominal' />
      <column caption='c.awaiting at?' datatype='string' name='[Calculation_1361424115620986881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([awaiting_persons 1],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([awaiting_persons 1],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([awaiting_persons 1],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSEIF CONTAINS([awaiting_persons 1],[employee_name]) and NOT CONTAINS([awaiting_persons 1],&apos;;&apos;)&#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([awaiting_persons 1],[managed_by_full_name]) and NOT CONTAINS([awaiting_persons 1],&apos;;&apos;)&#10;THEN&#10;&quot;Manager&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
      </column>
      <column caption='c.backdated' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1361424115638034436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_initiated_date 1]&gt;[bp_effective_date 1]&#10;THEN&#10;&quot;Backdated&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.dept filter' datatype='string' name='[Calculation_1361424115639570437]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_734227489290911745]' />
