      <column caption='c.level 1-wk-1' datatype='string' name='[Calculation_5905063596345110541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Level 1],[c.hr A+-curr-abr final-1 (copy)_5905063596333916168])&#10;THEN&#10;[c.hr A+-curr-abr final-1 (copy)_5905063596333916168]&#10;ELSEIF CONTAINS([Level 1],[c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529])&#10;THEN&#10;[c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529]&#10;ELSEIF CONTAINS([Level 1],[c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586])&#10;THEN&#10;[c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586]&#10;&#10;ELSEif CONTAINS([Level 1],[c.hr A+-curr-abr wk-1-split -1 (copy)_5905063596350115857])&#10;THEN&#10;[c.hr A+-curr-abr wk-1-split -1 (copy)_5905063596350115857]&#10;ELSEIF CONTAINS([Level 1],[c.hr P+-curr-abr wk-1-split -1 (copy)_5905063596350218258])&#10;THEN&#10;[c.hr P+-curr-abr wk-1-split -1 (copy)_5905063596350218258]&#10;ELSEIF CONTAINS([Level 1],[c.hr P+-curr-abr wk-1-split -2 (copy)_5905063596350271507])&#10;THEN&#10;[c.hr P+-curr-abr wk-1-split -2 (copy)_5905063596350271507]&#10;&#10;ELSE&#10;&quot;&quot;&#10;END' />
