          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04vf1hw1xxwqjj13fbuj70b5u94g'>
            <column caption='Initiated by?' datatype='string' name='[Awaiting at? (copy)_3765853738993025025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([bp_initiated_by],[employee_name]) &#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],[managed_by_full_name]) &#10;THEN&#10;&quot;Manager&quot;&#10;elseif CONTAINS([bp_initiated_by],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
            </column>
            <column caption='Awaiting at?' datatype='string' name='[Calculation_1361424115620986881]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([awaiting_persons],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([awaiting_persons],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[employee_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[managed_by_full_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Manager&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
            </column>
            <column caption='c.dept filter-hanna view 2' datatype='string' name='[Calculation_1361424115639570437]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_734227489290911745]=&quot;People &amp; Culture&quot;&#10;THEN&#10;&quot;Hanna View&quot;&#10;ELSE&#10;&quot;PP View&quot;&#10;END' />
            </column>
            <column caption='c.bp name filter' datatype='string' name='[Calculation_1361424115639873542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bp_name]=&quot;Termination&quot; &#10;or [bp_name]=&quot;Submit Resignation&quot;&#10;THEN&#10;&quot;Hanna View&quot;&#10;ELSE&#10;&quot;PP View&quot;&#10;END' />
            </column>
            <column caption='c.PP level 1-wk1' datatype='string' name='[Calculation_5905063602432278551]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([c.PP level 1-wk1 (copy)_5359213188282826758]=&apos;&apos; or contains([c.PP level 1-wk1 (copy)_5359213188282826758],&apos;Natasha Corbin&apos;),[level_1_2],[c.PP level 1-wk1 (copy)_5359213188282826758])' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_734227489290911745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs &amp; Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.man level concat' datatype='string' name='[Calculation_734227489291042818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([employee_id],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
            </column>
