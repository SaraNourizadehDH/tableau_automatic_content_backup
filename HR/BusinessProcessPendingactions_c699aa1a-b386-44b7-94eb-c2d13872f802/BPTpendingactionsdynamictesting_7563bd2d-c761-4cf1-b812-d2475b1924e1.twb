              <calculation class='tableau' formula='IF [bp_name]=&quot;Termination&quot; &#10;or [bp_name]=&quot;Submit Resignation&quot;&#10;THEN&#10;&quot;Hanna View&quot;&#10;ELSE&#10;&quot;PP View&quot;&#10;END' />
