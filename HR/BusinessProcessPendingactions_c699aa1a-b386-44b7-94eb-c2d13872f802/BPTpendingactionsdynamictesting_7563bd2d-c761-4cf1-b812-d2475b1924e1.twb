          <named-connection caption='BPT-Guidelines-TB input[04 Sept&apos;23]' name='cloudfile:googledrive-excel-direct.152srce0k19klv1fdwacj0ihudza'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1RlhnzV-jNpBPt6Ytsi3Obmf7mfIkKM-P_cxWwDJMyfk' cloudFileMetadata_-_folder='1xC6TJd89w1Nna8KkPIKgdB6Cd27L3nWv' cloudFileName='BPT-Guidelines-TB input[04 Sept&apos;23].xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1RlhnzV-jNpBPt6Ytsi3Obmf7mfIkKM-P_cxWwDJMyfk/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='BPT-Guidelines-TB input[04 Sept&apos;23].xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='kaavya.prakash@talabat.com' validate='no' workgroup-auth-mode='prompt' />
