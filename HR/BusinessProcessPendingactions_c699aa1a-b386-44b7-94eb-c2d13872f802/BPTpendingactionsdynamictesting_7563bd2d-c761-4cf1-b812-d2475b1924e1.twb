        <objects>
          <object caption='TB-Guidelines BPT Pending Actio1' id='TB-Guidelines BPT Pending Actio_FC536B81541D40DF8B9FDF48C7B1D680'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.152srce0k19klv1fdwacj0ihudza' name='TB-Guidelines BPT Pending Actio1' table='[&apos;TB-Guidelines BPT Pending Actio$&apos;]' type='table'>
