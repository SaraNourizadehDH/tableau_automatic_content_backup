      <aliases enabled='yes' />
      <column datatype='integer' name='[# Awaiting persons]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.04vf1hw1xxwqjj13fbuj70b5u94g]&quot;' value='Awaiting at (person/team)' />
          <alias key='&quot;[federated.04vf1hw1xxwqjj13fbuj70b5u94g].[cnt:Calculation_1361424115638034436:qk]&quot;' value='# Backdated' />
          <alias key='&quot;[federated.04vf1hw1xxwqjj13fbuj70b5u94g].[usr:Calculation_849632233974145025:qk]&quot;' value='% Backdated' />
        </aliases>
      </column>
      <column caption='Initiated by?' datatype='string' name='[Awaiting at? (copy)_3765853738993025025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([bp_initiated_by],[employee_name]) &#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],[managed_by_full_name]) &#10;THEN&#10;&quot;Manager&quot;&#10;elseif CONTAINS([bp_initiated_by],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([bp_initiated_by],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([bp_initiated_by],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
      </column>
      <column caption='Awaiting at?' datatype='string' name='[Calculation_1361424115620986881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([awaiting_persons],&quot;Santhosh Sebastian&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Diab&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Ahmed Farouk&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Raphy Chiramel Chackochan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;SIVARANJANI CHANDRASEKARAN&quot;) &#10;THEN&#10;&quot;Cost Center&quot;&#10;ELSEIF CONTAINS([awaiting_persons],&quot;Melita Reveredo&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Diana Sinan&quot;) OR &#10;CONTAINS([awaiting_persons],&quot;Mansi Charan&quot;)&#10;THEN&#10;&quot;Rewards&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[employee_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Employee&quot;&#10;ELSEIF CONTAINS([awaiting_persons],[managed_by_full_name]) and NOT CONTAINS([awaiting_persons],&apos;;&apos;)&#10;THEN&#10;&quot;Manager&quot;&#10;ELSE&#10;&quot;Partner&quot;&#10;END' />
      </column>
      <column caption='c.full name' datatype='string' name='[Calculation_1361424115627085826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([first_name],&quot;&quot;)+IFNULL(&quot; &quot;+[middle_name],&quot;&quot;)+IFNULL(&quot; &quot;+[last_name],&quot;&quot;)' />
      </column>
      <column caption='c.backdated' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1361424115638034436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_initiated_date]&gt;[bp_effective_date]&#10;THEN&#10;&quot;Backdated&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.dept filter-hanna view 2' datatype='string' name='[Calculation_1361424115639570437]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_734227489290911745]=&quot;People &amp; Culture&quot;&#10;THEN&#10;&quot;Hanna View&quot;&#10;ELSE&#10;&quot;PP View&quot;&#10;END' />
      </column>
      <column caption='c.bp name filter' datatype='string' name='[Calculation_1361424115639873542]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_name]=&quot;Termination&quot; &#10;or [bp_name]=&quot;Submit Resignation&quot;&#10;THEN&#10;&quot;Hanna View&quot;&#10;ELSE&#10;&quot;PP View&quot;&#10;END' />
      </column>
      <column caption='c.tt-kick off color' datatype='string' name='[Calculation_1624955052095950849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([c.TT complete (copy)_3191081819263471626])&lt;0&#13;&#10;THEN&#13;&#10;&quot;Neg&quot;&#13;&#10;ELSE&#13;&#10;&quot;Pos&quot;&#13;&#10;END' />
      </column>
      <column caption='c.time pending' datatype='real' name='[Calculation_1628684608839684096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((today()-[bp_initiated_date])/7,0)' />
      </column>
      <column caption='c.awaiting_persons' datatype='string' name='[Calculation_1715097423897284608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([awaiting_persons],&apos;;&apos;,char(10))' />
      </column>
      <column caption='c.hr A+-curr-abr final' datatype='string' name='[Calculation_2383811624272691205]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(IIF([c.hr A+-curr-abr final-1 (copy)_5905063596333916168]&lt;&gt;&apos;&apos;,[c.hr A+-curr-abr final-1 (copy)_5905063596333916168],&apos;&apos;)+&#10;IIF([c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529]&lt;&gt;&apos;&apos;,&quot;, &quot;+[c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529],&apos;&apos;)+&#10;IIF([c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586]&lt;&gt;&apos;&apos;,&quot;, &quot;+[c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586],&apos;&apos;),&quot;  &quot;,&quot; &quot;)' />
      </column>
      <column caption='c.overall bp top 10' datatype='string' name='[Calculation_3156460397579804672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Overall bp Type Set top 10]&#13;&#10;THEN [Overall BP - BP Type]&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='c.view by 2' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Calculation_3156460397581348865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5]=1&#13;&#10;THEN&#13;&#10;[Calculation_3156460397579804672]&#13;&#10;ELSEIF [Parameters].[Parameter 5]=2&#13;&#10;THEN&#13;&#10;[Status (group)]&#13;&#10;ELSEIF [Parameters].[Parameter 5]=3&#13;&#10;THEN&#13;&#10;[Calculation_3191081819300532236]&#13;&#10;ELSEIF [Parameters].[Parameter 5]=4&#13;&#10;THEN&#13;&#10;Left(DATENAME(&apos;month&apos;,[Date Initiated 1]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Date Initiated 1])&#13;&#10;END' />
      </column>
      <column caption='c.#SB &gt;1' datatype='real' name='[Calculation_3156460397929721871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_3191081815805313026])/COUNT([Sent Back])' />
      </column>
      <column caption='c.send back count-comm' datatype='real' name='[Calculation_3191081815805313026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(LEN([All Accessible Comments])-LEN(REPLACE([All Accessible Comments], &quot;Send Back Reason&quot;, &quot;&quot;)))/LEN(&quot;Send Back Reason&quot;)' />
      </column>
      <column caption='c.# in progress' datatype='integer' name='[Calculation_3191081819260125191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Status 1]=&quot;In Progress&quot;&#13;&#10;THEN&#13;&#10;1&#13;&#10;END' />
      </column>
      <column caption='c.% in progress' datatype='real' name='[Calculation_3191081819260530696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_3191081819260125191])/COUNT([Status 1])' />
      </column>
      <column caption='c.country' datatype='string' name='[Calculation_3191081819300532236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Country 1]&lt;&gt;&quot;&quot;&#13;&#10;THEN&#13;&#10;[Country 1]&#13;&#10;ELSE&#13;&#10;[Candidate Location Country]&#13;&#10;END' />
      </column>
      <column caption='c.%tasks sent back' datatype='real' name='[Calculation_3191081819698819104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Sent Back])/COUNT([Status 1])' />
      </column>
      <column caption='Pending since (WD report pulled on-Task Initiated date)' datatype='string' name='[Calculation_3590213356799320064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([Calculation_734227491422236681]-[Date Initiated])+&quot; days&quot;' />
      </column>
      <column caption='c. view callout' datatype='string' name='[Calculation_374713585421873154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if USERNAME()=&apos;hannanordell@talabat.com&apos;&#10;or USERNAME()=&apos;kaavya.prakash@talabat.com&apos;&#10;or USERNAME()=&apos;yacine.gaye@talabat.com&apos;&#10;or USERNAME()=&apos;kassim.kara@talabat.com&apos;&#10;THEN&#10;&apos;&apos;&#10;ELSE&#10;&quot;P&amp;C population, Resignations and Terminations are excluded&quot;&#10;END' />
      </column>
      <column caption='c.level 1-wk-1' datatype='string' name='[Calculation_5905063596345110541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Level 1],[c.hr A+-curr-abr final-1 (copy)_5905063596333916168])&#10;THEN&#10;[c.hr A+-curr-abr final-1 (copy)_5905063596333916168]&#10;ELSEIF CONTAINS([Level 1],[c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529])&#10;THEN&#10;[c.hr A+-curr-abr final-1-split -1 (copy)_5905063596334059529]&#10;ELSEIF CONTAINS([Level 1],[c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586])&#10;THEN&#10;[c.hr A+-curr-abr final-1-split -2 (copy)_5905063596334104586]&#10;&#10;ELSEif CONTAINS([Level 1],[c.hr A+-curr-abr wk-1-split -1 (copy)_5905063596350115857])&#10;THEN&#10;[c.hr A+-curr-abr wk-1-split -1 (copy)_5905063596350115857]&#10;ELSEIF CONTAINS([Level 1],[c.hr P+-curr-abr wk-1-split -1 (copy)_5905063596350218258])&#10;THEN&#10;[c.hr P+-curr-abr wk-1-split -1 (copy)_5905063596350218258]&#10;ELSEIF CONTAINS([Level 1],[c.hr P+-curr-abr wk-1-split -2 (copy)_5905063596350271507])&#10;THEN&#10;[c.hr P+-curr-abr wk-1-split -2 (copy)_5905063596350271507]&#10;&#10;ELSE&#10;&quot;&quot;&#10;END' />
      </column>
      <column caption='c.PP level 1-wk1' datatype='string' name='[Calculation_5905063602432278551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([c.PP level 1-wk1 (copy)_5359213188282826758]=&apos;&apos; or contains([c.PP level 1-wk1 (copy)_5359213188282826758],&apos;Natasha Corbin&apos;),[level_1_2],[c.PP level 1-wk1 (copy)_5359213188282826758])' />
      </column>
      <column caption='c.pp-lev1&amp;2' datatype='string' name='[Calculation_623185615277854720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=1&#13;&#10;THEN&#13;&#10;&apos;&apos;&#13;&#10;ELSEif [Parameters].[Parameter 6]=2&#13;&#10;THEN&#13;&#10;[c.PP level 1-wk3 (copy)_5359213188279492610]&#13;&#10;END' />
      </column>
      <column caption='c.dept calc tableau' datatype='string' name='[Calculation_734227489290911745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs &amp; Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_734227489291042818],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
      </column>
      <column caption='c.man level concat' datatype='string' name='[Calculation_734227489291042818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([employee_id],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
