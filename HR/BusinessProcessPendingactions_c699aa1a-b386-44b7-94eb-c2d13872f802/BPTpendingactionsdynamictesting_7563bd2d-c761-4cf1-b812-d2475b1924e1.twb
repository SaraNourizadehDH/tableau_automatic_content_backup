      <column caption='c.pp level 1-list' datatype='string' name='[Calculation_2383811624269086721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [managed_by]=&quot;2020-06-2821&quot;&#10;THEN&#10;[Calculation_2383811624269209602]&#10;ELSE&#10;NULL&#10;END' />
