    <worksheet name='Position Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#df1063' fontname='Tableau Bold' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='Sheet9' path='/t/HR/workbooks/TACLevelDashboard-WIP' revision='' site='HR' />
      <table>
        <view>
          <datasources>
            <datasource caption='pl_ta_job_requisitions (people_ops_proposed)' name='federated.14ik4xz0b7b0pe13p1ala0b90wo1' />
          </datasources>
          <datasource-dependencies datasource='federated.14ik4xz0b7b0pe13p1ala0b90wo1'>
            <column caption='Brand_Calcu' datatype='string' name='[Calculation_8135119452964499458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [region]&#10;when &apos;Europe&apos; then &apos;foodora&apos;&#10;when &apos;Asia&apos; then &apos;foodpanda&apos;&#10;when &apos;MENA&apos; then &apos;Yemek&apos;&#10;else null&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_8135119452965556227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [job_country]&#10;when &apos;Lao Peoples Democratic Republic&apos;&#10;then &apos;Laos&apos;&#10;else [job_country]&#10;END' />
