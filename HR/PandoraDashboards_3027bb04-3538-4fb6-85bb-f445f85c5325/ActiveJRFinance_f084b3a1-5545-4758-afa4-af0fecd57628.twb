    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Purpose &amp; Definition'>
      <repository-location derived-from='http://ip-172-31-0-77:8504/t/HR/workbooks/ActiveJR-Finance/PurposeDefinition?rev=' id='PurposeDefinition' path='/t/HR/workbooks/ActiveJR-Finance' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1400' minheight='2000' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone forceUpdate='true' h='2500' id='7' type-v2='text' w='100000' x='0' y='500'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Purpose &amp; Definition</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='0' />
            <format attr='background-color' value='#9f3190' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='40000' id='5' type-v2='text' w='92857' x='3571' y='7500'>
          <formatted-text>
            <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Purpose</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book'>This dashboard is mainly focusing on the roles which are in hiring process at Smartrecruiters and which are under Pandora CFO organization</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book'> ( Job Requisitions &amp; Positions). </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book'>All data is taken from SmartRecruiters and any changes at SmartRecruiters will be reflected here at the following day.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Objective</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book'>The main objective of this dashboard is to give visibility to the stakeholders about Open / Filled Job Requisitions and Positions; and give the stakeholder the opportunity to make data-driven decision.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Definitions</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#df1067' fontname='Tableau Medium' fontsize='12'>Active Job Requisitions</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>How many requisitions are open?</run>
            <run>Æ&#10;</run>
            <run>Provides the total count of open job requisitions currently in the system.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>How many positions are open?</run>
            <run>Æ&#10;</run>
            <run>Offers insight into the total number of positions that need to be filled.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>What is the distribution of open requisitions in each department / job family / cost center?</run>
            <run>Æ&#10;</run>
            <run>Details the spread of open job requisitions across different department / job family / cost center helping identify areas with the most needs.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>What is the distribution of open requisitions in each management track/level?</run>
            <run>Æ&#10;</run>
            <run>Shows the distribution based on management track/level, aiding in the understanding of hiring needs at different organizational levels.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>How many days/months has each requisition been open?</run>
            <run>Æ&#10;</run>
            <run>Tracks the duration each requisition has been open, assisting in identifying potential bottlenecks.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone h='2500' id='6' is-scaled='1' param='Image/Screenshot 2024-10-14 at 12.05.01.png' type-v2='bitmap' w='10714' x='0' y='500' />
        <zone forceUpdate='true' h='2500' id='8' type-v2='text' w='92857' x='714' y='50000'>
          <formatted-text>
            <run fontalignment='1'>Please create ticket from our Jira Portal for all questions and requests about this dashboard.</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' hyperlink='tabdoc:load-url url=&amp;quot;https://jira.deliveryhero.com/plugins/servlet/desk/portal/272?requestGroup=1357&amp;quot;'>Jira Portal</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='32' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99200' id='31' param='vert' type-v2='layout-flow' w='98858' x='571' y='400'>
                <zone forceUpdate='true' h='2500' id='7' type-v2='text' w='100000' x='0' y='500'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Purpose &amp; Definition</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#9f3190' />
                  </zone-style>
                </zone>
                <zone fixed-size='50' h='2500' id='6' is-fixed='true' is-scaled='1' param='Image/Screenshot 2024-10-14 at 12.05.01.png' type-v2='bitmap' w='10714' x='0' y='500'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='40000' id='5' type-v2='text' w='92857' x='3571' y='7500'>
                  <formatted-text>
                    <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Purpose</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book'>This dashboard is mainly focusing on the roles which are in hiring process at Smartrecruiters and which are under Pandora CFO organization</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book'> ( Job Requisitions &amp; Positions). </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book'>All data is taken from SmartRecruiters and any changes at SmartRecruiters will be reflected here at the following day.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Objective</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book'>The main objective of this dashboard is to give visibility to the stakeholders about Open / Filled Job Requisitions and Positions; and give the stakeholder the opportunity to make data-driven decision.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='14' underline='true'>Definitions</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#df1067' fontname='Tableau Medium' fontsize='12'>Active Job Requisitions</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>How many requisitions are open?</run>
                    <run>Æ&#10;</run>
                    <run>Provides the total count of open job requisitions currently in the system.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>How many positions are open?</run>
                    <run>Æ&#10;</run>
                    <run>Offers insight into the total number of positions that need to be filled.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What is the distribution of open requisitions in each department / job family / cost center?</run>
                    <run>Æ&#10;</run>
                    <run>Details the spread of open job requisitions across different department / job family / cost center helping identify areas with the most needs.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>What is the distribution of open requisitions in each management track/level?</run>
                    <run>Æ&#10;</run>
                    <run>Shows the distribution based on management track/level, aiding in the understanding of hiring needs at different organizational levels.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>How many days/months has each requisition been open?</run>
                    <run>Æ&#10;</run>
                    <run>Tracks the duration each requisition has been open, assisting in identifying potential bottlenecks.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2500' id='8' type-v2='text' w='92857' x='714' y='50000'>
                  <formatted-text>
                    <run fontalignment='1'>Please create ticket from our Jira Portal for all questions and requests about this dashboard.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' hyperlink='tabdoc:load-url url=&amp;quot;https://jira.deliveryhero.com/plugins/servlet/desk/portal/272?requestGroup=1357&amp;quot;'>Jira Portal</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{EE267553-EE2D-405C-9BB6-1F1C5F9A4858}' />
    </dashboard>
