    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Read Me'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/foodpandaAttrition/ReadMe?rev=' id='ReadMe' path='/t/HR/workbooks/foodpandaAttrition' revision='' site='HR' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='90625' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Attrition Dashboard Read Me</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Welcome to the Attrition Dashboard! This dashboard aims to align the management of employee attrition across all markets. It provides valuable insights into attrition rates and trends, allowing markets to track and analyze attrition data effectively.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10' underline='true'>Tabs:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>The first two tabs are available for markets to access and utilize for attrition management purposes.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10' underline='true'>Default View:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>The Attrition Dashboard tracks the rate of permanent employees leaving the organization.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Attrition does not include interns, consultants, contractors, contingent workers, or fixed-term employees.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10' underline='true'>Filterings:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>The dashboard allows filtering by entity, job level, worker type and contract type within each market to understand attrition trends.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10' underline='true'>Key Metrics:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Headcount: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>Active employees by end-of-month headcount</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Termination: </run>
              <run fontcolor='#1d1c1d' fontsize='10'>Number of leavers in the month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Voluntary Termination:</run>
              <run fontcolor='#b0203a' fontsize='10'>Æ </run>
              <run fontcolor='#1d1c1d' fontsize='10'>Number of voluntary leavers in the month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b00f53' fontsize='10'>Monthly Attrition:</run>
              <run fontcolor='#b00f53' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Leavers in the month divided by end-of-month headcount. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'># of leavers in the month / # of headcount at the end of the month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Quarterly Attrition: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Sum of monthly attrition rates within the quarter.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Annual Attrition:</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Sum of monthly attrition rates within the year.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Year-to-Date Attrition:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Sum of monthly attrition rates up to the current date.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b0203a' fontsize='10'>Annualised Attrition:</run>
              <run fontcolor='#b0203a' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Expected annual attrition rate based on current trends.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>(Sum of monthly attrition up to current date / # of months up to current date) X 12</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='10'>For support, please contact:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Angelia Lim: </run>
              <run fontcolor='#000000' fontsize='10' underline='true'>angelia.lim@foodpanda.com</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Karen See: </run>
              <run fontcolor='#000000' fontsize='10' underline='true'>karen.see@foodpanda.com</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Thank you!</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='7375' id='11' type-v2='empty' w='98400' x='800' y='91625'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
