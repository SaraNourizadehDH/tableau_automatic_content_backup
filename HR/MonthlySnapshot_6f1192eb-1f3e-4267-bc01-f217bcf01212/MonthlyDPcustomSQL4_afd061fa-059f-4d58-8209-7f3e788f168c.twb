            <column caption='c.sub dept calc' datatype='string' name='[Calculation_1684135223037825031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([Calculation_5287225962611671041]+[Sub Department Wd]) in [Concat Set]&#10;THEN&#10;[Sub Department Wd]&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5287225962611671041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[c.dept calc tableau (copy)_778982036811280384]' />
            </column>
            <column caption='c.day-for paramater' datatype='date' datatype-customized='true' name='[Calculation_6254796257853353984]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(IF YEAR([Report effective date])&gt;2020 and [Calculation_984036538659614724]=TRUE&#10;THEN&#10;DATETRUNC(&apos;month&apos;,[Report effective date])&#10;ELSE&#10;NULL&#10;END)' />
            </column>
            <column caption='c.last updated' datatype='date' datatype-customized='true' name='[Calculation_6532400954434973716]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;,1,[Parameters].[Parameter 16])-1)' />
            </column>
            <column caption='c.emp type' datatype='string' name='[Calculation_6532400954603532309]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Contract Type],&quot; (&quot;,1)' />
            </column>
            <column caption='c.upto eoLM' datatype='boolean' name='[Calculation_984036538659614724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([Report effective date])&lt;=(TODAY()-DAY(TODAY()))' />
            </column>
            <column datatype='string' name='[Concat]' role='dimension' type='nominal' />
