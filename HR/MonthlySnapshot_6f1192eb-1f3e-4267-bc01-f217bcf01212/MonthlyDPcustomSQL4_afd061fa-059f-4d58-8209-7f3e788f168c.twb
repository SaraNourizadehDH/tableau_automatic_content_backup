            <column-instance column='[Calculation_5287225962611671041]' derivation='None' name='[none:Calculation_5287225962611671041:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6532400954603532309]' derivation='None' name='[none:Calculation_6532400954603532309:nk]' pivot='key' type='nominal' />
            <column-instance column='[Management Level]' derivation='None' name='[none:Management Level:nk]' pivot='key' type='nominal' />
