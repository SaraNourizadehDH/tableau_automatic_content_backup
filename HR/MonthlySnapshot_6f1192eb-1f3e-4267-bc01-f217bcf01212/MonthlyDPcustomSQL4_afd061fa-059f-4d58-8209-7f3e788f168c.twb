          <object caption='HC,ATTR SQL' id='_4AEB364633A347EC88503C7AF38CF834'>
            <properties context=''>
              <relation connection='athena.15nneim09zbxdq12nj4w500v26a7' name='Custom SQL Query' type='text'>SELECT 
    wo.employee_id AS &quot;Employee Id&quot;,
    w.work_email AS &quot;Work Email&quot;,
     wp.first_name AS &quot;First Name&quot;,
    wp.last_name AS &quot;Last Name&quot;,
    wp.gender AS &quot;Gender&quot;,
    wp.nationality AS &quot;Nationality&quot;,
    wp.age as &quot;Age&quot;,
    wp.age_group as &quot;Age Group&quot;,
   w.is_people_manager as &quot;Is People manager&quot;,
    wo.company_id AS &quot;Company Id&quot;,
wo.cost_center_id AS &quot;Cost center&quot;,
    wo.is_terminated AS &quot;Is Terminated&quot;,
    wo.contract_type AS &quot;Contract Type&quot;,
    wo.office_location AS &quot;Office Location&quot;,
    wo.office_location_country AS &quot;Office Location Country&quot;,
     wo.department_wd AS &quot;Department Wd&quot;,
    wo.sub_department_wd AS &quot;Sub Department Wd&quot;,
    wo.management_level AS &quot;Management Level&quot;,
    wo.original_first_day_of_work AS &quot;Original First Day Of Work&quot;,
    wo.last_day_of_work AS &quot;Last Day Of Work&quot;,
    w.time_in_company AS &quot;Time In Company&quot;,
    w.time_in_management_level AS &quot;Time In Management Level&quot;,
  wo.report_effective_date as &quot;Report effective date&quot;,
   concat_ws(&apos; &apos;,m.manager_id_01,m.manager_id_02,m.manager_id_03,m.manager_id_04,m.manager_id_05,m.manager_id_06,m.manager_id_07,m.manager_id_08,m.manager_id_09,m.manager_id_10) as &quot;Manager ID concat&quot;, 
    CONCAT_WS(&apos;|&apos;,
        m.manager_01_full_name,
        m.manager_02_full_name,
        m.manager_03_full_name,
        m.manager_04_full_name,
        m.manager_05_full_name,
        m.manager_06_full_name,
        m.manager_07_full_name,
        m.manager_08_full_name,
        m.manager_09_full_name,
        m.manager_10_full_name
    ) as &quot;Manager Name concat&quot;,
    pr.manager_rating AS &quot;Manager Rating&quot;,
    pr.manager_rating_explained AS &quot;Manager Rating Explained&quot;,
     pr.review_date AS &quot;Review Date&quot;,
    t.termination_category AS &quot;Termination Category&quot;,
    t.is_termination_regrettable AS &quot;Is Termination Regrettable&quot;,
    t.status AS &quot;Status&quot;,
    t.last_day_of_work AS &quot;Last Day Of Work (Il Termination)&quot;
FROM 
    people_ops_proposed.il_worker_hist  wo

left join 
people_ops_proposed.il_worker_org  w on wo.employee_id = w.employee_id
LEFT JOIN 
    people_ops_proposed.il_manager_hist  m ON wo.employee_id = m.employee_id and date(wo.report_effective_date)=date(m.report_effective_date )
LEFT JOIN 
    people_ops_proposed.il_termination t ON wo.employee_id = t.employee_id
LEFT JOIN 
    people_ops_proposed.il_worker_personal wp ON wo.employee_id = wp.employee_id
LEFT JOIN 
    people_ops_proposed.il_performance  pr ON date(wo.report_effective_date)  = date(pr.review_date ) and wo.employee_id = pr.employee_id
where year(date(wo.report_effective_date))&gt;&gt;=2022</relation>
            </properties>
            <properties context='extract'>
              <relation name='_4AEB364633A347EC88503C7AF38CF834' table='[Extract].[_4AEB364633A347EC88503C7AF38CF834]' type='table' />
            </properties>
          </object>
        </objects>
