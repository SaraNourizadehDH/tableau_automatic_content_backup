          <datasource-dependencies datasource='federated.0imcdvb0y5eknz1a0wlu40gi6d8r'>
            <column caption='c.gender abriged' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [Gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
