    <worksheet name='gen-manager/nm ratio'>
      <table>
        <view>
          <datasources>
            <datasource caption='HC, ATTR SQL' name='federated.0imcdvb0y5eknz1a0wlu40gi6d8r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Manager ratio' caption='p.gender' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Manager ratio' />
                <alias key='2.' value='Manager ratio X Gender' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0imcdvb0y5eknz1a0wlu40gi6d8r'>
            <column caption='c.gender abriged' datatype='string' name='[Calculation_152840919976341549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Gender]=&quot;Male&quot;&#13;&#10;THEN&#13;&#10;&quot;Male&quot;&#13;&#10;ELSEIF [Gender]=&quot;Female&quot;&#13;&#10;THEN&#13;&#10;&quot;Female&quot;&#13;&#10;ELSE&#13;&#10;&quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='c.is People manager' datatype='string' name='[Calculation_1684135223009738752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Is People manager]=1&#10;then&#10;&quot;People Manager&quot;&#10;else&#10;&quot;Employee&quot;&#10;end' />
            </column>
            <column caption='c.man/gender' datatype='string' name='[Calculation_1684135223028383747]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1&#10;THEN&#10;&quot;All&quot;&#10;ELSE&#10;[Calculation_152840919976341549]&#10;&#10;END' />
            </column>
            <column caption='c.sub dept calc' datatype='string' name='[Calculation_1684135223037825031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([Calculation_5287225962611671041]+[Sub Department Wd]) in [Concat Set]&#10;THEN&#10;[Sub Department Wd]&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_5287225962611671041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[c.dept calc tableau (copy)_778982036811280384]' />
            </column>
            <column caption='c.emp type' datatype='string' name='[Calculation_6532400954603532309]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Contract Type],&quot; (&quot;,1)' />
            </column>
            <column datatype='string' name='[Concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Contract Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Employee Id]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='integer' datatype-customized='true' name='[Is People manager]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Is Terminated]' role='measure' type='quantitative' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[Last Day Of Work (Il Termination)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Management Level]' role='dimension' type='nominal' />
            <column datatype='string' name='[Manager ID concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Office Location Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Office Location]' role='dimension' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[Report effective date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Sub Department Wd]' role='dimension' type='nominal' />
            <column caption='c.people managers' datatype='string' hidden='true' name='[c. female managers (copy)_600386156412882953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Employee Id] IN [Managed By (Il Manager) Set]&#10;THEN&#10;&quot;Manager&quot;&#10;ELSE&#10;&quot;Non-manager&quot;&#10;END' />
            </column>
            <column caption='c.dept calc tableau-wk' datatype='string' name='[c.dept calc tableau (copy)_778982036811280384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat],&quot;2020-06-2825&quot;) and [Is Terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat],&quot;2020-06-2806&quot;) or CONTAINS([Manager ID concat],&quot;2020-06-0158&quot;)&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#9;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.eolm' datatype='string' default-role='measure' default-type='quantitative' name='[c.eoly (copy)_152840917877702686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Is Terminated]=0&#10;THEN&#10;[Employee Id]&#10;ELSEIF DATETRUNC(&apos;month&apos;,[Last Day Of Work (Il Termination)])=DATETRUNC(&apos;month&apos;,[Report effective date])&#10;THEN&#10;[Employee Id]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column-instance column='[c.eoly (copy)_152840917877702686]' derivation='CountD' name='[ctd:c.eoly (copy)_152840917877702686:qk]' pivot='key' type='quantitative' />
