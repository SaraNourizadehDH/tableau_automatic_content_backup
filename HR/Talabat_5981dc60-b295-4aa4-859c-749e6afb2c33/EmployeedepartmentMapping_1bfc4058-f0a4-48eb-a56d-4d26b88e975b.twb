      <aliases enabled='yes' />
      <column caption='c.eolm' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_218072769449472002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[last_day_of_work])&lt;DATE([month])&#10;THEN&#10;NULL&#10;ELSE&#10;[employee_id]&#10;END' />
      </column>
      <column caption='c.man level concat' datatype='string' name='[Calculation_218072769449639939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([employee_id],&quot;&quot;)+&#10;IFNULL([manager_id_01],&quot;&quot;)+&#10;IFNULL([manager_id_02],&quot;&quot;)+&#10;IFNULL([manager_id_03],&quot;&quot;)+&#10;IFNULL([manager_id_04],&quot;&quot;)+&#10;IFNULL([manager_id_05],&quot;&quot;)+&#10;IFNULL([manager_id_06],&quot;&quot;)+&#10;IFNULL([manager_id_07],&quot;&quot;)+&#10;IFNULL([manager_id_08],&quot;&quot;)+&#10;IFNULL([manager_id_09],&quot;&quot;)+&#10;IFNULL([manager_id_10],&quot;&quot;)' />
      </column>
      <column caption='Department (WD hier)' datatype='string' name='[Calculation_218072769449918468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Comms, Public Affairs and Sustainability&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Product&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-08-0133&quot;)&#9;&#10;THEN&#10;&quot;Brands&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-08-0388&quot;)&#9;&#10;THEN&#10;&quot;Strategy and Innovation&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Calculation_218072769449639939],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
      </column>
      <column caption='c.wd vs ax-dept' datatype='string' name='[Calculation_218072769450024965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [department_wd]&lt;&gt;[HR Department]&#10;THEN&#10;&quot;WD&lt;&gt;AX&quot;&#10;ELSE&#10;&quot;WD=AX&quot;&#10;END' />
      </column>
      <column caption='c.wd vs dept calc tb' datatype='string' name='[Calculation_218072769450422279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [department_wd]&lt;&gt;[Calculation_218072769449918468]&#10;THEN&#10;&quot;WD&lt;&gt;Dept calc TB&quot;&#10;ELSE&#10;&quot;WD=Dept calc TB&quot;&#10;END' />
      </column>
      <column caption='c.concat-errors' datatype='string' name='[Calculation_218072769452285961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_218072769450024965]+[c.wd vs ax-dept (copy)_218072769450311686]+[Calculation_218072769450422279]+[c.wd vs dept calc tb (copy)_218072769450631176]' />
      </column>
      <column caption='c.Dept/sub error' datatype='string' name='[Calculation_218072769452437514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Calculation_218072769452285961],&quot;&lt;&gt;&quot;)&#10;THEN&#10;&quot;Dept/Sub-dept error&quot;&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='Correct Department' datatype='string' name='[Calculation_218072769453932555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_218072769452437514]=&quot;Dept/Sub-dept error&quot;&#10;THEN&#10;[Calculation_218072769449918468]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.corr sub dept-to validate' datatype='string' name='[Calculation_218072769473056781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [c.correct dept (copy)_218072769454313484]=&quot;Manually add sub-dept&quot;&#10;THEN&#10;&quot;Partners to- &#10;1) Add the sub-department based on the list in sheet 4&#10;2) Update the above on &quot;&#10;ELSE&#10;&quot;Partners to-&#10;1) Update the Dept/sub-dept as provided in the previous 2 columns on &quot;&#10;END' />
