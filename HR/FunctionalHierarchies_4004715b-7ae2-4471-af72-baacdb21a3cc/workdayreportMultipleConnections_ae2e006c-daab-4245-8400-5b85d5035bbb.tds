  <column caption='Tech JFs' datatype='string' name='[Calculation_2679289977308246021]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [job_profile - Split 1] = &apos;Product Operations&apos; THEN &apos;Product Ops&apos;&#10;ELSEIF [job_profile - Split 1] = &apos;Product Management&apos; THEN &apos;Product Management&apos;&#10;ELSEIF [job_family] = &apos;Product Design&apos; THEN &apos;UX&apos;&#10;ELSEIF [job_family_group] = &apos;Data&apos; THEN &apos;Data&apos;&#10;ELSEIF [job_family] IN (&apos;Development Support&apos;, &apos;ERP&apos;, &apos;Infrastructure Engineering&apos;, &apos;Security Engineering&apos;, &apos;Software Engineering&apos;, &apos;Systems Engineering&apos;) THEN &apos;Engineering&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
  </column>
  <column caption='View By (color)' datatype='string' name='[Calculation_2679289978287869958]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Brand&apos; THEN [brand]&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level Group]&#10;    WHEN &apos;Country&apos; THEN [country]&#10;END' />
  </column>
