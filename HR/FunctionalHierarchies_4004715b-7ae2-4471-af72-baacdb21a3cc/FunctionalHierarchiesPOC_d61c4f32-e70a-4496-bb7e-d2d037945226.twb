            </column>
            <column caption='Headcount or FTE' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2679289977294712835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN  &apos;Headcount&apos; THEN [Calculation_2679289977280684032]&#10;    WHEN &apos;FTE&apos; THEN [Calculation_2679289977295564804]&#10;END' />
