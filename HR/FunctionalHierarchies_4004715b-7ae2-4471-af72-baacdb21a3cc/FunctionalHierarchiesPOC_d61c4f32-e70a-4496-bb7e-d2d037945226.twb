          <datasource-dependencies datasource='federated.1yeipow0egedey15vygey1tz896c'>
            <column caption='C Level' datatype='string' name='[C Level (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[manager_02_full_name]' new-bin='true'>
                <bin default-name='true' value='&quot;Benjamin Mann&quot;'>
                  <value>&quot;Benjamin Mann&quot;</value>
