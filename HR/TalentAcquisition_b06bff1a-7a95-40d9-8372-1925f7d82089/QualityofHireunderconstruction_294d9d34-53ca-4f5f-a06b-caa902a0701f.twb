          <zone forceUpdate='true' h='7333' id='10' type-v2='text' w='63357' x='18357' y='667'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='margin-top' value='6' />
              <format attr='margin-bottom' value='6' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7333' id='12' type-v2='text' w='8357' x='81714' y='667'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Last Updated:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='5' />
              <format attr='margin-top' value='6' />
              <format attr='margin-right' value='0' />
              <format attr='margin-bottom' value='6' />
              <format attr='margin-left' value='0' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone h='2667' id='13' type-v2='empty' w='46218' x='3782' y='8000'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='50250' id='14' type-v2='text' w='92430' x='3782' y='10667'>
            <formatted-text>
              <run bold='true' fontsize='12'>Calculated Fields</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Employees Reviewed</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of employees that received a manager score the most recent performance review. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting instances of </run>
              <run bold='true' fontsize='12'>Employee ID</run>
              <run fontsize='12'>.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># High Performers</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of employees that scored &apos;4&apos; or &apos;5&apos; on the most recent performance review. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting instances of </run>
              <run bold='true' fontsize='12'>Employee ID, </run>
              <run fontsize='12'>filtered by the above criteria.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'>% High Performers</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>[</run>
              <run bold='true' fontsize='12'># High Performers</run>
              <run fontsize='12'>] / [</run>
              <run bold='true' fontsize='12'># Employees Reviewed</run>
              <run fontsize='12'>]</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Quality Hires</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of high performers who also received an average interview score below 1.5.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting instances of </run>
              <run bold='true' fontsize='12'>Employee ID, </run>
              <run fontsize='12'>filtered by the above criteria</run>
              <run bold='true' fontsize='12'>.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'>% Quality Hires</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>[</run>
              <run bold='true' fontsize='12'># Quality Hires</run>
              <run fontsize='12'>] / [</run>
              <run bold='true' fontsize='12'># Employees Reviewed</run>
              <run fontsize='12'>]</run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='3857' id='24' type-v2='text' w='92430' x='3782' y='92667'>
            <formatted-text>
              <run bold='true' fontalignment='1'>Created By: Deanna Dang</run>
              <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='7333' id='29' is-scaled='1' param='Image/images.png' type-v2='bitmap' w='5572' x='571' y='667'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='margin-top' value='6' />
              <format attr='margin-right' value='0' />
              <format attr='margin-bottom' value='6' />
              <format attr='margin-left' value='0' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone h='7333' id='30' type-v2='empty' w='12214' x='6143' y='667'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='margin-top' value='6' />
              <format attr='margin-right' value='0' />
              <format attr='margin-bottom' value='6' />
