            <column caption='Quality Hire Prediction' datatype='string' name='[Calculation_2286562006187745280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [rating]=1 and [manager_rating]=4 then &apos;Correct Prediction&apos;&#10;elseif [rating]=1 and [manager_rating]=5 then &apos;Correct Prediction&apos;&#10;else &apos;Incorrect Prediction&apos; end' />
            </column>
            <column caption='# Correct Predictions' datatype='integer' name='[Calculation_2286562006188359681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_2286562006187745280] = &apos;Correct Prediction&apos; then 1&#10;else 0 END)' />
            </column>
            <column caption='User Filter Custom' datatype='string' name='[Calculation_4483263095118516224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;M4+&apos;&#10;ELSEIF [job_requisition_id (worker)] = &quot;JR0013856&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [job_family] = &quot;Product Design / Management&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Analytics&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Operations&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [department] = &quot;DH International&quot; THEN &quot;DH International&quot;&#10;ELSEIF [department] = &quot;DH People&quot; THEN &quot;DH People&quot;&#10;ELSEIF [department] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#10;ELSEIF [department] = &quot;DH Strategy&quot; THEN &quot;DH Strategy&quot;&#10;ELSEIF [department] = &quot;DH Finance&quot; THEN &quot;DH Finance&quot;&#13;&#10;ELSEIF [department] = &quot;DH Legal&quot; THEN &quot;DH Legal&quot;&#10;ELSE &quot;Other&quot; &#10;END' />
            </column>
            <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal'>
