      <column caption='# With Rating' datatype='integer' name='[# Missing Rating (copy)_4686628759338303492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if ISNULL([avg_rating]) then 0 else 1 end)' />
      </column>
      <column caption='% Missing Rating' datatype='real' name='[# With Rating (copy)_4686628759338573830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4686628759329042434])/([Calculation_4686628759329042434]+[# Missing Rating (copy)_4686628759338303492])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1q8adrs1h22vrj0zvwxn50lyh10q]&quot;' value='Interview Rating' />
          <alias key='&quot;[federated.1q8adrs1h22vrj0zvwxn50lyh10q].[avg:Calculation_2833749360598605826:qk]&quot;' value='Tenure (Y)' />
          <alias key='&quot;[federated.1q8adrs1h22vrj0zvwxn50lyh10q].[avg:ttp:qk]&quot;' value='TTP (Y)' />
