                              <expression op='[interview_event_scores].[job_requisition_id]' />
                              <expression op='[worker_hired].[job_requisition_id]' />
                            </expression>
                          </expression>
                        </clause>
                        <relation connection='athena.1gx4q940qir2yx19cc1wv139id2e' name='interview_event_scores' type='text'>select f.interviewer_id,
concat(w.first_name, &apos; &apos;, w.last_name) as interviewer_name,
e.candidate_wd_id,
e.candidate_id,
e.interview_id,
f.job_requisition_id, 
f.rating
from people_ops_il.interview_feedback as f
left join people_ops_il.interview_events as e on f.interview_wd_id = e.interview_id
left join people_ops_il.worker as w on f.interviewer_id = w.employee_id</relation>
                        <relation connection='athena.1gx4q940qir2yx19cc1wv139id2e' name='worker_hired' table='[people_ops_il].[worker_hired]' type='table' />
