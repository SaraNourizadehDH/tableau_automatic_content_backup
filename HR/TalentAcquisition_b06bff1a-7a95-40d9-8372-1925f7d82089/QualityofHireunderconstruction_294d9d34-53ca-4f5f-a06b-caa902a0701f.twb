    <dashboard name='Purpose / Objectives'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/QualityofHire/PurposeObjectives?rev=' id='PurposeObjectives' path='/t/HR/workbooks/QualityofHire' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='3200' id='3' type-v2='empty' w='46212' x='50000' y='9600'>
