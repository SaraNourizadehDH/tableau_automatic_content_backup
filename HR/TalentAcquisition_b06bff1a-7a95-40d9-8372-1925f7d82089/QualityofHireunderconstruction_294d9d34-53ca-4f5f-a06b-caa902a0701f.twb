            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[il_worker_hired].[employee_id]' />
                    <expression op='[time_to_promotion].[employee_id]' />
                  </expression>
                </clause>
                <relation join='inner' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[il_worker_hired].[employee_id]' />
                      <expression op='[worker].[employee_id]' />
                    </expression>
                  </clause>
                  <relation join='inner' type='join'>
                    <clause type='join'>
                      <expression op='AND'>
                        <expression op='='>
                          <expression op='[il_worker_hired].[candidate_id]' />
                          <expression op='[recruitment_corpus].[candidate_id]' />
                        </expression>
                        <expression op='='>
                          <expression op='[il_worker_hired].[job_requisition_id]' />
                          <expression op='[recruitment_corpus].[job_requisition_id]' />
                        </expression>
                      </expression>
                    </clause>
                    <relation join='inner' type='join'>
                      <clause type='join'>
                        <expression op='AND'>
                          <expression op='='>
                            <expression op='[il_worker_hired].[candidate_id]' />
                            <expression op='[avg_candidate_score].[candidate_id]' />
                          </expression>
                          <expression op='='>
                            <expression op='[il_worker_hired].[job_requisition_id]' />
                            <expression op='[avg_candidate_score].[job_requisition_id]' />
                          </expression>
                        </expression>
                      </clause>
                      <relation join='inner' type='join'>
                        <clause type='join'>
                          <expression op='='>
                            <expression op='[performance].[employee_id]' />
                            <expression op='[il_worker_hired].[employee_id]' />
                          </expression>
                        </clause>
                        <relation join='left' type='join'>
                          <clause type='join'>
                            <expression op='='>
                              <expression op='[performance].[cost_center_id]' />
                              <expression op='[cc_hierarchy_all].[cost_center_id]' />
                            </expression>
                          </clause>
                          <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='performance' table='[people_ops_il].[performance]' type='table' />
                          <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='cc_hierarchy_all' table='[people_ops_il].[cc_hierarchy_all]' type='table' />
                        </relation>
                        <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='il_worker_hired' table='[people_ops_proposed].[il_worker_hired]' type='table' />
                      </relation>
                      <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='avg_candidate_score' type='text'>select candidate_id,
job_requisition_id,
round(avg(rating), 1) as avg_rating
from people_ops_il.interview_feedback 
where rating is not null
group by 1,2</relation>
                    </relation>
                    <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='recruitment_corpus' table='[people_ops_il].[recruitment_corpus]' type='table' />
