            <column caption='User Filter Definition' datatype='string' name='[Calculation_2286562008120201221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hire_management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [hire_management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [hire_management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [hire_management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [hire_management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [job_requisition_id] = &quot;JR0013856&quot; THEN &quot;DH Tech&quot;&#13;&#10;ELSEIF [job_family_group] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#13;&#10;ELSEIF [department] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#13;&#10;ELSEIF [department] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#13;&#10;ELSEIF [department] = &quot;DH International&quot; THEN &quot;DH International&quot;&#13;&#10;ELSEIF [department] = &quot;DH People &amp; Culture&quot; THEN &quot;DH People &amp; Culture&quot;&#13;&#10;ELSEIF [department] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#13;&#10;ELSEIF [department] = &quot;DH CEO Office &amp; Strategy&quot; THEN &quot;DH CEO Office &amp; Strategy&quot;&#13;&#10;ELSEIF [department] = &quot;DH Oeconomicis&quot; THEN &quot;DH Oeconomicis&quot;&#13;&#10;ELSEIF [department] = &quot;DH Legal&quot; THEN &quot;DH Legal&quot;&#13;&#10;ELSE &quot;Other&quot; &#13;&#10;END' />
            </column>
            <column caption='Performance Group' datatype='string' name='[Calculation_4451808259991916546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [manager_rating] = 5 then &apos;High Performer&apos;&#10;elseif [manager_rating] = 4 then &apos;High Performer&apos;&#10;else &apos;Not High Performer&apos; end' />
            </column>
            <column caption='# Employees Reviewed' datatype='integer' name='[Calculation_4451808259992592387]' role='measure' type='quantitative'>
