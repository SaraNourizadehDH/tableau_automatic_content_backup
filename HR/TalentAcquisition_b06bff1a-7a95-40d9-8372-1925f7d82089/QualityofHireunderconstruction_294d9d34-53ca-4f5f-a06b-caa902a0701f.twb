              <calculation class='tableau' formula='if [rating]=1 and [manager_rating]=4 then &apos;Correct Prediction&apos;&#10;elseif [rating]=1 and [manager_rating]=5 then &apos;Correct Prediction&apos;&#10;else &apos;Incorrect Prediction&apos; end' />
