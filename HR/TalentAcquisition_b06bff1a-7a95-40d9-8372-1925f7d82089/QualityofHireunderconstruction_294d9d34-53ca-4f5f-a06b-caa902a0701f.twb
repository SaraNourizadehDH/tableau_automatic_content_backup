          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='196' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='195' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='76' h='7333' id='29' is-fixed='true' is-scaled='1' param='Image/images.png' type-v2='bitmap' w='5572' x='571' y='667'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7333' id='10' type-v2='text' w='63357' x='18357' y='667'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7333' id='12' type-v2='text' w='8357' x='81714' y='667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Last Updated:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone fixed-size='76' h='7333' id='59' is-fixed='true' name='Last Updated' show-title='false' w='9358' x='90071' y='667'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='50250' id='14' type-v2='text' w='92430' x='3782' y='10667'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Calculated Fields</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Employees Reviewed</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of employees that received a manager score the most recent performance review. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Employee ID</run>
                    <run fontsize='12'>.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># High Performers</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of employees that scored &apos;4&apos; or &apos;5&apos; on the most recent performance review. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Employee ID, </run>
                    <run fontsize='12'>filtered by the above criteria.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'>% High Performers</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>[</run>
                    <run bold='true' fontsize='12'># High Performers</run>
                    <run fontsize='12'>] / [</run>
                    <run bold='true' fontsize='12'># Employees Reviewed</run>
                    <run fontsize='12'>]</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Quality Hires</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>Number of high performers who also received an average interview score below 1.5.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>Calculated by counting instances of </run>
                    <run bold='true' fontsize='12'>Employee ID, </run>
                    <run fontsize='12'>filtered by the above criteria</run>
                    <run bold='true' fontsize='12'>.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'>% Quality Hires</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>[</run>
                    <run bold='true' fontsize='12'># Quality Hires</run>
                    <run fontsize='12'>] / [</run>
                    <run bold='true' fontsize='12'># Employees Reviewed</run>
                    <run fontsize='12'>]</run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='31750' id='68' type-v2='text' w='92430' x='3782' y='60917'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Assumptions</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>This analysis includes only employees who both received an interview rating and performance score.  </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'>Interview Ratings</run>
                    <run>&#10;* </run>
                    <run fontsize='12'>Some hires from before 2020 do not have interview ratings. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>1 - Strong Yes</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>2 - Yes</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>3 - No</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'>Performance Score (Manager Rating)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>5 - Outstanding</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>4 - Exceeding</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>3 - Performing</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>2 - Development Needed</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>1 - Unsatisfactory</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3857' id='24' type-v2='text' w='92430' x='3782' y='92667'>
                  <formatted-text>
                    <run bold='true' fontalignment='1'>Created By: Deanna Dang</run>
                    <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
