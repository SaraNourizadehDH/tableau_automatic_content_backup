                </relation>
                <relation connection='athena.0yo2izb1c353hu1eg3oj91q554bp' name='time_to_promotion' type='text'>select employee_id, 
round(promotion_speed/365.0, 2) as ttp
from people_ops_il.promotion 
where company_id = &apos;1001&apos;</relation>
              </relation>
            </properties>
