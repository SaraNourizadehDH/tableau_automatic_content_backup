                  </relation>
                  <relation connection='athena.1gx4q940qir2yx19cc1wv139id2e' name='worker' table='[people_ops_il].[worker]' type='table' />
                </relation>
                <relation connection='athena.1gx4q940qir2yx19cc1wv139id2e' name='time_to_promotion' type='text'>select employee_id, 
round(promotion_speed/365.0, 2) as ttp
from people_ops_il.promotion 
where company_id = &apos;1001&apos;</relation>
