          <zone h='7333' id='59' name='Last Updated' show-title='false' w='9358' x='90071' y='667'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='margin-top' value='6' />
              <format attr='margin-bottom' value='6' />
              <format attr='margin-left' value='0' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='31750' id='68' type-v2='text' w='92430' x='3782' y='60917'>
            <formatted-text>
              <run bold='true' fontsize='12'>Assumptions</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>This analysis includes only employees who both received an interview rating and performance score.  </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'>Interview Ratings</run>
              <run>&#10;* </run>
              <run fontsize='12'>Some hires from before 2020 do not have interview ratings. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='12'>1 - Strong Yes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>2 - Yes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>3 - No</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'>Performance Score (Manager Rating)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='12'>5 - Outstanding</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>4 - Exceeding</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>3 - Performing</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>2 - Development Needed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>1 - Unsatisfactory</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
