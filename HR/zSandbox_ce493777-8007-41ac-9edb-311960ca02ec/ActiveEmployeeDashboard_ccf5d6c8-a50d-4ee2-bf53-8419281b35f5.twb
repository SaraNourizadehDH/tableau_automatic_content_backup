          <datasource-dependencies datasource='federated.1yp9a331kywbx517fm6vk08pvbpu'>
            <column caption='Filter Row Dimensions' datatype='string' name='[Calculation_1130122037819990063]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Market&quot; THEN [country_group]&#13;&#10;WHEN &quot;Entity&quot; THEN [company_name]&#13;&#10;WHEN &quot;Department&quot; THEN [department_wd]&#13;&#10;WHEN &quot;Sub-Dept&quot; THEN [sub_department_wd]&#13;&#10;END' />
            </column>
            <column caption='Local/Foreign' datatype='string' name='[Calculation_1130122037826846768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT STARTSWITH([nric], &quot;S&quot; ) OR NOT STARTSWITH([nric], &quot;T&quot; )  then   &quot;Foreigner&quot;  ELSE &quot;Local&quot; END' />
            </column>
            <column caption='Tenure (Binned)' datatype='string' name='[Calculation_2143994905215791106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_537617209047375873] &lt;= 1 THEN &quot;1 year or less&quot; &#13;&#10;ELSEIF [Calculation_537617209047375873] &gt; 1 AND [Calculation_537617209047375873] &lt;= 3 THEN &quot;1 to 3 years&quot;&#13;&#10;ELSEIF  [Calculation_537617209047375873] &gt; 3 AND [Calculation_537617209047375873] &lt;=5 THEN &quot;3 to 5 years&quot;&#13;&#10;ELSE &quot;&gt;5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='headcount_count' datatype='integer' name='[Calculation_537617209001324544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([headcount])' />
            </column>
            <column caption='tenure (in years)' datatype='real' name='[Calculation_537617209047375873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[length_of_service]/365' />
