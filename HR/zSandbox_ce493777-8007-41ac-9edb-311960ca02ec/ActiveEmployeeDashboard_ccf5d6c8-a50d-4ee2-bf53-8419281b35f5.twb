            <column datatype='string' name='[country_group (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country_group]' default='&quot;Market&quot;' new-bin='true'>
                <bin default-name='true' value='&quot;Regional&quot;'>
