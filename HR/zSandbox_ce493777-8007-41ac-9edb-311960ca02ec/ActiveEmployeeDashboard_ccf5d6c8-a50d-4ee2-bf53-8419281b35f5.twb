      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.1yp9a331kywbx517fm6vk08pvbpu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1yp9a331kywbx517fm6vk08pvbpu].[Dynamic Month Parameter (copy)_107241973813739520]' caption='Current Year' datatype='integer' default-format='*' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1yp9a331kywbx517fm6vk08pvbpu].[Dynamic Month Parameter (copy)_2143994905285066763]' alias='Apr' caption='Current Month' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='1' value='Jan' />
                <alias key='2' value='Feb' />
                <alias key='3' value='Mar' />
                <alias key='4' value='Apr' />
                <alias key='5' value='May' />
