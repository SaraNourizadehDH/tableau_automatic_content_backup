        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.02l1br61c9rwkf15ce4ce1b98bk4' name='Custom SQL Query' type='text'><![CDATA[SELECT * FROM (SELECT  date_trunc('month',cast(wh.report_effective_date as date)) AS Month,
--worker--
cast(wh.first_day_of_work as date) as first_day_of_work,
wh.employee_id,
wh.business_title,
wh.management_level,
wh.cost_center_id,
wh.company_id,
wh.job_family,
wh.job_family_group,
wh.time_type,
wh.worker_type,
wh.department_wd,
wh.fte,
wh.worker_type as type,
wh.time_type as sub_type,
wh.contract_type,
wh.sub_department_wd,
wo.tenure_category,
--cost center allocation--
cl.costing_allocation_cost_center_id,
cl.costing_allocation_company_id,
cl.costing_allocation_start_date,
cl.costing_allocation_end_date,
--company--
cm.country,
cm.company_name,
cm.country_group,
cm.brand,
cm.marketplace,
--cost center-- (remove budget area and segment from dashboard)
cost_center.cost_center_name,
cost_center.segment,
cost_center.functional_area_group,
cost_center.budget_area,
----performance----
perf.employee_self_rating_explained,
perf.manager_rating_explained,
perf.review_date,
perf_template.review_template,

--manager--
mh.managed_by_full_name as manager_name,
mh.manager_01_full_name,
mh.manager_02_full_name,
mh.manager_03_full_name,
mh.manager_04_full_name,
mh.manager_05_full_name,
mh.manager_06_full_name,
mh.manager_07_full_name,
mh.manager_08_full_name,
mh.manager_09_full_name,
mh.manager_10_full_name,
mh.manager_id_01,
mh.manager_id_02,
mh.manager_id_03,
mh.manager_id_04,
mh.manager_id_05,
mh.manager_id_06,
mh.manager_id_07,
mh.manager_id_08,
mh.manager_id_09,
mh.manager_id_10,
--personal--
concat(wp.first_name,' ',wp.last_name) as name,
wp.gender,
wp.nric,
wp.preferred_full_name,

--termination--
cast(te.termination_effective_date as date) as termination_date,
te.status,
te.termination_effective_date,
CASE WHEN (te.termination_effective_date IS NULL) OR (wh.first_day_of_work >> te.termination_effective_date
OR te.status='Canceled' or te.status='Rescinded') THEN (DATE_DIFF('day', cast(wh.first_day_of_work as date),NOW()))
ELSE (DATE_DIFF('day', cast(wh.first_day_of_work as date),cast(te.termination_effective_date as date))) END AS length_of_service,
CASE WHEN (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) = CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date)
AND NOT (te.status = 'Canceled' OR te.status = 'Rescinded'))
THEN mh.employee_id
WHEN wh.is_terminated = 1
AND (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) = CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date))
THEN mh.employee_id
ELSE null END AS termination,
te.termination_category,
te.termination_reason,
te.is_termination_regrettable,
--headcount including terminated for the month--
CASE WHEN (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) << CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date)
AND (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) >>= CAST(date_trunc('month',cast(wh.first_day_of_work as date)) AS date))
AND NOT (te.status = 'Canceled' OR te.status = 'Rescinded'))
OR (CAST(date_trunc('month', date(wh.first_day_of_work)) AS date) >> CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date))
THEN mh.employee_id ELSE NULL END AS headcount_including_terminated,
-- headcount excluding terminated for the month --
CASE WHEN (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) <<= CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date)
AND (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) >>= CAST(date_trunc('month',cast(wh.first_day_of_work as date)) AS date))
AND NOT (te.status = 'Canceled' OR te.status = 'Rescinded'))
OR (CAST(date_trunc('month', date(wh.first_day_of_work)) AS date) >> CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date))
THEN null ELSE mh.employee_id END AS headcount,
--
CASE WHEN CAST(date_trunc('month', CAST(wh.first_day_of_work AS Date)) AS date) = CAST(date_trunc('month', CAST(wh.report_effective_date AS Date)) AS DATE)
then mh.employee_id else null END AS new_join,
wh.is_terminated
FROM people_ops_proposed.il_worker_hist_with_current wh
LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh
	ON mh.employee_id = wh.employee_id
	AND date_trunc('month',cast(mh.report_effective_date as date)) = date_trunc('month',cast(wh.report_effective_date as date))
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id
LEFT JOIN
	people_ops_proposed.il_worker_cost_allocation cl
	ON cl.employee_id = wh.employee_id
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wh.employee_id

LEFT JOIN
	people_ops_proposed.il_worker_org wo
	ON wo.employee_id = wh.employee_id

LEFT JOIN
        people_ops_proposed.il_termination te
        ON te.employee_id = wh.employee_id
        AND (te.status = 'Successfully Completed' OR te.status = 'Process Terminated')
        AND date_trunc('month', cast(wh.report_effective_date as date)) >>= date_trunc('month', cast(te.termination_initiated_date as date))
        AND date_trunc('month', cast(wh.first_day_of_work as date)) <<= date_trunc('month', cast(te.termination_effective_date as date))
LEFT JOIN
		people_ops_proposed.il_cost_center_mapping_apac cost_center
		ON (cost_center.cost_center_id = wh.cost_center_id)
LEFT JOIN
		people_ops_proposed.il_performance perf
		ON (perf.employee_id = wh.employee_id)
LEFT JOIN
		people_ops_proposed.il_performance_review_template perf_template
		ON (perf.review_template_id = perf_template.review_template_id)
ORDER BY 1 DESC)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.02l1br61c9rwkf15ce4ce1b98bk4' name='Custom SQL Query' type='text'><![CDATA[SELECT * FROM (SELECT  date_trunc('month',cast(wh.report_effective_date as date)) AS Month,
