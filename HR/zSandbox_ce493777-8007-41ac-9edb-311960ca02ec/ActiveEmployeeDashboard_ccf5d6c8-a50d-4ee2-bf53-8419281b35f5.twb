    <worksheet name='Headcount Variances'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.1yp9a331kywbx517fm6vk08pvbpu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1yp9a331kywbx517fm6vk08pvbpu].[Dynamic Month Parameter (copy)_107241973813739520]' caption='Current Year' datatype='integer' default-format='*' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1yp9a331kywbx517fm6vk08pvbpu].[Dynamic Month Parameter (copy)_2143994905285066763]' alias='Apr' caption='Current Month' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='1' value='Jan' />
                <alias key='2' value='Feb' />
                <alias key='3' value='Mar' />
                <alias key='4' value='Apr' />
                <alias key='5' value='May' />
                <alias key='6' value='Jun' />
                <alias key='7' value='Jul' />
                <alias key='8' value='Aug' />
                <alias key='9' value='Sep' />
                <alias key='10' value='Oct' />
                <alias key='11' value='Nov' />
                <alias key='12' value='Dec' />
              </aliases>
            </column>
            <column caption='Charging vs Entity' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Charging Headcount&quot;'>
              <calculation class='tableau' formula='&quot;Charging Headcount&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yp9a331kywbx517fm6vk08pvbpu'>
            <column caption='Main Date: Year' datatype='integer' name='[Calculation_1130122036673327104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Year([Month])' />
            </column>
            <column caption='Main Date: Month' datatype='integer' name='[Calculation_1130122036683587586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MONTH([Month])' />
            </column>
            <column caption='Total Headcount (Current Month)' datatype='integer' name='[Calculation_1130122036693458948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Month] ={max(IF [Calculation_1130122036673327104] = [Parameters].[Parameter 1] AND [Calculation_1130122036683587586] = [Parameters].[Parameter 2] THEN [Month] END)} THEN [headcount] ELSE NULL END)' />
            </column>
            <column caption='Period: Month Number of Previous Month' datatype='integer' name='[Calculation_1130122036747677705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 THEN &#13;&#10;12 &#13;&#10;ELSE &#13;&#10;[Parameters].[Parameter 2]-1 &#13;&#10;END' />
            </column>
            <column caption='Period: Year of Previous Month' datatype='integer' name='[Calculation_1130122036747960330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 THEN &#13;&#10;[Parameters].[Parameter 1]-1 &#13;&#10;ELSE &#13;&#10;[Parameters].[Parameter 1] &#13;&#10;END' />
            </column>
            <column caption='Total Headcount (Previous Month)' datatype='integer' name='[Calculation_1130122036748255243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Month] ={max(IF [Calculation_1130122036673327104] = [Calculation_1130122036747960330] AND [Calculation_1130122036683587586] = [Calculation_1130122036747677705] THEN [Month] END)} THEN [headcount] ELSE NULL END)' />
            </column>
            <column caption='Total Headcount - Current vs Previous Month' datatype='integer' name='[Calculation_1130122036748353548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1130122036693458948]) - ZN([Calculation_1130122036748255243])' />
            </column>
            <column caption='Total Headcount - Current vs Previous Month (shape)' datatype='string' name='[Calculation_1130122036748886030]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE sign([Calculation_1130122036748353548]) &#13;&#10;WHEN 1 THEN &quot;▲&quot;  &#13;&#10;WHEN 0 THEN &quot;►&quot; &#13;&#10;WHEN -1 THEN &quot;▼&quot;  &#13;&#10;ELSE &quot; &quot; &#13;&#10;END' />
            </column>
            <column caption='Total Headcount - Current vs Previous Month %' datatype='real' name='[Calculation_1130122036749901839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1130122036748353548] / ABS([Calculation_1130122036748255243])' />
            </column>
            <column caption='Total Headcount (Previous Year)' datatype='integer' name='[Calculation_1130122036767592465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Month] ={max(IF [Calculation_1130122036673327104] = ([Parameters].[Parameter 1]-1) AND [Calculation_1130122036683587586] = [Parameters].[Parameter 2] THEN [Month] END)} THEN [headcount] ELSE NULL END)' />
            </column>
            <column caption='Total Headcount - Current vs Previous Year' datatype='integer' name='[Calculation_1130122036767862802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1130122036693458948]) - ZN([Calculation_1130122036767592465])' />
            </column>
            <column caption='Total Headcount - Current vs Previous Year %' datatype='real' name='[Calculation_1130122036768825363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1130122036767862802] / ABS([Calculation_1130122036767592465])' />
            </column>
            <column caption='Total Headcount - Current vs Previous Year (shape)' datatype='string' name='[Calculation_1130122036769226772]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE sign([Calculation_1130122036767862802]) &#13;&#10;WHEN 1 THEN &quot;▲&quot;  &#13;&#10;WHEN 0 THEN &quot;►&quot; &#13;&#10;WHEN -1 THEN &quot;▼&quot;  &#13;&#10;ELSE &quot; &quot; &#13;&#10;END' />
            </column>
            <column caption='Placeholder Number' datatype='real' name='[Calculation_537617209637756935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(0)' />
            </column>
            <column caption='Costing Company ID' datatype='string' name='[Calculation_703405974892777473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  ISNULL([costing_allocation_company_id]) then [company_id] else [costing_allocation_company_id] END' />
            </column>
            <column caption='Charging vs Entity Headcount' datatype='string' name='[Calculation_703405974893031426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#13;&#10;when &quot;Charging Headcount&quot; then [Costing Company ID (group)]&#13;&#10;when &quot;Entity Headcount&quot; then [country_group] END' />
            </column>
            <column caption='Pandora/Non-Pandora' datatype='string' name='[Calculation_703405974898470915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([manager_01_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_01_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_01_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;[department_wd] == &quot;Pandora Tech&quot; OR&#13;&#10;[department_wd] == &quot;Pandora Product&quot; THEN &quot;Pandora&quot; &#13;&#10;ELSEIF [country_group] = &apos;1001&apos; THEN &quot;Central Hosted&quot;&#13;&#10;ELSEIF [employee_id] = &apos;2021-04-0571&apos; OR [employee_id] = &apos;2021-05-0218&apos; THEN &apos;Woowa&apos;&#13;&#10;ELSE &quot;Non-Pandora&quot; END' />
