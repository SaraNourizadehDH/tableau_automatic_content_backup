            <column caption='Costing Company ID' datatype='string' name='[Calculation_703405974892777473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  ISNULL([costing_allocation_company_id]) then [company_id] else [costing_allocation_company_id] END' />
            </column>
            <column caption='Charging vs Entity Headcount' datatype='string' name='[Calculation_703405974893031426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#13;&#10;when &quot;Charging Headcount&quot; then [Costing Company ID (group)]&#13;&#10;when &quot;Entity Headcount&quot; then [country_group] END' />
            </column>
            <column caption='Pandora/Non-Pandora' datatype='string' name='[Calculation_703405974898470915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([manager_01_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;sebastian rodriguez&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_01_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;davide vitiello&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_01_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_02_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_03_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_04_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_05_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_06_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_07_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_08_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;   CONTAINS(LOWER([manager_09_full_name]), &quot;nicolas daudin&quot;) OR&#13;&#10;[department_wd] == &quot;Pandora Tech&quot; OR&#13;&#10;[department_wd] == &quot;Pandora Product&quot; THEN &quot;Pandora&quot; &#13;&#10;ELSEIF [country_group] = &apos;1001&apos; THEN &quot;Central Hosted&quot;&#13;&#10;ELSEIF [employee_id] = &apos;2021-04-0571&apos; OR [employee_id] = &apos;2021-05-0218&apos; THEN &apos;Woowa&apos;&#13;&#10;ELSE &quot;Non-Pandora&quot; END' />
            </column>
            <column caption='Month = Month Parameter' datatype='boolean' name='[Calculation_703405974901641222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Month]) = [Parameters].[Parameter 2] AND YEAR([Month]) = [Parameters].[Parameter 1]' />
            </column>
            <column datatype='string' name='[Costing Company ID (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_703405974892777473]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Regional&quot;'>
                  <value>&quot;3803&quot;</value>
                  <value>&quot;3806&quot;</value>
                  <value>&quot;3809&quot;</value>
                  <value>&quot;3811&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Dynamic Year Parameter' datatype='integer' name='[Dynamic Month Parameter (copy)_107241973813739520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{MAX(YEAR({MAX([Month])}))}' />
            </column>
            <column caption='Dynamic Month Parameter' datatype='integer' name='[Dynamic Month Parameter (copy)_2143994905285066763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{MAX(MONTH({MAX([Month])}))}' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
