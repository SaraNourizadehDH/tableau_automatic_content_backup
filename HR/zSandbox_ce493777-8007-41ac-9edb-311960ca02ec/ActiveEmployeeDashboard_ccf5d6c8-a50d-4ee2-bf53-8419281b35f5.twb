          <groupfilter function='level-members' level='[none:Calculation_703405974893031426:nk]' />
          <groupfilter function='member' level='[none:Calculation_703405974893031426:nk]' member='%null%' />
        </groupfilter>
      </filter>
    </shared-view>
  </shared-views>
