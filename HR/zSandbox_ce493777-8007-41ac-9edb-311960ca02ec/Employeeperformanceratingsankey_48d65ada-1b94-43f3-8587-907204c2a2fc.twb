        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.0rrgdpe126o3j117rtj8q0q2ns97' name='Custom SQL Query' type='text'>with all_reviews as(
select p.* , pr.review_template
from people_ops_proposed.il_performance p 
left join people_ops_proposed.il_performance_review_template pr
using (review_template_id)
)

select distinct employee_id,
ar.cost_center_id, 
ar.company_id,
cm.company_name,
cm.region,
cm.brand,
ar.managed_by,
CASE
    WHEN whc.management_level like &apos;IC%&apos; THEN &apos;IC&apos;
    WHEN whc.management_level like &apos;M%&apos; THEN &apos;M&apos;
    WHEN whc.management_level like &apos;S%&apos; THEN &apos;S&apos;
end as management_level,
max(CASE WHEN review_date = &apos;2023-01-01&apos; THEN manager_rating_explained end) AS End_Year_2022_performance,
max(CASE WHEN review_date = &apos;2023-07-01&apos; THEN manager_rating_explained end) AS Mid_Year_2023_performance,
max(CASE WHEN review_date = &apos;2024-01-01&apos; THEN manager_rating_explained end) AS End_Year_2023_performance,
max(CASE WHEN review_date = &apos;2024-07-01&apos; THEN manager_rating_explained end) AS Mid_Year_2024_performance
from all_reviews ar
left join people_ops_proposed.il_worker_hist_with_current whc
using (employee_id)
left join people_ops_proposed.il_company_mapping cm
on ar.company_id = cm.company_id 
where whc.is_terminated = 0 
group by 1,2,3,4,5,6,7,8
having max(CASE WHEN review_date = &apos;2023-01-01&apos; THEN manager_rating_explained end) is not null 
and max(CASE WHEN review_date = &apos;2023-07-01&apos; THEN manager_rating_explained end) is not null
and max(CASE WHEN review_date = &apos;2024-01-01&apos; THEN manager_rating_explained end) is not null 
and max(CASE WHEN review_date = &apos;2024-07-01&apos; THEN manager_rating_explained end) is not null</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.0rrgdpe126o3j117rtj8q0q2ns97' name='Custom SQL Query' type='text'>with all_reviews as(
select p.* , pr.review_template
from people_ops_proposed.il_performance p 
left join people_ops_proposed.il_performance_review_template pr
using (review_template_id)
)

select distinct employee_id,
ar.cost_center_id, 
ar.company_id,
cm.company_name,
cm.region,
cm.brand,
ar.managed_by,
CASE
    WHEN whc.management_level like &apos;IC%&apos; THEN &apos;IC&apos;
    WHEN whc.management_level like &apos;M%&apos; THEN &apos;M&apos;
    WHEN whc.management_level like &apos;S%&apos; THEN &apos;S&apos;
end as management_level,
max(CASE WHEN review_date = &apos;2023-01-01&apos; THEN manager_rating_explained end) AS End_Year_2022_performance,
max(CASE WHEN review_date = &apos;2023-07-01&apos; THEN manager_rating_explained end) AS Mid_Year_2023_performance,
max(CASE WHEN review_date = &apos;2024-01-01&apos; THEN manager_rating_explained end) AS End_Year_2023_performance,
max(CASE WHEN review_date = &apos;2024-07-01&apos; THEN manager_rating_explained end) AS Mid_Year_2024_performance
from all_reviews ar
left join people_ops_proposed.il_worker_hist_with_current whc
using (employee_id)
left join people_ops_proposed.il_company_mapping cm
on ar.company_id = cm.company_id 
where whc.is_terminated = 0 
group by 1,2,3,4,5,6,7,8
having max(CASE WHEN review_date = &apos;2023-01-01&apos; THEN manager_rating_explained end) is not null 
and max(CASE WHEN review_date = &apos;2023-07-01&apos; THEN manager_rating_explained end) is not null
and max(CASE WHEN review_date = &apos;2024-01-01&apos; THEN manager_rating_explained end) is not null 
and max(CASE WHEN review_date = &apos;2024-07-01&apos; THEN manager_rating_explained end) is not null</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
