            <column caption='row dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Market&quot;'>
              <calculation class='tableau' formula='&quot;Market&quot;' />
            </column>
            <column caption='column dimension' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local/Foreign&quot;'>
              <calculation class='tableau' formula='&quot;Local/Foreign&quot;' />
            </column>
