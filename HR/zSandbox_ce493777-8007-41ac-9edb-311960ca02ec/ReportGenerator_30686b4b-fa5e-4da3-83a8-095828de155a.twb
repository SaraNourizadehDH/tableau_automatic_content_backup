            <column caption='calc tenure (year)' datatype='real' name='[Calculation_1278177884763189250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_terminated] = 1 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], [termination_date]) / 365&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], TODAY()) / 365&#13;&#10;END' />
