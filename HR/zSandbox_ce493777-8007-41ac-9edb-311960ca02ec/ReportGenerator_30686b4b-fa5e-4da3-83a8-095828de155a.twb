      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.143q4cz0ca1ug711c24b80cjs2dc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Changing metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Headcount&quot;'>
              <calculation class='tableau' formula='&quot;Headcount&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.143q4cz0ca1ug711c24b80cjs2dc'>
            <column caption='calc changing metric' datatype='real' name='[Calculation_1177691318722408448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Headcount&quot; THEN ROUND([Calculation_942096750248898560], 0)&#13;&#10;WHEN &quot;Attrition&quot; THEN ROUND([Calculation_895371904701485056], 2)&#13;&#10;WHEN &quot;Voluntary Rate&quot; THEN ROUND([Calculation_1280711154248196098], 2)&#13;&#10;WHEN &quot;Involuntary Rate&quot; THEN ROUND([calc voluntary rate  (copy)_1280711154249072643], 2)&#13;&#10;END' />
            </column>
            <column caption='calc tenure (year)' datatype='real' name='[Calculation_1278177884763189250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_terminated] = 1 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], [termination_date]) / 365&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], TODAY()) / 365&#13;&#10;END' />
            </column>
            <column caption='Tenure Category' datatype='string' name='[Calculation_1278177884763410436]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1278177884763189250] &lt;= 1 THEN &quot;1 year or less&quot;&#13;&#10;ELSEIF [Calculation_1278177884763189250] &gt; 1 AND [Calculation_1278177884763189250] &lt;= 3 THEN &quot;1 to 3 years&quot;&#13;&#10;ELSEIF  [Calculation_1278177884763189250] &gt; 3 AND [Calculation_1278177884763189250] &lt;=5 THEN &quot;3 to 5 years&quot;&#13;&#10;ELSE &quot;&gt;5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='calc voluntary count ' datatype='string' name='[Calculation_1280711154247921665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [termination_category] =&quot;Voluntary&quot; then [termination] else null end' />
            </column>
            <column caption='calc voluntary rate ' datatype='real' name='[Calculation_1280711154248196098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((COUNTD([Calculation_1280711154247921665])/COUNTD([headcount]))*100, 2)' />
            </column>
            <column caption='Attrtion Rate' datatype='real' name='[Calculation_895371904701485056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((COUNTD([termination]) / COUNTD([headcount])) * 100, 1)' />
            </column>
            <column caption='Headcount' datatype='integer' name='[Calculation_942096750248898560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([headcount])' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='calc involuntary count' datatype='string' name='[calc voluntary count  (copy)_1280711154249269252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [termination_category] =&quot;Involuntary&quot; then [termination] else null end' />
            </column>
            <column caption='calc involuntary rate' datatype='real' name='[calc voluntary rate  (copy)_1280711154249072643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((COUNTD([calc voluntary count  (copy)_1280711154249269252])/COUNTD([headcount]))*100,2)' />
