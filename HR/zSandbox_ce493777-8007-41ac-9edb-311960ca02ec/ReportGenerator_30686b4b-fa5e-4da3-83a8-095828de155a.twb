          <datasource-dependencies datasource='federated.143q4cz0ca1ug711c24b80cjs2dc'>
            <column caption='calc changing metric' datatype='real' name='[Calculation_1177691318722408448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Headcount&quot; THEN ROUND([Calculation_942096750248898560], 0)&#13;&#10;WHEN &quot;Attrition&quot; THEN ROUND([Calculation_895371904701485056], 2)&#13;&#10;WHEN &quot;Voluntary Rate&quot; THEN ROUND([Calculation_1280711154248196098], 2)&#13;&#10;WHEN &quot;Involuntary Rate&quot; THEN ROUND([calc voluntary rate  (copy)_1280711154249072643], 2)&#13;&#10;END' />
            </column>
            <column caption='Management Level Groups' datatype='string' name='[Calculation_1177691318731247617]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_level]&#13;&#10;    WHEN &quot;IC1&quot; THEN &quot;IC Level&quot;&#13;&#10;    WHEN &quot;IC2&quot; THEN &quot;IC Level&quot;&#13;&#10;    WHEN &quot;IC3&quot; THEN &quot;IC Level&quot;&#13;&#10;    WHEN &quot;IC4&quot; THEN &quot;IC Level&quot;&#13;&#10;    WHEN &quot;IC5&quot; THEN &quot;IC Level&quot;&#13;&#10;    WHEN &quot;M1&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;M2&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;M3&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;M4&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;M5&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;M6&quot; THEN &quot;M Level&quot;&#13;&#10;    WHEN &quot;S1&quot; THEN &quot;S Level&quot;&#13;&#10;    WHEN &quot;S2&quot; THEN &quot;S Level&quot;&#13;&#10;    WHEN &quot;S3&quot; THEN &quot;S Level&quot;&#13;&#10;    WHEN &quot;S4&quot; THEN &quot;S Level&quot;&#13;&#10;END' />
            </column>
            <column caption='calc tenure (year)' datatype='real' name='[Calculation_1278177884763189250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_terminated] = 1 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], [termination_date]) / 365&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&apos;day&apos;, [first_day_of_work], TODAY()) / 365&#13;&#10;END' />
            </column>
            <column caption='Tenure Category' datatype='string' name='[Calculation_1278177884763410436]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1278177884763189250] &lt;= 1 THEN &quot;1 year or less&quot;&#13;&#10;ELSEIF [Calculation_1278177884763189250] &gt; 1 AND [Calculation_1278177884763189250] &lt;= 3 THEN &quot;1 to 3 years&quot;&#13;&#10;ELSEIF  [Calculation_1278177884763189250] &gt; 3 AND [Calculation_1278177884763189250] &lt;=5 THEN &quot;3 to 5 years&quot;&#13;&#10;ELSE &quot;&gt;5 years&quot;&#13;&#10;END' />
            </column>
            <column caption='calc voluntary count ' datatype='string' name='[Calculation_1280711154247921665]' role='dimension' type='nominal'>
