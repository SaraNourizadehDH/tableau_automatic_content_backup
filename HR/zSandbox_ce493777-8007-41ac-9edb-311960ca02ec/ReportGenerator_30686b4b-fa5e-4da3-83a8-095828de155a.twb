            <column caption='calc voluntary rate ' datatype='real' name='[Calculation_1280711154248196098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((COUNTD([Calculation_1280711154247921665])/COUNTD([headcount]))*100, 2)' />
            </column>
            <column caption='calc row dimension ' datatype='string' name='[Calculation_265712394551779330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Market&quot; THEN [country]&#13;&#10;WHEN &quot;Entity&quot; THEN [company_name]&#13;&#10;WHEN &quot;Department&quot; THEN [department_wd]&#13;&#10;WHEN &quot;Sub-department&quot; THEN [sub_department_wd]&#13;&#10;END' />
            </column>
            <column caption='calc column dimension' datatype='string' name='[Calculation_265712394552193027]' role='dimension' type='nominal'>
