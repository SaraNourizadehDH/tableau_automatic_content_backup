      </column>
      <column caption='test 1' datatype='integer' hidden='true' name='[Calculation_1186698509173460994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='1 test' datatype='integer' hidden='true' name='[Calculation_1186698509178363907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Calculation1' datatype='string' hidden='true' name='[Calculation_1267481835574394881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()' />
      </column>
      <column caption='MoM Growth %' datatype='real' name='[Calculation_1294503425229684738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([headcount])) - LOOKUP(ZN(SUM([headcount])), -1)) / ABS(LOOKUP(ZN(SUM([headcount])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color' datatype='string' name='[Calculation_1294503425230872579]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1294503425229684738]&gt;=0 then &quot;Green&quot; else &quot;Red&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='New Management Level' datatype='string' name='[Calculation_1346857774486241280 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_level]' />
      </column>
      <column caption='Management Level ' datatype='string' name='[Calculation_1346857774486241280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Month]&lt;[promotion_day] and [employee_id]=&quot;2020-11-1476&quot;&#13;&#10;&#13;&#10;then [management_level] ELSE [management_level] END' />
      </column>
      <column caption='Termination Text' datatype='string' datatype-customized='true' name='[Calculation_1431300303313383424]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(IF SUM([termination]) &gt;= 1 THEN SUM([termination]) ELSE NULL END)' />
      </column>
      <column caption='HC/Intern/Charge Out' datatype='string' hidden='true' name='[Calculation_1498572783706902528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [employee_id]=&quot;2020-12-0426&quot; or [employee_id]=&quot;2020-11-1517&quot; or  [employee_id]=&quot;2020-12-0401&quot; or [employee_id]=&quot;2020-12-0377&quot; or&#13;&#10; [employee_id]=&quot;2021-05-0311&quot; then &quot;Charge Out&quot; &#13;&#10;&#13;&#10;ELSEIF [employee_id]=&quot;2021-05-0520&quot; then &quot;Charge out/ Pandamart&quot;&#13;&#10;&#13;&#10;ELSEIF [employee_id]=&quot;2021-05-0217&quot; then &quot;Park under Woowa KR employees&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [employee_id]=&quot;2020-12-0428&quot; then &quot;Tech&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([business_title],&quot;Intern&quot;) THEN &quot;Intern&quot; &#13;&#10;&#13;&#10;ELSE &quot;HC&quot;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Date Selection 1st Date' datatype='datetime' datatype-customized='true' name='[Calculation_1609192454821142533]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[Month])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[Month])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[Month])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[Month])&#13;&#10;END' />
      </column>
      <column caption='Current Month' datatype='real' name='[Calculation_1699264441882714112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if' />
      </column>
      <column caption='current Month' datatype='boolean' name='[Calculation_1699264441882959873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Month] &lt;= [Calculation_1844787010035314712] then true end' />
      </column>
      <column caption='range of month' datatype='date' name='[Calculation_1699264441889980418]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Month] &lt;= [Calculation_1844787010035314712] and [Month] &gt;= #2021-01-01# then [Month] END' />
      </column>
      <column caption='title' datatype='string' name='[Calculation_1699264441913544707]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If  {FIXED : MIN([Action (New Hire Date Filter (New Format),Cost Center)])} = true then &apos;Cost Center New Joiners&apos;&#13;&#10;ELSEIF {FIXED : MIN([Action (Termination Date Filter (New Format),Cost Center)])} = true then &apos;Cost Center Termination&apos;&#13;&#10;else &apos; &apos; END' />
      </column>
      <column caption='title - breakdown' datatype='string' name='[Calculation_1699264441916682244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Employee Listing - &quot; + [Calculation_1699264441913544707]' />
      </column>
      <column caption='title test 1' datatype='boolean' name='[Calculation_1699264441931898888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED : MIN([Action (New Hire Date Filter (New Format),Cost Center)])}' />
      </column>
      <column caption='check termination date' datatype='boolean' name='[Calculation_1699264442256465931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Month] = DATETRUNC(&apos;month&apos;,[Calculation_973903424978006017]) then true end' />
      </column>
      <column caption='EE Listing' datatype='boolean' name='[Calculation_1699264443635630095]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Action (Month)]' />
      </column>
      <column caption='listing title' datatype='string' name='[Calculation_1699264443638390801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([Month]) + &quot;Employee Listing&quot;' />
      </column>
      <column caption='Management Level Filter' datatype='boolean' name='[Calculation_1699264443640823826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_level] = [Parameters].[Parameter 6 1]' />
      </column>
      <column caption='back text' datatype='string' name='[Calculation_1699264443647229972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&lt; Back to Dashboard&quot;' />
      </column>
      <column caption='Sup Org1' datatype='string' name='[Calculation_1827617060443336705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='trim(if (split(split(split([supervisory_org],&quot;(&quot;,-1),&quot;)&quot;,1),&quot;)&quot;,1))=&quot;On Leave&quot; or &#13;&#10;&#13;&#10;(split(split(split([supervisory_org],&quot;(&quot;,-1),&quot;)&quot;,1),&quot;)&quot;,1))=&quot;Inherited&quot; then (split(split(split([supervisory_org],&quot;(&quot;,-2),&quot;)&quot;,1),&quot;)&quot;,1))&#13;&#10;ELSE (split(split(split([supervisory_org],&quot;(&quot;,-1),&quot;)&quot;,1),&quot;)&quot;,1))&#13;&#10; END)' />
      </column>
      <column caption='Previous Value' datatype='integer' hidden='true' name='[Calculation_1844787009296556032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD([employee_id]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='test' datatype='integer' hidden='true' name='[Calculation_1844787009297301506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([employee_id])&lt;&gt;[Calculation_1844787009296556032] then  COUNTD([employee_id]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index First' datatype='integer' hidden='true' name='[Calculation_1844787009299726339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FIRST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Updated Management Level' datatype='boolean' hidden='true' name='[Calculation_1844787009302765574]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1844787009296556032]=1 then NULL end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='New Hire/Termination' datatype='string' hidden='true' name='[Calculation_1844787009314414599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [first_day_of_work]&lt;=[Date (1st Day)] &#13;&#10;          then &quot;New Hire&quot;&#13;&#10;&#13;&#10;elseif  [Date (1st Day)]&gt;[last_day_of_work] then &quot;Termination&quot; &#13;&#10; END' />
      </column>
      <column caption='Select Measure Filter' datatype='string' name='[Calculation_1844787009933631501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Management Level&quot; THEN [Calculation_1346857774486241280 1]&#13;&#10;When &quot;Local vs Foreigner&quot; THEN [Calculation_1844787009946464275 1]&#13;&#10;When &quot;Gender&quot; THEN [Gender (group)]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Foreign/Local' datatype='string' name='[Calculation_1844787009946464275 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot; else  &quot;Foreigner&quot;  END' />
      </column>
      <column caption='foreign_local' datatype='string' name='[Calculation_1844787009946464275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT STARTSWITH([nric], &quot;S&quot; ) OR NOT STARTSWITH([nric], &quot;T&quot; )  then   &quot;Foreigner&quot;  ELSE &quot;Local&quot; END' />
      </column>
      <column caption='Month of today' datatype='boolean' hidden='true' name='[Calculation_1844787010033651735]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_1844787010035314712])== DATETRUNC(&apos;month&apos;, [Date (1st Day)])' />
      </column>
      <column caption='today' datatype='date' name='[Calculation_1844787010035314712]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
      </column>
      <column caption='Future New Hire filter' datatype='boolean' hidden='true' name='[Calculation_1844787010040426522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_day_of_work]) &gt;= &#13;&#10;DATETRUNC(&apos;month&apos;, [Calculation_1844787010035314712])' />
      </column>
      <column caption='Calculation2' datatype='boolean' hidden='true' name='[Calculation_1879126962437849094]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATETRUNC(&apos;month&apos;, [Calculation_1609192454821142533]))=[Parameters].[Parameter 1 2]' />
      </column>
      <column caption='Month Date 1st' datatype='datetime' hidden='true' name='[Calculation_1879126962438602760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_1609192454821142533])' />
      </column>
      <column caption='Date Selection Filter Final' datatype='boolean' hidden='true' name='[Calculation_1879126962443563017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Parameters].[Date Selection 1st Date (Months) Parameter])=DATETRUNC(&apos;month&apos;, [Calculation_1609192454821142533])' />
      </column>
      <column caption='intern' datatype='string' name='[Calculation_1933170198268485632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [contract_type] =  &apos;Intern (Fixed Term) (Trainee)&apos; or [business_title] = &quot;Intern &quot;  THEN &quot;Intern&quot; ELSE &quot;Non-Intern&quot; END' />
      </column>
      <column caption='Gender' datatype='string' name='[Calculation_1933170198519054341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[gender]' />
      </column>
      <column caption='Username' datatype='string' hidden='true' name='[Calculation_2078974208025362432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()' />
      </column>
      <column caption='Contractor' datatype='string' name='[Calculation_2606739767413026816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([employee_id],&quot;C-&quot;) then    &quot;Contractors&quot; END' />
      </column>
      <column caption='Exclusion' datatype='string' name='[Calculation_2606739767415476225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [employee_id]=&quot;2021-06-2514&quot; or&#13;&#10;[employee_id]=&quot;2021-05-0103&quot; or&#13;&#10;[employee_id]=&quot;2021-01-0279&quot; OR &#13;&#10;[employee_id]=&quot;2021-05-0528&quot;  then &quot;Exclude&quot; END' />
      </column>
      <column caption='Past 24 Months' datatype='date' datatype-customized='true' name='[Calculation_2653746092921155584]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Calculation_1844787010035314712])))' />
      </column>
      <column caption='Rolling 24 Months' datatype='date' name='[Calculation_2653746092921622529]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 0&#13;&#10;AND DATEDIFF(&apos;month&apos;, [Month], TODAY()) &lt;= 24&#13;&#10;THEN [Month] END' />
      </column>
      <column caption='quarter months' datatype='boolean' name='[Calculation_2703848637680345093]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if MONTH([Month]) =  3 or MONTH([Month])  = 6 or MONTH([Month]) = 9 or MONTH([Month]) = 12 then true end' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_2746632832564719621]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]&#13;&#10;&#13;&#10;= DATETRUNC(&apos;month&apos;,[Month])' />
      </column>
      <column caption='Manager Filter' datatype='string' name='[Calculation_2746632832918593547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  CONTAINS(LOWER([manager_10_name]),LOWER([Parameters].[Parameter 5 1])) or CONTAINS([manager_09_name],LOWER([Parameters].[Parameter 5 1])) OR &#13;&#10;CONTAINS(LOWER([manager_08_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_07_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_06_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_05_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_04_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_03_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_02_name]),LOWER([Parameters].[Parameter 5 1])) or &#13;&#10;CONTAINS(LOWER([manager_01_name]),LOWER([Parameters].[Parameter 5 1]))  then &quot;Yes&quot; END' />
      </column>
      <column caption='Number of Termination' datatype='string' default-role='measure' default-type='quantitative' hidden='true' name='[Calculation_2746632832936693772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [last_day_of_work]&lt;&gt;&quot;&quot; then [employee_id] END' />
      </column>
      <column caption='ytd' datatype='real' name='[Calculation_2748603205169430529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Date Filter (copy)_651333129793376256]-[Running Sum (Headcount) (#31-12-21#) (copy)_1343480123930951680])/[Running Sum (Headcount) (#31-12-21#) (copy)_1343480123930951680]' />
      </column>
      <column caption='FTE Type' datatype='string' name='[Calculation_3795971570169524224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fte]&gt;0.95 then      &quot;FTE&quot; else &quot;Non FTE&quot; END' />
      </column>
      <column caption='Sup Org Group' datatype='string' name='[Calculation_4316137332448124935]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  CONTAINS([supervisory_org],&quot;Inherited&quot;) THEN &quot;Inherited&quot; ELSE &quot;Non-Inherited&quot; END' />
      </column>
      <column caption='HOP M5/6 User Filter' datatype='boolean' name='[Calculation_4618722916343111680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[User Filter 2] or [User Filter HOP by Entity]' />
      </column>
      <column caption='Intern' datatype='string' name='[Calculation_528047076749164544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  CONTAINS([business_title],&quot;Intern &quot;) or [sub_type]=&quot;Intern (Fixed Term) (Trainee)&quot; then &quot;Intern&quot; ELSE&#13;&#10;&quot;Non-Intern&quot;  END' />
      </column>
      <column caption='Test date' datatype='date' hidden='true' name='[Calculation_561824065470517249]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if ISNULL([last_day_of_work]) then [first_day_of_work] else [last_day_of_work] END' />
      </column>
      <column caption='Calculated Department' datatype='string' hidden='true' name='[Calculation_624030032763146243]' role='dimension' type='nominal'>
