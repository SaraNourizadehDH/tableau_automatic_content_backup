      <column caption='Date Filter (copy 2)' datatype='boolean' name='[Date Filter (copy 2)_1950340170914426881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]&#13;&#10;&#13;&#10;= DATETRUNC(&apos;month&apos;,[Month])' />
      </column>
      <column caption='Date Filter (Current Month)' datatype='boolean' name='[Date Filter (copy 2)_777996853874253833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATETRUNC(&apos;month&apos;, [Calculation_1844787010035314712])) + str(DATETRUNC(&apos;year&apos;, [Calculation_1844787010035314712]) )&#13;&#10;&#13;&#10;= str(DATETRUNC(&apos;month&apos;, [Month])) + str(DATETRUNC(&apos;year&apos;, [Month]))' />
      </column>
      <column caption='Today&apos;s month filter' datatype='boolean' hidden='true' name='[Date Filter (copy)_1844787010036490265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_973903424978006017]&gt;DATETRUNC(&apos;month&apos;, [Calculation_1844787010035314712]) and [first_day_of_work]&lt;datetrunc(&apos;month&apos;,dateadd(&apos;month&apos;,1,[Calculation_1844787010035314712]))' />
