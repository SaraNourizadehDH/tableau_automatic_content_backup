      <column caption='Dept Cost ID' datatype='string' hidden='true' name='[Calculation_1099441267477311497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [cost_center_id]=&quot;3803010020&quot; then &quot;Biz Finance (FP&amp;A Controlling)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803010030&quot; then &quot;Finance Systems&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020010&quot; then &quot;TA&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020020&quot; then &quot;Comms &amp; Public Affairs&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020040&quot; then &quot;OPD&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020050&quot; then &quot;People Services&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020060&quot; then &quot;People technology&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020070&quot; then &quot;People Strategy, Analytics and Planning&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020080&quot; then &quot;Total Rewards&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803020090&quot; then &quot;Workplace&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803025000&quot; then &quot;Logistics Management&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803025020&quot; then &quot;GFS - Online Payment&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803025030&quot; then &quot;Kitchens &amp; Concepts - Innovation Management&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803025040&quot; then &quot;New Verticals (Shops)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803025110&quot; then &quot;IM - New Verticals (Darkstore)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803045010&quot; then &quot;Corporate Sales&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803045020&quot; then &quot;Sales Management&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803045070&quot; then &quot;Commercial&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803045080&quot; then &quot;Content&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803050000&quot; then &quot;Marketing&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803050030&quot; then &quot;Marketing - IM Kitchens&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803055000&quot; then &quot;Data&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060000&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060030&quot; then &quot;Internal IT&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060050&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060060&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060070&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060080&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060090&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060110&quot; then &quot;Tech G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803060120&quot; then &quot;Sales Management&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065000&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065010&quot; then &quot;Product Ops&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065030&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065040&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065050&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065070&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065080&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065090&quot; then &quot;Product G&amp;A&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803065110&quot; then &quot;Project Blue&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803070010&quot; then &quot;Corporate Strategy&quot;&#13;&#10;elseif [cost_center_id]=&quot;3803090000&quot; then &quot;Management under Woowa&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811010020&quot; then &quot;Biz Finance (FP&amp;A Controlling)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811010060&quot; then &quot;Finance G&amp;A - DMart&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811010070&quot; then &quot;Account, Regulatory and Reg Compliance&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811010080&quot; then &quot;Finance BP&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811010090&quot; then &quot;Finance Ops&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811020500&quot; then &quot;Woowa Korean Employees&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811030000&quot; then &quot;Legal (including GRC)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811030010&quot; then &quot;Legal (including GRC)&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811030020&quot; then &quot;Fintech Legal&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811070010&quot; then &quot;Corporate Strategy&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811070510&quot; then &quot;Woowa Korean Employees&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811070520&quot; then &quot;Woowa Korean Employees&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811080010&quot; then &quot;Procurement&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811090000&quot; then &quot;Management&quot;&#13;&#10;elseif [cost_center_id]=&quot;3811090500&quot; then &quot;Woowa Korean Employees&quot;&#13;&#10;END' />
