            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14ae6wm0m362zd1dietse19288xb (copy)'>
            <column caption='New Management Level' datatype='string' name='[Calculation_1346857774486241280 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_level]' />
            </column>
            <column caption='Select Measure Filter' datatype='string' name='[Calculation_1844787009933631501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Management Level&quot; THEN [Calculation_1346857774486241280 1]&#13;&#10;When &quot;Local vs Foreigner&quot; THEN [Calculation_1844787009946464275 1]&#13;&#10;When &quot;Gender&quot; THEN [Gender (group)]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_1844787009946464275 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot; else  &quot;Foreigner&quot;  END' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_1844787010035314712]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
            </column>
            <column caption='intern' datatype='string' name='[Calculation_1933170198268485632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [contract_type] =  &apos;Intern (Fixed Term) (Trainee)&apos; or [business_title] = &quot;Intern &quot;  THEN &quot;Intern&quot; ELSE &quot;Non-Intern&quot; END' />
            </column>
            <column caption='Gender' datatype='string' name='[Calculation_1933170198519054341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[gender]' />
            </column>
            <column caption='Contractor' datatype='string' name='[Calculation_2606739767413026816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([employee_id],&quot;C-&quot;) then    &quot;Contractors&quot; END' />
            </column>
            <column caption='Rolling 24 Months' datatype='date' name='[Calculation_2653746092921622529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 0&#13;&#10;AND DATEDIFF(&apos;month&apos;, [Month], TODAY()) &lt;= 24&#13;&#10;THEN [Month] END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_2746632832564719621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]&#13;&#10;&#13;&#10;= DATETRUNC(&apos;month&apos;,[Month])' />
            </column>
            <column caption='FTE Type' datatype='string' name='[Calculation_3795971570169524224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [fte]&gt;0.95 then      &quot;FTE&quot; else &quot;Non FTE&quot; END' />
            </column>
            <column caption='Intern' datatype='string' name='[Calculation_528047076749164544]' role='dimension' type='nominal'>
