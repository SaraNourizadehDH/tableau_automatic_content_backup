      <column caption='Annual Growth' datatype='real' name='[Calculation_732679365234745346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Running Sum (Headcount) (ytd) (copy)_3668463403273928727]-[Running Sum (Headcount) (#01-01-22#) (copy)_732679365230637056])/[Running Sum (Headcount) (#01-01-22#) (copy)_732679365230637056]' />
