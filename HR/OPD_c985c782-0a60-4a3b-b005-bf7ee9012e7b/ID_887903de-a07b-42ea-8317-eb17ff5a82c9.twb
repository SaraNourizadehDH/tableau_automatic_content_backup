            </column>
            <column datatype='date' datatype-customized='true' default-format='*mmmm yyyy' name='[Month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_806707294977368066]' derivation='Attribute' name='[attr:Calculation_806707294977368066:nk]' pivot='key' type='nominal' />
