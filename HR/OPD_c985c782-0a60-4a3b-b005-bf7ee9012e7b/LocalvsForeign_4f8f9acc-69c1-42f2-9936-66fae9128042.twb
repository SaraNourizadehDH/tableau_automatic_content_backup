    <worksheet name='[Local vs Foreign data] Local vs Foreign (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Foreign vs Local split  (Current Month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='worker (people_ops_proposed)' name='federated.14ae6wm0m362zd1dietse19288xb (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Date Level Selector' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14ae6wm0m362zd1dietse19288xb (copy)'>
            <column caption='Date Selection 1st Date' datatype='datetime' datatype-customized='true' name='[Calculation_1609192454821142533]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[Month])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[Month])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[Month])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[Month])&#13;&#10;END' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_1844787009946464275 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot; else  &quot;Foreigner&quot;  END' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_1844787010035314712]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
            </column>
            <column caption='Gender' datatype='string' name='[Calculation_1933170198519054341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[gender]' />
            </column>
            <column caption='Contractor' datatype='string' name='[Calculation_2606739767413026816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([employee_id],&quot;C-&quot;) then    &quot;Contractors&quot; END' />
            </column>
            <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2653746092921622529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 0&#13;&#10;AND DATEDIFF(&apos;month&apos;, [Month], TODAY()) &lt;= 24' />
            </column>
            <column caption='entity' datatype='string' name='[Calculation_879609363587268608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company]' />
            </column>
            <column caption='Date Filter (Current Month)' datatype='boolean' name='[Date Filter (copy 2)_777996853874253833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATETRUNC(&apos;month&apos;, [Calculation_1844787010035314712])) + str(DATETRUNC(&apos;year&apos;, [Calculation_1844787010035314712]) )&#13;&#10;&#13;&#10;= str(DATETRUNC(&apos;month&apos;, [Month])) + str(DATETRUNC(&apos;year&apos;, [Month]))' />
            </column>
            <column datatype='date' datatype-customized='true' default-format='*mmmm yyyy' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column caption='Cost Center Id' datatype='string' name='[cost_center_id]' role='dimension' type='nominal' />
            <column caption='Cost Center' datatype='string' name='[cost_center_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Innovation Managemen&quot;' value='Innovation Management' />
                <alias key='&quot;Sales Account Manage&quot;' value='Sales Account Management' />
              </aliases>
            </column>
            <column datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Department' datatype='string' name='[department_wd]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;ACCOUNTING&quot;' value='Accounting' />
              </aliases>
            </column>
            <column caption='Employee Id' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
