      <column caption='HOP M5/6 User Filter' datatype='boolean' name='[Calculation_4618722916343111680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[User Filter 2] or [User Filter HOP by Entity]' />
      </column>
      <column caption='Test date' datatype='date' hidden='true' name='[Calculation_561824065470517249]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if ISNULL([last_day_of_work]) then [first_day_of_work] else [last_day_of_work] END' />
