            <datasource caption='worker (people_ops_proposed)' name='federated.14ae6wm0m362zd1dietse19288xb (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Parameter' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-03-01#'>
              <calculation class='tableau' formula='#2023-03-01#' />
              <aliases>
                <alias key='#2021-09-01#' value='Sep 2021' />
              </aliases>
            </column>
            <column caption='Select Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gender&quot;'>
              <calculation class='tableau' formula='&quot;Gender&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14ae6wm0m362zd1dietse19288xb (copy)'>
            <column caption='New Management Level' datatype='string' hidden='true' name='[Calculation_1346857774486241280 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_level]' />
            </column>
            <column caption='Select Measure Filter' datatype='string' name='[Calculation_1844787009933631501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Management Level&quot; THEN [Calculation_1346857774486241280 1]&#13;&#10;When &quot;Local vs Foreigner&quot; THEN [Calculation_1844787009946464275 1]&#13;&#10;When &quot;Gender&quot; THEN [Gender (group)]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_1844787009946464275 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot; else  &quot;Foreigner&quot;  END' />
            </column>
            <column caption='Gender' datatype='string' name='[Calculation_1933170198519054341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[gender]' />
            </column>
            <column caption='SUM([headcount]) / TOTAL(SUM([headcount]))' datatype='real' name='[Calculation_216454273749639169]' role='measure' type='quantitative' user:unnamed='Gender (3)'>
              <calculation class='tableau' formula='SUM([headcount]) / TOTAL(SUM([headcount]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Contractor' datatype='string' name='[Calculation_2606739767413026816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([employee_id],&quot;C-&quot;) then    &quot;Contractors&quot; END' />
            </column>
            <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2653746092921622529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Month], TODAY()) &gt;= 0&#13;&#10;AND DATEDIFF(&apos;month&apos;, [Month], TODAY()) &lt;= 24' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_2746632832564719621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]&#13;&#10;&#13;&#10;= DATETRUNC(&apos;month&apos;,[Month])' />
            </column>
            <column caption='min(1)' datatype='integer' name='[Calculation_2746632832913240073]' role='measure' type='quantitative' user:unnamed='Gender (2)'>
              <calculation class='tableau' formula='min(1)' />
            </column>
            <column caption='FTE Type' datatype='string' name='[Calculation_3795971570169524224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [fte]&gt;0.95 then      &quot;FTE&quot; else &quot;Non FTE&quot; END' />
            </column>
            <column caption='entity' datatype='string' name='[Calculation_879609363587268608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company]' />
            </column>
            <column datatype='string' name='[Gender (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_1933170198519054341]' new-bin='true'>
                <bin default-name='false' value='&quot;Others&quot;'>
