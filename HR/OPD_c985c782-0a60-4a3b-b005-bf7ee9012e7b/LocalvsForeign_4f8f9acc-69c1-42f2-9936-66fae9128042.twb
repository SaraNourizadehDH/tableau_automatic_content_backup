AND (CAST(date_trunc('month', date(te.termination_effective_date)) AS date) >>= CAST(date_trunc('month',cast(wh.first_day_of_work as date)) AS date))
AND NOT (te.status = 'Canceled' OR te.status = 'Rescinded'))
OR (CAST(date_trunc('month', date(wh.first_day_of_work)) AS date) >> CAST(date_trunc('month',cast(wh.report_effective_date as date)) AS date))
THEN 0 ELSE 1 END AS headcount,
-- 
