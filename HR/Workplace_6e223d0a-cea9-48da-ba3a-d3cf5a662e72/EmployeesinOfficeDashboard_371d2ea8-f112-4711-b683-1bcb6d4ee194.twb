      </column>
      <column caption='Last' datatype='string' name='[Calculation_2902288512188243980]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF FIRST()=LAST()       THEN &quot;First/Last&quot;&#13;&#10;ELSEIF FIRST()=0        THEN &quot;First&quot;&#13;&#10;ELSEIF LAST()=0         THEN &quot;Last&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END'>
