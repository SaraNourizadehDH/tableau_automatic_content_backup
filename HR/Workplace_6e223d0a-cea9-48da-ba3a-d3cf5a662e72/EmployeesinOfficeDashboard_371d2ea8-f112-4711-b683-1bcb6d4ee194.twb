      <column caption='Name1' datatype='string' name='[Calculation_1126462886227943435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([last_name]) then [first_name] else [first_name]+&quot; &quot;+[last_name] END' />
