        </calculation>
      </column>
      <column caption='Manager Concat' datatype='string' name='[Calculation_1394427087069503489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([manager_01_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_02_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_03_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_04_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_05_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_06_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_07_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_08_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_09_full_name], &quot;&quot;) + &quot;, &quot; +&#13;&#10;IFNULL([manager_10_full_name], &quot;&quot;)' />
      </column>
      <column caption='New Department' datatype='string' name='[Calculation_1394427087071490052]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS(LOWER([Calculation_1394427087069503489]),&quot;jakob angele, davide vitiello&quot;) then &quot;Pandora Product&quot;&#13;&#10;elseif CONTAINS(LOWER([Calculation_1394427087069503489]),&quot;benjamin mann, sebastien rodriguez&quot;) then &quot;Pandora Tech&quot;&#13;&#10;elseif CONTAINS(LOWER([Calculation_1394427087069503489]),&quot;benjamin mann&quot;) then &quot;Other T&amp;P&quot;&#13;&#10;else &apos;None T&amp;P&apos;&#13;&#10;&#13;&#10; END' />
