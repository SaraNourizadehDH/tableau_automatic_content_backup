      <column caption='Market' datatype='string' name='[Calculation_1980739450808176644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_group]+&quot; - &quot;+[company_name]' />
      </column>
      <column caption='YTD Voluntary Rate %' datatype='real' name='[Calculation_1989746656753938433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([attrition (copy)_3508867089163247618])'>
          <table-calc ordering-type='Rows' />
        </calculation>
