        </calculation>
      </column>
      <column caption='current month &amp; year' datatype='boolean' name='[Calculation_2902288512193671188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='month([Month]) = MONTH(TODAY()) and YEAR([Month]) = year(TODAY())' />
