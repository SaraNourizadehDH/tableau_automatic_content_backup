      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# Men Tech &amp; Product (Year)' datatype='integer' name='[# Men Tech &amp; Product (Quarter) (copy)_2054204440342372379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Male&quot; and&#13;&#10; MONTH([Month])=12 &#13;&#10;then [headcount] END' />
            </column>
            <column caption='# Women Tech &amp; Product (Year)' datatype='integer' name='[# Women Tech &amp; Product (Quarter) (copy)_2054204440342372380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Female&quot; and&#13;&#10; MONTH([Month])=12 &#13;&#10; then [headcount] END' />
            </column>
            <column caption='# of Men Business Platform (Year)' datatype='integer' name='[# of Men Business Platform (Quarter) (copy)_2054204440339673110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; and [gender]=&quot;Male&quot; and&#13;&#10;MONTH([Month])=12   then [headcount] END' />
            </column>
            <column caption='# of Women Business Platform (Year)' datatype='integer' name='[# of Women Business Platform (Quarter) (copy)_2054204440339673111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; and [gender] = &apos;Female&apos; and&#13;&#10;MONTH([Month])=12    then [headcount] END' />
            </column>
            <column caption='% Women Business Platform  (Year)' datatype='real' name='[% Women Business Platform  (Quarter) (copy)_2054204440339673112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# of Women Business Platform (Quarter) (copy)_2054204440339673111])/(SUM([# of Women Business Platform (Quarter) (copy)_2054204440339673111])+SUM([# of Men Business Platform (Quarter) (copy)_2054204440339673110]))' />
            </column>
            <column caption='% Women Tech &amp; Product (Year)' datatype='real' name='[% Women Tech &amp; Product (Quarter) (copy)_2054204440342372381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Women Tech &amp; Product (Quarter) (copy)_2054204440342372380])/(SUM([# Women Tech &amp; Product (Quarter) (copy)_2054204440342372380])+SUM([# Men Tech &amp; Product (Quarter) (copy)_2054204440342372379]))' />
            </column>
            <column caption='Attrition Rate (Business Platform) (Year)' datatype='real' name='[Attrition Rate (Business Platform) (Quarter) (copy)_2054204440346304546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2435321555981295637])/((SUM([Business Platform beg_headcount (Quarter) (copy)_2054204440346365987])+SUM([Business Platform HC (Quarter) (copy)_2054204440340332569]))/2)' />
            </column>
            <column caption='Attrition Rate (Tech &amp; Product) Year' datatype='real' name='[Attrition Rate (Tech &amp; Product) Quarter (copy)_2054204440345206816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tech &amp; Product HC (copy)_2627850440023437334])/((SUM([Tech &amp; Product beg_headcount Quarter (copy)_2054204440345268257])+SUM([Tech &amp; Product HC (Quarter) (copy)_2054204440341954586]))/2)' />
            </column>
            <column caption='Business Platform HC (Year)' datatype='integer' name='[Business Platform HC (Quarter) (copy)_2054204440340332569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; then [end_yearheadcount] END' />
            </column>
            <column caption='Business Platform beg_headcount (Year)' datatype='integer' name='[Business Platform beg_headcount (Quarter) (copy)_2054204440346365987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; then [beg_yearheadcount] END' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
