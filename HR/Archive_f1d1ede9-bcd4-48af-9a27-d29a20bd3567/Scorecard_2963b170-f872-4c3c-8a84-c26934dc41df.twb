            <column caption='% of Women New Hires' datatype='real' name='[Calculation_5714364303253364738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# of Women (copy)_2627850439796232207])/(sum([# of Women (copy)_2627850439796232207])+sum([Calculation_5714364303253168128]))' />
