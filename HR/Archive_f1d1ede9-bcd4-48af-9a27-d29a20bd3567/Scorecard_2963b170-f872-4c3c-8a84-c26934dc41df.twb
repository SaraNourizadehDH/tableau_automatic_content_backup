      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# Men Tech &amp; Product' datatype='integer' name='[# Women Tech &amp; Product (copy)_2627850440024227864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Male&quot; then [headcount] END' />
            </column>
            <column caption='% Women Tech &amp; Product' datatype='real' name='[# Women Tech &amp; Product (copy)_2627850440024354842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tech &amp; Product Termination (copy)_2627850440023486487])/(SUM([Tech &amp; Product Termination (copy)_2627850440023486487])+SUM([# Women Tech &amp; Product (copy)_2627850440024227864]))' />
            </column>
            <column caption='Attrition Rate (Tech &amp; Product)' datatype='real' name='[Attrition Rate (copy)_2627850440028274716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tech &amp; Product HC (copy)_2627850440023437334])/((SUM([Tech &amp; Product beg_headcount Quarter (copy)_2054204440344330271])+SUM([Calculation_2627850440023093269]))/2)' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='Business Platform HC' datatype='integer' name='[Calculation_2435321555971751937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; then [headcount] END' />
            </column>
            <column caption='# of Women Business Platform' datatype='integer' name='[Calculation_2435321555972104195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; and [gender] = &apos;Female&apos; then [headcount] END' />
            </column>
            <column caption='% Women Business Platform ' datatype='real' name='[Calculation_2435321555979329552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2435321555972104195])/(SUM([Calculation_2435321555972104195])+SUM([# Women Tech &amp; Product (copy)_2627850440024227864]))' />
            </column>
            <column caption='Business Platform beg_headcount' datatype='integer' name='[Calculation_2435321555981139986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; then [beg_headcount] END' />
            </column>
            <column caption='Business Platform Termination' datatype='integer' name='[Calculation_2435321555981295637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; then [termination] END' />
            </column>
            <column caption='Attrition Rate (Business Platform)' datatype='real' name='[Calculation_2435321555982876695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2435321555981295637])/((SUM([Calculation_2435321555981139986])+SUM([Calculation_2435321555971751937]))/2)' />
            </column>
            <column caption='DHFS HC ' datatype='integer' name='[Calculation_2435321556013518875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [entity]=&quot;DH Financial Services APAC Holding Pte Ltd&quot; then [headcount] END' />
