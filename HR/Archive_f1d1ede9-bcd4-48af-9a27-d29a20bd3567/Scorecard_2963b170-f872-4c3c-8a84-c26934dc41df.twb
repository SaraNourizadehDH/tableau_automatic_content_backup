    <worksheet name='Quarterly Headcount'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11' underline='true'>Quarter Headcount</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# of Local' datatype='integer' name='[# of Women (copy)_2627850439796408336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_132363658274447362]=&quot;Local&quot; then [headcount] END' />
            </column>
            <column caption='Calculation2' datatype='string' name='[Calculation_118993602105729029]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &quot;year&quot; then str(year([Month]))&#10;&#10;elseif [Parameters].[Parameter 2] = &quot;quarter&quot; then str(year([Month])) + &quot;-&quot; + str(datepart(&apos;quarter&apos;, [Month])) &#10;end' />
            </column>
            <column caption='foreign/local' datatype='string' name='[Calculation_132363658274447362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &apos;S&apos; ) OR STARTSWITH([nric], &apos;T&apos; )  then   &quot;Local&quot; ELSE &quot;Foreigner&quot; END' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='Contingent Workers' datatype='integer' name='[Calculation_2627850439778504713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [type]=&quot;Contingent Worker&quot; then [headcount] else 0    END' />
            </column>
            <column caption='Quarter Filter ' datatype='boolean' name='[Calculation_4948048673177362432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(MONTH([Month])=3 OR MONTH([Month])=6 OR MONTH([Month])=9 OR MONTH([Month])=12,True,False)' />
            </column>
            <column caption='Permanent Employee' datatype='integer' name='[Contingent Workers (copy)_2627850439779282954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [type]=&quot;Employee&quot; and [contract_type] = &quot;Permanent&quot; then [headcount] else 0    END' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Intern HC' datatype='integer' name='[Permanent Employee (copy)_2627850439779393547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [contract_type]=&quot;Intern (Fixed Term) (Trainee)&quot; then [headcount] else 0    END' />
            </column>
            <column datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Headcount' datatype='integer' name='[headcount]' role='measure' type='quantitative' />
            <column-instance column='[Month]' derivation='Month' name='[mn:Month:ok]' pivot='key' type='ordinal' />
            <column caption='New Joiners' datatype='integer' name='[new_hire]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_118993602105729029]' derivation='None' name='[none:Calculation_118993602105729029:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1440026044013223936]' derivation='None' name='[none:Calculation_1440026044013223936:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4948048673177362432]' derivation='None' name='[none:Calculation_4948048673177362432:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[nric]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='Quarter' name='[qr:Month:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[# of Women (copy)_2627850439796408336]' derivation='Sum' name='[sum:# of Women (copy)_2627850439796408336:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2627850439778504713]' derivation='Sum' name='[sum:Calculation_2627850439778504713:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Contingent Workers (copy)_2627850439779282954]' derivation='Sum' name='[sum:Contingent Workers (copy)_2627850439779282954:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Permanent Employee (copy)_2627850439779393547]' derivation='Sum' name='[sum:Permanent Employee (copy)_2627850439779393547:qk]' pivot='key' type='quantitative' />
            <column-instance column='[headcount]' derivation='Sum' name='[sum:headcount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[new_hire]' derivation='Sum' name='[sum:new_hire:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='Year' name='[yr:Month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0kxjjjx0o6h0iq13pdjfo02maien].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
