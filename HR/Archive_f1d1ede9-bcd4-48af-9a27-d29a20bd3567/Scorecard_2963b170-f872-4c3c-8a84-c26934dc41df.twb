          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# Men Tech &amp; Product (Quarter)' datatype='integer' name='[# Men Tech &amp; Product (copy)_2054204440336285706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Male&quot; and&#13;&#10;(MONTH([Month])=3 or MONTH([Month])=6 or MONTH([Month])=9 or MONTH([Month])=12 )  &#13;&#10;then [headcount] END' />
            </column>
            <column caption='# Women Tech &amp; Product (Quarter)' datatype='integer' name='[# Women Tech &amp; Product (copy)_2054204440336285708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Female&quot; and&#13;&#10;(MONTH([Month])=3 or MONTH([Month])=6 or MONTH([Month])=9 or MONTH([Month])=12 )  &#13;&#10; then [headcount] END' />
            </column>
            <column caption='# of Women Business Platform (Quarter)' datatype='integer' name='[# of Women Business Platform (copy)_2054204440336760845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Business Platform&quot; and [gender] = &apos;Female&apos; and&#13;&#10;(MONTH([Month])=3 or MONTH([Month])=6 or MONTH([Month])=9 or MONTH([Month])=12 )   then [headcount] END' />
            </column>
            <column caption='% Women Business Platform  (Quarter)' datatype='real' name='[% Women Business Platform  (copy)_2054204440336760847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# of Women Business Platform (copy)_2054204440336760845])/(SUM([# of Women Business Platform (copy)_2054204440336760845])+SUM([# Men Tech &amp; Product (copy)_2054204440336285706]))' />
            </column>
            <column caption='% Women Tech &amp; Product (Quarter)' datatype='real' name='[% Women Tech &amp; Product (copy)_2054204440336285707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Women Tech &amp; Product (copy)_2054204440336285708])/(SUM([# Women Tech &amp; Product (copy)_2054204440336285708])+SUM([# Men Tech &amp; Product (copy)_2054204440336285706]))' />
            </column>
            <column caption='Attrition Rate (Business Platform) (Quarter)' datatype='real' name='[Attrition Rate (Business Platform) (copy)_2054204440338952213]' role='measure' type='quantitative'>
