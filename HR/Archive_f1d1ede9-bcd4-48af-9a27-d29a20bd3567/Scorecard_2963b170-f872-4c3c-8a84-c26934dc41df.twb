    <worksheet name='Diversity (Year)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11' underline='true'>Annual Diversity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# of Local' datatype='integer' name='[# of Women (copy)_2627850439796408336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_132363658274447362]=&quot;Local&quot; then [headcount] END' />
            </column>
            <column caption='# of Women' datatype='integer' name='[# of Women Leavers (copy)_2627850439796133902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Female&quot; then [headcount] END' />
            </column>
            <column caption='foreign/local' datatype='string' name='[Calculation_132363658274447362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &apos;S&apos; ) OR STARTSWITH([nric], &apos;T&apos; )  then   &quot;Local&quot; ELSE &quot;Foreigner&quot; END' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='# of women (employee only)' datatype='integer' name='[Calculation_4634907763642810373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Female&quot; and [type] = &apos;Employee&apos; then [headcount] END' />
            </column>
            <column caption='# of men (employee only)' datatype='integer' name='[Calculation_4634907763643088902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Male&quot; and [type] = &apos;Employee&apos; then [headcount] END' />
            </column>
            <column caption='% of women (employee)' datatype='real' name='[Calculation_4634907763643244551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4634907763642810373])/(sum([Calculation_4634907763642810373])+sum([Calculation_4634907763643088902]))' />
            </column>
            <column caption='# of Foreigner' datatype='integer' name='[Calculation_6911477380190609411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_132363658274447362]=&quot;Foreigner&quot; then [headcount] END' />
            </column>
            <column caption='% of Local' datatype='real' name='[Calculation_6911477380190662660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# of Women (copy)_2627850439796408336])/(sum([# of Women (copy)_2627850439796408336])+sum([Calculation_6911477380190609411]))' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Year Filter' datatype='boolean' name='[Quarter Filter  (copy)_4948048673177886721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;year&apos;, [Month])=#2022# then MONTH([Month])=month(TODAY()) else &#13;&#10;&#13;&#10;MONTH([Month])=12 END' />
            </column>
            <column datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Headcount' datatype='integer' name='[headcount]' role='measure' type='quantitative' />
            <column-instance column='[Month]' derivation='Month' name='[mn:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1440026044013223936]' derivation='None' name='[none:Calculation_1440026044013223936:nk]' pivot='key' type='nominal' />
