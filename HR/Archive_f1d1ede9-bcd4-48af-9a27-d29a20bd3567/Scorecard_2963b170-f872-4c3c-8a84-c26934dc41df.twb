          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# Men Tech &amp; Product' datatype='integer' name='[# Women Tech &amp; Product (copy)_2627850440024227864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Tech &amp; Product&quot; and [gender]=&quot;Male&quot; then [headcount] END' />
            </column>
            <column caption='% Women Tech &amp; Product' datatype='real' name='[# Women Tech &amp; Product (copy)_2627850440024354842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tech &amp; Product Termination (copy)_2627850440023486487])/(SUM([Tech &amp; Product Termination (copy)_2627850440023486487])+SUM([# Women Tech &amp; Product (copy)_2627850440024227864]))' />
            </column>
            <column caption='Attrition Rate (Tech &amp; Product)' datatype='real' name='[Attrition Rate (copy)_2627850440028274716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tech &amp; Product HC (copy)_2627850440023437334])/((SUM([Tech &amp; Product beg_headcount Quarter (copy)_2054204440344330271])+SUM([Calculation_2627850440023093269]))/2)' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='New Vertical HC' datatype='integer' name='[Calculation_1968424946502164480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Innovation Management&quot; then [headcount] END' />
            </column>
            <column caption='# of Women New Vertical ' datatype='integer' name='[Calculation_1968424946502443009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [segment]=&quot;Innovation Management&quot; and [gender]=&quot;Female&quot; then [headcount] END' />
            </column>
            <column caption='# of Men New Vertical' datatype='integer' name='[Calculation_1968424946502553602]' role='measure' type='quantitative'>
