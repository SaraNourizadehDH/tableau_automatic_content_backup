      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_118993602105729029]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &quot;year&quot; then str(year([Month]))&#10;&#10;elseif [Parameters].[Parameter 2] = &quot;quarter&quot; then str(year([Month])) + &quot;-&quot; + str(datepart(&apos;quarter&apos;, [Month])) &#10;end' />
      </column>
      <column caption='New Hire' datatype='integer' name='[Calculation_1208653558947577856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(If DATETRUNC(&apos;month&apos;, [first_day_of_work]) =DATETRUNC(&apos;month&apos;, [Month]) then [employee_id] end)' />
      </column>
      <column caption='New joiner Filter' datatype='boolean' name='[Calculation_1208653558948581377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If DATETRUNC(&apos;month&apos;, [first_day_of_work]) =DATETRUNC(&apos;month&apos;, [Month]) then true end' />
      </column>
      <column caption='isintern' datatype='string' name='[Calculation_1208653559199809538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [contract_type] =  &apos;Intern (Fixed Term) (Trainee)&apos; or [business_title] = &quot;Intern &quot;  THEN &quot;Intern&quot; ELSE &quot;Non-Intern&quot; END' />
      </column>
      <column caption='# of Leavers' datatype='integer' name='[Calculation_1208653559200194563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(If DATETRUNC(&apos;month&apos;, [Month])=DATETRUNC(&apos;month&apos;, [termination_date]) and (status != &quot;Rescinded&quot; or status != &quot;&#13;&#10;Canceled&quot;) then [employee_id] END)' />
      </column>
      <column caption='foreign/local' datatype='string' name='[Calculation_132363658274447362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([nric], &apos;S&apos; ) OR STARTSWITH([nric], &apos;T&apos; )  then   &quot;Local&quot; ELSE &quot;Foreigner&quot; END' />
      </column>
      <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
