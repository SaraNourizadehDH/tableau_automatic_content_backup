            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[nric]' role='dimension' type='nominal' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[# of Women (copy)_2627850439796408336]' derivation='Sum' name='[sum:# of Women (copy)_2627850439796408336:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2627850439778504713]' derivation='Sum' name='[sum:Calculation_2627850439778504713:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Contingent Workers (copy)_2627850439779282954]' derivation='Sum' name='[sum:Contingent Workers (copy)_2627850439779282954:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Permanent Employee (copy)_2627850439779393547]' derivation='Sum' name='[sum:Permanent Employee (copy)_2627850439779393547:qk]' pivot='key' type='quantitative' />
            <column-instance column='[headcount]' derivation='Sum' name='[sum:headcount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[new_hire]' derivation='Sum' name='[sum:new_hire:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='Year' name='[yr:Month:ok]' pivot='key' type='ordinal' />
