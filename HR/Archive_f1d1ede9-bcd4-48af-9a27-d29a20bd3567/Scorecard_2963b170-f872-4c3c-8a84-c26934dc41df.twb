    <worksheet name='termination (Year)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11' underline='true'>Annual Attrition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# of Regrettable Leavers' datatype='integer' name='[# of Women Leavers (copy)_2627850439789604877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_termination_regrettable]=&quot;1&quot; then [termination] END' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='# of voluntary leavers' datatype='integer' name='[Calculation_1492521067283410944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [termination_category] = &apos;Voluntary&apos; then [termination] end' />
            </column>
            <column caption='Attrition Rate (Year)' datatype='real' name='[Calculation_2158068706088591360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([termination])/ ((SUM([end_yearheadcount])+SUM([beg_yearheadcount]))/2)' />
            </column>
            <column caption='# of Women Leavers' datatype='integer' name='[Calculation_2627850439785029644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Female&quot; then [termination] END' />
            </column>
            <column caption='# of men leavers' datatype='integer' name='[Calculation_6911477380188557312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Male&quot; then [termination] END' />
            </column>
            <column caption='% of Women Leavers' datatype='real' name='[Calculation_6911477380188602369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2627850439785029644])/(sum([Calculation_2627850439785029644])+sum([Calculation_6911477380188557312]))' />
            </column>
            <column caption='% of Regrettable Leavers' datatype='real' name='[Calculation_6911477380188966914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# of Women Leavers (copy)_2627850439789604877])/sum([termination])' />
            </column>
            <column caption='% of Voluntary Leavers' datatype='real' name='[Calculation_6911477380193632262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1492521067283410944])/sum([termination])' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[beg_yearheadcount]' role='measure' type='quantitative' />
            <column datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
