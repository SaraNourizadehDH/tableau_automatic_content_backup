      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
          <calculation class='tableau' formula='&quot;month&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8B17DE6E234D44DAB5E360A90AC485CA'>
            <properties context=''>
              <relation connection='athena.0nb5iya1khggyv1ena0qe0acn83o' name='Custom SQL Query' type='text'><![CDATA[SELECT * FROM

(SELECT  cast(my.Month as date) as Month, 

cast(worker.first_day_of_work as date) as first_day_of_work, 
worker.employee_id,
worker.cost_center_id,
worker.time_type,
worker.worker_type,
worker.fte,
worker.worker_type as type,
worker.time_type as sub_type,
worker.contract_type,
worker.business_title,
worker.management_level,
worker.job_family,
worker.job_family_group,
worker.company_id,

cost_center_name, 
cost_center.segment, 
cost_center.functional_area_group,
cost_center.entity,

manager.managed_by_full_name as manager_name,   

termination.status,
termination.is_termination_regrettable,
termination.termination_category,
cast(termination.termination_effective_date as date) as termination_date,

personal.gender,
personal.nric,     
concat(personal.first_name,' ',personal.last_name) as name,

company.country,
company.company_name,
company.country_group,

--beg_monthheadcount
case when cast(worker.first_day_of_work as date) << cast(my.Month as date)and
( cast(my.Month as date) <<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date)or
cast(termination.termination_effective_date as date) is null)
then 1 end as beg_headcount,

--end_monthheadcount
case when cast(worker.first_day_of_work as date) << date_add('month',1,cast(my.Month as date)) and
( date_add('month',1,cast(my.Month as date)) <<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work or
termination.status='Canceled' or termination.status='Rescinded') then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date) or
cast(termination.termination_effective_date as date) is null)
then 1 end as headcount,


--leavers
case when date(termination.termination_effective_date) << date_add('month',1,cast(my.Month as date)) and (status<<>>'Rescinded' and status<<>>'Canceled')
then 1 end as leavers,

--end_yearheadcount
case when cast(worker.first_day_of_work as date) << date_add('year',1,date_trunc('year',cast(my.Month as date))) and
( date_add('year',1,date_trunc('year',cast(my.Month as date)))<<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date)or
cast(termination.termination_effective_date as date) is null) and MONTH(cast(my.Month as date))=12
then 1 end as end_yearheadcount,

--beg_yearheadcount
case when cast(worker.first_day_of_work as date) << date_trunc('year',cast(my.Month as date))and
( date_trunc('year',cast(my.Month as date)) <<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date)or
cast(termination.termination_effective_date as date) is null) and MONTH(cast(my.Month as date))=1
then 1 end as beg_yearheadcount,

--end_quarterheadcount
case when cast(worker.first_day_of_work as date) << date_add('quarter',1,date_trunc('quarter',cast(my.Month as date))) and
( date_add('quarter',1,date_trunc('quarter',cast(my.Month as date)))<<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date)or
cast(termination.termination_effective_date as date) is null) and
(MONTH(cast(my.Month as date))=3 or MONTH(cast(my.Month as date))=6 or MONTH(cast(my.Month as date))=9 or MONTH(cast(my.Month as date))=12)
then 1 end as end_quarterheadcount,

--beg_quarterheadcount
case when cast(worker.first_day_of_work as date) << date_add('quarter',0,date_trunc('quarter',cast(my.Month as date))) and
(date_add('quarter',0,date_trunc('quarter',cast(my.Month as date))) <<= cast(case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else date(termination.termination_effective_date) end as date)or
cast(termination.termination_effective_date as date) is null) and
(MONTH(cast(my.Month as date))=1 or MONTH(cast(my.Month as date))=4 or MONTH(cast(my.Month as date))=7 or MONTH(cast(my.Month as date))=10)
then 1 end as beg_quarterheadcount,

-- new hire
case when cast(date_trunc('month',date(worker.first_day_of_work)) as date) = cast(my.Month as date)
then 1 end as new_hire,

--tenure 
-- if still active employment
CASE 
WHEN (termination.termination_effective_date IS NULL) OR (worker.first_day_of_work >> termination.termination_effective_date) THEN (DATE_DIFF('day', cast(worker.first_day_of_work as date),NOW()))
ELSE (DATE_DIFF('day', cast(worker.first_day_of_work as date),cast(termination.termination_effective_date as date))) END AS length_of_service,

--termination
case when cast(date_trunc('month',date(termination.termination_effective_date )) as date) = cast(my.Month as date)and termination.status<<>>'Canceled' and termination.status<<>>'Rescinded'
then 1 end as termination



FROM people_ops_proposed.il_worker_org worker

LEFT JOIN people_ops_proposed.il_termination termination ON (worker.employee_id = termination.employee_id)
LEFT JOIN people_ops_proposed.il_cost_center_mapping_apac cost_center ON (cost_center.cost_center_id = worker.cost_center_id)
LEFT JOIN people_ops_proposed.il_manager manager ON (worker.employee_id = manager.employee_id)
LEFT JOIN people_ops_proposed.il_worker_personal personal ON (worker.employee_id = personal.employee_id)
LEFT JOIN people_ops_proposed.il_company_mapping company ON (cost_center.company_id = company.company_id)

Join people_ops_proposed.bl_calendar my
on to_date(my.month,'yyyy-mm-dd') between date_trunc('month', cast(worker.first_day_of_work as date))
and date_trunc('month', case when (termination.termination_effective_date is null or termination.termination_effective_date << worker.first_day_of_work) then date_parse('2050-01-01', '%Y-%m-%d')
else cast(termination.termination_effective_date as date) end)
)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
