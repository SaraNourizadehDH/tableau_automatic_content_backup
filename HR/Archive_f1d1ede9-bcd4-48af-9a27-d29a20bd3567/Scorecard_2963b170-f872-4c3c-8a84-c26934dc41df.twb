          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# Women DHFS (Quarter)' datatype='integer' name='[# Women DHFS (copy)_2054204440322879490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [entity]=&quot;DH Financial Services APAC Holding Pte Ltd&quot; and [gender]=&quot;Female&quot; and&#13;&#10;(MONTH([Month])=3 or MONTH([Month])=6 or MONTH([Month])=9 or MONTH([Month])=12 )  then [headcount] END' />
            </column>
            <column caption='# of Men DHFS (Quarter)' datatype='integer' name='[# of Men DHFS (copy)_2054204440322985987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [entity]=&quot;DH Financial Services APAC Holding Pte Ltd&quot; and [gender]=&quot;Male&quot; and &#13;&#10;(MONTH([Month])=3 or MONTH([Month])=6 or MONTH([Month])=9 or MONTH([Month])=12 ) then [headcount] END' />
            </column>
            <column caption='% Women DHFS (Quarter)' datatype='real' name='[% Women DHFS (copy)_2054204440322514945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# Women DHFS (copy)_2054204440322879490])/(sum([# Women DHFS (copy)_2054204440322879490])+sum([# of Men DHFS (copy)_2054204440322985987]))' />
            </column>
            <column caption='Attrition Rate (Quarter)' datatype='real' name='[Attrition Rate (copy 2)_2158068706125524996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([termination])/((SUM([beg_quarterheadcount])+SUM([end_quarterheadcount]))/2)' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
