            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='current month hc (2)' datatype='integer' name='[Calculation_2655153523730100224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if str(DATETRUNC(&apos;month&apos;, TODAY())) + str(DATETRUNC(&apos;year&apos;, TODAY()) )&#13;&#10;&#13;&#10;= str(DATETRUNC(&apos;month&apos;, [Month])) + str(DATETRUNC(&apos;year&apos;, [Month])) then [beg_headcount] END' />
            </column>
            <column caption='YTD Attrition Rate' datatype='real' name='[Calculation_4143593198106304513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([termination])/((SUM([Calculation_2655153523730100224])+SUM([beg_yearheadcount]))/2)' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Quarter Filter  (today)' datatype='boolean' name='[Quarter Filter  (copy)_4143593198105595904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC( &quot;month&quot;, [Month]) &lt;= DATETRUNC(&quot;month&quot;, TODAY() )' />
            </column>
            <column datatype='integer' name='[beg_headcount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[beg_yearheadcount]' role='measure' type='quantitative' />
