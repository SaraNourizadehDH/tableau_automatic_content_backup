    <worksheet name='Regrettable vs Unregrettable'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11' underline='true'>Regrettable Leavers by Entity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# of Unregrettable Leavers' datatype='integer' name='[# of Regrettable Leavers (copy)_1140255132816973826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_termination_regrettable]=&quot;0&quot; then [termination] END' />
            </column>
            <column caption='# of Regrettable Leavers' datatype='integer' name='[# of Women Leavers (copy)_2627850439789604877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_termination_regrettable]=&quot;1&quot; then [termination] END' />
            </column>
            <column caption='# of involuntary leavers' datatype='integer' name='[# of voluntary leavers (copy)_1140255132815306752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [termination_category] = &apos;Involuntary&apos; then [termination] end' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Unregrettable Rate' datatype='real' name='[Regrettable Rate  (copy)_1140255132873138184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# of Regrettable Leavers (copy)_1140255132816973826])/ ((SUM([end_yearheadcount])+SUM([beg_yearheadcount]))/2)' />
            </column>
            <column caption='Regrettable Rate ' datatype='real' name='[Voluntary Rate (copy)_1140255132872806405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# of Women Leavers (copy)_2627850439789604877])/ ((SUM([end_yearheadcount])+SUM([beg_yearheadcount]))/2)' />
            </column>
            <column datatype='integer' name='[beg_yearheadcount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[end_yearheadcount]' role='measure' type='quantitative' />
            <column datatype='string' name='[entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Bangladesh&quot;'>
                  <value>&quot;DH Kitchens (BD) Ltd&quot;</value>
                  <value>&quot;Delivery Hero Stores (Bangladesh) Limited&quot;</value>
                  <value>&quot;foodpanda Bangladesh Limited&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Cambodia&quot;'>
                  <value>&quot;\&quot;Delivery Hero (Cambodia) Co.&quot;</value>
                  <value>&quot;\&quot;Delivery Hero Dmart (Cambodia) Co.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Hong Kong&quot;'>
                  <value>&quot;Delivery Hero Food Hong Kong Limited&quot;</value>
                  <value>&quot;Delivery Hero Kitchens Hong Kong Limited&quot;</value>
                  <value>&quot;Delivery Hero Stores Hong Kong Limited&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Laos&quot;'>
                  <value>&quot;\&quot;Delivery Hero (Lao) Sole Co.&quot;</value>
                  <value>&quot;\&quot;Delivery Hero Dmart (Lao) Sole Co.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;MYSSC&quot;'>
                  <value>&quot;DH SSC Malaysia Sdn. Bhd.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Malaysia&quot;'>
                  <value>&quot;Delivery Hero Malaysia Sdn. Bhd.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Myanmar&quot;'>
                  <value>&quot;\&quot;Delivery Hero (Myanmar) Co.&quot;</value>
                  <value>&quot;\&quot;Delivery Hero Dmart Myanmar Co.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Pakistan&quot;'>
                  <value>&quot;Delivery Hero Kitchens PK&quot;</value>
                  <value>&quot;Delivery Hero Stores PK&quot;</value>
                  <value>&quot;R-SC Internet Serv Pk Ltd&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Philippines&quot;'>
                  <value>&quot;\&quot;Food Panda Philippines&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Regional&quot;'>
                  <value>&quot;DH Financial Services APAC Holding Pte Ltd&quot;</value>
                  <value>&quot;Delivery Hero APAC Pte. Limited&quot;</value>
                  <value>&quot;Delivery Hero Stores APAC Holding Pte Ltd&quot;</value>
                  <value>&quot;Woowa DH Asia Pte. Ltd.&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Singapore&quot;'>
                  <value>&quot;Delivery Hero (Singapore) Pte. Ltd.&quot;</value>
                  <value>&quot;Delivery Hero Kitchens Singapore Pte. Ltd.&quot;</value>
                  <value>&quot;Delivery Hero Stores (Singapore) Pte. Ltd.&quot;</value>
