    <worksheet name='YTD Annualised Attrition'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11' underline='true'>Yearly Attrition by Entity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.0kxjjjx0o6h0iq13pdjfo02maien' />
          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='current month hc (2)' datatype='integer' name='[Calculation_2655153523730100224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if str(DATETRUNC(&apos;month&apos;, TODAY())) + str(DATETRUNC(&apos;year&apos;, TODAY()) )&#13;&#10;&#13;&#10;= str(DATETRUNC(&apos;month&apos;, [Month])) + str(DATETRUNC(&apos;year&apos;, [Month])) then [beg_headcount] END' />
            </column>
            <column caption='[YTD Attrition Rate]/[Number of Months]*12' datatype='real' name='[Calculation_2655153523730780161]' role='measure' type='quantitative' user:unnamed='YTD Annualised Attrition'>
              <calculation class='tableau' formula='[Calculation_4143593198106304513]/[Calculation_698339484249473025]*12' />
            </column>
            <column caption='YTD Attrition Rate' datatype='real' name='[Calculation_4143593198106304513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([termination])/((SUM([Calculation_2655153523730100224])+SUM([beg_yearheadcount]))/2)' />
            </column>
            <column caption='Number of Months' datatype='integer' name='[Calculation_698339484249473025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,today())' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Quarter Filter  (today)' datatype='boolean' name='[Quarter Filter  (copy)_4143593198105595904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC( &quot;month&quot;, [Month]) &lt;= DATETRUNC(&quot;month&quot;, TODAY() )' />
            </column>
            <column datatype='integer' name='[beg_headcount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[beg_yearheadcount]' role='measure' type='quantitative' />
            <column-instance column='[Quarter Filter  (copy)_4143593198105595904]' derivation='None' name='[none:Quarter Filter  (copy)_4143593198105595904:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[type]' derivation='None' name='[none:type:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[termination]' role='measure' type='quantitative' />
            <column datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='Year-Trunc' name='[tyr:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2655153523730780161]' derivation='User' name='[usr:Calculation_2655153523730780161:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Month]' derivation='Year' name='[yr:Month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0kxjjjx0o6h0iq13pdjfo02maien].[none:Quarter Filter  (copy)_4143593198105595904:nk]'>
            <groupfilter function='member' level='[none:Quarter Filter  (copy)_4143593198105595904:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0kxjjjx0o6h0iq13pdjfo02maien].[none:segment:nk]'>
            <groupfilter function='level-members' level='[none:segment:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0kxjjjx0o6h0iq13pdjfo02maien].[none:status:nk]'>
            <groupfilter function='level-members' level='[none:status:nk]' />
          </filter>
          <filter class='categorical' column='[federated.0kxjjjx0o6h0iq13pdjfo02maien].[none:type:nk]' filter-group='4'>
