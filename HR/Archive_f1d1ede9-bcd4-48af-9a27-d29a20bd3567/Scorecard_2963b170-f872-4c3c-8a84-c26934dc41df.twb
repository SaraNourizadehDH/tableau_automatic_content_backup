          </datasources>
          <datasource-dependencies datasource='federated.0kxjjjx0o6h0iq13pdjfo02maien'>
            <column caption='# of Local New Hires' datatype='integer' name='[# of Local (copy)_2627850439796514833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_132363658274447362]=&quot;Local&quot; then [new_hire] END' />
            </column>
            <column caption='# of Women New Hires' datatype='integer' name='[# of Women (copy)_2627850439796232207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Female&quot; then [new_hire] END' />
            </column>
            <column caption='foreign/local' datatype='string' name='[Calculation_132363658274447362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([nric], &apos;S&apos; ) OR STARTSWITH([nric], &apos;T&apos; )  then   &quot;Local&quot; ELSE &quot;Foreigner&quot; END' />
            </column>
            <column caption='Entity - Country' datatype='string' name='[Calculation_1440026044013223936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &quot; - &quot; + [company_name]' />
            </column>
            <column caption='# of Male New Hires' datatype='integer' name='[Calculation_5714364303253168128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gender]=&quot;Male&quot; then [new_hire] END' />
            </column>
            <column caption='% of Women New Hires' datatype='real' name='[Calculation_5714364303253364738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# of Women (copy)_2627850439796232207])/(sum([# of Women (copy)_2627850439796232207])+sum([Calculation_5714364303253168128]))' />
            </column>
            <column caption='# of Foreign New Hires' datatype='integer' name='[Calculation_5714364303253880835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_132363658274447362]=&quot;Foreigner&quot; then [new_hire] END' />
            </column>
            <column caption='% of Local New Hires' datatype='real' name='[Calculation_5714364303253995524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([# of Local (copy)_2627850439796514833])/(sum([# of Local (copy)_2627850439796514833])+sum([Calculation_5714364303253880835]))' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='New Joiners' datatype='integer' name='[new_hire]' role='measure' type='quantitative' />
