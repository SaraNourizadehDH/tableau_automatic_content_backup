      <column caption='c.level category' datatype='string' name='[Calculation_3357152053934907392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='left([management_level],LEN([management_level])-1)' />
      </column>
      <column caption='c.emp span' datatype='string' name='[Calculation_4397272467754135556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Employee Id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSE&#10;(IF [Calculation_1682938946800185386]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-1&quot;&#10;ELSE&#10;(IF [c.ceo-1 (copy)_1682938946801229867]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-2&quot;&#10;ELSE&#10;(if [c.ceo-2 (copy)_1682938946801614892]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-3&quot;&#10;ELSE&#10;(IF  [c.ceo-3 (copy)_1682938946804650030]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-4&quot;&#10;ELSE&#10;(IF [c.ceo-4 (copy)_1682938946804760623]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-5&quot;&#10;ELSE&#10;(IF [c.ceo-5 (copy)_1682938946804854832]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-6&quot;&#10;ELSE&#10;(if [c.ceo-6 (copy)_1682938946804994097]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-7&quot;&#10;ELSE&#10;(if [c.ceo-3 (copy)_4397272467753488387]&lt;&gt;&quot;&quot;&#10;THEN&#10;&quot;CEO-8&quot;&#10;END)END)END)END)END)END)END)end)END' />
      </column>
      <column aggregation='CountD' caption='c.start pos -level 2' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_4397272468105482250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level]=&quot;IC5&quot; OR &#10;[management_level]=&quot;IC4&quot; OR &#10;[management_level]=&quot;IC1&quot; OR &#10;[management_level]=&quot;IC3&quot; OR &#10;[management_level]=&quot;IC2&quot;&#10;THEN&#10;[management_level (group)]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.start pos-level 3' datatype='real' name='[Calculation_4397272468105617419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([management_level])+[c.start pos -budget (copy)_4397272468085116937]-count([Calculation_4397272468105482250])'>
