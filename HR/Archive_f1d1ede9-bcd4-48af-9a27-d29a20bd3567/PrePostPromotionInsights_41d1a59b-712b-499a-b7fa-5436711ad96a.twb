      <column caption='c.manager' datatype='string' name='[Calculation_1682938946445373466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_people_manager]=&apos;1&apos;&#10;THEN&#10;[employee_id]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.man ratio-1' datatype='real' name='[Calculation_1682938946475139103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([Calculation_1682938946445373466])&lt;COUNT([c.manager (copy)_1682938946445545499])&#10;THEN&#10;1&#10;ELSE&#10;COUNT([Calculation_1682938946445373466])/COUNT([c.manager (copy)_1682938946445545499])&#10;END' />
      </column>
      <column caption='c.manager %' datatype='real' name='[Calculation_1682938946479284257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTd([c.manager (copy)_1682938946849787963])/(COUNTd([c.man-emp (copy)_1682938946868580418])+COUNTd([c.manager (copy)_1682938946849787963]))' />
      </column>
      <column caption='c.ceo-1' datatype='string' name='[Calculation_1682938946800185386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&quot;2020-06-2823&quot;&#10;THEN&#10;(&#10;IF ([Calculation_1682938947166634067]=&quot;2020-06-2823&quot; )&#10;THEN&#10;[Employee Id]&#10;ELSE&#10;NULL&#10;END&#10;)&#10;ELSEIF [Employee Id]=[Parameters].[Parameter 3]&#10;THEN&#10;[Employee Id]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.term-abr' datatype='string' name='[Calculation_1682938946866569281]' role='dimension' type='nominal'>
