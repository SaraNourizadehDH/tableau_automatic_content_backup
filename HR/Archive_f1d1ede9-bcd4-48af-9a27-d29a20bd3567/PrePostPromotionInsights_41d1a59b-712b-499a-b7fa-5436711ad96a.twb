              <calculation class='tableau' formula='IF {FIXED [employee_id]:COUNT([Calculation_6508053342383886336])}=0&#10;THEN&#10;[c.start pos -level 2 [post promo]] (copy)_283304602235600903]&#10;ELSE&#10;null&#10;&#10;END' />
