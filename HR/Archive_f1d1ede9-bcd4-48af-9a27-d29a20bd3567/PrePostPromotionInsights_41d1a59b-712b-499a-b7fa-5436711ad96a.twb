            <column caption='c.Emp or manager' datatype='string' name='[c.manager (copy)_1080371331802587140]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_people_manager]=&apos;1&apos;&#10;THEN&#10;&quot;People Manager&quot;&#10;ELSE&#10;&quot;Employee&quot;&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.level-IC' datatype='string' name='[c.post promo level -IC (copy)_283304602565169167]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([management_level]=&quot;IC6&quot; OR &#10;[management_level]=&quot;IC5&quot; OR &#10;[management_level]=&quot;IC4&quot; OR &#10;[management_level]=&quot;IC3&quot; OR &#10;[management_level]=&quot;IC1&quot; OR &#10;[management_level]=&quot;IC2&quot;)&#10;THEN&#10;[management_level]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.start pos -level' datatype='real' name='[c.start pos -budget (copy)_4397272468085116937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(window_max(COUNTd([employee_id]))-COUNT([employee_id]))/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
