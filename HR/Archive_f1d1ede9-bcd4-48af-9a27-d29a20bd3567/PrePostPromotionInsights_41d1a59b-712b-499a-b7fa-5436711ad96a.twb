        <column-instance column='[Calculation_4397272470906855446]' derivation='None' name='[none:Calculation_4397272470906855446:nk]' pivot='key' type='nominal' />
        <column-instance column='[Managers]' derivation='None' name='[none:Managers:nk]' pivot='key' type='nominal' />
        <column-instance column='[c.manager (copy)_1080371331802587140]' derivation='None' name='[none:c.manager (copy)_1080371331802587140:nk]' pivot='key' type='nominal' />
