    <worksheet name='WD-level split [post promo] (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='11'>Post Promotion Org Chart</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='WD-levelsplitpostpromo2' path='/t/HR/workbooks/Preandpostpromo-wk' revision='' site='HR' />
      <table>
        <view>
          <datasources>
            <datasource caption='Org Str-Custom SQL' name='federated.1eneugb1ulozxg18msjfj1yy1xca' />
          </datasources>
          <datasource-dependencies datasource='federated.1eneugb1ulozxg18msjfj1yy1xca'>
            <column caption='c.dept calc' datatype='string' name='[Calculation_1080371331780005891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance &amp; Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People &amp; Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.dept-tb filter' datatype='string' name='[Calculation_1682938947177443413]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1080371331780005891]' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_4397272469450493969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.off/non/ssc/disp-exc' datatype='string' name='[Calculation_4397272470906855446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([sub_department_wd], &quot;SSC&quot;)&#10;THEN&#10;&quot;Office-SSC/Dispatch (Excl)&quot;&#10;ELSEIF &#10;[sub_department_wd]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;Office-SSC/Dispatch (Excl)&quot;&#10;ELSEIF [Calculation_4397272469450493969]=&quot;Non-Office&quot;&#10;THEN&#10;&quot;Non-Office (Excl)&quot;&#10;ELSE&#10;&quot;Office (Incl)&quot;&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.post promo level' datatype='string' name='[Calculation_6508053342383886336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([Proposed Level (if promotion)])=TRUE,[management_level],[Proposed Level (if promotion)]&#10;)' />
            </column>
            <column datatype='string' name='[Manager ID concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
            <column datatype='string' name='[Proposed Level (if promotion)]' role='dimension' type='nominal' />
            <column-instance column='[c.post promo level (copy)_283304602563395598]' derivation='Attribute' name='[attr:c.post promo level (copy)_283304602563395598:nk]' pivot='key' type='nominal' />
            <column caption='c.Emp or manager' datatype='string' name='[c.manager (copy)_1080371331802587140]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_people_manager]=&apos;1&apos;&#10;THEN&#10;&quot;People Manager&quot;&#10;ELSE&#10;&quot;Employee&quot;&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.pp level -IC-abr' datatype='string' name='[c.post promo level (copy)_283304602563395598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (IFNULL([c.pp level-IC-wk1 (copy)_2074963198468325419],&apos;&apos;)+IFNULL([c.post promo level -IC (copy)_2074963198463344679],&apos;&apos;))=&apos;&apos;&#10;THEN&#10;null&#10;ELSE&#10;(IFNULL([c.pp level-IC-wk1 (copy)_2074963198468325419],&apos;&apos;)+IFNULL([c.post promo level -IC (copy)_2074963198463344679],&apos;&apos;))&#10;END' />
            </column>
            <column datatype='string' name='[c.post promo level (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_6508053342383886336]' new-bin='true'>
                <bin default-name='false' value='&quot;IC1, S1, S2 &amp; S3&quot;'>
                  <value>&quot;IC1&quot;</value>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                  <value>&quot;S3&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;IC2 &amp; S4&quot;'>
                  <value>&quot;IC2&quot;</value>
                  <value>&quot;S4&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M1 &amp; IC4&quot;'>
                  <value>&quot;IC4&quot;</value>
                  <value>&quot;M1&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M2 &amp; IC5&quot;'>
                  <value>&quot;IC5&quot;</value>
                  <value>&quot;M2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M3 &amp; IC6&quot;'>
                  <value>&quot;IC6&quot;</value>
                  <value>&quot;M3&quot;</value>
                </bin>
              </calculation>
            </column>
            <column aggregation='CountD' caption='c.pp level-IC-wk1' datatype='string' default-role='measure' default-type='quantitative' name='[c.post promo level -IC (copy)_2074963198463344679]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [employee_id]:COUNT([Calculation_6508053342383886336])}&gt;0&#10;THEN&#10;[c.post promo level -IC (copy)_2074963198464954408]&#10;ELSE&#10;null&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.pp level-IC' datatype='string' default-role='measure' default-type='quantitative' name='[c.post promo level -IC (copy)_2074963198464954408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6508053342383886336]=&quot;IC6&quot; OR &#10;[Calculation_6508053342383886336]=&quot;IC5&quot; OR &#10;[Calculation_6508053342383886336]=&quot;IC4&quot; OR &#10;[Calculation_6508053342383886336]=&quot;IC3&quot; OR &#10;[Calculation_6508053342383886336]=&quot;IC1&quot; OR &#10;[Calculation_6508053342383886336]=&quot;IC2&quot;&#10;THEN&#10;[Calculation_6508053342383886336]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.level-IC' datatype='string' name='[c.post promo level -IC (copy)_283304602565169167]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([management_level]=&quot;IC6&quot; OR &#10;[management_level]=&quot;IC5&quot; OR &#10;[management_level]=&quot;IC4&quot; OR &#10;[management_level]=&quot;IC3&quot; OR &#10;[management_level]=&quot;IC1&quot; OR &#10;[management_level]=&quot;IC2&quot;)&#10;THEN&#10;[management_level]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.pp level-IC-wk2' datatype='string' default-role='measure' default-type='quantitative' name='[c.pp level-IC-wk1 (copy)_2074963198468325419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [employee_id]:COUNT([Calculation_6508053342383886336])}=0&#10;THEN&#10;[c.post promo level -IC (copy)_283304602565169167]&#10;ELSE&#10;null&#10;END' />
            </column>
            <column caption='c.start pos -level [post promo]' datatype='real' name='[c.start pos -level (copy)_6508053342384779265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(window_max(COUNTd([employee_id]))-COUNTD([employee_id]))/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.start pos -level 2 [post promo]' datatype='integer' name='[c.start pos -level 2 (copy)_6508053342385102851]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([c.start pos -level 2 [post promo]] -wk 2 (copy)_2074963198466113577])+&#10;COUNTD([c.start pos -level 2 [post promo]] -wk 1 (copy)_283304602248904716])' />
            </column>
