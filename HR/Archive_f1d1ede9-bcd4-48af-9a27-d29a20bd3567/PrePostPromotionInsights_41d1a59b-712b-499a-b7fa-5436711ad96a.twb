    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Guidelines'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/Preandpostpromo-wk/Guidelines?rev=' id='Guidelines' path='/t/HR/workbooks/PrePostPromotionInsights' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='1100' maxwidth='1581' minheight='1100' minwidth='1581' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98546' id='3' type-v2='text' w='98988' x='506' y='727'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='20'>Note:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='16'>1. People managers-Any employee with active reports on WD</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='20'>Exclusions:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ee7522' fontsize='16'>WD: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>1. Interns</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>2. Anyone outside Tomaso&apos;s Org</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ef7336' fontsize='16'>Promotion exclusions:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='16'>1. Non Office (Operational worker, eg. Kitchens, Store staff, etc.)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='16'>2. Office (SSC  &amp; Agents)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='16'>3. Dispatchers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ff2600' fontsize='12'>Note: These exclusions may be subject to change until the 2023 Promotion Cycle</run>
              <run>Æ&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
