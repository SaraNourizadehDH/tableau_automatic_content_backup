    <worksheet name='WD-Manager levels (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Org Str-Custom SQL' name='federated.1eneugb1ulozxg18msjfj1yy1xca' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='CEO' caption='p.ceo-1 list' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;2020-06-2823&quot;'>
              <calculation class='tableau' formula='&quot;2020-06-2823&quot;' />
              <aliases>
                <alias key='&quot;2020-01-0022&quot;' value='COO' />
                <alias key='&quot;2020-06-0247&quot;' value='Q-commerce' />
                <alias key='&quot;2020-06-2813&quot;' value='Tech' />
                <alias key='&quot;2020-06-2821&quot;' value='People &amp; Culture' />
                <alias key='&quot;2020-06-2822&quot;' value='Comms and PA' />
                <alias key='&quot;2020-06-2823&quot;' value='CEO' />
                <alias key='&quot;2020-06-2824&quot;' value='Finance &amp; Legal' />
                <alias key='&quot;2020-06-2830&quot;' value='Product' />
                <alias key='&quot;2020-08-0133&quot;' value='Brand' />
                <alias key='&quot;2020-08-0388&quot;' value='Strategy &amp; Innovation' />
                <alias key='&quot;2020-09-0072&quot;' value='CBO' />
                <alias key='&quot;2021-09-0243&quot;' value='Social Commerce' />
              </aliases>
            </column>
