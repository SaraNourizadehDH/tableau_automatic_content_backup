            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[office_location_country]' derivation='None' name='[none:office_location_country:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_department_wd]' derivation='None' name='[none:sub_department_wd:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[office_location_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1080371331727900673]' derivation='CountD' name='[pcto:ctd:Calculation_1080371331727900673:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
