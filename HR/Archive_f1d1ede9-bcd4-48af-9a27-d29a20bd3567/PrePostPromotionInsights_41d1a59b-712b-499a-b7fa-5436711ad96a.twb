            <column caption='c.non-man ratio-1' datatype='real' name='[c.man ratio-1 (copy)_1682938946475495456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNT([Calculation_1682938946445373466])&lt;COUNT([c.manager (copy)_1682938946445545499])&#10;THEN&#10;COUNT([c.manager (copy)_1682938946445545499])/COUNT([Calculation_1682938946445373466])&#10;ELSE&#10;1&#10;END' />
