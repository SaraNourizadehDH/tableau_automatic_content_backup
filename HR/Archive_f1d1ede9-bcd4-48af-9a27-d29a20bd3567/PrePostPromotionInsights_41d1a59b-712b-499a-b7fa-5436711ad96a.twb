    <worksheet name='WD-level vs tenure'>
      <table>
        <view>
          <datasources>
            <datasource caption='Org Str-Custom SQL' name='federated.1eneugb1ulozxg18msjfj1yy1xca' />
          </datasources>
          <datasource-dependencies datasource='federated.1eneugb1ulozxg18msjfj1yy1xca'>
            <column aggregation='CountD' caption='c.eolm' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1080371331727900673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_terminated]=0&#10;THEN&#10;[employee_id]&#10;ELSEIF DATETRUNC(&apos;month&apos;,[last_day_of_work])=DATETRUNC(&apos;month&apos;,[report_effective_date])&#10;THEN&#10;[employee_id]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.dept calc' datatype='string' name='[Calculation_1080371331780005891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance &amp; Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People &amp; Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People &amp; Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column caption='c.dept-tb filter' datatype='string' name='[Calculation_1682938947177443413]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1080371331780005891]' />
            </column>
            <column caption='c.tenure' datatype='real' name='[Calculation_4397272468111724556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1080371331727900673]&lt;&gt;&apos;&apos;&#10;THEN&#10;([report_effective_date]-[first_day_of_work])/365&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_4397272469450493969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.off/non/ssc/disp-exc' datatype='string' name='[Calculation_4397272470906855446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([sub_department_wd], &quot;SSC&quot;)&#10;THEN&#10;&quot;Office-SSC/Dispatch (Excl)&quot;&#10;ELSEIF &#10;[sub_department_wd]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;Office-SSC/Dispatch (Excl)&quot;&#10;ELSEIF [Calculation_4397272469450493969]=&quot;Non-Office&quot;&#10;THEN&#10;&quot;Non-Office (Excl)&quot;&#10;ELSE&#10;&quot;Office (Incl)&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Manager ID concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4397272468111724556]' derivation='Avg' name='[avg:Calculation_4397272468111724556:qk]' pivot='key' type='quantitative' />
            <column caption='c.Emp or manager' datatype='string' name='[c.manager (copy)_1080371331802587140]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_people_manager]=&apos;1&apos;&#10;THEN&#10;&quot;People Manager&quot;&#10;ELSE&#10;&quot;Employee&quot;&#10;END' />
            </column>
            <column datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[employee_id]' role='dimension' type='nominal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[first_day_of_work]' role='dimension' type='ordinal' />
            <column datatype='string' name='[is_people_manager]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[is_terminated]' role='dimension' type='ordinal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[last_day_of_work]' role='dimension' type='ordinal' />
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[layer]' role='dimension' type='nominal' />
