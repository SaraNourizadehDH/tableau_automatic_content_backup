              <calculation class='tableau' formula='IF ([management_level]=&quot;IC6&quot; OR &#10;[management_level]=&quot;IC5&quot; OR &#10;[management_level]=&quot;IC4&quot; OR &#10;[management_level]=&quot;IC3&quot; OR &#10;[management_level]=&quot;IC1&quot; OR &#10;[management_level]=&quot;IC2&quot;)&#10;THEN&#10;[employee_id]&#10;ELSE&#10;NULL&#10;END' />
