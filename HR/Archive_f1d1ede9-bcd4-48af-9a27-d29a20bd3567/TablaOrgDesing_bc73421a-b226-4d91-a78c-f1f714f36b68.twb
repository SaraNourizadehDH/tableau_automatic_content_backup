        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.17ppaqm0jqgjce1eeplku06oi68s' name='consulta_sql_perso' type='text'>WITH Data_general AS (&#13;
    SELECT DISTINCT &#13;
        m.report_effective_date AS date_month,&#13;
        m.employee_id,&#13;
        CONCAT(wp.first_name, &apos; &apos;, wp.last_name) AS name,&#13;
        wo.business_title,&#13;
        wo.management_level,&#13;
        wo.job_family,&#13;
        wo.job_family_group,&#13;
        wo.office_location,&#13;
        wo.company_id,&#13;
        cm.country,&#13;
        cm.brand,&#13;
        NULL AS central_department,&#13;
        NULL AS central_sub_department,&#13;
        wo.department_wd,&#13;
        wo.sub_department_wd,&#13;
        wo.cost_center_id,&#13;
        ccw.cost_center_name,&#13;
        m.manager_id_01,&#13;
        m.manager_01_full_name,&#13;
        m.manager_id_02,&#13;
        m.manager_02_full_name,&#13;
        m.manager_id_03,&#13;
        m.manager_03_full_name,&#13;
        m.manager_id_04,&#13;
        m.manager_04_full_name,&#13;
        m.manager_id_05,&#13;
        m.manager_05_full_name,&#13;
        m.manager_id_06,&#13;
        m.manager_06_full_name,&#13;
        m.manager_id_07,&#13;
        m.manager_07_full_name,&#13;
        (CASE &#13;
            WHEN m.manager_id_03 IS NULL THEN &apos;Layer 1&apos;&#13;
            WHEN m.manager_id_04 IS NULL THEN &apos;Layer 2&apos;&#13;
            WHEN m.manager_id_05 IS NULL THEN &apos;Layer 3&apos;&#13;
            WHEN m.manager_id_06 IS NULL THEN &apos;Layer 4&apos;&#13;
            WHEN m.manager_id_07 IS NULL THEN &apos;Layer 5&apos;&#13;
            WHEN m.manager_id_08 IS NULL THEN &apos;Layer 6&apos;&#13;
            WHEN m.manager_id_09 IS NULL THEN &apos;Layer 7&apos;&#13;
            WHEN m.manager_id_10 IS NULL THEN &apos;Layer 8&apos;&#13;
            ELSE &apos;Unknown Layer&apos;&#13;
        END) AS layer&#13;
    FROM people_ops_proposed.il_manager_hist_with_current m&#13;
    LEFT JOIN people_ops_proposed.il_worker_hist_with_current wo &#13;
        ON wo.employee_id = m.employee_id &#13;
        AND wo.report_effective_date = m.report_effective_date&#13;
    LEFT JOIN people_ops_proposed.il_worker_personal wp &#13;
        ON m.employee_id = wp.employee_id &#13;
    LEFT JOIN people_ops_proposed.il_company_mapping cm &#13;
        ON wo.company_id = cm.company_id&#13;
    LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd ccw &#13;
        ON wo.cost_center_id = ccw.cost_center_id &#13;
where  wo.is_terminated=0&#13;
),&#13;
direct_reports AS (&#13;
    SELECT&#13;
        mm.managed_by,&#13;
        COUNT(*) AS direct_reports&#13;
    FROM people_ops_proposed.il_manager_hist_with_current mm&#13;
    LEFT JOIN people_ops_proposed.il_worker_hist_with_current woo &#13;
        ON mm.employee_id = woo.employee_id &#13;
        AND woo.report_effective_date = mm.report_effective_date&#13;
where woo.is_terminated=0&#13;
    GROUP BY mm.managed_by&#13;
)&#13;
SELECT DISTINCT&#13;
    dg.date_month,&#13;
    dg.employee_id,&#13;
    dg.name,&#13;
    dg.business_title,&#13;
    dg.management_level,&#13;
    dg.job_family,&#13;
    dg.job_family_group,&#13;
    dg.office_location,&#13;
    dg.company_id,&#13;
    dg.country,&#13;
    dg.brand,&#13;
    dg.department_wd,&#13;
    dg.sub_department_wd,&#13;
    dg.cost_center_id,&#13;
    dg.cost_center_name,&#13;
    dg.manager_id_01,&#13;
    dg.manager_01_full_name,&#13;
    dg.manager_id_02,&#13;
    dg.manager_02_full_name,&#13;
    dg.manager_id_03,&#13;
    dg.manager_03_full_name,&#13;
    dg.manager_id_04,&#13;
    dg.manager_04_full_name,&#13;
    dg.manager_id_05,&#13;
    dg.manager_05_full_name,&#13;
    dg.manager_id_06,&#13;
    dg.manager_06_full_name,&#13;
    dg.manager_id_07,&#13;
    dg.manager_07_full_name,&#13;
    dg.layer,&#13;
    COALESCE(SUM(dr.direct_reports), 0) AS total_direct_reports&#13;
FROM Data_general dg&#13;
LEFT JOIN direct_reports dr &#13;
    ON dg.employee_id = dr.managed_by&#13;
GROUP BY &#13;
    dg.date_month,&#13;
    dg.employee_id,&#13;
    dg.name,&#13;
    dg.business_title,&#13;
    dg.management_level,&#13;
    dg.job_family,&#13;
    dg.job_family_group,&#13;
    dg.office_location,&#13;
    dg.company_id,&#13;
    dg.country,&#13;
    dg.brand,&#13;
    dg.department_wd,&#13;
    dg.sub_department_wd,&#13;
    dg.cost_center_id,&#13;
    dg.cost_center_name,&#13;
    dg.manager_id_01,&#13;
    dg.manager_01_full_name,&#13;
    dg.manager_id_02,&#13;
    dg.manager_02_full_name,&#13;
    dg.manager_id_03,&#13;
    dg.manager_03_full_name,&#13;
    dg.manager_id_04,&#13;
    dg.manager_04_full_name,&#13;
    dg.manager_id_05,&#13;
    dg.manager_05_full_name,&#13;
    dg.manager_id_06,&#13;
    dg.manager_06_full_name,&#13;
    dg.manager_id_07,&#13;
    dg.manager_07_full_name,&#13;
    dg.layer</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
