            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Management level' caption='p.View By (Bars)' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Level&quot;'>
              <calculation class='tableau' formula='&quot;Management Level&quot;' />
              <aliases>
                <alias key='&quot;Management Level&quot;' value='Management level' />
                <alias key='&quot;Management Level Groups&quot;' value='Management level groups' />
                <alias key='&quot;Sub-Department&quot;' value='Sub-department' />
                <alias key='&quot;Tenure Category&quot;' value='Tenure category' />
              </aliases>
            </column>
            <column alias='Overall' caption='p.Women (Management Level)' datatype='string' datatype-customized='true' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;M2+&quot;' value='M2+' />
                <alias key='&quot;M3+&quot;' value='M3+' />
                <alias key='&quot;Overall&quot;' value='Overall' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zvncj0053cxpy1ark29f006or0g'>
            <column caption='% of All Women' datatype='real' default-format='p0.0%' name='[% of Women in leadership M2+ (copy)_1246089775269900304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Women M2+ (copy)_1246089775268270093]/COUNTD([employee_id]))' />
            </column>
            <column caption='% of Women in leadership M2+' datatype='real' default-format='p0.0%' name='[% of Women in leadership M3+ (copy)_5615988778474348558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Women M3+ (copy)_5615988778474070028]/[Total M3+ (copy)_5615988778474086413])' />
            </column>
            <column caption='_management level (tooltip)' datatype='string' name='[Calculation_1194861282907471873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &quot;Overall&quot; THEN &quot;All Management Levels&quot; ELSE STR([Parameters].[Parameter 7]) END' />
            </column>
            <column caption='_management_level (select)' datatype='string' name='[Calculation_1857171902607921153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]  &#13;&#10;    WHEN &quot;M1+&quot; THEN [management_level (group) M2+ (copy)_105834602256068612]&#13;&#10;    WHEN &quot;M2+&quot; THEN [management_level (group) M3+ (copy)_5615988778385653760]&#13;&#10;    WHEN &quot;M3+&quot; THEN [management_level (group) M3+] &#13;&#10;    WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;M Level and above&quot;' value='M1+' />
              </aliases>
            </column>
            <column caption='_sort stacked bar by dept/sub-dept' datatype='real' name='[Calculation_1927259173620318227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7] &#13;&#10;    WHEN &quot;M3+&quot; THEN [Calculation_5615988778463821834]&#13;&#10;    WHEN &quot;M2+&quot; THEN [% of Women in leadership M3+ (copy)_5615988778474348558]&#13;&#10;    ELSE [% of Women in leadership M2+ (copy)_1246089775269900304]&#13;&#10;END' />
            </column>
            <column caption='_Show stacked bar (Dept/Sub-Dept)' datatype='boolean' name='[Calculation_1927259173621112852]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &quot;Department&quot; OR [Parameters].[Parameter 13] = &quot;Sub-Department&quot;&#13;&#10;    THEN TRUE &#13;&#10;ELSE &#13;&#10;    FALSE &#13;&#10;END' />
            </column>
            <column caption='_INDEX()' datatype='boolean' name='[Calculation_2322731514126688264]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX()=1&#13;&#10;&#13;&#10;//Used to hide 2nd column (&quot;others&quot;) in the 100% Stacked bar chart by gender'>
                <table-calc ordering-type='Rows' />
              </calculation>
              <desc>
                <formatted-text>
                  <run>Used to hide 2nd column (&quot;others&quot;) in the 100% Stacked bar chart by gender</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='_Headcount' datatype='integer' name='[Calculation_2428847580056133635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([employee_id])' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939638898689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
            </column>
            <column caption='Women M3+' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5615988778462920712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [gender] = &quot;Female&quot; AND [management_level (group) M3+] = &quot;M3+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
