      <column caption='u.User Filter (Data Source level)' datatype='string' name='[Calculation_1020065330456604672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF USERNAME()=(&apos;benjamin.mann@deliveryhero.com&apos;) THEN &#13;&#10;IF [department] = &apos;DH Tech&apos; THEN 1 ELSE 0 END &#13;&#10;&#13;&#10;ELSEIF USERNAME()=(&apos;abdulrahman.alswaha@hungerstation.com&apos;) THEN 1&#13;&#10;ELSEIF USERNAME()=(&apos;batuhan.sagirdas@deliveryhero.com&apos;) THEN 1&#13;&#10;ELSEIF USERNAME()=(&apos;inna.skochko@deliveryhero.com&apos;) THEN 1&#13;&#10;ELSEIF USERNAME()=(&apos;laura.martinpastor@glovoapp.com&apos;) THEN 1&#13;&#10;ELSEIF USERNAME()=(&apos;sibel.kundes@deliveryhero.com&apos;) THEN 1&#13;&#10;ELSEIF USERNAME()=(&apos;thom.van@deliveryhero.com&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;DH People Leadership&apos;) THEN 1 &#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;eFood - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;DH Europe - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Foodpanda - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Foodpanda - Administrator Limited&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Hungerstation - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Pedidos Ya - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Talabat - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Yemeksepeti - Administrator&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - Administrator&apos;) THEN 1&#13;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - People Leadership&apos;) THEN 1&#13;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - People Partners&apos;) THEN 1&#13;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - Talent Development&apos;) THEN 1&#13;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - Total Rewards&apos;) THEN 1&#13;&#10;&#13;&#10;ELSEIF ISMEMBEROF(&apos;People - PMO&apos;) THEN 1&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='u.user.name' datatype='string' name='[Calculation_1020065330456756225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([work_email_manager_03],&apos;@deliveryhero.com&apos;,&quot;&quot;)' />
      </column>
      <column caption='Current Month' datatype='real' name='[Calculation_1022598595982622728]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_2932124872702570505]&#13;&#10;&#13;&#10;//This field is spefically used in Select Dimensions bar chart as a field label'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SMLY' datatype='real' name='[Calculation_1022598595982962697]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_2177208949032919041]&#13;&#10;&#13;&#10;//This field is spefically used in Select Dimensions bar chart as a field label'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date (Previous Month - Landing Page)' datatype='date' name='[Calculation_1221038458152103936]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MIN([report_month]) = DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Color - View By (Bars - Others)' datatype='string' name='[Calculation_1405686038002167814]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//IF COUNTD([Measure Filter])=1 THEN &quot;1&quot; ELSE &quot;0&quot; END&#13;&#10;&#13;&#10;IF ISNULL(ATTR([Calculation_5720415998002348032])) THEN&#13;&#10;    &quot;0&quot;  // No color for NULL values&#13;&#10;ELSEIF WINDOW_MAX(COUNTD([Calculation_5720415998002348032])) = 1 THEN&#13;&#10;    &quot;1&quot;  // Color only the grand total row&#13;&#10;ELSE&#13;&#10;    &quot;2&quot;  // No color for other rows&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date (&gt;= 2023)' datatype='date' name='[Calculation_1405686038205845512]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [report_month]) &gt;= 2023 THEN [report_month] END' />
      </column>
      <column caption='c.Bool (&lt;= Today)' datatype='boolean' name='[Calculation_1728537841107714049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] &lt;= DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='c.View By (Bars - Dept/Sub-Dept)' datatype='boolean' name='[Calculation_1927259173690359893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &quot;Department&quot; OR [Parameters].[Parameter 13] = &quot;Sub-Department&quot; &#13;&#10;    THEN TRUE &#13;&#10;ELSE &#13;&#10;    FALSE &#13;&#10;END' />
      </column>
      <column caption='c.Target (Reference Line)' datatype='real' name='[Calculation_1927259173691752536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*ATTR(&#13;&#10;    IF [brand] = &quot;Delivery Hero&quot; THEN &#13;&#10;        0.94&#13;&#10;    ELSE&#13;&#10;        0.915&#13;&#10;    END&#13;&#10;)&#13;&#10;*/&#13;&#10;&#13;&#10;IF MIN([brAND]) = &quot;Delivery Hero&quot; AND COUNTD([brAND]) = 1 THEN&#13;&#10;    0.94&#13;&#10;ELSEIF MIN([brAND]) != &quot;Delivery Hero&quot; THEN&#13;&#10;    0.915&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='c.Filter - Employee level table (Exclude data)' datatype='boolean' name='[Calculation_1991435476912775168]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Calculation_3049499900148760632]) + SUM([Calculation_2932124872704397322]) &gt;= 1' />
      </column>
      <column caption='c.Headcount yoy (High Performers)' datatype='real' default-format='p0.0%' name='[Calculation_2177208949032919041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;        1-WINDOW_SUM([Calculation_3049499900150386745], -23, -12)&#13;&#10;    ELSE &#13;&#10;        NULL&#13;&#10;    END&#13;&#10;,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Brand 1' datatype='boolean' name='[Calculation_2177208949137743876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brAND] = [Parameters].[Parameter 12]' />
      </column>
      <column caption='c.Filter - Brands (Trend - Brand)' datatype='integer' name='[Calculation_2261088533158719492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brAND] = [Parameters].[Parameter 12] &#13;&#10;    OR [brAND] = [Parameters].[Attribute 1 (copy)_2261088533158469635] &#13;&#10;    OR [brAND] = [Parameters].[Attribute 2 (copy)_2261088533159288837] &#13;&#10;THEN &#13;&#10;    1 &#13;&#10;ELSE &#13;&#10;    0 &#13;&#10;END' />
      </column>
      <column caption='c.Bool (YTD)' datatype='boolean' name='[Calculation_2351441957802721280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, [Parameters].[Parameter 15])&#13;&#10;AND [report_month] &lt;= [Parameters].[Parameter 15]&#13;&#10;&#13;&#10;&#13;&#10;// Dec PY to date selected&#13;&#10;/*DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [End Date (HIPe)])) &#13;&#10;   AND DATEPART(&apos;month&apos;, [report_month]) = 12&#13;&#10;   OR (DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, [End Date (HIPe)])&#13;&#10;       AND [report_month] &lt;= [End Date (HIPe)])&#13;&#10;*/' />
      </column>
      <column caption='c.Headcount avg ytd (High Performers)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2351441957802983425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_2351441957802721280] = TRUE THEN &#13;&#10;        [Calculation_3049499900148760632]&#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [Calculation_2351441957802721280] = TRUE THEN &#13;&#10;        DATETRUNC(&apos;month&apos;,[report_month])&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='c.Voluntary Effective Terminations - HiPe (ytd)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2351441957803270146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(&#13;&#10;    IF [Calculation_2351441957802721280] = TRUE THEN &#13;&#10;        [Calculation_2932124872704397322]&#13;&#10;    END&#13;&#10;),0)' />
      </column>
      <column caption='c.Scale By (Trends)' datatype='real' name='[Calculation_2352004915375144964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Zoom Axis (copy)_2352004915374612483] = TRUE THEN&#13;&#10;    0.7&#13;&#10;ELSE&#13;&#10;    MAX([Calculation_2177208949032919041],[Calculation_2932124872702570505])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_% HiPe (vs Target)' datatype='real' default-format='*0.0' name='[Calculation_2352004915390742536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2352004915572977683]&#13;&#10;- &#13;&#10;[Calculation_1927259173691752536]&#13;&#10;&#13;&#10;//This calculated field gets the difference between the Target and the actual Retention Rate %'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Color - Green (Target KPI)' datatype='string' name='[Calculation_2352004915391975433]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2352004915390742536] &gt; 0 THEN &#13;&#10;    &quot;▲ &quot; + STR(ROUND(ABS([Calculation_2352004915390742536]) * 100, 1)) + &quot;%&quot;&#13;&#10;ELSE &#13;&#10;    &quot;&quot; &#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_% HiPe (YTD)' datatype='real' default-format='p0.0%' name='[Calculation_2352004915572359186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Dec PY&#13;&#10;LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF DATEPART(&apos;month&apos;, min([report_month])) = 12 &#13;&#10;            AND DATEPART(&apos;year&apos;, min([report_month])) = DATEPART(&apos;year&apos;, [Parameters].[Parameter 9]) - 1 THEN&#13;&#10;            [Calculation_2932124872702570505]&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_% HiPe (Latest Month)' datatype='real' default-format='p0.0%' name='[Calculation_2352004915572977683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF MIN([report_month]) = [Parameters].[Parameter 9] THEN&#13;&#10;            ([Calculation_2932124872702570505])&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.% change moving avg (ytd)' datatype='real' name='[Calculation_2352004915573301268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2352004915572977683] - [Calculation_2352004915572359186] ) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_% HiPe (YTD Landing static)' datatype='real' name='[Calculation_2352004915577937942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    //Last Month from Today&#13;&#10;    LOOKUP(&#13;&#10;        WINDOW_SUM(&#13;&#10;            IF MIN([report_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#13;&#10;                [Calculation_2932124872702570505]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        LAST()&#13;&#10;    )&#13;&#10;    -&#13;&#10;    //Dec PY&#13;&#10;    LOOKUP(&#13;&#10;        WINDOW_SUM(&#13;&#10;            IF DATEPART(&apos;month&apos;, min([report_month])) = 12 &#13;&#10;                AND DATEPART(&apos;year&apos;, min([report_month])) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;                [Calculation_2932124872702570505]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        LAST()&#13;&#10;    )&#13;&#10;) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Bool (Date Range)' datatype='boolean' name='[Calculation_2491053555622146050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] &gt;= [Parameters].[Parameter 2] AND [report_month] &lt;= [Parameters].[Parameter 9]' />
      </column>
      <column caption='Review Template Final' datatype='boolean' name='[Calculation_2932124870911705089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEPART(&apos;year&apos;, [report_month])=2023 then [review_template (group)]=&quot;2022 End of year&quot; elseif&#13;&#10;DATEPART(&apos;year&apos;, [report_month])=2024 then [review_template (group)]=&quot;2023 End of year&quot; elseif&#13;&#10;DATEPART(&apos;year&apos;, [report_month])=2022 then [review_template (group)]=&quot;2021 End of year&quot; &#13;&#10;END' />
      </column>
      <column caption='c.Voluntary Effective Terminations %' datatype='real' name='[Calculation_2932124870937792514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(lookup(SUM([Calculation_5022076552060018788])/SUM([actuals]),0))'>
          <table-calc ordering-field='[federated.1hzr71m0dwgn0b1504swj1dw3zl3].[report_month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='c.12-month rolling effective retention of HiPe' datatype='real' default-format='p0.0%' name='[Calculation_2932124872702570505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;        1-WINDOW_SUM([Calculation_3049499900150386745], -11, 0)&#13;&#10;    ELSE &#13;&#10;        NULL&#13;&#10;    END&#13;&#10;,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Voluntary Effective Terminations - HiPe' datatype='integer' name='[Calculation_2932124872704397322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_3049499900148633655] THEN &#13;&#10;        [Calculation_5022076552060018788]&#13;&#10;    END&#13;&#10;,0)' />
      </column>
      <column caption='c.% change moving avg (yoy)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2932124873078169617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF SUM([_HIPe Headcount])&gt;= 4 THEN ((1-(WINDOW_SUM([Voluntary Termination Rate %], -11, 0))&#13;&#10; //- (1-WINDOW_SUM([Voluntary Termination Rate %], -23, -12)))*100) else NULL end&#13;&#10;&#13;&#10;IF SUM([Calculation_3049499900148760632]) &gt;= 4 THEN&#13;&#10;    (&#13;&#10;        (&#13;&#10;            1-(WINDOW_SUM([Calculation_3049499900150386745], -11, 0))&#13;&#10;            - (1-WINDOW_SUM([Calculation_3049499900150386745], -23, -12))&#13;&#10;        ) * 100&#13;&#10;    )&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Bool (Is Previous Month?)' datatype='boolean' name='[Calculation_2932124873389195296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[report_month]) = datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())) AND YEAR([report_month]) = YEAR(TODAY()) THEN True else FALSE end' />
      </column>
      <column caption='c.Color - Overall - KPI (yoy % change moving avg)' datatype='string' name='[Calculation_2932124873405382689]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2932124873078169617]&lt;0 then &quot;Red&quot; &#13;&#10;ELSEIF [Calculation_2932124873078169617]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [Calculation_2932124873078169617]&gt;0 then &quot;Green&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153 1]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
      </column>
      <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939639775236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brAND] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
      </column>
      <column caption='c.Voluntary Effective Terminations - HiPe (ytd - M3+)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3049499900117389342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    SUM(&#13;&#10;        IF [Calculation_2351441957802721280] = TRUE AND [management_level (group)] = &apos;M3+&apos; THEN &#13;&#10;            [Calculation_2932124872704397322]&#13;&#10;        END&#13;&#10;    )&#13;&#10;,0)' />
