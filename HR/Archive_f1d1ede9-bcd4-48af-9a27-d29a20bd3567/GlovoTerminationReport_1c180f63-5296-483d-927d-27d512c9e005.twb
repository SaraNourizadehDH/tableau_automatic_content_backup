            <column caption='Color M+ Men (yoy)' datatype='string' name='[Color M2+/M3+ yoy (Women) (copy)_1927259173661466678]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Mgmt Level (copy)_1952028970592219156] &#13;&#10;    WHEN &quot;M3+&quot; THEN [Color M3+ yoy (Women) (copy)_1927259173661118515]&#13;&#10;    WHEN &quot;M2+&quot; THEN [Color M2+ yoy (Women) (copy)_1927259173660803122]&#13;&#10;    WHEN &quot;M1+&quot; THEN [Color M2+ Men (yoy) (copy)_105834602276274202]&#13;&#10;&#13;&#10;END'>
