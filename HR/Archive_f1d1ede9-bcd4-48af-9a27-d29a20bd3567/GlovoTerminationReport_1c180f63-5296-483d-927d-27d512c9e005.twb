              <calculation class='tableau' formula='if [yoy changes M3+ (Men) (copy)_2322731514218790944]&lt;0 then &quot;Red&quot; &#13;&#10;ELSEIF [yoy changes M3+ (Men) (copy)_2322731514218790944]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [yoy changes M3+ (Men) (copy)_2322731514218790944]&gt;0 then &quot;Green&quot; END'>
                <table-calc ordering-type='Rows' />
