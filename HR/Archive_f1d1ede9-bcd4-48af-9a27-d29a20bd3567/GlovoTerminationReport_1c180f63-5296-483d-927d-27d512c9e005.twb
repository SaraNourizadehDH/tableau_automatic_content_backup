    <worksheet name='3) Women in leadership (Stacked Bars - Overall M+ view)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontname='Tableau Book' fontsize='10'>Detailed view</run>
          </formatted-text>
