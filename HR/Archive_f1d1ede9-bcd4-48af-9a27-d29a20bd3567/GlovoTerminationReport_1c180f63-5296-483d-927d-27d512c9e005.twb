      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Data Quality Score' id='_D24E4E45D2424E39927576DFDA3F0818'>
            <properties context=''>
              <relation connection='athena.031h77a0tywrhc1a8t8ng16lblk7' name='Custom SQL Query1' type='text'>SELECT metric&#13;
    ,brand1&#13;
    ,department&#13;
    ,sub_department&#13;
    ,round(sum(avg_data_quality_score) / sum(priority_of_column_ratio),2) AS wt_data_quality_score&#13;
    ,round(sum(avg_accuracy_score) / sum(priority_of_column_ratio),2) AS wt_accuracy&#13;
    ,round(sum(avg_completeness_score) / sum(priority_of_column_ratio),2) AS wt_completeness&#13;
    ,round(sum(avg_uniqueness_score) / sum(priority_of_column_ratio),2) AS wt_uniqueness&#13;
  ,round(sum(avg_timeliness_score) / sum(priority_of_column_ratio),2) AS wt_timeliness&#13;
FROM (&#13;
    SELECT a.metric&#13;
        ,b.brand as brand1&#13;
        ,b.department&#13;
        ,b.sub_department&#13;
        ,a.&quot;COLUMN&quot;&#13;
        ,cast(priority_of_column_ratio AS DOUBLE) AS priority_of_column_ratio&#13;
        ,avg((b.accuracy * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.completeness * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.timeliness * cast(priority_of_column_ratio AS DOUBLE))/4) as avg_data_quality_score&#13;
        ,avg(b.accuracy * cast(priority_of_column_ratio AS DOUBLE)) AS avg_accuracy_score&#13;
        ,avg(b.completeness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_completeness_score&#13;
        ,avg(b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_uniqueness_score&#13;
        ,avg(b.timeliness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_timeliness_score&#13;
    FROM people_ops_proposed.raw_gs_dataquality_validation_list a&#13;
    JOIN people_ops_proposed.il_data_quality_score b ON a.&quot;table&quot; = b.&quot;table&quot;&#13;
        AND a.&quot;column&quot; = b.variable&#13;
    --WHERE metric = &apos;Retention of High Performers&apos;&#13;
    GROUP BY 1,2,3,4,5,6&#13;
    )&#13;
GROUP BY 1,2,3,4&#13;
order by 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='_D24E4E45D2424E39927576DFDA3F0818' table='[Extract].[_D24E4E45D2424E39927576DFDA3F0818]' type='table' />
            </properties>
          </object>
          <object caption='Retention of High Performers' id='_F63E1DF635174542A4F213944A1BC408'>
            <properties context=''>
              <relation connection='athena.031h77a0tywrhc1a8t8ng16lblk7' name='Custom SQL Query' type='text'><![CDATA[-- Retention
WITH performance_1 AS
    (SELECT 
        DATE(review_date) AS month,
        employee_id,
        manager_rating,
        review_template_id,
        row_number () OVER (PARTITION BY employee_id ORDER BY review_date) AS row_num
    FROM 
        people_ops_proposed.il_performance 
    WHERE 
        manager_rating IS NOT NULL
        AND bp_status IN ('In Progress', 'Successfully Completed')),
performance_2 AS 
    (SELECT 
        a.month AS month_from,
        COALESCE(b.month, date_trunc('month', date_add('month', 1, current_date))) AS month_until,
        a.employee_id,
        a.manager_rating,
        a.review_template_id
    FROM 
        performance_1 AS a
    LEFT JOIN 
        performance_1 AS b ON a.employee_id = b.employee_id AND a.row_num = b.row_num - 1),
performance AS 
    (SELECT
        DATE(c.month) AS date_month,
        month_from,
        month_until,
        employee_id,
        manager_rating,
        review_template_id
    FROM 
        people_ops_proposed.bl_calendar c
    INNER JOIN 
        performance_2 ON DATE(c.month) >>= month_from AND DATE(c.month) << month_until),
termination AS
	(SELECT 
		*
	FROM
		people_ops_proposed.il_termination 
	WHERE 
		--(status is null or status IN ('Successfully Completed', 'In Progress')))
		status IN ('Successfully Completed', 'In Progress'))
, final_table as (
	SELECT
    date_trunc('month', DATE(wh.report_effective_date)) AS report_month,
    wh.company_id,
    wh.first_day_of_work,
    wh.last_day_of_work,
    cm.brAND,
    cm.company_name,
    cm.region,
    CASE WHEN cm.brand = 'Foodpanda' THEN cm.country_group ELSE cm.country END as country,
    cm.marketplace,
    m.manager_02_full_name,
    m.manager_03_full_name,
    wo.work_email AS work_email_manager_03,
    m.manager_04_full_name,
    m.manager_05_full_name,
    m.manager_06_full_name,
    CASE
		WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit_hierarchy, 8)
		WHEN cha.department IS NULL THEN wh.department_wd
		ELSE cha.department
	END as department,
	CASE
		WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit, 8)
		WHEN LOWER(
			REGEXP_REPLACE(
				COALESCE(cha.sub_department, wh.sub_department_wd),
				'\\s+',
				' '
			)
		) LIKE '%ops%store%operations%' THEN 'Ops Store Operations'
		ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
	END as sub_department,
    chw.cost_center_name, 
    wp.gender,
    wh.worker_type,
    CASE
    	WHEN cm.brand = 'PedidosYa' THEN
	    CASE 
			WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - PERMANENT' THEN 'Pickers' 
			WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - FIXED TERM (FIXED TERM)' THEN 'Pickers (Fixed Term)' 
			ELSE wh.contract_type
		END
		ELSE
    	wh.contract_type
    END AS contract_type,
    wh.job_family,
    wh.job_family_group,
    wh.management_level,
    sh.tenure_category,
    p.manager_rating,
    p.review_template_id,
    prt.review_template,
    wh.employee_id,
    te.termination_category,
    te.termination_reason,
    wh.time_type,
    wh.office_location,
    CASE 
			WHEN cm.brand = 'Glovo' THEN
			CASE 
				WHEN UPPER(wh.region) LIKE '%HQ%' THEN 'Regional' 
				WHEN wh.region IS NULL THEN wh.region
				ELSE 'Local' 
			END
			WHEN cm.brand = 'Foodora' THEN
			CASE 
				WHEN UPPER(wh.region) = 'FOODORA REGION' or UPPER(wh.region) = 'EU REGION' THEN 'Regional' 
				WHEN wh.region IS NULL THEN wh.region
				ELSE 'Local' 
			END
			WHEN cm.brand = 'PedidosYa' THEN
			CASE SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
				WHEN '1' then 'Local'
				WHEN '2' then 'Regional'
				WHEN '4' then 'Central'
				WHEN '5' then 'SSC'
				ELSE 'Null'
			end
	ELSE 'Null'
	END as scope,
    CASE
        WHEN te.employee_id IS NOT NULL THEN 1 ELSE 0 END AS terminations_effective,
    te.is_termination_regrettable,
    CASE 
        WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END AS actuals,
    te.last_updated,
    concat_ws(' ',
			m.manager_id_01,
			m.manager_id_02,
			m.manager_id_03,
			m.manager_id_04,
			m.manager_id_05,
			m.manager_id_06,
			m.manager_id_07,
			m.manager_id_08,
			m.manager_id_09,
			m.manager_id_10) as manager_id_concat
FROM 
    people_ops_proposed.il_worker_hist_with_current wh
LEFT JOIN 
    performance p ON p.employee_id = wh.employee_id AND p.date_month = date_trunc('month', DATE(wh.report_effective_date))  
LEFT JOIN 
    people_ops_proposed.il_manager m ON m.employee_id = wh.employee_id  -- why not il_manager_hist_with_crrent table?
LEFT JOIN
    people_ops_proposed.il_cc_hierarchy_all cha ON wh.cost_center_id = cha.cost_center_id      
LEFT JOIN
    people_ops_proposed.il_performance_review_template prt ON p.review_template_id = prt.review_template_id         
LEFT JOIN
    people_ops_proposed.il_cc_hierarchy_wd chw ON wh.cost_center_id = chw.cost_center_id      
LEFT JOIN
    people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id      
LEFT JOIN
    people_ops_proposed.il_worker_personal wp ON wp.employee_id = wh.employee_id     
LEFT JOIN
    people_ops_proposed.il_worker_org wo ON wo.employee_id = m.manager_id_03       
LEFT JOIN 
    people_ops_proposed.il_salary_hist_with_current sh ON sh.employee_id = wh.employee_id AND date_trunc('month', DATE(sh.report_effective_date)) = date_trunc('month', DATE(wh.report_effective_date))     
LEFT JOIN 
    termination te ON te.employee_id = wh.employee_id AND date_trunc('month', DATE(te.termination_effective_date)) = date_trunc('month', DATE(wh.report_effective_date))
)
select * from final_table
where terminations_effective + actuals >>= 1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_F63E1DF635174542A4F213944A1BC408' table='[Extract].[_F63E1DF635174542A4F213944A1BC408]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[brAND]' />
                <expression op='[brand1]' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[if ISNULL(department)&#13;&#10;THEN brAND&#13;&#10;else brAND+ department&#13;&#10;END]' _.fcp.RelationshipCalculations.true...op='if ISNULL([department])&#13;&#10;THEN [brAND]&#13;&#10;else [brAND]+ [department]&#13;&#10;END' />
                <expression _.fcp.RelationshipCalculations.false...op='[IF department (Custom SQL Query1) = &apos;No department&apos;&#13;&#10;THEN brand1&#13;&#10;else&#13;&#10;brand1+department (Custom SQL Query1)&#13;&#10;END&#13;&#10;]' _.fcp.RelationshipCalculations.true...op='IF [department (Custom SQL Query1)] = &apos;No department&apos;&#13;&#10;THEN [brand1]&#13;&#10;else&#13;&#10;[brand1]+[department (Custom SQL Query1)]&#13;&#10;END&#13;&#10;' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[if ISNULL(department) AND ISNULL(sub_department)&#13;&#10;THEN brAND&#13;&#10;ELSEIF ISNULL(sub_department)&#13;&#10;THEN brAND+department&#13;&#10;else brAND+department+sub_department&#13;&#10;END]' _.fcp.RelationshipCalculations.true...op='if ISNULL([department]) AND ISNULL([sub_department])&#13;&#10;THEN [brAND]&#13;&#10;ELSEIF ISNULL([sub_department])&#13;&#10;THEN [brAND]+[department]&#13;&#10;else [brAND]+[department]+[sub_department]&#13;&#10;END' />
                <expression _.fcp.RelationshipCalculations.false...op='[IF sub_department (Custom SQL Query1) = &apos;No sub_department&apos;&#13;&#10;AND department (Custom SQL Query1) = &apos;No department&apos;&#13;&#10;THEN brand1&#13;&#10;ELSEIF sub_department (Custom SQL Query1) = &apos;No sub_department&apos;&#13;&#10;THEN brand1 + department (Custom SQL Query1)&#13;&#10;else brand1 + department (Custom SQL Query1)+sub_department (Custom SQL Query1)&#13;&#10;END&#13;&#10;]' _.fcp.RelationshipCalculations.true...op='IF [sub_department (Custom SQL Query1)] = &apos;No sub_department&apos;&#13;&#10;AND [department (Custom SQL Query1)] = &apos;No department&apos;&#13;&#10;THEN [brand1]&#13;&#10;ELSEIF [sub_department (Custom SQL Query1)] = &apos;No sub_department&apos;&#13;&#10;THEN [brand1] + [department (Custom SQL Query1)]&#13;&#10;else [brand1] + [department (Custom SQL Query1)]+[sub_department (Custom SQL Query1)]&#13;&#10;END&#13;&#10;' />
              </expression>
            </expression>
            <first-end-point object-id='_F63E1DF635174542A4F213944A1BC408' />
            <second-end-point object-id='_D24E4E45D2424E39927576DFDA3F0818' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
