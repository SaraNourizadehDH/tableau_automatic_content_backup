        </calculation>
      </column>
      <column caption='c.Date (Previous Month - Landing Page)' datatype='date' name='[Calculation_1221038458153152513]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MIN([report_month]) = DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Color - View By (Bars - Others)' datatype='string' name='[Calculation_1405686038002167814]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//IF COUNTD([Measure Filter])=1 THEN &quot;1&quot; ELSE &quot;0&quot; END&#13;&#10;&#13;&#10;IF ISNULL(ATTR([Calculation_5720415998002348032])) THEN&#13;&#10;    &quot;0&quot;  // No color for NULL values&#13;&#10;ELSEIF WINDOW_MAX(COUNTD([Calculation_5720415998002348032])) = 1 THEN&#13;&#10;    &quot;1&quot;  // Color only the grand total row&#13;&#10;ELSE&#13;&#10;    &quot;2&quot;  // No color for other rows&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date (&gt;= 2023)' datatype='date' name='[Calculation_1405686038290096169]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [report_month]) &gt;= 2023 THEN [report_month] END' />
      </column>
      <column caption='c.Bool (YTD)' datatype='boolean' name='[Calculation_1405686038290473002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, [End Date (Att)])&#13;&#10;//AND [report_month] &lt;= [End Date (Att)]&#13;&#10;&#13;&#10;// Dec PY to date selected&#13;&#10;DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 9 1])) &#13;&#10;   AND DATEPART(&apos;month&apos;, [report_month]) = 12&#13;&#10;   OR (DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, [Parameters].[Parameter 9 1])&#13;&#10;       AND [report_month] &lt;= [Parameters].[Parameter 9 1])' />
      </column>
      <column caption='c.Headcount (parameter-driven)' datatype='integer' name='[Calculation_1561623178968059906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ EXCLUDE [termination_category] : SUM([actuals]) })' />
      </column>
      <column caption='c.Terminations effective (parameter-driven)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1561623178969870339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(&#13;&#10;    CASE [Parameters].[Parameter 11] &#13;&#10;        WHEN &quot;Voluntary&quot; THEN [Calculation_101260663796658176]&#13;&#10;        WHEN &quot;Involuntary&quot; THEN [Effective Voluntary Terminations (copy)_2932124874757550123]&#13;&#10;        ELSE [terminations_effective]&#13;&#10;    END&#13;&#10;),0)' />
      </column>
      <column caption='c.Select Termination Type' datatype='boolean' name='[Calculation_1561623178999898132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [termination_category] = [Parameters].[Parameter 11] THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='c.Total attrition rate (parameter-driven)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1727693413741010960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([terminations_effective]) / ([_Headcount (params)])&#13;&#10;&#13;&#10;[Calculation_1561623178969870339] / [Calculation_1561623178968059906]' />
      </column>
      <column caption='c.Monthly total attrition (parameter-driven)' datatype='real' default-format='p0.0%' name='[Calculation_1727693413741428753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    //[_Total Attrition Rate % (params)] &#13;&#10;    IF SUM([actuals])&gt;= 20 THEN &#13;&#10;        [Calculation_1727693413741010960] &#13;&#10;    ELSE &#13;&#10;        NULL &#13;&#10;    END&#13;&#10;,0)' />
      </column>
      <column caption='% Beta Voluntary' datatype='real' name='[Calculation_1894608087665463300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [termination_bucket] = &apos;Beta Voluntary&apos; THEN 1 ELSE 0 END) &#10;/ SUM(IF ISNULL([termination_bucket]) THEN 0 ELSE 1 END)' />
      </column>
      <column caption='# Termination(Glovo)' datatype='integer' name='[Calculation_1894608087737266192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([termination_bucket])' />
      </column>
      <column caption='% Turnover' datatype='integer' name='[Calculation_1894608087737466897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ EXCLUDE [termination_category] : SUM([actuals]) })' />
      </column>
      <column caption='c.View By (Bars - Dept/Sub-Dept)' datatype='boolean' name='[Calculation_1927259173694554203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &quot;Department&quot; OR [Parameters].[Parameter 13] = &quot;Sub-Department&quot; &#13;&#10;    THEN TRUE &#13;&#10;ELSE &#13;&#10;    FALSE &#13;&#10;END' />
      </column>
      <column caption='# Beta Voluntary Termination(Glovo)' datatype='integer' name='[Calculation_2014164585467719681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [termination_bucket] = &apos;Beta Voluntary&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='% Beta Voluntary Turnover' datatype='real' name='[Calculation_2014164585477324803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2014164585467719681])/([Calculation_1561623178968059906])' />
      </column>
      <column caption='c.Brand 1' datatype='boolean' name='[Calculation_2177208949137743876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand] = [Parameters].[Parameter 12]' />
      </column>
      <column caption='c.Filter - Brands (Trend - Brand)' datatype='integer' name='[Calculation_2261088533158719492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [brand]=[Parameters].[Parameter 12] or [brand]=[Parameters].[Attribute 1 (copy)_2261088533158469635]  or [brand]=[Parameters].[Attribute 2 (copy)_2261088533159288837]  then 1 else 0 END' />
      </column>
      <column caption='c.Scale By (Trends)' datatype='real' name='[Calculation_2352004915311763456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 18] = TRUE THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    MAX([12-month rolling effective voluntary attrition (copy)_1727693413741613074],[_Voluntary Attrition (YoY) % (copy)_1561623178971090948])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Attrition % (ytd)' datatype='real' default-format='p0.0%' name='[Calculation_2352004915596460056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Dec PY&#13;&#10;LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF DATEPART(&apos;month&apos;, min([report_month])) = 12 &#13;&#10;            AND DATEPART(&apos;year&apos;, min([report_month])) = DATEPART(&apos;year&apos;, [Parameters].[Parameter 9 1]) - 1 THEN&#13;&#10;            [12-month rolling effective voluntary attrition (copy)_1727693413741613074]&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Attrition % (end date)' datatype='real' default-format='p0.0%' name='[Calculation_2352004915596927001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF MIN([report_month]) = [Parameters].[Parameter 9 1] THEN&#13;&#10;            [12-month rolling effective voluntary attrition (copy)_1727693413741613074]&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date Lookup (Qtr)' datatype='datetime' name='[Calculation_2383811587653025793]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 19]&#13;&#10;    WHEN &quot;Month&quot; THEN MIN(DATETRUNC(&apos;month&apos;, [report_month]))&#13;&#10;    WHEN &quot;Quarter&quot; THEN &#13;&#10;        IF MIN(DATEPART(&apos;month&apos;, [report_month])) = 3 THEN LOOKUP(MIN([report_month]), 0) // For March&#13;&#10;        ELSEIF MIN(DATEPART(&apos;month&apos;, [report_month])) = 6 THEN LOOKUP(MIN([report_month]), 0) // For June&#13;&#10;        ELSEIF MIN(DATEPART(&apos;month&apos;, [report_month])) = 9 THEN LOOKUP(MIN([report_month]), 0) // For September&#13;&#10;        ELSEIF MIN(DATEPART(&apos;month&apos;, [report_month])) = 12 THEN LOOKUP(MIN([report_month]), 0) // For December&#13;&#10;        ELSE &#13;&#10;            NULL&#13;&#10;        END&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Termination Type (Overall)' datatype='boolean' name='[Calculation_2556637223298625536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 11] = &quot;All&quot;' />
      </column>
      <column caption='c.Headcount (ytd)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2603643539511345158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATE([report_month]) = DATE([Parameters].[Parameter 9 1]) THEN [actuals] END)' />
      </column>
      <column caption='Top/High Headcount' datatype='integer' name='[Calculation_271341900861943808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({&#10;    EXCLUDE [termination_category] : SUM(&#10;        IF [h1_2024_result (Custom SQL Query)] IN (&apos;High&apos;, &apos;Top&apos;) THEN [actuals] &#10;        ELSE 0 &#10;        END&#10;    )&#10;})' />
      </column>
      <column caption='# Top/High Beta Voluntary Termination(Glovo)' datatype='integer' name='[Calculation_271341900864090114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [termination_bucket] = &apos;Beta Voluntary&apos; AND [h1_2024_result (Custom SQL Query)] IN (&apos;High&apos;, &apos;Top&apos;) THEN 1 &#10;    ELSE 0 &#10;    END&#10;)' />
      </column>
      <column caption='% Top/High Beta Voluntary Turnover' datatype='real' name='[Calculation_271341900864610307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_271341900864090114]/ [Calculation_271341900861943808])' />
      </column>
      <column caption='c,Voluntary change moving avg (yoy)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2932124873078169617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([actuals])&gt;=20 THEN &#13;&#10;    (&#13;&#10;        (&#13;&#10;            WINDOW_SUM([Calculation_101260663830720516], -11, 0) &#13;&#10;            - WINDOW_SUM([Calculation_101260663830720516], -23, -12)&#13;&#10;        ) * 100&#13;&#10;    ) &#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Bool (Is Previous Month?)' datatype='boolean' name='[Calculation_2932124873389195296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[report_month]) = datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())) AND YEAR([report_month]) = YEAR(TODAY()) THEN True else FALSE end' />
      </column>
      <column caption='c.Color - Involuntary - KPI (ytd % change moving avg)' datatype='string' name='[Calculation_2932124873405382689]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [MOM % Change moving avg Involuntary (copy)_1246089775273558038]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [MOM % Change moving avg Involuntary (copy)_1246089775273558038]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [MOM % Change moving avg Involuntary (copy)_1246089775273558038]&gt;0 then &quot;Red&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.12-m rolling effective total attrition (Voluntary)' datatype='real' default-format='p0.0%' name='[Calculation_2932124873763463209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([actuals])&gt;=20 THEN &#13;&#10;        WINDOW_SUM([Calculation_101260663830720516], -11, 0) &#13;&#10;    ELSE &#13;&#10;        NULL &#13;&#10;    END&#13;&#10;,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
      </column>
      <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3179541352486285313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
      </column>
      <column caption='c.Filter (Others)' datatype='string' name='[Calculation_5720415998002348032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;WHEN &quot;Brand&quot; then [brand]&#13;&#10;WHEN &quot;Management Level&quot; then [management_level]&#13;&#10;WHEN &quot;Management Level Groups&quot; then [management_level (group)]&#13;&#10;WHEN &quot;Tenure Category&quot; then [tenure_category]&#13;&#10;WHEN &quot;Department&quot; then [Calculation_3179541352486285313]//[department]&#13;&#10;WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;WHEN &quot;Region&quot; then [region]&#13;&#10;WHEN &quot;Country&quot; then [country]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
          <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
          <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
          <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
          <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
          <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
          <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
        </aliases>
      </column>
      <column caption='c.View By (Trend - Brand)' datatype='boolean' name='[Calculation_628252149835997185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14] = &apos;Brand&apos;' />
      </column>
      <column caption='c.Date Lookup (Start to End)' datatype='date' name='[Calculation_628252149849305099]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MIN([report_month]) &gt;= [Parameters].[Parameter 2 1]&#13;&#10;   AND MIN([report_month]) &lt;= [Parameters].[Parameter 9 1]&#13;&#10;THEN LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Date Lookup (End Date = End)' datatype='date' name='[Calculation_628252149858635789]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MIN([report_month]) = [Parameters].[Parameter 9 1] THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
