		wh.time_type,
		wh.office_location,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN
			CASE
				WHEN UPPER(wh.region) LIKE &apos;%HQ%&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;Foodora&apos; THEN
			CASE
				WHEN UPPER(wh.region) = &apos;FOODORA REGION&apos; or UPPER(wh.region) = &apos;EU REGION&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;PedidosYa&apos; THEN
			CASE SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
				WHEN &apos;1&apos; then &apos;Local&apos;
				WHEN &apos;2&apos; then &apos;Regional&apos;
				WHEN &apos;4&apos; then &apos;Central&apos;
				WHEN &apos;5&apos; then &apos;SSC&apos;
				ELSE &apos;Null&apos;
			END
	ELSE &apos;Null&apos;
	END as scope,
		coalesce (ti.termination_category, te.termination_category) as termination_category,
		coalesce (ti.termination_reason, te.termination_reason) as termination_reason,
		CASE
			WHEN ti.employee_id is not null then 1
			else 0
		end as terminations_initiated,
		CASE
			WHEN te.employee_id is not null then 1
			else 0
		end as terminations_effective,
		coalesce (
			ti.is_termination_regrettable,
			te.is_termination_regrettable
		) as termination_regrettable,
		CASE
			WHEN wh.is_terminated = 0 THEN 1
			ELSE 0
		END as actuals,
		ac.is_people_manager,
		te.last_updated,
		concat_ws(&apos; &apos;,
			m.manager_id_01,
			m.manager_id_02,
			m.manager_id_03,
			m.manager_id_04,
			m.manager_id_05,
			m.manager_id_06,
			m.manager_id_07,
			m.manager_id_08,
			m.manager_id_09,
			m.manager_id_10) as manager_id_concat,
                  wh.region AS glovo_scope
	FROM
		people_ops_proposed.il_worker_hist_with_current wh
		LEFT JOIN people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id
		LEFT JOIN people_ops_proposed.il_worker_personal wp ON wh.employee_id = wp.employee_id
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON wh.cost_center_id = cha.cost_center_id
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw ON wh.cost_center_id = chw.cost_center_id
		LEFT JOIN people_ops_proposed.il_salary s ON wh.employee_id = s.employee_id
		LEFT JOIN people_ops_proposed.il_manager m ON wh.employee_id = m.employee_id
		LEFT JOIN active_managers ac ON m.managed_by = ac.employee_id
		LEFT JOIN termination ti ON ti.employee_id = wh.employee_id
		AND ti.termination_initiated_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;, 3, current_date))
		LEFT JOIN termination te ON te.employee_id = wh.employee_id
		AND te.termination_effective_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;, 3, current_date))
		LEFT JOIN people_ops_proposed.il_worker_org wo ON m.manager_id_03 = wo.employee_id
	WHERE
		date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
),
attrition_table as (
	--historic data
	SELECT
		report_month,
		company_id,
		company_name,
		country,
		period,
		brand,
		marketplace,
		region,
		department,
		sub_department,
		cost_center_id,
		job_family,
		job_family_group,
		cost_center_name,
		tenure_category,
		coalesce (managed_by_full_name, &apos;Null&apos;) as managed_by_full_name,
		coalesce (manager_02_full_name, &apos;Null&apos;) as manager_02_full_name,
		coalesce (manager_03_full_name, &apos;Null&apos;) as manager_03_full_name,
		coalesce (work_email_manager_03, &apos;Null&apos;) as work_email_manager_03,
		coalesce (manager_04_full_name, &apos;Null&apos;) as manager_04_full_name,
		coalesce (manager_05_full_name, &apos;Null&apos;) as manager_05_full_name,
		coalesce (manager_06_full_name, &apos;Null&apos;) as manager_06_full_name,
		gender,
		management_level,
		worker_type,
		contract_type,
		employee_id,
		first_day_of_work,
		last_day_of_work,
		time_type,
		office_location,
		scope,
		termination_category,
		termination_reason,
		terminations_initiated,
		terminations_effective,
		termination_regrettable,
		actuals,
		is_people_manager,
		last_updated,
		manager_id_concat,
                glovo_scope
	FROM
		historic_data
	UNION
	--future data
	SELECT
		report_month,
		company_id,
		company_name,
		country,
		period,
		brand,
		marketplace,
		region,
		department,
		sub_department,
		cost_center_id,
		job_family,
		job_family_group,
		cost_center_name,
		tenure_category,
		managed_by_full_name,
		manager_02_full_name,
		manager_03_full_name,
		work_email_manager_03,
		manager_04_full_name,
		manager_05_full_name,
		manager_06_full_name,
		gender,
		management_level,
		worker_type,
		contract_type,
		employee_id,
		first_day_of_work,
		last_day_of_work,
		time_type,
		office_location,
		scope,
		termination_category,
		termination_reason,
		terminations_initiated,
		terminations_effective,
		termination_regrettable,
		actuals,
		is_people_manager,
		last_updated,
		manager_id_concat,
                glovo_scope
	FROM
		next_month
	UNION
	SELECT
		report_month,
		company_id,
		company_name,
		country,
		period,
		brand,
		marketplace,
		region,
		department,
		sub_department,
		cost_center_id,
		job_family,
		job_family_group,
		cost_center_name,
		tenure_category,
		managed_by_full_name,
		manager_02_full_name,
		manager_03_full_name,
		work_email_manager_03,
		manager_04_full_name,
		manager_05_full_name,
		manager_06_full_name,
		gender,
		management_level,
		worker_type,
		contract_type,
		employee_id,
		first_day_of_work,
		last_day_of_work,
		time_type,
		office_location,
		scope,
		termination_category,
		termination_reason,
		terminations_initiated,
		terminations_effective,
		termination_regrettable,
		actuals,
		is_people_manager,
		last_updated,
		manager_id_concat,
                glovo_scope
	FROM
		next_next_month
	UNION
	SELECT
		report_month,
		company_id,
		company_name,
		country,
		period,
		brand,
		marketplace,
		region,
		department,
		sub_department,
		cost_center_id,
		job_family,
		job_family_group,
		cost_center_name,
		tenure_category,
		managed_by_full_name,
		manager_02_full_name,
		manager_03_full_name,
		work_email_manager_03,
		manager_04_full_name,
		manager_05_full_name,
		manager_06_full_name,
		gender,
		management_level,
		worker_type,
		contract_type,
		employee_id,
		first_day_of_work,
		last_day_of_work,
		time_type,
		office_location,
		scope,
		termination_category,
		termination_reason,
		terminations_initiated,
		terminations_effective,
		termination_regrettable,
		actuals,
		is_people_manager,
		last_updated,
		manager_id_concat,
                glovo_scope
	FROM
		next_next_next_month
)
SELECT
	*
FROM
	attrition_table
LEFT JOIN glovo_performance_review AS pr ON pr.worker_id = employee_id
WHERE terminations_effective + actuals &gt;&gt;= 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='_0743F576367145FD87CF5D43E2CB09F6' table='[Extract].[_0743F576367145FD87CF5D43E2CB09F6]' type='table' />
            </properties>
          </object>
          <object caption='Glovo Termination Buckets' id='_8C6D31388E4D4BF4AAC17C72C20638B1'>
            <properties context=''>
              <relation connection='athena.1czkikd16xgcmu1ggrw0g0ounse9' name='Custom SQL Query2' type='text'>
                <columns>
                  <column datatype='date' date-parse-format='yyyy-MM-dd' name='termination_effective_date' />
                </columns>
<![CDATA[WITH termination_glovo as (
	SELECT
	    t.employee_id,
		date_trunc('month', date(t.termination_effective_date)) as termination_effective_date,
		date_trunc('month', date(t.termination_effective_date)) as termination_effective_month,
		case
			when t.termination_category is null then 'Voluntary'
			else termination_category
		end as termination_category,
		t.termination_reason,
		t.last_updated
	FROM
		people_ops_proposed.il_termination t
	WHERE
		status IN ('Successfully Completed', 'In Progress')
		AND (
			(
				termination_category IS NULL
				AND resignation_reason IS NOT NULL
			)
			OR (termination_category IS not NULL)
		)
		AND t.termination_effective_date >>= '2024-06-01'),

termination_pr AS (SELECT
    t.*,
    wh.first_day_of_work,
    DATE_DIFF('month', CAST(wh.first_day_of_work AS date), CAST(t.termination_effective_date AS date)) AS tenure_months,
    pr.final_9box,
       CASE
           WHEN pr.final_9box IN ('Not Achieved/Role Model', 'Not achieved/Lives', 'Not Achieved/Does not live','Achieved/Does not live','Over achieved/Does not live') THEN 'Low'
           WHEN pr.final_9box IN ('Achieved/Lives') THEN 'Successful'
           WHEN pr.final_9box IN ('Over Achieved/Lives','Achieved/Role Model') THEN 'High'
           WHEN pr.final_9box IN ('Over Achieved/Role Model') THEN 'Top'
            ELSE 'No Review'
        END AS h1_2024_result
FROM termination_glovo AS t
LEFT JOIN people_ops_proposed.il_worker_hist_with_current AS wh ON t.employee_id = wh.employee_id
    AND t.termination_effective_date = date_trunc('month', cast(wh.report_effective_date as date))
LEFT JOIN people_ops_proposed.il_glovo_performance_review AS pr ON pr.worker_id = t.employee_id
   AND pr.review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills')

SELECT *,
       CASE
            WHEN t.termination_reason IN ('Workforce Reduction') THEN 'Business Decisions'
            WHEN (t.tenure_months <<= 6) OR
                ((t.first_day_of_work >>= '2023-09-21' AND t.h1_2024_result = 'Low')) THEN 'Non-Quality Hire'
            WHEN ((t.h1_2024_result = 'Low') OR (t.termination_reason = 'Poor Job Performance')) THEN 'Performance'
            WHEN (t.termination_category = 'Involuntary' AND t.termination_reason IN ('Contract Expired', 'Death', 'Gross Misconduct', 'Job Abandonment', 'Mutual Agreement',
                                                                                    'Not Authorized to Work')) THEN 'Other Involuntary'
            ELSE 'Beta Voluntary'
       END AS termination_bucket
FROM termination_pr AS t]]>              </relation>
            </properties>
            <properties context='extract'>
              <relation name='_8C6D31388E4D4BF4AAC17C72C20638B1' table='[Extract].[_8C6D31388E4D4BF4AAC17C72C20638B1]' type='table' />
            </properties>
          </object>
          <object caption='Data Quality Score' id='_B6FD1705261C4B94852EDFEF42C2D82B'>
            <properties context=''>
              <relation connection='athena.1czkikd16xgcmu1ggrw0g0ounse9' name='Custom SQL Query1' type='text'>SELECT metric&#13;
    ,brand&#13;
    ,department&#13;
    ,sub_department&#13;
    ,round(sum(avg_data_quality_score) / sum(priority_of_column_ratio),2) AS wt_data_quality_score&#13;
    ,round(sum(avg_accuracy_score) / sum(priority_of_column_ratio),2) AS wt_accuracy&#13;
    ,round(sum(avg_completeness_score) / sum(priority_of_column_ratio),2) AS wt_completeness&#13;
    ,round(sum(avg_uniqueness_score) / sum(priority_of_column_ratio),2) AS wt_uniqueness&#13;
  ,round(sum(avg_timeliness_score) / sum(priority_of_column_ratio),2) AS wt_timeliness&#13;
FROM (&#13;
    SELECT a.metric&#13;
        ,b.brand&#13;
        ,b.department&#13;
        ,b.sub_department&#13;
        ,a.&quot;COLUMN&quot;&#13;
        ,cast(priority_of_column_ratio AS DOUBLE) AS priority_of_column_ratio&#13;
        ,avg((b.accuracy * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.completeness * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.timeliness * cast(priority_of_column_ratio AS DOUBLE))/4) as avg_data_quality_score&#13;
        ,avg(b.accuracy * cast(priority_of_column_ratio AS DOUBLE)) AS avg_accuracy_score&#13;
        ,avg(b.completeness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_completeness_score&#13;
        ,avg(b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_uniqueness_score&#13;
        ,avg(b.timeliness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_timeliness_score&#13;
    FROM people_ops_proposed.raw_gs_dataquality_validation_list a&#13;
    JOIN people_ops_proposed.il_data_quality_score b ON a.&quot;table&quot; = b.&quot;table&quot;&#13;
        AND a.&quot;column&quot; = b.variable&#13;
    --WHERE metric = &apos;Retention of High Performers&apos;&#13;
    GROUP BY 1,2,3,4,5,6&#13;
    )&#13;
GROUP BY 1,2,3,4&#13;
order by 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='_B6FD1705261C4B94852EDFEF42C2D82B' table='[Extract].[_B6FD1705261C4B94852EDFEF42C2D82B]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[employee_id]' />
                <expression op='[employee_id (Custom SQL Query2)]' />
              </expression>
              <expression op='='>
                <expression op='[report_month]' />
                <expression op='[termination_effective_month]' />
              </expression>
            </expression>
            <first-end-point object-id='_0743F576367145FD87CF5D43E2CB09F6' />
            <second-end-point object-id='_8C6D31388E4D4BF4AAC17C72C20638B1' />
          </relationship>
          <relationship>
            <expression op='AND'>
              <expression op='='>
                <expression op='[brand]' />
                <expression op='[brand (Custom SQL Query1)]' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[if ISNULL(department)&#13;&#10;THEN brand&#13;&#10;else brand+ department&#13;&#10;END]' _.fcp.RelationshipCalculations.true...op='if ISNULL([department])&#13;&#10;THEN [brand]&#13;&#10;else [brand]+ [department]&#13;&#10;END' />
                <expression _.fcp.RelationshipCalculations.false...op='[IF department (Custom SQL Query1) = &apos;No department&apos;&#13;&#10;THEN brand (Custom SQL Query1)&#13;&#10;else&#13;&#10;brand (Custom SQL Query1)+department (Custom SQL Query1)&#13;&#10;END]' _.fcp.RelationshipCalculations.true...op='IF [department (Custom SQL Query1)] = &apos;No department&apos;&#13;&#10;THEN [brand (Custom SQL Query1)]&#13;&#10;else&#13;&#10;[brand (Custom SQL Query1)]+[department (Custom SQL Query1)]&#13;&#10;END' />
              </expression>
              <expression op='='>
                <expression _.fcp.RelationshipCalculations.false...op='[if ISNULL(department) AND ISNULL(sub_department)&#13;&#10;THEN brand&#13;&#10;ELSEIF ISNULL(sub_department)&#13;&#10;THEN brand+department&#13;&#10;else brand+department+sub_department&#13;&#10;END]' _.fcp.RelationshipCalculations.true...op='if ISNULL([department]) AND ISNULL([sub_department])&#13;&#10;THEN [brand]&#13;&#10;ELSEIF ISNULL([sub_department])&#13;&#10;THEN [brand]+[department]&#13;&#10;else [brand]+[department]+[sub_department]&#13;&#10;END' />
                <expression _.fcp.RelationshipCalculations.false...op='[IF sub_department (Custom SQL Query1) = &apos;No sub_department&apos;&#13;&#10;AND department (Custom SQL Query1) = &apos;No department&apos;&#13;&#10;THEN brand (Custom SQL Query1)&#13;&#10;ELSEIF sub_department (Custom SQL Query1) = &apos;No sub_department&apos;&#13;&#10;THEN brand (Custom SQL Query1) + department (Custom SQL Query1)&#13;&#10;else brand (Custom SQL Query1) + department (Custom SQL Query1)+sub_department (Custom SQL Query1)&#13;&#10;END&#13;&#10;]' _.fcp.RelationshipCalculations.true...op='IF [sub_department (Custom SQL Query1)] = &apos;No sub_department&apos;&#13;&#10;AND [department (Custom SQL Query1)] = &apos;No department&apos;&#13;&#10;THEN [brand (Custom SQL Query1)]&#13;&#10;ELSEIF [sub_department (Custom SQL Query1)] = &apos;No sub_department&apos;&#13;&#10;THEN [brand (Custom SQL Query1)] + [department (Custom SQL Query1)]&#13;&#10;else [brand (Custom SQL Query1)] + [department (Custom SQL Query1)]+[sub_department (Custom SQL Query1)]&#13;&#10;END&#13;&#10;' />
              </expression>
            </expression>
            <first-end-point object-id='_0743F576367145FD87CF5D43E2CB09F6' />
            <second-end-point object-id='_B6FD1705261C4B94852EDFEF42C2D82B' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
