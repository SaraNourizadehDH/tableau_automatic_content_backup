      <column caption='c.Effective terminations (Involuntary)' datatype='integer' name='[Effective Voluntary Terminations (copy)_2932124874757550123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [termination_category]= &apos;Involuntary&apos; &#10;THEN [terminations_effective] &#10;END' />
      </column>
      <column caption='c,Involuntary change moving avg (ytd)' datatype='real' name='[MOM % Change moving avg Involuntary (copy)_1246089775273558038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    //Last Month from Today&#13;&#10;    LOOKUP(&#13;&#10;        WINDOW_SUM(&#13;&#10;            IF MIN([report_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#13;&#10;                [12-month rolling effective voluntary attrition (copy)_2932124874801696818]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        LAST()&#13;&#10;    )&#13;&#10;    -&#13;&#10;    //Dec PY&#13;&#10;    LOOKUP(&#13;&#10;        WINDOW_SUM(&#13;&#10;            IF DATEPART(&apos;month&apos;, min([report_month])) = 12 &#13;&#10;                AND DATEPART(&apos;year&apos;, min([report_month])) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;                [12-month rolling effective voluntary attrition (copy)_2932124874801696818]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        LAST()&#13;&#10;    )&#13;&#10;) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.change moving avg (mom)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MOM % Change moving avg Voluntary (copy)_1561623178974928905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([actuals])&gt;=20 THEN &#13;&#10;    (&#13;&#10;        (&#13;&#10;            WINDOW_SUM([Calculation_1727693413741428753], -11, 0) &#13;&#10;            - WINDOW_SUM([Calculation_1727693413741428753], -12, -1)&#13;&#10;        ) *100&#13;&#10;    ) &#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c,Voluntary change moving avg (ytd)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MOM % Change moving avg Voluntary (copy)_1735293285084393473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    //Last Month from Today&#13;&#10;    [_Involuntary Attrition (Latest Month) % (copy)_2352004915608399901]&#13;&#10;    -&#13;&#10;    //Dec PY&#13;&#10;    [_Involuntary Attrition (YTD) % (copy)_2352004915608399902]&#13;&#10;    &#13;&#10;) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Filter (Bars - Dept/Sub-Dept)' datatype='string' name='[Measure Filter (copy)_1728537841116688391]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;WHEN &quot;Department&quot; then [Calculation_3179541352486285313]//[department]&#13;&#10;WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
          <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
          <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
          <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
          <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
          <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
