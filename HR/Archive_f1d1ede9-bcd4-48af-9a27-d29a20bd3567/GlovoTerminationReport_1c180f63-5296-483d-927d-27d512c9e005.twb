            <column-instance column='[Calculation_1020065330459803652]' derivation='None' name='[none:Calculation_1020065330459803652:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3179541352486285313]' derivation='None' name='[none:Calculation_3179541352486285313:nk]' pivot='key' type='nominal' />
