              <calculation class='tableau' formula='([Women M2+ (copy)_1246089775268270093]/COUNTD([employee_id]))' />
            </column>
            <column caption='All Women (MoM) %' datatype='real' default-format='p0.0%' name='[All Women (YoY) % (copy)_1727693413672194052]' role='measure' type='quantitative'>
