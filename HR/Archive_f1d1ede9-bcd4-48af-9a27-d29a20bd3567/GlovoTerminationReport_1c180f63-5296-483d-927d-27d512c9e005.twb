    <worksheet name='0) Global People Metrics (KPI - Women in Leadership)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Women in leadership (M3+ &amp; M2+)' name='federated.0zvncj0053cxpy1ark29f006or0g' />
            <datasource caption='Filter Control' name='federated.10yyxxn02juzfq16fpaje0nsua3y (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.0zvncj0053cxpy1ark29f006or0g'>
            <column caption='_Overall KPI subtitle (Entity name)' datatype='string' name='[Calculation_1221038458168692739]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([company_name]) = MAX([company_name]) THEN&#13;&#10;    &quot;(&quot; + MIN([company_name]) + &quot;)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='_Overall KPI Title (Brand)' datatype='string' name='[Calculation_1646628624710795266]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([brand]) = &quot;EFood&quot; THEN &#13;&#10;    &quot;efood&quot;     // Lowercase Efood&#13;&#10;ELSEIF MIN([brand]) = MAX([brand]) THEN&#13;&#10;    MIN([brand])  // Display the single selected brand&#13;&#10;ELSE&#13;&#10;    // Check if all selected brands are part of the Pandora group&#13;&#10;    IF MIN([brand]) IN (&quot;Foodpanda&quot;, &quot;Foodora&quot;, &quot;Yemeksepeti&quot;) &#13;&#10;       AND MAX([brand]) IN (&quot;Foodpanda&quot;, &quot;Foodora&quot;, &quot;Yemeksepeti&quot;) THEN&#13;&#10;        &quot;Pandora&quot;&#13;&#10;    ELSE&#13;&#10;       &quot;Multiple Brands Selected&quot; &#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Is Previous Month' datatype='boolean' name='[Calculation_2932124873389195296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[report_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;,-1,today())) &#13;&#10;    AND YEAR([report_month]) = YEAR(TODAY()) &#13;&#10;THEN &#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939638898689]' role='dimension' type='nominal'>
