          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retention of High Performers' name='federated.1hzr71m0dwgn0b1504swj1dw3zl3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Management level' caption='p.View By (Bars)' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Level&quot;'>
              <calculation class='tableau' formula='&quot;Management Level&quot;' />
              <aliases>
                <alias key='&quot;Management Level&quot;' value='Management level' />
                <alias key='&quot;Management Level Groups&quot;' value='Management level groups' />
                <alias key='&quot;Sub-Department&quot;' value='Sub-department' />
                <alias key='&quot;Tenure Category&quot;' value='Tenure category' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1hzr71m0dwgn0b1504swj1dw3zl3].[Calculation_2932124874836996153 1]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1hzr71m0dwgn0b1504swj1dw3zl3].[Calculation_1405686038205845512]' caption='p.HiPe (Select Date)' datatype='date' default-format='*mmmm yyyy' name='[Parameter 15]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hzr71m0dwgn0b1504swj1dw3zl3'>
            <column caption='Current Month' datatype='real' name='[Calculation_1022598595982622728]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_2932124872702570505]&#13;&#10;&#13;&#10;//This field is spefically used in Select Dimensions bar chart as a field label'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='SMLY' datatype='real' name='[Calculation_1022598595982962697]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_2177208949032919041]&#13;&#10;&#13;&#10;//This field is spefically used in Select Dimensions bar chart as a field label'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Date (&gt;= 2023)' datatype='date' name='[Calculation_1405686038205845512]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [report_month]) &gt;= 2023 THEN [report_month] END' />
            </column>
            <column caption='`' datatype='string' name='[Calculation_1728537841115713541]' role='dimension' type='nominal' user:unnamed='1) Retention of High Perf (Select Measure) dept'>
              <calculation class='tableau' formula='//`&#13;&#10;[Measure Filter (copy)_1728537841114329090]' />
            </column>
            <column caption='c.View By (Bars - Dept/Sub-Dept)' datatype='boolean' name='[Calculation_1927259173690359893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &quot;Department&quot; OR [Parameters].[Parameter 13] = &quot;Sub-Department&quot; &#13;&#10;    THEN TRUE &#13;&#10;ELSE &#13;&#10;    FALSE &#13;&#10;END' />
            </column>
            <column caption='&apos;' datatype='real' name='[Calculation_1927259173690875990]' role='measure' type='quantitative' user:unnamed='1) Retention of High Perf (Select Measure) dept'>
              <calculation class='tableau' formula='//&apos;&#13;&#10;[Calculation_1022598595982622728]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='`' datatype='string' name='[Calculation_1927259173691105367]' role='dimension' type='nominal' user:unnamed='1) Retention of High Perf (Select Measure) dept'>
              <calculation class='tableau' formula='//`&#13;&#10;[department]' />
            </column>
            <column caption='c.Target (Reference Line)' datatype='real' name='[Calculation_1927259173691752536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*ATTR(&#13;&#10;    IF [brand] = &quot;Delivery Hero&quot; THEN &#13;&#10;        0.94&#13;&#10;    ELSE&#13;&#10;        0.915&#13;&#10;    END&#13;&#10;)&#13;&#10;*/&#13;&#10;&#13;&#10;IF MIN([brAND]) = &quot;Delivery Hero&quot; AND COUNTD([brAND]) = 1 THEN&#13;&#10;    0.94&#13;&#10;ELSEIF MIN([brAND]) != &quot;Delivery Hero&quot; THEN&#13;&#10;    0.915&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='c.Headcount yoy (High Performers)' datatype='real' default-format='p0.0%' name='[Calculation_2177208949032919041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;        1-WINDOW_SUM([Calculation_3049499900150386745], -23, -12)&#13;&#10;    ELSE &#13;&#10;        NULL&#13;&#10;    END&#13;&#10;,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.12-month rolling effective retention of HiPe' datatype='real' default-format='p0.0%' name='[Calculation_2932124872702570505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;        1-WINDOW_SUM([Calculation_3049499900150386745], -11, 0)&#13;&#10;    ELSE &#13;&#10;        NULL&#13;&#10;    END&#13;&#10;,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary Effective Terminations - HiPe' datatype='integer' name='[Calculation_2932124872704397322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_3049499900148633655] THEN &#13;&#10;        [Calculation_5022076552060018788]&#13;&#10;    END&#13;&#10;,0)' />
            </column>
            <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153 1]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939639775236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brAND] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
            </column>
            <column caption='c.Bool (is High Perfomer?)' datatype='boolean' name='[Calculation_3049499900148633655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[manager_rating] = 4 OR [manager_rating] = 5' />
            </column>
            <column caption='c.Headcount (High Performers)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3049499900148760632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3049499900148633655] THEN [actuals] END' />
            </column>
            <column caption='c.Voluntary Effective Terminations % - HiPe' datatype='real' default-format='p0.0%' name='[Calculation_3049499900150386745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;    LOOKUP(&#13;&#10;        SUM([Calculation_2932124872704397322]) / SUM([Calculation_3049499900148760632])&#13;&#10;    ,0)&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary Effective Terminations' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
            </column>
            <column caption='c.12 months cummulative voluntary termination' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_7135953665071702016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;    IFNULL(WINDOW_SUM(SUM([Calculation_2932124872704397322]), -11, 0),0)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Select Dimensions (Dept/Sub-Dept)' datatype='string' name='[Measure Filter (copy)_1728537841114329090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;Department&quot; then [Calculation_3032329939639775236] //[department]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
                <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
                <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
                <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
                <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
                <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
                <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
              </aliases>
            </column>
            <column caption='c.Color - View By (Bars - Dept/Sub-Dept)' datatype='string' name='[_Color grand total (copy)_1728537841115455491]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//IF COUNTD([Measure Filter (Dept/Sub-Dept)])=1 THEN &quot;1&quot; ELSE &quot;0&quot; END&#13;&#10;&#13;&#10;&#13;&#10;IF ISNULL(ATTR([Measure Filter (copy)_1728537841114329090])) THEN&#13;&#10;    &quot;0&quot;  // No color for NULL values&#13;&#10;ELSEIF WINDOW_MAX(COUNTD([Measure Filter (copy)_1728537841114329090])) = 1 THEN&#13;&#10;    &quot;1&quot;  // Color only the grand total row&#13;&#10;ELSE&#13;&#10;    &quot;2&quot;  // No color for other rows&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Date Lookup (Select Date = End)' datatype='date' name='[_lookup end date (copy)_3049499900096008212]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MIN([report_month]) = [Parameters].[Parameter 15] THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1927259173691105367]' derivation='Attribute' name='[attr:Calculation_1927259173691105367:nk]' pivot='key' type='nominal' />
            <column caption='brand' datatype='string' name='[brAND]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
