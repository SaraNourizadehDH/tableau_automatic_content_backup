        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Voluntary Attrition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Attrition' name='federated.10yyxxn02juzfq16fpaje0nsua3y' />
            <datasource caption='Filter Control' name='federated.10yyxxn02juzfq16fpaje0nsua3y (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.10yyxxn02juzfq16fpaje0nsua3y'>
            <column caption='c.Effective terminations (Voluntary)' datatype='integer' name='[Calculation_101260663796658176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category]= &apos;Voluntary&apos; THEN &#13;&#10;    [terminations_effective] &#10;END' />
            </column>
            <column caption='c.Voluntary attrition rate' datatype='real' name='[Calculation_101260663797104641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_101260663796658176]) / SUM([actuals])' />
            </column>
            <column caption='c.Voluntary effective attrition (Monthly)' datatype='real' name='[Calculation_101260663830720516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([actuals])&gt;= 20 THEN &#13;&#10;    [Calculation_101260663797104641] &#13;&#10;ELSE &#13;&#10;    NULL &#13;&#10;END' />
            </column>
            <column caption='c.Bool (Is Previous Month?)' datatype='boolean' name='[Calculation_2932124873389195296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[report_month]) = datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())) AND YEAR([report_month]) = YEAR(TODAY()) THEN True else FALSE end' />
            </column>
            <column caption='c.12-m rolling effective total attrition (Voluntary)' datatype='real' default-format='p0.0%' name='[Calculation_2932124873763463209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([actuals])&gt;=20 THEN &#13;&#10;        WINDOW_SUM([Calculation_101260663830720516], -11, 0) &#13;&#10;    ELSE &#13;&#10;        NULL &#13;&#10;    END&#13;&#10;,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Color - Voluntary - KPI (ytd % change moving avg)' datatype='string' name='[Color [YTD % Change moving avg]] Involuntary (copy)_1735293285084614658]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [MOM % Change moving avg Voluntary (copy)_1735293285084393473]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [MOM % Change moving avg Voluntary (copy)_1735293285084393473]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [MOM % Change moving avg Voluntary (copy)_1735293285084393473]&gt;0 then &quot;Red&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c,Voluntary change moving avg (ytd)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MOM % Change moving avg Voluntary (copy)_1735293285084393473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    //Last Month from Today&#13;&#10;    [_Involuntary Attrition (Latest Month) % (copy)_2352004915608399901]&#13;&#10;    -&#13;&#10;    //Dec PY&#13;&#10;    [_Involuntary Attrition (YTD) % (copy)_2352004915608399902]&#13;&#10;    &#13;&#10;) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary attrition % (last month)' datatype='real' default-format='p0.0%' name='[_Involuntary Attrition (Latest Month) % (copy)_2352004915608399901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(&#13;&#10;        WINDOW_SUM(&#13;&#10;            IF MIN([report_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#13;&#10;                [Calculation_2932124873763463209]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        LAST()&#13;&#10;    )'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary attrition % (ytd)' datatype='real' default-format='p0.0%' name='[_Involuntary Attrition (YTD) % (copy)_2352004915608399902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Dec PY&#13;&#10;LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF DATEPART(&apos;month&apos;, min([report_month])) = 12 &#13;&#10;            AND DATEPART(&apos;year&apos;, min([report_month])) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;            [Calculation_2932124873763463209]&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Headcount' datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
