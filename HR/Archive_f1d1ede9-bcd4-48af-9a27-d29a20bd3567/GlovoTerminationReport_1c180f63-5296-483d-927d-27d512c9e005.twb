            <column caption='_Color (Title - Red)' datatype='string' name='[_Color (Title - Green) (copy)_2352004915403227151]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;    IF [Calculation_2352004915400507405] &lt; 0 THEN &#13;&#10;        &quot;▼ &quot; + STR(ROUND(ABS([Calculation_2352004915400507405]) * 100, 1)) + &quot;%&quot;&#13;&#10;    ELSE &#13;&#10;        &quot;&quot; &#13;&#10;    END&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
