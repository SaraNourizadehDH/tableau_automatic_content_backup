      <table>
        <view>
          <datasources>
            <datasource caption='Women in leadership (M3+ &amp; M2+)' name='federated.0zvncj0053cxpy1ark29f006or0g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='M3+' caption='p.Women (Management Level KPI)' datatype='string' datatype-customized='true' name='[Select Mgmt Level (copy)_1952028970592219156]' param-domain-type='list' role='measure' type='nominal' value='&quot;M3+&quot;'>
              <calculation class='tableau' formula='&quot;M3+&quot;' />
              <aliases>
                <alias key='&quot;M2+&quot;' value='M2+' />
                <alias key='&quot;M3+&quot;' value='M3+' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zvncj0053cxpy1ark29f006or0g'>
            <column caption='% of Women in leadership M1+' datatype='real' default-format='p0.0%' name='[% of Women in leadership M2+ (copy)_105834602255769601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Women M2+ (copy)_105834602255863810]/[Total M2+ (copy)_105834602255958019])' />
            </column>
            <column caption='% of Women in leadership M2+' datatype='real' default-format='p0.0%' name='[% of Women in leadership M3+ (copy)_5615988778474348558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Women M3+ (copy)_5615988778474070028]/[Total M3+ (copy)_5615988778474086413])' />
            </column>
            <column caption='_% of Women (vs Target)' datatype='real' name='[Calculation_2352004915400507405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the last value of M2+/M3+ Women for the most recent month&#13;&#10;IF LAST() = 0 THEN&#13;&#10;    [Calculation_426716073177571336]&#13;&#10;END&#13;&#10;-&#13;&#10;[Calculation_426716073178509321]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_Color (Title - Green)' datatype='string' name='[Calculation_2352004915403087886]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;    IF [Calculation_2352004915400507405] &gt; 0 THEN &#13;&#10;        &quot;▲ &quot; + STR(ROUND(ABS([Calculation_2352004915400507405]) * 100, 1)) + &quot;%&quot;&#13;&#10;    ELSE &#13;&#10;        &quot;&quot; &#13;&#10;    END&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='M+ Women (Latest Month)' datatype='real' name='[Calculation_2352004915643686949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST() = 0 THEN&#13;&#10;    [Calculation_426716073177571336]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Previous Month' datatype='boolean' name='[Calculation_2932124873389195296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[report_month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;,-1,today())) &#13;&#10;    AND YEAR([report_month]) = YEAR(TODAY()) &#13;&#10;THEN &#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939638898689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
            </column>
            <column caption='M+ Women' datatype='real' default-format='p0.0%' name='[Calculation_426716073177571336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Mgmt Level (copy)_1952028970592219156]&#13;&#10;    WHEN &quot;M3+&quot; THEN [Calculation_5615988778463821834]&#13;&#10;    WHEN &quot;M2+&quot; THEN [% of Women in leadership M3+ (copy)_5615988778474348558]&#13;&#10;    WHEN &quot;M1+&quot; THEN [% of Women in leadership M2+ (copy)_105834602255769601]&#13;&#10;END' />
            </column>
            <column caption='_Target (ref line)' datatype='real' name='[Calculation_426716073178509321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR(YEAR([report_month])) = 2024 THEN&#13;&#10;    IF COUNTD([brand]) &gt; 1 THEN&#13;&#10;        NULL  // Return NULL if multiple brands are selected&#13;&#10;    ELSEIF ATTR([company_name]) = &quot;Delivery Hero SE&quot; THEN&#13;&#10;        0.32  // Return 0.32 if the company is Delivery Hero SE&#13;&#10;    ELSE&#13;&#10;        CASE ATTR([brand])  // Use ATTR to ensure we&apos;re working with aggregated data&#13;&#10;            WHEN &quot;Delivery Hero&quot; THEN 0.26&#13;&#10;            WHEN &quot;EFood&quot; THEN 0.36&#13;&#10;            WHEN &quot;Foodora&quot; THEN 0.35&#13;&#10;            WHEN &quot;Foodpanda&quot; THEN 0.41&#13;&#10;            WHEN &quot;Foody&quot; THEN 0.36&#13;&#10;            WHEN &quot;Glovo&quot; THEN 0.35&#13;&#10;            WHEN &quot;Hungerstation&quot; THEN 0.10&#13;&#10;            WHEN &quot;PedidosYa&quot; THEN 0.22&#13;&#10;            WHEN &quot;Talabat&quot; THEN 0.25&#13;&#10;            WHEN &quot;Yemeksepeti&quot; THEN 0.35&#13;&#10;            WHEN &quot;Woowa&quot; THEN 0.23&#13;&#10;            ELSE NULL  // Handle any brand not listed&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Women M3+' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5615988778462920712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [gender] = &quot;Female&quot; AND [management_level (group) M3+] = &quot;M3+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% of Women in leadership M3+' datatype='real' default-format='p0.0%' name='[Calculation_5615988778463821834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5615988778462920712]/[Women M3+ (copy)_5615988778463715337])' />
            </column>
            <column caption='Total M1+' datatype='integer' default-format='n#,##0;-#,##0' name='[Total M2+ (copy)_105834602255958019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [management_level (group) M2+ (copy)_105834602256068612] = &quot;M1+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Total M2+' datatype='integer' default-format='n#,##0;-#,##0' name='[Total M3+ (copy)_5615988778474086413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [management_level (group) M3+ (copy)_5615988778385653760] = &quot;M2+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Women M1+' datatype='integer' default-format='n#,##0;-#,##0' name='[Women M2+ (copy)_105834602255863810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [gender] = &quot;Female&quot; AND [management_level (group) M2+ (copy)_105834602256068612] = &quot;M1+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Total M3+' datatype='integer' default-format='n#,##0;-#,##0' name='[Women M3+ (copy)_5615988778463715337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [management_level (group) M3+] = &quot;M3+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Women M2+' datatype='integer' default-format='n#,##0;-#,##0' name='[Women M3+ (copy)_5615988778474070028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [gender] = &quot;Female&quot; AND [management_level (group) M3+ (copy)_5615988778385653760] = &quot;M2+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='_Color (Title - Grey)' datatype='string' name='[_Color (Title - Green) (copy) (copy)_2352004915403239440]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;    IF [Calculation_2352004915400507405] = 0 THEN &#13;&#10;        &quot;▲ &quot; + STR(ROUND(ABS([Calculation_2352004915400507405]) * 100, 1)) + &quot;%&quot;&#13;&#10;    ELSE &#13;&#10;        &quot;&quot; &#13;&#10;    END&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
