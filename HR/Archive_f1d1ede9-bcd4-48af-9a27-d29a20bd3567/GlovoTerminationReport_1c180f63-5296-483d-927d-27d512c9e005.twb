            <column caption='M+ Men (YoY) %' datatype='real' default-format='p0.0%' name='[M2+/M3+ Women (YoY) % (copy)_1927259173659357224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Mgmt Level (copy)_1952028970592219156] &#13;&#10;    WHEN &quot;M3+&quot; THEN [_M3+ Women (YoY) % (copy)_1927259173660168237]&#13;&#10;    WHEN &quot;M2+&quot; THEN [_M2+ Women (YoY) % (copy)_1927259173659881516]&#13;&#10;    WHEN &quot;M1+&quot; THEN [_M2+ Men (YoY) % (copy)_105834602276020248]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Men M1+' datatype='integer' default-format='n#,##0;-#,##0' name='[Men M2+ (copy)_105834602274848783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [gender] = &quot;Male&quot; AND [management_level (group) M2+ (copy)_105834602256068612] = &quot;M1+&quot; THEN &#13;&#10;        [employee_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Men M2+' datatype='integer' default-format='n#,##0;-#,##0' name='[Men M3+ (copy)_2322731514218790942]' role='measure' type='quantitative'>
