            <column caption='_Measure Filter (Dept/Sub-Dept)' datatype='string' name='[_Measure Filter (copy)_1728537841118593033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;WHEN &quot;Department&quot; then [Calculation_3032329939638898689] //[department]&#13;&#10;WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
