    <worksheet name='0) Global People Metrics (KPI - Involuntary Attrition)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Voluntary Attrition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Attrition' name='federated.10yyxxn02juzfq16fpaje0nsua3y' />
            <datasource caption='Filter Control' name='federated.10yyxxn02juzfq16fpaje0nsua3y (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.10yyxxn02juzfq16fpaje0nsua3y'>
            <column caption='c.12-m rolling effective total attrition (Involuntary)' datatype='real' default-format='p0.0%' name='[12-month rolling effective voluntary attrition (copy)_2932124874801696818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([actuals])&gt;=20 THEN &#13;&#10;        WINDOW_SUM([Voluntary Attrition Rate % (copy)_2932124874757668908], -11, 0) &#13;&#10;    ELSE &#13;&#10;        NULL &#13;&#10;    END&#13;&#10;,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Date (Previous Month - Landing Page)' datatype='date' name='[Calculation_1221038458153152513]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MIN([report_month]) = DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
            </column>
            <column caption='c.Subtitle - Overall KPI (Entity name)' datatype='string' name='[Calculation_631629855159492614]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([company_name]) = MAX([company_name]) THEN&#13;&#10;    &quot;(&quot; + MIN([company_name]) + &quot;)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='c.Effective terminations (Involuntary)' datatype='integer' name='[Effective Voluntary Terminations (copy)_2932124874757550123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category]= &apos;Involuntary&apos; &#10;THEN [terminations_effective] &#10;END' />
            </column>
            <column caption='c.Involuntary attrition rate' datatype='real' name='[Voluntary Attrition Rate % (copy)_2932124874757668908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Effective Voluntary Terminations (copy)_2932124874757550123]) / SUM([actuals])' />
            </column>
            <column caption='c.Title - Overall KPI (Brand)' datatype='string' name='[_Overall KPI subtitle (Entity name) (copy)_1646628624703827968]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([brand]) = &quot;EFood&quot; THEN &#13;&#10;    &quot;efood&quot;     // Lowercase Efood&#13;&#10;ELSEIF MIN([brand]) = MAX([brand]) THEN&#13;&#10;    MIN([brand])  // Display the single selected brand&#13;&#10;ELSE&#13;&#10;    // Check if all selected brands are part of the Pandora group&#13;&#10;    IF MIN([brand]) IN (&quot;Foodpanda&quot;, &quot;Foodora&quot;, &quot;Yemeksepeti&quot;) &#13;&#10;       AND MAX([brand]) IN (&quot;Foodpanda&quot;, &quot;Foodora&quot;, &quot;Yemeksepeti&quot;) THEN&#13;&#10;        &quot;Pandora&quot;&#13;&#10;    ELSE&#13;&#10;       &quot;Multiple Brands Selected&quot; &#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Headcount' datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
