      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Filter Control' id='_0743F576367145FD87CF5D43E2CB09F6'>
            <properties context=''>
              <relation connection='athena.1czkikd16xgcmu1ggrw0g0ounse9 (copy)' name='Custom SQL Query' type='text'>-- Filter Control&#13;
SELECT&#13;
    cm.brand,&#13;
    cm.company_name,&#13;
    cm.region,&#13;
    wh.worker_type,&#13;
    CASE&#13;
    	WHEN cm.brand = &apos;PedidosYa&apos; THEN&#13;
	    CASE &#13;
			WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - PERMANENT&apos; THEN &apos;Pickers&apos; &#13;
			WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - FIXED TERM (FIXED TERM)&apos; THEN &apos;Pickers (Fixed Term)&apos; &#13;
			ELSE wh.contract_type&#13;
		END&#13;
		ELSE&#13;
    	wh.contract_type&#13;
    END AS contract_type,&#13;
    wh.job_family_group,&#13;
    wh.job_family,&#13;
    CASE&#13;
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit_hierarchy, 8)&#13;
			WHEN cha.department IS NULL THEN wh.department_wd&#13;
			ELSE cha.department&#13;
		END as department,&#13;
	CASE&#13;
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit, 8)&#13;
			WHEN LOWER(&#13;
				REGEXP_REPLACE(&#13;
					COALESCE(cha.sub_department, wh.sub_department_wd),&#13;
					&apos;\\s+&apos;,&#13;
					&apos; &apos;&#13;
				)&#13;
			) LIKE &apos;%ops%store%operations%&apos; THEN &apos;Ops Store Operations&apos;&#13;
			ELSE COALESCE(cha.sub_department, wh.sub_department_wd)			&#13;
		END as sub_department,&#13;
    wh.management_level,&#13;
    sh.tenure_category,&#13;
    CASE &#13;
			WHEN cm.brand = &apos;Glovo&apos; THEN&#13;
			CASE &#13;
				WHEN UPPER(wh.region) LIKE &apos;%HQ%&apos; THEN &apos;Regional&apos; &#13;
				WHEN wh.region IS NULL THEN wh.region&#13;
				ELSE &apos;Local&apos; &#13;
			END&#13;
			WHEN cm.brand = &apos;Foodora&apos; THEN&#13;
			CASE &#13;
				WHEN UPPER(wh.region) = &apos;FOODORA REGION&apos; or UPPER(wh.region) = &apos;EU REGION&apos; THEN &apos;Regional&apos; &#13;
				WHEN wh.region IS NULL THEN wh.region&#13;
				ELSE &apos;Local&apos; &#13;
			END&#13;
			WHEN cm.brand = &apos;PedidosYa&apos; THEN&#13;
			CASE SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)&#13;
				WHEN &apos;1&apos; then &apos;Local&apos;&#13;
				WHEN &apos;2&apos; then &apos;Regional&apos;&#13;
				WHEN &apos;4&apos; then &apos;Central&apos;&#13;
				WHEN &apos;5&apos; then &apos;SSC&apos;&#13;
				ELSE &apos;Null&apos;&#13;
			end&#13;
	else &apos;Null&apos;&#13;
	END as scope,&#13;
	concat_ws(&apos; &apos;,&#13;
			m.manager_id_01,&#13;
			m.manager_id_02,&#13;
			m.manager_id_03,&#13;
			m.manager_id_04,&#13;
			m.manager_id_05,&#13;
			m.manager_id_06,&#13;
			m.manager_id_07,&#13;
			m.manager_id_08,&#13;
			m.manager_id_09,&#13;
			m.manager_id_10) as manager_id_concat,&#13;
	wh.employee_id&#13;
FROM&#13;
    people_ops_proposed.il_worker_hist_with_current wh&#13;
LEFT JOIN&#13;
    people_ops_proposed.il_company_mapping cm&#13;
    ON wh.company_id = cm.company_id&#13;
LEFT JOIN&#13;
    people_ops_proposed.il_salary_hist_with_current sh&#13;
    ON sh.employee_id = wh.employee_id&#13;
    AND date_trunc(&apos;month&apos;, DATE(sh.report_effective_date)) = date_trunc(&apos;month&apos;, DATE(wh.report_effective_date))      &#13;
LEFT JOIN&#13;
    people_ops_proposed.il_cc_hierarchy_all cha&#13;
    ON wh.cost_center_id = cha.cost_center_id&#13;
LEFT JOIN &#13;
    people_ops_proposed.il_manager m ON m.employee_id = wh.employee_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
