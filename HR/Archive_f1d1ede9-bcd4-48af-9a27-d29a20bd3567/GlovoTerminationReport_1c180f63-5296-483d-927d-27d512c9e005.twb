        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;Brand&quot; then [brAND]&#13;&#10;    WHEN &quot;Management Level&quot; then [management_level]&#13;&#10;    WHEN &quot;Management Level Groups&quot; then [management_level (group)]&#13;&#10;    WHEN &quot;Tenure Category&quot; then [tenure_category]&#13;&#10;    WHEN &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Department&quot; then [Calculation_3032329939639775236] //[department]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [Calculation_3032329939639775236] //[department]&#13;&#10;    WHEN &quot;Region&quot; then [region]&#13;&#10;    WHEN &quot;Country&quot; then [country]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
          <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
          <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
          <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
          <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
          <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
          <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
        </aliases>
      </column>
