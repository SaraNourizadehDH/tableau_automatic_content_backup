    <worksheet name='0) Global People Metrics (Trend - Involuntary Attrition)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Involuntary Attrition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Attrition' name='federated.10yyxxn02juzfq16fpaje0nsua3y' />
            <datasource caption='Filter Control' name='federated.10yyxxn02juzfq16fpaje0nsua3y (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.10yyxxn02juzfq16fpaje0nsua3y'>
            <column caption='WINDOW_SUM([c.Involuntary attrition rate], -11, 0)' datatype='real' name='[Calculation_2932124874761035823]' role='measure' type='quantitative' user:unnamed='4) Voluntary Attrition'>
              <calculation class='tableau' formula='WINDOW_SUM([Voluntary Attrition Rate % (copy)_2932124874757668908], -11, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Bool (&lt;= Today)' datatype='boolean' name='[Calculation_81346277767782400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &lt;= DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='c.Effective terminations (Involuntary)' datatype='integer' name='[Effective Voluntary Terminations (copy)_2932124874757550123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category]= &apos;Involuntary&apos; &#10;THEN [terminations_effective] &#10;END' />
            </column>
            <column caption='c.Involuntary attrition rate' datatype='real' name='[Voluntary Attrition Rate % (copy)_2932124874757668908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Effective Voluntary Terminations (copy)_2932124874757550123]) / SUM([actuals])' />
            </column>
            <column caption='Headcount' datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
