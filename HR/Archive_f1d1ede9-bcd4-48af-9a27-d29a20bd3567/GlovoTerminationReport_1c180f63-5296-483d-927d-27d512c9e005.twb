        <calculation class='tableau' formula='if [YOY % Change moving avg Voluntary (copy)_2932124874803085363]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [YOY % Change moving avg Voluntary (copy)_2932124874803085363]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [YOY % Change moving avg Voluntary (copy)_2932124874803085363]&gt;0 then &quot;Red&quot; END'>
