      <column caption='c.View By (Trend - Overall)' datatype='boolean' name='[Calculation_631629855161507847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14] = &quot;Overall&quot;' />
