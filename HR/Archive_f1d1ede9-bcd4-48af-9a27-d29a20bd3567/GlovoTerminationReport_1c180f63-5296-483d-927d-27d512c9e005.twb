            </column>
            <column datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column caption='g.management_group' datatype='string' name='[management_level (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
                <bin default-name='false' value='&quot;IC1 - IC2&quot;'>
                  <value>&quot;IC1&quot;</value>
                  <value>&quot;IC2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IC3 - IC6&quot;'>
                  <value>&quot;IC3&quot;</value>
                  <value>&quot;IC4&quot;</value>
                  <value>&quot;IC5&quot;</value>
                  <value>&quot;IC6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M1 - M2&quot;'>
                  <value>&quot;M1&quot;</value>
                  <value>&quot;M2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M3+&quot;'>
                  <value>&quot;E1&quot;</value>
                  <value>&quot;E2&quot;</value>
                  <value>&quot;M3&quot;</value>
                  <value>&quot;M4&quot;</value>
                  <value>&quot;M5&quot;</value>
                  <value>&quot;M6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;S Track&quot;'>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                  <value>&quot;S3&quot;</value>
                  <value>&quot;S4&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[management_level]' role='dimension' type='nominal' />
