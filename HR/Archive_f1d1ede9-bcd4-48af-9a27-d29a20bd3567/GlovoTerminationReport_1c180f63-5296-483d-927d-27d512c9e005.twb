            <column caption='c.Target (Reference Line)' datatype='real' name='[Calculation_1927259173691752536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*ATTR(&#13;&#10;    IF [brand] = &quot;Delivery Hero&quot; THEN &#13;&#10;        0.94&#13;&#10;    ELSE&#13;&#10;        0.915&#13;&#10;    END&#13;&#10;)&#13;&#10;*/&#13;&#10;&#13;&#10;IF MIN([brAND]) = &quot;Delivery Hero&quot; AND COUNTD([brAND]) = 1 THEN&#13;&#10;    0.94&#13;&#10;ELSEIF MIN([brAND]) != &quot;Delivery Hero&quot; THEN&#13;&#10;    0.915&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='_% HiPe (vs Target)' datatype='real' default-format='*0.0' name='[Calculation_2352004915390742536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2352004915572977683]&#13;&#10;- &#13;&#10;[Calculation_1927259173691752536]&#13;&#10;&#13;&#10;//This calculated field gets the difference between the Target and the actual Retention Rate %'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Color - Green (Target KPI)' datatype='string' name='[Calculation_2352004915391975433]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2352004915390742536] &gt; 0 THEN &#13;&#10;    &quot;▲ &quot; + STR(ROUND(ABS([Calculation_2352004915390742536]) * 100, 1)) + &quot;%&quot;&#13;&#10;ELSE &#13;&#10;    &quot;&quot; &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_% HiPe (Latest Month)' datatype='real' default-format='p0.0%' name='[Calculation_2352004915572977683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(&#13;&#10;    WINDOW_SUM(&#13;&#10;        IF MIN([report_month]) = [Parameters].[Parameter 9] THEN&#13;&#10;            ([Calculation_2932124872702570505])&#13;&#10;        END&#13;&#10;    ),&#13;&#10;    LAST()&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.12-month rolling effective retention of HiPe' datatype='real' default-format='p0.0%' name='[Calculation_2932124872702570505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF SUM([Calculation_3049499900148760632])&gt;= 4 THEN &#13;&#10;        1-WINDOW_SUM([Calculation_3049499900150386745], -11, 0)&#13;&#10;    ELSE &#13;&#10;        NULL&#13;&#10;    END&#13;&#10;,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary Effective Terminations - HiPe' datatype='integer' name='[Calculation_2932124872704397322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_3049499900148633655] THEN &#13;&#10;        [Calculation_5022076552060018788]&#13;&#10;    END&#13;&#10;,0)' />
            </column>
            <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153 1]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3032329939639775236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brAND] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
            </column>
            <column caption='c.Bool (is High Perfomer?)' datatype='boolean' name='[Calculation_3049499900148633655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[manager_rating] = 4 OR [manager_rating] = 5' />
            </column>
            <column caption='c.Headcount (High Performers)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3049499900148760632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3049499900148633655] THEN [actuals] END' />
            </column>
            <column caption='c.Voluntary Effective Terminations % - HiPe' datatype='real' default-format='p0.0%' name='[Calculation_3049499900150386745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;    LOOKUP(&#13;&#10;        SUM([Calculation_2932124872704397322]) / SUM([Calculation_3049499900148760632])&#13;&#10;    ,0)&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Voluntary Effective Terminations' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
            </column>
            <column caption='c.Date Lookup (End Date = End)' datatype='date' name='[Calculation_628252149858635789]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MIN([report_month]) = [Parameters].[Parameter 9] THEN&#13;&#10;    LOOKUP(MIN([report_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Color - Red (Target KPI)' datatype='string' name='[_Color (Title - Green) (copy)_2352004915392299018]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2352004915390742536] &lt; 0 THEN &#13;&#10;    &quot;▼ &quot; + STR(ROUND(ABS([Calculation_2352004915390742536]) * 100, 1)) + &quot;%&quot;&#13;&#10;ELSE &#13;&#10;    &quot;&quot; &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Color - Grey (Target KPI)' datatype='string' name='[_Color (Title - Red) (copy)_2352004915392417803]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2352004915390742536] = 0 THEN &#13;&#10;    STR(ROUND(ABS([Calculation_2352004915390742536]) * 100, 1)) + &quot;%&quot;&#13;&#10;ELSE &#13;&#10;    &quot;&quot; &#13;&#10;END'>
