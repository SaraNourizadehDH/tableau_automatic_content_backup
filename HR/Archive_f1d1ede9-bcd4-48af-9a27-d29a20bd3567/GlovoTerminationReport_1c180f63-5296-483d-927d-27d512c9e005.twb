        + b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)&#13;
        + b.timeliness * cast(priority_of_column_ratio AS DOUBLE))/4) as avg_data_quality_score&#13;
        ,avg(b.accuracy * cast(priority_of_column_ratio AS DOUBLE)) AS avg_accuracy_score&#13;
        ,avg(b.completeness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_completeness_score&#13;
        ,avg(b.uniqueness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_uniqueness_score&#13;
        ,avg(b.timeliness * cast(priority_of_column_ratio AS DOUBLE)) AS avg_timeliness_score&#13;
    FROM people_ops_proposed.raw_gs_dataquality_validation_list a&#13;
    JOIN people_ops_proposed.il_data_quality_score b ON a.&quot;table&quot; = b.&quot;table&quot;&#13;
        AND a.&quot;column&quot; = b.variable&#13;
