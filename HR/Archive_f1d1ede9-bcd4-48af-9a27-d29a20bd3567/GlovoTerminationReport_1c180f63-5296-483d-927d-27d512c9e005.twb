    <action caption='HiPe: Term Reasons -&gt; List' name='[Action2_5CE78E88378B4053862322A989EF8403]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Retention of High Performers' type='sheet' worksheet='1) Retention of High Perf (Bars - Termination Reasons)' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='1) Retention of High Perf (Bars - Department/Sub-Department),1) Retention of High Perf (KPI - Overall),1) Retention of High Perf (Bars - Others),1) Retention of High Perf (Bars - Performance),1) Retention of High Perf (Bars - Termination Reasons),1) Retention of High Perf (Trend - Brands),1) Retention of High Perf (KPI - Brand 2),1) Retention of High Perf (KPI - Brand 1),1) Retention of High Perf (KPI - Brand 3),1) Retention of High Perf (KPI - Men YTDs),1) Retention of High Perf (KPI - Men),1) Retention of High Perf (KPI - MoM),1) Retention of High Perf (KPI - Target),1) Retention of High Perf (KPI - Women YTDs),1) Retention of High Perf (KPI - Women),1) Retention of High Perf (KPI - YoY),1) Retention of High Perf (KPI - YTD),1) Retention of High Perf (Legend - Brands),1) Retention of High Perf (Others - Last Updated info),1) Retention of High Perf (Trend - Overall),1) Retention of High Perf (Table - Detailed view),1) Retention of High Perf (Title - Attrition table view),1) Retention of High Perf (Trend - Gender)' />
        <param name='special-fields' value='all' />
