      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Attrition' id='_0743F576367145FD87CF5D43E2CB09F6'>
            <properties context=''>
              <relation connection='athena.1czkikd16xgcmu1ggrw0g0ounse9' name='Custom SQL Query' type='text'>WITH active_managers as (
	SELECT
		employee_id,
		is_people_manager
	FROM
		people_ops_proposed.il_worker_org
	where
		is_terminated = 0
),
termination as (
	SELECT
		date_trunc(&apos;month&apos;, date(t.termination_initiated_date)) as termination_initiated_date,
		date_trunc(&apos;month&apos;, date(t.termination_effective_date)) as termination_effective_date,
		t.employee_id,
		case
			when t.termination_category is null then &apos;Voluntary&apos;
			else termination_category
		end as termination_category,
		t.termination_reason,
		t.is_termination_regrettable,
		t.last_updated
	FROM
		people_ops_proposed.il_termination t
	WHERE
		status IN (&apos;Successfully Completed&apos;, &apos;In Progress&apos;)
		AND (
			(
				termination_category IS NULL
				AND resignation_reason IS NOT NULL
			)
			OR (termination_category IS not NULL)
		)
),
glovo_performance_review AS (
    SELECT
        worker_id,
        final_9box,
          CASE
           WHEN final_9box IN (&apos;Not Achieved/Role Model&apos;, &apos;Not achieved/Lives&apos;, &apos;Not Achieved/Does not live&apos;,&apos;Achieved/Does not live&apos;,&apos;Over achieved/Does not live&apos;) THEN &apos;Low&apos;
           WHEN final_9box IN (&apos;Achieved/Lives&apos;) THEN &apos;Successful&apos;
           WHEN final_9box IN (&apos;Over Achieved/Lives&apos;,&apos;Achieved/Role Model&apos;) THEN &apos;High&apos;
           WHEN final_9box IN (&apos;Over Achieved/Role Model&apos;) THEN &apos;Top&apos;
            ELSE &apos;No Review&apos; END AS h1_2024_result
    FROM people_ops_proposed.il_glovo_performance_review
    WHERE review_template = &apos;Glovo - 2024 (H1) Performance Review and Leadership Skills&apos;
),
historic_data as (
	SELECT
		date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) as report_month,
		wh.company_id,
		cm.company_name,
		case
			when cm.brand = &apos;Foodpanda&apos; then cm.country_group
			else cm.country
		end as country,
		&apos;Historical Data&apos; as period,
		cm.brand,
		cm.marketplace,
		cm.region,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit_hierarchy, 8)
			WHEN cha.department IS NULL THEN wh.department_wd
			ELSE cha.department
		END as department,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit, 8)
			WHEN LOWER(
				REGEXP_REPLACE(
					COALESCE(cha.sub_department, wh.sub_department_wd),
					&apos;\\s+&apos;,
					&apos; &apos;
				)
			) LIKE &apos;%ops%store%operations%&apos; THEN &apos;Ops Store Operations&apos;
			ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
		END as sub_department,
		wh.cost_center_id,
		wh.job_family,
		wh.job_family_group,
		chw.cost_center_name,
		sh.tenure_category,
		mh.managed_by_full_name,
		mh.manager_02_full_name,
		mh.manager_03_full_name,
		wo.work_email as work_email_manager_03,
		mh.manager_04_full_name,
		mh.manager_05_full_name,
		mh.manager_06_full_name,
		wp.gender,
		wh.management_level,
		wh.worker_type,
		CASE
	    	WHEN cm.brand = &apos;PedidosYa&apos; THEN
		    CASE
				WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - PERMANENT&apos; THEN &apos;Pickers&apos;
				WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - FIXED TERM (FIXED TERM)&apos; THEN &apos;Pickers (Fixed Term)&apos;
				ELSE wh.contract_type
			END
			ELSE
	    	wh.contract_type
	    END AS contract_type,
		wh.employee_id,
		wh.first_day_of_work,
		wh.last_day_of_work,
		wh.time_type,
		wh.office_location,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN
			CASE
				WHEN UPPER(wh.region) LIKE &apos;%HQ%&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;Foodora&apos; THEN
			CASE
				WHEN UPPER(wh.region) = &apos;FOODORA REGION&apos; or UPPER(wh.region) = &apos;EU REGION&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;PedidosYa&apos; THEN
			CASE SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
				WHEN &apos;1&apos; then &apos;Local&apos;
				WHEN &apos;2&apos; then &apos;Regional&apos;
				WHEN &apos;4&apos; then &apos;Central&apos;
				WHEN &apos;5&apos; then &apos;SSC&apos;
				ELSE &apos;Null&apos;
			END
	ELSE &apos;Null&apos;
	END as scope,
		coalesce (ti.termination_category, te.termination_category) as termination_category,
		coalesce (ti.termination_reason, te.termination_reason) as termination_reason,
		CASE
			WHEN ti.employee_id is not null then 1
			else 0
		end as terminations_initiated,
		CASE
			WHEN te.employee_id is not null then 1
			else 0
		end as terminations_effective,
		coalesce (
			ti.is_termination_regrettable,
			te.is_termination_regrettable
		) as termination_regrettable,
		CASE
			WHEN wh.is_terminated = 0 THEN 1
			ELSE 0
		END as actuals,
		ac.is_people_manager,
		te.last_updated,
		concat_ws(&apos; &apos;,
			m.manager_id_01,
			m.manager_id_02,
			m.manager_id_03,
			m.manager_id_04,
			m.manager_id_05,
			m.manager_id_06,
			m.manager_id_07,
			m.manager_id_08,
			m.manager_id_09,
			m.manager_id_10) as manager_id_concat,
                  wh.region AS glovo_scope
	FROM
		people_ops_proposed.il_worker_hist_with_current wh
		LEFT JOIN people_ops_proposed.il_manager m ON m.employee_id = wh.employee_id
		LEFT JOIN active_managers ac ON m.managed_by = ac.employee_id
		LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh ON mh.employee_id = wh.employee_id
		AND date_trunc(&apos;month&apos;, cast(mh.report_effective_date as date)) = date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date))
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON wh.cost_center_id = cha.cost_center_id
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw ON wh.cost_center_id = chw.cost_center_id
		LEFT JOIN people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id
		LEFT JOIN people_ops_proposed.il_worker_personal wp ON wp.employee_id = wh.employee_id
		LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh ON sh.employee_id = wh.employee_id
		AND date_trunc(&apos;month&apos;, cast(sh.report_effective_date as date)) = date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date))
		LEFT JOIN people_ops_proposed.il_worker_org wo ON mh.manager_id_03 = wo.employee_id
		LEFT JOIN termination ti ON ti.employee_id = wh.employee_id
		AND ti.termination_initiated_date = date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date))
		LEFT JOIN termination te ON te.employee_id = wh.employee_id
		AND te.termination_effective_date = date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date))
),
next_month as (
	SELECT
		CASE
			WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date) THEN date_trunc(
				&apos;month&apos;,
				date_add(
					&apos;month&apos;,
					1,
					cast(wh.report_effective_date as date)
				)
			)
			ELSE null
		END AS report_month,
		wh.company_id,
		cm.company_name,
		case
			when cm.brand = &apos;Foodpanda&apos; then cm.country_group
			else cm.country
		end as country,
		&apos;Future Data&apos; as period,
		cm.brand,
		cm.marketplace,
		cm.region,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit_hierarchy, 8)
			WHEN cha.department IS NULL THEN wh.department_wd
			ELSE cha.department
		END as department,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit, 8)
			WHEN LOWER(
				REGEXP_REPLACE(
					COALESCE(cha.sub_department, wh.sub_department_wd),
					&apos;\\s+&apos;,
					&apos; &apos;
				)
			) LIKE &apos;%ops%store%operations%&apos; THEN &apos;Ops Store Operations&apos;
			ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
		END as sub_department,
		wh.cost_center_id,
		wh.job_family,
		wh.job_family_group,
		chw.cost_center_name,
		s.tenure_category,
		m.managed_by_full_name,
		m.manager_02_full_name,
		m.manager_03_full_name,
		wo.work_email as work_email_manager_03,
		m.manager_04_full_name,
		m.manager_05_full_name,
		m.manager_06_full_name,
		wp.gender,
		wh.management_level,
		wh.worker_type,
		CASE
	    	WHEN cm.brand = &apos;PedidosYa&apos; THEN
		    CASE
				WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - PERMANENT&apos; THEN &apos;Pickers&apos;
				WHEN UPPER(wh.contract_type) = &apos;OPERATIONAL WORKER - FIXED TERM (FIXED TERM)&apos; THEN &apos;Pickers (Fixed Term)&apos;
				ELSE wh.contract_type
			END
			ELSE
	    	wh.contract_type
	    END AS contract_type,
		wh.employee_id,
		wh.first_day_of_work,
		wh.last_day_of_work,
		wh.time_type,
		wh.office_location,
		CASE
			WHEN cm.brand = &apos;Glovo&apos; THEN
			CASE
				WHEN UPPER(wh.region) LIKE &apos;%HQ%&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;Foodora&apos; THEN
			CASE
				WHEN UPPER(wh.region) = &apos;FOODORA REGION&apos; or UPPER(wh.region) = &apos;EU REGION&apos; THEN &apos;Regional&apos;
				WHEN wh.region IS NULL THEN wh.region
				ELSE &apos;Local&apos;
			END
			WHEN cm.brand = &apos;PedidosYa&apos; THEN
			CASE SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
				WHEN &apos;1&apos; then &apos;Local&apos;
				WHEN &apos;2&apos; then &apos;Regional&apos;
				WHEN &apos;4&apos; then &apos;Central&apos;
				WHEN &apos;5&apos; then &apos;SSC&apos;
				ELSE &apos;Null&apos;
			END
		ELSE &apos;Null&apos;
		END as scope,
		coalesce (ti.termination_category, te.termination_category) as termination_category,
		coalesce (ti.termination_reason, te.termination_reason) as termination_reason,
		CASE
			WHEN ti.employee_id is not null then 1
			else 0
		end as terminations_initiated,
		CASE
			WHEN te.employee_id is not null then 1
			else 0
		end as terminations_effective,
		coalesce (
			ti.is_termination_regrettable,
			te.is_termination_regrettable
		) as termination_regrettable,
		CASE
			WHEN wh.is_terminated = 0 THEN 1
			ELSE 0
		END as actuals,
		ac.is_people_manager,
		te.last_updated,
		concat_ws(&apos; &apos;,
			m.manager_id_01,
			m.manager_id_02,
			m.manager_id_03,
			m.manager_id_04,
			m.manager_id_05,
			m.manager_id_06,
			m.manager_id_07,
			m.manager_id_08,
			m.manager_id_09,
			m.manager_id_10) as manager_id_concat,
                  wh.region AS glovo_scope
	FROM
		people_ops_proposed.il_worker_hist_with_current wh
		LEFT JOIN people_ops_proposed.il_company_mapping cm ON wh.company_id = cm.company_id
		LEFT JOIN people_ops_proposed.il_worker_personal wp ON wh.employee_id = wp.employee_id
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON wh.cost_center_id = cha.cost_center_id
		LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw ON wh.cost_center_id = chw.cost_center_id
		LEFT JOIN people_ops_proposed.il_salary s ON wh.employee_id = s.employee_id
		LEFT JOIN people_ops_proposed.il_manager m ON wh.employee_id = m.employee_id
		LEFT JOIN active_managers ac ON m.managed_by = ac.employee_id
		LEFT JOIN termination ti ON ti.employee_id = wh.employee_id
		AND ti.termination_initiated_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;, 1, current_date))
		LEFT JOIN termination te ON te.employee_id = wh.employee_id
		AND te.termination_effective_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;, 1, current_date))
		LEFT JOIN people_ops_proposed.il_worker_org wo ON m.manager_id_03 = wo.employee_id
	WHERE
		date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
),
next_next_month as (
	SELECT
		CASE
			WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date) THEN date_trunc(
				&apos;month&apos;,
				date_add(
					&apos;month&apos;,
					2,
					cast(wh.report_effective_date as date)
				)
			)
			ELSE null
