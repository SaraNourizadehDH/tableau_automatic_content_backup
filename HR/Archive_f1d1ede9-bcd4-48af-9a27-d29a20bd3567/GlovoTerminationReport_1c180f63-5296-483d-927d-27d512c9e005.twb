    <worksheet name='2) Glovo Detailed Attrition view'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontsize='10'>Detailed attrition view</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#4629ff' fontsize='9'><![CDATA[<[Parameters].[Parameter 2 1]> to <[Parameters].[Parameter 9 1]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/GlovoTerminationReport/2GlovoDetailedAttritionview?rev=' id='2GlovoDetailedAttritionview' path='/t/HR/workbooks/GlovoTerminationReport' revision='' site='HR' />
      <table>
        <view>
          <datasources>
            <datasource caption='Attrition' name='federated.10yyxxn02juzfq16fpaje0nsua3y' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Overall' caption='p.Attrition (Termination Category)' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='Overall' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.10yyxxn02juzfq16fpaje0nsua3y].[Calculation_1405686038290096169]' caption='p.Attrition (Start Date)' datatype='date' default-format='*MMMM YYYY' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.10yyxxn02juzfq16fpaje0nsua3y].[Calculation_2932124874836996153]' _.fcp.ParameterDefaultValues.true...source-field='[federated.10yyxxn02juzfq16fpaje0nsua3y].[Calculation_1405686038290096169]' caption='p.Attrition (End Date)' datatype='date' default-format='*MMMM YYYY' name='[Parameter 9 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10yyxxn02juzfq16fpaje0nsua3y'>
            <column caption='c.Effective terminations (Voluntary)' datatype='integer' name='[Calculation_101260663796658176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category]= &apos;Voluntary&apos; THEN &#13;&#10;    [terminations_effective] &#10;END' />
            </column>
            <column caption='u.User Filter (Data Source level)' datatype='string' name='[Calculation_1020065330459803652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;Glovo - People Leadership&apos;) THEN 1&#10;&#10;ELSEIF USERNAME()=(&apos;jeongsoo.lee@glovoapp.com&apos;) THEN 1&#10;ELSEIF USERNAME()=(&apos;luka.bertasiute@glovoapp.com&apos;) THEN 1&#10;&#10;ELSEIF USERNAME() = (&apos;paula.polonio@glovoapp.com&apos;) THEN &#10;    IF [department] = &apos;People&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;agustina.cavotta@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] IN (&apos;Albania&apos;, &apos;Bosnia and Herzegovina&apos;, &apos;Bulgaria&apos;, &apos;Croatia&apos;, &apos;Moldova&apos;, &apos;Montenegro&apos;, &apos;Romania&apos;, &apos;SEE&apos;, &apos;Sebia&apos;,&apos;Slovenia&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;flor.badalucco@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] IN (&apos;Armenia&apos;, &apos;Belarus&apos;, &apos;ECA&apos;, &apos;Georgia&apos;, &apos;Kazakhstan&apos;, &apos;Kyrgyzstan&apos;, &apos;Poland&apos;, &apos;Ukraine&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;ginevra.motta@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] IN (&apos;Italy&apos;, &apos;Africa&apos;, &apos;Ghana&apos;, &apos;Ivory Coast&apos;, &apos;Kenya&apos;, &apos;Morocco&apos;, &apos;NA North Africa&apos;, &apos;Nigeria&apos;, &apos;SSA Sub-Saharan Africa&apos;,&apos;Tunisia&apos;, &apos;Uganda&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;eugenia.latrille@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] IN (&apos;Spain&apos;, &apos;Portugal&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;alejandra.verges@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] = &apos;Global HQ&apos; AND ([department] = &apos;Operations&apos; OR [department] = &apos;Partners &amp; Brands&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;anna.guzowska@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] = &apos;Global HQ&apos; AND ([department] = &apos;Q Commerce&apos; OR [department] = &apos;Marketing &amp; Growth&apos; OR [department] = &apos;On Demand&apos; OR [department] = &apos;Strategy &amp; New Business&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;maria.gomezdiaz@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] = &apos;Global HQ&apos; AND ([department] = &apos;Finance&apos; OR [department] = &apos;Global Affairs&apos;) THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME() = (&apos;martin.drabble@glovoapp.com&apos;) THEN &#10;    IF [glovo_scope] = &apos;Global HQ&apos; AND ([department] = &apos;Engineering&apos; OR [department] = &apos;Product&apos;) THEN 1 ELSE 0 END&#10;   &#10;&#10;END)' />
            </column>
            <column caption='c.Date (&gt;= 2023)' datatype='date' name='[Calculation_1405686038290096169]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [report_month]) &gt;= 2023 THEN [report_month] END' />
            </column>
            <column caption='c.Terminations effective (parameter-driven)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1561623178969870339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(&#13;&#10;    CASE [Parameters].[Parameter 11] &#13;&#10;        WHEN &quot;Voluntary&quot; THEN [Calculation_101260663796658176]&#13;&#10;        WHEN &quot;Involuntary&quot; THEN [Effective Voluntary Terminations (copy)_2932124874757550123]&#13;&#10;        ELSE [terminations_effective]&#13;&#10;    END&#13;&#10;),0)' />
            </column>
            <column caption='c.Select Termination Type' datatype='boolean' name='[Calculation_1561623178999898132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [termination_category] = [Parameters].[Parameter 11] THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='c.Date (Previous Month)' datatype='date' name='[Calculation_2932124874836996153]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())))' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_3179541352486285313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Talabat&apos; THEN&#13;&#10;    IF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2823&quot;)&#13;&#10;    THEN&#9;&#13;&#10;    (&#13;&#10;    IF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Q-commerce&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEif &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF  &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) &#13;&#10;    THEN&#13;&#10;    &quot;COO&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Tech&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Finance and Legal&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Product&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#13;&#10;&#13;&#10;    THEN&#13;&#10;    (if CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#13;&#10;    or CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)THEN&#13;&#10;    &quot;Strategy and Innovation&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    END)&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Comms, Public Affairs and Sustainability&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Chief Business Office&quot;&#13;&#10;    ELSEIF &#13;&#10;    CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#13;&#10;    THEN&#13;&#10;    &quot;Social Commerce&quot;&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2823&quot;&#13;&#10;    THEN&#13;&#10;    &quot;CEO&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;Unspecified&quot;&#13;&#10;    END&#13;&#10;    )&#13;&#10;    ELSEIF &#13;&#10;    [employee_id]=&quot;2020-06-2821&quot;&#13;&#10;    THEN&#13;&#10;    &quot;People and Culture&quot;&#13;&#10;    ELSE&#13;&#10;    &quot;DHSE&quot;&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
