        <calculation class='tableau' formula='if [MOM % Change moving avg Voluntary (copy)_1561623178974928905]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [MOM % Change moving avg Voluntary (copy)_1561623178974928905]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [MOM % Change moving avg Voluntary (copy)_1561623178974928905]&gt;0 then &quot;Red&quot; END'>
