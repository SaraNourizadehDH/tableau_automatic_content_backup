              <calculation class='tableau' formula='if [yoy changes M3+ (copy)_2322731514216071190]&lt;0 then &quot;Red&quot; &#13;&#10;ELSEIF [yoy changes M3+ (copy)_2322731514216071190]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [yoy changes M3+ (copy)_2322731514216071190]&gt;0 then &quot;Green&quot; END'>
