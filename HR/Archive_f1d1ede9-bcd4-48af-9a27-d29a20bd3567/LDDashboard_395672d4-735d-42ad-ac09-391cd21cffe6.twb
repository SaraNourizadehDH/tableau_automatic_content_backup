      <aliases enabled='yes' />
      <column caption='c.minutes viewed' datatype='real' name='[Calculation_1794402996213301248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Hours Viewed (LinkedIn Learning and Organization Content Only)]*60' />
      </column>
      <column caption='c.login rate/day' datatype='real' name='[Calculation_1794402996224811009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Email])/COUNTD(DATE([Started (PST/PDT)]))' />
      </column>
      <column caption='c.#times a person has logged in' datatype='real' name='[Calculation_1794402996225699842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(date([Started (PST/PDT)]))/COUNTD([Email])' />
      </column>
      <column caption='c.fix user login rate day2day' datatype='real' name='[Calculation_1794402996225953795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Email]:[Calculation_1794402996225699842]}' />
      </column>
      <column caption='c.users per day' datatype='integer' name='[Calculation_1794402996245991428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATE([Started (PST/PDT)]):COUNTD([Email])}' />
      </column>
      <column aggregation='Attribute' caption='c.#days used' datatype='integer' name='[Calculation_1794402996247666694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Email]:COUNTD(DATE([Started (PST/PDT)]))}' />
      </column>
      <column caption='c.mm-yy of start date' datatype='string' name='[Calculation_1794402996248535048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(MONTH(DATE([Started (PST/PDT)])))+&quot;-&quot;+str(year(DATE([Started (PST/PDT)])))' />
      </column>
      <column caption='c.unq users per month' datatype='integer' name='[Calculation_1794402996249497609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_1794402996248535048]:COUNTD([Email])}' />
      </column>
      <column caption='c.login rate 02 ' datatype='real' name='[Calculation_1794402996250054666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1794402996249497609]/30' />
      </column>
      <column caption='c.login rate final' datatype='real' name='[Calculation_1794402996251258891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Email]+[Calculation_1794402996248535048])/count([Email]+[Calculation_1794402996248535048])' />
      </column>
      <column caption='c.time per year' datatype='date' name='[Calculation_2492390551937318917]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1]=1&#10;THEN&#10;[Calculation_3341952429850071043]&#10;ELSE&#10;NULL&#10;END)' />
      </column>
      <column caption='c.time period' datatype='date' datatype-customized='true' name='[Calculation_3341952429850071043]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1]=1&#13;&#10;THEN&#13;&#10;DATETRUNC(&apos;year&apos;,[Started (PST/PDT)])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=2&#13;&#10;THEN&#13;&#10;DATETRUNC(&apos;quarter&apos;,[Started (PST/PDT)])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=3&#13;&#10;THEN&#13;&#10;DATETRUNC(&apos;month&apos;,[Started (PST/PDT)])&#13;&#10;END)' />
      </column>
