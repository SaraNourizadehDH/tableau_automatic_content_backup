    <worksheet name='emp level data'>
      <table>
        <view>
          <datasources>
            <datasource caption='Org Str-Custom SQL' name='federated.1eneugb1ulozxg18msjfj1yy1xca' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Including &apos;S&apos; Level' caption='p.span' datatype='real' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Including &apos;S&apos; Level' />
                <alias key='2.' value='Excluding &apos;S&apos; Level' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eneugb1ulozxg18msjfj1yy1xca'>
            <column caption='c.dept calc -wk' datatype='string' name='[Calculation_1078330644537782282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;CONTAINS([Manager ID concat],&quot;2020-06-2823&quot;)&#10;THEN&#9;&#10;(&#10;IF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-1616&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0247&quot;)&#9;&#10;THEN&#10;&quot;Q-commerce&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-11-1327&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEif &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-01-0022&quot;)&#9;&#10;THEN&#10;&quot;COO&quot;&#10;ELSEIF  &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2825&quot;) and [is_terminated]=1&#10;THEN&#10;&quot;COO&quot;&#10;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2813&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2824&quot;)&#9;&#10;THEN&#10;&quot;Finance and Legal&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2830&quot;)&#9;&#10;THEN&#10;&quot;Tech &amp; Product&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-08-0388&quot;)&#9;&#10;&#10;THEN&#10;(if CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2806&quot;) &#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0158&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-0244&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2120&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-09-0177&quot;)&#10;or CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;elseif contains(lower([department_wd]),&quot;strategy&quot;)&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSE&#10;&quot;People and Culture&quot;&#10;END)&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2822&quot;)&#9;&#10;THEN&#10;&quot;Strategy &amp; Comms&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-06-2821&quot;)&#9;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2020-09-0072&quot;)&#9;&#10;THEN&#10;&quot;Chief Business Office&quot;&#10;ELSEIF &#10;CONTAINS([Manager ID concat]+[employee_id],&quot;2021-09-0243&quot;)&#9;&#10;THEN&#10;&quot;Social Commerce&quot;&#10;&#10;ELSE&#10;&quot;Unspecified&quot;&#10;END&#10;)&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2823&quot;&#10;THEN&#10;&quot;CEO&quot;&#10;ELSEIF &#10;[employee_id]=&quot;2020-06-2821&quot;&#10;THEN&#10;&quot;People and Culture&quot;&#10;ELSE&#10;&quot;DHSE&quot;&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.eolm' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1080371331727900673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_terminated]=0&#10;THEN&#10;[employee_id]&#10;ELSEIF DATETRUNC(&apos;month&apos;,[last_day_of_work])=DATETRUNC(&apos;month&apos;,[report_effective_date])&#10;THEN&#10;[employee_id]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.dept calc tableau' datatype='string' name='[Calculation_1080371331780005891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1078330644537782282]' />
            </column>
            <column caption='c.managers' datatype='string' name='[Calculation_1080371331808014341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Managers]' />
            </column>
            <column caption='c.dept-tb filter' datatype='string' name='[Calculation_1682938947177443413]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[c.dept calc tableau (group)]' />
            </column>
            <column caption='c.tenure yrs' datatype='string' name='[Calculation_2935643288691707904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='left(str([Calculation_4397272468111724556]),FIND(str([Calculation_4397272468111724556]),&apos;.&apos;)+1)+&quot; yrs&quot;' />
            </column>
            <column caption='c.full name' datatype='string' name='[Calculation_2935643288693813249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='rtrim(SPLIT([full_name],&quot;(&quot;,1))' />
            </column>
            <column aggregation='Sum' caption='c.tenure' datatype='real' name='[Calculation_4397272468111724556]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1080371331727900673]&lt;&gt;&apos;&apos;&#10;THEN&#10;([report_effective_date]-[first_day_of_work])/365&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column caption='c.off/non-off' datatype='string' name='[Calculation_4397272469450493969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
            </column>
            <column caption='c.off/non/ssc/disp-exc' datatype='string' name='[Calculation_4397272470906855446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([sub_department_wd], &quot;SSC&quot;)&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF &#10;[sub_department_wd]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF [Calculation_4397272469450493969]=&quot;Non-Office&quot;&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office- Excl SSC/Dispatch&quot;&#10;END' />
            </column>
            <column caption='c.exc S filter' datatype='boolean' name='[Calculation_4928134305178836996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8]=1&#10;THEN&#10;TRUE&#10;ELSEIF [Parameters].[Parameter 8]=2&#10;THEN&#10;LEFT([management_level],1)&lt;&gt;&apos;S&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Manager ID concat]' role='dimension' type='nominal' />
            <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
            <column datatype='string' name='[business_title]' role='dimension' type='nominal' />
            <column datatype='string' name='[c.dept calc tableau (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_1080371331780005891]' new-bin='true'>
                <bin default-name='false' value='&quot;Q-commerce&quot;'>
                  <value>&quot;Q-Commerce&quot;</value>
                  <value>&quot;Q-commerce&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='c.managed by full name' datatype='string' name='[c.full name (copy)_2935643288693940226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='rtrim(SPLIT([managed_by_full_name],&quot;(&quot;,1))' />
