    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Management level distribution'>
      <repository-location derived-from='http://ip-172-31-0-77:8977/t/HR/workbooks/SpansandLayerswoOfficeSupport-SN/Managementleveldistribution?rev=' id='Managementleveldistribution' path='/t/HR/workbooks/SpansandLayerswoOfficeSupport-SN' revision='' site='HR' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='center' />
          <format attr='font-size' value='8' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1538' minheight='1000' minwidth='1538' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Org Str-Custom SQL' name='federated.1eneugb1ulozxg18msjfj1yy1xca' />
      </datasources>
      <datasource-dependencies datasource='federated.1eneugb1ulozxg18msjfj1yy1xca'>
        <column caption='c.dept calc tableau' datatype='string' name='[Calculation_1080371331780005891]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[Calculation_1078330644537782282]' />
        </column>
        <column caption='c.off/non-off' datatype='string' name='[Calculation_4397272469450493969]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([contract_type],&quot;Operational Worker&quot;)&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office&quot;&#10;END' />
        </column>
        <column caption='c.off/non/ssc/disp-exc' datatype='string' name='[Calculation_4397272470906855446]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([sub_department_wd], &quot;SSC&quot;)&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF &#10;[sub_department_wd]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF [Calculation_4397272469450493969]=&quot;Non-Office&quot;&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office- Excl SSC/Dispatch&quot;&#10;END' />
        </column>
        <column datatype='string' name='[Managers]' role='dimension' type='nominal' />
        <column datatype='string' name='[c.dept calc tableau (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[Calculation_1080371331780005891]' new-bin='true'>
            <bin default-name='false' value='&quot;Q-commerce&quot;'>
              <value>&quot;Q-Commerce&quot;</value>
              <value>&quot;Q-commerce&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='c.Emp or manager' datatype='string' name='[c.manager (copy)_1080371331802587140]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_people_manager]=&apos;1&apos;&#10;THEN&#10;&quot;People Manager&quot;&#10;ELSE&#10;&quot;Employee&quot;&#10;END' />
        </column>
        <column datatype='string' name='[layer_from_CEO]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Layer 1&quot;' value='CEO' />
            <alias key='&quot;Layer 2&quot;' value='CEO-1' />
            <alias key='&quot;Layer 3&quot;' value='CEO-2' />
            <alias key='&quot;Layer 4&quot;' value='CEO-3' />
            <alias key='&quot;Layer 5&quot;' value='CEO-4' />
            <alias key='&quot;Layer 6&quot;' value='CEO-5' />
            <alias key='&quot;Layer 7&quot;' value='CEO-6' />
            <alias key='&quot;Layer 8&quot;' value='CEO-7' />
          </aliases>
        </column>
