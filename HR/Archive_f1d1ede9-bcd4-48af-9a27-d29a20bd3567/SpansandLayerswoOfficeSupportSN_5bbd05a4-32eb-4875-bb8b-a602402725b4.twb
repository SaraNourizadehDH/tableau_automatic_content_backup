            <column caption='c.off/non/ssc/disp-exc' datatype='string' name='[Calculation_4397272470906855446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([sub_department_wd], &quot;SSC&quot;)&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF &#10;[sub_department_wd]=&quot;Logistics-Dispatch&quot;&#10;THEN&#10;&quot;SSC/Dispatch&quot;&#10;ELSEIF [Calculation_4397272469450493969]=&quot;Non-Office&quot;&#10;THEN&#10;&quot;Non-Office&quot;&#10;ELSE&#10;&quot;Office- Excl SSC/Dispatch&quot;&#10;END' />
