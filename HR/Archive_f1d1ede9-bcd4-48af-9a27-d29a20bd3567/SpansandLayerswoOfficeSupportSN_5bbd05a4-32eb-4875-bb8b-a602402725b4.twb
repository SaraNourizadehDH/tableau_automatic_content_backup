            <column aggregation='CountD' caption='c.IC with dir rep' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_3943816274820227073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_3357152053934907392]=&apos;IC&apos; and [Calculation_1682938945089581056]=&apos;Manager&apos;&#10;THEN&#10;[Calculation_1080371331727900673]&#10;ELSE&#10;NULL&#10;END' />
            </column>
            <column aggregation='Sum' caption='c.tenure' datatype='real' name='[Calculation_4397272468111724556]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1080371331727900673]&lt;&gt;&apos;&apos;&#10;THEN&#10;([report_effective_date]-[first_day_of_work])/365&#10;ELSE&#10;NULL&#10;END' />
