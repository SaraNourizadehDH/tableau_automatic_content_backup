      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Quality Hire' id='_65F97DA85D20406A8CF8117C2989D567'>
            <properties context=''>
              <relation connection='athena.1r9ei301kk2lru1c98dcz0wm9oud' name='Custom SQL Query' type='text'><![CDATA[WITH supervisory_org_group AS (
    SELECT
        employee_id,
        supervisory_org_id,
        CASE
            WHEN supervisory_org_id IN ('HIE95009','HIE96041','HIE95049','HIE96648','HIE95965','HIE95048','HIE14293','HIE96858','HIE95048','HIE96081','HIE96041','HIE96850','HIE96856','HIE13532','HIE95590', 'HIE95051') THEN 'Product'
