            WHEN supervisory_org_id IN ('HIE13419', 'HIE13434', 'HIE13439', 'HIE13444', 'HIE13446', 'HIE13447', 'HIE13487', 'HIE13496', 'HIE13542', 'HIE13575', 'HIE13576', 'HIE13705', 'HIE13707', 'HIE13758', 'HIE13759', 'HIE13771', 'HIE13785', 'HIE13793', 'HIE13794', 'HIE13875', 'HIE13891', 'HIE13905', 'HIE13906', 'HIE13953', 'HIE13957', 'HIE13961', 'HIE13989', 'HIE14016', 'HIE14076', 'HIE14151', 'HIE14155', 'HIE14192', 'HIE14297', 'HIE14307', 'HIE14454', 'HIE95038', 'HIE95102', 'HIE95118', 'HIE95122', 'HIE95124', 'HIE95146', 'HIE95147', 'HIE95149', 'HIE95152', 'HIE95154', 'HIE95262', 'HIE95456', 'HIE95634', 'HIE95650', 'HIE95651', 'HIE95730', 'HIE95852', 'HIE95855', 'HIE95856', 'HIE95921', 'HIE95955', 'HIE96152', 'HIE96189', 'HIE96230', 'HIE96251', 'HIE96253', 'HIE96353', 'HIE96412', 'HIE96416', 'HIE96530', 'HIE96539', 'HIE96600', 'HIE96602', 'HIE96606', 'HIE96664', 'HIE96674', 'HIE96845', 'HIE96865', 'HIE96872', 'HIE96890', 'HIE96893', 'HIE96938', 'HIE96951', 'HIE96955', 'HIE96970', 'HIE96992', 'HIE97035', 'HIE97069', 'HIE97123', 'HIE97129', 'HIE97150', 'HIE97161', 'HIE97205', 'HIE97217', 'HIE97228', 'HIE97230', 'HIE96530', 'HIE13785', 'HIE13419', 'HIE13961', 'HIE14076', 'HIE96630', 'HIE97235', 'HIE13435', 'HIE96780', 'HIE95336', 'HIE97132', 'HIE95544', 'HIE14585', 'HIE13811', 'HIE97068', 'HIE14562') THEN 'Total Africa'
            WHEN supervisory_org_id IN ('HIE13470', 'HIE13473', 'HIE13477', 'HIE13495', 'HIE13504', 'HIE13512', 'HIE13633', 'HIE13634', 'HIE13685', 'HIE13688', 'HIE13711', 'HIE13756', 'HIE13801', 'HIE13867', 'HIE13870', 'HIE14014', 'HIE14015', 'HIE14045', 'HIE14117', 'HIE14137', 'HIE14139', 'HIE14140', 'HIE14141', 'HIE14142', 'HIE14154', 'HIE14209', 'HIE14210', 'HIE14296', 'HIE14389', 'HIE14390', 'HIE14391', 'HIE95040', 'HIE95123', 'HIE95125', 'HIE95184', 'HIE95188', 'HIE95189', 'HIE95190', 'HIE95222', 'HIE95224', 'HIE95225', 'HIE95226', 'HIE95264', 'HIE95293', 'HIE95310', 'HIE95317', 'HIE95348', 'HIE95385', 'HIE95595', 'HIE95605', 'HIE95606', 'HIE95727', 'HIE95728', 'HIE95867', 'HIE95870', 'HIE95903', 'HIE95913', 'HIE95915', 'HIE96001', 'HIE96012', 'HIE96032', 'HIE96172', 'HIE96173', 'HIE96177', 'HIE96181', 'HIE96191', 'HIE96193', 'HIE96194', 'HIE96197', 'HIE96233', 'HIE96234', 'HIE96241', 'HIE96243', 'HIE96284', 'HIE96301', 'HIE96308', 'HIE96311', 'HIE96354', 'HIE96457', 'HIE96481', 'HIE96579', 'HIE96582', 'HIE96583', 'HIE96591', 'HIE96592', 'HIE96594', 'HIE96604', 'HIE96691', 'HIE96704', 'HIE96705', 'HIE96716', 'HIE96757', 'HIE96798', 'HIE96814', 'HIE96818', 'HIE96820', 'HIE96829', 'HIE96860', 'HIE96869', 'HIE96894', 'HIE96921', 'HIE96928', 'HIE96929', 'HIE96936', 'HIE96957', 'HIE96958', 'HIE96976', 'HIE96986', 'HIE97001', 'HIE97013', 'HIE97018', 'HIE97052', 'HIE97076', 'HIE97092', 'HIE97093', 'HIE97094', 'HIE97136', 'HIE97138', 'HIE97144', 'HIE97152', 'HIE97173', 'HIE97181', 'HIE97182', 'HIE97183', 'HIE97191', 'HIE97198', 'HIE97200', 'HIE97204', 'HIE95220', 'HIE97182', 'HIE95310', 'HIE96592', 'HIE96868', 'HIE96930', 'HIE97202', 'HIE95695', 'HIE96355', 'HIE14289', 'HIE96401') THEN 'Total PLECA'
            WHEN supervisory_org_id IN ('HIE13379', 'HIE13451', 'HIE13462', 'HIE13469', 'HIE13500', 'HIE13505', 'HIE13552', 'HIE13631', 'HIE13689', 'HIE13716', 'HIE13795', 'HIE13805', 'HIE13806', 'HIE13822', 'HIE13860', 'HIE13862', 'HIE13869', 'HIE13876', 'HIE13884', 'HIE13888', 'HIE13982', 'HIE14291', 'HIE14450', 'HIE95082', 'HIE95085', 'HIE95088', 'HIE95171', 'HIE95321', 'HIE95360', 'HIE95380', 'HIE95612', 'HIE95737', 'HIE95773', 'HIE95774', 'HIE95792', 'HIE95900', 'HIE95923', 'HIE95929', 'HIE95934', 'HIE95947', 'HIE95950', 'HIE95963', 'HIE95973', 'HIE95974', 'HIE95977', 'HIE96000', 'HIE96046', 'HIE96048', 'HIE96112', 'HIE96117', 'HIE96125', 'HIE96128', 'HIE96141', 'HIE96154', 'HIE96180', 'HIE96206', 'HIE96217', 'HIE96228', 'HIE96306', 'HIE96344', 'HIE96349', 'HIE96415', 'HIE96417', 'HIE96467', 'HIE96472', 'HIE96564', 'HIE96608', 'HIE96609', 'HIE96667', 'HIE96683', 'HIE96688', 'HIE96745', 'HIE96761', 'HIE96779', 'HIE96783', 'HIE96787', 'HIE96788', 'HIE96793', 'HIE96874', 'HIE96878', 'HIE96892', 'HIE96939', 'HIE96940', 'HIE96978', 'HIE96988', 'HIE97019', 'HIE97033', 'HIE97037', 'HIE97057', 'HIE97064', 'HIE97078', 'HIE97099', 'HIE97124', 'HIE97155', 'HIE97175', 'HIE97185', 'HIE97196', 'HIE97227', 'HIE95081', 'HIE96898', 'HIE96386', 'HIE14561', 'HIE96118', 'HIE14505', 'HIE13405', 'HIE14394', 'HIE96206', 'HIE96000', 'HIE95923', 'HIE96761', 'HIE95085', 'HIE97025', 'HIE97064', 'HIE13689', 'HIE96113', 'HIE95715', 'HIE96122', 'HIE13861', 'HIE97053', 'HIE96729', 'HIE95086', 'HIE96216', 'HIE97020') THEN 'Total SEE'
            WHEN supervisory_group IN ('Spain','Portugal','Italy') THEN 'Total WE'
            WHEN supervisory_group IN ('Product','Data','Engineering','Finance','Global Affairs','Marketing & Growth','Live Operations','Partner Operations','Logistics','P&B Brand Ads','P&B Commercial','Rest of Operations','People','Q Commerce','On Demand','Strategy & New Business','Executive') THEN 'Total HQ'
            WHEN supervisory_group IN ('DH Borrowed HC') THEN 'DH Borrowed HC'
            WHEN supervisory_group IN ('Placeholder Glovo Terminated Employees') THEN 'Placeholder Glovo Terminated Employees'
            ELSE 'Other'
        END AS regions,
        report_effective_date
    FROM supervisory_org_group
),
hq_intl AS (
    SELECT
        employee_id,
        supervisory_org_id,
        supervisory_group,
        regions,
        CASE
            WHEN supervisory_group IN ('Product','Data','Engineering','Finance','Global Affairs','Marketing & Growth','Live Operations','Partner Operations','Logistics','P&B Brand Ads','P&B Commercial','Rest of Operations','People','Q Commerce','On Demand','Strategy & New Business','Executive', 'International HQ') THEN 'Total HQ'
            WHEN regions IN ('Total Africa','Total PLECA','Total SEE','Total WE') THEN 'Total International'
            WHEN supervisory_group IN ('DH Borrowed HC') THEN 'DH Borrowed HC'
            WHEN supervisory_group IN ('Placeholder Glovo Terminated Employees') THEN 'Placeholder Glovo Terminated Employees'
            ELSE 'Other'
        END AS hq_intl_logic,
        report_effective_date
FROM regions
),
-- Cleaning the PR data, add the final result code, the review effective date, and rank
pr_ranking AS (
    SELECT
        employee_id,
        review_template,
        CASE
            WHEN final_9_box_position_in_manager_task IN ('Below Expectations/Role Model', 'Below Expectations/Lives', 'Below Expectations/Does not live', 'Solid Contributor/Does not live', 'Exceeds Expectations/Does not live') THEN 'Low'
            WHEN final_9_box_position_in_manager_task IN ('Solid Contributor/Lives') THEN 'Successful'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Lives', 'Solid Contributor/Role Model') THEN 'High'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Role Model') THEN 'Top'
            ELSE 'No Review'
        END AS final_result,
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN '2023-08-31'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN '2024-02-29'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN '2024-08-31'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN '2025-02-28'
        ELSE NULL END report_effective_date,
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY review_template) AS ranking
    FROM people_ops_proposed.il_glovo_performance
    WHERE manager_id IS NOT NULL -- filter only 1 row in PR table
),
 -- Select only hired employees in the last 1 year
group_selection AS (
    SELECT
        DATE_TRUNC('month', CAST(wh.report_effective_date AS DATE)) AS month,
        wh.employee_id,
        wp.preferred_full_name AS worker,
        hi.supervisory_org_id,
        hi.supervisory_group,
        hi.regions,
        hi.hq_intl_logic,
        wh.original_first_day_of_work,
        wh.last_day_of_work,
        wh.is_terminated,
        wh.on_leave,
        wh.management_level,
        wh.job_family_group,
        wh.job_family,
        CASE
            WHEN wh.is_terminated = 0
            THEN ROUND(DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.report_effective_date AS DATE)) / 30.0, 1) -- Active : Date diff Hire date - Report effective date
            ELSE ROUND(DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.last_day_of_work AS DATE)) / 30.0, 1) -- Terminated : Date diff Hire date  - termination date
        END AS tenure_by_month,
        pr.review_template AS first_review,
        pr.final_result AS first_pr_result,
        CASE WHEN final_result = 'Low' THEN 'Yes' ELSE 'No' END AS first_pr_low,
        CASE WHEN final_result IN ('Successful', 'Top', 'High') THEN 'Yes' ELSE 'No' END AS first_pr_not_low
    FROM people_ops_proposed.il_worker_hist_with_current AS wh
    LEFT JOIN pr_ranking AS pr ON pr.employee_id = wh.employee_id AND
                                pr.report_effective_date <<= wh.report_effective_date AND pr.ranking = 1 AND -- select only the PR happened before report effective date + select only the first PR
                                pr.report_effective_date >> wh.original_first_day_of_work -- make sure that the PR happened after hire date to account for rehires
    LEFT JOIN people_ops_proposed.il_worker_personal AS wp ON wh.employee_id = wp.employee_id
    LEFT JOIN hq_intl AS hi ON hi.employee_id = wh.employee_id AND wh.report_effective_date = hi.report_effective_date
    WHERE wh.report_effective_date >>= '2024-01-31'
    AND wh.contract_type IN ('Permanent', 'Fixed Term (Fixed Term)')
    AND (lower(wh.position) NOT LIKE '%picker%' OR lower(wh.position) LIKE '%agent%')
    AND CAST(wh.original_first_day_of_work  AS DATE) >>= DATE_ADD('year', -1, CAST(wh.report_effective_date AS DATE)) -- this subtracts 1 year from the report_effective_date, giving you the date 1 year before the effective date
    AND CAST(wh.original_first_day_of_work  AS DATE) <<= CAST(wh.report_effective_date AS DATE) -- no future hires are not included here
),
probation AS (
    SELECT
        gs.month,
        gs.employee_id,
        gs.worker,
        gs.supervisory_org_id,
        gs.supervisory_group,
        gs.regions,
        gs.hq_intl_logic,
        gs.original_first_day_of_work,
        gs.last_day_of_work,
        gs.is_terminated,
        gs.on_leave,
        gs.management_level,
        gs.job_family_group,
        gs.job_family,
        gs.tenure_by_month,
        gs.first_review,
        gs.first_pr_result,
        gs.first_pr_low,
        gs.first_pr_not_low,
        CASE
            WHEN gs.tenure_by_month >>= 6 THEN 'probation_passed'
            WHEN gs.tenure_by_month << 6 AND gs.is_terminated = 0 THEN 'probation_in_progress'
            WHEN gs.tenure_by_month << 6 AND gs.is_terminated = 1 THEN 'probation_not_passed'
        END AS probation_status
    FROM group_selection gs
),
termination AS (
    SELECT
        t.employee_id,
        date_trunc('month', date(t.termination_effective_date)) AS termination_effective_date,
        t.termination_category,
        t.termination_reason,
        t.local_termination_reason
    FROM people_ops_proposed.il_termination t
    WHERE t.status = 'Successfully Completed'
)
SELECT
    pc.month,
    pc.employee_id,
    pc.worker,
    pc.supervisory_org_id,
    pc.supervisory_group,
    pc.regions,
    pc.hq_intl_logic,
    pc.original_first_day_of_work,
    pc.is_terminated,
    pc.last_day_of_work,
    t.termination_category,
    t.termination_reason,
    t.local_termination_reason,
    pc.on_leave,
    pc.management_level,
    pc.job_family_group,
    pc.job_family,
    pc.tenure_by_month,
    pc.probation_status,
    pc.first_review,
    pc.first_pr_result,
    pc.first_pr_low,
    pc.first_pr_not_low,
    CASE WHEN (pc.is_terminated = 0 AND pc.tenure_by_month >>= 6 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) THEN 'Yes' ELSE 'No' END AS probation_passed_pending_1st_pr,
    CASE WHEN (pc.is_terminated = 0 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) OR
                (pc.is_terminated = 1 AND pc.tenure_by_month >>= 6 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) OR
                (pc.is_terminated = 0 AND pc.tenure_by_month << 6 AND pc.first_pr_result IN ('Successful','High','Top')) THEN 'No' ELSE 'Yes' END AS is_eligible,
    CASE WHEN pc.tenure_by_month >>= 6 AND pc.first_pr_result IN ('Successful', 'Top', 'High') THEN 'Yes' ELSE 'No' END AS is_quality_of_hire,
    CURRENT_DATE AS report_effective_date
FROM probation AS pc
LEFT JOIN termination AS t on pc.employee_id = t.employee_id AND pc.month = t.termination_effective_date
ORDER BY pc.month DESC]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
