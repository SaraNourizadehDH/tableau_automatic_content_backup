            <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Not Eligible' datatype='integer' name='[Calculation_1986087482740969474]' role='measure' type='quantitative'>
