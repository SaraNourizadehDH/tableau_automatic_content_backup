    <worksheet name='HQ: Quality Hire Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Quality Hire Rate</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Quality Hire Rate</run>
            <run fontsize='8'> = Count of Quality Hires / Total Eligible Employees</run>
            <run>Æ&#10;</run>
            <run fontsize='8'>Excluding divisions with less than 10 eligible employees</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target (80%)' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.8'>
              <calculation class='tableau' formula='0.8' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Quality Hire Rate' datatype='real' name='[Calculation_4002363106436399106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_quality_of_hire] = &apos;Yes&apos; THEN 1 ELSE 0 END) / SUM(IF [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_eligible]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_quality_of_hire]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column caption='Job Family Group' datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[job_family]' derivation='None' name='[none:job_family:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family_group]' derivation='None' name='[none:job_family_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[regions]' derivation='None' name='[none:regions:nk]' pivot='key' type='nominal' />
            <column-instance column='[supervisory_group]' derivation='None' name='[none:supervisory_group:nk]' pivot='key' type='nominal' />
            <column caption='Regions (Sup Org)' datatype='string' name='[regions]' role='dimension' type='nominal' />
            <column caption='Department/Country (Sup Org)' datatype='string' name='[supervisory_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1986087482740817921]' derivation='User' name='[usr:Calculation_1986087482740817921:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4002363106436399106]' derivation='User' name='[usr:Calculation_4002363106436399106:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[my:month:ok]' filter-group='4'>
            <groupfilter function='member' level='[my:month:ok]' member='202502' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[none:job_family:nk]' filter-group='10'>
            <groupfilter function='level-members' level='[none:job_family:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[none:job_family_group:nk]' filter-group='6'>
            <groupfilter function='level-members' level='[none:job_family_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[none:management_level:nk]' filter-group='11'>
            <groupfilter function='level-members' level='[none:management_level:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[none:regions:nk]'>
            <groupfilter function='member' level='[none:regions:nk]' member='&quot;Total HQ&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
