        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1r9ei301kk2lru1c98dcz0wm9oud' name='Custom SQL Query' type='text'><![CDATA[WITH supervisory_org_group AS (
    SELECT
        employee_id,
        supervisory_org_id,
        CASE
            WHEN supervisory_org_id IN ('HIE95009','HIE96041','HIE95049','HIE96648','HIE95965','HIE95048','HIE14293','HIE96858','HIE95048','HIE96081','HIE96041','HIE96850','HIE96856','HIE13532','HIE95590', 'HIE95051') THEN 'Product'
            WHEN supervisory_org_id IN ('HIE96652','HIE95641','HIE96636','HIE96513','HIE97236','HIE96513','HIE97011','HIE96268','HIE97012','HIE96470','HIE97157','HIE95112','HIE97003','HIE97065','HIE96225','HIE97193','HIE97238','HIE97021','HIE95655','HIE95953','HIE97041','HIE96747','HIE96722','HIE97119','HIE95449','HIE95742','HIE96730', 'HIE96087') THEN 'Data'
            WHEN supervisory_org_id IN ('HIE95016','HIE95563','HIE95324','HIE95092','HIE95322','HIE97244','HIE97176','HIE97177','HIE96909','HIE97243','HIE95960','HIE96909','HIE95073','HIE95075','HIE13443','HIE96139','HIE95074','HIE14173','HIE95073','HIE96910','HIE96905','HIE97242','HIE95077','HIE95482','HIE96560','HIE96566','HIE96384','HIE96511','HIE95878','HIE96350','HIE95482','HIE96049','HIE96324','HIE13959','HIE97197','HIE13388','HIE13448','HIE97043','HIE96473','HIE96049','HIE96678','HIE97091','HIE96679','HIE95713','HIE96448','HIE13445','HIE96490','HIE96339','HIE96679','HIE95570','HIE95476','HIE95490','HIE96479','HIE96145','HIE95592','HIE95762','HIE96003','HIE96391','HIE96800','HIE97241','HIE95768','HIE13432','HIE96778','HIE96800','HIE97024','HIE96447','HIE96296','HIE96007','HIE13783','HIE97024','HIE96637','HIE96003','HIE95568','HIE95477','HIE96082','HIE95477','HIE95475','HIE13896','HIE95475', 'HIE95823', 'HIE95568', 'HIE95570', 'HIE13948', 'HIE96695', 'HIE96710', 'HIE97015', 'HIE95808', 'HIE95968', 'HIE13810', 'HIE96024', 'HIE96275', 'HIE97178') THEN 'Engineering'
            WHEN supervisory_org_id IN ('HIE95011','HIE95069','HIE97107','HIE95389','HIE95390','HIE95983','HIE95063','HIE95910','HIE13840','HIE13809','HIE95136','HIE97005','HIE95061','HIE95854','HIE96150','HIE96857','HIE95071','HIE95859','HIE96058','HIE95499','HIE97002','HIE97006','HIE97148','HIE95499','HIE97149','HIE95071','HIE95072','HIE96815','HIE95993','HIE96358','HIE95991','HIE95286','HIE13791','HIE95061','HIE95062','HIE95098','HIE96753','HIE14497','HIE95099','HIE97180','HIE13481','HIE96877','HIE95097','HIE13533','HIE95100','HIE97190','HIE97174','HIE96085','HIE13963','HIE97023','HIE95062','HIE95052','HIE13563','HIE95811','HIE95002','HIE95052','HIE95066','HIE96813', 'HIE95818', 'HIE13418', 'HIE97100', 'HIE95070', 'HIE14601') THEN 'Finance'
            WHEN supervisory_org_id IN ('HIE95006','HIE96432','HIE13382','HIE96414','HIE95023','HIE13437','HIE13440','HIE95839','HIE96340','HIE13883') THEN 'Global Affairs'
            WHEN supervisory_org_id IN ('HIE95007','HIE95029','HIE95116','HIE95205','HIE95207','HIE95673','HIE95393','HIE95029','HIE95031','HIE96341','HIE97115','HIE96487','HIE13790','HIE97214','HIE95619','HIE96341','HIE95030','HIE95035','HIE95699','HIE95507','HIE13400','HIE95720','HIE95699','HIE97030','HIE13670','HIE96886','HIE96088','HIE95864','HIE95035','HIE95045','HIE95034','HIE97166','HIE97166','HIE96080','HIE95469','HIE95034', 'HIE95117') THEN 'Marketing & Growth'
            WHEN supervisory_org_id IN ('HIE96034') THEN 'International HQ'
            -- Operations
            WHEN supervisory_org_id IN ('HIE13927', 'HIE14264', 'HIE95058', 'HIE95174', 'HIE95239', 'HIE95266', 'HIE95267', 'HIE95284', 'HIE95350', 'HIE95351', 'HIE95404', 'HIE95405', 'HIE95406', 'HIE95407', 'HIE95661', 'HIE95710', 'HIE95760', 'HIE95780', 'HIE95813', 'HIE95835', 'HIE95846', 'HIE95994', 'HIE95996', 'HIE96187', 'HIE96188', 'HIE96204', 'HIE96270', 'HIE96292', 'HIE96505', 'HIE96555', 'HIE96557', 'HIE96558', 'HIE96568', 'HIE96709', 'HIE96733', 'HIE96862', 'HIE96864', 'HIE97215', 'HIE95426', 'HIE96201') THEN 'Live Operations'
            WHEN supervisory_org_id IN ('HIE13377', 'HIE13468', 'HIE13802', 'HIE13803', 'HIE13947', 'HIE14211', 'HIE14442', 'HIE95053', 'HIE95140', 'HIE95215', 'HIE95231', 'HIE95236', 'HIE95356', 'HIE95358', 'HIE95460', 'HIE95463', 'HIE95550', 'HIE95767', 'HIE95802', 'HIE96287', 'HIE96445', 'HIE96665', 'HIE96739', 'HIE96834', 'HIE97029', 'HIE97199', 'HIE95357', 'HIE14496') THEN 'Logistics'
            WHEN supervisory_org_id IN ('HIE14250', 'HIE95004', 'HIE95056', 'HIE95059', 'HIE96474', 'HIE96913', 'HIE96200') THEN 'Partner Operations'
            WHEN supervisory_org_id IN ('HIE13630', 'HIE95021', 'HIE96373', 'HIE96661') THEN 'P&B Brand Ads'
            WHEN supervisory_org_id IN ('HIE13872', 'HIE95019', 'HIE95067', 'HIE95068', 'HIE95143', 'HIE96299', 'HIE96727', 'HIE96735', 'HIE14592', 'HIE14551', 'HIE96916') THEN 'P&B Commercial'
            WHEN supervisory_org_id IN ('HIE95010') THEN 'Rest of Operations'
            --
            WHEN supervisory_org_id IN ('HIE13449', 'HIE14073', 'HIE95013', 'HIE95027', 'HIE95105', 'HIE95110', 'HIE95166', 'HIE95276', 'HIE95277', 'HIE95289', 'HIE95311', 'HIE95392', 'HIE95547', 'HIE95573', 'HIE95632', 'HIE95678', 'HIE95838', 'HIE96254', 'HIE96257', 'HIE96263', 'HIE96286', 'HIE96300', 'HIE96377', 'HIE96577', 'HIE96587', 'HIE96589', 'HIE96681', 'HIE96687', 'HIE96726', 'HIE96740', 'HIE96767', 'HIE96887', 'HIE96932', 'HIE96944', 'HIE96948', 'HIE96964', 'HIE96972', 'HIE97027', 'HIE97048', 'HIE97072', 'HIE97106', 'HIE97116', 'HIE97117', 'HIE97208', 'HIE97216', 'HIE97222', 'HIE95280', 'HIE95272', 'HIE96103', 'HIE95275', 'HIE13458') THEN 'People'
            WHEN supervisory_org_id IN ('HIE13401', 'HIE13403', 'HIE13438', 'HIE13463', 'HIE13787', 'HIE14118', 'HIE95012', 'HIE95246', 'HIE95269', 'HIE95270', 'HIE95271', 'HIE95349', 'HIE95352', 'HIE95353', 'HIE95616', 'HIE95648', 'HIE95781', 'HIE95862', 'HIE95863', 'HIE96151', 'HIE96240', 'HIE96247', 'HIE96343', 'HIE96392', 'HIE96863', 'HIE96999', 'HIE97028', 'HIE97165', 'HIE97109') THEN 'Q Commerce'
            WHEN supervisory_org_id IN ('HIE95014', 'HIE95448', 'HIE96223', 'HIE96232', 'HIE96873', 'HIE97032', 'HIE97218') THEN 'On Demand'
            WHEN supervisory_org_id IN ('HIE95447', 'HIE96043', 'HIE97110') THEN 'Strategy & New Business'
            -- INTL
            -- Total Africa
            WHEN supervisory_org_id IN ('HIE13875', 'HIE95102', 'HIE96253', 'HIE96416', 'HIE96890', 'HIE97228', 'HIE13811') THEN 'Kenya'
            WHEN supervisory_org_id IN ('HIE13575', 'HIE13758', 'HIE13759', 'HIE13794', 'HIE95122', 'HIE95147', 'HIE95152', 'HIE95154', 'HIE95651', 'HIE96189', 'HIE96602', 'HIE96606', 'HIE96664', 'HIE96865', 'HIE96872', 'HIE96992', 'HIE97123', 'HIE97129', 'HIE97205', 'HIE97217', 'HIE97230', 'HIE97235', 'HIE14562') THEN 'Morocco'
            WHEN supervisory_org_id IN ('HIE96230', 'HIE96251') THEN 'Uganda'
            WHEN supervisory_org_id IN ('HIE13891', 'HIE13906', 'HIE13989', 'HIE14016', 'HIE14297', 'HIE95456', 'HIE95955', 'HIE96353') THEN 'Ivory Coast'
            WHEN supervisory_org_id IN ('HIE13434', 'HIE13446', 'HIE13905', 'HIE14155', 'HIE14307', 'HIE95650', 'HIE95852', 'HIE95855', 'HIE96845', 'HIE13435', 'HIE13435') THEN 'Nigeria'
            WHEN supervisory_org_id IN ('HIE13444', 'HIE14192', 'HIE95730', 'HIE96152', 'HIE96539', 'HIE96955', 'HIE97069', 'HIE97161', 'HIE14585', 'HIE97068') THEN 'Tunisia'
            WHEN supervisory_org_id IN ('HIE96780', 'HIE95544') THEN 'Ghana'
            -- Total PLECA
            WHEN supervisory_org_id IN ('HIE13477', 'HIE13685', 'HIE14390', 'HIE96191', 'HIE96234', 'HIE96829') THEN 'Armenia'
            WHEN supervisory_org_id IN ('HIE13870', 'HIE14014', 'HIE14015', 'HIE14154', 'HIE14296', 'HIE95123', 'HIE95188', 'HIE95189', 'HIE95190', 'HIE95293', 'HIE95348', 'HIE96001', 'HIE96032', 'HIE96197', 'HIE96582', 'HIE96583', 'HIE96604', 'HIE96894') THEN 'Georgia'
            WHEN supervisory_org_id IN ('HIE13470', 'HIE13473', 'HIE13504', 'HIE13688', 'HIE14137', 'HIE95224', 'HIE95385', 'HIE96177', 'HIE96193', 'HIE96594', 'HIE96818', 'HIE96820', 'HIE97183', 'HIE97204', 'HIE95695') THEN 'Kazakhstan'
            WHEN supervisory_org_id IN ('HIE95225', 'HIE96194', 'HIE96481', 'HIE96814', 'HIE96976', 'HIE96986', 'HIE96930') THEN 'Kyrgyzstan'
            WHEN supervisory_org_id IN ('HIE13512', 'HIE13633', 'HIE13756', 'HIE13801', 'HIE13867', 'HIE14117', 'HIE14139', 'HIE14140', 'HIE14141', 'HIE14142', 'HIE14209', 'HIE14210', 'HIE14389', 'HIE14391', 'HIE95040', 'HIE95184', 'HIE95264', 'HIE95727', 'HIE95728', 'HIE95903', 'HIE95913', 'HIE96012', 'HIE96172', 'HIE96233', 'HIE96301', 'HIE96308', 'HIE96311', 'HIE96457', 'HIE96579', 'HIE96691', 'HIE96704', 'HIE96798', 'HIE96957', 'HIE96958', 'HIE97013', 'HIE97092', 'HIE97093', 'HIE97094', 'HIE97136', 'HIE97138', 'HIE97144', 'HIE97198', 'HIE96868') THEN 'Poland'
            WHEN supervisory_org_id IN ('HIE14045', 'HIE95226', 'HIE95595', 'HIE96591', 'HIE96716', 'HIE96869', 'HIE96921', 'HIE96936', 'HIE97001', 'HIE97173', 'HIE13495', 'HIE13711', 'HIE95222', 'HIE95317', 'HIE95605', 'HIE95606', 'HIE95867', 'HIE95870', 'HIE96173', 'HIE96181', 'HIE96241', 'HIE96243', 'HIE96284', 'HIE96354', 'HIE96705', 'HIE96928', 'HIE96929', 'HIE97018', 'HIE97052', 'HIE97152', 'HIE97191', 'HIE97200', 'HIE96355', 'HIE14289', 'HIE96401') THEN 'Ukraine'
            -- Total SEE
            WHEN supervisory_org_id IN ('HIE13405', 'HIE96206', 'HIE96000', 'HIE95923', 'HIE96761', 'HIE95085') THEN 'Bosnia and Herzegovina'
            WHEN supervisory_org_id IN ('HIE13451', 'HIE95792', 'HIE95929', 'HIE95934', 'HIE95947', 'HIE95950', 'HIE96415', 'HIE96417', 'HIE96564', 'HIE96688', 'HIE96783', 'HIE96793', 'HIE97124') THEN 'Bulgaria'
            WHEN supervisory_org_id IN ('HIE13505', 'HIE13805', 'HIE13806', 'HIE14291', 'HIE95321', 'HIE95963', 'HIE96344', 'HIE96467', 'HIE96683', 'HIE96978', 'HIE97155', 'HIE14505') THEN 'Croatia'
            WHEN supervisory_org_id IN ('HIE13552', 'HIE96048', 'HIE96779', 'HIE96892', 'HIE97033') THEN 'Moldova'
            WHEN supervisory_org_id IN ('HIE13822', 'HIE95737', 'HIE95973', 'HIE96349', 'HIE96472', 'HIE96608', 'HIE96667') THEN 'Montenegro'
            WHEN supervisory_org_id IN ('HIE13379', 'HIE13469', 'HIE13631', 'HIE13860', 'HIE13862', 'HIE13869', 'HIE13876', 'HIE95171', 'HIE95360', 'HIE95773', 'HIE95774', 'HIE96046', 'HIE96112', 'HIE96117', 'HIE96125', 'HIE96128', 'HIE96141', 'HIE96154', 'HIE96788', 'HIE96874', 'HIE96940', 'HIE97057', 'HIE97078', 'HIE97099', 'HIE97196', 'HIE97227', 'HIE14561', 'HIE96118', 'HIE14394', 'HIE96113', 'HIE95715', 'HIE96122', 'HIE13861', 'HIE97053') THEN 'Romania'
            WHEN supervisory_org_id IN ('HIE13462', 'HIE13884', 'HIE95088', 'HIE95380', 'HIE95974', 'HIE95977', 'HIE96180', 'HIE96217', 'HIE96228', 'HIE96306', 'HIE96745', 'HIE96787', 'HIE96878', 'HIE97185', 'HIE96729', 'HIE96216') THEN 'Serbia'
            -- Spain
            WHEN supervisory_org_id IN ('HIE13378', 'HIE13397', 'HIE13488', 'HIE13502', 'HIE13522', 'HIE13772', 'HIE13900', 'HIE14144', 'HIE14145', 'HIE95008', 'HIE95167', 'HIE95170', 'HIE95216', 'HIE95263', 'HIE95297', 'HIE95299', 'HIE95300', 'HIE95319', 'HIE95342', 'HIE95396', 'HIE95398', 'HIE95399', 'HIE95402', 'HIE95436', 'HIE95437', 'HIE95439', 'HIE95452', 'HIE95484', 'HIE95485', 'HIE95553', 'HIE95556', 'HIE95578', 'HIE95579', 'HIE95601', 'HIE95621', 'HIE95645', 'HIE95692', 'HIE95697', 'HIE95744', 'HIE95794', 'HIE95979', 'HIE96077', 'HIE96102', 'HIE96167', 'HIE96175', 'HIE96242', 'HIE96295', 'HIE96351', 'HIE96388', 'HIE96476', 'HIE96478', 'HIE96485', 'HIE96492', 'HIE96541', 'HIE96580', 'HIE96642', 'HIE96650', 'HIE96655', 'HIE96668', 'HIE96718', 'HIE96870', 'HIE96876', 'HIE96884', 'HIE96924', 'HIE96980', 'HIE96990', 'HIE97044', 'HIE97070', 'HIE97140', 'HIE97237', 'HIE97239', 'HIE95364', 'HIE96376', 'HIE95486', 'HIE14165', 'HIE95486') THEN 'Spain'
            -- Portugal
            WHEN supervisory_org_id IN ('HIE13431', 'HIE13684', 'HIE13704', 'HIE14046', 'HIE14176', 'HIE95257', 'HIE95295', 'HIE95369', 'HIE95370', 'HIE95465', 'HIE95466', 'HIE95707', 'HIE95971', 'HIE96160', 'HIE96161', 'HIE96162', 'HIE96290', 'HIE96362', 'HIE96364', 'HIE96365', 'HIE96626', 'HIE96764', 'HIE96837', 'HIE96880', 'HIE97082', 'HIE97084', 'HIE97126', 'HIE97133', 'HIE97194') THEN 'Portugal'
            -- Italy
            WHEN supervisory_org_id IN ('HIE13510', 'HIE13560', 'HIE13764', 'HIE13788', 'HIE13879', 'HIE13960', 'HIE13983', 'HIE95039', 'HIE95134', 'HIE95158', 'HIE95197', 'HIE95373', 'HIE95421', 'HIE95522', 'HIE95523', 'HIE95527', 'HIE95528', 'HIE95693', 'HIE95703', 'HIE95705', 'HIE95718', 'HIE96062', 'HIE96325', 'HIE96331', 'HIE96337', 'HIE96434', 'HIE96480', 'HIE96501', 'HIE96620', 'HIE96622', 'HIE96643', 'HIE96660', 'HIE96901', 'HIE96965', 'HIE96982', 'HIE96985', 'HIE97007', 'HIE97038', 'HIE97062', 'HIE97120', 'HIE97125', 'HIE97134', 'HIE97210', 'HIE97220', 'HIE97245','HIE95422') THEN 'Italy'
            -- Executive
            WHEN supervisory_org_id IN ('HIE95001','HIE12875','HIE95005','HIE14013') THEN 'Executive' -- VPs, Oscar, Executive Assistants and WorldCoo
            -- DH Borrowed HC
            WHEN supervisory_org_id IN ('HIE04930', 'HIE13738', 'HIE00170', 'HIE00267', 'HIE14568', 'HIE13380', 'HIE01231', 'HIE12039', 'HIE14204') THEN 'DH Borrowed HC'
            -- Placeholder Glovo Terminated Employees
            WHEN supervisory_org_id IN ('HIE13356') THEN 'Placeholder Glovo Terminated Employees'
            ELSE 'Other'
        END AS supervisory_group,
        report_effective_date
    FROM people_ops_proposed.il_worker_hist_with_current
    WHERE report_effective_date >>= '2024-05-31'
    AND contract_type IN ('Permanent', 'Fixed Term (Fixed Term)')
    AND (lower(position) NOT LIKE '%picker%' OR lower(position) LIKE '%agent%')
),
regions AS (
    SELECT
        employee_id,
        supervisory_org_id,
        supervisory_group,
        CASE
            WHEN supervisory_org_id IN ('HIE13419', 'HIE13434', 'HIE13439', 'HIE13444', 'HIE13446', 'HIE13447', 'HIE13487', 'HIE13496', 'HIE13542', 'HIE13575', 'HIE13576', 'HIE13705', 'HIE13707', 'HIE13758', 'HIE13759', 'HIE13771', 'HIE13785', 'HIE13793', 'HIE13794', 'HIE13875', 'HIE13891', 'HIE13905', 'HIE13906', 'HIE13953', 'HIE13957', 'HIE13961', 'HIE13989', 'HIE14016', 'HIE14076', 'HIE14151', 'HIE14155', 'HIE14192', 'HIE14297', 'HIE14307', 'HIE14454', 'HIE95038', 'HIE95102', 'HIE95118', 'HIE95122', 'HIE95124', 'HIE95146', 'HIE95147', 'HIE95149', 'HIE95152', 'HIE95154', 'HIE95262', 'HIE95456', 'HIE95634', 'HIE95650', 'HIE95651', 'HIE95730', 'HIE95852', 'HIE95855', 'HIE95856', 'HIE95921', 'HIE95955', 'HIE96152', 'HIE96189', 'HIE96230', 'HIE96251', 'HIE96253', 'HIE96353', 'HIE96412', 'HIE96416', 'HIE96530', 'HIE96539', 'HIE96600', 'HIE96602', 'HIE96606', 'HIE96664', 'HIE96674', 'HIE96845', 'HIE96865', 'HIE96872', 'HIE96890', 'HIE96893', 'HIE96938', 'HIE96951', 'HIE96955', 'HIE96970', 'HIE96992', 'HIE97035', 'HIE97069', 'HIE97123', 'HIE97129', 'HIE97150', 'HIE97161', 'HIE97205', 'HIE97217', 'HIE97228', 'HIE97230', 'HIE96530', 'HIE13785', 'HIE13419', 'HIE13961', 'HIE14076', 'HIE96630', 'HIE97235', 'HIE13435', 'HIE96780', 'HIE95336', 'HIE97132', 'HIE95544', 'HIE14585', 'HIE13811', 'HIE97068', 'HIE14562') THEN 'Total Africa'
            WHEN supervisory_org_id IN ('HIE13470', 'HIE13473', 'HIE13477', 'HIE13495', 'HIE13504', 'HIE13512', 'HIE13633', 'HIE13634', 'HIE13685', 'HIE13688', 'HIE13711', 'HIE13756', 'HIE13801', 'HIE13867', 'HIE13870', 'HIE14014', 'HIE14015', 'HIE14045', 'HIE14117', 'HIE14137', 'HIE14139', 'HIE14140', 'HIE14141', 'HIE14142', 'HIE14154', 'HIE14209', 'HIE14210', 'HIE14296', 'HIE14389', 'HIE14390', 'HIE14391', 'HIE95040', 'HIE95123', 'HIE95125', 'HIE95184', 'HIE95188', 'HIE95189', 'HIE95190', 'HIE95222', 'HIE95224', 'HIE95225', 'HIE95226', 'HIE95264', 'HIE95293', 'HIE95310', 'HIE95317', 'HIE95348', 'HIE95385', 'HIE95595', 'HIE95605', 'HIE95606', 'HIE95727', 'HIE95728', 'HIE95867', 'HIE95870', 'HIE95903', 'HIE95913', 'HIE95915', 'HIE96001', 'HIE96012', 'HIE96032', 'HIE96172', 'HIE96173', 'HIE96177', 'HIE96181', 'HIE96191', 'HIE96193', 'HIE96194', 'HIE96197', 'HIE96233', 'HIE96234', 'HIE96241', 'HIE96243', 'HIE96284', 'HIE96301', 'HIE96308', 'HIE96311', 'HIE96354', 'HIE96457', 'HIE96481', 'HIE96579', 'HIE96582', 'HIE96583', 'HIE96591', 'HIE96592', 'HIE96594', 'HIE96604', 'HIE96691', 'HIE96704', 'HIE96705', 'HIE96716', 'HIE96757', 'HIE96798', 'HIE96814', 'HIE96818', 'HIE96820', 'HIE96829', 'HIE96860', 'HIE96869', 'HIE96894', 'HIE96921', 'HIE96928', 'HIE96929', 'HIE96936', 'HIE96957', 'HIE96958', 'HIE96976', 'HIE96986', 'HIE97001', 'HIE97013', 'HIE97018', 'HIE97052', 'HIE97076', 'HIE97092', 'HIE97093', 'HIE97094', 'HIE97136', 'HIE97138', 'HIE97144', 'HIE97152', 'HIE97173', 'HIE97181', 'HIE97182', 'HIE97183', 'HIE97191', 'HIE97198', 'HIE97200', 'HIE97204', 'HIE95220', 'HIE97182', 'HIE95310', 'HIE96592', 'HIE96868', 'HIE96930', 'HIE97202', 'HIE95695', 'HIE96355', 'HIE14289', 'HIE96401') THEN 'Total PLECA'
            WHEN supervisory_org_id IN ('HIE13379', 'HIE13451', 'HIE13462', 'HIE13469', 'HIE13500', 'HIE13505', 'HIE13552', 'HIE13631', 'HIE13689', 'HIE13716', 'HIE13795', 'HIE13805', 'HIE13806', 'HIE13822', 'HIE13860', 'HIE13862', 'HIE13869', 'HIE13876', 'HIE13884', 'HIE13888', 'HIE13982', 'HIE14291', 'HIE14450', 'HIE95082', 'HIE95085', 'HIE95088', 'HIE95171', 'HIE95321', 'HIE95360', 'HIE95380', 'HIE95612', 'HIE95737', 'HIE95773', 'HIE95774', 'HIE95792', 'HIE95900', 'HIE95923', 'HIE95929', 'HIE95934', 'HIE95947', 'HIE95950', 'HIE95963', 'HIE95973', 'HIE95974', 'HIE95977', 'HIE96000', 'HIE96046', 'HIE96048', 'HIE96112', 'HIE96117', 'HIE96125', 'HIE96128', 'HIE96141', 'HIE96154', 'HIE96180', 'HIE96206', 'HIE96217', 'HIE96228', 'HIE96306', 'HIE96344', 'HIE96349', 'HIE96415', 'HIE96417', 'HIE96467', 'HIE96472', 'HIE96564', 'HIE96608', 'HIE96609', 'HIE96667', 'HIE96683', 'HIE96688', 'HIE96745', 'HIE96761', 'HIE96779', 'HIE96783', 'HIE96787', 'HIE96788', 'HIE96793', 'HIE96874', 'HIE96878', 'HIE96892', 'HIE96939', 'HIE96940', 'HIE96978', 'HIE96988', 'HIE97019', 'HIE97033', 'HIE97037', 'HIE97057', 'HIE97064', 'HIE97078', 'HIE97099', 'HIE97124', 'HIE97155', 'HIE97175', 'HIE97185', 'HIE97196', 'HIE97227', 'HIE95081', 'HIE96898', 'HIE96386', 'HIE14561', 'HIE96118', 'HIE14505', 'HIE13405', 'HIE14394', 'HIE96206', 'HIE96000', 'HIE95923', 'HIE96761', 'HIE95085', 'HIE97025', 'HIE97064', 'HIE13689', 'HIE96113', 'HIE95715', 'HIE96122', 'HIE13861', 'HIE97053', 'HIE96729', 'HIE95086', 'HIE96216', 'HIE97020') THEN 'Total SEE'
            WHEN supervisory_group IN ('Spain','Portugal','Italy') THEN 'Total WE'
            WHEN supervisory_group IN ('Product','Data','Engineering','Finance','Global Affairs','Marketing & Growth','Live Operations','Partner Operations','Logistics','P&B Brand Ads','P&B Commercial','Rest of Operations','People','Q Commerce','On Demand','Strategy & New Business','Executive') THEN 'Total HQ'
            WHEN supervisory_group IN ('DH Borrowed HC') THEN 'DH Borrowed HC'
            WHEN supervisory_group IN ('Placeholder Glovo Terminated Employees') THEN 'Placeholder Glovo Terminated Employees'
            ELSE 'Other'
        END AS regions,
        report_effective_date
    FROM supervisory_org_group
),
hq_intl AS (
    SELECT
        employee_id,
        supervisory_org_id,
        supervisory_group,
        regions,
        CASE
            WHEN supervisory_group IN ('Product','Data','Engineering','Finance','Global Affairs','Marketing & Growth','Live Operations','Partner Operations','Logistics','P&B Brand Ads','P&B Commercial','Rest of Operations','People','Q Commerce','On Demand','Strategy & New Business','Executive', 'International HQ') THEN 'Total HQ'
            WHEN regions IN ('Total Africa','Total PLECA','Total SEE','Total WE') THEN 'Total International'
            WHEN supervisory_group IN ('DH Borrowed HC') THEN 'DH Borrowed HC'
            WHEN supervisory_group IN ('Placeholder Glovo Terminated Employees') THEN 'Placeholder Glovo Terminated Employees'
            ELSE 'Other'
        END AS hq_intl_logic,
        report_effective_date
FROM regions
),
-- Cleaning the PR data, add the final result code, the review effective date, and rank
pr_ranking AS (
    SELECT
        employee_id,
        review_template,
        CASE
            WHEN final_9_box_position_in_manager_task IN ('Below Expectations/Role Model', 'Below Expectations/Lives', 'Below Expectations/Does not live', 'Solid Contributor/Does not live', 'Exceeds Expectations/Does not live') THEN 'Low'
            WHEN final_9_box_position_in_manager_task IN ('Solid Contributor/Lives') THEN 'Successful'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Lives', 'Solid Contributor/Role Model') THEN 'High'
            WHEN final_9_box_position_in_manager_task IN ('Exceeds Expectations/Role Model') THEN 'Top'
            ELSE 'No Review'
        END AS final_result,
        CASE
            WHEN review_template = 'Glovo - 2023 (H1) Performance Review and Leadership Skills' THEN '2023-08-31'
            WHEN review_template = 'Glovo - 2023 (H2) Performance Review and Leadership Skills' THEN '2024-02-29'
            WHEN review_template = 'Glovo - 2024 (H1) Performance Review and Leadership Skills' THEN '2024-08-31'
            WHEN review_template = 'Glovo - 2024 (H2) Performance Review' THEN '2025-02-28'
        ELSE NULL END report_effective_date,
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY review_template) AS ranking
    FROM people_ops_proposed.il_glovo_performance
    WHERE manager_id IS NOT NULL -- filter only 1 row in PR table
),
 -- Select only hired employees in the last 1 year
group_selection AS (
    SELECT
        DATE_TRUNC('month', CAST(wh.report_effective_date AS DATE)) AS month,
        wh.employee_id,
        wp.preferred_full_name AS worker,
        hi.supervisory_org_id,
        hi.supervisory_group,
        hi.regions,
        hi.hq_intl_logic,
        wh.original_first_day_of_work,
        wh.last_day_of_work,
        wh.is_terminated,
        wh.on_leave,
        wh.management_level,
        wh.job_family_group,
        wh.job_family,
        CASE
            WHEN wh.is_terminated = 0
            THEN ROUND(DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.report_effective_date AS DATE)) / 30.0, 1) -- Active : Date diff Hire date - Report effective date
            ELSE ROUND(DATE_DIFF('day', CAST(wh.original_first_day_of_work AS DATE), CAST(wh.last_day_of_work AS DATE)) / 30.0, 1) -- Terminated : Date diff Hire date  - termination date
        END AS tenure_by_month,
        pr.review_template AS first_review,
        pr.final_result AS first_pr_result,
        CASE WHEN final_result = 'Low' THEN 'Yes' ELSE 'No' END AS first_pr_low,
        CASE WHEN final_result IN ('Successful', 'Top', 'High') THEN 'Yes' ELSE 'No' END AS first_pr_not_low
    FROM people_ops_proposed.il_worker_hist_with_current AS wh
    LEFT JOIN pr_ranking AS pr ON pr.employee_id = wh.employee_id AND
                                pr.report_effective_date <<= wh.report_effective_date AND pr.ranking = 1 AND -- select only the PR happened before report effective date + select only the first PR
                                pr.report_effective_date >> wh.original_first_day_of_work -- make sure that the PR happened after hire date to account for rehires
    LEFT JOIN people_ops_proposed.il_worker_personal AS wp ON wh.employee_id = wp.employee_id
    LEFT JOIN hq_intl AS hi ON hi.employee_id = wh.employee_id AND wh.report_effective_date = hi.report_effective_date
    WHERE wh.report_effective_date >>= '2024-01-31'
    AND wh.contract_type IN ('Permanent', 'Fixed Term (Fixed Term)')
    AND (lower(wh.position) NOT LIKE '%picker%' OR lower(wh.position) LIKE '%agent%')
    AND CAST(wh.original_first_day_of_work  AS DATE) >>= DATE_ADD('year', -1, CAST(wh.report_effective_date AS DATE)) -- this subtracts 1 year from the report_effective_date, giving you the date 1 year before the effective date
    AND CAST(wh.original_first_day_of_work  AS DATE) <<= CAST(wh.report_effective_date AS DATE) -- no future hires are not included here
),
probation AS (
    SELECT
        gs.month,
        gs.employee_id,
        gs.worker,
        gs.supervisory_org_id,
        gs.supervisory_group,
        gs.regions,
        gs.hq_intl_logic,
        gs.original_first_day_of_work,
        gs.last_day_of_work,
        gs.is_terminated,
        gs.on_leave,
        gs.management_level,
        gs.job_family_group,
        gs.job_family,
        gs.tenure_by_month,
        gs.first_review,
        gs.first_pr_result,
        gs.first_pr_low,
        gs.first_pr_not_low,
        CASE
            WHEN gs.tenure_by_month >>= 6 THEN 'probation_passed'
            WHEN gs.tenure_by_month << 6 AND gs.is_terminated = 0 THEN 'probation_in_progress'
            WHEN gs.tenure_by_month << 6 AND gs.is_terminated = 1 THEN 'probation_not_passed'
        END AS probation_status
    FROM group_selection gs
),
termination AS (
    SELECT
        t.employee_id,
        date_trunc('month', date(t.termination_effective_date)) AS termination_effective_date,
        t.termination_category,
        t.termination_reason,
        t.local_termination_reason
    FROM people_ops_proposed.il_termination t
    WHERE t.status = 'Successfully Completed'
)
SELECT
    pc.month,
    pc.employee_id,
    pc.worker,
    pc.supervisory_org_id,
    pc.supervisory_group,
    pc.regions,
    pc.hq_intl_logic,
    pc.original_first_day_of_work,
    pc.is_terminated,
    pc.last_day_of_work,
    t.termination_category,
    t.termination_reason,
    t.local_termination_reason,
    pc.on_leave,
    pc.management_level,
    pc.job_family_group,
    pc.job_family,
    pc.tenure_by_month,
    pc.probation_status,
    pc.first_review,
    pc.first_pr_result,
    pc.first_pr_low,
    pc.first_pr_not_low,
    CASE WHEN (pc.is_terminated = 0 AND pc.tenure_by_month >>= 6 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) THEN 'Yes' ELSE 'No' END AS probation_passed_pending_1st_pr,
    CASE WHEN (pc.is_terminated = 0 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) OR
                (pc.is_terminated = 1 AND pc.tenure_by_month >>= 6 AND (pc.first_pr_result IS NULL OR pc.first_pr_result = 'No Review')) OR
                (pc.is_terminated = 0 AND pc.tenure_by_month << 6 AND pc.first_pr_result IN ('Successful','High','Top')) THEN 'No' ELSE 'Yes' END AS is_eligible,
    CASE WHEN pc.tenure_by_month >>= 6 AND pc.first_pr_result IN ('Successful', 'Top', 'High') THEN 'Yes' ELSE 'No' END AS is_quality_of_hire,
    CURRENT_DATE AS report_effective_date
FROM probation AS pc
LEFT JOIN termination AS t on pc.employee_id = t.employee_id AND pc.month = t.termination_effective_date
ORDER BY pc.month DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1r9ei301kk2lru1c98dcz0wm9oud' name='Custom SQL Query' type='text'><![CDATA[WITH supervisory_org_group AS (
    SELECT
        employee_id,
        supervisory_org_id,
        CASE
            WHEN supervisory_org_id IN ('HIE95009','HIE96041','HIE95049','HIE96648','HIE95965','HIE95048','HIE14293','HIE96858','HIE95048','HIE96081','HIE96041','HIE96850','HIE96856','HIE13532','HIE95590', 'HIE95051') THEN 'Product'
