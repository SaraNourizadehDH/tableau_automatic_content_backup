      <column caption='c.QoH (Categorization)' datatype='string' name='[c.test (copy)_1928948059303051268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [probation_status] = &apos;Probation_in_progress&apos; THEN &quot;Probation in Progress&quot;&#13;&#10;ELSEIF [probation_status] = &apos;Probation_Passed&apos; THEN &quot;Probation Passed&quot;&#13;&#10;ELSEIF [probation_status] = &apos;Probation_Passed&apos; AND [probation_passed_pending_1st_pr] = &apos;Yes&apos; THEN &quot;Probation Passed Pending 1st PR&quot;&#13;&#10;&#13;&#10;ELSEIF [first_pr_not_low] = &apos;Yes&apos; THEN &quot;First PR Not Low&quot;&#13;&#10;ELSEIF [first_pr_low] = &apos;Yes&apos; THEN &quot;First PR Low&quot;&#13;&#10;ELSEIF [is_quality_of_hire] = &apos;Yes&apos; THEN &quot;Quality Hire&quot;&#13;&#10;&#13;&#10;//ELSEIF [is_quality_of_hire] = &apos;No&apos; THEN &quot;Non-Quality Hire&quot;&#13;&#10;//ELSEIF [probation_status] = &apos;Probation_not_passed&apos; THEN &quot;Probation Not Passed&quot;&#13;&#10;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
