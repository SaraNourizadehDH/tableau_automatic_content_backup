    <worksheet name='HQ: Probation not Passed'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Probation not Passed</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>% Probation not Passed</run>
            <run fontsize='8'> = Count of Probation not Passed / Sum of Probation not Passed and Probation Passed</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Probation not Passed</run>
            <run fontsize='8'><![CDATA[ = Employees terminated <6 months after joining]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
          </datasources>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='% Probation not Passed' datatype='real' name='[Calculation_492088679299362817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END) /&#10;SUM(IF [probation_status] = &apos;probation_not_passed&apos; OR [probation_status] = &apos;probation_passed&apos; THEN 1 END)' />
            </column>
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column caption='Job Family Group' datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[job_family]' derivation='None' name='[none:job_family:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family_group]' derivation='None' name='[none:job_family_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_level]' derivation='None' name='[none:management_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[regions]' derivation='None' name='[none:regions:nk]' pivot='key' type='nominal' />
            <column-instance column='[supervisory_group]' derivation='None' name='[none:supervisory_group:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[probation_status]' role='dimension' type='nominal' />
            <column caption='Regions (Sup Org)' datatype='string' name='[regions]' role='dimension' type='nominal' />
            <column caption='Department/Country (Sup Org)' datatype='string' name='[supervisory_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_492088679299362817]' derivation='User' name='[usr:Calculation_492088679299362817:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[my:month:ok]' filter-group='4'>
            <groupfilter function='member' level='[my:month:ok]' member='202502' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
