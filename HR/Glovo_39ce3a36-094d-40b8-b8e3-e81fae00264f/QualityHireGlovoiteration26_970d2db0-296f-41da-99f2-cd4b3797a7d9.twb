    <worksheet name='INTL: Probation not Passed'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Probation not Passed</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>% Probation not Passed</run>
            <run fontsize='8'> = Count of Probation not Passed / Sum of Probation not Passed and Probation Passed</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Probation not Passed</run>
            <run fontsize='8'><![CDATA[ = Employees terminated <6 months after joining]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
          </datasources>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='% Probation not Passed' datatype='real' name='[Calculation_492088679299362817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END) /&#10;SUM(IF [probation_status] = &apos;probation_not_passed&apos; OR [probation_status] = &apos;probation_passed&apos; THEN 1 END)' />
            </column>
