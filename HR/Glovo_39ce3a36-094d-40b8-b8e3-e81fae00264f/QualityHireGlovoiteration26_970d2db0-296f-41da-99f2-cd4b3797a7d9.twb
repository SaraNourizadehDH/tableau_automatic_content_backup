    <worksheet name='HQ: Quality Hire Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Quality Hire Rate</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Quality Hire Rate</run>
            <run fontsize='8'> = Count of Quality Hires / Total Eligible Employees</run>
            <run>Æ&#10;</run>
            <run fontsize='8'>Excluding divisions with less than 5 eligible employees</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target (80%)' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.8'>
              <calculation class='tableau' formula='0.8' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Quality Hire Rate' datatype='real' name='[Calculation_4002363106436399106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_quality_of_hire] = &apos;Yes&apos; THEN 1 ELSE 0 END) / SUM(IF [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Division no IDs' datatype='string' name='[Calculation_492088679286157312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([business_unit_hierarchy (il_worker_hist_wit1)], LEN([business_unit_hierarchy (il_worker_hist_wit1)]) - 7)' />
            </column>
            <column caption='Sub-Division' datatype='string' name='[business_unit (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Division' datatype='string' name='[business_unit_hierarchy (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_eligible]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_quality_of_hire]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family (il_worker_hist_wit1)]' role='dimension' type='nominal' />
