  <worksheets>
    <worksheet name='Contribution to Non-Quality Hire'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>The </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Non-Quality Hire Rate</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> includes hires who either didn&apos;t pass probation or scored low in their first review. Some employees meet both conditions, so the contribution percentages exceed 100%.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Each condition&apos;s contribution is calculated by dividing the number of employees meeting that condition by the total number of non-quality hires.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
          </datasources>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='Non-Quality Hire' datatype='integer' name='[Calculation_5344787641582321675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Probation not Passed (% NQoH)' datatype='real' name='[Calculation_5344787641583173645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [probation_status] = &apos;probation_not_passed&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;SUM(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='First PR Low (% NQoH)' datatype='real' name='[Calculation_5344787641583333390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [first_pr_low] = &apos;Yes&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;SUM(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Sub-Division' datatype='string' name='[business_unit (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Division' datatype='string' name='[business_unit_hierarchy (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[first_pr_low]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_eligible]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_quality_of_hire]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Job Family Group' datatype='string' name='[job_family_group (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Management Level' datatype='string' name='[management_level (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column-instance column='[report_effective_date]' derivation='MY' name='[my:report_effective_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[business_unit (il_worker_hist_wit1)]' derivation='None' name='[none:business_unit (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[business_unit_hierarchy (il_worker_hist_wit1)]' derivation='None' name='[none:business_unit_hierarchy (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family (il_worker_hist_wit1)]' derivation='None' name='[none:job_family (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[job_family_group (il_worker_hist_wit1)]' derivation='None' name='[none:job_family_group (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[management_level (il_worker_hist_wit1)]' derivation='None' name='[none:management_level (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[office_location_country (il_worker_hist_wit1)]' derivation='None' name='[none:office_location_country (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[region (il_worker_hist_wit1)]' derivation='None' name='[none:region (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column caption='Office Location Country' datatype='string' name='[office_location_country (il_worker_hist_wit1)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[probation_status]' role='dimension' type='nominal' />
            <column caption='Region (Scope)' datatype='string' name='[region (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Report Effective Date' datatype='date' datatype-customized='true' name='[report_effective_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5344787641582321675]' derivation='User' name='[usr:Calculation_5344787641582321675:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5344787641583173645]' derivation='User' name='[usr:Calculation_5344787641583173645:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5344787641583333390]' derivation='User' name='[usr:Calculation_5344787641583333390:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0niweqr0bxvlxr1eaaiu20i3rqv5].[:Measure Names]'>
