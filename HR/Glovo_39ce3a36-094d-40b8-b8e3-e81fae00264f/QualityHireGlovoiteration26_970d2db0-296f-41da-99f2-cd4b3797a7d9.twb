    <worksheet name='Eligible Employees'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>Eligibility Criteria for Employees</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>Passed Probation and 1st PR Result</run>
            <run fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>: Employees active for &gt;= 6 months and completed their first performance review.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>Not Passed Probation/Low Performer</run>
            <run fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'><![CDATA[: Employees terminated <6 months or those who scored Low in their first performance review, regardless of probation status.]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
          </datasources>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Not Eligible' datatype='integer' name='[Calculation_1986087482740969474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;No&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Sub-Division' datatype='string' name='[business_unit (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Division' datatype='string' name='[business_unit_hierarchy (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_eligible]' role='dimension' type='nominal' />
            <column caption='Job Family' datatype='string' name='[job_family (il_worker_hist_wit1)]' role='dimension' type='nominal' />
            <column caption='Job Family Group' datatype='string' name='[job_family_group (il_worker_hist_wit1)]' role='dimension' type='nominal' />
