    <worksheet name='L6M Rolling Average Quality Hire Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Light' fontsize='8'>Quality Hire Rate</run>
            <run fontname='Tableau Light' fontsize='8'> = Count of Quality Hires / Total Eligible Employees</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target (80%)' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.8'>
              <calculation class='tableau' formula='0.8' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='L6M Rolling Avg Quality Hire' datatype='real' name='[Calculation_5344787641577525257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(&#10;       SUM(IF [is_quality_of_hire] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;       SUM(IF [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)&#10;   , -5, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
