            <column-instance column='[management_level (il_worker_hist_wit1)]' derivation='None' name='[none:management_level (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[office_location_country (il_worker_hist_wit1)]' derivation='None' name='[none:office_location_country (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
            <column-instance column='[region (il_worker_hist_wit1)]' derivation='None' name='[none:region (il_worker_hist_wit1):nk]' pivot='key' type='nominal' />
