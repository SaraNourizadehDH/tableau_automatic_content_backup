      <aliases enabled='yes' />
      <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Not Eligible' datatype='integer' name='[Calculation_1986087482740969474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;No&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Hires L12M' datatype='integer' name='[Calculation_4002363106425868288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id])' />
      </column>
      <column caption='Quality Hire Rate' datatype='real' name='[Calculation_4002363106436399106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_quality_of_hire] = &apos;Yes&apos; THEN 1 ELSE 0 END) / SUM(IF [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Division no IDs' datatype='string' name='[Calculation_492088679286157312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT([business_unit_hierarchy (il_worker_hist_wit1)], LEN([business_unit_hierarchy (il_worker_hist_wit1)]) - 7)' />
      </column>
      <column caption='% Probation not Passed' datatype='real' name='[Calculation_492088679299362817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END) /&#10;SUM(IF [probation_status] = &apos;probation_not_passed&apos; OR [probation_status] = &apos;probation_passed&apos; THEN 1 END)' />
      </column>
      <column caption='Eligible/Not Eligible' datatype='string' name='[Calculation_5222697872592117760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_eligible] = &apos;Yes&apos; THEN &quot;Eligible&quot;&#10;ELSEIF [is_eligible] = &apos;No&apos; THEN &quot;Not Eligible&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='First PR Low' datatype='integer' name='[Calculation_5222697872593915906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [first_pr_low] = &apos;Yes&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Probation Status' datatype='string' name='[Calculation_5344787639491665921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [probation_status] = &apos;probation_in_progress&apos; THEN &quot;Probation in Progress&quot;&#10;ELSEIF [probation_status] = &apos;probation_passed&apos; THEN &quot;Probation Passed&quot;&#10;ELSEIF [probation_status] = &apos;probation_not_passed&apos; THEN &quot;Probation Not Passed&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='First PR Status' datatype='string' name='[Calculation_5344787639513116675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_pr_not_low] = &quot;Yes&quot; THEN &quot;First PR Not Low&quot;&#10;ELSEIF [first_pr_low] = &quot;Yes&quot; THEN &quot;First PR Low&quot;&#10;ELSEIF [first_pr_result] = &quot;No Review&quot; THEN &quot;No Review&quot;&#10;ELSEIF NOT ISNULL([last_day_of_work]) AND ISNULL([first_pr_result]) THEN &quot;Terminated&quot;&#10;ELSE &quot;Pending&quot;&#10;END' />
      </column>
      <column caption='L6M Rolling Avg Quality Hire' datatype='real' name='[Calculation_5344787641577525257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(&#10;       SUM(IF [is_quality_of_hire] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;       SUM(IF [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)&#10;   , -5, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Non-Quality Hire' datatype='integer' name='[Calculation_5344787641582321675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Probation not Passed' datatype='integer' name='[Calculation_5344787641582694412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Probation not Passed (% NQoH)' datatype='real' name='[Calculation_5344787641583173645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [probation_status] = &apos;probation_not_passed&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;SUM(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='First PR Low (% NQoH)' datatype='real' name='[Calculation_5344787641583333390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [first_pr_low] = &apos;Yes&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END) /&#10;SUM(IF [is_quality_of_hire] = &apos;No&apos; AND [is_eligible] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Last Updated' datatype='date' name='[Calculation_6575325879213666304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='First PR Not Low' datatype='integer' name='[First PR Not Low (copy)_2859222857595310085]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(IF [first_pr_not_low] = &apos;Yes&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Probation Passed' datatype='integer' name='[Probation Passed (copy)_4002363106482733068]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT (IF [probation_status] = &apos;probation_passed&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Probation in Progress' datatype='integer' name='[Probation in Progress (copy)_2859222857594994692]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_in_progress&apos; THEN [employee_id] END)' />
      </column>
      <column caption='Quality Hire ' datatype='integer' name='[Quality Hire 1 (copy)_2859222857595465734]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(IF [is_quality_of_hire] = &apos;Yes&apos; THEN [employee_id] END)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Quality Hire' datatype='table' name='[__tableau_internal_object_id__].[_65F97DA85D20406A8CF8117C2989D567]' role='measure' type='quantitative' />
      <column caption='Business Title (Il Worker Hist Wit1)' datatype='string' name='[business_title (il_worker_hist_wit1)]' role='dimension' type='nominal' />
      <column caption='Sub-Division' datatype='string' name='[business_unit (il_worker_hist_wit1)]' role='dimension' type='nominal' />
      <column caption='Division' datatype='string' name='[business_unit_hierarchy (il_worker_hist_wit1)]' role='dimension' type='nominal' />
      <column caption='First PR Result' datatype='string' name='[c.PR Status (Categorization) (copy)_5344787639516708870]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_pr_result] = &apos;Top&apos; THEN &quot;Top&quot;&#10;ELSEIF [first_pr_result] = &apos;High&apos; THEN &quot;High&quot;&#10;ELSEIF [first_pr_result] = &apos;Successful&apos; THEN &quot;Successful&quot;&#10;ELSEIF [first_pr_result] = &apos;Low&apos; THEN &quot;Low&quot;&#10;ELSEIF [first_pr_result] = &apos;No Review&apos; THEN &quot;No Review&quot;&#10;ELSEIF [probation_passed_pending_1st_pr] = &apos;Yes&apos; THEN &quot;Pending&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Probation Passed Pending 1st PR' datatype='integer' name='[c.Probation Passed (copy)_2859222857594658819]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT (IF [probation_status] = &apos;probation_passed&apos; AND [probation_passed_pending_1st_pr] = &apos;Yes&apos;THEN [employee_id] END)' />
      </column>
      <column caption='Probation Not Passed' datatype='integer' name='[c.Probation Passed (copy)_5344787639464136704]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT (IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END)' />
      </column>
      <column caption='c.QoH (Categorization)' datatype='string' name='[c.test (copy)_1928948059303051268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [probation_status] = &apos;Probation_in_progress&apos; THEN &quot;Probation in Progress&quot;&#13;&#10;ELSEIF [probation_status] = &apos;Probation_Passed&apos; THEN &quot;Probation Passed&quot;&#13;&#10;ELSEIF [probation_status] = &apos;Probation_Passed&apos; AND [probation_passed_pending_1st_pr] = &apos;Yes&apos; THEN &quot;Probation Passed Pending 1st PR&quot;&#13;&#10;&#13;&#10;ELSEIF [first_pr_not_low] = &apos;Yes&apos; THEN &quot;First PR Not Low&quot;&#13;&#10;ELSEIF [first_pr_low] = &apos;Yes&apos; THEN &quot;First PR Low&quot;&#13;&#10;ELSEIF [is_quality_of_hire] = &apos;Yes&apos; THEN &quot;Quality Hire&quot;&#13;&#10;&#13;&#10;//ELSEIF [is_quality_of_hire] = &apos;No&apos; THEN &quot;Non-Quality Hire&quot;&#13;&#10;//ELSEIF [probation_status] = &apos;Probation_not_passed&apos; THEN &quot;Probation Not Passed&quot;&#13;&#10;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
