    <worksheet name='Funnel Bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>A </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Quality Hire</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> is someone hired in the last 12 months, active for at least 6 months, and scored Successful or above in their first performance review.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (people_ops_proposed)' name='federated.0niweqr0bxvlxr1eaaiu20i3rqv5' />
          </datasources>
          <datasource-dependencies datasource='federated.0niweqr0bxvlxr1eaaiu20i3rqv5'>
            <column caption='Eligible' datatype='integer' name='[Calculation_1986087482740817921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_eligible] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Hires L12M' datatype='integer' name='[Calculation_4002363106425868288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([employee_id])' />
            </column>
            <column caption='First PR Low' datatype='integer' name='[Calculation_5222697872593915906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [first_pr_low] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Probation not Passed' datatype='integer' name='[Calculation_5344787641582694412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_not_passed&apos; THEN [employee_id] END)' />
            </column>
            <column caption='First PR Not Low' datatype='integer' name='[First PR Not Low (copy)_2859222857595310085]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNT(IF [first_pr_not_low] = &apos;Yes&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Probation Passed' datatype='integer' name='[Probation Passed (copy)_4002363106482733068]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNT (IF [probation_status] = &apos;probation_passed&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Probation in Progress' datatype='integer' name='[Probation in Progress (copy)_2859222857594994692]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNT(IF [probation_status] = &apos;probation_in_progress&apos; THEN [employee_id] END)' />
            </column>
            <column caption='Quality Hire ' datatype='integer' name='[Quality Hire 1 (copy)_2859222857595465734]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNT(IF [is_quality_of_hire] = &apos;Yes&apos; THEN [employee_id] END)' />
