    <worksheet name='Job Profile List'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.02jehw91ixntdq16xj8b20ovfllx' />
          </datasources>
          <datasource-dependencies datasource='federated.02jehw91ixntdq16xj8b20ovfllx'>
            <column caption='Under-Assessment vs Good Quality' datatype='string' name='[Calculation_92886808167559169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [count_low_quality]&gt;0 THEN &apos;Under-Assesment&apos; ELSE &apos;Good Quality&apos; END' />
            </column>
            <column caption='MAX(DATETRUNC(&apos;month&apos;, [date_month]))' datatype='datetime' name='[Calculation_92886808180416514]' role='measure' type='ordinal' user:unnamed='Job Profile List'>
