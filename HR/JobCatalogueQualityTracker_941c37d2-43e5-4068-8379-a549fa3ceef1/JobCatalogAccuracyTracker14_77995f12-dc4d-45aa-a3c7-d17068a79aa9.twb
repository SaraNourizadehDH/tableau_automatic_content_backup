    <worksheet name='Short Instructions'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.02jehw91ixntdq16xj8b20ovfllx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Instructions' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Subject to review&quot;'>
              <calculation class='tableau' formula='&quot;Subject to review&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02jehw91ixntdq16xj8b20ovfllx'>
            <column caption='Instructions to Display' datatype='string' name='[Calculation_3527444471535747072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Validated&apos; THEN &apos;Employees with a Job Profile that the data model identified as a good match with their Business Title&apos;&#10;WHEN &apos;Subject to review&apos; THEN &apos;Employees with a Job Profile that the data model was not able to match with their Business Title&#10;&#10;Note: Achieving 100% data accuracy on employees&apos;&apos; Job Profiles is not the goal, as the data model is a quantitative analysis tool that compares employee&apos;&apos;s Business Title and Job Profile, hence won&apos;&apos;t be able to capture those cases where a more in-depth job matching needs to be carried out&apos;&#10;WHEN &apos;Tracking over time&apos; THEN &apos;The dashboard shows the % of validated Job Profiles over time. Changes are due to corrections in employees&apos;&apos; Job Profiles, updates of the data model or updates of the Job Catalogue&apos;&apos;s architecture.&apos;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Company' datatype='string' name='[company_name]' role='dimension' type='nominal' />
