      <aliases enabled='yes' />
      <column caption='% Validated' datatype='real' default-format='p0%' name='[# Good Quality (copy)_3537647935908036609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3537647935907856384])/SUM([actuals])' />
      </column>
      <column caption='% Subject to review' datatype='real' default-format='p0%' name='[% Good Quality (copy)_3537647935908851714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_low_quality])/SUM([actuals])' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1457758972010319872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Instructions to Display' datatype='string' name='[Calculation_3527444471535747072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Validated&apos; THEN &apos;Employees with a Job Profile that the data model identified as a good match with their Business Title&apos;&#10;WHEN &apos;Subject to review&apos; THEN &apos;Employees with a Job Profile that the data model was not able to match with their Business Title&#10;&#10;Note: Achieving 100% data accuracy on employees&apos;&apos; Job Profiles is not the goal, as the data model is a quantitative analysis tool that compares employee&apos;&apos;s Business Title and Job Profile, hence won&apos;&apos;t be able to capture those cases where a more in-depth job matching needs to be carried out&apos;&#10;WHEN &apos;Tracking over time&apos; THEN &apos;The dashboard shows the % of validated Job Profiles over time. Changes are due to corrections in employees&apos;&apos; Job Profiles, updates of the data model or updates of the Job Catalogue&apos;&apos;s architecture.&apos;&#10;END' />
      </column>
      <column caption='# Validated' datatype='integer' name='[Calculation_3537647935907856384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actuals] - [count_low_quality]' />
      </column>
      <column caption='Dimension to Display' datatype='string' name='[Calculation_3537647935911231492]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Brand&quot; THEN [brand]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Company&quot; THEN [company_name]&#10;WHEN &quot;Job Family&quot; THEN [job_family]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;WHEN &quot;Department&quot; THEN [department]&#10;WHEN &quot;Sub-Department&quot; THEN [sub_department]&#10;END' />
      </column>
      <column aggregation='Count' caption='Last Updated' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_3537647935914606597]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([last_updated])}' />
      </column>
      <column caption='Under-Assessment vs Good Quality' datatype='string' name='[Calculation_92886808167559169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [count_low_quality]&gt;0 THEN &apos;Under-Assesment&apos; ELSE &apos;Good Quality&apos; END' />
      </column>
      <column caption='Dimension to Display 2' datatype='string' name='[Dimension to Display (copy)_1457758972016287746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension to Display (copy)_1457758972016140289]&#10;WHEN &quot;Brand&quot; THEN [brand]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;END' />
      </column>
      <column aggregation='CountD' caption='Dimension to Display 3' datatype='string' name='[Dimension to Display (copy)_1457758972017205252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension to Display (copy)_1457758972016644099]&#10;WHEN &quot;Job Family&quot; THEN [job_family]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;END' />
      </column>
