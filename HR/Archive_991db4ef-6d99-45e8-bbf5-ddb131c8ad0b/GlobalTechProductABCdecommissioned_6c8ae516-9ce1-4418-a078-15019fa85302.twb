                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Purpose, Objectives &amp; Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
