              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;FTEs&apos; THEN ROUND(SUM([fte]),0)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Starters&apos; THEN INT(SUM([starters]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Leavers&apos; THEN INT(SUM([terminations_effective]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Net Addition&apos; THEN INT([Calculation_430797518703575040])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Attrition&apos; THEN 100*ROUND([Calculation_430797518727520268],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Product to Tech Ratio&apos; THEN 100*ROUND([Calculation_614319187151728644],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;M to IC Ratio&apos; THEN 100*ROUND([Calculation_430797518728151054],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Female Ratio&apos; THEN 100*ROUND([Calculation_430797518728347663],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;IC456 to IC123 Ratio&apos; THEN 100*ROUND(IFNULL([Calculation_2053500759875375104],0),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average eNPS&apos; THEN ROUND(AVG([avg_nps_score]),1)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Percentage of detractors&apos; THEN 100*ROUND(AVG([perc_demoters]),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Voluntary attrition&apos; THEN 100*ROUND([Calculation_2053500759892623363],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Hires&apos; THEN INT(SUM([hires]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Initiated Terminations&apos; THEN INT(SUM([initiated_terminations]))&#10;ELSE NULL END' />
