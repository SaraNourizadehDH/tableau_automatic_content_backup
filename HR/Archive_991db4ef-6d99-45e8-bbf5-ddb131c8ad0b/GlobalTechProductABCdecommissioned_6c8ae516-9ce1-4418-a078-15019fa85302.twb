            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Starters' datatype='integer' name='[starters]' role='measure' type='quantitative' />
            <column caption='sum_fte_inv' datatype='real' name='[sum_product_fte_inv (copy)_614319187152355333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Parameters].[metric (copy)_614319187149840385],[month]: SUM([fte])}' />
            </column>
            <column caption='Terminations Effective' datatype='real' name='[terminations_effective]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1302243981169258498]' derivation='User' name='[usr:Calculation_1302243981169258498:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1302243981511655440]' derivation='User' name='[usr:Calculation_1302243981511655440:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
