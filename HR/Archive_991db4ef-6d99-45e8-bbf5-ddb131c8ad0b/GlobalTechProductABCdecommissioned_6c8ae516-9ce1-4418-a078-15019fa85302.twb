            <column caption='Is Tech' datatype='integer' name='[is_tech]' role='measure' type='quantitative' />
            <column aggregation='Count' caption='Month' datatype='date' datatype-customized='true' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1302243981161607168]' derivation='None' name='[none:Calculation_1302243981161607168:nk]' pivot='key' type='nominal' />
            <column-instance column='[cost_center_name]' derivation='None' name='[none:cost_center_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
