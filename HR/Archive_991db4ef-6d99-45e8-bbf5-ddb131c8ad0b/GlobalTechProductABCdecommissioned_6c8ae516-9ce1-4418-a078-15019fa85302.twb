              <zone forceUpdate='true' h='3221' id='24' type-v2='text' w='92439' x='3773' y='93922'>
                <formatted-text>
                  <run bold='true' fontalignment='1'>Created By: Luigi Rossi</run>
                  <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='6422' id='29' is-scaled='1' param='Image/images.png' type-v2='bitmap' w='14203' x='571' y='571'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
