      <column caption='product_tech_ratio' datatype='real' name='[Calculation_3789427310732136453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_tech] = 0 THEN [actuals] ELSE NULL END)/sum(IF [is_tech] = 1 THEN [actuals] ELSE NULL END)' />
