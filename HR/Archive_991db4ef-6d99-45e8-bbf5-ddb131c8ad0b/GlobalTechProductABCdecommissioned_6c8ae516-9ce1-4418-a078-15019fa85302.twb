    <worksheet name='platform graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Open Sans' fontsize='11'>M to IC ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vertical' name='federated.0sz214n0gxd0xs0zrbj9q0vo1vxg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;FTEs&quot;'>
              <calculation class='tableau' formula='&quot;FTEs&quot;' />
              <aliases>
                <alias key='&quot;Attrition&quot;' value='Initiated Attrition (%)' />
                <alias key='&quot;Avg Interview Rating&quot;' value='Average Interview Rating' />
                <alias key='&quot;Female Ratio&quot;' value='% of Female FTEs' />
                <alias key='&quot;IC456 to IC123 Ratio&quot;' value='% of IC56 FTEs' />
                <alias key='&quot;M to IC Ratio&quot;' value='% of Managers FTEs' />
                <alias key='&quot;Percentage of detractors&quot;' value='% of Detractors' />
                <alias key='&quot;Product to Tech Ratio&quot;' value='% of Product FTEs' />
                <alias key='&quot;Voluntary attrition&quot;' value='Voluntary Initiated Attrition (%)' />
              </aliases>
            </column>
            <column caption='brand' datatype='string' name='[metric (copy)_614319187149840385]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivery Hero&quot;'>
              <calculation class='tableau' formula='&quot;Delivery Hero&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sz214n0gxd0xs0zrbj9q0vo1vxg'>
            <column caption='tech_or_prod' datatype='string' name='[Calculation_1302243981161607168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_tech] = 0 THEN &quot;Product&quot; ELSE &quot;Tech&quot; END' />
            </column>
            <column caption='metric_to_display' datatype='real' name='[Calculation_1302243981169258498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;FTEs&apos; THEN ROUND(SUM([fte]),0)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Starters&apos; THEN INT(SUM([starters]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Leavers&apos; THEN INT(SUM([terminations_effective]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Net Addition&apos; THEN INT([Calculation_430797518703575040])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Attrition&apos; THEN 100*ROUND([Calculation_430797518727520268],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Product to Tech Ratio&apos; THEN 100*ROUND([Calculation_614319187151728644],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;M to IC Ratio&apos; THEN 100*ROUND([Calculation_430797518728151054],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Female Ratio&apos; THEN 100*ROUND([Calculation_430797518728347663],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;IC456 to IC123 Ratio&apos; THEN 100*ROUND(IFNULL([Calculation_2053500759875375104],0),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average eNPS&apos; THEN ROUND(AVG([avg_nps_score]),1)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Percentage of detractors&apos; THEN 100*ROUND(AVG([perc_demoters]),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Voluntary attrition&apos; THEN 100*ROUND([Calculation_2053500759892623363],3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Hires&apos; THEN INT(SUM([hires]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Initiated Terminations&apos; THEN INT(SUM([initiated_terminations]))&#10;ELSE NULL END' />
            </column>
            <column caption='%metric' datatype='real' name='[Calculation_1302243981511655440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;HC&apos; THEN [Calculation_1302243981169258498] / TOTAL([Calculation_1302243981169258498])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Net Addition&apos; THEN [Calculation_1302243981169258498] / TOTAL([Calculation_1302243981169258498])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Starters&apos; THEN [Calculation_1302243981169258498] / TOTAL([Calculation_1302243981169258498])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Leavers&apos; THEN [Calculation_1302243981169258498] / TOTAL([Calculation_1302243981169258498])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Initiated Terminations&apos; THEN [Calculation_1302243981169258498]/TOTAL([Calculation_1302243981169258498])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Hires&apos; THEN [Calculation_1302243981169258498]/TOTAL([Calculation_1302243981169258498])&#10;ELSE NULL END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ic56_perc' datatype='real' name='[Calculation_2053500759875375104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_ic_56])/SUM([actuals])' />
            </column>
            <column caption='voluntary_attrition' datatype='real' name='[Calculation_2053500759892623363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([initiated_terminations_voluntary])/sum([actuals])' />
            </column>
            <column caption='Net Addition' datatype='real' name='[Calculation_430797518703575040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([starters]) - sum([terminations_effective])' />
            </column>
            <column caption='Attrition' datatype='real' name='[Calculation_430797518727520268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([initiated_terminations])/sum([actuals])' />
            </column>
            <column caption='manager_ic_ratio' datatype='real' name='[Calculation_430797518728151054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_m])/sum([fte])' />
            </column>
            <column caption='ratio female' datatype='real' name='[Calculation_430797518728347663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_female_fte])/sum([fte])' />
            </column>
            <column caption='sum_product_fte_inv' datatype='real' name='[Calculation_614319187150008322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Parameters].[metric (copy)_614319187149840385], [month]  : SUM(IF [is_tech] = 0 THEN [fte] ELSE NULL END)}' />
            </column>
            <column caption='prod_tech_inv' datatype='real' name='[Calculation_614319187151728644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_614319187150008322])/SUM([sum_product_fte_inv (copy)_614319187152355333])' />
            </column>
            <column caption='Actual Female Fte' datatype='real' name='[actual_female_fte]' role='measure' type='quantitative' />
            <column caption='Actual Ic 56' datatype='real' name='[actual_ic_56]' role='measure' type='quantitative' />
            <column caption='Actual M' datatype='real' name='[actual_m]' role='measure' type='quantitative' />
            <column caption='Actuals' datatype='real' name='[actuals]' role='measure' type='quantitative' />
            <column caption='Avg Nps Score' datatype='real' name='[avg_nps_score]' role='dimension' type='ordinal' />
            <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
            <column caption='Fte' datatype='real' name='[fte]' role='measure' type='quantitative' />
            <column caption='Hires' datatype='integer' name='[hires]' role='measure' type='quantitative' />
            <column caption='Initiated Terminations' datatype='real' name='[initiated_terminations]' role='measure' type='quantitative' />
