      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='131' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98400' id='130' param='vert' type-v2='layout-flow' w='98858' x='571' y='800'>
                <zone fixed-size='76' h='8800' id='29' is-fixed='true' is-scaled='1' param='Image/DH-ICON-white.jpg' type-v2='bitmap' w='5572' x='571' y='800'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8800' id='10' type-v2='text' w='84643' x='14786' y='800'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Purpose &amp; Objectives</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33400' id='14' type-v2='text' w='92430' x='3782' y='12800'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Purpose</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>This dashboard was created to investigate exit survey results further while taking characteristics of survey respondents into the account. Therefore, it aims to understand patterns among leavers  to help the audience derive some conclusions from exit survey results to increase retentions. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>This dashboard was created based on the request from People Partner team. All People Partner team, particular people from People Ops team and C-Level management have an access to this dashboard. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='43900' id='15' type-v2='text' w='92430' x='3782' y='46200'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Objectives</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>This dashboard aims to help the audience understand: </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='12'>1. Why people are leaving our company</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>2. What are the characteristics of exit survey participants</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>3. How likely people are attend to this survey when leaving</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>4. What these people think about their managers in terms of performance meetings, their supports and feedbacks</run>
                    <run>Æ&#10;</run>
                    <run fontsize='12'>5. What is the correlation between terminations reasons in Workday and reasons for leaving in exit survey</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6300' id='24' type-v2='text' w='92430' x='3782' y='90100'>
                  <formatted-text>
                    <run bold='true' fontalignment='1'>Created By: Esra Yener</run>
                    <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{CFEC3E0F-B25B-4A43-B3DE-6B6C4D3DB675}' />
    </dashboard>
