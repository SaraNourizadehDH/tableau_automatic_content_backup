      <aliases enabled='yes' />
      <column caption='Performance Meetings' datatype='integer' name='[Calculation_5547801473318256641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [answer]=&apos;Every two weeks or more&apos; then 5&#10;ELSEIF [answer]=&apos;Monthly&apos; then 4&#10;ELSEIF [answer]=&apos;Quarterly&apos; then 3&#10;ELSEIF [answer]=&apos;Once or twice a year&apos; then 2 &#10;ELSEIF [answer]=&apos;Never&apos; then 1&#10;END' />
      </column>
      <column caption='Support &amp; Feedback' datatype='integer' name='[Calculation_5547801473321091074]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [answer]=&apos;Fully Agree&apos; then 5&#10;ELSEIF [answer]=&apos;Agree&apos; then 4&#10;ELSEIF [answer]=&apos;Neutral&apos; then 3&#10;ELSEIF [answer]=&apos;Disagree&apos; then 2 &#10;ELSEIF [answer]=&apos;Fully Disagree&apos; then 1&#10;END' />
      </column>
      <column caption='Gender CF' datatype='string' name='[Calculation_5572360172443467776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([gender])==True then &apos;Unknown&apos; else [gender] end' />
      </column>
      <column caption='management_chain' datatype='string' name='[Calculation_5572360173048385537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(if [manager_01_full_name] != &apos;&apos; &#10;then [manager_01_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end) +&#10;(if [manager_02_full_name] != &apos;&apos; &#10;then [manager_02_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_03_full_name] != &apos;&apos; &#10;then [manager_03_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_04_full_name] != &apos;&apos; &#10;then [manager_04_full_name] + &apos;&gt;&gt; &apos; +&#10;(if [manager_05_full_name] != &apos;&apos; &#10;then [manager_05_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_06_full_name] != &apos;&apos; &#10;then [manager_06_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_07_full_name] != &apos;&apos; &#10;then [manager_07_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_08_full_name] != &apos;&apos; &#10;then [manager_08_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_09_full_name] != &apos;&apos; &#10;then [manager_09_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)+&#10;(if [manager_10_full_name] != &apos;&apos; &#10;then [manager_10_full_name] + &apos;&gt;&gt; &apos; &#10;else &apos;&apos; end)&#10;else &apos;&apos; end)' />
      </column>
      <column caption='Multiple Choice Answers without questions' datatype='string' name='[Calculation_962714837670387715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([answer], &apos;(&apos;, 1)' />
      </column>
