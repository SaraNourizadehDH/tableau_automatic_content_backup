            <column-instance column='[Calculation_2771684106879926280]' derivation='None' name='[none:Calculation_2771684106879926280:nk]' pivot='key' type='nominal' />
            <column-instance column='[Month]' derivation='None' name='[none:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[budget_area]' derivation='None' name='[none:budget_area:nk]' pivot='key' type='nominal' />
            <column-instance column='[contract_type]' derivation='None' name='[none:contract_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[cost_center_id]' derivation='None' name='[none:cost_center_id:nk]' pivot='key' type='nominal' />
