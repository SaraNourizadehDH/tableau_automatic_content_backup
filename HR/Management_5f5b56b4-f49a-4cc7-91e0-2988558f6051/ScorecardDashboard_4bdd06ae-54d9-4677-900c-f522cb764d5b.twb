      <column caption='Regrettable Color' datatype='string' name='[Attrition Color (copy)_644296238045810736]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MAX({FIXED [Calculation_2771684106875961350] &lt; [Month]:&#13;&#10;            MAX(IF [Calculation_2771684106875961350] &lt; [Month]  THEN 2&#13;&#10;                ELSE 1 END)&#13;&#10;        })&#13;&#10;WHEN 1 THEN &apos;Regrettable Rate&apos;&#13;&#10;WHEN 2 THEN &apos;Regrettable Rate (after)&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Attrition Rate (Foreigner)' datatype='real' default-format='p0.0%' name='[Attrition Rate (Local) (copy)_644296238022930449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_644296238021300239])/(sum([headcount]))' />
      </column>
      <column caption='Attrition Rate (Local)' datatype='real' default-format='p0.0%' name='[Attrition Rate (copy)_644296238022746128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_644296238021160974])/(sum([headcount]))' />
      </column>
      <column caption='Name1' datatype='string' name='[Calculation_1126462886227943435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([last_name]) then [first_name] else [first_name]+&quot; &quot;+[last_name] END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1126462886248984594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Termination Count' datatype='integer' name='[Calculation_1335598776058535940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF &#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &gt;= &#13;&#10;DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;&#13;&#10;and &#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &lt; &#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,TODAY()))&#13;&#10;and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10; then [employee_id] end )' />
      </column>
      <column caption='Future Termination Count' datatype='integer' name='[Calculation_1335598776059793413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF &#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &gt;= &#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,TODAY()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &lt; &#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,2,TODAY()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10;&#13;&#10; then [employee_id] end )' />
      </column>
      <column caption='Future Termination Count (Initiated_' datatype='integer' name='[Calculation_1335598776061227014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF &#13;&#10;ISNULL([termination_effective_date 1])&#13;&#10;&#13;&#10;and not ISNULL([termination_initiated_date])&#13;&#10;and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10;&#13;&#10; then [employee_id] end )&#13;&#10;&#13;&#10;+ &#13;&#10;&#13;&#10;COUNTD(if &#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &gt;= &#13;&#10;DATETRUNC(&apos;day&apos;,DATEADD(&apos;day&apos;,1,TODAY())) and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10; then [employee_id] end )' />
      </column>
      <column caption='Intern' datatype='string' name='[Calculation_1933170198268485632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [contract_type 1] =  &apos;Intern (Fixed Term) (Trainee)&apos; or [business_title 1] = &quot;Intern &quot;  THEN &quot;Intern&quot; ELSE &quot;Non-Intern&quot; END' />
      </column>
      <column caption='Market' datatype='string' name='[Calculation_1980739450808176644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_group]+&quot; - &quot;+[company_name]' />
        <aliases>
          <alias key='&quot;MYSSC - DH SSC Malaysia Sdn. Bhd.&quot;' value='Central Ops - DH SSC Malaysia Sdn. Bhd.' />
        </aliases>
      </column>
      <column caption='YTD Voluntary Rate %' datatype='real' name='[Calculation_1989746656753938433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([attrition (copy)_3508867089163247618])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Attrition Rate %' datatype='real' name='[Calculation_1989746656754176002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_3021633901299277824])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Chart' datatype='string' name='[Calculation_2096707115699388416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Past 24 Months' datatype='date' name='[Calculation_2096707115723304961]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Calculation_2771684106875961350])))' />
      </column>
      <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2096707115723395074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month] &gt;= [Calculation_2096707115723304961]' />
      </column>
      <column caption='Overall User Filter' datatype='boolean' name='[Calculation_2096707115829846019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[User Filter by Budget Area] or [User Filter HOP by Entity] or [User Filter by Segment]' />
      </column>
      <column caption='Placeholder 1' datatype='string' name='[Calculation_2096707116816371718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Cost Center/Department (copy)]&#13;&#10;when &quot;Cost Center&quot; then [cost_center_name]&#13;&#10;when &quot;Department&quot; then [department_wd]&#13;&#10;when &quot;Management Level&quot; then [management_level]&#13;&#10;when &quot;Type&quot; then [type]&#13;&#10;when &quot;Gender&quot; then [gender]&#13;&#10;END' />
      </column>
      <column caption='zero termination' datatype='integer' name='[Calculation_2705256013067644928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([termination])' />
      </column>
      <column caption='Tenure' datatype='real' name='[Calculation_2705256013076357127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[length_of_service]/365' />
      </column>
      <column caption='Tenure Category' datatype='string' name='[Calculation_2705256013076537352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2705256013076357127]&gt;=0 and [Calculation_2705256013076357127] &lt;=1 then &quot;0 to 12 months&quot;&#13;&#10;ELSEIF [Calculation_2705256013076357127] &gt;1 and [Calculation_2705256013076357127] &lt;=1.5 THEN &quot;12 to 18 months&quot;&#13;&#10;ELSEIF [Calculation_2705256013076357127] &gt;1.5 and [Calculation_2705256013076357127] &lt;=2 THEN &quot;18 to 24 months&quot;&#13;&#10;elseif [Calculation_2705256013076357127] &gt;2 and [Calculation_2705256013076357127] &lt;=2.5 THEN &quot;24 to 30 months&quot;&#13;&#10;elseif [Calculation_2705256013076357127] &gt;2.5 then &quot;&gt;30 months&quot;&#13;&#10;END' />
      </column>
      <column caption='Future Termination' datatype='real' name='[Calculation_2705256013078179849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1335598776059793413])/SUM([headcount])' />
      </column>
      <column caption='Last 60 Days' datatype='integer' name='[Calculation_2705256013215350794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF &#13;&#10;DATETRUNC(&apos;day&apos;, [termination_effective_date 1]) &gt;= &#13;&#10;DATETRUNC(&apos;day&apos;,DATEADD(&apos;day&apos;,-60,TODAY()))&#13;&#10;&#13;&#10;and &#13;&#10;&#13;&#10;DATETRUNC(&apos;day&apos;, [termination_effective_date 1]) &lt; &#13;&#10;DATETRUNC(&apos;day&apos;,DATEADD(&apos;day&apos;,1,TODAY()))&#13;&#10;and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10;&#13;&#10; then [employee_id] end )' />
      </column>
      <column caption='Termination YTD' datatype='integer' name='[Calculation_2705256013235499021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(If   [Calculation_2771684106875310083] &gt;=#01-01-23# and [Calculation_2771684106875310083]&lt;=[Calculation_2771684106875961350] then [termination] END)' />
      </column>
      <column caption='headcount 2023 beg' datatype='integer' name='[Calculation_2705256013236318222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(If [first_day_of_work 1]&lt;#01-01-23#&#13;&#10;              AND &#13;&#10;#01-01-23# &lt;= [Calculation_2771684106875310083]    &#13;&#10;&#13;&#10;Then [employee_id] END)' />
      </column>
      <column caption='Attrition 2023 YTD' datatype='real' name='[Calculation_2705256013236580367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2705256013235499021])/(([Calculation_2705256013236318222]+[Calculation_2771684106875535364])/2)' />
      </column>
      <column caption='number of months' datatype='integer' datatype-customized='true' name='[Calculation_2705256013277507600]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;,[Calculation_2771684106875961350])' />
      </column>
      <column caption='Termination 2022' datatype='integer' name='[Calculation_2705256013281263636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(If   [Calculation_2771684106875310083]&gt;=#1-1-22# and [Calculation_2771684106875310083]&lt;=#12-31-22#&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;([status]=&quot;Successfully Completed&quot;)&#13;&#10;&#13;&#10;Then [employee_id] END)' />
      </column>
      <column caption='2022 Attrition' datatype='real' name='[Calculation_2705256013281529877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2705256013281263636]/((SUM([beg_yearheadcount])+SUM([end_yearheadcount]))/2)' />
      </column>
      <column caption='Entity - Country Group' datatype='string' name='[Calculation_2771684106873151488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company_name]' />
      </column>
      <column caption='Next Month' datatype='datetime' name='[Calculation_2771684106875052033]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,1,[Month])' />
      </column>
      <column caption='Termination Date' datatype='date' name='[Calculation_2771684106875310083]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  ISNULL([termination_effective_date 1]) OR [termination_effective_date 1] &lt; [first_day_of_work 1] then DATE(#01-04-2030#)&#13;&#10;ELSE [termination_effective_date 1] END' />
      </column>
      <column caption='Running Sum (Headcount)' datatype='integer' name='[Calculation_2771684106875535364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(If [first_day_of_work 1]&lt;[Calculation_2771684106875052033] &#13;&#10;              AND &#13;&#10; [Calculation_2771684106875052033] &lt;= [Calculation_2771684106875310083]    &#13;&#10;&#13;&#10;Then [employee_id] END)' />
      </column>
      <column caption='upcoming month' datatype='boolean' name='[Calculation_2771684106875863045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Month] &lt;= DATEADD(&apos;month&apos;,3,[Calculation_2771684106875961350]) then true end' />
      </column>
      <column caption='today' datatype='date' name='[Calculation_2771684106875961350]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
      </column>
      <column caption='Foreign/Local' datatype='string' name='[Calculation_2771684106879926280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot;  ELSE &quot;Foreigner&quot; END' />
      </column>
      <column caption='# of Regrettable ' datatype='integer' name='[Calculation_2771684106885689356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_termination_regrettable]=&quot;1&quot; then [termination] END' />
      </column>
      <column caption='Regrettable Rate' datatype='real' name='[Calculation_2771684106885828621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2771684106885689356])/sum([headcount])' />
      </column>
      <column caption='Regrettable/Unregrettable' datatype='string' name='[Calculation_2771684107084771342]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if attr([is_termination_regrettable]) = &apos;1&apos; then &apos;Regrettable&apos;&#13;&#10;ELSE &apos;Unregrettable&apos; END' />
      </column>
      <column caption='column total' datatype='integer' name='[Calculation_2771684107086602255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(count([termination]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='1' datatype='integer' name='[Calculation_2771684107091386390]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Definition' datatype='string' name='[Calculation_2771684107103162401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Definition List&apos;' />
      </column>
      <column caption='beg_hc (annual)' datatype='integer' name='[Calculation_2902288512155299840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH([report_month]) =1 then [actuals] END' />
      </column>
      <column caption='Last' datatype='string' name='[Calculation_2902288512188243980]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF FIRST()=LAST()       THEN &quot;First/Last&quot;&#13;&#10;ELSEIF FIRST()=0        THEN &quot;First&quot;&#13;&#10;ELSEIF LAST()=0         THEN &quot;Last&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='current month &amp; year' datatype='boolean' name='[Calculation_2902288512193671188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='month([Month]) = MONTH(TODAY()) and YEAR([Month]) = year(TODAY())' />
      </column>
      <column caption='attrition' datatype='real' name='[Calculation_3021633901299277824 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([termination])/sum([headcount])' />
      </column>
      <column caption='Attrition' datatype='real' name='[Calculation_3021633901299277824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([termination])/sum([headcount])' />
      </column>
      <column caption='Voluntary Count' datatype='integer' name='[Calculation_3508867089162919936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [termination_category]=&quot;Voluntary&quot; then [termination] else 0 END' />
      </column>
      <column caption='Local Termination' datatype='integer' name='[Calculation_644296238021160974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2771684106879926280] = &quot;Local&quot; then [termination] END' />
      </column>
      <column caption='Foreign Termination' datatype='integer' name='[Calculation_644296238021300239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2771684106879926280] = &quot;Foreigner&quot; then [termination] END' />
      </column>
      <column caption='Male Termination' datatype='integer' name='[Calculation_644296238034841622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gender (group)] = &quot;Male&quot; then [termination] END' />
      </column>
      <column caption='Gender Color' datatype='string' name='[Calculation_644296238036140058]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MAX({FIXED  [gender (group)], [Calculation_2771684106875961350] &lt; [Month]:&#13;&#10;            MAX(IF [Calculation_2771684106875961350] &lt; [Month] AND [gender (group)] = &quot;Male&quot; THEN 1&#13;&#10;                ELSEIF [Calculation_2771684106875961350] &lt; [Month] AND [gender (group)] = &quot;Female&quot; THEN 2&#13;&#10;                ELSEIF [gender (group)] = &quot;Male&quot; THEN 3&#13;&#10;                ELSEIF  [gender (group)] = &quot;Female&quot; THEN 4 END)&#13;&#10;        })&#13;&#10;WHEN 1 THEN &apos;Male (after)&apos;&#13;&#10;WHEN 2 THEN &apos;Female (after)&apos;&#13;&#10;WHEN 3 THEN &apos;Male&apos;&#13;&#10;WHEN 4 THEN &apos;Female&apos;&#13;&#10;ELSE &apos;Black&apos;&#13;&#10;END' />
      </column>
      <column caption='Attrition Color' datatype='string' name='[Calculation_644296238044782639]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MAX({FIXED [Calculation_2771684106875961350] &lt; [Month]:&#13;&#10;            MAX(IF [Calculation_2771684106875961350] &lt; [Month]  THEN 2&#13;&#10;                ELSE 1 END)&#13;&#10;        })&#13;&#10;WHEN 1 THEN &apos;Attrition Rate&apos;&#13;&#10;WHEN 2 THEN &apos;Attrition Rate (after)&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Terminated Reason' datatype='string' name='[Calculation_644296238764032050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;[termination_reason] = &quot;Other&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[termination_reason] = &quot;Other Employment&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[termination_reason] = &quot;Hired by Competitor&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[termination_reason]&#13;&#10;END' />
      </column>
      <column caption='Primary Termination Reason  ' datatype='string' name='[Calculation_644296238768037943]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Hire Date Parameter]&#13;&#10;when &quot;Termination&quot; then [Calculation_644296238764032050]&#13;&#10;when &quot;Resignation&quot; then [Terminated Reason (copy)_644296238767345718]&#13;&#10;END' />
      </column>
      <column caption='entity' datatype='string' name='[Calculation_879609363587268608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_group 1] + &apos; - &apos; + [company_name 1]' />
      </column>
      <column caption='Date Filter (copy 2)' datatype='boolean' name='[Date Filter (copy 2)_1950340170914426881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Foreign/Local Parameter]&#13;&#10;&#13;&#10;= DATETRUNC(&apos;month&apos;,[Month 1])' />
      </column>
      <column caption='Other Termination' datatype='integer' name='[Female Termination (copy)_644296238035906585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gender (group)] = &quot;Others&quot; then [termination] END' />
      </column>
      <column caption='Current' datatype='boolean' name='[Last (copy)_2902288512191979538]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 60 Days (copy)' datatype='real' name='[Last 60 Days (copy)_2705256013216202764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2705256013215350794]/sum([headcount])' />
      </column>
      <column caption='Female Termination' datatype='integer' name='[Male Termination (copy)_644296238035722264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gender (group)] = &quot;Female&quot; then [termination] END' />
      </column>
      <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
      <column caption='Placeholder 2' datatype='string' name='[Placeholder 1 (copy)_2096707116816642055]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Placeholder 1 Selector (copy)_2096707116816187397]&#13;&#10;when &quot;Cost Center&quot; then [cost_center_name]&#13;&#10;when &quot;Department&quot; then [department_wd]&#13;&#10;when &quot;Management Level&quot; then [management_level]&#13;&#10;when &quot;Type&quot; then [type]&#13;&#10;when &quot;Gender&quot; then [gender]&#13;&#10;END' />
      </column>
      <column caption='Resignation Reason' datatype='string' name='[Terminated Reason (copy)_644296238767345718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;[resignation_reason] = &quot;Other&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[resignation_reason] = &quot;Other Employment&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[resignation_reason] = &quot;Hired by Competitor&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[resignation_reason]&#13;&#10;END' />
      </column>
      <column caption='Termination 2021' datatype='integer' name='[Termination 2022 (copy)_2705256013281976344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(If   [Calculation_2771684106875310083]&gt;=#1-1-21# and [Calculation_2771684106875310083]&lt;=#12-31-21#&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;([status]=&quot;Successfully Completed&quot;)&#13;&#10;&#13;&#10;Then [employee_id] END)' />
      </column>
      <column caption='F/L Color' datatype='string' name='[Termination Category Color  (copy)_644296238001709066]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MAX({FIXED  [Calculation_2771684106879926280], [Calculation_2771684106875961350] &lt; [Month]:&#13;&#10;            MAX(IF [Calculation_2771684106875961350] &lt; [Month] AND [Calculation_2771684106879926280] = &quot;Foreigner&quot; THEN 1&#13;&#10;                ELSEIF [Calculation_2771684106875961350] &lt; [Month] AND [Calculation_2771684106879926280] = &quot;Local&quot; THEN 2&#13;&#10;                ELSEIF [Calculation_2771684106879926280] = &quot;Foreigner&quot; THEN 3&#13;&#10;                ELSEIF  [Calculation_2771684106879926280] = &quot;Local&quot; THEN 4 END)&#13;&#10;        })&#13;&#10;WHEN 1 THEN &apos;Foreigner (after)&apos;&#13;&#10;WHEN 2 THEN &apos;Local (after)&apos;&#13;&#10;WHEN 3 THEN &apos;Foreigner&apos;&#13;&#10;WHEN 4 THEN &apos;Local&apos;&#13;&#10;ELSE &apos;Black&apos;&#13;&#10;END' />
      </column>
      <column caption='Termination Regrettable Color' datatype='string' name='[Termination Regrettable (copy)_644296237996814342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Month] &gt; [Calculation_2771684106875961350] and [is_termination_regrettable] = &quot;1&quot; then &quot;Regrettable (after)&quot;&#13;&#10;ELSEIF  [Month] &gt; [Calculation_2771684106875961350] and [is_termination_regrettable] = &quot;0&quot; then &quot;Unregrettable (after)&quot;&#13;&#10;ELSEIF   ([is_termination_regrettable]) = &quot;1&quot; then &quot;Regrettable&quot;&#13;&#10;ELSE  &quot;Unregrettable&quot;&#13;&#10;END' />
      </column>
      <column caption='Termination Category Color ' datatype='string' name='[Termination Regrettable Color (copy)_644296238000869385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Month] &gt; [Calculation_2771684106875961350] and [termination_category] = &quot;Voluntary&quot; then &quot;Voluntary (after)&quot;&#13;&#10;ELSEIF [Month] &gt; [Calculation_2771684106875961350] and [termination_category] = &quot;Involuntary&quot; then &quot;Involuntary (after)&quot;&#13;&#10;ELSEIF   ([termination_category]) = &quot;Voluntary&quot; then &quot;Voluntary&quot;&#13;&#10;ELSE  &quot;Involuntary&quot;&#13;&#10;END' />
      </column>
