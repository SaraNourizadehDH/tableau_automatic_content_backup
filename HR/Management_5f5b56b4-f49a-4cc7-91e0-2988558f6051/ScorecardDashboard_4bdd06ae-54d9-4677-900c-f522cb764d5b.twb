    <worksheet name='Future Termination (CC)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#b00f53' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='New' name='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cost Center/Department' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
              <calculation class='tableau' formula='&quot;Department&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)'>
            <column caption='Future Termination Count' datatype='integer' name='[Calculation_1335598776059793413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(IF &#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &gt;= &#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,TODAY()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [termination_effective_date 1]) &lt; &#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,2,TODAY()))&#13;&#10;&#13;&#10;and&#13;&#10;&#13;&#10;([status]&lt;&gt;&quot;Rescinded&quot; and [status]&lt;&gt;&quot;Canceled&quot;)&#13;&#10;&#13;&#10; then [employee_id] end )' />
            </column>
            <column caption='Market' datatype='string' name='[Calculation_1980739450808176644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group]+&quot; - &quot;+[company_name]' />
              <aliases>
                <alias key='&quot;MYSSC - DH SSC Malaysia Sdn. Bhd.&quot;' value='Central Ops - DH SSC Malaysia Sdn. Bhd.' />
              </aliases>
            </column>
            <column caption='Selected Chart' datatype='string' name='[Calculation_2096707115699388416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Past 24 Months' datatype='date' name='[Calculation_2096707115723304961]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Calculation_2771684106875961350])))' />
            </column>
            <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2096707115723395074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month] &gt;= [Calculation_2096707115723304961]' />
            </column>
            <column caption='Future Termination' datatype='real' name='[Calculation_2705256013078179849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1335598776059793413])/SUM([headcount])' />
            </column>
            <column caption='Entity - Country Group' datatype='string' name='[Calculation_2771684106873151488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company_name]' />
            </column>
            <column caption='upcoming month' datatype='boolean' name='[Calculation_2771684106875863045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Month] &lt;= DATEADD(&apos;month&apos;,3,[Calculation_2771684106875961350]) then true end' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_2771684106875961350]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_2771684106879926280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot;  ELSE &quot;Foreigner&quot; END' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[budget_area]' role='dimension' type='nominal' />
            <column caption='Entity' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Contract Type' datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[cost_center_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_group]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;MYSSC&quot;' value='Central Ops' />
              </aliases>
            </column>
            <column datatype='string' name='[department_wd]' role='dimension' type='nominal' />
            <column caption='Employee ID' datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column datatype='integer' name='[headcount]' role='measure' type='quantitative' />
            <column datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column caption='Job Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column datatype='string' name='[manager_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[marketplace]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1980739450808176644]' derivation='None' name='[none:Calculation_1980739450808176644:nk]' pivot='key' type='nominal' />
