            <column caption='Local Termination Reason' datatype='string' name='[local_termination_reason - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.1lnvw9r0arb2j717prvv71ddogcn].[local_termination_reason]'>
              <calculation class='tableau' formula='if  CONTAINS([local_termination_reason],&quot;-&quot;) then TRIM( SPLIT( [local_termination_reason], &quot;-&quot;, 2 ) )&#13;&#10;else [local_termination_reason] END' />
