    <worksheet name='Termination Trend by FL'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Attrition Rate by Foreign/Local - SG Based Entities</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='New' name='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)'>
            <column caption='Attrition Rate (Foreigner)' datatype='real' default-format='p0.0%' name='[Attrition Rate (Local) (copy)_644296238022930449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_644296238021300239])/(sum([headcount]))' />
            </column>
            <column caption='Attrition Rate (Local)' datatype='real' default-format='p0.0%' name='[Attrition Rate (copy)_644296238022746128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_644296238021160974])/(sum([headcount]))' />
            </column>
            <column caption='Market' datatype='string' name='[Calculation_1980739450808176644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group]+&quot; - &quot;+[company_name]' />
              <aliases>
                <alias key='&quot;MYSSC - DH SSC Malaysia Sdn. Bhd.&quot;' value='Central Ops - DH SSC Malaysia Sdn. Bhd.' />
              </aliases>
            </column>
            <column caption='Past 24 Months' datatype='date' name='[Calculation_2096707115723304961]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Calculation_2771684106875961350])))' />
            </column>
            <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2096707115723395074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month] &gt;= [Calculation_2096707115723304961]' />
            </column>
            <column caption='Entity - Country Group' datatype='string' name='[Calculation_2771684106873151488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company_name]' />
            </column>
            <column caption='upcoming month' datatype='boolean' name='[Calculation_2771684106875863045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Month] &lt;= DATEADD(&apos;month&apos;,3,[Calculation_2771684106875961350]) then true end' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_2771684106875961350]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_2771684106879926280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot;  ELSE &quot;Foreigner&quot; END' />
            </column>
            <column caption='column total' datatype='integer' name='[Calculation_2771684107086602255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(count([termination]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Local Termination' datatype='integer' name='[Calculation_644296238021160974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_2771684106879926280] = &quot;Local&quot; then [termination] END' />
            </column>
            <column caption='Foreign Termination' datatype='integer' name='[Calculation_644296238021300239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_2771684106879926280] = &quot;Foreigner&quot; then [termination] END' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='F/L Color' datatype='string' name='[Termination Category Color  (copy)_644296238001709066]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE MAX({FIXED  [Calculation_2771684106879926280], [Calculation_2771684106875961350] &lt; [Month]:&#13;&#10;            MAX(IF [Calculation_2771684106875961350] &lt; [Month] AND [Calculation_2771684106879926280] = &quot;Foreigner&quot; THEN 1&#13;&#10;                ELSEIF [Calculation_2771684106875961350] &lt; [Month] AND [Calculation_2771684106879926280] = &quot;Local&quot; THEN 2&#13;&#10;                ELSEIF [Calculation_2771684106879926280] = &quot;Foreigner&quot; THEN 3&#13;&#10;                ELSEIF  [Calculation_2771684106879926280] = &quot;Local&quot; THEN 4 END)&#13;&#10;        })&#13;&#10;WHEN 1 THEN &apos;Foreigner (after)&apos;&#13;&#10;WHEN 2 THEN &apos;Local (after)&apos;&#13;&#10;WHEN 3 THEN &apos;Foreigner&apos;&#13;&#10;WHEN 4 THEN &apos;Local&apos;&#13;&#10;ELSE &apos;Black&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[budget_area]' role='dimension' type='nominal' />
            <column caption='entity (group)' datatype='string' name='[company_name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[company_name]' new-bin='true'>
                <bin default-name='false' value='&quot;Bangladesh&quot;'>
