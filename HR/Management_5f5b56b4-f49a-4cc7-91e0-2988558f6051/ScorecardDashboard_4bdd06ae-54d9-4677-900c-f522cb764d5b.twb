              <calculation class='tableau' formula='if  CONTAINS([local_termination_reason],&quot;-&quot;) then TRIM( SPLIT( [local_termination_reason], &quot;-&quot;, 2 ) )&#13;&#10;else [local_termination_reason] END' />
