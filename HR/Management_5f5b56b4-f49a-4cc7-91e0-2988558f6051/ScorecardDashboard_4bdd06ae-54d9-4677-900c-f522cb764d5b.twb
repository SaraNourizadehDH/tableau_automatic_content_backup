      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#b00f53' fontname='Tableau Bold' fontsize='12'>&lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#b00f53' fontname='Tableau Bold' fontsize='12'>[Parameters].[Hire Date Parameter]</run>
            <run bold='true' fontalignment='1' fontcolor='#b00f53' fontname='Tableau Bold' fontsize='12'>&gt; - Employee Listing </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='New' name='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Placeholder 1 Selector' datatype='string' name='[Cost Center/Department (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Level&quot;'>
              <calculation class='tableau' formula='&quot;Management Level&quot;' />
            </column>
            <column alias='Termination' caption='Reason Parameter' datatype='string' name='[Hire Date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Termination&quot;'>
              <calculation class='tableau' formula='&quot;Termination&quot;' />
              <aliases>
                <alias key='&quot;Resignation&quot;' value='Resignation' />
                <alias key='&quot;Termination&quot;' value='Termination' />
              </aliases>
            </column>
            <column caption='Placeholder 2 Selector ' datatype='string' name='[Placeholder 1 Selector (copy)_2096707116816187397]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gender&quot;'>
              <calculation class='tableau' formula='&quot;Gender&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q5wvw816m7rqh1g1nm4m1orx7n6 (copy)'>
            <column caption='Market' datatype='string' name='[Calculation_1980739450808176644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group]+&quot; - &quot;+[company_name]' />
              <aliases>
                <alias key='&quot;MYSSC - DH SSC Malaysia Sdn. Bhd.&quot;' value='Central Ops - DH SSC Malaysia Sdn. Bhd.' />
              </aliases>
            </column>
            <column caption='Past 24 Months' datatype='date' name='[Calculation_2096707115723304961]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Calculation_2771684106875961350])))' />
            </column>
            <column caption='Rolling 24 Months' datatype='boolean' name='[Calculation_2096707115723395074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month] &gt;= [Calculation_2096707115723304961]' />
            </column>
            <column caption='Placeholder 1' datatype='string' name='[Calculation_2096707116816371718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Cost Center/Department (copy)]&#13;&#10;when &quot;Cost Center&quot; then [cost_center_name]&#13;&#10;when &quot;Department&quot; then [department_wd]&#13;&#10;when &quot;Management Level&quot; then [management_level]&#13;&#10;when &quot;Type&quot; then [type]&#13;&#10;when &quot;Gender&quot; then [gender]&#13;&#10;END' />
            </column>
            <column caption='Tenure' datatype='real' name='[Calculation_2705256013076357127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[length_of_service]/365' />
            </column>
            <column caption='Tenure Category' datatype='string' name='[Calculation_2705256013076537352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2705256013076357127]&gt;=0 and [Calculation_2705256013076357127] &lt;=1 then &quot;0 to 12 months&quot;&#13;&#10;ELSEIF [Calculation_2705256013076357127] &gt;1 and [Calculation_2705256013076357127] &lt;=1.5 THEN &quot;12 to 18 months&quot;&#13;&#10;ELSEIF [Calculation_2705256013076357127] &gt;1.5 and [Calculation_2705256013076357127] &lt;=2 THEN &quot;18 to 24 months&quot;&#13;&#10;elseif [Calculation_2705256013076357127] &gt;2 and [Calculation_2705256013076357127] &lt;=2.5 THEN &quot;24 to 30 months&quot;&#13;&#10;elseif [Calculation_2705256013076357127] &gt;2.5 then &quot;&gt;30 months&quot;&#13;&#10;END' />
            </column>
            <column caption='Entity - Country Group' datatype='string' name='[Calculation_2771684106873151488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_group] + &apos; - &apos; + [company_name]' />
            </column>
            <column caption='Termination Date' datatype='date' name='[Calculation_2771684106875310083]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  ISNULL([termination_effective_date 1]) OR [termination_effective_date 1] &lt; [first_day_of_work 1] then DATE(#01-04-2030#)&#13;&#10;ELSE [termination_effective_date 1] END' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_2771684106875961350]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(Datetrunc(&apos;month&apos;,Today()) )' />
            </column>
            <column caption='Foreign/Local' datatype='string' name='[Calculation_2771684106879926280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  STARTSWITH([nric], &quot;S&quot; ) OR  STARTSWITH([nric], &quot;T&quot; )  then   &quot;Local&quot;  ELSE &quot;Foreigner&quot; END' />
            </column>
            <column caption='Terminated Reason' datatype='string' name='[Calculation_644296238764032050]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;[termination_reason] = &quot;Other&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[termination_reason] = &quot;Other Employment&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[termination_reason] = &quot;Hired by Competitor&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([termination_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[termination_reason]&#13;&#10;END' />
            </column>
            <column caption='Primary Termination Reason  ' datatype='string' name='[Calculation_644296238768037943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Hire Date Parameter]&#13;&#10;when &quot;Termination&quot; then [Calculation_644296238764032050]&#13;&#10;when &quot;Resignation&quot; then [Terminated Reason (copy)_644296238767345718]&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Placeholder 2' datatype='string' name='[Placeholder 1 (copy)_2096707116816642055]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Placeholder 1 Selector (copy)_2096707116816187397]&#13;&#10;when &quot;Cost Center&quot; then [cost_center_name]&#13;&#10;when &quot;Department&quot; then [department_wd]&#13;&#10;when &quot;Management Level&quot; then [management_level]&#13;&#10;when &quot;Type&quot; then [type]&#13;&#10;when &quot;Gender&quot; then [gender]&#13;&#10;END' />
            </column>
            <column caption='Resignation Reason' datatype='string' name='[Terminated Reason (copy)_644296238767345718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;[resignation_reason] = &quot;Other&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[resignation_reason] = &quot;Other Employment&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[resignation_reason] = &quot;Hired by Competitor&quot; and NOT ISNULL([local_termination_reason - Split 2]) then ([resignation_reason] + &apos; - &apos; + [local_termination_reason - Split 2])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[resignation_reason]&#13;&#10;END' />
            </column>
