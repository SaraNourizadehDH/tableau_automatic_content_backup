            <run bold='true' fontalignment='1' fontname='Tableau Light' fontsize='10'> Job Profiles %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.02jehw91ixntdq16xj8b20ovfllx' />
          </datasources>
          <datasource-dependencies datasource='federated.02jehw91ixntdq16xj8b20ovfllx'>
            <column caption='% Good Quality' datatype='real' default-format='p0%' name='[# Good Quality (copy)_3537647935908036609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3537647935907856384])/SUM([actuals])' />
            </column>
            <column caption='# Good Quality' datatype='integer' name='[Calculation_3537647935907856384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actuals] - [count_low_quality]' />
            </column>
            <column caption='Actuals' datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Company' datatype='string' name='[company_name]' role='dimension' type='nominal' />
