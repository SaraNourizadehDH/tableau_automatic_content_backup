      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='950' minheight='950' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='143' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98666' id='142' param='vert' type-v2='layout-flow' w='98858' x='571' y='667'>
                <zone fixed-size='76' h='7331' id='29' is-fixed='true' is-scaled='1' param='Image/Untitled design (11).png' type-v2='bitmap' w='5571' x='571' y='667'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
