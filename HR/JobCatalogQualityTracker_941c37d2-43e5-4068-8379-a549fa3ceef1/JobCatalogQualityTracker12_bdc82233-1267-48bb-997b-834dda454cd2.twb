                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='2500' id='90' type-v2='text' w='8786' x='68500' y='63583'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Link to Training</run>
