      <aliases enabled='yes' />
      <column caption='% Good Quality' datatype='real' default-format='p0%' name='[# Good Quality (copy)_3537647935908036609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3537647935907856384])/SUM([actuals])' />
      </column>
      <column caption='% Under-Assessmet' datatype='real' default-format='p0%' name='[% Good Quality (copy)_3537647935908851714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_low_quality])/SUM([actuals])' />
      </column>
      <column caption='Instructions to Display' datatype='string' name='[Calculation_3527444471535747072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Data Model&apos; THEN &apos;Our data model for spotting low quality data relies on three key methods: String Matching finds good cases by matching common words between the Job Profile and Business Title. The Data Science Model uses NLP to spot semantic similarities, even without common words. Word Mapping leverages expert input and past data to recognize and refine common accurate or inaccurate pairings.&apos;&#10;WHEN &apos;Good Quality&apos; THEN &apos;These profiles have a clear and direct match between the employee job profile and business title, or they share similarities in meaning, confirmed by past data and expert reviews.&apos;&#10;WHEN &apos;Under-Assessment&apos; THEN &apos;These profiles show little or no direct match or meaningful connection between the employee job profile and business title, highlighted by inconsistencies based on past data and expert insights.&apos;&#10;END' />
      </column>
      <column caption='# Good Quality' datatype='integer' name='[Calculation_3537647935907856384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actuals] - [count_low_quality]' />
      </column>
      <column caption='Dimension to Display' datatype='string' name='[Calculation_3537647935911231492]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Brand&quot; THEN [brand]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Company&quot; THEN [company_name]&#10;WHEN &quot;Job Family&quot; THEN [job_family]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;WHEN &quot;Department&quot; THEN [department]&#10;WHEN &quot;Sub-Department&quot; THEN [sub_department]&#10;END' />
      </column>
      <column caption='Last Updated' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_3537647935914606597]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([last_updated])}' />
      </column>
      <column caption='Under-Assessment vs Good Quality' datatype='string' name='[Calculation_92886808167559169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [count_low_quality]&gt;0 THEN &apos;Under-Assesment&apos; ELSE &apos;Good Quality&apos; END' />
      </column>
