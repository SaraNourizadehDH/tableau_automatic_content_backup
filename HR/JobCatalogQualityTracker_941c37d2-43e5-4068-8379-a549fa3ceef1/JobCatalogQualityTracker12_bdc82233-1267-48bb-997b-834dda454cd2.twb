    <worksheet name='Short Instructions'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (people_ops_proposed)' name='federated.02jehw91ixntdq16xj8b20ovfllx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Instructions' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Data Model&quot;'>
              <calculation class='tableau' formula='&quot;Data Model&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02jehw91ixntdq16xj8b20ovfllx'>
            <column caption='Instructions to Display' datatype='string' name='[Calculation_3527444471535747072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Data Model&apos; THEN &apos;Our data model for spotting low quality data relies on three key methods: String Matching finds good cases by matching common words between the Job Profile and Business Title. The Data Science Model uses NLP to spot semantic similarities, even without common words. Word Mapping leverages expert input and past data to recognize and refine common accurate or inaccurate pairings.&apos;&#10;WHEN &apos;Good Quality&apos; THEN &apos;These profiles have a clear and direct match between the employee job profile and business title, or they share similarities in meaning, confirmed by past data and expert reviews.&apos;&#10;WHEN &apos;Under-Assessment&apos; THEN &apos;These profiles show little or no direct match or meaningful connection between the employee job profile and business title, highlighted by inconsistencies based on past data and expert insights.&apos;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Company' datatype='string' name='[company_name]' role='dimension' type='nominal' />
