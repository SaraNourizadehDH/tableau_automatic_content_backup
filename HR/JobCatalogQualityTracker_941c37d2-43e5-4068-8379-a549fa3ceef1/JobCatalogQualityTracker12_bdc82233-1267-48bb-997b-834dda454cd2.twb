            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3527444471535747072]' derivation='None' name='[none:Calculation_3527444471535747072:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
