      <aliases enabled='yes' />
      <column caption='Measure Names' datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1wuktgm1row1mu1gi43h81yzdh6u].[cnt:employee_id:qk]&quot;' value='# of movements in start dates' />
          <alias key='&quot;[federated.1wuktgm1row1mu1gi43h81yzdh6u].[ctd:employee_id:qk]&quot;' value='# of unique employees whose start date has changed' />
        </aliases>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_2318368687505162244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(MIN([proposed_start_date]),&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Departments' datatype='string' name='[Calculation_5693112933075357699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([department])=True then &apos;No Department&apos; else [department]end' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_6572088904347074565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Movement Direction' datatype='string' name='[Calculation_6572088905324744710]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [contract_signed_date_employee] &gt; [proposed_start_date] then &apos;Earlier&apos; else &apos;Later&apos; end' />
      </column>
      <column caption='# of proposed start date per employee' datatype='integer' name='[Calculation_6572088906428825608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[employee_id],[bp_completed_date]:COUNTD([proposed_start_date])}' />
      </column>
      <column caption='Previous Proposed Start Date' datatype='string' name='[Calculation_6572088906444726283]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([proposed_start_date]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Comments containing &apos;visa&apos;' datatype='real' name='[Calculation_6572088907009753106]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF (CONTAINS([comments], &apos;visa&apos;)=True or CONTAINS([comments], &apos;Visa&apos;)=True) then 1 else 0 end)/COUNTD([comments])' />
      </column>
      <column caption='Measure Values' datatype='real' name='[Multiple Values]' role='measure' type='quantitative' />
