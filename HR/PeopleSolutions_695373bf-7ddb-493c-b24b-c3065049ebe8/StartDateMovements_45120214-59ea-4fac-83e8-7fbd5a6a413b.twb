          <zone forceUpdate='true' h='4612' id='10' type-v2='text' w='98858' x='571' y='444'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='margin-top' value='6' />
              <format attr='margin-bottom' value='6' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone h='3611' id='13' type-v2='empty' w='92430' x='3782' y='5056'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='60777' id='14' type-v2='text' w='92430' x='3782' y='8667'>
            <formatted-text>
              <run bold='true' fontsize='12'>Fields</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Hire Date</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>First day of an employee at work</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Proposed Hire Date</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>New hire date proposed</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Country of Origin</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Country where a candidate has entered to the system when applying for a position. In case it is not entered, it is defined based on country code of phone number of the candidate</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='12'>Calculated Fields</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Start Date Corrections</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of total corrections made in start date</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Starters</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of hired employees starting on the given period</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Movement Rate (%)</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>([Starters] \ [Start Date Corrections])*100</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='27290' id='24' type-v2='text' w='92430' x='3782' y='69444'>
            <formatted-text>
              <run bold='true' fontalignment='1'>Owned By: Marcelo Rodriguez</run>
              <run fontalignment='1'>
Please direct all inquiries to the People Analytics JIRA </run>
