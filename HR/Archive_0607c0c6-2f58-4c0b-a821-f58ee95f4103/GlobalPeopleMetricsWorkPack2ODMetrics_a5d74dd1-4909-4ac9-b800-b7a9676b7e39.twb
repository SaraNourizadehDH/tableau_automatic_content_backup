          <datasource-dependencies datasource='federated.1h8dbdy0qswctd16qb1z013r80hj'>
            <column caption='c.Manager (no direct reports)' datatype='integer' name='[Calculation_2277414058822111245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF MID([management_level],1,1)=&quot;M&quot; THEN [Calculation_632755768801882112] END)' />
            </column>
            <column caption='c.w/o directs' datatype='integer' name='[Calculation_632755768801882112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [direct_reports] = 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='c.People Manager (Y/N)' datatype='string' name='[Calculation_632755768812146691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [direct_reports] &gt; 0 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Y&quot;&#13;&#10;ELSE&#13;&#10;    &quot;N&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;N&quot;' value='Employee' />
                <alias key='&quot;Y&quot;' value='People Manager' />
              </aliases>
            </column>
            <column caption='c.SPOC (CYTD)' datatype='real' name='[Calculation_632755768813137924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Calculation_632755768823078919] = TRUE THEN &#13;&#10;        IF [Calculation_632755768812146691] = &quot;Y&quot; THEN &#13;&#10;            [direct_reports] &#13;&#10;        END&#13;&#10;    END&#13;&#10;)&#13;&#10;&#13;&#10;//Average direct reports of People Managers' />
            </column>
            <column caption='c.Filter (CYTD)' datatype='boolean' name='[Calculation_632755768823078919]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) &lt;= [Parameters].[Parameter 8]' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
