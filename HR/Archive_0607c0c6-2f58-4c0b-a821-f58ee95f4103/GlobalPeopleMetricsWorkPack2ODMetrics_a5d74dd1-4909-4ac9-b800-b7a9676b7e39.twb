      <column caption='c.Dimensions' datatype='string' name='[Calculation_2277414058107559939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Management level groups&apos; THEN [g.management_track]&#13;&#10;    WHEN &apos;Department&apos; THEN [department]&#13;&#10;    WHEN &apos;Org Layers&apos; THEN [organisation_layer]&#13;&#10;END' />
