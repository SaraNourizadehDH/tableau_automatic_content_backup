            </column>
            <column caption='c.People Manager (=1 subordinate)' datatype='integer' name='[Calculation_632755768813514757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_632755768812146691] = &quot;Y&quot; AND [direct_reports] = 1 THEN&#13;&#10;    1&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
