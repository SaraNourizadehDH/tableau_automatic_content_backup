              <calculation class='tableau' formula='if [c.Distinct Layers (% yoy) (copy)_2277414060951908435]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [c.Distinct Layers (% yoy) (copy)_2277414060951908435]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [c.Distinct Layers (% yoy) (copy)_2277414060951908435]&gt;0 then &quot;Red&quot; END' />
            </column>
            <column caption='c.Date (Month = last month)' datatype='integer' name='[c.Date (Year = latest year) (copy)_2277414060907479106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY()) - 1' />
            </column>
            <column caption='c.Date (Year = latest year)' datatype='integer' name='[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY())' />
            </column>
            <column caption='c.Layers (change ytd)' datatype='integer' default-format='n0.00;-0.00' name='[c.Distinct Layers (% yoy) (copy)_2277414060951908435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( [c.Distinct Layers (Selected Year | Month) (copy)_2277414060920459339] - [c.Distinct Layers (PMY) (copy)_2277414060952203349] )' />
            </column>
            <column caption='c.Layers (Jan CY)' datatype='integer' default-format='n0;-0' name='[c.Distinct Layers (PMY) (copy)_2277414060952203349]' role='measure' type='quantitative'>
