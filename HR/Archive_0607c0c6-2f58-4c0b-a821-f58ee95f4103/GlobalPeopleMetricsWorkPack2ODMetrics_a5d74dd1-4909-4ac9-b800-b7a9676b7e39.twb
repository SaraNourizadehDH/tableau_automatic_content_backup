          <datasource-dependencies datasource='federated.1h8dbdy0qswctd16qb1z013r80hj'>
            <column caption='c.Filter (CMY)' datatype='boolean' name='[Calculation_2277414060914479174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) = [Parameters].[Parameter 8]' />
            </column>
            <column caption='c.People Manager (Y/N)' datatype='string' name='[Calculation_632755768812146691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [direct_reports] &gt; 0 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Y&quot;&#13;&#10;ELSE&#13;&#10;    &quot;N&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;N&quot;' value='Employee' />
                <alias key='&quot;Y&quot;' value='People Manager' />
              </aliases>
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='c.Color - SPOC KPI (% yoy)' datatype='string' name='[c.Color - Layers KPI (% yoy) (copy)_2277414060965535833]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [c.Distinct Layers (change yoy) (copy)_2277414060963033175]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [c.Distinct Layers (change yoy) (copy)_2277414060963033175]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [c.Distinct Layers (change yoy) (copy)_2277414060963033175]&gt;0 then &quot;Red&quot; END' />
            </column>
            <column caption='c.Date (Month = last month)' datatype='integer' name='[c.Date (Year = latest year) (copy)_2277414060907479106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY()) - 1' />
            </column>
            <column caption='c.Date (Year = latest year)' datatype='integer' name='[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY())' />
            </column>
            <column caption='c.SPOC (change yoy)' datatype='real' default-format='n0.00;-0.00' name='[c.Distinct Layers (change yoy) (copy)_2277414060963033175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( [c.SPOC (CY) (copy)_2277414060914921543] - [c.Layers (PMY) (copy)_2277414060964946008] )' />
            </column>
            <column caption='c.Filter (PMY)' datatype='boolean' name='[c.Filter (Selected Year | Month) (copy)_2277414060920336458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7] - 1&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) = [Parameters].[Parameter 8]' />
            </column>
            <column caption='c.SPOC (PMY)' datatype='real' default-format='n0;-0' name='[c.Layers (PMY) (copy)_2277414060964946008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(AVG(&#13;&#10;    IF [c.Filter (Selected Year | Month) (copy)_2277414060920336458] = TRUE THEN &#13;&#10;        IF [Calculation_632755768812146691] = &quot;Y&quot; THEN &#13;&#10;            [direct_reports] &#13;&#10;        END&#13;&#10;    END&#13;&#10;))&#13;&#10;&#13;&#10;//Average direct reports of People Managers' />
            </column>
            <column caption='c.SPOC (CMY)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.SPOC (CY) (copy)_2277414060914921543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(AVG(&#13;&#10;    IF [Calculation_2277414060914479174] = TRUE THEN &#13;&#10;        IF [Calculation_632755768812146691] = &quot;Y&quot; THEN &#13;&#10;            [direct_reports] &#13;&#10;        END&#13;&#10;    END&#13;&#10;))&#13;&#10;&#13;&#10;//Average direct reports of People Managers' />
            </column>
