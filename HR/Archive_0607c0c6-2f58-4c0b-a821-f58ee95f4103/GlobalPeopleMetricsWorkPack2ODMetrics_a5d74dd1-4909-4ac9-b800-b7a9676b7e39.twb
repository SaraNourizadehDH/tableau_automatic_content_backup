    <worksheet name='2) Span of Control (KPI - YTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Org Design' name='federated.1h8dbdy0qswctd16qb1z013r80hj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h8dbdy0qswctd16qb1z013r80hj].[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' caption='p.Date (Year)' datatype='integer' default-format='n0;-0' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h8dbdy0qswctd16qb1z013r80hj].[c.Date (Year = latest year) (copy)_2277414060907479106]' alias='January' caption='p.Date (Month)' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='January' />
                <alias key='2' value='February' />
                <alias key='3' value='March' />
                <alias key='4' value='April' />
                <alias key='5' value='May' />
                <alias key='6' value='June' />
                <alias key='7' value='July' />
                <alias key='8' value='August' />
                <alias key='9' value='September' />
                <alias key='10' value='October' />
                <alias key='11' value='November' />
                <alias key='12' value='December' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h8dbdy0qswctd16qb1z013r80hj'>
            <column caption='c.Filter (CMY)' datatype='boolean' name='[Calculation_2277414060914479174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) = [Parameters].[Parameter 8]' />
            </column>
            <column caption='c.People Manager (Y/N)' datatype='string' name='[Calculation_632755768812146691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [direct_reports] &gt; 0 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Y&quot;&#13;&#10;ELSE&#13;&#10;    &quot;N&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;N&quot;' value='Employee' />
                <alias key='&quot;Y&quot;' value='People Manager' />
              </aliases>
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='c.Color - SPOC KPI (% ytd)' datatype='string' name='[c.Color - SPOC KPI (% mom) (copy)_2277414060969373792]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [c.Layers (change ytd) (copy)_2277414060969226335]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [c.Layers (change ytd) (copy)_2277414060969226335]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [c.Layers (change ytd) (copy)_2277414060969226335]&gt;0 then &quot;Red&quot; END' />
            </column>
            <column caption='c.Date (Month = last month)' datatype='integer' name='[c.Date (Year = latest year) (copy)_2277414060907479106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY()) - 1' />
            </column>
            <column caption='c.Date (Year = latest year)' datatype='integer' name='[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY())' />
            </column>
            <column caption='c.Filter (Jan CY)' datatype='boolean' name='[c.Filter (PM) (copy)_2277414060952051796]' role='dimension' type='nominal'>
