          <datasource-dependencies datasource='federated.1h8dbdy0qswctd16qb1z013r80hj'>
            <column caption='c.People Manager Ratio (CYTD)' datatype='real' name='[Calculation_2277414058438209545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_632755768823078919] = TRUE AND [Calculation_632755768812146691] = &quot;Y&quot; THEN&#13;&#10;        [employee_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [Calculation_632755768823078919] = TRUE THEN [employee_id] END)' />
            </column>
            <column caption='COUNTD(IF [c.Filter (CYTD)] = TRUE THEN [employee_id] END)' datatype='integer' name='[Calculation_2277414061255782509]' role='measure' type='quantitative' user:unnamed='3) People Manager (Trend - Overall) (3)'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_632755768823078919] = TRUE THEN [employee_id] END)' />
            </column>
            <column caption='IF [c.Filter (CYTD)] = TRUE AND [c.People Manager (Y/N)] = &quot;Y...' datatype='string' name='[Calculation_2277414061255819374]' role='dimension' type='nominal' user:unnamed='3) People Manager (Trend - Overall) (3)'>
              <calculation class='tableau' formula='IF [Calculation_632755768823078919] = TRUE AND [Calculation_632755768812146691] = &quot;Y&quot; THEN&#13;&#10;        [employee_id]&#13;&#10;    END' />
            </column>
            <column caption='c.People Manager (Y/N)' datatype='string' name='[Calculation_632755768812146691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [direct_reports] &gt; 0 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Y&quot;&#13;&#10;ELSE&#13;&#10;    &quot;N&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;N&quot;' value='Employee' />
                <alias key='&quot;Y&quot;' value='People Manager' />
              </aliases>
            </column>
            <column caption='c.Filter (CYTD)' datatype='boolean' name='[Calculation_632755768823078919]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) &lt;= [Parameters].[Parameter 8]' />
            </column>
            <column caption='c.Date (Month = last month)' datatype='integer' name='[c.Date (Year = latest year) (copy)_2277414060907479106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY()) - 1' />
            </column>
            <column caption='c.Date (Year = latest year)' datatype='integer' name='[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY())' />
            </column>
            <column caption='c.Filter (PYTD)' datatype='boolean' name='[c.Filter Current Year (copy)_632755768823382024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7] - 1&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) &lt;= [Parameters].[Parameter 8]' />
            </column>
            <column caption='c.People Manager Ratio (PYTD)' datatype='real' name='[c.People Ratio (Current Year) (copy)_2277414058439135242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [c.Filter Current Year (copy)_632755768823382024] = TRUE AND [Calculation_632755768812146691] = &quot;Y&quot; THEN&#13;&#10;        [employee_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [c.Filter Current Year (copy)_632755768823382024] = TRUE THEN [employee_id] END)' />
