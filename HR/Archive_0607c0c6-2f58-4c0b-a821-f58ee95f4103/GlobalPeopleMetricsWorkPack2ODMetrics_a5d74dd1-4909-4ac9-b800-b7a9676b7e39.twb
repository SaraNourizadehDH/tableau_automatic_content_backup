              </aliases>
            </column>
            <column caption='c.Date (Month = last month)' datatype='integer' name='[c.Date (Year = latest year) (copy)_2277414060907479106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY()) - 1' />
            </column>
            <column caption='c.Date (Year = latest year)' datatype='integer' name='[c.Date (Year &gt;= 2023) (copy)_2277414060906651712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR(TODAY())' />
            </column>
            <column caption='c.Layers (change yoy)' datatype='integer' default-format='n0.00;-0.00' name='[c.Distinct Layers (Selected Year | Month - 1) (copy)_2277414060921028684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( [c.Distinct Layers (Selected Year | Month) (copy)_2277414060920459339] - [c.SPOC (Selected Year | Month) (copy)_2277414060916686920] )' />
            </column>
            <column caption='c.Layers (CMY)' datatype='integer' default-format='n0;-0' name='[c.Distinct Layers (Selected Year | Month) (copy)_2277414060920459339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2277414060914479174] = TRUE THEN &#13;&#10;        [organisation_layer]&#13;&#10;    END&#13;&#10;)' />
