        <calculation class='tableau' formula='IF [direct_reports] = 1 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;w 1 subordinate&quot;&#13;&#10;ELSEIF [direct_reports] &gt; 0 AND&#13;&#10;    (&#13;&#10;        MID([management_level],1,1)=&quot;M&quot; OR&#13;&#10;        MID([management_level],1,1)=&quot;E&quot; OR&#13;&#10;        MID([management_level],1,2)=&quot;IC&quot;&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Y&quot;&#13;&#10;ELSE&#13;&#10;    &quot;N&quot;&#13;&#10;END' />
