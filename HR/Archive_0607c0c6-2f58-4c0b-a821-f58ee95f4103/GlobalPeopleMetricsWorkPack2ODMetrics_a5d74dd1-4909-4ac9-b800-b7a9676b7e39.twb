      <column caption='c.People Manager Ratio (CYTD)' datatype='real' name='[Calculation_2277414058438209545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_632755768823078919] = TRUE AND [Calculation_632755768812146691] = &quot;Y&quot; THEN&#13;&#10;        [employee_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [Calculation_632755768823078919] = TRUE THEN [employee_id] END)' />
      </column>
      <column caption='c.Manager (no direct reports)' datatype='integer' name='[Calculation_2277414058822111245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF MID([management_level],1,1)=&quot;M&quot; THEN [Calculation_632755768801882112] END)' />
      </column>
      <column caption='c.Filter - Brand Parameter' datatype='integer' name='[Calculation_2277414058949636116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand]=[Parameters].[Parameter 2] OR [brand]=[Parameters].[p.Brand 1 (copy)_2277414058949308434] OR [brand]=[Parameters].[p.Brand 1 (copy) (copy)_2277414058949316627] THEN &#13;&#10;    1 &#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='c.Select Role (People Manager Type)' datatype='integer' name='[Calculation_2277414059583455268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &apos;People Manager&apos; THEN [c.People Manager (HC) (copy)_2277414061002416230]&#13;&#10;    WHEN &apos;Not People Manager&apos; THEN [c.People Manager (HC) (copy)_2277414059549769757]&#13;&#10;    WHEN &apos;People Manager w 1&apos; THEN [c.People Manager (HC) (copy)_2277414059617538087]&#13;&#10;    WHEN &apos;All&apos; THEN [Calculation_632755768811950082]&#13;&#10;END' />
      </column>
      <column caption='c.Date (Year &gt;= 2023)' datatype='integer' name='[Calculation_2277414060905828415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [date_month]) &gt;= 2023 THEN DATEPART(&apos;year&apos;, [date_month]) END' />
      </column>
      <column caption='c.Filter (CMY)' datatype='boolean' name='[Calculation_2277414060914479174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 7]&#13;&#10;AND&#13;&#10;DATEPART(&apos;month&apos;, [date_month]) = [Parameters].[Parameter 8]' />
      </column>
      <column caption='c.Color - Layers KPI (% yoy)' datatype='string' name='[Calculation_2277414060923039821]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [c.Distinct Layers (Selected Year | Month - 1) (copy)_2277414060921028684]&lt;0 then &quot;Green&quot; &#13;&#10;ELSEIF [c.Distinct Layers (Selected Year | Month - 1) (copy)_2277414060921028684]=0 then &quot;Grey&quot;&#13;&#10;ELSEIF [c.Distinct Layers (Selected Year | Month - 1) (copy)_2277414060921028684]&gt;0 then &quot;Red&quot; END' />
      </column>
      <column caption='c.Brand 1' datatype='boolean' name='[Calculation_2277414060986208353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand] = [Parameters].[Parameter 2]' />
