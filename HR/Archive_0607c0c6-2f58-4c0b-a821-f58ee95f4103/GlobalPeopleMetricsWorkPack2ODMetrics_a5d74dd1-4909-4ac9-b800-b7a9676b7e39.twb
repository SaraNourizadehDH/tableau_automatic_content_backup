      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4F605DA24D354764B55CB03F79F97906'>
            <properties context=''>
              <relation connection='athena.046m1os1s2l3vy18g1gv30hofdu6' name='Custom SQL Query' type='text'><![CDATA[-- Org Design
WITH direct_reports AS (
        SELECT
                mh.report_effective_date,
                mh.managed_by AS employee_id,
                COUNT(DISTINCT mh.employee_id) AS direct_reports
        FROM
                people_ops_proposed.il_manager_hist mh
                LEFT JOIN people_ops_proposed.il_worker_hist wh ON mh.employee_id = wh.employee_id
                AND mh.report_effective_date = wh.report_effective_date
        WHERE
                wh.is_terminated = 0
                AND wh.on_leave = 0
                AND mh.managed_by IS NOT NULL
                AND wh.worker_type = 'Employee'
                AND wh.company_id NOT IN ('3103', '3206') --EXCLUDE india AND woowa
                AND wh.management_level NOT LIKE 'S%'
                AND wh.management_level NOT LIKE 'P%'
        GROUP BY
                1,
                2
),
employees_without_reports AS (
        SELECT
                DISTINCT wh1.report_effective_date,
                wh1.employee_id
        FROM
                people_ops_proposed.il_worker_hist wh1
                LEFT JOIN people_ops_proposed.il_manager_hist mh ON wh1.employee_id = mh.managed_by
                AND wh1.report_effective_date = mh.report_effective_date
                LEFT JOIN people_ops_proposed.il_worker_hist wh2 ON mh.employee_id = wh2.employee_id
                AND mh.report_effective_date = wh2.report_effective_date
        WHERE
                (
                        (mh.managed_by IS NULL)
                        OR (
                                mh.managed_by IS NOT NULL
                                AND wh2.is_terminated = 1
                        )
                        OR (
                                mh.managed_by IS NOT NULL
                                AND wh2.on_leave = 1
                        )
                )
                AND wh1.is_terminated = 0
                AND wh1.on_leave = 0
                AND wh1.worker_type = 'Employee'
                AND wh1.company_id NOT IN ('3103', '3206') --EXCLUDE india AND woowa
                AND wh1.management_level NOT LIKE 'S%'
                AND wh1.management_level NOT LIKE 'P%'
),
layers_prep AS (
        SELECT
                mh.report_effective_date,
                mh.employee_id,
                CASE
                        WHEN mh.manager_id_10 IS NOT NULL THEN 'Layer 9'
                        WHEN mh.manager_id_09 IS NOT NULL THEN 'Layer 8'
                        WHEN mh.manager_id_08 IS NOT NULL THEN 'Layer 7'
                        WHEN mh.manager_id_07 IS NOT NULL THEN 'Layer 6'
                        WHEN mh.manager_id_06 IS NOT NULL THEN 'Layer 5'
                        WHEN mh.manager_id_05 IS NOT NULL THEN 'Layer 4'
                        WHEN mh.manager_id_04 IS NOT NULL THEN 'Layer 3'
                        WHEN mh.manager_id_03 IS NOT NULL THEN 'Layer 2'
                        WHEN mh.manager_id_02 IS NOT NULL THEN 'Layer 1'
                        WHEN mh.manager_id_01 IS NOT NULL THEN 'Layer 0'
                END AS organisation_layer
        FROM
                people_ops_proposed.il_manager_hist mh
                LEFT JOIN people_ops_proposed.il_worker_hist wh ON mh.employee_id = wh.employee_id
                AND mh.report_effective_date = wh.report_effective_date
        WHERE
                wh.is_terminated = 0 --AND wh.on_leave = 0
                AND wh.worker_type = 'Employee'
),
metrics_prep AS (
        SELECT
                report_effective_date,
                employee_id,
                COALESCE(direct_reports, 0) AS direct_reports
        FROM
                direct_reports FULL
                OUTER JOIN employees_without_reports USING(report_effective_date, employee_id)
)
SELECT
        DATE_TRUNC('month', DATE(mp.report_effective_date)) AS date_month,
        mp.employee_id,
        wp.preferred_full_name AS name,
        CASE
                WHEN cm.brand = 'EFood' THEN CASE
                        WHEN UPPER(wh.business_title) IN (
                                'ACCOUNTING SUPPORT AGENT',
                                'ASSISTANT CLARK DRIVER',
                                'ASSISTANT DRIVER',
                                'BUILDING SUPPORT AGENT',
                                'CLARK DRIVER',
                                'CLARK OPERATOR',
                                'CLARK OPERATOR''S ASSISTANT',
                                'CLEANING CREW',
                                'COURIERS SHIPMENTS ADMINISTRATOR',
                                'DRIVER',
                                'DRIVER''S ASSISTANT',
                                'EQUIPMENT ADMINISTRATOR',
                                'EX VAN DRIVER',
                                'FITNESS TRAINER',
                                'PICKER',
                                'REPLENISHMENT AGENT',
                                'SECURITY AGENT',
                                'VAN DRIVER',
                                'WAREHOUSE ASSISTANT',
                                'WAREHOUSE EMPLOYEE',
                                'SUPPORT AGENT'
                        ) THEN 'Operational Workers'
                        WHEN UPPER(wh.business_title) = 'BARISTA'
                        AND cm.company_id IN ('2504', '2502', '2507') THEN 'Operational Workers'
                        ELSE 'Office Employees'
                END
                ELSE wh.business_title
        END AS business_title,
        wh.management_level,
        wh.job_family,
        wh.job_family_group,
        wh.office_location,
        wh.company_id,
        CASE
                WHEN cm.brand = 'Foodpanda' THEN cm.country_group
                ELSE cm.country
        END AS country,
        CASE
                WHEN cha.department = 'EU Regional' THEN 'Foodora' --foodora regional team hired in DHSE
                WHEN cm.brand <<>> 'Delivery Hero'
                AND mh.manager_id_02 IN ('2021-10-0813', '2020-08-0169', '2018-10-0002') THEN 'Delivery Hero' --entity hires UNDER ANA, BEN, JOHANNES
                WHEN cm.brand <<>> 'Delivery Hero'
                AND mh.manager_id_03 IN ('2020-08-0207') THEN 'Delivery Hero' --entity hires UNDER Thomas Boully Finance Systems
                WHEN cm.brand = 'PedidosYa'
                AND substr(wh.cost_center_id, length(wh.cost_center_id), 1) = '4' THEN 'Delivery Hero'
                WHEN wh.company_id = '8706'
                AND mh.manager_id_02 IN (
                        '2023-08-0190',
                        '2020-08-0169',
                        '2021-10-0813',
                        '2018-10-0002'
                ) THEN 'Delivery Hero'
                WHEN wh.company_id = '8706' THEN 'Foodora'
                ELSE cm.brand
        END AS brand,
        CASE
                WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit_hierarchy, 8)
                WHEN cha.department IS NULL THEN wh.department_wd
                ELSE cha.department
        END as department,
        CASE
                WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit, 8)
                WHEN LOWER(
                        REGEXP_REPLACE(
                                COALESCE(cha.sub_department, wh.sub_department_wd),
                                '\\s+',
                                ' '
                        )
                ) LIKE '%ops%store%operations%' THEN 'Ops Store Operations'
                ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
        END as sub_department,
        CASE
                WHEN cm.brand = 'PedidosYa' THEN CASE
                        WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - PERMANENT' THEN 'Pickers'
                        WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - FIXED TERM (FIXED TERM)' THEN 'Pickers (Fixed Term)'
                        ELSE wh.contract_type
                END
                ELSE wh.contract_type
        END AS contract_type,
        CASE
                WHEN cm.brand = 'Glovo' THEN CASE
                        WHEN UPPER(wh.region) LIKE '%HQ%' THEN 'Regional'
                        WHEN wh.region IS NULL THEN wh.region
                        ELSE 'Local'
                END
                WHEN cm.brand = 'Foodora' THEN CASE
                        WHEN UPPER(wh.region) = 'FOODORA REGION'
                        or UPPER(wh.region) = 'EU REGION' THEN 'Regional'
                        WHEN wh.region IS NULL THEN wh.region
                        ELSE 'Local'
                END
                WHEN cm.brand = 'PedidosYa' THEN CASE
                        SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
                        WHEN '1' then 'Local'
                        WHEN '2' then 'Regional'
                        WHEN '4' then 'Central'
                        WHEN '5' then 'SSC'
                        ELSE 'Null'
                end
                ELSE 'Null'
        END as scope,
        concat_ws(
                ' ',
                mh.manager_id_01,
                mh.manager_id_02,
                mh.manager_id_03,
                mh.manager_id_04,
                mh.manager_id_05,
                mh.manager_id_06,
                mh.manager_id_07,
                mh.manager_id_08,
                mh.manager_id_09,
                mh.manager_id_10
        ) as manager_id_concat,
        wh.time_type,
        wh.worker_type,
        cm.region,
        cm.company_name,
        wh.cost_center_id,
        chw.cost_center_name,
        mh.manager_id_01,
        mh.manager_01_full_name,
        mh.manager_id_02,
        mh.manager_02_full_name,
        mh.manager_id_03,
        mh.manager_03_full_name,
        mh.manager_id_04,
        mh.manager_04_full_name,
        mh.manager_id_05,
        mh.manager_05_full_name,
        mh.manager_id_06,
        mh.manager_06_full_name,
        mh.manager_id_07,
        mh.manager_07_full_name,
        lp.organisation_layer,
        mp.direct_reports,
        wp.gender,
        sh.tenure_category
FROM
        metrics_prep mp
        LEFT JOIN layers_prep lp 
            ON mp.employee_id = lp.employee_id
            AND mp.report_effective_date = lp.report_effective_date
        LEFT JOIN people_ops_proposed.il_worker_personal wp 
            ON mp.employee_id = wp.employee_id
        LEFT JOIN people_ops_proposed.il_worker_hist wh 
            ON mp.employee_id = wh.employee_id
            AND mp.report_effective_date = wh.report_effective_date
        LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha 
            ON wh.cost_center_id = cha.cost_center_id
        LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw 
            ON wh.cost_center_id = chw.cost_center_id
        LEFT JOIN people_ops_proposed.il_manager_hist mh 
            ON mp.employee_id = mh.employee_id
            AND mp.report_effective_date = mh.report_effective_date
        LEFT JOIN people_ops_proposed.il_company_mapping cm 
            ON wh.company_id = cm.company_id
        LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh
                    ON mp.employee_id = sh.employee_id 
                    AND mp.report_effective_date = sh.report_effective_date
WHERE
        mp.report_effective_date >>= '2023-01-31']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
