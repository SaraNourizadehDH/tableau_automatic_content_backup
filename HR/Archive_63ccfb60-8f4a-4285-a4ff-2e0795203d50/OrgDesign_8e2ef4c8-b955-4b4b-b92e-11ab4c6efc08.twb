        <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='right_size' type='text'>WITH indirect_reports AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;m.company_id,&#13;&#10;&#9;&#9;m1.managed_by,&#13;&#10;&#9;&#9;COUNT(DISTINCT m.employee_id) AS indirect_reports&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_manager m&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_worker_org wo ON m.employee_id = wo.employee_id&#13;&#10;&#9;&#9;CROSS JOIN UNNEST(&#13;&#10;&#9;&#9;&#9;ARRAY [manager_id_01, manager_id_02, manager_id_03, manager_id_04, manager_id_05, manager_id_06, manager_id_07, manager_id_08, manager_id_09, manager_id_10]&#13;&#10;&#9;&#9;) AS m1(managed_by)&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;wo.is_terminated = 0&#13;&#10;&#9;&#9;AND m.managed_by IS NOT NULL&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;direct_reports AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;m.company_id,&#13;&#10;&#9;&#9;m.managed_by,&#13;&#10;&#9;&#9;COUNT(*) AS direct_reports&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_manager m&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_worker_org wo ON m.employee_id = wo.employee_id&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;wo.is_terminated = 0&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;direct_open_positions AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;jr.company_id,&#13;&#10;&#9;&#9;jr.position_managed_by AS managed_by,&#13;&#10;&#9;&#9;SUM(CAST(job_openings_total AS INT)) AS direct_open_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_job_requisition jr&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;jr.status = &apos;Open&apos;&#13;&#10;&#9;&#9;AND jr.is_confidential_job = &apos;0&apos;&#13;&#10;&#9;&#9;AND jr.is_evergreen = &apos;0&apos;&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;direct_hired_positions AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;jr.company_id,&#13;&#10;&#9;&#9;jr.position_managed_by AS managed_by,&#13;&#10;&#9;&#9;COUNT(*) AS direct_hired_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_offer o&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_job_requisition jr ON o.job_requisition_id = jr.job_requisition_id&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;o.candidate_offer_accepted_date IS NOT NULL&#13;&#10;&#9;&#9;AND o.disposition_reason IS NULL&#13;&#10;&#9;&#9;AND CAST(o.proposed_hire_date AS DATE) &gt;&gt; current_date&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;indirect_open_positions_prep AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;jr.company_id,&#13;&#10;&#9;&#9;m1.managed_by,&#13;&#10;&#9;&#9;jr.job_requisition_id,&#13;&#10;&#9;&#9;MIN(CAST(job_openings_total AS INT)) AS indirect_open_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_job_requisition jr&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_manager m ON m.employee_id = jr.position_managed_by&#13;&#10;&#9;&#9;CROSS JOIN UNNEST(&#13;&#10;&#9;&#9;&#9;ARRAY [employee_id, manager_id_01, manager_id_02, manager_id_03, manager_id_04, manager_id_05, manager_id_06, manager_id_07, manager_id_08, manager_id_09, manager_id_10]&#13;&#10;&#9;&#9;) AS m1(managed_by)&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;jr.status = &apos;Open&apos;&#13;&#10;&#9;&#9;AND jr.is_confidential_job = &apos;0&apos;&#13;&#10;&#9;&#9;AND jr.is_evergreen = &apos;0&apos;&#13;&#10;&#9;&#9;AND m1.managed_by IS NOT NULL&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2,&#13;&#10;&#9;&#9;3&#13;&#10;),&#13;&#10;indirect_open_positions AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;company_id,&#13;&#10;&#9;&#9;managed_by,&#13;&#10;&#9;&#9;SUM(indirect_open_positions) AS indirect_open_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;indirect_open_positions_prep&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;indirect_hired_positions AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;o.company_id,&#13;&#10;&#9;&#9;m1.managed_by,&#13;&#10;&#9;&#9;COUNT(*) AS indirect_hired_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;people_ops_proposed.il_offer o&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_job_requisition jr ON o.job_requisition_id = jr.job_requisition_id&#13;&#10;&#9;&#9;LEFT JOIN people_ops_proposed.il_manager m ON m.employee_id = jr.position_managed_by&#13;&#10;&#9;&#9;CROSS JOIN UNNEST(&#13;&#10;&#9;&#9;&#9;ARRAY [m.employee_id, manager_id_01, manager_id_02, manager_id_03, manager_id_04, manager_id_05, manager_id_06, manager_id_07, manager_id_08, manager_id_09, manager_id_10]&#13;&#10;&#9;&#9;) AS m1(managed_by)&#13;&#10;&#9;WHERE&#13;&#10;&#9;&#9;o.candidate_offer_accepted_date IS NOT NULL&#13;&#10;&#9;&#9;AND o.disposition_reason IS NULL&#13;&#10;&#9;&#9;AND CAST(o.proposed_hire_date AS DATE) &gt;&gt; current_date&#13;&#10;&#9;&#9;AND m1.managed_by IS NOT NULL&#13;&#10;&#9;GROUP BY&#13;&#10;&#9;&#9;1,&#13;&#10;&#9;&#9;2&#13;&#10;),&#13;&#10;metrics_prep AS (&#13;&#10;&#9;SELECT&#13;&#10;&#9;&#9;company_id,&#13;&#10;&#9;&#9;managed_by,&#13;&#10;&#9;&#9;COALESCE(indirect_reports, 0) AS indirect_reports,&#13;&#10;&#9;&#9;COALESCE(direct_reports, 0) AS direct_reports,&#13;&#10;&#9;&#9;COALESCE(direct_open_positions, 0) AS direct_open_positions,&#13;&#10;&#9;&#9;COALESCE(direct_hired_positions, 0) AS direct_hired_positions,&#13;&#10;&#9;&#9;COALESCE(indirect_open_positions, 0) AS indirect_open_positions,&#13;&#10;&#9;&#9;COALESCE(indirect_hired_positions, 0) AS indirect_hired_positions&#13;&#10;&#9;FROM&#13;&#10;&#9;&#9;indirect_reports&#13;&#10;&#9;&#9;FULL OUTER JOIN direct_reports USING(company_id, managed_by)&#13;&#10;&#9;&#9;FULL OUTER JOIN direct_open_positions USING(company_id, managed_by) &#13;&#10;&#9;&#9;FULL OUTER JOIN direct_hired_positions USING(company_id, managed_by) &#13;&#10;&#9;&#9;FULL OUTER JOIN indirect_open_positions USING(company_id, managed_by) &#13;&#10;&#9;&#9;FULL OUTER JOIN indirect_hired_positions USING(company_id, managed_by)&#13;&#10;)&#13;&#10;SELECT&#13;&#10;&#9;mp.managed_by AS manager_id,&#13;&#10;&#9;CONCAT(wp.first_name, &apos; &apos;, wp.last_name) AS manager_name,&#13;&#10;&#9;wo.management_level,&#13;&#10;&#9;wo.job_family,&#13;&#10;&#9;wo.job_family_group,&#13;&#10;&#9;mp.company_id,&#13;&#10;&#9;cm.company_name,&#13;&#10;&#9;cm.brand,&#13;&#10;&#9;cm.country,&#13;&#10;&#9;cm.country_group,&#13;&#10;&#9;cha.department,&#13;&#10;&#9;cha.sub_department,&#13;&#10;&#9;chw.cost_center_name,&#13;&#10;&#9;wo.department_wd,&#13;&#10;&#9;wo.sub_department_wd,&#13;&#10;&#9;m.manager_id_01,&#13;&#10;&#9;m.manager_01_full_name,&#13;&#10;&#9;m.manager_id_02,&#13;&#10;&#9;m.manager_02_full_name,&#13;&#10;&#9;m.manager_id_03,&#13;&#10;&#9;m.manager_03_full_name,&#13;&#10;&#9;m.manager_id_04,&#13;&#10;&#9;m.manager_04_full_name,&#13;&#10;&#9;m.manager_id_05,&#13;&#10;&#9;m.manager_05_full_name,&#13;&#10;&#9;m.manager_id_06,&#13;&#10;&#9;m.manager_06_full_name,&#13;&#10;&#9;m.manager_id_07,&#13;&#10;&#9;m.manager_07_full_name,&#13;&#10;&#9;wp.gender,&#13;&#10;&#9;mp.direct_reports,&#13;&#10;&#9;mp.direct_open_positions,&#13;&#10;&#9;mp.direct_hired_positions,&#13;&#10;&#9;mp.indirect_reports,&#13;&#10;&#9;mp.indirect_open_positions,&#13;&#10;&#9;mp.indirect_hired_positions,&#13;&#10;&#9;current_date AS last_updated&#13;&#10;FROM&#13;&#10;&#9;metrics_prep mp&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_worker_personal wp ON mp.managed_by = wp.employee_id&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_worker_org wo ON mp.managed_by = wo.employee_id&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_company_mapping cm ON mp.company_id = cm.company_id&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON wo.cost_center_id = cha.cost_center_id&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw ON wo.cost_center_id = chw.cost_center_id&#13;&#10;&#9;LEFT JOIN people_ops_proposed.il_manager m ON mp.managed_by = m.employee_id</relation>
