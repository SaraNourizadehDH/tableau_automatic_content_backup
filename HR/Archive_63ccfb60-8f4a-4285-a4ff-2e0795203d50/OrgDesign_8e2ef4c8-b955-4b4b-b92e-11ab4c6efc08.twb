            <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [company_id (Custom SQL Query)]&#13;&#10;    WHEN &apos;1001&apos; THEN [department (Custom SQL Query)]&#13;&#10;ELSE [department_wd (Custom SQL Query)]&#13;&#10;END' />
            </column>
