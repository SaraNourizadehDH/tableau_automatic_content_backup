            <column-instance column='[job_family_group (Custom SQL Query)]' derivation='None' name='[none:job_family_group (Custom SQL Query):nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d0n40q0gdxgwz0zopz8r07c6jjf'>
            <column caption='# Support Roles' datatype='integer' default-format='n#,##0;-#,##0' name='[# Core Roles (copy)_1317021450483376134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Job Family Core (copy)] AND [Job Family Group Set (copy)] THEN [actual_month_current] ELSE 0 END)' />
            </column>
            <column caption='% of Support Roles' datatype='real' default-format='p0.0%' name='[% of Core Roles (copy)_1317021450483527687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Core Roles (copy)_1317021450483376134] / TOTAL([# Core Roles (copy)_1317021450483376134])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
