            </column>
            <column caption='# Direct Positions &amp; Starters' datatype='integer' name='[Calculation_852869199706566663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [direct_open_positions] - [direct_hired_positions]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = FALSE THEN 0&#13;&#10;END' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_852869199735021578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [job_family (Custom SQL Query)]&#13;&#10;    WHEN &apos;Department&apos; THEN [Calculation_1751900275421347840]&#13;&#10;    WHEN &apos;Gender&apos; THEN [Gender (group)]&#13;&#10;END' />
