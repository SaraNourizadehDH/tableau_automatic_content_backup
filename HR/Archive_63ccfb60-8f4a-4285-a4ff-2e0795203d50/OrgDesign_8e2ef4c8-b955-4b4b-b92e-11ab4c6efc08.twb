      <aliases enabled='yes' />
      <column caption='# Total Indirect Reports' datatype='integer' name='[# Total Direct Reports (copy)_852869199494025218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[indirect_reports] + [Direct Positions &amp; Starters (copy)_852869199707369480]' />
      </column>
      <column caption='Avg. Indirect Reports' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Direct Reports (copy)_852869199495503876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([# Total Direct Reports (copy)_852869199494025218]) / COUNTD([manager_id])' />
      </column>
      <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id (Custom SQL Query)]&#13;&#10;    WHEN &apos;1001&apos; THEN [department (Custom SQL Query)]&#13;&#10;ELSE [department_wd (Custom SQL Query)]&#13;&#10;END' />
      </column>
      <column caption='Layer' datatype='string' name='[Calculation_1751900275426250754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [manager_id] = [manager_id_01] THEN &quot;DH CEO&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_02] THEN &quot;C Level&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_03] THEN &quot;C -1&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_04] THEN &quot;C -2&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_05] THEN &quot;C -3&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_06] THEN &quot;C -4&quot;&#13;&#10;ELSEIF [manager_id] = [manager_id_07] THEN &quot;C -5&quot;&#13;&#10;ELSE &quot;Lower layers&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg. Direct Reports' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1908400361064054785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_852869199491293185]) / COUNTD([manager_id])' />
      </column>
      <column caption='# of People Managers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2025634694644187144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([manager_id])' />
      </column>
      <column caption='Brand' datatype='string' name='[Calculation_711850251303669767]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Department global (copy)_1751900275421503489]&#13;&#10;    WHEN &apos;EU Regional Dmart&apos; THEN &apos;Foodora&apos;&#13;&#10;    WHEN &apos;EU Regional Platform&apos; THEN &apos;Foodora&apos;&#13;&#10;ELSE [brand (Custom SQL Query)]&#13;&#10;END' />
      </column>
      <column caption='Direct Reports &gt; 0' datatype='boolean' name='[Calculation_852869199485300736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_852869199491293185] &gt; 0' />
      </column>
      <column caption='# Total Direct Reports' datatype='integer' name='[Calculation_852869199491293185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[direct_reports] + [Calculation_852869199706566663]' />
      </column>
      <column caption='# Direct Positions &amp; Starters' datatype='integer' name='[Calculation_852869199706566663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [direct_open_positions] - [direct_hired_positions]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = FALSE THEN 0&#13;&#10;END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_852869199735021578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [job_family (Custom SQL Query)]&#13;&#10;    WHEN &apos;Department&apos; THEN [Calculation_1751900275421347840]&#13;&#10;    WHEN &apos;Gender&apos; THEN [Gender (group)]&#13;&#10;END' />
      </column>
      <column caption='Sub Department' datatype='string' name='[Department global (copy)_1751900275421503489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id (Custom SQL Query)]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department (Custom SQL Query)]&#13;&#10;ELSE [sub_department_wd (Custom SQL Query)]&#13;&#10;END' />
      </column>
      <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_1850135042241847297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension Switcher 1 (copy)_1850135042240897024]&#13;&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group (Custom SQL Query)]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [job_family (Custom SQL Query)]&#13;&#10;    WHEN &apos;Department&apos; THEN [Calculation_1751900275421347840]&#13;&#10;    WHEN &apos;Gender&apos; THEN [Gender (group)]&#13;&#10;END' />
      </column>
      <column caption='# Indirect Positions &amp; Starters' datatype='integer' name='[Direct Positions &amp; Starters (copy)_852869199707369480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [indirect_open_positions] - [indirect_hired_positions]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = FALSE THEN 0&#13;&#10;END' />
      </column>
      <column caption='Gender' datatype='string' name='[Gender (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[gender]' new-bin='true'>
          <bin default-name='true' value='&quot;Female&quot;'>
