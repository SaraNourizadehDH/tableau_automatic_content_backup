              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &apos;# HC Actual&apos; THEN [Calculation_1110981767137730561]&#13;&#10;    WHEN &apos;# of People Managers&apos; THEN [Calculation_1110981767137902594]&#13;&#10;    WHEN &apos;Avg. Time to Hire&apos; THEN [Calculation_1672524338021040129]&#13;&#10;    WHEN &apos;# Open Positions&apos; THEN [Calculation_419679224151121921]&#13;&#10;    WHEN &apos;# Voluntary Terminations Initiated (last 6m)&apos; THEN [Calculation_1110981767138205699]&#13;&#10;    WHEN &apos;Avg. Monthly Vol. Initiated Attrition (last 6m)&apos; THEN ([Calculation_419679224184770563] * 100)&#13;&#10;    WHEN &apos;# Monthly HC Actual in Risk (vs Vol. Attrition)&apos; THEN [Calculation_711850251255140352]&#13;&#10;END' />
