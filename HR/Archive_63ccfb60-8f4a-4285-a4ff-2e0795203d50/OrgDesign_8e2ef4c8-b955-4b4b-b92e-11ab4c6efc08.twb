      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>&lt;Sheet Name&gt; </run>
            <run fontalignment='1' fontcolor='#666666' fontname='Tableau Light' fontsize='8'>(&lt;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Avg. Direct Reports (copy)_852869199495503876:qk]&gt;)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Right Size' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='No' caption='Include Open Positions' datatype='boolean' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='Dimension Switcher 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Level&quot;'>
              <calculation class='tableau' formula='&quot;Management Level&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='# Total Indirect Reports' datatype='integer' name='[# Total Direct Reports (copy)_852869199494025218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[indirect_reports] + [Direct Positions &amp; Starters (copy)_852869199707369480]' />
            </column>
            <column caption='Avg. Indirect Reports' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Direct Reports (copy)_852869199495503876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Total Direct Reports (copy)_852869199494025218]) / COUNTD([manager_id])' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [company_id (Custom SQL Query)]&#13;&#10;    WHEN &apos;1001&apos; THEN [department (Custom SQL Query)]&#13;&#10;ELSE [department_wd (Custom SQL Query)]&#13;&#10;END' />
            </column>
            <column caption='# of People Managers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2025634694644187144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([manager_id])' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_711850251303669767]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Department global (copy)_1751900275421503489]&#13;&#10;    WHEN &apos;EU Regional Dmart&apos; THEN &apos;Foodora&apos;&#13;&#10;    WHEN &apos;EU Regional Platform&apos; THEN &apos;Foodora&apos;&#13;&#10;ELSE [brand (Custom SQL Query)]&#13;&#10;END' />
            </column>
            <column caption='-[Avg. Indirect Reports]' datatype='real' name='[Calculation_852869199499366406]' role='measure' type='quantitative' user:unnamed='Indirect Reports by Management Level'>
