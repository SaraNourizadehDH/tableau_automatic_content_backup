            <column caption='# Support Roles' datatype='integer' default-format='n#,##0;-#,##0' name='[# Core Roles (copy)_1317021450483376134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Job Family Core (copy)] AND [Job Family Group Set (copy)] THEN [actual_month_current] ELSE 0 END)' />
            </column>
            <column caption='Current Ratio (Core vs. Support)' datatype='string' name='[Calculation_1317021450479620098]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(&#13;&#10;    ZN(ROUND([Core Roles (copy)_1317021450482151429] / [Core Roles (copy)_1317021450482151429],0))&#13;&#10;) &#13;&#10;&#13;&#10;+ &quot;:&quot; +&#13;&#10;&#13;&#10;STR(&#13;&#10;    ZN(ROUND([# Core Roles (copy)_1317021450483376134] / [Core Roles (copy)_1317021450482151429],0))&#13;&#10;)' />
            </column>
            <column caption='Current Role Ratios' datatype='real' name='[Calculation_1317021450492903444]' role='measure' type='quantitative'>
