            <column caption='Management Level' datatype='string' name='[management_level (Custom SQL Query)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1751900275421347840]' derivation='None' name='[none:Calculation_1751900275421347840:nk]' pivot='key' type='nominal' />
            <column-instance column='[cost_center_name (Custom SQL Query)]' derivation='None' name='[none:cost_center_name (Custom SQL Query):nk]' pivot='key' type='nominal' />
