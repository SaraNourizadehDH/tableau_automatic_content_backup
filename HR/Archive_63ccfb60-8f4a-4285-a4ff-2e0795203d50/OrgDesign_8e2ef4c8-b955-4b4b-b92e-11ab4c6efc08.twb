      <aliases enabled='yes' />
      <column caption='# Support Roles' datatype='integer' default-format='n#,##0;-#,##0' name='[# Core Roles (copy)_1317021450483376134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Job Family Core (copy)] AND [Job Family Group Set (copy)] THEN [actual_month_current] ELSE 0 END)' />
      </column>
      <column caption='# Core Open Positions' datatype='integer' default-format='n#,##0;-#,##0' name='[# Core Roles (copy)_1317021450536665113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Job Family Set1] AND [Job Family Group Set]  THEN [direct_open_positions] - [direct_hired_positions] END' />
      </column>
      <column caption='% of Support Roles' datatype='real' default-format='p0.0%' name='[% of Core Roles (copy)_1317021450483527687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Core Roles (copy)_1317021450483376134] / TOTAL([# Core Roles (copy)_1317021450483376134])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% of Non People Managers' datatype='real' default-format='p0%' name='[% of People Managers (copy)_711850251302023174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1317021450520539159] / SUM([actual_month_current])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[pcto:sum:actual_month_current:qk:1]&quot;' value='% of Total' />
          <alias key='&quot;[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[pcto:sum:actual:qk:4]&quot;' value='% of Total1' />
          <alias key='&quot;[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[pcto:sum:actual:qk]&quot;' value='% of Total HC1' />
          <alias key='&quot;[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[usr:\% of Core Roles (copy)_1317021450483527687:qk:1]&quot;' value='% of Support Roles' />
          <alias key='&quot;[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[usr:Core Roles (copy)_1317021450481356804:qk]&quot;' value='% of Core Roles' />
        </aliases>
      </column>
      <column caption='HC Actual for Parameter' datatype='integer' hidden='true' name='[Calculation_1110981767137730561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_month_current])' />
      </column>
      <column caption='People Managers for Parameter' datatype='integer' hidden='true' name='[Calculation_1110981767137902594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_people_managers])' />
      </column>
      <column caption='Voluntary Terminations Initiated for Parameter' datatype='integer' hidden='true' name='[Calculation_1110981767138205699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voluntary_initiated_terminations])' />
      </column>
      <column caption='Current Ratio (Core vs. Support)' datatype='string' name='[Calculation_1317021450479620098]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;    ZN(ROUND([Core Roles (copy)_1317021450482151429] / [Core Roles (copy)_1317021450482151429],0))&#13;&#10;) &#13;&#10;&#13;&#10;+ &quot;:&quot; +&#13;&#10;&#13;&#10;STR(&#13;&#10;    ZN(ROUND([# Core Roles (copy)_1317021450483376134] / [Core Roles (copy)_1317021450482151429],0))&#13;&#10;)' />
      </column>
      <column caption='Current Role Ratios' datatype='real' name='[Calculation_1317021450492903444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(ROUND([# Core Roles (copy)_1317021450483376134] / [Core Roles (copy)_1317021450482151429],0))' />
      </column>
      <column caption='# of Non People Managers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1317021450520539159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_month_current]) - SUM([actual_people_managers])' />
      </column>
      <column caption='Avg. Direct Reports' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_1672524338019495936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_419679224121716736]) / SUM([actual_people_managers])' />
      </column>
      <column caption='Avg. Time to Hire (days)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1672524338021040129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tth] * [count_tth])&#13;&#10;/&#13;&#10;SUM([count_tth])' />
      </column>
      <column caption='Count TTH Last Month' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_1672524338043166728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([count_tth]), LAST() -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;ELSE [department_wd]&#13;&#10;END' />
      </column>
      <column caption='# Total Direct Reports' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_419679224121716736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual_month_current] + [Calculation_852869199706566663]' />
      </column>
      <column caption='# Open Positions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_419679224151121921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([direct_open_positions]) - SUM([direct_hired_positions])' />
      </column>
      <column caption='Avg. Monthly Vol. Initiated Attrition (last 6m)' datatype='real' default-format='p0.0%' name='[Calculation_419679224184770563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([voluntary_initiated_terminations])   &#13;&#10;/&#13;&#10;[Calculation_419679224195756036])&#13;&#10;/ &#13;&#10;6' />
      </column>
      <column caption='Avg. HC Actual (last 6m)' datatype='real' hidden='true' name='[Calculation_419679224195756036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([actual_month_current]) &#13;&#10;+ SUM([actual_month_minus1])&#13;&#10;+ SUM([actual_month_minus2])&#13;&#10;+ SUM([actual_month_minus3])&#13;&#10;+ SUM([actual_month_minus4])&#13;&#10;+ SUM([actual_month_minus5]))&#13;&#10;/&#13;&#10;6' />
      </column>
      <column caption='# Monthly HC Actual in Risk (vs Vol. Attrition)' datatype='real' name='[Calculation_711850251255140352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([actual_month_current]) * [Calculation_419679224184770563], 0)' />
      </column>
      <column caption='% of People Managers' datatype='real' default-format='p0%' name='[Calculation_711850251301892101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_people_managers]) / SUM([actual_month_current])' />
      </column>
      <column caption='Brand' datatype='string' name='[Calculation_711850251303669767]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Department global (copy)_1751900275421503489]&#13;&#10;    WHEN &apos;EU Regional Dmart&apos; THEN &apos;Foodora&apos;&#13;&#10;    WHEN &apos;EU Regional Platform&apos; THEN &apos;Foodora&apos;&#13;&#10;ELSE [brand]&#13;&#10;END' />
      </column>
      <column caption='# Direct Positions &amp; Starters' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_852869199706566663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [direct_open_positions] - [direct_hired_positions]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = FALSE THEN 0&#13;&#10;END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_852869199735021578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level]&#13;&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group - Split 1]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [Job Family Group (copy)_419679224206254085]&#13;&#10;    WHEN &apos;Department&apos; THEN [Calculation_1751900275421347840]&#13;&#10;    WHEN &apos;Gender&apos; THEN [Gender (group)]&#13;&#10;END' />
      </column>
      <column caption='% of Core Roles' datatype='real' default-format='p0.0%' name='[Core Roles (copy)_1317021450481356804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Core Roles (copy)_1317021450482151429] / TOTAL([Core Roles (copy)_1317021450482151429])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='# Core Roles' datatype='integer' default-format='n#,##0;-#,##0' name='[Core Roles (copy)_1317021450482151429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Job Family Set1] AND [Job Family Group Set]  THEN [actual_month_current] ELSE 0 END)' />
      </column>
      <column caption='Sub Department' datatype='string' name='[Department global (copy)_1751900275421503489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department]&#13;&#10;ELSE [sub_department_wd]&#13;&#10;END' />
      </column>
      <column caption='Metric 1' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Dimension 1 (copy)_1110981767136514048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &apos;# HC Actual&apos; THEN [Calculation_1110981767137730561]&#13;&#10;    WHEN &apos;# of People Managers&apos; THEN [Calculation_1110981767137902594]&#13;&#10;    WHEN &apos;Avg. Time to Hire&apos; THEN [Calculation_1672524338021040129]&#13;&#10;    WHEN &apos;# Open Positions&apos; THEN [Calculation_419679224151121921]&#13;&#10;    WHEN &apos;# Voluntary Terminations Initiated (last 6m)&apos; THEN [Calculation_1110981767138205699]&#13;&#10;    WHEN &apos;Avg. Monthly Vol. Initiated Attrition (last 6m)&apos; THEN ([Calculation_419679224184770563] * 100)&#13;&#10;    WHEN &apos;# Monthly HC Actual in Risk (vs Vol. Attrition)&apos; THEN [Calculation_711850251255140352]&#13;&#10;END' />
