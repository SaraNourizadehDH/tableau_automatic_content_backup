            <column caption='People Managers for Parameter' datatype='integer' hidden='true' name='[Calculation_1110981767137902594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_people_managers])' />
            </column>
            <column caption='Voluntary Terminations Initiated for Parameter' datatype='integer' hidden='true' name='[Calculation_1110981767138205699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voluntary_initiated_terminations])' />
            </column>
            <column caption='Avg. Time to Hire (days)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1672524338021040129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tth] * [count_tth])&#13;&#10;/&#13;&#10;SUM([count_tth])' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;ELSE [department_wd]&#13;&#10;END' />
            </column>
            <column caption='# Open Positions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_419679224151121921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([direct_open_positions]) - SUM([direct_hired_positions])' />
            </column>
            <column caption='Avg. Monthly Vol. Initiated Attrition (last 6m)' datatype='real' default-format='p0.0%' name='[Calculation_419679224184770563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([voluntary_initiated_terminations])   &#13;&#10;/&#13;&#10;[Calculation_419679224195756036])&#13;&#10;/ &#13;&#10;6' />
            </column>
            <column caption='Avg. HC Actual (last 6m)' datatype='real' hidden='true' name='[Calculation_419679224195756036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([actual_month_current]) &#13;&#10;+ SUM([actual_month_minus1])&#13;&#10;+ SUM([actual_month_minus2])&#13;&#10;+ SUM([actual_month_minus3])&#13;&#10;+ SUM([actual_month_minus4])&#13;&#10;+ SUM([actual_month_minus5]))&#13;&#10;/&#13;&#10;6' />
            </column>
            <column caption='# Monthly HC Actual in Risk (vs Vol. Attrition)' datatype='real' name='[Calculation_711850251255140352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([actual_month_current]) * [Calculation_419679224184770563], 0)' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_711850251303669767]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Department global (copy)_1751900275421503489]&#13;&#10;    WHEN &apos;EU Regional Dmart&apos; THEN &apos;Foodora&apos;&#13;&#10;    WHEN &apos;EU Regional Platform&apos; THEN &apos;Foodora&apos;&#13;&#10;ELSE [brand]&#13;&#10;END' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_852869199735021578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Management Level Group&apos; THEN [Management Level (group)]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level]&#13;&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group - Split 1]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [Job Family Group (copy)_419679224206254085]&#13;&#10;    WHEN &apos;Department&apos; THEN [Calculation_1751900275421347840]&#13;&#10;    WHEN &apos;Gender&apos; THEN [Gender (group)]&#13;&#10;END' />
