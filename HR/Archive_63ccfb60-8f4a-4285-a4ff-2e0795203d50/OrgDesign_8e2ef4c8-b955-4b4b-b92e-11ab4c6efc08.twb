      <repository-location id='4-RightSize-RoleRatios' path='/t/HR/workbooks/OrgDesign' revision='' site='HR' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='font-size' value='10' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-family' value='Tableau Book' />
          <format attr='font-size' value='10' />
        </style-rule>
      </style>
      <size maxheight='1600' maxwidth='1400' minheight='1600' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Right Structure' name='federated.0d0n40q0gdxgwz0zopz8r07c6jjf' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimension Switcher 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Level&quot;'>
          <calculation class='tableau' formula='&quot;Management Level&quot;' />
          <members>
            <member value='&quot;Management Level Group&quot;' />
            <member value='&quot;Management Level&quot;' />
            <member value='&quot;Job Family Group&quot;' />
            <member value='&quot;Job Family&quot;' />
            <member value='&quot;Department&quot;' />
            <member value='&quot;Gender&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0d0n40q0gdxgwz0zopz8r07c6jjf'>
        <column caption='Department' datatype='string' name='[Calculation_1751900275421347840]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;ELSE [department_wd]&#13;&#10;END' />
        </column>
        <column caption='Brand' datatype='string' name='[Calculation_711850251303669767]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Department global (copy)_1751900275421503489]&#13;&#10;    WHEN &apos;EU Regional Dmart&apos; THEN &apos;Foodora&apos;&#13;&#10;    WHEN &apos;EU Regional Platform&apos; THEN &apos;Foodora&apos;&#13;&#10;ELSE [brand]&#13;&#10;END' />
        </column>
        <column caption='Sub Department' datatype='string' name='[Department global (copy)_1751900275421503489]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department]&#13;&#10;ELSE [sub_department_wd]&#13;&#10;END' />
        </column>
        <column caption='Gender' datatype='string' name='[Gender (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[gender]' new-bin='true'>
            <bin default-name='true' value='&quot;Female&quot;'>
              <value>&quot;Female&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;Male&quot;'>
              <value>&quot;Male&quot;</value>
            </bin>
            <bin default-name='true' value='&quot;Non-binary&quot;'>
              <value>&quot;Non-binary&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Not disclosed&quot;'>
              <value>%null%</value>
              <value>&quot;Other&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='Job Family' datatype='string' name='[Job Family Group (copy)_419679224206254085]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[job_family_group]'>
          <calculation class='tableau' formula='(IF FIND([job_family], &quot;;&quot;, 1) &gt; 1 THEN SPLIT( [job_family], &quot;; &quot;, 2 )&#13;&#10;ELSE [job_family]&#13;&#10;END)' />
        </column>
        <column caption='Cost Center' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='string' name='[gender]' role='dimension' type='nominal' />
        <column caption='Job Family Group' datatype='string' name='[job_family_group - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0d0n40q0gdxgwz0zopz8r07c6jjf].[job_family_group]'>
          <calculation class='tableau' formula='IF FIND([job_family_group], &quot;;&quot;, 1) &gt; 1 THEN SPLIT( [job_family_group], &quot;; &quot;, 2 )&#13;&#10;ELSE [job_family_group]&#13;&#10;END' />
        </column>
