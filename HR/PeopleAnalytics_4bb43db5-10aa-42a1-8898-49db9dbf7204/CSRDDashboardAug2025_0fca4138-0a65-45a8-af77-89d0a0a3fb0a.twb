            </column>
            <column caption='Age (Calc)' datatype='integer' name='[Calculation_4612530489456680965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;))&#13;&#10;    - IF DATEADD(&#13;&#10;            &apos;year&apos;,&#13;&#10;            DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;)),&#13;&#10;            [Date of birth]&#13;&#10;        ) &gt; DATE(&quot;2025-08-31&quot;)&#13;&#10;      THEN 1 ELSE 0 END' />
            </column>
            <column caption='WD count' datatype='string' name='[Calculation_4612530489485946886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  ISNULL([Employee ID (required if using workday)]) then [Employee name]&#13;&#10;&#13;&#10;elseif (ISNULL([Employee ID (required if using workday)]) and ISNULL([Employee name])) then null&#13;&#10;else [Employee ID (required if using workday)]&#13;&#10;END' />
            </column>
            <column caption='Contract Type %' datatype='real' name='[Calculation_4612530489521795080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(IF [CSRD Contract Type]=&quot;Permanent&quot;&#13;&#10;or&#13;&#10; &#13;&#10;[CSRD Contract Type]=&quot;Temporary&quot;&#13;&#10;&#13;&#10;or CONTAINS([CSRD Contract Type],&quot;Permanent&quot;)&#13;&#10;&#13;&#10;or CONTAINS([CSRD Contract Type],&quot;Temporary&quot;)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;then [Calculation_4612530489485946886] END)/RUNNING_SUM(count([Calculation_4612530489485946886]))'>
                <table-calc ordering-type='Rows' />
