          <datasource-dependencies datasource='federated.17homhe1b13keg17xpiig0rl6c3t'>
            <column caption='Level % (Data Quality)' datatype='real' name='[Age % (Data Quality) (copy)_3296634976543760406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [management_level] = [Management Level] THEN [Management Level] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Management Level] END )&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
