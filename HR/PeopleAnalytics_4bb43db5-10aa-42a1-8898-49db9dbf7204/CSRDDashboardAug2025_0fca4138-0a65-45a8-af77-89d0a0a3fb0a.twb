    <worksheet name='Brand Tooltip'>
      <table>
        <view>
          <datasources>
            <datasource caption='Angelia Testing Master List CSRD final' name='federated.17homhe1b13keg17xpiig0rl6c3t' />
          </datasources>
          <datasource-dependencies datasource='federated.17homhe1b13keg17xpiig0rl6c3t'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DHSE&quot;' value='Delivery Hero' />
                <alias key='&quot;Efood/Foody&quot;' value='EFood/Foody' />
                <alias key='&quot;PedidosYa/Hugo&quot;' value='PedidosYa' />
              </aliases>
            </column>
            <column datatype='string' name='[CSRD Contract Type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CSRD Contract Type]' new-bin='true'>
                <bin default-name='false' value='&quot;Null or Others&quot;'>
                  <value>%null%</value>
                </bin>
                <bin default-name='false' value='&quot;Permanent&quot;'>
                  <value>&quot;Fixed Term&quot;</value>
                  <value>&quot;Fixed Term (Fixed Term)&quot;</value>
                  <value>&quot;Fixed-term&quot;</value>
                  <value>&quot;Intern&quot;</value>
                  <value>&quot;Intern (Fixed Term) (Trainee)&quot;</value>
                  <value>&quot;Intern (Trainee)&quot;</value>
                  <value>&quot;Operational Worker - Fixed Term (Fixed Term)&quot;</value>
                  <value>&quot;Operational Worker - Permanent&quot;</value>
                  <value>&quot;Permanent&quot;</value>
                  <value>&quot;Permanent Employee&quot;</value>
                  <value>&quot;Permanent employees&quot;</value>
                  <value>&quot;Project based (Fixed Term)&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Temporary&quot;'>
                  <value>&quot;Temporary&quot;</value>
                  <value>&quot;Temporary employees&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[CSRD Contract Type]' role='dimension' type='nominal' />
            <column caption='Age Group' datatype='string' name='[Calculation_4612530488494247940]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Age group buckets&#13;&#10;IF [Calculation_4612530489456680965] &lt; 30 THEN&#13;&#10;    &quot;Under 30 years old&quot;&#13;&#10;ELSEIF [Calculation_4612530489456680965] &lt;= 50 THEN&#13;&#10;    &quot;30-50 years old&quot;&#13;&#10;ELSEIF [Calculation_4612530489456680965] &gt; 50 THEN&#13;&#10;    &quot;Over 50 years old&quot;&#13;&#10;Else &quot;Others&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Others&quot;' value='Null or Others' />
              </aliases>
            </column>
            <column caption='Age (Calc)' datatype='integer' name='[Calculation_4612530489456680965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;))&#13;&#10;    - IF DATEADD(&#13;&#10;            &apos;year&apos;,&#13;&#10;            DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;)),&#13;&#10;            [Date of birth]&#13;&#10;        ) &gt; DATE(&quot;2025-08-31&quot;)&#13;&#10;      THEN 1 ELSE 0 END' />
            </column>
            <column caption='WD count' datatype='string' name='[Calculation_4612530489485946886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  ISNULL([Employee ID (required if using workday)]) then [Employee name]&#13;&#10;&#13;&#10;elseif (ISNULL([Employee ID (required if using workday)]) and ISNULL([Employee name])) then null&#13;&#10;else [Employee ID (required if using workday)]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[Country]' new-bin='true'>
                <bin default-name='false' value='&quot;Iraq&quot;'>
                  <value>&quot;Baghdad&quot;</value>
                  <value>&quot;Iraq&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Saudi Arabia&quot;'>
                  <value>&quot;KSA&quot;</value>
                  <value>&quot;Saudi Arabia&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;United Arab Emirates&quot;'>
                  <value>&quot;UAE&quot;</value>
                  <value>&quot;United Arab Emirates&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' default-format='*dd-mmm-yy' name='[Date of birth]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Employee ID (required if using workday)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Employee name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Gender]' new-bin='true'>
                <bin default-name='false' value='&quot;Not Reported&quot;'>
                  <value>&quot;Undisclosed&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Null or Others&quot;'>
                  <value>%null%</value>
                  <value>&quot;\#N/A&quot;</value>
                  <value>&quot;na&quot;</value>
                  <value>&quot;Other&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4612530489485946886]' derivation='Count' name='[cnt:Calculation_4612530489485946886:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Brand]' derivation='None' name='[none:Brand:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17homhe1b13keg17xpiig0rl6c3t].[Tooltip (Age Group)]'>
            <groupfilter function='level-members' level='[Calculation_4612530488494247940]' user:ui-action-filter='[Action - Brand Tooltip]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17homhe1b13keg17xpiig0rl6c3t].[Tooltip (CSRD Contract Type (group))]'>
            <groupfilter function='level-members' level='[CSRD Contract Type (group)]' user:ui-action-filter='[Action - Brand Tooltip]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17homhe1b13keg17xpiig0rl6c3t].[Tooltip (Country (group))]'>
            <groupfilter function='level-members' level='[Country (group)]' user:ui-action-filter='[Action - Brand Tooltip]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17homhe1b13keg17xpiig0rl6c3t].[Tooltip (Gender (group))]'>
            <groupfilter function='level-members' level='[Gender (group)]' user:ui-action-filter='[Action - Brand Tooltip]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.17homhe1b13keg17xpiig0rl6c3t].[none:Brand:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.17homhe1b13keg17xpiig0rl6c3t].[cnt:Calculation_4612530489485946886:qk]' shelf='rows' />
          </shelf-sorts>
