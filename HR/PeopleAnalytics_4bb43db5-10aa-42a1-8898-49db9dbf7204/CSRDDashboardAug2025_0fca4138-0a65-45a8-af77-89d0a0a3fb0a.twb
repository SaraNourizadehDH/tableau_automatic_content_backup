                  <relation connection='athena.0643fz70f854re1dgaqpm0pmax72' name='Custom SQL Query' type='text'>SELECT &#13;
  &quot;il_worker_personal&quot;.&quot;age&quot; AS &quot;age&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;age_group&quot; AS &quot;age_group&quot;,&#13;
  &#13;
  &quot;il_worker_personal&quot;.&quot;birth_date&quot; AS &quot;birth_date&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;business_title&quot; AS &quot;business_title&quot;,&#13;
