  &quot;il_worker_hist_wit&quot;.&quot;c_level&quot; AS &quot;c_level&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;citizenship_status&quot; AS &quot;citizenship_status&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;city_of_birth&quot; AS &quot;city_of_birth&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;company_id&quot; AS &quot;company_id__il_wor&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;company_id&quot; AS &quot;company_id&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;contract_type&quot; AS &quot;contract_type&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;country_of_birth&quot; AS &quot;country_of_birth&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;department_wd&quot; AS &quot;department_wd&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;employee_id&quot; AS &quot;employee_id__il_wo&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;employee_id&quot; AS &quot;employee_id&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;first_day_of_work&quot; AS &quot;first_day_of_work&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;fte&quot; AS &quot;fte&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;gender&quot; AS &quot;gender&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;is_active&quot; AS &quot;is_active&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;is_terminated&quot; AS &quot;is_terminated&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;last_day_of_work&quot; AS &quot;last_day_of_work&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;location_identifier&quot; AS &quot;location_identifie&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;management_level&quot; AS &quot;management_level&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;marital_status&quot; AS &quot;marital_status&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;national_ids&quot; AS &quot;national_ids&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;nationality&quot; AS &quot;nationality&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;num_dependants&quot; AS &quot;num_dependants&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;office_location&quot; AS &quot;office_location&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;office_location_country&quot; AS &quot;office_location_co&quot;,&#13;
  &quot;il_worker_personal&quot;.&quot;preferred_full_name&quot; AS &quot;preferred_full_nam&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;report_effective_date&quot; AS &quot;report_effective_d&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;sub_department_wd&quot; AS &quot;sub_department_wd&quot;,&#13;
  &quot;il_worker_hist_wit&quot;.&quot;worker_type&quot; AS &quot;worker_type&quot;&#13;
FROM &quot;people_ops_proposed&quot;.&quot;il_worker_hist_with_current&quot; &quot;il_worker_hist_wit&quot;&#13;
  LEFT JOIN &quot;people_ops_proposed&quot;.&quot;il_worker_personal&quot; &quot;il_worker_personal&quot; ON (&quot;il_worker_hist_wit&quot;.&quot;employee_id&quot; = &quot;il_worker_personal&quot;.&quot;employee_id&quot;)&#13;
WHERE CAST(&quot;il_worker_hist_wit&quot;.&quot;report_effective_date&quot; AS DATE) = DATE &apos;2025-08-31&apos;&#13;
  AND &quot;il_worker_hist_wit&quot;.&quot;is_terminated&quot; = 0</relation>
