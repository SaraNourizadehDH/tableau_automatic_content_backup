    <worksheet name='Gender (Data Quality)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Angelia Testing Master List CSRD final' name='federated.17homhe1b13keg17xpiig0rl6c3t' />
          </datasources>
          <datasource-dependencies datasource='federated.17homhe1b13keg17xpiig0rl6c3t'>
            <column caption='Gender % (Data Quality)' datatype='real' name='[Age % (Data Quality) (copy)_3296634976551981080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [Gender] = [gender] THEN [Gender] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Gender] END )&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Brand (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Brand]' new-bin='true'>
                <bin default-name='false' value='&quot;Delivery Hero&quot;'>
                  <value>&quot;Delivery Hero&quot;</value>
                  <value>&quot;DHSE&quot;</value>
                  <value>&quot;Other_europe&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;EFood/Foody&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Efood/Foody&quot;</value>
                  <value>&quot;EPN_BR_CY_GR&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Glovo&quot;'>
                  <value>&quot;epn_br_glovo_europe&quot;</value>
                  <value>&quot;Glovo&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Hungerstation&quot;'>
                  <value>&quot;EPN_BR_Hungerstation&quot;</value>
                  <value>&quot;epn_br_hungerstation_mena&quot;</value>
                  <value>&quot;Hungerstation&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Instashop&quot;'>
                  <value>&quot;EPN_BR_Instashop&quot;</value>
                  <value>&quot;Instashop&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Null &amp; N/A&quot;'>
                  <value>%null%</value>
                  <value>&quot;\#N/A&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;EPN_BR_Foodora&quot;</value>
                  <value>&quot;EPN_BR_Foodpanda&quot;</value>
                  <value>&quot;epn_br_pandora&quot;</value>
                  <value>&quot;EPN_BR_Yemeksepeti&quot;</value>
                  <value>&quot;Pandora&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PedidosYa&quot;'>
                  <value>&quot;EPN_BR_PedidosYa&quot;</value>
                  <value>&quot;Hugo&quot;</value>
                  <value>&quot;PedidosYa&quot;</value>
                  <value>&quot;PedidosYa/Hugo&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Tabsquare&quot;'>
                  <value>&quot;EPN_BR_Tabsquare&quot;</value>
                  <value>&quot;Tabsquare&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Talabat&quot;'>
                  <value>&quot;epn_br_talcarr_mena&quot;</value>
                  <value>&quot;Talabat&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Woowa&quot;'>
                  <value>&quot;EPN_BR_Woowa&quot;</value>
                  <value>&quot;Woowa&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DHSE&quot;' value='Delivery Hero' />
                <alias key='&quot;Efood/Foody&quot;' value='EFood/Foody' />
                <alias key='&quot;PedidosYa/Hugo&quot;' value='PedidosYa' />
              </aliases>
            </column>
            <column caption='Delta ' datatype='real' name='[Calculation_2205637964409159680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_7581528549959622657])-COUNT([Calculation_4612530489485946886])' />
            </column>
            <column caption='Data Consistency' datatype='real' name='[Calculation_4612530488488697856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if AVG([Calculation_7581528549959622657])&gt;COUNT([Calculation_4612530489485946886]) then&#13;&#10;&#13;&#10;&#13;&#10;COUNT([Calculation_4612530489485946886])/AVG([Calculation_7581528549959622657])&#13;&#10;&#13;&#10;ELSE&#13;&#10;AVG([Calculation_7581528549959622657])/COUNT([Calculation_4612530489485946886])&#13;&#10;END' />
            </column>
            <column caption='WD count' datatype='string' name='[Calculation_4612530489485946886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  ISNULL([Employee ID (required if using workday)]) then [Employee name]&#13;&#10;&#13;&#10;elseif (ISNULL([Employee ID (required if using workday)]) and ISNULL([Employee name])) then null&#13;&#10;else [Employee ID (required if using workday)]&#13;&#10;END' />
            </column>
            <column caption='Controlling' datatype='integer' name='[Calculation_7581528549959622657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_7581528550196035593]=&apos;Delivery Hero&apos; then 3157&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Pandora&apos; then 14256&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;EFood/Foody&apos; then 2021&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Glovo&apos; then 19358&#13;&#10; ELSEIF [Calculation_7581528550196035593]=&apos;Hungerstation&apos; then 1066&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Instashop&apos; then 848&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;PedidosYa&apos; then 5996&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Tabsquare&apos; then 113&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Talabat&apos; then 7081&#13;&#10;ELSEIF [Calculation_7581528550196035593]=&apos;Woowa&apos; then 4107&#13;&#10;END' />
            </column>
            <column caption='Brand (new cal)' datatype='string' name='[Calculation_7581528550196035593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Company Code]&lt;&gt;[company_id] then [brand] else [Brand (group)] END' />
            </column>
            <column datatype='string' name='[Company Code]' role='dimension' type='nominal' />
            <column datatype='string' name='[Employee ID (required if using workday)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Employee name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column caption='Brand1' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4612530489485946886]' derivation='Count' name='[cnt:Calculation_4612530489485946886:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[company_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column caption='WD - Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column-instance column='[Brand]' derivation='None' name='[none:Brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[Age % (Data Quality) (copy)_3296634976551981080]' derivation='User' name='[usr:Age % (Data Quality) (copy)_3296634976551981080:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
