      <table>
        <view>
          <datasources>
            <datasource caption='Angelia Testing Master List CSRD final' name='federated.17homhe1b13keg17xpiig0rl6c3t' />
          </datasources>
          <datasource-dependencies datasource='federated.17homhe1b13keg17xpiig0rl6c3t'>
            <column caption='Level % (Data Quality)' datatype='real' name='[Age % (Data Quality) (copy)_3296634976543760406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [management_level] = [Management Level] THEN [Management Level] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Management Level] END )&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Gender % (Data Quality)' datatype='real' name='[Age % (Data Quality) (copy)_3296634976551981080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [Gender] = [gender] THEN [Gender] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Gender] END )&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Age % (Data Quality)' datatype='real' name='[Age % (copy)_3296634976539131924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [Date of birth] = [birth_date] THEN [Date of birth] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Date of birth] END )&#13;&#10;    )&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DHSE&quot;' value='Delivery Hero' />
                <alias key='&quot;Efood/Foody&quot;' value='EFood/Foody' />
                <alias key='&quot;PedidosYa/Hugo&quot;' value='PedidosYa' />
              </aliases>
            </column>
            <column caption='Data Quality' datatype='real' name='[Calculation_3296634976553668633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Age % (copy)_3296634976539131924]+[Level % (Data Quality) (copy)_3296634976544538647]+[Age % (Data Quality) (copy)_3296634976551981080]+[Age % (Data Quality) (copy)_3296634976543760406])/4'>
