      <column caption='Level % (M4 &amp; above) (copy 2)' datatype='real' name='[Level % (M4 &amp; above) (copy 2)_7340867444787220481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [Completeness Score (M4+)]&#13;&#10;SUM( IIF(&#13;&#10;  [management_level] IN (&apos;M4&apos;,&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;,&apos;E2&apos;)&#13;&#10;  AND ( ISNULL([employee_id])         // auto 100% when employee_id is NULL&#13;&#10;        OR NOT ISNULL([Management Level]) ), &#13;&#10;  1, 0)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM( IIF(&#13;&#10;  [management_level] IN (&apos;M4&apos;,&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;,&apos;E2&apos;),&#13;&#10;  1, 0)&#13;&#10;)' />
