            <column caption='Date of birth str' datatype='string' name='[Calculation_2501186692825952265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Date of birth]) THEN &apos;&apos;&#13;&#10;ELSE&#13;&#10;  RIGHT(&apos;00&apos; + STR(DATEPART(&apos;day&apos;, [Date of birth])), 2)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  LEFT(DATENAME(&apos;month&apos;, [Date of birth]), 3)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  STR(DATEPART(&apos;year&apos;, [Date of birth]))&#13;&#10;END' />
            </column>
            <column caption='birth_date str' datatype='string' name='[Calculation_2501186692826603530]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([birth_date]) THEN &apos;&apos;&#13;&#10;ELSE&#13;&#10;  RIGHT(&apos;00&apos; + STR(DATEPART(&apos;day&apos;, DATE([birth_date]))), 2)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  LEFT(DATENAME(&apos;month&apos;, DATE([birth_date])), 3)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  STR(DATEPART(&apos;year&apos;, DATE([birth_date])))&#13;&#10;END' />
            </column>
            <column caption='Brand Submission Data' datatype='string' name='[Calculation_3296634975917998091]' role='dimension' type='nominal'>
