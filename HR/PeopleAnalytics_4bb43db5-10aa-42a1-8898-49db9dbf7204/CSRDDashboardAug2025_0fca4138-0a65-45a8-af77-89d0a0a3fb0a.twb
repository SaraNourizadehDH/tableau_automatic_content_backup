      </column>
      <column caption='Delta ' datatype='real' name='[Calculation_2205637964409159680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_7581528549959622657])-COUNT([Calculation_4612530489485946886])' />
      </column>
      <column caption='Gender check' datatype='boolean' name='[Calculation_2205637964409929729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[gender]=[Gender]' />
      </column>
      <column caption='Attrition Rate %' datatype='real' name='[Calculation_2501186692704743426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee ID (Leavers)])/COUNT([Calculation_4612530489485946886])' />
      </column>
      <column caption='Level M4 and Above' datatype='boolean' name='[Calculation_2501186692767899652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Management Level]=&apos;M4&apos; OR &#13;&#10;[Management Level]=&apos;M5&apos; OR &#13;&#10;[Management Level]=&apos;M6&apos; OR &#13;&#10;[Management Level]=&apos;E1&apos; OR &#13;&#10;[Management Level]=&apos;E2&apos; )' />
      </column>
      <column caption='WD Measure 1' datatype='string' name='[Calculation_2501186692806930440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Null Measure (copy)_3296634975919403020]=&quot;United Arab Emirates&quot; then &quot;UAE&quot; else [Null Measure (copy)_3296634975919403020] END' />
      </column>
      <column caption='Date of birth str' datatype='string' name='[Calculation_2501186692825952265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Date of birth]) THEN &apos;&apos;&#13;&#10;ELSE&#13;&#10;  RIGHT(&apos;00&apos; + STR(DATEPART(&apos;day&apos;, [Date of birth])), 2)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  LEFT(DATENAME(&apos;month&apos;, [Date of birth]), 3)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  STR(DATEPART(&apos;year&apos;, [Date of birth]))&#13;&#10;END' />
      </column>
      <column caption='birth_date str' datatype='string' name='[Calculation_2501186692826603530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([birth_date]) THEN &apos;&apos;&#13;&#10;ELSE&#13;&#10;  RIGHT(&apos;00&apos; + STR(DATEPART(&apos;day&apos;, DATE([birth_date]))), 2)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  LEFT(DATENAME(&apos;month&apos;, DATE([birth_date])), 3)&#13;&#10;  + &apos;-&apos; +&#13;&#10;  STR(DATEPART(&apos;year&apos;, DATE([birth_date])))&#13;&#10;END' />
      </column>
      <column caption='Data Coverage' datatype='real' name='[Calculation_2543689416319651841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id])/COUNT([Calculation_4612530489485946886])' />
      </column>
      <column caption='Count of WD Count' datatype='integer' name='[Calculation_2543689416404807683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_4612530489485946886])' />
      </column>
      <column caption='% of total WD Count' datatype='real' name='[Calculation_2543689416404893700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_4612530489485946886]) / TOTAL(COUNT([Calculation_4612530489485946886]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total HC based on Submission' datatype='integer' name='[Calculation_2543689416406425605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_4612530489485946886])' />
      </column>
      <column caption='No. of Leavers' datatype='integer' name='[Calculation_2543689416406626311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3296634976184086541]' />
      </column>
      <column caption='Level % (M4 &amp; above)' datatype='real' name='[Calculation_3296634974478954497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-count(IF isnull([Management Level]) and [Management Level]=&apos;M4&apos;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;then [Calculation_4612530489485946886] END)/RUNNING_SUM(count([Calculation_4612530489485946886]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CSRD Data Completeness' datatype='real' name='[Calculation_3296634974489722885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    // no Level% when employee_id is null&#13;&#10;    ([Level % (copy)_4612530489523904523] + [Level % (copy)_3296634976536240144] + [Calculation_4612530489521795080] + [Contract Type % (copy)_4612530489522778121]) / 4&#13;&#10;ELSE&#13;&#10;    // include Level% when employee_id is present&#13;&#10;    ([Level % (copy)_4612530489523904523] + [Level % (copy)_3296634976536240144] + [Calculation_4612530489521795080] + [Calculation_3296634974478954497] + [Contract Type % (copy)_4612530489522778121]) / 5&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Brand Submission Data' datatype='string' name='[Calculation_3296634975917998091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;when &quot;Gender List&quot; then [Gender]&#13;&#10;when &quot;Contract Type List&quot; then [CSRD Contract Type]&#13;&#10;when &quot;Date of Birth List&quot; then [Calculation_2501186692825952265]&#13;&#10;when &quot;Level List&quot; then [Management Level]&#13;&#10;when &quot;Country List&quot; then [Country (group)]&#13;&#10;when &quot;Company Code&quot; then [Company Code]&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Leavers' datatype='integer' name='[Calculation_3296634976184086541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee ID (Leavers)])' />
      </column>
      <column caption='TRUE age' datatype='boolean' name='[Calculation_3296634976539394069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date of birth]=[birth_date]' />
      </column>
      <column caption='Data Quality' datatype='real' name='[Calculation_3296634976553668633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Age % (copy)_3296634976539131924]+[Level % (Data Quality) (copy)_3296634976544538647]+[Age % (Data Quality) (copy)_3296634976551981080]+[Age % (Data Quality) (copy)_3296634976543760406])/4'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Data Consistency' datatype='real' name='[Calculation_4612530488488697856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if AVG([Calculation_7581528549959622657])&gt;COUNT([Calculation_4612530489485946886]) then&#13;&#10;&#13;&#10;&#13;&#10;COUNT([Calculation_4612530489485946886])/AVG([Calculation_7581528549959622657])&#13;&#10;&#13;&#10;ELSE&#13;&#10;AVG([Calculation_7581528549959622657])/COUNT([Calculation_4612530489485946886])&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_4612530488494247940]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Age group buckets&#13;&#10;IF [Calculation_4612530489456680965] &lt; 30 THEN&#13;&#10;    &quot;Under 30 years old&quot;&#13;&#10;ELSEIF [Calculation_4612530489456680965] &lt;= 50 THEN&#13;&#10;    &quot;30-50 years old&quot;&#13;&#10;ELSEIF [Calculation_4612530489456680965] &gt; 50 THEN&#13;&#10;    &quot;Over 50 years old&quot;&#13;&#10;Else &quot;Others&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Others&quot;' value='Null or Others' />
        </aliases>
      </column>
      <column caption='Age (Calc)' datatype='integer' name='[Calculation_4612530489456680965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;))&#13;&#10;    - IF DATEADD(&#13;&#10;            &apos;year&apos;,&#13;&#10;            DATEDIFF(&apos;year&apos;, [Date of birth], DATE(&quot;2024-08-31&quot;)),&#13;&#10;            [Date of birth]&#13;&#10;        ) &gt; DATE(&quot;2025-08-31&quot;)&#13;&#10;      THEN 1 ELSE 0 END' />
      </column>
      <column caption='WD count' datatype='string' name='[Calculation_4612530489485946886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([Employee ID (required if using workday)]) then [Employee name]&#13;&#10;&#13;&#10;elseif (ISNULL([Employee ID (required if using workday)]) and ISNULL([Employee name])) then null&#13;&#10;else [Employee ID (required if using workday)]&#13;&#10;END' />
      </column>
      <column caption='Contract Type %' datatype='real' name='[Calculation_4612530489521795080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(IF [CSRD Contract Type]=&quot;Permanent&quot;&#13;&#10;or&#13;&#10; &#13;&#10;[CSRD Contract Type]=&quot;Temporary&quot;&#13;&#10;&#13;&#10;or CONTAINS([CSRD Contract Type],&quot;Permanent&quot;)&#13;&#10;&#13;&#10;or CONTAINS([CSRD Contract Type],&quot;Temporary&quot;)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;then [Calculation_4612530489485946886] END)/RUNNING_SUM(count([Calculation_4612530489485946886]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
