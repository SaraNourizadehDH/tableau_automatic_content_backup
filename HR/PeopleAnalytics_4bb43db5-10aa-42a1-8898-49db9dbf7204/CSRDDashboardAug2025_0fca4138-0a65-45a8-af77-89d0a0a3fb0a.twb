      <column caption='Data Completeness' datatype='real' name='[CSRD Data Completeness (copy)_2501186692703043584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Level % (copy)_4612530489523904523]+[Level % (copy)_3296634976536240144]+[Calculation_4612530489521795080]+[Gender % (copy)_4612530489523249162]+[Contract Type % (copy)_4612530489522778121]))/5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Faith Rotich' datatype='string' name='[Calculation_1485343464471920644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;https://public.tableau.com/app/profile/faith5698/viz/SuperstoreProfitAnalysis_17217401707110/Overview&quot;' />
      </column>
      <column caption='FALSE' datatype='boolean' name='[Calculation_1485343464472895493]' role='dimension' type='nominal'>
