              <calculation class='tableau' formula='IF ISNULL(ATTR([employee_id])) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) AND [Country (group)] = [office_location_co (group)] THEN [Country (group)] END )&#13;&#10;    )&#13;&#10;    /&#13;&#10;    RUNNING_SUM(&#13;&#10;        COUNT( IF NOT ISNULL([employee_id]) THEN [Country (group)] END )&#13;&#10;    )&#13;&#10;END'>
