              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8800' id='10' type-v2='text' w='70857' x='14786' y='800'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Purpose &amp; Objectives</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='margin-top' value='6' />
              <format attr='margin-bottom' value='6' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8800' id='12' type-v2='text' w='13786' x='85643' y='800'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Last Updated:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='5' />
              <format attr='margin-top' value='6' />
              <format attr='margin-right' value='0' />
              <format attr='margin-bottom' value='6' />
              <format attr='margin-left' value='0' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone h='3200' id='13' type-v2='empty' w='46218' x='3782' y='9600'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='20400' id='14' type-v2='text' w='92430' x='3782' y='12800'>
            <formatted-text>
              <run bold='true' fontsize='12'>Purpose</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>This dashboard was designed to centralise reporting for the D&amp;I team. It was created to make D&amp;I-relevant data existing in various dashboards more visible and accessible, reducing the need to duplicate reporting. </run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='54600' id='15' type-v2='text' w='92430' x='3782' y='33200'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Objectives</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>The dashboard will link users to the following topics:</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>1. Current Gender Representation</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>2. Trended Gender Representation</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>3. Current Nationality Representation</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>4. Trended Nationality Representation</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>5. Candidate Gender </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>6. Trended Candidate Gender </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>7. Candidate Nationality </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>8. Trended Candidate Nationality</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>9. Promotion Velocity by Gender</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>10. Promotion Rate by Gender</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>11. Attrition Rate by Gender </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>12. Current Gender Pay Gap </run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8600' id='24' type-v2='text' w='92430' x='3782' y='87800'>
            <formatted-text>
              <run bold='true' fontalignment='1'>Created By: Analyst Name</run>
              <run fontalignment='1'>&#10;Please direct all inquiries to the People Analytics JIRA</run>
            </formatted-text>
            <zone-style>
