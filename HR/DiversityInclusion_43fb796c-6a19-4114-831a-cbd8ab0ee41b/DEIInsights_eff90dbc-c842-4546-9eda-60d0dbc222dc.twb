    <worksheet name='Gender Breakdown by Department / Cost Center'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='worker_personal + org' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p. Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
              <calculation class='tableau' formula='&quot;Department&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='# Tenure' datatype='real' hidden='true' name='[Calculation_1066790168023658496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[time_in_company] / 12' />
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_2389370774052380679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Tenure Group' datatype='string' name='[Calculation_2389370776159227915]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1066790168023658496] &gt; 0 and [Calculation_1066790168023658496] &lt; 6 then &apos;0-6 M&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 6 and [Calculation_1066790168023658496] &lt; 12 then &apos;6-12 M&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 12 and [Calculation_1066790168023658496] &lt; 24 then &apos;1-2 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 24 and [Calculation_1066790168023658496] &lt; 36 then &apos;2-3 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 36 and [Calculation_1066790168023658496] &lt; 48 then &apos;3-4 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 48 and [Calculation_1066790168023658496] &lt; 260 then &apos;4-5 Y&apos;&#10;else &apos;+5 Y&apos;&#10;end' />
            </column>
            <column caption='c. Demension' datatype='string' name='[Calculation_2393944711203278855]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Department&quot; THEN [department]&#10;WHEN &quot;Sub-Department&quot; THEN [sub_department]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;WHEN &quot;Job Family&quot; THEN [job_family]&#10;WHEN &quot;Age Group&quot; THEN [age_group]&#10;WHEN &quot;Tenure Group&quot; THEN [Calculation_2389370776159227915]&#10;WHEN &quot;Dependant Status&quot; THEN [Dependents]&#10;WHEN &quot;Management Level Group&quot; THEN [Management Level Track]&#10;WHEN &quot;Management Level&quot; THEN [management_level]&#10;END' />
            </column>
            <column caption='Gender' datatype='string' name='[Calculation_2393944711565500428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gender] = &quot;Female&quot; THEN &quot;Women&quot;&#10;ELSEIF [gender] = &quot;Male&quot; THEN &quot;Men&quot;&#10;ELSEIF ISNULL([gender]) THEN &quot;Unknown&quot;&#10;ELSE [gender]&#10;END' />
            </column>
            <column caption='Dependants' datatype='string' name='[Dependents]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[num_dependants]' new-bin='true'>
                <bin default-name='false' value='&quot;No Dependants&quot;' />
                <bin default-name='false' value='&quot;With Dependants&quot;' />
              </calculation>
            </column>
            <column caption='Management Level Group' datatype='string' name='[Management Level Track]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
                <bin default-name='false' value='&quot;IC1 - IC2&quot;'>
                  <value>&quot;IC1&quot;</value>
                  <value>&quot;IC2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IC3 - IC6&quot;'>
                  <value>&quot;IC3&quot;</value>
                  <value>&quot;IC4&quot;</value>
                  <value>&quot;IC5&quot;</value>
                  <value>&quot;IC6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M1 - M2&quot;'>
                  <value>&quot;M1&quot;</value>
                  <value>&quot;M2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M3+&quot;'>
                  <value>&quot;E1&quot;</value>
                  <value>&quot;E2&quot;</value>
                  <value>&quot;M3&quot;</value>
                  <value>&quot;M4&quot;</value>
                  <value>&quot;M5&quot;</value>
                  <value>&quot;M6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;S&quot;'>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;20 and under&quot;' value='Under 20' />
              </aliases>
            </column>
            <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Cost Center' />
              </aliases>
            </column>
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Department' />
              </aliases>
            </column>
            <column datatype='string' name='[gender]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Undisclosed' />
                <alias key='&quot;Non-binary&quot;' value='Non-Binary' />
              </aliases>
            </column>
