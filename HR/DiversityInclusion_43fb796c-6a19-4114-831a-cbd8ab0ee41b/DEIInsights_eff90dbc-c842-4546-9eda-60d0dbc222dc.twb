      <column caption='User Filter Definition' datatype='string' name='[Calculation_2229492943259717632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;M4+&apos;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH International&quot; THEN &quot;DH International&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH People&quot; THEN &quot;DH People&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH Strategy&quot; THEN &quot;DH Strategy&quot;&#10;ELSEIF [department (il_cc_hierarchy_al)] = &quot;DH Finance&quot; THEN &quot;DH Finance&quot;&#10;ELSE &quot;Other&quot; &#10;END' />
      </column>
      <column caption='Gender ' datatype='string' name='[Calculation_2393944711123525632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gender] = &quot;Female&quot; THEN &quot;Women&quot;&#10;ELSEIF [gender] = &quot;Male&quot; THEN &quot;Men&quot;&#10;ELSEIF ISNULL([gender]) THEN &quot;Unknown&quot;&#10;ELSE [gender]&#10;END' />
      </column>
      <column caption='c. Date' datatype='boolean' name='[Calculation_2393944711180828675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_month] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='c. Date Max' datatype='date' name='[Calculation_2393944711181680644]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,TODAY()))' />
