          <datasource-dependencies datasource='federated.14jp3r01usoewg106m71r1tmxfju'>
            <column caption='Brand' datatype='string' name='[Calculation_1248763773050257412]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department (il_cc_hierarchy_al)] IN (&apos;EU Regional&apos;,&apos;Pandora&apos;) THEN &quot;Pandora DHSE&quot;&#10;ELSEIF NOT [department (il_cc_hierarchy_al)] IN (&apos;EU Regional&apos;,&apos;Pandora&apos;) THEN &quot;Central&quot;&#10;END' />
            </column>
            <column caption='Brand title' datatype='string' name='[Calculation_1248763773050363909]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([Calculation_1248763773050257412]) = MAX([Calculation_1248763773050257412]) THEN MIN([Calculation_1248763773050257412])&#10;ELSE &quot;Central + Pandora DHSE&quot;&#10;END' />
            </column>
            <column caption='Gender ' datatype='string' name='[Calculation_2393944711123525632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gender] = &quot;Female&quot; THEN &quot;Women&quot;&#10;ELSEIF [gender] = &quot;Male&quot; THEN &quot;Men&quot;&#10;ELSEIF ISNULL([gender]) THEN &quot;Unknown&quot;&#10;ELSE [gender]&#10;END' />
            </column>
            <column caption='c. Date Max' datatype='date' name='[Calculation_2393944711181680644]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='c. Date - 1 year Trend' datatype='boolean' name='[Calculation_2393944711182405637]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_month] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;AND [date_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='c. Country/Continent' datatype='string' name='[Calculation_2393944711445573641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Country&quot; THEN [nationality]&#10;WHEN &quot;Continent&quot; THEN [continent]&#10;END' />
