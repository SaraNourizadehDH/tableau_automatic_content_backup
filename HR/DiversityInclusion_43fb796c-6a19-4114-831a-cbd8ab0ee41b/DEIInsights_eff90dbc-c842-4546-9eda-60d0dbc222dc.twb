      <column caption='c. Date - 1 year Trend' datatype='boolean' name='[Calculation_2393944711182405637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_month] &gt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;AND [date_month] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='c. Country/Continent' datatype='string' name='[Calculation_2393944711445573641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Country&quot; THEN [nationality]&#10;WHEN &quot;Continent&quot; THEN [continent]&#10;END' />
