        <calculation class='tableau' formula='IF [department] IN (&apos;EU Regional&apos;,&apos;Pandora&apos;) THEN &quot;Pandora DHSE&quot;&#10;ELSEIF NOT [department] IN (&apos;EU Regional&apos;,&apos;Pandora&apos;) THEN &quot;Central&quot;&#10;END' />
      </column>
      <column caption='Brand title' datatype='string' name='[Calculation_1248763773047050243]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Calculation_1248763773046493186]) = MAX([Calculation_1248763773046493186]) THEN MIN([Calculation_1248763773046493186])&#10;ELSE &quot;Central + Pandora DHSE&quot;&#10;END' />
