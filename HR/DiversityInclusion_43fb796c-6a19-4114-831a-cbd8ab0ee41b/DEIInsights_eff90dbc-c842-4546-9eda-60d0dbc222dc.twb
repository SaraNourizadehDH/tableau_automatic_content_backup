      <column caption='Tenure Group' datatype='string' name='[Calculation_2389370776159227915]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1066790168023658496] &gt; 0 and [Calculation_1066790168023658496] &lt; 6 then &apos;0-6 M&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 6 and [Calculation_1066790168023658496] &lt; 12 then &apos;6-12 M&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 12 and [Calculation_1066790168023658496] &lt; 24 then &apos;1-2 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 24 and [Calculation_1066790168023658496] &lt; 36 then &apos;2-3 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 36 and [Calculation_1066790168023658496] &lt; 48 then &apos;3-4 Y&apos;&#10;elseif [Calculation_1066790168023658496] &gt;= 48 and [Calculation_1066790168023658496] &lt; 260 then &apos;4-5 Y&apos;&#10;else &apos;+5 Y&apos;&#10;end' />
      </column>
      <column caption='c. Demension' datatype='string' name='[Calculation_2393944711203278855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Department&quot; THEN [department]&#10;WHEN &quot;Sub-Department&quot; THEN [sub_department]&#10;WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#10;WHEN &quot;Job Family&quot; THEN [job_family]&#10;WHEN &quot;Age Group&quot; THEN [age_group]&#10;WHEN &quot;Tenure Group&quot; THEN [Calculation_2389370776159227915]&#10;WHEN &quot;Dependant Status&quot; THEN [Dependents]&#10;WHEN &quot;Management Level Group&quot; THEN [Management Level Track]&#10;WHEN &quot;Management Level&quot; THEN [management_level]&#10;END' />
