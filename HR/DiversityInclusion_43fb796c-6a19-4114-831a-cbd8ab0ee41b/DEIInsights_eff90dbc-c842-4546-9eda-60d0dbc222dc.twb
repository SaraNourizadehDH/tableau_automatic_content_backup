          <zone forceUpdate='true' h='47500' id='14' type-v2='text' w='92430' x='3782' y='12800'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='12'>Purpose</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'>This dashboard shows current and historical data on employee nationality and gender diversity in Central + Pandora DHSE (EU Regional &amp; Pandora departments).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>It currently doesn&apos;t include Lent &amp; Borrowed cases, please consider this while comparing numbers with Global dashboards.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>It serves as a single source of information for all stakeholders interested in diversity data.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Objectives</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'>This dashboard helps answer these common questions:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of employees are women at each management level and career track?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of employees are women in each department?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of employees are women by job family group and job family?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of employees are women in each tenure group?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of employees are women in each age group?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - What percentage of female employees have dependents?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'> - How has female representation changed over time?</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
