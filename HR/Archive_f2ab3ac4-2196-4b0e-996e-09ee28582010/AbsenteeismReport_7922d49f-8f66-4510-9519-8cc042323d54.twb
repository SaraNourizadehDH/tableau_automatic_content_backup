                    <run>Æ&#10;</run>
                    <run fontsize='12'>Holidays / (Total Number of Employees * Work Days )</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#d61f26' fontsize='12' italic='true'># Engagement Score </run>
