      <aliases enabled='yes' />
      <column caption='Absence Rate (Sickness)' datatype='real' name='[Calculation_249949803498745859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sick_days])/(sum(actual)*5)' />
      </column>
      <column caption='% Employees reporting sick' datatype='real' name='[Calculation_5929622252566691840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sick_employee])/sum([actual])' />
      </column>
      <column caption='% Employees reporting sick child' datatype='real' name='[Calculation_5929622252569100289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sick_child])/sum(actual)' />
      </column>
      <column caption='Absence Rate (Holidays)' datatype='real' name='[Calculation_5929622252576690178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([holidays])/(sum([actual])*5)' />
      </column>
