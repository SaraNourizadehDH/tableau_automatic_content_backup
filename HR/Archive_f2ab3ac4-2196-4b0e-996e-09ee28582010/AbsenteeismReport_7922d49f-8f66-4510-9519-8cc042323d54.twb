            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8800' id='10' type-v2='text' w='69214' x='14786' y='800'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Purpose &amp; Definition</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='margin-top' value='6' />
              <format attr='margin-bottom' value='6' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8800' id='12' type-v2='text' w='8536' x='84000' y='800'>
            <formatted-text>
              <run bold='true' fontalignment='2' fontcolor='#ffffff' fontsize='12'>Last Updated:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='5' />
              <format attr='margin-top' value='6' />
              <format attr='margin-right' value='0' />
              <format attr='margin-bottom' value='6' />
              <format attr='margin-left' value='0' />
              <format attr='background-color' value='#d61f26' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='11900' id='14' type-v2='text' w='92430' x='3782' y='9600'>
            <formatted-text>
              <run bold='true' fontsize='12'>Purpose</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>This dashboard is designed to monitor employee absenteeism due to sick, sick child and vacation reasons. It also shows how it changes over time and whether there is a correlation between absenteeism and different metrics such as engagement, attrition, and performance.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='68800' id='15' type-v2='text' w='92430' x='3782' y='21500'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Definition</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Employees reporting sick / sick child</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of unique employees who report sick or sick child</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Sick Days</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of approved days requested by employees to report sick / sick child</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Absence Rate (Sickness) (%)</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Sick Days / (Total Number of Employees * Work Days )</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># % Employees reporting sick </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of unique employees who report sick  / (Total Number of Employees )</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># % Employees reporting sick  child </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of unique employees who report sick child / (Total Number of Employees )</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Holidays</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of approved days requested by employees for vacation</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Absence Rate (Holidays) (%) </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Holidays / (Total Number of Employees * Work Days )</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Engagement Score </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>(AVG) Peakon Score given by employees from 1 to 10</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Attrition</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Number of Terminations Initiated \ Total Number of Employees</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Performance Ratings </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>(AVG) Performance rating given by managers for each employee from 1 to 5</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='6100' id='24' type-v2='text' w='92430' x='3782' y='90300'>
            <formatted-text>
              <run bold='true' fontalignment='1'>Created By: Esra Yener</run>
