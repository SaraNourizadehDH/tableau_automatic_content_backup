    <dashboard name='Purpose / Definition'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/AbsenteeismReport_16663679834470/PurposeDefinition?rev=' id='PurposeDefinition' path='/t/HR/workbooks/AbsenteeismReport_16663679834470' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='2800' id='5' type-v2='empty' w='92430' x='3782' y='96400'>
            <zone-style>
              <format attr='border-color' value='#000000' />
