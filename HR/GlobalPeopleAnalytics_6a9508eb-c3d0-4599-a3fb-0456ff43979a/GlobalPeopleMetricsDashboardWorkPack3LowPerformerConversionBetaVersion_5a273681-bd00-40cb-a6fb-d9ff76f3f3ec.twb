                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='476' forceUpdate='true' h='28471' id='2015' is-fixed='true' type-v2='text' w='71667' x='5733' y='9355'>
                        <formatted-text>
                          <run bold='true' fontcolor='#4629ff' fontsize='12'>Overview</run>
                          <run>Æ&#10;&#10;</run>
                          <run fontcolor='#000000' fontsize='11'>This dashboard is designed to standardize the tracking and reporting of low performer outcomes. Specifically </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Conversions</run>
                          <run fontcolor='#000000' fontsize='11'>, </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Continued Underperformance</run>
                          <run fontcolor='#000000' fontsize='11'>, </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Cases with No Current Ratings</run>
                          <run fontcolor='#000000' fontsize='11'>, and </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Exits.</run>
                          <run fontcolor='#000000' fontsize='11'> This initiative contributes to building a high-performance culture.</run>
                          <run>Æ&#10;&#10;</run>
                          <run bold='true' fontcolor='#4629ff' fontsize='12'>Data Source Description</run>
                          <run>Æ&#10;&#10;</run>
                          <run fontcolor='#000000' fontsize='11'>This dashboard primarily utilizes </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Workday </run>
                          <run fontcolor='#000000' fontsize='11'>and it is refreshed daily to ensure the dashboard reflects the latest available data in the system.</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='11'>The dataset is filtered to only</run>
                          <run bold='true' fontcolor='#4629ff' fontsize='11'>Æ </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>DH SE Central</run>
                          <run fontcolor='#000000' fontsize='11'> employees.</run>
                          <run>Æ&#10;&#10;</run>
                          <run bold='true' fontcolor='#4629ff' fontsize='12'>Metrics Definitions</run>
                          <run>Æ&#10;&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Low Performer Headcount</run>
                          <run fontcolor='#000000' fontsize='11'>: Represents the employees who were marked as low performers based on the following classification:</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#ed2e2e' fontname='Tableau Bold' fontsize='8'>→ </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>EOY Low Performers: </run>
                          <run fontcolor='#000000' fontsize='11'>Employees who received an EOY Rating of </run>
                          <run bold='true' fontcolor='#c53530' fontsize='11'>Development Needed</run>
                          <run fontcolor='#c53530' fontsize='11'>Æ </run>
                          <run fontcolor='#000000' fontsize='11'>or </run>
                          <run bold='true' fontcolor='#c53530' fontsize='11'>Unsatisfactory</run>
                          <run fontcolor='#000000' fontsize='11'>.</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#ed2e2e' fontname='Tableau Bold' fontsize='8'>→ </run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>MOY NEW Low Performers: </run>
                          <run fontcolor='#000000' fontsize='11'>Employees who received an EOY Rating of </run>
                          <run bold='true' fontcolor='#4629ff' fontsize='11'>Outstanding</run>
                          <run fontcolor='#000000' fontsize='11'>, </run>
                          <run bold='true' fontcolor='#4629ff' fontsize='11'>Exceeding</run>
                          <run fontcolor='#000000' fontsize='11'>, or </run>
                          <run bold='true' fontcolor='#4629ff' fontsize='11'>Performing</run>
                          <run fontcolor='#000000' fontsize='11'> but had a Mid-Year Rating of </run>
                          <run bold='true' fontcolor='#c53530' fontsize='11'>Off Track</run>
                          <run fontcolor='#000000' fontsize='11'>.</run>
                          <run>Æ&#10;&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='11'>Low Performers Leavers: </run>
                          <run fontcolor='#000000' fontsize='11'>Employees who have exited the organization, either through Voluntary or Involuntary Termination based from </run>
                          <run bold='true' fontcolor='#4629ff' fontsize='11'>Termination Initiated Date.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='16' />
                        </zone-style>
                      </zone>
