      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:eoy_lp_total_low_performers:qk]&quot;' value='EOY Low Performers' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:lp_leaver_e_eoy:qk]&quot;' value='EOY Low Performers ' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:lp_leaver_new_moy:qk]&quot;' value='MOY NEW Low Performers ' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:lp_retained_e_eoy:qk]&quot;' value='EOY Low Performers  ' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:lp_retained_new_moy:qk]&quot;' value='MOY NEW Low Perfomers  ' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:moy_lp_total_low_performers:qk]&quot;' value='MOY NEW Low Performers' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:total_lp_leavers_agg:qk]&quot;' value='Leavers (Cummulative)' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:total_lp_leavers_month:qk]&quot;' value='Leavers (Month)' />
          <alias key='&quot;[federated.12e303p1kinz6p14y04f302hkuz3].[sum:total_lp_retained_agg:qk]&quot;' value='Retained' />
        </aliases>
      </column>
      <column caption='c.LP Converted' datatype='integer' name='[Calculation_1073404858291937291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [c.Bool (report month = month) (copy)_1073404858290147334] = TRUE THEN&#10;    [lp_converted_e_moy]&#10;ELSEIF [c.Bool (&lt;= 7) (copy)_1073404858290581511] = TRUE THEN&#10;    [lp_converted_combined_eoy]&#10;END' />
      </column>
      <column caption='c.Date - EOY Cycle Parameter (Current Value)' datatype='date' name='[Calculation_1517924224843759616]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([review_year]) }' />
      </column>
      <column caption='c.Bool (EOY Date = Param)' datatype='boolean' name='[Calculation_1534671961062162434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[review_year] = [Parameters].[Parameter 6]' />
      </column>
      <column caption='c.management_level (sort)' datatype='string' name='[Calculation_1534671961100619802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [management_level]&#10;    WHEN &apos;E2&apos; THEN &apos;a. E2&apos;&#10;    WHEN &apos;E1&apos; THEN &apos;b. E1&apos;&#10;    WHEN &apos;M6&apos; THEN &apos;c. M6&apos;&#10;    WHEN &apos;M5&apos; THEN &apos;d. M5&apos;&#10;    WHEN &apos;M4&apos; THEN &apos;e. M4&apos;&#10;    WHEN &apos;M3&apos; THEN &apos;f. M3&apos;&#10;    WHEN &apos;M2&apos; THEN &apos;h. M2&apos;&#10;    WHEN &apos;M1&apos; THEN &apos;i. M1&apos;&#10;    WHEN &apos;IC6&apos; THEN &apos;j. IC6&apos;&#10;    WHEN &apos;IC5&apos; THEN &apos;k. IC5&apos;&#10;    WHEN &apos;IC4&apos; THEN &apos;l. IC4&apos;&#10;    WHEN &apos;IC3&apos; THEN &apos;m. IC3&apos;&#10;    WHEN &apos;IC2&apos; THEN &apos;n. IC2&apos;&#10;    WHEN &apos;IC1&apos; THEN &apos;o. IC1&apos;&#10;    WHEN &apos;S4&apos; THEN &apos;p. S4&apos;&#10;    WHEN &apos;S3&apos; THEN &apos;q. S3&apos;&#10;    WHEN &apos;S2&apos; THEN &apos;r. S2&apos;&#10;    WHEN &apos;S1&apos; THEN &apos;s. S1&apos;&#10;    ELSE &apos;z. null&apos;&#10;END' />
      </column>
      <column caption='c.Select Dimension (Sorter)' datatype='integer' name='[Calculation_1534671961100906523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[p.Org Layers - Select Dimension (copy)_2382685732438695981] IN (&#10;    &apos;Management Level&apos;&#10;) &#10;THEN 0&#10;//ELSE RANK_UNIQUE(SUM([total_prev_low_performer]), &apos;desc&apos;)&#10;ELSE SUM([c.LP Total Headcount (copy)_1534671961102250013])&#10;END' />
      </column>
      <column caption='c.Termination Effective Date' datatype='string' datatype-customized='true' name='[Calculation_1534671961434710054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [termination_effective_date]), 3) &#10;+ &quot; &quot; + &#10;RIGHT(&quot;00&quot; + STR(DATEPART(&apos;day&apos;, [termination_effective_date])), 2) &#10;+ &quot;, &quot; + &#10;STR(DATEPART(&apos;year&apos;, [termination_effective_date]))' />
      </column>
      <column caption='c.Employee Sub-Category' datatype='string' name='[Calculation_3148438366376611853]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [c.Bool (report month = month) (copy)_1073404858290147334] = TRUE THEN&#10;    IF [lp_converted_e_moy] = 1 THEN &apos;LP Converted&apos;&#10;    ELSEIF [lp_continued_e_moy] = 1 THEN &apos;LP Continued&apos;&#10;    ELSEIF [lp_no_rating_e_moy] = 1 THEN &apos;LP No Rating&apos;&#10;    ELSE &apos;&apos;&#10;    END&#10;ELSEIF [c.Bool (&lt;= 7) (copy)_1073404858290581511] = TRUE THEN&#10;    IF [lp_converted_combined_eoy] = 1 THEN &apos;LP Converted&apos;&#10;    ELSEIF [lp_continued_combined_eoy] = 1 THEN &apos;LP Continued&apos;&#10;    ELSEIF [lp_no_rating_combined_eoy] = 1 THEN &apos;LP No Rating&apos;&#10;    ELSE &apos;&apos;&#10;    END&#10;END' />
        <aliases>
          <alias key='&quot;LP Continued&quot;' value='Continued' />
          <alias key='&quot;LP Converted&quot;' value='Converted' />
          <alias key='&quot;LP Leaver&quot;' value='Leaver' />
          <alias key='&quot;LP New&quot;' value='MOY New' />
          <alias key='&quot;LP No Rating&quot;' value='No Rating' />
        </aliases>
      </column>
      <column caption='u.User Filter (Worksheet level)' datatype='string' name='[Calculation_386817022002638856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//[u.User Filter (Data Source level)]&#10;&#10;// APPLIED ON THE DATA SOURCE FILTERS&#10;&#10;STR(&#10;    IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;    &#10;    ELSEIF [department] = &apos;DH People &amp; Culture&apos; THEN&#10;        //IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;        IF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1&#10;        ELSEIF USERNAME()=(&apos;natalia.cosa@deliveryhero.com&apos;) THEN 1&#10;        END&#10;    ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN 1&#10;    ELSE&#10;        0&#10;    END&#10;)' />
      </column>
      <column caption='c.Date (Today)' datatype='date' name='[Calculation_5179632181540282377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='c.Select Dimension (Bars - Select)' datatype='string' name='[Calculation_5720415998002348032 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p.Org Layers - Select Dimension (copy)_2382685732438695981]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#13;&#10;    WHEN &quot;Management Level&quot; then [Calculation_1534671961100619802]&#13;&#10;    WHEN &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Department&quot; then [department]//[c.Filter - Department (cleaned)]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;    WHEN &quot;Region&quot; then [region]&#10;    WHEN &quot;Job Family Group&quot; then [job_family_group]&#10;    WHEN &quot;Job Family&quot; then [job_family]&#10;    WHEN &quot;Company Name&quot; then [company_name]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
          <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
          <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
          <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
          <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
          <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
          <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
        </aliases>
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_E54F0FC5861F4FC8A364DCB7693E2269]' role='measure' type='quantitative' />
      <column datatype='string' name='[brand]' role='dimension' type='nominal' />
      <column caption='c.% LP No Rating' datatype='real' default-format='p0%' name='[c.% LP Continued (copy)_1073404858296234006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([c.LP Converted (copy)_1073404858293039119]) / SUM([total_lp_retained_agg])' />
      </column>
      <column caption='c.% LP MOY New' datatype='real' default-format='p0%' name='[c.% LP Converted (copy)_1073404858295943188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([lp_new_e_moy]) / SUM(total_lp_retained_agg)&#10;SUM([total_lp_new_moy_agg]) / SUM([total_low_performers])' />
      </column>
      <column caption='c.% LP Continued' datatype='real' default-format='p0%' name='[c.% LP Converted (copy)_1073404858296053781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([c.LP Converted (copy)_1073404858292690957]) / SUM([total_lp_retained_agg])' />
      </column>
      <column caption='c.% LP Converted' datatype='real' default-format='p0%' name='[c.% LP Retained (copy)_1073404858295791635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1073404858291937291]) / SUM([total_lp_retained_agg])' />
