      </column>
      <column caption='c.LP Continued' datatype='integer' name='[c.LP Converted (copy)_1073404858292690957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [c.Bool (report month = month) (copy)_1073404858290147334] = TRUE THEN&#10;    [lp_continued_e_moy]&#10;ELSEIF [c.Bool (&lt;= 7) (copy)_1073404858290581511] = TRUE THEN&#10;    [lp_continued_combined_eoy]&#10;END' />
