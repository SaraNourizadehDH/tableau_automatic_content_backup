      <column caption='c.Employee Category' datatype='string' name='[c.Employee Category (copy)_1073404858301612055]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_lp_retained_agg] = 1 THEN &apos;Retained&apos;&#10;ELSEIF [total_lp_leavers_agg] = 1 THEN &apos;Leaver&apos;&#10;ELSEIF [total_lp_new_moy_agg] = 1 THEN &apos;New Low Performer&apos;&#10;END' />
        <aliases>
          <alias key='&quot;LP Continued&quot;' value='Continued' />
          <alias key='&quot;LP Converted&quot;' value='Converted' />
