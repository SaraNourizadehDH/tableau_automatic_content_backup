              <aliases>
                <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
                <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
                <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
                <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
                <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
                <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
                <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
              </aliases>
            </column>
            <column-instance column='[c.p1_review_date (copy)_1965680522085937154]' derivation='Attribute' name='[attr:c.p1_review_date (copy)_1965680522085937154:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='c.LP - Continued %' datatype='real' default-format='p0%' name='[c.LP - Converted % (copy)_3148438366363443202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*SUM(IF [c.Employee Category] = &apos;LP Continued&apos; THEN 1 END) &#10;/ &#10;SUM([total_prev_low_performer])&#10;*/&#10;&#10;&#10;SUM([continued_low_performer]) &#10;/ &#10;SUM([total_eoy_low_performer])' />
            </column>
