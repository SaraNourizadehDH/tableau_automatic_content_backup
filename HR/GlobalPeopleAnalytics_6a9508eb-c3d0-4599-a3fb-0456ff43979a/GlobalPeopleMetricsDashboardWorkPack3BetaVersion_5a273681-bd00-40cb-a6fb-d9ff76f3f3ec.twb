            <column datatype='integer' name='[converted_low_performer]' role='measure' type='quantitative' />
            <column datatype='string' name='[department]' role='dimension' type='nominal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[job_family]' role='dimension' type='nominal' />
            <column datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
            <column datatype='integer' name='[low_perfomer_termination]' role='measure' type='quantitative' />
            <column datatype='integer' name='[low_performer_no_current_rating]' role='measure' type='quantitative' />
