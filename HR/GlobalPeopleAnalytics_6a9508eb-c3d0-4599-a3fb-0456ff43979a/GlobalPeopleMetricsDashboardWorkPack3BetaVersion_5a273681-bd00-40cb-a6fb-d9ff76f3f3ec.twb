            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='c.p2_review_date' datatype='date' datatype-customized='true' default-format='*MMM YYYY' name='[c.p1_review_date (-12 months) (copy)_1007328594690928642]' role='dimension' type='ordinal'>
