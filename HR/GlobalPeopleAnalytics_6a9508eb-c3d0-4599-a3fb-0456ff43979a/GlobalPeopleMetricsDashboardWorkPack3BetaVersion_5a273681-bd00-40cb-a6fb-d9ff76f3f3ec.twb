            <column datatype='string' name='[manager_03_full_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1534671961062162434]' derivation='None' name='[none:Calculation_1534671961062162434:nk]' pivot='key' type='nominal' />
