      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0mz79pt1b93jzd11j2iam0rf6dh9].[usr:c.LP - Continued \% (copy)_3148438366363529219:qk]&quot;' value='Low Performers Leavers %' />
