            </column>
            <column caption='Management Level' datatype='string' name='[Calculation_1534671961086574607]' role='dimension' type='nominal' user:unnamed='1) LP - (Table - Employee List)'>
              <calculation class='tableau' formula='//Management Level&#10;[management_level]' />
            </column>
            <column caption='Employee ID' datatype='string' name='[Calculation_1534671961086607376]' role='dimension' type='nominal' user:unnamed='1) LP - (Table - Employee List)'>
              <calculation class='tableau' formula='//Employee ID&#10;[employee_id]' />
            </column>
