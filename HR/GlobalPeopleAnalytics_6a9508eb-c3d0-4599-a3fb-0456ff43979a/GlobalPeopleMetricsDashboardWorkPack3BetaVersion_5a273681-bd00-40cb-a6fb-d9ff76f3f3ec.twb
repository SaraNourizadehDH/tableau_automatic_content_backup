      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_574944E78FEC416CBE3994545839D5F8'>
            <properties context=''>
              <relation connection='athena.1lw4zat0ajb45y1a6jtjm0ltvlku' name='Custom SQL Query' type='text'>WITH performance AS (
	SELECT
		p.*
	FROM people_ops_proposed.il_performance p
	-- Uses worker_hist to track employees&apos; past cost center assignments.
	LEFT JOIN people_ops_proposed.il_worker_hist_with_current wh 
		ON p.employee_id = wh.employee_id 
		AND DATE(p.review_date) = DATE_ADD(&apos;day&apos;, 1, DATE(wh.report_effective_date))
	LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha 
		ON wh.cost_center_id = cha.cost_center_id
	WHERE 
		p.bp_status = &apos;Successfully Completed&apos;
		AND p.company_id = &apos;1001&apos;
		AND LOWER(cha.department) NOT IN (&apos;eu regional&apos;, &apos;pandora&apos;)
		AND (DATE(p.review_date)) &gt;&gt; DATE &apos;2022-06-01&apos;
),

-- Limitation: Only gets the latest termination date
termination AS (
	SELECT
		DATE(MAX(termination_effective_date)) AS termination_effective_date,
		employee_id
	FROM people_ops_proposed.il_termination
	WHERE status = &apos;Successfully Completed&apos;
	AND company_id = &apos;1001&apos;
	GROUP BY 2
),

review_dates AS (
    SELECT DISTINCT
        DATE(p.review_date) AS p1_review_date,
        DATE_ADD(&apos;month&apos;, 6, DATE(p.review_date)) AS p2_review_date -- gets next performance review cycle
    FROM performance p
),

base AS (
    SELECT
    	p1.employee_id,
    	rd.p1_review_date AS p1_review_date,
        p1.manager_rating_explained AS p1_manager_rating,
        
        rd.p2_review_date AS p2_review_date,
        p2.manager_rating_explained AS p2_manager_rating,
        
		p1.review_template_id AS p1_review_template_id,
        p2.review_template_id AS p2_review_template_id,
        
        t.termination_effective_date,
        wh.is_terminated
        
    FROM review_dates rd
    LEFT JOIN performance p1
    	ON DATE(p1.review_date) = rd.p1_review_date
    LEFT JOIN performance p2
        ON p1.employee_id = p2.employee_id
        AND DATE(p2.review_date) = rd.p2_review_date
    LEFT JOIN termination t
    	ON p1.employee_id = t.employee_id
    LEFT JOIN people_ops_proposed.il_worker_hist_with_current wh
    	ON p1.employee_id = wh.employee_id
    	AND DATE_TRUNC(&apos;month&apos;, DATE(rd.p1_review_date)) = DATE_TRUNC(&apos;month&apos;, DATE(wh.report_effective_date))
),

-- Limitation: For Leavers, only those within the EOY time frame will be counted as leavers. Future terminations will fall under low performer with no current rating.
metrics AS (
	SELECT
		DATE_ADD(&apos;day&apos;, -1, DATE(p1_review_date)) AS p1_review_date_EOY,
	    p1_review_date,
	    p2_review_date,
	    employee_id,
	    p1_manager_rating,
	    p2_manager_rating,
	    termination_effective_date,
	        
	    -- Total low performers from EOY cycle
	    CASE
	    	WHEN p1_manager_rating IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;) THEN 1 ELSE 0
	    END AS total_eoy_low_performer,
		
	    -- Continued: Low performer in both EOY and MOY cycle
	    CASE 
	        WHEN p1_manager_rating IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;) AND p2_manager_rating IN (&apos;Off Track&apos;) 
	        THEN 1 ELSE 0 
	    END AS continued_low_performer,
	
	    -- Converted: previously low, now On Track
	    CASE 
	        WHEN p1_manager_rating IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;) AND p2_manager_rating IN (&apos;On Track&apos;) 
	        THEN 1 ELSE 0 
	    END AS converted_low_performer,
	   
		-- Leavers: Low Performers but has no MOY rating due to termination
	    CASE 
	        WHEN p1_manager_rating IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;) AND p2_manager_rating IS NULL 
	        THEN 
	        	-- Checks if an employee left during the EOY cycle (e.g. For Jan 2024 cycle, time frame would be Oct 2024 to July 2025).
	        	-- Future terminations
	        	CASE
	        		WHEN DATE_TRUNC(&apos;month&apos;, DATE(termination_effective_date)) BETWEEN DATE_TRUNC(&apos;month&apos;, DATE_ADD(&apos;month&apos;, -3, DATE(p1_review_date))) AND DATE_TRUNC(&apos;month&apos;, DATE(p2_review_date)) THEN 1
	        		ELSE 0
	        	END
	    END AS low_perfomer_termination,
	    
	    -- Low Performer but has no MOY ratings
	    CASE 
	        WHEN p1_manager_rating IN (&apos;Development Needed&apos;, &apos;Unsatisfactory&apos;) AND p2_manager_rating IS NULL 
	        THEN 
	        	-- Checks if the employee is still active with no MOY rating,
				-- or if they’re terminated after the EOY cycle (future termination)
	       		-- Low Performer but re-hire cases
	        	CASE
	        		WHEN termination_effective_date IS NULL 
	        		OR DATE(termination_effective_date) &gt;&gt; DATE(p1_review_date) 
	        		OR is_terminated = 0
	        		THEN 1 
	        		ELSE 0
	        	END
	    END AS low_performer_no_current_rating

	FROM base
)

SELECT
	m.*,
    CASE
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) IN (&apos;eu regional&apos;, &apos;pandora&apos;) THEN &apos;Pandora&apos;
		ELSE cm.brand
	END AS brand,
    CASE
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) IN (&apos;eu regional&apos;, &apos;pandora&apos;) THEN &apos;Europe&apos; 
		ELSE cm.region
	END AS region,
    cm.company_name,
    wh.worker_type,
    wh.contract_type,
    wh.job_family_group,
    wh.job_family,
    CASE
		WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit_hierarchy, 8)
	    WHEN wh.company_id = &apos;1001&apos; THEN cha.department
	    ELSE wh.department_wd
	END AS department,
	CASE
		WHEN cm.brand = &apos;Glovo&apos; THEN substr(wh.business_unit, 8)
		WHEN LOWER(
			REGEXP_REPLACE(
				COALESCE(cha.sub_department, wh.sub_department_wd),
				&apos;\\s+&apos;,
				&apos; &apos;
			)
		) LIKE &apos;%ops%store%operations%&apos; THEN &apos;Ops Store Operations&apos;
		ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
	END AS sub_department,
    wh.management_level,
    CONCAT(wp.first_name, &apos; &apos;, wp.last_name) AS employee_name,
    wp.gender,
    wh.first_day_of_work,
    wh.last_day_of_work,
    mh.managed_by,
	mh.managed_by_full_name,
	mh.manager_id_01,
	mh.manager_01_full_name,
	mh.manager_id_02,
	mh.manager_02_full_name,
	mh.manager_id_03,
	mh.manager_03_full_name,
	mh.manager_id_04,
	mh.manager_04_full_name,
	mh.manager_id_05,
	mh.manager_05_full_name,
	mh.manager_id_06,
	mh.manager_06_full_name,
	mh.manager_id_07,
	mh.manager_07_full_name
FROM metrics m
LEFT JOIN people_ops_proposed.il_worker_hist_with_current wh
	ON m.employee_id = wh.employee_id
	AND DATE(m.p1_review_date) = DATE_ADD(&apos;day&apos;, 1, DATE(wh.report_effective_date))
LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh 
	ON mh.employee_id = wh.employee_id 
    AND DATE_TRUNC(&apos;month&apos;, DATE(wh.report_effective_date)) = DATE_TRUNC(&apos;month&apos;, DATE(mh.report_effective_date))
LEFT JOIN people_ops_proposed.il_company_mapping cm 
	ON wh.company_id = cm.company_id
LEFT JOIN people_ops_proposed.il_worker_personal wp
	ON wh.employee_id = wp.employee_id 
LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha 
	ON wh.cost_center_id = cha.cost_center_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
