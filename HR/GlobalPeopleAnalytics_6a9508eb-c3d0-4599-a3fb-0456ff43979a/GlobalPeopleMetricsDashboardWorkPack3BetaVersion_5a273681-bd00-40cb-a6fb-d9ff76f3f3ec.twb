              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mz79pt1b93jzd11j2iam0rf6dh9'>
            <column caption='c.Date (Date = Param)' datatype='boolean' name='[Calculation_1534671961062162434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[p1_review_date_EOY] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='c.management_level (sort)' datatype='string' name='[Calculation_1534671961100619802]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_level]&#10;    WHEN &apos;E2&apos; THEN &apos;a. E2&apos;&#10;    WHEN &apos;E1&apos; THEN &apos;b. E1&apos;&#10;    WHEN &apos;M6&apos; THEN &apos;c. M6&apos;&#10;    WHEN &apos;M5&apos; THEN &apos;d. M5&apos;&#10;    WHEN &apos;M4&apos; THEN &apos;e. M4&apos;&#10;    WHEN &apos;M3&apos; THEN &apos;f. M3&apos;&#10;    WHEN &apos;M2&apos; THEN &apos;h. M2&apos;&#10;    WHEN &apos;M1&apos; THEN &apos;i. M1&apos;&#10;    WHEN &apos;IC6&apos; THEN &apos;j. IC6&apos;&#10;    WHEN &apos;IC5&apos; THEN &apos;k. IC5&apos;&#10;    WHEN &apos;IC4&apos; THEN &apos;l. IC4&apos;&#10;    WHEN &apos;IC3&apos; THEN &apos;m. IC3&apos;&#10;    WHEN &apos;IC2&apos; THEN &apos;n. IC2&apos;&#10;    WHEN &apos;IC1&apos; THEN &apos;o. IC1&apos;&#10;    WHEN &apos;S4&apos; THEN &apos;p. S4&apos;&#10;    WHEN &apos;S3&apos; THEN &apos;q. S3&apos;&#10;    WHEN &apos;S2&apos; THEN &apos;r. S2&apos;&#10;    WHEN &apos;S1&apos; THEN &apos;s. S1&apos;&#10;    ELSE &apos;z. null&apos;&#10;END' />
            </column>
            <column caption='c.Select Dimension (Sorter)' datatype='integer' name='[Calculation_1534671961100906523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[p.Org Layers - Select Dimension (copy)_2382685732438695981] IN (&#10;    &apos;Management Level&apos;&#10;) THEN 0&#10;//ELSE RANK_UNIQUE(SUM([total_prev_low_performer]), &apos;desc&apos;)&#10;ELSE [c.LP Total Headcount (copy)_1534671961102250013]&#10;END)' />
            </column>
            <column caption='c.Employee Category' datatype='string' name='[Calculation_3148438366376611853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [converted_low_performer] = 1 THEN &apos;LP Converted&apos;&#10;ELSEIF [continued_low_performer] = 1 THEN &apos;LP Continued&apos;&#10;ELSEIF [low_perfomer_termination] = 1 THEN &apos;LP Leaver&apos;&#10;ELSEIF [low_performer_no_current_rating] = 1 THEN &apos;LP No Current Rating&apos;&#10;ELSE &apos;&apos;&#10;END' />
              <aliases>
                <alias key='&quot;LP Continued&quot;' value='Continued' />
                <alias key='&quot;LP Converted&quot;' value='Converted' />
                <alias key='&quot;LP Leaver&quot;' value='Leaver' />
                <alias key='&quot;LP No Current Rating&quot;' value='No Rating' />
              </aliases>
            </column>
            <column caption='c.Select Dimension (Bars - Select)' datatype='string' name='[Calculation_5720415998002348032 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[p.Org Layers - Select Dimension (copy)_2382685732438695981]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#13;&#10;    WHEN &quot;Management Level&quot; then [Calculation_1534671961100619802]&#13;&#10;    WHEN &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Department&quot; then [department]//[c.Filter - Department (cleaned)]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [sub_department]&#13;&#10;    WHEN &quot;Region&quot; then [region]&#10;    WHEN &quot;Job Family Group&quot; then [job_family_group]&#10;    WHEN &quot;Job Family&quot; then [job_family]&#10;    WHEN &quot;Company Name&quot; then [company_name]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;a) &lt; 90 days&quot;' value='&lt; 3 months' />
                <alias key='&quot;b) &lt; 6 months&quot;' value='3 to 6 months' />
                <alias key='&quot;c) &lt; 1 year&quot;' value='6 months to 1 year' />
                <alias key='&quot;d) &lt; 2 years&quot;' value='1 to 2 years' />
                <alias key='&quot;e) &lt; 3 years&quot;' value='2 to 3 years' />
                <alias key='&quot;f) &lt; 4 years&quot;' value='3 to 4 years' />
                <alias key='&quot;g) above&quot;' value='&gt; 4 years' />
              </aliases>
            </column>
