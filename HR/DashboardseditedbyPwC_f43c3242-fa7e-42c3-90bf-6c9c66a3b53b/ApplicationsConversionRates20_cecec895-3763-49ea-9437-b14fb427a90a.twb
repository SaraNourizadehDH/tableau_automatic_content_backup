    <worksheet name='ICR_Offer_to_Hire'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Offer to Hire</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_rates_process_funnel (new)' name='federated.187tyif0wilrad1f3ybje0mx6qyw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Hiring Process Type Parameter' datatype='string' name='[Hiring Process Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
            <column caption='# in Hire' datatype='integer' name='[# in Offer (copy)_1564930555954049034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Hire&quot; THEN [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
            </column>
            <column caption='Brand ' datatype='string' name='[Calculation_3163567633409904640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand]&#10;END' />
            </column>
            <column caption='Candidate Job Key' datatype='string' name='[Calculation_4674103099138371584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[candidate_id] + &apos;-&apos; + [job_ref_id]&#10;// [Candidate Id]' />
            </column>
            <column caption='Hiring Process Type - parameter view' datatype='boolean' name='[Calculation_4674103099466072099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Hiring Process Type Parameter] = &apos;All&apos; THEN&#10;    IF [hiring_process_type] = [hiring_process_type] THEN TRUE&#10;    ELSE FALSE&#10;END&#10;&#10;ELSEIF [Parameters].[Hiring Process Type Parameter] != &apos;All&apos; THEN&#10;    [hiring_process_type]=[Parameters].[Hiring Process Type Parameter]&#10;END' />
            </column>
            <column caption='# in Offer' datatype='integer' name='[Count Candidates in First Event Type (copy)_1564930555940028423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Offer&quot; THEN [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='ICR_Offer_Hire' datatype='real' default-format='p0.0%' name='[ICR_First_Event_to_Offer (copy)_1564930555940061193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# in Offer (copy)_1564930555954049034]/[Count Candidates in First Event Type (copy)_1564930555940028423]' />
            </column>
            <column caption='Is_Interview_Step_Required' datatype='boolean' name='[Interview Standard Order_1 (copy)_2719048328949899266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [event_type]&#10;WHEN &quot;TA Interview&quot; THEN &#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Contingent Worker (CW)&quot;, &#10;                 &quot;Contingent Worker (CW)&quot;, &quot;D-Marts&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;HM Call&quot; THEN FALSE&#10;WHEN &quot;HM Interview&quot; THEN &#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Contingent Worker (CW)&quot;, &#10;                 &quot;Contingent Worker (CW)&quot;, &quot;D-Marts&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Group/Panel Interview&quot; THEN FALSE&#10;WHEN &quot;Pre-HM Assessment&quot; THEN FALSE&#10;WHEN &quot;Functional/Technical Interview&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&quot;Non-Tech (All Levels)&quot;,&#10;                &quot;Product IC3 - IC6&quot;, &quot;(DHSE ONLY) Product IC3 - IC6&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Cross Entity Leveling Interview&quot; THEN TRUE&#10;WHEN &quot;Bar Raiser Interview&quot; THEN TRUE&#10;WHEN &quot;Assessment&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&quot;Non-Tech (All Levels)&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Final Interview&quot; THEN FALSE&#10;WHEN &quot;Team Interview&quot; THEN FALSE&#10;WHEN &quot;Leadership Interview&quot; THEN TRUE&#10;WHEN &quot;SH/Business Interview&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&#10;                 &quot;Non-Tech (All Levels)&quot;, &quot;Executive Search M4+&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Offer&quot; THEN TRUE&#10;WHEN &quot;Hire&quot; THEN TRUE&#10;ELSE FALSE&#10;END' />
              <aliases>
                <alias key='false' value='Only Optional Interviews' />
                <alias key='true' value='Only Required Interviews' />
              </aliases>
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[candidate_id]' role='dimension' type='nominal' />
