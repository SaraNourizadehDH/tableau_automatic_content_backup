      <column caption='Dimension to Display' datatype='string' name='[Calculation_1277896432391098371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Country&quot; THEN [job_country]&#10;    WHEN &quot;Company&quot; THEN [company]&#13;&#10;    WHEN &quot;Department&quot; THEN [department]&#13;&#10;    WHEN &quot;Sub Department&quot; THEN [sub_department]&#13;&#10;    WHEN &quot;Cost Center&quot; THEN [cost_center_name]&#13;&#10;    WHEN &quot;Management Level&quot; THEN [management_level]&#10;    WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#13;&#10;    WHEN &quot;Job Family&quot; THEN [job_family]&#13;&#10;    WHEN &quot;Gender&quot; THEN [gender]&#13;&#10;    WHEN &quot;Source Category&quot; THEN [source_category]&#13;&#10;END' />
      </column>
      <column caption='First Event Type Name' datatype='string' name='[Calculation_1564930555924971521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Interview_Event_Order] = &#10;    { FIXED [hiring_process_type]: MIN([Interview_Event_Order]) } &#10;THEN &#10;    IF [event_type] = &quot;Offer&quot; OR [event_type] = &quot;Hire&quot; THEN NULL ELSE [event_type] END&#10;END' />
      </column>
      <column caption='ICR_First_Event_to_Offer' datatype='real' default-format='p0.0%' name='[Calculation_1564930555937439749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Count Candidates in First Event Type (copy)_1564930555940028423]/[# in Offer (copy)_1564930555954249739]' />
      </column>
      <column caption='Two_Filter_Conversion_Rate' datatype='real' default-format='p0.00%' name='[Calculation_1564930555959296016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = [Parameters].[Interview Type 1 (copy)_1564930555958210575] THEN 0 ELSE&#10;[# in Interview Type 1 (copy)_1564930555962437652]/[# in Second Event (copy)_1564930555962245139]&#10;END' />
      </column>
      <column caption='Title Second_to_Offer' datatype='string' name='[Calculation_1564930555968086037]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(ATTR([First Event Type Name (copy)_1564930555939598342])) THEN&#10;    &quot;&quot;&#10;ELSE&#10;    ATTR([First Event Type Name (copy)_1564930555939598342]) + &quot; to Offer&quot;&#10;END' />
      </column>
      <column caption='# in HM Interviews' datatype='integer' name='[Calculation_1564930555992899608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;HM Interview&quot; THEN [Calculation_4674103099138371584] END)' />
      </column>
      <column caption='Table Conversion Rate to Next Stage' datatype='real' default-format='p0.0%' name='[Calculation_1564930556015894556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL(COUNTD([Calculation_4674103099138371584])) AND NOT ISNULL(LOOKUP(COUNTD([Calculation_4674103099138371584]), 1)) THEN&#10;    LOOKUP(COUNTD([Calculation_4674103099138371584]), 1) / COUNTD([Calculation_4674103099138371584])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Next Stage' datatype='string' name='[Calculation_1564930556019785758]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(MIN([event_type]), 1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% In Review to First Interview' datatype='real' default-format='p0.0%' name='[Calculation_2020075579469393938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# First Interview (copy)_4674103099364110339]/[# In Reviews (copy)_4674103099377180680]' />
      </column>
