        <calculation class='tableau' formula='CASE [event_type]&#10;            WHEN &apos;TA Interview&apos; THEN TRUE &#10;            WHEN &apos;HM Call&apos; THEN TRUE &#10;            WHEN &apos;HM Interview&apos; THEN TRUE &#10;            WHEN &apos;Group/Panel Interview&apos; THEN TRUE &#10;            WHEN &apos;Pre-HM Assessment&apos; THEN TRUE &#10;            WHEN &apos;Functional/Technical Interview&apos; THEN TRUE &#10;            WHEN &apos;Cross Entity Leveling Interview&apos; THEN TRUE &#10;            WHEN &apos;Bar Raiser Interview&apos; THEN TRUE &#10;            WHEN &apos;Assessment&apos; THEN TRUE &#10;            WHEN &apos;Final Interview&apos; THEN TRUE &#10;            WHEN &apos;Team Interview&apos; THEN TRUE &#10;            WHEN &apos;Leadership Interview&apos; THEN TRUE&#10;            WHEN &apos;SH/Business Interview&apos; THEN TRUE&#10;            WHEN &apos;Offer&apos; THEN TRUE&#10;            WHEN &apos;Hire&apos; THEN TRUE&#10;            ELSE FALSE&#10;        END' />
