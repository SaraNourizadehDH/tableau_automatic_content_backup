      <column caption='Is_Interview_Step_Required' datatype='boolean' name='[Interview Standard Order_1 (copy)_2719048328949899266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [event_type]&#10;WHEN &quot;TA Interview&quot; THEN &#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Contingent Worker (CW)&quot;, &#10;                 &quot;Contingent Worker (CW)&quot;, &quot;D-Marts&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;HM Call&quot; THEN FALSE&#10;WHEN &quot;HM Interview&quot; THEN &#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Contingent Worker (CW)&quot;, &#10;                 &quot;Contingent Worker (CW)&quot;, &quot;D-Marts&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Group/Panel Interview&quot; THEN FALSE&#10;WHEN &quot;Pre-HM Assessment&quot; THEN FALSE&#10;WHEN &quot;Functional/Technical Interview&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&quot;Non-Tech (All Levels)&quot;,&#10;                &quot;Product IC3 - IC6&quot;, &quot;(DHSE ONLY) Product IC3 - IC6&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Cross Entity Leveling Interview&quot; THEN TRUE&#10;WHEN &quot;Bar Raiser Interview&quot; THEN TRUE&#10;WHEN &quot;Assessment&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&quot;Non-Tech (All Levels)&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Final Interview&quot; THEN FALSE&#10;WHEN &quot;Team Interview&quot; THEN FALSE&#10;WHEN &quot;Leadership Interview&quot; THEN TRUE&#10;WHEN &quot;SH/Business Interview&quot; THEN&#10;    CASE [hiring_process_type]&#10;        WHEN IN (&quot;(DHSE ONLY) Non-Tech (All Levels) IC1 - M3&quot;,&#10;                 &quot;Non-Tech (All Levels)&quot;, &quot;Executive Search M4+&quot;)&#10;        THEN FALSE&#10;        ELSE TRUE&#10;    END&#10;WHEN &quot;Offer&quot; THEN TRUE&#10;WHEN &quot;Hire&quot; THEN TRUE&#10;ELSE FALSE&#10;END' />
        <aliases>
          <alias key='false' value='Only Optional Interviews' />
          <alias key='true' value='Only Required Interviews' />
        </aliases>
      </column>
      <column caption='Interview Event Order' datatype='integer' name='[Interview_Event_Order]' role='measure' type='quantitative' />
      <column caption='Funnel Stages Required' datatype='boolean' name='[Is_Interview_Step_Required (copy)_4674103099381084171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [event_type]&#10;WHEN &quot;Applications&quot; THEN TRUE &#10;WHEN &quot;Screening&quot; THEN TRUE&#10;WHEN &quot;First Interviews&quot; THEN TRUE&#10;WHEN &quot;Offer&quot; THEN TRUE&#10;WHEN &quot;Hire&quot; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Table Conversion Rate to Next Stage new' datatype='real' default-format='p0%' name='[Table Conversion Rate to Next Stage (copy)_1767099967533744128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_4674103099138371584]) &gt; 0 THEN&#10;    IF [Calculation_3027756019517722628] = 0 THEN&#10;        0&#10;    ELSE&#10;        COUNTD([Calculation_4674103099138371584]) / [Calculation_3027756019517722628]&#10;    END&#10;ELSE&#10;    NULL&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Title First_to_Offer' datatype='string' name='[Title Second_to_Offer (copy)_3608227780964704256]' role='measure' type='nominal'>
