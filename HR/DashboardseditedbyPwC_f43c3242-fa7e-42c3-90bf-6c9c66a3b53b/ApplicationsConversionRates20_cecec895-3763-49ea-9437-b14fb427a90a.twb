      <column caption='Second Event Type Name' datatype='string' name='[First Event Type Name (copy)_1564930555939598342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Interview_Event_Order] = &#10;    { FIXED [hiring_process_type]: &#10;        MIN(&#10;            IF [Interview_Event_Order] &gt; &#10;                    { FIXED [hiring_process_type]: &#10;                        MIN(IF [Interview Standard Order_1 (copy)_2719048328949899266] THEN [Interview_Event_Order] END) &#10;                    } &#10;                AND [Interview Standard Order_1 (copy)_2719048328949899266] &#10;            THEN [Interview_Event_Order] &#10;            ELSE NULL &#10;        END)&#10;    }&#10;THEN &#10;    IF [event_type] = &quot;Offer&quot; OR [event_type] = &quot;Hire&quot; THEN NULL ELSE [event_type] END&#10;END' />
