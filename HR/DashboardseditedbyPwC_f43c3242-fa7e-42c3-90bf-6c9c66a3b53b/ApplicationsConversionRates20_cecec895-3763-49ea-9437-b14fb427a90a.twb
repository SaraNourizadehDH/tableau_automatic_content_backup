        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Applications&quot; THEN [Calculation_4674103099138867201]&#10;    WHEN &quot;First Interviews&quot; THEN [# First Interview (copy)_4674103099364110339]&#10;    WHEN &quot;Offers Initiated&quot; THEN [Calculation_295900623384162309]&#10;    WHEN &quot;Hires&quot; THEN [Calculation_295900623384289286]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Interview Event Order (Shifted)' datatype='integer' name='[Calculation_6015261052532088833]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [hiring_process_type]&#10;&#10;WHEN IN (&quot;(DHSE ONLY) Speedy Hiring: High Volume Roles, Interns&quot;, &quot;Speedy Hiring: High Volume Roles, Interns&quot;) THEN&#10;    CASE [event_type]&#10;        WHEN &quot;Offer&quot; THEN 98&#10;        WHEN &quot;Hire&quot; THEN 99&#10;        ELSE [Interview_Event_Order] + 2&#10;    END&#10;ELSE &#10;    CASE [event_type]&#10;        WHEN &quot;Offer&quot; THEN 98&#10;        WHEN &quot;Hire&quot; THEN 99&#10;        ELSE [Interview_Event_Order]&#10;    END&#10;END' />
      </column>
      <column caption='Conversion Rate 2' datatype='real' default-format='p0.0%' name='[Conversion Rate 1 (copy)_385339248820334593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Conversion Rate 1 (copy)_3354407666928173064]&#13;&#10;    WHEN &quot;% New to In Review&quot; THEN [% In Review to First Interview (copy)_5870231076077395968]&#10;    WHEN &quot;% In Review to First Interview&quot; THEN [Calculation_2020075579469393938]&#10;    WHEN &quot;% First Interview to Offer Initiated&quot; THEN [% Application to First Interview (copy)_2020075579472896019]&#10;    WHEN &quot;% Offer Initiated to Hire&quot; THEN [% Hired to Contract Generated (copy)_2020075579480494103]&#10;    WHEN &quot;% TA Interview to HM Interview&quot; THEN [ICR_HM_to_Offer (copy)_2167920274770104320]&#10;    WHEN &quot;% TA Interview to Functional/Technical Interview&quot; THEN [% First Interview to Offer Initiated (copy)_3354407666614853632]&#10;    WHEN &quot;% Functional/Technical Interview to HM Interview&quot; THEN [% TA Interview to Functional/Technical (copy)_3354407666615484417]&#10;    WHEN &quot;% HM Interview to Bar Raiser Interview&quot; THEN [% Functional/Technical to HM Interview (copy)_3354407666615648258]&#10;    WHEN &quot;% Bar Raiser Interview to Offer&quot; THEN [% HM Interview to Bar Raiser (copy)_3354407666615787523]&#10;    WHEN &quot;% Bar Raiser Interview to Hire&quot; THEN [% Bar Raiser to Offer (copy)_3354407666615889924]&#10;    WHEN &quot;% TA Interview to Offer&quot; THEN [% TA Interview to Functional/Technical (copy)_3354407666615971845]&#10;    WHEN &quot;% TA Interview to Hire&quot; THEN [% TA Interview to Offer (copy)_3354407666616045574]&#10;END' />
