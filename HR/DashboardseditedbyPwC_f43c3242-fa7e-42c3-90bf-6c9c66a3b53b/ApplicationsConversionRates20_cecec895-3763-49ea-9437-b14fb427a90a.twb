            <column caption='Event Type' datatype='string' name='[event_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Screening&quot;' value='In Review' />
              </aliases>
            </column>
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Hiring Manager' datatype='string' name='[hiring_manager]' role='dimension' type='nominal' />
