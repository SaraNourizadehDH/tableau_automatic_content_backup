    <worksheet name='Recruitment Funnel KPIs &amp; Conversion Rates'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Recruitment Funnel KPIs &amp; Conversion Rates</run>
            <run>Æ&#10;</run>
            <run fontsize='9'>How many applicants passed through each step in the hiring process?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_rates_process_funnel (new)' name='federated.187tyif0wilrad1f3ybje0mx6qyw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension to Display' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
            <column caption='# First Interviews' datatype='integer' default-format='n#,##0;-#,##0' name='[# First Interview (copy)_4674103099364110339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;First Interviews&quot; THEN [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='# In Reviews' datatype='integer' default-format='n#,##0;-#,##0' name='[# In Reviews (copy)_4674103099377180680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Screening&quot; THEN [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='% First Interview to Offer Initiated' datatype='real' default-format='p0.0%' name='[% Application to First Interview (copy)_2020075579472896019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_295900623384162309]/[# First Interview (copy)_4674103099364110339]' />
            </column>
            <column caption='% Offer Initiated to Hire' datatype='real' default-format='p0.0%' name='[% Hired to Contract Generated (copy)_2020075579480494103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_295900623384289286]/[Calculation_295900623384162309]' />
            </column>
            <column caption='% New to In Review' datatype='real' default-format='p0.0%' name='[% In Review to First Interview (copy)_5870231076077395968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# In Reviews (copy)_4674103099377180680]/[Calculation_4674103099138867201]' />
            </column>
            <column caption='Dimension to Display' datatype='string' name='[Calculation_1277896432391098371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Country&quot; THEN [job_country]&#10;    WHEN &quot;Company&quot; THEN [company]&#13;&#10;    WHEN &quot;Department&quot; THEN [department]&#13;&#10;    WHEN &quot;Sub Department&quot; THEN [sub_department]&#13;&#10;    WHEN &quot;Cost Center&quot; THEN [cost_center_name]&#13;&#10;    WHEN &quot;Management Level&quot; THEN [management_level]&#10;    WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#13;&#10;    WHEN &quot;Job Family&quot; THEN [job_family]&#13;&#10;    WHEN &quot;Gender&quot; THEN [gender]&#13;&#10;    WHEN &quot;Source Category&quot; THEN [source_category]&#13;&#10;END' />
            </column>
            <column caption='% In Review to First Interview' datatype='real' default-format='p0.0%' name='[Calculation_2020075579469393938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# First Interview (copy)_4674103099364110339]/[# In Reviews (copy)_4674103099377180680]' />
