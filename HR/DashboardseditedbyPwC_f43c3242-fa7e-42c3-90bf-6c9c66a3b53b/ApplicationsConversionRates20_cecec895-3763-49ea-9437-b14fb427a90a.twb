            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
            <column caption='% Withdrawals' datatype='real' default-format='p0.0%' name='[# Candidate Withdrawals (copy)_5065282958468395015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# DH Rejections (copy)_5065282958465859589] / [Calculation_4674103099138867201]' />
            </column>
            <column caption='#  Withdrawals' datatype='integer' default-format='n#,##0;-#,##0' name='[# DH Rejections (copy)_5065282958465859589]' role='measure' type='quantitative'>
