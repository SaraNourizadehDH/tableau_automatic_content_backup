    <worksheet name='Interview Funnel - Absolute Values New'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Interview Funnel - Absolute Values &amp; Conversion Rates</run>
            <run>Æ&#10;</run>
            <run fontsize='9'>How many applicants passed through each step in the interview process per department / cost center / hiring manager / job family / requisition?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_rates_process_funnel (new)' name='federated.187tyif0wilrad1f3ybje0mx6qyw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Hiring Process Type Parameter' datatype='string' name='[Hiring Process Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Dimension to Display' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
            <column caption='# TA Interviews' datatype='integer' default-format='n#,##0;-#,##0' name='[# TA Interviews old (copy)_4674103099404877847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;TA Interview&quot; then [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='Dimension to Display' datatype='string' name='[Calculation_1277896432391098371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Country&quot; THEN [job_country]&#10;    WHEN &quot;Company&quot; THEN [company]&#13;&#10;    WHEN &quot;Department&quot; THEN [department]&#13;&#10;    WHEN &quot;Sub Department&quot; THEN [sub_department]&#13;&#10;    WHEN &quot;Cost Center&quot; THEN [cost_center_name]&#13;&#10;    WHEN &quot;Management Level&quot; THEN [management_level]&#10;    WHEN &quot;Job Family Group&quot; THEN [job_family_group]&#13;&#10;    WHEN &quot;Job Family&quot; THEN [job_family]&#13;&#10;    WHEN &quot;Gender&quot; THEN [gender]&#13;&#10;    WHEN &quot;Source Category&quot; THEN [source_category]&#13;&#10;END' />
            </column>
            <column caption='Next Stage' datatype='string' name='[Calculation_1564930556019785758]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(MIN([event_type]), 1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
            </column>
            <column caption='Count of candidates' datatype='integer' name='[Calculation_295900623378116609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_4674103099138371584])' />
