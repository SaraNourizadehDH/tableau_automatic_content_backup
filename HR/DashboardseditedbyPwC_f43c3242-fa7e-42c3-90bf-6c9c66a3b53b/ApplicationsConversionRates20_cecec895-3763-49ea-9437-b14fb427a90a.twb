    <worksheet name='Interview Funnel_v2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Interview Funnel</run>
            <run>Æ&#10;</run>
            <run fontsize='9'>How many applicants passed through the interview steps?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_rates_process_funnel (new)' name='federated.187tyif0wilrad1f3ybje0mx6qyw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Hiring Process Type Parameter' datatype='string' name='[Hiring Process Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
            <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
            </column>
            <column caption='Count of candidates' datatype='integer' name='[Calculation_295900623378116609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_4674103099138371584])' />
            </column>
            <column caption='IE_HM_Interview' datatype='integer' name='[Calculation_295900623381270532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;HM Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;HM Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Offer' datatype='integer' name='[Calculation_295900623384162309 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Offer&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Offer&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Hire' datatype='integer' name='[Calculation_295900623384289286 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Hire&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Hire&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Hires' datatype='integer' name='[Calculation_295900623384289286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [event_type] = &quot;Hire&quot; then [Calculation_4674103099138371584] END)' />
            </column>
            <column caption='Brand ' datatype='string' name='[Calculation_3163567633409904640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand]&#10;END' />
            </column>
            <column caption='IE_TA Interview' datatype='integer' name='[Calculation_3390717986374651927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;TA Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;TA Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_HM_Call' datatype='integer' name='[Calculation_3390717986375901209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;HM Call&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;HM Call&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Technical_Interview' datatype='integer' name='[Calculation_3390717986376011802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Functional/Technical Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Functional/Technical Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Bar_Raiser_Interview' datatype='integer' name='[Calculation_3390717986376278043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Bar Raiser Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Bar Raiser Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Final_Interview' datatype='integer' name='[Calculation_3390717986376441884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Final Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Final Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Assessment' datatype='integer' name='[Calculation_3390717986376556573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Assessment&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Assessment&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Candidate Job Key' datatype='string' name='[Calculation_4674103099138371584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[candidate_id] + &apos;-&apos; + [job_ref_id]&#10;// [Candidate Id]' />
            </column>
            <column caption='Hiring Process Type - parameter view' datatype='boolean' name='[Calculation_4674103099466072099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Hiring Process Type Parameter] = &apos;All&apos; THEN&#10;    IF [hiring_process_type] = [hiring_process_type] THEN TRUE&#10;    ELSE FALSE&#10;END&#10;&#10;ELSEIF [Parameters].[Hiring Process Type Parameter] != &apos;All&apos; THEN&#10;    [hiring_process_type]=[Parameters].[Hiring Process Type Parameter]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Interview Event Order (Shifted)' datatype='integer' name='[Calculation_6015261052532088833]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [hiring_process_type]&#10;&#10;WHEN IN (&quot;(DHSE ONLY) Speedy Hiring: High Volume Roles, Interns&quot;, &quot;Speedy Hiring: High Volume Roles, Interns&quot;) THEN&#10;    CASE [event_type]&#10;        WHEN &quot;Offer&quot; THEN 98&#10;        WHEN &quot;Hire&quot; THEN 99&#10;        ELSE [Interview_Event_Order] + 2&#10;    END&#10;ELSE &#10;    CASE [event_type]&#10;        WHEN &quot;Offer&quot; THEN 98&#10;        WHEN &quot;Hire&quot; THEN 99&#10;        ELSE [Interview_Event_Order]&#10;    END&#10;END' />
            </column>
            <column caption='Funnel Interviews Required' datatype='boolean' name='[Funnel Stages Required (copy)_4674103099447791641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [event_type]&#10;            WHEN &apos;TA Interview&apos; THEN TRUE &#10;            WHEN &apos;HM Call&apos; THEN TRUE &#10;            WHEN &apos;HM Interview&apos; THEN TRUE &#10;            WHEN &apos;Group/Panel Interview&apos; THEN TRUE &#10;            WHEN &apos;Pre-HM Assessment&apos; THEN TRUE &#10;            WHEN &apos;Functional/Technical Interview&apos; THEN TRUE &#10;            WHEN &apos;Cross Entity Leveling Interview&apos; THEN TRUE &#10;            WHEN &apos;Bar Raiser Interview&apos; THEN TRUE &#10;            WHEN &apos;Assessment&apos; THEN TRUE &#10;            WHEN &apos;Final Interview&apos; THEN TRUE &#10;            WHEN &apos;Team Interview&apos; THEN TRUE &#10;            WHEN &apos;Leadership Interview&apos; THEN TRUE&#10;            WHEN &apos;SH/Business Interview&apos; THEN TRUE&#10;            WHEN &apos;Offer&apos; THEN TRUE&#10;            WHEN &apos;Hire&apos; THEN TRUE&#10;            ELSE FALSE&#10;        END' />
            </column>
            <column caption='IE_Cross_Entity_Leveling_Interview' datatype='integer' name='[IE_Assessment (copy)_3390717986377617438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Cross Entity Leveling Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Cross Entity Leveling Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Team_Interview' datatype='integer' name='[IE_Assessment (copy)_3390717986383298594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Team Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Team Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_SH_Business_Interview' datatype='integer' name='[IE_Assessment (copy)_3390717986383523875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;SH/Business Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;SH/Business Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Leadership_Interview' datatype='integer' name='[IE_Final_Interview (copy)_3390717986382991393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Leadership Interview&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Leadership Interview&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IE_Pre_HM_Assessment' datatype='integer' name='[IE_Technical_Interview (copy)_3390717986379235359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([event_type]) = &quot;Pre-HM Assessment&quot; or LOOKUP(ATTR([event_type]), -1) = &quot;Pre-HM Assessment&quot; then COUNTD([Calculation_4674103099138371584]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
