        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1kqev4f0nokc6611hwz4g1rpsnf0' name='Custom SQL Query' type='text'><![CDATA[WITH
worker_org_prep AS(
   SELECT
      *,
      ROW_NUMBER() OVER (
         PARTITION BY work_email
         ORDER BY
            last_updated DESC
      ) AS rn
   FROM
      people_ops_proposed.il_worker_org
),
worker_org AS(
   SELECT
      *
   FROM
      worker_org_prep
   WHERE
      rn = 1
),
flattened_mapping AS (
    SELECT Type AS hiring_process_type, "1" AS event_type, 1 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "1" IS NOT NULL AND "1" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "2" AS event_type, 2 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "2" IS NOT NULL AND "2" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "3" AS event_type, 3 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "3" IS NOT NULL AND "3" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "4" AS event_type, 4 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "4" IS NOT NULL AND "4" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "5" AS event_type, 5 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "5" IS NOT NULL AND "5" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "6" AS event_type, 6 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "6" IS NOT NULL AND "6" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "7" AS event_type, 7 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "7" IS NOT NULL AND "7" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "8" AS event_type, 8 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "8" IS NOT NULL AND "8" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "9" AS event_type, 9 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "9" IS NOT NULL AND "9" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "10" AS event_type, 10 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "10" IS NOT NULL AND "10" <<>> ''
),
events AS (
--Applications
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'Applications' as event_type,
     	CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      rc.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
   	rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      jr.evergreen = 'No'
    AND jr.confidential = 'No'
    AND
   ((
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))

UNION ALL
--Screenings
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'Screening' as event_type,
      CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      rc.in_review_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND 
      ((
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))
      
UNION ALL
--First Interviews
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'First Interviews' as event_type,
      CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc.source_type,
      rc."source",
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      rc.interview_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND 
      ((
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))

UNION ALL      
--Interviews      
   SELECT
      DATE_TRUNC('month',DATE(cast(ie.interview_date as timestamp))) AS date_month,
      ie.company_id,
      ie.brand,
      ie.company,
      ie.candidate_id,
      jr.job_country,
      CASE 
        WHEN ie.interview_types = 'Functional / Technical Interview' THEN 'Functional/Technical Interview'
        WHEN ie.interview_types = 'SH/Business interview' THEN 'SH/Business Interview'
        ELSE ie.interview_types
   	 END as event_type,
      CASE
        WHEN ie.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN ie.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      ie.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_interview_events ie
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON ie.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON ie.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON ie.candidate_id = rc.candidate_id
         AND ie.job_ref_id = rc.job_ref_id
   WHERE
      ie.interview_date IS NOT NULL
      AND ie.interview_types IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
       AND 
       (
        (
            DATE(CAST(ie.interview_date AS TIMESTAMP)) >>= DATE('2021-01-01')
            AND ie.brand = 'Delivery Hero'
        )
        OR (
            DATE(CAST(ie.interview_date AS TIMESTAMP)) >>= DATE('2024-03-18')
            AND ie.brand <<>> 'Delivery Hero'
        )
    )

UNION ALL
--Offers      
   SELECT
      DATE_TRUNC('month', DATE(CAST(COALESCE(rc.hired_position_hire_date, o.offer_pending_date) AS TIMESTAMP))) AS date_month,
      o.company_id,
      o.brand,
      o.company,
      o.candidate_id,
      jr.job_country,
      'Offer' as event_type,
      CASE
        WHEN o.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN o.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      o.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_offer o
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON o.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON o.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON o.candidate_id = rc.candidate_id
      AND o.job_ref_id = rc.job_ref_id
   WHERE
      (
         (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2021-01-01')
               AND o.brand = 'Delivery Hero'
         )
         OR (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2024-03-18')
               AND o.brand <<>> 'Delivery Hero'
         )
      )
      AND o.offer_pending_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'

UNION ALL
--Hires      
SELECT
      DATE_TRUNC('month', DATE(CAST(COALESCE(rc.hired_position_hire_date, o.offer_pending_date) AS TIMESTAMP))) AS date_month,
      o.company_id,
      o.brand,
      o.company,
      o.candidate_id,
      jr.job_country,
      'Hire' as event_type,
     CASE
        WHEN o.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN o.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END)) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
FROM people_ops_proposed.il_sr_offer o
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON o.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON o.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON rc.job_ref_id = o.job_ref_id AND rc.candidate_id = o.candidate_id
   WHERE
      (
         (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2021-01-01')
               AND rc.brand = 'Delivery Hero'
         )
         OR (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2024-03-18')
               AND rc.brand <<>> 'Delivery Hero'
         )
      )
      AND o.offer_pending_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND rc.onboarding_status = 'Onboarding Successful'
)
 SELECT
 	e.*,
 	COALESCE(
        fm.step_number,
        CASE e.event_type
            WHEN 'TA Interview' THEN 1
            WHEN 'HM Call' THEN 2
            WHEN 'HM Interview' THEN 3
            WHEN 'Group/Panel Interview' THEN 4
            WHEN 'Pre-HM Assessment' THEN 5
            WHEN 'Functional/Technical Interview' THEN 6
            WHEN 'Cross Entity Leveling Interview' THEN 7
            WHEN 'Bar Raiser Interview' THEN 8
            WHEN 'Assessment' THEN 9
            WHEN 'Final Interview' THEN 10
            WHEN 'Team Interview' THEN 11
            WHEN 'Leadership Interview' THEN 12
            WHEN 'SH/Business Interview' THEN 13
            WHEN 'Offer' THEN 14
            WHEN 'Hire' THEN 15
            ELSE NULL
        END
    ) AS Interview_Event_Order
 FROM 
 	events e
 LEFT JOIN flattened_mapping fm ON fm.hiring_process_type = e.hiring_process_type AND fm.event_type = e.event_type]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1kqev4f0nokc6611hwz4g1rpsnf0' name='Custom SQL Query' type='text'><![CDATA[WITH
worker_org_prep AS(
   SELECT
      *,
      ROW_NUMBER() OVER (
         PARTITION BY work_email
         ORDER BY
            last_updated DESC
      ) AS rn
   FROM
      people_ops_proposed.il_worker_org
),
worker_org AS(
   SELECT
      *
   FROM
      worker_org_prep
   WHERE
      rn = 1
),
flattened_mapping AS (
    SELECT Type AS hiring_process_type, "1" AS event_type, 1 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "1" IS NOT NULL AND "1" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "2" AS event_type, 2 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "2" IS NOT NULL AND "2" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "3" AS event_type, 3 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "3" IS NOT NULL AND "3" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "4" AS event_type, 4 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "4" IS NOT NULL AND "4" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "5" AS event_type, 5 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "5" IS NOT NULL AND "5" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "6" AS event_type, 6 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "6" IS NOT NULL AND "6" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "7" AS event_type, 7 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "7" IS NOT NULL AND "7" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "8" AS event_type, 8 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "8" IS NOT NULL AND "8" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "9" AS event_type, 9 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "9" IS NOT NULL AND "9" <<>> ''
    UNION ALL
    SELECT Type AS hiring_process_type, "10" AS event_type, 10 AS step_number FROM people_ops_proposed.raw_gs_hiring_process_type_mapping
    WHERE "10" IS NOT NULL AND "10" <<>> ''
),
events AS (
--Applications
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'Applications' as event_type,
     	CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      rc.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
   	rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      jr.evergreen = 'No'
    AND jr.confidential = 'No'
    AND
   ((
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.application_creation_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))

UNION ALL
--Screenings
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'Screening' as event_type,
      CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      rc.in_review_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND 
      ((
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.in_review_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))
      
UNION ALL
--First Interviews
   SELECT
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) AS date_month,
      jr.company_id,
      jr.brand,
      jr.company,
      rc.candidate_id,
      jr.job_country,
      'First Interviews' as event_type,
      CASE
        WHEN jr.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN jr.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc.source_type,
      rc."source",
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_recruitment_corpus rc
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON rc.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON rc.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
   WHERE
      rc.interview_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND 
      ((
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) >>= DATE('2021-01-01')
      AND jr.brand = 'Delivery Hero'
   )
   OR (
      DATE_TRUNC('month',DATE(cast(rc.interview_date as timestamp))) >>= DATE('2024-03-18')
      AND jr.brand <<>> 'Delivery Hero'))

UNION ALL      
--Interviews      
   SELECT
      DATE_TRUNC('month',DATE(cast(ie.interview_date as timestamp))) AS date_month,
      ie.company_id,
      ie.brand,
      ie.company,
      ie.candidate_id,
      jr.job_country,
      CASE 
        WHEN ie.interview_types = 'Functional / Technical Interview' THEN 'Functional/Technical Interview'
        WHEN ie.interview_types = 'SH/Business interview' THEN 'SH/Business Interview'
        ELSE ie.interview_types
   	 END as event_type,
      CASE
        WHEN ie.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN ie.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      ie.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_interview_events ie
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON ie.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON ie.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON ie.candidate_id = rc.candidate_id
         AND ie.job_ref_id = rc.job_ref_id
   WHERE
      ie.interview_date IS NOT NULL
      AND ie.interview_types IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
       AND 
       (
        (
            DATE(CAST(ie.interview_date AS TIMESTAMP)) >>= DATE('2021-01-01')
            AND ie.brand = 'Delivery Hero'
        )
        OR (
            DATE(CAST(ie.interview_date AS TIMESTAMP)) >>= DATE('2024-03-18')
            AND ie.brand <<>> 'Delivery Hero'
        )
    )

UNION ALL
--Offers      
   SELECT
      DATE_TRUNC('month', DATE(CAST(COALESCE(rc.hired_position_hire_date, o.offer_pending_date) AS TIMESTAMP))) AS date_month,
      o.company_id,
      o.brand,
      o.company,
      o.candidate_id,
      jr.job_country,
      'Offer' as event_type,
      CASE
        WHEN o.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN o.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      o.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END
   )) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
   FROM
      people_ops_proposed.il_sr_offer o
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON o.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON o.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON o.candidate_id = rc.candidate_id
      AND o.job_ref_id = rc.job_ref_id
   WHERE
      (
         (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2021-01-01')
               AND o.brand = 'Delivery Hero'
         )
         OR (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2024-03-18')
               AND o.brand <<>> 'Delivery Hero'
         )
      )
      AND o.offer_pending_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'

UNION ALL
--Hires      
SELECT
      DATE_TRUNC('month', DATE(CAST(COALESCE(rc.hired_position_hire_date, o.offer_pending_date) AS TIMESTAMP))) AS date_month,
      o.company_id,
      o.brand,
      o.company,
      o.candidate_id,
      jr.job_country,
      'Hire' as event_type,
     CASE
        WHEN o.company_id = '1001' THEN cha.department
        ELSE hm.department_wd
    END AS department,
    CASE
        WHEN o.company_id = '1001' THEN cha.sub_department
        ELSE hm.sub_department_wd
    END AS sub_department,
      cwd.cost_center_name,
      jr.cost_center_id,
      jr.management_level,
      jr.job_family,
      jr.job_family_group,
      jr.job_ref_id,
      jr.hiring_process_type,
      COALESCE((CASE
         WHEN wp.gender = 'Other' THEN 'Unknown'
         ELSE wp.gender
      END),
      (CASE
         WHEN lower(rc.gender) = 'female' THEN 'Female'
         WHEN lower(rc.gender) = 'male' THEN 'Male'
         WHEN lower(rc.gender) = 'non-binary' THEN 'Non-binary'
         WHEN lower(rc.gender) = 'other' THEN 'Unknown'
         WHEN lower(rc.gender) = 'unknown' THEN 'Unknown'
         WHEN rc.gender IS NULL THEN 'Unknown'
         ELSE rc.gender
      END)) AS gender,
      jr.hiring_manager,
      jr.recruiter,
      jr.ta_manager,
      jr.sourcer,
      jr.coordinator,
      rc."source",
      rc.source_type,
  	 rc.source_subtype,
 	  rc.source_category,
      rc.application_status_before_rejection,
      rc.application_reason_for_withdrawal,
      rc.application_reason_for_rejection,
      m.manager_02_full_name,
      m.manager_03_full_name,
      m.manager_04_full_name,
      m.manager_05_full_name,
      m.manager_06_full_name,
      m.manager_07_full_name,
      m.manager_08_full_name,
      CURRENT_DATE AS last_updated
FROM people_ops_proposed.il_sr_offer o
      LEFT JOIN people_ops_proposed.il_sr_job_requisition jr ON o.job_ref_id = jr.job_ref_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha ON jr.cost_center_id = cha.cost_center_id
      LEFT JOIN worker_org hm ON jr.hiring_manager_email = hm.work_email
      LEFT JOIN people_ops_proposed.il_worker_personal wp ON o.employee_id = wp.employee_id
      LEFT JOIN people_ops_proposed.il_manager m ON hm.employee_id = m.employee_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd cwd ON jr.cost_center_id = cwd.cost_center_id
      LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha2 ON hm.cost_center_id = cha2.cost_center_id
      LEFT JOIN people_ops_proposed.il_sr_recruitment_corpus rc ON rc.job_ref_id = o.job_ref_id AND rc.candidate_id = o.candidate_id
   WHERE
      (
         (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2021-01-01')
               AND rc.brand = 'Delivery Hero'
         )
         OR (
               DATE(CAST(o.offer_pending_date AS TIMESTAMP)) >>= DATE('2024-03-18')
               AND rc.brand <<>> 'Delivery Hero'
         )
      )
      AND o.offer_pending_date IS NOT NULL
      AND jr.evergreen = 'No'
      AND jr.confidential = 'No'
      AND rc.onboarding_status = 'Onboarding Successful'
)
 SELECT
 	e.*,
 	COALESCE(
        fm.step_number,
        CASE e.event_type
            WHEN 'TA Interview' THEN 1
            WHEN 'HM Call' THEN 2
            WHEN 'HM Interview' THEN 3
            WHEN 'Group/Panel Interview' THEN 4
            WHEN 'Pre-HM Assessment' THEN 5
            WHEN 'Functional/Technical Interview' THEN 6
            WHEN 'Cross Entity Leveling Interview' THEN 7
            WHEN 'Bar Raiser Interview' THEN 8
            WHEN 'Assessment' THEN 9
            WHEN 'Final Interview' THEN 10
            WHEN 'Team Interview' THEN 11
            WHEN 'Leadership Interview' THEN 12
            WHEN 'SH/Business Interview' THEN 13
            WHEN 'Offer' THEN 14
            WHEN 'Hire' THEN 15
            ELSE NULL
        END
    ) AS Interview_Event_Order
 FROM 
 	events e
 LEFT JOIN flattened_mapping fm ON fm.hiring_process_type = e.hiring_process_type AND fm.event_type = e.event_type]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
