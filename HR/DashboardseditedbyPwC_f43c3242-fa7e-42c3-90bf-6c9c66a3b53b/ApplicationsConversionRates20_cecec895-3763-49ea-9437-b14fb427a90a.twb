    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='6 - Diversity'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/ApplicationsConversionRates_17272564070160/6-Diversity?rev=' id='6-Diversity' path='/t/HR/workbooks/ApplicationsConversionRates2_0' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='1500' maxwidth='1400' minheight='1500' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='conversion_rates_process_funnel (new)' name='federated.187tyif0wilrad1f3ybje0mx6qyw' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimension to Display' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
          <members>
            <member value='&quot;Country&quot;' />
            <member value='&quot;Company&quot;' />
            <member value='&quot;Department&quot;' />
            <member value='&quot;Sub Department&quot;' />
            <member value='&quot;Cost Center&quot;' />
            <member value='&quot;Management Level&quot;' />
            <member value='&quot;Job Family Group&quot;' />
            <member value='&quot;Job Family&quot;' />
            <member value='&quot;Source Category&quot;' />
            <member value='&quot;Gender&quot;' />
          </members>
        </column>
        <column caption='Metric to display' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offers Initiated&quot;'>
          <calculation class='tableau' formula='&quot;Offers Initiated&quot;' />
          <members>
            <member value='&quot;Applications&quot;' />
            <member value='&quot;First Interviews&quot;' />
            <member value='&quot;Offers Initiated&quot;' />
            <member value='&quot;Hires&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.187tyif0wilrad1f3ybje0mx6qyw'>
        <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
        </column>
        <column caption='Brand ' datatype='string' name='[Calculation_3163567633409904640]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand]&#10;END' />
        </column>
        <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
        <column caption='CX' datatype='string' name='[coordinator]' role='dimension' type='nominal' />
        <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
        <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
        <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
        <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
        <column caption='Hiring Manager' datatype='string' name='[hiring_manager]' role='dimension' type='nominal' />
        <column caption='Hiring Process Type' datatype='string' name='[hiring_process_type]' role='dimension' type='nominal' />
        <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
        <column caption='Job Family Group' datatype='string' name='[job_family_group]' role='dimension' type='nominal' />
        <column caption='Job Req ID' datatype='string' name='[job_ref_id]' role='dimension' type='nominal' />
        <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
