        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1oiuoee1jjh02i1araqeu0nh1n4b' name='eoy_budget' type='text'>SELECT 
	DATE_TRUNC(&apos;month&apos;,DATE(&quot;month&quot;)) AS date_month,
	c.cost_center_id,
	cwd.cost_center_name,
	cha.department,
	cha.sub_department,
	SUM(hc_budget) AS hc_budget
FROM 
	people_ops_proposed.il_hc_budget_cc c
LEFT JOIN 
	people_ops_proposed.il_cc_hierarchy_wd cwd
	ON c.cost_center_id = cwd.cost_center_id 
LEFT JOIN 
	people_ops_proposed.il_cc_hierarchy_all cha
	ON c.cost_center_id = cha.cost_center_id 
WHERE 
	MONTH(DATE(&quot;month&quot;)) = 12
GROUP BY 	
	1, 2, 3, 4, 5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1oiuoee1jjh02i1araqeu0nh1n4b' name='eoy_budget' type='text'>SELECT 
