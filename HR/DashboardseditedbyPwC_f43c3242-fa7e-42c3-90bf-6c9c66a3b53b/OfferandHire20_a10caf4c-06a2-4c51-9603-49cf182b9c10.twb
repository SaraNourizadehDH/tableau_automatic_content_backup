    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Appendix - Hire Details'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/OfferandHire_17272581828970/Appendix-HireDetails?rev=' id='Appendix-HireDetails' path='/t/HR/workbooks/OfferandHire2_0' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1400' minheight='2000' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Offer and Hire' name='federated.05r9snf0pm3fk91dop2ed0zgusim (copy 2)' />
      </datasources>
      <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim (copy 2)'>
        <column caption='Brand ' datatype='string' name='[Calculation_1299921812271034368]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand (pl_ta_offer_hire)]&#10;END' />
        </column>
        <column caption='Job Req' datatype='string' name='[Calculation_1627488358110543872]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[job_ref_id (pl_ta_offer_hire)] + &quot; &quot; + [job_title (pl_ta_offer_hire)]' />
        </column>
        <column caption='Offer Inititiated Date Corrected' datatype='date' name='[Calculation_1948229114686500864]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, 1, [offer_initiated_date (pl_ta_offer_hire)]))' />
        </column>
        <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
        </column>
        <column caption='Year' datatype='string' datatype-customized='true' name='[Calculation_4602678834165899271]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(YEAR([Calculation_1948229114686500864]))' />
        </column>
        <column caption='Candidate ID' datatype='string' name='[candidate_id]' role='dimension' type='nominal' />
        <column caption='Company' datatype='string' name='[company (pl_ta_offer_hire)]' role='dimension' type='nominal' />
        <column caption='CX' datatype='string' name='[coordinator (pl_ta_offer_hire)]' role='dimension' type='nominal' />
        <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
        <column caption='Country ' datatype='string' name='[country (pl_ta_offer_hire)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
        <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
        <column caption='Hiring Manager' datatype='string' name='[hiring_manager (pl_ta_offer_hire)]' role='dimension' type='nominal' />
        <column caption='Hiring Process' datatype='string' name='[hiring_process_type (pl_ta_offer_hire)]' role='dimension' type='nominal' />
        <column caption='Job Family' datatype='string' name='[job_family]' role='dimension' type='nominal' />
        <column caption='Management Level' datatype='string' name='[job_req_level (pl_ta_offer_hire)]' role='dimension' type='nominal' />
        <column caption='Manager 02' datatype='string' name='[manager_02_full_name]' role='dimension' type='nominal' />
        <column caption='Manager 03' datatype='string' name='[manager_03_full_name]' role='dimension' type='nominal' />
        <column caption='Manager 04' datatype='string' name='[manager_04_full_name]' role='dimension' type='nominal' />
        <column caption='Manager 05' datatype='string' name='[manager_05_full_name]' role='dimension' type='nominal' />
        <column caption='Manager 06' datatype='string' name='[manager_06_full_name]' role='dimension' type='nominal' />
        <column caption='Manager 07' datatype='string' name='[manager_07_full_name]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1948229114686500864]' derivation='MY' name='[my:Calculation_1948229114686500864:ok]' pivot='key' type='ordinal' />
