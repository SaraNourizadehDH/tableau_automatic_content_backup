            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension Switcher' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim (copy 2)'>
            <column caption='# Offers Rejected' datatype='integer' default-format='n#,##0;-#,##0' name='[# Offers Initiated (copy)_654992321996124161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN 1&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN 1&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='# Offers Accepted' datatype='integer' default-format='n#,##0;-#,##0' name='[# Offers Initiated (copy)_941252357050814465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN 0&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN 0&#10;ELSEIF NOT ISNULL([offer_accepted_date (pl_ta_offer_hire)]) THEN 1&#10;ELSEIF [application_status_before_rejection (pl_ta_offer_hire)] = &quot;Handover to Core People Ops (With / without Visa)&quot; THEN 1 &#10;END' />
            </column>
            <column caption='Offer Stage' datatype='string' name='[Calculation_1217379326615044096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN &quot;Offer Rejected&quot;&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN &quot;Offer Rejected&quot;&#13;&#10;ELSEIF NOT ISNULL([offer_accepted_date (pl_ta_offer_hire)]) THEN &quot;Offer Accepted&quot;&#10;ELSEIF NOT ISNULL([handover_to_corops_date (pl_ta_offer_hire)]) THEN &quot;Offer Accepted&quot;&#13;&#10;ELSE &quot;Offer In Progress&quot; &#13;&#10;END' />
            </column>
            <column caption='Brand ' datatype='string' name='[Calculation_1299921812271034368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand (pl_ta_offer_hire)]&#10;END' />
            </column>
            <column caption='Offer Approval' datatype='boolean' name='[Calculation_135670994228310017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([offer_approved_date (pl_ta_offer_hire)])' />
            </column>
            <column caption='Job Req' datatype='string' name='[Calculation_1627488358110543872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[job_ref_id (pl_ta_offer_hire)] + &quot; &quot; + [job_title (pl_ta_offer_hire)]' />
            </column>
            <column caption='Offer Inititiated Date Corrected' datatype='date' name='[Calculation_1948229114686500864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, 1, [offer_initiated_date (pl_ta_offer_hire)]))' />
            </column>
            <column caption='Candidate job key' datatype='string' name='[Calculation_1948229114960060417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[candidate_id] + &apos;-&apos; + [job_ref_id (pl_ta_offer_hire)]' />
            </column>
            <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
            </column>
            <column caption='Year' datatype='string' datatype-customized='true' name='[Calculation_4602678834165899271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([Calculation_1948229114686500864]))' />
            </column>
            <column caption='# Offer Pending Approval' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_827254982711255041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_827254982969917444] = &apos;Offer Pending Approval&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Offer In Progress Substage' datatype='string' name='[Calculation_827254982969917444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1217379326615044096] = &quot;Offer In Progress&quot; AND [Calculation_135670994228310017] = TRUE THEN &apos;Offer Pending Acceptance&apos;&#13;&#10;ELSEIF [Calculation_1217379326615044096] = &quot;Offer In Progress&quot; AND [Calculation_135670994228310017] = FALSE THEN &apos;Offer Pending Approval&apos;&#13;&#10;END' />
            </column>
            <column caption='Dimension to Display' datatype='string' name='[Calculation_827254984124825610]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Brand&apos; THEN [Calculation_1299921812271034368]&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group]&#10;    WHEN &apos;Job Family&apos; THEN [job_family]&#13;&#10;    WHEN &apos;Department&apos; THEN [department]&#10;    WHEN &apos;Sub Department&apos; THEN [sub_department]&#10;    WHEN &apos;Cost Center Name&apos; THEN [cost_center_name]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [job_req_level (pl_ta_offer_hire)]&#13;&#10;    WHEN &apos;Country&apos; THEN [country (pl_ta_offer_hire)]&#10;    WHEN &apos;Company&apos; THEN [company (pl_ta_offer_hire)]&#10;    WHEN &apos;Gender&apos; THEN [gender]&#10;    WHEN &apos;Region&apos; THEN [candidate_region (pl_ta_offer_hire)]&#10;    WHEN &apos;Source Category&apos; THEN [source_category]&#13;&#10;END' />
            </column>
            <column caption='# Offer Initiated' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_941252357050609664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([Calculation_1948229114686500864]) THEN [Calculation_1948229114960060417] END)' />
