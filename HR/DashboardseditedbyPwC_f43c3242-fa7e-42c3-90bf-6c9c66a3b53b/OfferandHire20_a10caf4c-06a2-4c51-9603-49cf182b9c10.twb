          <zone forceUpdate='true' h='4100' id='10' type-v2='text' w='69928' x='14786' y='400'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='18'>Rejection and Withdrawal Reasons (BETA version)</run>
