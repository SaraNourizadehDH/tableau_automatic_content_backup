      <aliases enabled='yes' />
      <column caption='# Offer Pending Acceptance' datatype='integer' default-format='n#,##0;-#,##0' name='[# Offers In Progress (copy)_1799469581633290240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_827254982969917444] = &apos;Offer Pending Acceptance&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='# Offers Rejected' datatype='integer' default-format='n#,##0;-#,##0' name='[# Offers Initiated (copy)_654992321996124161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN 1&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN 1&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='# Offers Accepted' datatype='integer' default-format='n#,##0;-#,##0' name='[# Offers Initiated (copy)_941252357050814465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN 0&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN 0&#10;ELSEIF NOT ISNULL([offer_accepted_date (pl_ta_offer_hire)]) THEN 1&#10;ELSEIF [application_status_before_rejection (pl_ta_offer_hire)] = &quot;Handover to Core People Ops (With / without Visa)&quot; THEN 1 &#10;END' />
      </column>
      <column caption='# No Shows' datatype='integer' name='[% No Shows (copy)_1240741755665727491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marked_as_no_show (pl_ta_offer_hire)])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim (copy 2)].[pcto:sum:\# Offers Initiated (copy)_654992321996124161:qk:3]&quot;' value='% of Total' />
        </aliases>
      </column>
      <column caption='% Offer Rejection Rate' datatype='real' default-format='p0.0%' name='[Calculation_1074952988344389633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([# Offers Initiated (copy)_654992321996124161]) / [Calculation_941252357050609664]' />
      </column>
      <column caption='Last Updated - max' datatype='date' name='[Calculation_1155665901514948608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([last_updated (pl_ta_offer_hire)])}' />
      </column>
      <column caption='Offer Stage' datatype='string' name='[Calculation_1217379326615044096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([offer_rejection_reason (pl_ta_offer_hire)]) THEN &quot;Offer Rejected&quot;&#10;ELSEIF NOT ISNULL([offer_withdrawal_reason (pl_ta_offer_hire)]) THEN &quot;Offer Rejected&quot;&#13;&#10;ELSEIF NOT ISNULL([offer_accepted_date (pl_ta_offer_hire)]) THEN &quot;Offer Accepted&quot;&#10;ELSEIF NOT ISNULL([handover_to_corops_date (pl_ta_offer_hire)]) THEN &quot;Offer Accepted&quot;&#13;&#10;ELSE &quot;Offer In Progress&quot; &#13;&#10;END' />
      </column>
      <column caption='# Hires' datatype='integer' name='[Calculation_1297107073271939075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM(&#10;// IF [onboarding_status] = &apos;Onboarding Successful&apos; THEN 1 ELSE 0 END &#10;// )&#10;&#10;COUNTD(IF [onboarding_status] = &apos;Onboarding Successful&apos; THEN [Calculation_1948229114960060417] END)' />
      </column>
      <column caption='Offers Rejected x100' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1297107073273081860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_1074952988344389633] * 100,0)' />
      </column>
      <column caption='Hired Position?' datatype='string' name='[Calculation_1297107073278394375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([hired_position_hire_date (pl_ta_offer_hire)]) = TRUE THEN &quot;No&quot; ELSE &quot;Yes&quot; END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1297107073304555529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg TTH' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1297107073314660362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( DATEDIFF(&apos;day&apos;, [application_creation_date (pl_ta_offer_hire)], [handover_to_corops_date (pl_ta_offer_hire)]) )' />
      </column>
      <column caption='% Offer Accepted Rate' datatype='real' default-format='p0.0%' name='[Calculation_1297107073320607755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1074952988344389633]' />
      </column>
      <column caption='Contract Status ' datatype='string' name='[Calculation_1297107073345208337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([contract_signed_date_employee (pl_ta_offer_hire)]) = FALSE THEN &quot;4. Contract signed by candidate&quot;&#10;ELSEIF ISNULL([contract_signed_date_employee (pl_ta_offer_hire)]) = FALSE THEN &quot;3. Contract signed by DH&quot;&#10;ELSEIF ISNULL([contract_generated_on (pl_ta_offer_hire)]) = FALSE THEN &quot;2. Contract in generation&quot;&#10;ELSE &quot;1. Contract to be generated&quot;&#10;END' />
      </column>
      <column caption='Brand ' datatype='string' name='[Calculation_1299921812271034368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [department] = &apos;EU Regional&apos; THEN &apos;foodora&apos;&#10;ELSE [brand (pl_ta_offer_hire)]&#10;END' />
      </column>
      <column caption='Offer Approval' datatype='boolean' name='[Calculation_135670994228310017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([offer_approved_date (pl_ta_offer_hire)])' />
      </column>
      <column caption='% No Shows' datatype='real' name='[Calculation_1392738242693369856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marked_as_no_show (pl_ta_offer_hire)]) / SUM([# Offers Initiated (copy)_941252357050814465])' />
      </column>
      <column caption='Job Req' datatype='string' name='[Calculation_1627488358110543872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[job_ref_id (pl_ta_offer_hire)] + &quot; &quot; + [job_title (pl_ta_offer_hire)]' />
      </column>
      <column caption='Offer Inititiated Date Corrected' datatype='date' name='[Calculation_1948229114686500864]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, 1, [offer_initiated_date (pl_ta_offer_hire)]))' />
      </column>
      <column caption='Candidate job key' datatype='string' name='[Calculation_1948229114960060417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[candidate_id] + &apos;-&apos; + [job_ref_id (pl_ta_offer_hire)]' />
      </column>
      <column caption='Entity Hire Status' datatype='string' name='[Calculation_2001076015585067009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [entity_hire (pl_ta_offer_hire)] = &apos;Not entity hire&apos; THEN [entity_hire (pl_ta_offer_hire)]&#10;ELSEIF ISNULL([final_arrival_date_in_germany (pl_ta_offer_hire)]) = TRUE THEN &apos;Not relocated&apos;&#10;ELSEIF [final_arrival_date_in_germany (pl_ta_offer_hire)] &gt; TODAY() THEN &apos;Not relocated&apos;&#10;ELSE &apos;Relocated&apos;&#10;END' />
      </column>
      <column caption='Internal/External Candidates' datatype='string' name='[Calculation_234820505585901576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [source_category]=&apos;Internal&apos; THEN &quot;Internal Candidates Only&quot; ELSE &quot;External Candidates Only&quot; END' />
      </column>
      <column caption='Year' datatype='string' datatype-customized='true' name='[Calculation_4602678834165899271]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Calculation_1948229114686500864]))' />
      </column>
      <column aggregation='Avg' caption='% Offer Comp Ratio' datatype='real' default-format='p0%' name='[Calculation_5876142004309405696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [offer_comp_ratio] != 0 THEN [offer_comp_ratio] END&#10;// AND [offer_comp_ratio] &lt;= 10' />
      </column>
      <column caption='# Offer Pending Approval' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_827254982711255041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_827254982969917444] = &apos;Offer Pending Approval&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Offer In Progress Substage' datatype='string' name='[Calculation_827254982969917444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1217379326615044096] = &quot;Offer In Progress&quot; AND [Calculation_135670994228310017] = TRUE THEN &apos;Offer Pending Acceptance&apos;&#13;&#10;ELSEIF [Calculation_1217379326615044096] = &quot;Offer In Progress&quot; AND [Calculation_135670994228310017] = FALSE THEN &apos;Offer Pending Approval&apos;&#13;&#10;END' />
      </column>
      <column caption='Dimension to Display' datatype='string' name='[Calculation_827254984124825610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Brand&apos; THEN [Calculation_1299921812271034368]&#10;    WHEN &apos;Job Family Group&apos; THEN [job_family_group]&#10;    WHEN &apos;Job Family&apos; THEN [job_family]&#13;&#10;    WHEN &apos;Department&apos; THEN [department]&#10;    WHEN &apos;Sub Department&apos; THEN [sub_department]&#10;    WHEN &apos;Cost Center Name&apos; THEN [cost_center_name]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [job_req_level (pl_ta_offer_hire)]&#13;&#10;    WHEN &apos;Country&apos; THEN [country (pl_ta_offer_hire)]&#10;    WHEN &apos;Company&apos; THEN [company (pl_ta_offer_hire)]&#10;    WHEN &apos;Gender&apos; THEN [gender]&#10;    WHEN &apos;Region&apos; THEN [candidate_region (pl_ta_offer_hire)]&#10;    WHEN &apos;Source Category&apos; THEN [source_category]&#13;&#10;END' />
      </column>
      <column caption='# Offer Initiated' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_941252357050609664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([Calculation_1948229114686500864]) THEN [Calculation_1948229114960060417] END)' />
      </column>
      <column caption='No Show / Show' datatype='string' name='[Calculation_941252357079597058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [marked_as_no_show (pl_ta_offer_hire)]= 1 THEN &apos;No Show&apos; ELSE &apos;Show&apos; END' />
      </column>
      <column caption='# Candidates' datatype='integer' name='[Candidate Wd Id (copy)_827254982709092352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([candidate_id])' />
      </column>
      <column caption='Days Since Offered Initiated' datatype='integer' default-format='n#,##0;-#,##0' name='[Days Since 1st Interview (copy)_1838031626216144898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TODAY() - [Calculation_1948229114686500864]' />
      </column>
      <column caption='Offers Accepted x100' datatype='real' default-format='n#,##0;-#,##0' name='[Offers Rejected x100 (copy)_1297107073320792076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_1297107073320607755] * 100,0)' />
      </column>
