      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.03hfyz61adex0n10c7pmf1icj9em].[sum:Calculation_890023921712082949:qk]&quot;' value='# Direct Reports (Total)' />
          <alias key='&quot;[federated.03hfyz61adex0n10c7pmf1icj9em].[sum:direct_reports_with_on_leave:qk]&quot;' value='# Total Directs excl. on leave' />
          <alias key='&quot;[federated.03hfyz61adex0n10c7pmf1icj9em].[sum:direct_reports:qk]&quot;' value='# Total Directs incl. on leave' />
          <alias key='&quot;[federated.03hfyz61adex0n10c7pmf1icj9em].[usr:Calculation_2382685732405280791:qk]&quot;' value='# Total Directs diff.' />
        </aliases>
      </column>
      <column caption='c.SPOC - Scale Trend' datatype='real' name='[Calculation_1832965093713715200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([c.Direct Reports (Total) (copy)_890023921713831946],([c.Direct Reports (Total) (copy)_890023921713831946]+1))' />
      </column>
      <column caption='c.Date (Year = latest year)' datatype='integer' name='[Calculation_1832965093720199171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR(TODAY())' />
      </column>
      <column caption='c.Color - SPOC Trend' datatype='string' name='[Calculation_1832965093728231432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 3] THEN &quot;Current Year&quot;&#13;&#10;ELSEIF DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 3] - 1 THEN &quot;Previous Year&quot;&#13;&#10;ELSE &quot;Other Years&quot;&#13;&#10;END' />
      </column>
      <column caption='c.management_level (category)' datatype='string' name='[Calculation_1832965093946494988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEFT([management_level], 1) = &quot;M&quot; OR LEFT([management_level], 1) = &quot;E&quot; THEN &quot;M plus&quot; &#13;&#10;ELSEIF LEFT([management_level], 2) = &quot;IC&quot; THEN &quot;IC&quot;&#13;&#10;ELSE &quot;S&quot;&#13;&#10;END' />
      </column>
      <column caption='c.Select Dimension' datatype='string' name='[Calculation_1832965093989822486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p.View By (Bars) (copy)_3104106067960229889]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#13;&#10;    WHEN &quot;Management Level&quot; then [management_level (copy)_1832965093931302922]&#13;&#10;    WHEN &quot;Management Level Groups&quot; then [c.management_level group (sort) (copy)_829506803069911042]&#13;&#10;    WHEN &quot;Management Level Groups (DH)&quot; then [management_level (sort) (copy)_1832965093932339211]&#13;&#10;    //WHEN &quot;Management Level Groups (PedidosYa)&quot; then [c.management_level sort (PedidosYa)]&#13;&#10;    WHEN &quot;Tenure Category&quot; then [tenure_category]&#13;&#10;    WHEN &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Department&quot; then [Calculation_890023921708650499] //[department]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [sub_department]&#10;    WHEN &quot;Cost Center Name&quot; then [cost_center_name]&#13;&#10;    WHEN &quot;Region&quot; then [region]&#13;&#10;    WHEN &quot;Country&quot; then [country]&#13;&#10;    WHEN &quot;Scope&quot; then [scope]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#10;    WHEN &quot;Company&quot; then [company_name]&#10;    WHEN &quot;Glovo&quot; then [supervisory_group]&#10;    WHEN &quot;Job Family Group&quot; then [job_family_group]&#10;    WHEN &quot;Job Family&quot; then [job_family]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Female&quot;' value='Women' />
          <alias key='&quot;Male&quot;' value='Men' />
        </aliases>
      </column>
      <column caption='c.Date (Today)' datatype='date' name='[Calculation_1903615316309291008]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='c.Filter - Brands (Trend - Brand)' datatype='integer' name='[Calculation_2261088533158719492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [brand]=[Parameters].[Parameter 12] or [brand]=[Parameters].[Attribute 1 (copy)_2261088533158469635]  or [brand]=[Parameters].[Attribute 2 (copy)_2261088533159288837]  then 1 else 0 END' />
      </column>
      <column caption='c.Select Dimension (Sorted by)' datatype='integer' name='[Calculation_2325616684272492544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[p.View By (Bars) (copy)_3104106067960229889] IN (&#10;    &apos;Management Level&apos;, &#10;    &apos;Management Level Groups&apos;, &#10;    &apos;Management Level Groups (DH)&apos;, &#10;    &apos;Management Level Groups (PedidosYa)&apos;, &#10;    &apos;Tenure Category&apos;&#10;) THEN 0&#10;ELSE RANK_UNIQUE([c.Direct Reports (Total) (copy)_890023921713831946], &apos;desc&apos;)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Index' datatype='integer' name='[Calculation_3196570573180395520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.headcount (management_level)' datatype='integer' name='[Calculation_3578813591608602624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [g.management_level (group) (copy)_2123236130298503171]: COUNTD([employee_id])}' />
      </column>
      <column caption='c.MLD - Ratio' datatype='real' default-format='n#,##0&quot;%&quot;;-#,##0&quot;%&quot;' name='[Calculation_3578813591611441156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#10;([Calculation_890023921694015489] / SUM([Calculation_3578813591608602624])) * 100&#10;,0)' />
      </column>
      <column caption='c.SPOC - Stacked/Unstacked' datatype='real' name='[Calculation_447545259592482824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Stacked&apos; THEN &#13;&#10;    SUM([Calculation_890023921712082949]) / TOTAL(SUM([Calculation_890023921712082949]))&#13;&#10;ELSE &#13;&#10;    SUM([Calculation_890023921712082949])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.Org Layers - Split by' datatype='string' name='[Calculation_478226032132526088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;Employee/People Manager&quot; THEN         &#13;&#10;    [c.Org Layers - Split by (copy)_829506803405127694]&#13;&#10;ELSE&#13;&#10;    [c.Select Dimension (copy)_351562297913196545]&#13;&#10;END' />
        <aliases>
