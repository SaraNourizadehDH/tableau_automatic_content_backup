          <datasource-dependencies datasource='federated.03hfyz61adex0n10c7pmf1icj9em'>
            <column caption='c.management_level (category)' datatype='string' name='[Calculation_1832965093946494988]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LEFT([management_level], 1) = &quot;M&quot; OR LEFT([management_level], 1) = &quot;E&quot; THEN &quot;M plus&quot; &#13;&#10;ELSEIF LEFT([management_level], 2) = &quot;IC&quot; THEN &quot;IC&quot;&#13;&#10;ELSE &quot;S&quot;&#13;&#10;END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_1991998456155861023]' role='measure' type='quantitative' user:unnamed='Sheet 12'>
              <calculation class='tableau' formula='0' />
            </column>
            <column aggregation='Sum' caption='c.Direct Reports (Total)' datatype='integer' name='[Calculation_890023921712082949]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = FALSE THEN&#10;    [e_direct_reports_with_on_leave]&#10;    + [m_direct_reports_with_on_leave]&#10;    + [ic_direct_reports_with_on_leave]&#10;    + [p_direct_reports_with_on_leave]&#10;&#10;    + [c.Open Positions (Direct Reports) (copy)_890023921712660489]&#10;ELSE&#10;    [e_direct_reports]&#10;    + [m_direct_reports]&#10;    + [ic_direct_reports]&#10;    + [p_direct_reports]&#10;&#10;    + [c.Open Positions (Direct Reports) (copy)_890023921712660489]&#10;END&#10;+ [c.Total Direct Reports (copy)_890023921712549896]&#10;&#10;/*&#10;//Add Lent/Borrow &#10;&#10;IF [p.On Leave - Direct Report?] = TRUE THEN&#10;    IF [p.Include Lent/Borrow - Direct Report?] = TRUE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports]&#10;            + [m_direct_reports]&#10;            + [ic_direct_reports]&#10;            + [p_direct_reports]&#10;            + [s_direct_reports]&#10;&#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports]&#10;            + [m_direct_reports]&#10;            + [ic_direct_reports]&#10;            + [p_direct_reports]&#10;                &#10;        END&#10;    ELSEIF [p.Include Lent/Borrow - Direct Report?] = FALSE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports_lent_borrowed]&#10;            + [m_direct_reports_lent_borrowed]&#10;            + [ic_direct_reports_lent_borrowed]&#10;            + [p_direct_reports_lent_borrowed]&#10;            + [s_direct_reports_lent_borrowed]&#10;                &#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_lent_borrowed]&#10;            + [m_direct_reports_lent_borrowed]&#10;            + [ic_direct_reports_lent_borrowed]&#10;            + [p_direct_reports_lent_borrowed]&#10;&#10;        END&#10;    END&#10;&#10;&#10;ELSEIF [p.On Leave - Direct Report?] = FALSE THEN&#10;    IF [p.Include Lent/Borrow - Direct Report?] = TRUE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports_with_on_leave]&#10;            + [m_direct_reports_with_on_leave]&#10;            + [ic_direct_reports_with_on_leave]&#10;            + [p_direct_reports_with_on_leave]&#10;            + [s_direct_reports_with_on_leave]&#10;            &#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_with_on_leave]&#10;            + [m_direct_reports_with_on_leave]&#10;            + [ic_direct_reports_with_on_leave]&#10;            + [p_direct_reports_with_on_leave]&#10;&#10;        END&#10;    ELSEIF [p.Include Lent/Borrow - Direct Report?] = FALSE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;           [e_direct_reports_lent_borrowed_with_on_leave]&#10;            + [m_direct_reports_lent_borrowed_with_on_leave]&#10;            + [ic_direct_reports_lent_borrowed_with_on_leave]&#10;            + [p_direct_reports_lent_borrowed_with_on_leave]&#10;            + [s_direct_reports_lent_borrowed_with_on_leave]&#10;&#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_lent_borrowed_with_on_leave]&#10;            + [m_direct_reports_lent_borrowed_with_on_leave]&#10;            + [ic_direct_reports_lent_borrowed_with_on_leave]&#10;            + [p_direct_reports_lent_borrowed_with_on_leave]&#10;&#10;        END&#10;    END&#10;END&#10;+ [c.Direct Reports (Open Positions)]&#10;*/' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='c.Filter - (Global Hide M5+) (group)' datatype='string' name='[c.Filter - (Global Hide M5+) (copy)_1072912254065577985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Glovo&apos; THEN [c.management_level group (sort) (copy)_829506803069911042] ELSE &apos;&apos; END' />
            </column>
            <column caption='c.Direct Reports (S Employees)' datatype='integer' name='[c.Open Positions (Direct Reports) (copy)_890023921712660489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[p.SPOC - Include Open Positions? (copy)_890023921712431111] = TRUE THEN&#10;    IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = TRUE THEN&#10;        [s_direct_reports]&#10;    ELSE&#10;        [s_direct_reports_with_on_leave]&#10;    END&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='c.Direct Reports (Open Positions)' datatype='integer' name='[c.Total Direct Reports (copy)_890023921712549896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [open_positions] ELSE 0 END' />
            </column>
            <column caption='c.management_level (sub-category)' datatype='string' name='[c.management_level (category) (copy)_1832965093946855437]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1832965093946494988] = &quot;M plus&quot; THEN&#13;&#10;    IF [Calculation_890023921712082949] = 0 THEN &#13;&#10;        &quot;M w/o directs&quot; &#13;&#10;    ELSEIF [Calculation_890023921712082949] &gt; 0 THEN&#13;&#10;        IF [Calculation_890023921712082949] = 1 THEN&#13;&#10;            &quot;M with 1 direct&quot;&#13;&#10;        ELSE&#13;&#10;            &quot;M with &gt; 1 directs&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [Calculation_1832965093946494988] = &quot;IC&quot; THEN&#13;&#10;    IF [Calculation_890023921712082949] = 0 THEN &#13;&#10;        &quot;IC w/o directs&quot; &#10;    ELSEIF [Calculation_890023921712082949] = 1 THEN&#10;        &quot;IC with 1 direct&quot;&#13;&#10;    ELSEIF [Calculation_890023921712082949] &gt; 0 THEN&#10;        &quot;IC with &gt; 1 directs&quot;&#10;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    &quot;Others&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;IC with 1 direct&quot;' value='ICs with 1 direct report' />
                <alias key='&quot;IC with &gt; 1 directs&quot;' value='ICs with &gt; 1 direct reports' />
                <alias key='&quot;M w/o directs&quot;' value='Ms without direct reports' />
                <alias key='&quot;M with 1 direct&quot;' value='Ms with 1 direct report' />
              </aliases>
            </column>
            <column caption='c.management_level sort (group)' datatype='string' name='[c.management_level group (sort) (copy)_829506803069911042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [g.management_level (group) (copy)_829506803069571073]&#13;&#10;    WHEN &apos;E&apos; THEN &apos;a. E&apos;&#13;&#10;    WHEN &apos;M&apos; THEN &apos;b. M&apos;&#13;&#10;    WHEN &apos;IC&apos; THEN &apos;c. IC&apos;&#13;&#10;    WHEN &apos;S&apos; THEN &apos;d. S&apos;&#13;&#10;    ELSE &apos;z. null&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;a. E&quot;' value='E-Level HC' />
                <alias key='&quot;b. M&quot;' value='M-Level HC' />
                <alias key='&quot;c. IC&quot;' value='IC-Level HC' />
                <alias key='&quot;d. S&quot;' value='S-Level HC' />
                <alias key='&quot;z. null&quot;' value='Null' />
              </aliases>
            </column>
            <column aggregation='Sum' datatype='integer' name='[e_direct_reports]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[e_direct_reports_with_on_leave]' role='measure' type='quantitative' />
            <column caption='g.management_level (group)' datatype='string' name='[g.management_level (group) (copy)_829506803069571073]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
                <bin default-name='false' value='&quot;E&quot;'>
                  <value>&quot;E1&quot;</value>
                  <value>&quot;E2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IC&quot;'>
                  <value>&quot;IC1&quot;</value>
                  <value>&quot;IC2&quot;</value>
                  <value>&quot;IC3&quot;</value>
                  <value>&quot;IC4&quot;</value>
                  <value>&quot;IC5&quot;</value>
                  <value>&quot;IC6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;M&quot;'>
                  <value>&quot;M1&quot;</value>
                  <value>&quot;M2&quot;</value>
                  <value>&quot;M3&quot;</value>
                  <value>&quot;M4&quot;</value>
                  <value>&quot;M5&quot;</value>
                  <value>&quot;M6&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;S&quot;'>
                  <value>&quot;S1&quot;</value>
                  <value>&quot;S2&quot;</value>
                  <value>&quot;S3&quot;</value>
                  <value>&quot;S4&quot;</value>
                </bin>
              </calculation>
            </column>
            <column aggregation='Sum' datatype='integer' name='[ic_direct_reports]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[ic_direct_reports_with_on_leave]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[m_direct_reports]' role='dimension' type='ordinal' />
