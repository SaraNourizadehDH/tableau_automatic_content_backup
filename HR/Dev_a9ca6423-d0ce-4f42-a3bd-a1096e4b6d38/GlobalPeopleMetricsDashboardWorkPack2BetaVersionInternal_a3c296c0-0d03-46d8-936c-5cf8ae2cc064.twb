            <column caption='c.Date Lookup' datatype='date' name='[c.Filter (Last 12-m) (copy)_2213800740245303310]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MIN([date_month]) = MAKEDATE([Parameters].[Parameter 3], [Parameters].[Parameter 2], 1) THEN&#13;&#10;    LOOKUP(MIN([date_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
