            <column caption='p.Select Dimension' datatype='string' name='[p.View By (Bars) (copy)_3104106067960229889]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
              <calculation class='tableau' formula='&quot;Department&quot;' />
