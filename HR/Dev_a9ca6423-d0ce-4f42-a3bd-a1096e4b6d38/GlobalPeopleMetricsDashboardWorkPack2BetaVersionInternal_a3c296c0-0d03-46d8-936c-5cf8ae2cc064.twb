            <column datatype='integer' name='[e_direct_reports_with_on_leave]' role='measure' type='quantitative' />
            <column datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' datatype-customized='true' name='[employee_on_leave_status]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;0&quot;' value='Active' />
                <alias key='&quot;1&quot;' value='On Leave' />
              </aliases>
            </column>
            <column aggregation='Sum' datatype='integer' name='[ic_direct_reports]' role='dimension' type='ordinal' />
