            <column caption='c.Color - Ms w/o directs (yoy)' datatype='integer' name='[c.Color - MLD Manager Ratio (yoy) (copy)_2213800740580495413]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SIGN([c.MLD - Manager Ratio (yoy changes) (copy)_2213800740579090480])'>
