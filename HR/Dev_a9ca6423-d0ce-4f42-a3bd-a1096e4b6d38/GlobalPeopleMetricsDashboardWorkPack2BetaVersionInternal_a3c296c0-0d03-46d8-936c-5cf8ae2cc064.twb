            <column caption='c.Direct Reports (S Employees)' datatype='integer' name='[c.Open Positions (Direct Reports) (copy)_890023921712660489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[p.SPOC - Include Open Positions? (copy)_890023921712431111] = TRUE THEN&#10;    IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = TRUE THEN&#10;        [s_direct_reports]&#10;    ELSE&#10;        [s_direct_reports_with_on_leave]&#10;    END&#10;ELSE&#10;    0&#10;END' />
