                  <format attr='margin' value='6' />
                  <format attr='margin-right' value='0' />
                  <format attr='margin-left' value='0' />
                  <format attr='background-color' value='#0f1125' />
                </zone-style>
              </zone>
              <zone h='94058' id='11' type-v2='empty' w='3200' x='533' y='5471'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='94058' id='12' type-v2='empty' w='2400' x='97067' y='5471'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='94058' id='14' param='vert' type-v2='layout-flow' w='93334' x='3733' y='5471'>
                <zone fixed-size='1429' h='84059' id='73' is-fixed='true' param='vert' type-v2='layout-flow' w='93334' x='3733' y='5471'>
                  <zone fixed-size='7' h='883' id='26' is-fixed='true' type-v2='empty' w='89468' x='5666' y='5471'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='770' h='45294' id='2063' is-fixed='true' param='horz' type-v2='layout-flow' w='89468' x='5666' y='6354'>
                    <zone fixed-size='1079' forceUpdate='true' h='45176' id='2015' is-fixed='true' type-v2='text' w='72466' x='5733' y='6413'>
                      <formatted-text>
                        <run bold='true' fontcolor='#4629ff' fontsize='12'>Overview</run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#000000' fontsize='11'>This dashboard is designed to standardize organizational design efficiency and improve visibility across all brands. By tracking key metrics such as </run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Spans of Control, Org Layers, Management Level Distribution, Ms without direct reports, and ICs with direct reports</run>
                        <run fontcolor='#000000' fontsize='11'> the dashboard will help identify areas for improvement, optimize structure, and enable better decision-making for enhanced operational efficiency.</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#4629ff' fontsize='12'>Data Source Description</run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#000000' fontsize='11'>This dashboard primarily utilizes </run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Workday </run>
                        <run fontcolor='#000000' fontsize='11'>and </run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>SmartRecruiters </run>
                        <run fontcolor='#000000' fontsize='11'>data for open roles, used by Include Open Roles Direct filter. It is refreshed daily to ensure the dashboard reflects the latest available data in the system.</run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#000000' fontsize='11'>The dataset is filtered to only </run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>INCLUDE</run>
                        <run fontcolor='#000000' fontsize='11'> active employees and </run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>EXCLUDES</run>
                        <run fontcolor='#000000' fontsize='11'> the following population as aligned with brands:</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Talabat:</run>
                        <run fontcolor='#000000' fontsize='11'> Interns, Consultants, Freelancers, and Contingent Workers.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Glovo:</run>
                        <run fontcolor='#000000' fontsize='11'> Permanent Pickers and Agents.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>PedidosYa:</run>
                        <run fontcolor='#000000' fontsize='11'> Shift Supervisors, Store Managers, and Pickers.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Pandora:</run>
                        <run fontcolor='#000000' fontsize='11'>  All employees and planned to integrate once Workday data is stable.</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Lent/Borrow</run>
                        <run fontcolor='#000000' fontsize='11'> scenarios are taken into consideration on this dashboard. Employees within local entities, who report to Central are automatically assigned to Brand = Delivery Hero. To understand more about the logic and implementation, please reach out to @jan.paje@deliveryhero.com / Central People Analytics Team.</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#4629ff' fontsize='12'>Metrics Definitions</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>People Manager</run>
                        <run fontcolor='#000000' fontsize='11'>: Represents the employees who has at least 1 direct reports. It does not cover Managers without direct reports.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Spans of Control</run>
                        <run fontcolor='#000000' fontsize='11'>: Average amount of direct employees reporting under a People Manager. M track employees with no direct reports are not accounted for in this metric. IC track with direct reports are accounted for in this metric.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Org Layers: </run>
                        <run fontcolor='#000000' fontsize='11'>Number of hierarchical levels within the organization.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>People Manager Ratio: </run>
                        <run fontcolor='#000000' fontsize='11'>Proportion of People Managers over the total headcount.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>Ms Without Direct Reports: </run>
                        <run fontcolor='#000000' fontsize='11'>Number of managers (M+) who do not currently have any employees reporting directly to them within the specified reporting period.</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#000000' fontsize='11'>ICs With Direct Reports: </run>
                        <run fontcolor='#000000' fontsize='11'>Number of individual contributors (IC) who have one or more employees reporting directly to them within the specified reporting period.</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                        <format attr='padding' value='16' />
                      </zone-style>
                    </zone>
                    <zone fixed-size='2' h='45176' id='2065' is-fixed='true' type-v2='empty' w='133' x='78199' y='6413'>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                        <format attr='margin-top' value='40' />
                        <format attr='margin-bottom' value='40' />
                        <format attr='margin-left' value='0' />
                        <format attr='background-color' value='#f5f5f5' />
                      </zone-style>
