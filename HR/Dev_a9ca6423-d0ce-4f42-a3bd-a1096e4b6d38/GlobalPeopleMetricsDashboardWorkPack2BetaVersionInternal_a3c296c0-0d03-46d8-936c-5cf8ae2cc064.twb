      <column caption='u.User Filter (Worksheet level)' datatype='string' name='[u.User Filter (Worksheet level) - Scope (copy)_1497306149089079297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// APPLIED ON EMPLOYEE LIST TABLE WORKSHEETS&#10;STR(&#10;    IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;    ELSEIF USERNAME() = &apos;xenia.rauch@deliveryhero.com&apos; THEN 1&#10;    ELSEIF ISMEMBEROF(&apos;DH Entity People Leads&apos;) THEN 1&#10;    ELSEIF ISMEMBEROF(&apos;DH People Leadership&apos;) THEN 1&#10;&#10;    ELSEIF [brand] = &apos;Delivery Hero&apos; THEN&#10;        IF ISMEMBEROF(&apos;DH People Partners&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;DH International - Performance&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Total Rewards&apos;) THEN 1&#10;        END&#10;&#10;    ELSEIF [brand] = &apos;EFood&apos; OR [brand] = &apos;Foody&apos; THEN&#10;        IF ISMEMBEROF(&apos;eFood - Administrator&apos;) THEN 1&#10;        ELSEIF [brand] = &apos;EFood&apos; AND ISMEMBEROF(&apos;eFood - People Partners&apos;) THEN 1 &#10;        END&#10;&#10;    ELSEIF [brand] = &apos;Hungerstation&apos; THEN&#10;        IF ISMEMBEROF(&apos;Hungerstation - Administrator&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Hungerstation - C Level&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Hungerstation - CEO&apos;) THEN 1&#10;        END&#10;    &#10;    ELSEIF [brand] = &apos;PedidosYa&apos; THEN&#10;        IF ISMEMBEROF(&apos;Pedidos Ya - Administrator&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;PedidosYa - People Heads&apos;) THEN 1&#10;        ELSEIF USERNAME() = &apos;milagros.rotger@pedidosya.com&apos; THEN 1&#10;        ELSEIF USERNAME() = &apos;florencia.morgan@pedidosya.com&apos; THEN 1&#10;        ELSEIF USERNAME() = &apos;maria.giambenedetti@pedidosya.com&apos; THEN 1&#10;        END&#10;&#10;    ELSEIF [brand] = &apos;Talabat&apos; THEN&#10;        IF ISMEMBEROF(&apos;Talabat - Administrator&apos;) THEN 1&#10;        ELSEIF USERNAME()=(&apos;sirin.seymen@talabat.com&apos;) THEN 1&#10;        ELSEIF USERNAME()=(&apos;stefano.vecchio@talabat.com&apos;) THEN 1&#10;        END&#10;    &#10;    ELSEIF [brand] = &apos;Woowa&apos; THEN&#10;        IF ISMEMBEROF(&apos;Woowa - Administrator&apos;) THEN 1 END&#10;    &#10;    ELSEIF [brand] = &apos;Glovo&apos; THEN&#10;        IF ISMEMBEROF(&apos;Glovo - Administrator&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Glovo - C-Level&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Glovo - People Leadership&apos;) THEN 1&#10;&#10;        /* GLOVO SCOPE LOGIC */&#10;        // SEE&#10;        ELSEIF USERNAME() IN (&apos;agustina.cavotta@glovoapp.com&apos;, &apos;diana.sandu@glovoapp.com&apos;, &apos;kristiana.hadzhilarska@glovoapp.com&apos;) THEN&#10;        IF [supervisory_org_region] = &apos;Total SEE&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;iva.bikanec@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] = &apos;Croatia&apos; THEN 1 ELSE 0 END&#10;&#10;        // Africa and Italy&#10;        ELSEIF USERNAME() IN (&apos;ginevra.motta@glovoapp.com&apos;, &apos;tommaso.frigieri@glovoapp.com&apos;) THEN&#10;        IF [supervisory_org_region] = &apos;Total Africa&apos; OR [supervisory_group] = &apos;Italy&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;giulia.zema@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] = &apos;Italy&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() IN (&apos;amal.ihrouchen@glovoapp.com&apos;, &apos;siwar.jrad@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] IN (&apos;Morocco&apos;, &apos;Tunisia&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;michael.akinyemi@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Nigeria&apos;, &apos;Ivory Coast&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;byrone.tiaya@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] = &apos;Ivory Coast&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;christabella.natukunda@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Uganda&apos;, &apos;Kenya&apos;, &apos;Nigeria&apos;) THEN 1 ELSE 0 END&#10;&#10;        // PLECA&#10;        ELSEIF USERNAME() IN (&apos;flor.badalucco@glovoapp.com&apos;, &apos;henri.hebrard@glovoapp.com&apos;) THEN&#10;        IF [supervisory_org_region] = &apos;Total PLECA&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() IN (&apos;anna.nowickamejssner@glovoapp.com&apos;, &apos;ewa.szacillo@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] = &apos;Poland&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() IN (&apos;dana.abisheva@glovoapp.com&apos;, &apos;polina.abugaliyeva@glovoapp.com&apos;, &apos;dalia.puyesky@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] IN (&apos;Kyrgyzstan&apos;, &apos;Kazakhstan&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;daria.andreieva@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] = &apos;Ukraine&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;salome.kvakhadze@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Georgia&apos;, &apos;Armenia&apos;) THEN 1 ELSE 0 END&#10;&#10;        // Tech&#10;        ELSEIF USERNAME() IN (&apos;martin.drabble@glovoapp.com&apos;, &apos;ligia.paoletti@glovoapp.com&apos;, &apos;samantha.astorga@glovoapp.com&apos;, &apos;sofia.celada@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] IN (&apos;Engineering&apos;, &apos;Product&apos;, &apos;Data&apos;) THEN 1 ELSE 0 END&#10;&#10;        // Operations&#10;        ELSEIF USERNAME() IN (&apos;alejandra.verges@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] IN (&apos;Live Operations&apos;, &apos;Logistics&apos;, &apos;Partner Operations&apos;, &apos;Rest of Operations&apos;, &apos;P&amp;B Brand Ads&apos;, &apos;P&amp;B Commercial&apos;) &#10;        OR [job_family_group] = &apos;Sales&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() IN (&apos;elsa.marquinez@glovoapp.com&apos;, &apos;mar.blanco@glovoapp.com&apos;, &apos;eugenia.cano@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] IN (&apos;Live Operations&apos;, &apos;Logistics&apos;, &apos;Partner Operations&apos;, &apos;Rest of Operations&apos;, &apos;P&amp;B Brand Ads&apos;, &apos;P&amp;B Commercial&apos;) THEN 1 ELSE 0 END&#10;&#10;        // WE&#10;        ELSEIF USERNAME() IN (&apos;marta.marinello@glovoapp.com&apos;, &apos;nathalie.gallaztegui@glovoapp.com&apos;) THEN&#10;        IF [supervisory_group] = &apos;Spain&apos; THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;alberto.garrido@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] = &apos;Portugal&apos; THEN 1 ELSE 0 END&#10;&#10;        // Business HQ&#10;        ELSEIF USERNAME() = &apos;anna.guzowska@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Q Commerce&apos;, &apos;Marketing &amp; Growth&apos;, &apos;On Demand&apos;, &apos;Strategy &amp; New Business&apos;, &apos;Finance&apos;, &apos;Global Affairs&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;isadora.didomenico@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Finance&apos;, &apos;Global Affairs&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;sonia.cabrera@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Q Commerce&apos;, &apos;Marketing &amp; Growth&apos;, &apos;On Demand&apos;, &apos;Strategy &amp; New Business&apos;, &apos;People&apos;) THEN 1 ELSE 0 END&#10;&#10;        ELSEIF USERNAME() = &apos;tatiana.ternovschi@glovoapp.com&apos; THEN&#10;        IF [supervisory_group] IN (&apos;Q Commerce&apos;, &apos;Marketing &amp; Growth&apos;) THEN 1 ELSE 0 END&#10;&#10;        // COEs&#10;        // Access Level = None&#10;        &#10;        ELSEIF ISMEMBEROF(&apos;Glovo - People Partners&apos;) THEN 1&#10;        END&#10;&#10;    ELSEIF [brand] = &apos;Pandora&apos; THEN&#10;        IF USERNAME()=(&apos;batuhan.sagirdas@deliveryhero.com&apos;) THEN 1&#10;        ELSEIF ISMEMBEROF(&apos;Pandora - PLT&apos;) THEN 1&#10;        ELSEIF [region] = &apos;Asia&apos; AND ( ISMEMBEROF(&apos;Foodpanda - Administrator&apos;) OR ISMEMBEROF(&apos;Foodpanda - Administrator Limited&apos;) ) THEN 1&#10;        ELSEIF [region] = &apos;MENA&apos; AND ISMEMBEROF(&apos;Yemeksepeti - Administrator&apos;) THEN 1&#10;        ELSEIF [region] = &apos;Europe&apos; AND ISMEMBEROF(&apos;DH Europe - Administrator&apos;) THEN 1&#10;        END&#10;&#10;    END&#10;)' />
      </column>
