            <column caption='c.Bool (Is Latest Month?)' datatype='boolean' name='[c.Bool (Is Previous Month?) (copy)_1832965093897768969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [date_month]) = DATETRUNC(&apos;month&apos;, TODAY()) THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='c.Color - SPOC (yoy)' datatype='integer' name='[c.Color - SPOC (Bar Total) (copy)_2213800740247019536]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SIGN([c.SPOC (copy)_2213800740239990791])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.SPOC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.Direct Reports (Total) (copy)_890023921713831946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;AVG(&#13;&#10;    IF [Calculation_890023921714491403] = &quot;Y&quot; THEN &#13;&#10;        [Calculation_890023921712082949] &#13;&#10;    END&#13;&#10;)&#10;,1)&#13;&#10;//Average direct reports of People Managers' />
            </column>
            <column caption='c.Direct Reports (S Employees)' datatype='integer' name='[c.Open Positions (Direct Reports) (copy)_890023921712660489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[p.SPOC - Include Open Positions? (copy)_890023921712431111] = TRUE THEN&#10;    IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = TRUE THEN&#10;        [s_direct_reports]&#10;    ELSE&#10;        [s_direct_reports_with_on_leave]&#10;    END&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='c.SPOC (yoy changes)' datatype='real' default-format='*▲ 0.0;▼ 0.0; 0.0' name='[c.SPOC (copy)_2213800740239990791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946],0)&#13;&#10;-&#10;LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946],-12)&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Direct Reports (Open Positions)' datatype='integer' name='[c.Total Direct Reports (copy)_890023921712549896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [open_positions] ELSE 0 END' />
            </column>
