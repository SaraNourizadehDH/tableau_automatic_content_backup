            <column caption='c.Filter (CYTD)' datatype='boolean' name='[c.Date (Year = latest year) (copy)_1832965093721657350]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [date_month]) = [Parameters].[Parameter 3]&#13;&#10;AND DATEPART(&apos;month&apos;, [date_month]) &lt;= [Parameters].[Parameter 2]' />
