                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='73' h='4765' id='2069' is-fixed='true' is-scaled='1' param='Image/User Guide button.png' type-v2='bitmap' url='https://docs.google.com/presentation/d/195wxgPrvHGO4-ZkW2_aLpaSOaQgPJMD0MByZxp2gv7M/edit?slide=id.g23b1f2e0a27_0_8#slide=id.g23b1f2e0a27_0_8' w='13266' x='80067' y='23176'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
