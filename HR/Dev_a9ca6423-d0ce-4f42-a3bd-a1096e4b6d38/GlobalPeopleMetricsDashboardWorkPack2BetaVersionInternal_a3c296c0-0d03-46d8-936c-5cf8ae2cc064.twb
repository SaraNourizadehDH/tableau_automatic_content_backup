              <calculation class='tableau' formula='CASE [g.management_level (group) (copy)_829506803069571073]&#13;&#10;    WHEN &apos;E&apos; THEN &apos;a. E&apos;&#13;&#10;    WHEN &apos;M&apos; THEN &apos;b. M&apos;&#13;&#10;    WHEN &apos;IC&apos; THEN &apos;c. IC&apos;&#13;&#10;    WHEN &apos;S&apos; THEN &apos;d. S&apos;&#13;&#10;    ELSE &apos;z. null&apos;&#13;&#10;END' />
              <aliases>
