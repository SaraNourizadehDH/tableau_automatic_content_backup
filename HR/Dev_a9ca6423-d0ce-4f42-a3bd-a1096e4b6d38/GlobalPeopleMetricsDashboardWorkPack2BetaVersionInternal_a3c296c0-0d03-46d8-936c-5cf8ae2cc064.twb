            </column>
            <column caption='c.management_level sort (DH)' datatype='string' name='[management_level (sort) (copy)_1832965093932339211]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_level (group)]&#13;&#10;    WHEN &apos;E1+&apos; THEN &apos;a. E1+&apos;&#13;&#10;    WHEN &apos;M6&apos; THEN &apos;b. M6&apos;&#13;&#10;    WHEN &apos;M5&apos; THEN &apos;c. M5&apos;&#13;&#10;    WHEN &apos;M4&apos; THEN &apos;d. M4&apos;&#13;&#10;    WHEN &apos;M3&apos; THEN &apos;e. M3&apos;&#13;&#10;    WHEN &apos;M2&apos; THEN &apos;f. M2&apos;&#13;&#10;    WHEN &apos;M1&apos; THEN &apos;g. M1&apos;&#13;&#10;    WHEN &apos;IC4+&apos; THEN &apos;h. IC4+&apos;&#13;&#10;    WHEN &apos;IC3&apos; THEN &apos;i. IC3&apos;&#13;&#10;    WHEN &apos;IC2&apos; THEN &apos;j. IC2&apos;&#13;&#10;    WHEN &apos;IC1&apos; THEN &apos;k. IC1&apos;&#13;&#10;    WHEN &apos;S4&apos; THEN &apos;l. S4&apos;&#13;&#10;    WHEN &apos;S3&apos; THEN &apos;m. S3&apos;&#13;&#10;    WHEN &apos;S2&apos; THEN &apos;n. S2&apos;&#13;&#10;    WHEN &apos;S1&apos; THEN &apos;o. S1&apos;&#13;&#10;    ELSE &apos;z. null&apos;&#13;&#10;END' />
            </column>
