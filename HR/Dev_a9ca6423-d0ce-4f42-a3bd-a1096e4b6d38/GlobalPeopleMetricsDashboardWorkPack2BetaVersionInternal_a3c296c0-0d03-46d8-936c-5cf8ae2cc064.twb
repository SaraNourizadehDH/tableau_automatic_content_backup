      <column caption='c.SPOC - View by (Trend - Overall)' datatype='boolean' name='[Calculation_631629855161507847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &quot;Overall&quot;' />
