            <column caption='c.ICs with directs (ytd changes)' datatype='real' default-format='*▲ 0;▼ 0; 0' name='[c.Ms w/o directs (ytd changes) (copy)_2213800740582248505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    LOOKUP([c.Ms with 1 direct (ratio) (copy)_2116691872280264715], 0) &#13;&#10;    - &#13;&#10;    IF [Parameters].[Parameter 2] = 1 THEN  &#13;&#10;        LOOKUP([c.Ms with 1 direct (ratio) (copy)_2116691872280264715], -1)  // If January, compare with December of the previous year&#13;&#10;    ELSE  &#13;&#10;        LOOKUP([c.Ms with 1 direct (ratio) (copy)_2116691872280264715], - ([Parameters].[Parameter 2] - 1))  // Compare with January of the same year&#13;&#10;    END&#13;&#10;)'>
