            <column caption='c.Org Layer (ytd absolute)' datatype='integer' default-format='n#,##0;-#,##0' name='[c.SPOC (ytd absolute) (copy)_2213800740307472417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN  &#13;&#10;    LOOKUP([c.adj org layers (copy)_198439904617684994], -1)  // If January, compare with December of the previous year&#13;&#10;ELSE  &#13;&#10;    LOOKUP([c.adj org layers (copy)_198439904617684994], - ([Parameters].[Parameter 2] - 1))  // Compare with January of the same year&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Org Layer (ytd changes)' datatype='real' default-format='*▲ 0;▼ 0; 0' name='[c.SPOC (ytd changes) (copy)_2213800740307472420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND&#10;(&#10;LOOKUP([c.adj org layers (copy)_198439904617684994], 0) &#13;&#10;- &#13;&#10;IF [Parameters].[Parameter 2] = 1 THEN  &#13;&#10;    LOOKUP([c.adj org layers (copy)_198439904617684994], -1)  // If January, compare with December of the previous year&#13;&#10;ELSE  &#13;&#10;    LOOKUP([c.adj org layers (copy)_198439904617684994], - ([Parameters].[Parameter 2] - 1))  // Compare with January of the same year&#13;&#10;END&#10;,0)'>
                <table-calc ordering-type='Rows' />
