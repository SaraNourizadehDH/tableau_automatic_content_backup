        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <lod column='[federated.03hfyz61adex0n10c7pmf1icj9em].[sum:Calculation_1991998456155861023:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run bold='true' fontname='Tableau Regular'>Information about this filter:</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Regular' fontsize='9'>This filter enables forecasting of </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>MANAGEMENT LEVEL DISTRIBUTION</run>
                <run fontname='Tableau Regular' fontsize='9'> under the assumption that </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>ALL OPEN POSITIONS </run>
                <run fontname='Tableau Regular' fontsize='9'>are to be </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>FILLED</run>
                <run fontname='Tableau Regular' fontsize='9'>.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Regular'>Limitations:</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Regular' fontsize='9'>1. This filter applies only to the</run>
                <run fontcolor='#ed2e2e' fontname='Tableau Regular' fontsize='9'>Æ </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>MOST RECENT MONTH</run>
                <run fontname='Tableau Regular' fontsize='9'> available in the report.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Regular' fontsize='9'>2. This filter only </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>INCLUDES</run>
                <run fontname='Tableau Regular' fontsize='9'> open positions classified as </run>
                <run fontcolor='#4629ff' fontname='Tableau Regular' fontsize='9'>NEW ROLE</run>
                <run fontname='Tableau Regular' fontsize='9'> and </run>
                <run fontcolor='#ed2e2e' fontname='Tableau Regular' fontsize='9'>EXCLUDES</run>
                <run fontname='Tableau Regular' fontsize='9'> those with </run>
                <run fontcolor='#ed2e2e' fontname='Tableau Regular' fontsize='9'>ON HOLD, CANCELLED</run>
                <run fontname='Tableau Regular' fontsize='9'> job requisition statuses.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Regular' fontsize='9'>3. Glovo open positions are not currently included in this filter due to system differences.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Regular'>Data Source:</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Regular' fontsize='9'>This filter is based on data from SmartRecruiters.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='DH Icons/icon info.png' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
