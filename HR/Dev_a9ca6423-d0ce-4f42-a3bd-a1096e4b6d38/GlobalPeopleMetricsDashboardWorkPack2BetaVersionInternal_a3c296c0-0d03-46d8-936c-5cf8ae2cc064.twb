            </column>
            <column caption='c.Org Layers - Split by' datatype='string' name='[Calculation_478226032132526088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;Employee/People Manager&quot; THEN         &#13;&#10;    [c.Org Layers - Split by (copy)_829506803405127694]&#13;&#10;ELSE&#13;&#10;    [c.Select Dimension (copy)_351562297913196545]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Female&quot;' value='Women' />
                <alias key='&quot;Male&quot;' value='Men' />
                <alias key='&quot;N&quot;' value='Employee' />
                <alias key='&quot;Y&quot;' value='People Manager' />
              </aliases>
            </column>
            <column caption='c.Org Layer (Adjusted)' datatype='string' name='[Calculation_890023921692946432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] &lt;&gt; &quot;Delivery Hero&quot; THEN&#13;&#10;    CASE [organisation_layer]&#13;&#10;        WHEN &apos;Layer 1&apos; THEN &apos;Layer 0&apos;&#13;&#10;        WHEN &apos;Layer 2&apos; THEN &apos;Layer 1&apos;&#13;&#10;        WHEN &apos;Layer 3&apos; THEN &apos;Layer 2&apos;&#13;&#10;        WHEN &apos;Layer 4&apos; THEN &apos;Layer 3&apos;&#13;&#10;        WHEN &apos;Layer 5&apos; THEN &apos;Layer 4&apos;&#13;&#10;        WHEN &apos;Layer 6&apos; THEN &apos;Layer 5&apos;&#13;&#10;        WHEN &apos;Layer 7&apos; THEN &apos;Layer 6&apos;&#13;&#10;        WHEN &apos;Layer 8&apos; THEN &apos;Layer 7&apos;&#13;&#10;        WHEN &apos;Layer 9&apos; THEN &apos;Layer 8&apos;&#13;&#10;        WHEN &apos;Layer 10&apos; THEN &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    [organisation_layer]&#13;&#10;END' />
            </column>
            <column caption='c.Filter - Department (cleaned)' datatype='string' name='[Calculation_890023921708650499]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Talabat&apos; THEN&#10;    IF CONTAINS([manager_id_concat],&quot;2020-06-2823&quot;) THEN    &#10;    (&#10;        IF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;) THEN&#10;            &quot;Q-commerce&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) THEN //and [is_terminated]=1&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;) THEN&#10;            &quot;Tech &amp; Product&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;) THEN&#10;            &quot;Finance and Legal&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;) THEN&#10;            &quot;Tech &amp; Product&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;) THEN&#10;        (&#10;            IF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) &#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;)&#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2120&quot;)&#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0177&quot;)&#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;)   &#10;            THEN&#10;                &quot;Strategy &amp; Comms&quot;&#10;            ELSEIF contains(lower([department]),&quot;strategy&quot;) THEN&#10;                &quot;Strategy &amp; Comms&quot;&#10;            ELSE&#10;                &quot;People and Culture&quot;&#10;            END&#10;        )&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;) THEN&#10;            &quot;Strategy &amp; Comms&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;) THEN&#10;            &quot;People and Culture&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;) THEN&#10;            &quot;Chief Business Office&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;) THEN&#10;            &quot;Social Commerce&quot;&#10;        ELSE&#10;            &quot;Unspecified&quot;&#10;        END&#10;    )&#10;    ELSEIF [employee_id]=&quot;2020-06-2823&quot; THEN&#10;        &quot;CEO&quot;&#10;    ELSEIF [employee_id]=&quot;2020-06-2821&quot; THEN&#10;        &quot;People and Culture&quot;&#10;    ELSE&#10;        &quot;DHSE&quot;&#10;    END&#10;&#10;&#10;/*&#10;    IF CONTAINS([manager_id_concat],&quot;2020-06-2823&quot;) THEN&#9;&#10;    (&#10;        IF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-1616&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0247&quot;) THEN&#10;            &quot;Q-commerce&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-11-1327&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-01-0022&quot;) THEN&#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2825&quot;) THEN //and [is_terminated]=1 &#10;            &quot;COO&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2813&quot;) THEN&#10;            &quot;Tech &amp; Product&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2824&quot;) THEN&#10;            &quot;Finance &amp; Legal&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2830&quot;) THEN&#10;            &quot;Tech &amp; Product&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-08-0388&quot;) THEN&#10;        (&#10;            IF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2806&quot;) &#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0158&quot;)&#10;            OR CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-0244&quot;) &#10;            THEN&#10;                &quot;Strategy &amp; Comms&quot;&#10;            ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;) THEN&#10;                &quot;Strategy &amp; Comms&quot;&#10;            ELSE&#10;                &quot;People &amp; Culture&quot;&#10;            END&#10;        )&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2822&quot;) THEN&#10;            &quot;Strategy &amp; Comms&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-06-2821&quot;) THEN&#10;            &quot;People &amp; Culture&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2020-09-0072&quot;) THEN&#10;            &quot;Chief Business Office&quot;&#10;        ELSEIF CONTAINS([manager_id_concat]+[employee_id],&quot;2021-09-0243&quot;) THEN&#10;            &quot;Social Commerce&quot;&#10;        ELSE&#10;            &quot;Unspecified&quot;&#10;        END&#10;    )&#10;    ELSEIF [employee_id]=&quot;2020-06-2823&quot; THEN&#10;        &quot;CEO&quot;&#10;    ELSEIF [employee_id]=&quot;2020-06-2821&quot; THEN&#10;        &quot;People &amp; Culture&quot;&#10;    ELSE&#10;        &quot;DHSE&quot;&#10;    END&#13;&#10;*/&#10;&#13;&#10;ELSE&#13;&#10;    [department]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='c.Direct Reports (Total)' datatype='integer' name='[Calculation_890023921712082949]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = FALSE THEN&#10;    [e_direct_reports_with_on_leave]&#10;    + [m_direct_reports_with_on_leave]&#10;    + [ic_direct_reports_with_on_leave]&#10;    + [p_direct_reports_with_on_leave]&#10;&#10;    + [c.Open Positions (Direct Reports) (copy)_890023921712660489]&#10;ELSE&#10;    [e_direct_reports]&#10;    + [m_direct_reports]&#10;    + [ic_direct_reports]&#10;    + [p_direct_reports]&#10;&#10;    + [c.Open Positions (Direct Reports) (copy)_890023921712660489]&#10;END&#10;+ [c.Total Direct Reports (copy)_890023921712549896]&#10;&#10;/*&#10;//Add Lent/Borrow &#10;&#10;IF [p.On Leave - Direct Report?] = TRUE THEN&#10;    IF [p.Include Lent/Borrow - Direct Report?] = TRUE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports]&#10;            + [m_direct_reports]&#10;            + [ic_direct_reports]&#10;            + [p_direct_reports]&#10;            + [s_direct_reports]&#10;&#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports]&#10;            + [m_direct_reports]&#10;            + [ic_direct_reports]&#10;            + [p_direct_reports]&#10;                &#10;        END&#10;    ELSEIF [p.Include Lent/Borrow - Direct Report?] = FALSE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports_lent_borrowed]&#10;            + [m_direct_reports_lent_borrowed]&#10;            + [ic_direct_reports_lent_borrowed]&#10;            + [p_direct_reports_lent_borrowed]&#10;            + [s_direct_reports_lent_borrowed]&#10;                &#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_lent_borrowed]&#10;            + [m_direct_reports_lent_borrowed]&#10;            + [ic_direct_reports_lent_borrowed]&#10;            + [p_direct_reports_lent_borrowed]&#10;&#10;        END&#10;    END&#10;&#10;&#10;ELSEIF [p.On Leave - Direct Report?] = FALSE THEN&#10;    IF [p.Include Lent/Borrow - Direct Report?] = TRUE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;            [e_direct_reports_with_on_leave]&#10;            + [m_direct_reports_with_on_leave]&#10;            + [ic_direct_reports_with_on_leave]&#10;            + [p_direct_reports_with_on_leave]&#10;            + [s_direct_reports_with_on_leave]&#10;            &#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_with_on_leave]&#10;            + [m_direct_reports_with_on_leave]&#10;            + [ic_direct_reports_with_on_leave]&#10;            + [p_direct_reports_with_on_leave]&#10;&#10;        END&#10;    ELSEIF [p.Include Lent/Borrow - Direct Report?] = FALSE THEN&#10;        IF [p.Include &apos;S&apos; Employees?] = TRUE THEN&#10;           [e_direct_reports_lent_borrowed_with_on_leave]&#10;            + [m_direct_reports_lent_borrowed_with_on_leave]&#10;            + [ic_direct_reports_lent_borrowed_with_on_leave]&#10;            + [p_direct_reports_lent_borrowed_with_on_leave]&#10;            + [s_direct_reports_lent_borrowed_with_on_leave]&#10;&#10;        ELSEIF [p.Include &apos;S&apos; Employees?] = FALSE THEN&#10;            [e_direct_reports_lent_borrowed_with_on_leave]&#10;            + [m_direct_reports_lent_borrowed_with_on_leave]&#10;            + [ic_direct_reports_lent_borrowed_with_on_leave]&#10;            + [p_direct_reports_lent_borrowed_with_on_leave]&#10;&#10;        END&#10;    END&#10;END&#10;+ [c.Direct Reports (Open Positions)]&#10;*/' />
