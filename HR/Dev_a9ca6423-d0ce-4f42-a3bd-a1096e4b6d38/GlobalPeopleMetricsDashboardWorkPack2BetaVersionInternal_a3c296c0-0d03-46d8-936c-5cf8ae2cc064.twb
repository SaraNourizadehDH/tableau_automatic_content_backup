              <calculation class='tableau' formula='(&#10;LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], 0) &#13;&#10;- &#13;&#10;IF MONTH(MIN([date_month])) = 1 THEN  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], -1)  // If January, compare with December of the previous year&#13;&#10;ELSE  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], - (MONTH(MIN([date_month])) - 1))  // Compare with January of the same year&#13;&#10;END&#10;)'>
