          <alias key='&quot;Male&quot;' value='Men' />
          <alias key='&quot;N&quot;' value='Employee' />
          <alias key='&quot;Y&quot;' value='People Manager' />
        </aliases>
      </column>
      <column caption='c.SPOC - View by (Trend - Brand)' datatype='boolean' name='[Calculation_628252149835997185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;Brand&apos;' />
