              <calculation class='tableau' formula='IF ISNULL(ATTR([Calculation_1832965093989822486])) THEN&#13;&#10;    &quot;0&quot;  // No color for NULL values&#13;&#10;ELSEIF WINDOW_MAX(COUNTD([Calculation_1832965093989822486])) = 1 THEN&#13;&#10;    &quot;1&quot;  // Color only the grand total row&#13;&#10;ELSE&#13;&#10;    &quot;2&quot;  // No color for other rows&#13;&#10;END'>
