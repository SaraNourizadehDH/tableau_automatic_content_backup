      <column caption='c.management_level sort' datatype='string' name='[management_level (copy)_1832965093931302922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [management_level]&#13;&#10;    WHEN &apos;E2&apos; THEN &apos;a. E2&apos;&#13;&#10;    WHEN &apos;E1&apos; THEN &apos;b. E1&apos;&#13;&#10;    WHEN &apos;M6&apos; THEN &apos;c. M6&apos;&#13;&#10;    WHEN &apos;M5&apos; THEN &apos;d. M5&apos;&#13;&#10;    WHEN &apos;M4&apos; THEN &apos;e. M4&apos;&#13;&#10;    WHEN &apos;M3&apos; THEN &apos;f. M3&apos;&#13;&#10;    WHEN &apos;M2&apos; THEN &apos;h. M2&apos;&#13;&#10;    WHEN &apos;M1&apos; THEN &apos;i. M1&apos;&#13;&#10;    WHEN &apos;IC6&apos; THEN &apos;j. IC6&apos;&#13;&#10;    WHEN &apos;IC5&apos; THEN &apos;k. IC5&apos;&#13;&#10;    WHEN &apos;IC4&apos; THEN &apos;l. IC4&apos;&#13;&#10;    WHEN &apos;IC3&apos; THEN &apos;m. IC3&apos;&#13;&#10;    WHEN &apos;IC2&apos; THEN &apos;n. IC2&apos;&#13;&#10;    WHEN &apos;IC1&apos; THEN &apos;o. IC1&apos;&#13;&#10;    WHEN &apos;S4&apos; THEN &apos;p. S4&apos;&#13;&#10;    WHEN &apos;S3&apos; THEN &apos;q. S3&apos;&#13;&#10;    WHEN &apos;S2&apos; THEN &apos;r. S2&apos;&#13;&#10;    WHEN &apos;S1&apos; THEN &apos;s. S1&apos;&#13;&#10;    ELSE &apos;z. null&apos;&#13;&#10;END' />
      </column>
      <column caption='g.management_level (DH)' datatype='string' name='[management_level (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
          <bin default-name='false' value='&quot;E1+&quot;'>
