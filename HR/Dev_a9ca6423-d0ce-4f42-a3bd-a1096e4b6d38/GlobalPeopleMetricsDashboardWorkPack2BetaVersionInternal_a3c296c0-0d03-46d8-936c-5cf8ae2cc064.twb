            <column caption='c.Org Layer (qoq changes)' datatype='real' default-format='*▲ 0;▼ 0; 0' name='[c.SPOC (qoq changes) (copy)_6754766175759286284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND&#10;(&#10;    LOOKUP([c.adj org layers (copy)_198439904617684994],0) - &#10;    ([c.SPOC (qoq absolute) (copy)_6754766175759286285])&#10;,0)'>
