              <calculation class='tableau' formula='CASE [Parameters].[p.Select Dimension (copy)_1991998456121430043]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#13;&#10;    WHEN &quot;Management Level&quot; then [management_level (copy)_1832965093931302922]&#13;&#10;    WHEN &quot;Management Level Groups&quot; then [c.management_level group (sort) (copy)_829506803069911042]&#13;&#10;    WHEN &quot;Management Level Groups (DH)&quot; then [management_level (sort) (copy)_1832965093932339211]&#13;&#10;    //WHEN &quot;Management Level Groups (PedidosYa)&quot; then [c.management_level sort (PedidosYa)]&#13;&#10;    WHEN &quot;Tenure Category&quot; then [tenure_category]&#13;&#10;    WHEN &quot;Gender&quot; then [gender]&#13;&#10;    WHEN &quot;Department&quot; then [Calculation_890023921708650499] //[department]&#13;&#10;    WHEN &quot;Sub-Department&quot; then [sub_department]&#10;    WHEN &quot;Cost Center Name&quot; then [cost_center_name]&#13;&#10;    WHEN &quot;Region&quot; then [region]&#13;&#10;    WHEN &quot;Country&quot; then [country]&#13;&#10;    WHEN &quot;Scope&quot; then [scope]&#13;&#10;    WHEN &quot;Brand&quot; then [brand]&#10;    WHEN &quot;Company&quot; then [company_name]&#10;    WHEN &quot;Glovo&quot; then [supervisory_group]&#10;    WHEN &quot;Job Family Group&quot; then [job_family_group]&#10;    WHEN &quot;Job Family&quot; then [job_family]&#13;&#10;END' />
