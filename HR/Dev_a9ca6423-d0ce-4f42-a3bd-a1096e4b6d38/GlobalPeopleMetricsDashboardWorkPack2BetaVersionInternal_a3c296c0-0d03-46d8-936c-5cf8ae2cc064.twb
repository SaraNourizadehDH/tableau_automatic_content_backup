              <calculation class='tableau' formula='IF MONTH(MIN([date_month])) IN (1, 4, 7, 10) THEN LOOKUP([c.adj org layers (copy)_198439904617684994],-1)&#10;ELSEIF MONTH(MIN([date_month])) IN (2, 5, 8, 11) THEN LOOKUP([c.adj org layers (copy)_198439904617684994],-2)&#10;ELSEIF MONTH(MIN([date_month])) IN (3, 6, 9, 12) THEN LOOKUP([c.adj org layers (copy)_198439904617684994],-3) &#10;END'>
