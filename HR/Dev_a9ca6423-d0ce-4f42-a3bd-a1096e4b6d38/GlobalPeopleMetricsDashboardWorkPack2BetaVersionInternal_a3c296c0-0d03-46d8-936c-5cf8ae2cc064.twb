      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Spans &amp; Layers' id='_C70D90328C7E444A9DF869EEEDA134B2'>
            <properties context=''>
              <relation connection='athena.04v2syg1o74tox19u074h1kyhf8w' name='Custom SQL Query' type='text'><![CDATA[/*Org Design Query*/

WITH cte_worker_hist_with_current AS (
	SELECT
		wh.*,
		CASE WHEN cm.brand = 'Glovo' THEN sm.supervisory_group ELSE NULL END AS supervisory_group,
		CASE WHEN cm.brand = 'Glovo' THEN sm.regions ELSE NULL END AS supervisory_org_region,
		CASE WHEN cm.brand = 'Glovo' THEN sm.hq_intl_logic ELSE NULL END AS hq_intl_logic,
		CASE
			-- Foodora, FoodPanda, Yemeksepeti
			-- WHEN cm.brand in ('Foodpanda', 'Foodora')
			WHEN cm.brand in ('Pandora')
				AND wh.cost_center_id in ('2006060010','3803060190','3809025021','3803060220','3803060120','3803040020','3803060140','3803010030','3803020060','3803060150', 
				'3803065150','3803065160','3803065130','3603060002','4003010221','3809025024','4203020001','3811060015','3811010050','3811030010','8701060000') 
			THEN 'Y'
			-- Yemek
			-- WHEN cm.brand = 'Yemeksepeti' AND wh.cost_center_id = '8701060000' THEN 'Y'
			-- PedidosYa
			WHEN cm.brand = 'PedidosYa' AND substr(wh.cost_center_id, length(wh.cost_center_id), 1) = '4' THEN 'Y'
			-- Talabat
			WHEN cm.brand = 'Talabat' AND mh.manager_id_03 <<>>'2020-06-2823' THEN 'Y'
			-- Glovo
			WHEN cm.brand = 'Glovo' AND (mh.manager_id_03 <<>> '2015-10-9001' OR (mh.manager_id_03 IS NULL AND wh.employee_id <<>> '2015-10-9001')) THEN 'Y'
			-- Efood
			WHEN cm.brand = 'EFood' AND mh.manager_id_02 in ('2023-08-0190', '2020-08-0169') AND mh.manager_id_03 <<>> '2021-03-0578' THEN 'Y'
			ELSE 'N'
		END AS lent_borrowed_tag
	FROM people_ops_proposed.il_worker_hist_with_current wh
	LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh
		ON wh.employee_id = mh.employee_id
		AND DATE_TRUNC('month', DATE(wh.report_effective_date)) = DATE_TRUNC('month', DATE(mh.report_effective_date))
		--AND wh.report_effective_date = mh.report_effective_date    
	LEFT JOIN people_ops_proposed.il_company_mapping cm 
		ON wh.company_id = cm.company_id
	LEFT JOIN people_ops_proposed.pl_e_gl_supervisory_mapping sm
		ON wh.supervisory_org_id = sm.supervisory_org_id
	LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha 
    	ON wh.cost_center_id = cha.cost_center_id
	LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw 
    	ON wh.cost_center_id = chw.cost_center_id
	WHERE 
		wh.report_effective_date >>= '2023-01-31'
		AND wh.is_terminated = 0
		AND wh.worker_type = 'Employee'
     	AND NOT -- Talabat: exclude from dataset
   		(
             cm.brand = 'Talabat'
			 AND (
				    lower(wh.contract_type) LIKE '%intern%' 
					or lower(wh.contract_type) LIKE '%consultant%'
					or lower(wh.contract_type) = 'consultant'
					OR lower(wh.contract_type) = 'consultant (fixed term)'
				    OR lower(wh.contract_type) = 'contractor'
				    OR lower(wh.contract_type) = 'freelancer'
				    OR lower(wh.worker_type) = 'contingent worker'
				    --OR lower(wh.business_title) = 'office support - sn'
				    OR wh.employee_id IN ('2020-06-2821', '2020-06-2822') -- TO BE REMOVED ONCE UPDATED IN THE SYSTEM
				 )
		)

		AND NOT -- Glovo: exclude permanent pickers and agents employees
        (
			cm.brand = 'Glovo' AND lower(wh.contract_type) = 'permanent'
           	AND (lower(wh.position) LIKE '%picker%' OR lower(wh.position) LIKE '%agent%')
		) 
		AND NOT -- PedidosYa: exclude permanent pickers and agents employees
        (
			cm.brand = 'PedidosYa'
			AND (
                wh.sub_department_wd IN ('Shift Supervisors & Store Managers', 'Pickers')
            ) 
        )
),

direct_reports AS (
	SELECT
		DATE_TRUNC('month', DATE(mh.report_effective_date)) AS report_effective_date,
        mh.managed_by AS employee_id,
        /* Gets All Employees */
        COUNT(DISTINCT mh.employee_id) AS direct_reports,
        SUM(
			CASE
                WHEN wh.management_level LIKE 'S%' THEN 1
			END
		) AS s_direct_reports,
        SUM(
			CASE
                WHEN wh.management_level LIKE 'IC%' THEN 1
			END
		) AS ic_direct_reports,
		SUM(
			CASE
                WHEN wh.management_level LIKE 'M%' THEN 1
            END
        ) AS m_direct_reports,
        SUM(
			CASE
                WHEN wh.management_level LIKE 'E%' THEN 1
            END
        ) AS e_direct_reports,
        SUM(
			CASE
                WHEN wh.management_level LIKE 'P%' THEN 1
            END
        ) AS p_direct_reports,
        
        /* Gets Active Employees Only */
        COUNT(DISTINCT CASE WHEN wh.on_leave = 0 THEN mh.employee_id END) AS direct_reports_with_on_leave,
        SUM(
			CASE
                WHEN wh.on_leave = 0 AND wh.management_level LIKE 'S%' THEN 1
			END
		) AS s_direct_reports_with_on_leave,
        SUM(
			CASE
                WHEN wh.on_leave = 0 AND wh.management_level LIKE 'IC%' THEN 1
			END
		) AS ic_direct_reports_with_on_leave,
		SUM(
			CASE
                WHEN wh.on_leave = 0 AND wh.management_level LIKE 'M%' THEN 1
            END
        ) AS m_direct_reports_with_on_leave,
        SUM(
			CASE
                WHEN wh.on_leave = 0 AND wh.management_level LIKE 'E%' THEN 1
            END
        ) AS e_direct_reports_with_on_leave,
        SUM(
			CASE
                WHEN wh.on_leave = 0 AND wh.management_level LIKE 'P%' THEN 1
            END
        ) AS p_direct_reports_with_on_leave,
        
        /* Gets Employees NOT Lent / Borrowed */
        COUNT(DISTINCT CASE WHEN wh.lent_borrowed_tag = 'N' THEN mh.employee_id END) AS direct_reports_lent_borrowed,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.management_level LIKE 'S%' THEN 1
			END
		) AS s_direct_reports_lent_borrowed,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.management_level LIKE 'IC%' THEN 1
			END
		) AS ic_direct_reports_lent_borrowed,
		SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.management_level LIKE 'M%' THEN 1
            END
        ) AS m_direct_reports_lent_borrowed,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.management_level LIKE 'E%' THEN 1
            END
        ) AS e_direct_reports_lent_borrowed,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.management_level LIKE 'P%' THEN 1
            END
        ) AS p_direct_reports_lent_borrowed,
        
        /* Gets Active Employees NOT Lent / Borrowed */
        COUNT(DISTINCT CASE WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 THEN mh.employee_id END) AS direct_reports_lent_borrowed_with_on_leave,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 AND wh.management_level LIKE 'S%' THEN 1
			END
		) AS s_direct_reports_lent_borrowed_with_on_leave,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 AND wh.management_level LIKE 'IC%' THEN 1
			END
		) AS ic_direct_reports_lent_borrowed_with_on_leave,
		SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 AND wh.management_level LIKE 'M%' THEN 1
            END
        ) AS m_direct_reports_lent_borrowed_with_on_leave,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 AND wh.management_level LIKE 'E%' THEN 1
            END
        ) AS e_direct_reports_lent_borrowed_with_on_leave,
        SUM(
			CASE
                WHEN wh.lent_borrowed_tag = 'N' AND wh.on_leave = 0 AND wh.management_level LIKE 'P%' THEN 1
            END
        ) AS p_direct_reports_lent_borrowed_with_on_leave
        
        FROM people_ops_proposed.il_manager_hist_with_current mh
        LEFT JOIN cte_worker_hist_with_current wh 
            ON mh.employee_id = wh.employee_id
            --AND mh.report_effective_date = wh.report_effective_date      
            AND DATE_TRUNC('month', DATE(mh.report_effective_date)) = DATE_TRUNC('month', DATE(wh.report_effective_date))      
        WHERE
        	mh.managed_by IS NOT NULL
        GROUP BY
        1,2
),

employees_without_reports AS (
	SELECT
		DISTINCT DATE_TRUNC('month', DATE(wh1.report_effective_date)) AS report_effective_date,
		wh1.employee_id
	FROM cte_worker_hist_with_current wh1
	LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh 
		ON wh1.employee_id = mh.managed_by
		AND DATE_TRUNC('month', DATE(wh1.report_effective_date)) = DATE_TRUNC('month', DATE(mh.report_effective_date))
		--AND wh1.report_effective_date = mh.report_effective_date
	LEFT JOIN people_ops_proposed.il_worker_hist_with_current wh2 
		ON mh.employee_id = wh2.employee_id
		AND DATE_TRUNC('month', DATE(wh2.report_effective_date)) = DATE_TRUNC('month', DATE(mh.report_effective_date))
		--AND mh.report_effective_date = wh2.report_effective_date
	WHERE
		(
			(mh.managed_by IS NULL)
			OR (
					mh.managed_by IS NOT NULL
					AND wh2.is_terminated = 1
			)
			OR (
					mh.managed_by IS NOT NULL
					AND wh2.on_leave = 1
			)
		)
),
/* Obtain open positions as of the latest date. Historical open_positions not relevant. */
open_position_prep AS (
	SELECT
		wo.employee_id,
		date_trunc('month', DATE(jr.last_updated)) AS report_effective_date,
		SUM(jr.remaining_positions) AS open_positions
	FROM people_ops_proposed.pl_ta_job_requisitions jr
	JOIN people_ops_proposed.il_worker_org wo 
		ON wo.work_email = jr.hiring_manager_email
	WHERE
		UPPER(jr.reason) = 'NEW ROLE'
		AND UPPER(jr.job_status) NOT IN ('ON_HOLD', 'CANCELLED')
		AND jr.remaining_positions >> 0
	GROUP BY 1, 2
),

layers_prep AS (
	SELECT
		DATE_TRUNC('month', DATE(mh.report_effective_date)) AS report_effective_date,
		mh.employee_id,
		CASE
			WHEN mh.manager_id_10 IS NOT NULL THEN 'Layer 10'
			WHEN mh.manager_id_09 IS NOT NULL THEN 'Layer 9'
			WHEN mh.manager_id_08 IS NOT NULL THEN 'Layer 8'
			WHEN mh.manager_id_07 IS NOT NULL THEN 'Layer 7'
			WHEN mh.manager_id_06 IS NOT NULL THEN 'Layer 6'
			WHEN mh.manager_id_05 IS NOT NULL THEN 'Layer 5'
			WHEN mh.manager_id_04 IS NOT NULL THEN 'Layer 4'
			WHEN mh.manager_id_03 IS NOT NULL THEN 'Layer 3'
			WHEN mh.manager_id_02 IS NOT NULL THEN 'Layer 2'
			WHEN mh.manager_id_01 IS NOT NULL THEN 'Layer 1'
		END AS organisation_layer
	FROM people_ops_proposed.il_manager_hist_with_current mh
	LEFT JOIN cte_worker_hist_with_current wh 
		ON mh.employee_id = wh.employee_id
		AND DATE_TRUNC('month', DATE(mh.report_effective_date)) = DATE_TRUNC('month', DATE(wh.report_effective_date))
		--AND mh.report_effective_date = wh.report_effective_date
),

/* USING obtains # direct reports including 0 */
metrics_prep AS (
	SELECT
		report_effective_date,
		employee_id,
		COALESCE(direct_reports, 0) AS direct_reports,
		COALESCE(s_direct_reports, 0) AS s_direct_reports,
		COALESCE(ic_direct_reports, 0) AS ic_direct_reports,
		COALESCE(m_direct_reports, 0) AS m_direct_reports,
		COALESCE(e_direct_reports, 0) AS e_direct_reports,
		COALESCE(p_direct_reports, 0) AS p_direct_reports,
		
		COALESCE(direct_reports_with_on_leave, 0) AS direct_reports_with_on_leave,
		COALESCE(s_direct_reports_with_on_leave, 0) AS s_direct_reports_with_on_leave,
		COALESCE(ic_direct_reports_with_on_leave, 0) AS ic_direct_reports_with_on_leave,
		COALESCE(m_direct_reports_with_on_leave, 0) AS m_direct_reports_with_on_leave,
		COALESCE(e_direct_reports_with_on_leave, 0) AS e_direct_reports_with_on_leave,
		COALESCE(p_direct_reports_with_on_leave, 0) AS p_direct_reports_with_on_leave,
		
		COALESCE(direct_reports_lent_borrowed, 0) AS direct_reports_lent_borrowed,
		COALESCE(s_direct_reports_lent_borrowed, 0) AS s_direct_reports_lent_borrowed,
		COALESCE(ic_direct_reports_lent_borrowed, 0) AS ic_direct_reports_lent_borrowed,
		COALESCE(m_direct_reports_lent_borrowed, 0) AS m_direct_reports_lent_borrowed,
		COALESCE(e_direct_reports_lent_borrowed, 0) AS e_direct_reports_lent_borrowed,
		COALESCE(p_direct_reports_lent_borrowed, 0) AS p_direct_reports_lent_borrowed,
		
		COALESCE(direct_reports_lent_borrowed_with_on_leave, 0) AS direct_reports_lent_borrowed_with_on_leave,
		COALESCE(s_direct_reports_lent_borrowed_with_on_leave, 0) AS s_direct_reports_lent_borrowed_with_on_leave,
		COALESCE(ic_direct_reports_lent_borrowed_with_on_leave, 0) AS ic_direct_reports_lent_borrowed_with_on_leave,
		COALESCE(m_direct_reports_lent_borrowed_with_on_leave, 0) AS m_direct_reports_lent_borrowed_with_on_leave,
		COALESCE(e_direct_reports_lent_borrowed_with_on_leave, 0) AS e_direct_reports_lent_borrowed_with_on_leave,
		COALESCE(p_direct_reports_lent_borrowed_with_on_leave, 0) AS p_direct_reports_lent_borrowed_with_on_leave
		
	FROM direct_reports 
	FULL OUTER JOIN employees_without_reports USING(employee_id, report_effective_date)
),

metrics_final AS (
	SELECT
		mp.*,
		COALESCE(open_positions, 0) AS open_positions
	FROM metrics_prep mp
	LEFT JOIN open_position_prep op 
		ON mp.employee_id = op.employee_id
		AND date_trunc('month', CAST(mp.report_effective_date AS DATE)) = op.report_effective_date
)

SELECT 
	DATE_TRUNC('month', DATE(wh.report_effective_date)) AS date_month,
	wh.employee_id,
	CONCAT(wp.first_name, ' ', wp.last_name) AS employee_name,
	CASE
		WHEN cm.brand = 'EFood' THEN 
			CASE
				WHEN UPPER(wh.business_title) IN (
						'ACCOUNTING SUPPORT AGENT',
						'ASSISTANT CLARK DRIVER',
						'ASSISTANT DRIVER',
						'BUILDING SUPPORT AGENT',
						'CLARK DRIVER',
						'CLARK OPERATOR',
						'CLARK OPERATOR''S ASSISTANT',
						'CLEANING CREW',
						'COURIERS SHIPMENTS ADMINISTRATOR',
						'DRIVER',
						'DRIVER''S ASSISTANT',
						'EQUIPMENT ADMINISTRATOR',
						'EX VAN DRIVER',
						'FITNESS TRAINER',
						'PICKER',
						'REPLENISHMENT AGENT',
						'SECURITY AGENT',
						'VAN DRIVER',
						'WAREHOUSE ASSISTANT',
						'WAREHOUSE EMPLOYEE',
						'SUPPORT AGENT',
						'HUB DISPATCHER'
						) THEN 'Operational Workers'
					WHEN UPPER(wh.business_title) = 'BARISTA' AND cm.company_id IN ('2504', '2502', '2507') THEN 'Operational Workers'
				ELSE 'Office Employees'
			END
		ELSE wh.business_title                                
	END AS business_title,
	wh.management_level,
	wh.job_family,
	wh.job_family_group,
	wh.office_location,
	wh.company_id,
	CASE
		--WHEN cm.brand = 'Foodpanda' THEN cm.country_group
		WHEN cm.brand = 'Pandora' THEN cm.country_group
		ELSE cm.country
	END AS country,
	CASE
		/*WHEN mh.manager_id_03 = '2020-01-0022' THEN 'Foodora'
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) = 'eu regional' THEN 'Foodora'
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) = 'pandora' THEN 'Foodora'*/
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) IN ('eu regional', 'pandora') OR mh.manager_id_03 = '2020-01-0022' THEN 'Pandora'
		WHEN wh.lent_borrowed_tag = 'Y' THEN 'Delivery Hero'
		ELSE cm.brand
	END AS brand,
	cm.brand AS brand_origin,
	CASE
		WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit_hierarchy, 8)
		WHEN cha.department IS NULL THEN wh.department_wd
		ELSE cha.department
	END as department,
	CASE
		WHEN cm.brand = 'Glovo' THEN substr(wh.business_unit, 8)
		WHEN LOWER(
				REGEXP_REPLACE(
					COALESCE(cha.sub_department, wh.sub_department_wd),
					'\\s+',
					 ' '
				)
		) LIKE '%ops%store%operations%' THEN 'Ops Store Operations'
		ELSE COALESCE(cha.sub_department, wh.sub_department_wd)
	END as sub_department,
	CASE
			WHEN cm.brand = 'PedidosYa' THEN 
				CASE
					WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - PERMANENT' THEN 'Pickers'
					WHEN UPPER(wh.contract_type) = 'OPERATIONAL WORKER - FIXED TERM (FIXED TERM)' THEN 'Pickers (Fixed Term)'
					ELSE wh.contract_type
				END
			ELSE wh.contract_type
	END AS contract_type,
	CASE
		WHEN cm.brand = 'Glovo' THEN wh.hq_intl_logic
		--WHEN cm.brand = 'Foodora' THEN 
		WHEN cm.brand = 'Pandora' THEN 
		CASE
			WHEN UPPER(wh.region) IN ('FOODORA REGION', 'EU REGION') THEN 'Regional'
			WHEN wh.region IS NULL THEN wh.region
			ELSE 'Local'
		END
		WHEN cm.brand = 'PedidosYa' THEN CASE
			SUBSTR(wh.cost_center_id, LENGTH(wh.cost_center_id), 1)
			WHEN '1' THEN 'Local'
			WHEN '2' THEN 'Regional'
			WHEN '4' THEN 'Central'
			WHEN '5' THEN 'SSC'
			ELSE NULL
		END
		ELSE NULL
	END AS scope,
	concat_ws(
		' ',
		mh.manager_id_01,
		mh.manager_id_02,
		mh.manager_id_03,
		mh.manager_id_04,
		mh.manager_id_05,
		mh.manager_id_06,
		mh.manager_id_07,
		mh.manager_id_08,
		mh.manager_id_09,
		mh.manager_id_10
	) as manager_id_concat,
	wh.time_type,
	wh.worker_type,
	CASE
		WHEN LOWER(COALESCE(cha.department, wh.department_wd)) IN ('eu regional', 'pandora') THEN 'Europe' 
		ELSE cm.region
	END AS region,
	cm.company_name,
	wh.cost_center_id,
	chw.cost_center_name,
	mh.managed_by,
	mh.managed_by_full_name,
	mh.manager_id_01,
	mh.manager_01_full_name,
	mh.manager_id_02,
	mh.manager_02_full_name,
	mh.manager_id_03,
	mh.manager_03_full_name,
	mh.manager_id_04,
	mh.manager_04_full_name,
	mh.manager_id_05,
	mh.manager_05_full_name,
	mh.manager_id_06,
	mh.manager_06_full_name,
	mh.manager_id_07,
	mh.manager_07_full_name,
	lp.organisation_layer,
	mf.direct_reports,
	mf.s_direct_reports,
	mf.ic_direct_reports,
	mf.m_direct_reports,
	mf.e_direct_reports,
	mf.p_direct_reports,
	mf.open_positions,
	wp.gender,
	sh.tenure_category,
	wh.region AS wh_region,
	wh.on_leave as employee_on_leave_status,
	
	mf.direct_reports_with_on_leave,
	mf.s_direct_reports_with_on_leave,
	mf.ic_direct_reports_with_on_leave,
	mf.m_direct_reports_with_on_leave,
	mf.e_direct_reports_with_on_leave,
	mf.p_direct_reports_with_on_leave,
	mf.direct_reports_lent_borrowed_with_on_leave,
	
	mf.direct_reports_lent_borrowed,
	mf.s_direct_reports_lent_borrowed,
	mf.ic_direct_reports_lent_borrowed,
	mf.m_direct_reports_lent_borrowed,
	mf.e_direct_reports_lent_borrowed,
	mf.p_direct_reports_lent_borrowed,
	
	mf.s_direct_reports_lent_borrowed_with_on_leave,
	mf.ic_direct_reports_lent_borrowed_with_on_leave,
	mf.m_direct_reports_lent_borrowed_with_on_leave,
	mf.e_direct_reports_lent_borrowed_with_on_leave,
	mf.p_direct_reports_lent_borrowed_with_on_leave,	
	
	wh.supervisory_group,
	wh.supervisory_org_region,
	wh.lent_borrowed_tag
FROM cte_worker_hist_with_current wh
LEFT JOIN layers_prep lp 
    ON wh.employee_id = lp.employee_id
    AND DATE_TRUNC('month', DATE(wh.report_effective_date)) = lp.report_effective_date
LEFT JOIN metrics_final mf 
    ON wh.employee_id = mf.employee_id
    AND DATE_TRUNC('month', DATE(wh.report_effective_date)) = mf.report_effective_date
LEFT JOIN people_ops_proposed.il_worker_personal wp 
    ON wh.employee_id = wp.employee_id
LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha 
    ON wh.cost_center_id = cha.cost_center_id
LEFT JOIN people_ops_proposed.il_cc_hierarchy_wd chw 
    ON wh.cost_center_id = chw.cost_center_id
LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh 
    ON wh.employee_id = mh.employee_id
    AND DATE_TRUNC('month', DATE(wh.report_effective_date)) = DATE_TRUNC('month', DATE(mh.report_effective_date))
LEFT JOIN people_ops_proposed.il_company_mapping cm 
    ON wh.company_id = cm.company_id
LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh 
    ON wh.employee_id = sh.employee_id
    AND DATE_TRUNC('month', DATE(wh.report_effective_date)) = DATE_TRUNC('month', DATE(sh.report_effective_date))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
