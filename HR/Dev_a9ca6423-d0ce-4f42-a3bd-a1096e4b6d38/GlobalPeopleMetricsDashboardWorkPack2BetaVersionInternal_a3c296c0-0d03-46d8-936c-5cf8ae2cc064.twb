              <aliases>
                <alias key='&quot;EFood&quot;' value='efood' />
              </aliases>
            </column>
            <column caption='c.Bool (Date = Last 12-m)' datatype='boolean' name='[c.Bool (&lt;= Today) (copy)_2542000518753083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_month] &gt;= DATEADD(&apos;month&apos;, -12, DATETRUNC(&apos;month&apos;, TODAY()))&#10;AND [date_month] &lt;= DATETRUNC(&apos;month&apos;, TODAY())' />
