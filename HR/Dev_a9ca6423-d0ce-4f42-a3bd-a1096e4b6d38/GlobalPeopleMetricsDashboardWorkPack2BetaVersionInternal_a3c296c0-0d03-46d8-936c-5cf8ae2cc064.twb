          <filter class='categorical' column='[federated.03hfyz61adex0n10c7pmf1icj9em].[Action (c.Filter - (Global Hide M5+) (group),c.management_level sort (group))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action11_703DCD3FEFA5439898EE2C80C6B45255]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[c.Filter - (Global Hide M5+) (copy)_1072912254065577985]' />
