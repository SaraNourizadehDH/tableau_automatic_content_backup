            <column caption='c.IC Total HC' datatype='integer' name='[c.M Total HC (copy)_2116691872279896073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1832965093946494988] = &quot;IC&quot;&#13;&#10;    //IF [g.management_level (ML group)] = &apos;M&apos;&#13;&#10;    THEN&#13;&#10;        [employee_id]&#13;&#10;    END&#13;&#10;)' />
