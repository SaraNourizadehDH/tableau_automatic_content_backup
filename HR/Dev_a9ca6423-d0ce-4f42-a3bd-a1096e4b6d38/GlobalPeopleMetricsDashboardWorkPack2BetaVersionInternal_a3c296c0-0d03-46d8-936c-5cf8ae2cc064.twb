            </column>
            <column caption='p.Select Dimension' datatype='string' name='[p.View By (Bars) (copy)_3104106067960229889]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
              <calculation class='tableau' formula='&quot;Department&quot;' />
              <aliases>
                <alias key='&quot;Cost Center Name&quot;' value='Cost center name' />
                <alias key='&quot;Glovo&quot;' value='Supervisory Group (Glovo)' />
                <alias key='&quot;Management Level&quot;' value='Management level' />
                <alias key='&quot;Management Level Groups&quot;' value='Management level groups' />
                <alias key='&quot;Management Level Groups (DH)&quot;' value='Management level groups (DH)' />
