            <column caption='c.Color - SPOC (ytd)' datatype='integer' name='[c.Color - SPOC (yoy) (copy)_2213800740289257493]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SIGN([c.SPOC (yoy changes) (copy)_2213800740286910483])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Date (Month = latest month)' datatype='integer' name='[c.Date (Month = last month) (copy)_198439904613941249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,TODAY())' />
            </column>
            <column caption='c.SPOC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.Direct Reports (Total) (copy)_890023921713831946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;AVG(&#13;&#10;    IF [Calculation_890023921714491403] = &quot;Y&quot; THEN &#13;&#10;        [Calculation_890023921712082949] &#13;&#10;    END&#13;&#10;)&#10;,1)&#13;&#10;//Average direct reports of People Managers' />
            </column>
            <column caption='c.Date Lookup' datatype='date' name='[c.Filter (Last 12-m) (copy)_2213800740245303310]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MIN([date_month]) = MAKEDATE([Parameters].[Parameter 3], [Parameters].[Parameter 2], 1) THEN&#13;&#10;    LOOKUP(MIN([date_month]), 0)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Filter - (Global Hide M5+) (group)' datatype='string' name='[c.Filter - (Global Hide M5+) (copy)_1072912254065577985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Glovo&apos; THEN [c.management_level group (sort) (copy)_829506803069911042] ELSE &apos;&apos; END' />
            </column>
            <column caption='c.Filter - (Global Hide M5+) (DH)' datatype='string' name='[c.Filter - (Global Hide M5+) (group) (copy)_1072912254067724291]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Glovo&apos; THEN [management_level (sort) (copy)_1832965093932339211] ELSE &apos;&apos; END' />
            </column>
            <column caption='c.Filter - SPOC (Global Hide M5+)' datatype='string' name='[c.Filter - OL (Global Hide M5+) (copy)_1072912254334435334]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[p.View By (Bars) (copy)_3104106067960229889] = &apos;Management Level&apos; THEN&#10;    [c.management_level sort (PedidosYa) (copy)_1072912254060929024]&#10;ELSEIF [Parameters].[p.View By (Bars) (copy)_3104106067960229889] = &apos;Management Level Groups&apos; THEN&#10;    [c.Filter - (Global Hide M5+) (copy)_1072912254065577985]&#10;ELSEIF [Parameters].[p.View By (Bars) (copy)_3104106067960229889] = &apos;Management Level Groups (DH)&apos; THEN&#10;    [c.Filter - (Global Hide M5+) (group) (copy)_1072912254067724291]&#10;ELSE    &#10;    &apos;&apos;&#10;END' />
            </column>
            <column caption='c.Direct Reports (S Employees)' datatype='integer' name='[c.Open Positions (Direct Reports) (copy)_890023921712660489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[p.SPOC - Include Open Positions? (copy)_890023921712431111] = TRUE THEN&#10;    IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = TRUE THEN&#10;        [s_direct_reports]&#10;    ELSE&#10;        [s_direct_reports_with_on_leave]&#10;    END&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='c.SPOC (ytd absolute)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.SPOC (yoy absolute) (copy)_2213800740286910484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH(MIN([date_month])) = 1 THEN  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], -1)  // If January, compare with December of the previous year&#13;&#10;ELSE  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], - (MONTH(MIN([date_month])) - 1))  // Compare with January of the same year&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.SPOC (ytd changes)' datatype='real' default-format='*▲ 0.0;▼ 0.0; 0.0' name='[c.SPOC (yoy changes) (copy)_2213800740286910483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], 0) &#13;&#10;- &#13;&#10;IF MONTH(MIN([date_month])) = 1 THEN  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], -1)  // If January, compare with December of the previous year&#13;&#10;ELSE  &#13;&#10;    LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946], - (MONTH(MIN([date_month])) - 1))  // Compare with January of the same year&#13;&#10;END&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c.Direct Reports (Open Positions)' datatype='integer' name='[c.Total Direct Reports (copy)_890023921712549896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = TRUE THEN [open_positions] ELSE 0 END' />
