            <column caption='c.Direct Reports (S Employees)' datatype='integer' name='[c.Open Positions (Direct Reports) (copy)_890023921712660489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[p.SPOC - Include Open Positions? (copy)_890023921712431111] = TRUE THEN&#10;    IF [Parameters].[p.On Leave - Direct Manager? (copy)_173318270676602880] = TRUE THEN&#10;        [s_direct_reports]&#10;    ELSE&#10;        [s_direct_reports_with_on_leave]&#10;    END&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='c.MLD - Manager Ratio (qoq absolute)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.SPOC (qoq absolute) (copy)_6754766175763091473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH(MIN([date_month])) IN (1, 4, 7, 10) THEN LOOKUP([Calculation_829506803434147857],-1)&#10;ELSEIF MONTH(MIN([date_month])) IN (2, 5, 8, 11) THEN LOOKUP([Calculation_829506803434147857],-2)&#10;ELSEIF MONTH(MIN([date_month])) IN (3, 6, 9, 12) THEN LOOKUP([Calculation_829506803434147857],-3) &#10;END'>
