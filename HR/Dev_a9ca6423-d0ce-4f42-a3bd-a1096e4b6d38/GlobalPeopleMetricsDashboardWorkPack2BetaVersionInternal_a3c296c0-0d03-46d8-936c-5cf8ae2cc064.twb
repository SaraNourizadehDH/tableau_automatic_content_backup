            </column>
            <column caption='c.SPOC (qoq absolute)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[c.SPOC (yoy absolute) (copy)_6754766175715352576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH(MIN([date_month])) IN (1, 4, 7, 10) THEN LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946],-1)&#10;ELSEIF MONTH(MIN([date_month])) IN (2, 5, 8, 11) THEN LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946],-2)&#10;ELSEIF MONTH(MIN([date_month])) IN (3, 6, 9, 12) THEN LOOKUP([c.Direct Reports (Total) (copy)_890023921713831946],-3) &#10;END'>
                <table-calc ordering-type='Rows' />
