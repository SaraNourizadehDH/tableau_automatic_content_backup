      <aliases enabled='yes' />
      <column caption='# Unique Hires' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[# Internal Hires (copy)_379991273523376129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id])' />
      </column>
      <column caption='# External Hires' datatype='integer' default-format='n#,##0;-#,##0' name='[# Internal Hires (copy)_379991273536958471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Business Process (group)] = &apos;External Hire&apos; THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='% External Hires' datatype='real' default-format='p0.0%' name='[% Internal Hires (copy)_379991273537085449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Internal Hires (copy)_379991273536958471] / [Calculation_379991273523253248]' />
      </column>
      <column caption='Type of Hire' datatype='string' name='[Business Process (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[business_process]' new-bin='true'>
          <bin default-name='false' value='&quot;External Hire&quot;'>
            <value>&quot;Contract Contingent Worker&quot;</value>
            <value>&quot;Hire&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Internal Hire&quot;'>
            <value>&quot;Change Job&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='# Hires' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_379991273523253248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id])' />
      </column>
      <column caption='Last Updated Date' datatype='date' name='[Calculation_379991273530859525]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([last_updated]) }' />
      </column>
      <column caption='# Internal Hires' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_379991273536442374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Business Process (group)] = &apos;Internal Hire&apos; THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='% Internal Hires' datatype='real' default-format='p0.0%' name='[Calculation_379991273537028104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_379991273536442374] / [Calculation_379991273523253248]' />
      </column>
      <column caption='Department' datatype='string' name='[Department (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[department]' new-bin='true'>
          <bin default-name='false' value='&quot;International&quot;'>
