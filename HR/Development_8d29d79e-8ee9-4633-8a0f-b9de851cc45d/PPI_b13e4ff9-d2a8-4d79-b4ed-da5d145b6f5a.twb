      <aliases enabled='yes' />
      <column caption='Employee ID + Business Process' datatype='string' name='[Calculation_1161365760135860224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[employee_id] + [bp_name]' />
      </column>
      <column caption='TTC Step' datatype='integer' name='[Calculation_1178043197188894721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[bp_step_initiated_date],[bp_step_completed_date])' />
      </column>
      <column caption='Business Process (fixed)' datatype='integer' name='[Calculation_159174152972607489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [bp_name] : COUNT([bp_name])}' />
      </column>
      <column caption='Sent Back Null' datatype='boolean' name='[Calculation_3031485551652339713]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Calculation_358739913365889027],0) = 0' />
      </column>
      <column caption='Sent Back Security Group' datatype='string' name='[Calculation_3031485551653818370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_step_status] = &apos;Sent Back&apos; THEN [bp_step_security_group] END' />
      </column>
      <column caption='Delayed (old)' datatype='integer' name='[Calculation_358739913362984962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [bp_step_completed_date] &gt; [last_day_of_work] THEN DATEDIFF(&apos;day&apos;,[last_day_of_work],[bp_step_completed_date]) &#10;ELSEif [bp_step_completed_date] &lt;= [last_day_of_work] THEN 0&#10;END' />
      </column>
      <column caption='Sent Back' datatype='integer' name='[Calculation_358739913365889027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [bp_step_status] = &apos;Sent Back&apos; THEN [bp_step_status] END )' />
      </column>
      <column caption='#BP Transactions' datatype='integer' name='[Calculation_4285456568813690880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1161365760135860224])' />
      </column>
      <column caption='Delayed Step' datatype='integer' name='[Calculation_5811895371712192512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [bp_step_completed_date] &gt; [bp_step_due_date] THEN DATEDIFF(&apos;day&apos;,[bp_step_due_date],[bp_step_completed_date]) END' />
      </column>
      <column caption='Delayed Null BP/Step' datatype='boolean' name='[Calculation_5811895371713380353]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Delayed (copy)_5527605650095685633],0) = 0' />
      </column>
      <column caption='Initiator_category' datatype='string' name='[Calculation_6616632314231341057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bp_step_initiated_by] = [employee_id] THEN &apos;Employee&apos; &#10;ELSEIF [bp_step_initiated_by] = [managed_by] THEN &apos;Manager&apos;&#10;ELSE &apos;HR Partner&apos; END' />
      </column>
      <column caption='Metric_to_Display' datatype='real' name='[Calculation_675539999935860736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Terminations&apos; THEN [Calculation_4285456568813690880]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Skipped Step&apos; THEN AVG([Calculation_358739913362984962])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Sent Back&apos; THEN [Calculation_358739913365889027]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Avg. Completed Time (Days)&apos; THEN AVG([Calculation_1178043197188894721])&#10;END' />
      </column>
      <column caption='# Terminations Completed' datatype='integer' name='[Calculation_675540002709700610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if ([termination_effective_date (il_termination1)] &lt; TODAY()) then 0 else 1 end)' />
      </column>
      <column caption='# Terminations Initiated' datatype='integer' name='[Calculation_675540002710097923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if ([termination_initiated_date (il_termination1)]&gt; TODAY()) then 0 else 1 end)' />
      </column>
      <column caption='Delayed BP/Step' datatype='real' name='[Delayed (copy)_5527605650095685633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([bp_step]) = MAX([bp_step])&#10;THEN AVG(IF [bp_step_completed_date] &gt; [bp_step_due_date] THEN DATEDIFF(&apos;day&apos;,[bp_step_due_date],[bp_step_completed_date]) END)&#10;ELSEIF MIN([bp_name]) = MAX([bp_name]) &#10;THEN AVG(IF [overall_bp_completed_date] &gt; [overall_bp_due_date] THEN DATEDIFF(&apos;day&apos;,[overall_bp_due_date],[overall_bp_completed_date]) END)&#10;END' />
      </column>
      <column caption='Delayed Null Step' datatype='boolean' name='[Delayed Null BP/Step (copy)_5527605650159652868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Calculation_5811895371712192512],0) = 0' />
      </column>
      <column caption='Delayed Null BP' datatype='boolean' name='[Delayed Null Step (copy)_5527605650160496645]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Delayed Step (copy)_5527605650158534659],0) = 0' />
      </column>
      <column caption='Delayed BP' datatype='integer' name='[Delayed Step (copy)_5527605650158534659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [overall_bp_completed_date] &gt; [overall_bp_due_date] THEN DATEDIFF(&apos;day&apos;,[overall_bp_due_date],[overall_bp_completed_date]) END' />
      </column>
      <column caption='TTC BP/Step' datatype='real' name='[TTC (copy)_5527605650075574272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([bp_step]) = MAX([bp_step]) THEN AVG(DATEDIFF(&apos;day&apos;,[bp_step_initiated_date],[bp_step_completed_date]))&#10;ELSEIF MIN([bp_name]) = MAX([bp_name]) THEN AVG(DATEDIFF(&apos;day&apos;,[overall_bp_initiated_date],[overall_bp_completed_date]))&#10;END' />
      </column>
      <column caption='TTC BP' datatype='integer' name='[TTC Step (copy)_5527605650156343298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[overall_bp_initiated_date],[overall_bp_completed_date])' />
      </column>
