      <column caption='% Performed Development Needed' datatype='real' name='[% Consecutive Development Needed (copy)_208080432130215950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_208080432129691661])/sum([Calculation_208080432096595974])' />
      </column>
      <column caption='% Retention' datatype='real' name='[Calculation_208080432009191429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM([is_terminated])/sum([actuals]))' />
      </column>
      <column caption='Dev. Needed' datatype='integer' name='[Calculation_208080432096595974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [manager_rating_explained] = &apos;Development Needed&apos; &#10;OR [manager_rating_explained] = &apos;Off Track&apos;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Consecutive Dev. Needed' datatype='integer' name='[Calculation_208080432118669321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_208080432096595974] = 1&#10;AND [previous_rating] = &apos;Development Needed&apos; &#10;OR [previous_rating] = &apos;Off Track&apos;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Actuals CountD' datatype='integer' name='[Calculation_208080432128593930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_id])' />
      </column>
      <column caption='% Consecutive Development Needed' datatype='real' name='[Calculation_208080432128745483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_208080432118669321])/sum([Calculation_208080432096595974])' />
      </column>
      <column caption='Dev Needed that Performed' datatype='integer' name='[Calculation_208080432129691661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [previous_rating] = &apos;Development Needed&apos; &#10;AND ([manager_rating_explained] = &apos;Performing&apos; &#10;OR [manager_rating_explained] = &apos;Exceeding&apos;&#10;OR [manager_rating_explained] = &apos;Outstanding&apos;&#10;OR [manager_rating_explained] = &apos;On Track&apos;)&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='% Dev Needed that performed' datatype='real' name='[Calculation_208080432260931601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM([Calculation_208080432118669321])/SUM([Calculation_208080432096595974]))' />
      </column>
