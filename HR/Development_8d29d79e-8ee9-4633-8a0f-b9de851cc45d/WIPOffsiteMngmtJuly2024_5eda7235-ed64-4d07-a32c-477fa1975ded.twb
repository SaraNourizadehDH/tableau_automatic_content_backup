        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL - MoM effective (Monthly) (copy)_141722670084960275]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL VOL - MoM effective (Monthly) (copy)_141722670085111828]&#10;END'>
