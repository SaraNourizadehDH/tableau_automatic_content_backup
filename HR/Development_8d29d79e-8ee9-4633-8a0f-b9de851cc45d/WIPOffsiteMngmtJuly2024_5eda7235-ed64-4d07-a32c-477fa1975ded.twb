          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:Calculation_5022076552060018788:qk]&quot;' value='Voluntary Terminations' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:terminations_effective_voluntary (copy)_5022076552060276837:qk]&quot;' value='           Voluntary Initiated Terminations' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:terminations_effective_voluntary (copy)_5022076552060502119:qk]&quot;' value='           Involuntary Effective Terminations' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:terminations_effective:qk]&quot;' value='           Terminations Effective' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:terminations_initiated_voluntary (copy)_5022076552060391526:qk]&quot;' value='           Involuntary Initiated Terminations' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[sum:terminations_initiated:qk]&quot;' value='           Terminations Initiated' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Calculation_4278138200504725504:qk:1]&quot;' value='Total HC of this month' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Calculation_5022076552057204832:qk]&quot;' value='Overall Attrition' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Voluntary - Attrition (copy)_141722670134243396:qk]&quot;' value='Voluntary Attrition - Monthly' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[win:usr:Voluntary - Attrition Monthly (copy)_837106590025814020:qk:2]&quot;' value='Voluntary Attrition - 12 Month Rolling' />
        </aliases>
      </column>
      <column caption='Terminations Metric Dimensions' datatype='integer' name='[Attrition Metric Dimensions (copy)_4364762119980920848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Overall&apos; THEN [Calculation_4364762119615967237]&#10;WHEN &apos;Voluntary&apos; THEN [Calculation_4364762119980380172]&#10;WHEN &apos;Involuntary&apos; THEN [terminations_voluntary (copy)_4364762119980642317]&#10;WHEN &apos;Regrettable&apos; THEN [terminations_voluntary (copy)_4364762119980720142]&#10;WHEN &apos;Non Regrettable&apos; THEN [terminations_regrettable (copy)_4364762119980802063]&#10;END' />
      </column>
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Overall - Attrition (copy)_141722670134755400])'>
          <table-calc ordering-field='[federated.05r9snf0pm3fk91dop2ed0zgusim].[report_month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Attrition Calc - Managers' datatype='real' name='[Calculation_1654369209326612488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Overall&apos; THEN RUNNING_SUM([Overall - Attrition (copy)_141722670134755400])&#10;WHEN &apos;Voluntary&apos; THEN RUNNING_SUM([Voluntary - Attrition (copy)_141722670134243396])&#10;WHEN &apos;Involuntary&apos; THEN RUNNING_SUM([Involuntary - Attrition (copy)_141722670134325317])&#10;WHEN &apos;Regrettable&apos; THEN RUNNING_SUM([FINAL INVOL - Attrition (Monthly) (copy)_141722670089637925])&#10;WHEN &apos;Non-Regrettable&apos; THEN RUNNING_SUM([FINAL REG - Attrition (Monthly) (copy)_141722670092148783])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Today Ref Line' datatype='datetime' datatype-customized='true' name='[Calculation_2943806062930866179]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF year([report_month])=YEAR(TODAY()) THEN DATETRUNC(&apos;month&apos;,TODAY()) END' />
      </column>
      <column caption='User Filter Calc - Descriptive' datatype='integer' name='[Calculation_3777886816145670144]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//DESCRIPTIVE &#10;&#10;// PEOPLE ANALYTICS --&gt; ALL&#10;// C LEVEL --&gt; ALL&#10;// EXTENDED LEADERSHIP --&gt; ALL&#10;// TA EXTENDED LEADERSHIP --&gt; ALL, NO P&amp;C&#10;// PEOPLE PARTNERS -- ALL BUT P&amp;C,EXCEPT NIDHI&#10;// C-1 --&gt; THEIR SCOPE&#10;// PEOPLE ANALYTICS ENTITIES --&gt; THEIR BRAND&#10;&#10;&#10;(IF ISMEMBEROF(&apos;Administrator (People Analytics Team)&apos;) THEN 1&#10;&#10;ELSEIF ISMEMBEROF(&apos;C-Level&apos;) THEN 1 &#10;&#10;ELSEIF USERNAME()=(&apos;nidhi.singh@deliveryhero.com&apos;) THEN 1 &#10;ELSEIF USERNAME()=(&apos;natalia.cosa@deliveryhero.com&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Extended Leadership&apos;) THEN 1 &#10;&#10;ELSEIF ISMEMBEROF(&apos;Talent Acquisition - Extended Leadership&apos;) THEN &#10;    IF [manager_02_full_name] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [manager_02_full_name] &lt;&gt; &apos;Jeri Lynne Doris&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH Europe - Administrator&apos;) THEN &#10;IF [sub_department]=&apos;EU Regional Platform&apos; &#10;OR [sub_department]=&apos;EU Regional Dmart&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;DH People Partners&apos;) THEN &#10;    IF [manager_02_full_name] &lt;&gt; &apos;Ana Mitrasevic&apos; &#10;    AND [manager_02_full_name] &lt;&gt; &apos;Jeri Lynne Doris&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Foodpanda - Administrator&apos;) THEN &#10;IF [brand]=&apos;Foodpanda&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Foodpanda - Administrator Limited&apos;) THEN &#10;IF [brand]=&apos;Foodpanda&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Hungerstation - Administrator&apos;) THEN &#10;IF [brand]=&apos;Hungerstation&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Pedidos Ya - Administrator&apos;) THEN &#10;IF [brand]=&apos;PedidosYa&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Talabat - Administrator&apos;) THEN &#10;IF [brand]=&apos;Talabat&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF ISMEMBEROF(&apos;Yemeksepeti - Administrator&apos;) THEN &#10;IF [brand]=&apos;Yemeksepeti&apos; THEN 1 ELSE 0 END&#10;&#10;ELSEIF USERNAME()=[Calculation_4996884558846115842] OR USERNAME()=[work_email_manager_03]&#10; THEN 1 &#10;&#10;END)' />
      </column>
      <column caption='PedidosYa Teams' datatype='string' name='[Calculation_3924394536243191809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ENDSWITH([cost_center_id],&apos;1&apos;) THEN &apos;Local&apos; &#10;ELSEIF ENDSWITH([cost_center_id],&apos;2&apos;) THEN &apos;Regional&apos; &#10;ELSEIF ENDSWITH([cost_center_id],&apos;3&apos;) THEN &apos;NA&apos; &#10;ELSEIF ENDSWITH([cost_center_id],&apos;4&apos;) THEN &apos;DH&apos; &#10;ELSE &apos;NA&apos;&#10;END' />
      </column>
      <column caption='Actuals per Month &amp; Manager' datatype='integer' name='[Calculation_4278138200504725504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST () = 0&#10;THEN&#10;sum({ FIXED ([report_month]), [managed_by_full_name] : SUM([actuals])})&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Highlight managers' datatype='string' datatype-customized='true' name='[Calculation_4278138200574509069]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(if RUNNING_SUM([Voluntary - Attrition (copy)_141722670134243396]) &gt; 0.5 then 1 else 0 END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimensions Calc' datatype='string' name='[Calculation_4364762119613095938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Management Level&apos; THEN [management_level]&#10;WHEN &apos;Gender&apos; THEN [gender]&#10;WHEN &apos;Department&apos; THEN [department]&#10;WHEN &apos;Brand&apos; THEN [brand]&#10;WHEN &apos;Tenure&apos; THEN [tenure_category]&#10;WHEN &apos;Department Group&apos; THEN [department (group)]&#10;WHEN &apos;Company Name&apos; THEN [company_name]&#10;END' />
      </column>
      <column caption='terminations_count' datatype='integer' name='[Calculation_4364762119615967237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [terminations_effective]&#10;WHEN &apos;Initiated Attrition&apos; THEN [terminations_initiated]&#10;END' />
      </column>
      <column caption='Attrition Metric Dimensions' datatype='string' name='[Calculation_4364762119642341384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='terminations_voluntary' datatype='integer' name='[Calculation_4364762119980380172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Effective Attrition&apos; THEN [Calculation_5022076552060018788]&#10;WHEN &apos;Initiated Attrition&apos; THEN [terminations_effective_voluntary (copy)_5022076552060276837]&#10;END' />
      </column>
      <column caption='user.name' datatype='string' name='[Calculation_4996884558846115842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([work_email_manager_03],&quot;@deliveryhero.com&quot;,&quot;&quot;)' />
      </column>
      <column caption='Last' datatype='boolean' name='[Calculation_5022076551914856466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall - Attrition' datatype='real' default-format='p0.0%' name='[Calculation_5022076552057204832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Effective Involuntary Atrittion (copy)_5022076552284926121]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL Effective  Atrittion - Monthly (copy)_141722670077374476]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='terminations_effective_voluntary' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
      </column>
      <column caption='current_year' datatype='boolean' name='[Calculation_5022076552293089459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([report_month])= YEAR(TODAY())' />
      </column>
      <column caption='Months Name' datatype='string' name='[Calculation_5311292093328830464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(MONTH([report_month]))' />
        <aliases>
          <alias key='&quot;1&quot;' value='Jan' />
          <alias key='&quot;10&quot;' value='Oct' />
          <alias key='&quot;11&quot;' value='Nov' />
          <alias key='&quot;12&quot;' value='Dec' />
          <alias key='&quot;2&quot;' value='Feb' />
          <alias key='&quot;3&quot;' value='Mar' />
          <alias key='&quot;4&quot;' value='Apr' />
          <alias key='&quot;5&quot;' value='May' />
          <alias key='&quot;6&quot;' value='Jun' />
          <alias key='&quot;7&quot;' value='Jul' />
          <alias key='&quot;8&quot;' value='Aug' />
          <alias key='&quot;9&quot;' value='Sep' />
        </aliases>
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_835206677492695041]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF ISMEMBEROF(&apos;Pedidos Ya - Administrator&apos;) &#10; then 1 else 0 end' />
      </column>
      <column caption='Rolling 12 month' datatype='boolean' name='[Calculation_837106590626750474]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;,[report_month]),DATETRUNC(&apos;month&apos;,TODAY())))&lt;12&#13;&#10;AND MIN(DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;,[report_month]),DATETRUNC(&apos;month&apos;,TODAY())))&gt;=0' />
      </column>
      <column caption='Overall - Attrition Effective' datatype='real' default-format='p0.0%' name='[Effective Involuntary Atrittion (copy)_5022076552284926121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([terminations_effective]))&#10;/&#10;sum(&#10;{ FIXED YEAR([report_month]):AVG(&#10;&#10;{ FIXED YEAR([report_month]),MONTH([report_month]):SUM([actuals])})})'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall - MoM Initiated Monthly' datatype='real' name='[FINAL - MoM effective (Monthly) (copy)_141722670077534221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Overall - Attrition Initiated (copy)_141722670134640711])-&#10;&#10;LOOKUP(RUNNING_SUM([Overall - Attrition Initiated (copy)_141722670134640711]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Voluntary - MoM Effective Monthly' datatype='real' name='[FINAL - MoM effective (Monthly) (copy)_141722670084960275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Voluntary - Attrition Effective (copy)_141722670134071362])-&#10;LOOKUP((RUNNING_SUM([Voluntary - Attrition Effective (copy)_141722670134071362])),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall - Attrition Initiated' datatype='real' default-format='p0.0%' name='[FINAL Effective  Atrittion - Monthly (copy)_141722670077374476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([terminations_initiated])&#10;/&#10;SUM([actuals])' />
