        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='Custom SQL Query' type='text'>WITH active_managers as 
(
SELECT
employee_id,
is_people_manager
FROM people_ops_proposed.il_worker_org 
where is_terminated = 0
),


termination as (
SELECT
date_trunc(&apos;month&apos;,date(t.termination_initiated_date)) as termination_initiated_date,
date_trunc(&apos;month&apos;,date(t.termination_effective_date)) as termination_effective_date,
t.employee_id,
case when t.termination_category is null then &apos;Voluntary&apos; else termination_category end as termination_category,
t.termination_reason,
t.is_termination_regrettable,
t.last_updated
FROM people_ops_proposed.il_termination t

WHERE status IN (&apos;Successfully Completed&apos;,&apos;In Progress&apos;) AND ((termination_category IS NULL AND resignation_reason IS NOT NULL) OR (termination_category IS not NULL))

),


historic_data as (
SELECT
date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date)) as report_month,
wh.company_id,
cm.company_name,
case when cm.brand=&apos;Foodpanda&apos; then cm.country_group else cm.country end as country,
&apos;Historical Data&apos; as period,
cm.brand,
CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
wh.cost_center_id,
chw.cost_center_name,
sh.tenure_category,
mh.managed_by_full_name,
mh.manager_02_full_name,
mh.manager_03_full_name,
wo.work_email as work_email_manager_03,
mh.manager_04_full_name,
wp.gender,
wh.management_level,
wh.worker_type,
wh.employee_id,
coalesce (ti.termination_category,te.termination_category) as termination_category,
coalesce (ti.termination_reason,te.termination_reason) as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
coalesce (ti.is_termination_regrettable,te.is_termination_regrettable) as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
ac.is_people_manager,
te.last_updated

FROM
	people_ops_proposed.il_worker_hist_with_current wh	

LEFT JOIN people_ops_proposed.il_manager m
	ON m.employee_id = wh.employee_id
	
LEFT JOIN active_managers ac
	ON m.managed_by = ac.employee_id
	
LEFT JOIN people_ops_proposed.il_manager_hist_with_current mh
	ON mh.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(mh.report_effective_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wp.employee_id = wh.employee_id
	
LEFT JOIN people_ops_proposed.il_salary_hist_with_current sh
	ON sh.employee_id = wh.employee_id
	AND date_trunc(&apos;month&apos;,cast(sh.report_effective_date as date)) = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))
	
LEFT JOIN people_ops_proposed.il_worker_org wo
	ON mh.manager_id_03 = wo.employee_id 

LEFT JOIN termination ti
	ON ti.employee_id = wh.employee_id
	AND ti.termination_initiated_date = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))
	
LEFT JOIN termination te
	ON te.employee_id = wh.employee_id
	AND te.termination_effective_date = date_trunc(&apos;month&apos;,cast(wh.report_effective_date as date))	
	

),

next_month as 
(
SELECT
CASE 
    WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
      THEN date_trunc(&apos;month&apos;,date_add(&apos;month&apos;, 1, cast(wh.report_effective_date as date)))
    ELSE null
  END AS report_month,
  wh.company_id,
  cm.company_name,
  case when cm.brand=&apos;Foodpanda&apos; then cm.country_group else cm.country end as country,
  &apos;Future Data&apos; as period,
  cm.brand,
  CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
  CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
wh.cost_center_id,
chw.cost_center_name,
s.tenure_category,
m.managed_by_full_name,
m.manager_02_full_name,
m.manager_03_full_name,
wo.work_email as work_email_manager_03,
m.manager_04_full_name,
wp.gender,
wh.management_level,
wh.worker_type,
wh.employee_id,
coalesce (ti.termination_category,te.termination_category) as termination_category,
coalesce (ti.termination_reason,te.termination_reason) as termination_reason,
CASE WHEN ti.employee_id is not null then 1 else 0 end as terminations_initiated,
CASE WHEN te.employee_id is not null then 1 else 0 end as terminations_effective,
coalesce (ti.is_termination_regrettable,te.is_termination_regrettable) as termination_regrettable,
CASE WHEN wh.is_terminated = 0 THEN 1 ELSE 0 END as actuals,
ac.is_people_manager,
te.last_updated
  
FROM
	people_ops_proposed.il_worker_hist_with_current wh
	
LEFT JOIN
	people_ops_proposed.il_company_mapping cm
	ON wh.company_id = cm.company_id 
	
LEFT JOIN
	people_ops_proposed.il_worker_personal wp
	ON wh.employee_id = wp.employee_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_all cha
	ON wh.cost_center_id = cha.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_cc_hierarchy_wd chw
	ON wh.cost_center_id = chw.cost_center_id 
	
LEFT JOIN
	people_ops_proposed.il_salary s
	ON wh.employee_id = s.employee_id 
	
LEFT JOIN
	people_ops_proposed.manager m
	ON wh.employee_id = m.employee_id 
	
LEFT JOIN active_managers ac
	ON m.managed_by = ac.employee_id	
	
LEFT JOIN termination ti
	ON ti.employee_id = wh.employee_id
	AND ti.termination_initiated_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))	
	
LEFT JOIN termination te
	ON te.employee_id = wh.employee_id
	AND te.termination_effective_date = date_trunc(&apos;month&apos;, date_add(&apos;month&apos;,1,current_date))	
	
	
LEFT JOIN people_ops_proposed.il_worker_org wo
	ON m.manager_id_03 = wo.employee_id 	
	
WHERE date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date) 	
	
),

next_next_month as 
(
SELECT
CASE 
    WHEN date_trunc(&apos;month&apos;, cast(wh.report_effective_date as date)) = date_trunc(&apos;month&apos;, current_date)
      THEN date_trunc(&apos;month&apos;,date_add(&apos;month&apos;, 2, cast(wh.report_effective_date as date)))
    ELSE null
  END AS report_month,
  wh.company_id,
cm.company_name,
case when cm.brand=&apos;Foodpanda&apos; then cm.country_group else cm.country end as country,
&apos;Future Data&apos; as period,
  cm.brand,
  CASE WHEN cha.department IS NULL THEN wh.department_wd ELSE cha.department END as department,
  CASE WHEN cha.sub_department IS NULL THEN wh.sub_department_wd  ELSE cha.sub_department END as sub_department,
wh.cost_center_id,
chw.cost_center_name,
s.tenure_category,
m.managed_by_full_name,
m.manager_02_full_name,
m.manager_03_full_name,
wo.work_email as work_email_manager_03,
m.manager_04_full_name,
wp.gender,
wh.management_level,
wh.worker_type,
wh.employee_id,
coalesce (ti.termination_category,te.termination_category) as termination_category,
