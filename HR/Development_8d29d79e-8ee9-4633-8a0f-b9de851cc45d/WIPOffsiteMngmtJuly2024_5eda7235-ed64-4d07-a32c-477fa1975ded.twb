      <column caption='Overall - MoM  (+) Monthly' datatype='real' name='[FINAL Overall MoM - Attrition (Monthly) (copy)_141722670082547726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Overall YoY - Attrition (copy)_2943806063210524687] &gt; 0 THEN(&#10;CASE  [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Yoy effective (copy)_2943806063203561484]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL - MoM effective (Monthly) (copy)_141722670077534221]&#10;END) ELSE 0&#10;END'>
