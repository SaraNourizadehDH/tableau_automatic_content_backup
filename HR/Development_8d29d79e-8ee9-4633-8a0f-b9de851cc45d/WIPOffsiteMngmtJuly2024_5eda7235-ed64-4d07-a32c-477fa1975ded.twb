              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL REG Initiated  Atrittion - Monthly (copy)_141722670092029998]&#10;END' />
