            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='terminations_effective_voluntary' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
            </column>
            <column caption='Non Regrettable - MoM Effective Monthly' datatype='real' name='[FINAL REG - MoM effective (Monthly) (copy)_141722670092648497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444])-&#10;LOOKUP((RUNNING_SUM([FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444])),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
