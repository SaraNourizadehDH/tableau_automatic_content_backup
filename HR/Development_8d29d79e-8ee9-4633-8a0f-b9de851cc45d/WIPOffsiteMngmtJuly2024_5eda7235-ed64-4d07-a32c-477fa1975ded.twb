        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL INVOL - MoM effective (Monthly) (copy)_141722670089973799]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL REG - MoM effective (Monthly) (copy)_141722670090235944]&#10;END'>
