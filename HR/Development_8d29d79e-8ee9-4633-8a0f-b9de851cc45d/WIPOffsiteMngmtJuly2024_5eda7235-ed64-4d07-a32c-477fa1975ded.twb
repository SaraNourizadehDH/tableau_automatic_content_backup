      <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
        <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
        <members>
          <member value='&quot;Effective Attrition&quot;' />
          <member value='&quot;Initiated Attrition&quot;' />
        </members>
      </column>
      <column caption='Performance' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;High Performers&quot;'>
        <calculation class='tableau' formula='&quot;High Performers&quot;' />
        <members>
          <member value='&quot;High Performers&quot;' />
          <member value='&quot;Performers&quot;' />
          <member value='&quot;Low Performers&quot;' />
        </members>
      </column>
      <column caption='Dimensions' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gender&quot;'>
        <calculation class='tableau' formula='&quot;Gender&quot;' />
        <members>
          <member value='&quot;Gender&quot;' />
          <member value='&quot;Management Level&quot;' />
          <member value='&quot;Department&quot;' />
          <member value='&quot;Brand&quot;' />
          <member value='&quot;Tenure&quot;' />
          <member value='&quot;Department Group&quot;' />
          <member value='&quot;Company Name&quot;' />
        </members>
      </column>
      <column caption='Attrition Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Voluntary vs Involuntary&quot;'>
        <calculation class='tableau' formula='&quot;Voluntary vs Involuntary&quot;' />
        <members>
          <member value='&quot;Voluntary vs Involuntary&quot;' />
          <member value='&quot;Regrettable vs Non Regrettable&quot;' />
        </members>
      </column>
      <column caption='Attrition Metric - By Managers' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Involuntary&quot;'>
        <calculation class='tableau' formula='&quot;Involuntary&quot;' />
        <members>
          <member value='&quot;Overall&quot;' />
          <member value='&quot;Voluntary&quot;' />
          <member value='&quot;Involuntary&quot;' />
          <member value='&quot;Regrettable&quot;' />
          <member value='&quot;Non-Regrettable&quot;' />
        </members>
      </column>
      <column caption='Threshold line - 30 days' datatype='real' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='30.'>
        <calculation class='tableau' formula='30.' />
      </column>
      <column caption='Brand / Department' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
        <calculation class='tableau' formula='&quot;Department&quot;' />
        <members>
          <member value='&quot;Brand&quot;' />
          <member value='&quot;Department&quot;' />
        </members>
      </column>
    </datasource>
