  <worksheets>
    <worksheet name='IC1-IC2_Detailed_Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='8'>Last 12 Months Detailed view</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='attrition_pl_table' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Effective Attrition&quot;'>
              <calculation class='tableau' formula='&quot;Effective Attrition&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='terminations_effective_voluntary' datatype='integer' name='[Calculation_5022076552060018788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [termination_category] = &apos;Voluntary&apos; THEN [terminations_effective] END' />
            </column>
            <column caption='Non Regrettable - MoM Effective Monthly' datatype='real' name='[FINAL REG - MoM effective (Monthly) (copy)_141722670092648497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444])-&#10;LOOKUP((RUNNING_SUM([FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444])),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Regrettable - MoM Initiated Monthly' datatype='real' name='[FINAL REG - MoM initiated (Monthly) (copy)_141722670092767282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670092029998])-&#10;LOOKUP((RUNNING_SUM([FINAL REG Initiated  Atrittion - Monthly (copy)_141722670092029998])),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Regrettable - Attrition Effective Monthly' datatype='real' default-format='p0.0%' name='[FINAL REG Effective Atrittion - Monthly (copy)_141722670091878444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective_regrettable (copy)_5022076552060919914])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Non Regrettable - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[FINAL REG Initiated  Atrittion - Monthly (copy)_141722670092029998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_initiated_regrettable (copy)_5022076552060919915])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Non Regrettable - MoM Monthly' datatype='real' name='[FINAL REG MoM - Attrition (Monthly) (copy)_141722670092881971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL REG - MoM effective (Monthly) (copy)_141722670092648497]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL REG - MoM initiated (Monthly) (copy)_141722670092767282]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Regrettable - MoM  (-) Monthly' datatype='real' name='[FINAL REG NON MoM - Attrition (+) (copy)_141722670093062197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [FINAL REG MoM - Attrition (Monthly) (copy)_141722670092881971] &lt; 0 THEN(&#10;CASE  [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [FINAL REG - MoM effective (Monthly) (copy)_141722670092648497]&#10;WHEN &apos;Initiated Attrition&apos; THEN [FINAL REG - MoM initiated (Monthly) (copy)_141722670092767282]&#10;END) ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Voluntary - Attrition Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition (copy)_141722670134243396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Voluntary - Attrition Effective (copy)_141722670134071362]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Voluntary - Attrition Initiated (copy)_141722670134165571]&#10;END' />
            </column>
            <column caption='Voluntary - Attrition Effective Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition Effective (copy)_141722670134071362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5022076552060018788])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='-12 months' datatype='string' default-format='p0.0%' name='[Voluntary - Attrition Effective 12 Month Rolling Sum (copy)_837106590031212550]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&quot;month&quot;,LOOKUP(MAX([report_month]),0),TODAY())&gt;=12&#13;&#10;THEN &quot;Hide&quot;&#13;&#10;ELSE &quot;Show&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Voluntary - Attrition Initiated Monthly' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition Initiated (copy)_141722670134165571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([terminations_effective_voluntary (copy)_5022076552060276837])&#10;/&#10;SUM([actuals])' />
            </column>
            <column caption='Voluntary - Attrition Effective 12 Month Rolling Sum' datatype='real' default-format='p0.0%' name='[Voluntary - Attrition Monthly (copy)_837106590025814020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Effective Attrition&apos; THEN [Voluntary - Attrition Effective (copy)_141722670134071362]&#10;WHEN &apos;Initiated Attrition&apos; THEN [Voluntary - Attrition Initiated (copy)_141722670134165571]&#10;END' />
            </column>
            <column datatype='integer' name='[actuals]' role='measure' type='quantitative' />
            <column datatype='string' name='[company_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[department]' role='dimension' type='nominal' />
