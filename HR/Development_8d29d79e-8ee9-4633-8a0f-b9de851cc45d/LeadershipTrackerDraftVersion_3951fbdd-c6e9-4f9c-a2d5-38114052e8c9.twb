    <worksheet name='total_enrollments'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>Total Enrollments</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#cb0015' fontname='Tableau Semibold' fontsize='18'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Total - Enrolled (copy)_2049911905158361115:qk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='leadership_tracker_pl' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Total - Enrolled (Running_Sum)' datatype='integer' name='[Total - Enrolled (copy)_2049911905158361115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST()=0 THEN RUNNING_SUM([WiL - Eligibility (copy)_2049911904464957452]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total - Enrolled' datatype='integer' name='[WiL - Eligibility (copy)_2049911904464957452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [enrolled_lpp]=&apos;yes&apos; &#10;    OR [enrolled_slp]=&apos;yes&apos; &#10;    OR [enrolled_wil]=&apos;yes&apos; &#10;then [employee_id] end)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[enrolled_lpp]' role='dimension' type='nominal' />
            <column datatype='string' name='[enrolled_slp]' role='dimension' type='nominal' />
            <column datatype='string' name='[enrolled_wil]' role='dimension' type='nominal' />
            <column caption='Is Manager of Managers?' datatype='string' name='[managers_of_managers]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[managers_of_managers]' derivation='None' name='[none:managers_of_managers:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[report_date]' derivation='Year-Trunc' name='[tyr:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total - Enrolled (copy)_2049911905158361115]' derivation='User' name='[usr:Total - Enrolled (copy)_2049911905158361115:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[WiL - Eligibility (copy)_2049911904464957452]' derivation='User' name='[usr:WiL - Eligibility (copy)_2049911904464957452:qk]' pivot='key' type='quantitative' />
            <column-instance column='[report_date]' derivation='Year' name='[yr:report_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:brand:nk]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[yr:report_date:ok]</column>
