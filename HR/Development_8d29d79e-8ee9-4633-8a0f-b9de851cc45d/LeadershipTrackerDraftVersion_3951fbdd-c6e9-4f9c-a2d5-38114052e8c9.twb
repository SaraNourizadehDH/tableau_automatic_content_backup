    <worksheet name='lpp_enrollment_%'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>LPP Enrollments</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='leadership_tracker_pl' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='LPP - Eligibility' datatype='integer' name='[Calculation_2049911904417017857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [managers_of_managers]=&apos;no&apos; and [brand] = &apos;Delivery Hero&apos; &#10;then [employee_id]  end)' />
            </column>
            <column caption='% Enrollment LPP' datatype='real' default-format='p0.00%' name='[Calculation_2049911904418197507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LPP - Eligibility (copy)_2049911904417636354]/[Calculation_2049911904417017857]' />
            </column>
            <column caption='LPP - Enrolled' datatype='integer' name='[LPP - Eligibility (copy)_2049911904417636354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [enrolled_lpp]=&apos;yes&apos; then [employee_id] end)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[enrolled_lpp]' role='dimension' type='nominal' />
            <column caption='Is Manager of Managers?' datatype='string' name='[managers_of_managers]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[managers_of_managers]' derivation='None' name='[none:managers_of_managers:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2049911904418197507]' derivation='User' name='[usr:Calculation_2049911904418197507:qk]' pivot='key' type='quantitative' />
            <column-instance column='[report_date]' derivation='Year' name='[yr:report_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[yr:report_date:ok]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:brand:nk]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:department:nk]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:managers_of_managers:nk]</column>
