    <worksheet name='wil_enrollment_%'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>WiL Enrollments</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='leadership_tracker_pl' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='% Enrollment WiL' datatype='real' default-format='p0.00%' name='[% Enrollment SLP (copy)_2049911904420913162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SLP - Enrolled  (copy)_2049911904420511752]/[LPP - Eligibility (copy)_2049911904419950599]' />
            </column>
            <column caption='WiL - Eligibility' datatype='integer' name='[LPP - Eligibility (copy)_2049911904419950599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [gender]=&apos;Female&apos; &#10;and [management_level] IN (&apos;M3&apos;,&apos;M4&apos;,&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;,&apos;E2&apos;)&#10;then [employee_id]  end)' />
            </column>
            <column caption='WiL - Enrolled' datatype='integer' name='[SLP - Enrolled  (copy)_2049911904420511752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [enrolled_wil]=&apos;yes&apos; then [employee_id] end)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column datatype='string' name='[employee_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[enrolled_wil]' role='dimension' type='nominal' />
            <column datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Management Level' datatype='string' name='[management_level]' role='dimension' type='nominal' />
            <column caption='Is Manager of Managers?' datatype='string' name='[managers_of_managers]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[managers_of_managers]' derivation='None' name='[none:managers_of_managers:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[% Enrollment SLP (copy)_2049911904420913162]' derivation='User' name='[usr:% Enrollment SLP (copy)_2049911904420913162:qk]' pivot='key' type='quantitative' />
            <column-instance column='[report_date]' derivation='Year' name='[yr:report_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:brand:nk]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[yr:report_date:ok]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:department:nk]</column>
            <column>[federated.05r9snf0pm3fk91dop2ed0zgusim].[none:managers_of_managers:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:% Enrollment SLP (copy)_2049911904420913162:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>The sum of employees that enrolled in the program vs the sum of eligible employees (Global scope, Females, M3+)</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold='true' fontname='Tableau Semibold' fontsize='16'>&lt;</run>
                <run bold='true' fontname='Tableau Semibold' fontsize='16'>[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:% Enrollment SLP (copy)_2049911904420913162:qk]</run>
                <run bold='true' fontname='Tableau Semibold' fontsize='16'>&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='cell'>
                <format attr='text-align' value='center' />
                <format attr='vertical-align' value='center' />
              </style-rule>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
