      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8D439491E3384B5DB6798D8DBC831F71'>
            <properties context=''>
              <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='Custom SQL Query' type='text'>with name_managers as (
select
date_trunc(&apos;month&apos;,date(m.report_effective_date)) as report_date,
m.employee_id,
m.managed_by,
concat(wp.first_name,&apos; &apos;,wp.last_name) as manager_full_name
from people_ops_proposed.il_manager_hist_with_current m
left join people_ops_proposed.il_worker_personal wp
on wp.employee_id = m.managed_by

),

list_managers as (
select
date_trunc(&apos;month&apos;,date(whc.report_effective_date)) as report_date,
whc.employee_id,
wo.work_email,
concat(wp.first_name,&apos; &apos;,wp.last_name) as full_name,
wp.gender,
whc.management_level,
cha.department,
cm.brand,
cha.sub_department,
nm.manager_full_name,
wo.last_updated

FROM people_ops_proposed.il_worker_hist_with_current whc

LEFT JOIN people_ops_proposed.il_worker_personal wp
ON wp.employee_id = whc.employee_id

LEFT JOIN people_ops_proposed.il_worker_org wo
ON wo.employee_id = whc.employee_id

LEFT JOIN people_ops_proposed.il_company_mapping cm 
ON cm.company_id  = whc.company_id

LEFT JOIN people_ops_proposed.il_cc_hierarchy_all cha
ON cha.cost_center_id = whc.cost_center_id

LEFT JOIN name_managers nm
ON nm.employee_id=whc.employee_id
AND nm.report_date=date_trunc(&apos;month&apos;,date(whc.report_effective_date))

WHERE whc.is_people_manager=&apos;1&apos; and whc.is_terminated=0

),

managers_of_managers as (
select
date_trunc(&apos;month&apos;,date(m.report_effective_date)) as report_date,
m.managed_by as managers_of_managers_id
from people_ops_proposed.il_manager_hist_with_current  m
inner join list_managers lm
on lm.employee_id=m.employee_id
and lm.report_date=date_trunc(&apos;month&apos;,date(m.report_effective_date))
group by 1,2

),

lpp_enrollment as (

SELECT
date_trunc(&apos;month&apos;,date(cel.program_start_date)) as report_date,
wo.employee_id

FROM people_ops_proposed.il_course_enrollment_leadership cel

LEFT JOIN people_ops_proposed.il_worker_org wo
	ON cel.work_email=wo.work_email 
WHERE cel.course_name=&apos;LPP&apos; AND cel.registration_status=&apos;Enrolled&apos;

),

slp_enrollment as (

SELECT
date_trunc(&apos;month&apos;,date(cel.program_start_date)) as report_date,
wo.employee_id

FROM people_ops_proposed.il_course_enrollment_leadership cel

LEFT JOIN people_ops_proposed.il_worker_org wo
	ON cel.work_email=wo.work_email 
WHERE cel.course_name=&apos;SLP&apos; AND cel.registration_status=&apos;Enrolled&apos;


),


wil_enrollment as (

SELECT
date_trunc(&apos;month&apos;,date(cel.program_start_date)) as report_date,
wo.employee_id

FROM people_ops_proposed.il_course_enrollment_leadership cel

LEFT JOIN people_ops_proposed.il_worker_org wo
	ON cel.work_email=wo.work_email 
WHERE cel.course_name=&apos;WiL&apos; AND cel.registration_status=&apos;Enrolled&apos;

)

select
lm.*,
case when mm.managers_of_managers_id is not null then &apos;yes&apos; else &apos;no&apos; end as managers_of_managers,
case when lpp.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_lpp,
case when slp.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_slp,
case when wil.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_wil

from list_managers lm

left join managers_of_managers mm 
	on lm.employee_id=mm.managers_of_managers_id
	and lm.report_date=mm.report_date


LEFT JOIN lpp_enrollment lpp
	ON lm.employee_id=lpp.employee_id
	AND lm.report_date=lpp.report_date
	
	LEFT JOIN slp_enrollment slp
	ON lm.employee_id=slp.employee_id
	AND lm.report_date=slp.report_date
	
	LEFT JOIN wil_enrollment wil
	ON lm.employee_id=wil.employee_id
	AND lm.report_date=wil.report_date</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
