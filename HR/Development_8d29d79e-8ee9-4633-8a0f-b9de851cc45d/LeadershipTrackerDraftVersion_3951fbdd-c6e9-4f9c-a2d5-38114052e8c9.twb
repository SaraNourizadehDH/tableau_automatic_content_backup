select
lm.*,
case when mm.managers_of_managers_id is not null then &apos;yes&apos; else &apos;no&apos; end as managers_of_managers,
case when lpp.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_lpp,
case when slp.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_slp,
case when wil.employee_id is not null then &apos;yes&apos; else &apos;no&apos; end as enrolled_wil

from list_managers lm

left join managers_of_managers mm 
	on lm.employee_id=mm.managers_of_managers_id
	and lm.report_date=mm.report_date


LEFT JOIN lpp_enrollment lpp
	ON lm.employee_id=lpp.employee_id
	AND lm.report_date=lpp.report_date
	
	LEFT JOIN slp_enrollment slp
	ON lm.employee_id=slp.employee_id
	AND lm.report_date=slp.report_date
	
	LEFT JOIN wil_enrollment wil
	ON lm.employee_id=wil.employee_id
	AND lm.report_date=wil.report_date</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
