              <calculation class='tableau' formula='&quot;LPP Program&quot;' />
            </column>
            <column caption='Dimensions' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Department&quot;'>
              <calculation class='tableau' formula='&quot;Department&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='% Enrollment SLP' datatype='real' default-format='p0.00%' name='[% Enrollment LPP (copy)_2049911904419667974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LPP - Enrolled (copy)_2049911904419012613]/[WiL - Eligibility (copy)_2049911904420667401]' />
            </column>
            <column caption='% Enrollment WiL' datatype='real' default-format='p0.00%' name='[% Enrollment SLP (copy)_2049911904420913162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SLP - Enrolled  (copy)_2049911904420511752]/[LPP - Eligibility (copy)_2049911904419950599]' />
            </column>
            <column caption='LPP - Eligibility' datatype='integer' name='[Calculation_2049911904417017857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [managers_of_managers]=&apos;no&apos; and [brand] = &apos;Delivery Hero&apos; &#10;then [employee_id]  end)' />
            </column>
            <column caption='% Enrollment LPP' datatype='real' default-format='p0.00%' name='[Calculation_2049911904418197507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LPP - Eligibility (copy)_2049911904417636354]/[Calculation_2049911904417017857]' />
            </column>
            <column caption='Program Metric' datatype='real' default-format='p0.00%' name='[Calculation_2049911904730669076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;LPP Program&apos; THEN [Calculation_2049911904418197507]&#10;WHEN &apos;SLP Program&apos; THEN [% Enrollment LPP (copy)_2049911904419667974]&#10;WHEN &apos;WiL Program&apos; THEN [% Enrollment SLP (copy)_2049911904420913162]&#10;END' />
            </column>
            <column caption='LPP - Enrolled' datatype='integer' name='[LPP - Eligibility (copy)_2049911904417636354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [enrolled_lpp]=&apos;yes&apos; then [employee_id] end)' />
            </column>
            <column caption='WiL - Eligibility' datatype='integer' name='[LPP - Eligibility (copy)_2049911904419950599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [gender]=&apos;Female&apos; &#10;and [management_level] IN (&apos;M3&apos;,&apos;M4&apos;,&apos;M5&apos;,&apos;M6&apos;,&apos;E1&apos;,&apos;E2&apos;)&#10;then [employee_id]  end)' />
            </column>
            <column caption='SLP - Enrolled ' datatype='integer' name='[LPP - Enrolled (copy)_2049911904419012613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [enrolled_slp]=&apos;yes&apos; then [employee_id] end)' />
            </column>
            <column caption='Program Dimension' datatype='string' default-format='p0.00%' name='[Program Metric (copy)_2049911904731271189]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Brand&apos; THEN [brand]&#10;WHEN &apos;Management Level&apos; THEN [management_level]&#10;WHEN &apos;Gender&apos; THEN [gender]&#10;WHEN &apos;Department&apos; THEN [department]&#10;END' />
            </column>
            <column caption='WiL - Enrolled' datatype='integer' name='[SLP - Enrolled  (copy)_2049911904420511752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [enrolled_wil]=&apos;yes&apos; then [employee_id] end)' />
            </column>
            <column caption='SLP - Eligibility' datatype='integer' name='[WiL - Eligibility (copy)_2049911904420667401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [managers_of_managers]=&apos;yes&apos;&#10;then [employee_id]  end)' />
