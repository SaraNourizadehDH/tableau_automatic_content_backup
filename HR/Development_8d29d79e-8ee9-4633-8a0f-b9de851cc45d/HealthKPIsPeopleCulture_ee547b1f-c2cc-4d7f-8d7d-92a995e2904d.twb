      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <filter class='categorical' column='[yr:date_month:ok]' filter-group='2'>
        <groupfilter function='member' level='[yr:date_month:ok]' member='2022' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_16097445D55F403C8CBB25FBD7C13153'>
            <properties context=''>
              <relation connection='athena.0fwe70809j989w18amzvm1ufo78a' name='Custom SQL Query' type='text'><![CDATA[WITH actuals AS (
    SELECT
        date_trunc('month', cast(date_month as date)) AS date_month,
        SUM(actual) AS actual
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE company_id = '1001' 
    AND date_trunc('month', cast(date_month as date)) <<= date_trunc('month',current_date)
    GROUP BY
        1
),
        
engagement AS (
    SELECT 
        cast(survey_date as date) as survey_date,
        AVG(nps) AS enps
    FROM 
        people_ops_proposed.il_engagement_org 
    WHERE
        company_name = 'Delivery Hero SE'
        AND driver = 'growth'
    GROUP BY 
        1
    ORDER BY 
        1 DESC
),

propagated_engagement AS (
    SELECT
        date_month,
        first_value(enps) over (PARTITION BY value_partition ORDER BY date_month) AS avg_nps_score_growth
    FROM (
        SELECT
            c.month AS date_month,
            enps,
            SUM(CASE WHEN enps IS NULL THEN 0 ELSE 1 END) over (ORDER BY c.month) AS value_partition
        FROM 
            people_ops_bl.calendar c
        LEFT JOIN
            engagement e
            ON c.month = date_trunc('month',e.survey_date)
        ORDER BY 
            c.month ASC
        )
),

women_in_tech AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual) AS actual_women_in_tech
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
        AND gender = 'Female'
        AND department = 'DH Tech' OR department = 'DH Product'
    GROUP BY
        1
),

tech_actuals AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual) AS actuals_tech
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
        AND department = 'DH Tech' OR department = 'DH Product'
    GROUP BY
        1
),

m3_women_leaders AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual_m3_plus) AS m3_women
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
        AND gender = 'Female'
    GROUP BY
        1
),

m3_actuals AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual_m3_plus) AS m3_actuals
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
    GROUP BY
     1   
),

jira_created_tickets AS (
    SELECT 
        date_trunc('month',DATE(j.creation_date)) AS date_month,
        COUNT(DISTINCT j.ticket_number) as created_tickets
    FROM 
   people_ops_il.jira2 j 
        
    GROUP BY 1
),

jira_closed_tickets AS (
    SELECT 
        date_trunc('month',DATE(j.status_date)) AS date_month,
        COUNT(DISTINCT j.ticket_number) as closed_tickets
    FROM 
   people_ops_il.jira2 j 
    
   WHERE j.status = 'Done'
    GROUP BY 1
),

active_high_performers AS (
    SELECT 
    	date_trunc('month',cast(wh.report_effective_date as date)) as date_month,
    	count(distinct wh.employee_id) AS active_hp
    FROM
        people_ops_proposed.il_worker_hist_with_current wh
        
    LEFT JOIN people_ops_proposed.il_performance p
		ON p.employee_id = wh.employee_id 
    LEFT JOIN 
        people_ops_proposed.il_performance_review_template prt 
        ON p.review_template_id=prt.review_template_id 
 
	
	WHERE p.company_id = '1001'
		AND prt.review_date = '2022-01-01'
        AND p.manager_rating_explained IN ('Exceeding', 'Outstanding')
        AND date_trunc('month',cast(wh.report_effective_date as date)) >>= date_parse('2022-01-01','%Y-%d-%m') 
		AND cast(wh.first_day_of_work as date) <<= date_parse('2022-01-01','%Y-%d-%m') 
        AND (cast(wh.last_day_of_work as date) >> date_parse('2022-01-01','%Y-%d-%m') or cast(wh.last_day_of_work as date) is null)
        AND wh.is_terminated = 0
        AND p.bp_status <<>> 'Canceled'
        
		GROUP BY 1		
),

terminated_high_performers AS (
    SELECT 
    	date_trunc('month',cast(t.termination_effective_date as date)) as date_month,
    	count(distinct t.employee_id) as leavers_hp
    FROM
        people_ops_proposed.il_termination t
      
    LEFT JOIN people_ops_proposed.il_performance p 
		ON p.employee_id = t.employee_id 
	LEFT JOIN 
        people_ops_proposed.il_performance_review_template prt 
        ON p.review_template_id=prt.review_template_id 	
	LEFT JOIN 
        people_ops_proposed.il_worker_hist_with_current wh
        ON t.employee_id = wh.employee_id
		AND date_trunc('month',cast(t.termination_effective_date as date)) = date_trunc('month',cast(wh.report_effective_date as date))   
    WHERE 
        t.company_id = '1001'	
        AND p.manager_rating_explained IN ('Exceeding', 'Outstanding')
        AND prt.review_date = '2022-01-01'        
        AND date_trunc('month',cast(t.termination_effective_date as date)) >>= date_parse('2022-01-01','%Y-%d-%m') 	
        AND cast(t.last_day_of_work as date) >> date_parse('2022-01-01','%Y-%d-%m')
        AND cast(wh.first_day_of_work as date) <<= date_parse('2022-01-01','%Y-%d-%m') 
        AND p.bp_status <<>> 'Canceled'
    GROUP BY 1
 
)


SELECT 
	date_month,
	CAST(wit.actual_women_in_tech AS DOUBLE)/CAST(ta.actuals_tech AS DOUBLE) 
		AS women_leaders_in_tech,
	CAST(mwl.m3_women AS DOUBLE)/CAST(ma.m3_actuals AS DOUBLE) 
		AS m3_women,
	pe.avg_nps_score_growth,
	jct.closed_tickets,
	jt.created_tickets,
	ahp.active_hp,
	thp.leavers_hp
	
	
FROM actuals
	
LEFT JOIN propagated_engagement pe
	USING (date_month)
	
LEFT JOIN tech_actuals ta
	USING (date_month)
	
LEFT JOIN women_in_tech wit
	USING (date_month)
	
LEFT JOIN m3_women_leaders mwl
	USING (date_month)

LEFT JOIN m3_actuals ma
	USING (date_month)
	
LEFT JOIN jira_closed_tickets jct
	USING (date_month)
	
LEFT JOIN jira_created_tickets jt
	USING (date_month)
	
LEFT JOIN active_high_performers ahp
	USING (date_month)
	
LEFT JOIN terminated_high_performers thp
	USING (date_month)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
