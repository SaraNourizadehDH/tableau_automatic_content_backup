            <run bold='true' fontalignment='1' fontcolor='#272d36' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[avg:Latest NPS (copy)_7012175049950814231:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
