          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[cum:sum:perc_growth_plans_company:qk:5]&quot;' value='Growth Plans Delivery Hero' />
          <alias key='&quot;[federated.05r9snf0pm3fk91dop2ed0zgusim].[cum:sum:perc_growth_plans_department:qk:1]&quot;' value='Growth Plans People &amp; Culture' />
