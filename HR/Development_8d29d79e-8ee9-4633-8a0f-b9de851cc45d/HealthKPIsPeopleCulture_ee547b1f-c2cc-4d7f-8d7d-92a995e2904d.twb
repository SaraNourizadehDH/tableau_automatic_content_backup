      <aliases enabled='yes' />
      <column caption='Jira Tickets' datatype='real' default-format='p0.0%' name='[Calculation_241224055607877728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([closed_tickets])/SUM([created_tickets])' />
      </column>
      <column caption='Latest Jira Tickets' datatype='real' default-format='p0.0%' name='[Calculation_241224055608356962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST () = 0  THEN sum([closed_tickets])/sum([created_tickets]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous Jira Tickets' datatype='real' name='[Calculation_241224055608746083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if last() = 0 then LOOKUP(SUM([closed_tickets]),-1) end &#10;/&#10;if last() = 0 then LOOKUP(SUM([created_tickets]),-1)&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Start HC High Performer' datatype='integer' name='[Calculation_2582814394271662081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FIRST () = 0  THEN sum([active_hp]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='First HC HP' datatype='integer' name='[Calculation_2582814394273189892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF MONTH([date_month])= {MIN(MONTH([date_month]))} &#10;THEN [active_hp] END) }' />
      </column>
      <column caption='Retention Monthly Ratio' datatype='real' name='[Calculation_2582814394273419269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_hp]/[Calculation_2582814394273189892]' />
      </column>
      <column caption='Latest NPs Growth' datatype='real' name='[Calculation_6002665052420714499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))} &#10;THEN [avg_nps_score_growth] END) }' />
      </column>
      <column caption='Previous NPs Growth' datatype='real' name='[Calculation_6002665052420935684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-3 &#10;THEN [avg_nps_score_growth] END) }' />
      </column>
      <column caption='Change (-) NPs Growth' datatype='real' name='[Calculation_6002665052421111813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(IF [Calculation_6002665052420714499] &lt; [Calculation_6002665052420935684] THEN&#10;([Calculation_6002665052420714499]-[Calculation_6002665052420935684])/[Calculation_6002665052420935684]&#10;END)' />
      </column>
      <column caption='Change (+) Women_tech' datatype='real' name='[Change (+) HiPo Retention (copy)_6002665052451110923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(IF [Latest HiPo Retention (copy)_6002665052451110925] &gt; [Previous HiPo Retention (copy)_6002665052451110926] THEN&#10;([Latest HiPo Retention (copy)_6002665052451110925]-[Previous HiPo Retention (copy)_6002665052451110926])&#10;END)' />
