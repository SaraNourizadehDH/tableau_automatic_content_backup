    <worksheet name='Benefits Usage'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11'>AVG BENEFITS USAGE</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='8' italic='true'>Accumulated over time</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Growth plans DHSE (Last Running Sum) (copy)_241224055491039312:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='11'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Change Growth Plans DHSE (+) (copy)_241224055491645524:qk]>]]></run>
            <run bold='true' fontalignment='1' fontcolor='#ff0000' fontsize='11'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Change Growth Plans DHSE (-) (copy)_241224055491645523:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='11'>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Health KPIs Final Version' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
          </datasources>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Change Benefits Usage (+)' datatype='real' default-format='p0.0%' name='[Change Growth Plans DHSE (+) (copy)_241224055491645524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if last()=0 then zn(IF [Latest Growth Plans DHSE FINAL (copy)_241224055491395665] &gt; [Previous Growth Plans DHSE FINAL (copy)_241224055491510354] THEN&#10;([Latest Growth Plans DHSE FINAL (copy)_241224055491395665]-[Previous Growth Plans DHSE FINAL (copy)_241224055491510354])&#10;END) end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Change  Benefits Usage (-)' datatype='real' name='[Change Growth Plans DHSE (-) (copy)_241224055491645523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if last()=0 then zn(IF [Latest Growth Plans DHSE FINAL (copy)_241224055491395665] &lt; [Previous Growth Plans DHSE FINAL (copy)_241224055491510354] THEN&#10;([Latest Growth Plans DHSE FINAL (copy)_241224055491395665]-[Previous Growth Plans DHSE FINAL (copy)_241224055491510354])&#10;END) end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
