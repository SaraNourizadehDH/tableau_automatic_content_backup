              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-1 THEN [avg_equal_pay_gap] END) }' />
            </column>
            <column caption='Previous Pay Gap' datatype='real' name='[Previous Relocation Ratio (copy)_3288401849904467982]' role='measure' type='quantitative'>
