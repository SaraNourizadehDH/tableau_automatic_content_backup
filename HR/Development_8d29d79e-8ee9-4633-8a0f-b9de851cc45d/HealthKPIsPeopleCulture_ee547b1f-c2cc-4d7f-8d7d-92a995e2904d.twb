            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Growth plans DHSE (copy)_241224055315529800:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ff0000' fontsize='11'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Calculation_241224055193010217:qk]>]]></run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='11'><![CDATA[<[federated.05r9snf0pm3fk91dop2ed0zgusim].[usr:Change Relocation Ratio (+) (copy)_241224055192858664:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='11'>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Health KPIs Final Version' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target Growth Plans DHSE' datatype='real' default-format='p0%' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Change Growth Plans DHSE (-)' datatype='real' name='[Calculation_241224055193010217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if last()=0 then zn(IF [Previous Growth Plans DHSE FINAL (copy)_241224055313342535] &lt; [Previous Growth Plans DHSE (copy)_241224055312207941] THEN&#10;([Previous Growth Plans DHSE FINAL (copy)_241224055313342535]-[Previous Growth Plans DHSE (copy)_241224055312207941])&#10;END) end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Change Growth Plans DHSE (+)' datatype='real' default-format='p0.0%' name='[Change Relocation Ratio (+) (copy)_241224055192858664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if last()=0 then zn(IF [Previous Growth Plans DHSE FINAL (copy)_241224055313342535] &gt; [Previous Growth Plans DHSE (copy)_241224055312207941] THEN&#10;([Previous Growth Plans DHSE FINAL (copy)_241224055313342535]-[Previous Growth Plans DHSE (copy)_241224055312207941])&#10;END) end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Growth plans DHSE (Last Running Sum)' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Growth plans DHSE (copy)_241224055315529800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST () = 0  THEN FLOAT(WINDOW_SUM(sum([growth_plans_dhse]),-12,0))/sum([actual]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Previous Growth Plans DHSE FINAL' datatype='real' default-format='p0.0%' name='[Previous Growth Plans DHSE (copy)_241224055312207941]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if last() = 0 then WINDOW_SUM(sum([growth_plans_dhse]),-12,-1) end&#10;/&#10;if last() = 0 then LOOKUP(SUM([actual]),-1)&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Latest Growth Plans DHSE FINAL' datatype='real' default-format='p0.0%' name='[Previous Growth Plans DHSE FINAL (copy)_241224055313342535]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if last() = 0 then WINDOW_SUM(sum([growth_plans_dhse]),-12,0) end&#10;/&#10;if last() = 0 then LOOKUP(SUM([actual]),0)&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
