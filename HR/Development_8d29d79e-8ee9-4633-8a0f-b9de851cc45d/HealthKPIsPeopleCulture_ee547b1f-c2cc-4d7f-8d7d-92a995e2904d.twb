        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Health KPIs Final Version' name='federated.05r9snf0pm3fk91dop2ed0zgusim' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Acceptance Rate' datatype='real' default-format='p0%' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.8'>
              <calculation class='tableau' formula='0.8' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05r9snf0pm3fk91dop2ed0zgusim'>
            <column caption='Latest AR' datatype='real' default-format='n#,##0;-#,##0' name='[Latest NPS (copy)_7012175049950814231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))} THEN [acceptance_rate] END) }' />
            </column>
            <column caption='Change AR (+) ' datatype='real' default-format='p0.0%' name='[NPS change (+) (copy)_7012175049953116187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest NPS (copy)_7012175049950814231] &gt; [Previous NPS (copy)_7012175049950961688] THEN&#10;([Latest NPS (copy)_7012175049950814231]-[Previous NPS (copy)_7012175049950961688])/[Previous NPS (copy)_7012175049950961688]&#10;END)' />
            </column>
            <column caption='Change AR (-)' datatype='real' default-format='p0.0%' name='[NPS change (-) (copy)_7012175049953103898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest NPS (copy)_7012175049950814231] &lt; [Previous NPS (copy)_7012175049950961688] THEN&#10;([Latest NPS (copy)_7012175049950814231]-[Previous NPS (copy)_7012175049950961688])/[Previous NPS (copy)_7012175049950961688]&#10;END)' />
            </column>
            <column caption='AR change' datatype='real' default-format='p0.0%' name='[NPS change (copy)_7012175049951031321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest NPS (copy)_7012175049950814231]-[Previous NPS (copy)_7012175049950961688])/[Previous NPS (copy)_7012175049950961688]' />
            </column>
            <column caption='Previous AR' datatype='real' name='[Previous NPS (copy)_7012175049950961688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-1 THEN [acceptance_rate] END) }' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.00%' name='[acceptance_rate]' role='measure' type='quantitative' />
