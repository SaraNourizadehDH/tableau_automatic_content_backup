            <column caption='Pay Gap change (-)' datatype='real' default-format='p0.0%' name='[Relocation Hires change (-) (copy)_3288401849904467981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest Relocation Ratio (copy)_3288401849904467979] &lt; [Previous Relocation Ratio (copy)_3288401849904467982] THEN&#10;([Latest Relocation Ratio (copy)_3288401849904467979]-[Previous Relocation Ratio (copy)_3288401849904467982])&#10;END)' />
