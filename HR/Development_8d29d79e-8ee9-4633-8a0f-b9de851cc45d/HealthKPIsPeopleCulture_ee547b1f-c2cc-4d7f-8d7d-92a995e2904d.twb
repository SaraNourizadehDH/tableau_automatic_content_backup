      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <filter class='categorical' column='[yr:date_month:ok]' filter-group='2'>
        <groupfilter function='member' level='[yr:date_month:ok]' member='2023' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_433800EF2E214EDD9E346C89643FE543'>
            <properties context=''>
              <relation connection='athena.1e13dbp1dxe9vs12z12080xllwep' name='Custom SQL Query' type='text'><![CDATA[WITH actuals AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual) AS actual
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
    GROUP BY
        1
),
	
engagement AS (
    SELECT 
        cast(survey_date as date) as survey_date,
        AVG(nps) AS enps
    FROM 
        people_ops_proposed.il_engagement_org 
    WHERE
        company_name = 'Delivery Hero SE'
        AND driver = 'engagement'
    GROUP BY 
        1
    ORDER BY 
        1 DESC
),

propagated_engagement AS (
    SELECT
        date_month,
        first_value(enps) over (PARTITION BY value_partition ORDER BY date_month) AS avg_nps_score
    FROM (
        SELECT
            c.month AS date_month,
            enps,
            SUM(CASE WHEN enps IS NULL THEN 0 ELSE 1 END) over (ORDER BY c.month) AS value_partition
        FROM 
            people_ops_bl.calendar c
        LEFT JOIN
            engagement e
            ON c.month = date_trunc('month',e.survey_date)
        ORDER BY 
            c.month ASC
        )
),

growth_plans_company AS (
	SELECT
		date_trunc('month',DATE(gp.bp_initiated_date)) AS date_month,
		COUNT(DISTINCT gp.employee_id) AS growth_plans_dhse
	FROM
        people_ops_proposed.il_growth_plan gp      
    LEFT JOIN 
        people_ops_proposed.il_worker_hist_with_current wh
        ON gp.employee_id = wh.employee_id
        AND date_trunc('month',DATE(gp.bp_initiated_date)) = date_trunc('month',DATE(wh.report_effective_date))    
    WHERE gp.is_growth_plan_started >> 0
        AND wh.company_id = '1001'
GROUP BY 1
        

    
),



growth_plans_department AS (

	SELECT
		date_trunc('month',DATE(gp.bp_initiated_date)) AS date_month,
		COUNT(DISTINCT gp.employee_id) AS growth_plans_people
	FROM
        people_ops_proposed.il_growth_plan gp
        LEFT JOIN 
           people_ops_proposed.il_worker_hist_with_current wh
            ON gp.employee_id = wh.employee_id
            AND date_trunc('month',DATE(gp.bp_initiated_date)) = date_trunc('month',DATE(wh.report_effective_date))
        LEFT JOIN
        people_ops_proposed.il_cc_hierarchy_all cha
        USING(cost_center_id)
        
        WHERE gp.is_growth_plan_started >> 0
        	AND wh.company_id = '1001'
        	AND cha.department = 'DH People & Culture'
        GROUP BY
            1    
),

people_actuals AS (
    SELECT
        DATE(date_month) AS date_month,
        SUM(actual) AS actual_p
    FROM
        people_ops_proposed.bl_agg_metrics
    WHERE
        company_id = '1001'
        AND DATE(date_month) <<= date_trunc('month',current_date)
         AND department = 'DH People & Culture'
    GROUP BY
		1
),

etl_swapfiets AS (
    SELECT 
    *,
    CASE 
        WHEN "start date" LIKE '%/%' THEN date_parse("start date",'%m/%d/%Y') ELSE 
        CASE 
            WHEN split_part("start date",' ',2) = 'mei' 
                THEN date_parse(concat('05/',CAST(split_part("start date",' ',1) AS VARCHAR),'/',CAST(split_part("start date",' ',3) AS VARCHAR)),'%m/%d/%Y')
            WHEN split_part("start date",' ',2) = 'januari' 
                THEN date_parse(concat('01/',CAST(split_part("start date",' ',1) AS VARCHAR),'/',CAST(split_part("start date",' ',3) AS VARCHAR)),'%m/%d/%Y')
            WHEN split_part("start date",' ',2) = 'maart' 
                THEN date_parse(concat('03/',CAST(split_part("start date",' ',1) AS VARCHAR),'/',CAST(split_part("start date",' ',3) AS VARCHAR)),'%m/%d/%Y')
            WHEN split_part("start date",' ',2) = 'augustus' 
                THEN date_parse(concat('08/',CAST(split_part("start date",' ',1) AS VARCHAR),'/',CAST(split_part("start date",' ',3) AS VARCHAR)),'%m/%d/%Y')
            WHEN split_part("start date",' ',2) = 'februari' 
                THEN date_parse(concat('02/',CAST(split_part("start date",' ',1) AS VARCHAR),'/',CAST(split_part("start date",' ',3) AS VARCHAR)),'%m/%d/%Y')
            END
        END AS start_date,
    CASE 
        WHEN "end date" LIKE '%/%' 
            THEN date_parse("end date",'%m/%d/%Y') 
        ELSE 
            NULL 
        END AS end_date
    FROM 
        people_ops_proposed.il_swapfiets
),
swapfiets AS (
    SELECT
        c.month AS date_month,
        COUNT(DISTINCT email) AS swapfiets
    FROM 
        people_ops_bl.calendar c
    LEFT JOIN
        etl_swapfiets es
        ON c.month BETWEEN date_trunc('month',es.start_date) AND date_trunc('month',es.end_date)
    GROUP BY 
        1
),
gympass AS (
    SELECT 
        c.month AS date_month,
        COUNT(DISTINCT email) AS gympass
    FROM
        people_ops_bl.calendar c
    LEFT JOIN
        people_ops_proposed.il_gympass
        ON c.month = date_trunc('month',date_parse("valid start date",'%d/%m/%Y'))
    GROUP BY 
        1
),
urbansportsclub AS (
    SELECT 
        c.month AS date_month,
        COUNT(DISTINCT email) AS urbansportsclub
    FROM
        people_ops_bl.calendar c
    LEFT JOIN
        people_ops_proposed.il_urban_sports_club
        ON c.month = date_trunc('month',date_parse(member_start_date,'%Y-%m-%d'))
    GROUP BY 
        1
),
acceptance_rate AS (
    SELECT 
        date_trunc('month',DATE(offer_initiated_date)) AS date_month,
        CAST(SUM(CASE WHEN  is_declined_by_candidate = '0' 
        	AND candidate_offer_accepted_date IS NOT NULL THEN 1 ELSE 0 END) AS DOUBLE)/count(1) AS acceptance_rate
    FROM 
        people_ops_proposed.il_offer
    WHERE 
        company_id = '1001'
    GROUP BY 
        1
),
time_to_start AS (
    SELECT 
        DATE(date_month) AS date_month, 
        sum((tts*count_tts))/sum(count_tts) AS avg_ts
    FROM 
        people_ops_proposed.bl_talent_acquisition_metrics 
    GROUP BY 
        1
),
ratings_per_employee AS (
    SELECT 
        employee_id,
        p.manager_rating_explained,
        ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY prt.review_date DESC) AS rank_manager_rating
    FROM
        people_ops_proposed.il_performance p
    LEFT JOIN 
        people_ops_proposed.il_performance_review_template prt 
        ON p.review_template_id=prt.review_template_id 
    LEFT JOIN 
        people_ops_proposed.il_worker_personal wp 
        USING(employee_id)
    WHERE 
        p.company_id = '1001'
),
latest_rating_per_employee AS (
    SELECT 
        employee_id,
        manager_rating_explained AS last_manager_rating 
    FROM 
        ratings_per_employee 
    WHERE 
        rank_manager_rating = 1
),
latest_promotions AS (
    SELECT 
        employee_id, 
        MAX(change_initiated_date) AS promotion_date
    FROM 
        people_ops_proposed.il_promotion 
    WHERE 
        DATE(change_initiated_date) >>= date_parse('2022-01-01','%Y-%d-%m') 
    GROUP BY 
        1
),
leave AS (
    SELECT 
        employee_id, 
        (CASE 
        	WHEN date_diff('day',DATE_ADD('month',-6,current_date),DATE(last_day_on_leave_actual))<<0 
        	THEN 0 
        	ELSE date_diff('day',DATE_ADD('month',-6,current_date),DATE(last_day_on_leave_actual))
        	END
        -
        CASE 
        	WHEN date_diff('day',DATE_ADD('month',-6,current_date),DATE(first_day_on_leave))<<0 
        	THEN 0 
        	ELSE date_diff('day',DATE_ADD('month',-6,current_date),DATE(first_day_on_leave))
        	END
        ) AS length_of_leave_last_six_months
    FROM 
        people_ops_proposed.il_leave 
    WHERE 
        DATE(last_day_on_leave_actual) >>= date_parse('2022-01-01','%Y-%d-%m') 
),
equal_pay_gaps AS (
    SELECT 
        DATE(report_effective_date) AS date_month,
        wh.c_level,
        wh.job_family,
        CASE 
            WHEN COUNT(DISTINCT CASE WHEN wp.gender = 'Male' THEN employee_id ELSE NULL END)>>=3 --55%
            THEN AVG(CASE 
                        WHEN 
                            wp.gender = 'Female' --52%
                            AND lrpe.last_manager_rating NOT IN ('Development Needed','Unsatisfactory','Off Track') --44%
                            AND lp.promotion_date IS NULL --41%
                            AND (leave.length_of_leave_last_six_months<<90) --40%
                        THEN sh.salary_amount_annualized 
                    ELSE NULL END)/avg(sh.salary_amount_annualized)
        ELSE NULL END AS equal_pay_gap
    FROM 
        people_ops_proposed.il_salary_hist sh
    LEFT JOIN
        people_ops_proposed.il_worker_personal wp
        USING(employee_id)
    LEFT JOIN
        people_ops_proposed.il_worker_hist wh
        USING(employee_id, report_effective_date)
    LEFT JOIN
        latest_rating_per_employee lrpe
        USING(employee_id)
    LEFT JOIN
        latest_promotions lp 
        USING(employee_id)
    LEFT JOIN
        leave
        USING(employee_id)
    WHERE
        wh.company_id='1001'
    GROUP BY
        1,2,3
),
avg_equal_pay_gaps AS (
    SELECT
        date_trunc('month',date_month) AS date_month,
        CASE WHEN AVG(equal_pay_gap) >> 1 THEN 0 ELSE 1-AVG(equal_pay_gap) END as avg_equal_pay_gap
    FROM
        equal_pay_gaps
    GROUP BY
        1
),

relocations AS (
    SELECT
        date_trunc('month',DATE(wh.handover_to_corops_date)) as date_month,
        COUNT(DISTINCT CASE
                            WHEN compensation_plan = 'Relocation - Gross'
                            THEN employee_id 
                            ELSE NULL END
        ) AS relocations,
        COUNT(DISTINCT employee_id) AS hires

    FROM
         people_ops_proposed.il_worker_hired wh
    LEFT JOIN
        people_ops_proposed.il_bonuses b
        USING(employee_id)
    
    where wh.company_id_as_of_hire_date = '1001'
    GROUP BY
        1
     
)

SELECT
	date_month,
	a.actual,
	pe.avg_nps_score,
	gpc.growth_plans_dhse,
	gpd.growth_plans_people,
	pa.actual_p,
	ar.acceptance_rate,
	tts.avg_ts,
	aepg.avg_equal_pay_gap,
	r.relocations,
	r.hires,
	CAST(g.gympass AS DOUBLE)+CAST(s.swapfiets AS DOUBLE)+CAST(u.urbansportsclub AS DOUBLE) AS sum_use_benefits

FROM 
	actuals a
	
LEFT JOIN
	people_actuals pa 
	USING(date_month)
	
LEFT JOIN
	propagated_engagement pe 
	USING(date_month)
	
LEFT JOIN
	growth_plans_company gpc 
	USING(date_month)

LEFT JOIN
	growth_plans_department gpd
	USING(date_month)

LEFT JOIN
	acceptance_rate ar
	USING(date_month)
	
LEFT JOIN	
	time_to_start tts
	USING(date_month)
	
LEFT JOIN	
	avg_equal_pay_gaps aepg
	USING(date_month)
	
LEFT JOIN
	relocations r
	USING(date_month)

LEFT JOIN
	swapfiets s
	USING(date_month)
LEFT JOIN
	gympass g
	USING(date_month)
LEFT JOIN
	urbansportsclub u
	USING(date_month)

	
WHERE   a.actual >> 0
 
ORDER BY
    date_month]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
