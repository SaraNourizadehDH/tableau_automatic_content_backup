    <worksheet name='WOMEN TECH'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>LATEST % WOMEN IN TECH</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='18'><![CDATA[<[federated.0ojjruw0sxyiqo1axs1t40rlwcfr].[sum:Latest HiPo Retention (copy)_6002665052451110925:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ff0000' fontsize='11'><![CDATA[<[federated.0ojjruw0sxyiqo1axs1t40rlwcfr].[sum:Change (-) HiPo Retention (copy)_6002665052451110924:qk]>]]></run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='11'><![CDATA[<[federated.0ojjruw0sxyiqo1axs1t40rlwcfr].[sum:Change (+) HiPo Retention (copy)_6002665052451110923:qk]>]]></run>
            <run fontalignment='1' fontcolor='#272d36' fontsize='11'>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ABCs P&amp;C' name='federated.0ojjruw0sxyiqo1axs1t40rlwcfr' />
          </datasources>
          <datasource-dependencies datasource='federated.0ojjruw0sxyiqo1axs1t40rlwcfr'>
            <column caption='Change (+) Women_tech' datatype='real' name='[Change (+) HiPo Retention (copy)_6002665052451110923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest HiPo Retention (copy)_6002665052451110925] &gt; [Previous HiPo Retention (copy)_6002665052451110926] THEN&#10;([Latest HiPo Retention (copy)_6002665052451110925]-[Previous HiPo Retention (copy)_6002665052451110926])&#10;END)' />
            </column>
            <column caption='Change (-) Women_Tech' datatype='real' name='[Change (-) HiPo Retention (copy)_6002665052451110924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(IF [Latest HiPo Retention (copy)_6002665052451110925] &lt; [Previous HiPo Retention (copy)_6002665052451110926] THEN&#10;([Latest HiPo Retention (copy)_6002665052451110925]-[Previous HiPo Retention (copy)_6002665052451110926])&#10;END)' />
            </column>
            <column caption='Latest Women_Tech' datatype='real' name='[Latest HiPo Retention (copy)_6002665052451110925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))} &#10;THEN [women_leaders_in_tech] END) }' />
            </column>
            <column caption='Previous Women_tech' datatype='real' name='[Previous HiPo Retention (copy)_6002665052451110926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF MONTH([date_month])= {MAX(MONTH([date_month]))}-3 &#10;THEN [women_leaders_in_tech] END) }' />
            </column>
            <column-instance column='[women_leaders_in_tech]' derivation='Avg' name='[avg:women_leaders_in_tech:qk]' pivot='key' type='quantitative' />
            <column datatype='datetime' name='[date_month]' role='dimension' type='ordinal' />
            <column-instance column='[Change (+) HiPo Retention (copy)_6002665052451110923]' derivation='Sum' name='[sum:Change (+) HiPo Retention (copy)_6002665052451110923:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Change (-) HiPo Retention (copy)_6002665052451110924]' derivation='Sum' name='[sum:Change (-) HiPo Retention (copy)_6002665052451110924:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Latest HiPo Retention (copy)_6002665052451110925]' derivation='Sum' name='[sum:Latest HiPo Retention (copy)_6002665052451110925:qk]' pivot='key' type='quantitative' />
