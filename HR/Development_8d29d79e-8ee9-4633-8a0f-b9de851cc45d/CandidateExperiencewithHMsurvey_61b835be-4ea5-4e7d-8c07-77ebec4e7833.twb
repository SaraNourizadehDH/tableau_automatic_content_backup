    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='3 - Candidate Comments'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/CandidateExperiencewithHMsurvey/3-CandidateComments?rev=' id='3-CandidateComments' path='/t/HR/workbooks/CandidateExperiencewithHMsurvey' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
      </style>
      <size maxheight='1700' maxwidth='1400' minheight='1700' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='candidate_data' name='federated.0qi95321or88w0153px101gpdkwl' />
      </datasources>
      <datasource-dependencies datasource='federated.0qi95321or88w0153px101gpdkwl'>
        <column caption='Promoter / Passive / Detractor' datatype='string' name='[# Promoters (copy)_2887511085425877011]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Calculation_2887511085385408515]&lt;= 6 then &apos;Detractor&apos; &#10;ELSEIF [Calculation_2887511085385408515] = 7 or [Calculation_2887511085385408515] = 8 then &apos;Passive&apos;&#10;ELSEIF [Calculation_2887511085385408515]  &gt;= 9 then &apos;Promoter&apos;&#10;ELSE &apos;Non Numeric Answer&apos;&#10;END' />
        </column>
        <column caption='CPS Score Filter' datatype='real' name='[CPS Score (copy)_1387671670803263488]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='FLOAT(if [question_type] = &apos;0-10 rating (slider)&apos; or [question_type] = &apos;1-5 rating (stars)&apos;&#13;&#10;then [answer] else null end)' />
        </column>
        <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(YEAR([response_date])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([response_date]))' />
        </column>
        <column caption='Comment Filter' datatype='string' name='[Calculation_1374160864509161472]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([comment]) THEN &apos;No Comments&apos; ELSE &apos;Comments&apos; END' />
        </column>
        <column caption='Department' datatype='string' name='[Calculation_479633424631156736]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;    WHEN &apos;8706&apos; THEN [department_wd]&#13;&#10;END' />
        </column>
        <column caption='Sub Department' datatype='string' name='[Calculation_479633424631455745]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department]&#13;&#10;    WHEN &apos;8706&apos; THEN [sub_department_wd]&#13;&#10;END' />
        </column>
        <column caption='Manager 02' datatype='string' name='[Leader 01 ]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[manager_02_full_name]' new-bin='true'>
            <bin default-name='false' value='&quot;Ana Mitrasevic&quot;'>
              <value>&quot;Ana Mitrasevic&quot;</value>
              <value>&quot;Jeri Doris&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Benjamin Mann&quot;'>
              <value>&quot;Benjamin Mann&quot;</value>
              <value>&quot;Christian Hardenberg&quot;</value>
            </bin>
          </calculation>
        </column>
        <column caption='Company' datatype='string' name='[company_name]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Delivery Hero Teknoloji Hizmetleri Anonim Sirketi&quot;' value='Delivery Hero Turkey' />
