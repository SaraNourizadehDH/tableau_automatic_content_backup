      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='322' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='321' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='76' h='8800' id='29' is-fixed='true' is-scaled='1' param='Image/images.png' type-v2='bitmap' w='5572' x='571' y='800'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
