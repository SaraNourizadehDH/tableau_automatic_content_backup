                </bin>
              </calculation>
            </column>
            <column caption='# Detractors' datatype='integer' name='[Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2887511085385408515] &lt;= 6 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Answer' datatype='string' name='[answer]' role='dimension' type='nominal' />
