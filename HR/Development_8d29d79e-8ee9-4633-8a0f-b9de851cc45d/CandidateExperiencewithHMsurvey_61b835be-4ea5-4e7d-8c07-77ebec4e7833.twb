          <datasource-dependencies datasource='federated.0xghwit05ebndy11m2rty157ywu2'>
            <column caption='# Unique Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[# Responses (copy)_1803973176850886657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([reply_id])' />
            </column>
            <column caption='% Promoters' datatype='real' default-format='p0%' name='[% Detractors (copy)_2498090465554612226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_promoters]) / SUM([Calculation_2498090465554440192])' />
            </column>
            <column caption='% Passives' datatype='real' default-format='p0%' name='[% Promoters (copy)_1803973176851611651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_passives]) / SUM([Calculation_2498090465554440192])' />
            </column>
            <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date_month])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([date_month]))' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1803973176851165186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([% Detractors (copy)_2498090465554612226] - [Calculation_2498090465554534401]) * 100, 0)' />
            </column>
            <column caption='# Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2498090465554440192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[hm_promoters] + [hm_passives] + [hm_detractors]' />
            </column>
            <column caption='% Detractors' datatype='real' default-format='p0%' name='[Calculation_2498090465554534401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_detractors]) / SUM([Calculation_2498090465554440192])' />
