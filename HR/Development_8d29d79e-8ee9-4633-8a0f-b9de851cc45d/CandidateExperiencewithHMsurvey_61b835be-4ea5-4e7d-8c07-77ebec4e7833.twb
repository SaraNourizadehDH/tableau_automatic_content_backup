      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/CandidateExperiencewithHMsurvey/2-CandidateScoresperQuestion?rev=' id='2-CandidateScoresperQuestion' path='/t/HR/workbooks/CandidateExperiencewithHMsurvey' revision='' site='HR' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_8' value='center' />
        </style-rule>
