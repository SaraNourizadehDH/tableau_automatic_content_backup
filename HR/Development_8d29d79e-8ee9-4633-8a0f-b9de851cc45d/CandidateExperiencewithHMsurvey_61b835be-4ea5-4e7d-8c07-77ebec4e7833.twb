      <aliases enabled='yes' />
      <column caption='# Promoters' datatype='integer' name='[# Detractors (copy)_2887511085385961477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_2887511085385408515] &gt;= 9 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='# Passives' datatype='integer' name='[# Promoters (copy)_2887511085386182662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_2887511085385408515] = 7 or [Calculation_2887511085385408515] = 8 then 1 else 0 end)' />
      </column>
      <column caption='Promoter / Passive / Detractor' datatype='string' name='[# Promoters (copy)_2887511085425877011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2887511085385408515]&lt;= 6 then &apos;Detractor&apos; &#10;ELSEIF [Calculation_2887511085385408515] = 7 or [Calculation_2887511085385408515] = 8 then &apos;Passive&apos;&#10;ELSEIF [Calculation_2887511085385408515]  &gt;= 9 then &apos;Promoter&apos;&#10;ELSE &apos;Non Numeric Answer&apos;&#10;END' />
      </column>
      <column caption='% Detractors' datatype='real' name='[% Passives (copy)_2887511085386608649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652]) / WINDOW_SUM([Calculation_2887511084367032321])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Passives' datatype='real' name='[% Promoters (copy)_2887511085386567688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([# Promoters (copy)_2887511085386182662])/WINDOW_SUM([Calculation_2887511084367032321])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[min:Calculation_2887511085385408515:qk]&quot;' value='CPS Score' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:\% Passives (copy)_2887511085386608649:qk:8]&quot;' value='% Demoter' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:\% Promoters (copy)_2887511085386567688:qk:2]&quot;' value='% Passive' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:Calculation_2887511084367032321:qk]&quot;' value='# Response' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:Calculation_2887511085386440711:qk:4]&quot;' value='% Promoter' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:Calculation_2887511085392011277:qk]&quot;' value='Avg. NPS Score' />
          <alias key='&quot;[federated.0qi95321or88w0153px101gpdkwl].[usr:Calculation_3466786594993504272:qk]&quot;' value='AVG. CPS Score' />
        </aliases>
      </column>
      <column caption='CPS Score Filter' datatype='real' name='[CPS Score (copy)_1387671670803263488]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT(if [question_type] = &apos;0-10 rating (slider)&apos; or [question_type] = &apos;1-5 rating (stars)&apos;&#13;&#10;then [answer] else null end)' />
      </column>
      <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([response_date])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([response_date]))' />
      </column>
      <column caption='Last Updated Max' datatype='date' name='[Calculation_1100285750320078848]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED 1 : MAX( [last_updated] ) }' />
      </column>
      <column caption='0 to 10 Answers' datatype='real' name='[Calculation_1187261476020391936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;0-10 rating (slider)&apos; THEN [answer] &#13;&#10;ELSE NULL &#13;&#10;END)' />
      </column>
      <column caption='1  to 5 Answers' datatype='real' name='[Calculation_1187261476020498433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;1-5 rating (stars)&apos; THEN [answer]&#13;&#10;ELSE NULL &#13;&#10;END) * 2' />
      </column>
      <column caption='Normalized Answers' datatype='real' name='[Calculation_1187261476020641794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1187261476020391936] + [Calculation_1187261476020498433]' />
      </column>
      <column caption='Comment Filter' datatype='string' name='[Calculation_1374160864509161472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([comment]) THEN &apos;No Comments&apos; ELSE &apos;Comments&apos; END' />
      </column>
      <column caption='# Responses' datatype='integer' name='[Calculation_2887511084367032321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652] + [# Promoters (copy)_2887511085386182662] + [# Detractors (copy)_2887511085385961477]' />
      </column>
      <column caption='CPS Score' datatype='real' name='[Calculation_2887511085385408515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;0-10 rating (slider)&apos; THEN [Calculation_1187261476020391936] &#13;&#10;ELSEIF [question_type] = &apos;1-5 rating (stars)&apos; THEN [Calculation_1187261476020498433]&#13;&#10;ELSE NULL &#13;&#10;END)' />
      </column>
      <column caption='% Promoters' datatype='real' name='[Calculation_2887511085386440711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([# Detractors (copy)_2887511085385961477])/WINDOW_SUM([Calculation_2887511084367032321])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Hired' datatype='string' name='[Calculation_2887511085391785996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [employee_id] = &apos;&apos; then &apos;no&apos; else &apos;yes&apos; end' />
      </column>
      <column caption='NPS Score' datatype='real' name='[Calculation_2887511085392011277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*[Calculation_2887511085386440711]-100*[% Passives (copy)_2887511085386608649]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NPS Score - Color Scale' datatype='string' name='[Calculation_2887511085392277518]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2887511085392011277] &gt;= 30 then &apos;NPS &gt; 30&apos;&#10;ELSEIF [Calculation_2887511085392011277] &gt;= 0 and [Calculation_2887511085392011277] &lt; 30 then &apos;30 &gt; NPS &gt; 0&apos;&#10;else &apos;NPS &lt; 0&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Promoters' datatype='string' name='[Calculation_2887511085401456656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2887511085385408515] = 9 or [Calculation_2887511085385408515] = 10 then &apos;Promoter&apos; else &apos;Not Promoter&apos; end' />
      </column>
      <column caption='User Filter Definition' datatype='string' name='[Calculation_2887511085448945686]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF ([job_family_group] = &quot;DH Product&quot; AND [company_id] = &quot;1001&quot;) THEN &quot;DH Product&quot;&#13;&#10;ELSE [Calculation_479633424631156736]&#13;&#10;END' />
      </column>
      <column caption='AVG CPS Score' datatype='real' name='[Calculation_3466786594993504272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_2887511085385408515])' />
      </column>
      <column caption='Department' datatype='string' name='[Calculation_479633424631156736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;    WHEN &apos;8706&apos; THEN [department_wd]&#13;&#10;END' />
      </column>
      <column caption='Sub Department' datatype='string' name='[Calculation_479633424631455745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department]&#13;&#10;    WHEN &apos;8706&apos; THEN [sub_department_wd]&#13;&#10;END' />
      </column>
      <column caption='Manager 02' datatype='string' name='[Leader 01 ]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[manager_02_full_name]' new-bin='true'>
          <bin default-name='false' value='&quot;Ana Mitrasevic&quot;'>
            <value>&quot;Ana Mitrasevic&quot;</value>
            <value>&quot;Jeri Doris&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Benjamin Mann&quot;'>
            <value>&quot;Benjamin Mann&quot;</value>
            <value>&quot;Christian Hardenberg&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Management Level Track]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_level]' new-bin='true'>
          <bin default-name='false' value='&quot;IC&quot;'>
            <value>&quot;IC1&quot;</value>
            <value>&quot;IC2&quot;</value>
            <value>&quot;IC3&quot;</value>
            <value>&quot;IC4&quot;</value>
            <value>&quot;IC5&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;M&quot;'>
            <value>&quot;M1&quot;</value>
            <value>&quot;M2&quot;</value>
            <value>&quot;M3&quot;</value>
            <value>&quot;M4&quot;</value>
            <value>&quot;M5&quot;</value>
            <value>&quot;M6&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;S&quot;'>
            <value>&quot;S1&quot;</value>
            <value>&quot;S2&quot;</value>
            <value>&quot;S3&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='CPS Score - Color Scale' datatype='string' name='[NPS Score - Color Scale (copy)_2887511085433851924]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if avg([Calculation_2887511085385408515]) &gt;= 8 then &apos;Promoter&apos;&#10;ELSEIF  avg([Calculation_2887511085385408515]) &gt;= 6 and avg([Calculation_2887511085385408515]) &lt; 8 then &apos;Passive&apos;&#10;ELSE &apos;Detractor&apos; end' />
      </column>
      <column caption='Passives' datatype='string' name='[Promoters (copy)_2887511085401600017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2887511085385408515] = 7 or [Calculation_2887511085385408515] = 8 then &apos;Passive&apos; else null end' />
      </column>
      <column caption='Detractors' datatype='string' name='[Promoters (copy)_2887511085401976850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2887511085385408515] &lt;= 6 then &apos;Detractor&apos; else null end' />
      </column>
      <column caption='# Detractors' datatype='integer' name='[Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_2887511085385408515] &lt;= 6 THEN 1 ELSE 0 END)' />
      </column>
