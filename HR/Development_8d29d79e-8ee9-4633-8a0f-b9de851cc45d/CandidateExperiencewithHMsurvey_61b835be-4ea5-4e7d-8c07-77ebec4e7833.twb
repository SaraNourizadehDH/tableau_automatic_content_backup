            <column caption='# NPS Detractors' datatype='integer' default-format='n#,##0;-#,##0' name='[# Detractors (copy)_1803973176856547333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [driver] = &apos;NPS&apos; THEN [hm_detractors] ELSE NULL END' />
            </column>
            <column caption='# NPS Passives' datatype='integer' default-format='n#,##0;-#,##0' name='[# Passives (copy)_1803973176856547334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [driver] = &apos;NPS&apos; THEN [hm_passives] ELSE NULL END' />
            </column>
            <column caption='# NPS Promoters' datatype='integer' default-format='n#,##0;-#,##0' name='[# Promoters (copy)_1803973176856547335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [driver] = &apos;NPS&apos; THEN [hm_promoters] ELSE NULL END' />
            </column>
            <column caption='# NPS Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[# Responses (copy)_1803973176857096203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Promoters (copy)_1803973176856547335] + [# Passives (copy)_1803973176856547334] + [# Detractors (copy)_1803973176856547333]' />
            </column>
            <column caption='% NPS Detractors' datatype='real' default-format='p0%' name='[% Detractors (copy)_1803973176856973322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Detractors (copy)_1803973176856547333]) / SUM([# Responses (copy)_1803973176857096203])' />
            </column>
            <column caption='% NPS Promoters' datatype='real' default-format='p0%' name='[% Promoters (copy)_1803973176856973320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Promoters (copy)_1803973176856547335]) / SUM([# Responses (copy)_1803973176857096203])' />
            </column>
            <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date_month])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([date_month]))' />
            </column>
            <column caption='User Filter Definition' datatype='string' name='[Calculation_2887511085448945686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF ([job_family_group] = &quot;DH Product&quot; AND [company_id] = &quot;1001&quot;) THEN &quot;DH Product&quot;&#13;&#10;ELSE [department]&#13;&#10;END' />
            </column>
            <column caption='NPS (overall)' datatype='real' default-format='n#,##0;-#,##0' name='[NPS (copy)_1803973176857522188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([% Promoters (copy)_1803973176856973320] - [% Detractors (copy)_1803973176856973322]) * 100, 0)' />
            </column>
