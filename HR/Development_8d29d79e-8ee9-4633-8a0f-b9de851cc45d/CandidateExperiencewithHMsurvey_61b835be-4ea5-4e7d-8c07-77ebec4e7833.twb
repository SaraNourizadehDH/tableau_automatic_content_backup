            <column caption='CPS Score - Color Scale' datatype='string' name='[NPS Score - Color Scale (copy)_2887511085433851924]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if avg([Calculation_2887511085385408515]) &gt;= 8 then &apos;Promoter&apos;&#10;ELSEIF  avg([Calculation_2887511085385408515]) &gt;= 6 and avg([Calculation_2887511085385408515]) &lt; 8 then &apos;Passive&apos;&#10;ELSE &apos;Detractor&apos; end' />
            </column>
            <column caption='# Detractors' datatype='integer' name='[Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2887511085385408515] &lt;= 6 THEN 1 ELSE 0 END)' />
