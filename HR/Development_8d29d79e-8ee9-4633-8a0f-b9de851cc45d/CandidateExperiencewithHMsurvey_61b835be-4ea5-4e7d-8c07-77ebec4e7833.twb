    <worksheet name='NPS per '>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&lt;</run>
            <run>[Parameters].[Parameter 1]</run>
            <run>&gt; &amp; &lt;</run>
            <run>[Parameters].[Dimension 1 (copy)_1803973176878915599]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hm_data' name='federated.0xghwit05ebndy11m2rty157ywu2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_1803973176878915599]' param-domain-type='list' role='measure' type='nominal' value='&quot;Driver&quot;'>
              <calculation class='tableau' formula='&quot;Driver&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Company&quot;'>
              <calculation class='tableau' formula='&quot;Company&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xghwit05ebndy11m2rty157ywu2'>
            <column caption='# Unique Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[# Responses (copy)_1803973176850886657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([reply_id])' />
            </column>
            <column caption='% Promoters' datatype='real' default-format='p0%' name='[% Detractors (copy)_2498090465554612226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_promoters]) / SUM([Calculation_2498090465554440192])' />
            </column>
            <column caption='% Passives' datatype='real' default-format='p0%' name='[% Promoters (copy)_1803973176851611651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_passives]) / SUM([Calculation_2498090465554440192])' />
            </column>
            <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date_month])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([date_month]))' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1803973176851165186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([% Detractors (copy)_2498090465554612226] - [Calculation_2498090465554534401]) * 100, 0)' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_1803973176878956560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Company&apos; THEN [company_id]&#13;&#10;    WHEN &apos;Department&apos; THEN [department]&#13;&#10;    WHEN &apos;Sub Department&apos; THEN [sub_department]&#13;&#10;    WHEN &apos;Cost Center Name&apos; THEN [cost_center_name]&#13;&#10;    WHEN &apos;Hiring Manager&apos; THEN [hiring_manager]&#13;&#10;    WHEN &apos;Management Level&apos; THEN [management_level]&#13;&#10;    WHEN &apos;Job Family&apos; THEN [job_family]&#13;&#10;    WHEN &apos;Driver&apos; THEN [driver]&#13;&#10;    WHEN &apos;Question&apos; THEN [question]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;1001&quot;' value='Delivery Hero Berlin' />
                <alias key='&quot;8706&quot;' value='Delivery Hero Turkey' />
              </aliases>
            </column>
            <column caption='# Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2498090465554440192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[hm_promoters] + [hm_passives] + [hm_detractors]' />
            </column>
            <column caption='% Detractors' datatype='real' default-format='p0%' name='[Calculation_2498090465554534401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hm_detractors]) / SUM([Calculation_2498090465554440192])' />
            </column>
            <column caption='User Filter Definition' datatype='string' name='[Calculation_2887511085448945686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF ([job_family_group] = &quot;DH Product&quot; AND [company_id] = &quot;1001&quot;) THEN &quot;DH Product&quot;&#13;&#10;ELSE [department]&#13;&#10;END' />
