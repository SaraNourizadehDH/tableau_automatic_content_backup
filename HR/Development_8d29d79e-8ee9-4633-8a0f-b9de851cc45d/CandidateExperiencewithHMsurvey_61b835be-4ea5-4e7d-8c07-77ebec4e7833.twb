              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='64000' id='14' type-v2='text' w='92430' x='3782' y='10667'>
            <formatted-text>
              <run bold='true' fontsize='12'>Calculated Fields</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'>NPS Score</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>i.e. Net Promoter Score</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Likelihood that a candidate would recommend DHSE as a great place to work. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated from proportion of promoters subtracted by proportion of detractors using the formula </run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>NPS = [# Promoters / # Candidates ] - [# Detractors / # Candidates]</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Promoters</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of candidates that rated the CPS / NPS as 9 or 10. </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting unique instances of </run>
              <run bold='true' fontsize='12'>Candidate ID</run>
              <run fontsize='12'>.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Passives</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of candidates that rated CPS / NPS as 7 or 8.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting unique instances of </run>
              <run bold='true' fontsize='12'>Candidate ID</run>
              <run fontsize='12'>.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#d61f26' fontsize='12' italic='true'># Detractors</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>Number of candidates that rated CPS / NPS as 6 or less.</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Calculated by counting unique instances of </run>
              <run bold='true' fontsize='12'>Candidate ID</run>
              <run fontsize='12'>.</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7666' id='24' type-v2='text' w='92430' x='3782' y='74667'>
