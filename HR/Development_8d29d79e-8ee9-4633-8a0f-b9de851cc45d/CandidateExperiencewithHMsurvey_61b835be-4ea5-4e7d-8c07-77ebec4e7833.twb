    <worksheet name='# Promoters'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Promoters</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='candidate_data' name='federated.0qi95321or88w0153px101gpdkwl' />
          </datasources>
          <datasource-dependencies datasource='federated.0qi95321or88w0153px101gpdkwl'>
            <column caption='# Promoters' datatype='integer' name='[# Detractors (copy)_2887511085385961477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2887511085385408515] &gt;= 9 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='# Passives' datatype='integer' name='[# Promoters (copy)_2887511085386182662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_2887511085385408515] = 7 or [Calculation_2887511085385408515] = 8 then 1 else 0 end)' />
            </column>
            <column caption='Quarter / Year' datatype='string' name='[Calculation_1077767700889051136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([response_date])) +&quot; &quot;+&quot;Q&quot;+ STR(QUARTER([response_date]))' />
            </column>
            <column caption='0 to 10 Answers' datatype='real' name='[Calculation_1187261476020391936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;0-10 rating (slider)&apos; THEN [answer] &#13;&#10;ELSE NULL &#13;&#10;END)' />
            </column>
            <column caption='1  to 5 Answers' datatype='real' name='[Calculation_1187261476020498433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;1-5 rating (stars)&apos; THEN [answer]&#13;&#10;ELSE NULL &#13;&#10;END) * 2' />
            </column>
            <column caption='# Responses' datatype='integer' name='[Calculation_2887511084367032321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Question Type is 1-5 or 0-10 Rating (copy)_2887511085385883652] + [# Promoters (copy)_2887511085386182662] + [# Detractors (copy)_2887511085385961477]' />
            </column>
            <column caption='CPS Score' datatype='real' name='[Calculation_2887511085385408515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;IF [question_type] = &apos;0-10 rating (slider)&apos; THEN [Calculation_1187261476020391936] &#13;&#10;ELSEIF [question_type] = &apos;1-5 rating (stars)&apos; THEN [Calculation_1187261476020498433]&#13;&#10;ELSE NULL &#13;&#10;END)' />
            </column>
            <column caption='Promoters' datatype='string' name='[Calculation_2887511085401456656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_2887511085385408515] = 9 or [Calculation_2887511085385408515] = 10 then &apos;Promoter&apos; else &apos;Not Promoter&apos; end' />
            </column>
            <column caption='User Filter Definition' datatype='string' name='[Calculation_2887511085448945686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF ([job_family_group] = &quot;DH Product&quot; AND [company_id] = &quot;1001&quot;) THEN &quot;DH Product&quot;&#13;&#10;ELSE [Calculation_479633424631156736]&#13;&#10;END' />
            </column>
            <column caption='Department' datatype='string' name='[Calculation_479633424631156736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [department]&#13;&#10;    WHEN &apos;8706&apos; THEN [department_wd]&#13;&#10;END' />
            </column>
            <column caption='Sub Department' datatype='string' name='[Calculation_479633424631455745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [company_id]&#13;&#10;    WHEN &apos;1001&apos; THEN [sub_department]&#13;&#10;    WHEN &apos;8706&apos; THEN [sub_department_wd]&#13;&#10;END' />
            </column>
            <column caption='Manager 02' datatype='string' name='[Leader 01 ]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[manager_02_full_name]' new-bin='true'>
                <bin default-name='false' value='&quot;Ana Mitrasevic&quot;'>
