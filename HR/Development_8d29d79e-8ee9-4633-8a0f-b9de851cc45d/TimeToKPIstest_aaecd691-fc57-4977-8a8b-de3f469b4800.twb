    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/TimeToKPIstest/Definitions?rev=' id='Definitions' path='/t/HR/workbooks/TimeToKPIstest' revision='' site='HR' />
      <style />
      <size maxheight='1400' maxwidth='1400' minheight='1400' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='51297' id='3' type-v2='text' w='94286' x='2857' y='35071'>
            <formatted-text>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Post</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between the day a job requisition is created and the day when a job requisition was posted</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>Job Requisition Posted Date - Job Requisition Created Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Interview Candidate</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between a candidate is entered into the ATS and the day of first interview</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>Application Date - First Interview Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Interview Hiring Manager</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between a Job Requisition is created and the day of first interview of that Job Requisition</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>Job Creation Date - First Interview Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Hire</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between a candidate is entered into the ATS and the day the candidate is handed over to COPs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>Handover To CorOps Date - Application Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Contract (generated)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between a candidate is entered into the ATS and contract is generated</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>`Contract Generated Date - Application Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Contract (signed)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between a candidate is entered into the ATS and contract is signed by CorOps</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>Contract Signed Date - Application Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Fill - Full Process</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between the day a job requisition is created and the first day of hired candidate</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>First Day of Work - Job Requisition Created Date</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Time to Start</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Median of days between the candidate accepts the offer and the first day of hired candidate</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555'>Calculated using the formula: </run>
              <run bold='true' fontcolor='#555555'>First Day of Work - Handover to CorOps Date</run>
              <run>Æ&#10;&#10;&#10;</run>
            </formatted-text>
