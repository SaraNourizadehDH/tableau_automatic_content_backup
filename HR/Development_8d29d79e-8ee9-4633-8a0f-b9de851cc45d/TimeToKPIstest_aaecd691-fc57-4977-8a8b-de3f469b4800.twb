        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Department&apos; THEN [Calculation_1478588067972714496]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Cost Center&apos; THEN [cost_center_name (il_cc_hierarchy_wd)]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Hiring Manager&apos; THEN [hiring_manager]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Job Family Group&apos; THEN [job_family_group]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Management Level&apos; THEN [management_level]&#13;&#10;END' />
