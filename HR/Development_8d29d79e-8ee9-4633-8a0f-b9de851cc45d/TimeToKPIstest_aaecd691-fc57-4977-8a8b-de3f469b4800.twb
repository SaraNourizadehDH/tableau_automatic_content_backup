      <column caption='User Filter Definition' datatype='string' hidden='true' name='[Calculation_1128996179594874880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;Executive&apos;&#13;&#10;ELSEIF [job_family_group] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH International&quot; THEN &quot;DH International&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH People &amp; Culture&quot; THEN &quot;DH People &amp; Culture&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH CEO Office &amp; Strategy&quot; THEN &quot;DH CEO Office &amp; Strategy&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH Oeconomicis&quot; THEN &quot;DH Oeconomicis&quot;&#13;&#10;ELSEIF [Calculation_1478588067972714496] = &quot;DH Legal&quot; THEN &quot;DH Legal&quot;&#13;&#10;ELSE &quot;Other&quot; &#13;&#10;END' />
      </column>
      <column caption='Metric to Display' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1137158942291648520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Median TTCg&apos; THEN [Avg. TTCg (copy)_782781949105582082]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTCs&apos; THEN [Avg. TTCs (copy)_782781949105582081]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTF&apos; THEN [Avg. TTF (copy)_782781949104386048]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTH&apos; THEN [Avg. TTH (copy)_782781949105582087]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTIc&apos; THEN [Avg. TTI (copy)_782781949105582086]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTIhm&apos; THEN [Median TTIc (copy)_1286340647998689281]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTP&apos; THEN [Avg. TTP (copy)_782781949105582083]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Median TTS&apos; THEN [Avg. TTS (copy)_782781949105582085]&#13;&#10;END' />
      </column>
