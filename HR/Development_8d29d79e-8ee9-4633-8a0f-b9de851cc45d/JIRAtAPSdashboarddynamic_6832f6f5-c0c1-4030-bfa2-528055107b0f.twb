              <calculation class='tableau' formula='IF ISNULL([resolution_date]) or [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;NULL&#10;ELSEif DATETRUNC(&apos;month&apos;,[creation_date])=DATETRUNC(&apos;month&apos;,[resolution_date])&#10;THEN&#10;[ticket_number]&#10;ELSE&#10;NULL&#10;&#10;END' />
