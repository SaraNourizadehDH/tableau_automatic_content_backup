    <worksheet name='reporters/m/q/y'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Average Number of Reporters per timeframe</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Jira' name='federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Time to resolution' caption='p.sla parameter' datatype='real' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Time to resolution' />
                <alias key='2.' value='Time to first response' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)'>
            <column caption='c.ttfr-sla' datatype='string' name='[Calculation_134052476788842503]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_first_response_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
            </column>
            <column caption='c.sla param' datatype='string' name='[Calculation_134052476798832652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9]=1&#10;THEN&#10;[c.ttfr-sla (copy)_134052476789055497]&#10;ELSE&#10;[Calculation_134052476788842503]&#10;END' />
            </column>
            <column caption='c.avg unq rep-month' datatype='real' name='[Calculation_134052478187462669]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='countd([reporter]+STR(MONTH([creation_date]))+STR(YEAR([creation_date])))/&#10;DATEDIFF(&apos;month&apos;,MIN([creation_date]),MAX([creation_date]))' />
            </column>
            <column caption='c.status' datatype='string' name='[Calculation_2641713051732496384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([sub_status])' />
            </column>
            <column caption='Assignee Name' datatype='string' name='[assignee_full_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unassigned' />
              </aliases>
            </column>
            <column caption='c.avg unq rep-qtr' datatype='real' name='[c.avg unq rep-month (copy)_134052478484893712]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='countd([reporter]+STR(QUARTER([creation_date]))+STR(YEAR([creation_date])))/&#10;DATEDIFF(&apos;quarter&apos;,MIN([creation_date]),MAX([creation_date]))' />
            </column>
            <column caption='c.avg unq rep-year' datatype='real' name='[c.avg unq rep-qtr (copy)_134052478484979729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([reporter]+STR(YEAR([creation_date])))/&#10;DATEDIFF(&apos;year&apos;,MIN([creation_date]),MAX([creation_date]))' />
            </column>
            <column caption='c.ttr-sla' datatype='string' name='[c.ttfr-sla (copy)_134052476789055497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_resolution_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
            </column>
            <column caption='Component 1' datatype='string' name='[component_1]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Creation Date' datatype='date' datatype-customized='true' name='[creation_date]' role='dimension' type='ordinal' />
            <column-instance column='[creation_date]' derivation='MY' name='[my:creation_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_134052476798832652]' derivation='None' name='[none:Calculation_134052476798832652:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2641713051732496384]' derivation='None' name='[none:Calculation_2641713051732496384:nk]' pivot='key' type='nominal' />
            <column-instance column='[assignee_full_name]' derivation='None' name='[none:assignee_full_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[component_1]' derivation='None' name='[none:component_1:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[creation_date]' derivation='None' name='[none:creation_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_status]' derivation='None' name='[none:sub_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[talabat_request_type]' derivation='None' name='[none:talabat_request_type:nk]' pivot='key' type='nominal' />
            <column aggregation='CountD' caption='Reporter' datatype='string' default-role='measure' default-type='quantitative' name='[reporter]' role='dimension' type='nominal' />
            <column caption='Request Type' datatype='string' name='[request_type]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' name='[sub_status]' role='dimension' type='nominal' />
