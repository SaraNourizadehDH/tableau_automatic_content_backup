          <datasource-dependencies datasource='federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)'>
            <column caption='c.#resolved param' datatype='string' name='[Calculation_1097400588781498376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 10]=1&#10;THEN&#10;[Calculation_134052476361338881]&#10;ELSE&#10;[c.#resolved (copy)_1097400588780457989]&#10;END' />
            </column>
            <column aggregation='CountD' caption='c.#resolved' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_134052476361338881]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([resolution_date]) or [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;NULL&#10;ELSE&#10;&#10;[ticket_number]&#10;&#10;&#10;END' />
            </column>
            <column caption='c.%resolved' datatype='real' name='[Calculation_134052476361687042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_134052476361338881])/COUNTD([ticket_number])' />
            </column>
            <column caption='c.ttfr-sla' datatype='string' name='[Calculation_134052476788842503]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_first_response_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
