      <column caption='c.Average Resolution Time (DD:HH)-tb/others' datatype='string' datatype-customized='true' name='[Average Resolution Time (DD:HH) (copy)_4478618774616682506]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(AVG([Calculation_556264938122522634])/86400))&#10;&#10;+ &quot; day(s) &quot; +&#10;&#10;IF (INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&lt; 10 THEN &quot;0&quot; ELSE &quot;&quot; END + STR(INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&#10;+ &quot; hour(s) &quot;' />
      </column>
      <column caption='Average Resolution Time (DD:HH:MM:SS)' datatype='string' datatype-customized='true' hidden='true' name='[Average Time to Done (DD:HH:MM:SS) (copy)_329536846455828480]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(AVG([Calculation_556264938122522634])/86400))&#10;&#10;+ &quot; day(s) &quot; +&#10;&#10;IF (INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&lt; 10 THEN &quot;0&quot; ELSE &quot;&quot; END + STR(INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&#10;+ &quot;h:&quot; +&#10;&#10;IF INT(AVG([Calculation_556264938122522634])%3600/60)&#10;&lt;10 THEN &quot;0&quot; ELSE &quot;&quot; END + STR(INT(AVG([Calculation_556264938122522634])%3600/60))&#10;&#10;+ &quot;m:&quot; +&#10;&#10;IF INT(AVG([Calculation_556264938122522634]) %3600 %60)&#10;&lt;10 THEN &quot;0&quot; ELSE &quot;&quot; END + STR(INT(AVG([Calculation_556264938122522634]) %3600 %60))&#10;&#10;+ &quot;s&quot;' />
      </column>
      <column caption='C.ending point-#tickets (copy)' datatype='integer' hidden='true' name='[C.rstarting point-#tickets (copy)_6152761572722114582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNTD([ticket_number]))+COUNTD([ticket_number])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C.rstarting point-#tickets' datatype='integer' hidden='true' name='[C.running sum-sub-#tickets (copy)_6152761572717801493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNTD([ticket_number]))-COUNTD([ticket_number])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Analysis' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(COUNTD([ticket_number])) - LOOKUP(ZN(COUNTD([ticket_number])), -1)) / ABS(LOOKUP(ZN(COUNTD([ticket_number])), -1))'>
          <table-calc ordering-field='[federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)].[tmn:creation_date:qk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='reporter_brand' datatype='string' hidden='true' name='[Calculation_1085508291155869697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_internal_ticket]=1 then null else [reporter_brand] end' />
      </column>
      <column caption='COUNT([Ticket Number]) / TOTAL(COUNT([Ticket Number]))' datatype='real' hidden='true' name='[Calculation_1085508291163463690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ticket_number]) / TOTAL(COUNT([ticket_number]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='c.#resolved param' datatype='string' name='[Calculation_1097400588781498376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 10]=1&#10;THEN&#10;[Calculation_134052476361338881]&#10;ELSE&#10;[c.#resolved (copy)_1097400588780457989]&#10;END' />
      </column>
      <column aggregation='CountD' caption='c.#resolved' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_134052476361338881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([resolution_date]) or [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;NULL&#10;ELSE&#10;&#10;[ticket_number]&#10;&#10;&#10;END' />
      </column>
      <column caption='c.%resolved' datatype='real' name='[Calculation_134052476361687042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_134052476361338881])/COUNTD([ticket_number])' />
      </column>
      <column caption='c.ttfr-sla' datatype='string' name='[Calculation_134052476788842503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_first_response_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
      </column>
      <column caption='c.sla param' datatype='string' name='[Calculation_134052476798832652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9]=1&#10;THEN&#10;[c.ttfr-sla (copy)_134052476789055497]&#10;ELSE&#10;[Calculation_134052476788842503]&#10;END' />
      </column>
      <column caption='c.avg unq rep-month' datatype='real' name='[Calculation_134052478187462669]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='countd([reporter]+STR(MONTH([creation_date]))+STR(YEAR([creation_date])))/&#10;DATEDIFF(&apos;month&apos;,MIN([creation_date]),MAX([creation_date]))' />
      </column>
      <column caption='Weekday' datatype='string' hidden='true' name='[Calculation_1670061430074957824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[creation_date])' />
      </column>
      <column caption='c.hc wrt creation date-exc' datatype='integer' hidden='true' name='[Calculation_1876945571074007048]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ EXCLUDE [component_1],[request_type],[project],[assignee_full_name],[assignee_company],[sub_status]: COUNTD([c.hc wrt creation date (copy)_1876945571080749068])}' />
      </column>
      <column caption='c.% unique reporters' datatype='real' hidden='true' name='[Calculation_1876945571074797577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([reporter_employee_id])/SUM([Calculation_1876945571074007048])' />
      </column>
      <column caption='SLA breach %' datatype='real' hidden='true' name='[Calculation_197314008677498885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_3358559469383618565])/COUNTD([Calculation_2879137210250215424])' />
      </column>
      <column caption='SLA DHP' datatype='string' hidden='true' name='[Calculation_197314008695676934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [project]=&apos;DHP&apos; THEN [Calculation_3358559469383618565]&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Resolution - Status date' datatype='datetime' hidden='true' name='[Calculation_2031334584643485697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([resolution_date]) THEN [status_date] ELSE [resolution_date] END' />
      </column>
      <column caption='Test' datatype='integer' hidden='true' name='[Calculation_2282973184160468992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column aggregation='Count' caption='Time - Germany, Egypt' datatype='date' hidden='true' name='[Calculation_2282973184167038977]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[creation_date]' />
      </column>
      <column caption='Time - Jordan, Qatar, Kuwait, Bahrain, Iraq' datatype='datetime' hidden='true' name='[Calculation_2282973184167239682]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;,1,[creation_date])' />
      </column>
      <column caption='Time - UAE, Oman' datatype='datetime' hidden='true' name='[Calculation_2282973184167976963]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;,2,[creation_date])' />
      </column>
      <column caption='Time - Singapore' datatype='datetime' hidden='true' name='[Calculation_2282973184168439812]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;,6,[creation_date])' />
      </column>
      <column caption='c.status' datatype='string' name='[Calculation_2641713051732496384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([sub_status])' />
      </column>
      <column caption='Resolved #Tickets' datatype='string' hidden='true' name='[Calculation_2879137210250215424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sub_status] = &apos;Resolved&apos; OR [sub_status] = &apos;Done&apos; OR [sub_status] = &apos;Completed&apos; THEN [ticket_number] END' />
      </column>
      <column caption='c.sub status filter' datatype='string' name='[Calculation_302515297838571523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_status (group)]' />
      </column>
      <column caption='c.avg time since creation' datatype='integer' hidden='true' name='[Calculation_302515297838718980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [sub_status (group)]=&quot;In Progress/Pending&quot;&#10;THEN&#10;TODAY()-[creation_date]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='c.in progress-1' datatype='string' hidden='true' name='[Calculation_302515297854664711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sub_status (group)]=&quot;In Progress/Pending&quot;&#10;THEN&#10;[ticket_number]&#10;ELSE&#10;NULL&#10;END' />
      </column>
      <column caption='SLA breach' datatype='string' hidden='true' name='[Calculation_3358559469383618565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[creation_date],[resolution_date]) &gt; 5 THEN [ticket_number] END' />
      </column>
      <column caption='workload' datatype='real' hidden='true' name='[Calculation_3868662498824515615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ticket_number])/COUNTD([assignee])' />
      </column>
      <column caption='out_of_working_hours' datatype='string' hidden='true' name='[Calculation_3868662498851610658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[creation_date]) &lt; 9 OR DATEPART(&apos;hour&apos;,[creation_date]) &gt; 18 THEN [ticket_number] ELSE NULL END' />
      </column>
      <column caption='colour' datatype='integer' hidden='true' name='[Calculation_3868662499255177330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([reporter_brand]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='ratio_out_of_working_hours' datatype='real' hidden='true' name='[Calculation_3868662499259089017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_3868662498851610658])/COUNTD([ticket_number])' />
      </column>
      <column caption='c.# resolution tb/others' datatype='string' default-role='measure' default-type='quantitative' hidden='true' name='[Calculation_4478618774298685440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [project]=&quot;TWS&quot; &#10;THEN&#10;[Calculation_766948991402946560]&#10;ELSE&#10;[c.# resolution-tb (copy)_4478618774298873857]&#10;END' />
      </column>
      <column caption='c.avg resolution time in seconds-tb/others' datatype='integer' hidden='true' name='[Calculation_4478618774615728137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [project]=&quot;TWS&quot;&#10;THEN&#10;(&#10;IF [Calculation_766948991402946560]&lt;&gt;&quot;Not Resolved&quot;&#10;THEN&#10;DATEDIFF(&apos;second&apos;,[creation_date],[resolution_date]) END&#10;)&#10;ELSE&#10;[Calculation_556264938122522634]&#10;END' />
      </column>
      <column caption='Choose Metrics P TEST' datatype='real' hidden='true' name='[Calculation_556264937440075777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Ticket Numbers&apos; THEN [Calculation_556264938917842962]&#10;WHEN &apos;% of Total Tickets&apos; THEN [Calculation_1085508291163463690]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Status - Done' datatype='integer' hidden='true' name='[Calculation_556264938088488962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [status] = &apos;Done&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Average Resolution Time  (Seconds)' datatype='integer' name='[Calculation_556264938122522634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status]=&apos;Done&apos; THEN DATEDIFF(&apos;second&apos;,[creation_date],[resolution_date]) END' />
      </column>
      <column caption='Average Resolution Time ' datatype='real' hidden='true' name='[Calculation_556264938144645133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_556264938122522634])' />
      </column>
      <column caption='Average Resolution Time (DD:HH)' datatype='string' datatype-customized='true' hidden='true' name='[Calculation_556264938786725902]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(AVG([Calculation_556264938122522634])/86400))&#10;&#10;+ &quot; day(s) &quot; +&#10;&#10;IF (INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&lt; 10 THEN &quot;0&quot; ELSE &quot;&quot; END + STR(INT(AVG([Calculation_556264938122522634])%86400/3600))&#10;&#10;+ &quot; hour(s) &quot;' />
      </column>
      <column caption='Weekdays' datatype='datetime' datatype-customized='true' hidden='true' name='[Calculation_556264938795405327]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPARSE ( &quot;MM&quot;, STR(DATEPART(&apos;weekday&apos;,[creation_date])) ) ' />
      </column>
      <column caption='COUNTD tickets' datatype='integer' hidden='true' name='[Calculation_556264938917842962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ticket_number])' />
      </column>
      <column caption='Exclude internal tickets' datatype='string' hidden='true' name='[Calculation_556264939239768090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_internal_ticket]=1,&apos;Include&apos;,&apos;Exclude&apos;)' />
      </column>
      <column caption='c.pending for' datatype='integer' name='[Calculation_599330615400075265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[creation_date],TODAY())' />
      </column>
      <column caption='c.resolution date filter' datatype='boolean' hidden='true' name='[Calculation_6152761572708614153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[creation_date]&gt;= TODAY()-3' />
      </column>
      <column caption='C.running sum-sub-#tickets' datatype='integer' hidden='true' name='[Calculation_6152761572717576212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNTD([ticket_number]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='k' datatype='integer' hidden='true' name='[Calculation_6837238338904801280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Incoming Requests' datatype='string' hidden='true' name='[Calculation_6837238338915528711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Brand&apos; THEN [reporter_brand]&#10;WHEN &apos;Department&apos; THEN [reporter_department]&#10;WHEN &apos;Sub Department&apos; THEN [reporter_sub_department]&#10;WHEN &apos;Cost Center&apos; THEN [reporter_cost_center_name]&#10;WHEN &apos;Supervisory Org&apos; THEN [reporter_supervisory_org]&#10;END' />
        <aliases>
          <alias key='%null%' value='External / Not on Workday' />
        </aliases>
      </column>
      <column caption='c.# resolution-tb' datatype='string' hidden='true' name='[Calculation_766948991402946560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([resolution_date]) or [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;&quot;Not Resolved&quot;&#10;ELSE&#10;(IF  DAY([creation_date])&lt;25&#10;THEN&#10;(&#10;IF DATETRUNC(&apos;month&apos;,[creation_date])=DATETRUNC(&apos;month&apos;,[resolution_date])&#10;THEN&#10;&quot;Resolved&quot;&#10;ELSE&#10;&quot;Resolved outside timeframe&quot;&#10;END&#10;&#10;&#10;)&#10;ELSEif&#10;(    DATEDIFF( &quot;week&quot;, [creation_date], [resolution_date] ) * 5 &#10;      - MAX( DATEPART( &quot;weekday&quot;, [creation_date] ) - 2, 0 )&#10;       + MIN( DATEPART( &quot;weekday&quot;, [creation_date] ) - 1, 5 ))&lt;=5&#10;THEN&#10;&quot;Resolved&quot;&#10;ELSE&#10;&quot;Resolved outside timeframe&quot;&#10;END)&#10;END' />
      </column>
      <column caption='c.creation date filter' datatype='date' hidden='true' name='[Calculation_766948991427575811]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[creation_date]' />
      </column>
      <column caption='c.status 1' datatype='string' hidden='true' name='[Calculation_766948992075653126]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[status]' />
      </column>
      <column caption='c.dummy axis' datatype='integer' hidden='true' name='[Calculation_766948992078200839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='C.IN PROGRESS' datatype='integer' hidden='true' name='[Calculation_766948992089612296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [status]&lt;&gt;&quot;Cancelled&quot; and ISNULL([resolution_date])&#10;THEN&#10;1&#10;ELSE&#10;0&#10;END' />
      </column>
      <column caption='c.choose dimension' datatype='string' name='[Calculation_766948992426348563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=1&#10;THEN&#10;[country]&#10;ELSEIF [Parameters].[Parameter 4]=2&#10;then&#10;[component_1]&#10;ELSEIF [Parameters].[Parameter 4]=3&#10;THEN&#10;[assignee_full_name]&#10;ELSEIF [Parameters].[Parameter 4]=4&#10;THEN&#10;[sub_status]&#10;ELSEIF [Parameters].[Parameter 4]=5&#10;THEN&#10;[request_type]&#10;ELSEIF [Parameters].[Parameter 4]=6&#10;THEN&#10;left(str(DATENAME(&apos;month&apos;,[creation_date])),3)&#10;+&quot; &quot;+right(str(year([creation_date])),2)&#10;END' />
        <aliases>
          <alias key='%null%' value='Unspecified' />
        </aliases>
      </column>
      <column caption='c.sla' datatype='integer' name='[Calculation_766948992466423829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [component_1]=&apos;[BF] Benefits&apos; or [component_1]=&apos;[WR] Workday Request&apos; &#10;or [component_1]=&apos;[WS] Workday Support&apos; or [component_1]=&apos;Workday Configuration (WC)&apos;&#10;or [component_1]=&apos;Workday D-Stores Migration&apos; &#10;THEN&#10;24&#10;ELSE&#10;16&#10;END' />
      </column>
      <column caption='c.weekday diff' datatype='integer' name='[Calculation_766948992467136534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(DATEDIFF( &quot;week&quot;, [creation_date], [resolution_date] ) * 5 &#10;      - MAX( DATEPART( &quot;weekday&quot;, [creation_date] ) - 2, 0 )&#10;       + MIN( DATEPART( &quot;weekday&quot;, [resolution_date] ) - 1, 5 ))*9' />
      </column>
      <column aggregation='CountD' caption='c.sla met/not' datatype='string' name='[Calculation_766948992478445592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;&quot;Canceled&quot;&#10;elseIF [Calculation_766948992467136534]&gt;[Calculation_766948992466423829]&#10;THEN&#10;&quot;SLA breached&quot;&#10;ELSEif [Calculation_766948992467136534]&lt;=[Calculation_766948992466423829]&#10;then&#10;&quot;SLA met&quot;&#10;ELSE&#10;[sub_status (group)]&#10;END' />
        <aliases>
          <alias key='&quot;In Progress, Pending, Waiting for Employee and 1 more&quot;' value='In Progress/Pending' />
        </aliases>
      </column>
      <column caption='Status - To Do' datatype='integer' hidden='true' name='[Status - Backlog (copy)_556264938094694406]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [status] = &apos;To Do&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Status - Backlog' datatype='integer' hidden='true' name='[Status - Cancelled (copy)_556264938094624773]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [status] = &apos;Backlog&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Status - In Progress' datatype='integer' hidden='true' name='[Status - Done (copy)_556264938094354435]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [status] = &apos;In Progress&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Status - Cancelled' datatype='integer' hidden='true' name='[Status - In Progress (copy)_556264938094522372]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; THEN 1 ELSE 0 END' />
      </column>
