      <repository-location derived-from='https://tableau.deliveryhero.net/t/HR/workbooks/Jiratickets-Global/date?rev=' id='date' path='/t/HR/workbooks/Jiratickets-Global-feedback' revision='' site='HR' />
      <table>
        <view>
          <datasources>
            <datasource caption='Jira' name='federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Country' caption='p.choose dimension' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Country' />
                <alias key='2' value='Component' />
                <alias key='3' value='Assignee' />
                <alias key='4' value='Status' />
                <alias key='5' value='Request type' />
                <alias key='6' value='Created date' />
              </aliases>
            </column>
            <column alias='Time to resolution' caption='p.sla parameter' datatype='real' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Time to resolution' />
                <alias key='2.' value='Time to first response' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w5r8dh0dbs5u310749yz0m8e0he (copy)'>
            <column caption='c.ttfr-sla' datatype='string' name='[Calculation_134052476788842503]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_first_response_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
            </column>
            <column caption='c.sla param' datatype='string' name='[Calculation_134052476798832652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9]=1&#10;THEN&#10;[c.ttfr-sla (copy)_134052476789055497]&#10;ELSE&#10;[Calculation_134052476788842503]&#10;END' />
            </column>
            <column caption='c.status' datatype='string' name='[Calculation_2641713051732496384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([sub_status])' />
            </column>
            <column caption='DATE(MAX([Creation Date]))' datatype='date' name='[Calculation_3927138881306718210]' role='measure' type='ordinal' user:unnamed='Sheet 18'>
              <calculation class='tableau' formula='DATE(MAX([creation_date]))' />
            </column>
            <column caption='c.choose dimension' datatype='string' name='[Calculation_766948992426348563]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=1&#10;THEN&#10;[country]&#10;ELSEIF [Parameters].[Parameter 4]=2&#10;then&#10;[component_1]&#10;ELSEIF [Parameters].[Parameter 4]=3&#10;THEN&#10;[assignee_full_name]&#10;ELSEIF [Parameters].[Parameter 4]=4&#10;THEN&#10;[sub_status]&#10;ELSEIF [Parameters].[Parameter 4]=5&#10;THEN&#10;[request_type]&#10;ELSEIF [Parameters].[Parameter 4]=6&#10;THEN&#10;left(str(DATENAME(&apos;month&apos;,[creation_date])),3)&#10;+&quot; &quot;+right(str(year([creation_date])),2)&#10;END' />
              <aliases>
                <alias key='%null%' value='Unspecified' />
              </aliases>
            </column>
            <column caption='c.sla' datatype='integer' name='[Calculation_766948992466423829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [component_1]=&apos;[BF] Benefits&apos; or [component_1]=&apos;[WR] Workday Request&apos; &#10;or [component_1]=&apos;[WS] Workday Support&apos; or [component_1]=&apos;Workday Configuration (WC)&apos;&#10;or [component_1]=&apos;Workday D-Stores Migration&apos; &#10;THEN&#10;24&#10;ELSE&#10;16&#10;END' />
            </column>
            <column caption='c.weekday diff' datatype='integer' name='[Calculation_766948992467136534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DATEDIFF( &quot;week&quot;, [creation_date], [resolution_date] ) * 5 &#10;      - MAX( DATEPART( &quot;weekday&quot;, [creation_date] ) - 2, 0 )&#10;       + MIN( DATEPART( &quot;weekday&quot;, [resolution_date] ) - 1, 5 ))*9' />
            </column>
            <column aggregation='CountD' caption='c.sla met/not' datatype='string' name='[Calculation_766948992478445592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sub_status]=&quot;Canceled&quot;&#10;THEN&#10;&quot;Canceled&quot;&#10;elseIF [Calculation_766948992467136534]&gt;[Calculation_766948992466423829]&#10;THEN&#10;&quot;SLA breached&quot;&#10;ELSEif [Calculation_766948992467136534]&lt;=[Calculation_766948992466423829]&#10;then&#10;&quot;SLA met&quot;&#10;ELSE&#10;[sub_status (group)]&#10;END' />
              <aliases>
                <alias key='&quot;In Progress, Pending, Waiting for Employee and 1 more&quot;' value='In Progress/Pending' />
              </aliases>
            </column>
            <column caption='Assignee Name' datatype='string' name='[assignee_full_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unassigned' />
              </aliases>
            </column>
            <column caption='c.ttr-sla' datatype='string' name='[c.ttfr-sla (copy)_134052476789055497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([assignee_full_name])&#10;THEN&#10;&quot;Unassigned&quot;&#10;elseif&#10;[time_to_resolution_sla_tracker]&lt;0&#10;THEN&#10;&quot;SLA Breached&quot;&#10;ELSE&#10;&quot;SLA Met&quot;&#10;END' />
            </column>
            <column caption='Component 1' datatype='string' name='[component_1]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
