            <column datatype='real' datatype-customized='true' name='[time_to_resolution_sla_tracker]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_134052478187462669]' derivation='User' name='[usr:Calculation_134052478187462669:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c.avg unq rep-month (copy)_134052478484893712]' derivation='User' name='[usr:c.avg unq rep-month (copy)_134052478484893712:qk]' pivot='key' type='quantitative' />
            <column-instance column='[c.avg unq rep-qtr (copy)_134052478484979729]' derivation='User' name='[usr:c.avg unq rep-qtr (copy)_134052478484979729:qk]' pivot='key' type='quantitative' />
