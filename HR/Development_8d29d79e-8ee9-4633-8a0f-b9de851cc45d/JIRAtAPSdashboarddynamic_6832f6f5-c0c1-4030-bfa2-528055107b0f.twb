      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='723' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99058' id='722' param='vert' type-v2='layout-flow' w='98858' x='571' y='471'>
                <zone fixed-size='88' h='5863' id='589' is-fixed='true' is-scaled='1' param='Image/Untitled design (11).png' type-v2='bitmap' w='5572' x='571' y='471'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#272d36' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='5863' id='10' type-v2='text' w='93286' x='6143' y='471'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Purpose and Objectives</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#272d36' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='49393' id='210' type-v2='text' w='94286' x='2857' y='8489'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>Purpose</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Æ  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This dashboard is created to provide an overview of the volume of Jira tickets.</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>1 - Volume of Tickets</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides an overview of the overall volume of Jira tickets and their MoM growth. It also provides an overview about Weekday volume, average resolution time, sum of the tickets within selected time period, the relative distribution across teams and the distribution over time.</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Æ  </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>2 - Status of tickets</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides an overview of the status of Jira tickets overall and by team. The time window and status can be selected for a detailed view.</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Æ  </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>3 - Source of Received Tickets</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides an overview of the source of the incoming requests by country, brand, company and Cost Center. It also provides a distribution of tickets by requesting department per team.</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>Æ </run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>4 - Workload of the Team Members</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides an overview of the workload of each team member, volume of tickets per weekday, average resolution time, volume MoM and status information. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Æ  </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='12'>5 - Workflow from People Solutions to People Tech (only for the Central team)</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides an overview of tickets assigned by People Solutions teams to People Tech team, categorised by request type, component and label.</run>
                    <run fontcolor='#000000' fontsize='12'>Æ </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>6 - Resolution trend</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides a trend of ticket count, resolution status and resolution speed. The trend can be viewed by years, months or days. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>7 - SLA</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides a trend of ticket count by their respective SLA status (i.e SLA met/ SLA breached). Further deepdive by country, component and assignee.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>8 - Indepth</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontsize='12'>This view provides a detailed  view of all fields/components associated to individual tickets. This can be exported to excel for analysis.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='5798' id='24' type-v2='text' w='98858' x='571' y='93731'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#000000' fontsize='10'>Owned By: </run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Javad Eldarli, Kaavya Prakash</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontsize='10'>Please direct all inquiries to the </run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>People Analytics JIRA</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run auto-url='true' bold='true' fontalignment='1' fontcolor='#ffffff' hyperlink='tabdoc:load-url url=&amp;quot;https://jira.deliveryhero.com/plugins/servlet/desk/portal/53&amp;quot;' underline='true'>https://jira.deliveryhero.com/plugins/servlet/desk/portal/53</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{C1546584-0C90-4648-9AC4-DE8ADBFBAB1E}' />
    </dashboard>
