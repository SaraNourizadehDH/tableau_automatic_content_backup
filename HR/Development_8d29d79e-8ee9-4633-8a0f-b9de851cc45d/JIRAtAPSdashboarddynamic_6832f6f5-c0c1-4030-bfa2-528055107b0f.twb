        <calculation class='tableau' formula='str(FLOOR(AVG(([time_to_first_response_sla]-[time_to_first_response_sla_tracker])/60)))+&#10;&quot; hour(s) &quot;+&#10;STR(round(60*(AVG((([time_to_first_response_sla]-[time_to_first_response_sla_tracker])/60)-&#10;FLOOR(([time_to_first_response_sla]-[time_to_first_response_sla_tracker])/60))),0))&#10;+&quot; min(s)&quot;' />
