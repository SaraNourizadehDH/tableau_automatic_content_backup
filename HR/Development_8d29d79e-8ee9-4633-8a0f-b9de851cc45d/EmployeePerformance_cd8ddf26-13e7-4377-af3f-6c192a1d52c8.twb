    <worksheet name='High Performers'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontsize='9'>What proportion of each department, cost center, and job family are high performers?</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Performance' name='federated.1q8adrs1h22vrj0zvwxn50lyh10q' />
          </datasources>
          <datasource-dependencies datasource='federated.1q8adrs1h22vrj0zvwxn50lyh10q'>
            <column caption='User Filter Definition' datatype='string' name='[Calculation_2286562008120201221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;M4+&apos;&#10;ELSEIF [job_requisition_id] = &quot;JR0013856&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [job_family] = &quot;Product Design / Management&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Analytics&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Operations&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [department] = &quot;DH International&quot; THEN &quot;DH International&quot;&#10;ELSEIF [department] = &quot;DH People&quot; THEN &quot;DH People&quot;&#10;ELSEIF [department] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#10;ELSEIF [department] = &quot;DH Strategy&quot; THEN &quot;DH Strategy&quot;&#10;ELSEIF [department] = &quot;DH Finance&quot; THEN &quot;DH Finance&quot;&#13;&#10;ELSEIF [department] = &quot;DH Legal&quot; THEN &quot;DH Legal&quot;&#10;ELSE &quot;Other&quot; &#10;END' />
            </column>
            <column caption='Performance Group' datatype='string' name='[Calculation_4451808259991916546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [manager_rating] = 5 then &apos;High Performer&apos;&#10;elseif [manager_rating] = 4 then &apos;High Performer&apos;&#10;else &apos;Not High Performer&apos; end' />
            </column>
            <column caption='# Employees Reviewed' datatype='integer' name='[Calculation_4451808259992592387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([employee_id])' />
            </column>
            <column caption='# High Performers' datatype='integer' name='[Calculation_4451808259993112580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_4451808259991916546] = &apos;High Performer&apos; then 1&#10;else 0 END)' />
            </column>
            <column caption='% High Performers' datatype='real' name='[Calculation_4451808259993321477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4451808259993112580]/[Calculation_4451808259992592387]' />
