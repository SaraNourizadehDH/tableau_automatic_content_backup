          <zone forceUpdate='true' h='39500' id='14' type-v2='text' w='92430' x='3782' y='12800'>
            <formatted-text>
              <run bold='true' fontsize='12'>Purpose</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>The dashboard was created to provide an overview of performance ratings for each review template.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='12'>Objectives</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>The dashboard was created to answer the following commonly asked questions:</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='12'>1. How many employees received each score in the selected performance review template?</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>2. What proportion of employees received each score in the selected performance review template?</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>3. What proportion of employees are high performers?</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>4. What is the average tenure among high performers? </run>
              <run>Æ&#10;</run>
              <run fontsize='12'>5. What is the average time to promotion among high performers?</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
