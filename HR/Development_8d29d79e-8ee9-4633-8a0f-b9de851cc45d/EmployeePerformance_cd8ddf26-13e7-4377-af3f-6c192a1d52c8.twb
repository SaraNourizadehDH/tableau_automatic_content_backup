      <column caption='User Filter Definition' datatype='string' name='[Calculation_2286562008120201221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_level] = &apos;M4&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M5&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;M6&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E1&apos; THEN &apos;M4+&apos;&#10;ELSEIF [management_level] = &apos;E2&apos; THEN &apos;M4+&apos;&#10;ELSEIF [job_requisition_id] = &quot;JR0013856&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [job_family] = &quot;Product Design / Management&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Analytics&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [job_family] = &quot;Product Operations&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Product&quot; THEN &quot;DH Product&quot;&#10;ELSEIF [department] = &quot;DH Tech&quot; THEN &quot;DH Tech&quot;&#10;ELSEIF [department] = &quot;DH International&quot; THEN &quot;DH International&quot;&#10;ELSEIF [department] = &quot;DH People&quot; THEN &quot;DH People&quot;&#10;ELSEIF [department] = &quot;DH Marketing&quot; THEN &quot;DH Marketing&quot;&#10;ELSEIF [department] = &quot;DH Strategy&quot; THEN &quot;DH Strategy&quot;&#10;ELSEIF [department] = &quot;DH Finance&quot; THEN &quot;DH Finance&quot;&#13;&#10;ELSEIF [department] = &quot;DH Legal&quot; THEN &quot;DH Legal&quot;&#10;ELSE &quot;Other&quot; &#10;END' />
