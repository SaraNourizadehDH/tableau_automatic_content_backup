        <calculation class='tableau' formula='{FIXED [calendar_week],[employee_id],year([date]):&#10;SUM(&#10;IF [remote_work_days]&gt;=1 OR [time_off_days]&gt;3 OR [leave_days]&gt;3 &#10;OR [business_travel_days]&gt;=2 THEN 0 &#10;ELSEIF [time_off_days]&lt;= 2 OR [leave_days]&lt;=2 THEN 1 &#10;ELSE 2 &#10;END&#10;)&#10;}' />
