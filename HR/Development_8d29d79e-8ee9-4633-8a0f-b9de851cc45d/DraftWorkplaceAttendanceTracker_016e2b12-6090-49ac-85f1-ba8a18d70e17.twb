              <zone forceUpdate='true' h='41544' id='881' type-v2='text' w='46219' x='3773' y='23889'>
                <formatted-text>
                  <run bold='true'>2 days a week from 03 Feb 2024</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true'>CRITERIA BELOW - MEET - ABOVE </run>
                  <run><![CDATA[

{FIXED WEEK([date]),YEAR([date]),[employee_id]:
IF SUM([remote_work_days])>0 THEN 'Not Eligible'
ELSEIF SUM([time_off_days])>=3 THEN 'Not Eligible'
ELSEIF SUM([leave_days])>=3 THEN 'Not Eligible'
ELSEIF SUM([business_travel_days])>0 THEN 'Not Eligible'
ELSEIF SUM([time_off_days])<3 AND sum([time_off_days])>=1 THEN 'Half Eligible'
ELSEIF SUM([leave_days])<3 AND SUM([leave_days])>=1 THEN 'Half Eligible'
ELSEIF ([#_international_assignment_days])>=2 THEN 'Not Eligible'
ELSE 'Eligible'
END
}]]></run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
