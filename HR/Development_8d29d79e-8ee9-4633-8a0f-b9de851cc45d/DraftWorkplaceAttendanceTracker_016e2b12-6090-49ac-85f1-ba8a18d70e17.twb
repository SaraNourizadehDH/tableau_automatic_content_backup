          <datasource-dependencies datasource='federated.11etfhc079e88817d6t6m05wdxel'>
            <column caption='final_workplace_attendance' datatype='integer' name='[Calculation_1468032789230694402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[workplace_attendance]+[workplace_attendance_legacy]' />
            </column>
            <column caption='workplace_attendance_week/employee' datatype='integer' name='[Calculation_1468032789230874627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [calendar_week],[employee_id],year([date]):&#10;sum([Calculation_1468032789230694402])}' />
            </column>
            <column caption='workplace_attendance_expectations' datatype='string' name='[Calculation_1468032789232963588]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1468032791011397668]= &apos;Not Eligible&apos; THEN &apos;Not Eligible&apos; &#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;) &#10;AND [Calculation_1468032789230874627] &lt;  1 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;)&#10;AND [Calculation_1468032789230874627] = 1 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&lt;DATE(&apos;2024-02-03&apos;) AND ([Calculation_1468032791011397668]= &apos;Eligible&apos; OR [Calculation_1468032791011397668]= &apos;Half Eligible&apos;)&#10;AND [Calculation_1468032789230874627] &gt; 1 THEN &apos;Above Expectations&apos;&#10;&#10;///////&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] &lt; 2 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] = 2 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Eligible&apos;&#10;AND [Calculation_1468032789230874627] &gt; 2 THEN &apos;Above Expectations&apos;&#10;&#10;/////&#10;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] &lt;1 THEN &apos;Below Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] = 1 THEN &apos;Meet Expectations&apos;&#10;&#10;ELSEIF [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] &gt; 1 THEN &apos;Above Expectations&apos;&#10;&#10;&#10;END' />
            </column>
            <column caption='actuals' datatype='integer' name='[Calculation_1468032789236826120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([employee_id])' />
            </column>
            <column caption='previous_week (complete)' datatype='boolean' name='[Calculation_1468032789263081485]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [date], TODAY()) = 1' />
            </column>
            <column caption='DATETRUNC(&apos;week&apos;, [date])+1' datatype='datetime' name='[Calculation_1468032789286060050]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [date])+1' />
            </column>
            <column caption='Eligibility Criteria' datatype='string' name='[Calculation_1468032791011397668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED WEEK([date]),YEAR([date]),[employee_id]:&#10;IF SUM([remote_work_days])&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days])&gt;=3 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([leave_days])&gt;=3 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([business_travel_days])&gt;0 THEN &apos;Not Eligible&apos;&#10;ELSEIF SUM([time_off_days])&lt;3 AND sum([time_off_days])&gt;=1 THEN &apos;Half Eligible&apos;&#10;ELSEIF SUM([leave_days])&lt;3 AND SUM([leave_days])&gt;=1 THEN &apos;Half Eligible&apos;&#10;ELSEIF ([Calculation_6781435927110176774])&gt;=2 THEN &apos;Not Eligible&apos;&#10;ELSE &apos;Eligible&apos;&#10;END&#10;}' />
            </column>
            <column aggregation='Sum' caption='exclude_current_week' datatype='integer' name='[Calculation_6781435926695510016]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF WEEK([date])=WEEK(TODAY()) THEN 0 ELSE 1 END' />
            </column>
            <column caption='#_international_assignment_days' datatype='integer' name='[Calculation_6781435927110176774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(IF  NOT ISNULL ([remote_tag]) THEN [employee_id] END)' />
            </column>
