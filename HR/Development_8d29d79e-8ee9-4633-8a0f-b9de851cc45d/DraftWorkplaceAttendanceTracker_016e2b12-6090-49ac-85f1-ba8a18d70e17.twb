 [date]&gt;=DATE(&apos;2024-02-03&apos;) AND [Calculation_1468032791011397668]= &apos;Half Eligible&apos;&#10;AND [Calculation_1468032789230874627] &gt; 1 THEN &apos;Above Expectations&apos;&#10;&#10;&#10;END' />
