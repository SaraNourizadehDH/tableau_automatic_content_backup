              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Management Level (Group)&apos; THEN [management_level (group)]&#10;WHEN &apos;Gender&apos; THEN [gender]&#10;WHEN &apos;Department&apos; THEN [department]&#10;WHEN &apos;C - Level&apos; THEN [c_level]&#10;END' />
            </column>
