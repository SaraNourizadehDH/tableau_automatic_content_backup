            <column caption='Talabat Country' datatype='string' name='[talabat_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='CountD' caption='Ticket Number' datatype='string' default-role='measure' default-type='quantitative' name='[ticket_number]' role='dimension' type='nominal' />
            <column-instance column='[creation_date]' derivation='Week' name='[wk:creation_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.16fiqlo1mpsosh10bs34f06ae6ms].[:Measure Names]'>
