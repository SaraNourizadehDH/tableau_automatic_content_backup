            <column caption='% Resolved' datatype='real' default-format='p0%' name='[Calculation_1606659168106950657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1606659168102670336]/COUNTD([ticket_number])' />
            </column>
            <column caption='Solved' datatype='boolean' name='[Calculation_186336495028256773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If &#13;&#10;([sub_status] = &apos;Canceled&apos;&#13;&#10;OR [sub_status]= &apos;Closed&apos;&#13;&#10;OR [sub_status]= &apos;Resolved&apos;&#13;&#10;)&#13;&#10;THEN TRUE &#13;&#10;END' />
