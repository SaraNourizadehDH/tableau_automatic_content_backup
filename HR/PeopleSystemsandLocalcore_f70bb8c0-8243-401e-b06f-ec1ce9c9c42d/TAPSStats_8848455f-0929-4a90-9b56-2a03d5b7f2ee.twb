        <calculation class='tableau' formula='IF [Component/s] = &apos;[WR] Workday Request&apos; THEN &apos;[WS] Workday Support&apos; &#13;&#10;ELSEIF [Component/s] = &apos;[PM] Performance Management&apos; THEN &apos;[GS] General Support&apos; &#13;&#10;ELSEIF [Component/s] = &apos;[TA] Talent Acquisition&apos; THEN &apos;[GS] General Support&apos; &#13;&#10;ELSEIF [Issue key] = &apos;TWS-164&apos; THEN &apos;[WS] Workday Support&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-193&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-194&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-242&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-308&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-392&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-393&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-420&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-461&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-610&apos; THEN &apos;[WS] Workday Support&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-732&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-820&apos; THEN &apos;[WS] Workday Support&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-928&apos; THEN &apos;[TC] Talabat Credits&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1147&apos; THEN &apos;[WS] Workday Support&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1205&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1280&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1296&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1322&apos; THEN &apos;[DR] Document Request&apos;&#13;&#10;ELSEIF [Issue key] = &apos;TWS-1406&apo