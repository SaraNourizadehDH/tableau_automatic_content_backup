            <column-instance column='[component_1]' derivation='None' name='[none:component_1:nk]' pivot='key' type='nominal' />
            <column-instance column='[talabat_country]' derivation='None' name='[none:talabat_country:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' caption='Resolution Date' datatype='date' datatype-customized='true' name='[resolution_date]' role='dimension' type='ordinal' />
            <column caption='Sub Status' datatype='string' name='[sub_status]' role='dimension' type='nominal' />
            <column caption='Talabat Country' datatype='string' name='[talabat_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='CountD' caption='Ticket Number' datatype='string' default-role='measure' default-type='quantitative' name='[ticket_number]' role='dimension' type='nominal' />
