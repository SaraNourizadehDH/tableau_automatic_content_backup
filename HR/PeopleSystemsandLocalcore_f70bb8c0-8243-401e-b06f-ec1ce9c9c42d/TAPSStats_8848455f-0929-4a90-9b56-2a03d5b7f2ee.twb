    <worksheet name='tAPS Weekly Assignees'>
      <repository-location id='tAPSWeeklyAssignees' path='/t/HR/workbooks/TAPSStats' revision='' site='HR' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kaav JIRA for TAPS' name='federated.16fiqlo1mpsosh10bs34f06ae6ms' />
          </datasources>
          <datasource-dependencies datasource='federated.16fiqlo1mpsosh10bs34f06ae6ms'>
            <column caption='Date Range' datatype='string' name='[Calculation_1174876591690379264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DAY(DATETRUNC(&apos;week&apos;,[creation_date])))+&quot;/&quot;+&#13;&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,[creation_date])))+&quot;/&quot;+&#13;&#10;STR(YEAR(DATETRUNC(&apos;week&apos;,[creation_date])))&#13;&#10;+ &quot; - &quot; +&#13;&#10;STR(DAY(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))&#13;&#10;+&quot;/&quot;+&#13;&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))&#13;&#10;+&quot;/&quot;+&#13;&#10;STR(YEAR(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))' />
            </column>
            <column caption='Resolved Tickets' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1606659168102670336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Calculation_186336495028256773])' />
            </column>
            <column caption='% Resolved' datatype='real' default-format='p0%' name='[Calculation_1606659168106950657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1606659168102670336]/COUNTD([ticket_number])' />
            </column>
            <column caption='Solved' datatype='boolean' name='[Calculation_186336495028256773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If &#13;&#10;([sub_status] = &apos;Canceled&apos;&#13;&#10;OR [sub_status]= &apos;Closed&apos;&#13;&#10;OR [sub_status]= &apos;Resolved&apos;&#13;&#10;)&#13;&#10;THEN TRUE &#13;&#10;END' />
            </column>
            <column caption='Resolution Time (Weekdays)' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Resolution Time (Days) (copy)_966585131901906945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_186336495028256773] &#13;&#10;THEN&#13;&#10;&#13;&#10;DATEDIFF(&apos;week&apos;,[creation_date],[resolution_date])*5&#13;&#10;+&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;-&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Assignee Full Name' datatype='string' name='[assignee_full_name]' role='dimension' type='nominal' />
            <column-instance column='[Resolution Time (Days) (copy)_966585131901906945]' derivation='Avg' name='[avg:Resolution Time (Days) (copy)_966585131901906945:qk]' pivot='key' type='quantitative' />
            <column caption='Component 1' datatype='string' name='[component_1]' role='dimension' type='nominal' />
            <column caption='Creation Date' datatype='date' datatype-customized='true' name='[creation_date]' role='dimension' type='ordinal' />
            <column-instance column='[ticket_number]' derivation='CountD' name='[ctd:ticket_number:qk]' pivot='key' type='quantitative' />
