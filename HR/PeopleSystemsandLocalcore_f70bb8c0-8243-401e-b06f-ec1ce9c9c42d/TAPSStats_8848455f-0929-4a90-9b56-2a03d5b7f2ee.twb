          <datasource-dependencies datasource='federated.16fiqlo1mpsosh10bs34f06ae6ms'>
            <column caption='%Reporters per Country' datatype='real' default-format='p0.0%' name='[%Issue per Employee (copy)_1410752650484768768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporters (copy)_186336494998036483]/MAX([Calculation_740842205785137152])' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_1174876591690379264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DAY(DATETRUNC(&apos;week&apos;,[creation_date])))+&quot;/&quot;+&#13;&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,[creation_date])))+&quot;/&quot;+&#13;&#10;STR(YEAR(DATETRUNC(&apos;week&apos;,[creation_date])))&#13;&#10;+ &quot; - &quot; +&#13;&#10;STR(DAY(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))&#13;&#10;+&quot;/&quot;+&#13;&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))&#13;&#10;+&quot;/&quot;+&#13;&#10;STR(YEAR(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[creation_date]))-1))' />
            </column>
            <column caption='#Total Possible Reporters in Country' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_740842205785137152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [office_location_country] = &apos;Bahrain&apos; THEN 205&#13;&#10;ELSEIF [office_location_country] = &apos;Egypt&apos; THEN 2542&#13;&#10;ELSEIF [office_location_country] = &apos;Iraq&apos; THEN 149&#13;&#10;ELSEIF [office_location_country] = &apos;Jordan&apos; THEN 343&#13;&#10;ELSEIF [office_location_country] = &apos;Saudi Arabia&apos; THEN 5&#13;&#10;ELSEIF [office_location_country] = &apos;Kuwait&apos; THEN 627&#13;&#10;ELSEIF [office_location_country] = &apos;Oman&apos; THEN 219&#13;&#10;ELSEIF [office_location_country] = &apos;Qatar&apos; THEN 255&#13;&#10;ELSEIF [office_location_country] = &apos;UAE&apos; THEN 1943&#13;&#10;END' />
            </column>
            <column caption='Unique Reporters' datatype='integer' default-format='n#,##0;-#,##0' name='[Reporters (copy)_186336494998036483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([reporter])' />
            </column>
            <column caption='Component 1' datatype='string' name='[component_1]' role='dimension' type='nominal' />
            <column caption='Creation Date' datatype='date' datatype-customized='true' name='[creation_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_740842205785137152]' derivation='Max' name='[max:Calculation_740842205785137152:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
