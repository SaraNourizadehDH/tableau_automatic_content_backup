            <column caption='Resolution Time (Weekdays)' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Resolution Time (Days) (copy)_966585131901906945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_186336495028256773] &#13;&#10;THEN&#13;&#10;&#13;&#10;DATEDIFF(&apos;week&apos;,[creation_date],[resolution_date])*5&#13;&#10;+&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;-&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
