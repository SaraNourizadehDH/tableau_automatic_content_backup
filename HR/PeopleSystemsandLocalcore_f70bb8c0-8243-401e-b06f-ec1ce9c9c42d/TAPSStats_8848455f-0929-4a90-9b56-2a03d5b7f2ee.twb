      <column datatype='integer' name='[Month of Creation]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='Calculation_1118018629596901377' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [Calculation_1118018629596901377])*100 + DATEPART(&apos;month&apos;, [Calculation_1118018629596901377]))' />
      </column>
      <column caption='Month of Resolution' datatype='integer' name='[Month of Resolution Date]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='Updated' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [Updated])*100 + DATEPART(&apos;month&apos;, [Updated]))' />
      </column>
      <column caption='Unique Reporters' datatype='integer' default-format='n#,##0;-#,##0' name='[Reporters (copy)_186336494998036483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([reporter])' />
      </column>
      <column caption='Resolution Time (Weekdays)' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Resolution Time (Days) (copy)_966585131901906945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_186336495028256773] &#13;&#10;THEN&#13;&#10;&#13;&#10;DATEDIFF(&apos;week&apos;,[creation_date],[resolution_date])*5&#13;&#10;+&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;-&#13;&#10;MIN(DATEPART(&apos;weekday&apos;,[resolution_date],&apos;sunday&apos;),5)&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
