        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] &#13;&#10;&#13;&#10;WHEN &quot;LC&quot; &#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Target Local&quot; THEN [ads_LC] END) })&#13;&#10;&#13;&#10;WHEN &quot;EU&quot;&#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM ( CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Target Local&quot; THEN [ads_LC]/[rate_eu] END) })&#13;&#10;&#13;&#10;END' />
