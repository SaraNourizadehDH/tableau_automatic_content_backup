            <column caption='Run Rate Ads LS' datatype='real' name='[Run Rate (copia 3)_357754705471926278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &quot;LC&quot; THEN&#13;&#10;{ FIXED [date_month],[country_id]:&#13;&#10;&#13;&#10;SUM(CASE  [data_level] WHEN &quot;Run Rate&quot; THEN [ads_local_stores_lc] END)}&#13;&#10;&#13;&#10;WHEN &quot;EU&quot; THEN&#13;&#10;&#13;&#10;{ FIXED [date_month],[country_id]:&#13;&#10;&#13;&#10;SUM(CASE  [data_level] WHEN &quot;Run Rate&quot; THEN [ads_local_stores_lc]/[rate_eu]&#13;&#10;&#13;&#10;END)}&#13;&#10;&#13;&#10;END' />
