          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='FX' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EU&quot;'>
              <calculation class='tableau' formula='&quot;EU&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui'>
            <column caption='revenue_selfbooking' datatype='real' name='[Calculation_1199927862759280640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_booking_source] WHEN &quot;self_booking&quot; THEN [Calculation_302867109077139461] ELSE 0 END' />
            </column>
            <column caption='date_dynamic' datatype='string' name='[Calculation_302867109076201472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_302867109076283393]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [Calculation_302867109076336642]&#13;&#10;    WHEN &apos;Semester&apos; THEN [Calculation_302867109076377603]&#13;&#10;    WHEN &apos;Year&apos; THEN [Calculation_302867109076422660]&#13;&#10;END' />
            </column>
            <column caption='date_month_string' datatype='string' name='[Calculation_302867109076283393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='date_quarter' datatype='string' name='[Calculation_302867109076336642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[date_month]))+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='date_semester' datatype='string' name='[Calculation_302867109076377603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[date_month]) &lt; 3 THEN &apos;H1&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) ELSE &apos;H2&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) END' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='revenue_data' datatype='real' name='[Calculation_302867109077139461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;LC&apos;    THEN [revenue_LC]&#13;&#10;    WHEN &apos;EU&apos;  THEN [revenue_LC]/[rate_eu]&#13;&#10;END' />
            </column>
            <column caption='Revenue SB ' datatype='real' name='[Calculation_711287286784249864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [ad_booking_source]= &quot;self_booking&quot; THEN [revenue_EU] END' />
