    <worksheet name='8 Evolution ROAS by QP'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.082ijf909mrlsk19o3lrm15fzhui' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EU&quot;'>
              <calculation class='tableau' formula='&quot;EU&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui'>
            <column caption='date_month_string' datatype='string' name='[Calculation_302867109076283393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='revenue_data' datatype='real' name='[Calculation_302867109077139461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;LC&apos;    THEN [revenue_LC]&#13;&#10;    WHEN &apos;EU&apos;  THEN [revenue_LC]/[rate_eu]&#13;&#10;END' />
            </column>
            <column caption='rpp' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_302867109080797198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_302867109077139461])/(COUNTD([NCR_Partner (copia)_108086427332292610]))' />
            </column>
            <column caption='last' datatype='integer' name='[Calculation_302867109192192024]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPC' datatype='real' name='[Calculation_3511963331746603008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_302867109077139461])/SUM([clicks_billed])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_3511963331747233793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/SUM([clicks_billed])' />
            </column>
            <column caption='gmv_gv_lc' datatype='real' name='[Calculation_512847445259935744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_product] WHEN &apos;GoldVIP CPC&apos;&#13;&#10;THEN [GMV_LC] else 0 END' />
            </column>
            <column caption='ROAS GV' datatype='real' name='[Calculation_512847445260677122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_512847445259935744])&gt;0 THEN SUM([Calculation_512847445259935744]) / SUM([gmv_gv_lc (copia)_512847445260439553])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[Channel]' role='dimension' type='nominal' />
            <column datatype='real' name='[GMV_LC]' role='measure' type='quantitative' />
            <column datatype='string' name='[Is_Concept_or_Kitchen_or_Darkstore]' role='dimension' type='nominal' />
            <column caption='KA Sub Category' datatype='string' name='[Key_Account_Sub_Category]' role='dimension' type='nominal'>
