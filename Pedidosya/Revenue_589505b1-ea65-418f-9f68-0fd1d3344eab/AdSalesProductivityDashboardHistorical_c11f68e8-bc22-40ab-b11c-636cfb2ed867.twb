    <worksheet lock-quick-filters='true' name='5 Partner by Executive'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.082ijf909mrlsk19o3lrm15fzhui' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EU&quot;'>
              <calculation class='tableau' formula='&quot;EU&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui'>
            <column caption='Business Type Name Detail' datatype='string' name='[Business Type Name (copia)_549157725766840330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[business_type_name]' />
            </column>
            <column caption='joker_consumed' datatype='integer' name='[Calculation_1227230935098896386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_product]WHEN &quot;Joker&quot; THEN [confirmed_orders] ELSE 0 END' />
            </column>
            <column caption='budget_consumption_gv' datatype='real' default-format='p0.00%' name='[Calculation_1347983700861181952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;&gt;0&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;ROUND (&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_billed]) ELSE 0 END)&#13;&#10;,0) &#13;&#10;/&#13;&#10;ROUND(&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;,0)&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Increase Bdgt Gold VIP' datatype='string' name='[Calculation_1347983700870004737]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1347983700861181952]&gt;=0.85 AND [Calculation_512847445260677122]&gt;=3 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='revenue_data' datatype='real' name='[Calculation_302867109077139461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;LC&apos;    THEN [revenue_LC]&#13;&#10;    WHEN &apos;EU&apos;  THEN [revenue_LC]/[rate_eu]&#13;&#10;END' />
            </column>
            <column caption='new_revenue' datatype='real' name='[Calculation_302867109077565448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [NCR_new_partner] = &quot;YES&quot; THEN [Calculation_302867109077139461] ELSE 0 END' />
            </column>
            <column caption='rpp' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_302867109080797198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_302867109077139461])/(COUNTD([NCR_Partner (copia)_108086427332292610]))' />
            </column>
            <column caption='ads_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_302867109179756564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_LC]/[rate_eu])/SUM([GMV_LC]/[rate_eu])' />
            </column>
            <column caption='gmv_gv_lc' datatype='real' name='[Calculation_512847445259935744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_product] WHEN &apos;GoldVIP CPC&apos;&#13;&#10;THEN [GMV_LC] else 0 END' />
            </column>
            <column caption='ROAS GV' datatype='real' name='[Calculation_512847445260677122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_512847445259935744])&gt;0 THEN SUM([Calculation_512847445259935744]) / SUM([gmv_gv_lc (copia)_512847445260439553])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[Channel]' role='dimension' type='nominal' />
            <column datatype='real' name='[GMV_LC]' role='measure' type='quantitative' />
            <column datatype='string' name='[Is_Concept_or_Kitchen_or_Darkstore]' role='dimension' type='nominal' />
            <column caption='KA Sub Category Detail' datatype='string' name='[KA Sub Category (copia)_549157725767675921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Key_Account_Sub_Category]' />
            </column>
            <column caption='KA Sub Category' datatype='string' name='[Key_Account_Sub_Category]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Long Tail A&quot;' value='LT A' />
                <alias key='&quot;Long Tail B&quot;' value='LT B' />
                <alias key='&quot;Long Tail C&quot;' value='LT C' />
                <alias key='&quot;Long Tail D&quot;' value='LT D' />
                <alias key='&quot;Long Tail No Segment&quot;' value='LT No Segment' />
              </aliases>
            </column>
            <column caption='NCR Owner Name Detail' datatype='string' name='[NCR Owner Name (copia)_549157725766008839]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ncr_owner_name]' />
            </column>
            <column caption='NCR_Partner_revenue' datatype='integer' name='[NCR_Partner (copia)_108086427332292610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;([revenue_LC])&gt;0 &#13;&#10;THEN [partner_id] END' />
            </column>
            <column datatype='string' name='[NCR_new_partner]' role='dimension' type='nominal' />
            <column datatype='string' name='[active_partner]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_booking_source]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_product]' role='dimension' type='nominal' />
            <column caption='AM Owner Id' datatype='string' name='[am_owner_id]' role='dimension' type='nominal' />
            <column caption='AM Owner Name' datatype='string' name='[am_owner_name]' role='dimension' type='nominal' />
            <column caption='Business Type Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[clicks_billed]' role='measure' type='quantitative' />
            <column datatype='real' name='[clicks_budget_excl_canceled]' role='measure' type='quantitative' />
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Franchise Name' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column caption='revenue_gv_lc' datatype='real' name='[gmv_gv_lc (copia)_512847445260439553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_product] WHEN &apos;GoldVIP CPC&apos;&#13;&#10;THEN [revenue_LC] else 0 END' />
            </column>
            <column caption='Grid' datatype='string' name='[grid]' role='dimension' type='nominal' />
            <column datatype='integer' name='[joker_sold]' role='measure' type='quantitative' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
