            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[rate_eu]' role='measure' type='quantitative' />
            <column-instance column='[Delta Target Local (copia)_653021949638467604]' derivation='Sum' name='[sum:Delta Target Local (copia)_653021949638467604:qk]' pivot='key' type='quantitative' />
            <column-instance column='[target_local (copia)_653021949608849410]' derivation='Sum' name='[sum:target_local (copia)_653021949608849410:qk]' pivot='key' type='quantitative' />
            <column caption='Actual' datatype='real' name='[target_local (copia)_653021949608849410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] &#13;&#10;&#13;&#10;WHEN &quot;LC&quot; &#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [ads_LC]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [ads_LC] END)}) &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &quot;EU&quot;&#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [ads_LC]/[rate_eu]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [ads_LC]/[rate_eu] END)}) &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
