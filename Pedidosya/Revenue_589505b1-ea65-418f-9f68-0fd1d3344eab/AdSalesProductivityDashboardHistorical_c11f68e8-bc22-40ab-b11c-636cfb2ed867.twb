      </column>
      <column caption='joker_consumed' datatype='integer' name='[Calculation_1227230935098896386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [ad_product]WHEN &quot;Joker&quot; THEN [confirmed_orders] ELSE 0 END' />
      </column>
      <column caption='partner_selfbooking_share_complemento' datatype='real' name='[Calculation_1230890095978950657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[partner_selfbooking (copia)_1186417080843665409]' />
      </column>
      <column caption='NCR_churn_partner_BOTH_bdgt' datatype='string' name='[Calculation_1307451310971858962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NCR_churn_partner_cpc_bdgt]=&quot;YES&quot; AND [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; THEN &quot;YES&quot; END' />
      </column>
      <column caption='budget_consumption_gv' datatype='real' default-format='p0.00%' name='[Calculation_1347983700861181952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;&gt;0&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;ROUND (&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_billed]) ELSE 0 END)&#13;&#10;,0) &#13;&#10;/&#13;&#10;ROUND(&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;,0)&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='Increase Bdgt Gold VIP' datatype='string' name='[Calculation_1347983700870004737]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1347983700861181952]&gt;=0.85 AND [Calculation_512847445260677122]&gt;=3 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
      </column>
      <column caption='CVR Ads' datatype='real' name='[Calculation_1465077302561054723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([clicks_tot])&gt;0 THEN&#13;&#10;&#13;&#10;SUM([confirmed_orders])/SUM([clicks_tot])&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='target_ex_vp' datatype='real' name='[Calculation_1481684341306429440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[objetivo_ejecutivo_vp]*[target_fixed_cant_part_2 (copia)_635289059761377283]' />
      </column>
      <column aggregation='Sum' caption='date_max_bool' datatype='integer' name='[Calculation_1628895723302662144]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  [Calculation_699465332897497089] = [date_month] THEN 1 ELSE 0 END' />
      </column>
      <column caption='date_plus_1' datatype='date' name='[Calculation_202943506954915844]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;,1,[date_month]))' />
      </column>
      <column caption='Churn Type' datatype='string' name='[Calculation_202943506964328454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NCR_churn_partner_cpc_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;&#13;&#10;THEN &quot;CPC/CPP &amp; Joker Churn&quot;&#13;&#10;&#13;&#10;ELSEIF [NCR_churn_partner_cpc_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;&#13;&#10;THEN &quot;CPC/CPP Churn&quot;&#13;&#10;&#13;&#10;ELSEIF [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_cpc_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt]=&quot;YES&quot;&#13;&#10;THEN &quot;Joker Churn&quot;&#13;&#10;&#13;&#10;ELSE &quot;No Churn&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='target_fixed_cant_part' datatype='real' default-format='n#,##0.00000;-#,##0.00000' name='[Calculation_253890463923810315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_month],[ncr_owner_name],[ad_booking_source],[ad_product]: 1/COUNTD([ncr_owner_name])}' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_253890463927619598]' role='measure' type='quantitative'>
