      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports) (2)' name='federated.082ijf909mrlsk19o3lrm15fzhui (copia)' />
            <datasource caption='Parámetros' name='Parameters' />
