    <worksheet name='Resumen gral'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.082ijf909mrlsk19o3lrm15fzhui' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='FX' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EU&quot;'>
              <calculation class='tableau' formula='&quot;EU&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui'>
            <column caption='revenue_selfbooking' datatype='real' name='[Calculation_1199927862759280640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_booking_source] WHEN &quot;self_booking&quot; THEN [Calculation_302867109077139461] ELSE 0 END' />
            </column>
            <column caption='date_dynamic' datatype='string' name='[Calculation_302867109076201472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_302867109076283393]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [Calculation_302867109076336642]&#13;&#10;    WHEN &apos;Semester&apos; THEN [Calculation_302867109076377603]&#13;&#10;    WHEN &apos;Year&apos; THEN [Calculation_302867109076422660]&#13;&#10;END' />
            </column>
            <column caption='date_month_string' datatype='string' name='[Calculation_302867109076283393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='date_quarter' datatype='string' name='[Calculation_302867109076336642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[date_month]))+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='date_semester' datatype='string' name='[Calculation_302867109076377603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[date_month]) &lt; 3 THEN &apos;H1&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) ELSE &apos;H2&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) END' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='revenue_data' datatype='real' name='[Calculation_302867109077139461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;LC&apos;    THEN [revenue_LC]&#13;&#10;    WHEN &apos;EU&apos;  THEN [revenue_LC]/[rate_eu]&#13;&#10;END' />
            </column>
            <column caption='KA Sub Category' datatype='string' name='[Key_Account_Sub_Category]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Long Tail A&quot;' value='LT A' />
                <alias key='&quot;Long Tail B&quot;' value='LT B' />
                <alias key='&quot;Long Tail C&quot;' value='LT C' />
                <alias key='&quot;Long Tail D&quot;' value='LT D' />
                <alias key='&quot;Long Tail No Segment&quot;' value='LT No Segment' />
              </aliases>
            </column>
            <column caption='Quality Partner Share % SB' datatype='real' name='[Quality Partner Share % (copia)_711287286795145228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [quality_partner] = &apos;YES&apos; AND [ad_booking_source] = &quot;self_booking&quot; THEN  [partner_id] END)/COUNTD(IF [ad_booking_source] = &quot;self_booking&quot; THEN [partner_id] END)' />
            </column>
            <column datatype='string' name='[active_partner]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_booking_source]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_product]' role='dimension' type='nominal' />
            <column datatype='real' name='[budget_revenue_incl_canceled_LC]' role='measure' type='quantitative' />
            <column caption='Business Type Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[confirmed_orders_tot]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[revenue_selfbooking (copia)_1186417080843501568]' derivation='CountD' name='[ctd:revenue_selfbooking (copia)_1186417080843501568:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[joker_sold]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_302867109076201472]' derivation='None' name='[none:Calculation_302867109076201472:nk]' pivot='key' type='nominal' />
            <column-instance column='[Key_Account_Sub_Category]' derivation='None' name='[none:Key_Account_Sub_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[active_partner]' derivation='None' name='[none:active_partner:nk]' pivot='key' type='nominal' />
            <column-instance column='[ad_product]' derivation='None' name='[none:ad_product:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type_name]' derivation='None' name='[none:business_type_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[quality_partner]' derivation='None' name='[none:quality_partner:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' caption='Partner Id' datatype='integer' name='[partner_id]' role='dimension' type='ordinal' />
            <column caption='partner_selfbooking_share' datatype='real' default-format='p0.00%' name='[partner_selfbooking (copia)_1186417080843665409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([revenue_selfbooking (copia)_1186417080843501568]))&#13;&#10;/&#13;&#10;(COUNTD( IF ([budget_revenue_incl_canceled_LC] + [joker_sold]) &gt;0 &#13;&#10;and [confirmed_orders_tot]&gt;0  THEN [partner_id]END))' />
            </column>
            <column caption='Quality Partner' datatype='string' name='[quality_partner]' role='dimension' type='nominal' />
            <column datatype='real' name='[rate_eu]' role='measure' type='quantitative' />
            <column datatype='real' name='[revenue_LC]' role='measure' type='quantitative' />
            <column caption='partner_selfbooking' datatype='integer' name='[revenue_selfbooking (copia)_1186417080843501568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [ad_booking_source] = &quot;self_booking&quot; &#13;&#10;and [confirmed_orders_tot]&gt;0 AND ([budget_revenue_incl_canceled_LC] + [joker_sold])&gt;0 &#13;&#10;THEN [partner_id]  END' />
            </column>
            <column caption='revenue_selfbooking_share' datatype='real' default-format='p0.00%' name='[revenue_selfbooking (copia)_1199927862771535873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1199927862759280640])/SUM([Calculation_302867109077139461])' />
