            <column caption='Delta Run Rate Target BE 2 Ads LS Colour' datatype='integer' default-format='*0,0 ▲;-0,0 ▼' name='[Delta Run Rate Target BE 2 Ads LS (copia)_357754705474457616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([Run Rate (copia 3)_357754705471926278])-SUM([Target BE (copia) (copia)_357754705473474573]))&gt;0 THEN 1 ELSE 0 END' />
