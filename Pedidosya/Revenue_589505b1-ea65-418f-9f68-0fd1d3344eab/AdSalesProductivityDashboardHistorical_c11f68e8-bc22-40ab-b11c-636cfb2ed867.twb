          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui (copia)'>
            <column caption='Actual Ads/GMV' datatype='real' default-format='p0.00%' name='[Actual (copia)_1391330831995236354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] &#13;&#10;&#13;&#10;WHEN &quot;LC&quot; &#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [ads_LC]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [ads_LC] END)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM( { FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [gmv_total_cia_lc]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [gmv_total_cia_lc] END)} &#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;WHEN &quot;EU&quot;&#13;&#10;&#13;&#10;THEN SUM({ FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [ads_LC]/[rate_eu]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [ads_LC]/[rate_eu] END)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM( { FIXED [date_month],[country_id]: &#13;&#10;&#13;&#10;SUM(CASE  [data_level] &#13;&#10;&#13;&#10;WHEN &quot;Actual&quot; THEN [gmv_total_cia_lc]/[rate_eu]&#13;&#10;&#13;&#10;WHEN &quot;Actual Month&quot; THEN [gmv_total_cia_lc]/[rate_eu] END)} &#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Delta Ads/GMV Actual vs BE' datatype='real' default-format='*0.00% ▲;-0.00% ▼' name='[Calculation_1391330832017154054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actual (copia)_1391330831995236354]-[Target BE (copia)_1391330831994130433]' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='Delta Ads/GMV Actual vs BE colour' datatype='integer' default-format='*0.00% ▲;-0.00% ▼' name='[Delta Ads/GMV Actual vs BE (copia)_770115558420668416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Actual (copia)_1391330831995236354]-[Target BE (copia)_1391330831994130433])&gt;0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Delta Target BE 2' datatype='real' default-format='*0,0 ▲;-0,0 ▼' name='[Delta Target Local (copia)_653021949638467604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[target_local (copia)_653021949608849410]-[ads_LC (copia)_653021949631983630]' />
            </column>
            <column caption='Target BE Ads/GMV' datatype='real' default-format='p0.00%' name='[Target BE (copia)_1391330831994130433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] WHEN &quot;LC&quot; THEN&#13;&#10;&#13;&#10;SUM([ads_LC])/SUM([gmv_total_cia_lc])&#13;&#10;&#13;&#10;WHEN &quot;EU&quot; THEN&#13;&#10;&#13;&#10;SUM([ads_LC]/[rate_eu])/SUM([gmv_total_cia_lc]/[rate_eu])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Target BE' datatype='real' name='[ads_LC (copia)_653021949631983630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] WHEN &quot;LC&quot; THEN&#13;&#10;&#13;&#10;SUM([ads_LC] )&#13;&#10;&#13;&#10;WHEN &quot;EU&quot; THEN&#13;&#10;&#13;&#10;SUM([ads_LC]/[rate_eu])&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[ads_LC]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[country_id]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
