            <column caption='FC Display EUR' datatype='real' name='[Calculation_910008616161579012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_display_eu])' />
            </column>
            <column caption='FC Branded EUR' datatype='real' name='[Calculation_910008616161652741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_branded_eu])' />
            </column>
            <column caption='FC ADS FOOD EUR' datatype='real' name='[Calculation_910008616161796103]' role='measure' type='quantitative'>
