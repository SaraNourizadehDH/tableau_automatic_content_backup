            <column caption='FC GoldVIP EU' datatype='real' name='[Calculation_910008616161349633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_goldvip_eu])-SUM([ads_credits_goldvip_eu])' />
            </column>
            <column caption='FC Keywords EUR' datatype='real' name='[Calculation_910008616161419266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_keywords_eu])-SUM([ads_credits_keywords_eu])' />
