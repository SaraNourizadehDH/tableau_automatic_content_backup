            <column caption='comp_rank_suf_gmv_fxn' datatype='integer' name='[comp_rank_suf_gmv (copia)_1040613024875638795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM([suf_as_gmv_fxn (copia)_1718686243626549250])&#13;&#10;/ &#13;&#10;SUM([suf_as_gmv_fxn (copia) (copia)_1718686243626557443])&#13;&#10;/&#13;&#10;(SUM(([Set_Up_Fee]+ [POS_Package])/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &lt; - 0.1 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([suf_as_gmv_fxn (copia)_1718686243626549250])&#13;&#10;/ &#13;&#10;SUM([suf_as_gmv_fxn (copia) (copia)_1718686243626557443])&#13;&#10;/&#13;&#10;(SUM(([Set_Up_Fee]+ [POS_Package])/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &gt;= - 0.1&#13;&#10;AND (&#13;&#10;SUM([suf_as_gmv_fxn (copia)_1718686243626549250])&#13;&#10;/ &#13;&#10;SUM([suf_as_gmv_fxn (copia) (copia)_1718686243626557443])&#13;&#10;/&#13;&#10;(SUM(([Set_Up_Fee]+ [POS_Package])/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([suf_as_gmv_fxn (copia)_1718686243626549250])&#13;&#10;/ &#13;&#10;SUM([suf_as_gmv_fxn (copia) (copia)_1718686243626557443])&#13;&#10;/&#13;&#10;(SUM(([Set_Up_Fee]+ [POS_Package])/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &gt;= 0&#13;&#10; THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_suf_as_gmv_fxn' datatype='real' default-format='p0.00%' name='[compliance_suf_as_gmv_fxc (copia)_1040613024875147274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([suf_as_gmv_fxn (copia)_1718686243626549250])&#13;&#10;/ &#13;&#10;SUM([suf_as_gmv_fxn (copia) (copia)_1718686243626557443])&#13;&#10;-&#13;&#10;(SUM(([Set_Up_Fee]+ [POS_Package])/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)' />
            </column>
