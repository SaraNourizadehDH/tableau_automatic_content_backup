            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column datatype='real' name='[Commission_Revenue_Local_Stores]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='DATE_DIFF_MONTH_6M' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_MONTH (copia)_481885210712248320]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
            </column>
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[Pos_Rental]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='commrev_food_monthly_target' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_monthly_target (copia)_85005504464060417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([Calculation_540431994116587523])=1 &#13;&#10;THEN ([Commission_Revenue_Food]) &#13;&#10;ELSE 0 END)/1000000' />
            </column>
