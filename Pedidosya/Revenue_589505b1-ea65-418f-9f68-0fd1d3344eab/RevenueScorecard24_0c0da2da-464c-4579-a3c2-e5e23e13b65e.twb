    <worksheet name='Comp Y Ads FXC BC'>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue_lucanet (automated_tables_reports)' name='federated.1sug86j0swfs9e173830f0ln9et7' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_year' datatype='date' datatype-customized='true' default-format='*yyyy' name='[date_quarter (copia)_908319788429504519]' param-domain-type='list' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column datatype='real' name='[Ads_Local_Stores]' role='measure' type='quantitative' />
            <column caption='COUNTRY w/o SSC' datatype='string' name='[COUNTRY (copia)_1425952268347281410]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='ads_amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_409827598311694336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))/1000000' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' name='[Featured_Products]' role='measure' type='quantitative' />
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column caption='comp_rank_ads_fxc' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_cr_food (copia) (copia)_224617065014882334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])&#13;&#10;)-1 &lt; - 0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])&#13;&#10;)-1 &gt;= - 0.5&#13;&#10;AND (&#13;&#10;SUM({ FIXED [COUNTRY],[COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])&#13;&#10;)-1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])&#13;&#10;)-1 &gt;=  0 THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_ads_fxc' datatype='real' default-format='p0%' name='[compliance_cr_ls (copia)_224617064979447813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])&#13;&#10;)-1' />
