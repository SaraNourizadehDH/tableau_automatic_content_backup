            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[Pos_Rental]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='ads_amount_actual_fxc_in_mio' datatype='real' default-format='n#,##0;-#,##0' name='[ads_amount_actual_fxc (copia)_957577915335786510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} ELSE NULL END)/1000000' />
            </column>
            <column caption='bdgt_ads_monthly_target' datatype='real' name='[ads_monthly_target (copia)_1375005308223655955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 &#13;&#10;THEN ([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores]) &#13;&#10;ELSE 0 END)/1000000' />
            </column>
            <column caption='compliance_bdgt_acum_ads_fxc' datatype='real' default-format='p0%' name='[compliance_acum_ads_fxc (copia)_1375005308247216149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([ads_monthly_target (copia)_1375005308223655955])&#13;&#10;)-1' />
            </column>
            <column caption='date_current_last_month' datatype='boolean' name='[date_acumulado (copia)_957577915274211337]' role='measure' type='nominal'>
              <calculation class='tableau' formula='([Calculation_836262193946132484])=max([Calculation_957577915262074880])-max([Calculation_957577915262074880])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='bdgt_monthly_target_bin' datatype='integer' name='[monthly_target_bin (copia)_1375005308218925057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([DATA_LEVEL]=(&apos;Smart&apos;) OR [DATA_LEVEL]=(&apos;Budget 2023&apos;) OR [DATA_LEVEL]=(&apos;Budget Round 2024&apos;) ) = TRUE &#13;&#10;THEN 1 ELSE 0 END' />
            </column>
