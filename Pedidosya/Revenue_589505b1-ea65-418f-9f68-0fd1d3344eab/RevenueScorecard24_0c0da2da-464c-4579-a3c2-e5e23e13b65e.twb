            <column-instance column='[COUNTRY (copia)_1425952268347281410]' derivation='None' name='[none:COUNTRY (copia)_1425952268347281410:nk]' pivot='key' type='nominal' />
            <column-instance column='[COUNTRY w/o SSC (copia)_178455198619865088]' derivation='None' name='[none:COUNTRY w/o SSC (copia)_178455198619865088:nk]' pivot='key' type='nominal' />
