              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000 ) }' />
