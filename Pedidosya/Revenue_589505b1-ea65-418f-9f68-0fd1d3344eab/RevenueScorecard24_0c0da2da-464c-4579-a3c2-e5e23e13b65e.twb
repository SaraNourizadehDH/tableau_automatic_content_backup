      <column caption='listing_priority_monthly_target' datatype='real' name='[Calculation_540431994117574660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  ([Calculation_540431994116587523])=1 THEN ([Listing_Priority]) ELSE 0 END' />
      </column>
      <column caption='actual_afv_food' datatype='real' name='[Calculation_564075890613317649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)' />
      </column>
      <column caption='date_quarter_v2' datatype='string' datatype-customized='true' name='[Calculation_836262193943126018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[DATE])) + STR(&apos; &apos;) +  STR(DATEPART(&apos;year&apos;,[DATE]))' />
      </column>
      <column caption='last' datatype='integer' name='[Calculation_836262193946132484]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='date_month_prm' datatype='boolean' name='[Calculation_836262194027679753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[DATE]=[Parameters].[Parámetro 1]' />
      </column>
      <column caption='comm_rate_food_fxc' datatype='real' default-format='p0.00%' name='[Calculation_847239712005406720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Commission_Revenue_Food])/SUM([GFV_Food])' />
      </column>
      <column caption='current_last_month' datatype='integer' name='[Calculation_957577915262074880]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MONTH(DATEADD(&apos;month&apos;,-1,NOW()))' />
      </column>
      <column caption='date_acumulado' datatype='boolean' name='[Calculation_957577915262550017]' role='measure' type='nominal'>
        <calculation class='tableau' formula='([Calculation_1600185283983564815])*(-1)&lt;max([Calculation_957577915262074880])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='sem_year' datatype='integer' name='[Calculation_973621983243264000]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([DATE])' />
      </column>
      <column caption='semester' datatype='string' name='[Calculation_973621983245164546]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [year_s (copia)_973621983244451841]&lt;=6 THEN &quot;Sem - 1&quot; ELSE &quot;Sem - 2&quot; END' />
      </column>
      <column caption='sem_date1' datatype='date' name='[Calculation_973621983245455363]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([DATE])' />
      </column>
      <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
