              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='ads_amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_409827598311694336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))/1000000' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' name='[Featured_Products]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_including_Incentives__user_paid_amount_]' role='measure' type='quantitative' />
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column caption='comp_rank_ads_gmv_fxc' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_cr_food (copia) (copia) (copia)_224617065014890527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;((SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))&#13;&#10;/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &lt; -0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))&#13;&#10;/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &gt;= - 0.05&#13;&#10;AND (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;((SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))&#13;&#10;/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;((SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))&#13;&#10;/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &gt;=  0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_ads_as_gmv_fxc' datatype='real' default-format='p0.00%' name='[compliance_ads (copia)_224617064983465993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores])ELSE 0 END )} )&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;-&#13;&#10;&#13;&#10;(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))/SUM([GMV_including_Incentives__user_paid_amount_])&#13;&#10;)' />
            </column>
            <column caption='date_quarter_prm' datatype='boolean' name='[date_quarter_prm (copia)_908319788395044868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;,[DATE]))=&#13;&#10;[Parameters].[date_quarter (copia)_908319788394979331]' />
            </column>
            <column-instance column='[COUNTRY (copia)_1425952268347281410]' derivation='None' name='[none:COUNTRY (copia)_1425952268347281410:nk]' pivot='key' type='nominal' />
