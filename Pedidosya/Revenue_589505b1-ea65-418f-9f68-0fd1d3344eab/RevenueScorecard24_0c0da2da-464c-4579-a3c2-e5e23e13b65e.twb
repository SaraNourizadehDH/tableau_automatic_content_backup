            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_quarter' datatype='date' datatype-customized='true' default-format='*&quot;T&quot;q yy' name='[date_quarter (copia)_908319788394979331]' param-domain-type='list' role='measure' type='quantitative' value='#2022-10-01#'>
              <calculation class='tableau' formula='#2022-10-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
