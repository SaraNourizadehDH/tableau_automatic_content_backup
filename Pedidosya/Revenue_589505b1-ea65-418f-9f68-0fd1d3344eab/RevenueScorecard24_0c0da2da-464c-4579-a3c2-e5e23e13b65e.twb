              <calculation class='tableau' formula='(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 &#13;&#10;THEN ([Commission_Revenue_Food]) &#13;&#10;ELSE 0 END)/1000000' />
            </column>
            <column caption='compliance_bdgt_acum_commrev_food_fxc' datatype='real' default-format='p0%' name='[compliance_bdgt_acum_ads_fxc (copia)_1200772311146868740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1' />
            </column>
