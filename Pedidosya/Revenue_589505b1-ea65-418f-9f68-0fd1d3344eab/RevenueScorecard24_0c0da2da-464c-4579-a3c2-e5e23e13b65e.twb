              <calculation class='tableau' formula='IF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Set_Up_Fee]+ [POS_Package])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Set_Up_Fee]+ [POS_Package])/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &lt; - 0.1 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Set_Up_Fee]+ [POS_Package])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Set_Up_Fee]+ [POS_Package])/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &gt;= - 0.1&#13;&#10;AND (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Set_Up_Fee]+ [POS_Package])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Set_Up_Fee]+ [POS_Package])/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([Set_Up_Fee]+ [POS_Package])ELSE 0 END )} )&#13;&#10;/ &#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END ) } )&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Set_Up_Fee]+ [POS_Package])/SUM([GMV_including_Incentives__user_paid_amount_]))&#13;&#10;) -1 &gt;= 0&#13;&#10;THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
