              <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee]+[POS_Package] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee]+[POS_Package] ELSE 0 END)} ELSE NULL END)&#13;&#10;/&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)} ELSE NULL END)&#13;&#10;&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;([suf_as_gmv_monthly_target_suf (copia)_1375005308221980688])/([suf_as_gmv_monthly_target_gmv (copia)_1375005308221968399])&#13;&#10;)' />
