              <calculation class='tableau' formula='IF (&#13;&#10;SUM([pos_amount (copia)_601230585953669156])*1000&#13;&#10;/&#13;&#10;SUM([Pos_Rental]/[TC])&#13;&#10;)-1 &lt; - 0.1 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([pos_amount (copia)_601230585953669156])*1000&#13;&#10;/&#13;&#10;SUM([Pos_Rental]/[TC])&#13;&#10;)-1 &gt;= - 0.1 &#13;&#10;AND (&#13;&#10;SUM([pos_amount (copia)_601230585953669156])*1000&#13;&#10;/&#13;&#10;SUM([Pos_Rental]/[TC])&#13;&#10;)-1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([pos_amount (copia)_601230585953669156])*1000&#13;&#10;/&#13;&#10;SUM([Pos_Rental]/[TC])&#13;&#10;)-1 &gt;= 0&#13;&#10; THEN 2&#13;&#10;&#13;&#10;END' />
