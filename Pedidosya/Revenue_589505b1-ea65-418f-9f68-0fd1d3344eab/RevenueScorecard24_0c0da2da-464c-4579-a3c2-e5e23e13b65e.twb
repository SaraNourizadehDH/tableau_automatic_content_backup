            <column datatype='real' name='[TC]' role='measure' type='quantitative' />
            <column caption='ads_amount_fxn' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_amount (copia)_601230585916039198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }' />
            </column>
            <column caption='comp_rank_ads_fxn' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_ads (copia)_1040613024855007235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM([ads_amount (copia)_601230585916039198])*1000000&#13;&#10;/&#13;&#10;SUM([Listing_Priority]/[TC]+[Joker]/[TC]+[Featured_Products]/[TC]+[Ads_Local_Stores]/[TC])&#13;&#10;)-1 &lt; - 0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([ads_amount (copia)_601230585916039198])*1000000&#13;&#10;/&#13;&#10;SUM([Listing_Priority]/[TC]+[Joker]/[TC]+[Featured_Products]/[TC]+[Ads_Local_Stores]/[TC])&#13;&#10;)-1 &gt;= - 0.05 &#13;&#10;AND (&#13;&#10;SUM([ads_amount (copia)_601230585916039198])*1000000&#13;&#10;/&#13;&#10;SUM([Listing_Priority]/[TC]+[Joker]/[TC]+[Featured_Products]/[TC]+[Ads_Local_Stores]/[TC])&#13;&#10;)-1 &lt;  0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([ads_amount (copia)_601230585916039198])*1000000&#13;&#10;/&#13;&#10;SUM([Listing_Priority]/[TC]+[Joker]/[TC]+[Featured_Products]/[TC]+[Ads_Local_Stores]/[TC])&#13;&#10;)-1 &gt;= 0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_ads_fxn' datatype='real' default-format='p0%' name='[compliance_ads_fxc (copia)_1040613024853315584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([ads_amount (copia)_601230585916039198])*1000000&#13;&#10;/&#13;&#10;SUM([Listing_Priority]/[TC]+[Joker]/[TC]+[Featured_Products]/[TC]+[Ads_Local_Stores]/[TC])&#13;&#10;)-1' />
            </column>
