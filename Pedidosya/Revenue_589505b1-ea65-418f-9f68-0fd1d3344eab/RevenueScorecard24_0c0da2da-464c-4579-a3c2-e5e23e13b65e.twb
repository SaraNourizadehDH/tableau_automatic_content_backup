            <column datatype='real' name='[Orders_Food]' role='measure' type='quantitative' />
            <column caption='comp_rank_afv_food_fxc' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_commrev_food_fxc (copia 2)_564075890606596104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//BLOQUE 1:&#13;&#10;&#13;&#10;IF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Food])/SUM([Orders_Food])&#13;&#10;)&#13;&#10;)-1 &lt; - 0.05 &#13;&#10;&#13;&#10;THEN 0&#13;&#10;&#13;&#10;&#13;&#10;//&#13;&#10;&#13;&#10;// BLOQUE 2:&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Food])/SUM([Orders_Food])&#13;&#10;)&#13;&#10;)-1 &gt;= - 0.05&#13;&#10;&#13;&#10;AND (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Food])/SUM([Orders_Food])&#13;&#10;)&#13;&#10;)-1 &lt; 0 &#13;&#10;&#13;&#10;THEN 1&#13;&#10;&#13;&#10;// &#13;&#10;&#13;&#10;//BLOQUE 3:&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Food])/SUM([Orders_Food])&#13;&#10;)&#13;&#10;)-1 &gt;=  0 THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END&#13;&#10;&#13;&#10;//' />
            </column>
            <column caption='compliance_afv_food_fxc' datatype='real' default-format='p0%' name='[compliance_commrev_food_fxc (copia)_564075890610737168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Food])/SUM([Orders_Food])&#13;&#10;)&#13;&#10;)-1' />
            </column>
