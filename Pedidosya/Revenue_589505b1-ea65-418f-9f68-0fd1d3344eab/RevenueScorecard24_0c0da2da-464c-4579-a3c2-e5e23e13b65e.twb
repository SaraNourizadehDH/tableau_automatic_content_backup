            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='last' datatype='integer' name='[Calculation_836262193946132484]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='current_last_month' datatype='integer' name='[Calculation_957577915262074880]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MONTH(DATEADD(&apos;month&apos;,-1,NOW()))' />
            </column>
            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
