            <column-instance column='[date_quarter_prm (copia)_908319788429492230]' derivation='None' name='[none:date_quarter_prm (copia)_908319788429492230:nk]' pivot='key' type='nominal' />
            <column caption='pos_as_gmv_fxn_gmv' datatype='real' default-format='p0.00%' name='[pos_as_gmv_fxn (copia) (copia)_1718686243626188801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000 ) }' />
