              <calculation class='tableau' formula='IF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Local_Stores] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores])/SUM([GFV_Local_Stores])&#13;&#10;) &lt; - 0.0005 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Local_Stores] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores])/SUM([GFV_Local_Stores])&#13;&#10;) &gt;= -0.0005&#13;&#10;&#13;&#10;AND (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Local_Stores] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores])/SUM([GFV_Local_Stores])&#13;&#10;) &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Local_Stores] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Local_Stores] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores])/SUM([GFV_Local_Stores])&#13;&#10;) &gt;= 0&#13;&#10; THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_cr_ls_fxc' datatype='real' default-format='p0.00%' name='[compliance_cr_food (copia)_224617064977457156]' role='measure' type='quantitative'>
