              <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
