            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column caption='ads_amount_food' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_amount (copia)_564075890589261826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products]))/1000000' />
            </column>
            <column caption='comp_rank_ads_food_fxc' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_ads_fxc (copia)_564075890587242497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products])&#13;&#10;)-1 &lt; - 0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products])&#13;&#10;)-1 &gt;= - 0.05&#13;&#10;AND (&#13;&#10;SUM({ FIXED [COUNTRY],[COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products])&#13;&#10;)-1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products])&#13;&#10;)-1 &gt;=  0 THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_ads_fxc_food' datatype='real' default-format='p0%' name='[compliance_ads_fxc (copia)_564075890589753347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([Listing_Priority]+[Joker]+[Featured_Products])&#13;&#10;)-1' />
            </column>
            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[COUNTRY (copia)_1425952268347281410]' derivation='None' name='[none:COUNTRY (copia)_1425952268347281410:nk]' pivot='key' type='nominal' />
