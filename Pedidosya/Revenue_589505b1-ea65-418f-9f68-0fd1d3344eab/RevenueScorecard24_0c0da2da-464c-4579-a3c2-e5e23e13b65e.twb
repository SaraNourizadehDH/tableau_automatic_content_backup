              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)/1000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([listing_priority_monthly_target (copia 4)_1502513466285125635])&#13;&#10;)-1)&lt;-0.1 THEN 0&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)/1000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([listing_priority_monthly_target (copia 4)_1502513466285125635])&#13;&#10;)-1)&gt;=-0.1&#13;&#10;AND&#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)/1000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([listing_priority_monthly_target (copia 4)_1502513466285125635])&#13;&#10;)-1)&lt; 0 &#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)/1000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([listing_priority_monthly_target (copia 4)_1502513466285125635])&#13;&#10;)-1)&gt;=0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_acum_pos_fxc' datatype='real' default-format='p0%' name='[compliance_acum_suf_fxc (copia)_957577915358330897]' role='measure' type='quantitative'>
