            <column caption='last' datatype='integer' name='[Calculation_836262193946132484]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='current_last_month' datatype='integer' name='[Calculation_957577915262074880]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MONTH(DATEADD(&apos;month&apos;,-1,NOW()))' />
            </column>
            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column datatype='real' name='[Commission_Revenue_Local_Stores]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='DATE_DIFF_MONTH_6M' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_MONTH (copia)_481885210712248320]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
            </column>
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[Pos_Rental]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='compliance_bdgt_acum_pos_fxc' datatype='real' default-format='p0%' name='[compliance_acum_pos_fxc (copia)_1375005308247261209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)/1000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([pos_monthly_target (copia)_1375005308221935629])&#13;&#10;)-1' />
            </column>
            <column caption='date_current_last_month' datatype='boolean' name='[date_acumulado (copia)_957577915274211337]' role='measure' type='nominal'>
              <calculation class='tableau' formula='([Calculation_836262193946132484])=max([Calculation_957577915262074880])-max([Calculation_957577915262074880])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='bdgt_monthly_target_bin' datatype='integer' name='[monthly_target_bin (copia)_1375005308218925057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([DATA_LEVEL]=(&apos;Smart&apos;) OR [DATA_LEVEL]=(&apos;Budget 2023&apos;) OR [DATA_LEVEL]=(&apos;Budget Round 2024&apos;) ) = TRUE &#13;&#10;THEN 1 ELSE 0 END' />
            </column>
