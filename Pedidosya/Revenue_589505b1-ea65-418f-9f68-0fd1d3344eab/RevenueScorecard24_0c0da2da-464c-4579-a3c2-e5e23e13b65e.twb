            <column-instance column='[CURRENCY]' derivation='None' name='[none:CURRENCY:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1283525947915735040]' derivation='None' name='[none:Calculation_1283525947915735040:nk]' pivot='key' type='nominal' />
            <column-instance column='[DATA_LEVEL]' derivation='None' name='[none:DATA_LEVEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[DATE]' derivation='Quarter' name='[qr:DATE:ok]' pivot='key' type='ordinal' />
