            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='DATE_DIFF_YEAR' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_QUARTER (copia)_908319788429516808]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX((DATEDIFF(&apos;year&apos;,[Parameters].[date_quarter (copia)_908319788429504519],[DATE])))' />
            </column>
            <column datatype='real' name='[POS_Package]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='suf_amount_actual_fxc' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_amount_actual_fxc (copia)_718324181324304388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee] + [POS_Package] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee] + [POS_Package] ELSE 0 END)} ELSE NULL END' />
            </column>
            <column caption='suf_monthly_target' datatype='real' name='[listing_priority_monthly_target (copia 3)_1502513466285117442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([Calculation_540431994116587523])=1 THEN ([Set_Up_Fee] + [POS_Package]) ELSE 0 END)/1000' />
