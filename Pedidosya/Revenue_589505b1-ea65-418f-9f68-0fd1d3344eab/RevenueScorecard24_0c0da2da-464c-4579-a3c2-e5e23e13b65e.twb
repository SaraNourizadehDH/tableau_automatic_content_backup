              <calculation class='tableau' formula='IF (&#13;&#10;SUM([comm_rate_food_fxn (copia)_601230586008866859])/SUM([comm_rate_food_fxn (copia) (copia)_601230586008875052])-&#13;&#10;SUM([Commission_Revenue_Food]/[TC])/SUM([GFV_Food]/[TC])&#13;&#10;) &lt; - 0.0005 THEN 0&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ( (&#13;&#10;SUM([comm_rate_food_fxn (copia)_601230586008866859])/SUM([comm_rate_food_fxn (copia) (copia)_601230586008875052])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food]/[TC])/SUM([GFV_Food]/[TC])&#13;&#10;) &gt;= -0.0005 &#13;&#10;&#13;&#10;AND (&#13;&#10;SUM([comm_rate_food_fxn (copia)_601230586008866859])/SUM([comm_rate_food_fxn (copia) (copia)_601230586008875052])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food]/[TC])/SUM([GFV_Food]/[TC])&#13;&#10;) &lt; 0&#13;&#10;) THEN 1&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ((&#13;&#10;SUM([comm_rate_food_fxn (copia)_601230586008866859])/SUM([comm_rate_food_fxn (copia) (copia)_601230586008875052])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food]/[TC])/SUM([GFV_Food]/[TC])&#13;&#10;) &gt;=0&#13;&#10;) THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
