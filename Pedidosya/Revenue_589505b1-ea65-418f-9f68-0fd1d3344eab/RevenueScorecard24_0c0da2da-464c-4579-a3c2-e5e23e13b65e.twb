    <worksheet name='Comp Ads as GMV FXN LATAM'>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue_lucanet (automated_tables_reports)' name='federated.1sug86j0swfs9e173830f0ln9et7' />
          </datasources>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column datatype='real' name='[Ads_Local_Stores]' role='measure' type='quantitative' />
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='ads_amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_409827598311694336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))/1000000' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' name='[Featured_Products]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_including_Incentives__user_paid_amount_]' role='measure' type='quantitative' />
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[TC]' role='measure' type='quantitative' />
            <column caption='ads_as_gmv_fxn_gmv' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ads_as_gmv_fxn (copia) (copia)_601230586011693105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }' />
            </column>
            <column caption='ads_as_gmv_fxn_ads' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ads_as_gmv_fxn (copia)_601230586011676720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }&#13;&#10;&#13;&#10;+&#13;&#10;&#13;&#10;{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Joker] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }&#13;&#10;&#13;&#10;+&#13;&#10;&#13;&#10;{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Featured_Products] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }&#13;&#10;&#13;&#10;+&#13;&#10;&#13;&#10;{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Ads_Local_Stores] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }&#13;&#10;&#13;&#10;)' />
            </column>
            <column caption='comp_rank_ads_gmv_fxn' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_ads_gmv_fxc (copia)_1040613024870928393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;(SUM([ads_as_gmv_fxn (copia)_601230586011676720])/SUM([ads_as_gmv_fxn (copia) (copia)_601230586011693105]))&#13;&#10;/&#13;&#10;((SUM([Listing_Priority]/[TC])+SUM([Joker]/[TC])+SUM([Featured_Products]/[TC])+SUM([Ads_Local_Stores]/[TC]))/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &lt; -0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(SUM([ads_as_gmv_fxn (copia)_601230586011676720])/SUM([ads_as_gmv_fxn (copia) (copia)_601230586011693105]))&#13;&#10;/&#13;&#10;((SUM([Listing_Priority]/[TC])+SUM([Joker]/[TC])+SUM([Featured_Products]/[TC])+SUM([Ads_Local_Stores]/[TC]))/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &gt;= - 0.05&#13;&#10;AND (&#13;&#10;(SUM([ads_as_gmv_fxn (copia)_601230586011676720])/SUM([ads_as_gmv_fxn (copia) (copia)_601230586011693105]))&#13;&#10;/&#13;&#10;((SUM([Listing_Priority]/[TC])+SUM([Joker]/[TC])+SUM([Featured_Products]/[TC])+SUM([Ads_Local_Stores]/[TC]))/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(SUM([ads_as_gmv_fxn (copia)_601230586011676720])/SUM([ads_as_gmv_fxn (copia) (copia)_601230586011693105]))&#13;&#10;/&#13;&#10;((SUM([Listing_Priority]/[TC])+SUM([Joker]/[TC])+SUM([Featured_Products]/[TC])+SUM([Ads_Local_Stores]/[TC]))/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)-1 &gt;= 0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_ads_as_gmv_fxn' datatype='real' default-format='p0.00%' name='[compliance_ads_as_gmv_fxc (copia)_1040613024868282376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(SUM([ads_as_gmv_fxn (copia)_601230586011676720])/SUM([ads_as_gmv_fxn (copia) (copia)_601230586011693105]))&#13;&#10;-&#13;&#10;((SUM([Listing_Priority]/[TC])+SUM([Joker]/[TC])+SUM([Featured_Products]/[TC])+SUM([Ads_Local_Stores]/[TC]))/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)' />
            </column>
