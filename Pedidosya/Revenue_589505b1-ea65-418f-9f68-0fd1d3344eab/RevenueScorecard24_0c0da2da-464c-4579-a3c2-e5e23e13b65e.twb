              <calculation class='tableau' formula='IF ((&#13;&#10;SUM({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} )&#13;&#10;/&#13;&#10;&#13;&#10;SUM([Pos_Rental])&#13;&#10;)-1) = WINDOW_MAX(((&#13;&#10;SUM({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} )&#13;&#10;/&#13;&#10;&#13;&#10;SUM([Pos_Rental])&#13;&#10;)-1)) THEN &quot;Max&quot;&#13;&#10;&#13;&#10;ELSEIF ((&#13;&#10;SUM({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM([Pos_Rental])&#13;&#10;)-1) = WINDOW_MIN((&#13;&#10;SUM({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} )&#13;&#10;/&#13;&#10;&#13;&#10;SUM([Pos_Rental])&#13;&#10;)-1) THEN &quot;Min&quot;&#13;&#10;&#13;&#10;ELSE &quot;Neither&quot;&#13;&#10;&#13;&#10;END'>
