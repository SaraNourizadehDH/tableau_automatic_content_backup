      <column caption='DATE_DIFF_MONTH_6M' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_MONTH (copia)_481885210712248320]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
      </column>
      <column caption='DATE_DIFF_QUARTER' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_MONTH (copia)_908319788390330369]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX((DATEDIFF(&apos;quarter&apos;,[Parameters].[date_quarter (copia)_908319788394979331],[DATE])))' />
      </column>
      <column caption='DATE_DIFF_YEAR' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_QUARTER (copia)_908319788429516808]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX((DATEDIFF(&apos;year&apos;,[Parameters].[date_quarter (copia)_908319788429504519],[DATE])))' />
      </column>
