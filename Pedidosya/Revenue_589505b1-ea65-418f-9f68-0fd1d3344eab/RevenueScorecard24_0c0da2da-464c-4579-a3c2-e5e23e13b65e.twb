              <calculation class='tableau' formula='IF (&#13;&#10;(&#13;&#10;SUM([pos_as_gmv_fxn (copia)_1718686243626180608])/SUM([pos_as_gmv_fxn (copia) (copia)_1718686243626188801])&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Pos_Rental]/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;) -1 &lt; - 0.1 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM([pos_as_gmv_fxn (copia)_1718686243626180608])/SUM([pos_as_gmv_fxn (copia) (copia)_1718686243626188801])&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Pos_Rental]/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;) -1 &gt;= - 0.1 &#13;&#10;AND (&#13;&#10;(&#13;&#10;SUM([pos_as_gmv_fxn (copia)_1718686243626180608])/SUM([pos_as_gmv_fxn (copia) (copia)_1718686243626188801])&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Pos_Rental]/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;) -1 &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM([pos_as_gmv_fxn (copia)_1718686243626180608])/SUM([pos_as_gmv_fxn (copia) (copia)_1718686243626188801])&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM([Pos_Rental]/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;) -1 &gt;= 0&#13;&#10; THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_pos_as_gmv_fxn' datatype='real' default-format='p0.00%' name='[compliance_pos_as_gmv_fxc (copia)_1040613024883048460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(&#13;&#10;SUM([pos_as_gmv_fxn (copia)_1718686243626180608])/SUM([pos_as_gmv_fxn (copia) (copia)_1718686243626188801])&#13;&#10;)&#13;&#10;-&#13;&#10;(SUM([Pos_Rental]/[TC])/SUM([GMV_including_Incentives__user_paid_amount_]/[TC]))&#13;&#10;)' />
            </column>
