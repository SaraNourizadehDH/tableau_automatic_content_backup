    <worksheet name='Target Bdgt Ads %GMV Acum'>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue_lucanet (automated_tables_reports)' name='federated.1sug86j0swfs9e173830f0ln9et7' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_year' datatype='date' datatype-customized='true' default-format='*yyyy' name='[date_quarter (copia)_908319788429504519]' param-domain-type='list' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column datatype='real' name='[Ads_Local_Stores]' role='measure' type='quantitative' />
            <column caption='COUNTRY w/o SSC' datatype='string' name='[COUNTRY (copia)_1425952268347281410]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='DATE_DIFF_YEAR' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_QUARTER (copia)_908319788429516808]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX((DATEDIFF(&apos;year&apos;,[Parameters].[date_quarter (copia)_908319788429504519],[DATE])))' />
            </column>
            <column datatype='real' name='[Featured_Products]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_including_Incentives__user_paid_amount_]' role='measure' type='quantitative' />
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column caption='bdgt_ads_as_gmv_monthly_target' datatype='real' default-format='p0.00%' name='[ads_as_gmv_monthly_target (copia)_1375005308221628423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 THEN ([Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores]) ELSE 0 END)/&#13;&#10;SUM(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 THEN ([GMV_including_Incentives__user_paid_amount_]) ELSE 0 END)' />
            </column>
            <column caption='date_ytd' datatype='string' default-format='n#,##0;-#,##0' name='[month_number_max_date (copia)_1200772311193034761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,[DATE]) &lt; DATEPART(&apos;month&apos;,TODAY())&#13;&#10;&#13;&#10;THEN &quot;YTD&quot;&#13;&#10;ELSE &quot;Future&quot;&#13;&#10;END' />
            </column>
            <column caption='bdgt_monthly_target_bin' datatype='integer' name='[monthly_target_bin (copia)_1375005308218925057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([DATA_LEVEL]=(&apos;Smart&apos;) OR [DATA_LEVEL]=(&apos;Budget 2023&apos;) OR [DATA_LEVEL]=(&apos;Budget Round 2024&apos;) ) = TRUE &#13;&#10;THEN 1 ELSE 0 END' />
