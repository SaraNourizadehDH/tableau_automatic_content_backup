    <worksheet name='Compliance Bdgt CommRev Food Acum'>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue_lucanet (automated_tables_reports)' name='federated.1sug86j0swfs9e173830f0ln9et7' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_year' datatype='date' datatype-customized='true' default-format='*yyyy' name='[date_quarter (copia)_908319788429504519]' param-domain-type='list' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column caption='COUNTRY w/o SSC' datatype='string' name='[COUNTRY (copia)_1425952268347281410]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='DATE_DIFF_YEAR' datatype='integer' default-format='n#,##0.000;-#,##0.000' name='[DATE_DIFF_QUARTER (copia)_908319788429516808]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX((DATEDIFF(&apos;year&apos;,[Parameters].[date_quarter (copia)_908319788429504519],[DATE])))' />
            </column>
            <column caption='bdgt_commrev_food_monthly_target' datatype='real' name='[bdgt_ads_monthly_target (copia)_1200772311127695360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 &#13;&#10;THEN ([Commission_Revenue_Food]) &#13;&#10;ELSE 0 END)/1000000' />
            </column>
            <column caption='comp_rank_bdgt_acum_commrev_food_fxc' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[comp_rank_bdgt_acum_ads_fxc (copia 2)_562668538170843145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1)&lt;-0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1)&gt;=-0.05 &#13;&#10;AND&#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1)&lt; 0 &#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1)&gt;=0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_bdgt_acum_commrev_food_fxc' datatype='real' default-format='p0%' name='[compliance_bdgt_acum_ads_fxc (copia)_1200772311146868740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Food] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia)_1200772311127695360])&#13;&#10;)-1' />
            </column>
            <column-instance column='[DATE]' derivation='Month' name='[mn:DATE:ok]' pivot='key' type='ordinal' />
            <column caption='date_ytd' datatype='string' default-format='n#,##0;-#,##0' name='[month_number_max_date (copia)_1200772311193034761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,[DATE]) &lt; DATEPART(&apos;month&apos;,TODAY())&#13;&#10;&#13;&#10;THEN &quot;YTD&quot;&#13;&#10;ELSE &quot;Future&quot;&#13;&#10;END' />
            </column>
            <column caption='bdgt_monthly_target_bin' datatype='integer' name='[monthly_target_bin (copia)_1375005308218925057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([DATA_LEVEL]=(&apos;Smart&apos;) OR [DATA_LEVEL]=(&apos;Budget 2023&apos;) OR [DATA_LEVEL]=(&apos;Budget Round 2024&apos;) ) = TRUE &#13;&#10;THEN 1 ELSE 0 END' />
            </column>
            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[COUNTRY (copia)_1425952268347281410]' derivation='None' name='[none:COUNTRY (copia)_1425952268347281410:nk]' pivot='key' type='nominal' />
            <column-instance column='[COUNTRY]' derivation='None' name='[none:COUNTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[CURRENCY]' derivation='None' name='[none:CURRENCY:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number_max_date (copia)_1200772311193034761]' derivation='None' name='[none:month_number_max_date (copia)_1200772311193034761:nk]' pivot='key' type='nominal' />
