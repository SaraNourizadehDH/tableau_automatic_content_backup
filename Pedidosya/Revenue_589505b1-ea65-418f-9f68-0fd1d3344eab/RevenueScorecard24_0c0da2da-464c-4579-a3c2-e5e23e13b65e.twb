              <calculation class='tableau' formula='(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: &#13;&#10;&#13;&#10;SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food] ELSE 0 END)}&#13;&#10;&#13;&#10;)&gt;0 &#13;&#10;&#13;&#10;THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: &#13;&#10;SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Food] ELSE 0 END)} &#13;&#10;&#13;&#10;ELSE NULL END)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: &#13;&#10;&#13;&#10;SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food] ELSE 0 END)}&#13;&#10;&#13;&#10;)&gt;0 &#13;&#10;&#13;&#10;THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: &#13;&#10;SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food] ELSE 0 END)} &#13;&#10;&#13;&#10;ELSE NULL END)' />
