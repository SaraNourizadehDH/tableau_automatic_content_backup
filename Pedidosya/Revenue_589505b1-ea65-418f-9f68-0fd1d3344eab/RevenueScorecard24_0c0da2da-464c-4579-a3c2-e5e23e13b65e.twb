            <column caption='ads_amount_fxn' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_amount (copia)_601230585916039198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000000 ) }' />
