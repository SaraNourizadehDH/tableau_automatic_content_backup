            <column-instance column='[CURRENCY]' derivation='None' name='[none:CURRENCY:nk]' pivot='key' type='nominal' />
            <column caption='suf_amount_actual_fxc_in_k' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[suf_amount_actual_fxc (copia)_1375005308268372006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee] + [POS_Package] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Set_Up_Fee] + [POS_Package] ELSE 0 END)} ELSE NULL END / 1000' />
            </column>
            <column caption='bdgt_suf_monthly_target' datatype='real' name='[suf_monthly_target (copia)_1375005308222001169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 THEN ([Set_Up_Fee] + [POS_Package]) ELSE 0 END)/1000' />
            </column>
