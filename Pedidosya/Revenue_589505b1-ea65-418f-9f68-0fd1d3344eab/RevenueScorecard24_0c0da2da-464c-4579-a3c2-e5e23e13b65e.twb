              <calculation class='tableau' formula='//BLOQUE 1:&#13;&#10;&#13;&#10;IF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Local_Stores]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Local_Stores])/SUM([Orders_Local_Stores])&#13;&#10;)&#13;&#10;)-1 &lt; - 0.05 &#13;&#10;&#13;&#10;THEN 0&#13;&#10;&#13;&#10;&#13;&#10;//&#13;&#10;&#13;&#10;// BLOQUE 2:&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Local_Stores]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Local_Stores])/SUM([Orders_Local_Stores])&#13;&#10;)&#13;&#10;)-1 &gt;= - 0.05&#13;&#10;&#13;&#10;AND (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Local_Stores]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Local_Stores])/SUM([Orders_Local_Stores])&#13;&#10;)&#13;&#10;)-1 &lt; 0 &#13;&#10;&#13;&#10;THEN 1&#13;&#10;&#13;&#10;// &#13;&#10;&#13;&#10;//BLOQUE 3:&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Local_Stores]ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores]ELSE 0 END)} )&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(&#13;&#10;SUM([GFV_Local_Stores])/SUM([Orders_Local_Stores])&#13;&#10;)&#13;&#10;)-1 &gt;=  0 THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END&#13;&#10;&#13;&#10;//' />
            </column>
