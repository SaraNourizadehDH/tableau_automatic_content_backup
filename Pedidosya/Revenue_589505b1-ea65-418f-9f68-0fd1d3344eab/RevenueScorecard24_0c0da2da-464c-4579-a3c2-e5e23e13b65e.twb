          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_year' datatype='date' datatype-customized='true' default-format='*yyyy' name='[date_quarter (copia)_908319788429504519]' param-domain-type='list' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column caption='COUNTRY w/o SSC' datatype='string' name='[COUNTRY (copia)_1425952268347281410]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='comp_rank_cr_food_fxc' datatype='integer' name='[Calculation_224617065009102876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &lt; - 0.0005 THEN 0&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ( (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &gt;= -0.0005 &#13;&#10;&#13;&#10;AND (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &lt; 0 &#13;&#10;) THEN 1&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ((&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &gt;=0&#13;&#10;&#13;&#10;) THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_cr_food_fxc' datatype='real' default-format='p0.00%' name='[Calculation_409827598324576263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;)' />
            </column>
            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column caption='GFV Food' datatype='real' name='[GFV_Food]' role='measure' type='quantitative' />
            <column caption='date_year_prm' datatype='boolean' name='[date_quarter_prm (copia)_908319788429492230]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;,[DATE]))=&#13;&#10;[Parameters].[date_quarter (copia)_908319788429504519]' />
            </column>
            <column-instance column='[COUNTRY (copia)_1425952268347281410]' derivation='None' name='[none:COUNTRY (copia)_1425952268347281410:nk]' pivot='key' type='nominal' />
            <column-instance column='[COUNTRY]' derivation='None' name='[none:COUNTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[CURRENCY]' derivation='None' name='[none:CURRENCY:nk]' pivot='key' type='nominal' />
