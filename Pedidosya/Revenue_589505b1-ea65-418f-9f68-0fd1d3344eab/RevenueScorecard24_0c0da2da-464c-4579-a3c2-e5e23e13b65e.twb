      <column caption='max_date' datatype='date' default-format='*DD/MM/YY' name='[Calculation_1214564572551389185]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(&#13;&#10;IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)' />
      </column>
      <column caption='boldmax_ads_as_gmv_country_fxc' datatype='real' default-format='p0.00%' name='[Calculation_1236801081525620748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [compliance_ads_as_gmv_country_fxc (copia)_1236801081523097604] = &quot;Max&quot; Then [compliance_ads_as_gmv (copia)_224617064995151898] End'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='date_dynamic' datatype='string' name='[Calculation_1283525947915735040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_1283525947915792385]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [date_quarter (copia)_1283525947916398596]&#13;&#10;    WHEN &apos;Semester&apos;  THEN [date_quarter_dynamic (copia)_1283525947916742661]&#13;&#10;    WHEN &apos;Year&apos; THEN [date_quarter_dynamic (copia)_1283525947916873734]&#13;&#10;END' />
      </column>
      <column caption='date_month_string_dynamic' datatype='string' name='[Calculation_1283525947915792385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,DATE),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
      </column>
      <column caption='FIRST' datatype='integer' name='[Calculation_1600185283983564815]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='FIRST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='BEcount' datatype='integer' name='[Calculation_1600185283991965713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [DATA_LEVEL]:COUNTD([DATA_LEVEL])}' />
      </column>
      <column caption='comp_prueba' datatype='real' name='[Calculation_206884159513972736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;(SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Pos_Rental] ELSE 0 END)} ELSE NULL END)&#13;&#10;/&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)} ELSE NULL END))&#13;&#10;&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(([pos_as_gmv_monthly_target_pos (copia)_1375005308221923340])/([pos_as_gmv_monthly_target_gmv (copia)_1375005308221890571]))&#13;&#10;)-1' />
      </column>
      <column caption='comp_rank_cr_food_fxc' datatype='integer' name='[Calculation_224617065009102876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &lt; - 0.0005 THEN 0&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ( (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &gt;= -0.0005 &#13;&#10;&#13;&#10;AND (&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &lt; 0 &#13;&#10;) THEN 1&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ((&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;/&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;) &gt;=0&#13;&#10;&#13;&#10;) THEN 2&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='ads_amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_409827598311694336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))/1000000' />
      </column>
      <column caption='suf_amount' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_409827598312697857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Set_Up_Fee]+[POS_Package])/1000' />
      </column>
      <column caption='pos_amount' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_409827598312861698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pos_Rental])/1000' />
      </column>
      <column caption='suf_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_409827598314618883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Set_Up_Fee]+ [POS_Package])/SUM([GMV_including_Incentives__user_paid_amount_])' />
      </column>
      <column caption='ads_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_409827598315704325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))/SUM([GMV_including_Incentives__user_paid_amount_])' />
      </column>
      <column caption='compliance_cr_food_fxc' datatype='real' default-format='p0.00%' name='[Calculation_409827598324576263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;)' />
      </column>
