              <calculation class='tableau' formula='SUM({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: SUM ([Commission_Revenue_Food])} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} )) ) })&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM( { FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: SUM ([GFV_Food])} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} )) ) })' />
