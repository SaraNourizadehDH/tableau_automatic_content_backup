    <worksheet name='Non Ads Target Table FXC'>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue_lucanet (automated_tables_reports)' name='federated.1sug86j0swfs9e173830f0ln9et7' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
            <column datatype='real' name='[Ads_Local_Stores]' role='measure' type='quantitative' />
            <column caption='COUNTRY w/o SSC' datatype='string' name='[COUNTRY (copia)_1425952268347281410]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column caption='Data Level w/o Actual' datatype='string' name='[COUNTRY w/o SSC (copia)_178455198619865088]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[DATA_LEVEL]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='date_dynamic' datatype='string' name='[Calculation_1283525947915735040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_1283525947915792385]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [date_quarter (copia)_1283525947916398596]&#13;&#10;    WHEN &apos;Semester&apos;  THEN [date_quarter_dynamic (copia)_1283525947916742661]&#13;&#10;    WHEN &apos;Year&apos; THEN [date_quarter_dynamic (copia)_1283525947916873734]&#13;&#10;END' />
            </column>
            <column caption='date_month_string_dynamic' datatype='string' name='[Calculation_1283525947915792385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,DATE),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column caption='ads_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_409827598315704325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM(Ads_Local_Stores))/SUM([GMV_including_Incentives__user_paid_amount_])' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Featured_Products]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_including_Incentives__user_paid_amount_]' role='measure' type='quantitative' />
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[Pos_Rental]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='table_ads_amount' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[ads_amount (copia)_1212594240290656256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))' />
            </column>
            <column caption='date_quarter_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter (copia)_1283525947916398596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[DATE]))+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column caption='date_semester_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter_dynamic (copia)_1283525947916742661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[DATE]) &lt; 3 THEN &apos;H1&apos; ELSE &apos;H2&apos; END+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column caption='date_year_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter_dynamic (copia)_1283525947916873734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + &apos; &apos;+ STR(DATEPART(&apos;year&apos;,[DATE]))' />
