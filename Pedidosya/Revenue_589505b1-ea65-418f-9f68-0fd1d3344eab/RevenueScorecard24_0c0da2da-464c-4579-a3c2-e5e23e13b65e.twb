              <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
            </column>
            <column datatype='real' name='[Joker]' role='measure' type='quantitative' />
            <column datatype='real' name='[Listing_Priority]' role='measure' type='quantitative' />
            <column datatype='real' name='[Orders_Local_Stores]' role='measure' type='quantitative' />
            <column datatype='real' name='[Pos_Rental]' role='measure' type='quantitative' />
            <column datatype='real' name='[Set_Up_Fee]' role='measure' type='quantitative' />
            <column caption='bdgt_ord_ls_monthly_target' datatype='real' name='[bdgt_ads_monthly_target (copia) (copia 2) (copia)_1200772311127732227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  ([monthly_target_bin (copia)_1375005308218925057])=1 &#13;&#10;THEN ([Orders_Local_Stores]) &#13;&#10;ELSE 0 END)/1000000' />
            </column>
            <column caption='ord_ls_actual_fxc_in_mio' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[comm_rev_ls_actual_fxc_in_mio (copia)_562668538195443793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores] ELSE 0 END)} ELSE NULL END)/1000000' />
            </column>
            <column caption='compliance_bdgt_acum_ord_ls_fxc' datatype='real' default-format='p0%' name='[compliance_bdgt_acum_commrev_food_fxc (copia) (copia) (copia)_1200772311147134983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Local_Stores] ELSE 0 END)} ELSE NULL END)/1000000&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([bdgt_ads_monthly_target (copia) (copia 2) (copia)_1200772311127732227])&#13;&#10;)-1' />
            </column>
            <column caption='date_current_last_month' datatype='boolean' name='[date_acumulado (copia)_957577915274211337]' role='measure' type='nominal'>
              <calculation class='tableau' formula='([Calculation_836262193946132484])=max([Calculation_957577915262074880])-max([Calculation_957577915262074880])'>
                <table-calc ordering-type='Rows' />
