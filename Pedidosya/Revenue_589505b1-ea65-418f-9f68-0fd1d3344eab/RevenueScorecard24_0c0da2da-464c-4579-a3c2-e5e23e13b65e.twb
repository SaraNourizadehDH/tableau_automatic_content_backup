              <calculation class='tableau' formula='SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Listing_Priority]+[Joker]+[Featured_Products]+[Ads_Local_Stores] ELSE 0 END)} ELSE NULL END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_]  END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GMV_including_Incentives__user_paid_amount_] ELSE 0 END)} ELSE NULL END&#13;&#10;)' />
