            <column caption='date_quarter_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter (copia)_1283525947916398596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[DATE]))+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column caption='date_semester_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter_dynamic (copia)_1283525947916742661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[DATE]) &lt; 3 THEN &apos;H1&apos; ELSE &apos;H2&apos; END+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column caption='date_year_dynamic' datatype='string' datatype-customized='true' default-format='*Tq yy' name='[date_quarter_dynamic (copia)_1283525947916873734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + &apos; &apos;+ STR(DATEPART(&apos;year&apos;,[DATE]))' />
            </column>
            <column-instance column='[DATE]' derivation='Max' name='[max:DATE:qk]' pivot='key' type='quantitative' />
