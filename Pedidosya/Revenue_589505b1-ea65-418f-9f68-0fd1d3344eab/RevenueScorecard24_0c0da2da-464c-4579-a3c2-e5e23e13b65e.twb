              <calculation class='tableau' formula='(SUM([Listing_Priority])+SUM([Joker])+SUM([Featured_Products])+SUM([Ads_Local_Stores]))/1000000' />
            </column>
            <column caption='date_month_prm' datatype='boolean' name='[Calculation_836262194027679753]' role='dimension' type='nominal'>
