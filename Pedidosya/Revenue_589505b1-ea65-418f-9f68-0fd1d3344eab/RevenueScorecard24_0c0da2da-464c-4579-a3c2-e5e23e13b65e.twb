              <calculation class='tableau' formula='[COUNTRY]' />
            </column>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column datatype='real' name='[Commission_Revenue_Local_Stores]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' name='[GFV_Local_Stores]' role='measure' type='quantitative' />
            <column datatype='real' name='[TC]' role='measure' type='quantitative' />
            <column caption='comm_rate_ls_fxn cr' datatype='real' default-format='n#,##0;-#,##0' name='[comm_rate_food_fxn cr (copia)_601230586011254830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Commission_Revenue_Local_Stores] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000 ) }' />
            </column>
            <column caption='comm_rate_ls_fxn_gfv' datatype='real' default-format='n#,##0;-#,##0' name='[comm_rate_food_fxn gfv (copia)_601230586011263023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]:SUM (  (({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[GFV_Local_Stores] ELSE 0 END)} ))&#13;&#10;/&#13;&#10;(({ FIXED [CURRENCY],[DATE],[COUNTRY],[DATA_LEVEL]: AVG([TC])} ))/1000 ) }' />
            </column>
            <column caption='comp_rank_cr_ls_fxn' datatype='integer' name='[comp_rank_cr_ls (copia)_1718686243633369096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#13;&#10;SUM([comm_rate_food_fxn cr (copia)_601230586011254830])/SUM([comm_rate_food_fxn gfv (copia)_601230586011263023])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores]/[TC])/SUM([GFV_Local_Stores]/[TC])&#13;&#10;) &lt; - 0.0005 THEN 0&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([comm_rate_food_fxn cr (copia)_601230586011254830])/SUM([comm_rate_food_fxn gfv (copia)_601230586011263023])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores]/[TC])/SUM([GFV_Local_Stores]/[TC])&#13;&#10;) &gt;= - 0.0005 &#13;&#10;&#13;&#10;AND (&#13;&#10;SUM([comm_rate_food_fxn cr (copia)_601230586011254830])/SUM([comm_rate_food_fxn gfv (copia)_601230586011263023])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores]/[TC])/SUM([GFV_Local_Stores]/[TC])&#13;&#10;) &lt; 0 THEN 1&#13;&#10;&#13;&#10;ELSEIF (&#13;&#10;SUM([comm_rate_food_fxn cr (copia)_601230586011254830])/SUM([comm_rate_food_fxn gfv (copia)_601230586011263023])&#13;&#10;-&#13;&#10;SUM([Commission_Revenue_Local_Stores]/[TC])/SUM([GFV_Local_Stores]/[TC])&#13;&#10;) &gt;= 0 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='compliance_cr_ls_fxn' datatype='real' default-format='p0.00%' name='[compliance_cr_ls_fxc (copia)_1718686243633070087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([comm_rate_food_fxn cr (copia)_601230586011254830])/SUM([comm_rate_food_fxn gfv (copia)_601230586011263023])&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM([Commission_Revenue_Local_Stores]/[TC])/SUM([GFV_Local_Stores]/[TC])&#13;&#10;)' />
            </column>
            <column caption='date_quarter_prm' datatype='boolean' name='[date_quarter_prm (copia)_908319788395044868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;,[DATE]))=&#13;&#10;[Parameters].[date_quarter (copia)_908319788394979331]' />
