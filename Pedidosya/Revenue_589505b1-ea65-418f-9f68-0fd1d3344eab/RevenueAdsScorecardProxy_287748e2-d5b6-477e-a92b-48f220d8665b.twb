            <column caption='boldmin_ord_food_country_fxc' datatype='real' default-format='p0.00%' name='[boldmin_ads_country_fxc (copia) (copia) (copia)_562668538174136375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [maxmin_compliance_ads_country_fxc (copia) (copia) (copia)_562668538178437190] = &quot;Min&quot; Then [compliance_commrev_food_country_fxc CORREGIR (copia)_562668538172469271] End'>
                <table-calc ordering-type='Rows' />
