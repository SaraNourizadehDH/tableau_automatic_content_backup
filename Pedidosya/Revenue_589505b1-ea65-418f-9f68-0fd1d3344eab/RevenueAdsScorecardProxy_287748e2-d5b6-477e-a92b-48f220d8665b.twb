              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;)' />
            </column>
