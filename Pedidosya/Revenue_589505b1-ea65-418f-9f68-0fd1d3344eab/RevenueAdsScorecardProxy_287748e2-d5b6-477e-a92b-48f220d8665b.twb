            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' default-format='p0.0%' name='[Joker CVR %]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;€&quot;#,##0.000;(&quot;€&quot;#,##0.000)' name='[NCR EU ($M)]' role='measure' type='quantitative' />
