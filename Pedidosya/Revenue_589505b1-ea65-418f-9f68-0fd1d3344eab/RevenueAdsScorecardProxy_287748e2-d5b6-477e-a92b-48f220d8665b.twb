      <table>
        <view>
          <datasources>
            <datasource caption='Inputs (Scorecard Inputs)' name='federated.1yl281p1anocop16a87tg0x7lbcj' />
          </datasources>
          <datasource-dependencies datasource='federated.1sug86j0swfs9e173830f0ln9et7'>
