            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='compliance_cr_food_fxc' datatype='real' default-format='p0.00%' name='[Calculation_409827598324576263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [Commission_Revenue_Food] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({ FIXED [COUNTRY],[CURRENCY],[DATE]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN [GFV_Food] ELSE 0 END)})&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;)' />
            </column>
            <column caption='Commission Revenue Food' datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column caption='GFV Food' datatype='real' name='[GFV_Food]' role='measure' type='quantitative' />
