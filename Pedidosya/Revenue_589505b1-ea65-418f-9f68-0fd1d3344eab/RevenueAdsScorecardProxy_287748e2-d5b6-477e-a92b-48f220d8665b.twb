        <calculation class='tableau' formula='(IF [Calculation_849210016974848008] = 0 THEN 1 ELSE 0 END)*SUM([VP Active Food %])&#13;&#10;-&#13;&#10;(IF [Calculation_849210016974848008] = -1 THEN 1 ELSE 0 END)*SUM([VP Active Food %])&#13;&#10;-&#13;&#10;(IF [Calculation_849210016974848008] = -12 THEN 1 ELSE 0 END)*SUM([VP Active Food %])' />
