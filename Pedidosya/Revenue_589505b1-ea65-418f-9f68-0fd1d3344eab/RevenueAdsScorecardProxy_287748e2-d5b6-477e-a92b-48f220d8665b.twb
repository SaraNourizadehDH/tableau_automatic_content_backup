            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[COUNTRY]' derivation='None' name='[none:COUNTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[CURRENCY]' derivation='None' name='[none:CURRENCY:nk]' pivot='key' type='nominal' />
            <column-instance column='[DATA_LEVEL]' derivation='None' name='[none:DATA_LEVEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dashboard]' derivation='None' name='[none:Dashboard:nk]' pivot='key' type='nominal' />
            <column-instance column='[Score Plan 50 Rev (copy)_888897993944182793]' derivation='User' name='[usr:Score Plan 50 Rev (copy)_888897993944182793:qk]' pivot='key' type='quantitative' />
