      </column>
      <column caption='Vs CPC ROAS (Color)' datatype='integer' name='[Calculation_1649161951511871489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&gt;4&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&#13;&#10;AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt; 3.5&#13;&#10;&#13;&#10;THEN 1 &#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&lt; 3.5&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&#13;&#10;AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSE -1 END' />
      </column>
      <column caption='2022 Vs Roas (Color)' datatype='integer' name='[Calculation_1649161951514976258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&gt;4&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&lt;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&#13;&#10;&#13;&#10;THEN 1 &#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN [CPC ROAS]END)&lt; 3.5&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&gt;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&lt; 4&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSE -1 END' />
      </column>
