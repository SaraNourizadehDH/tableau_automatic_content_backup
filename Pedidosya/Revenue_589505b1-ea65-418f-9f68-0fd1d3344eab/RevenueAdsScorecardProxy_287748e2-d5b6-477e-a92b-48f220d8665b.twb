            <column-instance column='[DATA_LEVEL]' derivation='None' name='[none:DATA_LEVEL:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dashboard]' derivation='None' name='[none:Dashboard:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1649161951384231936]' derivation='Sum' name='[sum:Calculation_1649161951384231936:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1649161951511871489]' derivation='User' name='[usr:Calculation_1649161951511871489:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_764486097862049793]' derivation='User' name='[usr:Calculation_764486097862049793:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1yl281p1anocop16a87tg0x7lbcj].[my:DATE:ok]' filter-group='7'>
            <groupfilter function='member' level='[my:DATE:ok]' member='202308' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
