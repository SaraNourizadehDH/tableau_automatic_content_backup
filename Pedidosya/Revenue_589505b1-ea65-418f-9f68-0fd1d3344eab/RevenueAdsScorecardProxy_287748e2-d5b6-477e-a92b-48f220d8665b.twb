      <column caption='date_LM' datatype='integer' name='[Calculation_849210016974848008]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF&#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND [VP Active Food %]&gt;0&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
      </column>
      <column caption='last negativo' datatype='integer' name='[Calculation_849210016981274633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_849210016971530244]-1'>
