            <column datatype='real' default-format='p0.0%' name='[Budget Utilization]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Score Plan 50 Rev' datatype='integer' name='[Calculation_888897993942683655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([NCR EU ($M)])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([NCR EU ($M)])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([NCR EU ($M)])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([NCR EU ($M)])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
