            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter from='&quot;Argentina&quot;' function='range' level='[none:COUNTRY:nk]' to='&quot;Honduras&quot;' />
              <groupfilter from='&quot;Nicaragua&quot;' function='range' level='[none:COUNTRY:nk]' to='&quot;Venezuela&quot;' />
