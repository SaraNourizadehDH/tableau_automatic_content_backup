            <column caption='Score Plan 50 BU' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993944182793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Budget Utilization])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Budget Utilization])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Budget Utilization])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Budget Utilization])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
