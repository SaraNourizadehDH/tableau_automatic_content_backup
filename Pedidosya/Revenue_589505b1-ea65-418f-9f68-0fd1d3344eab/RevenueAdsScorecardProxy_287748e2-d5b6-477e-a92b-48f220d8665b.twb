            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cpc Roas' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPC ROAS]' role='dimension' type='ordinal' />
            <column caption='Currency' datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Actual CPC Roas ' datatype='real' name='[Calculation_1649161951384231936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE   [DATA_LEVEL] WHEN &quot;Actual&quot; THEN [CPC ROAS] END' />
            </column>
            <column caption='2022 Vs Roas (Color)' datatype='integer' name='[Calculation_1649161951514976258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&gt;4&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&lt;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&#13;&#10;&#13;&#10;THEN 1 &#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN [CPC ROAS]END)&lt; 3.5&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&gt;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE YEAR([DATE]) WHEN  2022 THEN([CPC ROAS])END)&lt; 4&#13;&#10;AND  SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE YEAR([DATE]) WHEN  2023 THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSE -1 END' />
            </column>
            <column caption='2022 Vs Roas' datatype='real' name='[Calculation_764486098023850005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE Year([DATE]) WHEN  2023&#13;&#10;&#13;&#10;THEN([CPC ROAS])END)-&#13;&#10;&#13;&#10;SUM(CASE Year([DATE]) WHEN  2022&#13;&#10;&#13;&#10;THEN([CPC ROAS])END)' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[COUNTRY]' derivation='None' name='[none:COUNTRY:nk]' pivot='key' type='nominal' />
