    <worksheet name='compromiso_o'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='9'>% compromiso por equipo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='base_asistencia_onboarding_newhires (automated_tables_reports)' name='federated.0yqg5t40i0hxmo1bvyl6j0i1vndq' />
          </datasources>
          <datasource-dependencies datasource='federated.0yqg5t40i0hxmo1bvyl6j0i1vndq'>
            <column caption='AsistenciaYes' datatype='integer' name='[Calculation_275282549827969028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [asistencia]= &quot;Si&quot; THEN 1 END)' />
            </column>
            <column caption='Count Asistencia' datatype='integer' name='[Calculation_275282549828112389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([asistencia])' />
            </column>
            <column caption='Porcentaje Asistencia' datatype='real' name='[Calculation_275282549828157446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_275282549827969028]/[Calculation_275282549828112389]' />
            </column>
            <column caption='CondicionOnboarding' datatype='string' name='[Calculation_275282549830569993]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) = 1 THEN &quot;Compromiso 100%&quot;&#13;&#10;ELSEIF ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) &gt;= 0.7 AND ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) &lt; 1 THEN &quot;Camino a lo esperado&quot; &#13;&#10;ELSE &quot;Necesita ajustar performance&quot;&#13;&#10;END' />
            </column>
            <column caption='Asistencia' datatype='string' name='[asistencia]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Manager' datatype='string' name='[manager]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Month' name='[mn:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[manager]' derivation='None' name='[none:manager:nk]' pivot='key' type='nominal' />
            <column-instance column='[pais]' derivation='None' name='[none:pais:nk]' pivot='key' type='nominal' />
            <column-instance column='[rol]' derivation='None' name='[none:rol:nk]' pivot='key' type='nominal' />
            <column caption='Pais' datatype='string' name='[pais]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Rol' datatype='string' name='[rol]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_275282549828157446]' derivation='User' name='[usr:Calculation_275282549828157446:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_275282549830569993]' derivation='User' name='[usr:Calculation_275282549830569993:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0yqg5t40i0hxmo1bvyl6j0i1vndq].[Action (MONTH(Date),Pais)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action12_C2D2F1504E194A468015B90134584C0A]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[mn:date:ok]' />
              <groupfilter function='level-members' level='[pais]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0yqg5t40i0hxmo1bvyl6j0i1vndq].[Action (MONTH(Date),Rol)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action12_19288381E72D4A72AA3A31823EEF466C]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[mn:date:ok]' />
