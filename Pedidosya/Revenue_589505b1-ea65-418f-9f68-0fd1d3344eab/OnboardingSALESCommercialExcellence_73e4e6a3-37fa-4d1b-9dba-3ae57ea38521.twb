      <column caption='CondicionOnboarding' datatype='string' name='[Calculation_275282549830569993]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) = 1 THEN &quot;Compromiso 100%&quot;&#13;&#10;ELSEIF ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) &gt;= 0.7 AND ([Calculation_275282549827969028])/ ([Calculation_275282549828112389]) &lt; 1 THEN &quot;Camino a lo esperado&quot; &#13;&#10;ELSE &quot;Necesita ajustar performance&quot;&#13;&#10;END' />
      </column>
