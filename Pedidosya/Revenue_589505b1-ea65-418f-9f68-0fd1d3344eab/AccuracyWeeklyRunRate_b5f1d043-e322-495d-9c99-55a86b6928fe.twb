    <worksheet name='Accuracy SUF by country'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0w2ytxy117jy7x18dzwhk037oovp' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w2ytxy117jy7x18dzwhk037oovp'>
            <column caption='date_month_string' datatype='string' name='[Calculation_220957906258993160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='acc_suf' datatype='real' default-format='p0.00%' name='[acc_listing_priority (copia) (copia) (copia) (copia) (copia)_1177972843692945413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/sum([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='colour_acc_suf' datatype='integer' default-format='p0.00%' name='[acc_suf (copia)_1242430613645066263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (ABS(IF sum([actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/sum([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;= 0 &#13;&#10;&#13;&#10;AND (ABS(IF SUM([actual_pos]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/SUM([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;= 0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_suf]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/SUM([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.05 &#13;&#10;&#13;&#10;AND (ABS(IF SUM([actual_suf]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/SUM([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;= 0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_pos]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_suf])-sum([rr_suf]))/SUM([actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.1 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[actual_pos]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_suf]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[country_id]' role='dimension' type='ordinal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='string' name='[date_dynamic (copia)_136515367550058497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_month_string (copia) (copia) (copia)_220957906259537931]' />
            </column>
            <column datatype='date' default-format='S' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='date_dynamic' datatype='string' name='[date_month_string (copia) (copia) (copia)_220957906259537931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_220957906258993160]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [date_month_string (copia)_220957906259300361]&#13;&#10;    WHEN &apos;Semester&apos; THEN [date_month_string (copia) (copia)_220957906259386378]&#13;&#10;END' />
            </column>
            <column caption='date_semester' datatype='string' name='[date_month_string (copia) (copia)_220957906259386378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[date_month]) &lt; 3 THEN &apos;H1&apos; ELSE &apos;H2&apos; END' />
            </column>
            <column caption='date_quarter' datatype='string' name='[date_month_string (copia)_220957906259300361]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[date_month]))' />
            </column>
            <column caption='dummy_axis_suf' datatype='real' name='[dummy_axis_ads_ls (copia) (copia) (copia) (copia) (copia) (copia) (copia) (copia)_1242430613595844618]' role='measure' type='quantitative'>
