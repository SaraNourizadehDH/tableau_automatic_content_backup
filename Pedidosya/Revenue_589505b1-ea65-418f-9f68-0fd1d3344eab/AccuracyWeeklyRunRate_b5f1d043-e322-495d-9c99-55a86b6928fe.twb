              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='acc_ncr' datatype='real' default-format='p0.00%' name='[acc_listing_priority (copia) (copia) (copia) (copia) (copia) (copia) (copia)_1177972843692961799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='colour_acc_ncr' datatype='integer' default-format='p0.00%' name='[acc_ncr (copia)_1242430613645041683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;= 0&#13;&#10;&#13;&#10;AND (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;=0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.05&#13;&#10;&#13;&#10;AND &#13;&#10;&#13;&#10;(ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;= 0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]+[rr_pos]+[rr_suf]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority]+[actual_pos]+[actual_suf])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.1 THEN 2&#13;&#10;&#13;&#10;END' />
            </column>
