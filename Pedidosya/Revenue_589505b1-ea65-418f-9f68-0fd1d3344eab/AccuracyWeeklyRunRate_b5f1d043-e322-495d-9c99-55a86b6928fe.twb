      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_EAAF0063EE7F4C11A16C70A37587719D]' role='measure' type='quantitative' />
      <column caption='colour_acc_ads_local_stores' datatype='integer' default-format='p0.00%' name='[acc_ads_local_stores (copia)_1242430613644955663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (ABS(IF SUM([actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores])+SUM([rr_ads_local_stores]))/SUM([actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END))&gt;=0  &#13;&#10;&#13;&#10;AND (ABS(IF SUM([actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores])+SUM([rr_ads_local_stores]))/SUM([actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END))&lt;= 0.05  THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores])+SUM([rr_ads_local_stores]))/SUM([actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END))&gt;0.05  &#13;&#10;&#13;&#10;AND (ABS(IF SUM([actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores])+SUM([rr_ads_local_stores]))/SUM([actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END))&lt;= 0.1  THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores])+SUM([rr_ads_local_stores]))/SUM([actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END))&gt;0.1  &#13;&#10;&#13;&#10;THEN 2&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='colour_acc_feat_prod' datatype='integer' default-format='p0.00%' name='[acc_feat_prod (copia)_1242430613645008912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS(IF sum([actual_featured_products])&gt;0 THEN&#13;&#10;&#13;&#10;&#13;&#10;(SUM([actual_featured_products])-sum([rr_featured_products]))/sum([actual_featured_products])&#13;&#10;&#13;&#10;ELSE 0 END) &gt;=0 &#13;&#10;&#13;&#10;AND&#13;&#10;&#13;&#10;ABS(IF sum([actual_featured_products])&gt;0 THEN&#13;&#10;&#13;&#10;&#13;&#10;(SUM([actual_featured_products])-sum([rr_featured_products]))/sum([actual_featured_products])&#13;&#10;&#13;&#10;ELSE 0 END) &lt;=0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF ABS(IF sum([actual_featured_products])&gt;0 THEN&#13;&#10;&#13;&#10;&#13;&#10;(SUM([actual_featured_products])-sum([rr_featured_products]))/sum([actual_featured_products])&#13;&#10;&#13;&#10;ELSE 0 END) &gt;0.05  &#13;&#10;&#13;&#10;AND &#13;&#10;&#13;&#10;ABS(IF sum([actual_featured_products])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_featured_products])-sum([rr_featured_products]))/sum([actual_featured_products])&#13;&#10;&#13;&#10;ELSE 0 END) &lt;=0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF ABS(IF sum([actual_featured_products])&gt;0 THEN&#13;&#10;&#13;&#10;&#13;&#10;(SUM([actual_featured_products])-sum([rr_featured_products]))/sum([actual_featured_products])&#13;&#10;&#13;&#10;ELSE 0 END) &gt;0.1 THEN 2&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='colour_acc_joker' datatype='integer' default-format='p0.00%' name='[acc_joker (copia)_1242430613645021201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (ABS(IF SUM([actual_joker]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_joker])-sum([rr_joker]))/SUM([actual_joker])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;=0&#13;&#10;&#13;&#10;AND&#13;&#10;&#13;&#10;(ABS(IF SUM([actual_joker]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_joker])-sum([rr_joker]))/SUM([actual_joker])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;=0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_joker]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_joker])-sum([rr_joker]))/SUM([actual_joker])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;0.05&#13;&#10;&#13;&#10;AND&#13;&#10;&#13;&#10;(ABS(IF SUM([actual_joker]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_joker])-sum([rr_joker]))/SUM([actual_joker])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;=0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF SUM([actual_joker]) &gt; 0 THEN&#13;&#10;&#13;&#10;(SUM([actual_joker])-sum([rr_joker]))/SUM([actual_joker])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.1 THEN 2&#13;&#10;&#13;&#10;END' />
