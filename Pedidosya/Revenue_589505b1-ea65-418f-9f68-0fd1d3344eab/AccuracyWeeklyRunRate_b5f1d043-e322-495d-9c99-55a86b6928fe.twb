              <calculation class='tableau' formula='IF (ABS(IF sum([actual_listing_priority]+[actual_ads_local_stores])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_listing_priority]+[actual_ads_local_stores])-sum([rr_listing_priority]+[rr_ads_local_stores]))/sum([actual_listing_priority]+[actual_ads_local_stores])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;= 0 &#13;&#10;&#13;&#10;AND (ABS(IF sum([actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_listing_priority])-sum([rr_listing_priority]))/sum([actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END))&lt;=0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF sum([actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_listing_priority])-sum([rr_listing_priority]))/sum([actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END))&gt;0.05 &#13;&#10;&#13;&#10;AND&#13;&#10;&#13;&#10;(ABS(IF sum([actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_listing_priority])-sum([rr_listing_priority]))/sum([actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END))&lt;= 0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF sum([actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_listing_priority])-sum([rr_listing_priority]))/sum([actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END))&gt;0.1 THEN 2&#13;&#10;&#13;&#10;END' />
