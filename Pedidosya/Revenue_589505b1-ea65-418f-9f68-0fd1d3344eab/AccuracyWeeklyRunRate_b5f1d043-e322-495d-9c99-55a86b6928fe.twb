    <worksheet name='Accuracy by week Ads'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0w2ytxy117jy7x18dzwhk037oovp' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w2ytxy117jy7x18dzwhk037oovp'>
            <column caption='date_month_string' datatype='string' name='[Calculation_220957906258993160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='acc_ncr_ads' datatype='real' default-format='p0.00%' name='[acc_listing_priority (copia) (copia) (copia) (copia) (copia) (copia)_1177972843692953606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='colour_acc_ncr_ads' datatype='integer' default-format='p0.00%' name='[acc_ncr_ads (copia)_1242430613645049876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;= 0&#13;&#10;&#13;&#10;AND (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;= 0.05 THEN 0&#13;&#10;&#13;&#10;ELSEIF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt;0.05&#13;&#10;&#13;&#10;AND &#13;&#10;&#13;&#10;(ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END)) &lt;= 0.1 THEN 1&#13;&#10;&#13;&#10;ELSEIF (ABS(IF&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&gt;0 THEN&#13;&#10;&#13;&#10;(SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])-&#13;&#10;SUM([rr_ads_local_stores]+[rr_featured_products]+[rr_joker]+[rr_listing_priority]))&#13;&#10;/&#13;&#10;SUM([actual_ads_local_stores]+[actual_featured_products]+[actual_joker]+[actual_listing_priority])&#13;&#10;&#13;&#10;ELSE 0 END)) &gt; 0.1 THEN 2&#13;&#10;&#13;&#10;END' />
