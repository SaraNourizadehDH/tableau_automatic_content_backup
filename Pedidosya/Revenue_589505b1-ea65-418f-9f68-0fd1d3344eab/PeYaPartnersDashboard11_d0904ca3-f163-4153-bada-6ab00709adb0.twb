            <column caption='Action - KW' datatype='string' name='[GoldVIP CPC Action (copia)_1633399305875746827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  DAY(TODAY())&lt;10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Tuviste muy buenos resultados! Aumenta tu presupuesto!&quot; &#13;&#10;ELSEIF DAY(TODAY())&gt;=10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Tuviste muy buenos resultados! Renueva tu prespuesto!&quot;&#13;&#10;ELSE &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot;&#13;&#10;END' />
            </column>
            <column caption='Show clicks billed-KW' datatype='integer' name='[Show clicks billed (copia)_1633399305875922956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [GoldVIP CPC Action (copia)_1633399305875746827]= &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot; then [clicks_billed] end' />
