          <datasource-dependencies datasource='federated.0m5jyfv1sq5igl10j7exl0dl650j'>
            <column caption='Action - GV' datatype='string' name='[Calculation_1633399305189601283]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  DAY(TODAY())&lt;10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Tuviste muy buenos resultados! Aumenta tu presupuesto!&quot; &#13;&#10;ELSEIF DAY(TODAY())&gt;=10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Tuviste muy buenos resultados! Renueva tu prespuesto!&quot;&#13;&#10;ELSE &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot;&#13;&#10;END' />
            </column>
            <column caption='Show clicks billed-GV' datatype='integer' name='[Calculation_1633399305509175305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1633399305189601283]=&quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot; then [clicks_billed] end' />
            </column>
            <column caption='Display_sheet_cpc' datatype='boolean' name='[Display_sheet_joker (copia)_1458603396315627521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([clicks_billed]) then FALSE&#13;&#10;ELSE true&#13;&#10;end' />
