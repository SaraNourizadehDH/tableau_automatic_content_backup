            <column datatype='real' name='[budget_consumption]' role='measure' type='quantitative' />
            <column caption='Clicks Billed' datatype='integer' default-format='n#,##0;-#,##0' name='[clicks_billed]' role='measure' type='quantitative' />
            <column datatype='real' name='[cpc_roas]' role='measure' type='quantitative' />
