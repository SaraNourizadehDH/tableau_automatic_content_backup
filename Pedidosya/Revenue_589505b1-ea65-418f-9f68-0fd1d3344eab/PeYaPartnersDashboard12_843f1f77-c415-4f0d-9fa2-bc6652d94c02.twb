              <calculation class='tableau' formula='IF  DAY(TODAY())&lt;10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Aumenta tu presupuesto!&quot; &#13;&#10;ELSEIF DAY(TODAY())&gt;=10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Renueva tu presupuesto!&quot;&#13;&#10;ELSE &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot;&#13;&#10;END' />
            </column>
            <column caption='Display_sheet_cpc' datatype='boolean' name='[Display_sheet_joker (copia)_1458603396315627521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([clicks_billed]) then FALSE&#13;&#10;ELSE true&#13;&#10;end' />
