      <column caption='Action - DF -2' datatype='string' name='[Action - DF (copia)_2434758567006978049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [budget_consumption_joker]&gt;0.9 THEN &quot;Aumenta tu presupuesto!&quot; &#13;&#10;ELSE &quot;Tu inversión generó todas estas reórdenes!&quot;&#13;&#10;END' />
      </column>
      <column caption='Action - GV -2' datatype='string' name='[Action - GV (copia)_2434758566997426176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  DAY(TODAY())&lt;10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Aumenta tu presupuesto!&quot; &#13;&#10;ELSEIF DAY(TODAY())&gt;=10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Renueva tu presupuesto!&quot;&#13;&#10;ELSE &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot;&#13;&#10;END' />
      </column>
      <column caption='Action - KW -2' datatype='string' name='[Action - KW (copia)_2434758567009517573]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  DAY(TODAY())&lt;10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Aumenta tu presupuesto!&quot; &#13;&#10;ELSEIF DAY(TODAY())&gt;=10 AND [cpc_roas]&gt;3 AND [budget_consumption]&gt;0.9 THEN &quot;Renueva tu presupuesto!&quot;&#13;&#10;ELSE &quot;Tu inversión en ads generó esta cantidad de visitas al menú!&quot;&#13;&#10;END' />
