          <datasource-dependencies datasource='Parameters'>
            <column caption='GFV/GMV' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GFV Gross&quot;'>
              <calculation class='tableau' formula='&quot;GFV Gross&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1raxruh1jheixo135mfxa0gvi4on'>
            <column caption='AFV Calculated' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1020628265828388864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;&#13;&#10;    WHEN &apos;GMV Gross&apos; THEN &#13;&#10;&#13;&#10;IF SUM([confirmed_orders])&gt;0 &#13;&#10;THEN &#13;&#10;SUM([gmv_gross_EU])/SUM([confirmed_orders]) ELSE 0 END&#13;&#10;&#13;&#10;    WHEN &apos;GFV Gross&apos; THEN &#13;&#10;IF SUM([confirmed_orders])&gt;0 &#13;&#10;THEN &#13;&#10;SUM([gfv_gross_EU])/sum([confirmed_orders]) ELSE 0 END&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Pcg_CR' datatype='real' default-format='p0.00%' name='[Calculation_1366561069702836224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;GMV Gross&apos;    &#13;&#10;    THEN SUM( [comm_rev_EU])/SUM([gmv_gross_EU])&#13;&#10;&#13;&#10;    WHEN &apos;GFV Gross&apos;  &#13;&#10;    THEN SUM( [comm_rev_EU])/SUM([gfv_gross_EU])&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Take Rate' datatype='real' default-format='p0.00%' name='[Calculation_1366561069704404997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;GMV Gross&apos;    &#13;&#10;    THEN SUM( [comm_rev_EU]+[ncr_EU]+[discount_amount_paid_by_partner_EU]+[pos_price_actual_eu])/SUM([gmv_gross_EU])&#13;&#10;&#13;&#10;    WHEN &apos;GFV Gross&apos;  &#13;&#10;    THEN SUM( [comm_rev_EU]+[ncr_EU]+[discount_amount_paid_by_partner_EU]+[pos_price_actual_eu])/SUM([gfv_gross_EU])&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_453456243362365447]' role='measure' type='ordinal'>
