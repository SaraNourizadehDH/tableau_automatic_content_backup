    <worksheet name='Delta Ads as GMV by KA'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.1raxruh1jheixo135mfxa0gvi4on' />
          </datasources>
          <datasource-dependencies datasource='federated.1raxruh1jheixo135mfxa0gvi4on'>
            <column caption='tot_actual_ads_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_1199083457035407360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ncr_EU])/sum([gmv_gross_EU])' />
            </column>
            <column caption='KA Sub Category 2' datatype='string' name='[Calculation_881016733613572098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Key_Account_Sub_Category]=&quot;Global KA&quot; THEN  &quot;Global KA&quot;&#13;&#10;&#13;&#10;ELSEIF [Key_Account_Sub_Category]=&quot;National KA&quot; THEN  &quot;National KA&quot;&#13;&#10;&#13;&#10;ELSEIF [Key_Account_Sub_Category]=&quot;Large Chain&quot; THEN &quot;Large Chain&quot;&#13;&#10;ELSEIF [Key_Account_Sub_Category]=&quot;Local Hero&quot; THEN &quot;Local Hero&quot;&#13;&#10;&#13;&#10;ELSEIF  CONTAINS([Key_Account_Sub_Category],&quot;Long Tail&quot;) THEN &quot;Long Tail&quot;&#13;&#10;&#13;&#10;END' />
