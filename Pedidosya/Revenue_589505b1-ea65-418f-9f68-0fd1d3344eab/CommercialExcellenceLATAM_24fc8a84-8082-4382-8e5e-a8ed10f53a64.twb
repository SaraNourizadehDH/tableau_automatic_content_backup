      <aliases enabled='yes' />
      <column caption='Invitados' datatype='integer' name='[Calculation_1666050401251422212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [asistencia] = &quot;Si&quot; THEN 1&#13;&#10;&#13;&#10;ELSEIF [asistencia] = &quot;No&quot; THEN 1&#13;&#10;&#13;&#10;ELSEIF [asistencia] = &quot;Licencia&quot; THEN 1&#13;&#10;&#13;&#10;ELSEIF [asistencia] = &quot;Vacaciones | Casual Day&quot; THEN 1&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='Asistencias SI' datatype='integer' name='[Calculation_1666050401251504133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [asistencia]= &quot;Si&quot; THEN 1 END)' />
      </column>
      <column caption='Porcentaje Asistencia' datatype='real' name='[Calculation_1666050401251606534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1666050401251504133]/[Calculation_1666050401251422212]' />
      </column>
      <column caption='Cantidad Capacitaciones' datatype='integer' name='[Calculation_1666050401254125577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([nombre_capacitacion])' />
      </column>
      <column caption='Condición' datatype='string' name='[Calculation_275282549561376771]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF([Calculation_1666050401251504133]) / ([Calculation_1666050401251422212]) = 1 THEN &quot;Compromiso 100%&quot;&#13;&#10;ELSEIF([Calculation_1666050401251504133]) /([Calculation_1666050401251422212]) &gt;= 0.7 AND([Calculation_1666050401251504133]) /([Calculation_1666050401251422212]) &lt; 1 THEN &quot;Camino a lo esperado&quot;&#13;&#10;ELSE &quot;Necesita ajustar performance&quot;&#13;&#10;END' />
      </column>
      <column caption='Cálculo1' datatype='string' name='[Calculation_357473242716405761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Capacitaciones Canceladas' datatype='integer' name='[Calculation_357473242719875075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [asistencia] = &quot;Cancelada localmente&quot; THEN [nombre_capacitacion] END)' />
      </column>
      <column caption='camponull' datatype='integer' name='[Calculation_357473242728296453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[month]' />
      </column>
