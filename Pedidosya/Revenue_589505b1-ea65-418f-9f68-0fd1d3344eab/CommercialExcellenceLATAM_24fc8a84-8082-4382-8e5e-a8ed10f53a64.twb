          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000'>% compromiso por equipo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='base_asistencia_commercial_excellence (automated_tables_reports)' name='federated.0pi0t0e0s6zy1216h5o2u1131o2g' />
