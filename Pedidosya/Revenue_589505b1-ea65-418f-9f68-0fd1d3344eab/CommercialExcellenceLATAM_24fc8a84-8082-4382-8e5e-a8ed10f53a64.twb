              <zone fixed-size='84' forceUpdate='true' h='4842' id='138' is-fixed='true' type-v2='text' w='99112' x='444' y='6369'>
                <formatted-text>
                  <run bold='true' fontcolor='#e15759' fontname='Tableau Semibold' fontsize='11'>Consideraciones al explorar le tablero:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#767676' fontname='Tableau Light'>➜</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>E</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>l total de invitados y asistentes</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> se calcula sumando individualmente la cantidad de invitados de todas las capacitaciones y la cantidad de asistentes de todas las capacitaciones.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#767676' fontname='Tableau Light'>➜</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>El</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'> compromiso por equipo </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>mide el porcentaje de asistencia de los invitados a las capacitaciones por manager directo.</run>
                </formatted-text>
