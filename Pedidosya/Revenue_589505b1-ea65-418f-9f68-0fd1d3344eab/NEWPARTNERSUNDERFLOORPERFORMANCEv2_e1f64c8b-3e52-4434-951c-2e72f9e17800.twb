      <column caption='Filtro Base Plana OpenTime' datatype='string' name='[Calculation_381680076078063619]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [open_time] &lt; 0.6 THEN &quot;&lt; 60% Open Time&quot;&#13;&#10;ELSE &quot;&gt;= 60% Open Time&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Filtro Base Plana FW' datatype='string' name='[Calculation_381680076078772228]' role='dimension' type='nominal'>
