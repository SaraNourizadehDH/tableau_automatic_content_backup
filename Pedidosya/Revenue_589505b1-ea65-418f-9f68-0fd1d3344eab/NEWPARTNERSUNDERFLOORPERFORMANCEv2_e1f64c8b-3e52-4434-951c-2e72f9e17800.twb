            <column-instance column='[Country_Name]' derivation='None' name='[none:Country_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Fecha Corta (copia)_403635162467586059]' derivation='None' name='[none:Fecha Corta (copia)_403635162467586059:nk]' pivot='key' type='nominal' />
            <column-instance column='[Key_Account_Sub_Category]' derivation='None' name='[none:Key_Account_Sub_Category:nk]' pivot='key' type='nominal' />
