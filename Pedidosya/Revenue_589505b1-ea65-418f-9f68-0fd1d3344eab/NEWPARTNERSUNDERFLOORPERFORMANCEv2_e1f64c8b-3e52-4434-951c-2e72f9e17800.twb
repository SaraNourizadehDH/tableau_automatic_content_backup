            <column caption='Business Type' datatype='string' name='[business_type_description]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2008042528382373907]' derivation='CountD' name='[ctd:Calculation_2008042528382373907:qk]' pivot='key' type='quantitative' />
            <column caption='Franchise Id' datatype='string' name='[franchise_id]' role='dimension' type='nominal' />
            <column caption='Last Commission Rate' datatype='real' name='[last_commission_rate]' role='measure' type='quantitative' />
