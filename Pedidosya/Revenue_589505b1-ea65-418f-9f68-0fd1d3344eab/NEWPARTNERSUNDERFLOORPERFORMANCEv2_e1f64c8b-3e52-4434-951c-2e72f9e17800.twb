    <worksheet name='Under Floor Tabla'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0njmip315otede1dxjnxn02eesje' />
          </datasources>
          <datasource-dependencies datasource='federated.0njmip315otede1dxjnxn02eesje'>
            <column caption='%Partners Compliance ' datatype='real' name='[%Under Floor (copia)_403635162364678150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_403635162363097091])/[Calculation_298644952603426817]' />
            </column>
            <column caption='Account Source' datatype='string' name='[AccountSource]' role='dimension' type='nominal' />
            <column caption='SSU or Field' datatype='string' name='[Calculation_1428485528930852864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [AccountSource] = &quot;Self Sign Up&quot; THEN &quot;SSU&quot;&#13;&#10;ELSE &quot;Field&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Partners Under Floor' datatype='integer' name='[Calculation_2008042528382373907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [type]=&apos;Under Floor&apos; then   [restaurant_id]END' />
            </column>
            <column caption='%Under Floor' datatype='real' name='[Calculation_2008042528383414296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2008042528382373907])/[Calculation_298644952603426817]' />
            </column>
            <column caption='Total New Partners' datatype='integer' name='[Calculation_298644952603426817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([restaurant_id])' />
            </column>
            <column caption='Partners Compliance' datatype='integer' name='[Calculation_403635162363097091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [type]=&apos;Over Floor&apos; or [type]=&apos;Equal Floor&apos; then   [restaurant_id]END' />
            </column>
            <column caption='Month Year' datatype='string' name='[Calculation_403635162426458119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT(DATENAME(&apos;month&apos;, [Month]), 3)) + &apos; &apos; + RIGHT(STR(YEAR([Month])), 2)' />
            </column>
            <column caption='Is Franchise' datatype='string' name='[Calculation_838795438236471296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [franchise_id]&#13;&#10;WHEN &quot;Not franchise&quot; THEN &quot;W/O Franchise&quot;&#13;&#10;ELSE &quot;With Franchise&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Is Must Have' datatype='string' name='[Calculation_838795438238384129]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Target_Partner]&#13;&#10;WHEN &quot;Must Have&quot; THEN &quot;With Must Have&quot;&#13;&#10;ELSE &quot;W/O Must Have&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
