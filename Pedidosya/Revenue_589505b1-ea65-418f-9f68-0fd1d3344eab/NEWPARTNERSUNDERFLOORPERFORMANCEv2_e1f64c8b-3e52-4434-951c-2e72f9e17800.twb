    <worksheet name='Performance Metrics Tabla'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ec0000' fontsize='12'>New Partners Under Floor Performance Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0njmip315otede1dxjnxn02eesje' />
          </datasources>
          <datasource-dependencies datasource='federated.0njmip315otede1dxjnxn02eesje'>
            <column caption='% 3 condiciones' datatype='real' name='[% Open time 60 ok (copia)_403635163276218381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Framework Compliance Day 30 (copia)_403635163275886604])/COUNTD([Calculation_2008042528382373907])' />
            </column>
            <column caption='% &lt;15 ordenes under floor' datatype='real' name='[&lt;15 ordenes under ok (copia)_2008042528748900396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2008042528572477475])/COUNTD([Calculation_2008042528382373907])' />
            </column>
            <column caption='Account Source' datatype='string' name='[AccountSource]' role='dimension' type='nominal' />
            <column caption='SSU or Field' datatype='string' name='[Calculation_1428485528930852864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [AccountSource] = &quot;Self Sign Up&quot; THEN &quot;SSU&quot;&#13;&#10;ELSE &quot;Field&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Partners Under Floor' datatype='integer' name='[Calculation_2008042528382373907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [type]=&apos;Under Floor&apos; then   [restaurant_id]END' />
            </column>
            <column caption='&lt;15 ordenes under ok' datatype='integer' name='[Calculation_2008042528572477475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Orders15] = &apos;Under 15 Orders&apos; AND [type] = &apos;Under Floor&apos; AND DATEDIFF(&apos;day&apos;, [first_date_online], DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [first_date_online]))) &gt; 15 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Open Time ok' datatype='integer' name='[Calculation_2008042528910422061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Open_time_60]=&apos;Under 60%&apos; and [type] =&apos;Under Floor&apos; AND DATEDIFF(&apos;day&apos;, [first_date_online], DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [first_date_online]))) &gt; 15 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Open time 60 ok' datatype='real' name='[Calculation_2008042528926003246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2008042528910422061])/COUNTD([Calculation_2008042528382373907])' />
            </column>
            <column caption='% FrameWork ' datatype='real' name='[Calculation_2008042528932716591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_246572085098311680])/COUNTD([Calculation_2008042528382373907])' />
            </column>
            <column caption='Framework Compliance Day 30' datatype='integer' name='[Calculation_246572085098311680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Framework_Compliance_Day_30_H2] = &quot;No&quot; and&#13;&#10;&#13;&#10;[type]=&apos;Under Floor&apos;&#13;&#10;&#13;&#10;THEN 1&#13;&#10;&#13;&#10;else 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Month Year' datatype='string' name='[Calculation_403635162426458119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT(DATENAME(&apos;month&apos;, [Month]), 3)) + &apos; &apos; + RIGHT(STR(YEAR([Month])), 2)' />
            </column>
            <column caption='Is Franchise' datatype='string' name='[Calculation_838795438236471296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [franchise_id]&#13;&#10;WHEN &quot;Not franchise&quot; THEN &quot;W/O Franchise&quot;&#13;&#10;ELSE &quot;With Franchise&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Is Must Have' datatype='string' name='[Calculation_838795438238384129]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Target_Partner]&#13;&#10;WHEN &quot;Must Have&quot; THEN &quot;With Must Have&quot;&#13;&#10;ELSE &quot;W/O Must Have&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='3 condiciones' datatype='integer' name='[Framework Compliance Day 30 (copia)_403635163275886604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Framework_Compliance_Day_30_H2] = &quot;No&quot; and [type]=&apos;Under Floor&apos; and [Open_time_60]=&apos;Under 60%&apos; and [Orders15]=&apos;Under 15 Orders&apos; &#13;&#10;&#13;&#10;and DATEDIFF(&apos;day&apos;, [first_date_online], DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [first_date_online]))) &gt; 15 THEN 1 ELSE 0 END' />
            </column>
            <column datatype='string' name='[Framework_Compliance_Day_30_H2]' role='dimension' type='nominal' />
