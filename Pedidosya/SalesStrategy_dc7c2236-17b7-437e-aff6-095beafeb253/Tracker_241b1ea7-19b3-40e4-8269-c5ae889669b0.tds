    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0j1daq11364xcl17wigcn08lkqvg' name='Consulta SQL personalizada1' type='text'><![CDATA[WITH last_closed_month AS (
  SELECT MAX(date_month) AS last_month_closed
  FROM `peya-food-and-groceries.automated_tables_reports.mhp_framework`
),

base_data AS (
  SELECT 
    f.*,
    l.last_month_closed AS current_month,
    DATE_ADD(f.date_month, INTERVAL 1 MONTH) AS next_month
  FROM `peya-food-and-groceries.automated_tables_reports.mhp_framework` f
  CROSS JOIN last_closed_month l
),

next_month_data AS (
  SELECT
    grid,
    date_month AS next_month,
    condiciones_no_cumple
  FROM `peya-food-and-groceries.automated_tables_reports.mhp_framework`
),

evaluated AS (
  SELECT 
    b.*,
    CASE 
      WHEN b.next_month >> b.current_month THEN 'Partner siendo evaluado actualmente'
      WHEN NOT EXISTS (
        SELECT 1 
        FROM next_month_data n
        WHERE n.grid = b.grid 
          AND n.next_month = b.next_month
      ) THEN 'SI'
      WHEN EXISTS (
        SELECT 1
        FROM next_month_data n
        WHERE n.grid = b.grid 
          AND n.next_month = b.next_month
          AND n.condiciones_no_cumple = 'Cumple'
      ) THEN 'SI'
      ELSE 'NO'
    END AS mejoro_al_mes_siguiente
  FROM base_data b
  WHERE b.date_month <<= b.current_month -- opcional, por claridad
)

SELECT *
FROM evaluated]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
      <relation connection='bigquery.0j1daq11364xcl17wigcn08lkqvg' name='mhp_tracker_wip' type='text'>SELECT&#13;
  m.*,&#13;
  DATE(t.full_date) AS month,&#13;
  dp.salesforce_id AS grid,&#13;
  g.gmv AS gmv,&#13;
  COALESCE(m.tier,&quot;&quot;) AS partner_tier,&#13;
  COALESCE(m.camada,&quot;&quot;) AS camada_v2,&#13;
  CASE&#13;
    WHEN m.peya_type != &quot;New&quot; THEN NULL&#13;
    ELSE m.peya_type&#13;
END&#13;
  AS peya_type_v2,&#13;
  dp.country.country_name AS country_name_v2,&#13;
  g.MHP,&#13;
FROM&#13;
  `peya-bi-tools-pro.il_core.fact_partners_monthly` t&#13;
LEFT JOIN&#13;
  `peya-bi-tools-pro.il_core.dim_partner` dp&#13;
ON&#13;
  dp.partner_id=t.restaurant_id&#13;
LEFT JOIN&#13;
  `peya-food-and-groceries.automated_tables_reports.GMV_preferente` g&#13;
ON&#13;
  DATE(t.full_date)=g.date_month&#13;
  AND dp.salesforce_id=g.salesforce_id&#13;
LEFT JOIN (&#13;
  SELECT&#13;
    mhp.*,&#13;
    pm.account_owner AS acc_owner&#13;
  FROM&#13;
    `peya-food-and-groceries.automated_tables_reports.mhp_tracker_v1` mhp&#13;
  LEFT JOIN&#13;
    `peya-bi-tools-pro.il_core.fact_partners_monthly` pm&#13;
  ON&#13;
    DATE(pm.full_date)=mhp.date_month&#13;
    AND pm.restaurant_id=mhp.partner_id&#13;
  WHERE&#13;
    peya_type=&apos;New&apos;) m&#13;
ON&#13;
  DATE(t.full_date)=m.date_month&#13;
  AND dp.salesforce_id=m.salesforce_id</relation>
      <relation connection='bigquery.0j1daq11364xcl17wigcn08lkqvg' name='Consulta SQL personalizada1' type='text'><![CDATA[WITH last_closed_month AS (
