  <column caption='SF ID (First Date)' datatype='string' name='[BRAND (First Date) (copy)_591660412786139139]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [acquisition_date (mhp_tracker_wip)] = [month] then ([salesforce_id]) else NULL END' />
  </column>
  <column caption='Benchmark Comm Rate' datatype='real' name='[Benchmark GFV (copia)_1130403521420107777]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [peya_type]=&quot;New&quot; then [commission_floor] else [avg_comm_rate_q1] END' />
  </column>
  <column caption='Benchmark GFV' datatype='real' name='[Benchmark Orders (copia)_1130403521419120640]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [peya_type]=&quot;New&quot; then 0 else [avg_gfv_q1] END' />
  </column>
  <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
  <column caption='Brands (PM) ' datatype='string' name='[Brands (ACT) (copy)_484137000716222471]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) then ([Brand]) END' />
  </column>
  <column caption='Inc. Orders (ACT)' datatype='real' name='[Brands (ACT) (copy)_484137000721920010]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [date_month] = [Parameters].[Parameter 1] then ([diff_orders]) END' />
  </column>
  <column caption='Inc. Orders (PM)' datatype='real' name='[Brands (PM)  (copy)_484137000722149387]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) then ([diff_orders]) END' />
  </column>
  <column aggregation='None' caption='CPO (bin)' datatype='integer' name='[CPO (w/o BF) (copy) (bin)]' role='dimension' type='quantitative'>
    <calculation class='bin' decimals='-2' formula='[CPO (w/o BF) (copy)_191684509245153281]' peg='0' size='0.25' />
  </column>
  <column caption='CPO' datatype='real' name='[CPO (w/o BF) (copy)_191684509245153281]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([diff_comm_revenue])/([diff_orders])' />
  </column>
  <column caption='CVR (zombie low order)' datatype='real' name='[CVR (zombie_low_order)]' role='measure' type='quantitative' />
  <column aggregation='None' caption='CVR3 (bin) (MPR)' datatype='integer' name='[CVR3 (bin) (copy)_1512365056045785100]' role='dimension' type='quantitative'>
    <calculation class='bin' decimals='-2' formula='[CVR]' peg='0' size='0.08' />
  </column>
  <column aggregation='None' datatype='integer' name='[CVR3 (bin)]' role='dimension' type='quantitative'>
    <calculation class='bin' decimals='-2' formula='[CVR]' peg='0' size='0.01' />
  </column>
  <column datatype='real' name='[CVR]' role='measure' type='quantitative' />
  <column caption='AFV' datatype='real' name='[Calculation_1130403521438797827]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[gfv_gross_without_subsidies_eu]/[confirmed_orders]' />
  </column>
  <column caption='Commission Rate' datatype='real' name='[Calculation_1181069063002173440]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([commission_revenue_without_subsidies_eu])/sum([gfv_gross_without_subsidies_eu])' />
  </column>
  <column caption='Diff AFV' datatype='real' name='[Calculation_1212031263274782723]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([diff_gfv])/sum([diff_orders]))' />
  </column>
  <column caption='AVG Orders' datatype='real' name='[Calculation_1281837071787974656]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([diff_orders])/COUNT([salesforce_id])' />
  </column>
  <column caption='GMV MHP %' datatype='real' name='[Calculation_1415256199153930240]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum(IF [MHP] = TRUE THEN [gmv] ELSE 0 END)/sum([gmv])' />
  </column>
  <column caption='Distinct date' datatype='integer' name='[Calculation_1484780522431598592]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([first_date_online])' />
  </column>
  <column caption='is_first_date' datatype='integer' name='[Calculation_1484780522433069057]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [acquisition_date (mhp_tracker_wip)] = [month] AND [peya_type_v2] = &quot;New&quot; then 1 ELSE 0 END' />
  </column>
  <column caption='VFD_flag' datatype='boolean' name='[Calculation_1495195141597315072]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [vfd]&gt;0 THEN TRUE ELSE FALSE END' />
  </column>
  <column caption='VFD Penetration' datatype='real' name='[Calculation_1495195141597757441]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if [Calculation_1495195141597315072] = TRUE then 1 END)/COUNT([Calculation_1495195141597315072])' />
  </column>
  <column caption='Zombie Count' datatype='integer' name='[Calculation_1512365055943991296]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [confirmed_orders] = 0 THEN 1 ELSE 0 END' />
  </column>
  <column caption='FOM (param)' datatype='boolean' name='[Calculation_1512365056018874371]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [acquisition_date (mhp_tracker_wip)] = [Parameters].[Parameter 1] THEN TRUE ELSE FALSE END' />
  </column>
  <column caption='Date (=Param)' datatype='boolean' name='[Calculation_1512365056019890180]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [date_month]=[Parameters].[Parameter 1] THEN TRUE ELSE FALSE END' />
  </column>
  <column caption='Date YTD (&lt;=Param)' datatype='boolean' name='[Calculation_1512365056020185093]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF ([date_month]&lt;=[Parameters].[Parameter 1] AND [date_month]&gt;= DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) THEN TRUE ELSE FALSE END' />
  </column>
  <column caption='Inc. Orders RR' datatype='real' name='[Calculation_1533475722770145281]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Brands (ACT) (copy)_484137000721920010] ) + SUM([Brands (ACT) (copy)_484137000721920010] ) / DAY(TODAY()) * DATEPART(&apos;day&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY())))' />
  </column>
  <column caption='Index' datatype='integer' name='[Calculation_1695042325801369603]' role='measure' type='ordinal'>
    <calculation class='tableau' formula='INDEX()'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='ADS/GMV' datatype='real' name='[Calculation_2011983195672494080]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='Sum([ads])/SUM([gmv_gross])' />
  </column>
  <column caption='VFD/GMV' datatype='real' name='[Calculation_2011983195672973313]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([VFD (mhp_tracker_wip)])/SUM([gmv_gross])' />
  </column>
  <column caption='count_ids' datatype='integer' name='[Calculation_2191282708887973890]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([grid (Consulta SQL personalizada1)])' />
  </column>
  <column caption='Bin Mapped Orders' datatype='string' name='[Calculation_2220274645369032707]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF ([monthly_mapped_orders]=0) then &quot;Sin Órdenes Mapeadas&quot;&#13;&#10;elseif ([monthly_mapped_orders]&lt;31) then &quot;&lt; 30 Órdenes Mapeadas&quot;&#13;&#10;else &quot;&gt; 30 Órdenes Mapeadas&quot; END' />
  </column>
  <column caption='% Mapped Orders' datatype='string' name='[Calculation_2220274645372084228]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if([vs_mapped]&lt; 0.3) then &quot;0-30%&quot;&#13;&#10;elseif ([vs_mapped]&gt;0.3 and [vs_mapped]&lt;0.7) then &quot;30-70%&quot;&#13;&#10;else &quot;&gt; 70%&quot;&#13;&#10;end' />
  </column>
  <column caption='Low Preformer Count' datatype='integer' name='[Calculation_2220274645422948358]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([salesforce_id (zombie_low_order)])' />
  </column>
  <column caption='% Low Preformer' datatype='real' name='[Calculation_2220274645423042567]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_2220274645422948358]/countd([salesforce_id])' />
  </column>
  <column caption='Total Investment' datatype='real' name='[Calculation_324540663201390592]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([diff_comm_revenue])+IFNULL(SUM([brand_fee_eu]),0)' />
  </column>
  <column caption='Incremental CPO' datatype='real' name='[Calculation_324540663201480705]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([Calculation_324540663201390592])/sum([diff_orders])' />
  </column>
  <column caption='Orders (ACT)' datatype='real' name='[Calculation_484137000715345925]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [date_month] = [Parameters].[Parameter 1] then [diff_orders] END' />
  </column>
  <column caption='Brands (ACT)' datatype='string' name='[Calculation_484137000715583494]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [date_month] = [Parameters].[Parameter 1] then ([Brand]) END' />
  </column>
  <column caption='Delta Brands (#)' datatype='integer' name='[Calculation_484137000716832776]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([Calculation_484137000715583494])-COUNTD([Brands (ACT) (copy)_484137000716222471])' />
  </column>
  <column caption='AVG CVR' datatype='real' name='[Calculation_5080341914519236608]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([confirmed_orders])/sum([sessions])' />
  </column>
  <column caption='Zombie?' datatype='boolean' name='[Calculation_519039909900750848]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [confirmed_orders] = 0 then TRUE else FALSE END' />
  </column>
  <column caption='Acq/Users' datatype='real' name='[Calculation_716072397129265154]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([acquisitions])/sum([users])' />
  </column>
  <column caption='Detail Level' datatype='string' name='[Calculation_716072397205454851]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF   [Parameters].[Parámetro Overview (copy)] = &quot;Brand&quot; then [Brand]&#13;&#10;ELSEIF [Parameters].[Parámetro Overview (copy)] = &quot;Country&quot; then [country_name]&#13;&#10;ELSEIF  [Parameters].[Parámetro Overview (copy)] = &quot;Partner Name&quot; then [partner_name]&#13;&#10;END' />
  </column>
  <column caption='Total Partners' datatype='integer' name='[Calculation_812055351661916160]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [salesforce_id] = NULL THEN 0 ELSE 1 END' />
  </column>
  <column caption='Plus Orders %' datatype='real' name='[Calculation_812055351672549377]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([PLUS_ORDERS_FOOD])/SUM([confirmed_orders])' />
  </column>
  <column caption='Plus Penetration' datatype='real' name='[Calculation_812055351672954882]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if [is_plus]=TRUE then 1 else 0 end)/COUNTD([salesforce_id])' />
  </column>
  <column caption='Espaciador' datatype='integer' datatype-customized='true' name='[Calculation_812055351674302467]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='INT(NULL)' />
  </column>
  <column caption='CPO (w/o BF)' datatype='real' name='[Calculation_868068877488742401]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([diff_comm_revenue])/SUM([diff_orders])' />
  </column>
  <column caption='CPA' datatype='real' name='[Calculation_868068877491089410]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([diff_comm_revenue])/SUM([acquisitions])' />
  </column>
  <column caption='Revenue per Partner' datatype='real' name='[Calculation_924645360921968640]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([commission_revenue_without_subsidies_eu])/COUNT([GRID_OR_FRANCHISE])' />
  </column>
  <column aggregation='CountD' caption='Plus' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_966585120486240261]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [is_plus] Then &quot;YES&quot; ELSE &quot;NO&quot; END' />
  </column>
  <column caption='Benchmark Orders' datatype='real' name='[Calculation_972496059195449344]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [peya_type]=&quot;New&quot; then 0 else [avg_orders_q1] END' />
  </column>
  <column caption='Parametro Overview' datatype='real' name='[Calculation_972496059247116289]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='case [Parameters].[Peya Type Parámetro]&#13;&#10;when &quot;Inc. Orders&quot; then [diff_orders]&#13;&#10;when &quot;Inc. Comm. Revenue&quot; then [diff_comm_revenue]&#13;&#10;when &quot;Inc. GFV&quot; then [diff_gfv]&#13;&#10;When &quot;Confirmed Orders&quot; then [confirmed_orders]&#13;&#10;WHEN &quot;New Partners&quot; then [Calculation_1484780522433069057]&#13;&#10;END' />
