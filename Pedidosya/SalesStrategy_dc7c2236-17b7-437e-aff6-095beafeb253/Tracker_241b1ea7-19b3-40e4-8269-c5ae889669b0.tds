          AND n.next_month = b.next_month
          AND n.condiciones_no_cumple = 'Cumple'
      ) THEN 'SI'
      ELSE 'NO'
    END AS mejoro_al_mes_siguiente
  FROM base_data b
  WHERE b.date_month <<= b.current_month -- opcional, por claridad
)

SELECT *
FROM evaluated]]></relation>
