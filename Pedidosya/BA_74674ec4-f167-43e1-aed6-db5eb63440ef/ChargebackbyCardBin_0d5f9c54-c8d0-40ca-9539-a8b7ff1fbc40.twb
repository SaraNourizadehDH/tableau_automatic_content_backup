ns&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;RU&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;GE&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSE &quot;Foreign Bins&quot;&#13;&#10;END' />
