      <column caption='Calculation1' datatype='string' name='[Calculation_975873749398450197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &quot;No&quot; then &quot;Success Rate evolution by month&quot;&#13;&#10;ELSEIF  [Parameters].[Parameter 8] = &quot;Yes&quot; then &quot;Success Rate definition&quot;&#13;&#10;END' />
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_975873749404545046]' role='dimension' type='nominal'>
