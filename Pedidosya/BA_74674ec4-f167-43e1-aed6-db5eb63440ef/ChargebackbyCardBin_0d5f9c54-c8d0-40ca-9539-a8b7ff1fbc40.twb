    <worksheet name='CBK BINS'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>&lt;</run>
            <run bold='true' fontalignment='1' fontsize='12'>[Parameters].[Data by (copy)_2075315009921875969]</run>
            <run bold='true' fontalignment='1' fontsize='12'><![CDATA[> Chargeback Rate by Order Date - Card Bin: <]]></run>
            <run bold='true' fontalignment='1' fontsize='12'>[federated.1bdmj9203zipk518p49w00memaks].[none:CardBin:nk]</run>
            <run bold='true' fontalignment='1' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Calendar+ (user_nicolas_alvarez)' name='federated.1bdmj9203zipk518p49w00memaks' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Data by CBK' datatype='string' name='[Data by (copy)_2075315009921875969]' param-domain-type='list' role='measure' type='nominal' value='&quot;Amount&quot;'>
              <calculation class='tableau' formula='&quot;Amount&quot;' />
            </column>
            <column caption='Cbk by' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Payment Date&quot;'>
              <calculation class='tableau' formula='&quot;Payment Date&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bdmj9203zipk518p49w00memaks'>
            <column datatype='real' name='[AmountCbkOrderEU]' role='measure' type='quantitative' />
            <column caption='Amount Cbk Payment EU' datatype='real' name='[AmountCbkPaymentEU]' role='measure' type='quantitative' />
            <column datatype='real' name='[AmountCbkincomingEU]' role='measure' type='quantitative' />
            <column caption='Amount Payments' datatype='real' name='[AmountPayments]' role='measure' type='quantitative' />
            <column caption='Gross Cbk Rate AMT' datatype='real' name='[Calculation_1303229159686975516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 12] = &quot;Payment Date&quot; then [Gross Cbk Rate QTY (copy)_443886053670232064]&#13;&#10;ELSEIF [Parameters].[Parameter 12] = &quot;Order Date&quot; then [Gross Cbk Rate AMT payment date (copy)_1303229159686520858]&#13;&#10;ELSEIF  [Parameters].[Parameter 12] = &quot;Incoming Date&quot; then [Gross Cbk Rate AMT order date (copy)_1303229159686684699]&#13;&#10;END' />
            </column>
            <column caption='Gross Cbk Rate' datatype='real' name='[Calculation_443886053748293633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Data by (copy)_2075315009921875969] = &quot;Amount&quot; then [Calculation_1303229159686975516]&#13;&#10;ELSEIF  [Parameters].[Data by (copy)_2075315009921875969] = &quot;Quantity&quot; then [Gross Cbk Rate AMT (copy)_1303229159687585823]&#13;&#10;END' />
            </column>
            <column caption='Is Peya Bin' datatype='string' name='[Calculation_929148928466604032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country (Custom SQL Query7)] = &quot;UY&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;CL&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;AR&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;PE&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;VE&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;PA&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;EC&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;PY&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;CR&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;BO&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;RD&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;SV&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;NI&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;GT&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;HN&quot; then &quot;PeYa Bins&quot;&#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;CA&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;US&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;CO&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;ES&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;FR&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;IT&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;RU&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSEIF   [country (Custom SQL Query7)] = &quot;GE&quot; then &quot;Other Acct Bins&quot;  &#13;&#10;ELSE &quot;Foreign Bins&quot;&#13;&#10;END' />
            </column>
            <column caption='Gross Cbk Rate QTY payment Date' datatype='real' name='[Calculation_987414222781337615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chargeback_status] = &quot;CBK&quot; then [payment_id] END)&#13;&#10;/&#13;&#10;SUM([QtyTransactions])' />
            </column>
            <column datatype='string' name='[CardBin]' role='dimension' type='nominal' />
