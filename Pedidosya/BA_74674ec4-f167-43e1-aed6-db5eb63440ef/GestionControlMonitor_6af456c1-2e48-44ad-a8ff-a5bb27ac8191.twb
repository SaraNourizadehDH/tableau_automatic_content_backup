      <column caption='user contact' datatype='integer' name='[Calculation_1419759812457783296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([userID (Contactos_Outlier)])' />
      </column>
      <column caption='Qty Antifraud' datatype='integer' name='[Calculation_1419759812487688193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Ticket])' />
      </column>
      <column caption='resolución outlier' datatype='string' name='[Calculation_709316975495053318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [resolucion]= &quot;SE ACTIVA&quot; &#13;&#10;&#13;&#10;then &quot;Active&quot; &#13;&#10;&#13;&#10;Else &quot;Others&quot;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Contact Rate Outlier' datatype='real' name='[Calculation_749286419693649920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([userID (Consulta SQL personalizada6)])/SUM([total_user])' />
      </column>
      <column caption='Cbk rate de ticket antifraud' datatype='real' name='[Calculation_749286419759898625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([userID (Consulta SQL personalizada1)])/COUNT(IF [ticketResolution] = &quot;Se limpió&quot; THEN [userID]END)' />
      </column>
      <column caption='ticket resolution ' datatype='string' name='[Calculation_765330494136606722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [ticketResolution (jira_others_tickets)]= &quot;Testeo de tarjeta&quot; &#13;&#10;or  [ticketResolution (jira_others_tickets)]= &quot;Testeo de tarjetas&quot;&#13;&#10;then &quot;Testeo de tarjeta&quot; &#13;&#10;ELSEIF [ticketResolution (jira_others_tickets)]= &quot;Usuario Externo&quot; &#13;&#10;or  [ticketResolution (jira_others_tickets)]= &quot;Usuario externo&quot;&#13;&#10;then &quot;Usuario externo&quot;ELSEIF [ticketResolution (jira_others_tickets)]= &quot;Consulta Caso&quot; &#13;&#10;or  [ticketResolution (jira_others_tickets)]= &quot;Consulta caso&quot;&#13;&#10;then &quot;Consulta caso&quot;  &#13;&#10;ELSEIF [ticketResolution (jira_others_tickets)]= &quot;Consulta Caso&quot; &#13;&#10;or  [ticketResolution (jira_others_tickets)]= &quot;Consulta caso&quot;&#13;&#10;then &quot;Consulta caso&quot; &#13;&#10;ELSEIF [ticketResolution (jira_others_tickets)]= &quot;Alerta AML&quot; &#13;&#10;or  [ticketResolution (jira_others_tickets)]= &quot;ATO&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Caso Gris&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Consulta por PS&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Contracargos&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Fraude Confirmado&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Incidencia&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Prueba&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Recupero&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Sin info&quot;&#13;&#10;or [ticketResolution (jira_others_tickets)]= &quot;Test&quot;&#13;&#10;&#13;&#10;then &quot;Otros&quot; &#13;&#10;&#13;&#10;Else [ticketResolution (jira_others_tickets)] &#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='contacto/rechazo' datatype='real' name='[Calculation_951103980180897797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([userID])/sum([reject_user])' />
      </column>
