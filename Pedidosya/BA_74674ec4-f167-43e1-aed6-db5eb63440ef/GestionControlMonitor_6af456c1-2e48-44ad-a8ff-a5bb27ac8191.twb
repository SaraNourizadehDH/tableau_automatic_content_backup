    <datasource caption='Calendar+ (group_team_fraud)' inline='true' name='federated.1psozuv0ns9sbp16o3ss9143zi3j' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1hx5dvv1xxljs711itzm106qmvqr'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_nicolas_alvarez' server-oauth='' username='virginia.burgueno@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada5' type='text'>SELECT *&#13;
FROM `peya-fraud-and-fintech.user_nicolas_alvarez.Calendar`&#13;
 where date &gt;&gt;= &quot;2022-01-01&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada5' type='text'>SELECT *&#13;
FROM `peya-fraud-and-fintech.user_nicolas_alvarez.Calendar`&#13;
 where date &gt;&gt;= &quot;2022-01-01&quot;</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada6' type='text'>select&#13;
fechaGestion,&#13;
Mail,&#13;
userID,&#13;
countryName,&#13;
resolucion&#13;
from `peya-fraud-and-fintech.user_virginia_burgueno.Contactos_Outlier`</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada' type='text'>select&#13;
Date(rs.date_created) as date_created,&#13;
ps.country,&#13;
count (distinct rs.user_id) as total_user&#13;
&#13;
&#13;
from `peya-data-origins-pro.cl_fraud_risk.scoring` as rs&#13;
inner join `peya-data-origins-pro.cl_fraud_risk.purchase_scoring` as ps on rs.scoring_id=ps.scoring_id&#13;
&#13;
&#13;
where&#13;
rs.reason =&apos;outlier_suspect&apos;&#13;
and date(rs.date_created)&gt;&gt;=(&apos;2022-06-01&apos;)&#13;
&#13;
group by 1,2</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada3' type='text'>select&#13;
date_trunc(date(transactionDate),month) as month_transaction,&#13;
countryName,&#13;
count(distinct userID) as reject_user&#13;
from `peya-fraud-and-fintech.group_team_fraud.fraud_prevention_scoring_intern` as si&#13;
&#13;
&#13;
where&#13;
result= &quot;REJECT&quot;&#13;
&#13;
group by 1,2</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='jira_antifraud_tickets' table='[peya-fraud-and-fintech.group_team_fraud].[jira_antifraud_tickets]' type='table' />
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada2' type='text'>with c as (select&#13;
distinct ta.userID,&#13;
min(payment_id) as payment_id&#13;
&#13;
&#13;
from `peya-fraud-and-fintech.group_team_fraud.jira_antifraud_tickets` as ta&#13;
inner join `peya-bi-tools-pro.il_payments.fact_payments_transaction` as t on ta.userID=t.user_id&#13;
&#13;
&#13;
where&#13;
date(t.date_created)between date(analysisdate) and date_add(analysisdate, INTERVAL 7 day)&#13;
and date(date_created)&gt;&gt;= (&apos;2022-01-01&apos;)&#13;
and ta.ticketResolution=&quot;Se limpió&quot;&#13;
&#13;
group by 1)&#13;
&#13;
select distinct&#13;
Date(date_created) as  order_date,&#13;
c.userid,&#13;
c.payment_id,&#13;
(payment_amount/rate_eu) as eu_amount,&#13;
co.country_name&#13;
&#13;
from c&#13;
inner join `peya-bi-tools-pro.il_payments.fact_payments_transaction` as t on c.payment_id=t.payment_id&#13;
inner join `peya-bi-tools-pro.il_core.dim_country` as co on t.country_id=co.country_id&#13;
inner join `peya-fraud-and-fintech.group_team_fraud.currency_exchange_fraud_op` as cu on t.country_id=cu.country_id and date_trunc(date(date_created),month)= cu.date_month&#13;
&#13;
where&#13;
date(date_created)&gt;&gt;=(&apos;2022-01-01&apos;)</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada1' type='text'>select&#13;
distinct ta.userID,&#13;
count(distinct purchaseID) as qty_cbk,&#13;
sum(cbk.amountEU) as total_monto,&#13;
(true) as cbk&#13;
&#13;
from `peya-fraud-and-fintech.group_team_fraud.jira_antifraud_tickets` as ta&#13;
inner join `peya-fraud-and-fintech.group_team_fraud.fraud_prevention_scoring_intern` as cbk on cast(ta.userID as string)=cbk.userID&#13;
&#13;
&#13;
where&#13;
date(cbk.transactionDate)&gt;&gt;= date(analysisdate)&#13;
and ta.ticketResolution=&quot;Se limpió&quot;&#13;
and cbk.IsChargeback is true&#13;
and date(analysisDate)&gt;&gt;=(&quot;2022-09-01&quot;)&#13;
&#13;
group by 1</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='Consulta SQL personalizada4' type='text'>with c as (select&#13;
date_trunc(date(transactionDate),month) as month_transaction,&#13;
countryName,&#13;
count(distinct userID) as reject_user&#13;
&#13;
from `peya-fraud-and-fintech.group_team_fraud.fraud_prevention_scoring_intern`&#13;
&#13;
&#13;
where&#13;
result= &quot;REJECT&quot;&#13;
&#13;
group by 1,2),&#13;
&#13;
j as (select&#13;
date_trunc(date(analysisDate),month) as month_analysis,&#13;
country,&#13;
count(distinct userID) as contact_user&#13;
&#13;
from `peya-fraud-and-fintech.group_team_fraud.jira_antifraud_tickets` &#13;
&#13;
where&#13;
analysisdate&gt;&gt;=(&quot;2022-09-01&quot;)&#13;
&#13;
group by 1,2)&#13;
&#13;
select&#13;
month_analysis,&#13;
countryname,&#13;
j.contact_user/c.reject_user as contact_rate&#13;
&#13;
from c &#13;
left join j on c.month_transaction=j.month_analysis and c.countryname=j.country&#13;
&#13;
where&#13;
month_analysis is not null</relation>
          <relation connection='bigquery.1hx5dvv1xxljs711itzm106qmvqr' name='jira_others_tickets' table='[peya-fraud-and-fintech.group_team_fraud].[jira_others_tickets]' type='table' />
