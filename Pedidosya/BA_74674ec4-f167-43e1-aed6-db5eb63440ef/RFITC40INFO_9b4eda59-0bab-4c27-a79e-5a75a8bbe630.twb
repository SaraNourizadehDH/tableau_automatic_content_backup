              <calculation class='tableau' formula='IF [cbk_clasification_detallada]= &quot;CBK with RFI&quot; THEN [Calculation_646266575268364318]&#13;&#10;END' />
            </column>
            <column caption='RFI Reported' datatype='real' name='[Calculation_646266576911401035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [cbk_clasification_detallada]IN (&apos;CBK with RFI&apos;, &apos;CBK with RFI and TC40&apos;, &apos;RFI&apos;, &apos;RFI and TC40 no CBK&apos;) &#13;&#10;THEN [Calculation_646266575268364318]&#13;&#10;END' />
