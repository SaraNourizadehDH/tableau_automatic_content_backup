    <worksheet name='Hoja 16'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='allDailyOrders_extract+ (group_scoring_fraude)' name='federated.157v0he0iqy9b917rl2x70clrbli' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
            <column alias='Yes' caption='Exclude Riskified from CBK Metrics?' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;True&quot;'>
              <calculation class='tableau' formula='&quot;True&quot;' />
              <aliases>
                <alias key='&quot;False&quot;' value='No' />
                <alias key='&quot;True&quot;' value='Yes' />
              </aliases>
            </column>
            <column caption='Data by CBK' datatype='string' name='[Parámetro 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Amount&quot;'>
              <calculation class='tableau' formula='&quot;Amount&quot;' />
            </column>
            <column caption='Chargeback Reported On the Chart' datatype='boolean' name='[Parámetro 6]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Cbk by' datatype='string' name='[Parámetro 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incoming Date&quot;'>
              <calculation class='tableau' formula='&quot;Incoming Date&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.157v0he0iqy9b917rl2x70clrbli'>
            <column caption='Amount Payments' datatype='real' name='[AmountPayments]' role='measure' type='quantitative' />
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_646266573051162632]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [TransactionDate])' />
            </column>
            <column caption='Food or QC clas' datatype='string' name='[Calculation_646266573054734347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [businessType] = &quot;RESTAURANT&quot; OR [businessType] = &quot;COFFEE&quot; THEN &quot;FOOD&quot;&#13;&#10;ELSEIF [businessType] = &quot;COURIER&quot; THEN &quot;COURIER&quot;&#13;&#10;ELSEIF [businessType] = &quot;LOYALTY_SUBSCRIPTION&quot; THEN &quot;LOYALTY&quot;&#13;&#10;ELSEIF ISNULL([businessType]) THEN NULL&#13;&#10;ELSE &quot;QUICK COMMERCE&quot; &#13;&#10;END' />
            </column>
            <column caption='GMV OP €' datatype='real' name='[Calculation_646266573356834836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AmountPayments])' />
            </column>
            <column caption='Qty Trx' datatype='integer' name='[Calculation_646266573394735125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [riskifiedAccepted] = TRUE THEN [QtyTransactions] END)&#13;&#10;ELSE&#13;&#10;([QtyTransactions])&#13;&#10;END' />
            </column>
            <column caption='amount cbk incoming' datatype='real' name='[Calculation_646266575517073448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;True&quot; THEN &#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] != TRUE then [amtCbkIncomingEU] END)&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] = TRUE then [amtCbkIncomingEU] END)&#13;&#10;ELSE&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; then [amtCbkIncomingEU] END)&#13;&#10;END' />
            </column>
            <column caption='Gross Cbk Rate' datatype='real' name='[Calculation_646266575517585449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Amount&quot; &#13;&#10;AND [Parameters].[Parámetro 6] = TRUE&#13;&#10;THEN [Calculation_646266575517859882]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 5] = &quot;Quantity&quot; THEN [Calculation_646266575518826540]&#13;&#10;END' />
            </column>
            <column caption='Gross Cbk Rate AMT' datatype='real' name='[Calculation_646266575517859882]' role='measure' type='quantitative'>
