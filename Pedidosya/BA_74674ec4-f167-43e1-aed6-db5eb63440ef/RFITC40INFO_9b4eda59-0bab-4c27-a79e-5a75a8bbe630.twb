            <column-instance column='[total RFI (copia)_646266573684981785]' derivation='Sum' name='[sum:total RFI (copia)_646266573684981785:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total TC40 (copia)_646266573683679255]' derivation='Sum' name='[sum:total TC40 (copia)_646266573683679255:qk]' pivot='key' type='quantitative' />
