            <column-instance column='[Calculation_646266573051162632]' derivation='None' name='[none:Calculation_646266573051162632:ok]' pivot='key' type='ordinal' />
            <column caption='Qty Cbk Incoming' datatype='integer' name='[qtyCbkIncoming]' role='measure' type='quantitative' />
            <column caption='Riskified Accepted' datatype='boolean' name='[riskifiedAccepted]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_646266573394735125]' derivation='Sum' name='[sum:Calculation_646266573394735125:qk]' pivot='key' type='quantitative' />
