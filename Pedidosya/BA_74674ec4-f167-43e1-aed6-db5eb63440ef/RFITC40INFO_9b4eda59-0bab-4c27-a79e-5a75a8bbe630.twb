            </column>
            <column caption='Qty Trx' datatype='integer' name='[Calculation_646266573394735125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [riskifiedAccepted] = TRUE THEN [QtyTransactions] END)&#13;&#10;ELSE&#13;&#10;([QtyTransactions])&#13;&#10;END' />
            </column>
            <column caption='total TC40' datatype='integer' name='[Calculation_646266573683326998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [chargebackStatus] = &apos;TC40&apos; THEN [qtyCbkIncoming] ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Rate_RFI_amt' datatype='real' name='[Calculation_646266573685854234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 8]= TRUE THEN&#13;&#10;    SUM([total RFI (copia)_646266573684981785]) / [Calculation_646266573356834836]&#13;&#10;ELSEIF [Parameters].[Parámetro 8]= FALSE THEN&#13;&#10;    SUM([total TC40 (copia)_646266573683679255])/ SUM([Calculation_646266573394735125])&#13;&#10;END' />
            </column>
            <column caption='Rate_amt TC40' datatype='real' name='[Calculation_646266573689794587]' role='measure' type='quantitative'>
