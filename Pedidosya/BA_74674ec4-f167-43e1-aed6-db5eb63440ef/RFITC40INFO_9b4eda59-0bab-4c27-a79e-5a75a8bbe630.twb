      <column caption='Amount Payments' datatype='real' name='[AmountPayments]' role='measure' type='quantitative' />
      <column caption='CardType' datatype='string' name='[Calculation_2334553491810709504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([card_type])' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_646266573051162632]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [TransactionDate])' />
      </column>
      <column caption='Chart Opening 3' datatype='string' name='[Calculation_646266573051887625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Country Name&quot; THEN [CountryName]&#13;&#10;ELSEIF  [Parameters].[Parámetro 2] = &quot;Business Type&quot; THEN [businessType]&#13;&#10;END' />
      </column>
      <column caption='Tc40 Gross Value' datatype='real' name='[Calculation_646266573053018122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;Quantity&quot; AND [chargeback_status (Consulta SQL personalizada3)] = &quot;TC40&quot; THEN [qtyCbk (Consulta SQL personalizada3)]&#13;&#10;ELSEIF  [Parameters].[Parámetro 3] = &quot;Amount&quot; AND [chargeback_status (Consulta SQL personalizada3)] = &quot;TC40&quot; THEN [amtEur (Consulta SQL personalizada3)]&#13;&#10;END' />
      </column>
      <column caption='Food or QC clas' datatype='string' name='[Calculation_646266573054734347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [businessType] = &quot;RESTAURANT&quot; OR [businessType] = &quot;COFFEE&quot; THEN &quot;FOOD&quot;&#13;&#10;ELSEIF [businessType] = &quot;COURIER&quot; THEN &quot;COURIER&quot;&#13;&#10;ELSEIF [businessType] = &quot;LOYALTY_SUBSCRIPTION&quot; THEN &quot;LOYALTY&quot;&#13;&#10;ELSEIF ISNULL([businessType]) THEN NULL&#13;&#10;ELSE &quot;QUICK COMMERCE&quot; &#13;&#10;END' />
      </column>
      <column caption='RFI Gross Value' datatype='real' name='[Calculation_646266573064032268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;Quantity&quot; AND [chargeback_status (Consulta SQL personalizada3)] = &quot;RFI&quot; THEN [qtyCbk (Consulta SQL personalizada3)]&#13;&#10;ELSEIF  [Parameters].[Parámetro 3] = &quot;Amount&quot; AND [chargeback_status (Consulta SQL personalizada3)] = &quot;RFI&quot; THEN [amtEur (Consulta SQL personalizada3)]&#13;&#10;END' />
      </column>
      <column caption='Rate_qty TC40' datatype='real' name='[Calculation_646266573330288656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 8]&#13;&#10;WHEN False THEN&#13;&#10;    sum([Calculation_646266573683326998]) / SUM([Calculation_646266573394735125])&#13;&#10;END' />
      </column>
      <column caption='GMV OP €' datatype='real' name='[Calculation_646266573356834836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AmountPayments])' />
      </column>
      <column caption='Qty Trx' datatype='integer' name='[Calculation_646266573394735125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [riskifiedAccepted] = TRUE THEN [QtyTransactions] END)&#13;&#10;ELSE&#13;&#10;([QtyTransactions])&#13;&#10;END' />
      </column>
      <column caption='total TC40' datatype='integer' name='[Calculation_646266573683326998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [chargebackStatus] = &apos;TC40&apos; THEN [qtyCbkIncoming] ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Rate_RFI_amt' datatype='real' name='[Calculation_646266573685854234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 8]= TRUE THEN&#13;&#10;    SUM([total RFI (copia)_646266573684981785]) / [Calculation_646266573356834836]&#13;&#10;ELSEIF [Parameters].[Parámetro 8]= FALSE THEN&#13;&#10;    SUM([total TC40 (copia)_646266573683679255])/ SUM([Calculation_646266573394735125])&#13;&#10;END' />
      </column>
      <column caption='Rate_amt TC40' datatype='real' name='[Calculation_646266573689794587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 8] = TRUE THEN&#13;&#10;    SUM([total TC40 (copia)_646266573684609048]) / [Calculation_646266573356834836]&#13;&#10;ELSEIF [Parameters].[Parámetro 8]= FALSE THEN&#13;&#10;     sum([Calculation_646266573683326998]) / SUM([Calculation_646266573394735125])&#13;&#10;END' />
      </column>
      <column caption='Gross Values Flow Cbk' datatype='real' name='[Calculation_646266575268364318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Amount&quot; THEN [amtEur]&#13;&#10;ELSEIF [Parameters].[Parámetro 5] = &quot;Quantity&quot; THEN [qtyCbk]&#13;&#10;END' />
      </column>
      <column caption='RFI - CBK %' datatype='real' name='[Calculation_646266575274549279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cbk_clasification_detallada]= &quot;CBK with RFI&quot;&#13;&#10;        THEN [Calculation_646266575268364318] &#13;&#10;    END)&#13;&#10;/&#13;&#10;SUM(IF [cbk_clasification_detallada]= &quot;RFI&quot;&#13;&#10;    OR [cbk_clasification_detallada]= &quot;CBK with RFI&quot;&#13;&#10;    OR [cbk_clasification_detallada]= &quot;CBK with RFI and TC40&quot;&#13;&#10;    OR [cbk_clasification_detallada]= &quot;RFI and TC40 no CBK&quot;&#13;&#10;    THEN [Calculation_646266575268364318]&#13;&#10;    END)' />
      </column>
      <column caption='TC40 - CBK %' datatype='real' name='[Calculation_646266575449276448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cbk_clasification_detallada] = &quot;CBK with TC40&quot; &#13;&#10;    THEN [Calculation_646266575268364318] &#13;&#10;    END)&#13;&#10;/&#13;&#10;SUM(IF [cbk_clasification_detallada] = &quot;CBK with TC40&quot;&#13;&#10;    OR [cbk_clasification_detallada] = &quot;TC40&quot; &#13;&#10;    THEN [Calculation_646266575268364318] &#13;&#10;    END)' />
      </column>
      <column caption='Ratio' datatype='real' name='[Calculation_646266575499677729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_amount_eur]) / [Calculation_646266573356834836]' />
      </column>
      <column caption='amount cbk incoming' datatype='real' name='[Calculation_646266575517073448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;True&quot; THEN &#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] != TRUE then [amtCbkIncomingEU] END)&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] = TRUE then [amtCbkIncomingEU] END)&#13;&#10;ELSE&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; then [amtCbkIncomingEU] END)&#13;&#10;END' />
      </column>
      <column caption='Gross Cbk Rate' datatype='real' name='[Calculation_646266575517585449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Amount&quot; &#13;&#10;AND [Parameters].[Parámetro 6] = TRUE&#13;&#10;THEN [Calculation_646266575517859882]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 5] = &quot;Quantity&quot; THEN [Calculation_646266575518826540]&#13;&#10;END' />
      </column>
      <column caption='Gross Cbk Rate AMT' datatype='real' name='[Calculation_646266575517859882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 7] = &quot;Incoming Date&quot; THEN [Calculation_646266575518494763] END' />
      </column>
      <column caption='Gross Cbk Rate AMT incoming Date' datatype='real' name='[Calculation_646266575518494763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_646266575517073448])&#13;&#10;/&#13;&#10;[Calculation_646266573356834836]' />
      </column>
      <column caption='Gross Cbk Rate QTY' datatype='real' name='[Calculation_646266575518826540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 7] = &quot;Incoming Date&quot; THEN [Calculation_646266575519146029] END' />
      </column>
      <column caption='Gross Cbk Rate QTY incoming  Date' datatype='real' name='[Calculation_646266575519146029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_646266575519326254])&#13;&#10;/&#13;&#10;SUM([Calculation_646266573394735125])' />
      </column>
      <column caption='Qty cbk incoming' datatype='integer' name='[Calculation_646266575519326254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &quot;True&quot; THEN &#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] != TRUE then [qtyCbkIncoming] END)&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &quot;Only Riskified&quot; THEN&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; AND [isRiskified] = TRUE then [qtyCbkIncoming] END)&#13;&#10;ELSE&#13;&#10;(IF [chargebackStatus] = &quot;CBK&quot; then [qtyCbkIncoming] END)&#13;&#10;END' />
