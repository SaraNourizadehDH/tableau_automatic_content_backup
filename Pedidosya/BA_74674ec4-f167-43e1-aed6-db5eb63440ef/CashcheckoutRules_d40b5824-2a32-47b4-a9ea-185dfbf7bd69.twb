            <column caption='Date  ' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2466846741592133632]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&quot;day&quot;,[order_date])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[order_date])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;,[order_date])&#13;&#10;END' />
