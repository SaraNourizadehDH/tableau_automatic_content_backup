    <worksheet name='Error Rate Amount - Look forward'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#1b1b1b'>Error Rate </run>
            <run fontalignment='1' fontcolor='#1b1b1b' fontsize='12'>(Amount)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.0nibmf60p6g4vq18rjcir07dfg7x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Selection' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nibmf60p6g4vq18rjcir07dfg7x'>
            <column caption='Active users error rate Amount' datatype='real' default-format='p0.00%' name='[Active users error rate (copia)_1224416201080655883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Blocked Orders wih subsequents clean (copia)_1224416201080754188]&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({Fixed [blockedorder]: MAX([blockedamt])})' />
            </column>
            <column caption='Active users error rate - Cash Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - Cash (copia)_1224416201080287241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({Fixed [blockedorder]:&#13;&#10;(MAX(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedamt] END)&#13;&#10;)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({Fixed [blockedorder]: MAX([blockedamt])})' />
            </column>
            <column caption='Active users error rate - Mixed Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - Mixed (copia)_752382669749534726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Active users error rate (copia)_1224416201080655883]-([Active users error rate - Cash (copia)_1224416201080287241]+[Active users error rate - OP (copia)_1224416201080553482])' />
            </column>
            <column caption='Active users error rate - OP Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - OP (copia)_1224416201080553482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({Fixed [blockedorder]:&#13;&#10;(MAX(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedamt] END)&#13;&#10;)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({Fixed [blockedorder]: MAX([blockedamt])})' />
            </column>
            <column caption='Blocked Orders wih subsequents clean AMOUNT' datatype='real' default-format='n#,##0;-#,##0' name='[Blocked Orders wih subsequents clean (copia)_1224416201080754188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({Fixed [blockedorder]: &#13;&#10;&#13;&#10;MAX(IF  &#13;&#10;    [Qty clean subsequent (copia)_1224416200779157507] = 0 AND&#13;&#10;    [Calculation_1224416200769601536] &gt; 0&#13;&#10;THEN [blockedamt] END)})' />
            </column>
            <column caption='Qty subsequent clean' datatype='integer' name='[Calculation_1224416200769601536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : COUNTD(IF&#13;&#10;        [subsstatus] = &quot;CONFIRMED&quot; AND &#13;&#10;        [uses_discount] = 0 AND&#13;&#10;        [cc_refund_accepted] =  0 AND&#13;&#10;        [uses_sorry_coupon] = 0&#13;&#10;    THEN [subsorder] END)}' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*dd/mm/yy' name='[Calculation_1227793892476469252]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&quot;day&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;,[blockeddate])&#13;&#10;END' />
            </column>
            <column caption='Active users error rate' datatype='real' default-format='p0.00%' name='[Calculation_1227793892582965289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[QTY CONFLICTO (copia)_1224416200781213702]&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;COUNTD([blockedorder])' />
            </column>
            <column caption='Orders €' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Orders € (copia)_171699781129601025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : AVG([blockedamt])}' />
            </column>
            <column caption='Blocked Orders wih subsequents clean' datatype='integer' default-format='n#,##0;-#,##0' name='[QTY CONFLICTO (copia)_1224416200781213702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  &#13;&#10;    [Qty clean subsequent (copia)_1224416200779157507] = 0 AND&#13;&#10;    [Calculation_1224416200769601536] &gt; 0&#13;&#10;THEN [blockedorder] END)' />
            </column>
            <column caption='Qty subsequent' datatype='integer' name='[Qty clean subsequent (copia)_1224416200771112961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : COUNTD([subsorder])}' />
            </column>
            <column caption='Qty subsequent with conflict' datatype='integer' name='[Qty clean subsequent (copia)_1224416200779157507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Qty clean subsequent (copia)_1224416200771112961] -  [Calculation_1224416200769601536]' />
            </column>
            <column caption='Blocked Orders amount' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[blockedamt]' role='measure' type='quantitative' />
            <column datatype='date' name='[blockeddate]' role='dimension' type='ordinal' />
