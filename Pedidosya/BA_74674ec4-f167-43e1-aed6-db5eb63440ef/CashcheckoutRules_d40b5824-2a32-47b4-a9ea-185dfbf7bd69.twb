          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Selection' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nibmf60p6g4vq18rjcir07dfg7x'>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[% with conflict (copia)_1227793892574875684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Suborder type (copia)_1227793892561535001])/SUM([subsamt])' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*dd/mm/yy' name='[Calculation_1227793892476469252]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&quot;day&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;,[blockeddate])&#13;&#10;END' />
            </column>
            <column caption='Clean Orders' datatype='real' default-format='p0.00%' name='[Calculation_1227793892491382789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1227793892503195657])/SUM([subsamt])' />
            </column>
            <column caption='Confirmed Clean' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_1227793892503195657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] = 0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [uses_other_coupon] = 0 AND&#13;&#10;    [sorry_coupon_given] = 0 AND&#13;&#10;    [other_coupon_given] = 0 &#13;&#10;THEN [subsamt] END' />
            </column>
            <column caption='MKT' datatype='real' default-format='p0.00%' name='[Fail Rate (copia)_1227793892575014949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Suborder type (copia) (copia)_1227793892562841627]) /  SUM(IF [subsstatus] = &quot;CONFIRMED&quot; THEN [subsamt] END)' />
            </column>
            <column caption='Partial Comp' datatype='real' default-format='p0.00%' name='[Mkt rate (copia)_1227793892575522855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Suborder type (copia) (copia) (copia 2)_1227793892563140639]/ SUM(IF [subsstatus] = &quot;CONFIRMED&quot; THEN [subsamt] END)' />
            </column>
            <column caption='Orders €' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Orders € (copia)_171699781129601025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : AVG([blockedamt])}' />
            </column>
            <column caption='Partial compensation' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Suborder type (copia) (copia) (copia 2)_1227793892563140639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;    ([subsstatus] = &quot;CONFIRMED&quot;&#13;&#10;    AND [cc_refund_risk_accepted] = 1)&#13;&#10;THEN [refund_amount] END)&#13;&#10;&#13;&#10;+&#13;&#10;&#13;&#10;SUM(IF&#13;&#10;    ([subsstatus] = &quot;CONFIRMED&quot;&#13;&#10;    AND [sorry_coupon_given] = 1)&#13;&#10;THEN [sorry_coupon_given_amt] END)' />
            </column>
            <column caption='Marketing' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Suborder type (copia) (copia)_1227793892562841627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot;&#13;&#10;    AND [uses_discount] = 1&#13;&#10;    AND [uses_sorry_coupon] = 0&#13;&#10;THEN [discount_paid_by_company] END' />
            </column>
            <column caption='Total Rejected' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Suborder type (copia)_1227793892561535001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    [subsstatus] = &quot;REJECTED&quot;&#13;&#10;THEN [subsamt] END' />
            </column>
            <column caption='Blocked Orders amount' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[blockedamt]' role='measure' type='quantitative' />
            <column datatype='date' name='[blockeddate]' role='dimension' type='ordinal' />
            <column datatype='string' name='[blockedorder]' role='dimension' type='nominal' />
            <column datatype='integer' name='[cc_refund_accepted]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cc_refund_risk_accepted]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[discount_paid_by_company]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1227793892476469252]' derivation='None' name='[none:Calculation_1227793892476469252:ok]' pivot='key' type='ordinal' />
