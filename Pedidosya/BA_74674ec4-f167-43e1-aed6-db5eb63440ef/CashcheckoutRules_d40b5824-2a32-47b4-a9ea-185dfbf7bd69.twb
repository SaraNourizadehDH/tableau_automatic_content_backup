      <column caption='Active users error rate - Cash Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - Cash (copia)_1224416201080287241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({Fixed [blockedorder]:&#13;&#10;(MAX(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedamt] END)&#13;&#10;)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({Fixed [blockedorder]: MAX([blockedamt])})' />
      </column>
      <column caption='Active users error rate - OP' datatype='real' default-format='p0.00%' name='[Active users error rate - Cash (copia)_752382669745639427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedorder] END)&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;COUNTD([blockedorder])' />
      </column>
      <column caption='Active users error rate - Mixed Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - Mixed (copia)_752382669749534726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active users error rate (copia)_1224416201080655883]-([Active users error rate - Cash (copia)_1224416201080287241]+[Active users error rate - OP (copia)_1224416201080553482])' />
      </column>
      <column caption='Active users error rate - OP Amount' datatype='real' default-format='p0.00%' name='[Active users error rate - OP (copia)_1224416201080553482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({Fixed [blockedorder]:&#13;&#10;(MAX(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedamt] END)&#13;&#10;)})&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM({Fixed [blockedorder]: MAX([blockedamt])})' />
      </column>
      <column caption='Blocked Orders wih subsequents clean AMOUNT' datatype='real' default-format='n#,##0;-#,##0' name='[Blocked Orders wih subsequents clean (copia)_1224416201080754188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({Fixed [blockedorder]: &#13;&#10;&#13;&#10;MAX(IF  &#13;&#10;    [Qty clean subsequent (copia)_1224416200779157507] = 0 AND&#13;&#10;    [Calculation_1224416200769601536] &gt; 0&#13;&#10;THEN [blockedamt] END)})' />
