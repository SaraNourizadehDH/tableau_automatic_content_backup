            </column>
            <column caption='Active users error rate - Mixed' datatype='real' default-format='p0.00%' name='[Calculation_752382669745864708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1227793892582965289]-([Calculation_752382669740871682]+[Active users error rate - Cash (copia)_752382669745639427])' />
            </column>
            <column caption='Orders €' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Orders € (copia)_171699781129601025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : AVG([blockedamt])}' />
