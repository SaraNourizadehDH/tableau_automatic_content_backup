        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0m5usaa1jfhob81bl18po0j0nlns' name='Consulta_SQL_personalizada' type='text'>WITH prank_orders_data AS (&#13;
&#13;
        SELECT DISTINCT&#13;
            a.user_id,&#13;
            messageTimestamp as date_created,&#13;
            scoring_id,&#13;
            external_id,&#13;
            final_resolver_id,&#13;
&#13;
            eur_amount,&#13;
&#13;
&#13;
            reason,&#13;
            result,&#13;
&#13;
&#13;
            c.country_name as country_name,&#13;
            online_strategy_id,&#13;
&#13;
&#13;
from `peya-data-origins-pro.cl_fraud_risk.scoring` as a&#13;
    left join `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_code = RIGHT(a.flow_id, 2)&#13;
where event_id = &apos;PURCHASE&apos;&#13;
and&#13;
      (final_resolver_id like &apos;%tree-cash%&apos;&#13;
      or final_resolver_id like &apos;%cash_rules%&apos;&#13;
      or final_resolver_id like &apos;%strong_rules%&apos;&#13;
      or final_resolver_id like &apos;risk-fail-rate%&apos;&#13;
                    or final_resolver_id IN (&apos;unable_to_find_user_tree&apos;,&apos;unable_to_find_device_tree&apos;,&apos;address_fail_rate_tree&apos;)&#13;
&#13;
       or final_resolver_id in (&apos;compensation&apos;,&apos;compensation_order_0&apos;,&apos;mixed-refund&apos;,&apos;cash_all_verticals_tree&apos;,&apos;risky_user&apos;)) &#13;
    and result = &apos;REJECT&apos;&#13;
  &#13;
    AND DATE(messageTimestamp) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -9 MONTH) AND CURRENT_DATE()&#13;
QUALIFY row_number() OVER (PARTITION BY external_id ORDER BY date_created DESC ) = 1&#13;
&#13;
),&#13;
&#13;
pais as (&#13;
    select &#13;
        distinct a.*, &#13;
        CAST(datetime(date_created,&#13;
        case &#13;
            when country_name in (&apos;Argentina&apos;,&apos;Uruguay&apos;,&apos;Brasil&apos;,&apos;Chile&apos;) then&apos;America/Argentina/Buenos_Aires&apos; &#13;
            when country_name in (&apos;Bolivia&apos;, &apos;Paraguay&apos;,&apos;República Dominicana&apos;) then&apos;America/Asuncion&apos;&#13;
            when country_name in (&apos;Venezuela&apos;) then&apos;America/Caracas&apos;&#13;
            when country_name in (&apos;Ecuador&apos;,&apos;Panamá&apos;,&apos;Perú&apos;) then&apos;America/Guayaquil&apos;&#13;
            when country_name in (&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;, &apos;Costa Rica&apos;) then&apos;America/Guatemala&apos;&#13;
            end) AS TIMESTAMP ) AS country_timestamp &#13;
    from prank_orders_data a&#13;
)&#13;
&#13;
SELECT&#13;
&#13;
    country_name&#13;
    , DATE(country_timestamp) AS order_date&#13;
    , online_strategy_id&#13;
    , reason&#13;
    , COUNT(DISTINCT CASE WHEN result = &quot;REJECT&quot; THEN external_id END) AS blocked_orders&#13;
    , COUNT(DISTINCT external_id) AS total_orders&#13;
    , COUNT(DISTINCT CASE WHEN result = &quot;REJECT&quot; THEN user_id END) AS blocked_users&#13;
    , COUNT(DISTINCT(user_id)) total_users&#13;
    , ROUND(SUM(eur_amount),2) AS orders_amount&#13;
    , ROUND(SUM(CASE WHEN result = &quot;REJECT&quot; THEN eur_amount END),2) AS rejected_orders_amount&#13;
&#13;
&#13;
&#13;
&#13;
&#13;
&#13;
FROM pais&#13;
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0m5usaa1jfhob81bl18po0j0nlns' name='Consulta_SQL_personalizada' type='text'>WITH prank_orders_data AS (&#13;
&#13;
        SELECT DISTINCT&#13;
            a.user_id,&#13;
            messageTimestamp as date_created,&#13;
            scoring_id,&#13;
            external_id,&#13;
            final_resolver_id,&#13;
&#13;
            eur_amount,&#13;
&#13;
&#13;
            reason,&#13;
            result,&#13;
&#13;
&#13;
            c.country_name as country_name,&#13;
            online_strategy_id,&#13;
&#13;
&#13;
from `peya-data-origins-pro.cl_fraud_risk.scoring` as a&#13;
    left join `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_code = RIGHT(a.flow_id, 2)&#13;
where event_id = &apos;PURCHASE&apos;&#13;
and&#13;
      (final_resolver_id like &apos;%tree-cash%&apos;&#13;
      or final_resolver_id like &apos;%cash_rules%&apos;&#13;
      or final_resolver_id like &apos;%strong_rules%&apos;&#13;
      or final_resolver_id like &apos;risk-fail-rate%&apos;&#13;
                    or final_resolver_id IN (&apos;unable_to_find_user_tree&apos;,&apos;unable_to_find_device_tree&apos;,&apos;address_fail_rate_tree&apos;)&#13;
&#13;
       or final_resolver_id in (&apos;compensation&apos;,&apos;compensation_order_0&apos;,&apos;mixed-refund&apos;,&apos;cash_all_verticals_tree&apos;,&apos;risky_user&apos;)) &#13;
    and result = &apos;REJECT&apos;&#13;
  &#13;
    AND DATE(messageTimestamp) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -9 MONTH) AND CURRENT_DATE()&#13;
QUALIFY row_number() OVER (PARTITION BY external_id ORDER BY date_created DESC ) = 1&#13;
&#13;
),&#13;
&#13;
pais as (&#13;
    select &#13;
        distinct a.*, &#13;
        CAST(datetime(date_created,&#13;
        case &#13;
            when country_name in (&apos;Argentina&apos;,&apos;Uruguay&apos;,&apos;Brasil&apos;,&apos;Chile&apos;) then&apos;America/Argentina/Buenos_Aires&apos; &#13;
            when country_name in (&apos;Bolivia&apos;, &apos;Paraguay&apos;,&apos;República Dominicana&apos;) then&apos;America/Asuncion&apos;&#13;
            when country_name in (&apos;Venezuela&apos;) then&apos;America/Caracas&apos;&#13;
            when country_name in (&apos;Ecuador&apos;,&apos;Panamá&apos;,&apos;Perú&apos;) then&apos;America/Guayaquil&apos;&#13;
            when country_name in (&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;, &apos;Costa Rica&apos;) then&apos;America/Guatemala&apos;&#13;
            end) AS TIMESTAMP ) AS country_timestamp &#13;
    from prank_orders_data a&#13;
)&#13;
&#13;
SELECT&#13;
&#13;
    country_name&#13;
    , DATE(country_timestamp) AS order_date&#13;
    , online_strategy_id&#13;
    , reason&#13;
    , COUNT(DISTINCT CASE WHEN result = &quot;REJECT&quot; THEN external_id END) AS blocked_orders&#13;
    , COUNT(DISTINCT external_id) AS total_orders&#13;
    , COUNT(DISTINCT CASE WHEN result = &quot;REJECT&quot; THEN user_id END) AS blocked_users&#13;
    , COUNT(DISTINCT(user_id)) total_users&#13;
    , ROUND(SUM(eur_amount),2) AS orders_amount&#13;
    , ROUND(SUM(CASE WHEN result = &quot;REJECT&quot; THEN eur_amount END),2) AS rejected_orders_amount&#13;
&#13;
&#13;
&#13;
&#13;
&#13;
&#13;
FROM pais&#13;
