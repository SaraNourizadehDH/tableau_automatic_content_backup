          <datasource-dependencies datasource='federated.0nibmf60p6g4vq18rjcir07dfg7x'>
            <column caption='Active users error rate - OP' datatype='real' default-format='p0.00%' name='[Active users error rate - Cash (copia)_752382669745639427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;op&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedorder] END)&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;COUNTD([blockedorder])' />
            </column>
            <column caption='Qty subsequent clean' datatype='integer' name='[Calculation_1224416200769601536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [blockedorder] : COUNTD(IF&#13;&#10;        [subsstatus] = &quot;CONFIRMED&quot; AND &#13;&#10;        [uses_discount] = 0 AND&#13;&#10;        [cc_refund_accepted] =  0 AND&#13;&#10;        [uses_sorry_coupon] = 0&#13;&#10;    THEN [subsorder] END)}' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*dd/mm/yy' name='[Calculation_1227793892476469252]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&quot;day&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[blockeddate])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;,[blockeddate])&#13;&#10;END' />
            </column>
            <column caption='Active users error rate' datatype='real' default-format='p0.00%' name='[Calculation_1227793892582965289]' role='measure' type='quantitative'>
