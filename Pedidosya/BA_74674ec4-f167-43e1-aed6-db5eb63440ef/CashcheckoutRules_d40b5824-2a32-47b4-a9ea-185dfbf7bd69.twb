            </column>
            <column caption='% Estimate' datatype='string' name='[Calculation_2466846741611421701]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[country_name] = &quot;Argentina&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,11%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Uruguay&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,33%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Chile&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,32%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Perú&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,26%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Bolivia&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,02%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Paraguay&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,04%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Guatemala&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,07%&quot;&#13;&#10;ELSEIF [country_name] = &quot;El Salvador&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,13%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Costa Rica&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,26%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Panamá&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,08%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Ecuador&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,20%&quot;&#13;&#10;ELSEIF [country_name] = &quot;República Dominicana&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,14%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Honduras&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,30%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Nicaragua&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,56%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Venezuela&quot; AND [Parameters].[Parámetro 3] = &quot;Users&quot; THEN &quot;0,26%&quot;&#13;&#10;&#13;&#10;ELSEIF [country_name] = &quot;Argentina&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,08%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Uruguay&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,47%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Chile&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,27%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Perú&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,27%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Bolivia&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,01%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Paraguay&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,02%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Guatemala&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,16%&quot;&#13;&#10;ELSEIF [country_name] = &quot;El Salvador&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,08%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Costa Rica&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,37%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Panamá&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,06%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Ecuador&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,37%&quot;&#13;&#10;ELSEIF [country_name] = &quot;República Dominicana&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,16%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Honduras&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,30%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Nicaragua&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,33%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Venezuela&quot; AND [Parameters].[Parámetro 3] = &quot;Orders&quot; THEN &quot;0,27%&quot;&#13;&#10;&#13;&#10;ELSEIF [country_name] = &quot;Argentina&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,27%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Uruguay&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,96%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Chile&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,72%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Perú&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,66%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Bolivia&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,05%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Paraguay&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,00%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Guatemala&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,00%&quot;&#13;&#10;ELSEIF [country_name] = &quot;El Salvador&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,59%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Costa Rica&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;2,49%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Panamá&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,29%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Ecuador&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,24%&quot;&#13;&#10;ELSEIF [country_name] = &quot;República Dominicana&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,13%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Honduras&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,41%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Nicaragua&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;0,76%&quot;&#13;&#10;ELSEIF [country_name] = &quot;Venezuela&quot; AND [Parameters].[Parámetro 3] = &quot;Amount&quot; THEN &quot;1,09%&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Block Rate' datatype='real' default-format='p0.00%' name='[Calculation_2466846741620666376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3] &#13;&#10;    WHEN &quot;Amount&quot; THEN [Users Block Rate (copia)_2466846741605556228]&#13;&#10;    WHEN &quot;Orders&quot; THEN [Users Block Rate (copia)_2466846741605388291]&#13;&#10;    WHEN &quot;Users&quot; THEN [Calculation_2466846741604896770]&#13;&#10;END' />
            </column>
            <column caption='Orders Block Rate' datatype='real' default-format='p0.00%' name='[Users Block Rate (copia)_2466846741605388291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([blocked_orders])/SUM([total_orders])' />
            </column>
            <column caption='Amount Block Rate' datatype='real' default-format='p0.00%' name='[Users Block Rate (copia)_2466846741605556228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rejected_orders_amount])/SUM([orders_amount])' />
