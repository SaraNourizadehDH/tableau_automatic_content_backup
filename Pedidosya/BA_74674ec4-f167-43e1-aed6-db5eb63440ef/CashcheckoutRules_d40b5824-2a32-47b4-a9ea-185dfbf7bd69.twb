      <column caption='Active users error rate - Cash' datatype='real' default-format='p0.00%' name='[Calculation_752382669740871682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD(IF  &#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD([subsorder])} &#13;&#10;    -&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;&#13;&#10;    = 0 AND&#13;&#10;&#13;&#10;    {FIXED [blockedorder] : COUNTD(IF&#13;&#10;    [subsstatus] = &quot;CONFIRMED&quot; AND&#13;&#10;    [uses_discount] = 0 AND&#13;&#10;    [cc_refund_accepted] =  0 AND&#13;&#10;    [uses_sorry_coupon] = 0 AND&#13;&#10;    [payment_mean] = &quot;cash&quot;&#13;&#10;    THEN [subsorder] END)}&#13;&#10;    &gt; 0&#13;&#10;THEN [blockedorder] END)&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;COUNTD([blockedorder])' />
      </column>
      <column caption='Active users error rate - Mixed' datatype='real' default-format='p0.00%' name='[Calculation_752382669745864708]' role='measure' type='quantitative'>
