      <column caption='Blocked Orders with no subsequent' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1224416200785969159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  ISNULL([subsamt]) THEN [blockedorder] END )' />
