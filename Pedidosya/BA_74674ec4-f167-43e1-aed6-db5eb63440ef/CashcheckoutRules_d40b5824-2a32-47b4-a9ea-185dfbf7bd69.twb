      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Look_forward_query' id='_4395860360D842C88F94EFDC764E37B2'>
            <properties context=''>
              <relation connection='bigquery.1vodm5o0bueljx1e9tcs61tkfd29' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH
    ordenes_bloqueadas AS (
        SELECT DISTINCT
            a.user_id,
            messageTimestamp as date_created,
            scoring_id,
            external_id,
            final_resolver_id,
            eur_amount,

            reason,



            c.country_name as country_name,
from `peya-data-origins-pro.cl_fraud_risk.scoring` as a
    left join `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_code = RIGHT(a.flow_id, 2)
where event_id = 'PURCHASE'

and
      (final_resolver_id like '%tree-cash%'
      or final_resolver_id like '%cash_rules%'
      or final_resolver_id like '%strong_rules%'
      or final_resolver_id like 'risk-fail-rate%'
                    or final_resolver_id IN ('unable_to_find_user_tree','unable_to_find_device_tree','address_fail_rate_tree')

       or final_resolver_id in ('compensation','compensation_order_0','mixed-refund','cash_all_verticals_tree','risky_user')) 

      and result = 'REJECT'

    AND DATE(messageTimestamp) BETWEEN DATE_ADD(CURRENT_DATE(), INTERVAL -9 MONTH) AND CURRENT_DATE()
QUALIFY row_number() OVER (PARTITION BY external_id ORDER BY date_created DESC ) = 1
    )
,pais as (
    select 
        distinct a.*,
        CAST(datetime(date_created,
        case 
            when country_name in ('Argentina','Uruguay','Brasil','Chile') then'America/Argentina/Buenos_Aires' 
            when country_name in ('Bolivia', 'Paraguay','República Dominicana') then'America/Asuncion'
            when country_name in ('Venezuela') then'America/Caracas'
            when country_name in ('Ecuador','Panamá','Perú') then'America/Guayaquil'
            when country_name in ('El Salvador','Guatemala','Honduras','Nicaragua', 'Costa Rica') then'America/Guatemala'
            end) AS TIMESTAMP ) AS country_timestamp 
    from ordenes_bloqueadas a
    )

    SELECT 
        * 
    FROM (
        SELECT
            a.country_name,
            b.vertical,
            a.reason,
            a.final_resolver_id,
            a.external_id as blockedorder,
            a.eur_amount as blockedamt,
            b.order_id as subsorder,
            a.user_id as blockeduserid,
            b.order_status as subsstatus,
            b.payment_mean,
            b.cc_refund_accepted,
            b.uses_sorry_coupon,
            b.uses_other_coupon,
            b.uses_discount,
            b.other_coupon_given,
            b.sorry_coupon_given,
            b.is_reject_risk,
            b.is_reject_blacklisted,
            b.is_reject_fraud_prank,
            b.cc_refund_risk_accepted,
            b.refund_risk_amount,
            b.sorry_coupon_given_amt,
            b.discount_paid_by_company,
            b.refund_amount,
            DATE(a.country_timestamp) as blockeddate,
            b.registered_date as subsdate,
            b.order_amount as subsamt,
            RANK() OVER (PARTITION BY a.user_id,a.external_id ORDER BY b.registered_date ASC) as subrank,
        FROM `peya-datamarts-pro.dm_fraud.orders_origin` b
            RIGHT JOIN pais AS a 
                ON SAFE_CAST(a.user_id as int64) = b.user_id
                AND b.registered_date >> a.country_timestamp
        )
    WHERE subrank <<= 10]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Fail Rate' inline='true' name='federated.0bnud3411ibmvo1501rq00ljfpwj' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ddhfhz09tlhd119eonqu0nzm1z1'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='automated_tables_reports' server-oauth='' username='laura.campanario@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ddhfhz09tlhd119eonqu0nzm1z1' name='Consulta_SQL_personalizada' type='text'><![CDATA[select
    country_name,
    vertical,

    DATE(registered_date) day,
    sum(case when order_status = 'REJECTED' then order_amount else 0 end) as rechazo_amt,
    sum(order_amount) as total_amt,
    count(distinct(case when order_status = 'REJECTED' then order_id else 0 end)) as rechazo_q,
    count(distinct(order_id)) as total_q,
    CASE WHEN 
        (country_name = 'Argentina'and date(registered_date) <<'2021-10-18' and date(registered_date) >>='2021-10-18' - interval '30' day)
        OR (country_name = 'Costa Rica'and date(registered_date) <<'2021-10-25' and date(registered_date) >>='2021-10-25' - interval '30' day)
        OR (country_name = 'Chile'and date(registered_date) <<'2021-10-25' and date(registered_date) >>='2021-10-25' - interval '30' day)
        OR (country_name = 'Perú'and date(registered_date) <<'2021-10-25' and date(registered_date) >>='2021-10-25' - interval '30' day)
        OR (country_name = 'Ecuador'and date(registered_date) <<'2021-10-26' and date(registered_date) >>='2021-10-26' - interval '30' day)
        OR (country_name = 'El Salvador'and date(registered_date) <<'2021-10-26' and date(registered_date) >>='2021-10-26' - interval '30' day)
        OR (country_name = 'Uruguay'and date(registered_date) <<'2021-10-26' and date(registered_date) >>='2021-10-26' - interval '30' day)
        OR (country_name = 'Honduras'and date(registered_date) <<'2021-10-29' and date(registered_date) >>='2021-10-29' - interval '30' day)
        OR (country_name = 'Guatemala'and date(registered_date) <<'2021-11-01' and date(registered_date) >>='2021-10-29' - interval '30' day)
        OR (country_name = 'República Dominicana'and date(registered_date) <<'2021-10-28' and date(registered_date) >>='2021-10-28' - interval '30' day)
        OR (country_name = 'Panamá'and date(registered_date) <<'2021-10-29' and date(registered_date) >>='2021-10-29' - interval '30' day)
        OR (country_name = 'Venezuela'and date(registered_date) <<'2021-10-27' and date(registered_date) >>='2021-10-27' - interval '30' day)
    THEN "Prior" ELSE "Post" END as prior_or_post,
from `peya-datamarts-pro.dm_fraud.orders_origin`
where 1=1
    and payment_mean = 'cash'
    and order_amount <<= 2000
    and date(registered_date) BETWEEN "2021-09-21" and CURRENT_DATE()
group by 1,2,3,8]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ddhfhz09tlhd119eonqu0nzm1z1' name='Consulta_SQL_personalizada' type='text'><![CDATA[select
