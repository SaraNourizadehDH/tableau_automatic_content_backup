      </column>
      <column caption='Blocked Orders with conflictive subsequents ' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1224416200780906501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [Qty clean subsequent (copia)_1224416200779157507] &gt; 0 &#13;&#10;THEN [blockedorder] END)' />
