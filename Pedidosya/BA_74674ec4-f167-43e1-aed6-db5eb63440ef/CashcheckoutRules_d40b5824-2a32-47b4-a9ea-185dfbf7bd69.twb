      <column caption='MKT' datatype='real' default-format='p0.00%' name='[Fail Rate (copia)_1227793892575014949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Suborder type (copia) (copia)_1227793892562841627]) /  SUM(IF [subsstatus] = &quot;CONFIRMED&quot; THEN [subsamt] END)' />
      </column>
      <column caption='Rejected or pending user rate' datatype='real' default-format='p0.00%' name='[Inactive Users Rate (copia)_1227793892594561071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;&#13;&#10;    IF &#13;&#10;    ([subsstatus] = &quot;REJECTED&quot;)&#13;&#10;&#13;&#10;    OR &#13;&#10;&#13;&#10;    ([subsstatus] = &quot;PENDING&quot;)&#13;&#10;THEN [blockedorder] END)&#13;&#10;/ &#13;&#10;COUNTD([blockedorder])' />
