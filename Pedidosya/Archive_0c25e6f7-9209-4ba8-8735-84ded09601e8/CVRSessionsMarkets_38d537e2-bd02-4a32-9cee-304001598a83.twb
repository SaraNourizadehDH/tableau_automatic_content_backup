      <table>
        <view>
          <datasources>
            <datasource caption='markets_deepdive (user_david_herrera)' name='federated.0pq2fyh1bzsan3190ej0o1c2ll4t' />
          </datasources>
          <datasource-dependencies datasource='federated.0pq2fyh1bzsan3190ej0o1c2ll4t'>
            <column caption='Selector' datatype='string' name='[Calculation_597571401492582400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(CONTAINS([partner_name],&quot;PedidosYa Market - Drinks&quot;)=True) THEN &quot;PeYa Market Drinks&quot;&#13;&#10;ELSEIF(CONTAINS([partner_name],&quot;PedidosYa Market&quot;)=True) THEN &quot;PeYa Market&quot;&#13;&#10;ELSEIF(CONTAINS([partner_name],&quot;Tienda Coca-Cola&quot;)=True) THEN &quot;Tienda Coca-Cola&quot;&#13;&#10;ELSEIF(CONTAINS([partner_name],&quot;Fresh Market&quot;)=True) THEN &quot;Fresh Market&quot;&#13;&#10;ELSEIF(CONTAINS([partner_name],&quot;AMPM&quot;)=True) THEN &quot;AMPM&quot;&#13;&#10;ELSEIF(CONTAINS([partner_name],&quot;Walmart&quot;)=True) THEN &quot;Walmart&quot;&#13;&#10;ELSE &quot;Resto del App&quot;&#13;&#10;END' />
            </column>
            <column caption='AVG Session time' datatype='real' name='[Calculation_597571403533967363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_time_in_checkout_in_min])+AVG([avg_time_in_menu_in_min])+AVG([avg_time_on_home_in_min])+AVG([avg_time_on_list_in_min])+AVG([avg_time_to_order_in_min])' />
            </column>
            <column caption='Basket Size' datatype='real' name='[Calculation_597571403564548100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fact_orders_qty_total_products])/SUM([fact_orders_total_confirmed_orders])' />
            </column>
            <column-instance column='[avg_time_in_checkout_in_min]' derivation='Avg' name='[avg:avg_time_in_checkout_in_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_time_in_menu_in_min]' derivation='Avg' name='[avg:avg_time_in_menu_in_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_time_on_home_in_min]' derivation='Avg' name='[avg:avg_time_on_home_in_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_time_on_list_in_min]' derivation='Avg' name='[avg:avg_time_on_list_in_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_time_to_order_in_min]' derivation='Avg' name='[avg:avg_time_to_order_in_min:qk]' pivot='key' type='quantitative' />
