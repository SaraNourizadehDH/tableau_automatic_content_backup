      <column datatype='real' default-format='p0.0%' name='[CVR3]' role='measure' type='quantitative' />
      <column caption='Orders no weekly' datatype='integer' name='[Calculation_648799861694853120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders]-[orders_weekly]' />
      </column>
      <column caption='CVR 3 - Calculado' datatype='real' name='[Calculation_648799862410702849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[transactions]/[shop_details]' />
      </column>
      <column caption='Has Weekly (0/1)' datatype='integer' name='[Calculation_648799862411026434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([has_weekly] )' />
      </column>
      <column caption='Min_weekly' datatype='date' name='[Calculation_738590372865589250]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [partner_id]:MIN(IF [has_weekly] THEN [registered_date] END)}' />
      </column>
      <column caption='New since power call' datatype='boolean' name='[Calculation_738590372866105347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_738590372865589250]&gt;=DATE(&quot;2022-04-19&quot;)' />
        <aliases>
