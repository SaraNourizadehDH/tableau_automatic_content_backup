      <column caption='New and deal' datatype='boolean' name='[Calculation_738590376408588293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_738590372866105347] AND [Deal] THEN TRUE&#13;&#10;ELSE FALSE END' />
        <aliases>
          <alias key='false' value='Órganicos' />
          <alias key='true' value='Power call' />
        </aliases>
      </column>
      <column caption='Avg order week' datatype='real' name='[Calculation_738590376413511686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED ISOWEEK([registered_date]),[partner_id]: AVG([orders])}' />
