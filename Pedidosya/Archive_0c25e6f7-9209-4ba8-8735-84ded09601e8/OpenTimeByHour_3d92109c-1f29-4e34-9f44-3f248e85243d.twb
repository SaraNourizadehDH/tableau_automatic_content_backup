      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2EC7DCFB28EA4363B97CB10A9F8C7FCC'>
            <properties context=''>
              <relation connection='bigquery.0clmcsx0p3k6wh16nc0pd11384vc' name='Custom SQL Query' type='text'><![CDATA[With dates as (
    SELECT DATE_SUB(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL 5 MONTH) begin_date
),

 all_days as (
       SELECT DISTINCT 
              date as date_day 
       FROM `peya-bi-tools-pro.il_core.dim_date` d
       WHERE d.date >>= (SELECT begin_date FROM dates)
       AND d.date << CURRENT_DATE
       ORDER BY 1
),
all_hours as (
    SELECT hour FROM `peya-data-origins-pro.cl_core.date_hour` ORDER BY 1
),
orders_data_info AS (

    SELECT  o.order_id,
            o.country.country_id AS country_id,
            business_type.business_type_name vertical,
    FROM `peya-bi-tools-pro.il_core.fact_orders` o 
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_id = o.country_id AND dc.active
    WHERE o.registered_date >>= (SELECT begin_date FROM dates)
),
orders AS (

    SELECT 
            DATE(o.registered_date) AS date_day,
            o.order_hour as hour,
            o.country.country_id AS country_id,
            business_type.business_type_name vertical,
            COUNT(DISTINCT o.order_id) AS total_orders,
            COUNT(DISTINCT CASE WHEN o.order_status = "CONFIRMED" THEN o.order_id ELSE NULL END) total_orders_confirmed,
            COUNT(DISTINCT CASE WHEN o.with_logistics = TRUE THEN o.order_id ELSE NULL END) total_orders_omw_delivery,
            COUNT(DISTINCT CASE WHEN o.order_status NOT IN ("CONFIRMED") THEN o.order_id ELSE NULL END) total_non_confirmed_orders,

    FROM `peya-bi-tools-pro.il_core.fact_orders` o 
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_id = o.country_id AND dc.active
    WHERE o.registered_date >>= (SELECT begin_date FROM dates)
    AND DATE(o.registered_date) << DATE(CURRENT_DATE)
    GROUP BY 1,2,3,4
),
partner_service_cases AS (

    SELECT 
            DATE(sca.create_date) date_day,
            EXTRACT(HOUR FROM sca.create_date) AS hour,
            sca.country_id,
            o.vertical,
            COUNT(DISTINCT sca.case_id) ps_cases

    FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` sca
    LEFT JOIN orders_data_info as o ON CAST(o.order_id  as STRING) = sca.case_order_id
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd ON cd.country_id = sca.country_id AND cd.active
    WHERE DATE(sca.create_date)  >>= (SELECT begin_date FROM dates)
      AND DATE(sca.create_date) << DATE(CURRENT_DATE)
      AND sca.record_type_name IN ('PY Inbound Case','CD Inbound Case')
      AND sca.case_origin NOT IN ('Chat')
      AND (sca.case_subjec NOT LIKE '%NDC |%' OR sca.case_subjec NOT LIKE '%No country%' OR sca.case_subjec NOT LIKE '%restaurant portal%')
      AND sca.case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ', NULL)
    GROUP BY 1,2,3,4
),
partner_service_chats AS (

    SELECT 
            DATE(sch.created_date) date_day,
            EXTRACT(HOUR FROM sch.created_date) AS hour,
            cd.country_id,
            o.vertical,
            COUNT(DISTINCT sch.chat_transcript_id) ps_chats    

    FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` sch
    LEFT JOIN orders_data_info as o on o.order_id = sch.order_id
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd  ON cd.country_id = sch.country_id AND cd.active
    WHERE DATE(sch.created_date) >>= (SELECT begin_date FROM dates)
      AND DATE(sch.created_date) << DATE(CURRENT_DATE)
      AND sch.livechat_button.button_name IN ('PS_SPA_PedidosYa_Courier_Partner','PS_SPA_PedidosYa_Vendor_KA_SSU_Chat','PS_SPA_PedidosYa_HighPrio_Partner','PS_SPA_PedidosYa_Kitchen_Partner','PS_SPA_PedidosYa_Restaurant_Chat','PS_SPA_Partner_Technical_Support_Chat','PS_SPA_PedidosYa_Urgent_Restaurant_Chat','PS_SPA_Partner_Technical_Support_Chat','PS_SPA_PedidosYa_Partner_Live_Chat','PS_SPA_PedidosYa_Content_Partner_Chat','PS_SPA_Appetito_Restaurant_Chat','PS_SPA_PedidosYa_Billing_Partner_Chat','PS_SPA_Appetito_Urgent_Restaurant_Chat')
    GROUP BY 1,2,3,4
),
data_country_vertical as (
    SELECT DISTINCT country_id, vertical
    FROM orders
    UNION DISTINCT 
    SELECT DISTINCT country_id, vertical
    FROM partner_service_cases
    UNION DISTINCT 
    SELECT DISTINCT country_id, vertical
    FROM partner_service_chats
),
data_base as(

    SELECT DISTINCT * FROM data_country_vertical as d
    CROSS JOIN all_days
    CROSS JOIN all_hours
),

--OPEN TIME


   Open_data as (
SELECT  a.country_id, 
  dp.business_type.business_type_name vertical,
  partner_time_date open_date, 
  partner_time_hour open_hour,
  COUNT(DISTINCT a.partner_id) open_partners_qty, 
  FROM `peya-bi-tools-pro.il_core.agg_fact_partner_times` a
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp ON a.partner_id = dp.partner_id
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON a.country_id = dc.country_id
  WHERE state = 'OPEN' 
  and partner_time_date >>= (SELECT begin_date FROM dates)
  GROUP BY 1,2,3,4
  order by 1,2,3
)


SELECT 
        a.date_day,
        a.hour,
        a.country_id,
        dc.country_name,
        a.vertical,
        CAST(FORMAT_DATE('%A', DATE(a.date_day)) AS STRING) weekday,
        # ORDERS
        o.total_orders,
        o.total_orders_confirmed,
        o.total_orders_omw_delivery,
        o.total_non_confirmed_orders,
        # PARTNERS
        COALESCE(op.open_partners_qty,0) open_partners_qty,
        COALESCE(pa.ps_cases,0) AS partner_service_cases,
        COALESCE(ph.ps_chats,0) AS partner_service_chats,
        COALESCE(pa.ps_cases,0) + COALESCE(ph.ps_chats,0) AS partner_service_contacts,

        DATE_SUB(CURRENT_DATE(),INTERVAL 1 DAY) as last_date

        #ROUND((COALESCE(pa.ps_cases,0) + COALESCE(ph.ps_chats,0)) / o.total_orders,2) AS Partner_Service_Contact_Rate

FROM data_base AS a

LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_id = a.country_id AND dc.active


LEFT JOIN orders o
       ON a.date_day = o.date_day 
      AND a.country_id = o.country_id
      AND a.hour = o.hour
      AND a.vertical = o.vertical
LEFT JOIN partner_service_cases pa
       ON pa.date_day = a.date_day 
      AND pa.country_id = a.country_id 
      AND pa.hour = a.hour
      AND pa.vertical = a.vertical
LEFT JOIN partner_service_chats ph
       ON ph.date_day = a.date_day 
       AND ph.country_id = a.country_id 
      AND ph.hour = a.hour 
      AND ph.vertical = a.vertical
--JOIN OPEN TIME
LEFT JOIN Open_data op 
       ON a.date_day = op.open_date
      AND a.country_id = op.country_id
      AND a.hour = op.open_hour
      AND a.vertical = op.vertical



ORDER BY 1 DESC, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
