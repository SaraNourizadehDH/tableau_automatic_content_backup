          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12ixnq21wh4ac2190b3m7133tl7j'>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='IF [KPI Exception] = TRUE THEN [KPI REAL] ELSEIF [KPI REAL] &gt;...' datatype='real' name='[Calculation_1270296575872696321]' role='measure' type='quantitative' user:unnamed='KPIs Line Plot'>
              <calculation class='tableau' formula='IF [Calculation_1548675327687655463] = TRUE THEN [Calculation_844424935848722440] ELSEIF [Calculation_844424935848722440] &gt; 0 AND [KPI real (copy)_844424935849738249] &gt; 100 THEN RUNNING_SUM([Calculation_844424935848722440]) ELSEIF RUNNING_SUM([Calculation_1548675327684198434])/RUNNING_SUM([KPI REAL SUB 1 (copy)_1548675327684530211]) &gt; 1 AND [Calculation_844424935848722440] &gt; 0 THEN RUNNING_SUM([Calculation_1548675327684198434])/RUNNING_SUM([KPI REAL SUB 1 (copy)_1548675327684530211]) ELSEIF RUNNING_SUM([Calculation_1548675327684198434])/RUNNING_SUM([KPI REAL SUB 1 (copy)_1548675327684530211]) &gt; 0 AND [Calculation_844424935848722440] &gt; 0 THEN (RUNNING_SUM([Calculation_1548675327684198434])/RUNNING_SUM([KPI REAL SUB 1 (copy)_1548675327684530211]) * 100) ELSE NULL END&#13;&#10;&#13;&#10;'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IF [KPI Exception] = TRUE THEN NULL ELSEIF [KPI REAL] &gt; 0 AND...' datatype='real' name='[Calculation_1270296575873355778]' role='measure' type='quantitative' user:unnamed='KPIs Line Plot'>
              <calculation class='tableau' formula='IF [Calculation_1548675327687655463] = TRUE THEN NULL ELSEIF [Calculation_844424935848722440] &gt; 0 AND [KPI real (copy)_844424935849738249] &gt; 100 THEN RUNNING_SUM([KPI TARGET (copy)_844424935851294731]) ELSEIF [Calculation_844424935848722440] &gt; 1 THEN NULL ELSEIF [Calculation_844424935848722440] &gt; 0 THEN NULL ELSE NULL END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='FR REAL' datatype='real' name='[Calculation_1270296575874424835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fr_fail_orders]) / SUM([fr_total_orders])' />
            </column>
            <column caption='UTR REAL' datatype='real' name='[Calculation_1270296575877169157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([utr_completed_orders])/SUM([utr_working_hours])' />
            </column>
            <column caption='Rating REAL' datatype='real' name='[Calculation_1270296575885606918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_reviews_sum_partner_rating])/SUM([rating_survey_reviews_count])' />
            </column>
            <column caption='NPS REAL' datatype='real' name='[Calculation_1270296575887466503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nps_promoters_less_detractors])/SUM([nps_total_responses])' />
            </column>
            <column caption='Open Time REAL' datatype='real' name='[Calculation_1270296575914356744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_time_open_state_time])/SUM([open_time_total_state_time])' />
            </column>
            <column caption='CVR REAL' datatype='real' default-format='p0.0%' name='[Calculation_1548675327627804672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cvr_transactions])/SUM([cvr_sessions])' />
            </column>
            <column caption='DT REAL' datatype='real' name='[Calculation_1548675327651385367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_total_delivery_time]) / SUM ([dt_total_deliveries])' />
            </column>
            <column caption='KPI REAL SUB 1' datatype='real' name='[Calculation_1548675327684198434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Level Selector (copy)]&#13;&#10;WHEN &quot;CVR&quot; THEN SUM([cvr_transactions])&#13;&#10;WHEN &quot;Delivery Time&quot; THEN SUM([dt_total_delivery_time])&#13;&#10;WHEN &quot;Fail Rate&quot; THEN SUM([fr_fail_orders])&#13;&#10;WHEN &quot;UTR&quot; THEN SUM([utr_completed_orders])&#13;&#10;WHEN &quot;Logistic Index&quot; THEN SUM([dt_total_delivery_time])/SUM([dt_total_deliveries])&#13;&#10;WHEN &quot;Rating&quot; THEN SUM([rating_reviews_sum_partner_rating])&#13;&#10;WHEN &quot;NPS&quot; THEN SUM([nps_promoters_less_detractors])&#13;&#10;WHEN &quot;Open Time&quot; THEN SUM([open_time_open_state_time])&#13;&#10;WHEN &quot;Churn&quot; THEN AVG([churns]) * 100&#13;&#10;WHEN &quot;Zombies&quot; THEN AVG([zombies]) * 100&#13;&#10;WHEN &quot;Photos&quot; THEN AVG([photos]) * 100&#13;&#10;END' />
            </column>
            <column caption='KPI Exception' datatype='boolean' name='[Calculation_1548675327687655463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Level Selector (copy)]&#13;&#10;WHEN &quot;Online Food Partners&quot; THEN TRUE&#13;&#10;WHEN &quot;Online NonFood Partners&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='IF [KPI Exception] = TRUE THEN [KPI TARGET] ELSEIF [KPI TARGE...' datatype='real' name='[Calculation_1548675327690682415]' role='measure' type='quantitative' user:unnamed='KPIs Line Plot'>
              <calculation class='tableau' formula='IF [Calculation_1548675327687655463] = TRUE THEN [KPI real (copy)_844424935849738249] ELSEIF [KPI real (copy)_844424935849738249] &gt; 100 THEN RUNNING_SUM([KPI real (copy)_844424935849738249]) ELSEIF [KPI real (copy)_844424935849738249] &gt; 0 THEN [KPI real (copy)_844424935849738249] ELSE NULL END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='year - quarter' datatype='string' name='[Calculation_1788492007782170640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(year([date])) + &quot; - Q&quot; + STR(quarter([date]))' />
            </column>
            <column caption='Before Today' datatype='boolean' name='[Calculation_844424935823319040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date]&lt;(TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='KPI REAL' datatype='real' name='[Calculation_844424935848722440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Level Selector (copy)]&#13;&#10;&#13;&#10;WHEN &quot;Confirmed Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [total_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Food Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [food_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Q-Commerce Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [q_commerce_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Cities Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [cities_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Dmart Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [dmart_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Concepts Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [concepts_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Acquisitions&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;REAL&quot; THEN [Acquisitions] END)&#13;&#10;&#13;&#10;WHEN &quot;CVR&quot; THEN [Calculation_1548675327627804672] * 100&#13;&#10;&#13;&#10;WHEN &quot;Delivery Time&quot; THEN [Calculation_1548675327651385367]&#13;&#10;&#13;&#10;WHEN &quot;Fail Rate&quot; THEN [Calculation_1270296575874424835] * 100&#13;&#10;&#13;&#10;WHEN &quot;UTR&quot; THEN [Calculation_1270296575877169157]&#13;&#10;&#13;&#10;WHEN &quot;Logistic Index&quot; THEN [Calculation_1548675327651385367]/[Calculation_1270296575877169157]&#13;&#10;&#13;&#10;WHEN &quot;Rating&quot; THEN [Calculation_1270296575885606918]&#13;&#10;&#13;&#10;WHEN &quot;NPS&quot; THEN [Calculation_1270296575887466503] * 100&#13;&#10;&#13;&#10;WHEN &quot;Online Food Partners&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;REAL&quot; THEN [online_food_partners] END)&#13;&#10;&#13;&#10;WHEN &quot;Online NonFood Partners&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;REAL&quot; THEN [online_nonfood_partners] END)&#13;&#10;&#13;&#10;WHEN &quot;Open Time&quot; THEN [Calculation_1270296575914356744] * 100&#13;&#10;&#13;&#10;WHEN &quot;Churn&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;REAL&quot; THEN [churns] END) * 100&#13;&#10;&#13;&#10;WHEN &quot;Zombies&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;REAL&quot; THEN [zombies] END) * 100&#13;&#10;&#13;&#10;WHEN &quot;Photos&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;REAL&quot; THEN [photos] END) * 100&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='KPI REAL SUB 2' datatype='real' name='[KPI REAL SUB 1 (copy)_1548675327684530211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Level Selector (copy)]&#13;&#10;WHEN &quot;CVR&quot; THEN SUM([cvr_sessions])&#13;&#10;WHEN &quot;Delivery Time&quot; THEN SUM ([dt_total_deliveries])&#13;&#10;WHEN &quot;Fail Rate&quot; THEN SUM([fr_total_orders])&#13;&#10;WHEN &quot;UTR&quot; THEN SUM([utr_working_hours])&#13;&#10;WHEN &quot;Logistic Index&quot; THEN SUM([utr_completed_orders])/SUM([utr_working_hours])&#13;&#10;WHEN &quot;Rating&quot; THEN SUM([rating_survey_reviews_count])&#13;&#10;WHEN &quot;NPS&quot; THEN SUM([nps_total_responses])&#13;&#10;WHEN &quot;Open Time&quot; THEN SUM([open_time_total_state_time])&#13;&#10;WHEN &quot;Churn&quot; THEN 1&#13;&#10;WHEN &quot;Zombies&quot; THEN 1&#13;&#10;WHEN &quot;Photos&quot; THEN 1&#13;&#10;END' />
            </column>
            <column caption='KPI (REAL - TARGET)' datatype='real' name='[KPI TARGET (copy)_844424935851294731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_844424935848722440] - [KPI real (copy)_844424935849738249]' />
            </column>
            <column caption='KPI TARGET' datatype='real' name='[KPI real (copy)_844424935849738249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Level Selector (copy)]&#13;&#10;&#13;&#10;WHEN &quot;Confirmed Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [total_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Food Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [food_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Q-Commerce Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [q_commerce_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Cities Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [cities_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Dmart Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [dmart_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Concepts Orders&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [concepts_orders] END)&#13;&#10;&#13;&#10;WHEN &quot;Acquisitions&quot; THEN &#13;&#10;    SUM(IF [type] = &quot;TARGET&quot; THEN [Acquisitions] END)&#13;&#10;&#13;&#10;WHEN &quot;CVR&quot; THEN AVG([cvr_pre_target]) * 100&#13;&#10;&#13;&#10;WHEN &quot;Delivery Time&quot; THEN AVG([dt_pre_target])&#13;&#10;&#13;&#10;WHEN &quot;Fail Rate&quot; THEN AVG([fr_pre_target]) * 100&#13;&#10;&#13;&#10;WHEN &quot;UTR&quot; THEN AVG([utr_pre_target])&#13;&#10;&#13;&#10;WHEN &quot;Logistic Index&quot; THEN AVG([log_index_pre_target])&#13;&#10;&#13;&#10;WHEN &quot;Rating&quot; THEN AVG([rating_pre_target])&#13;&#10;&#13;&#10;WHEN &quot;NPS&quot; THEN AVG([nps_pre_target])&#13;&#10;&#13;&#10;WHEN &quot;Online Food Partners&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;TARGET&quot; THEN [online_food_partners] END)&#13;&#10;&#13;&#10;WHEN &quot;Online NonFood Partners&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;TARGET&quot; THEN [online_nonfood_partners] END)&#13;&#10;&#13;&#10;WHEN &quot;Open Time&quot; THEN AVG([opt_pre_target]) * 100&#13;&#10;&#13;&#10;WHEN &quot;Churn&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;TARGET&quot; THEN [churns] END) * 100&#13;&#10;&#13;&#10;WHEN &quot;Zombies&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;TARGET&quot; THEN [zombies] END) * 100&#13;&#10;&#13;&#10;WHEN &quot;Photos&quot; THEN &#13;&#10;    AVG(IF [type] = &quot;TARGET&quot; THEN [photos] END) * 100&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Churns' datatype='real' name='[churns]' role='measure' type='quantitative' />
            <column caption='Cities Orders' datatype='integer' name='[cities_orders]' role='measure' type='quantitative' />
            <column caption='Concepts Orders' datatype='integer' name='[concepts_orders]' role='measure' type='quantitative' />
