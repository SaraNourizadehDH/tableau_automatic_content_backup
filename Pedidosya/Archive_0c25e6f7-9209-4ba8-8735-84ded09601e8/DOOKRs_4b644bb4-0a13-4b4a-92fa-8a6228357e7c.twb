            </column>
            <column caption='Date Month' datatype='string' name='[Year (copia)_1288592449021161482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date])) + &quot; - &quot; + STR(MONTH([date]))' />
