      <simple-id uuid='{C22E5300-01EF-409F-A94C-E947A75DB288}' />
    </worksheet>
    <worksheet name='ADR2'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily' name='federated.0d58r1908seunn14jzghs09i3i4g' />
          </datasources>
          <datasource-dependencies datasource='federated.0d58r1908seunn14jzghs09i3i4g'>
            <column caption='ADR' datatype='real' default-format='p0.0%' name='[ADF (copia)_1064256917760647180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Total_Amount]) &gt; 0&#13;&#10;THEN SUM([Subs_Disc] + [Voucher_Disc] + [Wallet_Disc] + [Corp_Disc]) / SUM([Total_Amount])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Latest Day' datatype='date' name='[Calculation_1657887625893625861]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED:MAX([Fecha])}' />
            </column>
            <column caption='Is Last Day -1 Week' datatype='boolean' name='[Calculation_1657887625899208714]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Fecha] = DATEADD(&apos;week&apos;,-1,[Calculation_1657887625893625861]) OR [Fecha] = [Calculation_1657887625893625861]&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE END' />
