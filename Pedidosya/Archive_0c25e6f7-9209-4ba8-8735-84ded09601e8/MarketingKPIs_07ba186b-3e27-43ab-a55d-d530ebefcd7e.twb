  <datasources>
    <datasource caption='Daily' inline='true' name='federated.0d58r1908seunn14jzghs09i3i4g' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17r4trm1qronqv1cqdmc40jd99fm'>
            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='user_santiago_curat' server-oauth='' username='santiago.curat@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17r4trm1qronqv1cqdmc40jd99fm' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dmarts_list AS (
    SELECT [174316,170860,168059,171430,181646,181650,181647,181653,179429,179430,181429,181146,172357,175968,181509,174398,184777,184776,184775,184774,184731,192673,189715,189729,189722,189714,189725,198444,192128,196419,196978,196716,197645,197631,197640,197635,197633,193456,197647,197643,195243,195246,195242,200808,200807,195244,201802,203368,192673] AS dmarts),
    campaigns_table AS (
    SELECT DISTINCT tc.order_id AS order_id,
           CASE WHEN tca.talon_campaign_name LIKE '%CENTRAL%' THEN 'MARKETING_CENTRAL'
                WHEN tca.talon_campaign_name LIKE '%LOCAL%' THEN 'MARKETING_LOCAL'
                WHEN UPPER(tca.talon_campaign_name) LIKE '%_DMA_%' THEN 'DMART'
                WHEN (tc.talon_campaign_id IN ('97') OR tc.talon_campaign_id LIKE '%-customer-service-agent-compensations%') THEN 'SORRY'
                WHEN tca.talon_campaign_name LIKE '%COOP%' THEN 'CORPORATIVE'
                WHEN (tca.talon_campaign_name LIKE '%NONE%' OR 
                      tca.talon_campaign_name LIKE '%OTHER%' OR 
                      tca.talon_campaign_name LIKE '%EMPLOYEE%' OR 
                      tca.talon_campaign_name LIKE '%RH%' OR 
                      tca.talon_campaign_name LIKE 'OTHER_NCR_%' OR
                      tca.talon_campaign_name LIKE '%other_cc_%' OR
                      tca.talon_campaign_name LIKE '%other_autocomp_%' OR
                      tca.talon_campaign_name LIKE '%other_employee_%' OR
                      tca.talon_campaign_name LIKE '%other_other_%' OR
                      tca.talon_campaign_name LIKE '%other_ncr_%' OR
                      tca.talon_campaign_name LIKE '%COOP__LOCAL_%' OR
                      tca.talon_campaign_name LIKE '%WEBPAY_REFUNDS%' OR
                      tca.talon_campaign_name LIKE '%PAYMENT_REFUNDS%') THEN 'NON_MARKETING' END AS coupon_type
    FROM `peya-bi-tools-pro.il_growth.fact_talon_coupons` AS tc
    LEFT JOIN `peya-bi-tools-pro.il_growth.dim_talon_campaigns` AS tca ON tc.talon_campaign_id = tca.talon_campaign_id
    WHERE DATE (tc.coupon_created_at) >>= DATE_ADD(DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH),INTERVAL -12 MONTH)
	   AND DATE(tc.order_registered_date) BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND tc.order_state_id = 1),
    general_disc_table AS (
    SELECT DISTINCT o.order_id AS order_id,
	    CASE WHEN od.discount_type_name != 'VOUCHER' THEN COALESCE(od.discount_type_name,'DISCOUNT_NAME_MISSING') 
	         WHEN ct.coupon_type = 'MARKETING_CENTRAL' THEN 'MARKETING_CENTRAL_COUPON'
           WHEN ct.coupon_type = 'MARKETING_LOCAL' THEN 'MARKETING_LOCAL_COUPON'
           WHEN ct.coupon_type = 'DMART' THEN 'DMART_COUPON'
           WHEN ct.coupon_type = 'SORRY' THEN 'SORRY_COUPON'
           WHEN ct.coupon_type = 'CORPORATIVE' THEN 'CORPORATIVE_COUPON'
           WHEN ct.coupon_type = 'NON_MARKETING' THEN 'NON_MARKETING_COUPON'
           WHEN ct.coupon_type IS NULL THEN 'OTHER_TYPE_COUPON' END AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (discounts) AS od
    LEFT JOIN campaigns_table AS ct ON o.order_id = ct.order_id
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.discount_type_name NOT IN ('SUBSIDIZED','BINS')),
    subsidized_disc_table AS (
    SELECT o.order_id AS order_id,
	    SUM(IFNULL(od.discount_amount,0)) AS disc_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (discounts) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.discount_type_name = 'SUBSIDIZED'
    GROUP BY 1),
    subsidized_company_table AS (
    SELECT o.order_id AS order_id,
           'SUBSIDIZED_COMPANY' AS discount_type,
	    SUM(IFNULL(od.subsidized_subtotal,0)) AS disc_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (details) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
  	   AND o.order_status = 'CONFIRMED'
	   AND od.is_subsidized
    GROUP BY 1,2),
    subsidized_partner_table AS (
    SELECT soc.order_id AS order_id,
	    'SUBSIDIZED_RESTAURANT' AS discount_type,
	    CASE WHEN soc.disc_amount <<= 0 THEN TRUE ELSE FALSE END AS not_company,
	    SUM(IF(sdi.disc_amount >> soc.disc_amount,sdi.disc_amount - soc.disc_amount,0)) AS disc_amount
    FROM subsidized_company_table AS soc
    LEFT JOIN subsidized_disc_table AS sdi ON sdi.order_id = soc.order_id
    GROUP BY 1,2,3),
    subsidized_table AS (
    SELECT DISTINCT o.order_id AS order_id,
	    'SUBSIDIZED' AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (details) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.is_subsidized),
    df_table AS (
    SELECT o.order_id AS order_id,
	    'DELIVERY_FREE' AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND o.shipping_amount_no_discount = 0
	   AND o.shipping_amount = 0
	   AND o.pickup = FALSE),
    bins_table AS (
    SELECT DISTINCT p.purchase_id AS order_id,
	    CASE WHEN i.campaign_type = 0 AND a.company >> 0 THEN 'BINS_REIMBURSEMENT_COMPANY'
		  WHEN i.campaign_type = 1 AND a.company >> 0 THEN 'BINS_CASHBACK_COMPANY'
		  WHEN i.campaign_type = 2 AND a.company >> 0 THEN 'BINS_DISCOUNT_COMPANY'
		  WHEN i.campaign_type = 0 AND a.partner >> 0 THEN 'BINS_REIMBURSEMENT_PARTNER'
		  WHEN i.campaign_type = 1 AND a.partner >> 0 THEN 'BINS_CASHBACK_PARTNER'
		  WHEN i.campaign_type = 2 AND a.partner >> 0 THEN 'BINS_DISCOUNT_PARTNER'
		  WHEN i.campaign_type = 0 AND a.bank >> 0 THEN 'BINS_REIMBURSEMENT_BANK'
		  WHEN i.campaign_type = 1 AND a.bank >> 0 THEN 'BINS_CASHBACK_BANK'
		  WHEN i.campaign_type = 2 AND a.bank >> 0 THEN 'BINS_DISCOUNT_BANK'
		  ELSE 'BINS_UNKNOWN' END AS discount_type
    FROM `peya-data-origins-pro.cl_campaigns.purchase_log` AS p
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign_purchase_log_items` AS i ON p.id = i.purchase_log_id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign` AS c ON i.id = c.id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.cost` AS co ON c.cost_id = co.id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.absorbed_by` AS a ON co.absorbed_by_id = a.id
    WHERE DATE(p.created_at) BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()),
    wallet_company_table AS (
    SELECT att.order_id AS order_id,
	    CASE WHEN UPPER(att_det.campaignCode) LIKE '%CENTRAL%' THEN 'WALLET_CENTRAL'
                WHEN UPPER(att_det.campaignCode) LIKE '%LOCAL%' THEN 'WALLET_LOCAL'
                WHEN UPPER(att_det.campaignCode) LIKE '%SORRY%' THEN 'WALLET_SORRY'
                WHEN UPPER(att_det.campaignCode) LIKE '%_DMA_%' THEN 'WALLET_DMART' END AS discount_type
    FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` AS att,
    UNNEST(attributionDetails) AS att_det 
    INNER JOIN `peya-bi-tools-pro.il_core.fact_order_funding` AS w ON att.order_id = w.order_id AND w.type IN (25,35)
    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` AS o ON att.order_id = o.order_id 
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND (UPPER(att_det.campaignCode) LIKE '%CENTRAL%' OR UPPER(att_det.campaignCode) LIKE '%LOCAL%' OR UPPER(att_det.campaignCode) LIKE '%SORRY%' OR UPPER(att_det.campaignCode) LIKE '%_DMA_%')),
    wallet_corp_table AS (
    SELECT att.order_id AS order_id,
  	    'WALLET_CORPORATIVE' AS discount_type
    FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` AS att,
    UNNEST(attributionDetails) AS att_det
    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` AS o ON att.order_id = o.order_id 
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND UPPER(att_det.campaignCode) LIKE '%COOP%'),
    disc_in_order_table AS (
    SELECT o.order_id AS order_id,
           CASE WHEN COUNT(DISTINCT bt.order_id) = 0
                     AND COUNT(DISTINCT df.order_id) = 0
                     AND COUNT(DISTINCT st.order_id) = 0
                     AND COUNT(DISTINCT gt.order_id) = 0
                     AND COUNT(DISTINCT wt.order_id) = 0 THEN TRUE ELSE FALSE END AS organic,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 THEN TRUE ELSE FALSE END AS bins,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_COMPANY','BINS_CASHBACK_COMPANY','BINS_DISCOUNT_COMPANY') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_company,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_PARTNER','BINS_CASHBACK_PARTNER','BINS_DISCOUNT_PARTNER') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_partner,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_BANK','BINS_CASHBACK_BANK','BINS_DISCOUNT_BANK') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_bank,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type = 'BINS_UNKNOWN' THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_unknown,
           CASE WHEN COUNT(DISTINCT df.order_id) >> 0 THEN TRUE ELSE FALSE END AS df,
           CASE WHEN COUNT(DISTINCT st.order_id) >> 0 THEN TRUE ELSE FALSE END AS sub,
           CASE WHEN COUNT(DISTINCT sc.order_id) >> 0 AND SUM(sc.disc_amount) >> 0 THEN TRUE ELSE FALSE END AS sub_company,
           CASE WHEN COUNT(DISTINCT sp.order_id) >> 0 AND (SUM(sp.disc_amount) >> 0 OR COUNT(DISTINCT CASE WHEN sp.not_company THEN sp.order_id ELSE NULL END) >> 0) THEN TRUE ELSE FALSE END AS sub_partner,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'MARKETING_CENTRAL_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS mkt_central_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'MARKETING_LOCAL_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS mkt_local_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'DMART_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS dmart_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'SORRY_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS sorry_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'CORPORATIVE_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS corp_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'NON_MARKETING_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS non_mkt_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'OTHER_TYPE_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS other_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'DISCOUNT_NAME_MISSING' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS missing,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'SHOPPER' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS shopper,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PARTNERSHIPS' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS partnerships,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'WEEKLY' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS weekly,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PLUS_SHIPPING_COST' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS plus,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PICKUP' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS pickup,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'STAMPS' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS stamps,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'JOKER' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS joker,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_CENTRAL' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_central,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_LOCAL' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_local,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_SORRY' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_sorry,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_DMART' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_dmart,
           CASE WHEN COUNT(DISTINCT CASE WHEN wct.discount_type = 'WALLET_CORPORATIVE' THEN wct.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_corp
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    LEFT JOIN general_disc_table AS gt ON o.order_id = gt.order_id
    LEFT JOIN subsidized_table AS st ON o.order_id = st.order_id
    LEFT JOIN subsidized_company_table AS sc ON o.order_id = sc.order_id
    LEFT JOIN subsidized_partner_table AS sp ON o.order_id = sp.order_id
    LEFT JOIN df_table AS df ON o.order_id = df.order_id
    LEFT JOIN bins_table AS bt ON o.order_id = bt.order_id
    LEFT JOIN wallet_company_table AS wt ON o.order_id = wt.order_id
    LEFT JOIN wallet_corp_table AS wct ON o.order_id = wct.order_id
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
    GROUP BY 1),
    desirable_table AS (
    SELECT acq.order_id AS order_id,
           acq.desirable AS desirable
    FROM `peya-bi-tools-pro.il_growth.fact_desirable_acq` AS acq),
    disc_table AS (
    SELECT od.order_id AS order_id,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('SORRY_COUPON','MARKETING_CENTRAL_COUPON','NON_MARKETING_COUPON','MARKETING_LOCAL_COUPON','DMART_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS voucher_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('SHOPPER','BINS_DISCOUNT','BINS_DISCOUNT_CENTRAL','PICKUP','JOKER','BINS_REIMBURSEMENT','BINS_REIMBURSEMENT_CENTRAL','PLUS_SHIPPING_COST','PARTNERSHIPS','STAMPS','SUBSIDIZED','BINS_CASHBACK','BINS_CASHBACK_CENTRAL','PROMOTION','WEEKLY') THEN od.discount_amount_euro ELSE 0 END) AS subs_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('WALLET_CENTRAL','WALLET_LOCAL','WALLET_DMART') THEN od.discount_amount_euro ELSE 0 END) AS wallet_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('WALLET_COORPORATIVE','COORPORATIVE_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS corp_peya,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('SORRY_COUPON','MARKETING_CENTRAL_COUPON','NON_MARKETING_COUPON','MARKETING_LOCAL_COUPON','DMART_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS voucher_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('SHOPPER','BINS_DISCOUNT','PICKUP','JOKER','BINS_REIMBURSEMENT','PLUS_SHIPPING_COST','PARTNERSHIPS','STAMPS','SUBSIDIZED','BINS_CASHBACK','PROMOTION','WEEKLY') THEN od.discount_amount_euro ELSE 0 END) AS subs_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('WALLET_CENTRAL','WALLET_LOCAL','WALLET_DMART') THEN od.discount_amount_euro ELSE 0 END) AS wallet_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('WALLET_COORPORATIVE','COORPORATIVE_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS corp_other,
           SUM(CASE WHEN od.basket_incentive THEN od.discount_amount_euro ELSE 0 END) AS bi
    FROM `peya-bi-tools-pro.il_growth.fact_mkt_orders_discounts` AS od
    GROUP BY 1),
    orders_table AS (
    SELECT o.order_id AS order_id,
           o.customer_id AS cust,
           o.registered_date AS fecha,
           cn.country_name AS country,
           o.country_id AS country_id,
           UPPER(CASE WHEN p.is_darkstore OR p.partner_id IN UNNEST((SELECT dmarts FROM dmarts_list)) THEN 'DMART' ELSE o.business_type.business_type_name END) AS business,
           CASE WHEN p.is_darkstore OR p.partner_id IN UNNEST((SELECT dmarts FROM dmarts_list)) THEN 'DMART' 
                WHEN o.business_type.business_type_name IN ('Restaurant','Coffee') THEN 'FOOD'
                ELSE 'QC' END AS business_type,
           CASE WHEN o.is_acquisition = 1 THEN TRUE ELSE FALSE END AS acq,
           CASE WHEN o.is_acquisition = 1 AND acq.desirable THEN TRUE ELSE FALSE END AS desirable_acq,
           CASE WHEN o.with_logistics THEN TRUE ELSE FALSE END AS logistic,
           IFNULL(o.gmv_confirmed_with_discount_paid_by_company / ce.rate_eu,0) AS gmv_gross,
           IFNULL(o.confirmed_total_amount / ce.rate_eu,0) AS fv,
           IFNULL(o.shipping_amount_no_discount / ce.rate_eu,0) AS delivery_fee,
           IFNULL((IFNULL(o.shipping_amount_no_discount,0) + IFNULL(o.amount_no_discount,0) + IFNULL(o.servicefee.service_fee_no_discount,0)) / ce.rate_eu,0) AS total_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS cn ON o.country_id = cn.country_id AND cn.active
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON o.restaurant.id = p.partner_id
    LEFT JOIN desirable_table AS acq ON o.order_id = acq.order_id
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` AS ce ON ce.currency_id = cn.currency_id AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)
    WHERE o.registered_date <<= CURRENT_DATE()
          AND o.order_status = 'CONFIRMED'),
    trials_table AS (
    SELECT ot.order_id AS order_id,
           ot.business AS business,
           CASE WHEN COUNT(DISTINCT otb.order_id) = 0 THEN TRUE ELSE FALSE END AS trial_qc,
           CASE WHEN ot.business = 'DMART' AND COUNT(DISTINCT CASE WHEN otb.business = 'DMART' THEN otb.order_id ELSE NULL END) = 0 THEN TRUE ELSE FALSE END AS trial_dmart
    FROM orders_table AS ot
    LEFT JOIN orders_table AS otb ON ot.cust = otb.cust 
                                     AND ot.country_id = otb.country_id 
                                     AND otb.order_id << ot.order_id
                                     AND otb.business NOT IN ('RESTAURANT','COFFEE','COURIER','COURIER BUSINESS')
    WHERE ot.business NOT IN ('RESTAURANT','COFFEE','COURIER','COURIER BUSINESS')
          AND ot.fecha BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
          AND ot.acq = FALSE
    GROUP BY 1,2)
SELECT ot.fecha AS Fecha,
       FORMAT_DATE('%A',ot.fecha) AS Day,
       ot.country AS Country,
       ot.business AS Business,
       ot.business_type AS Business_Type,
       COUNT(DISTINCT ot.order_id) AS Orders,
       COUNT(DISTINCT CASE WHEN ot.logistic THEN ot.order_id ELSE NULL END) AS Log_Orders,
       COUNT(DISTINCT CASE WHEN ot.acq THEN ot.order_id ELSE NULL END) AS Acq,
       COUNT(DISTINCT CASE WHEN ot.acq AND ot.desirable_acq THEN ot.order_id ELSE NULL END) AS Desirable_Acq,
       COUNT(DISTINCT CASE WHEN tt.trial_qc THEN ot.order_id ELSE NULL END) AS Trials_QC,
       COUNT(DISTINCT CASE WHEN tt.trial_dmart THEN ot.order_id ELSE NULL END) AS Trials_Dmart,
       COUNT(DISTINCT CASE WHEN dt.organic THEN ot.order_id ELSE NULL END) AS Organic,
       COUNT(DISTINCT CASE WHEN dt.df THEN ot.order_id ELSE NULL END) AS DF,
       COUNT(DISTINCT CASE WHEN dt.organic = FALSE THEN ot.order_id ELSE NULL END) AS Incentived,
       COUNT(DISTINCT CASE WHEN dt.organic = FALSE AND ot.acq THEN ot.order_id ELSE NULL END) AS Acq_Incentived,
       COUNT(DISTINCT CASE WHEN dt.non_mkt_cp OR dt.mkt_central_cp OR dt.mkt_local_cp OR dt.dmart_cp OR dt.sorry_cp OR dt.wallet_central OR dt.wallet_local OR dt.wallet_sorry OR dt.wallet_dmart OR dt.corp_cp OR dt.wallet_corp THEN ot.order_id ELSE NULL END) AS Vouchers_Wallet_Orders,
       COUNT(DISTINCT CASE WHEN dt.non_mkt_cp OR dt.mkt_central_cp OR dt.mkt_local_cp OR dt.dmart_cp OR dt.sorry_cp OR dt.corp_cp THEN ot.order_id ELSE NULL END) AS Vouchers_Orders,
       COUNT(DISTINCT CASE WHEN dt.sub OR dt.bins OR dt.shopper OR dt.partnerships OR dt.weekly OR dt.plus OR dt.pickup OR dt.stamps OR dt.joker THEN ot.order_id ELSE NULL END) AS Subs_Orders,
       SUM(ot.gmv_gross) AS GVM_Gross,
       SUM(ot.fv) AS FV,
       SUM(ot.delivery_fee) AS Delivery_Fee,
       SUM(ot.total_amount) AS Total_Amount,
       SUM(dts.bi) AS Basket_Incentives,
       SUM(IFNULL(dts.voucher_peya,0) + IFNULL(dts.voucher_other,0)) AS Voucher_Disc,
       SUM(dts.voucher_peya) AS Voucher_Disc_Peya,
       SUM(dts.voucher_other) AS Voucher_Disc_Other,
       SUM(IFNULL(dts.wallet_peya,0) + IFNULL(dts.wallet_other,0)) AS Wallet_Disc,
       SUM(dts.wallet_peya) AS Wallet_Disc_Peya,
       SUM(dts.wallet_other) AS Wallet_Disc_Other,
       SUM(IFNULL(dts.subs_peya,0) + IFNULL(dts.subs_other,0)) AS Subs_Disc,
       SUM(dts.subs_peya) AS Subs_Disc_Peya,
       SUM(dts.subs_other) AS Subs_Disc_Other,
       SUM(IFNULL(dts.corp_peya,0) + IFNULL(dts.corp_other,0)) AS Corp_Disc,
       SUM(dts.corp_peya) AS Corp_Disc_Peya,
       SUM(corp_other) AS Corp_Disc_Other
FROM orders_table AS ot
LEFT JOIN trials_table AS tt ON ot.order_id = tt.order_id
LEFT JOIN disc_in_order_table AS dt ON ot.order_id = dt.order_id
LEFT JOIN disc_table AS dts ON ot.order_id = dts.order_id
WHERE ot.fecha BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
GROUP BY 1,2,3,4,5
ORDER BY 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17r4trm1qronqv1cqdmc40jd99fm' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dmarts_list AS (
    SELECT [174316,170860,168059,171430,181646,181650,181647,181653,179429,179430,181429,181146,172357,175968,181509,174398,184777,184776,184775,184774,184731,192673,189715,189729,189722,189714,189725,198444,192128,196419,196978,196716,197645,197631,197640,197635,197633,193456,197647,197643,195243,195246,195242,200808,200807,195244,201802,203368,192673] AS dmarts),
    campaigns_table AS (
    SELECT DISTINCT tc.order_id AS order_id,
           CASE WHEN tca.talon_campaign_name LIKE '%CENTRAL%' THEN 'MARKETING_CENTRAL'
                WHEN tca.talon_campaign_name LIKE '%LOCAL%' THEN 'MARKETING_LOCAL'
                WHEN UPPER(tca.talon_campaign_name) LIKE '%_DMA_%' THEN 'DMART'
                WHEN (tc.talon_campaign_id IN ('97') OR tc.talon_campaign_id LIKE '%-customer-service-agent-compensations%') THEN 'SORRY'
                WHEN tca.talon_campaign_name LIKE '%COOP%' THEN 'CORPORATIVE'
                WHEN (tca.talon_campaign_name LIKE '%NONE%' OR 
                      tca.talon_campaign_name LIKE '%OTHER%' OR 
                      tca.talon_campaign_name LIKE '%EMPLOYEE%' OR 
                      tca.talon_campaign_name LIKE '%RH%' OR 
                      tca.talon_campaign_name LIKE 'OTHER_NCR_%' OR
                      tca.talon_campaign_name LIKE '%other_cc_%' OR
                      tca.talon_campaign_name LIKE '%other_autocomp_%' OR
                      tca.talon_campaign_name LIKE '%other_employee_%' OR
                      tca.talon_campaign_name LIKE '%other_other_%' OR
                      tca.talon_campaign_name LIKE '%other_ncr_%' OR
                      tca.talon_campaign_name LIKE '%COOP__LOCAL_%' OR
                      tca.talon_campaign_name LIKE '%WEBPAY_REFUNDS%' OR
                      tca.talon_campaign_name LIKE '%PAYMENT_REFUNDS%') THEN 'NON_MARKETING' END AS coupon_type
    FROM `peya-bi-tools-pro.il_growth.fact_talon_coupons` AS tc
    LEFT JOIN `peya-bi-tools-pro.il_growth.dim_talon_campaigns` AS tca ON tc.talon_campaign_id = tca.talon_campaign_id
    WHERE DATE (tc.coupon_created_at) >>= DATE_ADD(DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH),INTERVAL -12 MONTH)
	   AND DATE(tc.order_registered_date) BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND tc.order_state_id = 1),
    general_disc_table AS (
    SELECT DISTINCT o.order_id AS order_id,
	    CASE WHEN od.discount_type_name != 'VOUCHER' THEN COALESCE(od.discount_type_name,'DISCOUNT_NAME_MISSING') 
	         WHEN ct.coupon_type = 'MARKETING_CENTRAL' THEN 'MARKETING_CENTRAL_COUPON'
           WHEN ct.coupon_type = 'MARKETING_LOCAL' THEN 'MARKETING_LOCAL_COUPON'
           WHEN ct.coupon_type = 'DMART' THEN 'DMART_COUPON'
           WHEN ct.coupon_type = 'SORRY' THEN 'SORRY_COUPON'
           WHEN ct.coupon_type = 'CORPORATIVE' THEN 'CORPORATIVE_COUPON'
           WHEN ct.coupon_type = 'NON_MARKETING' THEN 'NON_MARKETING_COUPON'
           WHEN ct.coupon_type IS NULL THEN 'OTHER_TYPE_COUPON' END AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (discounts) AS od
    LEFT JOIN campaigns_table AS ct ON o.order_id = ct.order_id
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.discount_type_name NOT IN ('SUBSIDIZED','BINS')),
    subsidized_disc_table AS (
    SELECT o.order_id AS order_id,
	    SUM(IFNULL(od.discount_amount,0)) AS disc_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (discounts) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.discount_type_name = 'SUBSIDIZED'
    GROUP BY 1),
    subsidized_company_table AS (
    SELECT o.order_id AS order_id,
           'SUBSIDIZED_COMPANY' AS discount_type,
	    SUM(IFNULL(od.subsidized_subtotal,0)) AS disc_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (details) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
  	   AND o.order_status = 'CONFIRMED'
	   AND od.is_subsidized
    GROUP BY 1,2),
    subsidized_partner_table AS (
    SELECT soc.order_id AS order_id,
	    'SUBSIDIZED_RESTAURANT' AS discount_type,
	    CASE WHEN soc.disc_amount <<= 0 THEN TRUE ELSE FALSE END AS not_company,
	    SUM(IF(sdi.disc_amount >> soc.disc_amount,sdi.disc_amount - soc.disc_amount,0)) AS disc_amount
    FROM subsidized_company_table AS soc
    LEFT JOIN subsidized_disc_table AS sdi ON sdi.order_id = soc.order_id
    GROUP BY 1,2,3),
    subsidized_table AS (
    SELECT DISTINCT o.order_id AS order_id,
	    'SUBSIDIZED' AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o,
    UNNEST (details) AS od
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND od.is_subsidized),
    df_table AS (
    SELECT o.order_id AS order_id,
	    'DELIVERY_FREE' AS discount_type
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND o.order_status = 'CONFIRMED'
	   AND o.shipping_amount_no_discount = 0
	   AND o.shipping_amount = 0
	   AND o.pickup = FALSE),
    bins_table AS (
    SELECT DISTINCT p.purchase_id AS order_id,
	    CASE WHEN i.campaign_type = 0 AND a.company >> 0 THEN 'BINS_REIMBURSEMENT_COMPANY'
		  WHEN i.campaign_type = 1 AND a.company >> 0 THEN 'BINS_CASHBACK_COMPANY'
		  WHEN i.campaign_type = 2 AND a.company >> 0 THEN 'BINS_DISCOUNT_COMPANY'
		  WHEN i.campaign_type = 0 AND a.partner >> 0 THEN 'BINS_REIMBURSEMENT_PARTNER'
		  WHEN i.campaign_type = 1 AND a.partner >> 0 THEN 'BINS_CASHBACK_PARTNER'
		  WHEN i.campaign_type = 2 AND a.partner >> 0 THEN 'BINS_DISCOUNT_PARTNER'
		  WHEN i.campaign_type = 0 AND a.bank >> 0 THEN 'BINS_REIMBURSEMENT_BANK'
		  WHEN i.campaign_type = 1 AND a.bank >> 0 THEN 'BINS_CASHBACK_BANK'
		  WHEN i.campaign_type = 2 AND a.bank >> 0 THEN 'BINS_DISCOUNT_BANK'
		  ELSE 'BINS_UNKNOWN' END AS discount_type
    FROM `peya-data-origins-pro.cl_campaigns.purchase_log` AS p
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign_purchase_log_items` AS i ON p.id = i.purchase_log_id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign` AS c ON i.id = c.id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.cost` AS co ON c.cost_id = co.id
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.absorbed_by` AS a ON co.absorbed_by_id = a.id
    WHERE DATE(p.created_at) BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()),
    wallet_company_table AS (
    SELECT att.order_id AS order_id,
	    CASE WHEN UPPER(att_det.campaignCode) LIKE '%CENTRAL%' THEN 'WALLET_CENTRAL'
                WHEN UPPER(att_det.campaignCode) LIKE '%LOCAL%' THEN 'WALLET_LOCAL'
                WHEN UPPER(att_det.campaignCode) LIKE '%SORRY%' THEN 'WALLET_SORRY'
                WHEN UPPER(att_det.campaignCode) LIKE '%_DMA_%' THEN 'WALLET_DMART' END AS discount_type
    FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` AS att,
    UNNEST(attributionDetails) AS att_det 
    INNER JOIN `peya-bi-tools-pro.il_core.fact_order_funding` AS w ON att.order_id = w.order_id AND w.type IN (25,35)
    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` AS o ON att.order_id = o.order_id 
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND (UPPER(att_det.campaignCode) LIKE '%CENTRAL%' OR UPPER(att_det.campaignCode) LIKE '%LOCAL%' OR UPPER(att_det.campaignCode) LIKE '%SORRY%' OR UPPER(att_det.campaignCode) LIKE '%_DMA_%')),
    wallet_corp_table AS (
    SELECT att.order_id AS order_id,
  	    'WALLET_CORPORATIVE' AS discount_type
    FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` AS att,
    UNNEST(attributionDetails) AS att_det
    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` AS o ON att.order_id = o.order_id 
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
	   AND UPPER(att_det.campaignCode) LIKE '%COOP%'),
    disc_in_order_table AS (
    SELECT o.order_id AS order_id,
           CASE WHEN COUNT(DISTINCT bt.order_id) = 0
                     AND COUNT(DISTINCT df.order_id) = 0
                     AND COUNT(DISTINCT st.order_id) = 0
                     AND COUNT(DISTINCT gt.order_id) = 0
                     AND COUNT(DISTINCT wt.order_id) = 0 THEN TRUE ELSE FALSE END AS organic,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 THEN TRUE ELSE FALSE END AS bins,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_COMPANY','BINS_CASHBACK_COMPANY','BINS_DISCOUNT_COMPANY') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_company,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_PARTNER','BINS_CASHBACK_PARTNER','BINS_DISCOUNT_PARTNER') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_partner,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type IN ('BINS_REIMBURSEMENT_BANK','BINS_CASHBACK_BANK','BINS_DISCOUNT_BANK') THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_bank,
           CASE WHEN COUNT(DISTINCT bt.order_id) >> 0 AND COUNT(DISTINCT CASE WHEN bt.discount_type = 'BINS_UNKNOWN' THEN bt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS bins_unknown,
           CASE WHEN COUNT(DISTINCT df.order_id) >> 0 THEN TRUE ELSE FALSE END AS df,
           CASE WHEN COUNT(DISTINCT st.order_id) >> 0 THEN TRUE ELSE FALSE END AS sub,
           CASE WHEN COUNT(DISTINCT sc.order_id) >> 0 AND SUM(sc.disc_amount) >> 0 THEN TRUE ELSE FALSE END AS sub_company,
           CASE WHEN COUNT(DISTINCT sp.order_id) >> 0 AND (SUM(sp.disc_amount) >> 0 OR COUNT(DISTINCT CASE WHEN sp.not_company THEN sp.order_id ELSE NULL END) >> 0) THEN TRUE ELSE FALSE END AS sub_partner,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'MARKETING_CENTRAL_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS mkt_central_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'MARKETING_LOCAL_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS mkt_local_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'DMART_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS dmart_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'SORRY_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS sorry_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'CORPORATIVE_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS corp_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'NON_MARKETING_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS non_mkt_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'OTHER_TYPE_COUPON' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS other_cp,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'DISCOUNT_NAME_MISSING' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS missing,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'SHOPPER' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS shopper,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PARTNERSHIPS' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS partnerships,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'WEEKLY' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS weekly,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PLUS_SHIPPING_COST' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS plus,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'PICKUP' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS pickup,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'STAMPS' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS stamps,
           CASE WHEN COUNT(DISTINCT CASE WHEN gt.discount_type = 'JOKER' THEN gt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS joker,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_CENTRAL' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_central,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_LOCAL' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_local,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_SORRY' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_sorry,
           CASE WHEN COUNT(DISTINCT CASE WHEN wt.discount_type = 'WALLET_DMART' THEN wt.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_dmart,
           CASE WHEN COUNT(DISTINCT CASE WHEN wct.discount_type = 'WALLET_CORPORATIVE' THEN wct.order_id ELSE NULL END) >> 0 THEN TRUE ELSE FALSE END AS wallet_corp
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    LEFT JOIN general_disc_table AS gt ON o.order_id = gt.order_id
    LEFT JOIN subsidized_table AS st ON o.order_id = st.order_id
    LEFT JOIN subsidized_company_table AS sc ON o.order_id = sc.order_id
    LEFT JOIN subsidized_partner_table AS sp ON o.order_id = sp.order_id
    LEFT JOIN df_table AS df ON o.order_id = df.order_id
    LEFT JOIN bins_table AS bt ON o.order_id = bt.order_id
    LEFT JOIN wallet_company_table AS wt ON o.order_id = wt.order_id
    LEFT JOIN wallet_corp_table AS wct ON o.order_id = wct.order_id
    WHERE o.registered_date BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
    GROUP BY 1),
    desirable_table AS (
    SELECT acq.order_id AS order_id,
           acq.desirable AS desirable
    FROM `peya-bi-tools-pro.il_growth.fact_desirable_acq` AS acq),
    disc_table AS (
    SELECT od.order_id AS order_id,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('SORRY_COUPON','MARKETING_CENTRAL_COUPON','NON_MARKETING_COUPON','MARKETING_LOCAL_COUPON','DMART_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS voucher_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('SHOPPER','BINS_DISCOUNT','BINS_DISCOUNT_CENTRAL','PICKUP','JOKER','BINS_REIMBURSEMENT','BINS_REIMBURSEMENT_CENTRAL','PLUS_SHIPPING_COST','PARTNERSHIPS','STAMPS','SUBSIDIZED','BINS_CASHBACK','BINS_CASHBACK_CENTRAL','PROMOTION','WEEKLY') THEN od.discount_amount_euro ELSE 0 END) AS subs_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('WALLET_CENTRAL','WALLET_LOCAL','WALLET_DMART') THEN od.discount_amount_euro ELSE 0 END) AS wallet_peya,
           SUM(CASE WHEN od.paid_by = 'COMPANY' AND od.discounts_in_order IN ('WALLET_COORPORATIVE','COORPORATIVE_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS corp_peya,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('SORRY_COUPON','MARKETING_CENTRAL_COUPON','NON_MARKETING_COUPON','MARKETING_LOCAL_COUPON','DMART_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS voucher_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('SHOPPER','BINS_DISCOUNT','PICKUP','JOKER','BINS_REIMBURSEMENT','PLUS_SHIPPING_COST','PARTNERSHIPS','STAMPS','SUBSIDIZED','BINS_CASHBACK','PROMOTION','WEEKLY') THEN od.discount_amount_euro ELSE 0 END) AS subs_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('WALLET_CENTRAL','WALLET_LOCAL','WALLET_DMART') THEN od.discount_amount_euro ELSE 0 END) AS wallet_other,
           SUM(CASE WHEN od.paid_by != 'COMPANY' AND od.discounts_in_order IN ('WALLET_COORPORATIVE','COORPORATIVE_COUPON') THEN od.discount_amount_euro ELSE 0 END) AS corp_other,
           SUM(CASE WHEN od.basket_incentive THEN od.discount_amount_euro ELSE 0 END) AS bi
    FROM `peya-bi-tools-pro.il_growth.fact_mkt_orders_discounts` AS od
    GROUP BY 1),
    orders_table AS (
    SELECT o.order_id AS order_id,
           o.customer_id AS cust,
           o.registered_date AS fecha,
           cn.country_name AS country,
           o.country_id AS country_id,
           UPPER(CASE WHEN p.is_darkstore OR p.partner_id IN UNNEST((SELECT dmarts FROM dmarts_list)) THEN 'DMART' ELSE o.business_type.business_type_name END) AS business,
           CASE WHEN p.is_darkstore OR p.partner_id IN UNNEST((SELECT dmarts FROM dmarts_list)) THEN 'DMART' 
                WHEN o.business_type.business_type_name IN ('Restaurant','Coffee') THEN 'FOOD'
                ELSE 'QC' END AS business_type,
           CASE WHEN o.is_acquisition = 1 THEN TRUE ELSE FALSE END AS acq,
           CASE WHEN o.is_acquisition = 1 AND acq.desirable THEN TRUE ELSE FALSE END AS desirable_acq,
           CASE WHEN o.with_logistics THEN TRUE ELSE FALSE END AS logistic,
           IFNULL(o.gmv_confirmed_with_discount_paid_by_company / ce.rate_eu,0) AS gmv_gross,
           IFNULL(o.confirmed_total_amount / ce.rate_eu,0) AS fv,
           IFNULL(o.shipping_amount_no_discount / ce.rate_eu,0) AS delivery_fee,
           IFNULL((IFNULL(o.shipping_amount_no_discount,0) + IFNULL(o.amount_no_discount,0) + IFNULL(o.servicefee.service_fee_no_discount,0)) / ce.rate_eu,0) AS total_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS cn ON o.country_id = cn.country_id AND cn.active
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON o.restaurant.id = p.partner_id
    LEFT JOIN desirable_table AS acq ON o.order_id = acq.order_id
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` AS ce ON ce.currency_id = cn.currency_id AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)
    WHERE o.registered_date <<= CURRENT_DATE()
          AND o.order_status = 'CONFIRMED'),
    trials_table AS (
    SELECT ot.order_id AS order_id,
           ot.business AS business,
           CASE WHEN COUNT(DISTINCT otb.order_id) = 0 THEN TRUE ELSE FALSE END AS trial_qc,
           CASE WHEN ot.business = 'DMART' AND COUNT(DISTINCT CASE WHEN otb.business = 'DMART' THEN otb.order_id ELSE NULL END) = 0 THEN TRUE ELSE FALSE END AS trial_dmart
    FROM orders_table AS ot
    LEFT JOIN orders_table AS otb ON ot.cust = otb.cust 
                                     AND ot.country_id = otb.country_id 
                                     AND otb.order_id << ot.order_id
                                     AND otb.business NOT IN ('RESTAURANT','COFFEE','COURIER','COURIER BUSINESS')
    WHERE ot.business NOT IN ('RESTAURANT','COFFEE','COURIER','COURIER BUSINESS')
          AND ot.fecha BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
          AND ot.acq = FALSE
    GROUP BY 1,2)
SELECT ot.fecha AS Fecha,
       FORMAT_DATE('%A',ot.fecha) AS Day,
       ot.country AS Country,
       ot.business AS Business,
       ot.business_type AS Business_Type,
       COUNT(DISTINCT ot.order_id) AS Orders,
       COUNT(DISTINCT CASE WHEN ot.logistic THEN ot.order_id ELSE NULL END) AS Log_Orders,
       COUNT(DISTINCT CASE WHEN ot.acq THEN ot.order_id ELSE NULL END) AS Acq,
       COUNT(DISTINCT CASE WHEN ot.acq AND ot.desirable_acq THEN ot.order_id ELSE NULL END) AS Desirable_Acq,
       COUNT(DISTINCT CASE WHEN tt.trial_qc THEN ot.order_id ELSE NULL END) AS Trials_QC,
       COUNT(DISTINCT CASE WHEN tt.trial_dmart THEN ot.order_id ELSE NULL END) AS Trials_Dmart,
       COUNT(DISTINCT CASE WHEN dt.organic THEN ot.order_id ELSE NULL END) AS Organic,
       COUNT(DISTINCT CASE WHEN dt.df THEN ot.order_id ELSE NULL END) AS DF,
       COUNT(DISTINCT CASE WHEN dt.organic = FALSE THEN ot.order_id ELSE NULL END) AS Incentived,
       COUNT(DISTINCT CASE WHEN dt.organic = FALSE AND ot.acq THEN ot.order_id ELSE NULL END) AS Acq_Incentived,
       COUNT(DISTINCT CASE WHEN dt.non_mkt_cp OR dt.mkt_central_cp OR dt.mkt_local_cp OR dt.dmart_cp OR dt.sorry_cp OR dt.wallet_central OR dt.wallet_local OR dt.wallet_sorry OR dt.wallet_dmart OR dt.corp_cp OR dt.wallet_corp THEN ot.order_id ELSE NULL END) AS Vouchers_Wallet_Orders,
       COUNT(DISTINCT CASE WHEN dt.non_mkt_cp OR dt.mkt_central_cp OR dt.mkt_local_cp OR dt.dmart_cp OR dt.sorry_cp OR dt.corp_cp THEN ot.order_id ELSE NULL END) AS Vouchers_Orders,
       COUNT(DISTINCT CASE WHEN dt.sub OR dt.bins OR dt.shopper OR dt.partnerships OR dt.weekly OR dt.plus OR dt.pickup OR dt.stamps OR dt.joker THEN ot.order_id ELSE NULL END) AS Subs_Orders,
       SUM(ot.gmv_gross) AS GVM_Gross,
       SUM(ot.fv) AS FV,
       SUM(ot.delivery_fee) AS Delivery_Fee,
       SUM(ot.total_amount) AS Total_Amount,
       SUM(dts.bi) AS Basket_Incentives,
       SUM(IFNULL(dts.voucher_peya,0) + IFNULL(dts.voucher_other,0)) AS Voucher_Disc,
       SUM(dts.voucher_peya) AS Voucher_Disc_Peya,
       SUM(dts.voucher_other) AS Voucher_Disc_Other,
       SUM(IFNULL(dts.wallet_peya,0) + IFNULL(dts.wallet_other,0)) AS Wallet_Disc,
       SUM(dts.wallet_peya) AS Wallet_Disc_Peya,
       SUM(dts.wallet_other) AS Wallet_Disc_Other,
       SUM(IFNULL(dts.subs_peya,0) + IFNULL(dts.subs_other,0)) AS Subs_Disc,
       SUM(dts.subs_peya) AS Subs_Disc_Peya,
       SUM(dts.subs_other) AS Subs_Disc_Other,
       SUM(IFNULL(dts.corp_peya,0) + IFNULL(dts.corp_other,0)) AS Corp_Disc,
       SUM(dts.corp_peya) AS Corp_Disc_Peya,
       SUM(corp_other) AS Corp_Disc_Other
FROM orders_table AS ot
LEFT JOIN trials_table AS tt ON ot.order_id = tt.order_id
LEFT JOIN disc_in_order_table AS dt ON ot.order_id = dt.order_id
LEFT JOIN disc_table AS dts ON ot.order_id = dts.order_id
WHERE ot.fecha BETWEEN DATE_ADD(CURRENT_DATE(),INTERVAL -6 MONTH) AND CURRENT_DATE()
GROUP BY 1,2,3,4,5
ORDER BY 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
