    <worksheet name='DF1'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily' name='federated.0d58r1908seunn14jzghs09i3i4g' />
          </datasources>
          <datasource-dependencies datasource='federated.0d58r1908seunn14jzghs09i3i4g'>
            <column caption='ADF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1064256917480976384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([Orders]) - SUM([DF])) &gt; 0&#13;&#10;THEN SUM([Delivery_Fee]) / (SUM([Orders]) - SUM([DF]))&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Latest Day' datatype='date' name='[Calculation_1657887625893625861]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED:MAX([Fecha])}' />
            </column>
            <column caption='Is Last Day' datatype='boolean' name='[Calculation_1657887625897320457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Fecha] = [Calculation_1657887625893625861]&#13;&#10;THEN TRUE &#13;&#10;ELSE FALSE END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[DF]' role='measure' type='quantitative' />
            <column datatype='real' name='[Delivery_Fee]' role='measure' type='quantitative' />
            <column datatype='date' name='[Fecha]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1657887625897320457]' derivation='None' name='[none:Calculation_1657887625897320457:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1064256917480976384]' derivation='User' name='[usr:Calculation_1064256917480976384:qk]' pivot='key' type='quantitative' />
