      <aliases enabled='yes' />
      <column caption='% duracion' datatype='real' name='[% duracion (copy)_2192690098321801224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[date_week_string Parameter]&#13;&#10; WHEN &apos;Daily&apos; THEN sum([Calculation_2192690098311176192])/SUM([Horas Ciudad diaria])&#13;&#10; WHEN &apos;Monthly&apos; THEN sum([Calculation_2192690098311176192])/SUM([Horas Ciudad mensual])&#13;&#10; WHEN &apos;Weekly&apos; THEN sum([Calculation_2192690098311176192])/SUM([Horas Ciudad semanal])&#13;&#10;END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
