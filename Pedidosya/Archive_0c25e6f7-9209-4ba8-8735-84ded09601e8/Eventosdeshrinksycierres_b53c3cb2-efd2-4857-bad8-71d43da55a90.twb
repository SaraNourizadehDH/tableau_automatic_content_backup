      <column caption='duration (hours)' datatype='real' name='[Calculation_2192690098311176192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[duration]/60' />
      </column>
      <column caption='Horas trabajables' datatype='real' name='[Calculation_2192690098311442433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[date_week_string Parameter]&#13;&#10; WHEN &apos;Daily&apos; THEN SUM([Horas Ciudad diaria])&#13;&#10; WHEN &apos;Monthly&apos; THEN SUM([Horas Ciudad mensual])&#13;&#10; WHEN &apos;Weekly&apos; THEN SUM([Horas Ciudad semanal])&#13;&#10;END' />
      </column>
      <column caption='GAM/Growth' datatype='string' name='[Calculation_2192690098312826882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(CONTAINS([city_name],&quot;San jose&quot;))=True THEN &quot;GAM&quot; ELSE &quot;Growth&quot; END' />
      </column>
      <column caption='City name' datatype='string' name='[Calculation_2192690098314309635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(CONTAINS([event_title],&quot;ALAJUELA ESTE&quot;))=True THEN &quot;Alajuela este&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;ALAJUELA OESTE&quot;))=True THEN &quot;Alajuela oeste&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;CARTAGO&quot;))=True THEN &quot;Cartago&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;ESCAZ&quot;))=True THEN &quot;Escazu&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;HEREDIA&quot;))=True THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;SAN JOSE NORTE&quot;))=True THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;SAN JOSE SUR&quot;))=True THEN &quot;San jose sur&quot;&#13;&#10;ELSE [city_name]&#13;&#10;END' />
      </column>
      <column caption='date_day_string' datatype='string' name='[Calculation_2192690098316103684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[created_date]),3)) + &apos; &apos;+ &#13;&#10;STR(LEFT(DATENAME(&apos;day&apos;,[created_date]),2)) + &apos;, &apos;&#13;&#10;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date])),4)' />
      </column>
