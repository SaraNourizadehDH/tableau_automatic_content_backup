            </column>
            <column caption='City name' datatype='string' name='[Calculation_2192690098314309635]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(CONTAINS([event_title],&quot;ALAJUELA ESTE&quot;))=True THEN &quot;Alajuela este&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;ALAJUELA OESTE&quot;))=True THEN &quot;Alajuela oeste&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;CARTAGO&quot;))=True THEN &quot;Cartago&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;ESCAZ&quot;))=True THEN &quot;Escazu&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;HEREDIA&quot;))=True THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;SAN JOSE NORTE&quot;))=True THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS([event_title],&quot;SAN JOSE SUR&quot;))=True THEN &quot;San jose sur&quot;&#13;&#10;ELSE [city_name]&#13;&#10;END' />
