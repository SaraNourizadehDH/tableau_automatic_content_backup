            <column caption='date_week_string' datatype='string' name='[date_month_string (copy)_2192690098316357638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,DATE(DATETRUNC(&apos;week&apos;,[created_date],&apos;monday&apos;))),3)) &#13;&#10;//+ &apos; &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[created_date],&apos;monday&apos;)))),2) +&apos;, &apos;&#13;&#10;+&apos; &apos;+ STR(DATEPART(&apos;day&apos;, DATE(DATETRUNC(&apos;week&apos;,[created_date],&apos;monday&apos;)))) + &#13;&#10; &apos;, &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[created_date],&apos;monday&apos;)))),4)' />
