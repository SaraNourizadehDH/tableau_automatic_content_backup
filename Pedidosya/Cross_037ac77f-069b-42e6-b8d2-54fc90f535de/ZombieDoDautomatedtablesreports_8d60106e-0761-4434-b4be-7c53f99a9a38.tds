  </column>
  <column caption='Activación Diaria' datatype='integer' name='[Calculation_4419720106558132251]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN(SUM([zombies])) - LOOKUP(ZN(SUM([zombies])), -1)'>
      <table-calc ordering-type='Rows' />
