      <aliases enabled='yes' />
      <column caption='Area Especifica' datatype='string' name='[Area_Especifica]' role='dimension' type='nominal' />
      <column caption='% Activación' datatype='real' default-format='p0.0%' name='[Calculation_1591178065317474325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_active_partners_m0])/ SUM([new_online])' />
      </column>
      <column caption='Has OnLine?' datatype='boolean' name='[Calculation_1591178065566687254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[online_partners] &gt; 0' />
      </column>
      <column caption='Today Zombie' datatype='integer' name='[Calculation_2024086591456788480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;   AND [date] &lt; TODAY() // hasta ayer, excluye hoy&#13;&#10;THEN [zombies]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='SDLM Zombie' datatype='real' default-format='p0.0%' name='[Calculation_2024086591461523457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([zombies]) - LOOKUP(SUM([zombies]), -1)) / ABS(LOOKUP(SUM([zombies]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
