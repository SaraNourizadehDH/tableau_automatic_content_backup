      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_82492B1E4A5A4BF9B345CDC3E3DC3D41'>
            <properties context=''>
              <relation connection='bigquery.0h6zdwy1bakwh71c0g5w81gtudxf' name='Consulta SQL personalizada' type='text'>SELECT&#13;
  DATE(hitTimestamp) date_of_event,&#13;
  DATE(DATE_TRUNC(hitTimestamp,ISOWEEK)) week_start,&#13;
  DATE_ADD(DATE(DATE_TRUNC(hitTimestamp,ISOWEEK)), INTERVAL 6 DAY) week_end,&#13;
  platform,&#13;
  source,&#13;
  medium,&#13;
  p.country.country_name as country,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_bank_info.proceeded&quot; THEN visitID END) bank_input,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_phone.proceeded&quot; THEN visitID END) phone_input,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_email.proceeded&quot; THEN visitID END) email_input,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_selection.proceeded&quot; THEN visitID END) seleccion_credito,
  COUNT(DISTINCT CASE WHEN eventAction = &quot;file_upload.clicked&quot; THEN visitID END) carga_docs,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_approved.loaded&quot; THEN visitID END) credito_aceptado,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_selection.loaded&quot; THEN visitID END) carga_landing,&#13;
  COUNT(DISTINCT CASE WHEN eventAction = &quot;credit_confirmation.clicked&quot; THEN visitID END) credito_confirmado,&#13;
  FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga_hits`&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` p ON companyNumber = p.billingInfo.rut&#13;
&#13;
&#13;
WHERE&#13;
 DATE(hitTimestamp) &gt;&gt;= &quot;2023-03-01&quot;&#13;
&#13;
&#13;
&#13;
GROUP BY 1,2,3,4,5,6,7&#13;
ORDER BY 4 DESC, 1 DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
