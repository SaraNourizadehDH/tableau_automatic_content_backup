        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0431wh808upojd11fjgse0m31rbf' name='Consulta SQL personalizada' type='text'>SELECT 

  dp.country.country_name coutnry,
  DATE_TRUNC(DATE(cr.requestdate),MONTH) request_month,
  DATE_TRUNC(DATE(cr.endDate),MONTH) end_month,
  status,
  paymentType,
  COUNT(DISTINCT cr.id) credits,
  SUM(preapprovedCapital) preapproved_capital


FROM `peya-data-origins-pro.cl_financial_services.credits` cr
LEFT JOIN `peya-data-origins-pro.cl_financial_services.clients` cl
  ON  cr.clientId = cl.id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
  ON cl.taxIdNumber = dp.billinginfo.rut


WHERE TRUE
  AND cr.is_deleted != True
  AND cr.status NOT IN (&quot;expired&quot;,&quot;rejected&quot;)

GROUP BY 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0431wh808upojd11fjgse0m31rbf' name='Consulta SQL personalizada' type='text'>SELECT 

