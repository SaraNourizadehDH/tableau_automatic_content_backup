      <column caption='Accepted Users' datatype='integer' name='[Calculation_4799359462130413568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [accepted_user_flag] WHEN  1 THEN [user_id] END)' />
      </column>
      <column caption='Total Users' datatype='integer' name='[Calculation_4799359462148567041]' role='measure' type='quantitative'>
