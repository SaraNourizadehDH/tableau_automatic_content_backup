              <calculation class='tableau' formula='CASE [component_type]&#10;    WHEN &quot;android-module&quot; THEN &quot;[AND]&quot;&#10;    WHEN &quot;ios-module&quot; THEN &quot;[iOS]&quot;&#10;    WHEN &quot;backend-golang&quot; THEN &quot;[GO]&quot;&#10;    WHEN &quot;backend-kotlin&quot; THEN &quot;[KT]&quot;&#10;    WHEN &quot;web-micro-site&quot; THEN &quot;[WEB-MICRO]&quot;&#10;    WHEN &quot;web-app-shell&quot; THEN &quot;[WEB-SHELL]&quot;&#10;    WHEN &quot;empty-http&quot; THEN &quot;[HTTP]&quot;&#10;    WHEN &quot;library&quot; THEN &quot;[LIB]&quot;&#10;    WHEN &quot;gateway&quot; THEN &quot;[GTW]&quot;&#10;    WHEN &quot;scheduler&quot; THEN &quot;[TSCH]&quot;&#10;END' />
            </column>
            <column aggregation='Count' caption='Name' datatype='string' default-type='nominal' layered='true' name='[Calculation_2279665864368824327]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_2279665864367845382] + &quot; &quot; + [component_name]' />
            </column>
            <column aggregation='Sum' caption='Metric Value Boundaries' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2279665864437624841]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;coverage&quot; THEN&#10;        (case [tier]&#10;        WHEN &quot;1&quot; then 70&#10;        WHEN &quot;2&quot; then 50&#10;        WHEN &quot;3&quot; then 30&#10;        when &quot;4&quot; then 30&#10;        ELSE 30&#10;        end&#10;        )&#10;    WHEN &quot;cognitive_complexity&quot; THEN 300&#10;END' />
            </column>
            <column-instance column='[Calculation_2279665864363433987]' derivation='Avg' name='[avg:Calculation_2279665864363433987:qk]' pivot='key' type='quantitative' />
