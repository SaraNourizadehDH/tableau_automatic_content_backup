          <datasource-dependencies datasource='Parameters'>
            <column alias='Coverage' caption='Select Metric Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;coverage&quot;'>
              <calculation class='tableau' formula='&quot;coverage&quot;' />
              <aliases>
                <alias key='&quot;cognitive_complexity&quot;' value='Cognitive Complexity' />
                <alias key='&quot;coverage&quot;' value='Coverage' />
