  <column aggregation='Count' caption='Relevant Component Types' datatype='string' default-type='nominal' name='[Calculation_2279665864369831944]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF NOT [component_type] IN (&quot;gateway&quot;, &quot;dynamodb&quot;)&\#10;    then [component_type]&\#10;END' />
