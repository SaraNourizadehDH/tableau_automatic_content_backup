              <calculation class='tableau' formula='IF [metric_name]=&quot;coverage&quot;&#10;    THEN [metric_value]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Cognitive Complexity' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2279665864361586689]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
