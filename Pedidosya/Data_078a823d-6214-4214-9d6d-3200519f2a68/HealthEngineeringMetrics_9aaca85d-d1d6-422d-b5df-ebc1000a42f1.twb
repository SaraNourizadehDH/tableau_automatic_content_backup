    <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&\#10;    WHEN &quot;coverage&quot; THEN [Calculation_2279665864361476096]&\#10;    WHEN &quot;cognitive_complexity&quot; THEN [Calculation_2279665864361586689]&\#10;END' />
