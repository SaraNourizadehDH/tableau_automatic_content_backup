        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lghcen1wqd792181zlo90p898az' name='SEGMENTS' type='text'>WITH &#13;
active_users AS &#13;
(&#13;
  SELECT DISTINCT user.id as user_id,country.country_name&#13;
  FROM `peya-bi-tools-pro.il_core.fact_orders` &#13;
  WHERE registered_date &gt;&gt;= DATE_ADD(current_date,INTERVAL -30 DAY)&#13;
  AND order_status = &apos;CONFIRMED&apos;&#13;
)&#13;
&#13;
,growth_segments AS &#13;
(&#13;
  SELECT user_id,max(segment) as segment&#13;
  FROM `peya-bi-tools-pro.il_growth.fact_user_segments_last_snapshot` &#13;
  WHERE process_date &gt;&gt;= date_add(current_date,interval -1 day)  &#13;
  GROUP BY 1 &#13;
)&#13;
&#13;
,user_potential AS &#13;
(&#13;
  SELECT user_id,income,age_group,gender,segment as potential_segment,STRING_AGG(split(replace(segment,&apos; &apos;,&apos;&apos;),&apos;-&apos;)[safe_offset(0)]) as age_segment   &#13;
  FROM `peya-bi-tools-pro.il_growth.user_income`&#13;
  GROUP BY 1,2,3,4,5&#13;
)&#13;
&#13;
,tabla_final AS &#13;
(&#13;
  SELECT &#13;
   t1.user_id&#13;
  ,t1.country_name&#13;
  ,t2.segment&#13;
&#13;
  ,t3.gender&#13;
  ,t3.potential_segment&#13;
  ,t3.age_segment&#13;
  ,t3.income&#13;
&#13;
  FROM active_users t1 &#13;
  LEFT JOIN growth_segments t2 ON t1.user_id = t2.user_id &#13;
  LEFT JOIN user_potential  t3 ON t1.user_id = t3.user_Id&#13;
)&#13;
&#13;
SELECT &#13;
 country_name&#13;
,segment&#13;
,gender&#13;
,potential_segment&#13;
,age_segment&#13;
,income&#13;
&#13;
,min(DATE_ADD(current_date,INTERVAL -30 DAY)) as start_date &#13;
,max(current_date) as end_date&#13;
,count(distinct t1.user_id) users&#13;
&#13;
FROM tabla_final t1 &#13;
JOIN (select user_id from tabla_final group by 1 having count(*)=1) t2 ON t1.user_id = t2.user_id&#13;
GROUP BY 1,2,3,4,5,6&#13;
ORDER BY 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
