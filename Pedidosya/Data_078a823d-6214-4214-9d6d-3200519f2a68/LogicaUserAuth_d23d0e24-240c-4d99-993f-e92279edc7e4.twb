      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logica User Auth' name='federated.06rv1xg0qss2pb185gi0v1goa6vl' />
          </datasources>
          <datasource-dependencies datasource='federated.06rv1xg0qss2pb185gi0v1goa6vl'>
            <column caption='Sessions IRL Loaded' datatype='integer' name='[Calculation_518758449413591040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [login_signup_loaded] = true then [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='Sessions IRL Completed' datatype='integer' name='[Calculation_518758449413824513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and ([register_completed] = TRUE or [login_succeeded] = TRUE)  // completaste con este        6.714.201&#13;&#10;//and [register_completed_or_login_succeded] = TRUE  // no es lo mismo que usar el de arriba, 6.752.087&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='Sessions IRL Only Failed' datatype='integer' name='[Calculation_518758449414086658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = true // empezaste &#13;&#10;and ([register_failed] = true or [login_failed] = true or [authentication_failed] = true) // fallaste por auth tambien (fb google apple es de auth)  &#13;&#10;and ([register_completed] = false and [login_succeeded] = false)  // no completaste 102.216&#13;&#10;//and [register_completed_or_login_succeded] = false // no es lo mismo da 99.580&#13;&#10;and [Calculation_794322451335159808] = 0 // no abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
            </column>
            <column caption='Sessions IRL Only Abandon' datatype='integer' name='[Calculation_518758449415942147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = true // empezaste &#13;&#10;and ([register_failed] = false and [login_failed] = false and [authentication_failed] = false)  // no fallaste &#13;&#10;and ([register_completed] = false and [login_succeeded] = false) // no completaste  2.618.015&#13;&#10;//and [register_completed_or_login_succeded] = false // da 2.602.244 &#13;&#10;and [Calculation_794322451335159808] = 1 // abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
            </column>
            <column aggregation='Sum' caption='Flag Only Abandono IRL' datatype='integer' name='[Calculation_794322451335159808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [login_signup_loaded] = TRUE &#13;&#10;and ([register_completed] = FALSE and [login_succeeded] = FALSE) // que no te logueaste en ninguno &#13;&#10;and ([register_failed] = FALSE and [login_failed] = FALSE and [authentication_failed] = FALSE)  // que no fallaste en ninguno &#13;&#10;THEN 1 else 0 end' />
            </column>
            <column datatype='string' name='[app_version]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[authentication_failed]' role='dimension' type='nominal' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[customer_acquired]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[login_failed]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[login_signup_loaded]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[login_succeeded]' role='dimension' type='nominal' />
            <column-instance column='[app_version]' derivation='None' name='[none:app_version:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_acquired]' derivation='None' name='[none:customer_acquired:nk]' pivot='key' type='nominal' />
            <column-instance column='[partition_date]' derivation='None' name='[none:partition_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
