      <column aggregation='Sum' caption='Flag Only Abandono IRL' datatype='integer' name='[Calculation_794322451335159808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [login_signup_loaded] = TRUE &#13;&#10;and ([register_completed] = FALSE and [login_succeeded] = FALSE) // que no te logueaste en ninguno &#13;&#10;and ([register_failed] = FALSE and [login_failed] = FALSE and [authentication_failed] = FALSE)  // que no fallaste en ninguno &#13;&#10;THEN 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='Flag Only Abandono Phone Validation' datatype='integer' name='[Calculation_794322451336065025]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [phone_validation_started] = TRUE &#13;&#10;AND [phone_validation_completed] = FALSE&#13;&#10;AND [phone_validation_failed] = FALSE &#13;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Flag Only Abandono Mail Validation' datatype='integer' name='[Calculation_794322451336388610]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  [mail_validation_loaded] = TRUE &#13;&#10;and [mail_validation_completed] = FALSE&#13;&#10;and [mail_validation_error] = FALSE &#13;&#10;THEN 1 else 0 end' />
      </column>
      <column caption='Only Failed Exclude Deleted' datatype='boolean' name='[Calculation_794322451339317252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;(  &#13;&#10;    ([register_failed] = TRUE OR [login_failed] = TRUE) &#13;&#10;    and ([register_completed] = false and [login_succeeded] = false) &#13;&#10;    AND [Calculation_794322451335159808] = 0&#13;&#10;)&#13;&#10; &#13;&#10;OR ([phone_validation_failed] = TRUE &#13;&#10;    AND [phone_validation_completed] = FALSE&#13;&#10;    AND [Calculation_794322451336065025] = 0&#13;&#10;    ) &#13;&#10;&#13;&#10;OR ([mail_validation_error] = TRUE &#13;&#10;    AND [mail_validation_completed] = FALSE&#13;&#10;    and [Calculation_794322451336388610] = 0&#13;&#10;    ) &#13;&#10;&#13;&#10;OR ([mail_edition_error] = TRUE &#13;&#10;    AND [mail_edition_completed] = FALSE&#13;&#10;    AND [Flag Abandono Phone Validation (copia)_794322451336495107] = 0 &#13;&#10;    ) &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Completed Exclude Deleted' datatype='boolean' name='[Calculation_794322451352469509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&#13;&#10;[login_signup_loaded] = TRUE &#13;&#10;AND ([register_completed] = TRUE OR [login_succeeded] = TRUE) &#13;&#10;)&#13;&#10;&#13;&#10;OR &#13;&#10;&#13;&#10;(&#13;&#10;[phone_validation_started] = TRUE &#13;&#10;AND [phone_validation_completed] = TRUE &#13;&#10;)&#13;&#10;&#13;&#10;OR &#13;&#10;(&#13;&#10;[mail_validation_loaded] = TRUE &#13;&#10;AND [mail_validation_completed] = TRUE &#13;&#10;)&#13;&#10;&#13;&#10;OR &#13;&#10;(&#13;&#10;[mail_edition_loaded] = TRUE &#13;&#10;AND [mail_edition_completed] = TRUE&#13;&#10;)' />
      </column>
      <column caption='Only Failed Deleted' datatype='boolean' name='[Calculation_794322451353591814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;[delete_account_failed] = TRUE          // fallaste &#13;&#10;AND [delete_account_completed] = FALSE  // no completaste &#13;&#10;THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Completed Deleted' datatype='boolean' name='[Calculation_794322451354005511]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delete_account_completed] = TRUE' />
      </column>
      <column caption='Sessions Completed Deleted' datatype='integer' name='[Calculation_794322451354390536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_794322451354005511] WHEN TRUE THEN [session_sk] END)' />
      </column>
      <column caption='Sessions Completed Exclude Deleted' datatype='integer' name='[Calculation_794322451354644489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_794322451352469509] WHEN TRUE THEN [session_sk] END)' />
      </column>
      <column caption='Sessions Only Failed Deleted' datatype='integer' name='[Calculation_794322451354865674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_794322451353591814] WHEN TRUE THEN [session_sk] END)' />
      </column>
      <column caption='Sessions Only Failed Exclude Deleted' datatype='integer' name='[Calculation_794322451355004939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_794322451339317252] WHEN TRUE THEN [session_sk] END)' />
      </column>
      <column caption='Sessions Loaded Exclude Deleted' datatype='integer' name='[Calculation_794322451356364812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF &#13;&#10;[login_signup_loaded]           = TRUE &#13;&#10;OR [phone_validation_started]   = TRUE &#13;&#10;OR [mail_edition_loaded]        = TRUE &#13;&#10;OR [mail_validation_loaded]     = TRUE &#13;&#10;&#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
      </column>
      <column caption='Sessions Only Abandoned Exclude Deleted' datatype='integer' name='[Calculation_794322451357089805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_794322451335159808] = 1 &#13;&#10;OR [Calculation_794322451336065025] = 1 &#13;&#10;OR [Flag Abandono Phone Validation (copia)_794322451336495107] = 1 &#13;&#10;OR [Calculation_794322451336388610] = 1 &#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
      </column>
      <column caption='% completed / loaded exclude deleted' datatype='real' name='[Calculation_794322451359469582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_794322451354644489]) &#13;&#10;/ &#13;&#10;([Calculation_794322451356364812])' />
