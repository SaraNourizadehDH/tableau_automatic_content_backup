    <worksheet name='IRL completed by Method'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;</run>
            <run bold='true' fontalignment='1'>Sheet Name</run>
            <run bold='true' fontalignment='1'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logica User Auth' name='federated.06rv1xg0qss2pb185gi0v1goa6vl' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Method' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Google&quot;'>
              <calculation class='tableau' formula='&quot;Google&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06rv1xg0qss2pb185gi0v1goa6vl'>
            <column caption='IRL Fb Clicked' datatype='integer' name='[Calculation_195625176506224640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [facebook_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Google Clicked' datatype='integer' name='[Calculation_195625176506654721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [authentication_google_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Apple Clicked' datatype='integer' name='[Calculation_195625176506851330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [authentication_apple_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Phone Clicked' datatype='integer' name='[Calculation_195625176506998787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [auth_phone_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Email Clicked' datatype='integer' name='[Calculation_195625176507133956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [auth_mail_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Fb Completed' datatype='integer' name='[Calculation_195625176507453445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;facebook&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;facebook&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL method clicked' datatype='integer' name='[Calculation_670191935243845632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;Google&apos; THEN [Calculation_195625176506654721]&#13;&#10;WHEN &apos;Fb&apos; THEN [Calculation_195625176506224640]&#13;&#10;WHEN &apos;Apple&apos; THEN [Calculation_195625176506851330]&#13;&#10;WHEN &apos;Mail&apos; THEN [Calculation_195625176507133956]&#13;&#10;WHEN &apos;Phone&apos; THEN [Calculation_195625176506998787]&#13;&#10;END' />
            </column>
            <column caption='IRL Google Completed' datatype='integer' name='[Calculation_789818852434591744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [authentication_google_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;google&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;google&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Apple Completed' datatype='integer' name='[Calculation_789818852435890180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [authentication_apple_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;apple&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;apple&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Phone Completed' datatype='integer' name='[Calculation_789818852437348359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [auth_phone_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;phone&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Email Completed' datatype='integer' name='[Calculation_789818852440948747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [auth_mail_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;email&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;email&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Fb completed / clicked' datatype='real' name='[Calculation_789818852457988110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_195625176507453445]/ [Calculation_195625176506224640]' />
            </column>
            <column caption='IRL Apple completed / clicked' datatype='real' name='[Calculation_789818852458807315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852435890180] / [Calculation_195625176506851330]' />
