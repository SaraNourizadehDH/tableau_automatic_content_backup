            <column caption='Sessions ME Loaded' datatype='integer' name='[Calculation_518758449432547332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [mail_edition_loaded] = true then [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='Sessions ME Completed' datatype='integer' name='[Calculation_518758449432719365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [mail_edition_loaded] = TRUE          // empezaste &#13;&#10;and [mail_edition_completed] = TRUE       // completaste &#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='Sessions ME Only Failed' datatype='integer' name='[Calculation_518758449432936454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [mail_edition_loaded] = true // empezaste &#13;&#10;and [mail_edition_error] = true  // fallaste &#13;&#10;and [mail_edition_completed] = false // no completaste&#13;&#10;and [Flag Abandono Phone Validation (copia)_794322451336495107] = 0 // no abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
            </column>
            <column caption='Sessions ME Only Abandon' datatype='integer' name='[Calculation_518758449433300999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [mail_edition_loaded] = true // empezaste &#13;&#10;and [mail_edition_error] = false  // no fallaste&#13;&#10;and [mail_edition_completed] = false // no completaste&#13;&#10;and [Flag Abandono Phone Validation (copia)_794322451336495107] = 1 // abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
            </column>
            <column aggregation='Sum' caption='Flag Only Abandono Mail Edition ' datatype='integer' name='[Flag Abandono Phone Validation (copia)_794322451336495107]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [mail_edition_loaded] = TRUE &#13;&#10;and [mail_edition_completed] = FALSE&#13;&#10;and [mail_edition_error] = FALSE &#13;&#10;THEN 1 else 0 end' />
            </column>
