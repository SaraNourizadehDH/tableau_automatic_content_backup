      <column caption='IRL Fb Completed' datatype='integer' name='[Calculation_195625176507453445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;facebook&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;facebook&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
      </column>
      <column caption='Clicked Fb y Registro/login completed' datatype='boolean' name='[Calculation_195625176509603846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE // clickeaste &#13;&#10;and ([register_completed] = TRUE or [login_succeeded] = TRUE)' />
      </column>
      <column caption='Clicked Fb y Registro/login failed' datatype='boolean' name='[Calculation_195625176511619079]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// apple fb y google usan authentication failed type para mirar el tipó &#13;&#10;[login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE // clickeaste &#13;&#10;and ([authentication_failed] = TRUE)' />
      </column>
      <column caption='IRL Fb Only Failed' datatype='integer' name='[Calculation_195625176547463178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;&#13;&#10;and [facebook_clicked] = TRUE            // clickeaste &#13;&#10;&#13;&#10;and  [authentication_failed] = TRUE AND CONTAINS([authentication_failed_type], &apos;facebook&apos;) // fallaste &#13;&#10;&#13;&#10;and NOT(&#13;&#10;&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;facebook&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;facebook&apos;)&#13;&#10;        )      &#13;&#10;&#13;&#10;        ) // no completo&#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
      </column>
      <column caption='IRL Fb Only Abandon' datatype='integer' name='[Calculation_195625176547872779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE            // clickeaste &#13;&#10;&#13;&#10;and NOT(&#13;&#10;&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;facebook&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;facebook&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;&#13;&#10;        ) // no completo&#13;&#10;&#13;&#10;&#13;&#10;and NOT(&#13;&#10;        [authentication_failed] = TRUE AND CONTAINS([authentication_failed_type], &apos;facebook&apos;)&#13;&#10;        ) // no fallo &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
