    <worksheet name='IRL Share completados'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;</run>
            <run bold='true' fontalignment='1'>Sheet Name</run>
            <run bold='true' fontalignment='1'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logica User Auth' name='federated.06rv1xg0qss2pb185gi0v1goa6vl' />
          </datasources>
          <datasource-dependencies datasource='federated.06rv1xg0qss2pb185gi0v1goa6vl'>
            <column caption='IRL Fb Completed' datatype='integer' name='[Calculation_195625176507453445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [facebook_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;facebook&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;facebook&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Todos Completed por Metodo' datatype='integer' name='[Calculation_287667494274285568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852434591744] &#13;&#10;+ [Calculation_195625176507453445] &#13;&#10;+ [Calculation_789818852437348359] &#13;&#10;+ [Calculation_789818852435890180]&#13;&#10;+ [Calculation_789818852440948747]' />
            </column>
            <column caption='IRL Completed Google / All' datatype='real' name='[Calculation_287667494276321284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852434591744] / [Calculation_287667494274285568]' />
            </column>
            <column caption='IRL Completed Fb / All' datatype='real' name='[Calculation_287667494276591621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_195625176507453445] / [Calculation_287667494274285568]' />
            </column>
            <column caption='IRL Completed Phone / All' datatype='real' name='[Calculation_287667494276718598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852437348359] / [Calculation_287667494274285568]' />
            </column>
            <column caption='IRL Completed Apple / All' datatype='real' name='[Calculation_287667494276784135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852435890180] / [Calculation_287667494274285568]' />
            </column>
            <column caption='IRL Completed Email / All' datatype='real' name='[Calculation_287667494276947976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852440948747] / [Calculation_287667494274285568]' />
            </column>
            <column caption='IRL Google Completed' datatype='integer' name='[Calculation_789818852434591744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [authentication_google_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;google&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;google&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
