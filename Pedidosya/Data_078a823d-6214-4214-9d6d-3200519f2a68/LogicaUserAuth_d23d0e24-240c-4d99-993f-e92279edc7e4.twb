      <column caption='% only failed / loaded exclude deleted' datatype='real' name='[Calculation_794322451359801359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_794322451355004939]) &#13;&#10;/ &#13;&#10;([Calculation_794322451356364812])' />
      </column>
      <column caption='% abandoned / loaded exclude deleted' datatype='real' name='[Calculation_794322451360014352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_794322451357089805]) &#13;&#10;/ &#13;&#10;([Calculation_794322451356364812])' />
      </column>
      <column caption='Sessions PV Started' datatype='integer' name='[Calculation_794322451372290065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;if [phone_validation_started] = true then [session_sk] ELSE NULL END&#13;&#10;)' />
      </column>
      <column caption='Sessions PV Completed' datatype='integer' name='[Calculation_794322451372535826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [phone_validation_started] = TRUE          // empezaste &#13;&#10;and [phone_validation_completed] = TRUE       // completaste &#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
      </column>
      <column caption='Sessions PV Only Failed' datatype='integer' name='[Calculation_794322451373002771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [phone_validation_started] = true // empezaste &#13;&#10;and [phone_validation_failed] = true  // fallaste &#13;&#10;and [phone_validation_completed] = false // no completaste&#13;&#10;and [Calculation_794322451336065025] = 0 // no abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
      </column>
      <column caption='Sessions PV Only Abandon' datatype='integer' name='[Calculation_794322451374227476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [phone_validation_started] = true // empezaste &#13;&#10;and [phone_validation_failed] = false  // no fallaste&#13;&#10;and [phone_validation_completed] = false // no completaste&#13;&#10;and [Calculation_794322451336065025] = 1 // abandonaste &#13;&#10;then [session_sk] else null end &#13;&#10;)' />
      </column>
      <column caption='phone_validation_completed_type_integrado' datatype='string' name='[Calculation_932526665973956608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;CONTAINS([phone_validation_completed_type], &apos;sms,whatsapp&apos;) &#13;&#10;OR CONTAINS([phone_validation_completed_type], &apos;whatsapp,sms&apos;)&#13;&#10;)&#13;&#10;&#13;&#10;THEN &apos;ambos&apos; ELSE [phone_validation_completed_type] END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_794322451372535826] / TOTAL([Calculation_794322451372535826])'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Flag Only Abandono Mail Edition ' datatype='integer' name='[Flag Abandono Phone Validation (copia)_794322451336495107]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [mail_edition_loaded] = TRUE &#13;&#10;and [mail_edition_completed] = FALSE&#13;&#10;and [mail_edition_error] = FALSE &#13;&#10;THEN 1 else 0 end' />
