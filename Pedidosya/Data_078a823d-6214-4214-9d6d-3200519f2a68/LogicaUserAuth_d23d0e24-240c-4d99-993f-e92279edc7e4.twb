      <table>
        <view>
          <datasources>
            <datasource caption='Logica User Auth' name='federated.06rv1xg0qss2pb185gi0v1goa6vl' />
          </datasources>
          <datasource-dependencies datasource='federated.06rv1xg0qss2pb185gi0v1goa6vl'>
            <column caption='IRL Phone Clicked' datatype='integer' name='[Calculation_195625176506998787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [login_signup_loaded] = TRUE &#13;&#10;AND [auth_phone_clicked] = TRUE &#13;&#10;THEN [session_sk] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='IRL Phone Completed' datatype='integer' name='[Calculation_789818852437348359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [auth_phone_clicked] = TRUE // clickeaste &#13;&#10;and  (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;phone&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     ) &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Phone Only Failed' datatype='integer' name='[Calculation_789818852437717000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;&#13;&#10;and [auth_phone_clicked] = TRUE            // clickeaste &#13;&#10;&#13;&#10;and (&#13;&#10;&#13;&#10;        (&#13;&#10;        [register_failed] = TRUE and CONTAINS([register_failed_type], &apos;phone&apos;)&#13;&#10;        ) &#13;&#10;&#13;&#10;        or &#13;&#10;&#13;&#10;        (&#13;&#10;        [login_failed] = TRUE and CONTAINS([login_failed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;&#13;&#10;    )   &#13;&#10;&#13;&#10;&#13;&#10;and NOT(&#13;&#10;&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;phone&apos;)&#13;&#10;        )      &#13;&#10;&#13;&#10;        ) // no completo&#13;&#10; &#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Phone Only Abandon' datatype='integer' name='[Calculation_789818852439416841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD&#13;&#10;(&#13;&#10;if [login_signup_loaded] = TRUE          // empezaste &#13;&#10;and [auth_phone_clicked] = TRUE            // clickeaste &#13;&#10;&#13;&#10;and  NOT (&#13;&#10;        (&#13;&#10;            [register_completed] = TRUE AND CONTAINS([register_completed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;        OR &#13;&#10;        (&#13;&#10;            [login_succeeded] = TRUE AND CONTAINS([login_succeeded_type], &apos;phone&apos;)&#13;&#10;        )  // completaste con este       &#13;&#10;     &#9;&#13;&#10;&#9;) &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;and NOT (&#13;&#10;&#13;&#10;        (&#13;&#10;        [register_failed] = TRUE and CONTAINS([register_failed_type], &apos;phone&apos;)&#13;&#10;        ) &#13;&#10;&#13;&#10;        or &#13;&#10;&#13;&#10;        (&#13;&#10;        [login_failed] = TRUE and CONTAINS([login_failed_type], &apos;phone&apos;)&#13;&#10;        )&#13;&#10;&#13;&#10;    &#9;)    &#13;&#10;&#13;&#10;&#13;&#10;then [session_sk] ELSE NULL END &#13;&#10;)' />
            </column>
            <column caption='IRL Phone only failed / clicked' datatype='real' name='[Calculation_789818852459184151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852437717000] / [Calculation_195625176506998787]' />
            </column>
            <column caption='IRL Phone only abandon / clicked' datatype='real' name='[Calculation_789818852459266072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852439416841] / [Calculation_195625176506998787]' />
            </column>
            <column caption='IRL Phone Completed / clicked' datatype='real' name='[Calculation_789818852459376665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789818852437348359] / [Calculation_195625176506998787]' />
            </column>
