              <calculation class='tableau' formula='if &#10;    lower([cd_country]) IN (&apos;not_set&apos;, &apos;not_yet&apos;) &#10;then NUll&#10;else [cd_country]&#10;end' />
            </column>
            <column aggregation='User' caption='CVR' datatype='real' default-type='quantitative' layered='true' name='[Calculation_573786799283916800]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([count_sess_trans]) / sum ([count_sessions])' />
            </column>
