        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Calculation_1221319927845859342]' formula='if [Matching Type (copy)_2687452756758224896] &lt;&gt; &apos;no_matching&apos; &#10;then [count_sessions]&#10;else 0&#10;END' />
          <calculation column='[Calculation_1285988847674576912]' formula='SUM([unnamed_road_events (copy)_1285988847674286094]) / SUM([count_sessions])' />
          <calculation column='[Calculation_178103345703608320]' formula='if &#10;    ([location_matching_type]= &apos;my_addresses&apos; or [loc_submission_started] = &apos;on&apos;)&#10;then &#10;    [count_sessions] &#10;end' />
          <calculation column='[Calculation_2297539558711156736]' formula='if &#10;    lower([cd_country]) IN (&apos;not_set&apos;, &apos;not_yet&apos;) &#10;then NUll&#10;else [cd_country]&#10;end' />
          <calculation column='[Calculation_2687452756764471307]' formula='1' />
          <calculation column='[Calculation_292171070862569476]' formula='SUM([count_sessions]) / SUM([count_sessions]) ' />
          <calculation column='[Calculation_47921174338195470]' formula='CASE [Parameters].[Parameter 2]&#10;when &apos;cvr&apos; then [Calculation_573786799283916800]&#10;when &apos;mcvr1&apos; then [mCVR4 (copy)_292171070831042560]&#10;when &apos;mcvr4&apos; then [Calculation_573786799283990529]&#10;when &apos;contact_rate&apos; then [Calculation_573786799284228098]&#10;when &apos;fail_rate&apos; then [Calculation_573786799284641795]&#10;when &apos;location_fail_rate&apos; then [Calculation_573786799285014532]&#10;end' />
          <calculation column='[Calculation_573786799283916800]' formula='sum([count_sess_trans]) / sum ([count_sessions])' />
          <calculation column='[Calculation_573786799283990529]' formula='sum([sum_mCVR4]) / sum([count_mCVR4])' />
          <calculation column='[Calculation_573786799284228098]' formula='sum([message_contacts]) / sum([count_sess_trans])&#10;&#10;// # sesiones con contactos (chats) / # sesiones con transaccion' />
          <calculation column='[Calculation_573786799284641795]' formula='sum([failed_orders]) / sum([count_sess_trans])&#10;&#10;//# ordenes canceladas / #sesiones con transaccion' />
          <calculation column='[Calculation_573786799285014532]' formula='SUM(IF NOT(ISNULL([failure_reason]))&#10;    THEN [failed_orders] &#10;ELSE &#10;    NULL&#10;END) &#10;/&#10;SUM([failed_orders])' />
          <calculation column='[Calculation_573786799291727879]' formula='IF [loc_submission_started] IN (&apos;on&apos;, &apos;off&apos;) then&#10;    [count_sessions]&#10;ELSE&#10;    NULL&#10;END' />
          <calculation column='[Calculation_573786799316172833]' formula='case [Parameters].[Parameter 1] &#10;when &apos;platform&apos; then [platform]&#10;when &apos;app_version&apos; then [app_version]&#10;when &apos;Matching Type&apos; then [Matching Type (copy)_2687452756758224896]&#10;when &apos;Location Submission Started&apos; then [Loc Submission Started (copy)_2687452756758564865]&#10;when &apos;Location Submission Finished&apos; then [Loc Submission Started cleaned (copy)_2687452756758794242]&#10;when &apos;Matching Area Type&apos; then [loc_submission_area_matching_type (copy)_2687452756759060484]&#10;else &apos;-&apos;&#10;END' />
          <calculation column='[Count Sessions (copy)_292171070883864589]' formula='{ FIXED [date], [Calculation_2297539558711156736], &#10;        [app_version], [platform], [user_lifecycle], &#10;        [user_status], [health_status], [has_saved_addresses]: sum([count_sessions])}' />
          <calculation column='[DIsambiguation (copy)_1285988847645392899]' formula='if [location_matching_has_disambiguation] = &apos;NA&apos; then &apos;false&apos;&#10;else [location_matching_has_disambiguation]&#10;end' />
          <calculation column='[Fail_rate_location (copy)_47921174331301899]' formula='if not(ISNULL([failure_reason])) then&#10;    count_sess_trans&#10;else null&#10;END' />
          <calculation column='[Failed Orders (copy)_47921174330998794]' formula='[failed_orders]' />
          <calculation column='[Level 1 Breakdown (copy)_2687452756760338440]' formula='case [Parameters].[Level 1 Breakdown (copy)_2687452756760272903] &#10;when &apos;platform&apos; then [platform]&#10;when &apos;app_version&apos; then [app_version]&#10;when &apos;Matching Type&apos; then [Matching Type (copy)_2687452756758224896]&#10;when &apos;Location Submission Started&apos; then [Loc Submission Started (copy)_2687452756758564865]&#10;when &apos;Location Submission Finished&apos; then [Loc Submission Started cleaned (copy)_2687452756758794242]&#10;when &apos;Matching Area Type&apos; then [loc_submission_area_matching_type (copy)_2687452756759060484]&#10;else &apos;-&apos;&#10;END' />
          <calculation column='[Level 1 Breakdown (copy)_573786799316529186]' formula='case [Parameters].[Level 1 Breakdown (copy)_2687452756759851013] &#10;when &apos;platform&apos; then [platform]&#10;when &apos;app_version&apos; then [app_version]&#10;when &apos;Matching Type&apos; then [Matching Type (copy)_2687452756758224896]&#10;when &apos;Location Submission Started&apos; then [Loc Submission Started (copy)_2687452756758564865]&#10;when &apos;Location Submission Finished&apos; then [Loc Submission Started cleaned (copy)_2687452756758794242]&#10;when &apos;Matching Area Type&apos; then [loc_submission_area_matching_type (copy)_2687452756759060484]&#10;else &apos;-&apos;&#10;END' />
          <calculation column='[Level 2 Breakdown (copy)_47921174341488661]' formula='case [Parameters].[Level 2 Breakdown (copy)_2687452756759904262] &#10;when &apos;platform&apos; then [platform]&#10;when &apos;app_version&apos; then [app_version]&#10;when &apos;Matching Type&apos; then [Matching Type (copy)_2687452756758224896]&#10;when &apos;Location Submission Started&apos; then [Loc Submission Started (copy)_2687452756758564865]&#10;when &apos;Location Submission Finished&apos; then [Loc Submission Started cleaned (copy)_2687452756758794242]&#10;when &apos;Matching Area Type&apos; then [loc_submission_area_matching_type (copy)_2687452756759060484]&#10;else &apos;-&apos;&#10;END' />
          <calculation column='[Loc Submission Started (copy)_2687452756758564865]' formula='if isnull([loc_submission_started]) then &apos;not_started&apos;&#10;else [loc_submission_started]&#10;end' />
          <calculation column='[Loc Submission Started cleaned (copy)_2687452756758794242]' formula='if isnull([loc_submission_finished]) then &apos;not_finished&apos;&#10;else [loc_submission_finished]&#10;end' />
          <calculation column='[Matching Type (copy)_2687452756758224896]' formula='if ISNULL([location_matching_type]) then &apos;no_matching&apos;&#10;else [location_matching_type]&#10;end' />
          <calculation column='[loc_submission_area_matching_type (copy)_2687452756759060484]' formula='if isnull([loc_submission_area_matching_type]) then &apos;not_matched&apos;&#10;else [loc_submission_area_matching_type]&#10;end' />
          <calculation column='[mCVR4 (copy)_292171070831042560]' formula='sum([sum_mCVR1]) / sum([count_mCVR1])' />
          <calculation column='[reverse_geocoding_failed (copy)_1285988847670525959]' formula='if [reverse_geocoding_failed] = &apos;unnamed_road&apos; &#10;then &#10;[count_sessions] end' />
          <calculation column='[starts_loc_gps_on (copy)_573786799293771786]' formula='IF [loc_submission_finished] IN (&apos;on&apos;) then&#10;    [count_sessions]&#10;ELSE&#10;    NULL&#10;END' />
