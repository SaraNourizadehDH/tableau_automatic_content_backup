    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&\#10;when &apos;cvr&apos; then [Calculation_573786799283916800]&\#10;when &apos;mcvr1&apos; then [mCVR4 (copy)_292171070831042560]&\#10;when &apos;mcvr4&apos; then [Calculation_573786799283990529]&\#10;when &apos;contact_rate&apos; then [Calculation_573786799284228098]&\#10;when &apos;fail_rate&apos; then [Calculation_573786799284641795]&\#10;when &apos;location_fail_rate&apos; then [Calculation_573786799285014532]&\#10;end' />
