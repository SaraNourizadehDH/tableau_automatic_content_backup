  <column aggregation='User' caption='SUM([approximate_matching_events ]) / SUM([Count Sessions])' datatype='real' default-type='quantitative' name='[Calculation_1285988847674576912]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
