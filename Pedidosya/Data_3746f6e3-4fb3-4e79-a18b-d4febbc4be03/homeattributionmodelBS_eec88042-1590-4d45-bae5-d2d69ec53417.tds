        <connection CATALOG='peya-growth-and-onboarding' EXECCATALOG='peya-growth-and-onboarding' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-growth-and-onboarding' schema='automated_tables_reports' server-oauth='' username='guido.oliveri@pedidosya.com' workgroup-auth-mode='prompt' />
