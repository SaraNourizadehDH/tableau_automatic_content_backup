  <column caption='count_shown_completo' datatype='integer' name='[Calculation_455145053097029637]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='//CASE LOWER([jokerType]) WHEN &apos;highlight&apos; then count_shown&#13;&#10;//                        WHEN  &apos;fugaces&apos; then count_shown_joker_fugaces &#13;&#10;//                        ELSE count_shown &#13;&#10;//END&#13;&#10;&#13;&#10;//CASE LOWER([jokerType]) WHEN &apos;highlight&apos; then count_shown&#13;&#10;//                        WHEN  &apos;fugaces&apos; then count_shown_joker_fugaces &#13;&#10;//        &#9;CASE LOWER([Component]) WHEN &apos;brand_shortcut&apos; THEN count_shown_unique_BS       &#13;&#10;//&#9;&#9;&#9;ELSE count_shown &#13;&#10;//&#9;&#9;END &#13;&#10;//END&#13;&#10;&#13;&#10;&#13;&#10;IF LOWER([jokerType]) = &apos;fugaces&apos; then count_shown_joker_fugaces &#13;&#10;ELSEIF LOWER([component]) = &apos;brand_shortcut&apos; THEN count_shown_unique_BS  &#13;&#10;ELSE [count_shown]&#13;&#10;END' />
  </column>
  <column caption='Component Upper' datatype='string' name='[Calculation_455145053103427590]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='UPPER([component])' />
  </column>
  <column caption='CVR Home Component' datatype='real' name='[Calculation_721983329987100672]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([num_attrib_transactions]) &#13;&#10;/ &#13;&#10;SUM([sessions_component_level])' />
  </column>
  <column caption='Component CVR' datatype='real' name='[Calculation_721983329987162113]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([num_attrib_transactions]) / SUM([sum_last_clicked])' />
  </column>
  <column caption='CTR Comp' datatype='real' name='[Calculation_721983329987276802]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([Calculation_874824247948738563]) &#13;&#10;/ &#13;&#10;sum([Calculation_455145053097029637])' />
  </column>
  <column caption='CVR Comp' datatype='real' name='[Calculation_795729778333155328]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([num_attrib_transactions]) &#13;&#10;/ &#13;&#10;SUM([Calculation_874824247948738563])' />
  </column>
  <column caption='Count Clicked Component' datatype='integer' name='[Calculation_874824247948738563]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF LOWER([component]) = &apos;bottom_nav&apos; then [count_clicked_unique_bottom_nav] &#13;&#10;&#9;ELSEIF LOWER([component]) = &apos;brand_shortcut&apos; then [count_clicked_unique_BS]  &#13;&#10;        ELSE [count_clicked] &#13;&#10;END' />
  </column>
