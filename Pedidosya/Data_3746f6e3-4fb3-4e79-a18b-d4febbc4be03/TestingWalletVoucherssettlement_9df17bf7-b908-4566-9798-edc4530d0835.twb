    <worksheet name='Owner &amp; funding'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0gul7sp02siule1ax5ogh1cw6wk7' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euros&quot;'>
              <calculation class='tableau' formula='&quot;Euros&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gul7sp02siule1ax5ogh1cw6wk7'>
            <column caption='Total amount' datatype='real' default-format='n#,##0;-#,##0' name='[GFV fundings (copia)_4066469045483515907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Local currency&quot; THEN [product_fundings]&#13;&#10;    WHEN &quot;Euros&quot; THEN [product_fundings_eu]&#13;&#10;END' />
