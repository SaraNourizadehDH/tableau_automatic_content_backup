      <column caption='GFV share' datatype='real' default-format='p0.00%' name='[Calculation_3169689762421075969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Peya fundings (copia)_4066469045483360258])/SUM([GFV fundings (copia)_4066469045483515907])' />
      </column>
      <column caption='DF&amp;SF amount' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4066469045482954752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Local currency&quot; THEN [funded_peya_lc]&#13;&#10;    WHEN &quot;Euros&quot; THEN [funded_peya_eu]&#13;&#10;END' />
      </column>
      <column caption='Cálculo3' datatype='real' name='[Calculation_4066469045483069441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Currency' datatype='string' name='[Calculation_4066469045534474246]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Euros&quot; THEN &quot;€&quot;&#13;&#10;    WHEN &quot;Local currency&quot; THEN &quot;$&quot;&#13;&#10;END' />
      </column>
      <column caption='Cálculo1' datatype='integer' name='[Calculation_794603911107293184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [funded_peya_lc] &gt; 0 THEN 1 &#13;&#10;ELSEIF [funded_gfv_lc] &gt; 0 THEN 0&#13;&#10;END' />
      </column>
      <column caption='DF&amp;SF share' datatype='real' default-format='p0.00%' name='[Funded gfv (% of total) (copia)_3169689762421477378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4066469045482954752])/SUM([GFV fundings (copia)_4066469045483515907])' />
      </column>
      <column caption='Total amount' datatype='real' default-format='n#,##0;-#,##0' name='[GFV fundings (copia)_4066469045483515907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Local currency&quot; THEN [product_fundings]&#13;&#10;    WHEN &quot;Euros&quot; THEN [product_fundings_eu]&#13;&#10;END' />
