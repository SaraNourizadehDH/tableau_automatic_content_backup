        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kmgqsm0g7oq9p15kuy0m0ft5poi' name='Consulta SQL personalizada' type='text'>WITH country_details AS (&#13;
&#13;
    SELECT &#13;
        co.country_name&#13;
        , e.rate_eu&#13;
        , DATE(PARSE_DATE(&quot;%Y%m%d&quot;, CAST(e.date_id AS STRING))) AS currency_month,&#13;
        FROM `peya-bi-tools-pro.il_core.dim_country` co&#13;
            INNER JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange`  e &#13;
                ON co.currency_id = e.currency_id&#13;
        WHERE co.active&#13;
)&#13;
&#13;
SELECT&#13;
    MAX(fecha) AS data_up_to&#13;
    , DATE_TRUNC(fecha, MONTH) AS month&#13;
    , product_type&#13;
    , category&#13;
    , billing_system&#13;
    , s.country_name&#13;
    , owner&#13;
    , origin&#13;
    , care_category&#13;
    , used_in_darkstore&#13;
    , COUNT(product_id) AS used_products&#13;
    , COUNT(DISTINCT order_id) AS orders&#13;
    , SUM(funding_amount) AS product_fundings&#13;
    , SUM(funding_gfv) AS funded_gfv_lc&#13;
    , SUM(funding_peya) AS funded_peya_lc&#13;
    , SUM(funding_amount / rate_eu) AS product_fundings_eu&#13;
    , SUM(funding_gfv / rate_eu) AS funded_gfv_eu&#13;
    , SUM(funding_peya / rate_eu) AS funded_peya_eu&#13;
FROM `peya-fraud-and-fintech.user_santiago_castillo.delete_wallet_and_vouchers_settlement` s&#13;
    LEFT JOIN country_details cd&#13;
        ON s.country_name = cd.country_name&#13;
        AND DATE_TRUNC(s.fecha, MONTH) = currency_month&#13;
GROUP BY 2,3,4,5,6,7,8,9,10</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1kmgqsm0g7oq9p15kuy0m0ft5poi' name='Consulta SQL personalizada' type='text'>WITH country_details AS (&#13;
