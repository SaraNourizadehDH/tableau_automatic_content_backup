        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rljtr60vjiwxu14moato07rvity' name='Consulta SQL personalizada' type='text'><![CDATA[WITH sessions AS (

SELECT
distinct

session_id
,session_sk
,global_entity_id
,platform
,home_loaded 
,shop_list_loaded  
,shop_details_loaded
,add_cart_clicked
,checkout_loaded
,is_transaction
,shop_impressions_loaded 
,FORMAT_DATE('%F', DATE_TRUNC(sessions.partition_date , WEEK(MONDAY))) AS sessions_session_date_week
,case when  sessions.totals.orders   >>0 then  1   else 0 end  AS sessions_sum_transaction_boolean,
FROM `peya-bi-tools-pro.il_sessions.fact_perseus_sessions` AS sessions

WHERE ((( sessions.partition_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
 WEEK))) AND ( sessions.partition_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
 WEEK), INTERVAL 3
 WEEK))))) AND ((sessions.country_id ) >> 0 OR (sessions.country_id ) IS NULL) AND (sessions.country.country_name ) IS NOT NULL
)
, error_service AS (

WITH app_opened AS (
    SELECT 
    distinct
    sessionid
    ,global_entity_id

    FROM `peya-data-origins-pro.cl_sessions.perseus_events`
    WHERE ((( partition_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
     WEEK))) AND ( partition_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
     WEEK), INTERVAL 3
     WEEK)))))
    AND eventAction = "app.opened"

)

, modal_loaded AS (
     SELECT 
    distinct
    sessionid
    ,global_entity_id

    FROM `peya-data-origins-pro.cl_sessions.perseus_events`
    WHERE ((( partition_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
     WEEK))) AND ( partition_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -3
     WEEK), INTERVAL 3
     WEEK)))))
    AND eventAction = "modal.loaded"
    AND STRING(eventVariablesjson.modalType) = "error_service"
)

SELECT 
DISTINCT 
ao.sessionid
,ao.global_entity_id

FROM app_opened ao
INNER JOIN modal_loaded ml on ml.sessionid = ao.sessionId and ml.global_entity_id = ao.global_entity_id
)

,raw_total_sessions as ( 
SELECT 
distinct
s.session_id
, s.session_sk
,s.global_entity_id
,s.platform
,home_loaded 
,shop_list_loaded  
,shop_details_loaded
,add_cart_clicked
,checkout_loaded
,is_transaction
,shop_impressions_loaded 
,sessions_session_date_week
,sessions_sum_transaction_boolean
,CASE WHEN es.sessionid IS NOT NULL THEN TRUE ELSE FALSE END error_service_session


FROM sessions s
LEFT JOIN error_service es on es.sessionid = s.session_id and es.global_entity_id = s.global_entity_id)


SELECT
sessions_session_date_week,
platform,
CASE WHEN home_loaded  OR shop_list_loaded OR shop_details_loaded OR add_cart_clicked OR checkout_loaded OR is_transaction OR shop_impressions_loaded THEN "FUNNEL" else "NO FUNNEL" end global_group,

CASE WHEN home_loaded  OR shop_list_loaded OR shop_details_loaded OR add_cart_clicked OR checkout_loaded OR is_transaction OR shop_impressions_loaded THEN "FUNNEL"
WHEN home_loaded = FALSE AND shop_list_loaded = FALSE AND shop_details_loaded = FALSE AND add_cart_clicked = FALSE AND checkout_loaded = FALSE AND is_transaction = FALSE AND shop_impressions_loaded = FALSE AND error_service_session = TRUE THEN "NO FUNNEL ERROR SERVICE"
ELSE "NO FUNNEL" end with_error_service_group,

COUNT(DISTINCT session_sk ) AS sessions_total_sessions,
COUNT(DISTINCT case when sessions_sum_transaction_boolean >> 0 then session_sk else null end ) total_sessions_cvr,
COUNT(DISTINCT case when sessions_sum_transaction_boolean >> 0 then session_sk else null end ) / NULLIF(COUNT(DISTINCT session_sk ), 0) AS sessions_kpi_cvr

FROM raw_total_sessions
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
