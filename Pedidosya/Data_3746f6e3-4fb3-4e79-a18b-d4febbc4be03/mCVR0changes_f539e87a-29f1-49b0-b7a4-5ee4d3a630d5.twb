            <column caption='Funnel reclasification' datatype='string' name='[Calculation_984880977777508359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sessions_session_date_week] &lt; DATE(&quot;2025-07-25&quot;) THEN&#13;&#10;    IF [with_error_service_group] = &quot;FUNNEL&quot; THEN &quot;FUNNEL&quot;&#13;&#10;    ELSE &quot;NO FUNNEL&quot; END&#13;&#10;ELSE&#13;&#10;    IF [with_error_service_group] = &quot;FUNNEL&quot; THEN &quot;FUNNEL&quot;&#13;&#10;    ELSEIF [with_error_service_group] = &quot;NO FUNNEL&quot; THEN &quot;NO FUNNEL&quot;&#13;&#10;    ELSE NULL END&#13;&#10;END' />
