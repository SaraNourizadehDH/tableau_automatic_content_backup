        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0du25d20pgcxei16l6pq910v74yf' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
platform,
    CASE WHEN sessions.home_loaded THEN 'HOME' ELSE CASE WHEN ((((sessions.shop_list_loaded OR sessions.shop_details_loaded) OR sessions.add_cart_clicked) OR sessions.checkout_loaded) OR sessions.is_transaction) OR sessions.shop_impressions_loaded THEN 'OTHER' ELSE 'NO FUNNEL' END
 END
 AS `group`,
        (FORMAT_DATE('%F', DATE_TRUNC(sessions.partition_date , WEEK(MONDAY)))) AS sessions_session_date_week,
    COUNT(DISTINCT sessions.session_sk ) AS sessions_total_sessions,
    COUNT(DISTINCT case when  sessions.totals.orders   >>0 then  sessions.session_sk   else null end ) AS sessions_sum_transaction_boolean,
    100*COUNT(DISTINCT case when  sessions.totals.orders   >>0 then  sessions.session_sk   else null end ) / NULLIF(COUNT(DISTINCT sessions.session_sk ), 0) AS sessions_kpi_cvr
FROM `peya-bi-tools-pro.il_sessions.fact_perseus_sessions`
     AS sessions
WHERE ((( sessions.partition_date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -10 WEEK))) AND ( sessions.partition_date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -10 WEEK), INTERVAL 10 WEEK))))) AND ((sessions.country_id ) >> 0 OR (sessions.country_id ) IS NULL) AND (sessions.country.country_name ) IS NOT NULL
GROUP BY
    1,
    2,
    3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
