      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.06kgplv0wyity31d9je4z1e9546o].[sum:sessions_total_sessions:qk]&quot;' value='Total sessions' />
          <alias key='&quot;[federated.06kgplv0wyity31d9je4z1e9546o].[usr:Calculation_984880977751879682:qk:1]&quot;' value='Sessions share_' />
          <alias key='&quot;[federated.06kgplv0wyity31d9je4z1e9546o].[usr:Calculation_984880977751879682:qk]&quot;' value='Sessions share' />
        </aliases>
      </column>
      <column caption='cvr' datatype='real' name='[Calculation_984880977748353024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_sessions_cvr])/sum([sessions_total_sessions])' />
      </column>
      <column caption='Sessions share_' datatype='real' name='[Calculation_984880977751879682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_total_sessions])/TOTAL(sum([sessions_total_sessions]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Estimated CVR' datatype='real' name='[Calculation_984880977753948163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_sessions_cvr]) / SUM(IF [with_error_service_group] != &quot;NO FUNNEL ERROR SERVICE&quot; THEN [sessions_total_sessions] ELSE 0 END)' />
      </column>
      <column caption='Diff' datatype='real' name='[Calculation_984880977755303940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_984880977748353024] - [Calculation_984880977753948163]' />
      </column>
      <column caption='Cálculo1' datatype='integer' name='[Calculation_984880977772679174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cálculo corregido que evita mezclar agregación y no-agregación&#13;&#10;IF [sessions_session_date_week] &lt; DATE(&quot;2025-07-25&quot;) THEN&#13;&#10;    IF [with_error_service_group] = &quot;NO FUNNEL&quot; OR [with_error_service_group] = &quot;NO FUNNEL ERROR SERVICE&quot; THEN&#13;&#10;        [sessions_total_sessions]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [with_error_service_group] = &quot;NO FUNNEL&quot; THEN&#13;&#10;        [sessions_total_sessions]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Funnel reclasification' datatype='string' name='[Calculation_984880977777508359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sessions_session_date_week] &lt; DATE(&quot;2025-07-25&quot;) THEN&#13;&#10;    IF [with_error_service_group] = &quot;FUNNEL&quot; THEN &quot;FUNNEL&quot;&#13;&#10;    ELSE &quot;NO FUNNEL&quot; END&#13;&#10;ELSE&#13;&#10;    IF [with_error_service_group] = &quot;FUNNEL&quot; THEN &quot;FUNNEL&quot;&#13;&#10;    ELSEIF [with_error_service_group] = &quot;NO FUNNEL&quot; THEN &quot;NO FUNNEL&quot;&#13;&#10;    ELSE NULL END&#13;&#10;END' />
      </column>
