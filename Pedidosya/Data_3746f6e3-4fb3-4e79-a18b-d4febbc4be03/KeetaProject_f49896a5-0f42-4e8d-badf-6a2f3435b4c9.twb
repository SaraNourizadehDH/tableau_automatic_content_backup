    <worksheet name='NRT By Hour - Products'>
      <table>
        <view>
          <datasources>
            <datasource caption='NRT' name='federated.1mko05d0krss8v127ha6i0gcdn8u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Partners' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Burger King Bulnes&quot;'>
              <calculation class='tableau' formula='&quot;Burger King Bulnes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mko05d0krss8v127ha6i0gcdn8u'>
            <column caption='Partner Name Relation' datatype='string' name='[Calculation_219832008658128897]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF name = &quot;Burger King Canning Descuentos De Verano&quot; THEN &quot;Burger King Canning&quot;&#13;&#10;ELSEIF [name] = &quot;Burger King Bulnes Descuentos De Verano&quot; THEN &quot;Burger King Bulnes&quot;&#13;&#10;ELSEIF [name] = &quot;Mostaza Juan B Justo - Descuentos De Verano&quot; THEN &quot;Mostaza - Juan B Justo&quot; &#13;&#10;ELSEIF [name] = &quot;Mostaza Alto Palermo - Descuentos De Verano&quot; THEN &quot;Mostaza Alto Palermo Shopping&quot;&#13;&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='Qty Products of Campaign - Partner Clonados' datatype='integer' name='[Confirmed Orders - Partner Clonados (copy)_219832008714465284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ZN({ FIXED [order_id] : MAX(IF name = [Partners Clonados] THEN 1 END)})&#13;&#10;&#13;&#10;SUM(IF [product_of_the_campaign] = TRUE AND [Calculation_219832008658128897] = [Parameters].[Parameter 2] THEN product_quantity END )' />
            </column>
            <column caption='Qty Products of Campaign L4W - Partner Originales' datatype='integer' name='[Confirmed Orders L2W - Partner Originales (copy)_219832008715292677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ FIXED [order_id] : MAX(IF [date] &gt;= DATE(&quot;2024-01-15&quot;) AND [date] &lt;= DATE(&quot;2024-01-28&quot;) AND name = [Partners Originales] THEN 1 END)}&#13;&#10;&#13;&#10;SUM(IF [product_of_the_campaign] = TRUE AND [date] &gt;= DATE(&quot;2024-01-08&quot;) AND [date] &lt;= DATE(&quot;2024-02-04&quot;) AND name = [Parameters].[Parameter 2] THEN product_quantity END )' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[day_of_week]' role='dimension' type='nominal' />
            <column caption='fixed_avg_products_campaign_L2W' datatype='real' name='[fixed_avg_confirmed_orders_L2W (copy)_1973702588334764051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//AVG({ FIXED [name], [day_of_week], [hour] : COUNTD(IF [date] &gt;= date(&quot;2024-01-08&quot;) AND date &lt;= date(&quot;2024-01-21&quot;) AND [product_of_the_campaign] = TRUE THEN [product_id] END) })&#13;&#10;/// 2&#13;&#10;&#13;&#10;&#13;&#10;ZN(ROUND({ FIXED [day_of_week],[hour] : AVG({ FIXED  [day_of_week],[hour],[week_date]  : ([Confirmed Orders L2W - Partner Originales (copy)_219832008715292677]) })},0))' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='MDY' name='[md:date:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[name]' role='dimension' type='nominal' />
            <column-instance column='[hour]' derivation='None' name='[none:hour:ok]' pivot='key' type='ordinal' />
            <column datatype='boolean' name='[product_of_the_campaign]' role='dimension' type='nominal' />
            <column datatype='integer' name='[product_quantity]' role='measure' type='quantitative' />
            <column-instance column='[fixed_avg_confirmed_orders_L2W (copy)_1973702588334764051]' derivation='Sum' name='[sum:fixed_avg_confirmed_orders_L2W (copy)_1973702588334764051:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Confirmed Orders - Partner Clonados (copy)_219832008714465284]' derivation='User' name='[usr:Confirmed Orders - Partner Clonados (copy)_219832008714465284:qk]' pivot='key' type='quantitative' />
            <column datatype='datetime' name='[week_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1mko05d0krss8v127ha6i0gcdn8u].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1mko05d0krss8v127ha6i0gcdn8u].[usr:Confirmed Orders - Partner Clonados (copy)_219832008714465284:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1mko05d0krss8v127ha6i0gcdn8u].[sum:fixed_avg_confirmed_orders_L2W (copy)_1973702588334764051:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1mko05d0krss8v127ha6i0gcdn8u].[md:date:ok]</column>
            <column>[federated.1mko05d0krss8v127ha6i0gcdn8u].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.1mko05d0krss8v127ha6i0gcdn8u].[Multiple Values]' scope='rows' value='false' />
          </style-rule>
