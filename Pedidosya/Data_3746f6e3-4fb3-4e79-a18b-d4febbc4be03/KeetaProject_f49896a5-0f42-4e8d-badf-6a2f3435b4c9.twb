      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_FA21C5836028494EAD87A0B910466B14'>
            <properties context=''>
              <relation connection='bigquery.0izshq71su4t7r10gipy71fs6qkr' name='Custom SQL Query' type='text'>WITH dates AS (&#13;
  &#13;
    SELECT &#13;
      DATE(&quot;2024-01-01&quot;) AS date_begin,&#13;
      DATE(&quot;2024-02-16&quot;) AS end_date  &#13;
&#13;
), partners AS (&#13;
  SELECT partner_id, &#13;
         partner_name,&#13;
         franchise.franchise_name,&#13;
         CASE WHEN partner_id IN (480376,480347,480364,480367) THEN &quot;PARTNER CLONADO&quot; ELSE &quot;PARTNER ORIGINAL&quot; END AS partner_type&#13;
  FROM `peya-bi-tools-pro.il_core.dim_partner` &#13;
  WHERE 1 = 1&#13;
  &#13;
  AND &#13;
  (  &#13;
    /* ZONA: CABALLITO */ &#13;
      partner_id IN (16733) /* BK ORIGINAL*/&#13;
    OR partner_id IN (480376) /* BK CLONADO*/&#13;
    OR partner_id IN (352973) /* Mostaza ORIGINAL*/&#13;
    OR partner_id IN (480347) /* Mostaza CLONADO*/&#13;
    /* ZONA: PALERMO */&#13;
    OR partner_id IN (6412) /* BK ORIGINAL*/&#13;
    OR partner_id IN (480364) /* BK CLONADO*/&#13;
    OR partner_id IN (55837) /* Mostaza ORIGINAL*/&#13;
    OR partner_id IN (480367) /* Mostaza CLONADO*/&#13;
  )&#13;
&#13;
), users_max_order_date AS (&#13;
    SELECT DISTINCT &#13;
        o.user.id as user_id,&#13;
        MAX(DATE(o.registered_date)) as max_date&#13;
  FROM peya-bi-tools-pro.il_core.fact_orders as o&#13;
  INNER JOIN peya-bi-tools-pro.il_core.dim_user AS u ON u.user_id = o.user.id&#13;
  WHERE o.registered_date BETWEEN &quot;2010-01-01&quot; AND &quot;2024-02-04&quot;&#13;
  AND o.country_id = 3 &#13;
  AND o.order_status = &quot;CONFIRMED&quot;&#13;
  GROUP BY 1&#13;
  ORDER BY 1&#13;
),orders_with_products AS (&#13;
&#13;
  SELECT  DISTINCT &#13;
          o.id as order_id,&#13;
  FROM `peya-data-origins-pro.cl_core.orders` AS o&#13;
  LEFT JOIN UNNEST(o.details) AS d&#13;
  WHERE DATE(o.registeredDate) BETWEEN (SELECT date_begin FROM dates) AND (SELECT end_date FROM dates)&#13;
  AND o.restaurant.id IN (&#13;
    SELECT DISTINCT partner_id FROM partners&#13;
  )&#13;
  AND d.product.id IN &#13;
  (&#13;
     137587621&#13;
    ,137587639&#13;
    ,138544233&#13;
    ,138544326&#13;
    ,137423519&#13;
    ,137423584&#13;
    ,137423519&#13;
    ,137423520&#13;
    ,137587621&#13;
    ,137587639&#13;
    ,138544233&#13;
    ,138544326&#13;
    ,137423633&#13;
    ,137429159&#13;
    ,137423633&#13;
    ,137423636&#13;
    ,138044237&#13;
    ,138044462&#13;
    ,1089675883&#13;
    ,1089674550&#13;
    ,1089680236&#13;
    ,1089680236&#13;
  )&#13;
&#13;
)&#13;
&#13;
SELECT  DATE(o.registeredDate) AS date,&#13;
        DATE_TRUNC(o.registeredDate,WEEK(MONDAY)) AS week_date,&#13;
        EXTRACT(hour from o.registeredDate) as hour,&#13;
        FORMAT_DATE(&apos;%A&apos;, DATE(o.registeredDate)) as day_of_week,&#13;
        restaurant.id,&#13;
        restaurant.name,&#13;
        partners.franchise_name,&#13;
        partners.partner_type,&#13;
        o.id AS order_id,&#13;
        user.id AS user_id,&#13;
        ui.income,&#13;
        o.data.firstSuccessful AS is_acq,&#13;
        CASE WHEN DATE_DIFF(DATE(registeredDate), um.max_date, day) &gt;&gt;= 90 THEN &quot;REACTIVACION&quot; ELSE NULL END as reactivation,&#13;
        CASE WHEN orders_with_products.order_id IS NOT NULL THEN TRUE ELSE FALSE END as is_products_selected,&#13;
        d.product.id as product_id,&#13;
        CASE WHEN d.product.id IN &#13;
                              (&#13;
                              137587621&#13;
                              ,137587639&#13;
                              ,138544233&#13;
                              ,138544326&#13;
                              ,137423519&#13;
                              ,137423584&#13;
                              ,137423519&#13;
                              ,137423520&#13;
                              ,137587621&#13;
                              ,137587639&#13;
                              ,138544233&#13;
                              ,138544326&#13;
                              ,137423633&#13;
                              ,137429159&#13;
                              ,137423633&#13;
                              ,137423636&#13;
                              ,138044237&#13;
                              ,138044462&#13;
                              ,1089675883&#13;
                              ,1089674550&#13;
                              ,1089680236&#13;
                              ,1089680236&#13;
                              ) THEN TRUE ELSE FALSE END AS product_of_the_campaign,&#13;
        d.product.name as product_name,&#13;
        d.quantity as product_quantity,&#13;
&#13;
FROM `peya-data-origins-pro.cl_core.orders` AS o&#13;
LEFT JOIN  peya-bi-tools-pro.il_growth.user_income AS ui ON ui.user_id = o.user.id&#13;
LEFT JOIN users_max_order_date AS um ON um.user_id = o.user.id&#13;
LEFT JOIN partners ON partners.partner_id = o.restaurant.id&#13;
LEFT JOIN orders_with_products ON orders_with_products.order_id = o.id&#13;
LEFT JOIN UNNEST(details) AS d&#13;
WHERE DATE(TIMESTAMP_TRUNC(registeredDate, DAY)) BETWEEN (SELECT date_begin FROM dates) AND (SELECT end_date FROM dates)&#13;
AND restaurant.id IN (&#13;
  SELECT DISTINCT partner_id FROM partners&#13;
)&#13;
AND o.state = &quot;CONFIRMED&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
