            <format attr='text-format' field='[federated.1mko05d0krss8v127ha6i0gcdn8u].[sum:fixed_avg_confirmed_orders_L2W (copy)_1973702588334764051:qk]' value='N' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width-header' value='140' />
          </style-rule>
        </style>
