      <aliases enabled='yes' />
      <column caption='KPI Selected' datatype='real' name='[Calculation_1973702588260708352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Confirmed Orders&quot; THEN [Calculation_1973702588263403521]&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Fail Rate&quot; THEN [cf_confirmed_orders (copy)_1973702588263473154]&#13;&#10;ELSE SUM(0) END' />
      </column>
      <column caption='cf_confirmed_orders' datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Calculation_1973702588263403521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_confirmed_orders])' />
      </column>
      <column caption='fixed_avg_confirmed_orders_L2W' datatype='real' name='[Calculation_1973702588267376644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//{ FIXED [Partner Name],[day_of_week] : AVG({ FIXED  [Partner Name],[day_of_week],[Week Date] : SUM(IF [Date] &gt;= DATE(&quot;2024-01-15&quot;) AND [Date] &lt;= DATE(&quot;2024-01-28&quot;) THEN [Qty Confirmed Orders] END) })}&#13;&#10;&#13;&#10;{ FIXED [partner_name],[day_of_week] : AVG({ FIXED  [partner_name],[day_of_week],[week_date] : [cf_confirmed_orders (copy)_1371064663752589312] })}' />
      </column>
      <column caption='cf_partner_date' datatype='string' name='[Calculation_1973702588305612806]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([partner_name]) + STR([date])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='keeta_project_data_orders' datatype='table' name='[__tableau_internal_object_id__].[keeta_project_data_orders_DBE2E38E4F2746D8A706137077046968]' role='measure' type='quantitative' />
      <column caption='Active Customers' datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
      <column caption='Assumed Preptime' datatype='integer' name='[assumed_preptime]' role='measure' type='quantitative' />
