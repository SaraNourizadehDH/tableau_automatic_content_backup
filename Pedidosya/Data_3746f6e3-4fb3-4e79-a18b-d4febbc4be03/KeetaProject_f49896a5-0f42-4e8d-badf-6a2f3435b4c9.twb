              <calculation class='tableau' formula='&quot;Burger King Bulnes&quot;' />
            </column>
            <column caption='Only with products of campaign?' datatype='boolean' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mko05d0krss8v127ha6i0gcdn8u'>
            <column caption='fixed_avg_confirmed_orders_L2W' datatype='real' name='[Calculation_1973702588326326285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ROUND({ FIXED [name],[day_of_week], [hour] : AVG({ FIXED  [name],[day_of_week],[hour], [week_date]  : SUM([Confirmed Orders L2W - Partner Originales]) })},0)&#13;&#10;&#13;&#10;ZN(ROUND({ FIXED [day_of_week],[hour] : AVG({ FIXED  [day_of_week],[hour],[week_date]  : SUM([Confirmed Orders (copy)_219832008615563264]) })},0))' />
            </column>
            <column caption='Partner Name Relation' datatype='string' name='[Calculation_219832008658128897]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF name = &quot;Burger King Canning Descuentos De Verano&quot; THEN &quot;Burger King Canning&quot;&#13;&#10;ELSEIF [name] = &quot;Burger King Bulnes Descuentos De Verano&quot; THEN &quot;Burger King Bulnes&quot;&#13;&#10;ELSEIF [name] = &quot;Mostaza Juan B Justo - Descuentos De Verano&quot; THEN &quot;Mostaza - Juan B Justo&quot; &#13;&#10;ELSEIF [name] = &quot;Mostaza Alto Palermo - Descuentos De Verano&quot; THEN &quot;Mostaza Alto Palermo Shopping&quot;&#13;&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='Confirmed Orders L4W - Partner Originales' datatype='integer' name='[Confirmed Orders (copy)_219832008615563264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_id] : MAX(IF [date] &gt;= DATE(&quot;2024-01-01&quot;) AND [date] &lt;= DATE(&quot;2024-02-04&quot;) AND name = [Parameters].[Parameter 2] AND (IF [Parameters].[Parameter 4] = TRUE THEN [is_products_selected] = [Parameters].[Parameter 4] ELSE TRUE = TRUE END) THEN 1 END)}' />
            </column>
            <column caption='Confirmed Orders - Partner Originales' datatype='integer' name='[Confirmed Orders - Partner Clonados (copy)_97108919532777473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN({ FIXED [order_id] : MAX(IF name = [Parameters].[Parameter 2] AND (IF [Parameters].[Parameter 4] = TRUE THEN [is_products_selected] = [Parameters].[Parameter 4] ELSE TRUE = TRUE END)  THEN 1 END)})' />
            </column>
            <column caption='Confirmed Orders - Total' datatype='integer' name='[Confirmed Orders - Partner Clonados (copy)_97108919533555714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Confirmed Orders L2W - Partner Example (copy)_219832008686583811] + [Confirmed Orders - Partner Clonados (copy)_97108919532777473]' />
            </column>
            <column caption='Share Partners Clonados' datatype='real' name='[Confirmed Orders - Total (copy)_2265310665150128128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Confirmed Orders L2W - Partner Example (copy)_219832008686583811] / [Confirmed Orders - Partner Clonados (copy)_97108919533555714]' />
