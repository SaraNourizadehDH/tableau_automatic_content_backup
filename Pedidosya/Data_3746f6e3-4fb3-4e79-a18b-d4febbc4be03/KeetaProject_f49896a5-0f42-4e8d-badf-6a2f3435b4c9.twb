            <column caption='cf_confirmed_orders' datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Calculation_1973702588263403521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders])' />
            </column>
            <column caption='fixed_avg_confirmed_orders_L2W' datatype='real' name='[Calculation_1973702588267376644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ FIXED [Partner Name],[day_of_week] : AVG({ FIXED  [Partner Name],[day_of_week],[Week Date] : SUM(IF [Date] &gt;= DATE(&quot;2024-01-15&quot;) AND [Date] &lt;= DATE(&quot;2024-01-28&quot;) THEN [Qty Confirmed Orders] END) })}&#13;&#10;&#13;&#10;{ FIXED [partner_name],[day_of_week] : AVG({ FIXED  [partner_name],[day_of_week],[week_date] : [cf_confirmed_orders (copy)_1371064663752589312] })}' />
            </column>
            <column-instance column='[Calculation_1973702588267376644]' derivation='Avg' name='[avg:Calculation_1973702588267376644:ok]' pivot='key' type='ordinal' />
            <column caption='Confirmed Orders LW2 - Partners Originales' datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[cf_confirmed_orders (copy)_1371064663752589312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date] &gt;= DATE(&quot;2024-01-15&quot;) AND [date] &lt;= DATE(&quot;2024-01-28&quot;) AND [partner_name] = [Parameters].[Parameter 2] THEN [qty_confirmed_orders] END)&#13;&#10;//{ FIXED [order_id] : MAX(IF [date] &gt;= DATE(&quot;2024-01-15&quot;) AND [date] &lt;= DATE(&quot;2024-01-28&quot;) AND name = [Partners Originales] THEN 1 END)}' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[day_of_week]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='MDY' name='[md:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[day_of_week]' derivation='None' name='[none:day_of_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[partner_name]' derivation='None' name='[none:partner_name:nk]' pivot='key' type='nominal' />
            <column caption='Partner Name' datatype='string' name='[partner_name]' role='dimension' type='nominal' />
            <column caption='Qty Confirmed Orders' datatype='integer' name='[qty_confirmed_orders]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Day-Trunc' name='[tdy:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1973702588263403521]' derivation='User' name='[usr:Calculation_1973702588263403521:ok]' pivot='key' type='ordinal' />
            <column caption='Week Date' datatype='date' name='[week_date]' role='dimension' type='ordinal' />
