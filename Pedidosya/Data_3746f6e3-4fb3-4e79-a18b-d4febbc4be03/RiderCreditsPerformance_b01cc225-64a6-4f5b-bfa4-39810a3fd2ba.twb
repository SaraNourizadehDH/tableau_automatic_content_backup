      <aliases enabled='yes' />
      <column caption='Cohorts - Orders Per Hour Prev' datatype='string' name='[Calculation_2046886056016379904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_per_minute_4_prev_week (rider_credits_matched_cases_tableau)] &lt;= 1&#13;&#10;THEN &apos;a-[0-1]&apos;&#13;&#10;ELSEIF [orders_per_minute_4_prev_week (rider_credits_matched_cases_tableau)] &lt;= 2&#13;&#10;THEN &apos;b-(1-2]&apos;&#13;&#10;ELSEIF [orders_per_minute_4_prev_week (rider_credits_matched_cases_tableau)] &lt;= 3&#13;&#10;THEN &apos;c-(2-3]&apos;&#13;&#10;ELSEIF [orders_per_minute_4_prev_week (rider_credits_matched_cases_tableau)] &lt;= 4&#13;&#10;THEN &apos;d-(3-4]&apos;&#13;&#10;ELSE &apos;e-(4 OR MORE)&apos;&#13;&#10;END' />
      </column>
      <column caption='Conteo Casos' datatype='integer' name='[Calculation_2046886056018395137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([treatment (rider_credits_matched_cases_tableau)])' />
      </column>
      <column caption='Cohorts - Total Orders  Prev ' datatype='string' name='[Cohorts - Orders Per Hour Prev (copia)_2046886056019214338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_orders_4_prev_week] &lt;= 10&#13;&#10;THEN &apos;a-[0-100]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 200&#13;&#10;THEN &apos;b-(100-200]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 300&#13;&#10;THEN &apos;c-(200-300]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 400&#13;&#10;THEN &apos;d-(300-400]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 500&#13;&#10;THEN &apos;e-(400-500]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 600&#13;&#10;THEN &apos;f-(500-600]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 700&#13;&#10;THEN &apos;g-(600-700]&apos;&#13;&#10;ELSEIF [total_orders_4_prev_week] &lt;= 800&#13;&#10;THEN &apos;h-(700-800]&apos;&#13;&#10;ELSE &apos;m-(800 OR MORE)&apos;&#13;&#10;END' />
      </column>
      <column caption='Cohorts - Working Minutes Ratio  Prev ' datatype='string' name='[Cohorts - Total Orders  Prev  (copia)_2046886056022556675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [working_minutes_ratio_4_prev_week] &lt;= 50&#13;&#10;THEN &apos;a-[0-50]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 60&#13;&#10;THEN &apos;b-(50-60]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 70&#13;&#10;THEN &apos;c-(60-70]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 80&#13;&#10;THEN &apos;d-(70-80]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 90&#13;&#10;THEN &apos;e-(80-90]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &gt; 90&#13;&#10;THEN &apos;f-(90-100]&apos;&#13;&#10;ELSE &apos;g-(ERROR)&apos;&#13;&#10;END' />
      </column>
