            </column>
            <column caption='Cohorts - Working Minutes Ratio  Prev ' datatype='string' name='[Cohorts - Total Orders  Prev  (copia)_2046886056022556675]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [working_minutes_ratio_4_prev_week] &lt;= 50&#13;&#10;THEN &apos;a-[0-50]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 60&#13;&#10;THEN &apos;b-(50-60]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 70&#13;&#10;THEN &apos;c-(60-70]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 80&#13;&#10;THEN &apos;d-(70-80]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &lt;= 90&#13;&#10;THEN &apos;e-(80-90]&apos;&#13;&#10;ELSEIF [working_minutes_ratio_4_prev_week] &gt; 90&#13;&#10;THEN &apos;f-(90-100]&apos;&#13;&#10;ELSE &apos;g-(ERROR)&apos;&#13;&#10;END' />
            </column>
            <column-instance column='[working_minutes_ratio_4_post_week]' derivation='Avg' name='[avg:working_minutes_ratio_4_post_week:qk]' pivot='key' type='quantitative' />
