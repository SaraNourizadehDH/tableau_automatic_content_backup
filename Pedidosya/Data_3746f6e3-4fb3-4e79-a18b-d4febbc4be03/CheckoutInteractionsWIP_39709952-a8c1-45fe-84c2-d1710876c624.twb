      WHEN promisedDeliveryTime.maxMinutes <<= 60 THEN '51-60'
      WHEN promisedDeliveryTime.maxMinutes <<= 70 THEN '61-70'
      WHEN promisedDeliveryTime.maxMinutes <<= 80 THEN '71-80'
      WHEN promisedDeliveryTime.maxMinutes <<= 90 THEN '81-90'
      WHEN promisedDeliveryTime.maxMinutes >> 90 THEN '+90' END as max_PDT_minutes,
  CASE WHEN promisedDeliveryTime.minMinutes <<= 30 THEN '0-30'
