      <aliases enabled='yes' />
      <column caption='AccR' datatype='real' name='[Calculation_1533757178326040599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_scc_purchases])/SUM([qty_purchases])' />
      </column>
      <column caption='Rej Rate' datatype='real' name='[Calculation_1533757178342871065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rej_owner] != &apos;FULFILLED&apos; THEN [qty_purchases]ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <column caption='Val Rej Rate' datatype='real' name='[Calculation_1533757178347298843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rej_owner] = &apos;VALIDATION&apos; THEN [qty_purchases] ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_purchases]) / TOTAL(SUM([qty_purchases]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Others Rej Rate' datatype='real' name='[Val Rej Rate (copia) (copia) (copia)_1533757178347466782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rej_owner] = &apos;CREATION&apos; THEN [qty_purchases] ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <column caption='Pay Rej Rate ' datatype='real' name='[Val Rej Rate (copia) (copia)_1533757178347454493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rej_owner] = &apos;PAYMENT&apos; THEN [qty_purchases] ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <column caption='Risk Rej Rate ' datatype='real' name='[Val Rej Rate (copia)_1533757178347442204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rej_owner] = &apos;RISK&apos; THEN [qty_purchases] ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_03EC9EBCD2B94294A9A1B5998BAF4BA8]' role='measure' type='quantitative' />
      <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[last_payment_method_brand]' role='dimension' type='nominal' />
      <column datatype='string' name='[last_payment_method_type_2]' role='dimension' type='nominal' />
      <column datatype='string' name='[rej_owner]' role='dimension' type='nominal' />
      <column-instance column='[last_payment_method_brand]' derivation='None' name='[none:last_payment_method_brand:nk]' pivot='key' type='nominal' />
