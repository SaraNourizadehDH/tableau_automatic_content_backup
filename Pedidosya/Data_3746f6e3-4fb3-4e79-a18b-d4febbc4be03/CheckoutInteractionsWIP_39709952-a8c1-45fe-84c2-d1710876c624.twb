            <column caption='Share On Delivery Payments Orders' datatype='real' name='[Calculation_1533757176868491279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_online_payment] = 0 THEN [qty_orders] ELSE 0 END)/SUM([qty_orders])' />
