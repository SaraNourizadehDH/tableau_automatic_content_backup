      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Checkout Interactions' name='federated.1iw6bmq010gdk1127c4910cm4zht' />
          </datasources>
          <datasource-dependencies datasource='federated.1iw6bmq010gdk1127c4910cm4zht'>
            <column caption='Qty Sessions Add Card' datatype='real' name='[Calculation_450641494826782721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [tp_add_card]=1 AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
            </column>
            <column caption='Qty Sessions Boton Pedir' datatype='real' name='[Qty Sessions Add Card (copia)_450641494828654595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [tp_boton_pedir]=1  AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
            </column>
            <column caption='Qty Sessions Transaction' datatype='real' name='[Qty Sessions Boton Pedir (copia)_1533757176804212744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_transaction]=1  AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
            </column>
            <column caption='Qty Sessions Change Address' datatype='real' name='[Qty Sessions Boton Pedir (copia)_450641494829191172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [tp_change_address]=1  AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
            </column>
            <column caption='Qty Sessions Coupons' datatype='real' name='[Qty Sessions Change Address (copia)_450641494829596677]' role='measure' type='quantitative'>
