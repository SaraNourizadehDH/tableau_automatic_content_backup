      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1iw6bmq010gdk1127c4910cm4zht].[usr:Qty Sessions Add Card (copia)_450641494828654595:qk]&quot;' value='Checkout Success' />
          <alias key='&quot;[federated.1iw6bmq010gdk1127c4910cm4zht].[usr:Qty Sessions Boton Pedir (copia)_1533757176804212744:qk]&quot;' value='mcvr4' />
        </aliases>
      </column>
      <column caption='Fixed Qty Sessions' datatype='integer' name='[Calculation_1240741755217379328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Calculation_3105231995967156224]:SUM([qty_sessions])}' />
      </column>
      <column caption='Voucher Redeem Failure' datatype='real' name='[Calculation_1533757180471025704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [v_redeem_coupon_failed] = 1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
      </column>
      <column caption='CONCAT INTERACTION' datatype='string' name='[Calculation_3105231995967156224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(IF [tp_change_address] = 1 then &apos;ADDRESS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_delivery_notes] = 1 then &apos;DELIVERY NOTES-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_payment_methods_screen] = 1 then &apos;PAYMENT METHODS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_add_card] = 1 then &apos;ADD CARD-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_coupons] = 1 then &apos;VOUCHERS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_priority_delivery] = 1 then &apos;PRIORITY DELIVERY-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_tips_interaction] = 1 then &apos;TIPS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_boton_pedir] = 1 then &apos;TRX INTENTION-&apos; ELSE &apos;&apos; END)=&apos;&apos; THEN &apos;NO INTERACTION&apos;&#13;&#10;ELSE (IF [tp_change_address] = 1 then &apos;ADDRESS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_delivery_notes] = 1 then &apos;DELIVERY NOTES-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_payment_methods_screen] = 1 then &apos;PAYMENT METHODS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_add_card] = 1 then &apos;ADD CARD-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_coupons] = 1 then &apos;VOUCHERS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_priority_delivery] = 1 then &apos;PRIORITY DELIVERY-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_tips_interaction] = 1 then &apos;TIPS-&apos; ELSE &apos;&apos; END &#13;&#10;+&#13;&#10;IF [tp_boton_pedir] = 1 then &apos;TRX INTENTION-&apos; ELSE &apos;&apos; END) END' />
      </column>
      <column caption='Rank' datatype='integer' datatype-customized='true' name='[Calculation_3105231999796387848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(([Calculation_450641494902181905]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Qty Sessions Add Card' datatype='real' name='[Calculation_450641494826782721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [tp_add_card]=1 AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
      </column>
      <column caption='DUT' datatype='date' name='[Calculation_450641494838841358]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :MAX([date_created_utc])}' />
      </column>
      <column caption='Qty Sessions Cho Loaded' datatype='integer' name='[Calculation_450641494902181905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1240741755217379328]) / TOTAL(SUM([Calculation_1240741755217379328]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='real' name='[Cálculo2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Qty Sessions Boton Pedir (copia)_1533757176804212744]) - LOOKUP(ZN([Qty Sessions Boton Pedir (copia)_1533757176804212744]), -1)'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='Qty Sessions Boton Pedir' datatype='real' name='[Qty Sessions Add Card (copia)_450641494828654595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [tp_boton_pedir]=1  AND [checkout_loaded]=1 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
      </column>
      <column caption='Qty Sessions Dropped Pre Checkout' datatype='real' name='[Qty Sessions Add Card (copia)_450641494906810391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [checkout_loaded]=0 AND [has_transaction]=0 THEN [qty_sessions] ELSE 0 END)/SUM([qty_sessions])' />
      </column>
      <column caption='Qty Sessions Transaction' datatype='real' name='[Qty Sessions Boton Pedir (copia)_1533757176804212744]' role='measure' type='quantitative'>
