    <datasource caption='Purchase AccR' inline='true' name='federated.00ilggi09gsr8m16vl5fr1ycj5l3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.12vpca60gg2qsp1h3dx2b1frdysw'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_santiago_castillo' server-oauth='' username='santiago.castillo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12vpca60gg2qsp1h3dx2b1frdysw' name='Consulta SQL personalizada' type='text'>WITH validation_errors AS (&#13;
SELECT&#13;
DISTINCT p.id as purchase_id,&#13;
--first_value (v.result) over (partition by p.id order by c desc) as result,&#13;
first_value (CASE WHEN v.step IS NULL THEN v.result ELSE v.step END) over (partition by p.id order by c desc) as val_reason,&#13;
FROM `peya-data-origins-pro.cl_payments.purchase` p&#13;
LEFT JOIN unnest(p.validations) v, unnest(v.concepts) c&#13;
WHERE date_created &gt;&gt;= &apos;2024-04-01&apos;&#13;
AND v.result != &apos;ACCEPTED&apos;),&#13;
&#13;
payment_errors AS (&#13;
SELECT&#13;
DISTINCT payment_info.purchase_id,&#13;
first_value (payment_reject_reason) over (partition by payment_info.purchase_id order by payment_id desc) as pay_reason&#13;
FROM `peya-bi-tools-pro.il_payments.fact_payments_transaction`&#13;
WHERE date_created &gt;&gt;= &apos;2024-04-01&apos;&#13;
AND payment_type = &apos;ORDER&apos;&#13;
AND payment_reject_reason NOT IN (&apos;FRAUD_RISK&apos;,&apos;SPREEDLY_DM&apos;,&apos;CVV_NOT_PROVIDED&apos;)&#13;
AND payment_state NOT IN (&apos;ACCEPTED&apos;,&apos;AUTHORIZED&apos;,&apos;REFUNDED&apos;,&apos;CANCELLED&apos;,&apos;CHARGEBACK&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CREATED&apos;)&#13;
),&#13;
&#13;
risk_errors AS (&#13;
SELECT DISTINCT external_id as purchase_id,&#13;
first_value(result) over (partition by external_id order by date_created desc) as risk_result,&#13;
FROM `peya-data-origins-pro.cl_fraud_risk.scoring`&#13;
WHERE date_created &gt;&gt;= &apos;2024-04-01&apos;&#13;
AND event_id = &apos;PURCHASE&apos;&#13;
AND result != &apos;ACCEPT&apos;&#13;
--AND status = &apos;Finished&apos;&#13;
),&#13;
&#13;
instruments AS (&#13;
  SELECT&#13;
DISTINCT&#13;
external_reference_id purchase_id,&#13;
FIRST_VALUE(payment_method) OVER(PARTITION BY external_Reference_id ORDER BY date_created ASC) first_payment_method_type,&#13;
FIRST_VALUE(instrument_id) OVER(PARTITION BY external_Reference_id ORDER BY date_created ASC) first_payment_method_instrument_id,&#13;
FIRST_VALUE(payment_method) OVER(PARTITION BY external_Reference_id ORDER BY date_created DESC) last_payment_method_type,&#13;
FIRST_VALUE(instrument_id) OVER(PARTITION BY external_Reference_id ORDER BY date_created DESC) last_payment_method_instrument_id&#13;
&#13;
FROM `peya-data-origins-pro.cl_payments.payments_data_payments`&#13;
WHERE TRUE &#13;
-- AND status IN (&quot;AUTHORIZED&quot;, &quot;ACCEPTED&quot;, &quot;CHARGEBACK&quot;, &quot;REFUNDED&quot;, &quot;PARTIAL_REFUNDED&quot;)&#13;
AND payment_method != &quot;WALLET&quot;&#13;
AND payment_type = &quot;ORDER&quot;&#13;
AND DATE(date_created) &gt;&gt;= &apos;2024-04-01&apos;&#13;
),&#13;
&#13;
&#13;
base AS (&#13;
SELECT&#13;
DISTINCT p.id as purchase_id,&#13;
f.reference_id as fulfill_reference_id,&#13;
p.country as country_code,&#13;
p.application,&#13;
date_created,&#13;
--first_payment_method_type,&#13;
--last_payment_method_type,&#13;
FIRST_VALUE (payment_method.type) OVER(partition by p.id ORDER BY c.id DESC) as last_payment_method_type_2,&#13;
--first_payment_method_instrument_id,&#13;
--last_payment_method_instrument_id,&#13;
FIRST_VALUE (payment_method.instrument.card.brand) OVER(partition by p.id ORDER BY c.id DESC) as last_payment_method_brand,&#13;
CASE WHEN val_reason IS NULL THEN &apos;SEAMLESS VALIDATION&apos; ELSE val_reason END AS validation,&#13;
CASE WHEN pay_reason IS NULL THEN &apos;SEAMLESS PAYMENT&apos; ELSE pay_reason END AS payment,&#13;
CASE WHEN risk_result IS NULL THEN &apos;SEAMLESS RISK&apos; ELSE risk_result END AS risk,&#13;
FROM `peya-data-origins-pro.cl_payments.purchase` p, unnest(concepts) c, unnest(breakdown) b&#13;
LEFT JOIN UNNEST(fulfillment) f&#13;
--LEFT JOIN instruments i ON i.purchase_id = p.id&#13;
LEFT JOIN validation_errors ve ON ve.purchase_id = p.id&#13;
LEFT JOIN payment_errors pe ON pe.purchase_id = p.id&#13;
LEFT JOIN risk_errors re ON re.purchase_id = p.id&#13;
WHERE p.date_created &gt;&gt;= &apos;2024-04-01&apos;&#13;
AND c.type like &apos;%%ORDER%%&apos;)&#13;
&#13;
SELECT&#13;
DATE(b.date_created) AS date_created_utc,&#13;
country_code,&#13;
CASE WHEN fulfill_reference_id IS NULL AND payment = &apos;SEAMLESS PAYMENT&apos; AND risk = &apos;SEAMLESS RISK&apos; AND validation = &apos;SEAMLESS VALIDATION&apos; THEN &apos;CREATION&apos; &#13;
WHEN fulfill_reference_id IS NULL AND payment != &apos;SEAMLESS PAYMENT&apos; THEN &apos;PAYMENT&apos;&#13;
WHEN fulfill_reference_id IS NULL AND risk != &apos;SEAMLESS RISK&apos; THEN &apos;RISK&apos;&#13;
WHEN fulfill_reference_id IS NULL AND validation != &apos;SEAMLESS VALIDATION&apos; THEN &apos;VALIDATION&apos;&#13;
WHEN fulfill_reference_id IS NULL THEN &apos;OTHER&apos;&#13;
ELSE &apos;FULFILLED&apos; END AS rej_owner,&#13;
--CASE WHEN last_payment_method_type IS NULL THEN &apos;OTHER&apos; ELSE last_payment_method_type END AS last_payment_method_type,&#13;
CASE WHEN last_payment_method_type_2 IS NULL THEN &apos;OTHER&apos; ELSE last_payment_method_type_2 END AS last_payment_method_type_2,&#13;
CASE WHEN last_payment_method_brand IS NULL THEN &apos;NO INFO&apos; ELSE last_payment_method_brand END AS last_payment_method_brand,&#13;
--CASE WHEN ic.id IS NULL THEN &apos;NO INFO&apos; ELSE ic.brand END AS card_brand,&#13;
COUNT(DISTINCT purchase_id) AS qty_purchases,&#13;
COUNT(DISTINCT CASE WHEN fulfill_reference_id IS NOT NULL THEN purchase_id END) AS qty_scc_purchases&#13;
FROM base b&#13;
--LEFT JOIN `peya-data-origins-pro.cl_payments.instrument_card` ic&#13;
--ON b.last_payment_method_instrument_id = ic.id&#13;
--WHERE last_payment_method_type IS NULL-- AND ic.id IS NULL&#13;
GROUP BY 1,2,3,4,5--,6,7</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.12vpca60gg2qsp1h3dx2b1frdysw' name='Consulta SQL personalizada' type='text'>WITH validation_errors AS (&#13;
