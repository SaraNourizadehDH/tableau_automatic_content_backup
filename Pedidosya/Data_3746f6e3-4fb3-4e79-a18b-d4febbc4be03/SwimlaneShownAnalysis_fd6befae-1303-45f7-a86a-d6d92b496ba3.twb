    <calculation class='tableau' formula='if (ZN(SUM([qty_events])) - LOOKUP(ZN(SUM([qty_events])), -1)) / ABS(LOOKUP(ZN(SUM([qty_events])), -1)) &lt; -0.213 &\#13;&\#10;then &apos;excedido&apos; else &apos;no excede&apos; end'>
