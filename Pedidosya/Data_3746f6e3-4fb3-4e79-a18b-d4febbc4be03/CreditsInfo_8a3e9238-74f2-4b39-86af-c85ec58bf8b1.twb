            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_A7B6A8B17C7A482086661C8222A65250]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>vertical</remote-name>
            <remote-type>130</remote-type>
            <local-name>[vertical]</local-name>
            <parent-name>[Consulta SQL personalizada]</parent-name>
            <remote-alias>vertical</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
