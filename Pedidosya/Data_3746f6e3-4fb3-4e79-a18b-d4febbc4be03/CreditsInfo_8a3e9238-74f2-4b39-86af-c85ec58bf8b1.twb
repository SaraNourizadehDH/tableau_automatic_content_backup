      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Funnel' name='federated.0k9ccn01ju31o8154d6o60swdj6f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Country' caption='Dimensión' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;country&quot;'>
              <calculation class='tableau' formula='&quot;country&quot;' />
              <aliases>
                <alias key='&quot;client_segment&quot;' value='Segmento' />
                <alias key='&quot;country&quot;' value='Country' />
                <alias key='&quot;is_key_account&quot;' value='Is key account' />
                <alias key='&quot;partner_aging&quot;' value='Months in Peya' />
