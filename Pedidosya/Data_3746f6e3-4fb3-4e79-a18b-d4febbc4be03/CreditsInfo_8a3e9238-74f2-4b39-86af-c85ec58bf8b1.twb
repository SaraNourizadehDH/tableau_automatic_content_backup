            <alias key='&quot;ruts_approved&quot;' value='Ruts aprobados' />
            <alias key='&quot;sessions_approved&quot;' value='Credit Granted' />
            <alias key='&quot;sessions_proceeded&quot;' value='Credit Proceeded' />
            <alias key='&quot;sessions_selected&quot;' value='Credit Selected' />
            <alias key='&quot;sessions_simulated&quot;' value='Credit Simulated' />
            <alias key='&quot;sessions_use_confirmed&quot;' value='Credit Use Confirmed' />
          </aliases>
        </column>
        <column caption='Tipo de Fecha' datatype='string' name='[Parámetro 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mensual&quot;'>
          <calculation class='tableau' formula='&quot;Mensual&quot;' />
        </column>
        <column caption='Metrica Comms' datatype='string' name='[Parámetro 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Banner CTR Sessions&quot;'>
          <calculation class='tableau' formula='&quot;Banner CTR Sessions&quot;' />
          <aliases>
            <alias key='&quot;Banner Visto&quot;' value='Ruts con banner visto' />
            <alias key='&quot;Click Rate Ruts&quot;' value='Click Rate Ruts Emails' />
            <alias key='&quot;Email Click Rate&quot;' value='Click Rate Emails' />
            <alias key='&quot;Email Open Rate&quot;' value='Open Rate Emails' />
            <alias key='&quot;email_click_totals&quot;' value='Mail Clickeados' />
            <alias key='&quot;email_open_totals&quot;' value='Mail Abiertos' />
            <alias key='&quot;email_send_totals&quot;' value='Mail Enviados' />
            <alias key='&quot;Open Rate Ruts&quot;' value='Open Rate Ruts Emails' />
            <alias key='&quot;Ruts abierto&quot;' value='Ruts con mail abierto' />
            <alias key='&quot;Ruts clickeado&quot;' value='Ruts con mail clickeado' />
            <alias key='&quot;Ruts enviado&quot;' value='Ruts con mail enviado' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_A7B6A8B17C7A482086661C8222A65250'>
            <properties context=''>
              <relation connection='bigquery.03kni3k12ho9nt0zzv5o31kz6573' name='Consulta SQL personalizada' type='text'><![CDATA[---- MONTHLY MONTHLY MONTHLY MONTHLY
WITH partner_info AS (
SELECT DISTINCT
dp.billingInfo.rut,
dp.billingInfo.billing_info_id,
partner_id,
dp.country.country_name
FROM `peya-bi-tools-pro.il_core.dim_partner` dp
)
,loan_fix AS (
SELECT
  DISTINCT
  session_id,
  MAX(dp.rut) rut,
  MAX(COALESCE(loanid,offerId)) loanid
FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` ga
  LEFT JOIN partner_info dp
    ON REPLACE(LTRIM(REPLACE(ga.companynumber , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.rut , '0', ' ')),' ', '0') 
  AND ((ga.page_location NOT LIKE "%rider%" AND ga.page_location NOT LIKE "%stg-creditos%") OR ga.page_location IS NULL)
  AND (ga.loanid != "10" OR ga.offerId IS NOT NULL) 
GROUP BY 1
),
banner AS (
  SELECT
  DISTINCT
      pi.session_id,
      dp.country_name,
      COALESCE(ans.client_segment,hc.client_segment) AS client_segment,
      COALESCE(ans.legacy_client_segment,hc.segmento_old) AS legacy_segment,
      COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
      COALESCE(ans.vertical,hc.vertical) AS vertical,
      COALESCE(ans.is_ka,hc.is_ka) is_key_account,
      "Finance Plug In",
      DATE_TRUNC(DATE(session_date),MONTH) banner_date,
      CAST(rut AS STRING) rut,
      CAST(offer AS STRING) oferta,
      event_action,
      paymenttype,    
    FROM `peya-datamarts-pro.dm_fintech.finance_plugin_events` pi
    LEFT JOIN partner_info dp
      ON pi.partner_id = dp.partner_id
    LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
        ON REPLACE(LTRIM(REPLACE(rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
        AND DATE_TRUNC(DATE(session_date),MONTH) >>= hc.fecha
        AND DATE_TRUNC(DATE(session_date),MONTH) << hc.next_fecha
    LEFT JOIN `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` as ans
        ON REPLACE(LTRIM(REPLACE(rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(ans.tax_id_number , '0', ' ')),' ', '0')
        AND DATE(session_date) >>= ans.offer_date
        AND DATE(session_date) << ans.next_offer_date
    WHERE event_action IN ("finance_banner_credits_modal.loaded","finance_banner_credits_accepted_button.c")
    AND DATE(session_date) >>= "2023-01-01"
    AND dp.country_name IS NOT NULL
    AND COALESCE(ans.client_segment,hc.client_segment) IS NOT NULL
  UNION ALL
  SELECT
  DISTINCT
      pi.session_id,
      dp.country_name,
      COALESCE(ans.client_segment,hc.client_segment) AS client_segment,
      COALESCE(ans.legacy_client_segment,hc.segmento_old) AS legacy_segment,
      COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
      COALESCE(ans.vertical,hc.vertical) AS vertical,
      COALESCE(ans.is_ka,hc.is_ka) is_key_account,
      "Credits Plug In",
      DATE_TRUNC(DATE(fielddate),MONTH) banner_date,
      CAST(rut AS STRING) rut,
      CAST(offer AS STRING) oferta,
      event_name,
        paymenttype,
    FROM `peya-fraud-and-fintech.automated_tables_reports.credits_plugin` pi
    LEFT JOIN partner_info dp
      ON pi.vendor_id = CAST(dp.partner_id AS STRING)
    LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
        ON REPLACE(LTRIM(REPLACE(rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
        AND DATE_TRUNC(DATE(fielddate),MONTH) >>= hc.fecha
        AND DATE_TRUNC(DATE(fielddate),MONTH) << hc.next_fecha
    LEFT JOIN `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` as ans
        ON REPLACE(LTRIM(REPLACE(rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(ans.tax_id_number , '0', ' ')),' ', '0')
        AND DATE(fielddate) >>= ans.offer_date
        AND DATE(fielddate) << ans.next_offer_date
    WHERE event_name IN ("finance_banner_credits_modal.loaded","finance_banner_credits_accepted_button.c")
    AND DATE(fielddate) >>= "2023-01-01"
    AND dp.country_name IS NOT NULL
    AND COALESCE(ans.client_segment,hc.client_segment) IS NOT NULL 
),
comms_info AS (
  SELECT
    DISTINCT
    DATE(event_received) date_received,
    CASE
      WHEN external_id LIKE "%-%" THEN SPLIT(external_id,"-")[OFFSET(1)]
      WHEN external_id LIKE "%/%" THEN  SPLIT(external_id,"/")[OFFSET(0)]
      ELSE external_id
    END contrato,
    event_Type
  FROM `peya-data-origins-pro.cl_financial_services.braze_currents_partner_credits_engagements`
  WHERE external_id NOT LIKE "RC-%"
  AND external_id NOT LIKE "ML-%"
  AND external_id NOT LIKE "GA-%"
  AND event_type IN ("email_send" ,"email_open" , "email_click") 
),
main_comms AS (
  SELECT
    CONCAT(contrato,date_received) comm_id,
    p.country_name,
    COALESCE(ans.client_segment,hc.client_segment) AS client_segment,
    COALESCE(ans.legacy_client_segment,hc.segmento_old) AS legacy_segment,
    COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
    COALESCE(ans.vertical,hc.vertical) AS vertical,
    COALESCE(ans.is_ka,hc.is_ka) is_key_account,
    "EMAIL COMM" email,
    ci.date_received sent_date,
    p.rut rut,
    CAST(offer AS STRING) oferta,
    event_type,
    paymenttype,

  FROM comms_info ci
  LEFT JOIN partner_info p
    ON contrato = CAST(p.billing_info_id AS STRING)
  LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
      ON REPLACE(LTRIM(REPLACE(p.rut, '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
      AND DATE_TRUNC(DATE(date_received),MONTH) >>= hc.fecha
      AND DATE_TRUNC(DATE(date_received),MONTH) << hc.next_fecha
  LEFT JOIN `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` as ans
      ON REPLACE(LTRIM(REPLACE(p.rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(ans.tax_id_number , '0', ' ')),' ', '0')
      AND DATE(date_received) >>= ans.offer_date
      AND DATE(date_received) << ans.next_offer_date
  --WHERE p.billinginfo.rut = "30717371964"
  WHERE COALESCE(ans.client_segment,hc.client_segment) IS NOT NULL
),
banner_sessions AS (
SELECT 
  SAFE_CAST(vendor_id AS INT64) AS partner_id,
  event_timestamp_utc,
  "Credits Plug In" AS redirect_source
  FROM `peya-fraud-and-fintech.automated_tables_reports.credits_plugin` pi
    LEFT JOIN partner_info dp
      ON pi.vendor_id = CAST(dp.partner_id AS STRING)
    WHERE event_name IN ("finance_banner_credits_accepted_button.c")
    AND DATE(fielddate) >>= "2023-01-01"
    AND dp.country_name IS NOT NULL
UNION ALL
SELECT 
  pi.partner_id,
  hit_timestamp AS event_timestamp_utc,
  "Finance Plug In" AS redirect_source
  FROM `peya-datamarts-pro.dm_fintech.finance_plugin_events` pi
    LEFT JOIN partner_info dp
      ON pi.partner_id = dp.partner_id
    WHERE event_action IN ("finance_banner_credits_accepted_button.c")
    AND DATE(session_date) >>= "2023-01-01"
    AND dp.country_name IS NOT NULL
),

banner_redirected_sessions AS (
SELECT 
  DISTINCT ga.session_id,
  MAX(redirect_source) AS redirect_source
FROM  `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` ga
  LEFT JOIN partner_info dp
    ON REPLACE(LTRIM(REPLACE(ga.companynumber , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.rut , '0', ' ')),' ', '0') 
  LEFT JOIN banner_sessions bs
    ON dp.partner_id = bs.partner_id AND ga.visitstarttime between bs.event_timestamp_utc AND TIMESTAMP_ADD(bs.event_timestamp_utc, INTERVAL 5 MINUTE) 
  WHERE eventname != "page.view"
  AND ((ga.page_location NOT LIKE "%rider%" AND ga.page_location NOT LIKE "%stg-creditos%") OR ga.page_location IS NULL)
  AND (ga.loanid != "10" OR ga.offerId IS NOT NULL) 
  GROUP BY ALL

),

session_info AS (
SELECT DISTINCT
  ga.session_id,
  dp.country_name,
  COALESCE(ans.client_segment,hc.client_segment) AS client_segment,
  COALESCE(ans.legacy_client_segment,hc.segmento_old) AS legacy_segment,
  COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
  COALESCE(ans.vertical,hc.vertical) AS vertical,
  COALESCE(ans.is_ka,hc.is_ka) is_key_account,
  CASE 
    WHEN redirect_source IS NOT NULL THEN redirect_source
    WHEN source IS NULL THEN 'Direct Unknown' 
    WHEN UPPER(source) = "(DIRECT)" THEN "Direct" 
    WHEN (UPPER(source) LIKE "%CARDSOCIOS%") THEN "Socios"
    WHEN (UPPER(source) LIKE "%FINANCE%") THEN "Finance"
    WHEN (UPPER(source) LIKE "%CREDIT%") THEN "Credits Plug In"
    WHEN (UPPER(source) LIKE "%PORTAL.RESTAURANT%" OR UPPER(medium) LIKE "%PORTAL.RESTAURANT%" OR UPPER(source) LIKE "%BANNER%" OR UPPER(medium) LIKE "%BANNER%") THEN "VP"
    WHEN (UPPER(source) LIKE "%EMM%" OR UPPER(medium) LIKE "%EMM%") THEN "EMM"
    WHEN (UPPER(source) LIKE "%WAB%" OR UPPER(medium) LIKE "%WAB%") THEN "WAB"
    WHEN (UPPER(source) LIKE "%SMS%" OR UPPER(medium) LIKE "%SMS%") THEN "SMS"
    WHEN (UPPER(source) LIKE "%GOOGLE%" OR UPPER(medium) LIKE "%GOOGLE%") THEN "GOOGLE"
    WHEN (UPPER(source) LIKE "%META%" OR UPPER(medium) LIKE "%META%") THEN "META"
    ELSE "OTHER"
  END traffic_source,
  DATE(visitstarttime) eventDate,
  ga.companynumber,
  lf.loanid,
  eventname,
  paymenttype,

FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` ga
  LEFT JOIN loan_fix lf
    ON ga.session_id = lf.session_id
  LEFT JOIN banner_redirected_sessions br
    ON br.session_id = ga.session_id
  LEFT JOIN partner_info dp
    ON REPLACE(LTRIM(REPLACE(lf.rut , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.rut , '0', ' ')),' ', '0') 
  LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
    ON REPLACE(LTRIM(REPLACE(lf.rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
    AND DATE_TRUNC(DATE(visitstarttime),MONTH) >>= hc.fecha
    AND DATE_TRUNC(DATE(visitstarttime),MONTH) << hc.next_fecha
  LEFT JOIN `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` as ans
    ON REPLACE(LTRIM(REPLACE(lf.rut , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(ans.tax_id_number , '0', ' ')),' ', '0')
    AND DATE(visitstarttime) >>= ans.offer_date
    AND DATE(visitstarttime) << ans.next_offer_date
  WHERE eventname != "page.view"
  AND ((ga.page_location NOT LIKE "%rider%" AND ga.page_location NOT LIKE "%stg-creditos%") OR ga.page_location IS NULL)
  AND (ga.loanid != "10" OR ga.offerId IS NOT NULL) 
UNION ALL
SELECT * FROM banner
UNION ALL
SELECT * FROM main_comms
),
main AS (
SELECT
  session_id,
  country_name,
  DATE(eventDate) eventDate,
  loanid,
  companynumber,
  IFNULL(traffic_source,"Direct") traffic_source,
  client_segment,
  legacy_segment,
  IFNULL(partner_aging,"0-12") partner_aging,
  IFNULL(vertical,"Restaurant") vertical,
  IFNULL(is_key_account,FALSE) is_key_account,
  paymenttype,
  CASE WHEN simulation >> 0 THEN 1 ELSE 0 END simulated,
  CASE WHEN bank_proceeded >> 0  THEN 1 ELSE 0 END bank_proceeded,
  CASE WHEN amount_selector >> 0 THEN 1 ELSE 0 END amount_selector,
  CASE WHEN installment_selector >> 0 THEN 1 ELSE 0 END installment_selector,
  CASE WHEN selected >> 0 THEN 1 ELSE 0 END selected,
  CASE WHEN confirmed >> 0 THEN 1 ELSE 0 END confirmed,
  CASE WHEN aprobado >> 0 THEN 1 ELSE 0 END approved,
  CASE WHEN use_confirmed >> 0 THEN 1 ELSE 0 END use_confirmation,
  CASE WHEN offer_count >> 0 THEN 1 ELSE 0 END offer,
  CASE WHEN kyc >> 0 THEN 1 ELSE 0 END kyc,
  CASE WHEN banner_seen >> 0 THEN 1 ELSE 0 END banner_seen,
  CASE WHEN banner_clicked >> 0 THEN 1 ELSE 0 END banner_clicked,
  CASE WHEN email_send >> 0 THEN 1 ELSE 0 END email_send,
  CASE WHEN email_open >> 0 THEN 1 ELSE 0 END email_open,
  CASE WHEN email_click >> 0 THEN 1 ELSE 0 END email_click,
  CASE WHEN switch_amount >> 0 THEN 1 ELSE 0 END switch_amount
FROM session_info
PIVOT(COUNT(1) FOR eventname IN 
  ("credit_simulated.loaded"simulation,"amount_selector.clicked" amount_selector,"installment_selector.clicked" installment_selector,"switch_amount.clicked" switch_amount,"credit_selection.proceeded" selected,"credit_confirmation.clicked" confirmed,"credit_approved.loaded" aprobado,"credit_bank_info.proceeded" bank_proceeded,"selection_use_confirmation.clicked" use_confirmed, "offer_count" offer_count, "file_upload.clicked" kyc,"finance_banner_credits_modal.loaded" banner_seen,"finance_banner_credits_accepted_button.c" banner_clicked,"email_send","email_open","email_click"))
)
SELECT
  country_code AS country_name,
  eventDate eventDate,
  client_segment,
  legacy_segment,
  partner_aging,
  vertical,
  traffic_source,
  IFNULL(is_key_account,FALSE) is_key_account,
  paymenttype,
  COUNT(DISTINCT CASE WHEN approved = 1 THEN companynumber END) ruts_approved,
  COUNT(DISTINCT CASE WHEN (simulated = 1 OR (approved = 1 AND DATE(eventDate) IN ("2024-06-28","2024-06-29","2024-06-30"))) THEN companynumber END) ruts_simulated,
  COUNT(DISTINCT CASE WHEN (simulated = 1 OR (approved = 1 AND DATE(eventDate) IN ("2024-06-28","2024-06-29","2024-06-30"))) THEN session_id END) sessions_simulated,
  COUNT(DISTINCT CASE WHEN (bank_proceeded = 1 OR approved = 1)  THEN session_id END) sessions_proceeded,
  COUNT(DISTINCT CASE WHEN (selected = 1 OR approved = 1)   THEN session_id END) sessions_selected,
  COUNT(DISTINCT CASE WHEN (use_confirmation = 1 OR approved = 1)  THEN session_id END) sessions_use_confirmed,
  COUNT(DISTINCT CASE WHEN ((m.country_name = "Perú" AND kyc = 1) OR (m.country_name = "Perú" AND approved = 1 AND client_segment NOT IN ("Loyal","New Adopter","Past Adopter")))  THEN session_id END) sessions_kyc,
  COUNT(DISTINCT CASE WHEN approved = 1  THEN session_id END) sessions_approved,
  COUNT(DISTINCT CASE WHEN installment_selector = 1  OR amount_selector = 1 OR switch_amount = 1 THEN session_id END) sessions_interacted_first_step,
  COUNT(DISTINCT CASE WHEN installment_selector = 1 THEN session_id END) installment_selected,
  COUNT(DISTINCT CASE WHEN switch_amount = 1 OR amount_selector = 1 THEN session_id END) amount_switched,
  COUNT(DISTINCT CASE WHEN offer = 1  THEN loanid END) offers,
  COUNT(DISTINCT CASE WHEN  banner_seen >> 0 THEN session_id END) sessions_banner_seen,
  COUNT(DISTINCT CASE WHEN  banner_clicked >> 0 THEN session_id END) sessions_banner_clicked,
  COUNT(DISTINCT CASE WHEN  banner_seen >> 0 THEN companynumber END) ruts_banner_seen,
  COUNT(DISTINCT CASE WHEN  banner_clicked >> 0 THEN companynumber END) ruts_banner_clicked,
  COUNT(DISTINCT CASE WHEN  email_send >> 0 THEN session_id END) email_send,
  COUNT(DISTINCT CASE WHEN  email_open >> 0 THEN session_id END) email_open,
  COUNT(DISTINCT CASE WHEN  email_click >> 0 THEN session_id END) email_click,
  COUNT(DISTINCT CASE WHEN  email_send >> 0 THEN companyNumber END) rut_email_send,
  COUNT(DISTINCT CASE WHEN  email_open>> 0 THEN companyNumber END) rut_email_open,
  COUNT(DISTINCT CASE WHEN  email_click>> 0 THEN companyNumber END) rut_email_click
FROM main m
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_name = m.country_name
WHERE m.country_name IN ("Argentina","Ecuador","Chile","República Dominicana","Perú","El Salvador","Guatemala") 
AND eventDate >>= "2023-03-01"
--AND client_segment IS NOT NULL
GROUP BY 1,2,3,4,5,6,7,8,9]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Riders Funnel' inline='true' name='federated.11kqn5n0ccxt210zohbdz1js7q73' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1j8x8uc0swsdc61607xu20e3vb7m'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_franco_solano' server-oauth='' username='santiago.castillo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1j8x8uc0swsdc61607xu20e3vb7m' name='Consulta SQL personalizada' type='text'>------ RIDERS RIDERS RIDERS&#13;
WITH &#13;
backend_not_tracked AS (&#13;
SELECT&#13;
  DATE_TRUNC(DATE(request_date),MONTH) mes_solicitud,&#13;
  CONCAT(cc.id,cc.request_date) session_be,&#13;
  dc.country_name,&#13;
  product_type,&#13;
  status,&#13;
  CAST(cc.id AS STRING) credit_id,&#13;
  &quot;backend&quot; source,&#13;
  &quot;backend&quot; campaign,&#13;
  &quot;backend&quot; medium,&#13;
  &quot;credit_approved.loaded&quot; event_name&#13;
FROM `peya-data-origins-pro.cl_financial_services.credits_credit` cc&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc&#13;
  ON cc.country_iso = dc.country_code&#13;
WHERE client_Type = &quot;RIDER&quot;&#13;
AND request_date IS NOT NULL&#13;
-- Creditos que no tengan evento de solicitud trackeados&#13;
AND CAST(offer_id AS STRING) NOT IN (SELECT DISTINCT loanid FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` WHERE TRUE AND (page_location LIKE &quot;%rider%&quot; AND page_location NOT LIKE &quot;%stg-creditos%&quot;) AND eventname = &quot;credit_approved.loaded&quot;)&#13;
),&#13;
offers AS (&#13;
SELECT&#13;
  DATE_TRUNC(DATE(create_at),MONTH) mes_oferta,&#13;
  CONCAT(o.id,o.create_at) session_be,&#13;
  dc.country_name,&#13;
  product_type,&#13;
  status,&#13;
  CAST(o.id AS STRING) offer_id,&#13;
  &quot;backend&quot; source,&#13;
  &quot;backend&quot; campaign,&#13;
  &quot;backend&quot; medium,&#13;
  &quot;offer_count&quot; event_name&#13;
FROM `peya-data-origins-pro.cl_financial_services.credits_offer` o&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc&#13;
  ON o.country_iso = dc.country_code&#13;
WHERE client_type = &quot;RIDER&quot;&#13;
),&#13;
session_info AS (&#13;
SELECT&#13;
  DISTINCT&#13;
  DATE_TRUNC(DATE(visitstarttime),MONTH) date_month,&#13;
  session_id,&#13;
  country_name,&#13;
  off.product_type,&#13;
  IFNULL(c.status,off.status) status,&#13;
  ga.loanid,&#13;
  source,&#13;
  campaign,&#13;
  medium,&#13;
  eventname&#13;
FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` ga&#13;
LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_offer` off&#13;
  ON ga.loanid = CAST(off.id AS STRING)&#13;
LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_credit` c&#13;
  ON ga.loanid = CAST(c.offer_id AS STRING)&#13;
  OR ga.loanid = CAST(c.id AS STRING)&#13;
WHERE TRUE &#13;
  AND (ga.page_location LIKE &quot;%rider%&quot; AND ga.page_location NOT LIKE &quot;%stg-creditos%&quot;)&#13;
  --AND eventname = &quot;credit_approved.loaded&quot;&#13;
UNION ALL &#13;
SELECT * FROM backend_not_tracked&#13;
UNION ALL &#13;
SELECT * FROM offers&#13;
)&#13;
SELECT&#13;
  date_month,&#13;
  session_id,&#13;
  country_name,&#13;
  loanid,&#13;
  product_type,&#13;
  status,&#13;
  source,&#13;
  campaign,&#13;
  medium,&#13;
  CASE WHEN simulation &gt;&gt; 0 THEN 1 ELSE 0 END simulated,&#13;
  CASE WHEN granted &gt;&gt; 0 THEN 1 ELSE 0 END granted,&#13;
  CASE WHEN proceeded &gt;&gt; 0 THEN 1 ELSE 0 END proceeded,&#13;
  CASE WHEN identity_confirmed &gt;&gt; 0 THEN 1 ELSE 0 END identity_confirmed,&#13;
  CASE WHEN offer_count &gt;&gt; 0 THEN 1 ELSE 0 END offer_count,&#13;
  CASE WHEN amount_selector_clicked &gt;&gt; 0 THEN 1 ELSE 0 END amount_selector_clicked,&#13;
  CASE WHEN back_to_credit_clicked &gt;&gt; 0 THEN 1 ELSE 0 END back_to_credit_clicked,&#13;
  CASE WHEN cancel_credit_clicked &gt;&gt; 0 THEN 1 ELSE 0 END cancel_credit_clicked,&#13;
  CASE WHEN detail_button_clicked &gt;&gt; 0 THEN 1 ELSE 0 END detail_button_clicked,&#13;
  CASE WHEN installment_selector_clicked &gt;&gt; 0 THEN 1 ELSE 0 END installment_selector_clicked,&#13;
  CASE WHEN regret_page_clicked &gt;&gt; 0 THEN 1 ELSE 0 END regret_page_clicked&#13;
FROM session_info&#13;
PIVOT(COUNT(1) FOR eventname IN &#13;
  (&quot;credit_simulated.loaded&quot; simulation, &quot;credit_approved.loaded&quot; granted, &quot;credit_selection.proceeded&quot; proceeded, &quot;identity_confirmation.clicked&quot; identity_confirmed, &quot;offer_count&quot; offer_count,&quot;amount_selector.clicked&quot; amount_selector_clicked,&quot;back_to_credit.clicked&quot; back_to_credit_clicked,&quot;cancel_credit.clicked&quot; cancel_credit_clicked, &quot;detail_button.clicked&quot; detail_button_clicked,&quot;installment_selector.clicked&quot; installment_selector_clicked,&quot;regret_page.clicked&quot; regret_page_clicked))&#13;
WHERE country_name IN (&quot;Argentina&quot;,&quot;Chile&quot;,&quot;Ecuador&quot;,&quot;República Dominicana&quot;,&quot;Perú&quot;)&#13;
--AND date_month = &quot;2024-11-01&quot;&#13;
AND loanid IS NOT NULL&#13;
AND status IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1j8x8uc0swsdc61607xu20e3vb7m' name='Consulta SQL personalizada' type='text'>------ RIDERS RIDERS RIDERS&#13;
WITH &#13;
backend_not_tracked AS (&#13;
SELECT&#13;
  DATE_TRUNC(DATE(request_date),MONTH) mes_solicitud,&#13;
  CONCAT(cc.id,cc.request_date) session_be,&#13;
  dc.country_name,&#13;
  product_type,&#13;
  status,&#13;
  CAST(cc.id AS STRING) credit_id,&#13;
  &quot;backend&quot; source,&#13;
  &quot;backend&quot; campaign,&#13;
  &quot;backend&quot; medium,&#13;
  &quot;credit_approved.loaded&quot; event_name&#13;
FROM `peya-data-origins-pro.cl_financial_services.credits_credit` cc&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc&#13;
  ON cc.country_iso = dc.country_code&#13;
WHERE client_Type = &quot;RIDER&quot;&#13;
AND request_date IS NOT NULL&#13;
-- Creditos que no tengan evento de solicitud trackeados&#13;
AND CAST(offer_id AS STRING) NOT IN (SELECT DISTINCT loanid FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` WHERE TRUE AND (page_location LIKE &quot;%rider%&quot; AND page_location NOT LIKE &quot;%stg-creditos%&quot;) AND eventname = &quot;credit_approved.loaded&quot;)&#13;
),&#13;
offers AS (&#13;
SELECT&#13;
  DATE_TRUNC(DATE(create_at),MONTH) mes_oferta,&#13;
  CONCAT(o.id,o.create_at) session_be,&#13;
  dc.country_name,&#13;
  product_type,&#13;
  status,&#13;
  CAST(o.id AS STRING) offer_id,&#13;
  &quot;backend&quot; source,&#13;
  &quot;backend&quot; campaign,&#13;
  &quot;backend&quot; medium,&#13;
  &quot;offer_count&quot; event_name&#13;
FROM `peya-data-origins-pro.cl_financial_services.credits_offer` o&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc&#13;
  ON o.country_iso = dc.country_code&#13;
WHERE client_type = &quot;RIDER&quot;&#13;
),&#13;
session_info AS (&#13;
SELECT&#13;
  DISTINCT&#13;
  DATE_TRUNC(DATE(visitstarttime),MONTH) date_month,&#13;
  session_id,&#13;
  country_name,&#13;
  off.product_type,&#13;
  IFNULL(c.status,off.status) status,&#13;
  ga.loanid,&#13;
  source,&#13;
  campaign,&#13;
  medium,&#13;
  eventname&#13;
FROM `peya-data-origins-pro.cl_financial_services.partner_credits_ga4_hits` ga&#13;
LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_offer` off&#13;
  ON ga.loanid = CAST(off.id AS STRING)&#13;
LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_credit` c&#13;
  ON ga.loanid = CAST(c.offer_id AS STRING)&#13;
  OR ga.loanid = CAST(c.id AS STRING)&#13;
WHERE TRUE &#13;
  AND (ga.page_location LIKE &quot;%rider%&quot; AND ga.page_location NOT LIKE &quot;%stg-creditos%&quot;)&#13;
  --AND eventname = &quot;credit_approved.loaded&quot;&#13;
UNION ALL &#13;
SELECT * FROM backend_not_tracked&#13;
UNION ALL &#13;
SELECT * FROM offers&#13;
)&#13;
SELECT&#13;
  date_month,&#13;
  session_id,&#13;
  country_name,&#13;
  loanid,&#13;
  product_type,&#13;
  status,&#13;
  source,&#13;
  campaign,&#13;
  medium,&#13;
  CASE WHEN simulation &gt;&gt; 0 THEN 1 ELSE 0 END simulated,&#13;
  CASE WHEN granted &gt;&gt; 0 THEN 1 ELSE 0 END granted,&#13;
  CASE WHEN proceeded &gt;&gt; 0 THEN 1 ELSE 0 END proceeded,&#13;
  CASE WHEN identity_confirmed &gt;&gt; 0 THEN 1 ELSE 0 END identity_confirmed,&#13;
  CASE WHEN offer_count &gt;&gt; 0 THEN 1 ELSE 0 END offer_count,&#13;
  CASE WHEN amount_selector_clicked &gt;&gt; 0 THEN 1 ELSE 0 END amount_selector_clicked,&#13;
  CASE WHEN back_to_credit_clicked &gt;&gt; 0 THEN 1 ELSE 0 END back_to_credit_clicked,&#13;
  CASE WHEN cancel_credit_clicked &gt;&gt; 0 THEN 1 ELSE 0 END cancel_credit_clicked,&#13;
  CASE WHEN detail_button_clicked &gt;&gt; 0 THEN 1 ELSE 0 END detail_button_clicked,&#13;
  CASE WHEN installment_selector_clicked &gt;&gt; 0 THEN 1 ELSE 0 END installment_selector_clicked,&#13;
  CASE WHEN regret_page_clicked &gt;&gt; 0 THEN 1 ELSE 0 END regret_page_clicked&#13;
FROM session_info&#13;
PIVOT(COUNT(1) FOR eventname IN &#13;
  (&quot;credit_simulated.loaded&quot; simulation, &quot;credit_approved.loaded&quot; granted, &quot;credit_selection.proceeded&quot; proceeded, &quot;identity_confirmation.clicked&quot; identity_confirmed, &quot;offer_count&quot; offer_count,&quot;amount_selector.clicked&quot; amount_selector_clicked,&quot;back_to_credit.clicked&quot; back_to_credit_clicked,&quot;cancel_credit.clicked&quot; cancel_credit_clicked, &quot;detail_button.clicked&quot; detail_button_clicked,&quot;installment_selector.clicked&quot; installment_selector_clicked,&quot;regret_page.clicked&quot; regret_page_clicked))&#13;
WHERE country_name IN (&quot;Argentina&quot;,&quot;Chile&quot;,&quot;Ecuador&quot;,&quot;República Dominicana&quot;,&quot;Perú&quot;)&#13;
--AND date_month = &quot;2024-11-01&quot;&#13;
AND loanid IS NOT NULL&#13;
AND status IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
