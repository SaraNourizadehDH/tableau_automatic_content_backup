          <zone forceUpdate='true' h='12684' id='1403' type-v2='text' w='29941' x='69473' y='85211'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000'>Definición MCR</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#000000'>MCVR1 = Selected / Simulated</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#000000'>MCVR2 = Proceeded / Selected</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#000000'>MCVR3 = Use confirmed o KYC (PE ) / Proceeded</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#000000'>MCVR4 = Granted / Use confirmed o KYC (PE )</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='1684' id='1523' param='horz' type-v2='layout-flow' w='98828' x='586' y='97895'>
