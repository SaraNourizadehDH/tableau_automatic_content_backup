    <datasource caption='MONTHLY' inline='true' name='federated.0gisbhp0cqbkzr113kx0l17vhuc5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0dtdxar1em3ep616xo0fa0cuptke'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_santiago_castillo' server-oauth='' username='santiago.castillo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dtdxar1em3ep616xo0fa0cuptke' name='Consulta SQL personalizada' type='text'><![CDATA[---- MONTHLY MONTHLY MONTHLY MONTHLY
WITH
credits_backend_new AS (
SELECT cr.id,
  cr.offer_id,
  cr.request_date AS requestDate,
  cl.tax_id_number,
  lower(product_type) AS paymentType,
  requested_Capital AS requestedCapital,
  COALESCE(finish_date,expected_finish_date) AS endDate
FROM `peya-data-origins-pro.cl_financial_services.credits_credit` cr 
  LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_client` cl
    ON cr.client_id = cl.id
WHERE cr.client_type = 'CONTRACT'
AND cr.is_delete IS FALSE
),

offers_backend_new AS (
SELECT cr.id,
  cl.tax_id_number,
  DATE(cr.expiration_date) AS end_date,
  LOWER(cr.product_type) AS paymentType,
  max_capital AS preapprovedCapital,
  annual_nominal_rate AS annualNominalRate
FROM `peya-data-origins-pro.cl_financial_services.credits_offer` cr 
  LEFT JOIN `peya-data-origins-pro.cl_financial_services.credits_client` cl
    ON cr.client_id = cl.id
WHERE cr.client_type = 'CONTRACT'
AND cr.is_delete IS FALSE
),

ofertas AS (
SELECT
  DISTINCT
  "offer_count1",
  cr.country_name,
  COALESCE(cr.client_segment,hc.client_segment) AS client_segment,
  COALESCE(cr.legacy_client_segment,hc.segmento_old) AS legacy_segment,
  COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
  COALESCE(cr.vertical,hc.vertical) AS vertical,
  COALESCE(cr.is_ka,hc.is_ka) is_key_account,
  "Offer Count",
  DATE_TRUNC(DATE(cr.offer_date),MONTH) offerDate,
  "1",
  CAST(cr.offer_id AS STRING) loanid_offer,
  "offer_count",
  lower(COALESCE(hc.paymenttype,cr.offer_type)) AS paymentType,
  cr.tax_id_number,

FROM `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` cr
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
  ON REPLACE(LTRIM(REPLACE(cr.tax_id_number , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.billingInfo.rut , '0', ' ')),' ', '0') 
LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
    ON REPLACE(LTRIM(REPLACE(cr.tax_id_number , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
    AND DATE_TRUNC(DATE(cr.offer_date),MONTH) >>= hc.fecha
    AND DATE_TRUNC(DATE(cr.offer_date),MONTH) << hc.next_fecha
)
,business AS (
SELECT
    DISTINCT
    DATE_TRUNC(DATE(cr.offerDate),MONTH) fecha,
    --DATE_TRUNC(DATE(cr.requestDate),MONTH) fecha_solicitud,
    dc.country_code AS country_name,
    cr.loanid_offer loanid,
    cr.tax_id_number AS taxidnumber,
    cr.client_segment,
    cr.legacy_segment,
    cr.partner_aging,
    cr.vertical,
    cu.id AS credit_id,
    cu.offer_id AS credit_offer_id,
    cr.is_key_account AS is_ka,
    cr.paymenttype,
    CASE WHEN cu.endDate >> CURRENT_DATE THEN TRUE ELSE FALSE END is_active_credit,
    ou.annualNominalRate,
    ou.preapprovedcapital approvedcapital,
    ou.preapprovedcapital/dce.rate_eu approvedcapital_eu,
    IFNULL(cu.requestedCapital,0) requestedcapital,
    IFNULL(cu.requestedCapital,0)/dce.rate_eu requestedCapital_eu,

  FROM ofertas cr
  LEFT JOIN offers_backend_new ou 
    ON cr.loanid_offer = CAST(ou.id AS STRING)
  LEFT JOIN credits_backend_new cu 
    ON ou.id = cu.offer_id
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
   ON REPLACE(LTRIM(REPLACE(cr.tax_Id_Number , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.billingInfo.rut , '0', ' ')),' ', '0') 
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
    ON cr.country_name = dc.country_name
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
    ON dc.currency_id = dce.currency_id
    AND DATE_TRUNC(DATE(cr.offerDate),MONTH) = dce.currency_exchange_date
  WHERE TRUE
    --AND cr.country_name IN ("Argentina","Ecuador","Chile","República Dominicana","Perú") 
    AND DATE(cr.offerDate) >>= "2023-01-01"

)
SELECT
  fecha eventDate,
  country_name,
  client_segment,
  legacy_segment,
  IFNULL(partner_aging,"0-12") partner_aging,
  IFNULL(vertical,"Restaurant") vertical,
  IFNULL(is_ka,FALSE) is_key_account,
  "VP" traffic_source,
  paymenttype,
  COUNT(DISTINCT loanid) AS offers,
  COUNT(DISTINCT credit_id) AS credits,
  COUNT(DISTINCT CASE WHEN is_active_credit THEN loanid END) active_credits,
  SUM(COALESCE(approvedcapital_eu,0)) approved_capital_eu,
  SUM(COALESCE(requestedCapital_eu,0)) requested_capital_eu,
  SUM(COALESCE(approvedcapital,0)) approved_capital_lc,
  SUM(COALESCE(requestedCapital,0)) requested_capital_lc,
FROM business
GROUP BY 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0dtdxar1em3ep616xo0fa0cuptke' name='Consulta SQL personalizada' type='text'><![CDATA[---- MONTHLY MONTHLY MONTHLY MONTHLY
